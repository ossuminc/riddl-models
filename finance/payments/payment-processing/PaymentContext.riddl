// Payment Processing - Payment Context
context PaymentContext as router is {
  inlet PaymentCommandStreamIn is type PaymentCommand  outlet PaymentCommandStreamOut is type PaymentCommand
  inlet PaymentResultStreamIn is type Payment.PaymentResult  outlet PaymentResultStreamOut is type Payment.PaymentResult
  handler PaymentContextBoundary is {
    on authorizePayment: command Payment.AuthorizePayment is {
      send authorizePayment to outlet PaymentContext.PaymentCommandStreamOut
    }
    on declinePayment: command Payment.DeclinePayment is {
      send declinePayment to outlet PaymentContext.PaymentCommandStreamOut
    }
    on capturePayment: command Payment.CapturePayment is {
      send capturePayment to outlet PaymentContext.PaymentCommandStreamOut
    }
    on voidPayment: command Payment.VoidPayment is {
      send voidPayment to outlet PaymentContext.PaymentCommandStreamOut
    }
    on refundPayment: command Payment.RefundPayment is {
      send refundPayment to outlet PaymentContext.PaymentCommandStreamOut
    }
    on settlePayment: command Payment.SettlePayment is {
      send settlePayment to outlet PaymentContext.PaymentCommandStreamOut
    }
    on recordDispute: command Payment.RecordDispute is {
      send recordDispute to outlet PaymentContext.PaymentCommandStreamOut
    }
    on resolveDispute: command Payment.ResolveDispute is {
      send resolveDispute to outlet PaymentContext.PaymentCommandStreamOut
    }
    on initializePayment: command Payment.InitializePayment is {
      send initializePayment to outlet PaymentContext.PaymentCommandStreamOut
    }
    on paymentResult: result Payment.PaymentResult is {
      send paymentResult to outlet PaymentContext.PaymentResultStreamOut
    }
    on other is {
      error "Unexpected message at the PaymentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PaymentCommand Stream Intake' is from outlet PaymentContext.PaymentCommandStreamOut to inlet PaymentContext.Payment.PaymentCommands  connector 'PaymentResult Stream Egress' is from outlet PaymentContext.PaymentRepository.PaymentRepositoryResponses to inlet PaymentContext.PaymentResultStreamIn  adaptor FromCardNetworkService from context CardNetworkService is { 
    handler FromCardNetworkServiceHandler is {
      on event CardNetworkService.AuthResponseReceived is {
        do "the model receives auth response received"
      }
      on other is {
        error "Unexpected message for adaptor FromCardNetworkService"
      }
    } with {
      briefly "from card network service"
      described as {
        |Carries messages from the external CardNetworkService.
      }
    }
  } with {
    briefly "CardNetworkService integration"
    described as {
      |The model's side of the CardNetworkService conversation.
    }
  }
  adaptor ToCardNetworkService to context CardNetworkService is { 
    handler ToCardNetworkServiceHandler is {
      on command CardNetworkService.SendAuthRequest is {
        do "the model sends send auth request"
      }
      on other is {
        error "Unexpected message for adaptor ToCardNetworkService"
      }
    } with {
      briefly "to card network service"
      described as {
        |Carries messages to the external CardNetworkService.
      }
    }
  } with {
    briefly "CardNetworkService integration"
    described as {
      |The model's side of the CardNetworkService conversation.
    }
  }
  adaptor FromFraudService from context FraudService is { 
    handler FromFraudServiceHandler is {
      on event FraudService.FraudScreenCompleted is {
        do "the model receives fraud screen completed"
      }
      on other is {
        error "Unexpected message for adaptor FromFraudService"
      }
    } with {
      briefly "from fraud service"
      described as {
        |Carries messages from the external FraudService.
      }
    }
  } with {
    briefly "FraudService integration"
    described as {
      |The model's side of the FraudService conversation.
    }
  }
  adaptor ToFraudService to context FraudService is { 
    handler ToFraudServiceHandler is {
      on command FraudService.ScreenTransaction is {
        do "the model sends screen transaction"
      }
      on other is {
        error "Unexpected message for adaptor ToFraudService"
      }
    } with {
      briefly "to fraud service"
      described as {
        |Carries messages to the external FraudService.
      }
    }
  } with {
    briefly "FraudService integration"
    described as {
      |The model's side of the FraudService conversation.
    }
  }
  adaptor FromMerchantService from context MerchantService is { 
    handler FromMerchantServiceHandler is {
      on result MerchantService.MerchantDetails is {
        do "the model receives merchant details"
      }
      on other is {
        error "Unexpected message for adaptor FromMerchantService"
      }
    } with {
      briefly "from merchant service"
      described as {
        |Carries messages from the external MerchantService.
      }
    }
  } with {
    briefly "MerchantService integration"
    described as {
      |The model's side of the MerchantService conversation.
    }
  }
  adaptor ToMerchantService to context MerchantService is { 
    handler ToMerchantServiceHandler is {
      on query MerchantService.GetMerchant is {
        do "the model sends get merchant"
      }
      on other is {
        error "Unexpected message for adaptor ToMerchantService"
      }
    } with {
      briefly "to merchant service"
      described as {
        |Carries messages to the external MerchantService.
      }
    }
  } with {
    briefly "MerchantService integration"
    described as {
      |The model's side of the MerchantService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendPaymentNotification is {
        do "the model sends send payment notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromSettlementService from context SettlementService is { 
    handler FromSettlementServiceHandler is {
      on event SettlementService.SettlementSubmitted is {
        do "the model receives settlement submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromSettlementService"
      }
    } with {
      briefly "from settlement service"
      described as {
        |Carries messages from the external SettlementService.
      }
    }
  } with {
    briefly "SettlementService integration"
    described as {
      |The model's side of the SettlementService conversation.
    }
  }
  adaptor ToSettlementService to context SettlementService is { 
    handler ToSettlementServiceHandler is {
      on command SettlementService.SubmitForSettlement is {
        do "the model sends submit for settlement"
      }
      on other is {
        error "Unexpected message for adaptor ToSettlementService"
      }
    } with {
      briefly "to settlement service"
      described as {
        |Carries messages to the external SettlementService.
      }
    }
  } with {
    briefly "SettlementService integration"
    described as {
      |The model's side of the SettlementService conversation.
    }
  }
  adaptor FromThreeDSecureService from context ThreeDSecureService is { 
    handler FromThreeDSecureServiceHandler is {
      on event ThreeDSecureService.AuthenticationCompleted is {
        do "the model receives authentication completed"
      }
      on other is {
        error "Unexpected message for adaptor FromThreeDSecureService"
      }
    } with {
      briefly "from three d secure service"
      described as {
        |Carries messages from the external ThreeDSecureService.
      }
    }
  } with {
    briefly "ThreeDSecureService integration"
    described as {
      |The model's side of the ThreeDSecureService conversation.
    }
  }
  adaptor ToThreeDSecureService to context ThreeDSecureService is { 
    handler ToThreeDSecureServiceHandler is {
      on command ThreeDSecureService.InitiateAuthentication is {
        do "the model sends initiate authentication"
      }
      on other is {
        error "Unexpected message for adaptor ToThreeDSecureService"
      }
    } with {
      briefly "to three d secure service"
      described as {
        |Carries messages to the external ThreeDSecureService.
      }
    }
  } with {
    briefly "ThreeDSecureService integration"
    described as {
      |The model's side of the ThreeDSecureService conversation.
    }
  }
  include "types.riddl"
  include "Payment.riddl"
  // Repository for payment persistence
  repository PaymentRepository as merge is {
    command PersistDisputeRecorded is  {
      paymentId: PaymentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DisputeRecorded applies to.
        }
      }
    } with {
      briefly "Persist DisputeRecorded"
      described as {
        |Instructs this repository to apply DisputeRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentAuthorized is  {
      paymentId: PaymentId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentAuthorized applies to.
        }
      }
    } with {
      briefly "Persist PaymentAuthorized"
      described as {
        |Instructs this repository to apply PaymentAuthorized to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentCaptured is  {
      paymentId: PaymentId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentCaptured applies to.
        }
      }
    } with {
      briefly "Persist PaymentCaptured"
      described as {
        |Instructs this repository to apply PaymentCaptured to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet PaymentRepositoryFromPayment is type PaymentEvent    inlet PaymentRepositoryFromPaymentAnalytics is type PaymentEvent    outlet PaymentRepositoryResponses is type Payment.PaymentResult
    record StoredPayment is  {
      paymentId: PaymentId with {
        briefly "paymentId"
        described as {
          |The paymentId column of the stored payment row.
        }
      }
      info: PaymentInfo with {
        briefly "info"
        described as {
          |The info column of the stored payment row.
        }
      }
    } with {
      briefly "Stored payment row"
      described as {
        |The persistence shape of payment data as this repository stores it.
      }
    }
    schema PaymentData is relational
      of payments as type StoredPayment
        index on field StoredPayment.paymentId
        index on field StoredPayment.info.merchantId
 with {
      briefly "Payment data schema"
      described as {
        |The relational schema holding payment data for the PaymentRepository.
      }
    }
    handler PaymentPersistence is {
      on persistDisputeRecorded: command PersistDisputeRecorded is {
        do "apply DisputeRecorded to the stored row"
      }
      on persistPaymentAuthorized: command PersistPaymentAuthorized is {
        do "apply PaymentAuthorized to the stored row"
      }
      on persistPaymentCaptured: command PersistPaymentCaptured is {
        do "apply PaymentCaptured to the stored row"
      }
      on query GetPaymentStats is {
        let paymentStatsView: type PaymentStatsView = prompt("read the payment stats projection")
        reply paymentStatsView
      }
      on authorizePayment: command Payment.AuthorizePayment is {
        tell event Payment.PaymentAuthorized(paymentId = authorizePayment.paymentId, info = authorizePayment.info, card = authorizePayment.card) to entity PaymentContext.Payment
      }
      on declinePayment: command Payment.DeclinePayment is {
        tell event Payment.PaymentDeclined(paymentId = declinePayment.paymentId, result = declinePayment.result) to entity PaymentContext.Payment
      }
      on capturePayment: command Payment.CapturePayment is {
        tell event Payment.PaymentCaptured(paymentId = capturePayment.paymentId) to entity PaymentContext.Payment
      }
      on voidPayment: command Payment.VoidPayment is {
        tell event Payment.PaymentVoided(paymentId = voidPayment.paymentId, reason = voidPayment.reason) to entity PaymentContext.Payment
      }
      on refundPayment: command Payment.RefundPayment is {
        tell event Payment.PaymentRefunded(paymentId = refundPayment.paymentId, refund = refundPayment.refund) to entity PaymentContext.Payment
      }
      on settlePayment: command Payment.SettlePayment is {
        tell event Payment.PaymentSettled(paymentId = settlePayment.paymentId, settlement = settlePayment.settlement) to entity PaymentContext.Payment
      }
      on recordDispute: command Payment.RecordDispute is {
        tell event Payment.DisputeRecorded(paymentId = recordDispute.paymentId, dispute = recordDispute.dispute) to entity PaymentContext.Payment
      }
      on resolveDispute: command Payment.ResolveDispute is {
        tell event Payment.DisputeResolved(paymentId = resolveDispute.paymentId, disputeId = resolveDispute.disputeId, resolution = resolveDispute.resolution, wonDispute = resolveDispute.wonDispute) to entity PaymentContext.Payment
      }
    } with {
      briefly "Persists payment commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Payment data persistence"
    described as {
      | The PaymentRepository provides persistent storage for
      | payment transactions and settlement data.
    }
  }
  // Projector for payment analytics
  query GetPaymentStats replies result PaymentStatsView is  {
    paymentStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which payment stats to retrieve.
      }
    }
  } with {
    briefly "Get payment stats"
    described as {
      |Retrieves the payment stats projection.
    }
  }
  result PaymentStatsView is  {
    paymentStats: PaymentAnalytics.PaymentStats with {
      briefly "Payment stats"
      described as {
        |The payment stats being returned.
      }
    }
  } with {
    briefly "Payment stats view"
    described as {
      |Read model view carrying the payment stats projection.
    }
  }
  projector PaymentAnalytics as flow is {
    updates repository PaymentContext.PaymentRepository
    inlet PaymentAnalyticsFromPayment is type PaymentEvent    outlet PaymentAnalyticsOut is type PaymentEvent
    record PaymentStats is  {
      merchantId: MerchantId with {
        briefly "Merchant"
        described as {
          |Merchant ID.
        }
      }
      totalTransactions: Natural with {
        briefly "Transactions"
        described as {
          |Total transactions.
        }
      }
      totalVolume: Decimal(15,2) with {
        briefly "Volume"
        described as {
          |Total volume.
        }
      }
      approvalRate: Decimal(5,4) with {
        briefly "Approval"
        described as {
          |Approval rate.
        }
      }
      avgTransactionSize: Decimal(10,2) with {
        briefly "Average"
        described as {
          |Avg transaction.
        }
      }
      chargebackRate: Decimal(5,4) with {
        briefly "Chargeback"
        described as {
          |Chargeback rate.
        }
      }
    } with {
      briefly "Payment statistics"
      described as {
        |Payment processing metrics.
      }
    }
    handler AnalyticsHandler is {
      on paymentAuthorized: event Payment.PaymentAuthorized is {
        tell command PaymentContext.PaymentRepository.PersistPaymentAuthorized(paymentId = paymentAuthorized.paymentId) to repository PaymentContext.PaymentRepository
      }
      on paymentCaptured: event Payment.PaymentCaptured is {
        tell command PaymentContext.PaymentRepository.PersistPaymentCaptured(paymentId = paymentCaptured.paymentId) to repository PaymentContext.PaymentRepository
      }
      on disputeRecorded: event Payment.DisputeRecorded is {
        tell command PaymentContext.PaymentRepository.PersistDisputeRecorded(paymentId = disputeRecorded.paymentId) to repository PaymentContext.PaymentRepository
      }
    } with {
      briefly "Maintains payment analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Payment analytics projections"
    described as {
      |Maintains payment processing analytics data.
    }
  }
  processor PaymentEventSource as source is {
    outlet PaymentEvents is type PaymentEvent
    handler PaymentEventEmitter is {
      on init is {
        let initializePayment: type InitializePayment = prompt("the initialize payment that brings this this into existence")
        tell initializePayment to entity PaymentContext.Payment
      }
      on other is {
        error "Unexpected message for source PaymentEventSource"
      }
      on paymentAuthorized: event Payment.PaymentAuthorized is {
        send paymentAuthorized to outlet PaymentEvents
      }
      on paymentCaptured: event Payment.PaymentCaptured is {
        send paymentCaptured to outlet PaymentEvents
      }
      on paymentSettled: event Payment.PaymentSettled is {
        send paymentSettled to outlet PaymentEvents
      }
      on disputeRecorded: event Payment.DisputeRecorded is {
        send disputeRecorded to outlet PaymentEvents
      }
    } with {
      briefly "Payment event emitter"
      described as {
        |Emits payment lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Payment event source"
    described as {
      |Publishes payment entity events for streaming.
    }
  }
  processor PaymentEventSink as sink is {
    inlet IncomingPaymentEvents is type PaymentEvent    handler PaymentEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink PaymentEventSink"
      }
      on paymentAuthorized: event Payment.PaymentAuthorized is {
        tell paymentAuthorized to repository PaymentContext.PaymentRepository
      }
      on paymentSettled: event Payment.PaymentSettled is {
        tell paymentSettled to repository PaymentContext.PaymentRepository
      }
    } with {
      briefly "Payment event receiver"
      described as {
        |Receives payment events and persists them.
      }
    }
  } with {
    briefly "Payment event sink"
    described as {
      |Receives payment events from the streaming topology.
    }
  }
  connector PaymentEventPipeline is from outlet PaymentContext.PaymentEventSource.PaymentEvents to inlet PaymentContext.PaymentEventSink.IncomingPaymentEvents with {
    briefly "Payment event pipeline"
    described as {
      |Wires payment events from source to sink.
    }
  }
  processor PaymentEventSplit as split is {
    inlet PaymentEventSplitIn is type PaymentEvent    outlet PaymentEventSplitToPaymentRepository is type PaymentEvent
    outlet PaymentEventSplitToPaymentAnalytics is type PaymentEvent
    handler PaymentEventSplitHandler is {
      on paymentAuthorized: event Payment.PaymentAuthorized is {
        send paymentAuthorized to outlet PaymentEventSplitToPaymentRepository
        send paymentAuthorized to outlet PaymentEventSplitToPaymentAnalytics
        tell paymentAuthorized to entity PaymentContext.Payment
      }
      on paymentDeclined: event Payment.PaymentDeclined is {
        send paymentDeclined to outlet PaymentEventSplitToPaymentRepository
        send paymentDeclined to outlet PaymentEventSplitToPaymentAnalytics
        tell paymentDeclined to entity PaymentContext.Payment
      }
      on paymentCaptured: event Payment.PaymentCaptured is {
        send paymentCaptured to outlet PaymentEventSplitToPaymentRepository
        send paymentCaptured to outlet PaymentEventSplitToPaymentAnalytics
        tell paymentCaptured to entity PaymentContext.Payment
      }
      on paymentVoided: event Payment.PaymentVoided is {
        send paymentVoided to outlet PaymentEventSplitToPaymentRepository
        send paymentVoided to outlet PaymentEventSplitToPaymentAnalytics
        tell paymentVoided to entity PaymentContext.Payment
      }
      on paymentRefunded: event Payment.PaymentRefunded is {
        send paymentRefunded to outlet PaymentEventSplitToPaymentRepository
        send paymentRefunded to outlet PaymentEventSplitToPaymentAnalytics
        tell paymentRefunded to entity PaymentContext.Payment
      }
      on paymentSettled: event Payment.PaymentSettled is {
        send paymentSettled to outlet PaymentEventSplitToPaymentRepository
        send paymentSettled to outlet PaymentEventSplitToPaymentAnalytics
        tell paymentSettled to entity PaymentContext.Payment
      }
      on disputeRecorded: event Payment.DisputeRecorded is {
        send disputeRecorded to outlet PaymentEventSplitToPaymentRepository
        send disputeRecorded to outlet PaymentEventSplitToPaymentAnalytics
        tell disputeRecorded to entity PaymentContext.Payment
      }
      on disputeResolved: event Payment.DisputeResolved is {
        send disputeResolved to outlet PaymentEventSplitToPaymentRepository
        send disputeResolved to outlet PaymentEventSplitToPaymentAnalytics
        tell disputeResolved to entity PaymentContext.Payment
      }
      on other is {
        error "Unexpected message for processor PaymentEventSplit"
      }
    } with {
      briefly "Payment event fan-out handler"
      described as {
        |Delivers each Payment event to all of its consumers.
      }
    }
  } with {
    briefly "Payment event fan-out"
    described as {
      |Fans Payment events out to the repository and projectors.
    }
  }
  connector 'PaymentEvent Stream' is from outlet PaymentContext.Payment.PaymentEvents2 to inlet PaymentContext.PaymentEventSplit.PaymentEventSplitIn with {
    briefly "Payment events, fanned out to storage and read models"
  }
  connector 'PaymentEvent Storage' is from outlet PaymentContext.PaymentEventSplit.PaymentEventSplitToPaymentRepository to inlet PaymentContext.PaymentRepository.PaymentRepositoryFromPayment with {
    briefly "Payment events on their way to storage"
  }
  connector 'PaymentAnalytics Feed' is from outlet PaymentContext.PaymentEventSplit.PaymentEventSplitToPaymentAnalytics to inlet PaymentContext.PaymentAnalytics.PaymentAnalyticsFromPayment with {
    briefly "Payment events feeding the PaymentAnalytics projection"
  }
  connector 'PaymentAnalytics Storage' is from outlet PaymentContext.PaymentAnalytics.PaymentAnalyticsOut to inlet PaymentContext.PaymentRepository.PaymentRepositoryFromPaymentAnalytics with {
    briefly "The PaymentAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for payments"
  described as {
    | The PaymentContext is the bounded context for card
    | payment processing, settlement, and disputes.
  }
}
