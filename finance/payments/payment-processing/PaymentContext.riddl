// Payment Processing - Payment Context
context PaymentContext is {
  include "types.riddl"
  include "Payment.riddl"
  // Repository for payment persistence
  repository PaymentRepository is {
    inlet PaymentRepositoryFromPayment is type PaymentEvent
    inlet PaymentRepositoryFromPaymentAnalytics is type PaymentEvent
    outlet PaymentRepositoryResponses is type Payment.PaymentResult
    schema PaymentData is relational
      of payments as type Payment
        index on field Payment.paymentId
        index on field Payment.info.merchantId

    handler PaymentPersistence is {
      on command Payment.AuthorizePayment is {
        tell event Payment.PaymentAuthorized to entity
          PaymentContext.Payment
      }
      on command Payment.DeclinePayment is {
        tell event Payment.PaymentDeclined to entity
          PaymentContext.Payment
      }
      on command Payment.CapturePayment is {
        tell event Payment.PaymentCaptured to entity
          PaymentContext.Payment
      }
      on command Payment.VoidPayment is {
        tell event Payment.PaymentVoided to entity
          PaymentContext.Payment
      }
      on command Payment.RefundPayment is {
        tell event Payment.PaymentRefunded to entity
          PaymentContext.Payment
      }
      on command Payment.SettlePayment is {
        tell event Payment.PaymentSettled to entity
          PaymentContext.Payment
      }
      on command Payment.RecordDispute is {
        tell event Payment.DisputeRecorded to entity
          PaymentContext.Payment
      }
      on command Payment.ResolveDispute is {
        tell event Payment.DisputeResolved to entity
          PaymentContext.Payment
      }
    } with {
      briefly "Persists payment commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Payment data persistence"
    described as {
      | The PaymentRepository provides persistent storage for
      | payment transactions and settlement data.
    }
  }
  // Projector for payment analytics
  projector PaymentAnalytics is {
    inlet PaymentAnalyticsFromPayment is type PaymentEvent
    outlet PaymentAnalyticsOut is type PaymentEvent
    updates repository PaymentContext.PaymentRepository
    record PaymentStats is  {
      merchantId: MerchantId with {
        briefly "Merchant"
        described as {
          |Merchant ID.
        }
      }
      totalTransactions: Natural with {
        briefly "Transactions"
        described as {
          |Total transactions.
        }
      }
      totalVolume: Decimal(15,2) with {
        briefly "Volume"
        described as {
          |Total volume.
        }
      }
      approvalRate: Decimal(5,4) with {
        briefly "Approval"
        described as {
          |Approval rate.
        }
      }
      avgTransactionSize: Decimal(10,2) with {
        briefly "Average"
        described as {
          |Avg transaction.
        }
      }
      chargebackRate: Decimal(5,4) with {
        briefly "Chargeback"
        described as {
          |Chargeback rate.
        }
      }
    } with {
      briefly "Payment statistics"
      described as {
        |Payment processing metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Payment.PaymentAuthorized is {
        tell event Payment.PaymentAuthorized to repository
          PaymentContext.PaymentRepository
      }
      on event Payment.PaymentCaptured is {
        tell event Payment.PaymentCaptured to repository
          PaymentContext.PaymentRepository
      }
      on event Payment.DisputeRecorded is {
        tell event Payment.DisputeRecorded to repository
          PaymentContext.PaymentRepository
      }
    } with {
      briefly "Maintains payment analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Payment analytics projections"
    described as {
      |Maintains payment processing analytics data.
    }
  }
  processor PaymentEventSource as source is {
    outlet PaymentEvents is type PaymentEvent
    handler PaymentEventEmitter is {
      on init is {
        tell command InitializePayment to entity
          PaymentContext.Payment
      }
      on other is {
        error "Unexpected message for source PaymentEventSource"
      }
      on event Payment.PaymentAuthorized is {
        send event Payment.PaymentAuthorized to outlet PaymentEvents
      }
      on event Payment.PaymentCaptured is {
        send event Payment.PaymentCaptured to outlet PaymentEvents
      }
      on event Payment.PaymentSettled is {
        send event Payment.PaymentSettled to outlet PaymentEvents
      }
      on event Payment.DisputeRecorded is {
        send event Payment.DisputeRecorded to outlet PaymentEvents
      }
    } with {
      briefly "Payment event emitter"
      described as {
        |Emits payment lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Payment event source"
    described as {
      |Publishes payment entity events for streaming.
    }
  }
  processor PaymentEventSink as sink is {
    inlet IncomingPaymentEvents is type PaymentEvent
    handler PaymentEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink PaymentEventSink"
      }
      on event Payment.PaymentAuthorized is {
        tell event Payment.PaymentAuthorized to repository
          PaymentContext.PaymentRepository
      }
      on event Payment.PaymentSettled is {
        tell event Payment.PaymentSettled to repository
          PaymentContext.PaymentRepository
      }
    } with {
      briefly "Payment event receiver"
      described as {
        |Receives payment events and persists them.
      }
    }
  } with {
    briefly "Payment event sink"
    described as {
      |Receives payment events from the streaming topology.
    }
  }
  connector PaymentEventPipeline is {
    from outlet PaymentContext.PaymentEventSource.PaymentEvents
      to inlet PaymentContext.PaymentEventSink.IncomingPaymentEvents
  } with {
    briefly "Payment event pipeline"
    described as {
      |Wires payment events from source to sink.
    }
  }
  processor PaymentEventSplit is {
    inlet PaymentEventSplitIn is type PaymentEvent
    outlet PaymentEventSplitToPaymentRepository is type PaymentEvent
    outlet PaymentEventSplitToPaymentAnalytics is type PaymentEvent
    handler PaymentEventSplitHandler is {
      on event Payment.PaymentAuthorized is {
        send event Payment.PaymentAuthorized to outlet PaymentEventSplitToPaymentRepository
        send event Payment.PaymentAuthorized to outlet PaymentEventSplitToPaymentAnalytics
        tell event Payment.PaymentAuthorized to entity PaymentContext.Payment
      }
      on event Payment.PaymentDeclined is {
        send event Payment.PaymentDeclined to outlet PaymentEventSplitToPaymentRepository
        send event Payment.PaymentDeclined to outlet PaymentEventSplitToPaymentAnalytics
        tell event Payment.PaymentDeclined to entity PaymentContext.Payment
      }
      on event Payment.PaymentCaptured is {
        send event Payment.PaymentCaptured to outlet PaymentEventSplitToPaymentRepository
        send event Payment.PaymentCaptured to outlet PaymentEventSplitToPaymentAnalytics
        tell event Payment.PaymentCaptured to entity PaymentContext.Payment
      }
      on event Payment.PaymentVoided is {
        send event Payment.PaymentVoided to outlet PaymentEventSplitToPaymentRepository
        send event Payment.PaymentVoided to outlet PaymentEventSplitToPaymentAnalytics
        tell event Payment.PaymentVoided to entity PaymentContext.Payment
      }
      on event Payment.PaymentRefunded is {
        send event Payment.PaymentRefunded to outlet PaymentEventSplitToPaymentRepository
        send event Payment.PaymentRefunded to outlet PaymentEventSplitToPaymentAnalytics
        tell event Payment.PaymentRefunded to entity PaymentContext.Payment
      }
      on event Payment.PaymentSettled is {
        send event Payment.PaymentSettled to outlet PaymentEventSplitToPaymentRepository
        send event Payment.PaymentSettled to outlet PaymentEventSplitToPaymentAnalytics
        tell event Payment.PaymentSettled to entity PaymentContext.Payment
      }
      on event Payment.DisputeRecorded is {
        send event Payment.DisputeRecorded to outlet PaymentEventSplitToPaymentRepository
        send event Payment.DisputeRecorded to outlet PaymentEventSplitToPaymentAnalytics
        tell event Payment.DisputeRecorded to entity PaymentContext.Payment
      }
      on event Payment.DisputeResolved is {
        send event Payment.DisputeResolved to outlet PaymentEventSplitToPaymentRepository
        send event Payment.DisputeResolved to outlet PaymentEventSplitToPaymentAnalytics
        tell event Payment.DisputeResolved to entity PaymentContext.Payment
      }
      on other is {
        error "Unexpected message for processor PaymentEventSplit"
      }
    } with {
      briefly "Payment event fan-out handler"
      described as {
        |Delivers each Payment event to all of its consumers.
      }
    }
  } with {
    briefly "Payment event fan-out"
    described as {
      |Fans Payment events out to the repository and projectors.
    }
  }
  connector LinkPaymentToPaymentEventSplit is {
    from outlet PaymentContext.Payment.PaymentEvents2 to
      inlet PaymentContext.PaymentEventSplit.PaymentEventSplitIn
  } with {
    briefly "LinkPaymentToPaymentEventSplit"
  }
  connector LinkPaymentEventSplitToPaymentRepository is {
    from outlet PaymentContext.PaymentEventSplit.PaymentEventSplitToPaymentRepository to
      inlet PaymentContext.PaymentRepository.PaymentRepositoryFromPayment
  } with {
    briefly "LinkPaymentEventSplitToPaymentRepository"
  }
  connector LinkPaymentEventSplitToPaymentAnalytics is {
    from outlet PaymentContext.PaymentEventSplit.PaymentEventSplitToPaymentAnalytics to
      inlet PaymentContext.PaymentAnalytics.PaymentAnalyticsFromPayment
  } with {
    briefly "LinkPaymentEventSplitToPaymentAnalytics"
  }
  connector LinkPaymentAnalyticsToPaymentRepository is {
    from outlet PaymentContext.PaymentAnalytics.PaymentAnalyticsOut to
      inlet PaymentContext.PaymentRepository.PaymentRepositoryFromPaymentAnalytics
  } with {
    briefly "LinkPaymentAnalyticsToPaymentRepository"
  }
} with {
  briefly "Bounded context for payments"
  described as {
    | The PaymentContext is the bounded context for card
    | payment processing, settlement, and disputes.
  }
}
