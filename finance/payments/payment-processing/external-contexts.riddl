// Payment Processing - External Contexts
// Card Network Service
external context CardNetworkService as flow is {
  outlet CardNetworkServiceEventsOut is event AuthResponseReceived
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet CardNetworkServiceRequests is command SendAuthRequest with {
    briefly "What this context asks the service to send"
  }
  handler CardNetworkServiceBoundary is {
    on command SendAuthRequest is {
      let authResponseReceived: type AuthResponseReceived = prompt("the auth response received this produces")
      send authResponseReceived to outlet CardNetworkService.CardNetworkServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context CardNetworkService"
    }
  } with {
    briefly "CardNetworkService boundary"
  }
  command SendAuthRequest is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    cardBrand: CardBrand with {
      briefly "Brand"
      described as {
        |Card brand.
      }
    }
    amount: Decimal(12,2) with {
      briefly "Amount"
      described as {
        |Auth amount.
      }
    }
    currency: String(1,3) with {
      briefly "Currency"
      described as {
        |Currency code.
      }
    }
  } with {
    briefly "Send auth request"
    described as {
      |Sends authorization to network.
    }
  }
  event AuthResponseReceived is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    result: AuthorizationResult with {
      briefly "Result"
      described as {
        |Auth result.
      }
    }
    receivedAt: TimeStamp with {
      briefly "Received"
      described as {
        |Response time.
      }
    }
  } with {
    briefly "Auth response received"
    described as {
      |Emitted when network responds.
    }
  }
} with {
  briefly "External card network"
  described as {
    |External card network gateway.
  }
}
// Fraud Detection Service
external context FraudService as flow is {
  outlet FraudServiceEventsOut is event FraudScreenCompleted
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet FraudServiceRequests is command ScreenTransaction with {
    briefly "What this context asks the service to send"
  }
  handler FraudServiceBoundary is {
    on command ScreenTransaction is {
      let fraudScreenCompleted: type FraudScreenCompleted = prompt("the fraud screen completed this produces")
      send fraudScreenCompleted to outlet FraudService.FraudServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context FraudService"
    }
  } with {
    briefly "FraudService boundary"
  }
  command ScreenTransaction is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment info.
      }
    }
    card: CardDetails with {
      briefly "Card"
      described as {
        |Card details.
      }
    }
  } with {
    briefly "Screen transaction"
    described as {
      |Screens for fraud.
    }
  }
  event FraudScreenCompleted is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    approved: Boolean with {
      briefly "Approved"
      described as {
        |Passed screening.
      }
    }
    riskScore: Decimal(5,4) with {
      briefly "Risk"
      described as {
        |Risk score.
      }
    }
  } with {
    briefly "Fraud screen completed"
    described as {
      |Emitted when screening finishes.
    }
  }
} with {
  briefly "External fraud service"
  described as {
    |External fraud detection system.
  }
}
// Merchant Service
external context MerchantService as flow is {
  outlet MerchantServiceRepliesOut is result MerchantDetails
 with {
    briefly "What this service answers, on its way back"
  }
  inlet MerchantServiceRequests is query GetMerchant with {
    briefly "What this context asks the service to send"
  }
  handler MerchantServiceBoundary is {
    on query GetMerchant is {
      let askAnswer: type MerchantDetails = prompt("look up what GetMerchant asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context MerchantService"
    }
  } with {
    briefly "MerchantService boundary"
  }
  query GetMerchant replies result MerchantDetails is {
    merchantId: MerchantId with {
      briefly "Merchant"
      described as {
        |Merchant ID.
      }
    }
  } with {
    briefly "Get merchant"
    described as {
      |Retrieves merchant details.
    }
  }
  result MerchantDetails is {
    merchantId: MerchantId with {
      briefly "Merchant"
      described as {
        |Merchant ID.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Merchant name.
      }
    }
    mcc: String(4,4) with {
      briefly "MCC"
      described as {
        |Merchant category code.
      }
    }
  } with {
    briefly "Merchant details"
    described as {
      |Merchant information.
    }
  }
} with {
  briefly "External merchant service"
  described as {
    |External merchant management.
  }
}
// Settlement Service
external context SettlementService as flow is {
  outlet SettlementServiceEventsOut is event SettlementSubmitted
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet SettlementServiceRequests is command SubmitForSettlement with {
    briefly "What this context asks the service to send"
  }
  handler SettlementServiceBoundary is {
    on command SubmitForSettlement is {
      let settlementSubmitted: type SettlementSubmitted = prompt("the settlement submitted this produces")
      send settlementSubmitted to outlet SettlementService.SettlementServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context SettlementService"
    }
  } with {
    briefly "SettlementService boundary"
  }
  command SubmitForSettlement is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    amount: Decimal(12,2) with {
      briefly "Amount"
      described as {
        |Settlement amount.
      }
    }
  } with {
    briefly "Submit for settlement"
    described as {
      |Submits payment for settlement.
    }
  }
  event SettlementSubmitted is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    batchId: String(1,50) with {
      briefly "Batch"
      described as {
        |Settlement batch.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Settlement submitted"
    described as {
      |Emitted when submitted for settlement.
    }
  }
} with {
  briefly "External settlement service"
  described as {
    |External settlement processor.
  }
}
// Notification Service
external context NotificationService as sink is {
  inlet NotificationServiceRequests is command SendPaymentNotification with {
    briefly "What this context asks the service to send"
  }
  handler NotificationServiceBoundary is {
    on command SendPaymentNotification is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context NotificationService"
    }
  } with {
    briefly "NotificationService boundary"
  }
  command SendPaymentNotification is {
    merchantId: MerchantId with {
      briefly "Merchant"
      described as {
        |Merchant ID.
      }
    }
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    notificationType: String(1,50) with {
      briefly "Type"
      described as {
        |Notification type.
      }
    }
    message: String(1,500) with {
      briefly "Message"
      described as {
        |Message content.
      }
    }
  } with {
    briefly "Send notification"
    described as {
      |Sends payment notification.
    }
  }
  event NotificationSent is {
    notificationId: UUID with {
      briefly "Notification"
      described as {
        |Notification ID.
      }
    }
    sentAt: TimeStamp with {
      briefly "Sent"
      described as {
        |Send time.
      }
    }
  } with {
    briefly "Notification was sent"
    described as {
      |Emitted when notification is delivered.
    }
  }
} with {
  briefly "External notification service"
  described as {
    |External notification system.
  }
}
// 3D Secure Service
external context ThreeDSecureService as flow is {
  outlet ThreeDSecureServiceEventsOut is event AuthenticationCompleted
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet ThreeDSecureServiceRequests is command InitiateAuthentication with {
    briefly "What this context asks the service to send"
  }
  handler ThreeDSecureServiceBoundary is {
    on command InitiateAuthentication is {
      let authenticationCompleted: type AuthenticationCompleted = prompt("the authentication completed this produces")
      send authenticationCompleted to outlet ThreeDSecureService.ThreeDSecureServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context ThreeDSecureService"
    }
  } with {
    briefly "ThreeDSecureService boundary"
  }
  command InitiateAuthentication is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    cardBrand: CardBrand with {
      briefly "Brand"
      described as {
        |Card brand.
      }
    }
    amount: Decimal(12,2) with {
      briefly "Amount"
      described as {
        |Payment amount.
      }
    }
  } with {
    briefly "Initiate 3DS"
    described as {
      |Initiates 3D Secure authentication.
    }
  }
  event AuthenticationCompleted is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    authenticated: Boolean with {
      briefly "Authenticated"
      described as {
        |Is authenticated.
      }
    }
    cavv: String(1,50)? with {
      briefly "CAVV"
      described as {
        |Cardholder verification.
      }
    }
  } with {
    briefly "3DS completed"
    described as {
      |Emitted when 3DS completes.
    }
  }
} with {
  briefly "External 3DS service"
  described as {
    |External 3D Secure authentication.
  }
}
