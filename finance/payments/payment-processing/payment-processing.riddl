// Payment Processing Domain Model
// Credit card and debit transaction processing
domain PaymentProcessing is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Merchant is "business accepting payments" with {
    briefly "Merchant"
    described as {
      |Business processing transactions.
    }
  }
  user Cardholder is "person making payment" with {
    briefly "Cardholder"
    described as {
      |Customer making a purchase.
    }
  }
  user PaymentOperator is "person managing payment operations" with {
    briefly "Payment Operator"
    described as {
      |Person monitoring transactions.
    }
  }
  epic PaymentEpic is {
    user Merchant wants to "to process payments securely" so that "sales are completed reliably"
    case ProcessPayment is {
      user Cardholder wants to "to pay for a purchase with card" so that "the transaction completes smoothly"
      step is "Cardholder presents" "payment card" "to merchant" with {
        briefly "Present card"
        described as {
          |Provide payment.
        }
      }
      step is "System validates" "card details" "and authorization" with {
        briefly "Validate card"
        described as {
          |Check card.
        }
      }
      step take input PaymentProcessingApp.PaymentProcessingScreen.AuthorizePaymentInput from user Merchant with {
        briefly "Authorize"
        described as {
          |Request authorization.
        }
      }
      step is "System captures" "funds" "from issuing bank" with {
        briefly "Capture funds"
        described as {
          |Complete payment.
        }
      }
    } with {
      briefly "Payment workflow"
      described as {
        |Standard flow for card payments.
      }
    }
  } with {
    briefly "Payment processing"
    described as {
      | Epic covering payment transactions from
      | authorization through settlement.
    }
  }
  include "PaymentContext.riddl"
  include "external-contexts.riddl"
  application context PaymentProcessingApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PaymentProcessing are delivered.
      }
    }
    group PaymentProcessingScreen is {
      input AuthorizePaymentInput acquires command PaymentContext.Payment.AuthorizePayment with {
        briefly "Authorize payment control"
        described as {
          |The control through which a user submits the authorize payment request.
        }
      }
    } with {
      briefly "Payment processing screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppPaymentCommands is type PaymentContext.Payment.PaymentCommand
    inlet AppPaymentRepositoryResponses is result PaymentContext.Payment.PaymentResult    handler PaymentProcessingAppHandler is {
      on other is {
        error "Unexpected message for application context PaymentProcessingApp"
      }
    } with {
      briefly "PaymentProcessingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PaymentProcessingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'PaymentCommand Stream' is from outlet PaymentProcessingApp.AppPaymentCommands to inlet PaymentContext.PaymentCommandStreamIn with {
    briefly "Payment commands from the application"
  }
  persistent connector 'PaymentResult Stream' is from outlet PaymentContext.PaymentResultStreamOut to inlet PaymentProcessingApp.AppPaymentRepositoryResponses with {
    briefly "Payment query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PaymentProcessingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Payment processing domain"
  described as {
    | The PaymentProcessing domain handles credit and debit
    | card transactions including authorization and settlement.
  }
}
