// Payment Processing - Payment Entity
entity Payment as flow is {
  type PaymentCommand is one of {
    Payment.AuthorizePayment or Payment.DeclinePayment or Payment.CapturePayment or Payment.VoidPayment or Payment.RefundPayment or Payment.SettlePayment or Payment.RecordDispute or Payment.ResolveDispute
  } with {
    briefly "Payment command alternation"
    described as {
      |Commands accepted by the Payment entity.
    }
  }
  inlet PaymentCommands is type PaymentCommand  outlet PaymentEvents2 is type PaymentEvent
  // Commands
  command AuthorizePayment is  {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |New payment identifier.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment information.
      }
    }
    card: CardDetails with {
      briefly "Card"
      described as {
        |Card details.
      }
    }
  } with {
    briefly "Authorize payment"
    described as {
      |Requests payment authorization.
    }
  }
  command DeclinePayment yields event PaymentDeclined is  {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment to decline.
      }
    }
    result: AuthorizationResult with {
      briefly "Result"
      described as {
        |Decline result.
      }
    }
  } with {
    briefly "Decline payment"
    described as {
      |Records a declined payment authorization.
    }
  }
  command CapturePayment is  {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment to capture.
      }
    }
    captureAmount: Decimal(12,2)? with {
      briefly "Capture Amount"
      described as {
        |Capture amount.
      }
    }
  } with {
    briefly "Capture payment"
    described as {
      |Captures authorized payment.
    }
  }
  command VoidPayment is  {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment to void.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Void reason.
      }
    }
  } with {
    briefly "Void payment"
    described as {
      |Voids authorized payment.
    }
  }
  command RefundPayment is  {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment to refund.
      }
    }
    refund: RefundInfo with {
      briefly "Refund"
      described as {
        |Refund details.
      }
    }
  } with {
    briefly "Refund payment"
    described as {
      |Refunds captured payment.
    }
  }
  command SettlePayment is  {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment to settle.
      }
    }
    settlement: SettlementInfo with {
      briefly "Settlement"
      described as {
        |Settlement details.
      }
    }
  } with {
    briefly "Settle payment"
    described as {
      |Settles captured payment.
    }
  }
  command RecordDispute is  {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Disputed payment.
      }
    }
    dispute: DisputeInfo with {
      briefly "Dispute"
      described as {
        |Dispute details.
      }
    }
  } with {
    briefly "Record dispute"
    described as {
      |Records chargeback dispute.
    }
  }
  command ResolveDispute is  {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment identifier.
      }
    }
    disputeId: UUID with {
      briefly "Dispute"
      described as {
        |Dispute to resolve.
      }
    }
    resolution: String(1,200) with {
      briefly "Resolution"
      described as {
        |Dispute resolution.
      }
    }
    wonDispute: Boolean with {
      briefly "Won"
      described as {
        |Dispute won.
      }
    }
  } with {
    briefly "Resolve dispute"
    described as {
      |Resolves chargeback dispute.
    }
  }
  // Events
  event PaymentAuthorized is  {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment info.
      }
    }
    card: CardDetails with {
      briefly "Card"
      described as {
        |Card used.
      }
    }
    result: AuthorizationResult with {
      briefly "Result"
      described as {
        |Auth result.
      }
    }
    authorizedAt: TimeStamp with {
      briefly "Authorized"
      described as {
        |Auth time.
      }
    }
  } with {
    briefly "Payment was authorized"
    described as {
      |Emitted when payment is authorized.
    }
  }
  event PaymentDeclined is  {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment info.
      }
    }
    result: AuthorizationResult with {
      briefly "Result"
      described as {
        |Decline result.
      }
    }
    declinedAt: TimeStamp with {
      briefly "Declined"
      described as {
        |Decline time.
      }
    }
  } with {
    briefly "Payment was declined"
    described as {
      |Emitted when payment is declined.
    }
  }
  event PaymentCaptured is  {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    capturedAmount: Decimal(12,2) with {
      briefly "Amount"
      described as {
        |Captured amount.
      }
    }
    capturedAt: TimeStamp with {
      briefly "Captured"
      described as {
        |Capture time.
      }
    }
  } with {
    briefly "Payment was captured"
    described as {
      |Emitted when payment is captured.
    }
  }
  event PaymentVoided is  {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Void reason.
      }
    }
    voidedAt: TimeStamp with {
      briefly "Voided"
      described as {
        |Void time.
      }
    }
  } with {
    briefly "Payment was voided"
    described as {
      |Emitted when payment is voided.
    }
  }
  event PaymentRefunded is  {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    refund: RefundInfo with {
      briefly "Refund"
      described as {
        |Refund details.
      }
    }
    refundedAt: TimeStamp with {
      briefly "Refunded"
      described as {
        |Refund time.
      }
    }
  } with {
    briefly "Payment was refunded"
    described as {
      |Emitted when payment is refunded.
    }
  }
  event PaymentSettled is  {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    settlement: SettlementInfo with {
      briefly "Settlement"
      described as {
        |Settlement info.
      }
    }
    settledAt: TimeStamp with {
      briefly "Settled"
      described as {
        |Settlement time.
      }
    }
  } with {
    briefly "Payment was settled"
    described as {
      |Emitted when payment is settled.
    }
  }
  event DisputeRecorded is  {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    dispute: DisputeInfo with {
      briefly "Dispute"
      described as {
        |Dispute details.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Dispute was recorded"
    described as {
      |Emitted when dispute is filed.
    }
  }
  event DisputeResolved is  {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    disputeId: UUID with {
      briefly "Dispute"
      described as {
        |Dispute ID.
      }
    }
    resolution: String(1,200) with {
      briefly "Resolution"
      described as {
        |Resolution.
      }
    }
    wonDispute: Boolean with {
      briefly "Won"
      described as {
        |Won dispute.
      }
    }
    resolvedAt: TimeStamp with {
      briefly "Resolved"
      described as {
        |Resolution time.
      }
    }
  } with {
    briefly "Dispute was resolved"
    described as {
      |Emitted when dispute is resolved.
    }
  }
  // State Records
  record AuthorizedStateData is  {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment info.
      }
    }
    card: CardDetails with {
      briefly "Card"
      described as {
        |Card details.
      }
    }
    status: PaymentStatus with {
      briefly "Status"
      described as {
        |Payment status.
      }
    }
    authResult: AuthorizationResult with {
      briefly "Auth"
      described as {
        |Auth result.
      }
    }
    authorizedAt: TimeStamp with {
      briefly "Authorized"
      described as {
        |Auth time.
      }
    }
  } with {
    briefly "Authorized state data"
    described as {
      |State data for authorized payment.
    }
  }
  record CapturedStateData is  {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment info.
      }
    }
    card: CardDetails with {
      briefly "Card"
      described as {
        |Card details.
      }
    }
    status: PaymentStatus with {
      briefly "Status"
      described as {
        |Payment status.
      }
    }
    capturedAmount: Decimal(12,2) with {
      briefly "Amount"
      described as {
        |Captured amount.
      }
    }
    refunds: RefundInfo+ with {
      briefly "Refunds"
      described as {
        |Payment refunds.
      }
    }
    disputes: DisputeInfo+ with {
      briefly "Disputes"
      described as {
        |Payment disputes.
      }
    }
    capturedAt: TimeStamp with {
      briefly "Captured"
      described as {
        |Capture time.
      }
    }
  } with {
    briefly "Captured state data"
    described as {
      |State data for captured payment.
    }
  }
  record SettledStateData is  {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment info.
      }
    }
    settlement: SettlementInfo with {
      briefly "Settlement"
      described as {
        |Settlement info.
      }
    }
    settledAt: TimeStamp with {
      briefly "Settled"
      described as {
        |Settlement time.
      }
    }
  } with {
    briefly "Settled state data"
    described as {
      |State data for settled payment.
    }
  }
  // Query/Result
  query GetPayment replies result PaymentResult is {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment to retrieve.
      }
    }
  } with {
    briefly "Get payment"
    described as {
      |Retrieves payment data by identifier.
    }
  }
  result PaymentResult is  {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment identifier.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment info.
      }
    }
  } with {
    briefly "Payment result"
    described as {
      |Payment data result.
    }
  }
  // States
  initial state AuthorizedState of record Payment.AuthorizedStateData is {
    initial handler AuthorizedStateInitHandler is {
      on init is {
        set state AuthorizedState to "initialize from PaymentAuthorized event"
      }
    } with {
      briefly "Authorized state init handler"
      described as {
        |Initializes the Authorized state.
      }
    }
  } with {
    briefly "Authorized state"
    described as {
      |Payment has been authorized.
    }
  }
  state CapturedState of record Payment.CapturedStateData is {
    initial handler CapturedStateInitHandler is {
      on init is {
        set state CapturedState to "initialize from PaymentCaptured event"
      }
    } with {
      briefly "Captured state init handler"
      described as {
        |Initializes the Captured state.
      }
    }
  } with {
    briefly "Captured state"
    described as {
      |Payment has been captured for settlement.
    }
  }
  state SettledState of record Payment.SettledStateData is {
    initial handler SettledStateInitHandler is {
      on init is {
        set state SettledState to "initialize from PaymentSettled event"
      }
    } with {
      briefly "Settled state init handler"
      described as {
        |Initializes the Settled state.
      }
    }
  } with {
    briefly "Settled state"
    described as {
      |Payment has been settled.
    }
  }
  // Handler
  handler PaymentHandler is {
    on declinePayment: command DeclinePayment is {
      yield event PaymentDeclined(paymentId = declinePayment.paymentId, info = prompt("the info of this payment declined"), result = declinePayment.result, declinedAt = prompt("the declined at of this payment declined"))
    }
    on authorizePayment: command AuthorizePayment is {
      morph entity PaymentContext.Payment to state PaymentContext.Payment.AuthorizedState with record Payment.AuthorizedStateData(paymentId = authorizePayment.paymentId, info = authorizePayment.info, card = authorizePayment.card, status = prompt("the status of this authorized state data"), authResult = prompt("the auth result of this authorized state data"), authorizedAt = prompt("the authorized at of this authorized state data"))
      tell event PaymentAuthorized(paymentId = authorizePayment.paymentId, info = authorizePayment.info, card = authorizePayment.card, result = prompt("the result of this payment authorized"), authorizedAt = prompt("the authorized at of this payment authorized")) to entity PaymentContext.Payment
    }
    on capturePayment: command CapturePayment is {
      morph entity PaymentContext.Payment to state PaymentContext.Payment.CapturedState with record Payment.CapturedStateData(paymentId = capturePayment.paymentId, info = prompt("the info of this captured state data"), card = prompt("the card of this captured state data"), status = prompt("the status of this captured state data"), capturedAmount = prompt("the captured amount of this captured state data"), refunds = prompt("the refunds of this captured state data"), disputes = prompt("the disputes of this captured state data"), capturedAt = prompt("the captured at of this captured state data"))
      tell event PaymentCaptured(paymentId = capturePayment.paymentId, capturedAmount = prompt("the captured amount of this payment captured"), capturedAt = prompt("the captured at of this payment captured")) to entity PaymentContext.Payment
    }
    on voidPayment: command VoidPayment is {
      tell event PaymentVoided(paymentId = voidPayment.paymentId, reason = voidPayment.reason, voidedAt = prompt("the voided at of this payment voided")) to entity PaymentContext.Payment
    }
    on refundPayment: command RefundPayment is {
      tell event PaymentRefunded(paymentId = refundPayment.paymentId, refund = refundPayment.refund, refundedAt = prompt("the refunded at of this payment refunded")) to entity PaymentContext.Payment
    }
    on settlePayment: command SettlePayment is {
      morph entity PaymentContext.Payment to state PaymentContext.Payment.SettledState with record Payment.SettledStateData(paymentId = settlePayment.paymentId, settlement = settlePayment.settlement, info = prompt("the info of this settled state data"), settledAt = prompt("the settled at of this settled state data"))
      tell event PaymentSettled(paymentId = settlePayment.paymentId, settlement = settlePayment.settlement, settledAt = prompt("the settled at of this payment settled")) to entity PaymentContext.Payment
    }
    on recordDispute: command RecordDispute is {
      tell event DisputeRecorded(paymentId = recordDispute.paymentId, dispute = recordDispute.dispute, recordedAt = prompt("the recorded at of this dispute recorded")) to entity PaymentContext.Payment
    }
    on resolveDispute: command ResolveDispute is {
      tell event DisputeResolved(paymentId = resolveDispute.paymentId, disputeId = resolveDispute.disputeId, resolution = resolveDispute.resolution, wonDispute = resolveDispute.wonDispute, resolvedAt = prompt("the resolved at of this dispute resolved")) to entity PaymentContext.Payment
    }
    on getPayment: query GetPayment is {
      reply result PaymentResult(paymentId = getPayment.paymentId, info = prompt("the info of this payment result"))
    }
      on disputeRecorded: event DisputeRecorded is {
      do "apply DisputeRecorded to the payment so it can be persisted and replayed"
    }
    on disputeResolved: event DisputeResolved is {
      do "apply DisputeResolved to the payment so it can be persisted and replayed"
    }
    on paymentAuthorized: event PaymentAuthorized is {
      do "apply PaymentAuthorized to the payment so it can be persisted and replayed"
    }
    on paymentCaptured: event PaymentCaptured is {
      do "apply PaymentCaptured to the payment so it can be persisted and replayed"
    }
    on paymentDeclined: event PaymentDeclined is {
      do "apply PaymentDeclined to the payment so it can be persisted and replayed"
    }
    on paymentRefunded: event PaymentRefunded is {
      do "apply PaymentRefunded to the payment so it can be persisted and replayed"
    }
    on paymentSettled: event PaymentSettled is {
      do "apply PaymentSettled to the payment so it can be persisted and replayed"
    }
    on paymentVoided: event PaymentVoided is {
      do "apply PaymentVoided to the payment so it can be persisted and replayed"
    }
} with {
    briefly "Processes payment commands"
    described as {
      | Handles payment lifecycle including authorization,
      | capture, refunds, and disputes.
    }
  }
} with {
  briefly "Payment aggregate"
  described as {
    | The Payment entity manages card transactions including
    | authorization, capture, settlement, and disputes.
  }
}
