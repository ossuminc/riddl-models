// Payment Processing - Payment Entity
event-sourced entity Payment as flow is {
  type PaymentCommand is one of {
    Payment.InitiatePayment or Payment.RecordAuthentication or Payment.AuthorizePayment or Payment.DeclinePayment or Payment.CapturePayment or Payment.VoidPayment or Payment.RefundPayment or Payment.SettlePayment or Payment.RecordDispute or Payment.ResolveDispute
  } with {
    briefly "Payment command alternation"
    described as {
      |Commands accepted by the Payment entity.
    }
  }
  inlet PaymentCommands is type PaymentCommand  outlet PaymentEvents2 is type PaymentEvent
  // Commands
  command InitiatePayment yields event PaymentInitiated is {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Identifier assigned to the payment as it enters.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |What is being paid, to whom, and how much.
      }
    }
    card: CardDetails with {
      briefly "Card"
      described as {
        |The instrument presented.
      }
    }
  } with {
    briefly "Initiate a payment"
    described as {
      |Take a payment request in. This is the FIRST thing that happens to a
      |payment and the model had no way to say it: every event began at
      |authorization, so the steps that must precede authorization -- 3-D
      |Secure, and the authorization request to the card network itself --
      |had nothing to fire on.
    }
  }
  command RecordAuthentication yields event PaymentAuthenticated is {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment the authentication belongs to.
      }
    }
    authenticationOutcome: String(1,50) with {
      briefly "Outcome"
      described as {
        |What the cardholder authentication came back as.
      }
    }
  } with {
    briefly "Record cardholder authentication"
    described as {
      |Record the outcome of 3-D Secure, which is what makes a payment fit to
      |send to the card network for authorization.
    }
  }
  command AuthorizePayment yields event PaymentAuthorized is {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |New payment identifier.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment information.
      }
    }
    card: CardDetails with {
      briefly "Card"
      described as {
        |Card details.
      }
    }
  } with {
    briefly "Authorize payment"
    described as {
      |Requests payment authorization.
    }
  }
  command DeclinePayment yields event PaymentDeclined is {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment to decline.
      }
    }
    result: AuthorizationResult with {
      briefly "Result"
      described as {
        |Decline result.
      }
    }
  } with {
    briefly "Decline payment"
    described as {
      |Records a declined payment authorization.
    }
  }
  command CapturePayment yields event PaymentCaptured is {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment to capture.
      }
    }
    captureAmount: Decimal(12,2)? with {
      briefly "Capture Amount"
      described as {
        |Capture amount.
      }
    }
  } with {
    briefly "Capture payment"
    described as {
      |Captures authorized payment.
    }
  }
  command VoidPayment yields event PaymentVoided is {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment to void.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Void reason.
      }
    }
  } with {
    briefly "Void payment"
    described as {
      |Voids authorized payment.
    }
  }
  command RefundPayment yields event PaymentRefunded is {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment to refund.
      }
    }
    refund: RefundInfo with {
      briefly "Refund"
      described as {
        |Refund details.
      }
    }
  } with {
    briefly "Refund payment"
    described as {
      |Refunds captured payment.
    }
  }
  command SettlePayment yields event PaymentSettled is {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment to settle.
      }
    }
    settlement: SettlementInfo with {
      briefly "Settlement"
      described as {
        |Settlement details.
      }
    }
  } with {
    briefly "Settle payment"
    described as {
      |Settles captured payment.
    }
  }
  command RecordDispute yields event DisputeRecorded is {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Disputed payment.
      }
    }
    dispute: DisputeInfo with {
      briefly "Dispute"
      described as {
        |Dispute details.
      }
    }
  } with {
    briefly "Record dispute"
    described as {
      |Records chargeback dispute.
    }
  }
  command ResolveDispute yields event DisputeResolved is {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment identifier.
      }
    }
    disputeId: UUID with {
      briefly "Dispute"
      described as {
        |Dispute to resolve.
      }
    }
    resolution: String(1,200) with {
      briefly "Resolution"
      described as {
        |Dispute resolution.
      }
    }
    wonDispute: Boolean with {
      briefly "Won"
      described as {
        |Dispute won.
      }
    }
  } with {
    briefly "Resolve dispute"
    described as {
      |Resolves chargeback dispute.
    }
  }
  // Events
  event PaymentInitiated is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment that has entered.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment info.
      }
    }
    card: CardDetails with {
      briefly "Card"
      described as {
        |Card presented.
      }
    }
  } with {
    briefly "Payment initiated"
    described as {
      |Emitted when a payment request enters, before any authentication or
      |authorization has been attempted.
    }
  }
  event PaymentAuthenticated is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment authenticated.
      }
    }
    authenticationOutcome: String(1,50) with {
      briefly "Outcome"
      described as {
        |Cardholder authentication outcome.
      }
    }
  } with {
    briefly "Payment authenticated"
    described as {
      |Emitted when cardholder authentication has come back, which is when
      |the payment may be presented to the card network.
    }
  }
  event PaymentAuthorized is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment info.
      }
    }
    card: CardDetails with {
      briefly "Card"
      described as {
        |Card used.
      }
    }
    result: AuthorizationResult with {
      briefly "Result"
      described as {
        |Auth result.
      }
    }
    authorizedAt: TimeStamp with {
      briefly "Authorized"
      described as {
        |Auth time.
      }
    }
  } with {
    briefly "Payment was authorized"
    described as {
      |Emitted when payment is authorized.
    }
  }
  event PaymentDeclined is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment info.
      }
    }
    result: AuthorizationResult with {
      briefly "Result"
      described as {
        |Decline result.
      }
    }
    declinedAt: TimeStamp with {
      briefly "Declined"
      described as {
        |Decline time.
      }
    }
  } with {
    briefly "Payment was declined"
    described as {
      |Emitted when payment is declined.
    }
  }
  event PaymentCaptured is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    capturedAmount: Decimal(12,2) with {
      briefly "Amount"
      described as {
        |Captured amount.
      }
    }
    capturedAt: TimeStamp with {
      briefly "Captured"
      described as {
        |Capture time.
      }
    }
  } with {
    briefly "Payment was captured"
    described as {
      |Emitted when payment is captured.
    }
  }
  event PaymentVoided is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Void reason.
      }
    }
    voidedAt: TimeStamp with {
      briefly "Voided"
      described as {
        |Void time.
      }
    }
  } with {
    briefly "Payment was voided"
    described as {
      |Emitted when payment is voided.
    }
  }
  event PaymentRefunded is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    refund: RefundInfo with {
      briefly "Refund"
      described as {
        |Refund details.
      }
    }
    refundedAt: TimeStamp with {
      briefly "Refunded"
      described as {
        |Refund time.
      }
    }
  } with {
    briefly "Payment was refunded"
    described as {
      |Emitted when payment is refunded.
    }
  }
  event PaymentSettled is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    settlement: SettlementInfo with {
      briefly "Settlement"
      described as {
        |Settlement info.
      }
    }
    settledAt: TimeStamp with {
      briefly "Settled"
      described as {
        |Settlement time.
      }
    }
  } with {
    briefly "Payment was settled"
    described as {
      |Emitted when payment is settled.
    }
  }
  event DisputeRecorded is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    dispute: DisputeInfo with {
      briefly "Dispute"
      described as {
        |Dispute details.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Dispute was recorded"
    described as {
      |Emitted when dispute is filed.
    }
  }
  event DisputeResolved is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    disputeId: UUID with {
      briefly "Dispute"
      described as {
        |Dispute ID.
      }
    }
    resolution: String(1,200) with {
      briefly "Resolution"
      described as {
        |Resolution.
      }
    }
    wonDispute: Boolean with {
      briefly "Won"
      described as {
        |Won dispute.
      }
    }
    resolvedAt: TimeStamp with {
      briefly "Resolved"
      described as {
        |Resolution time.
      }
    }
  } with {
    briefly "Dispute was resolved"
    described as {
      |Emitted when dispute is resolved.
    }
  }
  // State Records
  record AuthorizedStateData is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment info.
      }
    }
    card: CardDetails with {
      briefly "Card"
      described as {
        |Card details.
      }
    }
    status: PaymentStatus with {
      briefly "Status"
      described as {
        |Payment status.
      }
    }
    authResult: AuthorizationResult with {
      briefly "Auth"
      described as {
        |Auth result.
      }
    }
    authorizedAt: TimeStamp with {
      briefly "Authorized"
      described as {
        |Auth time.
      }
    }
    authenticationOutcome: String(1,50)? with {
      briefly "Authentication outcome"
    }
    declinedAt: TimeStamp? with {
      briefly "Declined at"
    }
    voidReason: String(1,200)? with {
      briefly "Void reason"
    }
    voidedAt: TimeStamp? with {
      briefly "Voided at"
    }
  } with {
    briefly "Authorized state data"
    described as {
      |State data for authorized payment.
    }
  }
  record CapturedStateData is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment info.
      }
    }
    card: CardDetails with {
      briefly "Card"
      described as {
        |Card details.
      }
    }
    status: PaymentStatus with {
      briefly "Status"
      described as {
        |Payment status.
      }
    }
    capturedAmount: Decimal(12,2) with {
      briefly "Amount"
      described as {
        |Captured amount.
      }
    }
    refunds: RefundInfo+ with {
      briefly "Refunds"
      described as {
        |Payment refunds.
      }
    }
    disputes: DisputeInfo+ with {
      briefly "Disputes"
      described as {
        |Payment disputes.
      }
    }
    capturedAt: TimeStamp with {
      briefly "Captured"
      described as {
        |Capture time.
      }
    }
    lastDisputeResolvedAt: TimeStamp? with {
      briefly "Last dispute resolved at"
    }
    lastRefundedAt: TimeStamp? with {
      briefly "Last refunded at"
    }
  } with {
    briefly "Captured state data"
    described as {
      |State data for captured payment.
    }
  }
  record SettledStateData is {
    paymentId: PaymentId with {
      briefly "Payment"
      described as {
        |Payment ID.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment info.
      }
    }
    settlement: SettlementInfo with {
      briefly "Settlement"
      described as {
        |Settlement info.
      }
    }
    settledAt: TimeStamp with {
      briefly "Settled"
      described as {
        |Settlement time.
      }
    }
  } with {
    briefly "Settled state data"
    described as {
      |State data for settled payment.
    }
  }
  // Query/Result
  query GetPayment replies result PaymentResult is {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment to retrieve.
      }
    }
  } with {
    briefly "Get payment"
    described as {
      |Retrieves payment data by identifier.
    }
  }
  result PaymentResult is {
    paymentId: PaymentId with {
      briefly "Payment ID"
      described as {
        |Payment identifier.
      }
    }
    info: PaymentInfo with {
      briefly "Info"
      described as {
        |Payment info.
      }
    }
  } with {
    briefly "Payment result"
    described as {
      |Payment data result.
    }
  }
  // States
  initial state AuthorizedState of record Payment.AuthorizedStateData is {
    initial handler AuthorizedStateInitHandler is {
      on init is {
        let paymentAuthorized: type PaymentAuthorized = prompt("the payment authorized that brings this payment into existence")
        yield paymentAuthorized
      }
    } with {
      briefly "Authorized state init handler"
      described as {
        |Initializes the Authorized state.
      }
    }
  } with {
    briefly "Authorized state"
    described as {
      |Payment has been authorized.
    }
  }
  state CapturedState of record Payment.CapturedStateData is {
    initial handler CapturedStateInitHandler is {
      on init is {
        let paymentCaptured: type PaymentCaptured = prompt("the payment captured that brings this payment into existence")
        yield paymentCaptured
      }
    } with {
      briefly "Captured state init handler"
      described as {
        |Initializes the Captured state.
      }
    }
  } with {
    briefly "Captured state"
    described as {
      |Payment has been captured for settlement.
    }
  }
  state SettledState of record Payment.SettledStateData is {
    initial handler SettledStateInitHandler is {
      on init is {
        let paymentSettled: type PaymentSettled = prompt("the payment settled that brings this payment into existence")
        yield paymentSettled
      }
    } with {
      briefly "Settled state init handler"
      described as {
        |Initializes the Settled state.
      }
    }
  } with {
    briefly "Settled state"
    described as {
      |Payment has been settled.
    }
  }
  // Handler
  handler PaymentHandler is {
    on initiatePayment: command InitiatePayment is {
      yield event PaymentInitiated(paymentId = initiatePayment.paymentId, info = initiatePayment.info, card = initiatePayment.card)
    }
    on recordAuthentication: command RecordAuthentication is {
      yield event PaymentAuthenticated(paymentId = recordAuthentication.paymentId, authenticationOutcome = recordAuthentication.authenticationOutcome)
    }
    on paymentInitiated: event PaymentInitiated is {
      set field Payment.AuthorizedState.info to paymentInitiated.info
      set field Payment.AuthorizedState.card to paymentInitiated.card
      set field Payment.AuthorizedState.status to PaymentStatus.Initiated
    }
    on paymentAuthenticated: event PaymentAuthenticated is {
      set field Payment.AuthorizedState.authenticationOutcome to paymentAuthenticated.authenticationOutcome
    }
    on declinePayment: command DeclinePayment is {
      yield event PaymentDeclined(paymentId = declinePayment.paymentId, info = prompt("the info of this payment declined"), result = declinePayment.result, declinedAt = prompt("the declined at of this payment declined"))
    }
    on authorizePayment: command AuthorizePayment is {
      yield event PaymentAuthorized(paymentId = authorizePayment.paymentId, info = authorizePayment.info, card = authorizePayment.card, result = prompt("the result of this payment authorized"), authorizedAt = prompt("the authorized at of this payment authorized"))
    }
    on capturePayment: command CapturePayment is {
      yield event PaymentCaptured(paymentId = capturePayment.paymentId, capturedAmount = prompt("the captured amount of this payment captured"), capturedAt = prompt("the captured at of this payment captured"))
    }
    on voidPayment: command VoidPayment is {
      yield event PaymentVoided(paymentId = voidPayment.paymentId, reason = voidPayment.reason, voidedAt = prompt("the voided at of this payment voided"))
    }
    on refundPayment: command RefundPayment is {
      yield event PaymentRefunded(paymentId = refundPayment.paymentId, refund = refundPayment.refund, refundedAt = prompt("the refunded at of this payment refunded"))
    }
    on settlePayment: command SettlePayment is {
      yield event PaymentSettled(paymentId = settlePayment.paymentId, settlement = settlePayment.settlement, settledAt = prompt("the settled at of this payment settled"))
    }
    on recordDispute: command RecordDispute is {
      yield event DisputeRecorded(paymentId = recordDispute.paymentId, dispute = recordDispute.dispute, recordedAt = prompt("the recorded at of this dispute recorded"))
    }
    on resolveDispute: command ResolveDispute is {
      yield event DisputeResolved(paymentId = resolveDispute.paymentId, disputeId = resolveDispute.disputeId, resolution = resolveDispute.resolution, wonDispute = resolveDispute.wonDispute, resolvedAt = prompt("the resolved at of this dispute resolved"))
    }
    on getPayment: query GetPayment is {
      reply result PaymentResult(paymentId = getPayment.paymentId, info = prompt("the info of this payment result"))
    }
    on disputeRecorded: event DisputeRecorded is {
      set field Payment.CapturedState.status to PaymentStatus.Disputed
      set field Payment.CapturedState.disputes to prompt("the disputes with dispute appended")
    }
    on disputeResolved: event DisputeResolved is {
      set field Payment.CapturedState.status to prompt("Captured when wonDispute, else Disputed")
      set field Payment.CapturedState.disputes to prompt("the disputes with disputeId marked resolved with resolution")
      set field Payment.CapturedState.lastDisputeResolvedAt to disputeResolved.resolvedAt
    }
    on paymentAuthorized: event PaymentAuthorized is {
      morph entity PaymentContext.Payment to state PaymentContext.Payment.AuthorizedState with record Payment.AuthorizedStateData(paymentId = paymentAuthorized.paymentId, info = paymentAuthorized.info, card = paymentAuthorized.card, status = prompt("the status of this authorized state data"), authResult = prompt("the auth result of this authorized state data"), authorizedAt = prompt("the authorized at of this authorized state data"), authenticationOutcome = empty, declinedAt = empty, voidReason = empty, voidedAt = empty)
    }
    on paymentCaptured: event PaymentCaptured is {
      morph entity PaymentContext.Payment to state PaymentContext.Payment.CapturedState with record Payment.CapturedStateData(paymentId = paymentCaptured.paymentId, info = prompt("the info of this captured state data"), card = prompt("the card of this captured state data"), status = prompt("the status of this captured state data"), capturedAmount = prompt("the captured amount of this captured state data"), refunds = prompt("the refunds of this captured state data"), disputes = prompt("the disputes of this captured state data"), capturedAt = prompt("the captured at of this captured state data"), lastDisputeResolvedAt = empty, lastRefundedAt = empty)
    }
    on paymentDeclined: event PaymentDeclined is {
      set field Payment.AuthorizedState.status to PaymentStatus.Declined
      set field Payment.AuthorizedState.authResult to paymentDeclined.result
      set field Payment.AuthorizedState.declinedAt to paymentDeclined.declinedAt
    }
    on paymentRefunded: event PaymentRefunded is {
      set field Payment.CapturedState.status to PaymentStatus.Refunded
      set field Payment.CapturedState.refunds to prompt("the refunds with refund appended")
      set field Payment.CapturedState.lastRefundedAt to paymentRefunded.refundedAt
    }
    on paymentSettled: event PaymentSettled is {
      morph entity PaymentContext.Payment to state PaymentContext.Payment.SettledState with record Payment.SettledStateData(paymentId = paymentSettled.paymentId, settlement = paymentSettled.settlement, info = prompt("the info of this settled state data"), settledAt = prompt("the settled at of this settled state data"))
    }
    on paymentVoided: event PaymentVoided is {
      set field Payment.AuthorizedState.status to PaymentStatus.Voided
      set field Payment.AuthorizedState.voidReason to paymentVoided.reason
      set field Payment.AuthorizedState.voidedAt to paymentVoided.voidedAt
    }
  } with {
    briefly "Processes payment commands"
    described as {
      | Handles payment lifecycle including authorization,
      | capture, refunds, and disputes.
    }
  }
} with {
  briefly "Payment aggregate"
  described as {
    | The Payment entity manages card transactions including
    | authorization, capture, settlement, and disputes.
  }
}
