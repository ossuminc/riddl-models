// Merchant Acquiring - Merchant Context
context MerchantContext is {
  adaptor FromCreditBureauService from context CreditBureauService is { 
    handler FromCreditBureauServiceHandler is {
      on event CreditBureauService.CreditReportReceived is {
        do "the model receives credit report received"
      }
      on other is {
        error "Unexpected message for adaptor FromCreditBureauService"
      }
    } with {
      briefly "from credit bureau service"
      described as {
        |Carries messages from the external CreditBureauService.
      }
    }
  } with {
    briefly "CreditBureauService integration"
    described as {
      |The model's side of the CreditBureauService conversation.
    }
  }
  adaptor ToCreditBureauService to context CreditBureauService is { 
    handler ToCreditBureauServiceHandler is {
      on command CreditBureauService.CheckBusinessCredit is {
        do "the model sends check business credit"
      }
      on other is {
        error "Unexpected message for adaptor ToCreditBureauService"
      }
    } with {
      briefly "to credit bureau service"
      described as {
        |Carries messages to the external CreditBureauService.
      }
    }
  } with {
    briefly "CreditBureauService integration"
    described as {
      |The model's side of the CreditBureauService conversation.
    }
  }
  adaptor FromDocumentStorageService from context DocumentStorageService is { 
    handler FromDocumentStorageServiceHandler is {
      on event DocumentStorageService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentStorageService"
      }
    } with {
      briefly "from document storage service"
      described as {
        |Carries messages from the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor ToDocumentStorageService to context DocumentStorageService is { 
    handler ToDocumentStorageServiceHandler is {
      on command DocumentStorageService.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentStorageService"
      }
    } with {
      briefly "to document storage service"
      described as {
        |Carries messages to the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor FromKYBService from context KYBService is { 
    handler FromKYBServiceHandler is {
      on event KYBService.BusinessVerified is {
        do "the model receives business verified"
      }
      on other is {
        error "Unexpected message for adaptor FromKYBService"
      }
    } with {
      briefly "from kyb service"
      described as {
        |Carries messages from the external KYBService.
      }
    }
  } with {
    briefly "KYBService integration"
    described as {
      |The model's side of the KYBService conversation.
    }
  }
  adaptor ToKYBService to context KYBService is { 
    handler ToKYBServiceHandler is {
      on command KYBService.VerifyBusiness is {
        do "the model sends verify business"
      }
      on other is {
        error "Unexpected message for adaptor ToKYBService"
      }
    } with {
      briefly "to kyb service"
      described as {
        |Carries messages to the external KYBService.
      }
    }
  } with {
    briefly "KYBService integration"
    described as {
      |The model's side of the KYBService conversation.
    }
  }
  adaptor FromMATCHService from context MATCHService is { 
    handler FromMATCHServiceHandler is {
      on event MATCHService.AddedToMATCH is {
        do "the model receives added to match"
      }
      on event MATCHService.MATCHResultReceived is {
        do "the model receives match result received"
      }
      on other is {
        error "Unexpected message for adaptor FromMATCHService"
      }
    } with {
      briefly "from match service"
      described as {
        |Carries messages from the external MATCHService.
      }
    }
  } with {
    briefly "MATCHService integration"
    described as {
      |The model's side of the MATCHService conversation.
    }
  }
  adaptor ToMATCHService to context MATCHService is { 
    handler ToMATCHServiceHandler is {
      on command MATCHService.AddToMATCH is {
        do "the model sends add to match"
      }
      on command MATCHService.CheckMATCH is {
        do "the model sends check match"
      }
      on other is {
        error "Unexpected message for adaptor ToMATCHService"
      }
    } with {
      briefly "to match service"
      described as {
        |Carries messages to the external MATCHService.
      }
    }
  } with {
    briefly "MATCHService integration"
    described as {
      |The model's side of the MATCHService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendMerchantNotification is {
        do "the model sends send merchant notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromProcessorGatewayService from context ProcessorGatewayService is { 
    handler FromProcessorGatewayServiceHandler is {
      on event ProcessorGatewayService.MerchantAccountCreated is {
        do "the model receives merchant account created"
      }
      on other is {
        error "Unexpected message for adaptor FromProcessorGatewayService"
      }
    } with {
      briefly "from processor gateway service"
      described as {
        |Carries messages from the external ProcessorGatewayService.
      }
    }
  } with {
    briefly "ProcessorGatewayService integration"
    described as {
      |The model's side of the ProcessorGatewayService conversation.
    }
  }
  adaptor ToProcessorGatewayService to context ProcessorGatewayService is { 
    handler ToProcessorGatewayServiceHandler is {
      on command ProcessorGatewayService.SetupMerchantAccount is {
        do "the model sends setup merchant account"
      }
      on other is {
        error "Unexpected message for adaptor ToProcessorGatewayService"
      }
    } with {
      briefly "to processor gateway service"
      described as {
        |Carries messages to the external ProcessorGatewayService.
      }
    }
  } with {
    briefly "ProcessorGatewayService integration"
    described as {
      |The model's side of the ProcessorGatewayService conversation.
    }
  }
  include "types.riddl"
  include "Merchant.riddl"
  // Repository for merchant persistence
  repository MerchantRepository as merge is {
    inlet MerchantRepositoryFromMerchant is type MerchantEvent    inlet MerchantRepositoryFromMerchantAnalytics is type MerchantEvent    outlet MerchantRepositoryResponses is type Merchant.MerchantResult
    record StoredMerchant is  {
      merchantId: MerchantId with {
        briefly "merchantId"
        described as {
          |The merchantId column of the stored merchant row.
        }
      }
      business: BusinessInfo with {
        briefly "business"
        described as {
          |The business column of the stored merchant row.
        }
      }
    } with {
      briefly "Stored merchant row"
      described as {
        |The persistence shape of merchant data as this repository stores it.
      }
    }
    schema MerchantData is relational
      of merchants as type StoredMerchant
        index on field StoredMerchant.merchantId
        index on field StoredMerchant.business.legalName
 with {
      briefly "Merchant data schema"
      described as {
        |The relational schema holding merchant data for the MerchantRepository.
      }
    }
    handler MerchantPersistence is {
      on query GetMerchantStats is {
        let merchantStatsView: type MerchantStatsView = prompt("read the merchant stats projection")
        reply merchantStatsView
      }
      on submitApplication: command Merchant.SubmitApplication is {
        tell event Merchant.ApplicationSubmitted(merchantId = submitApplication.merchantId, business = submitApplication.business, contact = submitApplication.contact) to entity MerchantContext.Merchant
      }
      on approveApplication: command Merchant.ApproveApplication is {
        tell event Merchant.ApplicationApproved(merchantId = approveApplication.merchantId, decision = approveApplication.decision, pricing = approveApplication.pricing) to entity MerchantContext.Merchant
      }
      on declineApplication: command Merchant.DeclineApplication is {
        tell event Merchant.ApplicationDeclined(merchantId = declineApplication.merchantId, reason = declineApplication.reason) to entity MerchantContext.Merchant
      }
      on activateMerchant: command Merchant.ActivateMerchant is {
        tell event Merchant.MerchantActivated(merchantId = activateMerchant.merchantId, activatedBy = activateMerchant.activatedBy) to entity MerchantContext.Merchant
      }
      on updatePricing: command Merchant.UpdatePricing is {
        tell event Merchant.PricingUpdated(merchantId = updatePricing.merchantId, newPricing = updatePricing.newPricing, effectiveDate = updatePricing.effectiveDate) to entity MerchantContext.Merchant
      }
      on suspendMerchant: command Merchant.SuspendMerchant is {
        tell event Merchant.MerchantSuspended(merchantId = suspendMerchant.merchantId, reason = suspendMerchant.reason) to entity MerchantContext.Merchant
      }
      on reactivateMerchant: command Merchant.ReactivateMerchant is {
        tell event Merchant.MerchantReactivated(merchantId = reactivateMerchant.merchantId, notes = reactivateMerchant.notes) to entity MerchantContext.Merchant
      }
      on terminateMerchant: command Merchant.TerminateMerchant is {
        tell event Merchant.MerchantTerminated(merchantId = terminateMerchant.merchantId, reason = terminateMerchant.reason) to entity MerchantContext.Merchant
      }
    } with {
      briefly "Persists merchant commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Merchant data persistence"
    described as {
      | The MerchantRepository provides persistent storage for
      | merchant accounts and underwriting data.
    }
  }
  // Projector for merchant analytics
  query GetMerchantStats is  {
    merchantStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which merchant stats to retrieve.
      }
    }
  } with {
    briefly "Get merchant stats"
    described as {
      |Retrieves the merchant stats projection.
    }
  }
  result MerchantStatsView is  {
    merchantStats: MerchantAnalytics.MerchantStats with {
      briefly "Merchant stats"
      described as {
        |The merchant stats being returned.
      }
    }
  } with {
    briefly "Merchant stats view"
    described as {
      |Read model view carrying the merchant stats projection.
    }
  }
  projector MerchantAnalytics as flow is {
    updates repository MerchantContext.MerchantRepository
    inlet MerchantAnalyticsFromMerchant is type MerchantEvent    outlet MerchantAnalyticsOut is type MerchantEvent
    record MerchantStats is  {
      totalApplications: Natural with {
        briefly "Applications"
        described as {
          |Total applications.
        }
      }
      approvalRate: Decimal(5,4) with {
        briefly "Approval rate"
        described as {
          |Approval rate.
        }
      }
      activeMerchants: Natural with {
        briefly "Active"
        described as {
          |Active merchants.
        }
      }
      avgMonthlyVolume: Decimal(15,2) with {
        briefly "Avg volume"
        described as {
          |Average monthly volume.
        }
      }
      avgRiskScore: Decimal(5,4) with {
        briefly "Avg risk"
        described as {
          |Average risk level.
        }
      }
      chargebackRate: Decimal(5,4) with {
        briefly "Chargeback rate"
        described as {
          |Portfolio chargeback rate.
        }
      }
    } with {
      briefly "Merchant statistics"
      described as {
        |Merchant portfolio metrics.
      }
    }
    handler AnalyticsHandler is {
      on applicationSubmitted: event Merchant.ApplicationSubmitted is {
        tell applicationSubmitted to repository MerchantContext.MerchantRepository
      }
      on applicationApproved: event Merchant.ApplicationApproved is {
        tell applicationApproved to repository MerchantContext.MerchantRepository
      }
      on merchantActivated: event Merchant.MerchantActivated is {
        tell merchantActivated to repository MerchantContext.MerchantRepository
      }
      on merchantTerminated: event Merchant.MerchantTerminated is {
        tell merchantTerminated to repository MerchantContext.MerchantRepository
      }
    } with {
      briefly "Maintains merchant analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Merchant analytics projections"
    described as {
      |Maintains merchant portfolio analytics data.
    }
  }
  processor MerchantEventSource as source is {
    outlet MerchantEvents is type MerchantEvent
    handler MerchantEventEmitter is {
      on init is {
        tell command InitializeMerchant to entity MerchantContext.Merchant
      }
      on other is {
        error "Unexpected message for source MerchantEventSource"
      }
      on applicationSubmitted: event Merchant.ApplicationSubmitted is {
        send applicationSubmitted to outlet MerchantEvents
      }
      on merchantActivated: event Merchant.MerchantActivated is {
        send merchantActivated to outlet MerchantEvents
      }
      on merchantSuspended: event Merchant.MerchantSuspended is {
        send merchantSuspended to outlet MerchantEvents
      }
      on merchantTerminated: event Merchant.MerchantTerminated is {
        send merchantTerminated to outlet MerchantEvents
      }
    } with {
      briefly "Merchant event emitter"
      described as {
        |Emits merchant lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Merchant event source"
    described as {
      |Publishes merchant entity events for streaming.
    }
  }
  processor MerchantEventSink as sink is {
    inlet IncomingMerchantEvents is type MerchantEvent    handler MerchantEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink MerchantEventSink"
      }
      on applicationSubmitted: event Merchant.ApplicationSubmitted is {
        tell applicationSubmitted to repository MerchantContext.MerchantRepository
      }
      on merchantTerminated: event Merchant.MerchantTerminated is {
        tell merchantTerminated to repository MerchantContext.MerchantRepository
      }
    } with {
      briefly "Merchant event receiver"
      described as {
        |Receives merchant events and persists them.
      }
    }
  } with {
    briefly "Merchant event sink"
    described as {
      |Receives merchant events from the streaming topology.
    }
  }
  connector MerchantEventPipeline is from outlet MerchantContext.MerchantEventSource.MerchantEvents to inlet MerchantContext.MerchantEventSink.IncomingMerchantEvents with {
    briefly "Merchant event pipeline"
    described as {
      |Wires merchant events from source to sink.
    }
  }
  processor MerchantEventSplit as split is {
    inlet MerchantEventSplitIn is type MerchantEvent    outlet MerchantEventSplitToMerchantRepository is type MerchantEvent
    outlet MerchantEventSplitToMerchantAnalytics is type MerchantEvent
    handler MerchantEventSplitHandler is {
      on applicationSubmitted: event Merchant.ApplicationSubmitted is {
        send applicationSubmitted to outlet MerchantEventSplitToMerchantRepository
        send applicationSubmitted to outlet MerchantEventSplitToMerchantAnalytics
        tell applicationSubmitted to entity MerchantContext.Merchant
      }
      on applicationApproved: event Merchant.ApplicationApproved is {
        send applicationApproved to outlet MerchantEventSplitToMerchantRepository
        send applicationApproved to outlet MerchantEventSplitToMerchantAnalytics
        tell applicationApproved to entity MerchantContext.Merchant
      }
      on applicationDeclined: event Merchant.ApplicationDeclined is {
        send applicationDeclined to outlet MerchantEventSplitToMerchantRepository
        send applicationDeclined to outlet MerchantEventSplitToMerchantAnalytics
        tell applicationDeclined to entity MerchantContext.Merchant
      }
      on merchantActivated: event Merchant.MerchantActivated is {
        send merchantActivated to outlet MerchantEventSplitToMerchantRepository
        send merchantActivated to outlet MerchantEventSplitToMerchantAnalytics
        tell merchantActivated to entity MerchantContext.Merchant
      }
      on pricingUpdated: event Merchant.PricingUpdated is {
        send pricingUpdated to outlet MerchantEventSplitToMerchantRepository
        send pricingUpdated to outlet MerchantEventSplitToMerchantAnalytics
        tell pricingUpdated to entity MerchantContext.Merchant
      }
      on merchantSuspended: event Merchant.MerchantSuspended is {
        send merchantSuspended to outlet MerchantEventSplitToMerchantRepository
        send merchantSuspended to outlet MerchantEventSplitToMerchantAnalytics
        tell merchantSuspended to entity MerchantContext.Merchant
      }
      on merchantReactivated: event Merchant.MerchantReactivated is {
        send merchantReactivated to outlet MerchantEventSplitToMerchantRepository
        send merchantReactivated to outlet MerchantEventSplitToMerchantAnalytics
        tell merchantReactivated to entity MerchantContext.Merchant
      }
      on merchantTerminated: event Merchant.MerchantTerminated is {
        send merchantTerminated to outlet MerchantEventSplitToMerchantRepository
        send merchantTerminated to outlet MerchantEventSplitToMerchantAnalytics
        tell merchantTerminated to entity MerchantContext.Merchant
      }
      on other is {
        error "Unexpected message for processor MerchantEventSplit"
      }
    } with {
      briefly "Merchant event fan-out handler"
      described as {
        |Delivers each Merchant event to all of its consumers.
      }
    }
  } with {
    briefly "Merchant event fan-out"
    described as {
      |Fans Merchant events out to the repository and projectors.
    }
  }
  connector 'MerchantEvent Stream' is from outlet MerchantContext.Merchant.MerchantEvents2 to inlet MerchantContext.MerchantEventSplit.MerchantEventSplitIn with {
    briefly "Merchant events, fanned out to storage and read models"
  }
  connector 'MerchantEvent Storage' is from outlet MerchantContext.MerchantEventSplit.MerchantEventSplitToMerchantRepository to inlet MerchantContext.MerchantRepository.MerchantRepositoryFromMerchant with {
    briefly "Merchant events on their way to storage"
  }
  connector 'MerchantAnalytics Feed' is from outlet MerchantContext.MerchantEventSplit.MerchantEventSplitToMerchantAnalytics to inlet MerchantContext.MerchantAnalytics.MerchantAnalyticsFromMerchant with {
    briefly "Merchant events feeding the MerchantAnalytics projection"
  }
  connector 'MerchantAnalytics Storage' is from outlet MerchantContext.MerchantAnalytics.MerchantAnalyticsOut to inlet MerchantContext.MerchantRepository.MerchantRepositoryFromMerchantAnalytics with {
    briefly "The MerchantAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for merchant acquiring"
  described as {
    | The MerchantContext is the bounded context for merchant
    | onboarding, underwriting, and account management.
  }
}
