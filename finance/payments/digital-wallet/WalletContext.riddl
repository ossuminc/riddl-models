// Digital Wallet - Wallet Context
context WalletContext is {
  adaptor FromBankTransferService from context BankTransferService is {
    handler FromBankTransferServiceHandler is {
      on event BankTransferService.ACHCompleted is {
        do "the model receives ach completed"
      }
      on event BankTransferService.ACHInitiated is {
        do "the model receives ach initiated"
      }
      on other is {
        error "Unexpected message for adaptor FromBankTransferService"
      }
    } with {
      briefly "from bank transfer service"
      described as {
        |Carries messages from the external BankTransferService.
      }
    }
  } with {
      briefly "BankTransferService integration"
    described as {
      |The model's side of the BankTransferService conversation.
    }
  }
  adaptor ToBankTransferService to context BankTransferService is {
    handler ToBankTransferServiceHandler is {
      on command BankTransferService.InitiateACH is {
        do "the model sends initiate ach"
      }
      on other is {
        error "Unexpected message for adaptor ToBankTransferService"
      }
    } with {
      briefly "to bank transfer service"
      described as {
        |Carries messages to the external BankTransferService.
      }
    }
  } with {
      briefly "BankTransferService integration"
    described as {
      |The model's side of the BankTransferService conversation.
    }
  }
  adaptor FromFraudService from context FraudService is {
    handler FromFraudServiceHandler is {
      on event FraudService.FraudScreened is {
        do "the model receives fraud screened"
      }
      on other is {
        error "Unexpected message for adaptor FromFraudService"
      }
    } with {
      briefly "from fraud service"
      described as {
        |Carries messages from the external FraudService.
      }
    }
  } with {
      briefly "FraudService integration"
    described as {
      |The model's side of the FraudService conversation.
    }
  }
  adaptor ToFraudService to context FraudService is {
    handler ToFraudServiceHandler is {
      on command FraudService.ScreenTransaction is {
        do "the model sends screen transaction"
      }
      on other is {
        error "Unexpected message for adaptor ToFraudService"
      }
    } with {
      briefly "to fraud service"
      described as {
        |Carries messages to the external FraudService.
      }
    }
  } with {
      briefly "FraudService integration"
    described as {
      |The model's side of the FraudService conversation.
    }
  }
  adaptor FromIdentityService from context IdentityService is {
    handler FromIdentityServiceHandler is {
      on event IdentityService.IdentityVerified is {
        do "the model receives identity verified"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityService"
      }
    } with {
      briefly "from identity service"
      described as {
        |Carries messages from the external IdentityService.
      }
    }
  } with {
      briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor ToIdentityService to context IdentityService is {
    handler ToIdentityServiceHandler is {
      on command IdentityService.VerifyIdentity is {
        do "the model sends verify identity"
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityService"
      }
    } with {
      briefly "to identity service"
      described as {
        |Carries messages to the external IdentityService.
      }
    }
  } with {
      briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is {
    handler FromNotificationServiceHandler is {
      on event NotificationService.AlertSent is {
        do "the model receives alert sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is {
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendTransactionAlert is {
        do "the model sends send transaction alert"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessorService from context PaymentProcessorService is {
    handler FromPaymentProcessorServiceHandler is {
      on event PaymentProcessorService.PaymentProcessed is {
        do "the model receives payment processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessorService"
      }
    } with {
      briefly "from payment processor service"
      described as {
        |Carries messages from the external PaymentProcessorService.
      }
    }
  } with {
      briefly "PaymentProcessorService integration"
    described as {
      |The model's side of the PaymentProcessorService conversation.
    }
  }
  adaptor ToPaymentProcessorService to context PaymentProcessorService is {
    handler ToPaymentProcessorServiceHandler is {
      on command PaymentProcessorService.ProcessPayment is {
        do "the model sends process payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessorService"
      }
    } with {
      briefly "to payment processor service"
      described as {
        |Carries messages to the external PaymentProcessorService.
      }
    }
  } with {
      briefly "PaymentProcessorService integration"
    described as {
      |The model's side of the PaymentProcessorService conversation.
    }
  }
  adaptor FromTokenizationService from context TokenizationService is {
    handler FromTokenizationServiceHandler is {
      on event TokenizationService.CardTokenized is {
        do "the model receives card tokenized"
      }
      on other is {
        error "Unexpected message for adaptor FromTokenizationService"
      }
    } with {
      briefly "from tokenization service"
      described as {
        |Carries messages from the external TokenizationService.
      }
    }
  } with {
      briefly "TokenizationService integration"
    described as {
      |The model's side of the TokenizationService conversation.
    }
  }
  adaptor ToTokenizationService to context TokenizationService is {
    handler ToTokenizationServiceHandler is {
      on command TokenizationService.TokenizeCard is {
        do "the model sends tokenize card"
      }
      on other is {
        error "Unexpected message for adaptor ToTokenizationService"
      }
    } with {
      briefly "to tokenization service"
      described as {
        |Carries messages to the external TokenizationService.
      }
    }
  } with {
      briefly "TokenizationService integration"
    described as {
      |The model's side of the TokenizationService conversation.
    }
  }
  include "types.riddl"
  include "Wallet.riddl"
  // Repository for wallet persistence
  repository WalletRepository is {
    inlet WalletRepositoryFromWallet is type WalletEvent
    inlet WalletRepositoryFromWalletAnalytics is type WalletEvent
    outlet WalletRepositoryResponses is type Wallet.WalletResult
    record StoredWallet is {
      walletId: WalletId with {
        briefly "walletId"
        described as {
          |The walletId column of the stored wallet row.
        }
      }
      userId: WalletUserId with {
        briefly "userId"
        described as {
          |The userId column of the stored wallet row.
        }
      }
    } with {
      briefly "Stored wallet row"
      described as {
        |The persistence shape of wallet data as this repository stores it.
      }
    }
    schema WalletData is relational
      of wallets as type StoredWallet
        index on field StoredWallet.walletId
        index on field StoredWallet.userId
      with {
      briefly "Wallet data schema"
      described as {
        |The relational schema holding wallet data for the WalletRepository.
      }
    }

    handler WalletPersistence is {
      on command Wallet.CreateWallet is {
        tell event Wallet.WalletCreated to entity
          WalletContext.Wallet
      }
      on command Wallet.AddPaymentMethod is {
        tell event Wallet.PaymentMethodAdded to entity
          WalletContext.Wallet
      }
      on command Wallet.RemovePaymentMethod is {
        tell event Wallet.PaymentMethodRemoved to entity
          WalletContext.Wallet
      }
      on command Wallet.SetDefaultMethod is {
        tell event Wallet.DefaultMethodSet to entity
          WalletContext.Wallet
      }
      on command Wallet.TopUpBalance is {
        tell event Wallet.BalanceToppedUp to entity
          WalletContext.Wallet
      }
      on command Wallet.MakePayment is {
        tell event Wallet.PaymentMade to entity
          WalletContext.Wallet
      }
      on command Wallet.TransferFunds is {
        tell event Wallet.FundsTransferred to entity
          WalletContext.Wallet
      }
      on command Wallet.ReceiveFunds is {
        tell event Wallet.FundsReceived to entity
          WalletContext.Wallet
      }
      on command Wallet.WithdrawFunds is {
        tell event Wallet.FundsWithdrawn to entity
          WalletContext.Wallet
      }
      on command Wallet.SuspendWallet is {
        tell event Wallet.WalletSuspended to entity
          WalletContext.Wallet
      }
      on command Wallet.ReactivateWallet is {
        tell event Wallet.WalletReactivated to entity
          WalletContext.Wallet
      }
      on command Wallet.CloseWallet is {
        tell event Wallet.WalletClosed to entity
          WalletContext.Wallet
      }
    } with {
      briefly "Persists wallet commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Wallet data persistence"
    described as {
      | The WalletRepository provides persistent storage for
      | wallet accounts, transactions, and payment methods.
    }
  }
  // Projector for wallet analytics
  projector WalletAnalytics is {
    inlet WalletAnalyticsFromWallet is type WalletEvent
    outlet WalletAnalyticsOut is type WalletEvent
    updates repository WalletContext.WalletRepository
    record WalletStats is  {
      totalWallets: Natural with {
        briefly "Wallets"
        described as {
          |Total wallets.
        }
      }
      activeWallets: Natural with {
        briefly "Active"
        described as {
          |Active wallets.
        }
      }
      totalBalance: Decimal(18,2) with {
        briefly "Balance"
        described as {
          |Total platform balance.
        }
      }
      dailyTransactions: Natural with {
        briefly "Daily"
        described as {
          |Daily transactions.
        }
      }
      dailyVolume: Decimal(15,2) with {
        briefly "Volume"
        described as {
          |Daily transaction volume.
        }
      }
      avgTransactionSize: Decimal(10,2) with {
        briefly "Avg size"
        described as {
          |Average transaction.
        }
      }
    } with {
      briefly "Wallet statistics"
      described as {
        |Platform wallet metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Wallet.WalletCreated is {
        tell event Wallet.WalletCreated to repository
          WalletContext.WalletRepository
      }
      on event Wallet.PaymentMade is {
        tell event Wallet.PaymentMade to repository
          WalletContext.WalletRepository
      }
      on event Wallet.FundsTransferred is {
        tell event Wallet.FundsTransferred to repository
          WalletContext.WalletRepository
      }
      on event Wallet.BalanceToppedUp is {
        tell event Wallet.BalanceToppedUp to repository
          WalletContext.WalletRepository
      }
    } with {
      briefly "Maintains wallet analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Wallet analytics projections"
    described as {
      |Maintains wallet platform analytics data.
    }
  }
  processor WalletEventSource as source is {
    outlet WalletEvents is type WalletEvent
    handler WalletEventEmitter is {
      on init is {
        tell command InitializeWallet to entity
          WalletContext.Wallet
      }
      on other is {
        error "Unexpected message for source WalletEventSource"
      }
      on event Wallet.WalletCreated is {
        send event Wallet.WalletCreated to outlet WalletEvents
      }
      on event Wallet.PaymentMade is {
        send event Wallet.PaymentMade to outlet WalletEvents
      }
      on event Wallet.FundsTransferred is {
        send event Wallet.FundsTransferred to outlet WalletEvents
      }
      on event Wallet.WalletSuspended is {
        send event Wallet.WalletSuspended to outlet WalletEvents
      }
      on event Wallet.WalletClosed is {
        send event Wallet.WalletClosed to outlet WalletEvents
      }
    } with {
      briefly "Wallet event emitter"
      described as {
        |Emits wallet lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Wallet event source"
    described as {
      |Publishes wallet entity events for streaming.
    }
  }
  processor WalletEventSink as sink is {
    inlet IncomingWalletEvents is type WalletEvent
    handler WalletEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink WalletEventSink"
      }
      on event Wallet.WalletCreated is {
        tell event Wallet.WalletCreated to repository
          WalletContext.WalletRepository
      }
      on event Wallet.WalletClosed is {
        tell event Wallet.WalletClosed to repository
          WalletContext.WalletRepository
      }
    } with {
      briefly "Wallet event receiver"
      described as {
        |Receives wallet events and persists them.
      }
    }
  } with {
    briefly "Wallet event sink"
    described as {
      |Receives wallet events from the streaming topology.
    }
  }
  connector WalletEventPipeline is {
    from outlet WalletContext.WalletEventSource.WalletEvents
      to inlet WalletContext.WalletEventSink.IncomingWalletEvents
  } with {
    briefly "Wallet event pipeline"
    described as {
      |Wires wallet events from source to sink.
    }
  }
  processor WalletEventSplit is {
    inlet WalletEventSplitIn is type WalletEvent
    outlet WalletEventSplitToWalletRepository is type WalletEvent
    outlet WalletEventSplitToWalletAnalytics is type WalletEvent
    handler WalletEventSplitHandler is {
      on event Wallet.WalletCreated is {
        send event Wallet.WalletCreated to outlet WalletEventSplitToWalletRepository
        send event Wallet.WalletCreated to outlet WalletEventSplitToWalletAnalytics
        tell event Wallet.WalletCreated to entity WalletContext.Wallet
      }
      on event Wallet.PaymentMethodAdded is {
        send event Wallet.PaymentMethodAdded to outlet WalletEventSplitToWalletRepository
        send event Wallet.PaymentMethodAdded to outlet WalletEventSplitToWalletAnalytics
        tell event Wallet.PaymentMethodAdded to entity WalletContext.Wallet
      }
      on event Wallet.PaymentMethodRemoved is {
        send event Wallet.PaymentMethodRemoved to outlet WalletEventSplitToWalletRepository
        send event Wallet.PaymentMethodRemoved to outlet WalletEventSplitToWalletAnalytics
        tell event Wallet.PaymentMethodRemoved to entity WalletContext.Wallet
      }
      on event Wallet.DefaultMethodSet is {
        send event Wallet.DefaultMethodSet to outlet WalletEventSplitToWalletRepository
        send event Wallet.DefaultMethodSet to outlet WalletEventSplitToWalletAnalytics
        tell event Wallet.DefaultMethodSet to entity WalletContext.Wallet
      }
      on event Wallet.BalanceToppedUp is {
        send event Wallet.BalanceToppedUp to outlet WalletEventSplitToWalletRepository
        send event Wallet.BalanceToppedUp to outlet WalletEventSplitToWalletAnalytics
        tell event Wallet.BalanceToppedUp to entity WalletContext.Wallet
      }
      on event Wallet.PaymentMade is {
        send event Wallet.PaymentMade to outlet WalletEventSplitToWalletRepository
        send event Wallet.PaymentMade to outlet WalletEventSplitToWalletAnalytics
        tell event Wallet.PaymentMade to entity WalletContext.Wallet
      }
      on event Wallet.FundsTransferred is {
        send event Wallet.FundsTransferred to outlet WalletEventSplitToWalletRepository
        send event Wallet.FundsTransferred to outlet WalletEventSplitToWalletAnalytics
        tell event Wallet.FundsTransferred to entity WalletContext.Wallet
      }
      on event Wallet.FundsReceived is {
        send event Wallet.FundsReceived to outlet WalletEventSplitToWalletRepository
        send event Wallet.FundsReceived to outlet WalletEventSplitToWalletAnalytics
        tell event Wallet.FundsReceived to entity WalletContext.Wallet
      }
      on event Wallet.FundsWithdrawn is {
        send event Wallet.FundsWithdrawn to outlet WalletEventSplitToWalletRepository
        send event Wallet.FundsWithdrawn to outlet WalletEventSplitToWalletAnalytics
        tell event Wallet.FundsWithdrawn to entity WalletContext.Wallet
      }
      on event Wallet.WalletSuspended is {
        send event Wallet.WalletSuspended to outlet WalletEventSplitToWalletRepository
        send event Wallet.WalletSuspended to outlet WalletEventSplitToWalletAnalytics
        tell event Wallet.WalletSuspended to entity WalletContext.Wallet
      }
      on event Wallet.WalletReactivated is {
        send event Wallet.WalletReactivated to outlet WalletEventSplitToWalletRepository
        send event Wallet.WalletReactivated to outlet WalletEventSplitToWalletAnalytics
        tell event Wallet.WalletReactivated to entity WalletContext.Wallet
      }
      on event Wallet.WalletClosed is {
        send event Wallet.WalletClosed to outlet WalletEventSplitToWalletRepository
        send event Wallet.WalletClosed to outlet WalletEventSplitToWalletAnalytics
        tell event Wallet.WalletClosed to entity WalletContext.Wallet
      }
      on other is {
        error "Unexpected message for processor WalletEventSplit"
      }
    } with {
      briefly "Wallet event fan-out handler"
      described as {
        |Delivers each Wallet event to all of its consumers.
      }
    }
  } with {
    briefly "Wallet event fan-out"
    described as {
      |Fans Wallet events out to the repository and projectors.
    }
  }
  connector LinkWalletToWalletEventSplit is {
    from outlet WalletContext.Wallet.WalletEvents2 to
      inlet WalletContext.WalletEventSplit.WalletEventSplitIn
  } with {
    briefly "LinkWalletToWalletEventSplit"
  }
  connector LinkWalletEventSplitToWalletRepository is {
    from outlet WalletContext.WalletEventSplit.WalletEventSplitToWalletRepository to
      inlet WalletContext.WalletRepository.WalletRepositoryFromWallet
  } with {
    briefly "LinkWalletEventSplitToWalletRepository"
  }
  connector LinkWalletEventSplitToWalletAnalytics is {
    from outlet WalletContext.WalletEventSplit.WalletEventSplitToWalletAnalytics to
      inlet WalletContext.WalletAnalytics.WalletAnalyticsFromWallet
  } with {
    briefly "LinkWalletEventSplitToWalletAnalytics"
  }
  connector LinkWalletAnalyticsToWalletRepository is {
    from outlet WalletContext.WalletAnalytics.WalletAnalyticsOut to
      inlet WalletContext.WalletRepository.WalletRepositoryFromWalletAnalytics
  } with {
    briefly "LinkWalletAnalyticsToWalletRepository"
  }
} with {
  briefly "Bounded context for digital wallets"
  described as {
    | The WalletContext is the bounded context for digital
    | wallet management, payments, and P2P transfers.
  }
}
