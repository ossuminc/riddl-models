// Digital Wallet - Wallet Context
context WalletContext as router is {
  inlet WalletCommandStreamIn is type WalletCommand  outlet WalletCommandStreamOut is type WalletCommand
  inlet WalletResultStreamIn is type Wallet.WalletResult  outlet WalletResultStreamOut is type Wallet.WalletResult
  handler WalletContextBoundary is {
    on createWallet: command Wallet.CreateWallet is {
      send createWallet to outlet WalletContext.WalletCommandStreamOut
    }
    on addPaymentMethod: command Wallet.AddPaymentMethod is {
      send addPaymentMethod to outlet WalletContext.WalletCommandStreamOut
    }
    on removePaymentMethod: command Wallet.RemovePaymentMethod is {
      send removePaymentMethod to outlet WalletContext.WalletCommandStreamOut
    }
    on setDefaultMethod: command Wallet.SetDefaultMethod is {
      send setDefaultMethod to outlet WalletContext.WalletCommandStreamOut
    }
    on topUpBalance: command Wallet.TopUpBalance is {
      send topUpBalance to outlet WalletContext.WalletCommandStreamOut
    }
    on makePayment: command Wallet.MakePayment is {
      send makePayment to outlet WalletContext.WalletCommandStreamOut
    }
    on transferFunds: command Wallet.TransferFunds is {
      send transferFunds to outlet WalletContext.WalletCommandStreamOut
    }
    on withdrawFunds: command Wallet.WithdrawFunds is {
      send withdrawFunds to outlet WalletContext.WalletCommandStreamOut
    }
    on suspendWallet: command Wallet.SuspendWallet is {
      send suspendWallet to outlet WalletContext.WalletCommandStreamOut
    }
    on reactivateWallet: command Wallet.ReactivateWallet is {
      send reactivateWallet to outlet WalletContext.WalletCommandStreamOut
    }
    on receiveFunds: command ReceiveFunds is {
      yield event FundsReceived(walletId = receiveFunds.walletId, transactionId = prompt("the transaction id of this funds received"), senderWalletId = receiveFunds.senderWalletId, amount = receiveFunds.amount, newBalance = prompt("the new balance of this funds received"), receivedAt = prompt("the received at of this funds received"))
    }
    on closeWallet: command Wallet.CloseWallet is {
      send closeWallet to outlet WalletContext.WalletCommandStreamOut
    }
    on walletResult: result Wallet.WalletResult is {
      send walletResult to outlet WalletContext.WalletResultStreamOut
    }
    on other is {
      error "Unexpected message at the WalletContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'WalletCommand Stream Intake' is from outlet WalletContext.WalletCommandStreamOut to inlet WalletContext.Wallet.WalletCommands  connector 'WalletResult Stream Egress' is from outlet WalletContext.WalletRepository.WalletRepositoryResponses to inlet WalletContext.WalletResultStreamIn  adaptor FromBankTransferService from context BankTransferService is { 
    handler FromBankTransferServiceHandler is {
      on event BankTransferService.ACHCompleted is {
        do "the model receives ach completed"
      }
      on event BankTransferService.ACHInitiated is {
        do "the model receives ach initiated"
      }
      on other is {
        error "Unexpected message for adaptor FromBankTransferService"
      }
    } with {
      briefly "from bank transfer service"
      described as {
        |Carries messages from the external BankTransferService.
      }
    }
  } with {
    briefly "BankTransferService integration"
    described as {
      |The model's side of the BankTransferService conversation.
    }
  }
  adaptor ToBankTransferService to context BankTransferService is { 
    handler ToBankTransferServiceHandler is {
      on command BankTransferService.InitiateACH is {
        do "the model sends initiate ach"
      }
      on other is {
        error "Unexpected message for adaptor ToBankTransferService"
      }
    } with {
      briefly "to bank transfer service"
      described as {
        |Carries messages to the external BankTransferService.
      }
    }
  } with {
    briefly "BankTransferService integration"
    described as {
      |The model's side of the BankTransferService conversation.
    }
  }
  adaptor FromFraudService from context FraudService is { 
    handler FromFraudServiceHandler is {
      on event FraudService.FraudScreened is {
        do "the model receives fraud screened"
      }
      on other is {
        error "Unexpected message for adaptor FromFraudService"
      }
    } with {
      briefly "from fraud service"
      described as {
        |Carries messages from the external FraudService.
      }
    }
  } with {
    briefly "FraudService integration"
    described as {
      |The model's side of the FraudService conversation.
    }
  }
  adaptor ToFraudService to context FraudService is { 
    handler ToFraudServiceHandler is {
      on command FraudService.ScreenTransaction is {
        do "the model sends screen transaction"
      }
      on other is {
        error "Unexpected message for adaptor ToFraudService"
      }
    } with {
      briefly "to fraud service"
      described as {
        |Carries messages to the external FraudService.
      }
    }
  } with {
    briefly "FraudService integration"
    described as {
      |The model's side of the FraudService conversation.
    }
  }
  adaptor FromIdentityService from context IdentityService is { 
    handler FromIdentityServiceHandler is {
      on event IdentityService.IdentityVerified is {
        do "the model receives identity verified"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityService"
      }
    } with {
      briefly "from identity service"
      described as {
        |Carries messages from the external IdentityService.
      }
    }
  } with {
    briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor ToIdentityService to context IdentityService is { 
    handler ToIdentityServiceHandler is {
      on command IdentityService.VerifyIdentity is {
        do "the model sends verify identity"
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityService"
      }
    } with {
      briefly "to identity service"
      described as {
        |Carries messages to the external IdentityService.
      }
    }
  } with {
    briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.AlertSent is {
        do "the model receives alert sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendTransactionAlert is {
        do "the model sends send transaction alert"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessorService from context PaymentProcessorService is { 
    handler FromPaymentProcessorServiceHandler is {
      on event PaymentProcessorService.PaymentProcessed is {
        do "the model receives payment processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessorService"
      }
    } with {
      briefly "from payment processor service"
      described as {
        |Carries messages from the external PaymentProcessorService.
      }
    }
  } with {
    briefly "PaymentProcessorService integration"
    described as {
      |The model's side of the PaymentProcessorService conversation.
    }
  }
  adaptor ToPaymentProcessorService to context PaymentProcessorService is { 
    handler ToPaymentProcessorServiceHandler is {
      on command PaymentProcessorService.ProcessPayment is {
        do "the model sends process payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessorService"
      }
    } with {
      briefly "to payment processor service"
      described as {
        |Carries messages to the external PaymentProcessorService.
      }
    }
  } with {
    briefly "PaymentProcessorService integration"
    described as {
      |The model's side of the PaymentProcessorService conversation.
    }
  }
  adaptor FromTokenizationService from context TokenizationService is { 
    handler FromTokenizationServiceHandler is {
      on event TokenizationService.CardTokenized is {
        do "the model receives card tokenized"
      }
      on other is {
        error "Unexpected message for adaptor FromTokenizationService"
      }
    } with {
      briefly "from tokenization service"
      described as {
        |Carries messages from the external TokenizationService.
      }
    }
  } with {
    briefly "TokenizationService integration"
    described as {
      |The model's side of the TokenizationService conversation.
    }
  }
  adaptor ToTokenizationService to context TokenizationService is { 
    handler ToTokenizationServiceHandler is {
      on command TokenizationService.TokenizeCard is {
        do "the model sends tokenize card"
      }
      on other is {
        error "Unexpected message for adaptor ToTokenizationService"
      }
    } with {
      briefly "to tokenization service"
      described as {
        |Carries messages to the external TokenizationService.
      }
    }
  } with {
    briefly "TokenizationService integration"
    described as {
      |The model's side of the TokenizationService conversation.
    }
  }
  include "types.riddl"
  include "Wallet.riddl"
  // Repository for wallet persistence
  type WalletRepositoryCommand is one of {
    WalletContext.WalletRepository.PersistBalanceToppedUp or WalletContext.WalletRepository.PersistDefaultMethodSet or WalletContext.WalletRepository.PersistFundsReceived or WalletContext.WalletRepository.PersistFundsTransferred or WalletContext.WalletRepository.PersistFundsWithdrawn or WalletContext.WalletRepository.PersistPaymentMade or WalletContext.WalletRepository.PersistPaymentMethodAdded or WalletContext.WalletRepository.PersistPaymentMethodRemoved or WalletContext.WalletRepository.PersistWalletClosed or WalletContext.WalletRepository.PersistWalletCreated or WalletContext.WalletRepository.PersistWalletReactivated or WalletContext.WalletRepository.PersistWalletSuspended
  } with {
    briefly "Anything that writes WalletRepository"
    described as {
      |The persistence commands WalletRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository WalletRepository as flow is {
    inlet WalletRepositoryFromWalletAnalytics is type WalletRepositoryCommand
    command PersistDefaultMethodSet is  {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row DefaultMethodSet applies to.
        }
      }
    } with {
      briefly "Persist DefaultMethodSet"
      described as {
        |Instructs this repository to apply DefaultMethodSet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFundsReceived is  {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row FundsReceived applies to.
        }
      }
    } with {
      briefly "Persist FundsReceived"
      described as {
        |Instructs this repository to apply FundsReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFundsWithdrawn is  {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row FundsWithdrawn applies to.
        }
      }
    } with {
      briefly "Persist FundsWithdrawn"
      described as {
        |Instructs this repository to apply FundsWithdrawn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentMethodAdded is  {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentMethodAdded applies to.
        }
      }
    } with {
      briefly "Persist PaymentMethodAdded"
      described as {
        |Instructs this repository to apply PaymentMethodAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentMethodRemoved is  {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentMethodRemoved applies to.
        }
      }
    } with {
      briefly "Persist PaymentMethodRemoved"
      described as {
        |Instructs this repository to apply PaymentMethodRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWalletClosed is  {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row WalletClosed applies to.
        }
      }
    } with {
      briefly "Persist WalletClosed"
      described as {
        |Instructs this repository to apply WalletClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWalletReactivated is  {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row WalletReactivated applies to.
        }
      }
    } with {
      briefly "Persist WalletReactivated"
      described as {
        |Instructs this repository to apply WalletReactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWalletSuspended is  {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row WalletSuspended applies to.
        }
      }
    } with {
      briefly "Persist WalletSuspended"
      described as {
        |Instructs this repository to apply WalletSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBalanceToppedUp is  {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row BalanceToppedUp applies to.
        }
      }
    } with {
      briefly "Persist BalanceToppedUp"
      described as {
        |Instructs this repository to apply BalanceToppedUp to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFundsTransferred is  {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row FundsTransferred applies to.
        }
      }
    } with {
      briefly "Persist FundsTransferred"
      described as {
        |Instructs this repository to apply FundsTransferred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentMade is  {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentMade applies to.
        }
      }
    } with {
      briefly "Persist PaymentMade"
      described as {
        |Instructs this repository to apply PaymentMade to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWalletCreated is  {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row WalletCreated applies to.
        }
      }
    } with {
      briefly "Persist WalletCreated"
      described as {
        |Instructs this repository to apply WalletCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet WalletRepositoryResponses is type Wallet.WalletResult
    record StoredWallet is  {
      walletId: WalletId with {
        briefly "walletId"
        described as {
          |The walletId column of the stored wallet row.
        }
      }
      userId: WalletUserId with {
        briefly "userId"
        described as {
          |The userId column of the stored wallet row.
        }
      }
    } with {
      briefly "Stored wallet row"
      described as {
        |The persistence shape of wallet data as this repository stores it.
      }
    }
    schema WalletData is relational
      of wallets as type StoredWallet
        index on field StoredWallet.walletId
        index on field StoredWallet.userId
 with {
      briefly "Wallet data schema"
      described as {
        |The relational schema holding wallet data for the WalletRepository.
      }
    }
    handler WalletPersistence is {
      on persistDefaultMethodSet: command PersistDefaultMethodSet is {
        do "apply DefaultMethodSet to the stored row"
      }
      on persistFundsReceived: command PersistFundsReceived is {
        do "apply FundsReceived to the stored row"
      }
      on persistFundsWithdrawn: command PersistFundsWithdrawn is {
        do "apply FundsWithdrawn to the stored row"
      }
      on persistPaymentMethodAdded: command PersistPaymentMethodAdded is {
        do "apply PaymentMethodAdded to the stored row"
      }
      on persistPaymentMethodRemoved: command PersistPaymentMethodRemoved is {
        do "apply PaymentMethodRemoved to the stored row"
      }
      on persistWalletClosed: command PersistWalletClosed is {
        do "apply WalletClosed to the stored row"
      }
      on persistWalletReactivated: command PersistWalletReactivated is {
        do "apply WalletReactivated to the stored row"
      }
      on persistWalletSuspended: command PersistWalletSuspended is {
        do "apply WalletSuspended to the stored row"
      }
      on persistBalanceToppedUp: command PersistBalanceToppedUp is {
        do "apply BalanceToppedUp to the stored row"
      }
      on persistFundsTransferred: command PersistFundsTransferred is {
        do "apply FundsTransferred to the stored row"
      }
      on persistPaymentMade: command PersistPaymentMade is {
        do "apply PaymentMade to the stored row"
      }
      on persistWalletCreated: command PersistWalletCreated is {
        do "apply WalletCreated to the stored row"
      }
      on query GetWalletStats is {
        let walletStatsView: type WalletStatsView = prompt("read the wallet stats projection")
        reply walletStatsView
      }
    } with {
      briefly "Persists wallet commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Wallet data persistence"
    described as {
      | The WalletRepository provides persistent storage for
      | wallet accounts, transactions, and payment methods.
    }
  }
  // Projector for wallet analytics
  query GetWalletStats replies result WalletStatsView is  {
    walletStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which wallet stats to retrieve.
      }
    }
  } with {
    briefly "Get wallet stats"
    described as {
      |Retrieves the wallet stats projection.
    }
  }
  result WalletStatsView is  {
    walletStats: WalletAnalytics.WalletStats with {
      briefly "Wallet stats"
      described as {
        |The wallet stats being returned.
      }
    }
  } with {
    briefly "Wallet stats view"
    described as {
      |Read model view carrying the wallet stats projection.
    }
  }
  projector WalletAnalytics as flow is {
    outlet WalletAnalyticsToRepository is type WalletRepositoryCommand
    updates repository WalletContext.WalletRepository
    inlet WalletAnalyticsFromWallet is type WalletEvent
    record WalletStats is  {
      totalWallets: Natural with {
        briefly "Wallets"
        described as {
          |Total wallets.
        }
      }
      activeWallets: Natural with {
        briefly "Active"
        described as {
          |Active wallets.
        }
      }
      totalBalance: Decimal(18,2) with {
        briefly "Balance"
        described as {
          |Total platform balance.
        }
      }
      dailyTransactions: Natural with {
        briefly "Daily"
        described as {
          |Daily transactions.
        }
      }
      dailyVolume: Decimal(15,2) with {
        briefly "Volume"
        described as {
          |Daily transaction volume.
        }
      }
      avgTransactionSize: Decimal(10,2) with {
        briefly "Avg size"
        described as {
          |Average transaction.
        }
      }
    } with {
      briefly "Wallet statistics"
      described as {
        |Platform wallet metrics.
      }
    }
    handler AnalyticsHandler is {
      on defaultMethodSet: event Wallet.DefaultMethodSet is {
        tell command WalletContext.WalletRepository.PersistDefaultMethodSet(walletId = defaultMethodSet.walletId) to repository WalletContext.WalletRepository
        do "apply DefaultMethodSet to the WalletAnalytics projection"
      }
      on fundsReceived: event Wallet.FundsReceived is {
        tell command WalletContext.WalletRepository.PersistFundsReceived(walletId = fundsReceived.walletId) to repository WalletContext.WalletRepository
        do "apply FundsReceived to the WalletAnalytics projection"
      }
      on fundsWithdrawn: event Wallet.FundsWithdrawn is {
        tell command WalletContext.WalletRepository.PersistFundsWithdrawn(walletId = fundsWithdrawn.walletId) to repository WalletContext.WalletRepository
        do "apply FundsWithdrawn to the WalletAnalytics projection"
      }
      on paymentMethodAdded: event Wallet.PaymentMethodAdded is {
        tell command WalletContext.WalletRepository.PersistPaymentMethodAdded(walletId = paymentMethodAdded.walletId) to repository WalletContext.WalletRepository
        do "apply PaymentMethodAdded to the WalletAnalytics projection"
      }
      on paymentMethodRemoved: event Wallet.PaymentMethodRemoved is {
        tell command WalletContext.WalletRepository.PersistPaymentMethodRemoved(walletId = paymentMethodRemoved.walletId) to repository WalletContext.WalletRepository
        do "apply PaymentMethodRemoved to the WalletAnalytics projection"
      }
      on walletClosed: event Wallet.WalletClosed is {
        tell command WalletContext.WalletRepository.PersistWalletClosed(walletId = walletClosed.walletId) to repository WalletContext.WalletRepository
        do "apply WalletClosed to the WalletAnalytics projection"
      }
      on walletReactivated: event Wallet.WalletReactivated is {
        tell command WalletContext.WalletRepository.PersistWalletReactivated(walletId = walletReactivated.walletId) to repository WalletContext.WalletRepository
        do "apply WalletReactivated to the WalletAnalytics projection"
      }
      on walletSuspended: event Wallet.WalletSuspended is {
        tell command WalletContext.WalletRepository.PersistWalletSuspended(walletId = walletSuspended.walletId) to repository WalletContext.WalletRepository
        do "apply WalletSuspended to the WalletAnalytics projection"
      }
      on walletCreated: event Wallet.WalletCreated is {
        tell command WalletContext.WalletRepository.PersistWalletCreated(walletId = walletCreated.walletId) to repository WalletContext.WalletRepository
      }
      on paymentMade: event Wallet.PaymentMade is {
        tell command WalletContext.WalletRepository.PersistPaymentMade(walletId = paymentMade.walletId) to repository WalletContext.WalletRepository
      }
      on fundsTransferred: event Wallet.FundsTransferred is {
        tell command WalletContext.WalletRepository.PersistFundsTransferred(walletId = fundsTransferred.walletId) to repository WalletContext.WalletRepository
      }
      on balanceToppedUp: event Wallet.BalanceToppedUp is {
        tell command WalletContext.WalletRepository.PersistBalanceToppedUp(walletId = balanceToppedUp.walletId) to repository WalletContext.WalletRepository
      }
    } with {
      briefly "Maintains wallet analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Wallet analytics projections"
    described as {
      |Maintains wallet platform analytics data.
    }
  }
  processor WalletEventSplit as flow is {
    inlet WalletEventSplitIn is type WalletEvent
    outlet WalletEventSplitToWalletAnalytics is type WalletEvent
    handler WalletEventSplitHandler is {
      on walletCreated: event Wallet.WalletCreated is {
        send walletCreated to outlet WalletEventSplitToWalletAnalytics
        tell walletCreated to entity WalletContext.Wallet
      }
      on paymentMethodAdded: event Wallet.PaymentMethodAdded is {
        send paymentMethodAdded to outlet WalletEventSplitToWalletAnalytics
        tell paymentMethodAdded to entity WalletContext.Wallet
      }
      on paymentMethodRemoved: event Wallet.PaymentMethodRemoved is {
        send paymentMethodRemoved to outlet WalletEventSplitToWalletAnalytics
        tell paymentMethodRemoved to entity WalletContext.Wallet
      }
      on defaultMethodSet: event Wallet.DefaultMethodSet is {
        send defaultMethodSet to outlet WalletEventSplitToWalletAnalytics
        tell defaultMethodSet to entity WalletContext.Wallet
      }
      on balanceToppedUp: event Wallet.BalanceToppedUp is {
        send balanceToppedUp to outlet WalletEventSplitToWalletAnalytics
        tell balanceToppedUp to entity WalletContext.Wallet
      }
      on paymentMade: event Wallet.PaymentMade is {
        send paymentMade to outlet WalletEventSplitToWalletAnalytics
        tell paymentMade to entity WalletContext.Wallet
      }
      on fundsTransferred: event Wallet.FundsTransferred is {
        send fundsTransferred to outlet WalletEventSplitToWalletAnalytics
        tell fundsTransferred to entity WalletContext.Wallet
      }
      on fundsReceived: event Wallet.FundsReceived is {
        send fundsReceived to outlet WalletEventSplitToWalletAnalytics
        tell fundsReceived to entity WalletContext.Wallet by walletId
      }
      on fundsWithdrawn: event Wallet.FundsWithdrawn is {
        send fundsWithdrawn to outlet WalletEventSplitToWalletAnalytics
        tell fundsWithdrawn to entity WalletContext.Wallet
      }
      on walletSuspended: event Wallet.WalletSuspended is {
        send walletSuspended to outlet WalletEventSplitToWalletAnalytics
        tell walletSuspended to entity WalletContext.Wallet
      }
      on walletReactivated: event Wallet.WalletReactivated is {
        send walletReactivated to outlet WalletEventSplitToWalletAnalytics
        tell walletReactivated to entity WalletContext.Wallet
      }
      on walletClosed: event Wallet.WalletClosed is {
        send walletClosed to outlet WalletEventSplitToWalletAnalytics
        tell walletClosed to entity WalletContext.Wallet
      }
      on other is {
        error "Unexpected message for processor WalletEventSplit"
      }
    } with {
      briefly "Wallet event fan-out handler"
      described as {
        |Delivers each Wallet event to all of its consumers.
      }
    }
  } with {
    briefly "Wallet event fan-out"
    described as {
      |Fans Wallet events out to the repository and projectors.
    }
  }
  connector 'WalletEvent Stream' is from outlet WalletContext.Wallet.WalletEvents2 to inlet WalletContext.WalletEventSplit.WalletEventSplitIn with {
    briefly "Wallet events, fanned out to storage and read models"
  }
  connector 'WalletAnalytics Feed' is from outlet WalletContext.WalletEventSplit.WalletEventSplitToWalletAnalytics to inlet WalletContext.WalletAnalytics.WalletAnalyticsFromWallet with {
    briefly "Wallet events feeding the WalletAnalytics projection"
  }
  connector 'WalletAnalytics Storage' is from outlet WalletContext.WalletAnalytics.WalletAnalyticsToRepository to inlet WalletContext.WalletRepository.WalletRepositoryFromWalletAnalytics with {
    briefly "WalletAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for digital wallets"
  described as {
    | The WalletContext is the bounded context for digital
    | wallet management, payments, and P2P transfers.
  }
}
