// Digital Wallet - Wallet Context
context WalletContext as router is {
  inlet WalletContextFromBankTransferService is command Wallet.ReceiveFunds with {
    briefly "What FromBankTransferService makes of that service's news"
  }
  connector 'FromBankTransferService Intake' is from outlet WalletContext.FromBankTransferService.FromBankTransferServiceToWalletContext to inlet WalletContext.WalletContextFromBankTransferService with {
    briefly "What FromBankTransferService makes of that news, on its way in"
  }
  inlet WalletContextFromTokenizationService is command Wallet.AddPaymentMethod with {
    briefly "What FromTokenizationService makes of that service's news"
  }
  connector 'FromTokenizationService Intake' is from outlet WalletContext.FromTokenizationService.FromTokenizationServiceToWalletContext to inlet WalletContext.WalletContextFromTokenizationService with {
    briefly "What FromTokenizationService makes of that news, on its way in"
  }
  inlet WalletCommandStreamIn is type WalletCommand  outlet WalletCommandStreamOut is type WalletCommand
  inlet WalletResultStreamIn is result Wallet.WalletResult  outlet WalletResultStreamOut is result Wallet.WalletResult
  handler WalletContextBoundary is {
    on createWallet: command Wallet.CreateWallet is {
      forward createWallet to outlet WalletContext.WalletCommandStreamOut
    }
    on addPaymentMethod: command Wallet.AddPaymentMethod is {
      forward addPaymentMethod to outlet WalletContext.WalletCommandStreamOut
    }
    on removePaymentMethod: command Wallet.RemovePaymentMethod is {
      forward removePaymentMethod to outlet WalletContext.WalletCommandStreamOut
    }
    on setDefaultMethod: command Wallet.SetDefaultMethod is {
      forward setDefaultMethod to outlet WalletContext.WalletCommandStreamOut
    }
    on topUpBalance: command Wallet.TopUpBalance is {
      forward topUpBalance to outlet WalletContext.WalletCommandStreamOut
    }
    on makePayment: command Wallet.MakePayment is {
      forward makePayment to outlet WalletContext.WalletCommandStreamOut
    }
    on transferFunds: command Wallet.TransferFunds is {
      forward transferFunds to outlet WalletContext.WalletCommandStreamOut
    }
    on withdrawFunds: command Wallet.WithdrawFunds is {
      forward withdrawFunds to outlet WalletContext.WalletCommandStreamOut
    }
    on suspendWallet: command Wallet.SuspendWallet is {
      forward suspendWallet to outlet WalletContext.WalletCommandStreamOut
    }
    on reactivateWallet: command Wallet.ReactivateWallet is {
      forward reactivateWallet to outlet WalletContext.WalletCommandStreamOut
    }
    on receiveFunds: command ReceiveFunds is {
      yield event FundsReceived(walletId = receiveFunds.walletId, transactionId = prompt("the transaction id of this funds received"), senderWalletId = receiveFunds.senderWalletId, amount = receiveFunds.amount, newBalance = prompt("the new balance of this funds received"), receivedAt = prompt("the received at of this funds received"))
    }
    on closeWallet: command Wallet.CloseWallet is {
      forward closeWallet to outlet WalletContext.WalletCommandStreamOut
    }
    on walletResult: result Wallet.WalletResult is {
      send walletResult to outlet WalletContext.WalletResultStreamOut
    }
    on other is {
      error "Unexpected message at the WalletContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'WalletCommand Stream Intake' is from outlet WalletContext.WalletCommandStreamOut to inlet WalletContext.Wallet.WalletCommands  connector 'WalletResult Stream Egress' is from outlet WalletContext.WalletRepository.WalletRepositoryResponses to inlet WalletContext.WalletResultStreamIn  adaptor FromBankTransferService from context BankTransferService as flow is { 
    inlet FromBankTransferServiceIn is type BankTransferService.BankTransferServiceEvent    outlet FromBankTransferServiceToWalletContext is command Wallet.ReceiveFunds
    handler FromBankTransferServiceHandler is {
      on aCHCompleted: event BankTransferService.ACHCompleted is {
        let item0: type Wallet.ReceiveFunds = prompt("translate the aCHCompleted event into a ReceiveFunds, money that has actually arrived is what the wallet's balance reflects")
        send item0 to outlet WalletContext.FromBankTransferService.FromBankTransferServiceToWalletContext
      }
      on aCHInitiated: event BankTransferService.ACHInitiated is {
        do "the transfer is under way; the wallet records the balance when it lands"
      }
      on other is {
        error "Unexpected message for adaptor FromBankTransferService"
      }
    } with {
      briefly "from bank transfer service"
      described as {
        |Carries messages from the external BankTransferService.
      }
    }
  } with {
    briefly "BankTransferService integration"
    described as {
      |The model's side of the BankTransferService conversation.
    }
  }
  adaptor ToBankTransferService to context BankTransferService as flow is { 
    inlet ToBankTransferServiceIn is type WalletEvent    outlet ToBankTransferServiceOut is command BankTransferService.InitiateACH
    handler ToBankTransferServiceHandler is {
      on balanceToppedUp: event Wallet.BalanceToppedUp is {
        let item0: type BankTransferService.InitiateACH = prompt("translate the balanceToppedUp event into a InitiateACH, a top-up being what must be funded from the bank")
        send item0 to outlet WalletContext.ToBankTransferService.ToBankTransferServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToBankTransferService"
      }
    } with {
      briefly "to bank transfer service"
      described as {
        |Carries messages to the external BankTransferService.
      }
    }
  } with {
    briefly "BankTransferService integration"
    described as {
      |The model's side of the BankTransferService conversation.
    }
  }
  adaptor FromFraudService from context FraudService as sink is { 
    inlet FromFraudServiceIn is event FraudService.FraudScreened    handler FromFraudServiceHandler is {
      on fraudScreened: event FraudService.FraudScreened is {
        do "fraud has looked; the payment proceeds on its own terms"
      }
      on other is {
        error "Unexpected message for adaptor FromFraudService"
      }
    } with {
      briefly "from fraud service"
      described as {
        |Carries messages from the external FraudService.
      }
    }
  } with {
    briefly "FraudService integration"
    described as {
      |The model's side of the FraudService conversation.
    }
  }
  adaptor ToFraudService to context FraudService as flow is { 
    inlet ToFraudServiceIn is type WalletEvent    outlet ToFraudServiceOut is command FraudService.ScreenTransaction
    handler ToFraudServiceHandler is {
      on paymentMade: event PaymentMade is {
        let item0: type FraudService.ScreenTransaction = prompt("translate the paymentMade event into a ScreenTransaction as the payment is committed")
        send item0 to outlet WalletContext.ToFraudService.ToFraudServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToFraudService"
      }
    } with {
      briefly "to fraud service"
      described as {
        |Carries messages to the external FraudService.
      }
    }
  } with {
    briefly "FraudService integration"
    described as {
      |The model's side of the FraudService conversation.
    }
  }
  adaptor FromIdentityService from context IdentityService as sink is { 
    inlet FromIdentityServiceIn is event IdentityService.IdentityVerified    handler FromIdentityServiceHandler is {
      on identityVerified: event IdentityService.IdentityVerified is {
        do "identity is confirmed; opening or restoring the wallet is a separate act"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityService"
      }
    } with {
      briefly "from identity service"
      described as {
        |Carries messages from the external IdentityService.
      }
    }
  } with {
    briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor ToIdentityService to context IdentityService as flow is { 
    inlet ToIdentityServiceIn is type WalletEvent    outlet ToIdentityServiceOut is command IdentityService.VerifyIdentity
    handler ToIdentityServiceHandler is {
      on walletCreated: event WalletCreated is {
        let check0: type IdentityService.VerifyIdentity = prompt("translate the walletCreated event into a VerifyIdentity, a wallet being an instrument that may not be issued unverified")
        send check0 to outlet WalletContext.ToIdentityService.ToIdentityServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityService"
      }
    } with {
      briefly "to identity service"
      described as {
        |Carries messages to the external IdentityService.
      }
    }
  } with {
    briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type WalletEvent    outlet ToNotificationServiceOut is command NotificationService.SendTransactionAlert
    handler ToNotificationServiceHandler is {
      on paymentMade: event PaymentMade is {
        let msg: type NotificationService.SendTransactionAlert = prompt("translate the paymentMade event into a SendTransactionAlert for its recipient")
        send msg to outlet WalletContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessorService from context PaymentProcessorService as sink is { 
    inlet FromPaymentProcessorServiceIn is event PaymentProcessorService.PaymentProcessed    handler FromPaymentProcessorServiceHandler is {
      on paymentProcessed: event PaymentProcessorService.PaymentProcessed is {
        do "the processor has taken it; the wallet recorded the payment when it was made"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessorService"
      }
    } with {
      briefly "from payment processor service"
      described as {
        |Carries messages from the external PaymentProcessorService.
      }
    }
  } with {
    briefly "PaymentProcessorService integration"
    described as {
      |The model's side of the PaymentProcessorService conversation.
    }
  }
  adaptor ToPaymentProcessorService to context PaymentProcessorService as flow is { 
    inlet ToPaymentProcessorServiceIn is type WalletEvent    outlet ToPaymentProcessorServiceOut is command PaymentProcessorService.ProcessPayment
    handler ToPaymentProcessorServiceHandler is {
      on paymentMade: event Wallet.PaymentMade is {
        let notice: type PaymentProcessorService.ProcessPayment = prompt("translate the paymentMade event into a ProcessPayment moving the money the wallet holder has just committed to paying")
        send notice to outlet WalletContext.ToPaymentProcessorService.ToPaymentProcessorServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessorService"
      }
    } with {
      briefly "to payment processor service"
      described as {
        |Carries messages to the external PaymentProcessorService.
      }
    }
  } with {
    briefly "PaymentProcessorService integration"
    described as {
      |The model's side of the PaymentProcessorService conversation.
    }
  }
  adaptor FromTokenizationService from context TokenizationService as flow is { 
    inlet FromTokenizationServiceIn is event TokenizationService.CardTokenized    outlet FromTokenizationServiceToWalletContext is command Wallet.AddPaymentMethod
    handler FromTokenizationServiceHandler is {
      on cardTokenized: event TokenizationService.CardTokenized is {
        let item0: type Wallet.AddPaymentMethod = prompt("translate the cardTokenized event into a AddPaymentMethod, a tokenised card is what can actually be stored as a payment method")
        send item0 to outlet WalletContext.FromTokenizationService.FromTokenizationServiceToWalletContext
      }
      on other is {
        error "Unexpected message for adaptor FromTokenizationService"
      }
    } with {
      briefly "from tokenization service"
      described as {
        |Carries messages from the external TokenizationService.
      }
    }
  } with {
    briefly "TokenizationService integration"
    described as {
      |The model's side of the TokenizationService conversation.
    }
  }
  adaptor ToTokenizationService to context TokenizationService as flow is { 
    inlet ToTokenizationServiceIn is type WalletEvent    outlet ToTokenizationServiceOut is command TokenizationService.TokenizeCard
    handler ToTokenizationServiceHandler is {
      on paymentMethodAdded: event PaymentMethodAdded is {
        let check0: type TokenizationService.TokenizeCard = prompt("translate the paymentMethodAdded event into a TokenizeCard so the pan is replaced the moment it enters the model")
        send check0 to outlet WalletContext.ToTokenizationService.ToTokenizationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToTokenizationService"
      }
    } with {
      briefly "to tokenization service"
      described as {
        |Carries messages to the external TokenizationService.
      }
    }
  } with {
    briefly "TokenizationService integration"
    described as {
      |The model's side of the TokenizationService conversation.
    }
  }
  include "types.riddl"
  include "Wallet.riddl"
  // Repository for wallet persistence
  type WalletRepositoryCommand is one of {
    WalletContext.WalletRepository.PersistBalanceToppedUp or WalletContext.WalletRepository.PersistDefaultMethodSet or WalletContext.WalletRepository.PersistFundsReceived or WalletContext.WalletRepository.PersistFundsTransferred or WalletContext.WalletRepository.PersistFundsWithdrawn or WalletContext.WalletRepository.PersistPaymentMade or WalletContext.WalletRepository.PersistPaymentMethodAdded or WalletContext.WalletRepository.PersistPaymentMethodRemoved or WalletContext.WalletRepository.PersistWalletClosed or WalletContext.WalletRepository.PersistWalletCreated or WalletContext.WalletRepository.PersistWalletReactivated or WalletContext.WalletRepository.PersistWalletSuspended
  } with {
    briefly "Anything that writes WalletRepository"
    described as {
      |The persistence commands WalletRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository WalletRepository as flow is {
    inlet WalletRepositoryFromWalletAnalytics is type WalletRepositoryCommand    command PersistDefaultMethodSet is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row DefaultMethodSet applies to.
        }
      }
      methodId: PaymentMethodId? with {
        briefly "Method id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      setAt: TimeStamp? with {
        briefly "Set at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DefaultMethodSet"
      described as {
        |Instructs this repository to apply DefaultMethodSet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFundsReceived is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row FundsReceived applies to.
        }
      }
      transactionId: TransactionId? with {
        briefly "Transaction id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      senderWalletId: WalletId? with {
        briefly "Sender wallet id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      amount: Decimal(12,2)? with {
        briefly "Amount"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newBalance: Decimal(15,2)? with {
        briefly "New balance"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      receivedAt: TimeStamp? with {
        briefly "Received at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist FundsReceived"
      described as {
        |Instructs this repository to apply FundsReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFundsWithdrawn is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row FundsWithdrawn applies to.
        }
      }
      transactionId: TransactionId? with {
        briefly "Transaction id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      withdrawal: WithdrawalDetails? with {
        briefly "Withdrawal"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newBalance: Decimal(15,2)? with {
        briefly "New balance"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      withdrawnAt: TimeStamp? with {
        briefly "Withdrawn at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist FundsWithdrawn"
      described as {
        |Instructs this repository to apply FundsWithdrawn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentMethodAdded is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentMethodAdded applies to.
        }
      }
      method: LinkedPaymentMethod? with {
        briefly "Method"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PaymentMethodAdded"
      described as {
        |Instructs this repository to apply PaymentMethodAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentMethodRemoved is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentMethodRemoved applies to.
        }
      }
      methodId: PaymentMethodId? with {
        briefly "Method id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PaymentMethodRemoved"
      described as {
        |Instructs this repository to apply PaymentMethodRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWalletClosed is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row WalletClosed applies to.
        }
      }
      reason: String(1,200)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      closedAt: TimeStamp? with {
        briefly "Closed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist WalletClosed"
      described as {
        |Instructs this repository to apply WalletClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWalletReactivated is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row WalletReactivated applies to.
        }
      }
      reactivatedAt: TimeStamp? with {
        briefly "Reactivated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist WalletReactivated"
      described as {
        |Instructs this repository to apply WalletReactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWalletSuspended is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row WalletSuspended applies to.
        }
      }
      reason: String(1,200)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      suspendedAt: TimeStamp? with {
        briefly "Suspended at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist WalletSuspended"
      described as {
        |Instructs this repository to apply WalletSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBalanceToppedUp is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row BalanceToppedUp applies to.
        }
      }
      topUp: TopUpDetails? with {
        briefly "Top up"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newBalance: Decimal(15,2)? with {
        briefly "New balance"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      toppedUpAt: TimeStamp? with {
        briefly "Topped up at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist BalanceToppedUp"
      described as {
        |Instructs this repository to apply BalanceToppedUp to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFundsTransferred is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row FundsTransferred applies to.
        }
      }
      transactionId: TransactionId? with {
        briefly "Transaction id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      transfer: TransferDetails? with {
        briefly "Transfer"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newBalance: Decimal(15,2)? with {
        briefly "New balance"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      transferredAt: TimeStamp? with {
        briefly "Transferred at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist FundsTransferred"
      described as {
        |Instructs this repository to apply FundsTransferred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentMade is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentMade applies to.
        }
      }
      transactionId: TransactionId? with {
        briefly "Transaction id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      payment: PaymentDetails? with {
        briefly "Payment"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newBalance: Decimal(15,2)? with {
        briefly "New balance"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      paidAt: TimeStamp? with {
        briefly "Paid at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PaymentMade"
      described as {
        |Instructs this repository to apply PaymentMade to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWalletCreated is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row WalletCreated applies to.
        }
      }
      userId: WalletUserId? with {
        briefly "User id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      currency: String(3,3)? with {
        briefly "Currency"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist WalletCreated"
      described as {
        |Instructs this repository to apply WalletCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet WalletRepositoryResponses is result Wallet.WalletResult
    record StoredWallet is {
      walletId: WalletId with {
        briefly "walletId"
        described as {
          |The walletId column of the stored wallet row.
        }
      }
      userId: WalletUserId with {
        briefly "userId"
        described as {
          |The userId column of the stored wallet row.
        }
      }
      methodId: PaymentMethodId? with {
        briefly "Method id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      setAt: TimeStamp? with {
        briefly "Set at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      transactionId: TransactionId? with {
        briefly "Transaction id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      senderWalletId: WalletId? with {
        briefly "Sender wallet id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      amount: Decimal(12,2)? with {
        briefly "Amount"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newBalance: Decimal(15,2)? with {
        briefly "New balance"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      receivedAt: TimeStamp? with {
        briefly "Received at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      withdrawal: WithdrawalDetails? with {
        briefly "Withdrawal"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      withdrawnAt: TimeStamp? with {
        briefly "Withdrawn at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      method: LinkedPaymentMethod? with {
        briefly "Method"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,200)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      closedAt: TimeStamp? with {
        briefly "Closed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reactivatedAt: TimeStamp? with {
        briefly "Reactivated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      suspendedAt: TimeStamp? with {
        briefly "Suspended at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      topUp: TopUpDetails? with {
        briefly "Top up"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      toppedUpAt: TimeStamp? with {
        briefly "Topped up at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      transfer: TransferDetails? with {
        briefly "Transfer"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      transferredAt: TimeStamp? with {
        briefly "Transferred at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      payment: PaymentDetails? with {
        briefly "Payment"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      paidAt: TimeStamp? with {
        briefly "Paid at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      currency: String(3,3)? with {
        briefly "Currency"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored wallet row"
      described as {
        |The persistence shape of wallet data as this repository stores it.
      }
    }
    schema WalletData is relational
      of wallets as record StoredWallet
        key on field StoredWallet.walletId
        index on field StoredWallet.userId
 with {
      briefly "Wallet data schema"
      described as {
        |The relational schema holding wallet data for the WalletRepository.
      }
    }
    handler WalletPersistence is {
      on persistDefaultMethodSet: command PersistDefaultMethodSet is {
        update WalletData.wallets set methodId = persistDefaultMethodSet.methodId, setAt = persistDefaultMethodSet.setAt where walletId == persistDefaultMethodSet.walletId
      }
      on persistFundsReceived: command PersistFundsReceived is {
        update WalletData.wallets set transactionId = persistFundsReceived.transactionId, senderWalletId = persistFundsReceived.senderWalletId, amount = persistFundsReceived.amount, newBalance = persistFundsReceived.newBalance, receivedAt = persistFundsReceived.receivedAt where walletId == persistFundsReceived.walletId
      }
      on persistFundsWithdrawn: command PersistFundsWithdrawn is {
        update WalletData.wallets set transactionId = persistFundsWithdrawn.transactionId, withdrawal = persistFundsWithdrawn.withdrawal, newBalance = persistFundsWithdrawn.newBalance, withdrawnAt = persistFundsWithdrawn.withdrawnAt where walletId == persistFundsWithdrawn.walletId
      }
      on persistPaymentMethodAdded: command PersistPaymentMethodAdded is {
        update WalletData.wallets set method = persistPaymentMethodAdded.method, addedAt = persistPaymentMethodAdded.addedAt where walletId == persistPaymentMethodAdded.walletId
      }
      on persistPaymentMethodRemoved: command PersistPaymentMethodRemoved is {
        update WalletData.wallets set methodId = persistPaymentMethodRemoved.methodId, removedAt = persistPaymentMethodRemoved.removedAt where walletId == persistPaymentMethodRemoved.walletId
      }
      on persistWalletClosed: command PersistWalletClosed is {
        update WalletData.wallets set reason = persistWalletClosed.reason, closedAt = persistWalletClosed.closedAt where walletId == persistWalletClosed.walletId
      }
      on persistWalletReactivated: command PersistWalletReactivated is {
        update WalletData.wallets set reactivatedAt = persistWalletReactivated.reactivatedAt where walletId == persistWalletReactivated.walletId
      }
      on persistWalletSuspended: command PersistWalletSuspended is {
        update WalletData.wallets set reason = persistWalletSuspended.reason, suspendedAt = persistWalletSuspended.suspendedAt where walletId == persistWalletSuspended.walletId
      }
      on persistBalanceToppedUp: command PersistBalanceToppedUp is {
        update WalletData.wallets set topUp = persistBalanceToppedUp.topUp, newBalance = persistBalanceToppedUp.newBalance, toppedUpAt = persistBalanceToppedUp.toppedUpAt where walletId == persistBalanceToppedUp.walletId
      }
      on persistFundsTransferred: command PersistFundsTransferred is {
        update WalletData.wallets set transactionId = persistFundsTransferred.transactionId, transfer = persistFundsTransferred.transfer, newBalance = persistFundsTransferred.newBalance, transferredAt = persistFundsTransferred.transferredAt where walletId == persistFundsTransferred.walletId
      }
      on persistPaymentMade: command PersistPaymentMade is {
        update WalletData.wallets set transactionId = persistPaymentMade.transactionId, payment = persistPaymentMade.payment, newBalance = persistPaymentMade.newBalance, paidAt = persistPaymentMade.paidAt where walletId == persistPaymentMade.walletId
      }
      on persistWalletCreated: command PersistWalletCreated is {
        update WalletData.wallets set userId = persistWalletCreated.userId, currency = persistWalletCreated.currency, createdAt = persistWalletCreated.createdAt where walletId == persistWalletCreated.walletId
      }
      on query GetWalletStats is {
        let walletStatsView: type WalletStatsView = prompt("read the wallet stats projection")
        reply walletStatsView
      }
    } with {
      briefly "Persists wallet commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Wallet data persistence"
    described as {
      | The WalletRepository provides persistent storage for
      | wallet accounts, transactions, and payment methods.
    }
  }
  // Projector for wallet analytics
  query GetWalletStats replies result WalletStatsView is {
    walletStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which wallet stats to retrieve.
      }
    }
  } with {
    briefly "Get wallet stats"
    described as {
      |Retrieves the wallet stats projection.
    }
  }
  result WalletStatsView is {
    walletStats: WalletAnalytics.WalletStats with {
      briefly "Wallet stats"
      described as {
        |The wallet stats being returned.
      }
    }
  } with {
    briefly "Wallet stats view"
    described as {
      |Read model view carrying the wallet stats projection.
    }
  }
  projector WalletAnalytics as flow is {
    updates repository WalletContext.WalletRepository
    outlet WalletAnalyticsToRepository is type WalletRepositoryCommand
    inlet WalletAnalyticsFromWallet is type WalletEvent    record WalletStats is {
      totalWallets: Natural with {
        briefly "Wallets"
        described as {
          |Total wallets.
        }
      }
      activeWallets: Natural with {
        briefly "Active"
        described as {
          |Active wallets.
        }
      }
      totalBalance: Decimal(18,2) with {
        briefly "Balance"
        described as {
          |Total platform balance.
        }
      }
      dailyTransactions: Natural with {
        briefly "Daily"
        described as {
          |Daily transactions.
        }
      }
      dailyVolume: Decimal(15,2) with {
        briefly "Volume"
        described as {
          |Daily transaction volume.
        }
      }
      avgTransactionSize: Decimal(10,2) with {
        briefly "Avg size"
        described as {
          |Average transaction.
        }
      }
    } with {
      briefly "Wallet statistics"
      described as {
        |Platform wallet metrics.
      }
    }
    handler AnalyticsHandler is {
      on defaultMethodSet: event Wallet.DefaultMethodSet is {
        tell command WalletContext.WalletRepository.PersistDefaultMethodSet(walletId = defaultMethodSet.walletId, methodId = defaultMethodSet.methodId, setAt = defaultMethodSet.setAt) to repository WalletContext.WalletRepository
        do "apply DefaultMethodSet to the WalletAnalytics projection"
      }
      on fundsReceived: event Wallet.FundsReceived is {
        tell command WalletContext.WalletRepository.PersistFundsReceived(walletId = fundsReceived.walletId, transactionId = fundsReceived.transactionId, senderWalletId = fundsReceived.senderWalletId, amount = fundsReceived.amount, newBalance = fundsReceived.newBalance, receivedAt = fundsReceived.receivedAt) to repository WalletContext.WalletRepository
        do "apply FundsReceived to the WalletAnalytics projection"
      }
      on fundsWithdrawn: event Wallet.FundsWithdrawn is {
        tell command WalletContext.WalletRepository.PersistFundsWithdrawn(walletId = fundsWithdrawn.walletId, transactionId = fundsWithdrawn.transactionId, withdrawal = fundsWithdrawn.withdrawal, newBalance = fundsWithdrawn.newBalance, withdrawnAt = fundsWithdrawn.withdrawnAt) to repository WalletContext.WalletRepository
        do "apply FundsWithdrawn to the WalletAnalytics projection"
      }
      on paymentMethodAdded: event Wallet.PaymentMethodAdded is {
        tell command WalletContext.WalletRepository.PersistPaymentMethodAdded(walletId = paymentMethodAdded.walletId, method = paymentMethodAdded.method, addedAt = paymentMethodAdded.addedAt) to repository WalletContext.WalletRepository
        do "apply PaymentMethodAdded to the WalletAnalytics projection"
      }
      on paymentMethodRemoved: event Wallet.PaymentMethodRemoved is {
        tell command WalletContext.WalletRepository.PersistPaymentMethodRemoved(walletId = paymentMethodRemoved.walletId, methodId = paymentMethodRemoved.methodId, removedAt = paymentMethodRemoved.removedAt) to repository WalletContext.WalletRepository
        do "apply PaymentMethodRemoved to the WalletAnalytics projection"
      }
      on walletClosed: event Wallet.WalletClosed is {
        tell command WalletContext.WalletRepository.PersistWalletClosed(walletId = walletClosed.walletId, reason = walletClosed.reason, closedAt = walletClosed.closedAt) to repository WalletContext.WalletRepository
        do "apply WalletClosed to the WalletAnalytics projection"
      }
      on walletReactivated: event Wallet.WalletReactivated is {
        tell command WalletContext.WalletRepository.PersistWalletReactivated(walletId = walletReactivated.walletId, reactivatedAt = walletReactivated.reactivatedAt) to repository WalletContext.WalletRepository
        do "apply WalletReactivated to the WalletAnalytics projection"
      }
      on walletSuspended: event Wallet.WalletSuspended is {
        tell command WalletContext.WalletRepository.PersistWalletSuspended(walletId = walletSuspended.walletId, reason = walletSuspended.reason, suspendedAt = walletSuspended.suspendedAt) to repository WalletContext.WalletRepository
        do "apply WalletSuspended to the WalletAnalytics projection"
      }
      on walletCreated: event Wallet.WalletCreated is {
        tell command WalletContext.WalletRepository.PersistWalletCreated(walletId = walletCreated.walletId, userId = walletCreated.userId, currency = walletCreated.currency, createdAt = walletCreated.createdAt) to repository WalletContext.WalletRepository
      }
      on paymentMade: event Wallet.PaymentMade is {
        tell command WalletContext.WalletRepository.PersistPaymentMade(walletId = paymentMade.walletId, transactionId = paymentMade.transactionId, payment = paymentMade.payment, newBalance = paymentMade.newBalance, paidAt = paymentMade.paidAt) to repository WalletContext.WalletRepository
      }
      on fundsTransferred: event Wallet.FundsTransferred is {
        tell command WalletContext.WalletRepository.PersistFundsTransferred(walletId = fundsTransferred.walletId, transactionId = fundsTransferred.transactionId, transfer = fundsTransferred.transfer, newBalance = fundsTransferred.newBalance, transferredAt = fundsTransferred.transferredAt) to repository WalletContext.WalletRepository
      }
      on balanceToppedUp: event Wallet.BalanceToppedUp is {
        tell command WalletContext.WalletRepository.PersistBalanceToppedUp(walletId = balanceToppedUp.walletId, topUp = balanceToppedUp.topUp, newBalance = balanceToppedUp.newBalance, toppedUpAt = balanceToppedUp.toppedUpAt) to repository WalletContext.WalletRepository
      }
    } with {
      briefly "Maintains wallet analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Wallet analytics projections"
    described as {
      |Maintains wallet platform analytics data.
    }
  }
  streamlet WalletEventSplit as split is {
    outlet WalletEventSplitToToTokenizationService is type WalletEvent
    outlet WalletEventSplitToToPaymentProcessorService is type WalletEvent
    outlet WalletEventSplitToToNotificationService is type WalletEvent
    outlet WalletEventSplitToToIdentityService is type WalletEvent
    outlet WalletEventSplitToToFraudService is type WalletEvent
    outlet WalletEventSplitToToBankTransferService is type WalletEvent
    inlet WalletEventSplitIn is type WalletEvent    outlet WalletEventSplitToWalletAnalytics is type WalletEvent
    handler WalletEventSplitHandler is {
      on walletCreated: event Wallet.WalletCreated is {
        send walletCreated to outlet WalletEventSplitToWalletAnalytics
        send walletCreated to outlet WalletEventSplitToToIdentityService
        tell walletCreated to entity WalletContext.Wallet
      }
      on paymentMethodAdded: event Wallet.PaymentMethodAdded is {
        send paymentMethodAdded to outlet WalletEventSplitToWalletAnalytics
        send paymentMethodAdded to outlet WalletEventSplitToToTokenizationService
        tell paymentMethodAdded to entity WalletContext.Wallet
      }
      on paymentMethodRemoved: event Wallet.PaymentMethodRemoved is {
        send paymentMethodRemoved to outlet WalletEventSplitToWalletAnalytics
        tell paymentMethodRemoved to entity WalletContext.Wallet
      }
      on defaultMethodSet: event Wallet.DefaultMethodSet is {
        send defaultMethodSet to outlet WalletEventSplitToWalletAnalytics
        tell defaultMethodSet to entity WalletContext.Wallet
      }
      on balanceToppedUp: event Wallet.BalanceToppedUp is {
        send balanceToppedUp to outlet WalletEventSplitToWalletAnalytics
        send balanceToppedUp to outlet WalletEventSplitToToBankTransferService
        tell balanceToppedUp to entity WalletContext.Wallet
      }
      on paymentMade: event Wallet.PaymentMade is {
        send paymentMade to outlet WalletEventSplitToWalletAnalytics
        send paymentMade to outlet WalletEventSplitToToPaymentProcessorService
        send paymentMade to outlet WalletEventSplitToToNotificationService
        send paymentMade to outlet WalletEventSplitToToFraudService
        tell paymentMade to entity WalletContext.Wallet
      }
      on fundsTransferred: event Wallet.FundsTransferred is {
        send fundsTransferred to outlet WalletEventSplitToWalletAnalytics
        tell fundsTransferred to entity WalletContext.Wallet
      }
      on fundsReceived: event Wallet.FundsReceived is {
        send fundsReceived to outlet WalletEventSplitToWalletAnalytics
        tell fundsReceived to entity WalletContext.Wallet by walletId
      }
      on fundsWithdrawn: event Wallet.FundsWithdrawn is {
        send fundsWithdrawn to outlet WalletEventSplitToWalletAnalytics
        tell fundsWithdrawn to entity WalletContext.Wallet
      }
      on walletSuspended: event Wallet.WalletSuspended is {
        send walletSuspended to outlet WalletEventSplitToWalletAnalytics
        tell walletSuspended to entity WalletContext.Wallet
      }
      on walletReactivated: event Wallet.WalletReactivated is {
        send walletReactivated to outlet WalletEventSplitToWalletAnalytics
        tell walletReactivated to entity WalletContext.Wallet
      }
      on walletClosed: event Wallet.WalletClosed is {
        send walletClosed to outlet WalletEventSplitToWalletAnalytics
        tell walletClosed to entity WalletContext.Wallet
      }
      on other is {
        error "Unexpected message for processor WalletEventSplit"
      }
    } with {
      briefly "Wallet event fan-out handler"
      described as {
        |Delivers each Wallet event to all of its consumers.
      }
    }
  } with {
    briefly "Wallet event fan-out"
    described as {
      |Fans Wallet events out to the repository and projectors.
    }
  }
  connector 'ToTokenizationService Feed' is from outlet WalletContext.WalletEventSplit.WalletEventSplitToToTokenizationService to inlet WalletContext.ToTokenizationService.ToTokenizationServiceIn with {
    briefly "The Wallet events ToTokenizationService translates, on their way to it"
  }
  connector 'ToPaymentProcessorService Feed' is from outlet WalletContext.WalletEventSplit.WalletEventSplitToToPaymentProcessorService to inlet WalletContext.ToPaymentProcessorService.ToPaymentProcessorServiceIn with {
    briefly "The Wallet events ToPaymentProcessorService translates, on their way to it"
  }
  connector 'ToNotificationService Feed' is from outlet WalletContext.WalletEventSplit.WalletEventSplitToToNotificationService to inlet WalletContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The Wallet events ToNotificationService translates, on their way to it"
  }
  connector 'ToIdentityService Feed' is from outlet WalletContext.WalletEventSplit.WalletEventSplitToToIdentityService to inlet WalletContext.ToIdentityService.ToIdentityServiceIn with {
    briefly "The Wallet events ToIdentityService translates, on their way to it"
  }
  connector 'ToFraudService Feed' is from outlet WalletContext.WalletEventSplit.WalletEventSplitToToFraudService to inlet WalletContext.ToFraudService.ToFraudServiceIn with {
    briefly "The Wallet events ToFraudService translates, on their way to it"
  }
  connector 'ToBankTransferService Feed' is from outlet WalletContext.WalletEventSplit.WalletEventSplitToToBankTransferService to inlet WalletContext.ToBankTransferService.ToBankTransferServiceIn with {
    briefly "The Wallet events ToBankTransferService translates, on their way to it"
  }
  connector 'WalletEvent Stream' is from outlet WalletContext.Wallet.WalletEvents2 to inlet WalletContext.WalletEventSplit.WalletEventSplitIn with {
    briefly "Wallet events, fanned out to storage and read models"
  }
  connector 'WalletAnalytics Feed' is from outlet WalletContext.WalletEventSplit.WalletEventSplitToWalletAnalytics to inlet WalletContext.WalletAnalytics.WalletAnalyticsFromWallet with {
    briefly "Wallet events feeding the WalletAnalytics projection"
  }
  connector 'WalletAnalytics Storage' is from outlet WalletContext.WalletAnalytics.WalletAnalyticsToRepository to inlet WalletContext.WalletRepository.WalletRepositoryFromWalletAnalytics with {
    briefly "WalletAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for digital wallets"
  described as {
    | The WalletContext is the bounded context for digital
    | wallet management, payments, and P2P transfers.
  }
}
