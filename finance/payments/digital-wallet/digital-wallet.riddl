// Digital Wallet Domain Model
// Mobile payment wallets, stored value, and P2P transfers
domain DigitalWallet is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user WalletHolder is "person using digital wallet" with {
    briefly "Wallet Holder"
    described as {
      |Person with a digital wallet account.
    }
  }
  user WalletOperator is "person managing wallet platform" with {
    briefly "Wallet Operator"
    described as {
      |Person monitoring wallet operations.
    }
  }
  epic WalletPaymentEpic is {
    user WalletHolder wants to "to make payments from wallet" so that "transactions are convenient and fast"
    case ExecuteWalletPayment is {
      user WalletHolder wants to "to pay for a purchase" so that "the transaction completes smoothly"
      step is "User selects" "payment method" "from wallet" with {
        briefly "Select method"
        described as {
          |Choose funding source.
        }
      }
      step is "System validates" "wallet balance or card" "availability" with {
        briefly "Validate funds"
        described as {
          |Check availability.
        }
      }
      step take input DigitalWalletApp.DigitalWalletScreen.MakePaymentInput from user WalletHolder with {
        briefly "Pay"
        described as {
          |Execute payment.
        }
      }
      step is "System processes" "payment" "and updates balance" with {
        briefly "Process"
        described as {
          |Complete payment.
        }
      }
    } with {
      briefly "Payment workflow"
      described as {
        |Standard wallet payment flow.
      }
    }
  } with {
    briefly "Wallet payments"
    described as {
      | Epic covering wallet payments including balance,
      | card-backed, and P2P transfers.
    }
  }
  include "WalletContext.riddl"
  include "external-contexts.riddl"
  application context DigitalWalletApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in DigitalWallet are delivered.
      }
    }
    group DigitalWalletScreen is {
      input MakePaymentInput acquires command WalletContext.Wallet.MakePayment with {
        briefly "Make payment control"
        described as {
          |The control through which a user submits the make payment request.
        }
      }
    } with {
      briefly "Digital wallet screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppWalletCommands is type WalletContext.Wallet.WalletCommand
    inlet AppWalletRepositoryResponses is type WalletContext.Wallet.WalletResult    handler DigitalWalletAppHandler is {
      on other is {
        error "Unexpected message for application context DigitalWalletApp"
      }
    } with {
      briefly "DigitalWalletApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "DigitalWalletApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'WalletCommand Stream' is from outlet DigitalWalletApp.AppWalletCommands to inlet WalletContext.Wallet.WalletCommands with {
    option persistent()
    briefly "Wallet commands from the application"
  }
  connector 'WalletResult Stream' is from outlet WalletContext.WalletRepository.WalletRepositoryResponses to inlet DigitalWalletApp.AppWalletRepositoryResponses with {
    option persistent()
    briefly "Wallet query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet DigitalWalletApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Digital wallet domain"
  described as {
    | The DigitalWallet domain handles mobile payments,
    | stored value, P2P transfers, and payment tokenization.
  }
}
