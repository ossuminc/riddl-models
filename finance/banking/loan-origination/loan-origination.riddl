// Loan Origination Domain Model
// End-to-end loan application and funding process
domain LoanOrigination is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Borrower is "person applying for a loan" with {
    briefly "Borrower"
    described as {
      |Person requesting credit.
    }
  }
  user LoanOfficer is "person processing loan applications" with {
    briefly "Loan Officer"
    described as {
      |Person managing loan applications.
    }
  }
  user LoanProcessor is "person verifying loan documents" with {
    briefly "Loan Processor"
    described as {
      |Person handling document verification.
    }
  }
  epic LoanApplicationEpic is {
    user Borrower wants to "to obtain financing" so that "purchases can be made"
    case SubmitLoanApplication is {
      user Borrower wants to "to apply for a loan" so that "the request can be processed"
      step is "Borrower completes" "loan application form" "with details" with {
        briefly "Complete form"
        described as {
          |Fill application.
        }
      }
      step is "System validates" "application data" "for completeness" with {
        briefly "Validate data"
        described as {
          |Check completeness.
        }
      }
      step take input LoanOriginationApp.LoanOriginationScreen.SubmitApplicationInput from user Borrower with {
        briefly "Submit"
        described as {
          |Submit application.
        }
      }
      step is "System initiates" "loan processing workflow" "automatically" with {
        briefly "Start workflow"
        described as {
          |Begin processing.
        }
      }
    } with {
      briefly "Application workflow"
      described as {
        |Loan application submission process.
      }
    }
  } with {
    briefly "Loan origination"
    described as {
      | Epic covering loan origination from application
      | through approval, closing, and funding.
    }
  }
  include "LoanContext.riddl"
  include "external-contexts.riddl"
  application context LoanOriginationApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in LoanOrigination are delivered.
      }
    }
    group LoanOriginationScreen is {
      input SubmitApplicationInput acquires command LoanContext.Loan.SubmitApplication with {
        briefly "Submit application control"
        described as {
          |The control through which a user submits the submit application request.
        }
      }
    } with {
      briefly "Loan origination screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppLoanCommands is type LoanContext.Loan.LoanCommand
    inlet AppLoanRepositoryResponses is type LoanContext.Loan.LoanResult    handler LoanOriginationAppHandler is {
      on other is {
        error "Unexpected message for application context LoanOriginationApp"
      }
    } with {
      briefly "LoanOriginationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "LoanOriginationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LoanCommandStream is from outlet LoanOriginationApp.AppLoanCommands to inlet LoanContext.Loan.LoanCommands with {
    option persistent()
    briefly "Loan commands from the application"
  }
  connector LoanQueryResults is from outlet LoanContext.LoanRepository.LoanRepositoryResponses to inlet LoanOriginationApp.AppLoanRepositoryResponses with {
    option persistent()
    briefly "Loan query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet LoanOriginationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Loan origination domain"
  described as {
    | The LoanOrigination domain handles loan applications,
    | document collection, underwriting, and funding.
  }
}
