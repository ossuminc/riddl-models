// Loan Origination - Loan Context
context LoanContext as router is {
  inlet LoanCommandStreamIn is type LoanCommand  outlet LoanCommandStreamOut is type LoanCommand
  inlet LoanResultStreamIn is type Loan.LoanResult  outlet LoanResultStreamOut is type Loan.LoanResult
  handler LoanContextBoundary is {
    on submitApplication: command Loan.SubmitApplication is {
      send submitApplication to outlet LoanContext.LoanCommandStreamOut
    }
    on requestDocuments: command Loan.RequestDocuments is {
      send requestDocuments to outlet LoanContext.LoanCommandStreamOut
    }
    on uploadDocument: command Loan.UploadDocument is {
      send uploadDocument to outlet LoanContext.LoanCommandStreamOut
    }
    on reviewDocument: command Loan.ReviewDocument is {
      send reviewDocument to outlet LoanContext.LoanCommandStreamOut
    }
    on sendToUnderwriting: command Loan.SendToUnderwriting is {
      send sendToUnderwriting to outlet LoanContext.LoanCommandStreamOut
    }
    on approveLoan: command Loan.ApproveLoan is {
      send approveLoan to outlet LoanContext.LoanCommandStreamOut
    }
    on conditionallyApproveLoan: command Loan.ConditionallyApproveLoan is {
      send conditionallyApproveLoan to outlet LoanContext.LoanCommandStreamOut
    }
    on declineLoan: command Loan.DeclineLoan is {
      send declineLoan to outlet LoanContext.LoanCommandStreamOut
    }
    on acceptOffer: command Loan.AcceptOffer is {
      send acceptOffer to outlet LoanContext.LoanCommandStreamOut
    }
    on scheduleClosing: command Loan.ScheduleClosing is {
      send scheduleClosing to outlet LoanContext.LoanCommandStreamOut
    }
    on fundLoan: command Loan.FundLoan is {
      send fundLoan to outlet LoanContext.LoanCommandStreamOut
    }
    on withdrawApplication: command Loan.WithdrawApplication is {
      send withdrawApplication to outlet LoanContext.LoanCommandStreamOut
    }
    on initializeLoan: command Loan.InitializeLoan is {
      send initializeLoan to outlet LoanContext.LoanCommandStreamOut
    }
    on loanResult: result Loan.LoanResult is {
      send loanResult to outlet LoanContext.LoanResultStreamOut
    }
    on other is {
      error "Unexpected message at the LoanContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'LoanCommand Stream Intake' is from outlet LoanContext.LoanCommandStreamOut to inlet LoanContext.Loan.LoanCommands  connector 'LoanResult Stream Egress' is from outlet LoanContext.LoanRepository.LoanRepositoryResponses to inlet LoanContext.LoanResultStreamIn  adaptor FromCreditDecisioningService from context CreditDecisioningService is { 
    handler FromCreditDecisioningServiceHandler is {
      on event CreditDecisioningService.DecisionReceived is {
        do "the model receives decision received"
      }
      on other is {
        error "Unexpected message for adaptor FromCreditDecisioningService"
      }
    } with {
      briefly "from credit decisioning service"
      described as {
        |Carries messages from the external CreditDecisioningService.
      }
    }
  } with {
    briefly "CreditDecisioningService integration"
    described as {
      |The model's side of the CreditDecisioningService conversation.
    }
  }
  adaptor ToCreditDecisioningService to context CreditDecisioningService is { 
    handler ToCreditDecisioningServiceHandler is {
      on command CreditDecisioningService.RequestDecision is {
        do "the model sends request decision"
      }
      on other is {
        error "Unexpected message for adaptor ToCreditDecisioningService"
      }
    } with {
      briefly "to credit decisioning service"
      described as {
        |Carries messages to the external CreditDecisioningService.
      }
    }
  } with {
    briefly "CreditDecisioningService integration"
    described as {
      |The model's side of the CreditDecisioningService conversation.
    }
  }
  adaptor FromDisbursementService from context DisbursementService is { 
    handler FromDisbursementServiceHandler is {
      on event DisbursementService.FundsDisbursed is {
        do "the model receives funds disbursed"
      }
      on other is {
        error "Unexpected message for adaptor FromDisbursementService"
      }
    } with {
      briefly "from disbursement service"
      described as {
        |Carries messages from the external DisbursementService.
      }
    }
  } with {
    briefly "DisbursementService integration"
    described as {
      |The model's side of the DisbursementService conversation.
    }
  }
  adaptor ToDisbursementService to context DisbursementService is { 
    handler ToDisbursementServiceHandler is {
      on command DisbursementService.DisburseFunds is {
        do "the model sends disburse funds"
      }
      on other is {
        error "Unexpected message for adaptor ToDisbursementService"
      }
    } with {
      briefly "to disbursement service"
      described as {
        |Carries messages to the external DisbursementService.
      }
    }
  } with {
    briefly "DisbursementService integration"
    described as {
      |The model's side of the DisbursementService conversation.
    }
  }
  adaptor FromDocumentStorageService from context DocumentStorageService is { 
    handler FromDocumentStorageServiceHandler is {
      on event DocumentStorageService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentStorageService"
      }
    } with {
      briefly "from document storage service"
      described as {
        |Carries messages from the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor ToDocumentStorageService to context DocumentStorageService is { 
    handler ToDocumentStorageServiceHandler is {
      on command DocumentStorageService.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentStorageService"
      }
    } with {
      briefly "to document storage service"
      described as {
        |Carries messages to the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor FromDocumentVerificationService from context DocumentVerificationService is { 
    handler FromDocumentVerificationServiceHandler is {
      on event DocumentVerificationService.DocumentVerified is {
        do "the model receives document verified"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentVerificationService"
      }
    } with {
      briefly "from document verification service"
      described as {
        |Carries messages from the external DocumentVerificationService.
      }
    }
  } with {
    briefly "DocumentVerificationService integration"
    described as {
      |The model's side of the DocumentVerificationService conversation.
    }
  }
  adaptor ToDocumentVerificationService to context DocumentVerificationService is { 
    handler ToDocumentVerificationServiceHandler is {
      on command DocumentVerificationService.VerifyDocument is {
        do "the model sends verify document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentVerificationService"
      }
    } with {
      briefly "to document verification service"
      described as {
        |Carries messages to the external DocumentVerificationService.
      }
    }
  } with {
    briefly "DocumentVerificationService integration"
    described as {
      |The model's side of the DocumentVerificationService conversation.
    }
  }
  adaptor FromEmploymentVerificationService from context EmploymentVerificationService is { 
    handler FromEmploymentVerificationServiceHandler is {
      on event EmploymentVerificationService.EmploymentVerified is {
        do "the model receives employment verified"
      }
      on other is {
        error "Unexpected message for adaptor FromEmploymentVerificationService"
      }
    } with {
      briefly "from employment verification service"
      described as {
        |Carries messages from the external EmploymentVerificationService.
      }
    }
  } with {
    briefly "EmploymentVerificationService integration"
    described as {
      |The model's side of the EmploymentVerificationService conversation.
    }
  }
  adaptor ToEmploymentVerificationService to context EmploymentVerificationService is { 
    handler ToEmploymentVerificationServiceHandler is {
      on command EmploymentVerificationService.VerifyEmployment is {
        do "the model sends verify employment"
      }
      on other is {
        error "Unexpected message for adaptor ToEmploymentVerificationService"
      }
    } with {
      briefly "to employment verification service"
      described as {
        |Carries messages to the external EmploymentVerificationService.
      }
    }
  } with {
    briefly "EmploymentVerificationService integration"
    described as {
      |The model's side of the EmploymentVerificationService conversation.
    }
  }
  adaptor FromIncomeVerificationService from context IncomeVerificationService is { 
    handler FromIncomeVerificationServiceHandler is {
      on event IncomeVerificationService.IncomeVerified is {
        do "the model receives income verified"
      }
      on other is {
        error "Unexpected message for adaptor FromIncomeVerificationService"
      }
    } with {
      briefly "from income verification service"
      described as {
        |Carries messages from the external IncomeVerificationService.
      }
    }
  } with {
    briefly "IncomeVerificationService integration"
    described as {
      |The model's side of the IncomeVerificationService conversation.
    }
  }
  adaptor ToIncomeVerificationService to context IncomeVerificationService is { 
    handler ToIncomeVerificationServiceHandler is {
      on command IncomeVerificationService.VerifyIncome is {
        do "the model sends verify income"
      }
      on other is {
        error "Unexpected message for adaptor ToIncomeVerificationService"
      }
    } with {
      briefly "to income verification service"
      described as {
        |Carries messages to the external IncomeVerificationService.
      }
    }
  } with {
    briefly "IncomeVerificationService integration"
    described as {
      |The model's side of the IncomeVerificationService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendLoanNotification is {
        do "the model sends send loan notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "Loan.riddl"
  // Repository for loan persistence
  repository LoanRepository as merge is {
    command PersistApplicationSubmitted is  {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApplicationSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ApplicationSubmitted"
      described as {
        |Instructs this repository to apply ApplicationSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLoanApproved is  {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row LoanApproved applies to.
        }
      }
    } with {
      briefly "Persist LoanApproved"
      described as {
        |Instructs this repository to apply LoanApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLoanDeclined is  {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row LoanDeclined applies to.
        }
      }
    } with {
      briefly "Persist LoanDeclined"
      described as {
        |Instructs this repository to apply LoanDeclined to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLoanFunded is  {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row LoanFunded applies to.
        }
      }
    } with {
      briefly "Persist LoanFunded"
      described as {
        |Instructs this repository to apply LoanFunded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet LoanRepositoryFromLoan is type LoanEvent    inlet LoanRepositoryFromLoanAnalytics is type LoanEvent    outlet LoanRepositoryResponses is type Loan.LoanResult
    record StoredLoan is  {
      loanId: LoanId with {
        briefly "loanId"
        described as {
          |The loanId column of the stored loan row.
        }
      }
      borrower: BorrowerInfo with {
        briefly "borrower"
        described as {
          |The borrower column of the stored loan row.
        }
      }
    } with {
      briefly "Stored loan row"
      described as {
        |The persistence shape of loan data as this repository stores it.
      }
    }
    schema LoanData is relational
      of loans as type StoredLoan
        index on field StoredLoan.loanId
        index on field StoredLoan.borrower.borrowerId
 with {
      briefly "Loan data schema"
      described as {
        |The relational schema holding loan data for the LoanRepository.
      }
    }
    handler LoanPersistence is {
      on persistApplicationSubmitted: command PersistApplicationSubmitted is {
        do "apply ApplicationSubmitted to the stored row"
      }
      on persistLoanApproved: command PersistLoanApproved is {
        do "apply LoanApproved to the stored row"
      }
      on persistLoanDeclined: command PersistLoanDeclined is {
        do "apply LoanDeclined to the stored row"
      }
      on persistLoanFunded: command PersistLoanFunded is {
        do "apply LoanFunded to the stored row"
      }
      on query GetLoanStats is {
        let loanStatsView: type LoanStatsView = prompt("read the loan stats projection")
        reply loanStatsView
      }
      on submitApplication: command Loan.SubmitApplication is {
        tell event Loan.ApplicationSubmitted(loanId = submitApplication.loanId, borrower = submitApplication.borrower, request = submitApplication.request) to entity LoanContext.Loan
      }
      on requestDocuments: command Loan.RequestDocuments is {
        tell event Loan.DocumentsRequested(loanId = requestDocuments.loanId, requiredDocuments = requestDocuments.requiredDocuments) to entity LoanContext.Loan
      }
      on uploadDocument: command Loan.UploadDocument is {
        tell event Loan.DocumentUploaded(loanId = uploadDocument.loanId, document = uploadDocument.document) to entity LoanContext.Loan
      }
      on reviewDocument: command Loan.ReviewDocument is {
        tell event Loan.DocumentReviewed(loanId = reviewDocument.loanId, documentId = reviewDocument.documentId, accepted = reviewDocument.accepted, rejectionReason = reviewDocument.rejectionReason) to entity LoanContext.Loan
      }
      on sendToUnderwriting: command Loan.SendToUnderwriting is {
        tell event Loan.SentToUnderwriting(loanId = sendToUnderwriting.loanId) to entity LoanContext.Loan
      }
      on approveLoan: command Loan.ApproveLoan is {
        tell event Loan.LoanApproved(loanId = approveLoan.loanId, terms = approveLoan.terms, approvedBy = approveLoan.approvedBy) to entity LoanContext.Loan
      }
      on conditionallyApproveLoan: command Loan.ConditionallyApproveLoan is {
        tell event Loan.LoanConditionallyApproved(loanId = conditionallyApproveLoan.loanId, terms = conditionallyApproveLoan.terms, conditions = conditionallyApproveLoan.conditions) to entity LoanContext.Loan
      }
      on declineLoan: command Loan.DeclineLoan is {
        tell event Loan.LoanDeclined(loanId = declineLoan.loanId, reasons = declineLoan.reasons, declinedBy = declineLoan.declinedBy) to entity LoanContext.Loan
      }
      on acceptOffer: command Loan.AcceptOffer is {
        tell event Loan.OfferAccepted(loanId = acceptOffer.loanId, acceptedAt = acceptOffer.acceptedAt) to entity LoanContext.Loan
      }
      on scheduleClosing: command Loan.ScheduleClosing is {
        tell event Loan.ClosingScheduled(loanId = scheduleClosing.loanId, closing = scheduleClosing.closing) to entity LoanContext.Loan
      }
      on fundLoan: command Loan.FundLoan is {
        tell event Loan.LoanFunded(loanId = fundLoan.loanId, funding = fundLoan.funding) to entity LoanContext.Loan
      }
      on withdrawApplication: command Loan.WithdrawApplication is {
        tell event Loan.ApplicationWithdrawn(loanId = withdrawApplication.loanId, reason = withdrawApplication.reason) to entity LoanContext.Loan
      }
    } with {
      briefly "Persists loan commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Loan data persistence"
    described as {
      | The LoanRepository provides persistent storage for
      | loan applications, documents, and status history.
    }
  }
  // Projector for loan analytics
  query GetLoanStats is  {
    loanStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which loan stats to retrieve.
      }
    }
  } with {
    briefly "Get loan stats"
    described as {
      |Retrieves the loan stats projection.
    }
  }
  result LoanStatsView is  {
    loanStats: LoanAnalytics.LoanStats with {
      briefly "Loan stats"
      described as {
        |The loan stats being returned.
      }
    }
  } with {
    briefly "Loan stats view"
    described as {
      |Read model view carrying the loan stats projection.
    }
  }
  projector LoanAnalytics as flow is {
    updates repository LoanContext.LoanRepository
    inlet LoanAnalyticsFromLoan is type LoanEvent    outlet LoanAnalyticsOut is type LoanEvent
    record LoanStats is  {
      totalApplications: Natural with {
        briefly "Total"
        described as {
          |Total applications.
        }
      }
      approvalRate: Decimal(5,4) with {
        briefly "Approval"
        described as {
          |Approval rate.
        }
      }
      fundingRate: Decimal(5,4) with {
        briefly "Funding"
        described as {
          |Funding rate.
        }
      }
      avgLoanAmount: Decimal(12,2) with {
        briefly "Avg amount"
        described as {
          |Average loan amount.
        }
      }
      avgProcessingTime: Duration with {
        briefly "Avg time"
        described as {
          |Average processing time.
        }
      }
      totalFunded: Decimal(15,2) with {
        briefly "Total funded"
        described as {
          |Total amount funded.
        }
      }
    } with {
      briefly "Loan statistics"
      described as {
        |Loan origination metrics.
      }
    }
    handler AnalyticsHandler is {
      on applicationSubmitted: event Loan.ApplicationSubmitted is {
        tell command LoanContext.LoanRepository.PersistApplicationSubmitted(loanId = applicationSubmitted.loanId) to repository LoanContext.LoanRepository
      }
      on loanApproved: event Loan.LoanApproved is {
        tell command LoanContext.LoanRepository.PersistLoanApproved(loanId = loanApproved.loanId) to repository LoanContext.LoanRepository
      }
      on loanFunded: event Loan.LoanFunded is {
        tell command LoanContext.LoanRepository.PersistLoanFunded(loanId = loanFunded.loanId) to repository LoanContext.LoanRepository
      }
      on loanDeclined: event Loan.LoanDeclined is {
        tell command LoanContext.LoanRepository.PersistLoanDeclined(loanId = loanDeclined.loanId) to repository LoanContext.LoanRepository
      }
    } with {
      briefly "Maintains loan analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Loan analytics projections"
    described as {
      |Maintains loan origination analytics data.
    }
  }
  processor LoanEventSource as source is {
    outlet LoanEvents is type LoanEvent
    handler LoanEventEmitter is {
      on init is {
        let initializeLoan: type InitializeLoan = prompt("the initialize loan that brings this this into existence")
        tell initializeLoan to entity LoanContext.Loan
      }
      on other is {
        error "Unexpected message for source LoanEventSource"
      }
      on applicationSubmitted: event Loan.ApplicationSubmitted is {
        send applicationSubmitted to outlet LoanEvents
      }
      on loanApproved: event Loan.LoanApproved is {
        send loanApproved to outlet LoanEvents
      }
      on loanFunded: event Loan.LoanFunded is {
        send loanFunded to outlet LoanEvents
      }
      on loanDeclined: event Loan.LoanDeclined is {
        send loanDeclined to outlet LoanEvents
      }
      on applicationWithdrawn: event Loan.ApplicationWithdrawn is {
        send applicationWithdrawn to outlet LoanEvents
      }
    } with {
      briefly "Loan event emitter"
      described as {
        |Emits loan lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Loan event source"
    described as {
      |Publishes loan entity events for streaming.
    }
  }
  processor LoanEventSink as sink is {
    inlet IncomingLoanEvents is type LoanEvent    handler LoanEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink LoanEventSink"
      }
      on applicationSubmitted: event Loan.ApplicationSubmitted is {
        tell applicationSubmitted to repository LoanContext.LoanRepository
      }
      on loanFunded: event Loan.LoanFunded is {
        tell loanFunded to repository LoanContext.LoanRepository
      }
    } with {
      briefly "Loan event receiver"
      described as {
        |Receives loan events and persists them.
      }
    }
  } with {
    briefly "Loan event sink"
    described as {
      |Receives loan events from the streaming topology.
    }
  }
  connector LoanEventPipeline is from outlet LoanContext.LoanEventSource.LoanEvents to inlet LoanContext.LoanEventSink.IncomingLoanEvents with {
    briefly "Loan event pipeline"
    described as {
      |Wires loan events from source to sink.
    }
  }
  processor LoanEventSplit as split is {
    inlet LoanEventSplitIn is type LoanEvent    outlet LoanEventSplitToLoanRepository is type LoanEvent
    outlet LoanEventSplitToLoanAnalytics is type LoanEvent
    handler LoanEventSplitHandler is {
      on applicationSubmitted: event Loan.ApplicationSubmitted is {
        send applicationSubmitted to outlet LoanEventSplitToLoanRepository
        send applicationSubmitted to outlet LoanEventSplitToLoanAnalytics
        tell applicationSubmitted to entity LoanContext.Loan
      }
      on documentsRequested: event Loan.DocumentsRequested is {
        send documentsRequested to outlet LoanEventSplitToLoanRepository
        send documentsRequested to outlet LoanEventSplitToLoanAnalytics
        tell documentsRequested to entity LoanContext.Loan
      }
      on documentUploaded: event Loan.DocumentUploaded is {
        send documentUploaded to outlet LoanEventSplitToLoanRepository
        send documentUploaded to outlet LoanEventSplitToLoanAnalytics
        tell documentUploaded to entity LoanContext.Loan
      }
      on documentReviewed: event Loan.DocumentReviewed is {
        send documentReviewed to outlet LoanEventSplitToLoanRepository
        send documentReviewed to outlet LoanEventSplitToLoanAnalytics
        tell documentReviewed to entity LoanContext.Loan
      }
      on sentToUnderwriting: event Loan.SentToUnderwriting is {
        send sentToUnderwriting to outlet LoanEventSplitToLoanRepository
        send sentToUnderwriting to outlet LoanEventSplitToLoanAnalytics
        tell sentToUnderwriting to entity LoanContext.Loan
      }
      on loanApproved: event Loan.LoanApproved is {
        send loanApproved to outlet LoanEventSplitToLoanRepository
        send loanApproved to outlet LoanEventSplitToLoanAnalytics
        tell loanApproved to entity LoanContext.Loan
      }
      on loanConditionallyApproved: event Loan.LoanConditionallyApproved is {
        send loanConditionallyApproved to outlet LoanEventSplitToLoanRepository
        send loanConditionallyApproved to outlet LoanEventSplitToLoanAnalytics
        tell loanConditionallyApproved to entity LoanContext.Loan
      }
      on loanDeclined: event Loan.LoanDeclined is {
        send loanDeclined to outlet LoanEventSplitToLoanRepository
        send loanDeclined to outlet LoanEventSplitToLoanAnalytics
        tell loanDeclined to entity LoanContext.Loan
      }
      on offerAccepted: event Loan.OfferAccepted is {
        send offerAccepted to outlet LoanEventSplitToLoanRepository
        send offerAccepted to outlet LoanEventSplitToLoanAnalytics
        tell offerAccepted to entity LoanContext.Loan
      }
      on closingScheduled: event Loan.ClosingScheduled is {
        send closingScheduled to outlet LoanEventSplitToLoanRepository
        send closingScheduled to outlet LoanEventSplitToLoanAnalytics
        tell closingScheduled to entity LoanContext.Loan
      }
      on loanFunded: event Loan.LoanFunded is {
        send loanFunded to outlet LoanEventSplitToLoanRepository
        send loanFunded to outlet LoanEventSplitToLoanAnalytics
        tell loanFunded to entity LoanContext.Loan
      }
      on applicationWithdrawn: event Loan.ApplicationWithdrawn is {
        send applicationWithdrawn to outlet LoanEventSplitToLoanRepository
        send applicationWithdrawn to outlet LoanEventSplitToLoanAnalytics
        tell applicationWithdrawn to entity LoanContext.Loan
      }
      on other is {
        error "Unexpected message for processor LoanEventSplit"
      }
    } with {
      briefly "Loan event fan-out handler"
      described as {
        |Delivers each Loan event to all of its consumers.
      }
    }
  } with {
    briefly "Loan event fan-out"
    described as {
      |Fans Loan events out to the repository and projectors.
    }
  }
  connector 'LoanEvent Stream' is from outlet LoanContext.Loan.LoanEvents2 to inlet LoanContext.LoanEventSplit.LoanEventSplitIn with {
    briefly "Loan events, fanned out to storage and read models"
  }
  connector 'LoanEvent Storage' is from outlet LoanContext.LoanEventSplit.LoanEventSplitToLoanRepository to inlet LoanContext.LoanRepository.LoanRepositoryFromLoan with {
    briefly "Loan events on their way to storage"
  }
  connector 'LoanAnalytics Feed' is from outlet LoanContext.LoanEventSplit.LoanEventSplitToLoanAnalytics to inlet LoanContext.LoanAnalytics.LoanAnalyticsFromLoan with {
    briefly "Loan events feeding the LoanAnalytics projection"
  }
  connector 'LoanAnalytics Storage' is from outlet LoanContext.LoanAnalytics.LoanAnalyticsOut to inlet LoanContext.LoanRepository.LoanRepositoryFromLoanAnalytics with {
    briefly "The LoanAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for loan origination"
  described as {
    | The LoanContext is the bounded context for loan
    | application processing, underwriting, and funding.
  }
}
