// Loan Origination - Loan Context
context LoanContext as router is {
  inlet LoanContextFromDisbursementService is command Loan.FundLoan with {
    briefly "What FromDisbursementService makes of that service's news"
  }
  connector 'FromDisbursementService Intake' is from outlet LoanContext.FromDisbursementService.FromDisbursementServiceToLoanContext to inlet LoanContext.LoanContextFromDisbursementService with {
    briefly "What FromDisbursementService makes of that news, on its way in"
  }
  inlet LoanContextFromDocumentVerificationService is command Loan.ReviewDocument with {
    briefly "What FromDocumentVerificationService makes of that service's news"
  }
  connector 'FromDocumentVerificationService Intake' is from outlet LoanContext.FromDocumentVerificationService.FromDocumentVerificationServiceToLoanContext to inlet LoanContext.LoanContextFromDocumentVerificationService with {
    briefly "What FromDocumentVerificationService makes of that news, on its way in"
  }
  inlet LoanCommandStreamIn is type LoanCommand  outlet LoanCommandStreamOut is type LoanCommand
  inlet LoanResultStreamIn is result Loan.LoanResult  outlet LoanResultStreamOut is result Loan.LoanResult
  handler LoanContextBoundary is {
    on submitApplication: command Loan.SubmitApplication is {
      send submitApplication to outlet LoanContext.LoanCommandStreamOut
    }
    on requestDocuments: command Loan.RequestDocuments is {
      send requestDocuments to outlet LoanContext.LoanCommandStreamOut
    }
    on uploadDocument: command Loan.UploadDocument is {
      send uploadDocument to outlet LoanContext.LoanCommandStreamOut
    }
    on reviewDocument: command Loan.ReviewDocument is {
      send reviewDocument to outlet LoanContext.LoanCommandStreamOut
    }
    on sendToUnderwriting: command Loan.SendToUnderwriting is {
      send sendToUnderwriting to outlet LoanContext.LoanCommandStreamOut
    }
    on approveLoan: command Loan.ApproveLoan is {
      send approveLoan to outlet LoanContext.LoanCommandStreamOut
    }
    on conditionallyApproveLoan: command Loan.ConditionallyApproveLoan is {
      send conditionallyApproveLoan to outlet LoanContext.LoanCommandStreamOut
    }
    on declineLoan: command Loan.DeclineLoan is {
      send declineLoan to outlet LoanContext.LoanCommandStreamOut
    }
    on acceptOffer: command Loan.AcceptOffer is {
      send acceptOffer to outlet LoanContext.LoanCommandStreamOut
    }
    on scheduleClosing: command Loan.ScheduleClosing is {
      send scheduleClosing to outlet LoanContext.LoanCommandStreamOut
    }
    on fundLoan: command Loan.FundLoan is {
      send fundLoan to outlet LoanContext.LoanCommandStreamOut
    }
    on withdrawApplication: command Loan.WithdrawApplication is {
      send withdrawApplication to outlet LoanContext.LoanCommandStreamOut
    }
    on loanResult: result Loan.LoanResult is {
      send loanResult to outlet LoanContext.LoanResultStreamOut
    }
    on other is {
      error "Unexpected message at the LoanContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'LoanCommand Stream Intake' is from outlet LoanContext.LoanCommandStreamOut to inlet LoanContext.Loan.LoanCommands  connector 'LoanResult Stream Egress' is from outlet LoanContext.LoanRepository.LoanRepositoryResponses to inlet LoanContext.LoanResultStreamIn  adaptor FromCreditDecisioningService from context CreditDecisioningService is { 
    inlet FromCreditDecisioningServiceIn is event CreditDecisioningService.DecisionReceived    handler FromCreditDecisioningServiceHandler is {
      on decisionReceived: event CreditDecisioningService.DecisionReceived is {
        do "the decision is back; approving, declining or conditioning the loan follows from what it says"
      }
      on other is {
        error "Unexpected message for adaptor FromCreditDecisioningService"
      }
    } with {
      briefly "from credit decisioning service"
      described as {
        |Carries messages from the external CreditDecisioningService.
      }
    }
  } with {
    briefly "CreditDecisioningService integration"
    described as {
      |The model's side of the CreditDecisioningService conversation.
    }
  }
  adaptor ToCreditDecisioningService to context CreditDecisioningService as flow is { 
    inlet ToCreditDecisioningServiceIn is type LoanEvent    outlet ToCreditDecisioningServiceOut is command CreditDecisioningService.RequestDecision
    handler ToCreditDecisioningServiceHandler is {
      on sentToUnderwriting: event Loan.SentToUnderwriting is {
        let item0: type CreditDecisioningService.RequestDecision = prompt("translate the sentToUnderwriting event into a RequestDecision, underwriting being where the decision is actually asked for")
        send item0 to outlet LoanContext.ToCreditDecisioningService.ToCreditDecisioningServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToCreditDecisioningService"
      }
    } with {
      briefly "to credit decisioning service"
      described as {
        |Carries messages to the external CreditDecisioningService.
      }
    }
  } with {
    briefly "CreditDecisioningService integration"
    described as {
      |The model's side of the CreditDecisioningService conversation.
    }
  }
  adaptor FromDisbursementService from context DisbursementService as flow is { 
    inlet FromDisbursementServiceIn is event DisbursementService.FundsDisbursed    outlet FromDisbursementServiceToLoanContext is command Loan.FundLoan
    handler FromDisbursementServiceHandler is {
      on fundsDisbursed: event DisbursementService.FundsDisbursed is {
        let item0: type Loan.FundLoan = prompt("translate the fundsDisbursed event into a FundLoan, money actually reaching the borrower is what funds the loan")
        send item0 to outlet LoanContext.FromDisbursementService.FromDisbursementServiceToLoanContext
      }
      on other is {
        error "Unexpected message for adaptor FromDisbursementService"
      }
    } with {
      briefly "from disbursement service"
      described as {
        |Carries messages from the external DisbursementService.
      }
    }
  } with {
    briefly "DisbursementService integration"
    described as {
      |The model's side of the DisbursementService conversation.
    }
  }
  adaptor ToDisbursementService to context DisbursementService as flow is { 
    inlet ToDisbursementServiceIn is type LoanEvent    outlet ToDisbursementServiceOut is command DisbursementService.DisburseFunds
    handler ToDisbursementServiceHandler is {
      on loanFunded: event Loan.LoanFunded is {
        let payout: type DisbursementService.DisburseFunds = prompt("translate the loanFunded event into a DisburseFunds moving the principal the lender has just committed to advancing")
        send payout to outlet LoanContext.ToDisbursementService.ToDisbursementServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToDisbursementService"
      }
    } with {
      briefly "to disbursement service"
      described as {
        |Carries messages to the external DisbursementService.
      }
    }
  } with {
    briefly "DisbursementService integration"
    described as {
      |The model's side of the DisbursementService conversation.
    }
  }
  adaptor FromDocumentStorageService from context DocumentStorageService is { 
    inlet FromDocumentStorageServiceIn is event DocumentStorageService.DocumentStored    handler FromDocumentStorageServiceHandler is {
      on documentStored: event DocumentStorageService.DocumentStored is {
        do "the document is safe; the loan already records what it was for"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentStorageService"
      }
    } with {
      briefly "from document storage service"
      described as {
        |Carries messages from the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor ToDocumentStorageService to context DocumentStorageService as flow is { 
    inlet ToDocumentStorageServiceIn is type LoanEvent    outlet ToDocumentStorageServiceOut is command DocumentStorageService.StoreDocument
    handler ToDocumentStorageServiceHandler is {
      on documentUploaded: event DocumentUploaded is {
        let artifact: type DocumentStorageService.StoreDocument = prompt("translate the documentUploaded event into a StoreDocument putting the applicant's paperwork into the file of record")
        send artifact to outlet LoanContext.ToDocumentStorageService.ToDocumentStorageServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentStorageService"
      }
    } with {
      briefly "to document storage service"
      described as {
        |Carries messages to the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor FromDocumentVerificationService from context DocumentVerificationService as flow is { 
    inlet FromDocumentVerificationServiceIn is event DocumentVerificationService.DocumentVerified    outlet FromDocumentVerificationServiceToLoanContext is command Loan.ReviewDocument
    handler FromDocumentVerificationServiceHandler is {
      on documentVerified: event DocumentVerificationService.DocumentVerified is {
        let item0: type Loan.ReviewDocument = prompt("translate the documentVerified event into a ReviewDocument, a verified document is what the review records")
        send item0 to outlet LoanContext.FromDocumentVerificationService.FromDocumentVerificationServiceToLoanContext
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentVerificationService"
      }
    } with {
      briefly "from document verification service"
      described as {
        |Carries messages from the external DocumentVerificationService.
      }
    }
  } with {
    briefly "DocumentVerificationService integration"
    described as {
      |The model's side of the DocumentVerificationService conversation.
    }
  }
  adaptor ToDocumentVerificationService to context DocumentVerificationService as flow is { 
    inlet ToDocumentVerificationServiceIn is type LoanEvent    outlet ToDocumentVerificationServiceOut is command DocumentVerificationService.VerifyDocument
    handler ToDocumentVerificationServiceHandler is {
      on documentUploaded: event DocumentUploaded is {
        let check0: type DocumentVerificationService.VerifyDocument = prompt("translate the documentUploaded event into a VerifyDocument checking the paperwork is what it purports to be")
        send check0 to outlet LoanContext.ToDocumentVerificationService.ToDocumentVerificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentVerificationService"
      }
    } with {
      briefly "to document verification service"
      described as {
        |Carries messages to the external DocumentVerificationService.
      }
    }
  } with {
    briefly "DocumentVerificationService integration"
    described as {
      |The model's side of the DocumentVerificationService conversation.
    }
  }
  adaptor FromEmploymentVerificationService from context EmploymentVerificationService is { 
    inlet FromEmploymentVerificationServiceIn is event EmploymentVerificationService.EmploymentVerified    handler FromEmploymentVerificationServiceHandler is {
      on employmentVerified: event EmploymentVerificationService.EmploymentVerified is {
        do "employment checks out; underwriting weighs it rather than acting on it"
      }
      on other is {
        error "Unexpected message for adaptor FromEmploymentVerificationService"
      }
    } with {
      briefly "from employment verification service"
      described as {
        |Carries messages from the external EmploymentVerificationService.
      }
    }
  } with {
    briefly "EmploymentVerificationService integration"
    described as {
      |The model's side of the EmploymentVerificationService conversation.
    }
  }
  adaptor ToEmploymentVerificationService to context EmploymentVerificationService as flow is { 
    inlet ToEmploymentVerificationServiceIn is type LoanEvent    outlet ToEmploymentVerificationServiceOut is command EmploymentVerificationService.VerifyEmployment
    handler ToEmploymentVerificationServiceHandler is {
      on applicationSubmitted: event ApplicationSubmitted is {
        let check0: type EmploymentVerificationService.VerifyEmployment = prompt("translate the applicationSubmitted event into a VerifyEmployment checking the employment the application asserts")
        send check0 to outlet LoanContext.ToEmploymentVerificationService.ToEmploymentVerificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToEmploymentVerificationService"
      }
    } with {
      briefly "to employment verification service"
      described as {
        |Carries messages to the external EmploymentVerificationService.
      }
    }
  } with {
    briefly "EmploymentVerificationService integration"
    described as {
      |The model's side of the EmploymentVerificationService conversation.
    }
  }
  adaptor FromIncomeVerificationService from context IncomeVerificationService is { 
    inlet FromIncomeVerificationServiceIn is event IncomeVerificationService.IncomeVerified    handler FromIncomeVerificationServiceHandler is {
      on incomeVerified: event IncomeVerificationService.IncomeVerified is {
        do "income checks out; underwriting weighs it rather than acting on it"
      }
      on other is {
        error "Unexpected message for adaptor FromIncomeVerificationService"
      }
    } with {
      briefly "from income verification service"
      described as {
        |Carries messages from the external IncomeVerificationService.
      }
    }
  } with {
    briefly "IncomeVerificationService integration"
    described as {
      |The model's side of the IncomeVerificationService conversation.
    }
  }
  adaptor ToIncomeVerificationService to context IncomeVerificationService as flow is { 
    inlet ToIncomeVerificationServiceIn is type LoanEvent    outlet ToIncomeVerificationServiceOut is command IncomeVerificationService.VerifyIncome
    handler ToIncomeVerificationServiceHandler is {
      on applicationSubmitted: event ApplicationSubmitted is {
        let check0: type IncomeVerificationService.VerifyIncome = prompt("translate the applicationSubmitted event into a VerifyIncome checking the income the application asserts")
        send check0 to outlet LoanContext.ToIncomeVerificationService.ToIncomeVerificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToIncomeVerificationService"
      }
    } with {
      briefly "to income verification service"
      described as {
        |Carries messages to the external IncomeVerificationService.
      }
    }
  } with {
    briefly "IncomeVerificationService integration"
    described as {
      |The model's side of the IncomeVerificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type LoanEvent    outlet ToNotificationServiceOut is command NotificationService.SendLoanNotification
    handler ToNotificationServiceHandler is {
      on applicationSubmitted: event ApplicationSubmitted is {
        let notice: type NotificationService.SendLoanNotification = prompt("translate the applicationSubmitted event into a SendLoanNotification telling the applicant their application has been received and is under review, not that it is approved")
        send notice to outlet LoanContext.ToNotificationService.ToNotificationServiceOut
      }
      on loanConditionallyApproved: event LoanConditionallyApproved is {
        let notice: type NotificationService.SendLoanNotification = prompt("translate the loanConditionallyApproved event into a SendLoanNotification telling the applicant the loan is approved subject to conditions, and naming what still has to be satisfied")
        send notice to outlet LoanContext.ToNotificationService.ToNotificationServiceOut
      }
      on loanApproved: event LoanApproved is {
        let notice: type NotificationService.SendLoanNotification = prompt("translate the loanApproved event into a SendLoanNotification telling the applicant the loan is approved and what happens next")
        send notice to outlet LoanContext.ToNotificationService.ToNotificationServiceOut
      }
      on loanDeclined: event LoanDeclined is {
        let notice: type NotificationService.SendLoanNotification = prompt("translate the loanDeclined event into a SendLoanNotification telling the applicant the loan was declined, with the reason the decision records")
        send notice to outlet LoanContext.ToNotificationService.ToNotificationServiceOut
      }
      on loanFunded: event LoanFunded is {
        let notice: type NotificationService.SendLoanNotification = prompt("translate the loanFunded event into a SendLoanNotification telling the applicant the money has been disbursed")
        send notice to outlet LoanContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "Loan.riddl"
  // Repository for loan persistence
  type LoanRepositoryCommand is one of {
    LoanContext.LoanRepository.PersistApplicationSubmitted or LoanContext.LoanRepository.PersistApplicationWithdrawn or LoanContext.LoanRepository.PersistClosingScheduled or LoanContext.LoanRepository.PersistDocumentReviewed or LoanContext.LoanRepository.PersistDocumentUploaded or LoanContext.LoanRepository.PersistDocumentsRequested or LoanContext.LoanRepository.PersistLoanApproved or LoanContext.LoanRepository.PersistLoanConditionallyApproved or LoanContext.LoanRepository.PersistLoanDeclined or LoanContext.LoanRepository.PersistLoanFunded or LoanContext.LoanRepository.PersistOfferAccepted or LoanContext.LoanRepository.PersistSentToUnderwriting
  } with {
    briefly "Anything that writes LoanRepository"
    described as {
      |The persistence commands LoanRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository LoanRepository as flow is {
    inlet LoanRepositoryFromLoanAnalytics is type LoanRepositoryCommand    command PersistApplicationWithdrawn is {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApplicationWithdrawn applies to.
        }
      }
    } with {
      briefly "Persist ApplicationWithdrawn"
      described as {
        |Instructs this repository to apply ApplicationWithdrawn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClosingScheduled is {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row ClosingScheduled applies to.
        }
      }
    } with {
      briefly "Persist ClosingScheduled"
      described as {
        |Instructs this repository to apply ClosingScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDocumentReviewed is {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row DocumentReviewed applies to.
        }
      }
    } with {
      briefly "Persist DocumentReviewed"
      described as {
        |Instructs this repository to apply DocumentReviewed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDocumentUploaded is {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row DocumentUploaded applies to.
        }
      }
    } with {
      briefly "Persist DocumentUploaded"
      described as {
        |Instructs this repository to apply DocumentUploaded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDocumentsRequested is {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row DocumentsRequested applies to.
        }
      }
    } with {
      briefly "Persist DocumentsRequested"
      described as {
        |Instructs this repository to apply DocumentsRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLoanConditionallyApproved is {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row LoanConditionallyApproved applies to.
        }
      }
    } with {
      briefly "Persist LoanConditionallyApproved"
      described as {
        |Instructs this repository to apply LoanConditionallyApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOfferAccepted is {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row OfferAccepted applies to.
        }
      }
    } with {
      briefly "Persist OfferAccepted"
      described as {
        |Instructs this repository to apply OfferAccepted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSentToUnderwriting is {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row SentToUnderwriting applies to.
        }
      }
    } with {
      briefly "Persist SentToUnderwriting"
      described as {
        |Instructs this repository to apply SentToUnderwriting to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistApplicationSubmitted is {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApplicationSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ApplicationSubmitted"
      described as {
        |Instructs this repository to apply ApplicationSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLoanApproved is {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row LoanApproved applies to.
        }
      }
    } with {
      briefly "Persist LoanApproved"
      described as {
        |Instructs this repository to apply LoanApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLoanDeclined is {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row LoanDeclined applies to.
        }
      }
    } with {
      briefly "Persist LoanDeclined"
      described as {
        |Instructs this repository to apply LoanDeclined to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLoanFunded is {
      loanId: LoanId with {
        briefly "Row addressed"
        described as {
          |Which stored row LoanFunded applies to.
        }
      }
    } with {
      briefly "Persist LoanFunded"
      described as {
        |Instructs this repository to apply LoanFunded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet LoanRepositoryResponses is result Loan.LoanResult
    record StoredLoan is {
      loanId: LoanId with {
        briefly "loanId"
        described as {
          |The loanId column of the stored loan row.
        }
      }
      borrower: BorrowerInfo with {
        briefly "borrower"
        described as {
          |The borrower column of the stored loan row.
        }
      }
    } with {
      briefly "Stored loan row"
      described as {
        |The persistence shape of loan data as this repository stores it.
      }
    }
    schema LoanData is relational
      of loans as record StoredLoan
        index on field StoredLoan.loanId
        index on field StoredLoan.borrower.borrowerId
 with {
      briefly "Loan data schema"
      described as {
        |The relational schema holding loan data for the LoanRepository.
      }
    }
    handler LoanPersistence is {
      on persistApplicationWithdrawn: command PersistApplicationWithdrawn is {
        do "apply ApplicationWithdrawn to the stored row"
      }
      on persistClosingScheduled: command PersistClosingScheduled is {
        do "apply ClosingScheduled to the stored row"
      }
      on persistDocumentReviewed: command PersistDocumentReviewed is {
        do "apply DocumentReviewed to the stored row"
      }
      on persistDocumentUploaded: command PersistDocumentUploaded is {
        do "apply DocumentUploaded to the stored row"
      }
      on persistDocumentsRequested: command PersistDocumentsRequested is {
        do "apply DocumentsRequested to the stored row"
      }
      on persistLoanConditionallyApproved: command PersistLoanConditionallyApproved is {
        do "apply LoanConditionallyApproved to the stored row"
      }
      on persistOfferAccepted: command PersistOfferAccepted is {
        do "apply OfferAccepted to the stored row"
      }
      on persistSentToUnderwriting: command PersistSentToUnderwriting is {
        do "apply SentToUnderwriting to the stored row"
      }
      on persistApplicationSubmitted: command PersistApplicationSubmitted is {
        do "apply ApplicationSubmitted to the stored row"
      }
      on persistLoanApproved: command PersistLoanApproved is {
        do "apply LoanApproved to the stored row"
      }
      on persistLoanDeclined: command PersistLoanDeclined is {
        do "apply LoanDeclined to the stored row"
      }
      on persistLoanFunded: command PersistLoanFunded is {
        do "apply LoanFunded to the stored row"
      }
      on query GetLoanStats is {
        let loanStatsView: type LoanStatsView = prompt("read the loan stats projection")
        reply loanStatsView
      }
    } with {
      briefly "Persists loan commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Loan data persistence"
    described as {
      | The LoanRepository provides persistent storage for
      | loan applications, documents, and status history.
    }
  }
  // Projector for loan analytics
  query GetLoanStats replies result LoanStatsView is {
    loanStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which loan stats to retrieve.
      }
    }
  } with {
    briefly "Get loan stats"
    described as {
      |Retrieves the loan stats projection.
    }
  }
  result LoanStatsView is {
    loanStats: LoanAnalytics.LoanStats with {
      briefly "Loan stats"
      described as {
        |The loan stats being returned.
      }
    }
  } with {
    briefly "Loan stats view"
    described as {
      |Read model view carrying the loan stats projection.
    }
  }
  projector LoanAnalytics as flow is {
    updates repository LoanContext.LoanRepository
    outlet LoanAnalyticsToRepository is type LoanRepositoryCommand
    inlet LoanAnalyticsFromLoan is type LoanEvent    record LoanStats is {
      totalApplications: Natural with {
        briefly "Total"
        described as {
          |Total applications.
        }
      }
      approvalRate: Decimal(5,4) with {
        briefly "Approval"
        described as {
          |Approval rate.
        }
      }
      fundingRate: Decimal(5,4) with {
        briefly "Funding"
        described as {
          |Funding rate.
        }
      }
      avgLoanAmount: Decimal(12,2) with {
        briefly "Avg amount"
        described as {
          |Average loan amount.
        }
      }
      avgProcessingTime: Duration with {
        briefly "Avg time"
        described as {
          |Average processing time.
        }
      }
      totalFunded: Decimal(15,2) with {
        briefly "Total funded"
        described as {
          |Total amount funded.
        }
      }
    } with {
      briefly "Loan statistics"
      described as {
        |Loan origination metrics.
      }
    }
    handler AnalyticsHandler is {
      on applicationWithdrawn: event Loan.ApplicationWithdrawn is {
        tell command LoanContext.LoanRepository.PersistApplicationWithdrawn(loanId = applicationWithdrawn.loanId) to repository LoanContext.LoanRepository
        do "apply ApplicationWithdrawn to the LoanAnalytics projection"
      }
      on closingScheduled: event Loan.ClosingScheduled is {
        tell command LoanContext.LoanRepository.PersistClosingScheduled(loanId = closingScheduled.loanId) to repository LoanContext.LoanRepository
        do "apply ClosingScheduled to the LoanAnalytics projection"
      }
      on documentReviewed: event Loan.DocumentReviewed is {
        tell command LoanContext.LoanRepository.PersistDocumentReviewed(loanId = documentReviewed.loanId) to repository LoanContext.LoanRepository
        do "apply DocumentReviewed to the LoanAnalytics projection"
      }
      on documentUploaded: event Loan.DocumentUploaded is {
        tell command LoanContext.LoanRepository.PersistDocumentUploaded(loanId = documentUploaded.loanId) to repository LoanContext.LoanRepository
        do "apply DocumentUploaded to the LoanAnalytics projection"
      }
      on documentsRequested: event Loan.DocumentsRequested is {
        tell command LoanContext.LoanRepository.PersistDocumentsRequested(loanId = documentsRequested.loanId) to repository LoanContext.LoanRepository
        do "apply DocumentsRequested to the LoanAnalytics projection"
      }
      on loanConditionallyApproved: event Loan.LoanConditionallyApproved is {
        tell command LoanContext.LoanRepository.PersistLoanConditionallyApproved(loanId = loanConditionallyApproved.loanId) to repository LoanContext.LoanRepository
        do "apply LoanConditionallyApproved to the LoanAnalytics projection"
      }
      on offerAccepted: event Loan.OfferAccepted is {
        tell command LoanContext.LoanRepository.PersistOfferAccepted(loanId = offerAccepted.loanId) to repository LoanContext.LoanRepository
        do "apply OfferAccepted to the LoanAnalytics projection"
      }
      on sentToUnderwriting: event Loan.SentToUnderwriting is {
        tell command LoanContext.LoanRepository.PersistSentToUnderwriting(loanId = sentToUnderwriting.loanId) to repository LoanContext.LoanRepository
        do "apply SentToUnderwriting to the LoanAnalytics projection"
      }
      on applicationSubmitted: event Loan.ApplicationSubmitted is {
        tell command LoanContext.LoanRepository.PersistApplicationSubmitted(loanId = applicationSubmitted.loanId) to repository LoanContext.LoanRepository
      }
      on loanApproved: event Loan.LoanApproved is {
        tell command LoanContext.LoanRepository.PersistLoanApproved(loanId = loanApproved.loanId) to repository LoanContext.LoanRepository
      }
      on loanFunded: event Loan.LoanFunded is {
        tell command LoanContext.LoanRepository.PersistLoanFunded(loanId = loanFunded.loanId) to repository LoanContext.LoanRepository
      }
      on loanDeclined: event Loan.LoanDeclined is {
        tell command LoanContext.LoanRepository.PersistLoanDeclined(loanId = loanDeclined.loanId) to repository LoanContext.LoanRepository
      }
    } with {
      briefly "Maintains loan analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Loan analytics projections"
    described as {
      |Maintains loan origination analytics data.
    }
  }
  streamlet LoanEventSplit as split is {
    outlet LoanEventSplitToToNotificationService is type LoanEvent
    outlet LoanEventSplitToToIncomeVerificationService is type LoanEvent
    outlet LoanEventSplitToToEmploymentVerificationService is type LoanEvent
    outlet LoanEventSplitToToDocumentVerificationService is type LoanEvent
    outlet LoanEventSplitToToDocumentStorageService is type LoanEvent
    outlet LoanEventSplitToToDisbursementService is type LoanEvent
    outlet LoanEventSplitToToCreditDecisioningService is type LoanEvent
    inlet LoanEventSplitIn is type LoanEvent    outlet LoanEventSplitToLoanAnalytics is type LoanEvent
    handler LoanEventSplitHandler is {
      on applicationSubmitted: event Loan.ApplicationSubmitted is {
        send applicationSubmitted to outlet LoanEventSplitToLoanAnalytics
        send applicationSubmitted to outlet LoanEventSplitToToNotificationService
        send applicationSubmitted to outlet LoanEventSplitToToIncomeVerificationService
        send applicationSubmitted to outlet LoanEventSplitToToEmploymentVerificationService
        tell applicationSubmitted to entity LoanContext.Loan
      }
      on documentsRequested: event Loan.DocumentsRequested is {
        send documentsRequested to outlet LoanEventSplitToLoanAnalytics
        tell documentsRequested to entity LoanContext.Loan
      }
      on documentUploaded: event Loan.DocumentUploaded is {
        send documentUploaded to outlet LoanEventSplitToLoanAnalytics
        send documentUploaded to outlet LoanEventSplitToToDocumentVerificationService
        send documentUploaded to outlet LoanEventSplitToToDocumentStorageService
        tell documentUploaded to entity LoanContext.Loan
      }
      on documentReviewed: event Loan.DocumentReviewed is {
        send documentReviewed to outlet LoanEventSplitToLoanAnalytics
        tell documentReviewed to entity LoanContext.Loan
      }
      on sentToUnderwriting: event Loan.SentToUnderwriting is {
        send sentToUnderwriting to outlet LoanEventSplitToLoanAnalytics
        send sentToUnderwriting to outlet LoanEventSplitToToCreditDecisioningService
        tell sentToUnderwriting to entity LoanContext.Loan
      }
      on loanApproved: event Loan.LoanApproved is {
        send loanApproved to outlet LoanEventSplitToLoanAnalytics
        send loanApproved to outlet LoanEventSplitToToNotificationService
        tell loanApproved to entity LoanContext.Loan
      }
      on loanConditionallyApproved: event Loan.LoanConditionallyApproved is {
        send loanConditionallyApproved to outlet LoanEventSplitToLoanAnalytics
        send loanConditionallyApproved to outlet LoanEventSplitToToNotificationService
        tell loanConditionallyApproved to entity LoanContext.Loan
      }
      on loanDeclined: event Loan.LoanDeclined is {
        send loanDeclined to outlet LoanEventSplitToLoanAnalytics
        send loanDeclined to outlet LoanEventSplitToToNotificationService
        tell loanDeclined to entity LoanContext.Loan
      }
      on offerAccepted: event Loan.OfferAccepted is {
        send offerAccepted to outlet LoanEventSplitToLoanAnalytics
        tell offerAccepted to entity LoanContext.Loan
      }
      on closingScheduled: event Loan.ClosingScheduled is {
        send closingScheduled to outlet LoanEventSplitToLoanAnalytics
        tell closingScheduled to entity LoanContext.Loan
      }
      on loanFunded: event Loan.LoanFunded is {
        send loanFunded to outlet LoanEventSplitToLoanAnalytics
        send loanFunded to outlet LoanEventSplitToToNotificationService
        send loanFunded to outlet LoanEventSplitToToDisbursementService
        tell loanFunded to entity LoanContext.Loan
      }
      on applicationWithdrawn: event Loan.ApplicationWithdrawn is {
        send applicationWithdrawn to outlet LoanEventSplitToLoanAnalytics
        tell applicationWithdrawn to entity LoanContext.Loan
      }
      on other is {
        error "Unexpected message for processor LoanEventSplit"
      }
    } with {
      briefly "Loan event fan-out handler"
      described as {
        |Delivers each Loan event to all of its consumers.
      }
    }
  } with {
    briefly "Loan event fan-out"
    described as {
      |Fans Loan events out to the repository and projectors.
    }
  }
  connector 'ToNotificationService Feed' is from outlet LoanContext.LoanEventSplit.LoanEventSplitToToNotificationService to inlet LoanContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The Loan events ToNotificationService translates, on their way to it"
  }
  connector 'ToIncomeVerificationService Feed' is from outlet LoanContext.LoanEventSplit.LoanEventSplitToToIncomeVerificationService to inlet LoanContext.ToIncomeVerificationService.ToIncomeVerificationServiceIn with {
    briefly "The Loan events ToIncomeVerificationService translates, on their way to it"
  }
  connector 'ToEmploymentVerificationService Feed' is from outlet LoanContext.LoanEventSplit.LoanEventSplitToToEmploymentVerificationService to inlet LoanContext.ToEmploymentVerificationService.ToEmploymentVerificationServiceIn with {
    briefly "The Loan events ToEmploymentVerificationService translates, on their way to it"
  }
  connector 'ToDocumentVerificationService Feed' is from outlet LoanContext.LoanEventSplit.LoanEventSplitToToDocumentVerificationService to inlet LoanContext.ToDocumentVerificationService.ToDocumentVerificationServiceIn with {
    briefly "The Loan events ToDocumentVerificationService translates, on their way to it"
  }
  connector 'ToDocumentStorageService Feed' is from outlet LoanContext.LoanEventSplit.LoanEventSplitToToDocumentStorageService to inlet LoanContext.ToDocumentStorageService.ToDocumentStorageServiceIn with {
    briefly "The Loan events ToDocumentStorageService translates, on their way to it"
  }
  connector 'ToDisbursementService Feed' is from outlet LoanContext.LoanEventSplit.LoanEventSplitToToDisbursementService to inlet LoanContext.ToDisbursementService.ToDisbursementServiceIn with {
    briefly "The Loan events ToDisbursementService translates, on their way to it"
  }
  connector 'ToCreditDecisioningService Feed' is from outlet LoanContext.LoanEventSplit.LoanEventSplitToToCreditDecisioningService to inlet LoanContext.ToCreditDecisioningService.ToCreditDecisioningServiceIn with {
    briefly "The Loan events ToCreditDecisioningService translates, on their way to it"
  }
  connector 'LoanEvent Stream' is from outlet LoanContext.Loan.LoanEvents2 to inlet LoanContext.LoanEventSplit.LoanEventSplitIn with {
    briefly "Loan events, fanned out to storage and read models"
  }
  connector 'LoanAnalytics Feed' is from outlet LoanContext.LoanEventSplit.LoanEventSplitToLoanAnalytics to inlet LoanContext.LoanAnalytics.LoanAnalyticsFromLoan with {
    briefly "Loan events feeding the LoanAnalytics projection"
  }
  connector 'LoanAnalytics Storage' is from outlet LoanContext.LoanAnalytics.LoanAnalyticsToRepository to inlet LoanContext.LoanRepository.LoanRepositoryFromLoanAnalytics with {
    briefly "LoanAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for loan origination"
  described as {
    | The LoanContext is the bounded context for loan
    | application processing, underwriting, and funding.
  }
}
