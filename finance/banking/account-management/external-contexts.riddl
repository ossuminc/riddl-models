// Account Management - External Contexts
// Customer Service
external context CustomerService as flow is {
  outlet CustomerServiceEventsOut is event CustomerUpdated
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet CustomerServiceRequests is query GetCustomer with {
    briefly "What this context asks the service to send"
  }
  handler CustomerServiceBoundary is {
    on query GetCustomer is {
      let askAnswer: type CustomerResult = prompt("look up what GetCustomer asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context CustomerService"
    }
  } with {
    briefly "CustomerService boundary"
  }
  query GetCustomer replies result CustomerResult is {
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
  } with {
    briefly "Get customer"
    described as {
      |Retrieves customer details.
    }
  }
  result CustomerResult is {
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    customerName: String(1,200) with {
      briefly "Name"
      described as {
        |Customer name.
      }
    }
  } with {
    briefly "Customer result"
    described as {
      |Customer data result.
    }
  }
  event CustomerUpdated is {
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Customer was updated"
    described as {
      |Emitted when customer changes.
    }
  }
} with {
  briefly "External customer service"
  described as {
    |External customer management system.
  }
}
// Fraud Detection Service
external context FraudDetectionService as flow is {
  outlet FraudDetectionServiceEventsOut is event TransactionScreened
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet FraudDetectionServiceRequests is command ScreenTransaction with {
    briefly "What this context asks the service to send"
  }
  handler FraudDetectionServiceBoundary is {
    on command ScreenTransaction is {
      let transactionScreened: type TransactionScreened = prompt("the transaction screened this produces")
      send transactionScreened to outlet FraudDetectionService.FraudDetectionServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context FraudDetectionService"
    }
  } with {
    briefly "FraudDetectionService boundary"
  }
  command ScreenTransaction is {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account ID.
      }
    }
    amount: Decimal(15,2) with {
      briefly "Amount"
      described as {
        |Transaction amount.
      }
    }
  } with {
    briefly "Screen transaction"
    described as {
      |Screens for fraud.
    }
  }
  event TransactionScreened is {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    approved: Boolean with {
      briefly "Approved"
      described as {
        |Is approved.
      }
    }
    riskScore: Decimal(5,4) with {
      briefly "Risk"
      described as {
        |Risk score.
      }
    }
  } with {
    briefly "Transaction was screened"
    described as {
      |Emitted when screening completes.
    }
  }
} with {
  briefly "External fraud service"
  described as {
    |External fraud detection system.
  }
}
// Core Banking Service
external context CoreBankingService as flow is {
  outlet CoreBankingServiceEventsOut is event LedgerPosted
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet CoreBankingServiceRequests is command PostToLedger with {
    briefly "What this context asks the service to send"
  }
  handler CoreBankingServiceBoundary is {
    on command PostToLedger is {
      let ledgerPosted: type LedgerPosted = prompt("the ledger posted this produces")
      send ledgerPosted to outlet CoreBankingService.CoreBankingServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context CoreBankingService"
    }
  } with {
    briefly "CoreBankingService boundary"
  }
  command PostToLedger is {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account ID.
      }
    }
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    amount: Decimal(15,2) with {
      briefly "Amount"
      described as {
        |Amount.
      }
    }
    debitCredit: String(1,10) with {
      briefly "Type"
      described as {
        |Debit or credit.
      }
    }
  } with {
    briefly "Post to ledger"
    described as {
      |Posts to general ledger.
    }
  }
  event LedgerPosted is {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    postedAt: TimeStamp with {
      briefly "Posted"
      described as {
        |Posting time.
      }
    }
  } with {
    briefly "Ledger was posted"
    described as {
      |Emitted when posting completes.
    }
  }
} with {
  briefly "External core banking"
  described as {
    |External core banking system.
  }
}
// Notification Service
external context NotificationService as sink is {
  inlet NotificationServiceRequests is command SendAccountNotification with {
    briefly "What this context asks the service to send"
  }
  handler NotificationServiceBoundary is {
    on command SendAccountNotification is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context NotificationService"
    }
  } with {
    briefly "NotificationService boundary"
  }
  command SendAccountNotification is {
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account ID.
      }
    }
    notificationType: String(1,50) with {
      briefly "Type"
      described as {
        |Notification type.
      }
    }
    message: String(1,500) with {
      briefly "Message"
      described as {
        |Message content.
      }
    }
  } with {
    briefly "Send notification"
    described as {
      |Sends account notification.
    }
  }
  event NotificationSent is {
    notificationId: UUID with {
      briefly "Notification"
      described as {
        |Notification ID.
      }
    }
    sentAt: TimeStamp with {
      briefly "Sent"
      described as {
        |Send time.
      }
    }
  } with {
    briefly "Notification was sent"
    described as {
      |Emitted when notification is delivered.
    }
  }
} with {
  briefly "External notification service"
  described as {
    |External customer notification system.
  }
}
// Regulatory Reporting Service
external context RegulatoryService as flow is {
  outlet RegulatoryServiceEventsOut is event TransactionReported
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet RegulatoryServiceRequests is command ReportTransaction with {
    briefly "What this context asks the service to send"
  }
  handler RegulatoryServiceBoundary is {
    on command ReportTransaction is {
      let transactionReported: type TransactionReported = prompt("the transaction reported this produces")
      send transactionReported to outlet RegulatoryService.RegulatoryServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context RegulatoryService"
    }
  } with {
    briefly "RegulatoryService boundary"
  }
  command ReportTransaction is {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account ID.
      }
    }
    amount: Decimal(15,2) with {
      briefly "Amount"
      described as {
        |Transaction amount.
      }
    }
    reportType: String(1,50) with {
      briefly "Report"
      described as {
        |Report type.
      }
    }
  } with {
    briefly "Report transaction"
    described as {
      |Reports to regulatory system.
    }
  }
  event TransactionReported is {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    reportedAt: TimeStamp with {
      briefly "Reported"
      described as {
        |Report time.
      }
    }
  } with {
    briefly "Transaction was reported"
    described as {
      |Emitted when reporting completes.
    }
  }
} with {
  briefly "External regulatory service"
  described as {
    |External regulatory reporting system.
  }
}
