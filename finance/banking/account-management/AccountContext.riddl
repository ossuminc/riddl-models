// Account Management - Account Context
context AccountContext as router is {
  inlet AccountCommandStreamIn is type AccountCommand  outlet AccountCommandStreamOut is type AccountCommand
  inlet AccountResultStreamIn is result Account.AccountResult  outlet AccountResultStreamOut is result Account.AccountResult
  handler AccountContextBoundary is {
    on openAccount: command Account.OpenAccount is {
      send openAccount to outlet AccountContext.AccountCommandStreamOut
    }
    on updateAccountInfo: command Account.UpdateAccountInfo is {
      send updateAccountInfo to outlet AccountContext.AccountCommandStreamOut
    }
    on addAccountHolder: command Account.AddAccountHolder is {
      send addAccountHolder to outlet AccountContext.AccountCommandStreamOut
    }
    on recordTransaction: command Account.RecordTransaction is {
      send recordTransaction to outlet AccountContext.AccountCommandStreamOut
    }
    on processTransfer: command Account.ProcessTransfer is {
      send processTransfer to outlet AccountContext.AccountCommandStreamOut
    }
    on setLimit: command Account.SetLimit is {
      send setLimit to outlet AccountContext.AccountCommandStreamOut
    }
    on applyFee: command Account.ApplyFee is {
      send applyFee to outlet AccountContext.AccountCommandStreamOut
    }
    on freezeAccount: command Account.FreezeAccount is {
      send freezeAccount to outlet AccountContext.AccountCommandStreamOut
    }
    on unfreezeAccount: command Account.UnfreezeAccount is {
      send unfreezeAccount to outlet AccountContext.AccountCommandStreamOut
    }
    on closeAccount: command Account.CloseAccount is {
      send closeAccount to outlet AccountContext.AccountCommandStreamOut
    }
    on accountResult: result Account.AccountResult is {
      send accountResult to outlet AccountContext.AccountResultStreamOut
    }
    on other is {
      error "Unexpected message at the AccountContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AccountCommand Stream Intake' is from outlet AccountContext.AccountCommandStreamOut to inlet AccountContext.Account.AccountCommands  connector 'AccountResult Stream Egress' is from outlet AccountContext.AccountRepository.AccountRepositoryResponses to inlet AccountContext.AccountResultStreamIn  adaptor FromCoreBankingService from context CoreBankingService is { 
    handler FromCoreBankingServiceHandler is {
      on event CoreBankingService.LedgerPosted is {
        do "the model receives ledger posted"
      }
      on other is {
        error "Unexpected message for adaptor FromCoreBankingService"
      }
    } with {
      briefly "from core banking service"
      described as {
        |Carries messages from the external CoreBankingService.
      }
    }
  } with {
    briefly "CoreBankingService integration"
    described as {
      |The model's side of the CoreBankingService conversation.
    }
  }
  adaptor ToCoreBankingService to context CoreBankingService is { 
    handler ToCoreBankingServiceHandler is {
      on command CoreBankingService.PostToLedger is {
        do "the model sends post to ledger"
      }
      on other is {
        error "Unexpected message for adaptor ToCoreBankingService"
      }
    } with {
      briefly "to core banking service"
      described as {
        |Carries messages to the external CoreBankingService.
      }
    }
  } with {
    briefly "CoreBankingService integration"
    described as {
      |The model's side of the CoreBankingService conversation.
    }
  }
  adaptor FromCustomerService from context CustomerService is { 
    handler FromCustomerServiceHandler is {
      on result CustomerService.CustomerResult is {
        do "the model receives customer result"
      }
      on event CustomerService.CustomerUpdated is {
        do "the model receives customer updated"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerService"
      }
    } with {
      briefly "from customer service"
      described as {
        |Carries messages from the external CustomerService.
      }
    }
  } with {
    briefly "CustomerService integration"
    described as {
      |The model's side of the CustomerService conversation.
    }
  }
  adaptor ToCustomerService to context CustomerService is { 
    handler ToCustomerServiceHandler is {
      on query CustomerService.GetCustomer is {
        do "the model sends get customer"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerService"
      }
    } with {
      briefly "to customer service"
      described as {
        |Carries messages to the external CustomerService.
      }
    }
  } with {
    briefly "CustomerService integration"
    described as {
      |The model's side of the CustomerService conversation.
    }
  }
  adaptor FromFraudDetectionService from context FraudDetectionService is { 
    handler FromFraudDetectionServiceHandler is {
      on event FraudDetectionService.TransactionScreened is {
        do "the model receives transaction screened"
      }
      on other is {
        error "Unexpected message for adaptor FromFraudDetectionService"
      }
    } with {
      briefly "from fraud detection service"
      described as {
        |Carries messages from the external FraudDetectionService.
      }
    }
  } with {
    briefly "FraudDetectionService integration"
    described as {
      |The model's side of the FraudDetectionService conversation.
    }
  }
  adaptor ToFraudDetectionService to context FraudDetectionService is { 
    handler ToFraudDetectionServiceHandler is {
      on command FraudDetectionService.ScreenTransaction is {
        do "the model sends screen transaction"
      }
      on other is {
        error "Unexpected message for adaptor ToFraudDetectionService"
      }
    } with {
      briefly "to fraud detection service"
      described as {
        |Carries messages to the external FraudDetectionService.
      }
    }
  } with {
    briefly "FraudDetectionService integration"
    described as {
      |The model's side of the FraudDetectionService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendAccountNotification is {
        do "the model sends send account notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromRegulatoryService from context RegulatoryService is { 
    handler FromRegulatoryServiceHandler is {
      on event RegulatoryService.TransactionReported is {
        do "the model receives transaction reported"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryService"
      }
    } with {
      briefly "from regulatory service"
      described as {
        |Carries messages from the external RegulatoryService.
      }
    }
  } with {
    briefly "RegulatoryService integration"
    described as {
      |The model's side of the RegulatoryService conversation.
    }
  }
  adaptor ToRegulatoryService to context RegulatoryService is { 
    handler ToRegulatoryServiceHandler is {
      on command RegulatoryService.ReportTransaction is {
        do "the model sends report transaction"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryService"
      }
    } with {
      briefly "to regulatory service"
      described as {
        |Carries messages to the external RegulatoryService.
      }
    }
  } with {
    briefly "RegulatoryService integration"
    described as {
      |The model's side of the RegulatoryService conversation.
    }
  }
  include "types.riddl"
  include "Account.riddl"
  // Repository for account persistence
  type AccountRepositoryCommand is one of {
    AccountContext.AccountRepository.PersistAccountClosed or AccountContext.AccountRepository.PersistAccountFrozen or AccountContext.AccountRepository.PersistAccountHolderAdded or AccountContext.AccountRepository.PersistAccountInfoUpdated or AccountContext.AccountRepository.PersistAccountOpened or AccountContext.AccountRepository.PersistAccountUnfrozen or AccountContext.AccountRepository.PersistFeeApplied or AccountContext.AccountRepository.PersistLimitSet or AccountContext.AccountRepository.PersistTransactionRecorded or AccountContext.AccountRepository.PersistTransferProcessed
  } with {
    briefly "Anything that writes AccountRepository"
    described as {
      |The persistence commands AccountRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository AccountRepository as flow is {
    inlet AccountRepositoryFromAccountAnalytics is type AccountRepositoryCommand    command PersistAccountFrozen is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountFrozen applies to.
        }
      }
    } with {
      briefly "Persist AccountFrozen"
      described as {
        |Instructs this repository to apply AccountFrozen to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountHolderAdded is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountHolderAdded applies to.
        }
      }
    } with {
      briefly "Persist AccountHolderAdded"
      described as {
        |Instructs this repository to apply AccountHolderAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountInfoUpdated is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountInfoUpdated applies to.
        }
      }
    } with {
      briefly "Persist AccountInfoUpdated"
      described as {
        |Instructs this repository to apply AccountInfoUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountUnfrozen is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountUnfrozen applies to.
        }
      }
    } with {
      briefly "Persist AccountUnfrozen"
      described as {
        |Instructs this repository to apply AccountUnfrozen to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFeeApplied is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row FeeApplied applies to.
        }
      }
    } with {
      briefly "Persist FeeApplied"
      described as {
        |Instructs this repository to apply FeeApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLimitSet is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row LimitSet applies to.
        }
      }
    } with {
      briefly "Persist LimitSet"
      described as {
        |Instructs this repository to apply LimitSet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransferProcessed is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransferProcessed applies to.
        }
      }
    } with {
      briefly "Persist TransferProcessed"
      described as {
        |Instructs this repository to apply TransferProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountClosed is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountClosed applies to.
        }
      }
    } with {
      briefly "Persist AccountClosed"
      described as {
        |Instructs this repository to apply AccountClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountOpened is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountOpened applies to.
        }
      }
    } with {
      briefly "Persist AccountOpened"
      described as {
        |Instructs this repository to apply AccountOpened to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransactionRecorded is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransactionRecorded applies to.
        }
      }
    } with {
      briefly "Persist TransactionRecorded"
      described as {
        |Instructs this repository to apply TransactionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet AccountRepositoryResponses is result Account.AccountResult
    record StoredAccount is  {
      accountId: AccountId with {
        briefly "accountId"
        described as {
          |The accountId column of the stored account row.
        }
      }
      info: AccountInfo with {
        briefly "info"
        described as {
          |The info column of the stored account row.
        }
      }
    } with {
      briefly "Stored account row"
      described as {
        |The persistence shape of account data as this repository stores it.
      }
    }
    schema AccountData is relational
      of accounts as record StoredAccount
        index on field StoredAccount.accountId
        index on field StoredAccount.info.customerId
 with {
      briefly "Account data schema"
      described as {
        |The relational schema holding account data for the AccountRepository.
      }
    }
    handler AccountPersistence is {
      on persistAccountFrozen: command PersistAccountFrozen is {
        do "apply AccountFrozen to the stored row"
      }
      on persistAccountHolderAdded: command PersistAccountHolderAdded is {
        do "apply AccountHolderAdded to the stored row"
      }
      on persistAccountInfoUpdated: command PersistAccountInfoUpdated is {
        do "apply AccountInfoUpdated to the stored row"
      }
      on persistAccountUnfrozen: command PersistAccountUnfrozen is {
        do "apply AccountUnfrozen to the stored row"
      }
      on persistFeeApplied: command PersistFeeApplied is {
        do "apply FeeApplied to the stored row"
      }
      on persistLimitSet: command PersistLimitSet is {
        do "apply LimitSet to the stored row"
      }
      on persistTransferProcessed: command PersistTransferProcessed is {
        do "apply TransferProcessed to the stored row"
      }
      on persistAccountClosed: command PersistAccountClosed is {
        do "apply AccountClosed to the stored row"
      }
      on persistAccountOpened: command PersistAccountOpened is {
        do "apply AccountOpened to the stored row"
      }
      on persistTransactionRecorded: command PersistTransactionRecorded is {
        do "apply TransactionRecorded to the stored row"
      }
      on query GetAccountStats is {
        let accountStatsView: type AccountStatsView = prompt("read the account stats projection")
        reply accountStatsView
      }
    } with {
      briefly "Persists account commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Account data persistence"
    described as {
      | The AccountRepository provides persistent storage for
      | bank accounts, transactions, and balances.
    }
  }
  // Projector for account analytics
  query GetAccountStats replies result AccountStatsView is  {
    accountStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which account stats to retrieve.
      }
    }
  } with {
    briefly "Get account stats"
    described as {
      |Retrieves the account stats projection.
    }
  }
  result AccountStatsView is  {
    accountStats: AccountAnalytics.AccountStats with {
      briefly "Account stats"
      described as {
        |The account stats being returned.
      }
    }
  } with {
    briefly "Account stats view"
    described as {
      |Read model view carrying the account stats projection.
    }
  }
  projector AccountAnalytics as flow is {
    updates repository AccountContext.AccountRepository
    outlet AccountAnalyticsToRepository is type AccountRepositoryCommand
    inlet AccountAnalyticsFromAccount is type AccountEvent    record AccountStats is  {
      accountType: AccountType with {
        briefly "Type"
        described as {
          |Account type.
        }
      }
      totalAccounts: Natural with {
        briefly "Accounts"
        described as {
          |Total accounts.
        }
      }
      totalBalance: Decimal(20,2) with {
        briefly "Balance"
        described as {
          |Total balance.
        }
      }
      avgBalance: Decimal(15,2) with {
        briefly "Average"
        described as {
          |Average balance.
        }
      }
      dailyTransactions: Natural with {
        briefly "Transactions"
        described as {
          |Daily transactions.
        }
      }
      dailyVolume: Decimal(20,2) with {
        briefly "Volume"
        described as {
          |Daily volume.
        }
      }
    } with {
      briefly "Account statistics"
      described as {
        |Banking account metrics.
      }
    }
    handler AnalyticsHandler is {
      on accountFrozen: event Account.AccountFrozen is {
        tell command AccountContext.AccountRepository.PersistAccountFrozen(accountId = accountFrozen.accountId) to repository AccountContext.AccountRepository
        do "apply AccountFrozen to the AccountAnalytics projection"
      }
      on accountHolderAdded: event Account.AccountHolderAdded is {
        tell command AccountContext.AccountRepository.PersistAccountHolderAdded(accountId = accountHolderAdded.accountId) to repository AccountContext.AccountRepository
        do "apply AccountHolderAdded to the AccountAnalytics projection"
      }
      on accountInfoUpdated: event Account.AccountInfoUpdated is {
        tell command AccountContext.AccountRepository.PersistAccountInfoUpdated(accountId = accountInfoUpdated.accountId) to repository AccountContext.AccountRepository
        do "apply AccountInfoUpdated to the AccountAnalytics projection"
      }
      on accountUnfrozen: event Account.AccountUnfrozen is {
        tell command AccountContext.AccountRepository.PersistAccountUnfrozen(accountId = accountUnfrozen.accountId) to repository AccountContext.AccountRepository
        do "apply AccountUnfrozen to the AccountAnalytics projection"
      }
      on feeApplied: event Account.FeeApplied is {
        tell command AccountContext.AccountRepository.PersistFeeApplied(accountId = feeApplied.accountId) to repository AccountContext.AccountRepository
        do "apply FeeApplied to the AccountAnalytics projection"
      }
      on limitSet: event Account.LimitSet is {
        tell command AccountContext.AccountRepository.PersistLimitSet(accountId = limitSet.accountId) to repository AccountContext.AccountRepository
        do "apply LimitSet to the AccountAnalytics projection"
      }
      on transferProcessed: event Account.TransferProcessed is {
        tell command AccountContext.AccountRepository.PersistTransferProcessed(accountId = transferProcessed.accountId) to repository AccountContext.AccountRepository
        do "apply TransferProcessed to the AccountAnalytics projection"
      }
      on accountOpened: event Account.AccountOpened is {
        tell command AccountContext.AccountRepository.PersistAccountOpened(accountId = accountOpened.accountId) to repository AccountContext.AccountRepository
      }
      on transactionRecorded: event Account.TransactionRecorded is {
        tell command AccountContext.AccountRepository.PersistTransactionRecorded(accountId = transactionRecorded.accountId) to repository AccountContext.AccountRepository
      }
      on accountClosed: event Account.AccountClosed is {
        tell command AccountContext.AccountRepository.PersistAccountClosed(accountId = accountClosed.accountId) to repository AccountContext.AccountRepository
      }
    } with {
      briefly "Maintains account analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Account analytics projections"
    described as {
      |Maintains banking account analytics data.
    }
  }
  processor AccountEventSplit as flow is {
    inlet AccountEventSplitIn is type AccountEvent    outlet AccountEventSplitToAccountAnalytics is type AccountEvent
    handler AccountEventSplitHandler is {
      on accountOpened: event Account.AccountOpened is {
        send accountOpened to outlet AccountEventSplitToAccountAnalytics
        tell accountOpened to entity AccountContext.Account
      }
      on accountInfoUpdated: event Account.AccountInfoUpdated is {
        send accountInfoUpdated to outlet AccountEventSplitToAccountAnalytics
        tell accountInfoUpdated to entity AccountContext.Account
      }
      on accountHolderAdded: event Account.AccountHolderAdded is {
        send accountHolderAdded to outlet AccountEventSplitToAccountAnalytics
        tell accountHolderAdded to entity AccountContext.Account
      }
      on transactionRecorded: event Account.TransactionRecorded is {
        send transactionRecorded to outlet AccountEventSplitToAccountAnalytics
        tell transactionRecorded to entity AccountContext.Account
      }
      on transferProcessed: event Account.TransferProcessed is {
        send transferProcessed to outlet AccountEventSplitToAccountAnalytics
        tell transferProcessed to entity AccountContext.Account
      }
      on limitSet: event Account.LimitSet is {
        send limitSet to outlet AccountEventSplitToAccountAnalytics
        tell limitSet to entity AccountContext.Account
      }
      on feeApplied: event Account.FeeApplied is {
        send feeApplied to outlet AccountEventSplitToAccountAnalytics
        tell feeApplied to entity AccountContext.Account
      }
      on accountFrozen: event Account.AccountFrozen is {
        send accountFrozen to outlet AccountEventSplitToAccountAnalytics
        tell accountFrozen to entity AccountContext.Account
      }
      on accountUnfrozen: event Account.AccountUnfrozen is {
        send accountUnfrozen to outlet AccountEventSplitToAccountAnalytics
        tell accountUnfrozen to entity AccountContext.Account
      }
      on accountClosed: event Account.AccountClosed is {
        send accountClosed to outlet AccountEventSplitToAccountAnalytics
        tell accountClosed to entity AccountContext.Account
      }
      on other is {
        error "Unexpected message for processor AccountEventSplit"
      }
    } with {
      briefly "Account event fan-out handler"
      described as {
        |Delivers each Account event to all of its consumers.
      }
    }
  } with {
    briefly "Account event fan-out"
    described as {
      |Fans Account events out to the repository and projectors.
    }
  }
  connector 'AccountEvent Stream' is from outlet AccountContext.Account.AccountEvents2 to inlet AccountContext.AccountEventSplit.AccountEventSplitIn with {
    briefly "Account events, fanned out to storage and read models"
  }
  connector 'AccountAnalytics Feed' is from outlet AccountContext.AccountEventSplit.AccountEventSplitToAccountAnalytics to inlet AccountContext.AccountAnalytics.AccountAnalyticsFromAccount with {
    briefly "Account events feeding the AccountAnalytics projection"
  }
  connector 'AccountAnalytics Storage' is from outlet AccountContext.AccountAnalytics.AccountAnalyticsToRepository to inlet AccountContext.AccountRepository.AccountRepositoryFromAccountAnalytics with {
    briefly "AccountAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for accounts"
  described as {
    | The AccountContext is the bounded context for bank
    | account management, transactions, and reporting.
  }
}
