// Account Management - Account Context
context AccountContext is {
  adaptor FromCoreBankingService from context CoreBankingService is {
    handler FromCoreBankingServiceHandler is {
      on event CoreBankingService.LedgerPosted is {
        do "the model receives ledger posted"
      }
      on other is {
        error "Unexpected message for adaptor FromCoreBankingService"
      }
    } with {
      briefly "from core banking service"
      described as {
        |Carries messages from the external CoreBankingService.
      }
    }
  } with {
      briefly "CoreBankingService integration"
    described as {
      |The model's side of the CoreBankingService conversation.
    }
  }
  adaptor ToCoreBankingService to context CoreBankingService is {
    handler ToCoreBankingServiceHandler is {
      on command CoreBankingService.PostToLedger is {
        do "the model sends post to ledger"
      }
      on other is {
        error "Unexpected message for adaptor ToCoreBankingService"
      }
    } with {
      briefly "to core banking service"
      described as {
        |Carries messages to the external CoreBankingService.
      }
    }
  } with {
      briefly "CoreBankingService integration"
    described as {
      |The model's side of the CoreBankingService conversation.
    }
  }
  adaptor FromCustomerService from context CustomerService is {
    handler FromCustomerServiceHandler is {
      on result CustomerService.CustomerResult is {
        do "the model receives customer result"
      }
      on event CustomerService.CustomerUpdated is {
        do "the model receives customer updated"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerService"
      }
    } with {
      briefly "from customer service"
      described as {
        |Carries messages from the external CustomerService.
      }
    }
  } with {
      briefly "CustomerService integration"
    described as {
      |The model's side of the CustomerService conversation.
    }
  }
  adaptor ToCustomerService to context CustomerService is {
    handler ToCustomerServiceHandler is {
      on query CustomerService.GetCustomer is {
        do "the model sends get customer"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerService"
      }
    } with {
      briefly "to customer service"
      described as {
        |Carries messages to the external CustomerService.
      }
    }
  } with {
      briefly "CustomerService integration"
    described as {
      |The model's side of the CustomerService conversation.
    }
  }
  adaptor FromFraudDetectionService from context FraudDetectionService is {
    handler FromFraudDetectionServiceHandler is {
      on event FraudDetectionService.TransactionScreened is {
        do "the model receives transaction screened"
      }
      on other is {
        error "Unexpected message for adaptor FromFraudDetectionService"
      }
    } with {
      briefly "from fraud detection service"
      described as {
        |Carries messages from the external FraudDetectionService.
      }
    }
  } with {
      briefly "FraudDetectionService integration"
    described as {
      |The model's side of the FraudDetectionService conversation.
    }
  }
  adaptor ToFraudDetectionService to context FraudDetectionService is {
    handler ToFraudDetectionServiceHandler is {
      on command FraudDetectionService.ScreenTransaction is {
        do "the model sends screen transaction"
      }
      on other is {
        error "Unexpected message for adaptor ToFraudDetectionService"
      }
    } with {
      briefly "to fraud detection service"
      described as {
        |Carries messages to the external FraudDetectionService.
      }
    }
  } with {
      briefly "FraudDetectionService integration"
    described as {
      |The model's side of the FraudDetectionService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is {
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is {
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendAccountNotification is {
        do "the model sends send account notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromRegulatoryService from context RegulatoryService is {
    handler FromRegulatoryServiceHandler is {
      on event RegulatoryService.TransactionReported is {
        do "the model receives transaction reported"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryService"
      }
    } with {
      briefly "from regulatory service"
      described as {
        |Carries messages from the external RegulatoryService.
      }
    }
  } with {
      briefly "RegulatoryService integration"
    described as {
      |The model's side of the RegulatoryService conversation.
    }
  }
  adaptor ToRegulatoryService to context RegulatoryService is {
    handler ToRegulatoryServiceHandler is {
      on command RegulatoryService.ReportTransaction is {
        do "the model sends report transaction"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryService"
      }
    } with {
      briefly "to regulatory service"
      described as {
        |Carries messages to the external RegulatoryService.
      }
    }
  } with {
      briefly "RegulatoryService integration"
    described as {
      |The model's side of the RegulatoryService conversation.
    }
  }
  include "types.riddl"
  include "Account.riddl"
  // Repository for account persistence
  repository AccountRepository is {
    inlet AccountRepositoryFromAccount is type AccountEvent
    inlet AccountRepositoryFromAccountAnalytics is type AccountEvent
    outlet AccountRepositoryResponses is type Account.AccountResult
    record StoredAccount is {
      accountId: AccountId with {
        briefly "accountId"
        described as {
          |The accountId column of the stored account row.
        }
      }
      info: AccountInfo with {
        briefly "info"
        described as {
          |The info column of the stored account row.
        }
      }
    } with {
      briefly "Stored account row"
      described as {
        |The persistence shape of account data as this repository stores it.
      }
    }
    schema AccountData is relational
      of accounts as type StoredAccount
        index on field StoredAccount.accountId
        index on field StoredAccount.info.customerId
      with {
      briefly "Account data schema"
      described as {
        |The relational schema holding account data for the AccountRepository.
      }
    }

    handler AccountPersistence is {
      on query GetAccountStats is {
        do "read the account stats projection"
        yield result AccountStatsView
      }
      on command Account.OpenAccount is {
        tell event Account.AccountOpened to entity
          AccountContext.Account
      }
      on command Account.UpdateAccountInfo is {
        tell event Account.AccountInfoUpdated to entity
          AccountContext.Account
      }
      on command Account.AddAccountHolder is {
        tell event Account.AccountHolderAdded to entity
          AccountContext.Account
      }
      on command Account.RecordTransaction is {
        tell event Account.TransactionRecorded to entity
          AccountContext.Account
      }
      on command Account.ProcessTransfer is {
        tell event Account.TransferProcessed to entity
          AccountContext.Account
      }
      on command Account.SetLimit is {
        tell event Account.LimitSet to entity
          AccountContext.Account
      }
      on command Account.ApplyFee is {
        tell event Account.FeeApplied to entity
          AccountContext.Account
      }
      on command Account.FreezeAccount is {
        tell event Account.AccountFrozen to entity
          AccountContext.Account
      }
      on command Account.UnfreezeAccount is {
        tell event Account.AccountUnfrozen to entity
          AccountContext.Account
      }
      on command Account.CloseAccount is {
        tell event Account.AccountClosed to entity
          AccountContext.Account
      }
    } with {
      briefly "Persists account commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Account data persistence"
    described as {
      | The AccountRepository provides persistent storage for
      | bank accounts, transactions, and balances.
    }
  }
  // Projector for account analytics
  query GetAccountStats is {
    accountStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which account stats to retrieve.
      }
    }
  } with {
    briefly "Get account stats"
    described as {
      |Retrieves the account stats projection.
    }
  }
  result AccountStatsView is {
    accountStats: AccountAnalytics.AccountStats with {
      briefly "Account stats"
      described as {
        |The account stats being returned.
      }
    }
  } with {
    briefly "Account stats view"
    described as {
      |Read model view carrying the account stats projection.
    }
  }
  projector AccountAnalytics is {
    inlet AccountAnalyticsFromAccount is type AccountEvent
    outlet AccountAnalyticsOut is type AccountEvent
    updates repository AccountContext.AccountRepository
    record AccountStats is  {
      accountType: AccountType with {
        briefly "Type"
        described as {
          |Account type.
        }
      }
      totalAccounts: Natural with {
        briefly "Accounts"
        described as {
          |Total accounts.
        }
      }
      totalBalance: Decimal(20,2) with {
        briefly "Balance"
        described as {
          |Total balance.
        }
      }
      avgBalance: Decimal(15,2) with {
        briefly "Average"
        described as {
          |Average balance.
        }
      }
      dailyTransactions: Natural with {
        briefly "Transactions"
        described as {
          |Daily transactions.
        }
      }
      dailyVolume: Decimal(20,2) with {
        briefly "Volume"
        described as {
          |Daily volume.
        }
      }
    } with {
      briefly "Account statistics"
      described as {
        |Banking account metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Account.AccountOpened is {
        tell event Account.AccountOpened to repository
          AccountContext.AccountRepository
      }
      on event Account.TransactionRecorded is {
        tell event Account.TransactionRecorded to repository
          AccountContext.AccountRepository
      }
      on event Account.AccountClosed is {
        tell event Account.AccountClosed to repository
          AccountContext.AccountRepository
      }
    } with {
      briefly "Maintains account analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Account analytics projections"
    described as {
      |Maintains banking account analytics data.
    }
  }
  processor AccountEventSource as source is {
    outlet AccountEvents is type AccountEvent
    handler AccountEventEmitter is {
      on init is {
        tell command InitializeAccount to entity
          AccountContext.Account
      }
      on other is {
        error "Unexpected message for source AccountEventSource"
      }
      on event Account.AccountOpened is {
        send event Account.AccountOpened to outlet AccountEvents
      }
      on event Account.TransactionRecorded is {
        send event Account.TransactionRecorded to outlet
          AccountEvents
      }
      on event Account.AccountFrozen is {
        send event Account.AccountFrozen to outlet AccountEvents
      }
      on event Account.AccountUnfrozen is {
        send event Account.AccountUnfrozen to outlet
          AccountEvents
      }
      on event Account.AccountClosed is {
        send event Account.AccountClosed to outlet AccountEvents
      }
    } with {
      briefly "Account event emitter"
      described as {
        |Emits account lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Account event source"
    described as {
      |Publishes account entity events for streaming.
    }
  }
  processor AccountEventSink as sink is {
    inlet IncomingAccountEvents is type AccountEvent
    handler AccountEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink AccountEventSink"
      }
      on event Account.AccountOpened is {
        tell event Account.AccountOpened to repository
          AccountContext.AccountRepository
      }
      on event Account.AccountClosed is {
        tell event Account.AccountClosed to repository
          AccountContext.AccountRepository
      }
    } with {
      briefly "Account event receiver"
      described as {
        |Receives account events and persists them.
      }
    }
  } with {
    briefly "Account event sink"
    described as {
      |Receives account events from the streaming topology.
    }
  }
  connector AccountEventPipeline is {
    from outlet AccountContext.AccountEventSource.AccountEvents
      to inlet AccountContext.AccountEventSink.IncomingAccountEvents
  } with {
    briefly "Account event pipeline"
    described as {
      |Wires account events from source to sink.
    }
  }
  processor AccountEventSplit is {
    inlet AccountEventSplitIn is type AccountEvent
    outlet AccountEventSplitToAccountRepository is type AccountEvent
    outlet AccountEventSplitToAccountAnalytics is type AccountEvent
    handler AccountEventSplitHandler is {
      on event Account.AccountOpened is {
        send event Account.AccountOpened to outlet AccountEventSplitToAccountRepository
        send event Account.AccountOpened to outlet AccountEventSplitToAccountAnalytics
        tell event Account.AccountOpened to entity AccountContext.Account
      }
      on event Account.AccountInfoUpdated is {
        send event Account.AccountInfoUpdated to outlet AccountEventSplitToAccountRepository
        send event Account.AccountInfoUpdated to outlet AccountEventSplitToAccountAnalytics
        tell event Account.AccountInfoUpdated to entity AccountContext.Account
      }
      on event Account.AccountHolderAdded is {
        send event Account.AccountHolderAdded to outlet AccountEventSplitToAccountRepository
        send event Account.AccountHolderAdded to outlet AccountEventSplitToAccountAnalytics
        tell event Account.AccountHolderAdded to entity AccountContext.Account
      }
      on event Account.TransactionRecorded is {
        send event Account.TransactionRecorded to outlet AccountEventSplitToAccountRepository
        send event Account.TransactionRecorded to outlet AccountEventSplitToAccountAnalytics
        tell event Account.TransactionRecorded to entity AccountContext.Account
      }
      on event Account.TransferProcessed is {
        send event Account.TransferProcessed to outlet AccountEventSplitToAccountRepository
        send event Account.TransferProcessed to outlet AccountEventSplitToAccountAnalytics
        tell event Account.TransferProcessed to entity AccountContext.Account
      }
      on event Account.LimitSet is {
        send event Account.LimitSet to outlet AccountEventSplitToAccountRepository
        send event Account.LimitSet to outlet AccountEventSplitToAccountAnalytics
        tell event Account.LimitSet to entity AccountContext.Account
      }
      on event Account.FeeApplied is {
        send event Account.FeeApplied to outlet AccountEventSplitToAccountRepository
        send event Account.FeeApplied to outlet AccountEventSplitToAccountAnalytics
        tell event Account.FeeApplied to entity AccountContext.Account
      }
      on event Account.AccountFrozen is {
        send event Account.AccountFrozen to outlet AccountEventSplitToAccountRepository
        send event Account.AccountFrozen to outlet AccountEventSplitToAccountAnalytics
        tell event Account.AccountFrozen to entity AccountContext.Account
      }
      on event Account.AccountUnfrozen is {
        send event Account.AccountUnfrozen to outlet AccountEventSplitToAccountRepository
        send event Account.AccountUnfrozen to outlet AccountEventSplitToAccountAnalytics
        tell event Account.AccountUnfrozen to entity AccountContext.Account
      }
      on event Account.AccountClosed is {
        send event Account.AccountClosed to outlet AccountEventSplitToAccountRepository
        send event Account.AccountClosed to outlet AccountEventSplitToAccountAnalytics
        tell event Account.AccountClosed to entity AccountContext.Account
      }
      on other is {
        error "Unexpected message for processor AccountEventSplit"
      }
    } with {
      briefly "Account event fan-out handler"
      described as {
        |Delivers each Account event to all of its consumers.
      }
    }
  } with {
    briefly "Account event fan-out"
    described as {
      |Fans Account events out to the repository and projectors.
    }
  }
  connector LinkAccountToAccountEventSplit is {
    from outlet AccountContext.Account.AccountEvents2 to
      inlet AccountContext.AccountEventSplit.AccountEventSplitIn
  } with {
    briefly "LinkAccountToAccountEventSplit"
  }
  connector LinkAccountEventSplitToAccountRepository is {
    from outlet AccountContext.AccountEventSplit.AccountEventSplitToAccountRepository to
      inlet AccountContext.AccountRepository.AccountRepositoryFromAccount
  } with {
    briefly "LinkAccountEventSplitToAccountRepository"
  }
  connector LinkAccountEventSplitToAccountAnalytics is {
    from outlet AccountContext.AccountEventSplit.AccountEventSplitToAccountAnalytics to
      inlet AccountContext.AccountAnalytics.AccountAnalyticsFromAccount
  } with {
    briefly "LinkAccountEventSplitToAccountAnalytics"
  }
  connector LinkAccountAnalyticsToAccountRepository is {
    from outlet AccountContext.AccountAnalytics.AccountAnalyticsOut to
      inlet AccountContext.AccountRepository.AccountRepositoryFromAccountAnalytics
  } with {
    briefly "LinkAccountAnalyticsToAccountRepository"
  }
} with {
  briefly "Bounded context for accounts"
  described as {
    | The AccountContext is the bounded context for bank
    | account management, transactions, and reporting.
  }
}
