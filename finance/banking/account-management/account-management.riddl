// Account Management Domain Model
// Banking account lifecycle and transaction management
domain AccountManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Customer is "person holding bank accounts" with {
    briefly "Customer"
    described as {
      |Bank account holder.
    }
  }
  user BankTeller is "bank employee processing transactions" with {
    briefly "Bank Teller"
    described as {
      |Person handling customer transactions.
    }
  }
  user AccountManager is "person managing customer accounts" with {
    briefly "Account Manager"
    described as {
      |Person overseeing account operations.
    }
  }
  epic TransactionEpic is {
    user Customer wants to "to manage account transactions" so that "funds are properly tracked"
    case ProcessTransaction is {
      user Customer wants to "to complete a banking transaction" so that "funds are moved appropriately"
      step is "Customer initiates" "transaction request" "with details" with {
        briefly "Initiate transaction"
        described as {
          |Start transaction.
        }
      }
      step is "System validates" "account status" "and balance" with {
        briefly "Validate account"
        described as {
          |Check funds.
        }
      }
      step take input AccountManagementApp.AccountManagementScreen.RecordTransactionInput from user BankTeller with {
        briefly "Record transaction"
        described as {
          |Process transaction.
        }
      }
      step is "System updates" "account balance" "and history" with {
        briefly "Update balance"
        described as {
          |Adjust balance.
        }
      }
    } with {
      briefly "Transaction workflow"
      described as {
        |Standard flow for account transactions.
      }
    }
  } with {
    briefly "Transaction processing"
    described as {
      | Epic covering account transactions from initiation
      | through completion and balance update.
    }
  }
  include "AccountContext.riddl"
  include "external-contexts.riddl"
  application context AccountManagementApp is {
    group AccountManagementScreen is {
      input RecordTransactionInput acquires command AccountContext.Account.RecordTransaction with {
        briefly "Record transaction control"
        described as {
          |The control through which a user submits the record transaction request.
        }
      }
    } with {
      briefly "Account management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppAccountCommands is type AccountContext.Account.AccountCommand
    inlet AppAccountRepositoryResponses is type AccountContext.Account.AccountResult
    handler AccountManagementAppHandler is {
      on other is {
        error "Unexpected message for application context AccountManagementApp"
      }
    } with {
      briefly "AccountManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "AccountManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppAccountCommands is {
    from outlet AccountManagementApp.AppAccountCommands to
      inlet AccountContext.Account.AccountCommands
  } with {
    option is persistent
    briefly "LinkAppAccountCommands"
  }
  connector LinkAppAccountRepositoryResponses is {
    from outlet AccountContext.AccountRepository.AccountRepositoryResponses to
      inlet AccountManagementApp.AppAccountRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppAccountRepositoryResponses"
  }
} with {
  briefly "Account management domain"
  described as {
    | The AccountManagement domain handles bank account
    | lifecycle, transactions, and balance management.
  }
}
