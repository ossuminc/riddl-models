// Credit Decisioning Domain Model
// Automated credit assessment and loan approval decisions
domain CreditDecisioning is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user CreditAnalyst is "person reviewing credit applications" with {
    briefly "Credit Analyst"
    described as {
      |Person assessing creditworthiness.
    }
  }
  user Underwriter is "person making final credit decisions" with {
    briefly "Underwriter"
    described as {
      |Person approving or declining applications.
    }
  }
  user RiskManager is "person managing credit policies" with {
    briefly "Risk Manager"
    described as {
      |Person overseeing credit risk.
    }
  }
  epic CreditDecisionEpic is {
    user CreditAnalyst wants to "to assess applications efficiently" so that "decisions are accurate and timely"
    case EvaluateApplicationUseCase is {
      user CreditAnalyst wants to "to evaluate a credit application" so that "a decision can be rendered"
      step is "System retrieves" "application data" "for evaluation" with {
        briefly "Get application"
        described as {
          |Load application.
        }
      }
      step is "System pulls" "credit bureau reports" "for applicant" with {
        briefly "Pull credit"
        described as {
          |Get credit reports.
        }
      }
      step take input CreditDecisioningApp.CreditDecisioningScreen.EvaluateApplicationInput from user CreditAnalyst with {
        briefly "Evaluate"
        described as {
          |Run evaluation.
        }
      }
      step is "System calculates" "credit score" "and risk factors" with {
        briefly "Score"
        described as {
          |Calculate creditworthiness.
        }
      }
    } with {
      briefly "Evaluation workflow"
      described as {
        |Credit application evaluation process.
      }
    }
  } with {
    briefly "Credit decisioning"
    described as {
      | Epic covering credit evaluation from application
      | through scoring and final decision.
    }
  }
  include "DecisionContext.riddl"
  include "external-contexts.riddl"
  application context CreditDecisioningApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CreditDecisioning are delivered.
      }
    }
    group CreditDecisioningScreen is {
      input EvaluateApplicationInput acquires command DecisionContext.Decision.EvaluateApplication with {
        briefly "Evaluate application control"
        described as {
          |The control through which a user submits the evaluate application request.
        }
      }
    } with {
      briefly "Credit decisioning screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppDecisionCommands is type DecisionContext.Decision.DecisionCommand
    inlet AppDecisionRepositoryResponses is type DecisionContext.Decision.DecisionQueryResult    handler CreditDecisioningAppHandler is {
      on other is {
        error "Unexpected message for application context CreditDecisioningApp"
      }
    } with {
      briefly "CreditDecisioningApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CreditDecisioningApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'DecisionCommand Stream' is from outlet CreditDecisioningApp.AppDecisionCommands to inlet DecisionContext.DecisionCommandStreamIn with {
    briefly "Decision commands from the application"
  }
  persistent connector 'DecisionQueryResult Stream' is from outlet DecisionContext.DecisionQueryResultStreamOut to inlet CreditDecisioningApp.AppDecisionRepositoryResponses with {
    briefly "Decision query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CreditDecisioningApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Credit decisioning domain"
  described as {
    | The CreditDecisioning domain handles automated credit
    | assessment, scoring, and approval decisions.
  }
}
