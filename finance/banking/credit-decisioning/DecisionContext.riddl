// Credit Decisioning - Decision Context
context DecisionContext is {
  adaptor FromCreditBureauService from context CreditBureauService is { 
    handler FromCreditBureauServiceHandler is {
      on event CreditBureauService.CreditReportReceived is {
        do "the model receives credit report received"
      }
      on other is {
        error "Unexpected message for adaptor FromCreditBureauService"
      }
    } with {
      briefly "from credit bureau service"
      described as {
        |Carries messages from the external CreditBureauService.
      }
    }
  } with {
    briefly "CreditBureauService integration"
    described as {
      |The model's side of the CreditBureauService conversation.
    }
  }
  adaptor ToCreditBureauService to context CreditBureauService is { 
    handler ToCreditBureauServiceHandler is {
      on command CreditBureauService.PullCreditReport is {
        do "the model sends pull credit report"
      }
      on other is {
        error "Unexpected message for adaptor ToCreditBureauService"
      }
    } with {
      briefly "to credit bureau service"
      described as {
        |Carries messages to the external CreditBureauService.
      }
    }
  } with {
    briefly "CreditBureauService integration"
    described as {
      |The model's side of the CreditBureauService conversation.
    }
  }
  adaptor FromFraudService from context FraudService is { 
    handler FromFraudServiceHandler is {
      on event FraudService.FraudCheckCompleted is {
        do "the model receives fraud check completed"
      }
      on other is {
        error "Unexpected message for adaptor FromFraudService"
      }
    } with {
      briefly "from fraud service"
      described as {
        |Carries messages from the external FraudService.
      }
    }
  } with {
    briefly "FraudService integration"
    described as {
      |The model's side of the FraudService conversation.
    }
  }
  adaptor ToFraudService to context FraudService is { 
    handler ToFraudServiceHandler is {
      on command FraudService.CheckFraud is {
        do "the model sends check fraud"
      }
      on other is {
        error "Unexpected message for adaptor ToFraudService"
      }
    } with {
      briefly "to fraud service"
      described as {
        |Carries messages to the external FraudService.
      }
    }
  } with {
    briefly "FraudService integration"
    described as {
      |The model's side of the FraudService conversation.
    }
  }
  adaptor FromIdentityService from context IdentityService is { 
    handler FromIdentityServiceHandler is {
      on event IdentityService.IdentityVerified is {
        do "the model receives identity verified"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityService"
      }
    } with {
      briefly "from identity service"
      described as {
        |Carries messages from the external IdentityService.
      }
    }
  } with {
    briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor ToIdentityService to context IdentityService is { 
    handler ToIdentityServiceHandler is {
      on command IdentityService.VerifyIdentity is {
        do "the model sends verify identity"
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityService"
      }
    } with {
      briefly "to identity service"
      described as {
        |Carries messages to the external IdentityService.
      }
    }
  } with {
    briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor FromIncomeService from context IncomeService is { 
    handler FromIncomeServiceHandler is {
      on event IncomeService.IncomeVerified is {
        do "the model receives income verified"
      }
      on other is {
        error "Unexpected message for adaptor FromIncomeService"
      }
    } with {
      briefly "from income service"
      described as {
        |Carries messages from the external IncomeService.
      }
    }
  } with {
    briefly "IncomeService integration"
    described as {
      |The model's side of the IncomeService conversation.
    }
  }
  adaptor ToIncomeService to context IncomeService is { 
    handler ToIncomeServiceHandler is {
      on command IncomeService.VerifyIncome is {
        do "the model sends verify income"
      }
      on other is {
        error "Unexpected message for adaptor ToIncomeService"
      }
    } with {
      briefly "to income service"
      described as {
        |Carries messages to the external IncomeService.
      }
    }
  } with {
    briefly "IncomeService integration"
    described as {
      |The model's side of the IncomeService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendDecisionNotification is {
        do "the model sends send decision notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPolicyEngineService from context PolicyEngineService is { 
    handler FromPolicyEngineServiceHandler is {
      on event PolicyEngineService.PolicyEvaluated is {
        do "the model receives policy evaluated"
      }
      on other is {
        error "Unexpected message for adaptor FromPolicyEngineService"
      }
    } with {
      briefly "from policy engine service"
      described as {
        |Carries messages from the external PolicyEngineService.
      }
    }
  } with {
    briefly "PolicyEngineService integration"
    described as {
      |The model's side of the PolicyEngineService conversation.
    }
  }
  adaptor ToPolicyEngineService to context PolicyEngineService is { 
    handler ToPolicyEngineServiceHandler is {
      on command PolicyEngineService.EvaluatePolicy is {
        do "the model sends evaluate policy"
      }
      on other is {
        error "Unexpected message for adaptor ToPolicyEngineService"
      }
    } with {
      briefly "to policy engine service"
      described as {
        |Carries messages to the external PolicyEngineService.
      }
    }
  } with {
    briefly "PolicyEngineService integration"
    described as {
      |The model's side of the PolicyEngineService conversation.
    }
  }
  include "types.riddl"
  include "Decision.riddl"
  // Repository for decision persistence
  repository DecisionRepository as merge is {
    inlet DecisionRepositoryFromDecision is type DecisionEvent    inlet DecisionRepositoryFromDecisionAnalytics is type DecisionEvent    outlet DecisionRepositoryResponses is type Decision.DecisionQueryResult
    record StoredDecision is  {
      decisionId: DecisionId with {
        briefly "decisionId"
        described as {
          |The decisionId column of the stored decision row.
        }
      }
      applicationId: ApplicationId with {
        briefly "applicationId"
        described as {
          |The applicationId column of the stored decision row.
        }
      }
    } with {
      briefly "Stored decision row"
      described as {
        |The persistence shape of decision data as this repository stores it.
      }
    }
    schema DecisionData is relational
      of decisions as type StoredDecision
        index on field StoredDecision.decisionId
        index on field StoredDecision.applicationId
 with {
      briefly "Decision data schema"
      described as {
        |The relational schema holding decision data for the DecisionRepository.
      }
    }
    handler DecisionPersistence is {
      on query GetDecisionStats is {
        let decisionStatsView: type DecisionStatsView = prompt("read the decision stats projection")
        reply decisionStatsView
      }
      on evaluateApplication: command Decision.EvaluateApplication is {
        tell event Decision.ApplicationEvaluationStarted(decisionId = evaluateApplication.decisionId, applicationId = evaluateApplication.applicationId, applicant = evaluateApplication.applicant, request = evaluateApplication.request) to entity DecisionContext.Decision
      }
      on addBureauData: command Decision.AddBureauData is {
        tell event Decision.BureauDataAdded(decisionId = addBureauData.decisionId, bureauData = addBureauData.bureauData) to entity DecisionContext.Decision
      }
      on calculateScore: command Decision.CalculateScore is {
        tell event Decision.ScoreCalculated(decisionId = calculateScore.decisionId) to entity DecisionContext.Decision
      }
      on applyPolicy: command Decision.ApplyPolicy is {
        tell event Decision.PolicyApplied(decisionId = applyPolicy.decisionId) to entity DecisionContext.Decision
      }
      on renderDecision: command Decision.RenderDecision is {
        tell event Decision.DecisionRendered(decisionId = renderDecision.decisionId) to entity DecisionContext.Decision
      }
      on referToUnderwriter: command Decision.ReferToUnderwriter is {
        tell event Decision.ReferredToUnderwriter(decisionId = referToUnderwriter.decisionId, reason = referToUnderwriter.reason) to entity DecisionContext.Decision
      }
      on approveManually: command Decision.ApproveManually is {
        tell event Decision.ManuallyApproved(decisionId = approveManually.decisionId, result = approveManually.result, approvedBy = approveManually.approvedBy) to entity DecisionContext.Decision
      }
      on declineManually: command Decision.DeclineManually is {
        tell event Decision.ManuallyDeclined(decisionId = declineManually.decisionId, reasons = declineManually.reasons, declinedBy = declineManually.declinedBy) to entity DecisionContext.Decision
      }
      on overrideDecision: command Decision.OverrideDecision is {
        tell event Decision.DecisionOverridden(decisionId = overrideDecision.decisionId, newResult = overrideDecision.newResult, override = overrideDecision.override) to entity DecisionContext.Decision
      }
    } with {
      briefly "Persists decision commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Decision data persistence"
    described as {
      | The DecisionRepository provides persistent storage for
      | credit decisions and evaluation data.
    }
  }
  // Projector for decision analytics
  query GetDecisionStats is  {
    decisionStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which decision stats to retrieve.
      }
    }
  } with {
    briefly "Get decision stats"
    described as {
      |Retrieves the decision stats projection.
    }
  }
  result DecisionStatsView is  {
    decisionStats: DecisionAnalytics.DecisionStats with {
      briefly "Decision stats"
      described as {
        |The decision stats being returned.
      }
    }
  } with {
    briefly "Decision stats view"
    described as {
      |Read model view carrying the decision stats projection.
    }
  }
  projector DecisionAnalytics as flow is {
    updates repository DecisionContext.DecisionRepository
    inlet DecisionAnalyticsFromDecision is type DecisionEvent    outlet DecisionAnalyticsOut is type DecisionEvent
    record DecisionStats is  {
      totalApplications: Natural with {
        briefly "Total"
        described as {
          |Total applications.
        }
      }
      autoApprovalRate: Decimal(5,4) with {
        briefly "Auto approval"
        described as {
          |Auto-approval rate.
        }
      }
      manualReviewRate: Decimal(5,4) with {
        briefly "Manual review"
        described as {
          |Manual review rate.
        }
      }
      overallApprovalRate: Decimal(5,4) with {
        briefly "Approval"
        described as {
          |Overall approval rate.
        }
      }
      avgDecisionTime: Duration with {
        briefly "Avg time"
        described as {
          |Average decision time.
        }
      }
      avgApprovedAmount: Decimal(12,2) with {
        briefly "Avg amount"
        described as {
          |Average approved amount.
        }
      }
    } with {
      briefly "Decision statistics"
      described as {
        |Credit decisioning metrics.
      }
    }
    handler AnalyticsHandler is {
      on applicationEvaluationStarted: event Decision.ApplicationEvaluationStarted is {
        tell applicationEvaluationStarted to repository DecisionContext.DecisionRepository
      }
      on decisionRendered: event Decision.DecisionRendered is {
        tell decisionRendered to repository DecisionContext.DecisionRepository
      }
      on manuallyApproved: event Decision.ManuallyApproved is {
        tell manuallyApproved to repository DecisionContext.DecisionRepository
      }
      on manuallyDeclined: event Decision.ManuallyDeclined is {
        tell manuallyDeclined to repository DecisionContext.DecisionRepository
      }
    } with {
      briefly "Maintains decision analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Decision analytics projections"
    described as {
      |Maintains credit decisioning analytics data.
    }
  }
  processor DecisionEventSource as source is {
    outlet DecisionEvents is type DecisionEvent
    handler DecisionEventEmitter is {
      on init is {
        tell command InitializeDecision to entity DecisionContext.Decision
      }
      on other is {
        error "Unexpected message for source DecisionEventSource"
      }
      on applicationEvaluationStarted: event Decision.ApplicationEvaluationStarted is {
        send applicationEvaluationStarted to outlet DecisionEvents
      }
      on decisionRendered: event Decision.DecisionRendered is {
        send decisionRendered to outlet DecisionEvents
      }
      on manuallyApproved: event Decision.ManuallyApproved is {
        send manuallyApproved to outlet DecisionEvents
      }
      on manuallyDeclined: event Decision.ManuallyDeclined is {
        send manuallyDeclined to outlet DecisionEvents
      }
      on decisionOverridden: event Decision.DecisionOverridden is {
        send decisionOverridden to outlet DecisionEvents
      }
    } with {
      briefly "Decision event emitter"
      described as {
        |Emits decision lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Decision event source"
    described as {
      |Publishes decision entity events for streaming.
    }
  }
  processor DecisionEventSink as sink is {
    inlet IncomingDecisionEvents is type DecisionEvent    handler DecisionEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink DecisionEventSink"
      }
      on applicationEvaluationStarted: event Decision.ApplicationEvaluationStarted is {
        tell applicationEvaluationStarted to repository DecisionContext.DecisionRepository
      }
      on decisionRendered: event Decision.DecisionRendered is {
        tell decisionRendered to repository DecisionContext.DecisionRepository
      }
    } with {
      briefly "Decision event receiver"
      described as {
        |Receives decision events and persists them.
      }
    }
  } with {
    briefly "Decision event sink"
    described as {
      |Receives decision events from the streaming topology.
    }
  }
  connector DecisionEventPipeline is from outlet DecisionContext.DecisionEventSource.DecisionEvents to inlet DecisionContext.DecisionEventSink.IncomingDecisionEvents with {
    briefly "Decision event pipeline"
    described as {
      |Wires decision events from source to sink.
    }
  }
  processor DecisionEventSplit as split is {
    inlet DecisionEventSplitIn is type DecisionEvent    outlet DecisionEventSplitToDecisionRepository is type DecisionEvent
    outlet DecisionEventSplitToDecisionAnalytics is type DecisionEvent
    handler DecisionEventSplitHandler is {
      on applicationEvaluationStarted: event Decision.ApplicationEvaluationStarted is {
        send applicationEvaluationStarted to outlet DecisionEventSplitToDecisionRepository
        send applicationEvaluationStarted to outlet DecisionEventSplitToDecisionAnalytics
        tell applicationEvaluationStarted to entity DecisionContext.Decision
      }
      on bureauDataAdded: event Decision.BureauDataAdded is {
        send bureauDataAdded to outlet DecisionEventSplitToDecisionRepository
        send bureauDataAdded to outlet DecisionEventSplitToDecisionAnalytics
        tell bureauDataAdded to entity DecisionContext.Decision
      }
      on scoreCalculated: event Decision.ScoreCalculated is {
        send scoreCalculated to outlet DecisionEventSplitToDecisionRepository
        send scoreCalculated to outlet DecisionEventSplitToDecisionAnalytics
        tell scoreCalculated to entity DecisionContext.Decision
      }
      on policyApplied: event Decision.PolicyApplied is {
        send policyApplied to outlet DecisionEventSplitToDecisionRepository
        send policyApplied to outlet DecisionEventSplitToDecisionAnalytics
        tell policyApplied to entity DecisionContext.Decision
      }
      on decisionRendered: event Decision.DecisionRendered is {
        send decisionRendered to outlet DecisionEventSplitToDecisionRepository
        send decisionRendered to outlet DecisionEventSplitToDecisionAnalytics
        tell decisionRendered to entity DecisionContext.Decision
      }
      on referredToUnderwriter: event Decision.ReferredToUnderwriter is {
        send referredToUnderwriter to outlet DecisionEventSplitToDecisionRepository
        send referredToUnderwriter to outlet DecisionEventSplitToDecisionAnalytics
        tell referredToUnderwriter to entity DecisionContext.Decision
      }
      on manuallyApproved: event Decision.ManuallyApproved is {
        send manuallyApproved to outlet DecisionEventSplitToDecisionRepository
        send manuallyApproved to outlet DecisionEventSplitToDecisionAnalytics
        tell manuallyApproved to entity DecisionContext.Decision
      }
      on manuallyDeclined: event Decision.ManuallyDeclined is {
        send manuallyDeclined to outlet DecisionEventSplitToDecisionRepository
        send manuallyDeclined to outlet DecisionEventSplitToDecisionAnalytics
        tell manuallyDeclined to entity DecisionContext.Decision
      }
      on decisionOverridden: event Decision.DecisionOverridden is {
        send decisionOverridden to outlet DecisionEventSplitToDecisionRepository
        send decisionOverridden to outlet DecisionEventSplitToDecisionAnalytics
        tell decisionOverridden to entity DecisionContext.Decision
      }
      on other is {
        error "Unexpected message for processor DecisionEventSplit"
      }
    } with {
      briefly "Decision event fan-out handler"
      described as {
        |Delivers each Decision event to all of its consumers.
      }
    }
  } with {
    briefly "Decision event fan-out"
    described as {
      |Fans Decision events out to the repository and projectors.
    }
  }
  connector 'DecisionEvent Stream' is from outlet DecisionContext.Decision.DecisionEvents2 to inlet DecisionContext.DecisionEventSplit.DecisionEventSplitIn with {
    briefly "Decision events, fanned out to storage and read models"
  }
  connector 'DecisionEvent Storage' is from outlet DecisionContext.DecisionEventSplit.DecisionEventSplitToDecisionRepository to inlet DecisionContext.DecisionRepository.DecisionRepositoryFromDecision with {
    briefly "Decision events on their way to storage"
  }
  connector 'DecisionAnalytics Feed' is from outlet DecisionContext.DecisionEventSplit.DecisionEventSplitToDecisionAnalytics to inlet DecisionContext.DecisionAnalytics.DecisionAnalyticsFromDecision with {
    briefly "Decision events feeding the DecisionAnalytics projection"
  }
  connector 'DecisionAnalytics Storage' is from outlet DecisionContext.DecisionAnalytics.DecisionAnalyticsOut to inlet DecisionContext.DecisionRepository.DecisionRepositoryFromDecisionAnalytics with {
    briefly "The DecisionAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for credit decisioning"
  described as {
    | The DecisionContext is the bounded context for credit
    | evaluation, scoring, and approval decisions.
  }
}
