// Credit Decisioning - Decision Context
context DecisionContext as router is {
  inlet DecisionContextFromCreditBureauService is command Decision.AddBureauData with {
    briefly "What FromCreditBureauService makes of that service's news"
  }
  connector 'FromCreditBureauService Intake' is from outlet DecisionContext.FromCreditBureauService.FromCreditBureauServiceToDecisionContext to inlet DecisionContext.DecisionContextFromCreditBureauService with {
    briefly "What FromCreditBureauService makes of that news, on its way in"
  }
  inlet DecisionContextFromPolicyEngineService is command Decision.RenderDecision with {
    briefly "What FromPolicyEngineService makes of that service's news"
  }
  connector 'FromPolicyEngineService Intake' is from outlet DecisionContext.FromPolicyEngineService.FromPolicyEngineServiceToDecisionContext to inlet DecisionContext.DecisionContextFromPolicyEngineService with {
    briefly "What FromPolicyEngineService makes of that news, on its way in"
  }
  inlet DecisionCommandStreamIn is type DecisionCommand  outlet DecisionCommandStreamOut is type DecisionCommand
  inlet DecisionQueryResultStreamIn is result Decision.DecisionQueryResult  outlet DecisionQueryResultStreamOut is result Decision.DecisionQueryResult
  handler DecisionContextBoundary is {
    on evaluateApplication: command Decision.EvaluateApplication is {
      send evaluateApplication to outlet DecisionContext.DecisionCommandStreamOut
    }
    on addBureauData: command Decision.AddBureauData is {
      send addBureauData to outlet DecisionContext.DecisionCommandStreamOut
    }
    on calculateScore: command Decision.CalculateScore is {
      send calculateScore to outlet DecisionContext.DecisionCommandStreamOut
    }
    on applyPolicy: command Decision.ApplyPolicy is {
      send applyPolicy to outlet DecisionContext.DecisionCommandStreamOut
    }
    on renderDecision: command Decision.RenderDecision is {
      send renderDecision to outlet DecisionContext.DecisionCommandStreamOut
    }
    on referToUnderwriter: command Decision.ReferToUnderwriter is {
      send referToUnderwriter to outlet DecisionContext.DecisionCommandStreamOut
    }
    on approveManually: command Decision.ApproveManually is {
      send approveManually to outlet DecisionContext.DecisionCommandStreamOut
    }
    on declineManually: command Decision.DeclineManually is {
      send declineManually to outlet DecisionContext.DecisionCommandStreamOut
    }
    on overrideDecision: command Decision.OverrideDecision is {
      send overrideDecision to outlet DecisionContext.DecisionCommandStreamOut
    }
    on decisionQueryResult: result Decision.DecisionQueryResult is {
      send decisionQueryResult to outlet DecisionContext.DecisionQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the DecisionContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'DecisionCommand Stream Intake' is from outlet DecisionContext.DecisionCommandStreamOut to inlet DecisionContext.Decision.DecisionCommands  connector 'DecisionQueryResult Stream Egress' is from outlet DecisionContext.DecisionRepository.DecisionRepositoryResponses to inlet DecisionContext.DecisionQueryResultStreamIn  adaptor FromCreditBureauService from context CreditBureauService as flow is { 
    inlet FromCreditBureauServiceIn is event CreditBureauService.CreditReportReceived    outlet FromCreditBureauServiceToDecisionContext is command Decision.AddBureauData
    handler FromCreditBureauServiceHandler is {
      on creditReportReceived: event CreditBureauService.CreditReportReceived is {
        let item0: type Decision.AddBureauData = prompt("translate the creditReportReceived event into a AddBureauData, the bureau's report is the data the decision is made on, so it must reach the decision")
        send item0 to outlet DecisionContext.FromCreditBureauService.FromCreditBureauServiceToDecisionContext
      }
      on other is {
        error "Unexpected message for adaptor FromCreditBureauService"
      }
    } with {
      briefly "from credit bureau service"
      described as {
        |Carries messages from the external CreditBureauService.
      }
    }
  } with {
    briefly "CreditBureauService integration"
    described as {
      |The model's side of the CreditBureauService conversation.
    }
  }
  adaptor ToCreditBureauService to context CreditBureauService as flow is { 
    inlet ToCreditBureauServiceIn is type DecisionEvent    outlet ToCreditBureauServiceOut is command CreditBureauService.PullCreditReport
    handler ToCreditBureauServiceHandler is {
      on applicationEvaluationStarted: event Decision.ApplicationEvaluationStarted is {
        let item0: type CreditBureauService.PullCreditReport = prompt("translate the applicationEvaluationStarted event into a PullCreditReport, evaluation being unable to start on an unknown history")
        send item0 to outlet DecisionContext.ToCreditBureauService.ToCreditBureauServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToCreditBureauService"
      }
    } with {
      briefly "to credit bureau service"
      described as {
        |Carries messages to the external CreditBureauService.
      }
    }
  } with {
    briefly "CreditBureauService integration"
    described as {
      |The model's side of the CreditBureauService conversation.
    }
  }
  adaptor FromFraudService from context FraudService is { 
    inlet FromFraudServiceIn is event FraudService.FraudCheckCompleted    handler FromFraudServiceHandler is {
      on fraudCheckCompleted: event FraudService.FraudCheckCompleted is {
        do "the fraud check is back; the policy evaluation weighs it when it runs"
      }
      on other is {
        error "Unexpected message for adaptor FromFraudService"
      }
    } with {
      briefly "from fraud service"
      described as {
        |Carries messages from the external FraudService.
      }
    }
  } with {
    briefly "FraudService integration"
    described as {
      |The model's side of the FraudService conversation.
    }
  }
  adaptor ToFraudService to context FraudService as flow is { 
    inlet ToFraudServiceIn is type DecisionEvent    outlet ToFraudServiceOut is command FraudService.CheckFraud
    handler ToFraudServiceHandler is {
      on applicationEvaluationStarted: event ApplicationEvaluationStarted is {
        let item0: type FraudService.CheckFraud = prompt("translate the applicationEvaluationStarted event into a CheckFraud, since a decision must not be reached on an unscreened application")
        send item0 to outlet DecisionContext.ToFraudService.ToFraudServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToFraudService"
      }
    } with {
      briefly "to fraud service"
      described as {
        |Carries messages to the external FraudService.
      }
    }
  } with {
    briefly "FraudService integration"
    described as {
      |The model's side of the FraudService conversation.
    }
  }
  adaptor FromIdentityService from context IdentityService is { 
    inlet FromIdentityServiceIn is event IdentityService.IdentityVerified    handler FromIdentityServiceHandler is {
      on identityVerified: event IdentityService.IdentityVerified is {
        do "identity is confirmed; the decision weighs it when the application is evaluated"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityService"
      }
    } with {
      briefly "from identity service"
      described as {
        |Carries messages from the external IdentityService.
      }
    }
  } with {
    briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor ToIdentityService to context IdentityService as flow is { 
    inlet ToIdentityServiceIn is type DecisionEvent    outlet ToIdentityServiceOut is command IdentityService.VerifyIdentity
    handler ToIdentityServiceHandler is {
      on applicationEvaluationStarted: event ApplicationEvaluationStarted is {
        let check0: type IdentityService.VerifyIdentity = prompt("translate the applicationEvaluationStarted event into a VerifyIdentity, since nothing may be decided about an unverified applicant")
        send check0 to outlet DecisionContext.ToIdentityService.ToIdentityServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityService"
      }
    } with {
      briefly "to identity service"
      described as {
        |Carries messages to the external IdentityService.
      }
    }
  } with {
    briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor FromIncomeService from context IncomeService is { 
    inlet FromIncomeServiceIn is event IncomeService.IncomeVerified    handler FromIncomeServiceHandler is {
      on incomeVerified: event IncomeService.IncomeVerified is {
        do "verified income is an input the evaluation uses; it does not itself decide"
      }
      on other is {
        error "Unexpected message for adaptor FromIncomeService"
      }
    } with {
      briefly "from income service"
      described as {
        |Carries messages from the external IncomeService.
      }
    }
  } with {
    briefly "IncomeService integration"
    described as {
      |The model's side of the IncomeService conversation.
    }
  }
  adaptor ToIncomeService to context IncomeService as flow is { 
    inlet ToIncomeServiceIn is type DecisionEvent    outlet ToIncomeServiceOut is command IncomeService.VerifyIncome
    handler ToIncomeServiceHandler is {
      on applicationEvaluationStarted: event Decision.ApplicationEvaluationStarted is {
        let item0: type IncomeService.VerifyIncome = prompt("translate the applicationEvaluationStarted event into a VerifyIncome, no decision being reachable on an unverified income")
        send item0 to outlet DecisionContext.ToIncomeService.ToIncomeServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToIncomeService"
      }
    } with {
      briefly "to income service"
      described as {
        |Carries messages to the external IncomeService.
      }
    }
  } with {
    briefly "IncomeService integration"
    described as {
      |The model's side of the IncomeService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type DecisionEvent    outlet ToNotificationServiceOut is command NotificationService.SendDecisionNotification
    handler ToNotificationServiceHandler is {
      on decisionRendered: event DecisionRendered is {
        let notice: type NotificationService.SendDecisionNotification = prompt("translate the decisionRendered event into a SendDecisionNotification telling the applicant the automated decision and the score band it rested on")
        send notice to outlet DecisionContext.ToNotificationService.ToNotificationServiceOut
      }
      on referredToUnderwriter: event ReferredToUnderwriter is {
        let notice: type NotificationService.SendDecisionNotification = prompt("translate the referredToUnderwriter event into a SendDecisionNotification telling the applicant the decision needs human review, so they expect a delay rather than an answer")
        send notice to outlet DecisionContext.ToNotificationService.ToNotificationServiceOut
      }
      on manuallyApproved: event ManuallyApproved is {
        let notice: type NotificationService.SendDecisionNotification = prompt("translate the manuallyApproved event into a SendDecisionNotification telling the applicant an underwriter approved the application")
        send notice to outlet DecisionContext.ToNotificationService.ToNotificationServiceOut
      }
      on manuallyDeclined: event ManuallyDeclined is {
        let notice: type NotificationService.SendDecisionNotification = prompt("translate the manuallyDeclined event into a SendDecisionNotification telling the applicant an underwriter declined it, with the recorded reason")
        send notice to outlet DecisionContext.ToNotificationService.ToNotificationServiceOut
      }
      on decisionOverridden: event DecisionOverridden is {
        let notice: type NotificationService.SendDecisionNotification = prompt("translate the decisionOverridden event into a SendDecisionNotification telling the applicant the earlier decision has been replaced and what now stands")
        send notice to outlet DecisionContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPolicyEngineService from context PolicyEngineService as flow is { 
    inlet FromPolicyEngineServiceIn is event PolicyEngineService.PolicyEvaluated    outlet FromPolicyEngineServiceToDecisionContext is command Decision.RenderDecision
    handler FromPolicyEngineServiceHandler is {
      on policyEvaluated: event PolicyEngineService.PolicyEvaluated is {
        let item0: type Decision.RenderDecision = prompt("translate the policyEvaluated event into a RenderDecision, the policy engine's verdict is what the decision renders")
        send item0 to outlet DecisionContext.FromPolicyEngineService.FromPolicyEngineServiceToDecisionContext
      }
      on other is {
        error "Unexpected message for adaptor FromPolicyEngineService"
      }
    } with {
      briefly "from policy engine service"
      described as {
        |Carries messages from the external PolicyEngineService.
      }
    }
  } with {
    briefly "PolicyEngineService integration"
    described as {
      |The model's side of the PolicyEngineService conversation.
    }
  }
  adaptor ToPolicyEngineService to context PolicyEngineService as flow is { 
    inlet ToPolicyEngineServiceIn is type DecisionEvent    outlet ToPolicyEngineServiceOut is command PolicyEngineService.EvaluatePolicy
    handler ToPolicyEngineServiceHandler is {
      on scoreCalculated: event Decision.ScoreCalculated is {
        let item0: type PolicyEngineService.EvaluatePolicy = prompt("translate the scoreCalculated event into a EvaluatePolicy, policy being applied to a score rather than to an application")
        send item0 to outlet DecisionContext.ToPolicyEngineService.ToPolicyEngineServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToPolicyEngineService"
      }
    } with {
      briefly "to policy engine service"
      described as {
        |Carries messages to the external PolicyEngineService.
      }
    }
  } with {
    briefly "PolicyEngineService integration"
    described as {
      |The model's side of the PolicyEngineService conversation.
    }
  }
  include "types.riddl"
  include "Decision.riddl"
  // Repository for decision persistence
  type DecisionRepositoryCommand is one of {
    DecisionContext.DecisionRepository.PersistApplicationEvaluationStarted or DecisionContext.DecisionRepository.PersistBureauDataAdded or DecisionContext.DecisionRepository.PersistDecisionOverridden or DecisionContext.DecisionRepository.PersistDecisionRendered or DecisionContext.DecisionRepository.PersistManuallyApproved or DecisionContext.DecisionRepository.PersistManuallyDeclined or DecisionContext.DecisionRepository.PersistPolicyApplied or DecisionContext.DecisionRepository.PersistReferredToUnderwriter or DecisionContext.DecisionRepository.PersistScoreCalculated
  } with {
    briefly "Anything that writes DecisionRepository"
    described as {
      |The persistence commands DecisionRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository DecisionRepository as flow is {
    inlet DecisionRepositoryFromDecisionAnalytics is type DecisionRepositoryCommand    command PersistBureauDataAdded is {
      decisionId: DecisionId with {
        briefly "Row addressed"
        described as {
          |Which stored row BureauDataAdded applies to.
        }
      }
    } with {
      briefly "Persist BureauDataAdded"
      described as {
        |Instructs this repository to apply BureauDataAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDecisionOverridden is {
      decisionId: DecisionId with {
        briefly "Row addressed"
        described as {
          |Which stored row DecisionOverridden applies to.
        }
      }
    } with {
      briefly "Persist DecisionOverridden"
      described as {
        |Instructs this repository to apply DecisionOverridden to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPolicyApplied is {
      decisionId: DecisionId with {
        briefly "Row addressed"
        described as {
          |Which stored row PolicyApplied applies to.
        }
      }
    } with {
      briefly "Persist PolicyApplied"
      described as {
        |Instructs this repository to apply PolicyApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReferredToUnderwriter is {
      decisionId: DecisionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReferredToUnderwriter applies to.
        }
      }
    } with {
      briefly "Persist ReferredToUnderwriter"
      described as {
        |Instructs this repository to apply ReferredToUnderwriter to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistScoreCalculated is {
      decisionId: DecisionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ScoreCalculated applies to.
        }
      }
    } with {
      briefly "Persist ScoreCalculated"
      described as {
        |Instructs this repository to apply ScoreCalculated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistApplicationEvaluationStarted is {
      decisionId: DecisionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApplicationEvaluationStarted applies to.
        }
      }
    } with {
      briefly "Persist ApplicationEvaluationStarted"
      described as {
        |Instructs this repository to apply ApplicationEvaluationStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDecisionRendered is {
      decisionId: DecisionId with {
        briefly "Row addressed"
        described as {
          |Which stored row DecisionRendered applies to.
        }
      }
    } with {
      briefly "Persist DecisionRendered"
      described as {
        |Instructs this repository to apply DecisionRendered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistManuallyApproved is {
      decisionId: DecisionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ManuallyApproved applies to.
        }
      }
    } with {
      briefly "Persist ManuallyApproved"
      described as {
        |Instructs this repository to apply ManuallyApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistManuallyDeclined is {
      decisionId: DecisionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ManuallyDeclined applies to.
        }
      }
    } with {
      briefly "Persist ManuallyDeclined"
      described as {
        |Instructs this repository to apply ManuallyDeclined to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet DecisionRepositoryResponses is result Decision.DecisionQueryResult
    record StoredDecision is {
      decisionId: DecisionId with {
        briefly "decisionId"
        described as {
          |The decisionId column of the stored decision row.
        }
      }
      applicationId: ApplicationId with {
        briefly "applicationId"
        described as {
          |The applicationId column of the stored decision row.
        }
      }
    } with {
      briefly "Stored decision row"
      described as {
        |The persistence shape of decision data as this repository stores it.
      }
    }
    schema DecisionData is relational
      of decisions as record StoredDecision
        index on field StoredDecision.decisionId
        index on field StoredDecision.applicationId
 with {
      briefly "Decision data schema"
      described as {
        |The relational schema holding decision data for the DecisionRepository.
      }
    }
    handler DecisionPersistence is {
      on persistBureauDataAdded: command PersistBureauDataAdded is {
        do "apply BureauDataAdded to the stored row"
      }
      on persistDecisionOverridden: command PersistDecisionOverridden is {
        do "apply DecisionOverridden to the stored row"
      }
      on persistPolicyApplied: command PersistPolicyApplied is {
        do "apply PolicyApplied to the stored row"
      }
      on persistReferredToUnderwriter: command PersistReferredToUnderwriter is {
        do "apply ReferredToUnderwriter to the stored row"
      }
      on persistScoreCalculated: command PersistScoreCalculated is {
        do "apply ScoreCalculated to the stored row"
      }
      on persistApplicationEvaluationStarted: command PersistApplicationEvaluationStarted is {
        do "apply ApplicationEvaluationStarted to the stored row"
      }
      on persistDecisionRendered: command PersistDecisionRendered is {
        do "apply DecisionRendered to the stored row"
      }
      on persistManuallyApproved: command PersistManuallyApproved is {
        do "apply ManuallyApproved to the stored row"
      }
      on persistManuallyDeclined: command PersistManuallyDeclined is {
        do "apply ManuallyDeclined to the stored row"
      }
      on query GetDecisionStats is {
        let decisionStatsView: type DecisionStatsView = prompt("read the decision stats projection")
        reply decisionStatsView
      }
    } with {
      briefly "Persists decision commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Decision data persistence"
    described as {
      | The DecisionRepository provides persistent storage for
      | credit decisions and evaluation data.
    }
  }
  // Projector for decision analytics
  query GetDecisionStats replies result DecisionStatsView is {
    decisionStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which decision stats to retrieve.
      }
    }
  } with {
    briefly "Get decision stats"
    described as {
      |Retrieves the decision stats projection.
    }
  }
  result DecisionStatsView is {
    decisionStats: DecisionAnalytics.DecisionStats with {
      briefly "Decision stats"
      described as {
        |The decision stats being returned.
      }
    }
  } with {
    briefly "Decision stats view"
    described as {
      |Read model view carrying the decision stats projection.
    }
  }
  projector DecisionAnalytics as flow is {
    updates repository DecisionContext.DecisionRepository
    outlet DecisionAnalyticsToRepository is type DecisionRepositoryCommand
    inlet DecisionAnalyticsFromDecision is type DecisionEvent    record DecisionStats is {
      totalApplications: Natural with {
        briefly "Total"
        described as {
          |Total applications.
        }
      }
      autoApprovalRate: Decimal(5,4) with {
        briefly "Auto approval"
        described as {
          |Auto-approval rate.
        }
      }
      manualReviewRate: Decimal(5,4) with {
        briefly "Manual review"
        described as {
          |Manual review rate.
        }
      }
      overallApprovalRate: Decimal(5,4) with {
        briefly "Approval"
        described as {
          |Overall approval rate.
        }
      }
      avgDecisionTime: Duration with {
        briefly "Avg time"
        described as {
          |Average decision time.
        }
      }
      avgApprovedAmount: Decimal(12,2) with {
        briefly "Avg amount"
        described as {
          |Average approved amount.
        }
      }
    } with {
      briefly "Decision statistics"
      described as {
        |Credit decisioning metrics.
      }
    }
    handler AnalyticsHandler is {
      on bureauDataAdded: event Decision.BureauDataAdded is {
        tell command DecisionContext.DecisionRepository.PersistBureauDataAdded(decisionId = bureauDataAdded.decisionId) to repository DecisionContext.DecisionRepository
        do "apply BureauDataAdded to the DecisionAnalytics projection"
      }
      on decisionOverridden: event Decision.DecisionOverridden is {
        tell command DecisionContext.DecisionRepository.PersistDecisionOverridden(decisionId = decisionOverridden.decisionId) to repository DecisionContext.DecisionRepository
        do "apply DecisionOverridden to the DecisionAnalytics projection"
      }
      on policyApplied: event Decision.PolicyApplied is {
        tell command DecisionContext.DecisionRepository.PersistPolicyApplied(decisionId = policyApplied.decisionId) to repository DecisionContext.DecisionRepository
        do "apply PolicyApplied to the DecisionAnalytics projection"
      }
      on referredToUnderwriter: event Decision.ReferredToUnderwriter is {
        tell command DecisionContext.DecisionRepository.PersistReferredToUnderwriter(decisionId = referredToUnderwriter.decisionId) to repository DecisionContext.DecisionRepository
        do "apply ReferredToUnderwriter to the DecisionAnalytics projection"
      }
      on scoreCalculated: event Decision.ScoreCalculated is {
        tell command DecisionContext.DecisionRepository.PersistScoreCalculated(decisionId = scoreCalculated.decisionId) to repository DecisionContext.DecisionRepository
        do "apply ScoreCalculated to the DecisionAnalytics projection"
      }
      on applicationEvaluationStarted: event Decision.ApplicationEvaluationStarted is {
        tell command DecisionContext.DecisionRepository.PersistApplicationEvaluationStarted(decisionId = applicationEvaluationStarted.decisionId) to repository DecisionContext.DecisionRepository
      }
      on decisionRendered: event Decision.DecisionRendered is {
        tell command DecisionContext.DecisionRepository.PersistDecisionRendered(decisionId = decisionRendered.decisionId) to repository DecisionContext.DecisionRepository
      }
      on manuallyApproved: event Decision.ManuallyApproved is {
        tell command DecisionContext.DecisionRepository.PersistManuallyApproved(decisionId = manuallyApproved.decisionId) to repository DecisionContext.DecisionRepository
      }
      on manuallyDeclined: event Decision.ManuallyDeclined is {
        tell command DecisionContext.DecisionRepository.PersistManuallyDeclined(decisionId = manuallyDeclined.decisionId) to repository DecisionContext.DecisionRepository
      }
    } with {
      briefly "Maintains decision analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Decision analytics projections"
    described as {
      |Maintains credit decisioning analytics data.
    }
  }
  streamlet DecisionEventSplit as split is {
    outlet DecisionEventSplitToToPolicyEngineService is type DecisionEvent
    outlet DecisionEventSplitToToNotificationService is type DecisionEvent
    outlet DecisionEventSplitToToIncomeService is type DecisionEvent
    outlet DecisionEventSplitToToIdentityService is type DecisionEvent
    outlet DecisionEventSplitToToFraudService is type DecisionEvent
    outlet DecisionEventSplitToToCreditBureauService is type DecisionEvent
    inlet DecisionEventSplitIn is type DecisionEvent    outlet DecisionEventSplitToDecisionAnalytics is type DecisionEvent
    handler DecisionEventSplitHandler is {
      on applicationEvaluationStarted: event Decision.ApplicationEvaluationStarted is {
        send applicationEvaluationStarted to outlet DecisionEventSplitToDecisionAnalytics
        send applicationEvaluationStarted to outlet DecisionEventSplitToToIncomeService
        send applicationEvaluationStarted to outlet DecisionEventSplitToToIdentityService
        send applicationEvaluationStarted to outlet DecisionEventSplitToToFraudService
        send applicationEvaluationStarted to outlet DecisionEventSplitToToCreditBureauService
        tell applicationEvaluationStarted to entity DecisionContext.Decision
      }
      on bureauDataAdded: event Decision.BureauDataAdded is {
        send bureauDataAdded to outlet DecisionEventSplitToDecisionAnalytics
        tell bureauDataAdded to entity DecisionContext.Decision
      }
      on scoreCalculated: event Decision.ScoreCalculated is {
        send scoreCalculated to outlet DecisionEventSplitToDecisionAnalytics
        send scoreCalculated to outlet DecisionEventSplitToToPolicyEngineService
        tell scoreCalculated to entity DecisionContext.Decision
      }
      on policyApplied: event Decision.PolicyApplied is {
        send policyApplied to outlet DecisionEventSplitToDecisionAnalytics
        tell policyApplied to entity DecisionContext.Decision
      }
      on decisionRendered: event Decision.DecisionRendered is {
        send decisionRendered to outlet DecisionEventSplitToDecisionAnalytics
        send decisionRendered to outlet DecisionEventSplitToToNotificationService
        tell decisionRendered to entity DecisionContext.Decision
      }
      on referredToUnderwriter: event Decision.ReferredToUnderwriter is {
        send referredToUnderwriter to outlet DecisionEventSplitToDecisionAnalytics
        send referredToUnderwriter to outlet DecisionEventSplitToToNotificationService
        tell referredToUnderwriter to entity DecisionContext.Decision
      }
      on manuallyApproved: event Decision.ManuallyApproved is {
        send manuallyApproved to outlet DecisionEventSplitToDecisionAnalytics
        send manuallyApproved to outlet DecisionEventSplitToToNotificationService
        tell manuallyApproved to entity DecisionContext.Decision
      }
      on manuallyDeclined: event Decision.ManuallyDeclined is {
        send manuallyDeclined to outlet DecisionEventSplitToDecisionAnalytics
        send manuallyDeclined to outlet DecisionEventSplitToToNotificationService
        tell manuallyDeclined to entity DecisionContext.Decision
      }
      on decisionOverridden: event Decision.DecisionOverridden is {
        send decisionOverridden to outlet DecisionEventSplitToDecisionAnalytics
        send decisionOverridden to outlet DecisionEventSplitToToNotificationService
        tell decisionOverridden to entity DecisionContext.Decision
      }
      on other is {
        error "Unexpected message for processor DecisionEventSplit"
      }
    } with {
      briefly "Decision event fan-out handler"
      described as {
        |Delivers each Decision event to all of its consumers.
      }
    }
  } with {
    briefly "Decision event fan-out"
    described as {
      |Fans Decision events out to the repository and projectors.
    }
  }
  connector 'ToPolicyEngineService Feed' is from outlet DecisionContext.DecisionEventSplit.DecisionEventSplitToToPolicyEngineService to inlet DecisionContext.ToPolicyEngineService.ToPolicyEngineServiceIn with {
    briefly "The Decision events ToPolicyEngineService translates, on their way to it"
  }
  connector 'ToNotificationService Feed' is from outlet DecisionContext.DecisionEventSplit.DecisionEventSplitToToNotificationService to inlet DecisionContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The Decision events ToNotificationService translates, on their way to it"
  }
  connector 'ToIncomeService Feed' is from outlet DecisionContext.DecisionEventSplit.DecisionEventSplitToToIncomeService to inlet DecisionContext.ToIncomeService.ToIncomeServiceIn with {
    briefly "The Decision events ToIncomeService translates, on their way to it"
  }
  connector 'ToIdentityService Feed' is from outlet DecisionContext.DecisionEventSplit.DecisionEventSplitToToIdentityService to inlet DecisionContext.ToIdentityService.ToIdentityServiceIn with {
    briefly "The Decision events ToIdentityService translates, on their way to it"
  }
  connector 'ToFraudService Feed' is from outlet DecisionContext.DecisionEventSplit.DecisionEventSplitToToFraudService to inlet DecisionContext.ToFraudService.ToFraudServiceIn with {
    briefly "The Decision events ToFraudService translates, on their way to it"
  }
  connector 'ToCreditBureauService Feed' is from outlet DecisionContext.DecisionEventSplit.DecisionEventSplitToToCreditBureauService to inlet DecisionContext.ToCreditBureauService.ToCreditBureauServiceIn with {
    briefly "The Decision events ToCreditBureauService translates, on their way to it"
  }
  connector 'DecisionEvent Stream' is from outlet DecisionContext.Decision.DecisionEvents2 to inlet DecisionContext.DecisionEventSplit.DecisionEventSplitIn with {
    briefly "Decision events, fanned out to storage and read models"
  }
  connector 'DecisionAnalytics Feed' is from outlet DecisionContext.DecisionEventSplit.DecisionEventSplitToDecisionAnalytics to inlet DecisionContext.DecisionAnalytics.DecisionAnalyticsFromDecision with {
    briefly "Decision events feeding the DecisionAnalytics projection"
  }
  connector 'DecisionAnalytics Storage' is from outlet DecisionContext.DecisionAnalytics.DecisionAnalyticsToRepository to inlet DecisionContext.DecisionRepository.DecisionRepositoryFromDecisionAnalytics with {
    briefly "DecisionAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for credit decisioning"
  described as {
    | The DecisionContext is the bounded context for credit
    | evaluation, scoring, and approval decisions.
  }
}
