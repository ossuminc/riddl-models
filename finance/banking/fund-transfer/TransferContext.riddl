// Fund Transfer - Transfer Context
context TransferContext as router is {
  inlet TransferCommandStreamIn is type TransferCommand  outlet TransferCommandStreamOut is type TransferCommand
  inlet TransferResultStreamIn is result Transfer.TransferResult  outlet TransferResultStreamOut is result Transfer.TransferResult
  handler TransferContextBoundary is {
    on submitTransfer: command Transfer.SubmitTransfer is {
      send submitTransfer to outlet TransferContext.TransferCommandStreamOut
    }
    on validateTransfer: command Transfer.ValidateTransfer is {
      send validateTransfer to outlet TransferContext.TransferCommandStreamOut
    }
    on applyFees: command Transfer.ApplyFees is {
      send applyFees to outlet TransferContext.TransferCommandStreamOut
    }
    on applyExchangeRate: command Transfer.ApplyExchangeRate is {
      send applyExchangeRate to outlet TransferContext.TransferCommandStreamOut
    }
    on routeTransfer: command Transfer.RouteTransfer is {
      send routeTransfer to outlet TransferContext.TransferCommandStreamOut
    }
    on processTransfer: command Transfer.ProcessTransfer is {
      send processTransfer to outlet TransferContext.TransferCommandStreamOut
    }
    on completeTransfer: command Transfer.CompleteTransfer is {
      send completeTransfer to outlet TransferContext.TransferCommandStreamOut
    }
    on returnTransfer: command Transfer.ReturnTransfer is {
      send returnTransfer to outlet TransferContext.TransferCommandStreamOut
    }
    on cancelTransfer: command Transfer.CancelTransfer is {
      send cancelTransfer to outlet TransferContext.TransferCommandStreamOut
    }
    on transferResult: result Transfer.TransferResult is {
      send transferResult to outlet TransferContext.TransferResultStreamOut
    }
    on other is {
      error "Unexpected message at the TransferContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TransferCommand Stream Intake' is from outlet TransferContext.TransferCommandStreamOut to inlet TransferContext.Transfer.TransferCommands  connector 'TransferResult Stream Egress' is from outlet TransferContext.TransferRepository.TransferRepositoryResponses to inlet TransferContext.TransferResultStreamIn  adaptor FromACHNetworkService from context ACHNetworkService is { 
    handler FromACHNetworkServiceHandler is {
      on event ACHNetworkService.ACHProcessed is {
        do "the model receives ach processed"
      }
      on other is {
        error "Unexpected message for adaptor FromACHNetworkService"
      }
    } with {
      briefly "from ach network service"
      described as {
        |Carries messages from the external ACHNetworkService.
      }
    }
  } with {
    briefly "ACHNetworkService integration"
    described as {
      |The model's side of the ACHNetworkService conversation.
    }
  }
  adaptor ToACHNetworkService to context ACHNetworkService is { 
    handler ToACHNetworkServiceHandler is {
      on command ACHNetworkService.SubmitACHTransaction is {
        do "the model sends submit ach transaction"
      }
      on other is {
        error "Unexpected message for adaptor ToACHNetworkService"
      }
    } with {
      briefly "to ach network service"
      described as {
        |Carries messages to the external ACHNetworkService.
      }
    }
  } with {
    briefly "ACHNetworkService integration"
    described as {
      |The model's side of the ACHNetworkService conversation.
    }
  }
  adaptor FromAccountService from context AccountService is { 
    handler FromAccountServiceHandler is {
      on event AccountService.AccountDebited is {
        do "the model receives account debited"
      }
      on other is {
        error "Unexpected message for adaptor FromAccountService"
      }
    } with {
      briefly "from account service"
      described as {
        |Carries messages from the external AccountService.
      }
    }
  } with {
    briefly "AccountService integration"
    described as {
      |The model's side of the AccountService conversation.
    }
  }
  adaptor ToAccountService to context AccountService is { 
    handler ToAccountServiceHandler is {
      on command AccountService.DebitAccount is {
        do "the model sends debit account"
      }
      on other is {
        error "Unexpected message for adaptor ToAccountService"
      }
    } with {
      briefly "to account service"
      described as {
        |Carries messages to the external AccountService.
      }
    }
  } with {
    briefly "AccountService integration"
    described as {
      |The model's side of the AccountService conversation.
    }
  }
  adaptor FromFXService from context FXService is { 
    handler FromFXServiceHandler is {
      on result FXService.ExchangeQuote is {
        do "the model receives exchange quote"
      }
      on other is {
        error "Unexpected message for adaptor FromFXService"
      }
    } with {
      briefly "from fx service"
      described as {
        |Carries messages from the external FXService.
      }
    }
  } with {
    briefly "FXService integration"
    described as {
      |The model's side of the FXService conversation.
    }
  }
  adaptor ToFXService to context FXService is { 
    handler ToFXServiceHandler is {
      on query FXService.GetExchangeRate is {
        do "the model sends get exchange rate"
      }
      on other is {
        error "Unexpected message for adaptor ToFXService"
      }
    } with {
      briefly "to fx service"
      described as {
        |Carries messages to the external FXService.
      }
    }
  } with {
    briefly "FXService integration"
    described as {
      |The model's side of the FXService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendTransferNotification is {
        do "the model sends send transfer notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromSanctionsService from context SanctionsService is { 
    handler FromSanctionsServiceHandler is {
      on event SanctionsService.ScreeningCompleted is {
        do "the model receives screening completed"
      }
      on other is {
        error "Unexpected message for adaptor FromSanctionsService"
      }
    } with {
      briefly "from sanctions service"
      described as {
        |Carries messages from the external SanctionsService.
      }
    }
  } with {
    briefly "SanctionsService integration"
    described as {
      |The model's side of the SanctionsService conversation.
    }
  }
  adaptor ToSanctionsService to context SanctionsService is { 
    handler ToSanctionsServiceHandler is {
      on command SanctionsService.ScreenTransfer is {
        do "the model sends screen transfer"
      }
      on other is {
        error "Unexpected message for adaptor ToSanctionsService"
      }
    } with {
      briefly "to sanctions service"
      described as {
        |Carries messages to the external SanctionsService.
      }
    }
  } with {
    briefly "SanctionsService integration"
    described as {
      |The model's side of the SanctionsService conversation.
    }
  }
  adaptor FromWireNetworkService from context WireNetworkService is { 
    handler FromWireNetworkServiceHandler is {
      on event WireNetworkService.WireProcessed is {
        do "the model receives wire processed"
      }
      on other is {
        error "Unexpected message for adaptor FromWireNetworkService"
      }
    } with {
      briefly "from wire network service"
      described as {
        |Carries messages from the external WireNetworkService.
      }
    }
  } with {
    briefly "WireNetworkService integration"
    described as {
      |The model's side of the WireNetworkService conversation.
    }
  }
  adaptor ToWireNetworkService to context WireNetworkService is { 
    handler ToWireNetworkServiceHandler is {
      on command WireNetworkService.SubmitWire is {
        do "the model sends submit wire"
      }
      on other is {
        error "Unexpected message for adaptor ToWireNetworkService"
      }
    } with {
      briefly "to wire network service"
      described as {
        |Carries messages to the external WireNetworkService.
      }
    }
  } with {
    briefly "WireNetworkService integration"
    described as {
      |The model's side of the WireNetworkService conversation.
    }
  }
  include "types.riddl"
  include "Transfer.riddl"
  // Repository for transfer persistence
  type TransferRepositoryCommand is one of {
    TransferContext.TransferRepository.PersistExchangeRateApplied or TransferContext.TransferRepository.PersistFeesApplied or TransferContext.TransferRepository.PersistTransferCancelled or TransferContext.TransferRepository.PersistTransferCompleted or TransferContext.TransferRepository.PersistTransferProcessed or TransferContext.TransferRepository.PersistTransferReturned or TransferContext.TransferRepository.PersistTransferRouted or TransferContext.TransferRepository.PersistTransferSubmitted or TransferContext.TransferRepository.PersistTransferValidated
  } with {
    briefly "Anything that writes TransferRepository"
    described as {
      |The persistence commands TransferRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository TransferRepository as flow is {
    inlet TransferRepositoryFromTransferAnalytics is type TransferRepositoryCommand    command PersistExchangeRateApplied is  {
      transferId: TransferId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExchangeRateApplied applies to.
        }
      }
    } with {
      briefly "Persist ExchangeRateApplied"
      described as {
        |Instructs this repository to apply ExchangeRateApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFeesApplied is  {
      transferId: TransferId with {
        briefly "Row addressed"
        described as {
          |Which stored row FeesApplied applies to.
        }
      }
    } with {
      briefly "Persist FeesApplied"
      described as {
        |Instructs this repository to apply FeesApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransferCancelled is  {
      transferId: TransferId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransferCancelled applies to.
        }
      }
    } with {
      briefly "Persist TransferCancelled"
      described as {
        |Instructs this repository to apply TransferCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransferProcessed is  {
      transferId: TransferId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransferProcessed applies to.
        }
      }
    } with {
      briefly "Persist TransferProcessed"
      described as {
        |Instructs this repository to apply TransferProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransferRouted is  {
      transferId: TransferId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransferRouted applies to.
        }
      }
    } with {
      briefly "Persist TransferRouted"
      described as {
        |Instructs this repository to apply TransferRouted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransferValidated is  {
      transferId: TransferId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransferValidated applies to.
        }
      }
    } with {
      briefly "Persist TransferValidated"
      described as {
        |Instructs this repository to apply TransferValidated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransferCompleted is  {
      transferId: TransferId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransferCompleted applies to.
        }
      }
    } with {
      briefly "Persist TransferCompleted"
      described as {
        |Instructs this repository to apply TransferCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransferReturned is  {
      transferId: TransferId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransferReturned applies to.
        }
      }
    } with {
      briefly "Persist TransferReturned"
      described as {
        |Instructs this repository to apply TransferReturned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransferSubmitted is  {
      transferId: TransferId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransferSubmitted applies to.
        }
      }
    } with {
      briefly "Persist TransferSubmitted"
      described as {
        |Instructs this repository to apply TransferSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet TransferRepositoryResponses is result Transfer.TransferResult
    record StoredTransfer is  {
      transferId: TransferId with {
        briefly "transferId"
        described as {
          |The transferId column of the stored transfer row.
        }
      }
      info: TransferInfo with {
        briefly "info"
        described as {
          |The info column of the stored transfer row.
        }
      }
    } with {
      briefly "Stored transfer row"
      described as {
        |The persistence shape of transfer data as this repository stores it.
      }
    }
    schema TransferData is relational
      of transfers as record StoredTransfer
        index on field StoredTransfer.transferId
        index on field StoredTransfer.info.sourceAccountId
 with {
      briefly "Transfer data schema"
      described as {
        |The relational schema holding transfer data for the TransferRepository.
      }
    }
    handler TransferPersistence is {
      on persistExchangeRateApplied: command PersistExchangeRateApplied is {
        do "apply ExchangeRateApplied to the stored row"
      }
      on persistFeesApplied: command PersistFeesApplied is {
        do "apply FeesApplied to the stored row"
      }
      on persistTransferCancelled: command PersistTransferCancelled is {
        do "apply TransferCancelled to the stored row"
      }
      on persistTransferProcessed: command PersistTransferProcessed is {
        do "apply TransferProcessed to the stored row"
      }
      on persistTransferRouted: command PersistTransferRouted is {
        do "apply TransferRouted to the stored row"
      }
      on persistTransferValidated: command PersistTransferValidated is {
        do "apply TransferValidated to the stored row"
      }
      on persistTransferCompleted: command PersistTransferCompleted is {
        do "apply TransferCompleted to the stored row"
      }
      on persistTransferReturned: command PersistTransferReturned is {
        do "apply TransferReturned to the stored row"
      }
      on persistTransferSubmitted: command PersistTransferSubmitted is {
        do "apply TransferSubmitted to the stored row"
      }
      on query GetTransferStats is {
        let transferStatsView: type TransferStatsView = prompt("read the transfer stats projection")
        reply transferStatsView
      }
    } with {
      briefly "Persists transfer commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Transfer data persistence"
    described as {
      | The TransferRepository provides persistent storage for
      | fund transfers and payment tracking.
    }
  }
  // Projector for transfer analytics
  query GetTransferStats replies result TransferStatsView is  {
    transferStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which transfer stats to retrieve.
      }
    }
  } with {
    briefly "Get transfer stats"
    described as {
      |Retrieves the transfer stats projection.
    }
  }
  result TransferStatsView is  {
    transferStats: TransferAnalytics.TransferStats with {
      briefly "Transfer stats"
      described as {
        |The transfer stats being returned.
      }
    }
  } with {
    briefly "Transfer stats view"
    described as {
      |Read model view carrying the transfer stats projection.
    }
  }
  projector TransferAnalytics as flow is {
    updates repository TransferContext.TransferRepository
    outlet TransferAnalyticsToRepository is type TransferRepositoryCommand
    inlet TransferAnalyticsFromTransfer is type TransferEvent    record TransferStats is  {
      transferType: TransferType with {
        briefly "Type"
        described as {
          |Transfer type.
        }
      }
      totalTransfers: Natural with {
        briefly "Transfers"
        described as {
          |Total transfers.
        }
      }
      totalVolume: Decimal(20,2) with {
        briefly "Volume"
        described as {
          |Total volume.
        }
      }
      avgAmount: Decimal(15,2) with {
        briefly "Average"
        described as {
          |Average amount.
        }
      }
      successRate: Decimal(5,4) with {
        briefly "Success"
        described as {
          |Success rate.
        }
      }
      avgProcessingTime: Duration with {
        briefly "Processing"
        described as {
          |Avg processing time.
        }
      }
    } with {
      briefly "Transfer statistics"
      described as {
        |Fund transfer metrics.
      }
    }
    handler AnalyticsHandler is {
      on exchangeRateApplied: event Transfer.ExchangeRateApplied is {
        tell command TransferContext.TransferRepository.PersistExchangeRateApplied(transferId = exchangeRateApplied.transferId) to repository TransferContext.TransferRepository
        do "apply ExchangeRateApplied to the TransferAnalytics projection"
      }
      on feesApplied: event Transfer.FeesApplied is {
        tell command TransferContext.TransferRepository.PersistFeesApplied(transferId = feesApplied.transferId) to repository TransferContext.TransferRepository
        do "apply FeesApplied to the TransferAnalytics projection"
      }
      on transferCancelled: event Transfer.TransferCancelled is {
        tell command TransferContext.TransferRepository.PersistTransferCancelled(transferId = transferCancelled.transferId) to repository TransferContext.TransferRepository
        do "apply TransferCancelled to the TransferAnalytics projection"
      }
      on transferProcessed: event Transfer.TransferProcessed is {
        tell command TransferContext.TransferRepository.PersistTransferProcessed(transferId = transferProcessed.transferId) to repository TransferContext.TransferRepository
        do "apply TransferProcessed to the TransferAnalytics projection"
      }
      on transferRouted: event Transfer.TransferRouted is {
        tell command TransferContext.TransferRepository.PersistTransferRouted(transferId = transferRouted.transferId) to repository TransferContext.TransferRepository
        do "apply TransferRouted to the TransferAnalytics projection"
      }
      on transferValidated: event Transfer.TransferValidated is {
        tell command TransferContext.TransferRepository.PersistTransferValidated(transferId = transferValidated.transferId) to repository TransferContext.TransferRepository
        do "apply TransferValidated to the TransferAnalytics projection"
      }
      on transferSubmitted: event Transfer.TransferSubmitted is {
        tell command TransferContext.TransferRepository.PersistTransferSubmitted(transferId = transferSubmitted.transferId) to repository TransferContext.TransferRepository
      }
      on transferCompleted: event Transfer.TransferCompleted is {
        tell command TransferContext.TransferRepository.PersistTransferCompleted(transferId = transferCompleted.transferId) to repository TransferContext.TransferRepository
      }
      on transferReturned: event Transfer.TransferReturned is {
        tell command TransferContext.TransferRepository.PersistTransferReturned(transferId = transferReturned.transferId) to repository TransferContext.TransferRepository
      }
    } with {
      briefly "Maintains transfer analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Transfer analytics projections"
    described as {
      |Maintains fund transfer analytics data.
    }
  }
  processor TransferEventSplit as flow is {
    inlet TransferEventSplitIn is type TransferEvent    outlet TransferEventSplitToTransferAnalytics is type TransferEvent
    handler TransferEventSplitHandler is {
      on transferSubmitted: event Transfer.TransferSubmitted is {
        send transferSubmitted to outlet TransferEventSplitToTransferAnalytics
        tell transferSubmitted to entity TransferContext.Transfer
      }
      on transferValidated: event Transfer.TransferValidated is {
        send transferValidated to outlet TransferEventSplitToTransferAnalytics
        tell transferValidated to entity TransferContext.Transfer
      }
      on feesApplied: event Transfer.FeesApplied is {
        send feesApplied to outlet TransferEventSplitToTransferAnalytics
        tell feesApplied to entity TransferContext.Transfer
      }
      on exchangeRateApplied: event Transfer.ExchangeRateApplied is {
        send exchangeRateApplied to outlet TransferEventSplitToTransferAnalytics
        tell exchangeRateApplied to entity TransferContext.Transfer
      }
      on transferRouted: event Transfer.TransferRouted is {
        send transferRouted to outlet TransferEventSplitToTransferAnalytics
        tell transferRouted to entity TransferContext.Transfer
      }
      on transferProcessed: event Transfer.TransferProcessed is {
        send transferProcessed to outlet TransferEventSplitToTransferAnalytics
        tell transferProcessed to entity TransferContext.Transfer
      }
      on transferCompleted: event Transfer.TransferCompleted is {
        send transferCompleted to outlet TransferEventSplitToTransferAnalytics
        tell transferCompleted to entity TransferContext.Transfer
      }
      on transferReturned: event Transfer.TransferReturned is {
        send transferReturned to outlet TransferEventSplitToTransferAnalytics
        tell transferReturned to entity TransferContext.Transfer
      }
      on transferCancelled: event Transfer.TransferCancelled is {
        send transferCancelled to outlet TransferEventSplitToTransferAnalytics
        tell transferCancelled to entity TransferContext.Transfer
      }
      on other is {
        error "Unexpected message for processor TransferEventSplit"
      }
    } with {
      briefly "Transfer event fan-out handler"
      described as {
        |Delivers each Transfer event to all of its consumers.
      }
    }
  } with {
    briefly "Transfer event fan-out"
    described as {
      |Fans Transfer events out to the repository and projectors.
    }
  }
  connector 'TransferEvent Stream' is from outlet TransferContext.Transfer.TransferEvents2 to inlet TransferContext.TransferEventSplit.TransferEventSplitIn with {
    briefly "Transfer events, fanned out to storage and read models"
  }
  connector 'TransferAnalytics Feed' is from outlet TransferContext.TransferEventSplit.TransferEventSplitToTransferAnalytics to inlet TransferContext.TransferAnalytics.TransferAnalyticsFromTransfer with {
    briefly "Transfer events feeding the TransferAnalytics projection"
  }
  connector 'TransferAnalytics Storage' is from outlet TransferContext.TransferAnalytics.TransferAnalyticsToRepository to inlet TransferContext.TransferRepository.TransferRepositoryFromTransferAnalytics with {
    briefly "TransferAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for transfers"
  described as {
    | The TransferContext is the bounded context for fund
    | transfers, payment routing, and settlement.
  }
}
