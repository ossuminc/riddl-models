// Fund Transfer - Transfer Context
context TransferContext is {
  adaptor FromACHNetworkService from context ACHNetworkService is { 
    handler FromACHNetworkServiceHandler is {
      on event ACHNetworkService.ACHProcessed is {
        do "the model receives ach processed"
      }
      on other is {
        error "Unexpected message for adaptor FromACHNetworkService"
      }
    } with {
      briefly "from ach network service"
      described as {
        |Carries messages from the external ACHNetworkService.
      }
    }
  } with {
    briefly "ACHNetworkService integration"
    described as {
      |The model's side of the ACHNetworkService conversation.
    }
  }
  adaptor ToACHNetworkService to context ACHNetworkService is { 
    handler ToACHNetworkServiceHandler is {
      on command ACHNetworkService.SubmitACHTransaction is {
        do "the model sends submit ach transaction"
      }
      on other is {
        error "Unexpected message for adaptor ToACHNetworkService"
      }
    } with {
      briefly "to ach network service"
      described as {
        |Carries messages to the external ACHNetworkService.
      }
    }
  } with {
    briefly "ACHNetworkService integration"
    described as {
      |The model's side of the ACHNetworkService conversation.
    }
  }
  adaptor FromAccountService from context AccountService is { 
    handler FromAccountServiceHandler is {
      on event AccountService.AccountDebited is {
        do "the model receives account debited"
      }
      on other is {
        error "Unexpected message for adaptor FromAccountService"
      }
    } with {
      briefly "from account service"
      described as {
        |Carries messages from the external AccountService.
      }
    }
  } with {
    briefly "AccountService integration"
    described as {
      |The model's side of the AccountService conversation.
    }
  }
  adaptor ToAccountService to context AccountService is { 
    handler ToAccountServiceHandler is {
      on command AccountService.DebitAccount is {
        do "the model sends debit account"
      }
      on other is {
        error "Unexpected message for adaptor ToAccountService"
      }
    } with {
      briefly "to account service"
      described as {
        |Carries messages to the external AccountService.
      }
    }
  } with {
    briefly "AccountService integration"
    described as {
      |The model's side of the AccountService conversation.
    }
  }
  adaptor FromFXService from context FXService is { 
    handler FromFXServiceHandler is {
      on result FXService.ExchangeQuote is {
        do "the model receives exchange quote"
      }
      on other is {
        error "Unexpected message for adaptor FromFXService"
      }
    } with {
      briefly "from fx service"
      described as {
        |Carries messages from the external FXService.
      }
    }
  } with {
    briefly "FXService integration"
    described as {
      |The model's side of the FXService conversation.
    }
  }
  adaptor ToFXService to context FXService is { 
    handler ToFXServiceHandler is {
      on query FXService.GetExchangeRate is {
        do "the model sends get exchange rate"
      }
      on other is {
        error "Unexpected message for adaptor ToFXService"
      }
    } with {
      briefly "to fx service"
      described as {
        |Carries messages to the external FXService.
      }
    }
  } with {
    briefly "FXService integration"
    described as {
      |The model's side of the FXService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendTransferNotification is {
        do "the model sends send transfer notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromSanctionsService from context SanctionsService is { 
    handler FromSanctionsServiceHandler is {
      on event SanctionsService.ScreeningCompleted is {
        do "the model receives screening completed"
      }
      on other is {
        error "Unexpected message for adaptor FromSanctionsService"
      }
    } with {
      briefly "from sanctions service"
      described as {
        |Carries messages from the external SanctionsService.
      }
    }
  } with {
    briefly "SanctionsService integration"
    described as {
      |The model's side of the SanctionsService conversation.
    }
  }
  adaptor ToSanctionsService to context SanctionsService is { 
    handler ToSanctionsServiceHandler is {
      on command SanctionsService.ScreenTransfer is {
        do "the model sends screen transfer"
      }
      on other is {
        error "Unexpected message for adaptor ToSanctionsService"
      }
    } with {
      briefly "to sanctions service"
      described as {
        |Carries messages to the external SanctionsService.
      }
    }
  } with {
    briefly "SanctionsService integration"
    described as {
      |The model's side of the SanctionsService conversation.
    }
  }
  adaptor FromWireNetworkService from context WireNetworkService is { 
    handler FromWireNetworkServiceHandler is {
      on event WireNetworkService.WireProcessed is {
        do "the model receives wire processed"
      }
      on other is {
        error "Unexpected message for adaptor FromWireNetworkService"
      }
    } with {
      briefly "from wire network service"
      described as {
        |Carries messages from the external WireNetworkService.
      }
    }
  } with {
    briefly "WireNetworkService integration"
    described as {
      |The model's side of the WireNetworkService conversation.
    }
  }
  adaptor ToWireNetworkService to context WireNetworkService is { 
    handler ToWireNetworkServiceHandler is {
      on command WireNetworkService.SubmitWire is {
        do "the model sends submit wire"
      }
      on other is {
        error "Unexpected message for adaptor ToWireNetworkService"
      }
    } with {
      briefly "to wire network service"
      described as {
        |Carries messages to the external WireNetworkService.
      }
    }
  } with {
    briefly "WireNetworkService integration"
    described as {
      |The model's side of the WireNetworkService conversation.
    }
  }
  include "types.riddl"
  include "Transfer.riddl"
  // Repository for transfer persistence
  repository TransferRepository is {
    inlet TransferRepositoryFromTransfer is type TransferEvent    inlet TransferRepositoryFromTransferAnalytics is type TransferEvent    outlet TransferRepositoryResponses is type Transfer.TransferResult
    record StoredTransfer is  {
      transferId: TransferId with {
        briefly "transferId"
        described as {
          |The transferId column of the stored transfer row.
        }
      }
      info: TransferInfo with {
        briefly "info"
        described as {
          |The info column of the stored transfer row.
        }
      }
    } with {
      briefly "Stored transfer row"
      described as {
        |The persistence shape of transfer data as this repository stores it.
      }
    }
    schema TransferData is relational
      of transfers as type StoredTransfer
        index on field StoredTransfer.transferId
        index on field StoredTransfer.info.sourceAccountId
 with {
      briefly "Transfer data schema"
      described as {
        |The relational schema holding transfer data for the TransferRepository.
      }
    }
    handler TransferPersistence is {
      on query GetTransferStats is {
        do "read the transfer stats projection"
        yield result TransferStatsView
      }
      on command Transfer.SubmitTransfer is {
        tell event Transfer.TransferSubmitted to entity TransferContext.Transfer
      }
      on command Transfer.ValidateTransfer is {
        tell event Transfer.TransferValidated to entity TransferContext.Transfer
      }
      on command Transfer.ApplyFees is {
        tell event Transfer.FeesApplied to entity TransferContext.Transfer
      }
      on command Transfer.ApplyExchangeRate is {
        tell event Transfer.ExchangeRateApplied to entity TransferContext.Transfer
      }
      on command Transfer.RouteTransfer is {
        tell event Transfer.TransferRouted to entity TransferContext.Transfer
      }
      on command Transfer.ProcessTransfer is {
        tell event Transfer.TransferProcessed to entity TransferContext.Transfer
      }
      on command Transfer.CompleteTransfer is {
        tell event Transfer.TransferCompleted to entity TransferContext.Transfer
      }
      on command Transfer.ReturnTransfer is {
        tell event Transfer.TransferReturned to entity TransferContext.Transfer
      }
      on command Transfer.CancelTransfer is {
        tell event Transfer.TransferCancelled to entity TransferContext.Transfer
      }
    } with {
      briefly "Persists transfer commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Transfer data persistence"
    described as {
      | The TransferRepository provides persistent storage for
      | fund transfers and payment tracking.
    }
  }
  // Projector for transfer analytics
  query GetTransferStats is  {
    transferStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which transfer stats to retrieve.
      }
    }
  } with {
    briefly "Get transfer stats"
    described as {
      |Retrieves the transfer stats projection.
    }
  }
  result TransferStatsView is  {
    transferStats: TransferAnalytics.TransferStats with {
      briefly "Transfer stats"
      described as {
        |The transfer stats being returned.
      }
    }
  } with {
    briefly "Transfer stats view"
    described as {
      |Read model view carrying the transfer stats projection.
    }
  }
  projector TransferAnalytics is {
    updates repository TransferContext.TransferRepository
    inlet TransferAnalyticsFromTransfer is type TransferEvent    outlet TransferAnalyticsOut is type TransferEvent
    record TransferStats is  {
      transferType: TransferType with {
        briefly "Type"
        described as {
          |Transfer type.
        }
      }
      totalTransfers: Natural with {
        briefly "Transfers"
        described as {
          |Total transfers.
        }
      }
      totalVolume: Decimal(20,2) with {
        briefly "Volume"
        described as {
          |Total volume.
        }
      }
      avgAmount: Decimal(15,2) with {
        briefly "Average"
        described as {
          |Average amount.
        }
      }
      successRate: Decimal(5,4) with {
        briefly "Success"
        described as {
          |Success rate.
        }
      }
      avgProcessingTime: Duration with {
        briefly "Processing"
        described as {
          |Avg processing time.
        }
      }
    } with {
      briefly "Transfer statistics"
      described as {
        |Fund transfer metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Transfer.TransferSubmitted is {
        tell event Transfer.TransferSubmitted to repository TransferContext.TransferRepository
      }
      on event Transfer.TransferCompleted is {
        tell event Transfer.TransferCompleted to repository TransferContext.TransferRepository
      }
      on event Transfer.TransferReturned is {
        tell event Transfer.TransferReturned to repository TransferContext.TransferRepository
      }
    } with {
      briefly "Maintains transfer analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Transfer analytics projections"
    described as {
      |Maintains fund transfer analytics data.
    }
  }
  processor TransferEventSource as source is {
    outlet TransferEvents is type TransferEvent
    handler TransferEventEmitter is {
      on init is {
        tell command InitializeTransfer to entity TransferContext.Transfer
      }
      on other is {
        error "Unexpected message for source TransferEventSource"
      }
      on event Transfer.TransferSubmitted is {
        send event Transfer.TransferSubmitted to outlet TransferEvents
      }
      on event Transfer.TransferCompleted is {
        send event Transfer.TransferCompleted to outlet TransferEvents
      }
      on event Transfer.TransferReturned is {
        send event Transfer.TransferReturned to outlet TransferEvents
      }
      on event Transfer.TransferCancelled is {
        send event Transfer.TransferCancelled to outlet TransferEvents
      }
    } with {
      briefly "Transfer event emitter"
      described as {
        |Emits transfer lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Transfer event source"
    described as {
      |Publishes transfer entity events for streaming.
    }
  }
  processor TransferEventSink as sink is {
    inlet IncomingTransferEvents is type TransferEvent    handler TransferEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink TransferEventSink"
      }
      on event Transfer.TransferSubmitted is {
        tell event Transfer.TransferSubmitted to repository TransferContext.TransferRepository
      }
      on event Transfer.TransferCompleted is {
        tell event Transfer.TransferCompleted to repository TransferContext.TransferRepository
      }
    } with {
      briefly "Transfer event receiver"
      described as {
        |Receives transfer events and persists them.
      }
    }
  } with {
    briefly "Transfer event sink"
    described as {
      |Receives transfer events from the streaming topology.
    }
  }
  connector TransferEventPipeline is from outlet TransferContext.TransferEventSource.TransferEvents to inlet TransferContext.TransferEventSink.IncomingTransferEvents with {
    briefly "Transfer event pipeline"
    described as {
      |Wires transfer events from source to sink.
    }
  }
  processor TransferEventSplit is {
    inlet TransferEventSplitIn is type TransferEvent    outlet TransferEventSplitToTransferRepository is type TransferEvent
    outlet TransferEventSplitToTransferAnalytics is type TransferEvent
    handler TransferEventSplitHandler is {
      on event Transfer.TransferSubmitted is {
        send event Transfer.TransferSubmitted to outlet TransferEventSplitToTransferRepository
        send event Transfer.TransferSubmitted to outlet TransferEventSplitToTransferAnalytics
        tell event Transfer.TransferSubmitted to entity TransferContext.Transfer
      }
      on event Transfer.TransferValidated is {
        send event Transfer.TransferValidated to outlet TransferEventSplitToTransferRepository
        send event Transfer.TransferValidated to outlet TransferEventSplitToTransferAnalytics
        tell event Transfer.TransferValidated to entity TransferContext.Transfer
      }
      on event Transfer.FeesApplied is {
        send event Transfer.FeesApplied to outlet TransferEventSplitToTransferRepository
        send event Transfer.FeesApplied to outlet TransferEventSplitToTransferAnalytics
        tell event Transfer.FeesApplied to entity TransferContext.Transfer
      }
      on event Transfer.ExchangeRateApplied is {
        send event Transfer.ExchangeRateApplied to outlet TransferEventSplitToTransferRepository
        send event Transfer.ExchangeRateApplied to outlet TransferEventSplitToTransferAnalytics
        tell event Transfer.ExchangeRateApplied to entity TransferContext.Transfer
      }
      on event Transfer.TransferRouted is {
        send event Transfer.TransferRouted to outlet TransferEventSplitToTransferRepository
        send event Transfer.TransferRouted to outlet TransferEventSplitToTransferAnalytics
        tell event Transfer.TransferRouted to entity TransferContext.Transfer
      }
      on event Transfer.TransferProcessed is {
        send event Transfer.TransferProcessed to outlet TransferEventSplitToTransferRepository
        send event Transfer.TransferProcessed to outlet TransferEventSplitToTransferAnalytics
        tell event Transfer.TransferProcessed to entity TransferContext.Transfer
      }
      on event Transfer.TransferCompleted is {
        send event Transfer.TransferCompleted to outlet TransferEventSplitToTransferRepository
        send event Transfer.TransferCompleted to outlet TransferEventSplitToTransferAnalytics
        tell event Transfer.TransferCompleted to entity TransferContext.Transfer
      }
      on event Transfer.TransferReturned is {
        send event Transfer.TransferReturned to outlet TransferEventSplitToTransferRepository
        send event Transfer.TransferReturned to outlet TransferEventSplitToTransferAnalytics
        tell event Transfer.TransferReturned to entity TransferContext.Transfer
      }
      on event Transfer.TransferCancelled is {
        send event Transfer.TransferCancelled to outlet TransferEventSplitToTransferRepository
        send event Transfer.TransferCancelled to outlet TransferEventSplitToTransferAnalytics
        tell event Transfer.TransferCancelled to entity TransferContext.Transfer
      }
      on other is {
        error "Unexpected message for processor TransferEventSplit"
      }
    } with {
      briefly "Transfer event fan-out handler"
      described as {
        |Delivers each Transfer event to all of its consumers.
      }
    }
  } with {
    briefly "Transfer event fan-out"
    described as {
      |Fans Transfer events out to the repository and projectors.
    }
  }
  connector 'TransferEvent Stream' is from outlet TransferContext.Transfer.TransferEvents2 to inlet TransferContext.TransferEventSplit.TransferEventSplitIn with {
    briefly "Transfer events, fanned out to storage and read models"
  }
  connector 'TransferEvent Storage' is from outlet TransferContext.TransferEventSplit.TransferEventSplitToTransferRepository to inlet TransferContext.TransferRepository.TransferRepositoryFromTransfer with {
    briefly "Transfer events on their way to storage"
  }
  connector 'TransferAnalytics Feed' is from outlet TransferContext.TransferEventSplit.TransferEventSplitToTransferAnalytics to inlet TransferContext.TransferAnalytics.TransferAnalyticsFromTransfer with {
    briefly "Transfer events feeding the TransferAnalytics projection"
  }
  connector 'TransferAnalytics Storage' is from outlet TransferContext.TransferAnalytics.TransferAnalyticsOut to inlet TransferContext.TransferRepository.TransferRepositoryFromTransferAnalytics with {
    briefly "The TransferAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for transfers"
  described as {
    | The TransferContext is the bounded context for fund
    | transfers, payment routing, and settlement.
  }
}
