// Fund Transfer - Transfer Entity
entity Transfer as flow is {
  type TransferCommand is one of {
    Transfer.SubmitTransfer or Transfer.ValidateTransfer or Transfer.ApplyFees or Transfer.ApplyExchangeRate or Transfer.RouteTransfer or Transfer.ProcessTransfer or Transfer.CompleteTransfer or Transfer.ReturnTransfer or Transfer.CancelTransfer
  } with {
    briefly "Transfer command alternation"
    described as {
      |Commands accepted by the Transfer entity.
    }
  }
  inlet TransferCommands is type TransferCommand  outlet TransferEvents2 is type TransferEvent
  // Commands
  command SubmitTransfer is  {
    transferId: TransferId with {
      briefly "Transfer ID"
      described as {
        |New transfer identifier.
      }
    }
    info: TransferInfo with {
      briefly "Info"
      described as {
        |Transfer information.
      }
    }
    domesticRecipient: DomesticRecipient? with {
      briefly "Domestic"
      described as {
        |Domestic recipient.
      }
    }
    internationalRecipient: InternationalRecipient? with {
      briefly "International"
      described as {
        |International recipient.
      }
    }
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Initiating customer.
      }
    }
  } with {
    briefly "Submit transfer"
    described as {
      |Submits a new fund transfer.
    }
  }
  command ValidateTransfer is  {
    transferId: TransferId with {
      briefly "Transfer ID"
      described as {
        |Transfer to validate.
      }
    }
  } with {
    briefly "Validate transfer"
    described as {
      |Validates transfer details.
    }
  }
  command ApplyFees is  {
    transferId: TransferId with {
      briefly "Transfer ID"
      described as {
        |Transfer identifier.
      }
    }
    fees: TransferFees with {
      briefly "Fees"
      described as {
        |Transfer fees.
      }
    }
  } with {
    briefly "Apply fees"
    described as {
      |Applies transfer fees.
    }
  }
  command ApplyExchangeRate is  {
    transferId: TransferId with {
      briefly "Transfer ID"
      described as {
        |Transfer identifier.
      }
    }
    exchangeRate: ExchangeRate with {
      briefly "Rate"
      described as {
        |Exchange rate.
      }
    }
  } with {
    briefly "Apply exchange rate"
    described as {
      |Applies currency exchange.
    }
  }
  command RouteTransfer is  {
    transferId: TransferId with {
      briefly "Transfer ID"
      described as {
        |Transfer to route.
      }
    }
    networkReference: String(1,50) with {
      briefly "Reference"
      described as {
        |Network reference.
      }
    }
  } with {
    briefly "Route transfer"
    described as {
      |Routes to payment network.
    }
  }
  command ProcessTransfer is  {
    transferId: TransferId with {
      briefly "Transfer ID"
      described as {
        |Transfer to process.
      }
    }
  } with {
    briefly "Process transfer"
    described as {
      |Processes the transfer.
    }
  }
  command CompleteTransfer is  {
    transferId: TransferId with {
      briefly "Transfer ID"
      described as {
        |Transfer to complete.
      }
    }
  } with {
    briefly "Complete transfer"
    described as {
      |Marks transfer as complete.
    }
  }
  command ReturnTransfer is  {
    transferId: TransferId with {
      briefly "Transfer ID"
      described as {
        |Transfer to return.
      }
    }
    returnReason: ReturnReason with {
      briefly "Reason"
      described as {
        |Return reason.
      }
    }
  } with {
    briefly "Return transfer"
    described as {
      |Returns the transfer.
    }
  }
  command CancelTransfer is  {
    transferId: TransferId with {
      briefly "Transfer ID"
      described as {
        |Transfer to cancel.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
  } with {
    briefly "Cancel transfer"
    described as {
      |Cancels the transfer.
    }
  }
  // Events
  event TransferSubmitted is  {
    transferId: TransferId with {
      briefly "Transfer"
      described as {
        |Transfer ID.
      }
    }
    info: TransferInfo with {
      briefly "Info"
      described as {
        |Transfer info.
      }
    }
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Transfer was submitted"
    described as {
      |Emitted when transfer is submitted.
    }
  }
  event TransferValidated is  {
    transferId: TransferId with {
      briefly "Transfer"
      described as {
        |Transfer ID.
      }
    }
    validatedAt: TimeStamp with {
      briefly "Validated"
      described as {
        |Validation time.
      }
    }
  } with {
    briefly "Transfer was validated"
    described as {
      |Emitted when validation passes.
    }
  }
  event FeesApplied is  {
    transferId: TransferId with {
      briefly "Transfer"
      described as {
        |Transfer ID.
      }
    }
    fees: TransferFees with {
      briefly "Fees"
      described as {
        |Applied fees.
      }
    }
    appliedAt: TimeStamp with {
      briefly "Applied"
      described as {
        |Application time.
      }
    }
  } with {
    briefly "Fees were applied"
    described as {
      |Emitted when fees are calculated.
    }
  }
  event ExchangeRateApplied is  {
    transferId: TransferId with {
      briefly "Transfer"
      described as {
        |Transfer ID.
      }
    }
    exchangeRate: ExchangeRate with {
      briefly "Rate"
      described as {
        |Exchange rate.
      }
    }
    convertedAmount: Decimal(15,2) with {
      briefly "Amount"
      described as {
        |Converted amount.
      }
    }
    appliedAt: TimeStamp with {
      briefly "Applied"
      described as {
        |Application time.
      }
    }
  } with {
    briefly "Exchange rate was applied"
    described as {
      |Emitted when currency is converted.
    }
  }
  event TransferRouted is  {
    transferId: TransferId with {
      briefly "Transfer"
      described as {
        |Transfer ID.
      }
    }
    networkReference: String(1,50) with {
      briefly "Reference"
      described as {
        |Network reference.
      }
    }
    routedAt: TimeStamp with {
      briefly "Routed"
      described as {
        |Routing time.
      }
    }
  } with {
    briefly "Transfer was routed"
    described as {
      |Emitted when sent to network.
    }
  }
  event TransferProcessed is  {
    transferId: TransferId with {
      briefly "Transfer"
      described as {
        |Transfer ID.
      }
    }
    processedAt: TimeStamp with {
      briefly "Processed"
      described as {
        |Processing time.
      }
    }
  } with {
    briefly "Transfer was processed"
    described as {
      |Emitted when processing completes.
    }
  }
  event TransferCompleted is  {
    transferId: TransferId with {
      briefly "Transfer"
      described as {
        |Transfer ID.
      }
    }
    tracking: TransferTracking with {
      briefly "Tracking"
      described as {
        |Tracking info.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Transfer was completed"
    described as {
      |Emitted when transfer finishes.
    }
  }
  event TransferReturned is  {
    transferId: TransferId with {
      briefly "Transfer"
      described as {
        |Transfer ID.
      }
    }
    returnReason: ReturnReason with {
      briefly "Reason"
      described as {
        |Return reason.
      }
    }
    returnedAt: TimeStamp with {
      briefly "Returned"
      described as {
        |Return time.
      }
    }
  } with {
    briefly "Transfer was returned"
    described as {
      |Emitted when transfer is returned.
    }
  }
  event TransferCancelled is  {
    transferId: TransferId with {
      briefly "Transfer"
      described as {
        |Transfer ID.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancellation time.
      }
    }
  } with {
    briefly "Transfer was cancelled"
    described as {
      |Emitted when transfer is cancelled.
    }
  }
  // State Records
  record PendingStateData is  {
    transferId: TransferId with {
      briefly "Transfer"
      described as {
        |Transfer ID.
      }
    }
    info: TransferInfo with {
      briefly "Info"
      described as {
        |Transfer info.
      }
    }
    status: TransferStatus with {
      briefly "Status"
      described as {
        |Current status.
      }
    }
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    domesticRecipient: DomesticRecipient? with {
      briefly "Domestic"
      described as {
        |Domestic recipient.
      }
    }
    internationalRecipient: InternationalRecipient? with {
      briefly "International"
      described as {
        |International recipient.
      }
    }
    appliedFees: TransferFees? with {
      briefly "Fees"
      described as {
        |Transfer fees.
      }
    }
    appliedExchangeRate: ExchangeRate? with {
      briefly "Rate"
      described as {
        |Exchange rate.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Pending state data"
    described as {
      |State data for pending transfer.
    }
  }
  record ProcessingStateData is  {
    transferId: TransferId with {
      briefly "Transfer"
      described as {
        |Transfer ID.
      }
    }
    info: TransferInfo with {
      briefly "Info"
      described as {
        |Transfer info.
      }
    }
    status: TransferStatus with {
      briefly "Status"
      described as {
        |Current status.
      }
    }
    tracking: TransferTracking with {
      briefly "Tracking"
      described as {
        |Tracking info.
      }
    }
    fees: TransferFees with {
      briefly "Fees"
      described as {
        |Transfer fees.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
    routedAt: TimeStamp with {
      briefly "Routed"
      described as {
        |Routing time.
      }
    }
  } with {
    briefly "Processing state data"
    described as {
      |State data for processing transfer.
    }
  }
  record CompletedStateData is  {
    transferId: TransferId with {
      briefly "Transfer"
      described as {
        |Transfer ID.
      }
    }
    info: TransferInfo with {
      briefly "Info"
      described as {
        |Transfer info.
      }
    }
    tracking: TransferTracking with {
      briefly "Tracking"
      described as {
        |Tracking info.
      }
    }
    fees: TransferFees with {
      briefly "Fees"
      described as {
        |Transfer fees.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Completed state data"
    described as {
      |State data for completed transfer.
    }
  }
  // Query/Result
  query GetTransfer replies result TransferResult is {
    transferId: TransferId with {
      briefly "Transfer ID"
      described as {
        |Transfer to retrieve.
      }
    }
  } with {
    briefly "Get transfer"
    described as {
      |Retrieves transfer data by identifier.
    }
  }
  result TransferResult is  {
    transferId: TransferId with {
      briefly "Transfer ID"
      described as {
        |Transfer identifier.
      }
    }
    info: TransferInfo with {
      briefly "Info"
      described as {
        |Transfer info.
      }
    }
    status: TransferStatus with {
      briefly "Status"
      described as {
        |Transfer status.
      }
    }
  } with {
    briefly "Transfer result"
    described as {
      |Transfer data result.
    }
  }
  // Initialize command for source streamlet
  // States
  initial state PendingState of record Transfer.PendingStateData is {
    initial handler PendingStateInitHandler is {
      on init is {
        set state PendingState to "initialize from TransferSubmitted event"
      }
    } with {
      briefly "Pending state init handler"
      described as {
        |Initializes the Pending state.
      }
    }
  } with {
    briefly "Pending state"
    described as {
      |Transfer is pending validation and routing.
    }
  }
  state ProcessingState of record Transfer.ProcessingStateData is {
    initial handler ProcessingStateInitHandler is {
      on init is {
        set state ProcessingState to "initialize from TransferRouted event"
      }
    } with {
      briefly "Processing state init handler"
      described as {
        |Initializes the Processing state.
      }
    }
  } with {
    briefly "Processing state"
    described as {
      |Transfer is being processed through payment network.
    }
  }
  state CompletedState of record Transfer.CompletedStateData is {
    initial handler CompletedStateInitHandler is {
      on init is {
        set state CompletedState to "initialize from TransferCompleted event"
      }
    } with {
      briefly "Completed state init handler"
      described as {
        |Initializes the Completed state.
      }
    }
  } with {
    briefly "Completed state"
    described as {
      |Transfer has been completed successfully.
    }
  }
  // Handler
  handler TransferHandler is {
    on submitTransfer: command SubmitTransfer is {
      morph entity TransferContext.Transfer to state TransferContext.Transfer.PendingState with record Transfer.PendingStateData(transferId = submitTransfer.transferId, info = submitTransfer.info, customerId = submitTransfer.customerId, domesticRecipient = submitTransfer.domesticRecipient, internationalRecipient = submitTransfer.internationalRecipient, status = prompt("the status of this pending state data"), appliedFees = empty, appliedExchangeRate = empty, submittedAt = prompt("the submitted at of this pending state data"))
      tell event TransferSubmitted(transferId = submitTransfer.transferId, info = submitTransfer.info, customerId = submitTransfer.customerId, submittedAt = prompt("the submitted at of this transfer submitted")) to entity TransferContext.Transfer
    }
    on validateTransfer: command ValidateTransfer is {
      tell event TransferValidated(transferId = validateTransfer.transferId, validatedAt = prompt("the validated at of this transfer validated")) to entity TransferContext.Transfer
    }
    on applyFees: command ApplyFees is {
      tell event FeesApplied(transferId = applyFees.transferId, fees = applyFees.fees, appliedAt = prompt("the applied at of this fees applied")) to entity TransferContext.Transfer
    }
    on applyExchangeRate: command ApplyExchangeRate is {
      tell event ExchangeRateApplied(transferId = applyExchangeRate.transferId, exchangeRate = applyExchangeRate.exchangeRate, convertedAmount = prompt("the converted amount of this exchange rate applied"), appliedAt = prompt("the applied at of this exchange rate applied")) to entity TransferContext.Transfer
    }
    on routeTransfer: command RouteTransfer is {
      morph entity TransferContext.Transfer to state TransferContext.Transfer.ProcessingState with record Transfer.ProcessingStateData(transferId = routeTransfer.transferId, info = prompt("the info of this processing state data"), status = prompt("the status of this processing state data"), tracking = prompt("the tracking of this processing state data"), fees = prompt("the fees of this processing state data"), submittedAt = prompt("the submitted at of this processing state data"), routedAt = prompt("the routed at of this processing state data"))
      tell event TransferRouted(transferId = routeTransfer.transferId, networkReference = routeTransfer.networkReference, routedAt = prompt("the routed at of this transfer routed")) to entity TransferContext.Transfer
    }
    on processTransfer: command ProcessTransfer is {
      tell event TransferProcessed(transferId = processTransfer.transferId, processedAt = prompt("the processed at of this transfer processed")) to entity TransferContext.Transfer
    }
    on completeTransfer: command CompleteTransfer is {
      morph entity TransferContext.Transfer to state TransferContext.Transfer.CompletedState with record Transfer.CompletedStateData(transferId = completeTransfer.transferId, info = prompt("the info of this completed state data"), tracking = prompt("the tracking of this completed state data"), fees = prompt("the fees of this completed state data"), completedAt = prompt("the completed at of this completed state data"))
      tell event TransferCompleted(transferId = completeTransfer.transferId, tracking = prompt("the tracking of this transfer completed"), completedAt = prompt("the completed at of this transfer completed")) to entity TransferContext.Transfer
    }
    on returnTransfer: command ReturnTransfer is {
      tell event TransferReturned(transferId = returnTransfer.transferId, returnReason = returnTransfer.returnReason, returnedAt = prompt("the returned at of this transfer returned")) to entity TransferContext.Transfer
    }
    on cancelTransfer: command CancelTransfer is {
      tell event TransferCancelled(transferId = cancelTransfer.transferId, reason = cancelTransfer.reason, cancelledAt = prompt("the cancelled at of this transfer cancelled")) to entity TransferContext.Transfer
    }
    on getTransfer: query GetTransfer is {
      reply result TransferResult(transferId = getTransfer.transferId, info = prompt("the info of this transfer result"), status = prompt("the status of this transfer result"))
    }
      on exchangeRateApplied: event ExchangeRateApplied is {
      do "apply ExchangeRateApplied to the transfer so it can be persisted and replayed"
    }
    on feesApplied: event FeesApplied is {
      do "apply FeesApplied to the transfer so it can be persisted and replayed"
    }
    on transferCancelled: event TransferCancelled is {
      do "apply TransferCancelled to the transfer so it can be persisted and replayed"
    }
    on transferCompleted: event TransferCompleted is {
      do "apply TransferCompleted to the transfer so it can be persisted and replayed"
    }
    on transferProcessed: event TransferProcessed is {
      do "apply TransferProcessed to the transfer so it can be persisted and replayed"
    }
    on transferReturned: event TransferReturned is {
      do "apply TransferReturned to the transfer so it can be persisted and replayed"
    }
    on transferRouted: event TransferRouted is {
      do "apply TransferRouted to the transfer so it can be persisted and replayed"
    }
    on transferSubmitted: event TransferSubmitted is {
      do "apply TransferSubmitted to the transfer so it can be persisted and replayed"
    }
    on transferValidated: event TransferValidated is {
      do "apply TransferValidated to the transfer so it can be persisted and replayed"
    }
} with {
    briefly "Processes transfer commands"
    described as {
      | Handles fund transfer lifecycle including validation,
      | routing, processing, and completion.
    }
  }
} with {
  briefly "Transfer aggregate"
  described as {
    | The Transfer entity manages fund transfers including
    | domestic and international payments.
  }
}
