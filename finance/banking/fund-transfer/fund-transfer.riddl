// Fund Transfer Domain Model
// Wire transfers, ACH, and inter-bank transfers
domain FundTransfer is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Customer is "person initiating fund transfers" with {
    briefly "Customer"
    described as {
      |Bank customer making transfers.
    }
  }
  user TransferOperator is "bank staff processing transfers" with {
    briefly "Transfer Operator"
    described as {
      |Person handling transfer operations.
    }
  }
  epic TransferEpic is {
    user Customer wants to "to transfer funds securely" so that "money reaches intended recipients"
    case InitiateTransfer is {
      user Customer wants to "to send money to another account" so that "funds are delivered reliably"
      step is "Customer provides" "transfer details" "including recipient" with {
        briefly "Provide details"
        described as {
          |Enter transfer info.
        }
      }
      step is "System validates" "account and funds" "availability" with {
        briefly "Validate"
        described as {
          |Check requirements.
        }
      }
      step take input FundTransferApp.FundTransferScreen.SubmitTransferInput from user Customer with {
        briefly "Submit transfer"
        described as {
          |Create transfer request.
        }
      }
      step is "System routes" "through appropriate" "payment network" with {
        briefly "Route transfer"
        described as {
          |Send to network.
        }
      }
    } with {
      briefly "Transfer workflow"
      described as {
        |Standard flow for fund transfers.
      }
    }
  } with {
    briefly "Transfer processing"
    described as {
      | Epic covering fund transfers from initiation
      | through settlement and completion.
    }
  }
  include "TransferContext.riddl"
  include "external-contexts.riddl"
  application context FundTransferApp is {
    group FundTransferScreen is {
      input SubmitTransferInput acquires command TransferContext.Transfer.SubmitTransfer with {
        briefly "Submit transfer control"
        described as {
          |The control through which a user submits the submit transfer request.
        }
      }
    } with {
      briefly "Fund transfer screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppTransferCommands is type TransferContext.Transfer.TransferCommand
    inlet AppTransferRepositoryResponses is type TransferContext.Transfer.TransferResult
    handler FundTransferAppHandler is {
      on other is {
        error "Unexpected message for application context FundTransferApp"
      }
    } with {
      briefly "FundTransferApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "FundTransferApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppTransferCommands is {
    from outlet FundTransferApp.AppTransferCommands to
      inlet TransferContext.Transfer.TransferCommands
  } with {
    option is persistent
    briefly "LinkAppTransferCommands"
  }
  connector LinkAppTransferRepositoryResponses is {
    from outlet TransferContext.TransferRepository.TransferRepositoryResponses to
      inlet FundTransferApp.AppTransferRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppTransferRepositoryResponses"
  }
} with {
  term AccountBalance is "The available funds in an account, validated before a transfer."
  briefly "Fund transfer domain"
  described as {
    | The FundTransfer domain handles wire transfers,
    | ACH payments, and inter-bank fund movements.
  }
}
