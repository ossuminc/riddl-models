// Order Management Domain Model
// Securities trading order management system
domain OrderManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Trader is "person placing trading orders" with {
    briefly "Trader"
    described as {
      |Person executing trades.
    }
  }
  user PortfolioManager is "person managing investment portfolios" with {
    briefly "Portfolio Manager"
    described as {
      |Person overseeing trading strategy.
    }
  }
  user ComplianceOfficer is "person ensuring regulatory compliance" with {
    briefly "Compliance Officer"
    described as {
      |Person monitoring trading compliance.
    }
  }
  epic TradingEpic is {
    user Trader wants to "to execute securities trades" so that "investment positions can be managed"
    case PlaceOrderUseCase is {
      user Trader wants to "to place a trading order" so that "the position can be established"
      step is "Trader selects" "security and order parameters" "for trade" with {
        briefly "Select security"
        described as {
          |Choose instrument.
        }
      }
      step is "System validates" "order against compliance rules" "and limits" with {
        briefly "Validate order"
        described as {
          |Check compliance.
        }
      }
      step take input OrderManagementApp.OrderManagementScreen.PlaceOrderInput from user Trader with {
        briefly "Place"
        described as {
          |Submit order.
        }
      }
      step is "System routes" "order to execution venue" "for matching" with {
        briefly "Route order"
        described as {
          |Send to market.
        }
      }
    } with {
      briefly "Order placement"
      described as {
        |Standard order placement workflow.
      }
    }
  } with {
    briefly "Trading operations"
    described as {
      | Epic covering trading order lifecycle from
      | placement through execution and settlement.
    }
  }
  include "OrderContext.riddl"
  include "external-contexts.riddl"
  application context OrderManagementApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in OrderManagement are delivered.
      }
    }
    group OrderManagementScreen is {
      input PlaceOrderInput acquires command OrderContext.TradingOrder.PlaceOrder with {
        briefly "Place order control"
        described as {
          |The control through which a user submits the place order request.
        }
      }
    } with {
      briefly "Order management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppTradingOrderCommands is type OrderContext.TradingOrder.TradingOrderCommand
    inlet AppOrderRepositoryResponses is type OrderContext.TradingOrder.TradingOrderResult    handler OrderManagementAppHandler is {
      on other is {
        error "Unexpected message for application context OrderManagementApp"
      }
    } with {
      briefly "OrderManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "OrderManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'TradingOrderCommand Stream' is from outlet OrderManagementApp.AppTradingOrderCommands to inlet OrderContext.TradingOrder.TradingOrderCommands with {
    option persistent()
    briefly "TradingOrder commands from the application"
  }
  connector 'MarketplaceOrderResult Stream' is from outlet OrderContext.OrderRepository.OrderRepositoryResponses to inlet OrderManagementApp.AppOrderRepositoryResponses with {
    option persistent()
    briefly "Order query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet OrderManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Order management domain"
  described as {
    | The OrderManagement domain handles securities trading
    | orders including routing, execution, and fills.
  }
}
