// Order Management - Order Context
context OrderContext is {
  adaptor FromAccountService from context AccountService is {
    handler FromAccountServiceHandler is {
      on result AccountService.AccountInfo is {
        do "the model receives account info"
      }
      on other is {
        error "Unexpected message for adaptor FromAccountService"
      }
    } with {
      briefly "from account service"
      described as {
        |Carries messages from the external AccountService.
      }
    }
  } with {
      briefly "AccountService integration"
    described as {
      |The model's side of the AccountService conversation.
    }
  }
  adaptor ToAccountService to context AccountService is {
    handler ToAccountServiceHandler is {
      on query AccountService.GetAccountInfo is {
        do "the model sends get account info"
      }
      on other is {
        error "Unexpected message for adaptor ToAccountService"
      }
    } with {
      briefly "to account service"
      described as {
        |Carries messages to the external AccountService.
      }
    }
  } with {
      briefly "AccountService integration"
    described as {
      |The model's side of the AccountService conversation.
    }
  }
  adaptor FromComplianceService from context ComplianceService is {
    handler FromComplianceServiceHandler is {
      on event ComplianceService.ComplianceCheckCompleted is {
        do "the model receives compliance check completed"
      }
      on other is {
        error "Unexpected message for adaptor FromComplianceService"
      }
    } with {
      briefly "from compliance service"
      described as {
        |Carries messages from the external ComplianceService.
      }
    }
  } with {
      briefly "ComplianceService integration"
    described as {
      |The model's side of the ComplianceService conversation.
    }
  }
  adaptor ToComplianceService to context ComplianceService is {
    handler ToComplianceServiceHandler is {
      on command ComplianceService.CheckCompliance is {
        do "the model sends check compliance"
      }
      on other is {
        error "Unexpected message for adaptor ToComplianceService"
      }
    } with {
      briefly "to compliance service"
      described as {
        |Carries messages to the external ComplianceService.
      }
    }
  } with {
      briefly "ComplianceService integration"
    described as {
      |The model's side of the ComplianceService conversation.
    }
  }
  adaptor FromExecutionVenueService from context ExecutionVenueService is {
    handler FromExecutionVenueServiceHandler is {
      on event ExecutionVenueService.OrderRouted is {
        do "the model receives order routed"
      }
      on event ExecutionVenueService.VenueExecution is {
        do "the model receives venue execution"
      }
      on other is {
        error "Unexpected message for adaptor FromExecutionVenueService"
      }
    } with {
      briefly "from execution venue service"
      described as {
        |Carries messages from the external ExecutionVenueService.
      }
    }
  } with {
      briefly "ExecutionVenueService integration"
    described as {
      |The model's side of the ExecutionVenueService conversation.
    }
  }
  adaptor ToExecutionVenueService to context ExecutionVenueService is {
    handler ToExecutionVenueServiceHandler is {
      on command ExecutionVenueService.RouteOrder is {
        do "the model sends route order"
      }
      on other is {
        error "Unexpected message for adaptor ToExecutionVenueService"
      }
    } with {
      briefly "to execution venue service"
      described as {
        |Carries messages to the external ExecutionVenueService.
      }
    }
  } with {
      briefly "ExecutionVenueService integration"
    described as {
      |The model's side of the ExecutionVenueService conversation.
    }
  }
  adaptor FromMarketDataService from context MarketDataService is {
    handler FromMarketDataServiceHandler is {
      on event MarketDataService.QuoteReceived is {
        do "the model receives quote received"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketDataService"
      }
    } with {
      briefly "from market data service"
      described as {
        |Carries messages from the external MarketDataService.
      }
    }
  } with {
      briefly "MarketDataService integration"
    described as {
      |The model's side of the MarketDataService conversation.
    }
  }
  adaptor ToMarketDataService to context MarketDataService is {
    handler ToMarketDataServiceHandler is {
      on command MarketDataService.GetQuote is {
        do "the model sends get quote"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketDataService"
      }
    } with {
      briefly "to market data service"
      described as {
        |Carries messages to the external MarketDataService.
      }
    }
  } with {
      briefly "MarketDataService integration"
    described as {
      |The model's side of the MarketDataService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is {
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is {
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendOrderNotification is {
        do "the model sends send order notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromRiskManagementService from context RiskManagementService is {
    handler FromRiskManagementServiceHandler is {
      on event RiskManagementService.RiskCheckCompleted is {
        do "the model receives risk check completed"
      }
      on other is {
        error "Unexpected message for adaptor FromRiskManagementService"
      }
    } with {
      briefly "from risk management service"
      described as {
        |Carries messages from the external RiskManagementService.
      }
    }
  } with {
      briefly "RiskManagementService integration"
    described as {
      |The model's side of the RiskManagementService conversation.
    }
  }
  adaptor ToRiskManagementService to context RiskManagementService is {
    handler ToRiskManagementServiceHandler is {
      on command RiskManagementService.CheckOrderRisk is {
        do "the model sends check order risk"
      }
      on other is {
        error "Unexpected message for adaptor ToRiskManagementService"
      }
    } with {
      briefly "to risk management service"
      described as {
        |Carries messages to the external RiskManagementService.
      }
    }
  } with {
      briefly "RiskManagementService integration"
    described as {
      |The model's side of the RiskManagementService conversation.
    }
  }
  include "types.riddl"
  include "TradingOrder.riddl"
  // Repository for order persistence
  repository OrderRepository is {
    inlet OrderRepositoryFromTradingOrder is type TradingOrderEvent
    inlet OrderRepositoryFromTradingAnalytics is type TradingOrderEvent
    outlet OrderRepositoryResponses is type TradingOrder.TradingOrderResult
    record StoredTradingOrder is {
      tradingOrderId: UUID with {
        briefly "tradingOrderId"
        described as {
          |The tradingOrderId column of the stored tradingOrder row.
        }
      }
      details: OrderDetails with {
        briefly "details"
        described as {
          |The details column of the stored tradingOrder row.
        }
      }
      orderId: OrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored tradingOrder row.
        }
      }
    } with {
      briefly "Stored tradingOrder row"
      described as {
        |The persistence shape of tradingOrder data as this repository stores it.
      }
    }
    schema OrderData is relational
      of orders as type StoredTradingOrder
        index on field StoredTradingOrder.orderId
        index on field StoredTradingOrder.details.accountId
      with {
      briefly "Order data schema"
      described as {
        |The relational schema holding order data for the OrderRepository.
      }
    }

    handler OrderPersistence is {
      on query GetTradingStats is {
        do "read the trading stats projection"
        yield result TradingStatsView
      }
      on command TradingOrder.PlaceOrder is {
        tell event TradingOrder.OrderPlaced to entity
          OrderContext.TradingOrder
      }
      on command TradingOrder.AcknowledgeOrder is {
        tell event TradingOrder.OrderAcknowledged to entity
          OrderContext.TradingOrder
      }
      on command TradingOrder.ReportExecution is {
        tell event TradingOrder.ExecutionReported to entity
          OrderContext.TradingOrder
      }
      on command TradingOrder.FillOrder is {
        tell event TradingOrder.OrderFilled to entity
          OrderContext.TradingOrder
      }
      on command TradingOrder.AmendOrder is {
        tell event TradingOrder.OrderAmended to entity
          OrderContext.TradingOrder
      }
      on command TradingOrder.CancelOrder is {
        tell event TradingOrder.OrderCanceled to entity
          OrderContext.TradingOrder
      }
      on command TradingOrder.RejectOrder is {
        tell event TradingOrder.OrderRejected to entity
          OrderContext.TradingOrder
      }
      on command TradingOrder.ExpireOrder is {
        tell event TradingOrder.OrderExpired to entity
          OrderContext.TradingOrder
      }
      on command TradingOrder.SuspendOrder is {
        tell event TradingOrder.OrderSuspended to entity
          OrderContext.TradingOrder
      }
      on command TradingOrder.ResumeOrder is {
        tell event TradingOrder.OrderResumed to entity
          OrderContext.TradingOrder
      }
    } with {
      briefly "Persists order commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Order data persistence"
    described as {
      | The OrderRepository provides persistent storage for
      | trading orders, executions, and status history.
    }
  }
  // Projector for trading analytics
  query GetTradingStats is {
    tradingStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which trading stats to retrieve.
      }
    }
  } with {
    briefly "Get trading stats"
    described as {
      |Retrieves the trading stats projection.
    }
  }
  result TradingStatsView is {
    tradingStats: TradingAnalytics.TradingStats with {
      briefly "Trading stats"
      described as {
        |The trading stats being returned.
      }
    }
  } with {
    briefly "Trading stats view"
    described as {
      |Read model view carrying the trading stats projection.
    }
  }
  projector TradingAnalytics is {
    inlet TradingAnalyticsFromTradingOrder is type TradingOrderEvent
    outlet TradingAnalyticsOut is type TradingOrderEvent
    updates repository OrderContext.OrderRepository
    record TradingStats is  {
      totalOrders: Natural with {
        briefly "Orders"
        described as {
          |Total orders.
        }
      }
      totalVolume: Decimal(18,2) with {
        briefly "Volume"
        described as {
          |Total traded value.
        }
      }
      fillRate: Decimal(5,4) with {
        briefly "Fill rate"
        described as {
          |Order fill rate.
        }
      }
      avgFillTime: Duration with {
        briefly "Avg time"
        described as {
          |Average fill time.
        }
      }
      cancelRate: Decimal(5,4) with {
        briefly "Cancel rate"
        described as {
          |Cancellation rate.
        }
      }
      totalCommissions: Decimal(15,2) with {
        briefly "Commissions"
        described as {
          |Total commissions.
        }
      }
    } with {
      briefly "Trading statistics"
      described as {
        |Trading activity metrics.
      }
    }
    handler AnalyticsHandler is {
      on event TradingOrder.OrderPlaced is {
        tell event TradingOrder.OrderPlaced to repository
          OrderContext.OrderRepository
      }
      on event TradingOrder.ExecutionReported is {
        tell event TradingOrder.ExecutionReported to repository
          OrderContext.OrderRepository
      }
      on event TradingOrder.OrderFilled is {
        tell event TradingOrder.OrderFilled to repository
          OrderContext.OrderRepository
      }
      on event TradingOrder.OrderCanceled is {
        tell event TradingOrder.OrderCanceled to repository
          OrderContext.OrderRepository
      }
    } with {
      briefly "Maintains trading analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Trading analytics projections"
    described as {
      |Maintains trading order analytics data.
    }
  }
  processor OrderEventSource as source is {
    outlet OrderEvents is type TradingOrderEvent
    handler OrderEventEmitter is {
      on init is {
        tell command InitializeTradingOrder to entity
          OrderContext.TradingOrder
      }
      on other is {
        error "Unexpected message for source OrderEventSource"
      }
      on event TradingOrder.OrderPlaced is {
        send event TradingOrder.OrderPlaced to outlet OrderEvents
      }
      on event TradingOrder.OrderFilled is {
        send event TradingOrder.OrderFilled to outlet OrderEvents
      }
      on event TradingOrder.OrderCanceled is {
        send event TradingOrder.OrderCanceled to outlet OrderEvents
      }
      on event TradingOrder.OrderExpired is {
        send event TradingOrder.OrderExpired to outlet OrderEvents
      }
    } with {
      briefly "Order event emitter"
      described as {
        |Emits trading order events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Order event source"
    described as {
      |Publishes trading order events for streaming.
    }
  }
  processor OrderEventSink as sink is {
    inlet IncomingOrderEvents is type TradingOrderEvent
    handler OrderEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink OrderEventSink"
      }
      on event TradingOrder.OrderPlaced is {
        tell event TradingOrder.OrderPlaced to repository
          OrderContext.OrderRepository
      }
      on event TradingOrder.OrderFilled is {
        tell event TradingOrder.OrderFilled to repository
          OrderContext.OrderRepository
      }
    } with {
      briefly "Order event receiver"
      described as {
        |Receives trading order events and persists them.
      }
    }
  } with {
    briefly "Order event sink"
    described as {
      |Receives trading order events from the streaming topology.
    }
  }
  connector OrderEventPipeline is {
    from outlet OrderContext.OrderEventSource.OrderEvents
      to inlet OrderContext.OrderEventSink.IncomingOrderEvents
  } with {
    briefly "Order event pipeline"
    described as {
      |Wires trading order events from source to sink.
    }
  }
  processor TradingOrderEventSplit is {
    inlet TradingOrderEventSplitIn is type TradingOrderEvent
    outlet TradingOrderEventSplitToOrderRepository is type TradingOrderEvent
    outlet TradingOrderEventSplitToTradingAnalytics is type TradingOrderEvent
    handler TradingOrderEventSplitHandler is {
      on event TradingOrder.OrderPlaced is {
        send event TradingOrder.OrderPlaced to outlet TradingOrderEventSplitToOrderRepository
        send event TradingOrder.OrderPlaced to outlet TradingOrderEventSplitToTradingAnalytics
        tell event TradingOrder.OrderPlaced to entity OrderContext.TradingOrder
      }
      on event TradingOrder.OrderAcknowledged is {
        send event TradingOrder.OrderAcknowledged to outlet TradingOrderEventSplitToOrderRepository
        send event TradingOrder.OrderAcknowledged to outlet TradingOrderEventSplitToTradingAnalytics
        tell event TradingOrder.OrderAcknowledged to entity OrderContext.TradingOrder
      }
      on event TradingOrder.ExecutionReported is {
        send event TradingOrder.ExecutionReported to outlet TradingOrderEventSplitToOrderRepository
        send event TradingOrder.ExecutionReported to outlet TradingOrderEventSplitToTradingAnalytics
        tell event TradingOrder.ExecutionReported to entity OrderContext.TradingOrder
      }
      on event TradingOrder.OrderFilled is {
        send event TradingOrder.OrderFilled to outlet TradingOrderEventSplitToOrderRepository
        send event TradingOrder.OrderFilled to outlet TradingOrderEventSplitToTradingAnalytics
        tell event TradingOrder.OrderFilled to entity OrderContext.TradingOrder
      }
      on event TradingOrder.OrderAmended is {
        send event TradingOrder.OrderAmended to outlet TradingOrderEventSplitToOrderRepository
        send event TradingOrder.OrderAmended to outlet TradingOrderEventSplitToTradingAnalytics
        tell event TradingOrder.OrderAmended to entity OrderContext.TradingOrder
      }
      on event TradingOrder.OrderCanceled is {
        send event TradingOrder.OrderCanceled to outlet TradingOrderEventSplitToOrderRepository
        send event TradingOrder.OrderCanceled to outlet TradingOrderEventSplitToTradingAnalytics
        tell event TradingOrder.OrderCanceled to entity OrderContext.TradingOrder
      }
      on event TradingOrder.OrderRejected is {
        send event TradingOrder.OrderRejected to outlet TradingOrderEventSplitToOrderRepository
        send event TradingOrder.OrderRejected to outlet TradingOrderEventSplitToTradingAnalytics
        tell event TradingOrder.OrderRejected to entity OrderContext.TradingOrder
      }
      on event TradingOrder.OrderExpired is {
        send event TradingOrder.OrderExpired to outlet TradingOrderEventSplitToOrderRepository
        send event TradingOrder.OrderExpired to outlet TradingOrderEventSplitToTradingAnalytics
        tell event TradingOrder.OrderExpired to entity OrderContext.TradingOrder
      }
      on event TradingOrder.OrderSuspended is {
        send event TradingOrder.OrderSuspended to outlet TradingOrderEventSplitToOrderRepository
        send event TradingOrder.OrderSuspended to outlet TradingOrderEventSplitToTradingAnalytics
        tell event TradingOrder.OrderSuspended to entity OrderContext.TradingOrder
      }
      on event TradingOrder.OrderResumed is {
        send event TradingOrder.OrderResumed to outlet TradingOrderEventSplitToOrderRepository
        send event TradingOrder.OrderResumed to outlet TradingOrderEventSplitToTradingAnalytics
        tell event TradingOrder.OrderResumed to entity OrderContext.TradingOrder
      }
      on other is {
        error "Unexpected message for processor TradingOrderEventSplit"
      }
    } with {
      briefly "TradingOrder event fan-out handler"
      described as {
        |Delivers each TradingOrder event to all of its consumers.
      }
    }
  } with {
    briefly "TradingOrder event fan-out"
    described as {
      |Fans TradingOrder events out to the repository and projectors.
    }
  }
  connector LinkTradingOrderToTradingOrderEventSplit is {
    from outlet OrderContext.TradingOrder.TradingOrderEvents to
      inlet OrderContext.TradingOrderEventSplit.TradingOrderEventSplitIn
  } with {
    briefly "LinkTradingOrderToTradingOrderEventSplit"
  }
  connector LinkTradingOrderEventSplitToOrderRepository is {
    from outlet OrderContext.TradingOrderEventSplit.TradingOrderEventSplitToOrderRepository to
      inlet OrderContext.OrderRepository.OrderRepositoryFromTradingOrder
  } with {
    briefly "LinkTradingOrderEventSplitToOrderRepository"
  }
  connector LinkTradingOrderEventSplitToTradingAnalytics is {
    from outlet OrderContext.TradingOrderEventSplit.TradingOrderEventSplitToTradingAnalytics to
      inlet OrderContext.TradingAnalytics.TradingAnalyticsFromTradingOrder
  } with {
    briefly "LinkTradingOrderEventSplitToTradingAnalytics"
  }
  connector LinkTradingAnalyticsToOrderRepository is {
    from outlet OrderContext.TradingAnalytics.TradingAnalyticsOut to
      inlet OrderContext.OrderRepository.OrderRepositoryFromTradingAnalytics
  } with {
    briefly "LinkTradingAnalyticsToOrderRepository"
  }
} with {
  briefly "Bounded context for order management"
  described as {
    | The OrderContext is the bounded context for trading
    | order management, execution, and tracking.
  }
}
