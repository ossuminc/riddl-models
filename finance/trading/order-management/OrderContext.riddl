// Order Management - Order Context
context OrderContext as router is {
  inlet TradingOrderCommandStreamIn is type TradingOrderCommand  outlet TradingOrderCommandStreamOut is type TradingOrderCommand
  inlet MarketplaceOrderResultStreamIn is result TradingOrder.TradingOrderResult  outlet MarketplaceOrderResultStreamOut is result TradingOrder.TradingOrderResult
  handler OrderContextBoundary is {
    on placeOrder: command TradingOrder.PlaceOrder is {
      send placeOrder to outlet OrderContext.TradingOrderCommandStreamOut
    }
    on acknowledgeOrder: command TradingOrder.AcknowledgeOrder is {
      send acknowledgeOrder to outlet OrderContext.TradingOrderCommandStreamOut
    }
    on reportExecution: command TradingOrder.ReportExecution is {
      send reportExecution to outlet OrderContext.TradingOrderCommandStreamOut
    }
    on amendOrder: command TradingOrder.AmendOrder is {
      send amendOrder to outlet OrderContext.TradingOrderCommandStreamOut
    }
    on cancelOrder: command TradingOrder.CancelOrder is {
      send cancelOrder to outlet OrderContext.TradingOrderCommandStreamOut
    }
    on rejectOrder: command TradingOrder.RejectOrder is {
      send rejectOrder to outlet OrderContext.TradingOrderCommandStreamOut
    }
    on expireOrder: command TradingOrder.ExpireOrder is {
      send expireOrder to outlet OrderContext.TradingOrderCommandStreamOut
    }
    on fillOrder: command TradingOrder.FillOrder is {
      send fillOrder to outlet OrderContext.TradingOrderCommandStreamOut
    }
    on suspendOrder: command TradingOrder.SuspendOrder is {
      send suspendOrder to outlet OrderContext.TradingOrderCommandStreamOut
    }
    on resumeOrder: command TradingOrder.ResumeOrder is {
      send resumeOrder to outlet OrderContext.TradingOrderCommandStreamOut
    }
    on tradingOrderResult: result TradingOrder.TradingOrderResult is {
      send tradingOrderResult to outlet OrderContext.MarketplaceOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the OrderContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TradingAnalytics Storage' is from outlet OrderContext.TradingAnalytics.TradingAnalyticsToRepository to inlet OrderContext.OrderRepository.OrderRepositoryFromTradingAnalytics with {
    briefly "TradingAnalytics projections on their way to OrderRepository"
  }
  connector 'TradingOrderCommand Stream Intake' is from outlet OrderContext.TradingOrderCommandStreamOut to inlet OrderContext.TradingOrder.TradingOrderCommands  connector 'MarketplaceOrderResult Stream Egress' is from outlet OrderContext.OrderRepository.OrderRepositoryResponses to inlet OrderContext.MarketplaceOrderResultStreamIn  adaptor FromAccountService from context AccountService is { 
    handler FromAccountServiceHandler is {
      on result AccountService.AccountInfo is {
        do "the model receives account info"
      }
      on other is {
        error "Unexpected message for adaptor FromAccountService"
      }
    } with {
      briefly "from account service"
      described as {
        |Carries messages from the external AccountService.
      }
    }
  } with {
    briefly "AccountService integration"
    described as {
      |The model's side of the AccountService conversation.
    }
  }
  adaptor ToAccountService to context AccountService is { 
    handler ToAccountServiceHandler is {
      on query AccountService.GetAccountInfo is {
        do "the model sends get account info"
      }
      on other is {
        error "Unexpected message for adaptor ToAccountService"
      }
    } with {
      briefly "to account service"
      described as {
        |Carries messages to the external AccountService.
      }
    }
  } with {
    briefly "AccountService integration"
    described as {
      |The model's side of the AccountService conversation.
    }
  }
  adaptor FromComplianceService from context ComplianceService is { 
    handler FromComplianceServiceHandler is {
      on event ComplianceService.ComplianceCheckCompleted is {
        do "the model receives compliance check completed"
      }
      on other is {
        error "Unexpected message for adaptor FromComplianceService"
      }
    } with {
      briefly "from compliance service"
      described as {
        |Carries messages from the external ComplianceService.
      }
    }
  } with {
    briefly "ComplianceService integration"
    described as {
      |The model's side of the ComplianceService conversation.
    }
  }
  adaptor ToComplianceService to context ComplianceService is { 
    handler ToComplianceServiceHandler is {
      on command ComplianceService.CheckCompliance is {
        do "the model sends check compliance"
      }
      on other is {
        error "Unexpected message for adaptor ToComplianceService"
      }
    } with {
      briefly "to compliance service"
      described as {
        |Carries messages to the external ComplianceService.
      }
    }
  } with {
    briefly "ComplianceService integration"
    described as {
      |The model's side of the ComplianceService conversation.
    }
  }
  adaptor FromExecutionVenueService from context ExecutionVenueService is { 
    handler FromExecutionVenueServiceHandler is {
      on event ExecutionVenueService.OrderRouted is {
        do "the model receives order routed"
      }
      on event ExecutionVenueService.VenueExecution is {
        do "the model receives venue execution"
      }
      on other is {
        error "Unexpected message for adaptor FromExecutionVenueService"
      }
    } with {
      briefly "from execution venue service"
      described as {
        |Carries messages from the external ExecutionVenueService.
      }
    }
  } with {
    briefly "ExecutionVenueService integration"
    described as {
      |The model's side of the ExecutionVenueService conversation.
    }
  }
  adaptor ToExecutionVenueService to context ExecutionVenueService is { 
    handler ToExecutionVenueServiceHandler is {
      on command ExecutionVenueService.RouteOrder is {
        do "the model sends route order"
      }
      on other is {
        error "Unexpected message for adaptor ToExecutionVenueService"
      }
    } with {
      briefly "to execution venue service"
      described as {
        |Carries messages to the external ExecutionVenueService.
      }
    }
  } with {
    briefly "ExecutionVenueService integration"
    described as {
      |The model's side of the ExecutionVenueService conversation.
    }
  }
  adaptor FromMarketDataService from context MarketDataService is { 
    handler FromMarketDataServiceHandler is {
      on event MarketDataService.QuoteReceived is {
        do "the model receives quote received"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketDataService"
      }
    } with {
      briefly "from market data service"
      described as {
        |Carries messages from the external MarketDataService.
      }
    }
  } with {
    briefly "MarketDataService integration"
    described as {
      |The model's side of the MarketDataService conversation.
    }
  }
  adaptor ToMarketDataService to context MarketDataService is { 
    handler ToMarketDataServiceHandler is {
      on command MarketDataService.GetQuote is {
        do "the model sends get quote"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketDataService"
      }
    } with {
      briefly "to market data service"
      described as {
        |Carries messages to the external MarketDataService.
      }
    }
  } with {
    briefly "MarketDataService integration"
    described as {
      |The model's side of the MarketDataService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendOrderNotification is {
        do "the model sends send order notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromRiskManagementService from context RiskManagementService is { 
    handler FromRiskManagementServiceHandler is {
      on event RiskManagementService.RiskCheckCompleted is {
        do "the model receives risk check completed"
      }
      on other is {
        error "Unexpected message for adaptor FromRiskManagementService"
      }
    } with {
      briefly "from risk management service"
      described as {
        |Carries messages from the external RiskManagementService.
      }
    }
  } with {
    briefly "RiskManagementService integration"
    described as {
      |The model's side of the RiskManagementService conversation.
    }
  }
  adaptor ToRiskManagementService to context RiskManagementService is { 
    handler ToRiskManagementServiceHandler is {
      on command RiskManagementService.CheckOrderRisk is {
        do "the model sends check order risk"
      }
      on other is {
        error "Unexpected message for adaptor ToRiskManagementService"
      }
    } with {
      briefly "to risk management service"
      described as {
        |Carries messages to the external RiskManagementService.
      }
    }
  } with {
    briefly "RiskManagementService integration"
    described as {
      |The model's side of the RiskManagementService conversation.
    }
  }
  include "types.riddl"
  include "TradingOrder.riddl"
  // Repository for order persistence
  type OrderRepositoryCommand is one of {
    OrderContext.OrderRepository.PersistExecutionReported or OrderContext.OrderRepository.PersistOrderCanceled or OrderContext.OrderRepository.PersistOrderFilled or OrderContext.OrderRepository.PersistOrderPlaced or OrderContext.OrderRepository.PersistOrderAcknowledged or OrderContext.OrderRepository.PersistOrderAmended or OrderContext.OrderRepository.PersistOrderExpired or OrderContext.OrderRepository.PersistOrderRejected or OrderContext.OrderRepository.PersistOrderResumed or OrderContext.OrderRepository.PersistOrderSuspended
  } with {
    briefly "Anything that writes the OrderRepository"
    described as {
      |The persistence commands OrderRepository accepts. Entity events never
      |reach it directly; the projector turns each event into one of these.
    }
  }
  repository OrderRepository as flow is {
    command PersistExecutionReported is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExecutionReported applies to.
        }
      }
    } with {
      briefly "Persist ExecutionReported"
      described as {
        |Instructs this repository to apply ExecutionReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderCanceled is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCanceled applies to.
        }
      }
    } with {
      briefly "Persist OrderCanceled"
      described as {
        |Instructs this repository to apply OrderCanceled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderFilled is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderFilled applies to.
        }
      }
    } with {
      briefly "Persist OrderFilled"
      described as {
        |Instructs this repository to apply OrderFilled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderAcknowledged is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderAcknowledged applies to.
        }
      }
    } with {
      briefly "Persist OrderAcknowledged"
      described as {
        |Instructs this repository to apply OrderAcknowledged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderAmended is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderAmended applies to.
        }
      }
    } with {
      briefly "Persist OrderAmended"
      described as {
        |Instructs this repository to apply OrderAmended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderExpired is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderExpired applies to.
        }
      }
    } with {
      briefly "Persist OrderExpired"
      described as {
        |Instructs this repository to apply OrderExpired to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderRejected is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderRejected applies to.
        }
      }
    } with {
      briefly "Persist OrderRejected"
      described as {
        |Instructs this repository to apply OrderRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderResumed is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderResumed applies to.
        }
      }
    } with {
      briefly "Persist OrderResumed"
      described as {
        |Instructs this repository to apply OrderResumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderSuspended is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderSuspended applies to.
        }
      }
    } with {
      briefly "Persist OrderSuspended"
      described as {
        |Instructs this repository to apply OrderSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderPlaced is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderPlaced applies to.
        }
      }
    } with {
      briefly "Persist OrderPlaced"
      described as {
        |Instructs this repository to apply OrderPlaced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet OrderRepositoryFromTradingAnalytics is type OrderRepositoryCommand
    outlet OrderRepositoryResponses is result TradingOrder.TradingOrderResult
    record StoredTradingOrder is  {
      tradingOrderId: UUID with {
        briefly "tradingOrderId"
        described as {
          |The tradingOrderId column of the stored tradingOrder row.
        }
      }
      details: OrderDetails with {
        briefly "details"
        described as {
          |The details column of the stored tradingOrder row.
        }
      }
      orderId: OrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored tradingOrder row.
        }
      }
    } with {
      briefly "Stored tradingOrder row"
      described as {
        |The persistence shape of tradingOrder data as this repository stores it.
      }
    }
    schema OrderData is relational
      of orders as record StoredTradingOrder
        index on field StoredTradingOrder.orderId
        index on field StoredTradingOrder.details.accountId
 with {
      briefly "Order data schema"
      described as {
        |The relational schema holding order data for the OrderRepository.
      }
    }
    handler OrderPersistence is {
      on persistOrderAcknowledged: command PersistOrderAcknowledged is {
        do "apply OrderAcknowledged to the stored row"
      }
      on persistOrderAmended: command PersistOrderAmended is {
        do "apply OrderAmended to the stored row"
      }
      on persistOrderExpired: command PersistOrderExpired is {
        do "apply OrderExpired to the stored row"
      }
      on persistOrderRejected: command PersistOrderRejected is {
        do "apply OrderRejected to the stored row"
      }
      on persistOrderResumed: command PersistOrderResumed is {
        do "apply OrderResumed to the stored row"
      }
      on persistOrderSuspended: command PersistOrderSuspended is {
        do "apply OrderSuspended to the stored row"
      }
      on persistExecutionReported: command PersistExecutionReported is {
        do "apply ExecutionReported to the stored row"
      }
      on persistOrderCanceled: command PersistOrderCanceled is {
        do "apply OrderCanceled to the stored row"
      }
      on persistOrderFilled: command PersistOrderFilled is {
        do "apply OrderFilled to the stored row"
      }
      on persistOrderPlaced: command PersistOrderPlaced is {
        do "apply OrderPlaced to the stored row"
      }
      on query GetTradingStats is {
        let tradingStatsView: type TradingStatsView = prompt("read the trading stats projection")
        reply tradingStatsView
      }
    } with {
      briefly "Persists order commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Order data persistence"
    described as {
      | The OrderRepository provides persistent storage for
      | trading orders, executions, and status history.
    }
  }
  // Projector for trading analytics
  query GetTradingStats replies result TradingStatsView is  {
    tradingStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which trading stats to retrieve.
      }
    }
  } with {
    briefly "Get trading stats"
    described as {
      |Retrieves the trading stats projection.
    }
  }
  result TradingStatsView is  {
    tradingStats: TradingAnalytics.TradingStats with {
      briefly "Trading stats"
      described as {
        |The trading stats being returned.
      }
    }
  } with {
    briefly "Trading stats view"
    described as {
      |Read model view carrying the trading stats projection.
    }
  }
  projector TradingAnalytics as flow is {
    updates repository OrderContext.OrderRepository
    inlet TradingAnalyticsFromTradingOrder is type TradingOrderEvent
    outlet TradingAnalyticsToRepository is type OrderRepositoryCommand
    record TradingStats is  {
      totalOrders: Natural with {
        briefly "Orders"
        described as {
          |Total orders.
        }
      }
      totalVolume: Decimal(18,2) with {
        briefly "Volume"
        described as {
          |Total traded value.
        }
      }
      fillRate: Decimal(5,4) with {
        briefly "Fill rate"
        described as {
          |Order fill rate.
        }
      }
      avgFillTime: Duration with {
        briefly "Avg time"
        described as {
          |Average fill time.
        }
      }
      cancelRate: Decimal(5,4) with {
        briefly "Cancel rate"
        described as {
          |Cancellation rate.
        }
      }
      totalCommissions: Decimal(15,2) with {
        briefly "Commissions"
        described as {
          |Total commissions.
        }
      }
    } with {
      briefly "Trading statistics"
      described as {
        |Trading activity metrics.
      }
    }
    handler AnalyticsHandler is {
      on orderAcknowledged: event TradingOrder.OrderAcknowledged is {
        tell command OrderContext.OrderRepository.PersistOrderAcknowledged(orderId = orderAcknowledged.orderId) to repository OrderContext.OrderRepository
      }
      on orderAmended: event TradingOrder.OrderAmended is {
        tell command OrderContext.OrderRepository.PersistOrderAmended(orderId = orderAmended.orderId) to repository OrderContext.OrderRepository
      }
      on orderExpired: event TradingOrder.OrderExpired is {
        tell command OrderContext.OrderRepository.PersistOrderExpired(orderId = orderExpired.orderId) to repository OrderContext.OrderRepository
      }
      on orderRejected: event TradingOrder.OrderRejected is {
        tell command OrderContext.OrderRepository.PersistOrderRejected(orderId = orderRejected.orderId) to repository OrderContext.OrderRepository
      }
      on orderResumed: event TradingOrder.OrderResumed is {
        tell command OrderContext.OrderRepository.PersistOrderResumed(orderId = orderResumed.orderId) to repository OrderContext.OrderRepository
      }
      on orderSuspended: event TradingOrder.OrderSuspended is {
        tell command OrderContext.OrderRepository.PersistOrderSuspended(orderId = orderSuspended.orderId) to repository OrderContext.OrderRepository
      }
      on orderPlaced: event TradingOrder.OrderPlaced is {
        tell command OrderContext.OrderRepository.PersistOrderPlaced(orderId = orderPlaced.orderId) to repository OrderContext.OrderRepository
      }
      on executionReported: event TradingOrder.ExecutionReported is {
        tell command OrderContext.OrderRepository.PersistExecutionReported(orderId = executionReported.orderId) to repository OrderContext.OrderRepository
      }
      on orderFilled: event TradingOrder.OrderFilled is {
        tell command OrderContext.OrderRepository.PersistOrderFilled(orderId = orderFilled.orderId) to repository OrderContext.OrderRepository
      }
      on orderCanceled: event TradingOrder.OrderCanceled is {
        tell command OrderContext.OrderRepository.PersistOrderCanceled(orderId = orderCanceled.orderId) to repository OrderContext.OrderRepository
      }
    } with {
      briefly "Maintains trading analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Trading analytics projections"
    described as {
      |Maintains trading order analytics data.
    }
  }
  processor TradingOrderEventSplit as flow is {
    inlet TradingOrderEventSplitIn is type TradingOrderEvent
    outlet TradingOrderEventSplitToTradingAnalytics is type TradingOrderEvent
    handler TradingOrderEventSplitHandler is {
      on orderPlaced: event TradingOrder.OrderPlaced is {
        send orderPlaced to outlet TradingOrderEventSplitToTradingAnalytics
        tell orderPlaced to entity OrderContext.TradingOrder
      }
      on orderAcknowledged: event TradingOrder.OrderAcknowledged is {
        send orderAcknowledged to outlet TradingOrderEventSplitToTradingAnalytics
        tell orderAcknowledged to entity OrderContext.TradingOrder
      }
      on executionReported: event TradingOrder.ExecutionReported is {
        send executionReported to outlet TradingOrderEventSplitToTradingAnalytics
        tell executionReported to entity OrderContext.TradingOrder
      }
      on orderFilled: event TradingOrder.OrderFilled is {
        send orderFilled to outlet TradingOrderEventSplitToTradingAnalytics
        tell orderFilled to entity OrderContext.TradingOrder
      }
      on orderAmended: event TradingOrder.OrderAmended is {
        send orderAmended to outlet TradingOrderEventSplitToTradingAnalytics
        tell orderAmended to entity OrderContext.TradingOrder
      }
      on orderCanceled: event TradingOrder.OrderCanceled is {
        send orderCanceled to outlet TradingOrderEventSplitToTradingAnalytics
        tell orderCanceled to entity OrderContext.TradingOrder
      }
      on orderRejected: event TradingOrder.OrderRejected is {
        send orderRejected to outlet TradingOrderEventSplitToTradingAnalytics
        tell orderRejected to entity OrderContext.TradingOrder
      }
      on orderExpired: event TradingOrder.OrderExpired is {
        send orderExpired to outlet TradingOrderEventSplitToTradingAnalytics
        tell orderExpired to entity OrderContext.TradingOrder
      }
      on orderSuspended: event TradingOrder.OrderSuspended is {
        send orderSuspended to outlet TradingOrderEventSplitToTradingAnalytics
        tell orderSuspended to entity OrderContext.TradingOrder
      }
      on orderResumed: event TradingOrder.OrderResumed is {
        send orderResumed to outlet TradingOrderEventSplitToTradingAnalytics
        tell orderResumed to entity OrderContext.TradingOrder
      }
      on other is {
        error "Unexpected message for processor TradingOrderEventSplit"
      }
    } with {
      briefly "TradingOrder event fan-out handler"
      described as {
        |Delivers each TradingOrder event to all of its consumers.
      }
    }
  } with {
    briefly "TradingOrder event fan-out"
    described as {
      |Fans TradingOrder events out to the repository and projectors.
    }
  }
  connector 'TradingOrderEvent Stream' is from outlet OrderContext.TradingOrder.TradingOrderEvents to inlet OrderContext.TradingOrderEventSplit.TradingOrderEventSplitIn with {
    briefly "TradingOrder events, fanned out to storage and read models"
  }
  connector 'TradingAnalytics Feed' is from outlet OrderContext.TradingOrderEventSplit.TradingOrderEventSplitToTradingAnalytics to inlet OrderContext.TradingAnalytics.TradingAnalyticsFromTradingOrder with {
    briefly "TradingOrder events feeding the TradingAnalytics projection"
  }
} with {
  briefly "Bounded context for order management"
  described as {
    | The OrderContext is the bounded context for trading
    | order management, execution, and tracking.
  }
}
