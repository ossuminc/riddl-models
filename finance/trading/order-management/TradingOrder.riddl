// Order Management - Trading Order Entity
entity TradingOrder as flow is {
  type TradingOrderCommand is one of {
    TradingOrder.PlaceOrder or TradingOrder.AcknowledgeOrder or TradingOrder.ReportExecution or TradingOrder.AmendOrder or TradingOrder.CancelOrder or TradingOrder.RejectOrder or TradingOrder.ExpireOrder or TradingOrder.FillOrder or TradingOrder.SuspendOrder or TradingOrder.ResumeOrder
  } with {
    briefly "TradingOrder command alternation"
    described as {
      |Commands accepted by the TradingOrder entity.
    }
  }
  inlet TradingOrderCommands is type TradingOrderCommand  outlet TradingOrderEvents is type TradingOrderEvent
  // Commands
  command PlaceOrder is {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |New order identifier.
      }
    }
    details: OrderDetails with {
      briefly "Details"
      described as {
        |Order details.
      }
    }
    placedBy: String(1,100) with {
      briefly "Placed by"
      described as {
        |Trader placing order.
      }
    }
  } with {
    briefly "Place order"
    described as {
      |Places a new trading order.
    }
  }
  command AcknowledgeOrder is {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order identifier.
      }
    }
    brokerOrderId: String(1,50) with {
      briefly "Broker ID"
      described as {
        |Broker order reference.
      }
    }
  } with {
    briefly "Acknowledge order"
    described as {
      |Confirms order received by broker.
    }
  }
  command ReportExecution is {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order identifier.
      }
    }
    execution: Execution with {
      briefly "Execution"
      described as {
        |Execution details.
      }
    }
  } with {
    briefly "Report execution"
    described as {
      |Reports a trade execution.
    }
  }
  command AmendOrder is {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order identifier.
      }
    }
    amendment: OrderAmendment with {
      briefly "Amendment"
      described as {
        |Amendment details.
      }
    }
    amendedBy: String(1,100) with {
      briefly "Amended by"
      described as {
        |Person amending.
      }
    }
  } with {
    briefly "Amend order"
    described as {
      |Modifies an existing order.
    }
  }
  command CancelOrder is {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order identifier.
      }
    }
    reason: CancelReason with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
    canceledBy: String(1,100) with {
      briefly "Canceled by"
      described as {
        |Person canceling.
      }
    }
  } with {
    briefly "Cancel order"
    described as {
      |Cancels an open order.
    }
  }
  command RejectOrder is {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order identifier.
      }
    }
    rejection: RejectReason with {
      briefly "Rejection"
      described as {
        |Rejection details.
      }
    }
  } with {
    briefly "Reject order"
    described as {
      |Rejects an order.
    }
  }
  command ExpireOrder is {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order identifier.
      }
    }
    expiredAt: TimeStamp with {
      briefly "Expired"
      described as {
        |Expiration time.
      }
    }
  } with {
    briefly "Expire order"
    described as {
      |Marks order as expired.
    }
  }
  command FillOrder is {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order to fill.
      }
    }
    totalQuantity: Natural with {
      briefly "Quantity"
      described as {
        |Total quantity filled.
      }
    }
    avgPrice: Decimal(12,4) with {
      briefly "Avg price"
      described as {
        |Average fill price.
      }
    }
  } with {
    briefly "Fill order"
    described as {
      |Marks order as completely filled.
    }
  }
  command SuspendOrder is {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order identifier.
      }
    }
    suspensionReason: String(1,200) with {
      briefly "Reason"
      described as {
        |Suspension reason.
      }
    }
  } with {
    briefly "Suspend order"
    described as {
      |Suspends order execution.
    }
  }
  command ResumeOrder is {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order identifier.
      }
    }
  } with {
    briefly "Resume order"
    described as {
      |Resumes suspended order.
    }
  }
  // Events
  event OrderPlaced is {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    details: OrderDetails with {
      briefly "Details"
      described as {
        |Order details.
      }
    }
    placedBy: String(1,100) with {
      briefly "Placed by"
      described as {
        |Trader.
      }
    }
    placedAt: TimeStamp with {
      briefly "Placed"
      described as {
        |Placement time.
      }
    }
  } with {
    briefly "Order placed"
    described as {
      |Emitted when order is placed.
    }
  }
  event OrderAcknowledged is {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    brokerOrderId: String(1,50) with {
      briefly "Broker ID"
      described as {
        |Broker reference.
      }
    }
    acknowledgedAt: TimeStamp with {
      briefly "Acknowledged"
      described as {
        |Acknowledgment time.
      }
    }
  } with {
    briefly "Order acknowledged"
    described as {
      |Emitted when broker acknowledges.
    }
  }
  event ExecutionReported is {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    execution: Execution with {
      briefly "Execution"
      described as {
        |Execution details.
      }
    }
    cumulativeQuantity: Natural with {
      briefly "Cumulative"
      described as {
        |Total filled.
      }
    }
    remainingQuantity: Natural with {
      briefly "Remaining"
      described as {
        |Unfilled quantity.
      }
    }
    avgPrice: Decimal(12,4) with {
      briefly "Avg price"
      described as {
        |Average fill price.
      }
    }
  } with {
    briefly "Execution reported"
    described as {
      |Emitted when execution occurs.
    }
  }
  event OrderFilled is {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    totalQuantity: Natural with {
      briefly "Quantity"
      described as {
        |Total filled.
      }
    }
    avgPrice: Decimal(12,4) with {
      briefly "Avg price"
      described as {
        |Average price.
      }
    }
    totalCommission: Decimal(10,4) with {
      briefly "Commission"
      described as {
        |Total commission.
      }
    }
    totalFees: Decimal(10,4) with {
      briefly "Fees"
      described as {
        |Total fees.
      }
    }
    filledAt: TimeStamp with {
      briefly "Filled"
      described as {
        |Fill completion time.
      }
    }
  } with {
    briefly "Order filled"
    described as {
      |Emitted when order is completely filled.
    }
  }
  event OrderAmended is {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    amendment: OrderAmendment with {
      briefly "Amendment"
      described as {
        |Changes made.
      }
    }
    amendedBy: String(1,100) with {
      briefly "Amended by"
      described as {
        |Person who amended.
      }
    }
    amendedAt: TimeStamp with {
      briefly "Amended"
      described as {
        |Amendment time.
      }
    }
  } with {
    briefly "Order amended"
    described as {
      |Emitted when order is modified.
    }
  }
  event OrderCanceled is {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    reason: CancelReason with {
      briefly "Reason"
      described as {
        |Cancel reason.
      }
    }
    canceledBy: String(1,100) with {
      briefly "Canceled by"
      described as {
        |Who canceled.
      }
    }
    canceledAt: TimeStamp with {
      briefly "Canceled"
      described as {
        |Cancel time.
      }
    }
    filledQuantity: Natural with {
      briefly "Filled"
      described as {
        |Quantity filled before cancel.
      }
    }
  } with {
    briefly "Order canceled"
    described as {
      |Emitted when order is canceled.
    }
  }
  event OrderRejected is {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    rejection: RejectReason with {
      briefly "Rejection"
      described as {
        |Rejection details.
      }
    }
    rejectedAt: TimeStamp with {
      briefly "Rejected"
      described as {
        |Rejection time.
      }
    }
  } with {
    briefly "Order rejected"
    described as {
      |Emitted when order is rejected.
    }
  }
  event OrderExpired is {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    expiredAt: TimeStamp with {
      briefly "Expired"
      described as {
        |Expiration time.
      }
    }
    filledQuantity: Natural with {
      briefly "Filled"
      described as {
        |Quantity filled before expiry.
      }
    }
  } with {
    briefly "Order expired"
    described as {
      |Emitted when order expires.
    }
  }
  event OrderSuspended is {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    suspensionReason: String(1,200) with {
      briefly "Reason"
      described as {
        |Suspension reason.
      }
    }
    suspendedAt: TimeStamp with {
      briefly "Suspended"
      described as {
        |Suspension time.
      }
    }
  } with {
    briefly "Order suspended"
    described as {
      |Emitted when order is suspended.
    }
  }
  event OrderResumed is {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    resumedAt: TimeStamp with {
      briefly "Resumed"
      described as {
        |Resume time.
      }
    }
  } with {
    briefly "Order resumed"
    described as {
      |Emitted when order resumes.
    }
  }
  // State Records
  record OpenStateData is {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    details: OrderDetails with {
      briefly "Details"
      described as {
        |Order details.
      }
    }
    status: OrderStatus with {
      briefly "Status"
      described as {
        |Order status.
      }
    }
    assignedBrokerOrderId: String(1,50)? with {
      briefly "Broker ID"
      described as {
        |Broker reference.
      }
    }
    partialExecutions: Execution* with {
      briefly "Executions"
      described as {
        |Order executions.
      }
    }
    filledQuantity: Natural with {
      briefly "Filled"
      described as {
        |Quantity filled.
      }
    }
    remainingQuantity: Natural with {
      briefly "Remaining"
      described as {
        |Quantity remaining.
      }
    }
    avgPrice: Decimal(12,4) with {
      briefly "Avg price"
      described as {
        |Average fill price.
      }
    }
    placedBy: String(1,100) with {
      briefly "Placed by"
      described as {
        |Trader.
      }
    }
    placedAt: TimeStamp with {
      briefly "Placed"
      described as {
        |Placement time.
      }
    }
  } with {
    briefly "Open state data"
    described as {
      |State for open order.
    }
  }
  record FilledStateData is {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    details: OrderDetails with {
      briefly "Details"
      described as {
        |Order details.
      }
    }
    executions: Execution+ with {
      briefly "Executions"
      described as {
        |All executions.
      }
    }
    totalQuantity: Natural with {
      briefly "Quantity"
      described as {
        |Total filled.
      }
    }
    avgPrice: Decimal(12,4) with {
      briefly "Avg price"
      described as {
        |Average price.
      }
    }
    totalCommission: Decimal(10,4) with {
      briefly "Commission"
      described as {
        |Total commission.
      }
    }
    totalFees: Decimal(10,4) with {
      briefly "Fees"
      described as {
        |Total fees.
      }
    }
    filledAt: TimeStamp with {
      briefly "Filled"
      described as {
        |Fill time.
      }
    }
  } with {
    briefly "Filled state data"
    described as {
      |State for filled order.
    }
  }
  record ClosedStateData is {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    details: OrderDetails with {
      briefly "Details"
      described as {
        |Order details.
      }
    }
    finalStatus: OrderStatus with {
      briefly "Status"
      described as {
        |Final status.
      }
    }
    priorExecutions: Execution* with {
      briefly "Executions"
      described as {
        |Executions if any.
      }
    }
    filledQuantity: Natural with {
      briefly "Filled"
      described as {
        |Quantity filled.
      }
    }
    closedReason: String(1,200) with {
      briefly "Reason"
      described as {
        |Closure reason.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed"
      described as {
        |Closure time.
      }
    }
  } with {
    briefly "Closed state data"
    described as {
      |State for canceled/rejected/expired order.
    }
  }
  // Query/Result
  query GetTradingOrder replies result TradingOrderResult is {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order to retrieve.
      }
    }
  } with {
    briefly "Get trading order"
    described as {
      |Retrieves trading order data by identifier.
    }
  }
  result TradingOrderResult is {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order identifier.
      }
    }
    details: OrderDetails with {
      briefly "Details"
      described as {
        |Order details.
      }
    }
    status: OrderStatus with {
      briefly "Status"
      described as {
        |Order status.
      }
    }
  } with {
    briefly "Trading order result"
    described as {
      |Trading order data result.
    }
  }
  // States
  initial state OpenState of record TradingOrder.OpenStateData is {
    initial handler OpenStateInitHandler is {
      on init is {
        set state OpenState to "initialize from OrderPlaced event"
      }
    } with {
      briefly "Open state init handler"
      described as {
        |Initializes the Open state.
      }
    }
  } with {
    briefly "Open state"
    described as {
      |Order is open and active in the market.
    }
  }
  state FilledState of record TradingOrder.FilledStateData is {
    initial handler FilledStateInitHandler is {
      on init is {
        set state FilledState to "initialize from OrderFilled event"
      }
    } with {
      briefly "Filled state init handler"
      described as {
        |Initializes the Filled state.
      }
    }
  } with {
    briefly "Filled state"
    described as {
      |Order has been completely filled.
    }
  }
  state ClosedState of record TradingOrder.ClosedStateData is {
    initial handler ClosedStateInitHandler is {
      on init is {
        set state ClosedState to "initialize from OrderCanceled or OrderExpired event"
      }
    } with {
      briefly "Closed state init handler"
      described as {
        |Initializes the Closed state.
      }
    }
  } with {
    briefly "Closed state"
    described as {
      |Order has been canceled, rejected, or expired.
    }
  }
  // Handler
  handler OrderHandler is {
    on placeOrder: command PlaceOrder is {
      morph entity OrderContext.TradingOrder to state OrderContext.TradingOrder.OpenState with record TradingOrder.OpenStateData(orderId = placeOrder.orderId, details = placeOrder.details, placedBy = placeOrder.placedBy, status = prompt("the status of this open state data"), assignedBrokerOrderId = empty, partialExecutions = empty, filledQuantity = prompt("the filled quantity of this open state data"), remainingQuantity = prompt("the remaining quantity of this open state data"), avgPrice = prompt("the avg price of this open state data"), placedAt = prompt("the placed at of this open state data"))
      tell event OrderPlaced(orderId = placeOrder.orderId, details = placeOrder.details, placedBy = placeOrder.placedBy, placedAt = prompt("the placed at of this order placed")) to entity OrderContext.TradingOrder
    }
    on acknowledgeOrder: command AcknowledgeOrder is {
      tell event OrderAcknowledged(orderId = acknowledgeOrder.orderId, brokerOrderId = acknowledgeOrder.brokerOrderId, acknowledgedAt = prompt("the acknowledged at of this order acknowledged")) to entity OrderContext.TradingOrder
    }
    on reportExecution: command ReportExecution is {
      tell event ExecutionReported(orderId = reportExecution.orderId, execution = reportExecution.execution, cumulativeQuantity = prompt("the cumulative quantity of this execution reported"), remainingQuantity = prompt("the remaining quantity of this execution reported"), avgPrice = prompt("the avg price of this execution reported")) to entity OrderContext.TradingOrder
    }
    on fillOrder: command FillOrder is {
      morph entity OrderContext.TradingOrder to state OrderContext.TradingOrder.FilledState with record TradingOrder.FilledStateData(orderId = fillOrder.orderId, totalQuantity = fillOrder.totalQuantity, avgPrice = fillOrder.avgPrice, details = prompt("the details of this filled state data"), executions = prompt("the executions of this filled state data"), totalCommission = prompt("the total commission of this filled state data"), totalFees = prompt("the total fees of this filled state data"), filledAt = prompt("the filled at of this filled state data"))
      tell event OrderFilled(orderId = fillOrder.orderId, totalQuantity = fillOrder.totalQuantity, avgPrice = fillOrder.avgPrice, totalCommission = prompt("the total commission of this order filled"), totalFees = prompt("the total fees of this order filled"), filledAt = prompt("the filled at of this order filled")) to entity OrderContext.TradingOrder
    }
    on amendOrder: command AmendOrder is {
      tell event OrderAmended(orderId = amendOrder.orderId, amendment = amendOrder.amendment, amendedBy = amendOrder.amendedBy, amendedAt = prompt("the amended at of this order amended")) to entity OrderContext.TradingOrder
    }
    on cancelOrder: command CancelOrder is {
      morph entity OrderContext.TradingOrder to state OrderContext.TradingOrder.ClosedState with record TradingOrder.ClosedStateData(orderId = cancelOrder.orderId, details = prompt("the details of this closed state data"), finalStatus = prompt("the final status of this closed state data"), priorExecutions = empty, filledQuantity = prompt("the filled quantity of this closed state data"), closedReason = prompt("the closed reason of this closed state data"), closedAt = prompt("the closed at of this closed state data"))
      tell event OrderCanceled(orderId = cancelOrder.orderId, reason = cancelOrder.reason, canceledBy = cancelOrder.canceledBy, canceledAt = prompt("the canceled at of this order canceled"), filledQuantity = prompt("the filled quantity of this order canceled")) to entity OrderContext.TradingOrder
    }
    on rejectOrder: command RejectOrder is {
      morph entity OrderContext.TradingOrder to state OrderContext.TradingOrder.ClosedState with record TradingOrder.ClosedStateData(orderId = rejectOrder.orderId, details = prompt("the details of this closed state data"), finalStatus = prompt("the final status of this closed state data"), priorExecutions = empty, filledQuantity = prompt("the filled quantity of this closed state data"), closedReason = prompt("the closed reason of this closed state data"), closedAt = prompt("the closed at of this closed state data"))
      tell event OrderRejected(orderId = rejectOrder.orderId, rejection = rejectOrder.rejection, rejectedAt = prompt("the rejected at of this order rejected")) to entity OrderContext.TradingOrder
    }
    on expireOrder: command ExpireOrder is {
      morph entity OrderContext.TradingOrder to state OrderContext.TradingOrder.ClosedState with record TradingOrder.ClosedStateData(orderId = expireOrder.orderId, details = prompt("the details of this closed state data"), finalStatus = prompt("the final status of this closed state data"), priorExecutions = empty, filledQuantity = prompt("the filled quantity of this closed state data"), closedReason = prompt("the closed reason of this closed state data"), closedAt = prompt("the closed at of this closed state data"))
      tell event OrderExpired(orderId = expireOrder.orderId, expiredAt = expireOrder.expiredAt, filledQuantity = prompt("the filled quantity of this order expired")) to entity OrderContext.TradingOrder
    }
    on suspendOrder: command SuspendOrder is {
      tell event OrderSuspended(orderId = suspendOrder.orderId, suspensionReason = suspendOrder.suspensionReason, suspendedAt = prompt("the suspended at of this order suspended")) to entity OrderContext.TradingOrder
    }
    on resumeOrder: command ResumeOrder is {
      tell event OrderResumed(orderId = resumeOrder.orderId, resumedAt = prompt("the resumed at of this order resumed")) to entity OrderContext.TradingOrder
    }
    on getTradingOrder: query GetTradingOrder is {
      reply result TradingOrderResult(orderId = getTradingOrder.orderId, details = prompt("the details of this trading order result"), status = prompt("the status of this trading order result"))
    }
    on executionReported: event ExecutionReported is {
      do "apply ExecutionReported to the tradingOrder so it can be persisted and replayed"
    }
    on orderAcknowledged: event OrderAcknowledged is {
      do "apply OrderAcknowledged to the tradingOrder so it can be persisted and replayed"
    }
    on orderAmended: event OrderAmended is {
      do "apply OrderAmended to the tradingOrder so it can be persisted and replayed"
    }
    on orderCanceled: event OrderCanceled is {
      do "apply OrderCanceled to the tradingOrder so it can be persisted and replayed"
    }
    on orderExpired: event OrderExpired is {
      do "apply OrderExpired to the tradingOrder so it can be persisted and replayed"
    }
    on orderFilled: event OrderFilled is {
      do "apply OrderFilled to the tradingOrder so it can be persisted and replayed"
    }
    on orderPlaced: event OrderPlaced is {
      do "apply OrderPlaced to the tradingOrder so it can be persisted and replayed"
    }
    on orderRejected: event OrderRejected is {
      do "apply OrderRejected to the tradingOrder so it can be persisted and replayed"
    }
    on orderResumed: event OrderResumed is {
      do "apply OrderResumed to the tradingOrder so it can be persisted and replayed"
    }
    on orderSuspended: event OrderSuspended is {
      do "apply OrderSuspended to the tradingOrder so it can be persisted and replayed"
    }
  } with {
    briefly "Processes order commands"
    described as {
      | Handles trading order lifecycle from placement
      | through execution, amendment, and cancellation.
    }
  }
} with {
  briefly "Trading order aggregate"
  described as {
    | The TradingOrder entity manages securities orders
    | including execution, fills, and status tracking.
  }
}
