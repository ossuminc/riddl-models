// Trade Settlement Domain Model
// Post-trade clearing and settlement processing
domain TradeSettlement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user SettlementOperator is "person managing settlement operations" with {
    briefly "Settlement Operator"
    described as {
      |Person processing trade settlements.
    }
  }
  user ReconciliationAnalyst is "person handling trade breaks" with {
    briefly "Reconciliation Analyst"
    described as {
      |Person resolving settlement discrepancies.
    }
  }
  user CustodianManager is "person managing custody relationships" with {
    briefly "Custodian Manager"
    described as {
      |Person overseeing custodian interactions.
    }
  }
  epic SettlementEpic is {
    user SettlementOperator wants to "to settle trades efficiently" so that "positions and cash are exchanged correctly"
    case SettleTrade is {
      user SettlementOperator wants to "to process a trade for settlement" so that "the transaction completes"
      step is "System receives" "executed trade details" "from OMS" with {
        briefly "Receive trade"
        described as {
          |Get execution.
        }
      }
      step is "System matches" "trade with counterparty" "for affirmation" with {
        briefly "Match trade"
        described as {
          |Confirm details.
        }
      }
      step take input TradeSettlementApp.TradeSettlementScreen.InitiateSettlementInput from user SettlementOperator with {
        briefly "Initiate"
        described as {
          |Start settlement.
        }
      }
      step is "System delivers" "securities vs payment" "to custodian" with {
        briefly "DVP"
        described as {
          |Deliver vs payment.
        }
      }
    } with {
      briefly "Settlement workflow"
      described as {
        |Standard trade settlement process.
      }
    }
  } with {
    briefly "Trade settlement"
    described as {
      | Epic covering trade settlement from execution
      | through clearing, matching, and final settlement.
    }
  }
  include "SettlementContext.riddl"
  include "external-contexts.riddl"
  application context TradeSettlementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in TradeSettlement are delivered.
      }
    }
    group TradeSettlementScreen is {
      input InitiateSettlementInput acquires command SettlementContext.Settlement.InitiateSettlement with {
        briefly "Initiate settlement control"
        described as {
          |The control through which a user submits the initiate settlement request.
        }
      }
    } with {
      briefly "Trade settlement screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppSettlementCommands is type SettlementContext.Settlement.SettlementCommand
    inlet AppSettlementRepositoryResponses is result SettlementContext.Settlement.SettlementResult    handler TradeSettlementAppHandler is {
      on other is {
        error "Unexpected message for application context TradeSettlementApp"
      }
    } with {
      briefly "TradeSettlementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "TradeSettlementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'SettlementCommand Stream' is from outlet TradeSettlementApp.AppSettlementCommands to inlet SettlementContext.SettlementCommandStreamIn with {
    briefly "Settlement commands from the application"
  }
  persistent connector 'SettlementResult Stream' is from outlet SettlementContext.SettlementResultStreamOut to inlet TradeSettlementApp.AppSettlementRepositoryResponses with {
    briefly "Settlement query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet TradeSettlementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Trade settlement domain"
  described as {
    | The TradeSettlement domain handles post-trade processing
    | including clearing, matching, and DVP settlement.
  }
}
