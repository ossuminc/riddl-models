// Trade Settlement - Settlement Context
context SettlementContext is {
  adaptor FromCashService from context CashService is {
    handler FromCashServiceHandler is {
      on event CashService.CashBalanceUpdated is {
        do "the model receives cash balance updated"
      }
      on other is {
        error "Unexpected message for adaptor FromCashService"
      }
    } with {
      briefly "from cash service"
      described as {
        |Carries messages from the external CashService.
      }
    }
  } with {
      briefly "CashService integration"
    described as {
      |The model's side of the CashService conversation.
    }
  }
  adaptor ToCashService to context CashService is {
    handler ToCashServiceHandler is {
      on command CashService.UpdateCashBalance is {
        do "the model sends update cash balance"
      }
      on other is {
        error "Unexpected message for adaptor ToCashService"
      }
    } with {
      briefly "to cash service"
      described as {
        |Carries messages to the external CashService.
      }
    }
  } with {
      briefly "CashService integration"
    described as {
      |The model's side of the CashService conversation.
    }
  }
  adaptor FromClearinghouseService from context ClearinghouseService is {
    handler FromClearinghouseServiceHandler is {
      on event ClearinghouseService.ClearingAccepted is {
        do "the model receives clearing accepted"
      }
      on event ClearinghouseService.ClearingRejected is {
        do "the model receives clearing rejected"
      }
      on other is {
        error "Unexpected message for adaptor FromClearinghouseService"
      }
    } with {
      briefly "from clearinghouse service"
      described as {
        |Carries messages from the external ClearinghouseService.
      }
    }
  } with {
      briefly "ClearinghouseService integration"
    described as {
      |The model's side of the ClearinghouseService conversation.
    }
  }
  adaptor ToClearinghouseService to context ClearinghouseService is {
    handler ToClearinghouseServiceHandler is {
      on command ClearinghouseService.SubmitForClearing is {
        do "the model sends submit for clearing"
      }
      on other is {
        error "Unexpected message for adaptor ToClearinghouseService"
      }
    } with {
      briefly "to clearinghouse service"
      described as {
        |Carries messages to the external ClearinghouseService.
      }
    }
  } with {
      briefly "ClearinghouseService integration"
    described as {
      |The model's side of the ClearinghouseService conversation.
    }
  }
  adaptor FromCustodianService from context CustodianService is {
    handler FromCustodianServiceHandler is {
      on event CustodianService.InstructionAcknowledged is {
        do "the model receives instruction acknowledged"
      }
      on event CustodianService.SettlementExecuted is {
        do "the model receives settlement executed"
      }
      on event CustodianService.SettlementFailedAtCustodian is {
        do "the model receives settlement failed at custodian"
      }
      on other is {
        error "Unexpected message for adaptor FromCustodianService"
      }
    } with {
      briefly "from custodian service"
      described as {
        |Carries messages from the external CustodianService.
      }
    }
  } with {
      briefly "CustodianService integration"
    described as {
      |The model's side of the CustodianService conversation.
    }
  }
  adaptor ToCustodianService to context CustodianService is {
    handler ToCustodianServiceHandler is {
      on command CustodianService.SendSettlementInstruction is {
        do "the model sends send settlement instruction"
      }
      on other is {
        error "Unexpected message for adaptor ToCustodianService"
      }
    } with {
      briefly "to custodian service"
      described as {
        |Carries messages to the external CustodianService.
      }
    }
  } with {
      briefly "CustodianService integration"
    described as {
      |The model's side of the CustodianService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is {
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is {
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendSettlementNotification is {
        do "the model sends send settlement notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPositionService from context PositionService is {
    handler FromPositionServiceHandler is {
      on event PositionService.PositionUpdated is {
        do "the model receives position updated"
      }
      on other is {
        error "Unexpected message for adaptor FromPositionService"
      }
    } with {
      briefly "from position service"
      described as {
        |Carries messages from the external PositionService.
      }
    }
  } with {
      briefly "PositionService integration"
    described as {
      |The model's side of the PositionService conversation.
    }
  }
  adaptor ToPositionService to context PositionService is {
    handler ToPositionServiceHandler is {
      on command PositionService.UpdatePosition is {
        do "the model sends update position"
      }
      on other is {
        error "Unexpected message for adaptor ToPositionService"
      }
    } with {
      briefly "to position service"
      described as {
        |Carries messages to the external PositionService.
      }
    }
  } with {
      briefly "PositionService integration"
    described as {
      |The model's side of the PositionService conversation.
    }
  }
  adaptor FromTradeMatchingService from context TradeMatchingService is {
    handler FromTradeMatchingServiceHandler is {
      on event TradeMatchingService.NoMatchFound is {
        do "the model receives no match found"
      }
      on event TradeMatchingService.TradeMatchFound is {
        do "the model receives trade match found"
      }
      on other is {
        error "Unexpected message for adaptor FromTradeMatchingService"
      }
    } with {
      briefly "from trade matching service"
      described as {
        |Carries messages from the external TradeMatchingService.
      }
    }
  } with {
      briefly "TradeMatchingService integration"
    described as {
      |The model's side of the TradeMatchingService conversation.
    }
  }
  adaptor ToTradeMatchingService to context TradeMatchingService is {
    handler ToTradeMatchingServiceHandler is {
      on command TradeMatchingService.SubmitForMatching is {
        do "the model sends submit for matching"
      }
      on other is {
        error "Unexpected message for adaptor ToTradeMatchingService"
      }
    } with {
      briefly "to trade matching service"
      described as {
        |Carries messages to the external TradeMatchingService.
      }
    }
  } with {
      briefly "TradeMatchingService integration"
    described as {
      |The model's side of the TradeMatchingService conversation.
    }
  }
  include "types.riddl"
  include "Settlement.riddl"
  // Repository for settlement persistence
  repository SettlementRepository is {
    inlet SettlementRepositoryFromSettlement is type SettlementEvent
    inlet SettlementRepositoryFromSettlementAnalytics is type SettlementEvent
    outlet SettlementRepositoryResponses is type Settlement.SettlementResult
    record StoredSettlement is {
      settlementId: SettlementId with {
        briefly "settlementId"
        described as {
          |The settlementId column of the stored settlement row.
        }
      }
      trade: TradeDetails with {
        briefly "trade"
        described as {
          |The trade column of the stored settlement row.
        }
      }
    } with {
      briefly "Stored settlement row"
      described as {
        |The persistence shape of settlement data as this repository stores it.
      }
    }
    schema SettlementData is relational
      of settlements as type StoredSettlement
        index on field StoredSettlement.settlementId
        index on field StoredSettlement.trade.tradeId
      with {
      briefly "Settlement data schema"
      described as {
        |The relational schema holding settlement data for the SettlementRepository.
      }
    }

    handler SettlementPersistence is {
      on query GetSettlementStats is {
        do "read the settlement stats projection"
        yield result SettlementStatsView
      }
      on command Settlement.InitiateSettlement is {
        tell event Settlement.SettlementInitiated to entity
          SettlementContext.Settlement
      }
      on command Settlement.MatchTrade is {
        tell event Settlement.TradeMatched to entity
          SettlementContext.Settlement
      }
      on command Settlement.AffirmTrade is {
        tell event Settlement.TradeAffirmed to entity
          SettlementContext.Settlement
      }
      on command Settlement.SendInstructions is {
        tell event Settlement.InstructionsSent to entity
          SettlementContext.Settlement
      }
      on command Settlement.ConfirmSettlement is {
        tell event Settlement.SettlementConfirmed to entity
          SettlementContext.Settlement
      }
      on command Settlement.RecordPartialSettlement is {
        tell event Settlement.PartialSettlementRecorded to entity
          SettlementContext.Settlement
      }
      on command Settlement.FailSettlement is {
        tell event Settlement.SettlementFailed to entity
          SettlementContext.Settlement
      }
      on command Settlement.RetrySettlement is {
        tell event Settlement.SettlementRetried to entity
          SettlementContext.Settlement
      }
      on command Settlement.CancelSettlement is {
        tell event Settlement.SettlementCanceled to entity
          SettlementContext.Settlement
      }
      on command Settlement.HoldSettlement is {
        tell event Settlement.SettlementOnHold to entity
          SettlementContext.Settlement
      }
      on command Settlement.ReleaseHold is {
        tell event Settlement.HoldReleased to entity
          SettlementContext.Settlement
      }
    } with {
      briefly "Persists settlement commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Settlement data persistence"
    described as {
      | The SettlementRepository provides persistent storage for
      | trade settlements, instructions, and confirmations.
    }
  }
  // Projector for settlement analytics
  query GetSettlementStats is {
    settlementStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which settlement stats to retrieve.
      }
    }
  } with {
    briefly "Get settlement stats"
    described as {
      |Retrieves the settlement stats projection.
    }
  }
  result SettlementStatsView is {
    settlementStats: SettlementAnalytics.SettlementStats with {
      briefly "Settlement stats"
      described as {
        |The settlement stats being returned.
      }
    }
  } with {
    briefly "Settlement stats view"
    described as {
      |Read model view carrying the settlement stats projection.
    }
  }
  projector SettlementAnalytics is {
    inlet SettlementAnalyticsFromSettlement is type SettlementEvent
    outlet SettlementAnalyticsOut is type SettlementEvent
    updates repository SettlementContext.SettlementRepository
    record SettlementStats is  {
      totalSettlements: Natural with {
        briefly "Total"
        described as {
          |Total settlements.
        }
      }
      settledValue: Decimal(18,2) with {
        briefly "Value"
        described as {
          |Settled value.
        }
      }
      settlementRate: Decimal(5,4) with {
        briefly "Rate"
        described as {
          |Settlement success rate.
        }
      }
      avgSettlementTime: Duration with {
        briefly "Avg time"
        described as {
          |Average settlement time.
        }
      }
      failRate: Decimal(5,4) with {
        briefly "Fail rate"
        described as {
          |Failure rate.
        }
      }
      pendingValue: Decimal(18,2) with {
        briefly "Pending"
        described as {
          |Pending settlement value.
        }
      }
    } with {
      briefly "Settlement statistics"
      described as {
        |Settlement processing metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Settlement.SettlementInitiated is {
        tell event Settlement.SettlementInitiated to repository
          SettlementContext.SettlementRepository
      }
      on event Settlement.SettlementConfirmed is {
        tell event Settlement.SettlementConfirmed to repository
          SettlementContext.SettlementRepository
      }
      on event Settlement.SettlementFailed is {
        tell event Settlement.SettlementFailed to repository
          SettlementContext.SettlementRepository
      }
      on event Settlement.PartialSettlementRecorded is {
        tell event Settlement.PartialSettlementRecorded to repository
          SettlementContext.SettlementRepository
      }
    } with {
      briefly "Maintains settlement analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Settlement analytics projections"
    described as {
      |Maintains trade settlement analytics data.
    }
  }
  processor SettlementEventSource as source is {
    outlet SettlementEvents is type SettlementEvent
    handler SettlementEventEmitter is {
      on init is {
        tell command InitializeSettlement to entity
          SettlementContext.Settlement
      }
      on other is {
        error "Unexpected message for source SettlementEventSource"
      }
      on event Settlement.SettlementInitiated is {
        send event Settlement.SettlementInitiated to outlet SettlementEvents
      }
      on event Settlement.SettlementConfirmed is {
        send event Settlement.SettlementConfirmed to outlet SettlementEvents
      }
      on event Settlement.SettlementFailed is {
        send event Settlement.SettlementFailed to outlet SettlementEvents
      }
      on event Settlement.SettlementCanceled is {
        send event Settlement.SettlementCanceled to outlet SettlementEvents
      }
    } with {
      briefly "Settlement event emitter"
      described as {
        |Emits settlement lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Settlement event source"
    described as {
      |Publishes settlement entity events for streaming.
    }
  }
  processor SettlementEventSink as sink is {
    inlet IncomingSettlementEvents is type SettlementEvent
    handler SettlementEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink SettlementEventSink"
      }
      on event Settlement.SettlementInitiated is {
        tell event Settlement.SettlementInitiated to repository
          SettlementContext.SettlementRepository
      }
      on event Settlement.SettlementConfirmed is {
        tell event Settlement.SettlementConfirmed to repository
          SettlementContext.SettlementRepository
      }
    } with {
      briefly "Settlement event receiver"
      described as {
        |Receives settlement events and persists them.
      }
    }
  } with {
    briefly "Settlement event sink"
    described as {
      |Receives settlement events from the streaming topology.
    }
  }
  connector SettlementEventPipeline is {
    from outlet SettlementContext.SettlementEventSource.SettlementEvents
      to inlet SettlementContext.SettlementEventSink.IncomingSettlementEvents
  } with {
    briefly "Settlement event pipeline"
    described as {
      |Wires settlement events from source to sink.
    }
  }
  processor SettlementEventSplit is {
    inlet SettlementEventSplitIn is type SettlementEvent
    outlet SettlementEventSplitToSettlementRepository is type SettlementEvent
    outlet SettlementEventSplitToSettlementAnalytics is type SettlementEvent
    handler SettlementEventSplitHandler is {
      on event Settlement.SettlementInitiated is {
        send event Settlement.SettlementInitiated to outlet SettlementEventSplitToSettlementRepository
        send event Settlement.SettlementInitiated to outlet SettlementEventSplitToSettlementAnalytics
        tell event Settlement.SettlementInitiated to entity SettlementContext.Settlement
      }
      on event Settlement.TradeMatched is {
        send event Settlement.TradeMatched to outlet SettlementEventSplitToSettlementRepository
        send event Settlement.TradeMatched to outlet SettlementEventSplitToSettlementAnalytics
        tell event Settlement.TradeMatched to entity SettlementContext.Settlement
      }
      on event Settlement.TradeAffirmed is {
        send event Settlement.TradeAffirmed to outlet SettlementEventSplitToSettlementRepository
        send event Settlement.TradeAffirmed to outlet SettlementEventSplitToSettlementAnalytics
        tell event Settlement.TradeAffirmed to entity SettlementContext.Settlement
      }
      on event Settlement.InstructionsSent is {
        send event Settlement.InstructionsSent to outlet SettlementEventSplitToSettlementRepository
        send event Settlement.InstructionsSent to outlet SettlementEventSplitToSettlementAnalytics
        tell event Settlement.InstructionsSent to entity SettlementContext.Settlement
      }
      on event Settlement.SettlementConfirmed is {
        send event Settlement.SettlementConfirmed to outlet SettlementEventSplitToSettlementRepository
        send event Settlement.SettlementConfirmed to outlet SettlementEventSplitToSettlementAnalytics
        tell event Settlement.SettlementConfirmed to entity SettlementContext.Settlement
      }
      on event Settlement.PartialSettlementRecorded is {
        send event Settlement.PartialSettlementRecorded to outlet SettlementEventSplitToSettlementRepository
        send event Settlement.PartialSettlementRecorded to outlet SettlementEventSplitToSettlementAnalytics
        tell event Settlement.PartialSettlementRecorded to entity SettlementContext.Settlement
      }
      on event Settlement.SettlementFailed is {
        send event Settlement.SettlementFailed to outlet SettlementEventSplitToSettlementRepository
        send event Settlement.SettlementFailed to outlet SettlementEventSplitToSettlementAnalytics
        tell event Settlement.SettlementFailed to entity SettlementContext.Settlement
      }
      on event Settlement.SettlementRetried is {
        send event Settlement.SettlementRetried to outlet SettlementEventSplitToSettlementRepository
        send event Settlement.SettlementRetried to outlet SettlementEventSplitToSettlementAnalytics
        tell event Settlement.SettlementRetried to entity SettlementContext.Settlement
      }
      on event Settlement.SettlementCanceled is {
        send event Settlement.SettlementCanceled to outlet SettlementEventSplitToSettlementRepository
        send event Settlement.SettlementCanceled to outlet SettlementEventSplitToSettlementAnalytics
        tell event Settlement.SettlementCanceled to entity SettlementContext.Settlement
      }
      on event Settlement.SettlementOnHold is {
        send event Settlement.SettlementOnHold to outlet SettlementEventSplitToSettlementRepository
        send event Settlement.SettlementOnHold to outlet SettlementEventSplitToSettlementAnalytics
        tell event Settlement.SettlementOnHold to entity SettlementContext.Settlement
      }
      on event Settlement.HoldReleased is {
        send event Settlement.HoldReleased to outlet SettlementEventSplitToSettlementRepository
        send event Settlement.HoldReleased to outlet SettlementEventSplitToSettlementAnalytics
        tell event Settlement.HoldReleased to entity SettlementContext.Settlement
      }
      on other is {
        error "Unexpected message for processor SettlementEventSplit"
      }
    } with {
      briefly "Settlement event fan-out handler"
      described as {
        |Delivers each Settlement event to all of its consumers.
      }
    }
  } with {
    briefly "Settlement event fan-out"
    described as {
      |Fans Settlement events out to the repository and projectors.
    }
  }
  connector LinkSettlementToSettlementEventSplit is {
    from outlet SettlementContext.Settlement.SettlementEvents2 to
      inlet SettlementContext.SettlementEventSplit.SettlementEventSplitIn
  } with {
    briefly "LinkSettlementToSettlementEventSplit"
  }
  connector LinkSettlementEventSplitToSettlementRepository is {
    from outlet SettlementContext.SettlementEventSplit.SettlementEventSplitToSettlementRepository to
      inlet SettlementContext.SettlementRepository.SettlementRepositoryFromSettlement
  } with {
    briefly "LinkSettlementEventSplitToSettlementRepository"
  }
  connector LinkSettlementEventSplitToSettlementAnalytics is {
    from outlet SettlementContext.SettlementEventSplit.SettlementEventSplitToSettlementAnalytics to
      inlet SettlementContext.SettlementAnalytics.SettlementAnalyticsFromSettlement
  } with {
    briefly "LinkSettlementEventSplitToSettlementAnalytics"
  }
  connector LinkSettlementAnalyticsToSettlementRepository is {
    from outlet SettlementContext.SettlementAnalytics.SettlementAnalyticsOut to
      inlet SettlementContext.SettlementRepository.SettlementRepositoryFromSettlementAnalytics
  } with {
    briefly "LinkSettlementAnalyticsToSettlementRepository"
  }
} with {
  briefly "Bounded context for trade settlement"
  described as {
    | The SettlementContext is the bounded context for
    | post-trade clearing and settlement processing.
  }
}
