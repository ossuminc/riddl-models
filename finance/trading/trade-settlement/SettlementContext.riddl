// Trade Settlement - Settlement Context
context SettlementContext as router is {
  inlet SettlementCommandStreamIn is type SettlementCommand
  outlet SettlementCommandStreamOut is type SettlementCommand
  inlet SettlementResultStreamIn is type Settlement.SettlementResult
  outlet SettlementResultStreamOut is type Settlement.SettlementResult
  handler SettlementContextBoundary is {
    on initiateSettlement: command Settlement.InitiateSettlement is {
      send initiateSettlement to outlet SettlementContext.SettlementCommandStreamOut
    }
    on matchTrade: command Settlement.MatchTrade is {
      send matchTrade to outlet SettlementContext.SettlementCommandStreamOut
    }
    on affirmTrade: command Settlement.AffirmTrade is {
      send affirmTrade to outlet SettlementContext.SettlementCommandStreamOut
    }
    on sendInstructions: command Settlement.SendInstructions is {
      send sendInstructions to outlet SettlementContext.SettlementCommandStreamOut
    }
    on confirmSettlement: command Settlement.ConfirmSettlement is {
      send confirmSettlement to outlet SettlementContext.SettlementCommandStreamOut
    }
    on recordPartialSettlement: command Settlement.RecordPartialSettlement is {
      send recordPartialSettlement to outlet SettlementContext.SettlementCommandStreamOut
    }
    on failSettlement: command Settlement.FailSettlement is {
      send failSettlement to outlet SettlementContext.SettlementCommandStreamOut
    }
    on retrySettlement: command Settlement.RetrySettlement is {
      send retrySettlement to outlet SettlementContext.SettlementCommandStreamOut
    }
    on cancelSettlement: command Settlement.CancelSettlement is {
      send cancelSettlement to outlet SettlementContext.SettlementCommandStreamOut
    }
    on holdSettlement: command Settlement.HoldSettlement is {
      send holdSettlement to outlet SettlementContext.SettlementCommandStreamOut
    }
    on releaseHold: command Settlement.ReleaseHold is {
      send releaseHold to outlet SettlementContext.SettlementCommandStreamOut
    }
    on initializeSettlement: command Settlement.InitializeSettlement is {
      send initializeSettlement to outlet SettlementContext.SettlementCommandStreamOut
    }
    on settlementResult: result Settlement.SettlementResult is {
      send settlementResult to outlet SettlementContext.SettlementResultStreamOut
    }
    on other is {
      error "Unexpected message at the SettlementContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'SettlementCommand Stream Intake' is from outlet SettlementContext.SettlementCommandStreamOut to inlet SettlementContext.Settlement.SettlementCommands
  connector 'SettlementResult Stream Egress' is from outlet SettlementContext.SettlementRepository.SettlementRepositoryResponses to inlet SettlementContext.SettlementResultStreamIn
  adaptor FromCashService from context CashService is { 
    handler FromCashServiceHandler is {
      on event CashService.CashBalanceUpdated is {
        do "the model receives cash balance updated"
      }
      on other is {
        error "Unexpected message for adaptor FromCashService"
      }
    } with {
      briefly "from cash service"
      described as {
        |Carries messages from the external CashService.
      }
    }
  } with {
    briefly "CashService integration"
    described as {
      |The model's side of the CashService conversation.
    }
  }
  adaptor ToCashService to context CashService is { 
    handler ToCashServiceHandler is {
      on command CashService.UpdateCashBalance is {
        do "the model sends update cash balance"
      }
      on other is {
        error "Unexpected message for adaptor ToCashService"
      }
    } with {
      briefly "to cash service"
      described as {
        |Carries messages to the external CashService.
      }
    }
  } with {
    briefly "CashService integration"
    described as {
      |The model's side of the CashService conversation.
    }
  }
  adaptor FromClearinghouseService from context ClearinghouseService is { 
    handler FromClearinghouseServiceHandler is {
      on event ClearinghouseService.ClearingAccepted is {
        do "the model receives clearing accepted"
      }
      on event ClearinghouseService.ClearingRejected is {
        do "the model receives clearing rejected"
      }
      on other is {
        error "Unexpected message for adaptor FromClearinghouseService"
      }
    } with {
      briefly "from clearinghouse service"
      described as {
        |Carries messages from the external ClearinghouseService.
      }
    }
  } with {
    briefly "ClearinghouseService integration"
    described as {
      |The model's side of the ClearinghouseService conversation.
    }
  }
  adaptor ToClearinghouseService to context ClearinghouseService is { 
    handler ToClearinghouseServiceHandler is {
      on command ClearinghouseService.SubmitForClearing is {
        do "the model sends submit for clearing"
      }
      on other is {
        error "Unexpected message for adaptor ToClearinghouseService"
      }
    } with {
      briefly "to clearinghouse service"
      described as {
        |Carries messages to the external ClearinghouseService.
      }
    }
  } with {
    briefly "ClearinghouseService integration"
    described as {
      |The model's side of the ClearinghouseService conversation.
    }
  }
  adaptor FromCustodianService from context CustodianService is { 
    handler FromCustodianServiceHandler is {
      on event CustodianService.InstructionAcknowledged is {
        do "the model receives instruction acknowledged"
      }
      on event CustodianService.SettlementExecuted is {
        do "the model receives settlement executed"
      }
      on event CustodianService.SettlementFailedAtCustodian is {
        do "the model receives settlement failed at custodian"
      }
      on other is {
        error "Unexpected message for adaptor FromCustodianService"
      }
    } with {
      briefly "from custodian service"
      described as {
        |Carries messages from the external CustodianService.
      }
    }
  } with {
    briefly "CustodianService integration"
    described as {
      |The model's side of the CustodianService conversation.
    }
  }
  adaptor ToCustodianService to context CustodianService is { 
    handler ToCustodianServiceHandler is {
      on command CustodianService.SendSettlementInstruction is {
        do "the model sends send settlement instruction"
      }
      on other is {
        error "Unexpected message for adaptor ToCustodianService"
      }
    } with {
      briefly "to custodian service"
      described as {
        |Carries messages to the external CustodianService.
      }
    }
  } with {
    briefly "CustodianService integration"
    described as {
      |The model's side of the CustodianService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendSettlementNotification is {
        do "the model sends send settlement notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPositionService from context PositionService is { 
    handler FromPositionServiceHandler is {
      on event PositionService.PositionUpdated is {
        do "the model receives position updated"
      }
      on other is {
        error "Unexpected message for adaptor FromPositionService"
      }
    } with {
      briefly "from position service"
      described as {
        |Carries messages from the external PositionService.
      }
    }
  } with {
    briefly "PositionService integration"
    described as {
      |The model's side of the PositionService conversation.
    }
  }
  adaptor ToPositionService to context PositionService is { 
    handler ToPositionServiceHandler is {
      on command PositionService.UpdatePosition is {
        do "the model sends update position"
      }
      on other is {
        error "Unexpected message for adaptor ToPositionService"
      }
    } with {
      briefly "to position service"
      described as {
        |Carries messages to the external PositionService.
      }
    }
  } with {
    briefly "PositionService integration"
    described as {
      |The model's side of the PositionService conversation.
    }
  }
  adaptor FromTradeMatchingService from context TradeMatchingService is { 
    handler FromTradeMatchingServiceHandler is {
      on event TradeMatchingService.NoMatchFound is {
        do "the model receives no match found"
      }
      on event TradeMatchingService.TradeMatchFound is {
        do "the model receives trade match found"
      }
      on other is {
        error "Unexpected message for adaptor FromTradeMatchingService"
      }
    } with {
      briefly "from trade matching service"
      described as {
        |Carries messages from the external TradeMatchingService.
      }
    }
  } with {
    briefly "TradeMatchingService integration"
    described as {
      |The model's side of the TradeMatchingService conversation.
    }
  }
  adaptor ToTradeMatchingService to context TradeMatchingService is { 
    handler ToTradeMatchingServiceHandler is {
      on command TradeMatchingService.SubmitForMatching is {
        do "the model sends submit for matching"
      }
      on other is {
        error "Unexpected message for adaptor ToTradeMatchingService"
      }
    } with {
      briefly "to trade matching service"
      described as {
        |Carries messages to the external TradeMatchingService.
      }
    }
  } with {
    briefly "TradeMatchingService integration"
    described as {
      |The model's side of the TradeMatchingService conversation.
    }
  }
  include "types.riddl"
  include "Settlement.riddl"
  // Repository for settlement persistence
  repository SettlementRepository as merge is {
    command PersistPartialSettlementRecorded is {
      settlementId: SettlementId with {
        briefly "Row addressed"
        described as {
          |Which stored row PartialSettlementRecorded applies to.
        }
      }
    } with {
      briefly "Persist PartialSettlementRecorded"
      described as {
        |Instructs this repository to apply PartialSettlementRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSettlementConfirmed is {
      settlementId: SettlementId with {
        briefly "Row addressed"
        described as {
          |Which stored row SettlementConfirmed applies to.
        }
      }
    } with {
      briefly "Persist SettlementConfirmed"
      described as {
        |Instructs this repository to apply SettlementConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSettlementFailed is {
      settlementId: SettlementId with {
        briefly "Row addressed"
        described as {
          |Which stored row SettlementFailed applies to.
        }
      }
    } with {
      briefly "Persist SettlementFailed"
      described as {
        |Instructs this repository to apply SettlementFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSettlementInitiated is {
      settlementId: SettlementId with {
        briefly "Row addressed"
        described as {
          |Which stored row SettlementInitiated applies to.
        }
      }
    } with {
      briefly "Persist SettlementInitiated"
      described as {
        |Instructs this repository to apply SettlementInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet SettlementRepositoryFromSettlement is type SettlementEvent    inlet SettlementRepositoryFromSettlementAnalytics is type SettlementEvent    outlet SettlementRepositoryResponses is type Settlement.SettlementResult
    record StoredSettlement is  {
      settlementId: SettlementId with {
        briefly "settlementId"
        described as {
          |The settlementId column of the stored settlement row.
        }
      }
      trade: TradeDetails with {
        briefly "trade"
        described as {
          |The trade column of the stored settlement row.
        }
      }
    } with {
      briefly "Stored settlement row"
      described as {
        |The persistence shape of settlement data as this repository stores it.
      }
    }
    schema SettlementData is relational
      of settlements as type StoredSettlement
        index on field StoredSettlement.settlementId
        index on field StoredSettlement.trade.tradeId
 with {
      briefly "Settlement data schema"
      described as {
        |The relational schema holding settlement data for the SettlementRepository.
      }
    }
    handler SettlementPersistence is {
      on persistPartialSettlementRecorded: command PersistPartialSettlementRecorded is {
        do "apply PartialSettlementRecorded to the stored row"
      }
      on persistSettlementConfirmed: command PersistSettlementConfirmed is {
        do "apply SettlementConfirmed to the stored row"
      }
      on persistSettlementFailed: command PersistSettlementFailed is {
        do "apply SettlementFailed to the stored row"
      }
      on persistSettlementInitiated: command PersistSettlementInitiated is {
        do "apply SettlementInitiated to the stored row"
      }
      on query GetSettlementStats is {
        let settlementStatsView: type SettlementStatsView = prompt("read the settlement stats projection")
        reply settlementStatsView
      }
      on initiateSettlement: command Settlement.InitiateSettlement is {
        tell event Settlement.SettlementInitiated(settlementId = initiateSettlement.settlementId, trade = initiateSettlement.trade) to entity SettlementContext.Settlement
      }
      on matchTrade: command Settlement.MatchTrade is {
        tell event Settlement.TradeMatched(settlementId = matchTrade.settlementId, matching = matchTrade.matching) to entity SettlementContext.Settlement
      }
      on affirmTrade: command Settlement.AffirmTrade is {
        tell event Settlement.TradeAffirmed(settlementId = affirmTrade.settlementId, affirmedBy = affirmTrade.affirmedBy) to entity SettlementContext.Settlement
      }
      on sendInstructions: command Settlement.SendInstructions is {
        tell event Settlement.InstructionsSent(settlementId = sendInstructions.settlementId, instructions = sendInstructions.instructions) to entity SettlementContext.Settlement
      }
      on confirmSettlement: command Settlement.ConfirmSettlement is {
        tell event Settlement.SettlementConfirmed(settlementId = confirmSettlement.settlementId, confirmation = confirmSettlement.confirmation) to entity SettlementContext.Settlement
      }
      on recordPartialSettlement: command Settlement.RecordPartialSettlement is {
        tell event Settlement.PartialSettlementRecorded(settlementId = recordPartialSettlement.settlementId, partialConfirmation = recordPartialSettlement.partialConfirmation) to entity SettlementContext.Settlement
      }
      on failSettlement: command Settlement.FailSettlement is {
        tell event Settlement.SettlementFailed(settlementId = failSettlement.settlementId, failure = failSettlement.failure) to entity SettlementContext.Settlement
      }
      on retrySettlement: command Settlement.RetrySettlement is {
        tell event Settlement.SettlementRetried(settlementId = retrySettlement.settlementId, newSettlementDate = retrySettlement.newSettlementDate) to entity SettlementContext.Settlement
      }
      on cancelSettlement: command Settlement.CancelSettlement is {
        tell event Settlement.SettlementCanceled(settlementId = cancelSettlement.settlementId, reason = cancelSettlement.reason) to entity SettlementContext.Settlement
      }
      on holdSettlement: command Settlement.HoldSettlement is {
        tell event Settlement.SettlementOnHold(settlementId = holdSettlement.settlementId, reason = holdSettlement.reason) to entity SettlementContext.Settlement
      }
      on releaseHold: command Settlement.ReleaseHold is {
        tell event Settlement.HoldReleased(settlementId = releaseHold.settlementId) to entity SettlementContext.Settlement
      }
    } with {
      briefly "Persists settlement commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Settlement data persistence"
    described as {
      | The SettlementRepository provides persistent storage for
      | trade settlements, instructions, and confirmations.
    }
  }
  // Projector for settlement analytics
  query GetSettlementStats is  {
    settlementStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which settlement stats to retrieve.
      }
    }
  } with {
    briefly "Get settlement stats"
    described as {
      |Retrieves the settlement stats projection.
    }
  }
  result SettlementStatsView is  {
    settlementStats: SettlementAnalytics.SettlementStats with {
      briefly "Settlement stats"
      described as {
        |The settlement stats being returned.
      }
    }
  } with {
    briefly "Settlement stats view"
    described as {
      |Read model view carrying the settlement stats projection.
    }
  }
  projector SettlementAnalytics as flow is {
    updates repository SettlementContext.SettlementRepository
    inlet SettlementAnalyticsFromSettlement is type SettlementEvent    outlet SettlementAnalyticsOut is type SettlementEvent
    record SettlementStats is  {
      totalSettlements: Natural with {
        briefly "Total"
        described as {
          |Total settlements.
        }
      }
      settledValue: Decimal(18,2) with {
        briefly "Value"
        described as {
          |Settled value.
        }
      }
      settlementRate: Decimal(5,4) with {
        briefly "Rate"
        described as {
          |Settlement success rate.
        }
      }
      avgSettlementTime: Duration with {
        briefly "Avg time"
        described as {
          |Average settlement time.
        }
      }
      failRate: Decimal(5,4) with {
        briefly "Fail rate"
        described as {
          |Failure rate.
        }
      }
      pendingValue: Decimal(18,2) with {
        briefly "Pending"
        described as {
          |Pending settlement value.
        }
      }
    } with {
      briefly "Settlement statistics"
      described as {
        |Settlement processing metrics.
      }
    }
    handler AnalyticsHandler is {
      on settlementInitiated: event Settlement.SettlementInitiated is {
        tell command SettlementContext.SettlementRepository.PersistSettlementInitiated(settlementId = settlementInitiated.settlementId) to repository SettlementContext.SettlementRepository
      }
      on settlementConfirmed: event Settlement.SettlementConfirmed is {
        tell command SettlementContext.SettlementRepository.PersistSettlementConfirmed(settlementId = settlementConfirmed.settlementId) to repository SettlementContext.SettlementRepository
      }
      on settlementFailed: event Settlement.SettlementFailed is {
        tell command SettlementContext.SettlementRepository.PersistSettlementFailed(settlementId = settlementFailed.settlementId) to repository SettlementContext.SettlementRepository
      }
      on partialSettlementRecorded: event Settlement.PartialSettlementRecorded is {
        tell command SettlementContext.SettlementRepository.PersistPartialSettlementRecorded(settlementId = partialSettlementRecorded.settlementId) to repository SettlementContext.SettlementRepository
      }
    } with {
      briefly "Maintains settlement analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Settlement analytics projections"
    described as {
      |Maintains trade settlement analytics data.
    }
  }
  processor SettlementEventSource as source is {
    outlet SettlementEvents is type SettlementEvent
    handler SettlementEventEmitter is {
      on init is {
        let initializeSettlement: type InitializeSettlement = prompt("the initialize settlement that brings this this into existence")
        tell initializeSettlement to entity SettlementContext.Settlement
      }
      on other is {
        error "Unexpected message for source SettlementEventSource"
      }
      on settlementInitiated: event Settlement.SettlementInitiated is {
        send settlementInitiated to outlet SettlementEvents
      }
      on settlementConfirmed: event Settlement.SettlementConfirmed is {
        send settlementConfirmed to outlet SettlementEvents
      }
      on settlementFailed: event Settlement.SettlementFailed is {
        send settlementFailed to outlet SettlementEvents
      }
      on settlementCanceled: event Settlement.SettlementCanceled is {
        send settlementCanceled to outlet SettlementEvents
      }
    } with {
      briefly "Settlement event emitter"
      described as {
        |Emits settlement lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Settlement event source"
    described as {
      |Publishes settlement entity events for streaming.
    }
  }
  processor SettlementEventSink as sink is {
    inlet IncomingSettlementEvents is type SettlementEvent    handler SettlementEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink SettlementEventSink"
      }
      on settlementInitiated: event Settlement.SettlementInitiated is {
        tell settlementInitiated to repository SettlementContext.SettlementRepository
      }
      on settlementConfirmed: event Settlement.SettlementConfirmed is {
        tell settlementConfirmed to repository SettlementContext.SettlementRepository
      }
    } with {
      briefly "Settlement event receiver"
      described as {
        |Receives settlement events and persists them.
      }
    }
  } with {
    briefly "Settlement event sink"
    described as {
      |Receives settlement events from the streaming topology.
    }
  }
  connector SettlementEventPipeline is from outlet SettlementContext.SettlementEventSource.SettlementEvents to inlet SettlementContext.SettlementEventSink.IncomingSettlementEvents with {
    briefly "Settlement event pipeline"
    described as {
      |Wires settlement events from source to sink.
    }
  }
  processor SettlementEventSplit as split is {
    inlet SettlementEventSplitIn is type SettlementEvent    outlet SettlementEventSplitToSettlementRepository is type SettlementEvent
    outlet SettlementEventSplitToSettlementAnalytics is type SettlementEvent
    handler SettlementEventSplitHandler is {
      on settlementInitiated: event Settlement.SettlementInitiated is {
        send settlementInitiated to outlet SettlementEventSplitToSettlementRepository
        send settlementInitiated to outlet SettlementEventSplitToSettlementAnalytics
        tell settlementInitiated to entity SettlementContext.Settlement
      }
      on tradeMatched: event Settlement.TradeMatched is {
        send tradeMatched to outlet SettlementEventSplitToSettlementRepository
        send tradeMatched to outlet SettlementEventSplitToSettlementAnalytics
        tell tradeMatched to entity SettlementContext.Settlement
      }
      on tradeAffirmed: event Settlement.TradeAffirmed is {
        send tradeAffirmed to outlet SettlementEventSplitToSettlementRepository
        send tradeAffirmed to outlet SettlementEventSplitToSettlementAnalytics
        tell tradeAffirmed to entity SettlementContext.Settlement
      }
      on instructionsSent: event Settlement.InstructionsSent is {
        send instructionsSent to outlet SettlementEventSplitToSettlementRepository
        send instructionsSent to outlet SettlementEventSplitToSettlementAnalytics
        tell instructionsSent to entity SettlementContext.Settlement
      }
      on settlementConfirmed: event Settlement.SettlementConfirmed is {
        send settlementConfirmed to outlet SettlementEventSplitToSettlementRepository
        send settlementConfirmed to outlet SettlementEventSplitToSettlementAnalytics
        tell settlementConfirmed to entity SettlementContext.Settlement
      }
      on partialSettlementRecorded: event Settlement.PartialSettlementRecorded is {
        send partialSettlementRecorded to outlet SettlementEventSplitToSettlementRepository
        send partialSettlementRecorded to outlet SettlementEventSplitToSettlementAnalytics
        tell partialSettlementRecorded to entity SettlementContext.Settlement
      }
      on settlementFailed: event Settlement.SettlementFailed is {
        send settlementFailed to outlet SettlementEventSplitToSettlementRepository
        send settlementFailed to outlet SettlementEventSplitToSettlementAnalytics
        tell settlementFailed to entity SettlementContext.Settlement
      }
      on settlementRetried: event Settlement.SettlementRetried is {
        send settlementRetried to outlet SettlementEventSplitToSettlementRepository
        send settlementRetried to outlet SettlementEventSplitToSettlementAnalytics
        tell settlementRetried to entity SettlementContext.Settlement
      }
      on settlementCanceled: event Settlement.SettlementCanceled is {
        send settlementCanceled to outlet SettlementEventSplitToSettlementRepository
        send settlementCanceled to outlet SettlementEventSplitToSettlementAnalytics
        tell settlementCanceled to entity SettlementContext.Settlement
      }
      on settlementOnHold: event Settlement.SettlementOnHold is {
        send settlementOnHold to outlet SettlementEventSplitToSettlementRepository
        send settlementOnHold to outlet SettlementEventSplitToSettlementAnalytics
        tell settlementOnHold to entity SettlementContext.Settlement
      }
      on holdReleased: event Settlement.HoldReleased is {
        send holdReleased to outlet SettlementEventSplitToSettlementRepository
        send holdReleased to outlet SettlementEventSplitToSettlementAnalytics
        tell holdReleased to entity SettlementContext.Settlement
      }
      on other is {
        error "Unexpected message for processor SettlementEventSplit"
      }
    } with {
      briefly "Settlement event fan-out handler"
      described as {
        |Delivers each Settlement event to all of its consumers.
      }
    }
  } with {
    briefly "Settlement event fan-out"
    described as {
      |Fans Settlement events out to the repository and projectors.
    }
  }
  connector 'SettlementEvent Stream' is from outlet SettlementContext.Settlement.SettlementEvents2 to inlet SettlementContext.SettlementEventSplit.SettlementEventSplitIn with {
    briefly "Settlement events, fanned out to storage and read models"
  }
  connector 'SettlementEvent Storage' is from outlet SettlementContext.SettlementEventSplit.SettlementEventSplitToSettlementRepository to inlet SettlementContext.SettlementRepository.SettlementRepositoryFromSettlement with {
    briefly "Settlement events on their way to storage"
  }
  connector 'SettlementAnalytics Feed' is from outlet SettlementContext.SettlementEventSplit.SettlementEventSplitToSettlementAnalytics to inlet SettlementContext.SettlementAnalytics.SettlementAnalyticsFromSettlement with {
    briefly "Settlement events feeding the SettlementAnalytics projection"
  }
  connector 'SettlementAnalytics Storage' is from outlet SettlementContext.SettlementAnalytics.SettlementAnalyticsOut to inlet SettlementContext.SettlementRepository.SettlementRepositoryFromSettlementAnalytics with {
    briefly "The SettlementAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for trade settlement"
  described as {
    | The SettlementContext is the bounded context for
    | post-trade clearing and settlement processing.
  }
}
