// Trade Settlement - Settlement Entity
entity Settlement as flow is {
  type SettlementCommand is one of {
    Settlement.InitiateSettlement or Settlement.MatchTrade or Settlement.AffirmTrade or Settlement.SendInstructions or Settlement.ConfirmSettlement or Settlement.RecordPartialSettlement or Settlement.FailSettlement or Settlement.RetrySettlement or Settlement.CancelSettlement or Settlement.HoldSettlement or Settlement.ReleaseHold
  } with {
    briefly "Settlement command alternation"
    described as {
      |Commands accepted by the Settlement entity.
    }
  }
  inlet SettlementCommands is type SettlementCommand  outlet SettlementEvents2 is type SettlementEvent
  // Commands
  command InitiateSettlement is  {
    settlementId: SettlementId with {
      briefly "Settlement ID"
      described as {
        |New settlement identifier.
      }
    }
    trade: TradeDetails with {
      briefly "Trade"
      described as {
        |Trade to settle.
      }
    }
  } with {
    briefly "Initiate settlement"
    described as {
      |Initiates trade settlement.
    }
  }
  command MatchTrade is  {
    settlementId: SettlementId with {
      briefly "Settlement ID"
      described as {
        |Settlement identifier.
      }
    }
    matching: MatchingInfo with {
      briefly "Matching"
      described as {
        |Matching information.
      }
    }
  } with {
    briefly "Match trade"
    described as {
      |Records trade match with counterparty.
    }
  }
  command AffirmTrade is  {
    settlementId: SettlementId with {
      briefly "Settlement ID"
      described as {
        |Settlement identifier.
      }
    }
    affirmedBy: CounterpartyId with {
      briefly "Affirmed by"
      described as {
        |Affirming counterparty.
      }
    }
  } with {
    briefly "Affirm trade"
    described as {
      |Counterparty affirms trade details.
    }
  }
  command SendInstructions is  {
    settlementId: SettlementId with {
      briefly "Settlement ID"
      described as {
        |Settlement identifier.
      }
    }
    instructions: SettlementInstruction+ with {
      briefly "Instructions"
      described as {
        |Settlement instructions.
      }
    }
  } with {
    briefly "Send instructions"
    described as {
      |Sends settlement instructions to custodian.
    }
  }
  command ConfirmSettlement is  {
    settlementId: SettlementId with {
      briefly "Settlement ID"
      described as {
        |Settlement identifier.
      }
    }
    confirmation: SettlementConfirmation with {
      briefly "Confirmation"
      described as {
        |Settlement confirmation.
      }
    }
  } with {
    briefly "Confirm settlement"
    described as {
      |Confirms successful settlement.
    }
  }
  command RecordPartialSettlement is  {
    settlementId: SettlementId with {
      briefly "Settlement ID"
      described as {
        |Settlement identifier.
      }
    }
    partialConfirmation: SettlementConfirmation with {
      briefly "Partial"
      described as {
        |Partial settlement details.
      }
    }
  } with {
    briefly "Record partial"
    described as {
      |Records partial settlement.
    }
  }
  command FailSettlement is  {
    settlementId: SettlementId with {
      briefly "Settlement ID"
      described as {
        |Settlement identifier.
      }
    }
    failure: FailureInfo with {
      briefly "Failure"
      described as {
        |Failure details.
      }
    }
  } with {
    briefly "Fail settlement"
    described as {
      |Records settlement failure.
    }
  }
  command RetrySettlement is  {
    settlementId: SettlementId with {
      briefly "Settlement ID"
      described as {
        |Settlement identifier.
      }
    }
    newSettlementDate: Date with {
      briefly "New date"
      described as {
        |New settlement date.
      }
    }
  } with {
    briefly "Retry settlement"
    described as {
      |Retries failed settlement.
    }
  }
  command CancelSettlement is  {
    settlementId: SettlementId with {
      briefly "Settlement ID"
      described as {
        |Settlement identifier.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
  } with {
    briefly "Cancel settlement"
    described as {
      |Cancels pending settlement.
    }
  }
  command HoldSettlement is  {
    settlementId: SettlementId with {
      briefly "Settlement ID"
      described as {
        |Settlement identifier.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Hold reason.
      }
    }
  } with {
    briefly "Hold settlement"
    described as {
      |Places settlement on hold.
    }
  }
  command ReleaseHold is  {
    settlementId: SettlementId with {
      briefly "Settlement ID"
      described as {
        |Settlement identifier.
      }
    }
  } with {
    briefly "Release hold"
    described as {
      |Releases held settlement.
    }
  }
  // Events
  event SettlementInitiated is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    trade: TradeDetails with {
      briefly "Trade"
      described as {
        |Trade details.
      }
    }
    initiatedAt: TimeStamp with {
      briefly "Initiated"
      described as {
        |Initiation time.
      }
    }
  } with {
    briefly "Settlement initiated"
    described as {
      |Emitted when settlement begins.
    }
  }
  event TradeMatched is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    matching: MatchingInfo with {
      briefly "Matching"
      described as {
        |Match details.
      }
    }
  } with {
    briefly "Trade matched"
    described as {
      |Emitted when trade is matched.
    }
  }
  event TradeAffirmed is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    affirmedBy: CounterpartyId with {
      briefly "Affirmed by"
      described as {
        |Affirming party.
      }
    }
    affirmedAt: TimeStamp with {
      briefly "Affirmed"
      described as {
        |Affirmation time.
      }
    }
  } with {
    briefly "Trade affirmed"
    described as {
      |Emitted when counterparty affirms.
    }
  }
  event InstructionsSent is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    instructions: SettlementInstruction+ with {
      briefly "Instructions"
      described as {
        |Sent instructions.
      }
    }
    sentAt: TimeStamp with {
      briefly "Sent"
      described as {
        |Send time.
      }
    }
  } with {
    briefly "Instructions sent"
    described as {
      |Emitted when instructions are sent.
    }
  }
  event SettlementConfirmed is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    confirmation: SettlementConfirmation with {
      briefly "Confirmation"
      described as {
        |Confirmation details.
      }
    }
  } with {
    briefly "Settlement confirmed"
    described as {
      |Emitted when settlement completes.
    }
  }
  event PartialSettlementRecorded is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    partialConfirmation: SettlementConfirmation with {
      briefly "Partial"
      described as {
        |Partial details.
      }
    }
    remainingQuantity: Natural with {
      briefly "Remaining"
      described as {
        |Unsettled quantity.
      }
    }
    remainingAmount: Decimal(15,2) with {
      briefly "Amount"
      described as {
        |Unsettled amount.
      }
    }
  } with {
    briefly "Partial settlement"
    described as {
      |Emitted when partial settlement occurs.
    }
  }
  event SettlementFailed is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    failure: FailureInfo with {
      briefly "Failure"
      described as {
        |Failure info.
      }
    }
  } with {
    briefly "Settlement failed"
    described as {
      |Emitted when settlement fails.
    }
  }
  event SettlementRetried is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    newSettlementDate: Date with {
      briefly "New date"
      described as {
        |New settlement date.
      }
    }
    retriedAt: TimeStamp with {
      briefly "Retried"
      described as {
        |Retry time.
      }
    }
  } with {
    briefly "Settlement retried"
    described as {
      |Emitted when settlement is retried.
    }
  }
  event SettlementCanceled is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancel reason.
      }
    }
    canceledAt: TimeStamp with {
      briefly "Canceled"
      described as {
        |Cancel time.
      }
    }
  } with {
    briefly "Settlement canceled"
    described as {
      |Emitted when settlement is canceled.
    }
  }
  event SettlementOnHold is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Hold reason.
      }
    }
    heldAt: TimeStamp with {
      briefly "Held"
      described as {
        |Hold time.
      }
    }
  } with {
    briefly "Settlement on hold"
    described as {
      |Emitted when settlement is held.
    }
  }
  event HoldReleased is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    releasedAt: TimeStamp with {
      briefly "Released"
      described as {
        |Release time.
      }
    }
  } with {
    briefly "Hold released"
    described as {
      |Emitted when hold is released.
    }
  }
  // State Records
  record PendingStateData is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    trade: TradeDetails with {
      briefly "Trade"
      described as {
        |Trade details.
      }
    }
    status: SettlementStatus with {
      briefly "Status"
      described as {
        |Settlement status.
      }
    }
    matchingResult: MatchingInfo? with {
      briefly "Matching"
      described as {
        |Match info.
      }
    }
    affirmed: Boolean with {
      briefly "Affirmed"
      described as {
        |Is affirmed.
      }
    }
    initiatedAt: TimeStamp with {
      briefly "Initiated"
      described as {
        |Initiation time.
      }
    }
  } with {
    briefly "Pending state data"
    described as {
      |State for pending settlement.
    }
  }
  record InProcessStateData is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    trade: TradeDetails with {
      briefly "Trade"
      described as {
        |Trade details.
      }
    }
    status: SettlementStatus with {
      briefly "Status"
      described as {
        |Settlement status.
      }
    }
    instructions: SettlementInstruction+ with {
      briefly "Instructions"
      described as {
        |Sent instructions.
      }
    }
    settledQuantity: Natural with {
      briefly "Settled qty"
      described as {
        |Quantity settled.
      }
    }
    settledAmount: Decimal(15,2) with {
      briefly "Settled amt"
      described as {
        |Amount settled.
      }
    }
    instructionsSentAt: TimeStamp with {
      briefly "Sent"
      described as {
        |Instructions sent time.
      }
    }
  } with {
    briefly "In process state data"
    described as {
      |State for in-process settlement.
    }
  }
  record SettledStateData is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    trade: TradeDetails with {
      briefly "Trade"
      described as {
        |Trade details.
      }
    }
    confirmation: SettlementConfirmation with {
      briefly "Confirmation"
      described as {
        |Final confirmation.
      }
    }
    totalSettledQuantity: Natural with {
      briefly "Quantity"
      described as {
        |Total settled.
      }
    }
    totalSettledAmount: Decimal(15,2) with {
      briefly "Amount"
      described as {
        |Total amount.
      }
    }
  } with {
    briefly "Settled state data"
    described as {
      |State for completed settlement.
    }
  }
  record FailedStateData is  {
    settlementId: SettlementId with {
      briefly "Settlement"
      described as {
        |Settlement ID.
      }
    }
    trade: TradeDetails with {
      briefly "Trade"
      described as {
        |Trade details.
      }
    }
    failure: FailureInfo with {
      briefly "Failure"
      described as {
        |Failure details.
      }
    }
    settledQuantity: Natural with {
      briefly "Settled"
      described as {
        |Quantity settled before fail.
      }
    }
    retryCount: Natural with {
      briefly "Retries"
      described as {
        |Number of retries.
      }
    }
  } with {
    briefly "Failed state data"
    described as {
      |State for failed settlement.
    }
  }
  // Query/Result
  query GetSettlement replies result SettlementResult is  {
    settlementId: SettlementId with {
      briefly "Settlement ID"
      described as {
        |Settlement to retrieve.
      }
    }
  } with {
    briefly "Get settlement"
    described as {
      |Retrieves settlement data by identifier.
    }
  }
  result SettlementResult is  {
    settlementId: SettlementId with {
      briefly "Settlement ID"
      described as {
        |Settlement identifier.
      }
    }
    trade: TradeDetails with {
      briefly "Trade"
      described as {
        |Trade details.
      }
    }
    status: SettlementStatus with {
      briefly "Status"
      described as {
        |Settlement status.
      }
    }
  } with {
    briefly "Settlement result"
    described as {
      |Settlement data result.
    }
  }
  // States
  initial state PendingState of record Settlement.PendingStateData is {
    initial handler PendingStateInitHandler is {
      on init is {
        set state PendingState to "initialize from SettlementInitiated event"
      }
    } with {
      briefly "Pending state init handler"
      described as {
        |Initializes the Pending state.
      }
    }
  } with {
    briefly "Pending state"
    described as {
      |Settlement is pending matching and affirmation.
    }
  }
  state InProcessState of record Settlement.InProcessStateData is {
    initial handler InProcessStateInitHandler is {
      on init is {
        set state InProcessState to "initialize from InstructionsSent event"
      }
    } with {
      briefly "In process state init handler"
      described as {
        |Initializes the In Process state.
      }
    }
  } with {
    briefly "In process state"
    described as {
      |Settlement instructions have been sent for processing.
    }
  }
  state SettledState of record Settlement.SettledStateData is {
    initial handler SettledStateInitHandler is {
      on init is {
        set state SettledState to "initialize from SettlementConfirmed event"
      }
    } with {
      briefly "Settled state init handler"
      described as {
        |Initializes the Settled state.
      }
    }
  } with {
    briefly "Settled state"
    described as {
      |Settlement has been confirmed and completed.
    }
  }
  state FailedState of record Settlement.FailedStateData is {
    initial handler FailedStateInitHandler is {
      on init is {
        set state FailedState to "initialize from SettlementFailed event"
      }
    } with {
      briefly "Failed state init handler"
      described as {
        |Initializes the Failed state.
      }
    }
  } with {
    briefly "Failed state"
    described as {
      |Settlement has failed or been canceled.
    }
  }
  // Handler
  handler SettlementHandler is {
    on initiateSettlement: command InitiateSettlement is {
      morph entity SettlementContext.Settlement to state SettlementContext.Settlement.PendingState with record Settlement.PendingStateData(settlementId = initiateSettlement.settlementId, trade = initiateSettlement.trade, status = prompt("the status of this pending state data"), matchingResult = empty, affirmed = prompt("the affirmed of this pending state data"), initiatedAt = prompt("the initiated at of this pending state data"))
      tell event SettlementInitiated(settlementId = initiateSettlement.settlementId, trade = initiateSettlement.trade, initiatedAt = prompt("the initiated at of this settlement initiated")) to entity SettlementContext.Settlement
    }
    on matchTrade: command MatchTrade is {
      tell event TradeMatched(settlementId = matchTrade.settlementId, matching = matchTrade.matching) to entity SettlementContext.Settlement
    }
    on affirmTrade: command AffirmTrade is {
      tell event TradeAffirmed(settlementId = affirmTrade.settlementId, affirmedBy = affirmTrade.affirmedBy, affirmedAt = prompt("the affirmed at of this trade affirmed")) to entity SettlementContext.Settlement
    }
    on sendInstructions: command SendInstructions is {
      morph entity SettlementContext.Settlement to state SettlementContext.Settlement.InProcessState with record Settlement.InProcessStateData(settlementId = sendInstructions.settlementId, instructions = sendInstructions.instructions, trade = prompt("the trade of this in process state data"), status = prompt("the status of this in process state data"), settledQuantity = prompt("the settled quantity of this in process state data"), settledAmount = prompt("the settled amount of this in process state data"), instructionsSentAt = prompt("the instructions sent at of this in process state data"))
      tell event InstructionsSent(settlementId = sendInstructions.settlementId, instructions = sendInstructions.instructions, sentAt = prompt("the sent at of this instructions sent")) to entity SettlementContext.Settlement
    }
    on confirmSettlement: command ConfirmSettlement is {
      morph entity SettlementContext.Settlement to state SettlementContext.Settlement.SettledState with record Settlement.SettledStateData(settlementId = confirmSettlement.settlementId, confirmation = confirmSettlement.confirmation, trade = prompt("the trade of this settled state data"), totalSettledQuantity = prompt("the total settled quantity of this settled state data"), totalSettledAmount = prompt("the total settled amount of this settled state data"))
      tell event SettlementConfirmed(settlementId = confirmSettlement.settlementId, confirmation = confirmSettlement.confirmation) to entity SettlementContext.Settlement
    }
    on recordPartialSettlement: command RecordPartialSettlement is {
      tell event PartialSettlementRecorded(settlementId = recordPartialSettlement.settlementId, partialConfirmation = recordPartialSettlement.partialConfirmation, remainingQuantity = prompt("the remaining quantity of this partial settlement recorded"), remainingAmount = prompt("the remaining amount of this partial settlement recorded")) to entity SettlementContext.Settlement
    }
    on failSettlement: command FailSettlement is {
      morph entity SettlementContext.Settlement to state SettlementContext.Settlement.FailedState with record Settlement.FailedStateData(settlementId = failSettlement.settlementId, failure = failSettlement.failure, trade = prompt("the trade of this failed state data"), settledQuantity = prompt("the settled quantity of this failed state data"), retryCount = prompt("the retry count of this failed state data"))
      tell event SettlementFailed(settlementId = failSettlement.settlementId, failure = failSettlement.failure) to entity SettlementContext.Settlement
    }
    on retrySettlement: command RetrySettlement is {
      morph entity SettlementContext.Settlement to state SettlementContext.Settlement.PendingState with record Settlement.PendingStateData(settlementId = retrySettlement.settlementId, trade = prompt("the trade of this pending state data"), status = prompt("the status of this pending state data"), matchingResult = empty, affirmed = prompt("the affirmed of this pending state data"), initiatedAt = prompt("the initiated at of this pending state data"))
      tell event SettlementRetried(settlementId = retrySettlement.settlementId, newSettlementDate = retrySettlement.newSettlementDate, retriedAt = prompt("the retried at of this settlement retried")) to entity SettlementContext.Settlement
    }
    on cancelSettlement: command CancelSettlement is {
      morph entity SettlementContext.Settlement to state SettlementContext.Settlement.FailedState with record Settlement.FailedStateData(settlementId = cancelSettlement.settlementId, trade = prompt("the trade of this failed state data"), failure = prompt("the failure of this failed state data"), settledQuantity = prompt("the settled quantity of this failed state data"), retryCount = prompt("the retry count of this failed state data"))
      tell event SettlementCanceled(settlementId = cancelSettlement.settlementId, reason = cancelSettlement.reason, canceledAt = prompt("the canceled at of this settlement canceled")) to entity SettlementContext.Settlement
    }
    on holdSettlement: command HoldSettlement is {
      tell event SettlementOnHold(settlementId = holdSettlement.settlementId, reason = holdSettlement.reason, heldAt = prompt("the held at of this settlement on hold")) to entity SettlementContext.Settlement
    }
    on releaseHold: command ReleaseHold is {
      tell event HoldReleased(settlementId = releaseHold.settlementId, releasedAt = prompt("the released at of this hold released")) to entity SettlementContext.Settlement
    }
    on getSettlement: query GetSettlement is {
      reply result SettlementResult(settlementId = getSettlement.settlementId, trade = prompt("the trade of this settlement result"), status = prompt("the status of this settlement result"))
    }
    on holdReleased: event HoldReleased is {
      do "apply HoldReleased to the settlement so it can be persisted and replayed"
    }
    on instructionsSent: event InstructionsSent is {
      do "apply InstructionsSent to the settlement so it can be persisted and replayed"
    }
    on partialSettlementRecorded: event PartialSettlementRecorded is {
      do "apply PartialSettlementRecorded to the settlement so it can be persisted and replayed"
    }
    on settlementCanceled: event SettlementCanceled is {
      do "apply SettlementCanceled to the settlement so it can be persisted and replayed"
    }
    on settlementConfirmed: event SettlementConfirmed is {
      do "apply SettlementConfirmed to the settlement so it can be persisted and replayed"
    }
    on settlementFailed: event SettlementFailed is {
      do "apply SettlementFailed to the settlement so it can be persisted and replayed"
    }
    on settlementInitiated: event SettlementInitiated is {
      do "apply SettlementInitiated to the settlement so it can be persisted and replayed"
    }
    on settlementOnHold: event SettlementOnHold is {
      do "apply SettlementOnHold to the settlement so it can be persisted and replayed"
    }
    on settlementRetried: event SettlementRetried is {
      do "apply SettlementRetried to the settlement so it can be persisted and replayed"
    }
    on tradeAffirmed: event TradeAffirmed is {
      do "apply TradeAffirmed to the settlement so it can be persisted and replayed"
    }
    on tradeMatched: event TradeMatched is {
      do "apply TradeMatched to the settlement so it can be persisted and replayed"
    }
  } with {
    briefly "Processes settlement commands"
    described as {
      | Handles settlement lifecycle from initiation
      | through matching, instructions, and confirmation.
    }
  }
} with {
  briefly "Settlement aggregate"
  described as {
    | The Settlement entity manages trade settlements
    | including matching, instructions, and confirmation.
  }
}
