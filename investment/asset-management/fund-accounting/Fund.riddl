// Fund Entity
// Core entity representing an investment fund
entity Fund as flow is {
  type FundCommand is one of {
    Fund.CreateFund or Fund.CalculateNAV or Fund.RecordTransaction or Fund.UpdateHolding or Fund.ProcessSubscription or Fund.ProcessRedemption or Fund.SuspendFund or Fund.ResumeFund or Fund.InitializeFund
  } with {
    briefly "Fund command alternation"
    described as {
      |Commands accepted by the Fund entity.
    }
  }
  inlet FundCommands is type FundCommand  outlet FundEvents2 is type FundEvent
  // === Commands ===
  command CreateFund is  {
    fundId: FundId
    name: String(1,200)
    fundType: FundType
    baseCurrency: Currency(USD)
    inceptionDate: Date
    managementFeeRate: Percentage
    performanceFeeRate: Percentage?
    minimumInvestment: Money
  } with {
    briefly "Create a new investment fund"
    described as {
      | Initializes a new fund with its core configuration including
      | name, type, fee structure, and minimum investment requirements.
      | The fund starts in Active status.
    }
  }
  command CalculateNAV is  {
    fundId: FundId
    valuationDate: Date
    isOfficial: Boolean
  } with {
    briefly "Calculate the Net Asset Value for a fund"
    described as {
      | Triggers the NAV calculation process for the specified date.
      | Market data and holdings are used to compute total assets,
      | liabilities, and the resulting per-share NAV.
    }
  }
  command RecordTransaction is  {
    transactionId: TransactionId
    fundId: FundId
    transactionType: TransactionType
    tradeSecurityId: SecurityId?
    tradeQuantity: Quantity?
    tradePrice: Price?
    grossAmount: Money
    fees: Money
    tradeDate: Date
    settlementDate: Date
    description: String(,500)
  } with {
    briefly "Record a new fund transaction"
    described as {
      | Records a transaction affecting the fund such as security
      | purchases, sales, dividend receipts, or fee payments. The
      | transaction updates holdings and affects NAV calculation.
    }
  }
  command UpdateHolding is  {
    holdingId: HoldingId
    fundId: FundId
    securityId: SecurityId
    quantity: Quantity
    marketValue: Money
  } with {
    briefly "Update a portfolio holding position"
    described as {
      | Updates the quantity or market value of an existing holding.
      | Used during position reconciliation and mark-to-market
      | processes.
    }
  }
  command ProcessSubscription is  {
    accountId: InvestorAccountId
    fundId: FundId
    investorName: String(1,200)
    subscriptionAmount: Money
    subscriptionDate: Date
  } with {
    briefly "Process an investor subscription"
    described as {
      | Records a new investment into the fund. Calculates shares
      | issued based on current NAV and updates investor account
      | and fund shares outstanding.
    }
  }
  command ProcessRedemption is  {
    accountId: InvestorAccountId
    fundId: FundId
    shares: Quantity
    redemptionDate: Date
  } with {
    briefly "Process an investor redemption"
    described as {
      | Records a redemption from the fund. Calculates redemption
      | proceeds based on current NAV and updates investor account
      | and fund shares outstanding.
    }
  }
  command SuspendFund is  {
    fundId: FundId
    reason: String(1,500)
    suspensionDate: Date
  } with {
    briefly "Suspend fund operations"
    described as {
      | Temporarily halts fund operations including subscriptions
      | and redemptions. Used during unusual market conditions or
      | significant events affecting the fund.
    }
  }
  command ResumeFund is  {
    fundId: FundId
    resumptionDate: Date
  } with {
    briefly "Resume suspended fund operations"
    described as {
      | Resumes normal fund operations after a suspension period.
      | The fund returns to Active status and accepts new transactions.
    }
  }
  // === Events ===
  event FundCreated is  {
    fundId: FundId
    name: String(1,200)
    fundType: FundType
    inceptionDate: Date
    createdAt: TimeStamp
  } with {
    briefly "Fund has been created"
    described as {
      | Emitted when a new fund is successfully initialized and
      | ready for operations.
    }
  }
  event NAVCalculated is  {
    navId: NAVId
    fundId: FundId
    valuationDate: Date
    netAssetValue: Money
    navPerShare: Price
    sharesOutstanding: Quantity
    isOfficial: Boolean
    calculatedAt: TimeStamp
  } with {
    briefly "NAV calculation completed"
    described as {
      | Emitted when a NAV calculation completes successfully.
      | Contains the calculated values and whether this is the
      | official published NAV.
    }
  }
  event TransactionRecorded is  {
    transactionId: TransactionId
    fundId: FundId
    transactionType: TransactionType
    netAmount: Money
    tradeDate: Date
    recordedAt: TimeStamp
  } with {
    briefly "Transaction has been recorded"
    described as {
      | Emitted when a transaction is successfully recorded.
      | Triggers downstream processes such as holding updates
      | and NAV recalculation.
    }
  }
  event HoldingUpdated is  {
    holdingId: HoldingId
    fundId: FundId
    securityId: SecurityId
    quantity: Quantity
    marketValue: Money
    updatedAt: TimeStamp
  } with {
    briefly "Holding position has been updated"
    described as {
      | Emitted when a holding's quantity or value changes.
      | Triggers recalculation of portfolio allocations and
      | unrealized gains.
    }
  }
  event SubscriptionProcessed is  {
    accountId: InvestorAccountId
    fundId: FundId
    investorName: String(1,200)
    subscriptionAmount: Money
    sharesIssued: Quantity
    navPerShare: Price
    processedAt: TimeStamp
  } with {
    briefly "Investor subscription has been processed"
    described as {
      | Emitted when an investor's subscription is processed and
      | shares are issued.
    }
  }
  event RedemptionProcessed is  {
    accountId: InvestorAccountId
    fundId: FundId
    sharesRedeemed: Quantity
    redemptionAmount: Money
    navPerShare: Price
    processedAt: TimeStamp
  } with {
    briefly "Investor redemption has been processed"
    described as {
      | Emitted when an investor's redemption is processed and
      | funds are distributed.
    }
  }
  event FundSuspended is  {
    fundId: FundId
    reason: String(1,500)
    suspensionDate: Date
    suspendedAt: TimeStamp
  } with {
    briefly "Fund operations have been suspended"
    described as {
      | Emitted when a fund enters suspended status. New
      | transactions are blocked until the fund is resumed.
    }
  }
  event FundResumed is  {
    fundId: FundId
    resumptionDate: Date
    resumedAt: TimeStamp
  } with {
    briefly "Fund operations have resumed"
    described as {
      | Emitted when a suspended fund returns to active status.
    }
  }
  // === Queries ===
  query GetFundInfo is  { fundId: FundId } with {
    briefly "Retrieve fund information"
    described as {
      | Queries the current fund configuration and status information.
    }
  }
  result FundInfoResult is  { fundInfo: FundInfo } with {
    briefly "Fund information query result"
    described as {
      | Returns the fund's current configuration and status.
    }
  }
  query GetNAVHistory is  {
    fundId: FundId
    startDate: Date
    endDate: Date
  } with {
    briefly "Retrieve NAV history for a date range"
    described as {
      | Queries historical NAV values for the specified period.
    }
  }
  result NAVHistoryResult is  { navRecords: NAVRecord+ } with {
    briefly "NAV history query result"
    described as {
      | Returns a list of NAV records for the requested date range.
    }
  }
  query GetHoldings is  {
    fundId: FundId
    asOfDate: Date
  } with {
    briefly "Retrieve fund holdings"
    described as {
      | Queries the fund's portfolio holdings as of a specific date.
    }
  }
  result HoldingsResult is  { holdings: HoldingRecord+ } with {
    briefly "Holdings query result"
    described as {
      | Returns the list of current portfolio holdings with
      | positions and valuations.
    }
  }
  query GetPerformance is  {
    fundId: FundId
    asOfDate: Date
  } with {
    briefly "Retrieve fund performance metrics"
    described as {
      | Queries calculated performance returns for various periods.
    }
  }
  result PerformanceResult is  { performance: FundPerformance } with {
    briefly "Performance query result"
    described as {
      | Returns the fund's performance metrics for standard periods.
    }
  }
  command InitializeFund is  { ??? } with {
    briefly "Initialize fund"
    described as {
      |Initializes the fund entity.
    }
  }
  // === States ===
  initial state ActiveFund of record FundInfo is {
    initial handler ActiveFundInitHandler is {
      on init is {
        set state ActiveFund to "initialize from prior event"
      }
    } with {
      briefly "Active fund init handler"
      described as {
        |Initializes the Active fund state.
      }
    }
  } with {
    briefly "Active fund state"
    described as {
      |Fund in active operational status.
    }
  }
  state SuspendedFund of record FundInfo is {
    initial handler SuspendedFundInitHandler is {
      on init is {
        set state SuspendedFund to "initialize from prior event"
      }
    } with {
      briefly "Suspended fund init handler"
      described as {
        |Initializes the Suspended fund state.
      }
    }
  } with {
    briefly "Suspended fund state"
    described as {
      |Fund in suspended status, transactions blocked.
    }
  }
  // === Handler ===
  handler FundCommandHandler is {
    on createFund: command CreateFund is {
      do "Validate fund configuration and initialize fund state"
      morph entity Fund to state ActiveFund with record FundInfo
      tell event FundCreated(fundId = createFund.fundId, name = createFund.name, fundType = createFund.fundType, inceptionDate = createFund.inceptionDate) to entity Fund
    } with {
      briefly "Handles fund creation"
      described as {
        | Validates the fund configuration and creates a new fund
        | in active state.
      }
    }
    on calculateNAV: command CalculateNAV is {
      do "Retrieve current holdings and market prices"
      do "Calculate total assets by summing holding market values"
      do "Calculate total liabilities including accrued fees"
      do "Compute net asset value and per-share NAV"
      tell event NAVCalculated(fundId = calculateNAV.fundId, valuationDate = calculateNAV.valuationDate, isOfficial = calculateNAV.isOfficial) to entity Fund
    } with {
      briefly "Handles NAV calculation requests"
      described as {
        | Processes the NAV calculation by aggregating holdings,
        | applying market prices, and computing the per-share value.
      }
    }
    on recordTransaction: command RecordTransaction is {
      when prompt("transactionType is Buy or Sell") then
        do "Update security holding position"
        do "Calculate realized gain/loss for sells"
      end
      do "Record transaction with pending status"
      do "Update fund cash position"
      tell event TransactionRecorded(transactionId = recordTransaction.transactionId, fundId = recordTransaction.fundId, transactionType = recordTransaction.transactionType, tradeDate = recordTransaction.tradeDate) to entity Fund
    } with {
      briefly "Handles transaction recording"
      described as {
        | Records the transaction and updates affected holdings
        | and positions.
      }
    }
    on updateHolding: command UpdateHolding is {
      do "Recalculate holding cost basis and unrealized gain/loss"
      do "Update portfolio allocation percentages"
      tell event HoldingUpdated(holdingId = updateHolding.holdingId, fundId = updateHolding.fundId, securityId = updateHolding.securityId, quantity = updateHolding.quantity, marketValue = updateHolding.marketValue) to entity Fund
    } with {
      briefly "Handles holding updates"
      described as {
        | Updates holding position and recalculates related metrics.
      }
    }
    on processSubscription: command ProcessSubscription is {
      do "Retrieve current NAV per share"
      do "Calculate shares to issue based on investment amount"
      do "Create or update investor account"
      do "Increase fund shares outstanding"
      tell event SubscriptionProcessed(accountId = processSubscription.accountId, fundId = processSubscription.fundId, investorName = processSubscription.investorName, subscriptionAmount = processSubscription.subscriptionAmount) to entity Fund
    } with {
      briefly "Handles investor subscriptions"
      described as {
        | Processes new investments by calculating shares to issue
        | and updating investor accounts.
      }
    }
    on processRedemption: command ProcessRedemption is {
      do "Validate sufficient shares in investor account"
      do "Calculate redemption amount based on current NAV"
      do "Reduce investor account balance"
      do "Reduce fund shares outstanding"
      tell event RedemptionProcessed(accountId = processRedemption.accountId, fundId = processRedemption.fundId) to entity Fund
    } with {
      briefly "Handles investor redemptions"
      described as {
        | Processes redemption requests by calculating proceeds
        | and updating accounts.
      }
    }
    on suspendFund: command SuspendFund is {
      morph entity Fund to state SuspendedFund with record FundInfo
      tell event FundSuspended(fundId = suspendFund.fundId, reason = suspendFund.reason, suspensionDate = suspendFund.suspensionDate) to entity Fund
    } with {
      briefly "Handles fund suspension"
      described as {
        | Transitions the fund to suspended state and blocks new
        | transactions.
      }
    }
    on resumeFund: command ResumeFund is {
      morph entity Fund to state ActiveFund with record FundInfo
      tell event FundResumed(fundId = resumeFund.fundId, resumptionDate = resumeFund.resumptionDate) to entity Fund
    } with {
      briefly "Handles fund resumption"
      described as {
        | Returns a suspended fund to active operational status.
      }
    }
    on query GetFundInfo is {
      tell result FundInfoResult to entity FundContext.Fund
    } with {
      briefly "Handles fund info queries"
      described as {
        | Returns the current fund configuration and status.
      }
    }
    on query GetNAVHistory is {
      tell result NAVHistoryResult to entity FundContext.Fund
    } with {
      briefly "Handles NAV history queries"
      described as {
        | Returns historical NAV values for reporting and analysis.
      }
    }
    on query GetHoldings is {
      tell result HoldingsResult to entity FundContext.Fund
    } with {
      briefly "Handles holdings queries"
      described as {
        | Returns the fund's portfolio positions.
      }
    }
    on query GetPerformance is {
      tell result PerformanceResult to entity FundContext.Fund
    } with {
      briefly "Handles performance queries"
      described as {
        | Returns calculated performance returns for standard periods.
      }
    }
  } with {
    briefly "Primary command handler for Fund entity"
    described as {
      | Handles all commands and queries for fund operations including
      | NAV calculations, transaction processing, and investor account
      | management.
    }
  }
} with {
  briefly "Investment fund entity"
  described as {
    | The Fund entity represents an investment fund and manages its
    | lifecycle, holdings, transactions, and investor accounts. It
    | serves as the aggregate root for fund accounting operations.
  }
}
