// Fund Context
// Bounded context for fund accounting operations
context FundContext as router is {
  inlet FundCommandStreamIn is type FundCommand  outlet FundCommandStreamOut is type FundCommand
  inlet FundInfoResultStreamIn is result Fund.FundInfoResult  outlet FundInfoResultStreamOut is result Fund.FundInfoResult
  handler FundContextBoundary is {
    on createFund: command Fund.CreateFund is {
      forward createFund to outlet FundContext.FundCommandStreamOut
    }
    on calculateNAV: command Fund.CalculateNAV is {
      forward calculateNAV to outlet FundContext.FundCommandStreamOut
    }
    on recordTransaction: command Fund.RecordTransaction is {
      forward recordTransaction to outlet FundContext.FundCommandStreamOut
    }
    on updateHolding: command Fund.UpdateHolding is {
      forward updateHolding to outlet FundContext.FundCommandStreamOut
    }
    on processSubscription: command Fund.ProcessSubscription is {
      forward processSubscription to outlet FundContext.FundCommandStreamOut
    }
    on processRedemption: command Fund.ProcessRedemption is {
      forward processRedemption to outlet FundContext.FundCommandStreamOut
    }
    on suspendFund: command Fund.SuspendFund is {
      forward suspendFund to outlet FundContext.FundCommandStreamOut
    }
    on resumeFund: command Fund.ResumeFund is {
      forward resumeFund to outlet FundContext.FundCommandStreamOut
    }
    on fundInfoResult: result Fund.FundInfoResult is {
      send fundInfoResult to outlet FundContext.FundInfoResultStreamOut
    }
    on other is {
      error "Unexpected message at the FundContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'FundCommand Stream Intake' is from outlet FundContext.FundCommandStreamOut to inlet FundContext.Fund.FundCommands  connector 'FundInfoResult Stream Egress' is from outlet FundContext.FundRepository.FundRepositoryResponses to inlet FundContext.FundInfoResultStreamIn  adaptor FromComplianceContext from context ComplianceContext is { 
    handler FromComplianceContextHandler is {
      on event ComplianceContext.ComplianceCheckCompleted is {
        do "the model receives compliance check completed"
      }
      on event ComplianceContext.ViolationDetected is {
        do "the model receives violation detected"
      }
      on other is {
        error "Unexpected message for adaptor FromComplianceContext"
      }
    } with {
      briefly "from compliance context"
      described as {
        |Carries messages from the external ComplianceContext.
      }
    }
  } with {
    briefly "ComplianceContext integration"
    described as {
      |The model's side of the ComplianceContext conversation.
    }
  }
  adaptor FromCustodianContext from context CustodianContext is { 
    handler FromCustodianContextHandler is {
      on event CustodianContext.PositionsReceived is {
        do "the model receives positions received"
      }
      on event CustodianContext.TransactionSettled is {
        do "the model receives transaction settled"
      }
      on other is {
        error "Unexpected message for adaptor FromCustodianContext"
      }
    } with {
      briefly "from custodian context"
      described as {
        |Carries messages from the external CustodianContext.
      }
    }
  } with {
    briefly "CustodianContext integration"
    described as {
      |The model's side of the CustodianContext conversation.
    }
  }
  adaptor FromMarketDataContext from context MarketDataContext is { 
    handler FromMarketDataContextHandler is {
      on event MarketDataContext.EndOfDayPricesPublished is {
        do "the model receives end of day prices published"
      }
      on event MarketDataContext.PriceUpdated is {
        do "the model receives price updated"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketDataContext"
      }
    } with {
      briefly "from market data context"
      described as {
        |Carries messages from the external MarketDataContext.
      }
    }
  } with {
    briefly "MarketDataContext integration"
    described as {
      |The model's side of the MarketDataContext conversation.
    }
  }
  adaptor FromTransferAgentContext from context TransferAgentContext is { 
    handler FromTransferAgentContextHandler is {
      on event TransferAgentContext.DividendDeclared is {
        do "the model receives dividend declared"
      }
      on event TransferAgentContext.ShareholderRegistered is {
        do "the model receives shareholder registered"
      }
      on other is {
        error "Unexpected message for adaptor FromTransferAgentContext"
      }
    } with {
      briefly "from transfer agent context"
      described as {
        |Carries messages from the external TransferAgentContext.
      }
    }
  } with {
    briefly "TransferAgentContext integration"
    described as {
      |The model's side of the TransferAgentContext conversation.
    }
  }
  include "types.riddl"
  include "Fund.riddl"
  // === Repository ===
  type FundRepositoryCommand is one of {
    FundContext.FundRepository.PersistFundCreated or FundContext.FundRepository.PersistFundResumed or FundContext.FundRepository.PersistFundSuspended or FundContext.FundRepository.PersistHoldingUpdated or FundContext.FundRepository.PersistNAVCalculated or FundContext.FundRepository.PersistRedemptionProcessed or FundContext.FundRepository.PersistSubscriptionProcessed or FundContext.FundRepository.PersistTransactionRecorded
  } with {
    briefly "Anything that writes FundRepository"
    described as {
      |The persistence commands FundRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository FundRepository as flow is {
    inlet FundRepositoryFromFundDashboardProjector is type FundRepositoryCommand
    command PersistHoldingUpdated is  {
      holdingId: HoldingId with {
        briefly "Row addressed"
        described as {
          |Which stored row HoldingUpdated applies to.
        }
      }
    } with {
      briefly "Persist HoldingUpdated"
      described as {
        |Instructs this repository to apply HoldingUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFundCreated is  {
      fundId: FundId with {
        briefly "Row addressed"
        described as {
          |Which stored row FundCreated applies to.
        }
      }
    } with {
      briefly "Persist FundCreated"
      described as {
        |Instructs this repository to apply FundCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFundResumed is  {
      fundId: FundId with {
        briefly "Row addressed"
        described as {
          |Which stored row FundResumed applies to.
        }
      }
    } with {
      briefly "Persist FundResumed"
      described as {
        |Instructs this repository to apply FundResumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFundSuspended is  {
      fundId: FundId with {
        briefly "Row addressed"
        described as {
          |Which stored row FundSuspended applies to.
        }
      }
    } with {
      briefly "Persist FundSuspended"
      described as {
        |Instructs this repository to apply FundSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistNAVCalculated is  {
      navId: NAVId with {
        briefly "Row addressed"
        described as {
          |Which stored row NAVCalculated applies to.
        }
      }
    } with {
      briefly "Persist NAVCalculated"
      described as {
        |Instructs this repository to apply NAVCalculated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRedemptionProcessed is  {
      accountId: InvestorAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row RedemptionProcessed applies to.
        }
      }
    } with {
      briefly "Persist RedemptionProcessed"
      described as {
        |Instructs this repository to apply RedemptionProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubscriptionProcessed is  {
      accountId: InvestorAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubscriptionProcessed applies to.
        }
      }
    } with {
      briefly "Persist SubscriptionProcessed"
      described as {
        |Instructs this repository to apply SubscriptionProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransactionRecorded is  {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransactionRecorded applies to.
        }
      }
    } with {
      briefly "Persist TransactionRecorded"
      described as {
        |Instructs this repository to apply TransactionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet FundRepositoryResponses is result Fund.FundInfoResult
    schema FundData is relational
      of fund as record FundInfo
      of holding as record HoldingRecord
      of investor as record InvestorAccount
      of nav as record NAVRecord
      of transaction as record TransactionRecord
        link fundHolding as field HoldingRecord.fundId to field FundInfo.fundId
        link fundInvestor as field InvestorAccount.fundId to field FundInfo.fundId
        link fundNav as field NAVRecord.fundId to field FundInfo.fundId
        link fundTransaction as field TransactionRecord.fundId to field FundInfo.fundId
        index on field FundInfo.fundId
        index on field NAVRecord.valuationDate
        index on field TransactionRecord.tradeDate
 with {
      briefly "Relational schema for fund data storage"
      described as {
        | Defines the relational structure for persisting fund
        | information, NAV history, transactions, holdings, and
        | investor accounts with appropriate relationships and
        | indexes for efficient querying.
      }
    }
    handler FundRepositoryHandler is {
      on persistHoldingUpdated: command PersistHoldingUpdated is {
        do "apply HoldingUpdated to the stored row"
      }
      on persistFundCreated: command PersistFundCreated is {
        do "apply FundCreated to the stored row"
      }
      on persistFundResumed: command PersistFundResumed is {
        do "apply FundResumed to the stored row"
      }
      on persistFundSuspended: command PersistFundSuspended is {
        do "apply FundSuspended to the stored row"
      }
      on persistNAVCalculated: command PersistNAVCalculated is {
        do "apply NAVCalculated to the stored row"
      }
      on persistRedemptionProcessed: command PersistRedemptionProcessed is {
        do "apply RedemptionProcessed to the stored row"
      }
      on persistSubscriptionProcessed: command PersistSubscriptionProcessed is {
        do "apply SubscriptionProcessed to the stored row"
      }
      on persistTransactionRecorded: command PersistTransactionRecorded is {
        do "apply TransactionRecorded to the stored row"
      }
      on query GetDashboardRecord is {
        let dashboardRecordView: type DashboardRecordView = prompt("read the dashboard record projection")
        reply dashboardRecordView
      }
      on query GetReportingRecord is {
        let reportingRecordView: type ReportingRecordView = prompt("read the reporting record projection")
        reply reportingRecordView
      }
    } with {
      briefly "Event handler for fund persistence"
      described as {
        | Handles persistence of all fund-related events to the
        | repository for durable storage and querying.
      }
    }
  } with {
    briefly "Repository for fund accounting data"
    described as {
      | The FundRepository provides persistent storage for all fund
      | accounting data including fund configuration, NAV history,
      | transactions, holdings, and investor accounts.
    }
  }
  // === Projector ===
  query GetDashboardRecord replies result DashboardRecordView is  {
    dashboardRecordKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which dashboard record to retrieve.
      }
    }
  } with {
    briefly "Get dashboard record"
    described as {
      |Retrieves the dashboard record projection.
    }
  }
  result DashboardRecordView is  {
    dashboardRecord: FundDashboardProjector.DashboardRecord with {
      briefly "Dashboard record"
      described as {
        |The dashboard record being returned.
      }
    }
  } with {
    briefly "Dashboard record view"
    described as {
      |Read model view carrying the dashboard record projection.
    }
  }
  projector FundDashboardProjector as flow is {
    outlet FundDashboardProjectorToRepository is type FundRepositoryCommand
    updates repository FundContext.FundRepository
    inlet FundDashboardProjectorFromFund is type FundEvent
    record DashboardRecord is  {
      fundId: FundId with {
        briefly "Fund identifier"
        described as {
          |Fund this dashboard entry is for.
        }
      }
      fundName: String(1,200) with {
        briefly "Fund name"
        described as {
          |Display name of the fund.
        }
      }
      currentNAV: Money with {
        briefly "Current NAV"
        described as {
          |Latest net asset value.
        }
      }
      navPerShare: Price with {
        briefly "NAV per share"
        described as {
          |Latest NAV per share.
        }
      }
      totalAUM: Money with {
        briefly "Total AUM"
        described as {
          |Total assets under management.
        }
      }
      dailyChangePercent: Percentage with {
        briefly "Daily change"
        described as {
          |Daily NAV change percentage.
        }
      }
      ytdReturn: Percentage with {
        briefly "YTD return"
        described as {
          |Year-to-date return.
        }
      }
      investorCount: Natural with {
        briefly "Investor count"
        described as {
          |Number of investors.
        }
      }
      lastUpdated: TimeStamp with {
        briefly "Last updated"
        described as {
          |When dashboard was last refreshed.
        }
      }
    } with {
      briefly "Dashboard projection record"
      described as {
        |Core record for the fund dashboard projector.
      }
    }
    handler DashboardEventHandler is {
      on holdingUpdated: event Fund.HoldingUpdated is {
        tell command FundContext.FundRepository.PersistHoldingUpdated(holdingId = holdingUpdated.holdingId) to repository FundContext.FundRepository
        do "apply HoldingUpdated to the FundDashboardProjector projection"
      }
      on transactionRecorded: event Fund.TransactionRecorded is {
        tell command FundContext.FundRepository.PersistTransactionRecorded(transactionId = transactionRecorded.transactionId) to repository FundContext.FundRepository
        do "apply TransactionRecorded to the FundDashboardProjector projection"
      }
      on nAVCalculated: event NAVCalculated is {
        tell command FundContext.FundRepository.PersistNAVCalculated(navId = nAVCalculated.navId) to repository FundContext.FundRepository
      } with {
        briefly "Updates dashboard on NAV calculation"
        described as {
          | Projects NAV calculations to dashboard summary and
          | performance chart data.
        }
      }
      on subscriptionProcessed: event SubscriptionProcessed is {
        tell command FundContext.FundRepository.PersistSubscriptionProcessed(accountId = subscriptionProcessed.accountId) to repository FundContext.FundRepository
      } with {
        briefly "Updates dashboard on subscription"
        described as {
          | Projects subscription events to update AUM and
          | investor metrics.
        }
      }
      on redemptionProcessed: event RedemptionProcessed is {
        tell command FundContext.FundRepository.PersistRedemptionProcessed(accountId = redemptionProcessed.accountId) to repository FundContext.FundRepository
      } with {
        briefly "Updates dashboard on redemption"
        described as {
          | Projects redemption events to update AUM metrics.
        }
      }
      on fundCreated: event FundCreated is {
        tell command FundContext.FundRepository.PersistFundCreated(fundId = fundCreated.fundId) to repository FundContext.FundRepository
      } with {
        briefly "Initializes dashboard for new fund"
        described as {
          | Creates initial dashboard projection entries for
          | a newly created fund.
        }
      }
      on fundSuspended: event FundSuspended is {
        tell command FundContext.FundRepository.PersistFundSuspended(fundId = fundSuspended.fundId) to repository FundContext.FundRepository
      } with {
        briefly "Updates dashboard on fund suspension"
        described as {
          | Projects fund suspension to dashboard display.
        }
      }
      on fundResumed: event FundResumed is {
        tell command FundContext.FundRepository.PersistFundResumed(fundId = fundResumed.fundId) to repository FundContext.FundRepository
      } with {
        briefly "Updates dashboard on fund resumption"
        described as {
          | Projects fund resumption to dashboard display.
        }
      }
    } with {
      briefly "Event handler for dashboard projections"
      described as {
        | Handles events to maintain dashboard summary and
        | performance chart projections.
      }
    }
  } with {
    briefly "Projector for fund dashboard views"
    described as {
      | The FundDashboardProjector maintains read-optimized views
      | for fund dashboards including summary metrics and
      | performance charts for investor and manager portals.
    }
  }
  // === Reporting Projector ===
  query GetReportingRecord replies result ReportingRecordView is  {
    reportingRecordKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which reporting record to retrieve.
      }
    }
  } with {
    briefly "Get reporting record"
    described as {
      |Retrieves the reporting record projection.
    }
  }
  result ReportingRecordView is  {
    reportingRecord: RegulatoryReportingProjector.ReportingRecord with {
      briefly "Reporting record"
      described as {
        |The reporting record being returned.
      }
    }
  } with {
    briefly "Reporting record view"
    described as {
      |Read model view carrying the reporting record projection.
    }
  }
  projector RegulatoryReportingProjector as sink is {
    updates repository FundContext.FundRepository
    inlet RegulatoryReportingProjectorFromFund is type FundEvent
    record ReportingRecord is  {
      fundId: FundId with {
        briefly "Fund identifier"
        described as {
          |Fund this report covers.
        }
      }
      reportingPeriod: String(1,20) with {
        briefly "Reporting period"
        described as {
          |Period covered by the report.
        }
      }
      periodEndDate: Date with {
        briefly "Period end date"
        described as {
          |End date of the reporting period.
        }
      }
      totalAssets: Money with {
        briefly "Total assets"
        described as {
          |Total fund assets for the period.
        }
      }
      totalLiabilities: Money with {
        briefly "Total liabilities"
        described as {
          |Total fund liabilities for the period.
        }
      }
      netAssets: Money with {
        briefly "Net assets"
        described as {
          |Net fund assets.
        }
      }
      generatedAt: TimeStamp with {
        briefly "Generated at"
        described as {
          |When this report was generated.
        }
      }
    } with {
      briefly "Regulatory reporting projection record"
      described as {
        |Core record for the regulatory reporting projector.
      }
    }
    handler ReportingEventHandler is {
      on fundCreated: event Fund.FundCreated is {
        tell command FundContext.FundRepository.PersistFundCreated(fundId = fundCreated.fundId) to repository FundContext.FundRepository
        do "apply FundCreated to the RegulatoryReportingProjector projection"
      }
      on fundResumed: event Fund.FundResumed is {
        tell command FundContext.FundRepository.PersistFundResumed(fundId = fundResumed.fundId) to repository FundContext.FundRepository
        do "apply FundResumed to the RegulatoryReportingProjector projection"
      }
      on fundSuspended: event Fund.FundSuspended is {
        tell command FundContext.FundRepository.PersistFundSuspended(fundId = fundSuspended.fundId) to repository FundContext.FundRepository
        do "apply FundSuspended to the RegulatoryReportingProjector projection"
      }
      on holdingUpdated: event Fund.HoldingUpdated is {
        tell command FundContext.FundRepository.PersistHoldingUpdated(holdingId = holdingUpdated.holdingId) to repository FundContext.FundRepository
        do "apply HoldingUpdated to the RegulatoryReportingProjector projection"
      }
      on nAVCalculated: event NAVCalculated is {
        tell command FundContext.FundRepository.PersistNAVCalculated(navId = nAVCalculated.navId) to repository FundContext.FundRepository
      } with {
        briefly "Projects NAV data to regulatory reports"
        described as {
          | Accumulates NAV data for period-end regulatory reporting.
        }
      }
      on transactionRecorded: event TransactionRecorded is {
        tell command FundContext.FundRepository.PersistTransactionRecorded(transactionId = transactionRecorded.transactionId) to repository FundContext.FundRepository
      } with {
        briefly "Projects transactions to regulatory reports"
        described as {
          | Categorizes and aggregates transactions for regulatory
          | disclosure requirements.
        }
      }
      on subscriptionProcessed: event SubscriptionProcessed is {
        tell command FundContext.FundRepository.PersistSubscriptionProcessed(accountId = subscriptionProcessed.accountId) to repository FundContext.FundRepository
      } with {
        briefly "Projects subscriptions to regulatory reports"
        described as {
          | Tracks subscription activity for regulatory reporting.
        }
      }
      on redemptionProcessed: event RedemptionProcessed is {
        tell command FundContext.FundRepository.PersistRedemptionProcessed(accountId = redemptionProcessed.accountId) to repository FundContext.FundRepository
      } with {
        briefly "Projects redemptions to regulatory reports"
        described as {
          | Tracks redemption activity for regulatory reporting.
        }
      }
    } with {
      briefly "Event handler for regulatory report projections"
      described as {
        | Handles events to maintain data required for regulatory
        | filings and compliance reporting.
      }
    }
  } with {
    briefly "Projector for regulatory reporting"
    described as {
      | The RegulatoryReportingProjector maintains data required
      | for regulatory filings including period-end reports,
      | transaction summaries, and compliance metrics.
    }
  }
  processor FundEventSplit as split is {
    inlet FundEventSplitIn is type FundEvent
    outlet FundEventSplitToFundDashboardProjector is type FundEvent
    outlet FundEventSplitToRegulatoryReportingProjector is type FundEvent
    handler FundEventSplitHandler is {
      on fundCreated: event Fund.FundCreated is {
        send fundCreated to outlet FundEventSplitToFundDashboardProjector
        send fundCreated to outlet FundEventSplitToRegulatoryReportingProjector
        tell fundCreated to entity FundContext.Fund
      }
      on nAVCalculated: event Fund.NAVCalculated is {
        send nAVCalculated to outlet FundEventSplitToFundDashboardProjector
        send nAVCalculated to outlet FundEventSplitToRegulatoryReportingProjector
        tell nAVCalculated to entity FundContext.Fund
      }
      on transactionRecorded: event Fund.TransactionRecorded is {
        send transactionRecorded to outlet FundEventSplitToFundDashboardProjector
        send transactionRecorded to outlet FundEventSplitToRegulatoryReportingProjector
        tell transactionRecorded to entity FundContext.Fund
      }
      on holdingUpdated: event Fund.HoldingUpdated is {
        send holdingUpdated to outlet FundEventSplitToFundDashboardProjector
        send holdingUpdated to outlet FundEventSplitToRegulatoryReportingProjector
        tell holdingUpdated to entity FundContext.Fund
      }
      on subscriptionProcessed: event Fund.SubscriptionProcessed is {
        send subscriptionProcessed to outlet FundEventSplitToFundDashboardProjector
        send subscriptionProcessed to outlet FundEventSplitToRegulatoryReportingProjector
        tell subscriptionProcessed to entity FundContext.Fund
      }
      on redemptionProcessed: event Fund.RedemptionProcessed is {
        send redemptionProcessed to outlet FundEventSplitToFundDashboardProjector
        send redemptionProcessed to outlet FundEventSplitToRegulatoryReportingProjector
        tell redemptionProcessed to entity FundContext.Fund
      }
      on fundSuspended: event Fund.FundSuspended is {
        send fundSuspended to outlet FundEventSplitToFundDashboardProjector
        send fundSuspended to outlet FundEventSplitToRegulatoryReportingProjector
        tell fundSuspended to entity FundContext.Fund
      }
      on fundResumed: event Fund.FundResumed is {
        send fundResumed to outlet FundEventSplitToFundDashboardProjector
        send fundResumed to outlet FundEventSplitToRegulatoryReportingProjector
        tell fundResumed to entity FundContext.Fund
      }
      on other is {
        error "Unexpected message for processor FundEventSplit"
      }
    } with {
      briefly "Fund event fan-out handler"
      described as {
        |Delivers each Fund event to all of its consumers.
      }
    }
  } with {
    briefly "Fund event fan-out"
    described as {
      |Fans Fund events out to the repository and projectors.
    }
  }
  connector 'FundEvent Stream' is from outlet FundContext.Fund.FundEvents2 to inlet FundContext.FundEventSplit.FundEventSplitIn with {
    briefly "Fund events, fanned out to storage and read models"
  }
  connector 'FundDashboardProjector Feed' is from outlet FundContext.FundEventSplit.FundEventSplitToFundDashboardProjector to inlet FundContext.FundDashboardProjector.FundDashboardProjectorFromFund with {
    briefly "Fund events feeding the FundDashboardProjector projection"
  }
  connector 'RegulatoryReportingProjector Feed' is from outlet FundContext.FundEventSplit.FundEventSplitToRegulatoryReportingProjector to inlet FundContext.RegulatoryReportingProjector.RegulatoryReportingProjectorFromFund with {
    briefly "Fund events feeding the RegulatoryReportingProjector projection"
  }
  connector 'FundDashboardProjector Storage' is from outlet FundContext.FundDashboardProjector.FundDashboardProjectorToRepository to inlet FundContext.FundRepository.FundRepositoryFromFundDashboardProjector with {
    briefly "FundDashboardProjector updates on their way to storage"
  }
} with {
  briefly "Bounded context for fund accounting"
  described as {
    | The FundContext is the primary bounded context for fund
    | accounting operations. It contains the Fund entity, repository
    | for persistence, and projectors for dashboard and regulatory
    | reporting views.
  }
}
