// Fund Accounting Domain Model
// Domain for managing investment fund accounting operations including
// NAV calculations, transaction processing, and regulatory reporting.
domain FundAccounting is {
  persistent connector 'ComplianceContextEvent Stream' is from outlet ComplianceContext.ComplianceContextEventsOut to inlet FundContext.FromComplianceContext.FromComplianceContextIn with {
    briefly "What ComplianceContext tells FundContext, unasked"
  }
  persistent connector 'CustodianContextEvent Stream' is from outlet CustodianContext.CustodianContextEventsOut to inlet FundContext.FromCustodianContext.FromCustodianContextIn with {
    briefly "What CustodianContext tells FundContext, unasked"
  }
  persistent connector 'MarketDataContextEvent Stream' is from outlet MarketDataContext.MarketDataContextEventsOut to inlet FundContext.FromMarketDataContext.FromMarketDataContextIn with {
    briefly "What MarketDataContext tells FundContext, unasked"
  }
  persistent connector 'TransferAgentContextEvent Stream' is from outlet TransferAgentContext.TransferAgentContextEventsOut to inlet FundContext.FromTransferAgentContext.FromTransferAgentContextIn with {
    briefly "What TransferAgentContext tells FundContext, unasked"
  }
  persistent connector 'CustodianContextRequest Stream' is from outlet FundContext.ToCustodianContext.ToCustodianContextOut to inlet CustodianContext.CustodianContextRequests with {
    briefly "What FundContext asks CustodianContext"
  }
  persistent connector 'CustodianContextReply Stream' is from outlet CustodianContext.CustodianContextRepliesOut to inlet FundContext.FromCustodianContext.FromCustodianContextReplies with {
    briefly "What CustodianContext answers FundContext"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
    organization ="Ossum Inc."
    title = "Domain Model Author"
  } with {
    briefly "Primary author and maintainer of this domain model"
    described as {
      | Ossum Inc. is the creator and maintainer of this fund accounting
      | domain model, providing industry-standard patterns for investment
      | management systems.
    }
  }
  user PortfolioManager is "A portfolio manager who oversees fund investments" with {
    briefly "Investment professional managing fund portfolios"
    described as {
      | Portfolio managers are responsible for making investment decisions,
      | monitoring fund performance, and ensuring compliance with fund
      | investment mandates and regulatory requirements.
    }
  }
  user FundAccountant is "An accountant responsible for fund accounting operations" with {
    briefly "Accounting professional handling fund financial records"
    described as {
      | Fund accountants handle daily NAV calculations, transaction
      | processing, reconciliation, and preparation of financial
      | statements for investment funds.
    }
  }
  user ComplianceOfficer is "A compliance officer monitoring regulatory adherence" with {
    briefly "Professional ensuring regulatory compliance"
    described as {
      | Compliance officers monitor fund activities to ensure adherence
      | to regulatory requirements, investment guidelines, and internal
      | policies.
    }
  }
  user Investor is "An investor who has capital invested in funds" with {
    briefly "Individual or institution with fund investments"
    described as {
      | Investors are individuals or institutions who have invested
      | capital in one or more funds and receive periodic statements
      | and distributions.
    }
  }
  include "FundContext.riddl"
  include "external-contexts.riddl"
  epic FundOperations is {
    user FundAccountant wants to "manage daily fund accounting operations" so that "accurate NAV values are calculated and reported"
    case CalculateDailyNAV is {
      user FundAccountant wants to "calculate the daily NAV for a fund" so that "investors know the current value of their holdings"
      step from user FundAccountant "initiates NAV calculation" to input FundAccountingApp.FundAccountingScreen.CalculateNAVInput
      step take input FundAccountingApp.FundAccountingScreen.CalculateNAVInput from user FundAccountant
      step from entity FundContext.Fund "processes market data and calculates NAV" to entity FundContext.Fund
    } with {
      briefly "Process for calculating daily Net Asset Value"
      described as {
        | This use case describes the end-of-day process where a fund
        | accountant initiates the NAV calculation, the system processes
        | current market data and portfolio holdings, and produces the
        | official NAV for the day.
      }
    }
    case ProcessTransaction is {
      user FundAccountant wants to "record a new fund transaction" so that "all portfolio changes are accurately tracked"
      step from user FundAccountant "enters transaction details" to input FundAccountingApp.FundAccountingScreen.RecordTransactionInput
      step take input FundAccountingApp.FundAccountingScreen.RecordTransactionInput from user FundAccountant
      step from entity FundContext.Fund "validates and records transaction" to entity FundContext.Fund
    } with {
      briefly "Process for recording fund transactions"
      described as {
        | This use case covers the recording of transactions such as
        | security purchases, sales, dividends received, and other
        | portfolio activities that affect fund holdings and NAV.
      }
    }
  } with {
    briefly "Epic covering daily fund accounting operations"
    described as {
      | This epic encompasses the core daily operations performed by
      | fund accountants including NAV calculations, transaction
      | processing, reconciliation, and reporting activities.
    }
  }
  application context FundAccountingApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in FundAccounting are delivered.
      }
    }
    group FundAccountingScreen is {
      input GetPerformanceInput acquires query FundContext.Fund.GetPerformance with {
        briefly "Get performance control"
        described as {
          |The control through which a user asks the get performance question.
        }
      }
      input GetHoldingsInput acquires query FundContext.Fund.GetHoldings with {
        briefly "Get holdings control"
        described as {
          |The control through which a user asks the get holdings question.
        }
      }
      input GetNAVHistoryInput acquires query FundContext.Fund.GetNAVHistory with {
        briefly "Get NAV history control"
        described as {
          |The control through which a user asks the get nav history question.
        }
      }
      input GetReportingRecordInput acquires query FundContext.GetReportingRecord with {
        briefly "Get reporting record control"
        described as {
          |The control through which a user asks the get reporting record question.
        }
      }
      input GetDashboardRecordInput acquires query FundContext.GetDashboardRecord with {
        briefly "Get dashboard record control"
        described as {
          |The control through which a user asks the get dashboard record question.
        }
      }
      input GetFundInfoInput acquires query FundContext.Fund.GetFundInfo with {
        briefly "Get fund info control"
        described as {
          |The control through which a user asks the get fund info question.
        }
      }
      input CreateFundInput acquires command FundContext.CreateFund with {
        briefly "Create fund control"
        described as {
          |The control through which a user submits the create fund request.
        }
      }
      output FundCreatedView presents event FundContext.Fund.FundCreated with {
        briefly "The fund created answer"
        described as {
          |What CreateFund brought into being, with the id it was given.
        }
      }
      input ProcessRedemptionInput acquires command FundContext.Fund.ProcessRedemption with {
        briefly "Process redemption control"
        described as {
          |The control through which a user submits the process redemption request.
        }
      }
      input ProcessSubscriptionInput acquires command FundContext.Fund.ProcessSubscription with {
        briefly "Process subscription control"
        described as {
          |The control through which a user submits the process subscription request.
        }
      }
      input ResumeFundInput acquires command FundContext.Fund.ResumeFund with {
        briefly "Resume fund control"
        described as {
          |The control through which a user submits the resume fund request.
        }
      }
      input SuspendFundInput acquires command FundContext.Fund.SuspendFund with {
        briefly "Suspend fund control"
        described as {
          |The control through which a user submits the suspend fund request.
        }
      }
      input UpdateHoldingInput acquires command FundContext.Fund.UpdateHolding with {
        briefly "Update holding control"
        described as {
          |The control through which a user submits the update holding request.
        }
      }
      input CalculateNAVInput acquires command FundContext.Fund.CalculateNAV with {
        briefly "Calculate nav control"
        described as {
          |The control through which a user submits the calculate nav request.
        }
      }
      input RecordTransactionInput acquires command FundContext.Fund.RecordTransaction with {
        briefly "Record transaction control"
        described as {
          |The control through which a user submits the record transaction request.
        }
      }
    } with {
      briefly "Fund accounting screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppFundQueriesPort is type FundContext.Fund.FundQuery
    inlet AppFundReplies is type FundContext.Fund.FundReply
    outlet AppFundRepositoryQueries is type FundContext.FundRepository.FundRepositoryQuery
    inlet AppFundRepositoryReplies is type FundContext.FundRepository.FundRepositoryReply
    outlet AppFundQueries is query FundContext.Fund.GetFundInfo
    outlet AppFundCommands is type FundContext.FundRequest
    inlet AppFundRepositoryResponses is result FundContext.Fund.FundInfoResult
    inlet AppFundCreatedAnswer is event FundContext.Fund.FundCreated
    handler FundAccountingAppHandler is {
      on fundCreated: event FundContext.Fund.FundCreated is {
        put fundCreated to output FundAccountingApp.FundAccountingScreen.FundCreatedView
      }
      on other is {
        error "Unexpected message for application context FundAccountingApp"
      }
    } with {
      briefly "FundAccountingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "FundAccountingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'FundCreated Answer' is from outlet FundContext.FundCreatedAnswerOut to inlet FundAccountingApp.AppFundCreatedAnswer with {
    briefly "The fund created answer, back to the screen that issued CreateFund"
  }
  persistent connector 'FundQuery StreamPort' is from outlet FundAccountingApp.AppFundQueriesPort to inlet FundContext.FundQueriesInPort with {
    briefly "FundAccountingApp's look-ups of the fund"
  }
  persistent connector 'FundReply Stream' is from outlet FundContext.FundRepliesOut to inlet FundAccountingApp.AppFundReplies with {
    briefly "The fund's answers returned to FundAccountingApp"
  }
  persistent connector 'FundRepositoryQuery Stream' is from outlet FundAccountingApp.AppFundRepositoryQueries to inlet FundContext.FundRepositoryQueriesIn with {
    briefly "FundAccountingApp's look-ups of the fund repository"
  }
  persistent connector 'FundRepositoryReply Stream' is from outlet FundContext.FundRepositoryRepliesOut to inlet FundAccountingApp.AppFundRepositoryReplies with {
    briefly "The fund repository's answers returned to FundAccountingApp"
  }
  persistent connector 'FundQuery Stream' is from outlet FundAccountingApp.AppFundQueries to inlet FundContext.FundQueriesIn with {
    briefly "FundAccountingApp's look-ups of the fund"
  }
  persistent connector 'FundCommand Stream' is from outlet FundAccountingApp.AppFundCommands to inlet FundContext.FundCommandStreamIn with {
    briefly "Fund commands from the application"
  }
  persistent connector 'FundInfoResult Stream' is from outlet FundContext.FundInfoResultStreamOut to inlet FundAccountingApp.AppFundRepositoryResponses with {
    briefly "Fund query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet FundAccountingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Domain model for investment fund accounting"
  described as {
    | The Fund Accounting domain provides a comprehensive model for
    | managing investment fund operations. It supports daily NAV
    | calculations, transaction processing, investor accounting,
    | regulatory reporting, and integration with market data providers
    | and custodian systems.
  }
}
