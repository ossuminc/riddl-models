// Client Reporting - Reporting Context
context ReportingContext as router is {
  inlet ClientReportCommandStreamIn is type ClientReportCommand  outlet ClientReportCommandStreamOut is type ClientReportCommand
  inlet ClientReportResultStreamIn is result ClientReport.ClientReportResult  outlet ClientReportResultStreamOut is result ClientReport.ClientReportResult
  handler ReportingContextBoundary is {
    on generateReport: command ClientReport.GenerateReport is {
      send generateReport to outlet ReportingContext.ClientReportCommandStreamOut
    }
    on attachPortfolioData: command ClientReport.AttachPortfolioData is {
      send attachPortfolioData to outlet ReportingContext.ClientReportCommandStreamOut
    }
    on calculatePerformance: command ClientReport.CalculatePerformance is {
      send calculatePerformance to outlet ReportingContext.ClientReportCommandStreamOut
    }
    on composeReport: command ClientReport.ComposeReport is {
      send composeReport to outlet ReportingContext.ClientReportCommandStreamOut
    }
    on approveReport: command ClientReport.ApproveReport is {
      send approveReport to outlet ReportingContext.ClientReportCommandStreamOut
    }
    on distributeReport: command ClientReport.DistributeReport is {
      send distributeReport to outlet ReportingContext.ClientReportCommandStreamOut
    }
    on failReport: command ClientReport.FailReport is {
      send failReport to outlet ReportingContext.ClientReportCommandStreamOut
    }
    on archiveReport: command ClientReport.ArchiveReport is {
      send archiveReport to outlet ReportingContext.ClientReportCommandStreamOut
    }
    on clientReportResult: result ClientReport.ClientReportResult is {
      send clientReportResult to outlet ReportingContext.ClientReportResultStreamOut
    }
    on other is {
      error "Unexpected message at the ReportingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ClientReportCommand Stream Intake' is from outlet ReportingContext.ClientReportCommandStreamOut to inlet ReportingContext.ClientReport.ClientReportCommands  connector 'ClientReportResult Stream Egress' is from outlet ReportingContext.ReportingRepository.ReportingRepositoryResponses to inlet ReportingContext.ClientReportResultStreamIn  adaptor FromComplianceRegistry from context ComplianceRegistry is { 
    handler FromComplianceRegistryHandler is {
      on event ComplianceRegistry.DistributionLogged is {
        do "the model receives distribution logged"
      }
      on result ComplianceRegistry.RequiredDisclosures is {
        do "the model receives required disclosures"
      }
      on other is {
        error "Unexpected message for adaptor FromComplianceRegistry"
      }
    } with {
      briefly "from compliance registry"
      described as {
        |Carries messages from the external ComplianceRegistry.
      }
    }
  } with {
    briefly "ComplianceRegistry integration"
    described as {
      |The model's side of the ComplianceRegistry conversation.
    }
  }
  adaptor ToComplianceRegistry to context ComplianceRegistry is { 
    handler ToComplianceRegistryHandler is {
      on query ComplianceRegistry.GetRequiredDisclosures is {
        do "the model sends get required disclosures"
      }
      on command ComplianceRegistry.LogReportDistribution is {
        do "the model sends log report distribution"
      }
      on other is {
        error "Unexpected message for adaptor ToComplianceRegistry"
      }
    } with {
      briefly "to compliance registry"
      described as {
        |Carries messages to the external ComplianceRegistry.
      }
    }
  } with {
    briefly "ComplianceRegistry integration"
    described as {
      |The model's side of the ComplianceRegistry conversation.
    }
  }
  adaptor FromMarketDataProvider from context MarketDataProvider is { 
    handler FromMarketDataProviderHandler is {
      on result MarketDataProvider.BenchmarkReturns is {
        do "the model receives benchmark returns"
      }
      on result MarketDataProvider.SecurityPrices is {
        do "the model receives security prices"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketDataProvider"
      }
    } with {
      briefly "from market data provider"
      described as {
        |Carries messages from the external MarketDataProvider.
      }
    }
  } with {
    briefly "MarketDataProvider integration"
    described as {
      |The model's side of the MarketDataProvider conversation.
    }
  }
  adaptor ToMarketDataProvider to context MarketDataProvider is { 
    handler ToMarketDataProviderHandler is {
      on query MarketDataProvider.GetBenchmarkReturns is {
        do "the model sends get benchmark returns"
      }
      on query MarketDataProvider.GetSecurityPrices is {
        do "the model sends get security prices"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketDataProvider"
      }
    } with {
      briefly "to market data provider"
      described as {
        |Carries messages to the external MarketDataProvider.
      }
    }
  } with {
    briefly "MarketDataProvider integration"
    described as {
      |The model's side of the MarketDataProvider conversation.
    }
  }
  adaptor FromPortfolioSystem from context PortfolioSystem is { 
    handler FromPortfolioSystemHandler is {
      on result PortfolioSystem.AccountInfo is {
        do "the model receives account info"
      }
      on result PortfolioSystem.PortfolioHoldings is {
        do "the model receives portfolio holdings"
      }
      on result PortfolioSystem.TransactionHistory is {
        do "the model receives transaction history"
      }
      on other is {
        error "Unexpected message for adaptor FromPortfolioSystem"
      }
    } with {
      briefly "from portfolio system"
      described as {
        |Carries messages from the external PortfolioSystem.
      }
    }
  } with {
    briefly "PortfolioSystem integration"
    described as {
      |The model's side of the PortfolioSystem conversation.
    }
  }
  adaptor ToPortfolioSystem to context PortfolioSystem is { 
    handler ToPortfolioSystemHandler is {
      on query PortfolioSystem.GetAccountInfo is {
        do "the model sends get account info"
      }
      on query PortfolioSystem.GetPortfolioHoldings is {
        do "the model sends get portfolio holdings"
      }
      on query PortfolioSystem.GetTransactionHistory is {
        do "the model sends get transaction history"
      }
      on other is {
        error "Unexpected message for adaptor ToPortfolioSystem"
      }
    } with {
      briefly "to portfolio system"
      described as {
        |Carries messages to the external PortfolioSystem.
      }
    }
  } with {
    briefly "PortfolioSystem integration"
    described as {
      |The model's side of the PortfolioSystem conversation.
    }
  }
  include "types.riddl"
  include "ClientReport.riddl"
  type ReportingRepositoryCommand is one of {
    ReportingContext.ReportingRepository.PersistPerformanceCalculated or ReportingContext.ReportingRepository.PersistPortfolioDataAttached or ReportingContext.ReportingRepository.PersistReportApproved or ReportingContext.ReportingRepository.PersistReportArchived or ReportingContext.ReportingRepository.PersistReportComposed or ReportingContext.ReportingRepository.PersistReportDistributed or ReportingContext.ReportingRepository.PersistReportFailed or ReportingContext.ReportingRepository.PersistReportGenerated
  } with {
    briefly "Anything that writes ReportingRepository"
    described as {
      |The persistence commands ReportingRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ReportingRepository as flow is {
    inlet ReportingRepositoryFromReportingMetrics is type ReportingRepositoryCommand    command PersistPerformanceCalculated is  {
      reportId: ClientReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row PerformanceCalculated applies to.
        }
      }
    } with {
      briefly "Persist PerformanceCalculated"
      described as {
        |Instructs this repository to apply PerformanceCalculated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPortfolioDataAttached is  {
      reportId: ClientReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row PortfolioDataAttached applies to.
        }
      }
    } with {
      briefly "Persist PortfolioDataAttached"
      described as {
        |Instructs this repository to apply PortfolioDataAttached to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportApproved is  {
      reportId: ClientReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportApproved applies to.
        }
      }
    } with {
      briefly "Persist ReportApproved"
      described as {
        |Instructs this repository to apply ReportApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportArchived is  {
      reportId: ClientReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportArchived applies to.
        }
      }
    } with {
      briefly "Persist ReportArchived"
      described as {
        |Instructs this repository to apply ReportArchived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportComposed is  {
      reportId: ClientReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportComposed applies to.
        }
      }
    } with {
      briefly "Persist ReportComposed"
      described as {
        |Instructs this repository to apply ReportComposed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportDistributed is  {
      reportId: ClientReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportDistributed applies to.
        }
      }
    } with {
      briefly "Persist ReportDistributed"
      described as {
        |Instructs this repository to apply ReportDistributed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportFailed is  {
      reportId: ClientReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportFailed applies to.
        }
      }
    } with {
      briefly "Persist ReportFailed"
      described as {
        |Instructs this repository to apply ReportFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportGenerated is  {
      reportId: ClientReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportGenerated applies to.
        }
      }
    } with {
      briefly "Persist ReportGenerated"
      described as {
        |Instructs this repository to apply ReportGenerated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ReportingRepositoryResponses is result ClientReport.ClientReportResult
    record StoredClientReport is  {
      clientReportId: ClientReportId with {
        briefly "clientReportId"
        described as {
          |The clientReportId column of the stored clientReport row.
        }
      }
      reportId: ClientReportId with {
        briefly "reportId"
        described as {
          |The reportId column of the stored clientReport row.
        }
      }
      request: ReportRequest with {
        briefly "request"
        described as {
          |The request column of the stored clientReport row.
        }
      }
      status: ReportStatus with {
        briefly "status"
        described as {
          |The status column of the stored clientReport row.
        }
      }
    } with {
      briefly "Stored clientReport row"
      described as {
        |The persistence shape of clientReport data as this repository stores it.
      }
    }
    schema ReportingData is relational
      of clientReports as record StoredClientReport
        index on field StoredClientReport.reportId
        index on field StoredClientReport.request.clientId
        index on field StoredClientReport.status
 with {
      briefly "Reporting data schema"
      described as {
        |The relational schema holding reporting data for the ReportingRepository.
      }
    }
    handler ReportingPersistence is {
      on persistPerformanceCalculated: command PersistPerformanceCalculated is {
        do "apply PerformanceCalculated to the stored row"
      }
      on persistPortfolioDataAttached: command PersistPortfolioDataAttached is {
        do "apply PortfolioDataAttached to the stored row"
      }
      on persistReportApproved: command PersistReportApproved is {
        do "apply ReportApproved to the stored row"
      }
      on persistReportArchived: command PersistReportArchived is {
        do "apply ReportArchived to the stored row"
      }
      on persistReportComposed: command PersistReportComposed is {
        do "apply ReportComposed to the stored row"
      }
      on persistReportDistributed: command PersistReportDistributed is {
        do "apply ReportDistributed to the stored row"
      }
      on persistReportFailed: command PersistReportFailed is {
        do "apply ReportFailed to the stored row"
      }
      on persistReportGenerated: command PersistReportGenerated is {
        do "apply ReportGenerated to the stored row"
      }
      on query GetClientReportMetrics is {
        let clientReportMetricsView: type ClientReportMetricsView = prompt("read the client report metrics projection")
        reply clientReportMetricsView
      }
    } with {
      briefly "Persists reporting commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Reporting data persistence"
    described as {
      |Persistent storage for client reports.
    }
  }
  query GetClientReportMetrics replies result ClientReportMetricsView is  {
    clientReportMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which client report metrics to retrieve.
      }
    }
  } with {
    briefly "Get client report metrics"
    described as {
      |Retrieves the client report metrics projection.
    }
  }
  result ClientReportMetricsView is  {
    clientReportMetrics: ReportingMetrics.ClientReportMetrics with {
      briefly "Client report metrics"
      described as {
        |The client report metrics being returned.
      }
    }
  } with {
    briefly "Client report metrics view"
    described as {
      |Read model view carrying the client report metrics projection.
    }
  }
  projector ReportingMetrics as flow is {
    updates repository ReportingContext.ReportingRepository
    outlet ReportingMetricsToRepository is type ReportingRepositoryCommand
    inlet ReportingMetricsFromClientReport is type ClientReportEvent    record ClientReportMetrics is  {
      reportsGenerated: Natural with {
        briefly "Generated"
        described as {
          |Reports generated.
        }
      }
      reportsDistributed: Natural with {
        briefly "Distributed"
        described as {
          |Reports distributed.
        }
      }
      reportsFailed: Natural with {
        briefly "Failed"
        described as {
          |Reports failed.
        }
      }
      averageProcessingTime: Decimal(8,2) with {
        briefly "Avg time"
        described as {
          |Average processing hours.
        }
      }
    } with {
      briefly "Client report metrics"
      described as {
        |Report processing metrics.
      }
    }
    handler MetricsHandler is {
      on performanceCalculated: event ClientReport.PerformanceCalculated is {
        tell command ReportingContext.ReportingRepository.PersistPerformanceCalculated(reportId = performanceCalculated.reportId) to repository ReportingContext.ReportingRepository
        do "apply PerformanceCalculated to the ReportingMetrics projection"
      }
      on portfolioDataAttached: event ClientReport.PortfolioDataAttached is {
        tell command ReportingContext.ReportingRepository.PersistPortfolioDataAttached(reportId = portfolioDataAttached.reportId) to repository ReportingContext.ReportingRepository
        do "apply PortfolioDataAttached to the ReportingMetrics projection"
      }
      on reportApproved: event ClientReport.ReportApproved is {
        tell command ReportingContext.ReportingRepository.PersistReportApproved(reportId = reportApproved.reportId) to repository ReportingContext.ReportingRepository
        do "apply ReportApproved to the ReportingMetrics projection"
      }
      on reportArchived: event ClientReport.ReportArchived is {
        tell command ReportingContext.ReportingRepository.PersistReportArchived(reportId = reportArchived.reportId) to repository ReportingContext.ReportingRepository
        do "apply ReportArchived to the ReportingMetrics projection"
      }
      on reportComposed: event ClientReport.ReportComposed is {
        tell command ReportingContext.ReportingRepository.PersistReportComposed(reportId = reportComposed.reportId) to repository ReportingContext.ReportingRepository
        do "apply ReportComposed to the ReportingMetrics projection"
      }
      on reportGenerated: event ClientReport.ReportGenerated is {
        tell command ReportingContext.ReportingRepository.PersistReportGenerated(reportId = reportGenerated.reportId) to repository ReportingContext.ReportingRepository
      }
      on reportDistributed: event ClientReport.ReportDistributed is {
        tell command ReportingContext.ReportingRepository.PersistReportDistributed(reportId = reportDistributed.reportId) to repository ReportingContext.ReportingRepository
      }
      on reportFailed: event ClientReport.ReportFailed is {
        tell command ReportingContext.ReportingRepository.PersistReportFailed(reportId = reportFailed.reportId) to repository ReportingContext.ReportingRepository
      }
    } with {
      briefly "Maintains reporting metrics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Reporting metrics"
    described as {
      |Client reporting analytics.
    }
  }
  processor ClientReportEventSplit as flow is {
    inlet ClientReportEventSplitIn is type ClientReportEvent    outlet ClientReportEventSplitToReportingMetrics is type ClientReportEvent
    handler ClientReportEventSplitHandler is {
      on reportGenerated: event ClientReport.ReportGenerated is {
        send reportGenerated to outlet ClientReportEventSplitToReportingMetrics
        tell reportGenerated to entity ReportingContext.ClientReport
      }
      on portfolioDataAttached: event ClientReport.PortfolioDataAttached is {
        send portfolioDataAttached to outlet ClientReportEventSplitToReportingMetrics
        tell portfolioDataAttached to entity ReportingContext.ClientReport
      }
      on performanceCalculated: event ClientReport.PerformanceCalculated is {
        send performanceCalculated to outlet ClientReportEventSplitToReportingMetrics
        tell performanceCalculated to entity ReportingContext.ClientReport
      }
      on reportComposed: event ClientReport.ReportComposed is {
        send reportComposed to outlet ClientReportEventSplitToReportingMetrics
        tell reportComposed to entity ReportingContext.ClientReport
      }
      on reportApproved: event ClientReport.ReportApproved is {
        send reportApproved to outlet ClientReportEventSplitToReportingMetrics
        tell reportApproved to entity ReportingContext.ClientReport
      }
      on reportDistributed: event ClientReport.ReportDistributed is {
        send reportDistributed to outlet ClientReportEventSplitToReportingMetrics
        tell reportDistributed to entity ReportingContext.ClientReport
      }
      on reportFailed: event ClientReport.ReportFailed is {
        send reportFailed to outlet ClientReportEventSplitToReportingMetrics
        tell reportFailed to entity ReportingContext.ClientReport
      }
      on reportArchived: event ClientReport.ReportArchived is {
        send reportArchived to outlet ClientReportEventSplitToReportingMetrics
        tell reportArchived to entity ReportingContext.ClientReport
      }
      on other is {
        error "Unexpected message for processor ClientReportEventSplit"
      }
    } with {
      briefly "ClientReport event fan-out handler"
      described as {
        |Delivers each ClientReport event to all of its consumers.
      }
    }
  } with {
    briefly "ClientReport event fan-out"
    described as {
      |Fans ClientReport events out to the repository and projectors.
    }
  }
  connector 'ClientReportEvent Stream' is from outlet ReportingContext.ClientReport.ClientReportEvents2 to inlet ReportingContext.ClientReportEventSplit.ClientReportEventSplitIn with {
    briefly "ClientReport events, fanned out to storage and read models"
  }
  connector 'ReportingMetrics Feed' is from outlet ReportingContext.ClientReportEventSplit.ClientReportEventSplitToReportingMetrics to inlet ReportingContext.ReportingMetrics.ReportingMetricsFromClientReport with {
    briefly "ClientReport events feeding the ReportingMetrics projection"
  }
  connector 'ReportingMetrics Storage' is from outlet ReportingContext.ReportingMetrics.ReportingMetricsToRepository to inlet ReportingContext.ReportingRepository.ReportingRepositoryFromReportingMetrics with {
    briefly "ReportingMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for client reporting"
  described as {
    |Investment client reporting context.
  }
}
