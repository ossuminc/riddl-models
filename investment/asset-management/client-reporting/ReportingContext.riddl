// Client Reporting - Reporting Context
context ReportingContext is {
  adaptor FromComplianceRegistry from context ComplianceRegistry is {
    handler FromComplianceRegistryHandler is {
      on event ComplianceRegistry.DistributionLogged is {
        do "the model receives distribution logged"
      }
      on result ComplianceRegistry.RequiredDisclosures is {
        do "the model receives required disclosures"
      }
      on other is {
        error "Unexpected message for adaptor FromComplianceRegistry"
      }
    } with {
      briefly "from compliance registry"
      described as {
        |Carries messages from the external ComplianceRegistry.
      }
    }
  } with {
      briefly "ComplianceRegistry integration"
    described as {
      |The model's side of the ComplianceRegistry conversation.
    }
  }
  adaptor ToComplianceRegistry to context ComplianceRegistry is {
    handler ToComplianceRegistryHandler is {
      on query ComplianceRegistry.GetRequiredDisclosures is {
        do "the model sends get required disclosures"
      }
      on command ComplianceRegistry.LogReportDistribution is {
        do "the model sends log report distribution"
      }
      on other is {
        error "Unexpected message for adaptor ToComplianceRegistry"
      }
    } with {
      briefly "to compliance registry"
      described as {
        |Carries messages to the external ComplianceRegistry.
      }
    }
  } with {
      briefly "ComplianceRegistry integration"
    described as {
      |The model's side of the ComplianceRegistry conversation.
    }
  }
  adaptor FromMarketDataProvider from context MarketDataProvider is {
    handler FromMarketDataProviderHandler is {
      on result MarketDataProvider.BenchmarkReturns is {
        do "the model receives benchmark returns"
      }
      on result MarketDataProvider.SecurityPrices is {
        do "the model receives security prices"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketDataProvider"
      }
    } with {
      briefly "from market data provider"
      described as {
        |Carries messages from the external MarketDataProvider.
      }
    }
  } with {
      briefly "MarketDataProvider integration"
    described as {
      |The model's side of the MarketDataProvider conversation.
    }
  }
  adaptor ToMarketDataProvider to context MarketDataProvider is {
    handler ToMarketDataProviderHandler is {
      on query MarketDataProvider.GetBenchmarkReturns is {
        do "the model sends get benchmark returns"
      }
      on query MarketDataProvider.GetSecurityPrices is {
        do "the model sends get security prices"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketDataProvider"
      }
    } with {
      briefly "to market data provider"
      described as {
        |Carries messages to the external MarketDataProvider.
      }
    }
  } with {
      briefly "MarketDataProvider integration"
    described as {
      |The model's side of the MarketDataProvider conversation.
    }
  }
  adaptor FromPortfolioSystem from context PortfolioSystem is {
    handler FromPortfolioSystemHandler is {
      on result PortfolioSystem.AccountInfo is {
        do "the model receives account info"
      }
      on result PortfolioSystem.PortfolioHoldings is {
        do "the model receives portfolio holdings"
      }
      on result PortfolioSystem.TransactionHistory is {
        do "the model receives transaction history"
      }
      on other is {
        error "Unexpected message for adaptor FromPortfolioSystem"
      }
    } with {
      briefly "from portfolio system"
      described as {
        |Carries messages from the external PortfolioSystem.
      }
    }
  } with {
      briefly "PortfolioSystem integration"
    described as {
      |The model's side of the PortfolioSystem conversation.
    }
  }
  adaptor ToPortfolioSystem to context PortfolioSystem is {
    handler ToPortfolioSystemHandler is {
      on query PortfolioSystem.GetAccountInfo is {
        do "the model sends get account info"
      }
      on query PortfolioSystem.GetPortfolioHoldings is {
        do "the model sends get portfolio holdings"
      }
      on query PortfolioSystem.GetTransactionHistory is {
        do "the model sends get transaction history"
      }
      on other is {
        error "Unexpected message for adaptor ToPortfolioSystem"
      }
    } with {
      briefly "to portfolio system"
      described as {
        |Carries messages to the external PortfolioSystem.
      }
    }
  } with {
      briefly "PortfolioSystem integration"
    described as {
      |The model's side of the PortfolioSystem conversation.
    }
  }
  include "types.riddl"
  include "ClientReport.riddl"
  repository ReportingRepository is {
    inlet ReportingRepositoryFromClientReport is type ClientReportEvent
    inlet ReportingRepositoryFromReportingMetrics is type ClientReportEvent
    outlet ReportingRepositoryResponses is type ClientReport.ClientReportResult
    record StoredClientReport is {
      clientReportId: ClientReportId with {
        briefly "clientReportId"
        described as {
          |The clientReportId column of the stored clientReport row.
        }
      }
      reportId: ClientReportId with {
        briefly "reportId"
        described as {
          |The reportId column of the stored clientReport row.
        }
      }
      request: ReportRequest with {
        briefly "request"
        described as {
          |The request column of the stored clientReport row.
        }
      }
      status: ReportStatus with {
        briefly "status"
        described as {
          |The status column of the stored clientReport row.
        }
      }
    } with {
      briefly "Stored clientReport row"
      described as {
        |The persistence shape of clientReport data as this repository stores it.
      }
    }
    schema ReportingData is relational
      of clientReports as type StoredClientReport
        index on field StoredClientReport.reportId
        index on field StoredClientReport.request.clientId
        index on field StoredClientReport.status
      with {
      briefly "Reporting data schema"
      described as {
        |The relational schema holding reporting data for the ReportingRepository.
      }
    }

    handler ReportingPersistence is {
      on query GetClientReportMetrics is {
        do "read the client report metrics projection"
        yield result ClientReportMetricsView
      }
      on command ClientReport.GenerateReport is {
        tell event ClientReport.ReportGenerated to entity ReportingContext.ClientReport
      }
      on command ClientReport.AttachPortfolioData is {
        tell event ClientReport.PortfolioDataAttached to entity ReportingContext.ClientReport
      }
      on command ClientReport.CalculatePerformance is {
        tell event ClientReport.PerformanceCalculated to entity ReportingContext.ClientReport
      }
      on command ClientReport.ApproveReport is {
        tell event ClientReport.ReportApproved to entity ReportingContext.ClientReport
      }
      on command ClientReport.DistributeReport is {
        tell event ClientReport.ReportDistributed to entity ReportingContext.ClientReport
      }
    } with {
      briefly "Persists reporting commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Reporting data persistence"
    described as {
      |Persistent storage for client reports.
    }
  }
  query GetClientReportMetrics is {
    clientReportMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which client report metrics to retrieve.
      }
    }
  } with {
    briefly "Get client report metrics"
    described as {
      |Retrieves the client report metrics projection.
    }
  }
  result ClientReportMetricsView is {
    clientReportMetrics: ReportingMetrics.ClientReportMetrics with {
      briefly "Client report metrics"
      described as {
        |The client report metrics being returned.
      }
    }
  } with {
    briefly "Client report metrics view"
    described as {
      |Read model view carrying the client report metrics projection.
    }
  }
  projector ReportingMetrics is {
    inlet ReportingMetricsFromClientReport is type ClientReportEvent
    outlet ReportingMetricsOut is type ClientReportEvent
    updates repository ReportingContext.ReportingRepository
    record ClientReportMetrics is  {
      reportsGenerated: Natural with {
        briefly "Generated"
        described as {
          |Reports generated.
        }
      }
      reportsDistributed: Natural with {
        briefly "Distributed"
        described as {
          |Reports distributed.
        }
      }
      reportsFailed: Natural with {
        briefly "Failed"
        described as {
          |Reports failed.
        }
      }
      averageProcessingTime: Decimal(8,2) with {
        briefly "Avg time"
        described as {
          |Average processing hours.
        }
      }
    } with {
      briefly "Client report metrics"
      described as {
        |Report processing metrics.
      }
    }
    handler MetricsHandler is {
      on event ClientReport.ReportGenerated is {
        tell event ClientReport.ReportGenerated to repository ReportingContext.ReportingRepository
      }
      on event ClientReport.ReportDistributed is {
        tell event ClientReport.ReportDistributed to repository ReportingContext.ReportingRepository
      }
      on event ClientReport.ReportFailed is {
        tell event ClientReport.ReportFailed to repository ReportingContext.ReportingRepository
      }
    } with {
      briefly "Maintains reporting metrics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Reporting metrics"
    described as {
      |Client reporting analytics.
    }
  }
  processor ClientReportSource as source is {
    outlet ClientReportEvents is type ClientReportEvent
    handler ClientReportSourceHandler is {
      on init is {
        tell command ClientReport.InitializeClientReport to entity ReportingContext.ClientReport
      }
      on other is {
        error "Unexpected message for source ClientReportSource"
      }
      on event ClientReport.ReportGenerated is {
        send event ClientReport.ReportGenerated to outlet ClientReportEvents
      }
      on event ClientReport.ReportDistributed is {
        send event ClientReport.ReportDistributed to outlet ClientReportEvents
      }
      on event ClientReport.ReportFailed is {
        send event ClientReport.ReportFailed to outlet ClientReportEvents
      }
      on event ClientReport.ReportArchived is {
        send event ClientReport.ReportArchived to outlet ClientReportEvents
      }
    } with {
      briefly "Client report source handler"
      described as {
        |Handles client report events and sends to outlet.
      }
    }
  } with {
    briefly "Client report event source"
    described as {
      |Publishes client report entity events.
    }
  }
  processor ClientReportSink as sink is {
    inlet ClientReportInlet is type ClientReportEvent
    handler ClientReportSinkHandler is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink ClientReportSink"
      }
      on event ClientReport.ReportGenerated is {
        tell event ClientReport.ReportGenerated to repository ReportingContext.ReportingRepository
      }
      on event ClientReport.ReportDistributed is {
        tell event ClientReport.ReportDistributed to repository ReportingContext.ReportingRepository
      }
      on event ClientReport.ReportFailed is {
        tell event ClientReport.ReportFailed to repository ReportingContext.ReportingRepository
      }
    } with {
      briefly "Client report sink handler"
      described as {
        |Receives client report events and persists them.
      }
    }
  } with {
    briefly "Client report event sink"
    described as {
      |Receives client report events for persistence.
    }
  }
  connector ClientReportFlow is {
    from outlet ReportingContext.ClientReportSource.ClientReportEvents to
      inlet ReportingContext.ClientReportSink.ClientReportInlet
  } with {
    briefly "Client report event flow"
    described as {
      |Connects client report source to sink.
    }
  }
  processor ClientReportEventSplit is {
    inlet ClientReportEventSplitIn is type ClientReportEvent
    outlet ClientReportEventSplitToReportingRepository is type ClientReportEvent
    outlet ClientReportEventSplitToReportingMetrics is type ClientReportEvent
    handler ClientReportEventSplitHandler is {
      on event ClientReport.ReportGenerated is {
        send event ClientReport.ReportGenerated to outlet ClientReportEventSplitToReportingRepository
        send event ClientReport.ReportGenerated to outlet ClientReportEventSplitToReportingMetrics
        tell event ClientReport.ReportGenerated to entity ReportingContext.ClientReport
      }
      on event ClientReport.PortfolioDataAttached is {
        send event ClientReport.PortfolioDataAttached to outlet ClientReportEventSplitToReportingRepository
        send event ClientReport.PortfolioDataAttached to outlet ClientReportEventSplitToReportingMetrics
        tell event ClientReport.PortfolioDataAttached to entity ReportingContext.ClientReport
      }
      on event ClientReport.PerformanceCalculated is {
        send event ClientReport.PerformanceCalculated to outlet ClientReportEventSplitToReportingRepository
        send event ClientReport.PerformanceCalculated to outlet ClientReportEventSplitToReportingMetrics
        tell event ClientReport.PerformanceCalculated to entity ReportingContext.ClientReport
      }
      on event ClientReport.ReportComposed is {
        send event ClientReport.ReportComposed to outlet ClientReportEventSplitToReportingRepository
        send event ClientReport.ReportComposed to outlet ClientReportEventSplitToReportingMetrics
        tell event ClientReport.ReportComposed to entity ReportingContext.ClientReport
      }
      on event ClientReport.ReportApproved is {
        send event ClientReport.ReportApproved to outlet ClientReportEventSplitToReportingRepository
        send event ClientReport.ReportApproved to outlet ClientReportEventSplitToReportingMetrics
        tell event ClientReport.ReportApproved to entity ReportingContext.ClientReport
      }
      on event ClientReport.ReportDistributed is {
        send event ClientReport.ReportDistributed to outlet ClientReportEventSplitToReportingRepository
        send event ClientReport.ReportDistributed to outlet ClientReportEventSplitToReportingMetrics
        tell event ClientReport.ReportDistributed to entity ReportingContext.ClientReport
      }
      on event ClientReport.ReportFailed is {
        send event ClientReport.ReportFailed to outlet ClientReportEventSplitToReportingRepository
        send event ClientReport.ReportFailed to outlet ClientReportEventSplitToReportingMetrics
        tell event ClientReport.ReportFailed to entity ReportingContext.ClientReport
      }
      on event ClientReport.ReportArchived is {
        send event ClientReport.ReportArchived to outlet ClientReportEventSplitToReportingRepository
        send event ClientReport.ReportArchived to outlet ClientReportEventSplitToReportingMetrics
        tell event ClientReport.ReportArchived to entity ReportingContext.ClientReport
      }
      on other is {
        error "Unexpected message for processor ClientReportEventSplit"
      }
    } with {
      briefly "ClientReport event fan-out handler"
      described as {
        |Delivers each ClientReport event to all of its consumers.
      }
    }
  } with {
    briefly "ClientReport event fan-out"
    described as {
      |Fans ClientReport events out to the repository and projectors.
    }
  }
  connector LinkClientReportToClientReportEventSplit is {
    from outlet ReportingContext.ClientReport.ClientReportEvents2 to
      inlet ReportingContext.ClientReportEventSplit.ClientReportEventSplitIn
  } with {
    briefly "LinkClientReportToClientReportEventSplit"
  }
  connector LinkClientReportEventSplitToReportingRepository is {
    from outlet ReportingContext.ClientReportEventSplit.ClientReportEventSplitToReportingRepository to
      inlet ReportingContext.ReportingRepository.ReportingRepositoryFromClientReport
  } with {
    briefly "LinkClientReportEventSplitToReportingRepository"
  }
  connector LinkClientReportEventSplitToReportingMetrics is {
    from outlet ReportingContext.ClientReportEventSplit.ClientReportEventSplitToReportingMetrics to
      inlet ReportingContext.ReportingMetrics.ReportingMetricsFromClientReport
  } with {
    briefly "LinkClientReportEventSplitToReportingMetrics"
  }
  connector LinkReportingMetricsToReportingRepository is {
    from outlet ReportingContext.ReportingMetrics.ReportingMetricsOut to
      inlet ReportingContext.ReportingRepository.ReportingRepositoryFromReportingMetrics
  } with {
    briefly "LinkReportingMetricsToReportingRepository"
  }
} with {
  briefly "Bounded context for client reporting"
  described as {
    |Investment client reporting context.
  }
}
