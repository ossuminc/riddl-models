// Investment Portfolio - Portfolio Context
context PortfolioContext as router is {
  inlet PortfolioCommandStreamIn is type PortfolioCommand  outlet PortfolioCommandStreamOut is type PortfolioCommand
  inlet PortfolioCompanyResultStreamIn is result Portfolio.PortfolioResult  outlet PortfolioCompanyResultStreamOut is result Portfolio.PortfolioResult
  handler PortfolioContextBoundary is {
    on createPortfolio: command Portfolio.CreatePortfolio is {
      send createPortfolio to outlet PortfolioContext.PortfolioCommandStreamOut
    }
    on updateAllocations: command Portfolio.UpdateAllocations is {
      send updateAllocations to outlet PortfolioContext.PortfolioCommandStreamOut
    }
    on rebalancePortfolio: command Portfolio.RebalancePortfolio is {
      send rebalancePortfolio to outlet PortfolioContext.PortfolioCommandStreamOut
    }
    on executeTrade: command Portfolio.ExecuteTrade is {
      send executeTrade to outlet PortfolioContext.PortfolioCommandStreamOut
    }
    on recordTradeFill: command Portfolio.RecordTradeFill is {
      send recordTradeFill to outlet PortfolioContext.PortfolioCommandStreamOut
    }
    on analyzeRisk: command Portfolio.AnalyzeRisk is {
      send analyzeRisk to outlet PortfolioContext.PortfolioCommandStreamOut
    }
    on compareBenchmark: command Portfolio.CompareBenchmark is {
      send compareBenchmark to outlet PortfolioContext.PortfolioCommandStreamOut
    }
    on suspendPortfolio: command Portfolio.SuspendPortfolio is {
      send suspendPortfolio to outlet PortfolioContext.PortfolioCommandStreamOut
    }
    on closePortfolio: command Portfolio.ClosePortfolio is {
      send closePortfolio to outlet PortfolioContext.PortfolioCommandStreamOut
    }
    on portfolioResult: result Portfolio.PortfolioResult is {
      send portfolioResult to outlet PortfolioContext.PortfolioCompanyResultStreamOut
    }
    on other is {
      error "Unexpected message at the PortfolioContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PortfolioCommand Stream Intake' is from outlet PortfolioContext.PortfolioCommandStreamOut to inlet PortfolioContext.Portfolio.PortfolioCommands  connector 'PortfolioCompanyResult Stream Egress' is from outlet PortfolioContext.PortfolioRepository.PortfolioRepositoryResponses to inlet PortfolioContext.PortfolioCompanyResultStreamIn  adaptor FromMarketDataFeed from context MarketDataFeed is { 
    handler FromMarketDataFeedHandler is {
      on result MarketDataFeed.BenchmarkReturn is {
        do "the model receives benchmark return"
      }
      on event MarketDataFeed.PriceUpdated is {
        do "the model receives price updated"
      }
      on result MarketDataFeed.SecurityPrice is {
        do "the model receives security price"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketDataFeed"
      }
    } with {
      briefly "from market data feed"
      described as {
        |Carries messages from the external MarketDataFeed.
      }
    }
  } with {
    briefly "MarketDataFeed integration"
    described as {
      |The model's side of the MarketDataFeed conversation.
    }
  }
  adaptor ToMarketDataFeed to context MarketDataFeed is { 
    handler ToMarketDataFeedHandler is {
      on query MarketDataFeed.GetBenchmarkReturn is {
        do "the model sends get benchmark return"
      }
      on query MarketDataFeed.GetSecurityPrice is {
        do "the model sends get security price"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketDataFeed"
      }
    } with {
      briefly "to market data feed"
      described as {
        |Carries messages to the external MarketDataFeed.
      }
    }
  } with {
    briefly "MarketDataFeed integration"
    described as {
      |The model's side of the MarketDataFeed conversation.
    }
  }
  adaptor FromTradingSystem from context TradingSystem is { 
    handler FromTradingSystemHandler is {
      on event TradingSystem.OrderFilled is {
        do "the model receives order filled"
      }
      on event TradingSystem.OrderRejected is {
        do "the model receives order rejected"
      }
      on event TradingSystem.OrderSubmitted is {
        do "the model receives order submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromTradingSystem"
      }
    } with {
      briefly "from trading system"
      described as {
        |Carries messages from the external TradingSystem.
      }
    }
  } with {
    briefly "TradingSystem integration"
    described as {
      |The model's side of the TradingSystem conversation.
    }
  }
  adaptor ToTradingSystem to context TradingSystem is { 
    handler ToTradingSystemHandler is {
      on command TradingSystem.CancelTradeOrder is {
        do "the model sends cancel trade order"
      }
      on command TradingSystem.SubmitOrder is {
        do "the model sends submit order"
      }
      on other is {
        error "Unexpected message for adaptor ToTradingSystem"
      }
    } with {
      briefly "to trading system"
      described as {
        |Carries messages to the external TradingSystem.
      }
    }
  } with {
    briefly "TradingSystem integration"
    described as {
      |The model's side of the TradingSystem conversation.
    }
  }
  include "types.riddl"
  include "Portfolio.riddl"
  type PortfolioRepositoryCommand is one of {
    PortfolioContext.PortfolioRepository.PersistAllocationsUpdated or PortfolioContext.PortfolioRepository.PersistBenchmarkCompared or PortfolioContext.PortfolioRepository.PersistPortfolioClosed or PortfolioContext.PortfolioRepository.PersistPortfolioCreated or PortfolioContext.PortfolioRepository.PersistPortfolioRebalanced or PortfolioContext.PortfolioRepository.PersistPortfolioSuspended or PortfolioContext.PortfolioRepository.PersistRiskAnalyzed or PortfolioContext.PortfolioRepository.PersistTradeExecuted or PortfolioContext.PortfolioRepository.PersistTradeFilled
  } with {
    briefly "Anything that writes PortfolioRepository"
    described as {
      |The persistence commands PortfolioRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository PortfolioRepository as flow is {
    inlet PortfolioRepositoryFromPortfolioMetrics is type PortfolioRepositoryCommand    command PersistAllocationsUpdated is {
      portfolioId: PortfolioId with {
        briefly "Row addressed"
        described as {
          |Which stored row AllocationsUpdated applies to.
        }
      }
    } with {
      briefly "Persist AllocationsUpdated"
      described as {
        |Instructs this repository to apply AllocationsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPortfolioRebalanced is {
      portfolioId: PortfolioId with {
        briefly "Row addressed"
        described as {
          |Which stored row PortfolioRebalanced applies to.
        }
      }
    } with {
      briefly "Persist PortfolioRebalanced"
      described as {
        |Instructs this repository to apply PortfolioRebalanced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPortfolioSuspended is {
      portfolioId: PortfolioId with {
        briefly "Row addressed"
        described as {
          |Which stored row PortfolioSuspended applies to.
        }
      }
    } with {
      briefly "Persist PortfolioSuspended"
      described as {
        |Instructs this repository to apply PortfolioSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRiskAnalyzed is {
      portfolioId: PortfolioId with {
        briefly "Row addressed"
        described as {
          |Which stored row RiskAnalyzed applies to.
        }
      }
    } with {
      briefly "Persist RiskAnalyzed"
      described as {
        |Instructs this repository to apply RiskAnalyzed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTradeFilled is {
      portfolioId: PortfolioId with {
        briefly "Row addressed"
        described as {
          |Which stored row TradeFilled applies to.
        }
      }
    } with {
      briefly "Persist TradeFilled"
      described as {
        |Instructs this repository to apply TradeFilled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBenchmarkCompared is {
      portfolioId: PortfolioId with {
        briefly "Row addressed"
        described as {
          |Which stored row BenchmarkCompared applies to.
        }
      }
    } with {
      briefly "Persist BenchmarkCompared"
      described as {
        |Instructs this repository to apply BenchmarkCompared to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPortfolioClosed is {
      portfolioId: PortfolioId with {
        briefly "Row addressed"
        described as {
          |Which stored row PortfolioClosed applies to.
        }
      }
    } with {
      briefly "Persist PortfolioClosed"
      described as {
        |Instructs this repository to apply PortfolioClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPortfolioCreated is {
      portfolioId: PortfolioId with {
        briefly "Row addressed"
        described as {
          |Which stored row PortfolioCreated applies to.
        }
      }
    } with {
      briefly "Persist PortfolioCreated"
      described as {
        |Instructs this repository to apply PortfolioCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTradeExecuted is {
      portfolioId: PortfolioId with {
        briefly "Row addressed"
        described as {
          |Which stored row TradeExecuted applies to.
        }
      }
    } with {
      briefly "Persist TradeExecuted"
      described as {
        |Instructs this repository to apply TradeExecuted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet PortfolioRepositoryResponses is result Portfolio.PortfolioResult
    record StoredPortfolio is {
      portfolioId: PortfolioId with {
        briefly "portfolioId"
        described as {
          |The portfolioId column of the stored portfolio row.
        }
      }
      accountId: AccountId with {
        briefly "accountId"
        described as {
          |The accountId column of the stored portfolio row.
        }
      }
      status: PortfolioStatus with {
        briefly "status"
        described as {
          |The status column of the stored portfolio row.
        }
      }
    } with {
      briefly "Stored portfolio row"
      described as {
        |The persistence shape of portfolio data as this repository stores it.
      }
    }
    schema PortfolioData is relational
      of portfolios as record StoredPortfolio
        index on field StoredPortfolio.portfolioId
        index on field StoredPortfolio.accountId
        index on field StoredPortfolio.status
 with {
      briefly "Portfolio data schema"
      described as {
        |The relational schema holding portfolio data for the PortfolioRepository.
      }
    }
    handler PortfolioPersistence is {
      on persistAllocationsUpdated: command PersistAllocationsUpdated is {
        do "apply AllocationsUpdated to the stored row"
      }
      on persistPortfolioRebalanced: command PersistPortfolioRebalanced is {
        do "apply PortfolioRebalanced to the stored row"
      }
      on persistPortfolioSuspended: command PersistPortfolioSuspended is {
        do "apply PortfolioSuspended to the stored row"
      }
      on persistRiskAnalyzed: command PersistRiskAnalyzed is {
        do "apply RiskAnalyzed to the stored row"
      }
      on persistTradeFilled: command PersistTradeFilled is {
        do "apply TradeFilled to the stored row"
      }
      on persistBenchmarkCompared: command PersistBenchmarkCompared is {
        do "apply BenchmarkCompared to the stored row"
      }
      on persistPortfolioClosed: command PersistPortfolioClosed is {
        do "apply PortfolioClosed to the stored row"
      }
      on persistPortfolioCreated: command PersistPortfolioCreated is {
        do "apply PortfolioCreated to the stored row"
      }
      on persistTradeExecuted: command PersistTradeExecuted is {
        do "apply TradeExecuted to the stored row"
      }
      on query GetPortfolioAnalytics is {
        let portfolioAnalyticsView: type PortfolioAnalyticsView = prompt("read the portfolio analytics projection")
        reply portfolioAnalyticsView
      }
    } with {
      briefly "Persists portfolio commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Portfolio data persistence"
    described as {
      |Persistent storage for portfolios.
    }
  }
  query GetPortfolioAnalytics replies result PortfolioAnalyticsView is {
    portfolioAnalyticsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which portfolio analytics to retrieve.
      }
    }
  } with {
    briefly "Get portfolio analytics"
    described as {
      |Retrieves the portfolio analytics projection.
    }
  }
  result PortfolioAnalyticsView is {
    portfolioAnalytics: PortfolioMetrics.PortfolioAnalytics with {
      briefly "Portfolio analytics"
      described as {
        |The portfolio analytics being returned.
      }
    }
  } with {
    briefly "Portfolio analytics view"
    described as {
      |Read model view carrying the portfolio analytics projection.
    }
  }
  projector PortfolioMetrics as flow is {
    updates repository PortfolioContext.PortfolioRepository
    outlet PortfolioMetricsToRepository is type PortfolioRepositoryCommand
    inlet PortfolioMetricsFromPortfolio is type PortfolioEvent    record PortfolioAnalytics is {
      totalPortfolios: Natural with {
        briefly "Total"
        described as {
          |Total portfolios.
        }
      }
      activePortfolios: Natural with {
        briefly "Active"
        described as {
          |Active portfolios.
        }
      }
      totalTradesExecuted: Natural with {
        briefly "Trades"
        described as {
          |Total trades executed.
        }
      }
      averageTrackingError: Decimal(8,4) with {
        briefly "Avg tracking error"
        described as {
          |Average tracking error.
        }
      }
    } with {
      briefly "Portfolio analytics"
      described as {
        |Aggregate portfolio metrics.
      }
    }
    handler MetricsHandler is {
      on allocationsUpdated: event Portfolio.AllocationsUpdated is {
        tell command PortfolioContext.PortfolioRepository.PersistAllocationsUpdated(portfolioId = allocationsUpdated.portfolioId) to repository PortfolioContext.PortfolioRepository
        do "apply AllocationsUpdated to the PortfolioMetrics projection"
      }
      on portfolioRebalanced: event Portfolio.PortfolioRebalanced is {
        tell command PortfolioContext.PortfolioRepository.PersistPortfolioRebalanced(portfolioId = portfolioRebalanced.portfolioId) to repository PortfolioContext.PortfolioRepository
        do "apply PortfolioRebalanced to the PortfolioMetrics projection"
      }
      on portfolioSuspended: event Portfolio.PortfolioSuspended is {
        tell command PortfolioContext.PortfolioRepository.PersistPortfolioSuspended(portfolioId = portfolioSuspended.portfolioId) to repository PortfolioContext.PortfolioRepository
        do "apply PortfolioSuspended to the PortfolioMetrics projection"
      }
      on riskAnalyzed: event Portfolio.RiskAnalyzed is {
        tell command PortfolioContext.PortfolioRepository.PersistRiskAnalyzed(portfolioId = riskAnalyzed.portfolioId) to repository PortfolioContext.PortfolioRepository
        do "apply RiskAnalyzed to the PortfolioMetrics projection"
      }
      on tradeFilled: event Portfolio.TradeFilled is {
        tell command PortfolioContext.PortfolioRepository.PersistTradeFilled(portfolioId = tradeFilled.portfolioId) to repository PortfolioContext.PortfolioRepository
        do "apply TradeFilled to the PortfolioMetrics projection"
      }
      on portfolioCreated: event Portfolio.PortfolioCreated is {
        tell command PortfolioContext.PortfolioRepository.PersistPortfolioCreated(portfolioId = portfolioCreated.portfolioId) to repository PortfolioContext.PortfolioRepository
      }
      on tradeExecuted: event Portfolio.TradeExecuted is {
        tell command PortfolioContext.PortfolioRepository.PersistTradeExecuted(portfolioId = tradeExecuted.portfolioId) to repository PortfolioContext.PortfolioRepository
      }
      on benchmarkCompared: event Portfolio.BenchmarkCompared is {
        tell command PortfolioContext.PortfolioRepository.PersistBenchmarkCompared(portfolioId = benchmarkCompared.portfolioId) to repository PortfolioContext.PortfolioRepository
      }
      on portfolioClosed: event Portfolio.PortfolioClosed is {
        tell command PortfolioContext.PortfolioRepository.PersistPortfolioClosed(portfolioId = portfolioClosed.portfolioId) to repository PortfolioContext.PortfolioRepository
      }
    } with {
      briefly "Maintains portfolio metrics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Portfolio metrics"
    described as {
      |Investment portfolio analytics.
    }
  }
  streamlet PortfolioEventSplit as flow is {
    inlet PortfolioEventSplitIn is type PortfolioEvent    outlet PortfolioEventSplitToPortfolioMetrics is type PortfolioEvent
    handler PortfolioEventSplitHandler is {
      on portfolioCreated: event Portfolio.PortfolioCreated is {
        send portfolioCreated to outlet PortfolioEventSplitToPortfolioMetrics
        tell portfolioCreated to entity PortfolioContext.Portfolio
      }
      on allocationsUpdated: event Portfolio.AllocationsUpdated is {
        send allocationsUpdated to outlet PortfolioEventSplitToPortfolioMetrics
        tell allocationsUpdated to entity PortfolioContext.Portfolio
      }
      on portfolioRebalanced: event Portfolio.PortfolioRebalanced is {
        send portfolioRebalanced to outlet PortfolioEventSplitToPortfolioMetrics
        tell portfolioRebalanced to entity PortfolioContext.Portfolio
      }
      on tradeExecuted: event Portfolio.TradeExecuted is {
        send tradeExecuted to outlet PortfolioEventSplitToPortfolioMetrics
        tell tradeExecuted to entity PortfolioContext.Portfolio
      }
      on tradeFilled: event Portfolio.TradeFilled is {
        send tradeFilled to outlet PortfolioEventSplitToPortfolioMetrics
        tell tradeFilled to entity PortfolioContext.Portfolio
      }
      on riskAnalyzed: event Portfolio.RiskAnalyzed is {
        send riskAnalyzed to outlet PortfolioEventSplitToPortfolioMetrics
        tell riskAnalyzed to entity PortfolioContext.Portfolio
      }
      on benchmarkCompared: event Portfolio.BenchmarkCompared is {
        send benchmarkCompared to outlet PortfolioEventSplitToPortfolioMetrics
        tell benchmarkCompared to entity PortfolioContext.Portfolio
      }
      on portfolioSuspended: event Portfolio.PortfolioSuspended is {
        send portfolioSuspended to outlet PortfolioEventSplitToPortfolioMetrics
        tell portfolioSuspended to entity PortfolioContext.Portfolio
      }
      on portfolioClosed: event Portfolio.PortfolioClosed is {
        send portfolioClosed to outlet PortfolioEventSplitToPortfolioMetrics
        tell portfolioClosed to entity PortfolioContext.Portfolio
      }
      on other is {
        error "Unexpected message for processor PortfolioEventSplit"
      }
    } with {
      briefly "Portfolio event fan-out handler"
      described as {
        |Delivers each Portfolio event to all of its consumers.
      }
    }
  } with {
    briefly "Portfolio event fan-out"
    described as {
      |Fans Portfolio events out to the repository and projectors.
    }
  }
  connector 'PortfolioEvent Stream' is from outlet PortfolioContext.Portfolio.PortfolioEvents2 to inlet PortfolioContext.PortfolioEventSplit.PortfolioEventSplitIn with {
    briefly "Portfolio events, fanned out to storage and read models"
  }
  connector 'PortfolioMetrics Feed' is from outlet PortfolioContext.PortfolioEventSplit.PortfolioEventSplitToPortfolioMetrics to inlet PortfolioContext.PortfolioMetrics.PortfolioMetricsFromPortfolio with {
    briefly "Portfolio events feeding the PortfolioMetrics projection"
  }
  connector 'PortfolioMetrics Storage' is from outlet PortfolioContext.PortfolioMetrics.PortfolioMetricsToRepository to inlet PortfolioContext.PortfolioRepository.PortfolioRepositoryFromPortfolioMetrics with {
    briefly "PortfolioMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for portfolio management"
  described as {
    |Investment portfolio management context.
  }
}
