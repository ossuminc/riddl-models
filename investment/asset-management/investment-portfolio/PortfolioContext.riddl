// Investment Portfolio - Portfolio Context
context PortfolioContext is {
  include "types.riddl"
  include "Portfolio.riddl"
  repository PortfolioRepository is {
    inlet PortfolioRepositoryFromPortfolio is type PortfolioEvent
    inlet PortfolioRepositoryFromPortfolioMetrics is type PortfolioEvent
    outlet PortfolioRepositoryResponses is type Portfolio.PortfolioResult
    schema PortfolioData is relational
      of portfolios as type Portfolio
        index on field Portfolio.portfolioId
        index on field Portfolio.accountId
        index on field Portfolio.status
      with {
      briefly "Portfolio data schema"
      described as {
        |The relational schema holding portfolio data for the PortfolioRepository.
      }
    }

    handler PortfolioPersistence is {
      on command Portfolio.CreatePortfolio is {
        tell event Portfolio.PortfolioCreated to entity PortfolioContext.Portfolio
      }
      on command Portfolio.UpdateAllocations is {
        tell event Portfolio.AllocationsUpdated to entity PortfolioContext.Portfolio
      }
      on command Portfolio.RebalancePortfolio is {
        tell event Portfolio.PortfolioRebalanced to entity PortfolioContext.Portfolio
      }
      on command Portfolio.RecordTradeFill is {
        tell event Portfolio.TradeFilled to entity PortfolioContext.Portfolio
      }
      on command Portfolio.AnalyzeRisk is {
        tell event Portfolio.RiskAnalyzed to entity PortfolioContext.Portfolio
      }
      on command Portfolio.ClosePortfolio is {
        tell event Portfolio.PortfolioClosed to entity PortfolioContext.Portfolio
      }
    } with {
      briefly "Persists portfolio commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Portfolio data persistence"
    described as {
      |Persistent storage for portfolios.
    }
  }
  projector PortfolioMetrics is {
    inlet PortfolioMetricsFromPortfolio is type PortfolioEvent
    outlet PortfolioMetricsOut is type PortfolioEvent
    updates repository PortfolioContext.PortfolioRepository
    record PortfolioAnalytics is  {
      totalPortfolios: Natural with {
        briefly "Total"
        described as {
          |Total portfolios.
        }
      }
      activePortfolios: Natural with {
        briefly "Active"
        described as {
          |Active portfolios.
        }
      }
      totalTradesExecuted: Natural with {
        briefly "Trades"
        described as {
          |Total trades executed.
        }
      }
      averageTrackingError: Decimal(8,4) with {
        briefly "Avg tracking error"
        described as {
          |Average tracking error.
        }
      }
    } with {
      briefly "Portfolio analytics"
      described as {
        |Aggregate portfolio metrics.
      }
    }
    handler MetricsHandler is {
      on event Portfolio.PortfolioCreated is {
        tell event Portfolio.PortfolioCreated to repository PortfolioContext.PortfolioRepository
      }
      on event Portfolio.TradeExecuted is {
        tell event Portfolio.TradeExecuted to repository PortfolioContext.PortfolioRepository
      }
      on event Portfolio.BenchmarkCompared is {
        tell event Portfolio.BenchmarkCompared to repository PortfolioContext.PortfolioRepository
      }
      on event Portfolio.PortfolioClosed is {
        tell event Portfolio.PortfolioClosed to repository PortfolioContext.PortfolioRepository
      }
    } with {
      briefly "Maintains portfolio metrics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Portfolio metrics"
    described as {
      |Investment portfolio analytics.
    }
  }
  processor PortfolioSource as source is {
    outlet PortfolioEvents is type PortfolioEvent
    handler PortfolioSourceHandler is {
      on init is {
        tell command Portfolio.InitializePortfolio to entity PortfolioContext.Portfolio
      }
      on other is {
        error "Unexpected message for source PortfolioSource"
      }
      on event Portfolio.PortfolioCreated is {
        send event Portfolio.PortfolioCreated to outlet PortfolioEvents
      }
      on event Portfolio.TradeExecuted is {
        send event Portfolio.TradeExecuted to outlet PortfolioEvents
      }
      on event Portfolio.PortfolioClosed is {
        send event Portfolio.PortfolioClosed to outlet PortfolioEvents
      }
    } with {
      briefly "Portfolio source handler"
      described as {
        |Handles portfolio events and sends to outlet.
      }
    }
  } with {
    briefly "Portfolio event source"
    described as {
      |Publishes portfolio entity events.
    }
  }
  processor PortfolioSink as sink is {
    inlet PortfolioInlet is type PortfolioEvent
    handler PortfolioSinkHandler is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink PortfolioSink"
      }
      on event Portfolio.PortfolioCreated is {
        tell event Portfolio.PortfolioCreated to repository PortfolioContext.PortfolioRepository
      }
      on event Portfolio.TradeExecuted is {
        tell event Portfolio.TradeExecuted to repository PortfolioContext.PortfolioRepository
      }
      on event Portfolio.PortfolioClosed is {
        tell event Portfolio.PortfolioClosed to repository PortfolioContext.PortfolioRepository
      }
    } with {
      briefly "Portfolio sink handler"
      described as {
        |Receives portfolio events and persists them.
      }
    }
  } with {
    briefly "Portfolio event sink"
    described as {
      |Receives portfolio events for persistence.
    }
  }
  connector PortfolioFlow is {
    from outlet PortfolioContext.PortfolioSource.PortfolioEvents to
      inlet PortfolioContext.PortfolioSink.PortfolioInlet
  } with {
    briefly "Portfolio event flow"
    described as {
      |Connects portfolio source to sink.
    }
  }
  processor PortfolioEventSplit is {
    inlet PortfolioEventSplitIn is type PortfolioEvent
    outlet PortfolioEventSplitToPortfolioRepository is type PortfolioEvent
    outlet PortfolioEventSplitToPortfolioMetrics is type PortfolioEvent
    handler PortfolioEventSplitHandler is {
      on event Portfolio.PortfolioCreated is {
        send event Portfolio.PortfolioCreated to outlet PortfolioEventSplitToPortfolioRepository
        send event Portfolio.PortfolioCreated to outlet PortfolioEventSplitToPortfolioMetrics
        tell event Portfolio.PortfolioCreated to entity PortfolioContext.Portfolio
      }
      on event Portfolio.AllocationsUpdated is {
        send event Portfolio.AllocationsUpdated to outlet PortfolioEventSplitToPortfolioRepository
        send event Portfolio.AllocationsUpdated to outlet PortfolioEventSplitToPortfolioMetrics
        tell event Portfolio.AllocationsUpdated to entity PortfolioContext.Portfolio
      }
      on event Portfolio.PortfolioRebalanced is {
        send event Portfolio.PortfolioRebalanced to outlet PortfolioEventSplitToPortfolioRepository
        send event Portfolio.PortfolioRebalanced to outlet PortfolioEventSplitToPortfolioMetrics
        tell event Portfolio.PortfolioRebalanced to entity PortfolioContext.Portfolio
      }
      on event Portfolio.TradeExecuted is {
        send event Portfolio.TradeExecuted to outlet PortfolioEventSplitToPortfolioRepository
        send event Portfolio.TradeExecuted to outlet PortfolioEventSplitToPortfolioMetrics
        tell event Portfolio.TradeExecuted to entity PortfolioContext.Portfolio
      }
      on event Portfolio.TradeFilled is {
        send event Portfolio.TradeFilled to outlet PortfolioEventSplitToPortfolioRepository
        send event Portfolio.TradeFilled to outlet PortfolioEventSplitToPortfolioMetrics
        tell event Portfolio.TradeFilled to entity PortfolioContext.Portfolio
      }
      on event Portfolio.RiskAnalyzed is {
        send event Portfolio.RiskAnalyzed to outlet PortfolioEventSplitToPortfolioRepository
        send event Portfolio.RiskAnalyzed to outlet PortfolioEventSplitToPortfolioMetrics
        tell event Portfolio.RiskAnalyzed to entity PortfolioContext.Portfolio
      }
      on event Portfolio.BenchmarkCompared is {
        send event Portfolio.BenchmarkCompared to outlet PortfolioEventSplitToPortfolioRepository
        send event Portfolio.BenchmarkCompared to outlet PortfolioEventSplitToPortfolioMetrics
        tell event Portfolio.BenchmarkCompared to entity PortfolioContext.Portfolio
      }
      on event Portfolio.PortfolioSuspended is {
        send event Portfolio.PortfolioSuspended to outlet PortfolioEventSplitToPortfolioRepository
        send event Portfolio.PortfolioSuspended to outlet PortfolioEventSplitToPortfolioMetrics
        tell event Portfolio.PortfolioSuspended to entity PortfolioContext.Portfolio
      }
      on event Portfolio.PortfolioClosed is {
        send event Portfolio.PortfolioClosed to outlet PortfolioEventSplitToPortfolioRepository
        send event Portfolio.PortfolioClosed to outlet PortfolioEventSplitToPortfolioMetrics
        tell event Portfolio.PortfolioClosed to entity PortfolioContext.Portfolio
      }
      on other is {
        error "Unexpected message for processor PortfolioEventSplit"
      }
    } with {
      briefly "Portfolio event fan-out handler"
      described as {
        |Delivers each Portfolio event to all of its consumers.
      }
    }
  } with {
    briefly "Portfolio event fan-out"
    described as {
      |Fans Portfolio events out to the repository and projectors.
    }
  }
  connector LinkPortfolioToPortfolioEventSplit is {
    from outlet PortfolioContext.Portfolio.PortfolioEvents2 to
      inlet PortfolioContext.PortfolioEventSplit.PortfolioEventSplitIn
  } with {
    briefly "LinkPortfolioToPortfolioEventSplit"
  }
  connector LinkPortfolioEventSplitToPortfolioRepository is {
    from outlet PortfolioContext.PortfolioEventSplit.PortfolioEventSplitToPortfolioRepository to
      inlet PortfolioContext.PortfolioRepository.PortfolioRepositoryFromPortfolio
  } with {
    briefly "LinkPortfolioEventSplitToPortfolioRepository"
  }
  connector LinkPortfolioEventSplitToPortfolioMetrics is {
    from outlet PortfolioContext.PortfolioEventSplit.PortfolioEventSplitToPortfolioMetrics to
      inlet PortfolioContext.PortfolioMetrics.PortfolioMetricsFromPortfolio
  } with {
    briefly "LinkPortfolioEventSplitToPortfolioMetrics"
  }
  connector LinkPortfolioMetricsToPortfolioRepository is {
    from outlet PortfolioContext.PortfolioMetrics.PortfolioMetricsOut to
      inlet PortfolioContext.PortfolioRepository.PortfolioRepositoryFromPortfolioMetrics
  } with {
    briefly "LinkPortfolioMetricsToPortfolioRepository"
  }
} with {
  briefly "Bounded context for portfolio management"
  described as {
    |Investment portfolio management context.
  }
}
