// Investment Portfolio Domain Model
// Portfolio construction, asset allocation, rebalancing, and trade execution
domain InvestmentPortfolio is {
  persistent connector 'MarketDataFeedReply Stream' is from outlet MarketDataFeed.MarketDataFeedRepliesOut to inlet PortfolioContext.ToMarketDataFeed.ToMarketDataFeedReplies with {
    briefly "What MarketDataFeed answers PortfolioContext"
  }
  persistent connector 'MarketDataFeedEvent Stream' is from outlet MarketDataFeed.MarketDataFeedEventsOut to inlet PortfolioContext.FromMarketDataFeed.FromMarketDataFeedIn with {
    briefly "What MarketDataFeed tells PortfolioContext, unasked"
  }
  persistent connector 'TradingSystemEvent Stream' is from outlet TradingSystem.TradingSystemEventsOut to inlet PortfolioContext.FromTradingSystem.FromTradingSystemIn with {
    briefly "What TradingSystem tells PortfolioContext, unasked"
  }
  persistent connector 'MarketDataFeedRequest Stream' is from outlet PortfolioContext.ToMarketDataFeed.ToMarketDataFeedOut to inlet MarketDataFeed.MarketDataFeedRequests with {
    briefly "What PortfolioContext asks MarketDataFeed to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user PortfolioManager is "person managing investment portfolios" with {
    briefly "Portfolio Manager"
    described as {
      |Investment professional constructing and managing portfolios.
    }
  }
  user RiskAnalyst is "person analyzing portfolio risk" with {
    briefly "Risk Analyst"
    described as {
      |Analyst evaluating portfolio risk and compliance.
    }
  }
  user TradeOperator is "person executing portfolio trades" with {
    briefly "Trade Operator"
    described as {
      |Operator executing and settling trades.
    }
  }
  epic PortfolioManagement is {
    user PortfolioManager wants to "to manage institutional portfolios" so that "assets are optimally allocated and rebalanced"
    case ConstructAndRebalance is {
      user PortfolioManager wants to "to construct and rebalance a portfolio" so that "allocations match the investment strategy"
      step is "Manager creates" "portfolio" "with target allocations" with {
        briefly "Create portfolio"
        described as {
          |Define portfolio.
        }
      }
      step is "System rebalances" "holdings" "to match targets" with {
        briefly "Rebalance"
        described as {
          |Adjust allocations.
        }
      }
    } with {
      briefly "Construct and rebalance portfolio"
      described as {
        |Building and rebalancing investment portfolios.
      }
    }
  } with {
    briefly "Portfolio management"
    described as {
      |Epic for investment portfolio management.
    }
  }
  include "PortfolioContext.riddl"
  include "external-contexts.riddl"
  application context InvestmentPortfolioApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in InvestmentPortfolio are delivered.
      }
    }
    outlet AppPortfolioCommands is type PortfolioContext.Portfolio.PortfolioCommand
    inlet AppPortfolioRepositoryResponses is result PortfolioContext.Portfolio.PortfolioResult    handler InvestmentPortfolioAppHandler is {
      on other is {
        error "Unexpected message for application context InvestmentPortfolioApp"
      }
    } with {
      briefly "InvestmentPortfolioApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "InvestmentPortfolioApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'TradingSystemRequest Stream' is from outlet PortfolioContext.ToTradingSystem.ToTradingSystemOut to inlet TradingSystem.TradingSystemRequests with {
    briefly "What PortfolioContext asks TradingSystem to send"
  }
  persistent connector 'PortfolioCommand Stream' is from outlet InvestmentPortfolioApp.AppPortfolioCommands to inlet PortfolioContext.PortfolioCommandStreamIn with {
    briefly "Portfolio commands from the application"
  }
  persistent connector 'PortfolioCompanyResult Stream' is from outlet PortfolioContext.PortfolioCompanyResultStreamOut to inlet InvestmentPortfolioApp.AppPortfolioRepositoryResponses with {
    briefly "Portfolio query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet InvestmentPortfolioApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Investment portfolio management domain"
  described as {
    |Portfolio construction, allocation, rebalancing, and trade execution.
  }
}
