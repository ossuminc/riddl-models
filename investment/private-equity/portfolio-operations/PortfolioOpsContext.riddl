// Portfolio Operations - Portfolio Ops Context
context PortfolioOpsContext is {
  adaptor FromFinancialReportingSystem from context FinancialReportingSystem is { 
    handler FromFinancialReportingSystemHandler is {
      on event FinancialReportingSystem.FinancialReportSubmitted is {
        do "the model receives financial report submitted"
      }
      on result FinancialReportingSystem.HistoricalFinancials is {
        do "the model receives historical financials"
      }
      on other is {
        error "Unexpected message for adaptor FromFinancialReportingSystem"
      }
    } with {
      briefly "from financial reporting system"
      described as {
        |Carries messages from the external FinancialReportingSystem.
      }
    }
  } with {
    briefly "FinancialReportingSystem integration"
    described as {
      |The model's side of the FinancialReportingSystem conversation.
    }
  }
  adaptor ToFinancialReportingSystem to context FinancialReportingSystem is { 
    handler ToFinancialReportingSystemHandler is {
      on query FinancialReportingSystem.GetHistoricalFinancials is {
        do "the model sends get historical financials"
      }
      on command FinancialReportingSystem.SubmitFinancialReport is {
        do "the model sends submit financial report"
      }
      on other is {
        error "Unexpected message for adaptor ToFinancialReportingSystem"
      }
    } with {
      briefly "to financial reporting system"
      described as {
        |Carries messages to the external FinancialReportingSystem.
      }
    }
  } with {
    briefly "FinancialReportingSystem integration"
    described as {
      |The model's side of the FinancialReportingSystem conversation.
    }
  }
  adaptor FromFundManagementSystem from context FundManagementSystem is { 
    handler FromFundManagementSystemHandler is {
      on event FundManagementSystem.DistributionRecorded is {
        do "the model receives distribution recorded"
      }
      on result FundManagementSystem.FundDetails is {
        do "the model receives fund details"
      }
      on other is {
        error "Unexpected message for adaptor FromFundManagementSystem"
      }
    } with {
      briefly "from fund management system"
      described as {
        |Carries messages from the external FundManagementSystem.
      }
    }
  } with {
    briefly "FundManagementSystem integration"
    described as {
      |The model's side of the FundManagementSystem conversation.
    }
  }
  adaptor ToFundManagementSystem to context FundManagementSystem is { 
    handler ToFundManagementSystemHandler is {
      on query FundManagementSystem.GetFundDetails is {
        do "the model sends get fund details"
      }
      on command FundManagementSystem.RecordDistribution is {
        do "the model sends record distribution"
      }
      on other is {
        error "Unexpected message for adaptor ToFundManagementSystem"
      }
    } with {
      briefly "to fund management system"
      described as {
        |Carries messages to the external FundManagementSystem.
      }
    }
  } with {
    briefly "FundManagementSystem integration"
    described as {
      |The model's side of the FundManagementSystem conversation.
    }
  }
  adaptor FromLegalComplianceSystem from context LegalComplianceSystem is { 
    handler FromLegalComplianceSystemHandler is {
      on event LegalComplianceSystem.BoardResolutionFiled is {
        do "the model receives board resolution filed"
      }
      on result LegalComplianceSystem.ComplianceStatus is {
        do "the model receives compliance status"
      }
      on other is {
        error "Unexpected message for adaptor FromLegalComplianceSystem"
      }
    } with {
      briefly "from legal compliance system"
      described as {
        |Carries messages from the external LegalComplianceSystem.
      }
    }
  } with {
    briefly "LegalComplianceSystem integration"
    described as {
      |The model's side of the LegalComplianceSystem conversation.
    }
  }
  adaptor ToLegalComplianceSystem to context LegalComplianceSystem is { 
    handler ToLegalComplianceSystemHandler is {
      on command LegalComplianceSystem.FileBoardResolution is {
        do "the model sends file board resolution"
      }
      on query LegalComplianceSystem.GetComplianceStatus is {
        do "the model sends get compliance status"
      }
      on other is {
        error "Unexpected message for adaptor ToLegalComplianceSystem"
      }
    } with {
      briefly "to legal compliance system"
      described as {
        |Carries messages to the external LegalComplianceSystem.
      }
    }
  } with {
    briefly "LegalComplianceSystem integration"
    described as {
      |The model's side of the LegalComplianceSystem conversation.
    }
  }
  include "types.riddl"
  include "PortfolioCompany.riddl"
  repository PortfolioRepository is {
    inlet PortfolioRepositoryFromPortfolioCompany is type PortfolioCompanyEvent    inlet PortfolioRepositoryFromPortfolioMetrics is type PortfolioCompanyEvent    outlet PortfolioRepositoryResponses is type PortfolioCompany.PortfolioCompanyResult
    record StoredPortfolioCompany is  {
      portfolioCompanyId: PortfolioCompanyId with {
        briefly "portfolioCompanyId"
        described as {
          |The portfolioCompanyId column of the stored portfolioCompany row.
        }
      }
      companyId: PortfolioCompanyId with {
        briefly "companyId"
        described as {
          |The companyId column of the stored portfolioCompany row.
        }
      }
      fundId: FundId with {
        briefly "fundId"
        described as {
          |The fundId column of the stored portfolioCompany row.
        }
      }
      status: CompanyStatus with {
        briefly "status"
        described as {
          |The status column of the stored portfolioCompany row.
        }
      }
    } with {
      briefly "Stored portfolioCompany row"
      described as {
        |The persistence shape of portfolioCompany data as this repository stores it.
      }
    }
    schema PortfolioData is relational
      of portfolioCompanies as type StoredPortfolioCompany
        index on field StoredPortfolioCompany.companyId
        index on field StoredPortfolioCompany.fundId
        index on field StoredPortfolioCompany.status
 with {
      briefly "Portfolio data schema"
      described as {
        |The relational schema holding portfolio data for the PortfolioRepository.
      }
    }
    handler PortfolioPersistence is {
      on query GetPortfolioPerformanceMetrics is {
        do "read the portfolio performance metrics projection"
        yield result PortfolioPerformanceMetricsView
      }
      on command PortfolioCompany.OnboardCompany is {
        tell event PortfolioCompany.CompanyOnboarded to entity PortfolioOpsContext.PortfolioCompany
      }
      on command PortfolioCompany.UpdateFinancials is {
        tell event PortfolioCompany.FinancialsUpdated to entity PortfolioOpsContext.PortfolioCompany
      }
      on command PortfolioCompany.AddValueCreationInitiative is {
        tell event PortfolioCompany.InitiativeAdded to entity PortfolioOpsContext.PortfolioCompany
      }
      on command PortfolioCompany.UpdateInitiativeStatus is {
        tell event PortfolioCompany.InitiativeStatusUpdated to entity PortfolioOpsContext.PortfolioCompany
      }
      on command PortfolioCompany.RecordBoardMeeting is {
        tell event PortfolioCompany.BoardMeetingRecorded to entity PortfolioOpsContext.PortfolioCompany
      }
      on command PortfolioCompany.CompleteExit is {
        tell event PortfolioCompany.ExitCompleted to entity PortfolioOpsContext.PortfolioCompany
      }
    } with {
      briefly "Persists portfolio commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Portfolio data persistence"
    described as {
      |Persistent storage for portfolio operations.
    }
  }
  query GetPortfolioPerformanceMetrics is  {
    portfolioPerformanceMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which portfolio performance metrics to retrieve.
      }
    }
  } with {
    briefly "Get portfolio performance metrics"
    described as {
      |Retrieves the portfolio performance metrics projection.
    }
  }
  result PortfolioPerformanceMetricsView is  {
    portfolioPerformanceMetrics: PortfolioMetrics.PortfolioPerformanceMetrics with {
      briefly "Portfolio performance metrics"
      described as {
        |The portfolio performance metrics being returned.
      }
    }
  } with {
    briefly "Portfolio performance metrics view"
    described as {
      |Read model view carrying the portfolio performance metrics projection.
    }
  }
  projector PortfolioMetrics is {
    updates repository PortfolioOpsContext.PortfolioRepository
    inlet PortfolioMetricsFromPortfolioCompany is type PortfolioCompanyEvent    outlet PortfolioMetricsOut is type PortfolioCompanyEvent
    record PortfolioPerformanceMetrics is  {
      totalCompanies: Natural with {
        briefly "Total"
        described as {
          |Total portfolio companies.
        }
      }
      activeCompanies: Natural with {
        briefly "Active"
        described as {
          |Active portfolio companies.
        }
      }
      exitedCompanies: Natural with {
        briefly "Exited"
        described as {
          |Exited companies.
        }
      }
      averageMOIC: Decimal(5,2) with {
        briefly "Avg MOIC"
        described as {
          |Average multiple on invested capital.
        }
      }
      totalInvestedCapital: Decimal(14,2) with {
        briefly "Total invested"
        described as {
          |Total capital invested.
        }
      }
      initiativesOnTrack: Natural with {
        briefly "On track"
        described as {
          |Initiatives on track.
        }
      }
      initiativesAtRisk: Natural with {
        briefly "At risk"
        described as {
          |Initiatives at risk.
        }
      }
    } with {
      briefly "Portfolio performance metrics"
      described as {
        |Aggregated portfolio performance indicators.
      }
    }
    handler MetricsHandler is {
      on event PortfolioCompany.CompanyOnboarded is {
        tell event PortfolioCompany.CompanyOnboarded to repository PortfolioOpsContext.PortfolioRepository
      }
      on event PortfolioCompany.FinancialsUpdated is {
        tell event PortfolioCompany.FinancialsUpdated to repository PortfolioOpsContext.PortfolioRepository
      }
      on event PortfolioCompany.InitiativeStatusUpdated is {
        tell event PortfolioCompany.InitiativeStatusUpdated to repository PortfolioOpsContext.PortfolioRepository
      }
      on event PortfolioCompany.ExitCompleted is {
        tell event PortfolioCompany.ExitCompleted to repository PortfolioOpsContext.PortfolioRepository
      }
      on event PortfolioCompany.CompanyWrittenOff is {
        tell event PortfolioCompany.CompanyWrittenOff to repository PortfolioOpsContext.PortfolioRepository
      }
    } with {
      briefly "Maintains portfolio metrics"
      described as {
        |Projects events into portfolio analytics.
      }
    }
  } with {
    briefly "Portfolio metrics"
    described as {
      |Portfolio performance analytics.
    }
  }
  processor PortfolioCompanySource as source is {
    outlet PortfolioCompanyEvents is type PortfolioCompanyEvent
    handler PortfolioCompanySourceHandler is {
      on init is {
        tell command PortfolioCompany.InitializePortfolioCompany to entity PortfolioOpsContext.PortfolioCompany
      }
      on other is {
        error "Unexpected message for source PortfolioCompanySource"
      }
      on event PortfolioCompany.CompanyOnboarded is {
        send event PortfolioCompany.CompanyOnboarded to outlet PortfolioCompanyEvents
      }
      on event PortfolioCompany.ExitCompleted is {
        send event PortfolioCompany.ExitCompleted to outlet PortfolioCompanyEvents
      }
      on event PortfolioCompany.CompanyWrittenOff is {
        send event PortfolioCompany.CompanyWrittenOff to outlet PortfolioCompanyEvents
      }
    } with {
      briefly "Portfolio company source handler"
      described as {
        |Handles portfolio company events and sends to outlet.
      }
    }
  } with {
    briefly "Portfolio company event source"
    described as {
      |Publishes portfolio company entity events.
    }
  }
  processor PortfolioCompanySink as sink is {
    inlet PortfolioCompanyInlet is type PortfolioCompanyEvent    handler PortfolioCompanySinkHandler is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink PortfolioCompanySink"
      }
      on event PortfolioCompany.CompanyOnboarded is {
        tell event PortfolioCompany.CompanyOnboarded to repository PortfolioOpsContext.PortfolioRepository
      }
      on event PortfolioCompany.ExitCompleted is {
        tell event PortfolioCompany.ExitCompleted to repository PortfolioOpsContext.PortfolioRepository
      }
    } with {
      briefly "Portfolio company sink handler"
      described as {
        |Receives portfolio company events and persists them.
      }
    }
  } with {
    briefly "Portfolio company event sink"
    described as {
      |Receives portfolio company events for persistence.
    }
  }
  connector PortfolioCompanyFlow is from outlet PortfolioOpsContext.PortfolioCompanySource.PortfolioCompanyEvents to inlet PortfolioOpsContext.PortfolioCompanySink.PortfolioCompanyInlet with {
    briefly "Portfolio company event flow"
    described as {
      |Connects portfolio company source to sink.
    }
  }
  processor PortfolioCompanyEventSplit is {
    inlet PortfolioCompanyEventSplitIn is type PortfolioCompanyEvent    outlet PortfolioCompanyEventSplitToPortfolioRepository is type PortfolioCompanyEvent
    outlet PortfolioCompanyEventSplitToPortfolioMetrics is type PortfolioCompanyEvent
    handler PortfolioCompanyEventSplitHandler is {
      on event PortfolioCompany.CompanyOnboarded is {
        send event PortfolioCompany.CompanyOnboarded to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.CompanyOnboarded to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell event PortfolioCompany.CompanyOnboarded to entity PortfolioOpsContext.PortfolioCompany
      }
      on event PortfolioCompany.FinancialsUpdated is {
        send event PortfolioCompany.FinancialsUpdated to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.FinancialsUpdated to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell event PortfolioCompany.FinancialsUpdated to entity PortfolioOpsContext.PortfolioCompany
      }
      on event PortfolioCompany.OperationalKPIsRecorded is {
        send event PortfolioCompany.OperationalKPIsRecorded to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.OperationalKPIsRecorded to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell event PortfolioCompany.OperationalKPIsRecorded to entity PortfolioOpsContext.PortfolioCompany
      }
      on event PortfolioCompany.InitiativeAdded is {
        send event PortfolioCompany.InitiativeAdded to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.InitiativeAdded to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell event PortfolioCompany.InitiativeAdded to entity PortfolioOpsContext.PortfolioCompany
      }
      on event PortfolioCompany.InitiativeStatusUpdated is {
        send event PortfolioCompany.InitiativeStatusUpdated to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.InitiativeStatusUpdated to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell event PortfolioCompany.InitiativeStatusUpdated to entity PortfolioOpsContext.PortfolioCompany
      }
      on event PortfolioCompany.BoardMeetingRecorded is {
        send event PortfolioCompany.BoardMeetingRecorded to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.BoardMeetingRecorded to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell event PortfolioCompany.BoardMeetingRecorded to entity PortfolioOpsContext.PortfolioCompany
      }
      on event PortfolioCompany.DirectorAppointed is {
        send event PortfolioCompany.DirectorAppointed to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.DirectorAppointed to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell event PortfolioCompany.DirectorAppointed to entity PortfolioOpsContext.PortfolioCompany
      }
      on event PortfolioCompany.ExitReadinessAssessed is {
        send event PortfolioCompany.ExitReadinessAssessed to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.ExitReadinessAssessed to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell event PortfolioCompany.ExitReadinessAssessed to entity PortfolioOpsContext.PortfolioCompany
      }
      on event PortfolioCompany.ExitInitiated is {
        send event PortfolioCompany.ExitInitiated to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.ExitInitiated to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell event PortfolioCompany.ExitInitiated to entity PortfolioOpsContext.PortfolioCompany
      }
      on event PortfolioCompany.ExitCompleted is {
        send event PortfolioCompany.ExitCompleted to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.ExitCompleted to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell event PortfolioCompany.ExitCompleted to entity PortfolioOpsContext.PortfolioCompany
      }
      on event PortfolioCompany.CompanyWrittenOff is {
        send event PortfolioCompany.CompanyWrittenOff to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.CompanyWrittenOff to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell event PortfolioCompany.CompanyWrittenOff to entity PortfolioOpsContext.PortfolioCompany
      }
      on other is {
        error "Unexpected message for processor PortfolioCompanyEventSplit"
      }
    } with {
      briefly "PortfolioCompany event fan-out handler"
      described as {
        |Delivers each PortfolioCompany event to all of its consumers.
      }
    }
  } with {
    briefly "PortfolioCompany event fan-out"
    described as {
      |Fans PortfolioCompany events out to the repository and projectors.
    }
  }
  connector PortfolioCompanyEventStream is from outlet PortfolioOpsContext.PortfolioCompany.PortfolioCompanyEvents2 to inlet PortfolioOpsContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitIn with {
    briefly "PortfolioCompany events, fanned out to storage and read models"
  }
  connector PortfolioCompanyEventStorage is from outlet PortfolioOpsContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitToPortfolioRepository to inlet PortfolioOpsContext.PortfolioRepository.PortfolioRepositoryFromPortfolioCompany with {
    briefly "PortfolioCompany events on their way to storage"
  }
  connector PortfolioMetricsFeed is from outlet PortfolioOpsContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitToPortfolioMetrics to inlet PortfolioOpsContext.PortfolioMetrics.PortfolioMetricsFromPortfolioCompany with {
    briefly "PortfolioCompany events feeding the PortfolioMetrics projection"
  }
  connector PortfolioMetricsStorage is from outlet PortfolioOpsContext.PortfolioMetrics.PortfolioMetricsOut to inlet PortfolioOpsContext.PortfolioRepository.PortfolioRepositoryFromPortfolioMetrics with {
    briefly "The PortfolioMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for portfolio operations"
  described as {
    |Private equity portfolio operations context.
  }
}
