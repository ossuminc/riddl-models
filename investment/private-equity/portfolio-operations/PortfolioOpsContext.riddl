// Portfolio Operations - Portfolio Ops Context
context PortfolioOpsContext as router is {
  inlet PortfolioOpsContextFromToFinancialReportingSystem is command PortfolioCompany.RecordOperationalKPIs with {
    briefly "What ToFinancialReportingSystem makes of the answers it gets"
  }
  connector 'ToFinancialReportingSystem Intake' is from outlet PortfolioOpsContext.ToFinancialReportingSystem.ToFinancialReportingSystemToPortfolioOpsContext to inlet PortfolioOpsContext.PortfolioOpsContextFromToFinancialReportingSystem with {
    briefly "Answers translated by ToFinancialReportingSystem, on their way in"
  }
  inlet PortfolioOpsContextFromToFundManagementSystem is command PortfolioCompany.OnboardCompany with {
    briefly "What ToFundManagementSystem makes of the answers it gets"
  }
  connector 'ToFundManagementSystem Intake' is from outlet PortfolioOpsContext.ToFundManagementSystem.ToFundManagementSystemToPortfolioOpsContext to inlet PortfolioOpsContext.PortfolioOpsContextFromToFundManagementSystem with {
    briefly "Answers translated by ToFundManagementSystem, on their way in"
  }
  inlet PortfolioOpsContextFromToLegalComplianceSystem is command PortfolioCompany.RecordBoardMeeting with {
    briefly "What ToLegalComplianceSystem makes of the answers it gets"
  }
  connector 'ToLegalComplianceSystem Intake' is from outlet PortfolioOpsContext.ToLegalComplianceSystem.ToLegalComplianceSystemToPortfolioOpsContext to inlet PortfolioOpsContext.PortfolioOpsContextFromToLegalComplianceSystem with {
    briefly "Answers translated by ToLegalComplianceSystem, on their way in"
  }
  inlet PortfolioCompanyCommandStreaIn is type PortfolioCompanyCommand  outlet PortfolioCompanyCommandStreaOut is type PortfolioCompanyCommand
  inlet PortfolioCompanyResultStreamIn is result PortfolioCompany.PortfolioCompanyResult  outlet PortfolioCompanyResultStreamOut is result PortfolioCompany.PortfolioCompanyResult
  handler PortfolioOpsContextBoundary is {
    on onboardCompany: command PortfolioCompany.OnboardCompany is {
      send onboardCompany to outlet PortfolioOpsContext.PortfolioCompanyCommandStreaOut
    }
    on updateFinancials: command PortfolioCompany.UpdateFinancials is {
      send updateFinancials to outlet PortfolioOpsContext.PortfolioCompanyCommandStreaOut
    }
    on recordOperationalKPIs: command PortfolioCompany.RecordOperationalKPIs is {
      send recordOperationalKPIs to outlet PortfolioOpsContext.PortfolioCompanyCommandStreaOut
    }
    on addValueCreationInitiative: command PortfolioCompany.AddValueCreationInitiative is {
      send addValueCreationInitiative to outlet PortfolioOpsContext.PortfolioCompanyCommandStreaOut
    }
    on updateInitiativeStatus: command PortfolioCompany.UpdateInitiativeStatus is {
      send updateInitiativeStatus to outlet PortfolioOpsContext.PortfolioCompanyCommandStreaOut
    }
    on recordBoardMeeting: command PortfolioCompany.RecordBoardMeeting is {
      send recordBoardMeeting to outlet PortfolioOpsContext.PortfolioCompanyCommandStreaOut
    }
    on appointDirector: command PortfolioCompany.AppointDirector is {
      send appointDirector to outlet PortfolioOpsContext.PortfolioCompanyCommandStreaOut
    }
    on assessExitReadiness: command PortfolioCompany.AssessExitReadiness is {
      send assessExitReadiness to outlet PortfolioOpsContext.PortfolioCompanyCommandStreaOut
    }
    on initiateExit: command PortfolioCompany.InitiateExit is {
      send initiateExit to outlet PortfolioOpsContext.PortfolioCompanyCommandStreaOut
    }
    on completeExit: command PortfolioCompany.CompleteExit is {
      send completeExit to outlet PortfolioOpsContext.PortfolioCompanyCommandStreaOut
    }
    on writeOffCompany: command PortfolioCompany.WriteOffCompany is {
      send writeOffCompany to outlet PortfolioOpsContext.PortfolioCompanyCommandStreaOut
    }
    on portfolioCompanyResult: result PortfolioCompany.PortfolioCompanyResult is {
      send portfolioCompanyResult to outlet PortfolioOpsContext.PortfolioCompanyResultStreamOut
    }
    on other is {
      error "Unexpected message at the PortfolioOpsContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PortfolioCompanyCommand Stream Intake' is from outlet PortfolioOpsContext.PortfolioCompanyCommandStreaOut to inlet PortfolioOpsContext.PortfolioCompany.PortfolioCompanyCommands  connector 'PortfolioCompanyResult Stream Egress' is from outlet PortfolioOpsContext.PortfolioRepository.PortfolioRepositoryResponses to inlet PortfolioOpsContext.PortfolioCompanyResultStreamIn  adaptor FromFinancialReportingSystem from context FinancialReportingSystem as sink is { 
    inlet FromFinancialReportingSystemIn is event FinancialReportingSystem.FinancialReportSubmitted    handler FromFinancialReportingSystemHandler is {
      on financialReportSubmitted: event FinancialReportingSystem.FinancialReportSubmitted is {
        do "the report is filed; updating the financials was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromFinancialReportingSystem"
      }
    } with {
      briefly "from financial reporting system"
      described as {
        |Carries messages from the external FinancialReportingSystem.
      }
    }
  } with {
    briefly "FinancialReportingSystem integration"
    described as {
      |The model's side of the FinancialReportingSystem conversation.
    }
  }
  adaptor ToFinancialReportingSystem to context FinancialReportingSystem as router is { 
    outlet ToFinancialReportingSystemToPortfolioOpsContext is command PortfolioCompany.RecordOperationalKPIs
    inlet ToFinancialReportingSystemIn is type PortfolioCompanyEvent    inlet ToFinancialReportingSystemReplies is result FinancialReportingSystem.HistoricalFinancials    outlet ToFinancialReportingSystemOut is type FinancialReportingSystem.FinancialReportingSystemRequest
    handler ToFinancialReportingSystemHandler is {
      on financialsUpdated: event PortfolioCompany.FinancialsUpdated is {
        let askAnswer: type FinancialReportingSystem.HistoricalFinancials = ask query FinancialReportingSystem.GetHistoricalFinancials of context FinancialReportingSystem
        do "new figures meaning nothing without the series they extend"
        send command PortfolioCompany.RecordOperationalKPIs(companyId = financialsUpdated.companyId, kpis = prompt("the KPIs derived from askAnswer.periods extended by the new figures")) to outlet PortfolioOpsContext.ToFinancialReportingSystem.ToFinancialReportingSystemToPortfolioOpsContext
        let item0: type FinancialReportingSystem.SubmitFinancialReport = prompt("translate the financialsUpdated event into a SubmitFinancialReport, the update being what fixes the numbers to report")
        send item0 to outlet PortfolioOpsContext.ToFinancialReportingSystem.ToFinancialReportingSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToFinancialReportingSystem"
      }
    } with {
      briefly "to financial reporting system"
      described as {
        |Carries messages to the external FinancialReportingSystem.
      }
    }
  } with {
    briefly "FinancialReportingSystem integration"
    described as {
      |The model's side of the FinancialReportingSystem conversation.
    }
  }
  adaptor FromFundManagementSystem from context FundManagementSystem as sink is { 
    inlet FromFundManagementSystemIn is event FundManagementSystem.DistributionRecorded    handler FromFundManagementSystemHandler is {
      on distributionRecorded: event FundManagementSystem.DistributionRecorded is {
        do "the distribution is on the fund's books; completing the exit was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromFundManagementSystem"
      }
    } with {
      briefly "from fund management system"
      described as {
        |Carries messages from the external FundManagementSystem.
      }
    }
  } with {
    briefly "FundManagementSystem integration"
    described as {
      |The model's side of the FundManagementSystem conversation.
    }
  }
  adaptor ToFundManagementSystem to context FundManagementSystem as router is { 
    outlet ToFundManagementSystemToPortfolioOpsContext is command PortfolioCompany.OnboardCompany
    inlet ToFundManagementSystemIn is type PortfolioCompanyEvent    inlet ToFundManagementSystemReplies is result FundManagementSystem.FundDetails    outlet ToFundManagementSystemOut is type FundManagementSystem.FundManagementSystemRequest
    handler ToFundManagementSystemHandler is {
      on companyOnboarded: event PortfolioCompany.CompanyOnboarded is {
        let askAnswer: type FundManagementSystem.FundDetails = ask query FundManagementSystem.GetFundDetails of context FundManagementSystem
        do "onboarding needing the fund's terms to book against"
        when prompt("the onboarding named a fund askAnswer does not confirm") then
          send command PortfolioCompany.OnboardCompany(companyId = companyOnboarded.companyId, companyName = companyOnboarded.companyName, fundId = askAnswer.fundId, industry = prompt("the industry"), acquisitionDate = prompt("the acquisition date"), investedCapital = prompt("the capital invested"), exitStrategy = prompt("the exit strategy")) to outlet PortfolioOpsContext.ToFundManagementSystem.ToFundManagementSystemToPortfolioOpsContext
        end
      }
      on exitCompleted: event PortfolioCompany.ExitCompleted is {
        let item0: type FundManagementSystem.RecordDistribution = prompt("translate the exitCompleted event into a RecordDistribution, a completed exit being what there is to distribute")
        send item0 to outlet PortfolioOpsContext.ToFundManagementSystem.ToFundManagementSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToFundManagementSystem"
      }
    } with {
      briefly "to fund management system"
      described as {
        |Carries messages to the external FundManagementSystem.
      }
    }
  } with {
    briefly "FundManagementSystem integration"
    described as {
      |The model's side of the FundManagementSystem conversation.
    }
  }
  adaptor FromLegalComplianceSystem from context LegalComplianceSystem as sink is { 
    inlet FromLegalComplianceSystemIn is event LegalComplianceSystem.BoardResolutionFiled    handler FromLegalComplianceSystemHandler is {
      on boardResolutionFiled: event LegalComplianceSystem.BoardResolutionFiled is {
        do "the resolution is filed; the board meeting was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromLegalComplianceSystem"
      }
    } with {
      briefly "from legal compliance system"
      described as {
        |Carries messages from the external LegalComplianceSystem.
      }
    }
  } with {
    briefly "LegalComplianceSystem integration"
    described as {
      |The model's side of the LegalComplianceSystem conversation.
    }
  }
  adaptor ToLegalComplianceSystem to context LegalComplianceSystem as router is { 
    outlet ToLegalComplianceSystemToPortfolioOpsContext is command PortfolioCompany.RecordBoardMeeting
    inlet ToLegalComplianceSystemIn is type PortfolioCompanyEvent    inlet ToLegalComplianceSystemReplies is result LegalComplianceSystem.ComplianceStatus    outlet ToLegalComplianceSystemOut is type LegalComplianceSystem.LegalComplianceSystemRequest
    handler ToLegalComplianceSystemHandler is {
      on boardMeetingRecorded: event PortfolioCompany.BoardMeetingRecorded is {
        let askAnswer: type LegalComplianceSystem.ComplianceStatus = ask query LegalComplianceSystem.GetComplianceStatus of context LegalComplianceSystem
        do "a board meeting needing the company's standing in front of it"
        when prompt("not askAnswer.isCompliant") then
          send command PortfolioCompany.RecordBoardMeeting(companyId = boardMeetingRecorded.companyId, meeting = prompt("the meeting minuted with askAnswer.pendingFilings noted")) to outlet PortfolioOpsContext.ToLegalComplianceSystem.ToLegalComplianceSystemToPortfolioOpsContext
        end
        let item0: type LegalComplianceSystem.FileBoardResolution = prompt("translate the boardMeetingRecorded event into a FileBoardResolution, a resolution being what a board meeting produces")
        send item0 to outlet PortfolioOpsContext.ToLegalComplianceSystem.ToLegalComplianceSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToLegalComplianceSystem"
      }
    } with {
      briefly "to legal compliance system"
      described as {
        |Carries messages to the external LegalComplianceSystem.
      }
    }
  } with {
    briefly "LegalComplianceSystem integration"
    described as {
      |The model's side of the LegalComplianceSystem conversation.
    }
  }
  include "types.riddl"
  include "PortfolioCompany.riddl"
  type PortfolioRepositoryCommand is one of {
    PortfolioOpsContext.PortfolioRepository.PersistBoardMeetingRecorded or PortfolioOpsContext.PortfolioRepository.PersistCompanyOnboarded or PortfolioOpsContext.PortfolioRepository.PersistCompanyWrittenOff or PortfolioOpsContext.PortfolioRepository.PersistDirectorAppointed or PortfolioOpsContext.PortfolioRepository.PersistExitCompleted or PortfolioOpsContext.PortfolioRepository.PersistExitInitiated or PortfolioOpsContext.PortfolioRepository.PersistExitReadinessAssessed or PortfolioOpsContext.PortfolioRepository.PersistFinancialsUpdated or PortfolioOpsContext.PortfolioRepository.PersistInitiativeAdded or PortfolioOpsContext.PortfolioRepository.PersistInitiativeStatusUpdated or PortfolioOpsContext.PortfolioRepository.PersistOperationalKPIsRecorded
  } with {
    briefly "Anything that writes PortfolioRepository"
    described as {
      |The persistence commands PortfolioRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository PortfolioRepository as flow is {
    inlet PortfolioRepositoryFromPortfolioMetrics is type PortfolioRepositoryCommand    command PersistBoardMeetingRecorded is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row BoardMeetingRecorded applies to.
        }
      }
      meetingId: BoardMeetingId? with {
        briefly "Meeting id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      meetingDate: Date? with {
        briefly "Meeting date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist BoardMeetingRecorded"
      described as {
        |Instructs this repository to apply BoardMeetingRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDirectorAppointed is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row DirectorAppointed applies to.
        }
      }
      directorName: String(3,100)? with {
        briefly "Director name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      appointedAt: TimeStamp? with {
        briefly "Appointed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DirectorAppointed"
      described as {
        |Instructs this repository to apply DirectorAppointed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExitInitiated is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExitInitiated applies to.
        }
      }
      exitStrategy: ExitStrategy? with {
        briefly "Exit strategy"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      initiatedAt: TimeStamp? with {
        briefly "Initiated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ExitInitiated"
      described as {
        |Instructs this repository to apply ExitInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExitReadinessAssessed is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExitReadinessAssessed applies to.
        }
      }
      readiness: ExitReadiness? with {
        briefly "Readiness"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      assessedAt: TimeStamp? with {
        briefly "Assessed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ExitReadinessAssessed"
      described as {
        |Instructs this repository to apply ExitReadinessAssessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInitiativeAdded is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row InitiativeAdded applies to.
        }
      }
      initiativeId: InitiativeId? with {
        briefly "Initiative id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      title: String(3,200)? with {
        briefly "Title"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist InitiativeAdded"
      described as {
        |Instructs this repository to apply InitiativeAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOperationalKPIsRecorded is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row OperationalKPIsRecorded applies to.
        }
      }
      kpiCount: Natural? with {
        briefly "Kpi count"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist OperationalKPIsRecorded"
      described as {
        |Instructs this repository to apply OperationalKPIsRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCompanyOnboarded is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row CompanyOnboarded applies to.
        }
      }
      companyName: String(3,200)? with {
        briefly "Company name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      fundId: FundId? with {
        briefly "Fund id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      onboardedAt: TimeStamp? with {
        briefly "Onboarded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CompanyOnboarded"
      described as {
        |Instructs this repository to apply CompanyOnboarded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCompanyWrittenOff is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row CompanyWrittenOff applies to.
        }
      }
      reason: String(3,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      writtenOffAt: TimeStamp? with {
        briefly "Written off at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CompanyWrittenOff"
      described as {
        |Instructs this repository to apply CompanyWrittenOff to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExitCompleted is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExitCompleted applies to.
        }
      }
      exitValuation: Decimal(14,2)? with {
        briefly "Exit valuation"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      realizedMultiple: Decimal(5,2)? with {
        briefly "Realized multiple"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ExitCompleted"
      described as {
        |Instructs this repository to apply ExitCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFinancialsUpdated is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row FinancialsUpdated applies to.
        }
      }
      metrics: FinancialMetrics? with {
        briefly "Metrics"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist FinancialsUpdated"
      described as {
        |Instructs this repository to apply FinancialsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInitiativeStatusUpdated is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row InitiativeStatusUpdated applies to.
        }
      }
      initiativeId: InitiativeId? with {
        briefly "Initiative id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newStatus: InitiativeStatus? with {
        briefly "New status"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist InitiativeStatusUpdated"
      described as {
        |Instructs this repository to apply InitiativeStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet PortfolioRepositoryResponses is result PortfolioCompany.PortfolioCompanyResult
    record StoredPortfolioCompany is {
      portfolioCompanyId: PortfolioCompanyId with {
        briefly "portfolioCompanyId"
        described as {
          |The portfolioCompanyId column of the stored portfolioCompany row.
        }
      }
      companyId: PortfolioCompanyId with {
        briefly "companyId"
        described as {
          |The companyId column of the stored portfolioCompany row.
        }
      }
      fundId: FundId with {
        briefly "fundId"
        described as {
          |The fundId column of the stored portfolioCompany row.
        }
      }
      status: CompanyStatus with {
        briefly "status"
        described as {
          |The status column of the stored portfolioCompany row.
        }
      }
      meetingId: BoardMeetingId? with {
        briefly "Meeting id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      meetingDate: Date? with {
        briefly "Meeting date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      directorName: String(3,100)? with {
        briefly "Director name"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      appointedAt: TimeStamp? with {
        briefly "Appointed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      exitStrategy: ExitStrategy? with {
        briefly "Exit strategy"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      initiatedAt: TimeStamp? with {
        briefly "Initiated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      readiness: ExitReadiness? with {
        briefly "Readiness"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      assessedAt: TimeStamp? with {
        briefly "Assessed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      initiativeId: InitiativeId? with {
        briefly "Initiative id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      title: String(3,200)? with {
        briefly "Title"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      kpiCount: Natural? with {
        briefly "Kpi count"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      companyName: String(3,200)? with {
        briefly "Company name"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      onboardedAt: TimeStamp? with {
        briefly "Onboarded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(3,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      writtenOffAt: TimeStamp? with {
        briefly "Written off at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      exitValuation: Decimal(14,2)? with {
        briefly "Exit valuation"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      realizedMultiple: Decimal(5,2)? with {
        briefly "Realized multiple"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      metrics: FinancialMetrics? with {
        briefly "Metrics"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newStatus: InitiativeStatus? with {
        briefly "New status"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored portfolioCompany row"
      described as {
        |The persistence shape of portfolioCompany data as this repository stores it.
      }
    }
    schema PortfolioData is relational
      of portfolioCompanies as record StoredPortfolioCompany
        key on field StoredPortfolioCompany.portfolioCompanyId
        index on field StoredPortfolioCompany.companyId
        index on field StoredPortfolioCompany.fundId
        index on field StoredPortfolioCompany.status
 with {
      briefly "Portfolio data schema"
      described as {
        |The relational schema holding portfolio data for the PortfolioRepository.
      }
    }
    handler PortfolioPersistence is {
      on persistBoardMeetingRecorded: command PersistBoardMeetingRecorded is {
        do "apply BoardMeetingRecorded to the stored row"
      }
      on persistDirectorAppointed: command PersistDirectorAppointed is {
        do "apply DirectorAppointed to the stored row"
      }
      on persistExitInitiated: command PersistExitInitiated is {
        do "apply ExitInitiated to the stored row"
      }
      on persistExitReadinessAssessed: command PersistExitReadinessAssessed is {
        do "apply ExitReadinessAssessed to the stored row"
      }
      on persistInitiativeAdded: command PersistInitiativeAdded is {
        do "apply InitiativeAdded to the stored row"
      }
      on persistOperationalKPIsRecorded: command PersistOperationalKPIsRecorded is {
        do "apply OperationalKPIsRecorded to the stored row"
      }
      on persistCompanyOnboarded: command PersistCompanyOnboarded is {
        do "apply CompanyOnboarded to the stored row"
      }
      on persistCompanyWrittenOff: command PersistCompanyWrittenOff is {
        do "apply CompanyWrittenOff to the stored row"
      }
      on persistExitCompleted: command PersistExitCompleted is {
        do "apply ExitCompleted to the stored row"
      }
      on persistFinancialsUpdated: command PersistFinancialsUpdated is {
        do "apply FinancialsUpdated to the stored row"
      }
      on persistInitiativeStatusUpdated: command PersistInitiativeStatusUpdated is {
        do "apply InitiativeStatusUpdated to the stored row"
      }
      on query GetPortfolioPerformanceMetrics is {
        let portfolioPerformanceMetricsView: type PortfolioPerformanceMetricsView = prompt("read the portfolio performance metrics projection")
        reply portfolioPerformanceMetricsView
      }
    } with {
      briefly "Persists portfolio commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Portfolio data persistence"
    described as {
      |Persistent storage for portfolio operations.
    }
  }
  query GetPortfolioPerformanceMetrics replies result PortfolioPerformanceMetricsView is {
    portfolioPerformanceMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which portfolio performance metrics to retrieve.
      }
    }
  } with {
    briefly "Get portfolio performance metrics"
    described as {
      |Retrieves the portfolio performance metrics projection.
    }
  }
  result PortfolioPerformanceMetricsView is {
    portfolioPerformanceMetrics: PortfolioMetrics.PortfolioPerformanceMetrics with {
      briefly "Portfolio performance metrics"
      described as {
        |The portfolio performance metrics being returned.
      }
    }
  } with {
    briefly "Portfolio performance metrics view"
    described as {
      |Read model view carrying the portfolio performance metrics projection.
    }
  }
  projector PortfolioMetrics as flow is {
    updates repository PortfolioOpsContext.PortfolioRepository
    outlet PortfolioMetricsToRepository is type PortfolioRepositoryCommand
    inlet PortfolioMetricsFromPortfolioCompany is type PortfolioCompanyEvent    record PortfolioPerformanceMetrics is {
      totalCompanies: Natural with {
        briefly "Total"
        described as {
          |Total portfolio companies.
        }
      }
      activeCompanies: Natural with {
        briefly "Active"
        described as {
          |Active portfolio companies.
        }
      }
      exitedCompanies: Natural with {
        briefly "Exited"
        described as {
          |Exited companies.
        }
      }
      averageMOIC: Decimal(5,2) with {
        briefly "Avg MOIC"
        described as {
          |Average multiple on invested capital.
        }
      }
      totalInvestedCapital: Decimal(14,2) with {
        briefly "Total invested"
        described as {
          |Total capital invested.
        }
      }
      initiativesOnTrack: Natural with {
        briefly "On track"
        described as {
          |Initiatives on track.
        }
      }
      initiativesAtRisk: Natural with {
        briefly "At risk"
        described as {
          |Initiatives at risk.
        }
      }
    } with {
      briefly "Portfolio performance metrics"
      described as {
        |Aggregated portfolio performance indicators.
      }
    }
    handler MetricsHandler is {
      on boardMeetingRecorded: event PortfolioCompany.BoardMeetingRecorded is {
        tell command PortfolioOpsContext.PortfolioRepository.PersistBoardMeetingRecorded(companyId = boardMeetingRecorded.companyId, meetingId = boardMeetingRecorded.meetingId, meetingDate = boardMeetingRecorded.meetingDate, recordedAt = boardMeetingRecorded.recordedAt) to repository PortfolioOpsContext.PortfolioRepository
        do "apply BoardMeetingRecorded to the PortfolioMetrics projection"
      }
      on directorAppointed: event PortfolioCompany.DirectorAppointed is {
        tell command PortfolioOpsContext.PortfolioRepository.PersistDirectorAppointed(companyId = directorAppointed.companyId, directorName = directorAppointed.directorName, appointedAt = directorAppointed.appointedAt) to repository PortfolioOpsContext.PortfolioRepository
        do "apply DirectorAppointed to the PortfolioMetrics projection"
      }
      on exitInitiated: event PortfolioCompany.ExitInitiated is {
        tell command PortfolioOpsContext.PortfolioRepository.PersistExitInitiated(companyId = exitInitiated.companyId, exitStrategy = exitInitiated.exitStrategy, initiatedAt = exitInitiated.initiatedAt) to repository PortfolioOpsContext.PortfolioRepository
        do "apply ExitInitiated to the PortfolioMetrics projection"
      }
      on exitReadinessAssessed: event PortfolioCompany.ExitReadinessAssessed is {
        tell command PortfolioOpsContext.PortfolioRepository.PersistExitReadinessAssessed(companyId = exitReadinessAssessed.companyId, readiness = exitReadinessAssessed.readiness, assessedAt = exitReadinessAssessed.assessedAt) to repository PortfolioOpsContext.PortfolioRepository
        do "apply ExitReadinessAssessed to the PortfolioMetrics projection"
      }
      on initiativeAdded: event PortfolioCompany.InitiativeAdded is {
        tell command PortfolioOpsContext.PortfolioRepository.PersistInitiativeAdded(companyId = initiativeAdded.companyId, initiativeId = initiativeAdded.initiativeId, title = initiativeAdded.title, addedAt = initiativeAdded.addedAt) to repository PortfolioOpsContext.PortfolioRepository
        do "apply InitiativeAdded to the PortfolioMetrics projection"
      }
      on operationalKPIsRecorded: event PortfolioCompany.OperationalKPIsRecorded is {
        tell command PortfolioOpsContext.PortfolioRepository.PersistOperationalKPIsRecorded(companyId = operationalKPIsRecorded.companyId, kpiCount = operationalKPIsRecorded.kpiCount, recordedAt = operationalKPIsRecorded.recordedAt) to repository PortfolioOpsContext.PortfolioRepository
        do "apply OperationalKPIsRecorded to the PortfolioMetrics projection"
      }
      on companyOnboarded: event PortfolioCompany.CompanyOnboarded is {
        tell command PortfolioOpsContext.PortfolioRepository.PersistCompanyOnboarded(companyId = companyOnboarded.companyId, companyName = companyOnboarded.companyName, fundId = companyOnboarded.fundId, onboardedAt = companyOnboarded.onboardedAt) to repository PortfolioOpsContext.PortfolioRepository
      }
      on financialsUpdated: event PortfolioCompany.FinancialsUpdated is {
        tell command PortfolioOpsContext.PortfolioRepository.PersistFinancialsUpdated(companyId = financialsUpdated.companyId, metrics = financialsUpdated.metrics, updatedAt = financialsUpdated.updatedAt) to repository PortfolioOpsContext.PortfolioRepository
      }
      on initiativeStatusUpdated: event PortfolioCompany.InitiativeStatusUpdated is {
        tell command PortfolioOpsContext.PortfolioRepository.PersistInitiativeStatusUpdated(companyId = initiativeStatusUpdated.companyId, initiativeId = initiativeStatusUpdated.initiativeId, newStatus = initiativeStatusUpdated.newStatus, updatedAt = initiativeStatusUpdated.updatedAt) to repository PortfolioOpsContext.PortfolioRepository
      }
      on exitCompleted: event PortfolioCompany.ExitCompleted is {
        tell command PortfolioOpsContext.PortfolioRepository.PersistExitCompleted(companyId = exitCompleted.companyId, exitValuation = exitCompleted.exitValuation, realizedMultiple = exitCompleted.realizedMultiple, completedAt = exitCompleted.completedAt) to repository PortfolioOpsContext.PortfolioRepository
      }
      on companyWrittenOff: event PortfolioCompany.CompanyWrittenOff is {
        tell command PortfolioOpsContext.PortfolioRepository.PersistCompanyWrittenOff(companyId = companyWrittenOff.companyId, reason = companyWrittenOff.reason, writtenOffAt = companyWrittenOff.writtenOffAt) to repository PortfolioOpsContext.PortfolioRepository
      }
    } with {
      briefly "Maintains portfolio metrics"
      described as {
        |Projects events into portfolio analytics.
      }
    }
  } with {
    briefly "Portfolio metrics"
    described as {
      |Portfolio performance analytics.
    }
  }
  streamlet PortfolioCompanyEventSplit as split is {
    outlet PortfolioCompanyEventSplitToToLegalComplianceSystem is type PortfolioCompanyEvent
    outlet PortfolioCompanyEventSplitToToFundManagementSystem is type PortfolioCompanyEvent
    outlet PortfolioCompanyEventSplitToToFinancialReportingSystem is type PortfolioCompanyEvent
    inlet PortfolioCompanyEventSplitIn is type PortfolioCompanyEvent    outlet PortfolioCompanyEventSplitToPortfolioMetrics is type PortfolioCompanyEvent
    handler PortfolioCompanyEventSplitHandler is {
      on companyOnboarded: event PortfolioCompany.CompanyOnboarded is {
        send companyOnboarded to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        send companyOnboarded to outlet PortfolioCompanyEventSplitToToFundManagementSystem
        tell companyOnboarded to entity PortfolioOpsContext.PortfolioCompany
      }
      on financialsUpdated: event PortfolioCompany.FinancialsUpdated is {
        send financialsUpdated to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        send financialsUpdated to outlet PortfolioCompanyEventSplitToToFinancialReportingSystem
        tell financialsUpdated to entity PortfolioOpsContext.PortfolioCompany
      }
      on operationalKPIsRecorded: event PortfolioCompany.OperationalKPIsRecorded is {
        send operationalKPIsRecorded to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell operationalKPIsRecorded to entity PortfolioOpsContext.PortfolioCompany
      }
      on initiativeAdded: event PortfolioCompany.InitiativeAdded is {
        send initiativeAdded to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell initiativeAdded to entity PortfolioOpsContext.PortfolioCompany
      }
      on initiativeStatusUpdated: event PortfolioCompany.InitiativeStatusUpdated is {
        send initiativeStatusUpdated to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell initiativeStatusUpdated to entity PortfolioOpsContext.PortfolioCompany
      }
      on boardMeetingRecorded: event PortfolioCompany.BoardMeetingRecorded is {
        send boardMeetingRecorded to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        send boardMeetingRecorded to outlet PortfolioCompanyEventSplitToToLegalComplianceSystem
        tell boardMeetingRecorded to entity PortfolioOpsContext.PortfolioCompany
      }
      on directorAppointed: event PortfolioCompany.DirectorAppointed is {
        send directorAppointed to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell directorAppointed to entity PortfolioOpsContext.PortfolioCompany
      }
      on exitReadinessAssessed: event PortfolioCompany.ExitReadinessAssessed is {
        send exitReadinessAssessed to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell exitReadinessAssessed to entity PortfolioOpsContext.PortfolioCompany
      }
      on exitInitiated: event PortfolioCompany.ExitInitiated is {
        send exitInitiated to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell exitInitiated to entity PortfolioOpsContext.PortfolioCompany
      }
      on exitCompleted: event PortfolioCompany.ExitCompleted is {
        send exitCompleted to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        send exitCompleted to outlet PortfolioCompanyEventSplitToToFundManagementSystem
        tell exitCompleted to entity PortfolioOpsContext.PortfolioCompany
      }
      on companyWrittenOff: event PortfolioCompany.CompanyWrittenOff is {
        send companyWrittenOff to outlet PortfolioCompanyEventSplitToPortfolioMetrics
        tell companyWrittenOff to entity PortfolioOpsContext.PortfolioCompany
      }
      on other is {
        error "Unexpected message for processor PortfolioCompanyEventSplit"
      }
    } with {
      briefly "PortfolioCompany event fan-out handler"
      described as {
        |Delivers each PortfolioCompany event to all of its consumers.
      }
    }
  } with {
    briefly "PortfolioCompany event fan-out"
    described as {
      |Fans PortfolioCompany events out to the repository and projectors.
    }
  }
  connector 'ToLegalComplianceSystem Feed' is from outlet PortfolioOpsContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitToToLegalComplianceSystem to inlet PortfolioOpsContext.ToLegalComplianceSystem.ToLegalComplianceSystemIn with {
    briefly "The PortfolioCompany events ToLegalComplianceSystem translates, on their way to it"
  }
  connector 'ToFundManagementSystem Feed' is from outlet PortfolioOpsContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitToToFundManagementSystem to inlet PortfolioOpsContext.ToFundManagementSystem.ToFundManagementSystemIn with {
    briefly "The PortfolioCompany events ToFundManagementSystem translates, on their way to it"
  }
  connector 'ToFinancialReportingSystem Feed' is from outlet PortfolioOpsContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitToToFinancialReportingSystem to inlet PortfolioOpsContext.ToFinancialReportingSystem.ToFinancialReportingSystemIn with {
    briefly "The PortfolioCompany events ToFinancialReportingSystem translates, on their way to it"
  }
  connector 'PortfolioCompanyEvent Stream' is from outlet PortfolioOpsContext.PortfolioCompany.PortfolioCompanyEvents2 to inlet PortfolioOpsContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitIn with {
    briefly "PortfolioCompany events, fanned out to storage and read models"
  }
  connector 'PortfolioMetrics Feed' is from outlet PortfolioOpsContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitToPortfolioMetrics to inlet PortfolioOpsContext.PortfolioMetrics.PortfolioMetricsFromPortfolioCompany with {
    briefly "PortfolioCompany events feeding the PortfolioMetrics projection"
  }
  connector 'PortfolioMetrics Storage' is from outlet PortfolioOpsContext.PortfolioMetrics.PortfolioMetricsToRepository to inlet PortfolioOpsContext.PortfolioRepository.PortfolioRepositoryFromPortfolioMetrics with {
    briefly "PortfolioMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for portfolio operations"
  described as {
    |Private equity portfolio operations context.
  }
}
