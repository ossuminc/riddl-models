// Portfolio Operations Domain Model
// Private equity portfolio company management and value creation
domain PortfolioOperations is {
  persistent connector 'LegalComplianceSystemReply Stream' is from outlet LegalComplianceSystem.LegalComplianceSystemRepliesOut to inlet PortfolioOpsContext.ToLegalComplianceSystem.ToLegalComplianceSystemReplies with {
    briefly "What LegalComplianceSystem answers PortfolioOpsContext"
  }
  persistent connector 'FundManagementSystemReply Stream' is from outlet FundManagementSystem.FundManagementSystemRepliesOut to inlet PortfolioOpsContext.ToFundManagementSystem.ToFundManagementSystemReplies with {
    briefly "What FundManagementSystem answers PortfolioOpsContext"
  }
  persistent connector 'FinancialReportingSystemReply Stream' is from outlet FinancialReportingSystem.FinancialReportingSystemRepliesOut to inlet PortfolioOpsContext.ToFinancialReportingSystem.ToFinancialReportingSystemReplies with {
    briefly "What FinancialReportingSystem answers PortfolioOpsContext"
  }
  persistent connector 'FinancialReportingSystemEvent Stream' is from outlet FinancialReportingSystem.FinancialReportingSystemEventsOut to inlet PortfolioOpsContext.FromFinancialReportingSystem.FromFinancialReportingSystemIn with {
    briefly "What FinancialReportingSystem tells PortfolioOpsContext, unasked"
  }
  persistent connector 'FundManagementSystemEvent Stream' is from outlet FundManagementSystem.FundManagementSystemEventsOut to inlet PortfolioOpsContext.FromFundManagementSystem.FromFundManagementSystemIn with {
    briefly "What FundManagementSystem tells PortfolioOpsContext, unasked"
  }
  persistent connector 'LegalComplianceSystemEvent Stream' is from outlet LegalComplianceSystem.LegalComplianceSystemEventsOut to inlet PortfolioOpsContext.FromLegalComplianceSystem.FromLegalComplianceSystemIn with {
    briefly "What LegalComplianceSystem tells PortfolioOpsContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user OperatingPartner is "person overseeing portfolio company performance" with {
    briefly "Operating Partner"
    described as {
      |Senior PE professional driving operational improvements.
    }
  }
  user BoardMember is "person governing portfolio company strategy" with {
    briefly "Board Member"
    described as {
      |Director providing strategic oversight and governance.
    }
  }
  user PortfolioAnalyst is "person analyzing portfolio company financials" with {
    briefly "Portfolio Analyst"
    described as {
      |Analyst tracking KPIs and financial performance.
    }
  }
  epic ValueCreation is {
    user OperatingPartner wants to "to manage portfolio company value creation" so that "investments achieve target returns at exit"
    case TrackPerformance is {
      user OperatingPartner wants to "to track portfolio company performance" so that "operational improvements are measured"
      step is "Partner reviews" "financial KPIs" "for portfolio company" with {
        briefly "Review KPIs"
        described as {
          |Assess financial metrics.
        }
      }
      step is "System evaluates" "exit readiness" "against targets" with {
        briefly "Evaluate exit"
        described as {
          |Check exit readiness.
        }
      }
    } with {
      briefly "Track portfolio performance"
      described as {
        |Monitoring portfolio company operational metrics.
      }
    }
  } with {
    briefly "Value creation management"
    described as {
      |Epic for PE portfolio value creation and exit readiness.
    }
  }
  include "PortfolioOpsContext.riddl"
  include "external-contexts.riddl"
  application context PortfolioOperationsApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PortfolioOperations are delivered.
      }
    }
    outlet AppPortfolioCompanyCommands is type PortfolioOpsContext.PortfolioCompany.PortfolioCompanyCommand
    inlet AppPortfolioRepositoryResponses is result PortfolioOpsContext.PortfolioCompany.PortfolioCompanyResult    handler PortfolioOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context PortfolioOperationsApp"
      }
    } with {
      briefly "PortfolioOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PortfolioOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'FundManagementSystemRequest Stream' is from outlet PortfolioOpsContext.ToFundManagementSystem.ToFundManagementSystemOut to inlet FundManagementSystem.FundManagementSystemRequests with {
    briefly "What PortfolioOpsContext asks FundManagementSystem to send"
  }
  persistent connector 'LegalComplianceSystemRequest Stream' is from outlet PortfolioOpsContext.ToLegalComplianceSystem.ToLegalComplianceSystemOut to inlet LegalComplianceSystem.LegalComplianceSystemRequests with {
    briefly "What PortfolioOpsContext asks LegalComplianceSystem to send"
  }
  persistent connector 'FinancialReportingSystemRequest Stream' is from outlet PortfolioOpsContext.ToFinancialReportingSystem.ToFinancialReportingSystemOut to inlet FinancialReportingSystem.FinancialReportingSystemRequests with {
    briefly "What PortfolioOpsContext asks FinancialReportingSystem to send"
  }
  persistent connector 'PortfolioCompanyCommand Stream' is from outlet PortfolioOperationsApp.AppPortfolioCompanyCommands to inlet PortfolioOpsContext.PortfolioCompanyCommandStreaIn with {
    briefly "PortfolioCompany commands from the application"
  }
  persistent connector 'PortfolioCompanyResult Stream' is from outlet PortfolioOpsContext.PortfolioCompanyResultStreamOut to inlet PortfolioOperationsApp.AppPortfolioRepositoryResponses with {
    briefly "Portfolio query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PortfolioOperationsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Portfolio operations domain"
  described as {
    |Private equity portfolio company management and value creation.
  }
}
