// Portfolio Operations - External Contexts
external context FundManagementSystem as sink is {
  type FundManagementSystemRequest is one of {
    RecordDistribution or GetFundDetails
  } with {
    briefly "Everything this service can be asked"
  }
  inlet FundManagementSystemRequests is type FundManagementSystemRequest with {
    briefly "What this context asks the service to send"
  }
  handler FundManagementSystemBoundary is {
    on query GetFundDetails is {
      let askAnswer: type FundDetails = prompt("look up what GetFundDetails asks for")
      reply askAnswer
    }
    on command RecordDistribution is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context FundManagementSystem"
    }
  } with {
    briefly "FundManagementSystem boundary"
  }
  query GetFundDetails replies result FundDetails is {
    fundId: FundId with {
      briefly "Fund"
      described as {
        |Fund ID.
      }
    }
  } with {
    briefly "Get fund details"
    described as {
      |Retrieves fund information.
    }
  }
  result FundDetails is {
    fundId: FundId with {
      briefly "Fund"
      described as {
        |Fund ID.
      }
    }
    fundName: String(3,200) with {
      briefly "Name"
      described as {
        |Fund name.
      }
    }
    vintage: Natural with {
      briefly "Vintage"
      described as {
        |Fund vintage year.
      }
    }
    totalCommitted: Decimal(14,2) with {
      briefly "Committed"
      described as {
        |Total committed capital.
      }
    }
    totalDeployed: Decimal(14,2) with {
      briefly "Deployed"
      described as {
        |Total deployed capital.
      }
    }
  } with {
    briefly "Fund details"
    described as {
      |Fund information.
    }
  }
  command RecordDistribution is {
    fundId: FundId with {
      briefly "Fund"
      described as {
        |Fund ID.
      }
    }
    companyId: PortfolioCompanyId with {
      briefly "Company"
      described as {
        |Company ID.
      }
    }
    amount: Decimal(14,2) with {
      briefly "Amount"
      described as {
        |Distribution amount.
      }
    }
    distributionDate: Date with {
      briefly "Date"
      described as {
        |Distribution date.
      }
    }
  } with {
    briefly "Record distribution"
    described as {
      |Records capital distribution from exit.
    }
  }
  event DistributionRecorded is {
    fundId: FundId with {
      briefly "Fund"
      described as {
        |Fund ID.
      }
    }
    amount: Decimal(14,2) with {
      briefly "Amount"
      described as {
        |Distribution amount.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Recording time.
      }
    }
  } with {
    briefly "Distribution recorded"
    described as {
      |Emitted when distribution is recorded.
    }
  }
} with {
  briefly "External fund management"
  described as {
    |Fund-level management and accounting system.
  }
}
external context FinancialReportingSystem as sink is {
  type FinancialReportingSystemRequest is one of {
    SubmitFinancialReport or GetHistoricalFinancials
  } with {
    briefly "Everything this service can be asked"
  }
  inlet FinancialReportingSystemRequests is type FinancialReportingSystemRequest with {
    briefly "What this context asks the service to send"
  }
  handler FinancialReportingSystemBoundary is {
    on query GetHistoricalFinancials is {
      let askAnswer: type HistoricalFinancials = prompt("look up what GetHistoricalFinancials asks for")
      reply askAnswer
    }
    on command SubmitFinancialReport is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context FinancialReportingSystem"
    }
  } with {
    briefly "FinancialReportingSystem boundary"
  }
  command SubmitFinancialReport is {
    companyId: PortfolioCompanyId with {
      briefly "Company"
      described as {
        |Company ID.
      }
    }
    reportType: String(3,50) with {
      briefly "Type"
      described as {
        |Report type.
      }
    }
    reportingPeriod: Date with {
      briefly "Period"
      described as {
        |Reporting period.
      }
    }
    metrics: FinancialMetrics with {
      briefly "Metrics"
      described as {
        |Financial metrics.
      }
    }
  } with {
    briefly "Submit financial report"
    described as {
      |Submits financial report for portfolio company.
    }
  }
  event FinancialReportSubmitted is {
    companyId: PortfolioCompanyId with {
      briefly "Company"
      described as {
        |Company ID.
      }
    }
    reportType: String(3,50) with {
      briefly "Type"
      described as {
        |Report type.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Financial report submitted"
    described as {
      |Emitted when financial report is submitted.
    }
  }
  query GetHistoricalFinancials replies result HistoricalFinancials is {
    companyId: PortfolioCompanyId with {
      briefly "Company"
      described as {
        |Company ID.
      }
    }
    fromDate: Date with {
      briefly "From"
      described as {
        |Start date.
      }
    }
    toDate: Date with {
      briefly "To"
      described as {
        |End date.
      }
    }
  } with {
    briefly "Get historical financials"
    described as {
      |Retrieves historical financial data.
    }
  }
  result HistoricalFinancials is {
    companyId: PortfolioCompanyId with {
      briefly "Company"
      described as {
        |Company ID.
      }
    }
    periods: FinancialMetrics+ with {
      briefly "Periods"
      described as {
        |Financial metrics by period.
      }
    }
  } with {
    briefly "Historical financials"
    described as {
      |Historical financial data.
    }
  }
} with {
  briefly "External financial reporting"
  described as {
    |Financial reporting and consolidation system.
  }
}
external context LegalComplianceSystem as sink is {
  type LegalComplianceSystemRequest is one of {
    FileBoardResolution or GetComplianceStatus
  } with {
    briefly "Everything this service can be asked"
  }
  inlet LegalComplianceSystemRequests is type LegalComplianceSystemRequest with {
    briefly "What this context asks the service to send"
  }
  handler LegalComplianceSystemBoundary is {
    on query GetComplianceStatus is {
      let askAnswer: type ComplianceStatus = prompt("look up what GetComplianceStatus asks for")
      reply askAnswer
    }
    on command FileBoardResolution is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context LegalComplianceSystem"
    }
  } with {
    briefly "LegalComplianceSystem boundary"
  }
  command FileBoardResolution is {
    companyId: PortfolioCompanyId with {
      briefly "Company"
      described as {
        |Company ID.
      }
    }
    resolution: String(3,1000) with {
      briefly "Resolution"
      described as {
        |Board resolution text.
      }
    }
    filingDate: Date with {
      briefly "Date"
      described as {
        |Filing date.
      }
    }
  } with {
    briefly "File board resolution"
    described as {
      |Files a board resolution for compliance.
    }
  }
  event BoardResolutionFiled is {
    companyId: PortfolioCompanyId with {
      briefly "Company"
      described as {
        |Company ID.
      }
    }
    filedAt: TimeStamp with {
      briefly "Filed"
      described as {
        |Filing time.
      }
    }
  } with {
    briefly "Board resolution filed"
    described as {
      |Emitted when board resolution is filed.
    }
  }
  query GetComplianceStatus replies result ComplianceStatus is {
    companyId: PortfolioCompanyId with {
      briefly "Company"
      described as {
        |Company ID.
      }
    }
  } with {
    briefly "Get compliance status"
    described as {
      |Gets regulatory compliance status.
    }
  }
  result ComplianceStatus is {
    companyId: PortfolioCompanyId with {
      briefly "Company"
      described as {
        |Company ID.
      }
    }
    isCompliant: Boolean with {
      briefly "Compliant"
      described as {
        |Overall compliance.
      }
    }
    pendingFilings: Natural with {
      briefly "Pending"
      described as {
        |Pending filings count.
      }
    }
    lastReviewDate: Date with {
      briefly "Last review"
      described as {
        |Last compliance review.
      }
    }
  } with {
    briefly "Compliance status"
    described as {
      |Regulatory compliance status.
    }
  }
} with {
  briefly "External legal compliance"
  described as {
    |Legal and regulatory compliance system.
  }
}
