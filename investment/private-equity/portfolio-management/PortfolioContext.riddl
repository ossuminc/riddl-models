// Portfolio Management - Portfolio Context
context PortfolioContext is {
  adaptor FromFundAdministrationService from context FundAdministrationService is { 
    handler FromFundAdministrationServiceHandler is {
      on event FundAdministrationService.CapitalCallRecorded is {
        do "the model receives capital call recorded"
      }
      on event FundAdministrationService.DistributionRecorded is {
        do "the model receives distribution recorded"
      }
      on result FundAdministrationService.FundDetails is {
        do "the model receives fund details"
      }
      on other is {
        error "Unexpected message for adaptor FromFundAdministrationService"
      }
    } with {
      briefly "from fund administration service"
      described as {
        |Carries messages from the external FundAdministrationService.
      }
    }
  } with {
    briefly "FundAdministrationService integration"
    described as {
      |The model's side of the FundAdministrationService conversation.
    }
  }
  adaptor ToFundAdministrationService to context FundAdministrationService is { 
    handler ToFundAdministrationServiceHandler is {
      on query FundAdministrationService.GetFundDetails is {
        do "the model sends get fund details"
      }
      on command FundAdministrationService.RecordCapitalCall is {
        do "the model sends record capital call"
      }
      on command FundAdministrationService.RecordDistribution is {
        do "the model sends record distribution"
      }
      on other is {
        error "Unexpected message for adaptor ToFundAdministrationService"
      }
    } with {
      briefly "to fund administration service"
      described as {
        |Carries messages to the external FundAdministrationService.
      }
    }
  } with {
    briefly "FundAdministrationService integration"
    described as {
      |The model's side of the FundAdministrationService conversation.
    }
  }
  adaptor FromInvestorRelationsService from context InvestorRelationsService is { 
    handler FromInvestorRelationsServiceHandler is {
      on event InvestorRelationsService.ReportGenerated is {
        do "the model receives report generated"
      }
      on event InvestorRelationsService.UpdateSent is {
        do "the model receives update sent"
      }
      on other is {
        error "Unexpected message for adaptor FromInvestorRelationsService"
      }
    } with {
      briefly "from investor relations service"
      described as {
        |Carries messages from the external InvestorRelationsService.
      }
    }
  } with {
    briefly "InvestorRelationsService integration"
    described as {
      |The model's side of the InvestorRelationsService conversation.
    }
  }
  adaptor ToInvestorRelationsService to context InvestorRelationsService is { 
    handler ToInvestorRelationsServiceHandler is {
      on command InvestorRelationsService.GenerateQuarterlyReport is {
        do "the model sends generate quarterly report"
      }
      on command InvestorRelationsService.SendPortfolioUpdate is {
        do "the model sends send portfolio update"
      }
      on other is {
        error "Unexpected message for adaptor ToInvestorRelationsService"
      }
    } with {
      briefly "to investor relations service"
      described as {
        |Carries messages to the external InvestorRelationsService.
      }
    }
  } with {
    briefly "InvestorRelationsService integration"
    described as {
      |The model's side of the InvestorRelationsService conversation.
    }
  }
  adaptor FromLegalDocumentService from context LegalDocumentService is { 
    handler FromLegalDocumentServiceHandler is {
      on event LegalDocumentService.DocumentGenerated is {
        do "the model receives document generated"
      }
      on result LegalDocumentService.DocumentList is {
        do "the model receives document list"
      }
      on other is {
        error "Unexpected message for adaptor FromLegalDocumentService"
      }
    } with {
      briefly "from legal document service"
      described as {
        |Carries messages from the external LegalDocumentService.
      }
    }
  } with {
    briefly "LegalDocumentService integration"
    described as {
      |The model's side of the LegalDocumentService conversation.
    }
  }
  adaptor ToLegalDocumentService to context LegalDocumentService is { 
    handler ToLegalDocumentServiceHandler is {
      on command LegalDocumentService.GenerateInvestmentAgreement is {
        do "the model sends generate investment agreement"
      }
      on query LegalDocumentService.GetDocuments is {
        do "the model sends get documents"
      }
      on other is {
        error "Unexpected message for adaptor ToLegalDocumentService"
      }
    } with {
      briefly "to legal document service"
      described as {
        |Carries messages to the external LegalDocumentService.
      }
    }
  } with {
    briefly "LegalDocumentService integration"
    described as {
      |The model's side of the LegalDocumentService conversation.
    }
  }
  adaptor FromMarketDataService from context MarketDataService is { 
    handler FromMarketDataServiceHandler is {
      on result MarketDataService.ComparableSet is {
        do "the model receives comparable set"
      }
      on result MarketDataService.PrecedentTransaction is {
        do "the model receives precedent transaction"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketDataService"
      }
    } with {
      briefly "from market data service"
      described as {
        |Carries messages from the external MarketDataService.
      }
    }
  } with {
    briefly "MarketDataService integration"
    described as {
      |The model's side of the MarketDataService conversation.
    }
  }
  adaptor ToMarketDataService to context MarketDataService is { 
    handler ToMarketDataServiceHandler is {
      on query MarketDataService.GetComparableValuations is {
        do "the model sends get comparable valuations"
      }
      on query MarketDataService.GetPrecedentTransactions is {
        do "the model sends get precedent transactions"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketDataService"
      }
    } with {
      briefly "to market data service"
      described as {
        |Carries messages to the external MarketDataService.
      }
    }
  } with {
    briefly "MarketDataService integration"
    described as {
      |The model's side of the MarketDataService conversation.
    }
  }
  include "types.riddl"
  include "PortfolioCompany.riddl"
  // Repository for portfolio company persistence
  repository PortfolioRepository is {
    inlet PortfolioRepositoryFromPortfolioCompany is type PortfolioCompanyEvent    inlet PortfolioRepositoryFromPortfolioAnalytics is type PortfolioCompanyEvent    outlet PortfolioRepositoryResponses is type PortfolioCompany.PortfolioCompanyResult
    record StoredPortfolioCompany is  {
      portfolioCompanyId: PortfolioCompanyId with {
        briefly "portfolioCompanyId"
        described as {
          |The portfolioCompanyId column of the stored portfolioCompany row.
        }
      }
      companyId: PortfolioCompanyId with {
        briefly "companyId"
        described as {
          |The companyId column of the stored portfolioCompany row.
        }
      }
      investment: InvestmentInfo with {
        briefly "investment"
        described as {
          |The investment column of the stored portfolioCompany row.
        }
      }
      status: PortfolioStatus with {
        briefly "status"
        described as {
          |The status column of the stored portfolioCompany row.
        }
      }
    } with {
      briefly "Stored portfolioCompany row"
      described as {
        |The persistence shape of portfolioCompany data as this repository stores it.
      }
    }
    schema PortfolioData is relational
      of portfolioCompanies as type StoredPortfolioCompany
        index on field StoredPortfolioCompany.companyId
        index on field StoredPortfolioCompany.investment.fundId
        index on field StoredPortfolioCompany.status
 with {
      briefly "Portfolio data schema"
      described as {
        |The relational schema holding portfolio data for the PortfolioRepository.
      }
    }
    handler PortfolioPersistence is {
      on query GetPortfolioSummary is {
        do "read the portfolio summary projection"
        yield result PortfolioSummaryView
      }
      on query GetFundPerformance is {
        do "read the fund performance projection"
        yield result FundPerformanceView
      }
      on query GetCompanyPerformance is {
        do "read the company performance projection"
        yield result CompanyPerformanceView
      }
      on command PortfolioCompany.AcquireCompany is {
        tell event PortfolioCompany.CompanyAcquired to entity PortfolioContext.PortfolioCompany
      }
      on command PortfolioCompany.UpdateCompanyInfo is {
        tell event PortfolioCompany.CompanyInfoUpdated to entity PortfolioContext.PortfolioCompany
      }
      on command PortfolioCompany.RecordFinancials is {
        tell event PortfolioCompany.FinancialsRecorded to entity PortfolioContext.PortfolioCompany
      }
      on command PortfolioCompany.UpdateValuation is {
        tell event PortfolioCompany.ValuationUpdated to entity PortfolioContext.PortfolioCompany
      }
      on command PortfolioCompany.MakeFollowOn is {
        tell event PortfolioCompany.FollowOnMade to entity PortfolioContext.PortfolioCompany
      }
      on command PortfolioCompany.AppointBoardMember is {
        tell event PortfolioCompany.BoardMemberAppointed to entity PortfolioContext.PortfolioCompany
      }
      on command PortfolioCompany.RemoveBoardMember is {
        tell event PortfolioCompany.BoardMemberRemoved to entity PortfolioContext.PortfolioCompany
      }
      on command PortfolioCompany.ExitInvestment is {
        tell event PortfolioCompany.InvestmentExited to entity PortfolioContext.PortfolioCompany
      }
      on command PortfolioCompany.WriteOffInvestment is {
        tell event PortfolioCompany.InvestmentWrittenOff to entity PortfolioContext.PortfolioCompany
      }
    } with {
      briefly "Persists portfolio company events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Portfolio data persistence"
    described as {
      | The PortfolioRepository provides persistent storage for
      | portfolio companies, valuations, and financial data.
    }
  }
  // Projector for portfolio analytics
  query GetPortfolioSummary is  {
    portfolioSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which portfolio summary to retrieve.
      }
    }
  } with {
    briefly "Get portfolio summary"
    described as {
      |Retrieves the portfolio summary projection.
    }
  }
  result PortfolioSummaryView is  {
    portfolioSummary: PortfolioAnalytics.PortfolioSummary with {
      briefly "Portfolio summary"
      described as {
        |The portfolio summary being returned.
      }
    }
  } with {
    briefly "Portfolio summary view"
    described as {
      |Read model view carrying the portfolio summary projection.
    }
  }
  query GetFundPerformance is  {
    fundPerformanceKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which fund performance to retrieve.
      }
    }
  } with {
    briefly "Get fund performance"
    described as {
      |Retrieves the fund performance projection.
    }
  }
  result FundPerformanceView is  {
    fundPerformance: PortfolioAnalytics.FundPerformance with {
      briefly "Fund performance"
      described as {
        |The fund performance being returned.
      }
    }
  } with {
    briefly "Fund performance view"
    described as {
      |Read model view carrying the fund performance projection.
    }
  }
  query GetCompanyPerformance is  {
    companyPerformanceKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which company performance to retrieve.
      }
    }
  } with {
    briefly "Get company performance"
    described as {
      |Retrieves the company performance projection.
    }
  }
  result CompanyPerformanceView is  {
    companyPerformance: PortfolioAnalytics.CompanyPerformance with {
      briefly "Company performance"
      described as {
        |The company performance being returned.
      }
    }
  } with {
    briefly "Company performance view"
    described as {
      |Read model view carrying the company performance projection.
    }
  }
  projector PortfolioAnalytics is {
    updates repository PortfolioContext.PortfolioRepository
    inlet PortfolioAnalyticsFromPortfolioCompany is type PortfolioCompanyEvent    outlet PortfolioAnalyticsOut is type PortfolioCompanyEvent
    record PortfolioSummary is  {
      totalCompanies: Natural with {
        briefly "Companies"
        described as {
          |Total portfolio companies.
        }
      }
      activeCompanies: Natural with {
        briefly "Active"
        described as {
          |Active companies.
        }
      }
      totalInvested: MonetaryAmount with {
        briefly "Invested"
        described as {
          |Total capital invested.
        }
      }
      currentValue: MonetaryAmount with {
        briefly "Value"
        described as {
          |Current portfolio value.
        }
      }
      unrealizedGain: MonetaryAmount with {
        briefly "Unrealized"
        described as {
          |Unrealized gain/loss.
        }
      }
      grossMOIC: Decimal(6,2) with {
        briefly "MOIC"
        described as {
          |Gross multiple on invested capital.
        }
      }
    } with {
      briefly "Portfolio summary"
      described as {
        |Aggregate portfolio metrics.
      }
    }
    record FundPerformance is  {
      fundId: FundId with {
        briefly "Fund"
        described as {
          |Fund identifier.
        }
      }
      investedCapital: MonetaryAmount with {
        briefly "Invested"
        described as {
          |Capital invested.
        }
      }
      realizedValue: MonetaryAmount with {
        briefly "Realized"
        described as {
          |Realized proceeds.
        }
      }
      unrealizedValue: MonetaryAmount with {
        briefly "Unrealized"
        described as {
          |Unrealized value.
        }
      }
      totalValue: MonetaryAmount with {
        briefly "Total"
        described as {
          |Total value.
        }
      }
      grossMOIC: Decimal(6,2) with {
        briefly "MOIC"
        described as {
          |Gross multiple.
        }
      }
      netIRR: Decimal(6,2) with {
        briefly "IRR"
        described as {
          |Net IRR.
        }
      }
    } with {
      briefly "Fund performance"
      described as {
        |Fund-level performance metrics.
      }
    }
    record CompanyPerformance is  {
      companyId: PortfolioCompanyId with {
        briefly "Company"
        described as {
          |Company ID.
        }
      }
      companyName: String(1,200) with {
        briefly "Name"
        described as {
          |Company name.
        }
      }
      invested: MonetaryAmount with {
        briefly "Invested"
        described as {
          |Capital invested.
        }
      }
      currentValue: MonetaryAmount with {
        briefly "Value"
        described as {
          |Current value.
        }
      }
      moic: Decimal(6,2) with {
        briefly "MOIC"
        described as {
          |Return multiple.
        }
      }
      holdingPeriod: Natural with {
        briefly "Holding"
        described as {
          |Holding period in months.
        }
      }
      lastRevenueGrowth: Decimal(6,2) with {
        briefly "Growth"
        described as {
          |Last revenue growth.
        }
      }
    } with {
      briefly "Company performance"
      described as {
        |Individual company performance.
      }
    }
    handler AnalyticsHandler is {
      on event PortfolioCompany.CompanyAcquired is {
        tell event PortfolioCompany.CompanyAcquired to repository PortfolioContext.PortfolioRepository
      }
      on event PortfolioCompany.ValuationUpdated is {
        tell event PortfolioCompany.ValuationUpdated to repository PortfolioContext.PortfolioRepository
      }
      on event PortfolioCompany.FollowOnMade is {
        tell event PortfolioCompany.FollowOnMade to repository PortfolioContext.PortfolioRepository
      }
      on event PortfolioCompany.InvestmentExited is {
        tell event PortfolioCompany.InvestmentExited to repository PortfolioContext.PortfolioRepository
      }
      on event PortfolioCompany.FinancialsRecorded is {
        tell event PortfolioCompany.FinancialsRecorded to repository PortfolioContext.PortfolioRepository
      }
    } with {
      briefly "Maintains portfolio analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Portfolio analytics projections"
    described as {
      |Maintains portfolio performance analytics.
    }
  }
  processor PortfolioCompanySource as source is {
    outlet PortfolioCompanyEvents is type PortfolioCompanyEvent
    handler PortfolioCompanySourceHandler is {
      on init is {
        tell command PortfolioCompany.InitializePortfolioCompany to entity PortfolioContext.PortfolioCompany
      }
      on other is {
        error "Unexpected message for source PortfolioCompanySource"
      }
      on event PortfolioCompany.CompanyAcquired is {
        send event PortfolioCompany.CompanyAcquired to outlet PortfolioCompanyEvents
      }
      on event PortfolioCompany.ValuationUpdated is {
        send event PortfolioCompany.ValuationUpdated to outlet PortfolioCompanyEvents
      }
      on event PortfolioCompany.InvestmentExited is {
        send event PortfolioCompany.InvestmentExited to outlet PortfolioCompanyEvents
      }
    } with {
      briefly "Portfolio company source handler"
      described as {
        |Handles portfolio company events and sends to outlet.
      }
    }
  } with {
    briefly "Portfolio company event source"
    described as {
      |Publishes portfolio company entity events.
    }
  }
  processor PortfolioCompanySink as sink is {
    inlet PortfolioCompanyInlet is type PortfolioCompanyEvent    handler PortfolioCompanySinkHandler is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink PortfolioCompanySink"
      }
      on event PortfolioCompany.CompanyAcquired is {
        tell event PortfolioCompany.CompanyAcquired to repository PortfolioContext.PortfolioRepository
      }
      on event PortfolioCompany.ValuationUpdated is {
        tell event PortfolioCompany.ValuationUpdated to repository PortfolioContext.PortfolioRepository
      }
      on event PortfolioCompany.InvestmentExited is {
        tell event PortfolioCompany.InvestmentExited to repository PortfolioContext.PortfolioRepository
      }
    } with {
      briefly "Portfolio company sink handler"
      described as {
        |Receives portfolio company events and persists them.
      }
    }
  } with {
    briefly "Portfolio company event sink"
    described as {
      |Receives portfolio company events for persistence.
    }
  }
  connector PortfolioCompanyFlow is from outlet PortfolioContext.PortfolioCompanySource.PortfolioCompanyEvents to inlet PortfolioContext.PortfolioCompanySink.PortfolioCompanyInlet with {
    briefly "Portfolio company event flow"
    described as {
      |Connects portfolio company source to sink.
    }
  }
  processor PortfolioCompanyEventSplit is {
    inlet PortfolioCompanyEventSplitIn is type PortfolioCompanyEvent    outlet PortfolioCompanyEventSplitToPortfolioRepository is type PortfolioCompanyEvent
    outlet PortfolioCompanyEventSplitToPortfolioAnalytics is type PortfolioCompanyEvent
    handler PortfolioCompanyEventSplitHandler is {
      on event PortfolioCompany.CompanyAcquired is {
        send event PortfolioCompany.CompanyAcquired to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.CompanyAcquired to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        tell event PortfolioCompany.CompanyAcquired to entity PortfolioContext.PortfolioCompany
      }
      on event PortfolioCompany.CompanyInfoUpdated is {
        send event PortfolioCompany.CompanyInfoUpdated to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.CompanyInfoUpdated to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        tell event PortfolioCompany.CompanyInfoUpdated to entity PortfolioContext.PortfolioCompany
      }
      on event PortfolioCompany.FinancialsRecorded is {
        send event PortfolioCompany.FinancialsRecorded to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.FinancialsRecorded to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        tell event PortfolioCompany.FinancialsRecorded to entity PortfolioContext.PortfolioCompany
      }
      on event PortfolioCompany.ValuationUpdated is {
        send event PortfolioCompany.ValuationUpdated to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.ValuationUpdated to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        tell event PortfolioCompany.ValuationUpdated to entity PortfolioContext.PortfolioCompany
      }
      on event PortfolioCompany.FollowOnMade is {
        send event PortfolioCompany.FollowOnMade to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.FollowOnMade to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        tell event PortfolioCompany.FollowOnMade to entity PortfolioContext.PortfolioCompany
      }
      on event PortfolioCompany.BoardMemberAppointed is {
        send event PortfolioCompany.BoardMemberAppointed to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.BoardMemberAppointed to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        tell event PortfolioCompany.BoardMemberAppointed to entity PortfolioContext.PortfolioCompany
      }
      on event PortfolioCompany.BoardMemberRemoved is {
        send event PortfolioCompany.BoardMemberRemoved to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.BoardMemberRemoved to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        tell event PortfolioCompany.BoardMemberRemoved to entity PortfolioContext.PortfolioCompany
      }
      on event PortfolioCompany.InvestmentExited is {
        send event PortfolioCompany.InvestmentExited to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.InvestmentExited to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        tell event PortfolioCompany.InvestmentExited to entity PortfolioContext.PortfolioCompany
      }
      on event PortfolioCompany.InvestmentWrittenOff is {
        send event PortfolioCompany.InvestmentWrittenOff to outlet PortfolioCompanyEventSplitToPortfolioRepository
        send event PortfolioCompany.InvestmentWrittenOff to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        tell event PortfolioCompany.InvestmentWrittenOff to entity PortfolioContext.PortfolioCompany
      }
      on other is {
        error "Unexpected message for processor PortfolioCompanyEventSplit"
      }
    } with {
      briefly "PortfolioCompany event fan-out handler"
      described as {
        |Delivers each PortfolioCompany event to all of its consumers.
      }
    }
  } with {
    briefly "PortfolioCompany event fan-out"
    described as {
      |Fans PortfolioCompany events out to the repository and projectors.
    }
  }
  connector 'PortfolioCompanyEvent Stream' is from outlet PortfolioContext.PortfolioCompany.PortfolioCompanyEvents2 to inlet PortfolioContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitIn with {
    briefly "PortfolioCompany events, fanned out to storage and read models"
  }
  connector 'PortfolioCompanyEvent Storage' is from outlet PortfolioContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitToPortfolioRepository to inlet PortfolioContext.PortfolioRepository.PortfolioRepositoryFromPortfolioCompany with {
    briefly "PortfolioCompany events on their way to storage"
  }
  connector 'PortfolioAnalytics Feed' is from outlet PortfolioContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitToPortfolioAnalytics to inlet PortfolioContext.PortfolioAnalytics.PortfolioAnalyticsFromPortfolioCompany with {
    briefly "PortfolioCompany events feeding the PortfolioAnalytics projection"
  }
  connector 'PortfolioAnalytics Storage' is from outlet PortfolioContext.PortfolioAnalytics.PortfolioAnalyticsOut to inlet PortfolioContext.PortfolioRepository.PortfolioRepositoryFromPortfolioAnalytics with {
    briefly "The PortfolioAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for portfolio management"
  described as {
    | The PortfolioContext is the bounded context for
    | private equity portfolio company management.
  }
}
