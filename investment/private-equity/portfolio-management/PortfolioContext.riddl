// Portfolio Management - Portfolio Context
context PortfolioContext as router is {
  inlet PortfolioCompanyCommandStreaIn is type PortfolioCompanyCommand  outlet PortfolioCompanyCommandStreaOut is type PortfolioCompanyCommand
  inlet PortfolioCompanyResultStreamIn is result PortfolioCompany.PortfolioCompanyResult  outlet PortfolioCompanyResultStreamOut is result PortfolioCompany.PortfolioCompanyResult
  handler PortfolioContextBoundary is {
    on acquireCompany: command PortfolioCompany.AcquireCompany is {
      send acquireCompany to outlet PortfolioContext.PortfolioCompanyCommandStreaOut
    }
    on updateCompanyInfo: command PortfolioCompany.UpdateCompanyInfo is {
      send updateCompanyInfo to outlet PortfolioContext.PortfolioCompanyCommandStreaOut
    }
    on recordFinancials: command PortfolioCompany.RecordFinancials is {
      send recordFinancials to outlet PortfolioContext.PortfolioCompanyCommandStreaOut
    }
    on updateValuation: command PortfolioCompany.UpdateValuation is {
      send updateValuation to outlet PortfolioContext.PortfolioCompanyCommandStreaOut
    }
    on makeFollowOn: command PortfolioCompany.MakeFollowOn is {
      send makeFollowOn to outlet PortfolioContext.PortfolioCompanyCommandStreaOut
    }
    on appointBoardMember: command PortfolioCompany.AppointBoardMember is {
      send appointBoardMember to outlet PortfolioContext.PortfolioCompanyCommandStreaOut
    }
    on removeBoardMember: command PortfolioCompany.RemoveBoardMember is {
      send removeBoardMember to outlet PortfolioContext.PortfolioCompanyCommandStreaOut
    }
    on exitInvestment: command PortfolioCompany.ExitInvestment is {
      send exitInvestment to outlet PortfolioContext.PortfolioCompanyCommandStreaOut
    }
    on writeOffInvestment: command PortfolioCompany.WriteOffInvestment is {
      send writeOffInvestment to outlet PortfolioContext.PortfolioCompanyCommandStreaOut
    }
    on portfolioCompanyResult: result PortfolioCompany.PortfolioCompanyResult is {
      send portfolioCompanyResult to outlet PortfolioContext.PortfolioCompanyResultStreamOut
    }
    on other is {
      error "Unexpected message at the PortfolioContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PortfolioCompanyCommand Stream Intake' is from outlet PortfolioContext.PortfolioCompanyCommandStreaOut to inlet PortfolioContext.PortfolioCompany.PortfolioCompanyCommands  connector 'PortfolioCompanyResult Stream Egress' is from outlet PortfolioContext.PortfolioRepository.PortfolioRepositoryResponses to inlet PortfolioContext.PortfolioCompanyResultStreamIn  adaptor FromFundAdministrationService from context FundAdministrationService as sink is { 
    inlet FromFundAdministrationServiceIn is type FundAdministrationService.FundAdministrationServiceEvent    handler FromFundAdministrationServiceHandler is {
      on capitalCallRecorded: event FundAdministrationService.CapitalCallRecorded is {
        do "the call is on the fund's books; the follow-on was recorded here"
      }
      on distributionRecorded: event FundAdministrationService.DistributionRecorded is {
        do "the distribution is on the fund's books; the exit was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromFundAdministrationService"
      }
    } with {
      briefly "from fund administration service"
      described as {
        |Carries messages from the external FundAdministrationService.
      }
    }
  } with {
    briefly "FundAdministrationService integration"
    described as {
      |The model's side of the FundAdministrationService conversation.
    }
  }
  adaptor ToFundAdministrationService to context FundAdministrationService as merge is { 
    inlet ToFundAdministrationServiceIn is type PortfolioCompanyEvent    inlet ToFundAdministrationServiceReplies is result FundAdministrationService.FundDetails    outlet ToFundAdministrationServiceOut is type FundAdministrationService.FundAdministrationServiceCommand
    handler ToFundAdministrationServiceHandler is {
      on companyAcquired: event PortfolioCompany.CompanyAcquired is {
        let askAnswer: type FundAdministrationService.FundDetails = ask query FundAdministrationService.GetFundDetails of context FundAdministrationService
        do "an acquisition needing the fund's terms to book it against"
      }
      on followOnMade: event PortfolioCompany.FollowOnMade is {
        let item0: type FundAdministrationService.RecordCapitalCall = prompt("translate the followOnMade event into a RecordCapitalCall, a follow-on being what draws the capital")
        send item0 to outlet PortfolioContext.ToFundAdministrationService.ToFundAdministrationServiceOut
      }
      on investmentExited: event PortfolioCompany.InvestmentExited is {
        let item0: type FundAdministrationService.RecordDistribution = prompt("translate the investmentExited event into a RecordDistribution, an exit being what returns it")
        send item0 to outlet PortfolioContext.ToFundAdministrationService.ToFundAdministrationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToFundAdministrationService"
      }
    } with {
      briefly "to fund administration service"
      described as {
        |Carries messages to the external FundAdministrationService.
      }
    }
  } with {
    briefly "FundAdministrationService integration"
    described as {
      |The model's side of the FundAdministrationService conversation.
    }
  }
  adaptor FromInvestorRelationsService from context InvestorRelationsService as sink is { 
    inlet FromInvestorRelationsServiceIn is type InvestorRelationsService.InvestorRelationsServiceEvent    handler FromInvestorRelationsServiceHandler is {
      on reportGenerated: event InvestorRelationsService.ReportGenerated is {
        do "the report exists; the financials it draws on were recorded here"
      }
      on updateSent: event InvestorRelationsService.UpdateSent is {
        do "the investors have been told; the valuation was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromInvestorRelationsService"
      }
    } with {
      briefly "from investor relations service"
      described as {
        |Carries messages from the external InvestorRelationsService.
      }
    }
  } with {
    briefly "InvestorRelationsService integration"
    described as {
      |The model's side of the InvestorRelationsService conversation.
    }
  }
  adaptor ToInvestorRelationsService to context InvestorRelationsService as flow is { 
    inlet ToInvestorRelationsServiceIn is type PortfolioCompanyEvent    outlet ToInvestorRelationsServiceOut is type InvestorRelationsService.InvestorRelationsServiceCommand
    handler ToInvestorRelationsServiceHandler is {
      on valuationUpdated: event PortfolioCompany.ValuationUpdated is {
        let item0: type InvestorRelationsService.SendPortfolioUpdate = prompt("translate the valuationUpdated event into a SendPortfolioUpdate, a changed valuation being what investors are owed")
        send item0 to outlet PortfolioContext.ToInvestorRelationsService.ToInvestorRelationsServiceOut
      }
      on financialsRecorded: event PortfolioCompany.FinancialsRecorded is {
        let item0: type InvestorRelationsService.GenerateQuarterlyReport = prompt("translate the financialsRecorded event into a GenerateQuarterlyReport, recorded financials being what a quarter is reported from")
        send item0 to outlet PortfolioContext.ToInvestorRelationsService.ToInvestorRelationsServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToInvestorRelationsService"
      }
    } with {
      briefly "to investor relations service"
      described as {
        |Carries messages to the external InvestorRelationsService.
      }
    }
  } with {
    briefly "InvestorRelationsService integration"
    described as {
      |The model's side of the InvestorRelationsService conversation.
    }
  }
  adaptor FromLegalDocumentService from context LegalDocumentService as sink is { 
    inlet FromLegalDocumentServiceIn is event LegalDocumentService.DocumentGenerated    handler FromLegalDocumentServiceHandler is {
      on documentGenerated: event LegalDocumentService.DocumentGenerated is {
        do "the agreement exists; acquiring the company was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromLegalDocumentService"
      }
    } with {
      briefly "from legal document service"
      described as {
        |Carries messages from the external LegalDocumentService.
      }
    }
  } with {
    briefly "LegalDocumentService integration"
    described as {
      |The model's side of the LegalDocumentService conversation.
    }
  }
  adaptor ToLegalDocumentService to context LegalDocumentService as merge is { 
    inlet ToLegalDocumentServiceIn is type PortfolioCompanyEvent    inlet ToLegalDocumentServiceReplies is result LegalDocumentService.DocumentList    outlet ToLegalDocumentServiceOut is type LegalDocumentService.LegalDocumentServiceRequest
    handler ToLegalDocumentServiceHandler is {
      on companyAcquired: event CompanyAcquired is {
        let artifact: type LegalDocumentService.GenerateInvestmentAgreement = prompt("translate the companyAcquired event into a GenerateInvestmentAgreement papering the investment just made")
        send artifact to outlet PortfolioContext.ToLegalDocumentService.ToLegalDocumentServiceOut
      }
      on boardMemberAppointed: event PortfolioCompany.BoardMemberAppointed is {
        let askAnswer: type LegalDocumentService.DocumentList = ask query LegalDocumentService.GetDocuments of context LegalDocumentService
        do "an appointment needing the constitutional papers it is made under"
      }
      on other is {
        error "Unexpected message for adaptor ToLegalDocumentService"
      }
    } with {
      briefly "to legal document service"
      described as {
        |Carries messages to the external LegalDocumentService.
      }
    }
  } with {
    briefly "LegalDocumentService integration"
    described as {
      |The model's side of the LegalDocumentService conversation.
    }
  }
  adaptor ToMarketDataService to context MarketDataService as merge is { 
    inlet ToMarketDataServiceIn is type PortfolioCompanyEvent    inlet ToMarketDataServiceReplies is type MarketDataService.MarketDataServiceReply    outlet ToMarketDataServiceOut is type MarketDataService.MarketDataServiceRequest
    handler ToMarketDataServiceHandler is {
      on valuationUpdated: event PortfolioCompany.ValuationUpdated is {
        let askAnswer: type MarketDataService.ComparableSet = ask query MarketDataService.GetComparableValuations of context MarketDataService
        do "an updated valuation needing comparable companies to stand on"
      }
      on investmentExited: event PortfolioCompany.InvestmentExited is {
        let askAnswer: type MarketDataService.PrecedentTransaction = ask query MarketDataService.GetPrecedentTransactions of context MarketDataService
        do "an exit needing precedent deals to judge the price against"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketDataService"
      }
    } with {
      briefly "to market data service"
      described as {
        |Carries messages to the external MarketDataService.
      }
    }
  } with {
    briefly "MarketDataService integration"
    described as {
      |The model's side of the MarketDataService conversation.
    }
  }
  include "types.riddl"
  include "PortfolioCompany.riddl"
  // Repository for portfolio company persistence
  type PortfolioRepositoryCommand is one of {
    PortfolioContext.PortfolioRepository.PersistBoardMemberAppointed or PortfolioContext.PortfolioRepository.PersistBoardMemberRemoved or PortfolioContext.PortfolioRepository.PersistCompanyAcquired or PortfolioContext.PortfolioRepository.PersistCompanyInfoUpdated or PortfolioContext.PortfolioRepository.PersistFinancialsRecorded or PortfolioContext.PortfolioRepository.PersistFollowOnMade or PortfolioContext.PortfolioRepository.PersistInvestmentExited or PortfolioContext.PortfolioRepository.PersistInvestmentWrittenOff or PortfolioContext.PortfolioRepository.PersistValuationUpdated
  } with {
    briefly "Anything that writes PortfolioRepository"
    described as {
      |The persistence commands PortfolioRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository PortfolioRepository as flow is {
    inlet PortfolioRepositoryFromPortfolioAnalytics is type PortfolioRepositoryCommand    command PersistBoardMemberAppointed is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row BoardMemberAppointed applies to.
        }
      }
    } with {
      briefly "Persist BoardMemberAppointed"
      described as {
        |Instructs this repository to apply BoardMemberAppointed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBoardMemberRemoved is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row BoardMemberRemoved applies to.
        }
      }
    } with {
      briefly "Persist BoardMemberRemoved"
      described as {
        |Instructs this repository to apply BoardMemberRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCompanyInfoUpdated is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row CompanyInfoUpdated applies to.
        }
      }
    } with {
      briefly "Persist CompanyInfoUpdated"
      described as {
        |Instructs this repository to apply CompanyInfoUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInvestmentWrittenOff is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row InvestmentWrittenOff applies to.
        }
      }
    } with {
      briefly "Persist InvestmentWrittenOff"
      described as {
        |Instructs this repository to apply InvestmentWrittenOff to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCompanyAcquired is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row CompanyAcquired applies to.
        }
      }
    } with {
      briefly "Persist CompanyAcquired"
      described as {
        |Instructs this repository to apply CompanyAcquired to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFinancialsRecorded is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row FinancialsRecorded applies to.
        }
      }
    } with {
      briefly "Persist FinancialsRecorded"
      described as {
        |Instructs this repository to apply FinancialsRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFollowOnMade is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row FollowOnMade applies to.
        }
      }
    } with {
      briefly "Persist FollowOnMade"
      described as {
        |Instructs this repository to apply FollowOnMade to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInvestmentExited is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row InvestmentExited applies to.
        }
      }
    } with {
      briefly "Persist InvestmentExited"
      described as {
        |Instructs this repository to apply InvestmentExited to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistValuationUpdated is {
      companyId: PortfolioCompanyId with {
        briefly "Row addressed"
        described as {
          |Which stored row ValuationUpdated applies to.
        }
      }
    } with {
      briefly "Persist ValuationUpdated"
      described as {
        |Instructs this repository to apply ValuationUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet PortfolioRepositoryResponses is result PortfolioCompany.PortfolioCompanyResult
    record StoredPortfolioCompany is {
      portfolioCompanyId: PortfolioCompanyId with {
        briefly "portfolioCompanyId"
        described as {
          |The portfolioCompanyId column of the stored portfolioCompany row.
        }
      }
      companyId: PortfolioCompanyId with {
        briefly "companyId"
        described as {
          |The companyId column of the stored portfolioCompany row.
        }
      }
      investment: InvestmentInfo with {
        briefly "investment"
        described as {
          |The investment column of the stored portfolioCompany row.
        }
      }
      status: PortfolioStatus with {
        briefly "status"
        described as {
          |The status column of the stored portfolioCompany row.
        }
      }
    } with {
      briefly "Stored portfolioCompany row"
      described as {
        |The persistence shape of portfolioCompany data as this repository stores it.
      }
    }
    schema PortfolioData is relational
      of portfolioCompanies as record StoredPortfolioCompany
        index on field StoredPortfolioCompany.companyId
        index on field StoredPortfolioCompany.investment.fundId
        index on field StoredPortfolioCompany.status
 with {
      briefly "Portfolio data schema"
      described as {
        |The relational schema holding portfolio data for the PortfolioRepository.
      }
    }
    handler PortfolioPersistence is {
      on persistBoardMemberAppointed: command PersistBoardMemberAppointed is {
        do "apply BoardMemberAppointed to the stored row"
      }
      on persistBoardMemberRemoved: command PersistBoardMemberRemoved is {
        do "apply BoardMemberRemoved to the stored row"
      }
      on persistCompanyInfoUpdated: command PersistCompanyInfoUpdated is {
        do "apply CompanyInfoUpdated to the stored row"
      }
      on persistInvestmentWrittenOff: command PersistInvestmentWrittenOff is {
        do "apply InvestmentWrittenOff to the stored row"
      }
      on persistCompanyAcquired: command PersistCompanyAcquired is {
        do "apply CompanyAcquired to the stored row"
      }
      on persistFinancialsRecorded: command PersistFinancialsRecorded is {
        do "apply FinancialsRecorded to the stored row"
      }
      on persistFollowOnMade: command PersistFollowOnMade is {
        do "apply FollowOnMade to the stored row"
      }
      on persistInvestmentExited: command PersistInvestmentExited is {
        do "apply InvestmentExited to the stored row"
      }
      on persistValuationUpdated: command PersistValuationUpdated is {
        do "apply ValuationUpdated to the stored row"
      }
      on query GetPortfolioSummary is {
        let portfolioSummaryView: type PortfolioSummaryView = prompt("read the portfolio summary projection")
        reply portfolioSummaryView
      }
      on query GetFundPerformance is {
        let fundPerformanceView: type FundPerformanceView = prompt("read the fund performance projection")
        reply fundPerformanceView
      }
      on query GetCompanyPerformance is {
        let companyPerformanceView: type CompanyPerformanceView = prompt("read the company performance projection")
        reply companyPerformanceView
      }
    } with {
      briefly "Persists portfolio company events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Portfolio data persistence"
    described as {
      | The PortfolioRepository provides persistent storage for
      | portfolio companies, valuations, and financial data.
    }
  }
  // Projector for portfolio analytics
  query GetPortfolioSummary replies result PortfolioSummaryView is {
    portfolioSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which portfolio summary to retrieve.
      }
    }
  } with {
    briefly "Get portfolio summary"
    described as {
      |Retrieves the portfolio summary projection.
    }
  }
  result PortfolioSummaryView is {
    portfolioSummary: PortfolioAnalytics.PortfolioSummary with {
      briefly "Portfolio summary"
      described as {
        |The portfolio summary being returned.
      }
    }
  } with {
    briefly "Portfolio summary view"
    described as {
      |Read model view carrying the portfolio summary projection.
    }
  }
  query GetFundPerformance replies result FundPerformanceView is {
    fundPerformanceKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which fund performance to retrieve.
      }
    }
  } with {
    briefly "Get fund performance"
    described as {
      |Retrieves the fund performance projection.
    }
  }
  result FundPerformanceView is {
    fundPerformance: PortfolioAnalytics.FundPerformance with {
      briefly "Fund performance"
      described as {
        |The fund performance being returned.
      }
    }
  } with {
    briefly "Fund performance view"
    described as {
      |Read model view carrying the fund performance projection.
    }
  }
  query GetCompanyPerformance replies result CompanyPerformanceView is {
    companyPerformanceKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which company performance to retrieve.
      }
    }
  } with {
    briefly "Get company performance"
    described as {
      |Retrieves the company performance projection.
    }
  }
  result CompanyPerformanceView is {
    companyPerformance: PortfolioAnalytics.CompanyPerformance with {
      briefly "Company performance"
      described as {
        |The company performance being returned.
      }
    }
  } with {
    briefly "Company performance view"
    described as {
      |Read model view carrying the company performance projection.
    }
  }
  projector PortfolioAnalytics as flow is {
    updates repository PortfolioContext.PortfolioRepository
    outlet PortfolioAnalyticsToRepository is type PortfolioRepositoryCommand
    inlet PortfolioAnalyticsFromPortfolioCompany is type PortfolioCompanyEvent    record PortfolioSummary is {
      totalCompanies: Natural with {
        briefly "Companies"
        described as {
          |Total portfolio companies.
        }
      }
      activeCompanies: Natural with {
        briefly "Active"
        described as {
          |Active companies.
        }
      }
      totalInvested: MonetaryAmount with {
        briefly "Invested"
        described as {
          |Total capital invested.
        }
      }
      currentValue: MonetaryAmount with {
        briefly "Value"
        described as {
          |Current portfolio value.
        }
      }
      unrealizedGain: MonetaryAmount with {
        briefly "Unrealized"
        described as {
          |Unrealized gain/loss.
        }
      }
      grossMOIC: Decimal(6,2) with {
        briefly "MOIC"
        described as {
          |Gross multiple on invested capital.
        }
      }
    } with {
      briefly "Portfolio summary"
      described as {
        |Aggregate portfolio metrics.
      }
    }
    record FundPerformance is {
      fundId: FundId with {
        briefly "Fund"
        described as {
          |Fund identifier.
        }
      }
      investedCapital: MonetaryAmount with {
        briefly "Invested"
        described as {
          |Capital invested.
        }
      }
      realizedValue: MonetaryAmount with {
        briefly "Realized"
        described as {
          |Realized proceeds.
        }
      }
      unrealizedValue: MonetaryAmount with {
        briefly "Unrealized"
        described as {
          |Unrealized value.
        }
      }
      totalValue: MonetaryAmount with {
        briefly "Total"
        described as {
          |Total value.
        }
      }
      grossMOIC: Decimal(6,2) with {
        briefly "MOIC"
        described as {
          |Gross multiple.
        }
      }
      netIRR: Decimal(6,2) with {
        briefly "IRR"
        described as {
          |Net IRR.
        }
      }
    } with {
      briefly "Fund performance"
      described as {
        |Fund-level performance metrics.
      }
    }
    record CompanyPerformance is {
      companyId: PortfolioCompanyId with {
        briefly "Company"
        described as {
          |Company ID.
        }
      }
      companyName: String(1,200) with {
        briefly "Name"
        described as {
          |Company name.
        }
      }
      invested: MonetaryAmount with {
        briefly "Invested"
        described as {
          |Capital invested.
        }
      }
      currentValue: MonetaryAmount with {
        briefly "Value"
        described as {
          |Current value.
        }
      }
      moic: Decimal(6,2) with {
        briefly "MOIC"
        described as {
          |Return multiple.
        }
      }
      holdingPeriod: Natural with {
        briefly "Holding"
        described as {
          |Holding period in months.
        }
      }
      lastRevenueGrowth: Decimal(6,2) with {
        briefly "Growth"
        described as {
          |Last revenue growth.
        }
      }
    } with {
      briefly "Company performance"
      described as {
        |Individual company performance.
      }
    }
    handler AnalyticsHandler is {
      on boardMemberAppointed: event PortfolioCompany.BoardMemberAppointed is {
        tell command PortfolioContext.PortfolioRepository.PersistBoardMemberAppointed(companyId = boardMemberAppointed.companyId) to repository PortfolioContext.PortfolioRepository
        do "apply BoardMemberAppointed to the PortfolioAnalytics projection"
      }
      on boardMemberRemoved: event PortfolioCompany.BoardMemberRemoved is {
        tell command PortfolioContext.PortfolioRepository.PersistBoardMemberRemoved(companyId = boardMemberRemoved.companyId) to repository PortfolioContext.PortfolioRepository
        do "apply BoardMemberRemoved to the PortfolioAnalytics projection"
      }
      on companyInfoUpdated: event PortfolioCompany.CompanyInfoUpdated is {
        tell command PortfolioContext.PortfolioRepository.PersistCompanyInfoUpdated(companyId = companyInfoUpdated.companyId) to repository PortfolioContext.PortfolioRepository
        do "apply CompanyInfoUpdated to the PortfolioAnalytics projection"
      }
      on investmentWrittenOff: event PortfolioCompany.InvestmentWrittenOff is {
        tell command PortfolioContext.PortfolioRepository.PersistInvestmentWrittenOff(companyId = investmentWrittenOff.companyId) to repository PortfolioContext.PortfolioRepository
        do "apply InvestmentWrittenOff to the PortfolioAnalytics projection"
      }
      on companyAcquired: event PortfolioCompany.CompanyAcquired is {
        tell command PortfolioContext.PortfolioRepository.PersistCompanyAcquired(companyId = companyAcquired.companyId) to repository PortfolioContext.PortfolioRepository
      }
      on valuationUpdated: event PortfolioCompany.ValuationUpdated is {
        tell command PortfolioContext.PortfolioRepository.PersistValuationUpdated(companyId = valuationUpdated.companyId) to repository PortfolioContext.PortfolioRepository
      }
      on followOnMade: event PortfolioCompany.FollowOnMade is {
        tell command PortfolioContext.PortfolioRepository.PersistFollowOnMade(companyId = followOnMade.companyId) to repository PortfolioContext.PortfolioRepository
      }
      on investmentExited: event PortfolioCompany.InvestmentExited is {
        tell command PortfolioContext.PortfolioRepository.PersistInvestmentExited(companyId = investmentExited.companyId) to repository PortfolioContext.PortfolioRepository
      }
      on financialsRecorded: event PortfolioCompany.FinancialsRecorded is {
        tell command PortfolioContext.PortfolioRepository.PersistFinancialsRecorded(companyId = financialsRecorded.companyId) to repository PortfolioContext.PortfolioRepository
      }
    } with {
      briefly "Maintains portfolio analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Portfolio analytics projections"
    described as {
      |Maintains portfolio performance analytics.
    }
  }
  streamlet PortfolioCompanyEventSplit as split is {
    outlet PortfolioCompanyEventSplitToToMarketDataService is type PortfolioCompanyEvent
    outlet PortfolioCompanyEventSplitToToLegalDocumentService is type PortfolioCompanyEvent
    outlet PortfolioCompanyEventSplitToToInvestorRelationsService is type PortfolioCompanyEvent
    outlet PortfolioCompanyEventSplitToToFundAdministrationService is type PortfolioCompanyEvent
    inlet PortfolioCompanyEventSplitIn is type PortfolioCompanyEvent    outlet PortfolioCompanyEventSplitToPortfolioAnalytics is type PortfolioCompanyEvent
    handler PortfolioCompanyEventSplitHandler is {
      on companyAcquired: event PortfolioCompany.CompanyAcquired is {
        send companyAcquired to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        send companyAcquired to outlet PortfolioCompanyEventSplitToToLegalDocumentService
        send companyAcquired to outlet PortfolioCompanyEventSplitToToFundAdministrationService
        tell companyAcquired to entity PortfolioContext.PortfolioCompany
      }
      on companyInfoUpdated: event PortfolioCompany.CompanyInfoUpdated is {
        send companyInfoUpdated to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        tell companyInfoUpdated to entity PortfolioContext.PortfolioCompany
      }
      on financialsRecorded: event PortfolioCompany.FinancialsRecorded is {
        send financialsRecorded to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        send financialsRecorded to outlet PortfolioCompanyEventSplitToToInvestorRelationsService
        tell financialsRecorded to entity PortfolioContext.PortfolioCompany
      }
      on valuationUpdated: event PortfolioCompany.ValuationUpdated is {
        send valuationUpdated to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        send valuationUpdated to outlet PortfolioCompanyEventSplitToToMarketDataService
        send valuationUpdated to outlet PortfolioCompanyEventSplitToToInvestorRelationsService
        tell valuationUpdated to entity PortfolioContext.PortfolioCompany
      }
      on followOnMade: event PortfolioCompany.FollowOnMade is {
        send followOnMade to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        send followOnMade to outlet PortfolioCompanyEventSplitToToFundAdministrationService
        tell followOnMade to entity PortfolioContext.PortfolioCompany
      }
      on boardMemberAppointed: event PortfolioCompany.BoardMemberAppointed is {
        send boardMemberAppointed to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        send boardMemberAppointed to outlet PortfolioCompanyEventSplitToToLegalDocumentService
        tell boardMemberAppointed to entity PortfolioContext.PortfolioCompany
      }
      on boardMemberRemoved: event PortfolioCompany.BoardMemberRemoved is {
        send boardMemberRemoved to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        tell boardMemberRemoved to entity PortfolioContext.PortfolioCompany
      }
      on investmentExited: event PortfolioCompany.InvestmentExited is {
        send investmentExited to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        send investmentExited to outlet PortfolioCompanyEventSplitToToMarketDataService
        send investmentExited to outlet PortfolioCompanyEventSplitToToFundAdministrationService
        tell investmentExited to entity PortfolioContext.PortfolioCompany
      }
      on investmentWrittenOff: event PortfolioCompany.InvestmentWrittenOff is {
        send investmentWrittenOff to outlet PortfolioCompanyEventSplitToPortfolioAnalytics
        tell investmentWrittenOff to entity PortfolioContext.PortfolioCompany
      }
      on other is {
        error "Unexpected message for processor PortfolioCompanyEventSplit"
      }
    } with {
      briefly "PortfolioCompany event fan-out handler"
      described as {
        |Delivers each PortfolioCompany event to all of its consumers.
      }
    }
  } with {
    briefly "PortfolioCompany event fan-out"
    described as {
      |Fans PortfolioCompany events out to the repository and projectors.
    }
  }
  connector 'ToMarketDataService Feed' is from outlet PortfolioContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitToToMarketDataService to inlet PortfolioContext.ToMarketDataService.ToMarketDataServiceIn with {
    briefly "The PortfolioCompany events ToMarketDataService translates, on their way to it"
  }
  connector 'ToLegalDocumentService Feed' is from outlet PortfolioContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitToToLegalDocumentService to inlet PortfolioContext.ToLegalDocumentService.ToLegalDocumentServiceIn with {
    briefly "The PortfolioCompany events ToLegalDocumentService translates, on their way to it"
  }
  connector 'ToInvestorRelationsService Feed' is from outlet PortfolioContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitToToInvestorRelationsService to inlet PortfolioContext.ToInvestorRelationsService.ToInvestorRelationsServiceIn with {
    briefly "The PortfolioCompany events ToInvestorRelationsService translates, on their way to it"
  }
  connector 'ToFundAdministrationService Feed' is from outlet PortfolioContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitToToFundAdministrationService to inlet PortfolioContext.ToFundAdministrationService.ToFundAdministrationServiceIn with {
    briefly "The PortfolioCompany events ToFundAdministrationService translates, on their way to it"
  }
  connector 'PortfolioCompanyEvent Stream' is from outlet PortfolioContext.PortfolioCompany.PortfolioCompanyEvents2 to inlet PortfolioContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitIn with {
    briefly "PortfolioCompany events, fanned out to storage and read models"
  }
  connector 'PortfolioAnalytics Feed' is from outlet PortfolioContext.PortfolioCompanyEventSplit.PortfolioCompanyEventSplitToPortfolioAnalytics to inlet PortfolioContext.PortfolioAnalytics.PortfolioAnalyticsFromPortfolioCompany with {
    briefly "PortfolioCompany events feeding the PortfolioAnalytics projection"
  }
  connector 'PortfolioAnalytics Storage' is from outlet PortfolioContext.PortfolioAnalytics.PortfolioAnalyticsToRepository to inlet PortfolioContext.PortfolioRepository.PortfolioRepositoryFromPortfolioAnalytics with {
    briefly "PortfolioAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for portfolio management"
  described as {
    | The PortfolioContext is the bounded context for
    | private equity portfolio company management.
  }
}
