// Portfolio Management Domain Model
// Private equity portfolio company management
domain PortfolioManagement is {
  persistent connector 'MarketDataServiceReply Stream' is from outlet MarketDataService.MarketDataServiceRepliesOut to inlet PortfolioContext.ToMarketDataService.ToMarketDataServiceReplies with {
    briefly "What MarketDataService answers PortfolioContext"
  }
  persistent connector 'LegalDocumentServiceReply Stream' is from outlet LegalDocumentService.LegalDocumentServiceRepliesOut to inlet PortfolioContext.ToLegalDocumentService.ToLegalDocumentServiceReplies with {
    briefly "What LegalDocumentService answers PortfolioContext"
  }
  persistent connector 'FundAdministrationServiceReply Stream' is from outlet FundAdministrationService.FundAdministrationServiceRepliesOut to inlet PortfolioContext.ToFundAdministrationService.ToFundAdministrationServiceReplies with {
    briefly "What FundAdministrationService answers PortfolioContext"
  }
  persistent connector 'FundAdministrationServiceEvent Stream' is from outlet FundAdministrationService.FundAdministrationServiceEventsOut to inlet PortfolioContext.FromFundAdministrationService.FromFundAdministrationServiceIn with {
    briefly "What FundAdministrationService tells PortfolioContext, unasked"
  }
  persistent connector 'InvestorRelationsServiceEvent Stream' is from outlet InvestorRelationsService.InvestorRelationsServiceEventsOut to inlet PortfolioContext.FromInvestorRelationsService.FromInvestorRelationsServiceIn with {
    briefly "What InvestorRelationsService tells PortfolioContext, unasked"
  }
  persistent connector 'LegalDocumentServiceEvent Stream' is from outlet LegalDocumentService.LegalDocumentServiceEventsOut to inlet PortfolioContext.FromLegalDocumentService.FromLegalDocumentServiceIn with {
    briefly "What LegalDocumentService tells PortfolioContext, unasked"
  }
  persistent connector 'MarketDataServiceRequest Stream' is from outlet PortfolioContext.ToMarketDataService.ToMarketDataServiceOut to inlet MarketDataService.MarketDataServiceRequests with {
    briefly "What PortfolioContext asks MarketDataService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user InvestmentPartner is "person managing portfolio investments" with {
    briefly "Investment Partner"
    described as {
      |Senior partner overseeing portfolio companies.
    }
  }
  user PortfolioManager is "person managing day-to-day portfolio operations" with {
    briefly "Portfolio Manager"
    described as {
      |Manager tracking portfolio company performance.
    }
  }
  user FinanceAnalyst is "person analyzing portfolio financials" with {
    briefly "Finance Analyst"
    described as {
      |Analyst preparing valuations and reports.
    }
  }
  epic PortfolioLifecycle is {
    user InvestmentPartner wants to "to manage portfolio company investments" so that "fund returns are maximized"
    case AcquireCompanyUseCase is {
      user InvestmentPartner wants to "to add a new portfolio company" so that "capital is deployed according to strategy"
      step is "Partner completes" "deal closing" "and documentation" with {
        briefly "Close deal"
        described as {
          |Complete acquisition.
        }
      }
      step is "System creates" "portfolio company record" "with investment details" with {
        briefly "Create record"
        described as {
          |Initialize portfolio company.
        }
      }
    } with {
      briefly "Acquire portfolio company"
      described as {
        |Adding new company to portfolio.
      }
    }
    case MonitorPerformance is {
      user PortfolioManager wants to "to track portfolio company performance" so that "issues are identified early"
      step is "Manager reviews" "financial reports" "and KPIs" with {
        briefly "Review financials"
        described as {
          |Analyze performance.
        }
      }
      step is "System updates" "valuation metrics" "based on performance" with {
        briefly "Update valuation"
        described as {
          |Recalculate value.
        }
      }
    } with {
      briefly "Monitor company performance"
      described as {
        |Tracking portfolio company metrics.
      }
    }
    case ExitInvestmentUseCase is {
      user InvestmentPartner wants to "to exit a portfolio investment" so that "returns are realized for fund investors"
      step is "Partner evaluates" "exit options" "and timing" with {
        briefly "Evaluate exit"
        described as {
          |Assess exit strategy.
        }
      }
      step is "System records" "exit transaction" "and calculates returns" with {
        briefly "Record exit"
        described as {
          |Complete exit process.
        }
      }
    } with {
      briefly "Exit portfolio investment"
      described as {
        |Realizing investment returns through exit.
      }
    }
  } with {
    briefly "Portfolio investment lifecycle"
    described as {
      | Epic covering portfolio company acquisition,
      | monitoring, value creation, and exit.
    }
  }
  include "PortfolioContext.riddl"
  include "external-contexts.riddl"
  application context PortfolioManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PortfolioManagement are delivered.
      }
    }
    outlet AppPortfolioCompanyCommands is type PortfolioContext.PortfolioCompany.PortfolioCompanyCommand
    inlet AppPortfolioRepositoryResponses is result PortfolioContext.PortfolioCompany.PortfolioCompanyResult    handler PortfolioManagementAppHandler is {
      on other is {
        error "Unexpected message for application context PortfolioManagementApp"
      }
    } with {
      briefly "PortfolioManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PortfolioManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'InvestorRelationsServiceRequest Stream' is from outlet PortfolioContext.ToInvestorRelationsService.ToInvestorRelationsServiceOut to inlet InvestorRelationsService.InvestorRelationsServiceRequests with {
    briefly "What PortfolioContext asks InvestorRelationsService to send"
  }
  persistent connector 'FundAdministrationServiceRequest Stream' is from outlet PortfolioContext.ToFundAdministrationService.ToFundAdministrationServiceOut to inlet FundAdministrationService.FundAdministrationServiceRequests with {
    briefly "What PortfolioContext asks FundAdministrationService to send"
  }
  persistent connector 'LegalDocumentServiceRequest Stream' is from outlet PortfolioContext.ToLegalDocumentService.ToLegalDocumentServiceOut to inlet LegalDocumentService.LegalDocumentServiceRequests with {
    briefly "What PortfolioContext asks LegalDocumentService to send"
  }
  persistent connector 'PortfolioCompanyCommand Stream' is from outlet PortfolioManagementApp.AppPortfolioCompanyCommands to inlet PortfolioContext.PortfolioCompanyCommandStreaIn with {
    briefly "PortfolioCompany commands from the application"
  }
  persistent connector 'PortfolioCompanyResult Stream' is from outlet PortfolioContext.PortfolioCompanyResultStreamOut to inlet PortfolioManagementApp.AppPortfolioRepositoryResponses with {
    briefly "Portfolio query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PortfolioManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Portfolio management domain"
  described as {
    | The PortfolioManagement domain handles private equity
    | portfolio company investments and value creation.
  }
}
