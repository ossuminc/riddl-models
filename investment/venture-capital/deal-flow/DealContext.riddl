// Deal Flow - Deal Context
context DealContext is {
  adaptor FromCalendarService from context CalendarService is { 
    handler FromCalendarServiceHandler is {
      on event CalendarService.MeetingScheduled is {
        do "the model receives meeting scheduled"
      }
      on event CalendarService.ReminderSent is {
        do "the model receives reminder sent"
      }
      on other is {
        error "Unexpected message for adaptor FromCalendarService"
      }
    } with {
      briefly "from calendar service"
      described as {
        |Carries messages from the external CalendarService.
      }
    }
  } with {
    briefly "CalendarService integration"
    described as {
      |The model's side of the CalendarService conversation.
    }
  }
  adaptor ToCalendarService to context CalendarService is { 
    handler ToCalendarServiceHandler is {
      on command CalendarService.ScheduleMeeting is {
        do "the model sends schedule meeting"
      }
      on command CalendarService.SendMeetingReminder is {
        do "the model sends send meeting reminder"
      }
      on other is {
        error "Unexpected message for adaptor ToCalendarService"
      }
    } with {
      briefly "to calendar service"
      described as {
        |Carries messages to the external CalendarService.
      }
    }
  } with {
    briefly "CalendarService integration"
    described as {
      |The model's side of the CalendarService conversation.
    }
  }
  adaptor FromCompanyResearchService from context CompanyResearchService is { 
    handler FromCompanyResearchServiceHandler is {
      on result CompanyResearchService.CompanyResearch is {
        do "the model receives company research"
      }
      on result CompanyResearchService.FounderBackground is {
        do "the model receives founder background"
      }
      on other is {
        error "Unexpected message for adaptor FromCompanyResearchService"
      }
    } with {
      briefly "from company research service"
      described as {
        |Carries messages from the external CompanyResearchService.
      }
    }
  } with {
    briefly "CompanyResearchService integration"
    described as {
      |The model's side of the CompanyResearchService conversation.
    }
  }
  adaptor ToCompanyResearchService to context CompanyResearchService is { 
    handler ToCompanyResearchServiceHandler is {
      on query CompanyResearchService.GetCompanyInfo is {
        do "the model sends get company info"
      }
      on query CompanyResearchService.GetFounderBackground is {
        do "the model sends get founder background"
      }
      on other is {
        error "Unexpected message for adaptor ToCompanyResearchService"
      }
    } with {
      briefly "to company research service"
      described as {
        |Carries messages to the external CompanyResearchService.
      }
    }
  } with {
    briefly "CompanyResearchService integration"
    described as {
      |The model's side of the CompanyResearchService conversation.
    }
  }
  adaptor FromCrmIntegrationService from context CrmIntegrationService is { 
    handler FromCrmIntegrationServiceHandler is {
      on event CrmIntegrationService.ContactSynced is {
        do "the model receives contact synced"
      }
      on event CrmIntegrationService.InteractionLogged is {
        do "the model receives interaction logged"
      }
      on other is {
        error "Unexpected message for adaptor FromCrmIntegrationService"
      }
    } with {
      briefly "from crm integration service"
      described as {
        |Carries messages from the external CrmIntegrationService.
      }
    }
  } with {
    briefly "CrmIntegrationService integration"
    described as {
      |The model's side of the CrmIntegrationService conversation.
    }
  }
  adaptor ToCrmIntegrationService to context CrmIntegrationService is { 
    handler ToCrmIntegrationServiceHandler is {
      on command CrmIntegrationService.LogInteraction is {
        do "the model sends log interaction"
      }
      on command CrmIntegrationService.SyncContact is {
        do "the model sends sync contact"
      }
      on other is {
        error "Unexpected message for adaptor ToCrmIntegrationService"
      }
    } with {
      briefly "to crm integration service"
      described as {
        |Carries messages to the external CrmIntegrationService.
      }
    }
  } with {
    briefly "CrmIntegrationService integration"
    described as {
      |The model's side of the CrmIntegrationService conversation.
    }
  }
  adaptor FromDocumentManagementService from context DocumentManagementService is { 
    handler FromDocumentManagementServiceHandler is {
      on result DocumentManagementService.DealDocuments is {
        do "the model receives deal documents"
      }
      on event DocumentManagementService.DocumentUploaded is {
        do "the model receives document uploaded"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentManagementService"
      }
    } with {
      briefly "from document management service"
      described as {
        |Carries messages from the external DocumentManagementService.
      }
    }
  } with {
    briefly "DocumentManagementService integration"
    described as {
      |The model's side of the DocumentManagementService conversation.
    }
  }
  adaptor ToDocumentManagementService to context DocumentManagementService is { 
    handler ToDocumentManagementServiceHandler is {
      on query DocumentManagementService.GetDealDocuments is {
        do "the model sends get deal documents"
      }
      on command DocumentManagementService.UploadDocument is {
        do "the model sends upload document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentManagementService"
      }
    } with {
      briefly "to document management service"
      described as {
        |Carries messages to the external DocumentManagementService.
      }
    }
  } with {
    briefly "DocumentManagementService integration"
    described as {
      |The model's side of the DocumentManagementService conversation.
    }
  }
  adaptor FromLegalDocumentService from context LegalDocumentService is { 
    handler FromLegalDocumentServiceHandler is {
      on event LegalDocumentService.DocumentSigned is {
        do "the model receives document signed"
      }
      on event LegalDocumentService.SignatureRequested is {
        do "the model receives signature requested"
      }
      on event LegalDocumentService.TermSheetGenerated is {
        do "the model receives term sheet generated"
      }
      on other is {
        error "Unexpected message for adaptor FromLegalDocumentService"
      }
    } with {
      briefly "from legal document service"
      described as {
        |Carries messages from the external LegalDocumentService.
      }
    }
  } with {
    briefly "LegalDocumentService integration"
    described as {
      |The model's side of the LegalDocumentService conversation.
    }
  }
  adaptor ToLegalDocumentService to context LegalDocumentService is { 
    handler ToLegalDocumentServiceHandler is {
      on command LegalDocumentService.GenerateTermSheet is {
        do "the model sends generate term sheet"
      }
      on command LegalDocumentService.RequestSignature is {
        do "the model sends request signature"
      }
      on other is {
        error "Unexpected message for adaptor ToLegalDocumentService"
      }
    } with {
      briefly "to legal document service"
      described as {
        |Carries messages to the external LegalDocumentService.
      }
    }
  } with {
    briefly "LegalDocumentService integration"
    described as {
      |The model's side of the LegalDocumentService conversation.
    }
  }
  adaptor FromMarketDataService from context MarketDataService is { 
    handler FromMarketDataServiceHandler is {
      on result MarketDataService.ComparableDeals is {
        do "the model receives comparable deals"
      }
      on result MarketDataService.SectorAnalysis is {
        do "the model receives sector analysis"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketDataService"
      }
    } with {
      briefly "from market data service"
      described as {
        |Carries messages from the external MarketDataService.
      }
    }
  } with {
    briefly "MarketDataService integration"
    described as {
      |The model's side of the MarketDataService conversation.
    }
  }
  adaptor ToMarketDataService to context MarketDataService is { 
    handler ToMarketDataServiceHandler is {
      on query MarketDataService.GetComparableDeals is {
        do "the model sends get comparable deals"
      }
      on query MarketDataService.GetSectorData is {
        do "the model sends get sector data"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketDataService"
      }
    } with {
      briefly "to market data service"
      described as {
        |Carries messages to the external MarketDataService.
      }
    }
  } with {
    briefly "MarketDataService integration"
    described as {
      |The model's side of the MarketDataService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.StageUpdateSent is {
        do "the model receives stage update sent"
      }
      on event NotificationService.TeamNotified is {
        do "the model receives team notified"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.NotifyTeam is {
        do "the model sends notify team"
      }
      on command NotificationService.SendStageUpdate is {
        do "the model sends send stage update"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "Deal.riddl"
  // Repository for deal persistence
  repository DealRepository as merge is {
    inlet DealRepositoryFromDeal is type DealEvent    inlet DealRepositoryFromDealFlowAnalytics is type DealEvent    outlet DealRepositoryResponses is type Deal.DealResult
    record StoredDeal is  {
      dealId: DealId with {
        briefly "dealId"
        described as {
          |The dealId column of the stored deal row.
        }
      }
      assignedTo: String(1,200) with {
        briefly "assignedTo"
        described as {
          |The assignedTo column of the stored deal row.
        }
      }
      company: CompanyInfo with {
        briefly "company"
        described as {
          |The company column of the stored deal row.
        }
      }
      stage: DealStage with {
        briefly "stage"
        described as {
          |The stage column of the stored deal row.
        }
      }
    } with {
      briefly "Stored deal row"
      described as {
        |The persistence shape of deal data as this repository stores it.
      }
    }
    schema DealData is relational
      of deals as type StoredDeal
        index on field StoredDeal.dealId
        index on field StoredDeal.company.companyId
        index on field StoredDeal.stage
        index on field StoredDeal.assignedTo
 with {
      briefly "Deal data schema"
      described as {
        |The relational schema holding deal data for the DealRepository.
      }
    }
    handler DealPersistence is {
      on query GetDealFlowStats is {
        let dealFlowStatsView: type DealFlowStatsView = prompt("read the deal flow stats projection")
        reply dealFlowStatsView
      }
      on createDeal: command Deal.CreateDeal is {
        tell event Deal.DealCreated(dealId = createDeal.dealId, company = createDeal.company, founders = createDeal.founders, round = createDeal.round, source = createDeal.source, assignedTo = createDeal.assignedTo) to entity DealContext.Deal
      }
      on updateMetrics: command Deal.UpdateMetrics is {
        tell event Deal.MetricsUpdated(dealId = updateMetrics.dealId, metrics = updateMetrics.metrics) to entity DealContext.Deal
      }
      on addNote: command Deal.AddNote is {
        tell event Deal.NoteAdded(dealId = addNote.dealId) to entity DealContext.Deal
      }
      on recordMeeting: command Deal.RecordMeeting is {
        tell event Deal.MeetingRecorded(dealId = recordMeeting.dealId, meeting = recordMeeting.meeting) to entity DealContext.Deal
      }
      on advanceStage: command Deal.AdvanceStage is {
        tell event Deal.StageAdvanced(dealId = advanceStage.dealId, newStage = advanceStage.newStage) to entity DealContext.Deal
      }
      on setPriority: command Deal.SetPriority is {
        tell event Deal.PrioritySet(dealId = setPriority.dealId, priority = setPriority.priority) to entity DealContext.Deal
      }
      on writeThesis: command Deal.WriteThesis is {
        tell event Deal.ThesisWritten(dealId = writeThesis.dealId, thesis = writeThesis.thesis) to entity DealContext.Deal
      }
      on proposeTerms: command Deal.ProposeTerms is {
        tell event Deal.TermsProposed(dealId = proposeTerms.dealId, terms = proposeTerms.terms) to entity DealContext.Deal
      }
      on issueTermSheet: command Deal.IssueTermSheet is {
        tell event Deal.TermSheetIssued(dealId = issueTermSheet.dealId, terms = issueTermSheet.terms, expirationDate = issueTermSheet.expirationDate) to entity DealContext.Deal
      }
      on recordTermSheetResponse: command Deal.RecordTermSheetResponse is {
        tell event Deal.TermSheetResponseReceived(dealId = recordTermSheetResponse.dealId, accepted = recordTermSheetResponse.accepted, feedback = recordTermSheetResponse.feedback) to entity DealContext.Deal
      }
      on closeDeal: command Deal.CloseDeal is {
        tell event Deal.DealClosed(dealId = closeDeal.dealId, finalTerms = closeDeal.finalTerms, closingDate = closeDeal.closingDate) to entity DealContext.Deal
      }
      on passOnDeal: command Deal.PassOnDeal is {
        tell event Deal.DealPassed(dealId = passOnDeal.dealId, reason = passOnDeal.reason, passedBy = passOnDeal.passedBy) to entity DealContext.Deal
      }
      on markWithdrawn: command Deal.MarkWithdrawn is {
        tell event Deal.DealWithdrawn(dealId = markWithdrawn.dealId, reason = markWithdrawn.reason) to entity DealContext.Deal
      }
    } with {
      briefly "Persists deal commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Deal data persistence"
    described as {
      | The DealRepository provides persistent storage for
      | deals and related data.
    }
  }
  // Projector for deal flow analytics
  query GetDealFlowStats is  {
    dealFlowStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which deal flow stats to retrieve.
      }
    }
  } with {
    briefly "Get deal flow stats"
    described as {
      |Retrieves the deal flow stats projection.
    }
  }
  result DealFlowStatsView is  {
    dealFlowStats: DealFlowAnalytics.DealFlowStats with {
      briefly "Deal flow stats"
      described as {
        |The deal flow stats being returned.
      }
    }
  } with {
    briefly "Deal flow stats view"
    described as {
      |Read model view carrying the deal flow stats projection.
    }
  }
  projector DealFlowAnalytics as flow is {
    updates repository DealContext.DealRepository
    inlet DealFlowAnalyticsFromDeal is type DealEvent    outlet DealFlowAnalyticsOut is type DealEvent
    record DealFlowStats is  {
      totalDeals: Natural with {
        briefly "Total"
        described as {
          |Total deals.
        }
      }
      activeDeals: Natural with {
        briefly "Active"
        described as {
          |Active deals.
        }
      }
      closedDeals: Natural with {
        briefly "Closed"
        described as {
          |Closed deals.
        }
      }
      passedDeals: Natural with {
        briefly "Passed"
        described as {
          |Passed deals.
        }
      }
      totalDeployed: Decimal(12,2) with {
        briefly "Deployed"
        described as {
          |Capital deployed.
        }
      }
      conversionRate: Decimal(5,2) with {
        briefly "Conversion"
        described as {
          |Conversion rate.
        }
      }
      avgTimeToClose: Natural with {
        briefly "Time to close"
        described as {
          |Average days to close.
        }
      }
    } with {
      briefly "Deal flow statistics"
      described as {
        |Deal pipeline metrics.
      }
    }
    handler AnalyticsHandler is {
      on dealCreated: event Deal.DealCreated is {
        tell dealCreated to repository DealContext.DealRepository
      }
      on stageAdvanced: event Deal.StageAdvanced is {
        tell stageAdvanced to repository DealContext.DealRepository
      }
      on dealClosed: event Deal.DealClosed is {
        tell dealClosed to repository DealContext.DealRepository
      }
      on dealPassed: event Deal.DealPassed is {
        tell dealPassed to repository DealContext.DealRepository
      }
    } with {
      briefly "Maintains deal flow analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Deal flow analytics projections"
    described as {
      |Maintains deal pipeline analytics data.
    }
  }
  processor DealEventSource as source is {
    outlet DealEvents is type DealEvent
    handler DealEventSourceHandler is {
      on init is {
        tell command Deal.InitializeDeal to entity DealContext.Deal
      }
      on other is {
        error "Unexpected message for source DealEventSource"
      }
      on dealCreated: event Deal.DealCreated is {
        send dealCreated to outlet DealEvents
      }
      on dealClosed: event Deal.DealClosed is {
        send dealClosed to outlet DealEvents
      }
      on dealPassed: event Deal.DealPassed is {
        send dealPassed to outlet DealEvents
      }
    } with {
      briefly "Deal source handler"
      described as {
        |Handles deal events and sends to outlet.
      }
    }
  } with {
    briefly "Deal event source"
    described as {
      |Publishes deal entity events.
    }
  }
  processor DealSink as sink is {
    inlet DealInlet is type DealEvent    handler DealSinkHandler is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink DealSink"
      }
      on dealCreated: event Deal.DealCreated is {
        tell dealCreated to repository DealContext.DealRepository
      }
      on dealClosed: event Deal.DealClosed is {
        tell dealClosed to repository DealContext.DealRepository
      }
    } with {
      briefly "Deal sink handler"
      described as {
        |Receives deal events and persists them.
      }
    }
  } with {
    briefly "Deal event sink"
    described as {
      |Receives deal events for persistence.
    }
  }
  connector DealEventPipeline is from outlet DealContext.DealEventSource.DealEvents to inlet DealContext.DealSink.DealInlet with {
    briefly "Deal event flow"
    described as {
      |Connects deal source to sink.
    }
  }
  processor DealEventSplit as split is {
    inlet DealEventSplitIn is type DealEvent    outlet DealEventSplitToDealRepository is type DealEvent
    outlet DealEventSplitToDealFlowAnalytics is type DealEvent
    handler DealEventSplitHandler is {
      on dealCreated: event Deal.DealCreated is {
        send dealCreated to outlet DealEventSplitToDealRepository
        send dealCreated to outlet DealEventSplitToDealFlowAnalytics
        tell dealCreated to entity DealContext.Deal
      }
      on metricsUpdated: event Deal.MetricsUpdated is {
        send metricsUpdated to outlet DealEventSplitToDealRepository
        send metricsUpdated to outlet DealEventSplitToDealFlowAnalytics
        tell metricsUpdated to entity DealContext.Deal
      }
      on noteAdded: event Deal.NoteAdded is {
        send noteAdded to outlet DealEventSplitToDealRepository
        send noteAdded to outlet DealEventSplitToDealFlowAnalytics
        tell noteAdded to entity DealContext.Deal
      }
      on meetingRecorded: event Deal.MeetingRecorded is {
        send meetingRecorded to outlet DealEventSplitToDealRepository
        send meetingRecorded to outlet DealEventSplitToDealFlowAnalytics
        tell meetingRecorded to entity DealContext.Deal
      }
      on stageAdvanced: event Deal.StageAdvanced is {
        send stageAdvanced to outlet DealEventSplitToDealRepository
        send stageAdvanced to outlet DealEventSplitToDealFlowAnalytics
        tell stageAdvanced to entity DealContext.Deal
      }
      on prioritySet: event Deal.PrioritySet is {
        send prioritySet to outlet DealEventSplitToDealRepository
        send prioritySet to outlet DealEventSplitToDealFlowAnalytics
        tell prioritySet to entity DealContext.Deal
      }
      on thesisWritten: event Deal.ThesisWritten is {
        send thesisWritten to outlet DealEventSplitToDealRepository
        send thesisWritten to outlet DealEventSplitToDealFlowAnalytics
        tell thesisWritten to entity DealContext.Deal
      }
      on termsProposed: event Deal.TermsProposed is {
        send termsProposed to outlet DealEventSplitToDealRepository
        send termsProposed to outlet DealEventSplitToDealFlowAnalytics
        tell termsProposed to entity DealContext.Deal
      }
      on termSheetIssued: event Deal.TermSheetIssued is {
        send termSheetIssued to outlet DealEventSplitToDealRepository
        send termSheetIssued to outlet DealEventSplitToDealFlowAnalytics
        tell termSheetIssued to entity DealContext.Deal
      }
      on termSheetResponseReceived: event Deal.TermSheetResponseReceived is {
        send termSheetResponseReceived to outlet DealEventSplitToDealRepository
        send termSheetResponseReceived to outlet DealEventSplitToDealFlowAnalytics
        tell termSheetResponseReceived to entity DealContext.Deal
      }
      on dealClosed: event Deal.DealClosed is {
        send dealClosed to outlet DealEventSplitToDealRepository
        send dealClosed to outlet DealEventSplitToDealFlowAnalytics
        tell dealClosed to entity DealContext.Deal
      }
      on dealPassed: event Deal.DealPassed is {
        send dealPassed to outlet DealEventSplitToDealRepository
        send dealPassed to outlet DealEventSplitToDealFlowAnalytics
        tell dealPassed to entity DealContext.Deal
      }
      on dealWithdrawn: event Deal.DealWithdrawn is {
        send dealWithdrawn to outlet DealEventSplitToDealRepository
        send dealWithdrawn to outlet DealEventSplitToDealFlowAnalytics
        tell dealWithdrawn to entity DealContext.Deal
      }
      on other is {
        error "Unexpected message for processor DealEventSplit"
      }
    } with {
      briefly "Deal event fan-out handler"
      described as {
        |Delivers each Deal event to all of its consumers.
      }
    }
  } with {
    briefly "Deal event fan-out"
    described as {
      |Fans Deal events out to the repository and projectors.
    }
  }
  connector 'DealEvent Stream' is from outlet DealContext.Deal.DealEvents2 to inlet DealContext.DealEventSplit.DealEventSplitIn with {
    briefly "Deal events, fanned out to storage and read models"
  }
  connector 'DealEvent Storage' is from outlet DealContext.DealEventSplit.DealEventSplitToDealRepository to inlet DealContext.DealRepository.DealRepositoryFromDeal with {
    briefly "Deal events on their way to storage"
  }
  connector 'DealFlowAnalytics Feed' is from outlet DealContext.DealEventSplit.DealEventSplitToDealFlowAnalytics to inlet DealContext.DealFlowAnalytics.DealFlowAnalyticsFromDeal with {
    briefly "Deal events feeding the DealFlowAnalytics projection"
  }
  connector 'DealFlowAnalytics Storage' is from outlet DealContext.DealFlowAnalytics.DealFlowAnalyticsOut to inlet DealContext.DealRepository.DealRepositoryFromDealFlowAnalytics with {
    briefly "The DealFlowAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for deal flow"
  described as {
    | The DealContext is the bounded context for
    | venture capital deal sourcing and pipeline.
  }
}
