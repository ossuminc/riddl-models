// Deal Flow - Deal Context
context DealContext is {
  include "types.riddl"
  include "Deal.riddl"
  // Repository for deal persistence
  repository DealRepository is {
    inlet DealRepositoryFromDeal is type DealEvent
    inlet DealRepositoryFromDealFlowAnalytics is type DealEvent
    outlet DealRepositoryResponses is type Deal.DealResult
    schema DealData is relational
      of deals as type Deal
        index on field Deal.dealId
        index on field Deal.company.companyId
        index on field Deal.stage
        index on field Deal.assignedTo
      with {
      briefly "Deal data schema"
      described as {
        |The relational schema holding deal data for the DealRepository.
      }
    }

    handler DealPersistence is {
      on command Deal.CreateDeal is {
        tell event Deal.DealCreated to entity DealContext.Deal
      }
      on command Deal.UpdateMetrics is {
        tell event Deal.MetricsUpdated to entity DealContext.Deal
      }
      on command Deal.AddNote is {
        tell event Deal.NoteAdded to entity DealContext.Deal
      }
      on command Deal.RecordMeeting is {
        tell event Deal.MeetingRecorded to entity DealContext.Deal
      }
      on command Deal.AdvanceStage is {
        tell event Deal.StageAdvanced to entity DealContext.Deal
      }
      on command Deal.SetPriority is {
        tell event Deal.PrioritySet to entity DealContext.Deal
      }
      on command Deal.WriteThesis is {
        tell event Deal.ThesisWritten to entity DealContext.Deal
      }
      on command Deal.ProposeTerms is {
        tell event Deal.TermsProposed to entity DealContext.Deal
      }
      on command Deal.IssueTermSheet is {
        tell event Deal.TermSheetIssued to entity DealContext.Deal
      }
      on command Deal.RecordTermSheetResponse is {
        tell event Deal.TermSheetResponseReceived to entity DealContext.Deal
      }
      on command Deal.CloseDeal is {
        tell event Deal.DealClosed to entity DealContext.Deal
      }
      on command Deal.PassOnDeal is {
        tell event Deal.DealPassed to entity DealContext.Deal
      }
      on command Deal.MarkWithdrawn is {
        tell event Deal.DealWithdrawn to entity DealContext.Deal
      }
    } with {
      briefly "Persists deal commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Deal data persistence"
    described as {
      | The DealRepository provides persistent storage for
      | deals and related data.
    }
  }
  // Projector for deal flow analytics
  projector DealFlowAnalytics is {
    inlet DealFlowAnalyticsFromDeal is type DealEvent
    outlet DealFlowAnalyticsOut is type DealEvent
    updates repository DealContext.DealRepository
    record DealFlowStats is  {
      totalDeals: Natural with {
        briefly "Total"
        described as {
          |Total deals.
        }
      }
      activeDeals: Natural with {
        briefly "Active"
        described as {
          |Active deals.
        }
      }
      closedDeals: Natural with {
        briefly "Closed"
        described as {
          |Closed deals.
        }
      }
      passedDeals: Natural with {
        briefly "Passed"
        described as {
          |Passed deals.
        }
      }
      totalDeployed: Decimal(12,2) with {
        briefly "Deployed"
        described as {
          |Capital deployed.
        }
      }
      conversionRate: Decimal(5,2) with {
        briefly "Conversion"
        described as {
          |Conversion rate.
        }
      }
      avgTimeToClose: Natural with {
        briefly "Time to close"
        described as {
          |Average days to close.
        }
      }
    } with {
      briefly "Deal flow statistics"
      described as {
        |Deal pipeline metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Deal.DealCreated is {
        tell event Deal.DealCreated to repository DealContext.DealRepository
      }
      on event Deal.StageAdvanced is {
        tell event Deal.StageAdvanced to repository DealContext.DealRepository
      }
      on event Deal.DealClosed is {
        tell event Deal.DealClosed to repository DealContext.DealRepository
      }
      on event Deal.DealPassed is {
        tell event Deal.DealPassed to repository DealContext.DealRepository
      }
    } with {
      briefly "Maintains deal flow analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Deal flow analytics projections"
    described as {
      |Maintains deal pipeline analytics data.
    }
  }
  processor DealEventSource as source is {
    outlet DealEvents is type DealEvent
    handler DealEventSourceHandler is {
      on init is {
        tell command Deal.InitializeDeal to entity DealContext.Deal
      }
      on other is {
        error "Unexpected message for source DealEventSource"
      }
      on event Deal.DealCreated is {
        send event Deal.DealCreated to outlet DealEvents
      }
      on event Deal.DealClosed is {
        send event Deal.DealClosed to outlet DealEvents
      }
      on event Deal.DealPassed is {
        send event Deal.DealPassed to outlet DealEvents
      }
    } with {
      briefly "Deal source handler"
      described as {
        |Handles deal events and sends to outlet.
      }
    }
  } with {
    briefly "Deal event source"
    described as {
      |Publishes deal entity events.
    }
  }
  processor DealSink as sink is {
    inlet DealInlet is type DealEvent
    handler DealSinkHandler is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink DealSink"
      }
      on event Deal.DealCreated is {
        tell event Deal.DealCreated to repository DealContext.DealRepository
      }
      on event Deal.DealClosed is {
        tell event Deal.DealClosed to repository DealContext.DealRepository
      }
    } with {
      briefly "Deal sink handler"
      described as {
        |Receives deal events and persists them.
      }
    }
  } with {
    briefly "Deal event sink"
    described as {
      |Receives deal events for persistence.
    }
  }
  connector DealEventPipeline is {
    from outlet DealContext.DealEventSource.DealEvents to
      inlet DealContext.DealSink.DealInlet
  } with {
    briefly "Deal event flow"
    described as {
      |Connects deal source to sink.
    }
  }
  processor DealEventSplit is {
    inlet DealEventSplitIn is type DealEvent
    outlet DealEventSplitToDealRepository is type DealEvent
    outlet DealEventSplitToDealFlowAnalytics is type DealEvent
    handler DealEventSplitHandler is {
      on event Deal.DealCreated is {
        send event Deal.DealCreated to outlet DealEventSplitToDealRepository
        send event Deal.DealCreated to outlet DealEventSplitToDealFlowAnalytics
        tell event Deal.DealCreated to entity DealContext.Deal
      }
      on event Deal.MetricsUpdated is {
        send event Deal.MetricsUpdated to outlet DealEventSplitToDealRepository
        send event Deal.MetricsUpdated to outlet DealEventSplitToDealFlowAnalytics
        tell event Deal.MetricsUpdated to entity DealContext.Deal
      }
      on event Deal.NoteAdded is {
        send event Deal.NoteAdded to outlet DealEventSplitToDealRepository
        send event Deal.NoteAdded to outlet DealEventSplitToDealFlowAnalytics
        tell event Deal.NoteAdded to entity DealContext.Deal
      }
      on event Deal.MeetingRecorded is {
        send event Deal.MeetingRecorded to outlet DealEventSplitToDealRepository
        send event Deal.MeetingRecorded to outlet DealEventSplitToDealFlowAnalytics
        tell event Deal.MeetingRecorded to entity DealContext.Deal
      }
      on event Deal.StageAdvanced is {
        send event Deal.StageAdvanced to outlet DealEventSplitToDealRepository
        send event Deal.StageAdvanced to outlet DealEventSplitToDealFlowAnalytics
        tell event Deal.StageAdvanced to entity DealContext.Deal
      }
      on event Deal.PrioritySet is {
        send event Deal.PrioritySet to outlet DealEventSplitToDealRepository
        send event Deal.PrioritySet to outlet DealEventSplitToDealFlowAnalytics
        tell event Deal.PrioritySet to entity DealContext.Deal
      }
      on event Deal.ThesisWritten is {
        send event Deal.ThesisWritten to outlet DealEventSplitToDealRepository
        send event Deal.ThesisWritten to outlet DealEventSplitToDealFlowAnalytics
        tell event Deal.ThesisWritten to entity DealContext.Deal
      }
      on event Deal.TermsProposed is {
        send event Deal.TermsProposed to outlet DealEventSplitToDealRepository
        send event Deal.TermsProposed to outlet DealEventSplitToDealFlowAnalytics
        tell event Deal.TermsProposed to entity DealContext.Deal
      }
      on event Deal.TermSheetIssued is {
        send event Deal.TermSheetIssued to outlet DealEventSplitToDealRepository
        send event Deal.TermSheetIssued to outlet DealEventSplitToDealFlowAnalytics
        tell event Deal.TermSheetIssued to entity DealContext.Deal
      }
      on event Deal.TermSheetResponseReceived is {
        send event Deal.TermSheetResponseReceived to outlet DealEventSplitToDealRepository
        send event Deal.TermSheetResponseReceived to outlet DealEventSplitToDealFlowAnalytics
        tell event Deal.TermSheetResponseReceived to entity DealContext.Deal
      }
      on event Deal.DealClosed is {
        send event Deal.DealClosed to outlet DealEventSplitToDealRepository
        send event Deal.DealClosed to outlet DealEventSplitToDealFlowAnalytics
        tell event Deal.DealClosed to entity DealContext.Deal
      }
      on event Deal.DealPassed is {
        send event Deal.DealPassed to outlet DealEventSplitToDealRepository
        send event Deal.DealPassed to outlet DealEventSplitToDealFlowAnalytics
        tell event Deal.DealPassed to entity DealContext.Deal
      }
      on event Deal.DealWithdrawn is {
        send event Deal.DealWithdrawn to outlet DealEventSplitToDealRepository
        send event Deal.DealWithdrawn to outlet DealEventSplitToDealFlowAnalytics
        tell event Deal.DealWithdrawn to entity DealContext.Deal
      }
      on other is {
        error "Unexpected message for processor DealEventSplit"
      }
    } with {
      briefly "Deal event fan-out handler"
      described as {
        |Delivers each Deal event to all of its consumers.
      }
    }
  } with {
    briefly "Deal event fan-out"
    described as {
      |Fans Deal events out to the repository and projectors.
    }
  }
  connector LinkDealToDealEventSplit is {
    from outlet DealContext.Deal.DealEvents2 to
      inlet DealContext.DealEventSplit.DealEventSplitIn
  } with {
    briefly "LinkDealToDealEventSplit"
  }
  connector LinkDealEventSplitToDealRepository is {
    from outlet DealContext.DealEventSplit.DealEventSplitToDealRepository to
      inlet DealContext.DealRepository.DealRepositoryFromDeal
  } with {
    briefly "LinkDealEventSplitToDealRepository"
  }
  connector LinkDealEventSplitToDealFlowAnalytics is {
    from outlet DealContext.DealEventSplit.DealEventSplitToDealFlowAnalytics to
      inlet DealContext.DealFlowAnalytics.DealFlowAnalyticsFromDeal
  } with {
    briefly "LinkDealEventSplitToDealFlowAnalytics"
  }
  connector LinkDealFlowAnalyticsToDealRepository is {
    from outlet DealContext.DealFlowAnalytics.DealFlowAnalyticsOut to
      inlet DealContext.DealRepository.DealRepositoryFromDealFlowAnalytics
  } with {
    briefly "LinkDealFlowAnalyticsToDealRepository"
  }
} with {
  briefly "Bounded context for deal flow"
  described as {
    | The DealContext is the bounded context for
    | venture capital deal sourcing and pipeline.
  }
}
