      on event LegalDocumentService.DocumentSigned is {
        do "the model receives document signed"
      }
      on event LegalDocumentService.SignatureRequested is {
        do "the model receives signature requested"
      }
      on event LegalDocumentService.TermSheetGenerated is {
        do "the model receives term sheet generated"
      }
      on other is {
        error "Unexpected message for adaptor FromLegalDocumentService"
      }
    } with {
      briefly "from legal document service"
      described as {
        |Carries messages from the external LegalDocumentService.
      }
    }
  } with {
    briefly "LegalDocumentService integration"
    described as {
      |The model's side of the LegalDocumentService conversation.
    }
  }
  adaptor ToLegalDocumentService to context LegalDocumentService is { 
    handler ToLegalDocumentServiceHandler is {
      on command LegalDocumentService.GenerateTermSheet is {
        do "the model sends generate term sheet"
      }
      on command LegalDocumentService.RequestSignature is {
        do "the model sends request signature"
      }
      on other is {
        error "Unexpected message for adaptor ToLegalDocumentService"
      }
    } with {
      briefly "to legal document service"
      described as {
        |Carries messages to the external LegalDocumentService.
      }
    }
  } with {
    briefly "LegalDocumentService integration"
    described as {
      |The model's side of the LegalDocumentService conversation.
    }
  }
  adaptor FromMarketDataService from context MarketDataService is { 
    handler FromMarketDataServiceHandler is {
      on result MarketDataService.ComparableDeals is {
        do "the model receives comparable deals"
      }
      on result MarketDataService.SectorAnalysis is {
        do "the model receives sector analysis"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketDataService"
      }
    } with {
      briefly "from market data service"
      described as {
        |Carries messages from the external MarketDataService.
      }
    }
  } with {
    briefly "MarketDataService integration"
    described as {
      |The model's side of the MarketDataService conversation.
    }
  }
  adaptor ToMarketDataService to context MarketDataService is { 
    handler ToMarketDataServiceHandler is {
      on query MarketDataService.GetComparableDeals is {
        do "the model sends get comparable deals"
      }
      on query MarketDataService.GetSectorData is {
        do "the model sends get sector data"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketDataService"
      }
    } with {
      briefly "to market data service"
      described as {
        |Carries messages to the external MarketDataService.
      }
    }
  } with {
    briefly "MarketDataService integration"
    described as {
      |The model's side of the MarketDataService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.StageUpdateSent is {
        do "the model receives stage update sent"
      }
      on event NotificationService.TeamNotified is {
        do "the model receives team notified"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.NotifyTeam is {
        do "the model sends notify team"
      }
      on command NotificationService.SendStageUpdate is {
        do "the model sends send stage update"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "Deal.riddl"
  // Repository for deal persistence
  type DealRepositoryCommand is one of {
    DealContext.DealRepository.PersistDealClosed or DealContext.DealRepository.PersistDealCreated or DealContext.DealRepository.PersistDealPassed or DealContext.DealRepository.PersistDealWithdrawn or DealContext.DealRepository.PersistMeetingRecorded or DealContext.DealRepository.PersistMetricsUpdated or DealContext.DealRepository.PersistNoteAdded or DealContext.DealRepository.PersistPrioritySet or DealContext.DealRepository.PersistStageAdvanced or DealContext.DealRepository.PersistTermSheetIssued or DealContext.DealRepository.PersistTermSheetResponseReceived or DealContext.DealRepository.PersistTermsProposed or DealContext.DealRepository.PersistThesisWritten
  } with {
    briefly "Anything that writes DealRepository"
    described as {
      |The persistence commands DealRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository DealRepository as flow is {
    inlet DealRepositoryFromDealFlowAnalytics is type DealRepositoryCommand    command PersistDealWithdrawn is {
      dealId: DealId with {
        briefly "Row addressed"
        described as {
          |Which stored row DealWithdrawn applies to.
        }
      }
    } with {
      briefly "Persist DealWithdrawn"
      described as {
        |Instructs this repository to apply DealWithdrawn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMeetingRecorded is {
      dealId: DealId with {
        briefly "Row addressed"
        described as {
          |Which stored row MeetingRecorded applies to.
        }
      }
    } with {
      briefly "Persist MeetingRecorded"
      described as {
        |Instructs this repository to apply MeetingRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMetricsUpdated is {
      dealId: DealId with {
        briefly "Row addressed"
        described as {
          |Which stored row MetricsUpdated applies to.
        }
      }
    } with {
      briefly "Persist MetricsUpdated"
      described as {
        |Instructs this repository to apply MetricsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistNoteAdded is {
      dealId: DealId with {
        briefly "Row addressed"
        described as {
          |Which stored row NoteAdded applies to.
        }
      }
    } with {
      briefly "Persist NoteAdded"
      described as {
        |Instructs this repository to apply NoteAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPrioritySet is {
      dealId: DealId with {
        briefly "Row addressed"
        described as {
          |Which stored row PrioritySet applies to.
        }
      }
    } with {
      briefly "Persist PrioritySet"
      described as {
        |Instructs this repository to apply PrioritySet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTermSheetIssued is {
      dealId: DealId with {
        briefly "Row addressed"
        described as {
          |Which stored row TermSheetIssued applies to.
        }
      }
    } with {
      briefly "Persist TermSheetIssued"
      described as {
        |Instructs this repository to apply TermSheetIssued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTermSheetResponseReceived is {
      dealId: DealId with {
        briefly "Row addressed"
        described as {
          |Which stored row TermSheetResponseReceived applies to.
        }
      }
    } with {
      briefly "Persist TermSheetResponseReceived"
      described as {
        |Instructs this repository to apply TermSheetResponseReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTermsProposed is {
      dealId: DealId with {
        briefly "Row addressed"
        described as {
          |Which stored row TermsProposed applies to.
        }
      }
    } with {
      briefly "Persist TermsProposed"
      described as {
        |Instructs this repository to apply TermsProposed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistThesisWritten is {
      dealId: DealId with {
        briefly "Row addressed"
        described as {
          |Which stored row ThesisWritten applies to.
        }
      }
    } with {
      briefly "Persist ThesisWritten"
      described as {
        |Instructs this repository to apply ThesisWritten to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDealClosed is {
      dealId: DealId with {
        briefly "Row addressed"
        described as {
          |Which stored row DealClosed applies to.
        }
      }
    } with {
      briefly "Persist DealClosed"
      described as {
        |Instructs this repository to apply DealClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDealCreated is {
      dealId: DealId with {
        briefly "Row addressed"
        described as {
          |Which stored row DealCreated applies to.
        }
      }
    } with {
      briefly "Persist DealCreated"
      described as {
        |Instructs this repository to apply DealCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDealPassed is {
      dealId: DealId with {
        briefly "Row addressed"
        described as {
          |Which stored row DealPassed applies to.
        }
      }
    } with {
      briefly "Persist DealPassed"
      described as {
        |Instructs this repository to apply DealPassed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStageAdvanced is {
      dealId: DealId with {
        briefly "Row addressed"
        described as {
          |Which stored row StageAdvanced applies to.
        }
      }
    } with {
      briefly "Persist StageAdvanced"
      described as {
        |Instructs this repository to apply StageAdvanced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet DealRepositoryResponses is result Deal.DealResult
    record StoredDeal is {
      dealId: DealId with {
        briefly "dealId"
        described as {
          |The dealId column of the stored deal row.
        }
      }
      assignedTo: String(1,200) with {
        briefly "assignedTo"
        described as {
          |The assignedTo column of the stored deal row.
        }
      }
      company: CompanyInfo with {
        briefly "company"
        described as {
          |The company column of the stored deal row.
        }
      }
      stage: DealStage with {
        briefly "stage"
        described as {
          |The stage column of the stored deal row.
        }
      }
    } with {
      briefly "Stored deal row"
      described as {
        |The persistence shape of deal data as this repository stores it.
      }
    }
    schema DealData is relational
      of deals as record StoredDeal
        index on field StoredDeal.dealId
        index on field StoredDeal.company.companyId
        index on field StoredDeal.stage
        index on field StoredDeal.assignedTo
 with {
      briefly "Deal data schema"
      described as {
        |The relational schema holding deal data for the DealRepository.
      }
    }
    handler DealPersistence is {
      on persistDealWithdrawn: command PersistDealWithdrawn is {
        do "apply DealWithdrawn to the stored row"
      }
      on persistMeetingRecorded: command PersistMeetingRecorded is {
        do "apply MeetingRecorded to the stored row"
      }
      on persistMetricsUpdated: command PersistMetricsUpdated is {
        do "apply MetricsUpdated to the stored row"
      }
      on persistNoteAdded: command PersistNoteAdded is {
        do "apply NoteAdded to the stored row"
      }
      on persistPrioritySet: command PersistPrioritySet is {
        do "apply PrioritySet to the stored row"
      }
      on persistTermSheetIssued: command PersistTermSheetIssued is {
        do "apply TermSheetIssued to the stored row"
      }
      on persistTermSheetResponseReceived: command PersistTermSheetResponseReceived is {
        do "apply TermSheetResponseReceived to the stored row"
      }
      on persistTermsProposed: command PersistTermsProposed is {
        do "apply TermsProposed to the stored row"
      }
      on persistThesisWritten: command PersistThesisWritten is {
        do "apply ThesisWritten to the stored row"
      }
      on persistDealClosed: command PersistDealClosed is {
        do "apply DealClosed to the stored row"
      }
      on persistDealCreated: command PersistDealCreated is {
        do "apply DealCreated to the stored row"
      }
      on persistDealPassed: command PersistDealPassed is {
        do "apply DealPassed to the stored row"
      }
      on persistStageAdvanced: command PersistStageAdvanced is {
        do "apply StageAdvanced to the stored row"
      }
      on query GetDealFlowStats is {
        let dealFlowStatsView: type DealFlowStatsView = prompt("read the deal flow stats projection")
        reply dealFlowStatsView
      }
    } with {
      briefly "Persists deal commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Deal data persistence"
    described as {
      | The DealRepository provides persistent storage for
      | deals and related data.
    }
  }
  // Projector for deal flow analytics
  query GetDealFlowStats replies result DealFlowStatsView is {
    dealFlowStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which deal flow stats to retrieve.
      }
    }
  } with {
    briefly "Get deal flow stats"
    described as {
      |Retrieves the deal flow stats projection.
    }
  }
  result DealFlowStatsView is {
    dealFlowStats: DealFlowAnalytics.DealFlowStats with {
      briefly "Deal flow stats"
      described as {
        |The deal flow stats being returned.
      }
    }
  } with {
    briefly "Deal flow stats view"
    described as {
      |Read model view carrying the deal flow stats projection.
    }
  }
  projector DealFlowAnalytics as flow is {
    updates repository DealContext.DealRepository
    outlet DealFlowAnalyticsToRepository is type DealRepositoryCommand
    inlet DealFlowAnalyticsFromDeal is type DealEvent    record DealFlowStats is {
      totalDeals: Natural with {
        briefly "Total"
        described as {
          |Total deals.
        }
      }
      activeDeals: Natural with {
        briefly "Active"
        described as {
          |Active deals.
        }
      }
      closedDeals: Natural with {
        briefly "Closed"
        described as {
          |Closed deals.
        }
      }
      passedDeals: Natural with {
        briefly "Passed"
        described as {
          |Passed deals.
        }
      }
      totalDeployed: Decimal(12,2) with {
        briefly "Deployed"
        described as {
          |Capital deployed.
        }
      }
      conversionRate: Decimal(5,2) with {
        briefly "Conversion"
        described as {
          |Conversion rate.
        }
      }
      avgTimeToClose: Natural with {
        briefly "Time to close"
        described as {
          |Average days to close.
        }
      }
    } with {
      briefly "Deal flow statistics"
      described as {
        |Deal pipeline metrics.
      }
    }
    handler AnalyticsHandler is {
      on dealWithdrawn: event Deal.DealWithdrawn is {
        tell command DealContext.DealRepository.PersistDealWithdrawn(dealId = dealWithdrawn.dealId) to repository DealContext.DealRepository
        do "apply DealWithdrawn to the DealFlowAnalytics projection"
      }
      on meetingRecorded: event Deal.MeetingRecorded is {
        tell command DealContext.DealRepository.PersistMeetingRecorded(dealId = meetingRecorded.dealId) to repository DealContext.DealRepository
        do "apply MeetingRecorded to the DealFlowAnalytics projection"
      }
      on metricsUpdated: event Deal.MetricsUpdated is {
        tell command DealContext.DealRepository.PersistMetricsUpdated(dealId = metricsUpdated.dealId) to repository DealContext.DealRepository
        do "apply MetricsUpdated to the DealFlowAnalytics projection"
      }
      on noteAdded: event Deal.NoteAdded is {
        tell command DealContext.DealRepository.PersistNoteAdded(dealId = noteAdded.dealId) to repository DealContext.DealRepository
        do "apply NoteAdded to the DealFlowAnalytics projection"
      }
      on prioritySet: event Deal.PrioritySet is {
        tell command DealContext.DealRepository.PersistPrioritySet(dealId = prioritySet.dealId) to repository DealContext.DealRepository
        do "apply PrioritySet to the DealFlowAnalytics projection"
      }
      on termSheetIssued: event Deal.TermSheetIssued is {
        tell command DealContext.DealRepository.PersistTermSheetIssued(dealId = termSheetIssued.dealId) to repository DealContext.DealRepository
        do "apply TermSheetIssued to the DealFlowAnalytics projection"
      }
      on termSheetResponseReceived: event Deal.TermSheetResponseReceived is {
        tell command DealContext.DealRepository.PersistTermSheetResponseReceived(dealId = termSheetResponseReceived.dealId) to repository DealContext.DealRepository
        do "apply TermSheetResponseReceived to the DealFlowAnalytics projection"
      }
      on termsProposed: event Deal.TermsProposed is {
        tell command DealContext.DealRepository.PersistTermsProposed(dealId = termsProposed.dealId) to repository DealContext.DealRepository
        do "apply TermsProposed to the DealFlowAnalytics projection"
      }
      on thesisWritten: event Deal.ThesisWritten is {
        tell command DealContext.DealRepository.PersistThesisWritten(dealId = thesisWritten.dealId) to repository DealContext.DealRepository
        do "apply ThesisWritten to the DealFlowAnalytics projection"
      }
      on dealCreated: event Deal.DealCreated is {
        tell command DealContext.DealRepository.PersistDealCreated(dealId = dealCreated.dealId) to repository DealContext.DealRepository
      }
      on stageAdvanced: event Deal.StageAdvanced is {
        tell command DealContext.DealRepository.PersistStageAdvanced(dealId = stageAdvanced.dealId) to repository DealContext.DealRepository
      }
      on dealClosed: event Deal.DealClosed is {
        tell command DealContext.DealRepository.PersistDealClosed(dealId = dealClosed.dealId) to repository DealContext.DealRepository
      }
      on dealPassed: event Deal.DealPassed is {
        tell command DealContext.DealRepository.PersistDealPassed(dealId = dealPassed.dealId) to repository DealContext.DealRepository
      }
    } with {
      briefly "Maintains deal flow analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Deal flow analytics projections"
    described as {
      |Maintains deal pipeline analytics data.
    }
  }
  processor DealEventSplit as flow is {
    inlet DealEventSplitIn is type DealEvent    outlet DealEventSplitToDealFlowAnalytics is type DealEvent
    handler DealEventSplitHandler is {
      on dealCreated: event Deal.DealCreated is {
        send dealCreated to outlet DealEventSplitToDealFlowAnalytics
        tell dealCreated to entity DealContext.Deal
      }
      on metricsUpdated: event Deal.MetricsUpdated is {
        send metricsUpdated to outlet DealEventSplitToDealFlowAnalytics
        tell metricsUpdated to entity DealContext.Deal
      }
      on noteAdded: event Deal.NoteAdded is {
        send noteAdded to outlet DealEventSplitToDealFlowAnalytics
        tell noteAdded to entity DealContext.Deal
      }
      on meetingRecorded: event Deal.MeetingRecorded is {
        send meetingRecorded to outlet DealEventSplitToDealFlowAnalytics
        tell meetingRecorded to entity DealContext.Deal
      }
      on stageAdvanced: event Deal.StageAdvanced is {
        send stageAdvanced to outlet DealEventSplitToDealFlowAnalytics
        tell stageAdvanced to entity DealContext.Deal
      }
      on prioritySet: event Deal.PrioritySet is {
        send prioritySet to outlet DealEventSplitToDealFlowAnalytics
        tell prioritySet to entity DealContext.Deal
      }
      on thesisWritten: event Deal.ThesisWritten is {
        send thesisWritten to outlet DealEventSplitToDealFlowAnalytics
        tell thesisWritten to entity DealContext.Deal
      }
      on termsProposed: event Deal.TermsProposed is {
        send termsProposed to outlet DealEventSplitToDealFlowAnalytics
        tell termsProposed to entity DealContext.Deal
      }
      on termSheetIssued: event Deal.TermSheetIssued is {
        send termSheetIssued to outlet DealEventSplitToDealFlowAnalytics
        tell termSheetIssued to entity DealContext.Deal
      }
      on termSheetResponseReceived: event Deal.TermSheetResponseReceived is {
        send termSheetResponseReceived to outlet DealEventSplitToDealFlowAnalytics
        tell termSheetResponseReceived to entity DealContext.Deal
      }
      on dealClosed: event Deal.DealClosed is {
        send dealClosed to outlet DealEventSplitToDealFlowAnalytics
        tell dealClosed to entity DealContext.Deal
      }
      on dealPassed: event Deal.DealPassed is {
        send dealPassed to outlet DealEventSplitToDealFlowAnalytics
        tell dealPassed to entity DealContext.Deal
      }
      on dealWithdrawn: event Deal.DealWithdrawn is {
        send dealWithdrawn to outlet DealEventSplitToDealFlowAnalytics
        tell dealWithdrawn to entity DealContext.Deal
      }
      on other is {
        error "Unexpected message for processor DealEventSplit"
      }
    } with {
      briefly "Deal event fan-out handler"
      described as {
        |Delivers each Deal event to all of its consumers.
      }
    }
  } with {
    briefly "Deal event fan-out"
    described as {
      |Fans Deal events out to the repository and projectors.
    }
  }
  connector 'DealEvent Stream' is from outlet DealContext.Deal.DealEvents2 to inlet DealContext.DealEventSplit.DealEventSplitIn with {
    briefly "Deal events, fanned out to storage and read models"
  }
  connector 'DealFlowAnalytics Feed' is from outlet DealContext.DealEventSplit.DealEventSplitToDealFlowAnalytics to inlet DealContext.DealFlowAnalytics.DealFlowAnalyticsFromDeal with {
    briefly "Deal events feeding the DealFlowAnalytics projection"
  }
  connector 'DealFlowAnalytics Storage' is from outlet DealContext.DealFlowAnalytics.DealFlowAnalyticsToRepository to inlet DealContext.DealRepository.DealRepositoryFromDealFlowAnalytics with {
    briefly "DealFlowAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for deal flow"
  described as {
    | The DealContext is the bounded context for
    | venture capital deal sourcing and pipeline.
  }
}
