// Deal Flow Domain Model
// Venture capital deal sourcing and pipeline management
domain DealFlow is {
  persistent connector 'MarketDataServiceReply Stream' is from outlet MarketDataService.MarketDataServiceRepliesOut to inlet DealContext.ToMarketDataService.ToMarketDataServiceReplies with {
    briefly "What MarketDataService answers DealContext"
  }
  persistent connector 'DocumentManagementServiceReply Stream' is from outlet DocumentManagementService.DocumentManagementServiceRepliesOut to inlet DealContext.ToDocumentManagementService.ToDocumentManagementServiceReplies with {
    briefly "What DocumentManagementService answers DealContext"
  }
  persistent connector 'CompanyResearchServiceReply Stream' is from outlet CompanyResearchService.CompanyResearchServiceRepliesOut to inlet DealContext.ToCompanyResearchService.ToCompanyResearchServiceReplies with {
    briefly "What CompanyResearchService answers DealContext"
  }
  persistent connector 'CalendarServiceEvent Stream' is from outlet CalendarService.CalendarServiceEventsOut to inlet DealContext.FromCalendarService.FromCalendarServiceIn with {
    briefly "What CalendarService tells DealContext, unasked"
  }
  persistent connector 'CrmIntegrationServiceEvent Stream' is from outlet CrmIntegrationService.CrmIntegrationServiceEventsOut to inlet DealContext.FromCrmIntegrationService.FromCrmIntegrationServiceIn with {
    briefly "What CrmIntegrationService tells DealContext, unasked"
  }
  persistent connector 'DocumentManagementServiceEvent Stream' is from outlet DocumentManagementService.DocumentManagementServiceEventsOut to inlet DealContext.FromDocumentManagementService.FromDocumentManagementServiceIn with {
    briefly "What DocumentManagementService tells DealContext, unasked"
  }
  persistent connector 'LegalDocumentServiceEvent Stream' is from outlet LegalDocumentService.LegalDocumentServiceEventsOut to inlet DealContext.FromLegalDocumentService.FromLegalDocumentServiceIn with {
    briefly "What LegalDocumentService tells DealContext, unasked"
  }
  persistent connector 'MarketDataServiceRequest Stream' is from outlet DealContext.ToMarketDataService.ToMarketDataServiceOut to inlet MarketDataService.MarketDataServiceRequests with {
    briefly "What DealContext asks MarketDataService to send"
  }
  persistent connector 'CompanyResearchServiceRequest Stream' is from outlet DealContext.ToCompanyResearchService.ToCompanyResearchServiceOut to inlet CompanyResearchService.CompanyResearchServiceRequests with {
    briefly "What DealContext asks CompanyResearchService to send"
  }
  persistent connector 'CrmIntegrationServiceRequest Stream' is from outlet DealContext.ToCrmIntegrationService.ToCrmIntegrationServiceOut to inlet CrmIntegrationService.CrmIntegrationServiceRequests with {
    briefly "What DealContext asks CrmIntegrationService to send"
  }
  persistent connector 'DocumentManagementServiceRequest Stream' is from outlet DealContext.ToDocumentManagementService.ToDocumentManagementServiceOut to inlet DocumentManagementService.DocumentManagementServiceRequests with {
    briefly "What DealContext asks DocumentManagementService to send"
  }
  persistent connector 'LegalDocumentServiceRequest Stream' is from outlet DealContext.ToLegalDocumentService.ToLegalDocumentServiceOut to inlet LegalDocumentService.LegalDocumentServiceRequests with {
    briefly "What DealContext asks LegalDocumentService to send"
  }
  persistent connector 'CalendarServiceRequest Stream' is from outlet DealContext.ToCalendarService.ToCalendarServiceOut to inlet CalendarService.CalendarServiceRequests with {
    briefly "What DealContext asks CalendarService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet DealContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What DealContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Partner is "person making investment decisions" with {
    briefly "Partner"
    described as {
      |Investment partner.
    }
  }
  user Associate is "person sourcing deals" with {
    briefly "Associate"
    described as {
      |Investment associate.
    }
  }
  user Analyst is "person analyzing opportunities" with {
    briefly "Analyst"
    described as {
      |Investment analyst.
    }
  }
  epic DealFlowEpic is {
    user Associate wants to "to manage deal pipeline" so that "the fund finds great investments"
    case EvaluateOpportunity is {
      user Associate wants to "to evaluate a potential investment" so that "we can decide whether to pursue it"
      step is "Associate sources" "investment opportunity" "from network" with {
        briefly "Source deal"
        described as {
          |Find opportunity.
        }
      }
      step take input DealFlowApp.DealFlowScreen.CreateDealInput from user Associate with {
        briefly "Create deal"
        described as {
          |Enter into pipeline.
        }
      }
      step is "Analyst conducts" "initial screening" "and research" with {
        briefly "Screen deal"
        described as {
          |Initial analysis.
        }
      }
      step is "Partner decides" "whether to proceed" "to due diligence" with {
        briefly "Decision"
        described as {
          |Go/no-go decision.
        }
      }
    } with {
      briefly "Evaluate opportunity"
      described as {
        |Evaluating investment opportunities.
      }
    }
  } with {
    briefly "Deal flow management"
    described as {
      | Epic covering deal sourcing, screening,
      | and pipeline progression.
    }
  }
  include "DealContext.riddl"
  include "external-contexts.riddl"
  application context DealFlowApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in DealFlow are delivered.
      }
    }
    group DealFlowScreen is {
      input AdvanceStageInput acquires command DealContext.Deal.AdvanceStage with {
        briefly "Advance stage control"
        described as {
          |The control through which a user submits the advance stage request.
        }
      }
      input CloseDealInput acquires command DealContext.Deal.CloseDeal with {
        briefly "Close deal control"
        described as {
          |The control through which a user submits the close deal request.
        }
      }
      input IssueTermSheetInput acquires command DealContext.Deal.IssueTermSheet with {
        briefly "Issue term sheet control"
        described as {
          |The control through which a user submits the issue term sheet request.
        }
      }
      input MarkWithdrawnInput acquires command DealContext.Deal.MarkWithdrawn with {
        briefly "Mark withdrawn control"
        described as {
          |The control through which a user submits the mark withdrawn request.
        }
      }
      input PassOnDealInput acquires command DealContext.Deal.PassOnDeal with {
        briefly "Pass on deal control"
        described as {
          |The control through which a user submits the pass on deal request.
        }
      }
      input ProposeTermsInput acquires command DealContext.Deal.ProposeTerms with {
        briefly "Propose terms control"
        described as {
          |The control through which a user submits the propose terms request.
        }
      }
      input RecordMeetingInput acquires command DealContext.Deal.RecordMeeting with {
        briefly "Record meeting control"
        described as {
          |The control through which a user submits the record meeting request.
        }
      }
      input SetPriorityInput acquires command DealContext.Deal.SetPriority with {
        briefly "Set priority control"
        described as {
          |The control through which a user submits the set priority request.
        }
      }
      input WriteThesisInput acquires command DealContext.Deal.WriteThesis with {
        briefly "Write thesis control"
        described as {
          |The control through which a user submits the write thesis request.
        }
      }
      input CreateDealInput acquires command DealContext.CreateDeal with {
        briefly "Create deal control"
        described as {
          |The control through which a user submits the create deal request.
        }
      }
    } with {
      briefly "Deal flow screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppDealCommands is type DealContext.DealRequest
    inlet AppDealRepositoryResponses is result DealContext.Deal.DealResult
    handler DealFlowAppHandler is {
      on other is {
        error "Unexpected message for application context DealFlowApp"
      }
    } with {
      briefly "DealFlowApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "DealFlowApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'DealCommand Stream' is from outlet DealFlowApp.AppDealCommands to inlet DealContext.DealCommandStreamIn with {
    briefly "Deal commands from the application"
  }
  persistent connector 'DealResult Stream' is from outlet DealContext.DealResultStreamOut to inlet DealFlowApp.AppDealRepositoryResponses with {
    briefly "Deal query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet DealFlowApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Deal flow domain"
  described as {
    | The DealFlow domain handles venture capital
    | deal sourcing and pipeline management.
  }
}
