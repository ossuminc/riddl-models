// Deal Flow Domain Model
// Venture capital deal sourcing and pipeline management
domain DealFlow is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Partner is "person making investment decisions" with {
    briefly "Partner"
    described as {
      |Investment partner.
    }
  }
  user Associate is "person sourcing deals" with {
    briefly "Associate"
    described as {
      |Investment associate.
    }
  }
  user Analyst is "person analyzing opportunities" with {
    briefly "Analyst"
    described as {
      |Investment analyst.
    }
  }
  epic DealFlowEpic is {
    user Associate wants to "to manage deal pipeline" so that "the fund finds great investments"
    case EvaluateOpportunity is {
      user Associate wants to "to evaluate a potential investment" so that "we can decide whether to pursue it"
      step is "Associate sources" "investment opportunity" "from network" with {
        briefly "Source deal"
        described as {
          |Find opportunity.
        }
      }
      step take input DealFlowApp.DealFlowScreen.CreateDealInput from user Associate with {
        briefly "Create deal"
        described as {
          |Enter into pipeline.
        }
      }
      step is "Analyst conducts" "initial screening" "and research" with {
        briefly "Screen deal"
        described as {
          |Initial analysis.
        }
      }
      step is "Partner decides" "whether to proceed" "to due diligence" with {
        briefly "Decision"
        described as {
          |Go/no-go decision.
        }
      }
    } with {
      briefly "Evaluate opportunity"
      described as {
        |Evaluating investment opportunities.
      }
    }
  } with {
    briefly "Deal flow management"
    described as {
      | Epic covering deal sourcing, screening,
      | and pipeline progression.
    }
  }
  include "DealContext.riddl"
  include "external-contexts.riddl"
  application context DealFlowApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in DealFlow are delivered.
      }
    }
    group DealFlowScreen is {
      input CreateDealInput acquires command DealContext.Deal.CreateDeal with {
        briefly "Create deal control"
        described as {
          |The control through which a user submits the create deal request.
        }
      }
    } with {
      briefly "Deal flow screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppDealCommands is type DealContext.Deal.DealCommand
    inlet AppDealRepositoryResponses is type DealContext.Deal.DealResult    handler DealFlowAppHandler is {
      on other is {
        error "Unexpected message for application context DealFlowApp"
      }
    } with {
      briefly "DealFlowApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "DealFlowApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'DealCommand Stream' is from outlet DealFlowApp.AppDealCommands to inlet DealContext.Deal.DealCommands with {
    briefly "Deal commands from the application"
  }
  persistent connector 'DealResult Stream' is from outlet DealContext.DealRepository.DealRepositoryResponses to inlet DealFlowApp.AppDealRepositoryResponses with {
    briefly "Deal query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet DealFlowApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Deal flow domain"
  described as {
    | The DealFlow domain handles venture capital
    | deal sourcing and pipeline management.
  }
}
