// Fund Administration - Fund Admin Context
context FundAdminContext as router is {
  inlet FundAccountCommandStreamIn is type FundAccountCommand  outlet FundAccountCommandStreamOut is type FundAccountCommand
  inlet FundAccountResultStreamIn is type FundAccount.FundAccountResult  outlet FundAccountResultStreamOut is type FundAccount.FundAccountResult
  handler FundAdminContextBoundary is {
    on createFundAccount: command FundAccount.CreateFundAccount is {
      send createFundAccount to outlet FundAdminContext.FundAccountCommandStreamOut
    }
    on issueCapitalCall: command FundAccount.IssueCapitalCall is {
      send issueCapitalCall to outlet FundAdminContext.FundAccountCommandStreamOut
    }
    on recordCallPayment: command FundAccount.RecordCallPayment is {
      send recordCallPayment to outlet FundAdminContext.FundAccountCommandStreamOut
    }
    on processDistribution: command FundAccount.ProcessDistribution is {
      send processDistribution to outlet FundAdminContext.FundAccountCommandStreamOut
    }
    on calculateNav: command FundAccount.CalculateNav is {
      send calculateNav to outlet FundAdminContext.FundAccountCommandStreamOut
    }
    on recordTransaction: command FundAccount.RecordTransaction is {
      send recordTransaction to outlet FundAdminContext.FundAccountCommandStreamOut
    }
    on generateLpReport: command FundAccount.GenerateLpReport is {
      send generateLpReport to outlet FundAdminContext.FundAccountCommandStreamOut
    }
    on advanceFundStage: command FundAccount.AdvanceFundStage is {
      send advanceFundStage to outlet FundAdminContext.FundAccountCommandStreamOut
    }
    on terminateFund: command FundAccount.TerminateFund is {
      send terminateFund to outlet FundAdminContext.FundAccountCommandStreamOut
    }
    on fundAccountResult: result FundAccount.FundAccountResult is {
      send fundAccountResult to outlet FundAdminContext.FundAccountResultStreamOut
    }
    on other is {
      error "Unexpected message at the FundAdminContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'FundAccountCommand Stream Intake' is from outlet FundAdminContext.FundAccountCommandStreamOut to inlet FundAdminContext.FundAccount.FundAccountCommands  connector 'FundAccountResult Stream Egress' is from outlet FundAdminContext.FundAdminRepository.FundAdminRepositoryResponses to inlet FundAdminContext.FundAccountResultStreamIn  adaptor FromCustodianSystem from context CustodianSystem is { 
    handler FromCustodianSystemHandler is {
      on result CustodianSystem.AccountBalance is {
        do "the model receives account balance"
      }
      on event CustodianSystem.FundsTransferred is {
        do "the model receives funds transferred"
      }
      on other is {
        error "Unexpected message for adaptor FromCustodianSystem"
      }
    } with {
      briefly "from custodian system"
      described as {
        |Carries messages from the external CustodianSystem.
      }
    }
  } with {
    briefly "CustodianSystem integration"
    described as {
      |The model's side of the CustodianSystem conversation.
    }
  }
  adaptor ToCustodianSystem to context CustodianSystem is { 
    handler ToCustodianSystemHandler is {
      on query CustodianSystem.GetAccountBalance is {
        do "the model sends get account balance"
      }
      on command CustodianSystem.TransferFunds is {
        do "the model sends transfer funds"
      }
      on other is {
        error "Unexpected message for adaptor ToCustodianSystem"
      }
    } with {
      briefly "to custodian system"
      described as {
        |Carries messages to the external CustodianSystem.
      }
    }
  } with {
    briefly "CustodianSystem integration"
    described as {
      |The model's side of the CustodianSystem conversation.
    }
  }
  adaptor FromRegulatoryFiling from context RegulatoryFiling is { 
    handler FromRegulatoryFilingHandler is {
      on event RegulatoryFiling.FilingAccepted is {
        do "the model receives filing accepted"
      }
      on event RegulatoryFiling.FilingRejected is {
        do "the model receives filing rejected"
      }
      on result RegulatoryFiling.FilingStatus is {
        do "the model receives filing status"
      }
      on event RegulatoryFiling.FilingSubmitted is {
        do "the model receives filing submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryFiling"
      }
    } with {
      briefly "from regulatory filing"
      described as {
        |Carries messages from the external RegulatoryFiling.
      }
    }
  } with {
    briefly "RegulatoryFiling integration"
    described as {
      |The model's side of the RegulatoryFiling conversation.
    }
  }
  adaptor ToRegulatoryFiling to context RegulatoryFiling is { 
    handler ToRegulatoryFilingHandler is {
      on query RegulatoryFiling.GetFilingStatus is {
        do "the model sends get filing status"
      }
      on command RegulatoryFiling.SubmitFiling is {
        do "the model sends submit filing"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryFiling"
      }
    } with {
      briefly "to regulatory filing"
      described as {
        |Carries messages to the external RegulatoryFiling.
      }
    }
  } with {
    briefly "RegulatoryFiling integration"
    described as {
      |The model's side of the RegulatoryFiling conversation.
    }
  }
  include "types.riddl"
  include "FundAccount.riddl"
  type FundAdminRepositoryCommand is one of {
    FundAdminContext.FundAdminRepository.PersistCallPaymentReceived or FundAdminContext.FundAdminRepository.PersistCapitalCallIssued or FundAdminContext.FundAdminRepository.PersistDistributionProcessed or FundAdminContext.FundAdminRepository.PersistFundAccountCreated or FundAdminContext.FundAdminRepository.PersistFundStageAdvanced or FundAdminContext.FundAdminRepository.PersistFundTerminated or FundAdminContext.FundAdminRepository.PersistLpReportGenerated or FundAdminContext.FundAdminRepository.PersistNavCalculated or FundAdminContext.FundAdminRepository.PersistTransactionRecorded
  } with {
    briefly "Anything that writes FundAdminRepository"
    described as {
      |The persistence commands FundAdminRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository FundAdminRepository as flow is {
    inlet FundAdminRepositoryFromFundMetrics is type FundAdminRepositoryCommand
    command PersistCallPaymentReceived is  {
      accountId: FundAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row CallPaymentReceived applies to.
        }
      }
    } with {
      briefly "Persist CallPaymentReceived"
      described as {
        |Instructs this repository to apply CallPaymentReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFundStageAdvanced is  {
      accountId: FundAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row FundStageAdvanced applies to.
        }
      }
    } with {
      briefly "Persist FundStageAdvanced"
      described as {
        |Instructs this repository to apply FundStageAdvanced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFundTerminated is  {
      accountId: FundAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row FundTerminated applies to.
        }
      }
    } with {
      briefly "Persist FundTerminated"
      described as {
        |Instructs this repository to apply FundTerminated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLpReportGenerated is  {
      accountId: FundAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row LpReportGenerated applies to.
        }
      }
    } with {
      briefly "Persist LpReportGenerated"
      described as {
        |Instructs this repository to apply LpReportGenerated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransactionRecorded is  {
      accountId: FundAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransactionRecorded applies to.
        }
      }
    } with {
      briefly "Persist TransactionRecorded"
      described as {
        |Instructs this repository to apply TransactionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCapitalCallIssued is  {
      accountId: FundAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row CapitalCallIssued applies to.
        }
      }
    } with {
      briefly "Persist CapitalCallIssued"
      described as {
        |Instructs this repository to apply CapitalCallIssued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDistributionProcessed is  {
      accountId: FundAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row DistributionProcessed applies to.
        }
      }
    } with {
      briefly "Persist DistributionProcessed"
      described as {
        |Instructs this repository to apply DistributionProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFundAccountCreated is  {
      accountId: FundAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row FundAccountCreated applies to.
        }
      }
    } with {
      briefly "Persist FundAccountCreated"
      described as {
        |Instructs this repository to apply FundAccountCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistNavCalculated is  {
      accountId: FundAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row NavCalculated applies to.
        }
      }
    } with {
      briefly "Persist NavCalculated"
      described as {
        |Instructs this repository to apply NavCalculated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet FundAdminRepositoryResponses is type FundAccount.FundAccountResult
    record StoredFundAccount is  {
      fundAccountId: FundAccountId with {
        briefly "fundAccountId"
        described as {
          |The fundAccountId column of the stored fundAccount row.
        }
      }
      accountId: FundAccountId with {
        briefly "accountId"
        described as {
          |The accountId column of the stored fundAccount row.
        }
      }
      fundInfo: FundInfo with {
        briefly "fundInfo"
        described as {
          |The fundInfo column of the stored fundAccount row.
        }
      }
    } with {
      briefly "Stored fundAccount row"
      described as {
        |The persistence shape of fundAccount data as this repository stores it.
      }
    }
    schema FundAdminData is relational
      of fundAccounts as type StoredFundAccount
        index on field StoredFundAccount.accountId
        index on field StoredFundAccount.fundInfo.fundId
        index on field StoredFundAccount.status
 with {
      briefly "Fund admin data schema"
      described as {
        |The relational schema holding fund admin data for the FundAdminRepository.
      }
    }
    handler FundAdminPersistence is {
      on persistCallPaymentReceived: command PersistCallPaymentReceived is {
        do "apply CallPaymentReceived to the stored row"
      }
      on persistFundStageAdvanced: command PersistFundStageAdvanced is {
        do "apply FundStageAdvanced to the stored row"
      }
      on persistFundTerminated: command PersistFundTerminated is {
        do "apply FundTerminated to the stored row"
      }
      on persistLpReportGenerated: command PersistLpReportGenerated is {
        do "apply LpReportGenerated to the stored row"
      }
      on persistTransactionRecorded: command PersistTransactionRecorded is {
        do "apply TransactionRecorded to the stored row"
      }
      on persistCapitalCallIssued: command PersistCapitalCallIssued is {
        do "apply CapitalCallIssued to the stored row"
      }
      on persistDistributionProcessed: command PersistDistributionProcessed is {
        do "apply DistributionProcessed to the stored row"
      }
      on persistFundAccountCreated: command PersistFundAccountCreated is {
        do "apply FundAccountCreated to the stored row"
      }
      on persistNavCalculated: command PersistNavCalculated is {
        do "apply NavCalculated to the stored row"
      }
      on query GetFundPerformanceMetrics is {
        let fundPerformanceMetricsView: type FundPerformanceMetricsView = prompt("read the fund performance metrics projection")
        reply fundPerformanceMetricsView
      }
    } with {
      briefly "Persists fund administration events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Fund administration data persistence"
    described as {
      |Persistent storage for fund administration.
    }
  }
  query GetFundPerformanceMetrics replies result FundPerformanceMetricsView is  {
    fundPerformanceMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which fund performance metrics to retrieve.
      }
    }
  } with {
    briefly "Get fund performance metrics"
    described as {
      |Retrieves the fund performance metrics projection.
    }
  }
  result FundPerformanceMetricsView is  {
    fundPerformanceMetrics: FundMetrics.FundPerformanceMetrics with {
      briefly "Fund performance metrics"
      described as {
        |The fund performance metrics being returned.
      }
    }
  } with {
    briefly "Fund performance metrics view"
    described as {
      |Read model view carrying the fund performance metrics projection.
    }
  }
  projector FundMetrics as flow is {
    outlet FundMetricsToRepository is type FundAdminRepositoryCommand
    updates repository FundAdminContext.FundAdminRepository
    inlet FundMetricsFromFundAccount is type FundAccountEvent
    record FundPerformanceMetrics is  {
      totalFundsManaged: Natural with {
        briefly "Funds"
        described as {
          |Total funds managed.
        }
      }
      totalCapitalCommitted: Decimal(18,2) with {
        briefly "Committed"
        described as {
          |Total capital committed.
        }
      }
      totalCapitalCalled: Decimal(18,2) with {
        briefly "Called"
        described as {
          |Total capital called.
        }
      }
      totalDistributions: Decimal(18,2) with {
        briefly "Distributed"
        described as {
          |Total distributions.
        }
      }
      averageNavPerFund: Decimal(18,2) with {
        briefly "Avg NAV"
        described as {
          |Average NAV per fund.
        }
      }
    } with {
      briefly "Fund performance metrics"
      described as {
        |Aggregate fund performance statistics.
      }
    }
    handler MetricsHandler is {
      on callPaymentReceived: event FundAccount.CallPaymentReceived is {
        tell command FundAdminContext.FundAdminRepository.PersistCallPaymentReceived(accountId = callPaymentReceived.accountId) to repository FundAdminContext.FundAdminRepository
        do "apply CallPaymentReceived to the FundMetrics projection"
      }
      on fundStageAdvanced: event FundAccount.FundStageAdvanced is {
        tell command FundAdminContext.FundAdminRepository.PersistFundStageAdvanced(accountId = fundStageAdvanced.accountId) to repository FundAdminContext.FundAdminRepository
        do "apply FundStageAdvanced to the FundMetrics projection"
      }
      on fundTerminated: event FundAccount.FundTerminated is {
        tell command FundAdminContext.FundAdminRepository.PersistFundTerminated(accountId = fundTerminated.accountId) to repository FundAdminContext.FundAdminRepository
        do "apply FundTerminated to the FundMetrics projection"
      }
      on lpReportGenerated: event FundAccount.LpReportGenerated is {
        tell command FundAdminContext.FundAdminRepository.PersistLpReportGenerated(accountId = lpReportGenerated.accountId) to repository FundAdminContext.FundAdminRepository
        do "apply LpReportGenerated to the FundMetrics projection"
      }
      on transactionRecorded: event FundAccount.TransactionRecorded is {
        tell command FundAdminContext.FundAdminRepository.PersistTransactionRecorded(accountId = transactionRecorded.accountId) to repository FundAdminContext.FundAdminRepository
        do "apply TransactionRecorded to the FundMetrics projection"
      }
      on fundAccountCreated: event FundAccount.FundAccountCreated is {
        tell command FundAdminContext.FundAdminRepository.PersistFundAccountCreated(accountId = fundAccountCreated.accountId) to repository FundAdminContext.FundAdminRepository
      }
      on capitalCallIssued: event FundAccount.CapitalCallIssued is {
        tell command FundAdminContext.FundAdminRepository.PersistCapitalCallIssued(accountId = capitalCallIssued.accountId) to repository FundAdminContext.FundAdminRepository
      }
      on distributionProcessed: event FundAccount.DistributionProcessed is {
        tell command FundAdminContext.FundAdminRepository.PersistDistributionProcessed(accountId = distributionProcessed.accountId) to repository FundAdminContext.FundAdminRepository
      }
      on navCalculated: event FundAccount.NavCalculated is {
        tell command FundAdminContext.FundAdminRepository.PersistNavCalculated(accountId = navCalculated.accountId) to repository FundAdminContext.FundAdminRepository
      }
    } with {
      briefly "Maintains fund performance metrics"
      described as {
        |Projects events into performance metrics.
      }
    }
  } with {
    briefly "Fund performance metrics"
    described as {
      |Fund administration analytics.
    }
  }
  processor FundAccountEventSplit as flow is {
    inlet FundAccountEventSplitIn is type FundAccountEvent
    outlet FundAccountEventSplitToFundMetrics is type FundAccountEvent
    handler FundAccountEventSplitHandler is {
      on fundAccountCreated: event FundAccount.FundAccountCreated is {
        send fundAccountCreated to outlet FundAccountEventSplitToFundMetrics
        tell fundAccountCreated to entity FundAdminContext.FundAccount
      }
      on capitalCallIssued: event FundAccount.CapitalCallIssued is {
        send capitalCallIssued to outlet FundAccountEventSplitToFundMetrics
        tell capitalCallIssued to entity FundAdminContext.FundAccount
      }
      on callPaymentReceived: event FundAccount.CallPaymentReceived is {
        send callPaymentReceived to outlet FundAccountEventSplitToFundMetrics
        tell callPaymentReceived to entity FundAdminContext.FundAccount
      }
      on distributionProcessed: event FundAccount.DistributionProcessed is {
        send distributionProcessed to outlet FundAccountEventSplitToFundMetrics
        tell distributionProcessed to entity FundAdminContext.FundAccount
      }
      on navCalculated: event FundAccount.NavCalculated is {
        send navCalculated to outlet FundAccountEventSplitToFundMetrics
        tell navCalculated to entity FundAdminContext.FundAccount
      }
      on transactionRecorded: event FundAccount.TransactionRecorded is {
        send transactionRecorded to outlet FundAccountEventSplitToFundMetrics
        tell transactionRecorded to entity FundAdminContext.FundAccount
      }
      on lpReportGenerated: event FundAccount.LpReportGenerated is {
        send lpReportGenerated to outlet FundAccountEventSplitToFundMetrics
        tell lpReportGenerated to entity FundAdminContext.FundAccount
      }
      on fundStageAdvanced: event FundAccount.FundStageAdvanced is {
        send fundStageAdvanced to outlet FundAccountEventSplitToFundMetrics
        tell fundStageAdvanced to entity FundAdminContext.FundAccount
      }
      on fundTerminated: event FundAccount.FundTerminated is {
        send fundTerminated to outlet FundAccountEventSplitToFundMetrics
        tell fundTerminated to entity FundAdminContext.FundAccount
      }
      on other is {
        error "Unexpected message for processor FundAccountEventSplit"
      }
    } with {
      briefly "FundAccount event fan-out handler"
      described as {
        |Delivers each FundAccount event to all of its consumers.
      }
    }
  } with {
    briefly "FundAccount event fan-out"
    described as {
      |Fans FundAccount events out to the repository and projectors.
    }
  }
  connector 'FundAccountEvent Stream' is from outlet FundAdminContext.FundAccount.FundAccountEvents2 to inlet FundAdminContext.FundAccountEventSplit.FundAccountEventSplitIn with {
    briefly "FundAccount events, fanned out to storage and read models"
  }
  connector 'FundMetrics Feed' is from outlet FundAdminContext.FundAccountEventSplit.FundAccountEventSplitToFundMetrics to inlet FundAdminContext.FundMetrics.FundMetricsFromFundAccount with {
    briefly "FundAccount events feeding the FundMetrics projection"
  }
  connector 'FundMetrics Storage' is from outlet FundAdminContext.FundMetrics.FundMetricsToRepository to inlet FundAdminContext.FundAdminRepository.FundAdminRepositoryFromFundMetrics with {
    briefly "FundMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for fund administration"
  described as {
    |Venture capital fund administration context.
  }
}
