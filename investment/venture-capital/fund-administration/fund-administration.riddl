// Fund Administration Domain Model
// VC fund administration, capital calls, distributions, and LP reporting
domain FundAdministration is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user FundManager is "person managing venture capital fund operations" with {
    briefly "Fund Manager"
    described as {
      |Manager overseeing fund lifecycle and investment decisions.
    }
  }
  user FundAccountant is "person handling fund accounting and NAV calculations" with {
    briefly "Fund Accountant"
    described as {
      |Accountant managing fund financials and reporting.
    }
  }
  user LimitedPartner is "investor in the venture capital fund" with {
    briefly "Limited Partner"
    described as {
      |LP investor receiving capital calls and distributions.
    }
  }
  epic FundLifecycle is {
    user FundManager wants to "to administer fund operations end-to-end" so that "capital is deployed and returns distributed to investors"
    case ManageCapitalCall is {
      user FundManager wants to "to issue a capital call to limited partners" so that "committed capital is collected for investments"
      step is "Manager initiates" "capital call" "for investment" with {
        briefly "Initiate call"
        described as {
          |Create capital call.
        }
      }
      step is "System notifies" "limited partners" "of capital call" with {
        briefly "Notify LPs"
        described as {
          |Send capital call notices.
        }
      }
    } with {
      briefly "Manage capital call"
      described as {
        |Issuing and collecting capital calls from LPs.
      }
    }
  } with {
    briefly "Fund lifecycle"
    described as {
      |Epic for venture capital fund administration.
    }
  }
  include "FundAdminContext.riddl"
  include "external-contexts.riddl"
  application context FundAdministrationApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in FundAdministration are delivered.
      }
    }
    outlet AppFundAccountCommands is type FundAdminContext.FundAccount.FundAccountCommand
    inlet AppFundAdminRepositoryResponses is type FundAdminContext.FundAccount.FundAccountResult    handler FundAdministrationAppHandler is {
      on other is {
        error "Unexpected message for application context FundAdministrationApp"
      }
    } with {
      briefly "FundAdministrationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "FundAdministrationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'FundAccountCommand Stream' is from outlet FundAdministrationApp.AppFundAccountCommands to inlet FundAdminContext.FundAccount.FundAccountCommands with {
    briefly "FundAccount commands from the application"
  }
  persistent connector 'FundAccountResult Stream' is from outlet FundAdminContext.FundAdminRepository.FundAdminRepositoryResponses to inlet FundAdministrationApp.AppFundAdminRepositoryResponses with {
    briefly "FundAdmin query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet FundAdministrationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Fund administration domain"
  described as {
    |Venture capital fund administration and LP management.
  }
}
