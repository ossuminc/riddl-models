// Portfolio Management - VC Portfolio Context
context VCPortfolioContext is {
  adaptor FromLegalSystem from context LegalSystem is { 
    handler FromLegalSystemHandler is {
      on result LegalSystem.ComplianceStatus is {
        do "the model receives compliance status"
      }
      on event LegalSystem.RegulatoryReportFiled is {
        do "the model receives regulatory report filed"
      }
      on event LegalSystem.TermSheetReviewed is {
        do "the model receives term sheet reviewed"
      }
      on other is {
        error "Unexpected message for adaptor FromLegalSystem"
      }
    } with {
      briefly "from legal system"
      described as {
        |Carries messages from the external LegalSystem.
      }
    }
  } with {
    briefly "LegalSystem integration"
    described as {
      |The model's side of the LegalSystem conversation.
    }
  }
  adaptor ToLegalSystem to context LegalSystem is { 
    handler ToLegalSystemHandler is {
      on command LegalSystem.FileRegulatoryReport is {
        do "the model sends file regulatory report"
      }
      on query LegalSystem.GetComplianceStatus is {
        do "the model sends get compliance status"
      }
      on command LegalSystem.ReviewTermSheet is {
        do "the model sends review term sheet"
      }
      on other is {
        error "Unexpected message for adaptor ToLegalSystem"
      }
    } with {
      briefly "to legal system"
      described as {
        |Carries messages to the external LegalSystem.
      }
    }
  } with {
    briefly "LegalSystem integration"
    described as {
      |The model's side of the LegalSystem conversation.
    }
  }
  adaptor FromMarketIntelligence from context MarketIntelligence is { 
    handler FromMarketIntelligenceHandler is {
      on result MarketIntelligence.CompanyValuation is {
        do "the model receives company valuation"
      }
      on result MarketIntelligence.MarketTrends is {
        do "the model receives market trends"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketIntelligence"
      }
    } with {
      briefly "from market intelligence"
      described as {
        |Carries messages from the external MarketIntelligence.
      }
    }
  } with {
    briefly "MarketIntelligence integration"
    described as {
      |The model's side of the MarketIntelligence conversation.
    }
  }
  adaptor ToMarketIntelligence to context MarketIntelligence is { 
    handler ToMarketIntelligenceHandler is {
      on query MarketIntelligence.GetCompanyValuation is {
        do "the model sends get company valuation"
      }
      on query MarketIntelligence.GetMarketTrends is {
        do "the model sends get market trends"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketIntelligence"
      }
    } with {
      briefly "to market intelligence"
      described as {
        |Carries messages to the external MarketIntelligence.
      }
    }
  } with {
    briefly "MarketIntelligence integration"
    described as {
      |The model's side of the MarketIntelligence conversation.
    }
  }
  include "types.riddl"
  include "PortfolioInvestment.riddl"
  repository PortfolioRepository as merge is {
    inlet PortfolioRepositoryFromPortfolioInvestment is type PortfolioInvestmentEvent    inlet PortfolioRepositoryFromPortfolioAnalytics is type PortfolioInvestmentEvent    outlet PortfolioRepositoryResponses is type PortfolioInvestment.PortfolioInvestmentResult
    record StoredPortfolioInvestment is  {
      portfolioInvestmentId: UUID with {
        briefly "portfolioInvestmentId"
        described as {
          |The portfolioInvestmentId column of the stored portfolioInvestment row.
        }
      }
      companyInfo: CompanyInfo with {
        briefly "companyInfo"
        described as {
          |The companyInfo column of the stored portfolioInvestment row.
        }
      }
      investmentId: InvestmentId with {
        briefly "investmentId"
        described as {
          |The investmentId column of the stored portfolioInvestment row.
        }
      }
    } with {
      briefly "Stored portfolioInvestment row"
      described as {
        |The persistence shape of portfolioInvestment data as this repository stores it.
      }
    }
    schema PortfolioData is relational
      of portfolioInvestments as type StoredPortfolioInvestment
        index on field StoredPortfolioInvestment.investmentId
        index on field StoredPortfolioInvestment.companyInfo.companyId
        index on field StoredPortfolioInvestment.status
 with {
      briefly "Portfolio data schema"
      described as {
        |The relational schema holding portfolio data for the PortfolioRepository.
      }
    }
    handler PortfolioPersistence is {
      on query GetFundMetrics is {
        do "read the fund metrics projection"
        reply result FundMetricsView
      }
      on recordInvestment: command PortfolioInvestment.RecordInvestment is {
        tell event PortfolioInvestment.InvestmentRecorded(investmentId = recordInvestment.investmentId, companyInfo = recordInvestment.companyInfo, terms = recordInvestment.terms) to entity VCPortfolioContext.PortfolioInvestment
      }
      on addMilestone: command PortfolioInvestment.AddMilestone is {
        tell event PortfolioInvestment.MilestoneAdded(investmentId = addMilestone.investmentId, milestone = addMilestone.milestone) to entity VCPortfolioContext.PortfolioInvestment
      }
      on updateMilestone: command PortfolioInvestment.UpdateMilestone is {
        tell event PortfolioInvestment.MilestoneUpdated(investmentId = updateMilestone.investmentId, milestoneId = updateMilestone.milestoneId, newStatus = updateMilestone.newStatus) to entity VCPortfolioContext.PortfolioInvestment
      }
      on assignBoardSeat: command PortfolioInvestment.AssignBoardSeat is {
        tell event PortfolioInvestment.BoardSeatAssigned(investmentId = assignBoardSeat.investmentId, boardSeat = assignBoardSeat.boardSeat) to entity VCPortfolioContext.PortfolioInvestment
      }
      on recordFollowOn: command PortfolioInvestment.RecordFollowOn is {
        tell event PortfolioInvestment.FollowOnRecorded(investmentId = recordFollowOn.investmentId, followOn = recordFollowOn.followOn) to entity VCPortfolioContext.PortfolioInvestment
      }
      on recordExit: command PortfolioInvestment.RecordExit is {
        tell event PortfolioInvestment.ExitRecorded(investmentId = recordExit.investmentId, exitInfo = recordExit.exitInfo) to entity VCPortfolioContext.PortfolioInvestment
      }
      on writeOff: command PortfolioInvestment.WriteOff is {
        tell event PortfolioInvestment.InvestmentWrittenOff(investmentId = writeOff.investmentId, reason = writeOff.reason) to entity VCPortfolioContext.PortfolioInvestment
      }
    } with {
      briefly "Persists portfolio commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Portfolio data persistence"
    described as {
      |Persistent storage for portfolio investments.
    }
  }
  query GetFundMetrics is  {
    fundMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which fund metrics to retrieve.
      }
    }
  } with {
    briefly "Get fund metrics"
    described as {
      |Retrieves the fund metrics projection.
    }
  }
  result FundMetricsView is  {
    fundMetrics: PortfolioAnalytics.FundMetrics with {
      briefly "Fund metrics"
      described as {
        |The fund metrics being returned.
      }
    }
  } with {
    briefly "Fund metrics view"
    described as {
      |Read model view carrying the fund metrics projection.
    }
  }
  projector PortfolioAnalytics as flow is {
    updates repository VCPortfolioContext.PortfolioRepository
    inlet PortfolioAnalyticsFromPortfolioInvestment is type PortfolioInvestmentEvent    outlet PortfolioAnalyticsOut is type PortfolioInvestmentEvent
    record FundMetrics is  {
      totalInvested: Decimal(14,2) with {
        briefly "Invested"
        described as {
          |Total capital invested.
        }
      }
      totalRealized: Decimal(14,2) with {
        briefly "Realized"
        described as {
          |Total realized returns.
        }
      }
      activeInvestments: Natural with {
        briefly "Active"
        described as {
          |Active investment count.
        }
      }
      exitedInvestments: Natural with {
        briefly "Exited"
        described as {
          |Exited investment count.
        }
      }
      writtenOffCount: Natural with {
        briefly "Written off"
        described as {
          |Written-off investment count.
        }
      }
      averageMOIC: Decimal(6,2) with {
        briefly "Avg MOIC"
        described as {
          |Average multiple on invested capital.
        }
      }
    } with {
      briefly "Fund metrics"
      described as {
        |Fund-level performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on investmentRecorded: event PortfolioInvestment.InvestmentRecorded is {
        tell investmentRecorded to repository VCPortfolioContext.PortfolioRepository
      }
      on followOnRecorded: event PortfolioInvestment.FollowOnRecorded is {
        tell followOnRecorded to repository VCPortfolioContext.PortfolioRepository
      }
      on exitRecorded: event PortfolioInvestment.ExitRecorded is {
        tell exitRecorded to repository VCPortfolioContext.PortfolioRepository
      }
      on investmentWrittenOff: event PortfolioInvestment.InvestmentWrittenOff is {
        tell investmentWrittenOff to repository VCPortfolioContext.PortfolioRepository
      }
      on investmentMarkedDown: event PortfolioInvestment.InvestmentMarkedDown is {
        tell investmentMarkedDown to repository VCPortfolioContext.PortfolioRepository
      }
    } with {
      briefly "Maintains portfolio analytics"
      described as {
        |Projects events into fund metrics.
      }
    }
  } with {
    briefly "Portfolio analytics"
    described as {
      |Fund-level portfolio performance analytics.
    }
  }
  processor PortfolioInvestmentSource as source is {
    outlet PortfolioInvestmentEvents is type PortfolioInvestmentEvent
    handler PortfolioInvestmentSourceHandler is {
      on init is {
        tell command PortfolioInvestment.InitializePortfolioInvestment to entity VCPortfolioContext.PortfolioInvestment
      }
      on other is {
        error "Unexpected message for source PortfolioInvestmentSource"
      }
      on investmentRecorded: event PortfolioInvestment.InvestmentRecorded is {
        send investmentRecorded to outlet PortfolioInvestmentEvents
      }
      on exitRecorded: event PortfolioInvestment.ExitRecorded is {
        send exitRecorded to outlet PortfolioInvestmentEvents
      }
      on investmentWrittenOff: event PortfolioInvestment.InvestmentWrittenOff is {
        send investmentWrittenOff to outlet PortfolioInvestmentEvents
      }
    } with {
      briefly "Portfolio investment source handler"
      described as {
        |Handles portfolio investment events and sends to outlet.
      }
    }
  } with {
    briefly "Portfolio investment event source"
    described as {
      |Publishes portfolio investment entity events.
    }
  }
  processor PortfolioInvestmentSink as sink is {
    inlet PortfolioInvestmentInlet is type PortfolioInvestmentEvent    handler PortfolioInvestmentSinkHandler is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink PortfolioInvestmentSink"
      }
      on investmentRecorded: event PortfolioInvestment.InvestmentRecorded is {
        tell investmentRecorded to repository VCPortfolioContext.PortfolioRepository
      }
      on exitRecorded: event PortfolioInvestment.ExitRecorded is {
        tell exitRecorded to repository VCPortfolioContext.PortfolioRepository
      }
    } with {
      briefly "Portfolio investment sink handler"
      described as {
        |Receives portfolio investment events and persists them.
      }
    }
  } with {
    briefly "Portfolio investment event sink"
    described as {
      |Receives portfolio investment events for persistence.
    }
  }
  connector PortfolioInvestmentFlow is from outlet VCPortfolioContext.PortfolioInvestmentSource.PortfolioInvestmentEvents to inlet VCPortfolioContext.PortfolioInvestmentSink.PortfolioInvestmentInlet with {
    briefly "Portfolio investment event flow"
    described as {
      |Connects portfolio investment source to sink.
    }
  }
  processor PortfolioInvestmentEventSplit as split is {
    inlet PortfolioInvestmentEventSplitIn is type PortfolioInvestmentEvent    outlet PortfolioInvestmentEventSplitToPortfolioRepository is type PortfolioInvestmentEvent
    outlet PortfolioInvestmentEventSplitToPortfolioAnalytics is type PortfolioInvestmentEvent
    handler PortfolioInvestmentEventSplitHandler is {
      on investmentRecorded: event PortfolioInvestment.InvestmentRecorded is {
        send investmentRecorded to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send investmentRecorded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell investmentRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on dueDiligenceAdvanced: event PortfolioInvestment.DueDiligenceAdvanced is {
        send dueDiligenceAdvanced to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send dueDiligenceAdvanced to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell dueDiligenceAdvanced to entity VCPortfolioContext.PortfolioInvestment
      }
      on milestoneAdded: event PortfolioInvestment.MilestoneAdded is {
        send milestoneAdded to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send milestoneAdded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell milestoneAdded to entity VCPortfolioContext.PortfolioInvestment
      }
      on milestoneUpdated: event PortfolioInvestment.MilestoneUpdated is {
        send milestoneUpdated to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send milestoneUpdated to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell milestoneUpdated to entity VCPortfolioContext.PortfolioInvestment
      }
      on boardSeatAssigned: event PortfolioInvestment.BoardSeatAssigned is {
        send boardSeatAssigned to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send boardSeatAssigned to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell boardSeatAssigned to entity VCPortfolioContext.PortfolioInvestment
      }
      on boardSeatRemoved: event PortfolioInvestment.BoardSeatRemoved is {
        send boardSeatRemoved to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send boardSeatRemoved to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell boardSeatRemoved to entity VCPortfolioContext.PortfolioInvestment
      }
      on followOnRecorded: event PortfolioInvestment.FollowOnRecorded is {
        send followOnRecorded to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send followOnRecorded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell followOnRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on followOnDeclined: event PortfolioInvestment.FollowOnDeclined is {
        send followOnDeclined to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send followOnDeclined to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell followOnDeclined to entity VCPortfolioContext.PortfolioInvestment
      }
      on metricRecorded: event PortfolioInvestment.MetricRecorded is {
        send metricRecorded to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send metricRecorded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell metricRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on investmentMarkedDown: event PortfolioInvestment.InvestmentMarkedDown is {
        send investmentMarkedDown to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send investmentMarkedDown to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell investmentMarkedDown to entity VCPortfolioContext.PortfolioInvestment
      }
      on exitRecorded: event PortfolioInvestment.ExitRecorded is {
        send exitRecorded to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send exitRecorded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell exitRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on investmentWrittenOff: event PortfolioInvestment.InvestmentWrittenOff is {
        send investmentWrittenOff to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send investmentWrittenOff to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell investmentWrittenOff to entity VCPortfolioContext.PortfolioInvestment
      }
      on other is {
        error "Unexpected message for processor PortfolioInvestmentEventSplit"
      }
    } with {
      briefly "PortfolioInvestment event fan-out handler"
      described as {
        |Delivers each PortfolioInvestment event to all of its consumers.
      }
    }
  } with {
    briefly "PortfolioInvestment event fan-out"
    described as {
      |Fans PortfolioInvestment events out to the repository and projectors.
    }
  }
  connector 'PortfolioInvestmentEvent Stream' is from outlet VCPortfolioContext.PortfolioInvestment.PortfolioInvestmentEvents2 to inlet VCPortfolioContext.PortfolioInvestmentEventSplit.PortfolioInvestmentEventSplitIn with {
    briefly "PortfolioInvestment events, fanned out to storage and read models"
  }
  connector 'PortfolioInvestmentEvent Storage' is from outlet VCPortfolioContext.PortfolioInvestmentEventSplit.PortfolioInvestmentEventSplitToPortfolioRepository to inlet VCPortfolioContext.PortfolioRepository.PortfolioRepositoryFromPortfolioInvestment with {
    briefly "PortfolioInvestment events on their way to storage"
  }
  connector 'PortfolioAnalytics Feed' is from outlet VCPortfolioContext.PortfolioInvestmentEventSplit.PortfolioInvestmentEventSplitToPortfolioAnalytics to inlet VCPortfolioContext.PortfolioAnalytics.PortfolioAnalyticsFromPortfolioInvestment with {
    briefly "PortfolioInvestment events feeding the PortfolioAnalytics projection"
  }
  connector 'PortfolioAnalytics Storage' is from outlet VCPortfolioContext.PortfolioAnalytics.PortfolioAnalyticsOut to inlet VCPortfolioContext.PortfolioRepository.PortfolioRepositoryFromPortfolioAnalytics with {
    briefly "The PortfolioAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for VC portfolio management"
  described as {
    |Venture capital portfolio management context.
  }
}
