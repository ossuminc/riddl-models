// Portfolio Management - VC Portfolio Context
context VCPortfolioContext as router is {
  inlet VCPortfolioContextFromToLegalSystem is command PortfolioInvestment.AddMilestone with {
    briefly "What ToLegalSystem makes of the answers it gets"
  }
  connector 'ToLegalSystem Intake' is from outlet VCPortfolioContext.ToLegalSystem.ToLegalSystemToVCPortfolioContext to inlet VCPortfolioContext.VCPortfolioContextFromToLegalSystem with {
    briefly "Answers translated by ToLegalSystem, on their way in"
  }
  type ToMarketIntelligenceCommand is one of {
    PortfolioInvestment.MarkDown or PortfolioInvestment.RecordMetric
  } with {
    briefly "What ToMarketIntelligence turns its answers into"
  }
  inlet VCPortfolioContextFromToMarketIntelligence is type ToMarketIntelligenceCommand with {
    briefly "What ToMarketIntelligence makes of the answers it gets"
  }
  connector 'ToMarketIntelligence Intake' is from outlet VCPortfolioContext.ToMarketIntelligence.ToMarketIntelligenceToVCPortfolioContext to inlet VCPortfolioContext.VCPortfolioContextFromToMarketIntelligence with {
    briefly "Answers translated by ToMarketIntelligence, on their way in"
  }
  inlet PortfolioInvestmentCommandStIn is type PortfolioInvestmentCommand  outlet PortfolioInvestmentCommandStOut is type PortfolioInvestmentCommand
  inlet PortfolioCompanyResultStreamIn is result PortfolioInvestment.PortfolioInvestmentResult  outlet PortfolioCompanyResultStreamOut is result PortfolioInvestment.PortfolioInvestmentResult
  handler VCPortfolioContextBoundary is {
    on recordInvestment: command PortfolioInvestment.RecordInvestment is {
      send recordInvestment to outlet VCPortfolioContext.PortfolioInvestmentCommandStOut
    }
    on advanceDueDiligence: command PortfolioInvestment.AdvanceDueDiligence is {
      send advanceDueDiligence to outlet VCPortfolioContext.PortfolioInvestmentCommandStOut
    }
    on addMilestone: command PortfolioInvestment.AddMilestone is {
      send addMilestone to outlet VCPortfolioContext.PortfolioInvestmentCommandStOut
    }
    on updateMilestone: command PortfolioInvestment.UpdateMilestone is {
      send updateMilestone to outlet VCPortfolioContext.PortfolioInvestmentCommandStOut
    }
    on assignBoardSeat: command PortfolioInvestment.AssignBoardSeat is {
      send assignBoardSeat to outlet VCPortfolioContext.PortfolioInvestmentCommandStOut
    }
    on removeBoardSeat: command PortfolioInvestment.RemoveBoardSeat is {
      send removeBoardSeat to outlet VCPortfolioContext.PortfolioInvestmentCommandStOut
    }
    on recordFollowOn: command PortfolioInvestment.RecordFollowOn is {
      send recordFollowOn to outlet VCPortfolioContext.PortfolioInvestmentCommandStOut
    }
    on declineFollowOn: command PortfolioInvestment.DeclineFollowOn is {
      send declineFollowOn to outlet VCPortfolioContext.PortfolioInvestmentCommandStOut
    }
    on recordMetric: command PortfolioInvestment.RecordMetric is {
      send recordMetric to outlet VCPortfolioContext.PortfolioInvestmentCommandStOut
    }
    on markDown: command PortfolioInvestment.MarkDown is {
      send markDown to outlet VCPortfolioContext.PortfolioInvestmentCommandStOut
    }
    on recordExit: command PortfolioInvestment.RecordExit is {
      send recordExit to outlet VCPortfolioContext.PortfolioInvestmentCommandStOut
    }
    on writeOff: command PortfolioInvestment.WriteOff is {
      send writeOff to outlet VCPortfolioContext.PortfolioInvestmentCommandStOut
    }
    on portfolioInvestmentResult: result PortfolioInvestment.PortfolioInvestmentResult is {
      send portfolioInvestmentResult to outlet VCPortfolioContext.PortfolioCompanyResultStreamOut
    }
    on other is {
      error "Unexpected message at the VCPortfolioContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PortfolioInvestmentCommand Stream Intake' is from outlet VCPortfolioContext.PortfolioInvestmentCommandStOut to inlet VCPortfolioContext.PortfolioInvestment.PortfolioInvestmentCommands  connector 'PortfolioCompanyResult Stream Egress' is from outlet VCPortfolioContext.PortfolioRepository.PortfolioRepositoryResponses to inlet VCPortfolioContext.PortfolioCompanyResultStreamIn  adaptor FromLegalSystem from context LegalSystem as sink is { 
    inlet FromLegalSystemIn is type LegalSystem.LegalSystemEvent    handler FromLegalSystemHandler is {
      on regulatoryReportFiled: event LegalSystem.RegulatoryReportFiled is {
        do "the report is filed; recording the investment came first"
      }
      on termSheetReviewed: event LegalSystem.TermSheetReviewed is {
        do "legal has reviewed the term sheet; advancing diligence is the partner's call"
      }
      on other is {
        error "Unexpected message for adaptor FromLegalSystem"
      }
    } with {
      briefly "from legal system"
      described as {
        |Carries messages from the external LegalSystem.
      }
    }
  } with {
    briefly "LegalSystem integration"
    described as {
      |The model's side of the LegalSystem conversation.
    }
  }
  adaptor ToLegalSystem to context LegalSystem as router is { 
    outlet ToLegalSystemToVCPortfolioContext is command PortfolioInvestment.AddMilestone
    inlet ToLegalSystemIn is type PortfolioInvestmentEvent    inlet ToLegalSystemReplies is result LegalSystem.ComplianceStatus    outlet ToLegalSystemOut is type LegalSystem.LegalSystemRequest
    handler ToLegalSystemHandler is {
      on boardSeatAssigned: event PortfolioInvestment.BoardSeatAssigned is {
        let askAnswer: type LegalSystem.ComplianceStatus = ask query LegalSystem.GetComplianceStatus of context LegalSystem
        do "a board seat needing the company's standing behind it"
        when prompt("not askAnswer.isCompliant") then
          send command PortfolioInvestment.AddMilestone(investmentId = boardSeatAssigned.investmentId, milestone = prompt("a milestone to clear askAnswer.pendingFilings")) to outlet VCPortfolioContext.ToLegalSystem.ToLegalSystemToVCPortfolioContext
        end
      }
      on investmentRecorded: event PortfolioInvestment.InvestmentRecorded is {
        let item0: type LegalSystem.FileRegulatoryReport = prompt("translate the investmentRecorded event into a FileRegulatoryReport, a new position being the reportable fact")
        send item0 to outlet VCPortfolioContext.ToLegalSystem.ToLegalSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToLegalSystem"
      }
    } with {
      briefly "to legal system"
      described as {
        |Carries messages to the external LegalSystem.
      }
    }
  } with {
    briefly "LegalSystem integration"
    described as {
      |The model's side of the LegalSystem conversation.
    }
  }
  adaptor ToMarketIntelligence to context MarketIntelligence as router is { 
    outlet ToMarketIntelligenceToVCPortfolioContext is type ToMarketIntelligenceCommand
    inlet ToMarketIntelligenceIn is type PortfolioInvestmentEvent    inlet ToMarketIntelligenceReplies is type MarketIntelligence.MarketIntelligenceReply    outlet ToMarketIntelligenceOut is type MarketIntelligence.MarketIntelligenceRequest
    handler ToMarketIntelligenceHandler is {
      on investmentMarkedDown: event PortfolioInvestment.InvestmentMarkedDown is {
        let askAnswer: type MarketIntelligence.CompanyValuation = ask query MarketIntelligence.GetCompanyValuation of context MarketIntelligence
        do "a markdown needing an outside valuation to justify it"
        when prompt("askAnswer.estimatedValuation differs from investmentMarkedDown.newValuation") then
          send command PortfolioInvestment.MarkDown(investmentId = investmentMarkedDown.investmentId, newValuation = askAnswer.estimatedValuation, reason = prompt("market intelligence values it at askAnswer.estimatedValuation with askAnswer.confidenceLevel confidence")) to outlet VCPortfolioContext.ToMarketIntelligence.ToMarketIntelligenceToVCPortfolioContext
        end
      }
      on metricRecorded: event PortfolioInvestment.MetricRecorded is {
        let askAnswer: type MarketIntelligence.MarketTrends = ask query MarketIntelligence.GetMarketTrends of context MarketIntelligence
        do "a recorded metric needing the trend it should be read against"
        send command PortfolioInvestment.RecordMetric(investmentId = metricRecorded.investmentId, metric = prompt("the metric read against askAnswer.trendDirection in askAnswer.sector")) to outlet VCPortfolioContext.ToMarketIntelligence.ToMarketIntelligenceToVCPortfolioContext
      }
      on other is {
        error "Unexpected message for adaptor ToMarketIntelligence"
      }
    } with {
      briefly "to market intelligence"
      described as {
        |Carries messages to the external MarketIntelligence.
      }
    }
  } with {
    briefly "MarketIntelligence integration"
    described as {
      |The model's side of the MarketIntelligence conversation.
    }
  }
  include "types.riddl"
  include "PortfolioInvestment.riddl"
  type PortfolioRepositoryCommand is one of {
    VCPortfolioContext.PortfolioRepository.PersistBoardSeatAssigned or VCPortfolioContext.PortfolioRepository.PersistBoardSeatRemoved or VCPortfolioContext.PortfolioRepository.PersistDueDiligenceAdvanced or VCPortfolioContext.PortfolioRepository.PersistExitRecorded or VCPortfolioContext.PortfolioRepository.PersistFollowOnDeclined or VCPortfolioContext.PortfolioRepository.PersistFollowOnRecorded or VCPortfolioContext.PortfolioRepository.PersistInvestmentMarkedDown or VCPortfolioContext.PortfolioRepository.PersistInvestmentRecorded or VCPortfolioContext.PortfolioRepository.PersistInvestmentWrittenOff or VCPortfolioContext.PortfolioRepository.PersistMetricRecorded or VCPortfolioContext.PortfolioRepository.PersistMilestoneAdded or VCPortfolioContext.PortfolioRepository.PersistMilestoneUpdated
  } with {
    briefly "Anything that writes PortfolioRepository"
    described as {
      |The persistence commands PortfolioRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository PortfolioRepository as flow is {
    inlet PortfolioRepositoryFromPortfolioAnalytics is type PortfolioRepositoryCommand    command PersistBoardSeatAssigned is {
      investmentId: InvestmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row BoardSeatAssigned applies to.
        }
      }
      boardSeat: BoardSeatInfo? with {
        briefly "Board seat"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist BoardSeatAssigned"
      described as {
        |Instructs this repository to apply BoardSeatAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBoardSeatRemoved is {
      investmentId: InvestmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row BoardSeatRemoved applies to.
        }
      }
      seatId: BoardSeatId? with {
        briefly "Seat id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist BoardSeatRemoved"
      described as {
        |Instructs this repository to apply BoardSeatRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDueDiligenceAdvanced is {
      investmentId: InvestmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DueDiligenceAdvanced applies to.
        }
      }
      findings: String(3,2000)? with {
        briefly "Findings"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      advancedAt: TimeStamp? with {
        briefly "Advanced at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DueDiligenceAdvanced"
      described as {
        |Instructs this repository to apply DueDiligenceAdvanced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFollowOnDeclined is {
      investmentId: InvestmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row FollowOnDeclined applies to.
        }
      }
      roundStage: InvestmentStage? with {
        briefly "Round stage"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String(3,1000)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      declinedAt: TimeStamp? with {
        briefly "Declined at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist FollowOnDeclined"
      described as {
        |Instructs this repository to apply FollowOnDeclined to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMetricRecorded is {
      investmentId: InvestmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row MetricRecorded applies to.
        }
      }
      metric: PortfolioMetric? with {
        briefly "Metric"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MetricRecorded"
      described as {
        |Instructs this repository to apply MetricRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMilestoneAdded is {
      investmentId: InvestmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row MilestoneAdded applies to.
        }
      }
      milestone: MilestoneInfo? with {
        briefly "Milestone"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MilestoneAdded"
      described as {
        |Instructs this repository to apply MilestoneAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMilestoneUpdated is {
      investmentId: InvestmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row MilestoneUpdated applies to.
        }
      }
      milestoneId: MilestoneId? with {
        briefly "Milestone id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newStatus: MilestoneStatus? with {
        briefly "New status"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MilestoneUpdated"
      described as {
        |Instructs this repository to apply MilestoneUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExitRecorded is {
      investmentId: InvestmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExitRecorded applies to.
        }
      }
      exitInfo: ExitDetails? with {
        briefly "Exit info"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ExitRecorded"
      described as {
        |Instructs this repository to apply ExitRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFollowOnRecorded is {
      investmentId: InvestmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row FollowOnRecorded applies to.
        }
      }
      followOn: FollowOnRound? with {
        briefly "Follow on"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist FollowOnRecorded"
      described as {
        |Instructs this repository to apply FollowOnRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInvestmentMarkedDown is {
      investmentId: InvestmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row InvestmentMarkedDown applies to.
        }
      }
      newValuation: Decimal(14,2)? with {
        briefly "New valuation"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      markedDownAt: TimeStamp? with {
        briefly "Marked down at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist InvestmentMarkedDown"
      described as {
        |Instructs this repository to apply InvestmentMarkedDown to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInvestmentRecorded is {
      investmentId: InvestmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row InvestmentRecorded applies to.
        }
      }
      companyInfo: CompanyInfo? with {
        briefly "Company info"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      terms: InvestmentTerms? with {
        briefly "Terms"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist InvestmentRecorded"
      described as {
        |Instructs this repository to apply InvestmentRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInvestmentWrittenOff is {
      investmentId: InvestmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row InvestmentWrittenOff applies to.
        }
      }
      reason: String(3,1000)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      writtenOffAt: TimeStamp? with {
        briefly "Written off at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist InvestmentWrittenOff"
      described as {
        |Instructs this repository to apply InvestmentWrittenOff to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet PortfolioRepositoryResponses is result PortfolioInvestment.PortfolioInvestmentResult
    record StoredPortfolioInvestment is {
      portfolioInvestmentId: UUID with {
        briefly "portfolioInvestmentId"
        described as {
          |The portfolioInvestmentId column of the stored portfolioInvestment row.
        }
      }
      companyInfo: CompanyInfo with {
        briefly "companyInfo"
        described as {
          |The companyInfo column of the stored portfolioInvestment row.
        }
      }
      investmentId: InvestmentId with {
        briefly "investmentId"
        described as {
          |The investmentId column of the stored portfolioInvestment row.
        }
      }
      boardSeat: BoardSeatInfo? with {
        briefly "Board seat"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      seatId: BoardSeatId? with {
        briefly "Seat id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      findings: String(3,2000)? with {
        briefly "Findings"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      advancedAt: TimeStamp? with {
        briefly "Advanced at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      roundStage: InvestmentStage? with {
        briefly "Round stage"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(3,1000)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      declinedAt: TimeStamp? with {
        briefly "Declined at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      metric: PortfolioMetric? with {
        briefly "Metric"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      milestone: MilestoneInfo? with {
        briefly "Milestone"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      milestoneId: MilestoneId? with {
        briefly "Milestone id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newStatus: MilestoneStatus? with {
        briefly "New status"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      exitInfo: ExitDetails? with {
        briefly "Exit info"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      followOn: FollowOnRound? with {
        briefly "Follow on"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newValuation: Decimal(14,2)? with {
        briefly "New valuation"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      markedDownAt: TimeStamp? with {
        briefly "Marked down at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      terms: InvestmentTerms? with {
        briefly "Terms"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      writtenOffAt: TimeStamp? with {
        briefly "Written off at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored portfolioInvestment row"
      described as {
        |The persistence shape of portfolioInvestment data as this repository stores it.
      }
    }
    schema PortfolioData is relational
      of portfolioInvestments as record StoredPortfolioInvestment
        key on field StoredPortfolioInvestment.portfolioInvestmentId
        index on field StoredPortfolioInvestment.investmentId
        index on field StoredPortfolioInvestment.companyInfo.companyId
        index on field StoredPortfolioInvestment.status
 with {
      briefly "Portfolio data schema"
      described as {
        |The relational schema holding portfolio data for the PortfolioRepository.
      }
    }
    handler PortfolioPersistence is {
      on persistBoardSeatAssigned: command PersistBoardSeatAssigned is {
        do "apply BoardSeatAssigned to the stored row"
      }
      on persistBoardSeatRemoved: command PersistBoardSeatRemoved is {
        do "apply BoardSeatRemoved to the stored row"
      }
      on persistDueDiligenceAdvanced: command PersistDueDiligenceAdvanced is {
        do "apply DueDiligenceAdvanced to the stored row"
      }
      on persistFollowOnDeclined: command PersistFollowOnDeclined is {
        do "apply FollowOnDeclined to the stored row"
      }
      on persistMetricRecorded: command PersistMetricRecorded is {
        do "apply MetricRecorded to the stored row"
      }
      on persistMilestoneAdded: command PersistMilestoneAdded is {
        do "apply MilestoneAdded to the stored row"
      }
      on persistMilestoneUpdated: command PersistMilestoneUpdated is {
        do "apply MilestoneUpdated to the stored row"
      }
      on persistExitRecorded: command PersistExitRecorded is {
        do "apply ExitRecorded to the stored row"
      }
      on persistFollowOnRecorded: command PersistFollowOnRecorded is {
        do "apply FollowOnRecorded to the stored row"
      }
      on persistInvestmentMarkedDown: command PersistInvestmentMarkedDown is {
        do "apply InvestmentMarkedDown to the stored row"
      }
      on persistInvestmentRecorded: command PersistInvestmentRecorded is {
        do "apply InvestmentRecorded to the stored row"
      }
      on persistInvestmentWrittenOff: command PersistInvestmentWrittenOff is {
        do "apply InvestmentWrittenOff to the stored row"
      }
      on query GetFundMetrics is {
        let fundMetricsView: type FundMetricsView = prompt("read the fund metrics projection")
        reply fundMetricsView
      }
    } with {
      briefly "Persists portfolio commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Portfolio data persistence"
    described as {
      |Persistent storage for portfolio investments.
    }
  }
  query GetFundMetrics replies result FundMetricsView is {
    fundMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which fund metrics to retrieve.
      }
    }
  } with {
    briefly "Get fund metrics"
    described as {
      |Retrieves the fund metrics projection.
    }
  }
  result FundMetricsView is {
    fundMetrics: PortfolioAnalytics.FundMetrics with {
      briefly "Fund metrics"
      described as {
        |The fund metrics being returned.
      }
    }
  } with {
    briefly "Fund metrics view"
    described as {
      |Read model view carrying the fund metrics projection.
    }
  }
  projector PortfolioAnalytics as flow is {
    updates repository VCPortfolioContext.PortfolioRepository
    outlet PortfolioAnalyticsToRepository is type PortfolioRepositoryCommand
    inlet PortfolioAnalyticsFromPortfolioInvestment is type PortfolioInvestmentEvent    record FundMetrics is {
      totalInvested: Decimal(14,2) with {
        briefly "Invested"
        described as {
          |Total capital invested.
        }
      }
      totalRealized: Decimal(14,2) with {
        briefly "Realized"
        described as {
          |Total realized returns.
        }
      }
      activeInvestments: Natural with {
        briefly "Active"
        described as {
          |Active investment count.
        }
      }
      exitedInvestments: Natural with {
        briefly "Exited"
        described as {
          |Exited investment count.
        }
      }
      writtenOffCount: Natural with {
        briefly "Written off"
        described as {
          |Written-off investment count.
        }
      }
      averageMOIC: Decimal(6,2) with {
        briefly "Avg MOIC"
        described as {
          |Average multiple on invested capital.
        }
      }
    } with {
      briefly "Fund metrics"
      described as {
        |Fund-level performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on boardSeatAssigned: event PortfolioInvestment.BoardSeatAssigned is {
        tell command VCPortfolioContext.PortfolioRepository.PersistBoardSeatAssigned(investmentId = boardSeatAssigned.investmentId, boardSeat = boardSeatAssigned.boardSeat, assignedAt = boardSeatAssigned.assignedAt) to repository VCPortfolioContext.PortfolioRepository
        do "apply BoardSeatAssigned to the PortfolioAnalytics projection"
      }
      on boardSeatRemoved: event PortfolioInvestment.BoardSeatRemoved is {
        tell command VCPortfolioContext.PortfolioRepository.PersistBoardSeatRemoved(investmentId = boardSeatRemoved.investmentId, seatId = boardSeatRemoved.seatId, removedAt = boardSeatRemoved.removedAt) to repository VCPortfolioContext.PortfolioRepository
        do "apply BoardSeatRemoved to the PortfolioAnalytics projection"
      }
      on dueDiligenceAdvanced: event PortfolioInvestment.DueDiligenceAdvanced is {
        tell command VCPortfolioContext.PortfolioRepository.PersistDueDiligenceAdvanced(investmentId = dueDiligenceAdvanced.investmentId, findings = dueDiligenceAdvanced.findings, advancedAt = dueDiligenceAdvanced.advancedAt) to repository VCPortfolioContext.PortfolioRepository
        do "apply DueDiligenceAdvanced to the PortfolioAnalytics projection"
      }
      on followOnDeclined: event PortfolioInvestment.FollowOnDeclined is {
        tell command VCPortfolioContext.PortfolioRepository.PersistFollowOnDeclined(investmentId = followOnDeclined.investmentId, roundStage = followOnDeclined.roundStage, reason = followOnDeclined.reason, declinedAt = followOnDeclined.declinedAt) to repository VCPortfolioContext.PortfolioRepository
        do "apply FollowOnDeclined to the PortfolioAnalytics projection"
      }
      on metricRecorded: event PortfolioInvestment.MetricRecorded is {
        tell command VCPortfolioContext.PortfolioRepository.PersistMetricRecorded(investmentId = metricRecorded.investmentId, metric = metricRecorded.metric, recordedAt = metricRecorded.recordedAt) to repository VCPortfolioContext.PortfolioRepository
        do "apply MetricRecorded to the PortfolioAnalytics projection"
      }
      on milestoneAdded: event PortfolioInvestment.MilestoneAdded is {
        tell command VCPortfolioContext.PortfolioRepository.PersistMilestoneAdded(investmentId = milestoneAdded.investmentId, milestone = milestoneAdded.milestone, addedAt = milestoneAdded.addedAt) to repository VCPortfolioContext.PortfolioRepository
        do "apply MilestoneAdded to the PortfolioAnalytics projection"
      }
      on milestoneUpdated: event PortfolioInvestment.MilestoneUpdated is {
        tell command VCPortfolioContext.PortfolioRepository.PersistMilestoneUpdated(investmentId = milestoneUpdated.investmentId, milestoneId = milestoneUpdated.milestoneId, newStatus = milestoneUpdated.newStatus, updatedAt = milestoneUpdated.updatedAt) to repository VCPortfolioContext.PortfolioRepository
        do "apply MilestoneUpdated to the PortfolioAnalytics projection"
      }
      on investmentRecorded: event PortfolioInvestment.InvestmentRecorded is {
        tell command VCPortfolioContext.PortfolioRepository.PersistInvestmentRecorded(investmentId = investmentRecorded.investmentId, companyInfo = investmentRecorded.companyInfo, terms = investmentRecorded.terms, recordedAt = investmentRecorded.recordedAt) to repository VCPortfolioContext.PortfolioRepository
      }
      on followOnRecorded: event PortfolioInvestment.FollowOnRecorded is {
        tell command VCPortfolioContext.PortfolioRepository.PersistFollowOnRecorded(investmentId = followOnRecorded.investmentId, followOn = followOnRecorded.followOn, recordedAt = followOnRecorded.recordedAt) to repository VCPortfolioContext.PortfolioRepository
      }
      on exitRecorded: event PortfolioInvestment.ExitRecorded is {
        tell command VCPortfolioContext.PortfolioRepository.PersistExitRecorded(investmentId = exitRecorded.investmentId, exitInfo = exitRecorded.exitInfo, recordedAt = exitRecorded.recordedAt) to repository VCPortfolioContext.PortfolioRepository
      }
      on investmentWrittenOff: event PortfolioInvestment.InvestmentWrittenOff is {
        tell command VCPortfolioContext.PortfolioRepository.PersistInvestmentWrittenOff(investmentId = investmentWrittenOff.investmentId, reason = investmentWrittenOff.reason, writtenOffAt = investmentWrittenOff.writtenOffAt) to repository VCPortfolioContext.PortfolioRepository
      }
      on investmentMarkedDown: event PortfolioInvestment.InvestmentMarkedDown is {
        tell command VCPortfolioContext.PortfolioRepository.PersistInvestmentMarkedDown(investmentId = investmentMarkedDown.investmentId, newValuation = investmentMarkedDown.newValuation, markedDownAt = investmentMarkedDown.markedDownAt) to repository VCPortfolioContext.PortfolioRepository
      }
    } with {
      briefly "Maintains portfolio analytics"
      described as {
        |Projects events into fund metrics.
      }
    }
  } with {
    briefly "Portfolio analytics"
    described as {
      |Fund-level portfolio performance analytics.
    }
  }
  streamlet PortfolioInvestmentEventSplit as split is {
    outlet PortfolioInvestmentEventSplitToToMarketIntelligence is type PortfolioInvestmentEvent
    outlet PortfolioInvestmentEventSplitToToLegalSystem is type PortfolioInvestmentEvent
    inlet PortfolioInvestmentEventSplitIn is type PortfolioInvestmentEvent    outlet PortfolioInvestmentEventSplitToPortfolioAnalytics is type PortfolioInvestmentEvent
    handler PortfolioInvestmentEventSplitHandler is {
      on investmentRecorded: event PortfolioInvestment.InvestmentRecorded is {
        send investmentRecorded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        send investmentRecorded to outlet PortfolioInvestmentEventSplitToToLegalSystem
        tell investmentRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on dueDiligenceAdvanced: event PortfolioInvestment.DueDiligenceAdvanced is {
        send dueDiligenceAdvanced to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell dueDiligenceAdvanced to entity VCPortfolioContext.PortfolioInvestment
      }
      on milestoneAdded: event PortfolioInvestment.MilestoneAdded is {
        send milestoneAdded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell milestoneAdded to entity VCPortfolioContext.PortfolioInvestment
      }
      on milestoneUpdated: event PortfolioInvestment.MilestoneUpdated is {
        send milestoneUpdated to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell milestoneUpdated to entity VCPortfolioContext.PortfolioInvestment
      }
      on boardSeatAssigned: event PortfolioInvestment.BoardSeatAssigned is {
        send boardSeatAssigned to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        send boardSeatAssigned to outlet PortfolioInvestmentEventSplitToToLegalSystem
        tell boardSeatAssigned to entity VCPortfolioContext.PortfolioInvestment
      }
      on boardSeatRemoved: event PortfolioInvestment.BoardSeatRemoved is {
        send boardSeatRemoved to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell boardSeatRemoved to entity VCPortfolioContext.PortfolioInvestment
      }
      on followOnRecorded: event PortfolioInvestment.FollowOnRecorded is {
        send followOnRecorded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell followOnRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on followOnDeclined: event PortfolioInvestment.FollowOnDeclined is {
        send followOnDeclined to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell followOnDeclined to entity VCPortfolioContext.PortfolioInvestment
      }
      on metricRecorded: event PortfolioInvestment.MetricRecorded is {
        send metricRecorded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        send metricRecorded to outlet PortfolioInvestmentEventSplitToToMarketIntelligence
        tell metricRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on investmentMarkedDown: event PortfolioInvestment.InvestmentMarkedDown is {
        send investmentMarkedDown to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        send investmentMarkedDown to outlet PortfolioInvestmentEventSplitToToMarketIntelligence
        tell investmentMarkedDown to entity VCPortfolioContext.PortfolioInvestment
      }
      on exitRecorded: event PortfolioInvestment.ExitRecorded is {
        send exitRecorded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell exitRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on investmentWrittenOff: event PortfolioInvestment.InvestmentWrittenOff is {
        send investmentWrittenOff to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell investmentWrittenOff to entity VCPortfolioContext.PortfolioInvestment
      }
      on other is {
        error "Unexpected message for processor PortfolioInvestmentEventSplit"
      }
    } with {
      briefly "PortfolioInvestment event fan-out handler"
      described as {
        |Delivers each PortfolioInvestment event to all of its consumers.
      }
    }
  } with {
    briefly "PortfolioInvestment event fan-out"
    described as {
      |Fans PortfolioInvestment events out to the repository and projectors.
    }
  }
  connector 'ToMarketIntelligence Feed' is from outlet VCPortfolioContext.PortfolioInvestmentEventSplit.PortfolioInvestmentEventSplitToToMarketIntelligence to inlet VCPortfolioContext.ToMarketIntelligence.ToMarketIntelligenceIn with {
    briefly "The PortfolioInvestment events ToMarketIntelligence translates, on their way to it"
  }
  connector 'ToLegalSystem Feed' is from outlet VCPortfolioContext.PortfolioInvestmentEventSplit.PortfolioInvestmentEventSplitToToLegalSystem to inlet VCPortfolioContext.ToLegalSystem.ToLegalSystemIn with {
    briefly "The PortfolioInvestment events ToLegalSystem translates, on their way to it"
  }
  connector 'PortfolioInvestmentEvent Stream' is from outlet VCPortfolioContext.PortfolioInvestment.PortfolioInvestmentEvents2 to inlet VCPortfolioContext.PortfolioInvestmentEventSplit.PortfolioInvestmentEventSplitIn with {
    briefly "PortfolioInvestment events, fanned out to storage and read models"
  }
  connector 'PortfolioAnalytics Feed' is from outlet VCPortfolioContext.PortfolioInvestmentEventSplit.PortfolioInvestmentEventSplitToPortfolioAnalytics to inlet VCPortfolioContext.PortfolioAnalytics.PortfolioAnalyticsFromPortfolioInvestment with {
    briefly "PortfolioInvestment events feeding the PortfolioAnalytics projection"
  }
  connector 'PortfolioAnalytics Storage' is from outlet VCPortfolioContext.PortfolioAnalytics.PortfolioAnalyticsToRepository to inlet VCPortfolioContext.PortfolioRepository.PortfolioRepositoryFromPortfolioAnalytics with {
    briefly "PortfolioAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for VC portfolio management"
  described as {
    |Venture capital portfolio management context.
  }
}
