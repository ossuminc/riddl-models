// Portfolio Management - VC Portfolio Context
context VCPortfolioContext is {
  include "types.riddl"
  include "PortfolioInvestment.riddl"
  repository PortfolioRepository is {
    inlet PortfolioRepositoryFromPortfolioInvestment is type PortfolioInvestmentEvent
    inlet PortfolioRepositoryFromPortfolioAnalytics is type PortfolioInvestmentEvent
    outlet PortfolioRepositoryResponses is type PortfolioInvestment.PortfolioInvestmentResult
    schema PortfolioData is relational
      of portfolioInvestments as type PortfolioInvestment
        index on field PortfolioInvestment.investmentId
        index on field PortfolioInvestment.companyInfo.companyId
        index on field PortfolioInvestment.status
      with {
      briefly "Portfolio data schema"
      described as {
        |The relational schema holding portfolio data for the PortfolioRepository.
      }
    }

    handler PortfolioPersistence is {
      on command PortfolioInvestment.RecordInvestment is {
        tell event PortfolioInvestment.InvestmentRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on command PortfolioInvestment.AddMilestone is {
        tell event PortfolioInvestment.MilestoneAdded to entity VCPortfolioContext.PortfolioInvestment
      }
      on command PortfolioInvestment.UpdateMilestone is {
        tell event PortfolioInvestment.MilestoneUpdated to entity VCPortfolioContext.PortfolioInvestment
      }
      on command PortfolioInvestment.AssignBoardSeat is {
        tell event PortfolioInvestment.BoardSeatAssigned to entity VCPortfolioContext.PortfolioInvestment
      }
      on command PortfolioInvestment.RecordFollowOn is {
        tell event PortfolioInvestment.FollowOnRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on command PortfolioInvestment.RecordExit is {
        tell event PortfolioInvestment.ExitRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on command PortfolioInvestment.WriteOff is {
        tell event PortfolioInvestment.InvestmentWrittenOff to entity VCPortfolioContext.PortfolioInvestment
      }
    } with {
      briefly "Persists portfolio commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Portfolio data persistence"
    described as {
      |Persistent storage for portfolio investments.
    }
  }
  projector PortfolioAnalytics is {
    inlet PortfolioAnalyticsFromPortfolioInvestment is type PortfolioInvestmentEvent
    outlet PortfolioAnalyticsOut is type PortfolioInvestmentEvent
    updates repository VCPortfolioContext.PortfolioRepository
    record FundMetrics is  {
      totalInvested: Decimal(14,2) with {
        briefly "Invested"
        described as {
          |Total capital invested.
        }
      }
      totalRealized: Decimal(14,2) with {
        briefly "Realized"
        described as {
          |Total realized returns.
        }
      }
      activeInvestments: Natural with {
        briefly "Active"
        described as {
          |Active investment count.
        }
      }
      exitedInvestments: Natural with {
        briefly "Exited"
        described as {
          |Exited investment count.
        }
      }
      writtenOffCount: Natural with {
        briefly "Written off"
        described as {
          |Written-off investment count.
        }
      }
      averageMOIC: Decimal(6,2) with {
        briefly "Avg MOIC"
        described as {
          |Average multiple on invested capital.
        }
      }
    } with {
      briefly "Fund metrics"
      described as {
        |Fund-level performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on event PortfolioInvestment.InvestmentRecorded is {
        tell event PortfolioInvestment.InvestmentRecorded to repository VCPortfolioContext.PortfolioRepository
      }
      on event PortfolioInvestment.FollowOnRecorded is {
        tell event PortfolioInvestment.FollowOnRecorded to repository VCPortfolioContext.PortfolioRepository
      }
      on event PortfolioInvestment.ExitRecorded is {
        tell event PortfolioInvestment.ExitRecorded to repository VCPortfolioContext.PortfolioRepository
      }
      on event PortfolioInvestment.InvestmentWrittenOff is {
        tell event PortfolioInvestment.InvestmentWrittenOff to repository VCPortfolioContext.PortfolioRepository
      }
      on event PortfolioInvestment.InvestmentMarkedDown is {
        tell event PortfolioInvestment.InvestmentMarkedDown to repository VCPortfolioContext.PortfolioRepository
      }
    } with {
      briefly "Maintains portfolio analytics"
      described as {
        |Projects events into fund metrics.
      }
    }
  } with {
    briefly "Portfolio analytics"
    described as {
      |Fund-level portfolio performance analytics.
    }
  }
  processor PortfolioInvestmentSource as source is {
    outlet PortfolioInvestmentEvents is type PortfolioInvestmentEvent
    handler PortfolioInvestmentSourceHandler is {
      on init is {
        tell command PortfolioInvestment.InitializePortfolioInvestment to entity VCPortfolioContext.PortfolioInvestment
      }
      on other is {
        error "Unexpected message for source PortfolioInvestmentSource"
      }
      on event PortfolioInvestment.InvestmentRecorded is {
        send event PortfolioInvestment.InvestmentRecorded to outlet PortfolioInvestmentEvents
      }
      on event PortfolioInvestment.ExitRecorded is {
        send event PortfolioInvestment.ExitRecorded to outlet PortfolioInvestmentEvents
      }
      on event PortfolioInvestment.InvestmentWrittenOff is {
        send event PortfolioInvestment.InvestmentWrittenOff to outlet PortfolioInvestmentEvents
      }
    } with {
      briefly "Portfolio investment source handler"
      described as {
        |Handles portfolio investment events and sends to outlet.
      }
    }
  } with {
    briefly "Portfolio investment event source"
    described as {
      |Publishes portfolio investment entity events.
    }
  }
  processor PortfolioInvestmentSink as sink is {
    inlet PortfolioInvestmentInlet is type PortfolioInvestmentEvent
    handler PortfolioInvestmentSinkHandler is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink PortfolioInvestmentSink"
      }
      on event PortfolioInvestment.InvestmentRecorded is {
        tell event PortfolioInvestment.InvestmentRecorded to repository VCPortfolioContext.PortfolioRepository
      }
      on event PortfolioInvestment.ExitRecorded is {
        tell event PortfolioInvestment.ExitRecorded to repository VCPortfolioContext.PortfolioRepository
      }
    } with {
      briefly "Portfolio investment sink handler"
      described as {
        |Receives portfolio investment events and persists them.
      }
    }
  } with {
    briefly "Portfolio investment event sink"
    described as {
      |Receives portfolio investment events for persistence.
    }
  }
  connector PortfolioInvestmentFlow is {
    from outlet VCPortfolioContext.PortfolioInvestmentSource.PortfolioInvestmentEvents to
      inlet VCPortfolioContext.PortfolioInvestmentSink.PortfolioInvestmentInlet
  } with {
    briefly "Portfolio investment event flow"
    described as {
      |Connects portfolio investment source to sink.
    }
  }
  processor PortfolioInvestmentEventSplit is {
    inlet PortfolioInvestmentEventSplitIn is type PortfolioInvestmentEvent
    outlet PortfolioInvestmentEventSplitToPortfolioRepository is type PortfolioInvestmentEvent
    outlet PortfolioInvestmentEventSplitToPortfolioAnalytics is type PortfolioInvestmentEvent
    handler PortfolioInvestmentEventSplitHandler is {
      on event PortfolioInvestment.InvestmentRecorded is {
        send event PortfolioInvestment.InvestmentRecorded to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send event PortfolioInvestment.InvestmentRecorded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell event PortfolioInvestment.InvestmentRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on event PortfolioInvestment.DueDiligenceAdvanced is {
        send event PortfolioInvestment.DueDiligenceAdvanced to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send event PortfolioInvestment.DueDiligenceAdvanced to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell event PortfolioInvestment.DueDiligenceAdvanced to entity VCPortfolioContext.PortfolioInvestment
      }
      on event PortfolioInvestment.MilestoneAdded is {
        send event PortfolioInvestment.MilestoneAdded to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send event PortfolioInvestment.MilestoneAdded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell event PortfolioInvestment.MilestoneAdded to entity VCPortfolioContext.PortfolioInvestment
      }
      on event PortfolioInvestment.MilestoneUpdated is {
        send event PortfolioInvestment.MilestoneUpdated to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send event PortfolioInvestment.MilestoneUpdated to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell event PortfolioInvestment.MilestoneUpdated to entity VCPortfolioContext.PortfolioInvestment
      }
      on event PortfolioInvestment.BoardSeatAssigned is {
        send event PortfolioInvestment.BoardSeatAssigned to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send event PortfolioInvestment.BoardSeatAssigned to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell event PortfolioInvestment.BoardSeatAssigned to entity VCPortfolioContext.PortfolioInvestment
      }
      on event PortfolioInvestment.BoardSeatRemoved is {
        send event PortfolioInvestment.BoardSeatRemoved to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send event PortfolioInvestment.BoardSeatRemoved to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell event PortfolioInvestment.BoardSeatRemoved to entity VCPortfolioContext.PortfolioInvestment
      }
      on event PortfolioInvestment.FollowOnRecorded is {
        send event PortfolioInvestment.FollowOnRecorded to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send event PortfolioInvestment.FollowOnRecorded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell event PortfolioInvestment.FollowOnRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on event PortfolioInvestment.FollowOnDeclined is {
        send event PortfolioInvestment.FollowOnDeclined to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send event PortfolioInvestment.FollowOnDeclined to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell event PortfolioInvestment.FollowOnDeclined to entity VCPortfolioContext.PortfolioInvestment
      }
      on event PortfolioInvestment.MetricRecorded is {
        send event PortfolioInvestment.MetricRecorded to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send event PortfolioInvestment.MetricRecorded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell event PortfolioInvestment.MetricRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on event PortfolioInvestment.InvestmentMarkedDown is {
        send event PortfolioInvestment.InvestmentMarkedDown to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send event PortfolioInvestment.InvestmentMarkedDown to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell event PortfolioInvestment.InvestmentMarkedDown to entity VCPortfolioContext.PortfolioInvestment
      }
      on event PortfolioInvestment.ExitRecorded is {
        send event PortfolioInvestment.ExitRecorded to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send event PortfolioInvestment.ExitRecorded to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell event PortfolioInvestment.ExitRecorded to entity VCPortfolioContext.PortfolioInvestment
      }
      on event PortfolioInvestment.InvestmentWrittenOff is {
        send event PortfolioInvestment.InvestmentWrittenOff to outlet PortfolioInvestmentEventSplitToPortfolioRepository
        send event PortfolioInvestment.InvestmentWrittenOff to outlet PortfolioInvestmentEventSplitToPortfolioAnalytics
        tell event PortfolioInvestment.InvestmentWrittenOff to entity VCPortfolioContext.PortfolioInvestment
      }
      on other is {
        error "Unexpected message for processor PortfolioInvestmentEventSplit"
      }
    } with {
      briefly "PortfolioInvestment event fan-out handler"
      described as {
        |Delivers each PortfolioInvestment event to all of its consumers.
      }
    }
  } with {
    briefly "PortfolioInvestment event fan-out"
    described as {
      |Fans PortfolioInvestment events out to the repository and projectors.
    }
  }
  connector LinkPortfolioInvestmentToPortfolioInvestmentEventSplit is {
    from outlet VCPortfolioContext.PortfolioInvestment.PortfolioInvestmentEvents2 to
      inlet VCPortfolioContext.PortfolioInvestmentEventSplit.PortfolioInvestmentEventSplitIn
  } with {
    briefly "LinkPortfolioInvestmentToPortfolioInvestmentEventSplit"
  }
  connector LinkPortfolioInvestmentEventSplitToPortfolioRepository is {
    from outlet VCPortfolioContext.PortfolioInvestmentEventSplit.PortfolioInvestmentEventSplitToPortfolioRepository to
      inlet VCPortfolioContext.PortfolioRepository.PortfolioRepositoryFromPortfolioInvestment
  } with {
    briefly "LinkPortfolioInvestmentEventSplitToPortfolioRepository"
  }
  connector LinkPortfolioInvestmentEventSplitToPortfolioAnalytics is {
    from outlet VCPortfolioContext.PortfolioInvestmentEventSplit.PortfolioInvestmentEventSplitToPortfolioAnalytics to
      inlet VCPortfolioContext.PortfolioAnalytics.PortfolioAnalyticsFromPortfolioInvestment
  } with {
    briefly "LinkPortfolioInvestmentEventSplitToPortfolioAnalytics"
  }
  connector LinkPortfolioAnalyticsToPortfolioRepository is {
    from outlet VCPortfolioContext.PortfolioAnalytics.PortfolioAnalyticsOut to
      inlet VCPortfolioContext.PortfolioRepository.PortfolioRepositoryFromPortfolioAnalytics
  } with {
    briefly "LinkPortfolioAnalyticsToPortfolioRepository"
  }
} with {
  briefly "Bounded context for VC portfolio management"
  described as {
    |Venture capital portfolio management context.
  }
}
