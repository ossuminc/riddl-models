// Portfolio Management Domain Model
// VC portfolio company tracking and analytics
domain PortfolioManagement is {
  persistent connector 'MarketIntelligenceReply Stream' is from outlet MarketIntelligence.MarketIntelligenceRepliesOut to inlet VCPortfolioContext.ToMarketIntelligence.ToMarketIntelligenceReplies with {
    briefly "What MarketIntelligence answers VCPortfolioContext"
  }
  persistent connector 'LegalSystemReply Stream' is from outlet LegalSystem.LegalSystemRepliesOut to inlet VCPortfolioContext.ToLegalSystem.ToLegalSystemReplies with {
    briefly "What LegalSystem answers VCPortfolioContext"
  }
  persistent connector 'LegalSystemEvent Stream' is from outlet LegalSystem.LegalSystemEventsOut to inlet VCPortfolioContext.FromLegalSystem.FromLegalSystemIn with {
    briefly "What LegalSystem tells VCPortfolioContext, unasked"
  }
  persistent connector 'MarketIntelligenceRequest Stream' is from outlet VCPortfolioContext.ToMarketIntelligence.ToMarketIntelligenceOut to inlet MarketIntelligence.MarketIntelligenceRequests with {
    briefly "What VCPortfolioContext asks MarketIntelligence to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user PortfolioManager is "person managing portfolio investments" with {
    briefly "Portfolio Manager"
    described as {
      |Manager overseeing portfolio companies.
    }
  }
  user InvestmentAnalyst is "person analyzing investment opportunities" with {
    briefly "Investment Analyst"
    described as {
      |Analyst evaluating deals and portfolio performance.
    }
  }
  user FundPartner is "person making investment decisions" with {
    briefly "Fund Partner"
    described as {
      |General partner making investment decisions.
    }
  }
  epic InvestmentLifecycle is {
    user PortfolioManager wants to "to track portfolio investments" so that "investment performance is monitored and optimized"
    case TrackNewInvestment is {
      user PortfolioManager wants to "to record a new portfolio investment" so that "the investment is tracked from inception"
      step is "Manager records" "investment details" "into the system" with {
        briefly "Record investment"
        described as {
          |Capture investment.
        }
      }
      step is "System tracks" "milestones and metrics" "for reporting" with {
        briefly "Track progress"
        described as {
          |Monitor milestones.
        }
      }
    } with {
      briefly "Track new investment"
      described as {
        |Recording and tracking a new portfolio investment.
      }
    }
  } with {
    briefly "Investment lifecycle"
    described as {
      |Epic for managing portfolio investment lifecycle.
    }
  }
  include "VCPortfolioContext.riddl"
  include "external-contexts.riddl"
  application context PortfolioManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PortfolioManagement are delivered.
      }
    }
    group PortfolioManagementScreen is {
      input AdvanceDueDiligenceInput acquires command VCPortfolioContext.PortfolioInvestment.AdvanceDueDiligence with {
        briefly "Advance due diligence control"
        described as {
          |The control through which a user submits the advance due diligence request.
        }
      }
      input AssignBoardSeatInput acquires command VCPortfolioContext.PortfolioInvestment.AssignBoardSeat with {
        briefly "Assign board seat control"
        described as {
          |The control through which a user submits the assign board seat request.
        }
      }
      input DeclineFollowOnInput acquires command VCPortfolioContext.PortfolioInvestment.DeclineFollowOn with {
        briefly "Decline follow on control"
        described as {
          |The control through which a user submits the decline follow on request.
        }
      }
      input RecordExitInput acquires command VCPortfolioContext.PortfolioInvestment.RecordExit with {
        briefly "Record exit control"
        described as {
          |The control through which a user submits the record exit request.
        }
      }
      input RecordFollowOnInput acquires command VCPortfolioContext.PortfolioInvestment.RecordFollowOn with {
        briefly "Record follow on control"
        described as {
          |The control through which a user submits the record follow on request.
        }
      }
      input RemoveBoardSeatInput acquires command VCPortfolioContext.PortfolioInvestment.RemoveBoardSeat with {
        briefly "Remove board seat control"
        described as {
          |The control through which a user submits the remove board seat request.
        }
      }
      input UpdateMilestoneInput acquires command VCPortfolioContext.PortfolioInvestment.UpdateMilestone with {
        briefly "Update milestone control"
        described as {
          |The control through which a user submits the update milestone request.
        }
      }
      input WriteOffInput acquires command VCPortfolioContext.PortfolioInvestment.WriteOff with {
        briefly "Write off control"
        described as {
          |The control through which a user submits the write off request.
        }
      }
      input RecordInvestmentInput acquires command VCPortfolioContext.RecordInvestment with {
        briefly "Record investment control"
        described as {
          |The control through which a user submits the record investment request.
        }
      }
    } with {
      briefly "Portfolio management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppPortfolioInvestmentCommands is type VCPortfolioContext.PortfolioInvestmentRequest
    inlet AppPortfolioRepositoryResponses is result VCPortfolioContext.PortfolioInvestment.PortfolioInvestmentResult
    handler PortfolioManagementAppHandler is {
      on other is {
        error "Unexpected message for application context PortfolioManagementApp"
      }
    } with {
      briefly "PortfolioManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PortfolioManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'LegalSystemRequest Stream' is from outlet VCPortfolioContext.ToLegalSystem.ToLegalSystemOut to inlet LegalSystem.LegalSystemRequests with {
    briefly "What VCPortfolioContext asks LegalSystem to send"
  }
  persistent connector 'PortfolioInvestmentCommand Stream' is from outlet PortfolioManagementApp.AppPortfolioInvestmentCommands to inlet VCPortfolioContext.PortfolioInvestmentCommandStIn with {
    briefly "PortfolioInvestment commands from the application"
  }
  persistent connector 'PortfolioCompanyResult Stream' is from outlet VCPortfolioContext.PortfolioCompanyResultStreamOut to inlet PortfolioManagementApp.AppPortfolioRepositoryResponses with {
    briefly "Portfolio query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PortfolioManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Portfolio management domain"
  described as {
    |VC portfolio company tracking and analytics.
  }
}
