// Fund Management Domain Model
// Venture capital fund operations and LP management
domain FundManagement is {
  persistent connector 'FundAccountingReply Stream' is from outlet FundAccounting.FundAccountingRepliesOut to inlet FundContext.ToFundAccounting.ToFundAccountingReplies with {
    briefly "What FundAccounting answers FundContext"
  }
  persistent connector 'BankingServiceReply Stream' is from outlet BankingService.BankingServiceRepliesOut to inlet FundContext.ToBankingService.ToBankingServiceReplies with {
    briefly "What BankingService answers FundContext"
  }
  persistent connector 'BankingServiceEvent Stream' is from outlet BankingService.BankingServiceEventsOut to inlet FundContext.FromBankingService.FromBankingServiceIn with {
    briefly "What BankingService tells FundContext, unasked"
  }
  persistent connector 'ComplianceReportingEvent Stream' is from outlet ComplianceReporting.ComplianceReportingEventsOut to inlet FundContext.FromComplianceReporting.FromComplianceReportingIn with {
    briefly "What ComplianceReporting tells FundContext, unasked"
  }
  persistent connector 'LPPortalEvent Stream' is from outlet LPPortal.LPPortalEventsOut to inlet FundContext.FromLPPortal.FromLPPortalIn with {
    briefly "What LPPortal tells FundContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user FundManager is "person managing VC fund" with {
    briefly "Fund Manager"
    described as {
      |General partner managing fund.
    }
  }
  user InvestorRelations is "person managing LP relationships" with {
    briefly "Investor Relations"
    described as {
      |IR managing limited partner communications.
    }
  }
  user FundController is "person overseeing fund accounting" with {
    briefly "Fund Controller"
    described as {
      |Controller managing fund finances.
    }
  }
  epic FundOperationsManagement is {
    user FundManager wants to "to manage fund operations" so that "investors receive maximum returns"
    case RaiseCapital is {
      user FundManager wants to "to raise fund capital" so that "the fund can make investments"
      step is "IR manages" "LP commitments" "during fundraise" with {
        briefly "Manage commitments"
        described as {
          |Track LP commitments.
        }
      }
      step is "System tracks" "capital calls" "and distributions" with {
        briefly "Track capital"
        described as {
          |Manage fund flows.
        }
      }
    } with {
      briefly "Raise capital"
      described as {
        |Managing fund raising.
      }
    }
  } with {
    briefly "Fund operations management"
    described as {
      |Epic for VC fund management.
    }
  }
  include "FundContext.riddl"
  include "external-contexts.riddl"
  application context FundManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in FundManagement are delivered.
      }
    }
    group FundManagementScreen is {
      input CreateFundInput acquires command FundContext.CreateFund with {
        briefly "Create fund control"
        described as {
          |The control through which a user submits the create fund request.
        }
      }
      input AddLPCommitmentInput acquires command FundContext.Fund.AddLPCommitment with {
        briefly "Add LP commitment control"
        described as {
          |The control through which a user submits the add lp commitment request.
        }
      }
      input ChargeManagementFeeInput acquires command FundContext.Fund.ChargeManagementFee with {
        briefly "Charge management fee control"
        described as {
          |The control through which a user submits the charge management fee request.
        }
      }
      input CloseFundInput acquires command FundContext.Fund.CloseFund with {
        briefly "Close fund control"
        described as {
          |The control through which a user submits the close fund request.
        }
      }
      input IssueDistributionInput acquires command FundContext.Fund.IssueDistribution with {
        briefly "Issue distribution control"
        described as {
          |The control through which a user submits the issue distribution request.
        }
      }
      input RecordCallPaymentInput acquires command FundContext.Fund.RecordCallPayment with {
        briefly "Record call payment control"
        described as {
          |The control through which a user submits the record call payment request.
        }
      }
      input RecordFinalCloseInput acquires command FundContext.Fund.RecordFinalClose with {
        briefly "Record final close control"
        described as {
          |The control through which a user submits the record final close request.
        }
      }
      input RecordFirstCloseInput acquires command FundContext.Fund.RecordFirstClose with {
        briefly "Record first close control"
        described as {
          |The control through which a user submits the record first close request.
        }
      }
      input StartHarvestPeriodInput acquires command FundContext.Fund.StartHarvestPeriod with {
        briefly "Start harvest period control"
        described as {
          |The control through which a user submits the start harvest period request.
        }
      }
    } with {
      briefly "Fund management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppFundCommands is type FundContext.FundRequest
    inlet AppFundRepositoryResponses is result FundContext.Fund.FundResult
    handler FundManagementAppHandler is {
      on other is {
        error "Unexpected message for application context FundManagementApp"
      }
    } with {
      briefly "FundManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "FundManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'BankingServiceRequest Stream' is from outlet FundContext.ToBankingService.ToBankingServiceOut to inlet BankingService.BankingServiceRequests with {
    briefly "What FundContext asks BankingService to send"
  }
  persistent connector 'FundAccountingRequest Stream' is from outlet FundContext.ToFundAccounting.ToFundAccountingOut to inlet FundAccounting.FundAccountingRequests with {
    briefly "What FundContext asks FundAccounting to send"
  }
  persistent connector 'ComplianceReportingRequest Stream' is from outlet FundContext.ToComplianceReporting.ToComplianceReportingOut to inlet ComplianceReporting.ComplianceReportingRequests with {
    briefly "What FundContext asks ComplianceReporting to send"
  }
  persistent connector 'LPPortalRequest Stream' is from outlet FundContext.ToLPPortal.ToLPPortalOut to inlet LPPortal.LPPortalRequests with {
    briefly "What FundContext asks LPPortal to send"
  }
  persistent connector 'FundCommand Stream' is from outlet FundManagementApp.AppFundCommands to inlet FundContext.FundCommandStreamIn with {
    briefly "Fund commands from the application"
  }
  persistent connector 'FundInfoResult Stream' is from outlet FundContext.FundInfoResultStreamOut to inlet FundManagementApp.AppFundRepositoryResponses with {
    briefly "Fund query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet FundManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term Commitment is "A limited partner's capital commitment made during a fundraise."
  briefly "Fund management domain"
  described as {
    |Venture capital fund operations.
  }
}
