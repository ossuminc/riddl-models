// Fund Management Domain Model
// Venture capital fund operations and LP management
domain FundManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user FundManager is "person managing VC fund" with {
    briefly "Fund Manager"
    described as {
      |General partner managing fund.
    }
  }
  user InvestorRelations is "person managing LP relationships" with {
    briefly "Investor Relations"
    described as {
      |IR managing limited partner communications.
    }
  }
  user FundController is "person overseeing fund accounting" with {
    briefly "Fund Controller"
    described as {
      |Controller managing fund finances.
    }
  }
  epic FundOperationsManagement is {
    user FundManager wants to "to manage fund operations" so that "investors receive maximum returns"
    case RaiseCapital is {
      user FundManager wants to "to raise fund capital" so that "the fund can make investments"
      step is "IR manages" "LP commitments" "during fundraise" with {
        briefly "Manage commitments"
        described as {
          |Track LP commitments.
        }
      }
      step is "System tracks" "capital calls" "and distributions" with {
        briefly "Track capital"
        described as {
          |Manage fund flows.
        }
      }
    } with {
      briefly "Raise capital"
      described as {
        |Managing fund raising.
      }
    }
  } with {
    briefly "Fund operations management"
    described as {
      |Epic for VC fund management.
    }
  }
  include "FundContext.riddl"
  include "external-contexts.riddl"
  application context FundManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in FundManagement are delivered.
      }
    }
    outlet AppFundCommands is type FundContext.Fund.FundCommand
    inlet AppFundRepositoryResponses is result FundContext.Fund.FundResult    handler FundManagementAppHandler is {
      on other is {
        error "Unexpected message for application context FundManagementApp"
      }
    } with {
      briefly "FundManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "FundManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'FundCommand Stream' is from outlet FundManagementApp.AppFundCommands to inlet FundContext.FundCommandStreamIn with {
    briefly "Fund commands from the application"
  }
  persistent connector 'FundInfoResult Stream' is from outlet FundContext.FundInfoResultStreamOut to inlet FundManagementApp.AppFundRepositoryResponses with {
    briefly "Fund query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet FundManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term Commitment is  "A limited partner's capital commitment made during a fundraise." 
  briefly "Fund management domain"
  described as {
    |Venture capital fund operations.
  }
}
