// Fund Management - Fund Context
context FundContext is {
  include "types.riddl"
  include "Fund.riddl"
  repository FundRepository is {
    inlet FundRepositoryFromFund is type FundEvent
    inlet FundRepositoryFromFundPerformance is type FundEvent
    outlet FundRepositoryResponses is type Fund.FundResult
    schema FundData is relational
      of funds as type Fund
        index on field Fund.fundId
        index on field Fund.status
        index on field Fund.fundInfo.vintage

    handler FundPersistence is {
      on command Fund.CreateFund is {
        tell event Fund.FundCreated to entity FundContext.Fund
      }
      on command Fund.AddLPCommitment is {
        tell event Fund.LPCommitmentAdded to entity FundContext.Fund
      }
      on command Fund.IssueCapitalCall is {
        tell event Fund.CapitalCallIssued to entity FundContext.Fund
      }
      on command Fund.RecordCallPayment is {
        tell event Fund.CallPaymentReceived to entity FundContext.Fund
      }
      on command Fund.IssueDistribution is {
        tell event Fund.DistributionIssued to entity FundContext.Fund
      }
      on command Fund.UpdateNAV is {
        tell event Fund.NAVUpdated to entity FundContext.Fund
      }
      on command Fund.CloseFund is {
        tell event Fund.FundClosed to entity FundContext.Fund
      }
    } with {
      briefly "Persists fund commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Fund data persistence"
    described as {
      |Persistent storage for funds.
    }
  }
  projector FundPerformance is {
    inlet FundPerformanceFromFund is type FundEvent
    outlet FundPerformanceOut is type FundEvent
    updates repository FundContext.FundRepository
    record PerformanceMetrics is  {
      fundId: FundId with {
        briefly "Fund"
        described as {
          |Fund ID.
        }
      }
      vintage: Natural with {
        briefly "Vintage"
        described as {
          |Vintage year.
        }
      }
      tvpi: Decimal(6,2) with {
        briefly "TVPI"
        described as {
          |TVPI.
        }
      }
      dpi: Decimal(6,2) with {
        briefly "DPI"
        described as {
          |DPI.
        }
      }
      irr: Decimal(6,2)? with {
        briefly "IRR"
        described as {
          |IRR.
        }
      }
      lastUpdated: Date with {
        briefly "Updated"
        described as {
          |Last update.
        }
      }
    } with {
      briefly "Performance metrics"
      described as {
        |Fund performance tracking.
      }
    }
    handler PerformanceHandler is {
      on event Fund.DistributionIssued is {
        tell event Fund.DistributionIssued to repository FundContext.FundRepository
      }
      on event Fund.NAVUpdated is {
        tell event Fund.NAVUpdated to repository FundContext.FundRepository
      }
    } with {
      briefly "Maintains fund performance"
      described as {
        |Projects events into performance.
      }
    }
  } with {
    briefly "Fund performance"
    described as {
      |Fund performance analytics.
    }
  }
  processor FundSource as source is {
    outlet FundEvents is type FundEvent
    handler FundSourceHandler is {
      on init is {
        tell command Fund.InitializeFund to entity FundContext.Fund
      }
      on other is {
        error "Unexpected message for source FundSource"
      }
      on event Fund.FundCreated is {
        send event Fund.FundCreated to outlet FundEvents
      }
      on event Fund.CapitalCallIssued is {
        send event Fund.CapitalCallIssued to outlet FundEvents
      }
      on event Fund.FundClosed is {
        send event Fund.FundClosed to outlet FundEvents
      }
    } with {
      briefly "Fund source handler"
      described as {
        |Handles fund events and sends to outlet.
      }
    }
  } with {
    briefly "Fund event source"
    described as {
      |Publishes fund entity events.
    }
  }
  processor FundSink as sink is {
    inlet FundInlet is type FundEvent
    handler FundSinkHandler is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink FundSink"
      }
      on event Fund.FundCreated is {
        tell event Fund.FundCreated to repository FundContext.FundRepository
      }
      on event Fund.CapitalCallIssued is {
        tell event Fund.CapitalCallIssued to repository FundContext.FundRepository
      }
    } with {
      briefly "Fund sink handler"
      described as {
        |Receives fund events and persists them.
      }
    }
  } with {
    briefly "Fund event sink"
    described as {
      |Receives fund events for persistence.
    }
  }
  connector FundFlow is {
    from outlet FundContext.FundSource.FundEvents to
      inlet FundContext.FundSink.FundInlet
  } with {
    briefly "Fund event flow"
    described as {
      |Connects fund source to sink.
    }
  }
  processor FundEventSplit is {
    inlet FundEventSplitIn is type FundEvent
    outlet FundEventSplitToFundRepository is type FundEvent
    outlet FundEventSplitToFundPerformance is type FundEvent
    handler FundEventSplitHandler is {
      on event Fund.FundCreated is {
        send event Fund.FundCreated to outlet FundEventSplitToFundRepository
        send event Fund.FundCreated to outlet FundEventSplitToFundPerformance
        tell event Fund.FundCreated to entity FundContext.Fund
      }
      on event Fund.LPCommitmentAdded is {
        send event Fund.LPCommitmentAdded to outlet FundEventSplitToFundRepository
        send event Fund.LPCommitmentAdded to outlet FundEventSplitToFundPerformance
        tell event Fund.LPCommitmentAdded to entity FundContext.Fund
      }
      on event Fund.FirstCloseRecorded is {
        send event Fund.FirstCloseRecorded to outlet FundEventSplitToFundRepository
        send event Fund.FirstCloseRecorded to outlet FundEventSplitToFundPerformance
        tell event Fund.FirstCloseRecorded to entity FundContext.Fund
      }
      on event Fund.FinalCloseRecorded is {
        send event Fund.FinalCloseRecorded to outlet FundEventSplitToFundRepository
        send event Fund.FinalCloseRecorded to outlet FundEventSplitToFundPerformance
        tell event Fund.FinalCloseRecorded to entity FundContext.Fund
      }
      on event Fund.CapitalCallIssued is {
        send event Fund.CapitalCallIssued to outlet FundEventSplitToFundRepository
        send event Fund.CapitalCallIssued to outlet FundEventSplitToFundPerformance
        tell event Fund.CapitalCallIssued to entity FundContext.Fund
      }
      on event Fund.CallPaymentReceived is {
        send event Fund.CallPaymentReceived to outlet FundEventSplitToFundRepository
        send event Fund.CallPaymentReceived to outlet FundEventSplitToFundPerformance
        tell event Fund.CallPaymentReceived to entity FundContext.Fund
      }
      on event Fund.DistributionIssued is {
        send event Fund.DistributionIssued to outlet FundEventSplitToFundRepository
        send event Fund.DistributionIssued to outlet FundEventSplitToFundPerformance
        tell event Fund.DistributionIssued to entity FundContext.Fund
      }
      on event Fund.ManagementFeeCharged is {
        send event Fund.ManagementFeeCharged to outlet FundEventSplitToFundRepository
        send event Fund.ManagementFeeCharged to outlet FundEventSplitToFundPerformance
        tell event Fund.ManagementFeeCharged to entity FundContext.Fund
      }
      on event Fund.NAVUpdated is {
        send event Fund.NAVUpdated to outlet FundEventSplitToFundRepository
        send event Fund.NAVUpdated to outlet FundEventSplitToFundPerformance
        tell event Fund.NAVUpdated to entity FundContext.Fund
      }
      on event Fund.HarvestPeriodStarted is {
        send event Fund.HarvestPeriodStarted to outlet FundEventSplitToFundRepository
        send event Fund.HarvestPeriodStarted to outlet FundEventSplitToFundPerformance
        tell event Fund.HarvestPeriodStarted to entity FundContext.Fund
      }
      on event Fund.FundClosed is {
        send event Fund.FundClosed to outlet FundEventSplitToFundRepository
        send event Fund.FundClosed to outlet FundEventSplitToFundPerformance
        tell event Fund.FundClosed to entity FundContext.Fund
      }
      on other is {
        error "Unexpected message for processor FundEventSplit"
      }
    } with {
      briefly "Fund event fan-out handler"
      described as {
        |Delivers each Fund event to all of its consumers.
      }
    }
  } with {
    briefly "Fund event fan-out"
    described as {
      |Fans Fund events out to the repository and projectors.
    }
  }
  connector LinkFundToFundEventSplit is {
    from outlet FundContext.Fund.FundEvents2 to
      inlet FundContext.FundEventSplit.FundEventSplitIn
  } with {
    briefly "LinkFundToFundEventSplit"
  }
  connector LinkFundEventSplitToFundRepository is {
    from outlet FundContext.FundEventSplit.FundEventSplitToFundRepository to
      inlet FundContext.FundRepository.FundRepositoryFromFund
  } with {
    briefly "LinkFundEventSplitToFundRepository"
  }
  connector LinkFundEventSplitToFundPerformance is {
    from outlet FundContext.FundEventSplit.FundEventSplitToFundPerformance to
      inlet FundContext.FundPerformance.FundPerformanceFromFund
  } with {
    briefly "LinkFundEventSplitToFundPerformance"
  }
  connector LinkFundPerformanceToFundRepository is {
    from outlet FundContext.FundPerformance.FundPerformanceOut to
      inlet FundContext.FundRepository.FundRepositoryFromFundPerformance
  } with {
    briefly "LinkFundPerformanceToFundRepository"
  }
} with {
  briefly "Bounded context for fund management"
  described as {
    |VC fund operations context.
  }
}
