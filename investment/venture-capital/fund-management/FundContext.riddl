// Fund Management - Fund Context
context FundContext is {
  adaptor FromBankingService from context BankingService is { 
    handler FromBankingServiceHandler is {
      on result BankingService.AccountBalance is {
        do "the model receives account balance"
      }
      on event BankingService.WireTransferCompleted is {
        do "the model receives wire transfer completed"
      }
      on other is {
        error "Unexpected message for adaptor FromBankingService"
      }
    } with {
      briefly "from banking service"
      described as {
        |Carries messages from the external BankingService.
      }
    }
  } with {
    briefly "BankingService integration"
    described as {
      |The model's side of the BankingService conversation.
    }
  }
  adaptor ToBankingService to context BankingService is { 
    handler ToBankingServiceHandler is {
      on query BankingService.GetAccountBalance is {
        do "the model sends get account balance"
      }
      on command BankingService.InitiateWireTransfer is {
        do "the model sends initiate wire transfer"
      }
      on other is {
        error "Unexpected message for adaptor ToBankingService"
      }
    } with {
      briefly "to banking service"
      described as {
        |Carries messages to the external BankingService.
      }
    }
  } with {
    briefly "BankingService integration"
    described as {
      |The model's side of the BankingService conversation.
    }
  }
  adaptor FromComplianceReporting from context ComplianceReporting is { 
    handler FromComplianceReportingHandler is {
      on event ComplianceReporting.ComplianceFilingAccepted is {
        do "the model receives compliance filing accepted"
      }
      on other is {
        error "Unexpected message for adaptor FromComplianceReporting"
      }
    } with {
      briefly "from compliance reporting"
      described as {
        |Carries messages from the external ComplianceReporting.
      }
    }
  } with {
    briefly "ComplianceReporting integration"
    described as {
      |The model's side of the ComplianceReporting conversation.
    }
  }
  adaptor ToComplianceReporting to context ComplianceReporting is { 
    handler ToComplianceReportingHandler is {
      on command ComplianceReporting.FileForm10K is {
        do "the model sends file form 10 k"
      }
      on command ComplianceReporting.FileScheduleD is {
        do "the model sends file schedule d"
      }
      on other is {
        error "Unexpected message for adaptor ToComplianceReporting"
      }
    } with {
      briefly "to compliance reporting"
      described as {
        |Carries messages to the external ComplianceReporting.
      }
    }
  } with {
    briefly "ComplianceReporting integration"
    described as {
      |The model's side of the ComplianceReporting conversation.
    }
  }
  adaptor FromFundAccounting from context FundAccounting is { 
    handler FromFundAccountingHandler is {
      on result FundAccounting.FundNAV is {
        do "the model receives fund nav"
      }
      on other is {
        error "Unexpected message for adaptor FromFundAccounting"
      }
    } with {
      briefly "from fund accounting"
      described as {
        |Carries messages from the external FundAccounting.
      }
    }
  } with {
    briefly "FundAccounting integration"
    described as {
      |The model's side of the FundAccounting conversation.
    }
  }
  adaptor ToFundAccounting to context FundAccounting is { 
    handler ToFundAccountingHandler is {
      on query FundAccounting.GetFundNAV is {
        do "the model sends get fund nav"
      }
      on command FundAccounting.RecordInvestment is {
        do "the model sends record investment"
      }
      on command FundAccounting.RecordValuation is {
        do "the model sends record valuation"
      }
      on other is {
        error "Unexpected message for adaptor ToFundAccounting"
      }
    } with {
      briefly "to fund accounting"
      described as {
        |Carries messages to the external FundAccounting.
      }
    }
  } with {
    briefly "FundAccounting integration"
    described as {
      |The model's side of the FundAccounting conversation.
    }
  }
  adaptor FromLPPortal from context LPPortal is { 
    handler FromLPPortalHandler is {
      on event LPPortal.NoticeDelivered is {
        do "the model receives notice delivered"
      }
      on other is {
        error "Unexpected message for adaptor FromLPPortal"
      }
    } with {
      briefly "from lp portal"
      described as {
        |Carries messages from the external LPPortal.
      }
    }
  } with {
    briefly "LPPortal integration"
    described as {
      |The model's side of the LPPortal conversation.
    }
  }
  adaptor ToLPPortal to context LPPortal is { 
    handler ToLPPortalHandler is {
      on command LPPortal.SendCapitalCallNotice is {
        do "the model sends send capital call notice"
      }
      on command LPPortal.SendDistributionNotice is {
        do "the model sends send distribution notice"
      }
      on command LPPortal.SendQuarterlyReport is {
        do "the model sends send quarterly report"
      }
      on other is {
        error "Unexpected message for adaptor ToLPPortal"
      }
    } with {
      briefly "to lp portal"
      described as {
        |Carries messages to the external LPPortal.
      }
    }
  } with {
    briefly "LPPortal integration"
    described as {
      |The model's side of the LPPortal conversation.
    }
  }
  include "types.riddl"
  include "Fund.riddl"
  repository FundRepository is {
    inlet FundRepositoryFromFund is type FundEvent    inlet FundRepositoryFromFundPerformance is type FundEvent    outlet FundRepositoryResponses is type Fund.FundResult
    record StoredFund is  {
      fundId: FundId with {
        briefly "fundId"
        described as {
          |The fundId column of the stored fund row.
        }
      }
      fundInfo: FundInfo with {
        briefly "fundInfo"
        described as {
          |The fundInfo column of the stored fund row.
        }
      }
      status: FundStatus with {
        briefly "status"
        described as {
          |The status column of the stored fund row.
        }
      }
    } with {
      briefly "Stored fund row"
      described as {
        |The persistence shape of fund data as this repository stores it.
      }
    }
    schema FundData is relational
      of funds as type StoredFund
        index on field StoredFund.fundId
        index on field StoredFund.status
        index on field StoredFund.fundInfo.vintage
 with {
      briefly "Fund data schema"
      described as {
        |The relational schema holding fund data for the FundRepository.
      }
    }
    handler FundPersistence is {
      on query GetPerformanceMetrics is {
        do "read the performance metrics projection"
        yield result PerformanceMetricsView
      }
      on command Fund.CreateFund is {
        tell event Fund.FundCreated to entity FundContext.Fund
      }
      on command Fund.AddLPCommitment is {
        tell event Fund.LPCommitmentAdded to entity FundContext.Fund
      }
      on command Fund.IssueCapitalCall is {
        tell event Fund.CapitalCallIssued to entity FundContext.Fund
      }
      on command Fund.RecordCallPayment is {
        tell event Fund.CallPaymentReceived to entity FundContext.Fund
      }
      on command Fund.IssueDistribution is {
        tell event Fund.DistributionIssued to entity FundContext.Fund
      }
      on command Fund.UpdateNAV is {
        tell event Fund.NAVUpdated to entity FundContext.Fund
      }
      on command Fund.CloseFund is {
        tell event Fund.FundClosed to entity FundContext.Fund
      }
    } with {
      briefly "Persists fund commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Fund data persistence"
    described as {
      |Persistent storage for funds.
    }
  }
  query GetPerformanceMetrics is  {
    performanceMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which performance metrics to retrieve.
      }
    }
  } with {
    briefly "Get performance metrics"
    described as {
      |Retrieves the performance metrics projection.
    }
  }
  result PerformanceMetricsView is  {
    performanceMetrics: FundPerformance.PerformanceMetrics with {
      briefly "Performance metrics"
      described as {
        |The performance metrics being returned.
      }
    }
  } with {
    briefly "Performance metrics view"
    described as {
      |Read model view carrying the performance metrics projection.
    }
  }
  projector FundPerformance is {
    updates repository FundContext.FundRepository
    inlet FundPerformanceFromFund is type FundEvent    outlet FundPerformanceOut is type FundEvent
    record PerformanceMetrics is  {
      fundId: FundId with {
        briefly "Fund"
        described as {
          |Fund ID.
        }
      }
      vintage: Natural with {
        briefly "Vintage"
        described as {
          |Vintage year.
        }
      }
      tvpi: Decimal(6,2) with {
        briefly "TVPI"
        described as {
          |TVPI.
        }
      }
      dpi: Decimal(6,2) with {
        briefly "DPI"
        described as {
          |DPI.
        }
      }
      irr: Decimal(6,2)? with {
        briefly "IRR"
        described as {
          |IRR.
        }
      }
      lastUpdated: Date with {
        briefly "Updated"
        described as {
          |Last update.
        }
      }
    } with {
      briefly "Performance metrics"
      described as {
        |Fund performance tracking.
      }
    }
    handler PerformanceHandler is {
      on event Fund.DistributionIssued is {
        tell event Fund.DistributionIssued to repository FundContext.FundRepository
      }
      on event Fund.NAVUpdated is {
        tell event Fund.NAVUpdated to repository FundContext.FundRepository
      }
    } with {
      briefly "Maintains fund performance"
      described as {
        |Projects events into performance.
      }
    }
  } with {
    briefly "Fund performance"
    described as {
      |Fund performance analytics.
    }
  }
  processor FundSource as source is {
    outlet FundEvents is type FundEvent
    handler FundSourceHandler is {
      on init is {
        tell command Fund.InitializeFund to entity FundContext.Fund
      }
      on other is {
        error "Unexpected message for source FundSource"
      }
      on event Fund.FundCreated is {
        send event Fund.FundCreated to outlet FundEvents
      }
      on event Fund.CapitalCallIssued is {
        send event Fund.CapitalCallIssued to outlet FundEvents
      }
      on event Fund.FundClosed is {
        send event Fund.FundClosed to outlet FundEvents
      }
    } with {
      briefly "Fund source handler"
      described as {
        |Handles fund events and sends to outlet.
      }
    }
  } with {
    briefly "Fund event source"
    described as {
      |Publishes fund entity events.
    }
  }
  processor FundSink as sink is {
    inlet FundInlet is type FundEvent    handler FundSinkHandler is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink FundSink"
      }
      on event Fund.FundCreated is {
        tell event Fund.FundCreated to repository FundContext.FundRepository
      }
      on event Fund.CapitalCallIssued is {
        tell event Fund.CapitalCallIssued to repository FundContext.FundRepository
      }
    } with {
      briefly "Fund sink handler"
      described as {
        |Receives fund events and persists them.
      }
    }
  } with {
    briefly "Fund event sink"
    described as {
      |Receives fund events for persistence.
    }
  }
  connector FundFlow is from outlet FundContext.FundSource.FundEvents to inlet FundContext.FundSink.FundInlet with {
    briefly "Fund event flow"
    described as {
      |Connects fund source to sink.
    }
  }
  processor FundEventSplit is {
    inlet FundEventSplitIn is type FundEvent    outlet FundEventSplitToFundRepository is type FundEvent
    outlet FundEventSplitToFundPerformance is type FundEvent
    handler FundEventSplitHandler is {
      on event Fund.FundCreated is {
        send event Fund.FundCreated to outlet FundEventSplitToFundRepository
        send event Fund.FundCreated to outlet FundEventSplitToFundPerformance
        tell event Fund.FundCreated to entity FundContext.Fund
      }
      on event Fund.LPCommitmentAdded is {
        send event Fund.LPCommitmentAdded to outlet FundEventSplitToFundRepository
        send event Fund.LPCommitmentAdded to outlet FundEventSplitToFundPerformance
        tell event Fund.LPCommitmentAdded to entity FundContext.Fund
      }
      on event Fund.FirstCloseRecorded is {
        send event Fund.FirstCloseRecorded to outlet FundEventSplitToFundRepository
        send event Fund.FirstCloseRecorded to outlet FundEventSplitToFundPerformance
        tell event Fund.FirstCloseRecorded to entity FundContext.Fund
      }
      on event Fund.FinalCloseRecorded is {
        send event Fund.FinalCloseRecorded to outlet FundEventSplitToFundRepository
        send event Fund.FinalCloseRecorded to outlet FundEventSplitToFundPerformance
        tell event Fund.FinalCloseRecorded to entity FundContext.Fund
      }
      on event Fund.CapitalCallIssued is {
        send event Fund.CapitalCallIssued to outlet FundEventSplitToFundRepository
        send event Fund.CapitalCallIssued to outlet FundEventSplitToFundPerformance
        tell event Fund.CapitalCallIssued to entity FundContext.Fund
      }
      on event Fund.CallPaymentReceived is {
        send event Fund.CallPaymentReceived to outlet FundEventSplitToFundRepository
        send event Fund.CallPaymentReceived to outlet FundEventSplitToFundPerformance
        tell event Fund.CallPaymentReceived to entity FundContext.Fund
      }
      on event Fund.DistributionIssued is {
        send event Fund.DistributionIssued to outlet FundEventSplitToFundRepository
        send event Fund.DistributionIssued to outlet FundEventSplitToFundPerformance
        tell event Fund.DistributionIssued to entity FundContext.Fund
      }
      on event Fund.ManagementFeeCharged is {
        send event Fund.ManagementFeeCharged to outlet FundEventSplitToFundRepository
        send event Fund.ManagementFeeCharged to outlet FundEventSplitToFundPerformance
        tell event Fund.ManagementFeeCharged to entity FundContext.Fund
      }
      on event Fund.NAVUpdated is {
        send event Fund.NAVUpdated to outlet FundEventSplitToFundRepository
        send event Fund.NAVUpdated to outlet FundEventSplitToFundPerformance
        tell event Fund.NAVUpdated to entity FundContext.Fund
      }
      on event Fund.HarvestPeriodStarted is {
        send event Fund.HarvestPeriodStarted to outlet FundEventSplitToFundRepository
        send event Fund.HarvestPeriodStarted to outlet FundEventSplitToFundPerformance
        tell event Fund.HarvestPeriodStarted to entity FundContext.Fund
      }
      on event Fund.FundClosed is {
        send event Fund.FundClosed to outlet FundEventSplitToFundRepository
        send event Fund.FundClosed to outlet FundEventSplitToFundPerformance
        tell event Fund.FundClosed to entity FundContext.Fund
      }
      on other is {
        error "Unexpected message for processor FundEventSplit"
      }
    } with {
      briefly "Fund event fan-out handler"
      described as {
        |Delivers each Fund event to all of its consumers.
      }
    }
  } with {
    briefly "Fund event fan-out"
    described as {
      |Fans Fund events out to the repository and projectors.
    }
  }
  connector 'FundEvent Stream' is from outlet FundContext.Fund.FundEvents2 to inlet FundContext.FundEventSplit.FundEventSplitIn with {
    briefly "Fund events, fanned out to storage and read models"
  }
  connector 'FundEvent Storage' is from outlet FundContext.FundEventSplit.FundEventSplitToFundRepository to inlet FundContext.FundRepository.FundRepositoryFromFund with {
    briefly "Fund events on their way to storage"
  }
  connector 'FundPerformance Feed' is from outlet FundContext.FundEventSplit.FundEventSplitToFundPerformance to inlet FundContext.FundPerformance.FundPerformanceFromFund with {
    briefly "Fund events feeding the FundPerformance projection"
  }
  connector 'FundPerformance Storage' is from outlet FundContext.FundPerformance.FundPerformanceOut to inlet FundContext.FundRepository.FundRepositoryFromFundPerformance with {
    briefly "The FundPerformance projection on its way to storage"
  }
} with {
  briefly "Bounded context for fund management"
  described as {
    |VC fund operations context.
  }
}
