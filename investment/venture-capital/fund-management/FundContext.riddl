// Fund Management - Fund Context
context FundContext as router is {
  inlet FundCommandStreamIn is type FundCommand  outlet FundCommandStreamOut is type FundCommand
  inlet FundInfoResultStreamIn is result Fund.FundResult  outlet FundInfoResultStreamOut is result Fund.FundResult
  handler FundContextBoundary is {
    on createFund: command Fund.CreateFund is {
      send createFund to outlet FundContext.FundCommandStreamOut
    }
    on addLPCommitment: command Fund.AddLPCommitment is {
      send addLPCommitment to outlet FundContext.FundCommandStreamOut
    }
    on recordFirstClose: command Fund.RecordFirstClose is {
      send recordFirstClose to outlet FundContext.FundCommandStreamOut
    }
    on recordFinalClose: command Fund.RecordFinalClose is {
      send recordFinalClose to outlet FundContext.FundCommandStreamOut
    }
    on issueCapitalCall: command Fund.IssueCapitalCall is {
      send issueCapitalCall to outlet FundContext.FundCommandStreamOut
    }
    on recordCallPayment: command Fund.RecordCallPayment is {
      send recordCallPayment to outlet FundContext.FundCommandStreamOut
    }
    on issueDistribution: command Fund.IssueDistribution is {
      send issueDistribution to outlet FundContext.FundCommandStreamOut
    }
    on chargeManagementFee: command Fund.ChargeManagementFee is {
      send chargeManagementFee to outlet FundContext.FundCommandStreamOut
    }
    on updateNAV: command Fund.UpdateNAV is {
      send updateNAV to outlet FundContext.FundCommandStreamOut
    }
    on startHarvestPeriod: command Fund.StartHarvestPeriod is {
      send startHarvestPeriod to outlet FundContext.FundCommandStreamOut
    }
    on closeFund: command Fund.CloseFund is {
      send closeFund to outlet FundContext.FundCommandStreamOut
    }
    on fundResult: result Fund.FundResult is {
      send fundResult to outlet FundContext.FundInfoResultStreamOut
    }
    on other is {
      error "Unexpected message at the FundContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'FundCommand Stream Intake' is from outlet FundContext.FundCommandStreamOut to inlet FundContext.Fund.FundCommands  connector 'FundInfoResult Stream Egress' is from outlet FundContext.FundRepository.FundRepositoryResponses to inlet FundContext.FundInfoResultStreamIn  adaptor FromBankingService from context BankingService is { 
    handler FromBankingServiceHandler is {
      on result BankingService.AccountBalance is {
        do "the model receives account balance"
      }
      on event BankingService.WireTransferCompleted is {
        do "the model receives wire transfer completed"
      }
      on other is {
        error "Unexpected message for adaptor FromBankingService"
      }
    } with {
      briefly "from banking service"
      described as {
        |Carries messages from the external BankingService.
      }
    }
  } with {
    briefly "BankingService integration"
    described as {
      |The model's side of the BankingService conversation.
    }
  }
  adaptor ToBankingService to context BankingService is { 
    handler ToBankingServiceHandler is {
      on query BankingService.GetAccountBalance is {
        do "the model sends get account balance"
      }
      on command BankingService.InitiateWireTransfer is {
        do "the model sends initiate wire transfer"
      }
      on other is {
        error "Unexpected message for adaptor ToBankingService"
      }
    } with {
      briefly "to banking service"
      described as {
        |Carries messages to the external BankingService.
      }
    }
  } with {
    briefly "BankingService integration"
    described as {
      |The model's side of the BankingService conversation.
    }
  }
  adaptor FromComplianceReporting from context ComplianceReporting is { 
    handler FromComplianceReportingHandler is {
      on event ComplianceReporting.ComplianceFilingAccepted is {
        do "the model receives compliance filing accepted"
      }
      on other is {
        error "Unexpected message for adaptor FromComplianceReporting"
      }
    } with {
      briefly "from compliance reporting"
      described as {
        |Carries messages from the external ComplianceReporting.
      }
    }
  } with {
    briefly "ComplianceReporting integration"
    described as {
      |The model's side of the ComplianceReporting conversation.
    }
  }
  adaptor ToComplianceReporting to context ComplianceReporting is { 
    handler ToComplianceReportingHandler is {
      on command ComplianceReporting.FileForm10K is {
        do "the model sends file form 10 k"
      }
      on command ComplianceReporting.FileScheduleD is {
        do "the model sends file schedule d"
      }
      on other is {
        error "Unexpected message for adaptor ToComplianceReporting"
      }
    } with {
      briefly "to compliance reporting"
      described as {
        |Carries messages to the external ComplianceReporting.
      }
    }
  } with {
    briefly "ComplianceReporting integration"
    described as {
      |The model's side of the ComplianceReporting conversation.
    }
  }
  adaptor FromFundAccounting from context FundAccounting is { 
    handler FromFundAccountingHandler is {
      on result FundAccounting.FundNAV is {
        do "the model receives fund nav"
      }
      on other is {
        error "Unexpected message for adaptor FromFundAccounting"
      }
    } with {
      briefly "from fund accounting"
      described as {
        |Carries messages from the external FundAccounting.
      }
    }
  } with {
    briefly "FundAccounting integration"
    described as {
      |The model's side of the FundAccounting conversation.
    }
  }
  adaptor ToFundAccounting to context FundAccounting is { 
    handler ToFundAccountingHandler is {
      on query FundAccounting.GetFundNAV is {
        do "the model sends get fund nav"
      }
      on command FundAccounting.RecordInvestment is {
        do "the model sends record investment"
      }
      on command FundAccounting.RecordValuation is {
        do "the model sends record valuation"
      }
      on other is {
        error "Unexpected message for adaptor ToFundAccounting"
      }
    } with {
      briefly "to fund accounting"
      described as {
        |Carries messages to the external FundAccounting.
      }
    }
  } with {
    briefly "FundAccounting integration"
    described as {
      |The model's side of the FundAccounting conversation.
    }
  }
  adaptor FromLPPortal from context LPPortal is { 
    handler FromLPPortalHandler is {
      on event LPPortal.NoticeDelivered is {
        do "the model receives notice delivered"
      }
      on other is {
        error "Unexpected message for adaptor FromLPPortal"
      }
    } with {
      briefly "from lp portal"
      described as {
        |Carries messages from the external LPPortal.
      }
    }
  } with {
    briefly "LPPortal integration"
    described as {
      |The model's side of the LPPortal conversation.
    }
  }
  adaptor ToLPPortal to context LPPortal is { 
    handler ToLPPortalHandler is {
      on command LPPortal.SendCapitalCallNotice is {
        do "the model sends send capital call notice"
      }
      on command LPPortal.SendDistributionNotice is {
        do "the model sends send distribution notice"
      }
      on command LPPortal.SendQuarterlyReport is {
        do "the model sends send quarterly report"
      }
      on other is {
        error "Unexpected message for adaptor ToLPPortal"
      }
    } with {
      briefly "to lp portal"
      described as {
        |Carries messages to the external LPPortal.
      }
    }
  } with {
    briefly "LPPortal integration"
    described as {
      |The model's side of the LPPortal conversation.
    }
  }
  include "types.riddl"
  include "Fund.riddl"
  type FundRepositoryCommand is one of {
    FundContext.FundRepository.PersistCallPaymentReceived or FundContext.FundRepository.PersistCapitalCallIssued or FundContext.FundRepository.PersistDistributionIssued or FundContext.FundRepository.PersistFinalCloseRecorded or FundContext.FundRepository.PersistFirstCloseRecorded or FundContext.FundRepository.PersistFundClosed or FundContext.FundRepository.PersistFundCreated or FundContext.FundRepository.PersistHarvestPeriodStarted or FundContext.FundRepository.PersistLPCommitmentAdded or FundContext.FundRepository.PersistManagementFeeCharged or FundContext.FundRepository.PersistNAVUpdated
  } with {
    briefly "Anything that writes FundRepository"
    described as {
      |The persistence commands FundRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository FundRepository as flow is {
    inlet FundRepositoryFromFundPerformance is type FundRepositoryCommand    command PersistCallPaymentReceived is {
      fundId: FundId with {
        briefly "Row addressed"
        described as {
          |Which stored row CallPaymentReceived applies to.
        }
      }
    } with {
      briefly "Persist CallPaymentReceived"
      described as {
        |Instructs this repository to apply CallPaymentReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCapitalCallIssued is {
      fundId: FundId with {
        briefly "Row addressed"
        described as {
          |Which stored row CapitalCallIssued applies to.
        }
      }
    } with {
      briefly "Persist CapitalCallIssued"
      described as {
        |Instructs this repository to apply CapitalCallIssued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFinalCloseRecorded is {
      fundId: FundId with {
        briefly "Row addressed"
        described as {
          |Which stored row FinalCloseRecorded applies to.
        }
      }
    } with {
      briefly "Persist FinalCloseRecorded"
      described as {
        |Instructs this repository to apply FinalCloseRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFirstCloseRecorded is {
      fundId: FundId with {
        briefly "Row addressed"
        described as {
          |Which stored row FirstCloseRecorded applies to.
        }
      }
    } with {
      briefly "Persist FirstCloseRecorded"
      described as {
        |Instructs this repository to apply FirstCloseRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFundClosed is {
      fundId: FundId with {
        briefly "Row addressed"
        described as {
          |Which stored row FundClosed applies to.
        }
      }
    } with {
      briefly "Persist FundClosed"
      described as {
        |Instructs this repository to apply FundClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFundCreated is {
      fundId: FundId with {
        briefly "Row addressed"
        described as {
          |Which stored row FundCreated applies to.
        }
      }
    } with {
      briefly "Persist FundCreated"
      described as {
        |Instructs this repository to apply FundCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHarvestPeriodStarted is {
      fundId: FundId with {
        briefly "Row addressed"
        described as {
          |Which stored row HarvestPeriodStarted applies to.
        }
      }
    } with {
      briefly "Persist HarvestPeriodStarted"
      described as {
        |Instructs this repository to apply HarvestPeriodStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLPCommitmentAdded is {
      fundId: FundId with {
        briefly "Row addressed"
        described as {
          |Which stored row LPCommitmentAdded applies to.
        }
      }
    } with {
      briefly "Persist LPCommitmentAdded"
      described as {
        |Instructs this repository to apply LPCommitmentAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistManagementFeeCharged is {
      fundId: FundId with {
        briefly "Row addressed"
        described as {
          |Which stored row ManagementFeeCharged applies to.
        }
      }
    } with {
      briefly "Persist ManagementFeeCharged"
      described as {
        |Instructs this repository to apply ManagementFeeCharged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDistributionIssued is {
      fundId: FundId with {
        briefly "Row addressed"
        described as {
          |Which stored row DistributionIssued applies to.
        }
      }
    } with {
      briefly "Persist DistributionIssued"
      described as {
        |Instructs this repository to apply DistributionIssued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistNAVUpdated is {
      fundId: FundId with {
        briefly "Row addressed"
        described as {
          |Which stored row NAVUpdated applies to.
        }
      }
    } with {
      briefly "Persist NAVUpdated"
      described as {
        |Instructs this repository to apply NAVUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet FundRepositoryResponses is result Fund.FundResult
    record StoredFund is {
      fundId: FundId with {
        briefly "fundId"
        described as {
          |The fundId column of the stored fund row.
        }
      }
      fundInfo: FundInfo with {
        briefly "fundInfo"
        described as {
          |The fundInfo column of the stored fund row.
        }
      }
      status: FundStatus with {
        briefly "status"
        described as {
          |The status column of the stored fund row.
        }
      }
    } with {
      briefly "Stored fund row"
      described as {
        |The persistence shape of fund data as this repository stores it.
      }
    }
    schema FundData is relational
      of funds as record StoredFund
        index on field StoredFund.fundId
        index on field StoredFund.status
        index on field StoredFund.fundInfo.vintage
 with {
      briefly "Fund data schema"
      described as {
        |The relational schema holding fund data for the FundRepository.
      }
    }
    handler FundPersistence is {
      on persistCallPaymentReceived: command PersistCallPaymentReceived is {
        do "apply CallPaymentReceived to the stored row"
      }
      on persistCapitalCallIssued: command PersistCapitalCallIssued is {
        do "apply CapitalCallIssued to the stored row"
      }
      on persistFinalCloseRecorded: command PersistFinalCloseRecorded is {
        do "apply FinalCloseRecorded to the stored row"
      }
      on persistFirstCloseRecorded: command PersistFirstCloseRecorded is {
        do "apply FirstCloseRecorded to the stored row"
      }
      on persistFundClosed: command PersistFundClosed is {
        do "apply FundClosed to the stored row"
      }
      on persistFundCreated: command PersistFundCreated is {
        do "apply FundCreated to the stored row"
      }
      on persistHarvestPeriodStarted: command PersistHarvestPeriodStarted is {
        do "apply HarvestPeriodStarted to the stored row"
      }
      on persistLPCommitmentAdded: command PersistLPCommitmentAdded is {
        do "apply LPCommitmentAdded to the stored row"
      }
      on persistManagementFeeCharged: command PersistManagementFeeCharged is {
        do "apply ManagementFeeCharged to the stored row"
      }
      on persistDistributionIssued: command PersistDistributionIssued is {
        do "apply DistributionIssued to the stored row"
      }
      on persistNAVUpdated: command PersistNAVUpdated is {
        do "apply NAVUpdated to the stored row"
      }
      on query GetPerformanceMetrics is {
        let performanceMetricsView: type PerformanceMetricsView = prompt("read the performance metrics projection")
        reply performanceMetricsView
      }
    } with {
      briefly "Persists fund commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Fund data persistence"
    described as {
      |Persistent storage for funds.
    }
  }
  query GetPerformanceMetrics replies result PerformanceMetricsView is {
    performanceMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which performance metrics to retrieve.
      }
    }
  } with {
    briefly "Get performance metrics"
    described as {
      |Retrieves the performance metrics projection.
    }
  }
  result PerformanceMetricsView is {
    performanceMetrics: FundPerformance.PerformanceMetrics with {
      briefly "Performance metrics"
      described as {
        |The performance metrics being returned.
      }
    }
  } with {
    briefly "Performance metrics view"
    described as {
      |Read model view carrying the performance metrics projection.
    }
  }
  projector FundPerformance as flow is {
    updates repository FundContext.FundRepository
    outlet FundPerformanceToRepository is type FundRepositoryCommand
    inlet FundPerformanceFromFund is type FundEvent    record PerformanceMetrics is {
      fundId: FundId with {
        briefly "Fund"
        described as {
          |Fund ID.
        }
      }
      vintage: Natural with {
        briefly "Vintage"
        described as {
          |Vintage year.
        }
      }
      tvpi: Decimal(6,2) with {
        briefly "TVPI"
        described as {
          |TVPI.
        }
      }
      dpi: Decimal(6,2) with {
        briefly "DPI"
        described as {
          |DPI.
        }
      }
      irr: Decimal(6,2)? with {
        briefly "IRR"
        described as {
          |IRR.
        }
      }
      lastUpdated: Date with {
        briefly "Updated"
        described as {
          |Last update.
        }
      }
    } with {
      briefly "Performance metrics"
      described as {
        |Fund performance tracking.
      }
    }
    handler PerformanceHandler is {
      on callPaymentReceived: event Fund.CallPaymentReceived is {
        tell command FundContext.FundRepository.PersistCallPaymentReceived(fundId = callPaymentReceived.fundId) to repository FundContext.FundRepository
        do "apply CallPaymentReceived to the FundPerformance projection"
      }
      on capitalCallIssued: event Fund.CapitalCallIssued is {
        tell command FundContext.FundRepository.PersistCapitalCallIssued(fundId = capitalCallIssued.fundId) to repository FundContext.FundRepository
        do "apply CapitalCallIssued to the FundPerformance projection"
      }
      on finalCloseRecorded: event Fund.FinalCloseRecorded is {
        tell command FundContext.FundRepository.PersistFinalCloseRecorded(fundId = finalCloseRecorded.fundId) to repository FundContext.FundRepository
        do "apply FinalCloseRecorded to the FundPerformance projection"
      }
      on firstCloseRecorded: event Fund.FirstCloseRecorded is {
        tell command FundContext.FundRepository.PersistFirstCloseRecorded(fundId = firstCloseRecorded.fundId) to repository FundContext.FundRepository
        do "apply FirstCloseRecorded to the FundPerformance projection"
      }
      on fundClosed: event Fund.FundClosed is {
        tell command FundContext.FundRepository.PersistFundClosed(fundId = fundClosed.fundId) to repository FundContext.FundRepository
        do "apply FundClosed to the FundPerformance projection"
      }
      on fundCreated: event Fund.FundCreated is {
        tell command FundContext.FundRepository.PersistFundCreated(fundId = fundCreated.fundId) to repository FundContext.FundRepository
        do "apply FundCreated to the FundPerformance projection"
      }
      on harvestPeriodStarted: event Fund.HarvestPeriodStarted is {
        tell command FundContext.FundRepository.PersistHarvestPeriodStarted(fundId = harvestPeriodStarted.fundId) to repository FundContext.FundRepository
        do "apply HarvestPeriodStarted to the FundPerformance projection"
      }
      on lPCommitmentAdded: event Fund.LPCommitmentAdded is {
        tell command FundContext.FundRepository.PersistLPCommitmentAdded(fundId = lPCommitmentAdded.fundId) to repository FundContext.FundRepository
        do "apply LPCommitmentAdded to the FundPerformance projection"
      }
      on managementFeeCharged: event Fund.ManagementFeeCharged is {
        tell command FundContext.FundRepository.PersistManagementFeeCharged(fundId = managementFeeCharged.fundId) to repository FundContext.FundRepository
        do "apply ManagementFeeCharged to the FundPerformance projection"
      }
      on distributionIssued: event Fund.DistributionIssued is {
        tell command FundContext.FundRepository.PersistDistributionIssued(fundId = distributionIssued.fundId) to repository FundContext.FundRepository
      }
      on nAVUpdated: event Fund.NAVUpdated is {
        tell command FundContext.FundRepository.PersistNAVUpdated(fundId = nAVUpdated.fundId) to repository FundContext.FundRepository
      }
    } with {
      briefly "Maintains fund performance"
      described as {
        |Projects events into performance.
      }
    }
  } with {
    briefly "Fund performance"
    described as {
      |Fund performance analytics.
    }
  }
  streamlet FundEventSplit as flow is {
    inlet FundEventSplitIn is type FundEvent    outlet FundEventSplitToFundPerformance is type FundEvent
    handler FundEventSplitHandler is {
      on fundCreated: event Fund.FundCreated is {
        send fundCreated to outlet FundEventSplitToFundPerformance
        tell fundCreated to entity FundContext.Fund
      }
      on lPCommitmentAdded: event Fund.LPCommitmentAdded is {
        send lPCommitmentAdded to outlet FundEventSplitToFundPerformance
        tell lPCommitmentAdded to entity FundContext.Fund
      }
      on firstCloseRecorded: event Fund.FirstCloseRecorded is {
        send firstCloseRecorded to outlet FundEventSplitToFundPerformance
        tell firstCloseRecorded to entity FundContext.Fund
      }
      on finalCloseRecorded: event Fund.FinalCloseRecorded is {
        send finalCloseRecorded to outlet FundEventSplitToFundPerformance
        tell finalCloseRecorded to entity FundContext.Fund
      }
      on capitalCallIssued: event Fund.CapitalCallIssued is {
        send capitalCallIssued to outlet FundEventSplitToFundPerformance
        tell capitalCallIssued to entity FundContext.Fund
      }
      on callPaymentReceived: event Fund.CallPaymentReceived is {
        send callPaymentReceived to outlet FundEventSplitToFundPerformance
        tell callPaymentReceived to entity FundContext.Fund
      }
      on distributionIssued: event Fund.DistributionIssued is {
        send distributionIssued to outlet FundEventSplitToFundPerformance
        tell distributionIssued to entity FundContext.Fund
      }
      on managementFeeCharged: event Fund.ManagementFeeCharged is {
        send managementFeeCharged to outlet FundEventSplitToFundPerformance
        tell managementFeeCharged to entity FundContext.Fund
      }
      on nAVUpdated: event Fund.NAVUpdated is {
        send nAVUpdated to outlet FundEventSplitToFundPerformance
        tell nAVUpdated to entity FundContext.Fund
      }
      on harvestPeriodStarted: event Fund.HarvestPeriodStarted is {
        send harvestPeriodStarted to outlet FundEventSplitToFundPerformance
        tell harvestPeriodStarted to entity FundContext.Fund
      }
      on fundClosed: event Fund.FundClosed is {
        send fundClosed to outlet FundEventSplitToFundPerformance
        tell fundClosed to entity FundContext.Fund
      }
      on other is {
        error "Unexpected message for processor FundEventSplit"
      }
    } with {
      briefly "Fund event fan-out handler"
      described as {
        |Delivers each Fund event to all of its consumers.
      }
    }
  } with {
    briefly "Fund event fan-out"
    described as {
      |Fans Fund events out to the repository and projectors.
    }
  }
  connector 'FundEvent Stream' is from outlet FundContext.Fund.FundEvents2 to inlet FundContext.FundEventSplit.FundEventSplitIn with {
    briefly "Fund events, fanned out to storage and read models"
  }
  connector 'FundPerformance Feed' is from outlet FundContext.FundEventSplit.FundEventSplitToFundPerformance to inlet FundContext.FundPerformance.FundPerformanceFromFund with {
    briefly "Fund events feeding the FundPerformance projection"
  }
  connector 'FundPerformance Storage' is from outlet FundContext.FundPerformance.FundPerformanceToRepository to inlet FundContext.FundRepository.FundRepositoryFromFundPerformance with {
    briefly "FundPerformance updates on their way to storage"
  }
} with {
  briefly "Bounded context for fund management"
  described as {
    |VC fund operations context.
  }
}
