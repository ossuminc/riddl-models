// Treaty Context
// Bounded context for treaty management operations
context TreatyContext as router is {
  inlet TreatyCommandStreamIn is type TreatyCommand  outlet TreatyCommandStreamOut is type TreatyCommand
  inlet TreatyQueryResultStreamIn is type Treaty.TreatyQueryResult  outlet TreatyQueryResultStreamOut is type Treaty.TreatyQueryResult
  handler TreatyContextBoundary is {
    on negotiateTreaty: command Treaty.NegotiateTreaty is {
      send negotiateTreaty to outlet TreatyContext.TreatyCommandStreamOut
    }
    on executeTreaty: command Treaty.ExecuteTreaty is {
      send executeTreaty to outlet TreatyContext.TreatyCommandStreamOut
    }
    on recordCession: command Treaty.RecordCession is {
      send recordCession to outlet TreatyContext.TreatyCommandStreamOut
    }
    on submitBordereau: command Treaty.SubmitBordereau is {
      send submitBordereau to outlet TreatyContext.TreatyCommandStreamOut
    }
    on processSettlement: command Treaty.ProcessSettlement is {
      send processSettlement to outlet TreatyContext.TreatyCommandStreamOut
    }
    on renewTreaty: command Treaty.RenewTreaty is {
      send renewTreaty to outlet TreatyContext.TreatyCommandStreamOut
    }
    on suspendTreaty: command Treaty.SuspendTreaty is {
      send suspendTreaty to outlet TreatyContext.TreatyCommandStreamOut
    }
    on terminateTreaty: command Treaty.TerminateTreaty is {
      send terminateTreaty to outlet TreatyContext.TreatyCommandStreamOut
    }
    on initializeTreaty: command Treaty.InitializeTreaty is {
      send initializeTreaty to outlet TreatyContext.TreatyCommandStreamOut
    }
    on treatyQueryResult: result Treaty.TreatyQueryResult is {
      send treatyQueryResult to outlet TreatyContext.TreatyQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the TreatyContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TreatyCommand Stream Intake' is from outlet TreatyContext.TreatyCommandStreamOut to inlet TreatyContext.Treaty.TreatyCommands  connector 'TreatyQueryResult Stream Egress' is from outlet TreatyContext.TreatyRepository.TreatyRepositoryResponses to inlet TreatyContext.TreatyQueryResultStreamIn  adaptor FromAccountingService from context AccountingService is { 
    handler FromAccountingServiceHandler is {
      on event AccountingService.PaymentFailed is {
        do "the model receives payment failed"
      }
      on other is {
        error "Unexpected message for adaptor FromAccountingService"
      }
    } with {
      briefly "from accounting service"
      described as {
        |Carries messages from the external AccountingService.
      }
    }
  } with {
    briefly "AccountingService integration"
    described as {
      |The model's side of the AccountingService conversation.
    }
  }
  adaptor FromCedingSystem from context CedingSystem is { 
    handler FromCedingSystemHandler is {
      on event CedingSystem.ClaimNotificationReceived is {
        do "the model receives claim notification received"
      }
      on other is {
        error "Unexpected message for adaptor FromCedingSystem"
      }
    } with {
      briefly "from ceding system"
      described as {
        |Carries messages from the external CedingSystem.
      }
    }
  } with {
    briefly "CedingSystem integration"
    described as {
      |The model's side of the CedingSystem conversation.
    }
  }
  type TreatyId is Id(TreatyManagement.TreatyContext.Treaty)  with {
    briefly "Unique identifier for a reinsurance treaty"
  }
  include "Treaty.riddl"
  repository TreatyRepository as merge is {
    command PersistBordereauReceived is  {
      treatyId: TreatyId with {
        briefly "Row addressed"
        described as {
          |Which stored row BordereauReceived applies to.
        }
      }
    } with {
      briefly "Persist BordereauReceived"
      described as {
        |Instructs this repository to apply BordereauReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCessionRecorded is  {
      treatyId: TreatyId with {
        briefly "Row addressed"
        described as {
          |Which stored row CessionRecorded applies to.
        }
      }
    } with {
      briefly "Persist CessionRecorded"
      described as {
        |Instructs this repository to apply CessionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSettlementProcessed is  {
      treatyId: TreatyId with {
        briefly "Row addressed"
        described as {
          |Which stored row SettlementProcessed applies to.
        }
      }
    } with {
      briefly "Persist SettlementProcessed"
      described as {
        |Instructs this repository to apply SettlementProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTreatyExecuted is  {
      treatyId: TreatyId with {
        briefly "Row addressed"
        described as {
          |Which stored row TreatyExecuted applies to.
        }
      }
    } with {
      briefly "Persist TreatyExecuted"
      described as {
        |Instructs this repository to apply TreatyExecuted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTreatyExpired is  {
      treatyId: TreatyId with {
        briefly "Row addressed"
        described as {
          |Which stored row TreatyExpired applies to.
        }
      }
    } with {
      briefly "Persist TreatyExpired"
      described as {
        |Instructs this repository to apply TreatyExpired to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredTreaty is  {
      treatyId: TreatyId with {
        briefly "treatyId"
        described as {
          |The treatyId column of the stored treaty row.
        }
      }
    } with {
      briefly "Stored treaty row"
      described as {
        |The persistence shape of treaty data as this repository stores it.
      }
    }
    schema TreatyData is relational
      of treatys as type StoredTreaty
        index on field StoredTreaty.treatyId
 with {
      briefly "Treaty data schema"
      described as {
        |The relational schema persisting treaty records for this repository.
      }
    }
    inlet TreatyRepositoryFromTreaty is type TreatyEvent    inlet TreatyRepositoryFromCessionMetricsProjector is type TreatyEvent    inlet TreatyRepositoryFromBordereauSummaryProjector is type TreatyEvent    inlet TreatyRepositoryFromSettlementLedgerProjector is type TreatyEvent    outlet TreatyRepositoryResponses is type Treaty.TreatyQueryResult
    query FindTreatyById is  {
      treatyId: TreatyId with {
        briefly "Treaty ID"
        described as {
          |Treaty to find.
        }
      }
    } with {
      briefly "Query to find treaty by ID"
    }
    query FindTreatiesByCedent is  {
      cedingCompanyId: String(1,100) with {
        briefly "Cedent"
        described as {
          |Ceding company ID.
        }
      }
      includeExpired: Boolean with {
        briefly "Include expired"
        described as {
          |Include expired treaties.
        }
      }
    } with {
      briefly "Query to find treaties by ceding company"
    }
    query FindTreatiesByReinsurer is  {
      reinsurerId: String(1,100) with {
        briefly "Reinsurer"
        described as {
          |Reinsurer ID.
        }
      }
      includeExpired: Boolean with {
        briefly "Include expired"
        described as {
          |Include expired treaties.
        }
      }
    } with {
      briefly "Query to find treaties by reinsurer"
    }
    query FindActiveTreaties is  {
      queryAsOfDate: Date? with {
        briefly "As of"
        described as {
          |Reference date.
        }
      }
    } with {
      briefly "Query to find active treaties"
    }
    query FindExpiringTreaties is  {
      startDate: Date with {
        briefly "Start"
        described as {
          |Range start.
        }
      }
      endDate: Date with {
        briefly "End"
        described as {
          |Range end.
        }
      }
    } with {
      briefly "Query to find expiring treaties"
    }
    query FindTreatiesByStatus is  {
      status: TreatyStatus with {
        briefly "Status"
        described as {
          |Status to filter.
        }
      }
    } with {
      briefly "Query to find treaties by status"
    }
    query GetTreatyHistory is  {
      treatyId: TreatyId with {
        briefly "Treaty ID"
        described as {
          |Treaty to query.
        }
      }
      fromDate: Date? with {
        briefly "From"
        described as {
          |History start date.
        }
      }
      toDate: Date? with {
        briefly "To"
        described as {
          |History end date.
        }
      }
    } with {
      briefly "Query to get treaty change history"
    }
    result TreatyRecord is  {
      treatyId: TreatyId with {
        briefly "Treaty ID"
        described as {
          |Treaty identifier.
        }
      }
      cedingCompanyId: String(1,100) with {
        briefly "Cedent"
        described as {
          |Ceding company.
        }
      }
      reinsurerId: String(1,100) with {
        briefly "Reinsurer"
        described as {
          |Reinsurer.
        }
      }
      status: TreatyStatus with {
        briefly "Status"
        described as {
          |Current status.
        }
      }
      terms: TreatyTerms with {
        briefly "Terms"
        described as {
          |Treaty terms.
        }
      }
      commission: CommissionInfo with {
        briefly "Commission"
        described as {
          |Commission info.
        }
      }
      treatyExecutionDate: Date? with {
        briefly "Executed"
        described as {
          |Execution date.
        }
      }
      cumulativeCededPremium: MonetaryAmount? with {
        briefly "Premium"
        described as {
          |Total ceded premium.
        }
      }
      cumulativePaidLosses: MonetaryAmount? with {
        briefly "Losses"
        described as {
          |Total paid losses.
        }
      }
    } with {
      briefly "Treaty data returned from queries"
    }
    result TreatyList is  {
      treaties: TreatyRecord+ with {
        briefly "Treaties"
        described as {
          |Treaty records.
        }
      }
      totalCount: Integer with {
        briefly "Count"
        described as {
          |Total count.
        }
      }
    } with {
      briefly "List of treaties from search queries"
    }
    handler TreatyQueries is {
      on persistBordereauReceived: command PersistBordereauReceived is {
        do "apply BordereauReceived to the stored row"
      }
      on persistCessionRecorded: command PersistCessionRecorded is {
        do "apply CessionRecorded to the stored row"
      }
      on persistSettlementProcessed: command PersistSettlementProcessed is {
        do "apply SettlementProcessed to the stored row"
      }
      on persistTreatyExecuted: command PersistTreatyExecuted is {
        do "apply TreatyExecuted to the stored row"
      }
      on persistTreatyExpired: command PersistTreatyExpired is {
        do "apply TreatyExpired to the stored row"
      }
      on query GetCessionMetrics is {
        let cessionMetricsView: type CessionMetricsView = prompt("read the cession metrics projection")
        reply cessionMetricsView
      }
      on query GetBordereauSummary is {
        let bordereauSummaryView: type BordereauSummaryView = prompt("read the bordereau summary projection")
        reply bordereauSummaryView
      }
      on query GetSettlementLedger is {
        let settlementLedgerView: type SettlementLedgerView = prompt("read the settlement ledger projection")
        reply settlementLedgerView
      }
      on findTreatyById: query FindTreatyById is {
        reply result TreatyResult(treatyId = findTreatyById.treatyId)
      }
      on query FindTreatiesByCedent is {
        let treatyResult: type TreatyResult = prompt("read the treaty that treaties by cedent asks for")
        reply treatyResult
      }
      on query FindTreatiesByReinsurer is {
        let treatyResult: type TreatyResult = prompt("read the treaty that treaties by reinsurer asks for")
        reply treatyResult
      }
      on query FindActiveTreaties is {
        let treatyResult: type TreatyResult = prompt("read the treaty that active treaties asks for")
        reply treatyResult
      }
      on query FindExpiringTreaties is {
        let treatyResult: type TreatyResult = prompt("read the treaty that expiring treaties asks for")
        reply treatyResult
      }
      on findTreatiesByStatus: query FindTreatiesByStatus is {
        reply result TreatyResult(status = findTreatiesByStatus.status)
      }
      on query GetTreatyHistory is {
        let treatyList: type TreatyList = prompt("read the treaty list that treaty history asks for")
        reply treatyList
      }
    } with {
      briefly "Query handler for treaty lookups"
      described as {
        |Handles all read operations against the treaty repository.
      }
    }
  } with {
    briefly "Repository for treaty persistence and queries"
    described as {
      | The TreatyRepository provides persistence and query
      | capabilities for treaty aggregates.
    }
  }
  query GetCessionMetrics is  {
    cessionMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which cession metrics to retrieve.
      }
    }
  } with {
    briefly "Get cession metrics"
    described as {
      |Retrieves the cession metrics projection.
    }
  }
  result CessionMetricsView is  {
    cessionMetrics: CessionMetricsProjector.CessionMetrics with {
      briefly "Cession metrics"
      described as {
        |The cession metrics being returned.
      }
    }
  } with {
    briefly "Cession metrics view"
    described as {
      |Read model view carrying the cession metrics projection.
    }
  }
  projector CessionMetricsProjector as flow is {
    updates repository TreatyContext.TreatyRepository
    inlet CessionMetricsProjectorFromTreaty is type TreatyEvent    outlet CessionMetricsProjectorOut is type TreatyEvent
    record CessionMetrics is  {
      treatyId: TreatyId with {
        briefly "Treaty ID"
        described as {
          |Related treaty.
        }
      }
      periodStart: Date with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Period end.
        }
      }
      cessionCount: Integer with {
        briefly "Count"
        described as {
          |Number of cessions.
        }
      }
      totalCededAmount: MonetaryAmount with {
        briefly "Ceded amount"
        described as {
          |Total ceded.
        }
      }
      totalCededPremium: MonetaryAmount with {
        briefly "Premium"
        described as {
          |Total premium.
        }
      }
      averageCessionSize: MonetaryAmount with {
        briefly "Average"
        described as {
          |Average cession size.
        }
      }
      utilizationPercentage: Percentage with {
        briefly "Utilization"
        described as {
          |Capacity used.
        }
      }
      largestCession: MonetaryAmount with {
        briefly "Largest"
        described as {
          |Largest cession.
        }
      }
      classOfBusinessBreakdown: String(1,2000) with {
        briefly "Breakdown"
        described as {
          |Class breakdown.
        }
      }
    } with {
      briefly "Aggregated cession metrics for a treaty"
      described as {
        |Read-optimized view of cession activity.
      }
    }
    handler CessionMetricsHandler is {
      on cessionRecorded: event Treaty.CessionRecorded is {
        tell command TreatyContext.TreatyRepository.PersistCessionRecorded(treatyId = cessionRecorded.treatyId) to repository TreatyContext.TreatyRepository
      }
      on treatyExecuted: event Treaty.TreatyExecuted is {
        tell command TreatyContext.TreatyRepository.PersistTreatyExecuted(treatyId = treatyExecuted.treatyId) to repository TreatyContext.TreatyRepository
      }
      on treatyExpired: event Treaty.TreatyExpired is {
        tell command TreatyContext.TreatyRepository.PersistTreatyExpired(treatyId = treatyExpired.treatyId) to repository TreatyContext.TreatyRepository
      }
    } with {
      briefly "Handler for cession metrics updates"
      described as {
        |Processes treaty events to maintain metrics.
      }
    }
  } with {
    briefly "Projector for cession analytics"
    described as {
      | The CessionMetricsProjector maintains a read-optimized
      | view of cession activity per treaty.
    }
  }
  query GetBordereauSummary is  {
    bordereauSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which bordereau summary to retrieve.
      }
    }
  } with {
    briefly "Get bordereau summary"
    described as {
      |Retrieves the bordereau summary projection.
    }
  }
  result BordereauSummaryView is  {
    bordereauSummary: BordereauSummaryProjector.BordereauSummary with {
      briefly "Bordereau summary"
      described as {
        |The bordereau summary being returned.
      }
    }
  } with {
    briefly "Bordereau summary view"
    described as {
      |Read model view carrying the bordereau summary projection.
    }
  }
  projector BordereauSummaryProjector as flow is {
    updates repository TreatyContext.TreatyRepository
    inlet BordereauSummaryProjectorFromTreaty is type TreatyEvent    outlet BordereauSummaryProjectorOut is type TreatyEvent
    record BordereauSummary is  {
      treatyId: TreatyId with {
        briefly "Treaty ID"
        described as {
          |Related treaty.
        }
      }
      totalBordereaux: Integer with {
        briefly "Count"
        described as {
          |Number submitted.
        }
      }
      lastSubmissionDate: Date with {
        briefly "Last submitted"
        described as {
          |Most recent submission.
        }
      }
      cumulativePremium: MonetaryAmount with {
        briefly "Premium"
        described as {
          |Cumulative premium.
        }
      }
      cumulativeIncurred: MonetaryAmount with {
        briefly "Incurred"
        described as {
          |Cumulative incurred.
        }
      }
      cumulativePaid: MonetaryAmount with {
        briefly "Paid"
        described as {
          |Cumulative paid.
        }
      }
      currentLossRatio: Percentage with {
        briefly "Loss ratio"
        described as {
          |Current loss ratio.
        }
      }
      outstandingReserves: MonetaryAmount with {
        briefly "Reserves"
        described as {
          |Outstanding reserves.
        }
      }
    } with {
      briefly "Summary of bordereau activity for a treaty"
      described as {
        |Aggregated view of all bordereau submissions.
      }
    }
    handler BordereauSummaryHandler is {
      on bordereauReceived: event Treaty.BordereauReceived is {
        tell command TreatyContext.TreatyRepository.PersistBordereauReceived(treatyId = bordereauReceived.treatyId) to repository TreatyContext.TreatyRepository
      }
      on settlementProcessed: event Treaty.SettlementProcessed is {
        tell command TreatyContext.TreatyRepository.PersistSettlementProcessed(treatyId = settlementProcessed.treatyId) to repository TreatyContext.TreatyRepository
      }
    } with {
      briefly "Handler for bordereau summary updates"
      described as {
        |Maintains running totals from bordereau submissions.
      }
    }
  } with {
    briefly "Projector for bordereau analytics"
    described as {
      | The BordereauSummaryProjector maintains cumulative views
      | of bordereau data for quick access to treaty metrics.
    }
  }
  query GetSettlementLedger is  {
    settlementLedgerKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which settlement ledger to retrieve.
      }
    }
  } with {
    briefly "Get settlement ledger"
    described as {
      |Retrieves the settlement ledger projection.
    }
  }
  result SettlementLedgerView is  {
    settlementLedger: SettlementLedgerProjector.SettlementLedger with {
      briefly "Settlement ledger"
      described as {
        |The settlement ledger being returned.
      }
    }
  } with {
    briefly "Settlement ledger view"
    described as {
      |Read model view carrying the settlement ledger projection.
    }
  }
  projector SettlementLedgerProjector as flow is {
    updates repository TreatyContext.TreatyRepository
    inlet SettlementLedgerProjectorFromTreaty is type TreatyEvent    outlet SettlementLedgerProjectorOut is type TreatyEvent
    record SettlementLedger is  {
      treatyId: TreatyId with {
        briefly "Treaty ID"
        described as {
          |Related treaty.
        }
      }
      settlements: SettlementInfo+ with {
        briefly "Settlements"
        described as {
          |Settlement history.
        }
      }
      netPositionCedent: MonetaryAmount with {
        briefly "Cedent position"
        described as {
          |Net owed to cedent.
        }
      }
      netPositionReinsurer: MonetaryAmount with {
        briefly "Reinsurer position"
        described as {
          |Net owed to reinsurer.
        }
      }
      lastSettlementDate: Date with {
        briefly "Last settlement"
        described as {
          |Most recent settlement.
        }
      }
      nextSettlementDue: Date? with {
        briefly "Next due"
        described as {
          |Next settlement date.
        }
      }
    } with {
      briefly "Running ledger of settlements for a treaty"
      described as {
        |Tracks all settlements and net positions.
      }
    }
    handler SettlementLedgerHandler is {
      on settlementProcessed: event Treaty.SettlementProcessed is {
        tell command TreatyContext.TreatyRepository.PersistSettlementProcessed(treatyId = settlementProcessed.treatyId) to repository TreatyContext.TreatyRepository
      }
    } with {
      briefly "Handler for settlement ledger updates"
      described as {
        |Maintains settlement history and balances.
      }
    }
  } with {
    briefly "Projector for settlement tracking"
    described as {
      | The SettlementLedgerProjector maintains a financial ledger
      | of all settlements for each treaty.
    }
  }
  // ---- Event publication for Treaty ----
  type TreatyEvent is one of {
    TreatyContext.Treaty.TreatyNegotiationStarted or TreatyContext.Treaty.TreatyExecuted or TreatyContext.Treaty.CessionRecorded or TreatyContext.Treaty.BordereauReceived or TreatyContext.Treaty.SettlementProcessed or TreatyContext.Treaty.TreatyRenewed or TreatyContext.Treaty.TreatySuspended or TreatyContext.Treaty.TreatyTerminated or TreatyContext.Treaty.TreatyExpired
  } with {
    briefly "Treaty event alternation"
    described as {
      |Union of all Treaty events, for streaming and event-sourced
      |persistence.
    }
  }
  processor TreatyEventSource as source is {
    outlet TreatyEvents is type TreatyEvent
    handler TreatySourceHandler is {
      on treatyNegotiationStarted: event Treaty.TreatyNegotiationStarted is {
        send treatyNegotiationStarted to outlet TreatyEvents
      }
      on treatyExecuted: event Treaty.TreatyExecuted is {
        send treatyExecuted to outlet TreatyEvents
      }
      on cessionRecorded: event Treaty.CessionRecorded is {
        send cessionRecorded to outlet TreatyEvents
      }
      on bordereauReceived: event Treaty.BordereauReceived is {
        send bordereauReceived to outlet TreatyEvents
      }
      on settlementProcessed: event Treaty.SettlementProcessed is {
        send settlementProcessed to outlet TreatyEvents
      }
      on treatyRenewed: event Treaty.TreatyRenewed is {
        send treatyRenewed to outlet TreatyEvents
      }
      on treatySuspended: event Treaty.TreatySuspended is {
        send treatySuspended to outlet TreatyEvents
      }
      on treatyTerminated: event Treaty.TreatyTerminated is {
        send treatyTerminated to outlet TreatyEvents
      }
      on treatyExpired: event Treaty.TreatyExpired is {
        send treatyExpired to outlet TreatyEvents
      }
      on other is {
        error "Unexpected message for source TreatyEventSource"
      }
    } with {
      briefly "Treaty source handler"
      described as {
        |Publishes Treaty events onto the outlet.
      }
    }
  } with {
    briefly "Treaty event source"
    described as {
      |Publishes Treaty entity events into the streaming topology.
    }
  }
  processor TreatyEventSink as sink is {
    inlet TreatyInlet is type TreatyEvent    handler TreatySinkHandler is {
      on treatyNegotiationStarted: event Treaty.TreatyNegotiationStarted is {
        tell treatyNegotiationStarted to repository TreatyContext.TreatyRepository
      }
      on treatyExecuted: event Treaty.TreatyExecuted is {
        tell treatyExecuted to repository TreatyContext.TreatyRepository
      }
      on cessionRecorded: event Treaty.CessionRecorded is {
        tell cessionRecorded to repository TreatyContext.TreatyRepository
      }
      on bordereauReceived: event Treaty.BordereauReceived is {
        tell bordereauReceived to repository TreatyContext.TreatyRepository
      }
      on settlementProcessed: event Treaty.SettlementProcessed is {
        tell settlementProcessed to repository TreatyContext.TreatyRepository
      }
      on treatyRenewed: event Treaty.TreatyRenewed is {
        tell treatyRenewed to repository TreatyContext.TreatyRepository
      }
      on treatySuspended: event Treaty.TreatySuspended is {
        tell treatySuspended to repository TreatyContext.TreatyRepository
      }
      on treatyTerminated: event Treaty.TreatyTerminated is {
        tell treatyTerminated to repository TreatyContext.TreatyRepository
      }
      on treatyExpired: event Treaty.TreatyExpired is {
        tell treatyExpired to repository TreatyContext.TreatyRepository
      }
      on other is {
        error "Unexpected message for sink TreatyEventSink"
      }
    } with {
      briefly "Treaty sink handler"
      described as {
        |Persists Treaty events via the repository.
      }
    }
  } with {
    briefly "Treaty event sink"
    described as {
      |Receives Treaty events for persistence.
    }
  }
  connector TreatyEventFlow is from outlet TreatyContext.TreatyEventSource.TreatyEvents to inlet TreatyContext.TreatyEventSink.TreatyInlet with {
    briefly "Treaty event flow"
    described as {
      |Connects the Treaty source to its sink.
    }
  }
  processor TreatyEventSplit as split is {
    inlet TreatyEventSplitIn is type TreatyEvent    outlet TreatyEventSplitToTreatyRepository is type TreatyEvent
    outlet TreatyEventSplitToCessionMetricsProjector is type TreatyEvent
    outlet TreatyEventSplitToBordereauSummaryProjector is type TreatyEvent
    outlet TreatyEventSplitToSettlementLedgerProjector is type TreatyEvent
    handler TreatyEventSplitHandler is {
      on treatyNegotiationStarted: event Treaty.TreatyNegotiationStarted is {
        send treatyNegotiationStarted to outlet TreatyEventSplitToTreatyRepository
        send treatyNegotiationStarted to outlet TreatyEventSplitToCessionMetricsProjector
        send treatyNegotiationStarted to outlet TreatyEventSplitToBordereauSummaryProjector
        send treatyNegotiationStarted to outlet TreatyEventSplitToSettlementLedgerProjector
        tell treatyNegotiationStarted to entity TreatyContext.Treaty
      }
      on treatyExecuted: event Treaty.TreatyExecuted is {
        send treatyExecuted to outlet TreatyEventSplitToTreatyRepository
        send treatyExecuted to outlet TreatyEventSplitToCessionMetricsProjector
        send treatyExecuted to outlet TreatyEventSplitToBordereauSummaryProjector
        send treatyExecuted to outlet TreatyEventSplitToSettlementLedgerProjector
        tell treatyExecuted to entity TreatyContext.Treaty
      }
      on cessionRecorded: event Treaty.CessionRecorded is {
        send cessionRecorded to outlet TreatyEventSplitToTreatyRepository
        send cessionRecorded to outlet TreatyEventSplitToCessionMetricsProjector
        send cessionRecorded to outlet TreatyEventSplitToBordereauSummaryProjector
        send cessionRecorded to outlet TreatyEventSplitToSettlementLedgerProjector
        tell cessionRecorded to entity TreatyContext.Treaty
      }
      on bordereauReceived: event Treaty.BordereauReceived is {
        send bordereauReceived to outlet TreatyEventSplitToTreatyRepository
        send bordereauReceived to outlet TreatyEventSplitToCessionMetricsProjector
        send bordereauReceived to outlet TreatyEventSplitToBordereauSummaryProjector
        send bordereauReceived to outlet TreatyEventSplitToSettlementLedgerProjector
        tell bordereauReceived to entity TreatyContext.Treaty
      }
      on settlementProcessed: event Treaty.SettlementProcessed is {
        send settlementProcessed to outlet TreatyEventSplitToTreatyRepository
        send settlementProcessed to outlet TreatyEventSplitToCessionMetricsProjector
        send settlementProcessed to outlet TreatyEventSplitToBordereauSummaryProjector
        send settlementProcessed to outlet TreatyEventSplitToSettlementLedgerProjector
        tell settlementProcessed to entity TreatyContext.Treaty
      }
      on treatyRenewed: event Treaty.TreatyRenewed is {
        send treatyRenewed to outlet TreatyEventSplitToTreatyRepository
        send treatyRenewed to outlet TreatyEventSplitToCessionMetricsProjector
        send treatyRenewed to outlet TreatyEventSplitToBordereauSummaryProjector
        send treatyRenewed to outlet TreatyEventSplitToSettlementLedgerProjector
        tell treatyRenewed to entity TreatyContext.Treaty by treatyId
      }
      on treatySuspended: event Treaty.TreatySuspended is {
        send treatySuspended to outlet TreatyEventSplitToTreatyRepository
        send treatySuspended to outlet TreatyEventSplitToCessionMetricsProjector
        send treatySuspended to outlet TreatyEventSplitToBordereauSummaryProjector
        send treatySuspended to outlet TreatyEventSplitToSettlementLedgerProjector
        tell treatySuspended to entity TreatyContext.Treaty
      }
      on treatyTerminated: event Treaty.TreatyTerminated is {
        send treatyTerminated to outlet TreatyEventSplitToTreatyRepository
        send treatyTerminated to outlet TreatyEventSplitToCessionMetricsProjector
        send treatyTerminated to outlet TreatyEventSplitToBordereauSummaryProjector
        send treatyTerminated to outlet TreatyEventSplitToSettlementLedgerProjector
        tell treatyTerminated to entity TreatyContext.Treaty
      }
      on treatyExpired: event Treaty.TreatyExpired is {
        send treatyExpired to outlet TreatyEventSplitToTreatyRepository
        send treatyExpired to outlet TreatyEventSplitToCessionMetricsProjector
        send treatyExpired to outlet TreatyEventSplitToBordereauSummaryProjector
        send treatyExpired to outlet TreatyEventSplitToSettlementLedgerProjector
        tell treatyExpired to entity TreatyContext.Treaty
      }
      on other is {
        error "Unexpected message for processor TreatyEventSplit"
      }
    } with {
      briefly "Treaty event fan-out handler"
      described as {
        |Delivers each Treaty event to all of its consumers.
      }
    }
  } with {
    briefly "Treaty event fan-out"
    described as {
      |Fans Treaty events out to the repository and projectors.
    }
  }
  connector 'TreatyEvent Stream' is from outlet TreatyContext.Treaty.TreatyEvents2 to inlet TreatyContext.TreatyEventSplit.TreatyEventSplitIn with {
    briefly "Treaty events, fanned out to storage and read models"
  }
  connector 'TreatyEvent Storage' is from outlet TreatyContext.TreatyEventSplit.TreatyEventSplitToTreatyRepository to inlet TreatyContext.TreatyRepository.TreatyRepositoryFromTreaty with {
    briefly "Treaty events on their way to storage"
  }
  connector 'CessionMetricsProjector Feed' is from outlet TreatyContext.TreatyEventSplit.TreatyEventSplitToCessionMetricsProjector to inlet TreatyContext.CessionMetricsProjector.CessionMetricsProjectorFromTreaty with {
    briefly "Treaty events feeding the CessionMetricsProjector projection"
  }
  connector 'BordereauSummaryProjector Feed' is from outlet TreatyContext.TreatyEventSplit.TreatyEventSplitToBordereauSummaryProjector to inlet TreatyContext.BordereauSummaryProjector.BordereauSummaryProjectorFromTreaty with {
    briefly "Treaty events feeding the BordereauSummaryProjector projection"
  }
  connector 'SettlementLedgerProjector Feed' is from outlet TreatyContext.TreatyEventSplit.TreatyEventSplitToSettlementLedgerProjector to inlet TreatyContext.SettlementLedgerProjector.SettlementLedgerProjectorFromTreaty with {
    briefly "Treaty events feeding the SettlementLedgerProjector projection"
  }
  connector 'CessionMetricsProjector Storage' is from outlet TreatyContext.CessionMetricsProjector.CessionMetricsProjectorOut to inlet TreatyContext.TreatyRepository.TreatyRepositoryFromCessionMetricsProjector with {
    briefly "The CessionMetricsProjector projection on its way to storage"
  }
  connector 'BordereauSummaryProjector Storage' is from outlet TreatyContext.BordereauSummaryProjector.BordereauSummaryProjectorOut to inlet TreatyContext.TreatyRepository.TreatyRepositoryFromBordereauSummaryProjector with {
    briefly "The BordereauSummaryProjector projection on its way to storage"
  }
  connector 'SettlementLedgerProjector Storage' is from outlet TreatyContext.SettlementLedgerProjector.SettlementLedgerProjectorOut to inlet TreatyContext.TreatyRepository.TreatyRepositoryFromSettlementLedgerProjector with {
    briefly "The SettlementLedgerProjector projection on its way to storage"
  }
} with {
  briefly "Bounded context for treaty management"
  described as {
    | The TreatyContext encapsulates all treaty management
    | functionality including the Treaty aggregate, repository
    | for persistence, and projectors for analytics.
  }
}
