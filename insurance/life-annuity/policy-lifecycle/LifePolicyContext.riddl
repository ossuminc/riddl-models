// Life Policy Context - Bounded context for policy lifecycle management
context LifePolicyContext as router is {
  inlet LifePolicyCommandStreamIn is type LifePolicyCommand  outlet LifePolicyCommandStreamOut is type LifePolicyCommand
  inlet LifePolicyResultStreamIn is type LifePolicy.LifePolicyResult  outlet LifePolicyResultStreamOut is type LifePolicy.LifePolicyResult
  handler LifePolicyContextBoundary is {
    on issueLifePolicy: command LifePolicy.IssueLifePolicy is {
      send issueLifePolicy to outlet LifePolicyContext.LifePolicyCommandStreamOut
    }
    on addBeneficiary: command LifePolicy.AddBeneficiary is {
      send addBeneficiary to outlet LifePolicyContext.LifePolicyCommandStreamOut
    }
    on removeBeneficiary: command LifePolicy.RemoveBeneficiary is {
      send removeBeneficiary to outlet LifePolicyContext.LifePolicyCommandStreamOut
    }
    on addRider: command LifePolicy.AddRider is {
      send addRider to outlet LifePolicyContext.LifePolicyCommandStreamOut
    }
    on removeRider: command LifePolicy.RemoveRider is {
      send removeRider to outlet LifePolicyContext.LifePolicyCommandStreamOut
    }
    on processPremium: command LifePolicy.ProcessPremium is {
      send processPremium to outlet LifePolicyContext.LifePolicyCommandStreamOut
    }
    on requestLoan: command LifePolicy.RequestLoan is {
      send requestLoan to outlet LifePolicyContext.LifePolicyCommandStreamOut
    }
    on repayLoan: command LifePolicy.RepayLoan is {
      send repayLoan to outlet LifePolicyContext.LifePolicyCommandStreamOut
    }
    on surrenderPolicy: command LifePolicy.SurrenderPolicy is {
      send surrenderPolicy to outlet LifePolicyContext.LifePolicyCommandStreamOut
    }
    on processDeath: command LifePolicy.ProcessDeath is {
      send processDeath to outlet LifePolicyContext.LifePolicyCommandStreamOut
    }
    on lapsePolicy: command LifePolicy.LapsePolicy is {
      send lapsePolicy to outlet LifePolicyContext.LifePolicyCommandStreamOut
    }
    on reinstatePolicyFromLapse: command LifePolicy.ReinstatePolicyFromLapse is {
      send reinstatePolicyFromLapse to outlet LifePolicyContext.LifePolicyCommandStreamOut
    }
    on initializeLifePolicy: command LifePolicy.InitializeLifePolicy is {
      send initializeLifePolicy to outlet LifePolicyContext.LifePolicyCommandStreamOut
    }
    on lifePolicyResult: result LifePolicy.LifePolicyResult is {
      send lifePolicyResult to outlet LifePolicyContext.LifePolicyResultStreamOut
    }
    on other is {
      error "Unexpected message at the LifePolicyContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'LifePolicyCommand Stream Intake' is from outlet LifePolicyContext.LifePolicyCommandStreamOut to inlet LifePolicyContext.LifePolicy.LifePolicyCommands  connector 'LifePolicyResult Stream Egress' is from outlet LifePolicyContext.LifePolicyRepository.LifePolicyRepositoryResponses to inlet LifePolicyContext.LifePolicyResultStreamIn  include "types.riddl"
  include "LifePolicy.riddl"
  // Repository for policy persistence
  repository LifePolicyRepository as merge is {
    command PersistDeathClaimInitiated is  {
      policyId: LifePolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeathClaimInitiated applies to.
        }
      }
    } with {
      briefly "Persist DeathClaimInitiated"
      described as {
        |Instructs this repository to apply DeathClaimInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLifePolicyIssued is  {
      policyId: LifePolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row LifePolicyIssued applies to.
        }
      }
    } with {
      briefly "Persist LifePolicyIssued"
      described as {
        |Instructs this repository to apply LifePolicyIssued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLoanDisbursed is  {
      policyId: LifePolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row LoanDisbursed applies to.
        }
      }
    } with {
      briefly "Persist LoanDisbursed"
      described as {
        |Instructs this repository to apply LoanDisbursed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPolicyLapsed is  {
      policyId: LifePolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row PolicyLapsed applies to.
        }
      }
    } with {
      briefly "Persist PolicyLapsed"
      described as {
        |Instructs this repository to apply PolicyLapsed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPolicyReinstated is  {
      policyId: LifePolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row PolicyReinstated applies to.
        }
      }
    } with {
      briefly "Persist PolicyReinstated"
      described as {
        |Instructs this repository to apply PolicyReinstated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPolicySurrendered is  {
      policyId: LifePolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row PolicySurrendered applies to.
        }
      }
    } with {
      briefly "Persist PolicySurrendered"
      described as {
        |Instructs this repository to apply PolicySurrendered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPremiumProcessed is  {
      policyId: LifePolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row PremiumProcessed applies to.
        }
      }
    } with {
      briefly "Persist PremiumProcessed"
      described as {
        |Instructs this repository to apply PremiumProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredLifePolicy is  {
      lifePolicyId: LifePolicyId with {
        briefly "lifePolicyId"
        described as {
          |The lifePolicyId column of the stored lifePolicy row.
        }
      }
    } with {
      briefly "Stored lifePolicy row"
      described as {
        |The persistence shape of lifePolicy data as this repository stores it.
      }
    }
    schema LifePolicyData is relational
      of lifepolicys as type StoredLifePolicy
        index on field StoredLifePolicy.lifePolicyId
 with {
      briefly "Life policy data schema"
      described as {
        |The relational schema persisting life policy records for this repository.
      }
    }
    inlet LifePolicyRepositoryFromLifePolicy is type LifePolicyEvent    inlet LifePolicyRepositoryFromLifePolicyMetricsProjector is type LifePolicyEvent    outlet LifePolicyRepositoryResponses is type LifePolicy.LifePolicyResult
    handler LifePolicyRepositoryHandler is {
      on persistDeathClaimInitiated: command PersistDeathClaimInitiated is {
        do "apply DeathClaimInitiated to the stored row"
      }
      on persistLifePolicyIssued: command PersistLifePolicyIssued is {
        do "apply LifePolicyIssued to the stored row"
      }
      on persistLoanDisbursed: command PersistLoanDisbursed is {
        do "apply LoanDisbursed to the stored row"
      }
      on persistPolicyLapsed: command PersistPolicyLapsed is {
        do "apply PolicyLapsed to the stored row"
      }
      on persistPolicyReinstated: command PersistPolicyReinstated is {
        do "apply PolicyReinstated to the stored row"
      }
      on persistPolicySurrendered: command PersistPolicySurrendered is {
        do "apply PolicySurrendered to the stored row"
      }
      on persistPremiumProcessed: command PersistPremiumProcessed is {
        do "apply PremiumProcessed to the stored row"
      }
      on query GetPersistencyMetrics is {
        let persistencyMetricsView: type PersistencyMetricsView = prompt("read the persistency metrics projection")
        reply persistencyMetricsView
      }
      on query GetProductionMetrics is {
        let productionMetricsView: type ProductionMetricsView = prompt("read the production metrics projection")
        reply productionMetricsView
      }
      on query GetClaimsMetrics is {
        let claimsMetricsView: type ClaimsMetricsView = prompt("read the claims metrics projection")
        reply claimsMetricsView
      }
      on query GetLoanMetrics is {
        let loanMetricsView: type LoanMetricsView = prompt("read the loan metrics projection")
        reply loanMetricsView
      }
      on issueLifePolicy: command IssueLifePolicy is {
        tell event LifePolicyIssued(policyId = issueLifePolicy.policyId) to entity LifePolicy
      }
      on addBeneficiary: command AddBeneficiary is {
        tell event BeneficiaryAdded(policyId = addBeneficiary.policyId, beneficiary = addBeneficiary.beneficiary) to entity LifePolicy
      }
      on removeBeneficiary: command RemoveBeneficiary is {
        tell event BeneficiaryRemoved(policyId = removeBeneficiary.policyId, beneficiaryId = removeBeneficiary.beneficiaryId) to entity LifePolicy
      }
      on addRider: command AddRider is {
        tell event RiderAdded(policyId = addRider.policyId, rider = addRider.rider) to entity LifePolicy
      }
      on removeRider: command RemoveRider is {
        tell event RiderRemoved(policyId = removeRider.policyId, riderId = removeRider.riderId) to entity LifePolicy
      }
      on processPremium: command ProcessPremium is {
        tell event PremiumProcessed(policyId = processPremium.policyId, payment = processPremium.payment) to entity LifePolicy
      }
      on requestLoan: command RequestLoan is {
        tell event LoanDisbursed(policyId = requestLoan.policyId) to entity LifePolicy
      }
      on repayLoan: command RepayLoan is {
        tell event LoanRepaid(policyId = repayLoan.policyId) to entity LifePolicy
      }
      on surrenderPolicy: command SurrenderPolicy is {
        tell event PolicySurrendered(policyId = surrenderPolicy.policyId) to entity LifePolicy
      }
      on processDeath: command ProcessDeath is {
        tell event DeathClaimInitiated(policyId = processDeath.policyId, claimInfo = processDeath.claimInfo) to entity LifePolicy
      }
      on lapsePolicy: command LapsePolicy is {
        tell event PolicyLapsed(policyId = lapsePolicy.policyId, lapseDate = lapsePolicy.lapseDate, reason = lapsePolicy.reason) to entity LifePolicy
      }
      on reinstatePolicyFromLapse: command ReinstatePolicyFromLapse is {
        tell event PolicyReinstated(policyId = reinstatePolicyFromLapse.policyId, reinstateDate = reinstatePolicyFromLapse.reinstateDate) to entity LifePolicy
      }
    } with {
      briefly "Repository handler for policy events"
      described as {
        |Handles persistence operations for all life policy events.
      }
    }
  } with {
    briefly "Life policy data repository"
    described as {
      |Provides persistence and retrieval capabilities for life insurance policies.
    }
  }
  // Projector for policy metrics and reporting
  query GetPersistencyMetrics is  {
    persistencyMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which persistency metrics to retrieve.
      }
    }
  } with {
    briefly "Get persistency metrics"
    described as {
      |Retrieves the persistency metrics projection.
    }
  }
  result PersistencyMetricsView is  {
    persistencyMetrics: LifePolicyMetricsProjector.PersistencyMetrics with {
      briefly "Persistency metrics"
      described as {
        |The persistency metrics being returned.
      }
    }
  } with {
    briefly "Persistency metrics view"
    described as {
      |Read model view carrying the persistency metrics projection.
    }
  }
  query GetProductionMetrics is  {
    productionMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which production metrics to retrieve.
      }
    }
  } with {
    briefly "Get production metrics"
    described as {
      |Retrieves the production metrics projection.
    }
  }
  result ProductionMetricsView is  {
    productionMetrics: LifePolicyMetricsProjector.ProductionMetrics with {
      briefly "Production metrics"
      described as {
        |The production metrics being returned.
      }
    }
  } with {
    briefly "Production metrics view"
    described as {
      |Read model view carrying the production metrics projection.
    }
  }
  query GetClaimsMetrics is  {
    claimsMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which claims metrics to retrieve.
      }
    }
  } with {
    briefly "Get claims metrics"
    described as {
      |Retrieves the claims metrics projection.
    }
  }
  result ClaimsMetricsView is  {
    claimsMetrics: LifePolicyMetricsProjector.ClaimsMetrics with {
      briefly "Claims metrics"
      described as {
        |The claims metrics being returned.
      }
    }
  } with {
    briefly "Claims metrics view"
    described as {
      |Read model view carrying the claims metrics projection.
    }
  }
  query GetLoanMetrics is  {
    loanMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which loan metrics to retrieve.
      }
    }
  } with {
    briefly "Get loan metrics"
    described as {
      |Retrieves the loan metrics projection.
    }
  }
  result LoanMetricsView is  {
    loanMetrics: LifePolicyMetricsProjector.LoanMetrics with {
      briefly "Loan metrics"
      described as {
        |The loan metrics being returned.
      }
    }
  } with {
    briefly "Loan metrics view"
    described as {
      |Read model view carrying the loan metrics projection.
    }
  }
  projector LifePolicyMetricsProjector as flow is {
    updates repository LifePolicyContext.LifePolicyRepository
    inlet LifePolicyMetricsProjectorFromLifePolicy is type LifePolicyEvent    outlet LifePolicyMetricsProjectorOut is type LifePolicyEvent
    record PersistencyMetrics is  {
      totalPoliciesInForce: Natural with {
        briefly "Policies in force"
        described as {
          |Total number of active policies.
        }
      }
      totalFaceAmount: Money with {
        briefly "Total face amount"
        described as {
          |Sum of face amounts for all active policies.
        }
      }
      totalAnnualPremium: Money with {
        briefly "Total annual premium"
        described as {
          |Sum of annualized premiums for all active policies.
        }
      }
      lapseRateYTD: Decimal(5,4) with {
        briefly "Lapse rate YTD"
        described as {
          |Year-to-date lapse rate as a decimal.
        }
      }
      surrenderRateYTD: Decimal(5,4) with {
        briefly "Surrender rate YTD"
        described as {
          |Year-to-date surrender rate as a decimal.
        }
      }
      reinstatementRateYTD: Decimal(5,4) with {
        briefly "Reinstatement rate YTD"
        described as {
          |Year-to-date reinstatement rate as a decimal.
        }
      }
      averagePolicyDuration: Decimal(8,2) with {
        briefly "Average policy duration"
        described as {
          |Average duration of policies in months.
        }
      }
      reportDate: Date with {
        briefly "Report date"
        described as {
          |Date of the metrics report.
        }
      }
    } with {
      briefly "Persistency metrics record"
      described as {
        |Aggregate metrics tracking policy persistency and retention rates.
      }
    }
    record ProductionMetrics is  {
      policiesIssuedYTD: Natural with {
        briefly "Policies issued YTD"
        described as {
          |Number of policies issued year-to-date.
        }
      }
      faceAmountIssuedYTD: Money with {
        briefly "Face amount issued YTD"
        described as {
          |Total face amount issued year-to-date.
        }
      }
      premiumIssuedYTD: Money with {
        briefly "Premium issued YTD"
        described as {
          |Total premium issued year-to-date.
        }
      }
      averageFaceAmount: Money with {
        briefly "Average face amount"
        described as {
          |Average face amount per policy.
        }
      }
      averagePremium: Money with {
        briefly "Average premium"
        described as {
          |Average premium per policy.
        }
      }
      reportDate: Date with {
        briefly "Report date"
        described as {
          |Date of the metrics report.
        }
      }
    } with {
      briefly "Production metrics record"
      described as {
        |Aggregate metrics tracking new business production.
      }
    }
    record ClaimsMetrics is  {
      claimsFiledYTD: Natural with {
        briefly "Claims filed YTD"
        described as {
          |Number of death claims filed year-to-date.
        }
      }
      claimsPaidYTD: Natural with {
        briefly "Claims paid YTD"
        described as {
          |Number of death claims paid year-to-date.
        }
      }
      totalClaimsAmountPaid: Money with {
        briefly "Total claims paid"
        described as {
          |Total death benefits paid year-to-date.
        }
      }
      averageClaimAmount: Money with {
        briefly "Average claim amount"
        described as {
          |Average death benefit per claim.
        }
      }
      mortalityRatioActualToExpected: Decimal(5,4) with {
        briefly "A/E mortality ratio"
        described as {
          |Actual to expected mortality ratio.
        }
      }
      reportDate: Date with {
        briefly "Report date"
        described as {
          |Date of the metrics report.
        }
      }
    } with {
      briefly "Claims metrics record"
      described as {
        |Aggregate metrics tracking death claims and mortality experience.
      }
    }
    record LoanMetrics is  {
      totalLoanBalance: Money with {
        briefly "Total loan balance"
        described as {
          |Aggregate outstanding loan balance.
        }
      }
      policiesWithLoans: Natural with {
        briefly "Policies with loans"
        described as {
          |Number of policies with outstanding loans.
        }
      }
      averageLoanToValueRatio: Decimal(5,4) with {
        briefly "Average LTV ratio"
        described as {
          |Average loan-to-value ratio.
        }
      }
      loanUtilizationRate: Decimal(5,4) with {
        briefly "Loan utilization rate"
        described as {
          |Percentage of available loan value utilized.
        }
      }
      reportDate: Date with {
        briefly "Report date"
        described as {
          |Date of the metrics report.
        }
      }
    } with {
      briefly "Loan metrics record"
      described as {
        |Aggregate metrics tracking policy loan utilization.
      }
    }
    handler LifePolicyMetricsHandler is {
      on lifePolicyIssued: event LifePolicyIssued is {
        tell command LifePolicyContext.LifePolicyRepository.PersistLifePolicyIssued(policyId = lifePolicyIssued.policyId) to repository LifePolicyContext.LifePolicyRepository
      }
      on premiumProcessed: event PremiumProcessed is {
        tell command LifePolicyContext.LifePolicyRepository.PersistPremiumProcessed(policyId = premiumProcessed.policyId) to repository LifePolicyContext.LifePolicyRepository
      }
      on policySurrendered: event PolicySurrendered is {
        tell command LifePolicyContext.LifePolicyRepository.PersistPolicySurrendered(policyId = policySurrendered.policyId) to repository LifePolicyContext.LifePolicyRepository
      }
      on policyLapsed: event PolicyLapsed is {
        tell command LifePolicyContext.LifePolicyRepository.PersistPolicyLapsed(policyId = policyLapsed.policyId) to repository LifePolicyContext.LifePolicyRepository
      }
      on policyReinstated: event PolicyReinstated is {
        tell command LifePolicyContext.LifePolicyRepository.PersistPolicyReinstated(policyId = policyReinstated.policyId) to repository LifePolicyContext.LifePolicyRepository
      }
      on deathClaimInitiated: event DeathClaimInitiated is {
        tell command LifePolicyContext.LifePolicyRepository.PersistDeathClaimInitiated(policyId = deathClaimInitiated.policyId) to repository LifePolicyContext.LifePolicyRepository
      }
      on loanDisbursed: event LoanDisbursed is {
        tell command LifePolicyContext.LifePolicyRepository.PersistLoanDisbursed(policyId = loanDisbursed.policyId) to repository LifePolicyContext.LifePolicyRepository
      }
    } with {
      briefly "Metrics projector handler"
      described as {
        |Handles events to maintain persistency and performance metrics.
      }
    }
  } with {
    briefly "Persistency metrics projector"
    described as {
      | Maintains read-optimized views of policy persistency metrics including
      | in-force counts, lapse rates, production, and claims experience.
    }
  }
  processor LifePolicyEventSource as source is {
    outlet LifePolicyEvents is type LifePolicyEvent
    handler LifePolicyEventEmitter is {
      on init is {
        let initializeLifePolicy: type InitializeLifePolicy = prompt("the initialize life policy that brings this this into existence")
        tell initializeLifePolicy to entity LifePolicy
      }
      on other is {
        error "Unexpected message for source LifePolicyEventSource"
      }
      on lifePolicyIssued: event LifePolicyIssued is {
        send lifePolicyIssued to outlet LifePolicyEvents
      }
      on policySurrendered: event PolicySurrendered is {
        send policySurrendered to outlet LifePolicyEvents
      }
      on policyLapsed: event PolicyLapsed is {
        send policyLapsed to outlet LifePolicyEvents
      }
      on deathClaimInitiated: event DeathClaimInitiated is {
        send deathClaimInitiated to outlet LifePolicyEvents
      }
      on policyReinstated: event PolicyReinstated is {
        send policyReinstated to outlet LifePolicyEvents
      }
    } with {
      briefly "Life policy event emitter"
      described as {
        |Emits life policy lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Life policy event source"
    described as {
      |Publishes life policy entity events for streaming.
    }
  }
  processor LifePolicyEventSink as sink is {
    inlet IncomingLifePolicyEvents is type LifePolicyEvent    handler LifePolicyEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink LifePolicyEventSink"
      }
      on lifePolicyIssued: event LifePolicyIssued is {
        tell lifePolicyIssued to repository LifePolicyContext.LifePolicyRepository
      }
      on policyLapsed: event PolicyLapsed is {
        tell policyLapsed to repository LifePolicyContext.LifePolicyRepository
      }
    } with {
      briefly "Life policy event receiver"
      described as {
        |Receives life policy events and persists them.
      }
    }
  } with {
    briefly "Life policy event sink"
    described as {
      |Receives life policy events from the streaming topology.
    }
  }
  connector LifePolicyEventPipeline is from outlet LifePolicyContext.LifePolicyEventSource.LifePolicyEvents to inlet LifePolicyContext.LifePolicyEventSink.IncomingLifePolicyEvents with {
    briefly "Life policy event pipeline"
    described as {
      |Wires life policy events from source to sink.
    }
  }
  processor LifePolicyEventSplit as split is {
    inlet LifePolicyEventSplitIn is type LifePolicyEvent    outlet LifePolicyEventSplitToLifePolicyRepository is type LifePolicyEvent
    outlet LifePolicyEventSplitToLifePolicyMetricsProjector is type LifePolicyEvent
    handler LifePolicyEventSplitHandler is {
      on lifePolicyIssued: event LifePolicy.LifePolicyIssued is {
        send lifePolicyIssued to outlet LifePolicyEventSplitToLifePolicyRepository
        send lifePolicyIssued to outlet LifePolicyEventSplitToLifePolicyMetricsProjector
        tell lifePolicyIssued to entity LifePolicyContext.LifePolicy
      }
      on beneficiaryAdded: event LifePolicy.BeneficiaryAdded is {
        send beneficiaryAdded to outlet LifePolicyEventSplitToLifePolicyRepository
        send beneficiaryAdded to outlet LifePolicyEventSplitToLifePolicyMetricsProjector
        tell beneficiaryAdded to entity LifePolicyContext.LifePolicy
      }
      on beneficiaryRemoved: event LifePolicy.BeneficiaryRemoved is {
        send beneficiaryRemoved to outlet LifePolicyEventSplitToLifePolicyRepository
        send beneficiaryRemoved to outlet LifePolicyEventSplitToLifePolicyMetricsProjector
        tell beneficiaryRemoved to entity LifePolicyContext.LifePolicy
      }
      on riderAdded: event LifePolicy.RiderAdded is {
        send riderAdded to outlet LifePolicyEventSplitToLifePolicyRepository
        send riderAdded to outlet LifePolicyEventSplitToLifePolicyMetricsProjector
        tell riderAdded to entity LifePolicyContext.LifePolicy
      }
      on riderRemoved: event LifePolicy.RiderRemoved is {
        send riderRemoved to outlet LifePolicyEventSplitToLifePolicyRepository
        send riderRemoved to outlet LifePolicyEventSplitToLifePolicyMetricsProjector
        tell riderRemoved to entity LifePolicyContext.LifePolicy
      }
      on premiumProcessed: event LifePolicy.PremiumProcessed is {
        send premiumProcessed to outlet LifePolicyEventSplitToLifePolicyRepository
        send premiumProcessed to outlet LifePolicyEventSplitToLifePolicyMetricsProjector
        tell premiumProcessed to entity LifePolicyContext.LifePolicy
      }
      on loanDisbursed: event LifePolicy.LoanDisbursed is {
        send loanDisbursed to outlet LifePolicyEventSplitToLifePolicyRepository
        send loanDisbursed to outlet LifePolicyEventSplitToLifePolicyMetricsProjector
        tell loanDisbursed to entity LifePolicyContext.LifePolicy
      }
      on loanRepaid: event LifePolicy.LoanRepaid is {
        send loanRepaid to outlet LifePolicyEventSplitToLifePolicyRepository
        send loanRepaid to outlet LifePolicyEventSplitToLifePolicyMetricsProjector
        tell loanRepaid to entity LifePolicyContext.LifePolicy
      }
      on policySurrendered: event LifePolicy.PolicySurrendered is {
        send policySurrendered to outlet LifePolicyEventSplitToLifePolicyRepository
        send policySurrendered to outlet LifePolicyEventSplitToLifePolicyMetricsProjector
        tell policySurrendered to entity LifePolicyContext.LifePolicy
      }
      on deathClaimInitiated: event LifePolicy.DeathClaimInitiated is {
        send deathClaimInitiated to outlet LifePolicyEventSplitToLifePolicyRepository
        send deathClaimInitiated to outlet LifePolicyEventSplitToLifePolicyMetricsProjector
        tell deathClaimInitiated to entity LifePolicyContext.LifePolicy
      }
      on policyLapsed: event LifePolicy.PolicyLapsed is {
        send policyLapsed to outlet LifePolicyEventSplitToLifePolicyRepository
        send policyLapsed to outlet LifePolicyEventSplitToLifePolicyMetricsProjector
        tell policyLapsed to entity LifePolicyContext.LifePolicy
      }
      on policyReinstated: event LifePolicy.PolicyReinstated is {
        send policyReinstated to outlet LifePolicyEventSplitToLifePolicyRepository
        send policyReinstated to outlet LifePolicyEventSplitToLifePolicyMetricsProjector
        tell policyReinstated to entity LifePolicyContext.LifePolicy
      }
      on other is {
        error "Unexpected message for processor LifePolicyEventSplit"
      }
    } with {
      briefly "LifePolicy event fan-out handler"
      described as {
        |Delivers each LifePolicy event to all of its consumers.
      }
    }
  } with {
    briefly "LifePolicy event fan-out"
    described as {
      |Fans LifePolicy events out to the repository and projectors.
    }
  }
  connector 'LifePolicyEvent Stream' is from outlet LifePolicyContext.LifePolicy.LifePolicyEvents2 to inlet LifePolicyContext.LifePolicyEventSplit.LifePolicyEventSplitIn with {
    briefly "LifePolicy events, fanned out to storage and read models"
  }
  connector 'LifePolicyEvent Storage' is from outlet LifePolicyContext.LifePolicyEventSplit.LifePolicyEventSplitToLifePolicyRepository to inlet LifePolicyContext.LifePolicyRepository.LifePolicyRepositoryFromLifePolicy with {
    briefly "LifePolicy events on their way to storage"
  }
  connector 'LifePolicyMetricsProjector Feed' is from outlet LifePolicyContext.LifePolicyEventSplit.LifePolicyEventSplitToLifePolicyMetricsProjector to inlet LifePolicyContext.LifePolicyMetricsProjector.LifePolicyMetricsProjectorFromLifePolicy with {
    briefly "LifePolicy events feeding the LifePolicyMetricsProjector projection"
  }
  connector 'LifePolicyMetricsProjector Storage' is from outlet LifePolicyContext.LifePolicyMetricsProjector.LifePolicyMetricsProjectorOut to inlet LifePolicyContext.LifePolicyRepository.LifePolicyRepositoryFromLifePolicyMetricsProjector with {
    briefly "The LifePolicyMetricsProjector projection on its way to storage"
  }
} with {
  briefly "Life policy lifecycle bounded context"
  described as {
    | The LifePolicyContext provides the bounded context for managing life
    | insurance policy lifecycles including the entity, repository, projector,
    | and integration points with external services.
  }
}
