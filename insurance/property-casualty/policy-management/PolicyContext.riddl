// Policy Management - Policy Context
context PolicyContext as router is {
  inlet PolicyCommandStreamIn is type PolicyCommand  outlet PolicyCommandStreamOut is type PolicyCommand
  inlet PolicyResultStreamIn is type Policy.PolicyResult  outlet PolicyResultStreamOut is type Policy.PolicyResult
  handler PolicyContextBoundary is {
    on issuePolicy: command Policy.IssuePolicy is {
      send issuePolicy to outlet PolicyContext.PolicyCommandStreamOut
    }
    on bindPolicy: command Policy.BindPolicy is {
      send bindPolicy to outlet PolicyContext.PolicyCommandStreamOut
    }
    on addEndorsement: command Policy.AddEndorsement is {
      send addEndorsement to outlet PolicyContext.PolicyCommandStreamOut
    }
    on processRenewal: command Policy.ProcessRenewal is {
      send processRenewal to outlet PolicyContext.PolicyCommandStreamOut
    }
    on acceptRenewal: command Policy.AcceptRenewal is {
      send acceptRenewal to outlet PolicyContext.PolicyCommandStreamOut
    }
    on suspendPolicy: command Policy.SuspendPolicy is {
      send suspendPolicy to outlet PolicyContext.PolicyCommandStreamOut
    }
    on reinstatePolicy: command Policy.ReinstatePolicy is {
      send reinstatePolicy to outlet PolicyContext.PolicyCommandStreamOut
    }
    on cancelPolicy: command Policy.CancelPolicy is {
      send cancelPolicy to outlet PolicyContext.PolicyCommandStreamOut
    }
    on nonRenewPolicy: command Policy.NonRenewPolicy is {
      send nonRenewPolicy to outlet PolicyContext.PolicyCommandStreamOut
    }
    on policyResult: result Policy.PolicyResult is {
      send policyResult to outlet PolicyContext.PolicyResultStreamOut
    }
    on other is {
      error "Unexpected message at the PolicyContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PolicyCommand Stream Intake' is from outlet PolicyContext.PolicyCommandStreamOut to inlet PolicyContext.Policy.PolicyCommands  connector 'PolicyResult Stream Egress' is from outlet PolicyContext.PolicyRepository.PolicyRepositoryResponses to inlet PolicyContext.PolicyResultStreamIn  adaptor FromAgencyManagementService from context AgencyManagementService is { 
    handler FromAgencyManagementServiceHandler is {
      on result AgencyManagementService.AgentInfo is {
        do "the model receives agent info"
      }
      on event AgencyManagementService.CommissionRecorded is {
        do "the model receives commission recorded"
      }
      on other is {
        error "Unexpected message for adaptor FromAgencyManagementService"
      }
    } with {
      briefly "from agency management service"
      described as {
        |Carries messages from the external AgencyManagementService.
      }
    }
  } with {
    briefly "AgencyManagementService integration"
    described as {
      |The model's side of the AgencyManagementService conversation.
    }
  }
  adaptor ToAgencyManagementService to context AgencyManagementService is { 
    handler ToAgencyManagementServiceHandler is {
      on query AgencyManagementService.GetAgentInfo is {
        do "the model sends get agent info"
      }
      on command AgencyManagementService.RecordCommission is {
        do "the model sends record commission"
      }
      on other is {
        error "Unexpected message for adaptor ToAgencyManagementService"
      }
    } with {
      briefly "to agency management service"
      described as {
        |Carries messages to the external AgencyManagementService.
      }
    }
  } with {
    briefly "AgencyManagementService integration"
    described as {
      |The model's side of the AgencyManagementService conversation.
    }
  }
  adaptor FromBillingService from context BillingService is { 
    handler FromBillingServiceHandler is {
      on event BillingService.BillingScheduleCreated is {
        do "the model receives billing schedule created"
      }
      on event BillingService.RefundProcessed is {
        do "the model receives refund processed"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService is { 
    handler ToBillingServiceHandler is {
      on command BillingService.CreateBillingSchedule is {
        do "the model sends create billing schedule"
      }
      on command BillingService.ProcessRefund is {
        do "the model sends process refund"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromDocumentGenerationService from context DocumentGenerationService is { 
    handler FromDocumentGenerationServiceHandler is {
      on event DocumentGenerationService.DocumentsGenerated is {
        do "the model receives documents generated"
      }
      on event DocumentGenerationService.EndorsementGenerated is {
        do "the model receives endorsement generated"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentGenerationService"
      }
    } with {
      briefly "from document generation service"
      described as {
        |Carries messages from the external DocumentGenerationService.
      }
    }
  } with {
    briefly "DocumentGenerationService integration"
    described as {
      |The model's side of the DocumentGenerationService conversation.
    }
  }
  adaptor ToDocumentGenerationService to context DocumentGenerationService is { 
    handler ToDocumentGenerationServiceHandler is {
      on command DocumentGenerationService.GenerateEndorsement is {
        do "the model sends generate endorsement"
      }
      on command DocumentGenerationService.GeneratePolicyDocuments is {
        do "the model sends generate policy documents"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentGenerationService"
      }
    } with {
      briefly "to document generation service"
      described as {
        |Carries messages to the external DocumentGenerationService.
      }
    }
  } with {
    briefly "DocumentGenerationService integration"
    described as {
      |The model's side of the DocumentGenerationService conversation.
    }
  }
  adaptor FromRatingEngineService from context RatingEngineService is { 
    handler FromRatingEngineServiceHandler is {
      on result RatingEngineService.PremiumCalculation is {
        do "the model receives premium calculation"
      }
      on result RatingEngineService.RenewalPremiumCalculation is {
        do "the model receives renewal premium calculation"
      }
      on other is {
        error "Unexpected message for adaptor FromRatingEngineService"
      }
    } with {
      briefly "from rating engine service"
      described as {
        |Carries messages from the external RatingEngineService.
      }
    }
  } with {
    briefly "RatingEngineService integration"
    described as {
      |The model's side of the RatingEngineService conversation.
    }
  }
  adaptor ToRatingEngineService to context RatingEngineService is { 
    handler ToRatingEngineServiceHandler is {
      on command RatingEngineService.CalculatePremium is {
        do "the model sends calculate premium"
      }
      on query RatingEngineService.GetPremiumCalculation is {
        do "the model sends get premium calculation"
      }
      on command RatingEngineService.GetRenewalPremium is {
        do "the model sends get renewal premium"
      }
      on other is {
        error "Unexpected message for adaptor ToRatingEngineService"
      }
    } with {
      briefly "to rating engine service"
      described as {
        |Carries messages to the external RatingEngineService.
      }
    }
  } with {
    briefly "RatingEngineService integration"
    described as {
      |The model's side of the RatingEngineService conversation.
    }
  }
  adaptor FromRegulatoryReportingService from context RegulatoryReportingService is { 
    handler FromRegulatoryReportingServiceHandler is {
      on event RegulatoryReportingService.FilingSubmitted is {
        do "the model receives filing submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryReportingService"
      }
    } with {
      briefly "from regulatory reporting service"
      described as {
        |Carries messages from the external RegulatoryReportingService.
      }
    }
  } with {
    briefly "RegulatoryReportingService integration"
    described as {
      |The model's side of the RegulatoryReportingService conversation.
    }
  }
  adaptor ToRegulatoryReportingService to context RegulatoryReportingService is { 
    handler ToRegulatoryReportingServiceHandler is {
      on command RegulatoryReportingService.SubmitPolicyFiling is {
        do "the model sends submit policy filing"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryReportingService"
      }
    } with {
      briefly "to regulatory reporting service"
      described as {
        |Carries messages to the external RegulatoryReportingService.
      }
    }
  } with {
    briefly "RegulatoryReportingService integration"
    described as {
      |The model's side of the RegulatoryReportingService conversation.
    }
  }
  adaptor FromUnderwritingService from context UnderwritingService is { 
    handler FromUnderwritingServiceHandler is {
      on event UnderwritingService.InspectionOrdered is {
        do "the model receives inspection ordered"
      }
      on result UnderwritingService.RiskEvaluation is {
        do "the model receives risk evaluation"
      }
      on other is {
        error "Unexpected message for adaptor FromUnderwritingService"
      }
    } with {
      briefly "from underwriting service"
      described as {
        |Carries messages from the external UnderwritingService.
      }
    }
  } with {
    briefly "UnderwritingService integration"
    described as {
      |The model's side of the UnderwritingService conversation.
    }
  }
  adaptor ToUnderwritingService to context UnderwritingService is { 
    handler ToUnderwritingServiceHandler is {
      on command UnderwritingService.EvaluateRisk is {
        do "the model sends evaluate risk"
      }
      on query UnderwritingService.GetRiskEvaluation is {
        do "the model sends get risk evaluation"
      }
      on command UnderwritingService.OrderInspection is {
        do "the model sends order inspection"
      }
      on other is {
        error "Unexpected message for adaptor ToUnderwritingService"
      }
    } with {
      briefly "to underwriting service"
      described as {
        |Carries messages to the external UnderwritingService.
      }
    }
  } with {
    briefly "UnderwritingService integration"
    described as {
      |The model's side of the UnderwritingService conversation.
    }
  }
  include "types.riddl"
  include "Policy.riddl"
  // Repository for policy persistence
  type PolicyRepositoryCommand is one of {
    PolicyContext.PolicyRepository.PersistEndorsementAdded or PolicyContext.PolicyRepository.PersistPolicyBound or PolicyContext.PolicyRepository.PersistPolicyCancelled or PolicyContext.PolicyRepository.PersistPolicyIssued or PolicyContext.PolicyRepository.PersistPolicyNonRenewed or PolicyContext.PolicyRepository.PersistPolicyReinstated or PolicyContext.PolicyRepository.PersistPolicySuspended or PolicyContext.PolicyRepository.PersistRenewalAccepted or PolicyContext.PolicyRepository.PersistRenewalOffered
  } with {
    briefly "Anything that writes PolicyRepository"
    described as {
      |The persistence commands PolicyRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository PolicyRepository as flow is {
    inlet PolicyRepositoryFromPolicyAnalytics is type PolicyRepositoryCommand
    command PersistEndorsementAdded is  {
      policyId: PolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row EndorsementAdded applies to.
        }
      }
    } with {
      briefly "Persist EndorsementAdded"
      described as {
        |Instructs this repository to apply EndorsementAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPolicyNonRenewed is  {
      policyId: PolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row PolicyNonRenewed applies to.
        }
      }
    } with {
      briefly "Persist PolicyNonRenewed"
      described as {
        |Instructs this repository to apply PolicyNonRenewed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPolicyReinstated is  {
      policyId: PolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row PolicyReinstated applies to.
        }
      }
    } with {
      briefly "Persist PolicyReinstated"
      described as {
        |Instructs this repository to apply PolicyReinstated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPolicySuspended is  {
      policyId: PolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row PolicySuspended applies to.
        }
      }
    } with {
      briefly "Persist PolicySuspended"
      described as {
        |Instructs this repository to apply PolicySuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRenewalOffered is  {
      policyId: PolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row RenewalOffered applies to.
        }
      }
    } with {
      briefly "Persist RenewalOffered"
      described as {
        |Instructs this repository to apply RenewalOffered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPolicyBound is  {
      policyId: PolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row PolicyBound applies to.
        }
      }
    } with {
      briefly "Persist PolicyBound"
      described as {
        |Instructs this repository to apply PolicyBound to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPolicyCancelled is  {
      policyId: PolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row PolicyCancelled applies to.
        }
      }
    } with {
      briefly "Persist PolicyCancelled"
      described as {
        |Instructs this repository to apply PolicyCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPolicyIssued is  {
      policyId: PolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row PolicyIssued applies to.
        }
      }
    } with {
      briefly "Persist PolicyIssued"
      described as {
        |Instructs this repository to apply PolicyIssued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRenewalAccepted is  {
      policyId: PolicyId with {
        briefly "Row addressed"
        described as {
          |Which stored row RenewalAccepted applies to.
        }
      }
    } with {
      briefly "Persist RenewalAccepted"
      described as {
        |Instructs this repository to apply RenewalAccepted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet PolicyRepositoryResponses is type Policy.PolicyResult
    record StoredPolicy is  {
      policyId: PolicyId with {
        briefly "policyId"
        described as {
          |The policyId column of the stored policy row.
        }
      }
      period: PolicyPeriod with {
        briefly "period"
        described as {
          |The period column of the stored policy row.
        }
      }
      policyholder: PolicyholderInfo with {
        briefly "policyholder"
        described as {
          |The policyholder column of the stored policy row.
        }
      }
    } with {
      briefly "Stored policy row"
      described as {
        |The persistence shape of policy data as this repository stores it.
      }
    }
    schema PolicyData is relational
      of policies as type StoredPolicy
        index on field StoredPolicy.policyId
        index on field StoredPolicy.policyholder.policyholderId
        index on field StoredPolicy.period.expirationDate
 with {
      briefly "Policy data schema"
      described as {
        |The relational schema holding policy data for the PolicyRepository.
      }
    }
    handler PolicyPersistence is {
      on persistEndorsementAdded: command PersistEndorsementAdded is {
        do "apply EndorsementAdded to the stored row"
      }
      on persistPolicyNonRenewed: command PersistPolicyNonRenewed is {
        do "apply PolicyNonRenewed to the stored row"
      }
      on persistPolicyReinstated: command PersistPolicyReinstated is {
        do "apply PolicyReinstated to the stored row"
      }
      on persistPolicySuspended: command PersistPolicySuspended is {
        do "apply PolicySuspended to the stored row"
      }
      on persistRenewalOffered: command PersistRenewalOffered is {
        do "apply RenewalOffered to the stored row"
      }
      on persistPolicyBound: command PersistPolicyBound is {
        do "apply PolicyBound to the stored row"
      }
      on persistPolicyCancelled: command PersistPolicyCancelled is {
        do "apply PolicyCancelled to the stored row"
      }
      on persistPolicyIssued: command PersistPolicyIssued is {
        do "apply PolicyIssued to the stored row"
      }
      on persistRenewalAccepted: command PersistRenewalAccepted is {
        do "apply RenewalAccepted to the stored row"
      }
      on query GetPolicyStats is {
        let policyStatsView: type PolicyStatsView = prompt("read the policy stats projection")
        reply policyStatsView
      }
    } with {
      briefly "Persists policy commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Policy data persistence"
    described as {
      | The PolicyRepository provides persistent storage for
      | policies, endorsements, and history.
    }
  }
  // Projector for policy analytics
  query GetPolicyStats replies result PolicyStatsView is  {
    policyStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which policy stats to retrieve.
      }
    }
  } with {
    briefly "Get policy stats"
    described as {
      |Retrieves the policy stats projection.
    }
  }
  result PolicyStatsView is  {
    policyStats: PolicyAnalytics.PolicyStats with {
      briefly "Policy stats"
      described as {
        |The policy stats being returned.
      }
    }
  } with {
    briefly "Policy stats view"
    described as {
      |Read model view carrying the policy stats projection.
    }
  }
  projector PolicyAnalytics as flow is {
    outlet PolicyAnalyticsToRepository is type PolicyRepositoryCommand
    updates repository PolicyContext.PolicyRepository
    inlet PolicyAnalyticsFromPolicy is type PolicyEvent
    record PolicyStats is  {
      totalPolicies: Natural with {
        briefly "Total"
        described as {
          |Total policies.
        }
      }
      activePolicies: Natural with {
        briefly "Active"
        described as {
          |Active policies.
        }
      }
      totalPremiumInForce: Decimal(15,2) with {
        briefly "Premium"
        described as {
          |Total premium in force.
        }
      }
      renewalRate: Decimal(5,4) with {
        briefly "Renewal rate"
        described as {
          |Renewal rate.
        }
      }
      cancellationRate: Decimal(5,4) with {
        briefly "Cancellation rate"
        described as {
          |Cancellation rate.
        }
      }
      averagePremium: Decimal(10,2) with {
        briefly "Avg premium"
        described as {
          |Average premium.
        }
      }
    } with {
      briefly "Policy statistics"
      described as {
        |Insurance policy metrics.
      }
    }
    handler AnalyticsHandler is {
      on endorsementAdded: event Policy.EndorsementAdded is {
        tell command PolicyContext.PolicyRepository.PersistEndorsementAdded(policyId = endorsementAdded.policyId) to repository PolicyContext.PolicyRepository
        do "apply EndorsementAdded to the PolicyAnalytics projection"
      }
      on policyNonRenewed: event Policy.PolicyNonRenewed is {
        tell command PolicyContext.PolicyRepository.PersistPolicyNonRenewed(policyId = policyNonRenewed.policyId) to repository PolicyContext.PolicyRepository
        do "apply PolicyNonRenewed to the PolicyAnalytics projection"
      }
      on policyReinstated: event Policy.PolicyReinstated is {
        tell command PolicyContext.PolicyRepository.PersistPolicyReinstated(policyId = policyReinstated.policyId) to repository PolicyContext.PolicyRepository
        do "apply PolicyReinstated to the PolicyAnalytics projection"
      }
      on policySuspended: event Policy.PolicySuspended is {
        tell command PolicyContext.PolicyRepository.PersistPolicySuspended(policyId = policySuspended.policyId) to repository PolicyContext.PolicyRepository
        do "apply PolicySuspended to the PolicyAnalytics projection"
      }
      on renewalOffered: event Policy.RenewalOffered is {
        tell command PolicyContext.PolicyRepository.PersistRenewalOffered(policyId = renewalOffered.policyId) to repository PolicyContext.PolicyRepository
        do "apply RenewalOffered to the PolicyAnalytics projection"
      }
      on policyIssued: event Policy.PolicyIssued is {
        tell command PolicyContext.PolicyRepository.PersistPolicyIssued(policyId = policyIssued.policyId) to repository PolicyContext.PolicyRepository
      }
      on policyBound: event Policy.PolicyBound is {
        tell command PolicyContext.PolicyRepository.PersistPolicyBound(policyId = policyBound.policyId) to repository PolicyContext.PolicyRepository
      }
      on renewalAccepted: event Policy.RenewalAccepted is {
        tell command PolicyContext.PolicyRepository.PersistRenewalAccepted(policyId = renewalAccepted.policyId) to repository PolicyContext.PolicyRepository
      }
      on policyCancelled: event Policy.PolicyCancelled is {
        tell command PolicyContext.PolicyRepository.PersistPolicyCancelled(policyId = policyCancelled.policyId) to repository PolicyContext.PolicyRepository
      }
    } with {
      briefly "Maintains policy analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Policy analytics projections"
    described as {
      |Maintains insurance policy analytics data.
    }
  }
  processor PolicyEventSplit as flow is {
    inlet PolicyEventSplitIn is type PolicyEvent
    outlet PolicyEventSplitToPolicyAnalytics is type PolicyEvent
    handler PolicyEventSplitHandler is {
      on policyIssued: event Policy.PolicyIssued is {
        send policyIssued to outlet PolicyEventSplitToPolicyAnalytics
        tell policyIssued to entity PolicyContext.Policy
      }
      on policyBound: event Policy.PolicyBound is {
        send policyBound to outlet PolicyEventSplitToPolicyAnalytics
        tell policyBound to entity PolicyContext.Policy
      }
      on endorsementAdded: event Policy.EndorsementAdded is {
        send endorsementAdded to outlet PolicyEventSplitToPolicyAnalytics
        tell endorsementAdded to entity PolicyContext.Policy
      }
      on renewalOffered: event Policy.RenewalOffered is {
        send renewalOffered to outlet PolicyEventSplitToPolicyAnalytics
        tell renewalOffered to entity PolicyContext.Policy
      }
      on renewalAccepted: event Policy.RenewalAccepted is {
        send renewalAccepted to outlet PolicyEventSplitToPolicyAnalytics
        tell renewalAccepted to entity PolicyContext.Policy
      }
      on policySuspended: event Policy.PolicySuspended is {
        send policySuspended to outlet PolicyEventSplitToPolicyAnalytics
        tell policySuspended to entity PolicyContext.Policy
      }
      on policyReinstated: event Policy.PolicyReinstated is {
        send policyReinstated to outlet PolicyEventSplitToPolicyAnalytics
        tell policyReinstated to entity PolicyContext.Policy
      }
      on policyCancelled: event Policy.PolicyCancelled is {
        send policyCancelled to outlet PolicyEventSplitToPolicyAnalytics
        tell policyCancelled to entity PolicyContext.Policy
      }
      on policyNonRenewed: event Policy.PolicyNonRenewed is {
        send policyNonRenewed to outlet PolicyEventSplitToPolicyAnalytics
        tell policyNonRenewed to entity PolicyContext.Policy
      }
      on other is {
        error "Unexpected message for processor PolicyEventSplit"
      }
    } with {
      briefly "Policy event fan-out handler"
      described as {
        |Delivers each Policy event to all of its consumers.
      }
    }
  } with {
    briefly "Policy event fan-out"
    described as {
      |Fans Policy events out to the repository and projectors.
    }
  }
  connector 'PolicyEvent Stream' is from outlet PolicyContext.Policy.PolicyEvents2 to inlet PolicyContext.PolicyEventSplit.PolicyEventSplitIn with {
    briefly "Policy events, fanned out to storage and read models"
  }
  connector 'PolicyAnalytics Feed' is from outlet PolicyContext.PolicyEventSplit.PolicyEventSplitToPolicyAnalytics to inlet PolicyContext.PolicyAnalytics.PolicyAnalyticsFromPolicy with {
    briefly "Policy events feeding the PolicyAnalytics projection"
  }
  connector 'PolicyAnalytics Storage' is from outlet PolicyContext.PolicyAnalytics.PolicyAnalyticsToRepository to inlet PolicyContext.PolicyRepository.PolicyRepositoryFromPolicyAnalytics with {
    briefly "PolicyAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for policy management"
  described as {
    | The PolicyContext is the bounded context for
    | insurance policy administration and lifecycle.
  }
}
