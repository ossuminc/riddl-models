// Policy Management - External Contexts
// Rating Engine Service
external context RatingEngineService as flow is {
  type RatingEngineServiceReply is one of {
    PremiumCalculation or RenewalPremiumCalculation
  } with {
    briefly "Everything this service answers"
  }
  outlet RatingEngineServiceRepliesOut is type RatingEngineServiceReply
 with {
    briefly "What this service answers, on its way back"
  }
  type RatingEngineServiceCommand is one of {
    CalculatePremium or GetRenewalPremium or GetPremiumCalculation
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet RatingEngineServiceRequests is type RatingEngineServiceCommand with {
    briefly "What this context asks the service to send"
  }
  handler RatingEngineServiceBoundary is {
    on query GetPremiumCalculation is {
      let askAnswer: type PremiumCalculation = prompt("look up what GetPremiumCalculation asks for")
      reply askAnswer
    }
    on command CalculatePremium is {
      do "deliver it to the recipient"
    }
    on query GetRenewalPremium is {
      let askAnswer: type RenewalPremiumCalculation = prompt("look up what GetRenewalPremium asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context RatingEngineService"
    }
  } with {
    briefly "RatingEngineService boundary"
  }
  command CalculatePremium is {
    policyType: PolicyType with {
      briefly "Type"
      described as {
        |Policy type.
      }
    }
    property: InsuredProperty with {
      briefly "Property"
      described as {
        |Property info.
      }
    }
    coverages: CoverageInfo+ with {
      briefly "Coverages"
      described as {
        |Requested coverages.
      }
    }
    policyholder: PolicyholderInfo with {
      briefly "Policyholder"
      described as {
        |Policyholder info.
      }
    }
  } with {
    briefly "Calculate premium"
    described as {
      |Calculates policy premium.
    }
  }
  query GetPremiumCalculation replies result PremiumCalculation is {
    policyType: PolicyType with {
      briefly "Type"
      described as {
        |Policy type to rate.
      }
    }
  } with {
    briefly "Get premium calculation"
    described as {
      |Queries for a premium calculation.
    }
  }
  result PremiumCalculation is {
    premium: PremiumInfo with {
      briefly "Premium"
      described as {
        |Calculated premium.
      }
    }
    ratingFactors: String(1,200)+ with {
      briefly "Factors"
      described as {
        |Rating factors used.
      }
    }
    calculatedAt: TimeStamp with {
      briefly "Calculated"
      described as {
        |Calculation time.
      }
    }
  } with {
    briefly "Premium calculation"
    described as {
      |Premium calculation result.
    }
  }
  query GetRenewalPremium replies result RenewalPremiumCalculation is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    claimHistory: ClaimId* with {
      briefly "Claims"
      described as {
        |Claim history.
      }
    }
  } with {
    briefly "Get renewal premium"
    described as {
      |Calculates renewal premium.
    }
  }
  result RenewalPremiumCalculation is {
    currentPremium: PremiumInfo with {
      briefly "Current"
      described as {
        |Current premium.
      }
    }
    renewalPremium: PremiumInfo with {
      briefly "Renewal"
      described as {
        |Renewal premium.
      }
    }
    changePercent: Decimal(5,2) with {
      briefly "Change"
      described as {
        |Premium change percent.
      }
    }
    calculatedAt: TimeStamp with {
      briefly "Calculated"
      described as {
        |Calculation time.
      }
    }
  } with {
    briefly "Renewal premium calculation"
    described as {
      |Renewal premium result.
    }
  }
} with {
  briefly "External rating engine"
  described as {
    |External premium rating service.
  }
}
// Underwriting Service
external context UnderwritingService as split is {
  outlet UnderwritingServiceRepliesOut is result RiskEvaluation
 with {
    briefly "What this service answers, on its way back"
  }
  outlet UnderwritingServiceEventsOut is event InspectionOrdered
 with {
    briefly "What this service tells the model, unasked"
  }
  type UnderwritingServiceCommand is one of {
    EvaluateRisk or OrderInspection or GetRiskEvaluation
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet UnderwritingServiceRequests is type UnderwritingServiceCommand with {
    briefly "What this context asks the service to send"
  }
  handler UnderwritingServiceBoundary is {
    on query GetRiskEvaluation is {
      let askAnswer: type RiskEvaluation = prompt("look up what GetRiskEvaluation asks for")
      reply askAnswer
    }
    on command EvaluateRisk is {
      do "deliver it to the recipient"
    }
    on command OrderInspection is {
      let inspectionOrdered: type InspectionOrdered = prompt("the inspection ordered this produces")
      send inspectionOrdered to outlet UnderwritingService.UnderwritingServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context UnderwritingService"
    }
  } with {
    briefly "UnderwritingService boundary"
  }
  command EvaluateRisk is {
    policyType: PolicyType with {
      briefly "Type"
      described as {
        |Policy type.
      }
    }
    property: InsuredProperty with {
      briefly "Property"
      described as {
        |Property info.
      }
    }
    policyholder: PolicyholderInfo with {
      briefly "Policyholder"
      described as {
        |Policyholder info.
      }
    }
  } with {
    briefly "Evaluate risk"
    described as {
      |Evaluates insurance risk.
    }
  }
  query GetRiskEvaluation replies result RiskEvaluation is {
    policyType: PolicyType with {
      briefly "Type"
      described as {
        |Policy type to evaluate.
      }
    }
  } with {
    briefly "Get risk evaluation"
    described as {
      |Queries for a risk evaluation.
    }
  }
  result RiskEvaluation is {
    riskScore: Natural with {
      briefly "Score"
      described as {
        |Risk score.
      }
    }
    decision: String(1,50) with {
      briefly "Decision"
      described as {
        |Underwriting decision.
      }
    }
    conditions: String(1,500)* with {
      briefly "Conditions"
      described as {
        |Policy conditions.
      }
    }
    exclusions: String(1,500)* with {
      briefly "Exclusions"
      described as {
        |Coverage exclusions.
      }
    }
    evaluatedAt: TimeStamp with {
      briefly "Evaluated"
      described as {
        |Evaluation time.
      }
    }
  } with {
    briefly "Risk evaluation"
    described as {
      |Underwriting risk evaluation.
    }
  }
  command OrderInspection is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    property: InsuredProperty with {
      briefly "Property"
      described as {
        |Property to inspect.
      }
    }
  } with {
    briefly "Order inspection"
    described as {
      |Orders property inspection.
    }
  }
  event InspectionOrdered is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    inspectionId: UUID with {
      briefly "Inspection"
      described as {
        |Inspection ID.
      }
    }
    orderedAt: TimeStamp with {
      briefly "Ordered"
      described as {
        |Order time.
      }
    }
  } with {
    briefly "Inspection ordered"
    described as {
      |Emitted when inspection is ordered.
    }
  }
} with {
  briefly "External underwriting"
  described as {
    |External underwriting service.
  }
}
// Document Generation Service
external context DocumentGenerationService as flow is {
  type DocumentGenerationServiceEvent is one of {
    DocumentsGenerated or EndorsementGenerated
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet DocumentGenerationServiceEventsOut is type DocumentGenerationServiceEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type DocumentGenerationServiceCommand is one of {
    GenerateEndorsement or GeneratePolicyDocuments
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet DocumentGenerationServiceRequests is type DocumentGenerationServiceCommand with {
    briefly "What this context asks the service to send"
  }
  handler DocumentGenerationServiceBoundary is {
    on command GenerateEndorsement is {
      let endorsementGenerated: type EndorsementGenerated = prompt("the endorsement generated this produces")
      send endorsementGenerated to outlet DocumentGenerationService.DocumentGenerationServiceEventsOut
      do "deliver it to the recipient"
    }
    on command GeneratePolicyDocuments is {
      let documentsGenerated: type DocumentsGenerated = prompt("the documents generated this produces")
      send documentsGenerated to outlet DocumentGenerationService.DocumentGenerationServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context DocumentGenerationService"
    }
  } with {
    briefly "DocumentGenerationService boundary"
  }
  command GeneratePolicyDocuments is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    documentTypes: String(1,50)+ with {
      briefly "Types"
      described as {
        |Document types to generate.
      }
    }
  } with {
    briefly "Generate documents"
    described as {
      |Generates policy documents.
    }
  }
  event DocumentsGenerated is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    documentUrls: URL+ with {
      briefly "URLs"
      described as {
        |Document URLs.
      }
    }
    generatedAt: TimeStamp with {
      briefly "Generated"
      described as {
        |Generation time.
      }
    }
  } with {
    briefly "Documents generated"
    described as {
      |Emitted when documents are ready.
    }
  }
  command GenerateEndorsement is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    endorsement: EndorsementInfo with {
      briefly "Endorsement"
      described as {
        |Endorsement details.
      }
    }
  } with {
    briefly "Generate endorsement"
    described as {
      |Generates endorsement document.
    }
  }
  event EndorsementGenerated is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    endorsementId: EndorsementId with {
      briefly "Endorsement"
      described as {
        |Endorsement ID.
      }
    }
    documentUrl: URL with {
      briefly "URL"
      described as {
        |Document URL.
      }
    }
    generatedAt: TimeStamp with {
      briefly "Generated"
      described as {
        |Generation time.
      }
    }
  } with {
    briefly "Endorsement generated"
    described as {
      |Emitted when endorsement doc is ready.
    }
  }
} with {
  briefly "External document generation"
  described as {
    |External document generation service.
  }
}
// Billing Service
external context BillingService as flow is {
  type BillingServiceEvent is one of {
    BillingScheduleCreated or RefundProcessed
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet BillingServiceEventsOut is type BillingServiceEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type BillingServiceCommand is one of {
    CreateBillingSchedule or ProcessRefund
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet BillingServiceRequests is type BillingServiceCommand with {
    briefly "What this context asks the service to send"
  }
  handler BillingServiceBoundary is {
    on command CreateBillingSchedule is {
      let billingScheduleCreated: type BillingScheduleCreated = prompt("the billing schedule created this produces")
      send billingScheduleCreated to outlet BillingService.BillingServiceEventsOut
      do "deliver it to the recipient"
    }
    on command ProcessRefund is {
      let refundProcessed: type RefundProcessed = prompt("the refund processed this produces")
      send refundProcessed to outlet BillingService.BillingServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context BillingService"
    }
  } with {
    briefly "BillingService boundary"
  }
  command CreateBillingSchedule is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    premium: PremiumInfo with {
      briefly "Premium"
      described as {
        |Premium info.
      }
    }
    frequency: PaymentFrequency with {
      briefly "Frequency"
      described as {
        |Payment frequency.
      }
    }
    startDate: Date with {
      briefly "Start"
      described as {
        |Billing start date.
      }
    }
  } with {
    briefly "Create billing schedule"
    described as {
      |Creates premium billing schedule.
    }
  }
  event BillingScheduleCreated is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    installments: Natural with {
      briefly "Installments"
      described as {
        |Number of installments.
      }
    }
    firstDueDate: Date with {
      briefly "First due"
      described as {
        |First payment due date.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Billing schedule created"
    described as {
      |Emitted when billing is set up.
    }
  }
  command ProcessRefund is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    amount: Decimal(10,2) with {
      briefly "Amount"
      described as {
        |Refund amount.
      }
    }
    refundReason: String(1,200) with {
      briefly "Refund Reason"
      described as {
        |Refund reason.
      }
    }
  } with {
    briefly "Process refund"
    described as {
      |Processes premium refund.
    }
  }
  event RefundProcessed is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    amount: Decimal(10,2) with {
      briefly "Amount"
      described as {
        |Refund amount.
      }
    }
    processedAt: TimeStamp with {
      briefly "Processed"
      described as {
        |Process time.
      }
    }
  } with {
    briefly "Refund processed"
    described as {
      |Emitted when refund is processed.
    }
  }
} with {
  briefly "External billing"
  described as {
    |External premium billing service.
  }
}
// Agency Management Service
external context AgencyManagementService as split is {
  outlet AgencyManagementServiceRepliesOut is result AgentInfo
 with {
    briefly "What this service answers, on its way back"
  }
  outlet AgencyManagementServiceEventsOut is event CommissionRecorded
 with {
    briefly "What this service tells the model, unasked"
  }
  type AgencyManagementServiceRequest is one of {
    RecordCommission or GetAgentInfo
  } with {
    briefly "Everything this service can be asked"
  }
  inlet AgencyManagementServiceRequests is type AgencyManagementServiceRequest with {
    briefly "What this context asks the service to send"
  }
  handler AgencyManagementServiceBoundary is {
    on query GetAgentInfo is {
      let askAnswer: type AgentInfo = prompt("look up what GetAgentInfo asks for")
      reply askAnswer
    }
    on command RecordCommission is {
      let commissionRecorded: type CommissionRecorded = prompt("the commission recorded this produces")
      send commissionRecorded to outlet AgencyManagementService.AgencyManagementServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context AgencyManagementService"
    }
  } with {
    briefly "AgencyManagementService boundary"
  }
  query GetAgentInfo replies result AgentInfo is {
    agentId: UUID with {
      briefly "Agent"
      described as {
        |Agent ID.
      }
    }
  } with {
    briefly "Get agent info"
    described as {
      |Retrieves agent information.
    }
  }
  result AgentInfo is {
    agentId: UUID with {
      briefly "Agent"
      described as {
        |Agent ID.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Agent name.
      }
    }
    licenseNumber: String(1,50) with {
      briefly "License"
      described as {
        |License number.
      }
    }
    agencyName: String(1,200) with {
      briefly "Agency"
      described as {
        |Agency name.
      }
    }
    commissionRate: Decimal(5,4) with {
      briefly "Commission"
      described as {
        |Commission rate.
      }
    }
  } with {
    briefly "Agent info"
    described as {
      |Agent information.
    }
  }
  command RecordCommission is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    agentId: UUID with {
      briefly "Agent"
      described as {
        |Agent ID.
      }
    }
    policyPremium: Decimal(10,2) with {
      briefly "Policy Premium"
      described as {
        |Policy premium.
      }
    }
    commissionRate: Decimal(5,4) with {
      briefly "Rate"
      described as {
        |Commission rate.
      }
    }
  } with {
    briefly "Record commission"
    described as {
      |Records agent commission.
    }
  }
  event CommissionRecorded is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    agentId: UUID with {
      briefly "Agent"
      described as {
        |Agent ID.
      }
    }
    commissionAmount: Decimal(10,2) with {
      briefly "Amount"
      described as {
        |Commission amount.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Commission recorded"
    described as {
      |Emitted when commission is recorded.
    }
  }
} with {
  briefly "External agency management"
  described as {
    |External agency and commission service.
  }
}
// Regulatory Reporting Service
external context RegulatoryReportingService as flow is {
  outlet RegulatoryReportingServiceEventsOut is event FilingSubmitted
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet RegulatoryReportingServiceRequests is command SubmitPolicyFiling with {
    briefly "What this context asks the service to send"
  }
  handler RegulatoryReportingServiceBoundary is {
    on command SubmitPolicyFiling is {
      let filingSubmitted: type FilingSubmitted = prompt("the filing submitted this produces")
      send filingSubmitted to outlet RegulatoryReportingService.RegulatoryReportingServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context RegulatoryReportingService"
    }
  } with {
    briefly "RegulatoryReportingService boundary"
  }
  command SubmitPolicyFiling is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    filingType: String(1,50) with {
      briefly "Type"
      described as {
        |Filing type.
      }
    }
    state: String(2,2) with {
      briefly "State"
      described as {
        |State code.
      }
    }
  } with {
    briefly "Submit filing"
    described as {
      |Submits regulatory filing.
    }
  }
  event FilingSubmitted is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    filingId: UUID with {
      briefly "Filing"
      described as {
        |Filing ID.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Filing submitted"
    described as {
      |Emitted when filing is submitted.
    }
  }
} with {
  briefly "External regulatory reporting"
  described as {
    |External regulatory compliance service.
  }
}
