// Policy Management - Policy Entity
entity Policy as router is {
  type PolicyCommand is one of {
    Policy.BindPolicy or Policy.AddEndorsement or Policy.ProcessRenewal or Policy.AcceptRenewal or Policy.SuspendPolicy or Policy.ReinstatePolicy or Policy.CancelPolicy or Policy.NonRenewPolicy or Policy.RecordProducer
  } with {
    briefly "Policy command alternation"
    described as {
      |Commands accepted by the Policy entity.
    }
  }
  inlet PolicyQueries is query GetPolicy with {
    briefly "Look-ups of this policy"
    described as {
      |What PolicyManagementApp asks of the policy, by way of PolicyContext.
    }
  }
  outlet PolicyReplies is result PolicyResult
 with {
    briefly "This policy's answers"
    described as {
      |What the policy answers, on its way back to PolicyContext.
    }
  }
  inlet PolicyCommands is type PolicyCommand
  outlet PolicyEvents2 is type PolicyEvent
  // Commands
  command BindPolicy is {
    policyId: PolicyId with {
      briefly "Policy ID"
      described as {
        |Policy identifier.
      }
    }
    paymentFrequency: PaymentFrequency with {
      briefly "Payment frequency"
      described as {
        |How premiums are paid.
      }
    }
  } with {
    briefly "Bind policy"
    described as {
      |Binds coverage to the policy.
    }
  }
  command AddEndorsement is {
    policyId: PolicyId with {
      briefly "Policy ID"
      described as {
        |Policy identifier.
      }
    }
    endorsement: EndorsementInfo with {
      briefly "Endorsement"
      described as {
        |Endorsement details.
      }
    }
  } with {
    briefly "Add endorsement"
    described as {
      |Adds policy endorsement.
    }
  }
  command ProcessRenewal is {
    policyId: PolicyId with {
      briefly "Policy ID"
      described as {
        |Policy identifier.
      }
    }
    renewal: RenewalInfo with {
      briefly "Renewal"
      described as {
        |Renewal details.
      }
    }
  } with {
    briefly "Process renewal"
    described as {
      |Processes policy renewal.
    }
  }
  command AcceptRenewal is {
    policyId: PolicyId with {
      briefly "Policy ID"
      described as {
        |Policy identifier.
      }
    }
  } with {
    briefly "Accept renewal"
    described as {
      |Accepts renewal offer.
    }
  }
  command SuspendPolicy is {
    policyId: PolicyId with {
      briefly "Policy ID"
      described as {
        |Policy identifier.
      }
    }
    suspensionReason: String(1,500) with {
      briefly "Suspension Reason"
      described as {
        |Suspension reason.
      }
    }
  } with {
    briefly "Suspend policy"
    described as {
      |Suspends the policy.
    }
  }
  command ReinstatePolicy is {
    policyId: PolicyId with {
      briefly "Policy ID"
      described as {
        |Policy identifier.
      }
    }
    paymentReceived: Decimal(10,2) with {
      briefly "Payment"
      described as {
        |Reinstatement payment.
      }
    }
  } with {
    briefly "Reinstate policy"
    described as {
      |Reinstates suspended policy.
    }
  }
  command CancelPolicy is {
    policyId: PolicyId with {
      briefly "Policy ID"
      described as {
        |Policy identifier.
      }
    }
    cancellation: CancellationInfo with {
      briefly "Cancellation"
      described as {
        |Cancellation details.
      }
    }
  } with {
    briefly "Cancel policy"
    described as {
      |Cancels the policy.
    }
  }
  command NonRenewPolicy is {
    policyId: PolicyId with {
      briefly "Policy ID"
      described as {
        |Policy identifier.
      }
    }
    nonRenewalReason: String(1,500) with {
      briefly "Non-Renewal Reason"
      described as {
        |Non-renewal reason.
      }
    }
  } with {
    briefly "Non-renew policy"
    described as {
      |Non-renews the policy.
    }
  }
  command RecordProducer is {
    policyId: PolicyId with {
      briefly "policy addressed"
      described as {
        |Policy addressed.
      }
    }
    agentId: UUID with {
      briefly "agent id"
      described as {
        |Agent id.
      }
    }
    agencyName: String(1,200) with {
      briefly "agency name"
      described as {
        |Agency name.
      }
    }
    commissionRate: Decimal(5,4) with {
      briefly "commission rate"
      described as {
        |Commission rate.
      }
    }
  } with {
    briefly "Record producer"
    described as {
      |Carries an answer obtained from an external service into the policy.
    }
  }
  // Events
  event PolicyIssued is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    policyholder: PolicyholderInfo with {
      briefly "Policyholder"
      described as {
        |Policyholder info.
      }
    }
    policyType: PolicyType with {
      briefly "Type"
      described as {
        |Policy type.
      }
    }
    coverages: CoverageInfo+ with {
      briefly "Coverages"
      described as {
        |Policy coverages.
      }
    }
    period: PolicyPeriod with {
      briefly "Period"
      described as {
        |Policy period.
      }
    }
    premium: PremiumInfo with {
      briefly "Premium"
      described as {
        |Premium info.
      }
    }
    issuedAt: TimeStamp with {
      briefly "Issued"
      described as {
        |Issue time.
      }
    }
  } with {
    briefly "Policy issued"
    described as {
      |Emitted when policy is issued.
    }
  }
  event PolicyBound is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    paymentFrequency: PaymentFrequency with {
      briefly "Frequency"
      described as {
        |Payment frequency.
      }
    }
    boundAt: TimeStamp with {
      briefly "Bound"
      described as {
        |Bind time.
      }
    }
  } with {
    briefly "Policy bound"
    described as {
      |Emitted when policy is bound.
    }
  }
  event EndorsementAdded is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    endorsement: EndorsementInfo with {
      briefly "Endorsement"
      described as {
        |Endorsement details.
      }
    }
    addedAt: TimeStamp with {
      briefly "Added"
      described as {
        |Add time.
      }
    }
  } with {
    briefly "Endorsement added"
    described as {
      |Emitted when endorsement is added.
    }
  }
  event RenewalOffered is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    renewal: RenewalInfo with {
      briefly "Renewal"
      described as {
        |Renewal details.
      }
    }
    offeredAt: TimeStamp with {
      briefly "Offered"
      described as {
        |Offer time.
      }
    }
  } with {
    briefly "Renewal offered"
    described as {
      |Emitted when renewal is offered.
    }
  }
  event RenewalAccepted is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    newPeriod: PolicyPeriod with {
      briefly "Period"
      described as {
        |New policy period.
      }
    }
    acceptedAt: TimeStamp with {
      briefly "Accepted"
      described as {
        |Acceptance time.
      }
    }
  } with {
    briefly "Renewal accepted"
    described as {
      |Emitted when renewal is accepted.
    }
  }
  event PolicySuspended is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    suspensionReason: String(1,500) with {
      briefly "Suspension Reason"
      described as {
        |Suspension reason.
      }
    }
    suspendedAt: TimeStamp with {
      briefly "Suspended"
      described as {
        |Suspension time.
      }
    }
  } with {
    briefly "Policy suspended"
    described as {
      |Emitted when policy is suspended.
    }
  }
  event PolicyReinstated is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    paymentReceived: Decimal(10,2) with {
      briefly "Payment"
      described as {
        |Reinstatement payment.
      }
    }
    reinstatedAt: TimeStamp with {
      briefly "Reinstated"
      described as {
        |Reinstatement time.
      }
    }
  } with {
    briefly "Policy reinstated"
    described as {
      |Emitted when policy is reinstated.
    }
  }
  event PolicyCancelled is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    cancellation: CancellationInfo with {
      briefly "Cancellation"
      described as {
        |Cancellation info.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancellation time.
      }
    }
  } with {
    briefly "Policy cancelled"
    described as {
      |Emitted when policy is cancelled.
    }
  }
  event PolicyNonRenewed is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    nonRenewalReason: String(1,500) with {
      briefly "Non-Renewal Reason"
      described as {
        |Non-renewal reason.
      }
    }
    nonRenewedAt: TimeStamp with {
      briefly "Non-renewed"
      described as {
        |Non-renewal time.
      }
    }
  } with {
    briefly "Policy non-renewed"
    described as {
      |Emitted when policy is non-renewed.
    }
  }
  event ProducerRecorded is {
    policyId: PolicyId with {
      briefly "policy addressed"
      described as {
        |Policy addressed.
      }
    }
    agentId: UUID with {
      briefly "agent id"
      described as {
        |Agent id.
      }
    }
    agencyName: String(1,200) with {
      briefly "agency name"
      described as {
        |Agency name.
      }
    }
    commissionRate: Decimal(5,4) with {
      briefly "commission rate"
      described as {
        |Commission rate.
      }
    }
    recordedAt: TimeStamp with {
      briefly "when it was recorded"
      described as {
        |When it was recorded.
      }
    }
  } with {
    briefly "Producer recorded"
    described as {
      |Emitted when record producer has been applied.
    }
  }
  // State Records
  record ActiveStateData is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    policyholder: PolicyholderInfo with {
      briefly "Policyholder"
      described as {
        |Policyholder info.
      }
    }
    policyType: PolicyType with {
      briefly "Type"
      described as {
        |Policy type.
      }
    }
    property: InsuredProperty with {
      briefly "Property"
      described as {
        |Insured property.
      }
    }
    coverages: CoverageInfo+ with {
      briefly "Coverages"
      described as {
        |Policy coverages.
      }
    }
    period: PolicyPeriod with {
      briefly "Period"
      described as {
        |Policy period.
      }
    }
    premium: PremiumInfo with {
      briefly "Premium"
      described as {
        |Premium info.
      }
    }
    endorsements: EndorsementInfo* with {
      briefly "Endorsements"
      described as {
        |Policy endorsements.
      }
    }
    status: PolicyStatus with {
      briefly "Status"
      described as {
        |Policy status.
      }
    }
    selectedPaymentFrequency: PaymentFrequency? with {
      briefly "Frequency"
      described as {
        |Payment frequency.
      }
    }
    issuedAt: TimeStamp with {
      briefly "Issued"
      described as {
        |Issue time.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |State for active policy.
    }
  }
  record TerminatedStateData is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    policyholder: PolicyholderInfo with {
      briefly "Policyholder"
      described as {
        |Policyholder info.
      }
    }
    terminationReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Termination reason.
      }
    }
    terminatedAt: TimeStamp with {
      briefly "Terminated"
      described as {
        |Termination time.
      }
    }
  } with {
    briefly "Terminated state"
    described as {
      |State for terminated policy.
    }
  }
  // Query/Result
  query GetPolicy replies result PolicyResult is {
    policyId: PolicyId with {
      briefly "Policy ID"
      described as {
        |Policy to retrieve.
      }
    }
  } with {
    briefly "Get policy"
    described as {
      |Retrieves policy data by identifier.
    }
  }
  result PolicyResult is {
    policyId: PolicyId with {
      briefly "Policy ID"
      described as {
        |Policy identifier.
      }
    }
    policyholder: PolicyholderInfo with {
      briefly "Policyholder"
      described as {
        |Policyholder info.
      }
    }
    status: PolicyStatus with {
      briefly "Status"
      described as {
        |Policy status.
      }
    }
  } with {
    briefly "Policy result"
    described as {
      |Policy data result.
    }
  }
  // States
  state ActiveState of record Policy.ActiveStateData is {
    initial handler ActiveStateHandler is {
      on cancelPolicy: command CancelPolicy is {
        morph entity PolicyContext.Policy to state PolicyContext.Policy.TerminatedState with record Policy.TerminatedStateData(policyId = cancelPolicy.policyId, policyholder = ActiveStateData.policyholder, terminationReason = prompt("the termination reason of this terminated state data"), terminatedAt = prompt("the terminated at of this terminated state data"))
        tell event PolicyCancelled(policyId = cancelPolicy.policyId, cancellation = cancelPolicy.cancellation, cancelledAt = system.now) to entity PolicyContext.Policy
      }
      on nonRenewPolicy: command NonRenewPolicy is {
        morph entity PolicyContext.Policy to state PolicyContext.Policy.TerminatedState with record Policy.TerminatedStateData(policyId = nonRenewPolicy.policyId, policyholder = ActiveStateData.policyholder, terminationReason = prompt("the termination reason of this terminated state data"), terminatedAt = prompt("the terminated at of this terminated state data"))
        tell event PolicyNonRenewed(policyId = nonRenewPolicy.policyId, nonRenewalReason = nonRenewPolicy.nonRenewalReason, nonRenewedAt = system.now) to entity PolicyContext.Policy
      }
    } with {
      briefly "While ActiveState"
      described as {
        |The commands and folds accepted while the entity is in ActiveState.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |Policy is active and in force.
    }
  }
  state TerminatedState of record Policy.TerminatedStateData with {
    briefly "Terminated state"
    described as {
      |Policy has been cancelled or non-renewed.
    }
  }
  // Handler
  handler PolicyHandler is {
    on init(policyholder: type PolicyholderInfo, policyType: type PolicyType, property: type InsuredProperty, coverages: type CoverageInfo+, period: type PolicyPeriod, premium: type PremiumInfo) is {
      morph entity PolicyContext.Policy to state PolicyContext.Policy.ActiveState with record Policy.ActiveStateData(policyId = self.id, policyholder = policyholder, policyType = policyType, property = property, coverages = coverages, period = period, premium = premium, endorsements = empty, status = prompt("the status of this active state data"), selectedPaymentFrequency = empty, issuedAt = prompt("the issued at of this active state data"))
      tell event PolicyIssued(policyId = self.id, policyholder = policyholder, policyType = policyType, coverages = coverages, period = period, premium = premium, issuedAt = prompt("the issued at of this policy issued")) to entity PolicyContext.Policy
    }
    on bindPolicy: command BindPolicy is {
      tell event PolicyBound(policyId = bindPolicy.policyId, paymentFrequency = bindPolicy.paymentFrequency, boundAt = system.now) to entity PolicyContext.Policy
    }
    on addEndorsement: command AddEndorsement is {
      tell event EndorsementAdded(policyId = addEndorsement.policyId, endorsement = addEndorsement.endorsement, addedAt = system.now) to entity PolicyContext.Policy
    }
    on processRenewal: command ProcessRenewal is {
      tell event RenewalOffered(policyId = processRenewal.policyId, renewal = processRenewal.renewal, offeredAt = system.now) to entity PolicyContext.Policy
    }
    on acceptRenewal: command AcceptRenewal is {
      tell event RenewalAccepted(policyId = acceptRenewal.policyId, newPeriod = prompt("the new period of this renewal accepted"), acceptedAt = system.now) to entity PolicyContext.Policy
    }
    on suspendPolicy: command SuspendPolicy is {
      tell event PolicySuspended(policyId = suspendPolicy.policyId, suspensionReason = suspendPolicy.suspensionReason, suspendedAt = system.now) to entity PolicyContext.Policy
    }
    on reinstatePolicy: command ReinstatePolicy is {
      tell event PolicyReinstated(policyId = reinstatePolicy.policyId, paymentReceived = reinstatePolicy.paymentReceived, reinstatedAt = system.now) to entity PolicyContext.Policy
    }
    on recordProducer: command RecordProducer is {
      tell event ProducerRecorded(policyId = recordProducer.policyId, agentId = recordProducer.agentId, agencyName = recordProducer.agencyName, commissionRate = recordProducer.commissionRate, recordedAt = system.now) to entity PolicyContext.Policy
    }
    on getPolicy: query GetPolicy is {
      reply result PolicyResult(policyId = getPolicy.policyId, policyholder = prompt("the policyholder of this policy result"), status = prompt("the status of this policy result"))
    }
    on endorsementAdded: event EndorsementAdded is {
      do "apply EndorsementAdded to the policy so it can be persisted and replayed"
    }
    on policyBound: event PolicyBound is {
      do "apply PolicyBound to the policy so it can be persisted and replayed"
    }
    on policyCancelled: event PolicyCancelled is {
      do "apply PolicyCancelled to the policy so it can be persisted and replayed"
    }
    on policyIssued: event PolicyIssued is {
      do "apply PolicyIssued to the policy so it can be persisted and replayed"
    }
    on policyNonRenewed: event PolicyNonRenewed is {
      do "apply PolicyNonRenewed to the policy so it can be persisted and replayed"
    }
    on policyReinstated: event PolicyReinstated is {
      do "apply PolicyReinstated to the policy so it can be persisted and replayed"
    }
    on policySuspended: event PolicySuspended is {
      do "apply PolicySuspended to the policy so it can be persisted and replayed"
    }
    on renewalAccepted: event RenewalAccepted is {
      do "apply RenewalAccepted to the policy so it can be persisted and replayed"
    }
    on renewalOffered: event RenewalOffered is {
      do "apply RenewalOffered to the policy so it can be persisted and replayed"
    }
    on producerRecorded: event ProducerRecorded is {
      do "apply ProducerRecorded to the policy so it can be persisted and replayed"
    }
  } with {
    briefly "Processes policy commands"
    described as {
      | Handles policy lifecycle from issuance
      | through endorsements, renewals, and termination.
    }
  }
} with {
  briefly "Policy aggregate"
  described as {
    | The Policy entity manages insurance policies
    | and their lifecycle from issuance to termination.
  }
}
