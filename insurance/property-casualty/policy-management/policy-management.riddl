// Policy Management Domain Model
// Insurance policy lifecycle and administration
domain PolicyManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Policyholder is "person holding an insurance policy" with {
    briefly "Policyholder"
    described as {
      |Person with insurance coverage.
    }
  }
  user Underwriter is "person evaluating risk and pricing" with {
    briefly "Underwriter"
    described as {
      |Person assessing insurance risk.
    }
  }
  user Agent is "person selling insurance policies" with {
    briefly "Agent"
    described as {
      |Person selling and servicing policies.
    }
  }
  epic PolicyEpic is {
    user Policyholder wants to "to manage their insurance coverage" so that "they are protected against losses"
    case PurchasePolicy is {
      user Policyholder wants to "to purchase insurance coverage" so that "their assets are protected"
      step is "Policyholder requests" "quote" "for coverage" with {
        briefly "Request quote"
        described as {
          |Get insurance quote.
        }
      }
      step is "Underwriter evaluates" "risk factors" "and pricing" with {
        briefly "Evaluate risk"
        described as {
          |Assess risk and price.
        }
      }
      step take input PolicyManagementApp.PolicyManagementScreen.IssuePolicyInput from user Agent with {
        briefly "Issue policy"
        described as {
          |Create the policy.
        }
      }
      step is "System sends" "policy documents" "to policyholder" with {
        briefly "Send documents"
        described as {
          |Deliver policy docs.
        }
      }
    } with {
      briefly "Policy purchase"
      described as {
        |Purchasing insurance coverage.
      }
    }
  } with {
    briefly "Policy management"
    described as {
      | Epic covering policy issuance, endorsements,
      | renewals, and cancellations.
    }
  }
  include "PolicyContext.riddl"
  include "external-contexts.riddl"
  application context PolicyManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PolicyManagement are delivered.
      }
    }
    group PolicyManagementScreen is {
      input IssuePolicyInput acquires command PolicyContext.Policy.IssuePolicy with {
        briefly "Issue policy control"
        described as {
          |The control through which a user submits the issue policy request.
        }
      }
    } with {
      briefly "Policy management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppPolicyCommands is type PolicyContext.Policy.PolicyCommand
    inlet AppPolicyRepositoryResponses is result PolicyContext.Policy.PolicyResult    handler PolicyManagementAppHandler is {
      on other is {
        error "Unexpected message for application context PolicyManagementApp"
      }
    } with {
      briefly "PolicyManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PolicyManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'PolicyCommand Stream' is from outlet PolicyManagementApp.AppPolicyCommands to inlet PolicyContext.PolicyCommandStreamIn with {
    briefly "Policy commands from the application"
  }
  persistent connector 'PolicyResult Stream' is from outlet PolicyContext.PolicyResultStreamOut to inlet PolicyManagementApp.AppPolicyRepositoryResponses with {
    briefly "Policy query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PolicyManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Policy management domain"
  described as {
    | The PolicyManagement domain handles insurance
    | policy lifecycle and administration.
  }
}
