// Claims Processing Bounded Context
context ClaimsContext as router is {
  inlet ClaimCommandStreamIn is type ClaimCommand  outlet ClaimCommandStreamOut is type ClaimCommand
  inlet ClaimResultStreamIn is type Claim.ClaimResult  outlet ClaimResultStreamOut is type Claim.ClaimResult
  handler ClaimsContextBoundary is {
    on fileClaim: command Claim.FileClaim is {
      forward fileClaim to outlet ClaimsContext.ClaimCommandStreamOut
    }
    on assignAdjuster: command Claim.AssignAdjuster is {
      forward assignAdjuster to outlet ClaimsContext.ClaimCommandStreamOut
    }
    on investigateClaim: command Claim.InvestigateClaim is {
      forward investigateClaim to outlet ClaimsContext.ClaimCommandStreamOut
    }
    on setReserve: command Claim.SetReserve is {
      forward setReserve to outlet ClaimsContext.ClaimCommandStreamOut
    }
    on approveClaim: command Claim.ApproveClaim is {
      forward approveClaim to outlet ClaimsContext.ClaimCommandStreamOut
    }
    on issuePay: command Claim.IssuePay is {
      forward issuePay to outlet ClaimsContext.ClaimCommandStreamOut
    }
    on denyClaim: command Claim.DenyClaim is {
      forward denyClaim to outlet ClaimsContext.ClaimCommandStreamOut
    }
    on closeClaim: command Claim.CloseClaim is {
      forward closeClaim to outlet ClaimsContext.ClaimCommandStreamOut
    }
    on claimResult: result Claim.ClaimResult is {
      send claimResult to outlet ClaimsContext.ClaimResultStreamOut
    }
    on other is {
      error "Unexpected message at the ClaimsContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ClaimCommand Stream Intake' is from outlet ClaimsContext.ClaimCommandStreamOut to inlet ClaimsContext.Claim.ClaimCommands  connector 'ClaimResult Stream Egress' is from outlet ClaimsContext.ClaimRepository.ClaimRepositoryResponses to inlet ClaimsContext.ClaimResultStreamIn  include "types.riddl"
  include "Claim.riddl"
  // Adaptors for external system integration
  adaptor PolicyAdapter from context PolicyService is { 
    handler InboundPolicy is {
      on event PolicyService.PolicyDetailsRetrieved is {
        let fileClaim: type FileClaim = prompt("the file claim that results from policy details retrieved")
        tell fileClaim to entity Claim
      }
      on event PolicyService.CoverageVerified is {
        let approveClaim: type ApproveClaim = prompt("the approve claim that results from coverage verified")
        tell approveClaim to entity Claim
      }
      on other is {
        error "Unexpected message for adaptor PolicyAdapter"
      }
    } with {
      briefly "Handles policy events from policy service"
      described as {
        |Processes inbound policy and coverage events for claims.
      }
    }
  } with {
    briefly "Translates policy service events"
    described as {
      | Receives policy and coverage events from the external PolicyService
      | and applies them to claim processing.
    }
  }
  adaptor PaymentAdapter from context PaymentService is { 
    handler InboundPayments is {
      on event PaymentService.PaymentProcessed is {
        let issuePay: type IssuePay = prompt("the issue pay that results from payment processed")
        tell issuePay to entity Claim
      }
      on event PaymentService.PaymentVoided is {
        let issuePay: type IssuePay = prompt("the issue pay that results from payment voided")
        tell issuePay to entity Claim
      }
      on other is {
        error "Unexpected message for adaptor PaymentAdapter"
      }
    } with {
      briefly "Handles payment events from payment service"
      described as {
        |Processes payment confirmation events for claims.
      }
    }
  } with {
    briefly "Translates payment service events"
    described as {
      | Receives payment processing events from the external PaymentService
      | and updates claim payment status.
    }
  }
  adaptor FraudAdapter from context FraudDetection is { 
    handler InboundFraud is {
      on event FraudDetection.FraudAnalysisComplete is {
        let investigateClaim: type InvestigateClaim = prompt("the investigate claim that results from fraud analysis complete")
        tell investigateClaim to entity Claim
      }
      on event FraudDetection.SIUReferralAccepted is {
        let investigateClaim: type InvestigateClaim = prompt("the investigate claim that results from s i u referral accepted")
        tell investigateClaim to entity Claim
      }
      on event FraudDetection.SIUInvestigationClosed is {
        let approveClaim: type ApproveClaim = prompt("the approve claim that results from s i u investigation closed")
        tell approveClaim to entity Claim
      }
      on other is {
        error "Unexpected message for adaptor FraudAdapter"
      }
    } with {
      briefly "Handles fraud detection events"
      described as {
        |Processes fraud analysis and investigation events for claims.
      }
    }
  } with {
    briefly "Translates fraud detection events"
    described as {
      | Receives fraud detection events and SIU investigation updates
      | to apply to claim processing decisions.
    }
  }
  // Repository for claims persistence
  type ClaimRepositoryCommand is one of {
    ClaimsContext.ClaimRepository.PersistAdjusterAssigned or ClaimsContext.ClaimRepository.PersistClaimApproved or ClaimsContext.ClaimRepository.PersistClaimClosed or ClaimsContext.ClaimRepository.PersistClaimDenied or ClaimsContext.ClaimRepository.PersistClaimFiled or ClaimsContext.ClaimRepository.PersistInvestigationUpdated or ClaimsContext.ClaimRepository.PersistPaymentIssued or ClaimsContext.ClaimRepository.PersistReserveEstablished
  } with {
    briefly "Anything that writes ClaimRepository"
    described as {
      |The persistence commands ClaimRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ClaimRepository as flow is {
    inlet ClaimRepositoryFromLossRatioProjector is type ClaimRepositoryCommand
    outlet ClaimRepositoryResponses is type Claim.ClaimResult
    record StoredClaim is  {
      claimId: ClaimId with {
        briefly "claimId"
        described as {
          |The claimId column of the stored claim row.
        }
      }
      assignedAdjuster: AdjusterId with {
        briefly "assignedAdjuster"
        described as {
          |The assignedAdjuster column of the stored claim row.
        }
      }
      claimInfo: ClaimInfo with {
        briefly "claimInfo"
        described as {
          |The claimInfo column of the stored claim row.
        }
      }
    } with {
      briefly "Stored claim row"
      described as {
        |The persistence shape of claim data as this repository stores it.
      }
    }
    schema ClaimData is relational
      of claims as type StoredClaim
        index on field StoredClaim.claimInfo.policyId
        index on field StoredClaim.assignedAdjuster
 with {
      briefly "Claim data schema"
      described as {
        |The relational schema holding claim data for the ClaimRepository.
      }
    }
    command PersistClaimFiled is  {
      claimId: ClaimId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ClaimFiled"
      described as {
        |Instructs this repository to apply ClaimFiled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAdjusterAssigned is  {
      claimId: ClaimId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist AdjusterAssigned"
      described as {
        |Instructs this repository to apply AdjusterAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInvestigationUpdated is  {
      claimId: ClaimId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist InvestigationUpdated"
      described as {
        |Instructs this repository to apply InvestigationUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReserveEstablished is  {
      claimId: ClaimId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ReserveEstablished"
      described as {
        |Instructs this repository to apply ReserveEstablished to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClaimApproved is  {
      claimId: ClaimId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ClaimApproved"
      described as {
        |Instructs this repository to apply ClaimApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentIssued is  {
      claimId: ClaimId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist PaymentIssued"
      described as {
        |Instructs this repository to apply PaymentIssued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClaimDenied is  {
      claimId: ClaimId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ClaimDenied"
      described as {
        |Instructs this repository to apply ClaimDenied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClaimClosed is  {
      claimId: ClaimId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ClaimClosed"
      described as {
        |Instructs this repository to apply ClaimClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler ClaimPersistence is {
      on query GetLossRatioMetric is {
        let lossRatioMetricView: type LossRatioMetricView = prompt("read the loss ratio metric projection")
        reply lossRatioMetricView
      }
      on query GetCycleTimeMetric is {
        let cycleTimeMetricView: type CycleTimeMetricView = prompt("read the cycle time metric projection")
        reply cycleTimeMetricView
      }
      on query GetClaimCycleTracking is {
        let claimCycleTrackingView: type ClaimCycleTrackingView = prompt("read the claim cycle tracking projection")
        reply claimCycleTrackingView
      }
      on command PersistClaimFiled is {
        do "apply ClaimFiled to the stored data"
      }
      on command PersistAdjusterAssigned is {
        do "apply AdjusterAssigned to the stored data"
      }
      on command PersistInvestigationUpdated is {
        do "apply InvestigationUpdated to the stored data"
      }
      on command PersistReserveEstablished is {
        do "apply ReserveEstablished to the stored data"
      }
      on command PersistClaimApproved is {
        do "apply ClaimApproved to the stored data"
      }
      on command PersistPaymentIssued is {
        do "apply PaymentIssued to the stored data"
      }
      on command PersistClaimDenied is {
        do "apply ClaimDenied to the stored data"
      }
      on command PersistClaimClosed is {
        do "apply ClaimClosed to the stored data"
      }
    } with {
      briefly "Persists claim events to storage"
      described as {
        |Handles all event-driven persistence operations for claims.
      }
    }
    handler ClaimQueries is {
      on findClaimById: query FindClaimById is {
        reply result Claim.ClaimResult(claimId = findClaimById.claimId)
      }
      on query FindClaimsByPolicy is {
        let claimResult: type Claim.ClaimResult = prompt("read the claim from the store")
        reply claimResult
      }
      on query FindClaimsByAdjuster is {
        let claimResult: type Claim.ClaimResult = prompt("read the claim from the store")
        reply claimResult
      }
      on findClaimsByStatus: query FindClaimsByStatus is {
        reply result Claim.ClaimResult(status = findClaimsByStatus.status)
      }
      on query FindOpenClaims is {
        let claimResult: type Claim.ClaimResult = prompt("read the claim from the store")
        reply claimResult
      }
    } with {
      briefly "Query handler for claim repository"
      described as {
        | Provides query capabilities for retrieving claim data
        | based on various search criteria.
      }
    }
  } with {
    briefly "Persistent storage for claims"
    described as {
      | The ClaimRepository provides persistent storage for claim
      | aggregates with indexes for efficient queries by policy,
      | adjuster, and status.
    }
  }
  // Projector for loss ratio analytics
  query GetLossRatioMetric replies result LossRatioMetricView is  {
    lossRatioMetricKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which loss ratio metric to retrieve.
      }
    }
  } with {
    briefly "Get loss ratio metric"
    described as {
      |Retrieves the loss ratio metric projection.
    }
  }
  result LossRatioMetricView is  {
    lossRatioMetric: LossRatioProjector.LossRatioMetric with {
      briefly "Loss ratio metric"
      described as {
        |The loss ratio metric being returned.
      }
    }
  } with {
    briefly "Loss ratio metric view"
    described as {
      |Read model view carrying the loss ratio metric projection.
    }
  }
  projector LossRatioProjector as flow is {
    outlet LossRatioProjectorToRepository is type ClaimRepositoryCommand
    updates repository ClaimsContext.ClaimRepository
    inlet LossRatioProjectorFromClaim is type ClaimEvent
    record LossRatioMetric is  {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start date of the measurement period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End date of the measurement period.
        }
      }
      policyType: String(1,50) with {
        briefly "Policy type"
        described as {
          |Type of policy being measured.
        }
      }
      earnedPremium: Decimal(14,2) with {
        briefly "Earned premium"
        described as {
          |Total premium earned during the period.
        }
      }
      incurredLosses: Decimal(14,2) with {
        briefly "Incurred losses"
        described as {
          |Total losses incurred including reserves.
        }
      }
      lossRatio: Decimal(5,4) with {
        briefly "Loss ratio"
        described as {
          |Ratio of incurred losses to earned premium.
        }
      }
      claimCount: Integer with {
        briefly "Claim count"
        described as {
          |Number of claims in the period.
        }
      }
      averageClaimSize: Decimal(12,2) with {
        briefly "Average claim size"
        described as {
          |Average incurred amount per claim.
        }
      }
    } with {
      briefly "Calculated loss ratio metrics"
      described as {
        | Aggregated financial metrics showing the ratio of claims
        | losses to earned premiums for a given period and policy type.
      }
    }
    handler LossRatioHandler is {
      on adjusterAssigned: event Claim.AdjusterAssigned is {
        tell command ClaimsContext.ClaimRepository.PersistAdjusterAssigned(claimId = adjusterAssigned.claimId) to repository ClaimsContext.ClaimRepository
        do "apply AdjusterAssigned to the LossRatioProjector projection"
      }
      on claimApproved: event Claim.ClaimApproved is {
        tell command ClaimsContext.ClaimRepository.PersistClaimApproved(claimId = claimApproved.claimId) to repository ClaimsContext.ClaimRepository
        do "apply ClaimApproved to the LossRatioProjector projection"
      }
      on claimDenied: event Claim.ClaimDenied is {
        tell command ClaimsContext.ClaimRepository.PersistClaimDenied(claimId = claimDenied.claimId) to repository ClaimsContext.ClaimRepository
        do "apply ClaimDenied to the LossRatioProjector projection"
      }
      on investigationUpdated: event Claim.InvestigationUpdated is {
        tell command ClaimsContext.ClaimRepository.PersistInvestigationUpdated(claimId = investigationUpdated.claimId) to repository ClaimsContext.ClaimRepository
        do "apply InvestigationUpdated to the LossRatioProjector projection"
      }
      on claimFiled: event Claim.ClaimFiled is {
        tell command ClaimsContext.ClaimRepository.PersistClaimFiled(claimId = claimFiled.claimId) to repository ClaimsContext.ClaimRepository
      }
      on reserveEstablished: event Claim.ReserveEstablished is {
        tell command ClaimsContext.ClaimRepository.PersistReserveEstablished(claimId = reserveEstablished.claimId) to repository ClaimsContext.ClaimRepository
      }
      on paymentIssued: event Claim.PaymentIssued is {
        tell command ClaimsContext.ClaimRepository.PersistPaymentIssued(claimId = paymentIssued.claimId) to repository ClaimsContext.ClaimRepository
      }
      on claimClosed: event Claim.ClaimClosed is {
        tell command ClaimsContext.ClaimRepository.PersistClaimClosed(claimId = claimClosed.claimId) to repository ClaimsContext.ClaimRepository
      }
    } with {
      briefly "Event handler for loss ratio projection"
      described as {
        | Consumes claim events to maintain real-time loss ratio
        | calculations and financial metrics.
      }
    }
  } with {
    briefly "Projector for loss ratio analytics"
    described as {
      | Maintains aggregated loss ratio metrics by consuming claim
      | lifecycle events. Provides key financial indicators for
      | underwriting and actuarial analysis.
    }
  }
  // Projector for cycle time metrics
  query GetCycleTimeMetric replies result CycleTimeMetricView is  {
    cycleTimeMetricKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which cycle time metric to retrieve.
      }
    }
  } with {
    briefly "Get cycle time metric"
    described as {
      |Retrieves the cycle time metric projection.
    }
  }
  result CycleTimeMetricView is  {
    cycleTimeMetric: CycleTimeProjector.CycleTimeMetric with {
      briefly "Cycle time metric"
      described as {
        |The cycle time metric being returned.
      }
    }
  } with {
    briefly "Cycle time metric view"
    described as {
      |Read model view carrying the cycle time metric projection.
    }
  }
  query GetClaimCycleTracking replies result ClaimCycleTrackingView is  {
    claimCycleTrackingKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which claim cycle tracking to retrieve.
      }
    }
  } with {
    briefly "Get claim cycle tracking"
    described as {
      |Retrieves the claim cycle tracking projection.
    }
  }
  result ClaimCycleTrackingView is  {
    claimCycleTracking: CycleTimeProjector.ClaimCycleTracking with {
      briefly "Claim cycle tracking"
      described as {
        |The claim cycle tracking being returned.
      }
    }
  } with {
    briefly "Claim cycle tracking view"
    described as {
      |Read model view carrying the claim cycle tracking projection.
    }
  }
  projector CycleTimeProjector as sink is {
    updates repository ClaimsContext.ClaimRepository
    inlet CycleTimeProjectorFromClaim is type ClaimEvent
    record CycleTimeMetric is  {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start date of the measurement period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End date of the measurement period.
        }
      }
      lossType: LossType with {
        briefly "Loss type"
        described as {
          |Type of loss being measured.
        }
      }
      averageDaysToAssign: Decimal(5,2) with {
        briefly "Days to assign"
        described as {
          |Average days from filing to adjuster assignment.
        }
      }
      averageDaysToReserve: Decimal(5,2) with {
        briefly "Days to reserve"
        described as {
          |Average days from filing to reserve establishment.
        }
      }
      averageDaysToClose: Decimal(6,2) with {
        briefly "Days to close"
        described as {
          |Average days from filing to closure.
        }
      }
      averageTouchCount: Decimal(5,2) with {
        briefly "Touch count"
        described as {
          |Average number of activities per claim.
        }
      }
      claimVolume: Integer with {
        briefly "Claim volume"
        described as {
          |Number of claims in the period.
        }
      }
    } with {
      briefly "Claims processing cycle time metrics"
      described as {
        | Operational metrics tracking the time and effort required
        | to process claims through various lifecycle stages.
      }
    }
    record ClaimCycleTracking is  {
      claimId: ClaimId with {
        briefly "Claim identifier"
        described as {
          |The claim being tracked.
        }
      }
      lossType: LossType with {
        briefly "Loss type"
        described as {
          |Type of loss for the claim.
        }
      }
      filedAt: TimeStamp with {
        briefly "Filed at"
        described as {
          |When the claim was filed.
        }
      }
      adjusterAssignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |When adjuster was assigned.
        }
      }
      reserveSetAt: TimeStamp? with {
        briefly "Reserve set at"
        described as {
          |When reserves were established.
        }
      }
      claimClosedAt: TimeStamp? with {
        briefly "Closed at"
        described as {
          |When the claim was closed.
        }
      }
      touchCount: Integer with {
        briefly "Touch count"
        described as {
          |Number of activities on the claim.
        }
      }
    } with {
      briefly "Individual claim cycle tracking"
      described as {
        | Tracks timing milestones for individual claims to
        | calculate aggregate cycle time metrics.
      }
    }
    handler CycleTimeHandler is {
      on claimApproved: event Claim.ClaimApproved is {
        tell command ClaimsContext.ClaimRepository.PersistClaimApproved(claimId = claimApproved.claimId) to repository ClaimsContext.ClaimRepository
        do "apply ClaimApproved to the CycleTimeProjector projection"
      }
      on claimDenied: event Claim.ClaimDenied is {
        tell command ClaimsContext.ClaimRepository.PersistClaimDenied(claimId = claimDenied.claimId) to repository ClaimsContext.ClaimRepository
        do "apply ClaimDenied to the CycleTimeProjector projection"
      }
      on paymentIssued: event Claim.PaymentIssued is {
        tell command ClaimsContext.ClaimRepository.PersistPaymentIssued(claimId = paymentIssued.claimId) to repository ClaimsContext.ClaimRepository
        do "apply PaymentIssued to the CycleTimeProjector projection"
      }
      on claimFiled: event Claim.ClaimFiled is {
        tell command ClaimsContext.ClaimRepository.PersistClaimFiled(claimId = claimFiled.claimId) to repository ClaimsContext.ClaimRepository
      }
      on adjusterAssigned: event Claim.AdjusterAssigned is {
        tell command ClaimsContext.ClaimRepository.PersistAdjusterAssigned(claimId = adjusterAssigned.claimId) to repository ClaimsContext.ClaimRepository
      }
      on reserveEstablished: event Claim.ReserveEstablished is {
        tell command ClaimsContext.ClaimRepository.PersistReserveEstablished(claimId = reserveEstablished.claimId) to repository ClaimsContext.ClaimRepository
      }
      on investigationUpdated: event Claim.InvestigationUpdated is {
        tell command ClaimsContext.ClaimRepository.PersistInvestigationUpdated(claimId = investigationUpdated.claimId) to repository ClaimsContext.ClaimRepository
      }
      on claimClosed: event Claim.ClaimClosed is {
        tell command ClaimsContext.ClaimRepository.PersistClaimClosed(claimId = claimClosed.claimId) to repository ClaimsContext.ClaimRepository
      }
    } with {
      briefly "Event handler for cycle time projection"
      described as {
        | Consumes claim events to track processing times and
        | calculate operational efficiency metrics.
      }
    }
  } with {
    briefly "Projector for claims processing efficiency metrics"
    described as {
      | Tracks and aggregates claims processing cycle times and
      | activity metrics. Provides operational KPIs for process
      | improvement and staffing decisions.
    }
  }
  processor ClaimEventSplit as split is {
    inlet ClaimEventSplitIn is type ClaimEvent
    outlet ClaimEventSplitToLossRatioProjector is type ClaimEvent
    outlet ClaimEventSplitToCycleTimeProjector is type ClaimEvent
    handler ClaimEventSplitHandler is {
      on claimFiled: event Claim.ClaimFiled is {
        send claimFiled to outlet ClaimEventSplitToLossRatioProjector
        send claimFiled to outlet ClaimEventSplitToCycleTimeProjector
        tell claimFiled to entity ClaimsContext.Claim
      }
      on adjusterAssigned: event Claim.AdjusterAssigned is {
        send adjusterAssigned to outlet ClaimEventSplitToLossRatioProjector
        send adjusterAssigned to outlet ClaimEventSplitToCycleTimeProjector
        tell adjusterAssigned to entity ClaimsContext.Claim
      }
      on investigationUpdated: event Claim.InvestigationUpdated is {
        send investigationUpdated to outlet ClaimEventSplitToLossRatioProjector
        send investigationUpdated to outlet ClaimEventSplitToCycleTimeProjector
        tell investigationUpdated to entity ClaimsContext.Claim
      }
      on reserveEstablished: event Claim.ReserveEstablished is {
        send reserveEstablished to outlet ClaimEventSplitToLossRatioProjector
        send reserveEstablished to outlet ClaimEventSplitToCycleTimeProjector
        tell reserveEstablished to entity ClaimsContext.Claim
      }
      on claimApproved: event Claim.ClaimApproved is {
        send claimApproved to outlet ClaimEventSplitToLossRatioProjector
        send claimApproved to outlet ClaimEventSplitToCycleTimeProjector
        tell claimApproved to entity ClaimsContext.Claim
      }
      on paymentIssued: event Claim.PaymentIssued is {
        send paymentIssued to outlet ClaimEventSplitToLossRatioProjector
        send paymentIssued to outlet ClaimEventSplitToCycleTimeProjector
        tell paymentIssued to entity ClaimsContext.Claim
      }
      on claimDenied: event Claim.ClaimDenied is {
        send claimDenied to outlet ClaimEventSplitToLossRatioProjector
        send claimDenied to outlet ClaimEventSplitToCycleTimeProjector
        tell claimDenied to entity ClaimsContext.Claim
      }
      on claimClosed: event Claim.ClaimClosed is {
        send claimClosed to outlet ClaimEventSplitToLossRatioProjector
        send claimClosed to outlet ClaimEventSplitToCycleTimeProjector
        tell claimClosed to entity ClaimsContext.Claim
      }
      on other is {
        error "Unexpected message for processor ClaimEventSplit"
      }
    } with {
      briefly "Claim event fan-out handler"
      described as {
        |Delivers each Claim event to all of its consumers.
      }
    }
  } with {
    briefly "Claim event fan-out"
    described as {
      |Fans Claim events out to the repository and projectors.
    }
  }
  connector 'ClaimEvent Stream' is from outlet ClaimsContext.Claim.ClaimEvents2 to inlet ClaimsContext.ClaimEventSplit.ClaimEventSplitIn with {
    briefly "Claim events, fanned out to storage and read models"
  }
  connector 'LossRatioProjector Feed' is from outlet ClaimsContext.ClaimEventSplit.ClaimEventSplitToLossRatioProjector to inlet ClaimsContext.LossRatioProjector.LossRatioProjectorFromClaim with {
    briefly "Claim events feeding the LossRatioProjector projection"
  }
  connector 'CycleTimeProjector Feed' is from outlet ClaimsContext.ClaimEventSplit.ClaimEventSplitToCycleTimeProjector to inlet ClaimsContext.CycleTimeProjector.CycleTimeProjectorFromClaim with {
    briefly "Claim events feeding the CycleTimeProjector projection"
  }
  connector 'LossRatioProjector Storage' is from outlet ClaimsContext.LossRatioProjector.LossRatioProjectorToRepository to inlet ClaimsContext.ClaimRepository.ClaimRepositoryFromLossRatioProjector with {
    briefly "LossRatioProjector updates on their way to storage"
  }
} with {
  briefly "Bounded context for claims processing operations"
  described as {
    | The ClaimsContext encapsulates all claims processing capabilities
    | including the Claim aggregate, persistence repository, and analytics
    | projections. It defines the boundary within which claims terminology
    | and rules have consistent meaning.
  }
}
