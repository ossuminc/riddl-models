// Policy Administration - Policy Context
context PolicyContext is {
  adaptor FromBillingService from context BillingService is {
    handler FromBillingServiceHandler is {
      on event BillingService.BillingSetupComplete is {
        do "the model receives billing setup complete"
      }
      on event BillingService.PaymentPastDue is {
        do "the model receives payment past due"
      }
      on event BillingService.PaymentReceived is {
        do "the model receives payment received"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
      briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService is {
    handler ToBillingServiceHandler is {
      on command BillingService.AdjustBilling is {
        do "the model sends adjust billing"
      }
      on command BillingService.ProcessRefund is {
        do "the model sends process refund"
      }
      on command BillingService.SetupBilling is {
        do "the model sends setup billing"
      }
      on command BillingService.SuspendBilling is {
        do "the model sends suspend billing"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
      briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromDocumentService from context DocumentService is {
    handler FromDocumentServiceHandler is {
      on event DocumentService.DocumentGenerated is {
        do "the model receives document generated"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentService"
      }
    } with {
      briefly "from document service"
      described as {
        |Carries messages from the external DocumentService.
      }
    }
  } with {
      briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor ToDocumentService to context DocumentService is {
    handler ToDocumentServiceHandler is {
      on command DocumentService.GenerateCancellationNotice is {
        do "the model sends generate cancellation notice"
      }
      on command DocumentService.GeneratePolicyDocuments is {
        do "the model sends generate policy documents"
      }
      on command DocumentService.GenerateRenewalNotice is {
        do "the model sends generate renewal notice"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentService"
      }
    } with {
      briefly "to document service"
      described as {
        |Carries messages to the external DocumentService.
      }
    }
  } with {
      briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor FromRatingEngine from context RatingEngine is {
    handler FromRatingEngineHandler is {
      on event RatingEngine.PolicyRated is {
        do "the model receives policy rated"
      }
      on other is {
        error "Unexpected message for adaptor FromRatingEngine"
      }
    } with {
      briefly "from rating engine"
      described as {
        |Carries messages from the external RatingEngine.
      }
    }
  } with {
      briefly "RatingEngine integration"
    described as {
      |The model's side of the RatingEngine conversation.
    }
  }
  adaptor ToRatingEngine to context RatingEngine is {
    handler ToRatingEngineHandler is {
      on command RatingEngine.RateEndorsement is {
        do "the model sends rate endorsement"
      }
      on command RatingEngine.RatePolicy is {
        do "the model sends rate policy"
      }
      on command RatingEngine.RateRenewal is {
        do "the model sends rate renewal"
      }
      on other is {
        error "Unexpected message for adaptor ToRatingEngine"
      }
    } with {
      briefly "to rating engine"
      described as {
        |Carries messages to the external RatingEngine.
      }
    }
  } with {
      briefly "RatingEngine integration"
    described as {
      |The model's side of the RatingEngine conversation.
    }
  }
  include "types.riddl"
  include "Policy.riddl"
  // Repository for policy persistence
  repository PolicyRepository is {
    inlet PolicyRepositoryFromPolicy is type PolicyEvent
    inlet PolicyRepositoryFromPolicyMetricsProjector is type PolicyEvent
    outlet PolicyRepositoryResponses is type Policy.PolicyResult
    schema PolicyData is relational
      of policies as type Policy
        index on field Policy.policyId
        index on field Policy.details.policyNumber
        index on field Policy.details.insuredName
      with {
      briefly "Policy data schema"
      described as {
        |The relational schema holding policy data for the PolicyRepository.
      }
    }

    handler PolicyPersistence is {
      on command Policy.IssuePolicy is {
        tell event Policy.PolicyIssued to entity
          PolicyContext.Policy
      }
      on command Policy.AddEndorsement is {
        tell event Policy.EndorsementAdded to entity
          PolicyContext.Policy
      }
      on command Policy.ProcessRenewal is {
        tell event Policy.RenewalProcessed to entity
          PolicyContext.Policy
      }
      on command Policy.DeclineRenewal is {
        tell event Policy.RenewalDeclined to entity
          PolicyContext.Policy
      }
      on command Policy.CancelPolicy is {
        tell event Policy.PolicyCancelled to entity
          PolicyContext.Policy
      }
      on command Policy.ReinstatPolicy is {
        tell event Policy.PolicyReinstated to entity
          PolicyContext.Policy
      }
      on command Policy.UpdateBilling is {
        tell event Policy.BillingUpdated to entity
          PolicyContext.Policy
      }
      on command Policy.GenerateRenewalOffer is {
        tell event Policy.RenewalOfferGenerated to entity
          PolicyContext.Policy
      }
    } with {
      briefly "Persists policy commands"
      described as {
        |Handles command-driven persistence for policies.
      }
    }
  } with {
    briefly "Policy data persistence"
    described as {
      | The PolicyRepository provides persistent storage for
      | policy records including endorsements and renewals.
    }
  }
  // Projector for policy metrics
  projector PolicyMetricsProjector is {
    inlet PolicyMetricsProjectorFromPolicy is type PolicyEvent
    outlet PolicyMetricsProjectorOut is type PolicyEvent
    updates repository PolicyContext.PolicyRepository
    record PolicyMetricsView is  {
      policyId: PolicyId with {
        briefly "Policy"
        described as {
          |Policy ID.
        }
      }
      policyNumber: String(1,20) with {
        briefly "Number"
        described as {
          |Policy number.
        }
      }
      insuredName: String(1,200) with {
        briefly "Insured"
        described as {
          |Insured name.
        }
      }
      status: PolicyStatus with {
        briefly "Status"
        described as {
          |Policy status.
        }
      }
      effectiveDate: Date with {
        briefly "Effective"
        described as {
          |Effective date.
        }
      }
      expirationDate: Date with {
        briefly "Expiration"
        described as {
          |Expiration date.
        }
      }
      totalPremium: Decimal(12,2) with {
        briefly "Premium"
        described as {
          |Total premium.
        }
      }
      endorsementCount: Integer with {
        briefly "Endorsements"
        described as {
          |Endorsement count.
        }
      }
      lastActivityDate: Date with {
        briefly "Last activity"
        described as {
          |Last activity date.
        }
      }
      renewalEligible: Boolean with {
        briefly "Renewal eligible"
        described as {
          |Is eligible for renewal.
        }
      }
    } with {
      briefly "Policy metrics view"
      described as {
        |Denormalized view for policy metrics.
      }
    }
    record PortfolioSummary is  {
      totalActivePolicies: Integer with {
        briefly "Active"
        described as {
          |Total active policies.
        }
      }
      totalWrittenPremium: Decimal(14,2) with {
        briefly "Written"
        described as {
          |Total written premium.
        }
      }
      policiesExpiringThisMonth: Integer with {
        briefly "Expiring"
        described as {
          |Policies expiring this month.
        }
      }
      averagePolicyAge: Decimal(5,2) with {
        briefly "Avg age"
        described as {
          |Average policy age in days.
        }
      }
      endorsementsThisMonth: Integer with {
        briefly "Endorsements"
        described as {
          |Endorsements this month.
        }
      }
      cancellationsThisMonth: Integer with {
        briefly "Cancellations"
        described as {
          |Cancellations this month.
        }
      }
      renewalRate: Decimal(5,4) with {
        briefly "Renewal rate"
        described as {
          |Renewal rate percentage.
        }
      }
    } with {
      briefly "Portfolio summary"
      described as {
        |Aggregated metrics across the policy portfolio.
      }
    }
    handler MetricsHandler is {
      on event Policy.PolicyIssued is {
        tell event Policy.PolicyIssued to repository
          PolicyContext.PolicyRepository
      }
      on event Policy.EndorsementAdded is {
        tell event Policy.EndorsementAdded to repository
          PolicyContext.PolicyRepository
      }
      on event Policy.RenewalProcessed is {
        tell event Policy.RenewalProcessed to repository
          PolicyContext.PolicyRepository
      }
      on event Policy.PolicyCancelled is {
        tell event Policy.PolicyCancelled to repository
          PolicyContext.PolicyRepository
      }
      on event Policy.PolicyReinstated is {
        tell event Policy.PolicyReinstated to repository
          PolicyContext.PolicyRepository
      }
    } with {
      briefly "Maintains policy metrics"
      described as {
        |Projects events into metrics views.
      }
    }
  } with {
    briefly "Policy metrics projector"
    described as {
      | Maintains read-optimized views of policy data for
      | dashboards, reporting, and portfolio analysis.
    }
  }
  processor PolicyEventSource as source is {
    outlet PolicyEvents is type PolicyEvent
    handler PolicyEventEmitter is {
      on init is {
        tell command InitializePolicy to entity
          PolicyContext.Policy
      }
      on other is {
        error "Unexpected message for source PolicyEventSource"
      }
      on event Policy.PolicyIssued is {
        send event Policy.PolicyIssued to outlet PolicyEvents
      }
      on event Policy.PolicyCancelled is {
        send event Policy.PolicyCancelled to outlet PolicyEvents
      }
      on event Policy.RenewalProcessed is {
        send event Policy.RenewalProcessed to outlet PolicyEvents
      }
      on event Policy.PolicyReinstated is {
        send event Policy.PolicyReinstated to outlet PolicyEvents
      }
    } with {
      briefly "Policy event emitter"
      described as {
        |Emits policy lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Policy event source"
    described as {
      |Publishes policy entity events for streaming.
    }
  }
  processor PolicyEventSink as sink is {
    inlet IncomingPolicyEvents is type PolicyEvent
    handler PolicyEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink PolicyEventSink"
      }
      on event Policy.PolicyIssued is {
        tell event Policy.PolicyIssued to repository
          PolicyContext.PolicyRepository
      }
      on event Policy.PolicyCancelled is {
        tell event Policy.PolicyCancelled to repository
          PolicyContext.PolicyRepository
      }
    } with {
      briefly "Policy event receiver"
      described as {
        |Receives policy events and persists them.
      }
    }
  } with {
    briefly "Policy event sink"
    described as {
      |Receives policy events from the streaming topology.
    }
  }
  connector PolicyEventPipeline is {
    from outlet PolicyContext.PolicyEventSource.PolicyEvents
      to inlet PolicyContext.PolicyEventSink.IncomingPolicyEvents
  } with {
    briefly "Policy event pipeline"
    described as {
      |Wires policy events from source to sink.
    }
  }
  processor PolicyEventSplit is {
    inlet PolicyEventSplitIn is type PolicyEvent
    outlet PolicyEventSplitToPolicyRepository is type PolicyEvent
    outlet PolicyEventSplitToPolicyMetricsProjector is type PolicyEvent
    handler PolicyEventSplitHandler is {
      on event Policy.PolicyIssued is {
        send event Policy.PolicyIssued to outlet PolicyEventSplitToPolicyRepository
        send event Policy.PolicyIssued to outlet PolicyEventSplitToPolicyMetricsProjector
        tell event Policy.PolicyIssued to entity PolicyContext.Policy
      }
      on event Policy.EndorsementAdded is {
        send event Policy.EndorsementAdded to outlet PolicyEventSplitToPolicyRepository
        send event Policy.EndorsementAdded to outlet PolicyEventSplitToPolicyMetricsProjector
        tell event Policy.EndorsementAdded to entity PolicyContext.Policy
      }
      on event Policy.RenewalProcessed is {
        send event Policy.RenewalProcessed to outlet PolicyEventSplitToPolicyRepository
        send event Policy.RenewalProcessed to outlet PolicyEventSplitToPolicyMetricsProjector
        tell event Policy.RenewalProcessed to entity PolicyContext.Policy
      }
      on event Policy.RenewalDeclined is {
        send event Policy.RenewalDeclined to outlet PolicyEventSplitToPolicyRepository
        send event Policy.RenewalDeclined to outlet PolicyEventSplitToPolicyMetricsProjector
        tell event Policy.RenewalDeclined to entity PolicyContext.Policy
      }
      on event Policy.PolicyCancelled is {
        send event Policy.PolicyCancelled to outlet PolicyEventSplitToPolicyRepository
        send event Policy.PolicyCancelled to outlet PolicyEventSplitToPolicyMetricsProjector
        tell event Policy.PolicyCancelled to entity PolicyContext.Policy
      }
      on event Policy.PolicyReinstated is {
        send event Policy.PolicyReinstated to outlet PolicyEventSplitToPolicyRepository
        send event Policy.PolicyReinstated to outlet PolicyEventSplitToPolicyMetricsProjector
        tell event Policy.PolicyReinstated to entity PolicyContext.Policy
      }
      on event Policy.BillingUpdated is {
        send event Policy.BillingUpdated to outlet PolicyEventSplitToPolicyRepository
        send event Policy.BillingUpdated to outlet PolicyEventSplitToPolicyMetricsProjector
        tell event Policy.BillingUpdated to entity PolicyContext.Policy
      }
      on event Policy.RenewalOfferGenerated is {
        send event Policy.RenewalOfferGenerated to outlet PolicyEventSplitToPolicyRepository
        send event Policy.RenewalOfferGenerated to outlet PolicyEventSplitToPolicyMetricsProjector
        tell event Policy.RenewalOfferGenerated to entity PolicyContext.Policy
      }
      on other is {
        error "Unexpected message for processor PolicyEventSplit"
      }
    } with {
      briefly "Policy event fan-out handler"
      described as {
        |Delivers each Policy event to all of its consumers.
      }
    }
  } with {
    briefly "Policy event fan-out"
    described as {
      |Fans Policy events out to the repository and projectors.
    }
  }
  connector LinkPolicyToPolicyEventSplit is {
    from outlet PolicyContext.Policy.PolicyEvents2 to
      inlet PolicyContext.PolicyEventSplit.PolicyEventSplitIn
  } with {
    briefly "LinkPolicyToPolicyEventSplit"
  }
  connector LinkPolicyEventSplitToPolicyRepository is {
    from outlet PolicyContext.PolicyEventSplit.PolicyEventSplitToPolicyRepository to
      inlet PolicyContext.PolicyRepository.PolicyRepositoryFromPolicy
  } with {
    briefly "LinkPolicyEventSplitToPolicyRepository"
  }
  connector LinkPolicyEventSplitToPolicyMetricsProjector is {
    from outlet PolicyContext.PolicyEventSplit.PolicyEventSplitToPolicyMetricsProjector to
      inlet PolicyContext.PolicyMetricsProjector.PolicyMetricsProjectorFromPolicy
  } with {
    briefly "LinkPolicyEventSplitToPolicyMetricsProjector"
  }
  connector LinkPolicyMetricsProjectorToPolicyRepository is {
    from outlet PolicyContext.PolicyMetricsProjector.PolicyMetricsProjectorOut to
      inlet PolicyContext.PolicyRepository.PolicyRepositoryFromPolicyMetricsProjector
  } with {
    briefly "LinkPolicyMetricsProjectorToPolicyRepository"
  }
} with {
  briefly "Bounded context for policy administration"
  described as {
    | The PolicyContext is the bounded context for policy
    | administration including the Policy aggregate, repository,
    | and projections for metrics.
  }
}
