// Policy Administration - Policy Context
context PolicyContext is {
  adaptor FromBillingService from context BillingService is { 
    handler FromBillingServiceHandler is {
      on event BillingService.BillingSetupComplete is {
        do "the model receives billing setup complete"
      }
      on event BillingService.PaymentPastDue is {
        do "the model receives payment past due"
      }
      on event BillingService.PaymentReceived is {
        do "the model receives payment received"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService is { 
    handler ToBillingServiceHandler is {
      on command BillingService.AdjustBilling is {
        do "the model sends adjust billing"
      }
      on command BillingService.ProcessRefund is {
        do "the model sends process refund"
      }
      on command BillingService.SetupBilling is {
        do "the model sends setup billing"
      }
      on command BillingService.SuspendBilling is {
        do "the model sends suspend billing"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromDocumentService from context DocumentService is { 
    handler FromDocumentServiceHandler is {
      on event DocumentService.DocumentGenerated is {
        do "the model receives document generated"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentService"
      }
    } with {
      briefly "from document service"
      described as {
        |Carries messages from the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor ToDocumentService to context DocumentService is { 
    handler ToDocumentServiceHandler is {
      on command DocumentService.GenerateCancellationNotice is {
        do "the model sends generate cancellation notice"
      }
      on command DocumentService.GeneratePolicyDocuments is {
        do "the model sends generate policy documents"
      }
      on command DocumentService.GenerateRenewalNotice is {
        do "the model sends generate renewal notice"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentService"
      }
    } with {
      briefly "to document service"
      described as {
        |Carries messages to the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor FromRatingEngine from context RatingEngine is { 
    handler FromRatingEngineHandler is {
      on event RatingEngine.PolicyRated is {
        do "the model receives policy rated"
      }
      on other is {
        error "Unexpected message for adaptor FromRatingEngine"
      }
    } with {
      briefly "from rating engine"
      described as {
        |Carries messages from the external RatingEngine.
      }
    }
  } with {
    briefly "RatingEngine integration"
    described as {
      |The model's side of the RatingEngine conversation.
    }
  }
  adaptor ToRatingEngine to context RatingEngine is { 
    handler ToRatingEngineHandler is {
      on command RatingEngine.RateEndorsement is {
        do "the model sends rate endorsement"
      }
      on command RatingEngine.RatePolicy is {
        do "the model sends rate policy"
      }
      on command RatingEngine.RateRenewal is {
        do "the model sends rate renewal"
      }
      on other is {
        error "Unexpected message for adaptor ToRatingEngine"
      }
    } with {
      briefly "to rating engine"
      described as {
        |Carries messages to the external RatingEngine.
      }
    }
  } with {
    briefly "RatingEngine integration"
    described as {
      |The model's side of the RatingEngine conversation.
    }
  }
  include "types.riddl"
  include "Policy.riddl"
  // Repository for policy persistence
  repository PolicyRepository as merge is {
    inlet PolicyRepositoryFromPolicy is type PolicyEvent    inlet PolicyRepositoryFromPolicyMetricsProjector is type PolicyEvent    outlet PolicyRepositoryResponses is type Policy.PolicyResult
    record StoredPolicy is  {
      policyId: PolicyId with {
        briefly "policyId"
        described as {
          |The policyId column of the stored policy row.
        }
      }
      details: PolicyDetails with {
        briefly "details"
        described as {
          |The details column of the stored policy row.
        }
      }
    } with {
      briefly "Stored policy row"
      described as {
        |The persistence shape of policy data as this repository stores it.
      }
    }
    schema PolicyData is relational
      of policies as type StoredPolicy
        index on field StoredPolicy.policyId
        index on field StoredPolicy.details.policyNumber
        index on field StoredPolicy.details.insuredName
 with {
      briefly "Policy data schema"
      described as {
        |The relational schema holding policy data for the PolicyRepository.
      }
    }
    handler PolicyPersistence is {
      on query GetPolicyMetricsView is {
        let policyMetricsViewView: type PolicyMetricsViewView = prompt("read the policy metrics view projection")
        reply policyMetricsViewView
      }
      on query GetPortfolioSummary is {
        let portfolioSummaryView: type PortfolioSummaryView = prompt("read the portfolio summary projection")
        reply portfolioSummaryView
      }
      on issuePolicy: command Policy.IssuePolicy is {
        tell event Policy.PolicyIssued(policyId = issuePolicy.policyId, details = issuePolicy.details, billingSchedule = issuePolicy.billingSchedule, issuedBy = issuePolicy.issuedBy) to entity PolicyContext.Policy
      }
      on addEndorsement: command Policy.AddEndorsement is {
        tell event Policy.EndorsementAdded(policyId = addEndorsement.policyId, endorsement = addEndorsement.endorsement) to entity PolicyContext.Policy
      }
      on processRenewal: command Policy.ProcessRenewal is {
        tell event Policy.RenewalProcessed(policyId = processRenewal.policyId, renewalOffer = processRenewal.renewalOffer) to entity PolicyContext.Policy by policyId
      }
      on declineRenewal: command Policy.DeclineRenewal is {
        tell event Policy.RenewalDeclined(policyId = declineRenewal.policyId, renewalId = declineRenewal.renewalId, declineReason = declineRenewal.declineReason) to entity PolicyContext.Policy
      }
      on cancelPolicy: command Policy.CancelPolicy is {
        tell event Policy.PolicyCancelled(policyId = cancelPolicy.policyId, cancellationDate = cancelPolicy.cancellationDate, reason = cancelPolicy.reason) to entity PolicyContext.Policy
      }
      on reinstatPolicy: command Policy.ReinstatPolicy is {
        tell event Policy.PolicyReinstated(policyId = reinstatPolicy.policyId, reinstatementDate = reinstatPolicy.reinstatementDate, approvedBy = reinstatPolicy.approvedBy) to entity PolicyContext.Policy
      }
      on updateBilling: command Policy.UpdateBilling is {
        tell event Policy.BillingUpdated(policyId = updateBilling.policyId, newSchedule = updateBilling.newSchedule) to entity PolicyContext.Policy
      }
      on generateRenewalOffer: command Policy.GenerateRenewalOffer is {
        tell event Policy.RenewalOfferGenerated(policyId = generateRenewalOffer.policyId) to entity PolicyContext.Policy
      }
    } with {
      briefly "Persists policy commands"
      described as {
        |Handles command-driven persistence for policies.
      }
    }
  } with {
    briefly "Policy data persistence"
    described as {
      | The PolicyRepository provides persistent storage for
      | policy records including endorsements and renewals.
    }
  }
  // Projector for policy metrics
  query GetPolicyMetricsView is  {
    policyMetricsViewKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which policy metrics view to retrieve.
      }
    }
  } with {
    briefly "Get policy metrics view"
    described as {
      |Retrieves the policy metrics view projection.
    }
  }
  result PolicyMetricsViewView is  {
    policyMetricsView: PolicyMetricsProjector.PolicyMetricsView with {
      briefly "Policy metrics view"
      described as {
        |The policy metrics view being returned.
      }
    }
  } with {
    briefly "Policy metrics view view"
    described as {
      |Read model view carrying the policy metrics view projection.
    }
  }
  query GetPortfolioSummary is  {
    portfolioSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which portfolio summary to retrieve.
      }
    }
  } with {
    briefly "Get portfolio summary"
    described as {
      |Retrieves the portfolio summary projection.
    }
  }
  result PortfolioSummaryView is  {
    portfolioSummary: PolicyMetricsProjector.PortfolioSummary with {
      briefly "Portfolio summary"
      described as {
        |The portfolio summary being returned.
      }
    }
  } with {
    briefly "Portfolio summary view"
    described as {
      |Read model view carrying the portfolio summary projection.
    }
  }
  projector PolicyMetricsProjector as flow is {
    updates repository PolicyContext.PolicyRepository
    inlet PolicyMetricsProjectorFromPolicy is type PolicyEvent    outlet PolicyMetricsProjectorOut is type PolicyEvent
    record PolicyMetricsView is  {
      policyId: PolicyId with {
        briefly "Policy"
        described as {
          |Policy ID.
        }
      }
      policyNumber: String(1,20) with {
        briefly "Number"
        described as {
          |Policy number.
        }
      }
      insuredName: String(1,200) with {
        briefly "Insured"
        described as {
          |Insured name.
        }
      }
      status: PolicyStatus with {
        briefly "Status"
        described as {
          |Policy status.
        }
      }
      effectiveDate: Date with {
        briefly "Effective"
        described as {
          |Effective date.
        }
      }
      expirationDate: Date with {
        briefly "Expiration"
        described as {
          |Expiration date.
        }
      }
      totalPremium: Decimal(12,2) with {
        briefly "Premium"
        described as {
          |Total premium.
        }
      }
      endorsementCount: Integer with {
        briefly "Endorsements"
        described as {
          |Endorsement count.
        }
      }
      lastActivityDate: Date with {
        briefly "Last activity"
        described as {
          |Last activity date.
        }
      }
      renewalEligible: Boolean with {
        briefly "Renewal eligible"
        described as {
          |Is eligible for renewal.
        }
      }
    } with {
      briefly "Policy metrics view"
      described as {
        |Denormalized view for policy metrics.
      }
    }
    record PortfolioSummary is  {
      totalActivePolicies: Integer with {
        briefly "Active"
        described as {
          |Total active policies.
        }
      }
      totalWrittenPremium: Decimal(14,2) with {
        briefly "Written"
        described as {
          |Total written premium.
        }
      }
      policiesExpiringThisMonth: Integer with {
        briefly "Expiring"
        described as {
          |Policies expiring this month.
        }
      }
      averagePolicyAge: Decimal(5,2) with {
        briefly "Avg age"
        described as {
          |Average policy age in days.
        }
      }
      endorsementsThisMonth: Integer with {
        briefly "Endorsements"
        described as {
          |Endorsements this month.
        }
      }
      cancellationsThisMonth: Integer with {
        briefly "Cancellations"
        described as {
          |Cancellations this month.
        }
      }
      renewalRate: Decimal(5,4) with {
        briefly "Renewal rate"
        described as {
          |Renewal rate percentage.
        }
      }
    } with {
      briefly "Portfolio summary"
      described as {
        |Aggregated metrics across the policy portfolio.
      }
    }
    handler MetricsHandler is {
      on policyIssued: event Policy.PolicyIssued is {
        tell policyIssued to repository PolicyContext.PolicyRepository
      }
      on endorsementAdded: event Policy.EndorsementAdded is {
        tell endorsementAdded to repository PolicyContext.PolicyRepository
      }
      on renewalProcessed: event Policy.RenewalProcessed is {
        tell renewalProcessed to repository PolicyContext.PolicyRepository
      }
      on policyCancelled: event Policy.PolicyCancelled is {
        tell policyCancelled to repository PolicyContext.PolicyRepository
      }
      on policyReinstated: event Policy.PolicyReinstated is {
        tell policyReinstated to repository PolicyContext.PolicyRepository
      }
    } with {
      briefly "Maintains policy metrics"
      described as {
        |Projects events into metrics views.
      }
    }
  } with {
    briefly "Policy metrics projector"
    described as {
      | Maintains read-optimized views of policy data for
      | dashboards, reporting, and portfolio analysis.
    }
  }
  processor PolicyEventSource as source is {
    outlet PolicyEvents is type PolicyEvent
    handler PolicyEventEmitter is {
      on init is {
        let initializePolicy: type InitializePolicy = prompt("the initialize policy that brings this this into existence")
        tell initializePolicy to entity PolicyContext.Policy
      }
      on other is {
        error "Unexpected message for source PolicyEventSource"
      }
      on policyIssued: event Policy.PolicyIssued is {
        send policyIssued to outlet PolicyEvents
      }
      on policyCancelled: event Policy.PolicyCancelled is {
        send policyCancelled to outlet PolicyEvents
      }
      on renewalProcessed: event Policy.RenewalProcessed is {
        send renewalProcessed to outlet PolicyEvents
      }
      on policyReinstated: event Policy.PolicyReinstated is {
        send policyReinstated to outlet PolicyEvents
      }
    } with {
      briefly "Policy event emitter"
      described as {
        |Emits policy lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Policy event source"
    described as {
      |Publishes policy entity events for streaming.
    }
  }
  processor PolicyEventSink as sink is {
    inlet IncomingPolicyEvents is type PolicyEvent    handler PolicyEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink PolicyEventSink"
      }
      on policyIssued: event Policy.PolicyIssued is {
        tell policyIssued to repository PolicyContext.PolicyRepository
      }
      on policyCancelled: event Policy.PolicyCancelled is {
        tell policyCancelled to repository PolicyContext.PolicyRepository
      }
    } with {
      briefly "Policy event receiver"
      described as {
        |Receives policy events and persists them.
      }
    }
  } with {
    briefly "Policy event sink"
    described as {
      |Receives policy events from the streaming topology.
    }
  }
  connector PolicyEventPipeline is from outlet PolicyContext.PolicyEventSource.PolicyEvents to inlet PolicyContext.PolicyEventSink.IncomingPolicyEvents with {
    briefly "Policy event pipeline"
    described as {
      |Wires policy events from source to sink.
    }
  }
  processor PolicyEventSplit as split is {
    inlet PolicyEventSplitIn is type PolicyEvent    outlet PolicyEventSplitToPolicyRepository is type PolicyEvent
    outlet PolicyEventSplitToPolicyMetricsProjector is type PolicyEvent
    handler PolicyEventSplitHandler is {
      on policyIssued: event Policy.PolicyIssued is {
        send policyIssued to outlet PolicyEventSplitToPolicyRepository
        send policyIssued to outlet PolicyEventSplitToPolicyMetricsProjector
        tell policyIssued to entity PolicyContext.Policy
      }
      on endorsementAdded: event Policy.EndorsementAdded is {
        send endorsementAdded to outlet PolicyEventSplitToPolicyRepository
        send endorsementAdded to outlet PolicyEventSplitToPolicyMetricsProjector
        tell endorsementAdded to entity PolicyContext.Policy
      }
      on renewalProcessed: event Policy.RenewalProcessed is {
        send renewalProcessed to outlet PolicyEventSplitToPolicyRepository
        send renewalProcessed to outlet PolicyEventSplitToPolicyMetricsProjector
        tell renewalProcessed to entity PolicyContext.Policy by policyId
      }
      on renewalDeclined: event Policy.RenewalDeclined is {
        send renewalDeclined to outlet PolicyEventSplitToPolicyRepository
        send renewalDeclined to outlet PolicyEventSplitToPolicyMetricsProjector
        tell renewalDeclined to entity PolicyContext.Policy
      }
      on policyCancelled: event Policy.PolicyCancelled is {
        send policyCancelled to outlet PolicyEventSplitToPolicyRepository
        send policyCancelled to outlet PolicyEventSplitToPolicyMetricsProjector
        tell policyCancelled to entity PolicyContext.Policy
      }
      on policyReinstated: event Policy.PolicyReinstated is {
        send policyReinstated to outlet PolicyEventSplitToPolicyRepository
        send policyReinstated to outlet PolicyEventSplitToPolicyMetricsProjector
        tell policyReinstated to entity PolicyContext.Policy
      }
      on billingUpdated: event Policy.BillingUpdated is {
        send billingUpdated to outlet PolicyEventSplitToPolicyRepository
        send billingUpdated to outlet PolicyEventSplitToPolicyMetricsProjector
        tell billingUpdated to entity PolicyContext.Policy
      }
      on renewalOfferGenerated: event Policy.RenewalOfferGenerated is {
        send renewalOfferGenerated to outlet PolicyEventSplitToPolicyRepository
        send renewalOfferGenerated to outlet PolicyEventSplitToPolicyMetricsProjector
        tell renewalOfferGenerated to entity PolicyContext.Policy
      }
      on other is {
        error "Unexpected message for processor PolicyEventSplit"
      }
    } with {
      briefly "Policy event fan-out handler"
      described as {
        |Delivers each Policy event to all of its consumers.
      }
    }
  } with {
    briefly "Policy event fan-out"
    described as {
      |Fans Policy events out to the repository and projectors.
    }
  }
  connector 'PolicyEvent Stream' is from outlet PolicyContext.Policy.PolicyEvents2 to inlet PolicyContext.PolicyEventSplit.PolicyEventSplitIn with {
    briefly "Policy events, fanned out to storage and read models"
  }
  connector 'PolicyEvent Storage' is from outlet PolicyContext.PolicyEventSplit.PolicyEventSplitToPolicyRepository to inlet PolicyContext.PolicyRepository.PolicyRepositoryFromPolicy with {
    briefly "Policy events on their way to storage"
  }
  connector 'PolicyMetricsProjector Feed' is from outlet PolicyContext.PolicyEventSplit.PolicyEventSplitToPolicyMetricsProjector to inlet PolicyContext.PolicyMetricsProjector.PolicyMetricsProjectorFromPolicy with {
    briefly "Policy events feeding the PolicyMetricsProjector projection"
  }
  connector 'PolicyMetricsProjector Storage' is from outlet PolicyContext.PolicyMetricsProjector.PolicyMetricsProjectorOut to inlet PolicyContext.PolicyRepository.PolicyRepositoryFromPolicyMetricsProjector with {
    briefly "The PolicyMetricsProjector projection on its way to storage"
  }
} with {
  briefly "Bounded context for policy administration"
  described as {
    | The PolicyContext is the bounded context for policy
    | administration including the Policy aggregate, repository,
    | and projections for metrics.
  }
}
