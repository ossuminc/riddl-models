// Dispensing Context - Bounded context for medication dispensing operations
context DispensingContext is {
  include "types.riddl"
  include "Fill.riddl"
  // === Repository ===
  repository FillRepository is {
    schema FillData is relational
      of fills as type Fill
      with {
      briefly "Fill data schema"
      described as {
        |The relational schema persisting fill records for this repository.
      }
    }
    inlet FillRepositoryFromFill is type FillEvent
    inlet FillRepositoryFromDispensingMetrics is type FillEvent
    outlet FillRepositoryResponses is type Fill.FillResult
    handler FillQueries is {
      on query GetFillById is {
        yield result FillResult
      }
      on query GetFillsByPatient is {
        yield result FillResult
      }
      on query GetFillsByStatus is {
        yield result FillResult
      }
      on query GetPendingFills is {
        yield result FillResult
      }
      on query GetReadyForPickup is {
        yield result FillResult
      }
    } with {
      briefly "Fill queries"
      described as {
        |Query handler for fill records.
      }
    }
    handler CounselingQueries is {
      on query GetCounselingByFill is {
        yield result FillResult
      }
      on query GetCounselingByPharmacist is {
        yield result FillResult
      }
      on query GetDeclinedCounseling is {
        yield result FillResult
      }
    } with {
      briefly "Counseling queries"
      described as {
        |Query handler for counseling records.
      }
    }
    handler PickupQueries is {
      on query GetPickupsByDate is {
        yield result FillResult
      }
      on query GetOverduePickups is {
        yield result FillResult
      }
    } with {
      briefly "Pickup queries"
      described as {
        |Query handler for pickup records.
      }
    }
  } with {
    briefly "Fill repository"
    described as {
      |Repository for fill, counseling, and pickup records.
    }
  }
  // === Projector ===
  projector DispensingMetrics is {
    inlet DispensingMetricsFromFill is type FillEvent
    outlet DispensingMetricsOut is type FillEvent
    updates repository DispensingContext.FillRepository
    record FillTimeData is  {
      fillId: FillId with {
        briefly "Fill"
        described as {
          |Fill ID.
        }
      }
      initiatedAt: TimeStamp with {
        briefly "Initiated"
        described as {
          |Initiation time.
        }
      }
      selectedAt: TimeStamp? with {
        briefly "Selected"
        described as {
          |Selection time.
        }
      }
      filledAt: TimeStamp? with {
        briefly "Filled"
        described as {
          |Fill time.
        }
      }
      verifiedAt: TimeStamp? with {
        briefly "Verified"
        described as {
          |Verification time.
        }
      }
      labeledAt: TimeStamp? with {
        briefly "Labeled"
        described as {
          |Labeling time.
        }
      }
      pickedUpAt: TimeStamp? with {
        briefly "Picked up"
        described as {
          |Pickup time.
        }
      }
    } with {
      briefly "Fill time data"
      described as {
        |Timestamps for fill time analysis.
      }
    }
    record CounselingData is  {
      fillId: FillId with {
        briefly "Fill"
        described as {
          |Fill ID.
        }
      }
      counselingProvided: Boolean with {
        briefly "Provided"
        described as {
          |Counseling provided.
        }
      }
      counselingDeclined: Boolean with {
        briefly "Declined"
        described as {
          |Counseling declined.
        }
      }
      pharmacistId: PharmacistId? with {
        briefly "Pharmacist"
        described as {
          |Pharmacist ID.
        }
      }
      counselingDate: TimeStamp? with {
        briefly "Date"
        described as {
          |Counseling date.
        }
      }
    } with {
      briefly "Counseling data"
      described as {
        |Counseling tracking data.
      }
    }
    record ReturnData is  {
      fillId: FillId with {
        briefly "Fill"
        described as {
          |Fill ID.
        }
      }
      returnedAt: TimeStamp with {
        briefly "Returned"
        described as {
          |Return time.
        }
      }
      returnReason: String with {
        briefly "Reason"
        described as {
          |Return reason.
        }
      }
      daysUntilReturn: Integer with {
        briefly "Days"
        described as {
          |Days until return.
        }
      }
    } with {
      briefly "Return data"
      described as {
        |Return tracking data.
      }
    }
    handler MetricsHandler is {
      on event FillInitiated is {
        tell event FillInitiated to repository DispensingContext.FillRepository
      }
      on event DrugSelected is {
        tell event DrugSelected to repository DispensingContext.FillRepository
      }
      on event PrescriptionFilled is {
        tell event PrescriptionFilled to repository DispensingContext.FillRepository
      }
      on event FillVerified is {
        tell event FillVerified to repository DispensingContext.FillRepository
      }
      on event LabelPrinted is {
        tell event LabelPrinted to repository DispensingContext.FillRepository
      }
      on event PatientCounseled is {
        tell event PatientCounseled to repository DispensingContext.FillRepository
      }
      on event PickupCompleted is {
        tell event PickupCompleted to repository DispensingContext.FillRepository
      }
      on event ReturnedToStock is {
        tell event ReturnedToStock to repository DispensingContext.FillRepository
      }
      on other is {
        do "Ignore other events"
      }
    } with {
      briefly "Metrics handler"
      described as {
        |Handler for metrics collection events.
      }
    }
  } with {
    briefly "Dispensing metrics"
    described as {
      |Projector for dispensing analytics.
    }
  }
  // ---- Event publication for Fill ----
  type FillEvent is one of {
    DispensingContext.Fill.FillInitiated,
    DispensingContext.Fill.DrugSelected,
    DispensingContext.Fill.PrescriptionFilled,
    DispensingContext.Fill.FillVerified,
    DispensingContext.Fill.LabelPrinted,
    DispensingContext.Fill.PatientCounseled,
    DispensingContext.Fill.PickupCompleted,
    DispensingContext.Fill.ReturnedToStock
  } with {
    briefly "Fill event alternation"
    described as {
      |Union of all Fill events, for streaming and event-sourced
      |persistence.
    }
  }
  processor FillEventSource as source is {
    outlet FillEvents is type FillEvent
    handler FillSourceHandler is {
      on event Fill.FillInitiated is {
        send event Fill.FillInitiated to outlet FillEvents
      }
      on event Fill.DrugSelected is {
        send event Fill.DrugSelected to outlet FillEvents
      }
      on event Fill.PrescriptionFilled is {
        send event Fill.PrescriptionFilled to outlet FillEvents
      }
      on event Fill.FillVerified is {
        send event Fill.FillVerified to outlet FillEvents
      }
      on event Fill.LabelPrinted is {
        send event Fill.LabelPrinted to outlet FillEvents
      }
      on event Fill.PatientCounseled is {
        send event Fill.PatientCounseled to outlet FillEvents
      }
      on event Fill.PickupCompleted is {
        send event Fill.PickupCompleted to outlet FillEvents
      }
      on event Fill.ReturnedToStock is {
        send event Fill.ReturnedToStock to outlet FillEvents
      }
      on other is {
        error "Unexpected message for source FillEventSource"
      }
    } with {
      briefly "Fill source handler"
      described as {
        |Publishes Fill events onto the outlet.
      }
    }
  } with {
    briefly "Fill event source"
    described as {
      |Publishes Fill entity events into the streaming topology.
    }
  }
  processor FillEventSink as sink is {
    inlet FillInlet is type FillEvent
    handler FillSinkHandler is {
      on event Fill.FillInitiated is {
        tell event Fill.FillInitiated to repository DispensingContext.FillRepository
      }
      on event Fill.DrugSelected is {
        tell event Fill.DrugSelected to repository DispensingContext.FillRepository
      }
      on event Fill.PrescriptionFilled is {
        tell event Fill.PrescriptionFilled to repository DispensingContext.FillRepository
      }
      on event Fill.FillVerified is {
        tell event Fill.FillVerified to repository DispensingContext.FillRepository
      }
      on event Fill.LabelPrinted is {
        tell event Fill.LabelPrinted to repository DispensingContext.FillRepository
      }
      on event Fill.PatientCounseled is {
        tell event Fill.PatientCounseled to repository DispensingContext.FillRepository
      }
      on event Fill.PickupCompleted is {
        tell event Fill.PickupCompleted to repository DispensingContext.FillRepository
      }
      on event Fill.ReturnedToStock is {
        tell event Fill.ReturnedToStock to repository DispensingContext.FillRepository
      }
      on other is {
        error "Unexpected message for sink FillEventSink"
      }
    } with {
      briefly "Fill sink handler"
      described as {
        |Persists Fill events via the repository.
      }
    }
  } with {
    briefly "Fill event sink"
    described as {
      |Receives Fill events for persistence.
    }
  }
  connector FillEventFlow is {
    from outlet DispensingContext.FillEventSource.FillEvents to
      inlet DispensingContext.FillEventSink.FillInlet
  } with {
    briefly "Fill event flow"
    described as {
      |Connects the Fill source to its sink.
    }
  }
  processor FillEventSplit is {
    inlet FillEventSplitIn is type FillEvent
    outlet FillEventSplitToFillRepository is type FillEvent
    outlet FillEventSplitToDispensingMetrics is type FillEvent
    handler FillEventSplitHandler is {
      on event Fill.FillInitiated is {
        send event Fill.FillInitiated to outlet FillEventSplitToFillRepository
        send event Fill.FillInitiated to outlet FillEventSplitToDispensingMetrics
        tell event Fill.FillInitiated to entity DispensingContext.Fill
      }
      on event Fill.DrugSelected is {
        send event Fill.DrugSelected to outlet FillEventSplitToFillRepository
        send event Fill.DrugSelected to outlet FillEventSplitToDispensingMetrics
        tell event Fill.DrugSelected to entity DispensingContext.Fill
      }
      on event Fill.PrescriptionFilled is {
        send event Fill.PrescriptionFilled to outlet FillEventSplitToFillRepository
        send event Fill.PrescriptionFilled to outlet FillEventSplitToDispensingMetrics
        tell event Fill.PrescriptionFilled to entity DispensingContext.Fill
      }
      on event Fill.FillVerified is {
        send event Fill.FillVerified to outlet FillEventSplitToFillRepository
        send event Fill.FillVerified to outlet FillEventSplitToDispensingMetrics
        tell event Fill.FillVerified to entity DispensingContext.Fill
      }
      on event Fill.LabelPrinted is {
        send event Fill.LabelPrinted to outlet FillEventSplitToFillRepository
        send event Fill.LabelPrinted to outlet FillEventSplitToDispensingMetrics
        tell event Fill.LabelPrinted to entity DispensingContext.Fill
      }
      on event Fill.PatientCounseled is {
        send event Fill.PatientCounseled to outlet FillEventSplitToFillRepository
        send event Fill.PatientCounseled to outlet FillEventSplitToDispensingMetrics
        tell event Fill.PatientCounseled to entity DispensingContext.Fill
      }
      on event Fill.PickupCompleted is {
        send event Fill.PickupCompleted to outlet FillEventSplitToFillRepository
        send event Fill.PickupCompleted to outlet FillEventSplitToDispensingMetrics
        tell event Fill.PickupCompleted to entity DispensingContext.Fill
      }
      on event Fill.ReturnedToStock is {
        send event Fill.ReturnedToStock to outlet FillEventSplitToFillRepository
        send event Fill.ReturnedToStock to outlet FillEventSplitToDispensingMetrics
        tell event Fill.ReturnedToStock to entity DispensingContext.Fill
      }
      on other is {
        error "Unexpected message for processor FillEventSplit"
      }
    } with {
      briefly "Fill event fan-out handler"
      described as {
        |Delivers each Fill event to all of its consumers.
      }
    }
  } with {
    briefly "Fill event fan-out"
    described as {
      |Fans Fill events out to the repository and projectors.
    }
  }
  connector LinkFillToFillEventSplit is {
    from outlet DispensingContext.Fill.FillEvents2 to
      inlet DispensingContext.FillEventSplit.FillEventSplitIn
  } with {
    briefly "LinkFillToFillEventSplit"
  }
  connector LinkFillEventSplitToFillRepository is {
    from outlet DispensingContext.FillEventSplit.FillEventSplitToFillRepository to
      inlet DispensingContext.FillRepository.FillRepositoryFromFill
  } with {
    briefly "LinkFillEventSplitToFillRepository"
  }
  connector LinkFillEventSplitToDispensingMetrics is {
    from outlet DispensingContext.FillEventSplit.FillEventSplitToDispensingMetrics to
      inlet DispensingContext.DispensingMetrics.DispensingMetricsFromFill
  } with {
    briefly "LinkFillEventSplitToDispensingMetrics"
  }
  connector LinkDispensingMetricsToFillRepository is {
    from outlet DispensingContext.DispensingMetrics.DispensingMetricsOut to
      inlet DispensingContext.FillRepository.FillRepositoryFromDispensingMetrics
  } with {
    briefly "LinkDispensingMetricsToFillRepository"
  }
} with {
  briefly "Dispensing context"
  described as {
    | The DispensingContext encompasses all operations related to filling
    | prescriptions and dispensing medications to patients.
  }
}
