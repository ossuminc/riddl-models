// Dispensing Context - Bounded context for medication dispensing operations
context DispensingContext as router is {
  command InitiateFill is {
    prescriptionId: PrescriptionId with {
      briefly "Prescription"
      described as {
        |Prescription ID.
      }
    }
    patientId: PatientId with {
      briefly "Patient"
      described as {
        |Patient identifier.
      }
    }
    requestedDrug: String with {
      briefly "Drug"
      described as {
        |Requested drug name.
      }
    }
    requestedQuantity: Integer with {
      briefly "Quantity"
      described as {
        |Requested quantity.
      }
    }
    requestedDaysSupply: Integer with {
      briefly "Days"
      described as {
        |Requested days supply.
      }
    }
    initiatedBy: TechnicianId with {
      briefly "Initiated by"
      described as {
        |Initiating technician.
      }
    }
  } with {
    briefly "Initiate fill"
    described as {
      |Start a new prescription fill.
    }
  }
  type FillRequest is one of {
    DispensingContext.InitiateFill or Fill.FillCommand
  } with {
    briefly "Fill requests"
    described as {
      |What may be asked of DispensingContext about a Fill: InitiateFill, which the
      |context does itself by creating one, or any command for an existing one.
    }
  }
  inlet FillRepositoryQueriesIn is type FillRepository.FillRepositoryQuery with {
    briefly "Look-ups of the fill repository"
    described as {
      |MedicationDispensingApp's look-ups, on their way to the fill repository.
    }
  }
  outlet FillRepositoryQueriesOut is type FillRepository.FillRepositoryQuery
 with {
    briefly "Look-ups on their way to the fill repository"
    described as {
      |Each look-up goes to the fill repository it names.
    }
  }
  inlet FillRepositoryRepliesIn is type FillRepository.FillRepositoryReply with {
    briefly "The fill repository's answers"
    described as {
      |What the fill repository answers about itself.
    }
  }
  outlet FillRepositoryRepliesOut is type FillRepository.FillRepositoryReply
 with {
    briefly "Answers to MedicationDispensingApp"
    described as {
      |The reply leg of MedicationDispensingApp's look-ups of the fill repository.
    }
  }
  inlet FillQueriesIn is query Fill.GetFill with {
    briefly "Look-ups of the fill"
    described as {
      |MedicationDispensingApp's look-ups, on their way to the fill.
    }
  }
  outlet FillQueriesOut is query Fill.GetFill
 with {
    briefly "Look-ups on their way to the fill"
    described as {
      |Each look-up goes to the fill it names.
    }
  }
  inlet FillRepliesIn is result Fill.FillResult with {
    briefly "The fill's answers"
    described as {
      |What the fill answers about itself.
    }
  }
  inlet DispensingContextFromDrugDatabase is command Fill.CounselPatient with {
    briefly "What FromDrugDatabase makes of that service's news"
  }
  connector 'FillRepositoryQuery Intake' is from outlet DispensingContext.FillRepositoryQueriesOut to inlet DispensingContext.FillRepository.FillRepositoryQueries with {
    briefly "Look-ups on their way to the fill repository"
  }
  connector 'FillRepositoryReply Egress' is from outlet DispensingContext.FillRepository.FillRepositoryReplies to inlet DispensingContext.FillRepositoryRepliesIn with {
    briefly "The fill repository's answers on their way to the boundary"
  }
  connector 'FillQuery Intake' is from outlet DispensingContext.FillQueriesOut to inlet DispensingContext.Fill.FillQueriesPort with {
    briefly "Look-ups on their way to the fill"
  }
  connector 'FillReply Egress' is from outlet DispensingContext.Fill.FillReplies to inlet DispensingContext.FillRepliesIn with {
    briefly "The fill's answers on their way to the boundary"
  }
  connector 'FromDrugDatabase Intake' is from outlet DispensingContext.FromDrugDatabase.FromDrugDatabaseToDispensingContext to inlet DispensingContext.DispensingContextFromDrugDatabase with {
    briefly "What FromDrugDatabase makes of that news, on its way in"
  }
  inlet DispensingContextFromInventoryService is command Fill.ReturnToStock with {
    briefly "What FromInventoryService makes of that service's news"
  }
  connector 'FromInventoryService Intake' is from outlet DispensingContext.FromInventoryService.FromInventoryServiceToDispensingContext to inlet DispensingContext.DispensingContextFromInventoryService with {
    briefly "What FromInventoryService makes of that news, on its way in"
  }
  inlet DispensingContextFromPOSBilling is command Fill.CompletePickup with {
    briefly "What FromPOSBilling makes of that service's news"
  }
  connector 'FromPOSBilling Intake' is from outlet DispensingContext.FromPOSBilling.FromPOSBillingToDispensingContext to inlet DispensingContext.DispensingContextFromPOSBilling with {
    briefly "What FromPOSBilling makes of that news, on its way in"
  }
  inlet DispensingContextFromPrescriptionService is command DispensingContext.InitiateFill with {
    briefly "What FromPrescriptionService makes of that service's news"
  }
  connector 'FromPrescriptionService Intake' is from outlet DispensingContext.FromPrescriptionService.FromPrescriptionServiceToDispensingContext to inlet DispensingContext.DispensingContextFromPrescriptionService with {
    briefly "What FromPrescriptionService makes of that news, on its way in"
  }
  inlet FillCommandStreamIn is type DispensingContext.FillRequest
  outlet FillCommandStreamOut is type FillCommand
  inlet FillResultStreamIn is result Fill.FillResult
  outlet FillResultStreamOut is result Fill.FillResult
  handler DispensingContextBoundary is {
    on getFillTimeData: query GetFillTimeData is {
      forward getFillTimeData to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getCounselingData: query GetCounselingData is {
      forward getCounselingData to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getReturnData: query GetReturnData is {
      forward getReturnData to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getFillTimeMetrics: query GetFillTimeMetrics is {
      forward getFillTimeMetrics to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getCounselingComplianceMetrics: query GetCounselingComplianceMetrics is {
      forward getCounselingComplianceMetrics to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getReturnRateMetrics: query GetReturnRateMetrics is {
      forward getReturnRateMetrics to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getFillById: query GetFillById is {
      forward getFillById to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getFillsByPatient: query GetFillsByPatient is {
      forward getFillsByPatient to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getFillsByStatus: query GetFillsByStatus is {
      forward getFillsByStatus to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getPendingFills: query GetPendingFills is {
      forward getPendingFills to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getReadyForPickup: query GetReadyForPickup is {
      forward getReadyForPickup to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getCounselingByFill: query GetCounselingByFill is {
      forward getCounselingByFill to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getCounselingByPharmacist: query GetCounselingByPharmacist is {
      forward getCounselingByPharmacist to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getDeclinedCounseling: query GetDeclinedCounseling is {
      forward getDeclinedCounseling to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getPickupsByDate: query GetPickupsByDate is {
      forward getPickupsByDate to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on getOverduePickups: query GetOverduePickups is {
      forward getOverduePickups to outlet DispensingContext.FillRepositoryQueriesOut
    }
    on counselingComplianceMetricsView: result CounselingComplianceMetricsView is {
      send counselingComplianceMetricsView to outlet DispensingContext.FillRepositoryRepliesOut
    }
    on counselingDataView: result CounselingDataView is {
      send counselingDataView to outlet DispensingContext.FillRepositoryRepliesOut
    }
    on fillTimeDataView: result FillTimeDataView is {
      send fillTimeDataView to outlet DispensingContext.FillRepositoryRepliesOut
    }
    on fillTimeMetricsView: result FillTimeMetricsView is {
      send fillTimeMetricsView to outlet DispensingContext.FillRepositoryRepliesOut
    }
    on returnDataView: result ReturnDataView is {
      send returnDataView to outlet DispensingContext.FillRepositoryRepliesOut
    }
    on returnRateMetricsView: result ReturnRateMetricsView is {
      send returnRateMetricsView to outlet DispensingContext.FillRepositoryRepliesOut
    }
    on getFill: query Fill.GetFill is {
      forward getFill to outlet DispensingContext.FillQueriesOut
    }
    on initiateFill: command DispensingContext.InitiateFill is {
      let newFill = create entity DispensingContext.Fill(prescriptionId = initiateFill.prescriptionId, patientId = initiateFill.patientId, requestedDrug = initiateFill.requestedDrug, requestedQuantity = initiateFill.requestedQuantity, requestedDaysSupply = initiateFill.requestedDaysSupply, initiatedBy = initiateFill.initiatedBy)
      log newFill
    }
    on selectDrug: command Fill.SelectDrug is {
      send selectDrug to outlet DispensingContext.FillCommandStreamOut
    }
    on fillPrescription: command Fill.FillPrescription is {
      send fillPrescription to outlet DispensingContext.FillCommandStreamOut
    }
    on verifyFill: command Fill.VerifyFill is {
      send verifyFill to outlet DispensingContext.FillCommandStreamOut
    }
    on printLabel: command Fill.PrintLabel is {
      send printLabel to outlet DispensingContext.FillCommandStreamOut
    }
    on counselPatient: command Fill.CounselPatient is {
      send counselPatient to outlet DispensingContext.FillCommandStreamOut
    }
    on completePickup: command Fill.CompletePickup is {
      send completePickup to outlet DispensingContext.FillCommandStreamOut
    }
    on returnToStock: command Fill.ReturnToStock is {
      send returnToStock to outlet DispensingContext.FillCommandStreamOut
    }
    on fillResult: result Fill.FillResult is {
      send fillResult to outlet DispensingContext.FillResultStreamOut
    }
    on other is {
      error "Unexpected message at the DispensingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'FillCommand Stream Intake' is from outlet DispensingContext.FillCommandStreamOut to inlet DispensingContext.Fill.FillCommands
  connector 'FillResult Stream Egress' is from outlet DispensingContext.FillRepository.FillRepositoryResponses to inlet DispensingContext.FillResultStreamIn
  adaptor FromDrugDatabase from context DrugDatabase as flow is { 
    inlet FromDrugDatabaseIn is type DrugDatabase.DrugDatabaseEvent
    outlet FromDrugDatabaseToDispensingContext is command Fill.CounselPatient
    handler FromDrugDatabaseHandler is {
      on drugImageRequested: event DrugDatabase.DrugImageRequested is {
        do "an image request is the pharmacist checking the right drug; the fill is unchanged"
      }
      on drugInteractionDetected: event DrugDatabase.DrugInteractionDetected is {
        let item0: type Fill.CounselPatient = prompt("translate the drugInteractionDetected event into a CounselPatient, an interaction found is something the patient must be counselled about")
        send item0 to outlet DispensingContext.FromDrugDatabase.FromDrugDatabaseToDispensingContext
      }
      on other is {
        error "Unexpected message for adaptor FromDrugDatabase"
      }
    } with {
      briefly "from drug database"
      described as {
        |Carries messages from the external DrugDatabase.
      }
    }
  } with {
    briefly "DrugDatabase integration"
    described as {
      |The model's side of the DrugDatabase conversation.
    }
  }
  adaptor FromInventoryService from context InventoryService as flow is { 
    inlet FromInventoryServiceIn is type InventoryService.InventoryServiceEvent
    outlet FromInventoryServiceToDispensingContext is command Fill.ReturnToStock
    handler FromInventoryServiceHandler is {
      on expirationAlert: event InventoryService.ExpirationAlert is {
        do "expiring stock is removed by the pharmacy; a fill in progress selects a different lot"
      }
      on lowStockAlert: event InventoryService.LowStockAlert is {
        do "low stock is the pharmacy's problem to order against; this fill is unaffected"
      }
      on stockDispensed: event InventoryService.StockDispensed is {
        do "the dispense is recorded; filling the prescription was the act"
      }
      on stockReserved: event InventoryService.StockReserved is {
        do "stock is held for the fill; selecting the drug was recorded here"
      }
      on stockReturned: event InventoryService.StockReturned is {
        let item0: type Fill.ReturnToStock = prompt("translate the stockReturned event into a ReturnToStock, stock going back is what a return to stock records")
        send item0 to outlet DispensingContext.FromInventoryService.FromInventoryServiceToDispensingContext
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromPOSBilling from context POSBilling as flow is { 
    inlet FromPOSBillingIn is type POSBilling.POSBillingEvent
    outlet FromPOSBillingToDispensingContext is command Fill.CompletePickup
    handler FromPOSBillingHandler is {
      on copayCollectedEvent: event POSBilling.CopayCollected is {
        let item0: type Fill.CompletePickup = prompt("translate the copayCollectedEvent event into a CompletePickup, the copay taken at the counter is the last act of a pickup")
        send item0 to outlet DispensingContext.FromPOSBilling.FromPOSBillingToDispensingContext
      }
      on copayWaived: event POSBilling.CopayWaived is {
        do "a waived copay still lets the pickup complete; the waiver is the payer's business"
      }
      on paymentFailed: event POSBilling.PaymentFailed is {
        do "an unpaid copay holds the pickup; the pharmacist decides what happens next"
      }
      on other is {
        error "Unexpected message for adaptor FromPOSBilling"
      }
    } with {
      briefly "from pos billing"
      described as {
        |Carries messages from the external POSBilling.
      }
    }
  } with {
    briefly "POSBilling integration"
    described as {
      |The model's side of the POSBilling conversation.
    }
  }
  adaptor FromPatientService from context PatientService as sink is { 
    inlet FromPatientServiceIn is event PatientService.PatientArrived
    handler FromPatientServiceHandler is {
      on patientArrived: event PatientService.PatientArrived is {
        do "the patient is at the counter; the pickup completes when they are counselled and pay"
      }
      on other is {
        error "Unexpected message for adaptor FromPatientService"
      }
    } with {
      briefly "from patient service"
      described as {
        |Carries messages from the external PatientService.
      }
    }
  } with {
    briefly "PatientService integration"
    described as {
      |The model's side of the PatientService conversation.
    }
  }
  adaptor FromPrescriptionService from context PrescriptionService as flow is { 
    inlet FromPrescriptionServiceIn is event PrescriptionService.PrescriptionReadyToFill
    outlet FromPrescriptionServiceToDispensingContext is command DispensingContext.InitiateFill
    handler FromPrescriptionServiceHandler is {
      on prescriptionReadyToFill: event PrescriptionService.PrescriptionReadyToFill is {
        let item0: type DispensingContext.InitiateFill = prompt("translate the prescriptionReadyToFill event into a InitiateFill, a prescription ready is what a fill is started from")
        send item0 to outlet DispensingContext.FromPrescriptionService.FromPrescriptionServiceToDispensingContext
      }
      on other is {
        error "Unexpected message for adaptor FromPrescriptionService"
      }
    } with {
      briefly "from prescription service"
      described as {
        |Carries messages from the external PrescriptionService.
      }
    }
  } with {
    briefly "PrescriptionService integration"
    described as {
      |The model's side of the PrescriptionService conversation.
    }
  }
  include "types.riddl"
  include "Fill.riddl"
  // === Repository ===
  type FillRepositoryCommand is one of {
    DispensingContext.FillRepository.PersistDrugSelected or DispensingContext.FillRepository.PersistFillInitiated or DispensingContext.FillRepository.PersistFillVerified or DispensingContext.FillRepository.PersistLabelPrinted or DispensingContext.FillRepository.PersistPatientCounseled or DispensingContext.FillRepository.PersistPickupCompleted or DispensingContext.FillRepository.PersistPrescriptionFilled or DispensingContext.FillRepository.PersistReturnedToStock
  } with {
    briefly "Anything that writes FillRepository"
    described as {
      |The persistence commands FillRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository FillRepository as router is {
    type FillRepositoryQuery is one of {
      GetFillTimeData or GetCounselingData or GetReturnData or GetFillTimeMetrics or GetCounselingComplianceMetrics or GetReturnRateMetrics or GetFillById or GetFillsByPatient or GetFillsByStatus or GetPendingFills or GetReadyForPickup or GetCounselingByFill or GetCounselingByPharmacist or GetDeclinedCounseling or GetPickupsByDate or GetOverduePickups
    } with {
      briefly "What may be asked of FillRepository"
      described as {
        |The look-ups the fill repository answers.
      }
    }
    type FillRepositoryReply is one of {
      CounselingComplianceMetricsView or CounselingDataView or Fill.FillResult or FillTimeDataView or FillTimeMetricsView or ReturnDataView or ReturnRateMetricsView
    } with {
      briefly "What FillRepository answers"
      described as {
        |The answers the fill repository gives.
      }
    }
    inlet FillRepositoryQueries is type FillRepositoryQuery with {
      briefly "Look-ups of this fill repository"
      described as {
        |What MedicationDispensingApp asks of the fill repository, by way of DispensingContext.
      }
    }
    outlet FillRepositoryReplies is type FillRepositoryReply
 with {
      briefly "This fill repository's answers"
      described as {
        |What the fill repository answers, on its way back to DispensingContext.
      }
    }
    inlet FillRepositoryFromDispensingMetrics is type FillRepositoryCommand
    command PersistDrugSelected is {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row DrugSelected applies to.
        }
      }
      selection: DrugSelection? with {
        briefly "Selection"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DrugSelected"
      described as {
        |Instructs this repository to apply DrugSelected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFillInitiated is {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row FillInitiated applies to.
        }
      }
      prescriptionId: PrescriptionId? with {
        briefly "Prescription id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      patientId: PatientId? with {
        briefly "Patient id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      requestedDrug: String? with {
        briefly "Requested drug"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      requestedQuantity: Integer? with {
        briefly "Requested quantity"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      initiatedAt: TimeStamp? with {
        briefly "Initiated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      initiatedBy: TechnicianId? with {
        briefly "Initiated by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist FillInitiated"
      described as {
        |Instructs this repository to apply FillInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFillVerified is {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row FillVerified applies to.
        }
      }
      verifiedBy: PharmacistId? with {
        briefly "Verified by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      verifiedAt: TimeStamp? with {
        briefly "Verified at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      verificationNotes: String? with {
        briefly "Verification notes"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist FillVerified"
      described as {
        |Instructs this repository to apply FillVerified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLabelPrinted is {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row LabelPrinted applies to.
        }
      }
      labelInfo: LabelInfo? with {
        briefly "Label info"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist LabelPrinted"
      described as {
        |Instructs this repository to apply LabelPrinted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPatientCounseled is {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row PatientCounseled applies to.
        }
      }
      counseling: CounselingRecord? with {
        briefly "Counseling"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PatientCounseled"
      described as {
        |Instructs this repository to apply PatientCounseled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPickupCompleted is {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row PickupCompleted applies to.
        }
      }
      pickup: PickupRecord? with {
        briefly "Pickup"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PickupCompleted"
      described as {
        |Instructs this repository to apply PickupCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPrescriptionFilled is {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row PrescriptionFilled applies to.
        }
      }
      quantityDispensed: Integer? with {
        briefly "Quantity dispensed"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      filledBy: TechnicianId? with {
        briefly "Filled by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      filledAt: TimeStamp? with {
        briefly "Filled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PrescriptionFilled"
      described as {
        |Instructs this repository to apply PrescriptionFilled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnedToStock is {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnedToStock applies to.
        }
      }
      returnRecord: ReturnRecord? with {
        briefly "Return record"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReturnedToStock"
      described as {
        |Instructs this repository to apply ReturnedToStock to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredFill is {
      fillId: FillId with {
        briefly "fillId"
        described as {
          |The fillId column of the stored fill row.
        }
      }
      selection: DrugSelection? with {
        briefly "Selection"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      prescriptionId: PrescriptionId? with {
        briefly "Prescription id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      patientId: PatientId? with {
        briefly "Patient id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      requestedDrug: String? with {
        briefly "Requested drug"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      requestedQuantity: Integer? with {
        briefly "Requested quantity"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      initiatedAt: TimeStamp? with {
        briefly "Initiated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      initiatedBy: TechnicianId? with {
        briefly "Initiated by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      verifiedBy: PharmacistId? with {
        briefly "Verified by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      verifiedAt: TimeStamp? with {
        briefly "Verified at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      verificationNotes: String? with {
        briefly "Verification notes"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      labelInfo: LabelInfo? with {
        briefly "Label info"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      counseling: CounselingRecord? with {
        briefly "Counseling"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      pickup: PickupRecord? with {
        briefly "Pickup"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      quantityDispensed: Integer? with {
        briefly "Quantity dispensed"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      filledBy: TechnicianId? with {
        briefly "Filled by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      filledAt: TimeStamp? with {
        briefly "Filled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      returnRecord: ReturnRecord? with {
        briefly "Return record"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored fill row"
      described as {
        |The persistence shape of fill data as this repository stores it.
      }
    }
    schema FillData is relational
      of fills as record StoredFill
        key on field StoredFill.fillId
 with {
      briefly "Fill data schema"
      described as {
        |The relational schema persisting fill records for this repository.
      }
    }
    outlet FillRepositoryResponses is result Fill.FillResult
    handler FillQueries is {
      on persistDrugSelected: command PersistDrugSelected is {
        update FillData.fills set selection = persistDrugSelected.selection where fillId == persistDrugSelected.fillId
      }
      on persistFillInitiated: command PersistFillInitiated is {
        update FillData.fills set prescriptionId = persistFillInitiated.prescriptionId, patientId = persistFillInitiated.patientId, requestedDrug = persistFillInitiated.requestedDrug, requestedQuantity = persistFillInitiated.requestedQuantity, initiatedAt = persistFillInitiated.initiatedAt, initiatedBy = persistFillInitiated.initiatedBy where fillId == persistFillInitiated.fillId
      }
      on persistFillVerified: command PersistFillVerified is {
        update FillData.fills set verifiedBy = persistFillVerified.verifiedBy, verifiedAt = persistFillVerified.verifiedAt, verificationNotes = persistFillVerified.verificationNotes where fillId == persistFillVerified.fillId
      }
      on persistLabelPrinted: command PersistLabelPrinted is {
        update FillData.fills set labelInfo = persistLabelPrinted.labelInfo where fillId == persistLabelPrinted.fillId
      }
      on persistPatientCounseled: command PersistPatientCounseled is {
        update FillData.fills set counseling = persistPatientCounseled.counseling where fillId == persistPatientCounseled.fillId
      }
      on persistPickupCompleted: command PersistPickupCompleted is {
        update FillData.fills set pickup = persistPickupCompleted.pickup where fillId == persistPickupCompleted.fillId
      }
      on persistPrescriptionFilled: command PersistPrescriptionFilled is {
        update FillData.fills set quantityDispensed = persistPrescriptionFilled.quantityDispensed, filledBy = persistPrescriptionFilled.filledBy, filledAt = persistPrescriptionFilled.filledAt where fillId == persistPrescriptionFilled.fillId
      }
      on persistReturnedToStock: command PersistReturnedToStock is {
        update FillData.fills set returnRecord = persistReturnedToStock.returnRecord where fillId == persistReturnedToStock.fillId
      }
      on query GetFillTimeData is {
        let fillTimeDataView: type FillTimeDataView = prompt("read the fill time data projection")
        reply fillTimeDataView
      }
      on query GetCounselingData is {
        let counselingDataView: type CounselingDataView = prompt("read the counseling data projection")
        reply counselingDataView
      }
      on query GetReturnData is {
        let returnDataView: type ReturnDataView = prompt("read the return data projection")
        reply returnDataView
      }
      on query GetFillTimeMetrics is {
        let fillTimeMetricsView: type FillTimeMetricsView = prompt("aggregate fill time metrics over the requested period")
        reply fillTimeMetricsView
      }
      on query GetCounselingComplianceMetrics is {
        let counselingComplianceMetricsView: type CounselingComplianceMetricsView = prompt("aggregate counseling compliance metrics over the requested period")
        reply counselingComplianceMetricsView
      }
      on query GetReturnRateMetrics is {
        let returnRateMetricsView: type ReturnRateMetricsView = prompt("aggregate return rate metrics over the requested period")
        reply returnRateMetricsView
      }
      on query GetFillById is {
        let fillResult: type FillResult = prompt("read the fill from the store")
        reply fillResult
      }
      on query GetFillsByPatient is {
        let fillResult: type FillResult = prompt("read the fill from the store")
        reply fillResult
      }
      on query GetFillsByStatus is {
        let fillResult: type FillResult = prompt("read the fill from the store")
        reply fillResult
      }
      on query GetPendingFills is {
        let fillResult: type FillResult = prompt("read the fill from the store")
        reply fillResult
      }
      on query GetReadyForPickup is {
        let fillResult: type FillResult = prompt("read the fill that ready for pickup asks for")
        reply fillResult
      }
    } with {
      briefly "Fill queries"
      described as {
        |Query handler for fill records.
      }
    }
    handler CounselingQueries is {
      on query GetCounselingByFill is {
        let fillResult: type FillResult = prompt("read the fill from the store")
        reply fillResult
      }
      on query GetCounselingByPharmacist is {
        let fillResult: type FillResult = prompt("read the fill that counseling by pharmacist asks for")
        reply fillResult
      }
      on query GetDeclinedCounseling is {
        let fillResult: type FillResult = prompt("read the fill that declined counseling asks for")
        reply fillResult
      }
    } with {
      briefly "Counseling queries"
      described as {
        |Query handler for counseling records.
      }
    }
    handler PickupQueries is {
      on query GetPickupsByDate is {
        let fillResult: type FillResult = prompt("read the fill that pickups by date asks for")
        reply fillResult
      }
      on query GetOverduePickups is {
        let fillResult: type FillResult = prompt("read the fill that overdue pickups asks for")
        reply fillResult
      }
    } with {
      briefly "Pickup queries"
      described as {
        |Query handler for pickup records.
      }
    }
  } with {
    briefly "Fill repository"
    described as {
      |Repository for fill, counseling, and pickup records.
    }
  }
  // === Projector ===
  query GetFillTimeData replies result FillTimeDataView is {
    fillTimeDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which fill time data to retrieve.
      }
    }
  } with {
    briefly "Get fill time data"
    described as {
      |Retrieves the fill time data projection.
    }
  }
  result FillTimeDataView is {
    fillTimeData: DispensingMetrics.FillTimeData with {
      briefly "Fill time data"
      described as {
        |The fill time data being returned.
      }
    }
  } with {
    briefly "Fill time data view"
    described as {
      |Read model view carrying the fill time data projection.
    }
  }
  query GetCounselingData replies result CounselingDataView is {
    counselingDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which counseling data to retrieve.
      }
    }
  } with {
    briefly "Get counseling data"
    described as {
      |Retrieves the counseling data projection.
    }
  }
  result CounselingDataView is {
    counselingData: DispensingMetrics.CounselingData with {
      briefly "Counseling data"
      described as {
        |The counseling data being returned.
      }
    }
  } with {
    briefly "Counseling data view"
    described as {
      |Read model view carrying the counseling data projection.
    }
  }
  query GetReturnData replies result ReturnDataView is {
    returnDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which return data to retrieve.
      }
    }
  } with {
    briefly "Get return data"
    described as {
      |Retrieves the return data projection.
    }
  }
  result ReturnDataView is {
    returnData: DispensingMetrics.ReturnData with {
      briefly "Return data"
      described as {
        |The return data being returned.
      }
    }
  } with {
    briefly "Return data view"
    described as {
      |Read model view carrying the return data projection.
    }
  }
  result FillTimeMetricsView is {
    fillTimeMetrics: FillTimeMetrics with {
      briefly "Fill time metrics"
      described as {
        |The aggregated fill time metrics being returned.
      }
    }
  } with {
    briefly "Fill time metrics view"
    described as {
      |Read model view carrying fill time metrics aggregated over a period.
    }
  }
  result CounselingComplianceMetricsView is {
    counselingComplianceMetrics: CounselingComplianceMetrics with {
      briefly "Counseling compliance metrics"
      described as {
        |The aggregated counseling compliance metrics being returned.
      }
    }
  } with {
    briefly "Counseling compliance metrics view"
    described as {
      |Read model view carrying counseling compliance metrics aggregated over
      |a period.
    }
  }
  result ReturnRateMetricsView is {
    returnRateMetrics: ReturnRateMetrics with {
      briefly "Return rate metrics"
      described as {
        |The aggregated return rate metrics being returned.
      }
    }
  } with {
    briefly "Return rate metrics view"
    described as {
      |Read model view carrying return rate metrics aggregated over a period.
    }
  }
  projector DispensingMetrics as flow is {
    updates repository DispensingContext.FillRepository
    outlet DispensingMetricsToRepository is type FillRepositoryCommand
    inlet DispensingMetricsFromFill is type FillEvent
    record FillTimeData is {
      fillId: FillId with {
        briefly "Fill"
        described as {
          |Fill ID.
        }
      }
      initiatedAt: TimeStamp with {
        briefly "Initiated"
        described as {
          |Initiation time.
        }
      }
      selectedAt: TimeStamp? with {
        briefly "Selected"
        described as {
          |Selection time.
        }
      }
      filledAt: TimeStamp? with {
        briefly "Filled"
        described as {
          |Fill time.
        }
      }
      verifiedAt: TimeStamp? with {
        briefly "Verified"
        described as {
          |Verification time.
        }
      }
      labeledAt: TimeStamp? with {
        briefly "Labeled"
        described as {
          |Labeling time.
        }
      }
      pickedUpAt: TimeStamp? with {
        briefly "Picked up"
        described as {
          |Pickup time.
        }
      }
    } with {
      briefly "Fill time data"
      described as {
        |Timestamps for fill time analysis.
      }
    }
    record CounselingData is {
      fillId: FillId with {
        briefly "Fill"
        described as {
          |Fill ID.
        }
      }
      counselingProvided: Boolean with {
        briefly "Provided"
        described as {
          |Counseling provided.
        }
      }
      counselingDeclined: Boolean with {
        briefly "Declined"
        described as {
          |Counseling declined.
        }
      }
      pharmacistId: PharmacistId? with {
        briefly "Pharmacist"
        described as {
          |Pharmacist ID.
        }
      }
      counselingDate: TimeStamp? with {
        briefly "Date"
        described as {
          |Counseling date.
        }
      }
    } with {
      briefly "Counseling data"
      described as {
        |Counseling tracking data.
      }
    }
    record ReturnData is {
      fillId: FillId with {
        briefly "Fill"
        described as {
          |Fill ID.
        }
      }
      returnedAt: TimeStamp with {
        briefly "Returned"
        described as {
          |Return time.
        }
      }
      returnReason: String with {
        briefly "Reason"
        described as {
          |Return reason.
        }
      }
      daysUntilReturn: Integer with {
        briefly "Days"
        described as {
          |Days until return.
        }
      }
    } with {
      briefly "Return data"
      described as {
        |Return tracking data.
      }
    }
    handler MetricsHandler is {
      on fillInitiated: event FillInitiated is {
        tell command DispensingContext.FillRepository.PersistFillInitiated(fillId = fillInitiated.fillId, prescriptionId = fillInitiated.prescriptionId, patientId = fillInitiated.patientId, requestedDrug = fillInitiated.requestedDrug, requestedQuantity = fillInitiated.requestedQuantity, initiatedAt = fillInitiated.initiatedAt, initiatedBy = fillInitiated.initiatedBy) to repository DispensingContext.FillRepository
      }
      on drugSelected: event DrugSelected is {
        tell command DispensingContext.FillRepository.PersistDrugSelected(fillId = drugSelected.fillId, selection = drugSelected.selection) to repository DispensingContext.FillRepository
      }
      on prescriptionFilled: event PrescriptionFilled is {
        tell command DispensingContext.FillRepository.PersistPrescriptionFilled(fillId = prescriptionFilled.fillId, quantityDispensed = prescriptionFilled.quantityDispensed, filledBy = prescriptionFilled.filledBy, filledAt = prescriptionFilled.filledAt) to repository DispensingContext.FillRepository
      }
      on fillVerified: event FillVerified is {
        tell command DispensingContext.FillRepository.PersistFillVerified(fillId = fillVerified.fillId, verifiedBy = fillVerified.verifiedBy, verifiedAt = fillVerified.verifiedAt, verificationNotes = fillVerified.verificationNotes) to repository DispensingContext.FillRepository
      }
      on labelPrinted: event LabelPrinted is {
        tell command DispensingContext.FillRepository.PersistLabelPrinted(fillId = labelPrinted.fillId, labelInfo = labelPrinted.labelInfo) to repository DispensingContext.FillRepository
      }
      on patientCounseled: event PatientCounseled is {
        tell command DispensingContext.FillRepository.PersistPatientCounseled(fillId = patientCounseled.fillId, counseling = patientCounseled.counseling) to repository DispensingContext.FillRepository
      }
      on pickupCompleted: event PickupCompleted is {
        tell command DispensingContext.FillRepository.PersistPickupCompleted(fillId = pickupCompleted.fillId, pickup = pickupCompleted.pickup) to repository DispensingContext.FillRepository
      }
      on returnedToStockEvent: event ReturnedToStock is {
        tell command DispensingContext.FillRepository.PersistReturnedToStock(fillId = returnedToStockEvent.fillId, returnRecord = returnedToStockEvent.returnRecord) to repository DispensingContext.FillRepository
      }
      on other is {
        do "Ignore other events"
      }
    } with {
      briefly "Metrics handler"
      described as {
        |Handler for metrics collection events.
      }
    }
  } with {
    briefly "Dispensing metrics"
    described as {
      |Projector for dispensing analytics.
    }
  }
  // ---- Event publication for Fill ----
  type FillEvent is one of {
    DispensingContext.Fill.FillInitiated or DispensingContext.Fill.DrugSelected or DispensingContext.Fill.PrescriptionFilled or DispensingContext.Fill.FillVerified or DispensingContext.Fill.LabelPrinted or DispensingContext.Fill.PatientCounseled or DispensingContext.Fill.PickupCompleted or DispensingContext.Fill.ReturnedToStock
  } with {
    briefly "Fill event alternation"
    described as {
      |Union of all Fill events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet FillEventSplit as flow is {
    inlet FillEventSplitIn is type FillEvent
    outlet FillEventSplitToDispensingMetrics is type FillEvent
    handler FillEventSplitHandler is {
      on fillInitiated: event Fill.FillInitiated is {
        send fillInitiated to outlet FillEventSplitToDispensingMetrics
      }
      on drugSelected: event Fill.DrugSelected is {
        send drugSelected to outlet FillEventSplitToDispensingMetrics
      }
      on prescriptionFilled: event Fill.PrescriptionFilled is {
        send prescriptionFilled to outlet FillEventSplitToDispensingMetrics
      }
      on fillVerified: event Fill.FillVerified is {
        send fillVerified to outlet FillEventSplitToDispensingMetrics
      }
      on labelPrinted: event Fill.LabelPrinted is {
        send labelPrinted to outlet FillEventSplitToDispensingMetrics
      }
      on patientCounseled: event Fill.PatientCounseled is {
        send patientCounseled to outlet FillEventSplitToDispensingMetrics
      }
      on pickupCompleted: event Fill.PickupCompleted is {
        send pickupCompleted to outlet FillEventSplitToDispensingMetrics
      }
      on returnedToStockEvent: event Fill.ReturnedToStock is {
        send returnedToStockEvent to outlet FillEventSplitToDispensingMetrics
      }
      on other is {
        error "Unexpected message for processor FillEventSplit"
      }
    } with {
      briefly "Fill event fan-out handler"
      described as {
        |Delivers each Fill event to all of its consumers.
      }
    }
  } with {
    briefly "Fill event fan-out"
    described as {
      |Fans Fill events out to the repository and projectors.
    }
  }
  connector 'FillEvent Stream' is from outlet DispensingContext.Fill.FillEvents2 to inlet DispensingContext.FillEventSplit.FillEventSplitIn with {
    briefly "Fill events, fanned out to storage and read models"
  }
  connector 'DispensingMetrics Feed' is from outlet DispensingContext.FillEventSplit.FillEventSplitToDispensingMetrics to inlet DispensingContext.DispensingMetrics.DispensingMetricsFromFill with {
    briefly "Fill events feeding the DispensingMetrics projection"
  }
  connector 'DispensingMetrics Storage' is from outlet DispensingContext.DispensingMetrics.DispensingMetricsToRepository to inlet DispensingContext.FillRepository.FillRepositoryFromDispensingMetrics with {
    briefly "DispensingMetrics updates on their way to storage"
  }
} with {
  briefly "Dispensing context"
  described as {
    | The DispensingContext encompasses all operations related to filling
    | prescriptions and dispensing medications to patients.
  }
}
