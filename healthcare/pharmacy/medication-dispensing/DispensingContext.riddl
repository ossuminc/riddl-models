// Dispensing Context - Bounded context for medication dispensing operations
context DispensingContext as router is {
  inlet FillCommandStreamIn is type FillCommand  outlet FillCommandStreamOut is type FillCommand
  inlet FillResultStreamIn is type Fill.FillResult  outlet FillResultStreamOut is type Fill.FillResult
  handler DispensingContextBoundary is {
    on initiateFill: command Fill.InitiateFill is {
      send initiateFill to outlet DispensingContext.FillCommandStreamOut
    }
    on selectDrug: command Fill.SelectDrug is {
      send selectDrug to outlet DispensingContext.FillCommandStreamOut
    }
    on fillPrescription: command Fill.FillPrescription is {
      send fillPrescription to outlet DispensingContext.FillCommandStreamOut
    }
    on verifyFill: command Fill.VerifyFill is {
      send verifyFill to outlet DispensingContext.FillCommandStreamOut
    }
    on printLabel: command Fill.PrintLabel is {
      send printLabel to outlet DispensingContext.FillCommandStreamOut
    }
    on counselPatient: command Fill.CounselPatient is {
      send counselPatient to outlet DispensingContext.FillCommandStreamOut
    }
    on completePickup: command Fill.CompletePickup is {
      send completePickup to outlet DispensingContext.FillCommandStreamOut
    }
    on returnToStock: command Fill.ReturnToStock is {
      send returnToStock to outlet DispensingContext.FillCommandStreamOut
    }
    on fillResult: result Fill.FillResult is {
      send fillResult to outlet DispensingContext.FillResultStreamOut
    }
    on other is {
      error "Unexpected message at the DispensingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'FillCommand Stream Intake' is from outlet DispensingContext.FillCommandStreamOut to inlet DispensingContext.Fill.FillCommands  connector 'FillResult Stream Egress' is from outlet DispensingContext.FillRepository.FillRepositoryResponses to inlet DispensingContext.FillResultStreamIn  adaptor FromDrugDatabase from context DrugDatabase is { 
    handler FromDrugDatabaseHandler is {
      on event DrugDatabase.DrugImageRequested is {
        do "the model receives drug image requested"
      }
      on event DrugDatabase.DrugInteractionDetected is {
        do "the model receives drug interaction detected"
      }
      on other is {
        error "Unexpected message for adaptor FromDrugDatabase"
      }
    } with {
      briefly "from drug database"
      described as {
        |Carries messages from the external DrugDatabase.
      }
    }
  } with {
    briefly "DrugDatabase integration"
    described as {
      |The model's side of the DrugDatabase conversation.
    }
  }
  adaptor FromInventoryService from context InventoryService is { 
    handler FromInventoryServiceHandler is {
      on event InventoryService.ExpirationAlert is {
        do "the model receives expiration alert"
      }
      on event InventoryService.LowStockAlert is {
        do "the model receives low stock alert"
      }
      on event InventoryService.StockDispensed is {
        do "the model receives stock dispensed"
      }
      on event InventoryService.StockReserved is {
        do "the model receives stock reserved"
      }
      on event InventoryService.StockReturned is {
        do "the model receives stock returned"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromPOSBilling from context POSBilling is { 
    handler FromPOSBillingHandler is {
      on event POSBilling.CopayCollected is {
        do "the model receives copay collected"
      }
      on event POSBilling.CopayWaived is {
        do "the model receives copay waived"
      }
      on event POSBilling.PaymentFailed is {
        do "the model receives payment failed"
      }
      on other is {
        error "Unexpected message for adaptor FromPOSBilling"
      }
    } with {
      briefly "from pos billing"
      described as {
        |Carries messages from the external POSBilling.
      }
    }
  } with {
    briefly "POSBilling integration"
    described as {
      |The model's side of the POSBilling conversation.
    }
  }
  adaptor FromPatientService from context PatientService is { 
    handler FromPatientServiceHandler is {
      on event PatientService.PatientArrived is {
        do "the model receives patient arrived"
      }
      on other is {
        error "Unexpected message for adaptor FromPatientService"
      }
    } with {
      briefly "from patient service"
      described as {
        |Carries messages from the external PatientService.
      }
    }
  } with {
    briefly "PatientService integration"
    described as {
      |The model's side of the PatientService conversation.
    }
  }
  adaptor FromPrescriptionService from context PrescriptionService is { 
    handler FromPrescriptionServiceHandler is {
      on event PrescriptionService.PrescriptionReadyToFill is {
        do "the model receives prescription ready to fill"
      }
      on other is {
        error "Unexpected message for adaptor FromPrescriptionService"
      }
    } with {
      briefly "from prescription service"
      described as {
        |Carries messages from the external PrescriptionService.
      }
    }
  } with {
    briefly "PrescriptionService integration"
    described as {
      |The model's side of the PrescriptionService conversation.
    }
  }
  include "types.riddl"
  include "Fill.riddl"
  // === Repository ===
  repository FillRepository as merge is {
    command PersistDrugSelected is  {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row DrugSelected applies to.
        }
      }
    } with {
      briefly "Persist DrugSelected"
      described as {
        |Instructs this repository to apply DrugSelected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFillInitiated is  {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row FillInitiated applies to.
        }
      }
    } with {
      briefly "Persist FillInitiated"
      described as {
        |Instructs this repository to apply FillInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFillVerified is  {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row FillVerified applies to.
        }
      }
    } with {
      briefly "Persist FillVerified"
      described as {
        |Instructs this repository to apply FillVerified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLabelPrinted is  {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row LabelPrinted applies to.
        }
      }
    } with {
      briefly "Persist LabelPrinted"
      described as {
        |Instructs this repository to apply LabelPrinted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPatientCounseled is  {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row PatientCounseled applies to.
        }
      }
    } with {
      briefly "Persist PatientCounseled"
      described as {
        |Instructs this repository to apply PatientCounseled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPickupCompleted is  {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row PickupCompleted applies to.
        }
      }
    } with {
      briefly "Persist PickupCompleted"
      described as {
        |Instructs this repository to apply PickupCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPrescriptionFilled is  {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row PrescriptionFilled applies to.
        }
      }
    } with {
      briefly "Persist PrescriptionFilled"
      described as {
        |Instructs this repository to apply PrescriptionFilled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnedToStock is  {
      fillId: FillId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnedToStock applies to.
        }
      }
    } with {
      briefly "Persist ReturnedToStock"
      described as {
        |Instructs this repository to apply ReturnedToStock to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredFill is  {
      fillId: FillId with {
        briefly "fillId"
        described as {
          |The fillId column of the stored fill row.
        }
      }
    } with {
      briefly "Stored fill row"
      described as {
        |The persistence shape of fill data as this repository stores it.
      }
    }
    schema FillData is relational
      of fills as type StoredFill
        index on field StoredFill.fillId
 with {
      briefly "Fill data schema"
      described as {
        |The relational schema persisting fill records for this repository.
      }
    }
    inlet FillRepositoryFromFill is type FillEvent    inlet FillRepositoryFromDispensingMetrics is type FillEvent    outlet FillRepositoryResponses is type Fill.FillResult
    handler FillQueries is {
      on persistDrugSelected: command PersistDrugSelected is {
        do "apply DrugSelected to the stored row"
      }
      on persistFillInitiated: command PersistFillInitiated is {
        do "apply FillInitiated to the stored row"
      }
      on persistFillVerified: command PersistFillVerified is {
        do "apply FillVerified to the stored row"
      }
      on persistLabelPrinted: command PersistLabelPrinted is {
        do "apply LabelPrinted to the stored row"
      }
      on persistPatientCounseled: command PersistPatientCounseled is {
        do "apply PatientCounseled to the stored row"
      }
      on persistPickupCompleted: command PersistPickupCompleted is {
        do "apply PickupCompleted to the stored row"
      }
      on persistPrescriptionFilled: command PersistPrescriptionFilled is {
        do "apply PrescriptionFilled to the stored row"
      }
      on persistReturnedToStock: command PersistReturnedToStock is {
        do "apply ReturnedToStock to the stored row"
      }
      on query GetFillTimeData is {
        let fillTimeDataView: type FillTimeDataView = prompt("read the fill time data projection")
        reply fillTimeDataView
      }
      on query GetCounselingData is {
        let counselingDataView: type CounselingDataView = prompt("read the counseling data projection")
        reply counselingDataView
      }
      on query GetReturnData is {
        let returnDataView: type ReturnDataView = prompt("read the return data projection")
        reply returnDataView
      }
      on query GetFillTimeMetrics is {
        let fillTimeMetricsView: type FillTimeMetricsView = prompt("aggregate fill time metrics over the requested period")
        reply fillTimeMetricsView
      }
      on query GetCounselingComplianceMetrics is {
        let counselingComplianceMetricsView: type CounselingComplianceMetricsView = prompt("aggregate counseling compliance metrics over the requested period")
        reply counselingComplianceMetricsView
      }
      on query GetReturnRateMetrics is {
        let returnRateMetricsView: type ReturnRateMetricsView = prompt("aggregate return rate metrics over the requested period")
        reply returnRateMetricsView
      }
      on query GetFillById is {
        let fillResult: type FillResult = prompt("read the fill from the store")
        reply fillResult
      }
      on query GetFillsByPatient is {
        let fillResult: type FillResult = prompt("read the fill from the store")
        reply fillResult
      }
      on query GetFillsByStatus is {
        let fillResult: type FillResult = prompt("read the fill from the store")
        reply fillResult
      }
      on query GetPendingFills is {
        let fillResult: type FillResult = prompt("read the fill from the store")
        reply fillResult
      }
      on query GetReadyForPickup is {
        let fillResult: type FillResult = prompt("read the fill that ready for pickup asks for")
        reply fillResult
      }
    } with {
      briefly "Fill queries"
      described as {
        |Query handler for fill records.
      }
    }
    handler CounselingQueries is {
      on query GetCounselingByFill is {
        let fillResult: type FillResult = prompt("read the fill from the store")
        reply fillResult
      }
      on query GetCounselingByPharmacist is {
        let fillResult: type FillResult = prompt("read the fill that counseling by pharmacist asks for")
        reply fillResult
      }
      on query GetDeclinedCounseling is {
        let fillResult: type FillResult = prompt("read the fill that declined counseling asks for")
        reply fillResult
      }
    } with {
      briefly "Counseling queries"
      described as {
        |Query handler for counseling records.
      }
    }
    handler PickupQueries is {
      on query GetPickupsByDate is {
        let fillResult: type FillResult = prompt("read the fill that pickups by date asks for")
        reply fillResult
      }
      on query GetOverduePickups is {
        let fillResult: type FillResult = prompt("read the fill that overdue pickups asks for")
        reply fillResult
      }
    } with {
      briefly "Pickup queries"
      described as {
        |Query handler for pickup records.
      }
    }
  } with {
    briefly "Fill repository"
    described as {
      |Repository for fill, counseling, and pickup records.
    }
  }
  // === Projector ===
  query GetFillTimeData is  {
    fillTimeDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which fill time data to retrieve.
      }
    }
  } with {
    briefly "Get fill time data"
    described as {
      |Retrieves the fill time data projection.
    }
  }
  result FillTimeDataView is  {
    fillTimeData: DispensingMetrics.FillTimeData with {
      briefly "Fill time data"
      described as {
        |The fill time data being returned.
      }
    }
  } with {
    briefly "Fill time data view"
    described as {
      |Read model view carrying the fill time data projection.
    }
  }
  query GetCounselingData is  {
    counselingDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which counseling data to retrieve.
      }
    }
  } with {
    briefly "Get counseling data"
    described as {
      |Retrieves the counseling data projection.
    }
  }
  result CounselingDataView is  {
    counselingData: DispensingMetrics.CounselingData with {
      briefly "Counseling data"
      described as {
        |The counseling data being returned.
      }
    }
  } with {
    briefly "Counseling data view"
    described as {
      |Read model view carrying the counseling data projection.
    }
  }
  query GetReturnData is  {
    returnDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which return data to retrieve.
      }
    }
  } with {
    briefly "Get return data"
    described as {
      |Retrieves the return data projection.
    }
  }
  result ReturnDataView is  {
    returnData: DispensingMetrics.ReturnData with {
      briefly "Return data"
      described as {
        |The return data being returned.
      }
    }
  } with {
    briefly "Return data view"
    described as {
      |Read model view carrying the return data projection.
    }
  }
  result FillTimeMetricsView is  {
    fillTimeMetrics: FillTimeMetrics with {
      briefly "Fill time metrics"
      described as {
        |The aggregated fill time metrics being returned.
      }
    }
  } with {
    briefly "Fill time metrics view"
    described as {
      |Read model view carrying fill time metrics aggregated over a period.
    }
  }
  result CounselingComplianceMetricsView is  {
    counselingComplianceMetrics: CounselingComplianceMetrics with {
      briefly "Counseling compliance metrics"
      described as {
        |The aggregated counseling compliance metrics being returned.
      }
    }
  } with {
    briefly "Counseling compliance metrics view"
    described as {
      |Read model view carrying counseling compliance metrics aggregated over
      |a period.
    }
  }
  result ReturnRateMetricsView is  {
    returnRateMetrics: ReturnRateMetrics with {
      briefly "Return rate metrics"
      described as {
        |The aggregated return rate metrics being returned.
      }
    }
  } with {
    briefly "Return rate metrics view"
    described as {
      |Read model view carrying return rate metrics aggregated over a period.
    }
  }
  projector DispensingMetrics as flow is {
    updates repository DispensingContext.FillRepository
    inlet DispensingMetricsFromFill is type FillEvent    outlet DispensingMetricsOut is type FillEvent
    record FillTimeData is  {
      fillId: FillId with {
        briefly "Fill"
        described as {
          |Fill ID.
        }
      }
      initiatedAt: TimeStamp with {
        briefly "Initiated"
        described as {
          |Initiation time.
        }
      }
      selectedAt: TimeStamp? with {
        briefly "Selected"
        described as {
          |Selection time.
        }
      }
      filledAt: TimeStamp? with {
        briefly "Filled"
        described as {
          |Fill time.
        }
      }
      verifiedAt: TimeStamp? with {
        briefly "Verified"
        described as {
          |Verification time.
        }
      }
      labeledAt: TimeStamp? with {
        briefly "Labeled"
        described as {
          |Labeling time.
        }
      }
      pickedUpAt: TimeStamp? with {
        briefly "Picked up"
        described as {
          |Pickup time.
        }
      }
    } with {
      briefly "Fill time data"
      described as {
        |Timestamps for fill time analysis.
      }
    }
    record CounselingData is  {
      fillId: FillId with {
        briefly "Fill"
        described as {
          |Fill ID.
        }
      }
      counselingProvided: Boolean with {
        briefly "Provided"
        described as {
          |Counseling provided.
        }
      }
      counselingDeclined: Boolean with {
        briefly "Declined"
        described as {
          |Counseling declined.
        }
      }
      pharmacistId: PharmacistId? with {
        briefly "Pharmacist"
        described as {
          |Pharmacist ID.
        }
      }
      counselingDate: TimeStamp? with {
        briefly "Date"
        described as {
          |Counseling date.
        }
      }
    } with {
      briefly "Counseling data"
      described as {
        |Counseling tracking data.
      }
    }
    record ReturnData is  {
      fillId: FillId with {
        briefly "Fill"
        described as {
          |Fill ID.
        }
      }
      returnedAt: TimeStamp with {
        briefly "Returned"
        described as {
          |Return time.
        }
      }
      returnReason: String with {
        briefly "Reason"
        described as {
          |Return reason.
        }
      }
      daysUntilReturn: Integer with {
        briefly "Days"
        described as {
          |Days until return.
        }
      }
    } with {
      briefly "Return data"
      described as {
        |Return tracking data.
      }
    }
    handler MetricsHandler is {
      on fillInitiated: event FillInitiated is {
        tell command DispensingContext.FillRepository.PersistFillInitiated(fillId = fillInitiated.fillId) to repository DispensingContext.FillRepository
      }
      on drugSelected: event DrugSelected is {
        tell command DispensingContext.FillRepository.PersistDrugSelected(fillId = drugSelected.fillId) to repository DispensingContext.FillRepository
      }
      on prescriptionFilled: event PrescriptionFilled is {
        tell command DispensingContext.FillRepository.PersistPrescriptionFilled(fillId = prescriptionFilled.fillId) to repository DispensingContext.FillRepository
      }
      on fillVerified: event FillVerified is {
        tell command DispensingContext.FillRepository.PersistFillVerified(fillId = fillVerified.fillId) to repository DispensingContext.FillRepository
      }
      on labelPrinted: event LabelPrinted is {
        tell command DispensingContext.FillRepository.PersistLabelPrinted(fillId = labelPrinted.fillId) to repository DispensingContext.FillRepository
      }
      on patientCounseled: event PatientCounseled is {
        tell command DispensingContext.FillRepository.PersistPatientCounseled(fillId = patientCounseled.fillId) to repository DispensingContext.FillRepository
      }
      on pickupCompleted: event PickupCompleted is {
        tell command DispensingContext.FillRepository.PersistPickupCompleted(fillId = pickupCompleted.fillId) to repository DispensingContext.FillRepository
      }
      on returnedToStockEvent: event ReturnedToStock is {
        tell command DispensingContext.FillRepository.PersistReturnedToStock(fillId = returnedToStockEvent.fillId) to repository DispensingContext.FillRepository
      }
      on other is {
        do "Ignore other events"
      }
    } with {
      briefly "Metrics handler"
      described as {
        |Handler for metrics collection events.
      }
    }
  } with {
    briefly "Dispensing metrics"
    described as {
      |Projector for dispensing analytics.
    }
  }
  // ---- Event publication for Fill ----
  type FillEvent is one of {
    DispensingContext.Fill.FillInitiated or DispensingContext.Fill.DrugSelected or DispensingContext.Fill.PrescriptionFilled or DispensingContext.Fill.FillVerified or DispensingContext.Fill.LabelPrinted or DispensingContext.Fill.PatientCounseled or DispensingContext.Fill.PickupCompleted or DispensingContext.Fill.ReturnedToStock
  } with {
    briefly "Fill event alternation"
    described as {
      |Union of all Fill events, for streaming and event-sourced
      |persistence.
    }
  }
  processor FillEventSource as source is {
    outlet FillEvents is type FillEvent
    handler FillSourceHandler is {
      on fillInitiated: event Fill.FillInitiated is {
        send fillInitiated to outlet FillEvents
      }
      on drugSelected: event Fill.DrugSelected is {
        send drugSelected to outlet FillEvents
      }
      on prescriptionFilled: event Fill.PrescriptionFilled is {
        send prescriptionFilled to outlet FillEvents
      }
      on fillVerified: event Fill.FillVerified is {
        send fillVerified to outlet FillEvents
      }
      on labelPrinted: event Fill.LabelPrinted is {
        send labelPrinted to outlet FillEvents
      }
      on patientCounseled: event Fill.PatientCounseled is {
        send patientCounseled to outlet FillEvents
      }
      on pickupCompleted: event Fill.PickupCompleted is {
        send pickupCompleted to outlet FillEvents
      }
      on returnedToStockEvent: event Fill.ReturnedToStock is {
        send returnedToStockEvent to outlet FillEvents
      }
      on other is {
        error "Unexpected message for source FillEventSource"
      }
    } with {
      briefly "Fill source handler"
      described as {
        |Publishes Fill events onto the outlet.
      }
    }
  } with {
    briefly "Fill event source"
    described as {
      |Publishes Fill entity events into the streaming topology.
    }
  }
  processor FillEventSink as sink is {
    inlet FillInlet is type FillEvent    handler FillSinkHandler is {
      on fillInitiated: event Fill.FillInitiated is {
        tell fillInitiated to repository DispensingContext.FillRepository
      }
      on drugSelected: event Fill.DrugSelected is {
        tell drugSelected to repository DispensingContext.FillRepository
      }
      on prescriptionFilled: event Fill.PrescriptionFilled is {
        tell prescriptionFilled to repository DispensingContext.FillRepository
      }
      on fillVerified: event Fill.FillVerified is {
        tell fillVerified to repository DispensingContext.FillRepository
      }
      on labelPrinted: event Fill.LabelPrinted is {
        tell labelPrinted to repository DispensingContext.FillRepository
      }
      on patientCounseled: event Fill.PatientCounseled is {
        tell patientCounseled to repository DispensingContext.FillRepository
      }
      on pickupCompleted: event Fill.PickupCompleted is {
        tell pickupCompleted to repository DispensingContext.FillRepository
      }
      on returnedToStockEvent: event Fill.ReturnedToStock is {
        tell returnedToStockEvent to repository DispensingContext.FillRepository
      }
      on other is {
        error "Unexpected message for sink FillEventSink"
      }
    } with {
      briefly "Fill sink handler"
      described as {
        |Persists Fill events via the repository.
      }
    }
  } with {
    briefly "Fill event sink"
    described as {
      |Receives Fill events for persistence.
    }
  }
  connector FillEventFlow is from outlet DispensingContext.FillEventSource.FillEvents to inlet DispensingContext.FillEventSink.FillInlet with {
    briefly "Fill event flow"
    described as {
      |Connects the Fill source to its sink.
    }
  }
  processor FillEventSplit as split is {
    inlet FillEventSplitIn is type FillEvent    outlet FillEventSplitToFillRepository is type FillEvent
    outlet FillEventSplitToDispensingMetrics is type FillEvent
    handler FillEventSplitHandler is {
      on fillInitiated: event Fill.FillInitiated is {
        send fillInitiated to outlet FillEventSplitToFillRepository
        send fillInitiated to outlet FillEventSplitToDispensingMetrics
        tell fillInitiated to entity DispensingContext.Fill
      }
      on drugSelected: event Fill.DrugSelected is {
        send drugSelected to outlet FillEventSplitToFillRepository
        send drugSelected to outlet FillEventSplitToDispensingMetrics
        tell drugSelected to entity DispensingContext.Fill
      }
      on prescriptionFilled: event Fill.PrescriptionFilled is {
        send prescriptionFilled to outlet FillEventSplitToFillRepository
        send prescriptionFilled to outlet FillEventSplitToDispensingMetrics
        tell prescriptionFilled to entity DispensingContext.Fill
      }
      on fillVerified: event Fill.FillVerified is {
        send fillVerified to outlet FillEventSplitToFillRepository
        send fillVerified to outlet FillEventSplitToDispensingMetrics
        tell fillVerified to entity DispensingContext.Fill
      }
      on labelPrinted: event Fill.LabelPrinted is {
        send labelPrinted to outlet FillEventSplitToFillRepository
        send labelPrinted to outlet FillEventSplitToDispensingMetrics
        tell labelPrinted to entity DispensingContext.Fill
      }
      on patientCounseled: event Fill.PatientCounseled is {
        send patientCounseled to outlet FillEventSplitToFillRepository
        send patientCounseled to outlet FillEventSplitToDispensingMetrics
        tell patientCounseled to entity DispensingContext.Fill
      }
      on pickupCompleted: event Fill.PickupCompleted is {
        send pickupCompleted to outlet FillEventSplitToFillRepository
        send pickupCompleted to outlet FillEventSplitToDispensingMetrics
        tell pickupCompleted to entity DispensingContext.Fill
      }
      on returnedToStockEvent: event Fill.ReturnedToStock is {
        send returnedToStockEvent to outlet FillEventSplitToFillRepository
        send returnedToStockEvent to outlet FillEventSplitToDispensingMetrics
        tell returnedToStockEvent to entity DispensingContext.Fill
      }
      on other is {
        error "Unexpected message for processor FillEventSplit"
      }
    } with {
      briefly "Fill event fan-out handler"
      described as {
        |Delivers each Fill event to all of its consumers.
      }
    }
  } with {
    briefly "Fill event fan-out"
    described as {
      |Fans Fill events out to the repository and projectors.
    }
  }
  connector 'FillEvent Stream' is from outlet DispensingContext.Fill.FillEvents2 to inlet DispensingContext.FillEventSplit.FillEventSplitIn with {
    briefly "Fill events, fanned out to storage and read models"
  }
  connector 'FillEvent Storage' is from outlet DispensingContext.FillEventSplit.FillEventSplitToFillRepository to inlet DispensingContext.FillRepository.FillRepositoryFromFill with {
    briefly "Fill events on their way to storage"
  }
  connector 'DispensingMetrics Feed' is from outlet DispensingContext.FillEventSplit.FillEventSplitToDispensingMetrics to inlet DispensingContext.DispensingMetrics.DispensingMetricsFromFill with {
    briefly "Fill events feeding the DispensingMetrics projection"
  }
  connector 'DispensingMetrics Storage' is from outlet DispensingContext.DispensingMetrics.DispensingMetricsOut to inlet DispensingContext.FillRepository.FillRepositoryFromDispensingMetrics with {
    briefly "The DispensingMetrics projection on its way to storage"
  }
} with {
  briefly "Dispensing context"
  described as {
    | The DispensingContext encompasses all operations related to filling
    | prescriptions and dispensing medications to patients.
  }
}
