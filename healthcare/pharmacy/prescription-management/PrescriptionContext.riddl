// Prescription Management - Bounded Context
context PrescriptionContext is {
  include "types.riddl"
  include "Prescription.riddl"
  // ───────────────────────────────────────────────────────────────────────────
  // Repository
  // ───────────────────────────────────────────────────────────────────────────
  repository PrescriptionRepository is {
    schema PrescriptionData is relational
      of prescriptions as type Prescription
      with {
      briefly "Prescription data schema"
      described as {
        |The relational schema persisting prescription records for this repository.
      }
    }
    inlet PrescriptionRepositoryFromPrescription is type PrescriptionEvent
    inlet PrescriptionRepositoryFromRefillRateProjector is type PrescriptionEvent
    inlet PrescriptionRepositoryFromTransferMetricsProjector is type PrescriptionEvent
    inlet PrescriptionRepositoryFromHoldAnalysisProjector is type PrescriptionEvent
    outlet PrescriptionRepositoryResponses is type Prescription.PrescriptionQueryResult
    // Prescription queries
    query FindPrescriptionById is  {
      prescriptionId: PrescriptionId with {
        briefly "ID"
        described as {
          |Prescription identifier.
        }
      }
    } with {
      briefly "Find prescription by ID"
      described as {
        |Retrieves the complete prescription record.
      }
    }
    query FindPrescriptionsByPatient is  {
      patientId: PatientId with {
        briefly "Patient"
        described as {
          |Patient identifier.
        }
      }
      includeInactive: Boolean with {
        briefly "Inactive"
        described as {
          |Include inactive.
        }
      }
      limit: Integer with {
        briefly "Limit"
        described as {
          |Max results.
        }
      }
      offset: Integer with {
        briefly "Offset"
        described as {
          |Result offset.
        }
      }
    } with {
      briefly "Find prescriptions for a patient"
      described as {
        |Retrieves prescriptions for a patient.
      }
    }
    query FindPrescriptionsByPrescriber is  {
      prescriberId: PrescriberId with {
        briefly "Prescriber"
        described as {
          |Prescriber identifier.
        }
      }
      startDate: Date with {
        briefly "Start"
        described as {
          |Start date.
        }
      }
      endDate: Date with {
        briefly "End"
        described as {
          |End date.
        }
      }
      limit: Integer with {
        briefly "Limit"
        described as {
          |Max results.
        }
      }
    } with {
      briefly "Find prescriptions by prescriber"
      described as {
        |Retrieves prescriptions written by a prescriber.
      }
    }
    query FindPrescriptionsByStatus is  {
      status: RxStatus with {
        briefly "Status"
        described as {
          |Prescription status.
        }
      }
      pharmacyId: PharmacyId with {
        briefly "Pharmacy"
        described as {
          |Pharmacy identifier.
        }
      }
      limit: Integer with {
        briefly "Limit"
        described as {
          |Max results.
        }
      }
    } with {
      briefly "Find prescriptions by status"
      described as {
        |Retrieves prescriptions in a specific status.
      }
    }
    query FindPrescriptionsOnHold is  {
      pharmacyId: PharmacyId with {
        briefly "Pharmacy"
        described as {
          |Pharmacy identifier.
        }
      }
      holdReason: HoldReason? with {
        briefly "Reason"
        described as {
          |Hold reason filter.
        }
      }
      olderThanDays: Integer? with {
        briefly "Days"
        described as {
          |Age threshold.
        }
      }
    } with {
      briefly "Find prescriptions on hold"
      described as {
        |Retrieves held prescriptions for resolution.
      }
    }
    query FindExpiringPrescriptions is  {
      pharmacyId: PharmacyId with {
        briefly "Pharmacy"
        described as {
          |Pharmacy identifier.
        }
      }
      expiresWithinDays: Integer with {
        briefly "Days"
        described as {
          |Expiration window.
        }
      }
    } with {
      briefly "Find expiring prescriptions"
      described as {
        |Identifies prescriptions nearing expiration.
      }
    }
    query GetRefillHistory is  {
      prescriptionId: PrescriptionId with {
        briefly "ID"
        described as {
          |Prescription identifier.
        }
      }
    } with {
      briefly "Get refill history"
      described as {
        |Retrieves all refill records for a prescription.
      }
    }
    query FindRefillsDue is  {
      patientId: PatientId with {
        briefly "Patient"
        described as {
          |Patient identifier.
        }
      }
      daysUntilDue: Integer with {
        briefly "Days"
        described as {
          |Days until due.
        }
      }
    } with {
      briefly "Find prescriptions due for refill"
      described as {
        |Identifies prescriptions due for refill.
      }
    }
    // Query results
    result PrescriptionResult is  {
      prescription: PrescriptionRecord? with {
        briefly "Prescription"
        described as {
          |Prescription result.
        }
      }
    } with {
      briefly "Single prescription result"
      described as {
        |Returns the requested prescription or empty.
      }
    }
    result PrescriptionListResult is  {
      prescriptions: PrescriptionRecord+ with {
        briefly "Prescriptions"
        described as {
          |Matching prescriptions.
        }
      }
      totalCount: Integer with {
        briefly "Total"
        described as {
          |Total count.
        }
      }
      hasMore: Boolean with {
        briefly "More"
        described as {
          |Has more results.
        }
      }
    } with {
      briefly "Paginated prescription list"
      described as {
        |Returns matching prescriptions with pagination.
      }
    }
    result RefillHistoryResult is  {
      prescriptionId: PrescriptionId with {
        briefly "ID"
        described as {
          |Prescription identifier.
        }
      }
      refills: RefillInfo+ with {
        briefly "Refills"
        described as {
          |Refill records.
        }
      }
    } with {
      briefly "Refill history result"
      described as {
        |Returns all refill records.
      }
    }
    result RefillsDueResult is  {
      prescriptions: PrescriptionRecord+ with {
        briefly "Prescriptions"
        described as {
          |Prescriptions due.
        }
      }
      estimatedRefillDates: Date+ with {
        briefly "Dates"
        described as {
          |Estimated refill dates.
        }
      }
    } with {
      briefly "Prescriptions due for refill"
      described as {
        |Returns prescriptions due for refill.
      }
    }
    handler RepositoryHandler is {
      on query FindPrescriptionById is {
        yield result PrescriptionResult
      }
      on query FindPrescriptionsByPatient is {
        yield result PrescriptionResult
      }
      on query FindPrescriptionsByPrescriber is {
        yield result PrescriptionResult
      }
      on query FindPrescriptionsByStatus is {
        yield result PrescriptionResult
      }
      on query FindPrescriptionsOnHold is {
        yield result PrescriptionResult
      }
      on query FindExpiringPrescriptions is {
        yield result PrescriptionResult
      }
      on query GetRefillHistory is {
        yield result PrescriptionResult
      }
      on query FindRefillsDue is {
        yield result PrescriptionResult
      }
    } with {
      briefly "Repository query handler"
      described as {
        |Processes all prescription queries.
      }
    }
  } with {
    briefly "Prescription repository"
    described as {
      |Prescription and refill history persistence and queries.
    }
  }
  // ───────────────────────────────────────────────────────────────────────────
  // Projectors
  // ───────────────────────────────────────────────────────────────────────────
  projector RefillRateProjector is {
    inlet RefillRateProjectorFromPrescription is type PrescriptionEvent
    outlet RefillRateProjectorOut is type PrescriptionEvent
    updates repository PrescriptionContext.PrescriptionRepository
    record RefillRateMetrics is  {
      pharmacyId: PharmacyId with {
        briefly "Pharmacy"
        described as {
          |Pharmacy identifier.
        }
      }
      periodStart: Date with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Period end.
        }
      }
      totalPrescriptions: Integer with {
        briefly "Total"
        described as {
          |Total prescriptions.
        }
      }
      totalRefillsRequested: Integer with {
        briefly "Requested"
        described as {
          |Refills requested.
        }
      }
      totalRefillsApproved: Integer with {
        briefly "Approved"
        described as {
          |Refills approved.
        }
      }
      refillApprovalRate: Number with {
        briefly "Rate"
        described as {
          |Approval rate.
        }
      }
      averageRefillsPerRx: Number with {
        briefly "Average"
        described as {
          |Average refills per Rx.
        }
      }
      autoRefillCount: Integer with {
        briefly "Auto"
        described as {
          |Auto refill count.
        }
      }
      patientRequestCount: Integer with {
        briefly "Patient"
        described as {
          |Patient request count.
        }
      }
    } with {
      briefly "Refill rate metrics"
      described as {
        |Aggregated refill pattern metrics.
      }
    }
    handler RefillRateHandler is {
      on event Prescription.RefillRequested is {
        tell event Prescription.RefillRequested to repository PrescriptionContext.PrescriptionRepository
      }
      on event Prescription.RefillApproved is {
        tell event Prescription.RefillApproved to repository PrescriptionContext.PrescriptionRepository
      }
    } with {
      briefly "Refill rate handler"
      described as {
        |Updates refill rate metrics from events.
      }
    }
  } with {
    briefly "Refill rate analytics"
    described as {
      |Maintains read-optimized views of refill patterns.
    }
  }
  projector TransferMetricsProjector is {
    inlet TransferMetricsProjectorFromPrescription is type PrescriptionEvent
    outlet TransferMetricsProjectorOut is type PrescriptionEvent
    updates repository PrescriptionContext.PrescriptionRepository
    record TransferReasonCount is  {
      transferReason: TransferReason with {
        briefly "Reason"
        described as {
          |Transfer reason.
        }
      }
      count: Integer with {
        briefly "Count"
        described as {
          |Transfer count.
        }
      }
    } with {
      briefly "Transfer count by reason"
      described as {
        |Breakdown of transfer volume by reason.
      }
    }
    record PharmacyTransferCount is  {
      pharmacyId: PharmacyId with {
        briefly "Pharmacy"
        described as {
          |Pharmacy identifier.
        }
      }
      pharmacyName: String with {
        briefly "Name"
        described as {
          |Pharmacy name.
        }
      }
      count: Integer with {
        briefly "Count"
        described as {
          |Transfer count.
        }
      }
    } with {
      briefly "Transfer count by pharmacy"
      described as {
        |Transfer volume with a specific pharmacy.
      }
    }
    record TransferMetrics is  {
      pharmacyId: PharmacyId with {
        briefly "Pharmacy"
        described as {
          |Pharmacy identifier.
        }
      }
      periodStart: Date with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Period end.
        }
      }
      transfersIn: Integer with {
        briefly "In"
        described as {
          |Transfers in.
        }
      }
      transfersOut: Integer with {
        briefly "Out"
        described as {
          |Transfers out.
        }
      }
      netTransfers: Integer with {
        briefly "Net"
        described as {
          |Net transfers.
        }
      }
      transfersByReason: TransferReasonCount+ with {
        briefly "By reason"
        described as {
          |Transfers by reason.
        }
      }
      topDestinations: PharmacyTransferCount+ with {
        briefly "Top"
        described as {
          |Top destinations.
        }
      }
      averageRefillsTransferred: Number with {
        briefly "Average"
        described as {
          |Average refills transferred.
        }
      }
    } with {
      briefly "Transfer metrics"
      described as {
        |Aggregated transfer pattern metrics.
      }
    }
    handler TransferMetricsHandler is {
      on event Prescription.PrescriptionTransferred is {
        tell event Prescription.PrescriptionTransferred to repository PrescriptionContext.PrescriptionRepository
      }
    } with {
      briefly "Transfer metrics handler"
      described as {
        |Updates transfer metrics from events.
      }
    }
  } with {
    briefly "Transfer metrics analytics"
    described as {
      |Maintains read-optimized views of transfer patterns.
    }
  }
  projector HoldAnalysisProjector is {
    inlet HoldAnalysisProjectorFromPrescription is type PrescriptionEvent
    outlet HoldAnalysisProjectorOut is type PrescriptionEvent
    updates repository PrescriptionContext.PrescriptionRepository
    record HoldReasonCount is  {
      holdReason: HoldReason with {
        briefly "Reason"
        described as {
          |Hold reason.
        }
      }
      count: Integer with {
        briefly "Count"
        described as {
          |Hold count.
        }
      }
      averageDuration: Duration with {
        briefly "Duration"
        described as {
          |Average duration.
        }
      }
    } with {
      briefly "Hold count by reason"
      described as {
        |Breakdown of hold volume and duration by reason.
      }
    }
    record HoldAnalysisMetrics is  {
      pharmacyId: PharmacyId with {
        briefly "Pharmacy"
        described as {
          |Pharmacy identifier.
        }
      }
      periodStart: Date with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Period end.
        }
      }
      totalHoldsPlaced: Integer with {
        briefly "Placed"
        described as {
          |Holds placed.
        }
      }
      totalHoldsReleased: Integer with {
        briefly "Released"
        described as {
          |Holds released.
        }
      }
      currentlyOnHold: Integer with {
        briefly "Current"
        described as {
          |Currently on hold.
        }
      }
      holdsByReason: HoldReasonCount+ with {
        briefly "By reason"
        described as {
          |Holds by reason.
        }
      }
      averageHoldDuration: Duration with {
        briefly "Duration"
        described as {
          |Average duration.
        }
      }
      holdsExceedingSLA: Integer with {
        briefly "Exceeding"
        described as {
          |Holds exceeding SLA.
        }
      }
    } with {
      briefly "Hold analysis metrics"
      described as {
        |Aggregated hold pattern metrics.
      }
    }
    handler HoldAnalysisHandler is {
      on event Prescription.PrescriptionOnHold is {
        tell event Prescription.PrescriptionOnHold to repository PrescriptionContext.PrescriptionRepository
      }
      on event Prescription.HoldReleased is {
        tell event Prescription.HoldReleased to repository PrescriptionContext.PrescriptionRepository
      }
    } with {
      briefly "Hold analysis handler"
      described as {
        |Updates hold metrics from events.
      }
    }
  } with {
    briefly "Hold analysis analytics"
    described as {
      |Maintains read-optimized views of hold patterns.
    }
  }
  // ---- Event publication for Prescription ----
  type PrescriptionEvent is one of {
    PrescriptionContext.Prescription.PrescriptionReceived,
    PrescriptionContext.Prescription.PrescriptionVerified,
    PrescriptionContext.Prescription.RefillRequested,
    PrescriptionContext.Prescription.RefillApproved,
    PrescriptionContext.Prescription.PrescriptionOnHold,
    PrescriptionContext.Prescription.HoldReleased,
    PrescriptionContext.Prescription.PrescriptionTransferred,
    PrescriptionContext.Prescription.PrescriptionSuspended
  } with {
    briefly "Prescription event alternation"
    described as {
      |Union of all Prescription events, for streaming and event-sourced
      |persistence.
    }
  }
  processor PrescriptionEventSource as source is {
    outlet PrescriptionEvents is type PrescriptionEvent
    handler PrescriptionSourceHandler is {
      on event Prescription.PrescriptionReceived is {
        send event Prescription.PrescriptionReceived to outlet PrescriptionEvents
      }
      on event Prescription.PrescriptionVerified is {
        send event Prescription.PrescriptionVerified to outlet PrescriptionEvents
      }
      on event Prescription.RefillRequested is {
        send event Prescription.RefillRequested to outlet PrescriptionEvents
      }
      on event Prescription.RefillApproved is {
        send event Prescription.RefillApproved to outlet PrescriptionEvents
      }
      on event Prescription.PrescriptionOnHold is {
        send event Prescription.PrescriptionOnHold to outlet PrescriptionEvents
      }
      on event Prescription.HoldReleased is {
        send event Prescription.HoldReleased to outlet PrescriptionEvents
      }
      on event Prescription.PrescriptionTransferred is {
        send event Prescription.PrescriptionTransferred to outlet PrescriptionEvents
      }
      on event Prescription.PrescriptionSuspended is {
        send event Prescription.PrescriptionSuspended to outlet PrescriptionEvents
      }
      on other is {
        error "Unexpected message for source PrescriptionEventSource"
      }
    } with {
      briefly "Prescription source handler"
      described as {
        |Publishes Prescription events onto the outlet.
      }
    }
  } with {
    briefly "Prescription event source"
    described as {
      |Publishes Prescription entity events into the streaming topology.
    }
  }
  processor PrescriptionEventSink as sink is {
    inlet PrescriptionInlet is type PrescriptionEvent
    handler PrescriptionSinkHandler is {
      on event Prescription.PrescriptionReceived is {
        tell event Prescription.PrescriptionReceived to repository PrescriptionContext.PrescriptionRepository
      }
      on event Prescription.PrescriptionVerified is {
        tell event Prescription.PrescriptionVerified to repository PrescriptionContext.PrescriptionRepository
      }
      on event Prescription.RefillRequested is {
        tell event Prescription.RefillRequested to repository PrescriptionContext.PrescriptionRepository
      }
      on event Prescription.RefillApproved is {
        tell event Prescription.RefillApproved to repository PrescriptionContext.PrescriptionRepository
      }
      on event Prescription.PrescriptionOnHold is {
        tell event Prescription.PrescriptionOnHold to repository PrescriptionContext.PrescriptionRepository
      }
      on event Prescription.HoldReleased is {
        tell event Prescription.HoldReleased to repository PrescriptionContext.PrescriptionRepository
      }
      on event Prescription.PrescriptionTransferred is {
        tell event Prescription.PrescriptionTransferred to repository PrescriptionContext.PrescriptionRepository
      }
      on event Prescription.PrescriptionSuspended is {
        tell event Prescription.PrescriptionSuspended to repository PrescriptionContext.PrescriptionRepository
      }
      on other is {
        error "Unexpected message for sink PrescriptionEventSink"
      }
    } with {
      briefly "Prescription sink handler"
      described as {
        |Persists Prescription events via the repository.
      }
    }
  } with {
    briefly "Prescription event sink"
    described as {
      |Receives Prescription events for persistence.
    }
  }
  connector PrescriptionEventFlow is {
    from outlet PrescriptionContext.PrescriptionEventSource.PrescriptionEvents to
      inlet PrescriptionContext.PrescriptionEventSink.PrescriptionInlet
  } with {
    briefly "Prescription event flow"
    described as {
      |Connects the Prescription source to its sink.
    }
  }
  processor PrescriptionEventSplit is {
    inlet PrescriptionEventSplitIn is type PrescriptionEvent
    outlet PrescriptionEventSplitToPrescriptionRepository is type PrescriptionEvent
    outlet PrescriptionEventSplitToRefillRateProjector is type PrescriptionEvent
    outlet PrescriptionEventSplitToTransferMetricsProjector is type PrescriptionEvent
    outlet PrescriptionEventSplitToHoldAnalysisProjector is type PrescriptionEvent
    handler PrescriptionEventSplitHandler is {
      on event Prescription.PrescriptionReceived is {
        send event Prescription.PrescriptionReceived to outlet PrescriptionEventSplitToPrescriptionRepository
        send event Prescription.PrescriptionReceived to outlet PrescriptionEventSplitToRefillRateProjector
        send event Prescription.PrescriptionReceived to outlet PrescriptionEventSplitToTransferMetricsProjector
        send event Prescription.PrescriptionReceived to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell event Prescription.PrescriptionReceived to entity PrescriptionContext.Prescription
      }
      on event Prescription.PrescriptionVerified is {
        send event Prescription.PrescriptionVerified to outlet PrescriptionEventSplitToPrescriptionRepository
        send event Prescription.PrescriptionVerified to outlet PrescriptionEventSplitToRefillRateProjector
        send event Prescription.PrescriptionVerified to outlet PrescriptionEventSplitToTransferMetricsProjector
        send event Prescription.PrescriptionVerified to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell event Prescription.PrescriptionVerified to entity PrescriptionContext.Prescription
      }
      on event Prescription.RefillRequested is {
        send event Prescription.RefillRequested to outlet PrescriptionEventSplitToPrescriptionRepository
        send event Prescription.RefillRequested to outlet PrescriptionEventSplitToRefillRateProjector
        send event Prescription.RefillRequested to outlet PrescriptionEventSplitToTransferMetricsProjector
        send event Prescription.RefillRequested to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell event Prescription.RefillRequested to entity PrescriptionContext.Prescription
      }
      on event Prescription.RefillApproved is {
        send event Prescription.RefillApproved to outlet PrescriptionEventSplitToPrescriptionRepository
        send event Prescription.RefillApproved to outlet PrescriptionEventSplitToRefillRateProjector
        send event Prescription.RefillApproved to outlet PrescriptionEventSplitToTransferMetricsProjector
        send event Prescription.RefillApproved to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell event Prescription.RefillApproved to entity PrescriptionContext.Prescription
      }
      on event Prescription.PrescriptionOnHold is {
        send event Prescription.PrescriptionOnHold to outlet PrescriptionEventSplitToPrescriptionRepository
        send event Prescription.PrescriptionOnHold to outlet PrescriptionEventSplitToRefillRateProjector
        send event Prescription.PrescriptionOnHold to outlet PrescriptionEventSplitToTransferMetricsProjector
        send event Prescription.PrescriptionOnHold to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell event Prescription.PrescriptionOnHold to entity PrescriptionContext.Prescription
      }
      on event Prescription.HoldReleased is {
        send event Prescription.HoldReleased to outlet PrescriptionEventSplitToPrescriptionRepository
        send event Prescription.HoldReleased to outlet PrescriptionEventSplitToRefillRateProjector
        send event Prescription.HoldReleased to outlet PrescriptionEventSplitToTransferMetricsProjector
        send event Prescription.HoldReleased to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell event Prescription.HoldReleased to entity PrescriptionContext.Prescription
      }
      on event Prescription.PrescriptionTransferred is {
        send event Prescription.PrescriptionTransferred to outlet PrescriptionEventSplitToPrescriptionRepository
        send event Prescription.PrescriptionTransferred to outlet PrescriptionEventSplitToRefillRateProjector
        send event Prescription.PrescriptionTransferred to outlet PrescriptionEventSplitToTransferMetricsProjector
        send event Prescription.PrescriptionTransferred to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell event Prescription.PrescriptionTransferred to entity PrescriptionContext.Prescription
      }
      on event Prescription.PrescriptionSuspended is {
        send event Prescription.PrescriptionSuspended to outlet PrescriptionEventSplitToPrescriptionRepository
        send event Prescription.PrescriptionSuspended to outlet PrescriptionEventSplitToRefillRateProjector
        send event Prescription.PrescriptionSuspended to outlet PrescriptionEventSplitToTransferMetricsProjector
        send event Prescription.PrescriptionSuspended to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell event Prescription.PrescriptionSuspended to entity PrescriptionContext.Prescription
      }
      on other is {
        error "Unexpected message for processor PrescriptionEventSplit"
      }
    } with {
      briefly "Prescription event fan-out handler"
      described as {
        |Delivers each Prescription event to all of its consumers.
      }
    }
  } with {
    briefly "Prescription event fan-out"
    described as {
      |Fans Prescription events out to the repository and projectors.
    }
  }
  connector LinkPrescriptionToPrescriptionEventSplit is {
    from outlet PrescriptionContext.Prescription.PrescriptionEvents2 to
      inlet PrescriptionContext.PrescriptionEventSplit.PrescriptionEventSplitIn
  } with {
    briefly "LinkPrescriptionToPrescriptionEventSplit"
  }
  connector LinkPrescriptionEventSplitToPrescriptionRepository is {
    from outlet PrescriptionContext.PrescriptionEventSplit.PrescriptionEventSplitToPrescriptionRepository to
      inlet PrescriptionContext.PrescriptionRepository.PrescriptionRepositoryFromPrescription
  } with {
    briefly "LinkPrescriptionEventSplitToPrescriptionRepository"
  }
  connector LinkPrescriptionEventSplitToRefillRateProjector is {
    from outlet PrescriptionContext.PrescriptionEventSplit.PrescriptionEventSplitToRefillRateProjector to
      inlet PrescriptionContext.RefillRateProjector.RefillRateProjectorFromPrescription
  } with {
    briefly "LinkPrescriptionEventSplitToRefillRateProjector"
  }
  connector LinkPrescriptionEventSplitToTransferMetricsProjector is {
    from outlet PrescriptionContext.PrescriptionEventSplit.PrescriptionEventSplitToTransferMetricsProjector to
      inlet PrescriptionContext.TransferMetricsProjector.TransferMetricsProjectorFromPrescription
  } with {
    briefly "LinkPrescriptionEventSplitToTransferMetricsProjector"
  }
  connector LinkPrescriptionEventSplitToHoldAnalysisProjector is {
    from outlet PrescriptionContext.PrescriptionEventSplit.PrescriptionEventSplitToHoldAnalysisProjector to
      inlet PrescriptionContext.HoldAnalysisProjector.HoldAnalysisProjectorFromPrescription
  } with {
    briefly "LinkPrescriptionEventSplitToHoldAnalysisProjector"
  }
  connector LinkRefillRateProjectorToPrescriptionRepository is {
    from outlet PrescriptionContext.RefillRateProjector.RefillRateProjectorOut to
      inlet PrescriptionContext.PrescriptionRepository.PrescriptionRepositoryFromRefillRateProjector
  } with {
    briefly "LinkRefillRateProjectorToPrescriptionRepository"
  }
  connector LinkTransferMetricsProjectorToPrescriptionRepository is {
    from outlet PrescriptionContext.TransferMetricsProjector.TransferMetricsProjectorOut to
      inlet PrescriptionContext.PrescriptionRepository.PrescriptionRepositoryFromTransferMetricsProjector
  } with {
    briefly "LinkTransferMetricsProjectorToPrescriptionRepository"
  }
  connector LinkHoldAnalysisProjectorToPrescriptionRepository is {
    from outlet PrescriptionContext.HoldAnalysisProjector.HoldAnalysisProjectorOut to
      inlet PrescriptionContext.PrescriptionRepository.PrescriptionRepositoryFromHoldAnalysisProjector
  } with {
    briefly "LinkHoldAnalysisProjectorToPrescriptionRepository"
  }
} with {
  briefly "Prescription Management context"
  described as {
    | The PrescriptionContext is the primary bounded context for pharmacy
    | prescription management, including entities, repository, and projections.
  }
}
