// Prescription Management - Bounded Context
context PrescriptionContext as router is {
  inlet PrescriptionCommandStreamIn is type PrescriptionCommand  outlet PrescriptionCommandStreamOut is type PrescriptionCommand
  inlet PrescriptionQueryResultStreaIn is type Prescription.PrescriptionQueryResult  outlet PrescriptionQueryResultStreaOut is type Prescription.PrescriptionQueryResult
  handler PrescriptionContextBoundary is {
    on receivePrescription: command Prescription.ReceivePrescription is {
      send receivePrescription to outlet PrescriptionContext.PrescriptionCommandStreamOut
    }
    on verifyPrescription: command Prescription.VerifyPrescription is {
      send verifyPrescription to outlet PrescriptionContext.PrescriptionCommandStreamOut
    }
    on requestRefill: command Prescription.RequestRefill is {
      send requestRefill to outlet PrescriptionContext.PrescriptionCommandStreamOut
    }
    on approveRefill: command Prescription.ApproveRefill is {
      send approveRefill to outlet PrescriptionContext.PrescriptionCommandStreamOut
    }
    on placeOnHold: command Prescription.PlaceOnHold is {
      send placeOnHold to outlet PrescriptionContext.PrescriptionCommandStreamOut
    }
    on releaseHold: command Prescription.ReleaseHold is {
      send releaseHold to outlet PrescriptionContext.PrescriptionCommandStreamOut
    }
    on transferPrescription: command Prescription.TransferPrescription is {
      send transferPrescription to outlet PrescriptionContext.PrescriptionCommandStreamOut
    }
    on suspendPrescription: command Prescription.SuspendPrescription is {
      send suspendPrescription to outlet PrescriptionContext.PrescriptionCommandStreamOut
    }
    on prescriptionQueryResult: result Prescription.PrescriptionQueryResult is {
      send prescriptionQueryResult to outlet PrescriptionContext.PrescriptionQueryResultStreaOut
    }
    on other is {
      error "Unexpected message at the PrescriptionContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PrescriptionCommand Stream Intake' is from outlet PrescriptionContext.PrescriptionCommandStreamOut to inlet PrescriptionContext.Prescription.PrescriptionCommands  connector 'PrescriptionQueryResult Stream Egress' is from outlet PrescriptionContext.PrescriptionRepository.PrescriptionRepositoryResponses to inlet PrescriptionContext.PrescriptionQueryResultStreaIn  adaptor FromEPrescribingNetwork from context EPrescribingNetwork is { 
    handler FromEPrescribingNetworkHandler is {
      on event EPrescribingNetwork.NewPrescriptionReceived is {
        do "the model receives new prescription received"
      }
      on event EPrescribingNetwork.TransferCompleted is {
        do "the model receives transfer completed"
      }
      on other is {
        error "Unexpected message for adaptor FromEPrescribingNetwork"
      }
    } with {
      briefly "from e prescribing network"
      described as {
        |Carries messages from the external EPrescribingNetwork.
      }
    }
  } with {
    briefly "EPrescribingNetwork integration"
    described as {
      |The model's side of the EPrescribingNetwork conversation.
    }
  }
  adaptor FromInsuranceAdjudication from context InsuranceAdjudication is { 
    handler FromInsuranceAdjudicationHandler is {
      on event InsuranceAdjudication.ClaimAdjudicated is {
        do "the model receives claim adjudicated"
      }
      on event InsuranceAdjudication.PriorAuthDecided is {
        do "the model receives prior auth decided"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceAdjudication"
      }
    } with {
      briefly "from insurance adjudication"
      described as {
        |Carries messages from the external InsuranceAdjudication.
      }
    }
  } with {
    briefly "InsuranceAdjudication integration"
    described as {
      |The model's side of the InsuranceAdjudication conversation.
    }
  }
  adaptor FromPrescriberVerification from context PrescriberVerification is { 
    handler FromPrescriberVerificationHandler is {
      on event PrescriberVerification.PrescriberVerified is {
        do "the model receives prescriber verified"
      }
      on event PrescriberVerification.VerificationFailed is {
        do "the model receives verification failed"
      }
      on other is {
        error "Unexpected message for adaptor FromPrescriberVerification"
      }
    } with {
      briefly "from prescriber verification"
      described as {
        |Carries messages from the external PrescriberVerification.
      }
    }
  } with {
    briefly "PrescriberVerification integration"
    described as {
      |The model's side of the PrescriberVerification conversation.
    }
  }
  include "types.riddl"
  include "Prescription.riddl"
  // ───────────────────────────────────────────────────────────────────────────
  // Repository
  // ───────────────────────────────────────────────────────────────────────────
  type PrescriptionRepositoryCommand is one of {
    PrescriptionContext.PrescriptionRepository.PersistHoldReleased or PrescriptionContext.PrescriptionRepository.PersistPrescriptionOnHold or PrescriptionContext.PrescriptionRepository.PersistPrescriptionReceived or PrescriptionContext.PrescriptionRepository.PersistPrescriptionSuspended or PrescriptionContext.PrescriptionRepository.PersistPrescriptionTransferred or PrescriptionContext.PrescriptionRepository.PersistPrescriptionVerified or PrescriptionContext.PrescriptionRepository.PersistRefillApproved or PrescriptionContext.PrescriptionRepository.PersistRefillRequested
  } with {
    briefly "Anything that writes PrescriptionRepository"
    described as {
      |The persistence commands PrescriptionRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository PrescriptionRepository as flow is {
    inlet PrescriptionRepositoryFromRefillRateProjector is type PrescriptionRepositoryCommand
    command PersistPrescriptionReceived is  {
      prescriptionId: PrescriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row PrescriptionReceived applies to.
        }
      }
    } with {
      briefly "Persist PrescriptionReceived"
      described as {
        |Instructs this repository to apply PrescriptionReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPrescriptionSuspended is  {
      prescriptionId: PrescriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row PrescriptionSuspended applies to.
        }
      }
    } with {
      briefly "Persist PrescriptionSuspended"
      described as {
        |Instructs this repository to apply PrescriptionSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPrescriptionVerified is  {
      prescriptionId: PrescriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row PrescriptionVerified applies to.
        }
      }
    } with {
      briefly "Persist PrescriptionVerified"
      described as {
        |Instructs this repository to apply PrescriptionVerified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHoldReleased is  {
      prescriptionId: PrescriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row HoldReleased applies to.
        }
      }
    } with {
      briefly "Persist HoldReleased"
      described as {
        |Instructs this repository to apply HoldReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPrescriptionOnHold is  {
      prescriptionId: PrescriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row PrescriptionOnHold applies to.
        }
      }
    } with {
      briefly "Persist PrescriptionOnHold"
      described as {
        |Instructs this repository to apply PrescriptionOnHold to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPrescriptionTransferred is  {
      prescriptionId: PrescriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row PrescriptionTransferred applies to.
        }
      }
    } with {
      briefly "Persist PrescriptionTransferred"
      described as {
        |Instructs this repository to apply PrescriptionTransferred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRefillApproved is  {
      prescriptionId: PrescriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row RefillApproved applies to.
        }
      }
    } with {
      briefly "Persist RefillApproved"
      described as {
        |Instructs this repository to apply RefillApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRefillRequested is  {
      prescriptionId: PrescriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row RefillRequested applies to.
        }
      }
    } with {
      briefly "Persist RefillRequested"
      described as {
        |Instructs this repository to apply RefillRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredPrescription is  {
      prescriptionId: PrescriptionId with {
        briefly "prescriptionId"
        described as {
          |The prescriptionId column of the stored prescription row.
        }
      }
    } with {
      briefly "Stored prescription row"
      described as {
        |The persistence shape of prescription data as this repository stores it.
      }
    }
    schema PrescriptionData is relational
      of prescriptions as type StoredPrescription
        index on field StoredPrescription.prescriptionId
 with {
      briefly "Prescription data schema"
      described as {
        |The relational schema persisting prescription records for this repository.
      }
    }
    outlet PrescriptionRepositoryResponses is type Prescription.PrescriptionQueryResult
    // Prescription queries
    query FindPrescriptionById replies result PrescriptionResult is  {
      prescriptionId: PrescriptionId with {
        briefly "ID"
        described as {
          |Prescription identifier.
        }
      }
    } with {
      briefly "Find prescription by ID"
      described as {
        |Retrieves the complete prescription record.
      }
    }
    query FindPrescriptionsByPatient replies result PrescriptionListResult is  {
      patientId: PatientId with {
        briefly "Patient"
        described as {
          |Patient identifier.
        }
      }
      includeInactive: Boolean with {
        briefly "Inactive"
        described as {
          |Include inactive.
        }
      }
      limit: Integer with {
        briefly "Limit"
        described as {
          |Max results.
        }
      }
      offset: Integer with {
        briefly "Offset"
        described as {
          |Result offset.
        }
      }
    } with {
      briefly "Find prescriptions for a patient"
      described as {
        |Retrieves prescriptions for a patient.
      }
    }
    query FindPrescriptionsByPrescriber replies result PrescriptionListResult is  {
      prescriberId: PrescriberId with {
        briefly "Prescriber"
        described as {
          |Prescriber identifier.
        }
      }
      startDate: Date with {
        briefly "Start"
        described as {
          |Start date.
        }
      }
      endDate: Date with {
        briefly "End"
        described as {
          |End date.
        }
      }
      limit: Integer with {
        briefly "Limit"
        described as {
          |Max results.
        }
      }
    } with {
      briefly "Find prescriptions by prescriber"
      described as {
        |Retrieves prescriptions written by a prescriber.
      }
    }
    query FindPrescriptionsByStatus replies result PrescriptionListResult is  {
      status: RxStatus with {
        briefly "Status"
        described as {
          |Prescription status.
        }
      }
      pharmacyId: PharmacyId with {
        briefly "Pharmacy"
        described as {
          |Pharmacy identifier.
        }
      }
      limit: Integer with {
        briefly "Limit"
        described as {
          |Max results.
        }
      }
    } with {
      briefly "Find prescriptions by status"
      described as {
        |Retrieves prescriptions in a specific status.
      }
    }
    query FindPrescriptionsOnHold replies result PrescriptionListResult is  {
      pharmacyId: PharmacyId with {
        briefly "Pharmacy"
        described as {
          |Pharmacy identifier.
        }
      }
      holdReason: HoldReason? with {
        briefly "Reason"
        described as {
          |Hold reason filter.
        }
      }
      olderThanDays: Integer? with {
        briefly "Days"
        described as {
          |Age threshold.
        }
      }
    } with {
      briefly "Find prescriptions on hold"
      described as {
        |Retrieves held prescriptions for resolution.
      }
    }
    query FindExpiringPrescriptions replies result PrescriptionListResult is  {
      pharmacyId: PharmacyId with {
        briefly "Pharmacy"
        described as {
          |Pharmacy identifier.
        }
      }
      expiresWithinDays: Integer with {
        briefly "Days"
        described as {
          |Expiration window.
        }
      }
    } with {
      briefly "Find expiring prescriptions"
      described as {
        |Identifies prescriptions nearing expiration.
      }
    }
    query GetRefillHistory replies result RefillHistoryResult is  {
      prescriptionId: PrescriptionId with {
        briefly "ID"
        described as {
          |Prescription identifier.
        }
      }
    } with {
      briefly "Get refill history"
      described as {
        |Retrieves all refill records for a prescription.
      }
    }
    query FindRefillsDue replies result RefillsDueResult is  {
      patientId: PatientId with {
        briefly "Patient"
        described as {
          |Patient identifier.
        }
      }
      daysUntilDue: Integer with {
        briefly "Days"
        described as {
          |Days until due.
        }
      }
    } with {
      briefly "Find prescriptions due for refill"
      described as {
        |Identifies prescriptions due for refill.
      }
    }
    // Query results
    result PrescriptionResult is  {
      prescription: PrescriptionRecord? with {
        briefly "Prescription"
        described as {
          |Prescription result.
        }
      }
    } with {
      briefly "Single prescription result"
      described as {
        |Returns the requested prescription or empty.
      }
    }
    result PrescriptionListResult is  {
      prescriptions: PrescriptionRecord+ with {
        briefly "Prescriptions"
        described as {
          |Matching prescriptions.
        }
      }
      totalCount: Integer with {
        briefly "Total"
        described as {
          |Total count.
        }
      }
      hasMore: Boolean with {
        briefly "More"
        described as {
          |Has more results.
        }
      }
    } with {
      briefly "Paginated prescription list"
      described as {
        |Returns matching prescriptions with pagination.
      }
    }
    result RefillHistoryResult is  {
      prescriptionId: PrescriptionId with {
        briefly "ID"
        described as {
          |Prescription identifier.
        }
      }
      refills: RefillInfo+ with {
        briefly "Refills"
        described as {
          |Refill records.
        }
      }
    } with {
      briefly "Refill history result"
      described as {
        |Returns all refill records.
      }
    }
    result RefillsDueResult is  {
      prescriptions: PrescriptionRecord+ with {
        briefly "Prescriptions"
        described as {
          |Prescriptions due.
        }
      }
      estimatedRefillDates: Date+ with {
        briefly "Dates"
        described as {
          |Estimated refill dates.
        }
      }
    } with {
      briefly "Prescriptions due for refill"
      described as {
        |Returns prescriptions due for refill.
      }
    }
    handler RepositoryHandler is {
      on persistPrescriptionReceived: command PersistPrescriptionReceived is {
        do "apply PrescriptionReceived to the stored row"
      }
      on persistPrescriptionSuspended: command PersistPrescriptionSuspended is {
        do "apply PrescriptionSuspended to the stored row"
      }
      on persistPrescriptionVerified: command PersistPrescriptionVerified is {
        do "apply PrescriptionVerified to the stored row"
      }
      on persistHoldReleased: command PersistHoldReleased is {
        do "apply HoldReleased to the stored row"
      }
      on persistPrescriptionOnHold: command PersistPrescriptionOnHold is {
        do "apply PrescriptionOnHold to the stored row"
      }
      on persistPrescriptionTransferred: command PersistPrescriptionTransferred is {
        do "apply PrescriptionTransferred to the stored row"
      }
      on persistRefillApproved: command PersistRefillApproved is {
        do "apply RefillApproved to the stored row"
      }
      on persistRefillRequested: command PersistRefillRequested is {
        do "apply RefillRequested to the stored row"
      }
      on query GetRefillRateMetrics is {
        let refillRateMetricsView: type RefillRateMetricsView = prompt("read the refill rate metrics projection")
        reply refillRateMetricsView
      }
      on query GetTransferMetrics is {
        let transferMetricsView: type TransferMetricsView = prompt("read the transfer metrics projection")
        reply transferMetricsView
      }
      on query GetHoldAnalysisMetrics is {
        let holdAnalysisMetricsView: type HoldAnalysisMetricsView = prompt("read the hold analysis metrics projection")
        reply holdAnalysisMetricsView
      }
      on query FindPrescriptionById is {
        let prescriptionResult: type PrescriptionResult = prompt("read the prescription from the store")
        reply prescriptionResult
      }
      on query FindPrescriptionsByPatient is {
        let prescriptionListResult: type PrescriptionListResult = prompt("read the prescription list that prescriptions by patient asks for")
        reply prescriptionListResult
      }
      on query FindPrescriptionsByPrescriber is {
        let prescriptionListResult: type PrescriptionListResult = prompt("read the prescription list that prescriptions by prescriber asks for")
        reply prescriptionListResult
      }
      on query FindPrescriptionsByStatus is {
        let prescriptionListResult: type PrescriptionListResult = prompt("read the prescription list that prescriptions by status asks for")
        reply prescriptionListResult
      }
      on query FindPrescriptionsOnHold is {
        let prescriptionListResult: type PrescriptionListResult = prompt("read the prescription list that prescriptions on hold asks for")
        reply prescriptionListResult
      }
      on query FindExpiringPrescriptions is {
        let prescriptionListResult: type PrescriptionListResult = prompt("read the prescription list that expiring prescriptions asks for")
        reply prescriptionListResult
      }
      on getRefillHistory: query GetRefillHistory is {
        reply result RefillHistoryResult(prescriptionId = getRefillHistory.prescriptionId, refills = prompt("the refills of this refill history result"))
      }
      on query FindRefillsDue is {
        let refillsDueResult: type RefillsDueResult = prompt("read the refills due from the store")
        reply refillsDueResult
      }
    } with {
      briefly "Repository query handler"
      described as {
        |Processes all prescription queries.
      }
    }
  } with {
    briefly "Prescription repository"
    described as {
      |Prescription and refill history persistence and queries.
    }
  }
  // ───────────────────────────────────────────────────────────────────────────
  // Projectors
  // ───────────────────────────────────────────────────────────────────────────
  query GetRefillRateMetrics replies result RefillRateMetricsView is  {
    refillRateMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which refill rate metrics to retrieve.
      }
    }
  } with {
    briefly "Get refill rate metrics"
    described as {
      |Retrieves the refill rate metrics projection.
    }
  }
  result RefillRateMetricsView is  {
    refillRateMetrics: RefillRateProjector.RefillRateMetrics with {
      briefly "Refill rate metrics"
      described as {
        |The refill rate metrics being returned.
      }
    }
  } with {
    briefly "Refill rate metrics view"
    described as {
      |Read model view carrying the refill rate metrics projection.
    }
  }
  projector RefillRateProjector as flow is {
    outlet RefillRateProjectorToRepository is type PrescriptionRepositoryCommand
    updates repository PrescriptionContext.PrescriptionRepository
    inlet RefillRateProjectorFromPrescription is type PrescriptionEvent
    record RefillRateMetrics is  {
      pharmacyId: PharmacyId with {
        briefly "Pharmacy"
        described as {
          |Pharmacy identifier.
        }
      }
      periodStart: Date with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Period end.
        }
      }
      totalPrescriptions: Integer with {
        briefly "Total"
        described as {
          |Total prescriptions.
        }
      }
      totalRefillsRequested: Integer with {
        briefly "Requested"
        described as {
          |Refills requested.
        }
      }
      totalRefillsApproved: Integer with {
        briefly "Approved"
        described as {
          |Refills approved.
        }
      }
      refillApprovalRate: Number with {
        briefly "Rate"
        described as {
          |Approval rate.
        }
      }
      averageRefillsPerRx: Number with {
        briefly "Average"
        described as {
          |Average refills per Rx.
        }
      }
      autoRefillCount: Integer with {
        briefly "Auto"
        described as {
          |Auto refill count.
        }
      }
      patientRequestCount: Integer with {
        briefly "Patient"
        described as {
          |Patient request count.
        }
      }
    } with {
      briefly "Refill rate metrics"
      described as {
        |Aggregated refill pattern metrics.
      }
    }
    handler RefillRateHandler is {
      on holdReleased: event Prescription.HoldReleased is {
        tell command PrescriptionContext.PrescriptionRepository.PersistHoldReleased(prescriptionId = holdReleased.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply HoldReleased to the RefillRateProjector projection"
      }
      on prescriptionOnHold: event Prescription.PrescriptionOnHold is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionOnHold(prescriptionId = prescriptionOnHold.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply PrescriptionOnHold to the RefillRateProjector projection"
      }
      on prescriptionReceived: event Prescription.PrescriptionReceived is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionReceived(prescriptionId = prescriptionReceived.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply PrescriptionReceived to the RefillRateProjector projection"
      }
      on prescriptionSuspended: event Prescription.PrescriptionSuspended is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionSuspended(prescriptionId = prescriptionSuspended.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply PrescriptionSuspended to the RefillRateProjector projection"
      }
      on prescriptionTransferred: event Prescription.PrescriptionTransferred is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionTransferred(prescriptionId = prescriptionTransferred.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply PrescriptionTransferred to the RefillRateProjector projection"
      }
      on prescriptionVerified: event Prescription.PrescriptionVerified is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionVerified(prescriptionId = prescriptionVerified.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply PrescriptionVerified to the RefillRateProjector projection"
      }
      on refillRequested: event Prescription.RefillRequested is {
        tell command PrescriptionContext.PrescriptionRepository.PersistRefillRequested(prescriptionId = refillRequested.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
      }
      on refillApproved: event Prescription.RefillApproved is {
        tell command PrescriptionContext.PrescriptionRepository.PersistRefillApproved(prescriptionId = refillApproved.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
      }
    } with {
      briefly "Refill rate handler"
      described as {
        |Updates refill rate metrics from events.
      }
    }
  } with {
    briefly "Refill rate analytics"
    described as {
      |Maintains read-optimized views of refill patterns.
    }
  }
  query GetTransferMetrics replies result TransferMetricsView is  {
    transferMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which transfer metrics to retrieve.
      }
    }
  } with {
    briefly "Get transfer metrics"
    described as {
      |Retrieves the transfer metrics projection.
    }
  }
  result TransferMetricsView is  {
    transferMetrics: TransferMetricsProjector.TransferMetrics with {
      briefly "Transfer metrics"
      described as {
        |The transfer metrics being returned.
      }
    }
  } with {
    briefly "Transfer metrics view"
    described as {
      |Read model view carrying the transfer metrics projection.
    }
  }
  projector TransferMetricsProjector as sink is {
    updates repository PrescriptionContext.PrescriptionRepository
    inlet TransferMetricsProjectorFromPrescription is type PrescriptionEvent
    record TransferReasonCount is  {
      transferReason: TransferReason with {
        briefly "Reason"
        described as {
          |Transfer reason.
        }
      }
      count: Integer with {
        briefly "Count"
        described as {
          |Transfer count.
        }
      }
    } with {
      briefly "Transfer count by reason"
      described as {
        |Breakdown of transfer volume by reason.
      }
    }
    record PharmacyTransferCount is  {
      pharmacyId: PharmacyId with {
        briefly "Pharmacy"
        described as {
          |Pharmacy identifier.
        }
      }
      pharmacyName: String with {
        briefly "Name"
        described as {
          |Pharmacy name.
        }
      }
      count: Integer with {
        briefly "Count"
        described as {
          |Transfer count.
        }
      }
    } with {
      briefly "Transfer count by pharmacy"
      described as {
        |Transfer volume with a specific pharmacy.
      }
    }
    record TransferMetrics is  {
      pharmacyId: PharmacyId with {
        briefly "Pharmacy"
        described as {
          |Pharmacy identifier.
        }
      }
      periodStart: Date with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Period end.
        }
      }
      transfersIn: Integer with {
        briefly "In"
        described as {
          |Transfers in.
        }
      }
      transfersOut: Integer with {
        briefly "Out"
        described as {
          |Transfers out.
        }
      }
      netTransfers: Integer with {
        briefly "Net"
        described as {
          |Net transfers.
        }
      }
      transfersByReason: TransferReasonCount+ with {
        briefly "By reason"
        described as {
          |Transfers by reason.
        }
      }
      topDestinations: PharmacyTransferCount+ with {
        briefly "Top"
        described as {
          |Top destinations.
        }
      }
      averageRefillsTransferred: Number with {
        briefly "Average"
        described as {
          |Average refills transferred.
        }
      }
    } with {
      briefly "Transfer metrics"
      described as {
        |Aggregated transfer pattern metrics.
      }
    }
    handler TransferMetricsHandler is {
      on holdReleased: event Prescription.HoldReleased is {
        tell command PrescriptionContext.PrescriptionRepository.PersistHoldReleased(prescriptionId = holdReleased.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply HoldReleased to the TransferMetricsProjector projection"
      }
      on prescriptionOnHold: event Prescription.PrescriptionOnHold is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionOnHold(prescriptionId = prescriptionOnHold.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply PrescriptionOnHold to the TransferMetricsProjector projection"
      }
      on prescriptionReceived: event Prescription.PrescriptionReceived is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionReceived(prescriptionId = prescriptionReceived.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply PrescriptionReceived to the TransferMetricsProjector projection"
      }
      on prescriptionSuspended: event Prescription.PrescriptionSuspended is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionSuspended(prescriptionId = prescriptionSuspended.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply PrescriptionSuspended to the TransferMetricsProjector projection"
      }
      on prescriptionVerified: event Prescription.PrescriptionVerified is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionVerified(prescriptionId = prescriptionVerified.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply PrescriptionVerified to the TransferMetricsProjector projection"
      }
      on refillApproved: event Prescription.RefillApproved is {
        tell command PrescriptionContext.PrescriptionRepository.PersistRefillApproved(prescriptionId = refillApproved.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply RefillApproved to the TransferMetricsProjector projection"
      }
      on refillRequested: event Prescription.RefillRequested is {
        tell command PrescriptionContext.PrescriptionRepository.PersistRefillRequested(prescriptionId = refillRequested.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply RefillRequested to the TransferMetricsProjector projection"
      }
      on prescriptionTransferred: event Prescription.PrescriptionTransferred is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionTransferred(prescriptionId = prescriptionTransferred.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
      }
    } with {
      briefly "Transfer metrics handler"
      described as {
        |Updates transfer metrics from events.
      }
    }
  } with {
    briefly "Transfer metrics analytics"
    described as {
      |Maintains read-optimized views of transfer patterns.
    }
  }
  query GetHoldAnalysisMetrics replies result HoldAnalysisMetricsView is  {
    holdAnalysisMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which hold analysis metrics to retrieve.
      }
    }
  } with {
    briefly "Get hold analysis metrics"
    described as {
      |Retrieves the hold analysis metrics projection.
    }
  }
  result HoldAnalysisMetricsView is  {
    holdAnalysisMetrics: HoldAnalysisProjector.HoldAnalysisMetrics with {
      briefly "Hold analysis metrics"
      described as {
        |The hold analysis metrics being returned.
      }
    }
  } with {
    briefly "Hold analysis metrics view"
    described as {
      |Read model view carrying the hold analysis metrics projection.
    }
  }
  projector HoldAnalysisProjector as sink is {
    updates repository PrescriptionContext.PrescriptionRepository
    inlet HoldAnalysisProjectorFromPrescription is type PrescriptionEvent
    record HoldReasonCount is  {
      holdReason: HoldReason with {
        briefly "Reason"
        described as {
          |Hold reason.
        }
      }
      count: Integer with {
        briefly "Count"
        described as {
          |Hold count.
        }
      }
      averageDuration: Duration with {
        briefly "Duration"
        described as {
          |Average duration.
        }
      }
    } with {
      briefly "Hold count by reason"
      described as {
        |Breakdown of hold volume and duration by reason.
      }
    }
    record HoldAnalysisMetrics is  {
      pharmacyId: PharmacyId with {
        briefly "Pharmacy"
        described as {
          |Pharmacy identifier.
        }
      }
      periodStart: Date with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Period end.
        }
      }
      totalHoldsPlaced: Integer with {
        briefly "Placed"
        described as {
          |Holds placed.
        }
      }
      totalHoldsReleased: Integer with {
        briefly "Released"
        described as {
          |Holds released.
        }
      }
      currentlyOnHold: Integer with {
        briefly "Current"
        described as {
          |Currently on hold.
        }
      }
      holdsByReason: HoldReasonCount+ with {
        briefly "By reason"
        described as {
          |Holds by reason.
        }
      }
      averageHoldDuration: Duration with {
        briefly "Duration"
        described as {
          |Average duration.
        }
      }
      holdsExceedingSLA: Integer with {
        briefly "Exceeding"
        described as {
          |Holds exceeding SLA.
        }
      }
    } with {
      briefly "Hold analysis metrics"
      described as {
        |Aggregated hold pattern metrics.
      }
    }
    handler HoldAnalysisHandler is {
      on prescriptionReceived: event Prescription.PrescriptionReceived is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionReceived(prescriptionId = prescriptionReceived.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply PrescriptionReceived to the HoldAnalysisProjector projection"
      }
      on prescriptionSuspended: event Prescription.PrescriptionSuspended is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionSuspended(prescriptionId = prescriptionSuspended.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply PrescriptionSuspended to the HoldAnalysisProjector projection"
      }
      on prescriptionTransferred: event Prescription.PrescriptionTransferred is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionTransferred(prescriptionId = prescriptionTransferred.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply PrescriptionTransferred to the HoldAnalysisProjector projection"
      }
      on prescriptionVerified: event Prescription.PrescriptionVerified is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionVerified(prescriptionId = prescriptionVerified.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply PrescriptionVerified to the HoldAnalysisProjector projection"
      }
      on refillApproved: event Prescription.RefillApproved is {
        tell command PrescriptionContext.PrescriptionRepository.PersistRefillApproved(prescriptionId = refillApproved.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply RefillApproved to the HoldAnalysisProjector projection"
      }
      on refillRequested: event Prescription.RefillRequested is {
        tell command PrescriptionContext.PrescriptionRepository.PersistRefillRequested(prescriptionId = refillRequested.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
        do "apply RefillRequested to the HoldAnalysisProjector projection"
      }
      on prescriptionOnHold: event Prescription.PrescriptionOnHold is {
        tell command PrescriptionContext.PrescriptionRepository.PersistPrescriptionOnHold(prescriptionId = prescriptionOnHold.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
      }
      on holdReleased: event Prescription.HoldReleased is {
        tell command PrescriptionContext.PrescriptionRepository.PersistHoldReleased(prescriptionId = holdReleased.prescriptionId) to repository PrescriptionContext.PrescriptionRepository
      }
    } with {
      briefly "Hold analysis handler"
      described as {
        |Updates hold metrics from events.
      }
    }
  } with {
    briefly "Hold analysis analytics"
    described as {
      |Maintains read-optimized views of hold patterns.
    }
  }
  // ---- Event publication for Prescription ----
  type PrescriptionEvent is one of {
    PrescriptionContext.Prescription.PrescriptionReceived or PrescriptionContext.Prescription.PrescriptionVerified or PrescriptionContext.Prescription.RefillRequested or PrescriptionContext.Prescription.RefillApproved or PrescriptionContext.Prescription.PrescriptionOnHold or PrescriptionContext.Prescription.HoldReleased or PrescriptionContext.Prescription.PrescriptionTransferred or PrescriptionContext.Prescription.PrescriptionSuspended
  } with {
    briefly "Prescription event alternation"
    described as {
      |Union of all Prescription events, for streaming and event-sourced
      |persistence.
    }
  }
  processor PrescriptionEventSplit as split is {
    inlet PrescriptionEventSplitIn is type PrescriptionEvent
    outlet PrescriptionEventSplitToRefillRateProjector is type PrescriptionEvent
    outlet PrescriptionEventSplitToTransferMetricsProjector is type PrescriptionEvent
    outlet PrescriptionEventSplitToHoldAnalysisProjector is type PrescriptionEvent
    handler PrescriptionEventSplitHandler is {
      on prescriptionReceived: event Prescription.PrescriptionReceived is {
        send prescriptionReceived to outlet PrescriptionEventSplitToRefillRateProjector
        send prescriptionReceived to outlet PrescriptionEventSplitToTransferMetricsProjector
        send prescriptionReceived to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell prescriptionReceived to entity PrescriptionContext.Prescription
      }
      on prescriptionVerified: event Prescription.PrescriptionVerified is {
        send prescriptionVerified to outlet PrescriptionEventSplitToRefillRateProjector
        send prescriptionVerified to outlet PrescriptionEventSplitToTransferMetricsProjector
        send prescriptionVerified to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell prescriptionVerified to entity PrescriptionContext.Prescription
      }
      on refillRequested: event Prescription.RefillRequested is {
        send refillRequested to outlet PrescriptionEventSplitToRefillRateProjector
        send refillRequested to outlet PrescriptionEventSplitToTransferMetricsProjector
        send refillRequested to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell refillRequested to entity PrescriptionContext.Prescription
      }
      on refillApproved: event Prescription.RefillApproved is {
        send refillApproved to outlet PrescriptionEventSplitToRefillRateProjector
        send refillApproved to outlet PrescriptionEventSplitToTransferMetricsProjector
        send refillApproved to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell refillApproved to entity PrescriptionContext.Prescription
      }
      on prescriptionOnHold: event Prescription.PrescriptionOnHold is {
        send prescriptionOnHold to outlet PrescriptionEventSplitToRefillRateProjector
        send prescriptionOnHold to outlet PrescriptionEventSplitToTransferMetricsProjector
        send prescriptionOnHold to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell prescriptionOnHold to entity PrescriptionContext.Prescription
      }
      on holdReleased: event Prescription.HoldReleased is {
        send holdReleased to outlet PrescriptionEventSplitToRefillRateProjector
        send holdReleased to outlet PrescriptionEventSplitToTransferMetricsProjector
        send holdReleased to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell holdReleased to entity PrescriptionContext.Prescription
      }
      on prescriptionTransferred: event Prescription.PrescriptionTransferred is {
        send prescriptionTransferred to outlet PrescriptionEventSplitToRefillRateProjector
        send prescriptionTransferred to outlet PrescriptionEventSplitToTransferMetricsProjector
        send prescriptionTransferred to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell prescriptionTransferred to entity PrescriptionContext.Prescription
      }
      on prescriptionSuspended: event Prescription.PrescriptionSuspended is {
        send prescriptionSuspended to outlet PrescriptionEventSplitToRefillRateProjector
        send prescriptionSuspended to outlet PrescriptionEventSplitToTransferMetricsProjector
        send prescriptionSuspended to outlet PrescriptionEventSplitToHoldAnalysisProjector
        tell prescriptionSuspended to entity PrescriptionContext.Prescription
      }
      on other is {
        error "Unexpected message for processor PrescriptionEventSplit"
      }
    } with {
      briefly "Prescription event fan-out handler"
      described as {
        |Delivers each Prescription event to all of its consumers.
      }
    }
  } with {
    briefly "Prescription event fan-out"
    described as {
      |Fans Prescription events out to the repository and projectors.
    }
  }
  connector 'PrescriptionEvent Stream' is from outlet PrescriptionContext.Prescription.PrescriptionEvents2 to inlet PrescriptionContext.PrescriptionEventSplit.PrescriptionEventSplitIn with {
    briefly "Prescription events, fanned out to storage and read models"
  }
  connector 'RefillRateProjector Feed' is from outlet PrescriptionContext.PrescriptionEventSplit.PrescriptionEventSplitToRefillRateProjector to inlet PrescriptionContext.RefillRateProjector.RefillRateProjectorFromPrescription with {
    briefly "Prescription events feeding the RefillRateProjector projection"
  }
  connector 'TransferMetricsProjector Feed' is from outlet PrescriptionContext.PrescriptionEventSplit.PrescriptionEventSplitToTransferMetricsProjector to inlet PrescriptionContext.TransferMetricsProjector.TransferMetricsProjectorFromPrescription with {
    briefly "Prescription events feeding the TransferMetricsProjector projection"
  }
  connector 'HoldAnalysisProjector Feed' is from outlet PrescriptionContext.PrescriptionEventSplit.PrescriptionEventSplitToHoldAnalysisProjector to inlet PrescriptionContext.HoldAnalysisProjector.HoldAnalysisProjectorFromPrescription with {
    briefly "Prescription events feeding the HoldAnalysisProjector projection"
  }
  connector 'RefillRateProjector Storage' is from outlet PrescriptionContext.RefillRateProjector.RefillRateProjectorToRepository to inlet PrescriptionContext.PrescriptionRepository.PrescriptionRepositoryFromRefillRateProjector with {
    briefly "RefillRateProjector updates on their way to storage"
  }
} with {
  briefly "Prescription Management context"
  described as {
    | The PrescriptionContext is the primary bounded context for pharmacy
    | prescription management, including entities, repository, and projections.
  }
}
