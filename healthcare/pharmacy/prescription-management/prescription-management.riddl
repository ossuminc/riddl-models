// Prescription Management Domain Model
// Healthcare / Pharmacy / Prescription Management
// // This domain model covers the complete lifecycle of prescription management
// in a pharmacy setting, including intake, verification, filling, refills,
// holds, and transfers.
domain PrescriptionManagement is {
  // ───────────────────────────────────────────────────────────────────────────
  // Author
  // ───────────────────────────────────────────────────────────────────────────
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  // ───────────────────────────────────────────────────────────────────────────
  // Users
  // ───────────────────────────────────────────────────────────────────────────
  user Pharmacist is "a licensed pharmacist responsible for prescription
    verification, clinical review, and dispensing oversight" with {
    briefly "Licensed pharmacist"
    described as {
      |Healthcare professional licensed to dispense medications.
    }
  }
  user PharmacyTech is "a certified pharmacy technician who assists with
    prescription intake, filling, and customer service under pharmacist
    supervision" with {
    briefly "Pharmacy technician"
    described as {
      |Certified technician working under pharmacist supervision.
    }
  }
  user Prescriber is "a healthcare provider authorized to write prescriptions,
    including physicians, nurse practitioners, and physician assistants" with {
    briefly "Prescribing provider"
    described as {
      |Healthcare provider authorized to write prescriptions.
    }
  }
  user PatientUser is "a patient or their authorized representative who
    submits prescriptions, requests refills, and receives medications" with {
    briefly "Patient or representative"
    described as {
      |Patient or authorized representative receiving medications.
    }
  }
  // ───────────────────────────────────────────────────────────────────────────
  // Epic: Prescription Intake, Verification, and Refill Processing
  // ───────────────────────────────────────────────────────────────────────────
  epic PrescriptionIntakeAndProcessing is {
    user Pharmacist wants to "manage the complete prescription lifecycle" so that "patients receive safe and timely medications"
    // Use Case: New Prescription Intake
    case NewPrescriptionIntake is {
      user PharmacyTech wants to "receive and enter a new prescription into
        the system" so that "it can be queued for verification"
      step is "receive" "prescription" "from source" with {
        briefly "Receive"
        described as {
          |Receive prescription from any source.
        }
      }
      step take input PrescriptionManagementApp.PrescriptionManagementScreen.ReceivePrescriptionInput from user PharmacyTech with {
        briefly "Submit"
        described as {
          |Submit prescription to system.
        }
      }
      step is "create" "prescription record" "in received state" with {
        briefly "Create"
        described as {
          |Create prescription in received state.
        }
      }
    } with {
      briefly "Intake of new prescription"
      described as {
        |Covers initial receipt from e-prescribing, fax, phone, or walk-in.
      }
    }
    // Use Case: Pharmacist Verification
    case PharmacistVerification is {
      user Pharmacist wants to "verify a prescription is valid and safe" so that "it can be approved for filling"
      step is "review" "prescription" "for completeness" with {
        briefly "Review"
        described as {
          |Review prescription completeness.
        }
      }
      step is "perform" "DUR checks" "for safety" with {
        briefly "DUR"
        described as {
          |Perform Drug Utilization Review.
        }
      }
      step is "verify" "prescriber" "credentials" with {
        briefly "Verify"
        described as {
          |Verify prescriber credentials.
        }
      }
      step take input PrescriptionManagementApp.PrescriptionManagementScreen.VerifyPrescriptionInput from user Pharmacist with {
        briefly "Approve"
        described as {
          |Approve prescription for filling.
        }
      }
    } with {
      briefly "Clinical verification"
      described as {
        |Pharmacist review including DUR and prescriber verification.
      }
    }
    // Use Case: Refill Request
    case RefillRequest is {
      user PatientUser wants to "request a refill of my prescription" so that "I can continue my medication therapy"
      step is "submit" "refill request" "via any channel" with {
        briefly "Submit"
        described as {
          |Submit refill request.
        }
      }
      step take input PrescriptionManagementApp.PrescriptionManagementScreen.RequestRefillInput from user PatientUser with {
        briefly "Request"
        described as {
          |Request refill.
        }
      }
      step is "validate" "refills remaining" "and expiration" with {
        briefly "Validate"
        described as {
          |Validate refill eligibility.
        }
      }
      step take input PrescriptionManagementApp.PrescriptionManagementScreen.ApproveRefillInput from user Pharmacist with {
        briefly "Approve"
        described as {
          |Approve refill.
        }
      }
    } with {
      briefly "Patient refill request"
      described as {
        |Refill workflow with validation and approval.
      }
    }
    // Use Case: Place on Hold
    case PlaceOnHoldUseCase is {
      user Pharmacist wants to "place a prescription on hold when there is
        an issue" so that "the issue can be resolved before dispensing"
      step is "identify" "issue" "requiring hold" with {
        briefly "Identify"
        described as {
          |Identify issue requiring hold.
        }
      }
      step take input PrescriptionManagementApp.PrescriptionManagementScreen.PlaceOnHoldInput from user Pharmacist with {
        briefly "Hold"
        described as {
          |Place prescription on hold.
        }
      }
      step is "initiate" "resolution" "workflow" with {
        briefly "Resolve"
        described as {
          |Initiate resolution workflow.
        }
      }
    } with {
      briefly "Hold prescription"
      described as {
        |Hold prescription pending issue resolution.
      }
    }
    // Use Case: Release Hold
    case ReleaseHoldUseCase is {
      user Pharmacist wants to "release a hold after resolving the issue" so that "the prescription can proceed to filling"
      step is "verify" "issue" "is resolved" with {
        briefly "Verify"
        described as {
          |Verify issue resolution.
        }
      }
      step take input PrescriptionManagementApp.PrescriptionManagementScreen.ReleaseHoldInput from user Pharmacist with {
        briefly "Release"
        described as {
          |Release hold.
        }
      }
    } with {
      briefly "Release hold"
      described as {
        |Release prescription from hold after resolution.
      }
    }
    // Use Case: Transfer Prescription
    case TransferPrescriptionUseCase is {
      user PatientUser wants to "transfer my prescription to another pharmacy" so that "I can fill it at a more convenient location"
      step is "request" "transfer" "to pharmacy" with {
        briefly "Request"
        described as {
          |Request transfer.
        }
      }
      step is "verify" "transfer" "is allowed" with {
        briefly "Verify"
        described as {
          |Verify transfer is allowed.
        }
      }
      step take input PrescriptionManagementApp.PrescriptionManagementScreen.TransferPrescriptionInput from user Pharmacist with {
        briefly "Transfer"
        described as {
          |Transfer prescription.
        }
      }
    } with {
      briefly "Transfer prescription"
      described as {
        |Transfer prescription to another pharmacy.
      }
    }
  } with {
    briefly "Prescription intake and processing"
    described as {
      | This epic covers the primary prescription management workflows:
      | intake, verification, refills, holds, and transfers.
    }
  }
  // ───────────────────────────────────────────────────────────────────────────
  // Context Includes
  // ───────────────────────────────────────────────────────────────────────────
  include "PrescriptionContext.riddl"
  include "external-contexts.riddl"
  application context PrescriptionManagementApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PrescriptionManagement are delivered.
      }
    }
    group PrescriptionManagementScreen is {
      input ReceivePrescriptionInput acquires command PrescriptionContext.Prescription.ReceivePrescription with {
        briefly "Receive prescription control"
        described as {
          |The control through which a user submits the receive prescription request.
        }
      }
      input VerifyPrescriptionInput acquires command PrescriptionContext.Prescription.VerifyPrescription with {
        briefly "Verify prescription control"
        described as {
          |The control through which a user submits the verify prescription request.
        }
      }
      input RequestRefillInput acquires command PrescriptionContext.Prescription.RequestRefill with {
        briefly "Request refill control"
        described as {
          |The control through which a user submits the request refill request.
        }
      }
      input ApproveRefillInput acquires command PrescriptionContext.Prescription.ApproveRefill with {
        briefly "Approve refill control"
        described as {
          |The control through which a user submits the approve refill request.
        }
      }
      input PlaceOnHoldInput acquires command PrescriptionContext.Prescription.PlaceOnHold with {
        briefly "Place on hold control"
        described as {
          |The control through which a user submits the place on hold request.
        }
      }
      input ReleaseHoldInput acquires command PrescriptionContext.Prescription.ReleaseHold with {
        briefly "Release hold control"
        described as {
          |The control through which a user submits the release hold request.
        }
      }
      input TransferPrescriptionInput acquires command PrescriptionContext.Prescription.TransferPrescription with {
        briefly "Transfer prescription control"
        described as {
          |The control through which a user submits the transfer prescription request.
        }
      }
    } with {
      briefly "Prescription management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppPrescriptionCommands is type PrescriptionContext.Prescription.PrescriptionCommand
    inlet AppPrescriptionRepositoryResponses is type PrescriptionContext.Prescription.PrescriptionQueryResult    handler PrescriptionManagementAppHandler is {
      on other is {
        error "Unexpected message for application context PrescriptionManagementApp"
      }
    } with {
      briefly "PrescriptionManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PrescriptionManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppPrescriptionCommands is from outlet PrescriptionManagementApp.AppPrescriptionCommands to inlet PrescriptionContext.Prescription.PrescriptionCommands with {
    option persistent()
    briefly "LinkAppPrescriptionCommands"
  }
  connector LinkAppPrescriptionRepositoryResponses is from outlet PrescriptionContext.PrescriptionRepository.PrescriptionRepositoryResponses to inlet PrescriptionManagementApp.AppPrescriptionRepositoryResponses with {
    option persistent()
    briefly "LinkAppPrescriptionRepositoryResponses"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PrescriptionManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Pharmacy prescription management domain"
  described as {
    | The PrescriptionManagement domain provides a complete model for pharmacy
    | prescription lifecycle management including intake, verification, refills,
    | holds, transfers, and regulatory compliance.
  }
}
