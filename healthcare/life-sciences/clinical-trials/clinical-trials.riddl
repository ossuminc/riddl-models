domain ClinicalTrials is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Model author and maintainer"
    described as {
      |Ossum Inc., authors and maintainers of this model.
    }
  }
  user ClinicalResearchCoordinator is "Staff member who manages day-to-day study operations at clinical trial sites" with {
    briefly "Staff member who manages day-to-day study operations at cl"
    described as {
      |Staff member who manages day-to-day study operations at clinical trial sites
    }
  }
  user PrincipalInvestigator is "Physician who leads the clinical trial and oversees subject safety at a site" with {
    briefly "Physician who leads the clinical trial and oversees subjec"
    described as {
      |Physician who leads the clinical trial and oversees subject safety at a site
    }
  }
  user DataManager is "Professional who ensures data quality, manages queries, and prepares datasets for analysis" with {
    briefly "Professional who ensures data quality, manages queries, an"
    described as {
      |Professional who ensures data quality, manages queries, and prepares datasets for analysis
    }
  }
  epic StudyManagement is {
    user ClinicalResearchCoordinator wants to "to manage clinical trial operations" so that "studies are conducted safely and efficiently"
    case SetupStudy is {
      user ClinicalResearchCoordinator wants to "to configure a new clinical study" so that "sites can begin enrolling subjects"
      ???
    } with {
      briefly "Initialize a new clinical study"
      described as {
        |Create study record with protocol details and regulatory information.
      }
    }
    case EnrollSubjects is {
      user ClinicalResearchCoordinator wants to "to enroll qualified subjects" so that "the study can meet its enrollment targets"
      ???
    } with {
      briefly "Screen and enroll study subjects"
      described as {
        |Process subject screening, consent, and enrollment into the study.
      }
    }
    case ConductVisits is {
      user ClinicalResearchCoordinator wants to "to record study visit data" so that "protocol-required assessments are captured"
      ???
    } with {
      briefly "Execute and document study visits"
      described as {
        |Schedule visits, perform assessments, and record data per protocol.
      }
    }
  } with {
    briefly "Core workflows for clinical study management"
    described as {
      | This epic covers the complete lifecycle of a clinical study from
      | initial setup through closeout. It includes site activation, subject
      | enrollment, visit management, data collection, and study closure.
    }
  }
  include "types.riddl"
  include "StudyContext.riddl"
  include "external-contexts.riddl"
  application context ClinicalTrialsApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ClinicalTrials are delivered.
      }
    }
    outlet AppClinicalStudyCommands is type StudyContext.ClinicalStudy.ClinicalStudyCommand
    inlet AppStudyRepositoryResponses is type StudyContext.ClinicalStudy.ClinicalStudyResult    handler ClinicalTrialsAppHandler is {
      on other is {
        error "Unexpected message for application context ClinicalTrialsApp"
      }
    } with {
      briefly "ClinicalTrialsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ClinicalTrialsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ClinicalStudyCommand Stream' is from outlet ClinicalTrialsApp.AppClinicalStudyCommands to inlet StudyContext.ClinicalStudy.ClinicalStudyCommands with {
    briefly "ClinicalStudy commands from the application"
  }
  persistent connector 'ClinicalStudyResult Stream' is from outlet StudyContext.StudyRepository.StudyRepositoryResponses to inlet ClinicalTrialsApp.AppStudyRepositoryResponses with {
    briefly "Study query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ClinicalTrialsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Clinical Trials domain for life sciences research"
  described as {
    | The Clinical Trials domain models the complete lifecycle of clinical
    | research studies in the pharmaceutical and biotechnology industries.
    | It supports Phase I through Phase IV trials, covering study setup,
    | site management, subject enrollment, visit execution, data collection,
    | and regulatory compliance.
  }
}
