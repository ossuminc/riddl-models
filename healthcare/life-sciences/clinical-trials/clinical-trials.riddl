domain ClinicalTrials is {
  persistent connector 'CTMSIntegrationEvent Stream' is from outlet CTMSIntegration.CTMSIntegrationEventsOut to inlet StudyContext.FromCTMSIntegration.FromCTMSIntegrationIn with {
    briefly "What CTMSIntegration tells StudyContext, unasked"
  }
  persistent connector 'EDCSystemEvent Stream' is from outlet EDCSystem.EDCSystemEventsOut to inlet StudyContext.FromEDCSystem.FromEDCSystemIn with {
    briefly "What EDCSystem tells StudyContext, unasked"
  }
  persistent connector 'SafetyDatabaseEvent Stream' is from outlet SafetyDatabase.SafetyDatabaseEventsOut to inlet StudyContext.FromSafetyDatabase.FromSafetyDatabaseIn with {
    briefly "What SafetyDatabase tells StudyContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Model author and maintainer"
    described as {
      |Ossum Inc., authors and maintainers of this model.
    }
  }
  user ClinicalResearchCoordinator is "Staff member who manages day-to-day study operations at clinical trial sites" with {
    briefly "Staff member who manages day-to-day study operations at cl"
    described as {
      |Staff member who manages day-to-day study operations at clinical trial sites
    }
  }
  user PrincipalInvestigator is "Physician who leads the clinical trial and oversees subject safety at a site" with {
    briefly "Physician who leads the clinical trial and oversees subjec"
    described as {
      |Physician who leads the clinical trial and oversees subject safety at a site
    }
  }
  user DataManager is "Professional who ensures data quality, manages queries, and prepares datasets for analysis" with {
    briefly "Professional who ensures data quality, manages queries, an"
    described as {
      |Professional who ensures data quality, manages queries, and prepares datasets for analysis
    }
  }
  epic StudyManagement is {
    user ClinicalResearchCoordinator wants to "to manage clinical trial operations" so that "studies are conducted safely and efficiently"
    case SetupStudy is {
      user ClinicalResearchCoordinator wants to "to configure a new clinical study" so that "sites can begin enrolling subjects"
      ???
    } with {
      briefly "Initialize a new clinical study"
      described as {
        |Create study record with protocol details and regulatory information.
      }
    }
    case EnrollSubjects is {
      user ClinicalResearchCoordinator wants to "to enroll qualified subjects" so that "the study can meet its enrollment targets"
      ???
    } with {
      briefly "Screen and enroll study subjects"
      described as {
        |Process subject screening, consent, and enrollment into the study.
      }
    }
    case ConductVisits is {
      user ClinicalResearchCoordinator wants to "to record study visit data" so that "protocol-required assessments are captured"
      ???
    } with {
      briefly "Execute and document study visits"
      described as {
        |Schedule visits, perform assessments, and record data per protocol.
      }
    }
  } with {
    briefly "Core workflows for clinical study management"
    described as {
      | This epic covers the complete lifecycle of a clinical study from
      | initial setup through closeout. It includes site activation, subject
      | enrollment, visit management, data collection, and study closure.
    }
  }
  include "types.riddl"
  include "StudyContext.riddl"
  include "external-contexts.riddl"
  application context ClinicalTrialsApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ClinicalTrials are delivered.
      }
    }
    group ClinicalTrialsScreen is {
      input FindStudiesBySponsorInput acquires query StudyContext.StudyRepository.FindStudiesBySponsor with {
        briefly "Find studies by sponsor control"
        described as {
          |The control through which a user asks the find studies by sponsor question.
        }
      }
      input FindStudiesByStatusInput acquires query StudyContext.StudyRepository.FindStudiesByStatus with {
        briefly "Find studies by status control"
        described as {
          |The control through which a user asks the find studies by status question.
        }
      }
      input FindStudyByIdInput acquires query StudyContext.StudyRepository.FindStudyById with {
        briefly "Find study by id control"
        described as {
          |The control through which a user asks the find study by id question.
        }
      }
      input GetEnrollmentStateInput acquires query StudyContext.GetEnrollmentState with {
        briefly "Get enrollment state control"
        described as {
          |The control through which a user asks the get enrollment state question.
        }
      }
      input GetClinicalStudyInput acquires query StudyContext.ClinicalStudy.GetClinicalStudy with {
        briefly "Get clinical study control"
        described as {
          |The control through which a user asks the get clinical study question.
        }
      }
      input CloseStudyInput acquires command StudyContext.ClinicalStudy.CloseStudy with {
        briefly "Close study control"
        described as {
          |The control through which a user submits the close study request.
        }
      }
      input EnrollSubjectInput acquires command StudyContext.ClinicalStudy.EnrollSubject with {
        briefly "Enroll subject control"
        described as {
          |The control through which a user submits the enroll subject request.
        }
      }
      input RecordVisitInput acquires command StudyContext.ClinicalStudy.RecordVisit with {
        briefly "Record visit control"
        described as {
          |The control through which a user submits the record visit request.
        }
      }
      input UpdateStudyStatusInput acquires command StudyContext.ClinicalStudy.UpdateStudyStatus with {
        briefly "Update study status control"
        described as {
          |The control through which a user submits the update study status request.
        }
      }
      input CreateStudyInput acquires command StudyContext.CreateStudy with {
        briefly "Create study control"
        described as {
          |The control through which a user submits the create study request.
        }
      }
    } with {
      briefly "Clinical trials screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppStudyRepositoryQueries is type StudyContext.StudyRepository.StudyRepositoryQuery
    inlet AppStudyRepositoryReplies is type StudyContext.StudyRepository.StudyRepositoryReply
    outlet AppClinicalStudyQueries is query StudyContext.ClinicalStudy.GetClinicalStudy
    outlet AppClinicalStudyCommands is type StudyContext.ClinicalStudyRequest
    inlet AppStudyRepositoryResponses is result StudyContext.ClinicalStudy.ClinicalStudyResult
    handler ClinicalTrialsAppHandler is {
      on other is {
        error "Unexpected message for application context ClinicalTrialsApp"
      }
    } with {
      briefly "ClinicalTrialsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ClinicalTrialsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'StudyRepositoryQuery Stream' is from outlet ClinicalTrialsApp.AppStudyRepositoryQueries to inlet StudyContext.StudyRepositoryQueriesIn with {
    briefly "ClinicalTrialsApp's look-ups of the study repository"
  }
  persistent connector 'StudyRepositoryReply Stream' is from outlet StudyContext.StudyRepositoryRepliesOut to inlet ClinicalTrialsApp.AppStudyRepositoryReplies with {
    briefly "The study repository's answers returned to ClinicalTrialsApp"
  }
  persistent connector 'ClinicalStudyQuery Stream' is from outlet ClinicalTrialsApp.AppClinicalStudyQueries to inlet StudyContext.ClinicalStudyQueriesIn with {
    briefly "ClinicalTrialsApp's look-ups of the clinical study"
  }
  persistent connector 'ClinicalStudyCommand Stream' is from outlet ClinicalTrialsApp.AppClinicalStudyCommands to inlet StudyContext.ClinicalStudyCommandStreamIn with {
    briefly "ClinicalStudy commands from the application"
  }
  persistent connector 'ClinicalStudyResult Stream' is from outlet StudyContext.ClinicalStudyResultStreamOut to inlet ClinicalTrialsApp.AppStudyRepositoryResponses with {
    briefly "Study query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ClinicalTrialsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Clinical Trials domain for life sciences research"
  described as {
    | The Clinical Trials domain models the complete lifecycle of clinical
    | research studies in the pharmaceutical and biotechnology industries.
    | It supports Phase I through Phase IV trials, covering study setup,
    | site management, subject enrollment, visit execution, data collection,
    | and regulatory compliance.
  }
}
