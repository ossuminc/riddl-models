// Study Management Bounded Context
context StudyContext is {
  include "ClinicalStudy.riddl"
  repository StudyRepository is {
    type StudyRecord is {
      studyId: StudyId
      protocol: StudyProtocol
      status: StudyStatus
      siteCount: Integer
      enrolledCount: Integer
      createdAt: DateTime
      lastModifiedAt: DateTime
    } with {
      briefly "Persistent study record"
      described as {
        |Database record for a clinical study with summary statistics.
      }
    }
    command StoreStudy is  { studyRecord: StudyRecord } with {
      briefly "Persist a study record"
      described as {
        |Saves or updates a study record in the repository.
      }
    }
    command DeleteStudy is  { studyId: StudyId } with {
      briefly "Remove a study record"
      described as {
        |Deletes a study record from the repository.
      }
    }
    query FindStudyById is  { studyId: StudyId } with {
      briefly "Retrieve study by ID"
      described as {
        |Fetches a single study record by its unique identifier.
      }
    }
    query FindStudiesByStatus is  { status: StudyStatus } with {
      briefly "Find studies by status"
      described as {
        |Returns all studies matching the specified operational status.
      }
    }
    query FindStudiesBySponsor is  { sponsorName: String } with {
      briefly "Find studies by sponsor"
      described as {
        |Returns all studies for a given sponsor organization.
      }
    }
    result StudyResult is  { foundRecord: StudyRecord? } with {
      briefly "Single study query result"
      described as {
        |Returns the requested study or empty if not found.
      }
    }
    result StudyListResult is  { studyRecords: StudyRecord* } with {
      briefly "Multiple study query result"
      described as {
        |Returns a list of studies matching query criteria.
      }
    }
    handler StudyRepositoryHandler is {
      on command StoreStudy is { ??? }
      on command DeleteStudy is { ??? }
      on query FindStudyById is { ??? }
      on query FindStudiesByStatus is { ??? }
      on query FindStudiesBySponsor is { ??? }
    } with {
      briefly "Repository command and query handler"
      described as {
        |Processes persistence operations for study records.
      }
    }
  } with {
    briefly "Persistence for clinical study data"
    described as {
      | The StudyRepository provides persistence and query capabilities for
      | clinical study records. It supports standard CRUD operations plus
      | queries for finding studies by various criteria.
    }
  }
  projector EnrollmentMetricsProjector is {
    updates repository StudyContext.StudyRepository
    record EnrollmentState is  {
      studyId: StudyId
      totalSites: Integer
      activeSites: Integer
      totalEnrolled: Integer
      enrollmentTarget: Integer
      enrollmentPercentage: Number
      screenFailureRate: Number
      averageEnrollmentPerSite: Number
      projectedCompletionDate: Date?
      lastUpdated: DateTime
    } with {
      briefly "Enrollment metrics state"
      described as {
        |Aggregated statistics about study enrollment progress and site performance.
      }
    }
    handler MetricsProjectorHandler is {
      on event ClinicalStudy.SubjectEnrolled is {
        tell event ClinicalStudy.SubjectEnrolled to repository StudyContext.StudyRepository
      }
      on event ClinicalStudy.SiteActivated is {
        tell event ClinicalStudy.SiteActivated to repository StudyContext.StudyRepository
      }
      on event ClinicalStudy.StudyCreated is {
        tell event ClinicalStudy.StudyCreated to repository StudyContext.StudyRepository
      }
      on event ClinicalStudy.StudyClosed is {
        tell event ClinicalStudy.StudyClosed to repository StudyContext.StudyRepository
      }
    } with {
      briefly "Event handler for metrics projection"
      described as {
        |Processes clinical study events to maintain enrollment metrics.
      }
    }
  } with {
    briefly "Read model for enrollment analytics"
    described as {
      | The EnrollmentMetricsProjector maintains real-time enrollment
      | statistics by processing clinical study events. It provides
      | aggregated views of enrollment progress at both study and site
      | levels to support operational decision-making.
    }
  }
  // ---- Event publication for ClinicalStudy ----
  type ClinicalStudyEvent is one of {
    StudyContext.ClinicalStudy.StudyCreated,
    StudyContext.ClinicalStudy.SiteActivated,
    StudyContext.ClinicalStudy.SubjectEnrolled,
    StudyContext.ClinicalStudy.VisitRecorded,
    StudyContext.ClinicalStudy.DataSubmitted,
    StudyContext.ClinicalStudy.StudyClosed,
    StudyContext.ClinicalStudy.StudyStatusUpdated
  } with {
    briefly "ClinicalStudy event alternation"
    described as {
      |Union of all ClinicalStudy events, for streaming and event-sourced
      |persistence.
    }
  }
  source ClinicalStudyEventSource is {
    outlet ClinicalStudyEvents is type ClinicalStudyEvent
    handler ClinicalStudySourceHandler is {
      on event ClinicalStudy.StudyCreated is {
        send event ClinicalStudy.StudyCreated to outlet ClinicalStudyEvents
      }
      on event ClinicalStudy.SiteActivated is {
        send event ClinicalStudy.SiteActivated to outlet ClinicalStudyEvents
      }
      on event ClinicalStudy.SubjectEnrolled is {
        send event ClinicalStudy.SubjectEnrolled to outlet ClinicalStudyEvents
      }
      on event ClinicalStudy.VisitRecorded is {
        send event ClinicalStudy.VisitRecorded to outlet ClinicalStudyEvents
      }
      on event ClinicalStudy.DataSubmitted is {
        send event ClinicalStudy.DataSubmitted to outlet ClinicalStudyEvents
      }
      on event ClinicalStudy.StudyClosed is {
        send event ClinicalStudy.StudyClosed to outlet ClinicalStudyEvents
      }
      on event ClinicalStudy.StudyStatusUpdated is {
        send event ClinicalStudy.StudyStatusUpdated to outlet ClinicalStudyEvents
      }
      on other is {
        error "Unexpected message for source ClinicalStudyEventSource"
      }
    } with {
      briefly "ClinicalStudy source handler"
      described as {
        |Publishes ClinicalStudy events onto the outlet.
      }
    }
  } with {
    briefly "ClinicalStudy event source"
    described as {
      |Publishes ClinicalStudy entity events into the streaming topology.
    }
  }
  sink ClinicalStudyEventSink is {
    inlet ClinicalStudyInlet is type ClinicalStudyEvent
    handler ClinicalStudySinkHandler is {
      on event ClinicalStudy.StudyCreated is {
        tell event ClinicalStudy.StudyCreated to repository StudyContext.StudyRepository
      }
      on event ClinicalStudy.SiteActivated is {
        tell event ClinicalStudy.SiteActivated to repository StudyContext.StudyRepository
      }
      on event ClinicalStudy.SubjectEnrolled is {
        tell event ClinicalStudy.SubjectEnrolled to repository StudyContext.StudyRepository
      }
      on event ClinicalStudy.VisitRecorded is {
        tell event ClinicalStudy.VisitRecorded to repository StudyContext.StudyRepository
      }
      on event ClinicalStudy.DataSubmitted is {
        tell event ClinicalStudy.DataSubmitted to repository StudyContext.StudyRepository
      }
      on event ClinicalStudy.StudyClosed is {
        tell event ClinicalStudy.StudyClosed to repository StudyContext.StudyRepository
      }
      on event ClinicalStudy.StudyStatusUpdated is {
        tell event ClinicalStudy.StudyStatusUpdated to repository StudyContext.StudyRepository
      }
      on other is {
        error "Unexpected message for sink ClinicalStudyEventSink"
      }
    } with {
      briefly "ClinicalStudy sink handler"
      described as {
        |Persists ClinicalStudy events via the repository.
      }
    }
  } with {
    briefly "ClinicalStudy event sink"
    described as {
      |Receives ClinicalStudy events for persistence.
    }
  }
  connector ClinicalStudyEventFlow is {
    from outlet StudyContext.ClinicalStudyEventSource.ClinicalStudyEvents to
      inlet StudyContext.ClinicalStudyEventSink.ClinicalStudyInlet
  } with {
    briefly "ClinicalStudy event flow"
    described as {
      |Connects the ClinicalStudy source to its sink.
    }
  }
} with {
  briefly "Bounded context for clinical study operations"
  described as {
    | StudyContext is the core bounded context for clinical trial management.
    | It contains the ClinicalStudy aggregate, the StudyRepository for
    | persistence, and the EnrollmentMetricsProjector for analytics.
    | This context handles all study lifecycle operations from creation
    | through closeout.
  }
}
