// Study Management Bounded Context
context StudyContext as router is {
  inlet ClinicalStudyCommandStreamIn is type ClinicalStudyCommand
  outlet ClinicalStudyCommandStreamOut is type ClinicalStudyCommand
  inlet ClinicalStudyResultStreamIn is type ClinicalStudy.ClinicalStudyResult
  outlet ClinicalStudyResultStreamOut is type ClinicalStudy.ClinicalStudyResult
  handler StudyContextBoundary is {
    on createStudy: command ClinicalStudy.CreateStudy is {
      send createStudy to outlet StudyContext.ClinicalStudyCommandStreamOut
    }
    on activateSite: command ClinicalStudy.ActivateSite is {
      send activateSite to outlet StudyContext.ClinicalStudyCommandStreamOut
    }
    on enrollSubject: command ClinicalStudy.EnrollSubject is {
      send enrollSubject to outlet StudyContext.ClinicalStudyCommandStreamOut
    }
    on recordVisit: command ClinicalStudy.RecordVisit is {
      send recordVisit to outlet StudyContext.ClinicalStudyCommandStreamOut
    }
    on submitData: command ClinicalStudy.SubmitData is {
      send submitData to outlet StudyContext.ClinicalStudyCommandStreamOut
    }
    on closeStudy: command ClinicalStudy.CloseStudy is {
      send closeStudy to outlet StudyContext.ClinicalStudyCommandStreamOut
    }
    on updateStudyStatus: command ClinicalStudy.UpdateStudyStatus is {
      send updateStudyStatus to outlet StudyContext.ClinicalStudyCommandStreamOut
    }
    on clinicalStudyResult: result ClinicalStudy.ClinicalStudyResult is {
      send clinicalStudyResult to outlet StudyContext.ClinicalStudyResultStreamOut
    }
    on other is {
      error "Unexpected message at the StudyContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ClinicalStudyCommand Stream Intake' is from outlet StudyContext.ClinicalStudyCommandStreamOut to inlet StudyContext.ClinicalStudy.ClinicalStudyCommands
  connector 'ClinicalStudyResult Stream Egress' is from outlet StudyContext.StudyRepository.StudyRepositoryResponses to inlet StudyContext.ClinicalStudyResultStreamIn
  adaptor FromCTMSIntegration from context CTMSIntegration is { 
    handler FromCTMSIntegrationHandler is {
      on event CTMSIntegration.ContractExecuted is {
        do "the model receives contract executed"
      }
      on event CTMSIntegration.MilestoneAchieved is {
        do "the model receives milestone achieved"
      }
      on event CTMSIntegration.PaymentProcessed is {
        do "the model receives payment processed"
      }
      on other is {
        error "Unexpected message for adaptor FromCTMSIntegration"
      }
    } with {
      briefly "from ctms integration"
      described as {
        |Carries messages from the external CTMSIntegration.
      }
    }
  } with {
    briefly "CTMSIntegration integration"
    described as {
      |The model's side of the CTMSIntegration conversation.
    }
  }
  adaptor FromEDCSystem from context EDCSystem is { 
    handler FromEDCSystemHandler is {
      on event EDCSystem.CRFSubmitted is {
        do "the model receives crf submitted"
      }
      on event EDCSystem.DataQueryResolved is {
        do "the model receives data query resolved"
      }
      on event EDCSystem.QueryOpened is {
        do "the model receives query opened"
      }
      on other is {
        error "Unexpected message for adaptor FromEDCSystem"
      }
    } with {
      briefly "from edc system"
      described as {
        |Carries messages from the external EDCSystem.
      }
    }
  } with {
    briefly "EDCSystem integration"
    described as {
      |The model's side of the EDCSystem conversation.
    }
  }
  adaptor FromSafetyDatabase from context SafetyDatabase is { 
    handler FromSafetyDatabaseHandler is {
      on event SafetyDatabase.AdverseEventReported is {
        do "the model receives adverse event reported"
      }
      on event SafetyDatabase.SAEReported is {
        do "the model receives sae reported"
      }
      on event SafetyDatabase.SAESubmittedToRegulator is {
        do "the model receives sae submitted to regulator"
      }
      on other is {
        error "Unexpected message for adaptor FromSafetyDatabase"
      }
    } with {
      briefly "from safety database"
      described as {
        |Carries messages from the external SafetyDatabase.
      }
    }
  } with {
    briefly "SafetyDatabase integration"
    described as {
      |The model's side of the SafetyDatabase conversation.
    }
  }
  type StudyId is Id(ClinicalStudy)  with {
    briefly "Unique identifier for a clinical study"
    described as {
      |A globally unique identifier assigned to each clinical study, typically following sponsor naming conventions.
    }
  }
  include "ClinicalStudy.riddl"
  repository StudyRepository as merge is {
    command PersistSiteActivated is {
      studyId: StudyId with {
        briefly "Row addressed"
        described as {
          |Which stored row SiteActivated applies to.
        }
      }
    } with {
      briefly "Persist SiteActivated"
      described as {
        |Instructs this repository to apply SiteActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStudyClosed is {
      studyId: StudyId with {
        briefly "Row addressed"
        described as {
          |Which stored row StudyClosed applies to.
        }
      }
    } with {
      briefly "Persist StudyClosed"
      described as {
        |Instructs this repository to apply StudyClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStudyCreated is {
      studyId: StudyId with {
        briefly "Row addressed"
        described as {
          |Which stored row StudyCreated applies to.
        }
      }
    } with {
      briefly "Persist StudyCreated"
      described as {
        |Instructs this repository to apply StudyCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubjectEnrolled is {
      studyId: StudyId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubjectEnrolled applies to.
        }
      }
    } with {
      briefly "Persist SubjectEnrolled"
      described as {
        |Instructs this repository to apply SubjectEnrolled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredClinicalStudy is  {
      clinicalStudyId: UUID with {
        briefly "clinicalStudyId"
        described as {
          |The clinicalStudyId column of the stored clinicalStudy row.
        }
      }
    } with {
      briefly "Stored clinicalStudy row"
      described as {
        |The persistence shape of clinicalStudy data as this repository stores it.
      }
    }
    schema ClinicalStudyData is relational
      of clinicalstudys as type StoredClinicalStudy
 with {
      briefly "Clinical study data schema"
      described as {
        |The relational schema persisting clinical study records for this repository.
      }
    }
    inlet StudyRepositoryFromClinicalStudy is type ClinicalStudyEvent    inlet StudyRepositoryFromEnrollmentMetricsProjector is type ClinicalStudyEvent    outlet StudyRepositoryResponses is type ClinicalStudy.ClinicalStudyResult
    type StudyRecord is {
      studyId: StudyId
      protocol: StudyProtocol
      status: StudyStatus
      siteCount: Integer
      enrolledCount: Integer
      createdAt: DateTime
      lastModifiedAt: DateTime
    } with {
      briefly "Persistent study record"
      described as {
        |Database record for a clinical study with summary statistics.
      }
    }
    command StoreStudy is  { studyRecord: StudyRecord } with {
      briefly "Persist a study record"
      described as {
        |Saves or updates a study record in the repository.
      }
    }
    command DeleteStudy is  { studyId: StudyId } with {
      briefly "Remove a study record"
      described as {
        |Deletes a study record from the repository.
      }
    }
    query FindStudyById is  { studyId: StudyId } with {
      briefly "Retrieve study by ID"
      described as {
        |Fetches a single study record by its unique identifier.
      }
    }
    query FindStudiesByStatus is  { status: StudyStatus } with {
      briefly "Find studies by status"
      described as {
        |Returns all studies matching the specified operational status.
      }
    }
    query FindStudiesBySponsor is  { sponsorName: String } with {
      briefly "Find studies by sponsor"
      described as {
        |Returns all studies for a given sponsor organization.
      }
    }
    result StudyResult is  { foundRecord: StudyRecord? } with {
      briefly "Single study query result"
      described as {
        |Returns the requested study or empty if not found.
      }
    }
    result StudyListResult is  { studyRecords: StudyRecord* } with {
      briefly "Multiple study query result"
      described as {
        |Returns a list of studies matching query criteria.
      }
    }
    handler StudyRepositoryHandler is {
      on persistSiteActivated: command PersistSiteActivated is {
        do "apply SiteActivated to the stored row"
      }
      on persistStudyClosed: command PersistStudyClosed is {
        do "apply StudyClosed to the stored row"
      }
      on persistStudyCreated: command PersistStudyCreated is {
        do "apply StudyCreated to the stored row"
      }
      on persistSubjectEnrolled: command PersistSubjectEnrolled is {
        do "apply SubjectEnrolled to the stored row"
      }
      on query GetEnrollmentState is {
        let enrollmentStateView: type EnrollmentStateView = prompt("read the enrollment state projection")
        reply enrollmentStateView
      }
      on command StoreStudy is {
        do "store study"
      }
      on command DeleteStudy is {
        do "delete study"
      }
      on query FindStudyById is {
        let studyResult: type StudyResult = prompt("read the study from the store")
        reply studyResult
      }
      on query FindStudiesByStatus is {
        let studyListResult: type StudyListResult = prompt("read the study list that studies by status asks for")
        reply studyListResult
      }
      on query FindStudiesBySponsor is {
        let studyListResult: type StudyListResult = prompt("read the study list that studies by sponsor asks for")
        reply studyListResult
      }
    } with {
      briefly "Repository command and query handler"
      described as {
        |Processes persistence operations for study records.
      }
    }
  } with {
    briefly "Persistence for clinical study data"
    described as {
      | The StudyRepository provides persistence and query capabilities for
      | clinical study records. It supports standard CRUD operations plus
      | queries for finding studies by various criteria.
    }
  }
  query GetEnrollmentState is  {
    enrollmentStateKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which enrollment state to retrieve.
      }
    }
  } with {
    briefly "Get enrollment state"
    described as {
      |Retrieves the enrollment state projection.
    }
  }
  result EnrollmentStateView is  {
    enrollmentState: EnrollmentMetricsProjector.EnrollmentState with {
      briefly "Enrollment state"
      described as {
        |The enrollment state being returned.
      }
    }
  } with {
    briefly "Enrollment state view"
    described as {
      |Read model view carrying the enrollment state projection.
    }
  }
  projector EnrollmentMetricsProjector as flow is {
    updates repository StudyContext.StudyRepository
    inlet EnrollmentMetricsProjectorFromClinicalStudy is type ClinicalStudyEvent    outlet EnrollmentMetricsProjectorOut is type ClinicalStudyEvent
    record EnrollmentState is  {
      studyId: StudyId
      totalSites: Integer
      activeSites: Integer
      totalEnrolled: Integer
      enrollmentTarget: Integer
      enrollmentPercentage: Number
      screenFailureRate: Number
      averageEnrollmentPerSite: Number
      projectedCompletionDate: Date?
      lastUpdated: DateTime
    } with {
      briefly "Enrollment metrics state"
      described as {
        |Aggregated statistics about study enrollment progress and site performance.
      }
    }
    handler MetricsProjectorHandler is {
      on subjectEnrolled: event ClinicalStudy.SubjectEnrolled is {
        tell command StudyContext.StudyRepository.PersistSubjectEnrolled(studyId = subjectEnrolled.studyId) to repository StudyContext.StudyRepository
      }
      on siteActivated: event ClinicalStudy.SiteActivated is {
        tell command StudyContext.StudyRepository.PersistSiteActivated(studyId = siteActivated.studyId) to repository StudyContext.StudyRepository
      }
      on studyCreated: event ClinicalStudy.StudyCreated is {
        tell command StudyContext.StudyRepository.PersistStudyCreated(studyId = studyCreated.studyId) to repository StudyContext.StudyRepository
      }
      on studyClosed: event ClinicalStudy.StudyClosed is {
        tell command StudyContext.StudyRepository.PersistStudyClosed(studyId = studyClosed.studyId) to repository StudyContext.StudyRepository
      }
    } with {
      briefly "Event handler for metrics projection"
      described as {
        |Processes clinical study events to maintain enrollment metrics.
      }
    }
  } with {
    briefly "Read model for enrollment analytics"
    described as {
      | The EnrollmentMetricsProjector maintains real-time enrollment
      | statistics by processing clinical study events. It provides
      | aggregated views of enrollment progress at both study and site
      | levels to support operational decision-making.
    }
  }
  // ---- Event publication for ClinicalStudy ----
  type ClinicalStudyEvent is one of {
    StudyContext.ClinicalStudy.StudyCreated or StudyContext.ClinicalStudy.SiteActivated or StudyContext.ClinicalStudy.SubjectEnrolled or StudyContext.ClinicalStudy.VisitRecorded or StudyContext.ClinicalStudy.DataSubmitted or StudyContext.ClinicalStudy.StudyClosed or StudyContext.ClinicalStudy.StudyStatusUpdated
  } with {
    briefly "ClinicalStudy event alternation"
    described as {
      |Union of all ClinicalStudy events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ClinicalStudyEventSource as source is {
    outlet ClinicalStudyEvents is type ClinicalStudyEvent
    handler ClinicalStudySourceHandler is {
      on studyCreated: event ClinicalStudy.StudyCreated is {
        send studyCreated to outlet ClinicalStudyEvents
      }
      on siteActivated: event ClinicalStudy.SiteActivated is {
        send siteActivated to outlet ClinicalStudyEvents
      }
      on subjectEnrolled: event ClinicalStudy.SubjectEnrolled is {
        send subjectEnrolled to outlet ClinicalStudyEvents
      }
      on visitRecorded: event ClinicalStudy.VisitRecorded is {
        send visitRecorded to outlet ClinicalStudyEvents
      }
      on dataSubmitted: event ClinicalStudy.DataSubmitted is {
        send dataSubmitted to outlet ClinicalStudyEvents
      }
      on studyClosed: event ClinicalStudy.StudyClosed is {
        send studyClosed to outlet ClinicalStudyEvents
      }
      on studyStatusUpdated: event ClinicalStudy.StudyStatusUpdated is {
        send studyStatusUpdated to outlet ClinicalStudyEvents
      }
      on other is {
        error "Unexpected message for source ClinicalStudyEventSource"
      }
    } with {
      briefly "ClinicalStudy source handler"
      described as {
        |Publishes ClinicalStudy events onto the outlet.
      }
    }
  } with {
    briefly "ClinicalStudy event source"
    described as {
      |Publishes ClinicalStudy entity events into the streaming topology.
    }
  }
  processor ClinicalStudyEventSink as sink is {
    inlet ClinicalStudyInlet is type ClinicalStudyEvent    handler ClinicalStudySinkHandler is {
      on studyCreated: event ClinicalStudy.StudyCreated is {
        tell studyCreated to repository StudyContext.StudyRepository
      }
      on siteActivated: event ClinicalStudy.SiteActivated is {
        tell siteActivated to repository StudyContext.StudyRepository
      }
      on subjectEnrolled: event ClinicalStudy.SubjectEnrolled is {
        tell subjectEnrolled to repository StudyContext.StudyRepository
      }
      on visitRecorded: event ClinicalStudy.VisitRecorded is {
        tell visitRecorded to repository StudyContext.StudyRepository
      }
      on dataSubmitted: event ClinicalStudy.DataSubmitted is {
        tell dataSubmitted to repository StudyContext.StudyRepository
      }
      on studyClosed: event ClinicalStudy.StudyClosed is {
        tell studyClosed to repository StudyContext.StudyRepository
      }
      on studyStatusUpdated: event ClinicalStudy.StudyStatusUpdated is {
        tell studyStatusUpdated to repository StudyContext.StudyRepository
      }
      on other is {
        error "Unexpected message for sink ClinicalStudyEventSink"
      }
    } with {
      briefly "ClinicalStudy sink handler"
      described as {
        |Persists ClinicalStudy events via the repository.
      }
    }
  } with {
    briefly "ClinicalStudy event sink"
    described as {
      |Receives ClinicalStudy events for persistence.
    }
  }
  connector ClinicalStudyEventFlow is from outlet StudyContext.ClinicalStudyEventSource.ClinicalStudyEvents to inlet StudyContext.ClinicalStudyEventSink.ClinicalStudyInlet with {
    briefly "ClinicalStudy event flow"
    described as {
      |Connects the ClinicalStudy source to its sink.
    }
  }
  processor ClinicalStudyEventSplit as split is {
    inlet ClinicalStudyEventSplitIn is type ClinicalStudyEvent    outlet ClinicalStudyEventSplitToStudyRepository is type ClinicalStudyEvent
    outlet ClinicalStudyEventSplitToEnrollmentMetricsProjector is type ClinicalStudyEvent
    handler ClinicalStudyEventSplitHandler is {
      on studyCreated: event ClinicalStudy.StudyCreated is {
        send studyCreated to outlet ClinicalStudyEventSplitToStudyRepository
        send studyCreated to outlet ClinicalStudyEventSplitToEnrollmentMetricsProjector
        tell studyCreated to entity StudyContext.ClinicalStudy
      }
      on siteActivated: event ClinicalStudy.SiteActivated is {
        send siteActivated to outlet ClinicalStudyEventSplitToStudyRepository
        send siteActivated to outlet ClinicalStudyEventSplitToEnrollmentMetricsProjector
        tell siteActivated to entity StudyContext.ClinicalStudy
      }
      on subjectEnrolled: event ClinicalStudy.SubjectEnrolled is {
        send subjectEnrolled to outlet ClinicalStudyEventSplitToStudyRepository
        send subjectEnrolled to outlet ClinicalStudyEventSplitToEnrollmentMetricsProjector
        tell subjectEnrolled to entity StudyContext.ClinicalStudy
      }
      on visitRecorded: event ClinicalStudy.VisitRecorded is {
        send visitRecorded to outlet ClinicalStudyEventSplitToStudyRepository
        send visitRecorded to outlet ClinicalStudyEventSplitToEnrollmentMetricsProjector
        tell visitRecorded to entity StudyContext.ClinicalStudy
      }
      on dataSubmitted: event ClinicalStudy.DataSubmitted is {
        send dataSubmitted to outlet ClinicalStudyEventSplitToStudyRepository
        send dataSubmitted to outlet ClinicalStudyEventSplitToEnrollmentMetricsProjector
        tell dataSubmitted to entity StudyContext.ClinicalStudy
      }
      on studyClosed: event ClinicalStudy.StudyClosed is {
        send studyClosed to outlet ClinicalStudyEventSplitToStudyRepository
        send studyClosed to outlet ClinicalStudyEventSplitToEnrollmentMetricsProjector
        tell studyClosed to entity StudyContext.ClinicalStudy
      }
      on studyStatusUpdated: event ClinicalStudy.StudyStatusUpdated is {
        send studyStatusUpdated to outlet ClinicalStudyEventSplitToStudyRepository
        send studyStatusUpdated to outlet ClinicalStudyEventSplitToEnrollmentMetricsProjector
        tell studyStatusUpdated to entity StudyContext.ClinicalStudy
      }
      on other is {
        error "Unexpected message for processor ClinicalStudyEventSplit"
      }
    } with {
      briefly "ClinicalStudy event fan-out handler"
      described as {
        |Delivers each ClinicalStudy event to all of its consumers.
      }
    }
  } with {
    briefly "ClinicalStudy event fan-out"
    described as {
      |Fans ClinicalStudy events out to the repository and projectors.
    }
  }
  connector 'ClinicalStudyEvent Stream' is from outlet StudyContext.ClinicalStudy.ClinicalStudyEvents2 to inlet StudyContext.ClinicalStudyEventSplit.ClinicalStudyEventSplitIn with {
    briefly "ClinicalStudy events, fanned out to storage and read models"
  }
  connector 'ClinicalStudyEvent Storage' is from outlet StudyContext.ClinicalStudyEventSplit.ClinicalStudyEventSplitToStudyRepository to inlet StudyContext.StudyRepository.StudyRepositoryFromClinicalStudy with {
    briefly "ClinicalStudy events on their way to storage"
  }
  connector 'EnrollmentMetricsProjector Feed' is from outlet StudyContext.ClinicalStudyEventSplit.ClinicalStudyEventSplitToEnrollmentMetricsProjector to inlet StudyContext.EnrollmentMetricsProjector.EnrollmentMetricsProjectorFromClinicalStudy with {
    briefly "ClinicalStudy events feeding the EnrollmentMetricsProjector projection"
  }
  connector 'EnrollmentMetricsProjector Storage' is from outlet StudyContext.EnrollmentMetricsProjector.EnrollmentMetricsProjectorOut to inlet StudyContext.StudyRepository.StudyRepositoryFromEnrollmentMetricsProjector with {
    briefly "The EnrollmentMetricsProjector projection on its way to storage"
  }
} with {
  briefly "Bounded context for clinical study operations"
  described as {
    | StudyContext is the core bounded context for clinical trial management.
    | It contains the ClinicalStudy aggregate, the StudyRepository for
    | persistence, and the EnrollmentMetricsProjector for analytics.
    | This context handles all study lifecycle operations from creation
    | through closeout.
  }
}
