// Clinical Study Entity
aggregate event-sourced entity ClinicalStudy as flow is {
  type ClinicalStudyCommand is one of {
    ClinicalStudy.CreateStudy or ClinicalStudy.ActivateSite or ClinicalStudy.EnrollSubject or ClinicalStudy.RecordVisit or ClinicalStudy.SubmitData or ClinicalStudy.CloseStudy or ClinicalStudy.UpdateStudyStatus
  } with {
    briefly "ClinicalStudy command alternation"
    described as {
      |Commands accepted by the ClinicalStudy entity.
    }
  }
  inlet ClinicalStudyCommands is type ClinicalStudyCommand  outlet ClinicalStudyEvents2 is type ClinicalStudyEvent
  query GetClinicalStudy is  {
    clinicalStudyId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the ClinicalStudy to retrieve.
      }
    }
  } with {
    briefly "Get ClinicalStudy"
    described as {
      |Retrieve ClinicalStudy data by identifier.
    }
  }
  result ClinicalStudyResult is  {
    clinicalStudyId: StudyId with {
      briefly "ClinicalStudy addressed"
      described as {
        |Which clinicalstudy this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    clinicalStudyData: DraftStateFields with {
      briefly "ClinicalStudy data"
      described as {
        |The requested ClinicalStudy data.
      }
    }
  } with {
    briefly "ClinicalStudy result"
    described as {
      |Result carrying the requested ClinicalStudy data.
    }
  }
  // State Record Types
  record DraftStateFields is  {
    studyId: StudyId
    protocol: StudyProtocol
    status: StudyStatus
    createdAt: DateTime
  } with {
    briefly "Fields for draft state"
    described as {
      |Data stored when study is in draft status.
    }
  }
  record ActiveStateFields is  {
    studyId: StudyId
    protocol: StudyProtocol
    status: StudyStatus
    sites: SiteInfo*
    enrollments: SubjectEnrollment*
    visits: VisitRecord*
    submissions: DataSubmission*
    activatedAt: DateTime
  } with {
    briefly "Fields for active state"
    described as {
      |Data stored when study is active and operational.
    }
  }
  record ClosedStateFields is  {
    studyId: StudyId
    protocol: StudyProtocol
    finalStatus: StudyStatus
    sites: SiteInfo*
    enrollments: SubjectEnrollment*
    visits: VisitRecord*
    submissions: DataSubmission*
    closureDate: Date
    closureReason: String
  } with {
    briefly "Fields for closed state"
    described as {
      |Data stored when study has been closed.
    }
  }
  // Commands
  command CreateStudy yields event StudyCreated is  {
    studyId: StudyId
    protocol: StudyProtocol
  } with {
    briefly "Initialize a new clinical study"
    described as {
      |Creates a new clinical study record with protocol details. Study starts in Draft status.
    }
  }
  command ActivateSite yields event SiteActivated is  {
    studyId: StudyId
    siteInfo: SiteInfo
  } with {
    briefly "Activate a site for enrollment"
    described as {
      |Adds a site to the study and marks it as active for subject enrollment after initiation visit.
    }
  }
  command EnrollSubject yields event SubjectEnrolled is  {
    studyId: StudyId
    enrollment: SubjectEnrollment
  } with {
    briefly "Enroll a subject into the study"
    described as {
      |Records a new subject enrollment after informed consent and eligibility confirmation.
    }
  }
  command RecordVisit yields event VisitRecorded is  {
    studyId: StudyId
    visit: VisitRecord
  } with {
    briefly "Record a completed study visit"
    described as {
      |Documents the completion of a protocol-defined study visit with assessments performed.
    }
  }
  command SubmitData yields event DataSubmitted is  {
    studyId: StudyId
    submission: DataSubmission
  } with {
    briefly "Submit clinical data for a visit"
    described as {
      |Records data entry into the EDC system for a specific subject visit.
    }
  }
  command CloseStudy yields event StudyClosed is  {
    studyId: StudyId
    closureDate: Date
    closureReason: String
  } with {
    briefly "Close the clinical study"
    described as {
      |Marks the study as completed or terminated, triggering closeout procedures at all sites.
    }
  }
  command UpdateStudyStatus yields event StudyStatusUpdated is  {
    studyId: StudyId
    newStatus: StudyStatus
    effectiveDate: Date
    reason: String
  } with {
    briefly "Change the study status"
    described as {
      |Updates the operational status of the study, such as moving from Recruiting to Active Not Recruiting.
    }
  }
  // Events
  event StudyCreated is  {
    studyId: StudyId
    protocol: StudyProtocol
    createdAt: DateTime
  } with {
    briefly "A new clinical study was created"
    described as {
      |Indicates successful creation of a clinical study record.
    }
  }
  event SiteActivated is  {
    studyId: StudyId
    siteInfo: SiteInfo
    activatedAt: DateTime
  } with {
    briefly "A site was activated for the study"
    described as {
      |Indicates a site has completed initiation and can begin enrolling subjects.
    }
  }
  event SubjectEnrolled is  {
    studyId: StudyId
    enrollment: SubjectEnrollment
    enrolledAt: DateTime
  } with {
    briefly "A subject was enrolled in the study"
    described as {
      |Indicates successful enrollment of a subject after consent and eligibility verification.
    }
  }
  event VisitRecorded is  {
    studyId: StudyId
    visit: VisitRecord
    recordedAt: DateTime
  } with {
    briefly "A study visit was recorded"
    described as {
      |Indicates completion and documentation of a protocol-defined study visit.
    }
  }
  event DataSubmitted is  {
    studyId: StudyId
    submission: DataSubmission
    submittedAt: DateTime
  } with {
    briefly "Clinical data was submitted"
    described as {
      |Indicates data entry into the EDC system for review and cleaning.
    }
  }
  event StudyClosed is  {
    studyId: StudyId
    closureDate: Date
    closureReason: String
    finalStatus: StudyStatus
    closedAt: DateTime
  } with {
    briefly "The clinical study was closed"
    described as {
      |Indicates the study has reached its end state, either completed or terminated.
    }
  }
  event StudyStatusUpdated is  {
    studyId: StudyId
    previousStatus: StudyStatus
    newStatus: StudyStatus
    effectiveDate: Date
    reason: String
    updatedAt: DateTime
  } with {
    briefly "The study status was changed"
    described as {
      |Indicates a change in the operational status of the study.
    }
  }
  // States
  initial state DraftState of record DraftStateFields is {
    initial handler DraftStateInitHandler is {
      on query GetClinicalStudy is {
        let clinicalStudyResult: type ClinicalStudyResult = prompt("read the clinical study from the store")
        tell clinicalStudyResult to entity StudyContext.ClinicalStudy
      }
      on init is {
        let studyCreated: type StudyCreated = prompt("the study created that brings this clinical study into existence")
        yield studyCreated
      }
    } with {
      briefly "DraftState initialization"
      described as {
        |Initializes DraftState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Draft state"
    described as {
      |The draft state of the ClinicalStudy entity, carrying DraftStateFields.
    }
  }
  state ActiveState of record ActiveStateFields is {
    initial handler ActiveStateInitHandler is {
      on init is {
        let studyCreated: type StudyCreated = prompt("the study created that brings this clinical study into existence")
        yield studyCreated
      }
    } with {
      briefly "ActiveState initialization"
      described as {
        |Initializes ActiveState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |The active state of the ClinicalStudy entity, carrying ActiveStateFields.
    }
  }
  state ClosedState of record ClosedStateFields is {
    initial handler ClosedStateInitHandler is {
      on init is {
        let studyCreated: type StudyCreated = prompt("the study created that brings this clinical study into existence")
        yield studyCreated
      }
    } with {
      briefly "ClosedState initialization"
      described as {
        |Initializes ClosedState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Closed state"
    described as {
      |The closed state of the ClinicalStudy entity, carrying ClosedStateFields.
    }
  }
  // Handler
  handler ClinicalStudyHandler is {
    on createStudy: command CreateStudy is {
      yield event StudyCreated(studyId = createStudy.studyId, protocol = createStudy.protocol)
    }
    on activateSite: command ActivateSite is {
      yield event SiteActivated(studyId = activateSite.studyId, siteInfo = activateSite.siteInfo)
    }
    on enrollSubject: command EnrollSubject is {
      yield event SubjectEnrolled(studyId = enrollSubject.studyId, enrollment = enrollSubject.enrollment)
    }
    on recordVisit: command RecordVisit is {
      yield event VisitRecorded(studyId = recordVisit.studyId, visit = recordVisit.visit)
    }
    on submitData: command SubmitData is {
      yield event DataSubmitted(studyId = submitData.studyId, submission = submitData.submission)
    }
    on closeStudy: command CloseStudy is {
      yield event StudyClosed(studyId = closeStudy.studyId, closureDate = closeStudy.closureDate, closureReason = closeStudy.closureReason)
    }
    on updateStudyStatus: command UpdateStudyStatus is {
      yield event StudyStatusUpdated(studyId = updateStudyStatus.studyId, newStatus = updateStudyStatus.newStatus, effectiveDate = updateStudyStatus.effectiveDate, reason = updateStudyStatus.reason)
    }
    on event StudyCreated is {
      set field DraftState.studyId to "CreateStudy.studyId"
      set field DraftState.protocol to "CreateStudy.protocol"
    }
    on event SiteActivated is {
      do "apply SiteActivated to the current state"
    }
    on event SubjectEnrolled is {
      do "apply SubjectEnrolled to the current state"
    }
    on event VisitRecorded is {
      do "apply VisitRecorded to the current state"
    }
    on event DataSubmitted is {
      do "apply DataSubmitted to the current state"
    }
    on event StudyClosed is {
      do "apply StudyClosed to the current state"
    }
    on event StudyStatusUpdated is {
      do "apply StudyStatusUpdated to the current state"
    }
  } with {
    briefly "Command handler for ClinicalStudy"
    described as {
      |Processes all commands for clinical study lifecycle management.
    }
  }
} with {
  briefly "Aggregate root for clinical study management"
  described as {
    | The ClinicalStudy entity manages the complete lifecycle of a clinical
    | research study. It tracks protocol details, site activations, subject
    | enrollments, visit completions, and data submissions. This is an
    | event-sourced aggregate that maintains full audit history for
    | regulatory compliance.
  }
}
