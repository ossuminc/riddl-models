// Drug Supply Chain - DrugSupplyContext
// Bounded context for pharmaceutical supply chain management
context DrugSupplyContext is {
  adaptor FromManufacturingSystem from context ManufacturingSystem is { 
    handler FromManufacturingSystemHandler is {
      on event ManufacturingSystem.ProductionCompleteNotification is {
        do "the model receives production complete notification"
      }
      on event ManufacturingSystem.ProductionOrderReceived is {
        do "the model receives production order received"
      }
      on other is {
        error "Unexpected message for adaptor FromManufacturingSystem"
      }
    } with {
      briefly "from manufacturing system"
      described as {
        |Carries messages from the external ManufacturingSystem.
      }
    }
  } with {
    briefly "ManufacturingSystem integration"
    described as {
      |The model's side of the ManufacturingSystem conversation.
    }
  }
  adaptor FromRegulatoryReporting from context RegulatoryReporting is { 
    handler FromRegulatoryReportingHandler is {
      on event RegulatoryReporting.AdverseEventReportSubmitted is {
        do "the model receives adverse event report submitted"
      }
      on event RegulatoryReporting.RecallReportSubmitted is {
        do "the model receives recall report submitted"
      }
      on event RegulatoryReporting.TransactionReportSubmitted is {
        do "the model receives transaction report submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryReporting"
      }
    } with {
      briefly "from regulatory reporting"
      described as {
        |Carries messages from the external RegulatoryReporting.
      }
    }
  } with {
    briefly "RegulatoryReporting integration"
    described as {
      |The model's side of the RegulatoryReporting conversation.
    }
  }
  adaptor FromSerializationProvider from context SerializationProvider is { 
    handler FromSerializationProviderHandler is {
      on event SerializationProvider.SerialNumbersGenerated is {
        do "the model receives serial numbers generated"
      }
      on event SerializationProvider.VerificationCompleted is {
        do "the model receives verification completed"
      }
      on other is {
        error "Unexpected message for adaptor FromSerializationProvider"
      }
    } with {
      briefly "from serialization provider"
      described as {
        |Carries messages from the external SerializationProvider.
      }
    }
  } with {
    briefly "SerializationProvider integration"
    described as {
      |The model's side of the SerializationProvider conversation.
    }
  }
  include "types.riddl"
  include "DrugBatch.riddl"
  // Repository for batch persistence
  repository BatchRepository as merge is {
    inlet BatchRepositoryFromDrugBatch is type DrugBatchEvent    inlet BatchRepositoryFromTraceabilityDashboardProjector is type DrugBatchEvent    outlet BatchRepositoryResponses is type DrugBatch.DrugBatchResult
    record StoredDrugBatch is  {
      drugBatchId: UUID with {
        briefly "drugBatchId"
        described as {
          |The drugBatchId column of the stored drugBatch row.
        }
      }
      batchId: BatchId with {
        briefly "batchId"
        described as {
          |The batchId column of the stored drugBatch row.
        }
      }
      lotNumber: LotNumber with {
        briefly "lotNumber"
        described as {
          |The lotNumber column of the stored drugBatch row.
        }
      }
    } with {
      briefly "Stored drugBatch row"
      described as {
        |The persistence shape of drugBatch data as this repository stores it.
      }
    }
    schema BatchSchema is relational
      of batches as type StoredDrugBatch
        index on field StoredDrugBatch.batchId
        index on field StoredDrugBatch.lotNumber
 with {
      briefly "Batch schema schema"
      described as {
        |The relational schema holding batch schema for the BatchRepository.
      }
    }
    command PersistProductShipped is  {
      drugBatchId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ProductShipped"
      described as {
        |Instructs this repository to apply ProductShipped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentReceived is  {
      drugBatchId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ShipmentReceived"
      described as {
        |Instructs this repository to apply ShipmentReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBatchReleased is  {
      drugBatchId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist BatchReleased"
      described as {
        |Instructs this repository to apply BatchReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRecallInitiated is  {
      drugBatchId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist RecallInitiated"
      described as {
        |Instructs this repository to apply RecallInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBatchManufactured is  {
      drugBatchId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist BatchManufactured"
      described as {
        |Instructs this repository to apply BatchManufactured to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUnitsSerialized is  {
      drugBatchId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist UnitsSerialized"
      described as {
        |Instructs this repository to apply UnitsSerialized to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBatchPlacedOnHold is  {
      drugBatchId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist BatchPlacedOnHold"
      described as {
        |Instructs this repository to apply BatchPlacedOnHold to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler BatchPersistence is {
      on query GetTraceabilityDashboard is {
        do "read the traceability dashboard projection"
        reply result TraceabilityDashboardView
      }
      on command BatchRepository.PersistBatchManufactured is {
        do "Persist new batch to database"
      }
      on command BatchRepository.PersistUnitsSerialized is {
        do "Update batch with serialization data"
      }
      on command BatchRepository.PersistProductShipped is {
        do "Update batch status and shipment info"
      }
      on command BatchRepository.PersistShipmentReceived is {
        do "Update batch with receipt confirmation"
      }
      on command BatchRepository.PersistBatchPlacedOnHold is {
        do "Update batch to quality hold status"
      }
      on command BatchRepository.PersistBatchReleased is {
        do "Update batch to released status"
      }
      on command BatchRepository.PersistRecallInitiated is {
        do "Update batch to recalled status"
      }
    } with {
      briefly "Persists batch events to storage"
      described as {
        |Handles all event-driven persistence operations for batches.
      }
    }
  } with {
    briefly "Batch persistence repository"
    described as {
      | Repository for persisting and querying manufacturing batch
      | records with appropriate indexes for common access patterns.
    }
  }
  // Repository for serialization data
  repository SerializationRepository as sink is {
    inlet SerializationRepositoryFromSerializationMetricsProjector is type DrugBatchEvent    schema SerializationSchema is relational
      of serializations as type SerializationInfo
        index on field SerializationInfo.serialNumber
        index on field SerializationInfo.gtinCode
 with {
      briefly "Serialization schema schema"
      described as {
        |The relational schema holding serialization schema for the SerializationRepository.
      }
    }
    command PersistProductShipped is  {
      serializationId: String with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ProductShipped"
      described as {
        |Instructs this repository to apply ProductShipped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentReceived is  {
      serializationId: String with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ShipmentReceived"
      described as {
        |Instructs this repository to apply ShipmentReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUnitsSerialized is  {
      serializationId: String with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist UnitsSerialized"
      described as {
        |Instructs this repository to apply UnitsSerialized to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler SerializationPersistence is {
      on query GetSerializationMetrics is {
        do "read the serialization metrics projection"
        reply result SerializationMetricsView
      }
      on command SerializationRepository.PersistUnitsSerialized is {
        do "Store serialization records for units"
      }
      on command SerializationRepository.PersistProductShipped is {
        do "Update serialization location data"
      }
      on command SerializationRepository.PersistShipmentReceived is {
        do "Update serialization receipt status"
      }
    } with {
      briefly "Persists serialization commands"
      described as {
        |Handles persistence for serialization records.
      }
    }
  } with {
    briefly "Serialization data repository"
    described as {
      | Repository for persisting and querying DSCSA-compliant
      | serialization records with lookup by serial number and GTIN.
    }
  }
  // Projector for serialization metrics
  query GetSerializationMetrics is  {
    serializationMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which serialization metrics to retrieve.
      }
    }
  } with {
    briefly "Get serialization metrics"
    described as {
      |Retrieves the serialization metrics projection.
    }
  }
  result SerializationMetricsView is  {
    serializationMetrics: SerializationMetricsProjector.SerializationMetrics with {
      briefly "Serialization metrics"
      described as {
        |The serialization metrics being returned.
      }
    }
  } with {
    briefly "Serialization metrics view"
    described as {
      |Read model view carrying the serialization metrics projection.
    }
  }
  projector SerializationMetricsProjector as flow is {
    updates repository DrugSupplyContext.SerializationRepository
    inlet SerializationMetricsProjectorFromDrugBatch is type DrugBatchEvent    outlet SerializationMetricsProjectorOut is type DrugBatchEvent
    record SerializationMetrics is  {
      productGtin: GTINCode with {
        briefly "Product GTIN"
        described as {
          |The product being tracked.
        }
      }
      totalSerialized: Natural with {
        briefly "Total serialized"
        described as {
          |Total units serialized.
        }
      }
      totalShipped: Natural with {
        briefly "Total shipped"
        described as {
          |Total units shipped.
        }
      }
      totalReceived: Natural with {
        briefly "Total received"
        described as {
          |Total units received.
        }
      }
      totalVerified: Natural with {
        briefly "Total verified"
        described as {
          |Total units verified.
        }
      }
      suspectCount: Natural with {
        briefly "Suspect count"
        described as {
          |Units flagged as suspect.
        }
      }
      lastUpdated: TimeStamp with {
        briefly "Last updated"
        described as {
          |When metrics were last updated.
        }
      }
    } with {
      briefly "Serialization metrics record"
      described as {
        |Aggregated metrics for serialization activity by product.
      }
    }
    handler MetricsHandler is {
      on unitsSerialized: event DrugBatch.UnitsSerialized is {
        tell unitsSerialized to repository DrugSupplyContext.SerializationRepository
        do "Update serialization count"
      }
      on productShipped: event DrugBatch.ProductShipped is {
        tell productShipped to repository DrugSupplyContext.SerializationRepository
        do "Update shipment count"
      }
      on shipmentReceived: event DrugBatch.ShipmentReceived is {
        tell shipmentReceived to repository DrugSupplyContext.SerializationRepository
        do "Update receipt count"
      }
      on authenticityVerified: event DrugBatch.AuthenticityVerified is {
        tell authenticityVerified to repository DrugSupplyContext.SerializationRepository
        do "Update verification and suspect counts"
      }
    } with {
      briefly "Metrics projection handler"
      described as {
        |Maintains running metrics for serialization activity.
      }
    }
  } with {
    briefly "Serialization metrics projector"
    described as {
      | CQRS read model that maintains aggregated serialization metrics
      | for reporting and analytics, tracking counts of serialized,
      | shipped, received, and verified units by product.
    }
  }
  // Projector for traceability dashboard
  query GetTraceabilityDashboard is  {
    traceabilityDashboardKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which traceability dashboard to retrieve.
      }
    }
  } with {
    briefly "Get traceability dashboard"
    described as {
      |Retrieves the traceability dashboard projection.
    }
  }
  result TraceabilityDashboardView is  {
    traceabilityDashboard: TraceabilityDashboardProjector.TraceabilityDashboard with {
      briefly "Traceability dashboard"
      described as {
        |The traceability dashboard being returned.
      }
    }
  } with {
    briefly "Traceability dashboard view"
    described as {
      |Read model view carrying the traceability dashboard projection.
    }
  }
  projector TraceabilityDashboardProjector as flow is {
    updates repository DrugSupplyContext.BatchRepository
    inlet TraceabilityDashboardProjectorFromDrugBatch is type DrugBatchEvent    outlet TraceabilityDashboardProjectorOut is type DrugBatchEvent
    record TraceabilityDashboard is  {
      batchId: BatchId with {
        briefly "Batch identifier"
        described as {
          |The batch being tracked.
        }
      }
      productName: String(1,100) with {
        briefly "Product name"
        described as {
          |Name of the product.
        }
      }
      currentStatus: BatchStatus with {
        briefly "Current status"
        described as {
          |Current batch status.
        }
      }
      currentLocation: String(1,100) with {
        briefly "Current location"
        described as {
          |Current facility location.
        }
      }
      totalUnits: Natural with {
        briefly "Total units"
        described as {
          |Total units in batch.
        }
      }
      unitsInTransit: Natural with {
        briefly "In transit"
        described as {
          |Units currently in transit.
        }
      }
      unitsDelivered: Natural with {
        briefly "Delivered"
        described as {
          |Units successfully delivered.
        }
      }
      unitsRecalled: Natural with {
        briefly "Recalled"
        described as {
          |Units under recall.
        }
      }
      chainOfCustody: TraceabilityRecord+ with {
        briefly "Chain of custody"
        described as {
          |Complete custody chain.
        }
      }
      lastEvent: String(1,100) with {
        briefly "Last event"
        described as {
          |Most recent event type.
        }
      }
      lastEventTimestamp: TimeStamp with {
        briefly "Last event time"
        described as {
          |When last event occurred.
        }
      }
    } with {
      briefly "Traceability dashboard record"
      described as {
        | Comprehensive traceability view for a drug batch showing
        | current status, location, and complete chain of custody.
      }
    }
    handler DashboardHandler is {
      on batchManufactured: event DrugBatch.BatchManufactured is {
        tell batchManufactured to repository DrugSupplyContext.BatchRepository
        do "Initialize dashboard on manufacture"
      }
      on productShipped: event DrugBatch.ProductShipped is {
        tell productShipped to repository DrugSupplyContext.BatchRepository
        do "Update dashboard on shipment"
      }
      on shipmentReceived: event DrugBatch.ShipmentReceived is {
        tell shipmentReceived to repository DrugSupplyContext.BatchRepository
        do "Update dashboard on receipt"
      }
      on recallInitiated: event DrugBatch.RecallInitiated is {
        tell recallInitiated to repository DrugSupplyContext.BatchRepository
        do "Update dashboard on recall"
      }
    } with {
      briefly "Dashboard projection handler"
      described as {
        |Maintains traceability dashboard data from domain events.
      }
    }
  } with {
    briefly "Traceability dashboard projector"
    described as {
      | CQRS read model providing a comprehensive traceability view
      | for regulatory reporting and supply chain visibility dashboards.
    }
  }
  // ---- Event publication for DrugBatch ----
  type DrugBatchEvent is one of {
    DrugSupplyContext.DrugBatch.BatchManufactured or DrugSupplyContext.DrugBatch.UnitsSerialized or DrugSupplyContext.DrugBatch.ProductShipped or DrugSupplyContext.DrugBatch.ShipmentReceived or DrugSupplyContext.DrugBatch.AuthenticityVerified or DrugSupplyContext.DrugBatch.RecallInitiated or DrugSupplyContext.DrugBatch.BatchPlacedOnHold or DrugSupplyContext.DrugBatch.BatchReleased
  } with {
    briefly "DrugBatch event alternation"
    described as {
      |Union of all DrugBatch events, for streaming and event-sourced
      |persistence.
    }
  }
  processor DrugBatchEventSource as source is {
    outlet DrugBatchEvents is type DrugBatchEvent
    handler DrugBatchSourceHandler is {
      on batchManufactured: event DrugBatch.BatchManufactured is {
        send batchManufactured to outlet DrugBatchEvents
      }
      on unitsSerialized: event DrugBatch.UnitsSerialized is {
        send unitsSerialized to outlet DrugBatchEvents
      }
      on productShipped: event DrugBatch.ProductShipped is {
        send productShipped to outlet DrugBatchEvents
      }
      on shipmentReceived: event DrugBatch.ShipmentReceived is {
        send shipmentReceived to outlet DrugBatchEvents
      }
      on authenticityVerified: event DrugBatch.AuthenticityVerified is {
        send authenticityVerified to outlet DrugBatchEvents
      }
      on recallInitiated: event DrugBatch.RecallInitiated is {
        send recallInitiated to outlet DrugBatchEvents
      }
      on batchPlacedOnHold: event DrugBatch.BatchPlacedOnHold is {
        send batchPlacedOnHold to outlet DrugBatchEvents
      }
      on batchReleased: event DrugBatch.BatchReleased is {
        send batchReleased to outlet DrugBatchEvents
      }
      on other is {
        error "Unexpected message for source DrugBatchEventSource"
      }
    } with {
      briefly "DrugBatch source handler"
      described as {
        |Publishes DrugBatch events onto the outlet.
      }
    }
  } with {
    briefly "DrugBatch event source"
    described as {
      |Publishes DrugBatch entity events into the streaming topology.
    }
  }
  processor DrugBatchEventSink as sink is {
    inlet DrugBatchInlet is type DrugBatchEvent    handler DrugBatchSinkHandler is {
      on batchManufactured: event DrugBatch.BatchManufactured is {
        tell batchManufactured to repository DrugSupplyContext.BatchRepository
      }
      on unitsSerialized: event DrugBatch.UnitsSerialized is {
        tell unitsSerialized to repository DrugSupplyContext.BatchRepository
      }
      on productShipped: event DrugBatch.ProductShipped is {
        tell productShipped to repository DrugSupplyContext.BatchRepository
      }
      on shipmentReceived: event DrugBatch.ShipmentReceived is {
        tell shipmentReceived to repository DrugSupplyContext.BatchRepository
      }
      on authenticityVerified: event DrugBatch.AuthenticityVerified is {
        tell authenticityVerified to repository DrugSupplyContext.BatchRepository
      }
      on recallInitiated: event DrugBatch.RecallInitiated is {
        tell recallInitiated to repository DrugSupplyContext.BatchRepository
      }
      on batchPlacedOnHold: event DrugBatch.BatchPlacedOnHold is {
        tell batchPlacedOnHold to repository DrugSupplyContext.BatchRepository
      }
      on batchReleased: event DrugBatch.BatchReleased is {
        tell batchReleased to repository DrugSupplyContext.BatchRepository
      }
      on other is {
        error "Unexpected message for sink DrugBatchEventSink"
      }
    } with {
      briefly "DrugBatch sink handler"
      described as {
        |Persists DrugBatch events via the repository.
      }
    }
  } with {
    briefly "DrugBatch event sink"
    described as {
      |Receives DrugBatch events for persistence.
    }
  }
  connector DrugBatchEventFlow is from outlet DrugSupplyContext.DrugBatchEventSource.DrugBatchEvents to inlet DrugSupplyContext.DrugBatchEventSink.DrugBatchInlet with {
    briefly "DrugBatch event flow"
    described as {
      |Connects the DrugBatch source to its sink.
    }
  }
  processor DrugBatchEventSplit as split is {
    inlet DrugBatchEventSplitIn is type DrugBatchEvent    outlet DrugBatchEventSplitToBatchRepository is type DrugBatchEvent
    outlet DrugBatchEventSplitToSerializationMetricsProjector is type DrugBatchEvent
    outlet DrugBatchEventSplitToTraceabilityDashboardProjector is type DrugBatchEvent
    handler DrugBatchEventSplitHandler is {
      on batchManufactured: event DrugBatch.BatchManufactured is {
        send batchManufactured to outlet DrugBatchEventSplitToBatchRepository
        send batchManufactured to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send batchManufactured to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell batchManufactured to entity DrugSupplyContext.DrugBatch
      }
      on unitsSerialized: event DrugBatch.UnitsSerialized is {
        send unitsSerialized to outlet DrugBatchEventSplitToBatchRepository
        send unitsSerialized to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send unitsSerialized to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell unitsSerialized to entity DrugSupplyContext.DrugBatch
      }
      on productShipped: event DrugBatch.ProductShipped is {
        send productShipped to outlet DrugBatchEventSplitToBatchRepository
        send productShipped to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send productShipped to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell productShipped to entity DrugSupplyContext.DrugBatch
      }
      on shipmentReceived: event DrugBatch.ShipmentReceived is {
        send shipmentReceived to outlet DrugBatchEventSplitToBatchRepository
        send shipmentReceived to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send shipmentReceived to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell shipmentReceived to entity DrugSupplyContext.DrugBatch
      }
      on authenticityVerified: event DrugBatch.AuthenticityVerified is {
        send authenticityVerified to outlet DrugBatchEventSplitToBatchRepository
        send authenticityVerified to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send authenticityVerified to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell authenticityVerified to entity DrugSupplyContext.DrugBatch
      }
      on recallInitiated: event DrugBatch.RecallInitiated is {
        send recallInitiated to outlet DrugBatchEventSplitToBatchRepository
        send recallInitiated to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send recallInitiated to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell recallInitiated to entity DrugSupplyContext.DrugBatch
      }
      on batchPlacedOnHold: event DrugBatch.BatchPlacedOnHold is {
        send batchPlacedOnHold to outlet DrugBatchEventSplitToBatchRepository
        send batchPlacedOnHold to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send batchPlacedOnHold to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell batchPlacedOnHold to entity DrugSupplyContext.DrugBatch
      }
      on batchReleased: event DrugBatch.BatchReleased is {
        send batchReleased to outlet DrugBatchEventSplitToBatchRepository
        send batchReleased to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send batchReleased to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell batchReleased to entity DrugSupplyContext.DrugBatch
      }
      on other is {
        error "Unexpected message for processor DrugBatchEventSplit"
      }
    } with {
      briefly "DrugBatch event fan-out handler"
      described as {
        |Delivers each DrugBatch event to all of its consumers.
      }
    }
  } with {
    briefly "DrugBatch event fan-out"
    described as {
      |Fans DrugBatch events out to the repository and projectors.
    }
  }
  connector 'DrugBatchEvent Stream' is from outlet DrugSupplyContext.DrugBatch.DrugBatchEvents2 to inlet DrugSupplyContext.DrugBatchEventSplit.DrugBatchEventSplitIn with {
    briefly "DrugBatch events, fanned out to storage and read models"
  }
  connector 'DrugBatchEvent Storage' is from outlet DrugSupplyContext.DrugBatchEventSplit.DrugBatchEventSplitToBatchRepository to inlet DrugSupplyContext.BatchRepository.BatchRepositoryFromDrugBatch with {
    briefly "DrugBatch events on their way to storage"
  }
  connector 'SerializationMetricsProjector Feed' is from outlet DrugSupplyContext.DrugBatchEventSplit.DrugBatchEventSplitToSerializationMetricsProjector to inlet DrugSupplyContext.SerializationMetricsProjector.SerializationMetricsProjectorFromDrugBatch with {
    briefly "DrugBatch events feeding the SerializationMetricsProjector projection"
  }
  connector 'TraceabilityDashboardProjector Feed' is from outlet DrugSupplyContext.DrugBatchEventSplit.DrugBatchEventSplitToTraceabilityDashboardProjector to inlet DrugSupplyContext.TraceabilityDashboardProjector.TraceabilityDashboardProjectorFromDrugBatch with {
    briefly "DrugBatch events feeding the TraceabilityDashboardProjector projection"
  }
  connector 'SerializationMetricsProjector Storage' is from outlet DrugSupplyContext.SerializationMetricsProjector.SerializationMetricsProjectorOut to inlet DrugSupplyContext.SerializationRepository.SerializationRepositoryFromSerializationMetricsProjector with {
    briefly "The SerializationMetricsProjector projection on its way to storage"
  }
  connector 'TraceabilityDashboardProjector Storage' is from outlet DrugSupplyContext.TraceabilityDashboardProjector.TraceabilityDashboardProjectorOut to inlet DrugSupplyContext.BatchRepository.BatchRepositoryFromTraceabilityDashboardProjector with {
    briefly "The TraceabilityDashboardProjector projection on its way to storage"
  }
} with {
  briefly "Drug supply chain bounded context"
  described as {
    | Core bounded context for pharmaceutical supply chain management,
    | encompassing batch tracking, DSCSA-compliant serialization,
    | distribution management, and regulatory traceability for life
    | sciences applications.
  }
}
