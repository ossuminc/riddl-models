// Drug Supply Chain - DrugSupplyContext
// Bounded context for pharmaceutical supply chain management
context DrugSupplyContext is {
  include "types.riddl"
  include "DrugBatch.riddl"
  // Repository for batch persistence
  repository BatchRepository is {
    inlet BatchRepositoryFromDrugBatch is type DrugBatchEvent
    inlet BatchRepositoryFromTraceabilityDashboardProjector is type DrugBatchEvent
    outlet BatchRepositoryResponses is type DrugBatch.DrugBatchResult
    schema BatchSchema is relational
      of batches as type DrugBatch
        index on field DrugBatch.batchId
        index on field DrugBatch.lotNumber
      with {
      briefly "Batch schema schema"
      described as {
        |The relational schema holding batch schema for the BatchRepository.
      }
    }

    handler BatchPersistence is {
      on command DrugBatch.ManufactureBatch is {
        do "Persist new batch to database"
      }
      on command DrugBatch.SerializeUnits is {
        do "Update batch with serialization data"
      }
      on command DrugBatch.ShipProduct is {
        tell event DrugBatch.ProductShipped to entity DrugSupplyContext.DrugBatch
        do "Update batch status and shipment info"
      }
      on command DrugBatch.ReceiveShipment is {
        tell event DrugBatch.ShipmentReceived to entity DrugSupplyContext.DrugBatch
        do "Update batch with receipt confirmation"
      }
      on command DrugBatch.PlaceOnQualityHold is {
        do "Update batch to quality hold status"
      }
      on command DrugBatch.ReleaseBatch is {
        tell event DrugBatch.BatchReleased to entity DrugSupplyContext.DrugBatch
        do "Update batch to released status"
      }
      on command DrugBatch.InitiateRecall is {
        tell event DrugBatch.RecallInitiated to entity DrugSupplyContext.DrugBatch
        do "Update batch to recalled status"
      }
    } with {
      briefly "Persists batch events to storage"
      described as {
        |Handles all event-driven persistence operations for batches.
      }
    }
  } with {
    briefly "Batch persistence repository"
    described as {
      | Repository for persisting and querying manufacturing batch
      | records with appropriate indexes for common access patterns.
    }
  }
  // Repository for serialization data
  repository SerializationRepository is {
    inlet SerializationRepositoryFromSerializationMetricsProjector is type DrugBatchEvent
    schema SerializationSchema is relational
      of serializations as type SerializationInfo
        index on field SerializationInfo.serialNumber
        index on field SerializationInfo.gtinCode
      with {
      briefly "Serialization schema schema"
      described as {
        |The relational schema holding serialization schema for the SerializationRepository.
      }
    }

    handler SerializationPersistence is {
      on command DrugBatch.SerializeUnits is {
        do "Store serialization records for units"
      }
      on command DrugBatch.ShipProduct is {
        tell event DrugBatch.ProductShipped to entity DrugSupplyContext.DrugBatch
        do "Update serialization location data"
      }
      on command DrugBatch.ReceiveShipment is {
        tell event DrugBatch.ShipmentReceived to entity DrugSupplyContext.DrugBatch
        do "Update serialization receipt status"
      }
    } with {
      briefly "Persists serialization commands"
      described as {
        |Handles persistence for serialization records.
      }
    }
  } with {
    briefly "Serialization data repository"
    described as {
      | Repository for persisting and querying DSCSA-compliant
      | serialization records with lookup by serial number and GTIN.
    }
  }
  // Projector for serialization metrics
  projector SerializationMetricsProjector is {
    inlet SerializationMetricsProjectorFromDrugBatch is type DrugBatchEvent
    outlet SerializationMetricsProjectorOut is type DrugBatchEvent
    updates repository DrugSupplyContext.SerializationRepository
    record SerializationMetrics is  {
      productGtin: GTINCode with {
        briefly "Product GTIN"
        described as {
          |The product being tracked.
        }
      }
      totalSerialized: Natural with {
        briefly "Total serialized"
        described as {
          |Total units serialized.
        }
      }
      totalShipped: Natural with {
        briefly "Total shipped"
        described as {
          |Total units shipped.
        }
      }
      totalReceived: Natural with {
        briefly "Total received"
        described as {
          |Total units received.
        }
      }
      totalVerified: Natural with {
        briefly "Total verified"
        described as {
          |Total units verified.
        }
      }
      suspectCount: Natural with {
        briefly "Suspect count"
        described as {
          |Units flagged as suspect.
        }
      }
      lastUpdated: TimeStamp with {
        briefly "Last updated"
        described as {
          |When metrics were last updated.
        }
      }
    } with {
      briefly "Serialization metrics record"
      described as {
        |Aggregated metrics for serialization activity by product.
      }
    }
    handler MetricsHandler is {
      on event DrugBatch.UnitsSerialized is {
        tell event DrugBatch.UnitsSerialized to repository DrugSupplyContext.SerializationRepository
        do "Update serialization count"
      }
      on event DrugBatch.ProductShipped is {
        tell event DrugBatch.ProductShipped to repository DrugSupplyContext.SerializationRepository
        do "Update shipment count"
      }
      on event DrugBatch.ShipmentReceived is {
        tell event DrugBatch.ShipmentReceived to repository DrugSupplyContext.SerializationRepository
        do "Update receipt count"
      }
      on event DrugBatch.AuthenticityVerified is {
        tell event DrugBatch.AuthenticityVerified to repository DrugSupplyContext.SerializationRepository
        do "Update verification and suspect counts"
      }
    } with {
      briefly "Metrics projection handler"
      described as {
        |Maintains running metrics for serialization activity.
      }
    }
  } with {
    briefly "Serialization metrics projector"
    described as {
      | CQRS read model that maintains aggregated serialization metrics
      | for reporting and analytics, tracking counts of serialized,
      | shipped, received, and verified units by product.
    }
  }
  // Projector for traceability dashboard
  projector TraceabilityDashboardProjector is {
    inlet TraceabilityDashboardProjectorFromDrugBatch is type DrugBatchEvent
    outlet TraceabilityDashboardProjectorOut is type DrugBatchEvent
    updates repository DrugSupplyContext.BatchRepository
    record TraceabilityDashboard is  {
      batchId: BatchId with {
        briefly "Batch identifier"
        described as {
          |The batch being tracked.
        }
      }
      productName: String(1,100) with {
        briefly "Product name"
        described as {
          |Name of the product.
        }
      }
      currentStatus: BatchStatus with {
        briefly "Current status"
        described as {
          |Current batch status.
        }
      }
      currentLocation: String(1,100) with {
        briefly "Current location"
        described as {
          |Current facility location.
        }
      }
      totalUnits: Natural with {
        briefly "Total units"
        described as {
          |Total units in batch.
        }
      }
      unitsInTransit: Natural with {
        briefly "In transit"
        described as {
          |Units currently in transit.
        }
      }
      unitsDelivered: Natural with {
        briefly "Delivered"
        described as {
          |Units successfully delivered.
        }
      }
      unitsRecalled: Natural with {
        briefly "Recalled"
        described as {
          |Units under recall.
        }
      }
      chainOfCustody: TraceabilityRecord+ with {
        briefly "Chain of custody"
        described as {
          |Complete custody chain.
        }
      }
      lastEvent: String(1,100) with {
        briefly "Last event"
        described as {
          |Most recent event type.
        }
      }
      lastEventTimestamp: TimeStamp with {
        briefly "Last event time"
        described as {
          |When last event occurred.
        }
      }
    } with {
      briefly "Traceability dashboard record"
      described as {
        | Comprehensive traceability view for a drug batch showing
        | current status, location, and complete chain of custody.
      }
    }
    handler DashboardHandler is {
      on event DrugBatch.BatchManufactured is {
        tell event DrugBatch.BatchManufactured to repository DrugSupplyContext.BatchRepository
        do "Initialize dashboard on manufacture"
      }
      on event DrugBatch.ProductShipped is {
        tell event DrugBatch.ProductShipped to repository DrugSupplyContext.BatchRepository
        do "Update dashboard on shipment"
      }
      on event DrugBatch.ShipmentReceived is {
        tell event DrugBatch.ShipmentReceived to repository DrugSupplyContext.BatchRepository
        do "Update dashboard on receipt"
      }
      on event DrugBatch.RecallInitiated is {
        tell event DrugBatch.RecallInitiated to repository DrugSupplyContext.BatchRepository
        do "Update dashboard on recall"
      }
    } with {
      briefly "Dashboard projection handler"
      described as {
        |Maintains traceability dashboard data from domain events.
      }
    }
  } with {
    briefly "Traceability dashboard projector"
    described as {
      | CQRS read model providing a comprehensive traceability view
      | for regulatory reporting and supply chain visibility dashboards.
    }
  }
  // ---- Event publication for DrugBatch ----
  type DrugBatchEvent is one of {
    DrugSupplyContext.DrugBatch.BatchManufactured,
    DrugSupplyContext.DrugBatch.UnitsSerialized,
    DrugSupplyContext.DrugBatch.ProductShipped,
    DrugSupplyContext.DrugBatch.ShipmentReceived,
    DrugSupplyContext.DrugBatch.AuthenticityVerified,
    DrugSupplyContext.DrugBatch.RecallInitiated,
    DrugSupplyContext.DrugBatch.BatchPlacedOnHold,
    DrugSupplyContext.DrugBatch.BatchReleased
  } with {
    briefly "DrugBatch event alternation"
    described as {
      |Union of all DrugBatch events, for streaming and event-sourced
      |persistence.
    }
  }
  processor DrugBatchEventSource as source is {
    outlet DrugBatchEvents is type DrugBatchEvent
    handler DrugBatchSourceHandler is {
      on event DrugBatch.BatchManufactured is {
        send event DrugBatch.BatchManufactured to outlet DrugBatchEvents
      }
      on event DrugBatch.UnitsSerialized is {
        send event DrugBatch.UnitsSerialized to outlet DrugBatchEvents
      }
      on event DrugBatch.ProductShipped is {
        send event DrugBatch.ProductShipped to outlet DrugBatchEvents
      }
      on event DrugBatch.ShipmentReceived is {
        send event DrugBatch.ShipmentReceived to outlet DrugBatchEvents
      }
      on event DrugBatch.AuthenticityVerified is {
        send event DrugBatch.AuthenticityVerified to outlet DrugBatchEvents
      }
      on event DrugBatch.RecallInitiated is {
        send event DrugBatch.RecallInitiated to outlet DrugBatchEvents
      }
      on event DrugBatch.BatchPlacedOnHold is {
        send event DrugBatch.BatchPlacedOnHold to outlet DrugBatchEvents
      }
      on event DrugBatch.BatchReleased is {
        send event DrugBatch.BatchReleased to outlet DrugBatchEvents
      }
      on other is {
        error "Unexpected message for source DrugBatchEventSource"
      }
    } with {
      briefly "DrugBatch source handler"
      described as {
        |Publishes DrugBatch events onto the outlet.
      }
    }
  } with {
    briefly "DrugBatch event source"
    described as {
      |Publishes DrugBatch entity events into the streaming topology.
    }
  }
  processor DrugBatchEventSink as sink is {
    inlet DrugBatchInlet is type DrugBatchEvent
    handler DrugBatchSinkHandler is {
      on event DrugBatch.BatchManufactured is {
        tell event DrugBatch.BatchManufactured to repository DrugSupplyContext.BatchRepository
      }
      on event DrugBatch.UnitsSerialized is {
        tell event DrugBatch.UnitsSerialized to repository DrugSupplyContext.BatchRepository
      }
      on event DrugBatch.ProductShipped is {
        tell event DrugBatch.ProductShipped to repository DrugSupplyContext.BatchRepository
      }
      on event DrugBatch.ShipmentReceived is {
        tell event DrugBatch.ShipmentReceived to repository DrugSupplyContext.BatchRepository
      }
      on event DrugBatch.AuthenticityVerified is {
        tell event DrugBatch.AuthenticityVerified to repository DrugSupplyContext.BatchRepository
      }
      on event DrugBatch.RecallInitiated is {
        tell event DrugBatch.RecallInitiated to repository DrugSupplyContext.BatchRepository
      }
      on event DrugBatch.BatchPlacedOnHold is {
        tell event DrugBatch.BatchPlacedOnHold to repository DrugSupplyContext.BatchRepository
      }
      on event DrugBatch.BatchReleased is {
        tell event DrugBatch.BatchReleased to repository DrugSupplyContext.BatchRepository
      }
      on other is {
        error "Unexpected message for sink DrugBatchEventSink"
      }
    } with {
      briefly "DrugBatch sink handler"
      described as {
        |Persists DrugBatch events via the repository.
      }
    }
  } with {
    briefly "DrugBatch event sink"
    described as {
      |Receives DrugBatch events for persistence.
    }
  }
  connector DrugBatchEventFlow is {
    from outlet DrugSupplyContext.DrugBatchEventSource.DrugBatchEvents to
      inlet DrugSupplyContext.DrugBatchEventSink.DrugBatchInlet
  } with {
    briefly "DrugBatch event flow"
    described as {
      |Connects the DrugBatch source to its sink.
    }
  }
  processor DrugBatchEventSplit is {
    inlet DrugBatchEventSplitIn is type DrugBatchEvent
    outlet DrugBatchEventSplitToBatchRepository is type DrugBatchEvent
    outlet DrugBatchEventSplitToSerializationMetricsProjector is type DrugBatchEvent
    outlet DrugBatchEventSplitToTraceabilityDashboardProjector is type DrugBatchEvent
    handler DrugBatchEventSplitHandler is {
      on event DrugBatch.BatchManufactured is {
        send event DrugBatch.BatchManufactured to outlet DrugBatchEventSplitToBatchRepository
        send event DrugBatch.BatchManufactured to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send event DrugBatch.BatchManufactured to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell event DrugBatch.BatchManufactured to entity DrugSupplyContext.DrugBatch
      }
      on event DrugBatch.UnitsSerialized is {
        send event DrugBatch.UnitsSerialized to outlet DrugBatchEventSplitToBatchRepository
        send event DrugBatch.UnitsSerialized to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send event DrugBatch.UnitsSerialized to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell event DrugBatch.UnitsSerialized to entity DrugSupplyContext.DrugBatch
      }
      on event DrugBatch.ProductShipped is {
        send event DrugBatch.ProductShipped to outlet DrugBatchEventSplitToBatchRepository
        send event DrugBatch.ProductShipped to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send event DrugBatch.ProductShipped to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell event DrugBatch.ProductShipped to entity DrugSupplyContext.DrugBatch
      }
      on event DrugBatch.ShipmentReceived is {
        send event DrugBatch.ShipmentReceived to outlet DrugBatchEventSplitToBatchRepository
        send event DrugBatch.ShipmentReceived to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send event DrugBatch.ShipmentReceived to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell event DrugBatch.ShipmentReceived to entity DrugSupplyContext.DrugBatch
      }
      on event DrugBatch.AuthenticityVerified is {
        send event DrugBatch.AuthenticityVerified to outlet DrugBatchEventSplitToBatchRepository
        send event DrugBatch.AuthenticityVerified to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send event DrugBatch.AuthenticityVerified to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell event DrugBatch.AuthenticityVerified to entity DrugSupplyContext.DrugBatch
      }
      on event DrugBatch.RecallInitiated is {
        send event DrugBatch.RecallInitiated to outlet DrugBatchEventSplitToBatchRepository
        send event DrugBatch.RecallInitiated to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send event DrugBatch.RecallInitiated to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell event DrugBatch.RecallInitiated to entity DrugSupplyContext.DrugBatch
      }
      on event DrugBatch.BatchPlacedOnHold is {
        send event DrugBatch.BatchPlacedOnHold to outlet DrugBatchEventSplitToBatchRepository
        send event DrugBatch.BatchPlacedOnHold to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send event DrugBatch.BatchPlacedOnHold to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell event DrugBatch.BatchPlacedOnHold to entity DrugSupplyContext.DrugBatch
      }
      on event DrugBatch.BatchReleased is {
        send event DrugBatch.BatchReleased to outlet DrugBatchEventSplitToBatchRepository
        send event DrugBatch.BatchReleased to outlet DrugBatchEventSplitToSerializationMetricsProjector
        send event DrugBatch.BatchReleased to outlet DrugBatchEventSplitToTraceabilityDashboardProjector
        tell event DrugBatch.BatchReleased to entity DrugSupplyContext.DrugBatch
      }
      on other is {
        error "Unexpected message for processor DrugBatchEventSplit"
      }
    } with {
      briefly "DrugBatch event fan-out handler"
      described as {
        |Delivers each DrugBatch event to all of its consumers.
      }
    }
  } with {
    briefly "DrugBatch event fan-out"
    described as {
      |Fans DrugBatch events out to the repository and projectors.
    }
  }
  connector LinkDrugBatchToDrugBatchEventSplit is {
    from outlet DrugSupplyContext.DrugBatch.DrugBatchEvents2 to
      inlet DrugSupplyContext.DrugBatchEventSplit.DrugBatchEventSplitIn
  } with {
    briefly "LinkDrugBatchToDrugBatchEventSplit"
  }
  connector LinkDrugBatchEventSplitToBatchRepository is {
    from outlet DrugSupplyContext.DrugBatchEventSplit.DrugBatchEventSplitToBatchRepository to
      inlet DrugSupplyContext.BatchRepository.BatchRepositoryFromDrugBatch
  } with {
    briefly "LinkDrugBatchEventSplitToBatchRepository"
  }
  connector LinkDrugBatchEventSplitToSerializationMetricsProjector is {
    from outlet DrugSupplyContext.DrugBatchEventSplit.DrugBatchEventSplitToSerializationMetricsProjector to
      inlet DrugSupplyContext.SerializationMetricsProjector.SerializationMetricsProjectorFromDrugBatch
  } with {
    briefly "LinkDrugBatchEventSplitToSerializationMetricsProjector"
  }
  connector LinkDrugBatchEventSplitToTraceabilityDashboardProjector is {
    from outlet DrugSupplyContext.DrugBatchEventSplit.DrugBatchEventSplitToTraceabilityDashboardProjector to
      inlet DrugSupplyContext.TraceabilityDashboardProjector.TraceabilityDashboardProjectorFromDrugBatch
  } with {
    briefly "LinkDrugBatchEventSplitToTraceabilityDashboardProjector"
  }
  connector LinkSerializationMetricsProjectorToSerializationRepository is {
    from outlet DrugSupplyContext.SerializationMetricsProjector.SerializationMetricsProjectorOut to
      inlet DrugSupplyContext.SerializationRepository.SerializationRepositoryFromSerializationMetricsProjector
  } with {
    briefly "LinkSerializationMetricsProjectorToSerializationRepository"
  }
  connector LinkTraceabilityDashboardProjectorToBatchRepository is {
    from outlet DrugSupplyContext.TraceabilityDashboardProjector.TraceabilityDashboardProjectorOut to
      inlet DrugSupplyContext.BatchRepository.BatchRepositoryFromTraceabilityDashboardProjector
  } with {
    briefly "LinkTraceabilityDashboardProjectorToBatchRepository"
  }
} with {
  briefly "Drug supply chain bounded context"
  described as {
    | Core bounded context for pharmaceutical supply chain management,
    | encompassing batch tracking, DSCSA-compliant serialization,
    | distribution management, and regulatory traceability for life
    | sciences applications.
  }
}
