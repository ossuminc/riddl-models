// Supply Order entity for managing the procurement lifecycle
aggregate event-sourced entity SupplyOrder as flow is {
  type SupplyOrderCommand is one of {
    SupplyOrder.CreateRequisition or SupplyOrder.ApproveRequisition or SupplyOrder.PlaceOrder or SupplyOrder.ReceiveShipment or SupplyOrder.IssueSupplies
  } with {
    briefly "SupplyOrder command alternation"
    described as {
      |Commands accepted by the SupplyOrder entity.
    }
  }
  inlet SupplyOrderCommands is type SupplyOrderCommand  outlet SupplyOrderEvents2 is type SupplyOrderEvent
  query GetSupplyOrder is  {
    supplyOrderId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the SupplyOrder to retrieve.
      }
    }
  } with {
    briefly "Get SupplyOrder"
    described as {
      |Retrieve SupplyOrder data by identifier.
    }
  }
  result SupplyOrderResult is  {
    supplyOrderId: PurchaseOrderId with {
      briefly "SupplyOrder addressed"
      described as {
        |Which supplyorder this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    supplyOrderData: SupplyOrder.DraftStateData with {
      briefly "SupplyOrder data"
      described as {
        |The requested SupplyOrder data.
      }
    }
  } with {
    briefly "SupplyOrder result"
    described as {
      |Result carrying the requested SupplyOrder data.
    }
  }
  // ==========================================================================
  // Commands
  // ==========================================================================
  command CreateRequisition yields event RequisitionCreated is  {
    requisitionId: String
    requestedBy: String
    requestDate: DateTime
    items: PurchaseOrderLine+
    justification: String
    urgency: String
  } with {
    briefly "Create a new supply requisition"
    described as {
      | Initiates a new requisition for supplies. The requisition must include
      | at least one line item and justification for the request. Urgency can
      | be routine, urgent, or emergency which affects approval routing.
    }
  }
  command ApproveRequisition yields event RequisitionApproved is  {
    requisitionId: String
    approvedBy: String
    approvalDate: DateTime
    approvalNotes: String
  } with {
    briefly "Approve a pending requisition"
    described as {
      | Approves a requisition that is pending approval. Only authorized
      | approvers can approve requisitions. Approval moves the requisition
      | to the approved state where it can be converted to a purchase order.
    }
  }
  command PlaceOrder yields event OrderPlaced is  {
    purchaseOrderId: PurchaseOrderId
    requisitionId: String
    vendorId: String
    expectedDeliveryDate: Date
    shippingMethod: String
    specialInstructions: String
  } with {
    briefly "Convert approved requisition to purchase order"
    described as {
      | Creates a purchase order from an approved requisition and sends
      | it to the specified vendor. The buyer selects the vendor based
      | on pricing, availability, and contract terms.
    }
  }
  command ReceiveShipment yields event ShipmentReceived is  {
    receiptId: ReceiptId
    purchaseOrderId: PurchaseOrderId
    receiptDate: DateTime
    receivedBy: String
    lines: ReceiptLine+
    vendorPackingSlip: String
    discrepancyNotes: String
  } with {
    briefly "Record receipt of a vendor shipment"
    described as {
      | Records the receipt of goods from a vendor. The storekeeper verifies
      | quantities against the purchase order and records any discrepancies.
      | Lot numbers and expiration dates are captured for tracked items.
    }
  }
  command IssueSupplies yields event SuppliesIssued is  {
    issueId: String
    requestId: String
    itemId: ItemId
    quantityIssued: Integer
    issuedBy: String
    lotNumber: String
    departmentCharged: String
  } with {
    briefly "Issue supplies to a requesting department"
    described as {
      | Records the issuance of supplies to a clinical department. The
      | storekeeper picks items (using FEFO for expiration-tracked items),
      | delivers them, and records the transaction for inventory and
      | cost accounting.
    }
  }
  // ==========================================================================
  // Events
  // ==========================================================================
  event RequisitionCreated is  {
    supplyOrderId: PurchaseOrderId with {
      briefly "SupplyOrder addressed"
      described as {
        |Which supplyorder this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    requisitionId: String
    requestedBy: String
    requestDate: DateTime
    items: PurchaseOrderLine+
    justification: String
    urgency: String
  } with {
    briefly "A new requisition has been created"
    described as {
      | Indicates that a new requisition has been entered into the system
      | and is awaiting approval. The requisition contains the requested
      | items and justification for the purchase.
    }
  }
  event RequisitionApproved is  {
    supplyOrderId: PurchaseOrderId with {
      briefly "SupplyOrder addressed"
      described as {
        |Which supplyorder this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    requisitionId: String
    approvedBy: String
    approvalDate: DateTime
    approvalNotes: String
  } with {
    briefly "A requisition has been approved"
    described as {
      | Indicates that a requisition has been approved by an authorized
      | approver and is now ready to be converted to a purchase order.
    }
  }
  event OrderPlaced is  {
    purchaseOrderId: PurchaseOrderId
    requisitionId: String
    vendorId: String
    orderDate: Date
    expectedDeliveryDate: Date
    totalAmount: Decimal(12,2)
  } with {
    briefly "A purchase order has been placed with a vendor"
    described as {
      | Indicates that a purchase order has been created and transmitted
      | to the vendor. The order is now in the procurement pipeline awaiting
      | shipment.
    }
  }
  event ShipmentReceived is  {
    receiptId: ReceiptId
    purchaseOrderId: PurchaseOrderId
    receiptDate: DateTime
    receivedBy: String
    linesReceived: Integer
    totalQuantityReceived: Integer
    hasDiscrepancies: Boolean
  } with {
    briefly "A shipment has been received from a vendor"
    described as {
      | Indicates that a shipment has arrived and been processed. The event
      | summarizes what was received and flags if there were any discrepancies
      | requiring follow-up with the vendor.
    }
  }
  event SuppliesIssued is  {
    supplyOrderId: PurchaseOrderId with {
      briefly "SupplyOrder addressed"
      described as {
        |Which supplyorder this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    issueId: String
    requestId: String
    itemId: ItemId
    quantityIssued: Integer
    issueDate: DateTime
    departmentCharged: String
    costCharged: Decimal(12,2)
  } with {
    briefly "Supplies have been issued to a department"
    described as {
      | Indicates that supplies have been picked, delivered, and recorded
      | as issued to a clinical department. The cost has been charged to
      | the department's supply budget.
    }
  }
  // ==========================================================================
  // State Data Types
  // ==========================================================================
  record DraftStateData is  {
    requisitionId: String
    requestedBy: String
    requestDate: DateTime
    items: PurchaseOrderLine*
    justification: String
    urgency: String
  } with {
    briefly "Data for draft requisition state"
    described as {
      |Contains requisition data while in draft mode.
    }
  }
  record PendingApprovalStateData is  {
    requisitionId: String
    requestedBy: String
    requestDate: DateTime
    items: PurchaseOrderLine+
    justification: String
    urgency: String
    submittedDate: DateTime
  } with {
    briefly "Data for pending approval state"
    described as {
      |Contains requisition data awaiting management approval.
    }
  }
  record ApprovedStateData is  {
    requisitionId: String
    requestedBy: String
    items: PurchaseOrderLine+
    approvedBy: String
    approvalDate: DateTime
    approvalNotes: String
  } with {
    briefly "Data for approved requisition state"
    described as {
      |Contains approved requisition ready for ordering.
    }
  }
  record OrderedStateData is  {
    purchaseOrderId: PurchaseOrderId
    requisitionId: String
    vendorId: String
    orderDate: Date
    expectedDeliveryDate: Date
    lines: PurchaseOrderLine+
    totalAmount: Decimal(12,2)
  } with {
    briefly "Data for ordered state"
    described as {
      |Contains purchase order information after vendor submission.
    }
  }
  record PartiallyReceivedStateData is  {
    purchaseOrderId: PurchaseOrderId
    vendorId: String
    lines: PurchaseOrderLine+
    receipts: Receipt*
    totalOrdered: Integer
    totalReceived: Integer
  } with {
    briefly "Data for partially received state"
    described as {
      |Contains order data with partial receipt information.
    }
  }
  record FullyReceivedStateData is  {
    purchaseOrderId: PurchaseOrderId
    vendorId: String
    lines: PurchaseOrderLine+
    receipts: Receipt+
    completionDate: DateTime
  } with {
    briefly "Data for fully received state"
    described as {
      |Contains complete receipt information.
    }
  }
  record ClosedStateData is  {
    purchaseOrderId: PurchaseOrderId
    closedDate: DateTime
    closedBy: String
    finalAmount: Decimal(12,2)
  } with {
    briefly "Data for closed order state"
    described as {
      |Contains final reconciled order information.
    }
  }
  // ==========================================================================
  // States
  // ==========================================================================
  initial state DraftState of record SupplyOrder.DraftStateData is {
    initial handler DraftStateInitHandler is {
      on query GetSupplyOrder is {
        let supplyOrderResult: type SupplyOrderResult = prompt("read the supply order from the store")
        tell supplyOrderResult to entity SupplyContext.SupplyOrder
      }
      on init is {
        let requisitionCreated: type RequisitionCreated = prompt("the requisition created that brings this supply order into existence")
        yield requisitionCreated
      }
    } with {
      briefly "DraftState init handler"
      described as {
        |Initializes the DraftState state.
      }
    }
  } with {
    briefly "DraftState state"
    described as {
      |The DraftState state of the SupplyOrder.
    }
  }
  state PendingApprovalState of record SupplyOrder.PendingApprovalStateData is {
    initial handler PendingApprovalStateInitHandler is {
      on init is {
        let requisitionCreated: type RequisitionCreated = prompt("the requisition created that brings this supply order into existence")
        yield requisitionCreated
      }
    } with {
      briefly "PendingApprovalState init handler"
      described as {
        |Initializes the PendingApprovalState state.
      }
    }
  } with {
    briefly "PendingApprovalState state"
    described as {
      |The PendingApprovalState state of the SupplyOrder.
    }
  }
  state ApprovedState of record SupplyOrder.ApprovedStateData is {
    initial handler ApprovedStateInitHandler is {
      on init is {
        let requisitionApproved: type RequisitionApproved = prompt("the requisition approved that brings this supply order into existence")
        yield requisitionApproved
      }
    } with {
      briefly "ApprovedState init handler"
      described as {
        |Initializes the ApprovedState state.
      }
    }
  } with {
    briefly "ApprovedState state"
    described as {
      |The ApprovedState state of the SupplyOrder.
    }
  }
  state OrderedState of record SupplyOrder.OrderedStateData is {
    initial handler OrderedStateInitHandler is {
      on init is {
        let orderPlaced: type OrderPlaced = prompt("the order placed that brings this supply order into existence")
        yield orderPlaced
      }
    } with {
      briefly "OrderedState init handler"
      described as {
        |Initializes the OrderedState state.
      }
    }
  } with {
    briefly "OrderedState state"
    described as {
      |The OrderedState state of the SupplyOrder.
    }
  }
  state PartiallyReceivedState of record SupplyOrder.PartiallyReceivedStateData is {
    initial handler PartiallyReceivedStateInitHandler is {
      on init is {
        let requisitionCreated: type RequisitionCreated = prompt("the requisition created that brings this supply order into existence")
        yield requisitionCreated
      }
    } with {
      briefly "PartiallyReceivedState init handler"
      described as {
        |Initializes the PartiallyReceivedState state.
      }
    }
  } with {
    briefly "PartiallyReceivedState state"
    described as {
      |The PartiallyReceivedState state of the SupplyOrder.
    }
  }
  state FullyReceivedState of record SupplyOrder.FullyReceivedStateData is {
    initial handler FullyReceivedStateInitHandler is {
      on init is {
        let shipmentReceived: type ShipmentReceived = prompt("the shipment received that brings this supply order into existence")
        yield shipmentReceived
      }
    } with {
      briefly "FullyReceivedState init handler"
      described as {
        |Initializes the FullyReceivedState state.
      }
    }
  } with {
    briefly "FullyReceivedState state"
    described as {
      |The FullyReceivedState state of the SupplyOrder.
    }
  }
  state ClosedState of record SupplyOrder.ClosedStateData is {
    initial handler ClosedStateInitHandler is {
      on init is {
        let requisitionCreated: type RequisitionCreated = prompt("the requisition created that brings this supply order into existence")
        yield requisitionCreated
      }
    } with {
      briefly "ClosedState init handler"
      described as {
        |Initializes the ClosedState state.
      }
    }
  } with {
    briefly "ClosedState state"
    described as {
      |The ClosedState state of the SupplyOrder.
    }
  }
  // ==========================================================================
  // Handler
  // ==========================================================================
  handler SupplyOrderHandler is {
    on createRequisition: command CreateRequisition is {
      yield event RequisitionCreated(requisitionId = createRequisition.requisitionId, requestedBy = createRequisition.requestedBy, requestDate = createRequisition.requestDate, items = createRequisition.items, justification = createRequisition.justification, urgency = createRequisition.urgency, supplyOrderId = prompt("the supply order id of this requisition created"))
    }
    on approveRequisition: command ApproveRequisition is {
      yield event RequisitionApproved(requisitionId = approveRequisition.requisitionId, approvedBy = approveRequisition.approvedBy, approvalDate = approveRequisition.approvalDate, approvalNotes = approveRequisition.approvalNotes, supplyOrderId = prompt("the supply order id of this requisition approved"))
    }
    on placeOrder: command PlaceOrder is {
      yield event OrderPlaced(purchaseOrderId = placeOrder.purchaseOrderId, requisitionId = placeOrder.requisitionId, vendorId = placeOrder.vendorId, expectedDeliveryDate = placeOrder.expectedDeliveryDate, orderDate = prompt("the order date of this order placed"), totalAmount = prompt("the total amount of this order placed"))
    }
    on receiveShipment: command ReceiveShipment is {
      yield event ShipmentReceived(receiptId = receiveShipment.receiptId, purchaseOrderId = receiveShipment.purchaseOrderId, receiptDate = receiveShipment.receiptDate, receivedBy = receiveShipment.receivedBy, linesReceived = prompt("the lines received of this shipment received"), totalQuantityReceived = prompt("the total quantity received of this shipment received"), hasDiscrepancies = prompt("the has discrepancies of this shipment received"))
    }
    on issueSupplies: command IssueSupplies is {
      yield event SuppliesIssued(issueId = issueSupplies.issueId, requestId = issueSupplies.requestId, itemId = issueSupplies.itemId, quantityIssued = issueSupplies.quantityIssued, departmentCharged = issueSupplies.departmentCharged, supplyOrderId = prompt("the supply order id of this supplies issued"), issueDate = prompt("the issue date of this supplies issued"), costCharged = prompt("the cost charged of this supplies issued"))
      do "Supplies issued to department"
    }
    on other is {
      error "Unknown command received"
    }
    on requisitionCreated: event RequisitionCreated is {
      morph entity SupplyOrder to state SupplyOrder.PendingApprovalState with record SupplyOrder.PendingApprovalStateData(requisitionId = requisitionCreated.requisitionId, requestedBy = requisitionCreated.requestedBy, requestDate = requisitionCreated.requestDate, items = requisitionCreated.items, justification = requisitionCreated.justification, urgency = requisitionCreated.urgency, submittedDate = prompt("the submitted date of this pending approval state data"))
    }
    on requisitionApproved: event RequisitionApproved is {
      morph entity SupplyOrder to state SupplyOrder.ApprovedState with record SupplyOrder.ApprovedStateData(requisitionId = requisitionApproved.requisitionId, approvedBy = requisitionApproved.approvedBy, approvalDate = requisitionApproved.approvalDate, approvalNotes = requisitionApproved.approvalNotes, requestedBy = prompt("the requested by of this approved state data"), items = prompt("the items of this approved state data"))
    }
    on orderPlaced: event OrderPlaced is {
      morph entity SupplyOrder to state SupplyOrder.OrderedState with record SupplyOrder.OrderedStateData(purchaseOrderId = orderPlaced.purchaseOrderId, requisitionId = orderPlaced.requisitionId, vendorId = orderPlaced.vendorId, orderDate = orderPlaced.orderDate, expectedDeliveryDate = orderPlaced.expectedDeliveryDate, totalAmount = orderPlaced.totalAmount, lines = prompt("the lines of this ordered state data"))
    }
    on shipmentReceived: event ShipmentReceived is {
      morph entity SupplyOrder to state SupplyOrder.FullyReceivedState with record SupplyOrder.FullyReceivedStateData(purchaseOrderId = shipmentReceived.purchaseOrderId, vendorId = prompt("the vendor id of this fully received state data"), lines = prompt("the lines of this fully received state data"), receipts = prompt("the receipts of this fully received state data"), completionDate = prompt("the completion date of this fully received state data"))
    }
    on event SuppliesIssued is {
      do "apply SuppliesIssued to the current state"
    }
  } with {
    briefly "Command handler for supply order lifecycle"
    described as {
      | Handles all commands related to the supply order lifecycle,
      | from requisition creation through receipt and issuance. Each
      | command is validated before processing and appropriate events
      | are emitted for downstream consumers.
    }
  }
} with {
  briefly "Entity managing the supply order procurement lifecycle"
  described as {
    | The SupplyOrder entity is the aggregate root for the procurement
    | process. It manages the complete lifecycle from requisition creation
    | through approval, ordering, receipt, and closure. The entity is
    | event-sourced, maintaining a complete audit trail of all supply
    | chain activities for compliance and analysis.
  }
}
