domain HospitalSupplyChain is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "The author of this domain model"
    described as {
      |Ossum Inc. provides reactive system design and RIDDL tooling.
    }
  }
  user MaterialsManager is "healthcare supply chain manager responsible for inventory levels and procurement" with {
    briefly "Materials management professional"
    described as {
      | The Materials Manager oversees the entire supply chain operation
      | for the hospital, ensuring adequate stock levels while minimizing
      | carrying costs and preventing stockouts of critical medical supplies.
    }
  }
  user Buyer is "procurement specialist who places and manages purchase orders" with {
    briefly "Procurement specialist"
    described as {
      | The Buyer handles vendor relationships, negotiates contracts,
      | places purchase orders, and tracks order fulfillment. They work
      | closely with Materials Managers to ensure timely procurement.
    }
  }
  user StoreKeeper is "warehouse staff who receives, stores, and issues supplies" with {
    briefly "Warehouse operations staff"
    described as {
      | The StoreKeeper manages physical inventory operations including
      | receiving shipments, verifying quantities, storing items properly,
      | and issuing supplies to clinical departments on request.
    }
  }
  epic MedicalSupplyManagement is {
    user MaterialsManager wants to "to manage hospital medical supply inventory efficiently" so that "clinical departments always have necessary supplies without excessive stockpiling"
    case RequisitionWorkflow is {
      user MaterialsManager wants to "to create and approve supply requisitions" so that "procurement can begin for needed items"
      step from output HospitalSupplyChainApp.SupplyChainScreen.InventoryLevelsView "reviews inventory levels and par levels" to user MaterialsManager
      step from user MaterialsManager "creates requisition for low-stock items" to input HospitalSupplyChainApp.SupplyChainScreen.CreateRequisitionInput
      step from user MaterialsManager "approves requisition for procurement" to input HospitalSupplyChainApp.SupplyChainScreen.ApproveRequisitionInput
    } with {
      briefly "Workflow for creating and approving requisitions"
      described as {
        | This use case covers the requisition workflow from identifying
        | low inventory through approval for procurement. Materials managers
        | monitor par levels and initiate requisitions when stock falls below
        | minimum thresholds.
      }
    }
    case ProcurementWorkflow is {
      user Buyer wants to "to convert requisitions into purchase orders" so that "vendors can fulfill supply needs"
      step from output HospitalSupplyChainApp.SupplyChainScreen.ApprovedRequisitionsView "reviews approved requisitions" to user Buyer
      step from user Buyer "selects vendor and creates purchase order" to input HospitalSupplyChainApp.SupplyChainScreen.PlaceOrderInput
      step from context SupplyContext "sends order to vendor" to context VendorCatalog
      step from context VendorCatalog "acknowledges order" to context SupplyContext
    } with {
      briefly "Workflow for purchasing from vendors"
      described as {
        | This use case covers the procurement process where buyers convert
        | approved requisitions into purchase orders, select appropriate
        | vendors based on pricing and availability, and submit orders for
        | fulfillment.
      }
    }
    case ReceivingWorkflow is {
      user StoreKeeper wants to "to receive and verify incoming shipments" so that "inventory is accurately updated and discrepancies are caught"
      step from user StoreKeeper "receives shipment from vendor" to input HospitalSupplyChainApp.SupplyChainScreen.ReceiveShipmentInput
      step from user StoreKeeper "verifies quantities against purchase order" to input HospitalSupplyChainApp.SupplyChainScreen.VerifyReceiptInput
      step from context SupplyContext "updates inventory quantities" to context SupplyContext
      step from context SupplyContext "notifies finance of receipt" to context FinanceAP
    } with {
      briefly "Workflow for receiving shipments"
      described as {
        | This use case covers the receiving process where storekeepers
        | accept incoming shipments, verify quantities and quality against
        | purchase orders, and update inventory records. Discrepancies are
        | documented for vendor follow-up.
      }
    }
    case IssuanceWorkflow is {
      user StoreKeeper wants to "to issue supplies to clinical departments" so that "patient care areas have necessary materials"
      step from context ClinicalUsage "requests supplies from store" to context SupplyContext
      step from user StoreKeeper "picks items from warehouse" to input HospitalSupplyChainApp.SupplyChainScreen.IssueSuppliesInput
      step from user StoreKeeper "delivers to requesting department" to input HospitalSupplyChainApp.SupplyChainScreen.IssueSuppliesInput
      step from context SupplyContext "decrements inventory" to context SupplyContext
    } with {
      briefly "Workflow for issuing supplies to departments"
      described as {
        | This use case covers the issuance process where clinical departments
        | request supplies and storekeepers fulfill those requests by picking,
        | delivering, and recording the inventory decrement.
      }
    }
  } with {
    briefly "Medical supply management epic"
    described as {
      | This epic encompasses the complete lifecycle of medical supply
      | management in a hospital setting, from identifying reorder needs
      | through procurement, receiving, and issuance to clinical departments.
      | It ensures continuity of patient care through reliable supply availability.
    }
  }
  include "types.riddl"
  include "SupplyContext.riddl"
  include "external-contexts.riddl"
  application context HospitalSupplyChainApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in HospitalSupplyChain are delivered.
      }
    }
    group SupplyChainScreen is {
      output InventoryLevelsView presents result SupplyContext.SupplyOrder.SupplyOrderResult with {
        briefly "Inventory levels view"
        described as {
          |Shows materials managers current stock against par levels.
        }
      }
      input CreateRequisitionInput acquires command SupplyContext.SupplyOrder.CreateRequisition with {
        briefly "Create requisition control"
        described as {
          |Where a materials manager raises a requisition for low-stock items.
        }
      }
      input ApproveRequisitionInput acquires command SupplyContext.SupplyOrder.ApproveRequisition with {
        briefly "Approve requisition control"
        described as {
          |Where a materials manager approves a requisition for procurement.
        }
      }
      output ApprovedRequisitionsView presents result SupplyContext.SupplyOrder.SupplyOrderResult with {
        briefly "Approved requisitions view"
        described as {
          |Shows buyers the requisitions approved for ordering.
        }
      }
      input PlaceOrderInput acquires command SupplyContext.SupplyOrder.PlaceOrder with {
        briefly "Place order control"
        described as {
          |Where a buyer selects a vendor and raises a purchase order.
        }
      }
      input ReceiveShipmentInput acquires command SupplyContext.SupplyOrder.ReceiveShipment with {
        briefly "Receive shipment control"
        described as {
          |Where a storekeeper records a shipment received from a vendor.
        }
      }
      input VerifyReceiptInput acquires command SupplyContext.SupplyOrder.ReceiveShipment with {
        briefly "Verify receipt control"
        described as {
          |Where a storekeeper verifies received quantities against the purchase order.
        }
      }
      input IssueSuppliesInput acquires command SupplyContext.SupplyOrder.IssueSupplies with {
        briefly "Issue supplies control"
        described as {
          |Where a storekeeper picks and issues items to a department.
        }
      }
    } with {
      briefly "Supply chain screen"
      described as {
        |The screens through which supply chain staff act on supply orders.
      }
    }
    outlet AppSupplyOrderCommands is type SupplyContext.SupplyOrder.SupplyOrderCommand
    inlet AppInventoryRepositoryResponses is type SupplyContext.SupplyOrder.SupplyOrderResult    handler HospitalSupplyChainAppHandler is {
      on other is {
        error "Unexpected message for application context HospitalSupplyChainApp"
      }
    } with {
      briefly "HospitalSupplyChainApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "HospitalSupplyChainApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'SupplyOrderCommand Stream' is from outlet HospitalSupplyChainApp.AppSupplyOrderCommands to inlet SupplyContext.SupplyOrder.SupplyOrderCommands with {
    briefly "SupplyOrder commands from the application"
  }
  persistent connector 'StockItemResult Stream' is from outlet SupplyContext.InventoryRepository.InventoryRepositoryResponses to inlet HospitalSupplyChainApp.AppInventoryRepositoryResponses with {
    briefly "Inventory query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet HospitalSupplyChainApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term Department is  "A hospital department requesting supplies from the store." 
  briefly "Hospital supply chain management domain"
  described as {
    | The Hospital Supply Chain domain manages the procurement, storage,
    | and distribution of medical supplies within a healthcare facility.
    | It ensures clinical departments have access to necessary supplies
    | while optimizing inventory costs and preventing stockouts of
    | critical items. The domain integrates with vendor systems, finance,
    | and clinical usage tracking to provide end-to-end supply visibility.
  }
}
