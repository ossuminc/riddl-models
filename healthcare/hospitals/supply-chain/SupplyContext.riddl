// Supply Context - the main bounded context for hospital supply chain
context SupplyContext is {
  adaptor FromClinicalUsage from context ClinicalUsage is { 
    handler FromClinicalUsageHandler is {
      on event ClinicalUsage.ParLevelBreach is {
        do "the model receives par level breach"
      }
      on event ClinicalUsage.SupplyConsumed is {
        do "the model receives supply consumed"
      }
      on event ClinicalUsage.SupplyRequested is {
        do "the model receives supply requested"
      }
      on other is {
        error "Unexpected message for adaptor FromClinicalUsage"
      }
    } with {
      briefly "from clinical usage"
      described as {
        |Carries messages from the external ClinicalUsage.
      }
    }
  } with {
    briefly "ClinicalUsage integration"
    described as {
      |The model's side of the ClinicalUsage conversation.
    }
  }
  adaptor ToClinicalUsage to context ClinicalUsage is { 
    handler ToClinicalUsageHandler is {
      on command ClinicalUsage.ReportConsumption is {
        do "the model sends report consumption"
      }
      on command ClinicalUsage.RequestSupplies is {
        do "the model sends request supplies"
      }
      on other is {
        error "Unexpected message for adaptor ToClinicalUsage"
      }
    } with {
      briefly "to clinical usage"
      described as {
        |Carries messages to the external ClinicalUsage.
      }
    }
  } with {
    briefly "ClinicalUsage integration"
    described as {
      |The model's side of the ClinicalUsage conversation.
    }
  }
  adaptor FromFinanceAP from context FinanceAP is { 
    handler FromFinanceAPHandler is {
      on event FinanceAP.InvoiceReceived is {
        do "the model receives invoice received"
      }
      on event FinanceAP.MatchException is {
        do "the model receives match exception"
      }
      on event FinanceAP.PaymentScheduled is {
        do "the model receives payment scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromFinanceAP"
      }
    } with {
      briefly "from finance ap"
      described as {
        |Carries messages from the external FinanceAP.
      }
    }
  } with {
    briefly "FinanceAP integration"
    described as {
      |The model's side of the FinanceAP conversation.
    }
  }
  adaptor ToFinanceAP to context FinanceAP is { 
    handler ToFinanceAPHandler is {
      on command FinanceAP.NotifyReceipt is {
        do "the model sends notify receipt"
      }
      on command FinanceAP.ResolveMatchException is {
        do "the model sends resolve match exception"
      }
      on other is {
        error "Unexpected message for adaptor ToFinanceAP"
      }
    } with {
      briefly "to finance ap"
      described as {
        |Carries messages to the external FinanceAP.
      }
    }
  } with {
    briefly "FinanceAP integration"
    described as {
      |The model's side of the FinanceAP conversation.
    }
  }
  adaptor FromVendorCatalog from context VendorCatalog is { 
    handler FromVendorCatalogHandler is {
      on event VendorCatalog.CatalogUpdated is {
        do "the model receives catalog updated"
      }
      on event VendorCatalog.PriceChanged is {
        do "the model receives price changed"
      }
      on other is {
        error "Unexpected message for adaptor FromVendorCatalog"
      }
    } with {
      briefly "from vendor catalog"
      described as {
        |Carries messages from the external VendorCatalog.
      }
    }
  } with {
    briefly "VendorCatalog integration"
    described as {
      |The model's side of the VendorCatalog conversation.
    }
  }
  adaptor ToVendorCatalog to context VendorCatalog is { 
    handler ToVendorCatalogHandler is {
      on command VendorCatalog.LookupVendorItem is {
        do "the model sends lookup vendor item"
      }
      on command VendorCatalog.SubmitPurchaseOrder is {
        do "the model sends submit purchase order"
      }
      on other is {
        error "Unexpected message for adaptor ToVendorCatalog"
      }
    } with {
      briefly "to vendor catalog"
      described as {
        |Carries messages to the external VendorCatalog.
      }
    }
  } with {
    briefly "VendorCatalog integration"
    described as {
      |The model's side of the VendorCatalog conversation.
    }
  }
  type ItemId is UUID with {
    briefly "Unique identifier for a supply item"
    described as {
      |A system-generated identifier that uniquely identifies each supply item in the inventory catalog.
    }
  }
  type ReceiptId is UUID with {
    briefly "Unique identifier for a receipt transaction"
    described as {
      |A system-generated identifier for tracking goods receipt transactions when shipments arrive.
    }
  }
  type PurchaseOrderId is Id(SupplyOrder)  with {
    briefly "Unique identifier for a purchase order"
    described as {
      |A system-generated identifier for tracking purchase orders through the procurement lifecycle.
    }
  }
  include "SupplyOrder.riddl"
  // ==========================================================================
  // Repository
  // ==========================================================================
  repository InventoryRepository as merge is {
    record StoredSupplyOrder is  {
      supplyOrderId: UUID with {
        briefly "supplyOrderId"
        described as {
          |The supplyOrderId column of the stored supplyOrder row.
        }
      }
    } with {
      briefly "Stored supplyOrder row"
      described as {
        |The persistence shape of supplyOrder data as this repository stores it.
      }
    }
    schema SupplyOrderData is relational
      of supplyorders as type StoredSupplyOrder
 with {
      briefly "Supply order data schema"
      described as {
        |The relational schema persisting supply order records for this repository.
      }
    }
    inlet InventoryRepositoryFromSupplyOrder is type SupplyOrderEvent    inlet InventoryRepositoryFromInventoryMetricsProjector is type SupplyOrderEvent    outlet InventoryRepositoryResponses is type SupplyOrder.SupplyOrderResult
    query GetItemById is  { itemId: ItemId } with {
      briefly "Retrieve item by ID"
      described as {
        |Fetches a single supply item by its unique identifier.
      }
    }
    query GetParLevels is  { locationCode: String } with {
      briefly "Get par levels for a location"
      described as {
        |Retrieves all par level configurations for a specific storage location.
      }
    }
    query GetInventoryPosition is  {
      itemId: ItemId
      locationCode: String
    } with {
      briefly "Get current inventory position"
      described as {
        |Retrieves the current stock position for an item at a location.
      }
    }
    query GetIssuanceHistory is  {
      departmentCode: String
      filterStartDate: Date
      filterEndDate: Date
    } with {
      briefly "Get issuance history for a department"
      described as {
        |Retrieves historical issuance records for a department within a date range.
      }
    }
    query GetItemsBelowParLevel is  { locationCode: String } with {
      briefly "Find items needing reorder"
      described as {
        |Identifies all items at a location where current quantity is below reorder point.
      }
    }
    query GetPurchaseOrderById is  { purchaseOrderId: PurchaseOrderId } with {
      briefly "Retrieve purchase order by ID"
      described as {
        |Fetches a single purchase order by its unique identifier.
      }
    }
    query GetPendingRequisitions is  { approverCode: String? } with {
      briefly "Get requisitions awaiting approval"
      described as {
        |Retrieves requisitions in pending approval status for review.
      }
    }
    query GetOpenOrders is  {
      vendorId: String?
      startDate: Date?
      endDate: Date?
    } with {
      briefly "Get open purchase orders"
      described as {
        |Retrieves purchase orders that have not been fully received.
      }
    }
    handler InventoryRepositoryHandler is {
      on query GetMetricsSummary is {
        let metricsSummaryView: type MetricsSummaryView = prompt("read the metrics summary projection")
        reply metricsSummaryView
      }
      on query GetTurnoverMetrics is {
        let turnoverMetricsView: type TurnoverMetricsView = prompt("read the turnover metrics projection")
        reply turnoverMetricsView
      }
      on query GetVendorPerformance is {
        let vendorPerformanceView: type VendorPerformanceView = prompt("read the vendor performance projection")
        reply vendorPerformanceView
      }
      on query GetItemById is {
        do "Retrieve item from item master"
      }
      on query GetParLevels is {
        do "Query par levels by location"
      }
      on query GetInventoryPosition is {
        do "Calculate current position from events"
      }
      on query GetIssuanceHistory is {
        do "Query issuance events for department"
      }
      on query GetItemsBelowParLevel is {
        do "Find items where on-hand is below reorder point"
      }
      on query GetPurchaseOrderById is {
        reply result SupplyOrderResult
        do "Retrieve purchase order from event store"
      }
      on query GetPendingRequisitions is {
        do "Query requisitions in pending approval state"
      }
      on query GetOpenOrders is {
        reply result SupplyOrderResult
        do "Query orders not in closed state"
      }
      on other is {
        error "Unknown repository query"
      }
    } with {
      briefly "Query handler for inventory data"
      described as {
        | Handles queries for inventory data including item lookups,
        | par level retrieval, current positions, and historical issuance
        | records. Supports the various inventory management workflows.
      }
    }
  } with {
    briefly "Repository for inventory data persistence"
    described as {
      | The InventoryRepository manages persistent storage and retrieval
      | of inventory-related data including the item catalog, par level
      | configurations, current inventory positions, and issuance history.
      | It supports both transactional updates and analytical queries.
    }
  }
  // ==========================================================================
  // Projector
  // ==========================================================================
  query GetMetricsSummary is  {
    metricsSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which metrics summary to retrieve.
      }
    }
  } with {
    briefly "Get metrics summary"
    described as {
      |Retrieves the metrics summary projection.
    }
  }
  result MetricsSummaryView is  {
    metricsSummary: InventoryMetricsProjector.MetricsSummary with {
      briefly "Metrics summary"
      described as {
        |The metrics summary being returned.
      }
    }
  } with {
    briefly "Metrics summary view"
    described as {
      |Read model view carrying the metrics summary projection.
    }
  }
  query GetTurnoverMetrics is  {
    turnoverMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which turnover metrics to retrieve.
      }
    }
  } with {
    briefly "Get turnover metrics"
    described as {
      |Retrieves the turnover metrics projection.
    }
  }
  result TurnoverMetricsView is  {
    turnoverMetrics: InventoryMetricsProjector.TurnoverMetrics with {
      briefly "Turnover metrics"
      described as {
        |The turnover metrics being returned.
      }
    }
  } with {
    briefly "Turnover metrics view"
    described as {
      |Read model view carrying the turnover metrics projection.
    }
  }
  query GetVendorPerformance is  {
    vendorPerformanceKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which vendor performance to retrieve.
      }
    }
  } with {
    briefly "Get vendor performance"
    described as {
      |Retrieves the vendor performance projection.
    }
  }
  result VendorPerformanceView is  {
    vendorPerformance: InventoryMetricsProjector.VendorPerformance with {
      briefly "Vendor performance"
      described as {
        |The vendor performance being returned.
      }
    }
  } with {
    briefly "Vendor performance view"
    described as {
      |Read model view carrying the vendor performance projection.
    }
  }
  projector InventoryMetricsProjector as flow is {
    updates repository SupplyContext.InventoryRepository
    inlet InventoryMetricsProjectorFromSupplyOrder is type SupplyOrderEvent    outlet InventoryMetricsProjectorOut is type SupplyOrderEvent
    record MetricsSummary is  {
      locationCode: String
      totalItemCount: Integer
      itemsBelowParLevel: Integer
      itemsAtZero: Integer
      totalInventoryValue: Decimal(12,2)
      pendingOrdersCount: Integer
      pendingOrdersValue: Decimal(12,2)
      averageDaysOnHand: Decimal(12,2)
      stockoutIncidents: Integer
      lastUpdated: DateTime
    } with {
      briefly "Summary metrics for inventory management"
      described as {
        | Aggregated metrics providing a dashboard view of inventory health
        | at a location. Includes counts of problem items, financial totals,
        | and key performance indicators for supply chain effectiveness.
      }
    }
    record TurnoverMetrics is  {
      itemId: ItemId
      periodStart: Date
      periodEnd: Date
      beginningQuantity: Integer
      endingQuantity: Integer
      totalIssued: Integer
      totalReceived: Integer
      turnoverRate: Decimal(12,2)
      daysOfSupply: Decimal(10,2)
    } with {
      briefly "Inventory turnover metrics per item"
      described as {
        | Turnover metrics for a specific item over a time period. Used to
        | analyze inventory efficiency, identify slow-moving stock, and
        | optimize par level settings.
      }
    }
    record VendorPerformance is  {
      vendorId: String
      vendorName: String
      totalOrders: Integer
      onTimeDeliveryRate: Decimal(12,2)
      accurateShipmentRate: Decimal(12,2)
      averageLeadTimeDays: Decimal(12,2)
      totalSpend: Decimal(12,2)
      lastOrderDate: Date
    } with {
      briefly "Vendor delivery performance metrics"
      described as {
        | Performance metrics for a vendor including on-time delivery rate,
        | shipment accuracy, and average lead time. Used for vendor evaluation
        | and selection decisions.
      }
    }
    handler MetricsHandler is {
      on shipmentReceived: event ShipmentReceived is {
        tell shipmentReceived to repository SupplyContext.InventoryRepository
        do "Update inventory position and vendor metrics"
      }
      on suppliesIssued: event SuppliesIssued is {
        tell suppliesIssued to repository SupplyContext.InventoryRepository
        do "Update inventory position and turnover metrics"
      }
      on orderPlaced: event OrderPlaced is {
        tell orderPlaced to repository SupplyContext.InventoryRepository
        do "Update pending order metrics"
      }
      on requisitionCreated: event RequisitionCreated is {
        tell requisitionCreated to repository SupplyContext.InventoryRepository
        do "Update requisition counts"
      }
      on other is {
        do "Ignore other events"
      }
    } with {
      briefly "Event handler for metrics projection"
      described as {
        | Processes supply chain events to maintain real-time inventory
        | metrics. Updates positions, calculates turnover rates, and
        | tracks vendor performance based on actual transactions.
      }
    }
  } with {
    briefly "Projector for inventory analytics and dashboards"
    described as {
      | The InventoryMetricsProjector consumes supply chain events to
      | build and maintain analytical views of inventory data. It provides
      | real-time metrics for dashboards, alerts for low-stock conditions,
      | and historical analysis for inventory optimization.
    }
  }
  // ---- Event publication for SupplyOrder ----
  type SupplyOrderEvent is one of {
    SupplyContext.SupplyOrder.RequisitionCreated or SupplyContext.SupplyOrder.RequisitionApproved or SupplyContext.SupplyOrder.OrderPlaced or SupplyContext.SupplyOrder.ShipmentReceived or SupplyContext.SupplyOrder.SuppliesIssued
  } with {
    briefly "SupplyOrder event alternation"
    described as {
      |Union of all SupplyOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor SupplyOrderEventSource as source is {
    outlet SupplyOrderEvents is type SupplyOrderEvent
    handler SupplyOrderSourceHandler is {
      on requisitionCreated: event SupplyOrder.RequisitionCreated is {
        send requisitionCreated to outlet SupplyOrderEvents
      }
      on requisitionApproved: event SupplyOrder.RequisitionApproved is {
        send requisitionApproved to outlet SupplyOrderEvents
      }
      on orderPlaced: event SupplyOrder.OrderPlaced is {
        send orderPlaced to outlet SupplyOrderEvents
      }
      on shipmentReceived: event SupplyOrder.ShipmentReceived is {
        send shipmentReceived to outlet SupplyOrderEvents
      }
      on suppliesIssued: event SupplyOrder.SuppliesIssued is {
        send suppliesIssued to outlet SupplyOrderEvents
      }
      on other is {
        error "Unexpected message for source SupplyOrderEventSource"
      }
    } with {
      briefly "SupplyOrder source handler"
      described as {
        |Publishes SupplyOrder events onto the outlet.
      }
    }
  } with {
    briefly "SupplyOrder event source"
    described as {
      |Publishes SupplyOrder entity events into the streaming topology.
    }
  }
  processor SupplyOrderEventSink as sink is {
    inlet SupplyOrderInlet is type SupplyOrderEvent    handler SupplyOrderSinkHandler is {
      on requisitionCreated: event SupplyOrder.RequisitionCreated is {
        tell requisitionCreated to repository SupplyContext.InventoryRepository
      }
      on requisitionApproved: event SupplyOrder.RequisitionApproved is {
        tell requisitionApproved to repository SupplyContext.InventoryRepository
      }
      on orderPlaced: event SupplyOrder.OrderPlaced is {
        tell orderPlaced to repository SupplyContext.InventoryRepository
      }
      on shipmentReceived: event SupplyOrder.ShipmentReceived is {
        tell shipmentReceived to repository SupplyContext.InventoryRepository
      }
      on suppliesIssued: event SupplyOrder.SuppliesIssued is {
        tell suppliesIssued to repository SupplyContext.InventoryRepository
      }
      on other is {
        error "Unexpected message for sink SupplyOrderEventSink"
      }
    } with {
      briefly "SupplyOrder sink handler"
      described as {
        |Persists SupplyOrder events via the repository.
      }
    }
  } with {
    briefly "SupplyOrder event sink"
    described as {
      |Receives SupplyOrder events for persistence.
    }
  }
  connector SupplyOrderEventFlow is from outlet SupplyContext.SupplyOrderEventSource.SupplyOrderEvents to inlet SupplyContext.SupplyOrderEventSink.SupplyOrderInlet with {
    briefly "SupplyOrder event flow"
    described as {
      |Connects the SupplyOrder source to its sink.
    }
  }
  processor SupplyOrderEventSplit as split is {
    inlet SupplyOrderEventSplitIn is type SupplyOrderEvent    outlet SupplyOrderEventSplitToInventoryRepository is type SupplyOrderEvent
    outlet SupplyOrderEventSplitToInventoryMetricsProjector is type SupplyOrderEvent
    handler SupplyOrderEventSplitHandler is {
      on requisitionCreated: event SupplyOrder.RequisitionCreated is {
        send requisitionCreated to outlet SupplyOrderEventSplitToInventoryRepository
        send requisitionCreated to outlet SupplyOrderEventSplitToInventoryMetricsProjector
        tell requisitionCreated to entity SupplyContext.SupplyOrder
      }
      on requisitionApproved: event SupplyOrder.RequisitionApproved is {
        send requisitionApproved to outlet SupplyOrderEventSplitToInventoryRepository
        send requisitionApproved to outlet SupplyOrderEventSplitToInventoryMetricsProjector
        tell requisitionApproved to entity SupplyContext.SupplyOrder
      }
      on orderPlaced: event SupplyOrder.OrderPlaced is {
        send orderPlaced to outlet SupplyOrderEventSplitToInventoryRepository
        send orderPlaced to outlet SupplyOrderEventSplitToInventoryMetricsProjector
        tell orderPlaced to entity SupplyContext.SupplyOrder
      }
      on shipmentReceived: event SupplyOrder.ShipmentReceived is {
        send shipmentReceived to outlet SupplyOrderEventSplitToInventoryRepository
        send shipmentReceived to outlet SupplyOrderEventSplitToInventoryMetricsProjector
        tell shipmentReceived to entity SupplyContext.SupplyOrder
      }
      on suppliesIssued: event SupplyOrder.SuppliesIssued is {
        send suppliesIssued to outlet SupplyOrderEventSplitToInventoryRepository
        send suppliesIssued to outlet SupplyOrderEventSplitToInventoryMetricsProjector
        tell suppliesIssued to entity SupplyContext.SupplyOrder
      }
      on other is {
        error "Unexpected message for processor SupplyOrderEventSplit"
      }
    } with {
      briefly "SupplyOrder event fan-out handler"
      described as {
        |Delivers each SupplyOrder event to all of its consumers.
      }
    }
  } with {
    briefly "SupplyOrder event fan-out"
    described as {
      |Fans SupplyOrder events out to the repository and projectors.
    }
  }
  connector 'SupplyOrderEvent Stream' is from outlet SupplyContext.SupplyOrder.SupplyOrderEvents2 to inlet SupplyContext.SupplyOrderEventSplit.SupplyOrderEventSplitIn with {
    briefly "SupplyOrder events, fanned out to storage and read models"
  }
  connector 'SupplyOrderEvent Storage' is from outlet SupplyContext.SupplyOrderEventSplit.SupplyOrderEventSplitToInventoryRepository to inlet SupplyContext.InventoryRepository.InventoryRepositoryFromSupplyOrder with {
    briefly "SupplyOrder events on their way to storage"
  }
  connector 'InventoryMetricsProjector Feed' is from outlet SupplyContext.SupplyOrderEventSplit.SupplyOrderEventSplitToInventoryMetricsProjector to inlet SupplyContext.InventoryMetricsProjector.InventoryMetricsProjectorFromSupplyOrder with {
    briefly "SupplyOrder events feeding the InventoryMetricsProjector projection"
  }
  connector 'InventoryMetricsProjector Storage' is from outlet SupplyContext.InventoryMetricsProjector.InventoryMetricsProjectorOut to inlet SupplyContext.InventoryRepository.InventoryRepositoryFromInventoryMetricsProjector with {
    briefly "The InventoryMetricsProjector projection on its way to storage"
  }
} with {
  briefly "Bounded context for hospital supply chain operations"
  described as {
    | The SupplyContext is the primary bounded context for hospital supply
    | chain management. It encompasses procurement, receiving, storage,
    | and issuance of medical supplies. The context maintains inventory
    | accuracy, supports par-level based automatic reordering, and provides
    | metrics for supply chain optimization.
  }
}
