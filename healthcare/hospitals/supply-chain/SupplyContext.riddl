// Supply Context - the main bounded context for hospital supply chain
context SupplyContext is {
  type ItemId is Id(SupplyOrder)  with {
    briefly "Unique identifier for a supply item"
    described as {
      |A system-generated identifier that uniquely identifies each supply item in the inventory catalog.
    }
  }
  type ReceiptId is Id(SupplyOrder)  with {
    briefly "Unique identifier for a receipt transaction"
    described as {
      |A system-generated identifier for tracking goods receipt transactions when shipments arrive.
    }
  }
  type PurchaseOrderId is Id(SupplyOrder)  with {
    briefly "Unique identifier for a purchase order"
    described as {
      |A system-generated identifier for tracking purchase orders through the procurement lifecycle.
    }
  }
  include "SupplyOrder.riddl"
  // ==========================================================================
  // Repository
  // ==========================================================================
  repository InventoryRepository is {
    inlet InventoryRepositoryFromSupplyOrder is type SupplyOrderEvent
    inlet InventoryRepositoryFromInventoryMetricsProjector is type SupplyOrderEvent
    outlet InventoryRepositoryResponses is type SupplyOrder.SupplyOrderResult
    query GetItemById is  { itemId: ItemId } with {
      briefly "Retrieve item by ID"
      described as {
        |Fetches a single supply item by its unique identifier.
      }
    }
    query GetParLevels is  { locationCode: String } with {
      briefly "Get par levels for a location"
      described as {
        |Retrieves all par level configurations for a specific storage location.
      }
    }
    query GetInventoryPosition is  {
      itemId: ItemId
      locationCode: String
    } with {
      briefly "Get current inventory position"
      described as {
        |Retrieves the current stock position for an item at a location.
      }
    }
    query GetIssuanceHistory is  {
      departmentCode: String
      filterStartDate: Date
      filterEndDate: Date
    } with {
      briefly "Get issuance history for a department"
      described as {
        |Retrieves historical issuance records for a department within a date range.
      }
    }
    query GetItemsBelowParLevel is  { locationCode: String } with {
      briefly "Find items needing reorder"
      described as {
        |Identifies all items at a location where current quantity is below reorder point.
      }
    }
    query GetPurchaseOrderById is  { purchaseOrderId: PurchaseOrderId } with {
      briefly "Retrieve purchase order by ID"
      described as {
        |Fetches a single purchase order by its unique identifier.
      }
    }
    query GetPendingRequisitions is  { approverCode: String? } with {
      briefly "Get requisitions awaiting approval"
      described as {
        |Retrieves requisitions in pending approval status for review.
      }
    }
    query GetOpenOrders is  {
      vendorId: String?
      startDate: Date?
      endDate: Date?
    } with {
      briefly "Get open purchase orders"
      described as {
        |Retrieves purchase orders that have not been fully received.
      }
    }
    handler InventoryRepositoryHandler is {
      on query GetItemById is {
        do "Retrieve item from item master"
      }
      on query GetParLevels is {
        do "Query par levels by location"
      }
      on query GetInventoryPosition is {
        do "Calculate current position from events"
      }
      on query GetIssuanceHistory is {
        do "Query issuance events for department"
      }
      on query GetItemsBelowParLevel is {
        do "Find items where on-hand is below reorder point"
      }
      on query GetPurchaseOrderById is {
        yield result SupplyOrderResult
        do "Retrieve purchase order from event store"
      }
      on query GetPendingRequisitions is {
        do "Query requisitions in pending approval state"
      }
      on query GetOpenOrders is {
        yield result SupplyOrderResult
        do "Query orders not in closed state"
      }
      on other is {
        error "Unknown repository query"
      }
    } with {
      briefly "Query handler for inventory data"
      described as {
        | Handles queries for inventory data including item lookups,
        | par level retrieval, current positions, and historical issuance
        | records. Supports the various inventory management workflows.
      }
    }
  } with {
    briefly "Repository for inventory data persistence"
    described as {
      | The InventoryRepository manages persistent storage and retrieval
      | of inventory-related data including the item catalog, par level
      | configurations, current inventory positions, and issuance history.
      | It supports both transactional updates and analytical queries.
    }
  }
  // ==========================================================================
  // Projector
  // ==========================================================================
  projector InventoryMetricsProjector is {
    inlet InventoryMetricsProjectorFromSupplyOrder is type SupplyOrderEvent
    outlet InventoryMetricsProjectorOut is type SupplyOrderEvent
    updates repository SupplyContext.InventoryRepository
    record MetricsSummary is  {
      locationCode: String
      totalItemCount: Integer
      itemsBelowParLevel: Integer
      itemsAtZero: Integer
      totalInventoryValue: Decimal(12,2)
      pendingOrdersCount: Integer
      pendingOrdersValue: Decimal(12,2)
      averageDaysOnHand: Decimal(12,2)
      stockoutIncidents: Integer
      lastUpdated: DateTime
    } with {
      briefly "Summary metrics for inventory management"
      described as {
        | Aggregated metrics providing a dashboard view of inventory health
        | at a location. Includes counts of problem items, financial totals,
        | and key performance indicators for supply chain effectiveness.
      }
    }
    record TurnoverMetrics is  {
      itemId: ItemId
      periodStart: Date
      periodEnd: Date
      beginningQuantity: Integer
      endingQuantity: Integer
      totalIssued: Integer
      totalReceived: Integer
      turnoverRate: Decimal(12,2)
      daysOfSupply: Decimal(10,2)
    } with {
      briefly "Inventory turnover metrics per item"
      described as {
        | Turnover metrics for a specific item over a time period. Used to
        | analyze inventory efficiency, identify slow-moving stock, and
        | optimize par level settings.
      }
    }
    record VendorPerformance is  {
      vendorId: String
      vendorName: String
      totalOrders: Integer
      onTimeDeliveryRate: Decimal(12,2)
      accurateShipmentRate: Decimal(12,2)
      averageLeadTimeDays: Decimal(12,2)
      totalSpend: Decimal(12,2)
      lastOrderDate: Date
    } with {
      briefly "Vendor delivery performance metrics"
      described as {
        | Performance metrics for a vendor including on-time delivery rate,
        | shipment accuracy, and average lead time. Used for vendor evaluation
        | and selection decisions.
      }
    }
    handler MetricsHandler is {
      on event ShipmentReceived is {
        tell event ShipmentReceived to repository SupplyContext.InventoryRepository
        do "Update inventory position and vendor metrics"
      }
      on event SuppliesIssued is {
        tell event SuppliesIssued to repository SupplyContext.InventoryRepository
        do "Update inventory position and turnover metrics"
      }
      on event OrderPlaced is {
        tell event OrderPlaced to repository SupplyContext.InventoryRepository
        do "Update pending order metrics"
      }
      on event RequisitionCreated is {
        tell event RequisitionCreated to repository SupplyContext.InventoryRepository
        do "Update requisition counts"
      }
      on other is {
        do "Ignore other events"
      }
    } with {
      briefly "Event handler for metrics projection"
      described as {
        | Processes supply chain events to maintain real-time inventory
        | metrics. Updates positions, calculates turnover rates, and
        | tracks vendor performance based on actual transactions.
      }
    }
  } with {
    briefly "Projector for inventory analytics and dashboards"
    described as {
      | The InventoryMetricsProjector consumes supply chain events to
      | build and maintain analytical views of inventory data. It provides
      | real-time metrics for dashboards, alerts for low-stock conditions,
      | and historical analysis for inventory optimization.
    }
  }
  // ---- Event publication for SupplyOrder ----
  type SupplyOrderEvent is one of {
    SupplyContext.SupplyOrder.RequisitionCreated,
    SupplyContext.SupplyOrder.RequisitionApproved,
    SupplyContext.SupplyOrder.OrderPlaced,
    SupplyContext.SupplyOrder.ShipmentReceived,
    SupplyContext.SupplyOrder.SuppliesIssued
  } with {
    briefly "SupplyOrder event alternation"
    described as {
      |Union of all SupplyOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor SupplyOrderEventSource as source is {
    outlet SupplyOrderEvents is type SupplyOrderEvent
    handler SupplyOrderSourceHandler is {
      on event SupplyOrder.RequisitionCreated is {
        send event SupplyOrder.RequisitionCreated to outlet SupplyOrderEvents
      }
      on event SupplyOrder.RequisitionApproved is {
        send event SupplyOrder.RequisitionApproved to outlet SupplyOrderEvents
      }
      on event SupplyOrder.OrderPlaced is {
        send event SupplyOrder.OrderPlaced to outlet SupplyOrderEvents
      }
      on event SupplyOrder.ShipmentReceived is {
        send event SupplyOrder.ShipmentReceived to outlet SupplyOrderEvents
      }
      on event SupplyOrder.SuppliesIssued is {
        send event SupplyOrder.SuppliesIssued to outlet SupplyOrderEvents
      }
      on other is {
        error "Unexpected message for source SupplyOrderEventSource"
      }
    } with {
      briefly "SupplyOrder source handler"
      described as {
        |Publishes SupplyOrder events onto the outlet.
      }
    }
  } with {
    briefly "SupplyOrder event source"
    described as {
      |Publishes SupplyOrder entity events into the streaming topology.
    }
  }
  processor SupplyOrderEventSink as sink is {
    inlet SupplyOrderInlet is type SupplyOrderEvent
    handler SupplyOrderSinkHandler is {
      on event SupplyOrder.RequisitionCreated is {
        tell event SupplyOrder.RequisitionCreated to repository SupplyContext.InventoryRepository
      }
      on event SupplyOrder.RequisitionApproved is {
        tell event SupplyOrder.RequisitionApproved to repository SupplyContext.InventoryRepository
      }
      on event SupplyOrder.OrderPlaced is {
        tell event SupplyOrder.OrderPlaced to repository SupplyContext.InventoryRepository
      }
      on event SupplyOrder.ShipmentReceived is {
        tell event SupplyOrder.ShipmentReceived to repository SupplyContext.InventoryRepository
      }
      on event SupplyOrder.SuppliesIssued is {
        tell event SupplyOrder.SuppliesIssued to repository SupplyContext.InventoryRepository
      }
      on other is {
        error "Unexpected message for sink SupplyOrderEventSink"
      }
    } with {
      briefly "SupplyOrder sink handler"
      described as {
        |Persists SupplyOrder events via the repository.
      }
    }
  } with {
    briefly "SupplyOrder event sink"
    described as {
      |Receives SupplyOrder events for persistence.
    }
  }
  connector SupplyOrderEventFlow is {
    from outlet SupplyContext.SupplyOrderEventSource.SupplyOrderEvents to
      inlet SupplyContext.SupplyOrderEventSink.SupplyOrderInlet
  } with {
    briefly "SupplyOrder event flow"
    described as {
      |Connects the SupplyOrder source to its sink.
    }
  }
  processor SupplyOrderEventSplit is {
    inlet SupplyOrderEventSplitIn is type SupplyOrderEvent
    outlet SupplyOrderEventSplitToInventoryRepository is type SupplyOrderEvent
    outlet SupplyOrderEventSplitToInventoryMetricsProjector is type SupplyOrderEvent
    handler SupplyOrderEventSplitHandler is {
      on event SupplyOrder.RequisitionCreated is {
        send event SupplyOrder.RequisitionCreated to outlet SupplyOrderEventSplitToInventoryRepository
        send event SupplyOrder.RequisitionCreated to outlet SupplyOrderEventSplitToInventoryMetricsProjector
        tell event SupplyOrder.RequisitionCreated to entity SupplyContext.SupplyOrder
      }
      on event SupplyOrder.RequisitionApproved is {
        send event SupplyOrder.RequisitionApproved to outlet SupplyOrderEventSplitToInventoryRepository
        send event SupplyOrder.RequisitionApproved to outlet SupplyOrderEventSplitToInventoryMetricsProjector
        tell event SupplyOrder.RequisitionApproved to entity SupplyContext.SupplyOrder
      }
      on event SupplyOrder.OrderPlaced is {
        send event SupplyOrder.OrderPlaced to outlet SupplyOrderEventSplitToInventoryRepository
        send event SupplyOrder.OrderPlaced to outlet SupplyOrderEventSplitToInventoryMetricsProjector
        tell event SupplyOrder.OrderPlaced to entity SupplyContext.SupplyOrder
      }
      on event SupplyOrder.ShipmentReceived is {
        send event SupplyOrder.ShipmentReceived to outlet SupplyOrderEventSplitToInventoryRepository
        send event SupplyOrder.ShipmentReceived to outlet SupplyOrderEventSplitToInventoryMetricsProjector
        tell event SupplyOrder.ShipmentReceived to entity SupplyContext.SupplyOrder
      }
      on event SupplyOrder.SuppliesIssued is {
        send event SupplyOrder.SuppliesIssued to outlet SupplyOrderEventSplitToInventoryRepository
        send event SupplyOrder.SuppliesIssued to outlet SupplyOrderEventSplitToInventoryMetricsProjector
        tell event SupplyOrder.SuppliesIssued to entity SupplyContext.SupplyOrder
      }
      on other is {
        error "Unexpected message for processor SupplyOrderEventSplit"
      }
    } with {
      briefly "SupplyOrder event fan-out handler"
      described as {
        |Delivers each SupplyOrder event to all of its consumers.
      }
    }
  } with {
    briefly "SupplyOrder event fan-out"
    described as {
      |Fans SupplyOrder events out to the repository and projectors.
    }
  }
  connector LinkSupplyOrderToSupplyOrderEventSplit is {
    from outlet SupplyContext.SupplyOrder.SupplyOrderEvents2 to
      inlet SupplyContext.SupplyOrderEventSplit.SupplyOrderEventSplitIn
  } with {
    briefly "LinkSupplyOrderToSupplyOrderEventSplit"
  }
  connector LinkSupplyOrderEventSplitToInventoryRepository is {
    from outlet SupplyContext.SupplyOrderEventSplit.SupplyOrderEventSplitToInventoryRepository to
      inlet SupplyContext.InventoryRepository.InventoryRepositoryFromSupplyOrder
  } with {
    briefly "LinkSupplyOrderEventSplitToInventoryRepository"
  }
  connector LinkSupplyOrderEventSplitToInventoryMetricsProjector is {
    from outlet SupplyContext.SupplyOrderEventSplit.SupplyOrderEventSplitToInventoryMetricsProjector to
      inlet SupplyContext.InventoryMetricsProjector.InventoryMetricsProjectorFromSupplyOrder
  } with {
    briefly "LinkSupplyOrderEventSplitToInventoryMetricsProjector"
  }
  connector LinkInventoryMetricsProjectorToInventoryRepository is {
    from outlet SupplyContext.InventoryMetricsProjector.InventoryMetricsProjectorOut to
      inlet SupplyContext.InventoryRepository.InventoryRepositoryFromInventoryMetricsProjector
  } with {
    briefly "LinkInventoryMetricsProjectorToInventoryRepository"
  }
} with {
  briefly "Bounded context for hospital supply chain operations"
  described as {
    | The SupplyContext is the primary bounded context for hospital supply
    | chain management. It encompasses procurement, receiving, storage,
    | and issuance of medical supplies. The context maintains inventory
    | accuracy, supports par-level based automatic reordering, and provides
    | metrics for supply chain optimization.
  }
}
