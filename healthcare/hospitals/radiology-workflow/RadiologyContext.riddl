// RadiologyContext - Main Bounded Context
// Contains the primary entities, repositories, and projectors for radiology workflow
context RadiologyContext is {
  adaptor FromPACSIntegration from context PACSIntegration is { 
    handler FromPACSIntegrationHandler is {
      on event PACSIntegration.ImagesRetrieved is {
        do "the model receives images retrieved"
      }
      on event PACSIntegration.ImagesStored is {
        do "the model receives images stored"
      }
      on other is {
        error "Unexpected message for adaptor FromPACSIntegration"
      }
    } with {
      briefly "from pacs integration"
      described as {
        |Carries messages from the external PACSIntegration.
      }
    }
  } with {
    briefly "PACSIntegration integration"
    described as {
      |The model's side of the PACSIntegration conversation.
    }
  }
  adaptor ToPACSIntegration to context PACSIntegration is { 
    handler ToPACSIntegrationHandler is {
      on command PACSIntegration.PrefetchPriorStudies is {
        do "the model sends prefetch prior studies"
      }
      on command PACSIntegration.RetrieveImages is {
        do "the model sends retrieve images"
      }
      on command PACSIntegration.StoreImages is {
        do "the model sends store images"
      }
      on other is {
        error "Unexpected message for adaptor ToPACSIntegration"
      }
    } with {
      briefly "to pacs integration"
      described as {
        |Carries messages to the external PACSIntegration.
      }
    }
  } with {
    briefly "PACSIntegration integration"
    described as {
      |The model's side of the PACSIntegration conversation.
    }
  }
  adaptor FromRISIntegration from context RISIntegration is { 
    handler FromRISIntegrationHandler is {
      on event RISIntegration.ExamScheduledInRIS is {
        do "the model receives exam scheduled in ris"
      }
      on event RISIntegration.WorklistUpdated is {
        do "the model receives worklist updated"
      }
      on other is {
        error "Unexpected message for adaptor FromRISIntegration"
      }
    } with {
      briefly "from ris integration"
      described as {
        |Carries messages from the external RISIntegration.
      }
    }
  } with {
    briefly "RISIntegration integration"
    described as {
      |The model's side of the RISIntegration conversation.
    }
  }
  adaptor ToRISIntegration to context RISIntegration is { 
    handler ToRISIntegrationHandler is {
      on command RISIntegration.GetModalityWorklist is {
        do "the model sends get modality worklist"
      }
      on command RISIntegration.ScheduleExamInRIS is {
        do "the model sends schedule exam in ris"
      }
      on command RISIntegration.UpdateExamStatus is {
        do "the model sends update exam status"
      }
      on other is {
        error "Unexpected message for adaptor ToRISIntegration"
      }
    } with {
      briefly "to ris integration"
      described as {
        |Carries messages to the external RISIntegration.
      }
    }
  } with {
    briefly "RISIntegration integration"
    described as {
      |The model's side of the RISIntegration conversation.
    }
  }
  adaptor FromSpeechRecognition from context SpeechRecognition is { 
    handler FromSpeechRecognitionHandler is {
      on event SpeechRecognition.DictationCompleted is {
        do "the model receives dictation completed"
      }
      on event SpeechRecognition.DictationStarted is {
        do "the model receives dictation started"
      }
      on event SpeechRecognition.TranscriptionCorrected is {
        do "the model receives transcription corrected"
      }
      on other is {
        error "Unexpected message for adaptor FromSpeechRecognition"
      }
    } with {
      briefly "from speech recognition"
      described as {
        |Carries messages from the external SpeechRecognition.
      }
    }
  } with {
    briefly "SpeechRecognition integration"
    described as {
      |The model's side of the SpeechRecognition conversation.
    }
  }
  adaptor ToSpeechRecognition to context SpeechRecognition is { 
    handler ToSpeechRecognitionHandler is {
      on command SpeechRecognition.EndDictation is {
        do "the model sends end dictation"
      }
      on command SpeechRecognition.InsertMacro is {
        do "the model sends insert macro"
      }
      on command SpeechRecognition.StartDictation is {
        do "the model sends start dictation"
      }
      on other is {
        error "Unexpected message for adaptor ToSpeechRecognition"
      }
    } with {
      briefly "to speech recognition"
      described as {
        |Carries messages to the external SpeechRecognition.
      }
    }
  } with {
    briefly "SpeechRecognition integration"
    described as {
      |The model's side of the SpeechRecognition conversation.
    }
  }
  include "types.riddl"
  include "ImagingExam.riddl"
  // ==========================================================================
  // Repository
  // ==========================================================================
  repository ExamRepository as merge is {
    record StoredImagingExam is  {
      imagingExamId: UUID with {
        briefly "imagingExamId"
        described as {
          |The imagingExamId column of the stored imagingExam row.
        }
      }
    } with {
      briefly "Stored imagingExam row"
      described as {
        |The persistence shape of imagingExam data as this repository stores it.
      }
    }
    schema ImagingExamData is relational
      of imagingexams as type StoredImagingExam
 with {
      briefly "Imaging exam data schema"
      described as {
        |The relational schema persisting imaging exam records for this repository.
      }
    }
    inlet ExamRepositoryFromImagingExam is type ImagingExamEvent    inlet ExamRepositoryFromTurnaroundTimeProjector is type ImagingExamEvent    inlet ExamRepositoryFromModalityUtilizationProjector is type ImagingExamEvent    inlet ExamRepositoryFromCriticalFindingProjector is type ImagingExamEvent    inlet ExamRepositoryFromRadiologistProductivityProjector is type ImagingExamEvent    outlet ExamRepositoryResponses is type ImagingExam.ImagingExamResult
    // Exam queries
    query FindExamById is  { examId: ExamId } with {
      briefly "Find exam by identifier"
      described as {
        |Retrieves a single imaging exam by its unique identifier.
      }
    }
    query FindExamsByPatient is  {
      patientId: PatientId
      filterStartDate: Date?
      filterEndDate: Date?
    } with {
      briefly "Find exams for a patient"
      described as {
        | Retrieves all imaging exams for a patient within optional
        | date range.
      }
    }
    query FindExamsByStatus is  {
      status: ExamStatus
      modalityType: ModalityType?
      limit: Integer
    } with {
      briefly "Find exams by status"
      described as {
        | Retrieves exams in a specific workflow status, optionally
        | filtered by modality type.
      }
    }
    query FindScheduledExams is  {
      startDateTime: TimeStamp
      endDateTime: TimeStamp
      modalityId: ModalityId?
    } with {
      briefly "Find scheduled exams in time range"
      described as {
        | Retrieves exams scheduled within a time window for worklist
        | and capacity planning.
      }
    }
    // Study queries
    query FindStudyById is  { studyId: StudyId } with {
      briefly "Find study by identifier"
      described as {
        |Retrieves DICOM study metadata by study ID.
      }
    }
    query FindStudiesByPatient is  {
      patientId: PatientId
      modalityType: ModalityType?
      filterStartDate: Date?
      filterEndDate: Date?
    } with {
      briefly "Find studies for a patient"
      described as {
        |Retrieves study history for a patient for comparison views.
      }
    }
    query FindPriorStudies is  {
      patientId: PatientId
      bodyPart: String
      limit: Integer
    } with {
      briefly "Find prior studies of same body part"
      described as {
        | Retrieves relevant prior studies for comparison during
        | interpretation.
      }
    }
    // Report queries
    query FindReportById is  { reportId: ReportId } with {
      briefly "Find report by identifier"
      described as {
        |Retrieves a radiology report by its unique identifier.
      }
    }
    query FindReportsByRadiologist is  {
      radiologistId: PhysicianId
      reportStatus: ReportStatus?
      filterStartDate: Date?
      filterEndDate: Date?
    } with {
      briefly "Find reports by radiologist"
      described as {
        | Retrieves reports created by a specific radiologist for
        | productivity tracking.
      }
    }
    query FindPendingReports is  {
      radiologistId: PhysicianId?
      priority: ExamPriority?
      limit: Integer
    } with {
      briefly "Find reports awaiting signature"
      described as {
        |Retrieves draft reports in the interpretation queue.
      }
    }
    query FindCriticalFindings is  {
      filterStartDate: Date
      filterEndDate: Date
      isAcknowledged: Boolean?
    } with {
      briefly "Find critical findings"
      described as {
        | Retrieves critical findings for compliance reporting and
        | follow-up tracking.
      }
    }
    handler ExamRepositoryHandler is {
      on query GetTurnaroundTimeRecord is {
        let turnaroundTimeRecordView: type TurnaroundTimeRecordView = prompt("read the turnaround time record projection")
        reply turnaroundTimeRecordView
      }
      on query GetUtilizationRecord is {
        let utilizationRecordView: type UtilizationRecordView = prompt("read the utilization record projection")
        reply utilizationRecordView
      }
      on query GetCriticalFindingRecord is {
        let criticalFindingRecordView: type CriticalFindingRecordView = prompt("read the critical finding record projection")
        reply criticalFindingRecordView
      }
      on query GetProductivityRecord is {
        let productivityRecordView: type ProductivityRecordView = prompt("read the productivity record projection")
        reply productivityRecordView
      }
      on query FindExamById is {
        reply result ImagingExamResult
        do "Retrieve exam from event-sourced store"
      }
      on query FindExamsByPatient is {
        reply result ImagingExamResult
        do "Query exams by patient with date filtering"
      }
      on query FindExamsByStatus is {
        reply result ImagingExamResult
        do "Query exams by workflow status"
      }
      on query FindScheduledExams is {
        reply result ImagingExamResult
        do "Query scheduled exams for worklist"
      }
      on query FindStudyById is {
        reply result ImagingExamResult
        do "Retrieve study metadata"
      }
      on query FindStudiesByPatient is {
        reply result ImagingExamResult
        do "Query patient study history"
      }
      on query FindPriorStudies is {
        reply result ImagingExamResult
        do "Find relevant prior studies for comparison"
      }
      on query FindReportById is {
        reply result ImagingExamResult
        do "Retrieve radiology report"
      }
      on query FindReportsByRadiologist is {
        reply result ImagingExamResult
        do "Query reports by interpreting radiologist"
      }
      on query FindPendingReports is {
        reply result ImagingExamResult
        do "Query interpretation worklist"
      }
      on query FindCriticalFindings is {
        reply result ImagingExamResult
        do "Query critical findings for compliance"
      }
      on other is {
        error "Unknown repository query"
      }
    } with {
      briefly "Handles repository queries"
      described as {
        | Processes all exam, study, and report queries against the
        | event-sourced data store.
      }
    }
  } with {
    briefly "Repository for exams, studies, and reports"
    described as {
      | Provides query capabilities for imaging exams, DICOM studies, and
      | radiology reports. Supports worklist generation, patient history
      | retrieval, and compliance reporting for critical findings.
    }
  }
  // ==========================================================================
  // Projectors
  // ==========================================================================
  query GetTurnaroundTimeRecord is  {
    turnaroundTimeRecordKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which turnaround time record to retrieve.
      }
    }
  } with {
    briefly "Get turnaround time record"
    described as {
      |Retrieves the turnaround time record projection.
    }
  }
  result TurnaroundTimeRecordView is  {
    turnaroundTimeRecord: TurnaroundTimeProjector.TurnaroundTimeRecord with {
      briefly "Turnaround time record"
      described as {
        |The turnaround time record being returned.
      }
    }
  } with {
    briefly "Turnaround time record view"
    described as {
      |Read model view carrying the turnaround time record projection.
    }
  }
  projector TurnaroundTimeProjector as flow is {
    updates repository RadiologyContext.ExamRepository
    inlet TurnaroundTimeProjectorFromImagingExam is type ImagingExamEvent    outlet TurnaroundTimeProjectorOut is type ImagingExamEvent
    record TurnaroundTimeRecord is  {
      examId: ExamId
      modalityType: ModalityType
      priority: ExamPriority
      orderToScheduleMinutes: Integer?
      scheduleToAcquisitionMinutes: Integer?
      acquisitionToInterpretationMinutes: Integer?
      interpretationToFinalMinutes: Integer?
      totalTurnaroundMinutes: Integer?
      metSLA: Boolean?
    } with {
      briefly "Turnaround time metrics record"
      described as {
        | Stores calculated turnaround durations for each workflow
        | phase for performance analysis.
      }
    }
    handler TurnaroundTimeHandler is {
      on examOrdered: event ExamOrdered is {
        tell examOrdered to repository RadiologyContext.ExamRepository
        do "Record exam creation timestamp"
      }
      on examScheduled: event ExamScheduled is {
        tell examScheduled to repository RadiologyContext.ExamRepository
        do "Calculate order-to-schedule duration"
      }
      on acquisitionCompleted: event AcquisitionCompleted is {
        tell acquisitionCompleted to repository RadiologyContext.ExamRepository
        do "Calculate schedule-to-acquisition duration"
      }
      on draftReportCreated: event DraftReportCreated is {
        tell draftReportCreated to repository RadiologyContext.ExamRepository
        do "Calculate acquisition-to-interpretation duration"
      }
      on reportFinalized: event ReportFinalized is {
        tell reportFinalized to repository RadiologyContext.ExamRepository
        do "Calculate interpretation-to-final and total turnaround"
      }
      on other is {
        do "Ignore other events"
      }
    } with {
      briefly "Projects turnaround time metrics"
      described as {
        | Calculates and stores duration between workflow milestones
        | for performance tracking and SLA compliance.
      }
    }
  } with {
    briefly "Turnaround time metrics projector"
    described as {
      | Projects imaging exam events into turnaround time metrics. Tracks
      | duration between each workflow phase to support operational dashboards,
      | SLA monitoring, and quality improvement initiatives.
    }
  }
  query GetUtilizationRecord is  {
    utilizationRecordKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which utilization record to retrieve.
      }
    }
  } with {
    briefly "Get utilization record"
    described as {
      |Retrieves the utilization record projection.
    }
  }
  result UtilizationRecordView is  {
    utilizationRecord: ModalityUtilizationProjector.UtilizationRecord with {
      briefly "Utilization record"
      described as {
        |The utilization record being returned.
      }
    }
  } with {
    briefly "Utilization record view"
    described as {
      |Read model view carrying the utilization record projection.
    }
  }
  projector ModalityUtilizationProjector as flow is {
    updates repository RadiologyContext.ExamRepository
    inlet ModalityUtilizationProjectorFromImagingExam is type ImagingExamEvent    outlet ModalityUtilizationProjectorOut is type ImagingExamEvent
    record UtilizationRecord is  {
      modalityId: ModalityId
      modalityType: ModalityType
      date: Date
      hour: Integer
      scheduledCount: Integer
      completedCount: Integer
      cancelledCount: Integer
      totalAcquisitionMinutes: Integer
      availableMinutes: Integer
    } with {
      briefly "Hourly modality utilization record"
      described as {
        | Stores hourly utilization metrics for capacity planning
        | and equipment optimization.
      }
    }
    handler UtilizationHandler is {
      on examScheduled: event ExamScheduled is {
        tell examScheduled to repository RadiologyContext.ExamRepository
        do "Increment scheduled count for modality and time slot"
      }
      on acquisitionStarted: event AcquisitionStarted is {
        tell acquisitionStarted to repository RadiologyContext.ExamRepository
        do "Record acquisition start time"
      }
      on acquisitionCompleted: event AcquisitionCompleted is {
        tell acquisitionCompleted to repository RadiologyContext.ExamRepository
        do "Calculate acquisition duration and update utilization"
      }
      on other is {
        do "Ignore other events"
      }
    } with {
      briefly "Projects modality utilization"
      described as {
        | Aggregates exam events into hourly utilization metrics
        | per modality for capacity analysis.
      }
    }
  } with {
    briefly "Modality utilization projector"
    described as {
      | Projects exam acquisition events into modality utilization metrics.
      | Tracks scheduled vs completed exams, acquisition durations, and
      | equipment availability to support capacity planning and resource
      | optimization.
    }
  }
  query GetCriticalFindingRecord is  {
    criticalFindingRecordKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which critical finding record to retrieve.
      }
    }
  } with {
    briefly "Get critical finding record"
    described as {
      |Retrieves the critical finding record projection.
    }
  }
  result CriticalFindingRecordView is  {
    criticalFindingRecord: CriticalFindingProjector.CriticalFindingRecord with {
      briefly "Critical finding record"
      described as {
        |The critical finding record being returned.
      }
    }
  } with {
    briefly "Critical finding record view"
    described as {
      |Read model view carrying the critical finding record projection.
    }
  }
  projector CriticalFindingProjector as flow is {
    updates repository RadiologyContext.ExamRepository
    inlet CriticalFindingProjectorFromImagingExam is type ImagingExamEvent    outlet CriticalFindingProjectorOut is type ImagingExamEvent
    record CriticalFindingRecord is  {
      findingId: String
      examId: ExamId
      severity: CriticalFindingSeverity
      identifiedAt: TimeStamp
      communicatedAt: TimeStamp?
      communicationDelayMinutes: Integer?
      acknowledged: Boolean
      radiologistId: PhysicianId
      orderingPhysicianId: PhysicianId
    } with {
      briefly "Critical finding tracking record"
      described as {
        | Stores critical finding events with communication timing
        | for compliance reporting.
      }
    }
    handler CriticalFindingHandler is {
      on criticalFindingReported: event CriticalFindingReported is {
        tell criticalFindingReported to repository RadiologyContext.ExamRepository
        do "Record critical finding with identification time"
      }
      on other is {
        do "Ignore non-critical finding events"
      }
    } with {
      briefly "Projects critical findings"
      described as {
        | Tracks critical finding identification and communication
        | for ACR compliance monitoring.
      }
    }
  } with {
    briefly "Critical finding compliance projector"
    described as {
      | Projects critical finding events for compliance monitoring. Tracks
      | time from identification to physician notification to ensure adherence
      | to ACR Practice Parameter for communication of diagnostic imaging
      | findings.
    }
  }
  query GetProductivityRecord is  {
    productivityRecordKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which productivity record to retrieve.
      }
    }
  } with {
    briefly "Get productivity record"
    described as {
      |Retrieves the productivity record projection.
    }
  }
  result ProductivityRecordView is  {
    productivityRecord: RadiologistProductivityProjector.ProductivityRecord with {
      briefly "Productivity record"
      described as {
        |The productivity record being returned.
      }
    }
  } with {
    briefly "Productivity record view"
    described as {
      |Read model view carrying the productivity record projection.
    }
  }
  projector RadiologistProductivityProjector as flow is {
    updates repository RadiologyContext.ExamRepository
    inlet RadiologistProductivityProjectorFromImagingExam is type ImagingExamEvent    outlet RadiologistProductivityProjectorOut is type ImagingExamEvent
    record ProductivityRecord is  {
      radiologistId: PhysicianId
      date: Date
      reportsCreated: Integer
      reportsFinalized: Integer
      totalRVUs: Number
      averageReportTimeMinutes: Integer
      criticalFindingsReported: Integer
    } with {
      briefly "Daily radiologist productivity record"
      described as {
        | Stores daily productivity metrics per radiologist for
        | workload management and performance tracking.
      }
    }
    handler ProductivityHandler is {
      on draftReportCreated: event DraftReportCreated is {
        tell draftReportCreated to repository RadiologyContext.ExamRepository
        do "Increment reports created count"
      }
      on reportFinalized: event ReportFinalized is {
        tell reportFinalized to repository RadiologyContext.ExamRepository
        do "Increment finalized count and calculate RVUs"
      }
      on criticalFindingReported: event CriticalFindingReported is {
        tell criticalFindingReported to repository RadiologyContext.ExamRepository
        do "Increment critical findings count"
      }
      on other is {
        do "Ignore other events"
      }
    } with {
      briefly "Projects radiologist productivity"
      described as {
        | Aggregates report events into daily productivity metrics
        | per radiologist.
      }
    }
  } with {
    briefly "Radiologist productivity projector"
    described as {
      | Projects report events into radiologist productivity metrics. Tracks
      | report volumes, RVUs, and critical findings per radiologist per day
      | for workload balancing and performance management.
    }
  }
  // ---- Event publication for ImagingExam ----
  type ImagingExamEvent is one of {
    RadiologyContext.ImagingExam.ExamOrdered or RadiologyContext.ImagingExam.ExamScheduled or RadiologyContext.ImagingExam.PatientCheckedIn or RadiologyContext.ImagingExam.AcquisitionStarted or RadiologyContext.ImagingExam.AcquisitionCompleted or RadiologyContext.ImagingExam.DraftReportCreated or RadiologyContext.ImagingExam.ReportFinalized or RadiologyContext.ImagingExam.AddendumAdded or RadiologyContext.ImagingExam.CriticalFindingReported
  } with {
    briefly "ImagingExam event alternation"
    described as {
      |Union of all ImagingExam events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ImagingExamEventSource as source is {
    outlet ImagingExamEvents is type ImagingExamEvent
    handler ImagingExamSourceHandler is {
      on examOrdered: event ImagingExam.ExamOrdered is {
        send examOrdered to outlet ImagingExamEvents
      }
      on examScheduled: event ImagingExam.ExamScheduled is {
        send examScheduled to outlet ImagingExamEvents
      }
      on patientCheckedIn: event ImagingExam.PatientCheckedIn is {
        send patientCheckedIn to outlet ImagingExamEvents
      }
      on acquisitionStarted: event ImagingExam.AcquisitionStarted is {
        send acquisitionStarted to outlet ImagingExamEvents
      }
      on acquisitionCompleted: event ImagingExam.AcquisitionCompleted is {
        send acquisitionCompleted to outlet ImagingExamEvents
      }
      on draftReportCreated: event ImagingExam.DraftReportCreated is {
        send draftReportCreated to outlet ImagingExamEvents
      }
      on reportFinalized: event ImagingExam.ReportFinalized is {
        send reportFinalized to outlet ImagingExamEvents
      }
      on addendumAdded: event ImagingExam.AddendumAdded is {
        send addendumAdded to outlet ImagingExamEvents
      }
      on criticalFindingReported: event ImagingExam.CriticalFindingReported is {
        send criticalFindingReported to outlet ImagingExamEvents
      }
      on other is {
        error "Unexpected message for source ImagingExamEventSource"
      }
    } with {
      briefly "ImagingExam source handler"
      described as {
        |Publishes ImagingExam events onto the outlet.
      }
    }
  } with {
    briefly "ImagingExam event source"
    described as {
      |Publishes ImagingExam entity events into the streaming topology.
    }
  }
  processor ImagingExamEventSink as sink is {
    inlet ImagingExamInlet is type ImagingExamEvent    handler ImagingExamSinkHandler is {
      on examOrdered: event ImagingExam.ExamOrdered is {
        tell examOrdered to repository RadiologyContext.ExamRepository
      }
      on examScheduled: event ImagingExam.ExamScheduled is {
        tell examScheduled to repository RadiologyContext.ExamRepository
      }
      on patientCheckedIn: event ImagingExam.PatientCheckedIn is {
        tell patientCheckedIn to repository RadiologyContext.ExamRepository
      }
      on acquisitionStarted: event ImagingExam.AcquisitionStarted is {
        tell acquisitionStarted to repository RadiologyContext.ExamRepository
      }
      on acquisitionCompleted: event ImagingExam.AcquisitionCompleted is {
        tell acquisitionCompleted to repository RadiologyContext.ExamRepository
      }
      on draftReportCreated: event ImagingExam.DraftReportCreated is {
        tell draftReportCreated to repository RadiologyContext.ExamRepository
      }
      on reportFinalized: event ImagingExam.ReportFinalized is {
        tell reportFinalized to repository RadiologyContext.ExamRepository
      }
      on addendumAdded: event ImagingExam.AddendumAdded is {
        tell addendumAdded to repository RadiologyContext.ExamRepository
      }
      on criticalFindingReported: event ImagingExam.CriticalFindingReported is {
        tell criticalFindingReported to repository RadiologyContext.ExamRepository
      }
      on other is {
        error "Unexpected message for sink ImagingExamEventSink"
      }
    } with {
      briefly "ImagingExam sink handler"
      described as {
        |Persists ImagingExam events via the repository.
      }
    }
  } with {
    briefly "ImagingExam event sink"
    described as {
      |Receives ImagingExam events for persistence.
    }
  }
  connector ImagingExamEventFlow is from outlet RadiologyContext.ImagingExamEventSource.ImagingExamEvents to inlet RadiologyContext.ImagingExamEventSink.ImagingExamInlet with {
    briefly "ImagingExam event flow"
    described as {
      |Connects the ImagingExam source to its sink.
    }
  }
  processor ImagingExamEventSplit as split is {
    inlet ImagingExamEventSplitIn is type ImagingExamEvent    outlet ImagingExamEventSplitToExamRepository is type ImagingExamEvent
    outlet ImagingExamEventSplitToTurnaroundTimeProjector is type ImagingExamEvent
    outlet ImagingExamEventSplitToModalityUtilizationProjector is type ImagingExamEvent
    outlet ImagingExamEventSplitToCriticalFindingProjector is type ImagingExamEvent
    outlet ImagingExamEventSplitToRadiologistProductivityProjector is type ImagingExamEvent
    handler ImagingExamEventSplitHandler is {
      on examOrdered: event ImagingExam.ExamOrdered is {
        send examOrdered to outlet ImagingExamEventSplitToExamRepository
        send examOrdered to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send examOrdered to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send examOrdered to outlet ImagingExamEventSplitToCriticalFindingProjector
        send examOrdered to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell examOrdered to entity RadiologyContext.ImagingExam
      }
      on examScheduled: event ImagingExam.ExamScheduled is {
        send examScheduled to outlet ImagingExamEventSplitToExamRepository
        send examScheduled to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send examScheduled to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send examScheduled to outlet ImagingExamEventSplitToCriticalFindingProjector
        send examScheduled to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell examScheduled to entity RadiologyContext.ImagingExam
      }
      on patientCheckedIn: event ImagingExam.PatientCheckedIn is {
        send patientCheckedIn to outlet ImagingExamEventSplitToExamRepository
        send patientCheckedIn to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send patientCheckedIn to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send patientCheckedIn to outlet ImagingExamEventSplitToCriticalFindingProjector
        send patientCheckedIn to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell patientCheckedIn to entity RadiologyContext.ImagingExam
      }
      on acquisitionStarted: event ImagingExam.AcquisitionStarted is {
        send acquisitionStarted to outlet ImagingExamEventSplitToExamRepository
        send acquisitionStarted to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send acquisitionStarted to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send acquisitionStarted to outlet ImagingExamEventSplitToCriticalFindingProjector
        send acquisitionStarted to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell acquisitionStarted to entity RadiologyContext.ImagingExam
      }
      on acquisitionCompleted: event ImagingExam.AcquisitionCompleted is {
        send acquisitionCompleted to outlet ImagingExamEventSplitToExamRepository
        send acquisitionCompleted to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send acquisitionCompleted to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send acquisitionCompleted to outlet ImagingExamEventSplitToCriticalFindingProjector
        send acquisitionCompleted to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell acquisitionCompleted to entity RadiologyContext.ImagingExam
      }
      on draftReportCreated: event ImagingExam.DraftReportCreated is {
        send draftReportCreated to outlet ImagingExamEventSplitToExamRepository
        send draftReportCreated to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send draftReportCreated to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send draftReportCreated to outlet ImagingExamEventSplitToCriticalFindingProjector
        send draftReportCreated to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell draftReportCreated to entity RadiologyContext.ImagingExam
      }
      on reportFinalized: event ImagingExam.ReportFinalized is {
        send reportFinalized to outlet ImagingExamEventSplitToExamRepository
        send reportFinalized to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send reportFinalized to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send reportFinalized to outlet ImagingExamEventSplitToCriticalFindingProjector
        send reportFinalized to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell reportFinalized to entity RadiologyContext.ImagingExam
      }
      on addendumAdded: event ImagingExam.AddendumAdded is {
        send addendumAdded to outlet ImagingExamEventSplitToExamRepository
        send addendumAdded to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send addendumAdded to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send addendumAdded to outlet ImagingExamEventSplitToCriticalFindingProjector
        send addendumAdded to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell addendumAdded to entity RadiologyContext.ImagingExam
      }
      on criticalFindingReported: event ImagingExam.CriticalFindingReported is {
        send criticalFindingReported to outlet ImagingExamEventSplitToExamRepository
        send criticalFindingReported to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send criticalFindingReported to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send criticalFindingReported to outlet ImagingExamEventSplitToCriticalFindingProjector
        send criticalFindingReported to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell criticalFindingReported to entity RadiologyContext.ImagingExam
      }
      on other is {
        error "Unexpected message for processor ImagingExamEventSplit"
      }
    } with {
      briefly "ImagingExam event fan-out handler"
      described as {
        |Delivers each ImagingExam event to all of its consumers.
      }
    }
  } with {
    briefly "ImagingExam event fan-out"
    described as {
      |Fans ImagingExam events out to the repository and projectors.
    }
  }
  connector 'ImagingExamEvent Stream' is from outlet RadiologyContext.ImagingExam.ImagingExamEvents2 to inlet RadiologyContext.ImagingExamEventSplit.ImagingExamEventSplitIn with {
    briefly "ImagingExam events, fanned out to storage and read models"
  }
  connector 'ImagingExamEvent Storage' is from outlet RadiologyContext.ImagingExamEventSplit.ImagingExamEventSplitToExamRepository to inlet RadiologyContext.ExamRepository.ExamRepositoryFromImagingExam with {
    briefly "ImagingExam events on their way to storage"
  }
  connector 'TurnaroundTimeProjector Feed' is from outlet RadiologyContext.ImagingExamEventSplit.ImagingExamEventSplitToTurnaroundTimeProjector to inlet RadiologyContext.TurnaroundTimeProjector.TurnaroundTimeProjectorFromImagingExam with {
    briefly "ImagingExam events feeding the TurnaroundTimeProjector projection"
  }
  connector 'ModalityUtilizationProjector Feed' is from outlet RadiologyContext.ImagingExamEventSplit.ImagingExamEventSplitToModalityUtilizationProjector to inlet RadiologyContext.ModalityUtilizationProjector.ModalityUtilizationProjectorFromImagingExam with {
    briefly "ImagingExam events feeding the ModalityUtilizationProjector projection"
  }
  connector 'CriticalFindingProjector Feed' is from outlet RadiologyContext.ImagingExamEventSplit.ImagingExamEventSplitToCriticalFindingProjector to inlet RadiologyContext.CriticalFindingProjector.CriticalFindingProjectorFromImagingExam with {
    briefly "ImagingExam events feeding the CriticalFindingProjector projection"
  }
  connector 'RadiologistProductivityProjector Feed' is from outlet RadiologyContext.ImagingExamEventSplit.ImagingExamEventSplitToRadiologistProductivityProjector to inlet RadiologyContext.RadiologistProductivityProjector.RadiologistProductivityProjectorFromImagingExam with {
    briefly "ImagingExam events feeding the RadiologistProductivityProjector projection"
  }
  connector 'TurnaroundTimeProjector Storage' is from outlet RadiologyContext.TurnaroundTimeProjector.TurnaroundTimeProjectorOut to inlet RadiologyContext.ExamRepository.ExamRepositoryFromTurnaroundTimeProjector with {
    briefly "The TurnaroundTimeProjector projection on its way to storage"
  }
  connector 'ModalityUtilizationProjector Storage' is from outlet RadiologyContext.ModalityUtilizationProjector.ModalityUtilizationProjectorOut to inlet RadiologyContext.ExamRepository.ExamRepositoryFromModalityUtilizationProjector with {
    briefly "The ModalityUtilizationProjector projection on its way to storage"
  }
  connector 'CriticalFindingProjector Storage' is from outlet RadiologyContext.CriticalFindingProjector.CriticalFindingProjectorOut to inlet RadiologyContext.ExamRepository.ExamRepositoryFromCriticalFindingProjector with {
    briefly "The CriticalFindingProjector projection on its way to storage"
  }
  connector 'RadiologistProductivityProjector Storage' is from outlet RadiologyContext.RadiologistProductivityProjector.RadiologistProductivityProjectorOut to inlet RadiologyContext.ExamRepository.ExamRepositoryFromRadiologistProductivityProjector with {
    briefly "The RadiologistProductivityProjector projection on its way to storage"
  }
} with {
  briefly "Primary bounded context for radiology workflow"
  described as {
    | The RadiologyContext contains the core domain model for radiology
    | operations including the ImagingExam aggregate, repositories for
    | querying exams/studies/reports, and projectors for operational
    | analytics. It coordinates with external systems (PACS, RIS, Speech
    | Recognition) through defined integration points.
  }
}
