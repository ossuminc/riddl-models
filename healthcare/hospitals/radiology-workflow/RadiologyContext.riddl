// RadiologyContext - Main Bounded Context
// Contains the primary entities, repositories, and projectors for radiology workflow
context RadiologyContext is {
  adaptor FromPACSIntegration from context PACSIntegration is {
    handler FromPACSIntegrationHandler is {
      on event PACSIntegration.ImagesRetrieved is {
        do "the model receives images retrieved"
      }
      on event PACSIntegration.ImagesStored is {
        do "the model receives images stored"
      }
      on other is {
        error "Unexpected message for adaptor FromPACSIntegration"
      }
    } with {
      briefly "from pacs integration"
      described as {
        |Carries messages from the external PACSIntegration.
      }
    }
  } with {
      briefly "PACSIntegration integration"
    described as {
      |The model's side of the PACSIntegration conversation.
    }
  }
  adaptor ToPACSIntegration to context PACSIntegration is {
    handler ToPACSIntegrationHandler is {
      on command PACSIntegration.PrefetchPriorStudies is {
        do "the model sends prefetch prior studies"
      }
      on command PACSIntegration.RetrieveImages is {
        do "the model sends retrieve images"
      }
      on command PACSIntegration.StoreImages is {
        do "the model sends store images"
      }
      on other is {
        error "Unexpected message for adaptor ToPACSIntegration"
      }
    } with {
      briefly "to pacs integration"
      described as {
        |Carries messages to the external PACSIntegration.
      }
    }
  } with {
      briefly "PACSIntegration integration"
    described as {
      |The model's side of the PACSIntegration conversation.
    }
  }
  adaptor FromRISIntegration from context RISIntegration is {
    handler FromRISIntegrationHandler is {
      on event RISIntegration.ExamScheduledInRIS is {
        do "the model receives exam scheduled in ris"
      }
      on event RISIntegration.WorklistUpdated is {
        do "the model receives worklist updated"
      }
      on other is {
        error "Unexpected message for adaptor FromRISIntegration"
      }
    } with {
      briefly "from ris integration"
      described as {
        |Carries messages from the external RISIntegration.
      }
    }
  } with {
      briefly "RISIntegration integration"
    described as {
      |The model's side of the RISIntegration conversation.
    }
  }
  adaptor ToRISIntegration to context RISIntegration is {
    handler ToRISIntegrationHandler is {
      on command RISIntegration.GetModalityWorklist is {
        do "the model sends get modality worklist"
      }
      on command RISIntegration.ScheduleExamInRIS is {
        do "the model sends schedule exam in ris"
      }
      on command RISIntegration.UpdateExamStatus is {
        do "the model sends update exam status"
      }
      on other is {
        error "Unexpected message for adaptor ToRISIntegration"
      }
    } with {
      briefly "to ris integration"
      described as {
        |Carries messages to the external RISIntegration.
      }
    }
  } with {
      briefly "RISIntegration integration"
    described as {
      |The model's side of the RISIntegration conversation.
    }
  }
  adaptor FromSpeechRecognition from context SpeechRecognition is {
    handler FromSpeechRecognitionHandler is {
      on event SpeechRecognition.DictationCompleted is {
        do "the model receives dictation completed"
      }
      on event SpeechRecognition.DictationStarted is {
        do "the model receives dictation started"
      }
      on event SpeechRecognition.TranscriptionCorrected is {
        do "the model receives transcription corrected"
      }
      on other is {
        error "Unexpected message for adaptor FromSpeechRecognition"
      }
    } with {
      briefly "from speech recognition"
      described as {
        |Carries messages from the external SpeechRecognition.
      }
    }
  } with {
      briefly "SpeechRecognition integration"
    described as {
      |The model's side of the SpeechRecognition conversation.
    }
  }
  adaptor ToSpeechRecognition to context SpeechRecognition is {
    handler ToSpeechRecognitionHandler is {
      on command SpeechRecognition.EndDictation is {
        do "the model sends end dictation"
      }
      on command SpeechRecognition.InsertMacro is {
        do "the model sends insert macro"
      }
      on command SpeechRecognition.StartDictation is {
        do "the model sends start dictation"
      }
      on other is {
        error "Unexpected message for adaptor ToSpeechRecognition"
      }
    } with {
      briefly "to speech recognition"
      described as {
        |Carries messages to the external SpeechRecognition.
      }
    }
  } with {
      briefly "SpeechRecognition integration"
    described as {
      |The model's side of the SpeechRecognition conversation.
    }
  }
  include "types.riddl"
  include "ImagingExam.riddl"
  // ==========================================================================
  // Repository
  // ==========================================================================
  repository ExamRepository is {
    record StoredImagingExam is {
      imagingExamId: UUID with {
        briefly "imagingExamId"
        described as {
          |The imagingExamId column of the stored imagingExam row.
        }
      }
    } with {
      briefly "Stored imagingExam row"
      described as {
        |The persistence shape of imagingExam data as this repository stores it.
      }
    }
    schema ImagingExamData is relational
      of imagingexams as type StoredImagingExam
      with {
      briefly "Imaging exam data schema"
      described as {
        |The relational schema persisting imaging exam records for this repository.
      }
    }
    inlet ExamRepositoryFromImagingExam is type ImagingExamEvent
    inlet ExamRepositoryFromTurnaroundTimeProjector is type ImagingExamEvent
    inlet ExamRepositoryFromModalityUtilizationProjector is type ImagingExamEvent
    inlet ExamRepositoryFromCriticalFindingProjector is type ImagingExamEvent
    inlet ExamRepositoryFromRadiologistProductivityProjector is type ImagingExamEvent
    outlet ExamRepositoryResponses is type ImagingExam.ImagingExamResult
    // Exam queries
    query FindExamById is  { examId: ExamId } with {
      briefly "Find exam by identifier"
      described as {
        |Retrieves a single imaging exam by its unique identifier.
      }
    }
    query FindExamsByPatient is  {
      patientId: PatientId
      filterStartDate: Date?
      filterEndDate: Date?
    } with {
      briefly "Find exams for a patient"
      described as {
        | Retrieves all imaging exams for a patient within optional
        | date range.
      }
    }
    query FindExamsByStatus is  {
      status: ExamStatus
      modalityType: ModalityType?
      limit: Integer
    } with {
      briefly "Find exams by status"
      described as {
        | Retrieves exams in a specific workflow status, optionally
        | filtered by modality type.
      }
    }
    query FindScheduledExams is  {
      startDateTime: TimeStamp
      endDateTime: TimeStamp
      modalityId: ModalityId?
    } with {
      briefly "Find scheduled exams in time range"
      described as {
        | Retrieves exams scheduled within a time window for worklist
        | and capacity planning.
      }
    }
    // Study queries
    query FindStudyById is  { studyId: StudyId } with {
      briefly "Find study by identifier"
      described as {
        |Retrieves DICOM study metadata by study ID.
      }
    }
    query FindStudiesByPatient is  {
      patientId: PatientId
      modalityType: ModalityType?
      filterStartDate: Date?
      filterEndDate: Date?
    } with {
      briefly "Find studies for a patient"
      described as {
        |Retrieves study history for a patient for comparison views.
      }
    }
    query FindPriorStudies is  {
      patientId: PatientId
      bodyPart: String
      limit: Integer
    } with {
      briefly "Find prior studies of same body part"
      described as {
        | Retrieves relevant prior studies for comparison during
        | interpretation.
      }
    }
    // Report queries
    query FindReportById is  { reportId: ReportId } with {
      briefly "Find report by identifier"
      described as {
        |Retrieves a radiology report by its unique identifier.
      }
    }
    query FindReportsByRadiologist is  {
      radiologistId: PhysicianId
      reportStatus: ReportStatus?
      filterStartDate: Date?
      filterEndDate: Date?
    } with {
      briefly "Find reports by radiologist"
      described as {
        | Retrieves reports created by a specific radiologist for
        | productivity tracking.
      }
    }
    query FindPendingReports is  {
      radiologistId: PhysicianId?
      priority: ExamPriority?
      limit: Integer
    } with {
      briefly "Find reports awaiting signature"
      described as {
        |Retrieves draft reports in the interpretation queue.
      }
    }
    query FindCriticalFindings is  {
      filterStartDate: Date
      filterEndDate: Date
      isAcknowledged: Boolean?
    } with {
      briefly "Find critical findings"
      described as {
        | Retrieves critical findings for compliance reporting and
        | follow-up tracking.
      }
    }
    handler ExamRepositoryHandler is {
      on query GetTurnaroundTimeRecord is {
        do "read the turnaround time record projection"
        yield result TurnaroundTimeRecordView
      }
      on query GetUtilizationRecord is {
        do "read the utilization record projection"
        yield result UtilizationRecordView
      }
      on query GetCriticalFindingRecord is {
        do "read the critical finding record projection"
        yield result CriticalFindingRecordView
      }
      on query GetProductivityRecord is {
        do "read the productivity record projection"
        yield result ProductivityRecordView
      }
      on query FindExamById is {
        yield result ImagingExamResult
        do "Retrieve exam from event-sourced store"
      }
      on query FindExamsByPatient is {
        yield result ImagingExamResult
        do "Query exams by patient with date filtering"
      }
      on query FindExamsByStatus is {
        yield result ImagingExamResult
        do "Query exams by workflow status"
      }
      on query FindScheduledExams is {
        yield result ImagingExamResult
        do "Query scheduled exams for worklist"
      }
      on query FindStudyById is {
        yield result ImagingExamResult
        do "Retrieve study metadata"
      }
      on query FindStudiesByPatient is {
        yield result ImagingExamResult
        do "Query patient study history"
      }
      on query FindPriorStudies is {
        yield result ImagingExamResult
        do "Find relevant prior studies for comparison"
      }
      on query FindReportById is {
        yield result ImagingExamResult
        do "Retrieve radiology report"
      }
      on query FindReportsByRadiologist is {
        yield result ImagingExamResult
        do "Query reports by interpreting radiologist"
      }
      on query FindPendingReports is {
        yield result ImagingExamResult
        do "Query interpretation worklist"
      }
      on query FindCriticalFindings is {
        yield result ImagingExamResult
        do "Query critical findings for compliance"
      }
      on other is {
        error "Unknown repository query"
      }
    } with {
      briefly "Handles repository queries"
      described as {
        | Processes all exam, study, and report queries against the
        | event-sourced data store.
      }
    }
  } with {
    briefly "Repository for exams, studies, and reports"
    described as {
      | Provides query capabilities for imaging exams, DICOM studies, and
      | radiology reports. Supports worklist generation, patient history
      | retrieval, and compliance reporting for critical findings.
    }
  }
  // ==========================================================================
  // Projectors
  // ==========================================================================
  query GetTurnaroundTimeRecord is {
    turnaroundTimeRecordKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which turnaround time record to retrieve.
      }
    }
  } with {
    briefly "Get turnaround time record"
    described as {
      |Retrieves the turnaround time record projection.
    }
  }
  result TurnaroundTimeRecordView is {
    turnaroundTimeRecord: TurnaroundTimeProjector.TurnaroundTimeRecord with {
      briefly "Turnaround time record"
      described as {
        |The turnaround time record being returned.
      }
    }
  } with {
    briefly "Turnaround time record view"
    described as {
      |Read model view carrying the turnaround time record projection.
    }
  }
  projector TurnaroundTimeProjector is {
    inlet TurnaroundTimeProjectorFromImagingExam is type ImagingExamEvent
    outlet TurnaroundTimeProjectorOut is type ImagingExamEvent
    updates repository RadiologyContext.ExamRepository
    record TurnaroundTimeRecord is  {
      examId: ExamId
      modalityType: ModalityType
      priority: ExamPriority
      orderToScheduleMinutes: Integer?
      scheduleToAcquisitionMinutes: Integer?
      acquisitionToInterpretationMinutes: Integer?
      interpretationToFinalMinutes: Integer?
      totalTurnaroundMinutes: Integer?
      metSLA: Boolean?
    } with {
      briefly "Turnaround time metrics record"
      described as {
        | Stores calculated turnaround durations for each workflow
        | phase for performance analysis.
      }
    }
    handler TurnaroundTimeHandler is {
      on event ExamOrdered is {
        tell event ExamOrdered to repository RadiologyContext.ExamRepository
        do "Record exam creation timestamp"
      }
      on event ExamScheduled is {
        tell event ExamScheduled to repository RadiologyContext.ExamRepository
        do "Calculate order-to-schedule duration"
      }
      on event AcquisitionCompleted is {
        tell event AcquisitionCompleted to repository RadiologyContext.ExamRepository
        do "Calculate schedule-to-acquisition duration"
      }
      on event DraftReportCreated is {
        tell event DraftReportCreated to repository RadiologyContext.ExamRepository
        do "Calculate acquisition-to-interpretation duration"
      }
      on event ReportFinalized is {
        tell event ReportFinalized to repository RadiologyContext.ExamRepository
        do "Calculate interpretation-to-final and total turnaround"
      }
      on other is {
        do "Ignore other events"
      }
    } with {
      briefly "Projects turnaround time metrics"
      described as {
        | Calculates and stores duration between workflow milestones
        | for performance tracking and SLA compliance.
      }
    }
  } with {
    briefly "Turnaround time metrics projector"
    described as {
      | Projects imaging exam events into turnaround time metrics. Tracks
      | duration between each workflow phase to support operational dashboards,
      | SLA monitoring, and quality improvement initiatives.
    }
  }
  query GetUtilizationRecord is {
    utilizationRecordKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which utilization record to retrieve.
      }
    }
  } with {
    briefly "Get utilization record"
    described as {
      |Retrieves the utilization record projection.
    }
  }
  result UtilizationRecordView is {
    utilizationRecord: ModalityUtilizationProjector.UtilizationRecord with {
      briefly "Utilization record"
      described as {
        |The utilization record being returned.
      }
    }
  } with {
    briefly "Utilization record view"
    described as {
      |Read model view carrying the utilization record projection.
    }
  }
  projector ModalityUtilizationProjector is {
    inlet ModalityUtilizationProjectorFromImagingExam is type ImagingExamEvent
    outlet ModalityUtilizationProjectorOut is type ImagingExamEvent
    updates repository RadiologyContext.ExamRepository
    record UtilizationRecord is  {
      modalityId: ModalityId
      modalityType: ModalityType
      date: Date
      hour: Integer
      scheduledCount: Integer
      completedCount: Integer
      cancelledCount: Integer
      totalAcquisitionMinutes: Integer
      availableMinutes: Integer
    } with {
      briefly "Hourly modality utilization record"
      described as {
        | Stores hourly utilization metrics for capacity planning
        | and equipment optimization.
      }
    }
    handler UtilizationHandler is {
      on event ExamScheduled is {
        tell event ExamScheduled to repository RadiologyContext.ExamRepository
        do "Increment scheduled count for modality and time slot"
      }
      on event AcquisitionStarted is {
        tell event AcquisitionStarted to repository RadiologyContext.ExamRepository
        do "Record acquisition start time"
      }
      on event AcquisitionCompleted is {
        tell event AcquisitionCompleted to repository RadiologyContext.ExamRepository
        do "Calculate acquisition duration and update utilization"
      }
      on other is {
        do "Ignore other events"
      }
    } with {
      briefly "Projects modality utilization"
      described as {
        | Aggregates exam events into hourly utilization metrics
        | per modality for capacity analysis.
      }
    }
  } with {
    briefly "Modality utilization projector"
    described as {
      | Projects exam acquisition events into modality utilization metrics.
      | Tracks scheduled vs completed exams, acquisition durations, and
      | equipment availability to support capacity planning and resource
      | optimization.
    }
  }
  query GetCriticalFindingRecord is {
    criticalFindingRecordKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which critical finding record to retrieve.
      }
    }
  } with {
    briefly "Get critical finding record"
    described as {
      |Retrieves the critical finding record projection.
    }
  }
  result CriticalFindingRecordView is {
    criticalFindingRecord: CriticalFindingProjector.CriticalFindingRecord with {
      briefly "Critical finding record"
      described as {
        |The critical finding record being returned.
      }
    }
  } with {
    briefly "Critical finding record view"
    described as {
      |Read model view carrying the critical finding record projection.
    }
  }
  projector CriticalFindingProjector is {
    inlet CriticalFindingProjectorFromImagingExam is type ImagingExamEvent
    outlet CriticalFindingProjectorOut is type ImagingExamEvent
    updates repository RadiologyContext.ExamRepository
    record CriticalFindingRecord is  {
      findingId: String
      examId: ExamId
      severity: CriticalFindingSeverity
      identifiedAt: TimeStamp
      communicatedAt: TimeStamp?
      communicationDelayMinutes: Integer?
      acknowledged: Boolean
      radiologistId: PhysicianId
      orderingPhysicianId: PhysicianId
    } with {
      briefly "Critical finding tracking record"
      described as {
        | Stores critical finding events with communication timing
        | for compliance reporting.
      }
    }
    handler CriticalFindingHandler is {
      on event CriticalFindingReported is {
        tell event CriticalFindingReported to repository RadiologyContext.ExamRepository
        do "Record critical finding with identification time"
      }
      on other is {
        do "Ignore non-critical finding events"
      }
    } with {
      briefly "Projects critical findings"
      described as {
        | Tracks critical finding identification and communication
        | for ACR compliance monitoring.
      }
    }
  } with {
    briefly "Critical finding compliance projector"
    described as {
      | Projects critical finding events for compliance monitoring. Tracks
      | time from identification to physician notification to ensure adherence
      | to ACR Practice Parameter for communication of diagnostic imaging
      | findings.
    }
  }
  query GetProductivityRecord is {
    productivityRecordKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which productivity record to retrieve.
      }
    }
  } with {
    briefly "Get productivity record"
    described as {
      |Retrieves the productivity record projection.
    }
  }
  result ProductivityRecordView is {
    productivityRecord: RadiologistProductivityProjector.ProductivityRecord with {
      briefly "Productivity record"
      described as {
        |The productivity record being returned.
      }
    }
  } with {
    briefly "Productivity record view"
    described as {
      |Read model view carrying the productivity record projection.
    }
  }
  projector RadiologistProductivityProjector is {
    inlet RadiologistProductivityProjectorFromImagingExam is type ImagingExamEvent
    outlet RadiologistProductivityProjectorOut is type ImagingExamEvent
    updates repository RadiologyContext.ExamRepository
    record ProductivityRecord is  {
      radiologistId: PhysicianId
      date: Date
      reportsCreated: Integer
      reportsFinalized: Integer
      totalRVUs: Number
      averageReportTimeMinutes: Integer
      criticalFindingsReported: Integer
    } with {
      briefly "Daily radiologist productivity record"
      described as {
        | Stores daily productivity metrics per radiologist for
        | workload management and performance tracking.
      }
    }
    handler ProductivityHandler is {
      on event DraftReportCreated is {
        tell event DraftReportCreated to repository RadiologyContext.ExamRepository
        do "Increment reports created count"
      }
      on event ReportFinalized is {
        tell event ReportFinalized to repository RadiologyContext.ExamRepository
        do "Increment finalized count and calculate RVUs"
      }
      on event CriticalFindingReported is {
        tell event CriticalFindingReported to repository RadiologyContext.ExamRepository
        do "Increment critical findings count"
      }
      on other is {
        do "Ignore other events"
      }
    } with {
      briefly "Projects radiologist productivity"
      described as {
        | Aggregates report events into daily productivity metrics
        | per radiologist.
      }
    }
  } with {
    briefly "Radiologist productivity projector"
    described as {
      | Projects report events into radiologist productivity metrics. Tracks
      | report volumes, RVUs, and critical findings per radiologist per day
      | for workload balancing and performance management.
    }
  }
  // ---- Event publication for ImagingExam ----
  type ImagingExamEvent is one of {
    RadiologyContext.ImagingExam.ExamOrdered,
    RadiologyContext.ImagingExam.ExamScheduled,
    RadiologyContext.ImagingExam.PatientCheckedIn,
    RadiologyContext.ImagingExam.AcquisitionStarted,
    RadiologyContext.ImagingExam.AcquisitionCompleted,
    RadiologyContext.ImagingExam.DraftReportCreated,
    RadiologyContext.ImagingExam.ReportFinalized,
    RadiologyContext.ImagingExam.AddendumAdded,
    RadiologyContext.ImagingExam.CriticalFindingReported
  } with {
    briefly "ImagingExam event alternation"
    described as {
      |Union of all ImagingExam events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ImagingExamEventSource as source is {
    outlet ImagingExamEvents is type ImagingExamEvent
    handler ImagingExamSourceHandler is {
      on event ImagingExam.ExamOrdered is {
        send event ImagingExam.ExamOrdered to outlet ImagingExamEvents
      }
      on event ImagingExam.ExamScheduled is {
        send event ImagingExam.ExamScheduled to outlet ImagingExamEvents
      }
      on event ImagingExam.PatientCheckedIn is {
        send event ImagingExam.PatientCheckedIn to outlet ImagingExamEvents
      }
      on event ImagingExam.AcquisitionStarted is {
        send event ImagingExam.AcquisitionStarted to outlet ImagingExamEvents
      }
      on event ImagingExam.AcquisitionCompleted is {
        send event ImagingExam.AcquisitionCompleted to outlet ImagingExamEvents
      }
      on event ImagingExam.DraftReportCreated is {
        send event ImagingExam.DraftReportCreated to outlet ImagingExamEvents
      }
      on event ImagingExam.ReportFinalized is {
        send event ImagingExam.ReportFinalized to outlet ImagingExamEvents
      }
      on event ImagingExam.AddendumAdded is {
        send event ImagingExam.AddendumAdded to outlet ImagingExamEvents
      }
      on event ImagingExam.CriticalFindingReported is {
        send event ImagingExam.CriticalFindingReported to outlet ImagingExamEvents
      }
      on other is {
        error "Unexpected message for source ImagingExamEventSource"
      }
    } with {
      briefly "ImagingExam source handler"
      described as {
        |Publishes ImagingExam events onto the outlet.
      }
    }
  } with {
    briefly "ImagingExam event source"
    described as {
      |Publishes ImagingExam entity events into the streaming topology.
    }
  }
  processor ImagingExamEventSink as sink is {
    inlet ImagingExamInlet is type ImagingExamEvent
    handler ImagingExamSinkHandler is {
      on event ImagingExam.ExamOrdered is {
        tell event ImagingExam.ExamOrdered to repository RadiologyContext.ExamRepository
      }
      on event ImagingExam.ExamScheduled is {
        tell event ImagingExam.ExamScheduled to repository RadiologyContext.ExamRepository
      }
      on event ImagingExam.PatientCheckedIn is {
        tell event ImagingExam.PatientCheckedIn to repository RadiologyContext.ExamRepository
      }
      on event ImagingExam.AcquisitionStarted is {
        tell event ImagingExam.AcquisitionStarted to repository RadiologyContext.ExamRepository
      }
      on event ImagingExam.AcquisitionCompleted is {
        tell event ImagingExam.AcquisitionCompleted to repository RadiologyContext.ExamRepository
      }
      on event ImagingExam.DraftReportCreated is {
        tell event ImagingExam.DraftReportCreated to repository RadiologyContext.ExamRepository
      }
      on event ImagingExam.ReportFinalized is {
        tell event ImagingExam.ReportFinalized to repository RadiologyContext.ExamRepository
      }
      on event ImagingExam.AddendumAdded is {
        tell event ImagingExam.AddendumAdded to repository RadiologyContext.ExamRepository
      }
      on event ImagingExam.CriticalFindingReported is {
        tell event ImagingExam.CriticalFindingReported to repository RadiologyContext.ExamRepository
      }
      on other is {
        error "Unexpected message for sink ImagingExamEventSink"
      }
    } with {
      briefly "ImagingExam sink handler"
      described as {
        |Persists ImagingExam events via the repository.
      }
    }
  } with {
    briefly "ImagingExam event sink"
    described as {
      |Receives ImagingExam events for persistence.
    }
  }
  connector ImagingExamEventFlow is {
    from outlet RadiologyContext.ImagingExamEventSource.ImagingExamEvents to
      inlet RadiologyContext.ImagingExamEventSink.ImagingExamInlet
  } with {
    briefly "ImagingExam event flow"
    described as {
      |Connects the ImagingExam source to its sink.
    }
  }
  processor ImagingExamEventSplit is {
    inlet ImagingExamEventSplitIn is type ImagingExamEvent
    outlet ImagingExamEventSplitToExamRepository is type ImagingExamEvent
    outlet ImagingExamEventSplitToTurnaroundTimeProjector is type ImagingExamEvent
    outlet ImagingExamEventSplitToModalityUtilizationProjector is type ImagingExamEvent
    outlet ImagingExamEventSplitToCriticalFindingProjector is type ImagingExamEvent
    outlet ImagingExamEventSplitToRadiologistProductivityProjector is type ImagingExamEvent
    handler ImagingExamEventSplitHandler is {
      on event ImagingExam.ExamOrdered is {
        send event ImagingExam.ExamOrdered to outlet ImagingExamEventSplitToExamRepository
        send event ImagingExam.ExamOrdered to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send event ImagingExam.ExamOrdered to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send event ImagingExam.ExamOrdered to outlet ImagingExamEventSplitToCriticalFindingProjector
        send event ImagingExam.ExamOrdered to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell event ImagingExam.ExamOrdered to entity RadiologyContext.ImagingExam
      }
      on event ImagingExam.ExamScheduled is {
        send event ImagingExam.ExamScheduled to outlet ImagingExamEventSplitToExamRepository
        send event ImagingExam.ExamScheduled to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send event ImagingExam.ExamScheduled to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send event ImagingExam.ExamScheduled to outlet ImagingExamEventSplitToCriticalFindingProjector
        send event ImagingExam.ExamScheduled to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell event ImagingExam.ExamScheduled to entity RadiologyContext.ImagingExam
      }
      on event ImagingExam.PatientCheckedIn is {
        send event ImagingExam.PatientCheckedIn to outlet ImagingExamEventSplitToExamRepository
        send event ImagingExam.PatientCheckedIn to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send event ImagingExam.PatientCheckedIn to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send event ImagingExam.PatientCheckedIn to outlet ImagingExamEventSplitToCriticalFindingProjector
        send event ImagingExam.PatientCheckedIn to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell event ImagingExam.PatientCheckedIn to entity RadiologyContext.ImagingExam
      }
      on event ImagingExam.AcquisitionStarted is {
        send event ImagingExam.AcquisitionStarted to outlet ImagingExamEventSplitToExamRepository
        send event ImagingExam.AcquisitionStarted to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send event ImagingExam.AcquisitionStarted to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send event ImagingExam.AcquisitionStarted to outlet ImagingExamEventSplitToCriticalFindingProjector
        send event ImagingExam.AcquisitionStarted to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell event ImagingExam.AcquisitionStarted to entity RadiologyContext.ImagingExam
      }
      on event ImagingExam.AcquisitionCompleted is {
        send event ImagingExam.AcquisitionCompleted to outlet ImagingExamEventSplitToExamRepository
        send event ImagingExam.AcquisitionCompleted to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send event ImagingExam.AcquisitionCompleted to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send event ImagingExam.AcquisitionCompleted to outlet ImagingExamEventSplitToCriticalFindingProjector
        send event ImagingExam.AcquisitionCompleted to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell event ImagingExam.AcquisitionCompleted to entity RadiologyContext.ImagingExam
      }
      on event ImagingExam.DraftReportCreated is {
        send event ImagingExam.DraftReportCreated to outlet ImagingExamEventSplitToExamRepository
        send event ImagingExam.DraftReportCreated to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send event ImagingExam.DraftReportCreated to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send event ImagingExam.DraftReportCreated to outlet ImagingExamEventSplitToCriticalFindingProjector
        send event ImagingExam.DraftReportCreated to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell event ImagingExam.DraftReportCreated to entity RadiologyContext.ImagingExam
      }
      on event ImagingExam.ReportFinalized is {
        send event ImagingExam.ReportFinalized to outlet ImagingExamEventSplitToExamRepository
        send event ImagingExam.ReportFinalized to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send event ImagingExam.ReportFinalized to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send event ImagingExam.ReportFinalized to outlet ImagingExamEventSplitToCriticalFindingProjector
        send event ImagingExam.ReportFinalized to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell event ImagingExam.ReportFinalized to entity RadiologyContext.ImagingExam
      }
      on event ImagingExam.AddendumAdded is {
        send event ImagingExam.AddendumAdded to outlet ImagingExamEventSplitToExamRepository
        send event ImagingExam.AddendumAdded to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send event ImagingExam.AddendumAdded to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send event ImagingExam.AddendumAdded to outlet ImagingExamEventSplitToCriticalFindingProjector
        send event ImagingExam.AddendumAdded to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell event ImagingExam.AddendumAdded to entity RadiologyContext.ImagingExam
      }
      on event ImagingExam.CriticalFindingReported is {
        send event ImagingExam.CriticalFindingReported to outlet ImagingExamEventSplitToExamRepository
        send event ImagingExam.CriticalFindingReported to outlet ImagingExamEventSplitToTurnaroundTimeProjector
        send event ImagingExam.CriticalFindingReported to outlet ImagingExamEventSplitToModalityUtilizationProjector
        send event ImagingExam.CriticalFindingReported to outlet ImagingExamEventSplitToCriticalFindingProjector
        send event ImagingExam.CriticalFindingReported to outlet ImagingExamEventSplitToRadiologistProductivityProjector
        tell event ImagingExam.CriticalFindingReported to entity RadiologyContext.ImagingExam
      }
      on other is {
        error "Unexpected message for processor ImagingExamEventSplit"
      }
    } with {
      briefly "ImagingExam event fan-out handler"
      described as {
        |Delivers each ImagingExam event to all of its consumers.
      }
    }
  } with {
    briefly "ImagingExam event fan-out"
    described as {
      |Fans ImagingExam events out to the repository and projectors.
    }
  }
  connector LinkImagingExamToImagingExamEventSplit is {
    from outlet RadiologyContext.ImagingExam.ImagingExamEvents2 to
      inlet RadiologyContext.ImagingExamEventSplit.ImagingExamEventSplitIn
  } with {
    briefly "LinkImagingExamToImagingExamEventSplit"
  }
  connector LinkImagingExamEventSplitToExamRepository is {
    from outlet RadiologyContext.ImagingExamEventSplit.ImagingExamEventSplitToExamRepository to
      inlet RadiologyContext.ExamRepository.ExamRepositoryFromImagingExam
  } with {
    briefly "LinkImagingExamEventSplitToExamRepository"
  }
  connector LinkImagingExamEventSplitToTurnaroundTimeProjector is {
    from outlet RadiologyContext.ImagingExamEventSplit.ImagingExamEventSplitToTurnaroundTimeProjector to
      inlet RadiologyContext.TurnaroundTimeProjector.TurnaroundTimeProjectorFromImagingExam
  } with {
    briefly "LinkImagingExamEventSplitToTurnaroundTimeProjector"
  }
  connector LinkImagingExamEventSplitToModalityUtilizationProjector is {
    from outlet RadiologyContext.ImagingExamEventSplit.ImagingExamEventSplitToModalityUtilizationProjector to
      inlet RadiologyContext.ModalityUtilizationProjector.ModalityUtilizationProjectorFromImagingExam
  } with {
    briefly "LinkImagingExamEventSplitToModalityUtilizationProjector"
  }
  connector LinkImagingExamEventSplitToCriticalFindingProjector is {
    from outlet RadiologyContext.ImagingExamEventSplit.ImagingExamEventSplitToCriticalFindingProjector to
      inlet RadiologyContext.CriticalFindingProjector.CriticalFindingProjectorFromImagingExam
  } with {
    briefly "LinkImagingExamEventSplitToCriticalFindingProjector"
  }
  connector LinkImagingExamEventSplitToRadiologistProductivityProjector is {
    from outlet RadiologyContext.ImagingExamEventSplit.ImagingExamEventSplitToRadiologistProductivityProjector to
      inlet RadiologyContext.RadiologistProductivityProjector.RadiologistProductivityProjectorFromImagingExam
  } with {
    briefly "LinkImagingExamEventSplitToRadiologistProductivityProjector"
  }
  connector LinkTurnaroundTimeProjectorToExamRepository is {
    from outlet RadiologyContext.TurnaroundTimeProjector.TurnaroundTimeProjectorOut to
      inlet RadiologyContext.ExamRepository.ExamRepositoryFromTurnaroundTimeProjector
  } with {
    briefly "LinkTurnaroundTimeProjectorToExamRepository"
  }
  connector LinkModalityUtilizationProjectorToExamRepository is {
    from outlet RadiologyContext.ModalityUtilizationProjector.ModalityUtilizationProjectorOut to
      inlet RadiologyContext.ExamRepository.ExamRepositoryFromModalityUtilizationProjector
  } with {
    briefly "LinkModalityUtilizationProjectorToExamRepository"
  }
  connector LinkCriticalFindingProjectorToExamRepository is {
    from outlet RadiologyContext.CriticalFindingProjector.CriticalFindingProjectorOut to
      inlet RadiologyContext.ExamRepository.ExamRepositoryFromCriticalFindingProjector
  } with {
    briefly "LinkCriticalFindingProjectorToExamRepository"
  }
  connector LinkRadiologistProductivityProjectorToExamRepository is {
    from outlet RadiologyContext.RadiologistProductivityProjector.RadiologistProductivityProjectorOut to
      inlet RadiologyContext.ExamRepository.ExamRepositoryFromRadiologistProductivityProjector
  } with {
    briefly "LinkRadiologistProductivityProjectorToExamRepository"
  }
} with {
  briefly "Primary bounded context for radiology workflow"
  described as {
    | The RadiologyContext contains the core domain model for radiology
    | operations including the ImagingExam aggregate, repositories for
    | querying exams/studies/reports, and projectors for operational
    | analytics. It coordinates with external systems (PACS, RIS, Speech
    | Recognition) through defined integration points.
  }
}
