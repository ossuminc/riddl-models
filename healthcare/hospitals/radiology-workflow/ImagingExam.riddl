// ImagingExam Entity
// Core entity managing the lifecycle of an imaging examination
aggregate event-sourced entity ImagingExam as flow is {
  type ImagingExamCommand is one of {
    ImagingExam.OrderExam or ImagingExam.ScheduleExam or ImagingExam.CheckInPatient or ImagingExam.StartAcquisition or ImagingExam.CompleteAcquisition or ImagingExam.CreateDraftReport or ImagingExam.FinalizeReport or ImagingExam.AddAddendum or ImagingExam.ReportCriticalFinding
  } with {
    briefly "ImagingExam command alternation"
    described as {
      |Commands accepted by the ImagingExam entity.
    }
  }
  inlet ImagingExamCommands is type ImagingExamCommand  outlet ImagingExamEvents2 is type ImagingExamEvent
  query GetImagingExam is  {
    imagingExamId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the ImagingExam to retrieve.
      }
    }
  } with {
    briefly "Get ImagingExam"
    described as {
      |Retrieve ImagingExam data by identifier.
    }
  }
  result ImagingExamResult is  {
    imagingExamData: ImagingExam.OrderedStateData with {
      briefly "ImagingExam data"
      described as {
        |The requested ImagingExam data.
      }
    }
  } with {
    briefly "ImagingExam result"
    described as {
      |Result carrying the requested ImagingExam data.
    }
  }
  // ==========================================================================
  // Commands
  // ==========================================================================
  command OrderExam yields event ExamOrdered is  {
    examId: ExamId
    patientId: PatientId
    orderingPhysicianId: PhysicianId
    examCode: String
    examDescription: String
    modalityType: ModalityType
    priority: ExamPriority
    clinicalIndication: String
    relevantHistory: String
    specialInstructions: String?
  } with {
    briefly "Order a new imaging examination"
    described as {
      | Initiates the radiology workflow by creating a new imaging
      | order with clinical context and priority.
    }
  }
  command ScheduleExam yields event ExamScheduled is  {
    examId: ExamId
    scheduledDateTime: TimeStamp
    modalityId: ModalityId
    roomLocation: String
    scheduledDuration: Duration
    protocol: ExamProtocol
  } with {
    briefly "Schedule the examination appointment"
    described as {
      | Assigns a specific date, time, modality, and protocol to the
      | ordered examination.
    }
  }
  command CheckInPatient yields event PatientCheckedIn is  {
    examId: ExamId
    checkedInAt: TimeStamp
    verifiedIdentity: Boolean
    consentObtained: Boolean
    screeningCompleted: Boolean
  } with {
    briefly "Check in patient for their scheduled exam"
    described as {
      | Records patient arrival and completion of pre-exam safety
      | screening and consent processes.
    }
  }
  command StartAcquisition yields event AcquisitionStarted is  {
    examId: ExamId
    technicianId: TechnicianId
    modalityId: ModalityId
    startedAt: TimeStamp
  } with {
    briefly "Begin image acquisition"
    described as {
      | Marks the start of the imaging procedure when the technician
      | begins acquiring images.
    }
  }
  command CompleteAcquisition yields event AcquisitionCompleted is  {
    examId: ExamId
    studyInfo: StudyInfo
    completedAt: TimeStamp
    technicianNotes: String?
  } with {
    briefly "Complete image acquisition"
    described as {
      | Records completion of imaging with DICOM study metadata and
      | technician notes about the examination.
    }
  }
  command CreateDraftReport yields event DraftReportCreated is  {
    examId: ExamId
    radiologistId: PhysicianId
    findings: String
    impression: String
    recommendations: String?
    comparisonStudies: StudyId*
  } with {
    briefly "Create initial draft report"
    described as {
      | Radiologist creates the preliminary interpretation of the
      | imaging study.
    }
  }
  command FinalizeReport yields event ReportFinalized is  {
    examId: ExamId
    reportId: ReportId
    radiologistId: PhysicianId
    signedAt: TimeStamp
  } with {
    briefly "Sign and finalize the radiology report"
    described as {
      | Radiologist electronically signs the report, making it
      | available to ordering physicians.
    }
  }
  command AddAddendum yields event AddendumAdded is  {
    examId: ExamId
    reportId: ReportId
    radiologistId: PhysicianId
    addendumText: String
    addendumReason: String
  } with {
    briefly "Add an addendum to a finalized report"
    described as {
      | Allows radiologist to add supplementary information to a
      | finalized report without modifying the original interpretation.
    }
  }
  command ReportCriticalFinding yields event CriticalFindingReported is  {
    examId: ExamId
    finding: CriticalFinding
  } with {
    briefly "Report a critical finding requiring immediate communication"
    described as {
      | Initiates the critical finding communication workflow per
      | ACR guidelines for urgent results.
    }
  }
  // ==========================================================================
  // Events
  // ==========================================================================
  event ExamOrdered is  {
    examId: ExamId
    order: ImagingOrder
    orderedAt: TimeStamp
  } with {
    briefly "Imaging examination has been ordered"
    described as {
      | Records the creation of a new imaging order, capturing all
      | clinical context and priority information.
    }
  }
  event ExamScheduled is  {
    examId: ExamId
    scheduledDateTime: TimeStamp
    modalityId: ModalityId
    roomLocation: String
    protocol: ExamProtocol
    scheduledBy: String
  } with {
    briefly "Examination has been scheduled"
    described as {
      | Records the appointment details including time, location,
      | and selected imaging protocol.
    }
  }
  event PatientCheckedIn is  {
    examId: ExamId
    checkedInAt: TimeStamp
    screeningCompleted: Boolean
  } with {
    briefly "Patient has checked in for examination"
    described as {
      | Records patient arrival and completion of safety screening
      | procedures.
    }
  }
  event AcquisitionStarted is  {
    examId: ExamId
    technicianId: TechnicianId
    modalityId: ModalityId
    startedAt: TimeStamp
  } with {
    briefly "Image acquisition has begun"
    described as {
      |Records the start of the imaging procedure.
    }
  }
  event AcquisitionCompleted is  {
    examId: ExamId
    studyInfo: StudyInfo
    completedAt: TimeStamp
    technicianNotes: String?
  } with {
    briefly "Image acquisition has completed"
    described as {
      | Records successful completion of imaging with all DICOM
      | study metadata.
    }
  }
  event DraftReportCreated is  {
    examId: ExamId
    reportId: ReportId
    radiologistId: PhysicianId
    findings: String
    impression: String
    recommendations: String?
    createdAt: TimeStamp
  } with {
    briefly "Draft radiology report has been created"
    described as {
      | Records the preliminary interpretation awaiting final
      | signature.
    }
  }
  event ReportFinalized is  {
    examId: ExamId
    reportId: ReportId
    radiologistId: PhysicianId
    signedAt: TimeStamp
  } with {
    briefly "Radiology report has been finalized"
    described as {
      | Records the electronic signature and finalization of the
      | radiology report.
    }
  }
  event AddendumAdded is  {
    examId: ExamId
    reportId: ReportId
    radiologistId: PhysicianId
    addendumText: String
    addendumReason: String
    addedAt: TimeStamp
  } with {
    briefly "Addendum has been added to report"
    described as {
      | Records the addition of supplementary information to a
      | finalized report.
    }
  }
  event CriticalFindingReported is  {
    examId: ExamId
    finding: CriticalFinding
    reportedAt: TimeStamp
  } with {
    briefly "Critical finding has been reported"
    described as {
      | Records identification of a critical finding requiring
      | immediate physician notification.
    }
  }
  // ==========================================================================
  // State Data Types
  // ==========================================================================
  record OrderedStateData is  {
    examId: ExamId
    order: ImagingOrder
    orderedAt: TimeStamp
  } with {
    briefly "Data for ordered state"
    described as {
      |Contains the original imaging order information.
    }
  }
  record ScheduledStateData is  {
    examId: ExamId
    order: ImagingOrder
    scheduledDateTime: TimeStamp
    modalityId: ModalityId
    roomLocation: String
    protocol: ExamProtocol
  } with {
    briefly "Data for scheduled state"
    described as {
      |Contains order and scheduling information.
    }
  }
  record AcquisitionStateData is  {
    examId: ExamId
    order: ImagingOrder
    scheduledDateTime: TimeStamp
    modalityId: ModalityId
    checkedInAt: TimeStamp
    technicianId: TechnicianId?
    acquisitionStartedAt: TimeStamp?
  } with {
    briefly "Data for acquisition state"
    described as {
      |Contains order, schedule, and acquisition progress information.
    }
  }
  record InterpretationStateData is  {
    examId: ExamId
    order: ImagingOrder
    studyInfo: StudyInfo
    completedAt: TimeStamp
    draftReport: RadiologyReport?
  } with {
    briefly "Data for interpretation state"
    described as {
      |Contains study information awaiting interpretation.
    }
  }
  record FinalizedStateData is  {
    examId: ExamId
    order: ImagingOrder
    studyInfo: StudyInfo
    report: RadiologyReport
    finalizedAt: TimeStamp
    addendums: RadiologyReport*
  } with {
    briefly "Data for finalized state"
    described as {
      |Contains complete exam record with finalized report.
    }
  }
  // ==========================================================================
  // States
  // ==========================================================================
  initial state OrderedState of record ImagingExam.OrderedStateData is {
    initial handler OrderedStateInitHandler is {
      on query GetImagingExam is {
        let imagingExamResult: type ImagingExamResult = prompt("read the imaging exam from the store")
        tell imagingExamResult to entity RadiologyContext.ImagingExam
      }
      on init is {
        let examOrdered: type ExamOrdered = prompt("the exam ordered that brings this imaging exam into existence")
        yield examOrdered
      }
    } with {
      briefly "OrderedState init handler"
      described as {
        |Initializes the OrderedState state.
      }
    }
  } with {
    briefly "OrderedState state"
    described as {
      |The OrderedState state of the ImagingExam.
    }
  }
  state ScheduledState of record ImagingExam.ScheduledStateData is {
    initial handler ScheduledStateInitHandler is {
      on init is {
        let examScheduled: type ExamScheduled = prompt("the exam scheduled that brings this imaging exam into existence")
        yield examScheduled
      }
    } with {
      briefly "ScheduledState init handler"
      described as {
        |Initializes the ScheduledState state.
      }
    }
  } with {
    briefly "ScheduledState state"
    described as {
      |The ScheduledState state of the ImagingExam.
    }
  }
  state AcquisitionState of record ImagingExam.AcquisitionStateData is {
    initial handler AcquisitionStateInitHandler is {
      on init is {
        let patientCheckedIn: type PatientCheckedIn = prompt("the patient checked in that brings this imaging exam into existence")
        yield patientCheckedIn
      }
    } with {
      briefly "AcquisitionState init handler"
      described as {
        |Initializes the AcquisitionState state.
      }
    }
  } with {
    briefly "AcquisitionState state"
    described as {
      |The AcquisitionState state of the ImagingExam.
    }
  }
  state InterpretationState of record ImagingExam.InterpretationStateData is {
    initial handler InterpretationStateInitHandler is {
      on init is {
        let acquisitionCompleted: type AcquisitionCompleted = prompt("the acquisition completed that brings this imaging exam into existence")
        yield acquisitionCompleted
      }
    } with {
      briefly "InterpretationState init handler"
      described as {
        |Initializes the InterpretationState state.
      }
    }
  } with {
    briefly "InterpretationState state"
    described as {
      |The InterpretationState state of the ImagingExam.
    }
  }
  state FinalizedState of record ImagingExam.FinalizedStateData is {
    initial handler FinalizedStateInitHandler is {
      on init is {
        let reportFinalized: type ReportFinalized = prompt("the report finalized that brings this imaging exam into existence")
        yield reportFinalized
      }
    } with {
      briefly "FinalizedState init handler"
      described as {
        |Initializes the FinalizedState state.
      }
    }
  } with {
    briefly "FinalizedState state"
    described as {
      |The FinalizedState state of the ImagingExam.
    }
  }
  // ==========================================================================
  // Handler
  // ==========================================================================
  handler ImagingExamHandler is {
    on orderExam: command OrderExam is {
      yield event ExamOrdered(examId = orderExam.examId)
    }
    on scheduleExam: command ScheduleExam is {
      yield event ExamScheduled(examId = scheduleExam.examId, scheduledDateTime = scheduleExam.scheduledDateTime, modalityId = scheduleExam.modalityId, roomLocation = scheduleExam.roomLocation, protocol = scheduleExam.protocol)
    }
    on checkInPatient: command CheckInPatient is {
      yield event PatientCheckedIn(examId = checkInPatient.examId, checkedInAt = checkInPatient.checkedInAt, screeningCompleted = checkInPatient.screeningCompleted)
    }
    on startAcquisition: command StartAcquisition is {
      yield event AcquisitionStarted(examId = startAcquisition.examId, technicianId = startAcquisition.technicianId, modalityId = startAcquisition.modalityId, startedAt = startAcquisition.startedAt)
      do "Begin image acquisition"
    }
    on completeAcquisition: command CompleteAcquisition is {
      yield event AcquisitionCompleted(examId = completeAcquisition.examId, studyInfo = completeAcquisition.studyInfo, completedAt = completeAcquisition.completedAt, technicianNotes = completeAcquisition.technicianNotes)
    }
    on createDraftReport: command CreateDraftReport is {
      yield event DraftReportCreated(examId = createDraftReport.examId, radiologistId = createDraftReport.radiologistId, findings = createDraftReport.findings, impression = createDraftReport.impression, recommendations = createDraftReport.recommendations)
      do "Draft report created, awaiting signature"
    }
    on finalizeReport: command FinalizeReport is {
      yield event ReportFinalized(examId = finalizeReport.examId, reportId = finalizeReport.reportId, radiologistId = finalizeReport.radiologistId, signedAt = finalizeReport.signedAt)
    }
    on addAddendum: command AddAddendum is {
      yield event AddendumAdded(examId = addAddendum.examId, reportId = addAddendum.reportId, radiologistId = addAddendum.radiologistId, addendumText = addAddendum.addendumText, addendumReason = addAddendum.addendumReason)
      do "Addendum added to finalized report"
    }
    on reportCriticalFinding: command ReportCriticalFinding is {
      yield event CriticalFindingReported(examId = reportCriticalFinding.examId, finding = reportCriticalFinding.finding)
      do "Critical finding communication initiated"
    }
    on other is {
      error "Unknown command received"
    }
    on examOrdered: event ExamOrdered is {
      morph entity ImagingExam to state ImagingExam.OrderedState with record ImagingExam.OrderedStateData(examId = examOrdered.examId, order = examOrdered.order, orderedAt = examOrdered.orderedAt)
      set state OrderedState to "initialize from prior event"
    }
    on examScheduled: event ExamScheduled is {
      morph entity ImagingExam to state ImagingExam.ScheduledState with record ImagingExam.ScheduledStateData(examId = examScheduled.examId, scheduledDateTime = examScheduled.scheduledDateTime, modalityId = examScheduled.modalityId, roomLocation = examScheduled.roomLocation, protocol = examScheduled.protocol)
      set state ScheduledState to "initialize from prior event"
    }
    on patientCheckedIn: event PatientCheckedIn is {
      morph entity ImagingExam to state ImagingExam.AcquisitionState with record ImagingExam.AcquisitionStateData(examId = patientCheckedIn.examId, checkedInAt = patientCheckedIn.checkedInAt)
      set state AcquisitionState to "initialize from prior event"
    }
    on event AcquisitionStarted is {
      do "apply AcquisitionStarted to the current state"
    }
    on acquisitionCompleted: event AcquisitionCompleted is {
      morph entity ImagingExam to state ImagingExam.InterpretationState with record ImagingExam.InterpretationStateData(examId = acquisitionCompleted.examId, studyInfo = acquisitionCompleted.studyInfo, completedAt = acquisitionCompleted.completedAt)
      set state InterpretationState to "initialize from prior event"
    }
    on event DraftReportCreated is {
      do "apply DraftReportCreated to the current state"
    }
    on reportFinalized: event ReportFinalized is {
      morph entity ImagingExam to state ImagingExam.FinalizedState with record ImagingExam.FinalizedStateData(examId = reportFinalized.examId)
      set state FinalizedState to "initialize from prior event"
    }
    on event AddendumAdded is {
      do "apply AddendumAdded to the current state"
    }
    on event CriticalFindingReported is {
      do "apply CriticalFindingReported to the current state"
    }
  } with {
    briefly "Main command handler for imaging exams"
    described as {
      | Processes all commands for the ImagingExam entity, managing
      | state transitions and emitting events for each workflow step.
    }
  }
} with {
  briefly "Imaging examination aggregate"
  described as {
    | The ImagingExam entity manages the complete lifecycle of a radiology
    | examination from initial order through final report. It coordinates
    | scheduling, patient workflow, image acquisition, and interpretation
    | while ensuring proper state transitions and audit trail.
  }
}
