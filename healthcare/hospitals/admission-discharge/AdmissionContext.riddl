// Hospital Admission/Discharge - Admission Context
context AdmissionContext as router is {
  inlet AdmissionCommandStreamIn is type AdmissionCommand  outlet AdmissionCommandStreamOut is type AdmissionCommand
  inlet AdmissionResultStreamIn is type Admission.AdmissionResult  outlet AdmissionResultStreamOut is type Admission.AdmissionResult
  handler AdmissionContextBoundary is {
    on createAdmission: command Admission.CreateAdmission is {
      send createAdmission to outlet AdmissionContext.AdmissionCommandStreamOut
    }
    on assignBed: command Admission.AssignBed is {
      send assignBed to outlet AdmissionContext.AdmissionCommandStreamOut
    }
    on requestTransfer: command Admission.RequestTransfer is {
      send requestTransfer to outlet AdmissionContext.AdmissionCommandStreamOut
    }
    on transferPatient: command Admission.TransferPatient is {
      send transferPatient to outlet AdmissionContext.AdmissionCommandStreamOut
    }
    on updateCondition: command Admission.UpdateCondition is {
      send updateCondition to outlet AdmissionContext.AdmissionCommandStreamOut
    }
    on initiateDischarge: command Admission.InitiateDischarge is {
      send initiateDischarge to outlet AdmissionContext.AdmissionCommandStreamOut
    }
    on completeDischarge: command Admission.CompleteDischarge is {
      send completeDischarge to outlet AdmissionContext.AdmissionCommandStreamOut
    }
    on admissionResult: result Admission.AdmissionResult is {
      send admissionResult to outlet AdmissionContext.AdmissionResultStreamOut
    }
    on other is {
      error "Unexpected message at the AdmissionContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AdmissionCommand Stream Intake' is from outlet AdmissionContext.AdmissionCommandStreamOut to inlet AdmissionContext.Admission.AdmissionCommands  connector 'AdmissionResult Stream Egress' is from outlet AdmissionContext.AdmissionRepository.AdmissionRepositoryResponses to inlet AdmissionContext.AdmissionResultStreamIn  adaptor FromBedManagementService from context BedManagementService is { 
    handler FromBedManagementServiceHandler is {
      on result BedManagementService.AvailableBedList is {
        do "the model receives available bed list"
      }
      on event BedManagementService.BedReserved is {
        do "the model receives bed reserved"
      }
      on event BedManagementService.HousekeepingComplete is {
        do "the model receives housekeeping complete"
      }
      on other is {
        error "Unexpected message for adaptor FromBedManagementService"
      }
    } with {
      briefly "from bed management service"
      described as {
        |Carries messages from the external BedManagementService.
      }
    }
  } with {
    briefly "BedManagementService integration"
    described as {
      |The model's side of the BedManagementService conversation.
    }
  }
  adaptor ToBedManagementService to context BedManagementService is { 
    handler ToBedManagementServiceHandler is {
      on query BedManagementService.GetAvailableBeds is {
        do "the model sends get available beds"
      }
      on command BedManagementService.RequestHousekeeping is {
        do "the model sends request housekeeping"
      }
      on command BedManagementService.ReserveBed is {
        do "the model sends reserve bed"
      }
      on other is {
        error "Unexpected message for adaptor ToBedManagementService"
      }
    } with {
      briefly "to bed management service"
      described as {
        |Carries messages to the external BedManagementService.
      }
    }
  } with {
    briefly "BedManagementService integration"
    described as {
      |The model's side of the BedManagementService conversation.
    }
  }
  adaptor FromBillingService from context BillingService is { 
    handler FromBillingServiceHandler is {
      on event BillingService.BillingSubmitted is {
        do "the model receives billing submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService is { 
    handler ToBillingServiceHandler is {
      on command BillingService.SubmitAdmissionForBilling is {
        do "the model sends submit admission for billing"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromClinicalService from context ClinicalService is { 
    handler FromClinicalServiceHandler is {
      on event ClinicalService.AdmissionOrdersCreated is {
        do "the model receives admission orders created"
      }
      on event ClinicalService.ClinicalNoteDocumented is {
        do "the model receives clinical note documented"
      }
      on event ClinicalService.DischargeOrdersCreated is {
        do "the model receives discharge orders created"
      }
      on other is {
        error "Unexpected message for adaptor FromClinicalService"
      }
    } with {
      briefly "from clinical service"
      described as {
        |Carries messages from the external ClinicalService.
      }
    }
  } with {
    briefly "ClinicalService integration"
    described as {
      |The model's side of the ClinicalService conversation.
    }
  }
  adaptor ToClinicalService to context ClinicalService is { 
    handler ToClinicalServiceHandler is {
      on command ClinicalService.CreateAdmissionOrders is {
        do "the model sends create admission orders"
      }
      on command ClinicalService.CreateDischargeOrders is {
        do "the model sends create discharge orders"
      }
      on command ClinicalService.DocumentClinicalNote is {
        do "the model sends document clinical note"
      }
      on other is {
        error "Unexpected message for adaptor ToClinicalService"
      }
    } with {
      briefly "to clinical service"
      described as {
        |Carries messages to the external ClinicalService.
      }
    }
  } with {
    briefly "ClinicalService integration"
    described as {
      |The model's side of the ClinicalService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.NotifyCaseManagement is {
        do "the model sends notify case management"
      }
      on command NotificationService.NotifyNurseStation is {
        do "the model sends notify nurse station"
      }
      on command NotificationService.NotifyPhysician is {
        do "the model sends notify physician"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPatientRegistration from context PatientRegistration is { 
    handler FromPatientRegistrationHandler is {
      on result PatientRegistration.InsuranceInfo is {
        do "the model receives insurance info"
      }
      on event PatientRegistration.InsuranceVerified is {
        do "the model receives insurance verified"
      }
      on result PatientRegistration.PatientDemographics is {
        do "the model receives patient demographics"
      }
      on other is {
        error "Unexpected message for adaptor FromPatientRegistration"
      }
    } with {
      briefly "from patient registration"
      described as {
        |Carries messages from the external PatientRegistration.
      }
    }
  } with {
    briefly "PatientRegistration integration"
    described as {
      |The model's side of the PatientRegistration conversation.
    }
  }
  adaptor ToPatientRegistration to context PatientRegistration is { 
    handler ToPatientRegistrationHandler is {
      on query PatientRegistration.GetInsuranceInfo is {
        do "the model sends get insurance info"
      }
      on query PatientRegistration.GetPatientDemographics is {
        do "the model sends get patient demographics"
      }
      on command PatientRegistration.VerifyInsurance is {
        do "the model sends verify insurance"
      }
      on other is {
        error "Unexpected message for adaptor ToPatientRegistration"
      }
    } with {
      briefly "to patient registration"
      described as {
        |Carries messages to the external PatientRegistration.
      }
    }
  } with {
    briefly "PatientRegistration integration"
    described as {
      |The model's side of the PatientRegistration conversation.
    }
  }
  include "types.riddl"
  include "Admission.riddl"
  // Repository for admission persistence
  type AdmissionRepositoryCommand is one of {
    AdmissionContext.AdmissionRepository.PersistAdmissionCreated or AdmissionContext.AdmissionRepository.PersistBedAssigned or AdmissionContext.AdmissionRepository.PersistConditionUpdated or AdmissionContext.AdmissionRepository.PersistDischargeCompleted or AdmissionContext.AdmissionRepository.PersistDischargeInitiated or AdmissionContext.AdmissionRepository.PersistPatientTransferred or AdmissionContext.AdmissionRepository.PersistTransferRequested
  } with {
    briefly "Anything that writes AdmissionRepository"
    described as {
      |The persistence commands AdmissionRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository AdmissionRepository as flow is {
    inlet AdmissionRepositoryFromBedOccupancyProjector is type AdmissionRepositoryCommand
    command PersistConditionUpdated is  {
      admissionId: AdmissionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ConditionUpdated applies to.
        }
      }
    } with {
      briefly "Persist ConditionUpdated"
      described as {
        |Instructs this repository to apply ConditionUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDischargeInitiated is  {
      admissionId: AdmissionId with {
        briefly "Row addressed"
        described as {
          |Which stored row DischargeInitiated applies to.
        }
      }
    } with {
      briefly "Persist DischargeInitiated"
      described as {
        |Instructs this repository to apply DischargeInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransferRequested is  {
      admissionId: AdmissionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransferRequested applies to.
        }
      }
    } with {
      briefly "Persist TransferRequested"
      described as {
        |Instructs this repository to apply TransferRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAdmissionCreated is  {
      admissionId: AdmissionId with {
        briefly "Row addressed"
        described as {
          |Which stored row AdmissionCreated applies to.
        }
      }
    } with {
      briefly "Persist AdmissionCreated"
      described as {
        |Instructs this repository to apply AdmissionCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBedAssigned is  {
      admissionId: AdmissionId with {
        briefly "Row addressed"
        described as {
          |Which stored row BedAssigned applies to.
        }
      }
    } with {
      briefly "Persist BedAssigned"
      described as {
        |Instructs this repository to apply BedAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDischargeCompleted is  {
      admissionId: AdmissionId with {
        briefly "Row addressed"
        described as {
          |Which stored row DischargeCompleted applies to.
        }
      }
    } with {
      briefly "Persist DischargeCompleted"
      described as {
        |Instructs this repository to apply DischargeCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPatientTransferred is  {
      admissionId: AdmissionId with {
        briefly "Row addressed"
        described as {
          |Which stored row PatientTransferred applies to.
        }
      }
    } with {
      briefly "Persist PatientTransferred"
      described as {
        |Instructs this repository to apply PatientTransferred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet AdmissionRepositoryResponses is type Admission.AdmissionResult
    record StoredAdmission is  {
      admissionId: AdmissionId with {
        briefly "admissionId"
        described as {
          |The admissionId column of the stored admission row.
        }
      }
      patientId: PatientId with {
        briefly "patientId"
        described as {
          |The patientId column of the stored admission row.
        }
      }
    } with {
      briefly "Stored admission row"
      described as {
        |The persistence shape of admission data as this repository stores it.
      }
    }
    schema AdmissionData is relational
      of admissions as type StoredAdmission
        index on field StoredAdmission.admissionId
        index on field StoredAdmission.patientId
 with {
      briefly "Admission data schema"
      described as {
        |The relational schema holding admission data for the AdmissionRepository.
      }
    }
    handler AdmissionPersistence is {
      on persistConditionUpdated: command PersistConditionUpdated is {
        do "apply ConditionUpdated to the stored row"
      }
      on persistDischargeInitiated: command PersistDischargeInitiated is {
        do "apply DischargeInitiated to the stored row"
      }
      on persistTransferRequested: command PersistTransferRequested is {
        do "apply TransferRequested to the stored row"
      }
      on persistAdmissionCreated: command PersistAdmissionCreated is {
        do "apply AdmissionCreated to the stored row"
      }
      on persistBedAssigned: command PersistBedAssigned is {
        do "apply BedAssigned to the stored row"
      }
      on persistDischargeCompleted: command PersistDischargeCompleted is {
        do "apply DischargeCompleted to the stored row"
      }
      on persistPatientTransferred: command PersistPatientTransferred is {
        do "apply PatientTransferred to the stored row"
      }
      on query GetOccupancyStats is {
        let occupancyStatsView: type OccupancyStatsView = prompt("read the occupancy stats projection")
        reply occupancyStatsView
      }
      on query GetLOSStats is {
        let lOSStatsView: type LOSStatsView = prompt("read the los stats projection")
        reply lOSStatsView
      }
      on query GetThroughputStats is {
        let throughputStatsView: type ThroughputStatsView = prompt("read the throughput stats projection")
        reply throughputStatsView
      }
    } with {
      briefly "Persists admission commands"
      described as {
        |Handles command-driven persistence for admissions.
      }
    }
  } with {
    briefly "Admission data persistence"
    described as {
      | The AdmissionRepository provides persistent storage for
      | admission records, bed assignments, and transfers.
    }
  }
  // Repository for bed census
  repository BedCensusRepository as sink is {
    schema BedCensusData is relational
      of beds as type BedAssignment
        index on field BedAssignment.bedId
        index on field BedAssignment.unitId
 with {
      briefly "Bed census data schema"
      described as {
        |The relational schema holding bed census data for the BedCensusRepository.
      }
    }
    handler BedCensusPersistence is {
    } with {
      briefly "Maintains bed census"
      described as {
        |Tracks real-time bed occupancy status.
      }
    }
  } with {
    briefly "Bed census persistence"
    described as {
      | The BedCensusRepository tracks current bed occupancy
      | and availability across all hospital units.
    }
  }
  // Projector for bed occupancy metrics
  query GetOccupancyStats replies result OccupancyStatsView is  {
    occupancyStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which occupancy stats to retrieve.
      }
    }
  } with {
    briefly "Get occupancy stats"
    described as {
      |Retrieves the occupancy stats projection.
    }
  }
  result OccupancyStatsView is  {
    occupancyStats: BedOccupancyProjector.OccupancyStats with {
      briefly "Occupancy stats"
      described as {
        |The occupancy stats being returned.
      }
    }
  } with {
    briefly "Occupancy stats view"
    described as {
      |Read model view carrying the occupancy stats projection.
    }
  }
  projector BedOccupancyProjector as flow is {
    outlet BedOccupancyProjectorToRepository is type AdmissionRepositoryCommand
    updates repository AdmissionContext.AdmissionRepository
    inlet BedOccupancyProjectorFromAdmission is type AdmissionEvent
    record OccupancyStats is  {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Hospital unit.
        }
      }
      unitName: String(1,100) with {
        briefly "Name"
        described as {
          |Unit name.
        }
      }
      totalBeds: Natural with {
        briefly "Total"
        described as {
          |Total beds in unit.
        }
      }
      occupiedBeds: Natural with {
        briefly "Occupied"
        described as {
          |Currently occupied.
        }
      }
      availableBeds: Natural with {
        briefly "Available"
        described as {
          |Available for assignment.
        }
      }
      pendingClean: Natural with {
        briefly "Pending clean"
        described as {
          |Awaiting housekeeping.
        }
      }
      occupancyRate: Decimal(5,4) with {
        briefly "Rate"
        described as {
          |Occupancy percentage.
        }
      }
      asOfTime: TimeStamp with {
        briefly "As of"
        described as {
          |Snapshot time.
        }
      }
    } with {
      briefly "Occupancy statistics"
      described as {
        |Real-time bed occupancy metrics by unit.
      }
    }
    handler OccupancyHandler is {
      on admissionCreated: event Admission.AdmissionCreated is {
        tell command AdmissionContext.AdmissionRepository.PersistAdmissionCreated(admissionId = admissionCreated.admissionId) to repository AdmissionContext.AdmissionRepository
        do "apply AdmissionCreated to the BedOccupancyProjector projection"
      }
      on conditionUpdated: event Admission.ConditionUpdated is {
        tell command AdmissionContext.AdmissionRepository.PersistConditionUpdated(admissionId = conditionUpdated.admissionId) to repository AdmissionContext.AdmissionRepository
        do "apply ConditionUpdated to the BedOccupancyProjector projection"
      }
      on dischargeInitiated: event Admission.DischargeInitiated is {
        tell command AdmissionContext.AdmissionRepository.PersistDischargeInitiated(admissionId = dischargeInitiated.admissionId) to repository AdmissionContext.AdmissionRepository
        do "apply DischargeInitiated to the BedOccupancyProjector projection"
      }
      on transferRequested: event Admission.TransferRequested is {
        tell command AdmissionContext.AdmissionRepository.PersistTransferRequested(admissionId = transferRequested.admissionId) to repository AdmissionContext.AdmissionRepository
        do "apply TransferRequested to the BedOccupancyProjector projection"
      }
      on bedAssigned: event Admission.BedAssigned is {
        tell command AdmissionContext.AdmissionRepository.PersistBedAssigned(admissionId = bedAssigned.admissionId) to repository AdmissionContext.AdmissionRepository
      }
      on patientTransferred: event Admission.PatientTransferred is {
        tell command AdmissionContext.AdmissionRepository.PersistPatientTransferred(admissionId = patientTransferred.admissionId) to repository AdmissionContext.AdmissionRepository
      }
      on dischargeCompleted: event Admission.DischargeCompleted is {
        tell command AdmissionContext.AdmissionRepository.PersistDischargeCompleted(admissionId = dischargeCompleted.admissionId) to repository AdmissionContext.AdmissionRepository
      }
    } with {
      briefly "Maintains occupancy metrics"
      described as {
        |Projects bed events into occupancy statistics.
      }
    }
  } with {
    briefly "Bed occupancy projections"
    described as {
      |Maintains real-time bed occupancy analytics.
    }
  }
  // Projector for length of stay analytics
  query GetLOSStats replies result LOSStatsView is  {
    lOSStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which los stats to retrieve.
      }
    }
  } with {
    briefly "Get los stats"
    described as {
      |Retrieves the los stats projection.
    }
  }
  result LOSStatsView is  {
    lOSStats: LengthOfStayProjector.LOSStats with {
      briefly "Los stats"
      described as {
        |The los stats being returned.
      }
    }
  } with {
    briefly "Los stats view"
    described as {
      |Read model view carrying the los stats projection.
    }
  }
  projector LengthOfStayProjector as sink is {
    updates repository AdmissionContext.AdmissionRepository
    inlet LengthOfStayProjectorFromAdmission is type AdmissionEvent
    record LOSStats is  {
      filterUnitId: UnitId? with {
        briefly "Unit"
        described as {
          |Hospital unit filter.
        }
      }
      filterAdmissionType: AdmissionType? with {
        briefly "Type"
        described as {
          |Admission type filter.
        }
      }
      averageLOS: Decimal(6,2) with {
        briefly "Avg LOS"
        described as {
          |Average length of stay in days.
        }
      }
      medianLOS: Decimal(6,2) with {
        briefly "Median LOS"
        described as {
          |Median length of stay.
        }
      }
      minLOS: Natural with {
        briefly "Min"
        described as {
          |Shortest stay.
        }
      }
      maxLOS: Natural with {
        briefly "Max"
        described as {
          |Longest stay.
        }
      }
      totalDischarges: Natural with {
        briefly "Discharges"
        described as {
          |Total discharges in period.
        }
      }
      periodStart: Date with {
        briefly "Start"
        described as {
          |Period start date.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Period end date.
        }
      }
    } with {
      briefly "Length of stay statistics"
      described as {
        |Aggregated length of stay metrics.
      }
    }
    handler LOSHandler is {
      on admissionCreated: event Admission.AdmissionCreated is {
        tell command AdmissionContext.AdmissionRepository.PersistAdmissionCreated(admissionId = admissionCreated.admissionId) to repository AdmissionContext.AdmissionRepository
        do "apply AdmissionCreated to the LengthOfStayProjector projection"
      }
      on bedAssigned: event Admission.BedAssigned is {
        tell command AdmissionContext.AdmissionRepository.PersistBedAssigned(admissionId = bedAssigned.admissionId) to repository AdmissionContext.AdmissionRepository
        do "apply BedAssigned to the LengthOfStayProjector projection"
      }
      on conditionUpdated: event Admission.ConditionUpdated is {
        tell command AdmissionContext.AdmissionRepository.PersistConditionUpdated(admissionId = conditionUpdated.admissionId) to repository AdmissionContext.AdmissionRepository
        do "apply ConditionUpdated to the LengthOfStayProjector projection"
      }
      on dischargeInitiated: event Admission.DischargeInitiated is {
        tell command AdmissionContext.AdmissionRepository.PersistDischargeInitiated(admissionId = dischargeInitiated.admissionId) to repository AdmissionContext.AdmissionRepository
        do "apply DischargeInitiated to the LengthOfStayProjector projection"
      }
      on patientTransferred: event Admission.PatientTransferred is {
        tell command AdmissionContext.AdmissionRepository.PersistPatientTransferred(admissionId = patientTransferred.admissionId) to repository AdmissionContext.AdmissionRepository
        do "apply PatientTransferred to the LengthOfStayProjector projection"
      }
      on transferRequested: event Admission.TransferRequested is {
        tell command AdmissionContext.AdmissionRepository.PersistTransferRequested(admissionId = transferRequested.admissionId) to repository AdmissionContext.AdmissionRepository
        do "apply TransferRequested to the LengthOfStayProjector projection"
      }
      on dischargeCompleted: event Admission.DischargeCompleted is {
        tell command AdmissionContext.AdmissionRepository.PersistDischargeCompleted(admissionId = dischargeCompleted.admissionId) to repository AdmissionContext.AdmissionRepository
      }
    } with {
      briefly "Maintains LOS analytics"
      described as {
        |Projects discharge events into LOS metrics.
      }
    }
  } with {
    briefly "Length of stay projections"
    described as {
      |Maintains length of stay analytics for quality reporting.
    }
  }
  // Projector for throughput metrics
  query GetThroughputStats replies result ThroughputStatsView is  {
    throughputStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which throughput stats to retrieve.
      }
    }
  } with {
    briefly "Get throughput stats"
    described as {
      |Retrieves the throughput stats projection.
    }
  }
  result ThroughputStatsView is  {
    throughputStats: ThroughputProjector.ThroughputStats with {
      briefly "Throughput stats"
      described as {
        |The throughput stats being returned.
      }
    }
  } with {
    briefly "Throughput stats view"
    described as {
      |Read model view carrying the throughput stats projection.
    }
  }
  projector ThroughputProjector as sink is {
    updates repository AdmissionContext.AdmissionRepository
    inlet ThroughputProjectorFromAdmission is type AdmissionEvent
    record ThroughputStats is  {
      periodDate: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      admissions: Natural with {
        briefly "Admissions"
        described as {
          |New admissions.
        }
      }
      discharges: Natural with {
        briefly "Discharges"
        described as {
          |Total discharges.
        }
      }
      transfers: Natural with {
        briefly "Transfers"
        described as {
          |Inter-unit transfers.
        }
      }
      emergencyAdmits: Natural with {
        briefly "Emergency"
        described as {
          |Emergency admissions.
        }
      }
      electiveAdmits: Natural with {
        briefly "Elective"
        described as {
          |Elective admissions.
        }
      }
      averageTimeToAssignment: Duration with {
        briefly "Time to bed"
        described as {
          |Average time to bed assignment.
        }
      }
      averageDischargeTime: Duration with {
        briefly "Discharge time"
        described as {
          |Average discharge processing time.
        }
      }
    } with {
      briefly "Throughput statistics"
      described as {
        |Daily patient flow metrics.
      }
    }
    handler ThroughputHandler is {
      on conditionUpdated: event Admission.ConditionUpdated is {
        tell command AdmissionContext.AdmissionRepository.PersistConditionUpdated(admissionId = conditionUpdated.admissionId) to repository AdmissionContext.AdmissionRepository
        do "apply ConditionUpdated to the ThroughputProjector projection"
      }
      on dischargeInitiated: event Admission.DischargeInitiated is {
        tell command AdmissionContext.AdmissionRepository.PersistDischargeInitiated(admissionId = dischargeInitiated.admissionId) to repository AdmissionContext.AdmissionRepository
        do "apply DischargeInitiated to the ThroughputProjector projection"
      }
      on transferRequested: event Admission.TransferRequested is {
        tell command AdmissionContext.AdmissionRepository.PersistTransferRequested(admissionId = transferRequested.admissionId) to repository AdmissionContext.AdmissionRepository
        do "apply TransferRequested to the ThroughputProjector projection"
      }
      on admissionCreated: event Admission.AdmissionCreated is {
        tell command AdmissionContext.AdmissionRepository.PersistAdmissionCreated(admissionId = admissionCreated.admissionId) to repository AdmissionContext.AdmissionRepository
      }
      on bedAssigned: event Admission.BedAssigned is {
        tell command AdmissionContext.AdmissionRepository.PersistBedAssigned(admissionId = bedAssigned.admissionId) to repository AdmissionContext.AdmissionRepository
      }
      on patientTransferred: event Admission.PatientTransferred is {
        tell command AdmissionContext.AdmissionRepository.PersistPatientTransferred(admissionId = patientTransferred.admissionId) to repository AdmissionContext.AdmissionRepository
      }
      on dischargeCompleted: event Admission.DischargeCompleted is {
        tell command AdmissionContext.AdmissionRepository.PersistDischargeCompleted(admissionId = dischargeCompleted.admissionId) to repository AdmissionContext.AdmissionRepository
      }
    } with {
      briefly "Maintains throughput metrics"
      described as {
        |Projects events into throughput analytics.
      }
    }
  } with {
    briefly "Throughput projections"
    described as {
      |Maintains daily patient flow and throughput metrics.
    }
  }
  type AdmissionEvent is one of {
    AdmissionContext.Admission.AdmissionCreated or AdmissionContext.Admission.BedAssigned or AdmissionContext.Admission.TransferRequested or AdmissionContext.Admission.PatientTransferred or AdmissionContext.Admission.ConditionUpdated or AdmissionContext.Admission.DischargeInitiated or AdmissionContext.Admission.DischargeCompleted
  } with {
    briefly "Admission events"
    described as {
      |Union of all admission entity events for streaming.
    }
  }
  processor AdmissionSource as source is {
    outlet AdmissionEvents is type AdmissionEvent
 with {
      briefly "Admission event outlet"
      described as {
        |Publishes admission events.
      }
    }
    handler AdmissionSourceHandler is {
      on init is {
        let initializeAdmission: type Admission.InitializeAdmission = prompt("the initialize admission that brings this this into existence")
        tell initializeAdmission to entity AdmissionContext.Admission
      }
      on admissionCreated: event Admission.AdmissionCreated is {
        send admissionCreated to outlet AdmissionEvents
      }
      on dischargeCompleted: event Admission.DischargeCompleted is {
        send dischargeCompleted to outlet AdmissionEvents
      }
      on other is {
        error "Unexpected message for source AdmissionSource"
      }
    } with {
      briefly "Admission source handler"
      described as {
        |Forwards admission events to the outlet.
      }
    }
  } with {
    briefly "Admission event source"
    described as {
      |Source streamlet that publishes admission events.
    }
  }
  processor AdmissionSink as sink is {
    inlet AdmissionEventsIn is type AdmissionEvent with {
      briefly "Admission event inlet"
      described as {
        |Receives admission events.
      }
    }
    handler AdmissionSinkHandler is {
      on init is { ??? }
      on admissionCreated: event Admission.AdmissionCreated is {
        tell admissionCreated to repository AdmissionContext.AdmissionRepository
      }
      on dischargeCompleted: event Admission.DischargeCompleted is {
        tell dischargeCompleted to repository AdmissionContext.AdmissionRepository
      }
      on other is {
        error "Unexpected message for sink AdmissionSink"
      }
    } with {
      briefly "Admission sink handler"
      described as {
        |Persists admission events from the inlet.
      }
    }
  } with {
    briefly "Admission event sink"
    described as {
      |Sink streamlet that consumes admission events.
    }
  }
  connector AdmissionFlow is from outlet AdmissionContext.AdmissionSource.AdmissionEvents to inlet AdmissionContext.AdmissionSink.AdmissionEventsIn with {
    briefly "Admission event flow"
    described as {
      |Connects admission source to sink for event streaming.
    }
  }
  processor AdmissionEventSplit as split is {
    inlet AdmissionEventSplitIn is type AdmissionEvent
    outlet AdmissionEventSplitToBedOccupancyProjector is type AdmissionEvent
    outlet AdmissionEventSplitToLengthOfStayProjector is type AdmissionEvent
    outlet AdmissionEventSplitToThroughputProjector is type AdmissionEvent

    handler AdmissionEventSplitHandler is {
      on admissionCreated: event Admission.AdmissionCreated is {
        send admissionCreated to outlet AdmissionEventSplitToBedOccupancyProjector
        send admissionCreated to outlet AdmissionEventSplitToLengthOfStayProjector
        send admissionCreated to outlet AdmissionEventSplitToThroughputProjector
        tell admissionCreated to entity AdmissionContext.Admission
      }
      on bedAssigned: event Admission.BedAssigned is {
        send bedAssigned to outlet AdmissionEventSplitToBedOccupancyProjector
        send bedAssigned to outlet AdmissionEventSplitToLengthOfStayProjector
        send bedAssigned to outlet AdmissionEventSplitToThroughputProjector
        tell bedAssigned to entity AdmissionContext.Admission
      }
      on transferRequested: event Admission.TransferRequested is {
        send transferRequested to outlet AdmissionEventSplitToBedOccupancyProjector
        send transferRequested to outlet AdmissionEventSplitToLengthOfStayProjector
        send transferRequested to outlet AdmissionEventSplitToThroughputProjector
        tell transferRequested to entity AdmissionContext.Admission
      }
      on patientTransferred: event Admission.PatientTransferred is {
        send patientTransferred to outlet AdmissionEventSplitToBedOccupancyProjector
        send patientTransferred to outlet AdmissionEventSplitToLengthOfStayProjector
        send patientTransferred to outlet AdmissionEventSplitToThroughputProjector
        tell patientTransferred to entity AdmissionContext.Admission
      }
      on conditionUpdated: event Admission.ConditionUpdated is {
        send conditionUpdated to outlet AdmissionEventSplitToBedOccupancyProjector
        send conditionUpdated to outlet AdmissionEventSplitToLengthOfStayProjector
        send conditionUpdated to outlet AdmissionEventSplitToThroughputProjector
        tell conditionUpdated to entity AdmissionContext.Admission
      }
      on dischargeInitiated: event Admission.DischargeInitiated is {
        send dischargeInitiated to outlet AdmissionEventSplitToBedOccupancyProjector
        send dischargeInitiated to outlet AdmissionEventSplitToLengthOfStayProjector
        send dischargeInitiated to outlet AdmissionEventSplitToThroughputProjector
        tell dischargeInitiated to entity AdmissionContext.Admission
      }
      on dischargeCompleted: event Admission.DischargeCompleted is {
        send dischargeCompleted to outlet AdmissionEventSplitToBedOccupancyProjector
        send dischargeCompleted to outlet AdmissionEventSplitToLengthOfStayProjector
        send dischargeCompleted to outlet AdmissionEventSplitToThroughputProjector
        tell dischargeCompleted to entity AdmissionContext.Admission
      }
      on other is {
        error "Unexpected message for processor AdmissionEventSplit"
      }
    } with {
      briefly "Admission event fan-out handler"
      described as {
        |Delivers each Admission event to all of its consumers.
      }
    }
  } with {
    briefly "Admission event fan-out"
    described as {
      |Fans Admission events out to the repository and projectors.
    }
  }
  connector 'AdmissionEvent Stream' is from outlet AdmissionContext.Admission.AdmissionEvents2 to inlet AdmissionContext.AdmissionEventSplit.AdmissionEventSplitIn with {
    briefly "Admission events, fanned out to storage and read models"
  }
  connector 'BedOccupancyProjector Feed' is from outlet AdmissionContext.AdmissionEventSplit.AdmissionEventSplitToBedOccupancyProjector to inlet AdmissionContext.BedOccupancyProjector.BedOccupancyProjectorFromAdmission with {
    briefly "Admission events feeding the BedOccupancyProjector projection"
  }
  connector 'LengthOfStayProjector Feed' is from outlet AdmissionContext.AdmissionEventSplit.AdmissionEventSplitToLengthOfStayProjector to inlet AdmissionContext.LengthOfStayProjector.LengthOfStayProjectorFromAdmission with {
    briefly "Admission events feeding the LengthOfStayProjector projection"
  }
  connector 'ThroughputProjector Feed' is from outlet AdmissionContext.AdmissionEventSplit.AdmissionEventSplitToThroughputProjector to inlet AdmissionContext.ThroughputProjector.ThroughputProjectorFromAdmission with {
    briefly "Admission events feeding the ThroughputProjector projection"
  }
  connector 'BedOccupancyProjector Storage' is from outlet AdmissionContext.BedOccupancyProjector.BedOccupancyProjectorToRepository to inlet AdmissionContext.AdmissionRepository.AdmissionRepositoryFromBedOccupancyProjector with {
    briefly "BedOccupancyProjector updates on their way to storage"
  }
} with {
  briefly "Bounded context for hospital admissions"
  described as {
    | The AdmissionContext is the bounded context for
    | patient admissions, bed management, and discharges.
  }
}
