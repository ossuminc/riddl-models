// Operating Room Management Domain Model
// Surgery scheduling, case management, and OR workflow
domain OperatingRoom is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ORScheduler is "staff member coordinating OR schedules" with {
    briefly "OR Scheduler"
    described as {
      | Staff responsible for scheduling surgical cases, coordinating
      | room assignments, and managing the surgical block schedule.
    }
  }
  user Surgeon is "physician performing surgical procedures" with {
    briefly "Surgeon"
    described as {
      | Physician responsible for performing surgical procedures,
      | submitting preference cards, and directing the surgical team.
    }
  }
  user Anesthesiologist is "physician providing anesthesia care" with {
    briefly "Anesthesiologist"
    described as {
      | Physician responsible for pre-operative assessment, anesthesia
      | administration, and patient monitoring during surgery.
    }
  }
  user ORNurse is "registered nurse in the operating room" with {
    briefly "OR Nurse"
    described as {
      | Circulating nurse responsible for patient advocacy, documentation,
      | supply management, and team coordination in the OR.
    }
  }
  user SurgicalTech is "surgical technologist assisting in procedures" with {
    briefly "Surgical Technologist"
    described as {
      | Technologist responsible for preparing the sterile field, passing
      | instruments, and maintaining sterile technique during surgery.
    }
  }
  epic SurgerySchedulingEpic is {
    user ORScheduler wants to "to efficiently schedule surgical cases" so that "OR utilization is maximized and surgeons have predictable schedules"
    case ScheduleSurgicalCase is {
      user Surgeon wants to "to schedule a surgical procedure" so that "the patient receives timely surgical care"
      step is "Surgeon submits" "surgical case request" "with procedure details" with {
        briefly "Submit request"
        described as {
          |Surgeon initiates case scheduling.
        }
      }
      step is "ORScheduler reviews" "case requirements" "for room and equipment" with {
        briefly "Review requirements"
        described as {
          |Assess resource needs.
        }
      }
      step take input OperatingRoomApp.OperatingRoomScreen.ScheduleCaseInput from user ORScheduler with {
        briefly "Schedule case"
        described as {
          |Create scheduled case record.
        }
      }
      step is "ORScheduler coordinates" "with anesthesia" "for coverage" with {
        briefly "Coordinate anesthesia"
        described as {
          |Ensure anesthesia availability.
        }
      }
      step take input OperatingRoomApp.OperatingRoomScreen.ConfirmCaseInput from user ORScheduler with {
        briefly "Confirm case"
        described as {
          |Finalize case confirmation.
        }
      }
    } with {
      briefly "Schedule surgical case workflow"
      described as {
        |Process for scheduling a new surgical procedure.
      }
    }
    case DayOfSurgeryCase is {
      user ORNurse wants to "to manage patient flow through surgery" so that "cases proceed safely and efficiently"
      step take input OperatingRoomApp.OperatingRoomScreen.StartPreOpInput from user ORNurse with {
        briefly "Start pre-op"
        described as {
          |Patient arrives in pre-op holding.
        }
      }
      step is "Anesthesiologist performs" "pre-operative assessment" "and consent" with {
        briefly "Pre-op assessment"
        described as {
          |Anesthesia evaluation.
        }
      }
      step take input OperatingRoomApp.OperatingRoomScreen.BringToORInput from user ORNurse with {
        briefly "Bring to OR"
        described as {
          |Transport patient to operating room.
        }
      }
      step is "SurgicalTech verifies" "sterile supplies" "and instruments" with {
        briefly "Verify supplies"
        described as {
          |Confirm equipment ready.
        }
      }
      step take input OperatingRoomApp.OperatingRoomScreen.StartSurgeryInput from user Surgeon with {
        briefly "Start surgery"
        described as {
          |Begin surgical procedure.
        }
      }
      step take input OperatingRoomApp.OperatingRoomScreen.CompleteSurgeryInput from user Surgeon with {
        briefly "Complete surgery"
        described as {
          |End surgical procedure.
        }
      }
      step take input OperatingRoomApp.OperatingRoomScreen.MoveToRecoveryInput from user ORNurse with {
        briefly "Move to PACU"
        described as {
          |Transport to recovery.
        }
      }
    } with {
      briefly "Day of surgery workflow"
      described as {
        |Patient flow from pre-op through surgery to recovery.
      }
    }
    case CaseManagementCase is {
      user ORScheduler wants to "to manage case changes and cancellations" so that "OR resources are reallocated appropriately"
      step is "ORScheduler receives" "cancellation request" "from surgeon or patient" with {
        briefly "Receive request"
        described as {
          |Cancellation is requested.
        }
      }
      step take input OperatingRoomApp.OperatingRoomScreen.CancelCaseInput from user ORScheduler with {
        briefly "Cancel case"
        described as {
          |Process case cancellation.
        }
      }
      step is "ORScheduler notifies" "affected staff" "of schedule change" with {
        briefly "Notify staff"
        described as {
          |Alert team members.
        }
      }
      step is "ORScheduler offers" "slot to waitlist" "for utilization" with {
        briefly "Offer slot"
        described as {
          |Fill vacant time slot.
        }
      }
    } with {
      briefly "Case management workflow"
      described as {
        |Process for handling schedule changes and cancellations.
      }
    }
    case RecoveryDischargeCase is {
      user ORNurse wants to "to manage PACU recovery and discharge" so that "patients safely transition from surgery"
      step is "PACU Nurse monitors" "patient recovery" "using Aldrete criteria" with {
        briefly "Monitor recovery"
        described as {
          |Assess readiness for discharge.
        }
      }
      step take input OperatingRoomApp.OperatingRoomScreen.DischargeFromPACUInput from user ORNurse with {
        briefly "Discharge PACU"
        described as {
          |Release from recovery.
        }
      }
    } with {
      briefly "PACU recovery workflow"
      described as {
        |Post-operative recovery and discharge process.
      }
    }
  } with {
    briefly "Surgery scheduling and management epic"
    described as {
      | Epic covering the complete surgical case lifecycle from
      | scheduling through surgery to post-operative recovery.
    }
  }
  include "ORContext.riddl"
  include "external-contexts.riddl"
  application context OperatingRoomApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in OperatingRoom are delivered.
      }
    }
    group OperatingRoomScreen is {
      input ScheduleCaseInput acquires command ORContext.SurgicalCase.ScheduleCase with {
        briefly "Schedule case control"
        described as {
          |The control through which a user submits the schedule case request.
        }
      }
      input ConfirmCaseInput acquires command ORContext.SurgicalCase.ConfirmCase with {
        briefly "Confirm case control"
        described as {
          |The control through which a user submits the confirm case request.
        }
      }
      input StartPreOpInput acquires command ORContext.SurgicalCase.StartPreOp with {
        briefly "Start pre op control"
        described as {
          |The control through which a user submits the start pre op request.
        }
      }
      input BringToORInput acquires command ORContext.SurgicalCase.BringToOR with {
        briefly "Bring to or control"
        described as {
          |The control through which a user submits the bring to or request.
        }
      }
      input StartSurgeryInput acquires command ORContext.SurgicalCase.StartSurgery with {
        briefly "Start surgery control"
        described as {
          |The control through which a user submits the start surgery request.
        }
      }
      input CompleteSurgeryInput acquires command ORContext.SurgicalCase.CompleteSurgery with {
        briefly "Complete surgery control"
        described as {
          |The control through which a user submits the complete surgery request.
        }
      }
      input MoveToRecoveryInput acquires command ORContext.SurgicalCase.MoveToRecovery with {
        briefly "Move to recovery control"
        described as {
          |The control through which a user submits the move to recovery request.
        }
      }
      input CancelCaseInput acquires command ORContext.SurgicalCase.CancelCase with {
        briefly "Cancel case control"
        described as {
          |The control through which a user submits the cancel case request.
        }
      }
      input DischargeFromPACUInput acquires command ORContext.SurgicalCase.DischargeFromPACU with {
        briefly "Discharge from pacu control"
        described as {
          |The control through which a user submits the discharge from pacu request.
        }
      }
    } with {
      briefly "Operating room screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppSurgicalCaseCommands is type ORContext.SurgicalCase.SurgicalCaseCommand
    inlet AppSurgicalCaseRepositoryResponses is type ORContext.SurgicalCase.SurgicalCaseResult    handler OperatingRoomAppHandler is {
      on other is {
        error "Unexpected message for application context OperatingRoomApp"
      }
    } with {
      briefly "OperatingRoomApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "OperatingRoomApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppSurgicalCaseCommands is from outlet OperatingRoomApp.AppSurgicalCaseCommands to inlet ORContext.SurgicalCase.SurgicalCaseCommands with {
    option persistent()
    briefly "LinkAppSurgicalCaseCommands"
  }
  connector LinkAppSurgicalCaseRepositoryResponses is from outlet ORContext.SurgicalCaseRepository.SurgicalCaseRepositoryResponses to inlet OperatingRoomApp.AppSurgicalCaseRepositoryResponses with {
    option persistent()
    briefly "LinkAppSurgicalCaseRepositoryResponses"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet OperatingRoomApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Operating room management domain"
  described as {
    | The OperatingRoom domain handles surgical case scheduling,
    | intraoperative workflow, and perioperative management.
  }
}
