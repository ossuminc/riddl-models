// Operating Room Management - OR Context
context ORContext as router is {
  type FromAnesthesiaServiceCommand is one of {
    SurgicalCase.ConfirmCase or SurgicalCase.MoveToRecovery
  } with {
    briefly "What FromAnesthesiaService turns that service's news into"
  }
  inlet ORContextFromAnesthesiaService is type ORContext.FromAnesthesiaServiceCommand with {
    briefly "What FromAnesthesiaService makes of that service's news"
  }
  connector 'FromAnesthesiaService Intake' is from outlet ORContext.FromAnesthesiaService.FromAnesthesiaServiceToORContext to inlet ORContext.ORContextFromAnesthesiaService with {
    briefly "What FromAnesthesiaService makes of that news, on its way in"
  }
  type FromPreOpServiceCommand is one of {
    SurgicalCase.BringToOR or SurgicalCase.StartPreOp
  } with {
    briefly "What FromPreOpService turns that service's news into"
  }
  inlet ORContextFromPreOpService is type ORContext.FromPreOpServiceCommand with {
    briefly "What FromPreOpService makes of that service's news"
  }
  connector 'FromPreOpService Intake' is from outlet ORContext.FromPreOpService.FromPreOpServiceToORContext to inlet ORContext.ORContextFromPreOpService with {
    briefly "What FromPreOpService makes of that news, on its way in"
  }
  connector 'FirstCaseStartProjector Storage 2' is from outlet ORContext.FirstCaseStartProjector.FirstCaseStartProjectorToORScheduleRepository2 to inlet ORContext.ORScheduleRepository.ORScheduleRepositoryFromFirstCaseStartProjector with {
    briefly "FirstCaseStartProjector messages on their way to ORScheduleRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  connector 'FirstCaseStartProjector Storage' is from outlet ORContext.FirstCaseStartProjector.FirstCaseStartProjectorToRepository to inlet ORContext.SurgicalCaseRepository.SurgicalCaseRepositoryFromFirstCaseStartProjector with {
    briefly "FirstCaseStartProjector messages on their way to SurgicalCaseRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  connector 'CancellationRateProjector Storage 2' is from outlet ORContext.CancellationRateProjector.CancellationRateProjectorToORScheduleRepository2 to inlet ORContext.ORScheduleRepository.ORScheduleRepositoryFromCancellationRateProjector with {
    briefly "CancellationRateProjector messages on their way to ORScheduleRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  connector 'CancellationRateProjector Storage' is from outlet ORContext.CancellationRateProjector.CancellationRateProjectorToRepository to inlet ORContext.SurgicalCaseRepository.SurgicalCaseRepositoryFromCancellationRateProjector with {
    briefly "CancellationRateProjector messages on their way to SurgicalCaseRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  connector 'TurnoverTimeProjector Storage 2' is from outlet ORContext.TurnoverTimeProjector.TurnoverTimeProjectorToORScheduleRepository2 to inlet ORContext.ORScheduleRepository.ORScheduleRepositoryFromTurnoverTimeProjector with {
    briefly "TurnoverTimeProjector messages on their way to ORScheduleRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  connector 'TurnoverTimeProjector Storage' is from outlet ORContext.TurnoverTimeProjector.TurnoverTimeProjectorToRepository to inlet ORContext.SurgicalCaseRepository.SurgicalCaseRepositoryFromTurnoverTimeProjector with {
    briefly "TurnoverTimeProjector messages on their way to SurgicalCaseRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  connector 'CaseDurationProjector Storage 2' is from outlet ORContext.CaseDurationProjector.CaseDurationProjectorToORScheduleRepository2 to inlet ORContext.ORScheduleRepository.ORScheduleRepositoryFromCaseDurationProjector with {
    briefly "CaseDurationProjector messages on their way to ORScheduleRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  connector 'CaseDurationProjector Storage' is from outlet ORContext.CaseDurationProjector.CaseDurationProjectorToRepository to inlet ORContext.SurgicalCaseRepository.SurgicalCaseRepositoryFromCaseDurationProjector with {
    briefly "CaseDurationProjector messages on their way to SurgicalCaseRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet SurgicalCaseCommandStreamIn is type SurgicalCaseCommand  outlet SurgicalCaseCommandStreamOut is type SurgicalCaseCommand
  inlet SurgicalCaseResultStreamIn is result SurgicalCase.SurgicalCaseResult  outlet SurgicalCaseResultStreamOut is result SurgicalCase.SurgicalCaseResult
  handler ORContextBoundary is {
    on scheduleCase: command SurgicalCase.ScheduleCase is {
      send scheduleCase to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on confirmCase: command SurgicalCase.ConfirmCase is {
      send confirmCase to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on startPreOp: command SurgicalCase.StartPreOp is {
      send startPreOp to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on bringToOR: command SurgicalCase.BringToOR is {
      send bringToOR to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on startSurgery: command SurgicalCase.StartSurgery is {
      send startSurgery to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on completeSurgery: command SurgicalCase.CompleteSurgery is {
      send completeSurgery to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on moveToRecovery: command SurgicalCase.MoveToRecovery is {
      send moveToRecovery to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on dischargeFromPACU: command SurgicalCase.DischargeFromPACU is {
      send dischargeFromPACU to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on cancelCase: command SurgicalCase.CancelCase is {
      send cancelCase to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on surgicalCaseResult: result SurgicalCase.SurgicalCaseResult is {
      send surgicalCaseResult to outlet ORContext.SurgicalCaseResultStreamOut
    }
    on other is {
      error "Unexpected message at the ORContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ORUtilizationProjector To ORScheduleRepository Storage' is from outlet ORContext.ORUtilizationProjector.ORUtilizationProjectorToORScheduleRepository to inlet ORContext.ORScheduleRepository.ORScheduleRepositoryFromORUtilizationProjector with {
    briefly "ORUtilizationProjector commands on their way to ORScheduleRepository"
  }
  connector 'SurgicalCaseCommand Stream Intake' is from outlet ORContext.SurgicalCaseCommandStreamOut to inlet ORContext.SurgicalCase.SurgicalCaseCommands  connector 'SurgicalCaseResult Stream Egress' is from outlet ORContext.SurgicalCaseRepository.SurgicalCaseRepositoryResponses to inlet ORContext.SurgicalCaseResultStreamIn  adaptor FromAnesthesiaService from context AnesthesiaService as flow is { 
    inlet FromAnesthesiaServiceIn is type AnesthesiaService.AnesthesiaServiceEvent    outlet FromAnesthesiaServiceToORContext is type ORContext.FromAnesthesiaServiceCommand
    handler FromAnesthesiaServiceHandler is {
      on anesthesiaCoverageAssigned: event AnesthesiaService.AnesthesiaCoverageAssigned is {
        let item0: type SurgicalCase.ConfirmCase = prompt("translate the anesthesiaCoverageAssigned event into a ConfirmCase, a case without anaesthesia cover cannot be confirmed, so cover being assigned is what confirms it")
        send item0 to outlet ORContext.FromAnesthesiaService.FromAnesthesiaServiceToORContext
      }
      on anesthesiaRecordComplete: event AnesthesiaService.AnesthesiaRecordComplete is {
        do "the record is complete; the case recorded documenting it"
      }
      on pACUHandoffComplete: event AnesthesiaService.PACUHandoffComplete is {
        let item0: type SurgicalCase.MoveToRecovery = prompt("translate the pACUHandoffComplete event into a MoveToRecovery, handover to recovery actually completing is what moves the case there")
        send item0 to outlet ORContext.FromAnesthesiaService.FromAnesthesiaServiceToORContext
      }
      on other is {
        error "Unexpected message for adaptor FromAnesthesiaService"
      }
    } with {
      briefly "from anesthesia service"
      described as {
        |Carries messages from the external AnesthesiaService.
      }
    }
  } with {
    briefly "AnesthesiaService integration"
    described as {
      |The model's side of the AnesthesiaService conversation.
    }
  }
  adaptor ToAnesthesiaService to context AnesthesiaService as merge is { 
    inlet ToAnesthesiaServiceIn is type SurgicalCaseEvent    inlet ToAnesthesiaServiceReplies is result AnesthesiaService.AnesthesiologistSchedule    outlet ToAnesthesiaServiceOut is type AnesthesiaService.AnesthesiaServiceCommand
    handler ToAnesthesiaServiceHandler is {
      on caseScheduled: event SurgicalCase.CaseScheduled is {
        let askAnswer: type AnesthesiaService.AnesthesiologistSchedule = ask query AnesthesiaService.GetAnesthesiologistSchedule of context AnesthesiaService
        do "a scheduled case needing an anaesthetist who is free for it"
        let item0: type AnesthesiaService.RequestAnesthesiaCoverage = prompt("translate the caseScheduled event into a RequestAnesthesiaCoverage, a scheduled case needing an anaesthetist before it can proceed")
        send item0 to outlet ORContext.ToAnesthesiaService.ToAnesthesiaServiceOut
      }
      on surgeryCompleted: event SurgicalCase.SurgeryCompleted is {
        let item0: type AnesthesiaService.DocumentAnesthesiaRecord = prompt("translate the surgeryCompleted event into a DocumentAnesthesiaRecord, completion fixing what the record must say")
        send item0 to outlet ORContext.ToAnesthesiaService.ToAnesthesiaServiceOut
      }
      on inRecovery: event SurgicalCase.InRecovery is {
        let item0: type AnesthesiaService.RequestPACUHandoff = prompt("translate the inRecovery event into a RequestPACUHandoff, recovery being where care passes to another team")
        send item0 to outlet ORContext.ToAnesthesiaService.ToAnesthesiaServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToAnesthesiaService"
      }
    } with {
      briefly "to anesthesia service"
      described as {
        |Carries messages to the external AnesthesiaService.
      }
    }
  } with {
    briefly "AnesthesiaService integration"
    described as {
      |The model's side of the AnesthesiaService conversation.
    }
  }
  adaptor FromPreOpService from context PreOpService as flow is { 
    inlet FromPreOpServiceIn is type PreOpService.PreOpServiceEvent    outlet FromPreOpServiceToORContext is type ORContext.FromPreOpServiceCommand
    handler FromPreOpServiceHandler is {
      on medicalClearanceComplete: event PreOpService.MedicalClearanceComplete is {
        let item0: type SurgicalCase.StartPreOp = prompt("translate the medicalClearanceComplete event into a StartPreOp, clearance is what lets pre-op begin")
        send item0 to outlet ORContext.FromPreOpService.FromPreOpServiceToORContext
      }
      on patientReadyForOR: event PreOpService.PatientReadyForOR is {
        let item0: type SurgicalCase.BringToOR = prompt("translate the patientReadyForOR event into a BringToOR, a patient declared ready is one who can be brought to theatre")
        send item0 to outlet ORContext.FromPreOpService.FromPreOpServiceToORContext
      }
      on other is {
        error "Unexpected message for adaptor FromPreOpService"
      }
    } with {
      briefly "from pre op service"
      described as {
        |Carries messages from the external PreOpService.
      }
    }
  } with {
    briefly "PreOpService integration"
    described as {
      |The model's side of the PreOpService conversation.
    }
  }
  adaptor ToPreOpService to context PreOpService as merge is { 
    inlet ToPreOpServiceIn is type SurgicalCaseEvent    inlet ToPreOpServiceReplies is result PreOpService.PatientClearances    outlet ToPreOpServiceOut is type PreOpService.PreOpServiceCommand
    handler ToPreOpServiceHandler is {
      on caseScheduled: event SurgicalCase.CaseScheduled is {
        let askAnswer: type PreOpService.PatientClearances = ask query PreOpService.GetPatientClearances of context PreOpService
        do "and a patient who has been cleared for it"
        let item0: type PreOpService.RequestMedicalClearance = prompt("translate the caseScheduled event into a RequestMedicalClearance, a case being unable to proceed on an uncleared patient")
        send item0 to outlet ORContext.ToPreOpService.ToPreOpServiceOut
      }
      on preOpStarted: event SurgicalCase.PreOpStarted is {
        let item0: type PreOpService.RecordNPOStatus = prompt("translate the preOpStarted event into a RecordNPOStatus, pre-op being when fasting must be confirmed")
        send item0 to outlet ORContext.ToPreOpService.ToPreOpServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToPreOpService"
      }
    } with {
      briefly "to pre op service"
      described as {
        |Carries messages to the external PreOpService.
      }
    }
  } with {
    briefly "PreOpService integration"
    described as {
      |The model's side of the PreOpService conversation.
    }
  }
  adaptor FromSterileSupplyService from context SterileSupplyService is { 
    inlet FromSterileSupplyServiceIn is type SterileSupplyService.SterileSupplyServiceEvent    handler FromSterileSupplyServiceHandler is {
      on implantsReady: event SterileSupplyService.ImplantsReady is {
        do "the implants are ready; the case proceeds on clinical readiness"
      }
      on instrumentSetsDelivered: event SterileSupplyService.InstrumentSetsDelivered is {
        do "the sets are delivered; starting surgery depends on the patient and the team"
      }
      on other is {
        error "Unexpected message for adaptor FromSterileSupplyService"
      }
    } with {
      briefly "from sterile supply service"
      described as {
        |Carries messages from the external SterileSupplyService.
      }
    }
  } with {
    briefly "SterileSupplyService integration"
    described as {
      |The model's side of the SterileSupplyService conversation.
    }
  }
  adaptor ToSterileSupplyService to context SterileSupplyService as merge is { 
    inlet ToSterileSupplyServiceIn is type SurgicalCaseEvent    inlet ToSterileSupplyServiceReplies is result SterileSupplyService.InstrumentSetAvailability    outlet ToSterileSupplyServiceOut is type SterileSupplyService.SterileSupplyServiceCommand
    handler ToSterileSupplyServiceHandler is {
      on caseConfirmed: event SurgicalCase.CaseConfirmed is {
        let sets: type SterileSupplyService.RequestInstrumentSets = prompt("translate the caseConfirmed event into a RequestInstrumentSets claiming the trays this procedure needs")
        send sets to outlet ORContext.ToSterileSupplyService.ToSterileSupplyServiceOut
        let implantClaim: type SterileSupplyService.RequestImplants = prompt("translate the caseConfirmed event into a RequestImplants claiming the implants this procedure may consume")
        send implantClaim to outlet ORContext.ToSterileSupplyService.ToSterileSupplyServiceOut
      }
      on surgeryCompleted: event SurgicalCase.SurgeryCompleted is {
        let unused: type SterileSupplyService.ReturnUnusedSupplies = prompt("translate the surgeryCompleted event into a ReturnUnusedSupplies putting back whatever the case did not consume")
        send unused to outlet ORContext.ToSterileSupplyService.ToSterileSupplyServiceOut
      }
      on caseScheduled: event SurgicalCase.CaseScheduled is {
        let askAnswer: type SterileSupplyService.InstrumentSetAvailability = ask query SterileSupplyService.GetInstrumentSetAvailability of context SterileSupplyService
        do "and the instrument sets the procedure needs"
      }
      on other is {
        error "Unexpected message for adaptor ToSterileSupplyService"
      }
    } with {
      briefly "to sterile supply service"
      described as {
        |Carries messages to the external SterileSupplyService.
      }
    }
  } with {
    briefly "SterileSupplyService integration"
    described as {
      |The model's side of the SterileSupplyService conversation.
    }
  }
  include "types.riddl"
  include "SurgicalCase.riddl"
  // Repository for surgical case persistence
  type SurgicalCaseRepositoryCommand is one of {
    ORContext.SurgicalCaseRepository.PersistCaseCancelled or ORContext.SurgicalCaseRepository.PersistCaseConfirmed or ORContext.SurgicalCaseRepository.PersistDischargedFromPACU or ORContext.SurgicalCaseRepository.PersistInRecovery or ORContext.SurgicalCaseRepository.PersistPatientInOR or ORContext.SurgicalCaseRepository.PersistPreOpStarted or ORContext.SurgicalCaseRepository.PersistSurgeryCompleted or ORContext.SurgicalCaseRepository.PersistSurgeryStarted
  } with {
    briefly "Anything that writes SurgicalCaseRepository"
    described as {
      |The persistence commands SurgicalCaseRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository SurgicalCaseRepository as merge is {
    inlet SurgicalCaseRepositoryFromFirstCaseStartProjector is type SurgicalCaseRepositoryCommand with {
      briefly "What FirstCaseStartProjector sends SurgicalCaseRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet SurgicalCaseRepositoryFromCancellationRateProjector is type SurgicalCaseRepositoryCommand with {
      briefly "What CancellationRateProjector sends SurgicalCaseRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet SurgicalCaseRepositoryFromTurnoverTimeProjector is type SurgicalCaseRepositoryCommand with {
      briefly "What TurnoverTimeProjector sends SurgicalCaseRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet SurgicalCaseRepositoryFromCaseDurationProjector is type SurgicalCaseRepositoryCommand with {
      briefly "What CaseDurationProjector sends SurgicalCaseRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet SurgicalCaseRepositoryFromORUtilizationProjector is type SurgicalCaseRepositoryCommand    command PersistCaseConfirmed is {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseConfirmed applies to.
        }
      }
    } with {
      briefly "Persist CaseConfirmed"
      described as {
        |Instructs this repository to apply CaseConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDischargedFromPACU is {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row DischargedFromPACU applies to.
        }
      }
    } with {
      briefly "Persist DischargedFromPACU"
      described as {
        |Instructs this repository to apply DischargedFromPACU to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInRecovery is {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row InRecovery applies to.
        }
      }
    } with {
      briefly "Persist InRecovery"
      described as {
        |Instructs this repository to apply InRecovery to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPreOpStarted is {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row PreOpStarted applies to.
        }
      }
    } with {
      briefly "Persist PreOpStarted"
      described as {
        |Instructs this repository to apply PreOpStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCaseCancelled is {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseCancelled applies to.
        }
      }
    } with {
      briefly "Persist CaseCancelled"
      described as {
        |Instructs this repository to apply CaseCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPatientInOR is {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row PatientInOR applies to.
        }
      }
    } with {
      briefly "Persist PatientInOR"
      described as {
        |Instructs this repository to apply PatientInOR to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSurgeryCompleted is {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row SurgeryCompleted applies to.
        }
      }
    } with {
      briefly "Persist SurgeryCompleted"
      described as {
        |Instructs this repository to apply SurgeryCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSurgeryStarted is {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row SurgeryStarted applies to.
        }
      }
    } with {
      briefly "Persist SurgeryStarted"
      described as {
        |Instructs this repository to apply SurgeryStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet SurgicalCaseRepositoryResponses is result SurgicalCase.SurgicalCaseResult
    record StoredSurgicalCase is {
      surgicalCaseId: UUID with {
        briefly "surgicalCaseId"
        described as {
          |The surgicalCaseId column of the stored surgicalCase row.
        }
      }
      caseId: CaseId with {
        briefly "caseId"
        described as {
          |The caseId column of the stored surgicalCase row.
        }
      }
      patientId: PatientId with {
        briefly "patientId"
        described as {
          |The patientId column of the stored surgicalCase row.
        }
      }
      primarySurgeonId: SurgeonId with {
        briefly "primarySurgeonId"
        described as {
          |The primarySurgeonId column of the stored surgicalCase row.
        }
      }
    } with {
      briefly "Stored surgicalCase row"
      described as {
        |The persistence shape of surgicalCase data as this repository stores it.
      }
    }
    schema SurgicalCaseData is relational
      of cases as record StoredSurgicalCase
        index on field StoredSurgicalCase.caseId
        index on field StoredSurgicalCase.patientId
        index on field StoredSurgicalCase.primarySurgeonId
 with {
      briefly "Surgical case data schema"
      described as {
        |The relational schema holding surgical case data for the SurgicalCaseRepository.
      }
    }
    handler SurgicalCasePersistence is {
      on persistCaseConfirmed: command PersistCaseConfirmed is {
        do "apply CaseConfirmed to the stored row"
      }
      on persistDischargedFromPACU: command PersistDischargedFromPACU is {
        do "apply DischargedFromPACU to the stored row"
      }
      on persistInRecovery: command PersistInRecovery is {
        do "apply InRecovery to the stored row"
      }
      on persistPreOpStarted: command PersistPreOpStarted is {
        do "apply PreOpStarted to the stored row"
      }
      on persistCaseCancelled: command PersistCaseCancelled is {
        do "apply CaseCancelled to the stored row"
      }
      on persistPatientInOR: command PersistPatientInOR is {
        do "apply PatientInOR to the stored row"
      }
      on persistSurgeryCompleted: command PersistSurgeryCompleted is {
        do "apply SurgeryCompleted to the stored row"
      }
      on persistSurgeryStarted: command PersistSurgeryStarted is {
        do "apply SurgeryStarted to the stored row"
      }
      on query GetUtilizationStats is {
        let utilizationStatsView: type UtilizationStatsView = prompt("read the utilization stats projection")
        reply utilizationStatsView
      }
      on query GetDurationStats is {
        let durationStatsView: type DurationStatsView = prompt("read the duration stats projection")
        reply durationStatsView
      }
      on query GetTurnoverStats is {
        let turnoverStatsView: type TurnoverStatsView = prompt("read the turnover stats projection")
        reply turnoverStatsView
      }
      on query GetCancellationStats is {
        let cancellationStatsView: type CancellationStatsView = prompt("read the cancellation stats projection")
        reply cancellationStatsView
      }
      on query GetFirstCaseStats is {
        let firstCaseStatsView: type FirstCaseStatsView = prompt("read the first case stats projection")
        reply firstCaseStatsView
      }
    } with {
      briefly "Persists surgical case events"
      described as {
        |Handles command-driven persistence for surgical cases.
      }
    }
  } with {
    briefly "Surgical case persistence"
    described as {
      | The SurgicalCaseRepository provides persistent storage for
      | surgical case records and timing milestones.
    }
  }
  // Repository for OR schedule
  repository ORScheduleRepository as sink is {
    inlet ORScheduleRepositoryFromFirstCaseStartProjector is command ORContext.ORScheduleRepository.PersistCaseScheduled with {
      briefly "What FirstCaseStartProjector sends ORScheduleRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet ORScheduleRepositoryFromCancellationRateProjector is command ORContext.ORScheduleRepository.PersistCaseScheduled with {
      briefly "What CancellationRateProjector sends ORScheduleRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet ORScheduleRepositoryFromTurnoverTimeProjector is command ORContext.ORScheduleRepository.PersistCaseScheduled with {
      briefly "What TurnoverTimeProjector sends ORScheduleRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet ORScheduleRepositoryFromCaseDurationProjector is command ORContext.ORScheduleRepository.PersistCaseScheduled with {
      briefly "What CaseDurationProjector sends ORScheduleRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet ORScheduleRepositoryFromORUtilizationProjector is command ORContext.ORScheduleRepository.PersistCaseScheduled    command PersistCaseScheduled is {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseScheduled applies to.
        }
      }
    } with {
      briefly "Persist CaseScheduled"
      described as {
        |Instructs this repository to apply CaseScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    schema ORScheduleData is relational
      of schedules as type RoomAssignment
        index on field RoomAssignment.roomId
        index on field RoomAssignment.assignedDate
        index on field RoomAssignment.caseId
 with {
      briefly "Or schedule data schema"
      described as {
        |The relational schema holding or schedule data for the ORScheduleRepository.
      }
    }
    handler SchedulePersistence is {
      on persistCaseScheduled: command PersistCaseScheduled is {
        do "apply CaseScheduled to the stored row"
      }
    } with {
      briefly "Persists OR schedule"
      described as {
        |Maintains operating room schedule assignments.
      }
    }
  } with {
    briefly "OR schedule persistence"
    described as {
      | The ORScheduleRepository tracks room assignments and
      | the daily operating room schedule.
    }
  }
  // Projector for OR utilization metrics
  query GetUtilizationStats replies result UtilizationStatsView is {
    utilizationStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which utilization stats to retrieve.
      }
    }
  } with {
    briefly "Get utilization stats"
    described as {
      |Retrieves the utilization stats projection.
    }
  }
  result UtilizationStatsView is {
    utilizationStats: ORUtilizationProjector.UtilizationStats with {
      briefly "Utilization stats"
      described as {
        |The utilization stats being returned.
      }
    }
  } with {
    briefly "Utilization stats view"
    described as {
      |Read model view carrying the utilization stats projection.
    }
  }
  projector ORUtilizationProjector as split is {
    updates repository ORContext.SurgicalCaseRepository
    outlet ORUtilizationProjectorToRepository is type SurgicalCaseRepositoryCommand
    outlet ORUtilizationProjectorToORScheduleRepository is command ORContext.ORScheduleRepository.PersistCaseScheduled
    inlet ORUtilizationProjectorFromSurgicalCase is type SurgicalCaseEvent    record UtilizationStats is {
      roomId: RoomId with {
        briefly "Room"
        described as {
          |Operating room.
        }
      }
      roomName: String(1,50) with {
        briefly "Name"
        described as {
          |Room name.
        }
      }
      periodDate: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      scheduledMinutes: Natural with {
        briefly "Scheduled"
        described as {
          |Total scheduled minutes.
        }
      }
      actualMinutes: Natural with {
        briefly "Actual"
        described as {
          |Actual utilized minutes.
        }
      }
      availableMinutes: Natural with {
        briefly "Available"
        described as {
          |Total available minutes.
        }
      }
      utilizationRate: Decimal(5,4) with {
        briefly "Rate"
        described as {
          |Utilization percentage.
        }
      }
      casesScheduled: Natural with {
        briefly "Cases scheduled"
        described as {
          |Number of cases scheduled.
        }
      }
      casesCompleted: Natural with {
        briefly "Cases completed"
        described as {
          |Number of cases completed.
        }
      }
      casesCancelled: Natural with {
        briefly "Cancelled"
        described as {
          |Number cancelled same day.
        }
      }
    } with {
      briefly "Utilization statistics"
      described as {
        |Operating room utilization metrics by room and date.
      }
    }
    handler UtilizationHandler is {
      on caseConfirmed: event SurgicalCase.CaseConfirmed is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseConfirmed(caseId = caseConfirmed.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply CaseConfirmed to the ORUtilizationProjector projection"
      }
      on dischargedFromPACU: event SurgicalCase.DischargedFromPACU is {
        tell command ORContext.SurgicalCaseRepository.PersistDischargedFromPACU(caseId = dischargedFromPACU.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply DischargedFromPACU to the ORUtilizationProjector projection"
      }
      on inRecovery: event SurgicalCase.InRecovery is {
        tell command ORContext.SurgicalCaseRepository.PersistInRecovery(caseId = inRecovery.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply InRecovery to the ORUtilizationProjector projection"
      }
      on patientInOR: event SurgicalCase.PatientInOR is {
        tell command ORContext.SurgicalCaseRepository.PersistPatientInOR(caseId = patientInOR.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply PatientInOR to the ORUtilizationProjector projection"
      }
      on preOpStarted: event SurgicalCase.PreOpStarted is {
        tell command ORContext.SurgicalCaseRepository.PersistPreOpStarted(caseId = preOpStarted.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply PreOpStarted to the ORUtilizationProjector projection"
      }
      on surgeryStarted: event SurgicalCase.SurgeryStarted is {
        tell command ORContext.SurgicalCaseRepository.PersistSurgeryStarted(caseId = surgeryStarted.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply SurgeryStarted to the ORUtilizationProjector projection"
      }
      on caseScheduled: event SurgicalCase.CaseScheduled is {
        tell command ORContext.ORScheduleRepository.PersistCaseScheduled(caseId = caseScheduled.caseId) to repository ORContext.ORScheduleRepository
      }
      on surgeryCompleted: event SurgicalCase.SurgeryCompleted is {
        tell command ORContext.SurgicalCaseRepository.PersistSurgeryCompleted(caseId = surgeryCompleted.caseId) to repository ORContext.SurgicalCaseRepository
      }
      on caseCancelled: event SurgicalCase.CaseCancelled is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseCancelled(caseId = caseCancelled.caseId) to repository ORContext.SurgicalCaseRepository
      }
    } with {
      briefly "Maintains utilization metrics"
      described as {
        |Projects case events into utilization statistics.
