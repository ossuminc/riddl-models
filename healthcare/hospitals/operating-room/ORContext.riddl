// Operating Room Management - OR Context
context ORContext as router is {
  inlet SurgicalCaseCommandStreamIn is type SurgicalCaseCommand  outlet SurgicalCaseCommandStreamOut is type SurgicalCaseCommand
  inlet SurgicalCaseResultStreamIn is type SurgicalCase.SurgicalCaseResult  outlet SurgicalCaseResultStreamOut is type SurgicalCase.SurgicalCaseResult
  handler ORContextBoundary is {
    on scheduleCase: command SurgicalCase.ScheduleCase is {
      send scheduleCase to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on confirmCase: command SurgicalCase.ConfirmCase is {
      send confirmCase to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on startPreOp: command SurgicalCase.StartPreOp is {
      send startPreOp to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on bringToOR: command SurgicalCase.BringToOR is {
      send bringToOR to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on startSurgery: command SurgicalCase.StartSurgery is {
      send startSurgery to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on completeSurgery: command SurgicalCase.CompleteSurgery is {
      send completeSurgery to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on moveToRecovery: command SurgicalCase.MoveToRecovery is {
      send moveToRecovery to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on dischargeFromPACU: command SurgicalCase.DischargeFromPACU is {
      send dischargeFromPACU to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on cancelCase: command SurgicalCase.CancelCase is {
      send cancelCase to outlet ORContext.SurgicalCaseCommandStreamOut
    }
    on surgicalCaseResult: result SurgicalCase.SurgicalCaseResult is {
      send surgicalCaseResult to outlet ORContext.SurgicalCaseResultStreamOut
    }
    on other is {
      error "Unexpected message at the ORContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'SurgicalCaseCommand Stream Intake' is from outlet ORContext.SurgicalCaseCommandStreamOut to inlet ORContext.SurgicalCase.SurgicalCaseCommands  connector 'SurgicalCaseResult Stream Egress' is from outlet ORContext.SurgicalCaseRepository.SurgicalCaseRepositoryResponses to inlet ORContext.SurgicalCaseResultStreamIn  adaptor FromAnesthesiaService from context AnesthesiaService is { 
    handler FromAnesthesiaServiceHandler is {
      on event AnesthesiaService.AnesthesiaCoverageAssigned is {
        do "the model receives anesthesia coverage assigned"
      }
      on event AnesthesiaService.AnesthesiaRecordComplete is {
        do "the model receives anesthesia record complete"
      }
      on result AnesthesiaService.AnesthesiologistSchedule is {
        do "the model receives anesthesiologist schedule"
      }
      on event AnesthesiaService.PACUHandoffComplete is {
        do "the model receives pacu handoff complete"
      }
      on other is {
        error "Unexpected message for adaptor FromAnesthesiaService"
      }
    } with {
      briefly "from anesthesia service"
      described as {
        |Carries messages from the external AnesthesiaService.
      }
    }
  } with {
    briefly "AnesthesiaService integration"
    described as {
      |The model's side of the AnesthesiaService conversation.
    }
  }
  adaptor ToAnesthesiaService to context AnesthesiaService is { 
    handler ToAnesthesiaServiceHandler is {
      on command AnesthesiaService.DocumentAnesthesiaRecord is {
        do "the model sends document anesthesia record"
      }
      on query AnesthesiaService.GetAnesthesiologistSchedule is {
        do "the model sends get anesthesiologist schedule"
      }
      on command AnesthesiaService.RequestAnesthesiaCoverage is {
        do "the model sends request anesthesia coverage"
      }
      on command AnesthesiaService.RequestPACUHandoff is {
        do "the model sends request pacu handoff"
      }
      on other is {
        error "Unexpected message for adaptor ToAnesthesiaService"
      }
    } with {
      briefly "to anesthesia service"
      described as {
        |Carries messages to the external AnesthesiaService.
      }
    }
  } with {
    briefly "AnesthesiaService integration"
    described as {
      |The model's side of the AnesthesiaService conversation.
    }
  }
  adaptor FromPreOpService from context PreOpService is { 
    handler FromPreOpServiceHandler is {
      on event PreOpService.MedicalClearanceComplete is {
        do "the model receives medical clearance complete"
      }
      on result PreOpService.PatientClearances is {
        do "the model receives patient clearances"
      }
      on event PreOpService.PatientReadyForOR is {
        do "the model receives patient ready for or"
      }
      on other is {
        error "Unexpected message for adaptor FromPreOpService"
      }
    } with {
      briefly "from pre op service"
      described as {
        |Carries messages from the external PreOpService.
      }
    }
  } with {
    briefly "PreOpService integration"
    described as {
      |The model's side of the PreOpService conversation.
    }
  }
  adaptor ToPreOpService to context PreOpService is { 
    handler ToPreOpServiceHandler is {
      on query PreOpService.GetPatientClearances is {
        do "the model sends get patient clearances"
      }
      on command PreOpService.RecordNPOStatus is {
        do "the model sends record npo status"
      }
      on command PreOpService.RequestMedicalClearance is {
        do "the model sends request medical clearance"
      }
      on other is {
        error "Unexpected message for adaptor ToPreOpService"
      }
    } with {
      briefly "to pre op service"
      described as {
        |Carries messages to the external PreOpService.
      }
    }
  } with {
    briefly "PreOpService integration"
    described as {
      |The model's side of the PreOpService conversation.
    }
  }
  adaptor FromSterileSupplyService from context SterileSupplyService is { 
    handler FromSterileSupplyServiceHandler is {
      on event SterileSupplyService.ImplantsReady is {
        do "the model receives implants ready"
      }
      on result SterileSupplyService.InstrumentSetAvailability is {
        do "the model receives instrument set availability"
      }
      on event SterileSupplyService.InstrumentSetsDelivered is {
        do "the model receives instrument sets delivered"
      }
      on other is {
        error "Unexpected message for adaptor FromSterileSupplyService"
      }
    } with {
      briefly "from sterile supply service"
      described as {
        |Carries messages from the external SterileSupplyService.
      }
    }
  } with {
    briefly "SterileSupplyService integration"
    described as {
      |The model's side of the SterileSupplyService conversation.
    }
  }
  adaptor ToSterileSupplyService to context SterileSupplyService is { 
    handler ToSterileSupplyServiceHandler is {
      on query SterileSupplyService.GetInstrumentSetAvailability is {
        do "the model sends get instrument set availability"
      }
      on command SterileSupplyService.RequestImplants is {
        do "the model sends request implants"
      }
      on command SterileSupplyService.RequestInstrumentSets is {
        do "the model sends request instrument sets"
      }
      on command SterileSupplyService.ReturnUnusedSupplies is {
        do "the model sends return unused supplies"
      }
      on other is {
        error "Unexpected message for adaptor ToSterileSupplyService"
      }
    } with {
      briefly "to sterile supply service"
      described as {
        |Carries messages to the external SterileSupplyService.
      }
    }
  } with {
    briefly "SterileSupplyService integration"
    described as {
      |The model's side of the SterileSupplyService conversation.
    }
  }
  include "types.riddl"
  include "SurgicalCase.riddl"
  // Repository for surgical case persistence
  type SurgicalCaseRepositoryCommand is one of {
    ORContext.SurgicalCaseRepository.PersistCaseCancelled or ORContext.SurgicalCaseRepository.PersistCaseConfirmed or ORContext.SurgicalCaseRepository.PersistCaseScheduled or ORContext.SurgicalCaseRepository.PersistDischargedFromPACU or ORContext.SurgicalCaseRepository.PersistInRecovery or ORContext.SurgicalCaseRepository.PersistPatientInOR or ORContext.SurgicalCaseRepository.PersistPreOpStarted or ORContext.SurgicalCaseRepository.PersistSurgeryCompleted or ORContext.SurgicalCaseRepository.PersistSurgeryStarted
  } with {
    briefly "Anything that writes SurgicalCaseRepository"
    described as {
      |The persistence commands SurgicalCaseRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository SurgicalCaseRepository as flow is {
    inlet SurgicalCaseRepositoryFromORUtilizationProjector is type SurgicalCaseRepositoryCommand
    command PersistCaseConfirmed is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseConfirmed applies to.
        }
      }
    } with {
      briefly "Persist CaseConfirmed"
      described as {
        |Instructs this repository to apply CaseConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDischargedFromPACU is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row DischargedFromPACU applies to.
        }
      }
    } with {
      briefly "Persist DischargedFromPACU"
      described as {
        |Instructs this repository to apply DischargedFromPACU to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInRecovery is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row InRecovery applies to.
        }
      }
    } with {
      briefly "Persist InRecovery"
      described as {
        |Instructs this repository to apply InRecovery to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPreOpStarted is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row PreOpStarted applies to.
        }
      }
    } with {
      briefly "Persist PreOpStarted"
      described as {
        |Instructs this repository to apply PreOpStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCaseCancelled is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseCancelled applies to.
        }
      }
    } with {
      briefly "Persist CaseCancelled"
      described as {
        |Instructs this repository to apply CaseCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCaseScheduled is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseScheduled applies to.
        }
      }
    } with {
      briefly "Persist CaseScheduled"
      described as {
        |Instructs this repository to apply CaseScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPatientInOR is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row PatientInOR applies to.
        }
      }
    } with {
      briefly "Persist PatientInOR"
      described as {
        |Instructs this repository to apply PatientInOR to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSurgeryCompleted is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row SurgeryCompleted applies to.
        }
      }
    } with {
      briefly "Persist SurgeryCompleted"
      described as {
        |Instructs this repository to apply SurgeryCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSurgeryStarted is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row SurgeryStarted applies to.
        }
      }
    } with {
      briefly "Persist SurgeryStarted"
      described as {
        |Instructs this repository to apply SurgeryStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet SurgicalCaseRepositoryResponses is type SurgicalCase.SurgicalCaseResult
    record StoredSurgicalCase is  {
      surgicalCaseId: UUID with {
        briefly "surgicalCaseId"
        described as {
          |The surgicalCaseId column of the stored surgicalCase row.
        }
      }
      caseId: CaseId with {
        briefly "caseId"
        described as {
          |The caseId column of the stored surgicalCase row.
        }
      }
      patientId: PatientId with {
        briefly "patientId"
        described as {
          |The patientId column of the stored surgicalCase row.
        }
      }
      primarySurgeonId: SurgeonId with {
        briefly "primarySurgeonId"
        described as {
          |The primarySurgeonId column of the stored surgicalCase row.
        }
      }
    } with {
      briefly "Stored surgicalCase row"
      described as {
        |The persistence shape of surgicalCase data as this repository stores it.
      }
    }
    schema SurgicalCaseData is relational
      of cases as type StoredSurgicalCase
        index on field StoredSurgicalCase.caseId
        index on field StoredSurgicalCase.patientId
        index on field StoredSurgicalCase.primarySurgeonId
 with {
      briefly "Surgical case data schema"
      described as {
        |The relational schema holding surgical case data for the SurgicalCaseRepository.
      }
    }
    handler SurgicalCasePersistence is {
      on persistCaseConfirmed: command PersistCaseConfirmed is {
        do "apply CaseConfirmed to the stored row"
      }
      on persistDischargedFromPACU: command PersistDischargedFromPACU is {
        do "apply DischargedFromPACU to the stored row"
      }
      on persistInRecovery: command PersistInRecovery is {
        do "apply InRecovery to the stored row"
      }
      on persistPreOpStarted: command PersistPreOpStarted is {
        do "apply PreOpStarted to the stored row"
      }
      on persistCaseCancelled: command PersistCaseCancelled is {
        do "apply CaseCancelled to the stored row"
      }
      on persistCaseScheduled: command PersistCaseScheduled is {
        do "apply CaseScheduled to the stored row"
      }
      on persistPatientInOR: command PersistPatientInOR is {
        do "apply PatientInOR to the stored row"
      }
      on persistSurgeryCompleted: command PersistSurgeryCompleted is {
        do "apply SurgeryCompleted to the stored row"
      }
      on persistSurgeryStarted: command PersistSurgeryStarted is {
        do "apply SurgeryStarted to the stored row"
      }
      on query GetUtilizationStats is {
        let utilizationStatsView: type UtilizationStatsView = prompt("read the utilization stats projection")
        reply utilizationStatsView
      }
      on query GetDurationStats is {
        let durationStatsView: type DurationStatsView = prompt("read the duration stats projection")
        reply durationStatsView
      }
      on query GetTurnoverStats is {
        let turnoverStatsView: type TurnoverStatsView = prompt("read the turnover stats projection")
        reply turnoverStatsView
      }
      on query GetCancellationStats is {
        let cancellationStatsView: type CancellationStatsView = prompt("read the cancellation stats projection")
        reply cancellationStatsView
      }
      on query GetFirstCaseStats is {
        let firstCaseStatsView: type FirstCaseStatsView = prompt("read the first case stats projection")
        reply firstCaseStatsView
      }
    } with {
      briefly "Persists surgical case events"
      described as {
        |Handles command-driven persistence for surgical cases.
      }
    }
  } with {
    briefly "Surgical case persistence"
    described as {
      | The SurgicalCaseRepository provides persistent storage for
      | surgical case records and timing milestones.
    }
  }
  // Repository for OR schedule
  repository ORScheduleRepository as sink is {
    schema ORScheduleData is relational
      of schedules as type RoomAssignment
        index on field RoomAssignment.roomId
        index on field RoomAssignment.assignedDate
        index on field RoomAssignment.caseId
 with {
      briefly "Or schedule data schema"
      described as {
        |The relational schema holding or schedule data for the ORScheduleRepository.
      }
    }
    handler SchedulePersistence is {
    } with {
      briefly "Persists OR schedule"
      described as {
        |Maintains operating room schedule assignments.
      }
    }
  } with {
    briefly "OR schedule persistence"
    described as {
      | The ORScheduleRepository tracks room assignments and
      | the daily operating room schedule.
    }
  }
  // Projector for OR utilization metrics
  query GetUtilizationStats replies result UtilizationStatsView is  {
    utilizationStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which utilization stats to retrieve.
      }
    }
  } with {
    briefly "Get utilization stats"
    described as {
      |Retrieves the utilization stats projection.
    }
  }
  result UtilizationStatsView is  {
    utilizationStats: ORUtilizationProjector.UtilizationStats with {
      briefly "Utilization stats"
      described as {
        |The utilization stats being returned.
      }
    }
  } with {
    briefly "Utilization stats view"
    described as {
      |Read model view carrying the utilization stats projection.
    }
  }
  projector ORUtilizationProjector as flow is {
    outlet ORUtilizationProjectorToRepository is type SurgicalCaseRepositoryCommand
    updates repository ORContext.SurgicalCaseRepository
    inlet ORUtilizationProjectorFromSurgicalCase is type SurgicalCaseEvent
    record UtilizationStats is  {
      roomId: RoomId with {
        briefly "Room"
        described as {
          |Operating room.
        }
      }
      roomName: String(1,50) with {
        briefly "Name"
        described as {
          |Room name.
        }
      }
      periodDate: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      scheduledMinutes: Natural with {
        briefly "Scheduled"
        described as {
          |Total scheduled minutes.
        }
      }
      actualMinutes: Natural with {
        briefly "Actual"
        described as {
          |Actual utilized minutes.
        }
      }
      availableMinutes: Natural with {
        briefly "Available"
        described as {
          |Total available minutes.
        }
      }
      utilizationRate: Decimal(5,4) with {
        briefly "Rate"
        described as {
          |Utilization percentage.
        }
      }
      casesScheduled: Natural with {
        briefly "Cases scheduled"
        described as {
          |Number of cases scheduled.
        }
      }
      casesCompleted: Natural with {
        briefly "Cases completed"
        described as {
          |Number of cases completed.
        }
      }
      casesCancelled: Natural with {
        briefly "Cancelled"
        described as {
          |Number cancelled same day.
        }
      }
    } with {
      briefly "Utilization statistics"
      described as {
        |Operating room utilization metrics by room and date.
      }
    }
    handler UtilizationHandler is {
      on caseConfirmed: event SurgicalCase.CaseConfirmed is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseConfirmed(caseId = caseConfirmed.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply CaseConfirmed to the ORUtilizationProjector projection"
      }
      on dischargedFromPACU: event SurgicalCase.DischargedFromPACU is {
        tell command ORContext.SurgicalCaseRepository.PersistDischargedFromPACU(caseId = dischargedFromPACU.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply DischargedFromPACU to the ORUtilizationProjector projection"
      }
      on inRecovery: event SurgicalCase.InRecovery is {
        tell command ORContext.SurgicalCaseRepository.PersistInRecovery(caseId = inRecovery.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply InRecovery to the ORUtilizationProjector projection"
      }
      on patientInOR: event SurgicalCase.PatientInOR is {
        tell command ORContext.SurgicalCaseRepository.PersistPatientInOR(caseId = patientInOR.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply PatientInOR to the ORUtilizationProjector projection"
      }
      on preOpStarted: event SurgicalCase.PreOpStarted is {
        tell command ORContext.SurgicalCaseRepository.PersistPreOpStarted(caseId = preOpStarted.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply PreOpStarted to the ORUtilizationProjector projection"
      }
      on surgeryStarted: event SurgicalCase.SurgeryStarted is {
        tell command ORContext.SurgicalCaseRepository.PersistSurgeryStarted(caseId = surgeryStarted.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply SurgeryStarted to the ORUtilizationProjector projection"
      }
      on caseScheduled: event SurgicalCase.CaseScheduled is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseScheduled(caseId = caseScheduled.caseId) to repository ORContext.SurgicalCaseRepository
      }
      on surgeryCompleted: event SurgicalCase.SurgeryCompleted is {
        tell command ORContext.SurgicalCaseRepository.PersistSurgeryCompleted(caseId = surgeryCompleted.caseId) to repository ORContext.SurgicalCaseRepository
      }
      on caseCancelled: event SurgicalCase.CaseCancelled is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseCancelled(caseId = caseCancelled.caseId) to repository ORContext.SurgicalCaseRepository
      }
    } with {
      briefly "Maintains utilization metrics"
      described as {
        |Projects case events into utilization statistics.
      }
    }
  } with {
    briefly "OR utilization projections"
    described as {
      |Maintains real-time operating room utilization analytics.
    }
  }
  // Projector for case duration analytics
  query GetDurationStats replies result DurationStatsView is  {
    durationStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which duration stats to retrieve.
      }
    }
  } with {
    briefly "Get duration stats"
    described as {
      |Retrieves the duration stats projection.
    }
  }
  result DurationStatsView is  {
    durationStats: CaseDurationProjector.DurationStats with {
      briefly "Duration stats"
      described as {
        |The duration stats being returned.
      }
    }
  } with {
    briefly "Duration stats view"
    described as {
      |Read model view carrying the duration stats projection.
    }
  }
  projector CaseDurationProjector as sink is {
    updates repository ORContext.SurgicalCaseRepository
    inlet CaseDurationProjectorFromSurgicalCase is type SurgicalCaseEvent
    record DurationStats is  {
      procedureId: ProcedureId with {
        briefly "Procedure"
        described as {
          |Procedure type.
        }
      }
      procedureName: String(1,500) with {
        briefly "Name"
        described as {
          |Procedure name.
        }
      }
      surgeonId: SurgeonId? with {
        briefly "Surgeon"
        described as {
          |Surgeon filter.
        }
      }
      averageDuration: Duration with {
        briefly "Avg duration"
        described as {
          |Average procedure time.
        }
      }
      medianDuration: Duration with {
        briefly "Median"
        described as {
          |Median procedure time.
        }
      }
      minDuration: Duration with {
        briefly "Min"
        described as {
          |Shortest procedure.
        }
      }
      maxDuration: Duration with {
        briefly "Max"
        described as {
          |Longest procedure.
        }
      }
      standardDeviation: Decimal(8,2) with {
        briefly "Std dev"
        described as {
          |Duration variability.
        }
      }
      caseCount: Natural with {
        briefly "Cases"
        described as {
          |Number of cases analyzed.
        }
      }
      periodStart: Date with {
        briefly "Start"
        described as {
          |Analysis period start.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Analysis period end.
        }
      }
    } with {
      briefly "Duration statistics"
      described as {
        |Surgical procedure duration analytics.
      }
    }
    handler DurationHandler is {
      on caseCancelled: event SurgicalCase.CaseCancelled is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseCancelled(caseId = caseCancelled.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply CaseCancelled to the CaseDurationProjector projection"
      }
      on caseConfirmed: event SurgicalCase.CaseConfirmed is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseConfirmed(caseId = caseConfirmed.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply CaseConfirmed to the CaseDurationProjector projection"
      }
      on caseScheduled: event SurgicalCase.CaseScheduled is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseScheduled(caseId = caseScheduled.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply CaseScheduled to the CaseDurationProjector projection"
      }
      on dischargedFromPACU: event SurgicalCase.DischargedFromPACU is {
        tell command ORContext.SurgicalCaseRepository.PersistDischargedFromPACU(caseId = dischargedFromPACU.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply DischargedFromPACU to the CaseDurationProjector projection"
      }
      on inRecovery: event SurgicalCase.InRecovery is {
        tell command ORContext.SurgicalCaseRepository.PersistInRecovery(caseId = inRecovery.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply InRecovery to the CaseDurationProjector projection"
      }
      on patientInOR: event SurgicalCase.PatientInOR is {
        tell command ORContext.SurgicalCaseRepository.PersistPatientInOR(caseId = patientInOR.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply PatientInOR to the CaseDurationProjector projection"
      }
      on preOpStarted: event SurgicalCase.PreOpStarted is {
        tell command ORContext.SurgicalCaseRepository.PersistPreOpStarted(caseId = preOpStarted.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply PreOpStarted to the CaseDurationProjector projection"
      }
      on surgeryStarted: event SurgicalCase.SurgeryStarted is {
        tell command ORContext.SurgicalCaseRepository.PersistSurgeryStarted(caseId = surgeryStarted.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply SurgeryStarted to the CaseDurationProjector projection"
      }
      on surgeryCompleted: event SurgicalCase.SurgeryCompleted is {
        tell command ORContext.SurgicalCaseRepository.PersistSurgeryCompleted(caseId = surgeryCompleted.caseId) to repository ORContext.SurgicalCaseRepository
      }
    } with {
      briefly "Maintains duration metrics"
      described as {
        |Projects surgery completion into duration analytics.
      }
    }
  } with {
    briefly "Case duration projections"
    described as {
      |Maintains surgical procedure duration analytics for scheduling accuracy.
    }
  }
  // Projector for turnover time analytics
  query GetTurnoverStats replies result TurnoverStatsView is  {
    turnoverStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which turnover stats to retrieve.
      }
    }
  } with {
    briefly "Get turnover stats"
    described as {
      |Retrieves the turnover stats projection.
    }
  }
  result TurnoverStatsView is  {
    turnoverStats: TurnoverTimeProjector.TurnoverStats with {
      briefly "Turnover stats"
      described as {
        |The turnover stats being returned.
      }
    }
  } with {
    briefly "Turnover stats view"
    described as {
      |Read model view carrying the turnover stats projection.
    }
  }
  projector TurnoverTimeProjector as sink is {
    updates repository ORContext.SurgicalCaseRepository
    inlet TurnoverTimeProjectorFromSurgicalCase is type SurgicalCaseEvent
    record TurnoverStats is  {
      roomId: RoomId with {
        briefly "Room"
        described as {
          |Operating room.
        }
      }
      periodDate: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      averageTurnoverMinutes: Natural with {
        briefly "Avg turnover"
        described as {
          |Average turnover time.
        }
      }
      medianTurnoverMinutes: Natural with {
        briefly "Median"
        described as {
          |Median turnover time.
        }
      }
      targetTurnoverMinutes: Natural with {
        briefly "Target"
        described as {
          |Target turnover time.
        }
      }
      turnoversOnTarget: Natural with {
        briefly "On target"
        described as {
          |Turnovers meeting target.
        }
      }
      turnoversDelayed: Natural with {
        briefly "Delayed"
        described as {
          |Turnovers exceeding target.
        }
      }
      totalTurnovers: Natural with {
        briefly "Total"
        described as {
          |Total turnovers.
        }
      }
      delayMinutesTotal: Natural with {
        briefly "Delay total"
        described as {
          |Total delay minutes.
        }
      }
      commonDelayReasons: String(1,200)+ with {
        briefly "Delay reasons"
        described as {
          |Most common delay causes.
        }
      }
    } with {
      briefly "Turnover statistics"
      described as {
        |Room turnover time metrics.
      }
    }
    handler TurnoverHandler is {
      on caseCancelled: event SurgicalCase.CaseCancelled is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseCancelled(caseId = caseCancelled.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply CaseCancelled to the TurnoverTimeProjector projection"
      }
      on caseConfirmed: event SurgicalCase.CaseConfirmed is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseConfirmed(caseId = caseConfirmed.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply CaseConfirmed to the TurnoverTimeProjector projection"
      }
      on caseScheduled: event SurgicalCase.CaseScheduled is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseScheduled(caseId = caseScheduled.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply CaseScheduled to the TurnoverTimeProjector projection"
      }
      on dischargedFromPACU: event SurgicalCase.DischargedFromPACU is {
        tell command ORContext.SurgicalCaseRepository.PersistDischargedFromPACU(caseId = dischargedFromPACU.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply DischargedFromPACU to the TurnoverTimeProjector projection"
      }
      on inRecovery: event SurgicalCase.InRecovery is {
        tell command ORContext.SurgicalCaseRepository.PersistInRecovery(caseId = inRecovery.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply InRecovery to the TurnoverTimeProjector projection"
      }
      on preOpStarted: event SurgicalCase.PreOpStarted is {
        tell command ORContext.SurgicalCaseRepository.PersistPreOpStarted(caseId = preOpStarted.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply PreOpStarted to the TurnoverTimeProjector projection"
      }
      on surgeryStarted: event SurgicalCase.SurgeryStarted is {
        tell command ORContext.SurgicalCaseRepository.PersistSurgeryStarted(caseId = surgeryStarted.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply SurgeryStarted to the TurnoverTimeProjector projection"
      }
      on patientInOR: event SurgicalCase.PatientInOR is {
        tell command ORContext.SurgicalCaseRepository.PersistPatientInOR(caseId = patientInOR.caseId) to repository ORContext.SurgicalCaseRepository
      }
      on surgeryCompleted: event SurgicalCase.SurgeryCompleted is {
        tell command ORContext.SurgicalCaseRepository.PersistSurgeryCompleted(caseId = surgeryCompleted.caseId) to repository ORContext.SurgicalCaseRepository
      }
    } with {
      briefly "Maintains turnover metrics"
      described as {
        |Projects case events into turnover analytics.
      }
    }
  } with {
    briefly "Turnover time projections"
    described as {
      |Maintains room turnover time analytics for efficiency improvement.
    }
  }
  // Projector for cancellation analytics
  query GetCancellationStats replies result CancellationStatsView is  {
    cancellationStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which cancellation stats to retrieve.
      }
    }
  } with {
    briefly "Get cancellation stats"
    described as {
      |Retrieves the cancellation stats projection.
    }
  }
  result CancellationStatsView is  {
    cancellationStats: CancellationRateProjector.CancellationStats with {
      briefly "Cancellation stats"
      described as {
        |The cancellation stats being returned.
      }
    }
  } with {
    briefly "Cancellation stats view"
    described as {
      |Read model view carrying the cancellation stats projection.
    }
  }
  projector CancellationRateProjector as sink is {
    updates repository ORContext.SurgicalCaseRepository
    inlet CancellationRateProjectorFromSurgicalCase is type SurgicalCaseEvent
    record CancellationStats is  {
      periodStart: Date with {
        briefly "Start"
        described as {
          |Period start date.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Period end date.
        }
      }
      totalScheduled: Natural with {
        briefly "Scheduled"
        described as {
          |Total cases scheduled.
        }
      }
      totalCancelled: Natural with {
        briefly "Cancelled"
        described as {
          |Total cancellations.
        }
      }
      cancellationRate: Decimal(5,4) with {
        briefly "Rate"
        described as {
          |Cancellation percentage.
        }
      }
      sameDayCancellations: Natural with {
        briefly "Same day"
        described as {
          |Same-day cancellations.
        }
      }
      byReason: String(1,200)+ with {
        briefly "By reason"
        described as {
          |Cancellations by reason.
        }
      }
      bySurgeon: String(1,200)+ with {
        briefly "By surgeon"
        described as {
          |Cancellations by surgeon.
        }
      }
      byServiceLine: String(1,200)+ with {
        briefly "By service"
        described as {
          |Cancellations by service line.
        }
      }
      preventableCancellations: Natural with {
        briefly "Preventable"
        described as {
          |Potentially preventable cancellations.
        }
      }
    } with {
      briefly "Cancellation statistics"
      described as {
        |Surgical case cancellation analytics.
      }
    }
    handler CancellationHandler is {
      on caseConfirmed: event SurgicalCase.CaseConfirmed is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseConfirmed(caseId = caseConfirmed.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply CaseConfirmed to the CancellationRateProjector projection"
      }
      on dischargedFromPACU: event SurgicalCase.DischargedFromPACU is {
        tell command ORContext.SurgicalCaseRepository.PersistDischargedFromPACU(caseId = dischargedFromPACU.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply DischargedFromPACU to the CancellationRateProjector projection"
      }
      on inRecovery: event SurgicalCase.InRecovery is {
        tell command ORContext.SurgicalCaseRepository.PersistInRecovery(caseId = inRecovery.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply InRecovery to the CancellationRateProjector projection"
      }
      on patientInOR: event SurgicalCase.PatientInOR is {
        tell command ORContext.SurgicalCaseRepository.PersistPatientInOR(caseId = patientInOR.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply PatientInOR to the CancellationRateProjector projection"
      }
      on preOpStarted: event SurgicalCase.PreOpStarted is {
        tell command ORContext.SurgicalCaseRepository.PersistPreOpStarted(caseId = preOpStarted.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply PreOpStarted to the CancellationRateProjector projection"
      }
      on surgeryCompleted: event SurgicalCase.SurgeryCompleted is {
        tell command ORContext.SurgicalCaseRepository.PersistSurgeryCompleted(caseId = surgeryCompleted.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply SurgeryCompleted to the CancellationRateProjector projection"
      }
      on surgeryStarted: event SurgicalCase.SurgeryStarted is {
        tell command ORContext.SurgicalCaseRepository.PersistSurgeryStarted(caseId = surgeryStarted.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply SurgeryStarted to the CancellationRateProjector projection"
      }
      on caseScheduled: event SurgicalCase.CaseScheduled is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseScheduled(caseId = caseScheduled.caseId) to repository ORContext.SurgicalCaseRepository
      }
      on caseCancelled: event SurgicalCase.CaseCancelled is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseCancelled(caseId = caseCancelled.caseId) to repository ORContext.SurgicalCaseRepository
      }
    } with {
      briefly "Maintains cancellation metrics"
      described as {
        |Projects cancellation events into analytics.
      }
    }
  } with {
    briefly "Cancellation rate projections"
    described as {
      |Maintains surgical cancellation analytics for quality improvement.
    }
  }
  // Projector for first case on-time starts
  query GetFirstCaseStats replies result FirstCaseStatsView is  {
    firstCaseStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which first case stats to retrieve.
      }
    }
  } with {
    briefly "Get first case stats"
    described as {
      |Retrieves the first case stats projection.
    }
  }
  result FirstCaseStatsView is  {
    firstCaseStats: FirstCaseStartProjector.FirstCaseStats with {
      briefly "First case stats"
      described as {
        |The first case stats being returned.
      }
    }
  } with {
    briefly "First case stats view"
    described as {
      |Read model view carrying the first case stats projection.
    }
  }
  projector FirstCaseStartProjector as sink is {
    updates repository ORContext.SurgicalCaseRepository
    inlet FirstCaseStartProjectorFromSurgicalCase is type SurgicalCaseEvent
    record FirstCaseStats is  {
      roomId: RoomId with {
        briefly "Room"
        described as {
          |Operating room.
        }
      }
      periodDate: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      scheduledStartTime: Time with {
        briefly "Scheduled"
        described as {
          |Scheduled start time.
        }
      }
      actualStartTime: Time with {
        briefly "Actual"
        described as {
          |Actual start time.
        }
      }
      delayMinutes: Integer with {
        briefly "Delay"
        described as {
          |Minutes delayed (negative is early).
        }
      }
      onTimeStart: Boolean with {
        briefly "On time"
        described as {
          |Started within 5 minutes of scheduled.
        }
      }
      delayReason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Cause of delay if any.
        }
      }
    } with {
      briefly "First case start statistics"
      described as {
        |First case on-time start metrics.
      }
    }
    handler FirstCaseHandler is {
      on caseCancelled: event SurgicalCase.CaseCancelled is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseCancelled(caseId = caseCancelled.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply CaseCancelled to the FirstCaseStartProjector projection"
      }
      on caseConfirmed: event SurgicalCase.CaseConfirmed is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseConfirmed(caseId = caseConfirmed.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply CaseConfirmed to the FirstCaseStartProjector projection"
      }
      on caseScheduled: event SurgicalCase.CaseScheduled is {
        tell command ORContext.SurgicalCaseRepository.PersistCaseScheduled(caseId = caseScheduled.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply CaseScheduled to the FirstCaseStartProjector projection"
      }
      on dischargedFromPACU: event SurgicalCase.DischargedFromPACU is {
        tell command ORContext.SurgicalCaseRepository.PersistDischargedFromPACU(caseId = dischargedFromPACU.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply DischargedFromPACU to the FirstCaseStartProjector projection"
      }
      on inRecovery: event SurgicalCase.InRecovery is {
        tell command ORContext.SurgicalCaseRepository.PersistInRecovery(caseId = inRecovery.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply InRecovery to the FirstCaseStartProjector projection"
      }
      on patientInOR: event SurgicalCase.PatientInOR is {
        tell command ORContext.SurgicalCaseRepository.PersistPatientInOR(caseId = patientInOR.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply PatientInOR to the FirstCaseStartProjector projection"
      }
      on preOpStarted: event SurgicalCase.PreOpStarted is {
        tell command ORContext.SurgicalCaseRepository.PersistPreOpStarted(caseId = preOpStarted.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply PreOpStarted to the FirstCaseStartProjector projection"
      }
      on surgeryCompleted: event SurgicalCase.SurgeryCompleted is {
        tell command ORContext.SurgicalCaseRepository.PersistSurgeryCompleted(caseId = surgeryCompleted.caseId) to repository ORContext.SurgicalCaseRepository
        do "apply SurgeryCompleted to the FirstCaseStartProjector projection"
      }
      on surgeryStarted: event SurgicalCase.SurgeryStarted is {
        tell command ORContext.SurgicalCaseRepository.PersistSurgeryStarted(caseId = surgeryStarted.caseId) to repository ORContext.SurgicalCaseRepository
      }
    } with {
      briefly "Maintains first case metrics"
      described as {
        |Projects surgery starts into first case analytics.
      }
    }
  } with {
    briefly "First case on-time projections"
    described as {
      |Maintains first case on-time start analytics.
    }
  }
  type SurgicalCaseEvent is one of {
    ORContext.SurgicalCase.CaseScheduled or ORContext.SurgicalCase.CaseConfirmed or ORContext.SurgicalCase.PreOpStarted or ORContext.SurgicalCase.PatientInOR or ORContext.SurgicalCase.SurgeryStarted or ORContext.SurgicalCase.SurgeryCompleted or ORContext.SurgicalCase.InRecovery or ORContext.SurgicalCase.DischargedFromPACU or ORContext.SurgicalCase.CaseCancelled
  } with {
    briefly "Surgical case events"
    described as {
      |Union of all surgical case events for streaming.
    }
  }
  processor SurgicalCaseSource as source is {
    outlet SurgicalCaseEvents is type SurgicalCaseEvent
 with {
      briefly "Surgical case event outlet"
      described as {
        |Publishes surgical case events.
      }
    }
    handler SurgicalCaseSourceHandler is {
      on init is {
        let initializeSurgicalCase: type SurgicalCase.InitializeSurgicalCase = prompt("the initialize surgical case that brings this this into existence")
        tell initializeSurgicalCase to entity ORContext.SurgicalCase
      }
      on caseScheduled: event SurgicalCase.CaseScheduled is {
        send caseScheduled to outlet SurgicalCaseEvents
      }
      on surgeryCompleted: event SurgicalCase.SurgeryCompleted is {
        send surgeryCompleted to outlet SurgicalCaseEvents
      }
      on caseCancelled: event SurgicalCase.CaseCancelled is {
        send caseCancelled to outlet SurgicalCaseEvents
      }
      on other is {
        error "Unexpected message for source SurgicalCaseSource"
      }
    } with {
      briefly "Surgical case source handler"
      described as {
        |Forwards surgical case events to the outlet.
      }
    }
  } with {
    briefly "Surgical case event source"
    described as {
      |Source streamlet that publishes surgical case events.
    }
  }
  processor SurgicalCaseSink as sink is {
    inlet SurgicalCaseEventsIn is type SurgicalCaseEvent with {
      briefly "Surgical case event inlet"
      described as {
        |Receives surgical case events.
      }
    }
    handler SurgicalCaseSinkHandler is {
      on init is { ??? }
      on caseScheduled: event SurgicalCase.CaseScheduled is {
        tell caseScheduled to repository ORContext.SurgicalCaseRepository
      }
      on surgeryCompleted: event SurgicalCase.SurgeryCompleted is {
        tell surgeryCompleted to repository ORContext.SurgicalCaseRepository
      }
      on other is {
        error "Unexpected message for sink SurgicalCaseSink"
      }
    } with {
      briefly "Surgical case sink handler"
      described as {
        |Persists surgical case events from the inlet.
      }
    }
  } with {
    briefly "Surgical case event sink"
    described as {
      |Sink streamlet that consumes surgical case events.
    }
  }
  connector SurgicalCaseFlow is from outlet ORContext.SurgicalCaseSource.SurgicalCaseEvents to inlet ORContext.SurgicalCaseSink.SurgicalCaseEventsIn with {
    briefly "Surgical case event flow"
    described as {
      |Connects surgical case source to sink for event streaming.
    }
  }
  processor SurgicalCaseEventSplit as split is {
    inlet SurgicalCaseEventSplitIn is type SurgicalCaseEvent
    outlet SurgicalCaseEventSplitToORUtilizationProjector is type SurgicalCaseEvent
    outlet SurgicalCaseEventSplitToCaseDurationProjector is type SurgicalCaseEvent
    outlet SurgicalCaseEventSplitToTurnoverTimeProjector is type SurgicalCaseEvent
    outlet SurgicalCaseEventSplitToCancellationRateProjector is type SurgicalCaseEvent
    outlet SurgicalCaseEventSplitToFirstCaseStartProjector is type SurgicalCaseEvent

    handler SurgicalCaseEventSplitHandler is {
      on caseScheduled: event SurgicalCase.CaseScheduled is {
        send caseScheduled to outlet SurgicalCaseEventSplitToORUtilizationProjector
        send caseScheduled to outlet SurgicalCaseEventSplitToCaseDurationProjector
        send caseScheduled to outlet SurgicalCaseEventSplitToTurnoverTimeProjector
        send caseScheduled to outlet SurgicalCaseEventSplitToCancellationRateProjector
        send caseScheduled to outlet SurgicalCaseEventSplitToFirstCaseStartProjector
        tell caseScheduled to entity ORContext.SurgicalCase
      }
      on caseConfirmed: event SurgicalCase.CaseConfirmed is {
        send caseConfirmed to outlet SurgicalCaseEventSplitToORUtilizationProjector
        send caseConfirmed to outlet SurgicalCaseEventSplitToCaseDurationProjector
        send caseConfirmed to outlet SurgicalCaseEventSplitToTurnoverTimeProjector
        send caseConfirmed to outlet SurgicalCaseEventSplitToCancellationRateProjector
        send caseConfirmed to outlet SurgicalCaseEventSplitToFirstCaseStartProjector
        tell caseConfirmed to entity ORContext.SurgicalCase
      }
      on preOpStarted: event SurgicalCase.PreOpStarted is {
        send preOpStarted to outlet SurgicalCaseEventSplitToORUtilizationProjector
        send preOpStarted to outlet SurgicalCaseEventSplitToCaseDurationProjector
        send preOpStarted to outlet SurgicalCaseEventSplitToTurnoverTimeProjector
        send preOpStarted to outlet SurgicalCaseEventSplitToCancellationRateProjector
        send preOpStarted to outlet SurgicalCaseEventSplitToFirstCaseStartProjector
        tell preOpStarted to entity ORContext.SurgicalCase
      }
      on patientInOR: event SurgicalCase.PatientInOR is {
        send patientInOR to outlet SurgicalCaseEventSplitToORUtilizationProjector
        send patientInOR to outlet SurgicalCaseEventSplitToCaseDurationProjector
        send patientInOR to outlet SurgicalCaseEventSplitToTurnoverTimeProjector
        send patientInOR to outlet SurgicalCaseEventSplitToCancellationRateProjector
        send patientInOR to outlet SurgicalCaseEventSplitToFirstCaseStartProjector
        tell patientInOR to entity ORContext.SurgicalCase
      }
      on surgeryStarted: event SurgicalCase.SurgeryStarted is {
        send surgeryStarted to outlet SurgicalCaseEventSplitToORUtilizationProjector
        send surgeryStarted to outlet SurgicalCaseEventSplitToCaseDurationProjector
        send surgeryStarted to outlet SurgicalCaseEventSplitToTurnoverTimeProjector
        send surgeryStarted to outlet SurgicalCaseEventSplitToCancellationRateProjector
        send surgeryStarted to outlet SurgicalCaseEventSplitToFirstCaseStartProjector
        tell surgeryStarted to entity ORContext.SurgicalCase
      }
      on surgeryCompleted: event SurgicalCase.SurgeryCompleted is {
        send surgeryCompleted to outlet SurgicalCaseEventSplitToORUtilizationProjector
        send surgeryCompleted to outlet SurgicalCaseEventSplitToCaseDurationProjector
        send surgeryCompleted to outlet SurgicalCaseEventSplitToTurnoverTimeProjector
        send surgeryCompleted to outlet SurgicalCaseEventSplitToCancellationRateProjector
        send surgeryCompleted to outlet SurgicalCaseEventSplitToFirstCaseStartProjector
        tell surgeryCompleted to entity ORContext.SurgicalCase
      }
      on inRecovery: event SurgicalCase.InRecovery is {
        send inRecovery to outlet SurgicalCaseEventSplitToORUtilizationProjector
        send inRecovery to outlet SurgicalCaseEventSplitToCaseDurationProjector
        send inRecovery to outlet SurgicalCaseEventSplitToTurnoverTimeProjector
        send inRecovery to outlet SurgicalCaseEventSplitToCancellationRateProjector
        send inRecovery to outlet SurgicalCaseEventSplitToFirstCaseStartProjector
        tell inRecovery to entity ORContext.SurgicalCase
      }
      on dischargedFromPACU: event SurgicalCase.DischargedFromPACU is {
        send dischargedFromPACU to outlet SurgicalCaseEventSplitToORUtilizationProjector
        send dischargedFromPACU to outlet SurgicalCaseEventSplitToCaseDurationProjector
        send dischargedFromPACU to outlet SurgicalCaseEventSplitToTurnoverTimeProjector
        send dischargedFromPACU to outlet SurgicalCaseEventSplitToCancellationRateProjector
        send dischargedFromPACU to outlet SurgicalCaseEventSplitToFirstCaseStartProjector
        tell dischargedFromPACU to entity ORContext.SurgicalCase
      }
      on caseCancelled: event SurgicalCase.CaseCancelled is {
        send caseCancelled to outlet SurgicalCaseEventSplitToORUtilizationProjector
        send caseCancelled to outlet SurgicalCaseEventSplitToCaseDurationProjector
        send caseCancelled to outlet SurgicalCaseEventSplitToTurnoverTimeProjector
        send caseCancelled to outlet SurgicalCaseEventSplitToCancellationRateProjector
        send caseCancelled to outlet SurgicalCaseEventSplitToFirstCaseStartProjector
        tell caseCancelled to entity ORContext.SurgicalCase
      }
      on other is {
        error "Unexpected message for processor SurgicalCaseEventSplit"
      }
    } with {
      briefly "SurgicalCase event fan-out handler"
      described as {
        |Delivers each SurgicalCase event to all of its consumers.
      }
    }
  } with {
    briefly "SurgicalCase event fan-out"
    described as {
      |Fans SurgicalCase events out to the repository and projectors.
    }
  }
  connector 'SurgicalCaseEvent Stream' is from outlet ORContext.SurgicalCase.SurgicalCaseEvents2 to inlet ORContext.SurgicalCaseEventSplit.SurgicalCaseEventSplitIn with {
    briefly "SurgicalCase events, fanned out to storage and read models"
  }
  connector 'ORUtilizationProjector Feed' is from outlet ORContext.SurgicalCaseEventSplit.SurgicalCaseEventSplitToORUtilizationProjector to inlet ORContext.ORUtilizationProjector.ORUtilizationProjectorFromSurgicalCase with {
    briefly "SurgicalCase events feeding the ORUtilizationProjector projection"
  }
  connector 'CaseDurationProjector Feed' is from outlet ORContext.SurgicalCaseEventSplit.SurgicalCaseEventSplitToCaseDurationProjector to inlet ORContext.CaseDurationProjector.CaseDurationProjectorFromSurgicalCase with {
    briefly "SurgicalCase events feeding the CaseDurationProjector projection"
  }
  connector 'TurnoverTimeProjector Feed' is from outlet ORContext.SurgicalCaseEventSplit.SurgicalCaseEventSplitToTurnoverTimeProjector to inlet ORContext.TurnoverTimeProjector.TurnoverTimeProjectorFromSurgicalCase with {
    briefly "SurgicalCase events feeding the TurnoverTimeProjector projection"
  }
  connector 'CancellationRateProjector Feed' is from outlet ORContext.SurgicalCaseEventSplit.SurgicalCaseEventSplitToCancellationRateProjector to inlet ORContext.CancellationRateProjector.CancellationRateProjectorFromSurgicalCase with {
    briefly "SurgicalCase events feeding the CancellationRateProjector projection"
  }
  connector 'FirstCaseStartProjector Feed' is from outlet ORContext.SurgicalCaseEventSplit.SurgicalCaseEventSplitToFirstCaseStartProjector to inlet ORContext.FirstCaseStartProjector.FirstCaseStartProjectorFromSurgicalCase with {
    briefly "SurgicalCase events feeding the FirstCaseStartProjector projection"
  }
  connector 'ORUtilizationProjector Storage' is from outlet ORContext.ORUtilizationProjector.ORUtilizationProjectorToRepository to inlet ORContext.SurgicalCaseRepository.SurgicalCaseRepositoryFromORUtilizationProjector with {
    briefly "ORUtilizationProjector updates on their way to storage"
  }
} with {
  briefly "Bounded context for operating room management"
  described as {
    | The ORContext is the bounded context for surgical case
    | scheduling, perioperative workflow, and OR analytics.
  }
}
