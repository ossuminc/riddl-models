// Lab Orders - Lab Context
context LabContext as router is {
  outlet TranslationToContextPhysOut is command PhysicianNotificationService.SendCriticalAlert
  inlet TranslationToContextPhysSrc is command PhysicianNotificationService.SendCriticalAlert  connector 'TurnaroundTimeAnalytics To SpecimenRepository Storage' is from outlet LabContext.TurnaroundTimeAnalytics.TurnaroundTimeAnalyticsToSpecimenRepository to inlet LabContext.SpecimenRepository.SpecimenRepositoryFromTurnaroundTimeAnalytics with {
    briefly "TurnaroundTimeAnalytics projections on their way to SpecimenRepository"
  }
  connector 'TurnaroundTimeAnalytics To ResultRepository Storage' is from outlet LabContext.TurnaroundTimeAnalytics.TurnaroundTimeAnalyticsToResultRepository to inlet LabContext.ResultRepository.ResultRepositoryFromTurnaroundTimeAnalytics with {
    briefly "TurnaroundTimeAnalytics projections on their way to ResultRepository"
  }
  connector 'Translation To Context PhysicianNotificationService Egress' is from outlet LabContext.ToPhysicianNotificationService.TranslatedCriticalAlerts to inlet LabContext.TranslationToContextPhysSrc  inlet LabOrderCommandStreamIn is type LabOrderCommand  outlet LabOrderCommandStreamOut is type LabOrderCommand
  inlet LabOrderResultStreamIn is result LabOrder.LabOrderResult  outlet LabOrderResultStreamOut is result LabOrder.LabOrderResult
  handler LabContextBoundary is {
    on placeLabOrder: command LabOrder.PlaceLabOrder is {
      send placeLabOrder to outlet LabContext.LabOrderCommandStreamOut
    }
    on collectSpecimen: command LabOrder.CollectSpecimen is {
      send collectSpecimen to outlet LabContext.LabOrderCommandStreamOut
    }
    on receiveSpecimen: command LabOrder.ReceiveSpecimen is {
      send receiveSpecimen to outlet LabContext.LabOrderCommandStreamOut
    }
    on startTesting: command LabOrder.StartTesting is {
      send startTesting to outlet LabContext.LabOrderCommandStreamOut
    }
    on recordResult: command LabOrder.RecordResult is {
      send recordResult to outlet LabContext.LabOrderCommandStreamOut
    }
    on verifyResult: command LabOrder.VerifyResult is {
      send verifyResult to outlet LabContext.LabOrderCommandStreamOut
    }
    on reportCriticalValue: command LabOrder.ReportCriticalValue is {
      send reportCriticalValue to outlet LabContext.LabOrderCommandStreamOut
    }
    on cancelOrder: command LabOrder.CancelOrder is {
      send cancelOrder to outlet LabContext.LabOrderCommandStreamOut
    }
    on labOrderResult: result LabOrder.LabOrderResult is {
      send labOrderResult to outlet LabContext.LabOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the LabContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'LabOrderCommand Stream Intake' is from outlet LabContext.LabOrderCommandStreamOut to inlet LabContext.LabOrder.LabOrderCommands  connector 'LabOrderResult Stream Egress' is from outlet LabContext.LabOrderRepository.LabOrderRepositoryResponses to inlet LabContext.LabOrderResultStreamIn  adaptor FromEHRIntegration from context EHRIntegration is { 
    handler FromEHRIntegrationHandler is {
      on event EHRIntegration.OrderReceived is {
        do "the model receives order received"
      }
      on result EHRIntegration.PatientOrderHistory is {
        do "the model receives patient order history"
      }
      on event EHRIntegration.ResultDelivered is {
        do "the model receives result delivered"
      }
      on other is {
        error "Unexpected message for adaptor FromEHRIntegration"
      }
    } with {
      briefly "from ehr integration"
      described as {
        |Carries messages from the external EHRIntegration.
      }
    }
  } with {
    briefly "EHRIntegration integration"
    described as {
      |The model's side of the EHRIntegration conversation.
    }
  }
  adaptor ToEHRIntegration to context EHRIntegration is { 
    handler ToEHRIntegrationHandler is {
      on command EHRIntegration.DeliverResult is {
        do "the model sends deliver result"
      }
      on query EHRIntegration.GetPatientOrders is {
        do "the model sends get patient orders"
      }
      on command EHRIntegration.SubmitLabOrder is {
        do "the model sends submit lab order"
      }
      on other is {
        error "Unexpected message for adaptor ToEHRIntegration"
      }
    } with {
      briefly "to ehr integration"
      described as {
        |Carries messages to the external EHRIntegration.
      }
    }
  } with {
    briefly "EHRIntegration integration"
    described as {
      |The model's side of the EHRIntegration conversation.
    }
  }
  adaptor FromInsuranceVerification from context InsuranceVerification is { 
    handler FromInsuranceVerificationHandler is {
      on event InsuranceVerification.CoverageVerified is {
        do "the model receives coverage verified"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceVerification"
      }
    } with {
      briefly "from insurance verification"
      described as {
        |Carries messages from the external InsuranceVerification.
      }
    }
  } with {
    briefly "InsuranceVerification integration"
    described as {
      |The model's side of the InsuranceVerification conversation.
    }
  }
  adaptor ToInsuranceVerification to context InsuranceVerification is { 
    handler ToInsuranceVerificationHandler is {
      on command InsuranceVerification.VerifyLabCoverage is {
        do "the model sends verify lab coverage"
      }
      on other is {
        error "Unexpected message for adaptor ToInsuranceVerification"
      }
    } with {
      briefly "to insurance verification"
      described as {
        |Carries messages to the external InsuranceVerification.
      }
    }
  } with {
    briefly "InsuranceVerification integration"
    described as {
      |The model's side of the InsuranceVerification conversation.
    }
  }
  adaptor FromLabBillingService from context LabBillingService is { 
    handler FromLabBillingServiceHandler is {
      on event LabBillingService.ChargeSubmitted is {
        do "the model receives charge submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromLabBillingService"
      }
    } with {
      briefly "from lab billing service"
      described as {
        |Carries messages from the external LabBillingService.
      }
    }
  } with {
    briefly "LabBillingService integration"
    described as {
      |The model's side of the LabBillingService conversation.
    }
  }
  adaptor ToLabBillingService to context LabBillingService is { 
    handler ToLabBillingServiceHandler is {
      on command LabBillingService.SubmitLabCharge is {
        do "the model sends submit lab charge"
      }
      on other is {
        error "Unexpected message for adaptor ToLabBillingService"
      }
    } with {
      briefly "to lab billing service"
      described as {
        |Carries messages to the external LabBillingService.
      }
    }
  } with {
    briefly "LabBillingService integration"
    described as {
      |The model's side of the LabBillingService conversation.
    }
  }
  adaptor FromLaboratoryInstrumentInterface from context LaboratoryInstrumentInterface is { 
    handler FromLaboratoryInstrumentInterfaceHandler is {
      on event LaboratoryInstrumentInterface.AnalyzerError is {
        do "the model receives analyzer error"
      }
      on event LaboratoryInstrumentInterface.AnalyzerResultReceived is {
        do "the model receives analyzer result received"
      }
      on other is {
        error "Unexpected message for adaptor FromLaboratoryInstrumentInterface"
      }
    } with {
      briefly "from laboratory instrument interface"
      described as {
        |Carries messages from the external LaboratoryInstrumentInterface.
      }
    }
  } with {
    briefly "LaboratoryInstrumentInterface integration"
    described as {
      |The model's side of the LaboratoryInstrumentInterface conversation.
    }
  }
  adaptor ToLaboratoryInstrumentInterface to context LaboratoryInstrumentInterface is { 
    handler ToLaboratoryInstrumentInterfaceHandler is {
      on command LaboratoryInstrumentInterface.RequestAnalyzerResult is {
        do "the model sends request analyzer result"
      }
      on command LaboratoryInstrumentInterface.SendToAnalyzer is {
        do "the model sends send to analyzer"
      }
      on other is {
        error "Unexpected message for adaptor ToLaboratoryInstrumentInterface"
      }
    } with {
      briefly "to laboratory instrument interface"
      described as {
        |Carries messages to the external LaboratoryInstrumentInterface.
      }
    }
  } with {
    briefly "LaboratoryInstrumentInterface integration"
    described as {
      |The model's side of the LaboratoryInstrumentInterface conversation.
    }
  }
  adaptor FromPhysicianNotificationService from context PhysicianNotificationService is { 
    handler FromPhysicianNotificationServiceHandler is {
      on event PhysicianNotificationService.CriticalAlertAcknowledged is {
        do "the model receives critical alert acknowledged"
      }
      on event PhysicianNotificationService.CriticalAlertSent is {
        do "the model receives critical alert sent"
      }
      on event PhysicianNotificationService.ReadBackRecorded is {
        do "the model receives read back recorded"
      }
      on other is {
        error "Unexpected message for adaptor FromPhysicianNotificationService"
      }
    } with {
      briefly "from physician notification service"
      described as {
        |Carries messages from the external PhysicianNotificationService.
      }
    }
  } with {
    briefly "PhysicianNotificationService integration"
    described as {
      |The model's side of the PhysicianNotificationService conversation.
    }
  }
  adaptor ToPhysicianNotificationService to context PhysicianNotificationService as flow is { 
    inlet OutgoingCriticalAlerts is command PhysicianNotificationService.SendCriticalAlert    outlet TranslatedCriticalAlerts is command PhysicianNotificationService.SendCriticalAlert
    handler ToPhysicianNotificationServiceHandler is {
      on sendCriticalAlert: command PhysicianNotificationService.SendCriticalAlert is {
        send sendCriticalAlert to outlet TranslatedCriticalAlerts
      }
      on command PhysicianNotificationService.RecordReadBack is {
        do "the model sends record read back"
      }
      on command PhysicianNotificationService.SendResultNotification is {
        do "the model sends send result notification"
      }
      on other is {
        error "Unexpected message for adaptor ToPhysicianNotificationService"
      }
    } with {
      briefly "to physician notification service"
      described as {
        |Carries messages to the external PhysicianNotificationService.
      }
    }
  } with {
    briefly "PhysicianNotificationService integration"
    described as {
      |The model's side of the PhysicianNotificationService conversation.
    }
  }
  include "types.riddl"
  include "LabOrder.riddl"
  // Repository for lab order persistence
  type LabOrderRepositoryCommand is one of {
    LabContext.LabOrderRepository.PersistLabOrderPlaced or LabContext.LabOrderRepository.PersistTestingStarted or LabContext.LabOrderRepository.PersistOrderCancelled
  } with {
    briefly "Anything that writes LabOrderRepository"
    described as {
      |The persistence commands LabOrderRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository LabOrderRepository as flow is {
    inlet LabOrderRepositoryFromTurnaroundTimeAnalytics is type LabOrderRepositoryCommand    command PersistTestingStarted is {
      orderId: LabOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row TestingStarted applies to.
        }
      }
    } with {
      briefly "Persist TestingStarted"
      described as {
        |Instructs this repository to apply TestingStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLabOrderPlaced is {
      orderId: LabOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row LabOrderPlaced applies to.
        }
      }
    } with {
      briefly "Persist LabOrderPlaced"
      described as {
        |Instructs this repository to apply LabOrderPlaced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderCancelled is {
      orderId: LabOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCancelled applies to.
        }
      }
    } with {
      briefly "Persist OrderCancelled"
      described as {
        |Instructs this repository to apply OrderCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet LabOrderRepositoryResponses is result LabOrder.LabOrderResult
    record StoredLabOrder is {
      labOrderId: LabOrderId with {
        briefly "labOrderId"
        described as {
          |The labOrderId column of the stored labOrder row.
        }
      }
      orderId: LabOrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored labOrder row.
        }
      }
      patient: PatientInfo with {
        briefly "patient"
        described as {
          |The patient column of the stored labOrder row.
        }
      }
      specimen: SpecimenInfo with {
        briefly "specimen"
        described as {
          |The specimen column of the stored labOrder row.
        }
      }
    } with {
      briefly "Stored labOrder row"
      described as {
        |The persistence shape of labOrder data as this repository stores it.
      }
    }
    schema LabOrderData is relational
      of labOrders as record StoredLabOrder
        index on field StoredLabOrder.orderId
        index on field StoredLabOrder.patient.patientId
        index on field StoredLabOrder.specimen.specimenId
 with {
      briefly "Lab order data schema"
      described as {
        |The relational schema holding lab order data for the LabOrderRepository.
      }
    }
    handler LabOrderPersistence is {
      on persistTestingStarted: command PersistTestingStarted is {
        do "apply TestingStarted to the stored row"
      }
      on persistLabOrderPlaced: command PersistLabOrderPlaced is {
        do "apply LabOrderPlaced to the stored row"
      }
      on persistOrderCancelled: command PersistOrderCancelled is {
        do "apply OrderCancelled to the stored row"
      }
      on query GetTATMetrics is {
        let tATMetricsView: type TATMetricsView = prompt("read the tat metrics projection")
        reply tATMetricsView
      }
      on query GetVolumeMetrics is {
        let volumeMetricsView: type VolumeMetricsView = prompt("read the volume metrics projection")
        reply volumeMetricsView
      }
      on query GetCriticalValueMetrics is {
        let criticalValueMetricsView: type CriticalValueMetricsView = prompt("read the critical value metrics projection")
        reply criticalValueMetricsView
      }
    } with {
      briefly "Persists lab order events"
      described as {
        |Handles command-driven persistence for laboratory orders.
      }
    }
  } with {
    briefly "Lab order data persistence"
    described as {
      | The LabOrderRepository provides persistent storage for
      | laboratory orders, specimens, and test results.
    }
  }
  // Repository for specimen tracking
  type SpecimenRepositoryCommand is one of {
    LabContext.SpecimenRepository.PersistSpecimenCollected or LabContext.SpecimenRepository.PersistSpecimenReceived
  } with {
    briefly "Anything that writes the SpecimenRepository"
    described as {
      |The persistence commands SpecimenRepository accepts. Lab order events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository SpecimenRepository as sink is {
    inlet SpecimenRepositoryFromTurnaroundTimeAnalytics is type SpecimenRepositoryCommand    command PersistSpecimenCollected is {
      orderId: LabOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row SpecimenCollected applies to.
        }
      }
    } with {
      briefly "Persist SpecimenCollected"
      described as {
        |Instructs this repository to apply SpecimenCollected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSpecimenReceived is {
      orderId: LabOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row SpecimenReceived applies to.
        }
      }
    } with {
      briefly "Persist SpecimenReceived"
      described as {
        |Instructs this repository to apply SpecimenReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    schema SpecimenData is relational
      of specimens as type SpecimenInfo
        index on field SpecimenInfo.specimenId
        index on field SpecimenInfo.collectedAt
 with {
      briefly "Specimen data schema"
      described as {
        |The relational schema holding specimen data for the SpecimenRepository.
      }
    }
    handler SpecimenPersistence is {
      on persistSpecimenCollected: command PersistSpecimenCollected is {
        do "apply SpecimenCollected to the stored row"
      }
      on persistSpecimenReceived: command PersistSpecimenReceived is {
        do "apply SpecimenReceived to the stored row"
      }
    } with {
      briefly "Persists specimen data"
      described as {
        |Handles specimen tracking persistence.
      }
    }
  } with {
    briefly "Specimen data persistence"
    described as {
      |Repository for tracking specimen lifecycle.
    }
  }
  // Repository for test results
  type ResultRepositoryCommand is one of {
    LabContext.ResultRepository.PersistResultRecorded or LabContext.ResultRepository.PersistResultVerified or LabContext.ResultRepository.PersistCriticalValueReported
  } with {
    briefly "Anything that writes the ResultRepository"
    described as {
      |The persistence commands ResultRepository accepts. Lab order events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ResultRepository as sink is {
    inlet ResultRepositoryFromTurnaroundTimeAnalytics is type ResultRepositoryCommand    command PersistResultRecorded is {
      orderId: LabOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row ResultRecorded applies to.
        }
      }
    } with {
      briefly "Persist ResultRecorded"
      described as {
        |Instructs this repository to apply ResultRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistResultVerified is {
      orderId: LabOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row ResultVerified applies to.
        }
      }
    } with {
      briefly "Persist ResultVerified"
      described as {
        |Instructs this repository to apply ResultVerified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCriticalValueReported is {
      orderId: LabOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row CriticalValueReported applies to.
        }
      }
    } with {
      briefly "Persist CriticalValueReported"
      described as {
        |Instructs this repository to apply CriticalValueReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    schema ResultData is relational
      of results as type TestResult
        index on field TestResult.resultId
        index on field TestResult.testId
        index on field TestResult.performedAt
 with {
      briefly "Result data schema"
      described as {
        |The relational schema holding result data for the ResultRepository.
      }
    }
    handler ResultPersistence is {
      on persistResultRecorded: command PersistResultRecorded is {
        do "apply ResultRecorded to the stored row"
      }
      on persistResultVerified: command PersistResultVerified is {
        do "apply ResultVerified to the stored row"
      }
      on persistCriticalValueReported: command PersistCriticalValueReported is {
        do "apply CriticalValueReported to the stored row"
      }
    } with {
      briefly "Persists result data"
      described as {
        |Handles test result persistence.
      }
    }
  } with {
    briefly "Result data persistence"
    described as {
      |Repository for storing and querying test results.
    }
  }
  // Projector for turnaround time analytics
  query GetTATMetrics replies result TATMetricsView is {
    tATMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which tat metrics to retrieve.
      }
    }
  } with {
    briefly "Get tat metrics"
    described as {
      |Retrieves the tat metrics projection.
    }
  }
  result TATMetricsView is {
    tATMetrics: TurnaroundTimeAnalytics.TATMetrics with {
      briefly "Tat metrics"
      described as {
        |The tat metrics being returned.
      }
    }
  } with {
    briefly "Tat metrics view"
    described as {
      |Read model view carrying the tat metrics projection.
    }
  }
  projector TurnaroundTimeAnalytics as split is {
    updates repository LabContext.LabOrderRepository
    outlet TurnaroundTimeAnalyticsToRepository is type LabOrderRepositoryCommand
    outlet TurnaroundTimeAnalyticsToSpecimenRepository is type SpecimenRepositoryCommand
    outlet TurnaroundTimeAnalyticsToResultRepository is type ResultRepositoryCommand
    inlet TurnaroundTimeAnalyticsFromLabOrder is type LabOrderEvent    record TATMetrics is {
      testCode: String(1,20) with {
        briefly "Test"
        described as {
          |Test code.
        }
      }
      avgCollectionToReceipt: Duration with {
        briefly "Collect-to-receipt"
        described as {
          |Average time from collection to lab receipt.
        }
      }
      avgReceiptToResult: Duration with {
        briefly "Receipt-to-result"
        described as {
          |Average time from receipt to result.
        }
      }
      avgResultToVerify: Duration with {
        briefly "Result-to-verify"
        described as {
          |Average time from result to verification.
        }
      }
      totalTAT: Duration with {
        briefly "Total TAT"
        described as {
          |Total turnaround time.
        }
      }
      percentOnTarget: Decimal(5,2) with {
        briefly "On target %"
        described as {
          |Percentage meeting TAT target.
        }
      }
      sampleSize: Natural with {
        briefly "Sample size"
        described as {
          |Number of orders in calculation.
        }
      }
      calculatedAt: TimeStamp with {
        briefly "Calculated"
        described as {
          |Calculation timestamp.
        }
      }
    } with {
      briefly "TAT metrics"
      described as {
        |Turnaround time performance metrics.
      }
    }
    handler TATHandler is {
      on criticalValueReported: event LabOrder.CriticalValueReported is {
        tell command LabContext.ResultRepository.PersistCriticalValueReported(orderId = criticalValueReported.orderId) to repository LabContext.ResultRepository
        do "apply CriticalValueReported to the TurnaroundTimeAnalytics projection"
      }
      on orderCancelled: event LabOrder.OrderCancelled is {
        tell command LabContext.LabOrderRepository.PersistOrderCancelled(orderId = orderCancelled.orderId) to repository LabContext.LabOrderRepository
        do "apply OrderCancelled to the TurnaroundTimeAnalytics projection"
      }
      on testingStarted: event LabOrder.TestingStarted is {
        tell command LabContext.LabOrderRepository.PersistTestingStarted(orderId = testingStarted.orderId) to repository LabContext.LabOrderRepository
        do "apply TestingStarted to the TurnaroundTimeAnalytics projection"
      }
      on labOrderPlaced: event LabOrder.LabOrderPlaced is {
        tell command LabContext.LabOrderRepository.PersistLabOrderPlaced(orderId = labOrderPlaced.orderId) to repository LabContext.LabOrderRepository
      }
      on specimenCollected: event LabOrder.SpecimenCollected is {
        tell command LabContext.SpecimenRepository.PersistSpecimenCollected(orderId = specimenCollected.orderId) to repository LabContext.SpecimenRepository
      }
      on specimenReceived: event LabOrder.SpecimenReceived is {
        tell command LabContext.SpecimenRepository.PersistSpecimenReceived(orderId = specimenReceived.orderId) to repository LabContext.SpecimenRepository
      }
      on resultRecorded: event LabOrder.ResultRecorded is {
        tell command LabContext.ResultRepository.PersistResultRecorded(orderId = resultRecorded.orderId) to repository LabContext.ResultRepository
      }
      on resultVerified: event LabOrder.ResultVerified is {
        tell command LabContext.ResultRepository.PersistResultVerified(orderId = resultVerified.orderId) to repository LabContext.ResultRepository
      }
    } with {
      briefly "Maintains TAT analytics"
      described as {
        |Projects events into turnaround time metrics.
      }
    }
  } with {
    briefly "Turnaround time projections"
    described as {
      |Maintains laboratory turnaround time analytics.
    }
  }
  // Projector for volume metrics
  query GetVolumeMetrics replies result VolumeMetricsView is {
    volumeMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which volume metrics to retrieve.
      }
    }
  } with {
    briefly "Get volume metrics"
    described as {
      |Retrieves the volume metrics projection.
    }
  }
  result VolumeMetricsView is {
    volumeMetrics: VolumeAnalytics.VolumeMetrics with {
      briefly "Volume metrics"
      described as {
        |The volume metrics being returned.
      }
    }
  } with {
    briefly "Volume metrics view"
    described as {
      |Read model view carrying the volume metrics projection.
    }
  }
  projector VolumeAnalytics as sink is {
    updates repository LabContext.LabOrderRepository
    inlet VolumeAnalyticsFromLabOrder is type LabOrderEvent    record VolumeMetrics is {
      period: String(1,20) with {
        briefly "Period"
        described as {
          |Time period (hourly, daily, weekly).
        }
      }
      periodStart: TimeStamp with {
        briefly "Start"
        described as {
          |Period start time.
        }
      }
      totalOrders: Natural with {
        briefly "Total orders"
        described as {
          |Orders placed.
        }
      }
      totalSpecimens: Natural with {
        briefly "Total specimens"
        described as {
          |Specimens collected.
        }
      }
      totalResults: Natural with {
        briefly "Total results"
        described as {
          |Results recorded.
        }
      }
      ordersByPriority: String(1,100)+ with {
        briefly "By priority"
        described as {
          |Counts by priority.
        }
      }
      ordersByDepartment: String(1,100)+ with {
        briefly "By department"
        described as {
          |Counts by ordering department.
        }
      }
      testsByType: String(1,100)+ with {
        briefly "By test type"
        described as {
          |Counts by test code.
        }
      }
      cancelRate: Decimal(5,4) with {
        briefly "Cancel rate"
        described as {
          |Order cancellation rate.
        }
      }
    } with {
      briefly "Volume metrics"
      described as {
        |Laboratory volume and workload metrics.
      }
    }
    handler VolumeHandler is {
      on criticalValueReported: event LabOrder.CriticalValueReported is {
        tell command LabContext.ResultRepository.PersistCriticalValueReported(orderId = criticalValueReported.orderId) to repository LabContext.ResultRepository
        do "apply CriticalValueReported to the VolumeAnalytics projection"
      }
      on resultVerified: event LabOrder.ResultVerified is {
        tell command LabContext.ResultRepository.PersistResultVerified(orderId = resultVerified.orderId) to repository LabContext.ResultRepository
        do "apply ResultVerified to the VolumeAnalytics projection"
      }
      on specimenReceived: event LabOrder.SpecimenReceived is {
        tell command LabContext.SpecimenRepository.PersistSpecimenReceived(orderId = specimenReceived.orderId) to repository LabContext.SpecimenRepository
        do "apply SpecimenReceived to the VolumeAnalytics projection"
      }
      on testingStarted: event LabOrder.TestingStarted is {
        tell command LabContext.LabOrderRepository.PersistTestingStarted(orderId = testingStarted.orderId) to repository LabContext.LabOrderRepository
        do "apply TestingStarted to the VolumeAnalytics projection"
      }
      on labOrderPlaced: event LabOrder.LabOrderPlaced is {
        tell command LabContext.LabOrderRepository.PersistLabOrderPlaced(orderId = labOrderPlaced.orderId) to repository LabContext.LabOrderRepository
      }
      on specimenCollected: event LabOrder.SpecimenCollected is {
        tell command LabContext.SpecimenRepository.PersistSpecimenCollected(orderId = specimenCollected.orderId) to repository LabContext.SpecimenRepository
      }
      on resultRecorded: event LabOrder.ResultRecorded is {
        tell command LabContext.ResultRepository.PersistResultRecorded(orderId = resultRecorded.orderId) to repository LabContext.ResultRepository
      }
      on orderCancelled: event LabOrder.OrderCancelled is {
        tell command LabContext.LabOrderRepository.PersistOrderCancelled(orderId = orderCancelled.orderId) to repository LabContext.LabOrderRepository
      }
    } with {
      briefly "Maintains volume analytics"
      described as {
        |Projects events into volume metrics.
      }
    }
  } with {
    briefly "Volume projections"
    described as {
      |Maintains laboratory volume and workload analytics.
    }
  }
  // Projector for critical value tracking
  query GetCriticalValueMetrics replies result CriticalValueMetricsView is {
    criticalValueMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which critical value metrics to retrieve.
      }
    }
  } with {
    briefly "Get critical value metrics"
    described as {
      |Retrieves the critical value metrics projection.
    }
  }
  result CriticalValueMetricsView is {
    criticalValueMetrics: CriticalValueTracking.CriticalValueMetrics with {
      briefly "Critical value metrics"
      described as {
        |The critical value metrics being returned.
      }
    }
  } with {
    briefly "Critical value metrics view"
    described as {
      |Read model view carrying the critical value metrics projection.
    }
  }
  projector CriticalValueTracking as sink is {
    updates repository LabContext.LabOrderRepository
    inlet CriticalValueTrackingFromLabOrder is type LabOrderEvent    record CriticalValueMetrics is {
      period: String(1,20) with {
        briefly "Period"
        described as {
          |Time period.
        }
      }
      periodStart: TimeStamp with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      totalCriticals: Natural with {
        briefly "Total criticals"
        described as {
          |Critical values reported.
        }
      }
      avgNotificationTime: Duration with {
        briefly "Avg notification"
        described as {
          |Average time to notify provider.
        }
      }
      readBackRate: Decimal(5,4) with {
        briefly "Read-back rate"
        described as {
          |Read-back confirmation rate.
        }
      }
      criticalsByTest: String(1,100)+ with {
        briefly "By test"
        described as {
          |Criticals by test type.
        }
      }
      criticalsByUnit: String(1,100)+ with {
        briefly "By unit"
        described as {
          |Criticals by nursing unit.
        }
      }
    } with {
      briefly "Critical value metrics"
      described as {
        |Critical value reporting performance metrics.
      }
    }
    handler CriticalValueHandler is {
      on labOrderPlaced: event LabOrder.LabOrderPlaced is {
        tell command LabContext.LabOrderRepository.PersistLabOrderPlaced(orderId = labOrderPlaced.orderId) to repository LabContext.LabOrderRepository
        do "apply LabOrderPlaced to the CriticalValueTracking projection"
      }
      on orderCancelled: event LabOrder.OrderCancelled is {
        tell command LabContext.LabOrderRepository.PersistOrderCancelled(orderId = orderCancelled.orderId) to repository LabContext.LabOrderRepository
        do "apply OrderCancelled to the CriticalValueTracking projection"
      }
      on resultRecorded: event LabOrder.ResultRecorded is {
        tell command LabContext.ResultRepository.PersistResultRecorded(orderId = resultRecorded.orderId) to repository LabContext.ResultRepository
        do "apply ResultRecorded to the CriticalValueTracking projection"
      }
      on resultVerified: event LabOrder.ResultVerified is {
        tell command LabContext.ResultRepository.PersistResultVerified(orderId = resultVerified.orderId) to repository LabContext.ResultRepository
        do "apply ResultVerified to the CriticalValueTracking projection"
      }
      on specimenCollected: event LabOrder.SpecimenCollected is {
        tell command LabContext.SpecimenRepository.PersistSpecimenCollected(orderId = specimenCollected.orderId) to repository LabContext.SpecimenRepository
        do "apply SpecimenCollected to the CriticalValueTracking projection"
      }
      on specimenReceived: event LabOrder.SpecimenReceived is {
        tell command LabContext.SpecimenRepository.PersistSpecimenReceived(orderId = specimenReceived.orderId) to repository LabContext.SpecimenRepository
        do "apply SpecimenReceived to the CriticalValueTracking projection"
      }
      on testingStarted: event LabOrder.TestingStarted is {
        tell command LabContext.LabOrderRepository.PersistTestingStarted(orderId = testingStarted.orderId) to repository LabContext.LabOrderRepository
        do "apply TestingStarted to the CriticalValueTracking projection"
      }
      on criticalValueReported: event LabOrder.CriticalValueReported is {
        tell command LabContext.ResultRepository.PersistCriticalValueReported(orderId = criticalValueReported.orderId) to repository LabContext.ResultRepository
      }
    } with {
      briefly "Maintains critical value analytics"
      described as {
        |Projects events into critical value tracking metrics.
      }
    }
  } with {
    briefly "Critical value projections"
    described as {
      |Maintains critical value reporting analytics and compliance metrics.
    }
  }
  type LabOrderEvent is one of {
    LabContext.LabOrder.LabOrderPlaced or LabContext.LabOrder.SpecimenCollected or LabContext.LabOrder.SpecimenReceived or LabContext.LabOrder.TestingStarted or LabContext.LabOrder.ResultRecorded or LabContext.LabOrder.ResultVerified or LabContext.LabOrder.CriticalValueReported or LabContext.LabOrder.OrderCancelled
  } with {
    briefly "Lab order events"
    described as {
      |Union of all lab order entity events for streaming.
    }
  }
  streamlet LabOrderEventSplit as split is {
    inlet LabOrderEventSplitIn is type LabOrderEvent    outlet LabOrderEventSplitToTurnaroundTimeAnalytics is type LabOrderEvent
    outlet LabOrderEventSplitToVolumeAnalytics is type LabOrderEvent
    outlet LabOrderEventSplitToCriticalValueTracking is type LabOrderEvent
    handler LabOrderEventSplitHandler is {
      on labOrderPlaced: event LabOrder.LabOrderPlaced is {
        send labOrderPlaced to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send labOrderPlaced to outlet LabOrderEventSplitToVolumeAnalytics
        send labOrderPlaced to outlet LabOrderEventSplitToCriticalValueTracking
        tell labOrderPlaced to entity LabContext.LabOrder
      }
      on specimenCollected: event LabOrder.SpecimenCollected is {
        send specimenCollected to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send specimenCollected to outlet LabOrderEventSplitToVolumeAnalytics
        send specimenCollected to outlet LabOrderEventSplitToCriticalValueTracking
        tell specimenCollected to entity LabContext.LabOrder
      }
      on specimenReceived: event LabOrder.SpecimenReceived is {
        send specimenReceived to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send specimenReceived to outlet LabOrderEventSplitToVolumeAnalytics
        send specimenReceived to outlet LabOrderEventSplitToCriticalValueTracking
        tell specimenReceived to entity LabContext.LabOrder
      }
      on testingStarted: event LabOrder.TestingStarted is {
        send testingStarted to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send testingStarted to outlet LabOrderEventSplitToVolumeAnalytics
        send testingStarted to outlet LabOrderEventSplitToCriticalValueTracking
        tell testingStarted to entity LabContext.LabOrder
      }
      on resultRecorded: event LabOrder.ResultRecorded is {
        send resultRecorded to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send resultRecorded to outlet LabOrderEventSplitToVolumeAnalytics
        send resultRecorded to outlet LabOrderEventSplitToCriticalValueTracking
        tell resultRecorded to entity LabContext.LabOrder
      }
      on resultVerified: event LabOrder.ResultVerified is {
        send resultVerified to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send resultVerified to outlet LabOrderEventSplitToVolumeAnalytics
        send resultVerified to outlet LabOrderEventSplitToCriticalValueTracking
        tell resultVerified to entity LabContext.LabOrder
      }
      on criticalValueReported: event LabOrder.CriticalValueReported is {
        send criticalValueReported to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send criticalValueReported to outlet LabOrderEventSplitToVolumeAnalytics
        send criticalValueReported to outlet LabOrderEventSplitToCriticalValueTracking
        tell criticalValueReported to entity LabContext.LabOrder
      }
      on orderCancelled: event LabOrder.OrderCancelled is {
        send orderCancelled to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send orderCancelled to outlet LabOrderEventSplitToVolumeAnalytics
        send orderCancelled to outlet LabOrderEventSplitToCriticalValueTracking
        tell orderCancelled to entity LabContext.LabOrder
      }
      on other is {
        error "Unexpected message for processor LabOrderEventSplit"
      }
    } with {
      briefly "LabOrder event fan-out handler"
      described as {
        |Delivers each LabOrder event to all of its consumers.
      }
    }
  } with {
    briefly "LabOrder event fan-out"
    described as {
      |Fans LabOrder events out to the repository and projectors.
    }
  }
  connector 'LabOrderEvent Stream' is from outlet LabContext.LabOrder.LabOrderEvents2 to inlet LabContext.LabOrderEventSplit.LabOrderEventSplitIn with {
    briefly "LabOrder events, fanned out to storage and read models"
  }
  connector 'TurnaroundTimeAnalytics Feed' is from outlet LabContext.LabOrderEventSplit.LabOrderEventSplitToTurnaroundTimeAnalytics to inlet LabContext.TurnaroundTimeAnalytics.TurnaroundTimeAnalyticsFromLabOrder with {
    briefly "LabOrder events feeding the TurnaroundTimeAnalytics projection"
  }
  connector 'VolumeAnalytics Feed' is from outlet LabContext.LabOrderEventSplit.LabOrderEventSplitToVolumeAnalytics to inlet LabContext.VolumeAnalytics.VolumeAnalyticsFromLabOrder with {
    briefly "LabOrder events feeding the VolumeAnalytics projection"
  }
  connector 'CriticalValueTracking Feed' is from outlet LabContext.LabOrderEventSplit.LabOrderEventSplitToCriticalValueTracking to inlet LabContext.CriticalValueTracking.CriticalValueTrackingFromLabOrder with {
    briefly "LabOrder events feeding the CriticalValueTracking projection"
  }
  connector 'SendCriticalAlert Stream' is from outlet LabContext.LabOrder.LabOrderToPhysicianNotification to inlet LabContext.ToPhysicianNotificationService.OutgoingCriticalAlerts with {
    briefly "Critical alerts from the lab order to its adaptor"
  }
  connector 'TurnaroundTimeAnalytics Storage' is from outlet LabContext.TurnaroundTimeAnalytics.TurnaroundTimeAnalyticsToRepository to inlet LabContext.LabOrderRepository.LabOrderRepositoryFromTurnaroundTimeAnalytics with {
    briefly "TurnaroundTimeAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for laboratory orders"
  described as {
    | The LabContext is the bounded context for laboratory
    | order management, specimen tracking, result processing,
    | and analytics including TAT and critical value monitoring.
  }
}
