// Lab Orders - Lab Context
context LabContext is {
  adaptor FromEHRIntegration from context EHRIntegration is { 
    handler FromEHRIntegrationHandler is {
      on event EHRIntegration.OrderReceived is {
        do "the model receives order received"
      }
      on result EHRIntegration.PatientOrderHistory is {
        do "the model receives patient order history"
      }
      on event EHRIntegration.ResultDelivered is {
        do "the model receives result delivered"
      }
      on other is {
        error "Unexpected message for adaptor FromEHRIntegration"
      }
    } with {
      briefly "from ehr integration"
      described as {
        |Carries messages from the external EHRIntegration.
      }
    }
  } with {
    briefly "EHRIntegration integration"
    described as {
      |The model's side of the EHRIntegration conversation.
    }
  }
  adaptor ToEHRIntegration to context EHRIntegration is { 
    handler ToEHRIntegrationHandler is {
      on command EHRIntegration.DeliverResult is {
        do "the model sends deliver result"
      }
      on query EHRIntegration.GetPatientOrders is {
        do "the model sends get patient orders"
      }
      on command EHRIntegration.SubmitLabOrder is {
        do "the model sends submit lab order"
      }
      on other is {
        error "Unexpected message for adaptor ToEHRIntegration"
      }
    } with {
      briefly "to ehr integration"
      described as {
        |Carries messages to the external EHRIntegration.
      }
    }
  } with {
    briefly "EHRIntegration integration"
    described as {
      |The model's side of the EHRIntegration conversation.
    }
  }
  adaptor FromInsuranceVerification from context InsuranceVerification is { 
    handler FromInsuranceVerificationHandler is {
      on event InsuranceVerification.CoverageVerified is {
        do "the model receives coverage verified"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceVerification"
      }
    } with {
      briefly "from insurance verification"
      described as {
        |Carries messages from the external InsuranceVerification.
      }
    }
  } with {
    briefly "InsuranceVerification integration"
    described as {
      |The model's side of the InsuranceVerification conversation.
    }
  }
  adaptor ToInsuranceVerification to context InsuranceVerification is { 
    handler ToInsuranceVerificationHandler is {
      on command InsuranceVerification.VerifyLabCoverage is {
        do "the model sends verify lab coverage"
      }
      on other is {
        error "Unexpected message for adaptor ToInsuranceVerification"
      }
    } with {
      briefly "to insurance verification"
      described as {
        |Carries messages to the external InsuranceVerification.
      }
    }
  } with {
    briefly "InsuranceVerification integration"
    described as {
      |The model's side of the InsuranceVerification conversation.
    }
  }
  adaptor FromLabBillingService from context LabBillingService is { 
    handler FromLabBillingServiceHandler is {
      on event LabBillingService.ChargeSubmitted is {
        do "the model receives charge submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromLabBillingService"
      }
    } with {
      briefly "from lab billing service"
      described as {
        |Carries messages from the external LabBillingService.
      }
    }
  } with {
    briefly "LabBillingService integration"
    described as {
      |The model's side of the LabBillingService conversation.
    }
  }
  adaptor ToLabBillingService to context LabBillingService is { 
    handler ToLabBillingServiceHandler is {
      on command LabBillingService.SubmitLabCharge is {
        do "the model sends submit lab charge"
      }
      on other is {
        error "Unexpected message for adaptor ToLabBillingService"
      }
    } with {
      briefly "to lab billing service"
      described as {
        |Carries messages to the external LabBillingService.
      }
    }
  } with {
    briefly "LabBillingService integration"
    described as {
      |The model's side of the LabBillingService conversation.
    }
  }
  adaptor FromLaboratoryInstrumentInterface from context LaboratoryInstrumentInterface is { 
    handler FromLaboratoryInstrumentInterfaceHandler is {
      on event LaboratoryInstrumentInterface.AnalyzerError is {
        do "the model receives analyzer error"
      }
      on event LaboratoryInstrumentInterface.AnalyzerResultReceived is {
        do "the model receives analyzer result received"
      }
      on other is {
        error "Unexpected message for adaptor FromLaboratoryInstrumentInterface"
      }
    } with {
      briefly "from laboratory instrument interface"
      described as {
        |Carries messages from the external LaboratoryInstrumentInterface.
      }
    }
  } with {
    briefly "LaboratoryInstrumentInterface integration"
    described as {
      |The model's side of the LaboratoryInstrumentInterface conversation.
    }
  }
  adaptor ToLaboratoryInstrumentInterface to context LaboratoryInstrumentInterface is { 
    handler ToLaboratoryInstrumentInterfaceHandler is {
      on command LaboratoryInstrumentInterface.RequestAnalyzerResult is {
        do "the model sends request analyzer result"
      }
      on command LaboratoryInstrumentInterface.SendToAnalyzer is {
        do "the model sends send to analyzer"
      }
      on other is {
        error "Unexpected message for adaptor ToLaboratoryInstrumentInterface"
      }
    } with {
      briefly "to laboratory instrument interface"
      described as {
        |Carries messages to the external LaboratoryInstrumentInterface.
      }
    }
  } with {
    briefly "LaboratoryInstrumentInterface integration"
    described as {
      |The model's side of the LaboratoryInstrumentInterface conversation.
    }
  }
  adaptor FromPhysicianNotificationService from context PhysicianNotificationService is { 
    handler FromPhysicianNotificationServiceHandler is {
      on event PhysicianNotificationService.CriticalAlertAcknowledged is {
        do "the model receives critical alert acknowledged"
      }
      on event PhysicianNotificationService.CriticalAlertSent is {
        do "the model receives critical alert sent"
      }
      on event PhysicianNotificationService.ReadBackRecorded is {
        do "the model receives read back recorded"
      }
      on other is {
        error "Unexpected message for adaptor FromPhysicianNotificationService"
      }
    } with {
      briefly "from physician notification service"
      described as {
        |Carries messages from the external PhysicianNotificationService.
      }
    }
  } with {
    briefly "PhysicianNotificationService integration"
    described as {
      |The model's side of the PhysicianNotificationService conversation.
    }
  }
  adaptor ToPhysicianNotificationService to context PhysicianNotificationService is { 
    handler ToPhysicianNotificationServiceHandler is {
      on command PhysicianNotificationService.RecordReadBack is {
        do "the model sends record read back"
      }
      on command PhysicianNotificationService.SendResultNotification is {
        do "the model sends send result notification"
      }
      on other is {
        error "Unexpected message for adaptor ToPhysicianNotificationService"
      }
    } with {
      briefly "to physician notification service"
      described as {
        |Carries messages to the external PhysicianNotificationService.
      }
    }
  } with {
    briefly "PhysicianNotificationService integration"
    described as {
      |The model's side of the PhysicianNotificationService conversation.
    }
  }
  include "types.riddl"
  include "LabOrder.riddl"
  // Repository for lab order persistence
  repository LabOrderRepository is {
    inlet LabOrderRepositoryFromLabOrder is type LabOrderEvent    inlet LabOrderRepositoryFromTurnaroundTimeAnalytics is type LabOrderEvent    inlet LabOrderRepositoryFromVolumeAnalytics is type LabOrderEvent    inlet LabOrderRepositoryFromCriticalValueTracking is type LabOrderEvent    outlet LabOrderRepositoryResponses is type LabOrder.LabOrderResult
    record StoredLabOrder is  {
      labOrderId: LabOrderId with {
        briefly "labOrderId"
        described as {
          |The labOrderId column of the stored labOrder row.
        }
      }
      orderId: LabOrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored labOrder row.
        }
      }
      patient: PatientInfo with {
        briefly "patient"
        described as {
          |The patient column of the stored labOrder row.
        }
      }
      specimen: SpecimenInfo with {
        briefly "specimen"
        described as {
          |The specimen column of the stored labOrder row.
        }
      }
    } with {
      briefly "Stored labOrder row"
      described as {
        |The persistence shape of labOrder data as this repository stores it.
      }
    }
    schema LabOrderData is relational
      of labOrders as type StoredLabOrder
        index on field StoredLabOrder.orderId
        index on field StoredLabOrder.patient.patientId
        index on field StoredLabOrder.specimen.specimenId
 with {
      briefly "Lab order data schema"
      described as {
        |The relational schema holding lab order data for the LabOrderRepository.
      }
    }
    handler LabOrderPersistence is {
      on query GetTATMetrics is {
        do "read the tat metrics projection"
        yield result TATMetricsView
      }
      on query GetVolumeMetrics is {
        do "read the volume metrics projection"
        yield result VolumeMetricsView
      }
      on query GetCriticalValueMetrics is {
        do "read the critical value metrics projection"
        yield result CriticalValueMetricsView
      }
      on command LabOrder.PlaceLabOrder is {
        tell event LabOrder.LabOrderPlaced to entity LabContext.LabOrder
      }
      on command LabContext.LabOrder.CollectSpecimen is {
        tell event LabOrder.SpecimenCollected to entity LabContext.LabOrder
      }
      on command LabOrder.ReceiveSpecimen is {
        tell event LabOrder.SpecimenReceived to entity LabContext.LabOrder
      }
      on command LabOrder.StartTesting is {
        tell event LabOrder.TestingStarted to entity LabContext.LabOrder
      }
      on command LabOrder.RecordResult is {
        tell event LabOrder.ResultRecorded to entity LabContext.LabOrder
      }
      on command LabOrder.VerifyResult is {
        tell event LabOrder.ResultVerified to entity LabContext.LabOrder
      }
      on command LabOrder.ReportCriticalValue is {
        tell event LabOrder.CriticalValueReported to entity LabContext.LabOrder
      }
      on command LabOrder.CancelOrder is {
        tell event LabOrder.OrderCancelled to entity LabContext.LabOrder
      }
    } with {
      briefly "Persists lab order events"
      described as {
        |Handles command-driven persistence for laboratory orders.
      }
    }
  } with {
    briefly "Lab order data persistence"
    described as {
      | The LabOrderRepository provides persistent storage for
      | laboratory orders, specimens, and test results.
    }
  }
  // Repository for specimen tracking
  repository SpecimenRepository is {
    schema SpecimenData is relational
      of specimens as type SpecimenInfo
        index on field SpecimenInfo.specimenId
        index on field SpecimenInfo.collectedAt
 with {
      briefly "Specimen data schema"
      described as {
        |The relational schema holding specimen data for the SpecimenRepository.
      }
    }
    handler SpecimenPersistence is {
      on command LabContext.LabOrder.CollectSpecimen is {
        tell event LabOrder.SpecimenCollected to entity LabContext.LabOrder
      }
      on command LabOrder.ReceiveSpecimen is {
        tell event LabOrder.SpecimenReceived to entity LabContext.LabOrder
      }
    } with {
      briefly "Persists specimen data"
      described as {
        |Handles specimen tracking persistence.
      }
    }
  } with {
    briefly "Specimen data persistence"
    described as {
      |Repository for tracking specimen lifecycle.
    }
  }
  // Repository for test results
  repository ResultRepository is {
    schema ResultData is relational
      of results as type TestResult
        index on field TestResult.resultId
        index on field TestResult.testId
        index on field TestResult.performedAt
 with {
      briefly "Result data schema"
      described as {
        |The relational schema holding result data for the ResultRepository.
      }
    }
    handler ResultPersistence is {
      on command LabOrder.RecordResult is {
        tell event LabOrder.ResultRecorded to entity LabContext.LabOrder
      }
      on command LabOrder.VerifyResult is {
        tell event LabOrder.ResultVerified to entity LabContext.LabOrder
      }
    } with {
      briefly "Persists result data"
      described as {
        |Handles test result persistence.
      }
    }
  } with {
    briefly "Result data persistence"
    described as {
      |Repository for storing and querying test results.
    }
  }
  // Projector for turnaround time analytics
  query GetTATMetrics is  {
    tATMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which tat metrics to retrieve.
      }
    }
  } with {
    briefly "Get tat metrics"
    described as {
      |Retrieves the tat metrics projection.
    }
  }
  result TATMetricsView is  {
    tATMetrics: TurnaroundTimeAnalytics.TATMetrics with {
      briefly "Tat metrics"
      described as {
        |The tat metrics being returned.
      }
    }
  } with {
    briefly "Tat metrics view"
    described as {
      |Read model view carrying the tat metrics projection.
    }
  }
  projector TurnaroundTimeAnalytics is {
    updates repository LabContext.LabOrderRepository
    inlet TurnaroundTimeAnalyticsFromLabOrder is type LabOrderEvent    outlet TurnaroundTimeAnalyticsOut is type LabOrderEvent
    record TATMetrics is  {
      testCode: String(1,20) with {
        briefly "Test"
        described as {
          |Test code.
        }
      }
      avgCollectionToReceipt: Duration with {
        briefly "Collect-to-receipt"
        described as {
          |Average time from collection to lab receipt.
        }
      }
      avgReceiptToResult: Duration with {
        briefly "Receipt-to-result"
        described as {
          |Average time from receipt to result.
        }
      }
      avgResultToVerify: Duration with {
        briefly "Result-to-verify"
        described as {
          |Average time from result to verification.
        }
      }
      totalTAT: Duration with {
        briefly "Total TAT"
        described as {
          |Total turnaround time.
        }
      }
      percentOnTarget: Decimal(5,2) with {
        briefly "On target %"
        described as {
          |Percentage meeting TAT target.
        }
      }
      sampleSize: Natural with {
        briefly "Sample size"
        described as {
          |Number of orders in calculation.
        }
      }
      calculatedAt: TimeStamp with {
        briefly "Calculated"
        described as {
          |Calculation timestamp.
        }
      }
    } with {
      briefly "TAT metrics"
      described as {
        |Turnaround time performance metrics.
      }
    }
    handler TATHandler is {
      on event LabOrder.LabOrderPlaced is {
        tell event LabOrder.LabOrderPlaced to repository LabContext.LabOrderRepository
      }
      on event LabOrder.SpecimenCollected is {
        tell event LabOrder.SpecimenCollected to repository LabContext.LabOrderRepository
      }
      on event LabOrder.SpecimenReceived is {
        tell event LabOrder.SpecimenReceived to repository LabContext.LabOrderRepository
      }
      on event LabOrder.ResultRecorded is {
        tell event LabOrder.ResultRecorded to repository LabContext.LabOrderRepository
      }
      on event LabOrder.ResultVerified is {
        tell event LabOrder.ResultVerified to repository LabContext.LabOrderRepository
      }
    } with {
      briefly "Maintains TAT analytics"
      described as {
        |Projects events into turnaround time metrics.
      }
    }
  } with {
    briefly "Turnaround time projections"
    described as {
      |Maintains laboratory turnaround time analytics.
    }
  }
  // Projector for volume metrics
  query GetVolumeMetrics is  {
    volumeMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which volume metrics to retrieve.
      }
    }
  } with {
    briefly "Get volume metrics"
    described as {
      |Retrieves the volume metrics projection.
    }
  }
  result VolumeMetricsView is  {
    volumeMetrics: VolumeAnalytics.VolumeMetrics with {
      briefly "Volume metrics"
      described as {
        |The volume metrics being returned.
      }
    }
  } with {
    briefly "Volume metrics view"
    described as {
      |Read model view carrying the volume metrics projection.
    }
  }
  projector VolumeAnalytics is {
    updates repository LabContext.LabOrderRepository
    inlet VolumeAnalyticsFromLabOrder is type LabOrderEvent    outlet VolumeAnalyticsOut is type LabOrderEvent
    record VolumeMetrics is  {
      period: String(1,20) with {
        briefly "Period"
        described as {
          |Time period (hourly, daily, weekly).
        }
      }
      periodStart: TimeStamp with {
        briefly "Start"
        described as {
          |Period start time.
        }
      }
      totalOrders: Natural with {
        briefly "Total orders"
        described as {
          |Orders placed.
        }
      }
      totalSpecimens: Natural with {
        briefly "Total specimens"
        described as {
          |Specimens collected.
        }
      }
      totalResults: Natural with {
        briefly "Total results"
        described as {
          |Results recorded.
        }
      }
      ordersByPriority: String(1,100)+ with {
        briefly "By priority"
        described as {
          |Counts by priority.
        }
      }
      ordersByDepartment: String(1,100)+ with {
        briefly "By department"
        described as {
          |Counts by ordering department.
        }
      }
      testsByType: String(1,100)+ with {
        briefly "By test type"
        described as {
          |Counts by test code.
        }
      }
      cancelRate: Decimal(5,4) with {
        briefly "Cancel rate"
        described as {
          |Order cancellation rate.
        }
      }
    } with {
      briefly "Volume metrics"
      described as {
        |Laboratory volume and workload metrics.
      }
    }
    handler VolumeHandler is {
      on event LabOrder.LabOrderPlaced is {
        tell event LabOrder.LabOrderPlaced to repository LabContext.LabOrderRepository
      }
      on event LabOrder.SpecimenCollected is {
        tell event LabOrder.SpecimenCollected to repository LabContext.LabOrderRepository
      }
      on event LabOrder.ResultRecorded is {
        tell event LabOrder.ResultRecorded to repository LabContext.LabOrderRepository
      }
      on event LabOrder.OrderCancelled is {
        tell event LabOrder.OrderCancelled to repository LabContext.LabOrderRepository
      }
    } with {
      briefly "Maintains volume analytics"
      described as {
        |Projects events into volume metrics.
      }
    }
  } with {
    briefly "Volume projections"
    described as {
      |Maintains laboratory volume and workload analytics.
    }
  }
  // Projector for critical value tracking
  query GetCriticalValueMetrics is  {
    criticalValueMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which critical value metrics to retrieve.
      }
    }
  } with {
    briefly "Get critical value metrics"
    described as {
      |Retrieves the critical value metrics projection.
    }
  }
  result CriticalValueMetricsView is  {
    criticalValueMetrics: CriticalValueTracking.CriticalValueMetrics with {
      briefly "Critical value metrics"
      described as {
        |The critical value metrics being returned.
      }
    }
  } with {
    briefly "Critical value metrics view"
    described as {
      |Read model view carrying the critical value metrics projection.
    }
  }
  projector CriticalValueTracking is {
    updates repository LabContext.LabOrderRepository
    inlet CriticalValueTrackingFromLabOrder is type LabOrderEvent    outlet CriticalValueTrackingOut is type LabOrderEvent
    record CriticalValueMetrics is  {
      period: String(1,20) with {
        briefly "Period"
        described as {
          |Time period.
        }
      }
      periodStart: TimeStamp with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      totalCriticals: Natural with {
        briefly "Total criticals"
        described as {
          |Critical values reported.
        }
      }
      avgNotificationTime: Duration with {
        briefly "Avg notification"
        described as {
          |Average time to notify provider.
        }
      }
      readBackRate: Decimal(5,4) with {
        briefly "Read-back rate"
        described as {
          |Read-back confirmation rate.
        }
      }
      criticalsByTest: String(1,100)+ with {
        briefly "By test"
        described as {
          |Criticals by test type.
        }
      }
      criticalsByUnit: String(1,100)+ with {
        briefly "By unit"
        described as {
          |Criticals by nursing unit.
        }
      }
    } with {
      briefly "Critical value metrics"
      described as {
        |Critical value reporting performance metrics.
      }
    }
    handler CriticalValueHandler is {
      on event LabOrder.CriticalValueReported is {
        tell event LabOrder.CriticalValueReported to repository LabContext.LabOrderRepository
      }
    } with {
      briefly "Maintains critical value analytics"
      described as {
        |Projects events into critical value tracking metrics.
      }
    }
  } with {
    briefly "Critical value projections"
    described as {
      |Maintains critical value reporting analytics and compliance metrics.
    }
  }
  type LabOrderEvent is one of {
    LabContext.LabOrder.LabOrderPlaced or LabContext.LabOrder.SpecimenCollected or LabContext.LabOrder.SpecimenReceived or LabContext.LabOrder.TestingStarted or LabContext.LabOrder.ResultRecorded or LabContext.LabOrder.ResultVerified or LabContext.LabOrder.CriticalValueReported or LabContext.LabOrder.OrderCancelled
  } with {
    briefly "Lab order events"
    described as {
      |Union of all lab order entity events for streaming.
    }
  }
  processor LabOrderSource as source is {
    outlet LabOrderEvents is type LabOrderEvent
 with {
      briefly "Lab order event outlet"
      described as {
        |Publishes lab order events.
      }
    }
    handler LabOrderSourceHandler is {
      on init is {
        tell command LabOrder.InitializeLabOrder to entity LabContext.LabOrder
      }
      on event LabOrder.LabOrderPlaced is {
        send event LabOrder.LabOrderPlaced to outlet LabOrderEvents
      }
      on event LabOrder.ResultVerified is {
        send event LabOrder.ResultVerified to outlet LabOrderEvents
      }
      on event LabOrder.OrderCancelled is {
        send event LabOrder.OrderCancelled to outlet LabOrderEvents
      }
      on other is {
        error "Unexpected message for source LabOrderSource"
      }
    } with {
      briefly "Lab order source handler"
      described as {
        |Forwards lab order events to the outlet.
      }
    }
  } with {
    briefly "Lab order event source"
    described as {
      |Source streamlet that publishes lab order events.
    }
  }
  processor LabOrderSink as sink is {
    inlet LabOrderEventsIn is type LabOrderEvent with {
      briefly "Lab order event inlet"
      described as {
        |Receives lab order events.
      }
    }
    handler LabOrderSinkHandler is {
      on init is { ??? }
      on event LabOrder.LabOrderPlaced is {
        tell event LabOrder.LabOrderPlaced to repository LabContext.LabOrderRepository
      }
      on event LabOrder.ResultVerified is {
        tell event LabOrder.ResultVerified to repository LabContext.LabOrderRepository
      }
      on other is {
        error "Unexpected message for sink LabOrderSink"
      }
    } with {
      briefly "Lab order sink handler"
      described as {
        |Persists lab order events from the inlet.
      }
    }
  } with {
    briefly "Lab order event sink"
    described as {
      |Sink streamlet that consumes lab order events.
    }
  }
  connector LabOrderFlow is from outlet LabContext.LabOrderSource.LabOrderEvents to inlet LabContext.LabOrderSink.LabOrderEventsIn with {
    briefly "Lab order event flow"
    described as {
      |Connects lab order source to sink for event streaming.
    }
  }
  processor LabOrderEventSplit is {
    inlet LabOrderEventSplitIn is type LabOrderEvent    outlet LabOrderEventSplitToLabOrderRepository is type LabOrderEvent
    outlet LabOrderEventSplitToTurnaroundTimeAnalytics is type LabOrderEvent
    outlet LabOrderEventSplitToVolumeAnalytics is type LabOrderEvent
    outlet LabOrderEventSplitToCriticalValueTracking is type LabOrderEvent
    handler LabOrderEventSplitHandler is {
      on event LabOrder.LabOrderPlaced is {
        send event LabOrder.LabOrderPlaced to outlet LabOrderEventSplitToLabOrderRepository
        send event LabOrder.LabOrderPlaced to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send event LabOrder.LabOrderPlaced to outlet LabOrderEventSplitToVolumeAnalytics
        send event LabOrder.LabOrderPlaced to outlet LabOrderEventSplitToCriticalValueTracking
        tell event LabOrder.LabOrderPlaced to entity LabContext.LabOrder
      }
      on event LabOrder.SpecimenCollected is {
        send event LabOrder.SpecimenCollected to outlet LabOrderEventSplitToLabOrderRepository
        send event LabOrder.SpecimenCollected to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send event LabOrder.SpecimenCollected to outlet LabOrderEventSplitToVolumeAnalytics
        send event LabOrder.SpecimenCollected to outlet LabOrderEventSplitToCriticalValueTracking
        tell event LabOrder.SpecimenCollected to entity LabContext.LabOrder
      }
      on event LabOrder.SpecimenReceived is {
        send event LabOrder.SpecimenReceived to outlet LabOrderEventSplitToLabOrderRepository
        send event LabOrder.SpecimenReceived to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send event LabOrder.SpecimenReceived to outlet LabOrderEventSplitToVolumeAnalytics
        send event LabOrder.SpecimenReceived to outlet LabOrderEventSplitToCriticalValueTracking
        tell event LabOrder.SpecimenReceived to entity LabContext.LabOrder
      }
      on event LabOrder.TestingStarted is {
        send event LabOrder.TestingStarted to outlet LabOrderEventSplitToLabOrderRepository
        send event LabOrder.TestingStarted to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send event LabOrder.TestingStarted to outlet LabOrderEventSplitToVolumeAnalytics
        send event LabOrder.TestingStarted to outlet LabOrderEventSplitToCriticalValueTracking
        tell event LabOrder.TestingStarted to entity LabContext.LabOrder
      }
      on event LabOrder.ResultRecorded is {
        send event LabOrder.ResultRecorded to outlet LabOrderEventSplitToLabOrderRepository
        send event LabOrder.ResultRecorded to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send event LabOrder.ResultRecorded to outlet LabOrderEventSplitToVolumeAnalytics
        send event LabOrder.ResultRecorded to outlet LabOrderEventSplitToCriticalValueTracking
        tell event LabOrder.ResultRecorded to entity LabContext.LabOrder
      }
      on event LabOrder.ResultVerified is {
        send event LabOrder.ResultVerified to outlet LabOrderEventSplitToLabOrderRepository
        send event LabOrder.ResultVerified to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send event LabOrder.ResultVerified to outlet LabOrderEventSplitToVolumeAnalytics
        send event LabOrder.ResultVerified to outlet LabOrderEventSplitToCriticalValueTracking
        tell event LabOrder.ResultVerified to entity LabContext.LabOrder
      }
      on event LabOrder.CriticalValueReported is {
        send event LabOrder.CriticalValueReported to outlet LabOrderEventSplitToLabOrderRepository
        send event LabOrder.CriticalValueReported to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send event LabOrder.CriticalValueReported to outlet LabOrderEventSplitToVolumeAnalytics
        send event LabOrder.CriticalValueReported to outlet LabOrderEventSplitToCriticalValueTracking
        tell event LabOrder.CriticalValueReported to entity LabContext.LabOrder
      }
      on event LabOrder.OrderCancelled is {
        send event LabOrder.OrderCancelled to outlet LabOrderEventSplitToLabOrderRepository
        send event LabOrder.OrderCancelled to outlet LabOrderEventSplitToTurnaroundTimeAnalytics
        send event LabOrder.OrderCancelled to outlet LabOrderEventSplitToVolumeAnalytics
        send event LabOrder.OrderCancelled to outlet LabOrderEventSplitToCriticalValueTracking
        tell event LabOrder.OrderCancelled to entity LabContext.LabOrder
      }
      on other is {
        error "Unexpected message for processor LabOrderEventSplit"
      }
    } with {
      briefly "LabOrder event fan-out handler"
      described as {
        |Delivers each LabOrder event to all of its consumers.
      }
    }
  } with {
    briefly "LabOrder event fan-out"
    described as {
      |Fans LabOrder events out to the repository and projectors.
    }
  }
  connector LinkLabOrderToLabOrderEventSplit is from outlet LabContext.LabOrder.LabOrderEvents2 to inlet LabContext.LabOrderEventSplit.LabOrderEventSplitIn with {
    briefly "LinkLabOrderToLabOrderEventSplit"
  }
  connector LinkLabOrderEventSplitToLabOrderRepository is from outlet LabContext.LabOrderEventSplit.LabOrderEventSplitToLabOrderRepository to inlet LabContext.LabOrderRepository.LabOrderRepositoryFromLabOrder with {
    briefly "LinkLabOrderEventSplitToLabOrderRepository"
  }
  connector LinkLabOrderEventSplitToTurnaroundTimeAnalytics is from outlet LabContext.LabOrderEventSplit.LabOrderEventSplitToTurnaroundTimeAnalytics to inlet LabContext.TurnaroundTimeAnalytics.TurnaroundTimeAnalyticsFromLabOrder with {
    briefly "LinkLabOrderEventSplitToTurnaroundTimeAnalytics"
  }
  connector LinkLabOrderEventSplitToVolumeAnalytics is from outlet LabContext.LabOrderEventSplit.LabOrderEventSplitToVolumeAnalytics to inlet LabContext.VolumeAnalytics.VolumeAnalyticsFromLabOrder with {
    briefly "LinkLabOrderEventSplitToVolumeAnalytics"
  }
  connector LinkLabOrderEventSplitToCriticalValueTracking is from outlet LabContext.LabOrderEventSplit.LabOrderEventSplitToCriticalValueTracking to inlet LabContext.CriticalValueTracking.CriticalValueTrackingFromLabOrder with {
    briefly "LinkLabOrderEventSplitToCriticalValueTracking"
  }
  connector LinkTurnaroundTimeAnalyticsToLabOrderRepository is from outlet LabContext.TurnaroundTimeAnalytics.TurnaroundTimeAnalyticsOut to inlet LabContext.LabOrderRepository.LabOrderRepositoryFromTurnaroundTimeAnalytics with {
    briefly "LinkTurnaroundTimeAnalyticsToLabOrderRepository"
  }
  connector LinkVolumeAnalyticsToLabOrderRepository is from outlet LabContext.VolumeAnalytics.VolumeAnalyticsOut to inlet LabContext.LabOrderRepository.LabOrderRepositoryFromVolumeAnalytics with {
    briefly "LinkVolumeAnalyticsToLabOrderRepository"
  }
  connector LinkCriticalValueTrackingToLabOrderRepository is from outlet LabContext.CriticalValueTracking.CriticalValueTrackingOut to inlet LabContext.LabOrderRepository.LabOrderRepositoryFromCriticalValueTracking with {
    briefly "LinkCriticalValueTrackingToLabOrderRepository"
  }
} with {
  briefly "Bounded context for laboratory orders"
  described as {
    | The LabContext is the bounded context for laboratory
    | order management, specimen tracking, result processing,
    | and analytics including TAT and critical value monitoring.
  }
}
