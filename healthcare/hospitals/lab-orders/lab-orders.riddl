// Lab Orders Domain Model
// Laboratory test ordering, specimen collection, and result reporting
domain LabOrders is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user OrderingPhysician is "physician who orders laboratory tests" with {
    briefly "Ordering Physician"
    described as {
      |Healthcare provider authorized to order lab tests.
    }
  }
  user LabTechnician is "laboratory staff who processes specimens" with {
    briefly "Lab Technician"
    described as {
      |Laboratory personnel who perform testing procedures.
    }
  }
  user Phlebotomist is "staff who collects blood specimens" with {
    briefly "Phlebotomist"
    described as {
      |Trained personnel who collect blood and other specimens.
    }
  }
  user PathologistPnl is "pathologist who verifies results" with {
    briefly "Pathologist"
    described as {
      |Board-certified pathologist who reviews and verifies results.
    }
  }
  epic LabOrderEpic is {
    user OrderingPhysician wants to "to order laboratory tests for patients" so that "clinical decisions are informed by diagnostic data"
    case OrderLabTest is {
      user OrderingPhysician wants to "to place a lab order" so that "specimen collection can begin"
      step is "Physician reviews" "patient history and symptoms" "in EHR" with {
        briefly "Review patient"
        described as {
          |Review clinical history.
        }
      }
      step take input LabOrdersApp.LabOrdersScreen.PlaceLabOrderInput from user OrderingPhysician with {
        briefly "Place order"
        described as {
          |Submit lab order.
        }
      }
      step is "Order is" "transmitted to laboratory" "via interface" with {
        briefly "Transmit order"
        described as {
          |Send to lab system.
        }
      }
    } with {
      briefly "Lab order placement"
      described as {
        |Workflow for ordering laboratory tests.
      }
    }
    case CollectSpecimenCase is {
      user Phlebotomist wants to "to collect a specimen" so that "testing can proceed"
      step is "Phlebotomist receives" "collection request" "on worklist" with {
        briefly "View worklist"
        described as {
          |See pending collections.
        }
      }
      step is "Patient is" "identified and verified" "at bedside" with {
        briefly "Verify patient"
        described as {
          |Confirm patient identity.
        }
      }
      step take input LabOrdersApp.LabOrdersScreen.CollectSpecimenInput from user Phlebotomist with {
        briefly "Collect specimen"
        described as {
          |Record specimen collection.
        }
      }
      step is "Specimen is" "labeled and transported" "to laboratory" with {
        briefly "Transport"
        described as {
          |Deliver to lab.
        }
      }
    } with {
      briefly "Specimen collection"
      described as {
        |Workflow for collecting patient specimens.
      }
    }
    case ProcessAndResult is {
      user LabTechnician wants to "to process specimens and record results" so that "physicians receive diagnostic information"
      step take input LabOrdersApp.LabOrdersScreen.ReceiveSpecimenInput from user LabTechnician with {
        briefly "Receive specimen"
        described as {
          |Log specimen receipt.
        }
      }
      step take input LabOrdersApp.LabOrdersScreen.StartTestingInput from user LabTechnician with {
        briefly "Start testing"
        described as {
          |Begin analysis.
        }
      }
      step is "Analyzer processes" "specimen per protocol" "automatically" with {
        briefly "Run analyzer"
        described as {
          |Instrument analysis.
        }
      }
      step take input LabOrdersApp.LabOrdersScreen.RecordResultInput from user LabTechnician with {
        briefly "Record result"
        described as {
          |Enter test results.
        }
      }
    } with {
      briefly "Lab processing"
      described as {
        |Workflow for specimen processing and result recording.
      }
    }
    case VerifyAndReport is {
      user PathologistPnl wants to "to verify and release results" so that "accurate results reach ordering physicians"
      step is "Pathologist reviews" "results for accuracy" "in LIS" with {
        briefly "Review results"
        described as {
          |Quality check.
        }
      }
      step take input LabOrdersApp.LabOrdersScreen.VerifyResultInput from user PathologistPnl with {
        briefly "Verify result"
        described as {
          |Authorize release.
        }
      }
      step is "Result is" "transmitted to EHR" "via interface" with {
        briefly "Transmit result"
        described as {
          |Send to ordering system.
        }
      }
    } with {
      briefly "Result verification"
      described as {
        |Workflow for pathologist review and result release.
      }
    }
    case CriticalValueAlert is {
      user LabTechnician wants to "to report critical values immediately" so that "patient safety is ensured"
      step is "System detects" "critical value threshold" "exceeded" with {
        briefly "Detect critical"
        described as {
          |Flag abnormal result.
        }
      }
      step take input LabOrdersApp.LabOrdersScreen.ReportCriticalValueInput from user LabTechnician with {
        briefly "Report critical"
        described as {
          |Initiate alert.
        }
      }
      step is "Physician is" "notified immediately" "via alert system" with {
        briefly "Alert physician"
        described as {
          |Urgent notification.
        }
      }
      step is "Read-back is" "documented for compliance" "in system" with {
        briefly "Document callback"
        described as {
          |Record notification.
        }
      }
    } with {
      briefly "Critical value reporting"
      described as {
        |Workflow for urgent result notification.
      }
    }
  } with {
    briefly "Laboratory operations"
    described as {
      | Epic covering the complete laboratory workflow from order
      | placement through specimen collection, testing, result
      | verification, and critical value reporting.
    }
  }
  include "LabContext.riddl"
  include "external-contexts.riddl"
  application context LabOrdersApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in LabOrders are delivered.
      }
    }
    group LabOrdersScreen is {
      input PlaceLabOrderInput acquires command LabContext.LabOrder.PlaceLabOrder with {
        briefly "Place lab order control"
        described as {
          |The control through which a user submits the place lab order request.
        }
      }
      input CollectSpecimenInput acquires command LabContext.LabOrder.CollectSpecimen with {
        briefly "Collect specimen control"
        described as {
          |The control through which a user submits the collect specimen request.
        }
      }
      input ReceiveSpecimenInput acquires command LabContext.LabOrder.ReceiveSpecimen with {
        briefly "Receive specimen control"
        described as {
          |The control through which a user submits the receive specimen request.
        }
      }
      input StartTestingInput acquires command LabContext.LabOrder.StartTesting with {
        briefly "Start testing control"
        described as {
          |The control through which a user submits the start testing request.
        }
      }
      input RecordResultInput acquires command LabContext.LabOrder.RecordResult with {
        briefly "Record result control"
        described as {
          |The control through which a user submits the record result request.
        }
      }
      input VerifyResultInput acquires command LabContext.LabOrder.VerifyResult with {
        briefly "Verify result control"
        described as {
          |The control through which a user submits the verify result request.
        }
      }
      input ReportCriticalValueInput acquires command LabContext.LabOrder.ReportCriticalValue with {
        briefly "Report critical value control"
        described as {
          |The control through which a user submits the report critical value request.
        }
      }
    } with {
      briefly "Lab orders screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppLabOrderCommands is type LabContext.LabOrder.LabOrderCommand
    inlet AppLabOrderRepositoryResponses is type LabContext.LabOrder.LabOrderResult    handler LabOrdersAppHandler is {
      on other is {
        error "Unexpected message for application context LabOrdersApp"
      }
    } with {
      briefly "LabOrdersApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "LabOrdersApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'LabOrderCommand Stream' is from outlet LabOrdersApp.AppLabOrderCommands to inlet LabContext.LabOrder.LabOrderCommands with {
    option persistent()
    briefly "LabOrder commands from the application"
  }
  connector 'Translation To Context PhysicianNotificationService' is from outlet LabContext.ToPhysicianNotificationService.TranslatedCriticalAlerts to inlet PhysicianNotificationService.PhysicianNotificationServiceCommands with {
    option persistent()
    briefly "Lab order events translated into physician notification commands"
  }
  connector 'LabOrderResult Stream' is from outlet LabContext.LabOrderRepository.LabOrderRepositoryResponses to inlet LabOrdersApp.AppLabOrderRepositoryResponses with {
    option persistent()
    briefly "LabOrder query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet LabOrdersApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Laboratory orders domain"
  described as {
    | The LabOrders domain handles laboratory test ordering,
    | specimen collection, processing, result recording, and
    | reporting including critical value notifications.
  }
}
