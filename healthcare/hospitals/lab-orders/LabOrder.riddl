// Lab Orders - LabOrder Entity
entity LabOrder as router is {
  type LabOrderCommand is one of {
    LabOrder.CollectSpecimen or LabOrder.ReceiveSpecimen or LabOrder.StartTesting or LabOrder.RecordResult or LabOrder.VerifyResult or LabOrder.ReportCriticalValue or LabOrder.ConfirmCriticalValueReadBack or LabOrder.CancelOrder
  } with {
    briefly "LabOrder command alternation"
    described as {
      |Commands accepted by the LabOrder entity.
    }
  }
  inlet LabOrderQueries is query GetLabOrder with {
    briefly "Look-ups of this lab order"
    described as {
      |What LabOrdersApp asks of the lab order, by way of LabContext.
    }
  }
  outlet LabOrderReplies is result LabOrderResult
 with {
    briefly "This lab order's answers"
    described as {
      |What the lab order answers, on its way back to LabContext.
    }
  }
  inlet LabOrderCommands is type LabOrderCommand
  outlet LabOrderEvents2 is type LabOrderEvent
  outlet LabOrderToPhysicianNotification is type PhysicianNotificationService.PhysicianNotificationRequest
  // Commands
  command CollectSpecimen is {
    orderId: LabOrderId with {
      briefly "Order ID"
      described as {
        |Lab order identifier.
      }
    }
    specimen: SpecimenInfo with {
      briefly "Specimen"
      described as {
        |Collected specimen details.
      }
    }
  } with {
    briefly "Collect specimen"
    described as {
      |Records specimen collection for an order.
    }
  }
  command ReceiveSpecimen is {
    orderId: LabOrderId with {
      briefly "Order ID"
      described as {
        |Lab order identifier.
      }
    }
    specimenId: SpecimenId with {
      briefly "Specimen ID"
      described as {
        |Specimen identifier.
      }
    }
    receivedBy: ProviderId with {
      briefly "Received by"
      described as {
        |Lab staff receiving specimen.
      }
    }
    receivedAt: TimeStamp with {
      briefly "Received at"
      described as {
        |Receipt timestamp.
      }
    }
    specimenCondition: String(1,200) with {
      briefly "Condition"
      described as {
        |Specimen condition at receipt.
      }
    }
  } with {
    briefly "Receive specimen"
    described as {
      |Records specimen receipt in laboratory.
    }
  }
  command StartTesting is {
    orderId: LabOrderId with {
      briefly "Order ID"
      described as {
        |Lab order identifier.
      }
    }
    testId: TestId with {
      briefly "Test ID"
      described as {
        |Test being started.
      }
    }
    startedBy: ProviderId with {
      briefly "Started by"
      described as {
        |Technician starting test.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started at"
      described as {
        |Testing start time.
      }
    }
    analyzerId: String(1,50)? with {
      briefly "Analyzer"
      described as {
        |Instrument identifier.
      }
    }
  } with {
    briefly "Start testing"
    described as {
      |Begins laboratory testing for an order.
    }
  }
  command RecordResult is {
    orderId: LabOrderId with {
      briefly "Order ID"
      described as {
        |Lab order identifier.
      }
    }
    result: TestResult with {
      briefly "Result"
      described as {
        |Test result data.
      }
    }
  } with {
    briefly "Record result"
    described as {
      |Records test result for an order.
    }
  }
  command VerifyResult is {
    orderId: LabOrderId with {
      briefly "Order ID"
      described as {
        |Lab order identifier.
      }
    }
    resultId: ResultId with {
      briefly "Result ID"
      described as {
        |Result to verify.
      }
    }
    verifiedBy: ProviderId with {
      briefly "Verified by"
      described as {
        |Pathologist verifying result.
      }
    }
    verifiedAt: TimeStamp with {
      briefly "Verified at"
      described as {
        |Verification timestamp.
      }
    }
    comments: String(1,500)? with {
      briefly "Comments"
      described as {
        |Pathologist comments.
      }
    }
  } with {
    briefly "Verify result"
    described as {
      |Pathologist verification and release of result.
    }
  }
  command ConfirmCriticalValueReadBack is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |The order whose critical value was read back.
      }
    }
    resultId: ResultId with {
      briefly "Result"
      described as {
        |The result carrying the critical value.
      }
    }
    confirmedBy: String(1,200) with {
      briefly "Confirmed by"
      described as {
        |The clinician who read the value back.
      }
    }
    confirmedAt: TimeStamp with {
      briefly "Confirmed at"
      described as {
        |When the read-back happened.
      }
    }
  } with {
    briefly "Confirm that a clinician read a critical value back"
    described as {
      |A critical value is not considered communicated until the receiving
      |clinician repeats it back. The lab records who did so and when,
      |because the read-back is the evidence that the result was actually
      |received by a person.
    }
  }
  event CriticalValueReadBack is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |The order whose critical value was read back.
      }
    }
    resultId: ResultId with {
      briefly "Result"
      described as {
        |The result carrying the critical value.
      }
    }
    confirmedBy: String(1,200) with {
      briefly "Confirmed by"
      described as {
        |The clinician who read the value back.
      }
    }
    confirmedAt: TimeStamp with {
      briefly "Confirmed at"
      described as {
        |When the read-back happened.
      }
    }
  } with {
    briefly "A clinician read a critical value back"
    described as {
      |Closes the loop opened by CriticalValueReported. Until this, the
      |critical value has been sent but not demonstrably received.
    }
  }
  command ReportCriticalValue is {
    orderId: LabOrderId with {
      briefly "Order ID"
      described as {
        |Lab order identifier.
      }
    }
    criticalValue: CriticalValue with {
      briefly "Critical"
      described as {
        |Critical value details.
      }
    }
  } with {
    briefly "Report critical value"
    described as {
      |Reports a life-threatening critical result.
    }
  }
  command CancelOrder is {
    orderId: LabOrderId with {
      briefly "Order ID"
      described as {
        |Lab order identifier.
      }
    }
    cancelledBy: ProviderId with {
      briefly "Cancelled by"
      described as {
        |Person cancelling order.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled at"
      described as {
        |Cancellation timestamp.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
  } with {
    briefly "Cancel order"
    described as {
      |Cancels a laboratory order.
    }
  }
  // Events
  event LabOrderPlaced is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    patient: PatientInfo with {
      briefly "Patient"
      described as {
        |Patient info.
      }
    }
    orderingProvider: OrderingProviderInfo with {
      briefly "Provider"
      described as {
        |Ordering provider.
      }
    }
    facilityId: FacilityId with {
      briefly "Facility"
      described as {
        |Facility ID.
      }
    }
    orderDetails: OrderDetails with {
      briefly "Details"
      described as {
        |Order details.
      }
    }
    orderedAt: TimeStamp with {
      briefly "Ordered"
      described as {
        |Order time.
      }
    }
  } with {
    briefly "Lab order placed"
    described as {
      |Emitted when a laboratory order is created.
    }
  }
  event SpecimenCollected is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    specimen: SpecimenInfo with {
      briefly "Specimen"
      described as {
        |Specimen details.
      }
    }
  } with {
    briefly "Specimen collected"
    described as {
      |Emitted when specimen is collected from patient.
    }
  }
  event SpecimenReceived is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    specimenId: SpecimenId with {
      briefly "Specimen"
      described as {
        |Specimen ID.
      }
    }
    receivedBy: ProviderId with {
      briefly "Received by"
      described as {
        |Receiving staff.
      }
    }
    receivedAt: TimeStamp with {
      briefly "Received"
      described as {
        |Receipt time.
      }
    }
    specimenCondition: String(1,200) with {
      briefly "Condition"
      described as {
        |Specimen condition.
      }
    }
  } with {
    briefly "Specimen received"
    described as {
      |Emitted when specimen arrives in laboratory.
    }
  }
  event TestingStarted is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    testId: TestId with {
      briefly "Test"
      described as {
        |Test ID.
      }
    }
    startedBy: ProviderId with {
      briefly "Started by"
      described as {
        |Technician.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
    analyzerId: String(1,50)? with {
      briefly "Analyzer"
      described as {
        |Instrument.
      }
    }
  } with {
    briefly "Testing started"
    described as {
      |Emitted when laboratory testing begins.
    }
  }
  event ResultRecorded is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    result: TestResult with {
      briefly "Result"
      described as {
        |Test result.
      }
    }
  } with {
    briefly "Result recorded"
    described as {
      |Emitted when test result is recorded.
    }
  }
  event ResultVerified is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    resultId: ResultId with {
      briefly "Result"
      described as {
        |Result ID.
      }
    }
    verifiedBy: ProviderId with {
      briefly "Verified by"
      described as {
        |Pathologist.
      }
    }
    verifiedAt: TimeStamp with {
      briefly "Verified"
      described as {
        |Verification time.
      }
    }
    comments: String(1,500)? with {
      briefly "Comments"
      described as {
        |Pathologist notes.
      }
    }
  } with {
    briefly "Result verified"
    described as {
      |Emitted when pathologist verifies result.
    }
  }
  event CriticalValueReported is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    criticalValue: CriticalValue with {
      briefly "Critical"
      described as {
        |Critical value.
      }
    }
  } with {
    briefly "Critical value reported"
    described as {
      |Emitted when critical value is reported.
    }
  }
  event OrderCancelled is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    cancelledBy: ProviderId with {
      briefly "Cancelled by"
      described as {
        |Cancelling person.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancel time.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancel reason.
      }
    }
  } with {
    briefly "Order cancelled"
    described as {
      |Emitted when lab order is cancelled.
    }
  }
  // State Records
  record OrderedStateData is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    patient: PatientInfo with {
      briefly "Patient"
      described as {
        |Patient info.
      }
    }
    orderingProvider: OrderingProviderInfo with {
      briefly "Provider"
      described as {
        |Ordering provider.
      }
    }
    facilityId: FacilityId with {
      briefly "Facility"
      described as {
        |Facility ID.
      }
    }
    orderDetails: OrderDetails with {
      briefly "Details"
      described as {
        |Order details.
      }
    }
    status: OrderStatus with {
      briefly "Status"
      described as {
        |Order status.
      }
    }
    orderedAt: TimeStamp with {
      briefly "Ordered"
      described as {
        |Order time.
      }
    }
  } with {
    briefly "Ordered state data"
    described as {
      |Data for newly placed order.
    }
  }
  record CollectionStateData is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    patient: PatientInfo with {
      briefly "Patient"
      described as {
        |Patient info.
      }
    }
    orderingProvider: OrderingProviderInfo with {
      briefly "Provider"
      described as {
        |Ordering provider.
      }
    }
    facilityId: FacilityId with {
      briefly "Facility"
      described as {
        |Facility ID.
      }
    }
    orderDetails: OrderDetails with {
      briefly "Details"
      described as {
        |Order details.
      }
    }
    specimen: SpecimenInfo with {
      briefly "Specimen"
      described as {
        |Collected specimen.
      }
    }
    status: OrderStatus with {
      briefly "Status"
      described as {
        |Order status.
      }
    }
    orderedAt: TimeStamp with {
      briefly "Ordered"
      described as {
        |Order time.
      }
    }
  } with {
    briefly "Collection state data"
    described as {
      |Data for order with collected specimen.
    }
  }
  record TestingStateData is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    patient: PatientInfo with {
      briefly "Patient"
      described as {
        |Patient info.
      }
    }
    orderingProvider: OrderingProviderInfo with {
      briefly "Provider"
      described as {
        |Ordering provider.
      }
    }
    facilityId: FacilityId with {
      briefly "Facility"
      described as {
        |Facility ID.
      }
    }
    orderDetails: OrderDetails with {
      briefly "Details"
      described as {
        |Order details.
      }
    }
    specimen: SpecimenInfo with {
      briefly "Specimen"
      described as {
        |Specimen info.
      }
    }
    receivedAt: TimeStamp with {
      briefly "Received"
      described as {
        |Lab receipt time.
      }
    }
    testingStartedAt: TimeStamp? with {
      briefly "Testing started"
      described as {
        |Testing start time.
      }
    }
    pendingResults: TestResult* with {
      briefly "Pending"
      described as {
        |Results awaiting verification.
      }
    }
    status: OrderStatus with {
      briefly "Status"
      described as {
        |Order status.
      }
    }
    orderedAt: TimeStamp with {
      briefly "Ordered"
      described as {
        |Order time.
      }
    }
  } with {
    briefly "Testing state data"
    described as {
      |Data for order in laboratory processing.
    }
  }
  record ResultedStateData is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    patient: PatientInfo with {
      briefly "Patient"
      described as {
        |Patient info.
      }
    }
    orderingProvider: OrderingProviderInfo with {
      briefly "Provider"
      described as {
        |Ordering provider.
      }
    }
    facilityId: FacilityId with {
      briefly "Facility"
      described as {
        |Facility ID.
      }
    }
    orderDetails: OrderDetails with {
      briefly "Details"
      described as {
        |Order details.
      }
    }
    specimen: SpecimenInfo with {
      briefly "Specimen"
      described as {
        |Specimen info.
      }
    }
    results: TestResult+ with {
      briefly "Results"
      described as {
        |Verified results.
      }
    }
    criticalValues: CriticalValue* with {
      briefly "Criticals"
      described as {
        |Critical values reported.
      }
    }
    status: OrderStatus with {
      briefly "Status"
      described as {
        |Order status.
      }
    }
    orderedAt: TimeStamp with {
      briefly "Ordered"
      described as {
        |Order time.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Resulted state data"
    described as {
      |Data for completed order with verified results.
    }
  }
  record CancelledStateData is {
    orderId: LabOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    patient: PatientInfo with {
      briefly "Patient"
      described as {
        |Patient info.
      }
    }
    orderingProvider: OrderingProviderInfo with {
      briefly "Provider"
      described as {
        |Ordering provider.
      }
    }
    orderDetails: OrderDetails with {
      briefly "Details"
      described as {
        |Order details.
      }
    }
    cancelledBy: ProviderId with {
      briefly "Cancelled by"
      described as {
        |Cancelling person.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancel time.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancel reason.
      }
    }
    status: OrderStatus with {
      briefly "Status"
      described as {
        |Order status.
      }
    }
  } with {
    briefly "Cancelled state data"
    described as {
      |Data for cancelled order.
    }
  }
  // Queries
  query GetLabOrder replies result LabOrderResult is {
    orderId: LabOrderId with {
      briefly "Order ID"
      described as {
        |Lab order to retrieve.
      }
    }
  } with {
    briefly "Get lab order"
    described as {
      |Retrieves lab order data.
    }
  }
  result LabOrderResult is {
    orderId: LabOrderId with {
      briefly "Order ID"
      described as {
        |Lab order identifier.
      }
    }
    status: OrderStatus with {
      briefly "Status"
      described as {
        |Current order status.
      }
    }
  } with {
    briefly "Lab order result"
    described as {
      |Lab order data result.
    }
  }
  // States
  state OrderedState of record LabOrder.OrderedStateData is {
    initial handler OrderedStateHandler is {
      on collectSpecimen: command LabContext.LabOrder.CollectSpecimen is {
        morph entity LabContext.LabOrder to state LabContext.LabOrder.CollectionState with record LabOrder.CollectionStateData(orderId = collectSpecimen.orderId, specimen = collectSpecimen.specimen, patient = OrderedStateData.patient, orderingProvider = OrderedStateData.orderingProvider, facilityId = OrderedStateData.facilityId, orderDetails = OrderedStateData.orderDetails, status = OrderedStateData.status, orderedAt = OrderedStateData.orderedAt)
        tell event SpecimenCollected(orderId = collectSpecimen.orderId, specimen = collectSpecimen.specimen) to entity LabContext.LabOrder
      }
      on cancelOrder: command CancelOrder is {
        morph entity LabContext.LabOrder to state LabContext.LabOrder.CancelledState with record LabOrder.CancelledStateData(orderId = cancelOrder.orderId, cancelledBy = cancelOrder.cancelledBy, cancelledAt = cancelOrder.cancelledAt, reason = cancelOrder.reason, patient = OrderedStateData.patient, orderingProvider = OrderedStateData.orderingProvider, orderDetails = OrderedStateData.orderDetails, status = OrderedStateData.status)
        tell event OrderCancelled(orderId = cancelOrder.orderId, cancelledBy = cancelOrder.cancelledBy, cancelledAt = cancelOrder.cancelledAt, reason = cancelOrder.reason) to entity LabContext.LabOrder
      }
    } with {
      briefly "While OrderedState"
      described as {
        |The commands and folds accepted while the entity is in OrderedState.
      }
    }
  } with {
    briefly "Ordered state"
    described as {
      |State for a newly placed lab order.
    }
  }
  state CollectionState of record LabOrder.CollectionStateData is {
    initial handler CollectionStateHandler is {
      on receiveSpecimen: command ReceiveSpecimen is {
        morph entity LabContext.LabOrder to state LabContext.LabOrder.TestingState with record LabOrder.TestingStateData(orderId = receiveSpecimen.orderId, receivedAt = receiveSpecimen.receivedAt, patient = CollectionStateData.patient, orderingProvider = CollectionStateData.orderingProvider, facilityId = CollectionStateData.facilityId, orderDetails = CollectionStateData.orderDetails, specimen = CollectionStateData.specimen, testingStartedAt = empty, pendingResults = empty, status = CollectionStateData.status, orderedAt = CollectionStateData.orderedAt)
        tell event SpecimenReceived(orderId = receiveSpecimen.orderId, specimenId = receiveSpecimen.specimenId, receivedBy = receiveSpecimen.receivedBy, receivedAt = receiveSpecimen.receivedAt, specimenCondition = receiveSpecimen.specimenCondition) to entity LabContext.LabOrder
      }
      on cancelOrder: command CancelOrder is {
        morph entity LabContext.LabOrder to state LabContext.LabOrder.CancelledState with record LabOrder.CancelledStateData(orderId = cancelOrder.orderId, cancelledBy = cancelOrder.cancelledBy, cancelledAt = cancelOrder.cancelledAt, reason = cancelOrder.reason, patient = CollectionStateData.patient, orderingProvider = CollectionStateData.orderingProvider, orderDetails = CollectionStateData.orderDetails, status = CollectionStateData.status)
        tell event OrderCancelled(orderId = cancelOrder.orderId, cancelledBy = cancelOrder.cancelledBy, cancelledAt = cancelOrder.cancelledAt, reason = cancelOrder.reason) to entity LabContext.LabOrder
      }
    } with {
      briefly "While CollectionState"
      described as {
        |The commands and folds accepted while the entity is in CollectionState.
      }
    }
  } with {
    briefly "Collection state"
    described as {
      |State for specimen collection.
    }
  }
  state TestingState of record LabOrder.TestingStateData is {
    initial handler TestingStateHandler is {
      on verifyResult: command VerifyResult is {
        morph entity LabContext.LabOrder to state LabContext.LabOrder.ResultedState with record LabOrder.ResultedStateData(orderId = verifyResult.orderId, patient = TestingStateData.patient, orderingProvider = TestingStateData.orderingProvider, facilityId = TestingStateData.facilityId, orderDetails = TestingStateData.orderDetails, specimen = TestingStateData.specimen, results = prompt("the results of this resulted state data"), criticalValues = empty, status = TestingStateData.status, orderedAt = TestingStateData.orderedAt, completedAt = prompt("the completed at of this resulted state data"))
        tell event ResultVerified(orderId = verifyResult.orderId, resultId = verifyResult.resultId, verifiedBy = verifyResult.verifiedBy, verifiedAt = verifyResult.verifiedAt, comments = verifyResult.comments) to entity LabContext.LabOrder
        let sendResultNotification: type PhysicianNotificationService.SendResultNotification = prompt("a SendResultNotification telling the ordering provider their patient's result is verified and available, naming the test and summarising what it showed")
        send sendResultNotification to outlet LabOrderToPhysicianNotification
      }
      on cancelOrder: command CancelOrder is {
        morph entity LabContext.LabOrder to state LabContext.LabOrder.CancelledState with record LabOrder.CancelledStateData(orderId = cancelOrder.orderId, cancelledBy = cancelOrder.cancelledBy, cancelledAt = cancelOrder.cancelledAt, reason = cancelOrder.reason, patient = TestingStateData.patient, orderingProvider = TestingStateData.orderingProvider, orderDetails = TestingStateData.orderDetails, status = TestingStateData.status)
        tell event OrderCancelled(orderId = cancelOrder.orderId, cancelledBy = cancelOrder.cancelledBy, cancelledAt = cancelOrder.cancelledAt, reason = cancelOrder.reason) to entity LabContext.LabOrder
      }
    } with {
      briefly "While TestingState"
      described as {
        |The commands and folds accepted while the entity is in TestingState.
      }
    }
  } with {
    briefly "Testing state"
    described as {
      |State for active testing.
    }
  }
  state ResultedState of record LabOrder.ResultedStateData with {
    briefly "Resulted state"
    described as {
      |State for a completed lab order with results.
    }
  }
  state CancelledState of record LabOrder.CancelledStateData with {
    briefly "Cancelled state"
    described as {
      |Terminal state for a cancelled lab order.
    }
  }
  // Handler
  handler LabOrderHandler is {
    on init(patient: type PatientInfo, orderingProvider: type OrderingProviderInfo, facilityId: type FacilityId, orderDetails: type OrderDetails, orderedAt: TimeStamp) is {
      morph entity LabContext.LabOrder to state LabContext.LabOrder.OrderedState with record LabOrder.OrderedStateData(orderId = self.id, patient = patient, orderingProvider = orderingProvider, facilityId = facilityId, orderDetails = orderDetails, orderedAt = orderedAt, status = prompt("the status of this ordered state data"))
      tell event LabOrderPlaced(orderId = self.id, patient = patient, orderingProvider = orderingProvider, facilityId = facilityId, orderDetails = orderDetails, orderedAt = orderedAt) to entity LabContext.LabOrder
    }
    on startTesting: command StartTesting is {
      tell event TestingStarted(orderId = startTesting.orderId, testId = startTesting.testId, startedBy = startTesting.startedBy, startedAt = startTesting.startedAt, analyzerId = startTesting.analyzerId) to entity LabContext.LabOrder
    }
    on recordResult: command RecordResult is {
      tell event ResultRecorded(orderId = recordResult.orderId, result = recordResult.result) to entity LabContext.LabOrder
    }
    on reportCriticalValue: command ReportCriticalValue is {
      tell event CriticalValueReported(orderId = reportCriticalValue.orderId, criticalValue = reportCriticalValue.criticalValue) to entity LabContext.LabOrder
      let sendCriticalAlert: type PhysicianNotificationService.SendCriticalAlert = prompt("the send critical alert that results from report critical value")
      send sendCriticalAlert to outlet LabOrderToPhysicianNotification
    }
    on confirmCriticalValueReadBack: command ConfirmCriticalValueReadBack is {
      tell event CriticalValueReadBack(orderId = confirmCriticalValueReadBack.orderId, resultId = confirmCriticalValueReadBack.resultId, confirmedBy = confirmCriticalValueReadBack.confirmedBy, confirmedAt = confirmCriticalValueReadBack.confirmedAt) to entity LabContext.LabOrder
      let recordReadBack: type PhysicianNotificationService.RecordReadBack = prompt("a RecordReadBack telling the notification service who repeated the critical value back and when, so its record of the alert is closed")
      send recordReadBack to outlet LabOrderToPhysicianNotification
    }
    on getLabOrder: query GetLabOrder is {
      reply result LabOrderResult(orderId = getLabOrder.orderId, status = prompt("the status of this lab order result"))
    }
    on criticalValueReported: event CriticalValueReported is {
      do "apply CriticalValueReported to the labOrder so it can be persisted and replayed"
    }
    on criticalValueReadBack: event CriticalValueReadBack is {
      do "apply CriticalValueReadBack to the lab order so it can be persisted and replayed"
    }
    on labOrderPlaced: event LabOrderPlaced is {
      do "apply LabOrderPlaced to the labOrder so it can be persisted and replayed"
    }
    on orderCancelled: event OrderCancelled is {
      do "apply OrderCancelled to the labOrder so it can be persisted and replayed"
    }
    on resultRecorded: event ResultRecorded is {
      do "apply ResultRecorded to the labOrder so it can be persisted and replayed"
    }
    on resultVerified: event ResultVerified is {
      do "apply ResultVerified to the labOrder so it can be persisted and replayed"
    }
    on specimenCollected: event SpecimenCollected is {
      do "apply SpecimenCollected to the labOrder so it can be persisted and replayed"
    }
    on specimenReceived: event SpecimenReceived is {
      do "apply SpecimenReceived to the labOrder so it can be persisted and replayed"
    }
    on testingStarted: event TestingStarted is {
      do "apply TestingStarted to the labOrder so it can be persisted and replayed"
    }
  } with {
    briefly "Processes lab order commands"
    described as {
      | Handles laboratory order lifecycle from placement through
      | specimen collection, testing, result recording, verification,
      | critical value reporting, and cancellation.
    }
  }
} with {
  briefly "Lab order aggregate"
  described as {
    | The LabOrder entity manages laboratory orders including
    | specimen tracking, result recording, and critical value
    | notifications throughout the testing lifecycle.
  }
}
