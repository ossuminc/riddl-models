// NursingContext - Bounded Context for Nursing Workflow
// Contains repository and projectors for nursing operations
context NursingContext is {
  adaptor FromADTService from context ADTService is { 
    handler FromADTServiceHandler is {
      on result ADTService.CensusList is {
        do "the model receives census list"
      }
      on event ADTService.PatientAdmitted is {
        do "the model receives patient admitted"
      }
      on event ADTService.PatientDischarged is {
        do "the model receives patient discharged"
      }
      on event ADTService.PatientTransferred is {
        do "the model receives patient transferred"
      }
      on other is {
        error "Unexpected message for adaptor FromADTService"
      }
    } with {
      briefly "from adt service"
      described as {
        |Carries messages from the external ADTService.
      }
    }
  } with {
    briefly "ADTService integration"
    described as {
      |The model's side of the ADTService conversation.
    }
  }
  adaptor ToADTService to context ADTService is { 
    handler ToADTServiceHandler is {
      on query ADTService.GetPatientLocation is {
        do "the model sends get patient location"
      }
      on query ADTService.GetUnitCensus is {
        do "the model sends get unit census"
      }
      on other is {
        error "Unexpected message for adaptor ToADTService"
      }
    } with {
      briefly "to adt service"
      described as {
        |Carries messages to the external ADTService.
      }
    }
  } with {
    briefly "ADTService integration"
    described as {
      |The model's side of the ADTService conversation.
    }
  }
  adaptor FromMedicationAdministration from context MedicationAdministration is { 
    handler FromMedicationAdministrationHandler is {
      on result MedicationAdministration.AdministrationHistory is {
        do "the model receives administration history"
      }
      on result MedicationAdministration.DueMedicationList is {
        do "the model receives due medication list"
      }
      on event MedicationAdministration.MedicationAdministered is {
        do "the model receives medication administered"
      }
      on event MedicationAdministration.MedicationDue is {
        do "the model receives medication due"
      }
      on event MedicationAdministration.MedicationHeld is {
        do "the model receives medication held"
      }
      on other is {
        error "Unexpected message for adaptor FromMedicationAdministration"
      }
    } with {
      briefly "from medication administration"
      described as {
        |Carries messages from the external MedicationAdministration.
      }
    }
  } with {
    briefly "MedicationAdministration integration"
    described as {
      |The model's side of the MedicationAdministration conversation.
    }
  }
  adaptor ToMedicationAdministration to context MedicationAdministration is { 
    handler ToMedicationAdministrationHandler is {
      on command MedicationAdministration.DocumentAdministration is {
        do "the model sends document administration"
      }
      on command MedicationAdministration.DocumentHold is {
        do "the model sends document hold"
      }
      on query MedicationAdministration.GetDueMedications is {
        do "the model sends get due medications"
      }
      on query MedicationAdministration.GetMedicationHistory is {
        do "the model sends get medication history"
      }
      on other is {
        error "Unexpected message for adaptor ToMedicationAdministration"
      }
    } with {
      briefly "to medication administration"
      described as {
        |Carries messages to the external MedicationAdministration.
      }
    }
  } with {
    briefly "MedicationAdministration integration"
    described as {
      |The model's side of the MedicationAdministration conversation.
    }
  }
  adaptor FromOrderManagement from context OrderManagement is { 
    handler FromOrderManagementHandler is {
      on event OrderManagement.NursingOrderCreated is {
        do "the model receives nursing order created"
      }
      on event OrderManagement.NursingOrderDiscontinued is {
        do "the model receives nursing order discontinued"
      }
      on event OrderManagement.NursingOrderModified is {
        do "the model receives nursing order modified"
      }
      on result OrderManagement.OrderList is {
        do "the model receives order list"
      }
      on other is {
        error "Unexpected message for adaptor FromOrderManagement"
      }
    } with {
      briefly "from order management"
      described as {
        |Carries messages from the external OrderManagement.
      }
    }
  } with {
    briefly "OrderManagement integration"
    described as {
      |The model's side of the OrderManagement conversation.
    }
  }
  adaptor ToOrderManagement to context OrderManagement is { 
    handler ToOrderManagementHandler is {
      on command OrderManagement.AcknowledgeOrder is {
        do "the model sends acknowledge order"
      }
      on query OrderManagement.GetActiveOrders is {
        do "the model sends get active orders"
      }
      on query OrderManagement.GetOrdersByUnit is {
        do "the model sends get orders by unit"
      }
      on command OrderManagement.UpdateOrderStatus is {
        do "the model sends update order status"
      }
      on other is {
        error "Unexpected message for adaptor ToOrderManagement"
      }
    } with {
      briefly "to order management"
      described as {
        |Carries messages to the external OrderManagement.
      }
    }
  } with {
    briefly "OrderManagement integration"
    described as {
      |The model's side of the OrderManagement conversation.
    }
  }
  include "types.riddl"
  include "NurseShift.riddl"
  // ==========================================================================
  // Repository
  // ==========================================================================
  repository NursingRepository as merge is {
    record StoredNurseShift is  {
      nurseShiftId: UUID with {
        briefly "nurseShiftId"
        described as {
          |The nurseShiftId column of the stored nurseShift row.
        }
      }
    } with {
      briefly "Stored nurseShift row"
      described as {
        |The persistence shape of nurseShift data as this repository stores it.
      }
    }
    schema NurseShiftData is relational
      of nurseshifts as type StoredNurseShift
 with {
      briefly "Nurse shift data schema"
      described as {
        |The relational schema persisting nurse shift records for this repository.
      }
    }
    inlet NursingRepositoryFromNurseShift is type NurseShiftEvent    inlet NursingRepositoryFromNursePatientRatioProjector is type NurseShiftEvent    inlet NursingRepositoryFromTaskCompletionProjector is type NurseShiftEvent    inlet NursingRepositoryFromHandoffMetricsProjector is type NurseShiftEvent    outlet NursingRepositoryResponses is type NurseShift.NurseShiftResult
    // Assignment queries
    handler AssignmentQueries is {
      on query GetNursePatientRatio is {
        do "read the nurse patient ratio projection"
        reply result NursePatientRatioView
      }
      on query GetTaskCompletionMetrics is {
        do "read the task completion metrics projection"
        reply result TaskCompletionMetricsView
      }
      on query GetHandoffMetrics is {
        do "read the handoff metrics projection"
        reply result HandoffMetricsView
      }
      on query GetAssignmentsByShift is {
        reply result NurseShiftResult
      }
      on query GetAssignmentsByNurse is {
        reply result NurseShiftResult
      }
      on query GetAssignmentsByUnit is {
        reply result AssignmentList
      }
    } with {
      briefly "Handles assignment-related queries"
      described as {
        |Provides read access to nurse-patient assignment data.
      }
    }
    // Task queries
    handler TaskQueries is {
      on query GetTasksByShift is {
        reply result NurseShiftResult
      }
      on query GetPendingTasks is {
        reply result TaskList
      }
      on query GetOverdueTasks is {
        reply result TaskList
      }
      on query GetTasksByPatient is {
        reply result PatientLocationResult
      }
    } with {
      briefly "Handles task-related queries"
      described as {
        |Provides read access to nursing task data.
      }
    }
    // Shift queries
    handler ShiftQueries is {
      on query GetActiveShifts is {
        reply result ShiftList
      }
      on query GetShiftSummary is {
        reply result NurseShiftResult
      }
      on query GetHandoffReports is {
        reply result HandoffReportList
      }
    } with {
      briefly "Handles shift-related queries"
      described as {
        |Provides read access to shift and handoff data.
      }
    }
    // Define queries
    query GetAssignmentsByShift is  {
      shiftId: ShiftId with {
        briefly "Shift"
        described as {
          |Shift ID.
        }
      }
    } with {
      briefly "Query for assignments by shift"
      described as {
        |Retrieves all assignments associated with a shift.
      }
    }
    query GetAssignmentsByNurse is  {
      nurseId: NurseId with {
        briefly "Nurse"
        described as {
          |Nurse ID.
        }
      }
    } with {
      briefly "Query for assignments by nurse"
      described as {
        |Retrieves all assignments for a specific nurse.
      }
    }
    query GetAssignmentsByUnit is  {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
    } with {
      briefly "Query for assignments by unit"
      described as {
        |Retrieves all active assignments on a unit.
      }
    }
    query GetTasksByShift is  {
      shiftId: ShiftId with {
        briefly "Shift"
        described as {
          |Shift ID.
        }
      }
    } with {
      briefly "Query for tasks by shift"
      described as {
        |Retrieves all tasks for a specific shift.
      }
    }
    query GetPendingTasks is  {
      nurseId: NurseId with {
        briefly "Nurse"
        described as {
          |Nurse ID.
        }
      }
    } with {
      briefly "Query for pending tasks"
      described as {
        |Retrieves incomplete tasks for a nurse.
      }
    }
    query GetOverdueTasks is  {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
    } with {
      briefly "Query for overdue tasks"
      described as {
        |Retrieves tasks past due time for escalation.
      }
    }
    query GetTasksByPatient is  {
      patientId: PatientId with {
        briefly "Patient"
        described as {
          |Patient ID.
        }
      }
    } with {
      briefly "Query for tasks by patient"
      described as {
        |Retrieves all tasks for a patient.
      }
    }
    query GetActiveShifts is  {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
    } with {
      briefly "Query for active shifts"
      described as {
        |Retrieves currently active shifts on a unit.
      }
    }
    query GetShiftSummary is  {
      shiftId: ShiftId with {
        briefly "Shift"
        described as {
          |Shift ID.
        }
      }
    } with {
      briefly "Query for shift summary"
      described as {
        |Retrieves summary metrics for a shift.
      }
    }
    query GetHandoffReports is  {
      shiftId: ShiftId with {
        briefly "Shift"
        described as {
          |Shift ID.
        }
      }
    } with {
      briefly "Query for handoff reports"
      described as {
        |Retrieves SBAR handoff reports.
      }
    }
    // Results
    result AssignmentList is  {
      assignments: NurseAssignment* with {
        briefly "Assignments"
        described as {
          |Assignment list.
        }
      }
    } with {
      briefly "List of nurse assignments"
      described as {
        |Contains assignment records matching query criteria.
      }
    }
    result TaskList is  {
      tasks: NursingTask* with {
        briefly "Tasks"
        described as {
          |Task list.
        }
      }
    } with {
      briefly "List of nursing tasks"
      described as {
        |Contains task records matching query criteria.
      }
    }
    result ShiftList is  {
      shifts: ShiftSummary* with {
        briefly "Shifts"
        described as {
          |Shift list.
        }
      }
    } with {
      briefly "List of shift summaries"
      described as {
        |Contains shift summary records.
      }
    }
    result HandoffReportList is  {
      reports: HandoffReport* with {
        briefly "Reports"
        described as {
          |Report list.
        }
      }
    } with {
      briefly "List of handoff reports"
      described as {
        |Contains SBAR handoff reports.
      }
    }
  } with {
    briefly "Persistence and query repository for nursing data"
    described as {
      | Provides storage and retrieval for all nursing workflow data.
      | Supports queries for assignments, tasks, shifts, and handoffs.
      | Enables reporting and analytics on nursing operations.
    }
  }
  // ==========================================================================
  // Projectors
  // ==========================================================================
  query GetNursePatientRatio is  {
    nursePatientRatioKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which nurse patient ratio to retrieve.
      }
    }
  } with {
    briefly "Get nurse patient ratio"
    described as {
      |Retrieves the nurse patient ratio projection.
    }
  }
  result NursePatientRatioView is  {
    nursePatientRatio: NursePatientRatioProjector.NursePatientRatio with {
      briefly "Nurse patient ratio"
      described as {
        |The nurse patient ratio being returned.
      }
    }
  } with {
    briefly "Nurse patient ratio view"
    described as {
      |Read model view carrying the nurse patient ratio projection.
    }
  }
  projector NursePatientRatioProjector as flow is {
    updates repository NursingContext.NursingRepository
    inlet NursePatientRatioProjectorFromNurseShift is type NurseShiftEvent    outlet NursePatientRatioProjectorOut is type NurseShiftEvent
    record NursePatientRatio is  {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
      shiftDate: Date with {
        briefly "Date"
        described as {
          |Shift date.
        }
      }
      shiftType: String with {
        briefly "Type"
        described as {
          |Shift type.
        }
      }
      averageRatio: Number with {
        briefly "Average"
        described as {
          |Average ratio.
        }
      }
      maxRatio: Number with {
        briefly "Max"
        described as {
          |Maximum ratio.
        }
      }
      minRatio: Number with {
        briefly "Min"
        described as {
          |Minimum ratio.
        }
      }
      totalNurses: Number with {
        briefly "Nurses"
        described as {
          |Total nurses.
        }
      }
      totalPatients: Number with {
        briefly "Patients"
        described as {
          |Total patients.
        }
      }
      acuityAdjustedRatio: Number with {
        briefly "Adjusted"
        described as {
          |Acuity-adjusted ratio.
        }
      }
    } with {
      briefly "Nurse-to-patient ratio metrics"
      described as {
        |Aggregates staffing ratios for compliance and planning.
      }
    }
    handler RatioProjectionHandler is {
      on event PatientsAssigned is {
        tell event PatientsAssigned to repository NursingContext.NursingRepository
      }
      on event ShiftStarted is {
        tell event ShiftStarted to repository NursingContext.NursingRepository
      }
      on event HandoffCompleted is {
        tell event HandoffCompleted to repository NursingContext.NursingRepository
      }
    } with {
      briefly "Maintains nurse-patient ratio projections"
      described as {
        |Processes events to keep ratio metrics current.
      }
    }
  } with {
    briefly "Projects nurse-to-patient staffing ratios"
    described as {
      | Maintains real-time and historical nurse-patient ratios by unit.
      | Supports regulatory compliance monitoring and staffing decisions.
      | Includes acuity-adjusted ratios for workload analysis.
    }
  }
  query GetTaskCompletionMetrics is  {
    taskCompletionMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which task completion metrics to retrieve.
      }
    }
  } with {
    briefly "Get task completion metrics"
    described as {
      |Retrieves the task completion metrics projection.
    }
  }
  result TaskCompletionMetricsView is  {
    taskCompletionMetrics: TaskCompletionProjector.TaskCompletionMetrics with {
      briefly "Task completion metrics"
      described as {
        |The task completion metrics being returned.
      }
    }
  } with {
    briefly "Task completion metrics view"
    described as {
      |Read model view carrying the task completion metrics projection.
    }
  }
  projector TaskCompletionProjector as flow is {
    updates repository NursingContext.NursingRepository
    inlet TaskCompletionProjectorFromNurseShift is type NurseShiftEvent    outlet TaskCompletionProjectorOut is type NurseShiftEvent
    record TaskCompletionMetrics is  {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
      shiftDate: Date with {
        briefly "Date"
        described as {
          |Shift date.
        }
      }
      shiftType: String with {
        briefly "Type"
        described as {
          |Shift type.
        }
      }
      totalTasks: Number with {
        briefly "Total"
        described as {
          |Total tasks.
        }
      }
      completedOnTime: Number with {
        briefly "On time"
        described as {
          |Completed on time.
        }
      }
      completedLate: Number with {
        briefly "Late"
        described as {
          |Completed late.
        }
      }
      deferred: Number with {
        briefly "Deferred"
        described as {
          |Deferred count.
        }
      }
      cancelled: Number with {
        briefly "Cancelled"
        described as {
          |Cancelled count.
        }
      }
      completionRate: Number with {
        briefly "Rate"
        described as {
          |Completion rate.
        }
      }
      onTimeRate: Number with {
        briefly "On time rate"
        described as {
          |On-time rate.
        }
      }
      averageCompletionTime: Duration with {
        briefly "Avg time"
        described as {
          |Average completion time.
        }
      }
    } with {
      briefly "Task completion performance metrics"
      described as {
        |Tracks task completion rates and timeliness.
      }
    }
    handler TaskMetricsHandler is {
      on event TaskCreated is {
        tell event TaskCreated to repository NursingContext.NursingRepository
      }
      on event TaskCompleted is {
        tell event TaskCompleted to repository NursingContext.NursingRepository
      }
    } with {
      briefly "Maintains task completion projections"
      described as {
        |Processes task events to maintain metrics.
      }
    }
  } with {
    briefly "Projects task completion rates and performance"
    described as {
      | Tracks task completion metrics for quality improvement.
      | Identifies patterns in task deferral and late completion.
      | Supports nursing leadership dashboards and reporting.
    }
  }
  query GetHandoffMetrics is  {
    handoffMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which handoff metrics to retrieve.
      }
    }
  } with {
    briefly "Get handoff metrics"
    described as {
      |Retrieves the handoff metrics projection.
    }
  }
  result HandoffMetricsView is  {
    handoffMetrics: HandoffMetricsProjector.HandoffMetrics with {
      briefly "Handoff metrics"
      described as {
        |The handoff metrics being returned.
      }
    }
  } with {
    briefly "Handoff metrics view"
    described as {
      |Read model view carrying the handoff metrics projection.
    }
  }
  projector HandoffMetricsProjector as flow is {
    updates repository NursingContext.NursingRepository
    inlet HandoffMetricsProjectorFromNurseShift is type NurseShiftEvent    outlet HandoffMetricsProjectorOut is type NurseShiftEvent
    record HandoffMetrics is  {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
      shiftDate: Date with {
        briefly "Date"
        described as {
          |Shift date.
        }
      }
      totalHandoffs: Number with {
        briefly "Total"
        described as {
          |Total handoffs.
        }
      }
      acknowledgedOnTime: Number with {
        briefly "On time"
        described as {
          |Acknowledged on time.
        }
      }
      averageHandoffDuration: Duration with {
        briefly "Avg duration"
        described as {
          |Average handoff duration.
        }
      }
      tasksTransferred: Number with {
        briefly "Transferred"
        described as {
          |Tasks transferred.
        }
      }
      incompleteHandoffs: Number with {
        briefly "Incomplete"
        described as {
          |Incomplete handoffs.
        }
      }
    } with {
      briefly "Shift handoff quality metrics"
      described as {
        |Tracks handoff completion and quality indicators.
      }
    }
    handler HandoffMetricsHandler is {
      on event HandoffInitiated is {
        tell event HandoffInitiated to repository NursingContext.NursingRepository
      }
      on event HandoffCompleted is {
        tell event HandoffCompleted to repository NursingContext.NursingRepository
      }
    } with {
      briefly "Maintains handoff quality projections"
      described as {
        |Processes handoff events to maintain metrics.
      }
    }
  } with {
    briefly "Projects handoff quality and compliance metrics"
    described as {
      | Monitors shift handoff quality for patient safety.
      | Tracks SBAR compliance and acknowledgment rates.
      | Identifies units with handoff process issues.
    }
  }
  type NurseShiftEvent is one of {
    NursingContext.NurseShift.ShiftStarted or NursingContext.NurseShift.PatientsAssigned or NursingContext.NurseShift.TaskCreated or NursingContext.NurseShift.TaskCompleted or NursingContext.NurseShift.AssessmentDocumented or NursingContext.NurseShift.VitalsRecorded or NursingContext.NurseShift.HandoffInitiated or NursingContext.NurseShift.HandoffCompleted
  } with {
    briefly "Nurse shift events"
    described as {
      |Union of all nurse shift entity events for streaming.
    }
  }
  processor NurseShiftSource as source is {
    outlet NurseShiftEvents is type NurseShiftEvent
 with {
      briefly "Nurse shift event outlet"
      described as {
        |Publishes nurse shift events.
      }
    }
    handler NurseShiftSourceHandler is {
      on init is {
        tell command NurseShift.InitializeNurseShift to entity NursingContext.NurseShift
      }
      on event NurseShift.ShiftStarted is {
        send event NurseShift.ShiftStarted to outlet NurseShiftEvents
      }
      on event NurseShift.HandoffCompleted is {
        send event NurseShift.HandoffCompleted to outlet NurseShiftEvents
      }
      on other is {
        error "Unexpected message for source NurseShiftSource"
      }
    } with {
      briefly "Nurse shift source handler"
      described as {
        |Forwards nurse shift events to the outlet.
      }
    }
  } with {
    briefly "Nurse shift event source"
    described as {
      |Source streamlet that publishes nurse shift events.
    }
  }
  processor NurseShiftSink as sink is {
    inlet NurseShiftEventsIn is type NurseShiftEvent with {
      briefly "Nurse shift event inlet"
      described as {
        |Receives nurse shift events.
      }
    }
    handler NurseShiftSinkHandler is {
      on init is { ??? }
      on event NurseShift.ShiftStarted is {
        tell event NurseShift.ShiftStarted to repository NursingContext.NursingRepository
      }
      on event NurseShift.HandoffCompleted is {
        tell event NurseShift.HandoffCompleted to repository NursingContext.NursingRepository
      }
      on other is {
        error "Unexpected message for sink NurseShiftSink"
      }
    } with {
      briefly "Nurse shift sink handler"
      described as {
        |Persists nurse shift events from the inlet.
      }
    }
  } with {
    briefly "Nurse shift event sink"
    described as {
      |Sink streamlet that consumes nurse shift events.
    }
  }
  connector NurseShiftFlow is from outlet NursingContext.NurseShiftSource.NurseShiftEvents to inlet NursingContext.NurseShiftSink.NurseShiftEventsIn with {
    briefly "Nurse shift event flow"
    described as {
      |Connects nurse shift source to sink for event streaming.
    }
  }
  processor NurseShiftEventSplit as split is {
    inlet NurseShiftEventSplitIn is type NurseShiftEvent    outlet NurseShiftEventSplitToNursingRepository is type NurseShiftEvent
    outlet NurseShiftEventSplitToNursePatientRatioProjector is type NurseShiftEvent
    outlet NurseShiftEventSplitToTaskCompletionProjector is type NurseShiftEvent
    outlet NurseShiftEventSplitToHandoffMetricsProjector is type NurseShiftEvent
    handler NurseShiftEventSplitHandler is {
      on event NurseShift.ShiftStarted is {
        send event NurseShift.ShiftStarted to outlet NurseShiftEventSplitToNursingRepository
        send event NurseShift.ShiftStarted to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send event NurseShift.ShiftStarted to outlet NurseShiftEventSplitToTaskCompletionProjector
        send event NurseShift.ShiftStarted to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell event NurseShift.ShiftStarted to entity NursingContext.NurseShift
      }
      on event NurseShift.PatientsAssigned is {
        send event NurseShift.PatientsAssigned to outlet NurseShiftEventSplitToNursingRepository
        send event NurseShift.PatientsAssigned to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send event NurseShift.PatientsAssigned to outlet NurseShiftEventSplitToTaskCompletionProjector
        send event NurseShift.PatientsAssigned to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell event NurseShift.PatientsAssigned to entity NursingContext.NurseShift
      }
      on event NurseShift.TaskCreated is {
        send event NurseShift.TaskCreated to outlet NurseShiftEventSplitToNursingRepository
        send event NurseShift.TaskCreated to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send event NurseShift.TaskCreated to outlet NurseShiftEventSplitToTaskCompletionProjector
        send event NurseShift.TaskCreated to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell event NurseShift.TaskCreated to entity NursingContext.NurseShift
      }
      on event NurseShift.TaskCompleted is {
        send event NurseShift.TaskCompleted to outlet NurseShiftEventSplitToNursingRepository
        send event NurseShift.TaskCompleted to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send event NurseShift.TaskCompleted to outlet NurseShiftEventSplitToTaskCompletionProjector
        send event NurseShift.TaskCompleted to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell event NurseShift.TaskCompleted to entity NursingContext.NurseShift
      }
      on event NurseShift.AssessmentDocumented is {
        send event NurseShift.AssessmentDocumented to outlet NurseShiftEventSplitToNursingRepository
        send event NurseShift.AssessmentDocumented to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send event NurseShift.AssessmentDocumented to outlet NurseShiftEventSplitToTaskCompletionProjector
        send event NurseShift.AssessmentDocumented to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell event NurseShift.AssessmentDocumented to entity NursingContext.NurseShift
      }
      on event NurseShift.VitalsRecorded is {
        send event NurseShift.VitalsRecorded to outlet NurseShiftEventSplitToNursingRepository
        send event NurseShift.VitalsRecorded to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send event NurseShift.VitalsRecorded to outlet NurseShiftEventSplitToTaskCompletionProjector
        send event NurseShift.VitalsRecorded to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell event NurseShift.VitalsRecorded to entity NursingContext.NurseShift
      }
      on event NurseShift.HandoffInitiated is {
        send event NurseShift.HandoffInitiated to outlet NurseShiftEventSplitToNursingRepository
        send event NurseShift.HandoffInitiated to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send event NurseShift.HandoffInitiated to outlet NurseShiftEventSplitToTaskCompletionProjector
        send event NurseShift.HandoffInitiated to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell event NurseShift.HandoffInitiated to entity NursingContext.NurseShift
      }
      on event NurseShift.HandoffCompleted is {
        send event NurseShift.HandoffCompleted to outlet NurseShiftEventSplitToNursingRepository
        send event NurseShift.HandoffCompleted to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send event NurseShift.HandoffCompleted to outlet NurseShiftEventSplitToTaskCompletionProjector
        send event NurseShift.HandoffCompleted to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell event NurseShift.HandoffCompleted to entity NursingContext.NurseShift
      }
      on other is {
        error "Unexpected message for processor NurseShiftEventSplit"
      }
    } with {
      briefly "NurseShift event fan-out handler"
      described as {
        |Delivers each NurseShift event to all of its consumers.
      }
    }
  } with {
    briefly "NurseShift event fan-out"
    described as {
      |Fans NurseShift events out to the repository and projectors.
    }
  }
  connector 'NurseShiftEvent Stream' is from outlet NursingContext.NurseShift.NurseShiftEvents2 to inlet NursingContext.NurseShiftEventSplit.NurseShiftEventSplitIn with {
    briefly "NurseShift events, fanned out to storage and read models"
  }
  connector 'NurseShiftEvent Storage' is from outlet NursingContext.NurseShiftEventSplit.NurseShiftEventSplitToNursingRepository to inlet NursingContext.NursingRepository.NursingRepositoryFromNurseShift with {
    briefly "NurseShift events on their way to storage"
  }
  connector 'NursePatientRatioProjector Feed' is from outlet NursingContext.NurseShiftEventSplit.NurseShiftEventSplitToNursePatientRatioProjector to inlet NursingContext.NursePatientRatioProjector.NursePatientRatioProjectorFromNurseShift with {
    briefly "NurseShift events feeding the NursePatientRatioProjector projection"
  }
  connector 'TaskCompletionProjector Feed' is from outlet NursingContext.NurseShiftEventSplit.NurseShiftEventSplitToTaskCompletionProjector to inlet NursingContext.TaskCompletionProjector.TaskCompletionProjectorFromNurseShift with {
    briefly "NurseShift events feeding the TaskCompletionProjector projection"
  }
  connector 'HandoffMetricsProjector Feed' is from outlet NursingContext.NurseShiftEventSplit.NurseShiftEventSplitToHandoffMetricsProjector to inlet NursingContext.HandoffMetricsProjector.HandoffMetricsProjectorFromNurseShift with {
    briefly "NurseShift events feeding the HandoffMetricsProjector projection"
  }
  connector 'NursePatientRatioProjector Storage' is from outlet NursingContext.NursePatientRatioProjector.NursePatientRatioProjectorOut to inlet NursingContext.NursingRepository.NursingRepositoryFromNursePatientRatioProjector with {
    briefly "The NursePatientRatioProjector projection on its way to storage"
  }
  connector 'TaskCompletionProjector Storage' is from outlet NursingContext.TaskCompletionProjector.TaskCompletionProjectorOut to inlet NursingContext.NursingRepository.NursingRepositoryFromTaskCompletionProjector with {
    briefly "The TaskCompletionProjector projection on its way to storage"
  }
  connector 'HandoffMetricsProjector Storage' is from outlet NursingContext.HandoffMetricsProjector.HandoffMetricsProjectorOut to inlet NursingContext.NursingRepository.NursingRepositoryFromHandoffMetricsProjector with {
    briefly "The HandoffMetricsProjector projection on its way to storage"
  }
} with {
  briefly "Bounded context for nursing workflow operations"
  described as {
    | NursingContext encapsulates all nursing workflow functionality.
    | Contains the NurseShift aggregate and supporting infrastructure.
    | Provides repositories for persistence and projectors for analytics.
    | Integrates with external systems for patient data and orders.
  }
}
