// NursingContext - Bounded Context for Nursing Workflow
// Contains repository and projectors for nursing operations
context NursingContext as router is {
  inlet NurseShiftCommandStreamIn is type NurseShiftCommand  outlet NurseShiftCommandStreamOut is type NurseShiftCommand
  inlet NurseShiftResultStreamIn is result NurseShift.NurseShiftResult  outlet NurseShiftResultStreamOut is result NurseShift.NurseShiftResult
  handler NursingContextBoundary is {
    on startShift: command NurseShift.StartShift is {
      send startShift to outlet NursingContext.NurseShiftCommandStreamOut
    }
    on assignPatients: command NurseShift.AssignPatients is {
      send assignPatients to outlet NursingContext.NurseShiftCommandStreamOut
    }
    on createTask: command NurseShift.CreateTask is {
      send createTask to outlet NursingContext.NurseShiftCommandStreamOut
    }
    on completeTask: command NurseShift.CompleteTask is {
      send completeTask to outlet NursingContext.NurseShiftCommandStreamOut
    }
    on documentAssessment: command NurseShift.DocumentAssessment is {
      send documentAssessment to outlet NursingContext.NurseShiftCommandStreamOut
    }
    on recordVitals: command NurseShift.RecordVitals is {
      send recordVitals to outlet NursingContext.NurseShiftCommandStreamOut
    }
    on initiateHandoff: command NurseShift.InitiateHandoff is {
      send initiateHandoff to outlet NursingContext.NurseShiftCommandStreamOut
    }
    on completeHandoff: command NurseShift.CompleteHandoff is {
      send completeHandoff to outlet NursingContext.NurseShiftCommandStreamOut
    }
    on nurseShiftResult: result NurseShift.NurseShiftResult is {
      send nurseShiftResult to outlet NursingContext.NurseShiftResultStreamOut
    }
    on other is {
      error "Unexpected message at the NursingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'NurseShiftCommand Stream Intake' is from outlet NursingContext.NurseShiftCommandStreamOut to inlet NursingContext.NurseShift.NurseShiftCommands  connector 'NurseShiftResult Stream Egress' is from outlet NursingContext.NursingRepository.NursingRepositoryResponses to inlet NursingContext.NurseShiftResultStreamIn  adaptor FromADTService from context ADTService is { 
    handler FromADTServiceHandler is {
      on result ADTService.CensusList is {
        do "the model receives census list"
      }
      on event ADTService.PatientAdmitted is {
        do "the model receives patient admitted"
      }
      on event ADTService.PatientDischarged is {
        do "the model receives patient discharged"
      }
      on event ADTService.PatientTransferred is {
        do "the model receives patient transferred"
      }
      on other is {
        error "Unexpected message for adaptor FromADTService"
      }
    } with {
      briefly "from adt service"
      described as {
        |Carries messages from the external ADTService.
      }
    }
  } with {
    briefly "ADTService integration"
    described as {
      |The model's side of the ADTService conversation.
    }
  }
  adaptor ToADTService to context ADTService is { 
    handler ToADTServiceHandler is {
      on query ADTService.GetPatientLocation is {
        do "the model sends get patient location"
      }
      on query ADTService.GetUnitCensus is {
        do "the model sends get unit census"
      }
      on other is {
        error "Unexpected message for adaptor ToADTService"
      }
    } with {
      briefly "to adt service"
      described as {
        |Carries messages to the external ADTService.
      }
    }
  } with {
    briefly "ADTService integration"
    described as {
      |The model's side of the ADTService conversation.
    }
  }
  adaptor FromMedicationAdministration from context MedicationAdministration is { 
    handler FromMedicationAdministrationHandler is {
      on result MedicationAdministration.AdministrationHistory is {
        do "the model receives administration history"
      }
      on result MedicationAdministration.DueMedicationList is {
        do "the model receives due medication list"
      }
      on event MedicationAdministration.MedicationAdministered is {
        do "the model receives medication administered"
      }
      on event MedicationAdministration.MedicationDue is {
        do "the model receives medication due"
      }
      on event MedicationAdministration.MedicationHeld is {
        do "the model receives medication held"
      }
      on other is {
        error "Unexpected message for adaptor FromMedicationAdministration"
      }
    } with {
      briefly "from medication administration"
      described as {
        |Carries messages from the external MedicationAdministration.
      }
    }
  } with {
    briefly "MedicationAdministration integration"
    described as {
      |The model's side of the MedicationAdministration conversation.
    }
  }
  adaptor ToMedicationAdministration to context MedicationAdministration is { 
    handler ToMedicationAdministrationHandler is {
      on command MedicationAdministration.DocumentAdministration is {
        do "the model sends document administration"
      }
      on command MedicationAdministration.DocumentHold is {
        do "the model sends document hold"
      }
      on query MedicationAdministration.GetDueMedications is {
        do "the model sends get due medications"
      }
      on query MedicationAdministration.GetMedicationHistory is {
        do "the model sends get medication history"
      }
      on other is {
        error "Unexpected message for adaptor ToMedicationAdministration"
      }
    } with {
      briefly "to medication administration"
      described as {
        |Carries messages to the external MedicationAdministration.
      }
    }
  } with {
    briefly "MedicationAdministration integration"
    described as {
      |The model's side of the MedicationAdministration conversation.
    }
  }
  adaptor FromOrderManagement from context OrderManagement is { 
    handler FromOrderManagementHandler is {
      on event OrderManagement.NursingOrderCreated is {
        do "the model receives nursing order created"
      }
      on event OrderManagement.NursingOrderDiscontinued is {
        do "the model receives nursing order discontinued"
      }
      on event OrderManagement.NursingOrderModified is {
        do "the model receives nursing order modified"
      }
      on result OrderManagement.OrderList is {
        do "the model receives order list"
      }
      on other is {
        error "Unexpected message for adaptor FromOrderManagement"
      }
    } with {
      briefly "from order management"
      described as {
        |Carries messages from the external OrderManagement.
      }
    }
  } with {
    briefly "OrderManagement integration"
    described as {
      |The model's side of the OrderManagement conversation.
    }
  }
  adaptor ToOrderManagement to context OrderManagement is { 
    handler ToOrderManagementHandler is {
      on command OrderManagement.AcknowledgeOrder is {
        do "the model sends acknowledge order"
      }
      on query OrderManagement.GetActiveOrders is {
        do "the model sends get active orders"
      }
      on query OrderManagement.GetOrdersByUnit is {
        do "the model sends get orders by unit"
      }
      on command OrderManagement.UpdateOrderStatus is {
        do "the model sends update order status"
      }
      on other is {
        error "Unexpected message for adaptor ToOrderManagement"
      }
    } with {
      briefly "to order management"
      described as {
        |Carries messages to the external OrderManagement.
      }
    }
  } with {
    briefly "OrderManagement integration"
    described as {
      |The model's side of the OrderManagement conversation.
    }
  }
  include "types.riddl"
  include "NurseShift.riddl"
  // ==========================================================================
  // Repository
  // ==========================================================================
  type NursingRepositoryCommand is one of {
    NursingContext.NursingRepository.PersistAssessmentDocumented or NursingContext.NursingRepository.PersistHandoffCompleted or NursingContext.NursingRepository.PersistHandoffInitiated or NursingContext.NursingRepository.PersistPatientsAssigned or NursingContext.NursingRepository.PersistShiftStarted or NursingContext.NursingRepository.PersistTaskCompleted or NursingContext.NursingRepository.PersistTaskCreated or NursingContext.NursingRepository.PersistVitalsRecorded
  } with {
    briefly "Anything that writes NursingRepository"
    described as {
      |The persistence commands NursingRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository NursingRepository as flow is {
    inlet NursingRepositoryFromNursePatientRatioProjector is type NursingRepositoryCommand    command PersistAssessmentDocumented is {
      shiftId: ShiftId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssessmentDocumented applies to.
        }
      }
    } with {
      briefly "Persist AssessmentDocumented"
      described as {
        |Instructs this repository to apply AssessmentDocumented to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVitalsRecorded is {
      shiftId: ShiftId with {
        briefly "Row addressed"
        described as {
          |Which stored row VitalsRecorded applies to.
        }
      }
    } with {
      briefly "Persist VitalsRecorded"
      described as {
        |Instructs this repository to apply VitalsRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHandoffCompleted is {
      shiftId: ShiftId with {
        briefly "Row addressed"
        described as {
          |Which stored row HandoffCompleted applies to.
        }
      }
    } with {
      briefly "Persist HandoffCompleted"
      described as {
        |Instructs this repository to apply HandoffCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHandoffInitiated is {
      shiftId: ShiftId with {
        briefly "Row addressed"
        described as {
          |Which stored row HandoffInitiated applies to.
        }
      }
    } with {
      briefly "Persist HandoffInitiated"
      described as {
        |Instructs this repository to apply HandoffInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPatientsAssigned is {
      shiftId: ShiftId with {
        briefly "Row addressed"
        described as {
          |Which stored row PatientsAssigned applies to.
        }
      }
    } with {
      briefly "Persist PatientsAssigned"
      described as {
        |Instructs this repository to apply PatientsAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShiftStarted is {
      shiftId: ShiftId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShiftStarted applies to.
        }
      }
    } with {
      briefly "Persist ShiftStarted"
      described as {
        |Instructs this repository to apply ShiftStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTaskCompleted is {
      shiftId: ShiftId with {
        briefly "Row addressed"
        described as {
          |Which stored row TaskCompleted applies to.
        }
      }
    } with {
      briefly "Persist TaskCompleted"
      described as {
        |Instructs this repository to apply TaskCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTaskCreated is {
      shiftId: ShiftId with {
        briefly "Row addressed"
        described as {
          |Which stored row TaskCreated applies to.
        }
      }
    } with {
      briefly "Persist TaskCreated"
      described as {
        |Instructs this repository to apply TaskCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredNurseShift is {
      nurseShiftId: UUID with {
        briefly "nurseShiftId"
        described as {
          |The nurseShiftId column of the stored nurseShift row.
        }
      }
    } with {
      briefly "Stored nurseShift row"
      described as {
        |The persistence shape of nurseShift data as this repository stores it.
      }
    }
    schema NurseShiftData is relational
      of nurseshifts as record StoredNurseShift
        index on field StoredNurseShift.nurseShiftId
 with {
      briefly "Nurse shift data schema"
      described as {
        |The relational schema persisting nurse shift records for this repository.
      }
    }
    outlet NursingRepositoryResponses is result NurseShift.NurseShiftResult
    // Assignment queries
    handler AssignmentQueries is {
      on persistAssessmentDocumented: command PersistAssessmentDocumented is {
        do "apply AssessmentDocumented to the stored row"
      }
      on persistVitalsRecorded: command PersistVitalsRecorded is {
        do "apply VitalsRecorded to the stored row"
      }
      on persistHandoffCompleted: command PersistHandoffCompleted is {
        do "apply HandoffCompleted to the stored row"
      }
      on persistHandoffInitiated: command PersistHandoffInitiated is {
        do "apply HandoffInitiated to the stored row"
      }
      on persistPatientsAssigned: command PersistPatientsAssigned is {
        do "apply PatientsAssigned to the stored row"
      }
      on persistShiftStarted: command PersistShiftStarted is {
        do "apply ShiftStarted to the stored row"
      }
      on persistTaskCompleted: command PersistTaskCompleted is {
        do "apply TaskCompleted to the stored row"
      }
      on persistTaskCreated: command PersistTaskCreated is {
        do "apply TaskCreated to the stored row"
      }
      on query GetNursePatientRatio is {
        let nursePatientRatioView: type NursePatientRatioView = prompt("read the nurse patient ratio projection")
        reply nursePatientRatioView
      }
      on query GetTaskCompletionMetrics is {
        let taskCompletionMetricsView: type TaskCompletionMetricsView = prompt("read the task completion metrics projection")
        reply taskCompletionMetricsView
      }
      on query GetHandoffMetrics is {
        let handoffMetricsView: type HandoffMetricsView = prompt("read the handoff metrics projection")
        reply handoffMetricsView
      }
      on getAssignmentsByShift: query GetAssignmentsByShift is {
        reply result NurseShiftResult(shiftId = getAssignmentsByShift.shiftId, nurseId = prompt("the nurse id of this nurse shift result"), unitId = prompt("the unit id of this nurse shift result"))
      }
      on getAssignmentsByNurse: query GetAssignmentsByNurse is {
        reply result NurseShiftResult(nurseId = getAssignmentsByNurse.nurseId, shiftId = prompt("the shift id of this nurse shift result"), unitId = prompt("the unit id of this nurse shift result"))
      }
      on query GetAssignmentsByUnit is {
        let assignmentList: type AssignmentList = prompt("read the assignment list that assignments by unit asks for")
        reply assignmentList
      }
    } with {
      briefly "Handles assignment-related queries"
      described as {
        |Provides read access to nurse-patient assignment data.
      }
    }
    // Task queries
    handler TaskQueries is {
      on getTasksByShift: query GetTasksByShift is {
        reply result NurseShiftResult(shiftId = getTasksByShift.shiftId, nurseId = prompt("the nurse id of this nurse shift result"), unitId = prompt("the unit id of this nurse shift result"))
      }
      on query GetPendingTasks is {
        let taskList: type TaskList = prompt("read the task list that pending tasks asks for")
        reply taskList
      }
      on query GetOverdueTasks is {
        let taskList: type TaskList = prompt("read the task list that overdue tasks asks for")
        reply taskList
      }
      on query GetTasksByPatient is {
        let patientLocationResult: type PatientLocationResult = prompt("read the patient location that tasks by patient asks for")
        reply patientLocationResult
      }
    } with {
      briefly "Handles task-related queries"
      described as {
        |Provides read access to nursing task data.
      }
    }
    // Shift queries
    handler ShiftQueries is {
      on query GetActiveShifts is {
        let shiftList: type ShiftList = prompt("read the shift list that active shifts asks for")
        reply shiftList
      }
      on getShiftSummary: query GetShiftSummary is {
        reply result NurseShiftResult(shiftId = getShiftSummary.shiftId, nurseId = prompt("the nurse id of this nurse shift result"), unitId = prompt("the unit id of this nurse shift result"))
      }
      on query GetHandoffReports is {
        let handoffReportList: type HandoffReportList = prompt("read the handoff report list that handoff reports asks for")
        reply handoffReportList
      }
    } with {
      briefly "Handles shift-related queries"
      described as {
        |Provides read access to shift and handoff data.
      }
    }
    // Define queries
    query GetAssignmentsByShift replies result NurseShiftResult is {
      shiftId: ShiftId with {
        briefly "Shift"
        described as {
          |Shift ID.
        }
      }
    } with {
      briefly "Query for assignments by shift"
      described as {
        |Retrieves all assignments associated with a shift.
      }
    }
    query GetAssignmentsByNurse replies result NurseShiftResult is {
      nurseId: NurseId with {
        briefly "Nurse"
        described as {
          |Nurse ID.
        }
      }
    } with {
      briefly "Query for assignments by nurse"
      described as {
        |Retrieves all assignments for a specific nurse.
      }
    }
    query GetAssignmentsByUnit replies result AssignmentList is {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
    } with {
      briefly "Query for assignments by unit"
      described as {
        |Retrieves all active assignments on a unit.
      }
    }
    query GetTasksByShift replies result NurseShiftResult is {
      shiftId: ShiftId with {
        briefly "Shift"
        described as {
          |Shift ID.
        }
      }
    } with {
      briefly "Query for tasks by shift"
      described as {
        |Retrieves all tasks for a specific shift.
      }
    }
    query GetPendingTasks replies result TaskList is {
      nurseId: NurseId with {
        briefly "Nurse"
        described as {
          |Nurse ID.
        }
      }
    } with {
      briefly "Query for pending tasks"
      described as {
        |Retrieves incomplete tasks for a nurse.
      }
    }
    query GetOverdueTasks replies result TaskList is {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
    } with {
      briefly "Query for overdue tasks"
      described as {
        |Retrieves tasks past due time for escalation.
      }
    }
    query GetTasksByPatient replies result PatientLocationResult is {
      patientId: PatientId with {
        briefly "Patient"
        described as {
          |Patient ID.
        }
      }
    } with {
      briefly "Query for tasks by patient"
      described as {
        |Retrieves all tasks for a patient.
      }
    }
    query GetActiveShifts replies result ShiftList is {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
    } with {
      briefly "Query for active shifts"
      described as {
        |Retrieves currently active shifts on a unit.
      }
    }
    query GetShiftSummary replies result NurseShiftResult is {
      shiftId: ShiftId with {
        briefly "Shift"
        described as {
          |Shift ID.
        }
      }
    } with {
      briefly "Query for shift summary"
      described as {
        |Retrieves summary metrics for a shift.
      }
    }
    query GetHandoffReports replies result HandoffReportList is {
      shiftId: ShiftId with {
        briefly "Shift"
        described as {
          |Shift ID.
        }
      }
    } with {
      briefly "Query for handoff reports"
      described as {
        |Retrieves SBAR handoff reports.
      }
    }
    // Results
    result AssignmentList is {
      assignments: NurseAssignment* with {
        briefly "Assignments"
        described as {
          |Assignment list.
        }
      }
    } with {
      briefly "List of nurse assignments"
      described as {
        |Contains assignment records matching query criteria.
      }
    }
    result TaskList is {
      tasks: NursingTask* with {
        briefly "Tasks"
        described as {
          |Task list.
        }
      }
    } with {
      briefly "List of nursing tasks"
      described as {
        |Contains task records matching query criteria.
      }
    }
    result ShiftList is {
      shifts: ShiftSummary* with {
        briefly "Shifts"
        described as {
          |Shift list.
        }
      }
    } with {
      briefly "List of shift summaries"
      described as {
        |Contains shift summary records.
      }
    }
    result HandoffReportList is {
      reports: HandoffReport* with {
        briefly "Reports"
        described as {
          |Report list.
        }
      }
    } with {
      briefly "List of handoff reports"
      described as {
        |Contains SBAR handoff reports.
      }
    }
  } with {
    briefly "Persistence and query repository for nursing data"
    described as {
      | Provides storage and retrieval for all nursing workflow data.
      | Supports queries for assignments, tasks, shifts, and handoffs.
      | Enables reporting and analytics on nursing operations.
    }
  }
  // ==========================================================================
  // Projectors
  // ==========================================================================
  query GetNursePatientRatio replies result NursePatientRatioView is {
    nursePatientRatioKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which nurse patient ratio to retrieve.
      }
    }
  } with {
    briefly "Get nurse patient ratio"
    described as {
      |Retrieves the nurse patient ratio projection.
    }
  }
  result NursePatientRatioView is {
    nursePatientRatio: NursePatientRatioProjector.NursePatientRatio with {
      briefly "Nurse patient ratio"
      described as {
        |The nurse patient ratio being returned.
      }
    }
  } with {
    briefly "Nurse patient ratio view"
    described as {
      |Read model view carrying the nurse patient ratio projection.
    }
  }
  projector NursePatientRatioProjector as flow is {
    updates repository NursingContext.NursingRepository
    outlet NursePatientRatioProjectorToRepository is type NursingRepositoryCommand
    inlet NursePatientRatioProjectorFromNurseShift is type NurseShiftEvent    record NursePatientRatio is {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
      shiftDate: Date with {
        briefly "Date"
        described as {
          |Shift date.
        }
      }
      shiftType: String with {
        briefly "Type"
        described as {
          |Shift type.
        }
      }
      averageRatio: Number with {
        briefly "Average"
        described as {
          |Average ratio.
        }
      }
      maxRatio: Number with {
        briefly "Max"
        described as {
          |Maximum ratio.
        }
      }
      minRatio: Number with {
        briefly "Min"
        described as {
          |Minimum ratio.
        }
      }
      totalNurses: Number with {
        briefly "Nurses"
        described as {
          |Total nurses.
        }
      }
      totalPatients: Number with {
        briefly "Patients"
        described as {
          |Total patients.
        }
      }
      acuityAdjustedRatio: Number with {
        briefly "Adjusted"
        described as {
          |Acuity-adjusted ratio.
        }
      }
    } with {
      briefly "Nurse-to-patient ratio metrics"
      described as {
        |Aggregates staffing ratios for compliance and planning.
      }
    }
    handler RatioProjectionHandler is {
      on assessmentDocumented: event NurseShift.AssessmentDocumented is {
        tell command NursingContext.NursingRepository.PersistAssessmentDocumented(shiftId = assessmentDocumented.shiftId) to repository NursingContext.NursingRepository
        do "apply AssessmentDocumented to the NursePatientRatioProjector projection"
      }
      on handoffInitiated: event NurseShift.HandoffInitiated is {
        tell command NursingContext.NursingRepository.PersistHandoffInitiated(shiftId = handoffInitiated.shiftId) to repository NursingContext.NursingRepository
        do "apply HandoffInitiated to the NursePatientRatioProjector projection"
      }
      on taskCompleted: event NurseShift.TaskCompleted is {
        tell command NursingContext.NursingRepository.PersistTaskCompleted(shiftId = taskCompleted.shiftId) to repository NursingContext.NursingRepository
        do "apply TaskCompleted to the NursePatientRatioProjector projection"
      }
      on taskCreated: event NurseShift.TaskCreated is {
        tell command NursingContext.NursingRepository.PersistTaskCreated(shiftId = taskCreated.shiftId) to repository NursingContext.NursingRepository
        do "apply TaskCreated to the NursePatientRatioProjector projection"
      }
      on vitalsRecorded: event NurseShift.VitalsRecorded is {
        tell command NursingContext.NursingRepository.PersistVitalsRecorded(shiftId = vitalsRecorded.shiftId) to repository NursingContext.NursingRepository
        do "apply VitalsRecorded to the NursePatientRatioProjector projection"
      }
      on patientsAssigned: event PatientsAssigned is {
        tell command NursingContext.NursingRepository.PersistPatientsAssigned(shiftId = patientsAssigned.shiftId) to repository NursingContext.NursingRepository
      }
      on shiftStarted: event ShiftStarted is {
        tell command NursingContext.NursingRepository.PersistShiftStarted(shiftId = shiftStarted.shiftId) to repository NursingContext.NursingRepository
      }
      on handoffCompleted: event HandoffCompleted is {
        tell command NursingContext.NursingRepository.PersistHandoffCompleted(shiftId = handoffCompleted.shiftId) to repository NursingContext.NursingRepository
      }
    } with {
      briefly "Maintains nurse-patient ratio projections"
      described as {
        |Processes events to keep ratio metrics current.
      }
    }
  } with {
    briefly "Projects nurse-to-patient staffing ratios"
    described as {
      | Maintains real-time and historical nurse-patient ratios by unit.
      | Supports regulatory compliance monitoring and staffing decisions.
      | Includes acuity-adjusted ratios for workload analysis.
    }
  }
  query GetTaskCompletionMetrics replies result TaskCompletionMetricsView is {
    taskCompletionMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which task completion metrics to retrieve.
      }
    }
  } with {
    briefly "Get task completion metrics"
    described as {
      |Retrieves the task completion metrics projection.
    }
  }
  result TaskCompletionMetricsView is {
    taskCompletionMetrics: TaskCompletionProjector.TaskCompletionMetrics with {
      briefly "Task completion metrics"
      described as {
        |The task completion metrics being returned.
      }
    }
  } with {
    briefly "Task completion metrics view"
    described as {
      |Read model view carrying the task completion metrics projection.
    }
  }
  projector TaskCompletionProjector as sink is {
    updates repository NursingContext.NursingRepository
    inlet TaskCompletionProjectorFromNurseShift is type NurseShiftEvent    record TaskCompletionMetrics is {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
      shiftDate: Date with {
        briefly "Date"
        described as {
          |Shift date.
        }
      }
      shiftType: String with {
        briefly "Type"
        described as {
          |Shift type.
        }
      }
      totalTasks: Number with {
        briefly "Total"
        described as {
          |Total tasks.
        }
      }
      completedOnTime: Number with {
        briefly "On time"
        described as {
          |Completed on time.
        }
      }
      completedLate: Number with {
        briefly "Late"
        described as {
          |Completed late.
        }
      }
      deferred: Number with {
        briefly "Deferred"
        described as {
          |Deferred count.
        }
      }
      cancelled: Number with {
        briefly "Cancelled"
        described as {
          |Cancelled count.
        }
      }
      completionRate: Number with {
        briefly "Rate"
        described as {
          |Completion rate.
        }
      }
      onTimeRate: Number with {
        briefly "On time rate"
        described as {
          |On-time rate.
        }
      }
      averageCompletionTime: Duration with {
        briefly "Avg time"
        described as {
          |Average completion time.
        }
      }
    } with {
      briefly "Task completion performance metrics"
      described as {
        |Tracks task completion rates and timeliness.
      }
    }
    handler TaskMetricsHandler is {
      on assessmentDocumented: event NurseShift.AssessmentDocumented is {
        tell command NursingContext.NursingRepository.PersistAssessmentDocumented(shiftId = assessmentDocumented.shiftId) to repository NursingContext.NursingRepository
        do "apply AssessmentDocumented to the TaskCompletionProjector projection"
      }
      on handoffCompleted: event NurseShift.HandoffCompleted is {
        tell command NursingContext.NursingRepository.PersistHandoffCompleted(shiftId = handoffCompleted.shiftId) to repository NursingContext.NursingRepository
        do "apply HandoffCompleted to the TaskCompletionProjector projection"
      }
      on handoffInitiated: event NurseShift.HandoffInitiated is {
        tell command NursingContext.NursingRepository.PersistHandoffInitiated(shiftId = handoffInitiated.shiftId) to repository NursingContext.NursingRepository
        do "apply HandoffInitiated to the TaskCompletionProjector projection"
      }
      on patientsAssigned: event NurseShift.PatientsAssigned is {
        tell command NursingContext.NursingRepository.PersistPatientsAssigned(shiftId = patientsAssigned.shiftId) to repository NursingContext.NursingRepository
        do "apply PatientsAssigned to the TaskCompletionProjector projection"
      }
      on shiftStarted: event NurseShift.ShiftStarted is {
        tell command NursingContext.NursingRepository.PersistShiftStarted(shiftId = shiftStarted.shiftId) to repository NursingContext.NursingRepository
        do "apply ShiftStarted to the TaskCompletionProjector projection"
      }
      on vitalsRecorded: event NurseShift.VitalsRecorded is {
        tell command NursingContext.NursingRepository.PersistVitalsRecorded(shiftId = vitalsRecorded.shiftId) to repository NursingContext.NursingRepository
        do "apply VitalsRecorded to the TaskCompletionProjector projection"
      }
      on taskCreated: event TaskCreated is {
        tell command NursingContext.NursingRepository.PersistTaskCreated(shiftId = taskCreated.shiftId) to repository NursingContext.NursingRepository
      }
      on taskCompleted: event TaskCompleted is {
        tell command NursingContext.NursingRepository.PersistTaskCompleted(shiftId = taskCompleted.shiftId) to repository NursingContext.NursingRepository
      }
    } with {
      briefly "Maintains task completion projections"
      described as {
        |Processes task events to maintain metrics.
      }
    }
  } with {
    briefly "Projects task completion rates and performance"
    described as {
      | Tracks task completion metrics for quality improvement.
      | Identifies patterns in task deferral and late completion.
      | Supports nursing leadership dashboards and reporting.
    }
  }
  query GetHandoffMetrics replies result HandoffMetricsView is {
    handoffMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which handoff metrics to retrieve.
      }
    }
  } with {
    briefly "Get handoff metrics"
    described as {
      |Retrieves the handoff metrics projection.
    }
  }
  result HandoffMetricsView is {
    handoffMetrics: HandoffMetricsProjector.HandoffMetrics with {
      briefly "Handoff metrics"
      described as {
        |The handoff metrics being returned.
      }
    }
  } with {
    briefly "Handoff metrics view"
    described as {
      |Read model view carrying the handoff metrics projection.
    }
  }
  projector HandoffMetricsProjector as sink is {
    updates repository NursingContext.NursingRepository
    inlet HandoffMetricsProjectorFromNurseShift is type NurseShiftEvent    record HandoffMetrics is {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
      shiftDate: Date with {
        briefly "Date"
        described as {
          |Shift date.
        }
      }
      totalHandoffs: Number with {
        briefly "Total"
        described as {
          |Total handoffs.
        }
      }
      acknowledgedOnTime: Number with {
        briefly "On time"
        described as {
          |Acknowledged on time.
        }
      }
      averageHandoffDuration: Duration with {
        briefly "Avg duration"
        described as {
          |Average handoff duration.
        }
      }
      tasksTransferred: Number with {
        briefly "Transferred"
        described as {
          |Tasks transferred.
        }
      }
      incompleteHandoffs: Number with {
        briefly "Incomplete"
        described as {
          |Incomplete handoffs.
        }
      }
    } with {
      briefly "Shift handoff quality metrics"
      described as {
        |Tracks handoff completion and quality indicators.
      }
    }
    handler HandoffMetricsHandler is {
      on assessmentDocumented: event NurseShift.AssessmentDocumented is {
        tell command NursingContext.NursingRepository.PersistAssessmentDocumented(shiftId = assessmentDocumented.shiftId) to repository NursingContext.NursingRepository
        do "apply AssessmentDocumented to the HandoffMetricsProjector projection"
      }
      on patientsAssigned: event NurseShift.PatientsAssigned is {
        tell command NursingContext.NursingRepository.PersistPatientsAssigned(shiftId = patientsAssigned.shiftId) to repository NursingContext.NursingRepository
        do "apply PatientsAssigned to the HandoffMetricsProjector projection"
      }
      on shiftStarted: event NurseShift.ShiftStarted is {
        tell command NursingContext.NursingRepository.PersistShiftStarted(shiftId = shiftStarted.shiftId) to repository NursingContext.NursingRepository
        do "apply ShiftStarted to the HandoffMetricsProjector projection"
      }
      on taskCompleted: event NurseShift.TaskCompleted is {
        tell command NursingContext.NursingRepository.PersistTaskCompleted(shiftId = taskCompleted.shiftId) to repository NursingContext.NursingRepository
        do "apply TaskCompleted to the HandoffMetricsProjector projection"
      }
      on taskCreated: event NurseShift.TaskCreated is {
        tell command NursingContext.NursingRepository.PersistTaskCreated(shiftId = taskCreated.shiftId) to repository NursingContext.NursingRepository
        do "apply TaskCreated to the HandoffMetricsProjector projection"
      }
      on vitalsRecorded: event NurseShift.VitalsRecorded is {
        tell command NursingContext.NursingRepository.PersistVitalsRecorded(shiftId = vitalsRecorded.shiftId) to repository NursingContext.NursingRepository
        do "apply VitalsRecorded to the HandoffMetricsProjector projection"
      }
      on handoffInitiated: event HandoffInitiated is {
        tell command NursingContext.NursingRepository.PersistHandoffInitiated(shiftId = handoffInitiated.shiftId) to repository NursingContext.NursingRepository
      }
      on handoffCompleted: event HandoffCompleted is {
        tell command NursingContext.NursingRepository.PersistHandoffCompleted(shiftId = handoffCompleted.shiftId) to repository NursingContext.NursingRepository
      }
    } with {
      briefly "Maintains handoff quality projections"
      described as {
        |Processes handoff events to maintain metrics.
      }
    }
  } with {
    briefly "Projects handoff quality and compliance metrics"
    described as {
      | Monitors shift handoff quality for patient safety.
      | Tracks SBAR compliance and acknowledgment rates.
      | Identifies units with handoff process issues.
    }
  }
  type NurseShiftEvent is one of {
    NursingContext.NurseShift.ShiftStarted or NursingContext.NurseShift.PatientsAssigned or NursingContext.NurseShift.TaskCreated or NursingContext.NurseShift.TaskCompleted or NursingContext.NurseShift.AssessmentDocumented or NursingContext.NurseShift.VitalsRecorded or NursingContext.NurseShift.HandoffInitiated or NursingContext.NurseShift.HandoffCompleted
  } with {
    briefly "Nurse shift events"
    described as {
      |Union of all nurse shift entity events for streaming.
    }
  }
  processor NurseShiftEventSplit as split is {
    inlet NurseShiftEventSplitIn is type NurseShiftEvent    outlet NurseShiftEventSplitToNursePatientRatioProjector is type NurseShiftEvent
    outlet NurseShiftEventSplitToTaskCompletionProjector is type NurseShiftEvent
    outlet NurseShiftEventSplitToHandoffMetricsProjector is type NurseShiftEvent
    handler NurseShiftEventSplitHandler is {
      on shiftStarted: event NurseShift.ShiftStarted is {
        send shiftStarted to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send shiftStarted to outlet NurseShiftEventSplitToTaskCompletionProjector
        send shiftStarted to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell shiftStarted to entity NursingContext.NurseShift
      }
      on patientsAssigned: event NurseShift.PatientsAssigned is {
        send patientsAssigned to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send patientsAssigned to outlet NurseShiftEventSplitToTaskCompletionProjector
        send patientsAssigned to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell patientsAssigned to entity NursingContext.NurseShift
      }
      on taskCreated: event NurseShift.TaskCreated is {
        send taskCreated to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send taskCreated to outlet NurseShiftEventSplitToTaskCompletionProjector
        send taskCreated to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell taskCreated to entity NursingContext.NurseShift
      }
      on taskCompleted: event NurseShift.TaskCompleted is {
        send taskCompleted to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send taskCompleted to outlet NurseShiftEventSplitToTaskCompletionProjector
        send taskCompleted to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell taskCompleted to entity NursingContext.NurseShift
      }
      on assessmentDocumented: event NurseShift.AssessmentDocumented is {
        send assessmentDocumented to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send assessmentDocumented to outlet NurseShiftEventSplitToTaskCompletionProjector
        send assessmentDocumented to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell assessmentDocumented to entity NursingContext.NurseShift
      }
      on vitalsRecorded: event NurseShift.VitalsRecorded is {
        send vitalsRecorded to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send vitalsRecorded to outlet NurseShiftEventSplitToTaskCompletionProjector
        send vitalsRecorded to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell vitalsRecorded to entity NursingContext.NurseShift
      }
      on handoffInitiated: event NurseShift.HandoffInitiated is {
        send handoffInitiated to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send handoffInitiated to outlet NurseShiftEventSplitToTaskCompletionProjector
        send handoffInitiated to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell handoffInitiated to entity NursingContext.NurseShift
      }
      on handoffCompleted: event NurseShift.HandoffCompleted is {
        send handoffCompleted to outlet NurseShiftEventSplitToNursePatientRatioProjector
        send handoffCompleted to outlet NurseShiftEventSplitToTaskCompletionProjector
        send handoffCompleted to outlet NurseShiftEventSplitToHandoffMetricsProjector
        tell handoffCompleted to entity NursingContext.NurseShift
      }
      on other is {
        error "Unexpected message for processor NurseShiftEventSplit"
      }
    } with {
      briefly "NurseShift event fan-out handler"
      described as {
        |Delivers each NurseShift event to all of its consumers.
      }
    }
  } with {
    briefly "NurseShift event fan-out"
    described as {
      |Fans NurseShift events out to the repository and projectors.
    }
  }
  connector 'NurseShiftEvent Stream' is from outlet NursingContext.NurseShift.NurseShiftEvents2 to inlet NursingContext.NurseShiftEventSplit.NurseShiftEventSplitIn with {
    briefly "NurseShift events, fanned out to storage and read models"
  }
  connector 'NursePatientRatioProjector Feed' is from outlet NursingContext.NurseShiftEventSplit.NurseShiftEventSplitToNursePatientRatioProjector to inlet NursingContext.NursePatientRatioProjector.NursePatientRatioProjectorFromNurseShift with {
    briefly "NurseShift events feeding the NursePatientRatioProjector projection"
  }
  connector 'TaskCompletionProjector Feed' is from outlet NursingContext.NurseShiftEventSplit.NurseShiftEventSplitToTaskCompletionProjector to inlet NursingContext.TaskCompletionProjector.TaskCompletionProjectorFromNurseShift with {
    briefly "NurseShift events feeding the TaskCompletionProjector projection"
  }
  connector 'HandoffMetricsProjector Feed' is from outlet NursingContext.NurseShiftEventSplit.NurseShiftEventSplitToHandoffMetricsProjector to inlet NursingContext.HandoffMetricsProjector.HandoffMetricsProjectorFromNurseShift with {
    briefly "NurseShift events feeding the HandoffMetricsProjector projection"
  }
  connector 'NursePatientRatioProjector Storage' is from outlet NursingContext.NursePatientRatioProjector.NursePatientRatioProjectorToRepository to inlet NursingContext.NursingRepository.NursingRepositoryFromNursePatientRatioProjector with {
    briefly "NursePatientRatioProjector updates on their way to storage"
  }
} with {
  briefly "Bounded context for nursing workflow operations"
  described as {
    | NursingContext encapsulates all nursing workflow functionality.
    | Contains the NurseShift aggregate and supporting infrastructure.
    | Provides repositories for persistence and projectors for analytics.
    | Integrates with external systems for patient data and orders.
  }
}
