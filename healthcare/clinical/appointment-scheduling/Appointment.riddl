// Appointment Scheduling - Appointment Entity
entity Appointment as flow is {
  type AppointmentCommand is one of {
    Appointment.ScheduleAppointment or Appointment.ConfirmAppointment or Appointment.RescheduleAppointment or Appointment.CancelAppointment or Appointment.CheckInPatient or Appointment.StartAppointment or Appointment.CompleteAppointment or Appointment.MarkNoShow
  } with {
    briefly "Appointment command alternation"
    described as {
      |Commands accepted by the Appointment entity.
    }
  }
  inlet AppointmentCommands is type AppointmentCommand  outlet AppointmentEvents2 is type AppointmentEvent
  // Commands
  command ScheduleAppointment is  {
    appointmentId: AppointmentId with {
      briefly "Appointment ID"
      described as {
        |New appointment identifier.
      }
    }
    patientId: PatientId with {
      briefly "Patient"
      described as {
        |Patient identifier.
      }
    }
    providerId: ProviderId with {
      briefly "Provider"
      described as {
        |Provider identifier.
      }
    }
    locationId: LocationId with {
      briefly "Location"
      described as {
        |Appointment location.
      }
    }
    scheduledTime: TimeStamp with {
      briefly "Time"
      described as {
        |Scheduled time.
      }
    }
    details: AppointmentDetails with {
      briefly "Details"
      described as {
        |Appointment details.
      }
    }
  } with {
    briefly "Schedule appointment"
    described as {
      |Schedules a new appointment.
    }
  }
  command ConfirmAppointment is  {
    appointmentId: AppointmentId with {
      briefly "Appointment ID"
      described as {
        |Appointment identifier.
      }
    }
    confirmedBy: String(1,100) with {
      briefly "Confirmed by"
      described as {
        |Who confirmed.
      }
    }
  } with {
    briefly "Confirm appointment"
    described as {
      |Confirms the appointment.
    }
  }
  command RescheduleAppointment is  {
    appointmentId: AppointmentId with {
      briefly "Appointment ID"
      described as {
        |Appointment identifier.
      }
    }
    newTime: TimeStamp with {
      briefly "New time"
      described as {
        |New appointment time.
      }
    }
    rescheduleReason: String(1,200)? with {
      briefly "Reason"
      described as {
        |Reschedule reason.
      }
    }
    rescheduledBy: String(1,100) with {
      briefly "Rescheduled by"
      described as {
        |Who rescheduled.
      }
    }
  } with {
    briefly "Reschedule appointment"
    described as {
      |Reschedules the appointment.
    }
  }
  command CancelAppointment is  {
    appointmentId: AppointmentId with {
      briefly "Appointment ID"
      described as {
        |Appointment identifier.
      }
    }
    cancellationReason: String(1,200) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
    canceledBy: String(1,100) with {
      briefly "Canceled by"
      described as {
        |Who canceled.
      }
    }
  } with {
    briefly "Cancel appointment"
    described as {
      |Cancels the appointment.
    }
  }
  command CheckInPatient is  {
    appointmentId: AppointmentId with {
      briefly "Appointment ID"
      described as {
        |Appointment identifier.
      }
    }
    checkedInBy: String(1,100) with {
      briefly "Checked in by"
      described as {
        |Who checked patient in.
      }
    }
  } with {
    briefly "Check in patient"
    described as {
      |Checks in the patient.
    }
  }
  command StartAppointment is  {
    appointmentId: AppointmentId with {
      briefly "Appointment ID"
      described as {
        |Appointment identifier.
      }
    }
  } with {
    briefly "Start appointment"
    described as {
      |Marks appointment as started.
    }
  }
  command CompleteAppointment is  {
    appointmentId: AppointmentId with {
      briefly "Appointment ID"
      described as {
        |Appointment identifier.
      }
    }
    notes: String(1,1000)? with {
      briefly "Notes"
      described as {
        |Completion notes.
      }
    }
  } with {
    briefly "Complete appointment"
    described as {
      |Marks appointment as complete.
    }
  }
  command MarkNoShow is  {
    appointmentId: AppointmentId with {
      briefly "Appointment ID"
      described as {
        |Appointment identifier.
      }
    }
  } with {
    briefly "Mark no-show"
    described as {
      |Marks patient as no-show.
    }
  }
  // Events
  event AppointmentScheduled is  {
    appointmentId: AppointmentId with {
      briefly "Appointment"
      described as {
        |Appointment ID.
      }
    }
    patientId: PatientId with {
      briefly "Patient"
      described as {
        |Patient ID.
      }
    }
    providerId: ProviderId with {
      briefly "Provider"
      described as {
        |Provider ID.
      }
    }
    locationId: LocationId with {
      briefly "Location"
      described as {
        |Location ID.
      }
    }
    scheduledTime: TimeStamp with {
      briefly "Time"
      described as {
        |Scheduled time.
      }
    }
    details: AppointmentDetails with {
      briefly "Details"
      described as {
        |Appointment details.
      }
    }
    scheduledAt: TimeStamp with {
      briefly "Scheduled"
      described as {
        |Booking time.
      }
    }
  } with {
    briefly "Appointment scheduled"
    described as {
      |Emitted when appointment is booked.
    }
  }
  event AppointmentConfirmed is  {
    appointmentId: AppointmentId with {
      briefly "Appointment"
      described as {
        |Appointment ID.
      }
    }
    confirmedBy: String(1,100) with {
      briefly "Confirmed by"
      described as {
        |Who confirmed.
      }
    }
    confirmedAt: TimeStamp with {
      briefly "Confirmed"
      described as {
        |Confirmation time.
      }
    }
  } with {
    briefly "Appointment confirmed"
    described as {
      |Emitted when appointment is confirmed.
    }
  }
  event AppointmentRescheduled is  {
    appointmentId: AppointmentId with {
      briefly "Appointment"
      described as {
        |Appointment ID.
      }
    }
    reschedule: RescheduleInfo with {
      briefly "Reschedule"
      described as {
        |Reschedule info.
      }
    }
  } with {
    briefly "Appointment rescheduled"
    described as {
      |Emitted when appointment is rescheduled.
    }
  }
  event AppointmentCanceled is  {
    appointmentId: AppointmentId with {
      briefly "Appointment"
      described as {
        |Appointment ID.
      }
    }
    cancellation: CancellationInfo with {
      briefly "Cancellation"
      described as {
        |Cancellation info.
      }
    }
  } with {
    briefly "Appointment canceled"
    described as {
      |Emitted when appointment is canceled.
    }
  }
  event PatientCheckedIn is  {
    appointmentId: AppointmentId with {
      briefly "Appointment"
      described as {
        |Appointment ID.
      }
    }
    checkIn: CheckInInfo with {
      briefly "Check-in"
      described as {
        |Check-in info.
      }
    }
  } with {
    briefly "Patient checked in"
    described as {
      |Emitted when patient checks in.
    }
  }
  event AppointmentStarted is  {
    appointmentId: AppointmentId with {
      briefly "Appointment"
      described as {
        |Appointment ID.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
  } with {
    briefly "Appointment started"
    described as {
      |Emitted when appointment begins.
    }
  }
  event AppointmentCompleted is  {
    appointmentId: AppointmentId with {
      briefly "Appointment"
      described as {
        |Appointment ID.
      }
    }
    notes: String(1,1000)? with {
      briefly "Notes"
      described as {
        |Completion notes.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Appointment completed"
    described as {
      |Emitted when appointment ends.
    }
  }
  event PatientNoShow is  {
    appointmentId: AppointmentId with {
      briefly "Appointment"
      described as {
        |Appointment ID.
      }
    }
    markedAt: TimeStamp with {
      briefly "Marked"
      described as {
        |When marked.
      }
    }
  } with {
    briefly "Patient no-show"
    described as {
      |Emitted when patient doesn't show.
    }
  }
  // State Records
  record ScheduledStateData is  {
    appointmentId: AppointmentId with {
      briefly "Appointment"
      described as {
        |Appointment ID.
      }
    }
    patientId: PatientId with {
      briefly "Patient"
      described as {
        |Patient ID.
      }
    }
    providerId: ProviderId with {
      briefly "Provider"
      described as {
        |Provider ID.
      }
    }
    locationId: LocationId with {
      briefly "Location"
      described as {
        |Location ID.
      }
    }
    scheduledTime: TimeStamp with {
      briefly "Time"
      described as {
        |Scheduled time.
      }
    }
    details: AppointmentDetails with {
      briefly "Details"
      described as {
        |Appointment details.
      }
    }
    status: AppointmentStatus with {
      briefly "Status"
      described as {
        |Appointment status.
      }
    }
    confirmed: Boolean with {
      briefly "Confirmed"
      described as {
        |Is confirmed.
      }
    }
    scheduledAt: TimeStamp with {
      briefly "Scheduled"
      described as {
        |Booking time.
      }
    }
  } with {
    briefly "Scheduled state"
    described as {
      |State for scheduled appointment.
    }
  }
  record CompletedStateData is  {
    appointmentId: AppointmentId with {
      briefly "Appointment"
      described as {
        |Appointment ID.
      }
    }
    patientId: PatientId with {
      briefly "Patient"
      described as {
        |Patient ID.
      }
    }
    providerId: ProviderId with {
      briefly "Provider"
      described as {
        |Provider ID.
      }
    }
    scheduledTime: TimeStamp with {
      briefly "Time"
      described as {
        |Original time.
      }
    }
    actualStartTime: TimeStamp with {
      briefly "Start"
      described as {
        |Actual start.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
    notes: String(1,1000)? with {
      briefly "Notes"
      described as {
        |Completion notes.
      }
    }
  } with {
    briefly "Completed state"
    described as {
      |State for completed appointment.
    }
  }
  record CanceledStateData is  {
    appointmentId: AppointmentId with {
      briefly "Appointment"
      described as {
        |Appointment ID.
      }
    }
    patientId: PatientId with {
      briefly "Patient"
      described as {
        |Patient ID.
      }
    }
    cancellation: CancellationInfo with {
      briefly "Cancellation"
      described as {
        |Cancellation info.
      }
    }
  } with {
    briefly "Canceled state"
    described as {
      |State for canceled appointment.
    }
  }
  // Queries
  query GetAppointment replies result AppointmentResult is  {
    appointmentId: AppointmentId with {
      briefly "Appointment ID"
      described as {
        |Appointment to retrieve.
      }
    }
  } with {
    briefly "Get appointment"
    described as {
      |Retrieves appointment data.
    }
  }
  result AppointmentResult is  {
    appointmentId: AppointmentId with {
      briefly "Appointment ID"
      described as {
        |Appointment identifier.
      }
    }
    patientId: PatientId with {
      briefly "Patient"
      described as {
        |Patient identifier.
      }
    }
    providerId: ProviderId with {
      briefly "Provider"
      described as {
        |Provider identifier.
      }
    }
    scheduledTime: TimeStamp with {
      briefly "Time"
      described as {
        |Scheduled time.
      }
    }
    status: AppointmentStatus with {
      briefly "Status"
      described as {
        |Current status.
      }
    }
  } with {
    briefly "Appointment result"
    described as {
      |Appointment data result.
    }
  }
  // Initialize command for streamlet
  // States
  initial state ScheduledState of record Appointment.ScheduledStateData is {
    initial handler ScheduledStateInitHandler is {
      on init is {
        set state ScheduledState to "initialize from prior event"
      }
    } with {
      briefly "Scheduled state init handler"
      described as {
        |Initializes the Scheduled state.
      }
    }
  } with {
    briefly "Scheduled state"
    described as {
      |Active state for a scheduled appointment.
    }
  }
  state CompletedState of record Appointment.CompletedStateData is {
    initial handler CompletedStateInitHandler is {
      on init is {
        set state CompletedState to "initialize from prior event"
      }
    } with {
      briefly "Completed state init handler"
      described as {
        |Initializes the Completed state.
      }
    }
  } with {
    briefly "Completed state"
    described as {
      |Terminal state for a completed appointment.
    }
  }
  state CanceledState of record Appointment.CanceledStateData is {
    initial handler CanceledStateInitHandler is {
      on init is {
        set state CanceledState to "initialize from prior event"
      }
    } with {
      briefly "Canceled state init handler"
      described as {
        |Initializes the Canceled state.
      }
    }
  } with {
    briefly "Canceled state"
    described as {
      |Terminal state for a canceled appointment.
    }
  }
  // Handler
  handler AppointmentHandler is {
    on scheduleAppointment: command ScheduleAppointment is {
      morph entity AppointmentContext.Appointment to state AppointmentContext.Appointment.ScheduledState with record Appointment.ScheduledStateData(appointmentId = scheduleAppointment.appointmentId, patientId = scheduleAppointment.patientId, providerId = scheduleAppointment.providerId, locationId = scheduleAppointment.locationId, scheduledTime = scheduleAppointment.scheduledTime, details = scheduleAppointment.details, status = prompt("the status of this scheduled state data"), confirmed = prompt("the confirmed of this scheduled state data"), scheduledAt = prompt("the scheduled at of this scheduled state data"))
      tell event AppointmentScheduled(appointmentId = scheduleAppointment.appointmentId, patientId = scheduleAppointment.patientId, providerId = scheduleAppointment.providerId, locationId = scheduleAppointment.locationId, scheduledTime = scheduleAppointment.scheduledTime, details = scheduleAppointment.details, scheduledAt = prompt("the scheduled at of this appointment scheduled")) to entity AppointmentContext.Appointment
    }
    on confirmAppointment: command ConfirmAppointment is {
      tell event AppointmentConfirmed(appointmentId = confirmAppointment.appointmentId, confirmedBy = confirmAppointment.confirmedBy, confirmedAt = prompt("the confirmed at of this appointment confirmed")) to entity AppointmentContext.Appointment
    }
    on rescheduleAppointment: command RescheduleAppointment is {
      tell event AppointmentRescheduled(appointmentId = rescheduleAppointment.appointmentId, reschedule = prompt("the reschedule of this appointment rescheduled")) to entity AppointmentContext.Appointment
    }
    on cancelAppointment: command CancelAppointment is {
      morph entity AppointmentContext.Appointment to state AppointmentContext.Appointment.CanceledState with record Appointment.CanceledStateData(appointmentId = cancelAppointment.appointmentId, patientId = prompt("the patient id of this canceled state data"), cancellation = prompt("the cancellation of this canceled state data"))
      tell event AppointmentCanceled(appointmentId = cancelAppointment.appointmentId, cancellation = prompt("the cancellation of this appointment canceled")) to entity AppointmentContext.Appointment
    }
    on checkInPatient: command CheckInPatient is {
      tell event PatientCheckedIn(appointmentId = checkInPatient.appointmentId, checkIn = prompt("the check in of this patient checked in")) to entity AppointmentContext.Appointment
    }
    on startAppointment: command StartAppointment is {
      tell event AppointmentStarted(appointmentId = startAppointment.appointmentId, startedAt = prompt("the started at of this appointment started")) to entity AppointmentContext.Appointment
    }
    on completeAppointment: command CompleteAppointment is {
      morph entity AppointmentContext.Appointment to state AppointmentContext.Appointment.CompletedState with record Appointment.CompletedStateData(appointmentId = completeAppointment.appointmentId, notes = completeAppointment.notes, patientId = prompt("the patient id of this completed state data"), providerId = prompt("the provider id of this completed state data"), scheduledTime = prompt("the scheduled time of this completed state data"), actualStartTime = prompt("the actual start time of this completed state data"), completedAt = prompt("the completed at of this completed state data"))
      tell event AppointmentCompleted(appointmentId = completeAppointment.appointmentId, notes = completeAppointment.notes, completedAt = prompt("the completed at of this appointment completed")) to entity AppointmentContext.Appointment
    }
    on markNoShow: command MarkNoShow is {
      morph entity AppointmentContext.Appointment to state AppointmentContext.Appointment.CanceledState with record Appointment.CanceledStateData(appointmentId = markNoShow.appointmentId, patientId = prompt("the patient id of this canceled state data"), cancellation = prompt("the cancellation of this canceled state data"))
      tell event PatientNoShow(appointmentId = markNoShow.appointmentId, markedAt = prompt("the marked at of this patient no show")) to entity AppointmentContext.Appointment
    }
    on getAppointment: query GetAppointment is {
      reply result AppointmentResult(appointmentId = getAppointment.appointmentId, patientId = prompt("the patient id of this appointment result"), providerId = prompt("the provider id of this appointment result"), scheduledTime = prompt("the scheduled time of this appointment result"), status = prompt("the status of this appointment result"))
    }
    on appointmentCanceled: event AppointmentCanceled is {
      do "apply AppointmentCanceled to the appointment so it can be persisted and replayed"
    }
    on appointmentCompleted: event AppointmentCompleted is {
      do "apply AppointmentCompleted to the appointment so it can be persisted and replayed"
    }
    on appointmentConfirmed: event AppointmentConfirmed is {
      do "apply AppointmentConfirmed to the appointment so it can be persisted and replayed"
    }
    on appointmentRescheduled: event AppointmentRescheduled is {
      do "apply AppointmentRescheduled to the appointment so it can be persisted and replayed"
    }
    on appointmentScheduled: event AppointmentScheduled is {
      do "apply AppointmentScheduled to the appointment so it can be persisted and replayed"
    }
    on appointmentStarted: event AppointmentStarted is {
      do "apply AppointmentStarted to the appointment so it can be persisted and replayed"
    }
    on patientCheckedIn: event PatientCheckedIn is {
      do "apply PatientCheckedIn to the appointment so it can be persisted and replayed"
    }
    on patientNoShow: event PatientNoShow is {
      do "apply PatientNoShow to the appointment so it can be persisted and replayed"
    }
  } with {
    briefly "Processes appointment commands"
    described as {
      | Handles appointment lifecycle from scheduling
      | through check-in, visit, and completion.
    }
  }
} with {
  briefly "Appointment aggregate"
  described as {
    | The Appointment entity manages patient appointments
    | including booking, rescheduling, and status tracking.
  }
}
