// Appointment Scheduling - Appointment Context
context AppointmentContext as router is {
  inlet AppointmentCommandStreamIn is type AppointmentCommand  outlet AppointmentCommandStreamOut is type AppointmentCommand
  inlet AppointmentResultStreamIn is result Appointment.AppointmentResult  outlet AppointmentResultStreamOut is result Appointment.AppointmentResult
  handler AppointmentContextBoundary is {
    on scheduleAppointment: command Appointment.ScheduleAppointment is {
      send scheduleAppointment to outlet AppointmentContext.AppointmentCommandStreamOut
    }
    on confirmAppointment: command Appointment.ConfirmAppointment is {
      send confirmAppointment to outlet AppointmentContext.AppointmentCommandStreamOut
    }
    on rescheduleAppointment: command Appointment.RescheduleAppointment is {
      send rescheduleAppointment to outlet AppointmentContext.AppointmentCommandStreamOut
    }
    on cancelAppointment: command Appointment.CancelAppointment is {
      send cancelAppointment to outlet AppointmentContext.AppointmentCommandStreamOut
    }
    on checkInPatient: command Appointment.CheckInPatient is {
      send checkInPatient to outlet AppointmentContext.AppointmentCommandStreamOut
    }
    on startAppointment: command Appointment.StartAppointment is {
      send startAppointment to outlet AppointmentContext.AppointmentCommandStreamOut
    }
    on completeAppointment: command Appointment.CompleteAppointment is {
      send completeAppointment to outlet AppointmentContext.AppointmentCommandStreamOut
    }
    on markNoShow: command Appointment.MarkNoShow is {
      send markNoShow to outlet AppointmentContext.AppointmentCommandStreamOut
    }
    on appointmentResult: result Appointment.AppointmentResult is {
      send appointmentResult to outlet AppointmentContext.AppointmentResultStreamOut
    }
    on other is {
      error "Unexpected message at the AppointmentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AppointmentCommand Stream Intake' is from outlet AppointmentContext.AppointmentCommandStreamOut to inlet AppointmentContext.Appointment.AppointmentCommands  connector 'AppointmentResult Stream Egress' is from outlet AppointmentContext.AppointmentRepository.AppointmentRepositoryResponses to inlet AppointmentContext.AppointmentResultStreamIn  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendAppointmentNotification is {
        do "the model sends send appointment notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPatientService from context PatientService is { 
    handler FromPatientServiceHandler is {
      on result PatientService.PatientInfo is {
        do "the model receives patient info"
      }
      on other is {
        error "Unexpected message for adaptor FromPatientService"
      }
    } with {
      briefly "from patient service"
      described as {
        |Carries messages from the external PatientService.
      }
    }
  } with {
    briefly "PatientService integration"
    described as {
      |The model's side of the PatientService conversation.
    }
  }
  adaptor ToPatientService to context PatientService is { 
    handler ToPatientServiceHandler is {
      on query PatientService.GetPatientInfo is {
        do "the model sends get patient info"
      }
      on other is {
        error "Unexpected message for adaptor ToPatientService"
      }
    } with {
      briefly "to patient service"
      described as {
        |Carries messages to the external PatientService.
      }
    }
  } with {
    briefly "PatientService integration"
    described as {
      |The model's side of the PatientService conversation.
    }
  }
  adaptor FromProviderScheduleService from context ProviderScheduleService is { 
    handler FromProviderScheduleServiceHandler is {
      on result ProviderScheduleService.AvailabilityResult is {
        do "the model receives availability result"
      }
      on event ProviderScheduleService.TimeBlocked is {
        do "the model receives time blocked"
      }
      on other is {
        error "Unexpected message for adaptor FromProviderScheduleService"
      }
    } with {
      briefly "from provider schedule service"
      described as {
        |Carries messages from the external ProviderScheduleService.
      }
    }
  } with {
    briefly "ProviderScheduleService integration"
    described as {
      |The model's side of the ProviderScheduleService conversation.
    }
  }
  adaptor ToProviderScheduleService to context ProviderScheduleService is { 
    handler ToProviderScheduleServiceHandler is {
      on command ProviderScheduleService.BlockTime is {
        do "the model sends block time"
      }
      on query ProviderScheduleService.GetAvailability is {
        do "the model sends get availability"
      }
      on other is {
        error "Unexpected message for adaptor ToProviderScheduleService"
      }
    } with {
      briefly "to provider schedule service"
      described as {
        |Carries messages to the external ProviderScheduleService.
      }
    }
  } with {
    briefly "ProviderScheduleService integration"
    described as {
      |The model's side of the ProviderScheduleService conversation.
    }
  }
  adaptor FromReminderService from context ReminderService is { 
    handler FromReminderServiceHandler is {
      on event ReminderService.ReminderSent is {
        do "the model receives reminder sent"
      }
      on other is {
        error "Unexpected message for adaptor FromReminderService"
      }
    } with {
      briefly "from reminder service"
      described as {
        |Carries messages from the external ReminderService.
      }
    }
  } with {
    briefly "ReminderService integration"
    described as {
      |The model's side of the ReminderService conversation.
    }
  }
  adaptor ToReminderService to context ReminderService is { 
    handler ToReminderServiceHandler is {
      on command ReminderService.SendReminder is {
        do "the model sends send reminder"
      }
      on other is {
        error "Unexpected message for adaptor ToReminderService"
      }
    } with {
      briefly "to reminder service"
      described as {
        |Carries messages to the external ReminderService.
      }
    }
  } with {
    briefly "ReminderService integration"
    described as {
      |The model's side of the ReminderService conversation.
    }
  }
  adaptor FromWaitlistService from context WaitlistService is { 
    handler FromWaitlistServiceHandler is {
      on event WaitlistService.AddedToWaitlist is {
        do "the model receives added to waitlist"
      }
      on event WaitlistService.SlotAvailable is {
        do "the model receives slot available"
      }
      on other is {
        error "Unexpected message for adaptor FromWaitlistService"
      }
    } with {
      briefly "from waitlist service"
      described as {
        |Carries messages from the external WaitlistService.
      }
    }
  } with {
    briefly "WaitlistService integration"
    described as {
      |The model's side of the WaitlistService conversation.
    }
  }
  adaptor ToWaitlistService to context WaitlistService is { 
    handler ToWaitlistServiceHandler is {
      on command WaitlistService.AddToWaitlist is {
        do "the model sends add to waitlist"
      }
      on other is {
        error "Unexpected message for adaptor ToWaitlistService"
      }
    } with {
      briefly "to waitlist service"
      described as {
        |Carries messages to the external WaitlistService.
      }
    }
  } with {
    briefly "WaitlistService integration"
    described as {
      |The model's side of the WaitlistService conversation.
    }
  }
  include "types.riddl"
  include "Appointment.riddl"
  // Repository for appointment persistence
  type AppointmentRepositoryCommand is one of {
    AppointmentContext.AppointmentRepository.PersistAppointmentCanceled or AppointmentContext.AppointmentRepository.PersistAppointmentCompleted or AppointmentContext.AppointmentRepository.PersistAppointmentConfirmed or AppointmentContext.AppointmentRepository.PersistAppointmentRescheduled or AppointmentContext.AppointmentRepository.PersistAppointmentScheduled or AppointmentContext.AppointmentRepository.PersistAppointmentStarted or AppointmentContext.AppointmentRepository.PersistPatientCheckedIn or AppointmentContext.AppointmentRepository.PersistPatientNoShow
  } with {
    briefly "Anything that writes AppointmentRepository"
    described as {
      |The persistence commands AppointmentRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository AppointmentRepository as flow is {
    inlet AppointmentRepositoryFromSchedulingAnalytics is type AppointmentRepositoryCommand    command PersistAppointmentConfirmed is {
      appointmentId: AppointmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row AppointmentConfirmed applies to.
        }
      }
    } with {
      briefly "Persist AppointmentConfirmed"
      described as {
        |Instructs this repository to apply AppointmentConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAppointmentRescheduled is {
      appointmentId: AppointmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row AppointmentRescheduled applies to.
        }
      }
    } with {
      briefly "Persist AppointmentRescheduled"
      described as {
        |Instructs this repository to apply AppointmentRescheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAppointmentStarted is {
      appointmentId: AppointmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row AppointmentStarted applies to.
        }
      }
    } with {
      briefly "Persist AppointmentStarted"
      described as {
        |Instructs this repository to apply AppointmentStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPatientCheckedIn is {
      appointmentId: AppointmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row PatientCheckedIn applies to.
        }
      }
    } with {
      briefly "Persist PatientCheckedIn"
      described as {
        |Instructs this repository to apply PatientCheckedIn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAppointmentCanceled is {
      appointmentId: AppointmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row AppointmentCanceled applies to.
        }
      }
    } with {
      briefly "Persist AppointmentCanceled"
      described as {
        |Instructs this repository to apply AppointmentCanceled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAppointmentCompleted is {
      appointmentId: AppointmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row AppointmentCompleted applies to.
        }
      }
    } with {
      briefly "Persist AppointmentCompleted"
      described as {
        |Instructs this repository to apply AppointmentCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAppointmentScheduled is {
      appointmentId: AppointmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row AppointmentScheduled applies to.
        }
      }
    } with {
      briefly "Persist AppointmentScheduled"
      described as {
        |Instructs this repository to apply AppointmentScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPatientNoShow is {
      appointmentId: AppointmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row PatientNoShow applies to.
        }
      }
    } with {
      briefly "Persist PatientNoShow"
      described as {
        |Instructs this repository to apply PatientNoShow to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet AppointmentRepositoryResponses is result Appointment.AppointmentResult
    record StoredAppointment is {
      appointmentId: AppointmentId with {
        briefly "appointmentId"
        described as {
          |The appointmentId column of the stored appointment row.
        }
      }
      patientId: PatientId with {
        briefly "patientId"
        described as {
          |The patientId column of the stored appointment row.
        }
      }
      providerId: ProviderId with {
        briefly "providerId"
        described as {
          |The providerId column of the stored appointment row.
        }
      }
    } with {
      briefly "Stored appointment row"
      described as {
        |The persistence shape of appointment data as this repository stores it.
      }
    }
    schema AppointmentData is relational
      of appointments as record StoredAppointment
        index on field StoredAppointment.appointmentId
        index on field StoredAppointment.patientId
        index on field StoredAppointment.providerId
 with {
      briefly "Appointment data schema"
      described as {
        |The relational schema holding appointment data for the AppointmentRepository.
      }
    }
    handler AppointmentPersistence is {
      on persistAppointmentConfirmed: command PersistAppointmentConfirmed is {
        do "apply AppointmentConfirmed to the stored row"
      }
      on persistAppointmentRescheduled: command PersistAppointmentRescheduled is {
        do "apply AppointmentRescheduled to the stored row"
      }
      on persistAppointmentStarted: command PersistAppointmentStarted is {
        do "apply AppointmentStarted to the stored row"
      }
      on persistPatientCheckedIn: command PersistPatientCheckedIn is {
        do "apply PatientCheckedIn to the stored row"
      }
      on persistAppointmentCanceled: command PersistAppointmentCanceled is {
        do "apply AppointmentCanceled to the stored row"
      }
      on persistAppointmentCompleted: command PersistAppointmentCompleted is {
        do "apply AppointmentCompleted to the stored row"
      }
      on persistAppointmentScheduled: command PersistAppointmentScheduled is {
        do "apply AppointmentScheduled to the stored row"
      }
      on persistPatientNoShow: command PersistPatientNoShow is {
        do "apply PatientNoShow to the stored row"
      }
      on query GetSchedulingStats is {
        let schedulingStatsView: type SchedulingStatsView = prompt("read the scheduling stats projection")
        reply schedulingStatsView
      }
    } with {
      briefly "Persists appointment commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Appointment data persistence"
    described as {
      | The AppointmentRepository provides persistent storage for
      | patient appointments and schedule data.
    }
  }
  // Projector for scheduling analytics
  query GetSchedulingStats replies result SchedulingStatsView is {
    schedulingStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which scheduling stats to retrieve.
      }
    }
  } with {
    briefly "Get scheduling stats"
    described as {
      |Retrieves the scheduling stats projection.
    }
  }
  result SchedulingStatsView is {
    schedulingStats: SchedulingAnalytics.SchedulingStats with {
      briefly "Scheduling stats"
      described as {
        |The scheduling stats being returned.
      }
    }
  } with {
    briefly "Scheduling stats view"
    described as {
      |Read model view carrying the scheduling stats projection.
    }
  }
  projector SchedulingAnalytics as flow is {
    updates repository AppointmentContext.AppointmentRepository
    outlet SchedulingAnalyticsToRepository is type AppointmentRepositoryCommand
    inlet SchedulingAnalyticsFromAppointment is type AppointmentEvent    record SchedulingStats is {
      totalAppointments: Natural with {
        briefly "Total"
        described as {
          |Total appointments.
        }
      }
      completedAppointments: Natural with {
        briefly "Completed"
        described as {
          |Completed appointments.
        }
      }
      noShowRate: Decimal(5,4) with {
        briefly "No-show rate"
        described as {
          |No-show rate.
        }
      }
      cancellationRate: Decimal(5,4) with {
        briefly "Cancel rate"
        described as {
          |Cancellation rate.
        }
      }
      avgWaitTime: Duration with {
        briefly "Avg wait"
        described as {
          |Average wait time.
        }
      }
      utilizationRate: Decimal(5,4) with {
        briefly "Utilization"
        described as {
          |Schedule utilization.
        }
      }
    } with {
      briefly "Scheduling statistics"
      described as {
        |Appointment scheduling metrics.
      }
    }
    handler AnalyticsHandler is {
      on appointmentConfirmed: event Appointment.AppointmentConfirmed is {
        tell command AppointmentContext.AppointmentRepository.PersistAppointmentConfirmed(appointmentId = appointmentConfirmed.appointmentId) to repository AppointmentContext.AppointmentRepository
        do "apply AppointmentConfirmed to the SchedulingAnalytics projection"
      }
      on appointmentRescheduled: event Appointment.AppointmentRescheduled is {
        tell command AppointmentContext.AppointmentRepository.PersistAppointmentRescheduled(appointmentId = appointmentRescheduled.appointmentId) to repository AppointmentContext.AppointmentRepository
        do "apply AppointmentRescheduled to the SchedulingAnalytics projection"
      }
      on appointmentStarted: event Appointment.AppointmentStarted is {
        tell command AppointmentContext.AppointmentRepository.PersistAppointmentStarted(appointmentId = appointmentStarted.appointmentId) to repository AppointmentContext.AppointmentRepository
        do "apply AppointmentStarted to the SchedulingAnalytics projection"
      }
      on patientCheckedIn: event Appointment.PatientCheckedIn is {
        tell command AppointmentContext.AppointmentRepository.PersistPatientCheckedIn(appointmentId = patientCheckedIn.appointmentId) to repository AppointmentContext.AppointmentRepository
        do "apply PatientCheckedIn to the SchedulingAnalytics projection"
      }
      on appointmentScheduled: event Appointment.AppointmentScheduled is {
        tell command AppointmentContext.AppointmentRepository.PersistAppointmentScheduled(appointmentId = appointmentScheduled.appointmentId) to repository AppointmentContext.AppointmentRepository
      }
      on appointmentCompleted: event Appointment.AppointmentCompleted is {
        tell command AppointmentContext.AppointmentRepository.PersistAppointmentCompleted(appointmentId = appointmentCompleted.appointmentId) to repository AppointmentContext.AppointmentRepository
      }
      on patientNoShow: event Appointment.PatientNoShow is {
        tell command AppointmentContext.AppointmentRepository.PersistPatientNoShow(appointmentId = patientNoShow.appointmentId) to repository AppointmentContext.AppointmentRepository
      }
      on appointmentCanceled: event Appointment.AppointmentCanceled is {
        tell command AppointmentContext.AppointmentRepository.PersistAppointmentCanceled(appointmentId = appointmentCanceled.appointmentId) to repository AppointmentContext.AppointmentRepository
      }
    } with {
      briefly "Maintains scheduling analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Scheduling analytics projections"
    described as {
      |Maintains appointment scheduling analytics data.
    }
  }
  // Event union for streaming
  type AppointmentEvent is one of {
    AppointmentContext.Appointment.AppointmentScheduled or AppointmentContext.Appointment.AppointmentConfirmed or AppointmentContext.Appointment.AppointmentRescheduled or AppointmentContext.Appointment.AppointmentCanceled or AppointmentContext.Appointment.PatientCheckedIn or AppointmentContext.Appointment.AppointmentStarted or AppointmentContext.Appointment.AppointmentCompleted or AppointmentContext.Appointment.PatientNoShow
  } with {
    briefly "Appointment events"
    described as {
      |Union of all appointment entity events for streaming.
    }
  }
  // Source streamlet for appointment events
  // Sink streamlet for appointment events
  // Connector wiring source to sink
  processor AppointmentEventSplit as flow is {
    inlet AppointmentEventSplitIn is type AppointmentEvent    outlet AppointmentEventSplitToSchedulingAnalytics is type AppointmentEvent
    handler AppointmentEventSplitHandler is {
      on appointmentScheduled: event Appointment.AppointmentScheduled is {
        send appointmentScheduled to outlet AppointmentEventSplitToSchedulingAnalytics
        tell appointmentScheduled to entity AppointmentContext.Appointment
      }
      on appointmentConfirmed: event Appointment.AppointmentConfirmed is {
        send appointmentConfirmed to outlet AppointmentEventSplitToSchedulingAnalytics
        tell appointmentConfirmed to entity AppointmentContext.Appointment
      }
      on appointmentRescheduled: event Appointment.AppointmentRescheduled is {
        send appointmentRescheduled to outlet AppointmentEventSplitToSchedulingAnalytics
        tell appointmentRescheduled to entity AppointmentContext.Appointment
      }
      on appointmentCanceled: event Appointment.AppointmentCanceled is {
        send appointmentCanceled to outlet AppointmentEventSplitToSchedulingAnalytics
        tell appointmentCanceled to entity AppointmentContext.Appointment
      }
      on patientCheckedIn: event Appointment.PatientCheckedIn is {
        send patientCheckedIn to outlet AppointmentEventSplitToSchedulingAnalytics
        tell patientCheckedIn to entity AppointmentContext.Appointment
      }
      on appointmentStarted: event Appointment.AppointmentStarted is {
        send appointmentStarted to outlet AppointmentEventSplitToSchedulingAnalytics
        tell appointmentStarted to entity AppointmentContext.Appointment
      }
      on appointmentCompleted: event Appointment.AppointmentCompleted is {
        send appointmentCompleted to outlet AppointmentEventSplitToSchedulingAnalytics
        tell appointmentCompleted to entity AppointmentContext.Appointment
      }
      on patientNoShow: event Appointment.PatientNoShow is {
        send patientNoShow to outlet AppointmentEventSplitToSchedulingAnalytics
        tell patientNoShow to entity AppointmentContext.Appointment
      }
      on other is {
        error "Unexpected message for processor AppointmentEventSplit"
      }
    } with {
      briefly "Appointment event fan-out handler"
      described as {
        |Delivers each Appointment event to all of its consumers.
      }
    }
  } with {
    briefly "Appointment event fan-out"
    described as {
      |Fans Appointment events out to the repository and projectors.
    }
  }
  connector 'AppointmentEvent Stream' is from outlet AppointmentContext.Appointment.AppointmentEvents2 to inlet AppointmentContext.AppointmentEventSplit.AppointmentEventSplitIn with {
    briefly "Appointment events, fanned out to storage and read models"
  }
  connector 'SchedulingAnalytics Feed' is from outlet AppointmentContext.AppointmentEventSplit.AppointmentEventSplitToSchedulingAnalytics to inlet AppointmentContext.SchedulingAnalytics.SchedulingAnalyticsFromAppointment with {
    briefly "Appointment events feeding the SchedulingAnalytics projection"
  }
  connector 'SchedulingAnalytics Storage' is from outlet AppointmentContext.SchedulingAnalytics.SchedulingAnalyticsToRepository to inlet AppointmentContext.AppointmentRepository.AppointmentRepositoryFromSchedulingAnalytics with {
    briefly "SchedulingAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for appointment scheduling"
  described as {
    | The AppointmentContext is the bounded context for
    | patient appointment booking and schedule management.
  }
}
