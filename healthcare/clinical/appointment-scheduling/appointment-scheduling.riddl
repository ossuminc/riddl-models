// Appointment Scheduling Domain Model
// Patient appointment booking and schedule management
domain AppointmentScheduling is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Scheduler is "person managing appointment schedules" with {
    briefly "Scheduler"
    described as {
      |Person booking appointments.
    }
  }
  user PatientUser is "patient booking appointments" with {
    briefly "Patient"
    described as {
      |Person scheduling visits.
    }
  }
  user ProviderUser is "healthcare provider with schedule" with {
    briefly "Provider"
    described as {
      |Doctor or clinician.
    }
  }
  epic SchedulingEpic is {
    user PatientUser wants to "to book appointments easily" so that "care can be received timely"
    case BookAppointment is {
      user PatientUser wants to "to schedule an appointment" so that "a visit time is reserved"
      step is "Patient requests" "appointment for service" "with provider" with {
        briefly "Request"
        described as {
          |Request appointment.
        }
      }
      step is "System checks" "provider availability" "for requested time" with {
        briefly "Check availability"
        described as {
          |Find open slots.
        }
      }
      step send command AppointmentContext.Appointment.ScheduleAppointment from user Scheduler to entity AppointmentContext.Appointment with {
        briefly "Schedule"
        described as {
          |Book appointment.
        }
      }
      step is "System sends" "confirmation" "to patient" with {
        briefly "Confirm"
        described as {
          |Send confirmation.
        }
      }
    } with {
      briefly "Booking workflow"
      described as {
        |Standard appointment booking flow.
      }
    }
  } with {
    briefly "Appointment scheduling"
    described as {
      | Epic covering appointment booking, rescheduling,
      | and cancellation workflows.
    }
  }
  include "AppointmentContext.riddl"
  include "external-contexts.riddl"
  application context AppointmentSchedulingApp is {
    outlet AppAppointmentCommands is type AppointmentContext.Appointment.AppointmentCommand
    inlet AppAppointmentRepositoryResponses is type AppointmentContext.Appointment.AppointmentResult
    handler AppointmentSchedulingAppHandler is {
      on other is {
        error "Unexpected message for application context AppointmentSchedulingApp"
      }
    } with {
      briefly "AppointmentSchedulingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "AppointmentSchedulingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppAppointmentCommands is {
    from outlet AppointmentSchedulingApp.AppAppointmentCommands to
      inlet AppointmentContext.Appointment.AppointmentCommands
  } with {
    option is persistent
    briefly "LinkAppAppointmentCommands"
  }
  connector LinkAppAppointmentRepositoryResponses is {
    from outlet AppointmentContext.AppointmentRepository.AppointmentRepositoryResponses to
      inlet AppointmentSchedulingApp.AppAppointmentRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppAppointmentRepositoryResponses"
  }
} with {
  briefly "Appointment scheduling domain"
  described as {
    | The AppointmentScheduling domain handles patient
    | appointment booking, provider schedules, and reminders.
  }
}
