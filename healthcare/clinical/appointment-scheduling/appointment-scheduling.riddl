// Appointment Scheduling Domain Model
// Patient appointment booking and schedule management
domain AppointmentScheduling is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Scheduler is "person managing appointment schedules" with {
    briefly "Scheduler"
    described as {
      |Person booking appointments.
    }
  }
  user PatientUser is "patient booking appointments" with {
    briefly "Patient"
    described as {
      |Person scheduling visits.
    }
  }
  user ProviderUser is "healthcare provider with schedule" with {
    briefly "Provider"
    described as {
      |Doctor or clinician.
    }
  }
  epic SchedulingEpic is {
    user PatientUser wants to "to book appointments easily" so that "care can be received timely"
    case BookAppointment is {
      user PatientUser wants to "to schedule an appointment" so that "a visit time is reserved"
      step is "Patient requests" "appointment for service" "with provider" with {
        briefly "Request"
        described as {
          |Request appointment.
        }
      }
      step is "System checks" "provider availability" "for requested time" with {
        briefly "Check availability"
        described as {
          |Find open slots.
        }
      }
      step take input AppointmentSchedulingApp.AppointmentSchedulingScreen.ScheduleAppointmentInput from user Scheduler with {
        briefly "Schedule"
        described as {
          |Book appointment.
        }
      }
      step is "System sends" "confirmation" "to patient" with {
        briefly "Confirm"
        described as {
          |Send confirmation.
        }
      }
    } with {
      briefly "Booking workflow"
      described as {
        |Standard appointment booking flow.
      }
    }
  } with {
    briefly "Appointment scheduling"
    described as {
      | Epic covering appointment booking, rescheduling,
      | and cancellation workflows.
    }
  }
  include "AppointmentContext.riddl"
  include "external-contexts.riddl"
  application context AppointmentSchedulingApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in AppointmentScheduling are delivered.
      }
    }
    group AppointmentSchedulingScreen is {
      input ScheduleAppointmentInput acquires command AppointmentContext.Appointment.ScheduleAppointment with {
        briefly "Schedule appointment control"
        described as {
          |The control through which a user submits the schedule appointment request.
        }
      }
    } with {
      briefly "Appointment scheduling screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppAppointmentCommands is type AppointmentContext.Appointment.AppointmentCommand
    inlet AppAppointmentRepositoryResponses is type AppointmentContext.Appointment.AppointmentResult    handler AppointmentSchedulingAppHandler is {
      on other is {
        error "Unexpected message for application context AppointmentSchedulingApp"
      }
    } with {
      briefly "AppointmentSchedulingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "AppointmentSchedulingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'AppointmentCommand Stream' is from outlet AppointmentSchedulingApp.AppAppointmentCommands to inlet AppointmentContext.Appointment.AppointmentCommands with {
    option persistent()
    briefly "Appointment commands from the application"
  }
  connector 'AppointmentResult Stream' is from outlet AppointmentContext.AppointmentRepository.AppointmentRepositoryResponses to inlet AppointmentSchedulingApp.AppAppointmentRepositoryResponses with {
    option persistent()
    briefly "Appointment query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet AppointmentSchedulingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Appointment scheduling domain"
  described as {
    | The AppointmentScheduling domain handles patient
    | appointment booking, provider schedules, and reminders.
  }
}
