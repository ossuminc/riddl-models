// Appointment Scheduling Domain Model
// Patient appointment booking and schedule management
domain AppointmentScheduling is {
  persistent connector 'ProviderScheduleServiceReply Stream' is from outlet ProviderScheduleService.ProviderScheduleServiceRepliesOut to inlet AppointmentContext.ToProviderScheduleService.ToProviderScheduleServiceReplies with {
    briefly "What ProviderScheduleService answers AppointmentContext"
  }
  persistent connector 'PatientServiceReply Stream' is from outlet PatientService.PatientServiceRepliesOut to inlet AppointmentContext.ToPatientService.ToPatientServiceReplies with {
    briefly "What PatientService answers AppointmentContext"
  }
  persistent connector 'ProviderScheduleServiceEvent Stream' is from outlet ProviderScheduleService.ProviderScheduleServiceEventsOut to inlet AppointmentContext.FromProviderScheduleService.FromProviderScheduleServiceIn with {
    briefly "What ProviderScheduleService tells AppointmentContext, unasked"
  }
  persistent connector 'ReminderServiceEvent Stream' is from outlet ReminderService.ReminderServiceEventsOut to inlet AppointmentContext.FromReminderService.FromReminderServiceIn with {
    briefly "What ReminderService tells AppointmentContext, unasked"
  }
  persistent connector 'WaitlistServiceEvent Stream' is from outlet WaitlistService.WaitlistServiceEventsOut to inlet AppointmentContext.FromWaitlistService.FromWaitlistServiceIn with {
    briefly "What WaitlistService tells AppointmentContext, unasked"
  }
  persistent connector 'PatientServiceRequest Stream' is from outlet AppointmentContext.ToPatientService.ToPatientServiceOut to inlet PatientService.PatientServiceRequests with {
    briefly "What AppointmentContext asks PatientService to send"
  }
  persistent connector 'WaitlistServiceRequest Stream' is from outlet AppointmentContext.ToWaitlistService.ToWaitlistServiceOut to inlet WaitlistService.WaitlistServiceRequests with {
    briefly "What AppointmentContext asks WaitlistService to send"
  }
  persistent connector 'ProviderScheduleServiceRequest Stream' is from outlet AppointmentContext.ToProviderScheduleService.ToProviderScheduleServiceOut to inlet ProviderScheduleService.ProviderScheduleServiceRequests with {
    briefly "What AppointmentContext asks ProviderScheduleService to send"
  }
  persistent connector 'ReminderServiceRequest Stream' is from outlet AppointmentContext.ToReminderService.ToReminderServiceOut to inlet ReminderService.ReminderServiceRequests with {
    briefly "What AppointmentContext asks ReminderService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet AppointmentContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What AppointmentContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Scheduler is "person managing appointment schedules" with {
    briefly "Scheduler"
    described as {
      |Person booking appointments.
    }
  }
  user PatientUser is "patient booking appointments" with {
    briefly "Patient"
    described as {
      |Person scheduling visits.
    }
  }
  user ProviderUser is "healthcare provider with schedule" with {
    briefly "Provider"
    described as {
      |Doctor or clinician.
    }
  }
  epic SchedulingEpic is {
    user PatientUser wants to "to book appointments easily" so that "care can be received timely"
    case BookAppointment is {
      user PatientUser wants to "to schedule an appointment" so that "a visit time is reserved"
      step is "Patient requests" "appointment for service" "with provider" with {
        briefly "Request"
        described as {
          |Request appointment.
        }
      }
      step is "System checks" "provider availability" "for requested time" with {
        briefly "Check availability"
        described as {
          |Find open slots.
        }
      }
      step take input AppointmentSchedulingApp.AppointmentSchedulingScreen.ScheduleAppointmentInput from user Scheduler with {
        briefly "Schedule"
        described as {
          |Book appointment.
        }
      }
      step is "System sends" "confirmation" "to patient" with {
        briefly "Confirm"
        described as {
          |Send confirmation.
        }
      }
    } with {
      briefly "Booking workflow"
      described as {
        |Standard appointment booking flow.
      }
    }
  } with {
    briefly "Appointment scheduling"
    described as {
      | Epic covering appointment booking, rescheduling,
      | and cancellation workflows.
    }
  }
  include "AppointmentContext.riddl"
  include "external-contexts.riddl"
  application context AppointmentSchedulingApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in AppointmentScheduling are delivered.
      }
    }
    group AppointmentSchedulingScreen is {
      input GetSchedulingStatsInput acquires query AppointmentContext.GetSchedulingStats with {
        briefly "Get scheduling stats control"
        described as {
          |The control through which a user asks the get scheduling stats question.
        }
      }
      input GetAppointmentInput acquires query AppointmentContext.Appointment.GetAppointment with {
        briefly "Get appointment control"
        described as {
          |The control through which a user asks the get appointment question.
        }
      }
      input CancelAppointmentInput acquires command AppointmentContext.Appointment.CancelAppointment with {
        briefly "Cancel appointment control"
        described as {
          |The control through which a user submits the cancel appointment request.
        }
      }
      input CheckInPatientInput acquires command AppointmentContext.Appointment.CheckInPatient with {
        briefly "Check in patient control"
        described as {
          |The control through which a user submits the check in patient request.
        }
      }
      input CompleteAppointmentInput acquires command AppointmentContext.Appointment.CompleteAppointment with {
        briefly "Complete appointment control"
        described as {
          |The control through which a user submits the complete appointment request.
        }
      }
      input ConfirmAppointmentInput acquires command AppointmentContext.Appointment.ConfirmAppointment with {
        briefly "Confirm appointment control"
        described as {
          |The control through which a user submits the confirm appointment request.
        }
      }
      input MarkNoShowInput acquires command AppointmentContext.Appointment.MarkNoShow with {
        briefly "Mark no show control"
        described as {
          |The control through which a user submits the mark no show request.
        }
      }
      input StartAppointmentInput acquires command AppointmentContext.Appointment.StartAppointment with {
        briefly "Start appointment control"
        described as {
          |The control through which a user submits the start appointment request.
        }
      }
      input ScheduleAppointmentInput acquires command AppointmentContext.ScheduleAppointment with {
        briefly "Schedule appointment control"
        described as {
          |The control through which a user submits the schedule appointment request.
        }
      }
    } with {
      briefly "Appointment scheduling screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppAppointmentRepositoryQueries is query AppointmentContext.GetSchedulingStats
    inlet AppAppointmentRepositoryReplies is result AppointmentContext.SchedulingStatsView
    outlet AppAppointmentQueries is query AppointmentContext.Appointment.GetAppointment
    outlet AppAppointmentCommands is type AppointmentContext.AppointmentRequest
    inlet AppAppointmentRepositoryResponses is result AppointmentContext.Appointment.AppointmentResult
    handler AppointmentSchedulingAppHandler is {
      on other is {
        error "Unexpected message for application context AppointmentSchedulingApp"
      }
    } with {
      briefly "AppointmentSchedulingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "AppointmentSchedulingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'AppointmentRepositoryQuery Stream' is from outlet AppointmentSchedulingApp.AppAppointmentRepositoryQueries to inlet AppointmentContext.AppointmentRepositoryQueriesIn with {
    briefly "AppointmentSchedulingApp's look-ups of the appointment repository"
  }
  persistent connector 'AppointmentRepositoryReply Stream' is from outlet AppointmentContext.AppointmentRepositoryRepliesOut to inlet AppointmentSchedulingApp.AppAppointmentRepositoryReplies with {
    briefly "The appointment repository's answers returned to AppointmentSchedulingApp"
  }
  persistent connector 'AppointmentQuery Stream' is from outlet AppointmentSchedulingApp.AppAppointmentQueries to inlet AppointmentContext.AppointmentQueriesIn with {
    briefly "AppointmentSchedulingApp's look-ups of the appointment"
  }
  persistent connector 'AppointmentCommand Stream' is from outlet AppointmentSchedulingApp.AppAppointmentCommands to inlet AppointmentContext.AppointmentCommandStreamIn with {
    briefly "Appointment commands from the application"
  }
  persistent connector 'AppointmentResult Stream' is from outlet AppointmentContext.AppointmentResultStreamOut to inlet AppointmentSchedulingApp.AppAppointmentRepositoryResponses with {
    briefly "Appointment query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet AppointmentSchedulingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Appointment scheduling domain"
  described as {
    | The AppointmentScheduling domain handles patient
    | appointment booking, provider schedules, and reminders.
  }
}
