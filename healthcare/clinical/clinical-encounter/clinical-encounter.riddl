// Clinical Encounter Domain Model
// Patient visit documentation and clinical notes
domain ClinicalEncounter is {
  persistent connector 'PatientRecordServiceReply Stream' is from outlet PatientRecordService.PatientRecordServiceRepliesOut to inlet EncounterContext.ToPatientRecordService.ToPatientRecordServiceReplies with {
    briefly "What PatientRecordService answers EncounterContext"
  }
  persistent connector 'BillingServiceEvent Stream' is from outlet BillingService.BillingServiceEventsOut to inlet EncounterContext.FromBillingService.FromBillingServiceIn with {
    briefly "What BillingService tells EncounterContext, unasked"
  }
  persistent connector 'CodingServiceEvent Stream' is from outlet CodingService.CodingServiceEventsOut to inlet EncounterContext.FromCodingService.FromCodingServiceIn with {
    briefly "What CodingService tells EncounterContext, unasked"
  }
  persistent connector 'OrderEntryServiceEvent Stream' is from outlet OrderEntryService.OrderEntryServiceEventsOut to inlet EncounterContext.FromOrderEntryService.FromOrderEntryServiceIn with {
    briefly "What OrderEntryService tells EncounterContext, unasked"
  }
  persistent connector 'SchedulingServiceEvent Stream' is from outlet SchedulingService.SchedulingServiceEventsOut to inlet EncounterContext.FromSchedulingService.FromSchedulingServiceIn with {
    briefly "What SchedulingService tells EncounterContext, unasked"
  }
  persistent connector 'PatientRecordServiceRequest Stream' is from outlet EncounterContext.ToPatientRecordService.ToPatientRecordServiceOut to inlet PatientRecordService.PatientRecordServiceRequests with {
    briefly "What EncounterContext asks PatientRecordService to send"
  }
  persistent connector 'OrderEntryServiceRequest Stream' is from outlet EncounterContext.ToOrderEntryService.ToOrderEntryServiceOut to inlet OrderEntryService.OrderEntryServiceRequests with {
    briefly "What EncounterContext asks OrderEntryService to send"
  }
  persistent connector 'CodingServiceRequest Stream' is from outlet EncounterContext.ToCodingService.ToCodingServiceOut to inlet CodingService.CodingServiceRequests with {
    briefly "What EncounterContext asks CodingService to send"
  }
  persistent connector 'SchedulingServiceRequest Stream' is from outlet EncounterContext.ToSchedulingService.ToSchedulingServiceOut to inlet SchedulingService.SchedulingServiceRequests with {
    briefly "What EncounterContext asks SchedulingService to send"
  }
  persistent connector 'BillingServiceRequest Stream' is from outlet EncounterContext.ToBillingService.ToBillingServiceOut to inlet BillingService.BillingServiceRequests with {
    briefly "What EncounterContext asks BillingService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet EncounterContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What EncounterContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Physician is "medical doctor providing care" with {
    briefly "Physician"
    described as {
      |Doctor seeing the patient.
    }
  }
  user Nurse is "nursing staff member" with {
    briefly "Nurse"
    described as {
      |Nurse supporting patient care.
    }
  }
  user MedicalCoder is "person coding encounters for billing" with {
    briefly "Medical Coder"
    described as {
      |Person assigning diagnosis and procedure codes.
    }
  }
  epic EncounterEpic is {
    user Physician wants to "to document patient encounters" so that "care is properly recorded"
    case DocumentVisit is {
      user Physician wants to "to document a patient visit" so that "clinical notes are complete"
      step is "Patient arrives" "for scheduled appointment" "at clinic" with {
        briefly "Patient arrives"
        described as {
          |Check-in.
        }
      }
      step is "Nurse performs" "vitals and preliminary assessment" "on patient" with {
        briefly "Vitals"
        described as {
          |Record vitals.
        }
      }
      step take input ClinicalEncounterApp.ClinicalEncounterScreen.StartEncounterInput from user Physician with {
        briefly "Start"
        described as {
          |Begin encounter.
        }
      }
      step is "Physician documents" "assessment and plan" "in chart" with {
        briefly "Document"
        described as {
          |Record findings.
        }
      }
    } with {
      briefly "Visit documentation"
      described as {
        |Standard clinical visit workflow.
      }
    }
  } with {
    briefly "Clinical encounters"
    described as {
      | Epic covering clinical encounters from patient
      | arrival through documentation and coding.
    }
  }
  include "EncounterContext.riddl"
  include "external-contexts.riddl"
  application context ClinicalEncounterApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ClinicalEncounter are delivered.
      }
    }
    group ClinicalEncounterScreen is {
      input GetEncounterStatsInput acquires query EncounterContext.GetEncounterStats with {
        briefly "Get encounter stats control"
        described as {
          |The control through which a user asks the get encounter stats question.
        }
      }
      input GetEncounterInput acquires query EncounterContext.Encounter.GetEncounter with {
        briefly "Get encounter control"
        described as {
          |The control through which a user asks the get encounter question.
        }
      }
      input AddDiagnosisInput acquires command EncounterContext.Encounter.AddDiagnosis with {
        briefly "Add diagnosis control"
        described as {
          |The control through which a user submits the add diagnosis request.
        }
      }
      input CancelEncounterInput acquires command EncounterContext.Encounter.CancelEncounter with {
        briefly "Cancel encounter control"
        described as {
          |The control through which a user submits the cancel encounter request.
        }
      }
      input CompleteEncounterInput acquires command EncounterContext.Encounter.CompleteEncounter with {
        briefly "Complete encounter control"
        described as {
          |The control through which a user submits the complete encounter request.
        }
      }
      input PlaceOrderInput acquires command EncounterContext.Encounter.PlaceOrder with {
        briefly "Place order control"
        described as {
          |The control through which a user submits the place order request.
        }
      }
      input RecordChiefComplaintInput acquires command EncounterContext.Encounter.RecordChiefComplaint with {
        briefly "Record chief complaint control"
        described as {
          |The control through which a user submits the record chief complaint request.
        }
      }
      input RecordProcedureInput acquires command EncounterContext.Encounter.RecordProcedure with {
        briefly "Record procedure control"
        described as {
          |The control through which a user submits the record procedure request.
        }
      }
      input RecordVitalsInput acquires command EncounterContext.Encounter.RecordVitals with {
        briefly "Record vitals control"
        described as {
          |The control through which a user submits the record vitals request.
        }
      }
      input SignNoteInput acquires command EncounterContext.Encounter.SignNote with {
        briefly "Sign note control"
        described as {
          |The control through which a user submits the sign note request.
        }
      }
      input StartEncounterInput acquires command EncounterContext.StartEncounter with {
        briefly "Start encounter control"
        described as {
          |The control through which a user submits the start encounter request.
        }
      }
    } with {
      briefly "Clinical encounter screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppEncounterRepositoryQueries is query EncounterContext.GetEncounterStats
    inlet AppEncounterRepositoryReplies is result EncounterContext.EncounterStatsView
    outlet AppEncounterQueries is query EncounterContext.Encounter.GetEncounter
    outlet AppEncounterCommands is type EncounterContext.EncounterRequest
    inlet AppEncounterRepositoryResponses is result EncounterContext.Encounter.EncounterResult
    handler ClinicalEncounterAppHandler is {
      on other is {
        error "Unexpected message for application context ClinicalEncounterApp"
      }
    } with {
      briefly "ClinicalEncounterApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ClinicalEncounterApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'EncounterRepositoryQuery Stream' is from outlet ClinicalEncounterApp.AppEncounterRepositoryQueries to inlet EncounterContext.EncounterRepositoryQueriesIn with {
    briefly "ClinicalEncounterApp's look-ups of the encounter repository"
  }
  persistent connector 'EncounterRepositoryReply Stream' is from outlet EncounterContext.EncounterRepositoryRepliesOut to inlet ClinicalEncounterApp.AppEncounterRepositoryReplies with {
    briefly "The encounter repository's answers returned to ClinicalEncounterApp"
  }
  persistent connector 'EncounterQuery Stream' is from outlet ClinicalEncounterApp.AppEncounterQueries to inlet EncounterContext.EncounterQueriesIn with {
    briefly "ClinicalEncounterApp's look-ups of the encounter"
  }
  persistent connector 'EncounterCommand Stream' is from outlet ClinicalEncounterApp.AppEncounterCommands to inlet EncounterContext.EncounterCommandStreamIn with {
    briefly "Encounter commands from the application"
  }
  persistent connector 'EncounterResult Stream' is from outlet EncounterContext.EncounterResultStreamOut to inlet ClinicalEncounterApp.AppEncounterRepositoryResponses with {
    briefly "Encounter query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ClinicalEncounterApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Clinical encounter domain"
  described as {
    | The ClinicalEncounter domain handles patient visit
    | documentation, clinical notes, and encounter coding.
  }
}
