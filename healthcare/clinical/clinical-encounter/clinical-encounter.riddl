// Clinical Encounter Domain Model
// Patient visit documentation and clinical notes
domain ClinicalEncounter is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Physician is "medical doctor providing care" with {
    briefly "Physician"
    described as {
      |Doctor seeing the patient.
    }
  }
  user Nurse is "nursing staff member" with {
    briefly "Nurse"
    described as {
      |Nurse supporting patient care.
    }
  }
  user MedicalCoder is "person coding encounters for billing" with {
    briefly "Medical Coder"
    described as {
      |Person assigning diagnosis and procedure codes.
    }
  }
  epic EncounterEpic is {
    user Physician wants to "to document patient encounters" so that "care is properly recorded"
    case DocumentVisit is {
      user Physician wants to "to document a patient visit" so that "clinical notes are complete"
      step is "Patient arrives" "for scheduled appointment" "at clinic" with {
        briefly "Patient arrives"
        described as {
          |Check-in.
        }
      }
      step is "Nurse performs" "vitals and preliminary assessment" "on patient" with {
        briefly "Vitals"
        described as {
          |Record vitals.
        }
      }
      step take input ClinicalEncounterApp.ClinicalEncounterScreen.StartEncounterInput from user Physician with {
        briefly "Start"
        described as {
          |Begin encounter.
        }
      }
      step is "Physician documents" "assessment and plan" "in chart" with {
        briefly "Document"
        described as {
          |Record findings.
        }
      }
    } with {
      briefly "Visit documentation"
      described as {
        |Standard clinical visit workflow.
      }
    }
  } with {
    briefly "Clinical encounters"
    described as {
      | Epic covering clinical encounters from patient
      | arrival through documentation and coding.
    }
  }
  include "EncounterContext.riddl"
  include "external-contexts.riddl"
  application context ClinicalEncounterApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ClinicalEncounter are delivered.
      }
    }
    group ClinicalEncounterScreen is {
      input StartEncounterInput acquires command EncounterContext.Encounter.StartEncounter with {
        briefly "Start encounter control"
        described as {
          |The control through which a user submits the start encounter request.
        }
      }
    } with {
      briefly "Clinical encounter screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppEncounterCommands is type EncounterContext.Encounter.EncounterCommand
    inlet AppEncounterRepositoryResponses is type EncounterContext.Encounter.EncounterResult    handler ClinicalEncounterAppHandler is {
      on other is {
        error "Unexpected message for application context ClinicalEncounterApp"
      }
    } with {
      briefly "ClinicalEncounterApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ClinicalEncounterApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'EncounterCommand Stream' is from outlet ClinicalEncounterApp.AppEncounterCommands to inlet EncounterContext.Encounter.EncounterCommands with {
    option persistent()
    briefly "Encounter commands from the application"
  }
  connector 'EncounterResult Stream' is from outlet EncounterContext.EncounterRepository.EncounterRepositoryResponses to inlet ClinicalEncounterApp.AppEncounterRepositoryResponses with {
    option persistent()
    briefly "Encounter query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ClinicalEncounterApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Clinical encounter domain"
  described as {
    | The ClinicalEncounter domain handles patient visit
    | documentation, clinical notes, and encounter coding.
  }
}
