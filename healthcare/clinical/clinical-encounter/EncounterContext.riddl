// Clinical Encounter - Encounter Context
context EncounterContext as router is {
  inlet EncounterCommandStreamIn is type EncounterCommand  outlet EncounterCommandStreamOut is type EncounterCommand
  inlet EncounterResultStreamIn is type Encounter.EncounterResult  outlet EncounterResultStreamOut is type Encounter.EncounterResult
  handler EncounterContextBoundary is {
    on startEncounter: command Encounter.StartEncounter is {
      send startEncounter to outlet EncounterContext.EncounterCommandStreamOut
    }
    on recordVitals: command Encounter.RecordVitals is {
      send recordVitals to outlet EncounterContext.EncounterCommandStreamOut
    }
    on recordChiefComplaint: command Encounter.RecordChiefComplaint is {
      send recordChiefComplaint to outlet EncounterContext.EncounterCommandStreamOut
    }
    on addClinicalNote: command Encounter.AddClinicalNote is {
      send addClinicalNote to outlet EncounterContext.EncounterCommandStreamOut
    }
    on addDiagnosis: command Encounter.AddDiagnosis is {
      send addDiagnosis to outlet EncounterContext.EncounterCommandStreamOut
    }
    on recordProcedure: command Encounter.RecordProcedure is {
      send recordProcedure to outlet EncounterContext.EncounterCommandStreamOut
    }
    on placeOrder: command Encounter.PlaceOrder is {
      send placeOrder to outlet EncounterContext.EncounterCommandStreamOut
    }
    on signNote: command Encounter.SignNote is {
      send signNote to outlet EncounterContext.EncounterCommandStreamOut
    }
    on completeEncounter: command Encounter.CompleteEncounter is {
      send completeEncounter to outlet EncounterContext.EncounterCommandStreamOut
    }
    on cancelEncounter: command Encounter.CancelEncounter is {
      send cancelEncounter to outlet EncounterContext.EncounterCommandStreamOut
    }
    on initializeEncounter: command Encounter.InitializeEncounter is {
      send initializeEncounter to outlet EncounterContext.EncounterCommandStreamOut
    }
    on encounterResult: result Encounter.EncounterResult is {
      send encounterResult to outlet EncounterContext.EncounterResultStreamOut
    }
    on other is {
      error "Unexpected message at the EncounterContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'EncounterCommand Stream Intake' is from outlet EncounterContext.EncounterCommandStreamOut to inlet EncounterContext.Encounter.EncounterCommands  connector 'EncounterResult Stream Egress' is from outlet EncounterContext.EncounterRepository.EncounterRepositoryResponses to inlet EncounterContext.EncounterResultStreamIn  adaptor FromBillingService from context BillingService is { 
    handler FromBillingServiceHandler is {
      on event BillingService.BillingSubmitted is {
        do "the model receives billing submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService is { 
    handler ToBillingServiceHandler is {
      on command BillingService.SubmitEncounterForBilling is {
        do "the model sends submit encounter for billing"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromCodingService from context CodingService is { 
    handler FromCodingServiceHandler is {
      on event CodingService.CodesSuggested is {
        do "the model receives codes suggested"
      }
      on other is {
        error "Unexpected message for adaptor FromCodingService"
      }
    } with {
      briefly "from coding service"
      described as {
        |Carries messages from the external CodingService.
      }
    }
  } with {
    briefly "CodingService integration"
    described as {
      |The model's side of the CodingService conversation.
    }
  }
  adaptor ToCodingService to context CodingService is { 
    handler ToCodingServiceHandler is {
      on command CodingService.SuggestCodes is {
        do "the model sends suggest codes"
      }
      on other is {
        error "Unexpected message for adaptor ToCodingService"
      }
    } with {
      briefly "to coding service"
      described as {
        |Carries messages to the external CodingService.
      }
    }
  } with {
    briefly "CodingService integration"
    described as {
      |The model's side of the CodingService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.AlertSent is {
        do "the model receives alert sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendProviderAlert is {
        do "the model sends send provider alert"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromOrderEntryService from context OrderEntryService is { 
    handler FromOrderEntryServiceHandler is {
      on event OrderEntryService.OrderSubmitted is {
        do "the model receives order submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromOrderEntryService"
      }
    } with {
      briefly "from order entry service"
      described as {
        |Carries messages from the external OrderEntryService.
      }
    }
  } with {
    briefly "OrderEntryService integration"
    described as {
      |The model's side of the OrderEntryService conversation.
    }
  }
  adaptor ToOrderEntryService to context OrderEntryService is { 
    handler ToOrderEntryServiceHandler is {
      on command OrderEntryService.SubmitOrder is {
        do "the model sends submit order"
      }
      on other is {
        error "Unexpected message for adaptor ToOrderEntryService"
      }
    } with {
      briefly "to order entry service"
      described as {
        |Carries messages to the external OrderEntryService.
      }
    }
  } with {
    briefly "OrderEntryService integration"
    described as {
      |The model's side of the OrderEntryService conversation.
    }
  }
  adaptor FromPatientRecordService from context PatientRecordService is { 
    handler FromPatientRecordServiceHandler is {
      on result PatientRecordService.PatientRecord is {
        do "the model receives patient record"
      }
      on other is {
        error "Unexpected message for adaptor FromPatientRecordService"
      }
    } with {
      briefly "from patient record service"
      described as {
        |Carries messages from the external PatientRecordService.
      }
    }
  } with {
    briefly "PatientRecordService integration"
    described as {
      |The model's side of the PatientRecordService conversation.
    }
  }
  adaptor ToPatientRecordService to context PatientRecordService is { 
    handler ToPatientRecordServiceHandler is {
      on query PatientRecordService.GetPatient is {
        do "the model sends get patient"
      }
      on other is {
        error "Unexpected message for adaptor ToPatientRecordService"
      }
    } with {
      briefly "to patient record service"
      described as {
        |Carries messages to the external PatientRecordService.
      }
    }
  } with {
    briefly "PatientRecordService integration"
    described as {
      |The model's side of the PatientRecordService conversation.
    }
  }
  adaptor FromSchedulingService from context SchedulingService is { 
    handler FromSchedulingServiceHandler is {
      on event SchedulingService.PatientCheckedIn is {
        do "the model receives patient checked in"
      }
      on other is {
        error "Unexpected message for adaptor FromSchedulingService"
      }
    } with {
      briefly "from scheduling service"
      described as {
        |Carries messages from the external SchedulingService.
      }
    }
  } with {
    briefly "SchedulingService integration"
    described as {
      |The model's side of the SchedulingService conversation.
    }
  }
  adaptor ToSchedulingService to context SchedulingService is { 
    handler ToSchedulingServiceHandler is {
      on command SchedulingService.CheckInPatient is {
        do "the model sends check in patient"
      }
      on other is {
        error "Unexpected message for adaptor ToSchedulingService"
      }
    } with {
      briefly "to scheduling service"
      described as {
        |Carries messages to the external SchedulingService.
      }
    }
  } with {
    briefly "SchedulingService integration"
    described as {
      |The model's side of the SchedulingService conversation.
    }
  }
  include "types.riddl"
  include "Encounter.riddl"
  // Repository for encounter persistence
  repository EncounterRepository as merge is {
    command PersistDiagnosisAdded is  {
      encounterId: EncounterId with {
        briefly "Row addressed"
        described as {
          |Which stored row DiagnosisAdded applies to.
        }
      }
    } with {
      briefly "Persist DiagnosisAdded"
      described as {
        |Instructs this repository to apply DiagnosisAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEncounterCompleted is  {
      encounterId: EncounterId with {
        briefly "Row addressed"
        described as {
          |Which stored row EncounterCompleted applies to.
        }
      }
    } with {
      briefly "Persist EncounterCompleted"
      described as {
        |Instructs this repository to apply EncounterCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEncounterStarted is  {
      encounterId: EncounterId with {
        briefly "Row addressed"
        described as {
          |Which stored row EncounterStarted applies to.
        }
      }
    } with {
      briefly "Persist EncounterStarted"
      described as {
        |Instructs this repository to apply EncounterStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet EncounterRepositoryFromEncounter is type EncounterEvent    inlet EncounterRepositoryFromEncounterAnalytics is type EncounterEvent    outlet EncounterRepositoryResponses is type Encounter.EncounterResult
    record StoredEncounter is  {
      encounterId: EncounterId with {
        briefly "encounterId"
        described as {
          |The encounterId column of the stored encounter row.
        }
      }
      patient: PatientInfo with {
        briefly "patient"
        described as {
          |The patient column of the stored encounter row.
        }
      }
    } with {
      briefly "Stored encounter row"
      described as {
        |The persistence shape of encounter data as this repository stores it.
      }
    }
    schema EncounterData is relational
      of encounters as type StoredEncounter
        index on field StoredEncounter.encounterId
        index on field StoredEncounter.patient.patientId
 with {
      briefly "Encounter data schema"
      described as {
        |The relational schema holding encounter data for the EncounterRepository.
      }
    }
    handler EncounterPersistence is {
      on persistDiagnosisAdded: command PersistDiagnosisAdded is {
        do "apply DiagnosisAdded to the stored row"
      }
      on persistEncounterCompleted: command PersistEncounterCompleted is {
        do "apply EncounterCompleted to the stored row"
      }
      on persistEncounterStarted: command PersistEncounterStarted is {
        do "apply EncounterStarted to the stored row"
      }
      on query GetEncounterStats is {
        let encounterStatsView: type EncounterStatsView = prompt("read the encounter stats projection")
        reply encounterStatsView
      }
      on startEncounter: command Encounter.StartEncounter is {
        tell event Encounter.EncounterStarted(encounterId = startEncounter.encounterId, patient = startEncounter.patient, provider = startEncounter.provider, facilityId = startEncounter.facilityId, encounterType = startEncounter.encounterType) to entity EncounterContext.Encounter
      }
      on recordVitals: command Encounter.RecordVitals is {
        tell event Encounter.VitalsRecorded(encounterId = recordVitals.encounterId, vitals = recordVitals.vitals) to entity EncounterContext.Encounter
      }
      on recordChiefComplaint: command Encounter.RecordChiefComplaint is {
        tell event Encounter.ChiefComplaintRecorded(encounterId = recordChiefComplaint.encounterId, complaint = recordChiefComplaint.complaint) to entity EncounterContext.Encounter
      }
      on addClinicalNote: command Encounter.AddClinicalNote is {
        tell event Encounter.ClinicalNoteAdded(encounterId = addClinicalNote.encounterId, note = addClinicalNote.note) to entity EncounterContext.Encounter
      }
      on addDiagnosis: command Encounter.AddDiagnosis is {
        tell event Encounter.DiagnosisAdded(encounterId = addDiagnosis.encounterId, diagnosis = addDiagnosis.diagnosis) to entity EncounterContext.Encounter
      }
      on recordProcedure: command Encounter.RecordProcedure is {
        tell event Encounter.ProcedureRecorded(encounterId = recordProcedure.encounterId, encounterProcedure = recordProcedure.encounterProcedure) to entity EncounterContext.Encounter
      }
      on placeOrder: command Encounter.PlaceOrder is {
        tell event Encounter.OrderPlaced(encounterId = placeOrder.encounterId, order = placeOrder.order) to entity EncounterContext.Encounter
      }
      on signNote: command Encounter.SignNote is {
        tell event Encounter.NoteSigned(encounterId = signNote.encounterId, noteType = signNote.noteType, signedBy = signNote.signedBy) to entity EncounterContext.Encounter
      }
      on completeEncounter: command Encounter.CompleteEncounter is {
        tell event Encounter.EncounterCompleted(encounterId = completeEncounter.encounterId, disposition = completeEncounter.disposition) to entity EncounterContext.Encounter
      }
      on cancelEncounter: command Encounter.CancelEncounter is {
        tell event Encounter.EncounterCanceled(encounterId = cancelEncounter.encounterId, reason = cancelEncounter.reason) to entity EncounterContext.Encounter
      }
    } with {
      briefly "Persists encounter commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Encounter data persistence"
    described as {
      | The EncounterRepository provides persistent storage for
      | clinical encounters and documentation.
    }
  }
  // Projector for encounter analytics
  query GetEncounterStats is  {
    encounterStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which encounter stats to retrieve.
      }
    }
  } with {
    briefly "Get encounter stats"
    described as {
      |Retrieves the encounter stats projection.
    }
  }
  result EncounterStatsView is  {
    encounterStats: EncounterAnalytics.EncounterStats with {
      briefly "Encounter stats"
      described as {
        |The encounter stats being returned.
      }
    }
  } with {
    briefly "Encounter stats view"
    described as {
      |Read model view carrying the encounter stats projection.
    }
  }
  projector EncounterAnalytics as flow is {
    updates repository EncounterContext.EncounterRepository
    inlet EncounterAnalyticsFromEncounter is type EncounterEvent    outlet EncounterAnalyticsOut is type EncounterEvent
    record EncounterStats is  {
      totalEncounters: Natural with {
        briefly "Total"
        described as {
          |Total encounters.
        }
      }
      avgDuration: Duration with {
        briefly "Avg duration"
        described as {
          |Average encounter length.
        }
      }
      encountersByType: String(1,100)+ with {
        briefly "By type"
        described as {
          |Counts by type.
        }
      }
      completionRate: Decimal(5,4) with {
        briefly "Completion"
        described as {
          |Completion rate.
        }
      }
      avgDiagnoses: Decimal(4,2) with {
        briefly "Avg diagnoses"
        described as {
          |Average diagnoses per visit.
        }
      }
    } with {
      briefly "Encounter statistics"
      described as {
        |Clinical encounter metrics.
      }
    }
    handler AnalyticsHandler is {
      on encounterStarted: event Encounter.EncounterStarted is {
        tell command EncounterContext.EncounterRepository.PersistEncounterStarted(encounterId = encounterStarted.encounterId) to repository EncounterContext.EncounterRepository
      }
      on encounterCompleted: event Encounter.EncounterCompleted is {
        tell command EncounterContext.EncounterRepository.PersistEncounterCompleted(encounterId = encounterCompleted.encounterId) to repository EncounterContext.EncounterRepository
      }
      on diagnosisAdded: event Encounter.DiagnosisAdded is {
        tell command EncounterContext.EncounterRepository.PersistDiagnosisAdded(encounterId = diagnosisAdded.encounterId) to repository EncounterContext.EncounterRepository
      }
    } with {
      briefly "Maintains encounter analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Encounter analytics projections"
    described as {
      |Maintains clinical encounter analytics data.
    }
  }
  type EncounterEvent is one of {
    EncounterContext.Encounter.EncounterStarted or EncounterContext.Encounter.VitalsRecorded or EncounterContext.Encounter.ChiefComplaintRecorded or EncounterContext.Encounter.ClinicalNoteAdded or EncounterContext.Encounter.DiagnosisAdded or EncounterContext.Encounter.ProcedureRecorded or EncounterContext.Encounter.OrderPlaced or EncounterContext.Encounter.NoteSigned or EncounterContext.Encounter.EncounterCompleted or EncounterContext.Encounter.EncounterCanceled
  } with {
    briefly "Encounter events"
    described as {
      |Union of all encounter entity events for streaming.
    }
  }
  processor EncounterSource as source is {
    outlet EncounterEvents is type EncounterEvent
 with {
      briefly "Encounter event outlet"
      described as {
        |Publishes encounter events.
      }
    }
    handler EncounterSourceHandler is {
      on init is {
        let initializeEncounter: type Encounter.InitializeEncounter = prompt("the initialize encounter that brings this this into existence")
        tell initializeEncounter to entity EncounterContext.Encounter
      }
      on encounterStarted: event Encounter.EncounterStarted is {
        send encounterStarted to outlet EncounterEvents
      }
      on encounterCompleted: event Encounter.EncounterCompleted is {
        send encounterCompleted to outlet EncounterEvents
      }
      on encounterCanceled: event Encounter.EncounterCanceled is {
        send encounterCanceled to outlet EncounterEvents
      }
      on other is {
        error "Unexpected message for source EncounterSource"
      }
    } with {
      briefly "Encounter source handler"
      described as {
        |Forwards encounter events to the outlet.
      }
    }
  } with {
    briefly "Encounter event source"
    described as {
      |Source streamlet that publishes encounter events.
    }
  }
  processor EncounterSink as sink is {
    inlet EncounterEventsIn is type EncounterEvent with {
      briefly "Encounter event inlet"
      described as {
        |Receives encounter events.
      }
    }
    handler EncounterSinkHandler is {
      on init is { ??? }
      on encounterStarted: event Encounter.EncounterStarted is {
        tell encounterStarted to repository EncounterContext.EncounterRepository
      }
      on encounterCompleted: event Encounter.EncounterCompleted is {
        tell encounterCompleted to repository EncounterContext.EncounterRepository
      }
      on other is {
        error "Unexpected message for sink EncounterSink"
      }
    } with {
      briefly "Encounter sink handler"
      described as {
        |Persists encounter events from the inlet.
      }
    }
  } with {
    briefly "Encounter event sink"
    described as {
      |Sink streamlet that consumes encounter events.
    }
  }
  connector EncounterFlow is from outlet EncounterContext.EncounterSource.EncounterEvents to inlet EncounterContext.EncounterSink.EncounterEventsIn with {
    briefly "Encounter event flow"
    described as {
      |Connects encounter source to sink for event streaming.
    }
  }
  processor EncounterEventSplit as split is {
    inlet EncounterEventSplitIn is type EncounterEvent    outlet EncounterEventSplitToEncounterRepository is type EncounterEvent
    outlet EncounterEventSplitToEncounterAnalytics is type EncounterEvent
    handler EncounterEventSplitHandler is {
      on encounterStarted: event Encounter.EncounterStarted is {
        send encounterStarted to outlet EncounterEventSplitToEncounterRepository
        send encounterStarted to outlet EncounterEventSplitToEncounterAnalytics
        tell encounterStarted to entity EncounterContext.Encounter
      }
      on vitalsRecorded: event Encounter.VitalsRecorded is {
        send vitalsRecorded to outlet EncounterEventSplitToEncounterRepository
        send vitalsRecorded to outlet EncounterEventSplitToEncounterAnalytics
        tell vitalsRecorded to entity EncounterContext.Encounter
      }
      on chiefComplaintRecorded: event Encounter.ChiefComplaintRecorded is {
        send chiefComplaintRecorded to outlet EncounterEventSplitToEncounterRepository
        send chiefComplaintRecorded to outlet EncounterEventSplitToEncounterAnalytics
        tell chiefComplaintRecorded to entity EncounterContext.Encounter
      }
      on clinicalNoteAdded: event Encounter.ClinicalNoteAdded is {
        send clinicalNoteAdded to outlet EncounterEventSplitToEncounterRepository
        send clinicalNoteAdded to outlet EncounterEventSplitToEncounterAnalytics
        tell clinicalNoteAdded to entity EncounterContext.Encounter
      }
      on diagnosisAdded: event Encounter.DiagnosisAdded is {
        send diagnosisAdded to outlet EncounterEventSplitToEncounterRepository
        send diagnosisAdded to outlet EncounterEventSplitToEncounterAnalytics
        tell diagnosisAdded to entity EncounterContext.Encounter
      }
      on procedureRecorded: event Encounter.ProcedureRecorded is {
        send procedureRecorded to outlet EncounterEventSplitToEncounterRepository
        send procedureRecorded to outlet EncounterEventSplitToEncounterAnalytics
        tell procedureRecorded to entity EncounterContext.Encounter
      }
      on orderPlaced: event Encounter.OrderPlaced is {
        send orderPlaced to outlet EncounterEventSplitToEncounterRepository
        send orderPlaced to outlet EncounterEventSplitToEncounterAnalytics
        tell orderPlaced to entity EncounterContext.Encounter
      }
      on noteSigned: event Encounter.NoteSigned is {
        send noteSigned to outlet EncounterEventSplitToEncounterRepository
        send noteSigned to outlet EncounterEventSplitToEncounterAnalytics
        tell noteSigned to entity EncounterContext.Encounter
      }
      on encounterCompleted: event Encounter.EncounterCompleted is {
        send encounterCompleted to outlet EncounterEventSplitToEncounterRepository
        send encounterCompleted to outlet EncounterEventSplitToEncounterAnalytics
        tell encounterCompleted to entity EncounterContext.Encounter
      }
      on encounterCanceled: event Encounter.EncounterCanceled is {
        send encounterCanceled to outlet EncounterEventSplitToEncounterRepository
        send encounterCanceled to outlet EncounterEventSplitToEncounterAnalytics
        tell encounterCanceled to entity EncounterContext.Encounter
      }
      on other is {
        error "Unexpected message for processor EncounterEventSplit"
      }
    } with {
      briefly "Encounter event fan-out handler"
      described as {
        |Delivers each Encounter event to all of its consumers.
      }
    }
  } with {
    briefly "Encounter event fan-out"
    described as {
      |Fans Encounter events out to the repository and projectors.
    }
  }
  connector 'EncounterEvent Stream' is from outlet EncounterContext.Encounter.EncounterEvents2 to inlet EncounterContext.EncounterEventSplit.EncounterEventSplitIn with {
    briefly "Encounter events, fanned out to storage and read models"
  }
  connector 'EncounterEvent Storage' is from outlet EncounterContext.EncounterEventSplit.EncounterEventSplitToEncounterRepository to inlet EncounterContext.EncounterRepository.EncounterRepositoryFromEncounter with {
    briefly "Encounter events on their way to storage"
  }
  connector 'EncounterAnalytics Feed' is from outlet EncounterContext.EncounterEventSplit.EncounterEventSplitToEncounterAnalytics to inlet EncounterContext.EncounterAnalytics.EncounterAnalyticsFromEncounter with {
    briefly "Encounter events feeding the EncounterAnalytics projection"
  }
  connector 'EncounterAnalytics Storage' is from outlet EncounterContext.EncounterAnalytics.EncounterAnalyticsOut to inlet EncounterContext.EncounterRepository.EncounterRepositoryFromEncounterAnalytics with {
    briefly "The EncounterAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for clinical encounters"
  described as {
    | The EncounterContext is the bounded context for
    | clinical visit documentation and management.
  }
}
