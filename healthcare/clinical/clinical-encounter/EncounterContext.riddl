// Clinical Encounter - Encounter Context
context EncounterContext is {
  adaptor FromBillingService from context BillingService is {
    handler FromBillingServiceHandler is {
      on event BillingService.BillingSubmitted is {
        do "the model receives billing submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
      briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService is {
    handler ToBillingServiceHandler is {
      on command BillingService.SubmitEncounterForBilling is {
        do "the model sends submit encounter for billing"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
      briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromCodingService from context CodingService is {
    handler FromCodingServiceHandler is {
      on event CodingService.CodesSuggested is {
        do "the model receives codes suggested"
      }
      on other is {
        error "Unexpected message for adaptor FromCodingService"
      }
    } with {
      briefly "from coding service"
      described as {
        |Carries messages from the external CodingService.
      }
    }
  } with {
      briefly "CodingService integration"
    described as {
      |The model's side of the CodingService conversation.
    }
  }
  adaptor ToCodingService to context CodingService is {
    handler ToCodingServiceHandler is {
      on command CodingService.SuggestCodes is {
        do "the model sends suggest codes"
      }
      on other is {
        error "Unexpected message for adaptor ToCodingService"
      }
    } with {
      briefly "to coding service"
      described as {
        |Carries messages to the external CodingService.
      }
    }
  } with {
      briefly "CodingService integration"
    described as {
      |The model's side of the CodingService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is {
    handler FromNotificationServiceHandler is {
      on event NotificationService.AlertSent is {
        do "the model receives alert sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is {
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendProviderAlert is {
        do "the model sends send provider alert"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromOrderEntryService from context OrderEntryService is {
    handler FromOrderEntryServiceHandler is {
      on event OrderEntryService.OrderSubmitted is {
        do "the model receives order submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromOrderEntryService"
      }
    } with {
      briefly "from order entry service"
      described as {
        |Carries messages from the external OrderEntryService.
      }
    }
  } with {
      briefly "OrderEntryService integration"
    described as {
      |The model's side of the OrderEntryService conversation.
    }
  }
  adaptor ToOrderEntryService to context OrderEntryService is {
    handler ToOrderEntryServiceHandler is {
      on command OrderEntryService.SubmitOrder is {
        do "the model sends submit order"
      }
      on other is {
        error "Unexpected message for adaptor ToOrderEntryService"
      }
    } with {
      briefly "to order entry service"
      described as {
        |Carries messages to the external OrderEntryService.
      }
    }
  } with {
      briefly "OrderEntryService integration"
    described as {
      |The model's side of the OrderEntryService conversation.
    }
  }
  adaptor FromPatientRecordService from context PatientRecordService is {
    handler FromPatientRecordServiceHandler is {
      on result PatientRecordService.PatientRecord is {
        do "the model receives patient record"
      }
      on other is {
        error "Unexpected message for adaptor FromPatientRecordService"
      }
    } with {
      briefly "from patient record service"
      described as {
        |Carries messages from the external PatientRecordService.
      }
    }
  } with {
      briefly "PatientRecordService integration"
    described as {
      |The model's side of the PatientRecordService conversation.
    }
  }
  adaptor ToPatientRecordService to context PatientRecordService is {
    handler ToPatientRecordServiceHandler is {
      on query PatientRecordService.GetPatient is {
        do "the model sends get patient"
      }
      on other is {
        error "Unexpected message for adaptor ToPatientRecordService"
      }
    } with {
      briefly "to patient record service"
      described as {
        |Carries messages to the external PatientRecordService.
      }
    }
  } with {
      briefly "PatientRecordService integration"
    described as {
      |The model's side of the PatientRecordService conversation.
    }
  }
  adaptor FromSchedulingService from context SchedulingService is {
    handler FromSchedulingServiceHandler is {
      on event SchedulingService.PatientCheckedIn is {
        do "the model receives patient checked in"
      }
      on other is {
        error "Unexpected message for adaptor FromSchedulingService"
      }
    } with {
      briefly "from scheduling service"
      described as {
        |Carries messages from the external SchedulingService.
      }
    }
  } with {
      briefly "SchedulingService integration"
    described as {
      |The model's side of the SchedulingService conversation.
    }
  }
  adaptor ToSchedulingService to context SchedulingService is {
    handler ToSchedulingServiceHandler is {
      on command SchedulingService.CheckInPatient is {
        do "the model sends check in patient"
      }
      on other is {
        error "Unexpected message for adaptor ToSchedulingService"
      }
    } with {
      briefly "to scheduling service"
      described as {
        |Carries messages to the external SchedulingService.
      }
    }
  } with {
      briefly "SchedulingService integration"
    described as {
      |The model's side of the SchedulingService conversation.
    }
  }
  include "types.riddl"
  include "Encounter.riddl"
  // Repository for encounter persistence
  repository EncounterRepository is {
    inlet EncounterRepositoryFromEncounter is type EncounterEvent
    inlet EncounterRepositoryFromEncounterAnalytics is type EncounterEvent
    outlet EncounterRepositoryResponses is type Encounter.EncounterResult
    record StoredEncounter is {
      encounterId: EncounterId with {
        briefly "encounterId"
        described as {
          |The encounterId column of the stored encounter row.
        }
      }
      patient: PatientInfo with {
        briefly "patient"
        described as {
          |The patient column of the stored encounter row.
        }
      }
    } with {
      briefly "Stored encounter row"
      described as {
        |The persistence shape of encounter data as this repository stores it.
      }
    }
    schema EncounterData is relational
      of encounters as type StoredEncounter
        index on field StoredEncounter.encounterId
        index on field StoredEncounter.patient.patientId
      with {
      briefly "Encounter data schema"
      described as {
        |The relational schema holding encounter data for the EncounterRepository.
      }
    }

    handler EncounterPersistence is {
      on command Encounter.StartEncounter is {
        tell event Encounter.EncounterStarted to entity EncounterContext.Encounter
      }
      on command Encounter.RecordVitals is {
        tell event Encounter.VitalsRecorded to entity EncounterContext.Encounter
      }
      on command Encounter.RecordChiefComplaint is {
        tell event Encounter.ChiefComplaintRecorded to entity EncounterContext.Encounter
      }
      on command Encounter.AddClinicalNote is {
        tell event Encounter.ClinicalNoteAdded to entity EncounterContext.Encounter
      }
      on command Encounter.AddDiagnosis is {
        tell event Encounter.DiagnosisAdded to entity EncounterContext.Encounter
      }
      on command Encounter.RecordProcedure is {
        tell event Encounter.ProcedureRecorded to entity EncounterContext.Encounter
      }
      on command Encounter.PlaceOrder is {
        tell event Encounter.OrderPlaced to entity EncounterContext.Encounter
      }
      on command Encounter.SignNote is {
        tell event Encounter.NoteSigned to entity EncounterContext.Encounter
      }
      on command Encounter.CompleteEncounter is {
        tell event Encounter.EncounterCompleted to entity EncounterContext.Encounter
      }
      on command Encounter.CancelEncounter is {
        tell event Encounter.EncounterCanceled to entity EncounterContext.Encounter
      }
    } with {
      briefly "Persists encounter commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Encounter data persistence"
    described as {
      | The EncounterRepository provides persistent storage for
      | clinical encounters and documentation.
    }
  }
  // Projector for encounter analytics
  projector EncounterAnalytics is {
    inlet EncounterAnalyticsFromEncounter is type EncounterEvent
    outlet EncounterAnalyticsOut is type EncounterEvent
    updates repository EncounterContext.EncounterRepository
    record EncounterStats is  {
      totalEncounters: Natural with {
        briefly "Total"
        described as {
          |Total encounters.
        }
      }
      avgDuration: Duration with {
        briefly "Avg duration"
        described as {
          |Average encounter length.
        }
      }
      encountersByType: String(1,100)+ with {
        briefly "By type"
        described as {
          |Counts by type.
        }
      }
      completionRate: Decimal(5,4) with {
        briefly "Completion"
        described as {
          |Completion rate.
        }
      }
      avgDiagnoses: Decimal(4,2) with {
        briefly "Avg diagnoses"
        described as {
          |Average diagnoses per visit.
        }
      }
    } with {
      briefly "Encounter statistics"
      described as {
        |Clinical encounter metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Encounter.EncounterStarted is {
        tell event Encounter.EncounterStarted to repository EncounterContext.EncounterRepository
      }
      on event Encounter.EncounterCompleted is {
        tell event Encounter.EncounterCompleted to repository EncounterContext.EncounterRepository
      }
      on event Encounter.DiagnosisAdded is {
        tell event Encounter.DiagnosisAdded to repository EncounterContext.EncounterRepository
      }
    } with {
      briefly "Maintains encounter analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Encounter analytics projections"
    described as {
      |Maintains clinical encounter analytics data.
    }
  }
  type EncounterEvent is one of {
    EncounterContext.Encounter.EncounterStarted,
    EncounterContext.Encounter.VitalsRecorded,
    EncounterContext.Encounter.ChiefComplaintRecorded,
    EncounterContext.Encounter.ClinicalNoteAdded,
    EncounterContext.Encounter.DiagnosisAdded,
    EncounterContext.Encounter.ProcedureRecorded,
    EncounterContext.Encounter.OrderPlaced,
    EncounterContext.Encounter.NoteSigned,
    EncounterContext.Encounter.EncounterCompleted,
    EncounterContext.Encounter.EncounterCanceled
  } with {
    briefly "Encounter events"
    described as {
      |Union of all encounter entity events for streaming.
    }
  }
  processor EncounterSource as source is {
    outlet EncounterEvents is type EncounterEvent with {
      briefly "Encounter event outlet"
      described as {
        |Publishes encounter events.
      }
    }
    handler EncounterSourceHandler is {
      on init is {
        tell command Encounter.InitializeEncounter to entity EncounterContext.Encounter
      }
      on event Encounter.EncounterStarted is {
        send event Encounter.EncounterStarted to outlet EncounterEvents
      }
      on event Encounter.EncounterCompleted is {
        send event Encounter.EncounterCompleted to outlet EncounterEvents
      }
      on event Encounter.EncounterCanceled is {
        send event Encounter.EncounterCanceled to outlet EncounterEvents
      }
      on other is {
        error "Unexpected message for source EncounterSource"
      }
    } with {
      briefly "Encounter source handler"
      described as {
        |Forwards encounter events to the outlet.
      }
    }
  } with {
    briefly "Encounter event source"
    described as {
      |Source streamlet that publishes encounter events.
    }
  }
  processor EncounterSink as sink is {
    inlet EncounterEventsIn is type EncounterEvent with {
      briefly "Encounter event inlet"
      described as {
        |Receives encounter events.
      }
    }
    handler EncounterSinkHandler is {
      on init is { ??? }
      on event Encounter.EncounterStarted is {
        tell event Encounter.EncounterStarted to repository EncounterContext.EncounterRepository
      }
      on event Encounter.EncounterCompleted is {
        tell event Encounter.EncounterCompleted to repository EncounterContext.EncounterRepository
      }
      on other is {
        error "Unexpected message for sink EncounterSink"
      }
    } with {
      briefly "Encounter sink handler"
      described as {
        |Persists encounter events from the inlet.
      }
    }
  } with {
    briefly "Encounter event sink"
    described as {
      |Sink streamlet that consumes encounter events.
    }
  }
  connector EncounterFlow is {
    from outlet EncounterContext.EncounterSource.EncounterEvents to
      inlet EncounterContext.EncounterSink.EncounterEventsIn
  } with {
    briefly "Encounter event flow"
    described as {
      |Connects encounter source to sink for event streaming.
    }
  }
  processor EncounterEventSplit is {
    inlet EncounterEventSplitIn is type EncounterEvent
    outlet EncounterEventSplitToEncounterRepository is type EncounterEvent
    outlet EncounterEventSplitToEncounterAnalytics is type EncounterEvent
    handler EncounterEventSplitHandler is {
      on event Encounter.EncounterStarted is {
        send event Encounter.EncounterStarted to outlet EncounterEventSplitToEncounterRepository
        send event Encounter.EncounterStarted to outlet EncounterEventSplitToEncounterAnalytics
        tell event Encounter.EncounterStarted to entity EncounterContext.Encounter
      }
      on event Encounter.VitalsRecorded is {
        send event Encounter.VitalsRecorded to outlet EncounterEventSplitToEncounterRepository
        send event Encounter.VitalsRecorded to outlet EncounterEventSplitToEncounterAnalytics
        tell event Encounter.VitalsRecorded to entity EncounterContext.Encounter
      }
      on event Encounter.ChiefComplaintRecorded is {
        send event Encounter.ChiefComplaintRecorded to outlet EncounterEventSplitToEncounterRepository
        send event Encounter.ChiefComplaintRecorded to outlet EncounterEventSplitToEncounterAnalytics
        tell event Encounter.ChiefComplaintRecorded to entity EncounterContext.Encounter
      }
      on event Encounter.ClinicalNoteAdded is {
        send event Encounter.ClinicalNoteAdded to outlet EncounterEventSplitToEncounterRepository
        send event Encounter.ClinicalNoteAdded to outlet EncounterEventSplitToEncounterAnalytics
        tell event Encounter.ClinicalNoteAdded to entity EncounterContext.Encounter
      }
      on event Encounter.DiagnosisAdded is {
        send event Encounter.DiagnosisAdded to outlet EncounterEventSplitToEncounterRepository
        send event Encounter.DiagnosisAdded to outlet EncounterEventSplitToEncounterAnalytics
        tell event Encounter.DiagnosisAdded to entity EncounterContext.Encounter
      }
      on event Encounter.ProcedureRecorded is {
        send event Encounter.ProcedureRecorded to outlet EncounterEventSplitToEncounterRepository
        send event Encounter.ProcedureRecorded to outlet EncounterEventSplitToEncounterAnalytics
        tell event Encounter.ProcedureRecorded to entity EncounterContext.Encounter
      }
      on event Encounter.OrderPlaced is {
        send event Encounter.OrderPlaced to outlet EncounterEventSplitToEncounterRepository
        send event Encounter.OrderPlaced to outlet EncounterEventSplitToEncounterAnalytics
        tell event Encounter.OrderPlaced to entity EncounterContext.Encounter
      }
      on event Encounter.NoteSigned is {
        send event Encounter.NoteSigned to outlet EncounterEventSplitToEncounterRepository
        send event Encounter.NoteSigned to outlet EncounterEventSplitToEncounterAnalytics
        tell event Encounter.NoteSigned to entity EncounterContext.Encounter
      }
      on event Encounter.EncounterCompleted is {
        send event Encounter.EncounterCompleted to outlet EncounterEventSplitToEncounterRepository
        send event Encounter.EncounterCompleted to outlet EncounterEventSplitToEncounterAnalytics
        tell event Encounter.EncounterCompleted to entity EncounterContext.Encounter
      }
      on event Encounter.EncounterCanceled is {
        send event Encounter.EncounterCanceled to outlet EncounterEventSplitToEncounterRepository
        send event Encounter.EncounterCanceled to outlet EncounterEventSplitToEncounterAnalytics
        tell event Encounter.EncounterCanceled to entity EncounterContext.Encounter
      }
      on other is {
        error "Unexpected message for processor EncounterEventSplit"
      }
    } with {
      briefly "Encounter event fan-out handler"
      described as {
        |Delivers each Encounter event to all of its consumers.
      }
    }
  } with {
    briefly "Encounter event fan-out"
    described as {
      |Fans Encounter events out to the repository and projectors.
    }
  }
  connector LinkEncounterToEncounterEventSplit is {
    from outlet EncounterContext.Encounter.EncounterEvents2 to
      inlet EncounterContext.EncounterEventSplit.EncounterEventSplitIn
  } with {
    briefly "LinkEncounterToEncounterEventSplit"
  }
  connector LinkEncounterEventSplitToEncounterRepository is {
    from outlet EncounterContext.EncounterEventSplit.EncounterEventSplitToEncounterRepository to
      inlet EncounterContext.EncounterRepository.EncounterRepositoryFromEncounter
  } with {
    briefly "LinkEncounterEventSplitToEncounterRepository"
  }
  connector LinkEncounterEventSplitToEncounterAnalytics is {
    from outlet EncounterContext.EncounterEventSplit.EncounterEventSplitToEncounterAnalytics to
      inlet EncounterContext.EncounterAnalytics.EncounterAnalyticsFromEncounter
  } with {
    briefly "LinkEncounterEventSplitToEncounterAnalytics"
  }
  connector LinkEncounterAnalyticsToEncounterRepository is {
    from outlet EncounterContext.EncounterAnalytics.EncounterAnalyticsOut to
      inlet EncounterContext.EncounterRepository.EncounterRepositoryFromEncounterAnalytics
  } with {
    briefly "LinkEncounterAnalyticsToEncounterRepository"
  }
} with {
  briefly "Bounded context for clinical encounters"
  described as {
    | The EncounterContext is the bounded context for
    | clinical visit documentation and management.
  }
}
