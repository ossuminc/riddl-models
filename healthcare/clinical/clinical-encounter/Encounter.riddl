// Clinical Encounter - Encounter Entity
entity Encounter as flow is {
  type EncounterCommand is one of {
    Encounter.StartEncounter or Encounter.RecordVitals or Encounter.RecordChiefComplaint or Encounter.AddClinicalNote or Encounter.AddDiagnosis or Encounter.RecordProcedure or Encounter.PlaceOrder or Encounter.SignNote or Encounter.CompleteEncounter or Encounter.CancelEncounter
  } with {
    briefly "Encounter command alternation"
    described as {
      |Commands accepted by the Encounter entity.
    }
  }
  inlet EncounterCommands is type EncounterCommand  outlet EncounterEvents2 is type EncounterEvent
  // Commands
  command StartEncounter is  {
    encounterId: EncounterId with {
      briefly "Encounter ID"
      described as {
        |New encounter identifier.
      }
    }
    patient: PatientInfo with {
      briefly "Patient"
      described as {
        |Patient information.
      }
    }
    provider: ProviderInfo with {
      briefly "Provider"
      described as {
        |Treating provider.
      }
    }
    facilityId: FacilityId with {
      briefly "Facility"
      described as {
        |Healthcare facility.
      }
    }
    encounterType: EncounterType with {
      briefly "Type"
      described as {
        |Encounter type.
      }
    }
    visitReason: VisitReason with {
      briefly "Reason"
      described as {
        |Visit reason.
      }
    }
  } with {
    briefly "Start encounter"
    described as {
      |Begins a clinical encounter.
    }
  }
  command RecordVitals is  {
    encounterId: EncounterId with {
      briefly "Encounter ID"
      described as {
        |Encounter identifier.
      }
    }
    vitals: VitalSigns with {
      briefly "Vitals"
      described as {
        |Vital signs.
      }
    }
  } with {
    briefly "Record vitals"
    described as {
      |Records patient vital signs.
    }
  }
  command RecordChiefComplaint is  {
    encounterId: EncounterId with {
      briefly "Encounter ID"
      described as {
        |Encounter identifier.
      }
    }
    complaint: ChiefComplaint with {
      briefly "Complaint"
      described as {
        |Chief complaint.
      }
    }
  } with {
    briefly "Record complaint"
    described as {
      |Records chief complaint.
    }
  }
  command AddClinicalNote is  {
    encounterId: EncounterId with {
      briefly "Encounter ID"
      described as {
        |Encounter identifier.
      }
    }
    note: ClinicalNote with {
      briefly "Note"
      described as {
        |Clinical note.
      }
    }
  } with {
    briefly "Add note"
    described as {
      |Adds clinical documentation.
    }
  }
  command AddDiagnosis is  {
    encounterId: EncounterId with {
      briefly "Encounter ID"
      described as {
        |Encounter identifier.
      }
    }
    diagnosis: Diagnosis with {
      briefly "Diagnosis"
      described as {
        |Clinical diagnosis.
      }
    }
  } with {
    briefly "Add diagnosis"
    described as {
      |Records a diagnosis.
    }
  }
  command RecordProcedure is  {
    encounterId: EncounterId with {
      briefly "Encounter ID"
      described as {
        |Encounter identifier.
      }
    }
    encounterProcedure: EncounterProcedure with {
      briefly "Procedure"
      described as {
        |Procedure performed.
      }
    }
  } with {
    briefly "Record procedure"
    described as {
      |Records a procedure.
    }
  }
  command PlaceOrder is  {
    encounterId: EncounterId with {
      briefly "Encounter ID"
      described as {
        |Encounter identifier.
      }
    }
    order: EncounterOrder with {
      briefly "Order"
      described as {
        |Clinical order.
      }
    }
  } with {
    briefly "Place order"
    described as {
      |Places a clinical order.
    }
  }
  command SignNote is  {
    encounterId: EncounterId with {
      briefly "Encounter ID"
      described as {
        |Encounter identifier.
      }
    }
    noteType: String(1,50) with {
      briefly "Note type"
      described as {
        |Type of note to sign.
      }
    }
    signedBy: ProviderId with {
      briefly "Signed by"
      described as {
        |Signing provider.
      }
    }
  } with {
    briefly "Sign note"
    described as {
      |Signs clinical documentation.
    }
  }
  command CompleteEncounter is  {
    encounterId: EncounterId with {
      briefly "Encounter ID"
      described as {
        |Encounter identifier.
      }
    }
    disposition: DispositionInfo with {
      briefly "Disposition"
      described as {
        |Patient disposition.
      }
    }
  } with {
    briefly "Complete encounter"
    described as {
      |Completes the encounter.
    }
  }
  command CancelEncounter is  {
    encounterId: EncounterId with {
      briefly "Encounter ID"
      described as {
        |Encounter identifier.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
  } with {
    briefly "Cancel encounter"
    described as {
      |Cancels the encounter.
    }
  }
  // Events
  event EncounterStarted is  {
    encounterId: EncounterId with {
      briefly "Encounter"
      described as {
        |Encounter ID.
      }
    }
    patient: PatientInfo with {
      briefly "Patient"
      described as {
        |Patient info.
      }
    }
    provider: ProviderInfo with {
      briefly "Provider"
      described as {
        |Provider info.
      }
    }
    facilityId: FacilityId with {
      briefly "Facility"
      described as {
        |Facility ID.
      }
    }
    encounterType: EncounterType with {
      briefly "Type"
      described as {
        |Encounter type.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
  } with {
    briefly "Encounter started"
    described as {
      |Emitted when encounter begins.
    }
  }
  event VitalsRecorded is  {
    encounterId: EncounterId with {
      briefly "Encounter"
      described as {
        |Encounter ID.
      }
    }
    vitals: VitalSigns with {
      briefly "Vitals"
      described as {
        |Vital signs.
      }
    }
  } with {
    briefly "Vitals recorded"
    described as {
      |Emitted when vitals are recorded.
    }
  }
  event ChiefComplaintRecorded is  {
    encounterId: EncounterId with {
      briefly "Encounter"
      described as {
        |Encounter ID.
      }
    }
    complaint: ChiefComplaint with {
      briefly "Complaint"
      described as {
        |Chief complaint.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Complaint recorded"
    described as {
      |Emitted when complaint is recorded.
    }
  }
  event ClinicalNoteAdded is  {
    encounterId: EncounterId with {
      briefly "Encounter"
      described as {
        |Encounter ID.
      }
    }
    note: ClinicalNote with {
      briefly "Note"
      described as {
        |Clinical note.
      }
    }
  } with {
    briefly "Note added"
    described as {
      |Emitted when note is added.
    }
  }
  event DiagnosisAdded is  {
    encounterId: EncounterId with {
      briefly "Encounter"
      described as {
        |Encounter ID.
      }
    }
    diagnosis: Diagnosis with {
      briefly "Diagnosis"
      described as {
        |Added diagnosis.
      }
    }
  } with {
    briefly "Diagnosis added"
    described as {
      |Emitted when diagnosis is recorded.
    }
  }
  event ProcedureRecorded is  {
    encounterId: EncounterId with {
      briefly "Encounter"
      described as {
        |Encounter ID.
      }
    }
    encounterProcedure: EncounterProcedure with {
      briefly "Procedure"
      described as {
        |Procedure performed.
      }
    }
  } with {
    briefly "Procedure recorded"
    described as {
      |Emitted when procedure is documented.
    }
  }
  event OrderPlaced is  {
    encounterId: EncounterId with {
      briefly "Encounter"
      described as {
        |Encounter ID.
      }
    }
    order: EncounterOrder with {
      briefly "Order"
      described as {
        |Placed order.
      }
    }
  } with {
    briefly "Order placed"
    described as {
      |Emitted when order is placed.
    }
  }
  event NoteSigned is  {
    encounterId: EncounterId with {
      briefly "Encounter"
      described as {
        |Encounter ID.
      }
    }
    noteType: String(1,50) with {
      briefly "Note type"
      described as {
        |Signed note type.
      }
    }
    signedBy: ProviderId with {
      briefly "Signed by"
      described as {
        |Signing provider.
      }
    }
    signatureTime: TimeStamp with {
      briefly "Signed"
      described as {
        |Signature time.
      }
    }
  } with {
    briefly "Note signed"
    described as {
      |Emitted when note is signed.
    }
  }
  event EncounterCompleted is  {
    encounterId: EncounterId with {
      briefly "Encounter"
      described as {
        |Encounter ID.
      }
    }
    disposition: DispositionInfo with {
      briefly "Disposition"
      described as {
        |Final disposition.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Encounter completed"
    described as {
      |Emitted when encounter ends.
    }
  }
  event EncounterCanceled is  {
    encounterId: EncounterId with {
      briefly "Encounter"
      described as {
        |Encounter ID.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Cancel reason.
      }
    }
    canceledAt: TimeStamp with {
      briefly "Canceled"
      described as {
        |Cancel time.
      }
    }
  } with {
    briefly "Encounter canceled"
    described as {
      |Emitted when encounter is canceled.
    }
  }
  // State Records
  record InProgressStateData is  {
    encounterId: EncounterId with {
      briefly "Encounter"
      described as {
        |Encounter ID.
      }
    }
    patient: PatientInfo with {
      briefly "Patient"
      described as {
        |Patient info.
      }
    }
    provider: ProviderInfo with {
      briefly "Provider"
      described as {
        |Provider info.
      }
    }
    facilityId: FacilityId with {
      briefly "Facility"
      described as {
        |Facility ID.
      }
    }
    encounterType: EncounterType with {
      briefly "Type"
      described as {
        |Encounter type.
      }
    }
    visitReason: VisitReason with {
      briefly "Reason"
      described as {
        |Visit reason.
      }
    }
    recordedVitals: VitalSigns? with {
      briefly "Vitals"
      described as {
        |Vital signs.
      }
    }
    chiefComplaint: ChiefComplaint? with {
      briefly "Complaint"
      described as {
        |Chief complaint.
      }
    }
    notes: ClinicalNote* with {
      briefly "Notes"
      described as {
        |Clinical notes.
      }
    }
    encounterDiagnoses: Diagnosis* with {
      briefly "Diagnoses"
      described as {
        |Diagnoses.
      }
    }
    encounterProcedures: EncounterProcedure* with {
      briefly "Procedures"
      described as {
        |Procedures.
      }
    }
    orders: EncounterOrder* with {
      briefly "Orders"
      described as {
        |Orders placed.
      }
    }
    status: EncounterStatus with {
      briefly "Status"
      described as {
        |Encounter status.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
  } with {
    briefly "In progress state"
    described as {
      |State for active encounter.
    }
  }
  record CompletedStateData is  {
    encounterId: EncounterId with {
      briefly "Encounter"
      described as {
        |Encounter ID.
      }
    }
    patient: PatientInfo with {
      briefly "Patient"
      described as {
        |Patient info.
      }
    }
    provider: ProviderInfo with {
      briefly "Provider"
      described as {
        |Provider info.
      }
    }
    encounterType: EncounterType with {
      briefly "Type"
      described as {
        |Encounter type.
      }
    }
    finalVitals: VitalSigns? with {
      briefly "Vitals"
      described as {
        |Final vitals.
      }
    }
    finalDiagnoses: Diagnosis+ with {
      briefly "Diagnoses"
      described as {
        |Final diagnoses.
      }
    }
    completedProcedures: EncounterProcedure* with {
      briefly "Procedures"
      described as {
        |Procedures.
      }
    }
    disposition: DispositionInfo with {
      briefly "Disposition"
      described as {
        |Disposition.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Completed state"
    described as {
      |State for completed encounter.
    }
  }
  record CanceledStateData is  {
    encounterId: EncounterId with {
      briefly "Encounter"
      described as {
        |Encounter ID.
      }
    }
    patient: PatientInfo with {
      briefly "Patient"
      described as {
        |Patient info.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Cancel reason.
      }
    }
    canceledAt: TimeStamp with {
      briefly "Canceled"
      described as {
        |Cancel time.
      }
    }
  } with {
    briefly "Canceled state"
    described as {
      |State for canceled encounter.
    }
  }
  // Queries
  query GetEncounter replies result EncounterResult is  {
    encounterId: EncounterId with {
      briefly "Encounter ID"
      described as {
        |Encounter to retrieve.
      }
    }
  } with {
    briefly "Get encounter"
    described as {
      |Retrieves encounter data.
    }
  }
  result EncounterResult is  {
    encounterId: EncounterId with {
      briefly "Encounter ID"
      described as {
        |Encounter identifier.
      }
    }
    patient: PatientInfo with {
      briefly "Patient"
      described as {
        |Patient information.
      }
    }
    encounterType: EncounterType with {
      briefly "Type"
      described as {
        |Encounter type.
      }
    }
    status: EncounterStatus with {
      briefly "Status"
      described as {
        |Current status.
      }
    }
  } with {
    briefly "Encounter result"
    described as {
      |Encounter data result.
    }
  }
  // States
  initial state InProgressState of record Encounter.InProgressStateData is {
    initial handler InProgressStateInitHandler is {
      on init is {
        set state InProgressState to "initialize from prior event"
      }
    } with {
      briefly "In-progress state init handler"
      described as {
        |Initializes the InProgress state.
      }
    }
  } with {
    briefly "In-progress state"
    described as {
      |Active state for an ongoing encounter.
    }
  }
  state CompletedState of record Encounter.CompletedStateData is {
    initial handler CompletedStateInitHandler is {
      on init is {
        set state CompletedState to "initialize from prior event"
      }
    } with {
      briefly "Completed state init handler"
      described as {
        |Initializes the Completed state.
      }
    }
  } with {
    briefly "Completed state"
    described as {
      |Terminal state for a completed encounter.
    }
  }
  state CanceledState of record Encounter.CanceledStateData is {
    initial handler CanceledStateInitHandler is {
      on init is {
        set state CanceledState to "initialize from prior event"
      }
    } with {
      briefly "Canceled state init handler"
      described as {
        |Initializes the Canceled state.
      }
    }
  } with {
    briefly "Canceled state"
    described as {
      |Terminal state for a canceled encounter.
    }
  }
  // Handler
  handler EncounterHandler is {
    on startEncounter: command StartEncounter is {
      morph entity EncounterContext.Encounter to state EncounterContext.Encounter.InProgressState with record Encounter.InProgressStateData(encounterId = startEncounter.encounterId, patient = startEncounter.patient, provider = startEncounter.provider, facilityId = startEncounter.facilityId, encounterType = startEncounter.encounterType, visitReason = startEncounter.visitReason, recordedVitals = empty, chiefComplaint = empty, notes = empty, encounterDiagnoses = empty, encounterProcedures = empty, orders = empty, status = prompt("the status of this in progress state data"), startedAt = prompt("the started at of this in progress state data"))
      tell event EncounterStarted(encounterId = startEncounter.encounterId, patient = startEncounter.patient, provider = startEncounter.provider, facilityId = startEncounter.facilityId, encounterType = startEncounter.encounterType, startedAt = prompt("the started at of this encounter started")) to entity EncounterContext.Encounter
    }
    on recordVitals: command RecordVitals is {
      tell event VitalsRecorded(encounterId = recordVitals.encounterId, vitals = recordVitals.vitals) to entity EncounterContext.Encounter
    }
    on recordChiefComplaint: command RecordChiefComplaint is {
      tell event ChiefComplaintRecorded(encounterId = recordChiefComplaint.encounterId, complaint = recordChiefComplaint.complaint, recordedAt = prompt("the recorded at of this chief complaint recorded")) to entity EncounterContext.Encounter
    }
    on addClinicalNote: command AddClinicalNote is {
      tell event ClinicalNoteAdded(encounterId = addClinicalNote.encounterId, note = addClinicalNote.note) to entity EncounterContext.Encounter
    }
    on addDiagnosis: command AddDiagnosis is {
      tell event DiagnosisAdded(encounterId = addDiagnosis.encounterId, diagnosis = addDiagnosis.diagnosis) to entity EncounterContext.Encounter
    }
    on recordProcedure: command RecordProcedure is {
      tell event ProcedureRecorded(encounterId = recordProcedure.encounterId, encounterProcedure = recordProcedure.encounterProcedure) to entity EncounterContext.Encounter
    }
    on placeOrder: command PlaceOrder is {
      tell event OrderPlaced(encounterId = placeOrder.encounterId, order = placeOrder.order) to entity EncounterContext.Encounter
    }
    on signNote: command SignNote is {
      tell event NoteSigned(encounterId = signNote.encounterId, noteType = signNote.noteType, signedBy = signNote.signedBy, signatureTime = prompt("the signature time of this note signed")) to entity EncounterContext.Encounter
    }
    on completeEncounter: command CompleteEncounter is {
      morph entity EncounterContext.Encounter to state EncounterContext.Encounter.CompletedState with record Encounter.CompletedStateData(encounterId = completeEncounter.encounterId, disposition = completeEncounter.disposition, patient = prompt("the patient of this completed state data"), provider = prompt("the provider of this completed state data"), encounterType = prompt("the encounter type of this completed state data"), finalVitals = empty, finalDiagnoses = prompt("the final diagnoses of this completed state data"), completedProcedures = empty, startedAt = prompt("the started at of this completed state data"), completedAt = prompt("the completed at of this completed state data"))
      tell event EncounterCompleted(encounterId = completeEncounter.encounterId, disposition = completeEncounter.disposition, completedAt = prompt("the completed at of this encounter completed")) to entity EncounterContext.Encounter
    }
    on cancelEncounter: command CancelEncounter is {
      morph entity EncounterContext.Encounter to state EncounterContext.Encounter.CanceledState with record Encounter.CanceledStateData(encounterId = cancelEncounter.encounterId, reason = cancelEncounter.reason, patient = prompt("the patient of this canceled state data"), canceledAt = prompt("the canceled at of this canceled state data"))
      tell event EncounterCanceled(encounterId = cancelEncounter.encounterId, reason = cancelEncounter.reason, canceledAt = prompt("the canceled at of this encounter canceled")) to entity EncounterContext.Encounter
    }
    on getEncounter: query GetEncounter is {
      reply result EncounterResult(encounterId = getEncounter.encounterId, patient = prompt("the patient of this encounter result"), encounterType = prompt("the encounter type of this encounter result"), status = prompt("the status of this encounter result"))
    }
    on chiefComplaintRecorded: event ChiefComplaintRecorded is {
      do "apply ChiefComplaintRecorded to the encounter so it can be persisted and replayed"
    }
    on clinicalNoteAdded: event ClinicalNoteAdded is {
      do "apply ClinicalNoteAdded to the encounter so it can be persisted and replayed"
    }
    on diagnosisAdded: event DiagnosisAdded is {
      do "apply DiagnosisAdded to the encounter so it can be persisted and replayed"
    }
    on encounterCanceled: event EncounterCanceled is {
      do "apply EncounterCanceled to the encounter so it can be persisted and replayed"
    }
    on encounterCompleted: event EncounterCompleted is {
      do "apply EncounterCompleted to the encounter so it can be persisted and replayed"
    }
    on encounterStarted: event EncounterStarted is {
      do "apply EncounterStarted to the encounter so it can be persisted and replayed"
    }
    on noteSigned: event NoteSigned is {
      do "apply NoteSigned to the encounter so it can be persisted and replayed"
    }
    on orderPlaced: event OrderPlaced is {
      do "apply OrderPlaced to the encounter so it can be persisted and replayed"
    }
    on procedureRecorded: event ProcedureRecorded is {
      do "apply ProcedureRecorded to the encounter so it can be persisted and replayed"
    }
    on vitalsRecorded: event VitalsRecorded is {
      do "apply VitalsRecorded to the encounter so it can be persisted and replayed"
    }
  } with {
    briefly "Processes encounter commands"
    described as {
      | Handles clinical encounter lifecycle from start
      | through documentation, orders, and completion.
    }
  }
} with {
  briefly "Encounter aggregate"
  described as {
    | The Encounter entity manages clinical encounters
    | including documentation, diagnoses, and orders.
  }
}
