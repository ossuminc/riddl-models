// Patient Registration Domain Model
// Patient demographics and registration management
domain PatientRegistration is {
  persistent connector 'DocumentStorageServiceEvent Stream' is from outlet DocumentStorageService.DocumentStorageServiceEventsOut to inlet PatientContext.FromDocumentStorageService.FromDocumentStorageServiceIn with {
    briefly "What DocumentStorageService tells PatientContext, unasked"
  }
  persistent connector 'IdentityVerificationServiceEvent Stream' is from outlet IdentityVerificationService.IdentityVerificationServiceEventsOut to inlet PatientContext.FromIdentityVerificationService.FromIdentityVerificationServiceIn with {
    briefly "What IdentityVerificationService tells PatientContext, unasked"
  }
  persistent connector 'InsuranceEligibilityServiceEvent Stream' is from outlet InsuranceEligibilityService.InsuranceEligibilityServiceEventsOut to inlet PatientContext.FromInsuranceEligibilityService.FromInsuranceEligibilityServiceIn with {
    briefly "What InsuranceEligibilityService tells PatientContext, unasked"
  }
  persistent connector 'MPIServiceEvent Stream' is from outlet MPIService.MPIServiceEventsOut to inlet PatientContext.FromMPIService.FromMPIServiceIn with {
    briefly "What MPIService tells PatientContext, unasked"
  }
  persistent connector 'MPIServiceRequest Stream' is from outlet PatientContext.ToMPIService.ToMPIServiceOut to inlet MPIService.MPIServiceRequests with {
    briefly "What PatientContext asks MPIService to send"
  }
  persistent connector 'InsuranceEligibilityServiceRequest Stream' is from outlet PatientContext.ToInsuranceEligibilityService.ToInsuranceEligibilityServiceOut to inlet InsuranceEligibilityService.InsuranceEligibilityServiceRequests with {
    briefly "What PatientContext asks InsuranceEligibilityService to send"
  }
  persistent connector 'IdentityVerificationServiceRequest Stream' is from outlet PatientContext.ToIdentityVerificationService.ToIdentityVerificationServiceOut to inlet IdentityVerificationService.IdentityVerificationServiceRequests with {
    briefly "What PatientContext asks IdentityVerificationService to send"
  }
  persistent connector 'DocumentStorageServiceRequest Stream' is from outlet PatientContext.ToDocumentStorageService.ToDocumentStorageServiceOut to inlet DocumentStorageService.DocumentStorageServiceRequests with {
    briefly "What PatientContext asks DocumentStorageService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet PatientContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What PatientContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Registrar is "person registering patients" with {
    briefly "Registrar"
    described as {
      |Person handling patient registration.
    }
  }
  user PatientUser is "patient accessing their information" with {
    briefly "Patient"
    described as {
      |Person receiving healthcare.
    }
  }
  user HealthInformationManager is "person managing patient data" with {
    briefly "HIM Staff"
    described as {
      |Health information management staff.
    }
  }
  epic RegistrationEpic is {
    user Registrar wants to "to register patients efficiently" so that "patients can receive care"
    case RegisterNewPatient is {
      user Registrar wants to "to register a new patient" so that "they can be seen by providers"
      step is "Patient provides" "demographic information" "to registrar" with {
        briefly "Collect info"
        described as {
          |Get demographics.
        }
      }
      step is "System validates" "patient identity" "and insurance" with {
        briefly "Validate"
        described as {
          |Verify information.
        }
      }
      step take input PatientRegistrationApp.PatientRegistrationScreen.RegisterPatientInput from user Registrar with {
        briefly "Register"
        described as {
          |Create patient record.
        }
      }
      step is "System assigns" "medical record number" "to patient" with {
        briefly "Assign MRN"
        described as {
          |Generate identifier.
        }
      }
    } with {
      briefly "Registration workflow"
      described as {
        |New patient registration process.
      }
    }
  } with {
    briefly "Patient registration"
    described as {
      | Epic covering patient registration from initial
      | intake through record creation and verification.
    }
  }
  include "PatientContext.riddl"
  include "external-contexts.riddl"
  application context PatientRegistrationApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PatientRegistration are delivered.
      }
    }
    group PatientRegistrationScreen is {
      input AddEmergencyContactInput acquires command PatientContext.Patient.AddEmergencyContact with {
        briefly "Add emergency contact control"
        described as {
          |The control through which a user submits the add emergency contact request.
        }
      }
      input AddInsuranceInput acquires command PatientContext.Patient.AddInsurance with {
        briefly "Add insurance control"
        described as {
          |The control through which a user submits the add insurance request.
        }
      }
      input DeactivatePatientInput acquires command PatientContext.Patient.DeactivatePatient with {
        briefly "Deactivate patient control"
        described as {
          |The control through which a user submits the deactivate patient request.
        }
      }
      input MergePatientsInput acquires command PatientContext.Patient.MergePatients with {
        briefly "Merge patients control"
        described as {
          |The control through which a user submits the merge patients request.
        }
      }
      input ReactivatePatientInput acquires command PatientContext.Patient.ReactivatePatient with {
        briefly "Reactivate patient control"
        described as {
          |The control through which a user submits the reactivate patient request.
        }
      }
      input RecordConsentInput acquires command PatientContext.Patient.RecordConsent with {
        briefly "Record consent control"
        described as {
          |The control through which a user submits the record consent request.
        }
      }
      input UpdateAddressInput acquires command PatientContext.Patient.UpdateAddress with {
        briefly "Update address control"
        described as {
          |The control through which a user submits the update address request.
        }
      }
      input UpdateContactInput acquires command PatientContext.Patient.UpdateContact with {
        briefly "Update contact control"
        described as {
          |The control through which a user submits the update contact request.
        }
      }
      input UpdateDemographicsInput acquires command PatientContext.Patient.UpdateDemographics with {
        briefly "Update demographics control"
        described as {
          |The control through which a user submits the update demographics request.
        }
      }
      input RegisterPatientInput acquires command PatientContext.RegisterPatient with {
        briefly "Register patient control"
        described as {
          |The control through which a user submits the register patient request.
        }
      }
    } with {
      briefly "Patient registration screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppPatientCommands is type PatientContext.PatientRequest
    inlet AppPatientRepositoryResponses is result PatientContext.Patient.PatientResult
    handler PatientRegistrationAppHandler is {
      on other is {
        error "Unexpected message for application context PatientRegistrationApp"
      }
    } with {
      briefly "PatientRegistrationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PatientRegistrationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'PatientCommand Stream' is from outlet PatientRegistrationApp.AppPatientCommands to inlet PatientContext.PatientCommandStreamIn with {
    briefly "Patient commands from the application"
  }
  persistent connector 'PatientResult Stream' is from outlet PatientContext.PatientResultStreamOut to inlet PatientRegistrationApp.AppPatientRepositoryResponses with {
    briefly "Patient query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PatientRegistrationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Patient registration domain"
  described as {
    | The PatientRegistration domain handles patient
    | demographics, identity, and registration management.
  }
}
