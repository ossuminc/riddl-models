// Patient Registration Domain Model
// Patient demographics and registration management
domain PatientRegistration is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Registrar is "person registering patients" with {
    briefly "Registrar"
    described as {
      |Person handling patient registration.
    }
  }
  user PatientUser is "patient accessing their information" with {
    briefly "Patient"
    described as {
      |Person receiving healthcare.
    }
  }
  user HealthInformationManager is "person managing patient data" with {
    briefly "HIM Staff"
    described as {
      |Health information management staff.
    }
  }
  epic RegistrationEpic is {
    user Registrar wants to "to register patients efficiently" so that "patients can receive care"
    case RegisterNewPatient is {
      user Registrar wants to "to register a new patient" so that "they can be seen by providers"
      step is "Patient provides" "demographic information" "to registrar" with {
        briefly "Collect info"
        described as {
          |Get demographics.
        }
      }
      step is "System validates" "patient identity" "and insurance" with {
        briefly "Validate"
        described as {
          |Verify information.
        }
      }
      step take input PatientRegistrationApp.PatientRegistrationScreen.RegisterPatientInput from user Registrar with {
        briefly "Register"
        described as {
          |Create patient record.
        }
      }
      step is "System assigns" "medical record number" "to patient" with {
        briefly "Assign MRN"
        described as {
          |Generate identifier.
        }
      }
    } with {
      briefly "Registration workflow"
      described as {
        |New patient registration process.
      }
    }
  } with {
    briefly "Patient registration"
    described as {
      | Epic covering patient registration from initial
      | intake through record creation and verification.
    }
  }
  include "PatientContext.riddl"
  include "external-contexts.riddl"
  application context PatientRegistrationApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PatientRegistration are delivered.
      }
    }
    group PatientRegistrationScreen is {
      input RegisterPatientInput acquires command PatientContext.Patient.RegisterPatient with {
        briefly "Register patient control"
        described as {
          |The control through which a user submits the register patient request.
        }
      }
    } with {
      briefly "Patient registration screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppPatientCommands is type PatientContext.Patient.PatientCommand
    inlet AppPatientRepositoryResponses is type PatientContext.Patient.PatientResult    handler PatientRegistrationAppHandler is {
      on other is {
        error "Unexpected message for application context PatientRegistrationApp"
      }
    } with {
      briefly "PatientRegistrationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PatientRegistrationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'PatientCommand Stream' is from outlet PatientRegistrationApp.AppPatientCommands to inlet PatientContext.PatientCommandStreamIn with {
    briefly "Patient commands from the application"
  }
  persistent connector 'PatientResult Stream' is from outlet PatientContext.PatientResultStreamOut to inlet PatientRegistrationApp.AppPatientRepositoryResponses with {
    briefly "Patient query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PatientRegistrationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Patient registration domain"
  described as {
    | The PatientRegistration domain handles patient
    | demographics, identity, and registration management.
  }
}
