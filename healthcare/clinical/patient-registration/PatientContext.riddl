// Patient Registration - Patient Context
context PatientContext is {
  include "types.riddl"
  include "Patient.riddl"
  // Repository for patient persistence
  repository PatientRepository is {
    inlet PatientRepositoryFromPatient is type PatientEvent
    inlet PatientRepositoryFromPatientAnalytics is type PatientEvent
    outlet PatientRepositoryResponses is type Patient.PatientResult
    schema PatientData is relational
      of patients as type Patient
        index on field Patient.patientId
        index on field Patient.mrn
        index on field Patient.demographics.lastName

    handler PatientPersistence is {
      on command Patient.RegisterPatient is {
        tell event Patient.PatientRegistered to entity PatientContext.Patient
      }
      on command Patient.UpdateDemographics is {
        tell event Patient.DemographicsUpdated to entity PatientContext.Patient
      }
      on command Patient.UpdateAddress is {
        tell event Patient.AddressUpdated to entity PatientContext.Patient
      }
      on command Patient.UpdateContact is {
        tell event Patient.ContactUpdated to entity PatientContext.Patient
      }
      on command Patient.AddEmergencyContact is {
        tell event Patient.EmergencyContactAdded to entity PatientContext.Patient
      }
      on command Patient.AddInsurance is {
        tell event Patient.InsuranceAdded to entity PatientContext.Patient
      }
      on command Patient.UpdateInsurance is {
        tell event Patient.InsuranceUpdated to entity PatientContext.Patient
      }
      on command Patient.RecordConsent is {
        tell event Patient.ConsentRecorded to entity PatientContext.Patient
      }
      on command Patient.DeactivatePatient is {
        tell event Patient.PatientDeactivated to entity PatientContext.Patient
      }
      on command Patient.ReactivatePatient is {
        tell event Patient.PatientReactivated to entity PatientContext.Patient
      }
      on command Patient.MergePatients is {
        tell event Patient.PatientsMerged to entity PatientContext.Patient
      }
    } with {
      briefly "Persists patient commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Patient data persistence"
    described as {
      | The PatientRepository provides persistent storage for
      | patient records and demographics.
    }
  }
  // Projector for patient analytics
  projector PatientAnalytics is {
    inlet PatientAnalyticsFromPatient is type PatientEvent
    outlet PatientAnalyticsOut is type PatientEvent
    updates repository PatientContext.PatientRepository
    record PatientStats is  {
      totalPatients: Natural with {
        briefly "Total"
        described as {
          |Total patients.
        }
      }
      activePatients: Natural with {
        briefly "Active"
        described as {
          |Active patients.
        }
      }
      newRegistrations: Natural with {
        briefly "New"
        described as {
          |New registrations today.
        }
      }
      insuranceCoverage: Decimal(5,4) with {
        briefly "Insured"
        described as {
          |Percent with insurance.
        }
      }
      avgAge: Decimal(5,2) with {
        briefly "Avg age"
        described as {
          |Average patient age.
        }
      }
    } with {
      briefly "Patient statistics"
      described as {
        |Patient registration metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Patient.PatientRegistered is {
        tell event Patient.PatientRegistered to repository PatientContext.PatientRepository
      }
      on event Patient.PatientDeactivated is {
        tell event Patient.PatientDeactivated to repository PatientContext.PatientRepository
      }
      on event Patient.InsuranceAdded is {
        tell event Patient.InsuranceAdded to repository PatientContext.PatientRepository
      }
    } with {
      briefly "Maintains patient analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Patient analytics projections"
    described as {
      |Maintains patient registration analytics data.
    }
  }
  type PatientEvent is one of {
    PatientContext.Patient.PatientRegistered,
    PatientContext.Patient.DemographicsUpdated,
    PatientContext.Patient.AddressUpdated,
    PatientContext.Patient.ContactUpdated,
    PatientContext.Patient.EmergencyContactAdded,
    PatientContext.Patient.InsuranceAdded,
    PatientContext.Patient.InsuranceUpdated,
    PatientContext.Patient.ConsentRecorded,
    PatientContext.Patient.PatientDeactivated,
    PatientContext.Patient.PatientReactivated,
    PatientContext.Patient.PatientsMerged
  } with {
    briefly "Patient events"
    described as {
      |Union of all patient entity events for streaming.
    }
  }
  processor PatientSource as source is {
    outlet PatientEvents is type PatientEvent with {
      briefly "Patient event outlet"
      described as {
        |Publishes patient events.
      }
    }
    handler PatientSourceHandler is {
      on init is {
        tell command Patient.InitializePatient to entity PatientContext.Patient
      }
      on event Patient.PatientRegistered is {
        send event Patient.PatientRegistered to outlet PatientEvents
      }
      on event Patient.PatientDeactivated is {
        send event Patient.PatientDeactivated to outlet PatientEvents
      }
      on event Patient.PatientReactivated is {
        send event Patient.PatientReactivated to outlet PatientEvents
      }
      on other is {
        error "Unexpected message for source PatientSource"
      }
    } with {
      briefly "Patient source handler"
      described as {
        |Forwards patient events to the outlet.
      }
    }
  } with {
    briefly "Patient event source"
    described as {
      |Source streamlet that publishes patient events.
    }
  }
  processor PatientSink as sink is {
    inlet PatientEventsIn is type PatientEvent with {
      briefly "Patient event inlet"
      described as {
        |Receives patient events.
      }
    }
    handler PatientSinkHandler is {
      on init is { ??? }
      on event Patient.PatientRegistered is {
        tell event Patient.PatientRegistered to repository PatientContext.PatientRepository
      }
      on event Patient.PatientDeactivated is {
        tell event Patient.PatientDeactivated to repository PatientContext.PatientRepository
      }
      on other is {
        error "Unexpected message for sink PatientSink"
      }
    } with {
      briefly "Patient sink handler"
      described as {
        |Persists patient events from the inlet.
      }
    }
  } with {
    briefly "Patient event sink"
    described as {
      |Sink streamlet that consumes patient events.
    }
  }
  connector PatientFlow is {
    from outlet PatientContext.PatientSource.PatientEvents to
      inlet PatientContext.PatientSink.PatientEventsIn
  } with {
    briefly "Patient event flow"
    described as {
      |Connects patient source to sink for event streaming.
    }
  }
  processor PatientEventSplit is {
    inlet PatientEventSplitIn is type PatientEvent
    outlet PatientEventSplitToPatientRepository is type PatientEvent
    outlet PatientEventSplitToPatientAnalytics is type PatientEvent
    handler PatientEventSplitHandler is {
      on event Patient.PatientRegistered is {
        send event Patient.PatientRegistered to outlet PatientEventSplitToPatientRepository
        send event Patient.PatientRegistered to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.PatientRegistered to entity PatientContext.Patient
      }
      on event Patient.DemographicsUpdated is {
        send event Patient.DemographicsUpdated to outlet PatientEventSplitToPatientRepository
        send event Patient.DemographicsUpdated to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.DemographicsUpdated to entity PatientContext.Patient
      }
      on event Patient.AddressUpdated is {
        send event Patient.AddressUpdated to outlet PatientEventSplitToPatientRepository
        send event Patient.AddressUpdated to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.AddressUpdated to entity PatientContext.Patient
      }
      on event Patient.ContactUpdated is {
        send event Patient.ContactUpdated to outlet PatientEventSplitToPatientRepository
        send event Patient.ContactUpdated to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.ContactUpdated to entity PatientContext.Patient
      }
      on event Patient.EmergencyContactAdded is {
        send event Patient.EmergencyContactAdded to outlet PatientEventSplitToPatientRepository
        send event Patient.EmergencyContactAdded to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.EmergencyContactAdded to entity PatientContext.Patient
      }
      on event Patient.InsuranceAdded is {
        send event Patient.InsuranceAdded to outlet PatientEventSplitToPatientRepository
        send event Patient.InsuranceAdded to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.InsuranceAdded to entity PatientContext.Patient
      }
      on event Patient.InsuranceUpdated is {
        send event Patient.InsuranceUpdated to outlet PatientEventSplitToPatientRepository
        send event Patient.InsuranceUpdated to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.InsuranceUpdated to entity PatientContext.Patient
      }
      on event Patient.ConsentRecorded is {
        send event Patient.ConsentRecorded to outlet PatientEventSplitToPatientRepository
        send event Patient.ConsentRecorded to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.ConsentRecorded to entity PatientContext.Patient
      }
      on event Patient.PatientDeactivated is {
        send event Patient.PatientDeactivated to outlet PatientEventSplitToPatientRepository
        send event Patient.PatientDeactivated to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.PatientDeactivated to entity PatientContext.Patient
      }
      on event Patient.PatientReactivated is {
        send event Patient.PatientReactivated to outlet PatientEventSplitToPatientRepository
        send event Patient.PatientReactivated to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.PatientReactivated to entity PatientContext.Patient
      }
      on event Patient.PatientsMerged is {
        send event Patient.PatientsMerged to outlet PatientEventSplitToPatientRepository
        send event Patient.PatientsMerged to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.PatientsMerged to entity PatientContext.Patient
      }
      on other is {
        error "Unexpected message for processor PatientEventSplit"
      }
    } with {
      briefly "Patient event fan-out handler"
      described as {
        |Delivers each Patient event to all of its consumers.
      }
    }
  } with {
    briefly "Patient event fan-out"
    described as {
      |Fans Patient events out to the repository and projectors.
    }
  }
  connector LinkPatientToPatientEventSplit is {
    from outlet PatientContext.Patient.PatientEvents2 to
      inlet PatientContext.PatientEventSplit.PatientEventSplitIn
  } with {
    briefly "LinkPatientToPatientEventSplit"
  }
  connector LinkPatientEventSplitToPatientRepository is {
    from outlet PatientContext.PatientEventSplit.PatientEventSplitToPatientRepository to
      inlet PatientContext.PatientRepository.PatientRepositoryFromPatient
  } with {
    briefly "LinkPatientEventSplitToPatientRepository"
  }
  connector LinkPatientEventSplitToPatientAnalytics is {
    from outlet PatientContext.PatientEventSplit.PatientEventSplitToPatientAnalytics to
      inlet PatientContext.PatientAnalytics.PatientAnalyticsFromPatient
  } with {
    briefly "LinkPatientEventSplitToPatientAnalytics"
  }
  connector LinkPatientAnalyticsToPatientRepository is {
    from outlet PatientContext.PatientAnalytics.PatientAnalyticsOut to
      inlet PatientContext.PatientRepository.PatientRepositoryFromPatientAnalytics
  } with {
    briefly "LinkPatientAnalyticsToPatientRepository"
  }
} with {
  briefly "Bounded context for patient registration"
  described as {
    | The PatientContext is the bounded context for
    | patient demographics and registration management.
  }
}
