// Patient Registration - Patient Context
context PatientContext is {
  adaptor FromDocumentStorageService from context DocumentStorageService is { 
    handler FromDocumentStorageServiceHandler is {
      on event DocumentStorageService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentStorageService"
      }
    } with {
      briefly "from document storage service"
      described as {
        |Carries messages from the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor ToDocumentStorageService to context DocumentStorageService is { 
    handler ToDocumentStorageServiceHandler is {
      on command DocumentStorageService.StorePatientDocument is {
        do "the model sends store patient document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentStorageService"
      }
    } with {
      briefly "to document storage service"
      described as {
        |Carries messages to the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor FromIdentityVerificationService from context IdentityVerificationService is { 
    handler FromIdentityVerificationServiceHandler is {
      on event IdentityVerificationService.IdentityVerified is {
        do "the model receives identity verified"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityVerificationService"
      }
    } with {
      briefly "from identity verification service"
      described as {
        |Carries messages from the external IdentityVerificationService.
      }
    }
  } with {
    briefly "IdentityVerificationService integration"
    described as {
      |The model's side of the IdentityVerificationService conversation.
    }
  }
  adaptor ToIdentityVerificationService to context IdentityVerificationService is { 
    handler ToIdentityVerificationServiceHandler is {
      on command IdentityVerificationService.VerifyPatientIdentity is {
        do "the model sends verify patient identity"
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityVerificationService"
      }
    } with {
      briefly "to identity verification service"
      described as {
        |Carries messages to the external IdentityVerificationService.
      }
    }
  } with {
    briefly "IdentityVerificationService integration"
    described as {
      |The model's side of the IdentityVerificationService conversation.
    }
  }
  adaptor FromInsuranceEligibilityService from context InsuranceEligibilityService is { 
    handler FromInsuranceEligibilityServiceHandler is {
      on event InsuranceEligibilityService.EligibilityChecked is {
        do "the model receives eligibility checked"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceEligibilityService"
      }
    } with {
      briefly "from insurance eligibility service"
      described as {
        |Carries messages from the external InsuranceEligibilityService.
      }
    }
  } with {
    briefly "InsuranceEligibilityService integration"
    described as {
      |The model's side of the InsuranceEligibilityService conversation.
    }
  }
  adaptor ToInsuranceEligibilityService to context InsuranceEligibilityService is { 
    handler ToInsuranceEligibilityServiceHandler is {
      on command InsuranceEligibilityService.CheckEligibility is {
        do "the model sends check eligibility"
      }
      on other is {
        error "Unexpected message for adaptor ToInsuranceEligibilityService"
      }
    } with {
      briefly "to insurance eligibility service"
      described as {
        |Carries messages to the external InsuranceEligibilityService.
      }
    }
  } with {
    briefly "InsuranceEligibilityService integration"
    described as {
      |The model's side of the InsuranceEligibilityService conversation.
    }
  }
  adaptor FromMPIService from context MPIService is { 
    handler FromMPIServiceHandler is {
      on event MPIService.LinkedToMPI is {
        do "the model receives linked to mpi"
      }
      on event MPIService.MPISearchResults is {
        do "the model receives mpi search results"
      }
      on other is {
        error "Unexpected message for adaptor FromMPIService"
      }
    } with {
      briefly "from mpi service"
      described as {
        |Carries messages from the external MPIService.
      }
    }
  } with {
    briefly "MPIService integration"
    described as {
      |The model's side of the MPIService conversation.
    }
  }
  adaptor ToMPIService to context MPIService is { 
    handler ToMPIServiceHandler is {
      on command MPIService.LinkToMPI is {
        do "the model sends link to mpi"
      }
      on command MPIService.SearchMPI is {
        do "the model sends search mpi"
      }
      on other is {
        error "Unexpected message for adaptor ToMPIService"
      }
    } with {
      briefly "to mpi service"
      described as {
        |Carries messages to the external MPIService.
      }
    }
  } with {
    briefly "MPIService integration"
    described as {
      |The model's side of the MPIService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendPatientNotification is {
        do "the model sends send patient notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "Patient.riddl"
  // Repository for patient persistence
  repository PatientRepository as merge is {
    inlet PatientRepositoryFromPatient is type PatientEvent    inlet PatientRepositoryFromPatientAnalytics is type PatientEvent    outlet PatientRepositoryResponses is type Patient.PatientResult
    record StoredPatient is  {
      patientId: PatientId with {
        briefly "patientId"
        described as {
          |The patientId column of the stored patient row.
        }
      }
      demographics: Demographics with {
        briefly "demographics"
        described as {
          |The demographics column of the stored patient row.
        }
      }
      mrn: MRN with {
        briefly "mrn"
        described as {
          |The mrn column of the stored patient row.
        }
      }
    } with {
      briefly "Stored patient row"
      described as {
        |The persistence shape of patient data as this repository stores it.
      }
    }
    schema PatientData is relational
      of patients as type StoredPatient
        index on field StoredPatient.patientId
        index on field StoredPatient.mrn
        index on field StoredPatient.demographics.lastName
 with {
      briefly "Patient data schema"
      described as {
        |The relational schema holding patient data for the PatientRepository.
      }
    }
    handler PatientPersistence is {
      on query GetPatientStats is {
        do "read the patient stats projection"
        reply result PatientStatsView
      }
      on command Patient.RegisterPatient is {
        tell event Patient.PatientRegistered to entity PatientContext.Patient
      }
      on command Patient.UpdateDemographics is {
        tell event Patient.DemographicsUpdated to entity PatientContext.Patient
      }
      on command Patient.UpdateAddress is {
        tell event Patient.AddressUpdated to entity PatientContext.Patient
      }
      on command Patient.UpdateContact is {
        tell event Patient.ContactUpdated to entity PatientContext.Patient
      }
      on command Patient.AddEmergencyContact is {
        tell event Patient.EmergencyContactAdded to entity PatientContext.Patient
      }
      on command Patient.AddInsurance is {
        tell event Patient.InsuranceAdded to entity PatientContext.Patient
      }
      on command Patient.UpdateInsurance is {
        tell event Patient.InsuranceUpdated to entity PatientContext.Patient
      }
      on command Patient.RecordConsent is {
        tell event Patient.ConsentRecorded to entity PatientContext.Patient
      }
      on command Patient.DeactivatePatient is {
        tell event Patient.PatientDeactivated to entity PatientContext.Patient
      }
      on command Patient.ReactivatePatient is {
        tell event Patient.PatientReactivated to entity PatientContext.Patient
      }
      on command Patient.MergePatients is {
        tell event Patient.PatientsMerged to entity PatientContext.Patient by survivingPatientId
      }
    } with {
      briefly "Persists patient commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Patient data persistence"
    described as {
      | The PatientRepository provides persistent storage for
      | patient records and demographics.
    }
  }
  // Projector for patient analytics
  query GetPatientStats is  {
    patientStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which patient stats to retrieve.
      }
    }
  } with {
    briefly "Get patient stats"
    described as {
      |Retrieves the patient stats projection.
    }
  }
  result PatientStatsView is  {
    patientStats: PatientAnalytics.PatientStats with {
      briefly "Patient stats"
      described as {
        |The patient stats being returned.
      }
    }
  } with {
    briefly "Patient stats view"
    described as {
      |Read model view carrying the patient stats projection.
    }
  }
  projector PatientAnalytics as flow is {
    updates repository PatientContext.PatientRepository
    inlet PatientAnalyticsFromPatient is type PatientEvent    outlet PatientAnalyticsOut is type PatientEvent
    record PatientStats is  {
      totalPatients: Natural with {
        briefly "Total"
        described as {
          |Total patients.
        }
      }
      activePatients: Natural with {
        briefly "Active"
        described as {
          |Active patients.
        }
      }
      newRegistrations: Natural with {
        briefly "New"
        described as {
          |New registrations today.
        }
      }
      insuranceCoverage: Decimal(5,4) with {
        briefly "Insured"
        described as {
          |Percent with insurance.
        }
      }
      avgAge: Decimal(5,2) with {
        briefly "Avg age"
        described as {
          |Average patient age.
        }
      }
    } with {
      briefly "Patient statistics"
      described as {
        |Patient registration metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Patient.PatientRegistered is {
        tell event Patient.PatientRegistered to repository PatientContext.PatientRepository
      }
      on event Patient.PatientDeactivated is {
        tell event Patient.PatientDeactivated to repository PatientContext.PatientRepository
      }
      on event Patient.InsuranceAdded is {
        tell event Patient.InsuranceAdded to repository PatientContext.PatientRepository
      }
    } with {
      briefly "Maintains patient analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Patient analytics projections"
    described as {
      |Maintains patient registration analytics data.
    }
  }
  type PatientEvent is one of {
    PatientContext.Patient.PatientRegistered or PatientContext.Patient.DemographicsUpdated or PatientContext.Patient.AddressUpdated or PatientContext.Patient.ContactUpdated or PatientContext.Patient.EmergencyContactAdded or PatientContext.Patient.InsuranceAdded or PatientContext.Patient.InsuranceUpdated or PatientContext.Patient.ConsentRecorded or PatientContext.Patient.PatientDeactivated or PatientContext.Patient.PatientReactivated or PatientContext.Patient.PatientsMerged
  } with {
    briefly "Patient events"
    described as {
      |Union of all patient entity events for streaming.
    }
  }
  processor PatientSource as source is {
    outlet PatientEvents is type PatientEvent
 with {
      briefly "Patient event outlet"
      described as {
        |Publishes patient events.
      }
    }
    handler PatientSourceHandler is {
      on init is {
        tell command Patient.InitializePatient to entity PatientContext.Patient
      }
      on event Patient.PatientRegistered is {
        send event Patient.PatientRegistered to outlet PatientEvents
      }
      on event Patient.PatientDeactivated is {
        send event Patient.PatientDeactivated to outlet PatientEvents
      }
      on event Patient.PatientReactivated is {
        send event Patient.PatientReactivated to outlet PatientEvents
      }
      on other is {
        error "Unexpected message for source PatientSource"
      }
    } with {
      briefly "Patient source handler"
      described as {
        |Forwards patient events to the outlet.
      }
    }
  } with {
    briefly "Patient event source"
    described as {
      |Source streamlet that publishes patient events.
    }
  }
  processor PatientSink as sink is {
    inlet PatientEventsIn is type PatientEvent with {
      briefly "Patient event inlet"
      described as {
        |Receives patient events.
      }
    }
    handler PatientSinkHandler is {
      on init is { ??? }
      on event Patient.PatientRegistered is {
        tell event Patient.PatientRegistered to repository PatientContext.PatientRepository
      }
      on event Patient.PatientDeactivated is {
        tell event Patient.PatientDeactivated to repository PatientContext.PatientRepository
      }
      on other is {
        error "Unexpected message for sink PatientSink"
      }
    } with {
      briefly "Patient sink handler"
      described as {
        |Persists patient events from the inlet.
      }
    }
  } with {
    briefly "Patient event sink"
    described as {
      |Sink streamlet that consumes patient events.
    }
  }
  connector PatientFlow is from outlet PatientContext.PatientSource.PatientEvents to inlet PatientContext.PatientSink.PatientEventsIn with {
    briefly "Patient event flow"
    described as {
      |Connects patient source to sink for event streaming.
    }
  }
  processor PatientEventSplit as split is {
    inlet PatientEventSplitIn is type PatientEvent    outlet PatientEventSplitToPatientRepository is type PatientEvent
    outlet PatientEventSplitToPatientAnalytics is type PatientEvent
    handler PatientEventSplitHandler is {
      on event Patient.PatientRegistered is {
        send event Patient.PatientRegistered to outlet PatientEventSplitToPatientRepository
        send event Patient.PatientRegistered to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.PatientRegistered to entity PatientContext.Patient
      }
      on event Patient.DemographicsUpdated is {
        send event Patient.DemographicsUpdated to outlet PatientEventSplitToPatientRepository
        send event Patient.DemographicsUpdated to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.DemographicsUpdated to entity PatientContext.Patient
      }
      on event Patient.AddressUpdated is {
        send event Patient.AddressUpdated to outlet PatientEventSplitToPatientRepository
        send event Patient.AddressUpdated to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.AddressUpdated to entity PatientContext.Patient
      }
      on event Patient.ContactUpdated is {
        send event Patient.ContactUpdated to outlet PatientEventSplitToPatientRepository
        send event Patient.ContactUpdated to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.ContactUpdated to entity PatientContext.Patient
      }
      on event Patient.EmergencyContactAdded is {
        send event Patient.EmergencyContactAdded to outlet PatientEventSplitToPatientRepository
        send event Patient.EmergencyContactAdded to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.EmergencyContactAdded to entity PatientContext.Patient
      }
      on event Patient.InsuranceAdded is {
        send event Patient.InsuranceAdded to outlet PatientEventSplitToPatientRepository
        send event Patient.InsuranceAdded to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.InsuranceAdded to entity PatientContext.Patient
      }
      on event Patient.InsuranceUpdated is {
        send event Patient.InsuranceUpdated to outlet PatientEventSplitToPatientRepository
        send event Patient.InsuranceUpdated to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.InsuranceUpdated to entity PatientContext.Patient
      }
      on event Patient.ConsentRecorded is {
        send event Patient.ConsentRecorded to outlet PatientEventSplitToPatientRepository
        send event Patient.ConsentRecorded to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.ConsentRecorded to entity PatientContext.Patient
      }
      on event Patient.PatientDeactivated is {
        send event Patient.PatientDeactivated to outlet PatientEventSplitToPatientRepository
        send event Patient.PatientDeactivated to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.PatientDeactivated to entity PatientContext.Patient
      }
      on event Patient.PatientReactivated is {
        send event Patient.PatientReactivated to outlet PatientEventSplitToPatientRepository
        send event Patient.PatientReactivated to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.PatientReactivated to entity PatientContext.Patient
      }
      on event Patient.PatientsMerged is {
        send event Patient.PatientsMerged to outlet PatientEventSplitToPatientRepository
        send event Patient.PatientsMerged to outlet PatientEventSplitToPatientAnalytics
        tell event Patient.PatientsMerged to entity PatientContext.Patient by survivingPatientId
      }
      on other is {
        error "Unexpected message for processor PatientEventSplit"
      }
    } with {
      briefly "Patient event fan-out handler"
      described as {
        |Delivers each Patient event to all of its consumers.
      }
    }
  } with {
    briefly "Patient event fan-out"
    described as {
      |Fans Patient events out to the repository and projectors.
    }
  }
  connector 'PatientEvent Stream' is from outlet PatientContext.Patient.PatientEvents2 to inlet PatientContext.PatientEventSplit.PatientEventSplitIn with {
    briefly "Patient events, fanned out to storage and read models"
  }
  connector 'PatientEvent Storage' is from outlet PatientContext.PatientEventSplit.PatientEventSplitToPatientRepository to inlet PatientContext.PatientRepository.PatientRepositoryFromPatient with {
    briefly "Patient events on their way to storage"
  }
  connector 'PatientAnalytics Feed' is from outlet PatientContext.PatientEventSplit.PatientEventSplitToPatientAnalytics to inlet PatientContext.PatientAnalytics.PatientAnalyticsFromPatient with {
    briefly "Patient events feeding the PatientAnalytics projection"
  }
  connector 'PatientAnalytics Storage' is from outlet PatientContext.PatientAnalytics.PatientAnalyticsOut to inlet PatientContext.PatientRepository.PatientRepositoryFromPatientAnalytics with {
    briefly "The PatientAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for patient registration"
  described as {
    | The PatientContext is the bounded context for
    | patient demographics and registration management.
  }
}
