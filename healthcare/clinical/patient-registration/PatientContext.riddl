// Patient Registration - Patient Context
context PatientContext as router is {
  inlet PatientCommandStreamIn is type PatientCommand  outlet PatientCommandStreamOut is type PatientCommand
  inlet PatientResultStreamIn is result Patient.PatientResult  outlet PatientResultStreamOut is result Patient.PatientResult
  handler PatientContextBoundary is {
    on registerPatient: command Patient.RegisterPatient is {
      send registerPatient to outlet PatientContext.PatientCommandStreamOut
    }
    on updateDemographics: command Patient.UpdateDemographics is {
      send updateDemographics to outlet PatientContext.PatientCommandStreamOut
    }
    on updateAddress: command Patient.UpdateAddress is {
      send updateAddress to outlet PatientContext.PatientCommandStreamOut
    }
    on updateContact: command Patient.UpdateContact is {
      send updateContact to outlet PatientContext.PatientCommandStreamOut
    }
    on addEmergencyContact: command Patient.AddEmergencyContact is {
      send addEmergencyContact to outlet PatientContext.PatientCommandStreamOut
    }
    on addInsurance: command Patient.AddInsurance is {
      send addInsurance to outlet PatientContext.PatientCommandStreamOut
    }
    on updateInsurance: command Patient.UpdateInsurance is {
      send updateInsurance to outlet PatientContext.PatientCommandStreamOut
    }
    on recordConsent: command Patient.RecordConsent is {
      send recordConsent to outlet PatientContext.PatientCommandStreamOut
    }
    on deactivatePatient: command Patient.DeactivatePatient is {
      send deactivatePatient to outlet PatientContext.PatientCommandStreamOut
    }
    on reactivatePatient: command Patient.ReactivatePatient is {
      send reactivatePatient to outlet PatientContext.PatientCommandStreamOut
    }
    on mergePatients: command Patient.MergePatients is {
      send mergePatients to outlet PatientContext.PatientCommandStreamOut
    }
    on patientResult: result Patient.PatientResult is {
      send patientResult to outlet PatientContext.PatientResultStreamOut
    }
    on other is {
      error "Unexpected message at the PatientContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PatientCommand Stream Intake' is from outlet PatientContext.PatientCommandStreamOut to inlet PatientContext.Patient.PatientCommands  connector 'PatientResult Stream Egress' is from outlet PatientContext.PatientRepository.PatientRepositoryResponses to inlet PatientContext.PatientResultStreamIn  adaptor FromDocumentStorageService from context DocumentStorageService is { 
    handler FromDocumentStorageServiceHandler is {
      on event DocumentStorageService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentStorageService"
      }
    } with {
      briefly "from document storage service"
      described as {
        |Carries messages from the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor ToDocumentStorageService to context DocumentStorageService is { 
    handler ToDocumentStorageServiceHandler is {
      on command DocumentStorageService.StorePatientDocument is {
        do "the model sends store patient document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentStorageService"
      }
    } with {
      briefly "to document storage service"
      described as {
        |Carries messages to the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor FromIdentityVerificationService from context IdentityVerificationService is { 
    handler FromIdentityVerificationServiceHandler is {
      on event IdentityVerificationService.IdentityVerified is {
        do "the model receives identity verified"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityVerificationService"
      }
    } with {
      briefly "from identity verification service"
      described as {
        |Carries messages from the external IdentityVerificationService.
      }
    }
  } with {
    briefly "IdentityVerificationService integration"
    described as {
      |The model's side of the IdentityVerificationService conversation.
    }
  }
  adaptor ToIdentityVerificationService to context IdentityVerificationService is { 
    handler ToIdentityVerificationServiceHandler is {
      on command IdentityVerificationService.VerifyPatientIdentity is {
        do "the model sends verify patient identity"
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityVerificationService"
      }
    } with {
      briefly "to identity verification service"
      described as {
        |Carries messages to the external IdentityVerificationService.
      }
    }
  } with {
    briefly "IdentityVerificationService integration"
    described as {
      |The model's side of the IdentityVerificationService conversation.
    }
  }
  adaptor FromInsuranceEligibilityService from context InsuranceEligibilityService is { 
    handler FromInsuranceEligibilityServiceHandler is {
      on event InsuranceEligibilityService.EligibilityChecked is {
        do "the model receives eligibility checked"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceEligibilityService"
      }
    } with {
      briefly "from insurance eligibility service"
      described as {
        |Carries messages from the external InsuranceEligibilityService.
      }
    }
  } with {
    briefly "InsuranceEligibilityService integration"
    described as {
      |The model's side of the InsuranceEligibilityService conversation.
    }
  }
  adaptor ToInsuranceEligibilityService to context InsuranceEligibilityService is { 
    handler ToInsuranceEligibilityServiceHandler is {
      on command InsuranceEligibilityService.CheckEligibility is {
        do "the model sends check eligibility"
      }
      on other is {
        error "Unexpected message for adaptor ToInsuranceEligibilityService"
      }
    } with {
      briefly "to insurance eligibility service"
      described as {
        |Carries messages to the external InsuranceEligibilityService.
      }
    }
  } with {
    briefly "InsuranceEligibilityService integration"
    described as {
      |The model's side of the InsuranceEligibilityService conversation.
    }
  }
  adaptor FromMPIService from context MPIService is { 
    handler FromMPIServiceHandler is {
      on event MPIService.LinkedToMPI is {
        do "the model receives linked to mpi"
      }
      on event MPIService.MPISearchResults is {
        do "the model receives mpi search results"
      }
      on other is {
        error "Unexpected message for adaptor FromMPIService"
      }
    } with {
      briefly "from mpi service"
      described as {
        |Carries messages from the external MPIService.
      }
    }
  } with {
    briefly "MPIService integration"
    described as {
      |The model's side of the MPIService conversation.
    }
  }
  adaptor ToMPIService to context MPIService is { 
    handler ToMPIServiceHandler is {
      on command MPIService.LinkToMPI is {
        do "the model sends link to mpi"
      }
      on command MPIService.SearchMPI is {
        do "the model sends search mpi"
      }
      on other is {
        error "Unexpected message for adaptor ToMPIService"
      }
    } with {
      briefly "to mpi service"
      described as {
        |Carries messages to the external MPIService.
      }
    }
  } with {
    briefly "MPIService integration"
    described as {
      |The model's side of the MPIService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendPatientNotification is {
        do "the model sends send patient notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "Patient.riddl"
  // Repository for patient persistence
  type PatientRepositoryCommand is one of {
    PatientContext.PatientRepository.PersistAddressUpdated or PatientContext.PatientRepository.PersistConsentRecorded or PatientContext.PatientRepository.PersistContactUpdated or PatientContext.PatientRepository.PersistDemographicsUpdated or PatientContext.PatientRepository.PersistEmergencyContactAdded or PatientContext.PatientRepository.PersistInsuranceAdded or PatientContext.PatientRepository.PersistInsuranceUpdated or PatientContext.PatientRepository.PersistPatientDeactivated or PatientContext.PatientRepository.PersistPatientReactivated or PatientContext.PatientRepository.PersistPatientRegistered or PatientContext.PatientRepository.PersistPatientsMerged
  } with {
    briefly "Anything that writes PatientRepository"
    described as {
      |The persistence commands PatientRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository PatientRepository as flow is {
    inlet PatientRepositoryFromPatientAnalytics is type PatientRepositoryCommand    command PersistAddressUpdated is  {
      patientId: PatientId with {
        briefly "Row addressed"
        described as {
          |Which stored row AddressUpdated applies to.
        }
      }
    } with {
      briefly "Persist AddressUpdated"
      described as {
        |Instructs this repository to apply AddressUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistConsentRecorded is  {
      patientId: PatientId with {
        briefly "Row addressed"
        described as {
          |Which stored row ConsentRecorded applies to.
        }
      }
    } with {
      briefly "Persist ConsentRecorded"
      described as {
        |Instructs this repository to apply ConsentRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContactUpdated is  {
      patientId: PatientId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContactUpdated applies to.
        }
      }
    } with {
      briefly "Persist ContactUpdated"
      described as {
        |Instructs this repository to apply ContactUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDemographicsUpdated is  {
      patientId: PatientId with {
        briefly "Row addressed"
        described as {
          |Which stored row DemographicsUpdated applies to.
        }
      }
    } with {
      briefly "Persist DemographicsUpdated"
      described as {
        |Instructs this repository to apply DemographicsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEmergencyContactAdded is  {
      patientId: PatientId with {
        briefly "Row addressed"
        described as {
          |Which stored row EmergencyContactAdded applies to.
        }
      }
    } with {
      briefly "Persist EmergencyContactAdded"
      described as {
        |Instructs this repository to apply EmergencyContactAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInsuranceUpdated is  {
      patientId: PatientId with {
        briefly "Row addressed"
        described as {
          |Which stored row InsuranceUpdated applies to.
        }
      }
    } with {
      briefly "Persist InsuranceUpdated"
      described as {
        |Instructs this repository to apply InsuranceUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPatientReactivated is  {
      patientId: PatientId with {
        briefly "Row addressed"
        described as {
          |Which stored row PatientReactivated applies to.
        }
      }
    } with {
      briefly "Persist PatientReactivated"
      described as {
        |Instructs this repository to apply PatientReactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPatientsMerged is  {
      survivingPatientId: PatientId with {
        briefly "Row addressed"
        described as {
          |Which stored row PatientsMerged applies to.
        }
      }
    } with {
      briefly "Persist PatientsMerged"
      described as {
        |Instructs this repository to apply PatientsMerged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInsuranceAdded is  {
      patientId: PatientId with {
        briefly "Row addressed"
        described as {
          |Which stored row InsuranceAdded applies to.
        }
      }
    } with {
      briefly "Persist InsuranceAdded"
      described as {
        |Instructs this repository to apply InsuranceAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPatientDeactivated is  {
      patientId: PatientId with {
        briefly "Row addressed"
        described as {
          |Which stored row PatientDeactivated applies to.
        }
      }
    } with {
      briefly "Persist PatientDeactivated"
      described as {
        |Instructs this repository to apply PatientDeactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPatientRegistered is  {
      patientId: PatientId with {
        briefly "Row addressed"
        described as {
          |Which stored row PatientRegistered applies to.
        }
      }
    } with {
      briefly "Persist PatientRegistered"
      described as {
        |Instructs this repository to apply PatientRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet PatientRepositoryResponses is result Patient.PatientResult
    record StoredPatient is  {
      patientId: PatientId with {
        briefly "patientId"
        described as {
          |The patientId column of the stored patient row.
        }
      }
      demographics: Demographics with {
        briefly "demographics"
        described as {
          |The demographics column of the stored patient row.
        }
      }
      mrn: MRN with {
        briefly "mrn"
        described as {
          |The mrn column of the stored patient row.
        }
      }
    } with {
      briefly "Stored patient row"
      described as {
        |The persistence shape of patient data as this repository stores it.
      }
    }
    schema PatientData is relational
      of patients as record StoredPatient
        index on field StoredPatient.patientId
        index on field StoredPatient.mrn
        index on field StoredPatient.demographics.lastName
 with {
      briefly "Patient data schema"
      described as {
        |The relational schema holding patient data for the PatientRepository.
      }
    }
    handler PatientPersistence is {
      on persistAddressUpdated: command PersistAddressUpdated is {
        do "apply AddressUpdated to the stored row"
      }
      on persistConsentRecorded: command PersistConsentRecorded is {
        do "apply ConsentRecorded to the stored row"
      }
      on persistContactUpdated: command PersistContactUpdated is {
        do "apply ContactUpdated to the stored row"
      }
      on persistDemographicsUpdated: command PersistDemographicsUpdated is {
        do "apply DemographicsUpdated to the stored row"
      }
      on persistEmergencyContactAdded: command PersistEmergencyContactAdded is {
        do "apply EmergencyContactAdded to the stored row"
      }
      on persistInsuranceUpdated: command PersistInsuranceUpdated is {
        do "apply InsuranceUpdated to the stored row"
      }
      on persistPatientReactivated: command PersistPatientReactivated is {
        do "apply PatientReactivated to the stored row"
      }
      on persistPatientsMerged: command PersistPatientsMerged is {
        do "apply PatientsMerged to the stored row"
      }
      on persistInsuranceAdded: command PersistInsuranceAdded is {
        do "apply InsuranceAdded to the stored row"
      }
      on persistPatientDeactivated: command PersistPatientDeactivated is {
        do "apply PatientDeactivated to the stored row"
      }
      on persistPatientRegistered: command PersistPatientRegistered is {
        do "apply PatientRegistered to the stored row"
      }
      on query GetPatientStats is {
        let patientStatsView: type PatientStatsView = prompt("read the patient stats projection")
        reply patientStatsView
      }
    } with {
      briefly "Persists patient commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Patient data persistence"
    described as {
      | The PatientRepository provides persistent storage for
      | patient records and demographics.
    }
  }
  // Projector for patient analytics
  query GetPatientStats replies result PatientStatsView is  {
    patientStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which patient stats to retrieve.
      }
    }
  } with {
    briefly "Get patient stats"
    described as {
      |Retrieves the patient stats projection.
    }
  }
  result PatientStatsView is  {
    patientStats: PatientAnalytics.PatientStats with {
      briefly "Patient stats"
      described as {
        |The patient stats being returned.
      }
    }
  } with {
    briefly "Patient stats view"
    described as {
      |Read model view carrying the patient stats projection.
    }
  }
  projector PatientAnalytics as flow is {
    updates repository PatientContext.PatientRepository
    outlet PatientAnalyticsToRepository is type PatientRepositoryCommand
    inlet PatientAnalyticsFromPatient is type PatientEvent    record PatientStats is  {
      totalPatients: Natural with {
        briefly "Total"
        described as {
          |Total patients.
        }
      }
      activePatients: Natural with {
        briefly "Active"
        described as {
          |Active patients.
        }
      }
      newRegistrations: Natural with {
        briefly "New"
        described as {
          |New registrations today.
        }
      }
      insuranceCoverage: Decimal(5,4) with {
        briefly "Insured"
        described as {
          |Percent with insurance.
        }
      }
      avgAge: Decimal(5,2) with {
        briefly "Avg age"
        described as {
          |Average patient age.
        }
      }
    } with {
      briefly "Patient statistics"
      described as {
        |Patient registration metrics.
      }
    }
    handler AnalyticsHandler is {
      on addressUpdated: event Patient.AddressUpdated is {
        tell command PatientContext.PatientRepository.PersistAddressUpdated(patientId = addressUpdated.patientId) to repository PatientContext.PatientRepository
        do "apply AddressUpdated to the PatientAnalytics projection"
      }
      on consentRecorded: event Patient.ConsentRecorded is {
        tell command PatientContext.PatientRepository.PersistConsentRecorded(patientId = consentRecorded.patientId) to repository PatientContext.PatientRepository
        do "apply ConsentRecorded to the PatientAnalytics projection"
      }
      on contactUpdated: event Patient.ContactUpdated is {
        tell command PatientContext.PatientRepository.PersistContactUpdated(patientId = contactUpdated.patientId) to repository PatientContext.PatientRepository
        do "apply ContactUpdated to the PatientAnalytics projection"
      }
      on demographicsUpdated: event Patient.DemographicsUpdated is {
        tell command PatientContext.PatientRepository.PersistDemographicsUpdated(patientId = demographicsUpdated.patientId) to repository PatientContext.PatientRepository
        do "apply DemographicsUpdated to the PatientAnalytics projection"
      }
      on emergencyContactAdded: event Patient.EmergencyContactAdded is {
        tell command PatientContext.PatientRepository.PersistEmergencyContactAdded(patientId = emergencyContactAdded.patientId) to repository PatientContext.PatientRepository
        do "apply EmergencyContactAdded to the PatientAnalytics projection"
      }
      on insuranceUpdated: event Patient.InsuranceUpdated is {
        tell command PatientContext.PatientRepository.PersistInsuranceUpdated(patientId = insuranceUpdated.patientId) to repository PatientContext.PatientRepository
        do "apply InsuranceUpdated to the PatientAnalytics projection"
      }
      on patientReactivated: event Patient.PatientReactivated is {
        tell command PatientContext.PatientRepository.PersistPatientReactivated(patientId = patientReactivated.patientId) to repository PatientContext.PatientRepository
        do "apply PatientReactivated to the PatientAnalytics projection"
      }
      on patientsMerged: event Patient.PatientsMerged is {
        tell command PatientContext.PatientRepository.PersistPatientsMerged(survivingPatientId = patientsMerged.survivingPatientId) to repository PatientContext.PatientRepository
        do "apply PatientsMerged to the PatientAnalytics projection"
      }
      on patientRegistered: event Patient.PatientRegistered is {
        tell command PatientContext.PatientRepository.PersistPatientRegistered(patientId = patientRegistered.patientId) to repository PatientContext.PatientRepository
      }
      on patientDeactivated: event Patient.PatientDeactivated is {
        tell command PatientContext.PatientRepository.PersistPatientDeactivated(patientId = patientDeactivated.patientId) to repository PatientContext.PatientRepository
      }
      on insuranceAdded: event Patient.InsuranceAdded is {
        tell command PatientContext.PatientRepository.PersistInsuranceAdded(patientId = insuranceAdded.patientId) to repository PatientContext.PatientRepository
      }
    } with {
      briefly "Maintains patient analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Patient analytics projections"
    described as {
      |Maintains patient registration analytics data.
    }
  }
  type PatientEvent is one of {
    PatientContext.Patient.PatientRegistered or PatientContext.Patient.DemographicsUpdated or PatientContext.Patient.AddressUpdated or PatientContext.Patient.ContactUpdated or PatientContext.Patient.EmergencyContactAdded or PatientContext.Patient.InsuranceAdded or PatientContext.Patient.InsuranceUpdated or PatientContext.Patient.ConsentRecorded or PatientContext.Patient.PatientDeactivated or PatientContext.Patient.PatientReactivated or PatientContext.Patient.PatientsMerged
  } with {
    briefly "Patient events"
    described as {
      |Union of all patient entity events for streaming.
    }
  }
  processor PatientEventSplit as flow is {
    inlet PatientEventSplitIn is type PatientEvent    outlet PatientEventSplitToPatientAnalytics is type PatientEvent
    handler PatientEventSplitHandler is {
      on patientRegistered: event Patient.PatientRegistered is {
        send patientRegistered to outlet PatientEventSplitToPatientAnalytics
        tell patientRegistered to entity PatientContext.Patient
      }
      on demographicsUpdated: event Patient.DemographicsUpdated is {
        send demographicsUpdated to outlet PatientEventSplitToPatientAnalytics
        tell demographicsUpdated to entity PatientContext.Patient
      }
      on addressUpdated: event Patient.AddressUpdated is {
        send addressUpdated to outlet PatientEventSplitToPatientAnalytics
        tell addressUpdated to entity PatientContext.Patient
      }
      on contactUpdated: event Patient.ContactUpdated is {
        send contactUpdated to outlet PatientEventSplitToPatientAnalytics
        tell contactUpdated to entity PatientContext.Patient
      }
      on emergencyContactAdded: event Patient.EmergencyContactAdded is {
        send emergencyContactAdded to outlet PatientEventSplitToPatientAnalytics
        tell emergencyContactAdded to entity PatientContext.Patient
      }
      on insuranceAdded: event Patient.InsuranceAdded is {
        send insuranceAdded to outlet PatientEventSplitToPatientAnalytics
        tell insuranceAdded to entity PatientContext.Patient
      }
      on insuranceUpdated: event Patient.InsuranceUpdated is {
        send insuranceUpdated to outlet PatientEventSplitToPatientAnalytics
        tell insuranceUpdated to entity PatientContext.Patient
      }
      on consentRecorded: event Patient.ConsentRecorded is {
        send consentRecorded to outlet PatientEventSplitToPatientAnalytics
        tell consentRecorded to entity PatientContext.Patient
      }
      on patientDeactivated: event Patient.PatientDeactivated is {
        send patientDeactivated to outlet PatientEventSplitToPatientAnalytics
        tell patientDeactivated to entity PatientContext.Patient
      }
      on patientReactivated: event Patient.PatientReactivated is {
        send patientReactivated to outlet PatientEventSplitToPatientAnalytics
        tell patientReactivated to entity PatientContext.Patient
      }
      on patientsMerged: event Patient.PatientsMerged is {
        send patientsMerged to outlet PatientEventSplitToPatientAnalytics
        tell patientsMerged to entity PatientContext.Patient by survivingPatientId
      }
      on other is {
        error "Unexpected message for processor PatientEventSplit"
      }
    } with {
      briefly "Patient event fan-out handler"
      described as {
        |Delivers each Patient event to all of its consumers.
      }
    }
  } with {
    briefly "Patient event fan-out"
    described as {
      |Fans Patient events out to the repository and projectors.
    }
  }
  connector 'PatientEvent Stream' is from outlet PatientContext.Patient.PatientEvents2 to inlet PatientContext.PatientEventSplit.PatientEventSplitIn with {
    briefly "Patient events, fanned out to storage and read models"
  }
  connector 'PatientAnalytics Feed' is from outlet PatientContext.PatientEventSplit.PatientEventSplitToPatientAnalytics to inlet PatientContext.PatientAnalytics.PatientAnalyticsFromPatient with {
    briefly "Patient events feeding the PatientAnalytics projection"
  }
  connector 'PatientAnalytics Storage' is from outlet PatientContext.PatientAnalytics.PatientAnalyticsToRepository to inlet PatientContext.PatientRepository.PatientRepositoryFromPatientAnalytics with {
    briefly "PatientAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for patient registration"
  described as {
    | The PatientContext is the bounded context for
    | patient demographics and registration management.
  }
}
