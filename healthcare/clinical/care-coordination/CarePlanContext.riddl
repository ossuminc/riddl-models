// Care Coordination - Care Plan Context
context CarePlanContext as router is {
  inlet CarePlanCommandStreamIn is type CarePlanCommand  outlet CarePlanCommandStreamOut is type CarePlanCommand
  inlet CarePlanResultStreamIn is type CarePlan.CarePlanResult  outlet CarePlanResultStreamOut is type CarePlan.CarePlanResult
  handler CarePlanContextBoundary is {
    on createCarePlan: command CarePlan.CreateCarePlan is {
      send createCarePlan to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on addCareTeamMember: command CarePlan.AddCareTeamMember is {
      send addCareTeamMember to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on removeCareTeamMember: command CarePlan.RemoveCareTeamMember is {
      send removeCareTeamMember to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on addGoal: command CarePlan.AddGoal is {
      send addGoal to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on updateGoalStatus: command CarePlan.UpdateGoalStatus is {
      send updateGoalStatus to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on addTask: command CarePlan.AddTask is {
      send addTask to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on completeTask: command CarePlan.CompleteTask is {
      send completeTask to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on createReferral: command CarePlan.CreateReferral is {
      send createReferral to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on updateReferralStatus: command CarePlan.UpdateReferralStatus is {
      send updateReferralStatus to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on activateCarePlan: command CarePlan.ActivateCarePlan is {
      send activateCarePlan to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on completeCarePlan: command CarePlan.CompleteCarePlan is {
      send completeCarePlan to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on initializeCarePlan: command CarePlan.InitializeCarePlan is {
      send initializeCarePlan to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on carePlanResult: result CarePlan.CarePlanResult is {
      send carePlanResult to outlet CarePlanContext.CarePlanResultStreamOut
    }
    on other is {
      error "Unexpected message at the CarePlanContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CarePlanCommand Stream Intake' is from outlet CarePlanContext.CarePlanCommandStreamOut to inlet CarePlanContext.CarePlan.CarePlanCommands  connector 'CarePlanResult Stream Egress' is from outlet CarePlanContext.CarePlanRepository.CarePlanRepositoryResponses to inlet CarePlanContext.CarePlanResultStreamIn  adaptor FromHIEService from context HIEService is { 
    handler FromHIEServiceHandler is {
      on event HIEService.CarePlanShared is {
        do "the model receives care plan shared"
      }
      on other is {
        error "Unexpected message for adaptor FromHIEService"
      }
    } with {
      briefly "from hie service"
      described as {
        |Carries messages from the external HIEService.
      }
    }
  } with {
    briefly "HIEService integration"
    described as {
      |The model's side of the HIEService conversation.
    }
  }
  adaptor ToHIEService to context HIEService is { 
    handler ToHIEServiceHandler is {
      on command HIEService.ShareCarePlan is {
        do "the model sends share care plan"
      }
      on other is {
        error "Unexpected message for adaptor ToHIEService"
      }
    } with {
      briefly "to hie service"
      described as {
        |Carries messages to the external HIEService.
      }
    }
  } with {
    briefly "HIEService integration"
    described as {
      |The model's side of the HIEService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendCareTeamNotification is {
        do "the model sends send care team notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPatientService from context PatientService is { 
    handler FromPatientServiceHandler is {
      on result PatientService.PatientConditions is {
        do "the model receives patient conditions"
      }
      on other is {
        error "Unexpected message for adaptor FromPatientService"
      }
    } with {
      briefly "from patient service"
      described as {
        |Carries messages from the external PatientService.
      }
    }
  } with {
    briefly "PatientService integration"
    described as {
      |The model's side of the PatientService conversation.
    }
  }
  adaptor ToPatientService to context PatientService is { 
    handler ToPatientServiceHandler is {
      on query PatientService.GetPatientConditions is {
        do "the model sends get patient conditions"
      }
      on other is {
        error "Unexpected message for adaptor ToPatientService"
      }
    } with {
      briefly "to patient service"
      described as {
        |Carries messages to the external PatientService.
      }
    }
  } with {
    briefly "PatientService integration"
    described as {
      |The model's side of the PatientService conversation.
    }
  }
  adaptor FromProviderDirectoryService from context ProviderDirectoryService is { 
    handler FromProviderDirectoryServiceHandler is {
      on result ProviderDirectoryService.SpecialistList is {
        do "the model receives specialist list"
      }
      on other is {
        error "Unexpected message for adaptor FromProviderDirectoryService"
      }
    } with {
      briefly "from provider directory service"
      described as {
        |Carries messages from the external ProviderDirectoryService.
      }
    }
  } with {
    briefly "ProviderDirectoryService integration"
    described as {
      |The model's side of the ProviderDirectoryService conversation.
    }
  }
  adaptor ToProviderDirectoryService to context ProviderDirectoryService is { 
    handler ToProviderDirectoryServiceHandler is {
      on query ProviderDirectoryService.FindSpecialist is {
        do "the model sends find specialist"
      }
      on other is {
        error "Unexpected message for adaptor ToProviderDirectoryService"
      }
    } with {
      briefly "to provider directory service"
      described as {
        |Carries messages to the external ProviderDirectoryService.
      }
    }
  } with {
    briefly "ProviderDirectoryService integration"
    described as {
      |The model's side of the ProviderDirectoryService conversation.
    }
  }
  adaptor FromReferralManagementService from context ReferralManagementService is { 
    handler FromReferralManagementServiceHandler is {
      on event ReferralManagementService.ReferralAcknowledged is {
        do "the model receives referral acknowledged"
      }
      on event ReferralManagementService.ReferralSent is {
        do "the model receives referral sent"
      }
      on other is {
        error "Unexpected message for adaptor FromReferralManagementService"
      }
    } with {
      briefly "from referral management service"
      described as {
        |Carries messages from the external ReferralManagementService.
      }
    }
  } with {
    briefly "ReferralManagementService integration"
    described as {
      |The model's side of the ReferralManagementService conversation.
    }
  }
  adaptor ToReferralManagementService to context ReferralManagementService is { 
    handler ToReferralManagementServiceHandler is {
      on command ReferralManagementService.SendReferral is {
        do "the model sends send referral"
      }
      on other is {
        error "Unexpected message for adaptor ToReferralManagementService"
      }
    } with {
      briefly "to referral management service"
      described as {
        |Carries messages to the external ReferralManagementService.
      }
    }
  } with {
    briefly "ReferralManagementService integration"
    described as {
      |The model's side of the ReferralManagementService conversation.
    }
  }
  include "types.riddl"
  include "CarePlan.riddl"
  // Repository for care plan persistence
  repository CarePlanRepository as merge is {
    command PersistCarePlanCompleted is  {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row CarePlanCompleted applies to.
        }
      }
    } with {
      briefly "Persist CarePlanCompleted"
      described as {
        |Instructs this repository to apply CarePlanCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCarePlanCreated is  {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row CarePlanCreated applies to.
        }
      }
    } with {
      briefly "Persist CarePlanCreated"
      described as {
        |Instructs this repository to apply CarePlanCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistGoalStatusUpdated is  {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row GoalStatusUpdated applies to.
        }
      }
    } with {
      briefly "Persist GoalStatusUpdated"
      described as {
        |Instructs this repository to apply GoalStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReferralCreated is  {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReferralCreated applies to.
        }
      }
    } with {
      briefly "Persist ReferralCreated"
      described as {
        |Instructs this repository to apply ReferralCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet CarePlanRepositoryFromCarePlan is type CarePlanEvent    inlet CarePlanRepositoryFromCareCoordinationAnalytics is type CarePlanEvent    outlet CarePlanRepositoryResponses is type CarePlan.CarePlanResult
    record StoredCarePlan is  {
      carePlanId: CarePlanId with {
        briefly "carePlanId"
        described as {
          |The carePlanId column of the stored carePlan row.
        }
      }
      patientId: PatientId with {
        briefly "patientId"
        described as {
          |The patientId column of the stored carePlan row.
        }
      }
    } with {
      briefly "Stored carePlan row"
      described as {
        |The persistence shape of carePlan data as this repository stores it.
      }
    }
    schema CarePlanData is relational
      of carePlans as type StoredCarePlan
        index on field StoredCarePlan.carePlanId
        index on field StoredCarePlan.patientId
 with {
      briefly "Care plan data schema"
      described as {
        |The relational schema holding care plan data for the CarePlanRepository.
      }
    }
    handler CarePlanPersistence is {
      on persistCarePlanCompleted: command PersistCarePlanCompleted is {
        do "apply CarePlanCompleted to the stored row"
      }
      on persistCarePlanCreated: command PersistCarePlanCreated is {
        do "apply CarePlanCreated to the stored row"
      }
      on persistGoalStatusUpdated: command PersistGoalStatusUpdated is {
        do "apply GoalStatusUpdated to the stored row"
      }
      on persistReferralCreated: command PersistReferralCreated is {
        do "apply ReferralCreated to the stored row"
      }
      on query GetCoordinationStats is {
        let coordinationStatsView: type CoordinationStatsView = prompt("read the coordination stats projection")
        reply coordinationStatsView
      }
      on createCarePlan: command CarePlan.CreateCarePlan is {
        tell event CarePlan.CarePlanCreated(carePlanId = createCarePlan.carePlanId, patientId = createCarePlan.patientId, conditions = createCarePlan.conditions, createdBy = createCarePlan.createdBy) to entity CarePlanContext.CarePlan
      }
      on addCareTeamMember: command CarePlan.AddCareTeamMember is {
        tell event CarePlan.CareTeamMemberAdded(carePlanId = addCareTeamMember.carePlanId, member = addCareTeamMember.member) to entity CarePlanContext.CarePlan
      }
      on removeCareTeamMember: command CarePlan.RemoveCareTeamMember is {
        tell event CarePlan.CareTeamMemberRemoved(carePlanId = removeCareTeamMember.carePlanId, providerId = removeCareTeamMember.providerId) to entity CarePlanContext.CarePlan
      }
      on addGoal: command CarePlan.AddGoal is {
        tell event CarePlan.GoalAdded(carePlanId = addGoal.carePlanId, goal = addGoal.goal) to entity CarePlanContext.CarePlan
      }
      on updateGoalStatus: command CarePlan.UpdateGoalStatus is {
        tell event CarePlan.GoalStatusUpdated(carePlanId = updateGoalStatus.carePlanId, goalId = updateGoalStatus.goalId, goalStatus = updateGoalStatus.goalStatus, progress = updateGoalStatus.progress) to entity CarePlanContext.CarePlan
      }
      on addTask: command CarePlan.AddTask is {
        tell event CarePlan.TaskAdded(carePlanId = addTask.carePlanId, task = addTask.task) to entity CarePlanContext.CarePlan
      }
      on completeTask: command CarePlan.CompleteTask is {
        tell event CarePlan.TaskCompleted(carePlanId = completeTask.carePlanId, taskId = completeTask.taskId, completedBy = completeTask.completedBy) to entity CarePlanContext.CarePlan
      }
      on createReferral: command CarePlan.CreateReferral is {
        tell event CarePlan.ReferralCreated(carePlanId = createReferral.carePlanId, referral = createReferral.referral) to entity CarePlanContext.CarePlan
      }
      on updateReferralStatus: command CarePlan.UpdateReferralStatus is {
        tell event CarePlan.ReferralStatusUpdated(carePlanId = updateReferralStatus.carePlanId, referralId = updateReferralStatus.referralId, referralStatus = updateReferralStatus.referralStatus) to entity CarePlanContext.CarePlan
      }
      on activateCarePlan: command CarePlan.ActivateCarePlan is {
        tell event CarePlan.CarePlanActivated(carePlanId = activateCarePlan.carePlanId) to entity CarePlanContext.CarePlan
      }
      on completeCarePlan: command CarePlan.CompleteCarePlan is {
        tell event CarePlan.CarePlanCompleted(carePlanId = completeCarePlan.carePlanId, outcome = completeCarePlan.outcome) to entity CarePlanContext.CarePlan
      }
    } with {
      briefly "Persists care plan events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Care plan data persistence"
    described as {
      | The CarePlanRepository provides persistent storage for
      | care plans, goals, tasks, and referrals.
    }
  }
  // Projector for care coordination analytics
  query GetCoordinationStats replies result CoordinationStatsView is  {
    coordinationStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which coordination stats to retrieve.
      }
    }
  } with {
    briefly "Get coordination stats"
    described as {
      |Retrieves the coordination stats projection.
    }
  }
  result CoordinationStatsView is  {
    coordinationStats: CareCoordinationAnalytics.CoordinationStats with {
      briefly "Coordination stats"
      described as {
        |The coordination stats being returned.
      }
    }
  } with {
    briefly "Coordination stats view"
    described as {
      |Read model view carrying the coordination stats projection.
    }
  }
  projector CareCoordinationAnalytics as flow is {
    updates repository CarePlanContext.CarePlanRepository
    inlet CareCoordinationAnalyticsFromCarePlan is type CarePlanEvent    outlet CareCoordinationAnalyticsOut is type CarePlanEvent
    record CoordinationStats is  {
      activePlans: Natural with {
        briefly "Active"
        described as {
          |Active care plans.
        }
      }
      goalsAchieved: Natural with {
        briefly "Goals"
        described as {
          |Goals achieved.
        }
      }
      pendingReferrals: Natural with {
        briefly "Referrals"
        described as {
          |Pending referrals.
        }
      }
      overdueTasks: Natural with {
        briefly "Overdue"
        described as {
          |Overdue tasks.
        }
      }
      avgPlanDuration: Duration with {
        briefly "Avg duration"
        described as {
          |Average plan duration.
        }
      }
    } with {
      briefly "Coordination statistics"
      described as {
        |Care coordination metrics.
      }
    }
    handler AnalyticsHandler is {
      on carePlanCreated: event CarePlan.CarePlanCreated is {
        tell command CarePlanContext.CarePlanRepository.PersistCarePlanCreated(carePlanId = carePlanCreated.carePlanId) to repository CarePlanContext.CarePlanRepository
      }
      on goalStatusUpdated: event CarePlan.GoalStatusUpdated is {
        tell command CarePlanContext.CarePlanRepository.PersistGoalStatusUpdated(carePlanId = goalStatusUpdated.carePlanId) to repository CarePlanContext.CarePlanRepository
      }
      on referralCreated: event CarePlan.ReferralCreated is {
        tell command CarePlanContext.CarePlanRepository.PersistReferralCreated(carePlanId = referralCreated.carePlanId) to repository CarePlanContext.CarePlanRepository
      }
      on carePlanCompleted: event CarePlan.CarePlanCompleted is {
        tell command CarePlanContext.CarePlanRepository.PersistCarePlanCompleted(carePlanId = carePlanCompleted.carePlanId) to repository CarePlanContext.CarePlanRepository
      }
    } with {
      briefly "Maintains coordination analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Coordination analytics projections"
    described as {
      |Maintains care coordination analytics data.
    }
  }
  // Event union for streaming
  type CarePlanEvent is one of {
    CarePlanContext.CarePlan.CarePlanCreated or CarePlanContext.CarePlan.CareTeamMemberAdded or CarePlanContext.CarePlan.CareTeamMemberRemoved or CarePlanContext.CarePlan.GoalAdded or CarePlanContext.CarePlan.GoalStatusUpdated or CarePlanContext.CarePlan.TaskAdded or CarePlanContext.CarePlan.TaskCompleted or CarePlanContext.CarePlan.ReferralCreated or CarePlanContext.CarePlan.ReferralStatusUpdated or CarePlanContext.CarePlan.CarePlanActivated or CarePlanContext.CarePlan.CarePlanCompleted
  } with {
    briefly "Care plan events"
    described as {
      |Union of all care plan entity events for streaming.
    }
  }
  processor CarePlanSource as source is {
    outlet CarePlanEvents is type CarePlanEvent
 with {
      briefly "Care plan event outlet"
      described as {
        |Publishes care plan events.
      }
    }
    handler CarePlanSourceHandler is {
      on init is {
        let initializeCarePlan: type CarePlan.InitializeCarePlan = prompt("the initialize care plan that brings this this into existence")
        tell initializeCarePlan to entity CarePlanContext.CarePlan
      }
      on carePlanCreated: event CarePlan.CarePlanCreated is {
        send carePlanCreated to outlet CarePlanEvents
      }
      on carePlanActivated: event CarePlan.CarePlanActivated is {
        send carePlanActivated to outlet CarePlanEvents
      }
      on carePlanCompleted: event CarePlan.CarePlanCompleted is {
        send carePlanCompleted to outlet CarePlanEvents
      }
      on other is {
        error "Unexpected message for source CarePlanSource"
      }
    } with {
      briefly "Care plan source handler"
      described as {
        |Forwards care plan events to the outlet.
      }
    }
  } with {
    briefly "Care plan event source"
    described as {
      |Source streamlet that publishes care plan events.
    }
  }
  processor CarePlanSink as sink is {
    inlet CarePlanEventsIn is type CarePlanEvent with {
      briefly "Care plan event inlet"
      described as {
        |Receives care plan events.
      }
    }
    handler CarePlanSinkHandler is {
      on init is { ??? }
      on carePlanCreated: event CarePlan.CarePlanCreated is {
        tell carePlanCreated to repository CarePlanContext.CarePlanRepository
      }
      on carePlanCompleted: event CarePlan.CarePlanCompleted is {
        tell carePlanCompleted to repository CarePlanContext.CarePlanRepository
      }
      on other is {
        error "Unexpected message for sink CarePlanSink"
      }
    } with {
      briefly "Care plan sink handler"
      described as {
        |Persists care plan events from the inlet.
      }
    }
  } with {
    briefly "Care plan event sink"
    described as {
      |Sink streamlet that consumes care plan events.
    }
  }
  connector CarePlanFlow is from outlet CarePlanContext.CarePlanSource.CarePlanEvents to inlet CarePlanContext.CarePlanSink.CarePlanEventsIn with {
    briefly "Care plan event flow"
    described as {
      |Connects care plan source to sink for event streaming.
    }
  }
  processor CarePlanEventSplit as split is {
    inlet CarePlanEventSplitIn is type CarePlanEvent    outlet CarePlanEventSplitToCarePlanRepository is type CarePlanEvent
    outlet CarePlanEventSplitToCareCoordinationAnalytics is type CarePlanEvent
    handler CarePlanEventSplitHandler is {
      on carePlanCreated: event CarePlan.CarePlanCreated is {
        send carePlanCreated to outlet CarePlanEventSplitToCarePlanRepository
        send carePlanCreated to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell carePlanCreated to entity CarePlanContext.CarePlan
      }
      on careTeamMemberAdded: event CarePlan.CareTeamMemberAdded is {
        send careTeamMemberAdded to outlet CarePlanEventSplitToCarePlanRepository
        send careTeamMemberAdded to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell careTeamMemberAdded to entity CarePlanContext.CarePlan
      }
      on careTeamMemberRemoved: event CarePlan.CareTeamMemberRemoved is {
        send careTeamMemberRemoved to outlet CarePlanEventSplitToCarePlanRepository
        send careTeamMemberRemoved to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell careTeamMemberRemoved to entity CarePlanContext.CarePlan
      }
      on goalAdded: event CarePlan.GoalAdded is {
        send goalAdded to outlet CarePlanEventSplitToCarePlanRepository
        send goalAdded to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell goalAdded to entity CarePlanContext.CarePlan
      }
      on goalStatusUpdated: event CarePlan.GoalStatusUpdated is {
        send goalStatusUpdated to outlet CarePlanEventSplitToCarePlanRepository
        send goalStatusUpdated to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell goalStatusUpdated to entity CarePlanContext.CarePlan
      }
      on taskAdded: event CarePlan.TaskAdded is {
        send taskAdded to outlet CarePlanEventSplitToCarePlanRepository
        send taskAdded to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell taskAdded to entity CarePlanContext.CarePlan
      }
      on taskCompleted: event CarePlan.TaskCompleted is {
        send taskCompleted to outlet CarePlanEventSplitToCarePlanRepository
        send taskCompleted to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell taskCompleted to entity CarePlanContext.CarePlan
      }
      on referralCreated: event CarePlan.ReferralCreated is {
        send referralCreated to outlet CarePlanEventSplitToCarePlanRepository
        send referralCreated to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell referralCreated to entity CarePlanContext.CarePlan
      }
      on referralStatusUpdated: event CarePlan.ReferralStatusUpdated is {
        send referralStatusUpdated to outlet CarePlanEventSplitToCarePlanRepository
        send referralStatusUpdated to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell referralStatusUpdated to entity CarePlanContext.CarePlan
      }
      on carePlanActivated: event CarePlan.CarePlanActivated is {
        send carePlanActivated to outlet CarePlanEventSplitToCarePlanRepository
        send carePlanActivated to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell carePlanActivated to entity CarePlanContext.CarePlan
      }
      on carePlanCompleted: event CarePlan.CarePlanCompleted is {
        send carePlanCompleted to outlet CarePlanEventSplitToCarePlanRepository
        send carePlanCompleted to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell carePlanCompleted to entity CarePlanContext.CarePlan
      }
      on other is {
        error "Unexpected message for processor CarePlanEventSplit"
      }
    } with {
      briefly "CarePlan event fan-out handler"
      described as {
        |Delivers each CarePlan event to all of its consumers.
      }
    }
  } with {
    briefly "CarePlan event fan-out"
    described as {
      |Fans CarePlan events out to the repository and projectors.
    }
  }
  connector 'CarePlanEvent Stream' is from outlet CarePlanContext.CarePlan.CarePlanEvents2 to inlet CarePlanContext.CarePlanEventSplit.CarePlanEventSplitIn with {
    briefly "CarePlan events, fanned out to storage and read models"
  }
  connector 'CarePlanEvent Storage' is from outlet CarePlanContext.CarePlanEventSplit.CarePlanEventSplitToCarePlanRepository to inlet CarePlanContext.CarePlanRepository.CarePlanRepositoryFromCarePlan with {
    briefly "CarePlan events on their way to storage"
  }
  connector 'CareCoordinationAnalytics Feed' is from outlet CarePlanContext.CarePlanEventSplit.CarePlanEventSplitToCareCoordinationAnalytics to inlet CarePlanContext.CareCoordinationAnalytics.CareCoordinationAnalyticsFromCarePlan with {
    briefly "CarePlan events feeding the CareCoordinationAnalytics projection"
  }
  connector 'CareCoordinationAnalytics Storage' is from outlet CarePlanContext.CareCoordinationAnalytics.CareCoordinationAnalyticsOut to inlet CarePlanContext.CarePlanRepository.CarePlanRepositoryFromCareCoordinationAnalytics with {
    briefly "The CareCoordinationAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for care coordination"
  described as {
    | The CarePlanContext is the bounded context for
    | care plans, referrals, and team coordination.
  }
}
