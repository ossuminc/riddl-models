// Care Coordination - Care Plan Context
context CarePlanContext as router is {
  inlet CarePlanContextFromToPatientService is command CarePlan.AddGoal with {
    briefly "What ToPatientService makes of the answers it gets"
  }
  connector 'ToPatientService Intake' is from outlet CarePlanContext.ToPatientService.ToPatientServiceToCarePlanContext to inlet CarePlanContext.CarePlanContextFromToPatientService with {
    briefly "Answers translated by ToPatientService, on their way in"
  }
  inlet CarePlanContextFromToProviderDirectoryService is command CarePlan.AddCareTeamMember with {
    briefly "What ToProviderDirectoryService makes of the answers it gets"
  }
  connector 'ToProviderDirectoryService Intake' is from outlet CarePlanContext.ToProviderDirectoryService.ToProviderDirectoryServiceToCarePlanContext to inlet CarePlanContext.CarePlanContextFromToProviderDirectoryService with {
    briefly "Answers translated by ToProviderDirectoryService, on their way in"
  }
  inlet CarePlanContextFromReferralManagementService is command CarePlan.UpdateReferralStatus with {
    briefly "What FromReferralManagementService makes of that service's news"
  }
  connector 'FromReferralManagementService Intake' is from outlet CarePlanContext.FromReferralManagementService.FromReferralManagementServiceToCarePlanContext to inlet CarePlanContext.CarePlanContextFromReferralManagementService with {
    briefly "What FromReferralManagementService makes of that news, on its way in"
  }
  inlet CarePlanCommandStreamIn is type CarePlanCommand  outlet CarePlanCommandStreamOut is type CarePlanCommand
  inlet CarePlanResultStreamIn is result CarePlan.CarePlanResult  outlet CarePlanResultStreamOut is result CarePlan.CarePlanResult
  handler CarePlanContextBoundary is {
    on createCarePlan: command CarePlan.CreateCarePlan is {
      send createCarePlan to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on addCareTeamMember: command CarePlan.AddCareTeamMember is {
      send addCareTeamMember to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on removeCareTeamMember: command CarePlan.RemoveCareTeamMember is {
      send removeCareTeamMember to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on addGoal: command CarePlan.AddGoal is {
      send addGoal to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on updateGoalStatus: command CarePlan.UpdateGoalStatus is {
      send updateGoalStatus to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on addTask: command CarePlan.AddTask is {
      send addTask to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on completeTask: command CarePlan.CompleteTask is {
      send completeTask to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on createReferral: command CarePlan.CreateReferral is {
      send createReferral to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on updateReferralStatus: command CarePlan.UpdateReferralStatus is {
      send updateReferralStatus to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on activateCarePlan: command CarePlan.ActivateCarePlan is {
      send activateCarePlan to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on completeCarePlan: command CarePlan.CompleteCarePlan is {
      send completeCarePlan to outlet CarePlanContext.CarePlanCommandStreamOut
    }
    on carePlanResult: result CarePlan.CarePlanResult is {
      send carePlanResult to outlet CarePlanContext.CarePlanResultStreamOut
    }
    on other is {
      error "Unexpected message at the CarePlanContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CarePlanCommand Stream Intake' is from outlet CarePlanContext.CarePlanCommandStreamOut to inlet CarePlanContext.CarePlan.CarePlanCommands  connector 'CarePlanResult Stream Egress' is from outlet CarePlanContext.CarePlanRepository.CarePlanRepositoryResponses to inlet CarePlanContext.CarePlanResultStreamIn  adaptor FromHIEService from context HIEService as sink is { 
    inlet FromHIEServiceIn is event HIEService.CarePlanShared    handler FromHIEServiceHandler is {
      on carePlanShared: event HIEService.CarePlanShared is {
        do "the exchange has the plan; sharing it was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromHIEService"
      }
    } with {
      briefly "from hie service"
      described as {
        |Carries messages from the external HIEService.
      }
    }
  } with {
    briefly "HIEService integration"
    described as {
      |The model's side of the HIEService conversation.
    }
  }
  adaptor ToHIEService to context HIEService as flow is { 
    inlet ToHIEServiceIn is type CarePlanEvent    outlet ToHIEServiceOut is command HIEService.ShareCarePlan
    handler ToHIEServiceHandler is {
      on carePlanActivated: event CarePlan.CarePlanActivated is {
        let item0: type HIEService.ShareCarePlan = prompt("translate the carePlanActivated event into a ShareCarePlan, activation being when other providers need to see it")
        send item0 to outlet CarePlanContext.ToHIEService.ToHIEServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToHIEService"
      }
    } with {
      briefly "to hie service"
      described as {
        |Carries messages to the external HIEService.
      }
    }
  } with {
    briefly "HIEService integration"
    described as {
      |The model's side of the HIEService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type CarePlanEvent    outlet ToNotificationServiceOut is command NotificationService.SendCareTeamNotification
    handler ToNotificationServiceHandler is {
      on referralStatusUpdated: event ReferralStatusUpdated is {
        let notice: type NotificationService.SendCareTeamNotification = prompt("translate the referralStatusUpdated event into a SendCareTeamNotification telling the care team where the referral now stands, since the next step waits on it")
        send notice to outlet CarePlanContext.ToNotificationService.ToNotificationServiceOut
      }
      on carePlanActivated: event CarePlanActivated is {
        let notice: type NotificationService.SendCareTeamNotification = prompt("translate the carePlanActivated event into a SendCareTeamNotification telling the care team the plan is live and they are accountable for its goals")
        send notice to outlet CarePlanContext.ToNotificationService.ToNotificationServiceOut
      }
      on careTeamMemberAdded: event CareTeamMemberAdded is {
        let notice: type NotificationService.SendCareTeamNotification = prompt("translate the careTeamMemberAdded event into a SendCareTeamNotification telling the new member they are on this patient's team")
        send notice to outlet CarePlanContext.ToNotificationService.ToNotificationServiceOut
      }
      on goalStatusUpdated: event GoalStatusUpdated is {
        let notice: type NotificationService.SendCareTeamNotification = prompt("translate the goalStatusUpdated event into a SendCareTeamNotification telling the care team a goal has moved, since the plan is judged on them")
        send notice to outlet CarePlanContext.ToNotificationService.ToNotificationServiceOut
      }
      on taskCompleted: event TaskCompleted is {
        let notice: type NotificationService.SendCareTeamNotification = prompt("translate the taskCompleted event into a SendCareTeamNotification telling the care team a task is done so nobody repeats it")
        send notice to outlet CarePlanContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToPatientService to context PatientService as router is { 
    outlet ToPatientServiceToCarePlanContext is command CarePlan.AddGoal
    inlet ToPatientServiceIn is type CarePlanEvent    inlet ToPatientServiceReplies is result PatientService.PatientConditions    outlet ToPatientServiceOut is query PatientService.GetPatientConditions
    handler ToPatientServiceHandler is {
      on carePlanCreated: event CarePlan.CarePlanCreated is {
        let askAnswer: type PatientService.PatientConditions = ask query PatientService.GetPatientConditions of context PatientService
        do "a new care plan needing the conditions it is meant to address"
        send command CarePlan.AddGoal(carePlanId = carePlanCreated.carePlanId, goal = prompt("a goal for the first of askAnswer.conditions the plan does not yet address")) to outlet CarePlanContext.ToPatientService.ToPatientServiceToCarePlanContext
      }
      on other is {
        error "Unexpected message for adaptor ToPatientService"
      }
    } with {
      briefly "to patient service"
      described as {
        |Carries messages to the external PatientService.
      }
    }
  } with {
    briefly "PatientService integration"
    described as {
      |The model's side of the PatientService conversation.
    }
  }
  adaptor ToProviderDirectoryService to context ProviderDirectoryService as router is { 
    outlet ToProviderDirectoryServiceToCarePlanContext is command CarePlan.AddCareTeamMember
    inlet ToProviderDirectoryServiceIn is type CarePlanEvent    inlet ToProviderDirectoryServiceReplies is result ProviderDirectoryService.SpecialistList    outlet ToProviderDirectoryServiceOut is query ProviderDirectoryService.FindSpecialist
    handler ToProviderDirectoryServiceHandler is {
      on referralCreated: event CarePlan.ReferralCreated is {
        let askAnswer: type ProviderDirectoryService.SpecialistList = ask query ProviderDirectoryService.FindSpecialist of context ProviderDirectoryService
        do "a referral needing a specialist who takes this patient"
        send command CarePlan.AddCareTeamMember(carePlanId = referralCreated.carePlanId, member = prompt("the first of askAnswer.providers, as the referred specialist")) to outlet CarePlanContext.ToProviderDirectoryService.ToProviderDirectoryServiceToCarePlanContext
      }
      on other is {
        error "Unexpected message for adaptor ToProviderDirectoryService"
      }
    } with {
      briefly "to provider directory service"
      described as {
        |Carries messages to the external ProviderDirectoryService.
      }
    }
  } with {
    briefly "ProviderDirectoryService integration"
    described as {
      |The model's side of the ProviderDirectoryService conversation.
    }
  }
  adaptor FromReferralManagementService from context ReferralManagementService as flow is { 
    inlet FromReferralManagementServiceIn is type ReferralManagementService.ReferralManagementServiceEvent    outlet FromReferralManagementServiceToCarePlanContext is command CarePlan.UpdateReferralStatus
    handler FromReferralManagementServiceHandler is {
      on referralAcknowledged: event ReferralManagementService.ReferralAcknowledged is {
        let item0: type CarePlan.UpdateReferralStatus = prompt("translate the referralAcknowledged event into a UpdateReferralStatus, the receiving provider acknowledging is exactly what the referral's status records")
        send item0 to outlet CarePlanContext.FromReferralManagementService.FromReferralManagementServiceToCarePlanContext
      }
      on referralSent: event ReferralManagementService.ReferralSent is {
        do "the referral is out; the care plan recorded making it"
      }
      on other is {
        error "Unexpected message for adaptor FromReferralManagementService"
      }
    } with {
      briefly "from referral management service"
      described as {
        |Carries messages from the external ReferralManagementService.
      }
    }
  } with {
    briefly "ReferralManagementService integration"
    described as {
      |The model's side of the ReferralManagementService conversation.
    }
  }
  adaptor ToReferralManagementService to context ReferralManagementService as flow is { 
    inlet ToReferralManagementServiceIn is type CarePlanEvent    outlet ToReferralManagementServiceOut is command ReferralManagementService.SendReferral
    handler ToReferralManagementServiceHandler is {
      on referralCreated: event CarePlan.ReferralCreated is {
        let item0: type ReferralManagementService.SendReferral = prompt("translate the referralCreated event into a SendReferral, the referral being the thing itself")
        send item0 to outlet CarePlanContext.ToReferralManagementService.ToReferralManagementServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToReferralManagementService"
      }
    } with {
      briefly "to referral management service"
      described as {
        |Carries messages to the external ReferralManagementService.
      }
    }
  } with {
    briefly "ReferralManagementService integration"
    described as {
      |The model's side of the ReferralManagementService conversation.
    }
  }
  include "types.riddl"
  include "CarePlan.riddl"
  // Repository for care plan persistence
  type CarePlanRepositoryCommand is one of {
    CarePlanContext.CarePlanRepository.PersistCarePlanActivated or CarePlanContext.CarePlanRepository.PersistCarePlanCompleted or CarePlanContext.CarePlanRepository.PersistCarePlanCreated or CarePlanContext.CarePlanRepository.PersistCareTeamMemberAdded or CarePlanContext.CarePlanRepository.PersistCareTeamMemberRemoved or CarePlanContext.CarePlanRepository.PersistGoalAdded or CarePlanContext.CarePlanRepository.PersistGoalStatusUpdated or CarePlanContext.CarePlanRepository.PersistReferralCreated or CarePlanContext.CarePlanRepository.PersistReferralStatusUpdated or CarePlanContext.CarePlanRepository.PersistTaskAdded or CarePlanContext.CarePlanRepository.PersistTaskCompleted
  } with {
    briefly "Anything that writes CarePlanRepository"
    described as {
      |The persistence commands CarePlanRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository CarePlanRepository as flow is {
    inlet CarePlanRepositoryFromCareCoordinationAnalytics is type CarePlanRepositoryCommand    command PersistCarePlanActivated is {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row CarePlanActivated applies to.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CarePlanActivated"
      described as {
        |Instructs this repository to apply CarePlanActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCareTeamMemberAdded is {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row CareTeamMemberAdded applies to.
        }
      }
      member: CareTeamMember? with {
        briefly "Member"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CareTeamMemberAdded"
      described as {
        |Instructs this repository to apply CareTeamMemberAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCareTeamMemberRemoved is {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row CareTeamMemberRemoved applies to.
        }
      }
      providerId: ProviderId? with {
        briefly "Provider id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CareTeamMemberRemoved"
      described as {
        |Instructs this repository to apply CareTeamMemberRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistGoalAdded is {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row GoalAdded applies to.
        }
      }
      goal: CareGoal? with {
        briefly "Goal"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist GoalAdded"
      described as {
        |Instructs this repository to apply GoalAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReferralStatusUpdated is {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReferralStatusUpdated applies to.
        }
      }
      referralId: ReferralId? with {
        briefly "Referral id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      referralStatus: ReferralStatus? with {
        briefly "Referral status"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReferralStatusUpdated"
      described as {
        |Instructs this repository to apply ReferralStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTaskAdded is {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row TaskAdded applies to.
        }
      }
      task: CareTask? with {
        briefly "Task"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TaskAdded"
      described as {
        |Instructs this repository to apply TaskAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTaskCompleted is {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row TaskCompleted applies to.
        }
      }
      taskId: TaskId? with {
        briefly "Task id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      completedBy: ProviderId? with {
        briefly "Completed by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TaskCompleted"
      described as {
        |Instructs this repository to apply TaskCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCarePlanCompleted is {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row CarePlanCompleted applies to.
        }
      }
      outcome: String(1,500)? with {
        briefly "Outcome"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CarePlanCompleted"
      described as {
        |Instructs this repository to apply CarePlanCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCarePlanCreated is {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row CarePlanCreated applies to.
        }
      }
      patientId: PatientId? with {
        briefly "Patient id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      conditions: Condition+ with {
        briefly "Conditions"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdBy: ProviderId? with {
        briefly "Created by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CarePlanCreated"
      described as {
        |Instructs this repository to apply CarePlanCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistGoalStatusUpdated is {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row GoalStatusUpdated applies to.
        }
      }
      goalId: GoalId? with {
        briefly "Goal id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      goalStatus: GoalStatus? with {
        briefly "Goal status"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      progress: String(1,1000)? with {
        briefly "Progress"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist GoalStatusUpdated"
      described as {
        |Instructs this repository to apply GoalStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReferralCreated is {
      carePlanId: CarePlanId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReferralCreated applies to.
        }
      }
      referral: Referral? with {
        briefly "Referral"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReferralCreated"
      described as {
        |Instructs this repository to apply ReferralCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet CarePlanRepositoryResponses is result CarePlan.CarePlanResult
    record StoredCarePlan is {
      carePlanId: CarePlanId with {
        briefly "carePlanId"
        described as {
          |The carePlanId column of the stored carePlan row.
        }
      }
      patientId: PatientId with {
        briefly "patientId"
        described as {
          |The patientId column of the stored carePlan row.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      member: CareTeamMember? with {
        briefly "Member"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      providerId: ProviderId? with {
        briefly "Provider id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      goal: CareGoal? with {
        briefly "Goal"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      referralId: ReferralId? with {
        briefly "Referral id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      referralStatus: ReferralStatus? with {
        briefly "Referral status"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      task: CareTask? with {
        briefly "Task"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      taskId: TaskId? with {
        briefly "Task id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      completedBy: ProviderId? with {
        briefly "Completed by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      outcome: String(1,500)? with {
        briefly "Outcome"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      conditions: Condition+ with {
        briefly "Conditions"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdBy: ProviderId? with {
        briefly "Created by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      goalId: GoalId? with {
        briefly "Goal id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      goalStatus: GoalStatus? with {
        briefly "Goal status"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      progress: String(1,1000)? with {
        briefly "Progress"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      referral: Referral? with {
        briefly "Referral"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored carePlan row"
      described as {
        |The persistence shape of carePlan data as this repository stores it.
      }
    }
    schema CarePlanData is relational
      of carePlans as record StoredCarePlan
        key on field StoredCarePlan.carePlanId
        index on field StoredCarePlan.patientId
 with {
      briefly "Care plan data schema"
      described as {
        |The relational schema holding care plan data for the CarePlanRepository.
      }
    }
    handler CarePlanPersistence is {
      on persistCarePlanActivated: command PersistCarePlanActivated is {
        update CarePlanData.carePlans set activatedAt = persistCarePlanActivated.activatedAt where carePlanId == persistCarePlanActivated.carePlanId
      }
      on persistCareTeamMemberAdded: command PersistCareTeamMemberAdded is {
        update CarePlanData.carePlans set member = persistCareTeamMemberAdded.member, addedAt = persistCareTeamMemberAdded.addedAt where carePlanId == persistCareTeamMemberAdded.carePlanId
      }
      on persistCareTeamMemberRemoved: command PersistCareTeamMemberRemoved is {
        update CarePlanData.carePlans set providerId = persistCareTeamMemberRemoved.providerId, removedAt = persistCareTeamMemberRemoved.removedAt where carePlanId == persistCareTeamMemberRemoved.carePlanId
      }
      on persistGoalAdded: command PersistGoalAdded is {
        update CarePlanData.carePlans set goal = persistGoalAdded.goal where carePlanId == persistGoalAdded.carePlanId
      }
      on persistReferralStatusUpdated: command PersistReferralStatusUpdated is {
        update CarePlanData.carePlans set referralId = persistReferralStatusUpdated.referralId, referralStatus = persistReferralStatusUpdated.referralStatus, updatedAt = persistReferralStatusUpdated.updatedAt where carePlanId == persistReferralStatusUpdated.carePlanId
      }
      on persistTaskAdded: command PersistTaskAdded is {
        update CarePlanData.carePlans set task = persistTaskAdded.task where carePlanId == persistTaskAdded.carePlanId
      }
      on persistTaskCompleted: command PersistTaskCompleted is {
        update CarePlanData.carePlans set taskId = persistTaskCompleted.taskId, completedBy = persistTaskCompleted.completedBy, completedAt = persistTaskCompleted.completedAt where carePlanId == persistTaskCompleted.carePlanId
      }
      on persistCarePlanCompleted: command PersistCarePlanCompleted is {
        update CarePlanData.carePlans set outcome = persistCarePlanCompleted.outcome, completedAt = persistCarePlanCompleted.completedAt where carePlanId == persistCarePlanCompleted.carePlanId
      }
      on persistCarePlanCreated: command PersistCarePlanCreated is {
        update CarePlanData.carePlans set patientId = persistCarePlanCreated.patientId, conditions = persistCarePlanCreated.conditions, createdBy = persistCarePlanCreated.createdBy, createdAt = persistCarePlanCreated.createdAt where carePlanId == persistCarePlanCreated.carePlanId
      }
      on persistGoalStatusUpdated: command PersistGoalStatusUpdated is {
        update CarePlanData.carePlans set goalId = persistGoalStatusUpdated.goalId, goalStatus = persistGoalStatusUpdated.goalStatus, progress = persistGoalStatusUpdated.progress, updatedAt = persistGoalStatusUpdated.updatedAt where carePlanId == persistGoalStatusUpdated.carePlanId
      }
      on persistReferralCreated: command PersistReferralCreated is {
        update CarePlanData.carePlans set referral = persistReferralCreated.referral where carePlanId == persistReferralCreated.carePlanId
      }
      on query GetCoordinationStats is {
        let coordinationStatsView: type CoordinationStatsView = prompt("read the coordination stats projection")
        reply coordinationStatsView
      }
    } with {
      briefly "Persists care plan events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Care plan data persistence"
    described as {
      | The CarePlanRepository provides persistent storage for
      | care plans, goals, tasks, and referrals.
    }
  }
  // Projector for care coordination analytics
  query GetCoordinationStats replies result CoordinationStatsView is {
    coordinationStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which coordination stats to retrieve.
      }
    }
  } with {
    briefly "Get coordination stats"
    described as {
      |Retrieves the coordination stats projection.
    }
  }
  result CoordinationStatsView is {
    coordinationStats: CareCoordinationAnalytics.CoordinationStats with {
      briefly "Coordination stats"
      described as {
        |The coordination stats being returned.
      }
    }
  } with {
    briefly "Coordination stats view"
    described as {
      |Read model view carrying the coordination stats projection.
    }
  }
  projector CareCoordinationAnalytics as flow is {
    updates repository CarePlanContext.CarePlanRepository
    outlet CareCoordinationAnalyticsToRepository is type CarePlanRepositoryCommand
    inlet CareCoordinationAnalyticsFromCarePlan is type CarePlanEvent    record CoordinationStats is {
      activePlans: Natural with {
        briefly "Active"
        described as {
          |Active care plans.
        }
      }
      goalsAchieved: Natural with {
        briefly "Goals"
        described as {
          |Goals achieved.
        }
      }
      pendingReferrals: Natural with {
        briefly "Referrals"
        described as {
          |Pending referrals.
        }
      }
      overdueTasks: Natural with {
        briefly "Overdue"
        described as {
          |Overdue tasks.
        }
      }
      avgPlanDuration: Duration with {
        briefly "Avg duration"
        described as {
          |Average plan duration.
        }
      }
    } with {
      briefly "Coordination statistics"
      described as {
        |Care coordination metrics.
      }
    }
    handler AnalyticsHandler is {
      on carePlanActivated: event CarePlan.CarePlanActivated is {
        tell command CarePlanContext.CarePlanRepository.PersistCarePlanActivated(carePlanId = carePlanActivated.carePlanId, activatedAt = carePlanActivated.activatedAt) to repository CarePlanContext.CarePlanRepository
        do "apply CarePlanActivated to the CareCoordinationAnalytics projection"
      }
      on careTeamMemberAdded: event CarePlan.CareTeamMemberAdded is {
        tell command CarePlanContext.CarePlanRepository.PersistCareTeamMemberAdded(carePlanId = careTeamMemberAdded.carePlanId, member = careTeamMemberAdded.member, addedAt = careTeamMemberAdded.addedAt) to repository CarePlanContext.CarePlanRepository
        do "apply CareTeamMemberAdded to the CareCoordinationAnalytics projection"
      }
      on careTeamMemberRemoved: event CarePlan.CareTeamMemberRemoved is {
        tell command CarePlanContext.CarePlanRepository.PersistCareTeamMemberRemoved(carePlanId = careTeamMemberRemoved.carePlanId, providerId = careTeamMemberRemoved.providerId, removedAt = careTeamMemberRemoved.removedAt) to repository CarePlanContext.CarePlanRepository
        do "apply CareTeamMemberRemoved to the CareCoordinationAnalytics projection"
      }
      on goalAdded: event CarePlan.GoalAdded is {
        tell command CarePlanContext.CarePlanRepository.PersistGoalAdded(carePlanId = goalAdded.carePlanId, goal = goalAdded.goal) to repository CarePlanContext.CarePlanRepository
        do "apply GoalAdded to the CareCoordinationAnalytics projection"
      }
      on referralStatusUpdated: event CarePlan.ReferralStatusUpdated is {
        tell command CarePlanContext.CarePlanRepository.PersistReferralStatusUpdated(carePlanId = referralStatusUpdated.carePlanId, referralId = referralStatusUpdated.referralId, referralStatus = referralStatusUpdated.referralStatus, updatedAt = referralStatusUpdated.updatedAt) to repository CarePlanContext.CarePlanRepository
        do "apply ReferralStatusUpdated to the CareCoordinationAnalytics projection"
      }
      on taskAdded: event CarePlan.TaskAdded is {
        tell command CarePlanContext.CarePlanRepository.PersistTaskAdded(carePlanId = taskAdded.carePlanId, task = taskAdded.task) to repository CarePlanContext.CarePlanRepository
        do "apply TaskAdded to the CareCoordinationAnalytics projection"
      }
      on taskCompleted: event CarePlan.TaskCompleted is {
        tell command CarePlanContext.CarePlanRepository.PersistTaskCompleted(carePlanId = taskCompleted.carePlanId, taskId = taskCompleted.taskId, completedBy = taskCompleted.completedBy, completedAt = taskCompleted.completedAt) to repository CarePlanContext.CarePlanRepository
        do "apply TaskCompleted to the CareCoordinationAnalytics projection"
      }
      on carePlanCreated: event CarePlan.CarePlanCreated is {
        tell command CarePlanContext.CarePlanRepository.PersistCarePlanCreated(carePlanId = carePlanCreated.carePlanId, patientId = carePlanCreated.patientId, conditions = carePlanCreated.conditions, createdBy = carePlanCreated.createdBy, createdAt = carePlanCreated.createdAt) to repository CarePlanContext.CarePlanRepository
      }
      on goalStatusUpdated: event CarePlan.GoalStatusUpdated is {
        tell command CarePlanContext.CarePlanRepository.PersistGoalStatusUpdated(carePlanId = goalStatusUpdated.carePlanId, goalId = goalStatusUpdated.goalId, goalStatus = goalStatusUpdated.goalStatus, progress = goalStatusUpdated.progress, updatedAt = goalStatusUpdated.updatedAt) to repository CarePlanContext.CarePlanRepository
      }
      on referralCreated: event CarePlan.ReferralCreated is {
        tell command CarePlanContext.CarePlanRepository.PersistReferralCreated(carePlanId = referralCreated.carePlanId, referral = referralCreated.referral) to repository CarePlanContext.CarePlanRepository
      }
      on carePlanCompleted: event CarePlan.CarePlanCompleted is {
        tell command CarePlanContext.CarePlanRepository.PersistCarePlanCompleted(carePlanId = carePlanCompleted.carePlanId, outcome = carePlanCompleted.outcome, completedAt = carePlanCompleted.completedAt) to repository CarePlanContext.CarePlanRepository
      }
    } with {
      briefly "Maintains coordination analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Coordination analytics projections"
    described as {
      |Maintains care coordination analytics data.
    }
  }
  // Event union for streaming
  type CarePlanEvent is one of {
    CarePlanContext.CarePlan.CarePlanCreated or CarePlanContext.CarePlan.CareTeamMemberAdded or CarePlanContext.CarePlan.CareTeamMemberRemoved or CarePlanContext.CarePlan.GoalAdded or CarePlanContext.CarePlan.GoalStatusUpdated or CarePlanContext.CarePlan.TaskAdded or CarePlanContext.CarePlan.TaskCompleted or CarePlanContext.CarePlan.ReferralCreated or CarePlanContext.CarePlan.ReferralStatusUpdated or CarePlanContext.CarePlan.CarePlanActivated or CarePlanContext.CarePlan.CarePlanCompleted
  } with {
    briefly "Care plan events"
    described as {
      |Union of all care plan entity events for streaming.
    }
  }
  streamlet CarePlanEventSplit as split is {
    outlet CarePlanEventSplitToToReferralManagementService is type CarePlanEvent
    outlet CarePlanEventSplitToToProviderDirectoryService is type CarePlanEvent
    outlet CarePlanEventSplitToToPatientService is type CarePlanEvent
    outlet CarePlanEventSplitToToNotificationService is type CarePlanEvent
    outlet CarePlanEventSplitToToHIEService is type CarePlanEvent
    inlet CarePlanEventSplitIn is type CarePlanEvent    outlet CarePlanEventSplitToCareCoordinationAnalytics is type CarePlanEvent
    handler CarePlanEventSplitHandler is {
      on carePlanCreated: event CarePlan.CarePlanCreated is {
        send carePlanCreated to outlet CarePlanEventSplitToCareCoordinationAnalytics
        send carePlanCreated to outlet CarePlanEventSplitToToPatientService
        tell carePlanCreated to entity CarePlanContext.CarePlan
      }
      on careTeamMemberAdded: event CarePlan.CareTeamMemberAdded is {
        send careTeamMemberAdded to outlet CarePlanEventSplitToCareCoordinationAnalytics
        send careTeamMemberAdded to outlet CarePlanEventSplitToToNotificationService
        tell careTeamMemberAdded to entity CarePlanContext.CarePlan
      }
      on careTeamMemberRemoved: event CarePlan.CareTeamMemberRemoved is {
        send careTeamMemberRemoved to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell careTeamMemberRemoved to entity CarePlanContext.CarePlan
      }
      on goalAdded: event CarePlan.GoalAdded is {
        send goalAdded to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell goalAdded to entity CarePlanContext.CarePlan
      }
      on goalStatusUpdated: event CarePlan.GoalStatusUpdated is {
        send goalStatusUpdated to outlet CarePlanEventSplitToCareCoordinationAnalytics
        send goalStatusUpdated to outlet CarePlanEventSplitToToNotificationService
        tell goalStatusUpdated to entity CarePlanContext.CarePlan
      }
      on taskAdded: event CarePlan.TaskAdded is {
        send taskAdded to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell taskAdded to entity CarePlanContext.CarePlan
      }
      on taskCompleted: event CarePlan.TaskCompleted is {
        send taskCompleted to outlet CarePlanEventSplitToCareCoordinationAnalytics
        send taskCompleted to outlet CarePlanEventSplitToToNotificationService
        tell taskCompleted to entity CarePlanContext.CarePlan
      }
      on referralCreated: event CarePlan.ReferralCreated is {
        send referralCreated to outlet CarePlanEventSplitToCareCoordinationAnalytics
        send referralCreated to outlet CarePlanEventSplitToToReferralManagementService
        send referralCreated to outlet CarePlanEventSplitToToProviderDirectoryService
        tell referralCreated to entity CarePlanContext.CarePlan
      }
      on referralStatusUpdated: event CarePlan.ReferralStatusUpdated is {
        send referralStatusUpdated to outlet CarePlanEventSplitToCareCoordinationAnalytics
        send referralStatusUpdated to outlet CarePlanEventSplitToToNotificationService
        tell referralStatusUpdated to entity CarePlanContext.CarePlan
      }
      on carePlanActivated: event CarePlan.CarePlanActivated is {
        send carePlanActivated to outlet CarePlanEventSplitToCareCoordinationAnalytics
        send carePlanActivated to outlet CarePlanEventSplitToToNotificationService
        send carePlanActivated to outlet CarePlanEventSplitToToHIEService
        tell carePlanActivated to entity CarePlanContext.CarePlan
      }
      on carePlanCompleted: event CarePlan.CarePlanCompleted is {
        send carePlanCompleted to outlet CarePlanEventSplitToCareCoordinationAnalytics
        tell carePlanCompleted to entity CarePlanContext.CarePlan
      }
      on other is {
        error "Unexpected message for processor CarePlanEventSplit"
      }
    } with {
      briefly "CarePlan event fan-out handler"
      described as {
        |Delivers each CarePlan event to all of its consumers.
      }
    }
  } with {
    briefly "CarePlan event fan-out"
    described as {
      |Fans CarePlan events out to the repository and projectors.
    }
  }
  connector 'ToReferralManagementService Feed' is from outlet CarePlanContext.CarePlanEventSplit.CarePlanEventSplitToToReferralManagementService to inlet CarePlanContext.ToReferralManagementService.ToReferralManagementServiceIn with {
    briefly "The CarePlan events ToReferralManagementService translates, on their way to it"
  }
  connector 'ToProviderDirectoryService Feed' is from outlet CarePlanContext.CarePlanEventSplit.CarePlanEventSplitToToProviderDirectoryService to inlet CarePlanContext.ToProviderDirectoryService.ToProviderDirectoryServiceIn with {
    briefly "The CarePlan events ToProviderDirectoryService translates, on their way to it"
  }
  connector 'ToPatientService Feed' is from outlet CarePlanContext.CarePlanEventSplit.CarePlanEventSplitToToPatientService to inlet CarePlanContext.ToPatientService.ToPatientServiceIn with {
    briefly "The CarePlan events ToPatientService translates, on their way to it"
  }
  connector 'ToNotificationService Feed' is from outlet CarePlanContext.CarePlanEventSplit.CarePlanEventSplitToToNotificationService to inlet CarePlanContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The CarePlan events ToNotificationService translates, on their way to it"
  }
  connector 'ToHIEService Feed' is from outlet CarePlanContext.CarePlanEventSplit.CarePlanEventSplitToToHIEService to inlet CarePlanContext.ToHIEService.ToHIEServiceIn with {
    briefly "The CarePlan events ToHIEService translates, on their way to it"
  }
  connector 'CarePlanEvent Stream' is from outlet CarePlanContext.CarePlan.CarePlanEvents2 to inlet CarePlanContext.CarePlanEventSplit.CarePlanEventSplitIn with {
    briefly "CarePlan events, fanned out to storage and read models"
  }
  connector 'CareCoordinationAnalytics Feed' is from outlet CarePlanContext.CarePlanEventSplit.CarePlanEventSplitToCareCoordinationAnalytics to inlet CarePlanContext.CareCoordinationAnalytics.CareCoordinationAnalyticsFromCarePlan with {
    briefly "CarePlan events feeding the CareCoordinationAnalytics projection"
  }
  connector 'CareCoordinationAnalytics Storage' is from outlet CarePlanContext.CareCoordinationAnalytics.CareCoordinationAnalyticsToRepository to inlet CarePlanContext.CarePlanRepository.CarePlanRepositoryFromCareCoordinationAnalytics with {
    briefly "CareCoordinationAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for care coordination"
  described as {
    | The CarePlanContext is the bounded context for
    | care plans, referrals, and team coordination.
  }
}
