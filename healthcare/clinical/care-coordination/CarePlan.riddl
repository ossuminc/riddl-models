// Care Coordination - Care Plan Entity
entity CarePlan as flow is {
  type CarePlanCommand is one of {
    CarePlan.CreateCarePlan or CarePlan.AddCareTeamMember or CarePlan.RemoveCareTeamMember or CarePlan.AddGoal or CarePlan.UpdateGoalStatus or CarePlan.AddTask or CarePlan.CompleteTask or CarePlan.CreateReferral or CarePlan.UpdateReferralStatus or CarePlan.ActivateCarePlan or CarePlan.CompleteCarePlan
  } with {
    briefly "CarePlan command alternation"
    described as {
      |Commands accepted by the CarePlan entity.
    }
  }
  inlet CarePlanCommands is type CarePlanCommand  outlet CarePlanEvents2 is type CarePlanEvent
  // Commands
  command CreateCarePlan is {
    carePlanId: CarePlanId with {
      briefly "Plan ID"
      described as {
        |New care plan identifier.
      }
    }
    patientId: PatientId with {
      briefly "Patient"
      described as {
        |Patient identifier.
      }
    }
    conditions: Condition+ with {
      briefly "Conditions"
      described as {
        |Patient conditions.
      }
    }
    createdBy: ProviderId with {
      briefly "Created by"
      described as {
        |Creating provider.
      }
    }
  } with {
    briefly "Create care plan"
    described as {
      |Creates a new care plan.
    }
  }
  command AddCareTeamMember is {
    carePlanId: CarePlanId with {
      briefly "Plan ID"
      described as {
        |Care plan identifier.
      }
    }
    member: CareTeamMember with {
      briefly "Member"
      described as {
        |Team member to add.
      }
    }
  } with {
    briefly "Add team member"
    described as {
      |Adds care team member.
    }
  }
  command RemoveCareTeamMember is {
    carePlanId: CarePlanId with {
      briefly "Plan ID"
      described as {
        |Care plan identifier.
      }
    }
    providerId: ProviderId with {
      briefly "Provider"
      described as {
        |Member to remove.
      }
    }
  } with {
    briefly "Remove team member"
    described as {
      |Removes care team member.
    }
  }
  command AddGoal is {
    carePlanId: CarePlanId with {
      briefly "Plan ID"
      described as {
        |Care plan identifier.
      }
    }
    goal: CareGoal with {
      briefly "Goal"
      described as {
        |Care goal.
      }
    }
  } with {
    briefly "Add goal"
    described as {
      |Adds a care goal.
    }
  }
  command UpdateGoalStatus is {
    carePlanId: CarePlanId with {
      briefly "Plan ID"
      described as {
        |Care plan identifier.
      }
    }
    goalId: GoalId with {
      briefly "Goal"
      described as {
        |Goal identifier.
      }
    }
    goalStatus: GoalStatus with {
      briefly "Status"
      described as {
        |New status.
      }
    }
    progress: String(1,1000)? with {
      briefly "Progress"
      described as {
        |Progress notes.
      }
    }
  } with {
    briefly "Update goal"
    described as {
      |Updates goal status.
    }
  }
  command AddTask is {
    carePlanId: CarePlanId with {
      briefly "Plan ID"
      described as {
        |Care plan identifier.
      }
    }
    task: CareTask with {
      briefly "Task"
      described as {
        |Care task.
      }
    }
  } with {
    briefly "Add task"
    described as {
      |Adds a care task.
    }
  }
  command CompleteTask is {
    carePlanId: CarePlanId with {
      briefly "Plan ID"
      described as {
        |Care plan identifier.
      }
    }
    taskId: TaskId with {
      briefly "Task"
      described as {
        |Task identifier.
      }
    }
    completedBy: ProviderId with {
      briefly "Completed by"
      described as {
        |Completing provider.
      }
    }
  } with {
    briefly "Complete task"
    described as {
      |Marks task as complete.
    }
  }
  command CreateReferral is {
    carePlanId: CarePlanId with {
      briefly "Plan ID"
      described as {
        |Care plan identifier.
      }
    }
    referral: Referral with {
      briefly "Referral"
      described as {
        |Referral details.
      }
    }
  } with {
    briefly "Create referral"
    described as {
      |Creates a referral.
    }
  }
  command UpdateReferralStatus is {
    carePlanId: CarePlanId with {
      briefly "Plan ID"
      described as {
        |Care plan identifier.
      }
    }
    referralId: ReferralId with {
      briefly "Referral"
      described as {
        |Referral identifier.
      }
    }
    referralStatus: ReferralStatus with {
      briefly "Status"
      described as {
        |New status.
      }
    }
  } with {
    briefly "Update referral"
    described as {
      |Updates referral status.
    }
  }
  command ActivateCarePlan is {
    carePlanId: CarePlanId with {
      briefly "Plan ID"
      described as {
        |Care plan identifier.
      }
    }
  } with {
    briefly "Activate plan"
    described as {
      |Activates the care plan.
    }
  }
  command CompleteCarePlan is {
    carePlanId: CarePlanId with {
      briefly "Plan ID"
      described as {
        |Care plan identifier.
      }
    }
    outcome: String(1,500) with {
      briefly "Outcome"
      described as {
        |Plan outcome.
      }
    }
  } with {
    briefly "Complete plan"
    described as {
      |Completes the care plan.
    }
  }
  // Events
  event CarePlanCreated is {
    carePlanId: CarePlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    patientId: PatientId with {
      briefly "Patient"
      described as {
        |Patient ID.
      }
    }
    conditions: Condition+ with {
      briefly "Conditions"
      described as {
        |Patient conditions.
      }
    }
    createdBy: ProviderId with {
      briefly "Created by"
      described as {
        |Creator.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Plan created"
    described as {
      |Emitted when plan is created.
    }
  }
  event CareTeamMemberAdded is {
    carePlanId: CarePlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    member: CareTeamMember with {
      briefly "Member"
      described as {
        |Added member.
      }
    }
    addedAt: TimeStamp with {
      briefly "Added"
      described as {
        |Addition time.
      }
    }
  } with {
    briefly "Member added"
    described as {
      |Emitted when team member is added.
    }
  }
  event CareTeamMemberRemoved is {
    carePlanId: CarePlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    providerId: ProviderId with {
      briefly "Provider"
      described as {
        |Removed member.
      }
    }
    removedAt: TimeStamp with {
      briefly "Removed"
      described as {
        |Removal time.
      }
    }
  } with {
    briefly "Member removed"
    described as {
      |Emitted when team member is removed.
    }
  }
  event GoalAdded is {
    carePlanId: CarePlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    goal: CareGoal with {
      briefly "Goal"
      described as {
        |Added goal.
      }
    }
  } with {
    briefly "Goal added"
    described as {
      |Emitted when goal is added.
    }
  }
  event GoalStatusUpdated is {
    carePlanId: CarePlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    goalId: GoalId with {
      briefly "Goal"
      described as {
        |Goal ID.
      }
    }
    goalStatus: GoalStatus with {
      briefly "Status"
      described as {
        |New status.
      }
    }
    progress: String(1,1000)? with {
      briefly "Progress"
      described as {
        |Progress notes.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Goal updated"
    described as {
      |Emitted when goal status changes.
    }
  }
  event TaskAdded is {
    carePlanId: CarePlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    task: CareTask with {
      briefly "Task"
      described as {
        |Added task.
      }
    }
  } with {
    briefly "Task added"
    described as {
      |Emitted when task is added.
    }
  }
  event TaskCompleted is {
    carePlanId: CarePlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    taskId: TaskId with {
      briefly "Task"
      described as {
        |Task ID.
      }
    }
    completedBy: ProviderId with {
      briefly "Completed by"
      described as {
        |Completer.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Task completed"
    described as {
      |Emitted when task is completed.
    }
  }
  event ReferralCreated is {
    carePlanId: CarePlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    referral: Referral with {
      briefly "Referral"
      described as {
        |Created referral.
      }
    }
  } with {
    briefly "Referral created"
    described as {
      |Emitted when referral is created.
    }
  }
  event ReferralStatusUpdated is {
    carePlanId: CarePlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    referralId: ReferralId with {
      briefly "Referral"
      described as {
        |Referral ID.
      }
    }
    referralStatus: ReferralStatus with {
      briefly "Status"
      described as {
        |New status.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Referral updated"
    described as {
      |Emitted when referral status changes.
    }
  }
  event CarePlanActivated is {
    carePlanId: CarePlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    activatedAt: TimeStamp with {
      briefly "Activated"
      described as {
        |Activation time.
      }
    }
  } with {
    briefly "Plan activated"
    described as {
      |Emitted when plan is activated.
    }
  }
  event CarePlanCompleted is {
    carePlanId: CarePlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    outcome: String(1,500) with {
      briefly "Outcome"
      described as {
        |Plan outcome.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Plan completed"
    described as {
      |Emitted when plan is completed.
    }
  }
  // State Records
  record DraftStateData is {
    carePlanId: CarePlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    patientId: PatientId with {
      briefly "Patient"
      described as {
        |Patient ID.
      }
    }
    conditions: Condition+ with {
      briefly "Conditions"
      described as {
        |Patient conditions.
      }
    }
    draftCareTeam: CareTeamMember* with {
      briefly "Team"
      described as {
        |Care team.
      }
    }
    draftGoals: CareGoal* with {
      briefly "Goals"
      described as {
        |Care goals.
      }
    }
    tasks: CareTask* with {
      briefly "Tasks"
      described as {
        |Care tasks.
      }
    }
    referrals: Referral* with {
      briefly "Referrals"
      described as {
        |Referrals.
      }
    }
    planStatus: CarePlanStatus with {
      briefly "Status"
      described as {
        |Plan status.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Draft state"
    described as {
      |State for draft plan.
    }
  }
  record ActiveStateData is {
    carePlanId: CarePlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    patientId: PatientId with {
      briefly "Patient"
      described as {
        |Patient ID.
      }
    }
    conditions: Condition+ with {
      briefly "Conditions"
      described as {
        |Patient conditions.
      }
    }
    activeCareTeam: CareTeamMember+ with {
      briefly "Team"
      described as {
        |Care team.
      }
    }
    activeGoals: CareGoal+ with {
      briefly "Goals"
      described as {
        |Care goals.
      }
    }
    tasks: CareTask* with {
      briefly "Tasks"
      described as {
        |Care tasks.
      }
    }
    referrals: Referral* with {
      briefly "Referrals"
      described as {
        |Referrals.
      }
    }
    planStatus: CarePlanStatus with {
      briefly "Status"
      described as {
        |Plan status.
      }
    }
    activatedAt: TimeStamp with {
      briefly "Activated"
      described as {
        |Activation time.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |State for active plan.
    }
  }
  record CompletedStateData is {
    carePlanId: CarePlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    patientId: PatientId with {
      briefly "Patient"
      described as {
        |Patient ID.
      }
    }
    outcome: String(1,500) with {
      briefly "Outcome"
      described as {
        |Plan outcome.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Completed state"
    described as {
      |State for completed plan.
    }
  }
  // Queries
  query GetCarePlan replies result CarePlanResult is {
    carePlanId: CarePlanId with {
      briefly "Plan ID"
      described as {
        |Care plan to retrieve.
      }
    }
  } with {
    briefly "Get care plan"
    described as {
      |Retrieves care plan data.
    }
  }
  result CarePlanResult is {
    carePlanId: CarePlanId with {
      briefly "Plan ID"
      described as {
        |Care plan identifier.
      }
    }
    patientId: PatientId with {
      briefly "Patient"
      described as {
        |Patient identifier.
      }
    }
    planStatus: CarePlanStatus with {
      briefly "Status"
      described as {
        |Current plan status.
      }
    }
  } with {
    briefly "Care plan result"
    described as {
      |Care plan data result.
    }
  }
  // Initialize command for streamlet
  // States
  initial state DraftState of record CarePlan.DraftStateData is {
    initial handler DraftStateInitHandler is {
      on init is {
        set state DraftState to "initialize from prior event"
      }
    } with {
      briefly "Draft state init handler"
      described as {
        |Initializes the Draft state.
      }
    }
  } with {
    briefly "Draft state"
    described as {
      |State for a draft care plan.
    }
  }
  state ActiveState of record CarePlan.ActiveStateData is {
    initial handler ActiveStateInitHandler is {
      on init is {
        set state ActiveState to "initialize from prior event"
      }
    } with {
      briefly "Active state init handler"
      described as {
        |Initializes the Active state.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |State for an active care plan.
    }
  }
  state CompletedState of record CarePlan.CompletedStateData is {
    initial handler CompletedStateInitHandler is {
      on init is {
        set state CompletedState to "initialize from prior event"
      }
    } with {
      briefly "Completed state init handler"
      described as {
        |Initializes the Completed state.
      }
    }
  } with {
    briefly "Completed state"
    described as {
      |Terminal state for a completed care plan.
    }
  }
  // Handler
  handler CarePlanHandler is {
    on createCarePlan: command CreateCarePlan is {
      morph entity CarePlanContext.CarePlan to state CarePlanContext.CarePlan.DraftState with record CarePlan.DraftStateData(carePlanId = createCarePlan.carePlanId, patientId = createCarePlan.patientId, conditions = createCarePlan.conditions, draftCareTeam = empty, draftGoals = empty, tasks = empty, referrals = empty, planStatus = prompt("the plan status of this draft state data"), createdAt = prompt("the created at of this draft state data"))
      tell event CarePlanCreated(carePlanId = createCarePlan.carePlanId, patientId = createCarePlan.patientId, conditions = createCarePlan.conditions, createdBy = createCarePlan.createdBy, createdAt = prompt("the created at of this care plan created")) to entity CarePlanContext.CarePlan
    }
    on addCareTeamMember: command AddCareTeamMember is {
      tell event CareTeamMemberAdded(carePlanId = addCareTeamMember.carePlanId, member = addCareTeamMember.member, addedAt = prompt("the added at of this care team member added")) to entity CarePlanContext.CarePlan
    }
    on removeCareTeamMember: command RemoveCareTeamMember is {
      tell event CareTeamMemberRemoved(carePlanId = removeCareTeamMember.carePlanId, providerId = removeCareTeamMember.providerId, removedAt = prompt("the removed at of this care team member removed")) to entity CarePlanContext.CarePlan
    }
    on addGoal: command AddGoal is {
      tell event GoalAdded(carePlanId = addGoal.carePlanId, goal = addGoal.goal) to entity CarePlanContext.CarePlan
    }
    on updateGoalStatus: command UpdateGoalStatus is {
      tell event GoalStatusUpdated(carePlanId = updateGoalStatus.carePlanId, goalId = updateGoalStatus.goalId, goalStatus = updateGoalStatus.goalStatus, progress = updateGoalStatus.progress, updatedAt = prompt("the updated at of this goal status updated")) to entity CarePlanContext.CarePlan
    }
    on addTask: command AddTask is {
      tell event TaskAdded(carePlanId = addTask.carePlanId, task = addTask.task) to entity CarePlanContext.CarePlan
    }
    on completeTask: command CompleteTask is {
      tell event TaskCompleted(carePlanId = completeTask.carePlanId, taskId = completeTask.taskId, completedBy = completeTask.completedBy, completedAt = prompt("the completed at of this task completed")) to entity CarePlanContext.CarePlan
    }
    on createReferral: command CreateReferral is {
      tell event ReferralCreated(carePlanId = createReferral.carePlanId, referral = createReferral.referral) to entity CarePlanContext.CarePlan
    }
    on updateReferralStatus: command UpdateReferralStatus is {
      tell event ReferralStatusUpdated(carePlanId = updateReferralStatus.carePlanId, referralId = updateReferralStatus.referralId, referralStatus = updateReferralStatus.referralStatus, updatedAt = prompt("the updated at of this referral status updated")) to entity CarePlanContext.CarePlan
    }
    on activateCarePlan: command ActivateCarePlan is {
      morph entity CarePlanContext.CarePlan to state CarePlanContext.CarePlan.ActiveState with record CarePlan.ActiveStateData(carePlanId = activateCarePlan.carePlanId, patientId = prompt("the patient id of this active state data"), conditions = prompt("the conditions of this active state data"), activeCareTeam = prompt("the active care team of this active state data"), activeGoals = prompt("the active goals of this active state data"), tasks = empty, referrals = empty, planStatus = prompt("the plan status of this active state data"), activatedAt = prompt("the activated at of this active state data"))
      tell event CarePlanActivated(carePlanId = activateCarePlan.carePlanId, activatedAt = prompt("the activated at of this care plan activated")) to entity CarePlanContext.CarePlan
    }
    on completeCarePlan: command CompleteCarePlan is {
      morph entity CarePlanContext.CarePlan to state CarePlanContext.CarePlan.CompletedState with record CarePlan.CompletedStateData(carePlanId = completeCarePlan.carePlanId, outcome = completeCarePlan.outcome, patientId = prompt("the patient id of this completed state data"), completedAt = prompt("the completed at of this completed state data"))
      tell event CarePlanCompleted(carePlanId = completeCarePlan.carePlanId, outcome = completeCarePlan.outcome, completedAt = prompt("the completed at of this care plan completed")) to entity CarePlanContext.CarePlan
    }
    on getCarePlan: query GetCarePlan is {
      reply result CarePlanResult(carePlanId = getCarePlan.carePlanId, patientId = prompt("the patient id of this care plan result"), planStatus = prompt("the plan status of this care plan result"))
    }
    on carePlanActivated: event CarePlanActivated is {
      do "apply CarePlanActivated to the carePlan so it can be persisted and replayed"
    }
    on carePlanCompleted: event CarePlanCompleted is {
      do "apply CarePlanCompleted to the carePlan so it can be persisted and replayed"
    }
    on carePlanCreated: event CarePlanCreated is {
      do "apply CarePlanCreated to the carePlan so it can be persisted and replayed"
    }
    on careTeamMemberAdded: event CareTeamMemberAdded is {
      do "apply CareTeamMemberAdded to the carePlan so it can be persisted and replayed"
    }
    on careTeamMemberRemoved: event CareTeamMemberRemoved is {
      do "apply CareTeamMemberRemoved to the carePlan so it can be persisted and replayed"
    }
    on goalAdded: event GoalAdded is {
      do "apply GoalAdded to the carePlan so it can be persisted and replayed"
    }
    on goalStatusUpdated: event GoalStatusUpdated is {
      do "apply GoalStatusUpdated to the carePlan so it can be persisted and replayed"
    }
    on referralCreated: event ReferralCreated is {
      do "apply ReferralCreated to the carePlan so it can be persisted and replayed"
    }
    on referralStatusUpdated: event ReferralStatusUpdated is {
      do "apply ReferralStatusUpdated to the carePlan so it can be persisted and replayed"
    }
    on taskAdded: event TaskAdded is {
      do "apply TaskAdded to the carePlan so it can be persisted and replayed"
    }
    on taskCompleted: event TaskCompleted is {
      do "apply TaskCompleted to the carePlan so it can be persisted and replayed"
    }
  } with {
    briefly "Processes care plan commands"
    described as {
      | Handles care plan lifecycle including team
      | management, goals, tasks, and referrals.
    }
  }
} with {
  briefly "Care plan aggregate"
  described as {
    | The CarePlan entity manages coordinated care
    | including care teams, goals, tasks, and referrals.
  }
}
