// Care Coordination Domain Model
// Multi-provider care plans and referral management
domain CareCoordination is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user CareCoordinator is "person managing patient care plans" with {
    briefly "Care Coordinator"
    described as {
      |Person coordinating multi-provider care.
    }
  }
  user PrimaryCareProvider is "patient's primary physician" with {
    briefly "PCP"
    described as {
      |Primary care physician.
    }
  }
  user SpecialistPhysician is "specialist physician" with {
    briefly "Specialist"
    described as {
      |Specialist receiving referrals.
    }
  }
  epic CareCoordinationEpic is {
    user CareCoordinator wants to "to manage complex patient care" so that "care is well-coordinated"
    case CreateCarePlanUseCase is {
      user CareCoordinator wants to "to create a care plan" so that "patient care is organized"
      step is "Coordinator reviews" "patient conditions" "and history" with {
        briefly "Review"
        described as {
          |Assess patient.
        }
      }
      step is "Coordinator identifies" "care team members" "and goals" with {
        briefly "Identify team"
        described as {
          |Build care team.
        }
      }
      step take input CareCoordinationApp.CareCoordinationScreen.CreateCarePlanInput from user CareCoordinator with {
        briefly "Create"
        described as {
          |Create plan.
        }
      }
      step is "System notifies" "care team" "of new plan" with {
        briefly "Notify"
        described as {
          |Alert team.
        }
      }
    } with {
      briefly "Care plan creation"
      described as {
        |Creating coordinated care plans.
      }
    }
  } with {
    briefly "Care coordination"
    described as {
      | Epic covering care plan creation, referral
      | management, and multi-provider coordination.
    }
  }
  include "CarePlanContext.riddl"
  include "external-contexts.riddl"
  application context CareCoordinationApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CareCoordination are delivered.
      }
    }
    group CareCoordinationScreen is {
      input CreateCarePlanInput acquires command CarePlanContext.CarePlan.CreateCarePlan with {
        briefly "Create care plan control"
        described as {
          |The control through which a user submits the create care plan request.
        }
      }
    } with {
      briefly "Care coordination screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppCarePlanCommands is type CarePlanContext.CarePlan.CarePlanCommand
    inlet AppCarePlanRepositoryResponses is type CarePlanContext.CarePlan.CarePlanResult    handler CareCoordinationAppHandler is {
      on other is {
        error "Unexpected message for application context CareCoordinationApp"
      }
    } with {
      briefly "CareCoordinationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CareCoordinationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector CarePlanCommandStream is from outlet CareCoordinationApp.AppCarePlanCommands to inlet CarePlanContext.CarePlan.CarePlanCommands with {
    option persistent()
    briefly "CarePlan commands from the application"
  }
  connector CarePlanQueryResults is from outlet CarePlanContext.CarePlanRepository.CarePlanRepositoryResponses to inlet CareCoordinationApp.AppCarePlanRepositoryResponses with {
    option persistent()
    briefly "CarePlan query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CareCoordinationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Care coordination domain"
  described as {
    | The CareCoordination domain handles care plans,
    | referrals, and multi-provider care coordination.
  }
}
