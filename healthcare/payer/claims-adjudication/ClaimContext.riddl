// Claims Adjudication - Claim Context
context ClaimContext is {
  adaptor FromAuthorizationService from context AuthorizationService is { 
    handler FromAuthorizationServiceHandler is {
      on result AuthorizationService.AuthorizationResult is {
        do "the model receives authorization result"
      }
      on other is {
        error "Unexpected message for adaptor FromAuthorizationService"
      }
    } with {
      briefly "from authorization service"
      described as {
        |Carries messages from the external AuthorizationService.
      }
    }
  } with {
    briefly "AuthorizationService integration"
    described as {
      |The model's side of the AuthorizationService conversation.
    }
  }
  adaptor ToAuthorizationService to context AuthorizationService is { 
    handler ToAuthorizationServiceHandler is {
      on query AuthorizationService.CheckAuthorization is {
        do "the model sends check authorization"
      }
      on other is {
        error "Unexpected message for adaptor ToAuthorizationService"
      }
    } with {
      briefly "to authorization service"
      described as {
        |Carries messages to the external AuthorizationService.
      }
    }
  } with {
    briefly "AuthorizationService integration"
    described as {
      |The model's side of the AuthorizationService conversation.
    }
  }
  adaptor FromBenefitsService from context BenefitsService is { 
    handler FromBenefitsServiceHandler is {
      on result BenefitsService.BenefitInfo is {
        do "the model receives benefit info"
      }
      on other is {
        error "Unexpected message for adaptor FromBenefitsService"
      }
    } with {
      briefly "from benefits service"
      described as {
        |Carries messages from the external BenefitsService.
      }
    }
  } with {
    briefly "BenefitsService integration"
    described as {
      |The model's side of the BenefitsService conversation.
    }
  }
  adaptor ToBenefitsService to context BenefitsService is { 
    handler ToBenefitsServiceHandler is {
      on query BenefitsService.GetBenefits is {
        do "the model sends get benefits"
      }
      on other is {
        error "Unexpected message for adaptor ToBenefitsService"
      }
    } with {
      briefly "to benefits service"
      described as {
        |Carries messages to the external BenefitsService.
      }
    }
  } with {
    briefly "BenefitsService integration"
    described as {
      |The model's side of the BenefitsService conversation.
    }
  }
  adaptor FromEligibilityService from context EligibilityService is { 
    handler FromEligibilityServiceHandler is {
      on result EligibilityService.EligibilityResult is {
        do "the model receives eligibility result"
      }
      on other is {
        error "Unexpected message for adaptor FromEligibilityService"
      }
    } with {
      briefly "from eligibility service"
      described as {
        |Carries messages from the external EligibilityService.
      }
    }
  } with {
    briefly "EligibilityService integration"
    described as {
      |The model's side of the EligibilityService conversation.
    }
  }
  adaptor ToEligibilityService to context EligibilityService is { 
    handler ToEligibilityServiceHandler is {
      on query EligibilityService.CheckEligibility is {
        do "the model sends check eligibility"
      }
      on other is {
        error "Unexpected message for adaptor ToEligibilityService"
      }
    } with {
      briefly "to eligibility service"
      described as {
        |Carries messages to the external EligibilityService.
      }
    }
  } with {
    briefly "EligibilityService integration"
    described as {
      |The model's side of the EligibilityService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendClaimNotification is {
        do "the model sends send claim notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentService from context PaymentService is { 
    handler FromPaymentServiceHandler is {
      on event PaymentService.PaymentIssued is {
        do "the model receives payment issued"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentService"
      }
    } with {
      briefly "from payment service"
      described as {
        |Carries messages from the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor ToPaymentService to context PaymentService is { 
    handler ToPaymentServiceHandler is {
      on command PaymentService.IssuePayment is {
        do "the model sends issue payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentService"
      }
    } with {
      briefly "to payment service"
      described as {
        |Carries messages to the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor FromProviderContractService from context ProviderContractService is { 
    handler FromProviderContractServiceHandler is {
      on result ProviderContractService.ContractRates is {
        do "the model receives contract rates"
      }
      on other is {
        error "Unexpected message for adaptor FromProviderContractService"
      }
    } with {
      briefly "from provider contract service"
      described as {
        |Carries messages from the external ProviderContractService.
      }
    }
  } with {
    briefly "ProviderContractService integration"
    described as {
      |The model's side of the ProviderContractService conversation.
    }
  }
  adaptor ToProviderContractService to context ProviderContractService is { 
    handler ToProviderContractServiceHandler is {
      on query ProviderContractService.GetContractRates is {
        do "the model sends get contract rates"
      }
      on other is {
        error "Unexpected message for adaptor ToProviderContractService"
      }
    } with {
      briefly "to provider contract service"
      described as {
        |Carries messages to the external ProviderContractService.
      }
    }
  } with {
    briefly "ProviderContractService integration"
    described as {
      |The model's side of the ProviderContractService conversation.
    }
  }
  include "types.riddl"
  include "Claim.riddl"
  // Repository for claim persistence
  repository ClaimRepository as merge is {
    inlet ClaimRepositoryFromClaim is type ClaimEvent    inlet ClaimRepositoryFromClaimsAnalytics is type ClaimEvent    outlet ClaimRepositoryResponses is type Claim.ClaimResult
    record StoredClaim is  {
      claimId: ClaimId with {
        briefly "claimId"
        described as {
          |The claimId column of the stored claim row.
        }
      }
      member: MemberInfo with {
        briefly "member"
        described as {
          |The member column of the stored claim row.
        }
      }
      provider: ProviderInfo with {
        briefly "provider"
        described as {
          |The provider column of the stored claim row.
        }
      }
    } with {
      briefly "Stored claim row"
      described as {
        |The persistence shape of claim data as this repository stores it.
      }
    }
    schema ClaimData is relational
      of claims as type StoredClaim
        index on field StoredClaim.claimId
        index on field StoredClaim.member.memberId
        index on field StoredClaim.provider.providerId
 with {
      briefly "Claim data schema"
      described as {
        |The relational schema holding claim data for the ClaimRepository.
      }
    }
    handler ClaimPersistence is {
      on query GetClaimsStats is {
        do "read the claims stats projection"
        reply result ClaimsStatsView
      }
      on submitClaim: command Claim.SubmitClaim is {
        tell event Claim.ClaimSubmitted(claimId = submitClaim.claimId, member = submitClaim.member, provider = submitClaim.provider, header = submitClaim.header) to entity ClaimContext.Claim
        do "Store new claim"
      }
      on command Claim.AdjudicateClaim is {
        do "Update adjudication"
      }
      on command Claim.PendClaim is {
        do "Update claim to pended"
      }
      on command Claim.ResolvePend is {
        do "Update pend resolution"
      }
      on approveClaim: command Claim.ApproveClaim is {
        tell event Claim.ClaimApproved(claimId = approveClaim.claimId, payment = approveClaim.payment) to entity ClaimContext.Claim
        do "Update claim to approved"
      }
      on command Claim.DenyClaim is {
        do "Update claim to denied"
      }
      on command Claim.PayClaim is {
        do "Update payment record"
      }
      on command Claim.AppealClaim is {
        do "Store appeal"
      }
      on command Claim.ResolveAppeal is {
        do "Update appeal resolution"
      }
      on command Claim.VoidClaim is {
        do "Update claim to voided"
      }
    } with {
      briefly "Persists claim commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Claim data persistence"
    described as {
      | The ClaimRepository provides persistent storage for
      | claims, adjudication, and payment history.
    }
  }
  // Projector for claims analytics
  query GetClaimsStats is  {
    claimsStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which claims stats to retrieve.
      }
    }
  } with {
    briefly "Get claims stats"
    described as {
      |Retrieves the claims stats projection.
    }
  }
  result ClaimsStatsView is  {
    claimsStats: ClaimsAnalytics.ClaimsStats with {
      briefly "Claims stats"
      described as {
        |The claims stats being returned.
      }
    }
  } with {
    briefly "Claims stats view"
    described as {
      |Read model view carrying the claims stats projection.
    }
  }
  projector ClaimsAnalytics as flow is {
    updates repository ClaimContext.ClaimRepository
    inlet ClaimsAnalyticsFromClaim is type ClaimEvent    outlet ClaimsAnalyticsOut is type ClaimEvent
    record ClaimsStats is  {
      totalClaims: Natural with {
        briefly "Total"
        described as {
          |Total claims.
        }
      }
      totalPaid: Decimal(18,2) with {
        briefly "Paid"
        described as {
          |Total paid.
        }
      }
      approvalRate: Decimal(5,4) with {
        briefly "Approval"
        described as {
          |Approval rate.
        }
      }
      denialRate: Decimal(5,4) with {
        briefly "Denial"
        described as {
          |Denial rate.
        }
      }
      avgProcessingTime: Duration with {
        briefly "Avg time"
        described as {
          |Average processing time.
        }
      }
      pendRate: Decimal(5,4) with {
        briefly "Pend rate"
        described as {
          |Pend rate.
        }
      }
    } with {
      briefly "Claims statistics"
      described as {
        |Claims processing metrics.
      }
    }
    handler AnalyticsHandler is {
      on claimSubmitted: event Claim.ClaimSubmitted is {
        tell claimSubmitted to repository ClaimContext.ClaimRepository
        do "Update claim counts"
      }
      on claimApproved: event Claim.ClaimApproved is {
        tell claimApproved to repository ClaimContext.ClaimRepository
        do "Update approval metrics"
      }
      on claimDenied: event Claim.ClaimDenied is {
        tell claimDenied to repository ClaimContext.ClaimRepository
        do "Update denial metrics"
      }
      on claimPaid: event Claim.ClaimPaid is {
        tell claimPaid to repository ClaimContext.ClaimRepository
        do "Update payment metrics"
      }
    } with {
      briefly "Maintains claims analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Claims analytics projections"
    described as {
      |Maintains claims adjudication analytics data.
    }
  }
  // ---- Event publication for Claim ----
  type ClaimEvent is one of {
    ClaimContext.Claim.ClaimSubmitted or ClaimContext.Claim.ClaimAdjudicated or ClaimContext.Claim.ClaimPended or ClaimContext.Claim.PendResolved or ClaimContext.Claim.ClaimApproved or ClaimContext.Claim.ClaimDenied or ClaimContext.Claim.ClaimPaid or ClaimContext.Claim.ClaimAppealed or ClaimContext.Claim.AppealResolved or ClaimContext.Claim.ClaimVoided
  } with {
    briefly "Claim event alternation"
    described as {
      |Union of all Claim events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ClaimEventSource as source is {
    outlet ClaimEvents is type ClaimEvent
    handler ClaimSourceHandler is {
      on claimSubmitted: event Claim.ClaimSubmitted is {
        send claimSubmitted to outlet ClaimEvents
      }
      on claimAdjudicated: event Claim.ClaimAdjudicated is {
        send claimAdjudicated to outlet ClaimEvents
      }
      on claimPended: event Claim.ClaimPended is {
        send claimPended to outlet ClaimEvents
      }
      on pendResolved: event Claim.PendResolved is {
        send pendResolved to outlet ClaimEvents
      }
      on claimApproved: event Claim.ClaimApproved is {
        send claimApproved to outlet ClaimEvents
      }
      on claimDenied: event Claim.ClaimDenied is {
        send claimDenied to outlet ClaimEvents
      }
      on claimPaid: event Claim.ClaimPaid is {
        send claimPaid to outlet ClaimEvents
      }
      on claimAppealed: event Claim.ClaimAppealed is {
        send claimAppealed to outlet ClaimEvents
      }
      on appealResolved: event Claim.AppealResolved is {
        send appealResolved to outlet ClaimEvents
      }
      on claimVoided: event Claim.ClaimVoided is {
        send claimVoided to outlet ClaimEvents
      }
      on other is {
        error "Unexpected message for source ClaimEventSource"
      }
    } with {
      briefly "Claim source handler"
      described as {
        |Publishes Claim events onto the outlet.
      }
    }
  } with {
    briefly "Claim event source"
    described as {
      |Publishes Claim entity events into the streaming topology.
    }
  }
  processor ClaimEventSink as sink is {
    inlet ClaimInlet is type ClaimEvent    handler ClaimSinkHandler is {
      on claimSubmitted: event Claim.ClaimSubmitted is {
        tell claimSubmitted to repository ClaimContext.ClaimRepository
      }
      on claimAdjudicated: event Claim.ClaimAdjudicated is {
        tell claimAdjudicated to repository ClaimContext.ClaimRepository
      }
      on claimPended: event Claim.ClaimPended is {
        tell claimPended to repository ClaimContext.ClaimRepository
      }
      on pendResolved: event Claim.PendResolved is {
        tell pendResolved to repository ClaimContext.ClaimRepository
      }
      on claimApproved: event Claim.ClaimApproved is {
        tell claimApproved to repository ClaimContext.ClaimRepository
      }
      on claimDenied: event Claim.ClaimDenied is {
        tell claimDenied to repository ClaimContext.ClaimRepository
      }
      on claimPaid: event Claim.ClaimPaid is {
        tell claimPaid to repository ClaimContext.ClaimRepository
      }
      on claimAppealed: event Claim.ClaimAppealed is {
        tell claimAppealed to repository ClaimContext.ClaimRepository
      }
      on appealResolved: event Claim.AppealResolved is {
        tell appealResolved to repository ClaimContext.ClaimRepository
      }
      on claimVoided: event Claim.ClaimVoided is {
        tell claimVoided to repository ClaimContext.ClaimRepository
      }
      on other is {
        error "Unexpected message for sink ClaimEventSink"
      }
    } with {
      briefly "Claim sink handler"
      described as {
        |Persists Claim events via the repository.
      }
    }
  } with {
    briefly "Claim event sink"
    described as {
      |Receives Claim events for persistence.
    }
  }
  connector ClaimEventFlow is from outlet ClaimContext.ClaimEventSource.ClaimEvents to inlet ClaimContext.ClaimEventSink.ClaimInlet with {
    briefly "Claim event flow"
    described as {
      |Connects the Claim source to its sink.
    }
  }
  processor ClaimEventSplit as split is {
    inlet ClaimEventSplitIn is type ClaimEvent    outlet ClaimEventSplitToClaimRepository is type ClaimEvent
    outlet ClaimEventSplitToClaimsAnalytics is type ClaimEvent
    handler ClaimEventSplitHandler is {
      on claimSubmitted: event Claim.ClaimSubmitted is {
        send claimSubmitted to outlet ClaimEventSplitToClaimRepository
        send claimSubmitted to outlet ClaimEventSplitToClaimsAnalytics
        tell claimSubmitted to entity ClaimContext.Claim
      }
      on claimAdjudicated: event Claim.ClaimAdjudicated is {
        send claimAdjudicated to outlet ClaimEventSplitToClaimRepository
        send claimAdjudicated to outlet ClaimEventSplitToClaimsAnalytics
        tell claimAdjudicated to entity ClaimContext.Claim
      }
      on claimPended: event Claim.ClaimPended is {
        send claimPended to outlet ClaimEventSplitToClaimRepository
        send claimPended to outlet ClaimEventSplitToClaimsAnalytics
        tell claimPended to entity ClaimContext.Claim
      }
      on pendResolved: event Claim.PendResolved is {
        send pendResolved to outlet ClaimEventSplitToClaimRepository
        send pendResolved to outlet ClaimEventSplitToClaimsAnalytics
        tell pendResolved to entity ClaimContext.Claim
      }
      on claimApproved: event Claim.ClaimApproved is {
        send claimApproved to outlet ClaimEventSplitToClaimRepository
        send claimApproved to outlet ClaimEventSplitToClaimsAnalytics
        tell claimApproved to entity ClaimContext.Claim
      }
      on claimDenied: event Claim.ClaimDenied is {
        send claimDenied to outlet ClaimEventSplitToClaimRepository
        send claimDenied to outlet ClaimEventSplitToClaimsAnalytics
        tell claimDenied to entity ClaimContext.Claim
      }
      on claimPaid: event Claim.ClaimPaid is {
        send claimPaid to outlet ClaimEventSplitToClaimRepository
        send claimPaid to outlet ClaimEventSplitToClaimsAnalytics
        tell claimPaid to entity ClaimContext.Claim
      }
      on claimAppealed: event Claim.ClaimAppealed is {
        send claimAppealed to outlet ClaimEventSplitToClaimRepository
        send claimAppealed to outlet ClaimEventSplitToClaimsAnalytics
        tell claimAppealed to entity ClaimContext.Claim
      }
      on appealResolved: event Claim.AppealResolved is {
        send appealResolved to outlet ClaimEventSplitToClaimRepository
        send appealResolved to outlet ClaimEventSplitToClaimsAnalytics
        tell appealResolved to entity ClaimContext.Claim
      }
      on claimVoided: event Claim.ClaimVoided is {
        send claimVoided to outlet ClaimEventSplitToClaimRepository
        send claimVoided to outlet ClaimEventSplitToClaimsAnalytics
        tell claimVoided to entity ClaimContext.Claim
      }
      on other is {
        error "Unexpected message for processor ClaimEventSplit"
      }
    } with {
      briefly "Claim event fan-out handler"
      described as {
        |Delivers each Claim event to all of its consumers.
      }
    }
  } with {
    briefly "Claim event fan-out"
    described as {
      |Fans Claim events out to the repository and projectors.
    }
  }
  connector 'ClaimEvent Stream' is from outlet ClaimContext.Claim.ClaimEvents2 to inlet ClaimContext.ClaimEventSplit.ClaimEventSplitIn with {
    briefly "Claim events, fanned out to storage and read models"
  }
  connector 'ClaimEvent Storage' is from outlet ClaimContext.ClaimEventSplit.ClaimEventSplitToClaimRepository to inlet ClaimContext.ClaimRepository.ClaimRepositoryFromClaim with {
    briefly "Claim events on their way to storage"
  }
  connector 'ClaimsAnalytics Feed' is from outlet ClaimContext.ClaimEventSplit.ClaimEventSplitToClaimsAnalytics to inlet ClaimContext.ClaimsAnalytics.ClaimsAnalyticsFromClaim with {
    briefly "Claim events feeding the ClaimsAnalytics projection"
  }
  connector 'ClaimsAnalytics Storage' is from outlet ClaimContext.ClaimsAnalytics.ClaimsAnalyticsOut to inlet ClaimContext.ClaimRepository.ClaimRepositoryFromClaimsAnalytics with {
    briefly "The ClaimsAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for claims adjudication"
  described as {
    | The ClaimContext is the bounded context for
    | insurance claims processing and payment.
  }
}
