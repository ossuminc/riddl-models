// Claims Adjudication - Claim Context
context ClaimContext is {
  include "types.riddl"
  include "Claim.riddl"
  // Repository for claim persistence
  repository ClaimRepository is {
    schema ClaimData is relational
      of claims as type Claim
        index on field Claim.claimId
        index on field Claim.member.memberId
        index on field Claim.provider.providerId

    handler ClaimPersistence is {
      on command Claim.SubmitClaim is {
        tell event Claim.ClaimSubmitted to entity ClaimContext.Claim
        prompt "Store new claim"
      }
      on command Claim.AdjudicateClaim is {
        prompt "Update adjudication"
      }
      on command Claim.PendClaim is {
        prompt "Update claim to pended"
      }
      on command Claim.ResolvePend is {
        prompt "Update pend resolution"
      }
      on command Claim.ApproveClaim is {
        tell event Claim.ClaimApproved to entity ClaimContext.Claim
        prompt "Update claim to approved"
      }
      on command Claim.DenyClaim is {
        prompt "Update claim to denied"
      }
      on command Claim.PayClaim is {
        prompt "Update payment record"
      }
      on command Claim.AppealClaim is {
        prompt "Store appeal"
      }
      on command Claim.ResolveAppeal is {
        prompt "Update appeal resolution"
      }
      on command Claim.VoidClaim is {
        prompt "Update claim to voided"
      }
    } with {
      briefly "Persists claim commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Claim data persistence"
    described as {
      | The ClaimRepository provides persistent storage for
      | claims, adjudication, and payment history.
    }
  }
  // Projector for claims analytics
  projector ClaimsAnalytics is {
    updates repository ClaimContext.ClaimRepository
    record ClaimsStats is  {
      totalClaims: Natural with {
        briefly "Total"
        described as {
          |Total claims.
        }
      }
      totalPaid: Decimal(18,2) with {
        briefly "Paid"
        described as {
          |Total paid.
        }
      }
      approvalRate: Decimal(5,4) with {
        briefly "Approval"
        described as {
          |Approval rate.
        }
      }
      denialRate: Decimal(5,4) with {
        briefly "Denial"
        described as {
          |Denial rate.
        }
      }
      avgProcessingTime: Duration with {
        briefly "Avg time"
        described as {
          |Average processing time.
        }
      }
      pendRate: Decimal(5,4) with {
        briefly "Pend rate"
        described as {
          |Pend rate.
        }
      }
    } with {
      briefly "Claims statistics"
      described as {
        |Claims processing metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Claim.ClaimSubmitted is {
        tell event Claim.ClaimSubmitted to repository ClaimContext.ClaimRepository
        prompt "Update claim counts"
      }
      on event Claim.ClaimApproved is {
        tell event Claim.ClaimApproved to repository ClaimContext.ClaimRepository
        prompt "Update approval metrics"
      }
      on event Claim.ClaimDenied is {
        tell event Claim.ClaimDenied to repository ClaimContext.ClaimRepository
        prompt "Update denial metrics"
      }
      on event Claim.ClaimPaid is {
        tell event Claim.ClaimPaid to repository ClaimContext.ClaimRepository
        prompt "Update payment metrics"
      }
    } with {
      briefly "Maintains claims analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Claims analytics projections"
    described as {
      |Maintains claims adjudication analytics data.
    }
  }
  // ---- Event publication for Claim ----
  type ClaimEvent is one of {
    ClaimContext.Claim.ClaimSubmitted,
    ClaimContext.Claim.ClaimAdjudicated,
    ClaimContext.Claim.ClaimPended,
    ClaimContext.Claim.PendResolved,
    ClaimContext.Claim.ClaimApproved,
    ClaimContext.Claim.ClaimDenied,
    ClaimContext.Claim.ClaimPaid,
    ClaimContext.Claim.ClaimAppealed,
    ClaimContext.Claim.AppealResolved,
    ClaimContext.Claim.ClaimVoided
  } with {
    briefly "Claim event alternation"
    described as {
      |Union of all Claim events, for streaming and event-sourced
      |persistence.
    }
  }
  source ClaimEventSource is {
    outlet ClaimEvents is type ClaimEvent
    handler ClaimSourceHandler is {
      on event Claim.ClaimSubmitted is {
        send event Claim.ClaimSubmitted to outlet ClaimEvents
      }
      on event Claim.ClaimAdjudicated is {
        send event Claim.ClaimAdjudicated to outlet ClaimEvents
      }
      on event Claim.ClaimPended is {
        send event Claim.ClaimPended to outlet ClaimEvents
      }
      on event Claim.PendResolved is {
        send event Claim.PendResolved to outlet ClaimEvents
      }
      on event Claim.ClaimApproved is {
        send event Claim.ClaimApproved to outlet ClaimEvents
      }
      on event Claim.ClaimDenied is {
        send event Claim.ClaimDenied to outlet ClaimEvents
      }
      on event Claim.ClaimPaid is {
        send event Claim.ClaimPaid to outlet ClaimEvents
      }
      on event Claim.ClaimAppealed is {
        send event Claim.ClaimAppealed to outlet ClaimEvents
      }
      on event Claim.AppealResolved is {
        send event Claim.AppealResolved to outlet ClaimEvents
      }
      on event Claim.ClaimVoided is {
        send event Claim.ClaimVoided to outlet ClaimEvents
      }
      on other is {
        error "Unexpected message for source ClaimEventSource"
      }
    } with {
      briefly "Claim source handler"
      described as {
        |Publishes Claim events onto the outlet.
      }
    }
  } with {
    briefly "Claim event source"
    described as {
      |Publishes Claim entity events into the streaming topology.
    }
  }
  sink ClaimEventSink is {
    inlet ClaimInlet is type ClaimEvent
    handler ClaimSinkHandler is {
      on event Claim.ClaimSubmitted is {
        tell event Claim.ClaimSubmitted to repository ClaimContext.ClaimRepository
      }
      on event Claim.ClaimAdjudicated is {
        tell event Claim.ClaimAdjudicated to repository ClaimContext.ClaimRepository
      }
      on event Claim.ClaimPended is {
        tell event Claim.ClaimPended to repository ClaimContext.ClaimRepository
      }
      on event Claim.PendResolved is {
        tell event Claim.PendResolved to repository ClaimContext.ClaimRepository
      }
      on event Claim.ClaimApproved is {
        tell event Claim.ClaimApproved to repository ClaimContext.ClaimRepository
      }
      on event Claim.ClaimDenied is {
        tell event Claim.ClaimDenied to repository ClaimContext.ClaimRepository
      }
      on event Claim.ClaimPaid is {
        tell event Claim.ClaimPaid to repository ClaimContext.ClaimRepository
      }
      on event Claim.ClaimAppealed is {
        tell event Claim.ClaimAppealed to repository ClaimContext.ClaimRepository
      }
      on event Claim.AppealResolved is {
        tell event Claim.AppealResolved to repository ClaimContext.ClaimRepository
      }
      on event Claim.ClaimVoided is {
        tell event Claim.ClaimVoided to repository ClaimContext.ClaimRepository
      }
      on other is {
        error "Unexpected message for sink ClaimEventSink"
      }
    } with {
      briefly "Claim sink handler"
      described as {
        |Persists Claim events via the repository.
      }
    }
  } with {
    briefly "Claim event sink"
    described as {
      |Receives Claim events for persistence.
    }
  }
  connector ClaimEventFlow is {
    from outlet ClaimContext.ClaimEventSource.ClaimEvents to
      inlet ClaimContext.ClaimEventSink.ClaimInlet
  } with {
    briefly "Claim event flow"
    described as {
      |Connects the Claim source to its sink.
    }
  }
} with {
  briefly "Bounded context for claims adjudication"
  described as {
    | The ClaimContext is the bounded context for
    | insurance claims processing and payment.
  }
}
