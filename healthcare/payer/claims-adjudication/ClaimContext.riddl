// Claims Adjudication - Claim Context
context ClaimContext is {
  adaptor FromAuthorizationService from context AuthorizationService is {
    handler FromAuthorizationServiceHandler is {
      on result AuthorizationService.AuthorizationResult is {
        do "the model receives authorization result"
      }
      on other is {
        error "Unexpected message for adaptor FromAuthorizationService"
      }
    } with {
      briefly "from authorization service"
      described as {
        |Carries messages from the external AuthorizationService.
      }
    }
  } with {
      briefly "AuthorizationService integration"
    described as {
      |The model's side of the AuthorizationService conversation.
    }
  }
  adaptor ToAuthorizationService to context AuthorizationService is {
    handler ToAuthorizationServiceHandler is {
      on query AuthorizationService.CheckAuthorization is {
        do "the model sends check authorization"
      }
      on other is {
        error "Unexpected message for adaptor ToAuthorizationService"
      }
    } with {
      briefly "to authorization service"
      described as {
        |Carries messages to the external AuthorizationService.
      }
    }
  } with {
      briefly "AuthorizationService integration"
    described as {
      |The model's side of the AuthorizationService conversation.
    }
  }
  adaptor FromBenefitsService from context BenefitsService is {
    handler FromBenefitsServiceHandler is {
      on result BenefitsService.BenefitInfo is {
        do "the model receives benefit info"
      }
      on other is {
        error "Unexpected message for adaptor FromBenefitsService"
      }
    } with {
      briefly "from benefits service"
      described as {
        |Carries messages from the external BenefitsService.
      }
    }
  } with {
      briefly "BenefitsService integration"
    described as {
      |The model's side of the BenefitsService conversation.
    }
  }
  adaptor ToBenefitsService to context BenefitsService is {
    handler ToBenefitsServiceHandler is {
      on query BenefitsService.GetBenefits is {
        do "the model sends get benefits"
      }
      on other is {
        error "Unexpected message for adaptor ToBenefitsService"
      }
    } with {
      briefly "to benefits service"
      described as {
        |Carries messages to the external BenefitsService.
      }
    }
  } with {
      briefly "BenefitsService integration"
    described as {
      |The model's side of the BenefitsService conversation.
    }
  }
  adaptor FromEligibilityService from context EligibilityService is {
    handler FromEligibilityServiceHandler is {
      on result EligibilityService.EligibilityResult is {
        do "the model receives eligibility result"
      }
      on other is {
        error "Unexpected message for adaptor FromEligibilityService"
      }
    } with {
      briefly "from eligibility service"
      described as {
        |Carries messages from the external EligibilityService.
      }
    }
  } with {
      briefly "EligibilityService integration"
    described as {
      |The model's side of the EligibilityService conversation.
    }
  }
  adaptor ToEligibilityService to context EligibilityService is {
    handler ToEligibilityServiceHandler is {
      on query EligibilityService.CheckEligibility is {
        do "the model sends check eligibility"
      }
      on other is {
        error "Unexpected message for adaptor ToEligibilityService"
      }
    } with {
      briefly "to eligibility service"
      described as {
        |Carries messages to the external EligibilityService.
      }
    }
  } with {
      briefly "EligibilityService integration"
    described as {
      |The model's side of the EligibilityService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is {
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is {
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendClaimNotification is {
        do "the model sends send claim notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentService from context PaymentService is {
    handler FromPaymentServiceHandler is {
      on event PaymentService.PaymentIssued is {
        do "the model receives payment issued"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentService"
      }
    } with {
      briefly "from payment service"
      described as {
        |Carries messages from the external PaymentService.
      }
    }
  } with {
      briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor ToPaymentService to context PaymentService is {
    handler ToPaymentServiceHandler is {
      on command PaymentService.IssuePayment is {
        do "the model sends issue payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentService"
      }
    } with {
      briefly "to payment service"
      described as {
        |Carries messages to the external PaymentService.
      }
    }
  } with {
      briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor FromProviderContractService from context ProviderContractService is {
    handler FromProviderContractServiceHandler is {
      on result ProviderContractService.ContractRates is {
        do "the model receives contract rates"
      }
      on other is {
        error "Unexpected message for adaptor FromProviderContractService"
      }
    } with {
      briefly "from provider contract service"
      described as {
        |Carries messages from the external ProviderContractService.
      }
    }
  } with {
      briefly "ProviderContractService integration"
    described as {
      |The model's side of the ProviderContractService conversation.
    }
  }
  adaptor ToProviderContractService to context ProviderContractService is {
    handler ToProviderContractServiceHandler is {
      on query ProviderContractService.GetContractRates is {
        do "the model sends get contract rates"
      }
      on other is {
        error "Unexpected message for adaptor ToProviderContractService"
      }
    } with {
      briefly "to provider contract service"
      described as {
        |Carries messages to the external ProviderContractService.
      }
    }
  } with {
      briefly "ProviderContractService integration"
    described as {
      |The model's side of the ProviderContractService conversation.
    }
  }
  include "types.riddl"
  include "Claim.riddl"
  // Repository for claim persistence
  repository ClaimRepository is {
    inlet ClaimRepositoryFromClaim is type ClaimEvent
    inlet ClaimRepositoryFromClaimsAnalytics is type ClaimEvent
    outlet ClaimRepositoryResponses is type Claim.ClaimResult
    schema ClaimData is relational
      of claims as type Claim
        index on field Claim.claimId
        index on field Claim.member.memberId
        index on field Claim.provider.providerId
      with {
      briefly "Claim data schema"
      described as {
        |The relational schema holding claim data for the ClaimRepository.
      }
    }

    handler ClaimPersistence is {
      on command Claim.SubmitClaim is {
        tell event Claim.ClaimSubmitted to entity ClaimContext.Claim
        do "Store new claim"
      }
      on command Claim.AdjudicateClaim is {
        do "Update adjudication"
      }
      on command Claim.PendClaim is {
        do "Update claim to pended"
      }
      on command Claim.ResolvePend is {
        do "Update pend resolution"
      }
      on command Claim.ApproveClaim is {
        tell event Claim.ClaimApproved to entity ClaimContext.Claim
        do "Update claim to approved"
      }
      on command Claim.DenyClaim is {
        do "Update claim to denied"
      }
      on command Claim.PayClaim is {
        do "Update payment record"
      }
      on command Claim.AppealClaim is {
        do "Store appeal"
      }
      on command Claim.ResolveAppeal is {
        do "Update appeal resolution"
      }
      on command Claim.VoidClaim is {
        do "Update claim to voided"
      }
    } with {
      briefly "Persists claim commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Claim data persistence"
    described as {
      | The ClaimRepository provides persistent storage for
      | claims, adjudication, and payment history.
    }
  }
  // Projector for claims analytics
  projector ClaimsAnalytics is {
    inlet ClaimsAnalyticsFromClaim is type ClaimEvent
    outlet ClaimsAnalyticsOut is type ClaimEvent
    updates repository ClaimContext.ClaimRepository
    record ClaimsStats is  {
      totalClaims: Natural with {
        briefly "Total"
        described as {
          |Total claims.
        }
      }
      totalPaid: Decimal(18,2) with {
        briefly "Paid"
        described as {
          |Total paid.
        }
      }
      approvalRate: Decimal(5,4) with {
        briefly "Approval"
        described as {
          |Approval rate.
        }
      }
      denialRate: Decimal(5,4) with {
        briefly "Denial"
        described as {
          |Denial rate.
        }
      }
      avgProcessingTime: Duration with {
        briefly "Avg time"
        described as {
          |Average processing time.
        }
      }
      pendRate: Decimal(5,4) with {
        briefly "Pend rate"
        described as {
          |Pend rate.
        }
      }
    } with {
      briefly "Claims statistics"
      described as {
        |Claims processing metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Claim.ClaimSubmitted is {
        tell event Claim.ClaimSubmitted to repository ClaimContext.ClaimRepository
        do "Update claim counts"
      }
      on event Claim.ClaimApproved is {
        tell event Claim.ClaimApproved to repository ClaimContext.ClaimRepository
        do "Update approval metrics"
      }
      on event Claim.ClaimDenied is {
        tell event Claim.ClaimDenied to repository ClaimContext.ClaimRepository
        do "Update denial metrics"
      }
      on event Claim.ClaimPaid is {
        tell event Claim.ClaimPaid to repository ClaimContext.ClaimRepository
        do "Update payment metrics"
      }
    } with {
      briefly "Maintains claims analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Claims analytics projections"
    described as {
      |Maintains claims adjudication analytics data.
    }
  }
  // ---- Event publication for Claim ----
  type ClaimEvent is one of {
    ClaimContext.Claim.ClaimSubmitted,
    ClaimContext.Claim.ClaimAdjudicated,
    ClaimContext.Claim.ClaimPended,
    ClaimContext.Claim.PendResolved,
    ClaimContext.Claim.ClaimApproved,
    ClaimContext.Claim.ClaimDenied,
    ClaimContext.Claim.ClaimPaid,
    ClaimContext.Claim.ClaimAppealed,
    ClaimContext.Claim.AppealResolved,
    ClaimContext.Claim.ClaimVoided
  } with {
    briefly "Claim event alternation"
    described as {
      |Union of all Claim events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ClaimEventSource as source is {
    outlet ClaimEvents is type ClaimEvent
    handler ClaimSourceHandler is {
      on event Claim.ClaimSubmitted is {
        send event Claim.ClaimSubmitted to outlet ClaimEvents
      }
      on event Claim.ClaimAdjudicated is {
        send event Claim.ClaimAdjudicated to outlet ClaimEvents
      }
      on event Claim.ClaimPended is {
        send event Claim.ClaimPended to outlet ClaimEvents
      }
      on event Claim.PendResolved is {
        send event Claim.PendResolved to outlet ClaimEvents
      }
      on event Claim.ClaimApproved is {
        send event Claim.ClaimApproved to outlet ClaimEvents
      }
      on event Claim.ClaimDenied is {
        send event Claim.ClaimDenied to outlet ClaimEvents
      }
      on event Claim.ClaimPaid is {
        send event Claim.ClaimPaid to outlet ClaimEvents
      }
      on event Claim.ClaimAppealed is {
        send event Claim.ClaimAppealed to outlet ClaimEvents
      }
      on event Claim.AppealResolved is {
        send event Claim.AppealResolved to outlet ClaimEvents
      }
      on event Claim.ClaimVoided is {
        send event Claim.ClaimVoided to outlet ClaimEvents
      }
      on other is {
        error "Unexpected message for source ClaimEventSource"
      }
    } with {
      briefly "Claim source handler"
      described as {
        |Publishes Claim events onto the outlet.
      }
    }
  } with {
    briefly "Claim event source"
    described as {
      |Publishes Claim entity events into the streaming topology.
    }
  }
  processor ClaimEventSink as sink is {
    inlet ClaimInlet is type ClaimEvent
    handler ClaimSinkHandler is {
      on event Claim.ClaimSubmitted is {
        tell event Claim.ClaimSubmitted to repository ClaimContext.ClaimRepository
      }
      on event Claim.ClaimAdjudicated is {
        tell event Claim.ClaimAdjudicated to repository ClaimContext.ClaimRepository
      }
      on event Claim.ClaimPended is {
        tell event Claim.ClaimPended to repository ClaimContext.ClaimRepository
      }
      on event Claim.PendResolved is {
        tell event Claim.PendResolved to repository ClaimContext.ClaimRepository
      }
      on event Claim.ClaimApproved is {
        tell event Claim.ClaimApproved to repository ClaimContext.ClaimRepository
      }
      on event Claim.ClaimDenied is {
        tell event Claim.ClaimDenied to repository ClaimContext.ClaimRepository
      }
      on event Claim.ClaimPaid is {
        tell event Claim.ClaimPaid to repository ClaimContext.ClaimRepository
      }
      on event Claim.ClaimAppealed is {
        tell event Claim.ClaimAppealed to repository ClaimContext.ClaimRepository
      }
      on event Claim.AppealResolved is {
        tell event Claim.AppealResolved to repository ClaimContext.ClaimRepository
      }
      on event Claim.ClaimVoided is {
        tell event Claim.ClaimVoided to repository ClaimContext.ClaimRepository
      }
      on other is {
        error "Unexpected message for sink ClaimEventSink"
      }
    } with {
      briefly "Claim sink handler"
      described as {
        |Persists Claim events via the repository.
      }
    }
  } with {
    briefly "Claim event sink"
    described as {
      |Receives Claim events for persistence.
    }
  }
  connector ClaimEventFlow is {
    from outlet ClaimContext.ClaimEventSource.ClaimEvents to
      inlet ClaimContext.ClaimEventSink.ClaimInlet
  } with {
    briefly "Claim event flow"
    described as {
      |Connects the Claim source to its sink.
    }
  }
  processor ClaimEventSplit is {
    inlet ClaimEventSplitIn is type ClaimEvent
    outlet ClaimEventSplitToClaimRepository is type ClaimEvent
    outlet ClaimEventSplitToClaimsAnalytics is type ClaimEvent
    handler ClaimEventSplitHandler is {
      on event Claim.ClaimSubmitted is {
        send event Claim.ClaimSubmitted to outlet ClaimEventSplitToClaimRepository
        send event Claim.ClaimSubmitted to outlet ClaimEventSplitToClaimsAnalytics
        tell event Claim.ClaimSubmitted to entity ClaimContext.Claim
      }
      on event Claim.ClaimAdjudicated is {
        send event Claim.ClaimAdjudicated to outlet ClaimEventSplitToClaimRepository
        send event Claim.ClaimAdjudicated to outlet ClaimEventSplitToClaimsAnalytics
        tell event Claim.ClaimAdjudicated to entity ClaimContext.Claim
      }
      on event Claim.ClaimPended is {
        send event Claim.ClaimPended to outlet ClaimEventSplitToClaimRepository
        send event Claim.ClaimPended to outlet ClaimEventSplitToClaimsAnalytics
        tell event Claim.ClaimPended to entity ClaimContext.Claim
      }
      on event Claim.PendResolved is {
        send event Claim.PendResolved to outlet ClaimEventSplitToClaimRepository
        send event Claim.PendResolved to outlet ClaimEventSplitToClaimsAnalytics
        tell event Claim.PendResolved to entity ClaimContext.Claim
      }
      on event Claim.ClaimApproved is {
        send event Claim.ClaimApproved to outlet ClaimEventSplitToClaimRepository
        send event Claim.ClaimApproved to outlet ClaimEventSplitToClaimsAnalytics
        tell event Claim.ClaimApproved to entity ClaimContext.Claim
      }
      on event Claim.ClaimDenied is {
        send event Claim.ClaimDenied to outlet ClaimEventSplitToClaimRepository
        send event Claim.ClaimDenied to outlet ClaimEventSplitToClaimsAnalytics
        tell event Claim.ClaimDenied to entity ClaimContext.Claim
      }
      on event Claim.ClaimPaid is {
        send event Claim.ClaimPaid to outlet ClaimEventSplitToClaimRepository
        send event Claim.ClaimPaid to outlet ClaimEventSplitToClaimsAnalytics
        tell event Claim.ClaimPaid to entity ClaimContext.Claim
      }
      on event Claim.ClaimAppealed is {
        send event Claim.ClaimAppealed to outlet ClaimEventSplitToClaimRepository
        send event Claim.ClaimAppealed to outlet ClaimEventSplitToClaimsAnalytics
        tell event Claim.ClaimAppealed to entity ClaimContext.Claim
      }
      on event Claim.AppealResolved is {
        send event Claim.AppealResolved to outlet ClaimEventSplitToClaimRepository
        send event Claim.AppealResolved to outlet ClaimEventSplitToClaimsAnalytics
        tell event Claim.AppealResolved to entity ClaimContext.Claim
      }
      on event Claim.ClaimVoided is {
        send event Claim.ClaimVoided to outlet ClaimEventSplitToClaimRepository
        send event Claim.ClaimVoided to outlet ClaimEventSplitToClaimsAnalytics
        tell event Claim.ClaimVoided to entity ClaimContext.Claim
      }
      on other is {
        error "Unexpected message for processor ClaimEventSplit"
      }
    } with {
      briefly "Claim event fan-out handler"
      described as {
        |Delivers each Claim event to all of its consumers.
      }
    }
  } with {
    briefly "Claim event fan-out"
    described as {
      |Fans Claim events out to the repository and projectors.
    }
  }
  connector LinkClaimToClaimEventSplit is {
    from outlet ClaimContext.Claim.ClaimEvents2 to
      inlet ClaimContext.ClaimEventSplit.ClaimEventSplitIn
  } with {
    briefly "LinkClaimToClaimEventSplit"
  }
  connector LinkClaimEventSplitToClaimRepository is {
    from outlet ClaimContext.ClaimEventSplit.ClaimEventSplitToClaimRepository to
      inlet ClaimContext.ClaimRepository.ClaimRepositoryFromClaim
  } with {
    briefly "LinkClaimEventSplitToClaimRepository"
  }
  connector LinkClaimEventSplitToClaimsAnalytics is {
    from outlet ClaimContext.ClaimEventSplit.ClaimEventSplitToClaimsAnalytics to
      inlet ClaimContext.ClaimsAnalytics.ClaimsAnalyticsFromClaim
  } with {
    briefly "LinkClaimEventSplitToClaimsAnalytics"
  }
  connector LinkClaimsAnalyticsToClaimRepository is {
    from outlet ClaimContext.ClaimsAnalytics.ClaimsAnalyticsOut to
      inlet ClaimContext.ClaimRepository.ClaimRepositoryFromClaimsAnalytics
  } with {
    briefly "LinkClaimsAnalyticsToClaimRepository"
  }
} with {
  briefly "Bounded context for claims adjudication"
  described as {
    | The ClaimContext is the bounded context for
    | insurance claims processing and payment.
  }
}
