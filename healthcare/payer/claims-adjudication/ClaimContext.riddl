// Claims Adjudication - Claim Context
context ClaimContext as router is {
  inlet ClaimCommandStreamIn is type ClaimCommand  outlet ClaimCommandStreamOut is type ClaimCommand
  inlet ClaimResultStreamIn is result Claim.ClaimResult  outlet ClaimResultStreamOut is result Claim.ClaimResult
  handler ClaimContextBoundary is {
    on submitClaim: command Claim.SubmitClaim is {
      send submitClaim to outlet ClaimContext.ClaimCommandStreamOut
    }
    on adjudicateClaim: command Claim.AdjudicateClaim is {
      send adjudicateClaim to outlet ClaimContext.ClaimCommandStreamOut
    }
    on pendClaim: command Claim.PendClaim is {
      send pendClaim to outlet ClaimContext.ClaimCommandStreamOut
    }
    on resolvePend: command Claim.ResolvePend is {
      send resolvePend to outlet ClaimContext.ClaimCommandStreamOut
    }
    on approveClaim: command Claim.ApproveClaim is {
      send approveClaim to outlet ClaimContext.ClaimCommandStreamOut
    }
    on denyClaim: command Claim.DenyClaim is {
      send denyClaim to outlet ClaimContext.ClaimCommandStreamOut
    }
    on payClaim: command Claim.PayClaim is {
      send payClaim to outlet ClaimContext.ClaimCommandStreamOut
    }
    on appealClaim: command Claim.AppealClaim is {
      send appealClaim to outlet ClaimContext.ClaimCommandStreamOut
    }
    on resolveAppeal: command Claim.ResolveAppeal is {
      send resolveAppeal to outlet ClaimContext.ClaimCommandStreamOut
    }
    on voidClaim: command Claim.VoidClaim is {
      send voidClaim to outlet ClaimContext.ClaimCommandStreamOut
    }
    on claimResult: result Claim.ClaimResult is {
      send claimResult to outlet ClaimContext.ClaimResultStreamOut
    }
    on other is {
      error "Unexpected message at the ClaimContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ClaimCommand Stream Intake' is from outlet ClaimContext.ClaimCommandStreamOut to inlet ClaimContext.Claim.ClaimCommands  connector 'ClaimResult Stream Egress' is from outlet ClaimContext.ClaimRepository.ClaimRepositoryResponses to inlet ClaimContext.ClaimResultStreamIn  adaptor FromAuthorizationService from context AuthorizationService is { 
    handler FromAuthorizationServiceHandler is {
      on result AuthorizationService.AuthorizationResult is {
        do "the model receives authorization result"
      }
      on other is {
        error "Unexpected message for adaptor FromAuthorizationService"
      }
    } with {
      briefly "from authorization service"
      described as {
        |Carries messages from the external AuthorizationService.
      }
    }
  } with {
    briefly "AuthorizationService integration"
    described as {
      |The model's side of the AuthorizationService conversation.
    }
  }
  adaptor ToAuthorizationService to context AuthorizationService is { 
    handler ToAuthorizationServiceHandler is {
      on query AuthorizationService.CheckAuthorization is {
        do "the model sends check authorization"
      }
      on other is {
        error "Unexpected message for adaptor ToAuthorizationService"
      }
    } with {
      briefly "to authorization service"
      described as {
        |Carries messages to the external AuthorizationService.
      }
    }
  } with {
    briefly "AuthorizationService integration"
    described as {
      |The model's side of the AuthorizationService conversation.
    }
  }
  adaptor FromBenefitsService from context BenefitsService is { 
    handler FromBenefitsServiceHandler is {
      on result BenefitsService.BenefitInfo is {
        do "the model receives benefit info"
      }
      on other is {
        error "Unexpected message for adaptor FromBenefitsService"
      }
    } with {
      briefly "from benefits service"
      described as {
        |Carries messages from the external BenefitsService.
      }
    }
  } with {
    briefly "BenefitsService integration"
    described as {
      |The model's side of the BenefitsService conversation.
    }
  }
  adaptor ToBenefitsService to context BenefitsService is { 
    handler ToBenefitsServiceHandler is {
      on query BenefitsService.GetBenefits is {
        do "the model sends get benefits"
      }
      on other is {
        error "Unexpected message for adaptor ToBenefitsService"
      }
    } with {
      briefly "to benefits service"
      described as {
        |Carries messages to the external BenefitsService.
      }
    }
  } with {
    briefly "BenefitsService integration"
    described as {
      |The model's side of the BenefitsService conversation.
    }
  }
  adaptor FromEligibilityService from context EligibilityService is { 
    handler FromEligibilityServiceHandler is {
      on result EligibilityService.EligibilityResult is {
        do "the model receives eligibility result"
      }
      on other is {
        error "Unexpected message for adaptor FromEligibilityService"
      }
    } with {
      briefly "from eligibility service"
      described as {
        |Carries messages from the external EligibilityService.
      }
    }
  } with {
    briefly "EligibilityService integration"
    described as {
      |The model's side of the EligibilityService conversation.
    }
  }
  adaptor ToEligibilityService to context EligibilityService is { 
    handler ToEligibilityServiceHandler is {
      on query EligibilityService.CheckEligibility is {
        do "the model sends check eligibility"
      }
      on other is {
        error "Unexpected message for adaptor ToEligibilityService"
      }
    } with {
      briefly "to eligibility service"
      described as {
        |Carries messages to the external EligibilityService.
      }
    }
  } with {
    briefly "EligibilityService integration"
    described as {
      |The model's side of the EligibilityService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendClaimNotification is {
        do "the model sends send claim notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentService from context PaymentService is { 
    handler FromPaymentServiceHandler is {
      on event PaymentService.PaymentIssued is {
        do "the model receives payment issued"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentService"
      }
    } with {
      briefly "from payment service"
      described as {
        |Carries messages from the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor ToPaymentService to context PaymentService is { 
    handler ToPaymentServiceHandler is {
      on command PaymentService.IssuePayment is {
        do "the model sends issue payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentService"
      }
    } with {
      briefly "to payment service"
      described as {
        |Carries messages to the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor FromProviderContractService from context ProviderContractService is { 
    handler FromProviderContractServiceHandler is {
      on result ProviderContractService.ContractRates is {
        do "the model receives contract rates"
      }
      on other is {
        error "Unexpected message for adaptor FromProviderContractService"
      }
    } with {
      briefly "from provider contract service"
      described as {
        |Carries messages from the external ProviderContractService.
      }
    }
  } with {
    briefly "ProviderContractService integration"
    described as {
      |The model's side of the ProviderContractService conversation.
    }
  }
  adaptor ToProviderContractService to context ProviderContractService is { 
    handler ToProviderContractServiceHandler is {
      on query ProviderContractService.GetContractRates is {
        do "the model sends get contract rates"
      }
      on other is {
        error "Unexpected message for adaptor ToProviderContractService"
      }
    } with {
      briefly "to provider contract service"
      described as {
        |Carries messages to the external ProviderContractService.
      }
    }
  } with {
    briefly "ProviderContractService integration"
    described as {
      |The model's side of the ProviderContractService conversation.
    }
  }
  include "types.riddl"
  include "Claim.riddl"
  // Repository for claim persistence
  type ClaimRepositoryCommand is one of {
    ClaimContext.ClaimRepository.PersistAppealResolved or ClaimContext.ClaimRepository.PersistClaimAdjudicated or ClaimContext.ClaimRepository.PersistClaimAppealed or ClaimContext.ClaimRepository.PersistClaimApproved or ClaimContext.ClaimRepository.PersistClaimDenied or ClaimContext.ClaimRepository.PersistClaimPaid or ClaimContext.ClaimRepository.PersistClaimPended or ClaimContext.ClaimRepository.PersistClaimSubmitted or ClaimContext.ClaimRepository.PersistClaimVoided or ClaimContext.ClaimRepository.PersistPendResolved
  } with {
    briefly "Anything that writes ClaimRepository"
    described as {
      |The persistence commands ClaimRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ClaimRepository as flow is {
    inlet ClaimRepositoryFromClaimsAnalytics is type ClaimRepositoryCommand    command PersistAppealResolved is {
      claimId: ClaimId with {
        briefly "Row addressed"
        described as {
          |Which stored row AppealResolved applies to.
        }
      }
    } with {
      briefly "Persist AppealResolved"
      described as {
        |Instructs this repository to apply AppealResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClaimAdjudicated is {
      claimId: ClaimId with {
        briefly "Row addressed"
        described as {
          |Which stored row ClaimAdjudicated applies to.
        }
      }
    } with {
      briefly "Persist ClaimAdjudicated"
      described as {
        |Instructs this repository to apply ClaimAdjudicated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClaimAppealed is {
      claimId: ClaimId with {
        briefly "Row addressed"
        described as {
          |Which stored row ClaimAppealed applies to.
        }
      }
    } with {
      briefly "Persist ClaimAppealed"
      described as {
        |Instructs this repository to apply ClaimAppealed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClaimPended is {
      claimId: ClaimId with {
        briefly "Row addressed"
        described as {
          |Which stored row ClaimPended applies to.
        }
      }
    } with {
      briefly "Persist ClaimPended"
      described as {
        |Instructs this repository to apply ClaimPended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClaimVoided is {
      claimId: ClaimId with {
        briefly "Row addressed"
        described as {
          |Which stored row ClaimVoided applies to.
        }
      }
    } with {
      briefly "Persist ClaimVoided"
      described as {
        |Instructs this repository to apply ClaimVoided to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPendResolved is {
      claimId: ClaimId with {
        briefly "Row addressed"
        described as {
          |Which stored row PendResolved applies to.
        }
      }
    } with {
      briefly "Persist PendResolved"
      described as {
        |Instructs this repository to apply PendResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClaimApproved is {
      claimId: ClaimId with {
        briefly "Row addressed"
        described as {
          |Which stored row ClaimApproved applies to.
        }
      }
    } with {
      briefly "Persist ClaimApproved"
      described as {
        |Instructs this repository to apply ClaimApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClaimDenied is {
      claimId: ClaimId with {
        briefly "Row addressed"
        described as {
          |Which stored row ClaimDenied applies to.
        }
      }
    } with {
      briefly "Persist ClaimDenied"
      described as {
        |Instructs this repository to apply ClaimDenied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClaimPaid is {
      claimId: ClaimId with {
        briefly "Row addressed"
        described as {
          |Which stored row ClaimPaid applies to.
        }
      }
    } with {
      briefly "Persist ClaimPaid"
      described as {
        |Instructs this repository to apply ClaimPaid to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClaimSubmitted is {
      claimId: ClaimId with {
        briefly "Row addressed"
        described as {
          |Which stored row ClaimSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ClaimSubmitted"
      described as {
        |Instructs this repository to apply ClaimSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ClaimRepositoryResponses is result Claim.ClaimResult
    record StoredClaim is {
      claimId: ClaimId with {
        briefly "claimId"
        described as {
          |The claimId column of the stored claim row.
        }
      }
      member: MemberInfo with {
        briefly "member"
        described as {
          |The member column of the stored claim row.
        }
      }
      provider: ProviderInfo with {
        briefly "provider"
        described as {
          |The provider column of the stored claim row.
        }
      }
    } with {
      briefly "Stored claim row"
      described as {
        |The persistence shape of claim data as this repository stores it.
      }
    }
    schema ClaimData is relational
      of claims as record StoredClaim
        index on field StoredClaim.claimId
        index on field StoredClaim.member.memberId
        index on field StoredClaim.provider.providerId
 with {
      briefly "Claim data schema"
      described as {
        |The relational schema holding claim data for the ClaimRepository.
      }
    }
    handler ClaimPersistence is {
      on persistAppealResolved: command PersistAppealResolved is {
        do "apply AppealResolved to the stored row"
      }
      on persistClaimAdjudicated: command PersistClaimAdjudicated is {
        do "apply ClaimAdjudicated to the stored row"
      }
      on persistClaimAppealed: command PersistClaimAppealed is {
        do "apply ClaimAppealed to the stored row"
      }
      on persistClaimPended: command PersistClaimPended is {
        do "apply ClaimPended to the stored row"
      }
      on persistClaimVoided: command PersistClaimVoided is {
        do "apply ClaimVoided to the stored row"
      }
      on persistPendResolved: command PersistPendResolved is {
        do "apply PendResolved to the stored row"
      }
      on persistClaimApproved: command PersistClaimApproved is {
        do "apply ClaimApproved to the stored row"
      }
      on persistClaimDenied: command PersistClaimDenied is {
        do "apply ClaimDenied to the stored row"
      }
      on persistClaimPaid: command PersistClaimPaid is {
        do "apply ClaimPaid to the stored row"
      }
      on persistClaimSubmitted: command PersistClaimSubmitted is {
        do "apply ClaimSubmitted to the stored row"
      }
      on query GetClaimsStats is {
        let claimsStatsView: type ClaimsStatsView = prompt("read the claims stats projection")
        reply claimsStatsView
      }
    } with {
      briefly "Persists claim commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Claim data persistence"
    described as {
      | The ClaimRepository provides persistent storage for
      | claims, adjudication, and payment history.
    }
  }
  // Projector for claims analytics
  query GetClaimsStats replies result ClaimsStatsView is {
    claimsStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which claims stats to retrieve.
      }
    }
  } with {
    briefly "Get claims stats"
    described as {
      |Retrieves the claims stats projection.
    }
  }
  result ClaimsStatsView is {
    claimsStats: ClaimsAnalytics.ClaimsStats with {
      briefly "Claims stats"
      described as {
        |The claims stats being returned.
      }
    }
  } with {
    briefly "Claims stats view"
    described as {
      |Read model view carrying the claims stats projection.
    }
  }
  projector ClaimsAnalytics as flow is {
    updates repository ClaimContext.ClaimRepository
    outlet ClaimsAnalyticsToRepository is type ClaimRepositoryCommand
    inlet ClaimsAnalyticsFromClaim is type ClaimEvent    record ClaimsStats is {
      totalClaims: Natural with {
        briefly "Total"
        described as {
          |Total claims.
        }
      }
      totalPaid: Decimal(18,2) with {
        briefly "Paid"
        described as {
          |Total paid.
        }
      }
      approvalRate: Decimal(5,4) with {
        briefly "Approval"
        described as {
          |Approval rate.
        }
      }
      denialRate: Decimal(5,4) with {
        briefly "Denial"
        described as {
          |Denial rate.
        }
      }
      avgProcessingTime: Duration with {
        briefly "Avg time"
        described as {
          |Average processing time.
        }
      }
      pendRate: Decimal(5,4) with {
        briefly "Pend rate"
        described as {
          |Pend rate.
        }
      }
    } with {
      briefly "Claims statistics"
      described as {
        |Claims processing metrics.
      }
    }
    handler AnalyticsHandler is {
      on appealResolved: event Claim.AppealResolved is {
        tell command ClaimContext.ClaimRepository.PersistAppealResolved(claimId = appealResolved.claimId) to repository ClaimContext.ClaimRepository
        do "apply AppealResolved to the ClaimsAnalytics projection"
      }
      on claimAdjudicated: event Claim.ClaimAdjudicated is {
        tell command ClaimContext.ClaimRepository.PersistClaimAdjudicated(claimId = claimAdjudicated.claimId) to repository ClaimContext.ClaimRepository
        do "apply ClaimAdjudicated to the ClaimsAnalytics projection"
      }
      on claimAppealed: event Claim.ClaimAppealed is {
        tell command ClaimContext.ClaimRepository.PersistClaimAppealed(claimId = claimAppealed.claimId) to repository ClaimContext.ClaimRepository
        do "apply ClaimAppealed to the ClaimsAnalytics projection"
      }
      on claimPended: event Claim.ClaimPended is {
        tell command ClaimContext.ClaimRepository.PersistClaimPended(claimId = claimPended.claimId) to repository ClaimContext.ClaimRepository
        do "apply ClaimPended to the ClaimsAnalytics projection"
      }
      on claimVoided: event Claim.ClaimVoided is {
        tell command ClaimContext.ClaimRepository.PersistClaimVoided(claimId = claimVoided.claimId) to repository ClaimContext.ClaimRepository
        do "apply ClaimVoided to the ClaimsAnalytics projection"
      }
      on pendResolved: event Claim.PendResolved is {
        tell command ClaimContext.ClaimRepository.PersistPendResolved(claimId = pendResolved.claimId) to repository ClaimContext.ClaimRepository
        do "apply PendResolved to the ClaimsAnalytics projection"
      }
      on claimSubmitted: event Claim.ClaimSubmitted is {
        tell command ClaimContext.ClaimRepository.PersistClaimSubmitted(claimId = claimSubmitted.claimId) to repository ClaimContext.ClaimRepository
        do "Update claim counts"
      }
      on claimApproved: event Claim.ClaimApproved is {
        tell command ClaimContext.ClaimRepository.PersistClaimApproved(claimId = claimApproved.claimId) to repository ClaimContext.ClaimRepository
        do "Update approval metrics"
      }
      on claimDenied: event Claim.ClaimDenied is {
        tell command ClaimContext.ClaimRepository.PersistClaimDenied(claimId = claimDenied.claimId) to repository ClaimContext.ClaimRepository
        do "Update denial metrics"
      }
      on claimPaid: event Claim.ClaimPaid is {
        tell command ClaimContext.ClaimRepository.PersistClaimPaid(claimId = claimPaid.claimId) to repository ClaimContext.ClaimRepository
        do "Update payment metrics"
      }
    } with {
      briefly "Maintains claims analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Claims analytics projections"
    described as {
      |Maintains claims adjudication analytics data.
    }
  }
  // ---- Event publication for Claim ----
  type ClaimEvent is one of {
    ClaimContext.Claim.ClaimSubmitted or ClaimContext.Claim.ClaimAdjudicated or ClaimContext.Claim.ClaimPended or ClaimContext.Claim.PendResolved or ClaimContext.Claim.ClaimApproved or ClaimContext.Claim.ClaimDenied or ClaimContext.Claim.ClaimPaid or ClaimContext.Claim.ClaimAppealed or ClaimContext.Claim.AppealResolved or ClaimContext.Claim.ClaimVoided
  } with {
    briefly "Claim event alternation"
    described as {
      |Union of all Claim events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ClaimEventSplit as flow is {
    inlet ClaimEventSplitIn is type ClaimEvent    outlet ClaimEventSplitToClaimsAnalytics is type ClaimEvent
    handler ClaimEventSplitHandler is {
      on claimSubmitted: event Claim.ClaimSubmitted is {
        send claimSubmitted to outlet ClaimEventSplitToClaimsAnalytics
        tell claimSubmitted to entity ClaimContext.Claim
      }
      on claimAdjudicated: event Claim.ClaimAdjudicated is {
        send claimAdjudicated to outlet ClaimEventSplitToClaimsAnalytics
        tell claimAdjudicated to entity ClaimContext.Claim
      }
      on claimPended: event Claim.ClaimPended is {
        send claimPended to outlet ClaimEventSplitToClaimsAnalytics
        tell claimPended to entity ClaimContext.Claim
      }
      on pendResolved: event Claim.PendResolved is {
        send pendResolved to outlet ClaimEventSplitToClaimsAnalytics
        tell pendResolved to entity ClaimContext.Claim
      }
      on claimApproved: event Claim.ClaimApproved is {
        send claimApproved to outlet ClaimEventSplitToClaimsAnalytics
        tell claimApproved to entity ClaimContext.Claim
      }
      on claimDenied: event Claim.ClaimDenied is {
        send claimDenied to outlet ClaimEventSplitToClaimsAnalytics
        tell claimDenied to entity ClaimContext.Claim
      }
      on claimPaid: event Claim.ClaimPaid is {
        send claimPaid to outlet ClaimEventSplitToClaimsAnalytics
        tell claimPaid to entity ClaimContext.Claim
      }
      on claimAppealed: event Claim.ClaimAppealed is {
        send claimAppealed to outlet ClaimEventSplitToClaimsAnalytics
        tell claimAppealed to entity ClaimContext.Claim
      }
      on appealResolved: event Claim.AppealResolved is {
        send appealResolved to outlet ClaimEventSplitToClaimsAnalytics
        tell appealResolved to entity ClaimContext.Claim
      }
      on claimVoided: event Claim.ClaimVoided is {
        send claimVoided to outlet ClaimEventSplitToClaimsAnalytics
        tell claimVoided to entity ClaimContext.Claim
      }
      on other is {
        error "Unexpected message for processor ClaimEventSplit"
      }
    } with {
      briefly "Claim event fan-out handler"
      described as {
        |Delivers each Claim event to all of its consumers.
      }
    }
  } with {
    briefly "Claim event fan-out"
    described as {
      |Fans Claim events out to the repository and projectors.
    }
  }
  connector 'ClaimEvent Stream' is from outlet ClaimContext.Claim.ClaimEvents2 to inlet ClaimContext.ClaimEventSplit.ClaimEventSplitIn with {
    briefly "Claim events, fanned out to storage and read models"
  }
  connector 'ClaimsAnalytics Feed' is from outlet ClaimContext.ClaimEventSplit.ClaimEventSplitToClaimsAnalytics to inlet ClaimContext.ClaimsAnalytics.ClaimsAnalyticsFromClaim with {
    briefly "Claim events feeding the ClaimsAnalytics projection"
  }
  connector 'ClaimsAnalytics Storage' is from outlet ClaimContext.ClaimsAnalytics.ClaimsAnalyticsToRepository to inlet ClaimContext.ClaimRepository.ClaimRepositoryFromClaimsAnalytics with {
    briefly "ClaimsAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for claims adjudication"
  described as {
    | The ClaimContext is the bounded context for
    | insurance claims processing and payment.
  }
}
