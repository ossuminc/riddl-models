// Claims Adjudication Domain Model
// Healthcare insurance claims processing
domain ClaimsAdjudication is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ClaimsProcessor is "person processing insurance claims" with {
    briefly "Claims Processor"
    described as {
      |Person adjudicating claims.
    }
  }
  user ClaimsExaminer is "person reviewing complex claims" with {
    briefly "Claims Examiner"
    described as {
      |Person handling appeals and complex cases.
    }
  }
  user ProviderRelations is "person managing provider contracts" with {
    briefly "Provider Relations"
    described as {
      |Person handling provider issues.
    }
  }
  epic ClaimsProcessingEpic is {
    user ClaimsProcessor wants to "to process claims efficiently" so that "payments are made accurately"
    case AdjudicateClaimUseCase is {
      user ClaimsProcessor wants to "to adjudicate a claim" so that "provider is paid correctly"
      step is "System receives" "claim submission" "from provider" with {
        briefly "Receive claim"
        described as {
          |Get claim data.
        }
      }
      step is "System validates" "member eligibility" "and benefits" with {
        briefly "Validate"
        described as {
          |Check eligibility.
        }
      }
      step take input ClaimsAdjudicationApp.ClaimsAdjudicationScreen.SubmitClaimInput from user ClaimsProcessor with {
        briefly "Submit"
        described as {
          |Process claim.
        }
      }
      step is "System applies" "payment rules" "and calculates amount" with {
        briefly "Calculate"
        described as {
          |Determine payment.
        }
      }
    } with {
      briefly "Adjudication workflow"
      described as {
        |Standard claims adjudication process.
      }
    }
  } with {
    briefly "Claims adjudication"
    described as {
      | Epic covering claims from submission through
      | adjudication, payment, and appeals.
    }
  }
  include "ClaimContext.riddl"
  include "external-contexts.riddl"
  application context ClaimsAdjudicationApp is {
    group ClaimsAdjudicationScreen is {
      input SubmitClaimInput acquires command ClaimContext.Claim.SubmitClaim with {
        briefly "Submit claim control"
        described as {
          |The control through which a user submits the submit claim request.
        }
      }
    } with {
      briefly "Claims adjudication screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppClaimCommands is type ClaimContext.Claim.ClaimCommand
    inlet AppClaimRepositoryResponses is type ClaimContext.Claim.ClaimResult    handler ClaimsAdjudicationAppHandler is {
      on other is {
        error "Unexpected message for application context ClaimsAdjudicationApp"
      }
    } with {
      briefly "ClaimsAdjudicationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ClaimsAdjudicationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppClaimCommands is from outlet ClaimsAdjudicationApp.AppClaimCommands to inlet ClaimContext.Claim.ClaimCommands with {
    option persistent()
    briefly "LinkAppClaimCommands"
  }
  connector LinkAppClaimRepositoryResponses is from outlet ClaimContext.ClaimRepository.ClaimRepositoryResponses to inlet ClaimsAdjudicationApp.AppClaimRepositoryResponses with {
    option persistent()
    briefly "LinkAppClaimRepositoryResponses"
  }
} with {
  term MemberEligibility is  "Whether a member is eligible for benefits on the date of service." 
  briefly "Claims adjudication domain"
  described as {
    | The ClaimsAdjudication domain handles insurance
    | claims processing, payment, and appeals management.
  }
}
