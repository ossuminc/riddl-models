// Claims Adjudication - External Contexts
// Member Eligibility Service
external context EligibilityService as flow is {
  outlet EligibilityServiceRepliesOut is result EligibilityResult
 with {
    briefly "What this service answers, on its way back"
  }
  inlet EligibilityServiceRequests is query CheckEligibility with {
    briefly "What this context asks the service to send"
  }
  handler EligibilityServiceBoundary is {
    on query CheckEligibility is {
      let askAnswer: type EligibilityResult = prompt("look up what CheckEligibility asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context EligibilityService"
    }
  } with {
    briefly "EligibilityService boundary"
  }
  query CheckEligibility replies result EligibilityResult is {
    memberId: MemberId with {
      briefly "Member"
      described as {
        |Member ID.
      }
    }
    serviceDate: Date with {
      briefly "Date"
      described as {
        |Service date.
      }
    }
  } with {
    briefly "Check eligibility"
    described as {
      |Checks member eligibility.
    }
  }
  result EligibilityResult is {
    memberId: MemberId with {
      briefly "Member"
      described as {
        |Member ID.
      }
    }
    eligible: Boolean with {
      briefly "Eligible"
      described as {
        |Is eligible.
      }
    }
    policyId: PolicyId? with {
      briefly "Policy"
      described as {
        |Active policy.
      }
    }
    effectiveDate: Date? with {
      briefly "Effective"
      described as {
        |Coverage start.
      }
    }
    terminationDate: Date? with {
      briefly "Termination"
      described as {
        |Coverage end.
      }
    }
  } with {
    briefly "Eligibility result"
    described as {
      |Member eligibility status.
    }
  }
} with {
  briefly "External eligibility"
  described as {
    |External eligibility verification.
  }
}
// Benefits Service
external context BenefitsService as flow is {
  outlet BenefitsServiceRepliesOut is result BenefitInfo
 with {
    briefly "What this service answers, on its way back"
  }
  inlet BenefitsServiceRequests is query GetBenefits with {
    briefly "What this context asks the service to send"
  }
  handler BenefitsServiceBoundary is {
    on query GetBenefits is {
      let askAnswer: type BenefitInfo = prompt("look up what GetBenefits asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context BenefitsService"
    }
  } with {
    briefly "BenefitsService boundary"
  }
  query GetBenefits replies result BenefitInfo is {
    policyId: PolicyId with {
      briefly "Policy"
      described as {
        |Policy ID.
      }
    }
    procedureCode: ProcedureCode with {
      briefly "Procedure"
      described as {
        |Procedure code.
      }
    }
  } with {
    briefly "Get benefits"
    described as {
      |Retrieves coverage benefits.
    }
  }
  result BenefitInfo is {
    covered: Boolean with {
      briefly "Covered"
      described as {
        |Is covered.
      }
    }
    copay: Decimal(8,2) with {
      briefly "Copay"
      described as {
        |Copay amount.
      }
    }
    coinsurance: Decimal(5,4) with {
      briefly "Coinsurance"
      described as {
        |Coinsurance rate.
      }
    }
    requiresAuth: Boolean with {
      briefly "Auth"
      described as {
        |Requires authorization.
      }
    }
  } with {
    briefly "Benefit info"
    described as {
      |Coverage benefit details.
    }
  }
} with {
  briefly "External benefits"
  described as {
    |External benefits lookup service.
  }
}
// Provider Contract Service
external context ProviderContractService as flow is {
  outlet ProviderContractServiceRepliesOut is result ContractRates
 with {
    briefly "What this service answers, on its way back"
  }
  inlet ProviderContractServiceRequests is query GetContractRates with {
    briefly "What this context asks the service to send"
  }
  handler ProviderContractServiceBoundary is {
    on query GetContractRates is {
      let askAnswer: type ContractRates = prompt("look up what GetContractRates asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context ProviderContractService"
    }
  } with {
    briefly "ProviderContractService boundary"
  }
  query GetContractRates replies result ContractRates is {
    providerId: ProviderId with {
      briefly "Provider"
      described as {
        |Provider ID.
      }
    }
    procedureCode: ProcedureCode with {
      briefly "Procedure"
      described as {
        |Procedure code.
      }
    }
  } with {
    briefly "Get contract rates"
    described as {
      |Retrieves contracted rates.
    }
  }
  result ContractRates is {
    providerId: ProviderId with {
      briefly "Provider"
      described as {
        |Provider ID.
      }
    }
    allowedAmount: Decimal(10,2) with {
      briefly "Allowed"
      described as {
        |Allowed amount.
      }
    }
    isInNetwork: Boolean with {
      briefly "In-network"
      described as {
        |Is in-network.
      }
    }
  } with {
    briefly "Contract rates"
    described as {
      |Provider contracted rates.
    }
  }
} with {
  briefly "External provider contracts"
  described as {
    |External provider contract service.
  }
}
// Authorization Service
external context AuthorizationService as flow is {
  outlet AuthorizationServiceRepliesOut is result AuthorizationResult
 with {
    briefly "What this service answers, on its way back"
  }
  inlet AuthorizationServiceRequests is query CheckAuthorization with {
    briefly "What this context asks the service to send"
  }
  handler AuthorizationServiceBoundary is {
    on query CheckAuthorization is {
      let askAnswer: type AuthorizationResult = prompt("look up what CheckAuthorization asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context AuthorizationService"
    }
  } with {
    briefly "AuthorizationService boundary"
  }
  query CheckAuthorization replies result AuthorizationResult is {
    memberId: MemberId with {
      briefly "Member"
      described as {
        |Member ID.
      }
    }
    procedureCode: ProcedureCode with {
      briefly "Procedure"
      described as {
        |Procedure code.
      }
    }
    serviceDate: Date with {
      briefly "Date"
      described as {
        |Service date.
      }
    }
  } with {
    briefly "Check authorization"
    described as {
      |Checks for prior authorization.
    }
  }
  result AuthorizationResult is {
    authorized: Boolean with {
      briefly "Authorized"
      described as {
        |Is authorized.
      }
    }
    authNumber: String(1,30)? with {
      briefly "Auth number"
      described as {
        |Authorization number.
      }
    }
    approvedUnits: Natural? with {
      briefly "Units"
      described as {
        |Approved units.
      }
    }
  } with {
    briefly "Authorization result"
    described as {
      |Prior authorization status.
    }
  }
} with {
  briefly "External authorization"
  described as {
    |External prior auth service.
  }
}
// Payment Service
external context PaymentService as flow is {
  outlet PaymentServiceEventsOut is event PaymentIssued
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet PaymentServiceRequests is command IssuePayment with {
    briefly "What this context asks the service to send"
  }
  handler PaymentServiceBoundary is {
    on command IssuePayment is {
      let paymentIssued: type PaymentIssued = prompt("the payment issued this produces")
      send paymentIssued to outlet PaymentService.PaymentServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context PaymentService"
    }
  } with {
    briefly "PaymentService boundary"
  }
  command IssuePayment is {
    claimId: ClaimId with {
      briefly "Claim"
      described as {
        |Claim ID.
      }
    }
    providerId: ProviderId with {
      briefly "Provider"
      described as {
        |Provider ID.
      }
    }
    amount: Decimal(12,2) with {
      briefly "Amount"
      described as {
        |Payment amount.
      }
    }
  } with {
    briefly "Issue payment"
    described as {
      |Issues provider payment.
    }
  }
  event PaymentIssued is {
    claimId: ClaimId with {
      briefly "Claim"
      described as {
        |Claim ID.
      }
    }
    checkNumber: String(1,30) with {
      briefly "Check"
      described as {
        |Check number.
      }
    }
    issuedAt: TimeStamp with {
      briefly "Issued"
      described as {
        |Issue time.
      }
    }
  } with {
    briefly "Payment issued"
    described as {
      |Emitted when payment is sent.
    }
  }
} with {
  briefly "External payment"
  described as {
    |External payment processing.
  }
}
// Notification Service
external context NotificationService as sink is {
  inlet NotificationServiceRequests is command SendClaimNotification with {
    briefly "What this context asks the service to send"
  }
  handler NotificationServiceBoundary is {
    on command SendClaimNotification is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context NotificationService"
    }
  } with {
    briefly "NotificationService boundary"
  }
  command SendClaimNotification is {
    claimId: ClaimId with {
      briefly "Claim"
      described as {
        |Claim ID.
      }
    }
    recipientType: String(1,20) with {
      briefly "Type"
      described as {
        |Recipient type.
      }
    }
    notificationType: String(1,50) with {
      briefly "Notification"
      described as {
        |Notification type.
      }
    }
    message: String(1,1000) with {
      briefly "Message"
      described as {
        |Message content.
      }
    }
  } with {
    briefly "Send notification"
    described as {
      |Sends claim notification.
    }
  }
  event NotificationSent is {
    notificationId: UUID with {
      briefly "Notification"
      described as {
        |Notification ID.
      }
    }
    sentAt: TimeStamp with {
      briefly "Sent"
      described as {
        |Send time.
      }
    }
  } with {
    briefly "Notification sent"
    described as {
      |Emitted when notification is delivered.
    }
  }
} with {
  briefly "External notifications"
  described as {
    |External notification system.
  }
}
