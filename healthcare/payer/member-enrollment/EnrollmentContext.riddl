// Enrollment Context for Member Enrollment Domain
context EnrollmentContext as router is {
  inlet EnrollmentCommandStreamIn is type EnrollmentCommand  outlet EnrollmentCommandStreamOut is type EnrollmentCommand
  inlet EnrollmentQueryResultStreamIn is type Enrollment.EnrollmentQueryResult  outlet EnrollmentQueryResultStreamOut is type Enrollment.EnrollmentQueryResult
  handler EnrollmentContextBoundary is {
    on initiateEnrollment: command Enrollment.InitiateEnrollment is {
      send initiateEnrollment to outlet EnrollmentContext.EnrollmentCommandStreamOut
    }
    on selectPlan: command Enrollment.SelectPlan is {
      send selectPlan to outlet EnrollmentContext.EnrollmentCommandStreamOut
    }
    on verifyEligibility: command Enrollment.VerifyEligibility is {
      send verifyEligibility to outlet EnrollmentContext.EnrollmentCommandStreamOut
    }
    on confirmEnrollment: command Enrollment.ConfirmEnrollment is {
      send confirmEnrollment to outlet EnrollmentContext.EnrollmentCommandStreamOut
    }
    on terminateCoverage: command Enrollment.TerminateCoverage is {
      send terminateCoverage to outlet EnrollmentContext.EnrollmentCommandStreamOut
    }
    on transferEnrollment: command Enrollment.TransferEnrollment is {
      send transferEnrollment to outlet EnrollmentContext.EnrollmentCommandStreamOut
    }
    on enrollmentQueryResult: result Enrollment.EnrollmentQueryResult is {
      send enrollmentQueryResult to outlet EnrollmentContext.EnrollmentQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the EnrollmentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'EnrollmentCommand Stream Intake' is from outlet EnrollmentContext.EnrollmentCommandStreamOut to inlet EnrollmentContext.Enrollment.EnrollmentCommands  connector 'EnrollmentQueryResult Stream Egress' is from outlet EnrollmentContext.EnrollmentRepository.EnrollmentRepositoryResponses to inlet EnrollmentContext.EnrollmentQueryResultStreamIn  include "types.riddl"
  include "Enrollment.riddl"
  repository EnrollmentRepository as merge is {
    command PersistCoverageTerminated is  {
      enrollmentId: EnrollmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row CoverageTerminated applies to.
        }
      }
    } with {
      briefly "Persist CoverageTerminated"
      described as {
        |Instructs this repository to apply CoverageTerminated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEnrollmentConfirmed is  {
      enrollmentId: EnrollmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row EnrollmentConfirmed applies to.
        }
      }
    } with {
      briefly "Persist EnrollmentConfirmed"
      described as {
        |Instructs this repository to apply EnrollmentConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEnrollmentInitiated is  {
      enrollmentId: EnrollmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row EnrollmentInitiated applies to.
        }
      }
    } with {
      briefly "Persist EnrollmentInitiated"
      described as {
        |Instructs this repository to apply EnrollmentInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEnrollmentTransferred is  {
      enrollmentId: EnrollmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row EnrollmentTransferred applies to.
        }
      }
    } with {
      briefly "Persist EnrollmentTransferred"
      described as {
        |Instructs this repository to apply EnrollmentTransferred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredEnrollment is  {
      enrollmentId: EnrollmentId with {
        briefly "enrollmentId"
        described as {
          |The enrollmentId column of the stored enrollment row.
        }
      }
    } with {
      briefly "Stored enrollment row"
      described as {
        |The persistence shape of enrollment data as this repository stores it.
      }
    }
    schema EnrollmentData is relational
      of enrollments as type StoredEnrollment
        index on field StoredEnrollment.enrollmentId
 with {
      briefly "Enrollment data schema"
      described as {
        |The relational schema persisting enrollment records for this repository.
      }
    }
    inlet EnrollmentRepositoryFromEnrollment is type EnrollmentEvent    inlet EnrollmentRepositoryFromEnrollmentMetrics is type EnrollmentEvent    outlet EnrollmentRepositoryResponses is type Enrollment.EnrollmentQueryResult
    record EnrollmentRecord is  {
      enrollmentId: EnrollmentId with {
        briefly "Enrollment ID"
        described as {
          |Enrollment identifier.
        }
      }
      memberId: MemberId with {
        briefly "Member ID"
        described as {
          |Member identifier.
        }
      }
      memberInfo: MemberInfo with {
        briefly "Member info"
        described as {
          |Member information.
        }
      }
      selectedPlan: PlanSelection? with {
        briefly "Plan"
        described as {
          |Selected plan.
        }
      }
      verifiedEligibility: EligibilityInfo? with {
        briefly "Eligibility"
        described as {
          |Eligibility info.
        }
      }
      activeCoverage: CoverageInfo? with {
        briefly "Coverage"
        described as {
          |Coverage details.
        }
      }
      status: EnrollmentStatus with {
        briefly "Status"
        described as {
          |Current status.
        }
      }
      createdAt: DateTime with {
        briefly "Created"
        described as {
          |Creation timestamp.
        }
      }
      updatedAt: DateTime with {
        briefly "Updated"
        described as {
          |Last update timestamp.
        }
      }
    } with {
      briefly "Persistent enrollment record"
      described as {
        | Complete enrollment record stored in the repository
        | including all lifecycle data and current status.
      }
    }
    record EnrollmentQuery is  {
      memberId: MemberId? with {
        briefly "Member ID"
        described as {
          |Filter by member.
        }
      }
      planId: PlanId? with {
        briefly "Plan ID"
        described as {
          |Filter by plan.
        }
      }
      status: EnrollmentStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      effectiveDateFrom: Date? with {
        briefly "From date"
        described as {
          |Effective date start.
        }
      }
      effectiveDateTo: Date? with {
        briefly "To date"
        described as {
          |Effective date end.
        }
      }
    } with {
      briefly "Query parameters for enrollment search"
      described as {
        | Flexible query structure supporting search by member,
        | plan, status, and date range combinations.
      }
    }
    record PageInfo is  {
      pageNumber: Natural with {
        briefly "Page"
        described as {
          |Current page number.
        }
      }
      pageSize: Natural with {
        briefly "Size"
        described as {
          |Records per page.
        }
      }
      totalPages: Natural with {
        briefly "Total pages"
        described as {
          |Total page count.
        }
      }
    } with {
      briefly "Pagination metadata"
      described as {
        |Information about result pagination.
      }
    }
    query FindEnrollmentById is  {
      enrollmentId: EnrollmentId with {
        briefly "Enrollment ID"
        described as {
          |The enrollment to find.
        }
      }
    } with {
      briefly "Find enrollment by unique ID"
      described as {
        | Retrieves a single enrollment record by its unique
        | identifier for detailed view or processing.
      }
    }
    result EnrollmentResult is  {
      enrollment: EnrollmentRecord? with {
        briefly "Enrollment"
        described as {
          |The found enrollment, if any.
        }
      }
    } with {
      briefly "Single enrollment query result"
      described as {
        |Result containing optional enrollment record.
      }
    }
    query FindEnrollmentsByMember is  {
      memberId: MemberId with {
        briefly "Member ID"
        described as {
          |The member to find enrollments for.
        }
      }
    } with {
      briefly "Find all enrollments for a member"
      described as {
        | Retrieves enrollment history for a member including
        | current and past enrollments.
      }
    }
    result MemberEnrollmentsResult is  {
      enrollments: EnrollmentRecord+ with {
        briefly "Enrollments"
        described as {
          |List of member enrollments.
        }
      }
    } with {
      briefly "List of member enrollments"
      described as {
        |Result containing all enrollments for a member.
      }
    }
    query FindEnrollmentsByPlan is  {
      planId: PlanId with {
        briefly "Plan ID"
        described as {
          |The plan to find enrollments for.
        }
      }
      status: EnrollmentStatus? with {
        briefly "Status filter"
        described as {
          |Optional status filter.
        }
      }
    } with {
      briefly "Find enrollments for a specific plan"
      described as {
        | Retrieves all enrollments for a plan, optionally
        | filtered by status for plan performance analysis.
      }
    }
    result PlanEnrollmentsResult is  {
      enrollments: EnrollmentRecord+ with {
        briefly "Enrollments"
        described as {
          |List of plan enrollments.
        }
      }
      totalCount: Natural with {
        briefly "Total count"
        described as {
          |Total number of enrollments.
        }
      }
    } with {
      briefly "List of plan enrollments with count"
      described as {
        |Result containing enrollments for a plan.
      }
    }
    query SearchEnrollments is  {
      queryParams: EnrollmentQuery with {
        briefly "Query parameters"
        described as {
          |Search criteria.
        }
      }
    } with {
      briefly "Search enrollments with flexible criteria"
      described as {
        | Flexible search supporting multiple filter combinations
        | for reporting and member services.
      }
    }
    result SearchResult is  {
      enrollments: EnrollmentRecord+ with {
        briefly "Enrollments"
        described as {
          |Matching enrollments.
        }
      }
      totalCount: Natural with {
        briefly "Total count"
        described as {
          |Total matches.
        }
      }
      pageInfo: PageInfo with {
        briefly "Page info"
        described as {
          |Pagination details.
        }
      }
    } with {
      briefly "Paginated search results"
      described as {
        |Paginated enrollment search results.
      }
    }
    handler EnrollmentRepositoryHandler is {
      on persistCoverageTerminated: command PersistCoverageTerminated is {
        do "apply CoverageTerminated to the stored row"
      }
      on persistEnrollmentConfirmed: command PersistEnrollmentConfirmed is {
        do "apply EnrollmentConfirmed to the stored row"
      }
      on persistEnrollmentInitiated: command PersistEnrollmentInitiated is {
        do "apply EnrollmentInitiated to the stored row"
      }
      on persistEnrollmentTransferred: command PersistEnrollmentTransferred is {
        do "apply EnrollmentTransferred to the stored row"
      }
      on query GetMetricsState is {
        let metricsStateView: type MetricsStateView = prompt("read the metrics state projection")
        reply metricsStateView
      }
      on query FindEnrollmentById is {
        let enrollmentResult: type EnrollmentResult = prompt("read the enrollment from the store")
        reply enrollmentResult
      }
      on query FindEnrollmentsByMember is {
        let memberEnrollmentsResult: type MemberEnrollmentsResult = prompt("read the member enrollments that enrollments by member asks for")
        reply memberEnrollmentsResult
      }
      on query FindEnrollmentsByPlan is {
        let planEnrollmentsResult: type PlanEnrollmentsResult = prompt("read the plan enrollments that enrollments by plan asks for")
        reply planEnrollmentsResult
      }
      on query SearchEnrollments is {
        let searchResult: type SearchResult = prompt("read the search that enrollments asks for")
        reply searchResult
      }
    } with {
      briefly "Handles enrollment persistence operations"
      described as {
        | Provides query capabilities for enrollment records
        | supporting member services and reporting needs.
      }
    }
  } with {
    briefly "Enrollment data persistence"
    described as {
      | Repository for storing and querying enrollment records.
      | Supports member lookup, plan analysis, and flexible search
      | for operational and reporting purposes.
    }
  }
  query GetMetricsState is  {
    metricsStateKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which metrics state to retrieve.
      }
    }
  } with {
    briefly "Get metrics state"
    described as {
      |Retrieves the metrics state projection.
    }
  }
  result MetricsStateView is  {
    metricsState: EnrollmentMetrics.MetricsState with {
      briefly "Metrics state"
      described as {
        |The metrics state being returned.
      }
    }
  } with {
    briefly "Metrics state view"
    described as {
      |Read model view carrying the metrics state projection.
    }
  }
  projector EnrollmentMetrics as flow is {
    updates repository EnrollmentContext.EnrollmentRepository
    inlet EnrollmentMetricsFromEnrollment is type EnrollmentEvent    outlet EnrollmentMetricsOut is type EnrollmentEvent
    record PlanEnrollmentCount is  {
      planId: PlanId with {
        briefly "Plan ID"
        described as {
          |Plan identifier.
        }
      }
      planName: String(1,100) with {
        briefly "Plan name"
        described as {
          |Plan name.
        }
      }
      activeCount: Natural with {
        briefly "Active"
        described as {
          |Active enrollments.
        }
      }
      pendingCount: Natural with {
        briefly "Pending"
        described as {
          |Pending enrollments.
        }
      }
    } with {
      briefly "Enrollment counts per plan"
      described as {
        |Aggregated enrollment counts for a plan.
      }
    }
    record PeriodEnrollmentCount is  {
      period: EnrollmentPeriod with {
        briefly "Period"
        described as {
          |Enrollment period.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Number of enrollments.
        }
      }
      month: Natural with {
        briefly "Month"
        described as {
          |Month number.
        }
      }
      year: Natural with {
        briefly "Year"
        described as {
          |Year.
        }
      }
    } with {
      briefly "Enrollment counts per period"
      described as {
        |Aggregated enrollment counts by period.
      }
    }
    record MetricsState is  {
      totalEnrollments: Natural with {
        briefly "Total"
        described as {
          |Total enrollments.
        }
      }
      activeEnrollments: Natural with {
        briefly "Active"
        described as {
          |Active enrollments.
        }
      }
      pendingEnrollments: Natural with {
        briefly "Pending"
        described as {
          |Pending enrollments.
        }
      }
      terminatedEnrollments: Natural with {
        briefly "Terminated"
        described as {
          |Terminated enrollments.
        }
      }
      enrollmentsByPlan: PlanEnrollmentCount+ with {
        briefly "By plan"
        described as {
          |Counts by plan.
        }
      }
      enrollmentsByPeriod: PeriodEnrollmentCount+ with {
        briefly "By period"
        described as {
          |Counts by period.
        }
      }
      averageProcessingDays: Natural with {
        briefly "Avg processing"
        described as {
          |Average processing days.
        }
      }
      lastUpdated: DateTime with {
        briefly "Updated"
        described as {
          |Last update time.
        }
      }
    } with {
      briefly "Current enrollment metrics snapshot"
      described as {
        | Aggregated metrics for enrollment operations including
        | counts by status, plan, and period for dashboards.
      }
    }
    handler MetricsHandler is {
      on enrollmentInitiated: event Enrollment.EnrollmentInitiated is {
        tell command EnrollmentContext.EnrollmentRepository.PersistEnrollmentInitiated(enrollmentId = enrollmentInitiated.enrollmentId) to repository EnrollmentContext.EnrollmentRepository
      }
      on enrollmentConfirmed: event Enrollment.EnrollmentConfirmed is {
        tell command EnrollmentContext.EnrollmentRepository.PersistEnrollmentConfirmed(enrollmentId = enrollmentConfirmed.enrollmentId) to repository EnrollmentContext.EnrollmentRepository
      }
      on coverageTerminated: event Enrollment.CoverageTerminated is {
        tell command EnrollmentContext.EnrollmentRepository.PersistCoverageTerminated(enrollmentId = coverageTerminated.enrollmentId) to repository EnrollmentContext.EnrollmentRepository
      }
      on enrollmentTransferred: event Enrollment.EnrollmentTransferred is {
        tell command EnrollmentContext.EnrollmentRepository.PersistEnrollmentTransferred(enrollmentId = enrollmentTransferred.enrollmentId) to repository EnrollmentContext.EnrollmentRepository
      }
    } with {
      briefly "Updates metrics on enrollment events"
      described as {
        | Processes enrollment lifecycle events to maintain
        | real-time metrics for operational dashboards.
      }
    }
  } with {
    briefly "Enrollment metrics projector"
    described as {
      | Maintains read-optimized view of enrollment metrics
      | for operational dashboards and executive reporting.
      | Updates in near real-time as enrollment events occur.
    }
  }
  // ---- Event publication for Enrollment ----
  type EnrollmentEvent is one of {
    EnrollmentContext.Enrollment.EnrollmentInitiated or EnrollmentContext.Enrollment.PlanSelected or EnrollmentContext.Enrollment.EligibilityVerified or EnrollmentContext.Enrollment.EnrollmentConfirmed or EnrollmentContext.Enrollment.CoverageTerminated or EnrollmentContext.Enrollment.EnrollmentTransferred
  } with {
    briefly "Enrollment event alternation"
    described as {
      |Union of all Enrollment events, for streaming and event-sourced
      |persistence.
    }
  }
  processor EnrollmentEventSource as source is {
    outlet EnrollmentEvents is type EnrollmentEvent
    handler EnrollmentSourceHandler is {
      on enrollmentInitiated: event Enrollment.EnrollmentInitiated is {
        send enrollmentInitiated to outlet EnrollmentEvents
      }
      on planSelected: event Enrollment.PlanSelected is {
        send planSelected to outlet EnrollmentEvents
      }
      on eligibilityVerified: event Enrollment.EligibilityVerified is {
        send eligibilityVerified to outlet EnrollmentEvents
      }
      on enrollmentConfirmed: event Enrollment.EnrollmentConfirmed is {
        send enrollmentConfirmed to outlet EnrollmentEvents
      }
      on coverageTerminated: event Enrollment.CoverageTerminated is {
        send coverageTerminated to outlet EnrollmentEvents
      }
      on enrollmentTransferred: event Enrollment.EnrollmentTransferred is {
        send enrollmentTransferred to outlet EnrollmentEvents
      }
      on other is {
        error "Unexpected message for source EnrollmentEventSource"
      }
    } with {
      briefly "Enrollment source handler"
      described as {
        |Publishes Enrollment events onto the outlet.
      }
    }
  } with {
    briefly "Enrollment event source"
    described as {
      |Publishes Enrollment entity events into the streaming topology.
    }
  }
  processor EnrollmentEventSink as sink is {
    inlet EnrollmentInlet is type EnrollmentEvent    handler EnrollmentSinkHandler is {
      on enrollmentInitiated: event Enrollment.EnrollmentInitiated is {
        tell enrollmentInitiated to repository EnrollmentContext.EnrollmentRepository
      }
      on planSelected: event Enrollment.PlanSelected is {
        tell planSelected to repository EnrollmentContext.EnrollmentRepository
      }
      on eligibilityVerified: event Enrollment.EligibilityVerified is {
        tell eligibilityVerified to repository EnrollmentContext.EnrollmentRepository
      }
      on enrollmentConfirmed: event Enrollment.EnrollmentConfirmed is {
        tell enrollmentConfirmed to repository EnrollmentContext.EnrollmentRepository
      }
      on coverageTerminated: event Enrollment.CoverageTerminated is {
        tell coverageTerminated to repository EnrollmentContext.EnrollmentRepository
      }
      on enrollmentTransferred: event Enrollment.EnrollmentTransferred is {
        tell enrollmentTransferred to repository EnrollmentContext.EnrollmentRepository
      }
      on other is {
        error "Unexpected message for sink EnrollmentEventSink"
      }
    } with {
      briefly "Enrollment sink handler"
      described as {
        |Persists Enrollment events via the repository.
      }
    }
  } with {
    briefly "Enrollment event sink"
    described as {
      |Receives Enrollment events for persistence.
    }
  }
  connector EnrollmentEventFlow is from outlet EnrollmentContext.EnrollmentEventSource.EnrollmentEvents to inlet EnrollmentContext.EnrollmentEventSink.EnrollmentInlet with {
    briefly "Enrollment event flow"
    described as {
      |Connects the Enrollment source to its sink.
    }
  }
  processor EnrollmentEventSplit as split is {
    inlet EnrollmentEventSplitIn is type EnrollmentEvent    outlet EnrollmentEventSplitToEnrollmentRepository is type EnrollmentEvent
    outlet EnrollmentEventSplitToEnrollmentMetrics is type EnrollmentEvent
    handler EnrollmentEventSplitHandler is {
      on enrollmentInitiated: event Enrollment.EnrollmentInitiated is {
        send enrollmentInitiated to outlet EnrollmentEventSplitToEnrollmentRepository
        send enrollmentInitiated to outlet EnrollmentEventSplitToEnrollmentMetrics
        tell enrollmentInitiated to entity EnrollmentContext.Enrollment
      }
      on planSelected: event Enrollment.PlanSelected is {
        send planSelected to outlet EnrollmentEventSplitToEnrollmentRepository
        send planSelected to outlet EnrollmentEventSplitToEnrollmentMetrics
        tell planSelected to entity EnrollmentContext.Enrollment
      }
      on eligibilityVerified: event Enrollment.EligibilityVerified is {
        send eligibilityVerified to outlet EnrollmentEventSplitToEnrollmentRepository
        send eligibilityVerified to outlet EnrollmentEventSplitToEnrollmentMetrics
        tell eligibilityVerified to entity EnrollmentContext.Enrollment
      }
      on enrollmentConfirmed: event Enrollment.EnrollmentConfirmed is {
        send enrollmentConfirmed to outlet EnrollmentEventSplitToEnrollmentRepository
        send enrollmentConfirmed to outlet EnrollmentEventSplitToEnrollmentMetrics
        tell enrollmentConfirmed to entity EnrollmentContext.Enrollment
      }
      on coverageTerminated: event Enrollment.CoverageTerminated is {
        send coverageTerminated to outlet EnrollmentEventSplitToEnrollmentRepository
        send coverageTerminated to outlet EnrollmentEventSplitToEnrollmentMetrics
        tell coverageTerminated to entity EnrollmentContext.Enrollment
      }
      on enrollmentTransferred: event Enrollment.EnrollmentTransferred is {
        send enrollmentTransferred to outlet EnrollmentEventSplitToEnrollmentRepository
        send enrollmentTransferred to outlet EnrollmentEventSplitToEnrollmentMetrics
        tell enrollmentTransferred to entity EnrollmentContext.Enrollment by enrollmentId
      }
      on other is {
        error "Unexpected message for processor EnrollmentEventSplit"
      }
    } with {
      briefly "Enrollment event fan-out handler"
      described as {
        |Delivers each Enrollment event to all of its consumers.
      }
    }
  } with {
    briefly "Enrollment event fan-out"
    described as {
      |Fans Enrollment events out to the repository and projectors.
    }
  }
  connector 'EnrollmentEvent Stream' is from outlet EnrollmentContext.Enrollment.EnrollmentEvents2 to inlet EnrollmentContext.EnrollmentEventSplit.EnrollmentEventSplitIn with {
    briefly "Enrollment events, fanned out to storage and read models"
  }
  connector 'EnrollmentEvent Storage' is from outlet EnrollmentContext.EnrollmentEventSplit.EnrollmentEventSplitToEnrollmentRepository to inlet EnrollmentContext.EnrollmentRepository.EnrollmentRepositoryFromEnrollment with {
    briefly "Enrollment events on their way to storage"
  }
  connector 'EnrollmentMetrics Feed' is from outlet EnrollmentContext.EnrollmentEventSplit.EnrollmentEventSplitToEnrollmentMetrics to inlet EnrollmentContext.EnrollmentMetrics.EnrollmentMetricsFromEnrollment with {
    briefly "Enrollment events feeding the EnrollmentMetrics projection"
  }
  connector 'EnrollmentMetrics Storage' is from outlet EnrollmentContext.EnrollmentMetrics.EnrollmentMetricsOut to inlet EnrollmentContext.EnrollmentRepository.EnrollmentRepositoryFromEnrollmentMetrics with {
    briefly "The EnrollmentMetrics projection on its way to storage"
  }
} with {
  briefly "Member enrollment bounded context"
  described as {
    | Primary bounded context for health plan member enrollment
    | operations. Manages enrollment lifecycle, eligibility
    | verification, plan selection, and coverage management.
    | Integrates with exchange systems, employer groups, and
    | benefits administration for end-to-end enrollment processing.
  }
}
