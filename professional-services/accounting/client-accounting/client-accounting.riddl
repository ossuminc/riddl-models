// Client Accounting Domain Model
// Accounting firm client services
domain ClientAccounting is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Client is "business or individual receiving accounting services" with {
    briefly "Client"
    described as {
      |Accounting client.
    }
  }
  user Accountant is "person providing accounting services" with {
    briefly "Accountant"
    described as {
      |Staff accountant.
    }
  }
  user Partner is "senior accountant overseeing engagements" with {
    briefly "Partner"
    described as {
      |Accounting partner.
    }
  }
  epic ClientAccountingEpic is {
    user Client wants to "professional accounting services" so that "their financial records are accurate"
    case EngageServices is {
      user Client wants to "to engage accounting services" so that "their books are properly maintained"
      step is "Client requests" "engagement proposal" "from firm" with {
        briefly "Request"
        described as {
          |Request services.
        }
      }
      step take input ClientAccountingApp.ClientAccountingScreen.CreateEngagementInput from user Accountant with {
        briefly "Create"
        described as {
          |Create engagement.
        }
      }
      step is "Accountant performs" "and delivers" "services" with {
        briefly "Deliver"
        described as {
          |Provide services.
        }
      }
    } with {
      briefly "Engage services"
      described as {
        |Service engagement workflow.
      }
    }
  } with {
    briefly "Client accounting"
    described as {
      | Epic covering client engagements,
      | bookkeeping, and financial reporting.
    }
  }
  include "EngagementContext.riddl"
  include "external-contexts.riddl"
  application context ClientAccountingApp is {
    group ClientAccountingScreen is {
      input CreateEngagementInput acquires command EngagementContext.Engagement.CreateEngagement with {
        briefly "Create engagement control"
        described as {
          |The control through which a user submits the create engagement request.
        }
      }
    } with {
      briefly "Client accounting screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppEngagementCommands is type EngagementContext.Engagement.EngagementCommand
    inlet AppEngagementRepositoryResponses is type EngagementContext.Engagement.EngagementQueryResult    handler ClientAccountingAppHandler is {
      on other is {
        error "Unexpected message for application context ClientAccountingApp"
      }
    } with {
      briefly "ClientAccountingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ClientAccountingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppEngagementCommands is from outlet ClientAccountingApp.AppEngagementCommands to inlet EngagementContext.Engagement.EngagementCommands with {
    option persistent()
    briefly "LinkAppEngagementCommands"
  }
  connector LinkAppEngagementRepositoryResponses is from outlet EngagementContext.EngagementRepository.EngagementRepositoryResponses to inlet ClientAccountingApp.AppEngagementRepositoryResponses with {
    option persistent()
    briefly "LinkAppEngagementRepositoryResponses"
  }
} with {
  briefly "Client accounting domain"
  described as {
    | The Client Accounting domain handles
    | accounting firm client services.
  }
}
