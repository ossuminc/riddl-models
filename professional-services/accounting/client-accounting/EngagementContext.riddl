// Client Accounting - Engagement Context
context EngagementContext as router is {
  inlet EngagementCommandStreamIn is type EngagementCommand  outlet EngagementCommandStreamOut is type EngagementCommand
  inlet EngagementQueryResultStreamIn is type Engagement.EngagementQueryResult  outlet EngagementQueryResultStreamOut is type Engagement.EngagementQueryResult
  handler EngagementContextBoundary is {
    on createEngagement: command Engagement.CreateEngagement is {
      send createEngagement to outlet EngagementContext.EngagementCommandStreamOut
    }
    on setupChartOfAccounts: command Engagement.SetupChartOfAccounts is {
      send setupChartOfAccounts to outlet EngagementContext.EngagementCommandStreamOut
    }
    on addAccount: command Engagement.AddAccount is {
      send addAccount to outlet EngagementContext.EngagementCommandStreamOut
    }
    on postJournalEntry: command Engagement.PostJournalEntry is {
      send postJournalEntry to outlet EngagementContext.EngagementCommandStreamOut
    }
    on reverseJournalEntry: command Engagement.ReverseJournalEntry is {
      send reverseJournalEntry to outlet EngagementContext.EngagementCommandStreamOut
    }
    on reconcileAccount: command Engagement.ReconcileAccount is {
      send reconcileAccount to outlet EngagementContext.EngagementCommandStreamOut
    }
    on generateFinancials: command Engagement.GenerateFinancials is {
      send generateFinancials to outlet EngagementContext.EngagementCommandStreamOut
    }
    on reviewFinancials: command Engagement.ReviewFinancials is {
      send reviewFinancials to outlet EngagementContext.EngagementCommandStreamOut
    }
    on recordTime: command Engagement.RecordTime is {
      send recordTime to outlet EngagementContext.EngagementCommandStreamOut
    }
    on generateInvoice: command Engagement.GenerateInvoice is {
      send generateInvoice to outlet EngagementContext.EngagementCommandStreamOut
    }
    on recordPayment: command Engagement.RecordPayment is {
      send recordPayment to outlet EngagementContext.EngagementCommandStreamOut
    }
    on closeEngagement: command Engagement.CloseEngagement is {
      send closeEngagement to outlet EngagementContext.EngagementCommandStreamOut
    }
    on engagementQueryResult: result Engagement.EngagementQueryResult is {
      send engagementQueryResult to outlet EngagementContext.EngagementQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the EngagementContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'EngagementCommand Stream Intake' is from outlet EngagementContext.EngagementCommandStreamOut to inlet EngagementContext.Engagement.EngagementCommands  connector 'EngagementQueryResult Stream Egress' is from outlet EngagementContext.EngagementRepository.EngagementRepositoryResponses to inlet EngagementContext.EngagementQueryResultStreamIn  adaptor FromBankFeedService from context BankFeedService is { 
    handler FromBankFeedServiceHandler is {
      on result BankFeedService.BankTransactionsResult is {
        do "the model receives bank transactions result"
      }
      on other is {
        error "Unexpected message for adaptor FromBankFeedService"
      }
    } with {
      briefly "from bank feed service"
      described as {
        |Carries messages from the external BankFeedService.
      }
    }
  } with {
    briefly "BankFeedService integration"
    described as {
      |The model's side of the BankFeedService conversation.
    }
  }
  adaptor ToBankFeedService to context BankFeedService is { 
    handler ToBankFeedServiceHandler is {
      on query BankFeedService.GetTransactions is {
        do "the model sends get transactions"
      }
      on other is {
        error "Unexpected message for adaptor ToBankFeedService"
      }
    } with {
      briefly "to bank feed service"
      described as {
        |Carries messages to the external BankFeedService.
      }
    }
  } with {
    briefly "BankFeedService integration"
    described as {
      |The model's side of the BankFeedService conversation.
    }
  }
  adaptor FromClientPortalService from context ClientPortalService is { 
    handler FromClientPortalServiceHandler is {
      on event ClientPortalService.ClientAccessedDocument is {
        do "the model receives client accessed document"
      }
      on event ClientPortalService.DocumentPublished is {
        do "the model receives document published"
      }
      on other is {
        error "Unexpected message for adaptor FromClientPortalService"
      }
    } with {
      briefly "from client portal service"
      described as {
        |Carries messages from the external ClientPortalService.
      }
    }
  } with {
    briefly "ClientPortalService integration"
    described as {
      |The model's side of the ClientPortalService conversation.
    }
  }
  adaptor ToClientPortalService to context ClientPortalService is { 
    handler ToClientPortalServiceHandler is {
      on command ClientPortalService.PublishDocument is {
        do "the model sends publish document"
      }
      on other is {
        error "Unexpected message for adaptor ToClientPortalService"
      }
    } with {
      briefly "to client portal service"
      described as {
        |Carries messages to the external ClientPortalService.
      }
    }
  } with {
    briefly "ClientPortalService integration"
    described as {
      |The model's side of the ClientPortalService conversation.
    }
  }
  adaptor FromDocumentStorageService from context DocumentStorageService is { 
    handler FromDocumentStorageServiceHandler is {
      on result DocumentStorageService.DocumentResult is {
        do "the model receives document result"
      }
      on event DocumentStorageService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentStorageService"
      }
    } with {
      briefly "from document storage service"
      described as {
        |Carries messages from the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor ToDocumentStorageService to context DocumentStorageService is { 
    handler ToDocumentStorageServiceHandler is {
      on query DocumentStorageService.RetrieveDocument is {
        do "the model sends retrieve document"
      }
      on command DocumentStorageService.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentStorageService"
      }
    } with {
      briefly "to document storage service"
      described as {
        |Carries messages to the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.PaymentProcessed is {
        do "the model receives payment processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.ProcessPayment is {
        do "the model sends process payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor FromTaxService from context TaxService is { 
    handler FromTaxServiceHandler is {
      on event TaxService.TaxLiabilityCalculated is {
        do "the model receives tax liability calculated"
      }
      on result TaxService.TaxRatesResult is {
        do "the model receives tax rates result"
      }
      on other is {
        error "Unexpected message for adaptor FromTaxService"
      }
    } with {
      briefly "from tax service"
      described as {
        |Carries messages from the external TaxService.
      }
    }
  } with {
    briefly "TaxService integration"
    described as {
      |The model's side of the TaxService conversation.
    }
  }
  adaptor ToTaxService to context TaxService is { 
    handler ToTaxServiceHandler is {
      on command TaxService.CalculateTaxLiability is {
        do "the model sends calculate tax liability"
      }
      on query TaxService.GetTaxRates is {
        do "the model sends get tax rates"
      }
      on other is {
        error "Unexpected message for adaptor ToTaxService"
      }
    } with {
      briefly "to tax service"
      described as {
        |Carries messages to the external TaxService.
      }
    }
  } with {
    briefly "TaxService integration"
    described as {
      |The model's side of the TaxService conversation.
    }
  }
  include "types.riddl"
  include "Engagement.riddl"
  // Repository
  type EngagementRepositoryCommand is one of {
    EngagementContext.EngagementRepository.PersistAccountAdded or EngagementContext.EngagementRepository.PersistAccountReconciled or EngagementContext.EngagementRepository.PersistChartOfAccountsConfigured or EngagementContext.EngagementRepository.PersistEngagementClosed or EngagementContext.EngagementRepository.PersistEngagementCreated or EngagementContext.EngagementRepository.PersistFinancialsGenerated or EngagementContext.EngagementRepository.PersistFinancialsReviewed or EngagementContext.EngagementRepository.PersistInvoiceGenerated or EngagementContext.EngagementRepository.PersistJournalEntryPosted or EngagementContext.EngagementRepository.PersistJournalEntryReversed or EngagementContext.EngagementRepository.PersistPaymentRecorded or EngagementContext.EngagementRepository.PersistTimeRecorded
  } with {
    briefly "Anything that writes EngagementRepository"
    described as {
      |The persistence commands EngagementRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository EngagementRepository as flow is {
    inlet EngagementRepositoryFromBillingAnalytics is type EngagementRepositoryCommand
    command PersistAccountAdded is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountAdded applies to.
        }
      }
    } with {
      briefly "Persist AccountAdded"
      described as {
        |Instructs this repository to apply AccountAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountReconciled is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountReconciled applies to.
        }
      }
    } with {
      briefly "Persist AccountReconciled"
      described as {
        |Instructs this repository to apply AccountReconciled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistChartOfAccountsConfigured is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row ChartOfAccountsConfigured applies to.
        }
      }
    } with {
      briefly "Persist ChartOfAccountsConfigured"
      described as {
        |Instructs this repository to apply ChartOfAccountsConfigured to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEngagementClosed is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row EngagementClosed applies to.
        }
      }
    } with {
      briefly "Persist EngagementClosed"
      described as {
        |Instructs this repository to apply EngagementClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEngagementCreated is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row EngagementCreated applies to.
        }
      }
    } with {
      briefly "Persist EngagementCreated"
      described as {
        |Instructs this repository to apply EngagementCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFinancialsGenerated is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row FinancialsGenerated applies to.
        }
      }
    } with {
      briefly "Persist FinancialsGenerated"
      described as {
        |Instructs this repository to apply FinancialsGenerated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFinancialsReviewed is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row FinancialsReviewed applies to.
        }
      }
    } with {
      briefly "Persist FinancialsReviewed"
      described as {
        |Instructs this repository to apply FinancialsReviewed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistJournalEntryPosted is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row JournalEntryPosted applies to.
        }
      }
    } with {
      briefly "Persist JournalEntryPosted"
      described as {
        |Instructs this repository to apply JournalEntryPosted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistJournalEntryReversed is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row JournalEntryReversed applies to.
        }
      }
    } with {
      briefly "Persist JournalEntryReversed"
      described as {
        |Instructs this repository to apply JournalEntryReversed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInvoiceGenerated is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row InvoiceGenerated applies to.
        }
      }
    } with {
      briefly "Persist InvoiceGenerated"
      described as {
        |Instructs this repository to apply InvoiceGenerated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentRecorded is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentRecorded applies to.
        }
      }
    } with {
      briefly "Persist PaymentRecorded"
      described as {
        |Instructs this repository to apply PaymentRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTimeRecorded is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row TimeRecorded applies to.
        }
      }
    } with {
      briefly "Persist TimeRecorded"
      described as {
        |Instructs this repository to apply TimeRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredEngagement is  {
      engagementId: EngagementId with {
        briefly "engagementId"
        described as {
          |The engagementId column of the stored engagement row.
        }
      }
    } with {
      briefly "Stored engagement row"
      described as {
        |The persistence shape of engagement data as this repository stores it.
      }
    }
    schema EngagementData is relational
      of engagements as type StoredEngagement
        index on field StoredEngagement.engagementId
 with {
      briefly "Engagement data schema"
      described as {
        |The relational schema persisting engagement records for this repository.
      }
    }
    outlet EngagementRepositoryResponses is type Engagement.EngagementQueryResult
    query FindEngagementById replies result EngagementResult is  {
      engagementId: EngagementId with {
        briefly "Engagement"
        described as {
          |Engagement identifier.
        }
      }
    } with {
      briefly "Find engagement by ID"
      described as {
        |Retrieves engagement by identifier.
      }
    }
    result EngagementResult is  {
      engagement: Engagement.ActiveStateData with {
        briefly "Engagement"
        described as {
          |Engagement data.
        }
      }
    } with {
      briefly "Engagement result"
      described as {
        |Returns engagement data.
      }
    }
    query SearchEngagements replies result EngagementsResult is  {
      filterStatus: EngagementStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      filterAccountantId: AccountantId? with {
        briefly "Accountant"
        described as {
          |Filter by accountant.
        }
      }
      filterServiceType: ServiceType? with {
        briefly "Service"
        described as {
          |Filter by service type.
        }
      }
    } with {
      briefly "Search engagements"
      described as {
        |Searches engagements by criteria.
      }
    }
    result EngagementsResult is  {
      engagements: Engagement.ActiveStateData+ with {
        briefly "Engagements"
        described as {
          |Matching engagements.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Engagements result"
      described as {
        |Returns matching engagements.
      }
    }
    query FindByClient replies result EngagementsResult is  {
      clientId: ClientId with {
        briefly "Client"
        described as {
          |Client identifier.
        }
      }
    } with {
      briefly "Find by client"
      described as {
        |Finds engagements for client.
      }
    }
    query GetTrialBalance replies result EngagementResult is  {
      engagementId: EngagementId with {
        briefly "Engagement"
        described as {
          |Engagement identifier.
        }
      }
      asOfDate: Date with {
        briefly "Date"
        described as {
          |As-of date.
        }
      }
    } with {
      briefly "Get trial balance"
      described as {
        |Generates trial balance.
      }
    }
    handler EngagementRepositoryHandler is {
      on persistAccountAdded: command PersistAccountAdded is {
        do "apply AccountAdded to the stored row"
      }
      on persistAccountReconciled: command PersistAccountReconciled is {
        do "apply AccountReconciled to the stored row"
      }
      on persistChartOfAccountsConfigured: command PersistChartOfAccountsConfigured is {
        do "apply ChartOfAccountsConfigured to the stored row"
      }
      on persistEngagementClosed: command PersistEngagementClosed is {
        do "apply EngagementClosed to the stored row"
      }
      on persistEngagementCreated: command PersistEngagementCreated is {
        do "apply EngagementCreated to the stored row"
      }
      on persistFinancialsGenerated: command PersistFinancialsGenerated is {
        do "apply FinancialsGenerated to the stored row"
      }
      on persistFinancialsReviewed: command PersistFinancialsReviewed is {
        do "apply FinancialsReviewed to the stored row"
      }
      on persistJournalEntryPosted: command PersistJournalEntryPosted is {
        do "apply JournalEntryPosted to the stored row"
      }
      on persistJournalEntryReversed: command PersistJournalEntryReversed is {
        do "apply JournalEntryReversed to the stored row"
      }
      on persistInvoiceGenerated: command PersistInvoiceGenerated is {
        do "apply InvoiceGenerated to the stored row"
      }
      on persistPaymentRecorded: command PersistPaymentRecorded is {
        do "apply PaymentRecorded to the stored row"
      }
      on persistTimeRecorded: command PersistTimeRecorded is {
        do "apply TimeRecorded to the stored row"
      }
      on query GetAnalyticsData is {
        let analyticsDataView: type AnalyticsDataView = prompt("read the analytics data projection")
        reply analyticsDataView
      }
      on query FindEngagementById is {
        let engagementResult: type EngagementResult = prompt("read the engagement from the store")
        reply engagementResult
      }
      on query SearchEngagements is {
        let engagementsResult: type EngagementsResult = prompt("read the engagements from the store")
        reply engagementsResult
      }
      on query FindByClient is {
        let engagementsResult: type EngagementsResult = prompt("read the engagements that by client asks for")
        reply engagementsResult
      }
      on query GetTrialBalance is {
        let engagementResult: type EngagementResult = prompt("read the engagement that trial balance asks for")
        reply engagementResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes engagement queries.
      }
    }
  } with {
    briefly "Engagement repository"
    described as {
      |Persistence for engagement records.
    }
  }
  // Projector for billing analytics
  query GetAnalyticsData replies result AnalyticsDataView is  {
    analyticsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which analytics data to retrieve.
      }
    }
  } with {
    briefly "Get analytics data"
    described as {
      |Retrieves the analytics data projection.
    }
  }
  result AnalyticsDataView is  {
    analyticsData: BillingAnalytics.AnalyticsData with {
      briefly "Analytics data"
      described as {
        |The analytics data being returned.
      }
    }
  } with {
    briefly "Analytics data view"
    described as {
      |Read model view carrying the analytics data projection.
    }
  }
  projector BillingAnalytics as flow is {
    outlet BillingAnalyticsToRepository is type EngagementRepositoryCommand
    updates repository EngagementContext.EngagementRepository
    inlet BillingAnalyticsFromEngagement is type EngagementEvent
    record AnalyticsData is  {
      totalBillableHours: Decimal(10,2) with {
        briefly "Hours"
        described as {
          |Total billable hours.
        }
      }
      totalFeesBilled: Decimal(12,2) with {
        briefly "Billed"
        described as {
          |Total fees billed.
        }
      }
      totalCollected: Decimal(12,2) with {
        briefly "Collected"
        described as {
          |Total collected.
        }
      }
      outstandingAR: Decimal(12,2) with {
        briefly "AR"
        described as {
          |Outstanding receivables.
        }
      }
      utilizationByAccountant: AccountantUtilization+ with {
        briefly "Utilization"
        described as {
          |Utilization by accountant.
        }
      }
      revenueByServiceType: ServiceRevenue+ with {
        briefly "By service"
        described as {
          |Revenue by service type.
        }
      }
    } with {
      briefly "Analytics data"
      described as {
        |Billing metrics.
      }
    }
    record AccountantUtilization is  {
      accountantId: AccountantId with {
        briefly "Accountant"
        described as {
          |Accountant ID.
        }
      }
      billableHours: Decimal(8,2) with {
        briefly "Billable"
        described as {
          |Billable hours.
        }
      }
      totalHours: Decimal(8,2) with {
        briefly "Total"
        described as {
          |Total hours.
        }
      }
      utilizationRate: Decimal(5,2) with {
        briefly "Rate"
        described as {
          |Utilization percentage.
        }
      }
    } with {
      briefly "Accountant utilization"
      described as {
        |Utilization for accountant.
      }
    }
    record ServiceRevenue is  {
      serviceType: ServiceType with {
        briefly "Service"
        described as {
          |Service type.
        }
      }
      revenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Service revenue.
        }
      }
    } with {
      briefly "Service revenue"
      described as {
        |Revenue for service type.
      }
    }
    handler AnalyticsHandler is {
      on accountAdded: event Engagement.AccountAdded is {
        tell command EngagementContext.EngagementRepository.PersistAccountAdded(engagementId = accountAdded.engagementId) to repository EngagementContext.EngagementRepository
        do "apply AccountAdded to the BillingAnalytics projection"
      }
      on accountReconciled: event Engagement.AccountReconciled is {
        tell command EngagementContext.EngagementRepository.PersistAccountReconciled(engagementId = accountReconciled.engagementId) to repository EngagementContext.EngagementRepository
        do "apply AccountReconciled to the BillingAnalytics projection"
      }
      on chartOfAccountsConfigured: event Engagement.ChartOfAccountsConfigured is {
        tell command EngagementContext.EngagementRepository.PersistChartOfAccountsConfigured(engagementId = chartOfAccountsConfigured.engagementId) to repository EngagementContext.EngagementRepository
        do "apply ChartOfAccountsConfigured to the BillingAnalytics projection"
      }
      on engagementClosed: event Engagement.EngagementClosed is {
        tell command EngagementContext.EngagementRepository.PersistEngagementClosed(engagementId = engagementClosed.engagementId) to repository EngagementContext.EngagementRepository
        do "apply EngagementClosed to the BillingAnalytics projection"
      }
      on engagementCreated: event Engagement.EngagementCreated is {
        tell command EngagementContext.EngagementRepository.PersistEngagementCreated(engagementId = engagementCreated.engagementId) to repository EngagementContext.EngagementRepository
        do "apply EngagementCreated to the BillingAnalytics projection"
      }
      on financialsGenerated: event Engagement.FinancialsGenerated is {
        tell command EngagementContext.EngagementRepository.PersistFinancialsGenerated(engagementId = financialsGenerated.engagementId) to repository EngagementContext.EngagementRepository
        do "apply FinancialsGenerated to the BillingAnalytics projection"
      }
      on financialsReviewed: event Engagement.FinancialsReviewed is {
        tell command EngagementContext.EngagementRepository.PersistFinancialsReviewed(engagementId = financialsReviewed.engagementId) to repository EngagementContext.EngagementRepository
        do "apply FinancialsReviewed to the BillingAnalytics projection"
      }
      on journalEntryPosted: event Engagement.JournalEntryPosted is {
        tell command EngagementContext.EngagementRepository.PersistJournalEntryPosted(engagementId = journalEntryPosted.engagementId) to repository EngagementContext.EngagementRepository
        do "apply JournalEntryPosted to the BillingAnalytics projection"
      }
      on journalEntryReversed: event Engagement.JournalEntryReversed is {
        tell command EngagementContext.EngagementRepository.PersistJournalEntryReversed(engagementId = journalEntryReversed.engagementId) to repository EngagementContext.EngagementRepository
        do "apply JournalEntryReversed to the BillingAnalytics projection"
      }
      on timeRecorded: event Engagement.TimeRecorded is {
        tell command EngagementContext.EngagementRepository.PersistTimeRecorded(engagementId = timeRecorded.engagementId) to repository EngagementContext.EngagementRepository
      }
      on invoiceGenerated: event Engagement.InvoiceGenerated is {
        tell command EngagementContext.EngagementRepository.PersistInvoiceGenerated(engagementId = invoiceGenerated.engagementId) to repository EngagementContext.EngagementRepository
      }
      on paymentRecorded: event Engagement.PaymentRecorded is {
        tell command EngagementContext.EngagementRepository.PersistPaymentRecorded(engagementId = paymentRecorded.engagementId) to repository EngagementContext.EngagementRepository
      }
    } with {
      briefly "Processes analytics events"
      described as {
        |Updates billing analytics.
      }
    }
  } with {
    briefly "Billing analytics"
    described as {
      |Projects billing metrics for reporting.
    }
  }
  // ---- Event publication for Engagement ----
  type EngagementEvent is one of {
    EngagementContext.Engagement.EngagementCreated or EngagementContext.Engagement.ChartOfAccountsConfigured or EngagementContext.Engagement.AccountAdded or EngagementContext.Engagement.JournalEntryPosted or EngagementContext.Engagement.JournalEntryReversed or EngagementContext.Engagement.AccountReconciled or EngagementContext.Engagement.FinancialsGenerated or EngagementContext.Engagement.FinancialsReviewed or EngagementContext.Engagement.TimeRecorded or EngagementContext.Engagement.InvoiceGenerated or EngagementContext.Engagement.PaymentRecorded or EngagementContext.Engagement.EngagementClosed
  } with {
    briefly "Engagement event alternation"
    described as {
      |Union of all Engagement events, for streaming and event-sourced
      |persistence.
    }
  }
  processor EngagementEventSplit as flow is {
    inlet EngagementEventSplitIn is type EngagementEvent
    outlet EngagementEventSplitToBillingAnalytics is type EngagementEvent
    handler EngagementEventSplitHandler is {
      on engagementCreated: event Engagement.EngagementCreated is {
        send engagementCreated to outlet EngagementEventSplitToBillingAnalytics
        tell engagementCreated to entity EngagementContext.Engagement
      }
      on chartOfAccountsConfigured: event Engagement.ChartOfAccountsConfigured is {
        send chartOfAccountsConfigured to outlet EngagementEventSplitToBillingAnalytics
        tell chartOfAccountsConfigured to entity EngagementContext.Engagement
      }
      on accountAdded: event Engagement.AccountAdded is {
        send accountAdded to outlet EngagementEventSplitToBillingAnalytics
        tell accountAdded to entity EngagementContext.Engagement
      }
      on journalEntryPosted: event Engagement.JournalEntryPosted is {
        send journalEntryPosted to outlet EngagementEventSplitToBillingAnalytics
        tell journalEntryPosted to entity EngagementContext.Engagement
      }
      on journalEntryReversed: event Engagement.JournalEntryReversed is {
        send journalEntryReversed to outlet EngagementEventSplitToBillingAnalytics
        tell journalEntryReversed to entity EngagementContext.Engagement
      }
      on accountReconciled: event Engagement.AccountReconciled is {
        send accountReconciled to outlet EngagementEventSplitToBillingAnalytics
        tell accountReconciled to entity EngagementContext.Engagement
      }
      on financialsGenerated: event Engagement.FinancialsGenerated is {
        send financialsGenerated to outlet EngagementEventSplitToBillingAnalytics
        tell financialsGenerated to entity EngagementContext.Engagement
      }
      on financialsReviewed: event Engagement.FinancialsReviewed is {
        send financialsReviewed to outlet EngagementEventSplitToBillingAnalytics
        tell financialsReviewed to entity EngagementContext.Engagement
      }
      on timeRecorded: event Engagement.TimeRecorded is {
        send timeRecorded to outlet EngagementEventSplitToBillingAnalytics
        tell timeRecorded to entity EngagementContext.Engagement
      }
      on invoiceGenerated: event Engagement.InvoiceGenerated is {
        send invoiceGenerated to outlet EngagementEventSplitToBillingAnalytics
        tell invoiceGenerated to entity EngagementContext.Engagement
      }
      on paymentRecorded: event Engagement.PaymentRecorded is {
        send paymentRecorded to outlet EngagementEventSplitToBillingAnalytics
        tell paymentRecorded to entity EngagementContext.Engagement
      }
      on engagementClosed: event Engagement.EngagementClosed is {
        send engagementClosed to outlet EngagementEventSplitToBillingAnalytics
        tell engagementClosed to entity EngagementContext.Engagement
      }
      on other is {
        error "Unexpected message for processor EngagementEventSplit"
      }
    } with {
      briefly "Engagement event fan-out handler"
      described as {
        |Delivers each Engagement event to all of its consumers.
      }
    }
  } with {
    briefly "Engagement event fan-out"
    described as {
      |Fans Engagement events out to the repository and projectors.
    }
  }
  connector 'EngagementEvent Stream' is from outlet EngagementContext.Engagement.EngagementEvents2 to inlet EngagementContext.EngagementEventSplit.EngagementEventSplitIn with {
    briefly "Engagement events, fanned out to storage and read models"
  }
  connector 'BillingAnalytics Feed' is from outlet EngagementContext.EngagementEventSplit.EngagementEventSplitToBillingAnalytics to inlet EngagementContext.BillingAnalytics.BillingAnalyticsFromEngagement with {
    briefly "Engagement events feeding the BillingAnalytics projection"
  }
  connector 'BillingAnalytics Storage' is from outlet EngagementContext.BillingAnalytics.BillingAnalyticsToRepository to inlet EngagementContext.EngagementRepository.EngagementRepositoryFromBillingAnalytics with {
    briefly "BillingAnalytics updates on their way to storage"
  }
} with {
  briefly "Engagement context"
  described as {
    | The Engagement context manages client
    | accounting engagements.
  }
}
