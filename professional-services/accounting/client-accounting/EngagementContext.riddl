// Client Accounting - Engagement Context
context EngagementContext is {
  include "types.riddl"
  include "Engagement.riddl"
  // Repository
  repository EngagementRepository is {
    query FindEngagementById is  {
      engagementId: EngagementId with {
        briefly "Engagement"
        described as {
          |Engagement identifier.
        }
      }
    } with {
      briefly "Find engagement by ID"
      described as {
        |Retrieves engagement by identifier.
      }
    }
    result EngagementResult is  {
      engagement: Engagement.ActiveStateData with {
        briefly "Engagement"
        described as {
          |Engagement data.
        }
      }
    } with {
      briefly "Engagement result"
      described as {
        |Returns engagement data.
      }
    }
    query SearchEngagements is  {
      filterStatus: EngagementStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      filterAccountantId: AccountantId? with {
        briefly "Accountant"
        described as {
          |Filter by accountant.
        }
      }
      filterServiceType: ServiceType? with {
        briefly "Service"
        described as {
          |Filter by service type.
        }
      }
    } with {
      briefly "Search engagements"
      described as {
        |Searches engagements by criteria.
      }
    }
    result EngagementsResult is  {
      engagements: Engagement.ActiveStateData+ with {
        briefly "Engagements"
        described as {
          |Matching engagements.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Engagements result"
      described as {
        |Returns matching engagements.
      }
    }
    query FindByClient is  {
      clientId: ClientId with {
        briefly "Client"
        described as {
          |Client identifier.
        }
      }
    } with {
      briefly "Find by client"
      described as {
        |Finds engagements for client.
      }
    }
    query GetTrialBalance is  {
      engagementId: EngagementId with {
        briefly "Engagement"
        described as {
          |Engagement identifier.
        }
      }
      asOfDate: Date with {
        briefly "Date"
        described as {
          |As-of date.
        }
      }
    } with {
      briefly "Get trial balance"
      described as {
        |Generates trial balance.
      }
    }
    handler EngagementRepositoryHandler is {
      on query FindEngagementById is { ??? }
      on query SearchEngagements is { ??? }
      on query FindByClient is { ??? }
      on query GetTrialBalance is { ??? }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes engagement queries.
      }
    }
  } with {
    briefly "Engagement repository"
    described as {
      |Persistence for engagement records.
    }
  }
  // Projector for billing analytics
  projector BillingAnalytics is {
    updates repository EngagementContext.EngagementRepository
    record AnalyticsData is  {
      totalBillableHours: Decimal(10,2) with {
        briefly "Hours"
        described as {
          |Total billable hours.
        }
      }
      totalFeesBilled: Decimal(12,2) with {
        briefly "Billed"
        described as {
          |Total fees billed.
        }
      }
      totalCollected: Decimal(12,2) with {
        briefly "Collected"
        described as {
          |Total collected.
        }
      }
      outstandingAR: Decimal(12,2) with {
        briefly "AR"
        described as {
          |Outstanding receivables.
        }
      }
      utilizationByAccountant: AccountantUtilization+ with {
        briefly "Utilization"
        described as {
          |Utilization by accountant.
        }
      }
      revenueByServiceType: ServiceRevenue+ with {
        briefly "By service"
        described as {
          |Revenue by service type.
        }
      }
    } with {
      briefly "Analytics data"
      described as {
        |Billing metrics.
      }
    }
    record AccountantUtilization is  {
      accountantId: AccountantId with {
        briefly "Accountant"
        described as {
          |Accountant ID.
        }
      }
      billableHours: Decimal(8,2) with {
        briefly "Billable"
        described as {
          |Billable hours.
        }
      }
      totalHours: Decimal(8,2) with {
        briefly "Total"
        described as {
          |Total hours.
        }
      }
      utilizationRate: Decimal(5,2) with {
        briefly "Rate"
        described as {
          |Utilization percentage.
        }
      }
    } with {
      briefly "Accountant utilization"
      described as {
        |Utilization for accountant.
      }
    }
    record ServiceRevenue is  {
      serviceType: ServiceType with {
        briefly "Service"
        described as {
          |Service type.
        }
      }
      revenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Service revenue.
        }
      }
    } with {
      briefly "Service revenue"
      described as {
        |Revenue for service type.
      }
    }
    handler AnalyticsHandler is {
      on event Engagement.TimeRecorded is {
        tell event Engagement.TimeRecorded to repository EngagementContext.EngagementRepository
      }
      on event Engagement.InvoiceGenerated is {
        tell event Engagement.InvoiceGenerated to repository EngagementContext.EngagementRepository
      }
      on event Engagement.PaymentRecorded is {
        tell event Engagement.PaymentRecorded to repository EngagementContext.EngagementRepository
      }
    } with {
      briefly "Processes analytics events"
      described as {
        |Updates billing analytics.
      }
    }
  } with {
    briefly "Billing analytics"
    described as {
      |Projects billing metrics for reporting.
    }
  }
  // ---- Event publication for Engagement ----
  type EngagementEvent is one of {
    EngagementContext.Engagement.EngagementCreated,
    EngagementContext.Engagement.ChartOfAccountsConfigured,
    EngagementContext.Engagement.AccountAdded,
    EngagementContext.Engagement.JournalEntryPosted,
    EngagementContext.Engagement.JournalEntryReversed,
    EngagementContext.Engagement.AccountReconciled,
    EngagementContext.Engagement.FinancialsGenerated,
    EngagementContext.Engagement.FinancialsReviewed,
    EngagementContext.Engagement.TimeRecorded,
    EngagementContext.Engagement.InvoiceGenerated,
    EngagementContext.Engagement.PaymentRecorded,
    EngagementContext.Engagement.EngagementClosed
  } with {
    briefly "Engagement event alternation"
    described as {
      |Union of all Engagement events, for streaming and event-sourced
      |persistence.
    }
  }
  source EngagementEventSource is {
    outlet EngagementEvents is type EngagementEvent
    handler EngagementSourceHandler is {
      on event Engagement.EngagementCreated is {
        send event Engagement.EngagementCreated to outlet EngagementEvents
      }
      on event Engagement.ChartOfAccountsConfigured is {
        send event Engagement.ChartOfAccountsConfigured to outlet EngagementEvents
      }
      on event Engagement.AccountAdded is {
        send event Engagement.AccountAdded to outlet EngagementEvents
      }
      on event Engagement.JournalEntryPosted is {
        send event Engagement.JournalEntryPosted to outlet EngagementEvents
      }
      on event Engagement.JournalEntryReversed is {
        send event Engagement.JournalEntryReversed to outlet EngagementEvents
      }
      on event Engagement.AccountReconciled is {
        send event Engagement.AccountReconciled to outlet EngagementEvents
      }
      on event Engagement.FinancialsGenerated is {
        send event Engagement.FinancialsGenerated to outlet EngagementEvents
      }
      on event Engagement.FinancialsReviewed is {
        send event Engagement.FinancialsReviewed to outlet EngagementEvents
      }
      on event Engagement.TimeRecorded is {
        send event Engagement.TimeRecorded to outlet EngagementEvents
      }
      on event Engagement.InvoiceGenerated is {
        send event Engagement.InvoiceGenerated to outlet EngagementEvents
      }
      on event Engagement.PaymentRecorded is {
        send event Engagement.PaymentRecorded to outlet EngagementEvents
      }
      on event Engagement.EngagementClosed is {
        send event Engagement.EngagementClosed to outlet EngagementEvents
      }
      on other is {
        error "Unexpected message for source EngagementEventSource"
      }
    } with {
      briefly "Engagement source handler"
      described as {
        |Publishes Engagement events onto the outlet.
      }
    }
  } with {
    briefly "Engagement event source"
    described as {
      |Publishes Engagement entity events into the streaming topology.
    }
  }
  sink EngagementEventSink is {
    inlet EngagementInlet is type EngagementEvent
    handler EngagementSinkHandler is {
      on event Engagement.EngagementCreated is {
        tell event Engagement.EngagementCreated to repository EngagementContext.EngagementRepository
      }
      on event Engagement.ChartOfAccountsConfigured is {
        tell event Engagement.ChartOfAccountsConfigured to repository EngagementContext.EngagementRepository
      }
      on event Engagement.AccountAdded is {
        tell event Engagement.AccountAdded to repository EngagementContext.EngagementRepository
      }
      on event Engagement.JournalEntryPosted is {
        tell event Engagement.JournalEntryPosted to repository EngagementContext.EngagementRepository
      }
      on event Engagement.JournalEntryReversed is {
        tell event Engagement.JournalEntryReversed to repository EngagementContext.EngagementRepository
      }
      on event Engagement.AccountReconciled is {
        tell event Engagement.AccountReconciled to repository EngagementContext.EngagementRepository
      }
      on event Engagement.FinancialsGenerated is {
        tell event Engagement.FinancialsGenerated to repository EngagementContext.EngagementRepository
      }
      on event Engagement.FinancialsReviewed is {
        tell event Engagement.FinancialsReviewed to repository EngagementContext.EngagementRepository
      }
      on event Engagement.TimeRecorded is {
        tell event Engagement.TimeRecorded to repository EngagementContext.EngagementRepository
      }
      on event Engagement.InvoiceGenerated is {
        tell event Engagement.InvoiceGenerated to repository EngagementContext.EngagementRepository
      }
      on event Engagement.PaymentRecorded is {
        tell event Engagement.PaymentRecorded to repository EngagementContext.EngagementRepository
      }
      on event Engagement.EngagementClosed is {
        tell event Engagement.EngagementClosed to repository EngagementContext.EngagementRepository
      }
      on other is {
        error "Unexpected message for sink EngagementEventSink"
      }
    } with {
      briefly "Engagement sink handler"
      described as {
        |Persists Engagement events via the repository.
      }
    }
  } with {
    briefly "Engagement event sink"
    described as {
      |Receives Engagement events for persistence.
    }
  }
  connector EngagementEventFlow is {
    from outlet EngagementContext.EngagementEventSource.EngagementEvents to
      inlet EngagementContext.EngagementEventSink.EngagementInlet
  } with {
    briefly "Engagement event flow"
    described as {
      |Connects the Engagement source to its sink.
    }
  }
} with {
  briefly "Engagement context"
  described as {
    | The Engagement context manages client
    | accounting engagements.
  }
}
