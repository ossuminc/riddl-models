// Audit Management - Audit Context
context AuditContext is {
  adaptor FromDocumentManagement from context DocumentManagement is {
    handler FromDocumentManagementHandler is {
      on result DocumentManagement.DocumentContent is {
        do "the model receives document content"
      }
      on event DocumentManagement.DocumentStored is {
        do "the model receives document stored"
      }
      on event DocumentManagement.EngagementDocumentsArchived is {
        do "the model receives engagement documents archived"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentManagement"
      }
    } with {
      briefly "from document management"
      described as {
        |Carries messages from the external DocumentManagement.
      }
    }
  } with {
      briefly "DocumentManagement integration"
    described as {
      |The model's side of the DocumentManagement conversation.
    }
  }
  adaptor ToDocumentManagement to context DocumentManagement is {
    handler ToDocumentManagementHandler is {
      on command DocumentManagement.ArchiveEngagementDocuments is {
        do "the model sends archive engagement documents"
      }
      on query DocumentManagement.RetrieveDocument is {
        do "the model sends retrieve document"
      }
      on command DocumentManagement.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentManagement"
      }
    } with {
      briefly "to document management"
      described as {
        |Carries messages to the external DocumentManagement.
      }
    }
  } with {
      briefly "DocumentManagement integration"
    described as {
      |The model's side of the DocumentManagement conversation.
    }
  }
  adaptor FromRegulatoryFiling from context RegulatoryFiling is {
    handler FromRegulatoryFilingHandler is {
      on result RegulatoryFiling.FilingStatus is {
        do "the model receives filing status"
      }
      on event RegulatoryFiling.FilingSubmitted is {
        do "the model receives filing submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryFiling"
      }
    } with {
      briefly "from regulatory filing"
      described as {
        |Carries messages from the external RegulatoryFiling.
      }
    }
  } with {
      briefly "RegulatoryFiling integration"
    described as {
      |The model's side of the RegulatoryFiling conversation.
    }
  }
  adaptor ToRegulatoryFiling to context RegulatoryFiling is {
    handler ToRegulatoryFilingHandler is {
      on query RegulatoryFiling.GetFilingStatus is {
        do "the model sends get filing status"
      }
      on command RegulatoryFiling.SubmitFiling is {
        do "the model sends submit filing"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryFiling"
      }
    } with {
      briefly "to regulatory filing"
      described as {
        |Carries messages to the external RegulatoryFiling.
      }
    }
  } with {
      briefly "RegulatoryFiling integration"
    described as {
      |The model's side of the RegulatoryFiling conversation.
    }
  }
  include "types.riddl"
  include "AuditEngagement.riddl"
  repository AuditRepository is {
    inlet AuditRepositoryFromAuditEngagement is type AuditEngagementEvent
    inlet AuditRepositoryFromAuditMetrics is type AuditEngagementEvent
    outlet AuditRepositoryResponses is type AuditEngagement.AuditEngagementResult
    record StoredAuditEngagement is {
      auditEngagementId: UUID with {
        briefly "auditEngagementId"
        described as {
          |The auditEngagementId column of the stored auditEngagement row.
        }
      }
      engagementId: EngagementId with {
        briefly "engagementId"
        described as {
          |The engagementId column of the stored auditEngagement row.
        }
      }
      engagementInfo: EngagementInfo with {
        briefly "engagementInfo"
        described as {
          |The engagementInfo column of the stored auditEngagement row.
        }
      }
      status: EngagementStatus with {
        briefly "status"
        described as {
          |The status column of the stored auditEngagement row.
        }
      }
    } with {
      briefly "Stored auditEngagement row"
      described as {
        |The persistence shape of auditEngagement data as this repository stores it.
      }
    }
    schema AuditData is relational
      of engagements as type StoredAuditEngagement
        index on field StoredAuditEngagement.engagementId
        index on field StoredAuditEngagement.engagementInfo.clientId
        index on field StoredAuditEngagement.status
      with {
      briefly "Audit data schema"
      described as {
        |The relational schema holding audit data for the AuditRepository.
      }
    }

    handler AuditPersistence is {
      on query GetEngagementMetrics is {
        do "read the engagement metrics projection"
        yield result EngagementMetricsView
      }
      on command AuditEngagement.CreateEngagement is {
        tell event AuditEngagement.EngagementCreated to entity AuditContext.AuditEngagement
        do "Store new audit engagement"
      }
      on command AuditEngagement.AssignTeam is {
        tell event AuditEngagement.TeamAssigned to entity AuditContext.AuditEngagement
        do "Update engagement team assignments"
      }
      on command AuditEngagement.BeginFieldwork is {
        do "Update engagement to in-progress"
      }
      on command AuditEngagement.AddWorkpaper is {
        tell event AuditEngagement.WorkpaperAdded to entity AuditContext.AuditEngagement
        do "Store new workpaper"
      }
      on command AuditEngagement.CompleteWorkpaperReview is {
        tell event AuditEngagement.WorkpaperReviewCompleted to entity AuditContext.AuditEngagement
        do "Update workpaper review status"
      }
      on command AuditEngagement.RecordFinding is {
        tell event AuditEngagement.FindingRecorded to entity AuditContext.AuditEngagement
        do "Store audit finding"
      }
      on command AuditEngagement.IssueReport is {
        tell event AuditEngagement.ReportIssued to entity AuditContext.AuditEngagement
        do "Update engagement to report issued"
      }
      on command AuditEngagement.CloseEngagement is {
        tell event AuditEngagement.EngagementClosed to entity AuditContext.AuditEngagement
        do "Update engagement to closed"
      }
    } with {
      briefly "Persists audit commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Audit data persistence"
    described as {
      |Persistent storage for audit engagements.
    }
  }
  query GetEngagementMetrics is {
    engagementMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which engagement metrics to retrieve.
      }
    }
  } with {
    briefly "Get engagement metrics"
    described as {
      |Retrieves the engagement metrics projection.
    }
  }
  result EngagementMetricsView is {
    engagementMetrics: AuditMetrics.EngagementMetrics with {
      briefly "Engagement metrics"
      described as {
        |The engagement metrics being returned.
      }
    }
  } with {
    briefly "Engagement metrics view"
    described as {
      |Read model view carrying the engagement metrics projection.
    }
  }
  projector AuditMetrics is {
    inlet AuditMetricsFromAuditEngagement is type AuditEngagementEvent
    outlet AuditMetricsOut is type AuditEngagementEvent
    updates repository AuditContext.AuditRepository
    record EngagementMetrics is  {
      engagementsPlanned: Natural with {
        briefly "Planned"
        described as {
          |Engagements planned.
        }
      }
      engagementsInProgress: Natural with {
        briefly "In progress"
        described as {
          |Engagements in progress.
        }
      }
      reportsIssued: Natural with {
        briefly "Issued"
        described as {
          |Reports issued.
        }
      }
      totalFindings: Natural with {
        briefly "Findings"
        described as {
          |Total findings recorded.
        }
      }
      criticalFindings: Natural with {
        briefly "Critical"
        described as {
          |Critical findings recorded.
        }
      }
      averageEngagementDays: Decimal(8,2) with {
        briefly "Avg days"
        described as {
          |Average engagement duration in days.
        }
      }
    } with {
      briefly "Engagement metrics"
      described as {
        |Audit engagement metrics.
      }
    }
    handler MetricsHandler is {
      on event AuditEngagement.EngagementCreated is {
        tell event AuditEngagement.EngagementCreated to repository AuditContext.AuditRepository
        do "Increment engagements planned"
      }
      on event AuditEngagement.FieldworkBegan is {
        tell event AuditEngagement.FieldworkBegan to repository AuditContext.AuditRepository
        do "Increment engagements in progress"
      }
      on event AuditEngagement.ReportIssued is {
        tell event AuditEngagement.ReportIssued to repository AuditContext.AuditRepository
        do "Increment reports issued and calculate duration"
      }
      on event AuditEngagement.FindingRecorded is {
        tell event AuditEngagement.FindingRecorded to repository AuditContext.AuditRepository
        do "Increment findings count by severity"
      }
    } with {
      briefly "Maintains audit metrics"
      described as {
        |Projects events into audit metrics.
      }
    }
  } with {
    briefly "Audit metrics"
    described as {
      |Audit engagement analytics.
    }
  }
  // ---- Event publication for AuditEngagement ----
  type AuditEngagementEvent is one of {
    AuditContext.AuditEngagement.EngagementCreated,
    AuditContext.AuditEngagement.TeamAssigned,
    AuditContext.AuditEngagement.FieldworkBegan,
    AuditContext.AuditEngagement.WorkpaperAdded,
    AuditContext.AuditEngagement.WorkpaperSubmittedForReview,
    AuditContext.AuditEngagement.WorkpaperReviewCompleted,
    AuditContext.AuditEngagement.FindingRecorded,
    AuditContext.AuditEngagement.ReportDrafted,
    AuditContext.AuditEngagement.ReportSubmittedForReview,
    AuditContext.AuditEngagement.ReportIssued,
    AuditContext.AuditEngagement.EngagementClosed,
    AuditContext.AuditEngagement.EngagementCancelled
  } with {
    briefly "AuditEngagement event alternation"
    described as {
      |Union of all AuditEngagement events, for streaming and event-sourced
      |persistence.
    }
  }
  processor AuditEngagementEventSource as source is {
    outlet AuditEngagementEvents is type AuditEngagementEvent
    handler AuditEngagementSourceHandler is {
      on event AuditEngagement.EngagementCreated is {
        send event AuditEngagement.EngagementCreated to outlet AuditEngagementEvents
      }
      on event AuditEngagement.TeamAssigned is {
        send event AuditEngagement.TeamAssigned to outlet AuditEngagementEvents
      }
      on event AuditEngagement.FieldworkBegan is {
        send event AuditEngagement.FieldworkBegan to outlet AuditEngagementEvents
      }
      on event AuditEngagement.WorkpaperAdded is {
        send event AuditEngagement.WorkpaperAdded to outlet AuditEngagementEvents
      }
      on event AuditEngagement.WorkpaperSubmittedForReview is {
        send event AuditEngagement.WorkpaperSubmittedForReview to outlet AuditEngagementEvents
      }
      on event AuditEngagement.WorkpaperReviewCompleted is {
        send event AuditEngagement.WorkpaperReviewCompleted to outlet AuditEngagementEvents
      }
      on event AuditEngagement.FindingRecorded is {
        send event AuditEngagement.FindingRecorded to outlet AuditEngagementEvents
      }
      on event AuditEngagement.ReportDrafted is {
        send event AuditEngagement.ReportDrafted to outlet AuditEngagementEvents
      }
      on event AuditEngagement.ReportSubmittedForReview is {
        send event AuditEngagement.ReportSubmittedForReview to outlet AuditEngagementEvents
      }
      on event AuditEngagement.ReportIssued is {
        send event AuditEngagement.ReportIssued to outlet AuditEngagementEvents
      }
      on event AuditEngagement.EngagementClosed is {
        send event AuditEngagement.EngagementClosed to outlet AuditEngagementEvents
      }
      on event AuditEngagement.EngagementCancelled is {
        send event AuditEngagement.EngagementCancelled to outlet AuditEngagementEvents
      }
      on other is {
        error "Unexpected message for source AuditEngagementEventSource"
      }
    } with {
      briefly "AuditEngagement source handler"
      described as {
        |Publishes AuditEngagement events onto the outlet.
      }
    }
  } with {
    briefly "AuditEngagement event source"
    described as {
      |Publishes AuditEngagement entity events into the streaming topology.
    }
  }
  processor AuditEngagementEventSink as sink is {
    inlet AuditEngagementInlet is type AuditEngagementEvent
    handler AuditEngagementSinkHandler is {
      on event AuditEngagement.EngagementCreated is {
        tell event AuditEngagement.EngagementCreated to repository AuditContext.AuditRepository
      }
      on event AuditEngagement.TeamAssigned is {
        tell event AuditEngagement.TeamAssigned to repository AuditContext.AuditRepository
      }
      on event AuditEngagement.FieldworkBegan is {
        tell event AuditEngagement.FieldworkBegan to repository AuditContext.AuditRepository
      }
      on event AuditEngagement.WorkpaperAdded is {
        tell event AuditEngagement.WorkpaperAdded to repository AuditContext.AuditRepository
      }
      on event AuditEngagement.WorkpaperSubmittedForReview is {
        tell event AuditEngagement.WorkpaperSubmittedForReview to repository AuditContext.AuditRepository
      }
      on event AuditEngagement.WorkpaperReviewCompleted is {
        tell event AuditEngagement.WorkpaperReviewCompleted to repository AuditContext.AuditRepository
      }
      on event AuditEngagement.FindingRecorded is {
        tell event AuditEngagement.FindingRecorded to repository AuditContext.AuditRepository
      }
      on event AuditEngagement.ReportDrafted is {
        tell event AuditEngagement.ReportDrafted to repository AuditContext.AuditRepository
      }
      on event AuditEngagement.ReportSubmittedForReview is {
        tell event AuditEngagement.ReportSubmittedForReview to repository AuditContext.AuditRepository
      }
      on event AuditEngagement.ReportIssued is {
        tell event AuditEngagement.ReportIssued to repository AuditContext.AuditRepository
      }
      on event AuditEngagement.EngagementClosed is {
        tell event AuditEngagement.EngagementClosed to repository AuditContext.AuditRepository
      }
      on event AuditEngagement.EngagementCancelled is {
        tell event AuditEngagement.EngagementCancelled to repository AuditContext.AuditRepository
      }
      on other is {
        error "Unexpected message for sink AuditEngagementEventSink"
      }
    } with {
      briefly "AuditEngagement sink handler"
      described as {
        |Persists AuditEngagement events via the repository.
      }
    }
  } with {
    briefly "AuditEngagement event sink"
    described as {
      |Receives AuditEngagement events for persistence.
    }
  }
  connector AuditEngagementEventFlow is {
    from outlet AuditContext.AuditEngagementEventSource.AuditEngagementEvents to
      inlet AuditContext.AuditEngagementEventSink.AuditEngagementInlet
  } with {
    briefly "AuditEngagement event flow"
    described as {
      |Connects the AuditEngagement source to its sink.
    }
  }
  processor AuditEngagementEventSplit is {
    inlet AuditEngagementEventSplitIn is type AuditEngagementEvent
    outlet AuditEngagementEventSplitToAuditRepository is type AuditEngagementEvent
    outlet AuditEngagementEventSplitToAuditMetrics is type AuditEngagementEvent
    handler AuditEngagementEventSplitHandler is {
      on event AuditEngagement.EngagementCreated is {
        send event AuditEngagement.EngagementCreated to outlet AuditEngagementEventSplitToAuditRepository
        send event AuditEngagement.EngagementCreated to outlet AuditEngagementEventSplitToAuditMetrics
        tell event AuditEngagement.EngagementCreated to entity AuditContext.AuditEngagement
      }
      on event AuditEngagement.TeamAssigned is {
        send event AuditEngagement.TeamAssigned to outlet AuditEngagementEventSplitToAuditRepository
        send event AuditEngagement.TeamAssigned to outlet AuditEngagementEventSplitToAuditMetrics
        tell event AuditEngagement.TeamAssigned to entity AuditContext.AuditEngagement
      }
      on event AuditEngagement.FieldworkBegan is {
        send event AuditEngagement.FieldworkBegan to outlet AuditEngagementEventSplitToAuditRepository
        send event AuditEngagement.FieldworkBegan to outlet AuditEngagementEventSplitToAuditMetrics
        tell event AuditEngagement.FieldworkBegan to entity AuditContext.AuditEngagement
      }
      on event AuditEngagement.WorkpaperAdded is {
        send event AuditEngagement.WorkpaperAdded to outlet AuditEngagementEventSplitToAuditRepository
        send event AuditEngagement.WorkpaperAdded to outlet AuditEngagementEventSplitToAuditMetrics
        tell event AuditEngagement.WorkpaperAdded to entity AuditContext.AuditEngagement
      }
      on event AuditEngagement.WorkpaperSubmittedForReview is {
        send event AuditEngagement.WorkpaperSubmittedForReview to outlet AuditEngagementEventSplitToAuditRepository
        send event AuditEngagement.WorkpaperSubmittedForReview to outlet AuditEngagementEventSplitToAuditMetrics
        tell event AuditEngagement.WorkpaperSubmittedForReview to entity AuditContext.AuditEngagement
      }
      on event AuditEngagement.WorkpaperReviewCompleted is {
        send event AuditEngagement.WorkpaperReviewCompleted to outlet AuditEngagementEventSplitToAuditRepository
        send event AuditEngagement.WorkpaperReviewCompleted to outlet AuditEngagementEventSplitToAuditMetrics
        tell event AuditEngagement.WorkpaperReviewCompleted to entity AuditContext.AuditEngagement
      }
      on event AuditEngagement.FindingRecorded is {
        send event AuditEngagement.FindingRecorded to outlet AuditEngagementEventSplitToAuditRepository
        send event AuditEngagement.FindingRecorded to outlet AuditEngagementEventSplitToAuditMetrics
        tell event AuditEngagement.FindingRecorded to entity AuditContext.AuditEngagement
      }
      on event AuditEngagement.ReportDrafted is {
        send event AuditEngagement.ReportDrafted to outlet AuditEngagementEventSplitToAuditRepository
        send event AuditEngagement.ReportDrafted to outlet AuditEngagementEventSplitToAuditMetrics
        tell event AuditEngagement.ReportDrafted to entity AuditContext.AuditEngagement
      }
      on event AuditEngagement.ReportSubmittedForReview is {
        send event AuditEngagement.ReportSubmittedForReview to outlet AuditEngagementEventSplitToAuditRepository
        send event AuditEngagement.ReportSubmittedForReview to outlet AuditEngagementEventSplitToAuditMetrics
        tell event AuditEngagement.ReportSubmittedForReview to entity AuditContext.AuditEngagement
      }
      on event AuditEngagement.ReportIssued is {
        send event AuditEngagement.ReportIssued to outlet AuditEngagementEventSplitToAuditRepository
        send event AuditEngagement.ReportIssued to outlet AuditEngagementEventSplitToAuditMetrics
        tell event AuditEngagement.ReportIssued to entity AuditContext.AuditEngagement
      }
      on event AuditEngagement.EngagementClosed is {
        send event AuditEngagement.EngagementClosed to outlet AuditEngagementEventSplitToAuditRepository
        send event AuditEngagement.EngagementClosed to outlet AuditEngagementEventSplitToAuditMetrics
        tell event AuditEngagement.EngagementClosed to entity AuditContext.AuditEngagement
      }
      on event AuditEngagement.EngagementCancelled is {
        send event AuditEngagement.EngagementCancelled to outlet AuditEngagementEventSplitToAuditRepository
        send event AuditEngagement.EngagementCancelled to outlet AuditEngagementEventSplitToAuditMetrics
        tell event AuditEngagement.EngagementCancelled to entity AuditContext.AuditEngagement
      }
      on other is {
        error "Unexpected message for processor AuditEngagementEventSplit"
      }
    } with {
      briefly "AuditEngagement event fan-out handler"
      described as {
        |Delivers each AuditEngagement event to all of its consumers.
      }
    }
  } with {
    briefly "AuditEngagement event fan-out"
    described as {
      |Fans AuditEngagement events out to the repository and projectors.
    }
  }
  connector LinkAuditEngagementToAuditEngagementEventSplit is {
    from outlet AuditContext.AuditEngagement.AuditEngagementEvents2 to
      inlet AuditContext.AuditEngagementEventSplit.AuditEngagementEventSplitIn
  } with {
    briefly "LinkAuditEngagementToAuditEngagementEventSplit"
  }
  connector LinkAuditEngagementEventSplitToAuditRepository is {
    from outlet AuditContext.AuditEngagementEventSplit.AuditEngagementEventSplitToAuditRepository to
      inlet AuditContext.AuditRepository.AuditRepositoryFromAuditEngagement
  } with {
    briefly "LinkAuditEngagementEventSplitToAuditRepository"
  }
  connector LinkAuditEngagementEventSplitToAuditMetrics is {
    from outlet AuditContext.AuditEngagementEventSplit.AuditEngagementEventSplitToAuditMetrics to
      inlet AuditContext.AuditMetrics.AuditMetricsFromAuditEngagement
  } with {
    briefly "LinkAuditEngagementEventSplitToAuditMetrics"
  }
  connector LinkAuditMetricsToAuditRepository is {
    from outlet AuditContext.AuditMetrics.AuditMetricsOut to
      inlet AuditContext.AuditRepository.AuditRepositoryFromAuditMetrics
  } with {
    briefly "LinkAuditMetricsToAuditRepository"
  }
} with {
  briefly "Bounded context for audit management"
  described as {
    |Audit engagement management context.
  }
}
