// Audit Management - Audit Context
context AuditContext as router is {
  inlet AuditEngagementCommandStreamIn is type AuditEngagementCommand  outlet AuditEngagementCommandStreamOut is type AuditEngagementCommand
  inlet AuditEngagementResultStreamIn is type AuditEngagement.AuditEngagementResult  outlet AuditEngagementResultStreamOut is type AuditEngagement.AuditEngagementResult
  handler AuditContextBoundary is {
    on createEngagement: command AuditEngagement.CreateEngagement is {
      send createEngagement to outlet AuditContext.AuditEngagementCommandStreamOut
    }
    on assignTeam: command AuditEngagement.AssignTeam is {
      send assignTeam to outlet AuditContext.AuditEngagementCommandStreamOut
    }
    on beginFieldwork: command AuditEngagement.BeginFieldwork is {
      send beginFieldwork to outlet AuditContext.AuditEngagementCommandStreamOut
    }
    on addWorkpaper: command AuditEngagement.AddWorkpaper is {
      send addWorkpaper to outlet AuditContext.AuditEngagementCommandStreamOut
    }
    on submitWorkpaperForReview: command AuditEngagement.SubmitWorkpaperForReview is {
      send submitWorkpaperForReview to outlet AuditContext.AuditEngagementCommandStreamOut
    }
    on completeWorkpaperReview: command AuditEngagement.CompleteWorkpaperReview is {
      send completeWorkpaperReview to outlet AuditContext.AuditEngagementCommandStreamOut
    }
    on recordFinding: command AuditEngagement.RecordFinding is {
      send recordFinding to outlet AuditContext.AuditEngagementCommandStreamOut
    }
    on draftReport: command AuditEngagement.DraftReport is {
      send draftReport to outlet AuditContext.AuditEngagementCommandStreamOut
    }
    on submitReportForReview: command AuditEngagement.SubmitReportForReview is {
      send submitReportForReview to outlet AuditContext.AuditEngagementCommandStreamOut
    }
    on issueReport: command AuditEngagement.IssueReport is {
      send issueReport to outlet AuditContext.AuditEngagementCommandStreamOut
    }
    on closeEngagement: command AuditEngagement.CloseEngagement is {
      send closeEngagement to outlet AuditContext.AuditEngagementCommandStreamOut
    }
    on cancelEngagement: command AuditEngagement.CancelEngagement is {
      send cancelEngagement to outlet AuditContext.AuditEngagementCommandStreamOut
    }
    on auditEngagementResult: result AuditEngagement.AuditEngagementResult is {
      send auditEngagementResult to outlet AuditContext.AuditEngagementResultStreamOut
    }
    on other is {
      error "Unexpected message at the AuditContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AuditEngagementCommand Stream Intake' is from outlet AuditContext.AuditEngagementCommandStreamOut to inlet AuditContext.AuditEngagement.AuditEngagementCommands  connector 'AuditEngagementResult Stream Egress' is from outlet AuditContext.AuditRepository.AuditRepositoryResponses to inlet AuditContext.AuditEngagementResultStreamIn  adaptor FromDocumentManagement from context DocumentManagement is { 
    handler FromDocumentManagementHandler is {
      on result DocumentManagement.DocumentContent is {
        do "the model receives document content"
      }
      on event DocumentManagement.DocumentStored is {
        do "the model receives document stored"
      }
      on event DocumentManagement.EngagementDocumentsArchived is {
        do "the model receives engagement documents archived"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentManagement"
      }
    } with {
      briefly "from document management"
      described as {
        |Carries messages from the external DocumentManagement.
      }
    }
  } with {
    briefly "DocumentManagement integration"
    described as {
      |The model's side of the DocumentManagement conversation.
    }
  }
  adaptor ToDocumentManagement to context DocumentManagement is { 
    handler ToDocumentManagementHandler is {
      on command DocumentManagement.ArchiveEngagementDocuments is {
        do "the model sends archive engagement documents"
      }
      on query DocumentManagement.RetrieveDocument is {
        do "the model sends retrieve document"
      }
      on command DocumentManagement.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentManagement"
      }
    } with {
      briefly "to document management"
      described as {
        |Carries messages to the external DocumentManagement.
      }
    }
  } with {
    briefly "DocumentManagement integration"
    described as {
      |The model's side of the DocumentManagement conversation.
    }
  }
  adaptor FromRegulatoryFiling from context RegulatoryFiling is { 
    handler FromRegulatoryFilingHandler is {
      on result RegulatoryFiling.FilingStatus is {
        do "the model receives filing status"
      }
      on event RegulatoryFiling.FilingSubmitted is {
        do "the model receives filing submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryFiling"
      }
    } with {
      briefly "from regulatory filing"
      described as {
        |Carries messages from the external RegulatoryFiling.
      }
    }
  } with {
    briefly "RegulatoryFiling integration"
    described as {
      |The model's side of the RegulatoryFiling conversation.
    }
  }
  adaptor ToRegulatoryFiling to context RegulatoryFiling is { 
    handler ToRegulatoryFilingHandler is {
      on query RegulatoryFiling.GetFilingStatus is {
        do "the model sends get filing status"
      }
      on command RegulatoryFiling.SubmitFiling is {
        do "the model sends submit filing"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryFiling"
      }
    } with {
      briefly "to regulatory filing"
      described as {
        |Carries messages to the external RegulatoryFiling.
      }
    }
  } with {
    briefly "RegulatoryFiling integration"
    described as {
      |The model's side of the RegulatoryFiling conversation.
    }
  }
  include "types.riddl"
  include "AuditEngagement.riddl"
  repository AuditRepository as merge is {
    command PersistEngagementCreated is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row EngagementCreated applies to.
        }
      }
    } with {
      briefly "Persist EngagementCreated"
      described as {
        |Instructs this repository to apply EngagementCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFieldworkBegan is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row FieldworkBegan applies to.
        }
      }
    } with {
      briefly "Persist FieldworkBegan"
      described as {
        |Instructs this repository to apply FieldworkBegan to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFindingRecorded is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row FindingRecorded applies to.
        }
      }
    } with {
      briefly "Persist FindingRecorded"
      described as {
        |Instructs this repository to apply FindingRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportIssued is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportIssued applies to.
        }
      }
    } with {
      briefly "Persist ReportIssued"
      described as {
        |Instructs this repository to apply ReportIssued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet AuditRepositoryFromAuditEngagement is type AuditEngagementEvent    inlet AuditRepositoryFromAuditMetrics is type AuditEngagementEvent    outlet AuditRepositoryResponses is type AuditEngagement.AuditEngagementResult
    record StoredAuditEngagement is  {
      auditEngagementId: UUID with {
        briefly "auditEngagementId"
        described as {
          |The auditEngagementId column of the stored auditEngagement row.
        }
      }
      engagementId: EngagementId with {
        briefly "engagementId"
        described as {
          |The engagementId column of the stored auditEngagement row.
        }
      }
      engagementInfo: EngagementInfo with {
        briefly "engagementInfo"
        described as {
          |The engagementInfo column of the stored auditEngagement row.
        }
      }
      status: EngagementStatus with {
        briefly "status"
        described as {
          |The status column of the stored auditEngagement row.
        }
      }
    } with {
      briefly "Stored auditEngagement row"
      described as {
        |The persistence shape of auditEngagement data as this repository stores it.
      }
    }
    schema AuditData is relational
      of engagements as type StoredAuditEngagement
        index on field StoredAuditEngagement.engagementId
        index on field StoredAuditEngagement.engagementInfo.clientId
        index on field StoredAuditEngagement.status
 with {
      briefly "Audit data schema"
      described as {
        |The relational schema holding audit data for the AuditRepository.
      }
    }
    handler AuditPersistence is {
      on persistEngagementCreated: command PersistEngagementCreated is {
        do "apply EngagementCreated to the stored row"
      }
      on persistFieldworkBegan: command PersistFieldworkBegan is {
        do "apply FieldworkBegan to the stored row"
      }
      on persistFindingRecorded: command PersistFindingRecorded is {
        do "apply FindingRecorded to the stored row"
      }
      on persistReportIssued: command PersistReportIssued is {
        do "apply ReportIssued to the stored row"
      }
      on query GetEngagementMetrics is {
        let engagementMetricsView: type EngagementMetricsView = prompt("read the engagement metrics projection")
        reply engagementMetricsView
      }
      on createEngagement: command AuditEngagement.CreateEngagement is {
        tell event AuditEngagement.EngagementCreated(engagementId = createEngagement.engagementId, engagementInfo = createEngagement.engagementInfo) to entity AuditContext.AuditEngagement
        do "Store new audit engagement"
      }
      on assignTeam: command AuditEngagement.AssignTeam is {
        tell event AuditEngagement.TeamAssigned(engagementId = assignTeam.engagementId) to entity AuditContext.AuditEngagement
        do "Update engagement team assignments"
      }
      on command AuditEngagement.BeginFieldwork is {
        do "Update engagement to in-progress"
      }
      on addWorkpaper: command AuditEngagement.AddWorkpaper is {
        tell event AuditEngagement.WorkpaperAdded(engagementId = addWorkpaper.engagementId) to entity AuditContext.AuditEngagement
        do "Store new workpaper"
      }
      on completeWorkpaperReview: command AuditEngagement.CompleteWorkpaperReview is {
        tell event AuditEngagement.WorkpaperReviewCompleted(engagementId = completeWorkpaperReview.engagementId, workpaperId = completeWorkpaperReview.workpaperId) to entity AuditContext.AuditEngagement
        do "Update workpaper review status"
      }
      on recordFinding: command AuditEngagement.RecordFinding is {
        tell event AuditEngagement.FindingRecorded(engagementId = recordFinding.engagementId) to entity AuditContext.AuditEngagement
        do "Store audit finding"
      }
      on issueReport: command AuditEngagement.IssueReport is {
        tell event AuditEngagement.ReportIssued(engagementId = issueReport.engagementId, issuedDate = issueReport.issuedDate) to entity AuditContext.AuditEngagement
        do "Update engagement to report issued"
      }
      on closeEngagement: command AuditEngagement.CloseEngagement is {
        tell event AuditEngagement.EngagementClosed(engagementId = closeEngagement.engagementId, closedDate = closeEngagement.closedDate) to entity AuditContext.AuditEngagement
        do "Update engagement to closed"
      }
    } with {
      briefly "Persists audit commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Audit data persistence"
    described as {
      |Persistent storage for audit engagements.
    }
  }
  query GetEngagementMetrics replies result EngagementMetricsView is  {
    engagementMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which engagement metrics to retrieve.
      }
    }
  } with {
    briefly "Get engagement metrics"
    described as {
      |Retrieves the engagement metrics projection.
    }
  }
  result EngagementMetricsView is  {
    engagementMetrics: AuditMetrics.EngagementMetrics with {
      briefly "Engagement metrics"
      described as {
        |The engagement metrics being returned.
      }
    }
  } with {
    briefly "Engagement metrics view"
    described as {
      |Read model view carrying the engagement metrics projection.
    }
  }
  projector AuditMetrics as flow is {
    updates repository AuditContext.AuditRepository
    inlet AuditMetricsFromAuditEngagement is type AuditEngagementEvent    outlet AuditMetricsOut is type AuditEngagementEvent
    record EngagementMetrics is  {
      engagementsPlanned: Natural with {
        briefly "Planned"
        described as {
          |Engagements planned.
        }
      }
      engagementsInProgress: Natural with {
        briefly "In progress"
        described as {
          |Engagements in progress.
        }
      }
      reportsIssued: Natural with {
        briefly "Issued"
        described as {
          |Reports issued.
        }
      }
      totalFindings: Natural with {
        briefly "Findings"
        described as {
          |Total findings recorded.
        }
      }
      criticalFindings: Natural with {
        briefly "Critical"
        described as {
          |Critical findings recorded.
        }
      }
      averageEngagementDays: Decimal(8,2) with {
        briefly "Avg days"
        described as {
          |Average engagement duration in days.
        }
      }
    } with {
      briefly "Engagement metrics"
      described as {
        |Audit engagement metrics.
      }
    }
    handler MetricsHandler is {
      on engagementCreated: event AuditEngagement.EngagementCreated is {
        tell command AuditContext.AuditRepository.PersistEngagementCreated(engagementId = engagementCreated.engagementId) to repository AuditContext.AuditRepository
        do "Increment engagements planned"
      }
      on fieldworkBegan: event AuditEngagement.FieldworkBegan is {
        tell command AuditContext.AuditRepository.PersistFieldworkBegan(engagementId = fieldworkBegan.engagementId) to repository AuditContext.AuditRepository
        do "Increment engagements in progress"
      }
      on reportIssued: event AuditEngagement.ReportIssued is {
        tell command AuditContext.AuditRepository.PersistReportIssued(engagementId = reportIssued.engagementId) to repository AuditContext.AuditRepository
        do "Increment reports issued and calculate duration"
      }
      on findingRecorded: event AuditEngagement.FindingRecorded is {
        tell command AuditContext.AuditRepository.PersistFindingRecorded(engagementId = findingRecorded.engagementId) to repository AuditContext.AuditRepository
        do "Increment findings count by severity"
      }
    } with {
      briefly "Maintains audit metrics"
      described as {
        |Projects events into audit metrics.
      }
    }
  } with {
    briefly "Audit metrics"
    described as {
      |Audit engagement analytics.
    }
  }
  // ---- Event publication for AuditEngagement ----
  type AuditEngagementEvent is one of {
    AuditContext.AuditEngagement.EngagementCreated or AuditContext.AuditEngagement.TeamAssigned or AuditContext.AuditEngagement.FieldworkBegan or AuditContext.AuditEngagement.WorkpaperAdded or AuditContext.AuditEngagement.WorkpaperSubmittedForReview or AuditContext.AuditEngagement.WorkpaperReviewCompleted or AuditContext.AuditEngagement.FindingRecorded or AuditContext.AuditEngagement.ReportDrafted or AuditContext.AuditEngagement.ReportSubmittedForReview or AuditContext.AuditEngagement.ReportIssued or AuditContext.AuditEngagement.EngagementClosed or AuditContext.AuditEngagement.EngagementCancelled
  } with {
    briefly "AuditEngagement event alternation"
    described as {
      |Union of all AuditEngagement events, for streaming and event-sourced
      |persistence.
    }
  }
  processor AuditEngagementEventSource as source is {
    outlet AuditEngagementEvents is type AuditEngagementEvent
    handler AuditEngagementSourceHandler is {
      on engagementCreated: event AuditEngagement.EngagementCreated is {
        send engagementCreated to outlet AuditEngagementEvents
      }
      on teamAssigned: event AuditEngagement.TeamAssigned is {
        send teamAssigned to outlet AuditEngagementEvents
      }
      on fieldworkBegan: event AuditEngagement.FieldworkBegan is {
        send fieldworkBegan to outlet AuditEngagementEvents
      }
      on workpaperAdded: event AuditEngagement.WorkpaperAdded is {
        send workpaperAdded to outlet AuditEngagementEvents
      }
      on workpaperSubmittedForReview: event AuditEngagement.WorkpaperSubmittedForReview is {
        send workpaperSubmittedForReview to outlet AuditEngagementEvents
      }
      on workpaperReviewCompleted: event AuditEngagement.WorkpaperReviewCompleted is {
        send workpaperReviewCompleted to outlet AuditEngagementEvents
      }
      on findingRecorded: event AuditEngagement.FindingRecorded is {
        send findingRecorded to outlet AuditEngagementEvents
      }
      on reportDrafted: event AuditEngagement.ReportDrafted is {
        send reportDrafted to outlet AuditEngagementEvents
      }
      on reportSubmittedForReview: event AuditEngagement.ReportSubmittedForReview is {
        send reportSubmittedForReview to outlet AuditEngagementEvents
      }
      on reportIssued: event AuditEngagement.ReportIssued is {
        send reportIssued to outlet AuditEngagementEvents
      }
      on engagementClosed: event AuditEngagement.EngagementClosed is {
        send engagementClosed to outlet AuditEngagementEvents
      }
      on engagementCancelled: event AuditEngagement.EngagementCancelled is {
        send engagementCancelled to outlet AuditEngagementEvents
      }
      on other is {
        error "Unexpected message for source AuditEngagementEventSource"
      }
    } with {
      briefly "AuditEngagement source handler"
      described as {
        |Publishes AuditEngagement events onto the outlet.
      }
    }
  } with {
    briefly "AuditEngagement event source"
    described as {
      |Publishes AuditEngagement entity events into the streaming topology.
    }
  }
  processor AuditEngagementEventSink as sink is {
    inlet AuditEngagementInlet is type AuditEngagementEvent    handler AuditEngagementSinkHandler is {
      on engagementCreated: event AuditEngagement.EngagementCreated is {
        tell engagementCreated to repository AuditContext.AuditRepository
      }
      on teamAssigned: event AuditEngagement.TeamAssigned is {
        tell teamAssigned to repository AuditContext.AuditRepository
      }
      on fieldworkBegan: event AuditEngagement.FieldworkBegan is {
        tell fieldworkBegan to repository AuditContext.AuditRepository
      }
      on workpaperAdded: event AuditEngagement.WorkpaperAdded is {
        tell workpaperAdded to repository AuditContext.AuditRepository
      }
      on workpaperSubmittedForReview: event AuditEngagement.WorkpaperSubmittedForReview is {
        tell workpaperSubmittedForReview to repository AuditContext.AuditRepository
      }
      on workpaperReviewCompleted: event AuditEngagement.WorkpaperReviewCompleted is {
        tell workpaperReviewCompleted to repository AuditContext.AuditRepository
      }
      on findingRecorded: event AuditEngagement.FindingRecorded is {
        tell findingRecorded to repository AuditContext.AuditRepository
      }
      on reportDrafted: event AuditEngagement.ReportDrafted is {
        tell reportDrafted to repository AuditContext.AuditRepository
      }
      on reportSubmittedForReview: event AuditEngagement.ReportSubmittedForReview is {
        tell reportSubmittedForReview to repository AuditContext.AuditRepository
      }
      on reportIssued: event AuditEngagement.ReportIssued is {
        tell reportIssued to repository AuditContext.AuditRepository
      }
      on engagementClosed: event AuditEngagement.EngagementClosed is {
        tell engagementClosed to repository AuditContext.AuditRepository
      }
      on engagementCancelled: event AuditEngagement.EngagementCancelled is {
        tell engagementCancelled to repository AuditContext.AuditRepository
      }
      on other is {
        error "Unexpected message for sink AuditEngagementEventSink"
      }
    } with {
      briefly "AuditEngagement sink handler"
      described as {
        |Persists AuditEngagement events via the repository.
      }
    }
  } with {
    briefly "AuditEngagement event sink"
    described as {
      |Receives AuditEngagement events for persistence.
    }
  }
  connector AuditEngagementEventFlow is from outlet AuditContext.AuditEngagementEventSource.AuditEngagementEvents to inlet AuditContext.AuditEngagementEventSink.AuditEngagementInlet with {
    briefly "AuditEngagement event flow"
    described as {
      |Connects the AuditEngagement source to its sink.
    }
  }
  processor AuditEngagementEventSplit as split is {
    inlet AuditEngagementEventSplitIn is type AuditEngagementEvent    outlet AuditEngagementEventSplitToAuditRepository is type AuditEngagementEvent
    outlet AuditEngagementEventSplitToAuditMetrics is type AuditEngagementEvent
    handler AuditEngagementEventSplitHandler is {
      on engagementCreated: event AuditEngagement.EngagementCreated is {
        send engagementCreated to outlet AuditEngagementEventSplitToAuditRepository
        send engagementCreated to outlet AuditEngagementEventSplitToAuditMetrics
        tell engagementCreated to entity AuditContext.AuditEngagement
      }
      on teamAssigned: event AuditEngagement.TeamAssigned is {
        send teamAssigned to outlet AuditEngagementEventSplitToAuditRepository
        send teamAssigned to outlet AuditEngagementEventSplitToAuditMetrics
        tell teamAssigned to entity AuditContext.AuditEngagement
      }
      on fieldworkBegan: event AuditEngagement.FieldworkBegan is {
        send fieldworkBegan to outlet AuditEngagementEventSplitToAuditRepository
        send fieldworkBegan to outlet AuditEngagementEventSplitToAuditMetrics
        tell fieldworkBegan to entity AuditContext.AuditEngagement
      }
      on workpaperAdded: event AuditEngagement.WorkpaperAdded is {
        send workpaperAdded to outlet AuditEngagementEventSplitToAuditRepository
        send workpaperAdded to outlet AuditEngagementEventSplitToAuditMetrics
        tell workpaperAdded to entity AuditContext.AuditEngagement
      }
      on workpaperSubmittedForReview: event AuditEngagement.WorkpaperSubmittedForReview is {
        send workpaperSubmittedForReview to outlet AuditEngagementEventSplitToAuditRepository
        send workpaperSubmittedForReview to outlet AuditEngagementEventSplitToAuditMetrics
        tell workpaperSubmittedForReview to entity AuditContext.AuditEngagement
      }
      on workpaperReviewCompleted: event AuditEngagement.WorkpaperReviewCompleted is {
        send workpaperReviewCompleted to outlet AuditEngagementEventSplitToAuditRepository
        send workpaperReviewCompleted to outlet AuditEngagementEventSplitToAuditMetrics
        tell workpaperReviewCompleted to entity AuditContext.AuditEngagement
      }
      on findingRecorded: event AuditEngagement.FindingRecorded is {
        send findingRecorded to outlet AuditEngagementEventSplitToAuditRepository
        send findingRecorded to outlet AuditEngagementEventSplitToAuditMetrics
        tell findingRecorded to entity AuditContext.AuditEngagement
      }
      on reportDrafted: event AuditEngagement.ReportDrafted is {
        send reportDrafted to outlet AuditEngagementEventSplitToAuditRepository
        send reportDrafted to outlet AuditEngagementEventSplitToAuditMetrics
        tell reportDrafted to entity AuditContext.AuditEngagement
      }
      on reportSubmittedForReview: event AuditEngagement.ReportSubmittedForReview is {
        send reportSubmittedForReview to outlet AuditEngagementEventSplitToAuditRepository
        send reportSubmittedForReview to outlet AuditEngagementEventSplitToAuditMetrics
        tell reportSubmittedForReview to entity AuditContext.AuditEngagement
      }
      on reportIssued: event AuditEngagement.ReportIssued is {
        send reportIssued to outlet AuditEngagementEventSplitToAuditRepository
        send reportIssued to outlet AuditEngagementEventSplitToAuditMetrics
        tell reportIssued to entity AuditContext.AuditEngagement
      }
      on engagementClosed: event AuditEngagement.EngagementClosed is {
        send engagementClosed to outlet AuditEngagementEventSplitToAuditRepository
        send engagementClosed to outlet AuditEngagementEventSplitToAuditMetrics
        tell engagementClosed to entity AuditContext.AuditEngagement
      }
      on engagementCancelled: event AuditEngagement.EngagementCancelled is {
        send engagementCancelled to outlet AuditEngagementEventSplitToAuditRepository
        send engagementCancelled to outlet AuditEngagementEventSplitToAuditMetrics
        tell engagementCancelled to entity AuditContext.AuditEngagement
      }
      on other is {
        error "Unexpected message for processor AuditEngagementEventSplit"
      }
    } with {
      briefly "AuditEngagement event fan-out handler"
      described as {
        |Delivers each AuditEngagement event to all of its consumers.
      }
    }
  } with {
    briefly "AuditEngagement event fan-out"
    described as {
      |Fans AuditEngagement events out to the repository and projectors.
    }
  }
  connector 'AuditEngagementEvent Stream' is from outlet AuditContext.AuditEngagement.AuditEngagementEvents2 to inlet AuditContext.AuditEngagementEventSplit.AuditEngagementEventSplitIn with {
    briefly "AuditEngagement events, fanned out to storage and read models"
  }
  connector 'AuditEngagementEvent Storage' is from outlet AuditContext.AuditEngagementEventSplit.AuditEngagementEventSplitToAuditRepository to inlet AuditContext.AuditRepository.AuditRepositoryFromAuditEngagement with {
    briefly "AuditEngagement events on their way to storage"
  }
  connector 'AuditMetrics Feed' is from outlet AuditContext.AuditEngagementEventSplit.AuditEngagementEventSplitToAuditMetrics to inlet AuditContext.AuditMetrics.AuditMetricsFromAuditEngagement with {
    briefly "AuditEngagement events feeding the AuditMetrics projection"
  }
  connector 'AuditMetrics Storage' is from outlet AuditContext.AuditMetrics.AuditMetricsOut to inlet AuditContext.AuditRepository.AuditRepositoryFromAuditMetrics with {
    briefly "The AuditMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for audit management"
  described as {
    |Audit engagement management context.
  }
}
