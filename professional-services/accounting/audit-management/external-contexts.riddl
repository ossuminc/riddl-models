// Audit Management - External Contexts
external context DocumentManagement as flow is {
  type DocumentManagementEvent is one of {
    DocumentStored or EngagementDocumentsArchived
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet DocumentManagementEventsOut is type DocumentManagementEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type DocumentManagementCommand is one of {
    ArchiveEngagementDocuments or StoreDocument or RetrieveDocument
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet DocumentManagementRequests is type DocumentManagementCommand with {
    briefly "What this context asks the service to send"
  }
  handler DocumentManagementBoundary is {
    on query RetrieveDocument is {
      let askAnswer: type DocumentContent = prompt("look up what RetrieveDocument asks for")
      reply askAnswer
    }
    on command ArchiveEngagementDocuments is {
      let engagementDocumentsArchived: type EngagementDocumentsArchived = prompt("the engagement documents archived this produces")
      send engagementDocumentsArchived to outlet DocumentManagement.DocumentManagementEventsOut
      do "deliver it to the recipient"
    }
    on command StoreDocument is {
      let documentStored: type DocumentStored = prompt("the document stored this produces")
      send documentStored to outlet DocumentManagement.DocumentManagementEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context DocumentManagement"
    }
  } with {
    briefly "DocumentManagement boundary"
  }
  command StoreDocument is {
    documentId: UUID with {
      briefly "Document ID"
      described as {
        |Document identifier.
      }
    }
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    documentType: String(3,100) with {
      briefly "Type"
      described as {
        |Document type.
      }
    }
    content: String(1,50000) with {
      briefly "Content"
      described as {
        |Document content.
      }
    }
  } with {
    briefly "Store document"
    described as {
      |Stores a document in the document management system.
    }
  }
  event DocumentStored is {
    documentId: UUID with {
      briefly "Document ID"
      described as {
        |Document identifier.
      }
    }
    storedAt: TimeStamp with {
      briefly "Stored"
      described as {
        |Storage time.
      }
    }
  } with {
    briefly "Document stored"
    described as {
      |Emitted when document is stored.
    }
  }
  query RetrieveDocument replies result DocumentContent is {
    documentId: UUID with {
      briefly "Document ID"
      described as {
        |Document identifier.
      }
    }
  } with {
    briefly "Retrieve document"
    described as {
      |Retrieves a stored document.
    }
  }
  result DocumentContent is {
    documentId: UUID with {
      briefly "Document ID"
      described as {
        |Document identifier.
      }
    }
    documentType: String(3,100) with {
      briefly "Type"
      described as {
        |Document type.
      }
    }
    content: String(1,50000) with {
      briefly "Content"
      described as {
        |Document content.
      }
    }
    lastModified: TimeStamp with {
      briefly "Modified"
      described as {
        |Last modification time.
      }
    }
  } with {
    briefly "Document content"
    described as {
      |Retrieved document content.
    }
  }
  command ArchiveEngagementDocuments is {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    retentionYears: Natural with {
      briefly "Retention"
      described as {
        |Retention period in years.
      }
    }
  } with {
    briefly "Archive engagement documents"
    described as {
      |Archives all documents for an engagement.
    }
  }
  event EngagementDocumentsArchived is {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    archivedAt: TimeStamp with {
      briefly "Archived"
      described as {
        |Archive time.
      }
    }
  } with {
    briefly "Engagement documents archived"
    described as {
      |Emitted when engagement documents are archived.
    }
  }
} with {
  briefly "External document management"
  described as {
    |Document management and archival system.
  }
}
external context RegulatoryFiling as flow is {
  outlet RegulatoryFilingEventsOut is event FilingSubmitted
 with {
    briefly "What this service tells the model, unasked"
  }
  type RegulatoryFilingRequest is one of {
    SubmitFiling or GetFilingStatus
  } with {
    briefly "Everything this service can be asked"
  }
  inlet RegulatoryFilingRequests is type RegulatoryFilingRequest with {
    briefly "What this context asks the service to send"
  }
  handler RegulatoryFilingBoundary is {
    on query GetFilingStatus is {
      let askAnswer: type FilingStatus = prompt("look up what GetFilingStatus asks for")
      reply askAnswer
    }
    on command SubmitFiling is {
      let filingSubmitted: type FilingSubmitted = prompt("the filing submitted this produces")
      send filingSubmitted to outlet RegulatoryFiling.RegulatoryFilingEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context RegulatoryFiling"
    }
  } with {
    briefly "RegulatoryFiling boundary"
  }
  command SubmitFiling is {
    filingId: UUID with {
      briefly "Filing ID"
      described as {
        |Filing identifier.
      }
    }
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    regulatoryBody: String(3,200) with {
      briefly "Regulatory body"
      described as {
        |Target regulatory body.
      }
    }
    filingType: String(3,100) with {
      briefly "Filing type"
      described as {
        |Type of filing.
      }
    }
    reportContent: String(1,50000) with {
      briefly "Content"
      described as {
        |Filing content.
      }
    }
  } with {
    briefly "Submit filing"
    described as {
      |Submits a regulatory filing.
    }
  }
  event FilingSubmitted is {
    filingId: UUID with {
      briefly "Filing ID"
      described as {
        |Filing identifier.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
    confirmationNumber: String(3,100) with {
      briefly "Confirmation"
      described as {
        |Filing confirmation number.
      }
    }
  } with {
    briefly "Filing submitted"
    described as {
      |Emitted when filing is submitted.
    }
  }
  query GetFilingStatus replies result FilingStatus is {
    filingId: UUID with {
      briefly "Filing ID"
      described as {
        |Filing identifier.
      }
    }
  } with {
    briefly "Get filing status"
    described as {
      |Checks status of a regulatory filing.
    }
  }
  result FilingStatus is {
    filingId: UUID with {
      briefly "Filing ID"
      described as {
        |Filing identifier.
      }
    }
    filingStatus: String(3,50) with {
      briefly "Status"
      described as {
        |Filing status.
      }
    }
    receivedDate: Date? with {
      briefly "Received"
      described as {
        |Date filing was received.
      }
    }
    acceptedDate: Date? with {
      briefly "Accepted"
      described as {
        |Date filing was accepted.
      }
    }
  } with {
    briefly "Filing status"
    described as {
      |Status of a regulatory filing.
    }
  }
} with {
  briefly "External regulatory filing"
  described as {
    |Regulatory filing and compliance system.
  }
}
