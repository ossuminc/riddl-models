// Audit Management Domain Model
// Audit engagement planning, fieldwork, findings, and reporting
domain AuditManagement is {
  persistent connector 'RegulatoryFilingReply Stream' is from outlet RegulatoryFiling.RegulatoryFilingRepliesOut to inlet AuditContext.ToRegulatoryFiling.ToRegulatoryFilingReplies with {
    briefly "What RegulatoryFiling answers AuditContext"
  }
  persistent connector 'DocumentManagementReply Stream' is from outlet DocumentManagement.DocumentManagementRepliesOut to inlet AuditContext.ToDocumentManagement.ToDocumentManagementReplies with {
    briefly "What DocumentManagement answers AuditContext"
  }
  persistent connector 'DocumentManagementEvent Stream' is from outlet DocumentManagement.DocumentManagementEventsOut to inlet AuditContext.FromDocumentManagement.FromDocumentManagementIn with {
    briefly "What DocumentManagement tells AuditContext, unasked"
  }
  persistent connector 'RegulatoryFilingEvent Stream' is from outlet RegulatoryFiling.RegulatoryFilingEventsOut to inlet AuditContext.FromRegulatoryFiling.FromRegulatoryFilingIn with {
    briefly "What RegulatoryFiling tells AuditContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user AuditPartner is "person overseeing audit engagements" with {
    briefly "Audit Partner"
    described as {
      |Senior partner responsible for audit quality.
    }
  }
  user AuditManager is "person managing audit fieldwork" with {
    briefly "Audit Manager"
    described as {
      |Manager coordinating audit teams and tasks.
    }
  }
  user AuditStaff is "person performing audit procedures" with {
    briefly "Audit Staff"
    described as {
      |Staff auditor executing fieldwork and documentation.
    }
  }
  epic AuditEngagementLifecycle is {
    user AuditManager wants to "to manage audit engagements end-to-end" so that "audits are completed on time with proper documentation"
    case PlanAndExecuteAudit is {
      user AuditManager wants to "to plan and execute an audit engagement" so that "fieldwork is completed and findings are reported"
      step is "Manager creates" "audit engagement" "from client request" with {
        briefly "Create engagement"
        described as {
          |Initiate audit.
        }
      }
      step is "Staff performs" "fieldwork procedures" "per audit plan" with {
        briefly "Execute fieldwork"
        described as {
          |Perform procedures.
        }
      }
    } with {
      briefly "Plan and execute audit"
      described as {
        |Full audit engagement lifecycle.
      }
    }
  } with {
    briefly "Audit engagement lifecycle"
    described as {
      |Epic for audit planning through report issuance.
    }
  }
  include "AuditContext.riddl"
  include "external-contexts.riddl"
  application context AuditManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in AuditManagement are delivered.
      }
    }
    group AuditManagementScreen is {
      input AddWorkpaperInput acquires command AuditContext.AuditEngagement.AddWorkpaper with {
        briefly "Add workpaper control"
        described as {
          |The control through which a user submits the add workpaper request.
        }
      }
      input AssignTeamInput acquires command AuditContext.AuditEngagement.AssignTeam with {
        briefly "Assign team control"
        described as {
          |The control through which a user submits the assign team request.
        }
      }
      input BeginFieldworkInput acquires command AuditContext.AuditEngagement.BeginFieldwork with {
        briefly "Begin fieldwork control"
        described as {
          |The control through which a user submits the begin fieldwork request.
        }
      }
      input CancelEngagementInput acquires command AuditContext.AuditEngagement.CancelEngagement with {
        briefly "Cancel engagement control"
        described as {
          |The control through which a user submits the cancel engagement request.
        }
      }
      input CloseEngagementInput acquires command AuditContext.AuditEngagement.CloseEngagement with {
        briefly "Close engagement control"
        described as {
          |The control through which a user submits the close engagement request.
        }
      }
      input CompleteWorkpaperReviewInput acquires command AuditContext.AuditEngagement.CompleteWorkpaperReview with {
        briefly "Complete workpaper review control"
        described as {
          |The control through which a user submits the complete workpaper review request.
        }
      }
      input DraftReportInput acquires command AuditContext.AuditEngagement.DraftReport with {
        briefly "Draft report control"
        described as {
          |The control through which a user submits the draft report request.
        }
      }
      input IssueReportInput acquires command AuditContext.AuditEngagement.IssueReport with {
        briefly "Issue report control"
        described as {
          |The control through which a user submits the issue report request.
        }
      }
      input SubmitReportForReviewInput acquires command AuditContext.AuditEngagement.SubmitReportForReview with {
        briefly "Submit report for review control"
        described as {
          |The control through which a user submits the submit report for review request.
        }
      }
      input CreateEngagementInput acquires command AuditContext.CreateEngagement with {
        briefly "Create engagement control"
        described as {
          |The control through which a user submits the create engagement request.
        }
      }
    } with {
      briefly "Audit management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppAuditEngagementCommands is type AuditContext.AuditEngagementRequest
    inlet AppAuditRepositoryResponses is result AuditContext.AuditEngagement.AuditEngagementResult
    handler AuditManagementAppHandler is {
      on other is {
        error "Unexpected message for application context AuditManagementApp"
      }
    } with {
      briefly "AuditManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "AuditManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'RegulatoryFilingRequest Stream' is from outlet AuditContext.ToRegulatoryFiling.ToRegulatoryFilingOut to inlet RegulatoryFiling.RegulatoryFilingRequests with {
    briefly "What AuditContext asks RegulatoryFiling to send"
  }
  persistent connector 'DocumentManagementRequest Stream' is from outlet AuditContext.ToDocumentManagement.ToDocumentManagementOut to inlet DocumentManagement.DocumentManagementRequests with {
    briefly "What AuditContext asks DocumentManagement to send"
  }
  persistent connector 'AuditEngagementCommand Stream' is from outlet AuditManagementApp.AppAuditEngagementCommands to inlet AuditContext.AuditEngagementCommandStreamIn with {
    briefly "AuditEngagement commands from the application"
  }
  persistent connector 'AuditEngagementResult Stream' is from outlet AuditContext.AuditEngagementResultStreamOut to inlet AuditManagementApp.AppAuditRepositoryResponses with {
    briefly "Audit query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet AuditManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Audit management domain"
  described as {
    |Audit engagement planning, fieldwork, findings, and reporting.
  }
}
