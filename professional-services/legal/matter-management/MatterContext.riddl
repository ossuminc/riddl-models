// Matter Management - Matter Context
context MatterContext is {
  include "types.riddl"
  include "LegalMatter.riddl"
  repository MatterRepository is {
    schema MatterData is relational
      of legalMatters as type LegalMatter
        index on field LegalMatter.matterId
        index on field LegalMatter.matterInfo.clientInfo.clientId
        index on field LegalMatter.status

    handler MatterPersistence is {
      on command LegalMatter.CreateMatter is {
        tell event LegalMatter.MatterCreated to entity MatterContext.LegalMatter
        prompt "Store new legal matter"
      }
      on command LegalMatter.RecordConflictCheck is {
        tell event LegalMatter.ConflictCheckRecorded to entity MatterContext.LegalMatter
        prompt "Update matter conflict check result"
      }
      on command LegalMatter.AssignTeam is {
        tell event LegalMatter.TeamAssigned to entity MatterContext.LegalMatter
        prompt "Store team assignment"
      }
      on command LegalMatter.ActivateMatter is {
        prompt "Update matter to active"
      }
      on command LegalMatter.RecordTime is {
        tell event LegalMatter.TimeRecorded to entity MatterContext.LegalMatter
        prompt "Store time entry"
      }
      on command LegalMatter.RecordExpense is {
        tell event LegalMatter.ExpenseRecorded to entity MatterContext.LegalMatter
        prompt "Store expense entry"
      }
      on command LegalMatter.AttachDocument is {
        prompt "Store document reference"
      }
      on command LegalMatter.CloseMatter is {
        tell event LegalMatter.MatterClosed to entity MatterContext.LegalMatter
        prompt "Update matter to closed"
      }
    } with {
      briefly "Persists matter commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Matter data persistence"
    described as {
      |Persistent storage for legal matters.
    }
  }
  projector MatterMetrics is {
    updates repository MatterContext.MatterRepository
    record MatterAnalytics is  {
      mattersOpened: Natural with {
        briefly "Opened"
        described as {
          |Matters opened.
        }
      }
      mattersClosed: Natural with {
        briefly "Closed"
        described as {
          |Matters closed.
        }
      }
      mattersRejected: Natural with {
        briefly "Rejected"
        described as {
          |Matters rejected.
        }
      }
      totalBillableHours: Decimal(10,2) with {
        briefly "Hours"
        described as {
          |Total billable hours.
        }
      }
      totalExpenses: Decimal(12,2) with {
        briefly "Expenses"
        described as {
          |Total expenses.
        }
      }
      averageMatterDuration: Decimal(8,2) with {
        briefly "Avg duration"
        described as {
          |Average matter duration in days.
        }
      }
    } with {
      briefly "Matter analytics"
      described as {
        |Matter processing analytics.
      }
    }
    handler MetricsHandler is {
      on event LegalMatter.MatterCreated is {
        tell event LegalMatter.MatterCreated to repository MatterContext.MatterRepository
        prompt "Increment matters opened"
      }
      on event LegalMatter.TimeRecorded is {
        tell event LegalMatter.TimeRecorded to repository MatterContext.MatterRepository
        prompt "Add to total billable hours"
      }
      on event LegalMatter.ExpenseRecorded is {
        tell event LegalMatter.ExpenseRecorded to repository MatterContext.MatterRepository
        prompt "Add to total expenses"
      }
      on event LegalMatter.MatterClosed is {
        tell event LegalMatter.MatterClosed to repository MatterContext.MatterRepository
        prompt "Increment matters closed and calculate duration"
      }
      on event LegalMatter.MatterRejected is {
        tell event LegalMatter.MatterRejected to repository MatterContext.MatterRepository
        prompt "Increment matters rejected"
      }
    } with {
      briefly "Maintains matter metrics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Matter metrics"
    described as {
      |Legal matter analytics and reporting.
    }
  }
  // ---- Event publication for LegalMatter ----
  type LegalMatterEvent is one of {
    MatterContext.LegalMatter.MatterCreated,
    MatterContext.LegalMatter.ConflictCheckRecorded,
    MatterContext.LegalMatter.TeamAssigned,
    MatterContext.LegalMatter.MatterActivated,
    MatterContext.LegalMatter.TimeRecorded,
    MatterContext.LegalMatter.ExpenseRecorded,
    MatterContext.LegalMatter.DocumentAttached,
    MatterContext.LegalMatter.CourtDeadlineAdded,
    MatterContext.LegalMatter.DeadlineCompleted,
    MatterContext.LegalMatter.MatterPlacedOnHold,
    MatterContext.LegalMatter.MatterReactivated,
    MatterContext.LegalMatter.MatterClosed,
    MatterContext.LegalMatter.MatterRejected
  } with {
    briefly "LegalMatter event alternation"
    described as {
      |Union of all LegalMatter events, for streaming and event-sourced
      |persistence.
    }
  }
  processor LegalMatterEventSource as source is {
    outlet LegalMatterEvents is type LegalMatterEvent
    handler LegalMatterSourceHandler is {
      on event LegalMatter.MatterCreated is {
        send event LegalMatter.MatterCreated to outlet LegalMatterEvents
      }
      on event LegalMatter.ConflictCheckRecorded is {
        send event LegalMatter.ConflictCheckRecorded to outlet LegalMatterEvents
      }
      on event LegalMatter.TeamAssigned is {
        send event LegalMatter.TeamAssigned to outlet LegalMatterEvents
      }
      on event LegalMatter.MatterActivated is {
        send event LegalMatter.MatterActivated to outlet LegalMatterEvents
      }
      on event LegalMatter.TimeRecorded is {
        send event LegalMatter.TimeRecorded to outlet LegalMatterEvents
      }
      on event LegalMatter.ExpenseRecorded is {
        send event LegalMatter.ExpenseRecorded to outlet LegalMatterEvents
      }
      on event LegalMatter.DocumentAttached is {
        send event LegalMatter.DocumentAttached to outlet LegalMatterEvents
      }
      on event LegalMatter.CourtDeadlineAdded is {
        send event LegalMatter.CourtDeadlineAdded to outlet LegalMatterEvents
      }
      on event LegalMatter.DeadlineCompleted is {
        send event LegalMatter.DeadlineCompleted to outlet LegalMatterEvents
      }
      on event LegalMatter.MatterPlacedOnHold is {
        send event LegalMatter.MatterPlacedOnHold to outlet LegalMatterEvents
      }
      on event LegalMatter.MatterReactivated is {
        send event LegalMatter.MatterReactivated to outlet LegalMatterEvents
      }
      on event LegalMatter.MatterClosed is {
        send event LegalMatter.MatterClosed to outlet LegalMatterEvents
      }
      on event LegalMatter.MatterRejected is {
        send event LegalMatter.MatterRejected to outlet LegalMatterEvents
      }
      on other is {
        error "Unexpected message for source LegalMatterEventSource"
      }
    } with {
      briefly "LegalMatter source handler"
      described as {
        |Publishes LegalMatter events onto the outlet.
      }
    }
  } with {
    briefly "LegalMatter event source"
    described as {
      |Publishes LegalMatter entity events into the streaming topology.
    }
  }
  processor LegalMatterEventSink as sink is {
    inlet LegalMatterInlet is type LegalMatterEvent
    handler LegalMatterSinkHandler is {
      on event LegalMatter.MatterCreated is {
        tell event LegalMatter.MatterCreated to repository MatterContext.MatterRepository
      }
      on event LegalMatter.ConflictCheckRecorded is {
        tell event LegalMatter.ConflictCheckRecorded to repository MatterContext.MatterRepository
      }
      on event LegalMatter.TeamAssigned is {
        tell event LegalMatter.TeamAssigned to repository MatterContext.MatterRepository
      }
      on event LegalMatter.MatterActivated is {
        tell event LegalMatter.MatterActivated to repository MatterContext.MatterRepository
      }
      on event LegalMatter.TimeRecorded is {
        tell event LegalMatter.TimeRecorded to repository MatterContext.MatterRepository
      }
      on event LegalMatter.ExpenseRecorded is {
        tell event LegalMatter.ExpenseRecorded to repository MatterContext.MatterRepository
      }
      on event LegalMatter.DocumentAttached is {
        tell event LegalMatter.DocumentAttached to repository MatterContext.MatterRepository
      }
      on event LegalMatter.CourtDeadlineAdded is {
        tell event LegalMatter.CourtDeadlineAdded to repository MatterContext.MatterRepository
      }
      on event LegalMatter.DeadlineCompleted is {
        tell event LegalMatter.DeadlineCompleted to repository MatterContext.MatterRepository
      }
      on event LegalMatter.MatterPlacedOnHold is {
        tell event LegalMatter.MatterPlacedOnHold to repository MatterContext.MatterRepository
      }
      on event LegalMatter.MatterReactivated is {
        tell event LegalMatter.MatterReactivated to repository MatterContext.MatterRepository
      }
      on event LegalMatter.MatterClosed is {
        tell event LegalMatter.MatterClosed to repository MatterContext.MatterRepository
      }
      on event LegalMatter.MatterRejected is {
        tell event LegalMatter.MatterRejected to repository MatterContext.MatterRepository
      }
      on other is {
        error "Unexpected message for sink LegalMatterEventSink"
      }
    } with {
      briefly "LegalMatter sink handler"
      described as {
        |Persists LegalMatter events via the repository.
      }
    }
  } with {
    briefly "LegalMatter event sink"
    described as {
      |Receives LegalMatter events for persistence.
    }
  }
  connector LegalMatterEventFlow is {
    from outlet MatterContext.LegalMatterEventSource.LegalMatterEvents to
      inlet MatterContext.LegalMatterEventSink.LegalMatterInlet
  } with {
    briefly "LegalMatter event flow"
    described as {
      |Connects the LegalMatter source to its sink.
    }
  }
} with {
  briefly "Bounded context for matter management"
  described as {
    |Legal matter management context.
  }
}
