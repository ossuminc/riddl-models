// Matter Management - Matter Context
context MatterContext as router is {
  inlet LegalMatterCommandStreamIn is type LegalMatterCommand  outlet LegalMatterCommandStreamOut is type LegalMatterCommand
  inlet LegalMatterResultStreamIn is type LegalMatter.LegalMatterResult  outlet LegalMatterResultStreamOut is type LegalMatter.LegalMatterResult
  handler MatterContextBoundary is {
    on createMatter: command LegalMatter.CreateMatter is {
      send createMatter to outlet MatterContext.LegalMatterCommandStreamOut
    }
    on recordConflictCheck: command LegalMatter.RecordConflictCheck is {
      send recordConflictCheck to outlet MatterContext.LegalMatterCommandStreamOut
    }
    on assignTeam: command LegalMatter.AssignTeam is {
      send assignTeam to outlet MatterContext.LegalMatterCommandStreamOut
    }
    on activateMatter: command LegalMatter.ActivateMatter is {
      send activateMatter to outlet MatterContext.LegalMatterCommandStreamOut
    }
    on recordTime: command LegalMatter.RecordTime is {
      send recordTime to outlet MatterContext.LegalMatterCommandStreamOut
    }
    on recordExpense: command LegalMatter.RecordExpense is {
      send recordExpense to outlet MatterContext.LegalMatterCommandStreamOut
    }
    on attachDocument: command LegalMatter.AttachDocument is {
      send attachDocument to outlet MatterContext.LegalMatterCommandStreamOut
    }
    on addCourtDeadline: command LegalMatter.AddCourtDeadline is {
      send addCourtDeadline to outlet MatterContext.LegalMatterCommandStreamOut
    }
    on completeDeadline: command LegalMatter.CompleteDeadline is {
      send completeDeadline to outlet MatterContext.LegalMatterCommandStreamOut
    }
    on placeMatterOnHold: command LegalMatter.PlaceMatterOnHold is {
      send placeMatterOnHold to outlet MatterContext.LegalMatterCommandStreamOut
    }
    on reactivateMatter: command LegalMatter.ReactivateMatter is {
      send reactivateMatter to outlet MatterContext.LegalMatterCommandStreamOut
    }
    on closeMatter: command LegalMatter.CloseMatter is {
      send closeMatter to outlet MatterContext.LegalMatterCommandStreamOut
    }
    on rejectMatter: command LegalMatter.RejectMatter is {
      send rejectMatter to outlet MatterContext.LegalMatterCommandStreamOut
    }
    on legalMatterResult: result LegalMatter.LegalMatterResult is {
      send legalMatterResult to outlet MatterContext.LegalMatterResultStreamOut
    }
    on other is {
      error "Unexpected message at the MatterContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'LegalMatterCommand Stream Intake' is from outlet MatterContext.LegalMatterCommandStreamOut to inlet MatterContext.LegalMatter.LegalMatterCommands  connector 'LegalMatterResult Stream Egress' is from outlet MatterContext.MatterRepository.MatterRepositoryResponses to inlet MatterContext.LegalMatterResultStreamIn  adaptor FromCourtFilingSystem from context CourtFilingSystem is { 
    handler FromCourtFilingSystemHandler is {
      on result CourtFilingSystem.FilingDeadlines is {
        do "the model receives filing deadlines"
      }
      on event CourtFilingSystem.FilingSubmitted is {
        do "the model receives filing submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromCourtFilingSystem"
      }
    } with {
      briefly "from court filing system"
      described as {
        |Carries messages from the external CourtFilingSystem.
      }
    }
  } with {
    briefly "CourtFilingSystem integration"
    described as {
      |The model's side of the CourtFilingSystem conversation.
    }
  }
  adaptor ToCourtFilingSystem to context CourtFilingSystem is { 
    handler ToCourtFilingSystemHandler is {
      on query CourtFilingSystem.GetFilingDeadlines is {
        do "the model sends get filing deadlines"
      }
      on command CourtFilingSystem.SubmitFiling is {
        do "the model sends submit filing"
      }
      on other is {
        error "Unexpected message for adaptor ToCourtFilingSystem"
      }
    } with {
      briefly "to court filing system"
      described as {
        |Carries messages to the external CourtFilingSystem.
      }
    }
  } with {
    briefly "CourtFilingSystem integration"
    described as {
      |The model's side of the CourtFilingSystem conversation.
    }
  }
  adaptor FromTimekeepingSystem from context TimekeepingSystem is { 
    handler FromTimekeepingSystemHandler is {
      on event TimekeepingSystem.ExpenseEntrySynced is {
        do "the model receives expense entry synced"
      }
      on result TimekeepingSystem.MatterBillingSummary is {
        do "the model receives matter billing summary"
      }
      on event TimekeepingSystem.TimeEntrySynced is {
        do "the model receives time entry synced"
      }
      on other is {
        error "Unexpected message for adaptor FromTimekeepingSystem"
      }
    } with {
      briefly "from timekeeping system"
      described as {
        |Carries messages from the external TimekeepingSystem.
      }
    }
  } with {
    briefly "TimekeepingSystem integration"
    described as {
      |The model's side of the TimekeepingSystem conversation.
    }
  }
  adaptor ToTimekeepingSystem to context TimekeepingSystem is { 
    handler ToTimekeepingSystemHandler is {
      on query TimekeepingSystem.GetMatterBillingSummary is {
        do "the model sends get matter billing summary"
      }
      on command TimekeepingSystem.SyncExpenseEntry is {
        do "the model sends sync expense entry"
      }
      on command TimekeepingSystem.SyncTimeEntry is {
        do "the model sends sync time entry"
      }
      on other is {
        error "Unexpected message for adaptor ToTimekeepingSystem"
      }
    } with {
      briefly "to timekeeping system"
      described as {
        |Carries messages to the external TimekeepingSystem.
      }
    }
  } with {
    briefly "TimekeepingSystem integration"
    described as {
      |The model's side of the TimekeepingSystem conversation.
    }
  }
  include "types.riddl"
  include "LegalMatter.riddl"
  type MatterRepositoryCommand is one of {
    MatterContext.MatterRepository.PersistConflictCheckRecorded or MatterContext.MatterRepository.PersistCourtDeadlineAdded or MatterContext.MatterRepository.PersistDeadlineCompleted or MatterContext.MatterRepository.PersistDocumentAttached or MatterContext.MatterRepository.PersistExpenseRecorded or MatterContext.MatterRepository.PersistMatterActivated or MatterContext.MatterRepository.PersistMatterClosed or MatterContext.MatterRepository.PersistMatterCreated or MatterContext.MatterRepository.PersistMatterPlacedOnHold or MatterContext.MatterRepository.PersistMatterReactivated or MatterContext.MatterRepository.PersistMatterRejected or MatterContext.MatterRepository.PersistTeamAssigned or MatterContext.MatterRepository.PersistTimeRecorded
  } with {
    briefly "Anything that writes MatterRepository"
    described as {
      |The persistence commands MatterRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository MatterRepository as flow is {
    inlet MatterRepositoryFromMatterMetrics is type MatterRepositoryCommand
    command PersistConflictCheckRecorded is  {
      matterId: MatterId with {
        briefly "Row addressed"
        described as {
          |Which stored row ConflictCheckRecorded applies to.
        }
      }
    } with {
      briefly "Persist ConflictCheckRecorded"
      described as {
        |Instructs this repository to apply ConflictCheckRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCourtDeadlineAdded is  {
      matterId: MatterId with {
        briefly "Row addressed"
        described as {
          |Which stored row CourtDeadlineAdded applies to.
        }
      }
    } with {
      briefly "Persist CourtDeadlineAdded"
      described as {
        |Instructs this repository to apply CourtDeadlineAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeadlineCompleted is  {
      matterId: MatterId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeadlineCompleted applies to.
        }
      }
    } with {
      briefly "Persist DeadlineCompleted"
      described as {
        |Instructs this repository to apply DeadlineCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDocumentAttached is  {
      matterId: MatterId with {
        briefly "Row addressed"
        described as {
          |Which stored row DocumentAttached applies to.
        }
      }
    } with {
      briefly "Persist DocumentAttached"
      described as {
        |Instructs this repository to apply DocumentAttached to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMatterActivated is  {
      matterId: MatterId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatterActivated applies to.
        }
      }
    } with {
      briefly "Persist MatterActivated"
      described as {
        |Instructs this repository to apply MatterActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMatterPlacedOnHold is  {
      matterId: MatterId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatterPlacedOnHold applies to.
        }
      }
    } with {
      briefly "Persist MatterPlacedOnHold"
      described as {
        |Instructs this repository to apply MatterPlacedOnHold to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMatterReactivated is  {
      matterId: MatterId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatterReactivated applies to.
        }
      }
    } with {
      briefly "Persist MatterReactivated"
      described as {
        |Instructs this repository to apply MatterReactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTeamAssigned is  {
      matterId: MatterId with {
        briefly "Row addressed"
        described as {
          |Which stored row TeamAssigned applies to.
        }
      }
    } with {
      briefly "Persist TeamAssigned"
      described as {
        |Instructs this repository to apply TeamAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExpenseRecorded is  {
      matterId: MatterId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExpenseRecorded applies to.
        }
      }
    } with {
      briefly "Persist ExpenseRecorded"
      described as {
        |Instructs this repository to apply ExpenseRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMatterClosed is  {
      matterId: MatterId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatterClosed applies to.
        }
      }
    } with {
      briefly "Persist MatterClosed"
      described as {
        |Instructs this repository to apply MatterClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMatterCreated is  {
      matterId: MatterId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatterCreated applies to.
        }
      }
    } with {
      briefly "Persist MatterCreated"
      described as {
        |Instructs this repository to apply MatterCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMatterRejected is  {
      matterId: MatterId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatterRejected applies to.
        }
      }
    } with {
      briefly "Persist MatterRejected"
      described as {
        |Instructs this repository to apply MatterRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTimeRecorded is  {
      matterId: MatterId with {
        briefly "Row addressed"
        described as {
          |Which stored row TimeRecorded applies to.
        }
      }
    } with {
      briefly "Persist TimeRecorded"
      described as {
        |Instructs this repository to apply TimeRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet MatterRepositoryResponses is type LegalMatter.LegalMatterResult
    record StoredLegalMatter is  {
      legalMatterId: UUID with {
        briefly "legalMatterId"
        described as {
          |The legalMatterId column of the stored legalMatter row.
        }
      }
      matterId: MatterId with {
        briefly "matterId"
        described as {
          |The matterId column of the stored legalMatter row.
        }
      }
      matterInfo: MatterInfo with {
        briefly "matterInfo"
        described as {
          |The matterInfo column of the stored legalMatter row.
        }
      }
      status: MatterStatus with {
        briefly "status"
        described as {
          |The status column of the stored legalMatter row.
        }
      }
    } with {
      briefly "Stored legalMatter row"
      described as {
        |The persistence shape of legalMatter data as this repository stores it.
      }
    }
    schema MatterData is relational
      of legalMatters as type StoredLegalMatter
        index on field StoredLegalMatter.matterId
        index on field StoredLegalMatter.matterInfo.clientInfo.clientId
        index on field StoredLegalMatter.status
 with {
      briefly "Matter data schema"
      described as {
        |The relational schema holding matter data for the MatterRepository.
      }
    }
    handler MatterPersistence is {
      on persistConflictCheckRecorded: command PersistConflictCheckRecorded is {
        do "apply ConflictCheckRecorded to the stored row"
      }
      on persistCourtDeadlineAdded: command PersistCourtDeadlineAdded is {
        do "apply CourtDeadlineAdded to the stored row"
      }
      on persistDeadlineCompleted: command PersistDeadlineCompleted is {
        do "apply DeadlineCompleted to the stored row"
      }
      on persistDocumentAttached: command PersistDocumentAttached is {
        do "apply DocumentAttached to the stored row"
      }
      on persistMatterActivated: command PersistMatterActivated is {
        do "apply MatterActivated to the stored row"
      }
      on persistMatterPlacedOnHold: command PersistMatterPlacedOnHold is {
        do "apply MatterPlacedOnHold to the stored row"
      }
      on persistMatterReactivated: command PersistMatterReactivated is {
        do "apply MatterReactivated to the stored row"
      }
      on persistTeamAssigned: command PersistTeamAssigned is {
        do "apply TeamAssigned to the stored row"
      }
      on persistExpenseRecorded: command PersistExpenseRecorded is {
        do "apply ExpenseRecorded to the stored row"
      }
      on persistMatterClosed: command PersistMatterClosed is {
        do "apply MatterClosed to the stored row"
      }
      on persistMatterCreated: command PersistMatterCreated is {
        do "apply MatterCreated to the stored row"
      }
      on persistMatterRejected: command PersistMatterRejected is {
        do "apply MatterRejected to the stored row"
      }
      on persistTimeRecorded: command PersistTimeRecorded is {
        do "apply TimeRecorded to the stored row"
      }
      on query GetMatterAnalytics is {
        let matterAnalyticsView: type MatterAnalyticsView = prompt("read the matter analytics projection")
        reply matterAnalyticsView
      }
    } with {
      briefly "Persists matter commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Matter data persistence"
    described as {
      |Persistent storage for legal matters.
    }
  }
  query GetMatterAnalytics replies result MatterAnalyticsView is  {
    matterAnalyticsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which matter analytics to retrieve.
      }
    }
  } with {
    briefly "Get matter analytics"
    described as {
      |Retrieves the matter analytics projection.
    }
  }
  result MatterAnalyticsView is  {
    matterAnalytics: MatterMetrics.MatterAnalytics with {
      briefly "Matter analytics"
      described as {
        |The matter analytics being returned.
      }
    }
  } with {
    briefly "Matter analytics view"
    described as {
      |Read model view carrying the matter analytics projection.
    }
  }
  projector MatterMetrics as flow is {
    outlet MatterMetricsToRepository is type MatterRepositoryCommand
    updates repository MatterContext.MatterRepository
    inlet MatterMetricsFromLegalMatter is type LegalMatterEvent
    record MatterAnalytics is  {
      mattersOpened: Natural with {
        briefly "Opened"
        described as {
          |Matters opened.
        }
      }
      mattersClosed: Natural with {
        briefly "Closed"
        described as {
          |Matters closed.
        }
      }
      mattersRejected: Natural with {
        briefly "Rejected"
        described as {
          |Matters rejected.
        }
      }
      totalBillableHours: Decimal(10,2) with {
        briefly "Hours"
        described as {
          |Total billable hours.
        }
      }
      totalExpenses: Decimal(12,2) with {
        briefly "Expenses"
        described as {
          |Total expenses.
        }
      }
      averageMatterDuration: Decimal(8,2) with {
        briefly "Avg duration"
        described as {
          |Average matter duration in days.
        }
      }
    } with {
      briefly "Matter analytics"
      described as {
        |Matter processing analytics.
      }
    }
    handler MetricsHandler is {
      on conflictCheckRecorded: event LegalMatter.ConflictCheckRecorded is {
        tell command MatterContext.MatterRepository.PersistConflictCheckRecorded(matterId = conflictCheckRecorded.matterId) to repository MatterContext.MatterRepository
        do "apply ConflictCheckRecorded to the MatterMetrics projection"
      }
      on courtDeadlineAdded: event LegalMatter.CourtDeadlineAdded is {
        tell command MatterContext.MatterRepository.PersistCourtDeadlineAdded(matterId = courtDeadlineAdded.matterId) to repository MatterContext.MatterRepository
        do "apply CourtDeadlineAdded to the MatterMetrics projection"
      }
      on deadlineCompleted: event LegalMatter.DeadlineCompleted is {
        tell command MatterContext.MatterRepository.PersistDeadlineCompleted(matterId = deadlineCompleted.matterId) to repository MatterContext.MatterRepository
        do "apply DeadlineCompleted to the MatterMetrics projection"
      }
      on documentAttached: event LegalMatter.DocumentAttached is {
        tell command MatterContext.MatterRepository.PersistDocumentAttached(matterId = documentAttached.matterId) to repository MatterContext.MatterRepository
        do "apply DocumentAttached to the MatterMetrics projection"
      }
      on matterActivated: event LegalMatter.MatterActivated is {
        tell command MatterContext.MatterRepository.PersistMatterActivated(matterId = matterActivated.matterId) to repository MatterContext.MatterRepository
        do "apply MatterActivated to the MatterMetrics projection"
      }
      on matterPlacedOnHold: event LegalMatter.MatterPlacedOnHold is {
        tell command MatterContext.MatterRepository.PersistMatterPlacedOnHold(matterId = matterPlacedOnHold.matterId) to repository MatterContext.MatterRepository
        do "apply MatterPlacedOnHold to the MatterMetrics projection"
      }
      on matterReactivated: event LegalMatter.MatterReactivated is {
        tell command MatterContext.MatterRepository.PersistMatterReactivated(matterId = matterReactivated.matterId) to repository MatterContext.MatterRepository
        do "apply MatterReactivated to the MatterMetrics projection"
      }
      on teamAssigned: event LegalMatter.TeamAssigned is {
        tell command MatterContext.MatterRepository.PersistTeamAssigned(matterId = teamAssigned.matterId) to repository MatterContext.MatterRepository
        do "apply TeamAssigned to the MatterMetrics projection"
      }
      on matterCreated: event LegalMatter.MatterCreated is {
        tell command MatterContext.MatterRepository.PersistMatterCreated(matterId = matterCreated.matterId) to repository MatterContext.MatterRepository
        do "Increment matters opened"
      }
      on timeRecorded: event LegalMatter.TimeRecorded is {
        tell command MatterContext.MatterRepository.PersistTimeRecorded(matterId = timeRecorded.matterId) to repository MatterContext.MatterRepository
        do "Add to total billable hours"
      }
      on expenseRecorded: event LegalMatter.ExpenseRecorded is {
        tell command MatterContext.MatterRepository.PersistExpenseRecorded(matterId = expenseRecorded.matterId) to repository MatterContext.MatterRepository
        do "Add to total expenses"
      }
      on matterClosed: event LegalMatter.MatterClosed is {
        tell command MatterContext.MatterRepository.PersistMatterClosed(matterId = matterClosed.matterId) to repository MatterContext.MatterRepository
        do "Increment matters closed and calculate duration"
      }
      on matterRejected: event LegalMatter.MatterRejected is {
        tell command MatterContext.MatterRepository.PersistMatterRejected(matterId = matterRejected.matterId) to repository MatterContext.MatterRepository
        do "Increment matters rejected"
      }
    } with {
      briefly "Maintains matter metrics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Matter metrics"
    described as {
      |Legal matter analytics and reporting.
    }
  }
  // ---- Event publication for LegalMatter ----
  type LegalMatterEvent is one of {
    MatterContext.LegalMatter.MatterCreated or MatterContext.LegalMatter.ConflictCheckRecorded or MatterContext.LegalMatter.TeamAssigned or MatterContext.LegalMatter.MatterActivated or MatterContext.LegalMatter.TimeRecorded or MatterContext.LegalMatter.ExpenseRecorded or MatterContext.LegalMatter.DocumentAttached or MatterContext.LegalMatter.CourtDeadlineAdded or MatterContext.LegalMatter.DeadlineCompleted or MatterContext.LegalMatter.MatterPlacedOnHold or MatterContext.LegalMatter.MatterReactivated or MatterContext.LegalMatter.MatterClosed or MatterContext.LegalMatter.MatterRejected
  } with {
    briefly "LegalMatter event alternation"
    described as {
      |Union of all LegalMatter events, for streaming and event-sourced
      |persistence.
    }
  }
  processor LegalMatterEventSplit as flow is {
    inlet LegalMatterEventSplitIn is type LegalMatterEvent
    outlet LegalMatterEventSplitToMatterMetrics is type LegalMatterEvent
    handler LegalMatterEventSplitHandler is {
      on matterCreated: event LegalMatter.MatterCreated is {
        send matterCreated to outlet LegalMatterEventSplitToMatterMetrics
        tell matterCreated to entity MatterContext.LegalMatter
      }
      on conflictCheckRecorded: event LegalMatter.ConflictCheckRecorded is {
        send conflictCheckRecorded to outlet LegalMatterEventSplitToMatterMetrics
        tell conflictCheckRecorded to entity MatterContext.LegalMatter
      }
      on teamAssigned: event LegalMatter.TeamAssigned is {
        send teamAssigned to outlet LegalMatterEventSplitToMatterMetrics
        tell teamAssigned to entity MatterContext.LegalMatter
      }
      on matterActivated: event LegalMatter.MatterActivated is {
        send matterActivated to outlet LegalMatterEventSplitToMatterMetrics
        tell matterActivated to entity MatterContext.LegalMatter
      }
      on timeRecorded: event LegalMatter.TimeRecorded is {
        send timeRecorded to outlet LegalMatterEventSplitToMatterMetrics
        tell timeRecorded to entity MatterContext.LegalMatter
      }
      on expenseRecorded: event LegalMatter.ExpenseRecorded is {
        send expenseRecorded to outlet LegalMatterEventSplitToMatterMetrics
        tell expenseRecorded to entity MatterContext.LegalMatter
      }
      on documentAttached: event LegalMatter.DocumentAttached is {
        send documentAttached to outlet LegalMatterEventSplitToMatterMetrics
        tell documentAttached to entity MatterContext.LegalMatter
      }
      on courtDeadlineAdded: event LegalMatter.CourtDeadlineAdded is {
        send courtDeadlineAdded to outlet LegalMatterEventSplitToMatterMetrics
        tell courtDeadlineAdded to entity MatterContext.LegalMatter
      }
      on deadlineCompleted: event LegalMatter.DeadlineCompleted is {
        send deadlineCompleted to outlet LegalMatterEventSplitToMatterMetrics
        tell deadlineCompleted to entity MatterContext.LegalMatter
      }
      on matterPlacedOnHold: event LegalMatter.MatterPlacedOnHold is {
        send matterPlacedOnHold to outlet LegalMatterEventSplitToMatterMetrics
        tell matterPlacedOnHold to entity MatterContext.LegalMatter
      }
      on matterReactivated: event LegalMatter.MatterReactivated is {
        send matterReactivated to outlet LegalMatterEventSplitToMatterMetrics
        tell matterReactivated to entity MatterContext.LegalMatter
      }
      on matterClosed: event LegalMatter.MatterClosed is {
        send matterClosed to outlet LegalMatterEventSplitToMatterMetrics
        tell matterClosed to entity MatterContext.LegalMatter
      }
      on matterRejected: event LegalMatter.MatterRejected is {
        send matterRejected to outlet LegalMatterEventSplitToMatterMetrics
        tell matterRejected to entity MatterContext.LegalMatter
      }
      on other is {
        error "Unexpected message for processor LegalMatterEventSplit"
      }
    } with {
      briefly "LegalMatter event fan-out handler"
      described as {
        |Delivers each LegalMatter event to all of its consumers.
      }
    }
  } with {
    briefly "LegalMatter event fan-out"
    described as {
      |Fans LegalMatter events out to the repository and projectors.
    }
  }
  connector 'LegalMatterEvent Stream' is from outlet MatterContext.LegalMatter.LegalMatterEvents2 to inlet MatterContext.LegalMatterEventSplit.LegalMatterEventSplitIn with {
    briefly "LegalMatter events, fanned out to storage and read models"
  }
  connector 'MatterMetrics Feed' is from outlet MatterContext.LegalMatterEventSplit.LegalMatterEventSplitToMatterMetrics to inlet MatterContext.MatterMetrics.MatterMetricsFromLegalMatter with {
    briefly "LegalMatter events feeding the MatterMetrics projection"
  }
  connector 'MatterMetrics Storage' is from outlet MatterContext.MatterMetrics.MatterMetricsToRepository to inlet MatterContext.MatterRepository.MatterRepositoryFromMatterMetrics with {
    briefly "MatterMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for matter management"
  described as {
    |Legal matter management context.
  }
}
