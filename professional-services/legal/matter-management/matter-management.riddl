// Matter Management Domain Model
// Legal matter intake, tracking, and lifecycle management
domain MatterManagement is {
  persistent connector 'TimekeepingSystemReply Stream' is from outlet TimekeepingSystem.TimekeepingSystemRepliesOut to inlet MatterContext.ToTimekeepingSystem.ToTimekeepingSystemReplies with {
    briefly "What TimekeepingSystem answers MatterContext"
  }
  persistent connector 'CourtFilingSystemReply Stream' is from outlet CourtFilingSystem.CourtFilingSystemRepliesOut to inlet MatterContext.ToCourtFilingSystem.ToCourtFilingSystemReplies with {
    briefly "What CourtFilingSystem answers MatterContext"
  }
  persistent connector 'CourtFilingSystemEvent Stream' is from outlet CourtFilingSystem.CourtFilingSystemEventsOut to inlet MatterContext.FromCourtFilingSystem.FromCourtFilingSystemIn with {
    briefly "What CourtFilingSystem tells MatterContext, unasked"
  }
  persistent connector 'TimekeepingSystemEvent Stream' is from outlet TimekeepingSystem.TimekeepingSystemEventsOut to inlet MatterContext.FromTimekeepingSystem.FromTimekeepingSystemIn with {
    briefly "What TimekeepingSystem tells MatterContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ManagingPartner is "person overseeing firm matters" with {
    briefly "Managing Partner"
    described as {
      |Senior attorney managing firm operations.
    }
  }
  user LeadAttorney is "person responsible for a legal matter" with {
    briefly "Lead Attorney"
    described as {
      |Attorney leading a specific matter.
    }
  }
  user ParalegalStaff is "person supporting attorneys on matters" with {
    briefly "Paralegal Staff"
    described as {
      |Paralegal assisting with matter work.
    }
  }
  user BillingClerk is "person managing time and expense entries" with {
    briefly "Billing Clerk"
    described as {
      |Clerk handling billing and invoicing.
    }
  }
  epic MatterLifecycle is {
    user LeadAttorney wants to "to manage legal matters from intake to closure" so that "matters are tracked and completed efficiently"
    case IntakeNewMatter is {
      user LeadAttorney wants to "to open a new legal matter" so that "client work is formally tracked"
      step is "Attorney submits" "matter intake request" "with client details" with {
        briefly "Submit intake"
        described as {
          |Submit matter request.
        }
      }
      step is "System checks" "conflicts of interest" "against existing matters" with {
        briefly "Check conflicts"
        described as {
          |Run conflict check.
        }
      }
      step is "System assigns" "matter team" "and opens matter" with {
        briefly "Open matter"
        described as {
          |Assign team and open.
        }
      }
    } with {
      briefly "Intake new matter"
      described as {
        |Opening a new legal matter with conflict checking.
      }
    }
  } with {
    briefly "Matter lifecycle"
    described as {
      |Epic for managing legal matters end to end.
    }
  }
  include "MatterContext.riddl"
  include "external-contexts.riddl"
  application context MatterManagementApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in MatterManagement are delivered.
      }
    }
    group MatterManagementScreen is {
      input GetMatterAnalyticsInput acquires query MatterContext.GetMatterAnalytics with {
        briefly "Get matter analytics control"
        described as {
          |The control through which a user asks the get matter analytics question.
        }
      }
      input GetLegalMatterInput acquires query MatterContext.LegalMatter.GetLegalMatter with {
        briefly "Get legal matter control"
        described as {
          |The control through which a user asks the get legal matter question.
        }
      }
      input CreateMatterInput acquires command MatterContext.CreateMatter with {
        briefly "Create matter control"
        described as {
          |The control through which a user submits the create matter request.
        }
      }
      input ActivateMatterInput acquires command MatterContext.LegalMatter.ActivateMatter with {
        briefly "Activate matter control"
        described as {
          |The control through which a user submits the activate matter request.
        }
      }
      input AssignTeamInput acquires command MatterContext.LegalMatter.AssignTeam with {
        briefly "Assign team control"
        described as {
          |The control through which a user submits the assign team request.
        }
      }
      input AttachDocumentInput acquires command MatterContext.LegalMatter.AttachDocument with {
        briefly "Attach document control"
        described as {
          |The control through which a user submits the attach document request.
        }
      }
      input CloseMatterInput acquires command MatterContext.LegalMatter.CloseMatter with {
        briefly "Close matter control"
        described as {
          |The control through which a user submits the close matter request.
        }
      }
      input CompleteDeadlineInput acquires command MatterContext.LegalMatter.CompleteDeadline with {
        briefly "Complete deadline control"
        described as {
          |The control through which a user submits the complete deadline request.
        }
      }
      input PlaceMatterOnHoldInput acquires command MatterContext.LegalMatter.PlaceMatterOnHold with {
        briefly "Place matter on hold control"
        described as {
          |The control through which a user submits the place matter on hold request.
        }
      }
      input ReactivateMatterInput acquires command MatterContext.LegalMatter.ReactivateMatter with {
        briefly "Reactivate matter control"
        described as {
          |The control through which a user submits the reactivate matter request.
        }
      }
      input RecordConflictCheckInput acquires command MatterContext.LegalMatter.RecordConflictCheck with {
        briefly "Record conflict check control"
        described as {
          |The control through which a user submits the record conflict check request.
        }
      }
      input RecordTimeInput acquires command MatterContext.LegalMatter.RecordTime with {
        briefly "Record time control"
        described as {
          |The control through which a user submits the record time request.
        }
      }
      input RejectMatterInput acquires command MatterContext.LegalMatter.RejectMatter with {
        briefly "Reject matter control"
        described as {
          |The control through which a user submits the reject matter request.
        }
      }
    } with {
      briefly "Matter management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppMatterRepositoryQueries is query MatterContext.GetMatterAnalytics
    inlet AppMatterRepositoryReplies is result MatterContext.MatterAnalyticsView
    outlet AppLegalMatterQueries is query MatterContext.LegalMatter.GetLegalMatter
    outlet AppLegalMatterCommands is type MatterContext.LegalMatterRequest
    inlet AppMatterRepositoryResponses is result MatterContext.LegalMatter.LegalMatterResult
    handler MatterManagementAppHandler is {
      on other is {
        error "Unexpected message for application context MatterManagementApp"
      }
    } with {
      briefly "MatterManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "MatterManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'TimekeepingSystemRequest Stream' is from outlet MatterContext.ToTimekeepingSystem.ToTimekeepingSystemOut to inlet TimekeepingSystem.TimekeepingSystemRequests with {
    briefly "What MatterContext asks TimekeepingSystem to send"
  }
  persistent connector 'CourtFilingSystemRequest Stream' is from outlet MatterContext.ToCourtFilingSystem.ToCourtFilingSystemOut to inlet CourtFilingSystem.CourtFilingSystemRequests with {
    briefly "What MatterContext asks CourtFilingSystem to send"
  }
  persistent connector 'MatterRepositoryQuery Stream' is from outlet MatterManagementApp.AppMatterRepositoryQueries to inlet MatterContext.MatterRepositoryQueriesIn with {
    briefly "MatterManagementApp's look-ups of the matter repository"
  }
  persistent connector 'MatterRepositoryReply Stream' is from outlet MatterContext.MatterRepositoryRepliesOut to inlet MatterManagementApp.AppMatterRepositoryReplies with {
    briefly "The matter repository's answers returned to MatterManagementApp"
  }
  persistent connector 'LegalMatterQuery Stream' is from outlet MatterManagementApp.AppLegalMatterQueries to inlet MatterContext.LegalMatterQueriesIn with {
    briefly "MatterManagementApp's look-ups of the legal matter"
  }
  persistent connector 'LegalMatterCommand Stream' is from outlet MatterManagementApp.AppLegalMatterCommands to inlet MatterContext.LegalMatterCommandStreamIn with {
    briefly "LegalMatter commands from the application"
  }
  persistent connector 'LegalMatterResult Stream' is from outlet MatterContext.LegalMatterResultStreamOut to inlet MatterManagementApp.AppMatterRepositoryResponses with {
    briefly "Matter query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet MatterManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Matter management domain"
  described as {
    |Legal matter intake, tracking, and lifecycle management.
  }
}
