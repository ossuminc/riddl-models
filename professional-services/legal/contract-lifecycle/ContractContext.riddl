// Contract Lifecycle - Contract Context
context ContractContext is {
  include "types.riddl"
  include "Contract.riddl"
  repository ContractRepository is {
    schema ContractData is relational
      of contracts as type Contract
        index on field Contract.contractId
        index on field Contract.contractInfo.contractType
        index on field Contract.status

    handler ContractPersistence is {
      on command Contract.CreateContract is {
        tell event Contract.ContractCreated to entity ContractContext.Contract
        prompt "Store new contract draft"
      }
      on command Contract.SubmitForReview is {
        prompt "Update contract to in review"
      }
      on command Contract.SubmitRedline is {
        tell event Contract.RedlineSubmitted to entity ContractContext.Contract
        prompt "Store redline changes"
      }
      on command Contract.RecordApproval is {
        tell event Contract.ApprovalRecorded to entity ContractContext.Contract
        prompt "Store approval decision"
      }
      on command Contract.RecordSignature is {
        tell event Contract.SignatureRecorded to entity ContractContext.Contract
        prompt "Store signature record"
      }
      on command Contract.ActivateContract is {
        prompt "Update contract to active"
      }
      on command Contract.FulfillObligation is {
        prompt "Update obligation status"
      }
      on command Contract.RenewContract is {
        prompt "Update contract renewal"
      }
      on command Contract.ExpireContract is {
        prompt "Update contract to expired"
      }
      on command Contract.TerminateContract is {
        tell event Contract.ContractTerminated to entity ContractContext.Contract
        prompt "Update contract to terminated"
      }
    } with {
      briefly "Persists contract commands"
      described as {
        |Handles event-driven contract persistence.
      }
    }
  } with {
    briefly "Contract data persistence"
    described as {
      |Persistent storage for contracts.
    }
  }
  projector ContractMetrics is {
    updates repository ContractContext.ContractRepository
    record ContractDashboard is  {
      contractsDrafted: Natural with {
        briefly "Drafted"
        described as {
          |Contracts drafted.
        }
      }
      contractsExecuted: Natural with {
        briefly "Executed"
        described as {
          |Contracts executed.
        }
      }
      contractsExpired: Natural with {
        briefly "Expired"
        described as {
          |Contracts expired.
        }
      }
      contractsTerminated: Natural with {
        briefly "Terminated"
        described as {
          |Contracts terminated.
        }
      }
      obligationsFulfilled: Natural with {
        briefly "Fulfilled"
        described as {
          |Obligations fulfilled.
        }
      }
      averageApprovalDays: Decimal(8,2) with {
        briefly "Avg approval"
        described as {
          |Average days to approval.
        }
      }
    } with {
      briefly "Contract dashboard"
      described as {
        |Contract portfolio metrics.
      }
    }
    handler MetricsHandler is {
      on event Contract.ContractCreated is {
        tell event Contract.ContractCreated to repository ContractContext.ContractRepository
        prompt "Increment contracts drafted"
      }
      on event Contract.ContractActivated is {
        tell event Contract.ContractActivated to repository ContractContext.ContractRepository
        prompt "Increment contracts executed and calculate approval time"
      }
      on event Contract.ContractExpired is {
        tell event Contract.ContractExpired to repository ContractContext.ContractRepository
        prompt "Increment contracts expired"
      }
      on event Contract.ContractTerminated is {
        tell event Contract.ContractTerminated to repository ContractContext.ContractRepository
        prompt "Increment contracts terminated"
      }
      on event Contract.ObligationFulfilled is {
        tell event Contract.ObligationFulfilled to repository ContractContext.ContractRepository
        prompt "Increment obligations fulfilled"
      }
    } with {
      briefly "Maintains contract metrics"
      described as {
        |Projects events into contract metrics.
      }
    }
  } with {
    briefly "Contract metrics"
    described as {
      |Contract lifecycle analytics.
    }
  }
  // ---- Event publication for Contract ----
  type ContractEvent is one of {
    ContractContext.Contract.ContractCreated,
    ContractContext.Contract.ContractSubmittedForReview,
    ContractContext.Contract.ReviewCommentAdded,
    ContractContext.Contract.RedlineSubmitted,
    ContractContext.Contract.RedlineAccepted,
    ContractContext.Contract.RedlineRejected,
    ContractContext.Contract.ApprovalRequested,
    ContractContext.Contract.ApprovalRecorded,
    ContractContext.Contract.ContractSentForSignature,
    ContractContext.Contract.SignatureRecorded,
    ContractContext.Contract.ContractActivated,
    ContractContext.Contract.ObligationAdded,
    ContractContext.Contract.ObligationFulfilled,
    ContractContext.Contract.ContractRenewed,
    ContractContext.Contract.ContractExpired,
    ContractContext.Contract.ContractTerminated
  } with {
    briefly "Contract event alternation"
    described as {
      |Union of all Contract events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ContractEventSource as source is {
    outlet ContractEvents is type ContractEvent
    handler ContractSourceHandler is {
      on event Contract.ContractCreated is {
        send event Contract.ContractCreated to outlet ContractEvents
      }
      on event Contract.ContractSubmittedForReview is {
        send event Contract.ContractSubmittedForReview to outlet ContractEvents
      }
      on event Contract.ReviewCommentAdded is {
        send event Contract.ReviewCommentAdded to outlet ContractEvents
      }
      on event Contract.RedlineSubmitted is {
        send event Contract.RedlineSubmitted to outlet ContractEvents
      }
      on event Contract.RedlineAccepted is {
        send event Contract.RedlineAccepted to outlet ContractEvents
      }
      on event Contract.RedlineRejected is {
        send event Contract.RedlineRejected to outlet ContractEvents
      }
      on event Contract.ApprovalRequested is {
        send event Contract.ApprovalRequested to outlet ContractEvents
      }
      on event Contract.ApprovalRecorded is {
        send event Contract.ApprovalRecorded to outlet ContractEvents
      }
      on event Contract.ContractSentForSignature is {
        send event Contract.ContractSentForSignature to outlet ContractEvents
      }
      on event Contract.SignatureRecorded is {
        send event Contract.SignatureRecorded to outlet ContractEvents
      }
      on event Contract.ContractActivated is {
        send event Contract.ContractActivated to outlet ContractEvents
      }
      on event Contract.ObligationAdded is {
        send event Contract.ObligationAdded to outlet ContractEvents
      }
      on event Contract.ObligationFulfilled is {
        send event Contract.ObligationFulfilled to outlet ContractEvents
      }
      on event Contract.ContractRenewed is {
        send event Contract.ContractRenewed to outlet ContractEvents
      }
      on event Contract.ContractExpired is {
        send event Contract.ContractExpired to outlet ContractEvents
      }
      on event Contract.ContractTerminated is {
        send event Contract.ContractTerminated to outlet ContractEvents
      }
      on other is {
        error "Unexpected message for source ContractEventSource"
      }
    } with {
      briefly "Contract source handler"
      described as {
        |Publishes Contract events onto the outlet.
      }
    }
  } with {
    briefly "Contract event source"
    described as {
      |Publishes Contract entity events into the streaming topology.
    }
  }
  processor ContractEventSink as sink is {
    inlet ContractInlet is type ContractEvent
    handler ContractSinkHandler is {
      on event Contract.ContractCreated is {
        tell event Contract.ContractCreated to repository ContractContext.ContractRepository
      }
      on event Contract.ContractSubmittedForReview is {
        tell event Contract.ContractSubmittedForReview to repository ContractContext.ContractRepository
      }
      on event Contract.ReviewCommentAdded is {
        tell event Contract.ReviewCommentAdded to repository ContractContext.ContractRepository
      }
      on event Contract.RedlineSubmitted is {
        tell event Contract.RedlineSubmitted to repository ContractContext.ContractRepository
      }
      on event Contract.RedlineAccepted is {
        tell event Contract.RedlineAccepted to repository ContractContext.ContractRepository
      }
      on event Contract.RedlineRejected is {
        tell event Contract.RedlineRejected to repository ContractContext.ContractRepository
      }
      on event Contract.ApprovalRequested is {
        tell event Contract.ApprovalRequested to repository ContractContext.ContractRepository
      }
      on event Contract.ApprovalRecorded is {
        tell event Contract.ApprovalRecorded to repository ContractContext.ContractRepository
      }
      on event Contract.ContractSentForSignature is {
        tell event Contract.ContractSentForSignature to repository ContractContext.ContractRepository
      }
      on event Contract.SignatureRecorded is {
        tell event Contract.SignatureRecorded to repository ContractContext.ContractRepository
      }
      on event Contract.ContractActivated is {
        tell event Contract.ContractActivated to repository ContractContext.ContractRepository
      }
      on event Contract.ObligationAdded is {
        tell event Contract.ObligationAdded to repository ContractContext.ContractRepository
      }
      on event Contract.ObligationFulfilled is {
        tell event Contract.ObligationFulfilled to repository ContractContext.ContractRepository
      }
      on event Contract.ContractRenewed is {
        tell event Contract.ContractRenewed to repository ContractContext.ContractRepository
      }
      on event Contract.ContractExpired is {
        tell event Contract.ContractExpired to repository ContractContext.ContractRepository
      }
      on event Contract.ContractTerminated is {
        tell event Contract.ContractTerminated to repository ContractContext.ContractRepository
      }
      on other is {
        error "Unexpected message for sink ContractEventSink"
      }
    } with {
      briefly "Contract sink handler"
      described as {
        |Persists Contract events via the repository.
      }
    }
  } with {
    briefly "Contract event sink"
    described as {
      |Receives Contract events for persistence.
    }
  }
  connector ContractEventFlow is {
    from outlet ContractContext.ContractEventSource.ContractEvents to
      inlet ContractContext.ContractEventSink.ContractInlet
  } with {
    briefly "Contract event flow"
    described as {
      |Connects the Contract source to its sink.
    }
  }
} with {
  briefly "Bounded context for contract lifecycle"
  described as {
    |Contract lifecycle management context.
  }
}
