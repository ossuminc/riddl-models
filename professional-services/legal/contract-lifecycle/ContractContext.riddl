// Contract Lifecycle - Contract Context
context ContractContext is {
  adaptor FromDocumentRepository from context DocumentRepository is { 
    handler FromDocumentRepositoryHandler is {
      on result DocumentRepository.DocumentContent is {
        do "the model receives document content"
      }
      on event DocumentRepository.DocumentStored is {
        do "the model receives document stored"
      }
      on result DocumentRepository.VersionList is {
        do "the model receives version list"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentRepository"
      }
    } with {
      briefly "from document repository"
      described as {
        |Carries messages from the external DocumentRepository.
      }
    }
  } with {
    briefly "DocumentRepository integration"
    described as {
      |The model's side of the DocumentRepository conversation.
    }
  }
  adaptor ToDocumentRepository to context DocumentRepository is { 
    handler ToDocumentRepositoryHandler is {
      on query DocumentRepository.GetDocument is {
        do "the model sends get document"
      }
      on query DocumentRepository.ListVersions is {
        do "the model sends list versions"
      }
      on command DocumentRepository.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentRepository"
      }
    } with {
      briefly "to document repository"
      described as {
        |Carries messages to the external DocumentRepository.
      }
    }
  } with {
    briefly "DocumentRepository integration"
    described as {
      |The model's side of the DocumentRepository conversation.
    }
  }
  adaptor FromESignatureService from context ESignatureService is { 
    handler FromESignatureServiceHandler is {
      on event ESignatureService.EnvelopeCompleted is {
        do "the model receives envelope completed"
      }
      on event ESignatureService.EnvelopeSigned is {
        do "the model receives envelope signed"
      }
      on result ESignatureService.EnvelopeStatus is {
        do "the model receives envelope status"
      }
      on other is {
        error "Unexpected message for adaptor FromESignatureService"
      }
    } with {
      briefly "from e signature service"
      described as {
        |Carries messages from the external ESignatureService.
      }
    }
  } with {
    briefly "ESignatureService integration"
    described as {
      |The model's side of the ESignatureService conversation.
    }
  }
  adaptor ToESignatureService to context ESignatureService is { 
    handler ToESignatureServiceHandler is {
      on query ESignatureService.GetEnvelopeStatus is {
        do "the model sends get envelope status"
      }
      on command ESignatureService.SendEnvelope is {
        do "the model sends send envelope"
      }
      on other is {
        error "Unexpected message for adaptor ToESignatureService"
      }
    } with {
      briefly "to e signature service"
      described as {
        |Carries messages to the external ESignatureService.
      }
    }
  } with {
    briefly "ESignatureService integration"
    described as {
      |The model's side of the ESignatureService conversation.
    }
  }
  include "types.riddl"
  include "Contract.riddl"
  repository ContractRepository is {
    inlet ContractRepositoryFromContract is type ContractEvent    inlet ContractRepositoryFromContractMetrics is type ContractEvent    outlet ContractRepositoryResponses is type Contract.ContractResult
    record StoredContract is  {
      contractId: ContractId with {
        briefly "contractId"
        described as {
          |The contractId column of the stored contract row.
        }
      }
      contractInfo: ContractInfo with {
        briefly "contractInfo"
        described as {
          |The contractInfo column of the stored contract row.
        }
      }
      status: ContractStatus with {
        briefly "status"
        described as {
          |The status column of the stored contract row.
        }
      }
    } with {
      briefly "Stored contract row"
      described as {
        |The persistence shape of contract data as this repository stores it.
      }
    }
    schema ContractData is relational
      of contracts as type StoredContract
        index on field StoredContract.contractId
        index on field StoredContract.contractInfo.contractType
        index on field StoredContract.status
 with {
      briefly "Contract data schema"
      described as {
        |The relational schema holding contract data for the ContractRepository.
      }
    }
    handler ContractPersistence is {
      on query GetContractDashboard is {
        do "read the contract dashboard projection"
        yield result ContractDashboardView
      }
      on command Contract.CreateContract is {
        tell event Contract.ContractCreated to entity ContractContext.Contract
        do "Store new contract draft"
      }
      on command Contract.SubmitForReview is {
        do "Update contract to in review"
      }
      on command Contract.SubmitRedline is {
        tell event Contract.RedlineSubmitted to entity ContractContext.Contract
        do "Store redline changes"
      }
      on command Contract.RecordApproval is {
        tell event Contract.ApprovalRecorded to entity ContractContext.Contract
        do "Store approval decision"
      }
      on command Contract.RecordSignature is {
        tell event Contract.SignatureRecorded to entity ContractContext.Contract
        do "Store signature record"
      }
      on command Contract.ActivateContract is {
        do "Update contract to active"
      }
      on command Contract.FulfillObligation is {
        do "Update obligation status"
      }
      on command Contract.RenewContract is {
        do "Update contract renewal"
      }
      on command Contract.ExpireContract is {
        do "Update contract to expired"
      }
      on command Contract.TerminateContract is {
        tell event Contract.ContractTerminated to entity ContractContext.Contract
        do "Update contract to terminated"
      }
    } with {
      briefly "Persists contract commands"
      described as {
        |Handles event-driven contract persistence.
      }
    }
  } with {
    briefly "Contract data persistence"
    described as {
      |Persistent storage for contracts.
    }
  }
  query GetContractDashboard is  {
    contractDashboardKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which contract dashboard to retrieve.
      }
    }
  } with {
    briefly "Get contract dashboard"
    described as {
      |Retrieves the contract dashboard projection.
    }
  }
  result ContractDashboardView is  {
    contractDashboard: ContractMetrics.ContractDashboard with {
      briefly "Contract dashboard"
      described as {
        |The contract dashboard being returned.
      }
    }
  } with {
    briefly "Contract dashboard view"
    described as {
      |Read model view carrying the contract dashboard projection.
    }
  }
  projector ContractMetrics is {
    updates repository ContractContext.ContractRepository
    inlet ContractMetricsFromContract is type ContractEvent    outlet ContractMetricsOut is type ContractEvent
    record ContractDashboard is  {
      contractsDrafted: Natural with {
        briefly "Drafted"
        described as {
          |Contracts drafted.
        }
      }
      contractsExecuted: Natural with {
        briefly "Executed"
        described as {
          |Contracts executed.
        }
      }
      contractsExpired: Natural with {
        briefly "Expired"
        described as {
          |Contracts expired.
        }
      }
      contractsTerminated: Natural with {
        briefly "Terminated"
        described as {
          |Contracts terminated.
        }
      }
      obligationsFulfilled: Natural with {
        briefly "Fulfilled"
        described as {
          |Obligations fulfilled.
        }
      }
      averageApprovalDays: Decimal(8,2) with {
        briefly "Avg approval"
        described as {
          |Average days to approval.
        }
      }
    } with {
      briefly "Contract dashboard"
      described as {
        |Contract portfolio metrics.
      }
    }
    handler MetricsHandler is {
      on event Contract.ContractCreated is {
        tell event Contract.ContractCreated to repository ContractContext.ContractRepository
        do "Increment contracts drafted"
      }
      on event Contract.ContractActivated is {
        tell event Contract.ContractActivated to repository ContractContext.ContractRepository
        do "Increment contracts executed and calculate approval time"
      }
      on event Contract.ContractExpired is {
        tell event Contract.ContractExpired to repository ContractContext.ContractRepository
        do "Increment contracts expired"
      }
      on event Contract.ContractTerminated is {
        tell event Contract.ContractTerminated to repository ContractContext.ContractRepository
        do "Increment contracts terminated"
      }
      on event Contract.ObligationFulfilled is {
        tell event Contract.ObligationFulfilled to repository ContractContext.ContractRepository
        do "Increment obligations fulfilled"
      }
    } with {
      briefly "Maintains contract metrics"
      described as {
        |Projects events into contract metrics.
      }
    }
  } with {
    briefly "Contract metrics"
    described as {
      |Contract lifecycle analytics.
    }
  }
  // ---- Event publication for Contract ----
  type ContractEvent is one of {
    ContractContext.Contract.ContractCreated or ContractContext.Contract.ContractSubmittedForReview or ContractContext.Contract.ReviewCommentAdded or ContractContext.Contract.RedlineSubmitted or ContractContext.Contract.RedlineAccepted or ContractContext.Contract.RedlineRejected or ContractContext.Contract.ApprovalRequested or ContractContext.Contract.ApprovalRecorded or ContractContext.Contract.ContractSentForSignature or ContractContext.Contract.SignatureRecorded or ContractContext.Contract.ContractActivated or ContractContext.Contract.ObligationAdded or ContractContext.Contract.ObligationFulfilled or ContractContext.Contract.ContractRenewed or ContractContext.Contract.ContractExpired or ContractContext.Contract.ContractTerminated
  } with {
    briefly "Contract event alternation"
    described as {
      |Union of all Contract events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ContractEventSource as source is {
    outlet ContractEvents is type ContractEvent
    handler ContractSourceHandler is {
      on event Contract.ContractCreated is {
        send event Contract.ContractCreated to outlet ContractEvents
      }
      on event Contract.ContractSubmittedForReview is {
        send event Contract.ContractSubmittedForReview to outlet ContractEvents
      }
      on event Contract.ReviewCommentAdded is {
        send event Contract.ReviewCommentAdded to outlet ContractEvents
      }
      on event Contract.RedlineSubmitted is {
        send event Contract.RedlineSubmitted to outlet ContractEvents
      }
      on event Contract.RedlineAccepted is {
        send event Contract.RedlineAccepted to outlet ContractEvents
      }
      on event Contract.RedlineRejected is {
        send event Contract.RedlineRejected to outlet ContractEvents
      }
      on event Contract.ApprovalRequested is {
        send event Contract.ApprovalRequested to outlet ContractEvents
      }
      on event Contract.ApprovalRecorded is {
        send event Contract.ApprovalRecorded to outlet ContractEvents
      }
      on event Contract.ContractSentForSignature is {
        send event Contract.ContractSentForSignature to outlet ContractEvents
      }
      on event Contract.SignatureRecorded is {
        send event Contract.SignatureRecorded to outlet ContractEvents
      }
      on event Contract.ContractActivated is {
        send event Contract.ContractActivated to outlet ContractEvents
      }
      on event Contract.ObligationAdded is {
        send event Contract.ObligationAdded to outlet ContractEvents
      }
      on event Contract.ObligationFulfilled is {
        send event Contract.ObligationFulfilled to outlet ContractEvents
      }
      on event Contract.ContractRenewed is {
        send event Contract.ContractRenewed to outlet ContractEvents
      }
      on event Contract.ContractExpired is {
        send event Contract.ContractExpired to outlet ContractEvents
      }
      on event Contract.ContractTerminated is {
        send event Contract.ContractTerminated to outlet ContractEvents
      }
      on other is {
        error "Unexpected message for source ContractEventSource"
      }
    } with {
      briefly "Contract source handler"
      described as {
        |Publishes Contract events onto the outlet.
      }
    }
  } with {
    briefly "Contract event source"
    described as {
      |Publishes Contract entity events into the streaming topology.
    }
  }
  processor ContractEventSink as sink is {
    inlet ContractInlet is type ContractEvent    handler ContractSinkHandler is {
      on event Contract.ContractCreated is {
        tell event Contract.ContractCreated to repository ContractContext.ContractRepository
      }
      on event Contract.ContractSubmittedForReview is {
        tell event Contract.ContractSubmittedForReview to repository ContractContext.ContractRepository
      }
      on event Contract.ReviewCommentAdded is {
        tell event Contract.ReviewCommentAdded to repository ContractContext.ContractRepository
      }
      on event Contract.RedlineSubmitted is {
        tell event Contract.RedlineSubmitted to repository ContractContext.ContractRepository
      }
      on event Contract.RedlineAccepted is {
        tell event Contract.RedlineAccepted to repository ContractContext.ContractRepository
      }
      on event Contract.RedlineRejected is {
        tell event Contract.RedlineRejected to repository ContractContext.ContractRepository
      }
      on event Contract.ApprovalRequested is {
        tell event Contract.ApprovalRequested to repository ContractContext.ContractRepository
      }
      on event Contract.ApprovalRecorded is {
        tell event Contract.ApprovalRecorded to repository ContractContext.ContractRepository
      }
      on event Contract.ContractSentForSignature is {
        tell event Contract.ContractSentForSignature to repository ContractContext.ContractRepository
      }
      on event Contract.SignatureRecorded is {
        tell event Contract.SignatureRecorded to repository ContractContext.ContractRepository
      }
      on event Contract.ContractActivated is {
        tell event Contract.ContractActivated to repository ContractContext.ContractRepository
      }
      on event Contract.ObligationAdded is {
        tell event Contract.ObligationAdded to repository ContractContext.ContractRepository
      }
      on event Contract.ObligationFulfilled is {
        tell event Contract.ObligationFulfilled to repository ContractContext.ContractRepository
      }
      on event Contract.ContractRenewed is {
        tell event Contract.ContractRenewed to repository ContractContext.ContractRepository
      }
      on event Contract.ContractExpired is {
        tell event Contract.ContractExpired to repository ContractContext.ContractRepository
      }
      on event Contract.ContractTerminated is {
        tell event Contract.ContractTerminated to repository ContractContext.ContractRepository
      }
      on other is {
        error "Unexpected message for sink ContractEventSink"
      }
    } with {
      briefly "Contract sink handler"
      described as {
        |Persists Contract events via the repository.
      }
    }
  } with {
    briefly "Contract event sink"
    described as {
      |Receives Contract events for persistence.
    }
  }
  connector ContractEventFlow is from outlet ContractContext.ContractEventSource.ContractEvents to inlet ContractContext.ContractEventSink.ContractInlet with {
    briefly "Contract event flow"
    described as {
      |Connects the Contract source to its sink.
    }
  }
  processor ContractEventSplit is {
    inlet ContractEventSplitIn is type ContractEvent    outlet ContractEventSplitToContractRepository is type ContractEvent
    outlet ContractEventSplitToContractMetrics is type ContractEvent
    handler ContractEventSplitHandler is {
      on event Contract.ContractCreated is {
        send event Contract.ContractCreated to outlet ContractEventSplitToContractRepository
        send event Contract.ContractCreated to outlet ContractEventSplitToContractMetrics
        tell event Contract.ContractCreated to entity ContractContext.Contract
      }
      on event Contract.ContractSubmittedForReview is {
        send event Contract.ContractSubmittedForReview to outlet ContractEventSplitToContractRepository
        send event Contract.ContractSubmittedForReview to outlet ContractEventSplitToContractMetrics
        tell event Contract.ContractSubmittedForReview to entity ContractContext.Contract
      }
      on event Contract.ReviewCommentAdded is {
        send event Contract.ReviewCommentAdded to outlet ContractEventSplitToContractRepository
        send event Contract.ReviewCommentAdded to outlet ContractEventSplitToContractMetrics
        tell event Contract.ReviewCommentAdded to entity ContractContext.Contract
      }
      on event Contract.RedlineSubmitted is {
        send event Contract.RedlineSubmitted to outlet ContractEventSplitToContractRepository
        send event Contract.RedlineSubmitted to outlet ContractEventSplitToContractMetrics
        tell event Contract.RedlineSubmitted to entity ContractContext.Contract
      }
      on event Contract.RedlineAccepted is {
        send event Contract.RedlineAccepted to outlet ContractEventSplitToContractRepository
        send event Contract.RedlineAccepted to outlet ContractEventSplitToContractMetrics
        tell event Contract.RedlineAccepted to entity ContractContext.Contract
      }
      on event Contract.RedlineRejected is {
        send event Contract.RedlineRejected to outlet ContractEventSplitToContractRepository
        send event Contract.RedlineRejected to outlet ContractEventSplitToContractMetrics
        tell event Contract.RedlineRejected to entity ContractContext.Contract
      }
      on event Contract.ApprovalRequested is {
        send event Contract.ApprovalRequested to outlet ContractEventSplitToContractRepository
        send event Contract.ApprovalRequested to outlet ContractEventSplitToContractMetrics
        tell event Contract.ApprovalRequested to entity ContractContext.Contract
      }
      on event Contract.ApprovalRecorded is {
        send event Contract.ApprovalRecorded to outlet ContractEventSplitToContractRepository
        send event Contract.ApprovalRecorded to outlet ContractEventSplitToContractMetrics
        tell event Contract.ApprovalRecorded to entity ContractContext.Contract
      }
      on event Contract.ContractSentForSignature is {
        send event Contract.ContractSentForSignature to outlet ContractEventSplitToContractRepository
        send event Contract.ContractSentForSignature to outlet ContractEventSplitToContractMetrics
        tell event Contract.ContractSentForSignature to entity ContractContext.Contract
      }
      on event Contract.SignatureRecorded is {
        send event Contract.SignatureRecorded to outlet ContractEventSplitToContractRepository
        send event Contract.SignatureRecorded to outlet ContractEventSplitToContractMetrics
        tell event Contract.SignatureRecorded to entity ContractContext.Contract
      }
      on event Contract.ContractActivated is {
        send event Contract.ContractActivated to outlet ContractEventSplitToContractRepository
        send event Contract.ContractActivated to outlet ContractEventSplitToContractMetrics
        tell event Contract.ContractActivated to entity ContractContext.Contract
      }
      on event Contract.ObligationAdded is {
        send event Contract.ObligationAdded to outlet ContractEventSplitToContractRepository
        send event Contract.ObligationAdded to outlet ContractEventSplitToContractMetrics
        tell event Contract.ObligationAdded to entity ContractContext.Contract
      }
      on event Contract.ObligationFulfilled is {
        send event Contract.ObligationFulfilled to outlet ContractEventSplitToContractRepository
        send event Contract.ObligationFulfilled to outlet ContractEventSplitToContractMetrics
        tell event Contract.ObligationFulfilled to entity ContractContext.Contract
      }
      on event Contract.ContractRenewed is {
        send event Contract.ContractRenewed to outlet ContractEventSplitToContractRepository
        send event Contract.ContractRenewed to outlet ContractEventSplitToContractMetrics
        tell event Contract.ContractRenewed to entity ContractContext.Contract
      }
      on event Contract.ContractExpired is {
        send event Contract.ContractExpired to outlet ContractEventSplitToContractRepository
        send event Contract.ContractExpired to outlet ContractEventSplitToContractMetrics
        tell event Contract.ContractExpired to entity ContractContext.Contract
      }
      on event Contract.ContractTerminated is {
        send event Contract.ContractTerminated to outlet ContractEventSplitToContractRepository
        send event Contract.ContractTerminated to outlet ContractEventSplitToContractMetrics
        tell event Contract.ContractTerminated to entity ContractContext.Contract
      }
      on other is {
        error "Unexpected message for processor ContractEventSplit"
      }
    } with {
      briefly "Contract event fan-out handler"
      described as {
        |Delivers each Contract event to all of its consumers.
      }
    }
  } with {
    briefly "Contract event fan-out"
    described as {
      |Fans Contract events out to the repository and projectors.
    }
  }
  connector LinkContractToContractEventSplit is from outlet ContractContext.Contract.ContractEvents2 to inlet ContractContext.ContractEventSplit.ContractEventSplitIn with {
    briefly "LinkContractToContractEventSplit"
  }
  connector LinkContractEventSplitToContractRepository is from outlet ContractContext.ContractEventSplit.ContractEventSplitToContractRepository to inlet ContractContext.ContractRepository.ContractRepositoryFromContract with {
    briefly "LinkContractEventSplitToContractRepository"
  }
  connector LinkContractEventSplitToContractMetrics is from outlet ContractContext.ContractEventSplit.ContractEventSplitToContractMetrics to inlet ContractContext.ContractMetrics.ContractMetricsFromContract with {
    briefly "LinkContractEventSplitToContractMetrics"
  }
  connector LinkContractMetricsToContractRepository is from outlet ContractContext.ContractMetrics.ContractMetricsOut to inlet ContractContext.ContractRepository.ContractRepositoryFromContractMetrics with {
    briefly "LinkContractMetricsToContractRepository"
  }
} with {
  briefly "Bounded context for contract lifecycle"
  described as {
    |Contract lifecycle management context.
  }
}
