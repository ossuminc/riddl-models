// Contract Lifecycle - Contract Context
context ContractContext is {
  adaptor FromDocumentRepository from context DocumentRepository is { 
    handler FromDocumentRepositoryHandler is {
      on result DocumentRepository.DocumentContent is {
        do "the model receives document content"
      }
      on event DocumentRepository.DocumentStored is {
        do "the model receives document stored"
      }
      on result DocumentRepository.VersionList is {
        do "the model receives version list"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentRepository"
      }
    } with {
      briefly "from document repository"
      described as {
        |Carries messages from the external DocumentRepository.
      }
    }
  } with {
    briefly "DocumentRepository integration"
    described as {
      |The model's side of the DocumentRepository conversation.
    }
  }
  adaptor ToDocumentRepository to context DocumentRepository is { 
    handler ToDocumentRepositoryHandler is {
      on query DocumentRepository.GetDocument is {
        do "the model sends get document"
      }
      on query DocumentRepository.ListVersions is {
        do "the model sends list versions"
      }
      on command DocumentRepository.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentRepository"
      }
    } with {
      briefly "to document repository"
      described as {
        |Carries messages to the external DocumentRepository.
      }
    }
  } with {
    briefly "DocumentRepository integration"
    described as {
      |The model's side of the DocumentRepository conversation.
    }
  }
  adaptor FromESignatureService from context ESignatureService is { 
    handler FromESignatureServiceHandler is {
      on event ESignatureService.EnvelopeCompleted is {
        do "the model receives envelope completed"
      }
      on event ESignatureService.EnvelopeSigned is {
        do "the model receives envelope signed"
      }
      on result ESignatureService.EnvelopeStatus is {
        do "the model receives envelope status"
      }
      on other is {
        error "Unexpected message for adaptor FromESignatureService"
      }
    } with {
      briefly "from e signature service"
      described as {
        |Carries messages from the external ESignatureService.
      }
    }
  } with {
    briefly "ESignatureService integration"
    described as {
      |The model's side of the ESignatureService conversation.
    }
  }
  adaptor ToESignatureService to context ESignatureService is { 
    handler ToESignatureServiceHandler is {
      on query ESignatureService.GetEnvelopeStatus is {
        do "the model sends get envelope status"
      }
      on command ESignatureService.SendEnvelope is {
        do "the model sends send envelope"
      }
      on other is {
        error "Unexpected message for adaptor ToESignatureService"
      }
    } with {
      briefly "to e signature service"
      described as {
        |Carries messages to the external ESignatureService.
      }
    }
  } with {
    briefly "ESignatureService integration"
    described as {
      |The model's side of the ESignatureService conversation.
    }
  }
  include "types.riddl"
  include "Contract.riddl"
  repository ContractRepository as merge is {
    inlet ContractRepositoryFromContract is type ContractEvent    inlet ContractRepositoryFromContractMetrics is type ContractEvent    outlet ContractRepositoryResponses is type Contract.ContractResult
    record StoredContract is  {
      contractId: ContractId with {
        briefly "contractId"
        described as {
          |The contractId column of the stored contract row.
        }
      }
      contractInfo: ContractInfo with {
        briefly "contractInfo"
        described as {
          |The contractInfo column of the stored contract row.
        }
      }
      status: ContractStatus with {
        briefly "status"
        described as {
          |The status column of the stored contract row.
        }
      }
    } with {
      briefly "Stored contract row"
      described as {
        |The persistence shape of contract data as this repository stores it.
      }
    }
    schema ContractData is relational
      of contracts as type StoredContract
        index on field StoredContract.contractId
        index on field StoredContract.contractInfo.contractType
        index on field StoredContract.status
 with {
      briefly "Contract data schema"
      described as {
        |The relational schema holding contract data for the ContractRepository.
      }
    }
    handler ContractPersistence is {
      on query GetContractDashboard is {
        let contractDashboardView: ContractDashboardView = prompt("read the contract dashboard projection")
        reply contractDashboardView
      }
      on createContract: command Contract.CreateContract is {
        tell event Contract.ContractCreated(contractId = createContract.contractId, contractInfo = createContract.contractInfo) to entity ContractContext.Contract
        do "Store new contract draft"
      }
      on command Contract.SubmitForReview is {
        do "Update contract to in review"
      }
      on submitRedline: command Contract.SubmitRedline is {
        tell event Contract.RedlineSubmitted(contractId = submitRedline.contractId) to entity ContractContext.Contract
        do "Store redline changes"
      }
      on recordApproval: command Contract.RecordApproval is {
        tell event Contract.ApprovalRecorded(contractId = recordApproval.contractId, approval = recordApproval.approval) to entity ContractContext.Contract
        do "Store approval decision"
      }
      on recordSignature: command Contract.RecordSignature is {
        tell event Contract.SignatureRecorded(contractId = recordSignature.contractId, signature = recordSignature.signature) to entity ContractContext.Contract
        do "Store signature record"
      }
      on command Contract.ActivateContract is {
        do "Update contract to active"
      }
      on command Contract.FulfillObligation is {
        do "Update obligation status"
      }
      on command Contract.RenewContract is {
        do "Update contract renewal"
      }
      on command Contract.ExpireContract is {
        do "Update contract to expired"
      }
      on terminateContract: command Contract.TerminateContract is {
        tell event Contract.ContractTerminated(contractId = terminateContract.contractId, reason = terminateContract.reason, terminatedAt = terminateContract.terminatedAt) to entity ContractContext.Contract
        do "Update contract to terminated"
      }
    } with {
      briefly "Persists contract commands"
      described as {
        |Handles event-driven contract persistence.
      }
    }
  } with {
    briefly "Contract data persistence"
    described as {
      |Persistent storage for contracts.
    }
  }
  query GetContractDashboard is  {
    contractDashboardKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which contract dashboard to retrieve.
      }
    }
  } with {
    briefly "Get contract dashboard"
    described as {
      |Retrieves the contract dashboard projection.
    }
  }
  result ContractDashboardView is  {
    contractDashboard: ContractMetrics.ContractDashboard with {
      briefly "Contract dashboard"
      described as {
        |The contract dashboard being returned.
      }
    }
  } with {
    briefly "Contract dashboard view"
    described as {
      |Read model view carrying the contract dashboard projection.
    }
  }
  projector ContractMetrics as flow is {
    updates repository ContractContext.ContractRepository
    inlet ContractMetricsFromContract is type ContractEvent    outlet ContractMetricsOut is type ContractEvent
    record ContractDashboard is  {
      contractsDrafted: Natural with {
        briefly "Drafted"
        described as {
          |Contracts drafted.
        }
      }
      contractsExecuted: Natural with {
        briefly "Executed"
        described as {
          |Contracts executed.
        }
      }
      contractsExpired: Natural with {
        briefly "Expired"
        described as {
          |Contracts expired.
        }
      }
      contractsTerminated: Natural with {
        briefly "Terminated"
        described as {
          |Contracts terminated.
        }
      }
      obligationsFulfilled: Natural with {
        briefly "Fulfilled"
        described as {
          |Obligations fulfilled.
        }
      }
      averageApprovalDays: Decimal(8,2) with {
        briefly "Avg approval"
        described as {
          |Average days to approval.
        }
      }
    } with {
      briefly "Contract dashboard"
      described as {
        |Contract portfolio metrics.
      }
    }
    handler MetricsHandler is {
      on contractCreated: event Contract.ContractCreated is {
        tell contractCreated to repository ContractContext.ContractRepository
        do "Increment contracts drafted"
      }
      on contractActivated: event Contract.ContractActivated is {
        tell contractActivated to repository ContractContext.ContractRepository
        do "Increment contracts executed and calculate approval time"
      }
      on contractExpired: event Contract.ContractExpired is {
        tell contractExpired to repository ContractContext.ContractRepository
        do "Increment contracts expired"
      }
      on contractTerminated: event Contract.ContractTerminated is {
        tell contractTerminated to repository ContractContext.ContractRepository
        do "Increment contracts terminated"
      }
      on obligationFulfilled: event Contract.ObligationFulfilled is {
        tell obligationFulfilled to repository ContractContext.ContractRepository
        do "Increment obligations fulfilled"
      }
    } with {
      briefly "Maintains contract metrics"
      described as {
        |Projects events into contract metrics.
      }
    }
  } with {
    briefly "Contract metrics"
    described as {
      |Contract lifecycle analytics.
    }
  }
  // ---- Event publication for Contract ----
  type ContractEvent is one of {
    ContractContext.Contract.ContractCreated or ContractContext.Contract.ContractSubmittedForReview or ContractContext.Contract.ReviewCommentAdded or ContractContext.Contract.RedlineSubmitted or ContractContext.Contract.RedlineAccepted or ContractContext.Contract.RedlineRejected or ContractContext.Contract.ApprovalRequested or ContractContext.Contract.ApprovalRecorded or ContractContext.Contract.ContractSentForSignature or ContractContext.Contract.SignatureRecorded or ContractContext.Contract.ContractActivated or ContractContext.Contract.ObligationAdded or ContractContext.Contract.ObligationFulfilled or ContractContext.Contract.ContractRenewed or ContractContext.Contract.ContractExpired or ContractContext.Contract.ContractTerminated
  } with {
    briefly "Contract event alternation"
    described as {
      |Union of all Contract events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ContractEventSource as source is {
    outlet ContractEvents is type ContractEvent
    handler ContractSourceHandler is {
      on contractCreated: event Contract.ContractCreated is {
        send contractCreated to outlet ContractEvents
      }
      on contractSubmittedForReview: event Contract.ContractSubmittedForReview is {
        send contractSubmittedForReview to outlet ContractEvents
      }
      on reviewCommentAdded: event Contract.ReviewCommentAdded is {
        send reviewCommentAdded to outlet ContractEvents
      }
      on redlineSubmitted: event Contract.RedlineSubmitted is {
        send redlineSubmitted to outlet ContractEvents
      }
      on redlineAccepted: event Contract.RedlineAccepted is {
        send redlineAccepted to outlet ContractEvents
      }
      on redlineRejected: event Contract.RedlineRejected is {
        send redlineRejected to outlet ContractEvents
      }
      on approvalRequested: event Contract.ApprovalRequested is {
        send approvalRequested to outlet ContractEvents
      }
      on approvalRecorded: event Contract.ApprovalRecorded is {
        send approvalRecorded to outlet ContractEvents
      }
      on contractSentForSignature: event Contract.ContractSentForSignature is {
        send contractSentForSignature to outlet ContractEvents
      }
      on signatureRecorded: event Contract.SignatureRecorded is {
        send signatureRecorded to outlet ContractEvents
      }
      on contractActivated: event Contract.ContractActivated is {
        send contractActivated to outlet ContractEvents
      }
      on obligationAdded: event Contract.ObligationAdded is {
        send obligationAdded to outlet ContractEvents
      }
      on obligationFulfilled: event Contract.ObligationFulfilled is {
        send obligationFulfilled to outlet ContractEvents
      }
      on contractRenewed: event Contract.ContractRenewed is {
        send contractRenewed to outlet ContractEvents
      }
      on contractExpired: event Contract.ContractExpired is {
        send contractExpired to outlet ContractEvents
      }
      on contractTerminated: event Contract.ContractTerminated is {
        send contractTerminated to outlet ContractEvents
      }
      on other is {
        error "Unexpected message for source ContractEventSource"
      }
    } with {
      briefly "Contract source handler"
      described as {
        |Publishes Contract events onto the outlet.
      }
    }
  } with {
    briefly "Contract event source"
    described as {
      |Publishes Contract entity events into the streaming topology.
    }
  }
  processor ContractEventSink as sink is {
    inlet ContractInlet is type ContractEvent    handler ContractSinkHandler is {
      on contractCreated: event Contract.ContractCreated is {
        tell contractCreated to repository ContractContext.ContractRepository
      }
      on contractSubmittedForReview: event Contract.ContractSubmittedForReview is {
        tell contractSubmittedForReview to repository ContractContext.ContractRepository
      }
      on reviewCommentAdded: event Contract.ReviewCommentAdded is {
        tell reviewCommentAdded to repository ContractContext.ContractRepository
      }
      on redlineSubmitted: event Contract.RedlineSubmitted is {
        tell redlineSubmitted to repository ContractContext.ContractRepository
      }
      on redlineAccepted: event Contract.RedlineAccepted is {
        tell redlineAccepted to repository ContractContext.ContractRepository
      }
      on redlineRejected: event Contract.RedlineRejected is {
        tell redlineRejected to repository ContractContext.ContractRepository
      }
      on approvalRequested: event Contract.ApprovalRequested is {
        tell approvalRequested to repository ContractContext.ContractRepository
      }
      on approvalRecorded: event Contract.ApprovalRecorded is {
        tell approvalRecorded to repository ContractContext.ContractRepository
      }
      on contractSentForSignature: event Contract.ContractSentForSignature is {
        tell contractSentForSignature to repository ContractContext.ContractRepository
      }
      on signatureRecorded: event Contract.SignatureRecorded is {
        tell signatureRecorded to repository ContractContext.ContractRepository
      }
      on contractActivated: event Contract.ContractActivated is {
        tell contractActivated to repository ContractContext.ContractRepository
      }
      on obligationAdded: event Contract.ObligationAdded is {
        tell obligationAdded to repository ContractContext.ContractRepository
      }
      on obligationFulfilled: event Contract.ObligationFulfilled is {
        tell obligationFulfilled to repository ContractContext.ContractRepository
      }
      on contractRenewed: event Contract.ContractRenewed is {
        tell contractRenewed to repository ContractContext.ContractRepository
      }
      on contractExpired: event Contract.ContractExpired is {
        tell contractExpired to repository ContractContext.ContractRepository
      }
      on contractTerminated: event Contract.ContractTerminated is {
        tell contractTerminated to repository ContractContext.ContractRepository
      }
      on other is {
        error "Unexpected message for sink ContractEventSink"
      }
    } with {
      briefly "Contract sink handler"
      described as {
        |Persists Contract events via the repository.
      }
    }
  } with {
    briefly "Contract event sink"
    described as {
      |Receives Contract events for persistence.
    }
  }
  connector ContractEventFlow is from outlet ContractContext.ContractEventSource.ContractEvents to inlet ContractContext.ContractEventSink.ContractInlet with {
    briefly "Contract event flow"
    described as {
      |Connects the Contract source to its sink.
    }
  }
  processor ContractEventSplit as split is {
    inlet ContractEventSplitIn is type ContractEvent    outlet ContractEventSplitToContractRepository is type ContractEvent
    outlet ContractEventSplitToContractMetrics is type ContractEvent
    handler ContractEventSplitHandler is {
      on contractCreated: event Contract.ContractCreated is {
        send contractCreated to outlet ContractEventSplitToContractRepository
        send contractCreated to outlet ContractEventSplitToContractMetrics
        tell contractCreated to entity ContractContext.Contract
      }
      on contractSubmittedForReview: event Contract.ContractSubmittedForReview is {
        send contractSubmittedForReview to outlet ContractEventSplitToContractRepository
        send contractSubmittedForReview to outlet ContractEventSplitToContractMetrics
        tell contractSubmittedForReview to entity ContractContext.Contract
      }
      on reviewCommentAdded: event Contract.ReviewCommentAdded is {
        send reviewCommentAdded to outlet ContractEventSplitToContractRepository
        send reviewCommentAdded to outlet ContractEventSplitToContractMetrics
        tell reviewCommentAdded to entity ContractContext.Contract
      }
      on redlineSubmitted: event Contract.RedlineSubmitted is {
        send redlineSubmitted to outlet ContractEventSplitToContractRepository
        send redlineSubmitted to outlet ContractEventSplitToContractMetrics
        tell redlineSubmitted to entity ContractContext.Contract
      }
      on redlineAccepted: event Contract.RedlineAccepted is {
        send redlineAccepted to outlet ContractEventSplitToContractRepository
        send redlineAccepted to outlet ContractEventSplitToContractMetrics
        tell redlineAccepted to entity ContractContext.Contract
      }
      on redlineRejected: event Contract.RedlineRejected is {
        send redlineRejected to outlet ContractEventSplitToContractRepository
        send redlineRejected to outlet ContractEventSplitToContractMetrics
        tell redlineRejected to entity ContractContext.Contract
      }
      on approvalRequested: event Contract.ApprovalRequested is {
        send approvalRequested to outlet ContractEventSplitToContractRepository
        send approvalRequested to outlet ContractEventSplitToContractMetrics
        tell approvalRequested to entity ContractContext.Contract
      }
      on approvalRecorded: event Contract.ApprovalRecorded is {
        send approvalRecorded to outlet ContractEventSplitToContractRepository
        send approvalRecorded to outlet ContractEventSplitToContractMetrics
        tell approvalRecorded to entity ContractContext.Contract
      }
      on contractSentForSignature: event Contract.ContractSentForSignature is {
        send contractSentForSignature to outlet ContractEventSplitToContractRepository
        send contractSentForSignature to outlet ContractEventSplitToContractMetrics
        tell contractSentForSignature to entity ContractContext.Contract
      }
      on signatureRecorded: event Contract.SignatureRecorded is {
        send signatureRecorded to outlet ContractEventSplitToContractRepository
        send signatureRecorded to outlet ContractEventSplitToContractMetrics
        tell signatureRecorded to entity ContractContext.Contract
      }
      on contractActivated: event Contract.ContractActivated is {
        send contractActivated to outlet ContractEventSplitToContractRepository
        send contractActivated to outlet ContractEventSplitToContractMetrics
        tell contractActivated to entity ContractContext.Contract
      }
      on obligationAdded: event Contract.ObligationAdded is {
        send obligationAdded to outlet ContractEventSplitToContractRepository
        send obligationAdded to outlet ContractEventSplitToContractMetrics
        tell obligationAdded to entity ContractContext.Contract
      }
      on obligationFulfilled: event Contract.ObligationFulfilled is {
        send obligationFulfilled to outlet ContractEventSplitToContractRepository
        send obligationFulfilled to outlet ContractEventSplitToContractMetrics
        tell obligationFulfilled to entity ContractContext.Contract
      }
      on contractRenewed: event Contract.ContractRenewed is {
        send contractRenewed to outlet ContractEventSplitToContractRepository
        send contractRenewed to outlet ContractEventSplitToContractMetrics
        tell contractRenewed to entity ContractContext.Contract
      }
      on contractExpired: event Contract.ContractExpired is {
        send contractExpired to outlet ContractEventSplitToContractRepository
        send contractExpired to outlet ContractEventSplitToContractMetrics
        tell contractExpired to entity ContractContext.Contract
      }
      on contractTerminated: event Contract.ContractTerminated is {
        send contractTerminated to outlet ContractEventSplitToContractRepository
        send contractTerminated to outlet ContractEventSplitToContractMetrics
        tell contractTerminated to entity ContractContext.Contract
      }
      on other is {
        error "Unexpected message for processor ContractEventSplit"
      }
    } with {
      briefly "Contract event fan-out handler"
      described as {
        |Delivers each Contract event to all of its consumers.
      }
    }
  } with {
    briefly "Contract event fan-out"
    described as {
      |Fans Contract events out to the repository and projectors.
    }
  }
  connector 'ContractEvent Stream' is from outlet ContractContext.Contract.ContractEvents2 to inlet ContractContext.ContractEventSplit.ContractEventSplitIn with {
    briefly "Contract events, fanned out to storage and read models"
  }
  connector 'ContractEvent Storage' is from outlet ContractContext.ContractEventSplit.ContractEventSplitToContractRepository to inlet ContractContext.ContractRepository.ContractRepositoryFromContract with {
    briefly "Contract events on their way to storage"
  }
  connector 'ContractMetrics Feed' is from outlet ContractContext.ContractEventSplit.ContractEventSplitToContractMetrics to inlet ContractContext.ContractMetrics.ContractMetricsFromContract with {
    briefly "Contract events feeding the ContractMetrics projection"
  }
  connector 'ContractMetrics Storage' is from outlet ContractContext.ContractMetrics.ContractMetricsOut to inlet ContractContext.ContractRepository.ContractRepositoryFromContractMetrics with {
    briefly "The ContractMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for contract lifecycle"
  described as {
    |Contract lifecycle management context.
  }
}
