// Contract Lifecycle - Contract Context
context ContractContext as router is {
  inlet ContractCommandStreamIn is type ContractCommand  outlet ContractCommandStreamOut is type ContractCommand
  inlet ContractResultStreamIn is result Contract.ContractResult  outlet ContractResultStreamOut is result Contract.ContractResult
  handler ContractContextBoundary is {
    on createContract: command Contract.CreateContract is {
      send createContract to outlet ContractContext.ContractCommandStreamOut
    }
    on submitForReview: command Contract.SubmitForReview is {
      send submitForReview to outlet ContractContext.ContractCommandStreamOut
    }
    on addReviewComment: command Contract.AddReviewComment is {
      send addReviewComment to outlet ContractContext.ContractCommandStreamOut
    }
    on submitRedline: command Contract.SubmitRedline is {
      send submitRedline to outlet ContractContext.ContractCommandStreamOut
    }
    on acceptRedline: command Contract.AcceptRedline is {
      send acceptRedline to outlet ContractContext.ContractCommandStreamOut
    }
    on rejectRedline: command Contract.RejectRedline is {
      send rejectRedline to outlet ContractContext.ContractCommandStreamOut
    }
    on requestApproval: command Contract.RequestApproval is {
      send requestApproval to outlet ContractContext.ContractCommandStreamOut
    }
    on recordApproval: command Contract.RecordApproval is {
      send recordApproval to outlet ContractContext.ContractCommandStreamOut
    }
    on sendForSignature: command Contract.SendForSignature is {
      send sendForSignature to outlet ContractContext.ContractCommandStreamOut
    }
    on recordSignature: command Contract.RecordSignature is {
      send recordSignature to outlet ContractContext.ContractCommandStreamOut
    }
    on activateContract: command Contract.ActivateContract is {
      send activateContract to outlet ContractContext.ContractCommandStreamOut
    }
    on addObligation: command Contract.AddObligation is {
      send addObligation to outlet ContractContext.ContractCommandStreamOut
    }
    on fulfillObligation: command Contract.FulfillObligation is {
      send fulfillObligation to outlet ContractContext.ContractCommandStreamOut
    }
    on renewContract: command Contract.RenewContract is {
      send renewContract to outlet ContractContext.ContractCommandStreamOut
    }
    on expireContract: command Contract.ExpireContract is {
      send expireContract to outlet ContractContext.ContractCommandStreamOut
    }
    on terminateContract: command Contract.TerminateContract is {
      send terminateContract to outlet ContractContext.ContractCommandStreamOut
    }
    on contractResult: result Contract.ContractResult is {
      send contractResult to outlet ContractContext.ContractResultStreamOut
    }
    on other is {
      error "Unexpected message at the ContractContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ContractCommand Stream Intake' is from outlet ContractContext.ContractCommandStreamOut to inlet ContractContext.Contract.ContractCommands  connector 'ContractResult Stream Egress' is from outlet ContractContext.ContractRepository.ContractRepositoryResponses to inlet ContractContext.ContractResultStreamIn  adaptor FromDocumentRepository from context DocumentRepository is { 
    handler FromDocumentRepositoryHandler is {
      on result DocumentRepository.DocumentContent is {
        do "the model receives document content"
      }
      on event DocumentRepository.DocumentStored is {
        do "the model receives document stored"
      }
      on result DocumentRepository.VersionList is {
        do "the model receives version list"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentRepository"
      }
    } with {
      briefly "from document repository"
      described as {
        |Carries messages from the external DocumentRepository.
      }
    }
  } with {
    briefly "DocumentRepository integration"
    described as {
      |The model's side of the DocumentRepository conversation.
    }
  }
  adaptor ToDocumentRepository to context DocumentRepository is { 
    handler ToDocumentRepositoryHandler is {
      on query DocumentRepository.GetDocument is {
        do "the model sends get document"
      }
      on query DocumentRepository.ListVersions is {
        do "the model sends list versions"
      }
      on command DocumentRepository.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentRepository"
      }
    } with {
      briefly "to document repository"
      described as {
        |Carries messages to the external DocumentRepository.
      }
    }
  } with {
    briefly "DocumentRepository integration"
    described as {
      |The model's side of the DocumentRepository conversation.
    }
  }
  adaptor FromESignatureService from context ESignatureService is { 
    handler FromESignatureServiceHandler is {
      on event ESignatureService.EnvelopeCompleted is {
        do "the model receives envelope completed"
      }
      on event ESignatureService.EnvelopeSigned is {
        do "the model receives envelope signed"
      }
      on result ESignatureService.EnvelopeStatus is {
        do "the model receives envelope status"
      }
      on other is {
        error "Unexpected message for adaptor FromESignatureService"
      }
    } with {
      briefly "from e signature service"
      described as {
        |Carries messages from the external ESignatureService.
      }
    }
  } with {
    briefly "ESignatureService integration"
    described as {
      |The model's side of the ESignatureService conversation.
    }
  }
  adaptor ToESignatureService to context ESignatureService is { 
    handler ToESignatureServiceHandler is {
      on query ESignatureService.GetEnvelopeStatus is {
        do "the model sends get envelope status"
      }
      on command ESignatureService.SendEnvelope is {
        do "the model sends send envelope"
      }
      on other is {
        error "Unexpected message for adaptor ToESignatureService"
      }
    } with {
      briefly "to e signature service"
      described as {
        |Carries messages to the external ESignatureService.
      }
    }
  } with {
    briefly "ESignatureService integration"
    described as {
      |The model's side of the ESignatureService conversation.
    }
  }
  include "types.riddl"
  include "Contract.riddl"
  type ContractRepositoryCommand is one of {
    ContractContext.ContractRepository.PersistApprovalRecorded or ContractContext.ContractRepository.PersistApprovalRequested or ContractContext.ContractRepository.PersistContractActivated or ContractContext.ContractRepository.PersistContractCreated or ContractContext.ContractRepository.PersistContractExpired or ContractContext.ContractRepository.PersistContractRenewed or ContractContext.ContractRepository.PersistContractSentForSignature or ContractContext.ContractRepository.PersistContractSubmittedForReview or ContractContext.ContractRepository.PersistContractTerminated or ContractContext.ContractRepository.PersistObligationAdded or ContractContext.ContractRepository.PersistObligationFulfilled or ContractContext.ContractRepository.PersistRedlineAccepted or ContractContext.ContractRepository.PersistRedlineRejected or ContractContext.ContractRepository.PersistRedlineSubmitted or ContractContext.ContractRepository.PersistReviewCommentAdded or ContractContext.ContractRepository.PersistSignatureRecorded
  } with {
    briefly "Anything that writes ContractRepository"
    described as {
      |The persistence commands ContractRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ContractRepository as flow is {
    inlet ContractRepositoryFromContractMetrics is type ContractRepositoryCommand    command PersistApprovalRecorded is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApprovalRecorded applies to.
        }
      }
    } with {
      briefly "Persist ApprovalRecorded"
      described as {
        |Instructs this repository to apply ApprovalRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistApprovalRequested is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApprovalRequested applies to.
        }
      }
    } with {
      briefly "Persist ApprovalRequested"
      described as {
        |Instructs this repository to apply ApprovalRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContractRenewed is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContractRenewed applies to.
        }
      }
    } with {
      briefly "Persist ContractRenewed"
      described as {
        |Instructs this repository to apply ContractRenewed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContractSentForSignature is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContractSentForSignature applies to.
        }
      }
    } with {
      briefly "Persist ContractSentForSignature"
      described as {
        |Instructs this repository to apply ContractSentForSignature to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContractSubmittedForReview is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContractSubmittedForReview applies to.
        }
      }
    } with {
      briefly "Persist ContractSubmittedForReview"
      described as {
        |Instructs this repository to apply ContractSubmittedForReview to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistObligationAdded is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row ObligationAdded applies to.
        }
      }
    } with {
      briefly "Persist ObligationAdded"
      described as {
        |Instructs this repository to apply ObligationAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRedlineAccepted is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row RedlineAccepted applies to.
        }
      }
    } with {
      briefly "Persist RedlineAccepted"
      described as {
        |Instructs this repository to apply RedlineAccepted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRedlineRejected is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row RedlineRejected applies to.
        }
      }
    } with {
      briefly "Persist RedlineRejected"
      described as {
        |Instructs this repository to apply RedlineRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRedlineSubmitted is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row RedlineSubmitted applies to.
        }
      }
    } with {
      briefly "Persist RedlineSubmitted"
      described as {
        |Instructs this repository to apply RedlineSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReviewCommentAdded is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReviewCommentAdded applies to.
        }
      }
    } with {
      briefly "Persist ReviewCommentAdded"
      described as {
        |Instructs this repository to apply ReviewCommentAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSignatureRecorded is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row SignatureRecorded applies to.
        }
      }
    } with {
      briefly "Persist SignatureRecorded"
      described as {
        |Instructs this repository to apply SignatureRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContractActivated is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContractActivated applies to.
        }
      }
    } with {
      briefly "Persist ContractActivated"
      described as {
        |Instructs this repository to apply ContractActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContractCreated is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContractCreated applies to.
        }
      }
    } with {
      briefly "Persist ContractCreated"
      described as {
        |Instructs this repository to apply ContractCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContractExpired is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContractExpired applies to.
        }
      }
    } with {
      briefly "Persist ContractExpired"
      described as {
        |Instructs this repository to apply ContractExpired to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContractTerminated is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContractTerminated applies to.
        }
      }
    } with {
      briefly "Persist ContractTerminated"
      described as {
        |Instructs this repository to apply ContractTerminated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistObligationFulfilled is {
      contractId: ContractId with {
        briefly "Row addressed"
        described as {
          |Which stored row ObligationFulfilled applies to.
        }
      }
    } with {
      briefly "Persist ObligationFulfilled"
      described as {
        |Instructs this repository to apply ObligationFulfilled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ContractRepositoryResponses is result Contract.ContractResult
    record StoredContract is {
      contractId: ContractId with {
        briefly "contractId"
        described as {
          |The contractId column of the stored contract row.
        }
      }
      contractInfo: ContractInfo with {
        briefly "contractInfo"
        described as {
          |The contractInfo column of the stored contract row.
        }
      }
      status: ContractStatus with {
        briefly "status"
        described as {
          |The status column of the stored contract row.
        }
      }
    } with {
      briefly "Stored contract row"
      described as {
        |The persistence shape of contract data as this repository stores it.
      }
    }
    schema ContractData is relational
      of contracts as record StoredContract
        index on field StoredContract.contractId
        index on field StoredContract.contractInfo.contractType
        index on field StoredContract.status
 with {
      briefly "Contract data schema"
      described as {
        |The relational schema holding contract data for the ContractRepository.
      }
    }
    handler ContractPersistence is {
      on persistApprovalRecorded: command PersistApprovalRecorded is {
        do "apply ApprovalRecorded to the stored row"
      }
      on persistApprovalRequested: command PersistApprovalRequested is {
        do "apply ApprovalRequested to the stored row"
      }
      on persistContractRenewed: command PersistContractRenewed is {
        do "apply ContractRenewed to the stored row"
      }
      on persistContractSentForSignature: command PersistContractSentForSignature is {
        do "apply ContractSentForSignature to the stored row"
      }
      on persistContractSubmittedForReview: command PersistContractSubmittedForReview is {
        do "apply ContractSubmittedForReview to the stored row"
      }
      on persistObligationAdded: command PersistObligationAdded is {
        do "apply ObligationAdded to the stored row"
      }
      on persistRedlineAccepted: command PersistRedlineAccepted is {
        do "apply RedlineAccepted to the stored row"
      }
      on persistRedlineRejected: command PersistRedlineRejected is {
        do "apply RedlineRejected to the stored row"
      }
      on persistRedlineSubmitted: command PersistRedlineSubmitted is {
        do "apply RedlineSubmitted to the stored row"
      }
      on persistReviewCommentAdded: command PersistReviewCommentAdded is {
        do "apply ReviewCommentAdded to the stored row"
      }
      on persistSignatureRecorded: command PersistSignatureRecorded is {
        do "apply SignatureRecorded to the stored row"
      }
      on persistContractActivated: command PersistContractActivated is {
        do "apply ContractActivated to the stored row"
      }
      on persistContractCreated: command PersistContractCreated is {
        do "apply ContractCreated to the stored row"
      }
      on persistContractExpired: command PersistContractExpired is {
        do "apply ContractExpired to the stored row"
      }
      on persistContractTerminated: command PersistContractTerminated is {
        do "apply ContractTerminated to the stored row"
      }
      on persistObligationFulfilled: command PersistObligationFulfilled is {
        do "apply ObligationFulfilled to the stored row"
      }
      on query GetContractDashboard is {
        let contractDashboardView: type ContractDashboardView = prompt("read the contract dashboard projection")
        reply contractDashboardView
      }
    } with {
      briefly "Persists contract commands"
      described as {
        |Handles event-driven contract persistence.
      }
    }
  } with {
    briefly "Contract data persistence"
    described as {
      |Persistent storage for contracts.
    }
  }
  query GetContractDashboard replies result ContractDashboardView is {
    contractDashboardKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which contract dashboard to retrieve.
      }
    }
  } with {
    briefly "Get contract dashboard"
    described as {
      |Retrieves the contract dashboard projection.
    }
  }
  result ContractDashboardView is {
    contractDashboard: ContractMetrics.ContractDashboard with {
      briefly "Contract dashboard"
      described as {
        |The contract dashboard being returned.
      }
    }
  } with {
    briefly "Contract dashboard view"
    described as {
      |Read model view carrying the contract dashboard projection.
    }
  }
  projector ContractMetrics as flow is {
    updates repository ContractContext.ContractRepository
    outlet ContractMetricsToRepository is type ContractRepositoryCommand
    inlet ContractMetricsFromContract is type ContractEvent    record ContractDashboard is {
      contractsDrafted: Natural with {
        briefly "Drafted"
        described as {
          |Contracts drafted.
        }
      }
      contractsExecuted: Natural with {
        briefly "Executed"
        described as {
          |Contracts executed.
        }
      }
      contractsExpired: Natural with {
        briefly "Expired"
        described as {
          |Contracts expired.
        }
      }
      contractsTerminated: Natural with {
        briefly "Terminated"
        described as {
          |Contracts terminated.
        }
      }
      obligationsFulfilled: Natural with {
        briefly "Fulfilled"
        described as {
          |Obligations fulfilled.
        }
      }
      averageApprovalDays: Decimal(8,2) with {
        briefly "Avg approval"
        described as {
          |Average days to approval.
        }
      }
    } with {
      briefly "Contract dashboard"
      described as {
        |Contract portfolio metrics.
      }
    }
    handler MetricsHandler is {
      on approvalRecorded: event Contract.ApprovalRecorded is {
        tell command ContractContext.ContractRepository.PersistApprovalRecorded(contractId = approvalRecorded.contractId) to repository ContractContext.ContractRepository
        do "apply ApprovalRecorded to the ContractMetrics projection"
      }
      on approvalRequested: event Contract.ApprovalRequested is {
        tell command ContractContext.ContractRepository.PersistApprovalRequested(contractId = approvalRequested.contractId) to repository ContractContext.ContractRepository
        do "apply ApprovalRequested to the ContractMetrics projection"
      }
      on contractRenewed: event Contract.ContractRenewed is {
        tell command ContractContext.ContractRepository.PersistContractRenewed(contractId = contractRenewed.contractId) to repository ContractContext.ContractRepository
        do "apply ContractRenewed to the ContractMetrics projection"
      }
      on contractSentForSignature: event Contract.ContractSentForSignature is {
        tell command ContractContext.ContractRepository.PersistContractSentForSignature(contractId = contractSentForSignature.contractId) to repository ContractContext.ContractRepository
        do "apply ContractSentForSignature to the ContractMetrics projection"
      }
      on contractSubmittedForReview: event Contract.ContractSubmittedForReview is {
        tell command ContractContext.ContractRepository.PersistContractSubmittedForReview(contractId = contractSubmittedForReview.contractId) to repository ContractContext.ContractRepository
        do "apply ContractSubmittedForReview to the ContractMetrics projection"
      }
      on obligationAdded: event Contract.ObligationAdded is {
        tell command ContractContext.ContractRepository.PersistObligationAdded(contractId = obligationAdded.contractId) to repository ContractContext.ContractRepository
        do "apply ObligationAdded to the ContractMetrics projection"
      }
      on redlineAccepted: event Contract.RedlineAccepted is {
        tell command ContractContext.ContractRepository.PersistRedlineAccepted(contractId = redlineAccepted.contractId) to repository ContractContext.ContractRepository
        do "apply RedlineAccepted to the ContractMetrics projection"
      }
      on redlineRejected: event Contract.RedlineRejected is {
        tell command ContractContext.ContractRepository.PersistRedlineRejected(contractId = redlineRejected.contractId) to repository ContractContext.ContractRepository
        do "apply RedlineRejected to the ContractMetrics projection"
      }
      on redlineSubmitted: event Contract.RedlineSubmitted is {
        tell command ContractContext.ContractRepository.PersistRedlineSubmitted(contractId = redlineSubmitted.contractId) to repository ContractContext.ContractRepository
        do "apply RedlineSubmitted to the ContractMetrics projection"
      }
      on reviewCommentAdded: event Contract.ReviewCommentAdded is {
        tell command ContractContext.ContractRepository.PersistReviewCommentAdded(contractId = reviewCommentAdded.contractId) to repository ContractContext.ContractRepository
        do "apply ReviewCommentAdded to the ContractMetrics projection"
      }
      on signatureRecorded: event Contract.SignatureRecorded is {
        tell command ContractContext.ContractRepository.PersistSignatureRecorded(contractId = signatureRecorded.contractId) to repository ContractContext.ContractRepository
        do "apply SignatureRecorded to the ContractMetrics projection"
      }
      on contractCreated: event Contract.ContractCreated is {
        tell command ContractContext.ContractRepository.PersistContractCreated(contractId = contractCreated.contractId) to repository ContractContext.ContractRepository
        do "Increment contracts drafted"
      }
      on contractActivated: event Contract.ContractActivated is {
        tell command ContractContext.ContractRepository.PersistContractActivated(contractId = contractActivated.contractId) to repository ContractContext.ContractRepository
        do "Increment contracts executed and calculate approval time"
      }
      on contractExpired: event Contract.ContractExpired is {
        tell command ContractContext.ContractRepository.PersistContractExpired(contractId = contractExpired.contractId) to repository ContractContext.ContractRepository
        do "Increment contracts expired"
      }
      on contractTerminated: event Contract.ContractTerminated is {
        tell command ContractContext.ContractRepository.PersistContractTerminated(contractId = contractTerminated.contractId) to repository ContractContext.ContractRepository
        do "Increment contracts terminated"
      }
      on obligationFulfilled: event Contract.ObligationFulfilled is {
        tell command ContractContext.ContractRepository.PersistObligationFulfilled(contractId = obligationFulfilled.contractId) to repository ContractContext.ContractRepository
        do "Increment obligations fulfilled"
      }
    } with {
      briefly "Maintains contract metrics"
      described as {
        |Projects events into contract metrics.
      }
    }
  } with {
    briefly "Contract metrics"
    described as {
      |Contract lifecycle analytics.
    }
  }
  // ---- Event publication for Contract ----
  type ContractEvent is one of {
    ContractContext.Contract.ContractCreated or ContractContext.Contract.ContractSubmittedForReview or ContractContext.Contract.ReviewCommentAdded or ContractContext.Contract.RedlineSubmitted or ContractContext.Contract.RedlineAccepted or ContractContext.Contract.RedlineRejected or ContractContext.Contract.ApprovalRequested or ContractContext.Contract.ApprovalRecorded or ContractContext.Contract.ContractSentForSignature or ContractContext.Contract.SignatureRecorded or ContractContext.Contract.ContractActivated or ContractContext.Contract.ObligationAdded or ContractContext.Contract.ObligationFulfilled or ContractContext.Contract.ContractRenewed or ContractContext.Contract.ContractExpired or ContractContext.Contract.ContractTerminated
  } with {
    briefly "Contract event alternation"
    described as {
      |Union of all Contract events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet ContractEventSplit as flow is {
    inlet ContractEventSplitIn is type ContractEvent    outlet ContractEventSplitToContractMetrics is type ContractEvent
    handler ContractEventSplitHandler is {
      on contractCreated: event Contract.ContractCreated is {
        send contractCreated to outlet ContractEventSplitToContractMetrics
        tell contractCreated to entity ContractContext.Contract
      }
      on contractSubmittedForReview: event Contract.ContractSubmittedForReview is {
        send contractSubmittedForReview to outlet ContractEventSplitToContractMetrics
        tell contractSubmittedForReview to entity ContractContext.Contract
      }
      on reviewCommentAdded: event Contract.ReviewCommentAdded is {
        send reviewCommentAdded to outlet ContractEventSplitToContractMetrics
        tell reviewCommentAdded to entity ContractContext.Contract
      }
      on redlineSubmitted: event Contract.RedlineSubmitted is {
        send redlineSubmitted to outlet ContractEventSplitToContractMetrics
        tell redlineSubmitted to entity ContractContext.Contract
      }
      on redlineAccepted: event Contract.RedlineAccepted is {
        send redlineAccepted to outlet ContractEventSplitToContractMetrics
        tell redlineAccepted to entity ContractContext.Contract
      }
      on redlineRejected: event Contract.RedlineRejected is {
        send redlineRejected to outlet ContractEventSplitToContractMetrics
        tell redlineRejected to entity ContractContext.Contract
      }
      on approvalRequested: event Contract.ApprovalRequested is {
        send approvalRequested to outlet ContractEventSplitToContractMetrics
        tell approvalRequested to entity ContractContext.Contract
      }
      on approvalRecorded: event Contract.ApprovalRecorded is {
        send approvalRecorded to outlet ContractEventSplitToContractMetrics
        tell approvalRecorded to entity ContractContext.Contract
      }
      on contractSentForSignature: event Contract.ContractSentForSignature is {
        send contractSentForSignature to outlet ContractEventSplitToContractMetrics
        tell contractSentForSignature to entity ContractContext.Contract
      }
      on signatureRecorded: event Contract.SignatureRecorded is {
        send signatureRecorded to outlet ContractEventSplitToContractMetrics
        tell signatureRecorded to entity ContractContext.Contract
      }
      on contractActivated: event Contract.ContractActivated is {
        send contractActivated to outlet ContractEventSplitToContractMetrics
        tell contractActivated to entity ContractContext.Contract
      }
      on obligationAdded: event Contract.ObligationAdded is {
        send obligationAdded to outlet ContractEventSplitToContractMetrics
        tell obligationAdded to entity ContractContext.Contract
      }
      on obligationFulfilled: event Contract.ObligationFulfilled is {
        send obligationFulfilled to outlet ContractEventSplitToContractMetrics
        tell obligationFulfilled to entity ContractContext.Contract
      }
      on contractRenewed: event Contract.ContractRenewed is {
        send contractRenewed to outlet ContractEventSplitToContractMetrics
        tell contractRenewed to entity ContractContext.Contract
      }
      on contractExpired: event Contract.ContractExpired is {
        send contractExpired to outlet ContractEventSplitToContractMetrics
        tell contractExpired to entity ContractContext.Contract
      }
      on contractTerminated: event Contract.ContractTerminated is {
        send contractTerminated to outlet ContractEventSplitToContractMetrics
        tell contractTerminated to entity ContractContext.Contract
      }
      on other is {
        error "Unexpected message for processor ContractEventSplit"
      }
    } with {
      briefly "Contract event fan-out handler"
      described as {
        |Delivers each Contract event to all of its consumers.
      }
    }
  } with {
    briefly "Contract event fan-out"
    described as {
      |Fans Contract events out to the repository and projectors.
    }
  }
  connector 'ContractEvent Stream' is from outlet ContractContext.Contract.ContractEvents2 to inlet ContractContext.ContractEventSplit.ContractEventSplitIn with {
    briefly "Contract events, fanned out to storage and read models"
  }
  connector 'ContractMetrics Feed' is from outlet ContractContext.ContractEventSplit.ContractEventSplitToContractMetrics to inlet ContractContext.ContractMetrics.ContractMetricsFromContract with {
    briefly "Contract events feeding the ContractMetrics projection"
  }
  connector 'ContractMetrics Storage' is from outlet ContractContext.ContractMetrics.ContractMetricsToRepository to inlet ContractContext.ContractRepository.ContractRepositoryFromContractMetrics with {
    briefly "ContractMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for contract lifecycle"
  described as {
    |Contract lifecycle management context.
  }
}
