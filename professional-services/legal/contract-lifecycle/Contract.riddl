// Contract Lifecycle - Contract Entity
entity Contract as flow is {
  type ContractCommand is one of {
    Contract.CreateContract or Contract.SubmitForReview or Contract.AddReviewComment or Contract.SubmitRedline or Contract.AcceptRedline or Contract.RejectRedline or Contract.RequestApproval or Contract.RecordApproval or Contract.SendForSignature or Contract.RecordSignature or Contract.ActivateContract or Contract.AddObligation or Contract.FulfillObligation or Contract.RenewContract or Contract.ExpireContract or Contract.TerminateContract
  } with {
    briefly "Contract command alternation"
    described as {
      |Commands accepted by the Contract entity.
    }
  }
  inlet ContractCommands is type ContractCommand  outlet ContractEvents2 is type ContractEvent
  query GetContract replies result ContractResult is  {
    contractId: ContractId with {
      briefly "ID"
      described as {
        |Identifier of the Contract to retrieve.
      }
    }
  } with {
    briefly "Get Contract"
    described as {
      |Retrieve Contract data by identifier.
    }
  }
  result ContractResult is  {
    contractId: ContractId with {
      briefly "Contract addressed"
      described as {
        |Which contract this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    contractData: Contract.DraftStateData with {
      briefly "Contract data"
      described as {
        |The requested Contract data.
      }
    }
  } with {
    briefly "Contract result"
    described as {
      |Result carrying the requested Contract data.
    }
  }
  // Commands
  command CreateContract is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |New contract identifier.
      }
    }
    contractInfo: ContractInfo with {
      briefly "Contract info"
      described as {
        |Contract details.
      }
    }
    templateId: TemplateId? with {
      briefly "Template"
      described as {
        |Template used for drafting.
      }
    }
  } with {
    briefly "Create contract"
    described as {
      |Creates a new contract draft.
    }
  }
  command SubmitForReview is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    reviewers: String(3,200)+ with {
      briefly "Reviewers"
      described as {
        |Assigned reviewers.
      }
    }
  } with {
    briefly "Submit for review"
    described as {
      |Submits contract for legal review.
    }
  }
  command AddReviewComment is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    comment: ReviewComment with {
      briefly "Comment"
      described as {
        |Review comment.
      }
    }
  } with {
    briefly "Add review comment"
    described as {
      |Adds a review comment to the contract.
    }
  }
  command SubmitRedline is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    changes: RedlineChange+ with {
      briefly "Changes"
      described as {
        |Redline changes.
      }
    }
  } with {
    briefly "Submit redline"
    described as {
      |Submits redline changes for the contract.
    }
  }
  command AcceptRedline is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    changeId: UUID with {
      briefly "Change ID"
      described as {
        |Redline change to accept.
      }
    }
  } with {
    briefly "Accept redline"
    described as {
      |Accepts a specific redline change.
    }
  }
  command RejectRedline is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    changeId: UUID with {
      briefly "Change ID"
      described as {
        |Redline change to reject.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Rejection reason.
      }
    }
  } with {
    briefly "Reject redline"
    described as {
      |Rejects a specific redline change.
    }
  }
  command RequestApproval is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    approvers: String(3,200)+ with {
      briefly "Approvers"
      described as {
        |Required approvers.
      }
    }
  } with {
    briefly "Request approval"
    described as {
      |Submits contract for approval.
    }
  }
  command RecordApproval is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    approval: ApprovalRecord with {
      briefly "Approval"
      described as {
        |Approval decision.
      }
    }
  } with {
    briefly "Record approval"
    described as {
      |Records an approval decision.
    }
  }
  command SendForSignature is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    signatories: ContractParty+ with {
      briefly "Signatories"
      described as {
        |Parties to sign.
      }
    }
  } with {
    briefly "Send for signature"
    described as {
      |Sends contract for e-signature.
    }
  }
  command RecordSignature is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    signature: SignatureRecord with {
      briefly "Signature"
      described as {
        |Signature record.
      }
    }
  } with {
    briefly "Record signature"
    described as {
      |Records a party signature.
    }
  }
  command ActivateContract is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    activatedAt: TimeStamp with {
      briefly "Activated"
      described as {
        |Activation time.
      }
    }
  } with {
    briefly "Activate contract"
    described as {
      |Activates an executed contract.
    }
  }
  command AddObligation is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    obligation: Obligation with {
      briefly "Obligation"
      described as {
        |Obligation to track.
      }
    }
  } with {
    briefly "Add obligation"
    described as {
      |Adds an obligation to track.
    }
  }
  command FulfillObligation is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    obligationId: ObligationId with {
      briefly "Obligation ID"
      described as {
        |Obligation to fulfill.
      }
    }
    fulfilledAt: TimeStamp with {
      briefly "Fulfilled"
      described as {
        |Fulfillment time.
      }
    }
  } with {
    briefly "Fulfill obligation"
    described as {
      |Marks an obligation as fulfilled.
    }
  }
  command RenewContract is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    newExpirationDate: Date with {
      briefly "New expiration"
      described as {
        |New expiration date after renewal.
      }
    }
    renewedAt: TimeStamp with {
      briefly "Renewed"
      described as {
        |Renewal time.
      }
    }
  } with {
    briefly "Renew contract"
    described as {
      |Renews the contract for another term.
    }
  }
  command ExpireContract is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    expiredAt: TimeStamp with {
      briefly "Expired"
      described as {
        |Expiration time.
      }
    }
  } with {
    briefly "Expire contract"
    described as {
      |Marks contract as expired.
    }
  }
  command TerminateContract is  {
    contractId: ContractId with {
      briefly "Contract ID"
      described as {
        |Contract identifier.
      }
    }
    reason: String(3,1000) with {
      briefly "Reason"
      described as {
        |Termination reason.
      }
    }
    terminatedAt: TimeStamp with {
      briefly "Terminated"
      described as {
        |Termination time.
      }
    }
  } with {
    briefly "Terminate contract"
    described as {
      |Terminates the contract early.
    }
  }
  // Events
  event ContractCreated is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    contractInfo: ContractInfo with {
      briefly "Info"
      described as {
        |Contract info.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Contract created"
    described as {
      |Emitted when a contract draft is created.
    }
  }
  event ContractSubmittedForReview is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    reviewers: String(3,200)+ with {
      briefly "Reviewers"
      described as {
        |Assigned reviewers.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Contract submitted for review"
    described as {
      |Emitted when contract is sent for review.
    }
  }
  event ReviewCommentAdded is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    comment: ReviewComment with {
      briefly "Comment"
      described as {
        |Review comment.
      }
    }
  } with {
    briefly "Review comment added"
    described as {
      |Emitted when a review comment is added.
    }
  }
  event RedlineSubmitted is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    changeCount: Natural with {
      briefly "Changes"
      described as {
        |Number of changes.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Redline submitted"
    described as {
      |Emitted when redline changes are submitted.
    }
  }
  event RedlineAccepted is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    changeId: UUID with {
      briefly "Change"
      described as {
        |Accepted change ID.
      }
    }
    acceptedAt: TimeStamp with {
      briefly "Accepted"
      described as {
        |Acceptance time.
      }
    }
  } with {
    briefly "Redline accepted"
    described as {
      |Emitted when a redline change is accepted.
    }
  }
  event RedlineRejected is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    changeId: UUID with {
      briefly "Change"
      described as {
        |Rejected change ID.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Rejection reason.
      }
    }
    rejectedAt: TimeStamp with {
      briefly "Rejected"
      described as {
        |Rejection time.
      }
    }
  } with {
    briefly "Redline rejected"
    described as {
      |Emitted when a redline change is rejected.
    }
  }
  event ApprovalRequested is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    approvers: String(3,200)+ with {
      briefly "Approvers"
      described as {
        |Required approvers.
      }
    }
    requestedAt: TimeStamp with {
      briefly "Requested"
      described as {
        |Request time.
      }
    }
  } with {
    briefly "Approval requested"
    described as {
      |Emitted when approval is requested.
    }
  }
  event ApprovalRecorded is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    approval: ApprovalRecord with {
      briefly "Approval"
      described as {
        |Approval decision.
      }
    }
  } with {
    briefly "Approval recorded"
    described as {
      |Emitted when an approval decision is recorded.
    }
  }
  event ContractSentForSignature is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    signatoryCount: Natural with {
      briefly "Signatories"
      described as {
        |Number of signatories.
      }
    }
    sentAt: TimeStamp with {
      briefly "Sent"
      described as {
        |Time sent.
      }
    }
  } with {
    briefly "Contract sent for signature"
    described as {
      |Emitted when contract is sent for signing.
    }
  }
  event SignatureRecorded is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    signature: SignatureRecord with {
      briefly "Signature"
      described as {
        |Signature record.
      }
    }
  } with {
    briefly "Signature recorded"
    described as {
      |Emitted when a signature is recorded.
    }
  }
  event ContractActivated is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    activatedAt: TimeStamp with {
      briefly "Activated"
      described as {
        |Activation time.
      }
    }
  } with {
    briefly "Contract activated"
    described as {
      |Emitted when contract becomes active.
    }
  }
  event ObligationAdded is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    obligation: Obligation with {
      briefly "Obligation"
      described as {
        |Added obligation.
      }
    }
  } with {
    briefly "Obligation added"
    described as {
      |Emitted when an obligation is added.
    }
  }
  event ObligationFulfilled is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    obligationId: ObligationId with {
      briefly "Obligation"
      described as {
        |Obligation ID.
      }
    }
    fulfilledAt: TimeStamp with {
      briefly "Fulfilled"
      described as {
        |Fulfillment time.
      }
    }
  } with {
    briefly "Obligation fulfilled"
    described as {
      |Emitted when an obligation is fulfilled.
    }
  }
  event ContractRenewed is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    newExpirationDate: Date with {
      briefly "Expiration"
      described as {
        |New expiration date.
      }
    }
    renewedAt: TimeStamp with {
      briefly "Renewed"
      described as {
        |Renewal time.
      }
    }
  } with {
    briefly "Contract renewed"
    described as {
      |Emitted when contract is renewed.
    }
  }
  event ContractExpired is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    expiredAt: TimeStamp with {
      briefly "Expired"
      described as {
        |Expiration time.
      }
    }
  } with {
    briefly "Contract expired"
    described as {
      |Emitted when contract expires.
    }
  }
  event ContractTerminated is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    reason: String(3,1000) with {
      briefly "Reason"
      described as {
        |Termination reason.
      }
    }
    terminatedAt: TimeStamp with {
      briefly "Terminated"
      described as {
        |Termination time.
      }
    }
  } with {
    briefly "Contract terminated"
    described as {
      |Emitted when contract is terminated early.
    }
  }
  // States
  record DraftStateData is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    contractInfo: ContractInfo with {
      briefly "Info"
      described as {
        |Contract info.
      }
    }
    status: ContractStatus with {
      briefly "Status"
      described as {
        |Contract status.
      }
    }
    templateId: TemplateId? with {
      briefly "Template"
      described as {
        |Template used.
      }
    }
    reviewComments: ReviewComment* with {
      briefly "Comments"
      described as {
        |Review comments.
      }
    }
    redlineChanges: RedlineChange* with {
      briefly "Redlines"
      described as {
        |Redline changes.
      }
    }
    approvals: ApprovalRecord* with {
      briefly "Approvals"
      described as {
        |Approval records.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Draft contract state"
    described as {
      |State for contract in draft through approval.
    }
  }
  record ExecutedStateData is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    contractInfo: ContractInfo with {
      briefly "Info"
      described as {
        |Contract info.
      }
    }
    status: ContractStatus with {
      briefly "Status"
      described as {
        |Contract status.
      }
    }
    signatures: SignatureRecord+ with {
      briefly "Signatures"
      described as {
        |Signature records.
      }
    }
    obligations: Obligation* with {
      briefly "Obligations"
      described as {
        |Contract obligations.
      }
    }
    renewalTerms: RenewalTerms? with {
      briefly "Renewal"
      described as {
        |Renewal terms.
      }
    }
    activatedAt: TimeStamp with {
      briefly "Activated"
      described as {
        |Activation time.
      }
    }
  } with {
    briefly "Executed contract state"
    described as {
      |State for executed and active contracts.
    }
  }
  record ClosedStateData is  {
    contractId: ContractId with {
      briefly "Contract"
      described as {
        |Contract ID.
      }
    }
    status: ContractStatus with {
      briefly "Status"
      described as {
        |Final status.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed"
      described as {
        |Close time.
      }
    }
    closeReason: String(3,1000)? with {
      briefly "Reason"
      described as {
        |Close reason.
      }
    }
  } with {
    briefly "Closed contract state"
    described as {
      |State for expired or terminated contracts.
    }
  }
  initial state DraftState of record Contract.DraftStateData is {
    initial handler DraftStateInitHandler is {
      on query GetContract is {
        let contractResult: type ContractResult = prompt("read the contract from the store")
        reply contractResult
      }
      on init is {
        set state DraftState to "initialize Contract.DraftStateData fields from the creating message"
      }
    } with {
      briefly "DraftState initialization"
      described as {
        |Initializes DraftState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Draft state"
    described as {
      |The draft state of the Contract entity, carrying DraftStateData.
    }
  }
  state ExecutedState of record Contract.ExecutedStateData is {
    initial handler ExecutedStateInitHandler is {
      on init is {
        set state ExecutedState to "initialize Contract.ExecutedStateData fields from the creating message"
      }
    } with {
      briefly "ExecutedState initialization"
      described as {
        |Initializes ExecutedState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Executed state"
    described as {
      |The executed state of the Contract entity, carrying ExecutedStateData.
    }
  }
  state ClosedState of record Contract.ClosedStateData with {
    briefly "Closed state"
    described as {
      |The closed state of the Contract entity, carrying ClosedStateData.
    }
  }
  handler ContractHandler is {
    on init is {
      set state ClosedState to "initialize Contract.ClosedStateData fields from the creating message"
    }
    on createContract: command CreateContract is {
      morph entity ContractContext.Contract to state ContractContext.Contract.DraftState with record Contract.DraftStateData(contractId = createContract.contractId, contractInfo = createContract.contractInfo, templateId = createContract.templateId, status = prompt("the status of this draft state data"), reviewComments = empty, redlineChanges = empty, approvals = empty, createdAt = prompt("the created at of this draft state data"))
      tell event ContractCreated(contractId = createContract.contractId, contractInfo = createContract.contractInfo, createdAt = prompt("the created at of this contract created")) to entity ContractContext.Contract
    }
    on submitForReview: command SubmitForReview is {
      tell event ContractSubmittedForReview(contractId = submitForReview.contractId, reviewers = submitForReview.reviewers, submittedAt = prompt("the submitted at of this contract submitted for review")) to entity ContractContext.Contract
    }
    on addReviewComment: command AddReviewComment is {
      tell event ReviewCommentAdded(contractId = addReviewComment.contractId, comment = addReviewComment.comment) to entity ContractContext.Contract
    }
    on submitRedline: command SubmitRedline is {
      tell event RedlineSubmitted(contractId = submitRedline.contractId, changeCount = prompt("the change count of this redline submitted"), submittedAt = prompt("the submitted at of this redline submitted")) to entity ContractContext.Contract
    }
    on acceptRedline: command AcceptRedline is {
      tell event RedlineAccepted(contractId = acceptRedline.contractId, changeId = acceptRedline.changeId, acceptedAt = prompt("the accepted at of this redline accepted")) to entity ContractContext.Contract
    }
    on rejectRedline: command RejectRedline is {
      tell event RedlineRejected(contractId = rejectRedline.contractId, changeId = rejectRedline.changeId, reason = rejectRedline.reason, rejectedAt = prompt("the rejected at of this redline rejected")) to entity ContractContext.Contract
    }
    on requestApproval: command RequestApproval is {
      tell event ApprovalRequested(contractId = requestApproval.contractId, approvers = requestApproval.approvers, requestedAt = prompt("the requested at of this approval requested")) to entity ContractContext.Contract
    }
    on recordApproval: command RecordApproval is {
      tell event ApprovalRecorded(contractId = recordApproval.contractId, approval = recordApproval.approval) to entity ContractContext.Contract
    }
    on sendForSignature: command SendForSignature is {
      tell event ContractSentForSignature(contractId = sendForSignature.contractId, signatoryCount = prompt("the signatory count of this contract sent for signature"), sentAt = prompt("the sent at of this contract sent for signature")) to entity ContractContext.Contract
    }
    on recordSignature: command RecordSignature is {
      tell event SignatureRecorded(contractId = recordSignature.contractId, signature = recordSignature.signature) to entity ContractContext.Contract
    }
    on activateContract: command ActivateContract is {
      morph entity ContractContext.Contract to state ContractContext.Contract.ExecutedState with record Contract.ExecutedStateData(contractId = activateContract.contractId, activatedAt = activateContract.activatedAt, contractInfo = prompt("the contract info of this executed state data"), status = prompt("the status of this executed state data"), signatures = prompt("the signatures of this executed state data"), obligations = empty, renewalTerms = empty)
      tell event ContractActivated(contractId = activateContract.contractId, activatedAt = activateContract.activatedAt) to entity ContractContext.Contract
    }
    on addObligation: command AddObligation is {
      tell event ObligationAdded(contractId = addObligation.contractId, obligation = addObligation.obligation) to entity ContractContext.Contract
    }
    on fulfillObligation: command FulfillObligation is {
      tell event ObligationFulfilled(contractId = fulfillObligation.contractId, obligationId = fulfillObligation.obligationId, fulfilledAt = fulfillObligation.fulfilledAt) to entity ContractContext.Contract
    }
    on renewContract: command RenewContract is {
      tell event ContractRenewed(contractId = renewContract.contractId, newExpirationDate = renewContract.newExpirationDate, renewedAt = renewContract.renewedAt) to entity ContractContext.Contract
    }
    on expireContract: command ExpireContract is {
      morph entity ContractContext.Contract to state ContractContext.Contract.ClosedState with record Contract.ClosedStateData(contractId = expireContract.contractId, status = prompt("the status of this closed state data"), closedAt = prompt("the closed at of this closed state data"), closeReason = empty)
      tell event ContractExpired(contractId = expireContract.contractId, expiredAt = expireContract.expiredAt) to entity ContractContext.Contract
    }
    on terminateContract: command TerminateContract is {
      morph entity ContractContext.Contract to state ContractContext.Contract.ClosedState with record Contract.ClosedStateData(contractId = terminateContract.contractId, status = prompt("the status of this closed state data"), closedAt = prompt("the closed at of this closed state data"), closeReason = empty)
      tell event ContractTerminated(contractId = terminateContract.contractId, reason = terminateContract.reason, terminatedAt = terminateContract.terminatedAt) to entity ContractContext.Contract
    }
    on approvalRecorded: event ApprovalRecorded is {
