// Contract Lifecycle Management Domain Model
// Contract drafting, review, approval, execution, and renewal
domain ContractLifecycle is {
  persistent connector 'ESignatureServiceReply Stream' is from outlet ESignatureService.ESignatureServiceRepliesOut to inlet ContractContext.ToESignatureService.ToESignatureServiceReplies with {
    briefly "What ESignatureService answers ContractContext"
  }
  persistent connector 'DocumentRepositoryReply Stream' is from outlet DocumentRepository.DocumentRepositoryRepliesOut to inlet ContractContext.ToDocumentRepository.ToDocumentRepositoryReplies with {
    briefly "What DocumentRepository answers ContractContext"
  }
  persistent connector 'DocumentRepositoryEvent Stream' is from outlet DocumentRepository.DocumentRepositoryEventsOut to inlet ContractContext.FromDocumentRepository.FromDocumentRepositoryIn with {
    briefly "What DocumentRepository tells ContractContext, unasked"
  }
  persistent connector 'ESignatureServiceEvent Stream' is from outlet ESignatureService.ESignatureServiceEventsOut to inlet ContractContext.FromESignatureService.FromESignatureServiceIn with {
    briefly "What ESignatureService tells ContractContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ContractManager is "person managing contract lifecycle" with {
    briefly "Contract Manager"
    described as {
      |Manager overseeing contract processes.
    }
  }
  user LegalCounsel is "person reviewing and redlining contracts" with {
    briefly "Legal Counsel"
    described as {
      |Attorney reviewing contract terms.
    }
  }
  user Approver is "person approving contracts for execution" with {
    briefly "Approver"
    described as {
      |Authorized person approving contracts.
    }
  }
  user Signatory is "person executing and signing contracts" with {
    briefly "Signatory"
    described as {
      |Authorized person signing contracts.
    }
  }
  epic ContractProcessing is {
    user ContractManager wants to "to manage contracts through their lifecycle" so that "contracts are properly drafted, approved, and executed"
    case DraftAndExecuteContract is {
      user ContractManager wants to "to create and execute a new contract" so that "business agreements are formalized"
      step is "Manager drafts" "contract document" "from template" with {
        briefly "Draft contract"
        described as {
          |Create contract draft.
        }
      }
      step is "Counsel reviews" "contract terms" "and redlines" with {
        briefly "Review contract"
        described as {
          |Legal review and redline.
        }
      }
      step is "Approver approves" "final contract" "for execution" with {
        briefly "Approve contract"
        described as {
          |Approval workflow.
        }
      }
      step is "Signatory signs" "approved contract" "via e-signature" with {
        briefly "Execute contract"
        described as {
          |Contract signing.
        }
      }
    } with {
      briefly "Draft and execute contract"
      described as {
        |Full contract lifecycle from draft to execution.
      }
    }
  } with {
    briefly "Contract processing"
    described as {
      |Epic for contract lifecycle management.
    }
  }
  include "ContractContext.riddl"
  include "external-contexts.riddl"
  application context ContractLifecycleApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ContractLifecycle are delivered.
      }
    }
    group ContractLifecycleScreen is {
      input AcceptRedlineInput acquires command ContractContext.Contract.AcceptRedline with {
        briefly "Accept redline control"
        described as {
          |The control through which a user submits the accept redline request.
        }
      }
      input AddObligationInput acquires command ContractContext.Contract.AddObligation with {
        briefly "Add obligation control"
        described as {
          |The control through which a user submits the add obligation request.
        }
      }
      input ExpireContractInput acquires command ContractContext.Contract.ExpireContract with {
        briefly "Expire contract control"
        described as {
          |The control through which a user submits the expire contract request.
        }
      }
      input FulfillObligationInput acquires command ContractContext.Contract.FulfillObligation with {
        briefly "Fulfill obligation control"
        described as {
          |The control through which a user submits the fulfill obligation request.
        }
      }
      input RecordApprovalInput acquires command ContractContext.Contract.RecordApproval with {
        briefly "Record approval control"
        described as {
          |The control through which a user submits the record approval request.
        }
      }
      input RejectRedlineInput acquires command ContractContext.Contract.RejectRedline with {
        briefly "Reject redline control"
        described as {
          |The control through which a user submits the reject redline request.
        }
      }
      input RenewContractInput acquires command ContractContext.Contract.RenewContract with {
        briefly "Renew contract control"
        described as {
          |The control through which a user submits the renew contract request.
        }
      }
      input RequestApprovalInput acquires command ContractContext.Contract.RequestApproval with {
        briefly "Request approval control"
        described as {
          |The control through which a user submits the request approval request.
        }
      }
      input SendForSignatureInput acquires command ContractContext.Contract.SendForSignature with {
        briefly "Send for signature control"
        described as {
          |The control through which a user submits the send for signature request.
        }
      }
      input SubmitForReviewInput acquires command ContractContext.Contract.SubmitForReview with {
        briefly "Submit for review control"
        described as {
          |The control through which a user submits the submit for review request.
        }
      }
      input TerminateContractInput acquires command ContractContext.Contract.TerminateContract with {
        briefly "Terminate contract control"
        described as {
          |The control through which a user submits the terminate contract request.
        }
      }
      input CreateContractInput acquires command ContractContext.CreateContract with {
        briefly "Create contract control"
        described as {
          |The control through which a user submits the create contract request.
        }
      }
    } with {
      briefly "Contract lifecycle screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppContractCommands is type ContractContext.ContractRequest
    inlet AppContractRepositoryResponses is result ContractContext.Contract.ContractResult
    handler ContractLifecycleAppHandler is {
      on other is {
        error "Unexpected message for application context ContractLifecycleApp"
      }
    } with {
      briefly "ContractLifecycleApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ContractLifecycleApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'DocumentRepositoryRequest Stream' is from outlet ContractContext.ToDocumentRepository.ToDocumentRepositoryOut to inlet DocumentRepository.DocumentRepositoryRequests with {
    briefly "What ContractContext asks DocumentRepository to send"
  }
  persistent connector 'ESignatureServiceRequest Stream' is from outlet ContractContext.ToESignatureService.ToESignatureServiceOut to inlet ESignatureService.ESignatureServiceRequests with {
    briefly "What ContractContext asks ESignatureService to send"
  }
  persistent connector 'ContractCommand Stream' is from outlet ContractLifecycleApp.AppContractCommands to inlet ContractContext.ContractCommandStreamIn with {
    briefly "Contract commands from the application"
  }
  persistent connector 'ContractResult Stream' is from outlet ContractContext.ContractResultStreamOut to inlet ContractLifecycleApp.AppContractRepositoryResponses with {
    briefly "Contract query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ContractLifecycleApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Contract lifecycle management domain"
  described as {
    |Contract drafting, review, approval, execution, and renewal.
  }
}
