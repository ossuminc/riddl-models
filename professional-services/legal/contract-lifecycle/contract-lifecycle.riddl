// Contract Lifecycle Management Domain Model
// Contract drafting, review, approval, execution, and renewal
domain ContractLifecycle is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ContractManager is "person managing contract lifecycle" with {
    briefly "Contract Manager"
    described as {
      |Manager overseeing contract processes.
    }
  }
  user LegalCounsel is "person reviewing and redlining contracts" with {
    briefly "Legal Counsel"
    described as {
      |Attorney reviewing contract terms.
    }
  }
  user Approver is "person approving contracts for execution" with {
    briefly "Approver"
    described as {
      |Authorized person approving contracts.
    }
  }
  user Signatory is "person executing and signing contracts" with {
    briefly "Signatory"
    described as {
      |Authorized person signing contracts.
    }
  }
  epic ContractProcessing is {
    user ContractManager wants to "to manage contracts through their lifecycle" so that "contracts are properly drafted, approved, and executed"
    case DraftAndExecuteContract is {
      user ContractManager wants to "to create and execute a new contract" so that "business agreements are formalized"
      step is "Manager drafts" "contract document" "from template" with {
        briefly "Draft contract"
        described as {
          |Create contract draft.
        }
      }
      step is "Counsel reviews" "contract terms" "and redlines" with {
        briefly "Review contract"
        described as {
          |Legal review and redline.
        }
      }
      step is "Approver approves" "final contract" "for execution" with {
        briefly "Approve contract"
        described as {
          |Approval workflow.
        }
      }
      step is "Signatory signs" "approved contract" "via e-signature" with {
        briefly "Execute contract"
        described as {
          |Contract signing.
        }
      }
    } with {
      briefly "Draft and execute contract"
      described as {
        |Full contract lifecycle from draft to execution.
      }
    }
  } with {
    briefly "Contract processing"
    described as {
      |Epic for contract lifecycle management.
    }
  }
  include "ContractContext.riddl"
  include "external-contexts.riddl"
  application context ContractLifecycleApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ContractLifecycle are delivered.
      }
    }
    outlet AppContractCommands is type ContractContext.Contract.ContractCommand
    inlet AppContractRepositoryResponses is type ContractContext.Contract.ContractResult    handler ContractLifecycleAppHandler is {
      on other is {
        error "Unexpected message for application context ContractLifecycleApp"
      }
    } with {
      briefly "ContractLifecycleApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ContractLifecycleApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppContractCommands is from outlet ContractLifecycleApp.AppContractCommands to inlet ContractContext.Contract.ContractCommands with {
    option persistent()
    briefly "LinkAppContractCommands"
  }
  connector LinkAppContractRepositoryResponses is from outlet ContractContext.ContractRepository.ContractRepositoryResponses to inlet ContractLifecycleApp.AppContractRepositoryResponses with {
    option persistent()
    briefly "LinkAppContractRepositoryResponses"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ContractLifecycleApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Contract lifecycle management domain"
  described as {
    |Contract drafting, review, approval, execution, and renewal.
  }
}
