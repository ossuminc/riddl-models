// Case Management Bounded Context
context CaseContext as router is {
  inlet LegalCaseCommandStreamIn is type LegalCaseCommand  outlet LegalCaseCommandStreamOut is type LegalCaseCommand
  inlet CaseQueryResultStreamIn is type CaseRepository.CaseResult  outlet CaseQueryResultStreamOut is type CaseRepository.CaseResult
  handler CaseContextBoundary is {
    on createCase: command LegalCase.CreateCase is {
      forward createCase to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on assignTeamMember: command LegalCase.AssignTeamMember is {
      forward assignTeamMember to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on removeTeamMember: command LegalCase.RemoveTeamMember is {
      forward removeTeamMember to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on recordTimeEntry: command LegalCase.RecordTimeEntry is {
      forward recordTimeEntry to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on recordExpense: command LegalCase.RecordExpense is {
      forward recordExpense to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on addDocument: command LegalCase.AddDocument is {
      forward addDocument to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on scheduleCourtDate: command LegalCase.ScheduleCourtDate is {
      forward scheduleCourtDate to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on cancelCourtDate: command LegalCase.CancelCourtDate is {
      forward cancelCourtDate to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on addNote: command LegalCase.AddNote is {
      forward addNote to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on updateCaseStatus: command LegalCase.UpdateCaseStatus is {
      forward updateCaseStatus to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on setCasePriority: command LegalCase.SetCasePriority is {
      forward setCasePriority to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on placeCaseOnHold: command LegalCase.PlaceCaseOnHold is {
      forward placeCaseOnHold to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on reactivateCase: command LegalCase.ReactivateCase is {
      forward reactivateCase to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on closeCase: command LegalCase.CloseCase is {
      forward closeCase to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on archiveCase: command LegalCase.ArchiveCase is {
      forward archiveCase to outlet CaseContext.LegalCaseCommandStreamOut
    }
    on caseResult: result CaseRepository.CaseResult is {
      send caseResult to outlet CaseContext.CaseQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the CaseContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'LegalCaseCommand Stream Intake' is from outlet CaseContext.LegalCaseCommandStreamOut to inlet CaseContext.LegalCase.LegalCaseCommands  connector 'CaseQueryResult Stream Egress' is from outlet CaseContext.CaseRepository.CaseRepositoryResponses to inlet CaseContext.CaseQueryResultStreamIn  adaptor FromBillingSystem from context BillingSystem is { 
    handler FromBillingSystemHandler is {
      on event BillingSystem.InvoiceGenerated is {
        do "the model receives invoice generated"
      }
      on event BillingSystem.InvoiceSent is {
        do "the model receives invoice sent"
      }
      on event BillingSystem.PaymentReceived is {
        do "the model receives payment received"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingSystem"
      }
    } with {
      briefly "from billing system"
      described as {
        |Carries messages from the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor ToBillingSystem to context BillingSystem is { 
    handler ToBillingSystemHandler is {
      on command BillingSystem.GenerateInvoice is {
        do "the model sends generate invoice"
      }
      on command BillingSystem.RecordPayment is {
        do "the model sends record payment"
      }
      on command BillingSystem.SendInvoice is {
        do "the model sends send invoice"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingSystem"
      }
    } with {
      briefly "to billing system"
      described as {
        |Carries messages to the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor FromCalendarSystem from context CalendarSystem is { 
    handler FromCalendarSystemHandler is {
      on event CalendarSystem.CalendarEventCancelled is {
        do "the model receives calendar event cancelled"
      }
      on event CalendarSystem.CalendarEventCreated is {
        do "the model receives calendar event created"
      }
      on event CalendarSystem.CalendarEventUpdated is {
        do "the model receives calendar event updated"
      }
      on event CalendarSystem.ReminderSent is {
        do "the model receives reminder sent"
      }
      on other is {
        error "Unexpected message for adaptor FromCalendarSystem"
      }
    } with {
      briefly "from calendar system"
      described as {
        |Carries messages from the external CalendarSystem.
      }
    }
  } with {
    briefly "CalendarSystem integration"
    described as {
      |The model's side of the CalendarSystem conversation.
    }
  }
  adaptor ToCalendarSystem to context CalendarSystem is { 
    handler ToCalendarSystemHandler is {
      on command CalendarSystem.CancelCalendarEvent is {
        do "the model sends cancel calendar event"
      }
      on command CalendarSystem.CreateCalendarEvent is {
        do "the model sends create calendar event"
      }
      on command CalendarSystem.SendReminder is {
        do "the model sends send reminder"
      }
      on command CalendarSystem.UpdateCalendarEvent is {
        do "the model sends update calendar event"
      }
      on other is {
        error "Unexpected message for adaptor ToCalendarSystem"
      }
    } with {
      briefly "to calendar system"
      described as {
        |Carries messages to the external CalendarSystem.
      }
    }
  } with {
    briefly "CalendarSystem integration"
    described as {
      |The model's side of the CalendarSystem conversation.
    }
  }
  adaptor FromClientPortal from context ClientPortal is { 
    handler FromClientPortalHandler is {
      on event ClientPortal.CaseUpdatePublished is {
        do "the model receives case update published"
      }
      on event ClientPortal.DocumentShared is {
        do "the model receives document shared"
      }
      on event ClientPortal.SecureMessageSent is {
        do "the model receives secure message sent"
      }
      on other is {
        error "Unexpected message for adaptor FromClientPortal"
      }
    } with {
      briefly "from client portal"
      described as {
        |Carries messages from the external ClientPortal.
      }
    }
  } with {
    briefly "ClientPortal integration"
    described as {
      |The model's side of the ClientPortal conversation.
    }
  }
  adaptor ToClientPortal to context ClientPortal is { 
    handler ToClientPortalHandler is {
      on command ClientPortal.PublishCaseUpdate is {
        do "the model sends publish case update"
      }
      on command ClientPortal.SendSecureMessage is {
        do "the model sends send secure message"
      }
      on command ClientPortal.ShareDocument is {
        do "the model sends share document"
      }
      on other is {
        error "Unexpected message for adaptor ToClientPortal"
      }
    } with {
      briefly "to client portal"
      described as {
        |Carries messages to the external ClientPortal.
      }
    }
  } with {
    briefly "ClientPortal integration"
    described as {
      |The model's side of the ClientPortal conversation.
    }
  }
  adaptor FromConflictDatabase from context ConflictDatabase is { 
    handler FromConflictDatabaseHandler is {
      on event ConflictDatabase.ConflictSearchCompleted is {
        do "the model receives conflict search completed"
      }
      on event ConflictDatabase.ConflictWaiverRecorded is {
        do "the model receives conflict waiver recorded"
      }
      on other is {
        error "Unexpected message for adaptor FromConflictDatabase"
      }
    } with {
      briefly "from conflict database"
      described as {
        |Carries messages from the external ConflictDatabase.
      }
    }
  } with {
    briefly "ConflictDatabase integration"
    described as {
      |The model's side of the ConflictDatabase conversation.
    }
  }
  adaptor ToConflictDatabase to context ConflictDatabase is { 
    handler ToConflictDatabaseHandler is {
      on command ConflictDatabase.RecordConflictWaiver is {
        do "the model sends record conflict waiver"
      }
      on command ConflictDatabase.SearchConflicts is {
        do "the model sends search conflicts"
      }
      on other is {
        error "Unexpected message for adaptor ToConflictDatabase"
      }
    } with {
      briefly "to conflict database"
      described as {
        |Carries messages to the external ConflictDatabase.
      }
    }
  } with {
    briefly "ConflictDatabase integration"
    described as {
      |The model's side of the ConflictDatabase conversation.
    }
  }
  adaptor FromDocumentManagement from context DocumentManagement is { 
    handler FromDocumentManagementHandler is {
      on event DocumentManagement.DocumentDeleted is {
        do "the model receives document deleted"
      }
      on event DocumentManagement.DocumentRetrieved is {
        do "the model receives document retrieved"
      }
      on event DocumentManagement.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentManagement"
      }
    } with {
      briefly "from document management"
      described as {
        |Carries messages from the external DocumentManagement.
      }
    }
  } with {
    briefly "DocumentManagement integration"
    described as {
      |The model's side of the DocumentManagement conversation.
    }
  }
  adaptor ToDocumentManagement to context DocumentManagement is { 
    handler ToDocumentManagementHandler is {
      on command DocumentManagement.DeleteDocument is {
        do "the model sends delete document"
      }
      on command DocumentManagement.RetrieveDocument is {
        do "the model sends retrieve document"
      }
      on command DocumentManagement.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentManagement"
      }
    } with {
      briefly "to document management"
      described as {
        |Carries messages to the external DocumentManagement.
      }
    }
  } with {
    briefly "DocumentManagement integration"
    described as {
      |The model's side of the DocumentManagement conversation.
    }
  }
  include "types.riddl"
  include "LegalCase.riddl"
  type CaseRepositoryCommand is one of {
    CaseContext.CaseRepository.PersistCaseArchived or CaseContext.CaseRepository.PersistCaseClosed or CaseContext.CaseRepository.PersistCaseCreated or CaseContext.CaseRepository.PersistCasePlacedOnHold or CaseContext.CaseRepository.PersistCasePrioritySet or CaseContext.CaseRepository.PersistCaseReactivated or CaseContext.CaseRepository.PersistCaseStatusUpdated or CaseContext.CaseRepository.PersistCourtDateCancelled or CaseContext.CaseRepository.PersistCourtDateScheduled or CaseContext.CaseRepository.PersistDocumentAdded or CaseContext.CaseRepository.PersistExpenseRecorded or CaseContext.CaseRepository.PersistNoteAdded or CaseContext.CaseRepository.PersistTeamMemberAssigned or CaseContext.CaseRepository.PersistTeamMemberRemoved or CaseContext.CaseRepository.PersistTimeEntryRecorded
  } with {
    briefly "Anything that writes CaseRepository"
    described as {
      |The persistence commands CaseRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository CaseRepository as flow is {
    inlet CaseRepositoryFromCaseDashboard is type CaseRepositoryCommand
    command PersistCaseArchived is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseArchived applies to.
        }
      }
    } with {
      briefly "Persist CaseArchived"
      described as {
        |Instructs this repository to apply CaseArchived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCasePlacedOnHold is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CasePlacedOnHold applies to.
        }
      }
    } with {
      briefly "Persist CasePlacedOnHold"
      described as {
        |Instructs this repository to apply CasePlacedOnHold to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCasePrioritySet is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CasePrioritySet applies to.
        }
      }
    } with {
      briefly "Persist CasePrioritySet"
      described as {
        |Instructs this repository to apply CasePrioritySet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCaseReactivated is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseReactivated applies to.
        }
      }
    } with {
      briefly "Persist CaseReactivated"
      described as {
        |Instructs this repository to apply CaseReactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCourtDateCancelled is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CourtDateCancelled applies to.
        }
      }
    } with {
      briefly "Persist CourtDateCancelled"
      described as {
        |Instructs this repository to apply CourtDateCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDocumentAdded is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row DocumentAdded applies to.
        }
      }
    } with {
      briefly "Persist DocumentAdded"
      described as {
        |Instructs this repository to apply DocumentAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistNoteAdded is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row NoteAdded applies to.
        }
      }
    } with {
      briefly "Persist NoteAdded"
      described as {
        |Instructs this repository to apply NoteAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCaseClosed is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseClosed applies to.
        }
      }
    } with {
      briefly "Persist CaseClosed"
      described as {
        |Instructs this repository to apply CaseClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCaseCreated is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseCreated applies to.
        }
      }
    } with {
      briefly "Persist CaseCreated"
      described as {
        |Instructs this repository to apply CaseCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCaseStatusUpdated is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseStatusUpdated applies to.
        }
      }
    } with {
      briefly "Persist CaseStatusUpdated"
      described as {
        |Instructs this repository to apply CaseStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCourtDateScheduled is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CourtDateScheduled applies to.
        }
      }
    } with {
      briefly "Persist CourtDateScheduled"
      described as {
        |Instructs this repository to apply CourtDateScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExpenseRecorded is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExpenseRecorded applies to.
        }
      }
    } with {
      briefly "Persist ExpenseRecorded"
      described as {
        |Instructs this repository to apply ExpenseRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTeamMemberAssigned is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row TeamMemberAssigned applies to.
        }
      }
    } with {
      briefly "Persist TeamMemberAssigned"
      described as {
        |Instructs this repository to apply TeamMemberAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTeamMemberRemoved is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row TeamMemberRemoved applies to.
        }
      }
    } with {
      briefly "Persist TeamMemberRemoved"
      described as {
        |Instructs this repository to apply TeamMemberRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTimeEntryRecorded is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row TimeEntryRecorded applies to.
        }
      }
    } with {
      briefly "Persist TimeEntryRecorded"
      described as {
        |Instructs this repository to apply TimeEntryRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredLegalCase is  {
      legalCaseId: UUID with {
        briefly "legalCaseId"
        described as {
          |The legalCaseId column of the stored legalCase row.
        }
      }
    } with {
      briefly "Stored legalCase row"
      described as {
        |The persistence shape of legalCase data as this repository stores it.
      }
    }
    schema LegalCaseData is relational
      of legalcases as type StoredLegalCase
        index on field StoredLegalCase.legalCaseId
 with {
      briefly "Legal case data schema"
      described as {
        |The relational schema persisting legal case records for this repository.
      }
    }
    outlet CaseRepositoryResponses is type CaseRepository.CaseResult
    record CaseRecord is  {
      caseId: CaseId
      matterId: MatterId
      title: String
      clientId: ClientId
      clientName: String
      practiceArea: PracticeArea
      billingType: BillingType
      status: CaseStatus
      priority: CasePriority
      leadAttorneyId: AttorneyId?
      createdAt: DateTime
      lastUpdated: DateTime
      updatedClosedAt: DateTime?
    } with {
      briefly "Persisted case record"
      described as {
        |The database record structure for storing case data.
      }
    }
    handler CaseQueryHandler is {
      on persistCaseArchived: command PersistCaseArchived is {
        do "apply CaseArchived to the stored row"
      }
      on persistCasePlacedOnHold: command PersistCasePlacedOnHold is {
        do "apply CasePlacedOnHold to the stored row"
      }
      on persistCasePrioritySet: command PersistCasePrioritySet is {
        do "apply CasePrioritySet to the stored row"
      }
      on persistCaseReactivated: command PersistCaseReactivated is {
        do "apply CaseReactivated to the stored row"
      }
      on persistCourtDateCancelled: command PersistCourtDateCancelled is {
        do "apply CourtDateCancelled to the stored row"
      }
      on persistDocumentAdded: command PersistDocumentAdded is {
        do "apply DocumentAdded to the stored row"
      }
      on persistNoteAdded: command PersistNoteAdded is {
        do "apply NoteAdded to the stored row"
      }
      on persistCaseClosed: command PersistCaseClosed is {
        do "apply CaseClosed to the stored row"
      }
      on persistCaseCreated: command PersistCaseCreated is {
        do "apply CaseCreated to the stored row"
      }
      on persistCaseStatusUpdated: command PersistCaseStatusUpdated is {
        do "apply CaseStatusUpdated to the stored row"
      }
      on persistCourtDateScheduled: command PersistCourtDateScheduled is {
        do "apply CourtDateScheduled to the stored row"
      }
      on persistExpenseRecorded: command PersistExpenseRecorded is {
        do "apply ExpenseRecorded to the stored row"
      }
      on persistTeamMemberAssigned: command PersistTeamMemberAssigned is {
        do "apply TeamMemberAssigned to the stored row"
      }
      on persistTeamMemberRemoved: command PersistTeamMemberRemoved is {
        do "apply TeamMemberRemoved to the stored row"
      }
      on persistTimeEntryRecorded: command PersistTimeEntryRecorded is {
        do "apply TimeEntryRecorded to the stored row"
      }
      on query GetCaseDashboardData is {
        let caseDashboardDataView: type CaseDashboardDataView = prompt("read the case dashboard data projection")
        reply caseDashboardDataView
      }
      on query GetAttorneyWorkloadData is {
        let attorneyWorkloadDataView: type AttorneyWorkloadDataView = prompt("read the attorney workload data projection")
        reply attorneyWorkloadDataView
      }
      on query GetBillingData is {
        let billingDataView: type BillingDataView = prompt("read the billing data projection")
        reply billingDataView
      }
      on query FindCaseById is {
        let caseResult: type CaseResult = prompt("read the case from the store")
        reply caseResult
      }
      on query FindCasesByClient is {
        let caseListResult: type CaseListResult = prompt("read the case list that cases by client asks for")
        reply caseListResult
      }
      on query FindCasesByAttorney is {
        let caseListResult: type CaseListResult = prompt("read the case list that cases by attorney asks for")
        reply caseListResult
      }
      on query FindCasesByStatus is {
        let caseListResult: type CaseListResult = prompt("read the case list that cases by status asks for")
        reply caseListResult
      }
      on query SearchCases is {
        let caseListResult: type CaseListResult = prompt("read the case list that cases asks for")
        reply caseListResult
      }
    } with {
      briefly "Handles case queries"
      described as {
        |Processes read queries against the case repository.
      }
    }
    query FindCaseById replies result CaseResult is  { caseId: CaseId } with {
      briefly "Query to find case by ID"
      described as {
        |Looks up a case using its unique identifier.
      }
    }
    query FindCasesByClient replies result CaseListResult is  { clientId: ClientId } with {
      briefly "Query to find cases by client"
      described as {
        |Retrieves all cases associated with a client.
      }
    }
    query FindCasesByAttorney replies result CaseListResult is  { attorneyId: AttorneyId } with {
      briefly "Query to find cases by attorney"
      described as {
        |Retrieves all cases where an attorney is assigned.
      }
    }
    query FindCasesByStatus replies result CaseListResult is  {
      status: CaseStatus
      filterPracticeArea: PracticeArea?
    } with {
      briefly "Query to find cases by status"
      described as {
        |Filters cases by status with optional practice area filter.
      }
    }
    query SearchCases replies result CaseListResult is  {
      searchText: String
      filterPracticeArea: PracticeArea?
      filterStatus: CaseStatus?
      fromDate: Date?
      toDate: Date?
    } with {
      briefly "Full-text case search query"
      described as {
        |Searches cases with optional filters for practice area, status, and date range.
      }
    }
    result CaseResult is  {
      found: Boolean
      caseRecord: CaseRecord?
    } with {
      briefly "Single case query result"
      described as {
        |Returns a single case record if found.
      }
    }
    result CaseListResult is  {
      totalCount: Integer
      cases: CaseRecord*
    } with {
      briefly "Multiple case query result"
      described as {
        |Returns a list of case records with total count.
      }
    }
  } with {
    briefly "Case persistence repository"
    described as {
      | The CaseRepository provides persistence and query capabilities for
      | legal cases. It supports finding cases by ID, client, attorney,
      | status, and full-text search.
    }
  }
  query GetCaseDashboardData replies result CaseDashboardDataView is  {
    caseDashboardDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which case dashboard data to retrieve.
      }
    }
  } with {
    briefly "Get case dashboard data"
    described as {
      |Retrieves the case dashboard data projection.
    }
  }
  result CaseDashboardDataView is  {
    caseDashboardData: CaseDashboard.CaseDashboardData with {
      briefly "Case dashboard data"
      described as {
        |The case dashboard data being returned.
      }
    }
  } with {
    briefly "Case dashboard data view"
    described as {
      |Read model view carrying the case dashboard data projection.
    }
  }
  projector CaseDashboard as flow is {
    outlet CaseDashboardToRepository is type CaseRepositoryCommand
    updates repository CaseContext.CaseRepository
    inlet CaseDashboardFromLegalCase is type LegalCaseEvent
    record CaseDashboardData is  {
      totalActiveCases: Integer
      casesByStatus: CaseStatusCount*
      casesByPracticeArea: PracticeAreaCount*
      upcomingDeadlines: UpcomingDeadline*
      recentActivity: RecentCaseActivity*
    } with {
      briefly "Dashboard projection data"
      described as {
        |Aggregated data for the case management dashboard.
      }
    }
    record CaseStatusCount is  {
      status: CaseStatus
      count: Integer
    } with {
      briefly "Count by status"
      described as {
        |Number of cases in each status.
      }
    }
    record PracticeAreaCount is  {
      practiceArea: PracticeArea
      count: Integer
    } with {
      briefly "Count by practice area"
      described as {
        |Number of cases in each practice area.
      }
    }
    record UpcomingDeadline is  {
      caseId: CaseId
      matterId: MatterId
      title: String
      eventType: CourtEventType
      dueDate: DateTime
      daysUntilDue: Integer
    } with {
      briefly "Upcoming deadline summary"
      described as {
        |Court dates and deadlines approaching in the near future.
      }
    }
    record RecentCaseActivity is  {
      caseId: CaseId
      matterId: MatterId
      title: String
      activityType: String
      activityDescription: String
      occurredAt: DateTime
    } with {
      briefly "Recent case activity"
      described as {
        |Latest activities across all cases.
      }
    }
    handler DashboardHandler is {
      on caseArchived: event LegalCase.CaseArchived is {
        tell command CaseContext.CaseRepository.PersistCaseArchived(caseId = caseArchived.caseId) to repository CaseContext.CaseRepository
        do "apply CaseArchived to the CaseDashboard projection"
      }
      on casePlacedOnHold: event LegalCase.CasePlacedOnHold is {
        tell command CaseContext.CaseRepository.PersistCasePlacedOnHold(caseId = casePlacedOnHold.caseId) to repository CaseContext.CaseRepository
        do "apply CasePlacedOnHold to the CaseDashboard projection"
      }
      on casePrioritySet: event LegalCase.CasePrioritySet is {
        tell command CaseContext.CaseRepository.PersistCasePrioritySet(caseId = casePrioritySet.caseId) to repository CaseContext.CaseRepository
        do "apply CasePrioritySet to the CaseDashboard projection"
      }
      on caseReactivated: event LegalCase.CaseReactivated is {
        tell command CaseContext.CaseRepository.PersistCaseReactivated(caseId = caseReactivated.caseId) to repository CaseContext.CaseRepository
        do "apply CaseReactivated to the CaseDashboard projection"
      }
      on courtDateCancelled: event LegalCase.CourtDateCancelled is {
        tell command CaseContext.CaseRepository.PersistCourtDateCancelled(caseId = courtDateCancelled.caseId) to repository CaseContext.CaseRepository
        do "apply CourtDateCancelled to the CaseDashboard projection"
      }
      on documentAdded: event LegalCase.DocumentAdded is {
        tell command CaseContext.CaseRepository.PersistDocumentAdded(caseId = documentAdded.caseId) to repository CaseContext.CaseRepository
        do "apply DocumentAdded to the CaseDashboard projection"
      }
      on expenseRecorded: event LegalCase.ExpenseRecorded is {
        tell command CaseContext.CaseRepository.PersistExpenseRecorded(caseId = expenseRecorded.caseId) to repository CaseContext.CaseRepository
        do "apply ExpenseRecorded to the CaseDashboard projection"
      }
      on noteAdded: event LegalCase.NoteAdded is {
        tell command CaseContext.CaseRepository.PersistNoteAdded(caseId = noteAdded.caseId) to repository CaseContext.CaseRepository
        do "apply NoteAdded to the CaseDashboard projection"
      }
      on teamMemberAssigned: event LegalCase.TeamMemberAssigned is {
        tell command CaseContext.CaseRepository.PersistTeamMemberAssigned(caseId = teamMemberAssigned.caseId) to repository CaseContext.CaseRepository
        do "apply TeamMemberAssigned to the CaseDashboard projection"
      }
      on teamMemberRemoved: event LegalCase.TeamMemberRemoved is {
        tell command CaseContext.CaseRepository.PersistTeamMemberRemoved(caseId = teamMemberRemoved.caseId) to repository CaseContext.CaseRepository
        do "apply TeamMemberRemoved to the CaseDashboard projection"
      }
      on timeEntryRecorded: event LegalCase.TimeEntryRecorded is {
        tell command CaseContext.CaseRepository.PersistTimeEntryRecorded(caseId = timeEntryRecorded.caseId) to repository CaseContext.CaseRepository
        do "apply TimeEntryRecorded to the CaseDashboard projection"
      }
      on caseCreated: event LegalCase.CaseCreated is {
        tell command CaseContext.CaseRepository.PersistCaseCreated(caseId = caseCreated.caseId) to repository CaseContext.CaseRepository
      }
      on caseStatusUpdated: event LegalCase.CaseStatusUpdated is {
        tell command CaseContext.CaseRepository.PersistCaseStatusUpdated(caseId = caseStatusUpdated.caseId) to repository CaseContext.CaseRepository
      }
      on courtDateScheduled: event LegalCase.CourtDateScheduled is {
        tell command CaseContext.CaseRepository.PersistCourtDateScheduled(caseId = courtDateScheduled.caseId) to repository CaseContext.CaseRepository
      }
      on caseClosed: event LegalCase.CaseClosed is {
        tell command CaseContext.CaseRepository.PersistCaseClosed(caseId = caseClosed.caseId) to repository CaseContext.CaseRepository
      }
    } with {
      briefly "Processes events for dashboard"
      described as {
        |Maintains the dashboard projection by processing case events.
      }
    }
  } with {
    briefly "Case management dashboard projector"
    described as {
      | The CaseDashboard projector maintains aggregated views of case data
      | for display on management dashboards. It tracks case counts by status
      | and practice area, upcoming deadlines, and recent activity.
    }
  }
  query GetAttorneyWorkloadData replies result AttorneyWorkloadDataView is  {
    attorneyWorkloadDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which attorney workload data to retrieve.
      }
    }
  } with {
    briefly "Get attorney workload data"
    described as {
      |Retrieves the attorney workload data projection.
    }
  }
  result AttorneyWorkloadDataView is  {
    attorneyWorkloadData: AttorneyWorkload.AttorneyWorkloadData with {
      briefly "Attorney workload data"
      described as {
        |The attorney workload data being returned.
      }
    }
  } with {
    briefly "Attorney workload data view"
    described as {
      |Read model view carrying the attorney workload data projection.
    }
  }
  projector AttorneyWorkload as sink is {
    updates repository CaseContext.CaseRepository
    inlet AttorneyWorkloadFromLegalCase is type LegalCaseEvent
    record AttorneyWorkloadData is  {
      attorneyId: AttorneyId
      attorneyName: String
      activeCases: Integer
      totalBillableHoursThisMonth: Decimal(10,2)
      billableTarget: Decimal(10,2)
      utilizationPercent: Decimal(5,2)
      caseBreakdown: AttorneyCaseAssignment*
    } with {
      briefly "Attorney workload data"
      described as {
        |Tracks attorney workload and utilization metrics.
      }
    }
    record AttorneyCaseAssignment is  {
      caseId: CaseId
      matterId: MatterId
      title: String
      role: TeamRole
      hoursThisMonth: Decimal(8,2)
    } with {
      briefly "Attorney case assignment"
      described as {
        |Case assignments and hours for an attorney.
      }
    }
    handler WorkloadHandler is {
      on caseArchived: event LegalCase.CaseArchived is {
        tell command CaseContext.CaseRepository.PersistCaseArchived(caseId = caseArchived.caseId) to repository CaseContext.CaseRepository
        do "apply CaseArchived to the AttorneyWorkload projection"
      }
      on caseCreated: event LegalCase.CaseCreated is {
        tell command CaseContext.CaseRepository.PersistCaseCreated(caseId = caseCreated.caseId) to repository CaseContext.CaseRepository
        do "apply CaseCreated to the AttorneyWorkload projection"
      }
      on casePlacedOnHold: event LegalCase.CasePlacedOnHold is {
        tell command CaseContext.CaseRepository.PersistCasePlacedOnHold(caseId = casePlacedOnHold.caseId) to repository CaseContext.CaseRepository
        do "apply CasePlacedOnHold to the AttorneyWorkload projection"
      }
      on casePrioritySet: event LegalCase.CasePrioritySet is {
        tell command CaseContext.CaseRepository.PersistCasePrioritySet(caseId = casePrioritySet.caseId) to repository CaseContext.CaseRepository
        do "apply CasePrioritySet to the AttorneyWorkload projection"
      }
      on caseReactivated: event LegalCase.CaseReactivated is {
        tell command CaseContext.CaseRepository.PersistCaseReactivated(caseId = caseReactivated.caseId) to repository CaseContext.CaseRepository
        do "apply CaseReactivated to the AttorneyWorkload projection"
      }
      on caseStatusUpdated: event LegalCase.CaseStatusUpdated is {
        tell command CaseContext.CaseRepository.PersistCaseStatusUpdated(caseId = caseStatusUpdated.caseId) to repository CaseContext.CaseRepository
        do "apply CaseStatusUpdated to the AttorneyWorkload projection"
      }
      on courtDateCancelled: event LegalCase.CourtDateCancelled is {
        tell command CaseContext.CaseRepository.PersistCourtDateCancelled(caseId = courtDateCancelled.caseId) to repository CaseContext.CaseRepository
        do "apply CourtDateCancelled to the AttorneyWorkload projection"
      }
      on courtDateScheduled: event LegalCase.CourtDateScheduled is {
        tell command CaseContext.CaseRepository.PersistCourtDateScheduled(caseId = courtDateScheduled.caseId) to repository CaseContext.CaseRepository
        do "apply CourtDateScheduled to the AttorneyWorkload projection"
      }
      on documentAdded: event LegalCase.DocumentAdded is {
        tell command CaseContext.CaseRepository.PersistDocumentAdded(caseId = documentAdded.caseId) to repository CaseContext.CaseRepository
        do "apply DocumentAdded to the AttorneyWorkload projection"
      }
      on expenseRecorded: event LegalCase.ExpenseRecorded is {
        tell command CaseContext.CaseRepository.PersistExpenseRecorded(caseId = expenseRecorded.caseId) to repository CaseContext.CaseRepository
        do "apply ExpenseRecorded to the AttorneyWorkload projection"
      }
      on noteAdded: event LegalCase.NoteAdded is {
        tell command CaseContext.CaseRepository.PersistNoteAdded(caseId = noteAdded.caseId) to repository CaseContext.CaseRepository
        do "apply NoteAdded to the AttorneyWorkload projection"
      }
      on teamMemberAssigned: event LegalCase.TeamMemberAssigned is {
        tell command CaseContext.CaseRepository.PersistTeamMemberAssigned(caseId = teamMemberAssigned.caseId) to repository CaseContext.CaseRepository
      }
      on teamMemberRemoved: event LegalCase.TeamMemberRemoved is {
        tell command CaseContext.CaseRepository.PersistTeamMemberRemoved(caseId = teamMemberRemoved.caseId) to repository CaseContext.CaseRepository
      }
      on timeEntryRecorded: event LegalCase.TimeEntryRecorded is {
        tell command CaseContext.CaseRepository.PersistTimeEntryRecorded(caseId = timeEntryRecorded.caseId) to repository CaseContext.CaseRepository
      }
      on caseClosed: event LegalCase.CaseClosed is {
        tell command CaseContext.CaseRepository.PersistCaseClosed(caseId = caseClosed.caseId) to repository CaseContext.CaseRepository
      }
    } with {
      briefly "Processes events for workload tracking"
      described as {
        |Maintains attorney workload projections from case events.
      }
    }
  } with {
    briefly "Attorney workload projector"
    described as {
      | The AttorneyWorkload projector tracks each attorney's case assignments
      | and billable hours. It calculates utilization against targets and
      | provides workload distribution visibility for management.
    }
  }
  query GetBillingData replies result BillingDataView is  {
    billingDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which billing data to retrieve.
      }
    }
  } with {
    briefly "Get billing data"
    described as {
      |Retrieves the billing data projection.
    }
  }
  result BillingDataView is  {
    billingData: BillingProjection.BillingData with {
      briefly "Billing data"
      described as {
        |The billing data being returned.
      }
    }
  } with {
    briefly "Billing data view"
    described as {
      |Read model view carrying the billing data projection.
    }
  }
  projector BillingProjection as sink is {
    updates repository CaseContext.CaseRepository
    inlet BillingProjectionFromLegalCase is type LegalCaseEvent
    record BillingData is  {
      caseId: CaseId
      matterId: MatterId
      clientId: ClientId
      billingType: BillingType
      unbilledHours: Decimal(10,2)
      unbilledExpenses: Decimal(15,2)
      totalBilled: Decimal(15,2)
      lastBilledDate: Date?
    } with {
      briefly "Case billing summary"
      described as {
        |Aggregated billing data for a case.
      }
    }
    handler BillingHandler is {
      on caseArchived: event LegalCase.CaseArchived is {
        tell command CaseContext.CaseRepository.PersistCaseArchived(caseId = caseArchived.caseId) to repository CaseContext.CaseRepository
        do "apply CaseArchived to the BillingProjection projection"
      }
      on caseCreated: event LegalCase.CaseCreated is {
        tell command CaseContext.CaseRepository.PersistCaseCreated(caseId = caseCreated.caseId) to repository CaseContext.CaseRepository
        do "apply CaseCreated to the BillingProjection projection"
      }
      on casePlacedOnHold: event LegalCase.CasePlacedOnHold is {
        tell command CaseContext.CaseRepository.PersistCasePlacedOnHold(caseId = casePlacedOnHold.caseId) to repository CaseContext.CaseRepository
        do "apply CasePlacedOnHold to the BillingProjection projection"
      }
      on casePrioritySet: event LegalCase.CasePrioritySet is {
        tell command CaseContext.CaseRepository.PersistCasePrioritySet(caseId = casePrioritySet.caseId) to repository CaseContext.CaseRepository
        do "apply CasePrioritySet to the BillingProjection projection"
      }
      on caseReactivated: event LegalCase.CaseReactivated is {
        tell command CaseContext.CaseRepository.PersistCaseReactivated(caseId = caseReactivated.caseId) to repository CaseContext.CaseRepository
        do "apply CaseReactivated to the BillingProjection projection"
      }
      on caseStatusUpdated: event LegalCase.CaseStatusUpdated is {
        tell command CaseContext.CaseRepository.PersistCaseStatusUpdated(caseId = caseStatusUpdated.caseId) to repository CaseContext.CaseRepository
        do "apply CaseStatusUpdated to the BillingProjection projection"
      }
      on courtDateCancelled: event LegalCase.CourtDateCancelled is {
        tell command CaseContext.CaseRepository.PersistCourtDateCancelled(caseId = courtDateCancelled.caseId) to repository CaseContext.CaseRepository
        do "apply CourtDateCancelled to the BillingProjection projection"
      }
      on courtDateScheduled: event LegalCase.CourtDateScheduled is {
        tell command CaseContext.CaseRepository.PersistCourtDateScheduled(caseId = courtDateScheduled.caseId) to repository CaseContext.CaseRepository
        do "apply CourtDateScheduled to the BillingProjection projection"
      }
      on documentAdded: event LegalCase.DocumentAdded is {
        tell command CaseContext.CaseRepository.PersistDocumentAdded(caseId = documentAdded.caseId) to repository CaseContext.CaseRepository
        do "apply DocumentAdded to the BillingProjection projection"
      }
      on noteAdded: event LegalCase.NoteAdded is {
        tell command CaseContext.CaseRepository.PersistNoteAdded(caseId = noteAdded.caseId) to repository CaseContext.CaseRepository
        do "apply NoteAdded to the BillingProjection projection"
      }
      on teamMemberAssigned: event LegalCase.TeamMemberAssigned is {
        tell command CaseContext.CaseRepository.PersistTeamMemberAssigned(caseId = teamMemberAssigned.caseId) to repository CaseContext.CaseRepository
        do "apply TeamMemberAssigned to the BillingProjection projection"
      }
      on teamMemberRemoved: event LegalCase.TeamMemberRemoved is {
        tell command CaseContext.CaseRepository.PersistTeamMemberRemoved(caseId = teamMemberRemoved.caseId) to repository CaseContext.CaseRepository
        do "apply TeamMemberRemoved to the BillingProjection projection"
      }
      on timeEntryRecorded: event LegalCase.TimeEntryRecorded is {
        tell command CaseContext.CaseRepository.PersistTimeEntryRecorded(caseId = timeEntryRecorded.caseId) to repository CaseContext.CaseRepository
      }
      on expenseRecorded: event LegalCase.ExpenseRecorded is {
        tell command CaseContext.CaseRepository.PersistExpenseRecorded(caseId = expenseRecorded.caseId) to repository CaseContext.CaseRepository
      }
      on caseClosed: event LegalCase.CaseClosed is {
        tell command CaseContext.CaseRepository.PersistCaseClosed(caseId = caseClosed.caseId) to repository CaseContext.CaseRepository
      }
    } with {
      briefly "Processes events for billing"
      described as {
        |Maintains billing projections from time and expense events.
      }
    }
  } with {
    briefly "Billing summary projector"
    described as {
      | The BillingProjection tracks unbilled time and expenses for each case.
      | It provides data for generating client invoices and accounts receivable
      | reporting.
    }
  }
  // ---- Event publication for LegalCase ----
  type LegalCaseEvent is one of {
    CaseContext.LegalCase.CaseCreated or CaseContext.LegalCase.TeamMemberAssigned or CaseContext.LegalCase.TeamMemberRemoved or CaseContext.LegalCase.TimeEntryRecorded or CaseContext.LegalCase.ExpenseRecorded or CaseContext.LegalCase.DocumentAdded or CaseContext.LegalCase.CourtDateScheduled or CaseContext.LegalCase.CourtDateCancelled or CaseContext.LegalCase.NoteAdded or CaseContext.LegalCase.CaseStatusUpdated or CaseContext.LegalCase.CasePrioritySet or CaseContext.LegalCase.CasePlacedOnHold or CaseContext.LegalCase.CaseReactivated or CaseContext.LegalCase.CaseClosed or CaseContext.LegalCase.CaseArchived
  } with {
    briefly "LegalCase event alternation"
    described as {
      |Union of all LegalCase events, for streaming and event-sourced
      |persistence.
    }
  }
  processor LegalCaseEventSplit as split is {
    inlet LegalCaseEventSplitIn is type LegalCaseEvent
    outlet LegalCaseEventSplitToCaseDashboard is type LegalCaseEvent
    outlet LegalCaseEventSplitToAttorneyWorkload is type LegalCaseEvent
    outlet LegalCaseEventSplitToBillingProjection is type LegalCaseEvent
    handler LegalCaseEventSplitHandler is {
      on caseCreated: event LegalCase.CaseCreated is {
        send caseCreated to outlet LegalCaseEventSplitToCaseDashboard
        send caseCreated to outlet LegalCaseEventSplitToAttorneyWorkload
        send caseCreated to outlet LegalCaseEventSplitToBillingProjection
        tell caseCreated to entity CaseContext.LegalCase
      }
      on teamMemberAssigned: event LegalCase.TeamMemberAssigned is {
        send teamMemberAssigned to outlet LegalCaseEventSplitToCaseDashboard
        send teamMemberAssigned to outlet LegalCaseEventSplitToAttorneyWorkload
        send teamMemberAssigned to outlet LegalCaseEventSplitToBillingProjection
        tell teamMemberAssigned to entity CaseContext.LegalCase
      }
      on teamMemberRemoved: event LegalCase.TeamMemberRemoved is {
        send teamMemberRemoved to outlet LegalCaseEventSplitToCaseDashboard
        send teamMemberRemoved to outlet LegalCaseEventSplitToAttorneyWorkload
        send teamMemberRemoved to outlet LegalCaseEventSplitToBillingProjection
        tell teamMemberRemoved to entity CaseContext.LegalCase
      }
      on timeEntryRecorded: event LegalCase.TimeEntryRecorded is {
        send timeEntryRecorded to outlet LegalCaseEventSplitToCaseDashboard
        send timeEntryRecorded to outlet LegalCaseEventSplitToAttorneyWorkload
        send timeEntryRecorded to outlet LegalCaseEventSplitToBillingProjection
        tell timeEntryRecorded to entity CaseContext.LegalCase
      }
      on expenseRecorded: event LegalCase.ExpenseRecorded is {
        send expenseRecorded to outlet LegalCaseEventSplitToCaseDashboard
        send expenseRecorded to outlet LegalCaseEventSplitToAttorneyWorkload
        send expenseRecorded to outlet LegalCaseEventSplitToBillingProjection
        tell expenseRecorded to entity CaseContext.LegalCase
      }
      on documentAdded: event LegalCase.DocumentAdded is {
        send documentAdded to outlet LegalCaseEventSplitToCaseDashboard
        send documentAdded to outlet LegalCaseEventSplitToAttorneyWorkload
        send documentAdded to outlet LegalCaseEventSplitToBillingProjection
        tell documentAdded to entity CaseContext.LegalCase
      }
      on courtDateScheduled: event LegalCase.CourtDateScheduled is {
        send courtDateScheduled to outlet LegalCaseEventSplitToCaseDashboard
        send courtDateScheduled to outlet LegalCaseEventSplitToAttorneyWorkload
        send courtDateScheduled to outlet LegalCaseEventSplitToBillingProjection
        tell courtDateScheduled to entity CaseContext.LegalCase
      }
      on courtDateCancelled: event LegalCase.CourtDateCancelled is {
        send courtDateCancelled to outlet LegalCaseEventSplitToCaseDashboard
        send courtDateCancelled to outlet LegalCaseEventSplitToAttorneyWorkload
        send courtDateCancelled to outlet LegalCaseEventSplitToBillingProjection
        tell courtDateCancelled to entity CaseContext.LegalCase
      }
      on noteAdded: event LegalCase.NoteAdded is {
        send noteAdded to outlet LegalCaseEventSplitToCaseDashboard
        send noteAdded to outlet LegalCaseEventSplitToAttorneyWorkload
        send noteAdded to outlet LegalCaseEventSplitToBillingProjection
        tell noteAdded to entity CaseContext.LegalCase
      }
      on caseStatusUpdated: event LegalCase.CaseStatusUpdated is {
        send caseStatusUpdated to outlet LegalCaseEventSplitToCaseDashboard
        send caseStatusUpdated to outlet LegalCaseEventSplitToAttorneyWorkload
        send caseStatusUpdated to outlet LegalCaseEventSplitToBillingProjection
        tell caseStatusUpdated to entity CaseContext.LegalCase
      }
      on casePrioritySet: event LegalCase.CasePrioritySet is {
        send casePrioritySet to outlet LegalCaseEventSplitToCaseDashboard
        send casePrioritySet to outlet LegalCaseEventSplitToAttorneyWorkload
        send casePrioritySet to outlet LegalCaseEventSplitToBillingProjection
        tell casePrioritySet to entity CaseContext.LegalCase
      }
      on casePlacedOnHold: event LegalCase.CasePlacedOnHold is {
        send casePlacedOnHold to outlet LegalCaseEventSplitToCaseDashboard
        send casePlacedOnHold to outlet LegalCaseEventSplitToAttorneyWorkload
        send casePlacedOnHold to outlet LegalCaseEventSplitToBillingProjection
        tell casePlacedOnHold to entity CaseContext.LegalCase
      }
      on caseReactivated: event LegalCase.CaseReactivated is {
        send caseReactivated to outlet LegalCaseEventSplitToCaseDashboard
        send caseReactivated to outlet LegalCaseEventSplitToAttorneyWorkload
        send caseReactivated to outlet LegalCaseEventSplitToBillingProjection
        tell caseReactivated to entity CaseContext.LegalCase
      }
      on caseClosed: event LegalCase.CaseClosed is {
        send caseClosed to outlet LegalCaseEventSplitToCaseDashboard
        send caseClosed to outlet LegalCaseEventSplitToAttorneyWorkload
        send caseClosed to outlet LegalCaseEventSplitToBillingProjection
        tell caseClosed to entity CaseContext.LegalCase
      }
      on caseArchived: event LegalCase.CaseArchived is {
        send caseArchived to outlet LegalCaseEventSplitToCaseDashboard
        send caseArchived to outlet LegalCaseEventSplitToAttorneyWorkload
        send caseArchived to outlet LegalCaseEventSplitToBillingProjection
        tell caseArchived to entity CaseContext.LegalCase
      }
      on other is {
        error "Unexpected message for processor LegalCaseEventSplit"
      }
    } with {
      briefly "LegalCase event fan-out handler"
      described as {
        |Delivers each LegalCase event to all of its consumers.
      }
    }
  } with {
    briefly "LegalCase event fan-out"
    described as {
      |Fans LegalCase events out to the repository and projectors.
    }
  }
  connector 'LegalCaseEvent Stream' is from outlet CaseContext.LegalCase.LegalCaseEvents2 to inlet CaseContext.LegalCaseEventSplit.LegalCaseEventSplitIn with {
    briefly "LegalCase events, fanned out to storage and read models"
  }
  connector 'CaseDashboard Feed' is from outlet CaseContext.LegalCaseEventSplit.LegalCaseEventSplitToCaseDashboard to inlet CaseContext.CaseDashboard.CaseDashboardFromLegalCase with {
    briefly "LegalCase events feeding the CaseDashboard projection"
  }
  connector 'AttorneyWorkload Feed' is from outlet CaseContext.LegalCaseEventSplit.LegalCaseEventSplitToAttorneyWorkload to inlet CaseContext.AttorneyWorkload.AttorneyWorkloadFromLegalCase with {
    briefly "LegalCase events feeding the AttorneyWorkload projection"
  }
  connector 'BillingProjection Feed' is from outlet CaseContext.LegalCaseEventSplit.LegalCaseEventSplitToBillingProjection to inlet CaseContext.BillingProjection.BillingProjectionFromLegalCase with {
    briefly "LegalCase events feeding the BillingProjection projection"
  }
  connector 'CaseDashboard Storage' is from outlet CaseContext.CaseDashboard.CaseDashboardToRepository to inlet CaseContext.CaseRepository.CaseRepositoryFromCaseDashboard with {
    briefly "CaseDashboard updates on their way to storage"
  }
} with {
  briefly "Case management bounded context"
  described as {
    | The CaseContext is the core bounded context for legal case management.
    | It contains the LegalCase entity, the CaseRepository for persistence,
    | and projectors for dashboard views, attorney workload tracking, and
    | billing summaries.
  }
}
