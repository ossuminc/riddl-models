// Case Management Domain Model
// Legal services case lifecycle management
author OssumInc is {
  name = "Ossum Inc."
  email = "support@ossuminc.com"
} with {
  briefly "The author of this domain model"
  described as {
    |Ossum Inc. provides enterprise software solutions and RIDDL modeling services.
  }
}
domain CaseManagement is {
  persistent connector 'BillingSystemEvent Stream' is from outlet BillingSystem.BillingSystemEventsOut to inlet CaseContext.FromBillingSystem.FromBillingSystemIn with {
    briefly "What BillingSystem tells CaseContext, unasked"
  }
  persistent connector 'CalendarSystemEvent Stream' is from outlet CalendarSystem.CalendarSystemEventsOut to inlet CaseContext.FromCalendarSystem.FromCalendarSystemIn with {
    briefly "What CalendarSystem tells CaseContext, unasked"
  }
  persistent connector 'ClientPortalEvent Stream' is from outlet ClientPortal.ClientPortalEventsOut to inlet CaseContext.FromClientPortal.FromClientPortalIn with {
    briefly "What ClientPortal tells CaseContext, unasked"
  }
  persistent connector 'ConflictDatabaseEvent Stream' is from outlet ConflictDatabase.ConflictDatabaseEventsOut to inlet CaseContext.FromConflictDatabase.FromConflictDatabaseIn with {
    briefly "What ConflictDatabase tells CaseContext, unasked"
  }
  persistent connector 'DocumentManagementEvent Stream' is from outlet DocumentManagement.DocumentManagementEventsOut to inlet CaseContext.FromDocumentManagement.FromDocumentManagementIn with {
    briefly "What DocumentManagement tells CaseContext, unasked"
  }
  user Attorney is "A licensed attorney who handles legal cases" with {
    briefly "Legal professional managing cases"
    described as {
      |A licensed attorney who handles legal cases
    }
  }
  user ParalegalUser is "A paralegal who assists attorneys with case preparation" with {
    briefly "Legal support staff"
    described as {
      |A paralegal who assists attorneys with case preparation
    }
  }
  user Client is "A person or organization receiving legal services" with {
    briefly "Consumer of legal services"
    described as {
      |A person or organization receiving legal services
    }
  }
  user CaseManager is "Administrative staff coordinating case workflows" with {
    briefly "Case workflow coordinator"
    described as {
      |Administrative staff coordinating case workflows
    }
  }
  epic ManageLegalCase is {
    user Attorney wants to "to manage the complete lifecycle of legal cases" so that "clients receive effective legal representation"
    case HappyPath is {
      user Attorney wants to "to complete standard case management workflow" so that "cases are managed efficiently"
      step is "Attorney creates" "a new legal case" "for a client" with {
        briefly "Initiate case"
        described as {
          |Create case.
        }
      }
      step is "Attorney assigns" "attorneys and paralegals" "to the case" with {
        briefly "Staff case"
        described as {
          |Assign team.
        }
      }
      step is "Attorney records" "billable time" "and expenses" with {
        briefly "Track billing"
        described as {
          |Record time.
        }
      }
      step is "Attorney uploads" "case documents" "and evidence" with {
        briefly "Manage documents"
        described as {
          |Upload docs.
        }
      }
      step is "Attorney tracks" "court dates" "and deadlines" with {
        briefly "Monitor calendar"
        described as {
          |Track dates.
        }
      }
      step is "Attorney updates" "case status" "as it progresses" with {
        briefly "Update status"
        described as {
          |Change status.
        }
      }
      step is "Attorney closes" "the case" "upon resolution" with {
        briefly "Close case"
        described as {
          |Resolve case.
        }
      }
    } with {
      briefly "Standard case management workflow"
      described as {
        |The typical flow of managing a legal case from intake to resolution.
      }
    }
  } with {
    briefly "Manage legal cases through their lifecycle"
    described as {
      | This epic covers the complete case management workflow including
      | case creation, staffing, time tracking, document management,
      | calendar management, and case closure.
    }
  }
  include "CaseContext.riddl"
  include "external-contexts.riddl"
  application context CaseManagementApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CaseManagement are delivered.
      }
    }
    group CaseManagementScreen is {
      input SearchCasesInput acquires query CaseContext.CaseRepository.SearchCases with {
        briefly "Search cases control"
        described as {
          |The control through which a user asks the search cases question.
        }
      }
      input FindCasesByStatusInput acquires query CaseContext.CaseRepository.FindCasesByStatus with {
        briefly "Find cases by status control"
        described as {
          |The control through which a user asks the find cases by status question.
        }
      }
      input FindCasesByAttorneyInput acquires query CaseContext.CaseRepository.FindCasesByAttorney with {
        briefly "Find cases by attorney control"
        described as {
          |The control through which a user asks the find cases by attorney question.
        }
      }
      input FindCasesByClientInput acquires query CaseContext.CaseRepository.FindCasesByClient with {
        briefly "Find cases by client control"
        described as {
          |The control through which a user asks the find cases by client question.
        }
      }
      input FindCaseByIdInput acquires query CaseContext.CaseRepository.FindCaseById with {
        briefly "Find case by id control"
        described as {
          |The control through which a user asks the find case by id question.
        }
      }
      input GetBillingDataInput acquires query CaseContext.GetBillingData with {
        briefly "Get billing data control"
        described as {
          |The control through which a user asks the get billing data question.
        }
      }
      input GetAttorneyWorkloadDataInput acquires query CaseContext.GetAttorneyWorkloadData with {
        briefly "Get attorney workload data control"
        described as {
          |The control through which a user asks the get attorney workload data question.
        }
      }
      input GetCaseDashboardDataInput acquires query CaseContext.GetCaseDashboardData with {
        briefly "Get case dashboard data control"
        described as {
          |The control through which a user asks the get case dashboard data question.
        }
      }
      input CreateCaseInput acquires command CaseContext.CreateCase with {
        briefly "Create case control"
        described as {
          |The control through which a user submits the create case request.
        }
      }
      input AddDocumentInput acquires command CaseContext.LegalCase.AddDocument with {
        briefly "Add document control"
        described as {
          |The control through which a user submits the add document request.
        }
      }
      input AddNoteInput acquires command CaseContext.LegalCase.AddNote with {
        briefly "Add note control"
        described as {
          |The control through which a user submits the add note request.
        }
      }
      input ArchiveCaseInput acquires command CaseContext.LegalCase.ArchiveCase with {
        briefly "Archive case control"
        described as {
          |The control through which a user submits the archive case request.
        }
      }
      input AssignTeamMemberInput acquires command CaseContext.LegalCase.AssignTeamMember with {
        briefly "Assign team member control"
        described as {
          |The control through which a user submits the assign team member request.
        }
      }
      input CancelCourtDateInput acquires command CaseContext.LegalCase.CancelCourtDate with {
        briefly "Cancel court date control"
        described as {
          |The control through which a user submits the cancel court date request.
        }
      }
      input CloseCaseInput acquires command CaseContext.LegalCase.CloseCase with {
        briefly "Close case control"
        described as {
          |The control through which a user submits the close case request.
        }
      }
      input PlaceCaseOnHoldInput acquires command CaseContext.LegalCase.PlaceCaseOnHold with {
        briefly "Place case on hold control"
        described as {
          |The control through which a user submits the place case on hold request.
        }
      }
      input ReactivateCaseInput acquires command CaseContext.LegalCase.ReactivateCase with {
        briefly "Reactivate case control"
        described as {
          |The control through which a user submits the reactivate case request.
        }
      }
      input RecordClientPaymentInput acquires command CaseContext.LegalCase.RecordClientPayment with {
        briefly "Record client payment control"
        described as {
          |The control through which a user submits the record client payment request.
        }
      }
      input RecordConflictWaiverObtainedInput acquires command CaseContext.LegalCase.RecordConflictWaiverObtained with {
        briefly "Record conflict waiver obtained control"
        described as {
          |The control through which a user submits the record conflict waiver obtained request.
        }
      }
      input RecordExpenseInput acquires command CaseContext.LegalCase.RecordExpense with {
        briefly "Record expense control"
        described as {
          |The control through which a user submits the record expense request.
        }
      }
      input RecordTimeEntryInput acquires command CaseContext.LegalCase.RecordTimeEntry with {
        briefly "Record time entry control"
        described as {
          |The control through which a user submits the record time entry request.
        }
      }
      input RemoveTeamMemberInput acquires command CaseContext.LegalCase.RemoveTeamMember with {
        briefly "Remove team member control"
        described as {
          |The control through which a user submits the remove team member request.
        }
      }
      input ScheduleCourtDateInput acquires command CaseContext.LegalCase.ScheduleCourtDate with {
        briefly "Schedule court date control"
        described as {
          |The control through which a user submits the schedule court date request.
        }
      }
      input SetCasePriorityInput acquires command CaseContext.LegalCase.SetCasePriority with {
        briefly "Set case priority control"
        described as {
          |The control through which a user submits the set case priority request.
        }
      }
      input UpdateCaseStatusInput acquires command CaseContext.LegalCase.UpdateCaseStatus with {
        briefly "Update case status control"
        described as {
          |The control through which a user submits the update case status request.
        }
      }
    } with {
      briefly "Case management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppCaseRepositoryQueries is type CaseContext.CaseRepository.CaseRepositoryQuery
    inlet AppCaseRepositoryReplies is type CaseContext.CaseRepository.CaseRepositoryReply
    outlet AppLegalCaseCommands is type CaseContext.LegalCaseRequest
    inlet AppCaseRepositoryResponses is result CaseContext.CaseRepository.CaseResult
    handler CaseManagementAppHandler is {
      on other is {
        error "Unexpected message for application context CaseManagementApp"
      }
    } with {
      briefly "CaseManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CaseManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ConflictDatabaseRequest Stream' is from outlet CaseContext.ToConflictDatabase.ToConflictDatabaseOut to inlet ConflictDatabase.ConflictDatabaseRequests with {
    briefly "What CaseContext asks ConflictDatabase to send"
  }
  persistent connector 'DocumentManagementRequest Stream' is from outlet CaseContext.ToDocumentManagement.ToDocumentManagementOut to inlet DocumentManagement.DocumentManagementRequests with {
    briefly "What CaseContext asks DocumentManagement to send"
  }
  persistent connector 'CalendarSystemRequest Stream' is from outlet CaseContext.ToCalendarSystem.ToCalendarSystemOut to inlet CalendarSystem.CalendarSystemRequests with {
    briefly "What CaseContext asks CalendarSystem to send"
  }
  persistent connector 'ClientPortalRequest Stream' is from outlet CaseContext.ToClientPortal.ToClientPortalOut to inlet ClientPortal.ClientPortalRequests with {
    briefly "What CaseContext asks ClientPortal to send"
  }
  persistent connector 'BillingSystemRequest Stream' is from outlet CaseContext.ToBillingSystem.ToBillingSystemOut to inlet BillingSystem.BillingSystemRequests with {
    briefly "What CaseContext asks BillingSystem to send"
  }
  persistent connector 'CaseRepositoryQuery Stream' is from outlet CaseManagementApp.AppCaseRepositoryQueries to inlet CaseContext.CaseRepositoryQueriesIn with {
    briefly "CaseManagementApp's look-ups of the case repository"
  }
  persistent connector 'CaseRepositoryReply Stream' is from outlet CaseContext.CaseRepositoryRepliesOut to inlet CaseManagementApp.AppCaseRepositoryReplies with {
    briefly "The case repository's answers returned to CaseManagementApp"
  }
  persistent connector 'LegalCaseCommand Stream' is from outlet CaseManagementApp.AppLegalCaseCommands to inlet CaseContext.LegalCaseCommandStreamIn with {
    briefly "LegalCase commands from the application"
  }
  persistent connector 'CaseQueryResult Stream' is from outlet CaseContext.CaseQueryResultStreamOut to inlet CaseManagementApp.AppCaseRepositoryResponses with {
    briefly "Case query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CaseManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  by author OssumInc
  briefly "Legal case management domain"
  described as {
    | The Case Management domain handles the complete lifecycle of legal cases
    | in a law firm or legal department. It supports case intake, attorney
    | assignment, time and expense tracking, document management, court
    | calendar management, and case resolution workflows.
  }
}
