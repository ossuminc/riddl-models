// Case Management Domain Model
// Legal services case lifecycle management
author OssumInc is {
  name = "Ossum Inc."
  email = "support@ossuminc.com"
} with {
  briefly "The author of this domain model"
  described as {
    |Ossum Inc. provides enterprise software solutions and RIDDL modeling services.
  }
}
domain CaseManagement is {
  user Attorney is "A licensed attorney who handles legal cases" with {
    briefly "Legal professional managing cases"
    described as {
      |A licensed attorney who handles legal cases
    }
  }
  user ParalegalUser is "A paralegal who assists attorneys with case preparation" with {
    briefly "Legal support staff"
    described as {
      |A paralegal who assists attorneys with case preparation
    }
  }
  user Client is "A person or organization receiving legal services" with {
    briefly "Consumer of legal services"
    described as {
      |A person or organization receiving legal services
    }
  }
  user CaseManager is "Administrative staff coordinating case workflows" with {
    briefly "Case workflow coordinator"
    described as {
      |Administrative staff coordinating case workflows
    }
  }
  epic ManageLegalCase is {
    user Attorney wants to "to manage the complete lifecycle of legal cases" so that "clients receive effective legal representation"
    case HappyPath is {
      user Attorney wants to "to complete standard case management workflow" so that "cases are managed efficiently"
      step is "Attorney creates" "a new legal case" "for a client" with {
        briefly "Initiate case"
        described as {
          |Create case.
        }
      }
      step is "Attorney assigns" "attorneys and paralegals" "to the case" with {
        briefly "Staff case"
        described as {
          |Assign team.
        }
      }
      step is "Attorney records" "billable time" "and expenses" with {
        briefly "Track billing"
        described as {
          |Record time.
        }
      }
      step is "Attorney uploads" "case documents" "and evidence" with {
        briefly "Manage documents"
        described as {
          |Upload docs.
        }
      }
      step is "Attorney tracks" "court dates" "and deadlines" with {
        briefly "Monitor calendar"
        described as {
          |Track dates.
        }
      }
      step is "Attorney updates" "case status" "as it progresses" with {
        briefly "Update status"
        described as {
          |Change status.
        }
      }
      step is "Attorney closes" "the case" "upon resolution" with {
        briefly "Close case"
        described as {
          |Resolve case.
        }
      }
    } with {
      briefly "Standard case management workflow"
      described as {
        |The typical flow of managing a legal case from intake to resolution.
      }
    }
  } with {
    briefly "Manage legal cases through their lifecycle"
    described as {
      | This epic covers the complete case management workflow including
      | case creation, staffing, time tracking, document management,
      | calendar management, and case closure.
    }
  }
  include "CaseContext.riddl"
  include "external-contexts.riddl"
  application context CaseManagementApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CaseManagement are delivered.
      }
    }
    outlet AppLegalCaseCommands is type CaseContext.LegalCase.LegalCaseCommand
    inlet AppCaseRepositoryResponses is type CaseContext.CaseRepository.CaseResult    handler CaseManagementAppHandler is {
      on other is {
        error "Unexpected message for application context CaseManagementApp"
      }
    } with {
      briefly "CaseManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CaseManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'LegalCaseCommand Stream' is from outlet CaseManagementApp.AppLegalCaseCommands to inlet CaseContext.LegalCase.LegalCaseCommands with {
    briefly "LegalCase commands from the application"
  }
  persistent connector 'CaseQueryResult Stream' is from outlet CaseContext.CaseRepository.CaseRepositoryResponses to inlet CaseManagementApp.AppCaseRepositoryResponses with {
    briefly "Case query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CaseManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  by author OssumInc
  briefly "Legal case management domain"
  described as {
    | The Case Management domain handles the complete lifecycle of legal cases
    | in a law firm or legal department. It supports case intake, attorney
    | assignment, time and expense tracking, document management, court
    | calendar management, and case resolution workflows.
  }
}
