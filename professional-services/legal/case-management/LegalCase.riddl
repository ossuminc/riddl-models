// Legal Case Entity
aggregate event-sourced entity LegalCase as flow is {
  type LegalCaseCommand is one of {
    LegalCase.CreateCase or LegalCase.AssignTeamMember or LegalCase.RemoveTeamMember or LegalCase.RecordTimeEntry or LegalCase.RecordExpense or LegalCase.AddDocument or LegalCase.ScheduleCourtDate or LegalCase.CancelCourtDate or LegalCase.AddNote or LegalCase.UpdateCaseStatus or LegalCase.SetCasePriority or LegalCase.PlaceCaseOnHold or LegalCase.ReactivateCase or LegalCase.CloseCase or LegalCase.ArchiveCase
  } with {
    briefly "LegalCase command alternation"
    described as {
      |Commands accepted by the LegalCase entity.
    }
  }
  inlet LegalCaseCommands is type LegalCaseCommand  outlet LegalCaseEvents2 is type LegalCaseEvent
  query GetLegalCase is  {
    legalCaseId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the LegalCase to retrieve.
      }
    }
  } with {
    briefly "Get LegalCase"
    described as {
      |Retrieve LegalCase data by identifier.
    }
  }
  result LegalCaseResult is  {
    legalCaseData: LegalCase.IntakeStateData with {
      briefly "LegalCase data"
      described as {
        |The requested LegalCase data.
      }
    }
  } with {
    briefly "LegalCase result"
    described as {
      |Result carrying the requested LegalCase data.
    }
  }
  // Commands
  command CreateCase yields event CaseCreated is  {
    caseId: CaseId
    matterId: MatterId
    title: String
    clientInfo: ClientInfo
    practiceArea: PracticeArea
    billingType: BillingType
    description: String
  } with {
    briefly "Create a new legal case"
    described as {
      |Initiates a new legal case with client information and initial details.
    }
  }
  command AssignTeamMember yields event TeamMemberAssigned is  {
    caseId: CaseId
    member: TeamMember
  } with {
    briefly "Assign attorney or paralegal to case"
    described as {
      |Adds a team member to work on the case with their role and billing rate.
    }
  }
  command RemoveTeamMember yields event TeamMemberRemoved is  {
    caseId: CaseId
    memberId: AttorneyId
  } with {
    briefly "Remove team member from case"
    described as {
      |Removes an attorney or paralegal from the case team.
    }
  }
  command RecordTimeEntry yields event TimeEntryRecorded is  {
    caseId: CaseId
    timeEntry: TimeEntry
  } with {
    briefly "Record billable time"
    described as {
      |Logs time spent working on the case for billing purposes.
    }
  }
  command RecordExpense yields event ExpenseRecorded is  {
    caseId: CaseId
    expense: Expense
  } with {
    briefly "Record case expense"
    described as {
      |Logs an expense incurred for the case.
    }
  }
  command AddDocument yields event DocumentAdded is  {
    caseId: CaseId
    document: CaseDocument
  } with {
    briefly "Add document to case file"
    described as {
      |Uploads a new document to the case file.
    }
  }
  command ScheduleCourtDate yields event CourtDateScheduled is  {
    caseId: CaseId
    courtDate: CourtDate
  } with {
    briefly "Schedule court appearance or deadline"
    described as {
      |Adds a court date or deadline to the case calendar.
    }
  }
  command CancelCourtDate yields event CourtDateCancelled is  {
    caseId: CaseId
    dateId: UUID 
  } with {
    briefly "Cancel scheduled court date"
    described as {
      |Removes a court date from the case calendar.
    }
  }
  command AddNote yields event NoteAdded is  {
    caseId: CaseId
    note: CaseNote
  } with {
    briefly "Add note to case"
    described as {
      |Records an internal note or observation on the case.
    }
  }
  command UpdateCaseStatus yields event CaseStatusUpdated is  {
    caseId: CaseId
    newStatus: CaseStatus
    reason: String
  } with {
    briefly "Update case status"
    described as {
      |Changes the case status as it progresses through its lifecycle.
    }
  }
  command SetCasePriority yields event CasePrioritySet is  {
    caseId: CaseId
    priority: CasePriority
  } with {
    briefly "Set case priority"
    described as {
      |Adjusts the priority level of the case.
    }
  }
  command PlaceCaseOnHold yields event CasePlacedOnHold is  {
    caseId: CaseId
    reason: String
  } with {
    briefly "Place case on hold"
    described as {
      |Suspends active work on the case temporarily.
    }
  }
  command ReactivateCase yields event CaseReactivated is  {
    caseId: CaseId
    reason: String
  } with {
    briefly "Reactivate held case"
    described as {
      |Resumes work on a case that was on hold.
    }
  }
  command CloseCase yields event CaseClosed is  {
    caseId: CaseId
    resolution: CaseResolution
    closingNotes: String
  } with {
    briefly "Close the case"
    described as {
      |Marks the case as closed with its resolution outcome.
    }
  }
  command ArchiveCase yields event CaseArchived is  { caseId: CaseId } with {
    briefly "Archive closed case"
    described as {
      |Moves a closed case to long-term archive storage.
    }
  }
  // Types local to this entity
  type CaseResolution is any of {
    Settled,
    WonAtTrial,
    LostAtTrial,
    Dismissed,
    Withdrawn,
    TransferredOut,
    Other
  } with {
    briefly "Outcome of the case"
    described as {
      |Records how the case was ultimately resolved.
    }
  }
  // Events
  event CaseCreated is  {
    caseId: CaseId
    matterId: MatterId
    title: String
    clientInfo: ClientInfo
    practiceArea: PracticeArea
    billingType: BillingType
    description: String
    createdAt: DateTime
  } with {
    briefly "New case created"
    described as {
      |Indicates a new legal case has been opened in the system.
    }
  }
  event TeamMemberAssigned is  {
    caseId: CaseId
    member: TeamMember
  } with {
    briefly "Team member assigned to case"
    described as {
      |Records assignment of an attorney or paralegal to the case.
    }
  }
  event TeamMemberRemoved is  {
    caseId: CaseId
    memberId: AttorneyId
    removedAt: DateTime
  } with {
    briefly "Team member removed from case"
    described as {
      |Records removal of a team member from the case.
    }
  }
  event TimeEntryRecorded is  {
    caseId: CaseId
    timeEntry: TimeEntry
  } with {
    briefly "Time entry logged"
    described as {
      |Records billable time added to the case.
    }
  }
  event ExpenseRecorded is  {
    caseId: CaseId
    expense: Expense
  } with {
    briefly "Expense logged"
    described as {
      |Records an expense added to the case.
    }
  }
  event DocumentAdded is  {
    caseId: CaseId
    document: CaseDocument
  } with {
    briefly "Document added to case"
    described as {
      |Records a new document uploaded to the case file.
    }
  }
  event CourtDateScheduled is  {
    caseId: CaseId
    courtDate: CourtDate
  } with {
    briefly "Court date scheduled"
    described as {
      |Records a new court date added to the calendar.
    }
  }
  event CourtDateCancelled is  {
    caseId: CaseId
    dateId: UUID 
    cancelledAt: DateTime
  } with {
    briefly "Court date cancelled"
    described as {
      |Records removal of a court date from the calendar.
    }
  }
  event NoteAdded is  {
    caseId: CaseId
    note: CaseNote
  } with {
    briefly "Note added to case"
    described as {
      |Records a new note added to the case file.
    }
  }
  event CaseStatusUpdated is  {
    caseId: CaseId
    oldStatus: CaseStatus
    newStatus: CaseStatus
    reason: String
    updatedAt: DateTime
  } with {
    briefly "Case status changed"
    described as {
      |Records a change in the case's status.
    }
  }
  event CasePrioritySet is  {
    caseId: CaseId
    oldPriority: CasePriority
    newPriority: CasePriority
  } with {
    briefly "Case priority changed"
    described as {
      |Records a change in the case's priority level.
    }
  }
  event CasePlacedOnHold is  {
    caseId: CaseId
    reason: String
    heldAt: DateTime
  } with {
    briefly "Case placed on hold"
    described as {
      |Records that work on the case has been suspended.
    }
  }
  event CaseReactivated is  {
    caseId: CaseId
    reason: String
    reactivatedAt: DateTime
  } with {
    briefly "Case reactivated"
    described as {
      |Records that work on a held case has resumed.
    }
  }
  event CaseClosed is  {
    caseId: CaseId
    resolution: CaseResolution
    closingNotes: String
    closedAt: DateTime
  } with {
    briefly "Case closed"
    described as {
      |Records that the case has been closed with its resolution.
    }
  }
  event CaseArchived is  {
    caseId: CaseId
    archivedAt: DateTime
  } with {
    briefly "Case archived"
    described as {
      |Records that the case has been moved to archive storage.
    }
  }
  // State data records
  record IntakeStateData is  {
    caseId: CaseId
    createdAt: DateTime
  } with {
    briefly "Data during intake"
    described as {
      |Minimal data captured during initial case creation.
    }
  }
  record ActiveStateData is  {
    caseId: CaseId
    matterId: MatterId
    title: String
    clientInfo: ClientInfo
    practiceArea: PracticeArea
    billingType: BillingType
    description: String
    status: CaseStatus
    priority: CasePriority
    teamMembers: TeamMember*
    timeEntries: TimeEntry*
    expenses: Expense*
    documents: CaseDocument*
    courtDates: CourtDate*
    notes: CaseNote*
    createdAt: DateTime
    lastUpdated: DateTime
  } with {
    briefly "Active case data"
    described as {
      |Complete case data during active work.
    }
  }
  record OnHoldStateData is  {
    caseId: CaseId
    matterId: MatterId
    title: String
    clientInfo: ClientInfo
    practiceArea: PracticeArea
    billingType: BillingType
    description: String
    status: CaseStatus
    priority: CasePriority
    teamMembers: TeamMember*
    timeEntries: TimeEntry*
    expenses: Expense*
    documents: CaseDocument*
    courtDates: CourtDate*
    notes: CaseNote*
    holdReason: String
    heldAt: DateTime
    createdAt: DateTime
    lastUpdated: DateTime
  } with {
    briefly "On-hold case data"
    described as {
      |Case data including hold reason and timestamp.
    }
  }
  record ClosedStateData is  {
    caseId: CaseId
    matterId: MatterId
    title: String
    clientInfo: ClientInfo
    practiceArea: PracticeArea
    billingType: BillingType
    description: String
    status: CaseStatus
    teamMembers: TeamMember*
    timeEntries: TimeEntry*
    expenses: Expense*
    documents: CaseDocument*
    courtDates: CourtDate*
    notes: CaseNote*
    resolution: CaseResolution
    closingNotes: String
    closedAt: DateTime
    createdAt: DateTime
  } with {
    briefly "Closed case data"
    described as {
      |Complete case data including resolution details.
    }
  }
  record ArchivedStateData is  {
    caseId: CaseId
    matterId: MatterId
    title: String
    clientName: String
    practiceArea: PracticeArea
    resolution: CaseResolution
    archivedAt: DateTime
    createdAt: DateTime
    closedAt: DateTime
  } with {
    briefly "Archived case data"
    described as {
      |Minimal case data retained in archive.
    }
  }
  // States
  initial state IntakeState of record LegalCase.IntakeStateData is {
    initial handler IntakeStateInitHandler is {
      on query GetLegalCase is {
        tell result LegalCaseResult to entity CaseContext.LegalCase
      }
      on init is {
        yield event CaseCreated
      }
    } with {
      briefly "IntakeState initialization"
      described as {
        |Initializes IntakeState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Intake state"
    described as {
      |The intake state of the LegalCase entity, carrying IntakeStateData.
    }
  }
  state ActiveState of record LegalCase.ActiveStateData is {
    initial handler ActiveStateInitHandler is {
      on init is {
        yield event CaseReactivated
      }
    } with {
      briefly "ActiveState initialization"
      described as {
        |Initializes ActiveState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |The active state of the LegalCase entity, carrying ActiveStateData.
    }
  }
  state OnHoldState of record LegalCase.OnHoldStateData is {
    initial handler OnHoldStateInitHandler is {
      on init is {
        yield event CasePlacedOnHold
      }
    } with {
      briefly "OnHoldState initialization"
      described as {
        |Initializes OnHoldState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "On hold state"
    described as {
      |The on hold state of the LegalCase entity, carrying OnHoldStateData.
    }
  }
  state ClosedState of record LegalCase.ClosedStateData is {
    initial handler ClosedStateInitHandler is {
      on init is {
        yield event CaseClosed
      }
    } with {
      briefly "ClosedState initialization"
      described as {
        |Initializes ClosedState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Closed state"
    described as {
      |The closed state of the LegalCase entity, carrying ClosedStateData.
    }
  }
  state ArchivedState of record LegalCase.ArchivedStateData is {
    initial handler ArchivedStateInitHandler is {
      on init is {
        yield event CaseArchived
      }
    } with {
      briefly "ArchivedState initialization"
      described as {
        |Initializes ArchivedState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Archived state"
    described as {
      |The archived state of the LegalCase entity, carrying ArchivedStateData.
    }
  }
  // Handler
  handler CaseHandler is {
    on createCase: command CreateCase is {
      yield event CaseCreated(caseId = createCase.caseId, matterId = createCase.matterId, title = createCase.title, clientInfo = createCase.clientInfo, practiceArea = createCase.practiceArea, billingType = createCase.billingType, description = createCase.description)
    }
    on assignTeamMember: command AssignTeamMember is {
      yield event TeamMemberAssigned(caseId = assignTeamMember.caseId, member = assignTeamMember.member)
    }
    on removeTeamMember: command RemoveTeamMember is {
      yield event TeamMemberRemoved(caseId = removeTeamMember.caseId, memberId = removeTeamMember.memberId)
    }
    on recordTimeEntry: command RecordTimeEntry is {
      yield event TimeEntryRecorded(caseId = recordTimeEntry.caseId, timeEntry = recordTimeEntry.timeEntry)
    }
    on recordExpense: command RecordExpense is {
      yield event ExpenseRecorded(caseId = recordExpense.caseId, expense = recordExpense.expense)
    }
    on addDocument: command AddDocument is {
      yield event DocumentAdded(caseId = addDocument.caseId, document = addDocument.document)
    }
    on scheduleCourtDate: command ScheduleCourtDate is {
      yield event CourtDateScheduled(caseId = scheduleCourtDate.caseId, courtDate = scheduleCourtDate.courtDate)
    }
    on cancelCourtDate: command CancelCourtDate is {
      yield event CourtDateCancelled(caseId = cancelCourtDate.caseId, dateId = cancelCourtDate.dateId)
    }
    on addNote: command AddNote is {
      yield event NoteAdded(caseId = addNote.caseId, note = addNote.note)
    }
    on updateCaseStatus: command UpdateCaseStatus is {
      yield event CaseStatusUpdated(caseId = updateCaseStatus.caseId, newStatus = updateCaseStatus.newStatus, reason = updateCaseStatus.reason)
    }
    on setCasePriority: command SetCasePriority is {
      yield event CasePrioritySet(caseId = setCasePriority.caseId)
    }
    on placeCaseOnHold: command PlaceCaseOnHold is {
      yield event CasePlacedOnHold(caseId = placeCaseOnHold.caseId, reason = placeCaseOnHold.reason)
    }
    on reactivateCase: command ReactivateCase is {
      yield event CaseReactivated(caseId = reactivateCase.caseId, reason = reactivateCase.reason)
    }
    on closeCase: command CloseCase is {
      yield event CaseClosed(caseId = closeCase.caseId, resolution = closeCase.resolution, closingNotes = closeCase.closingNotes)
    }
    on command ArchiveCase is {
      yield event CaseArchived
    }
    on caseCreated: event CaseCreated is {
      morph entity CaseContext.LegalCase to state CaseContext.LegalCase.ActiveState with record LegalCase.ActiveStateData(caseId = caseCreated.caseId, matterId = caseCreated.matterId, title = caseCreated.title, clientInfo = caseCreated.clientInfo, practiceArea = caseCreated.practiceArea, billingType = caseCreated.billingType, description = caseCreated.description, createdAt = caseCreated.createdAt)
      set state ActiveState to "initialize LegalCase.ActiveStateData fields from the creating message"
    }
    on event TeamMemberAssigned is {
      do "apply TeamMemberAssigned to the current state"
    }
    on event TeamMemberRemoved is {
      do "apply TeamMemberRemoved to the current state"
    }
    on event TimeEntryRecorded is {
      do "apply TimeEntryRecorded to the current state"
    }
    on event ExpenseRecorded is {
      do "apply ExpenseRecorded to the current state"
    }
    on event DocumentAdded is {
      do "apply DocumentAdded to the current state"
    }
    on event CourtDateScheduled is {
      do "apply CourtDateScheduled to the current state"
    }
    on event CourtDateCancelled is {
      do "apply CourtDateCancelled to the current state"
    }
    on event NoteAdded is {
      do "apply NoteAdded to the current state"
    }
    on event CaseStatusUpdated is {
      do "apply CaseStatusUpdated to the current state"
    }
    on event CasePrioritySet is {
      do "apply CasePrioritySet to the current state"
    }
    on casePlacedOnHold: event CasePlacedOnHold is {
      morph entity CaseContext.LegalCase to state CaseContext.LegalCase.OnHoldState with record LegalCase.OnHoldStateData(caseId = casePlacedOnHold.caseId, heldAt = casePlacedOnHold.heldAt)
      set state OnHoldState to "initialize LegalCase.OnHoldStateData fields from the creating message"
    }
    on caseReactivated: event CaseReactivated is {
      morph entity CaseContext.LegalCase to state CaseContext.LegalCase.ActiveState with record LegalCase.ActiveStateData(caseId = caseReactivated.caseId)
      set state ActiveState to "initialize LegalCase.ActiveStateData fields from the creating message"
    }
    on caseClosed: event CaseClosed is {
      morph entity CaseContext.LegalCase to state CaseContext.LegalCase.ClosedState with record LegalCase.ClosedStateData(caseId = caseClosed.caseId, resolution = caseClosed.resolution, closingNotes = caseClosed.closingNotes, closedAt = caseClosed.closedAt)
      set state ClosedState to "initialize LegalCase.ClosedStateData fields from the creating message"
    }
    on caseArchived: event CaseArchived is {
      morph entity CaseContext.LegalCase to state CaseContext.LegalCase.ArchivedState with record LegalCase.ArchivedStateData(caseId = caseArchived.caseId, archivedAt = caseArchived.archivedAt)
      set state ArchivedState to "initialize LegalCase.ArchivedStateData fields from the creating message"
    }
  } with {
    briefly "Processes case lifecycle commands"
    described as {
      | Handles all case lifecycle commands including creation,
      | team management, billing, documents, and status changes.
    }
  }
} with {
  briefly "Legal case aggregate entity"
  described as {
    | The LegalCase entity represents a single legal matter being handled
    | by the firm. It aggregates all case-related data including team
    | assignments, time entries, expenses, documents, court dates, and
    | notes. The entity progresses through states from intake through
    | active work to closure and archival.
  }
}
