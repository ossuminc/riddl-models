// Benefits Administration - Benefits Context
context BenefitsContext is {
  include "types.riddl"
  include "BenefitsEnrollment.riddl"
  repository BenefitsRepository is {
    inlet BenefitsRepositoryFromBenefitsEnrollment is type BenefitsEnrollmentEvent
    inlet BenefitsRepositoryFromBenefitsMetrics is type BenefitsEnrollmentEvent
    outlet BenefitsRepositoryResponses is type BenefitsEnrollment.BenefitsEnrollmentResult
    schema BenefitsData is relational
      of enrollments as type BenefitsEnrollment
        index on field BenefitsEnrollment.enrollmentId
        index on field BenefitsEnrollment.employeeId
        index on field BenefitsEnrollment.status

    handler BenefitsPersistence is {
      on command BenefitsEnrollment.CreateEnrollment is {
        tell event BenefitsEnrollment.EnrollmentCreated to entity BenefitsContext.BenefitsEnrollment
        do "Store new benefits enrollment"
      }
      on command BenefitsEnrollment.SelectPlan is {
        do "Store plan election"
      }
      on command BenefitsEnrollment.AddDependent is {
        tell event BenefitsEnrollment.DependentAdded to entity BenefitsContext.BenefitsEnrollment
        do "Store added dependent"
      }
      on command BenefitsEnrollment.SubmitEnrollment is {
        tell event BenefitsEnrollment.EnrollmentSubmitted to entity BenefitsContext.BenefitsEnrollment
        do "Update enrollment to submitted"
      }
      on command BenefitsEnrollment.ApproveEnrollment is {
        tell event BenefitsEnrollment.EnrollmentApproved to entity BenefitsContext.BenefitsEnrollment
        do "Update enrollment to approved"
      }
      on command BenefitsEnrollment.TerminateEnrollment is {
        tell event BenefitsEnrollment.EnrollmentTerminated to entity BenefitsContext.BenefitsEnrollment
        do "Update enrollment to terminated"
      }
    } with {
      briefly "Persists benefits commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Benefits data persistence"
    described as {
      |Persistent storage for benefits enrollments.
    }
  }
  projector BenefitsMetrics is {
    inlet BenefitsMetricsFromBenefitsEnrollment is type BenefitsEnrollmentEvent
    outlet BenefitsMetricsOut is type BenefitsEnrollmentEvent
    updates repository BenefitsContext.BenefitsRepository
    record EnrollmentMetrics is  {
      totalEnrollments: Natural with {
        briefly "Total"
        described as {
          |Total enrollments.
        }
      }
      activeEnrollments: Natural with {
        briefly "Active"
        described as {
          |Active enrollments.
        }
      }
      pendingEnrollments: Natural with {
        briefly "Pending"
        described as {
          |Pending enrollments.
        }
      }
      terminatedEnrollments: Natural with {
        briefly "Terminated"
        described as {
          |Terminated enrollments.
        }
      }
      cobraEnrollments: Natural with {
        briefly "COBRA"
        described as {
          |COBRA enrollments.
        }
      }
      lifeEventChanges: Natural with {
        briefly "Life events"
        described as {
          |Life event changes.
        }
      }
    } with {
      briefly "Enrollment metrics"
      described as {
        |Benefits enrollment metrics.
      }
    }
    handler MetricsHandler is {
      on event BenefitsEnrollment.EnrollmentCreated is {
        tell event BenefitsEnrollment.EnrollmentCreated to repository BenefitsContext.BenefitsRepository
        do "Increment total enrollments"
      }
      on event BenefitsEnrollment.EnrollmentApproved is {
        tell event BenefitsEnrollment.EnrollmentApproved to repository BenefitsContext.BenefitsRepository
        do "Increment active enrollments"
      }
      on event BenefitsEnrollment.CobraInitiated is {
        tell event BenefitsEnrollment.CobraInitiated to repository BenefitsContext.BenefitsRepository
        do "Increment COBRA enrollments"
      }
      on event BenefitsEnrollment.LifeEventRecorded is {
        tell event BenefitsEnrollment.LifeEventRecorded to repository BenefitsContext.BenefitsRepository
        do "Increment life event changes"
      }
      on event BenefitsEnrollment.EnrollmentTerminated is {
        tell event BenefitsEnrollment.EnrollmentTerminated to repository BenefitsContext.BenefitsRepository
        do "Increment terminated enrollments"
      }
    } with {
      briefly "Maintains benefits metrics"
      described as {
        |Projects events into enrollment metrics.
      }
    }
  } with {
    briefly "Benefits metrics"
    described as {
      |Benefits enrollment analytics and compliance reporting.
    }
  }
  // ---- Event publication for BenefitsEnrollment ----
  type BenefitsEnrollmentEvent is one of {
    BenefitsContext.BenefitsEnrollment.EnrollmentCreated,
    BenefitsContext.BenefitsEnrollment.PlanSelected,
    BenefitsContext.BenefitsEnrollment.DependentAdded,
    BenefitsContext.BenefitsEnrollment.DependentRemoved,
    BenefitsContext.BenefitsEnrollment.EnrollmentSubmitted,
    BenefitsContext.BenefitsEnrollment.EnrollmentApproved,
    BenefitsContext.BenefitsEnrollment.EnrollmentDenied,
    BenefitsContext.BenefitsEnrollment.LifeEventRecorded,
    BenefitsContext.BenefitsEnrollment.CobraInitiated,
    BenefitsContext.BenefitsEnrollment.EnrollmentTerminated
  } with {
    briefly "BenefitsEnrollment event alternation"
    described as {
      |Union of all BenefitsEnrollment events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BenefitsEnrollmentEventSource as source is {
    outlet BenefitsEnrollmentEvents is type BenefitsEnrollmentEvent
    handler BenefitsEnrollmentSourceHandler is {
      on event BenefitsEnrollment.EnrollmentCreated is {
        send event BenefitsEnrollment.EnrollmentCreated to outlet BenefitsEnrollmentEvents
      }
      on event BenefitsEnrollment.PlanSelected is {
        send event BenefitsEnrollment.PlanSelected to outlet BenefitsEnrollmentEvents
      }
      on event BenefitsEnrollment.DependentAdded is {
        send event BenefitsEnrollment.DependentAdded to outlet BenefitsEnrollmentEvents
      }
      on event BenefitsEnrollment.DependentRemoved is {
        send event BenefitsEnrollment.DependentRemoved to outlet BenefitsEnrollmentEvents
      }
      on event BenefitsEnrollment.EnrollmentSubmitted is {
        send event BenefitsEnrollment.EnrollmentSubmitted to outlet BenefitsEnrollmentEvents
      }
      on event BenefitsEnrollment.EnrollmentApproved is {
        send event BenefitsEnrollment.EnrollmentApproved to outlet BenefitsEnrollmentEvents
      }
      on event BenefitsEnrollment.EnrollmentDenied is {
        send event BenefitsEnrollment.EnrollmentDenied to outlet BenefitsEnrollmentEvents
      }
      on event BenefitsEnrollment.LifeEventRecorded is {
        send event BenefitsEnrollment.LifeEventRecorded to outlet BenefitsEnrollmentEvents
      }
      on event BenefitsEnrollment.CobraInitiated is {
        send event BenefitsEnrollment.CobraInitiated to outlet BenefitsEnrollmentEvents
      }
      on event BenefitsEnrollment.EnrollmentTerminated is {
        send event BenefitsEnrollment.EnrollmentTerminated to outlet BenefitsEnrollmentEvents
      }
      on other is {
        error "Unexpected message for source BenefitsEnrollmentEventSource"
      }
    } with {
      briefly "BenefitsEnrollment source handler"
      described as {
        |Publishes BenefitsEnrollment events onto the outlet.
      }
    }
  } with {
    briefly "BenefitsEnrollment event source"
    described as {
      |Publishes BenefitsEnrollment entity events into the streaming topology.
    }
  }
  processor BenefitsEnrollmentEventSink as sink is {
    inlet BenefitsEnrollmentInlet is type BenefitsEnrollmentEvent
    handler BenefitsEnrollmentSinkHandler is {
      on event BenefitsEnrollment.EnrollmentCreated is {
        tell event BenefitsEnrollment.EnrollmentCreated to repository BenefitsContext.BenefitsRepository
      }
      on event BenefitsEnrollment.PlanSelected is {
        tell event BenefitsEnrollment.PlanSelected to repository BenefitsContext.BenefitsRepository
      }
      on event BenefitsEnrollment.DependentAdded is {
        tell event BenefitsEnrollment.DependentAdded to repository BenefitsContext.BenefitsRepository
      }
      on event BenefitsEnrollment.DependentRemoved is {
        tell event BenefitsEnrollment.DependentRemoved to repository BenefitsContext.BenefitsRepository
      }
      on event BenefitsEnrollment.EnrollmentSubmitted is {
        tell event BenefitsEnrollment.EnrollmentSubmitted to repository BenefitsContext.BenefitsRepository
      }
      on event BenefitsEnrollment.EnrollmentApproved is {
        tell event BenefitsEnrollment.EnrollmentApproved to repository BenefitsContext.BenefitsRepository
      }
      on event BenefitsEnrollment.EnrollmentDenied is {
        tell event BenefitsEnrollment.EnrollmentDenied to repository BenefitsContext.BenefitsRepository
      }
      on event BenefitsEnrollment.LifeEventRecorded is {
        tell event BenefitsEnrollment.LifeEventRecorded to repository BenefitsContext.BenefitsRepository
      }
      on event BenefitsEnrollment.CobraInitiated is {
        tell event BenefitsEnrollment.CobraInitiated to repository BenefitsContext.BenefitsRepository
      }
      on event BenefitsEnrollment.EnrollmentTerminated is {
        tell event BenefitsEnrollment.EnrollmentTerminated to repository BenefitsContext.BenefitsRepository
      }
      on other is {
        error "Unexpected message for sink BenefitsEnrollmentEventSink"
      }
    } with {
      briefly "BenefitsEnrollment sink handler"
      described as {
        |Persists BenefitsEnrollment events via the repository.
      }
    }
  } with {
    briefly "BenefitsEnrollment event sink"
    described as {
      |Receives BenefitsEnrollment events for persistence.
    }
  }
  connector BenefitsEnrollmentEventFlow is {
    from outlet BenefitsContext.BenefitsEnrollmentEventSource.BenefitsEnrollmentEvents to
      inlet BenefitsContext.BenefitsEnrollmentEventSink.BenefitsEnrollmentInlet
  } with {
    briefly "BenefitsEnrollment event flow"
    described as {
      |Connects the BenefitsEnrollment source to its sink.
    }
  }
  processor BenefitsEnrollmentEventSplit is {
    inlet BenefitsEnrollmentEventSplitIn is type BenefitsEnrollmentEvent
    outlet BenefitsEnrollmentEventSplitToBenefitsRepository is type BenefitsEnrollmentEvent
    outlet BenefitsEnrollmentEventSplitToBenefitsMetrics is type BenefitsEnrollmentEvent
    handler BenefitsEnrollmentEventSplitHandler is {
      on event BenefitsEnrollment.EnrollmentCreated is {
        send event BenefitsEnrollment.EnrollmentCreated to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send event BenefitsEnrollment.EnrollmentCreated to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell event BenefitsEnrollment.EnrollmentCreated to entity BenefitsContext.BenefitsEnrollment
      }
      on event BenefitsEnrollment.PlanSelected is {
        send event BenefitsEnrollment.PlanSelected to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send event BenefitsEnrollment.PlanSelected to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell event BenefitsEnrollment.PlanSelected to entity BenefitsContext.BenefitsEnrollment
      }
      on event BenefitsEnrollment.DependentAdded is {
        send event BenefitsEnrollment.DependentAdded to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send event BenefitsEnrollment.DependentAdded to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell event BenefitsEnrollment.DependentAdded to entity BenefitsContext.BenefitsEnrollment
      }
      on event BenefitsEnrollment.DependentRemoved is {
        send event BenefitsEnrollment.DependentRemoved to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send event BenefitsEnrollment.DependentRemoved to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell event BenefitsEnrollment.DependentRemoved to entity BenefitsContext.BenefitsEnrollment
      }
      on event BenefitsEnrollment.EnrollmentSubmitted is {
        send event BenefitsEnrollment.EnrollmentSubmitted to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send event BenefitsEnrollment.EnrollmentSubmitted to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell event BenefitsEnrollment.EnrollmentSubmitted to entity BenefitsContext.BenefitsEnrollment
      }
      on event BenefitsEnrollment.EnrollmentApproved is {
        send event BenefitsEnrollment.EnrollmentApproved to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send event BenefitsEnrollment.EnrollmentApproved to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell event BenefitsEnrollment.EnrollmentApproved to entity BenefitsContext.BenefitsEnrollment
      }
      on event BenefitsEnrollment.EnrollmentDenied is {
        send event BenefitsEnrollment.EnrollmentDenied to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send event BenefitsEnrollment.EnrollmentDenied to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell event BenefitsEnrollment.EnrollmentDenied to entity BenefitsContext.BenefitsEnrollment
      }
      on event BenefitsEnrollment.LifeEventRecorded is {
        send event BenefitsEnrollment.LifeEventRecorded to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send event BenefitsEnrollment.LifeEventRecorded to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell event BenefitsEnrollment.LifeEventRecorded to entity BenefitsContext.BenefitsEnrollment
      }
      on event BenefitsEnrollment.CobraInitiated is {
        send event BenefitsEnrollment.CobraInitiated to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send event BenefitsEnrollment.CobraInitiated to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell event BenefitsEnrollment.CobraInitiated to entity BenefitsContext.BenefitsEnrollment
      }
      on event BenefitsEnrollment.EnrollmentTerminated is {
        send event BenefitsEnrollment.EnrollmentTerminated to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send event BenefitsEnrollment.EnrollmentTerminated to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell event BenefitsEnrollment.EnrollmentTerminated to entity BenefitsContext.BenefitsEnrollment
      }
      on other is {
        error "Unexpected message for processor BenefitsEnrollmentEventSplit"
      }
    } with {
      briefly "BenefitsEnrollment event fan-out handler"
      described as {
        |Delivers each BenefitsEnrollment event to all of its consumers.
      }
    }
  } with {
    briefly "BenefitsEnrollment event fan-out"
    described as {
      |Fans BenefitsEnrollment events out to the repository and projectors.
    }
  }
  connector LinkBenefitsEnrollmentToBenefitsEnrollmentEventSplit is {
    from outlet BenefitsContext.BenefitsEnrollment.BenefitsEnrollmentEvents2 to
      inlet BenefitsContext.BenefitsEnrollmentEventSplit.BenefitsEnrollmentEventSplitIn
  } with {
    briefly "LinkBenefitsEnrollmentToBenefitsEnrollmentEventSplit"
  }
  connector LinkBenefitsEnrollmentEventSplitToBenefitsRepository is {
    from outlet BenefitsContext.BenefitsEnrollmentEventSplit.BenefitsEnrollmentEventSplitToBenefitsRepository to
      inlet BenefitsContext.BenefitsRepository.BenefitsRepositoryFromBenefitsEnrollment
  } with {
    briefly "LinkBenefitsEnrollmentEventSplitToBenefitsRepository"
  }
  connector LinkBenefitsEnrollmentEventSplitToBenefitsMetrics is {
    from outlet BenefitsContext.BenefitsEnrollmentEventSplit.BenefitsEnrollmentEventSplitToBenefitsMetrics to
      inlet BenefitsContext.BenefitsMetrics.BenefitsMetricsFromBenefitsEnrollment
  } with {
    briefly "LinkBenefitsEnrollmentEventSplitToBenefitsMetrics"
  }
  connector LinkBenefitsMetricsToBenefitsRepository is {
    from outlet BenefitsContext.BenefitsMetrics.BenefitsMetricsOut to
      inlet BenefitsContext.BenefitsRepository.BenefitsRepositoryFromBenefitsMetrics
  } with {
    briefly "LinkBenefitsMetricsToBenefitsRepository"
  }
} with {
  briefly "Bounded context for benefits administration"
  described as {
    |Benefits enrollment and plan management context.
  }
}
