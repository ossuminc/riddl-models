// Benefits Administration - Benefits Context
context BenefitsContext as router is {
  inlet BenefitsEnrollmentCommandStrIn is type BenefitsEnrollmentCommand  outlet BenefitsEnrollmentCommandStrOut is type BenefitsEnrollmentCommand
  inlet BenefitsEnrollmentResultStreIn is result BenefitsEnrollment.BenefitsEnrollmentResult  outlet BenefitsEnrollmentResultStreOut is result BenefitsEnrollment.BenefitsEnrollmentResult
  handler BenefitsContextBoundary is {
    on createEnrollment: command BenefitsEnrollment.CreateEnrollment is {
      send createEnrollment to outlet BenefitsContext.BenefitsEnrollmentCommandStrOut
    }
    on selectPlan: command BenefitsEnrollment.SelectPlan is {
      send selectPlan to outlet BenefitsContext.BenefitsEnrollmentCommandStrOut
    }
    on addDependent: command BenefitsEnrollment.AddDependent is {
      send addDependent to outlet BenefitsContext.BenefitsEnrollmentCommandStrOut
    }
    on removeDependent: command BenefitsEnrollment.RemoveDependent is {
      send removeDependent to outlet BenefitsContext.BenefitsEnrollmentCommandStrOut
    }
    on submitEnrollment: command BenefitsEnrollment.SubmitEnrollment is {
      send submitEnrollment to outlet BenefitsContext.BenefitsEnrollmentCommandStrOut
    }
    on approveEnrollment: command BenefitsEnrollment.ApproveEnrollment is {
      send approveEnrollment to outlet BenefitsContext.BenefitsEnrollmentCommandStrOut
    }
    on denyEnrollment: command BenefitsEnrollment.DenyEnrollment is {
      send denyEnrollment to outlet BenefitsContext.BenefitsEnrollmentCommandStrOut
    }
    on recordLifeEvent: command BenefitsEnrollment.RecordLifeEvent is {
      send recordLifeEvent to outlet BenefitsContext.BenefitsEnrollmentCommandStrOut
    }
    on initiateCobra: command BenefitsEnrollment.InitiateCobra is {
      send initiateCobra to outlet BenefitsContext.BenefitsEnrollmentCommandStrOut
    }
    on terminateEnrollment: command BenefitsEnrollment.TerminateEnrollment is {
      send terminateEnrollment to outlet BenefitsContext.BenefitsEnrollmentCommandStrOut
    }
    on benefitsEnrollmentResult: result BenefitsEnrollment.BenefitsEnrollmentResult is {
      send benefitsEnrollmentResult to outlet BenefitsContext.BenefitsEnrollmentResultStreOut
    }
    on other is {
      error "Unexpected message at the BenefitsContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'BenefitsEnrollmentCommand Stream Intake' is from outlet BenefitsContext.BenefitsEnrollmentCommandStrOut to inlet BenefitsContext.BenefitsEnrollment.BenefitsEnrollmentCommands  connector 'BenefitsEnrollmentResult Stream Egress' is from outlet BenefitsContext.BenefitsRepository.BenefitsRepositoryResponses to inlet BenefitsContext.BenefitsEnrollmentResultStreIn  adaptor FromComplianceReportingSystem from context ComplianceReportingSystem is { 
    handler FromComplianceReportingSystemHandler is {
      on event ComplianceReportingSystem.AcaReportGenerated is {
        do "the model receives aca report generated"
      }
      on event ComplianceReportingSystem.CobraNoticeGenerated is {
        do "the model receives cobra notice generated"
      }
      on other is {
        error "Unexpected message for adaptor FromComplianceReportingSystem"
      }
    } with {
      briefly "from compliance reporting system"
      described as {
        |Carries messages from the external ComplianceReportingSystem.
      }
    }
  } with {
    briefly "ComplianceReportingSystem integration"
    described as {
      |The model's side of the ComplianceReportingSystem conversation.
    }
  }
  adaptor ToComplianceReportingSystem to context ComplianceReportingSystem is { 
    handler ToComplianceReportingSystemHandler is {
      on command ComplianceReportingSystem.GenerateAcaReport is {
        do "the model sends generate aca report"
      }
      on command ComplianceReportingSystem.GenerateCobraNotice is {
        do "the model sends generate cobra notice"
      }
      on other is {
        error "Unexpected message for adaptor ToComplianceReportingSystem"
      }
    } with {
      briefly "to compliance reporting system"
      described as {
        |Carries messages to the external ComplianceReportingSystem.
      }
    }
  } with {
    briefly "ComplianceReportingSystem integration"
    described as {
      |The model's side of the ComplianceReportingSystem conversation.
    }
  }
  adaptor FromInsuranceCarrier from context InsuranceCarrier is { 
    handler FromInsuranceCarrierHandler is {
      on event InsuranceCarrier.EnrollmentFileAccepted is {
        do "the model receives enrollment file accepted"
      }
      on event InsuranceCarrier.EnrollmentFileRejected is {
        do "the model receives enrollment file rejected"
      }
      on result InsuranceCarrier.PlanDetails is {
        do "the model receives plan details"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceCarrier"
      }
    } with {
      briefly "from insurance carrier"
      described as {
        |Carries messages from the external InsuranceCarrier.
      }
    }
  } with {
    briefly "InsuranceCarrier integration"
    described as {
      |The model's side of the InsuranceCarrier conversation.
    }
  }
  adaptor ToInsuranceCarrier to context InsuranceCarrier is { 
    handler ToInsuranceCarrierHandler is {
      on query InsuranceCarrier.GetPlanDetails is {
        do "the model sends get plan details"
      }
      on command InsuranceCarrier.SubmitEnrollmentFile is {
        do "the model sends submit enrollment file"
      }
      on other is {
        error "Unexpected message for adaptor ToInsuranceCarrier"
      }
    } with {
      briefly "to insurance carrier"
      described as {
        |Carries messages to the external InsuranceCarrier.
      }
    }
  } with {
    briefly "InsuranceCarrier integration"
    described as {
      |The model's side of the InsuranceCarrier conversation.
    }
  }
  adaptor FromPayrollSystem from context PayrollSystem is { 
    handler FromPayrollSystemHandler is {
      on event PayrollSystem.DeductionsUpdated is {
        do "the model receives deductions updated"
      }
      on result PayrollSystem.EmployeeCompensation is {
        do "the model receives employee compensation"
      }
      on other is {
        error "Unexpected message for adaptor FromPayrollSystem"
      }
    } with {
      briefly "from payroll system"
      described as {
        |Carries messages from the external PayrollSystem.
      }
    }
  } with {
    briefly "PayrollSystem integration"
    described as {
      |The model's side of the PayrollSystem conversation.
    }
  }
  adaptor ToPayrollSystem to context PayrollSystem is { 
    handler ToPayrollSystemHandler is {
      on query PayrollSystem.GetEmployeeCompensation is {
        do "the model sends get employee compensation"
      }
      on command PayrollSystem.UpdateDeductions is {
        do "the model sends update deductions"
      }
      on other is {
        error "Unexpected message for adaptor ToPayrollSystem"
      }
    } with {
      briefly "to payroll system"
      described as {
        |Carries messages to the external PayrollSystem.
      }
    }
  } with {
    briefly "PayrollSystem integration"
    described as {
      |The model's side of the PayrollSystem conversation.
    }
  }
  include "types.riddl"
  include "BenefitsEnrollment.riddl"
  type BenefitsRepositoryCommand is one of {
    BenefitsContext.BenefitsRepository.PersistCobraInitiated or BenefitsContext.BenefitsRepository.PersistDependentAdded or BenefitsContext.BenefitsRepository.PersistDependentRemoved or BenefitsContext.BenefitsRepository.PersistEnrollmentApproved or BenefitsContext.BenefitsRepository.PersistEnrollmentCreated or BenefitsContext.BenefitsRepository.PersistEnrollmentDenied or BenefitsContext.BenefitsRepository.PersistEnrollmentSubmitted or BenefitsContext.BenefitsRepository.PersistEnrollmentTerminated or BenefitsContext.BenefitsRepository.PersistLifeEventRecorded or BenefitsContext.BenefitsRepository.PersistPlanSelected
  } with {
    briefly "Anything that writes BenefitsRepository"
    described as {
      |The persistence commands BenefitsRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository BenefitsRepository as flow is {
    inlet BenefitsRepositoryFromBenefitsMetrics is type BenefitsRepositoryCommand    command PersistDependentAdded is {
      enrollmentId: EnrollmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DependentAdded applies to.
        }
      }
    } with {
      briefly "Persist DependentAdded"
      described as {
        |Instructs this repository to apply DependentAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDependentRemoved is {
      enrollmentId: EnrollmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DependentRemoved applies to.
        }
      }
    } with {
      briefly "Persist DependentRemoved"
      described as {
        |Instructs this repository to apply DependentRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEnrollmentDenied is {
      enrollmentId: EnrollmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row EnrollmentDenied applies to.
        }
      }
    } with {
      briefly "Persist EnrollmentDenied"
      described as {
        |Instructs this repository to apply EnrollmentDenied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEnrollmentSubmitted is {
      enrollmentId: EnrollmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row EnrollmentSubmitted applies to.
        }
      }
    } with {
      briefly "Persist EnrollmentSubmitted"
      described as {
        |Instructs this repository to apply EnrollmentSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlanSelected is {
      enrollmentId: EnrollmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlanSelected applies to.
        }
      }
    } with {
      briefly "Persist PlanSelected"
      described as {
        |Instructs this repository to apply PlanSelected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCobraInitiated is {
      enrollmentId: EnrollmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row CobraInitiated applies to.
        }
      }
    } with {
      briefly "Persist CobraInitiated"
      described as {
        |Instructs this repository to apply CobraInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEnrollmentApproved is {
      enrollmentId: EnrollmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row EnrollmentApproved applies to.
        }
      }
    } with {
      briefly "Persist EnrollmentApproved"
      described as {
        |Instructs this repository to apply EnrollmentApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEnrollmentCreated is {
      enrollmentId: EnrollmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row EnrollmentCreated applies to.
        }
      }
    } with {
      briefly "Persist EnrollmentCreated"
      described as {
        |Instructs this repository to apply EnrollmentCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEnrollmentTerminated is {
      enrollmentId: EnrollmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row EnrollmentTerminated applies to.
        }
      }
    } with {
      briefly "Persist EnrollmentTerminated"
      described as {
        |Instructs this repository to apply EnrollmentTerminated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLifeEventRecorded is {
      enrollmentId: EnrollmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row LifeEventRecorded applies to.
        }
      }
    } with {
      briefly "Persist LifeEventRecorded"
      described as {
        |Instructs this repository to apply LifeEventRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet BenefitsRepositoryResponses is result BenefitsEnrollment.BenefitsEnrollmentResult
    record StoredBenefitsEnrollment is {
      benefitsEnrollmentId: UUID with {
        briefly "benefitsEnrollmentId"
        described as {
          |The benefitsEnrollmentId column of the stored benefitsEnrollment row.
        }
      }
      employeeId: EmployeeId with {
        briefly "employeeId"
        described as {
          |The employeeId column of the stored benefitsEnrollment row.
        }
      }
      enrollmentId: EnrollmentId with {
        briefly "enrollmentId"
        described as {
          |The enrollmentId column of the stored benefitsEnrollment row.
        }
      }
      status: EnrollmentStatus with {
        briefly "status"
        described as {
          |The status column of the stored benefitsEnrollment row.
        }
      }
    } with {
      briefly "Stored benefitsEnrollment row"
      described as {
        |The persistence shape of benefitsEnrollment data as this repository stores it.
      }
    }
    schema BenefitsData is relational
      of enrollments as record StoredBenefitsEnrollment
        index on field StoredBenefitsEnrollment.enrollmentId
        index on field StoredBenefitsEnrollment.employeeId
        index on field StoredBenefitsEnrollment.status
 with {
      briefly "Benefits data schema"
      described as {
        |The relational schema holding benefits data for the BenefitsRepository.
      }
    }
    handler BenefitsPersistence is {
      on persistDependentAdded: command PersistDependentAdded is {
        do "apply DependentAdded to the stored row"
      }
      on persistDependentRemoved: command PersistDependentRemoved is {
        do "apply DependentRemoved to the stored row"
      }
      on persistEnrollmentDenied: command PersistEnrollmentDenied is {
        do "apply EnrollmentDenied to the stored row"
      }
      on persistEnrollmentSubmitted: command PersistEnrollmentSubmitted is {
        do "apply EnrollmentSubmitted to the stored row"
      }
      on persistPlanSelected: command PersistPlanSelected is {
        do "apply PlanSelected to the stored row"
      }
      on persistCobraInitiated: command PersistCobraInitiated is {
        do "apply CobraInitiated to the stored row"
      }
      on persistEnrollmentApproved: command PersistEnrollmentApproved is {
        do "apply EnrollmentApproved to the stored row"
      }
      on persistEnrollmentCreated: command PersistEnrollmentCreated is {
        do "apply EnrollmentCreated to the stored row"
      }
      on persistEnrollmentTerminated: command PersistEnrollmentTerminated is {
        do "apply EnrollmentTerminated to the stored row"
      }
      on persistLifeEventRecorded: command PersistLifeEventRecorded is {
        do "apply LifeEventRecorded to the stored row"
      }
      on query GetEnrollmentMetrics is {
        let enrollmentMetricsView: type EnrollmentMetricsView = prompt("read the enrollment metrics projection")
        reply enrollmentMetricsView
      }
    } with {
      briefly "Persists benefits commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Benefits data persistence"
    described as {
      |Persistent storage for benefits enrollments.
    }
  }
  query GetEnrollmentMetrics replies result EnrollmentMetricsView is {
    enrollmentMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which enrollment metrics to retrieve.
      }
    }
  } with {
    briefly "Get enrollment metrics"
    described as {
      |Retrieves the enrollment metrics projection.
    }
  }
  result EnrollmentMetricsView is {
    enrollmentMetrics: BenefitsMetrics.EnrollmentMetrics with {
      briefly "Enrollment metrics"
      described as {
        |The enrollment metrics being returned.
      }
    }
  } with {
    briefly "Enrollment metrics view"
    described as {
      |Read model view carrying the enrollment metrics projection.
    }
  }
  projector BenefitsMetrics as flow is {
    updates repository BenefitsContext.BenefitsRepository
    outlet BenefitsMetricsToRepository is type BenefitsRepositoryCommand
    inlet BenefitsMetricsFromBenefitsEnrollment is type BenefitsEnrollmentEvent    record EnrollmentMetrics is {
      totalEnrollments: Natural with {
        briefly "Total"
        described as {
          |Total enrollments.
        }
      }
      activeEnrollments: Natural with {
        briefly "Active"
        described as {
          |Active enrollments.
        }
      }
      pendingEnrollments: Natural with {
        briefly "Pending"
        described as {
          |Pending enrollments.
        }
      }
      terminatedEnrollments: Natural with {
        briefly "Terminated"
        described as {
          |Terminated enrollments.
        }
      }
      cobraEnrollments: Natural with {
        briefly "COBRA"
        described as {
          |COBRA enrollments.
        }
      }
      lifeEventChanges: Natural with {
        briefly "Life events"
        described as {
          |Life event changes.
        }
      }
    } with {
      briefly "Enrollment metrics"
      described as {
        |Benefits enrollment metrics.
      }
    }
    handler MetricsHandler is {
      on dependentAdded: event BenefitsEnrollment.DependentAdded is {
        tell command BenefitsContext.BenefitsRepository.PersistDependentAdded(enrollmentId = dependentAdded.enrollmentId) to repository BenefitsContext.BenefitsRepository
        do "apply DependentAdded to the BenefitsMetrics projection"
      }
      on dependentRemoved: event BenefitsEnrollment.DependentRemoved is {
        tell command BenefitsContext.BenefitsRepository.PersistDependentRemoved(enrollmentId = dependentRemoved.enrollmentId) to repository BenefitsContext.BenefitsRepository
        do "apply DependentRemoved to the BenefitsMetrics projection"
      }
      on enrollmentDenied: event BenefitsEnrollment.EnrollmentDenied is {
        tell command BenefitsContext.BenefitsRepository.PersistEnrollmentDenied(enrollmentId = enrollmentDenied.enrollmentId) to repository BenefitsContext.BenefitsRepository
        do "apply EnrollmentDenied to the BenefitsMetrics projection"
      }
      on enrollmentSubmitted: event BenefitsEnrollment.EnrollmentSubmitted is {
        tell command BenefitsContext.BenefitsRepository.PersistEnrollmentSubmitted(enrollmentId = enrollmentSubmitted.enrollmentId) to repository BenefitsContext.BenefitsRepository
        do "apply EnrollmentSubmitted to the BenefitsMetrics projection"
      }
      on planSelected: event BenefitsEnrollment.PlanSelected is {
        tell command BenefitsContext.BenefitsRepository.PersistPlanSelected(enrollmentId = planSelected.enrollmentId) to repository BenefitsContext.BenefitsRepository
        do "apply PlanSelected to the BenefitsMetrics projection"
      }
      on enrollmentCreated: event BenefitsEnrollment.EnrollmentCreated is {
        tell command BenefitsContext.BenefitsRepository.PersistEnrollmentCreated(enrollmentId = enrollmentCreated.enrollmentId) to repository BenefitsContext.BenefitsRepository
        do "Increment total enrollments"
      }
      on enrollmentApproved: event BenefitsEnrollment.EnrollmentApproved is {
        tell command BenefitsContext.BenefitsRepository.PersistEnrollmentApproved(enrollmentId = enrollmentApproved.enrollmentId) to repository BenefitsContext.BenefitsRepository
        do "Increment active enrollments"
      }
      on cobraInitiated: event BenefitsEnrollment.CobraInitiated is {
        tell command BenefitsContext.BenefitsRepository.PersistCobraInitiated(enrollmentId = cobraInitiated.enrollmentId) to repository BenefitsContext.BenefitsRepository
        do "Increment COBRA enrollments"
      }
      on lifeEventRecorded: event BenefitsEnrollment.LifeEventRecorded is {
        tell command BenefitsContext.BenefitsRepository.PersistLifeEventRecorded(enrollmentId = lifeEventRecorded.enrollmentId) to repository BenefitsContext.BenefitsRepository
        do "Increment life event changes"
      }
      on enrollmentTerminated: event BenefitsEnrollment.EnrollmentTerminated is {
        tell command BenefitsContext.BenefitsRepository.PersistEnrollmentTerminated(enrollmentId = enrollmentTerminated.enrollmentId) to repository BenefitsContext.BenefitsRepository
        do "Increment terminated enrollments"
      }
    } with {
      briefly "Maintains benefits metrics"
      described as {
        |Projects events into enrollment metrics.
      }
    }
  } with {
    briefly "Benefits metrics"
    described as {
      |Benefits enrollment analytics and compliance reporting.
    }
  }
  // ---- Event publication for BenefitsEnrollment ----
  type BenefitsEnrollmentEvent is one of {
    BenefitsContext.BenefitsEnrollment.EnrollmentCreated or BenefitsContext.BenefitsEnrollment.PlanSelected or BenefitsContext.BenefitsEnrollment.DependentAdded or BenefitsContext.BenefitsEnrollment.DependentRemoved or BenefitsContext.BenefitsEnrollment.EnrollmentSubmitted or BenefitsContext.BenefitsEnrollment.EnrollmentApproved or BenefitsContext.BenefitsEnrollment.EnrollmentDenied or BenefitsContext.BenefitsEnrollment.LifeEventRecorded or BenefitsContext.BenefitsEnrollment.CobraInitiated or BenefitsContext.BenefitsEnrollment.EnrollmentTerminated
  } with {
    briefly "BenefitsEnrollment event alternation"
    described as {
      |Union of all BenefitsEnrollment events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BenefitsEnrollmentEventSplit as flow is {
    inlet BenefitsEnrollmentEventSplitIn is type BenefitsEnrollmentEvent    outlet BenefitsEnrollmentEventSplitToBenefitsMetrics is type BenefitsEnrollmentEvent
    handler BenefitsEnrollmentEventSplitHandler is {
      on enrollmentCreated: event BenefitsEnrollment.EnrollmentCreated is {
        send enrollmentCreated to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell enrollmentCreated to entity BenefitsContext.BenefitsEnrollment
      }
      on planSelected: event BenefitsEnrollment.PlanSelected is {
        send planSelected to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell planSelected to entity BenefitsContext.BenefitsEnrollment
      }
      on dependentAdded: event BenefitsEnrollment.DependentAdded is {
        send dependentAdded to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell dependentAdded to entity BenefitsContext.BenefitsEnrollment
      }
      on dependentRemoved: event BenefitsEnrollment.DependentRemoved is {
        send dependentRemoved to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell dependentRemoved to entity BenefitsContext.BenefitsEnrollment
      }
      on enrollmentSubmitted: event BenefitsEnrollment.EnrollmentSubmitted is {
        send enrollmentSubmitted to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell enrollmentSubmitted to entity BenefitsContext.BenefitsEnrollment
      }
      on enrollmentApproved: event BenefitsEnrollment.EnrollmentApproved is {
        send enrollmentApproved to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell enrollmentApproved to entity BenefitsContext.BenefitsEnrollment
      }
      on enrollmentDenied: event BenefitsEnrollment.EnrollmentDenied is {
        send enrollmentDenied to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell enrollmentDenied to entity BenefitsContext.BenefitsEnrollment
      }
      on lifeEventRecorded: event BenefitsEnrollment.LifeEventRecorded is {
        send lifeEventRecorded to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell lifeEventRecorded to entity BenefitsContext.BenefitsEnrollment
      }
      on cobraInitiated: event BenefitsEnrollment.CobraInitiated is {
        send cobraInitiated to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell cobraInitiated to entity BenefitsContext.BenefitsEnrollment
      }
      on enrollmentTerminated: event BenefitsEnrollment.EnrollmentTerminated is {
        send enrollmentTerminated to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell enrollmentTerminated to entity BenefitsContext.BenefitsEnrollment
      }
      on other is {
        error "Unexpected message for processor BenefitsEnrollmentEventSplit"
      }
    } with {
      briefly "BenefitsEnrollment event fan-out handler"
      described as {
        |Delivers each BenefitsEnrollment event to all of its consumers.
      }
    }
  } with {
    briefly "BenefitsEnrollment event fan-out"
    described as {
      |Fans BenefitsEnrollment events out to the repository and projectors.
    }
  }
  connector 'BenefitsEnrollmentEvent Stream' is from outlet BenefitsContext.BenefitsEnrollment.BenefitsEnrollmentEvents2 to inlet BenefitsContext.BenefitsEnrollmentEventSplit.BenefitsEnrollmentEventSplitIn with {
    briefly "BenefitsEnrollment events, fanned out to storage and read models"
  }
  connector 'BenefitsMetrics Feed' is from outlet BenefitsContext.BenefitsEnrollmentEventSplit.BenefitsEnrollmentEventSplitToBenefitsMetrics to inlet BenefitsContext.BenefitsMetrics.BenefitsMetricsFromBenefitsEnrollment with {
    briefly "BenefitsEnrollment events feeding the BenefitsMetrics projection"
  }
  connector 'BenefitsMetrics Storage' is from outlet BenefitsContext.BenefitsMetrics.BenefitsMetricsToRepository to inlet BenefitsContext.BenefitsRepository.BenefitsRepositoryFromBenefitsMetrics with {
    briefly "BenefitsMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for benefits administration"
  described as {
    |Benefits enrollment and plan management context.
  }
}
