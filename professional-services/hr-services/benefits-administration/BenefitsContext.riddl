// Benefits Administration - Benefits Context
context BenefitsContext is {
  adaptor FromComplianceReportingSystem from context ComplianceReportingSystem is { 
    handler FromComplianceReportingSystemHandler is {
      on event ComplianceReportingSystem.AcaReportGenerated is {
        do "the model receives aca report generated"
      }
      on event ComplianceReportingSystem.CobraNoticeGenerated is {
        do "the model receives cobra notice generated"
      }
      on other is {
        error "Unexpected message for adaptor FromComplianceReportingSystem"
      }
    } with {
      briefly "from compliance reporting system"
      described as {
        |Carries messages from the external ComplianceReportingSystem.
      }
    }
  } with {
    briefly "ComplianceReportingSystem integration"
    described as {
      |The model's side of the ComplianceReportingSystem conversation.
    }
  }
  adaptor ToComplianceReportingSystem to context ComplianceReportingSystem is { 
    handler ToComplianceReportingSystemHandler is {
      on command ComplianceReportingSystem.GenerateAcaReport is {
        do "the model sends generate aca report"
      }
      on command ComplianceReportingSystem.GenerateCobraNotice is {
        do "the model sends generate cobra notice"
      }
      on other is {
        error "Unexpected message for adaptor ToComplianceReportingSystem"
      }
    } with {
      briefly "to compliance reporting system"
      described as {
        |Carries messages to the external ComplianceReportingSystem.
      }
    }
  } with {
    briefly "ComplianceReportingSystem integration"
    described as {
      |The model's side of the ComplianceReportingSystem conversation.
    }
  }
  adaptor FromInsuranceCarrier from context InsuranceCarrier is { 
    handler FromInsuranceCarrierHandler is {
      on event InsuranceCarrier.EnrollmentFileAccepted is {
        do "the model receives enrollment file accepted"
      }
      on event InsuranceCarrier.EnrollmentFileRejected is {
        do "the model receives enrollment file rejected"
      }
      on result InsuranceCarrier.PlanDetails is {
        do "the model receives plan details"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceCarrier"
      }
    } with {
      briefly "from insurance carrier"
      described as {
        |Carries messages from the external InsuranceCarrier.
      }
    }
  } with {
    briefly "InsuranceCarrier integration"
    described as {
      |The model's side of the InsuranceCarrier conversation.
    }
  }
  adaptor ToInsuranceCarrier to context InsuranceCarrier is { 
    handler ToInsuranceCarrierHandler is {
      on query InsuranceCarrier.GetPlanDetails is {
        do "the model sends get plan details"
      }
      on command InsuranceCarrier.SubmitEnrollmentFile is {
        do "the model sends submit enrollment file"
      }
      on other is {
        error "Unexpected message for adaptor ToInsuranceCarrier"
      }
    } with {
      briefly "to insurance carrier"
      described as {
        |Carries messages to the external InsuranceCarrier.
      }
    }
  } with {
    briefly "InsuranceCarrier integration"
    described as {
      |The model's side of the InsuranceCarrier conversation.
    }
  }
  adaptor FromPayrollSystem from context PayrollSystem is { 
    handler FromPayrollSystemHandler is {
      on event PayrollSystem.DeductionsUpdated is {
        do "the model receives deductions updated"
      }
      on result PayrollSystem.EmployeeCompensation is {
        do "the model receives employee compensation"
      }
      on other is {
        error "Unexpected message for adaptor FromPayrollSystem"
      }
    } with {
      briefly "from payroll system"
      described as {
        |Carries messages from the external PayrollSystem.
      }
    }
  } with {
    briefly "PayrollSystem integration"
    described as {
      |The model's side of the PayrollSystem conversation.
    }
  }
  adaptor ToPayrollSystem to context PayrollSystem is { 
    handler ToPayrollSystemHandler is {
      on query PayrollSystem.GetEmployeeCompensation is {
        do "the model sends get employee compensation"
      }
      on command PayrollSystem.UpdateDeductions is {
        do "the model sends update deductions"
      }
      on other is {
        error "Unexpected message for adaptor ToPayrollSystem"
      }
    } with {
      briefly "to payroll system"
      described as {
        |Carries messages to the external PayrollSystem.
      }
    }
  } with {
    briefly "PayrollSystem integration"
    described as {
      |The model's side of the PayrollSystem conversation.
    }
  }
  include "types.riddl"
  include "BenefitsEnrollment.riddl"
  repository BenefitsRepository as merge is {
    inlet BenefitsRepositoryFromBenefitsEnrollment is type BenefitsEnrollmentEvent    inlet BenefitsRepositoryFromBenefitsMetrics is type BenefitsEnrollmentEvent    outlet BenefitsRepositoryResponses is type BenefitsEnrollment.BenefitsEnrollmentResult
    record StoredBenefitsEnrollment is  {
      benefitsEnrollmentId: UUID with {
        briefly "benefitsEnrollmentId"
        described as {
          |The benefitsEnrollmentId column of the stored benefitsEnrollment row.
        }
      }
      employeeId: EmployeeId with {
        briefly "employeeId"
        described as {
          |The employeeId column of the stored benefitsEnrollment row.
        }
      }
      enrollmentId: EnrollmentId with {
        briefly "enrollmentId"
        described as {
          |The enrollmentId column of the stored benefitsEnrollment row.
        }
      }
      status: EnrollmentStatus with {
        briefly "status"
        described as {
          |The status column of the stored benefitsEnrollment row.
        }
      }
    } with {
      briefly "Stored benefitsEnrollment row"
      described as {
        |The persistence shape of benefitsEnrollment data as this repository stores it.
      }
    }
    schema BenefitsData is relational
      of enrollments as type StoredBenefitsEnrollment
        index on field StoredBenefitsEnrollment.enrollmentId
        index on field StoredBenefitsEnrollment.employeeId
        index on field StoredBenefitsEnrollment.status
 with {
      briefly "Benefits data schema"
      described as {
        |The relational schema holding benefits data for the BenefitsRepository.
      }
    }
    handler BenefitsPersistence is {
      on query GetEnrollmentMetrics is {
        do "read the enrollment metrics projection"
        reply result EnrollmentMetricsView
      }
      on createEnrollment: command BenefitsEnrollment.CreateEnrollment is {
        tell event BenefitsEnrollment.EnrollmentCreated(enrollmentId = createEnrollment.enrollmentId, employeeId = createEnrollment.employeeId) to entity BenefitsContext.BenefitsEnrollment
        do "Store new benefits enrollment"
      }
      on command BenefitsEnrollment.SelectPlan is {
        do "Store plan election"
      }
      on addDependent: command BenefitsEnrollment.AddDependent is {
        tell event BenefitsEnrollment.DependentAdded(enrollmentId = addDependent.enrollmentId, dependent = addDependent.dependent) to entity BenefitsContext.BenefitsEnrollment
        do "Store added dependent"
      }
      on submitEnrollment: command BenefitsEnrollment.SubmitEnrollment is {
        tell event BenefitsEnrollment.EnrollmentSubmitted(enrollmentId = submitEnrollment.enrollmentId, submittedAt = submitEnrollment.submittedAt) to entity BenefitsContext.BenefitsEnrollment
        do "Update enrollment to submitted"
      }
      on approveEnrollment: command BenefitsEnrollment.ApproveEnrollment is {
        tell event BenefitsEnrollment.EnrollmentApproved(enrollmentId = approveEnrollment.enrollmentId, approvedBy = approveEnrollment.approvedBy) to entity BenefitsContext.BenefitsEnrollment
        do "Update enrollment to approved"
      }
      on terminateEnrollment: command BenefitsEnrollment.TerminateEnrollment is {
        tell event BenefitsEnrollment.EnrollmentTerminated(enrollmentId = terminateEnrollment.enrollmentId, terminationDate = terminateEnrollment.terminationDate, reason = terminateEnrollment.reason) to entity BenefitsContext.BenefitsEnrollment
        do "Update enrollment to terminated"
      }
    } with {
      briefly "Persists benefits commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Benefits data persistence"
    described as {
      |Persistent storage for benefits enrollments.
    }
  }
  query GetEnrollmentMetrics is  {
    enrollmentMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which enrollment metrics to retrieve.
      }
    }
  } with {
    briefly "Get enrollment metrics"
    described as {
      |Retrieves the enrollment metrics projection.
    }
  }
  result EnrollmentMetricsView is  {
    enrollmentMetrics: BenefitsMetrics.EnrollmentMetrics with {
      briefly "Enrollment metrics"
      described as {
        |The enrollment metrics being returned.
      }
    }
  } with {
    briefly "Enrollment metrics view"
    described as {
      |Read model view carrying the enrollment metrics projection.
    }
  }
  projector BenefitsMetrics as flow is {
    updates repository BenefitsContext.BenefitsRepository
    inlet BenefitsMetricsFromBenefitsEnrollment is type BenefitsEnrollmentEvent    outlet BenefitsMetricsOut is type BenefitsEnrollmentEvent
    record EnrollmentMetrics is  {
      totalEnrollments: Natural with {
        briefly "Total"
        described as {
          |Total enrollments.
        }
      }
      activeEnrollments: Natural with {
        briefly "Active"
        described as {
          |Active enrollments.
        }
      }
      pendingEnrollments: Natural with {
        briefly "Pending"
        described as {
          |Pending enrollments.
        }
      }
      terminatedEnrollments: Natural with {
        briefly "Terminated"
        described as {
          |Terminated enrollments.
        }
      }
      cobraEnrollments: Natural with {
        briefly "COBRA"
        described as {
          |COBRA enrollments.
        }
      }
      lifeEventChanges: Natural with {
        briefly "Life events"
        described as {
          |Life event changes.
        }
      }
    } with {
      briefly "Enrollment metrics"
      described as {
        |Benefits enrollment metrics.
      }
    }
    handler MetricsHandler is {
      on enrollmentCreated: event BenefitsEnrollment.EnrollmentCreated is {
        tell enrollmentCreated to repository BenefitsContext.BenefitsRepository
        do "Increment total enrollments"
      }
      on enrollmentApproved: event BenefitsEnrollment.EnrollmentApproved is {
        tell enrollmentApproved to repository BenefitsContext.BenefitsRepository
        do "Increment active enrollments"
      }
      on cobraInitiated: event BenefitsEnrollment.CobraInitiated is {
        tell cobraInitiated to repository BenefitsContext.BenefitsRepository
        do "Increment COBRA enrollments"
      }
      on lifeEventRecorded: event BenefitsEnrollment.LifeEventRecorded is {
        tell lifeEventRecorded to repository BenefitsContext.BenefitsRepository
        do "Increment life event changes"
      }
      on enrollmentTerminated: event BenefitsEnrollment.EnrollmentTerminated is {
        tell enrollmentTerminated to repository BenefitsContext.BenefitsRepository
        do "Increment terminated enrollments"
      }
    } with {
      briefly "Maintains benefits metrics"
      described as {
        |Projects events into enrollment metrics.
      }
    }
  } with {
    briefly "Benefits metrics"
    described as {
      |Benefits enrollment analytics and compliance reporting.
    }
  }
  // ---- Event publication for BenefitsEnrollment ----
  type BenefitsEnrollmentEvent is one of {
    BenefitsContext.BenefitsEnrollment.EnrollmentCreated or BenefitsContext.BenefitsEnrollment.PlanSelected or BenefitsContext.BenefitsEnrollment.DependentAdded or BenefitsContext.BenefitsEnrollment.DependentRemoved or BenefitsContext.BenefitsEnrollment.EnrollmentSubmitted or BenefitsContext.BenefitsEnrollment.EnrollmentApproved or BenefitsContext.BenefitsEnrollment.EnrollmentDenied or BenefitsContext.BenefitsEnrollment.LifeEventRecorded or BenefitsContext.BenefitsEnrollment.CobraInitiated or BenefitsContext.BenefitsEnrollment.EnrollmentTerminated
  } with {
    briefly "BenefitsEnrollment event alternation"
    described as {
      |Union of all BenefitsEnrollment events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BenefitsEnrollmentEventSource as source is {
    outlet BenefitsEnrollmentEvents is type BenefitsEnrollmentEvent
    handler BenefitsEnrollmentSourceHandler is {
      on enrollmentCreated: event BenefitsEnrollment.EnrollmentCreated is {
        send enrollmentCreated to outlet BenefitsEnrollmentEvents
      }
      on planSelected: event BenefitsEnrollment.PlanSelected is {
        send planSelected to outlet BenefitsEnrollmentEvents
      }
      on dependentAdded: event BenefitsEnrollment.DependentAdded is {
        send dependentAdded to outlet BenefitsEnrollmentEvents
      }
      on dependentRemoved: event BenefitsEnrollment.DependentRemoved is {
        send dependentRemoved to outlet BenefitsEnrollmentEvents
      }
      on enrollmentSubmitted: event BenefitsEnrollment.EnrollmentSubmitted is {
        send enrollmentSubmitted to outlet BenefitsEnrollmentEvents
      }
      on enrollmentApproved: event BenefitsEnrollment.EnrollmentApproved is {
        send enrollmentApproved to outlet BenefitsEnrollmentEvents
      }
      on enrollmentDenied: event BenefitsEnrollment.EnrollmentDenied is {
        send enrollmentDenied to outlet BenefitsEnrollmentEvents
      }
      on lifeEventRecorded: event BenefitsEnrollment.LifeEventRecorded is {
        send lifeEventRecorded to outlet BenefitsEnrollmentEvents
      }
      on cobraInitiated: event BenefitsEnrollment.CobraInitiated is {
        send cobraInitiated to outlet BenefitsEnrollmentEvents
      }
      on enrollmentTerminated: event BenefitsEnrollment.EnrollmentTerminated is {
        send enrollmentTerminated to outlet BenefitsEnrollmentEvents
      }
      on other is {
        error "Unexpected message for source BenefitsEnrollmentEventSource"
      }
    } with {
      briefly "BenefitsEnrollment source handler"
      described as {
        |Publishes BenefitsEnrollment events onto the outlet.
      }
    }
  } with {
    briefly "BenefitsEnrollment event source"
    described as {
      |Publishes BenefitsEnrollment entity events into the streaming topology.
    }
  }
  processor BenefitsEnrollmentEventSink as sink is {
    inlet BenefitsEnrollmentInlet is type BenefitsEnrollmentEvent    handler BenefitsEnrollmentSinkHandler is {
      on enrollmentCreated: event BenefitsEnrollment.EnrollmentCreated is {
        tell enrollmentCreated to repository BenefitsContext.BenefitsRepository
      }
      on planSelected: event BenefitsEnrollment.PlanSelected is {
        tell planSelected to repository BenefitsContext.BenefitsRepository
      }
      on dependentAdded: event BenefitsEnrollment.DependentAdded is {
        tell dependentAdded to repository BenefitsContext.BenefitsRepository
      }
      on dependentRemoved: event BenefitsEnrollment.DependentRemoved is {
        tell dependentRemoved to repository BenefitsContext.BenefitsRepository
      }
      on enrollmentSubmitted: event BenefitsEnrollment.EnrollmentSubmitted is {
        tell enrollmentSubmitted to repository BenefitsContext.BenefitsRepository
      }
      on enrollmentApproved: event BenefitsEnrollment.EnrollmentApproved is {
        tell enrollmentApproved to repository BenefitsContext.BenefitsRepository
      }
      on enrollmentDenied: event BenefitsEnrollment.EnrollmentDenied is {
        tell enrollmentDenied to repository BenefitsContext.BenefitsRepository
      }
      on lifeEventRecorded: event BenefitsEnrollment.LifeEventRecorded is {
        tell lifeEventRecorded to repository BenefitsContext.BenefitsRepository
      }
      on cobraInitiated: event BenefitsEnrollment.CobraInitiated is {
        tell cobraInitiated to repository BenefitsContext.BenefitsRepository
      }
      on enrollmentTerminated: event BenefitsEnrollment.EnrollmentTerminated is {
        tell enrollmentTerminated to repository BenefitsContext.BenefitsRepository
      }
      on other is {
        error "Unexpected message for sink BenefitsEnrollmentEventSink"
      }
    } with {
      briefly "BenefitsEnrollment sink handler"
      described as {
        |Persists BenefitsEnrollment events via the repository.
      }
    }
  } with {
    briefly "BenefitsEnrollment event sink"
    described as {
      |Receives BenefitsEnrollment events for persistence.
    }
  }
  connector BenefitsEnrollmentEventFlow is from outlet BenefitsContext.BenefitsEnrollmentEventSource.BenefitsEnrollmentEvents to inlet BenefitsContext.BenefitsEnrollmentEventSink.BenefitsEnrollmentInlet with {
    briefly "BenefitsEnrollment event flow"
    described as {
      |Connects the BenefitsEnrollment source to its sink.
    }
  }
  processor BenefitsEnrollmentEventSplit as split is {
    inlet BenefitsEnrollmentEventSplitIn is type BenefitsEnrollmentEvent    outlet BenefitsEnrollmentEventSplitToBenefitsRepository is type BenefitsEnrollmentEvent
    outlet BenefitsEnrollmentEventSplitToBenefitsMetrics is type BenefitsEnrollmentEvent
    handler BenefitsEnrollmentEventSplitHandler is {
      on enrollmentCreated: event BenefitsEnrollment.EnrollmentCreated is {
        send enrollmentCreated to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send enrollmentCreated to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell enrollmentCreated to entity BenefitsContext.BenefitsEnrollment
      }
      on planSelected: event BenefitsEnrollment.PlanSelected is {
        send planSelected to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send planSelected to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell planSelected to entity BenefitsContext.BenefitsEnrollment
      }
      on dependentAdded: event BenefitsEnrollment.DependentAdded is {
        send dependentAdded to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send dependentAdded to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell dependentAdded to entity BenefitsContext.BenefitsEnrollment
      }
      on dependentRemoved: event BenefitsEnrollment.DependentRemoved is {
        send dependentRemoved to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send dependentRemoved to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell dependentRemoved to entity BenefitsContext.BenefitsEnrollment
      }
      on enrollmentSubmitted: event BenefitsEnrollment.EnrollmentSubmitted is {
        send enrollmentSubmitted to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send enrollmentSubmitted to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell enrollmentSubmitted to entity BenefitsContext.BenefitsEnrollment
      }
      on enrollmentApproved: event BenefitsEnrollment.EnrollmentApproved is {
        send enrollmentApproved to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send enrollmentApproved to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell enrollmentApproved to entity BenefitsContext.BenefitsEnrollment
      }
      on enrollmentDenied: event BenefitsEnrollment.EnrollmentDenied is {
        send enrollmentDenied to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send enrollmentDenied to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell enrollmentDenied to entity BenefitsContext.BenefitsEnrollment
      }
      on lifeEventRecorded: event BenefitsEnrollment.LifeEventRecorded is {
        send lifeEventRecorded to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send lifeEventRecorded to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell lifeEventRecorded to entity BenefitsContext.BenefitsEnrollment
      }
      on cobraInitiated: event BenefitsEnrollment.CobraInitiated is {
        send cobraInitiated to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send cobraInitiated to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell cobraInitiated to entity BenefitsContext.BenefitsEnrollment
      }
      on enrollmentTerminated: event BenefitsEnrollment.EnrollmentTerminated is {
        send enrollmentTerminated to outlet BenefitsEnrollmentEventSplitToBenefitsRepository
        send enrollmentTerminated to outlet BenefitsEnrollmentEventSplitToBenefitsMetrics
        tell enrollmentTerminated to entity BenefitsContext.BenefitsEnrollment
      }
      on other is {
        error "Unexpected message for processor BenefitsEnrollmentEventSplit"
      }
    } with {
      briefly "BenefitsEnrollment event fan-out handler"
      described as {
        |Delivers each BenefitsEnrollment event to all of its consumers.
      }
    }
  } with {
    briefly "BenefitsEnrollment event fan-out"
    described as {
      |Fans BenefitsEnrollment events out to the repository and projectors.
    }
  }
  connector 'BenefitsEnrollmentEvent Stream' is from outlet BenefitsContext.BenefitsEnrollment.BenefitsEnrollmentEvents2 to inlet BenefitsContext.BenefitsEnrollmentEventSplit.BenefitsEnrollmentEventSplitIn with {
    briefly "BenefitsEnrollment events, fanned out to storage and read models"
  }
  connector 'BenefitsEnrollmentEvent Storage' is from outlet BenefitsContext.BenefitsEnrollmentEventSplit.BenefitsEnrollmentEventSplitToBenefitsRepository to inlet BenefitsContext.BenefitsRepository.BenefitsRepositoryFromBenefitsEnrollment with {
    briefly "BenefitsEnrollment events on their way to storage"
  }
  connector 'BenefitsMetrics Feed' is from outlet BenefitsContext.BenefitsEnrollmentEventSplit.BenefitsEnrollmentEventSplitToBenefitsMetrics to inlet BenefitsContext.BenefitsMetrics.BenefitsMetricsFromBenefitsEnrollment with {
    briefly "BenefitsEnrollment events feeding the BenefitsMetrics projection"
  }
  connector 'BenefitsMetrics Storage' is from outlet BenefitsContext.BenefitsMetrics.BenefitsMetricsOut to inlet BenefitsContext.BenefitsRepository.BenefitsRepositoryFromBenefitsMetrics with {
    briefly "The BenefitsMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for benefits administration"
  described as {
    |Benefits enrollment and plan management context.
  }
}
