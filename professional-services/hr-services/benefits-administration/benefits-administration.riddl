// Benefits Administration Domain Model
// Employee benefits enrollment, plan management, and compliance
domain BenefitsAdministration is {
  persistent connector 'PayrollSystemReply Stream' is from outlet PayrollSystem.PayrollSystemRepliesOut to inlet BenefitsContext.ToPayrollSystem.ToPayrollSystemReplies with {
    briefly "What PayrollSystem answers BenefitsContext"
  }
  persistent connector 'InsuranceCarrierReply Stream' is from outlet InsuranceCarrier.InsuranceCarrierRepliesOut to inlet BenefitsContext.ToInsuranceCarrier.ToInsuranceCarrierReplies with {
    briefly "What InsuranceCarrier answers BenefitsContext"
  }
  persistent connector 'ComplianceReportingSystemEvent Stream' is from outlet ComplianceReportingSystem.ComplianceReportingSystemEventsOut to inlet BenefitsContext.FromComplianceReportingSystem.FromComplianceReportingSystemIn with {
    briefly "What ComplianceReportingSystem tells BenefitsContext, unasked"
  }
  persistent connector 'InsuranceCarrierEvent Stream' is from outlet InsuranceCarrier.InsuranceCarrierEventsOut to inlet BenefitsContext.FromInsuranceCarrier.FromInsuranceCarrierIn with {
    briefly "What InsuranceCarrier tells BenefitsContext, unasked"
  }
  persistent connector 'PayrollSystemEvent Stream' is from outlet PayrollSystem.PayrollSystemEventsOut to inlet BenefitsContext.FromPayrollSystem.FromPayrollSystemIn with {
    briefly "What PayrollSystem tells BenefitsContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user BenefitsAdmin is "person managing benefits plans and enrollment" with {
    briefly "Benefits Administrator"
    described as {
      |Administrator managing employee benefits programs.
    }
  }
  user HumanResourcesRep is "person assisting employees with benefits" with {
    briefly "HR Representative"
    described as {
      |Representative helping employees with benefits questions.
    }
  }
  user EmployeeUser is "person enrolling in and managing their benefits" with {
    briefly "Employee"
    described as {
      |Employee selecting and managing their own benefits.
    }
  }
  epic OpenEnrollmentProcess is {
    user BenefitsAdmin wants to "to manage annual open enrollment" so that "employees can select their benefits for the plan year"
    case ProcessEnrollment is {
      user EmployeeUser wants to "to enroll in benefits during open enrollment" so that "coverage is effective for the new plan year"
      step is "Employee reviews" "available benefit plans" "during open enrollment" with {
        briefly "Review plans"
        described as {
          |Browse available plans.
        }
      }
      step is "Employee selects" "benefit elections" "for the plan year" with {
        briefly "Select benefits"
        described as {
          |Choose plan elections.
        }
      }
    } with {
      briefly "Process enrollment"
      described as {
        |Employee enrolling in benefits during open enrollment.
      }
    }
  } with {
    briefly "Open enrollment process"
    described as {
      |Epic for annual open enrollment management.
    }
  }
  include "BenefitsContext.riddl"
  include "external-contexts.riddl"
  application context BenefitsAdministrationApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in BenefitsAdministration are delivered.
      }
    }
    group BenefitsAdministrationScreen is {
      input GetEnrollmentMetricsInput acquires query BenefitsContext.GetEnrollmentMetrics with {
        briefly "Get enrollment metrics control"
        described as {
          |The control through which a user asks the get enrollment metrics question.
        }
      }
      input GetBenefitsEnrollmentInput acquires query BenefitsContext.BenefitsEnrollment.GetBenefitsEnrollment with {
        briefly "Get benefits enrollment control"
        described as {
          |The control through which a user asks the get benefits enrollment question.
        }
      }
      input AddDependentInput acquires command BenefitsContext.BenefitsEnrollment.AddDependent with {
        briefly "Add dependent control"
        described as {
          |The control through which a user submits the add dependent request.
        }
      }
      input ApproveEnrollmentInput acquires command BenefitsContext.BenefitsEnrollment.ApproveEnrollment with {
        briefly "Approve enrollment control"
        described as {
          |The control through which a user submits the approve enrollment request.
        }
      }
      input DenyEnrollmentInput acquires command BenefitsContext.BenefitsEnrollment.DenyEnrollment with {
        briefly "Deny enrollment control"
        described as {
          |The control through which a user submits the deny enrollment request.
        }
      }
      input InitiateCobraInput acquires command BenefitsContext.BenefitsEnrollment.InitiateCobra with {
        briefly "Initiate cobra control"
        described as {
          |The control through which a user submits the initiate cobra request.
        }
      }
      input RecordLifeEventInput acquires command BenefitsContext.BenefitsEnrollment.RecordLifeEvent with {
        briefly "Record life event control"
        described as {
          |The control through which a user submits the record life event request.
        }
      }
      input RemoveDependentInput acquires command BenefitsContext.BenefitsEnrollment.RemoveDependent with {
        briefly "Remove dependent control"
        described as {
          |The control through which a user submits the remove dependent request.
        }
      }
      input SelectPlanInput acquires command BenefitsContext.BenefitsEnrollment.SelectPlan with {
        briefly "Select plan control"
        described as {
          |The control through which a user submits the select plan request.
        }
      }
      input SubmitEnrollmentInput acquires command BenefitsContext.BenefitsEnrollment.SubmitEnrollment with {
        briefly "Submit enrollment control"
        described as {
          |The control through which a user submits the submit enrollment request.
        }
      }
      input TerminateEnrollmentInput acquires command BenefitsContext.BenefitsEnrollment.TerminateEnrollment with {
        briefly "Terminate enrollment control"
        described as {
          |The control through which a user submits the terminate enrollment request.
        }
      }
      input CreateEnrollmentInput acquires command BenefitsContext.CreateEnrollment with {
        briefly "Create enrollment control"
        described as {
          |The control through which a user submits the create enrollment request.
        }
      }
    } with {
      briefly "Benefits administration screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppBenefitsRepositoryQueries is query BenefitsContext.GetEnrollmentMetrics
    inlet AppBenefitsRepositoryReplies is result BenefitsContext.EnrollmentMetricsView
    outlet AppBenefitsEnrollmentQueries is query BenefitsContext.BenefitsEnrollment.GetBenefitsEnrollment
    outlet AppBenefitsEnrollmentCommands is type BenefitsContext.BenefitsEnrollmentRequest
    inlet AppBenefitsRepositoryResponses is result BenefitsContext.BenefitsEnrollment.BenefitsEnrollmentResult
    handler BenefitsAdministrationAppHandler is {
      on other is {
        error "Unexpected message for application context BenefitsAdministrationApp"
      }
    } with {
      briefly "BenefitsAdministrationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "BenefitsAdministrationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'InsuranceCarrierRequest Stream' is from outlet BenefitsContext.ToInsuranceCarrier.ToInsuranceCarrierOut to inlet InsuranceCarrier.InsuranceCarrierRequests with {
    briefly "What BenefitsContext asks InsuranceCarrier to send"
  }
  persistent connector 'PayrollSystemRequest Stream' is from outlet BenefitsContext.ToPayrollSystem.ToPayrollSystemOut to inlet PayrollSystem.PayrollSystemRequests with {
    briefly "What BenefitsContext asks PayrollSystem to send"
  }
  persistent connector 'ComplianceReportingSystemRequest Stream' is from outlet BenefitsContext.ToComplianceReportingSystem.ToComplianceReportingSystemOut to inlet ComplianceReportingSystem.ComplianceReportingSystemRequests with {
    briefly "What BenefitsContext asks ComplianceReportingSystem to send"
  }
  persistent connector 'BenefitsRepositoryQuery Stream' is from outlet BenefitsAdministrationApp.AppBenefitsRepositoryQueries to inlet BenefitsContext.BenefitsRepositoryQueriesIn with {
    briefly "BenefitsAdministrationApp's look-ups of the benefits repository"
  }
  persistent connector 'BenefitsRepositoryReply Stream' is from outlet BenefitsContext.BenefitsRepositoryRepliesOut to inlet BenefitsAdministrationApp.AppBenefitsRepositoryReplies with {
    briefly "The benefits repository's answers returned to BenefitsAdministrationApp"
  }
  persistent connector 'BenefitsEnrollmentQuery Stream' is from outlet BenefitsAdministrationApp.AppBenefitsEnrollmentQueries to inlet BenefitsContext.BenefitsEnrollmentQueriesIn with {
    briefly "BenefitsAdministrationApp's look-ups of the benefits enrollment"
  }
  persistent connector 'BenefitsEnrollmentCommand Stream' is from outlet BenefitsAdministrationApp.AppBenefitsEnrollmentCommands to inlet BenefitsContext.BenefitsEnrollmentCommandStrIn with {
    briefly "BenefitsEnrollment commands from the application"
  }
  persistent connector 'BenefitsEnrollmentResult Stream' is from outlet BenefitsContext.BenefitsEnrollmentResultStreOut to inlet BenefitsAdministrationApp.AppBenefitsRepositoryResponses with {
    briefly "Benefits query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet BenefitsAdministrationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Benefits administration domain"
  described as {
    |Employee benefits enrollment, plan management, and compliance.
  }
}
