// Benefits Administration Domain Model
// Employee benefits enrollment, plan management, and compliance
domain BenefitsAdministration is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user BenefitsAdmin is "person managing benefits plans and enrollment" with {
    briefly "Benefits Administrator"
    described as {
      |Administrator managing employee benefits programs.
    }
  }
  user HumanResourcesRep is "person assisting employees with benefits" with {
    briefly "HR Representative"
    described as {
      |Representative helping employees with benefits questions.
    }
  }
  user EmployeeUser is "person enrolling in and managing their benefits" with {
    briefly "Employee"
    described as {
      |Employee selecting and managing their own benefits.
    }
  }
  epic OpenEnrollmentProcess is {
    user BenefitsAdmin wants to "to manage annual open enrollment" so that "employees can select their benefits for the plan year"
    case ProcessEnrollment is {
      user EmployeeUser wants to "to enroll in benefits during open enrollment" so that "coverage is effective for the new plan year"
      step is "Employee reviews" "available benefit plans" "during open enrollment" with {
        briefly "Review plans"
        described as {
          |Browse available plans.
        }
      }
      step is "Employee selects" "benefit elections" "for the plan year" with {
        briefly "Select benefits"
        described as {
          |Choose plan elections.
        }
      }
    } with {
      briefly "Process enrollment"
      described as {
        |Employee enrolling in benefits during open enrollment.
      }
    }
  } with {
    briefly "Open enrollment process"
    described as {
      |Epic for annual open enrollment management.
    }
  }
  include "BenefitsContext.riddl"
  include "external-contexts.riddl"
  application context BenefitsAdministrationApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in BenefitsAdministration are delivered.
      }
    }
    outlet AppBenefitsEnrollmentCommands is type BenefitsContext.BenefitsEnrollment.BenefitsEnrollmentCommand
    inlet AppBenefitsRepositoryResponses is result BenefitsContext.BenefitsEnrollment.BenefitsEnrollmentResult    handler BenefitsAdministrationAppHandler is {
      on other is {
        error "Unexpected message for application context BenefitsAdministrationApp"
      }
    } with {
      briefly "BenefitsAdministrationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "BenefitsAdministrationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'BenefitsEnrollmentCommand Stream' is from outlet BenefitsAdministrationApp.AppBenefitsEnrollmentCommands to inlet BenefitsContext.BenefitsEnrollmentCommandStrIn with {
    briefly "BenefitsEnrollment commands from the application"
  }
  persistent connector 'BenefitsEnrollmentResult Stream' is from outlet BenefitsContext.BenefitsEnrollmentResultStreOut to inlet BenefitsAdministrationApp.AppBenefitsRepositoryResponses with {
    briefly "Benefits query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet BenefitsAdministrationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Benefits administration domain"
  described as {
    |Employee benefits enrollment, plan management, and compliance.
  }
}
