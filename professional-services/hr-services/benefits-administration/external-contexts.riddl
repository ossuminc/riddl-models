// Benefits Administration - External Contexts
external context InsuranceCarrier as split is {
  outlet InsuranceCarrierRepliesOut is result PlanDetails
 with {
    briefly "What this service answers, on its way back"
  }
  type InsuranceCarrierEvent is one of {
    EnrollmentFileAccepted or EnrollmentFileRejected
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet InsuranceCarrierEventsOut is type InsuranceCarrierEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type InsuranceCarrierRequest is one of {
    SubmitEnrollmentFile or GetPlanDetails
  } with {
    briefly "Everything this service can be asked"
  }
  inlet InsuranceCarrierRequests is type InsuranceCarrierRequest with {
    briefly "What this context asks the service to send"
  }
  handler InsuranceCarrierBoundary is {
    on query GetPlanDetails is {
      let askAnswer: type PlanDetails = prompt("look up what GetPlanDetails asks for")
      reply askAnswer
    }
    on command SubmitEnrollmentFile is {
      let enrollmentFileAccepted: type EnrollmentFileAccepted = prompt("the enrollment file accepted this produces")
      send enrollmentFileAccepted to outlet InsuranceCarrier.InsuranceCarrierEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context InsuranceCarrier"
    }
  } with {
    briefly "InsuranceCarrier boundary"
  }
  command SubmitEnrollmentFile is {
    carrierId: CarrierId with {
      briefly "Carrier"
      described as {
        |Carrier ID.
      }
    }
    enrollments: PlanElection+ with {
      briefly "Enrollments"
      described as {
        |Plan elections to submit.
      }
    }
    effectiveDate: Date with {
      briefly "Effective"
      described as {
        |Coverage effective date.
      }
    }
  } with {
    briefly "Submit enrollment file"
    described as {
      |Submits enrollment data to insurance carrier.
    }
  }
  event EnrollmentFileAccepted is {
    carrierId: CarrierId with {
      briefly "Carrier"
      described as {
        |Carrier ID.
      }
    }
    acceptedAt: TimeStamp with {
      briefly "Accepted"
      described as {
        |Acceptance time.
      }
    }
    recordCount: Natural with {
      briefly "Records"
      described as {
        |Number of records accepted.
      }
    }
  } with {
    briefly "Enrollment file accepted"
    described as {
      |Emitted when carrier accepts enrollment file.
    }
  }
  event EnrollmentFileRejected is {
    carrierId: CarrierId with {
      briefly "Carrier"
      described as {
        |Carrier ID.
      }
    }
    rejectedAt: TimeStamp with {
      briefly "Rejected"
      described as {
        |Rejection time.
      }
    }
    errors: String(3,500)+ with {
      briefly "Errors"
      described as {
        |Rejection errors.
      }
    }
  } with {
    briefly "Enrollment file rejected"
    described as {
      |Emitted when carrier rejects enrollment file.
    }
  }
  query GetPlanDetails replies result PlanDetails is {
    carrierId: CarrierId with {
      briefly "Carrier"
      described as {
        |Carrier ID.
      }
    }
    planId: PlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
  } with {
    briefly "Get plan details"
    described as {
      |Retrieves plan details from carrier.
    }
  }
  result PlanDetails is {
    planInfo: BenefitsPlanInfo with {
      briefly "Plan info"
      described as {
        |Plan details.
      }
    }
    premiumSchedule: Decimal(10,2)+ with {
      briefly "Premiums"
      described as {
        |Premium schedule.
      }
    }
    networkProviders: Natural with {
      briefly "Providers"
      described as {
        |Network provider count.
      }
    }
  } with {
    briefly "Plan details"
    described as {
      |Insurance plan details from carrier.
    }
  }
} with {
  briefly "External insurance carrier"
  described as {
    |Insurance carrier system for plan and enrollment management.
  }
}
external context PayrollSystem as split is {
  outlet PayrollSystemRepliesOut is result EmployeeCompensation
 with {
    briefly "What this service answers, on its way back"
  }
  outlet PayrollSystemEventsOut is event DeductionsUpdated
 with {
    briefly "What this service tells the model, unasked"
  }
  type PayrollSystemRequest is one of {
    UpdateDeductions or GetEmployeeCompensation
  } with {
    briefly "Everything this service can be asked"
  }
  inlet PayrollSystemRequests is type PayrollSystemRequest with {
    briefly "What this context asks the service to send"
  }
  handler PayrollSystemBoundary is {
    on query GetEmployeeCompensation is {
      let askAnswer: type EmployeeCompensation = prompt("look up what GetEmployeeCompensation asks for")
      reply askAnswer
    }
    on command UpdateDeductions is {
      let deductionsUpdated: type DeductionsUpdated = prompt("the deductions updated this produces")
      send deductionsUpdated to outlet PayrollSystem.PayrollSystemEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context PayrollSystem"
    }
  } with {
    briefly "PayrollSystem boundary"
  }
  command UpdateDeductions is {
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    elections: PlanElection+ with {
      briefly "Elections"
      described as {
        |Plan elections.
      }
    }
    effectiveDate: Date with {
      briefly "Effective"
      described as {
        |Deduction effective date.
      }
    }
  } with {
    briefly "Update deductions"
    described as {
      |Updates payroll deductions for benefit elections.
    }
  }
  event DeductionsUpdated is {
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    totalDeduction: Decimal(10,2) with {
      briefly "Total"
      described as {
        |Total per-period deduction.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Deductions updated"
    described as {
      |Emitted when payroll deductions are updated.
    }
  }
  query GetEmployeeCompensation replies result EmployeeCompensation is {
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
  } with {
    briefly "Get employee compensation"
    described as {
      |Retrieves employee compensation details.
    }
  }
  result EmployeeCompensation is {
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    annualSalary: Decimal(12,2) with {
      briefly "Salary"
      described as {
        |Annual salary.
      }
    }
    payFrequency: String(3,50) with {
      briefly "Frequency"
      described as {
        |Pay frequency.
      }
    }
  } with {
    briefly "Employee compensation"
    described as {
      |Employee compensation details.
    }
  }
} with {
  briefly "External payroll system"
  described as {
    |Payroll system for benefits deduction management.
  }
}
external context ComplianceReportingSystem as flow is {
  type ComplianceReportingSystemEvent is one of {
    AcaReportGenerated or CobraNoticeGenerated
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet ComplianceReportingSystemEventsOut is type ComplianceReportingSystemEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type ComplianceReportingSystemCommand is one of {
    GenerateAcaReport or GenerateCobraNotice
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet ComplianceReportingSystemRequests is type ComplianceReportingSystemCommand with {
    briefly "What this context asks the service to send"
  }
  handler ComplianceReportingSystemBoundary is {
    on command GenerateAcaReport is {
      let acaReportGenerated: type AcaReportGenerated = prompt("the aca report generated this produces")
      send acaReportGenerated to outlet ComplianceReportingSystem.ComplianceReportingSystemEventsOut
      do "deliver it to the recipient"
    }
    on command GenerateCobraNotice is {
      let cobraNoticeGenerated: type CobraNoticeGenerated = prompt("the cobra notice generated this produces")
      send cobraNoticeGenerated to outlet ComplianceReportingSystem.ComplianceReportingSystemEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context ComplianceReportingSystem"
    }
  } with {
    briefly "ComplianceReportingSystem boundary"
  }
  command GenerateAcaReport is {
    reportingYear: Year with {
      briefly "Year"
      described as {
        |ACA reporting year.
      }
    }
    employeeRecords: AcaReportingInfo+ with {
      briefly "Records"
      described as {
        |Employee ACA records.
      }
    }
  } with {
    briefly "Generate ACA report"
    described as {
      |Generates ACA compliance report.
    }
  }
  event AcaReportGenerated is {
    reportingYear: Year with {
      briefly "Year"
      described as {
        |Reporting year.
      }
    }
    generatedAt: TimeStamp with {
      briefly "Generated"
      described as {
        |Generation time.
      }
    }
    employeeCount: Natural with {
      briefly "Employees"
      described as {
        |Employee count.
      }
    }
  } with {
    briefly "ACA report generated"
    described as {
      |Emitted when ACA report is generated.
    }
  }
  command GenerateCobraNotice is {
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    cobraInfo: CobraInfo with {
      briefly "COBRA"
      described as {
        |COBRA details.
      }
    }
  } with {
    briefly "Generate COBRA notice"
    described as {
      |Generates COBRA election notice.
    }
  }
  event CobraNoticeGenerated is {
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    generatedAt: TimeStamp with {
      briefly "Generated"
      described as {
        |Generation time.
      }
    }
    electionDeadline: Date with {
      briefly "Deadline"
      described as {
        |Election deadline.
      }
    }
  } with {
    briefly "COBRA notice generated"
    described as {
      |Emitted when COBRA notice is generated.
    }
  }
} with {
  briefly "External compliance reporting"
  described as {
    |Compliance reporting system for ACA and COBRA.
  }
}
