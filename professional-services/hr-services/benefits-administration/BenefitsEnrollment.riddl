// Benefits Administration - BenefitsEnrollment Entity
entity BenefitsEnrollment as flow is {
  type BenefitsEnrollmentCommand is one of {
    BenefitsEnrollment.CreateEnrollment or BenefitsEnrollment.SelectPlan or BenefitsEnrollment.AddDependent or BenefitsEnrollment.RemoveDependent or BenefitsEnrollment.SubmitEnrollment or BenefitsEnrollment.ApproveEnrollment or BenefitsEnrollment.DenyEnrollment or BenefitsEnrollment.RecordLifeEvent or BenefitsEnrollment.InitiateCobra or BenefitsEnrollment.TerminateEnrollment
  } with {
    briefly "BenefitsEnrollment command alternation"
    described as {
      |Commands accepted by the BenefitsEnrollment entity.
    }
  }
  inlet BenefitsEnrollmentCommands is type BenefitsEnrollmentCommand  outlet BenefitsEnrollmentEvents2 is type BenefitsEnrollmentEvent
  query GetBenefitsEnrollment replies result BenefitsEnrollmentResult is  {
    enrollmentId: EnrollmentId with {
      briefly "ID"
      described as {
        |Identifier of the BenefitsEnrollment to retrieve.
      }
    }
  } with {
    briefly "Get BenefitsEnrollment"
    described as {
      |Retrieve BenefitsEnrollment data by identifier.
    }
  }
  result BenefitsEnrollmentResult is  {
    benefitsEnrollmentId: EnrollmentId with {
      briefly "BenefitsEnrollment addressed"
      described as {
        |Which benefitsenrollment this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    benefitsEnrollmentData: BenefitsEnrollment.ActiveEnrollmentData with {
      briefly "BenefitsEnrollment data"
      described as {
        |The requested BenefitsEnrollment data.
      }
    }
  } with {
    briefly "BenefitsEnrollment result"
    described as {
      |Result carrying the requested BenefitsEnrollment data.
    }
  }
  command CreateEnrollment is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment ID"
      described as {
        |New enrollment identifier.
      }
    }
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee identifier.
      }
    }
    planYear: Year with {
      briefly "Plan year"
      described as {
        |Benefits plan year.
      }
    }
  } with {
    briefly "Create enrollment"
    described as {
      |Creates a new benefits enrollment for an employee.
    }
  }
  command SelectPlan is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment ID"
      described as {
        |Enrollment identifier.
      }
    }
    election: PlanElection with {
      briefly "Election"
      described as {
        |Plan election details.
      }
    }
  } with {
    briefly "Select plan"
    described as {
      |Selects a benefits plan for the enrollment.
    }
  }
  command AddDependent is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment ID"
      described as {
        |Enrollment identifier.
      }
    }
    dependent: DependentInfo with {
      briefly "Dependent"
      described as {
        |Dependent to add.
      }
    }
  } with {
    briefly "Add dependent"
    described as {
      |Adds a dependent to the enrollment.
    }
  }
  command RemoveDependent is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment ID"
      described as {
        |Enrollment identifier.
      }
    }
    dependentId: DependentId with {
      briefly "Dependent ID"
      described as {
        |Dependent to remove.
      }
    }
  } with {
    briefly "Remove dependent"
    described as {
      |Removes a dependent from the enrollment.
    }
  }
  command SubmitEnrollment is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment ID"
      described as {
        |Enrollment identifier.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission timestamp.
      }
    }
  } with {
    briefly "Submit enrollment"
    described as {
      |Submits enrollment elections for approval.
    }
  }
  command ApproveEnrollment is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment ID"
      described as {
        |Enrollment identifier.
      }
    }
    approvedBy: String(3,100) with {
      briefly "Approved by"
      described as {
        |Person approving the enrollment.
      }
    }
  } with {
    briefly "Approve enrollment"
    described as {
      |Approves enrollment elections.
    }
  }
  command DenyEnrollment is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment ID"
      described as {
        |Enrollment identifier.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Denial reason.
      }
    }
  } with {
    briefly "Deny enrollment"
    described as {
      |Denies enrollment elections.
    }
  }
  command RecordLifeEvent is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment ID"
      described as {
        |Enrollment identifier.
      }
    }
    lifeEvent: LifeEventInfo with {
      briefly "Life event"
      described as {
        |Qualifying life event details.
      }
    }
  } with {
    briefly "Record life event"
    described as {
      |Records a qualifying life event for mid-year changes.
    }
  }
  command InitiateCobra is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment ID"
      described as {
        |Enrollment identifier.
      }
    }
    cobraInfo: CobraInfo with {
      briefly "COBRA info"
      described as {
        |COBRA continuation details.
      }
    }
  } with {
    briefly "Initiate COBRA"
    described as {
      |Initiates COBRA continuation coverage.
    }
  }
  command TerminateEnrollment is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment ID"
      described as {
        |Enrollment identifier.
      }
    }
    terminationDate: Date with {
      briefly "Termination date"
      described as {
        |Coverage termination date.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Termination reason.
      }
    }
  } with {
    briefly "Terminate enrollment"
    described as {
      |Terminates benefits enrollment.
    }
  }
  // Events
  event EnrollmentCreated is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment"
      described as {
        |Enrollment ID.
      }
    }
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Enrollment created"
    described as {
      |Emitted when enrollment is created.
    }
  }
  event PlanSelected is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment"
      described as {
        |Enrollment ID.
      }
    }
    election: PlanElection with {
      briefly "Election"
      described as {
        |Plan election.
      }
    }
    selectedAt: TimeStamp with {
      briefly "Selected"
      described as {
        |Selection time.
      }
    }
  } with {
    briefly "Plan selected"
    described as {
      |Emitted when a plan is selected.
    }
  }
  event DependentAdded is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment"
      described as {
        |Enrollment ID.
      }
    }
    dependent: DependentInfo with {
      briefly "Dependent"
      described as {
        |Added dependent.
      }
    }
    addedAt: TimeStamp with {
      briefly "Added"
      described as {
        |Addition time.
      }
    }
  } with {
    briefly "Dependent added"
    described as {
      |Emitted when a dependent is added.
    }
  }
  event DependentRemoved is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment"
      described as {
        |Enrollment ID.
      }
    }
    dependentId: DependentId with {
      briefly "Dependent"
      described as {
        |Removed dependent.
      }
    }
    removedAt: TimeStamp with {
      briefly "Removed"
      described as {
        |Removal time.
      }
    }
  } with {
    briefly "Dependent removed"
    described as {
      |Emitted when a dependent is removed.
    }
  }
  event EnrollmentSubmitted is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment"
      described as {
        |Enrollment ID.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Enrollment submitted"
    described as {
      |Emitted when enrollment is submitted.
    }
  }
  event EnrollmentApproved is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment"
      described as {
        |Enrollment ID.
      }
    }
    approvedBy: String(3,100) with {
      briefly "Approved by"
      described as {
        |Approver.
      }
    }
    approvedAt: TimeStamp with {
      briefly "Approved"
      described as {
        |Approval time.
      }
    }
  } with {
    briefly "Enrollment approved"
    described as {
      |Emitted when enrollment is approved.
    }
  }
  event EnrollmentDenied is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment"
      described as {
        |Enrollment ID.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Denial reason.
      }
    }
    deniedAt: TimeStamp with {
      briefly "Denied"
      described as {
        |Denial time.
      }
    }
  } with {
    briefly "Enrollment denied"
    described as {
      |Emitted when enrollment is denied.
    }
  }
  event LifeEventRecorded is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment"
      described as {
        |Enrollment ID.
      }
    }
    lifeEvent: LifeEventInfo with {
      briefly "Life event"
      described as {
        |Recorded life event.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Recording time.
      }
    }
  } with {
    briefly "Life event recorded"
    described as {
      |Emitted when a qualifying life event is recorded.
    }
  }
  event CobraInitiated is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment"
      described as {
        |Enrollment ID.
      }
    }
    cobraInfo: CobraInfo with {
      briefly "COBRA"
      described as {
        |COBRA details.
      }
    }
    initiatedAt: TimeStamp with {
      briefly "Initiated"
      described as {
        |Initiation time.
      }
    }
  } with {
    briefly "COBRA initiated"
    described as {
      |Emitted when COBRA coverage is initiated.
    }
  }
  event EnrollmentTerminated is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment"
      described as {
        |Enrollment ID.
      }
    }
    terminationDate: Date with {
      briefly "Termination"
      described as {
        |Termination date.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Termination reason.
      }
    }
    terminatedAt: TimeStamp with {
      briefly "Terminated"
      described as {
        |Termination time.
      }
    }
  } with {
    briefly "Enrollment terminated"
    described as {
      |Emitted when enrollment is terminated.
    }
  }
  // States
  record ActiveEnrollmentData is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment"
      described as {
        |Enrollment ID.
      }
    }
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    planYear: Year with {
      briefly "Plan year"
      described as {
        |Benefits plan year.
      }
    }
    status: EnrollmentStatus with {
      briefly "Status"
      described as {
        |Enrollment status.
      }
    }
    updatedElections: PlanElection* with {
      briefly "Elections"
      described as {
        |Plan elections.
      }
    }
    dependents: DependentInfo* with {
      briefly "Dependents"
      described as {
        |Enrolled dependents.
      }
    }
    lifeEvents: LifeEventInfo* with {
      briefly "Life events"
      described as {
        |Qualifying life events.
      }
    }
    updatedCobraInfo: CobraInfo? with {
      briefly "COBRA"
      described as {
        |COBRA coverage info.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Active enrollment state"
    described as {
      |State for an active benefits enrollment.
    }
  }
  record TerminatedEnrollmentData is  {
    enrollmentId: EnrollmentId with {
      briefly "Enrollment"
      described as {
        |Enrollment ID.
      }
    }
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    terminationDate: Date with {
      briefly "Termination"
      described as {
        |Termination date.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Termination reason.
      }
    }
    terminatedAt: TimeStamp with {
      briefly "Terminated"
      described as {
        |Termination time.
      }
    }
  } with {
    briefly "Terminated enrollment state"
    described as {
      |State for a terminated benefits enrollment.
    }
  }
  initial state ActiveEnrollment of record BenefitsEnrollment.ActiveEnrollmentData is {
    initial handler ActiveEnrollmentInitHandler is {
      on query GetBenefitsEnrollment is {
        let benefitsEnrollmentResult: type BenefitsEnrollmentResult = prompt("read the benefits enrollment from the store")
        reply benefitsEnrollmentResult
      }
      on init is {
        set state ActiveEnrollment to "initialize BenefitsEnrollment.ActiveEnrollmentData fields from the creating message"
      }
    } with {
      briefly "ActiveEnrollment initialization"
      described as {
        |Initializes ActiveEnrollment from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Active enrollment"
    described as {
      |The active enrollment of the BenefitsEnrollment entity, carrying ActiveEnrollmentData.
    }
  }
  state TerminatedEnrollment of record BenefitsEnrollment.TerminatedEnrollmentData with {
    briefly "Terminated enrollment"
    described as {
      |The terminated enrollment of the BenefitsEnrollment entity, carrying TerminatedEnrollmentData.
    }
  }
  handler BenefitsEnrollmentHandler is {
    on init is {
      set state TerminatedEnrollment to "initialize BenefitsEnrollment.TerminatedEnrollmentData fields from the creating message"
    }
    on createEnrollment: command CreateEnrollment is {
      morph entity BenefitsContext.BenefitsEnrollment to state BenefitsContext.BenefitsEnrollment.ActiveEnrollment with record BenefitsEnrollment.ActiveEnrollmentData(enrollmentId = createEnrollment.enrollmentId, employeeId = createEnrollment.employeeId, planYear = createEnrollment.planYear, status = prompt("the status of this active enrollment data"), updatedElections = empty, dependents = empty, lifeEvents = empty, updatedCobraInfo = empty, createdAt = prompt("the created at of this active enrollment data"))
      tell event EnrollmentCreated(enrollmentId = createEnrollment.enrollmentId, employeeId = createEnrollment.employeeId, createdAt = prompt("the created at of this enrollment created")) to entity BenefitsContext.BenefitsEnrollment
    }
    on selectPlan: command SelectPlan is {
      tell event PlanSelected(enrollmentId = selectPlan.enrollmentId, election = selectPlan.election, selectedAt = prompt("the selected at of this plan selected")) to entity BenefitsContext.BenefitsEnrollment
    }
    on addDependent: command AddDependent is {
      tell event DependentAdded(enrollmentId = addDependent.enrollmentId, dependent = addDependent.dependent, addedAt = prompt("the added at of this dependent added")) to entity BenefitsContext.BenefitsEnrollment
    }
    on removeDependent: command RemoveDependent is {
      tell event DependentRemoved(enrollmentId = removeDependent.enrollmentId, dependentId = removeDependent.dependentId, removedAt = prompt("the removed at of this dependent removed")) to entity BenefitsContext.BenefitsEnrollment
    }
    on submitEnrollment: command SubmitEnrollment is {
      tell event EnrollmentSubmitted(enrollmentId = submitEnrollment.enrollmentId, submittedAt = submitEnrollment.submittedAt) to entity BenefitsContext.BenefitsEnrollment
    }
    on approveEnrollment: command ApproveEnrollment is {
      tell event EnrollmentApproved(enrollmentId = approveEnrollment.enrollmentId, approvedBy = approveEnrollment.approvedBy, approvedAt = prompt("the approved at of this enrollment approved")) to entity BenefitsContext.BenefitsEnrollment
    }
    on denyEnrollment: command DenyEnrollment is {
      tell event EnrollmentDenied(enrollmentId = denyEnrollment.enrollmentId, reason = denyEnrollment.reason, deniedAt = prompt("the denied at of this enrollment denied")) to entity BenefitsContext.BenefitsEnrollment
    }
    on recordLifeEvent: command RecordLifeEvent is {
      tell event LifeEventRecorded(enrollmentId = recordLifeEvent.enrollmentId, lifeEvent = recordLifeEvent.lifeEvent, recordedAt = prompt("the recorded at of this life event recorded")) to entity BenefitsContext.BenefitsEnrollment
    }
    on initiateCobra: command InitiateCobra is {
      tell event CobraInitiated(enrollmentId = initiateCobra.enrollmentId, cobraInfo = initiateCobra.cobraInfo, initiatedAt = prompt("the initiated at of this cobra initiated")) to entity BenefitsContext.BenefitsEnrollment
    }
    on terminateEnrollment: command TerminateEnrollment is {
      morph entity BenefitsContext.BenefitsEnrollment to state BenefitsContext.BenefitsEnrollment.TerminatedEnrollment with record BenefitsEnrollment.TerminatedEnrollmentData(enrollmentId = terminateEnrollment.enrollmentId, terminationDate = terminateEnrollment.terminationDate, reason = terminateEnrollment.reason, employeeId = prompt("the employee id of this terminated enrollment data"), terminatedAt = prompt("the terminated at of this terminated enrollment data"))
      tell event EnrollmentTerminated(enrollmentId = terminateEnrollment.enrollmentId, terminationDate = terminateEnrollment.terminationDate, reason = terminateEnrollment.reason, terminatedAt = prompt("the terminated at of this enrollment terminated")) to entity BenefitsContext.BenefitsEnrollment
    }
    on cobraInitiated: event CobraInitiated is {
      do "apply CobraInitiated to the benefitsEnrollment so it can be persisted and replayed"
    }
    on dependentAdded: event DependentAdded is {
      do "apply DependentAdded to the benefitsEnrollment so it can be persisted and replayed"
    }
    on dependentRemoved: event DependentRemoved is {
      do "apply DependentRemoved to the benefitsEnrollment so it can be persisted and replayed"
    }
    on enrollmentApproved: event EnrollmentApproved is {
      do "apply EnrollmentApproved to the benefitsEnrollment so it can be persisted and replayed"
    }
    on enrollmentCreated: event EnrollmentCreated is {
      do "apply EnrollmentCreated to the benefitsEnrollment so it can be persisted and replayed"
    }
    on enrollmentDenied: event EnrollmentDenied is {
      do "apply EnrollmentDenied to the benefitsEnrollment so it can be persisted and replayed"
    }
    on enrollmentSubmitted: event EnrollmentSubmitted is {
      do "apply EnrollmentSubmitted to the benefitsEnrollment so it can be persisted and replayed"
    }
    on enrollmentTerminated: event EnrollmentTerminated is {
      do "apply EnrollmentTerminated to the benefitsEnrollment so it can be persisted and replayed"
    }
    on lifeEventRecorded: event LifeEventRecorded is {
      do "apply LifeEventRecorded to the benefitsEnrollment so it can be persisted and replayed"
    }
    on planSelected: event PlanSelected is {
      do "apply PlanSelected to the benefitsEnrollment so it can be persisted and replayed"
    }
  } with {
    briefly "Processes enrollment commands"
    described as {
      |Handles benefits enrollment lifecycle.
    }
  }
} with {
  briefly "BenefitsEnrollment aggregate"
  described as {
    |Manages employee benefits enrollments.
  }
}
