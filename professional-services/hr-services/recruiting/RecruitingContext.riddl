// Recruiting - Recruiting Context
context RecruitingContext is {
  include "types.riddl"
  include "JobRequisition.riddl"
  repository RecruitingRepository is {
    schema RecruitingData is relational
      of jobRequisitions as type JobRequisition
        index on field JobRequisition.requisitionId
        index on field JobRequisition.requisitionInfo.hiringManagerId
        index on field JobRequisition.status

    handler RecruitingPersistence is {
      on command JobRequisition.CreateRequisition is {
        tell event JobRequisition.RequisitionCreated to entity RecruitingContext.JobRequisition
        prompt "Store new job requisition"
      }
      on command JobRequisition.ApproveRequisition is {
        tell event JobRequisition.RequisitionApproved to entity RecruitingContext.JobRequisition
        prompt "Update requisition to approved"
      }
      on command JobRequisition.AddCandidate is {
        tell event JobRequisition.CandidateAdded to entity RecruitingContext.JobRequisition
        prompt "Add candidate to requisition pipeline"
      }
      on command JobRequisition.ScheduleInterview is {
        tell event JobRequisition.InterviewScheduled to entity RecruitingContext.JobRequisition
        prompt "Store interview schedule"
      }
      on command JobRequisition.ExtendOffer is {
        prompt "Store offer details"
      }
      on command JobRequisition.AcceptOffer is {
        prompt "Update candidate and requisition to hired and mark as filled"
      }
    } with {
      briefly "Persists recruiting commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Recruiting data persistence"
    described as {
      |Persistent storage for recruiting data.
    }
  }
  projector RecruitingMetrics is {
    updates repository RecruitingContext.RecruitingRepository
    record PipelineMetrics is  {
      openRequisitions: Natural with {
        briefly "Open"
        described as {
          |Open requisitions.
        }
      }
      totalCandidates: Natural with {
        briefly "Candidates"
        described as {
          |Total candidates in pipeline.
        }
      }
      interviewsScheduled: Natural with {
        briefly "Interviews"
        described as {
          |Interviews scheduled.
        }
      }
      offersExtended: Natural with {
        briefly "Offers"
        described as {
          |Offers extended.
        }
      }
      offerAcceptanceRate: Decimal(5,2) with {
        briefly "Accept rate"
        described as {
          |Offer acceptance percentage.
        }
      }
      averageTimeToFill: Decimal(8,2) with {
        briefly "Time to fill"
        described as {
          |Average days to fill a requisition.
        }
      }
    } with {
      briefly "Pipeline metrics"
      described as {
        |Recruiting pipeline analytics.
      }
    }
    handler MetricsHandler is {
      on event JobRequisition.RequisitionCreated is {
        tell event JobRequisition.RequisitionCreated to repository RecruitingContext.RecruitingRepository
        prompt "Increment open requisitions"
      }
      on event JobRequisition.CandidateAdded is {
        tell event JobRequisition.CandidateAdded to repository RecruitingContext.RecruitingRepository
        prompt "Increment total candidates"
      }
      on event JobRequisition.InterviewScheduled is {
        tell event JobRequisition.InterviewScheduled to repository RecruitingContext.RecruitingRepository
        prompt "Increment interviews scheduled"
      }
      on event JobRequisition.OfferExtended is {
        tell event JobRequisition.OfferExtended to repository RecruitingContext.RecruitingRepository
        prompt "Increment offers extended"
      }
      on event JobRequisition.OfferAccepted is {
        tell event JobRequisition.OfferAccepted to repository RecruitingContext.RecruitingRepository
        prompt "Update acceptance rate and decrement open requisitions"
      }
      on event JobRequisition.RequisitionFilled is {
        tell event JobRequisition.RequisitionFilled to repository RecruitingContext.RecruitingRepository
        prompt "Calculate time to fill"
      }
    } with {
      briefly "Maintains recruiting metrics"
      described as {
        |Projects events into recruiting analytics.
      }
    }
  } with {
    briefly "Recruiting metrics"
    described as {
      |Talent acquisition analytics and reporting.
    }
  }
  // ---- Event publication for JobRequisition ----
  type JobRequisitionEvent is one of {
    RecruitingContext.JobRequisition.RequisitionCreated,
    RecruitingContext.JobRequisition.RequisitionApproved,
    RecruitingContext.JobRequisition.CandidateAdded,
    RecruitingContext.JobRequisition.CandidateScreened,
    RecruitingContext.JobRequisition.InterviewScheduled,
    RecruitingContext.JobRequisition.InterviewFeedbackRecorded,
    RecruitingContext.JobRequisition.OfferExtended,
    RecruitingContext.JobRequisition.OfferAccepted,
    RecruitingContext.JobRequisition.OfferDeclined,
    RecruitingContext.JobRequisition.CandidateRejected,
    RecruitingContext.JobRequisition.RequisitionCancelled,
    RecruitingContext.JobRequisition.RequisitionPutOnHold,
    RecruitingContext.JobRequisition.RequisitionFilled
  } with {
    briefly "JobRequisition event alternation"
    described as {
      |Union of all JobRequisition events, for streaming and event-sourced
      |persistence.
    }
  }
  source JobRequisitionEventSource is {
    outlet JobRequisitionEvents is type JobRequisitionEvent
    handler JobRequisitionSourceHandler is {
      on event JobRequisition.RequisitionCreated is {
        send event JobRequisition.RequisitionCreated to outlet JobRequisitionEvents
      }
      on event JobRequisition.RequisitionApproved is {
        send event JobRequisition.RequisitionApproved to outlet JobRequisitionEvents
      }
      on event JobRequisition.CandidateAdded is {
        send event JobRequisition.CandidateAdded to outlet JobRequisitionEvents
      }
      on event JobRequisition.CandidateScreened is {
        send event JobRequisition.CandidateScreened to outlet JobRequisitionEvents
      }
      on event JobRequisition.InterviewScheduled is {
        send event JobRequisition.InterviewScheduled to outlet JobRequisitionEvents
      }
      on event JobRequisition.InterviewFeedbackRecorded is {
        send event JobRequisition.InterviewFeedbackRecorded to outlet JobRequisitionEvents
      }
      on event JobRequisition.OfferExtended is {
        send event JobRequisition.OfferExtended to outlet JobRequisitionEvents
      }
      on event JobRequisition.OfferAccepted is {
        send event JobRequisition.OfferAccepted to outlet JobRequisitionEvents
      }
      on event JobRequisition.OfferDeclined is {
        send event JobRequisition.OfferDeclined to outlet JobRequisitionEvents
      }
      on event JobRequisition.CandidateRejected is {
        send event JobRequisition.CandidateRejected to outlet JobRequisitionEvents
      }
      on event JobRequisition.RequisitionCancelled is {
        send event JobRequisition.RequisitionCancelled to outlet JobRequisitionEvents
      }
      on event JobRequisition.RequisitionPutOnHold is {
        send event JobRequisition.RequisitionPutOnHold to outlet JobRequisitionEvents
      }
      on event JobRequisition.RequisitionFilled is {
        send event JobRequisition.RequisitionFilled to outlet JobRequisitionEvents
      }
      on other is {
        error "Unexpected message for source JobRequisitionEventSource"
      }
    } with {
      briefly "JobRequisition source handler"
      described as {
        |Publishes JobRequisition events onto the outlet.
      }
    }
  } with {
    briefly "JobRequisition event source"
    described as {
      |Publishes JobRequisition entity events into the streaming topology.
    }
  }
  sink JobRequisitionEventSink is {
    inlet JobRequisitionInlet is type JobRequisitionEvent
    handler JobRequisitionSinkHandler is {
      on event JobRequisition.RequisitionCreated is {
        tell event JobRequisition.RequisitionCreated to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.RequisitionApproved is {
        tell event JobRequisition.RequisitionApproved to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.CandidateAdded is {
        tell event JobRequisition.CandidateAdded to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.CandidateScreened is {
        tell event JobRequisition.CandidateScreened to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.InterviewScheduled is {
        tell event JobRequisition.InterviewScheduled to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.InterviewFeedbackRecorded is {
        tell event JobRequisition.InterviewFeedbackRecorded to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.OfferExtended is {
        tell event JobRequisition.OfferExtended to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.OfferAccepted is {
        tell event JobRequisition.OfferAccepted to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.OfferDeclined is {
        tell event JobRequisition.OfferDeclined to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.CandidateRejected is {
        tell event JobRequisition.CandidateRejected to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.RequisitionCancelled is {
        tell event JobRequisition.RequisitionCancelled to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.RequisitionPutOnHold is {
        tell event JobRequisition.RequisitionPutOnHold to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.RequisitionFilled is {
        tell event JobRequisition.RequisitionFilled to repository RecruitingContext.RecruitingRepository
      }
      on other is {
        error "Unexpected message for sink JobRequisitionEventSink"
      }
    } with {
      briefly "JobRequisition sink handler"
      described as {
        |Persists JobRequisition events via the repository.
      }
    }
  } with {
    briefly "JobRequisition event sink"
    described as {
      |Receives JobRequisition events for persistence.
    }
  }
  connector JobRequisitionEventFlow is {
    from outlet RecruitingContext.JobRequisitionEventSource.JobRequisitionEvents to
      inlet RecruitingContext.JobRequisitionEventSink.JobRequisitionInlet
  } with {
    briefly "JobRequisition event flow"
    described as {
      |Connects the JobRequisition source to its sink.
    }
  }
} with {
  briefly "Bounded context for recruiting"
  described as {
    |Talent acquisition and applicant tracking context.
  }
}
