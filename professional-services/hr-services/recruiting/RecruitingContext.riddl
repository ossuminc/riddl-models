// Recruiting - Recruiting Context
context RecruitingContext as router is {
  inlet JobRequisitionCommandStreamIn is type JobRequisitionCommand  outlet JobRequisitionCommandStreamOut is type JobRequisitionCommand
  inlet JobRequisitionResultStreamIn is type JobRequisition.JobRequisitionResult  outlet JobRequisitionResultStreamOut is type JobRequisition.JobRequisitionResult
  handler RecruitingContextBoundary is {
    on createRequisition: command JobRequisition.CreateRequisition is {
      send createRequisition to outlet RecruitingContext.JobRequisitionCommandStreamOut
    }
    on approveRequisition: command JobRequisition.ApproveRequisition is {
      send approveRequisition to outlet RecruitingContext.JobRequisitionCommandStreamOut
    }
    on addCandidate: command JobRequisition.AddCandidate is {
      send addCandidate to outlet RecruitingContext.JobRequisitionCommandStreamOut
    }
    on screenCandidate: command JobRequisition.ScreenCandidate is {
      send screenCandidate to outlet RecruitingContext.JobRequisitionCommandStreamOut
    }
    on scheduleInterview: command JobRequisition.ScheduleInterview is {
      send scheduleInterview to outlet RecruitingContext.JobRequisitionCommandStreamOut
    }
    on recordInterviewFeedback: command JobRequisition.RecordInterviewFeedback is {
      send recordInterviewFeedback to outlet RecruitingContext.JobRequisitionCommandStreamOut
    }
    on extendOffer: command JobRequisition.ExtendOffer is {
      send extendOffer to outlet RecruitingContext.JobRequisitionCommandStreamOut
    }
    on acceptOffer: command JobRequisition.AcceptOffer is {
      send acceptOffer to outlet RecruitingContext.JobRequisitionCommandStreamOut
    }
    on declineOffer: command JobRequisition.DeclineOffer is {
      send declineOffer to outlet RecruitingContext.JobRequisitionCommandStreamOut
    }
    on rejectCandidate: command JobRequisition.RejectCandidate is {
      send rejectCandidate to outlet RecruitingContext.JobRequisitionCommandStreamOut
    }
    on cancelRequisition: command JobRequisition.CancelRequisition is {
      send cancelRequisition to outlet RecruitingContext.JobRequisitionCommandStreamOut
    }
    on putRequisitionOnHold: command JobRequisition.PutRequisitionOnHold is {
      send putRequisitionOnHold to outlet RecruitingContext.JobRequisitionCommandStreamOut
    }
    on jobRequisitionResult: result JobRequisition.JobRequisitionResult is {
      send jobRequisitionResult to outlet RecruitingContext.JobRequisitionResultStreamOut
    }
    on other is {
      error "Unexpected message at the RecruitingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'JobRequisitionCommand Stream Intake' is from outlet RecruitingContext.JobRequisitionCommandStreamOut to inlet RecruitingContext.JobRequisition.JobRequisitionCommands  connector 'JobRequisitionResult Stream Egress' is from outlet RecruitingContext.RecruitingRepository.RecruitingRepositoryResponses to inlet RecruitingContext.JobRequisitionResultStreamIn  adaptor FromBackgroundCheckService from context BackgroundCheckService is { 
    handler FromBackgroundCheckServiceHandler is {
      on event BackgroundCheckService.BackgroundCheckCompleted is {
        do "the model receives background check completed"
      }
      on result BackgroundCheckService.CheckStatus is {
        do "the model receives check status"
      }
      on other is {
        error "Unexpected message for adaptor FromBackgroundCheckService"
      }
    } with {
      briefly "from background check service"
      described as {
        |Carries messages from the external BackgroundCheckService.
      }
    }
  } with {
    briefly "BackgroundCheckService integration"
    described as {
      |The model's side of the BackgroundCheckService conversation.
    }
  }
  adaptor ToBackgroundCheckService to context BackgroundCheckService is { 
    handler ToBackgroundCheckServiceHandler is {
      on query BackgroundCheckService.GetCheckStatus is {
        do "the model sends get check status"
      }
      on command BackgroundCheckService.InitiateBackgroundCheck is {
        do "the model sends initiate background check"
      }
      on other is {
        error "Unexpected message for adaptor ToBackgroundCheckService"
      }
    } with {
      briefly "to background check service"
      described as {
        |Carries messages to the external BackgroundCheckService.
      }
    }
  } with {
    briefly "BackgroundCheckService integration"
    described as {
      |The model's side of the BackgroundCheckService conversation.
    }
  }
  adaptor FromJobBoardIntegration from context JobBoardIntegration is { 
    handler FromJobBoardIntegrationHandler is {
      on result JobBoardIntegration.BoardApplications is {
        do "the model receives board applications"
      }
      on event JobBoardIntegration.JobListingPosted is {
        do "the model receives job listing posted"
      }
      on event JobBoardIntegration.JobListingRemoved is {
        do "the model receives job listing removed"
      }
      on other is {
        error "Unexpected message for adaptor FromJobBoardIntegration"
      }
    } with {
      briefly "from job board integration"
      described as {
        |Carries messages from the external JobBoardIntegration.
      }
    }
  } with {
    briefly "JobBoardIntegration integration"
    described as {
      |The model's side of the JobBoardIntegration conversation.
    }
  }
  adaptor ToJobBoardIntegration to context JobBoardIntegration is { 
    handler ToJobBoardIntegrationHandler is {
      on query JobBoardIntegration.GetApplicationsFromBoard is {
        do "the model sends get applications from board"
      }
      on command JobBoardIntegration.PostJobListing is {
        do "the model sends post job listing"
      }
      on command JobBoardIntegration.RemoveJobListing is {
        do "the model sends remove job listing"
      }
      on other is {
        error "Unexpected message for adaptor ToJobBoardIntegration"
      }
    } with {
      briefly "to job board integration"
      described as {
        |Carries messages to the external JobBoardIntegration.
      }
    }
  } with {
    briefly "JobBoardIntegration integration"
    described as {
      |The model's side of the JobBoardIntegration conversation.
    }
  }
  include "types.riddl"
  include "JobRequisition.riddl"
  type RecruitingRepositoryCommand is one of {
    RecruitingContext.RecruitingRepository.PersistCandidateAdded or RecruitingContext.RecruitingRepository.PersistCandidateRejected or RecruitingContext.RecruitingRepository.PersistCandidateScreened or RecruitingContext.RecruitingRepository.PersistInterviewFeedbackRecorded or RecruitingContext.RecruitingRepository.PersistInterviewScheduled or RecruitingContext.RecruitingRepository.PersistOfferAccepted or RecruitingContext.RecruitingRepository.PersistOfferDeclined or RecruitingContext.RecruitingRepository.PersistOfferExtended or RecruitingContext.RecruitingRepository.PersistRequisitionApproved or RecruitingContext.RecruitingRepository.PersistRequisitionCancelled or RecruitingContext.RecruitingRepository.PersistRequisitionCreated or RecruitingContext.RecruitingRepository.PersistRequisitionFilled or RecruitingContext.RecruitingRepository.PersistRequisitionPutOnHold
  } with {
    briefly "Anything that writes RecruitingRepository"
    described as {
      |The persistence commands RecruitingRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository RecruitingRepository as flow is {
    inlet RecruitingRepositoryFromRecruitingMetrics is type RecruitingRepositoryCommand
    command PersistCandidateRejected is  {
      requisitionId: RequisitionId with {
        briefly "Row addressed"
        described as {
          |Which stored row CandidateRejected applies to.
        }
      }
    } with {
      briefly "Persist CandidateRejected"
      described as {
        |Instructs this repository to apply CandidateRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCandidateScreened is  {
      requisitionId: RequisitionId with {
        briefly "Row addressed"
        described as {
          |Which stored row CandidateScreened applies to.
        }
      }
    } with {
      briefly "Persist CandidateScreened"
      described as {
        |Instructs this repository to apply CandidateScreened to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInterviewFeedbackRecorded is  {
      requisitionId: RequisitionId with {
        briefly "Row addressed"
        described as {
          |Which stored row InterviewFeedbackRecorded applies to.
        }
      }
    } with {
      briefly "Persist InterviewFeedbackRecorded"
      described as {
        |Instructs this repository to apply InterviewFeedbackRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOfferDeclined is  {
      requisitionId: RequisitionId with {
        briefly "Row addressed"
        described as {
          |Which stored row OfferDeclined applies to.
        }
      }
    } with {
      briefly "Persist OfferDeclined"
      described as {
        |Instructs this repository to apply OfferDeclined to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRequisitionApproved is  {
      requisitionId: RequisitionId with {
        briefly "Row addressed"
        described as {
          |Which stored row RequisitionApproved applies to.
        }
      }
    } with {
      briefly "Persist RequisitionApproved"
      described as {
        |Instructs this repository to apply RequisitionApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRequisitionCancelled is  {
      requisitionId: RequisitionId with {
        briefly "Row addressed"
        described as {
          |Which stored row RequisitionCancelled applies to.
        }
      }
    } with {
      briefly "Persist RequisitionCancelled"
      described as {
        |Instructs this repository to apply RequisitionCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRequisitionPutOnHold is  {
      requisitionId: RequisitionId with {
        briefly "Row addressed"
        described as {
          |Which stored row RequisitionPutOnHold applies to.
        }
      }
    } with {
      briefly "Persist RequisitionPutOnHold"
      described as {
        |Instructs this repository to apply RequisitionPutOnHold to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCandidateAdded is  {
      requisitionId: RequisitionId with {
        briefly "Row addressed"
        described as {
          |Which stored row CandidateAdded applies to.
        }
      }
    } with {
      briefly "Persist CandidateAdded"
      described as {
        |Instructs this repository to apply CandidateAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInterviewScheduled is  {
      requisitionId: RequisitionId with {
        briefly "Row addressed"
        described as {
          |Which stored row InterviewScheduled applies to.
        }
      }
    } with {
      briefly "Persist InterviewScheduled"
      described as {
        |Instructs this repository to apply InterviewScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOfferAccepted is  {
      requisitionId: RequisitionId with {
        briefly "Row addressed"
        described as {
          |Which stored row OfferAccepted applies to.
        }
      }
    } with {
      briefly "Persist OfferAccepted"
      described as {
        |Instructs this repository to apply OfferAccepted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOfferExtended is  {
      requisitionId: RequisitionId with {
        briefly "Row addressed"
        described as {
          |Which stored row OfferExtended applies to.
        }
      }
    } with {
      briefly "Persist OfferExtended"
      described as {
        |Instructs this repository to apply OfferExtended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRequisitionCreated is  {
      requisitionId: RequisitionId with {
        briefly "Row addressed"
        described as {
          |Which stored row RequisitionCreated applies to.
        }
      }
    } with {
      briefly "Persist RequisitionCreated"
      described as {
        |Instructs this repository to apply RequisitionCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRequisitionFilled is  {
      requisitionId: RequisitionId with {
        briefly "Row addressed"
        described as {
          |Which stored row RequisitionFilled applies to.
        }
      }
    } with {
      briefly "Persist RequisitionFilled"
      described as {
        |Instructs this repository to apply RequisitionFilled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet RecruitingRepositoryResponses is type JobRequisition.JobRequisitionResult
    record StoredJobRequisition is  {
      jobRequisitionId: UUID with {
        briefly "jobRequisitionId"
        described as {
          |The jobRequisitionId column of the stored jobRequisition row.
        }
      }
      requisitionId: RequisitionId with {
        briefly "requisitionId"
        described as {
          |The requisitionId column of the stored jobRequisition row.
        }
      }
      requisitionInfo: RequisitionInfo with {
        briefly "requisitionInfo"
        described as {
          |The requisitionInfo column of the stored jobRequisition row.
        }
      }
      status: RequisitionStatus with {
        briefly "status"
        described as {
          |The status column of the stored jobRequisition row.
        }
      }
    } with {
      briefly "Stored jobRequisition row"
      described as {
        |The persistence shape of jobRequisition data as this repository stores it.
      }
    }
    schema RecruitingData is relational
      of jobRequisitions as type StoredJobRequisition
        index on field StoredJobRequisition.requisitionId
        index on field StoredJobRequisition.requisitionInfo.hiringManagerId
        index on field StoredJobRequisition.status
 with {
      briefly "Recruiting data schema"
      described as {
        |The relational schema holding recruiting data for the RecruitingRepository.
      }
    }
    handler RecruitingPersistence is {
      on persistCandidateRejected: command PersistCandidateRejected is {
        do "apply CandidateRejected to the stored row"
      }
      on persistCandidateScreened: command PersistCandidateScreened is {
        do "apply CandidateScreened to the stored row"
      }
      on persistInterviewFeedbackRecorded: command PersistInterviewFeedbackRecorded is {
        do "apply InterviewFeedbackRecorded to the stored row"
      }
      on persistOfferDeclined: command PersistOfferDeclined is {
        do "apply OfferDeclined to the stored row"
      }
      on persistRequisitionApproved: command PersistRequisitionApproved is {
        do "apply RequisitionApproved to the stored row"
      }
      on persistRequisitionCancelled: command PersistRequisitionCancelled is {
        do "apply RequisitionCancelled to the stored row"
      }
      on persistRequisitionPutOnHold: command PersistRequisitionPutOnHold is {
        do "apply RequisitionPutOnHold to the stored row"
      }
      on persistCandidateAdded: command PersistCandidateAdded is {
        do "apply CandidateAdded to the stored row"
      }
      on persistInterviewScheduled: command PersistInterviewScheduled is {
        do "apply InterviewScheduled to the stored row"
      }
      on persistOfferAccepted: command PersistOfferAccepted is {
        do "apply OfferAccepted to the stored row"
      }
      on persistOfferExtended: command PersistOfferExtended is {
        do "apply OfferExtended to the stored row"
      }
      on persistRequisitionCreated: command PersistRequisitionCreated is {
        do "apply RequisitionCreated to the stored row"
      }
      on persistRequisitionFilled: command PersistRequisitionFilled is {
        do "apply RequisitionFilled to the stored row"
      }
      on query GetPipelineMetrics is {
        let pipelineMetricsView: type PipelineMetricsView = prompt("read the pipeline metrics projection")
        reply pipelineMetricsView
      }
    } with {
      briefly "Persists recruiting commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Recruiting data persistence"
    described as {
      |Persistent storage for recruiting data.
    }
  }
  query GetPipelineMetrics replies result PipelineMetricsView is  {
    pipelineMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which pipeline metrics to retrieve.
      }
    }
  } with {
    briefly "Get pipeline metrics"
    described as {
      |Retrieves the pipeline metrics projection.
    }
  }
  result PipelineMetricsView is  {
    pipelineMetrics: RecruitingMetrics.PipelineMetrics with {
      briefly "Pipeline metrics"
      described as {
        |The pipeline metrics being returned.
      }
    }
  } with {
    briefly "Pipeline metrics view"
    described as {
      |Read model view carrying the pipeline metrics projection.
    }
  }
  projector RecruitingMetrics as flow is {
    outlet RecruitingMetricsToRepository is type RecruitingRepositoryCommand
    updates repository RecruitingContext.RecruitingRepository
    inlet RecruitingMetricsFromJobRequisition is type JobRequisitionEvent
    record PipelineMetrics is  {
      openRequisitions: Natural with {
        briefly "Open"
        described as {
          |Open requisitions.
        }
      }
      totalCandidates: Natural with {
        briefly "Candidates"
        described as {
          |Total candidates in pipeline.
        }
      }
      interviewsScheduled: Natural with {
        briefly "Interviews"
        described as {
          |Interviews scheduled.
        }
      }
      offersExtended: Natural with {
        briefly "Offers"
        described as {
          |Offers extended.
        }
      }
      offerAcceptanceRate: Decimal(5,2) with {
        briefly "Accept rate"
        described as {
          |Offer acceptance percentage.
        }
      }
      averageTimeToFill: Decimal(8,2) with {
        briefly "Time to fill"
        described as {
          |Average days to fill a requisition.
        }
      }
    } with {
      briefly "Pipeline metrics"
      described as {
        |Recruiting pipeline analytics.
      }
    }
    handler MetricsHandler is {
      on candidateRejected: event JobRequisition.CandidateRejected is {
        tell command RecruitingContext.RecruitingRepository.PersistCandidateRejected(requisitionId = candidateRejected.requisitionId) to repository RecruitingContext.RecruitingRepository
        do "apply CandidateRejected to the RecruitingMetrics projection"
      }
      on candidateScreened: event JobRequisition.CandidateScreened is {
        tell command RecruitingContext.RecruitingRepository.PersistCandidateScreened(requisitionId = candidateScreened.requisitionId) to repository RecruitingContext.RecruitingRepository
        do "apply CandidateScreened to the RecruitingMetrics projection"
      }
      on interviewFeedbackRecorded: event JobRequisition.InterviewFeedbackRecorded is {
        tell command RecruitingContext.RecruitingRepository.PersistInterviewFeedbackRecorded(requisitionId = interviewFeedbackRecorded.requisitionId) to repository RecruitingContext.RecruitingRepository
        do "apply InterviewFeedbackRecorded to the RecruitingMetrics projection"
      }
      on offerDeclined: event JobRequisition.OfferDeclined is {
        tell command RecruitingContext.RecruitingRepository.PersistOfferDeclined(requisitionId = offerDeclined.requisitionId) to repository RecruitingContext.RecruitingRepository
        do "apply OfferDeclined to the RecruitingMetrics projection"
      }
      on requisitionApproved: event JobRequisition.RequisitionApproved is {
        tell command RecruitingContext.RecruitingRepository.PersistRequisitionApproved(requisitionId = requisitionApproved.requisitionId) to repository RecruitingContext.RecruitingRepository
        do "apply RequisitionApproved to the RecruitingMetrics projection"
      }
      on requisitionCancelled: event JobRequisition.RequisitionCancelled is {
        tell command RecruitingContext.RecruitingRepository.PersistRequisitionCancelled(requisitionId = requisitionCancelled.requisitionId) to repository RecruitingContext.RecruitingRepository
        do "apply RequisitionCancelled to the RecruitingMetrics projection"
      }
      on requisitionPutOnHold: event JobRequisition.RequisitionPutOnHold is {
        tell command RecruitingContext.RecruitingRepository.PersistRequisitionPutOnHold(requisitionId = requisitionPutOnHold.requisitionId) to repository RecruitingContext.RecruitingRepository
        do "apply RequisitionPutOnHold to the RecruitingMetrics projection"
      }
      on requisitionCreated: event JobRequisition.RequisitionCreated is {
        tell command RecruitingContext.RecruitingRepository.PersistRequisitionCreated(requisitionId = requisitionCreated.requisitionId) to repository RecruitingContext.RecruitingRepository
        do "Increment open requisitions"
      }
      on candidateAdded: event JobRequisition.CandidateAdded is {
        tell command RecruitingContext.RecruitingRepository.PersistCandidateAdded(requisitionId = candidateAdded.requisitionId) to repository RecruitingContext.RecruitingRepository
        do "Increment total candidates"
      }
      on interviewScheduled: event JobRequisition.InterviewScheduled is {
        tell command RecruitingContext.RecruitingRepository.PersistInterviewScheduled(requisitionId = interviewScheduled.requisitionId) to repository RecruitingContext.RecruitingRepository
        do "Increment interviews scheduled"
      }
      on offerExtended: event JobRequisition.OfferExtended is {
        tell command RecruitingContext.RecruitingRepository.PersistOfferExtended(requisitionId = offerExtended.requisitionId) to repository RecruitingContext.RecruitingRepository
        do "Increment offers extended"
      }
      on offerAccepted: event JobRequisition.OfferAccepted is {
        tell command RecruitingContext.RecruitingRepository.PersistOfferAccepted(requisitionId = offerAccepted.requisitionId) to repository RecruitingContext.RecruitingRepository
        do "Update acceptance rate and decrement open requisitions"
      }
      on requisitionFilled: event JobRequisition.RequisitionFilled is {
        tell command RecruitingContext.RecruitingRepository.PersistRequisitionFilled(requisitionId = requisitionFilled.requisitionId) to repository RecruitingContext.RecruitingRepository
        do "Calculate time to fill"
      }
    } with {
      briefly "Maintains recruiting metrics"
      described as {
        |Projects events into recruiting analytics.
      }
    }
  } with {
    briefly "Recruiting metrics"
    described as {
      |Talent acquisition analytics and reporting.
    }
  }
  // ---- Event publication for JobRequisition ----
  type JobRequisitionEvent is one of {
    RecruitingContext.JobRequisition.RequisitionCreated or RecruitingContext.JobRequisition.RequisitionApproved or RecruitingContext.JobRequisition.CandidateAdded or RecruitingContext.JobRequisition.CandidateScreened or RecruitingContext.JobRequisition.InterviewScheduled or RecruitingContext.JobRequisition.InterviewFeedbackRecorded or RecruitingContext.JobRequisition.OfferExtended or RecruitingContext.JobRequisition.OfferAccepted or RecruitingContext.JobRequisition.OfferDeclined or RecruitingContext.JobRequisition.CandidateRejected or RecruitingContext.JobRequisition.RequisitionCancelled or RecruitingContext.JobRequisition.RequisitionPutOnHold or RecruitingContext.JobRequisition.RequisitionFilled
  } with {
    briefly "JobRequisition event alternation"
    described as {
      |Union of all JobRequisition events, for streaming and event-sourced
      |persistence.
    }
  }
  processor JobRequisitionEventSplit as flow is {
    inlet JobRequisitionEventSplitIn is type JobRequisitionEvent
    outlet JobRequisitionEventSplitToRecruitingMetrics is type JobRequisitionEvent
    handler JobRequisitionEventSplitHandler is {
      on requisitionCreated: event JobRequisition.RequisitionCreated is {
        send requisitionCreated to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell requisitionCreated to entity RecruitingContext.JobRequisition
      }
      on requisitionApproved: event JobRequisition.RequisitionApproved is {
        send requisitionApproved to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell requisitionApproved to entity RecruitingContext.JobRequisition
      }
      on candidateAdded: event JobRequisition.CandidateAdded is {
        send candidateAdded to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell candidateAdded to entity RecruitingContext.JobRequisition
      }
      on candidateScreened: event JobRequisition.CandidateScreened is {
        send candidateScreened to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell candidateScreened to entity RecruitingContext.JobRequisition
      }
      on interviewScheduled: event JobRequisition.InterviewScheduled is {
        send interviewScheduled to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell interviewScheduled to entity RecruitingContext.JobRequisition
      }
      on interviewFeedbackRecorded: event JobRequisition.InterviewFeedbackRecorded is {
        send interviewFeedbackRecorded to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell interviewFeedbackRecorded to entity RecruitingContext.JobRequisition
      }
      on offerExtended: event JobRequisition.OfferExtended is {
        send offerExtended to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell offerExtended to entity RecruitingContext.JobRequisition
      }
      on offerAccepted: event JobRequisition.OfferAccepted is {
        send offerAccepted to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell offerAccepted to entity RecruitingContext.JobRequisition
      }
      on offerDeclined: event JobRequisition.OfferDeclined is {
        send offerDeclined to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell offerDeclined to entity RecruitingContext.JobRequisition
      }
      on candidateRejected: event JobRequisition.CandidateRejected is {
        send candidateRejected to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell candidateRejected to entity RecruitingContext.JobRequisition
      }
      on requisitionCancelled: event JobRequisition.RequisitionCancelled is {
        send requisitionCancelled to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell requisitionCancelled to entity RecruitingContext.JobRequisition
      }
      on requisitionPutOnHold: event JobRequisition.RequisitionPutOnHold is {
        send requisitionPutOnHold to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell requisitionPutOnHold to entity RecruitingContext.JobRequisition
      }
      on requisitionFilled: event JobRequisition.RequisitionFilled is {
        send requisitionFilled to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell requisitionFilled to entity RecruitingContext.JobRequisition
      }
      on other is {
        error "Unexpected message for processor JobRequisitionEventSplit"
      }
    } with {
      briefly "JobRequisition event fan-out handler"
      described as {
        |Delivers each JobRequisition event to all of its consumers.
      }
    }
  } with {
    briefly "JobRequisition event fan-out"
    described as {
      |Fans JobRequisition events out to the repository and projectors.
    }
  }
  connector 'JobRequisitionEvent Stream' is from outlet RecruitingContext.JobRequisition.JobRequisitionEvents2 to inlet RecruitingContext.JobRequisitionEventSplit.JobRequisitionEventSplitIn with {
    briefly "JobRequisition events, fanned out to storage and read models"
  }
  connector 'RecruitingMetrics Feed' is from outlet RecruitingContext.JobRequisitionEventSplit.JobRequisitionEventSplitToRecruitingMetrics to inlet RecruitingContext.RecruitingMetrics.RecruitingMetricsFromJobRequisition with {
    briefly "JobRequisition events feeding the RecruitingMetrics projection"
  }
  connector 'RecruitingMetrics Storage' is from outlet RecruitingContext.RecruitingMetrics.RecruitingMetricsToRepository to inlet RecruitingContext.RecruitingRepository.RecruitingRepositoryFromRecruitingMetrics with {
    briefly "RecruitingMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for recruiting"
  described as {
    |Talent acquisition and applicant tracking context.
  }
}
