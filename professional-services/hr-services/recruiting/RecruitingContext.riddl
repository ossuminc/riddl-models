// Recruiting - Recruiting Context
context RecruitingContext is {
  adaptor FromBackgroundCheckService from context BackgroundCheckService is {
    handler FromBackgroundCheckServiceHandler is {
      on event BackgroundCheckService.BackgroundCheckCompleted is {
        do "the model receives background check completed"
      }
      on result BackgroundCheckService.CheckStatus is {
        do "the model receives check status"
      }
      on other is {
        error "Unexpected message for adaptor FromBackgroundCheckService"
      }
    } with {
      briefly "from background check service"
      described as {
        |Carries messages from the external BackgroundCheckService.
      }
    }
  } with {
      briefly "BackgroundCheckService integration"
    described as {
      |The model's side of the BackgroundCheckService conversation.
    }
  }
  adaptor ToBackgroundCheckService to context BackgroundCheckService is {
    handler ToBackgroundCheckServiceHandler is {
      on query BackgroundCheckService.GetCheckStatus is {
        do "the model sends get check status"
      }
      on command BackgroundCheckService.InitiateBackgroundCheck is {
        do "the model sends initiate background check"
      }
      on other is {
        error "Unexpected message for adaptor ToBackgroundCheckService"
      }
    } with {
      briefly "to background check service"
      described as {
        |Carries messages to the external BackgroundCheckService.
      }
    }
  } with {
      briefly "BackgroundCheckService integration"
    described as {
      |The model's side of the BackgroundCheckService conversation.
    }
  }
  adaptor FromJobBoardIntegration from context JobBoardIntegration is {
    handler FromJobBoardIntegrationHandler is {
      on result JobBoardIntegration.BoardApplications is {
        do "the model receives board applications"
      }
      on event JobBoardIntegration.JobListingPosted is {
        do "the model receives job listing posted"
      }
      on event JobBoardIntegration.JobListingRemoved is {
        do "the model receives job listing removed"
      }
      on other is {
        error "Unexpected message for adaptor FromJobBoardIntegration"
      }
    } with {
      briefly "from job board integration"
      described as {
        |Carries messages from the external JobBoardIntegration.
      }
    }
  } with {
      briefly "JobBoardIntegration integration"
    described as {
      |The model's side of the JobBoardIntegration conversation.
    }
  }
  adaptor ToJobBoardIntegration to context JobBoardIntegration is {
    handler ToJobBoardIntegrationHandler is {
      on query JobBoardIntegration.GetApplicationsFromBoard is {
        do "the model sends get applications from board"
      }
      on command JobBoardIntegration.PostJobListing is {
        do "the model sends post job listing"
      }
      on command JobBoardIntegration.RemoveJobListing is {
        do "the model sends remove job listing"
      }
      on other is {
        error "Unexpected message for adaptor ToJobBoardIntegration"
      }
    } with {
      briefly "to job board integration"
      described as {
        |Carries messages to the external JobBoardIntegration.
      }
    }
  } with {
      briefly "JobBoardIntegration integration"
    described as {
      |The model's side of the JobBoardIntegration conversation.
    }
  }
  include "types.riddl"
  include "JobRequisition.riddl"
  repository RecruitingRepository is {
    inlet RecruitingRepositoryFromJobRequisition is type JobRequisitionEvent
    inlet RecruitingRepositoryFromRecruitingMetrics is type JobRequisitionEvent
    outlet RecruitingRepositoryResponses is type JobRequisition.JobRequisitionResult
    record StoredJobRequisition is {
      jobRequisitionId: UUID with {
        briefly "jobRequisitionId"
        described as {
          |The jobRequisitionId column of the stored jobRequisition row.
        }
      }
      requisitionId: RequisitionId with {
        briefly "requisitionId"
        described as {
          |The requisitionId column of the stored jobRequisition row.
        }
      }
      requisitionInfo: RequisitionInfo with {
        briefly "requisitionInfo"
        described as {
          |The requisitionInfo column of the stored jobRequisition row.
        }
      }
      status: RequisitionStatus with {
        briefly "status"
        described as {
          |The status column of the stored jobRequisition row.
        }
      }
    } with {
      briefly "Stored jobRequisition row"
      described as {
        |The persistence shape of jobRequisition data as this repository stores it.
      }
    }
    schema RecruitingData is relational
      of jobRequisitions as type StoredJobRequisition
        index on field StoredJobRequisition.requisitionId
        index on field StoredJobRequisition.requisitionInfo.hiringManagerId
        index on field StoredJobRequisition.status
      with {
      briefly "Recruiting data schema"
      described as {
        |The relational schema holding recruiting data for the RecruitingRepository.
      }
    }

    handler RecruitingPersistence is {
      on query GetPipelineMetrics is {
        do "read the pipeline metrics projection"
        yield result PipelineMetricsView
      }
      on command JobRequisition.CreateRequisition is {
        tell event JobRequisition.RequisitionCreated to entity RecruitingContext.JobRequisition
        do "Store new job requisition"
      }
      on command JobRequisition.ApproveRequisition is {
        tell event JobRequisition.RequisitionApproved to entity RecruitingContext.JobRequisition
        do "Update requisition to approved"
      }
      on command JobRequisition.AddCandidate is {
        tell event JobRequisition.CandidateAdded to entity RecruitingContext.JobRequisition
        do "Add candidate to requisition pipeline"
      }
      on command JobRequisition.ScheduleInterview is {
        tell event JobRequisition.InterviewScheduled to entity RecruitingContext.JobRequisition
        do "Store interview schedule"
      }
      on command JobRequisition.ExtendOffer is {
        do "Store offer details"
      }
      on command JobRequisition.AcceptOffer is {
        do "Update candidate and requisition to hired and mark as filled"
      }
    } with {
      briefly "Persists recruiting commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Recruiting data persistence"
    described as {
      |Persistent storage for recruiting data.
    }
  }
  query GetPipelineMetrics is {
    pipelineMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which pipeline metrics to retrieve.
      }
    }
  } with {
    briefly "Get pipeline metrics"
    described as {
      |Retrieves the pipeline metrics projection.
    }
  }
  result PipelineMetricsView is {
    pipelineMetrics: RecruitingMetrics.PipelineMetrics with {
      briefly "Pipeline metrics"
      described as {
        |The pipeline metrics being returned.
      }
    }
  } with {
    briefly "Pipeline metrics view"
    described as {
      |Read model view carrying the pipeline metrics projection.
    }
  }
  projector RecruitingMetrics is {
    inlet RecruitingMetricsFromJobRequisition is type JobRequisitionEvent
    outlet RecruitingMetricsOut is type JobRequisitionEvent
    updates repository RecruitingContext.RecruitingRepository
    record PipelineMetrics is  {
      openRequisitions: Natural with {
        briefly "Open"
        described as {
          |Open requisitions.
        }
      }
      totalCandidates: Natural with {
        briefly "Candidates"
        described as {
          |Total candidates in pipeline.
        }
      }
      interviewsScheduled: Natural with {
        briefly "Interviews"
        described as {
          |Interviews scheduled.
        }
      }
      offersExtended: Natural with {
        briefly "Offers"
        described as {
          |Offers extended.
        }
      }
      offerAcceptanceRate: Decimal(5,2) with {
        briefly "Accept rate"
        described as {
          |Offer acceptance percentage.
        }
      }
      averageTimeToFill: Decimal(8,2) with {
        briefly "Time to fill"
        described as {
          |Average days to fill a requisition.
        }
      }
    } with {
      briefly "Pipeline metrics"
      described as {
        |Recruiting pipeline analytics.
      }
    }
    handler MetricsHandler is {
      on event JobRequisition.RequisitionCreated is {
        tell event JobRequisition.RequisitionCreated to repository RecruitingContext.RecruitingRepository
        do "Increment open requisitions"
      }
      on event JobRequisition.CandidateAdded is {
        tell event JobRequisition.CandidateAdded to repository RecruitingContext.RecruitingRepository
        do "Increment total candidates"
      }
      on event JobRequisition.InterviewScheduled is {
        tell event JobRequisition.InterviewScheduled to repository RecruitingContext.RecruitingRepository
        do "Increment interviews scheduled"
      }
      on event JobRequisition.OfferExtended is {
        tell event JobRequisition.OfferExtended to repository RecruitingContext.RecruitingRepository
        do "Increment offers extended"
      }
      on event JobRequisition.OfferAccepted is {
        tell event JobRequisition.OfferAccepted to repository RecruitingContext.RecruitingRepository
        do "Update acceptance rate and decrement open requisitions"
      }
      on event JobRequisition.RequisitionFilled is {
        tell event JobRequisition.RequisitionFilled to repository RecruitingContext.RecruitingRepository
        do "Calculate time to fill"
      }
    } with {
      briefly "Maintains recruiting metrics"
      described as {
        |Projects events into recruiting analytics.
      }
    }
  } with {
    briefly "Recruiting metrics"
    described as {
      |Talent acquisition analytics and reporting.
    }
  }
  // ---- Event publication for JobRequisition ----
  type JobRequisitionEvent is one of {
    RecruitingContext.JobRequisition.RequisitionCreated,
    RecruitingContext.JobRequisition.RequisitionApproved,
    RecruitingContext.JobRequisition.CandidateAdded,
    RecruitingContext.JobRequisition.CandidateScreened,
    RecruitingContext.JobRequisition.InterviewScheduled,
    RecruitingContext.JobRequisition.InterviewFeedbackRecorded,
    RecruitingContext.JobRequisition.OfferExtended,
    RecruitingContext.JobRequisition.OfferAccepted,
    RecruitingContext.JobRequisition.OfferDeclined,
    RecruitingContext.JobRequisition.CandidateRejected,
    RecruitingContext.JobRequisition.RequisitionCancelled,
    RecruitingContext.JobRequisition.RequisitionPutOnHold,
    RecruitingContext.JobRequisition.RequisitionFilled
  } with {
    briefly "JobRequisition event alternation"
    described as {
      |Union of all JobRequisition events, for streaming and event-sourced
      |persistence.
    }
  }
  processor JobRequisitionEventSource as source is {
    outlet JobRequisitionEvents is type JobRequisitionEvent
    handler JobRequisitionSourceHandler is {
      on event JobRequisition.RequisitionCreated is {
        send event JobRequisition.RequisitionCreated to outlet JobRequisitionEvents
      }
      on event JobRequisition.RequisitionApproved is {
        send event JobRequisition.RequisitionApproved to outlet JobRequisitionEvents
      }
      on event JobRequisition.CandidateAdded is {
        send event JobRequisition.CandidateAdded to outlet JobRequisitionEvents
      }
      on event JobRequisition.CandidateScreened is {
        send event JobRequisition.CandidateScreened to outlet JobRequisitionEvents
      }
      on event JobRequisition.InterviewScheduled is {
        send event JobRequisition.InterviewScheduled to outlet JobRequisitionEvents
      }
      on event JobRequisition.InterviewFeedbackRecorded is {
        send event JobRequisition.InterviewFeedbackRecorded to outlet JobRequisitionEvents
      }
      on event JobRequisition.OfferExtended is {
        send event JobRequisition.OfferExtended to outlet JobRequisitionEvents
      }
      on event JobRequisition.OfferAccepted is {
        send event JobRequisition.OfferAccepted to outlet JobRequisitionEvents
      }
      on event JobRequisition.OfferDeclined is {
        send event JobRequisition.OfferDeclined to outlet JobRequisitionEvents
      }
      on event JobRequisition.CandidateRejected is {
        send event JobRequisition.CandidateRejected to outlet JobRequisitionEvents
      }
      on event JobRequisition.RequisitionCancelled is {
        send event JobRequisition.RequisitionCancelled to outlet JobRequisitionEvents
      }
      on event JobRequisition.RequisitionPutOnHold is {
        send event JobRequisition.RequisitionPutOnHold to outlet JobRequisitionEvents
      }
      on event JobRequisition.RequisitionFilled is {
        send event JobRequisition.RequisitionFilled to outlet JobRequisitionEvents
      }
      on other is {
        error "Unexpected message for source JobRequisitionEventSource"
      }
    } with {
      briefly "JobRequisition source handler"
      described as {
        |Publishes JobRequisition events onto the outlet.
      }
    }
  } with {
    briefly "JobRequisition event source"
    described as {
      |Publishes JobRequisition entity events into the streaming topology.
    }
  }
  processor JobRequisitionEventSink as sink is {
    inlet JobRequisitionInlet is type JobRequisitionEvent
    handler JobRequisitionSinkHandler is {
      on event JobRequisition.RequisitionCreated is {
        tell event JobRequisition.RequisitionCreated to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.RequisitionApproved is {
        tell event JobRequisition.RequisitionApproved to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.CandidateAdded is {
        tell event JobRequisition.CandidateAdded to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.CandidateScreened is {
        tell event JobRequisition.CandidateScreened to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.InterviewScheduled is {
        tell event JobRequisition.InterviewScheduled to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.InterviewFeedbackRecorded is {
        tell event JobRequisition.InterviewFeedbackRecorded to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.OfferExtended is {
        tell event JobRequisition.OfferExtended to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.OfferAccepted is {
        tell event JobRequisition.OfferAccepted to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.OfferDeclined is {
        tell event JobRequisition.OfferDeclined to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.CandidateRejected is {
        tell event JobRequisition.CandidateRejected to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.RequisitionCancelled is {
        tell event JobRequisition.RequisitionCancelled to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.RequisitionPutOnHold is {
        tell event JobRequisition.RequisitionPutOnHold to repository RecruitingContext.RecruitingRepository
      }
      on event JobRequisition.RequisitionFilled is {
        tell event JobRequisition.RequisitionFilled to repository RecruitingContext.RecruitingRepository
      }
      on other is {
        error "Unexpected message for sink JobRequisitionEventSink"
      }
    } with {
      briefly "JobRequisition sink handler"
      described as {
        |Persists JobRequisition events via the repository.
      }
    }
  } with {
    briefly "JobRequisition event sink"
    described as {
      |Receives JobRequisition events for persistence.
    }
  }
  connector JobRequisitionEventFlow is {
    from outlet RecruitingContext.JobRequisitionEventSource.JobRequisitionEvents to
      inlet RecruitingContext.JobRequisitionEventSink.JobRequisitionInlet
  } with {
    briefly "JobRequisition event flow"
    described as {
      |Connects the JobRequisition source to its sink.
    }
  }
  processor JobRequisitionEventSplit is {
    inlet JobRequisitionEventSplitIn is type JobRequisitionEvent
    outlet JobRequisitionEventSplitToRecruitingRepository is type JobRequisitionEvent
    outlet JobRequisitionEventSplitToRecruitingMetrics is type JobRequisitionEvent
    handler JobRequisitionEventSplitHandler is {
      on event JobRequisition.RequisitionCreated is {
        send event JobRequisition.RequisitionCreated to outlet JobRequisitionEventSplitToRecruitingRepository
        send event JobRequisition.RequisitionCreated to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell event JobRequisition.RequisitionCreated to entity RecruitingContext.JobRequisition
      }
      on event JobRequisition.RequisitionApproved is {
        send event JobRequisition.RequisitionApproved to outlet JobRequisitionEventSplitToRecruitingRepository
        send event JobRequisition.RequisitionApproved to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell event JobRequisition.RequisitionApproved to entity RecruitingContext.JobRequisition
      }
      on event JobRequisition.CandidateAdded is {
        send event JobRequisition.CandidateAdded to outlet JobRequisitionEventSplitToRecruitingRepository
        send event JobRequisition.CandidateAdded to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell event JobRequisition.CandidateAdded to entity RecruitingContext.JobRequisition
      }
      on event JobRequisition.CandidateScreened is {
        send event JobRequisition.CandidateScreened to outlet JobRequisitionEventSplitToRecruitingRepository
        send event JobRequisition.CandidateScreened to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell event JobRequisition.CandidateScreened to entity RecruitingContext.JobRequisition
      }
      on event JobRequisition.InterviewScheduled is {
        send event JobRequisition.InterviewScheduled to outlet JobRequisitionEventSplitToRecruitingRepository
        send event JobRequisition.InterviewScheduled to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell event JobRequisition.InterviewScheduled to entity RecruitingContext.JobRequisition
      }
      on event JobRequisition.InterviewFeedbackRecorded is {
        send event JobRequisition.InterviewFeedbackRecorded to outlet JobRequisitionEventSplitToRecruitingRepository
        send event JobRequisition.InterviewFeedbackRecorded to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell event JobRequisition.InterviewFeedbackRecorded to entity RecruitingContext.JobRequisition
      }
      on event JobRequisition.OfferExtended is {
        send event JobRequisition.OfferExtended to outlet JobRequisitionEventSplitToRecruitingRepository
        send event JobRequisition.OfferExtended to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell event JobRequisition.OfferExtended to entity RecruitingContext.JobRequisition
      }
      on event JobRequisition.OfferAccepted is {
        send event JobRequisition.OfferAccepted to outlet JobRequisitionEventSplitToRecruitingRepository
        send event JobRequisition.OfferAccepted to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell event JobRequisition.OfferAccepted to entity RecruitingContext.JobRequisition
      }
      on event JobRequisition.OfferDeclined is {
        send event JobRequisition.OfferDeclined to outlet JobRequisitionEventSplitToRecruitingRepository
        send event JobRequisition.OfferDeclined to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell event JobRequisition.OfferDeclined to entity RecruitingContext.JobRequisition
      }
      on event JobRequisition.CandidateRejected is {
        send event JobRequisition.CandidateRejected to outlet JobRequisitionEventSplitToRecruitingRepository
        send event JobRequisition.CandidateRejected to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell event JobRequisition.CandidateRejected to entity RecruitingContext.JobRequisition
      }
      on event JobRequisition.RequisitionCancelled is {
        send event JobRequisition.RequisitionCancelled to outlet JobRequisitionEventSplitToRecruitingRepository
        send event JobRequisition.RequisitionCancelled to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell event JobRequisition.RequisitionCancelled to entity RecruitingContext.JobRequisition
      }
      on event JobRequisition.RequisitionPutOnHold is {
        send event JobRequisition.RequisitionPutOnHold to outlet JobRequisitionEventSplitToRecruitingRepository
        send event JobRequisition.RequisitionPutOnHold to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell event JobRequisition.RequisitionPutOnHold to entity RecruitingContext.JobRequisition
      }
      on event JobRequisition.RequisitionFilled is {
        send event JobRequisition.RequisitionFilled to outlet JobRequisitionEventSplitToRecruitingRepository
        send event JobRequisition.RequisitionFilled to outlet JobRequisitionEventSplitToRecruitingMetrics
        tell event JobRequisition.RequisitionFilled to entity RecruitingContext.JobRequisition
      }
      on other is {
        error "Unexpected message for processor JobRequisitionEventSplit"
      }
    } with {
      briefly "JobRequisition event fan-out handler"
      described as {
        |Delivers each JobRequisition event to all of its consumers.
      }
    }
  } with {
    briefly "JobRequisition event fan-out"
    described as {
      |Fans JobRequisition events out to the repository and projectors.
    }
  }
  connector LinkJobRequisitionToJobRequisitionEventSplit is {
    from outlet RecruitingContext.JobRequisition.JobRequisitionEvents2 to
      inlet RecruitingContext.JobRequisitionEventSplit.JobRequisitionEventSplitIn
  } with {
    briefly "LinkJobRequisitionToJobRequisitionEventSplit"
  }
  connector LinkJobRequisitionEventSplitToRecruitingRepository is {
    from outlet RecruitingContext.JobRequisitionEventSplit.JobRequisitionEventSplitToRecruitingRepository to
      inlet RecruitingContext.RecruitingRepository.RecruitingRepositoryFromJobRequisition
  } with {
    briefly "LinkJobRequisitionEventSplitToRecruitingRepository"
  }
  connector LinkJobRequisitionEventSplitToRecruitingMetrics is {
    from outlet RecruitingContext.JobRequisitionEventSplit.JobRequisitionEventSplitToRecruitingMetrics to
      inlet RecruitingContext.RecruitingMetrics.RecruitingMetricsFromJobRequisition
  } with {
    briefly "LinkJobRequisitionEventSplitToRecruitingMetrics"
  }
  connector LinkRecruitingMetricsToRecruitingRepository is {
    from outlet RecruitingContext.RecruitingMetrics.RecruitingMetricsOut to
      inlet RecruitingContext.RecruitingRepository.RecruitingRepositoryFromRecruitingMetrics
  } with {
    briefly "LinkRecruitingMetricsToRecruitingRepository"
  }
} with {
  briefly "Bounded context for recruiting"
  described as {
    |Talent acquisition and applicant tracking context.
  }
}
