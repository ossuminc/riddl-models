// Recruiting Domain Model
// Talent acquisition and applicant tracking
domain Recruiting is {
  persistent connector 'JobBoardIntegrationReply Stream' is from outlet JobBoardIntegration.JobBoardIntegrationRepliesOut to inlet RecruitingContext.ToJobBoardIntegration.ToJobBoardIntegrationReplies with {
    briefly "What JobBoardIntegration answers RecruitingContext"
  }
  persistent connector 'BackgroundCheckServiceReply Stream' is from outlet BackgroundCheckService.BackgroundCheckServiceRepliesOut to inlet RecruitingContext.ToBackgroundCheckService.ToBackgroundCheckServiceReplies with {
    briefly "What BackgroundCheckService answers RecruitingContext"
  }
  persistent connector 'BackgroundCheckServiceEvent Stream' is from outlet BackgroundCheckService.BackgroundCheckServiceEventsOut to inlet RecruitingContext.FromBackgroundCheckService.FromBackgroundCheckServiceIn with {
    briefly "What BackgroundCheckService tells RecruitingContext, unasked"
  }
  persistent connector 'JobBoardIntegrationEvent Stream' is from outlet JobBoardIntegration.JobBoardIntegrationEventsOut to inlet RecruitingContext.FromJobBoardIntegration.FromJobBoardIntegrationIn with {
    briefly "What JobBoardIntegration tells RecruitingContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user HiringManager is "person who creates requisitions and approves hires" with {
    briefly "Hiring Manager"
    described as {
      |Manager requesting new hires for their team.
    }
  }
  user Recruiter is "person managing candidates through the hiring pipeline" with {
    briefly "Recruiter"
    described as {
      |Talent acquisition specialist sourcing and screening candidates.
    }
  }
  user Interviewer is "person conducting candidate interviews" with {
    briefly "Interviewer"
    described as {
      |Team member evaluating candidates during interviews.
    }
  }
  epic TalentAcquisition is {
    user HiringManager wants to "to fill open positions with qualified candidates" so that "the team can meet its staffing goals"
    case FillOpenPosition is {
      user HiringManager wants to "to hire a candidate for an open requisition" so that "the team has the resources it needs"
      step is "Manager creates" "job requisition" "for an open role" with {
        briefly "Create requisition"
        described as {
          |Open a new job requisition.
        }
      }
      step is "Recruiter sources" "candidates" "from multiple channels" with {
        briefly "Source candidates"
        described as {
          |Find qualified candidates.
        }
      }
      step is "System tracks" "applicants" "through interview stages" with {
        briefly "Track applicants"
        described as {
          |Manage candidate pipeline.
        }
      }
      step is "Manager extends" "offer" "to selected candidate" with {
        briefly "Extend offer"
        described as {
          |Make offer to top candidate.
        }
      }
    } with {
      briefly "Fill open position"
      described as {
        |End-to-end hiring for a single requisition.
      }
    }
  } with {
    briefly "Talent acquisition"
    described as {
      |Epic for recruiting and hiring new employees.
    }
  }
  include "RecruitingContext.riddl"
  include "external-contexts.riddl"
  application context RecruitingApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in Recruiting are delivered.
      }
    }
    group RecruitingScreen is {
      input GetPipelineMetricsInput acquires query RecruitingContext.GetPipelineMetrics with {
        briefly "Get pipeline metrics control"
        described as {
          |The control through which a user asks the get pipeline metrics question.
        }
      }
      input GetJobRequisitionInput acquires query RecruitingContext.JobRequisition.GetJobRequisition with {
        briefly "Get job requisition control"
        described as {
          |The control through which a user asks the get job requisition question.
        }
      }
      input CreateRequisitionInput acquires command RecruitingContext.CreateRequisition with {
        briefly "Create requisition control"
        described as {
          |The control through which a user submits the create requisition request.
        }
      }
      input AcceptOfferInput acquires command RecruitingContext.JobRequisition.AcceptOffer with {
        briefly "Accept offer control"
        described as {
          |The control through which a user submits the accept offer request.
        }
      }
      input ApproveRequisitionInput acquires command RecruitingContext.JobRequisition.ApproveRequisition with {
        briefly "Approve requisition control"
        described as {
          |The control through which a user submits the approve requisition request.
        }
      }
      input CancelRequisitionInput acquires command RecruitingContext.JobRequisition.CancelRequisition with {
        briefly "Cancel requisition control"
        described as {
          |The control through which a user submits the cancel requisition request.
        }
      }
      input DeclineOfferInput acquires command RecruitingContext.JobRequisition.DeclineOffer with {
        briefly "Decline offer control"
        described as {
          |The control through which a user submits the decline offer request.
        }
      }
      input ExtendOfferInput acquires command RecruitingContext.JobRequisition.ExtendOffer with {
        briefly "Extend offer control"
        described as {
          |The control through which a user submits the extend offer request.
        }
      }
      input PutRequisitionOnHoldInput acquires command RecruitingContext.JobRequisition.PutRequisitionOnHold with {
        briefly "Put requisition on hold control"
        described as {
          |The control through which a user submits the put requisition on hold request.
        }
      }
      input RecordInterviewFeedbackInput acquires command RecruitingContext.JobRequisition.RecordInterviewFeedback with {
        briefly "Record interview feedback control"
        described as {
          |The control through which a user submits the record interview feedback request.
        }
      }
      input ScheduleInterviewInput acquires command RecruitingContext.JobRequisition.ScheduleInterview with {
        briefly "Schedule interview control"
        described as {
          |The control through which a user submits the schedule interview request.
        }
      }
      input ScreenCandidateInput acquires command RecruitingContext.JobRequisition.ScreenCandidate with {
        briefly "Screen candidate control"
        described as {
          |The control through which a user submits the screen candidate request.
        }
      }
    } with {
      briefly "Recruiting screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppRecruitingRepositoryQueries is query RecruitingContext.GetPipelineMetrics
    inlet AppRecruitingRepositoryReplies is result RecruitingContext.PipelineMetricsView
    outlet AppJobRequisitionQueries is query RecruitingContext.JobRequisition.GetJobRequisition
    outlet AppJobRequisitionCommands is type RecruitingContext.JobRequisitionRequest
    inlet AppRecruitingRepositoryResponses is result RecruitingContext.JobRequisition.JobRequisitionResult
    handler RecruitingAppHandler is {
      on other is {
        error "Unexpected message for application context RecruitingApp"
      }
    } with {
      briefly "RecruitingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "RecruitingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'JobBoardIntegrationRequest Stream' is from outlet RecruitingContext.ToJobBoardIntegration.ToJobBoardIntegrationOut to inlet JobBoardIntegration.JobBoardIntegrationRequests with {
    briefly "What RecruitingContext asks JobBoardIntegration to send"
  }
  persistent connector 'BackgroundCheckServiceRequest Stream' is from outlet RecruitingContext.ToBackgroundCheckService.ToBackgroundCheckServiceOut to inlet BackgroundCheckService.BackgroundCheckServiceRequests with {
    briefly "What RecruitingContext asks BackgroundCheckService to send"
  }
  persistent connector 'RecruitingRepositoryQuery Stream' is from outlet RecruitingApp.AppRecruitingRepositoryQueries to inlet RecruitingContext.RecruitingRepositoryQueriesIn with {
    briefly "RecruitingApp's look-ups of the recruiting repository"
  }
  persistent connector 'RecruitingRepositoryReply Stream' is from outlet RecruitingContext.RecruitingRepositoryRepliesOut to inlet RecruitingApp.AppRecruitingRepositoryReplies with {
    briefly "The recruiting repository's answers returned to RecruitingApp"
  }
  persistent connector 'JobRequisitionQuery Stream' is from outlet RecruitingApp.AppJobRequisitionQueries to inlet RecruitingContext.JobRequisitionQueriesIn with {
    briefly "RecruitingApp's look-ups of the job requisition"
  }
  persistent connector 'JobRequisitionCommand Stream' is from outlet RecruitingApp.AppJobRequisitionCommands to inlet RecruitingContext.JobRequisitionCommandStreamIn with {
    briefly "JobRequisition commands from the application"
  }
  persistent connector 'JobRequisitionResult Stream' is from outlet RecruitingContext.JobRequisitionResultStreamOut to inlet RecruitingApp.AppRecruitingRepositoryResponses with {
    briefly "Recruiting query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet RecruitingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term InterviewStage is "A stage applicants move through during interviews."
  briefly "Recruiting domain"
  described as {
    |Talent acquisition, applicant tracking, and hiring management.
  }
}
