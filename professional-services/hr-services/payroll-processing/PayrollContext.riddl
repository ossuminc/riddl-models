// Payroll Processing - Payroll Context
context PayrollContext as router is {
  inlet PayrollContextFromBankingService is command PayrollRun.CompletePayroll with {
    briefly "What FromBankingService makes of that service's news"
  }
  connector 'FromBankingService Intake' is from outlet PayrollContext.FromBankingService.FromBankingServiceToPayrollContext to inlet PayrollContext.PayrollContextFromBankingService with {
    briefly "What FromBankingService makes of that news, on its way in"
  }
  inlet PayrollRunCommandStreamIn is type PayrollRunCommand  outlet PayrollRunCommandStreamOut is type PayrollRunCommand
  inlet PayrollRunResultStreamIn is result PayrollRun.PayrollRunResult  outlet PayrollRunResultStreamOut is result PayrollRun.PayrollRunResult
  handler PayrollContextBoundary is {
    on initiatePayroll: command PayrollRun.InitiatePayroll is {
      send initiatePayroll to outlet PayrollContext.PayrollRunCommandStreamOut
    }
    on calculatePayroll: command PayrollRun.CalculatePayroll is {
      send calculatePayroll to outlet PayrollContext.PayrollRunCommandStreamOut
    }
    on addTimeEntry: command PayrollRun.AddTimeEntry is {
      send addTimeEntry to outlet PayrollContext.PayrollRunCommandStreamOut
    }
    on applyDeduction: command PayrollRun.ApplyDeduction is {
      send applyDeduction to outlet PayrollContext.PayrollRunCommandStreamOut
    }
    on calculateTaxes: command PayrollRun.CalculateTaxes is {
      send calculateTaxes to outlet PayrollContext.PayrollRunCommandStreamOut
    }
    on submitForApproval: command PayrollRun.SubmitForApproval is {
      send submitForApproval to outlet PayrollContext.PayrollRunCommandStreamOut
    }
    on approvePayroll: command PayrollRun.ApprovePayroll is {
      send approvePayroll to outlet PayrollContext.PayrollRunCommandStreamOut
    }
    on processPayments: command PayrollRun.ProcessPayments is {
      send processPayments to outlet PayrollContext.PayrollRunCommandStreamOut
    }
    on completePayroll: command PayrollRun.CompletePayroll is {
      send completePayroll to outlet PayrollContext.PayrollRunCommandStreamOut
    }
    on voidPayroll: command PayrollRun.VoidPayroll is {
      send voidPayroll to outlet PayrollContext.PayrollRunCommandStreamOut
    }
    on payrollRunResult: result PayrollRun.PayrollRunResult is {
      send payrollRunResult to outlet PayrollContext.PayrollRunResultStreamOut
    }
    on other is {
      error "Unexpected message at the PayrollContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PayrollRunCommand Stream Intake' is from outlet PayrollContext.PayrollRunCommandStreamOut to inlet PayrollContext.PayrollRun.PayrollRunCommands  connector 'PayrollRunResult Stream Egress' is from outlet PayrollContext.PayrollRepository.PayrollRepositoryResponses to inlet PayrollContext.PayrollRunResultStreamIn  adaptor FromBankingService from context BankingService as flow is { 
    inlet FromBankingServiceIn is type BankingService.BankingServiceEvent    outlet FromBankingServiceToPayrollContext is command PayrollRun.CompletePayroll
    handler FromBankingServiceHandler is {
      on aCHBatchSettled: event BankingService.ACHBatchSettled is {
        let item0: type PayrollRun.CompletePayroll = prompt("translate the aCHBatchSettled event into a CompletePayroll, money landed in employees' accounts is what completes the run")
        send item0 to outlet PayrollContext.FromBankingService.FromBankingServiceToPayrollContext
      }
      on aCHBatchSubmitted: event BankingService.ACHBatchSubmitted is {
        do "the bank has the batch; approving the payroll was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromBankingService"
      }
    } with {
      briefly "from banking service"
      described as {
        |Carries messages from the external BankingService.
      }
    }
  } with {
    briefly "BankingService integration"
    described as {
      |The model's side of the BankingService conversation.
    }
  }
  adaptor ToBankingService to context BankingService as flow is { 
    outlet ToBankingServiceOut is command BankingService.SubmitACHBatch
    handler ToBankingServiceHandler is {
      on payrollApproved: event PayrollRun.PayrollApproved is {
        let item0: type BankingService.SubmitACHBatch = prompt("translate the payrollApproved event into a SubmitACHBatch, approval being what authorises the money to move")
        send item0 to outlet PayrollContext.ToBankingService.ToBankingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToBankingService"
      }
    } with {
      briefly "to banking service"
      described as {
        |Carries messages to the external BankingService.
      }
    }
  } with {
    briefly "BankingService integration"
    described as {
      |The model's side of the BankingService conversation.
    }
  }
  adaptor FromGeneralLedger from context GeneralLedger as flow is { 
    inlet FromGeneralLedgerIn is event GeneralLedger.JournalEntryPosted    handler FromGeneralLedgerHandler is {
      on journalEntryPosted: event GeneralLedger.JournalEntryPosted is {
        do "the ledger has the entry; approving the payroll was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromGeneralLedger"
      }
    } with {
      briefly "from general ledger"
      described as {
        |Carries messages from the external GeneralLedger.
      }
    }
  } with {
    briefly "GeneralLedger integration"
    described as {
      |The model's side of the GeneralLedger conversation.
    }
  }
  adaptor ToGeneralLedger to context GeneralLedger as flow is { 
    outlet ToGeneralLedgerOut is command GeneralLedger.PostPayrollJournalEntry
    handler ToGeneralLedgerHandler is {
      on payrollApproved: event PayrollRun.PayrollApproved is {
        let item0: type GeneralLedger.PostPayrollJournalEntry = prompt("translate the payrollApproved event into a PostPayrollJournalEntry, approval being what makes the amounts final and postable")
        send item0 to outlet PayrollContext.ToGeneralLedger.ToGeneralLedgerOut
      }
      on other is {
        error "Unexpected message for adaptor ToGeneralLedger"
      }
    } with {
      briefly "to general ledger"
      described as {
        |Carries messages to the external GeneralLedger.
      }
    }
  } with {
    briefly "GeneralLedger integration"
    described as {
      |The model's side of the GeneralLedger conversation.
    }
  }
  adaptor ToHRISSystem to context HRISSystem as flow is { 
    outlet ToHRISSystemOut is type HRISSystem.HRISSystemRequest
    handler ToHRISSystemHandler is {
      on payrollInitiated: event PayrollRun.PayrollInitiated is {
        let askAnswer: type HRISSystem.EmployeeList = ask query HRISSystem.GetEmployeeList of context HRISSystem
        do "a payroll run needing everyone who should be paid in it"
      }
      on payrollCalculated: event PayrollRun.PayrollCalculated is {
        let askAnswer: type HRISSystem.EmployeePayInfo = ask query HRISSystem.GetEmployeePayInfo of context HRISSystem
        do "a calculated payroll needing each person's rate and standing deductions"
      }
      on other is {
        error "Unexpected message for adaptor ToHRISSystem"
      }
    } with {
      briefly "to hris system"
      described as {
        |Carries messages to the external HRISSystem.
      }
    }
  } with {
    briefly "HRISSystem integration"
    described as {
      |The model's side of the HRISSystem conversation.
    }
  }
  adaptor ToTaxService to context TaxService as flow is { 
    outlet ToTaxServiceOut is type TaxService.TaxServiceCommand
    handler ToTaxServiceHandler is {
      on payrollCalculated: event PayrollRun.PayrollCalculated is {
        let askAnswer: type TaxService.TaxCalculation = ask query TaxService.GetTaxCalculation of context TaxService
        do "gross pay being what withholding is computed from"
        let item0: type TaxService.CalculateFederalTax = prompt("translate the payrollCalculated event into a CalculateFederalTax, gross pay being what federal withholding is computed on")
        send item0 to outlet PayrollContext.ToTaxService.ToTaxServiceOut
        let item1: type TaxService.CalculateStateTax = prompt("translate the payrollCalculated event into a CalculateStateTax, and what state withholding is computed on")
        send item1 to outlet PayrollContext.ToTaxService.ToTaxServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToTaxService"
      }
    } with {
      briefly "to tax service"
      described as {
        |Carries messages to the external TaxService.
      }
    }
  } with {
    briefly "TaxService integration"
    described as {
      |The model's side of the TaxService conversation.
    }
  }
  adaptor ToTimeTracking to context TimeTracking as flow is { 
    outlet ToTimeTrackingOut is query TimeTracking.GetTimeEntries
    handler ToTimeTrackingHandler is {
      on timeEntryAdded: event PayrollRun.TimeEntryAdded is {
        let askAnswer: type TimeTracking.TimeEntries = ask query TimeTracking.GetTimeEntries of context TimeTracking
        do "a time entry needing the tracked hours it should match"
      }
      on other is {
        error "Unexpected message for adaptor ToTimeTracking"
      }
    } with {
      briefly "to time tracking"
      described as {
        |Carries messages to the external TimeTracking.
      }
    }
  } with {
    briefly "TimeTracking integration"
    described as {
      |The model's side of the TimeTracking conversation.
    }
  }
  include "types.riddl"
  include "PayrollRun.riddl"
  type PayrollRepositoryCommand is one of {
    PayrollContext.PayrollRepository.PersistDeductionApplied or PayrollContext.PayrollRepository.PersistPaymentsProcessed or PayrollContext.PayrollRepository.PersistPayrollApproved or PayrollContext.PayrollRepository.PersistPayrollCalculated or PayrollContext.PayrollRepository.PersistPayrollCompleted or PayrollContext.PayrollRepository.PersistPayrollInitiated or PayrollContext.PayrollRepository.PersistPayrollSubmittedForApproval or PayrollContext.PayrollRepository.PersistPayrollVoided or PayrollContext.PayrollRepository.PersistTaxesCalculated or PayrollContext.PayrollRepository.PersistTimeEntryAdded
  } with {
    briefly "Anything that writes PayrollRepository"
    described as {
      |The persistence commands PayrollRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository PayrollRepository as flow is {
    inlet PayrollRepositoryFromPayrollAnalytics is type PayrollRepositoryCommand    command PersistDeductionApplied is {
      runId: PayrollRunId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeductionApplied applies to.
        }
      }
    } with {
      briefly "Persist DeductionApplied"
      described as {
        |Instructs this repository to apply DeductionApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentsProcessed is {
      runId: PayrollRunId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentsProcessed applies to.
        }
      }
    } with {
      briefly "Persist PaymentsProcessed"
      described as {
        |Instructs this repository to apply PaymentsProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPayrollApproved is {
      runId: PayrollRunId with {
        briefly "Row addressed"
        described as {
          |Which stored row PayrollApproved applies to.
        }
      }
    } with {
      briefly "Persist PayrollApproved"
      described as {
        |Instructs this repository to apply PayrollApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPayrollCalculated is {
      runId: PayrollRunId with {
        briefly "Row addressed"
        described as {
          |Which stored row PayrollCalculated applies to.
        }
      }
    } with {
      briefly "Persist PayrollCalculated"
      described as {
        |Instructs this repository to apply PayrollCalculated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPayrollInitiated is {
      runId: PayrollRunId with {
        briefly "Row addressed"
        described as {
          |Which stored row PayrollInitiated applies to.
        }
      }
    } with {
      briefly "Persist PayrollInitiated"
      described as {
        |Instructs this repository to apply PayrollInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPayrollSubmittedForApproval is {
      runId: PayrollRunId with {
        briefly "Row addressed"
        described as {
          |Which stored row PayrollSubmittedForApproval applies to.
        }
      }
    } with {
      briefly "Persist PayrollSubmittedForApproval"
      described as {
        |Instructs this repository to apply PayrollSubmittedForApproval to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPayrollVoided is {
      runId: PayrollRunId with {
        briefly "Row addressed"
        described as {
          |Which stored row PayrollVoided applies to.
        }
      }
    } with {
      briefly "Persist PayrollVoided"
      described as {
        |Instructs this repository to apply PayrollVoided to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTaxesCalculated is {
      runId: PayrollRunId with {
        briefly "Row addressed"
        described as {
          |Which stored row TaxesCalculated applies to.
        }
      }
    } with {
      briefly "Persist TaxesCalculated"
      described as {
        |Instructs this repository to apply TaxesCalculated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTimeEntryAdded is {
      runId: PayrollRunId with {
        briefly "Row addressed"
        described as {
          |Which stored row TimeEntryAdded applies to.
        }
      }
    } with {
      briefly "Persist TimeEntryAdded"
      described as {
        |Instructs this repository to apply TimeEntryAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPayrollCompleted is {
      runId: PayrollRunId with {
        briefly "Row addressed"
        described as {
          |Which stored row PayrollCompleted applies to.
        }
      }
    } with {
      briefly "Persist PayrollCompleted"
      described as {
        |Instructs this repository to apply PayrollCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet PayrollRepositoryResponses is result PayrollRun.PayrollRunResult
    record StoredPayrollRun is {
      payrollRunId: PayrollRunId with {
        briefly "payrollRunId"
        described as {
          |The payrollRunId column of the stored payrollRun row.
        }
      }
      payPeriod: PayPeriod with {
        briefly "payPeriod"
        described as {
          |The payPeriod column of the stored payrollRun row.
        }
      }
      runId: PayrollRunId with {
        briefly "runId"
        described as {
          |The runId column of the stored payrollRun row.
        }
      }
      status: PayrollStatus with {
        briefly "status"
        described as {
          |The status column of the stored payrollRun row.
        }
      }
    } with {
      briefly "Stored payrollRun row"
      described as {
        |The persistence shape of payrollRun data as this repository stores it.
      }
    }
    schema PayrollData is relational
      of payrollRuns as record StoredPayrollRun
        index on field StoredPayrollRun.runId
        index on field StoredPayrollRun.payPeriod.periodId
        index on field StoredPayrollRun.status
 with {
      briefly "Payroll data schema"
      described as {
        |The relational schema holding payroll data for the PayrollRepository.
      }
    }
    handler PayrollPersistence is {
      on persistDeductionApplied: command PersistDeductionApplied is {
        do "apply DeductionApplied to the stored row"
      }
      on persistPaymentsProcessed: command PersistPaymentsProcessed is {
        do "apply PaymentsProcessed to the stored row"
      }
      on persistPayrollApproved: command PersistPayrollApproved is {
        do "apply PayrollApproved to the stored row"
      }
      on persistPayrollCalculated: command PersistPayrollCalculated is {
        do "apply PayrollCalculated to the stored row"
      }
      on persistPayrollInitiated: command PersistPayrollInitiated is {
        do "apply PayrollInitiated to the stored row"
      }
      on persistPayrollSubmittedForApproval: command PersistPayrollSubmittedForApproval is {
        do "apply PayrollSubmittedForApproval to the stored row"
      }
      on persistPayrollVoided: command PersistPayrollVoided is {
        do "apply PayrollVoided to the stored row"
      }
      on persistTaxesCalculated: command PersistTaxesCalculated is {
        do "apply TaxesCalculated to the stored row"
      }
      on persistTimeEntryAdded: command PersistTimeEntryAdded is {
        do "apply TimeEntryAdded to the stored row"
      }
      on persistPayrollCompleted: command PersistPayrollCompleted is {
        do "apply PayrollCompleted to the stored row"
      }
      on query GetPayrollMetrics is {
        let payrollMetricsView: type PayrollMetricsView = prompt("read the payroll metrics projection")
        reply payrollMetricsView
      }
    } with {
      briefly "Persists payroll commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Payroll data persistence"
    described as {
      |Persistent storage for payroll.
    }
  }
  query GetPayrollMetrics replies result PayrollMetricsView is {
    payrollMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which payroll metrics to retrieve.
      }
    }
  } with {
    briefly "Get payroll metrics"
    described as {
      |Retrieves the payroll metrics projection.
    }
  }
  result PayrollMetricsView is {
    payrollMetrics: PayrollAnalytics.PayrollMetrics with {
      briefly "Payroll metrics"
      described as {
        |The payroll metrics being returned.
      }
    }
  } with {
    briefly "Payroll metrics view"
    described as {
      |Read model view carrying the payroll metrics projection.
    }
  }
  projector PayrollAnalytics as flow is {
    updates repository PayrollContext.PayrollRepository
    outlet PayrollAnalyticsToRepository is type PayrollRepositoryCommand
    inlet PayrollAnalyticsFromPayrollRun is type PayrollRunEvent    record PayrollMetrics is {
      year: Natural with {
        briefly "Year"
        described as {
          |Fiscal year.
        }
      }
      month: Natural with {
        briefly "Month"
        described as {
          |Month number.
        }
      }
      totalGrossPaid: Decimal(18,2) with {
        briefly "Gross"
        described as {
          |Total gross paid.
        }
      }
      totalTaxesPaid: Decimal(18,2) with {
        briefly "Taxes"
        described as {
          |Total taxes paid.
        }
      }
      totalNetPaid: Decimal(18,2) with {
        briefly "Net"
        described as {
          |Total net paid.
        }
      }
      payrollRunCount: Natural with {
        briefly "Runs"
        described as {
          |Payroll runs.
        }
      }
    } with {
      briefly "Payroll metrics"
      described as {
        |Monthly payroll metrics.
      }
    }
    handler AnalyticsHandler is {
      on deductionApplied: event PayrollRun.DeductionApplied is {
        tell command PayrollContext.PayrollRepository.PersistDeductionApplied(runId = deductionApplied.runId) to repository PayrollContext.PayrollRepository
        do "apply DeductionApplied to the PayrollAnalytics projection"
      }
      on paymentsProcessed: event PayrollRun.PaymentsProcessed is {
        tell command PayrollContext.PayrollRepository.PersistPaymentsProcessed(runId = paymentsProcessed.runId) to repository PayrollContext.PayrollRepository
        do "apply PaymentsProcessed to the PayrollAnalytics projection"
      }
      on payrollApproved: event PayrollRun.PayrollApproved is {
        tell command PayrollContext.PayrollRepository.PersistPayrollApproved(runId = payrollApproved.runId) to repository PayrollContext.PayrollRepository
        do "apply PayrollApproved to the PayrollAnalytics projection"
      }
      on payrollCalculated: event PayrollRun.PayrollCalculated is {
        tell command PayrollContext.PayrollRepository.PersistPayrollCalculated(runId = payrollCalculated.runId) to repository PayrollContext.PayrollRepository
        do "apply PayrollCalculated to the PayrollAnalytics projection"
      }
      on payrollInitiated: event PayrollRun.PayrollInitiated is {
        tell command PayrollContext.PayrollRepository.PersistPayrollInitiated(runId = payrollInitiated.runId) to repository PayrollContext.PayrollRepository
        do "apply PayrollInitiated to the PayrollAnalytics projection"
      }
      on payrollSubmittedForApproval: event PayrollRun.PayrollSubmittedForApproval is {
        tell command PayrollContext.PayrollRepository.PersistPayrollSubmittedForApproval(runId = payrollSubmittedForApproval.runId) to repository PayrollContext.PayrollRepository
        do "apply PayrollSubmittedForApproval to the PayrollAnalytics projection"
      }
      on payrollVoided: event PayrollRun.PayrollVoided is {
        tell command PayrollContext.PayrollRepository.PersistPayrollVoided(runId = payrollVoided.runId) to repository PayrollContext.PayrollRepository
        do "apply PayrollVoided to the PayrollAnalytics projection"
      }
      on taxesCalculated: event PayrollRun.TaxesCalculated is {
        tell command PayrollContext.PayrollRepository.PersistTaxesCalculated(runId = taxesCalculated.runId) to repository PayrollContext.PayrollRepository
        do "apply TaxesCalculated to the PayrollAnalytics projection"
      }
      on timeEntryAdded: event PayrollRun.TimeEntryAdded is {
        tell command PayrollContext.PayrollRepository.PersistTimeEntryAdded(runId = timeEntryAdded.runId) to repository PayrollContext.PayrollRepository
        do "apply TimeEntryAdded to the PayrollAnalytics projection"
      }
      on payrollCompleted: event PayrollRun.PayrollCompleted is {
        tell command PayrollContext.PayrollRepository.PersistPayrollCompleted(runId = payrollCompleted.runId) to repository PayrollContext.PayrollRepository
        do "Aggregate payroll totals by month"
      }
    } with {
      briefly "Maintains payroll analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Payroll analytics"
    described as {
      |Payroll reporting and analysis.
    }
  }
  // ---- Event publication for PayrollRun ----
  type PayrollRunEvent is one of {
    PayrollContext.PayrollRun.PayrollInitiated or PayrollContext.PayrollRun.PayrollCalculated or PayrollContext.PayrollRun.TimeEntryAdded or PayrollContext.PayrollRun.DeductionApplied or PayrollContext.PayrollRun.TaxesCalculated or PayrollContext.PayrollRun.PayrollSubmittedForApproval or PayrollContext.PayrollRun.PayrollApproved or PayrollContext.PayrollRun.PaymentsProcessed or PayrollContext.PayrollRun.PayrollCompleted or PayrollContext.PayrollRun.PayrollVoided
  } with {
    briefly "PayrollRun event alternation"
    described as {
      |Union of all PayrollRun events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet PayrollRunEventSplit as flow is {
    inlet PayrollRunEventSplitIn is type PayrollRunEvent    outlet PayrollRunEventSplitToPayrollAnalytics is type PayrollRunEvent
    handler PayrollRunEventSplitHandler is {
      on payrollInitiated: event PayrollRun.PayrollInitiated is {
        send payrollInitiated to outlet PayrollRunEventSplitToPayrollAnalytics
        tell payrollInitiated to entity PayrollContext.PayrollRun
      }
      on payrollCalculated: event PayrollRun.PayrollCalculated is {
        send payrollCalculated to outlet PayrollRunEventSplitToPayrollAnalytics
        tell payrollCalculated to entity PayrollContext.PayrollRun
      }
      on timeEntryAdded: event PayrollRun.TimeEntryAdded is {
        send timeEntryAdded to outlet PayrollRunEventSplitToPayrollAnalytics
        tell timeEntryAdded to entity PayrollContext.PayrollRun
      }
      on deductionApplied: event PayrollRun.DeductionApplied is {
        send deductionApplied to outlet PayrollRunEventSplitToPayrollAnalytics
        tell deductionApplied to entity PayrollContext.PayrollRun
      }
      on taxesCalculated: event PayrollRun.TaxesCalculated is {
        send taxesCalculated to outlet PayrollRunEventSplitToPayrollAnalytics
        tell taxesCalculated to entity PayrollContext.PayrollRun
      }
      on payrollSubmittedForApproval: event PayrollRun.PayrollSubmittedForApproval is {
        send payrollSubmittedForApproval to outlet PayrollRunEventSplitToPayrollAnalytics
        tell payrollSubmittedForApproval to entity PayrollContext.PayrollRun
      }
      on payrollApproved: event PayrollRun.PayrollApproved is {
        send payrollApproved to outlet PayrollRunEventSplitToPayrollAnalytics
        tell payrollApproved to entity PayrollContext.PayrollRun
      }
      on paymentsProcessed: event PayrollRun.PaymentsProcessed is {
        send paymentsProcessed to outlet PayrollRunEventSplitToPayrollAnalytics
        tell paymentsProcessed to entity PayrollContext.PayrollRun
      }
      on payrollCompleted: event PayrollRun.PayrollCompleted is {
        send payrollCompleted to outlet PayrollRunEventSplitToPayrollAnalytics
        tell payrollCompleted to entity PayrollContext.PayrollRun
      }
      on payrollVoided: event PayrollRun.PayrollVoided is {
        send payrollVoided to outlet PayrollRunEventSplitToPayrollAnalytics
        tell payrollVoided to entity PayrollContext.PayrollRun
      }
      on other is {
        error "Unexpected message for processor PayrollRunEventSplit"
      }
    } with {
      briefly "PayrollRun event fan-out handler"
      described as {
        |Delivers each PayrollRun event to all of its consumers.
      }
    }
  } with {
    briefly "PayrollRun event fan-out"
    described as {
      |Fans PayrollRun events out to the repository and projectors.
    }
  }
  connector 'PayrollRunEvent Stream' is from outlet PayrollContext.PayrollRun.PayrollRunEvents2 to inlet PayrollContext.PayrollRunEventSplit.PayrollRunEventSplitIn with {
    briefly "PayrollRun events, fanned out to storage and read models"
  }
  connector 'PayrollAnalytics Feed' is from outlet PayrollContext.PayrollRunEventSplit.PayrollRunEventSplitToPayrollAnalytics to inlet PayrollContext.PayrollAnalytics.PayrollAnalyticsFromPayrollRun with {
    briefly "PayrollRun events feeding the PayrollAnalytics projection"
  }
  connector 'PayrollAnalytics Storage' is from outlet PayrollContext.PayrollAnalytics.PayrollAnalyticsToRepository to inlet PayrollContext.PayrollRepository.PayrollRepositoryFromPayrollAnalytics with {
    briefly "PayrollAnalytics updates on their way to storage"
  }
} with {
