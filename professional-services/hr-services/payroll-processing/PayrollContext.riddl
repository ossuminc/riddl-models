// Payroll Processing - Payroll Context
context PayrollContext is {
  include "types.riddl"
  include "PayrollRun.riddl"
  repository PayrollRepository is {
    schema PayrollData is relational
      of payrollRuns as type PayrollRun
        index on field PayrollRun.runId
        index on field PayrollRun.payPeriod.periodId
        index on field PayrollRun.status

    handler PayrollPersistence is {
      on command PayrollRun.InitiatePayroll is {
        tell event PayrollRun.PayrollInitiated to entity PayrollContext.PayrollRun
        prompt "Store new payroll run"
      }
      on command PayrollRun.CalculatePayroll is {
        prompt "Store calculated totals"
      }
      on command PayrollRun.AddTimeEntry is {
        tell event PayrollRun.TimeEntryAdded to entity PayrollContext.PayrollRun
        prompt "Store time entry"
      }
      on command PayrollRun.ApprovePayroll is {
        tell event PayrollRun.PayrollApproved to entity PayrollContext.PayrollRun
        prompt "Update status to approved"
      }
      on command PayrollRun.CompletePayroll is {
        tell event PayrollRun.PayrollCompleted to entity PayrollContext.PayrollRun
        prompt "Update status to completed"
      }
    } with {
      briefly "Persists payroll commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Payroll data persistence"
    described as {
      |Persistent storage for payroll.
    }
  }
  projector PayrollAnalytics is {
    updates repository PayrollContext.PayrollRepository
    record PayrollMetrics is  {
      year: Natural with {
        briefly "Year"
        described as {
          |Fiscal year.
        }
      }
      month: Natural with {
        briefly "Month"
        described as {
          |Month number.
        }
      }
      totalGrossPaid: Decimal(18,2) with {
        briefly "Gross"
        described as {
          |Total gross paid.
        }
      }
      totalTaxesPaid: Decimal(18,2) with {
        briefly "Taxes"
        described as {
          |Total taxes paid.
        }
      }
      totalNetPaid: Decimal(18,2) with {
        briefly "Net"
        described as {
          |Total net paid.
        }
      }
      payrollRunCount: Natural with {
        briefly "Runs"
        described as {
          |Payroll runs.
        }
      }
    } with {
      briefly "Payroll metrics"
      described as {
        |Monthly payroll metrics.
      }
    }
    handler AnalyticsHandler is {
      on event PayrollRun.PayrollCompleted is {
        tell event PayrollRun.PayrollCompleted to repository PayrollContext.PayrollRepository
        prompt "Aggregate payroll totals by month"
      }
    } with {
      briefly "Maintains payroll analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Payroll analytics"
    described as {
      |Payroll reporting and analysis.
    }
  }
  // ---- Event publication for PayrollRun ----
  type PayrollRunEvent is one of {
    PayrollContext.PayrollRun.PayrollInitiated,
    PayrollContext.PayrollRun.PayrollCalculated,
    PayrollContext.PayrollRun.TimeEntryAdded,
    PayrollContext.PayrollRun.DeductionApplied,
    PayrollContext.PayrollRun.TaxesCalculated,
    PayrollContext.PayrollRun.PayrollSubmittedForApproval,
    PayrollContext.PayrollRun.PayrollApproved,
    PayrollContext.PayrollRun.PaymentsProcessed,
    PayrollContext.PayrollRun.PayrollCompleted,
    PayrollContext.PayrollRun.PayrollVoided
  } with {
    briefly "PayrollRun event alternation"
    described as {
      |Union of all PayrollRun events, for streaming and event-sourced
      |persistence.
    }
  }
  processor PayrollRunEventSource as source is {
    outlet PayrollRunEvents is type PayrollRunEvent
    handler PayrollRunSourceHandler is {
      on event PayrollRun.PayrollInitiated is {
        send event PayrollRun.PayrollInitiated to outlet PayrollRunEvents
      }
      on event PayrollRun.PayrollCalculated is {
        send event PayrollRun.PayrollCalculated to outlet PayrollRunEvents
      }
      on event PayrollRun.TimeEntryAdded is {
        send event PayrollRun.TimeEntryAdded to outlet PayrollRunEvents
      }
      on event PayrollRun.DeductionApplied is {
        send event PayrollRun.DeductionApplied to outlet PayrollRunEvents
      }
      on event PayrollRun.TaxesCalculated is {
        send event PayrollRun.TaxesCalculated to outlet PayrollRunEvents
      }
      on event PayrollRun.PayrollSubmittedForApproval is {
        send event PayrollRun.PayrollSubmittedForApproval to outlet PayrollRunEvents
      }
      on event PayrollRun.PayrollApproved is {
        send event PayrollRun.PayrollApproved to outlet PayrollRunEvents
      }
      on event PayrollRun.PaymentsProcessed is {
        send event PayrollRun.PaymentsProcessed to outlet PayrollRunEvents
      }
      on event PayrollRun.PayrollCompleted is {
        send event PayrollRun.PayrollCompleted to outlet PayrollRunEvents
      }
      on event PayrollRun.PayrollVoided is {
        send event PayrollRun.PayrollVoided to outlet PayrollRunEvents
      }
      on other is {
        error "Unexpected message for source PayrollRunEventSource"
      }
    } with {
      briefly "PayrollRun source handler"
      described as {
        |Publishes PayrollRun events onto the outlet.
      }
    }
  } with {
    briefly "PayrollRun event source"
    described as {
      |Publishes PayrollRun entity events into the streaming topology.
    }
  }
  processor PayrollRunEventSink as sink is {
    inlet PayrollRunInlet is type PayrollRunEvent
    handler PayrollRunSinkHandler is {
      on event PayrollRun.PayrollInitiated is {
        tell event PayrollRun.PayrollInitiated to repository PayrollContext.PayrollRepository
      }
      on event PayrollRun.PayrollCalculated is {
        tell event PayrollRun.PayrollCalculated to repository PayrollContext.PayrollRepository
      }
      on event PayrollRun.TimeEntryAdded is {
        tell event PayrollRun.TimeEntryAdded to repository PayrollContext.PayrollRepository
      }
      on event PayrollRun.DeductionApplied is {
        tell event PayrollRun.DeductionApplied to repository PayrollContext.PayrollRepository
      }
      on event PayrollRun.TaxesCalculated is {
        tell event PayrollRun.TaxesCalculated to repository PayrollContext.PayrollRepository
      }
      on event PayrollRun.PayrollSubmittedForApproval is {
        tell event PayrollRun.PayrollSubmittedForApproval to repository PayrollContext.PayrollRepository
      }
      on event PayrollRun.PayrollApproved is {
        tell event PayrollRun.PayrollApproved to repository PayrollContext.PayrollRepository
      }
      on event PayrollRun.PaymentsProcessed is {
        tell event PayrollRun.PaymentsProcessed to repository PayrollContext.PayrollRepository
      }
      on event PayrollRun.PayrollCompleted is {
        tell event PayrollRun.PayrollCompleted to repository PayrollContext.PayrollRepository
      }
      on event PayrollRun.PayrollVoided is {
        tell event PayrollRun.PayrollVoided to repository PayrollContext.PayrollRepository
      }
      on other is {
        error "Unexpected message for sink PayrollRunEventSink"
      }
    } with {
      briefly "PayrollRun sink handler"
      described as {
        |Persists PayrollRun events via the repository.
      }
    }
  } with {
    briefly "PayrollRun event sink"
    described as {
      |Receives PayrollRun events for persistence.
    }
  }
  connector PayrollRunEventFlow is {
    from outlet PayrollContext.PayrollRunEventSource.PayrollRunEvents to
      inlet PayrollContext.PayrollRunEventSink.PayrollRunInlet
  } with {
    briefly "PayrollRun event flow"
    described as {
      |Connects the PayrollRun source to its sink.
    }
  }
} with {
  briefly "Bounded context for payroll processing"
  described as {
    |Payroll and compensation context.
  }
}
