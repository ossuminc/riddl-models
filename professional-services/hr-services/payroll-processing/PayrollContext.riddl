// Payroll Processing - Payroll Context
context PayrollContext is {
  adaptor FromBankingService from context BankingService is { 
    handler FromBankingServiceHandler is {
      on event BankingService.ACHBatchSettled is {
        do "the model receives ach batch settled"
      }
      on event BankingService.ACHBatchSubmitted is {
        do "the model receives ach batch submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromBankingService"
      }
    } with {
      briefly "from banking service"
      described as {
        |Carries messages from the external BankingService.
      }
    }
  } with {
    briefly "BankingService integration"
    described as {
      |The model's side of the BankingService conversation.
    }
  }
  adaptor ToBankingService to context BankingService is { 
    handler ToBankingServiceHandler is {
      on command BankingService.SubmitACHBatch is {
        do "the model sends submit ach batch"
      }
      on other is {
        error "Unexpected message for adaptor ToBankingService"
      }
    } with {
      briefly "to banking service"
      described as {
        |Carries messages to the external BankingService.
      }
    }
  } with {
    briefly "BankingService integration"
    described as {
      |The model's side of the BankingService conversation.
    }
  }
  adaptor FromGeneralLedger from context GeneralLedger is { 
    handler FromGeneralLedgerHandler is {
      on event GeneralLedger.JournalEntryPosted is {
        do "the model receives journal entry posted"
      }
      on other is {
        error "Unexpected message for adaptor FromGeneralLedger"
      }
    } with {
      briefly "from general ledger"
      described as {
        |Carries messages from the external GeneralLedger.
      }
    }
  } with {
    briefly "GeneralLedger integration"
    described as {
      |The model's side of the GeneralLedger conversation.
    }
  }
  adaptor ToGeneralLedger to context GeneralLedger is { 
    handler ToGeneralLedgerHandler is {
      on command GeneralLedger.PostPayrollJournalEntry is {
        do "the model sends post payroll journal entry"
      }
      on other is {
        error "Unexpected message for adaptor ToGeneralLedger"
      }
    } with {
      briefly "to general ledger"
      described as {
        |Carries messages to the external GeneralLedger.
      }
    }
  } with {
    briefly "GeneralLedger integration"
    described as {
      |The model's side of the GeneralLedger conversation.
    }
  }
  adaptor FromHRISSystem from context HRISSystem is { 
    handler FromHRISSystemHandler is {
      on result HRISSystem.EmployeeList is {
        do "the model receives employee list"
      }
      on result HRISSystem.EmployeePayInfo is {
        do "the model receives employee pay info"
      }
      on other is {
        error "Unexpected message for adaptor FromHRISSystem"
      }
    } with {
      briefly "from hris system"
      described as {
        |Carries messages from the external HRISSystem.
      }
    }
  } with {
    briefly "HRISSystem integration"
    described as {
      |The model's side of the HRISSystem conversation.
    }
  }
  adaptor ToHRISSystem to context HRISSystem is { 
    handler ToHRISSystemHandler is {
      on query HRISSystem.GetEmployeeList is {
        do "the model sends get employee list"
      }
      on query HRISSystem.GetEmployeePayInfo is {
        do "the model sends get employee pay info"
      }
      on other is {
        error "Unexpected message for adaptor ToHRISSystem"
      }
    } with {
      briefly "to hris system"
      described as {
        |Carries messages to the external HRISSystem.
      }
    }
  } with {
    briefly "HRISSystem integration"
    described as {
      |The model's side of the HRISSystem conversation.
    }
  }
  adaptor FromTaxService from context TaxService is { 
    handler FromTaxServiceHandler is {
      on result TaxService.TaxCalculation is {
        do "the model receives tax calculation"
      }
      on other is {
        error "Unexpected message for adaptor FromTaxService"
      }
    } with {
      briefly "from tax service"
      described as {
        |Carries messages from the external TaxService.
      }
    }
  } with {
    briefly "TaxService integration"
    described as {
      |The model's side of the TaxService conversation.
    }
  }
  adaptor ToTaxService to context TaxService is { 
    handler ToTaxServiceHandler is {
      on command TaxService.CalculateFederalTax is {
        do "the model sends calculate federal tax"
      }
      on command TaxService.CalculateStateTax is {
        do "the model sends calculate state tax"
      }
      on query TaxService.GetTaxCalculation is {
        do "the model sends get tax calculation"
      }
      on other is {
        error "Unexpected message for adaptor ToTaxService"
      }
    } with {
      briefly "to tax service"
      described as {
        |Carries messages to the external TaxService.
      }
    }
  } with {
    briefly "TaxService integration"
    described as {
      |The model's side of the TaxService conversation.
    }
  }
  adaptor FromTimeTracking from context TimeTracking is { 
    handler FromTimeTrackingHandler is {
      on result TimeTracking.TimeEntries is {
        do "the model receives time entries"
      }
      on other is {
        error "Unexpected message for adaptor FromTimeTracking"
      }
    } with {
      briefly "from time tracking"
      described as {
        |Carries messages from the external TimeTracking.
      }
    }
  } with {
    briefly "TimeTracking integration"
    described as {
      |The model's side of the TimeTracking conversation.
    }
  }
  adaptor ToTimeTracking to context TimeTracking is { 
    handler ToTimeTrackingHandler is {
      on query TimeTracking.GetTimeEntries is {
        do "the model sends get time entries"
      }
      on other is {
        error "Unexpected message for adaptor ToTimeTracking"
      }
    } with {
      briefly "to time tracking"
      described as {
        |Carries messages to the external TimeTracking.
      }
    }
  } with {
    briefly "TimeTracking integration"
    described as {
      |The model's side of the TimeTracking conversation.
    }
  }
  include "types.riddl"
  include "PayrollRun.riddl"
  repository PayrollRepository as merge is {
    inlet PayrollRepositoryFromPayrollRun is type PayrollRunEvent    inlet PayrollRepositoryFromPayrollAnalytics is type PayrollRunEvent    outlet PayrollRepositoryResponses is type PayrollRun.PayrollRunResult
    record StoredPayrollRun is  {
      payrollRunId: PayrollRunId with {
        briefly "payrollRunId"
        described as {
          |The payrollRunId column of the stored payrollRun row.
        }
      }
      payPeriod: PayPeriod with {
        briefly "payPeriod"
        described as {
          |The payPeriod column of the stored payrollRun row.
        }
      }
      runId: PayrollRunId with {
        briefly "runId"
        described as {
          |The runId column of the stored payrollRun row.
        }
      }
      status: PayrollStatus with {
        briefly "status"
        described as {
          |The status column of the stored payrollRun row.
        }
      }
    } with {
      briefly "Stored payrollRun row"
      described as {
        |The persistence shape of payrollRun data as this repository stores it.
      }
    }
    schema PayrollData is relational
      of payrollRuns as type StoredPayrollRun
        index on field StoredPayrollRun.runId
        index on field StoredPayrollRun.payPeriod.periodId
        index on field StoredPayrollRun.status
 with {
      briefly "Payroll data schema"
      described as {
        |The relational schema holding payroll data for the PayrollRepository.
      }
    }
    handler PayrollPersistence is {
      on query GetPayrollMetrics is {
        do "read the payroll metrics projection"
        reply result PayrollMetricsView
      }
      on command PayrollRun.InitiatePayroll is {
        tell event PayrollRun.PayrollInitiated to entity PayrollContext.PayrollRun
        do "Store new payroll run"
      }
      on command PayrollRun.CalculatePayroll is {
        do "Store calculated totals"
      }
      on command PayrollRun.AddTimeEntry is {
        tell event PayrollRun.TimeEntryAdded to entity PayrollContext.PayrollRun
        do "Store time entry"
      }
      on command PayrollRun.ApprovePayroll is {
        tell event PayrollRun.PayrollApproved to entity PayrollContext.PayrollRun
        do "Update status to approved"
      }
      on command PayrollRun.CompletePayroll is {
        tell event PayrollRun.PayrollCompleted to entity PayrollContext.PayrollRun
        do "Update status to completed"
      }
    } with {
      briefly "Persists payroll commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Payroll data persistence"
    described as {
      |Persistent storage for payroll.
    }
  }
  query GetPayrollMetrics is  {
    payrollMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which payroll metrics to retrieve.
      }
    }
  } with {
    briefly "Get payroll metrics"
    described as {
      |Retrieves the payroll metrics projection.
    }
  }
  result PayrollMetricsView is  {
    payrollMetrics: PayrollAnalytics.PayrollMetrics with {
      briefly "Payroll metrics"
      described as {
        |The payroll metrics being returned.
      }
    }
  } with {
    briefly "Payroll metrics view"
    described as {
      |Read model view carrying the payroll metrics projection.
    }
  }
  projector PayrollAnalytics as flow is {
    updates repository PayrollContext.PayrollRepository
    inlet PayrollAnalyticsFromPayrollRun is type PayrollRunEvent    outlet PayrollAnalyticsOut is type PayrollRunEvent
    record PayrollMetrics is  {
      year: Natural with {
        briefly "Year"
        described as {
          |Fiscal year.
        }
      }
      month: Natural with {
        briefly "Month"
        described as {
          |Month number.
        }
      }
      totalGrossPaid: Decimal(18,2) with {
        briefly "Gross"
        described as {
          |Total gross paid.
        }
      }
      totalTaxesPaid: Decimal(18,2) with {
        briefly "Taxes"
        described as {
          |Total taxes paid.
        }
      }
      totalNetPaid: Decimal(18,2) with {
        briefly "Net"
        described as {
          |Total net paid.
        }
      }
      payrollRunCount: Natural with {
        briefly "Runs"
        described as {
          |Payroll runs.
        }
      }
    } with {
      briefly "Payroll metrics"
      described as {
        |Monthly payroll metrics.
      }
    }
    handler AnalyticsHandler is {
      on payrollCompleted: event PayrollRun.PayrollCompleted is {
        tell payrollCompleted to repository PayrollContext.PayrollRepository
        do "Aggregate payroll totals by month"
      }
    } with {
      briefly "Maintains payroll analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Payroll analytics"
    described as {
      |Payroll reporting and analysis.
    }
  }
  // ---- Event publication for PayrollRun ----
  type PayrollRunEvent is one of {
    PayrollContext.PayrollRun.PayrollInitiated or PayrollContext.PayrollRun.PayrollCalculated or PayrollContext.PayrollRun.TimeEntryAdded or PayrollContext.PayrollRun.DeductionApplied or PayrollContext.PayrollRun.TaxesCalculated or PayrollContext.PayrollRun.PayrollSubmittedForApproval or PayrollContext.PayrollRun.PayrollApproved or PayrollContext.PayrollRun.PaymentsProcessed or PayrollContext.PayrollRun.PayrollCompleted or PayrollContext.PayrollRun.PayrollVoided
  } with {
    briefly "PayrollRun event alternation"
    described as {
      |Union of all PayrollRun events, for streaming and event-sourced
      |persistence.
    }
  }
  processor PayrollRunEventSource as source is {
    outlet PayrollRunEvents is type PayrollRunEvent
    handler PayrollRunSourceHandler is {
      on payrollInitiated: event PayrollRun.PayrollInitiated is {
        send payrollInitiated to outlet PayrollRunEvents
      }
      on payrollCalculated: event PayrollRun.PayrollCalculated is {
        send payrollCalculated to outlet PayrollRunEvents
      }
      on timeEntryAdded: event PayrollRun.TimeEntryAdded is {
        send timeEntryAdded to outlet PayrollRunEvents
      }
      on deductionApplied: event PayrollRun.DeductionApplied is {
        send deductionApplied to outlet PayrollRunEvents
      }
      on taxesCalculated: event PayrollRun.TaxesCalculated is {
        send taxesCalculated to outlet PayrollRunEvents
      }
      on payrollSubmittedForApproval: event PayrollRun.PayrollSubmittedForApproval is {
        send payrollSubmittedForApproval to outlet PayrollRunEvents
      }
      on payrollApproved: event PayrollRun.PayrollApproved is {
        send payrollApproved to outlet PayrollRunEvents
      }
      on paymentsProcessed: event PayrollRun.PaymentsProcessed is {
        send paymentsProcessed to outlet PayrollRunEvents
      }
      on payrollCompleted: event PayrollRun.PayrollCompleted is {
        send payrollCompleted to outlet PayrollRunEvents
      }
      on payrollVoided: event PayrollRun.PayrollVoided is {
        send payrollVoided to outlet PayrollRunEvents
      }
      on other is {
        error "Unexpected message for source PayrollRunEventSource"
      }
    } with {
      briefly "PayrollRun source handler"
      described as {
        |Publishes PayrollRun events onto the outlet.
      }
    }
  } with {
    briefly "PayrollRun event source"
    described as {
      |Publishes PayrollRun entity events into the streaming topology.
    }
  }
  processor PayrollRunEventSink as sink is {
    inlet PayrollRunInlet is type PayrollRunEvent    handler PayrollRunSinkHandler is {
      on payrollInitiated: event PayrollRun.PayrollInitiated is {
        tell payrollInitiated to repository PayrollContext.PayrollRepository
      }
      on payrollCalculated: event PayrollRun.PayrollCalculated is {
        tell payrollCalculated to repository PayrollContext.PayrollRepository
      }
      on timeEntryAdded: event PayrollRun.TimeEntryAdded is {
        tell timeEntryAdded to repository PayrollContext.PayrollRepository
      }
      on deductionApplied: event PayrollRun.DeductionApplied is {
        tell deductionApplied to repository PayrollContext.PayrollRepository
      }
      on taxesCalculated: event PayrollRun.TaxesCalculated is {
        tell taxesCalculated to repository PayrollContext.PayrollRepository
      }
      on payrollSubmittedForApproval: event PayrollRun.PayrollSubmittedForApproval is {
        tell payrollSubmittedForApproval to repository PayrollContext.PayrollRepository
      }
      on payrollApproved: event PayrollRun.PayrollApproved is {
        tell payrollApproved to repository PayrollContext.PayrollRepository
      }
      on paymentsProcessed: event PayrollRun.PaymentsProcessed is {
        tell paymentsProcessed to repository PayrollContext.PayrollRepository
      }
      on payrollCompleted: event PayrollRun.PayrollCompleted is {
        tell payrollCompleted to repository PayrollContext.PayrollRepository
      }
      on payrollVoided: event PayrollRun.PayrollVoided is {
        tell payrollVoided to repository PayrollContext.PayrollRepository
      }
      on other is {
        error "Unexpected message for sink PayrollRunEventSink"
      }
    } with {
      briefly "PayrollRun sink handler"
      described as {
        |Persists PayrollRun events via the repository.
      }
    }
  } with {
    briefly "PayrollRun event sink"
    described as {
      |Receives PayrollRun events for persistence.
    }
  }
  connector PayrollRunEventFlow is from outlet PayrollContext.PayrollRunEventSource.PayrollRunEvents to inlet PayrollContext.PayrollRunEventSink.PayrollRunInlet with {
    briefly "PayrollRun event flow"
    described as {
      |Connects the PayrollRun source to its sink.
    }
  }
  processor PayrollRunEventSplit as split is {
    inlet PayrollRunEventSplitIn is type PayrollRunEvent    outlet PayrollRunEventSplitToPayrollRepository is type PayrollRunEvent
    outlet PayrollRunEventSplitToPayrollAnalytics is type PayrollRunEvent
    handler PayrollRunEventSplitHandler is {
      on payrollInitiated: event PayrollRun.PayrollInitiated is {
        send payrollInitiated to outlet PayrollRunEventSplitToPayrollRepository
        send payrollInitiated to outlet PayrollRunEventSplitToPayrollAnalytics
        tell payrollInitiated to entity PayrollContext.PayrollRun
      }
      on payrollCalculated: event PayrollRun.PayrollCalculated is {
        send payrollCalculated to outlet PayrollRunEventSplitToPayrollRepository
        send payrollCalculated to outlet PayrollRunEventSplitToPayrollAnalytics
        tell payrollCalculated to entity PayrollContext.PayrollRun
      }
      on timeEntryAdded: event PayrollRun.TimeEntryAdded is {
        send timeEntryAdded to outlet PayrollRunEventSplitToPayrollRepository
        send timeEntryAdded to outlet PayrollRunEventSplitToPayrollAnalytics
        tell timeEntryAdded to entity PayrollContext.PayrollRun
      }
      on deductionApplied: event PayrollRun.DeductionApplied is {
        send deductionApplied to outlet PayrollRunEventSplitToPayrollRepository
        send deductionApplied to outlet PayrollRunEventSplitToPayrollAnalytics
        tell deductionApplied to entity PayrollContext.PayrollRun
      }
      on taxesCalculated: event PayrollRun.TaxesCalculated is {
        send taxesCalculated to outlet PayrollRunEventSplitToPayrollRepository
        send taxesCalculated to outlet PayrollRunEventSplitToPayrollAnalytics
        tell taxesCalculated to entity PayrollContext.PayrollRun
      }
      on payrollSubmittedForApproval: event PayrollRun.PayrollSubmittedForApproval is {
        send payrollSubmittedForApproval to outlet PayrollRunEventSplitToPayrollRepository
        send payrollSubmittedForApproval to outlet PayrollRunEventSplitToPayrollAnalytics
        tell payrollSubmittedForApproval to entity PayrollContext.PayrollRun
      }
      on payrollApproved: event PayrollRun.PayrollApproved is {
        send payrollApproved to outlet PayrollRunEventSplitToPayrollRepository
        send payrollApproved to outlet PayrollRunEventSplitToPayrollAnalytics
        tell payrollApproved to entity PayrollContext.PayrollRun
      }
      on paymentsProcessed: event PayrollRun.PaymentsProcessed is {
        send paymentsProcessed to outlet PayrollRunEventSplitToPayrollRepository
        send paymentsProcessed to outlet PayrollRunEventSplitToPayrollAnalytics
        tell paymentsProcessed to entity PayrollContext.PayrollRun
      }
      on payrollCompleted: event PayrollRun.PayrollCompleted is {
        send payrollCompleted to outlet PayrollRunEventSplitToPayrollRepository
        send payrollCompleted to outlet PayrollRunEventSplitToPayrollAnalytics
        tell payrollCompleted to entity PayrollContext.PayrollRun
      }
      on payrollVoided: event PayrollRun.PayrollVoided is {
        send payrollVoided to outlet PayrollRunEventSplitToPayrollRepository
        send payrollVoided to outlet PayrollRunEventSplitToPayrollAnalytics
        tell payrollVoided to entity PayrollContext.PayrollRun
      }
      on other is {
        error "Unexpected message for processor PayrollRunEventSplit"
      }
    } with {
      briefly "PayrollRun event fan-out handler"
      described as {
        |Delivers each PayrollRun event to all of its consumers.
      }
    }
  } with {
    briefly "PayrollRun event fan-out"
    described as {
      |Fans PayrollRun events out to the repository and projectors.
    }
  }
  connector 'PayrollRunEvent Stream' is from outlet PayrollContext.PayrollRun.PayrollRunEvents2 to inlet PayrollContext.PayrollRunEventSplit.PayrollRunEventSplitIn with {
    briefly "PayrollRun events, fanned out to storage and read models"
  }
  connector 'PayrollRunEvent Storage' is from outlet PayrollContext.PayrollRunEventSplit.PayrollRunEventSplitToPayrollRepository to inlet PayrollContext.PayrollRepository.PayrollRepositoryFromPayrollRun with {
    briefly "PayrollRun events on their way to storage"
  }
  connector 'PayrollAnalytics Feed' is from outlet PayrollContext.PayrollRunEventSplit.PayrollRunEventSplitToPayrollAnalytics to inlet PayrollContext.PayrollAnalytics.PayrollAnalyticsFromPayrollRun with {
    briefly "PayrollRun events feeding the PayrollAnalytics projection"
  }
  connector 'PayrollAnalytics Storage' is from outlet PayrollContext.PayrollAnalytics.PayrollAnalyticsOut to inlet PayrollContext.PayrollRepository.PayrollRepositoryFromPayrollAnalytics with {
    briefly "The PayrollAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for payroll processing"
  described as {
    |Payroll and compensation context.
  }
}
