// Payroll Processing Domain Model
// Employee payroll and compensation management
domain PayrollProcessing is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user PayrollManager is "person overseeing payroll operations" with {
    briefly "Payroll Manager"
    described as {
      |Manager responsible for payroll.
    }
  }
  user PayrollSpecialist is "person processing payroll" with {
    briefly "Payroll Specialist"
    described as {
      |Specialist handling payroll calculations.
    }
  }
  user HRAdministrator is "person managing employee records" with {
    briefly "HR Administrator"
    described as {
      |Administrator maintaining HR data.
    }
  }
  epic PayrollManagement is {
    user PayrollManager wants to "to process payroll accurately" so that "employees are paid correctly and on time"
    case ProcessPayroll is {
      user PayrollManager wants to "to run payroll cycle" so that "employees receive compensation"
      step is "System calculates" "earnings and deductions" "for period" with {
        briefly "Calculate pay"
        described as {
          |Compute compensation.
        }
      }
      step is "Manager reviews" "payroll report" "for approval" with {
        briefly "Review payroll"
        described as {
          |Verify accuracy.
        }
      }
    } with {
      briefly "Process payroll"
      described as {
        |Running payroll cycle.
      }
    }
  } with {
    briefly "Payroll management"
    described as {
      |Epic for payroll processing.
    }
  }
  include "PayrollContext.riddl"
  include "external-contexts.riddl"
  application context PayrollProcessingApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PayrollProcessing are delivered.
      }
    }
    outlet AppPayrollRunCommands is type PayrollContext.PayrollRun.PayrollRunCommand
    inlet AppPayrollRepositoryResponses is type PayrollContext.PayrollRun.PayrollRunResult    handler PayrollProcessingAppHandler is {
      on other is {
        error "Unexpected message for application context PayrollProcessingApp"
      }
    } with {
      briefly "PayrollProcessingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PayrollProcessingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'PayrollRunCommand Stream' is from outlet PayrollProcessingApp.AppPayrollRunCommands to inlet PayrollContext.PayrollRun.PayrollRunCommands with {
    briefly "PayrollRun commands from the application"
  }
  persistent connector 'PayrollRunResult Stream' is from outlet PayrollContext.PayrollRepository.PayrollRepositoryResponses to inlet PayrollProcessingApp.AppPayrollRepositoryResponses with {
    briefly "Payroll query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PayrollProcessingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Payroll processing domain"
  described as {
    |Employee payroll and compensation.
  }
}
