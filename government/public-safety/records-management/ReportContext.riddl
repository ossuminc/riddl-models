// Records Management - Report Context
context ReportContext as router is {
  inlet ReportCommandStreamIn is type ReportCommand  outlet ReportCommandStreamOut is type ReportCommand
  inlet ReportResultStreamIn is result Report.ReportQueryResult  outlet ReportResultStreamOut is result Report.ReportQueryResult
  handler ReportContextBoundary is {
    on createReport: command Report.CreateReport is {
      send createReport to outlet ReportContext.ReportCommandStreamOut
    }
    on updateReportDetails: command Report.UpdateReportDetails is {
      send updateReportDetails to outlet ReportContext.ReportCommandStreamOut
    }
    on addOffense: command Report.AddOffense is {
      send addOffense to outlet ReportContext.ReportCommandStreamOut
    }
    on removeOffense: command Report.RemoveOffense is {
      send removeOffense to outlet ReportContext.ReportCommandStreamOut
    }
    on addInvolvedParty: command Report.AddInvolvedParty is {
      send addInvolvedParty to outlet ReportContext.ReportCommandStreamOut
    }
    on updateInvolvedParty: command Report.UpdateInvolvedParty is {
      send updateInvolvedParty to outlet ReportContext.ReportCommandStreamOut
    }
    on addVehicle: command Report.AddVehicle is {
      send addVehicle to outlet ReportContext.ReportCommandStreamOut
    }
    on addProperty: command Report.AddProperty is {
      send addProperty to outlet ReportContext.ReportCommandStreamOut
    }
    on addEvidence: command Report.AddEvidence is {
      send addEvidence to outlet ReportContext.ReportCommandStreamOut
    }
    on updateEvidenceCustody: command Report.UpdateEvidenceCustody is {
      send updateEvidenceCustody to outlet ReportContext.ReportCommandStreamOut
    }
    on recordArrest: command Report.RecordArrest is {
      send recordArrest to outlet ReportContext.ReportCommandStreamOut
    }
    on writeNarrative: command Report.WriteNarrative is {
      send writeNarrative to outlet ReportContext.ReportCommandStreamOut
    }
    on submitForReview: command Report.SubmitForReview is {
      send submitForReview to outlet ReportContext.ReportCommandStreamOut
    }
    on approveReport: command Report.ApproveReport is {
      send approveReport to outlet ReportContext.ReportCommandStreamOut
    }
    on rejectReport: command Report.RejectReport is {
      send rejectReport to outlet ReportContext.ReportCommandStreamOut
    }
    on linkToCase: command Report.LinkToCase is {
      send linkToCase to outlet ReportContext.ReportCommandStreamOut
    }
    on sealReport: command Report.SealReport is {
      send sealReport to outlet ReportContext.ReportCommandStreamOut
    }
    on expungeReport: command Report.ExpungeReport is {
      send expungeReport to outlet ReportContext.ReportCommandStreamOut
    }
    on reportQueryResult: result Report.ReportQueryResult is {
      send reportQueryResult to outlet ReportContext.ReportResultStreamOut
    }
    on other is {
      error "Unexpected message at the ReportContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ReportCommand Stream Intake' is from outlet ReportContext.ReportCommandStreamOut to inlet ReportContext.Report.ReportCommands  connector 'ReportResult Stream Egress' is from outlet ReportContext.ReportRepository.ReportRepositoryResponses to inlet ReportContext.ReportResultStreamIn  adaptor FromCourtService from context CourtService is { 
    handler FromCourtServiceHandler is {
      on event CourtService.ProtectiveOrderIssued is {
        do "the model receives protective order issued"
      }
      on event CourtService.WarrantIssued is {
        do "the model receives warrant issued"
      }
      on event CourtService.WarrantRecalled is {
        do "the model receives warrant recalled"
      }
      on other is {
        error "Unexpected message for adaptor FromCourtService"
      }
    } with {
      briefly "from court service"
      described as {
        |Carries messages from the external CourtService.
      }
    }
  } with {
    briefly "CourtService integration"
    described as {
      |The model's side of the CourtService conversation.
    }
  }
  adaptor FromDMVService from context DMVService is { 
    handler FromDMVServiceHandler is {
      on result DMVService.DriverInfoResult is {
        do "the model receives driver info result"
      }
      on result DMVService.VehicleRegistrationResult is {
        do "the model receives vehicle registration result"
      }
      on other is {
        error "Unexpected message for adaptor FromDMVService"
      }
    } with {
      briefly "from dmv service"
      described as {
        |Carries messages from the external DMVService.
      }
    }
  } with {
    briefly "DMVService integration"
    described as {
      |The model's side of the DMVService conversation.
    }
  }
  adaptor ToDMVService to context DMVService is { 
    handler ToDMVServiceHandler is {
      on query DMVService.GetDriverInfo is {
        do "the model sends get driver info"
      }
      on query DMVService.GetVehicleRegistration is {
        do "the model sends get vehicle registration"
      }
      on other is {
        error "Unexpected message for adaptor ToDMVService"
      }
    } with {
      briefly "to dmv service"
      described as {
        |Carries messages to the external DMVService.
      }
    }
  } with {
    briefly "DMVService integration"
    described as {
      |The model's side of the DMVService conversation.
    }
  }
  adaptor FromEvidenceLabService from context EvidenceLabService is { 
    handler FromEvidenceLabServiceHandler is {
      on event EvidenceLabService.AnalysisCompleted is {
        do "the model receives analysis completed"
      }
      on event EvidenceLabService.AnalysisReceived is {
        do "the model receives analysis received"
      }
      on other is {
        error "Unexpected message for adaptor FromEvidenceLabService"
      }
    } with {
      briefly "from evidence lab service"
      described as {
        |Carries messages from the external EvidenceLabService.
      }
    }
  } with {
    briefly "EvidenceLabService integration"
    described as {
      |The model's side of the EvidenceLabService conversation.
    }
  }
  adaptor ToEvidenceLabService to context EvidenceLabService is { 
    handler ToEvidenceLabServiceHandler is {
      on command EvidenceLabService.SubmitForAnalysis is {
        do "the model sends submit for analysis"
      }
      on other is {
        error "Unexpected message for adaptor ToEvidenceLabService"
      }
    } with {
      briefly "to evidence lab service"
      described as {
        |Carries messages to the external EvidenceLabService.
      }
    }
  } with {
    briefly "EvidenceLabService integration"
    described as {
      |The model's side of the EvidenceLabService conversation.
    }
  }
  adaptor FromJailService from context JailService is { 
    handler FromJailServiceHandler is {
      on event JailService.InmateReleased is {
        do "the model receives inmate released"
      }
      on result JailService.InmateStatusResult is {
        do "the model receives inmate status result"
      }
      on other is {
        error "Unexpected message for adaptor FromJailService"
      }
    } with {
      briefly "from jail service"
      described as {
        |Carries messages from the external JailService.
      }
    }
  } with {
    briefly "JailService integration"
    described as {
      |The model's side of the JailService conversation.
    }
  }
  adaptor ToJailService to context JailService is { 
    handler ToJailServiceHandler is {
      on query JailService.GetInmateStatus is {
        do "the model sends get inmate status"
      }
      on other is {
        error "Unexpected message for adaptor ToJailService"
      }
    } with {
      briefly "to jail service"
      described as {
        |Carries messages to the external JailService.
      }
    }
  } with {
    briefly "JailService integration"
    described as {
      |The model's side of the JailService conversation.
    }
  }
  adaptor FromNCICService from context NCICService is { 
    handler FromNCICServiceHandler is {
      on result NCICService.PersonCheckResult is {
        do "the model receives person check result"
      }
      on result NCICService.PropertyCheckResult is {
        do "the model receives property check result"
      }
      on result NCICService.VehicleCheckResult is {
        do "the model receives vehicle check result"
      }
      on other is {
        error "Unexpected message for adaptor FromNCICService"
      }
    } with {
      briefly "from ncic service"
      described as {
        |Carries messages from the external NCICService.
      }
    }
  } with {
    briefly "NCICService integration"
    described as {
      |The model's side of the NCICService conversation.
    }
  }
  adaptor ToNCICService to context NCICService is { 
    handler ToNCICServiceHandler is {
      on query NCICService.RunPersonCheck is {
        do "the model sends run person check"
      }
      on query NCICService.RunPropertyCheck is {
        do "the model sends run property check"
      }
      on query NCICService.RunVehicleCheck is {
        do "the model sends run vehicle check"
      }
      on other is {
        error "Unexpected message for adaptor ToNCICService"
      }
    } with {
      briefly "to ncic service"
      described as {
        |Carries messages to the external NCICService.
      }
    }
  } with {
    briefly "NCICService integration"
    described as {
      |The model's side of the NCICService conversation.
    }
  }
  adaptor FromProsecutorService from context ProsecutorService is { 
    handler FromProsecutorServiceHandler is {
      on event ProsecutorService.CaseDeclinedNotification is {
        do "the model receives case declined notification"
      }
      on event ProsecutorService.CasePacketReceived is {
        do "the model receives case packet received"
      }
      on event ProsecutorService.ChargesFiledNotification is {
        do "the model receives charges filed notification"
      }
      on other is {
        error "Unexpected message for adaptor FromProsecutorService"
      }
    } with {
      briefly "from prosecutor service"
      described as {
        |Carries messages from the external ProsecutorService.
      }
    }
  } with {
    briefly "ProsecutorService integration"
    described as {
      |The model's side of the ProsecutorService conversation.
    }
  }
  adaptor ToProsecutorService to context ProsecutorService is { 
    handler ToProsecutorServiceHandler is {
      on command ProsecutorService.SubmitCasePacket is {
        do "the model sends submit case packet"
      }
      on other is {
        error "Unexpected message for adaptor ToProsecutorService"
      }
    } with {
      briefly "to prosecutor service"
      described as {
        |Carries messages to the external ProsecutorService.
      }
    }
  } with {
    briefly "ProsecutorService integration"
    described as {
      |The model's side of the ProsecutorService conversation.
    }
  }
  include "types.riddl"
  include "Report.riddl"
  // Repository
  type ReportRepositoryCommand is one of {
    ReportContext.ReportRepository.PersistArrestRecorded or ReportContext.ReportRepository.PersistEvidenceAdded or ReportContext.ReportRepository.PersistEvidenceCustodyUpdated or ReportContext.ReportRepository.PersistInvolvedPartyAdded or ReportContext.ReportRepository.PersistInvolvedPartyUpdated or ReportContext.ReportRepository.PersistNarrativeWritten or ReportContext.ReportRepository.PersistOffenseAdded or ReportContext.ReportRepository.PersistOffenseRemoved or ReportContext.ReportRepository.PersistPropertyAdded or ReportContext.ReportRepository.PersistReportApproved or ReportContext.ReportRepository.PersistReportCreated or ReportContext.ReportRepository.PersistReportDetailsUpdated or ReportContext.ReportRepository.PersistReportExpunged or ReportContext.ReportRepository.PersistReportLinkedToCase or ReportContext.ReportRepository.PersistReportRejected or ReportContext.ReportRepository.PersistReportSealed or ReportContext.ReportRepository.PersistReportSubmitted or ReportContext.ReportRepository.PersistVehicleAdded
  } with {
    briefly "Anything that writes ReportRepository"
    described as {
      |The persistence commands ReportRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ReportRepository as flow is {
    inlet ReportRepositoryFromCrimeStatistics is type ReportRepositoryCommand    command PersistInvolvedPartyAdded is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row InvolvedPartyAdded applies to.
        }
      }
    } with {
      briefly "Persist InvolvedPartyAdded"
      described as {
        |Instructs this repository to apply InvolvedPartyAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInvolvedPartyUpdated is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row InvolvedPartyUpdated applies to.
        }
      }
    } with {
      briefly "Persist InvolvedPartyUpdated"
      described as {
        |Instructs this repository to apply InvolvedPartyUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistNarrativeWritten is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row NarrativeWritten applies to.
        }
      }
    } with {
      briefly "Persist NarrativeWritten"
      described as {
        |Instructs this repository to apply NarrativeWritten to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOffenseRemoved is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row OffenseRemoved applies to.
        }
      }
    } with {
      briefly "Persist OffenseRemoved"
      described as {
        |Instructs this repository to apply OffenseRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPropertyAdded is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row PropertyAdded applies to.
        }
      }
    } with {
      briefly "Persist PropertyAdded"
      described as {
        |Instructs this repository to apply PropertyAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportDetailsUpdated is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportDetailsUpdated applies to.
        }
      }
    } with {
      briefly "Persist ReportDetailsUpdated"
      described as {
        |Instructs this repository to apply ReportDetailsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportExpunged is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportExpunged applies to.
        }
      }
    } with {
      briefly "Persist ReportExpunged"
      described as {
        |Instructs this repository to apply ReportExpunged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportLinkedToCase is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportLinkedToCase applies to.
        }
      }
    } with {
      briefly "Persist ReportLinkedToCase"
      described as {
        |Instructs this repository to apply ReportLinkedToCase to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportRejected is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportRejected applies to.
        }
      }
    } with {
      briefly "Persist ReportRejected"
      described as {
        |Instructs this repository to apply ReportRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportSealed is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportSealed applies to.
        }
      }
    } with {
      briefly "Persist ReportSealed"
      described as {
        |Instructs this repository to apply ReportSealed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportSubmitted is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ReportSubmitted"
      described as {
        |Instructs this repository to apply ReportSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVehicleAdded is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row VehicleAdded applies to.
        }
      }
    } with {
      briefly "Persist VehicleAdded"
      described as {
        |Instructs this repository to apply VehicleAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistArrestRecorded is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ArrestRecorded applies to.
        }
      }
    } with {
      briefly "Persist ArrestRecorded"
      described as {
        |Instructs this repository to apply ArrestRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEvidenceAdded is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row EvidenceAdded applies to.
        }
      }
    } with {
      briefly "Persist EvidenceAdded"
      described as {
        |Instructs this repository to apply EvidenceAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEvidenceCustodyUpdated is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row EvidenceCustodyUpdated applies to.
        }
      }
    } with {
      briefly "Persist EvidenceCustodyUpdated"
      described as {
        |Instructs this repository to apply EvidenceCustodyUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOffenseAdded is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row OffenseAdded applies to.
        }
      }
    } with {
      briefly "Persist OffenseAdded"
      described as {
        |Instructs this repository to apply OffenseAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportApproved is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportApproved applies to.
        }
      }
    } with {
      briefly "Persist ReportApproved"
      described as {
        |Instructs this repository to apply ReportApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportCreated is {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportCreated applies to.
        }
      }
    } with {
      briefly "Persist ReportCreated"
      described as {
        |Instructs this repository to apply ReportCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredReport is {
      reportId: ReportId with {
        briefly "reportId"
        described as {
          |The reportId column of the stored report row.
        }
      }
    } with {
      briefly "Stored report row"
      described as {
        |The persistence shape of report data as this repository stores it.
      }
    }
    schema ReportData is relational
      of reports as record StoredReport
        index on field StoredReport.reportId
 with {
      briefly "Report data schema"
      described as {
        |The relational schema persisting report records for this repository.
      }
    }
    outlet ReportRepositoryResponses is result Report.ReportQueryResult
    query FindReportById replies result ReportResult is {
      reportId: ReportId with {
        briefly "Report"
        described as {
          |Report identifier.
        }
      }
    } with {
      briefly "Find report by ID"
      described as {
        |Retrieves report by identifier.
      }
    }
    result ReportResult is {
      report: Report.ActiveStateData with {
        briefly "Report"
        described as {
          |Report data.
        }
      }
    } with {
      briefly "Report result"
      described as {
        |Returns report data.
      }
    }
    query SearchReports replies result ReportsResult is {
      filterReportType: ReportType? with {
        briefly "Type"
        described as {
          |Filter by type.
        }
      }
      filterStatus: ReportStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      officerId: OfficerId? with {
        briefly "Officer"
        described as {
          |Filter by officer.
        }
      }
      fromDate: Date? with {
        briefly "From"
        described as {
          |Start date.
        }
      }
      toDate: Date? with {
        briefly "To"
        described as {
          |End date.
        }
      }
      filterOffense: String(1,50)? with {
        briefly "Offense"
        described as {
          |Filter by offense statute.
        }
      }
    } with {
      briefly "Search reports"
      described as {
        |Searches reports by criteria.
      }
    }
    result ReportsResult is {
      reports: Report.ActiveStateData+ with {
        briefly "Reports"
        described as {
          |Matching reports.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Reports result"
      described as {
        |Returns matching reports.
      }
    }
    query FindByPerson replies result ReportsResult is {
      searchFirstName: String(1,100)? with {
        briefly "First"
        described as {
          |First name.
        }
      }
      lastName: String(1,100) with {
        briefly "Last"
        described as {
          |Last name.
        }
      }
      searchDateOfBirth: Date? with {
        briefly "DOB"
        described as {
          |Date of birth.
        }
      }
    } with {
      briefly "Find by person"
      described as {
        |Finds reports involving a person.
      }
    }
    query FindByAddress replies result ReportsResult is {
      street: String(1,200) with {
        briefly "Street"
        described as {
          |Street address.
        }
      }
      city: String(1,100)? with {
        briefly "City"
        described as {
          |City.
        }
      }
    } with {
      briefly "Find by address"
      described as {
        |Finds reports at a location.
      }
    }
    query FindByVehicle replies result ReportsResult is {
      searchLicensePlate: String(1,20)? with {
        briefly "Plate"
        described as {
          |License plate.
        }
      }
      vin: String(17,17)? with {
        briefly "VIN"
        described as {
          |Vehicle identification number.
        }
      }
    } with {
      briefly "Find by vehicle"
      described as {
        |Finds reports involving a vehicle.
      }
    }
    query FindPendingApproval replies result ReportsResult is {
      supervisorId: OfficerId with {
        briefly "Supervisor"
        described as {
          |Supervisor identifier.
        }
      }
    } with {
      briefly "Find pending approval"
      described as {
        |Finds reports awaiting approval.
      }
    }
    handler ReportRepositoryHandler is {
      on persistInvolvedPartyAdded: command PersistInvolvedPartyAdded is {
        do "apply InvolvedPartyAdded to the stored row"
      }
      on persistInvolvedPartyUpdated: command PersistInvolvedPartyUpdated is {
        do "apply InvolvedPartyUpdated to the stored row"
      }
      on persistNarrativeWritten: command PersistNarrativeWritten is {
        do "apply NarrativeWritten to the stored row"
      }
      on persistOffenseRemoved: command PersistOffenseRemoved is {
        do "apply OffenseRemoved to the stored row"
      }
      on persistPropertyAdded: command PersistPropertyAdded is {
        do "apply PropertyAdded to the stored row"
      }
      on persistReportDetailsUpdated: command PersistReportDetailsUpdated is {
        do "apply ReportDetailsUpdated to the stored row"
      }
      on persistReportExpunged: command PersistReportExpunged is {
        do "apply ReportExpunged to the stored row"
      }
      on persistReportLinkedToCase: command PersistReportLinkedToCase is {
        do "apply ReportLinkedToCase to the stored row"
      }
      on persistReportRejected: command PersistReportRejected is {
        do "apply ReportRejected to the stored row"
      }
      on persistReportSealed: command PersistReportSealed is {
        do "apply ReportSealed to the stored row"
      }
      on persistReportSubmitted: command PersistReportSubmitted is {
        do "apply ReportSubmitted to the stored row"
      }
      on persistVehicleAdded: command PersistVehicleAdded is {
        do "apply VehicleAdded to the stored row"
      }
      on persistArrestRecorded: command PersistArrestRecorded is {
        do "apply ArrestRecorded to the stored row"
      }
      on persistEvidenceAdded: command PersistEvidenceAdded is {
        do "apply EvidenceAdded to the stored row"
      }
      on persistEvidenceCustodyUpdated: command PersistEvidenceCustodyUpdated is {
        do "apply EvidenceCustodyUpdated to the stored row"
      }
      on persistOffenseAdded: command PersistOffenseAdded is {
        do "apply OffenseAdded to the stored row"
      }
      on persistReportApproved: command PersistReportApproved is {
        do "apply ReportApproved to the stored row"
      }
      on persistReportCreated: command PersistReportCreated is {
        do "apply ReportCreated to the stored row"
      }
      on query GetStatisticsData is {
        let statisticsDataView: type StatisticsDataView = prompt("read the statistics data projection")
        reply statisticsDataView
      }
      on query GetInventoryData is {
        let inventoryDataView: type InventoryDataView = prompt("read the inventory data projection")
        reply inventoryDataView
      }
      on query FindReportById is {
        let reportResult: type ReportResult = prompt("read the report from the store")
        reply reportResult
      }
      on query SearchReports is {
        let reportsResult: type ReportsResult = prompt("read the reports from the store")
        reply reportsResult
      }
      on query FindByPerson is {
        let reportsResult: type ReportsResult = prompt("read the reports that by person asks for")
        reply reportsResult
      }
      on query FindByAddress is {
        let reportsResult: type ReportsResult = prompt("read the reports that by address asks for")
        reply reportsResult
      }
      on query FindByVehicle is {
        let reportsResult: type ReportsResult = prompt("read the reports that by vehicle asks for")
        reply reportsResult
      }
      on query FindPendingApproval is {
        let reportsResult: type ReportsResult = prompt("read the reports that pending approval asks for")
        reply reportsResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes report queries.
      }
    }
  } with {
    briefly "Report repository"
    described as {
      |Persistence for report records.
    }
  }
  // Projector for crime statistics
  query GetStatisticsData replies result StatisticsDataView is {
    statisticsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which statistics data to retrieve.
      }
    }
  } with {
    briefly "Get statistics data"
    described as {
      |Retrieves the statistics data projection.
    }
  }
  result StatisticsDataView is {
    statisticsData: CrimeStatistics.StatisticsData with {
      briefly "Statistics data"
      described as {
        |The statistics data being returned.
      }
    }
  } with {
    briefly "Statistics data view"
    described as {
      |Read model view carrying the statistics data projection.
    }
  }
  projector CrimeStatistics as flow is {
    updates repository ReportContext.ReportRepository
    outlet CrimeStatisticsToRepository is type ReportRepositoryCommand
    inlet CrimeStatisticsFromReport is type ReportEvent    record StatisticsData is {
      reportsByType: TypeCount+ with {
        briefly "By type"
        described as {
          |Reports by type.
        }
      }
      reportsByOffense: OffenseCount+ with {
        briefly "By offense"
        described as {
          |Reports by offense.
        }
      }
      reportsByBeat: BeatCount+ with {
        briefly "By beat"
        described as {
          |Reports by patrol beat.
        }
      }
      arrestCount: Natural with {
        briefly "Arrests"
        described as {
          |Total arrests.
        }
      }
      clearanceRate: Decimal(5,2) with {
        briefly "Clearance"
        described as {
          |Case clearance rate.
        }
      }
      monthlyTrend: MonthlyCount+ with {
        briefly "Monthly"
        described as {
          |Monthly incident counts.
        }
      }
    } with {
      briefly "Statistics data"
      described as {
        |Crime statistics metrics.
      }
    }
    record TypeCount is {
      reportType: ReportType with {
        briefly "Type"
        described as {
          |Report type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Report count.
        }
      }
    } with {
      briefly "Type count"
      described as {
        |Count by report type.
      }
    }
    record OffenseCount is {
      statute: String(1,50) with {
        briefly "Statute"
        described as {
          |Offense statute.
        }
      }
      description: String(1,200) with {
        briefly "Description"
        described as {
          |Offense description.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Offense count.
        }
      }
    } with {
      briefly "Offense count"
      described as {
        |Count by offense.
      }
    }
    record BeatCount is {
      beat: String(1,20) with {
        briefly "Beat"
        described as {
          |Patrol beat.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Incident count.
        }
      }
    } with {
      briefly "Beat count"
      described as {
        |Count by patrol beat.
      }
    }
    record MonthlyCount is {
      month: Date with {
        briefly "Month"
        described as {
          |Month.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Incident count.
        }
      }
    } with {
      briefly "Monthly count"
      described as {
        |Monthly incident count.
      }
    }
    handler StatisticsHandler is {
      on evidenceAdded: event Report.EvidenceAdded is {
        tell command ReportContext.ReportRepository.PersistEvidenceAdded(reportId = evidenceAdded.reportId) to repository ReportContext.ReportRepository
        do "apply EvidenceAdded to the CrimeStatistics projection"
      }
      on evidenceCustodyUpdated: event Report.EvidenceCustodyUpdated is {
        tell command ReportContext.ReportRepository.PersistEvidenceCustodyUpdated(reportId = evidenceCustodyUpdated.reportId) to repository ReportContext.ReportRepository
        do "apply EvidenceCustodyUpdated to the CrimeStatistics projection"
      }
      on involvedPartyAdded: event Report.InvolvedPartyAdded is {
        tell command ReportContext.ReportRepository.PersistInvolvedPartyAdded(reportId = involvedPartyAdded.reportId) to repository ReportContext.ReportRepository
        do "apply InvolvedPartyAdded to the CrimeStatistics projection"
      }
      on involvedPartyUpdated: event Report.InvolvedPartyUpdated is {
        tell command ReportContext.ReportRepository.PersistInvolvedPartyUpdated(reportId = involvedPartyUpdated.reportId) to repository ReportContext.ReportRepository
        do "apply InvolvedPartyUpdated to the CrimeStatistics projection"
      }
      on narrativeWritten: event Report.NarrativeWritten is {
        tell command ReportContext.ReportRepository.PersistNarrativeWritten(reportId = narrativeWritten.reportId) to repository ReportContext.ReportRepository
        do "apply NarrativeWritten to the CrimeStatistics projection"
      }
      on offenseRemoved: event Report.OffenseRemoved is {
        tell command ReportContext.ReportRepository.PersistOffenseRemoved(reportId = offenseRemoved.reportId) to repository ReportContext.ReportRepository
        do "apply OffenseRemoved to the CrimeStatistics projection"
      }
      on propertyAdded: event Report.PropertyAdded is {
        tell command ReportContext.ReportRepository.PersistPropertyAdded(reportId = propertyAdded.reportId) to repository ReportContext.ReportRepository
        do "apply PropertyAdded to the CrimeStatistics projection"
      }
      on reportDetailsUpdated: event Report.ReportDetailsUpdated is {
        tell command ReportContext.ReportRepository.PersistReportDetailsUpdated(reportId = reportDetailsUpdated.reportId) to repository ReportContext.ReportRepository
        do "apply ReportDetailsUpdated to the CrimeStatistics projection"
      }
      on reportExpunged: event Report.ReportExpunged is {
        tell command ReportContext.ReportRepository.PersistReportExpunged(reportId = reportExpunged.reportId) to repository ReportContext.ReportRepository
        do "apply ReportExpunged to the CrimeStatistics projection"
      }
      on reportLinkedToCase: event Report.ReportLinkedToCase is {
        tell command ReportContext.ReportRepository.PersistReportLinkedToCase(reportId = reportLinkedToCase.reportId) to repository ReportContext.ReportRepository
        do "apply ReportLinkedToCase to the CrimeStatistics projection"
      }
      on reportRejected: event Report.ReportRejected is {
        tell command ReportContext.ReportRepository.PersistReportRejected(reportId = reportRejected.reportId) to repository ReportContext.ReportRepository
        do "apply ReportRejected to the CrimeStatistics projection"
      }
      on reportSealed: event Report.ReportSealed is {
        tell command ReportContext.ReportRepository.PersistReportSealed(reportId = reportSealed.reportId) to repository ReportContext.ReportRepository
        do "apply ReportSealed to the CrimeStatistics projection"
      }
      on reportSubmitted: event Report.ReportSubmitted is {
        tell command ReportContext.ReportRepository.PersistReportSubmitted(reportId = reportSubmitted.reportId) to repository ReportContext.ReportRepository
        do "apply ReportSubmitted to the CrimeStatistics projection"
      }
      on vehicleAdded: event Report.VehicleAdded is {
        tell command ReportContext.ReportRepository.PersistVehicleAdded(reportId = vehicleAdded.reportId) to repository ReportContext.ReportRepository
        do "apply VehicleAdded to the CrimeStatistics projection"
      }
      on reportCreated: event Report.ReportCreated is {
        tell command ReportContext.ReportRepository.PersistReportCreated(reportId = reportCreated.reportId) to repository ReportContext.ReportRepository
      }
      on offenseAdded: event Report.OffenseAdded is {
        tell command ReportContext.ReportRepository.PersistOffenseAdded(reportId = offenseAdded.reportId) to repository ReportContext.ReportRepository
      }
      on arrestRecorded: event Report.ArrestRecorded is {
        tell command ReportContext.ReportRepository.PersistArrestRecorded(reportId = arrestRecorded.reportId) to repository ReportContext.ReportRepository
      }
      on reportApproved: event Report.ReportApproved is {
        tell command ReportContext.ReportRepository.PersistReportApproved(reportId = reportApproved.reportId) to repository ReportContext.ReportRepository
      }
    } with {
      briefly "Processes statistics events"
      described as {
        |Updates crime statistics from events.
      }
    }
  } with {
    briefly "Crime statistics"
    described as {
      |Projects crime statistics for analysis.
    }
  }
  // Projector for evidence tracking
  query GetInventoryData replies result InventoryDataView is {
    inventoryDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which inventory data to retrieve.
      }
    }
  } with {
    briefly "Get inventory data"
    described as {
      |Retrieves the inventory data projection.
    }
  }
  result InventoryDataView is {
    inventoryData: EvidenceInventory.InventoryData with {
      briefly "Inventory data"
      described as {
        |The inventory data being returned.
      }
    }
  } with {
    briefly "Inventory data view"
    described as {
      |Read model view carrying the inventory data projection.
    }
  }
  projector EvidenceInventory as sink is {
    updates repository ReportContext.ReportRepository
    inlet EvidenceInventoryFromReport is type ReportEvent    record InventoryData is {
      totalItems: Natural with {
        briefly "Total"
        described as {
          |Total evidence items.
        }
      }
      itemsByType: EvidenceTypeCount+ with {
        briefly "By type"
        described as {
          |Items by type.
        }
      }
      pendingDisposition: Natural with {
        briefly "Pending"
        described as {
          |Awaiting disposition.
        }
      }
      recentTransfers: CustodyTransfer+ with {
        briefly "Transfers"
        described as {
          |Recent custody transfers.
        }
      }
    } with {
      briefly "Inventory data"
      described as {
        |Evidence inventory status.
      }
    }
    record EvidenceTypeCount is {
      evidenceType: String(1,50) with {
        briefly "Type"
        described as {
          |Evidence type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Item count.
        }
      }
    } with {
      briefly "Evidence type count"
      described as {
        |Count by evidence type.
      }
    }
    record CustodyTransfer is {
      evidenceId: EvidenceId with {
        briefly "Evidence"
        described as {
          |Evidence ID.
        }
      }
      reportId: ReportId with {
        briefly "Report"
        described as {
          |Associated report.
        }
      }
      transferredAt: TimeStamp with {
        briefly "Transferred"
        described as {
          |Transfer time.
        }
      }
    } with {
      briefly "Custody transfer"
      described as {
        |Recent custody transfer.
      }
    }
    handler InventoryHandler is {
      on arrestRecorded: event Report.ArrestRecorded is {
        tell command ReportContext.ReportRepository.PersistArrestRecorded(reportId = arrestRecorded.reportId) to repository ReportContext.ReportRepository
        do "apply ArrestRecorded to the EvidenceInventory projection"
      }
      on involvedPartyAdded: event Report.InvolvedPartyAdded is {
        tell command ReportContext.ReportRepository.PersistInvolvedPartyAdded(reportId = involvedPartyAdded.reportId) to repository ReportContext.ReportRepository
        do "apply InvolvedPartyAdded to the EvidenceInventory projection"
      }
      on involvedPartyUpdated: event Report.InvolvedPartyUpdated is {
        tell command ReportContext.ReportRepository.PersistInvolvedPartyUpdated(reportId = involvedPartyUpdated.reportId) to repository ReportContext.ReportRepository
        do "apply InvolvedPartyUpdated to the EvidenceInventory projection"
      }
      on narrativeWritten: event Report.NarrativeWritten is {
        tell command ReportContext.ReportRepository.PersistNarrativeWritten(reportId = narrativeWritten.reportId) to repository ReportContext.ReportRepository
        do "apply NarrativeWritten to the EvidenceInventory projection"
      }
      on offenseAdded: event Report.OffenseAdded is {
        tell command ReportContext.ReportRepository.PersistOffenseAdded(reportId = offenseAdded.reportId) to repository ReportContext.ReportRepository
        do "apply OffenseAdded to the EvidenceInventory projection"
      }
      on offenseRemoved: event Report.OffenseRemoved is {
        tell command ReportContext.ReportRepository.PersistOffenseRemoved(reportId = offenseRemoved.reportId) to repository ReportContext.ReportRepository
        do "apply OffenseRemoved to the EvidenceInventory projection"
      }
      on propertyAdded: event Report.PropertyAdded is {
        tell command ReportContext.ReportRepository.PersistPropertyAdded(reportId = propertyAdded.reportId) to repository ReportContext.ReportRepository
        do "apply PropertyAdded to the EvidenceInventory projection"
      }
      on reportApproved: event Report.ReportApproved is {
        tell command ReportContext.ReportRepository.PersistReportApproved(reportId = reportApproved.reportId) to repository ReportContext.ReportRepository
        do "apply ReportApproved to the EvidenceInventory projection"
      }
      on reportCreated: event Report.ReportCreated is {
        tell command ReportContext.ReportRepository.PersistReportCreated(reportId = reportCreated.reportId) to repository ReportContext.ReportRepository
        do "apply ReportCreated to the EvidenceInventory projection"
      }
      on reportDetailsUpdated: event Report.ReportDetailsUpdated is {
        tell command ReportContext.ReportRepository.PersistReportDetailsUpdated(reportId = reportDetailsUpdated.reportId) to repository ReportContext.ReportRepository
        do "apply ReportDetailsUpdated to the EvidenceInventory projection"
      }
      on reportExpunged: event Report.ReportExpunged is {
        tell command ReportContext.ReportRepository.PersistReportExpunged(reportId = reportExpunged.reportId) to repository ReportContext.ReportRepository
        do "apply ReportExpunged to the EvidenceInventory projection"
      }
      on reportLinkedToCase: event Report.ReportLinkedToCase is {
        tell command ReportContext.ReportRepository.PersistReportLinkedToCase(reportId = reportLinkedToCase.reportId) to repository ReportContext.ReportRepository
        do "apply ReportLinkedToCase to the EvidenceInventory projection"
      }
      on reportRejected: event Report.ReportRejected is {
        tell command ReportContext.ReportRepository.PersistReportRejected(reportId = reportRejected.reportId) to repository ReportContext.ReportRepository
        do "apply ReportRejected to the EvidenceInventory projection"
      }
      on reportSealed: event Report.ReportSealed is {
        tell command ReportContext.ReportRepository.PersistReportSealed(reportId = reportSealed.reportId) to repository ReportContext.ReportRepository
        do "apply ReportSealed to the EvidenceInventory projection"
      }
      on reportSubmitted: event Report.ReportSubmitted is {
        tell command ReportContext.ReportRepository.PersistReportSubmitted(reportId = reportSubmitted.reportId) to repository ReportContext.ReportRepository
        do "apply ReportSubmitted to the EvidenceInventory projection"
      }
      on vehicleAdded: event Report.VehicleAdded is {
        tell command ReportContext.ReportRepository.PersistVehicleAdded(reportId = vehicleAdded.reportId) to repository ReportContext.ReportRepository
        do "apply VehicleAdded to the EvidenceInventory projection"
      }
      on evidenceAdded: event Report.EvidenceAdded is {
        tell command ReportContext.ReportRepository.PersistEvidenceAdded(reportId = evidenceAdded.reportId) to repository ReportContext.ReportRepository
      }
      on evidenceCustodyUpdated: event Report.EvidenceCustodyUpdated is {
        tell command ReportContext.ReportRepository.PersistEvidenceCustodyUpdated(reportId = evidenceCustodyUpdated.reportId) to repository ReportContext.ReportRepository
      }
    } with {
      briefly "Processes inventory events"
      described as {
        |Updates evidence inventory from events.
      }
    }
  } with {
    briefly "Evidence inventory"
    described as {
      |Projects evidence tracking data.
    }
  }
  // ---- Event publication for Report ----
  type ReportEvent is one of {
    ReportContext.Report.ReportCreated or ReportContext.Report.ReportDetailsUpdated or ReportContext.Report.OffenseAdded or ReportContext.Report.OffenseRemoved or ReportContext.Report.InvolvedPartyAdded or ReportContext.Report.InvolvedPartyUpdated or ReportContext.Report.VehicleAdded or ReportContext.Report.PropertyAdded or ReportContext.Report.EvidenceAdded or ReportContext.Report.EvidenceCustodyUpdated or ReportContext.Report.ArrestRecorded or ReportContext.Report.NarrativeWritten or ReportContext.Report.ReportSubmitted or ReportContext.Report.ReportApproved or ReportContext.Report.ReportRejected or ReportContext.Report.ReportLinkedToCase or ReportContext.Report.ReportSealed or ReportContext.Report.ReportExpunged
  } with {
    briefly "Report event alternation"
    described as {
      |Union of all Report events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet ReportEventSplit as split is {
    inlet ReportEventSplitIn is type ReportEvent    outlet ReportEventSplitToCrimeStatistics is type ReportEvent
    outlet ReportEventSplitToEvidenceInventory is type ReportEvent
    handler ReportEventSplitHandler is {
      on reportCreated: event Report.ReportCreated is {
        send reportCreated to outlet ReportEventSplitToCrimeStatistics
        send reportCreated to outlet ReportEventSplitToEvidenceInventory
        tell reportCreated to entity ReportContext.Report
      }
      on reportDetailsUpdated: event Report.ReportDetailsUpdated is {
        send reportDetailsUpdated to outlet ReportEventSplitToCrimeStatistics
        send reportDetailsUpdated to outlet ReportEventSplitToEvidenceInventory
        tell reportDetailsUpdated to entity ReportContext.Report
      }
      on offenseAdded: event Report.OffenseAdded is {
        send offenseAdded to outlet ReportEventSplitToCrimeStatistics
        send offenseAdded to outlet ReportEventSplitToEvidenceInventory
        tell offenseAdded to entity ReportContext.Report
      }
      on offenseRemoved: event Report.OffenseRemoved is {
        send offenseRemoved to outlet ReportEventSplitToCrimeStatistics
        send offenseRemoved to outlet ReportEventSplitToEvidenceInventory
        tell offenseRemoved to entity ReportContext.Report
      }
      on involvedPartyAdded: event Report.InvolvedPartyAdded is {
        send involvedPartyAdded to outlet ReportEventSplitToCrimeStatistics
        send involvedPartyAdded to outlet ReportEventSplitToEvidenceInventory
        tell involvedPartyAdded to entity ReportContext.Report
      }
      on involvedPartyUpdated: event Report.InvolvedPartyUpdated is {
        send involvedPartyUpdated to outlet ReportEventSplitToCrimeStatistics
        send involvedPartyUpdated to outlet ReportEventSplitToEvidenceInventory
        tell involvedPartyUpdated to entity ReportContext.Report
      }
      on vehicleAdded: event Report.VehicleAdded is {
        send vehicleAdded to outlet ReportEventSplitToCrimeStatistics
        send vehicleAdded to outlet ReportEventSplitToEvidenceInventory
        tell vehicleAdded to entity ReportContext.Report
      }
      on propertyAdded: event Report.PropertyAdded is {
        send propertyAdded to outlet ReportEventSplitToCrimeStatistics
        send propertyAdded to outlet ReportEventSplitToEvidenceInventory
        tell propertyAdded to entity ReportContext.Report
      }
      on evidenceAdded: event Report.EvidenceAdded is {
        send evidenceAdded to outlet ReportEventSplitToCrimeStatistics
        send evidenceAdded to outlet ReportEventSplitToEvidenceInventory
        tell evidenceAdded to entity ReportContext.Report
      }
      on evidenceCustodyUpdated: event Report.EvidenceCustodyUpdated is {
        send evidenceCustodyUpdated to outlet ReportEventSplitToCrimeStatistics
        send evidenceCustodyUpdated to outlet ReportEventSplitToEvidenceInventory
        tell evidenceCustodyUpdated to entity ReportContext.Report
      }
      on arrestRecorded: event Report.ArrestRecorded is {
        send arrestRecorded to outlet ReportEventSplitToCrimeStatistics
        send arrestRecorded to outlet ReportEventSplitToEvidenceInventory
        tell arrestRecorded to entity ReportContext.Report
      }
      on narrativeWritten: event Report.NarrativeWritten is {
        send narrativeWritten to outlet ReportEventSplitToCrimeStatistics
        send narrativeWritten to outlet ReportEventSplitToEvidenceInventory
        tell narrativeWritten to entity ReportContext.Report
      }
      on reportSubmitted: event Report.ReportSubmitted is {
        send reportSubmitted to outlet ReportEventSplitToCrimeStatistics
        send reportSubmitted to outlet ReportEventSplitToEvidenceInventory
        tell reportSubmitted to entity ReportContext.Report
      }
      on reportApproved: event Report.ReportApproved is {
        send reportApproved to outlet ReportEventSplitToCrimeStatistics
        send reportApproved to outlet ReportEventSplitToEvidenceInventory
        tell reportApproved to entity ReportContext.Report
      }
      on reportRejected: event Report.ReportRejected is {
        send reportRejected to outlet ReportEventSplitToCrimeStatistics
        send reportRejected to outlet ReportEventSplitToEvidenceInventory
        tell reportRejected to entity ReportContext.Report
      }
      on reportLinkedToCase: event Report.ReportLinkedToCase is {
        send reportLinkedToCase to outlet ReportEventSplitToCrimeStatistics
        send reportLinkedToCase to outlet ReportEventSplitToEvidenceInventory
        tell reportLinkedToCase to entity ReportContext.Report
      }
      on reportSealed: event Report.ReportSealed is {
        send reportSealed to outlet ReportEventSplitToCrimeStatistics
        send reportSealed to outlet ReportEventSplitToEvidenceInventory
        tell reportSealed to entity ReportContext.Report
      }
      on reportExpunged: event Report.ReportExpunged is {
        send reportExpunged to outlet ReportEventSplitToCrimeStatistics
        send reportExpunged to outlet ReportEventSplitToEvidenceInventory
        tell reportExpunged to entity ReportContext.Report
      }
      on other is {
        error "Unexpected message for processor ReportEventSplit"
      }
    } with {
      briefly "Report event fan-out handler"
      described as {
        |Delivers each Report event to all of its consumers.
      }
    }
  } with {
    briefly "Report event fan-out"
    described as {
      |Fans Report events out to the repository and projectors.
    }
  }
  connector 'ReportEvent Stream' is from outlet ReportContext.Report.ReportEvents2 to inlet ReportContext.ReportEventSplit.ReportEventSplitIn with {
    briefly "Report events, fanned out to storage and read models"
  }
  connector 'CrimeStatistics Feed' is from outlet ReportContext.ReportEventSplit.ReportEventSplitToCrimeStatistics to inlet ReportContext.CrimeStatistics.CrimeStatisticsFromReport with {
    briefly "Report events feeding the CrimeStatistics projection"
  }
  connector 'EvidenceInventory Feed' is from outlet ReportContext.ReportEventSplit.ReportEventSplitToEvidenceInventory to inlet ReportContext.EvidenceInventory.EvidenceInventoryFromReport with {
    briefly "Report events feeding the EvidenceInventory projection"
  }
  connector 'CrimeStatistics Storage' is from outlet ReportContext.CrimeStatistics.CrimeStatisticsToRepository to inlet ReportContext.ReportRepository.ReportRepositoryFromCrimeStatistics with {
    briefly "CrimeStatistics updates on their way to storage"
  }
} with {
  briefly "Report context"
  described as {
    | The Report context manages police reports
    | and documentation.
  }
}
