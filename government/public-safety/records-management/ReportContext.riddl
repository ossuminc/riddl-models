// Records Management - Report Context
context ReportContext is {
  include "types.riddl"
  include "Report.riddl"
  // Repository
  repository ReportRepository is {
    query FindReportById is  {
      reportId: ReportId with {
        briefly "Report"
        described as {
          |Report identifier.
        }
      }
    } with {
      briefly "Find report by ID"
      described as {
        |Retrieves report by identifier.
      }
    }
    result ReportResult is  {
      report: Report.ActiveStateData with {
        briefly "Report"
        described as {
          |Report data.
        }
      }
    } with {
      briefly "Report result"
      described as {
        |Returns report data.
      }
    }
    query SearchReports is  {
      filterReportType: ReportType? with {
        briefly "Type"
        described as {
          |Filter by type.
        }
      }
      filterStatus: ReportStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      officerId: OfficerId? with {
        briefly "Officer"
        described as {
          |Filter by officer.
        }
      }
      fromDate: Date? with {
        briefly "From"
        described as {
          |Start date.
        }
      }
      toDate: Date? with {
        briefly "To"
        described as {
          |End date.
        }
      }
      filterOffense: String(1,50)? with {
        briefly "Offense"
        described as {
          |Filter by offense statute.
        }
      }
    } with {
      briefly "Search reports"
      described as {
        |Searches reports by criteria.
      }
    }
    result ReportsResult is  {
      reports: Report.ActiveStateData+ with {
        briefly "Reports"
        described as {
          |Matching reports.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Reports result"
      described as {
        |Returns matching reports.
      }
    }
    query FindByPerson is  {
      searchFirstName: String(1,100)? with {
        briefly "First"
        described as {
          |First name.
        }
      }
      lastName: String(1,100) with {
        briefly "Last"
        described as {
          |Last name.
        }
      }
      searchDateOfBirth: Date? with {
        briefly "DOB"
        described as {
          |Date of birth.
        }
      }
    } with {
      briefly "Find by person"
      described as {
        |Finds reports involving a person.
      }
    }
    query FindByAddress is  {
      street: String(1,200) with {
        briefly "Street"
        described as {
          |Street address.
        }
      }
      city: String(1,100)? with {
        briefly "City"
        described as {
          |City.
        }
      }
    } with {
      briefly "Find by address"
      described as {
        |Finds reports at a location.
      }
    }
    query FindByVehicle is  {
      searchLicensePlate: String(1,20)? with {
        briefly "Plate"
        described as {
          |License plate.
        }
      }
      vin: String(17,17)? with {
        briefly "VIN"
        described as {
          |Vehicle identification number.
        }
      }
    } with {
      briefly "Find by vehicle"
      described as {
        |Finds reports involving a vehicle.
      }
    }
    query FindPendingApproval is  {
      supervisorId: OfficerId with {
        briefly "Supervisor"
        described as {
          |Supervisor identifier.
        }
      }
    } with {
      briefly "Find pending approval"
      described as {
        |Finds reports awaiting approval.
      }
    }
    handler ReportRepositoryHandler is {
      on query FindReportById is {
        reply result ReportResult
      }
      on query SearchReports is {
        reply result ReportResult
      }
      on query FindByPerson is {
        reply result ReportResult
      }
      on query FindByAddress is {
        reply result ReportResult
      }
      on query FindByVehicle is {
        reply result ReportResult
      }
      on query FindPendingApproval is {
        reply result ReportResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes report queries.
      }
    }
  } with {
    briefly "Report repository"
    described as {
      |Persistence for report records.
    }
  }
  // Projector for crime statistics
  projector CrimeStatistics is {
    updates repository ReportContext.ReportRepository
    record StatisticsData is  {
      reportsByType: TypeCount+ with {
        briefly "By type"
        described as {
          |Reports by type.
        }
      }
      reportsByOffense: OffenseCount+ with {
        briefly "By offense"
        described as {
          |Reports by offense.
        }
      }
      reportsByBeat: BeatCount+ with {
        briefly "By beat"
        described as {
          |Reports by patrol beat.
        }
      }
      arrestCount: Natural with {
        briefly "Arrests"
        described as {
          |Total arrests.
        }
      }
      clearanceRate: Decimal(5,2) with {
        briefly "Clearance"
        described as {
          |Case clearance rate.
        }
      }
      monthlyTrend: MonthlyCount+ with {
        briefly "Monthly"
        described as {
          |Monthly incident counts.
        }
      }
    } with {
      briefly "Statistics data"
      described as {
        |Crime statistics metrics.
      }
    }
    record TypeCount is  {
      reportType: ReportType with {
        briefly "Type"
        described as {
          |Report type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Report count.
        }
      }
    } with {
      briefly "Type count"
      described as {
        |Count by report type.
      }
    }
    record OffenseCount is  {
      statute: String(1,50) with {
        briefly "Statute"
        described as {
          |Offense statute.
        }
      }
      description: String(1,200) with {
        briefly "Description"
        described as {
          |Offense description.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Offense count.
        }
      }
    } with {
      briefly "Offense count"
      described as {
        |Count by offense.
      }
    }
    record BeatCount is  {
      beat: String(1,20) with {
        briefly "Beat"
        described as {
          |Patrol beat.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Incident count.
        }
      }
    } with {
      briefly "Beat count"
      described as {
        |Count by patrol beat.
      }
    }
    record MonthlyCount is  {
      month: Date with {
        briefly "Month"
        described as {
          |Month.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Incident count.
        }
      }
    } with {
      briefly "Monthly count"
      described as {
        |Monthly incident count.
      }
    }
    handler StatisticsHandler is {
      on event Report.ReportCreated is {
        tell event Report.ReportCreated to repository ReportContext.ReportRepository
      }
      on event Report.OffenseAdded is {
        tell event Report.OffenseAdded to repository ReportContext.ReportRepository
      }
      on event Report.ArrestRecorded is {
        tell event Report.ArrestRecorded to repository ReportContext.ReportRepository
      }
      on event Report.ReportApproved is {
        tell event Report.ReportApproved to repository ReportContext.ReportRepository
      }
    } with {
      briefly "Processes statistics events"
      described as {
        |Updates crime statistics from events.
      }
    }
  } with {
    briefly "Crime statistics"
    described as {
      |Projects crime statistics for analysis.
    }
  }
  // Projector for evidence tracking
  projector EvidenceInventory is {
    updates repository ReportContext.ReportRepository
    record InventoryData is  {
      totalItems: Natural with {
        briefly "Total"
        described as {
          |Total evidence items.
        }
      }
      itemsByType: EvidenceTypeCount+ with {
        briefly "By type"
        described as {
          |Items by type.
        }
      }
      pendingDisposition: Natural with {
        briefly "Pending"
        described as {
          |Awaiting disposition.
        }
      }
      recentTransfers: CustodyTransfer+ with {
        briefly "Transfers"
        described as {
          |Recent custody transfers.
        }
      }
    } with {
      briefly "Inventory data"
      described as {
        |Evidence inventory status.
      }
    }
    record EvidenceTypeCount is  {
      evidenceType: String(1,50) with {
        briefly "Type"
        described as {
          |Evidence type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Item count.
        }
      }
    } with {
      briefly "Evidence type count"
      described as {
        |Count by evidence type.
      }
    }
    record CustodyTransfer is  {
      evidenceId: EvidenceId with {
        briefly "Evidence"
        described as {
          |Evidence ID.
        }
      }
      reportId: ReportId with {
        briefly "Report"
        described as {
          |Associated report.
        }
      }
      transferredAt: TimeStamp with {
        briefly "Transferred"
        described as {
          |Transfer time.
        }
      }
    } with {
      briefly "Custody transfer"
      described as {
        |Recent custody transfer.
      }
    }
    handler InventoryHandler is {
      on event Report.EvidenceAdded is {
        tell event Report.EvidenceAdded to repository ReportContext.ReportRepository
      }
      on event Report.EvidenceCustodyUpdated is {
        tell event Report.EvidenceCustodyUpdated to repository ReportContext.ReportRepository
      }
    } with {
      briefly "Processes inventory events"
      described as {
        |Updates evidence inventory from events.
      }
    }
  } with {
    briefly "Evidence inventory"
    described as {
      |Projects evidence tracking data.
    }
  }
  // ---- Event publication for Report ----
  type ReportEvent is one of {
    ReportContext.Report.ReportCreated,
    ReportContext.Report.ReportDetailsUpdated,
    ReportContext.Report.OffenseAdded,
    ReportContext.Report.OffenseRemoved,
    ReportContext.Report.InvolvedPartyAdded,
    ReportContext.Report.InvolvedPartyUpdated,
    ReportContext.Report.VehicleAdded,
    ReportContext.Report.PropertyAdded,
    ReportContext.Report.EvidenceAdded,
    ReportContext.Report.EvidenceCustodyUpdated,
    ReportContext.Report.ArrestRecorded,
    ReportContext.Report.NarrativeWritten,
    ReportContext.Report.ReportSubmitted,
    ReportContext.Report.ReportApproved,
    ReportContext.Report.ReportRejected,
    ReportContext.Report.ReportLinkedToCase,
    ReportContext.Report.ReportSealed,
    ReportContext.Report.ReportExpunged
  } with {
    briefly "Report event alternation"
    described as {
      |Union of all Report events, for streaming and event-sourced
      |persistence.
    }
  }
  source ReportEventSource is {
    outlet ReportEvents is type ReportEvent
    handler ReportSourceHandler is {
      on event Report.ReportCreated is {
        send event Report.ReportCreated to outlet ReportEvents
      }
      on event Report.ReportDetailsUpdated is {
        send event Report.ReportDetailsUpdated to outlet ReportEvents
      }
      on event Report.OffenseAdded is {
        send event Report.OffenseAdded to outlet ReportEvents
      }
      on event Report.OffenseRemoved is {
        send event Report.OffenseRemoved to outlet ReportEvents
      }
      on event Report.InvolvedPartyAdded is {
        send event Report.InvolvedPartyAdded to outlet ReportEvents
      }
      on event Report.InvolvedPartyUpdated is {
        send event Report.InvolvedPartyUpdated to outlet ReportEvents
      }
      on event Report.VehicleAdded is {
        send event Report.VehicleAdded to outlet ReportEvents
      }
      on event Report.PropertyAdded is {
        send event Report.PropertyAdded to outlet ReportEvents
      }
      on event Report.EvidenceAdded is {
        send event Report.EvidenceAdded to outlet ReportEvents
      }
      on event Report.EvidenceCustodyUpdated is {
        send event Report.EvidenceCustodyUpdated to outlet ReportEvents
      }
      on event Report.ArrestRecorded is {
        send event Report.ArrestRecorded to outlet ReportEvents
      }
      on event Report.NarrativeWritten is {
        send event Report.NarrativeWritten to outlet ReportEvents
      }
      on event Report.ReportSubmitted is {
        send event Report.ReportSubmitted to outlet ReportEvents
      }
      on event Report.ReportApproved is {
        send event Report.ReportApproved to outlet ReportEvents
      }
      on event Report.ReportRejected is {
        send event Report.ReportRejected to outlet ReportEvents
      }
      on event Report.ReportLinkedToCase is {
        send event Report.ReportLinkedToCase to outlet ReportEvents
      }
      on event Report.ReportSealed is {
        send event Report.ReportSealed to outlet ReportEvents
      }
      on event Report.ReportExpunged is {
        send event Report.ReportExpunged to outlet ReportEvents
      }
      on other is {
        error "Unexpected message for source ReportEventSource"
      }
    } with {
      briefly "Report source handler"
      described as {
        |Publishes Report events onto the outlet.
      }
    }
  } with {
    briefly "Report event source"
    described as {
      |Publishes Report entity events into the streaming topology.
    }
  }
  sink ReportEventSink is {
    inlet ReportInlet is type ReportEvent
    handler ReportSinkHandler is {
      on event Report.ReportCreated is {
        tell event Report.ReportCreated to repository ReportContext.ReportRepository
      }
      on event Report.ReportDetailsUpdated is {
        tell event Report.ReportDetailsUpdated to repository ReportContext.ReportRepository
      }
      on event Report.OffenseAdded is {
        tell event Report.OffenseAdded to repository ReportContext.ReportRepository
      }
      on event Report.OffenseRemoved is {
        tell event Report.OffenseRemoved to repository ReportContext.ReportRepository
      }
      on event Report.InvolvedPartyAdded is {
        tell event Report.InvolvedPartyAdded to repository ReportContext.ReportRepository
      }
      on event Report.InvolvedPartyUpdated is {
        tell event Report.InvolvedPartyUpdated to repository ReportContext.ReportRepository
      }
      on event Report.VehicleAdded is {
        tell event Report.VehicleAdded to repository ReportContext.ReportRepository
      }
      on event Report.PropertyAdded is {
        tell event Report.PropertyAdded to repository ReportContext.ReportRepository
      }
      on event Report.EvidenceAdded is {
        tell event Report.EvidenceAdded to repository ReportContext.ReportRepository
      }
      on event Report.EvidenceCustodyUpdated is {
        tell event Report.EvidenceCustodyUpdated to repository ReportContext.ReportRepository
      }
      on event Report.ArrestRecorded is {
        tell event Report.ArrestRecorded to repository ReportContext.ReportRepository
      }
      on event Report.NarrativeWritten is {
        tell event Report.NarrativeWritten to repository ReportContext.ReportRepository
      }
      on event Report.ReportSubmitted is {
        tell event Report.ReportSubmitted to repository ReportContext.ReportRepository
      }
      on event Report.ReportApproved is {
        tell event Report.ReportApproved to repository ReportContext.ReportRepository
      }
      on event Report.ReportRejected is {
        tell event Report.ReportRejected to repository ReportContext.ReportRepository
      }
      on event Report.ReportLinkedToCase is {
        tell event Report.ReportLinkedToCase to repository ReportContext.ReportRepository
      }
      on event Report.ReportSealed is {
        tell event Report.ReportSealed to repository ReportContext.ReportRepository
      }
      on event Report.ReportExpunged is {
        tell event Report.ReportExpunged to repository ReportContext.ReportRepository
      }
      on other is {
        error "Unexpected message for sink ReportEventSink"
      }
    } with {
      briefly "Report sink handler"
      described as {
        |Persists Report events via the repository.
      }
    }
  } with {
    briefly "Report event sink"
    described as {
      |Receives Report events for persistence.
    }
  }
  connector ReportEventFlow is {
    from outlet ReportContext.ReportEventSource.ReportEvents to
      inlet ReportContext.ReportEventSink.ReportInlet
  } with {
    briefly "Report event flow"
    described as {
      |Connects the Report source to its sink.
    }
  }
} with {
  briefly "Report context"
  described as {
    | The Report context manages police reports
    | and documentation.
  }
}
