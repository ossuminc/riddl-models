// Records Management - Report Context
context ReportContext is {
  adaptor FromCourtService from context CourtService is { 
    handler FromCourtServiceHandler is {
      on event CourtService.ProtectiveOrderIssued is {
        do "the model receives protective order issued"
      }
      on event CourtService.WarrantIssued is {
        do "the model receives warrant issued"
      }
      on event CourtService.WarrantRecalled is {
        do "the model receives warrant recalled"
      }
      on other is {
        error "Unexpected message for adaptor FromCourtService"
      }
    } with {
      briefly "from court service"
      described as {
        |Carries messages from the external CourtService.
      }
    }
  } with {
    briefly "CourtService integration"
    described as {
      |The model's side of the CourtService conversation.
    }
  }
  adaptor FromDMVService from context DMVService is { 
    handler FromDMVServiceHandler is {
      on result DMVService.DriverInfoResult is {
        do "the model receives driver info result"
      }
      on result DMVService.VehicleRegistrationResult is {
        do "the model receives vehicle registration result"
      }
      on other is {
        error "Unexpected message for adaptor FromDMVService"
      }
    } with {
      briefly "from dmv service"
      described as {
        |Carries messages from the external DMVService.
      }
    }
  } with {
    briefly "DMVService integration"
    described as {
      |The model's side of the DMVService conversation.
    }
  }
  adaptor ToDMVService to context DMVService is { 
    handler ToDMVServiceHandler is {
      on query DMVService.GetDriverInfo is {
        do "the model sends get driver info"
      }
      on query DMVService.GetVehicleRegistration is {
        do "the model sends get vehicle registration"
      }
      on other is {
        error "Unexpected message for adaptor ToDMVService"
      }
    } with {
      briefly "to dmv service"
      described as {
        |Carries messages to the external DMVService.
      }
    }
  } with {
    briefly "DMVService integration"
    described as {
      |The model's side of the DMVService conversation.
    }
  }
  adaptor FromEvidenceLabService from context EvidenceLabService is { 
    handler FromEvidenceLabServiceHandler is {
      on event EvidenceLabService.AnalysisCompleted is {
        do "the model receives analysis completed"
      }
      on event EvidenceLabService.AnalysisReceived is {
        do "the model receives analysis received"
      }
      on other is {
        error "Unexpected message for adaptor FromEvidenceLabService"
      }
    } with {
      briefly "from evidence lab service"
      described as {
        |Carries messages from the external EvidenceLabService.
      }
    }
  } with {
    briefly "EvidenceLabService integration"
    described as {
      |The model's side of the EvidenceLabService conversation.
    }
  }
  adaptor ToEvidenceLabService to context EvidenceLabService is { 
    handler ToEvidenceLabServiceHandler is {
      on command EvidenceLabService.SubmitForAnalysis is {
        do "the model sends submit for analysis"
      }
      on other is {
        error "Unexpected message for adaptor ToEvidenceLabService"
      }
    } with {
      briefly "to evidence lab service"
      described as {
        |Carries messages to the external EvidenceLabService.
      }
    }
  } with {
    briefly "EvidenceLabService integration"
    described as {
      |The model's side of the EvidenceLabService conversation.
    }
  }
  adaptor FromJailService from context JailService is { 
    handler FromJailServiceHandler is {
      on event JailService.InmateReleased is {
        do "the model receives inmate released"
      }
      on result JailService.InmateStatusResult is {
        do "the model receives inmate status result"
      }
      on other is {
        error "Unexpected message for adaptor FromJailService"
      }
    } with {
      briefly "from jail service"
      described as {
        |Carries messages from the external JailService.
      }
    }
  } with {
    briefly "JailService integration"
    described as {
      |The model's side of the JailService conversation.
    }
  }
  adaptor ToJailService to context JailService is { 
    handler ToJailServiceHandler is {
      on query JailService.GetInmateStatus is {
        do "the model sends get inmate status"
      }
      on other is {
        error "Unexpected message for adaptor ToJailService"
      }
    } with {
      briefly "to jail service"
      described as {
        |Carries messages to the external JailService.
      }
    }
  } with {
    briefly "JailService integration"
    described as {
      |The model's side of the JailService conversation.
    }
  }
  adaptor FromNCICService from context NCICService is { 
    handler FromNCICServiceHandler is {
      on result NCICService.PersonCheckResult is {
        do "the model receives person check result"
      }
      on result NCICService.PropertyCheckResult is {
        do "the model receives property check result"
      }
      on result NCICService.VehicleCheckResult is {
        do "the model receives vehicle check result"
      }
      on other is {
        error "Unexpected message for adaptor FromNCICService"
      }
    } with {
      briefly "from ncic service"
      described as {
        |Carries messages from the external NCICService.
      }
    }
  } with {
    briefly "NCICService integration"
    described as {
      |The model's side of the NCICService conversation.
    }
  }
  adaptor ToNCICService to context NCICService is { 
    handler ToNCICServiceHandler is {
      on query NCICService.RunPersonCheck is {
        do "the model sends run person check"
      }
      on query NCICService.RunPropertyCheck is {
        do "the model sends run property check"
      }
      on query NCICService.RunVehicleCheck is {
        do "the model sends run vehicle check"
      }
      on other is {
        error "Unexpected message for adaptor ToNCICService"
      }
    } with {
      briefly "to ncic service"
      described as {
        |Carries messages to the external NCICService.
      }
    }
  } with {
    briefly "NCICService integration"
    described as {
      |The model's side of the NCICService conversation.
    }
  }
  adaptor FromProsecutorService from context ProsecutorService is { 
    handler FromProsecutorServiceHandler is {
      on event ProsecutorService.CaseDeclinedNotification is {
        do "the model receives case declined notification"
      }
      on event ProsecutorService.CasePacketReceived is {
        do "the model receives case packet received"
      }
      on event ProsecutorService.ChargesFiledNotification is {
        do "the model receives charges filed notification"
      }
      on other is {
        error "Unexpected message for adaptor FromProsecutorService"
      }
    } with {
      briefly "from prosecutor service"
      described as {
        |Carries messages from the external ProsecutorService.
      }
    }
  } with {
    briefly "ProsecutorService integration"
    described as {
      |The model's side of the ProsecutorService conversation.
    }
  }
  adaptor ToProsecutorService to context ProsecutorService is { 
    handler ToProsecutorServiceHandler is {
      on command ProsecutorService.SubmitCasePacket is {
        do "the model sends submit case packet"
      }
      on other is {
        error "Unexpected message for adaptor ToProsecutorService"
      }
    } with {
      briefly "to prosecutor service"
      described as {
        |Carries messages to the external ProsecutorService.
      }
    }
  } with {
    briefly "ProsecutorService integration"
    described as {
      |The model's side of the ProsecutorService conversation.
    }
  }
  include "types.riddl"
  include "Report.riddl"
  // Repository
  repository ReportRepository as merge is {
    record StoredReport is  {
      reportId: ReportId with {
        briefly "reportId"
        described as {
          |The reportId column of the stored report row.
        }
      }
    } with {
      briefly "Stored report row"
      described as {
        |The persistence shape of report data as this repository stores it.
      }
    }
    schema ReportData is relational
      of reports as type StoredReport
 with {
      briefly "Report data schema"
      described as {
        |The relational schema persisting report records for this repository.
      }
    }
    inlet ReportRepositoryFromReport is type ReportEvent    inlet ReportRepositoryFromCrimeStatistics is type ReportEvent    inlet ReportRepositoryFromEvidenceInventory is type ReportEvent    outlet ReportRepositoryResponses is type Report.ReportQueryResult
    query FindReportById is  {
      reportId: ReportId with {
        briefly "Report"
        described as {
          |Report identifier.
        }
      }
    } with {
      briefly "Find report by ID"
      described as {
        |Retrieves report by identifier.
      }
    }
    result ReportResult is  {
      report: Report.ActiveStateData with {
        briefly "Report"
        described as {
          |Report data.
        }
      }
    } with {
      briefly "Report result"
      described as {
        |Returns report data.
      }
    }
    query SearchReports is  {
      filterReportType: ReportType? with {
        briefly "Type"
        described as {
          |Filter by type.
        }
      }
      filterStatus: ReportStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      officerId: OfficerId? with {
        briefly "Officer"
        described as {
          |Filter by officer.
        }
      }
      fromDate: Date? with {
        briefly "From"
        described as {
          |Start date.
        }
      }
      toDate: Date? with {
        briefly "To"
        described as {
          |End date.
        }
      }
      filterOffense: String(1,50)? with {
        briefly "Offense"
        described as {
          |Filter by offense statute.
        }
      }
    } with {
      briefly "Search reports"
      described as {
        |Searches reports by criteria.
      }
    }
    result ReportsResult is  {
      reports: Report.ActiveStateData+ with {
        briefly "Reports"
        described as {
          |Matching reports.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Reports result"
      described as {
        |Returns matching reports.
      }
    }
    query FindByPerson is  {
      searchFirstName: String(1,100)? with {
        briefly "First"
        described as {
          |First name.
        }
      }
      lastName: String(1,100) with {
        briefly "Last"
        described as {
          |Last name.
        }
      }
      searchDateOfBirth: Date? with {
        briefly "DOB"
        described as {
          |Date of birth.
        }
      }
    } with {
      briefly "Find by person"
      described as {
        |Finds reports involving a person.
      }
    }
    query FindByAddress is  {
      street: String(1,200) with {
        briefly "Street"
        described as {
          |Street address.
        }
      }
      city: String(1,100)? with {
        briefly "City"
        described as {
          |City.
        }
      }
    } with {
      briefly "Find by address"
      described as {
        |Finds reports at a location.
      }
    }
    query FindByVehicle is  {
      searchLicensePlate: String(1,20)? with {
        briefly "Plate"
        described as {
          |License plate.
        }
      }
      vin: String(17,17)? with {
        briefly "VIN"
        described as {
          |Vehicle identification number.
        }
      }
    } with {
      briefly "Find by vehicle"
      described as {
        |Finds reports involving a vehicle.
      }
    }
    query FindPendingApproval is  {
      supervisorId: OfficerId with {
        briefly "Supervisor"
        described as {
          |Supervisor identifier.
        }
      }
    } with {
      briefly "Find pending approval"
      described as {
        |Finds reports awaiting approval.
      }
    }
    handler ReportRepositoryHandler is {
      on query GetStatisticsData is {
        do "read the statistics data projection"
        reply result StatisticsDataView
      }
      on query GetInventoryData is {
        do "read the inventory data projection"
        reply result InventoryDataView
      }
      on query FindReportById is {
        reply result ReportResult
      }
      on query SearchReports is {
        reply result ReportsResult
      }
      on query FindByPerson is {
        reply result ReportsResult
      }
      on query FindByAddress is {
        reply result ReportsResult
      }
      on query FindByVehicle is {
        reply result ReportsResult
      }
      on query FindPendingApproval is {
        reply result ReportsResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes report queries.
      }
    }
  } with {
    briefly "Report repository"
    described as {
      |Persistence for report records.
    }
  }
  // Projector for crime statistics
  query GetStatisticsData is  {
    statisticsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which statistics data to retrieve.
      }
    }
  } with {
    briefly "Get statistics data"
    described as {
      |Retrieves the statistics data projection.
    }
  }
  result StatisticsDataView is  {
    statisticsData: CrimeStatistics.StatisticsData with {
      briefly "Statistics data"
      described as {
        |The statistics data being returned.
      }
    }
  } with {
    briefly "Statistics data view"
    described as {
      |Read model view carrying the statistics data projection.
    }
  }
  projector CrimeStatistics as flow is {
    updates repository ReportContext.ReportRepository
    inlet CrimeStatisticsFromReport is type ReportEvent    outlet CrimeStatisticsOut is type ReportEvent
    record StatisticsData is  {
      reportsByType: TypeCount+ with {
        briefly "By type"
        described as {
          |Reports by type.
        }
      }
      reportsByOffense: OffenseCount+ with {
        briefly "By offense"
        described as {
          |Reports by offense.
        }
      }
      reportsByBeat: BeatCount+ with {
        briefly "By beat"
        described as {
          |Reports by patrol beat.
        }
      }
      arrestCount: Natural with {
        briefly "Arrests"
        described as {
          |Total arrests.
        }
      }
      clearanceRate: Decimal(5,2) with {
        briefly "Clearance"
        described as {
          |Case clearance rate.
        }
      }
      monthlyTrend: MonthlyCount+ with {
        briefly "Monthly"
        described as {
          |Monthly incident counts.
        }
      }
    } with {
      briefly "Statistics data"
      described as {
        |Crime statistics metrics.
      }
    }
    record TypeCount is  {
      reportType: ReportType with {
        briefly "Type"
        described as {
          |Report type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Report count.
        }
      }
    } with {
      briefly "Type count"
      described as {
        |Count by report type.
      }
    }
    record OffenseCount is  {
      statute: String(1,50) with {
        briefly "Statute"
        described as {
          |Offense statute.
        }
      }
      description: String(1,200) with {
        briefly "Description"
        described as {
          |Offense description.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Offense count.
        }
      }
    } with {
      briefly "Offense count"
      described as {
        |Count by offense.
      }
    }
    record BeatCount is  {
      beat: String(1,20) with {
        briefly "Beat"
        described as {
          |Patrol beat.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Incident count.
        }
      }
    } with {
      briefly "Beat count"
      described as {
        |Count by patrol beat.
      }
    }
    record MonthlyCount is  {
      month: Date with {
        briefly "Month"
        described as {
          |Month.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Incident count.
        }
      }
    } with {
      briefly "Monthly count"
      described as {
        |Monthly incident count.
      }
    }
    handler StatisticsHandler is {
      on event Report.ReportCreated is {
        tell event Report.ReportCreated to repository ReportContext.ReportRepository
      }
      on event Report.OffenseAdded is {
        tell event Report.OffenseAdded to repository ReportContext.ReportRepository
      }
      on event Report.ArrestRecorded is {
        tell event Report.ArrestRecorded to repository ReportContext.ReportRepository
      }
      on event Report.ReportApproved is {
        tell event Report.ReportApproved to repository ReportContext.ReportRepository
      }
    } with {
      briefly "Processes statistics events"
      described as {
        |Updates crime statistics from events.
      }
    }
  } with {
    briefly "Crime statistics"
    described as {
      |Projects crime statistics for analysis.
    }
  }
  // Projector for evidence tracking
  query GetInventoryData is  {
    inventoryDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which inventory data to retrieve.
      }
    }
  } with {
    briefly "Get inventory data"
    described as {
      |Retrieves the inventory data projection.
    }
  }
  result InventoryDataView is  {
    inventoryData: EvidenceInventory.InventoryData with {
      briefly "Inventory data"
      described as {
        |The inventory data being returned.
      }
    }
  } with {
    briefly "Inventory data view"
    described as {
      |Read model view carrying the inventory data projection.
    }
  }
  projector EvidenceInventory as flow is {
    updates repository ReportContext.ReportRepository
    inlet EvidenceInventoryFromReport is type ReportEvent    outlet EvidenceInventoryOut is type ReportEvent
    record InventoryData is  {
      totalItems: Natural with {
        briefly "Total"
        described as {
          |Total evidence items.
        }
      }
      itemsByType: EvidenceTypeCount+ with {
        briefly "By type"
        described as {
          |Items by type.
        }
      }
      pendingDisposition: Natural with {
        briefly "Pending"
        described as {
          |Awaiting disposition.
        }
      }
      recentTransfers: CustodyTransfer+ with {
        briefly "Transfers"
        described as {
          |Recent custody transfers.
        }
      }
    } with {
      briefly "Inventory data"
      described as {
        |Evidence inventory status.
      }
    }
    record EvidenceTypeCount is  {
      evidenceType: String(1,50) with {
        briefly "Type"
        described as {
          |Evidence type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Item count.
        }
      }
    } with {
      briefly "Evidence type count"
      described as {
        |Count by evidence type.
      }
    }
    record CustodyTransfer is  {
      evidenceId: EvidenceId with {
        briefly "Evidence"
        described as {
          |Evidence ID.
        }
      }
      reportId: ReportId with {
        briefly "Report"
        described as {
          |Associated report.
        }
      }
      transferredAt: TimeStamp with {
        briefly "Transferred"
        described as {
          |Transfer time.
        }
      }
    } with {
      briefly "Custody transfer"
      described as {
        |Recent custody transfer.
      }
    }
    handler InventoryHandler is {
      on event Report.EvidenceAdded is {
        tell event Report.EvidenceAdded to repository ReportContext.ReportRepository
      }
      on event Report.EvidenceCustodyUpdated is {
        tell event Report.EvidenceCustodyUpdated to repository ReportContext.ReportRepository
      }
    } with {
      briefly "Processes inventory events"
      described as {
        |Updates evidence inventory from events.
      }
    }
  } with {
    briefly "Evidence inventory"
    described as {
      |Projects evidence tracking data.
    }
  }
  // ---- Event publication for Report ----
  type ReportEvent is one of {
    ReportContext.Report.ReportCreated or ReportContext.Report.ReportDetailsUpdated or ReportContext.Report.OffenseAdded or ReportContext.Report.OffenseRemoved or ReportContext.Report.InvolvedPartyAdded or ReportContext.Report.InvolvedPartyUpdated or ReportContext.Report.VehicleAdded or ReportContext.Report.PropertyAdded or ReportContext.Report.EvidenceAdded or ReportContext.Report.EvidenceCustodyUpdated or ReportContext.Report.ArrestRecorded or ReportContext.Report.NarrativeWritten or ReportContext.Report.ReportSubmitted or ReportContext.Report.ReportApproved or ReportContext.Report.ReportRejected or ReportContext.Report.ReportLinkedToCase or ReportContext.Report.ReportSealed or ReportContext.Report.ReportExpunged
  } with {
    briefly "Report event alternation"
    described as {
      |Union of all Report events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ReportEventSource as source is {
    outlet ReportEvents is type ReportEvent
    handler ReportSourceHandler is {
      on event Report.ReportCreated is {
        send event Report.ReportCreated to outlet ReportEvents
      }
      on event Report.ReportDetailsUpdated is {
        send event Report.ReportDetailsUpdated to outlet ReportEvents
      }
      on event Report.OffenseAdded is {
        send event Report.OffenseAdded to outlet ReportEvents
      }
      on event Report.OffenseRemoved is {
        send event Report.OffenseRemoved to outlet ReportEvents
      }
      on event Report.InvolvedPartyAdded is {
        send event Report.InvolvedPartyAdded to outlet ReportEvents
      }
      on event Report.InvolvedPartyUpdated is {
        send event Report.InvolvedPartyUpdated to outlet ReportEvents
      }
      on event Report.VehicleAdded is {
        send event Report.VehicleAdded to outlet ReportEvents
      }
      on event Report.PropertyAdded is {
        send event Report.PropertyAdded to outlet ReportEvents
      }
      on event Report.EvidenceAdded is {
        send event Report.EvidenceAdded to outlet ReportEvents
      }
      on event Report.EvidenceCustodyUpdated is {
        send event Report.EvidenceCustodyUpdated to outlet ReportEvents
      }
      on event Report.ArrestRecorded is {
        send event Report.ArrestRecorded to outlet ReportEvents
      }
      on event Report.NarrativeWritten is {
        send event Report.NarrativeWritten to outlet ReportEvents
      }
      on event Report.ReportSubmitted is {
        send event Report.ReportSubmitted to outlet ReportEvents
      }
      on event Report.ReportApproved is {
        send event Report.ReportApproved to outlet ReportEvents
      }
      on event Report.ReportRejected is {
        send event Report.ReportRejected to outlet ReportEvents
      }
      on event Report.ReportLinkedToCase is {
        send event Report.ReportLinkedToCase to outlet ReportEvents
      }
      on event Report.ReportSealed is {
        send event Report.ReportSealed to outlet ReportEvents
      }
      on event Report.ReportExpunged is {
        send event Report.ReportExpunged to outlet ReportEvents
      }
      on other is {
        error "Unexpected message for source ReportEventSource"
      }
    } with {
      briefly "Report source handler"
      described as {
        |Publishes Report events onto the outlet.
      }
    }
  } with {
    briefly "Report event source"
    described as {
      |Publishes Report entity events into the streaming topology.
    }
  }
  processor ReportEventSink as sink is {
    inlet ReportInlet is type ReportEvent    handler ReportSinkHandler is {
      on event Report.ReportCreated is {
        tell event Report.ReportCreated to repository ReportContext.ReportRepository
      }
      on event Report.ReportDetailsUpdated is {
        tell event Report.ReportDetailsUpdated to repository ReportContext.ReportRepository
      }
      on event Report.OffenseAdded is {
        tell event Report.OffenseAdded to repository ReportContext.ReportRepository
      }
      on event Report.OffenseRemoved is {
        tell event Report.OffenseRemoved to repository ReportContext.ReportRepository
      }
      on event Report.InvolvedPartyAdded is {
        tell event Report.InvolvedPartyAdded to repository ReportContext.ReportRepository
      }
      on event Report.InvolvedPartyUpdated is {
        tell event Report.InvolvedPartyUpdated to repository ReportContext.ReportRepository
      }
      on event Report.VehicleAdded is {
        tell event Report.VehicleAdded to repository ReportContext.ReportRepository
      }
      on event Report.PropertyAdded is {
        tell event Report.PropertyAdded to repository ReportContext.ReportRepository
      }
      on event Report.EvidenceAdded is {
        tell event Report.EvidenceAdded to repository ReportContext.ReportRepository
      }
      on event Report.EvidenceCustodyUpdated is {
        tell event Report.EvidenceCustodyUpdated to repository ReportContext.ReportRepository
      }
      on event Report.ArrestRecorded is {
        tell event Report.ArrestRecorded to repository ReportContext.ReportRepository
      }
      on event Report.NarrativeWritten is {
        tell event Report.NarrativeWritten to repository ReportContext.ReportRepository
      }
      on event Report.ReportSubmitted is {
        tell event Report.ReportSubmitted to repository ReportContext.ReportRepository
      }
      on event Report.ReportApproved is {
        tell event Report.ReportApproved to repository ReportContext.ReportRepository
      }
      on event Report.ReportRejected is {
        tell event Report.ReportRejected to repository ReportContext.ReportRepository
      }
      on event Report.ReportLinkedToCase is {
        tell event Report.ReportLinkedToCase to repository ReportContext.ReportRepository
      }
      on event Report.ReportSealed is {
        tell event Report.ReportSealed to repository ReportContext.ReportRepository
      }
      on event Report.ReportExpunged is {
        tell event Report.ReportExpunged to repository ReportContext.ReportRepository
      }
      on other is {
        error "Unexpected message for sink ReportEventSink"
      }
    } with {
      briefly "Report sink handler"
      described as {
        |Persists Report events via the repository.
      }
    }
  } with {
    briefly "Report event sink"
    described as {
      |Receives Report events for persistence.
    }
  }
  connector ReportEventFlow is from outlet ReportContext.ReportEventSource.ReportEvents to inlet ReportContext.ReportEventSink.ReportInlet with {
    briefly "Report event flow"
    described as {
      |Connects the Report source to its sink.
    }
  }
  processor ReportEventSplit as split is {
    inlet ReportEventSplitIn is type ReportEvent    outlet ReportEventSplitToReportRepository is type ReportEvent
    outlet ReportEventSplitToCrimeStatistics is type ReportEvent
    outlet ReportEventSplitToEvidenceInventory is type ReportEvent
    handler ReportEventSplitHandler is {
      on event Report.ReportCreated is {
        send event Report.ReportCreated to outlet ReportEventSplitToReportRepository
        send event Report.ReportCreated to outlet ReportEventSplitToCrimeStatistics
        send event Report.ReportCreated to outlet ReportEventSplitToEvidenceInventory
        tell event Report.ReportCreated to entity ReportContext.Report
      }
      on event Report.ReportDetailsUpdated is {
        send event Report.ReportDetailsUpdated to outlet ReportEventSplitToReportRepository
        send event Report.ReportDetailsUpdated to outlet ReportEventSplitToCrimeStatistics
        send event Report.ReportDetailsUpdated to outlet ReportEventSplitToEvidenceInventory
        tell event Report.ReportDetailsUpdated to entity ReportContext.Report
      }
      on event Report.OffenseAdded is {
        send event Report.OffenseAdded to outlet ReportEventSplitToReportRepository
        send event Report.OffenseAdded to outlet ReportEventSplitToCrimeStatistics
        send event Report.OffenseAdded to outlet ReportEventSplitToEvidenceInventory
        tell event Report.OffenseAdded to entity ReportContext.Report
      }
      on event Report.OffenseRemoved is {
        send event Report.OffenseRemoved to outlet ReportEventSplitToReportRepository
        send event Report.OffenseRemoved to outlet ReportEventSplitToCrimeStatistics
        send event Report.OffenseRemoved to outlet ReportEventSplitToEvidenceInventory
        tell event Report.OffenseRemoved to entity ReportContext.Report
      }
      on event Report.InvolvedPartyAdded is {
        send event Report.InvolvedPartyAdded to outlet ReportEventSplitToReportRepository
        send event Report.InvolvedPartyAdded to outlet ReportEventSplitToCrimeStatistics
        send event Report.InvolvedPartyAdded to outlet ReportEventSplitToEvidenceInventory
        tell event Report.InvolvedPartyAdded to entity ReportContext.Report
      }
      on event Report.InvolvedPartyUpdated is {
        send event Report.InvolvedPartyUpdated to outlet ReportEventSplitToReportRepository
        send event Report.InvolvedPartyUpdated to outlet ReportEventSplitToCrimeStatistics
        send event Report.InvolvedPartyUpdated to outlet ReportEventSplitToEvidenceInventory
        tell event Report.InvolvedPartyUpdated to entity ReportContext.Report
      }
      on event Report.VehicleAdded is {
        send event Report.VehicleAdded to outlet ReportEventSplitToReportRepository
        send event Report.VehicleAdded to outlet ReportEventSplitToCrimeStatistics
        send event Report.VehicleAdded to outlet ReportEventSplitToEvidenceInventory
        tell event Report.VehicleAdded to entity ReportContext.Report
      }
      on event Report.PropertyAdded is {
        send event Report.PropertyAdded to outlet ReportEventSplitToReportRepository
        send event Report.PropertyAdded to outlet ReportEventSplitToCrimeStatistics
        send event Report.PropertyAdded to outlet ReportEventSplitToEvidenceInventory
        tell event Report.PropertyAdded to entity ReportContext.Report
      }
      on event Report.EvidenceAdded is {
        send event Report.EvidenceAdded to outlet ReportEventSplitToReportRepository
        send event Report.EvidenceAdded to outlet ReportEventSplitToCrimeStatistics
        send event Report.EvidenceAdded to outlet ReportEventSplitToEvidenceInventory
        tell event Report.EvidenceAdded to entity ReportContext.Report
      }
      on event Report.EvidenceCustodyUpdated is {
        send event Report.EvidenceCustodyUpdated to outlet ReportEventSplitToReportRepository
        send event Report.EvidenceCustodyUpdated to outlet ReportEventSplitToCrimeStatistics
        send event Report.EvidenceCustodyUpdated to outlet ReportEventSplitToEvidenceInventory
        tell event Report.EvidenceCustodyUpdated to entity ReportContext.Report
      }
      on event Report.ArrestRecorded is {
        send event Report.ArrestRecorded to outlet ReportEventSplitToReportRepository
        send event Report.ArrestRecorded to outlet ReportEventSplitToCrimeStatistics
        send event Report.ArrestRecorded to outlet ReportEventSplitToEvidenceInventory
        tell event Report.ArrestRecorded to entity ReportContext.Report
      }
      on event Report.NarrativeWritten is {
        send event Report.NarrativeWritten to outlet ReportEventSplitToReportRepository
        send event Report.NarrativeWritten to outlet ReportEventSplitToCrimeStatistics
        send event Report.NarrativeWritten to outlet ReportEventSplitToEvidenceInventory
        tell event Report.NarrativeWritten to entity ReportContext.Report
      }
      on event Report.ReportSubmitted is {
        send event Report.ReportSubmitted to outlet ReportEventSplitToReportRepository
        send event Report.ReportSubmitted to outlet ReportEventSplitToCrimeStatistics
        send event Report.ReportSubmitted to outlet ReportEventSplitToEvidenceInventory
        tell event Report.ReportSubmitted to entity ReportContext.Report
      }
      on event Report.ReportApproved is {
        send event Report.ReportApproved to outlet ReportEventSplitToReportRepository
        send event Report.ReportApproved to outlet ReportEventSplitToCrimeStatistics
        send event Report.ReportApproved to outlet ReportEventSplitToEvidenceInventory
        tell event Report.ReportApproved to entity ReportContext.Report
      }
      on event Report.ReportRejected is {
        send event Report.ReportRejected to outlet ReportEventSplitToReportRepository
        send event Report.ReportRejected to outlet ReportEventSplitToCrimeStatistics
        send event Report.ReportRejected to outlet ReportEventSplitToEvidenceInventory
        tell event Report.ReportRejected to entity ReportContext.Report
      }
      on event Report.ReportLinkedToCase is {
        send event Report.ReportLinkedToCase to outlet ReportEventSplitToReportRepository
        send event Report.ReportLinkedToCase to outlet ReportEventSplitToCrimeStatistics
        send event Report.ReportLinkedToCase to outlet ReportEventSplitToEvidenceInventory
        tell event Report.ReportLinkedToCase to entity ReportContext.Report
      }
      on event Report.ReportSealed is {
        send event Report.ReportSealed to outlet ReportEventSplitToReportRepository
        send event Report.ReportSealed to outlet ReportEventSplitToCrimeStatistics
        send event Report.ReportSealed to outlet ReportEventSplitToEvidenceInventory
        tell event Report.ReportSealed to entity ReportContext.Report
      }
      on event Report.ReportExpunged is {
        send event Report.ReportExpunged to outlet ReportEventSplitToReportRepository
        send event Report.ReportExpunged to outlet ReportEventSplitToCrimeStatistics
        send event Report.ReportExpunged to outlet ReportEventSplitToEvidenceInventory
        tell event Report.ReportExpunged to entity ReportContext.Report
      }
      on other is {
        error "Unexpected message for processor ReportEventSplit"
      }
    } with {
      briefly "Report event fan-out handler"
      described as {
        |Delivers each Report event to all of its consumers.
      }
    }
  } with {
    briefly "Report event fan-out"
    described as {
      |Fans Report events out to the repository and projectors.
    }
  }
  connector 'ReportEvent Stream' is from outlet ReportContext.Report.ReportEvents2 to inlet ReportContext.ReportEventSplit.ReportEventSplitIn with {
    briefly "Report events, fanned out to storage and read models"
  }
  connector 'ReportEvent Storage' is from outlet ReportContext.ReportEventSplit.ReportEventSplitToReportRepository to inlet ReportContext.ReportRepository.ReportRepositoryFromReport with {
    briefly "Report events on their way to storage"
  }
  connector 'CrimeStatistics Feed' is from outlet ReportContext.ReportEventSplit.ReportEventSplitToCrimeStatistics to inlet ReportContext.CrimeStatistics.CrimeStatisticsFromReport with {
    briefly "Report events feeding the CrimeStatistics projection"
  }
  connector 'EvidenceInventory Feed' is from outlet ReportContext.ReportEventSplit.ReportEventSplitToEvidenceInventory to inlet ReportContext.EvidenceInventory.EvidenceInventoryFromReport with {
    briefly "Report events feeding the EvidenceInventory projection"
  }
  connector 'CrimeStatistics Storage' is from outlet ReportContext.CrimeStatistics.CrimeStatisticsOut to inlet ReportContext.ReportRepository.ReportRepositoryFromCrimeStatistics with {
    briefly "The CrimeStatistics projection on its way to storage"
  }
  connector 'EvidenceInventory Storage' is from outlet ReportContext.EvidenceInventory.EvidenceInventoryOut to inlet ReportContext.ReportRepository.ReportRepositoryFromEvidenceInventory with {
    briefly "The EvidenceInventory projection on its way to storage"
  }
} with {
  briefly "Report context"
  described as {
    | The Report context manages police reports
    | and documentation.
  }
}
