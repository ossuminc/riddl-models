// Records Management Domain Model
// Law enforcement records management system
domain RecordsManagement is {
  persistent connector 'NCICServiceReply Stream' is from outlet NCICService.NCICServiceRepliesOut to inlet ReportContext.ToNCICService.ToNCICServiceReplies with {
    briefly "What NCICService answers ReportContext"
  }
  persistent connector 'JailServiceReply Stream' is from outlet JailService.JailServiceRepliesOut to inlet ReportContext.ToJailService.ToJailServiceReplies with {
    briefly "What JailService answers ReportContext"
  }
  persistent connector 'DMVServiceReply Stream' is from outlet DMVService.DMVServiceRepliesOut to inlet ReportContext.ToDMVService.ToDMVServiceReplies with {
    briefly "What DMVService answers ReportContext"
  }
  persistent connector 'CourtServiceEvent Stream' is from outlet CourtService.CourtServiceEventsOut to inlet ReportContext.FromCourtService.FromCourtServiceIn with {
    briefly "What CourtService tells ReportContext, unasked"
  }
  persistent connector 'EvidenceLabServiceEvent Stream' is from outlet EvidenceLabService.EvidenceLabServiceEventsOut to inlet ReportContext.FromEvidenceLabService.FromEvidenceLabServiceIn with {
    briefly "What EvidenceLabService tells ReportContext, unasked"
  }
  persistent connector 'JailServiceEvent Stream' is from outlet JailService.JailServiceEventsOut to inlet ReportContext.FromJailService.FromJailServiceIn with {
    briefly "What JailService tells ReportContext, unasked"
  }
  persistent connector 'ProsecutorServiceEvent Stream' is from outlet ProsecutorService.ProsecutorServiceEventsOut to inlet ReportContext.FromProsecutorService.FromProsecutorServiceIn with {
    briefly "What ProsecutorService tells ReportContext, unasked"
  }
  persistent connector 'NCICServiceRequest Stream' is from outlet ReportContext.ToNCICService.ToNCICServiceOut to inlet NCICService.NCICServiceRequests with {
    briefly "What ReportContext asks NCICService to send"
  }
  persistent connector 'JailServiceRequest Stream' is from outlet ReportContext.ToJailService.ToJailServiceOut to inlet JailService.JailServiceRequests with {
    briefly "What ReportContext asks JailService to send"
  }
  persistent connector 'DMVServiceRequest Stream' is from outlet ReportContext.ToDMVService.ToDMVServiceOut to inlet DMVService.DMVServiceRequests with {
    briefly "What ReportContext asks DMVService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Officer is "law enforcement officer" with {
    briefly "Officer"
    described as {
      |Police officer creating reports.
    }
  }
  user RecordsClerk is "person managing police records" with {
    briefly "Records Clerk"
    described as {
      |Staff managing report records.
    }
  }
  user Detective is "investigator working cases" with {
    briefly "Detective"
    described as {
      |Investigator on cases.
    }
  }
  user Supervisor is "person reviewing reports" with {
    briefly "Supervisor"
    described as {
      |Supervisory staff.
    }
  }
  epic RecordsManagementEpic is {
    user Officer wants to "to document incidents and arrests" so that "records are available for prosecution and analysis"
    case FileReport is {
      user Officer wants to "to submit an incident report" so that "the incident is documented"
      step is "Officer completes" "report form" "in the field" with {
        briefly "Complete form"
        described as {
          |Fill out report.
        }
      }
      step take input RecordsManagementApp.RecordsManagementScreen.CreateReportInput from user Officer with {
        briefly "Submit report"
        described as {
          |File the report.
        }
      }
      step is "Supervisor reviews" "and approves" "report" with {
        briefly "Review"
        described as {
          |Approve report.
        }
      }
    } with {
      briefly "File report"
      described as {
        |Report filing workflow.
      }
    }
  } with {
    briefly "Records management"
    described as {
      | Epic covering incident reports, arrests,
      | and evidence documentation.
    }
  }
  include "ReportContext.riddl"
  include "external-contexts.riddl"
  application context RecordsManagementApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in RecordsManagement are delivered.
      }
    }
    group RecordsManagementScreen is {
      input FindPendingApprovalInput acquires query ReportContext.ReportRepository.FindPendingApproval with {
        briefly "Find pending approval control"
        described as {
          |The control through which a user asks the find pending approval question.
        }
      }
      input FindByVehicleInput acquires query ReportContext.ReportRepository.FindByVehicle with {
        briefly "Find by vehicle control"
        described as {
          |The control through which a user asks the find by vehicle question.
        }
      }
      input FindByAddressInput acquires query ReportContext.ReportRepository.FindByAddress with {
        briefly "Find by address control"
        described as {
          |The control through which a user asks the find by address question.
        }
      }
      input FindByPersonInput acquires query ReportContext.ReportRepository.FindByPerson with {
        briefly "Find by person control"
        described as {
          |The control through which a user asks the find by person question.
        }
      }
      input SearchReportsInput acquires query ReportContext.ReportRepository.SearchReports with {
        briefly "Search reports control"
        described as {
          |The control through which a user asks the search reports question.
        }
      }
      input FindReportByIdInput acquires query ReportContext.ReportRepository.FindReportById with {
        briefly "Find report by id control"
        described as {
          |The control through which a user asks the find report by id question.
        }
      }
      input GetInventoryDataInput acquires query ReportContext.GetInventoryData with {
        briefly "Get inventory data control"
        described as {
          |The control through which a user asks the get inventory data question.
        }
      }
      input GetStatisticsDataInput acquires query ReportContext.GetStatisticsData with {
        briefly "Get statistics data control"
        described as {
          |The control through which a user asks the get statistics data question.
        }
      }
      input FetchReportInput acquires query ReportContext.Report.FetchReport with {
        briefly "Fetch report control"
        described as {
          |The control through which a user asks the fetch report question.
        }
      }
      input AddPropertyInput acquires command ReportContext.Report.AddProperty with {
        briefly "Add property control"
        described as {
          |The control through which a user submits the add property request.
        }
      }
      input AddVehicleInput acquires command ReportContext.Report.AddVehicle with {
        briefly "Add vehicle control"
        described as {
          |The control through which a user submits the add vehicle request.
        }
      }
      input ApproveReportInput acquires command ReportContext.Report.ApproveReport with {
        briefly "Approve report control"
        described as {
          |The control through which a user submits the approve report request.
        }
      }
      input ExpungeReportInput acquires command ReportContext.Report.ExpungeReport with {
        briefly "Expunge report control"
        described as {
          |The control through which a user submits the expunge report request.
        }
      }
      input RecordArrestInput acquires command ReportContext.Report.RecordArrest with {
        briefly "Record arrest control"
        described as {
          |The control through which a user submits the record arrest request.
        }
      }
      input RejectReportInput acquires command ReportContext.Report.RejectReport with {
        briefly "Reject report control"
        described as {
          |The control through which a user submits the reject report request.
        }
      }
      input RemoveOffenseInput acquires command ReportContext.Report.RemoveOffense with {
        briefly "Remove offense control"
        described as {
          |The control through which a user submits the remove offense request.
        }
      }
      input SealReportInput acquires command ReportContext.Report.SealReport with {
        briefly "Seal report control"
        described as {
          |The control through which a user submits the seal report request.
        }
      }
      input SubmitForReviewInput acquires command ReportContext.Report.SubmitForReview with {
        briefly "Submit for review control"
        described as {
          |The control through which a user submits the submit for review request.
        }
      }
      input UpdateEvidenceCustodyInput acquires command ReportContext.Report.UpdateEvidenceCustody with {
        briefly "Update evidence custody control"
        described as {
          |The control through which a user submits the update evidence custody request.
        }
      }
      input UpdateReportDetailsInput acquires command ReportContext.Report.UpdateReportDetails with {
        briefly "Update report details control"
        described as {
          |The control through which a user submits the update report details request.
        }
      }
      input WriteNarrativeInput acquires command ReportContext.Report.WriteNarrative with {
        briefly "Write narrative control"
        described as {
          |The control through which a user submits the write narrative request.
        }
      }
      input CreateReportInput acquires command ReportContext.CreateReport with {
        briefly "Create report control"
        described as {
          |The control through which a user submits the create report request.
        }
      }
    } with {
      briefly "Records management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppReportRepositoryQueries is type ReportContext.ReportRepository.ReportRepositoryQuery
    inlet AppReportRepositoryReplies is type ReportContext.ReportRepository.ReportRepositoryReply
    outlet AppReportQueries is query ReportContext.Report.FetchReport
    outlet AppReportCommands is type ReportContext.ReportRequest
    inlet AppReportRepositoryResponses is result ReportContext.Report.ReportQueryResult
    handler RecordsManagementAppHandler is {
      on other is {
        error "Unexpected message for application context RecordsManagementApp"
      }
    } with {
      briefly "RecordsManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "RecordsManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ProsecutorServiceRequest Stream' is from outlet ReportContext.ToProsecutorService.ToProsecutorServiceOut to inlet ProsecutorService.ProsecutorServiceRequests with {
    briefly "What ReportContext asks ProsecutorService to send"
  }
  persistent connector 'EvidenceLabServiceRequest Stream' is from outlet ReportContext.ToEvidenceLabService.ToEvidenceLabServiceOut to inlet EvidenceLabService.EvidenceLabServiceRequests with {
    briefly "What ReportContext asks EvidenceLabService to send"
  }
  persistent connector 'ReportRepositoryQuery Stream' is from outlet RecordsManagementApp.AppReportRepositoryQueries to inlet ReportContext.ReportRepositoryQueriesIn with {
    briefly "RecordsManagementApp's look-ups of the report repository"
  }
  persistent connector 'ReportRepositoryReply Stream' is from outlet ReportContext.ReportRepositoryRepliesOut to inlet RecordsManagementApp.AppReportRepositoryReplies with {
    briefly "The report repository's answers returned to RecordsManagementApp"
  }
  persistent connector 'ReportQuery Stream' is from outlet RecordsManagementApp.AppReportQueries to inlet ReportContext.ReportQueriesIn with {
    briefly "RecordsManagementApp's look-ups of the report"
  }
  persistent connector 'ReportCommand Stream' is from outlet RecordsManagementApp.AppReportCommands to inlet ReportContext.ReportCommandStreamIn with {
    briefly "Report commands from the application"
  }
  persistent connector 'ReportResult Stream' is from outlet ReportContext.ReportResultStreamOut to inlet RecordsManagementApp.AppReportRepositoryResponses with {
    briefly "Report query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet RecordsManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Records management domain"
  described as {
    | The Records Management domain handles police
    | reports, arrests, and case documentation.
  }
}
