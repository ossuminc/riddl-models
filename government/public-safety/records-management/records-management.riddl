// Records Management Domain Model
// Law enforcement records management system
domain RecordsManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Officer is "law enforcement officer" with {
    briefly "Officer"
    described as {
      |Police officer creating reports.
    }
  }
  user RecordsClerk is "person managing police records" with {
    briefly "Records Clerk"
    described as {
      |Staff managing report records.
    }
  }
  user Detective is "investigator working cases" with {
    briefly "Detective"
    described as {
      |Investigator on cases.
    }
  }
  user Supervisor is "person reviewing reports" with {
    briefly "Supervisor"
    described as {
      |Supervisory staff.
    }
  }
  epic RecordsManagementEpic is {
    user Officer wants to "to document incidents and arrests" so that "records are available for prosecution and analysis"
    case FileReport is {
      user Officer wants to "to submit an incident report" so that "the incident is documented"
      step is "Officer completes" "report form" "in the field" with {
        briefly "Complete form"
        described as {
          |Fill out report.
        }
      }
      step take input RecordsManagementApp.RecordsManagementScreen.CreateReportInput from user Officer with {
        briefly "Submit report"
        described as {
          |File the report.
        }
      }
      step is "Supervisor reviews" "and approves" "report" with {
        briefly "Review"
        described as {
          |Approve report.
        }
      }
    } with {
      briefly "File report"
      described as {
        |Report filing workflow.
      }
    }
  } with {
    briefly "Records management"
    described as {
      | Epic covering incident reports, arrests,
      | and evidence documentation.
    }
  }
  include "ReportContext.riddl"
  include "external-contexts.riddl"
  application context RecordsManagementApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in RecordsManagement are delivered.
      }
    }
    group RecordsManagementScreen is {
      input CreateReportInput acquires command ReportContext.Report.CreateReport with {
        briefly "Create report control"
        described as {
          |The control through which a user submits the create report request.
        }
      }
    } with {
      briefly "Records management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppReportCommands is type ReportContext.Report.ReportCommand
    inlet AppReportRepositoryResponses is type ReportContext.Report.ReportQueryResult    handler RecordsManagementAppHandler is {
      on other is {
        error "Unexpected message for application context RecordsManagementApp"
      }
    } with {
      briefly "RecordsManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "RecordsManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ReportCommand Stream' is from outlet RecordsManagementApp.AppReportCommands to inlet ReportContext.Report.ReportCommands with {
    briefly "Report commands from the application"
  }
  persistent connector 'ReportResult Stream' is from outlet ReportContext.ReportRepository.ReportRepositoryResponses to inlet RecordsManagementApp.AppReportRepositoryResponses with {
    briefly "Report query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet RecordsManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Records management domain"
  described as {
    | The Records Management domain handles police
    | reports, arrests, and case documentation.
  }
}
