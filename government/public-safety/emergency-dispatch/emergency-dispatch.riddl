// Emergency Dispatch Domain Model
// 911/emergency call handling and first responder dispatch
domain EmergencyDispatch is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Caller is "person reporting an emergency" with {
    briefly "Caller"
    described as {
      |Individual calling emergency services.
    }
  }
  user Dispatcher is "person handling emergency calls" with {
    briefly "Dispatcher"
    described as {
      |911 call taker and dispatcher.
    }
  }
  user FirstResponder is "person responding to emergencies" with {
    briefly "First Responder"
    described as {
      |Police, fire, or EMS personnel.
    }
  }
  user DispatchSupervisor is "person overseeing dispatch operations" with {
    briefly "Supervisor"
    described as {
      |Dispatch center supervisor.
    }
  }
  epic EmergencyResponseEpic is {
    user Caller wants to "to report an emergency" so that "help can be dispatched"
    case ReportEmergency is {
      user Caller wants to "to call 911 and report an incident" so that "appropriate responders are sent"
      step is "Caller dials" "911 emergency line" "from phone" with {
        briefly "Call 911"
        described as {
          |Initiate emergency call.
        }
      }
      step take input EmergencyDispatchApp.EmergencyDispatchScreen.CreateIncidentInput from user Dispatcher with {
        briefly "Create incident"
        described as {
          |Log the incident.
        }
      }
      step is "Dispatcher evaluates" "and dispatches" "resources" with {
        briefly "Dispatch"
        described as {
          |Send responders.
        }
      }
    } with {
      briefly "Report emergency"
      described as {
        |Emergency reporting workflow.
      }
    }
  } with {
    briefly "Emergency response"
    described as {
      | Epic covering emergency calls, dispatch,
      | and incident management.
    }
  }
  include "IncidentContext.riddl"
  include "external-contexts.riddl"
  application context EmergencyDispatchApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in EmergencyDispatch are delivered.
      }
    }
    group EmergencyDispatchScreen is {
      input CreateIncidentInput acquires command IncidentContext.Incident.CreateIncident with {
        briefly "Create incident control"
        described as {
          |The control through which a user submits the create incident request.
        }
      }
    } with {
      briefly "Emergency dispatch screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppIncidentCommands is type IncidentContext.Incident.IncidentCommand
    inlet AppIncidentRepositoryResponses is result IncidentContext.Incident.IncidentQueryResult    handler EmergencyDispatchAppHandler is {
      on other is {
        error "Unexpected message for application context EmergencyDispatchApp"
      }
    } with {
      briefly "EmergencyDispatchApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "EmergencyDispatchApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'IncidentCommand Stream' is from outlet EmergencyDispatchApp.AppIncidentCommands to inlet IncidentContext.IncidentCommandStreamIn with {
    briefly "Incident commands from the application"
  }
  persistent connector 'IncidentQueryResult Stream' is from outlet IncidentContext.IncidentQueryResultStreamOut to inlet EmergencyDispatchApp.AppIncidentRepositoryResponses with {
    briefly "Incident query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet EmergencyDispatchApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Emergency dispatch domain"
  described as {
    | The Emergency Dispatch domain handles 911 calls,
    | incident creation, and first responder dispatch.
  }
}
