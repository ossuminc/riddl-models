        described as {
          |Which stored row UnitCleared applies to.
        }
      }
      unitId: UnitId? with {
        briefly "Unit id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      disposition: DispositionCode? with {
        briefly "Disposition"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      clearedAt: TimeStamp? with {
        briefly "Cleared at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist UnitCleared"
      described as {
        |Instructs this repository to apply UnitCleared to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUnitDispatched is {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row UnitDispatched applies to.
        }
      }
      unitId: UnitId? with {
        briefly "Unit id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      dispatchedBy: DispatcherId? with {
        briefly "Dispatched by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      dispatchedAt: TimeStamp? with {
        briefly "Dispatched at"
        described as {
