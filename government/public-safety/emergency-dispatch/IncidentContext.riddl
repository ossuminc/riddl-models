        }
      }
    } with {
      briefly "Persist UnitDispatched"
      described as {
        |Instructs this repository to apply UnitDispatched to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUnitEnRoute is {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row UnitEnRoute applies to.
        }
      }
      unitId: UnitId? with {
        briefly "Unit id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      enRouteAt: TimeStamp? with {
        briefly "En route at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist UnitEnRoute"
      described as {
        |Instructs this repository to apply UnitEnRoute to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredIncident is {
      incidentId: IncidentId with {
        briefly "incidentId"
        described as {
          |The incidentId column of the stored incident row.
        }
      }
      details: IncidentDetails? with {
        briefly "Details"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reopenedBy: DispatcherId? with {
        briefly "Reopened by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reopenedAt: TimeStamp? with {
        briefly "Reopened at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      linkedIncidentId: IncidentId? with {
        briefly "Linked incident id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      linkType: String(1,50)? with {
        briefly "Link type"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      linkedAt: TimeStamp? with {
        briefly "Linked at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      note: IncidentNote? with {
        briefly "Note"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      oldPriority: IncidentPriority? with {
        briefly "Old priority"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newPriority: IncidentPriority? with {
        briefly "New priority"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      downgradedAt: TimeStamp? with {
        briefly "Downgraded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      upgradedAt: TimeStamp? with {
        briefly "Upgraded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      unitId: UnitId? with {
        briefly "Unit id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      recalledAt: TimeStamp? with {
        briefly "Recalled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      cancelledBy: DispatcherId? with {
        briefly "Cancelled by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      disposition: DispositionCode? with {
        briefly "Disposition"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      closedBy: DispatcherId? with {
        briefly "Closed by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      closedAt: TimeStamp? with {
        briefly "Closed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      call: CallInfo? with {
        briefly "Call"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdBy: DispatcherId? with {
        briefly "Created by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      arrivedAt: TimeStamp? with {
        briefly "Arrived at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      clearedAt: TimeStamp? with {
        briefly "Cleared at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      dispatchedBy: DispatcherId? with {
        briefly "Dispatched by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      dispatchedAt: TimeStamp? with {
        briefly "Dispatched at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      enRouteAt: TimeStamp? with {
        briefly "En route at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored incident row"
      described as {
        |The persistence shape of incident data as this repository stores it.
      }
    }
    schema IncidentData is relational
      of incidents as record StoredIncident
        key on field StoredIncident.incidentId
 with {
      briefly "Incident data schema"
      described as {
        |The relational schema persisting incident records for this repository.
      }
    }
    outlet IncidentRepositoryResponses is result Incident.IncidentQueryResult
    query FindIncidentById replies result IncidentResult is {
      incidentId: IncidentId with {
        briefly "Incident"
        described as {
          |Incident identifier.
        }
      }
    } with {
      briefly "Find incident by ID"
      described as {
        |Retrieves incident by identifier.
      }
    }
    result IncidentResult is {
      incident: Incident.ActiveStateData with {
        briefly "Incident"
        described as {
          |Incident data.
        }
      }
    } with {
      briefly "Incident result"
      described as {
        |Returns incident data.
      }
    }
    query SearchIncidents replies result IncidentsResult is {
      filterStatus: IncidentStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      filterPriority: IncidentPriority? with {
        briefly "Priority"
        described as {
          |Filter by priority.
        }
      }
      filterIncidentType: IncidentType? with {
        briefly "Type"
        described as {
          |Filter by type.
        }
      }
      fromDate: Date? with {
        briefly "From"
        described as {
          |Start date filter.
        }
      }
      toDate: Date? with {
        briefly "To"
        described as {
          |End date filter.
        }
      }
    } with {
      briefly "Search incidents"
      described as {
        |Searches incidents by criteria.
      }
    }
    result IncidentsResult is {
      matchingIncidents: Incident.ActiveStateData+ with {
        briefly "Incidents"
        described as {
          |Matching incidents.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Incidents result"
      described as {
        |Returns matching incidents.
      }
    }
    query FindActiveIncidents replies result IncidentResult is {
      activePriority: IncidentPriority? with {
        briefly "Priority"
        described as {
          |Filter by priority.
        }
      }
      zone: String(1,50)? with {
        briefly "Zone"
        described as {
          |Filter by dispatch zone.
        }
      }
    } with {
      briefly "Find active incidents"
      described as {
        |Finds all active incidents.
      }
    }
    query FindIncidentsByUnit replies result IncidentResult is {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit identifier.
        }
      }
      activeOnly: Boolean with {
        briefly "Active only"
        described as {
          |Only active incidents.
        }
      }
    } with {
      briefly "Find by unit"
      described as {
        |Finds incidents for a unit.
      }
    }
    query FindIncidentsByLocation replies result IncidentResult is {
      latitude: Decimal(9,6) with {
        briefly "Latitude"
        described as {
          |Center latitude.
        }
      }
      longitude: Decimal(10,6) with {
        briefly "Longitude"
        described as {
          |Center longitude.
        }
      }
      radiusMiles: Decimal(5,2) with {
        briefly "Radius"
        described as {
          |Search radius in miles.
        }
      }
    } with {
      briefly "Find by location"
      described as {
        |Finds incidents near a location.
      }
    }
    handler IncidentRepositoryHandler is {
      on persistIncidentDetailsUpdated: command PersistIncidentDetailsUpdated is {
        update IncidentData.incidents set details = persistIncidentDetailsUpdated.details, updatedAt = persistIncidentDetailsUpdated.updatedAt where incidentId == persistIncidentDetailsUpdated.incidentId
      }
      on persistIncidentReopened: command PersistIncidentReopened is {
        update IncidentData.incidents set reason = persistIncidentReopened.reason, reopenedBy = persistIncidentReopened.reopenedBy, reopenedAt = persistIncidentReopened.reopenedAt where incidentId == persistIncidentReopened.incidentId
      }
      on persistIncidentsLinked: command PersistIncidentsLinked is {
        update IncidentData.incidents set linkedIncidentId = persistIncidentsLinked.linkedIncidentId, linkType = persistIncidentsLinked.linkType, linkedAt = persistIncidentsLinked.linkedAt where incidentId == persistIncidentsLinked.incidentId
      }
      on persistNoteAdded: command PersistNoteAdded is {
        update IncidentData.incidents set note = persistNoteAdded.note where incidentId == persistNoteAdded.incidentId
      }
      on persistPriorityDowngraded: command PersistPriorityDowngraded is {
        update IncidentData.incidents set oldPriority = persistPriorityDowngraded.oldPriority, newPriority = persistPriorityDowngraded.newPriority, reason = persistPriorityDowngraded.reason, downgradedAt = persistPriorityDowngraded.downgradedAt where incidentId == persistPriorityDowngraded.incidentId
      }
      on persistPriorityUpgraded: command PersistPriorityUpgraded is {
        update IncidentData.incidents set oldPriority = persistPriorityUpgraded.oldPriority, newPriority = persistPriorityUpgraded.newPriority, reason = persistPriorityUpgraded.reason, upgradedAt = persistPriorityUpgraded.upgradedAt where incidentId == persistPriorityUpgraded.incidentId
      }
      on persistUnitRecalled: command PersistUnitRecalled is {
        update IncidentData.incidents set unitId = persistUnitRecalled.unitId, reason = persistUnitRecalled.reason, recalledAt = persistUnitRecalled.recalledAt where incidentId == persistUnitRecalled.incidentId
      }
      on persistIncidentCancelled: command PersistIncidentCancelled is {
        update IncidentData.incidents set reason = persistIncidentCancelled.reason, cancelledBy = persistIncidentCancelled.cancelledBy, cancelledAt = persistIncidentCancelled.cancelledAt where incidentId == persistIncidentCancelled.incidentId
      }
      on persistIncidentClosed: command PersistIncidentClosed is {
        update IncidentData.incidents set disposition = persistIncidentClosed.disposition, closedBy = persistIncidentClosed.closedBy, closedAt = persistIncidentClosed.closedAt where incidentId == persistIncidentClosed.incidentId
      }
      on persistIncidentCreated: command PersistIncidentCreated is {
        update IncidentData.incidents set call = persistIncidentCreated.call, details = persistIncidentCreated.details, createdBy = persistIncidentCreated.createdBy, createdAt = persistIncidentCreated.createdAt where incidentId == persistIncidentCreated.incidentId
      }
      on persistUnitArrived: command PersistUnitArrived is {
        update IncidentData.incidents set unitId = persistUnitArrived.unitId, arrivedAt = persistUnitArrived.arrivedAt where incidentId == persistUnitArrived.incidentId
      }
      on persistUnitCleared: command PersistUnitCleared is {
        update IncidentData.incidents set unitId = persistUnitCleared.unitId, disposition = persistUnitCleared.disposition, clearedAt = persistUnitCleared.clearedAt where incidentId == persistUnitCleared.incidentId
      }
      on persistUnitDispatched: command PersistUnitDispatched is {
        update IncidentData.incidents set unitId = persistUnitDispatched.unitId, dispatchedBy = persistUnitDispatched.dispatchedBy, dispatchedAt = persistUnitDispatched.dispatchedAt where incidentId == persistUnitDispatched.incidentId
      }
      on persistUnitEnRoute: command PersistUnitEnRoute is {
        update IncidentData.incidents set unitId = persistUnitEnRoute.unitId, enRouteAt = persistUnitEnRoute.enRouteAt where incidentId == persistUnitEnRoute.incidentId
      }
      on query GetBoardData is {
        let boardDataView: type BoardDataView = prompt("read the board data projection")
        reply boardDataView
      }
      on query GetAnalyticsData is {
        let analyticsDataView: type AnalyticsDataView = prompt("read the analytics data projection")
        reply analyticsDataView
      }
      on query FindIncidentById is {
        let incidentResult: type IncidentResult = prompt("read the incident from the store")
        reply incidentResult
      }
      on query SearchIncidents is {
        let incidentsResult: type IncidentsResult = prompt("read the incidents from the store")
        reply incidentsResult
      }
      on query FindActiveIncidents is {
        let incidentResult: type IncidentResult = prompt("read the incident from the store")
        reply incidentResult
      }
      on query FindIncidentsByUnit is {
        let incidentResult: type IncidentResult = prompt("read the incident from the store")
        reply incidentResult
      }
      on query FindIncidentsByLocation is {
        let incidentResult: type IncidentResult = prompt("read the incident from the store")
        reply incidentResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes incident queries.
      }
    }
  } with {
    briefly "Incident repository"
    described as {
      |Persistence for incident records.
    }
  }
  // Projector for dispatch board
  query GetBoardData replies result BoardDataView is {
    boardDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which board data to retrieve.
      }
    }
  } with {
    briefly "Get board data"
    described as {
      |Retrieves the board data projection.
    }
  }
  result BoardDataView is {
    boardData: DispatchBoard.BoardData with {
      briefly "Board data"
      described as {
        |The board data being returned.
      }
    }
  } with {
    briefly "Board data view"
    described as {
      |Read model view carrying the board data projection.
    }
  }
  projector DispatchBoard as flow is {
    updates repository IncidentContext.IncidentRepository
    outlet DispatchBoardToRepository is type IncidentRepositoryCommand
    inlet DispatchBoardFromIncident is type IncidentEvent    record BoardData is {
      activeIncidents: ActiveIncidentSummary+ with {
        briefly "Active"
        described as {
          |Active incidents.
        }
      }
      pendingUnits: UnitSummary+ with {
        briefly "Pending"
        described as {
          |Units waiting dispatch.
        }
      }
      boardDispatchedUnits: UnitSummary+ with {
        briefly "Dispatched"
        described as {
          |Units on calls.
        }
      }
      availableUnits: UnitSummary+ with {
        briefly "Available"
        described as {
          |Available units.
        }
      }
    } with {
      briefly "Board data"
      described as {
        |Dispatch board display data.
      }
    }
    record ActiveIncidentSummary is {
      incidentId: IncidentId with {
        briefly "Incident"
        described as {
          |Incident ID.
        }
      }
      summaryPriority: IncidentPriority with {
        briefly "Priority"
        described as {
          |Priority level.
        }
      }
      summaryIncidentType: IncidentType with {
        briefly "Type"
        described as {
          |Incident type.
        }
      }
      summaryLocation: String(1,200) with {
        briefly "Location"
        described as {
          |Location summary.
        }
      }
      summaryStatus: IncidentStatus with {
        briefly "Status"
        described as {
          |Current status.
        }
      }
      unitsAssigned: Natural with {
        briefly "Units"
        described as {
          |Units assigned.
        }
      }
      elapsedMinutes: Natural with {
        briefly "Elapsed"
        described as {
          |Minutes since creation.
        }
      }
    } with {
      briefly "Incident summary"
      described as {
        |Summary for dispatch board.
      }
    }
    record UnitSummary is {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
      unitNumber: String(1,20) with {
        briefly "Number"
        described as {
          |Unit number.
        }
      }
      summaryUnitType: UnitType with {
        briefly "Type"
        described as {
          |Unit type.
        }
      }
      summaryUnitStatus: UnitStatus with {
        briefly "Status"
        described as {
          |Current status.
        }
      }
      currentCall: IncidentId? with {
        briefly "Call"
        described as {
          |Current incident.
        }
      }
    } with {
      briefly "Unit summary"
      described as {
        |Unit status summary.
      }
    }
    handler BoardHandler is {
      on incidentDetailsUpdated: event Incident.IncidentDetailsUpdated is {
        tell command IncidentContext.IncidentRepository.PersistIncidentDetailsUpdated(incidentId = incidentDetailsUpdated.incidentId, details = incidentDetailsUpdated.details, updatedAt = incidentDetailsUpdated.updatedAt) to repository IncidentContext.IncidentRepository
        do "apply IncidentDetailsUpdated to the DispatchBoard projection"
      }
      on incidentReopened: event Incident.IncidentReopened is {
        tell command IncidentContext.IncidentRepository.PersistIncidentReopened(incidentId = incidentReopened.incidentId, reason = incidentReopened.reason, reopenedBy = incidentReopened.reopenedBy, reopenedAt = incidentReopened.reopenedAt) to repository IncidentContext.IncidentRepository
        do "apply IncidentReopened to the DispatchBoard projection"
      }
      on incidentsLinked: event Incident.IncidentsLinked is {
        tell command IncidentContext.IncidentRepository.PersistIncidentsLinked(incidentId = incidentsLinked.incidentId, linkedIncidentId = incidentsLinked.linkedIncidentId, linkType = incidentsLinked.linkType, linkedAt = incidentsLinked.linkedAt) to repository IncidentContext.IncidentRepository
        do "apply IncidentsLinked to the DispatchBoard projection"
      }
      on noteAdded: event Incident.NoteAdded is {
        tell command IncidentContext.IncidentRepository.PersistNoteAdded(incidentId = noteAdded.incidentId, note = noteAdded.note) to repository IncidentContext.IncidentRepository
        do "apply NoteAdded to the DispatchBoard projection"
      }
      on priorityDowngraded: event Incident.PriorityDowngraded is {
        tell command IncidentContext.IncidentRepository.PersistPriorityDowngraded(incidentId = priorityDowngraded.incidentId, oldPriority = priorityDowngraded.oldPriority, newPriority = priorityDowngraded.newPriority, reason = priorityDowngraded.reason, downgradedAt = priorityDowngraded.downgradedAt) to repository IncidentContext.IncidentRepository
        do "apply PriorityDowngraded to the DispatchBoard projection"
      }
      on priorityUpgraded: event Incident.PriorityUpgraded is {
        tell command IncidentContext.IncidentRepository.PersistPriorityUpgraded(incidentId = priorityUpgraded.incidentId, oldPriority = priorityUpgraded.oldPriority, newPriority = priorityUpgraded.newPriority, reason = priorityUpgraded.reason, upgradedAt = priorityUpgraded.upgradedAt) to repository IncidentContext.IncidentRepository
        do "apply PriorityUpgraded to the DispatchBoard projection"
      }
      on unitRecalled: event Incident.UnitRecalled is {
        tell command IncidentContext.IncidentRepository.PersistUnitRecalled(incidentId = unitRecalled.incidentId, unitId = unitRecalled.unitId, reason = unitRecalled.reason, recalledAt = unitRecalled.recalledAt) to repository IncidentContext.IncidentRepository
        do "apply UnitRecalled to the DispatchBoard projection"
      }
      on incidentCreated: event Incident.IncidentCreated is {
        tell command IncidentContext.IncidentRepository.PersistIncidentCreated(incidentId = incidentCreated.incidentId, call = incidentCreated.call, details = incidentCreated.details, createdBy = incidentCreated.createdBy, createdAt = incidentCreated.createdAt) to repository IncidentContext.IncidentRepository
      }
      on unitDispatched: event Incident.UnitDispatched is {
        tell command IncidentContext.IncidentRepository.PersistUnitDispatched(incidentId = unitDispatched.incidentId, unitId = unitDispatched.unitId, dispatchedBy = unitDispatched.dispatchedBy, dispatchedAt = unitDispatched.dispatchedAt) to repository IncidentContext.IncidentRepository
      }
      on unitEnRoute: event Incident.UnitEnRoute is {
        tell command IncidentContext.IncidentRepository.PersistUnitEnRoute(incidentId = unitEnRoute.incidentId, unitId = unitEnRoute.unitId, enRouteAt = unitEnRoute.enRouteAt) to repository IncidentContext.IncidentRepository
      }
      on unitArrived: event Incident.UnitArrived is {
        tell command IncidentContext.IncidentRepository.PersistUnitArrived(incidentId = unitArrived.incidentId, unitId = unitArrived.unitId, arrivedAt = unitArrived.arrivedAt) to repository IncidentContext.IncidentRepository
      }
      on unitCleared: event Incident.UnitCleared is {
        tell command IncidentContext.IncidentRepository.PersistUnitCleared(incidentId = unitCleared.incidentId, unitId = unitCleared.unitId, disposition = unitCleared.disposition, clearedAt = unitCleared.clearedAt) to repository IncidentContext.IncidentRepository
      }
      on incidentClosed: event Incident.IncidentClosed is {
        tell command IncidentContext.IncidentRepository.PersistIncidentClosed(incidentId = incidentClosed.incidentId, disposition = incidentClosed.disposition, closedBy = incidentClosed.closedBy, closedAt = incidentClosed.closedAt) to repository IncidentContext.IncidentRepository
      }
      on incidentCancelled: event Incident.IncidentCancelled is {
        tell command IncidentContext.IncidentRepository.PersistIncidentCancelled(incidentId = incidentCancelled.incidentId, reason = incidentCancelled.reason, cancelledBy = incidentCancelled.cancelledBy, cancelledAt = incidentCancelled.cancelledAt) to repository IncidentContext.IncidentRepository
      }
      on unitLocationRecorded: event Incident.UnitLocationRecorded is {
        do "a unit location recorded changes nothing this projector keeps"
      }
    } with {
      briefly "Processes board events"
      described as {
        |Updates dispatch board from events.
      }
    }
  } with {
    briefly "Dispatch board"
    described as {
      |Projects real-time dispatch status.
    }
  }
  // Projector for response time analytics
  query GetAnalyticsData replies result AnalyticsDataView is {
    analyticsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which analytics data to retrieve.
      }
    }
  } with {
    briefly "Get analytics data"
    described as {
      |Retrieves the analytics data projection.
    }
  }
  result AnalyticsDataView is {
    analyticsData: ResponseTimeAnalytics.AnalyticsData with {
      briefly "Analytics data"
      described as {
        |The analytics data being returned.
      }
    }
  } with {
    briefly "Analytics data view"
    described as {
      |Read model view carrying the analytics data projection.
    }
  }
  projector ResponseTimeAnalytics as flow is {
    updates repository IncidentContext.IncidentRepository
    outlet ResponseTimeAnalyticsToRepository is type IncidentRepositoryCommand
 with {
      briefly "What ResponseTimeAnalytics publishes to IncidentRepository"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to IncidentRepository needs this port to travel on.
      }
    }
    inlet ResponseTimeAnalyticsFromIncident is type IncidentEvent    record AnalyticsData is {
      averageDispatchTime: Decimal(6,2) with {
        briefly "Dispatch time"
        described as {
          |Average dispatch time (seconds).
        }
      }
      averageEnRouteTime: Decimal(6,2) with {
        briefly "En route time"
        described as {
          |Average time to go en route (seconds).
        }
      }
      averageResponseTime: Decimal(6,2) with {
        briefly "Response time"
        described as {
          |Average total response time (seconds).
        }
      }
      averageOnSceneTime: Decimal(6,2) with {
        briefly "On scene time"
        described as {
          |Average time on scene (minutes).
        }
      }
      incidentsByPriority: PriorityMetrics+ with {
        briefly "By priority"
        described as {
          |Metrics by priority level.
        }
      }
      incidentsByType: TypeMetrics+ with {
        briefly "By type"
        described as {
          |Metrics by incident type.
        }
      }
    } with {
      briefly "Analytics data"
      described as {
        |Response time metrics.
      }
    }
    record PriorityMetrics is {
      metricPriority: IncidentPriority with {
        briefly "Priority"
        described as {
          |Priority level.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Incident count.
        }
      }
      avgResponseSeconds: Decimal(6,2) with {
        briefly "Avg response"
        described as {
          |Average response time.
        }
      }
    } with {
      briefly "Priority metrics"
      described as {
        |Metrics for priority level.
      }
    }
    record TypeMetrics is {
      metricIncidentType: IncidentType with {
        briefly "Type"
        described as {
          |Incident type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Incident count.
        }
      }
      avgResponseSeconds: Decimal(6,2) with {
        briefly "Avg response"
        described as {
          |Average response time.
        }
      }
    } with {
      briefly "Type metrics"
      described as {
        |Metrics for incident type.
      }
    }
    handler AnalyticsHandler is {
      on incidentCancelled: event Incident.IncidentCancelled is {
        tell command IncidentContext.IncidentRepository.PersistIncidentCancelled(incidentId = incidentCancelled.incidentId, reason = incidentCancelled.reason, cancelledBy = incidentCancelled.cancelledBy, cancelledAt = incidentCancelled.cancelledAt) to repository IncidentContext.IncidentRepository
        do "apply IncidentCancelled to the ResponseTimeAnalytics projection"
      }
      on incidentDetailsUpdated: event Incident.IncidentDetailsUpdated is {
        tell command IncidentContext.IncidentRepository.PersistIncidentDetailsUpdated(incidentId = incidentDetailsUpdated.incidentId, details = incidentDetailsUpdated.details, updatedAt = incidentDetailsUpdated.updatedAt) to repository IncidentContext.IncidentRepository
        do "apply IncidentDetailsUpdated to the ResponseTimeAnalytics projection"
      }
      on incidentReopened: event Incident.IncidentReopened is {
        tell command IncidentContext.IncidentRepository.PersistIncidentReopened(incidentId = incidentReopened.incidentId, reason = incidentReopened.reason, reopenedBy = incidentReopened.reopenedBy, reopenedAt = incidentReopened.reopenedAt) to repository IncidentContext.IncidentRepository
        do "apply IncidentReopened to the ResponseTimeAnalytics projection"
      }
      on incidentsLinked: event Incident.IncidentsLinked is {
        tell command IncidentContext.IncidentRepository.PersistIncidentsLinked(incidentId = incidentsLinked.incidentId, linkedIncidentId = incidentsLinked.linkedIncidentId, linkType = incidentsLinked.linkType, linkedAt = incidentsLinked.linkedAt) to repository IncidentContext.IncidentRepository
        do "apply IncidentsLinked to the ResponseTimeAnalytics projection"
      }
      on noteAdded: event Incident.NoteAdded is {
        tell command IncidentContext.IncidentRepository.PersistNoteAdded(incidentId = noteAdded.incidentId, note = noteAdded.note) to repository IncidentContext.IncidentRepository
        do "apply NoteAdded to the ResponseTimeAnalytics projection"
      }
      on priorityDowngraded: event Incident.PriorityDowngraded is {
        tell command IncidentContext.IncidentRepository.PersistPriorityDowngraded(incidentId = priorityDowngraded.incidentId, oldPriority = priorityDowngraded.oldPriority, newPriority = priorityDowngraded.newPriority, reason = priorityDowngraded.reason, downgradedAt = priorityDowngraded.downgradedAt) to repository IncidentContext.IncidentRepository
        do "apply PriorityDowngraded to the ResponseTimeAnalytics projection"
      }
      on priorityUpgraded: event Incident.PriorityUpgraded is {
        tell command IncidentContext.IncidentRepository.PersistPriorityUpgraded(incidentId = priorityUpgraded.incidentId, oldPriority = priorityUpgraded.oldPriority, newPriority = priorityUpgraded.newPriority, reason = priorityUpgraded.reason, upgradedAt = priorityUpgraded.upgradedAt) to repository IncidentContext.IncidentRepository
        do "apply PriorityUpgraded to the ResponseTimeAnalytics projection"
      }
      on unitCleared: event Incident.UnitCleared is {
        tell command IncidentContext.IncidentRepository.PersistUnitCleared(incidentId = unitCleared.incidentId, unitId = unitCleared.unitId, disposition = unitCleared.disposition, clearedAt = unitCleared.clearedAt) to repository IncidentContext.IncidentRepository
        do "apply UnitCleared to the ResponseTimeAnalytics projection"
      }
      on unitRecalled: event Incident.UnitRecalled is {
        tell command IncidentContext.IncidentRepository.PersistUnitRecalled(incidentId = unitRecalled.incidentId, unitId = unitRecalled.unitId, reason = unitRecalled.reason, recalledAt = unitRecalled.recalledAt) to repository IncidentContext.IncidentRepository
        do "apply UnitRecalled to the ResponseTimeAnalytics projection"
      }
      on incidentCreated: event Incident.IncidentCreated is {
        tell command IncidentContext.IncidentRepository.PersistIncidentCreated(incidentId = incidentCreated.incidentId, call = incidentCreated.call, details = incidentCreated.details, createdBy = incidentCreated.createdBy, createdAt = incidentCreated.createdAt) to repository IncidentContext.IncidentRepository
      }
      on unitDispatched: event Incident.UnitDispatched is {
        tell command IncidentContext.IncidentRepository.PersistUnitDispatched(incidentId = unitDispatched.incidentId, unitId = unitDispatched.unitId, dispatchedBy = unitDispatched.dispatchedBy, dispatchedAt = unitDispatched.dispatchedAt) to repository IncidentContext.IncidentRepository
      }
      on unitEnRoute: event Incident.UnitEnRoute is {
        tell command IncidentContext.IncidentRepository.PersistUnitEnRoute(incidentId = unitEnRoute.incidentId, unitId = unitEnRoute.unitId, enRouteAt = unitEnRoute.enRouteAt) to repository IncidentContext.IncidentRepository
      }
      on unitArrived: event Incident.UnitArrived is {
        tell command IncidentContext.IncidentRepository.PersistUnitArrived(incidentId = unitArrived.incidentId, unitId = unitArrived.unitId, arrivedAt = unitArrived.arrivedAt) to repository IncidentContext.IncidentRepository
      }
      on incidentClosed: event Incident.IncidentClosed is {
        tell command IncidentContext.IncidentRepository.PersistIncidentClosed(incidentId = incidentClosed.incidentId, disposition = incidentClosed.disposition, closedBy = incidentClosed.closedBy, closedAt = incidentClosed.closedAt) to repository IncidentContext.IncidentRepository
      }
      on unitLocationRecorded: event Incident.UnitLocationRecorded is {
        do "a unit location recorded changes nothing this projector keeps"
      }
    } with {
      briefly "Processes analytics events"
      described as {
        |Updates response time analytics.
      }
    }
  } with {
    briefly "Response time analytics"
    described as {
      |Projects response time metrics for reporting.
    }
  }
  // ---- Event publication for Incident ----
  type IncidentEvent is one of {
    IncidentContext.Incident.IncidentCreated or IncidentContext.Incident.IncidentDetailsUpdated or IncidentContext.Incident.UnitDispatched or IncidentContext.Incident.UnitRecalled or IncidentContext.Incident.UnitEnRoute or IncidentContext.Incident.UnitArrived or IncidentContext.Incident.UnitCleared or IncidentContext.Incident.NoteAdded or IncidentContext.Incident.PriorityUpgraded or IncidentContext.Incident.PriorityDowngraded or IncidentContext.Incident.IncidentsLinked or IncidentContext.Incident.IncidentClosed or IncidentContext.Incident.IncidentCancelled or IncidentContext.Incident.IncidentReopened or IncidentContext.Incident.UnitLocationRecorded
  } with {
    briefly "Incident event alternation"
    described as {
      |Union of all Incident events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet IncidentEventSplit as split is {
    outlet IncidentEventSplitToToRadioService is type IncidentEvent
    outlet IncidentEventSplitToToRMSService is type IncidentEvent
    outlet IncidentEventSplitToToMDTService is type IncidentEvent
    outlet IncidentEventSplitToToGISService is type IncidentEvent
    outlet IncidentEventSplitToToE911Service is type IncidentEvent
    outlet IncidentEventSplitToToAVLService is type IncidentEvent
    inlet IncidentEventSplitIn is type IncidentEvent    outlet IncidentEventSplitToDispatchBoard is type IncidentEvent
    outlet IncidentEventSplitToResponseTimeAnalytics is type IncidentEvent
    handler IncidentEventSplitHandler is {
      on incidentCreated: event Incident.IncidentCreated is {
        send incidentCreated to outlet IncidentEventSplitToDispatchBoard
        send incidentCreated to outlet IncidentEventSplitToResponseTimeAnalytics
        send incidentCreated to outlet IncidentEventSplitToToRadioService
        send incidentCreated to outlet IncidentEventSplitToToRMSService
        send incidentCreated to outlet IncidentEventSplitToToGISService
        send incidentCreated to outlet IncidentEventSplitToToAVLService
        tell incidentCreated to entity IncidentContext.Incident
      }
      on incidentDetailsUpdated: event Incident.IncidentDetailsUpdated is {
        send incidentDetailsUpdated to outlet IncidentEventSplitToDispatchBoard
        send incidentDetailsUpdated to outlet IncidentEventSplitToResponseTimeAnalytics
        send incidentDetailsUpdated to outlet IncidentEventSplitToToGISService
        send incidentDetailsUpdated to outlet IncidentEventSplitToToE911Service
        tell incidentDetailsUpdated to entity IncidentContext.Incident
      }
      on unitDispatched: event Incident.UnitDispatched is {
        send unitDispatched to outlet IncidentEventSplitToDispatchBoard
        send unitDispatched to outlet IncidentEventSplitToResponseTimeAnalytics
        send unitDispatched to outlet IncidentEventSplitToToMDTService
        send unitDispatched to outlet IncidentEventSplitToToGISService
        tell unitDispatched to entity IncidentContext.Incident
      }
      on unitRecalled: event Incident.UnitRecalled is {
        send unitRecalled to outlet IncidentEventSplitToDispatchBoard
        send unitRecalled to outlet IncidentEventSplitToResponseTimeAnalytics
        tell unitRecalled to entity IncidentContext.Incident
      }
      on unitEnRoute: event Incident.UnitEnRoute is {
        send unitEnRoute to outlet IncidentEventSplitToDispatchBoard
        send unitEnRoute to outlet IncidentEventSplitToResponseTimeAnalytics
        send unitEnRoute to outlet IncidentEventSplitToToAVLService
        tell unitEnRoute to entity IncidentContext.Incident
      }
      on unitArrived: event Incident.UnitArrived is {
        send unitArrived to outlet IncidentEventSplitToDispatchBoard
        send unitArrived to outlet IncidentEventSplitToResponseTimeAnalytics
        send unitArrived to outlet IncidentEventSplitToToRMSService
        tell unitArrived to entity IncidentContext.Incident
      }
      on unitCleared: event Incident.UnitCleared is {
        send unitCleared to outlet IncidentEventSplitToDispatchBoard
        send unitCleared to outlet IncidentEventSplitToResponseTimeAnalytics
        tell unitCleared to entity IncidentContext.Incident
      }
      on noteAdded: event Incident.NoteAdded is {
        send noteAdded to outlet IncidentEventSplitToDispatchBoard
        send noteAdded to outlet IncidentEventSplitToResponseTimeAnalytics
        send noteAdded to outlet IncidentEventSplitToToMDTService
        tell noteAdded to entity IncidentContext.Incident
      }
      on priorityUpgraded: event Incident.PriorityUpgraded is {
        send priorityUpgraded to outlet IncidentEventSplitToDispatchBoard
        send priorityUpgraded to outlet IncidentEventSplitToResponseTimeAnalytics
        send priorityUpgraded to outlet IncidentEventSplitToToGISService
        tell priorityUpgraded to entity IncidentContext.Incident
      }
      on priorityDowngraded: event Incident.PriorityDowngraded is {
        send priorityDowngraded to outlet IncidentEventSplitToDispatchBoard
        send priorityDowngraded to outlet IncidentEventSplitToResponseTimeAnalytics
        tell priorityDowngraded to entity IncidentContext.Incident
      }
      on incidentsLinked: event Incident.IncidentsLinked is {
        send incidentsLinked to outlet IncidentEventSplitToDispatchBoard
        send incidentsLinked to outlet IncidentEventSplitToResponseTimeAnalytics
        tell incidentsLinked to entity IncidentContext.Incident by incidentId
      }
      on incidentClosed: event Incident.IncidentClosed is {
        send incidentClosed to outlet IncidentEventSplitToDispatchBoard
        send incidentClosed to outlet IncidentEventSplitToResponseTimeAnalytics
        tell incidentClosed to entity IncidentContext.Incident
      }
      on incidentCancelled: event Incident.IncidentCancelled is {
        send incidentCancelled to outlet IncidentEventSplitToDispatchBoard
        send incidentCancelled to outlet IncidentEventSplitToResponseTimeAnalytics
        tell incidentCancelled to entity IncidentContext.Incident
      }
      on incidentReopened: event Incident.IncidentReopened is {
        send incidentReopened to outlet IncidentEventSplitToDispatchBoard
        send incidentReopened to outlet IncidentEventSplitToResponseTimeAnalytics
        tell incidentReopened to entity IncidentContext.Incident
      }
      on unitLocationRecorded: event Incident.UnitLocationRecorded is {
        send unitLocationRecorded to outlet IncidentEventSplitToDispatchBoard
        send unitLocationRecorded to outlet IncidentEventSplitToResponseTimeAnalytics
        tell unitLocationRecorded to entity IncidentContext.Incident
      }
      on other is {
        error "Unexpected message for processor IncidentEventSplit"
      }
    } with {
      briefly "Incident event fan-out handler"
      described as {
        |Delivers each Incident event to all of its consumers.
      }
    }
  } with {
    briefly "Incident event fan-out"
    described as {
      |Fans Incident events out to the repository and projectors.
    }
  }
  connector 'ToRadioService Feed' is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToToRadioService to inlet IncidentContext.ToRadioService.ToRadioServiceIn with {
    briefly "The Incident events ToRadioService translates, on their way to it"
  }
  connector 'ToRMSService Feed' is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToToRMSService to inlet IncidentContext.ToRMSService.ToRMSServiceIn with {
    briefly "The Incident events ToRMSService translates, on their way to it"
  }
  connector 'ToMDTService Feed' is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToToMDTService to inlet IncidentContext.ToMDTService.ToMDTServiceIn with {
    briefly "The Incident events ToMDTService translates, on their way to it"
  }
  connector 'ToGISService Feed' is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToToGISService to inlet IncidentContext.ToGISService.ToGISServiceIn with {
    briefly "The Incident events ToGISService translates, on their way to it"
  }
  connector 'ToE911Service Feed' is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToToE911Service to inlet IncidentContext.ToE911Service.ToE911ServiceIn with {
    briefly "The Incident events ToE911Service translates, on their way to it"
  }
  connector 'ToAVLService Feed' is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToToAVLService to inlet IncidentContext.ToAVLService.ToAVLServiceIn with {
    briefly "The Incident events ToAVLService translates, on their way to it"
  }
  connector 'IncidentEvent Stream' is from outlet IncidentContext.Incident.IncidentEvents2 to inlet IncidentContext.IncidentEventSplit.IncidentEventSplitIn with {
    briefly "Incident events, fanned out to storage and read models"
  }
  connector 'DispatchBoard Feed' is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToDispatchBoard to inlet IncidentContext.DispatchBoard.DispatchBoardFromIncident with {
    briefly "Incident events feeding the DispatchBoard projection"
  }
  connector 'ResponseTimeAnalytics Feed' is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToResponseTimeAnalytics to inlet IncidentContext.ResponseTimeAnalytics.ResponseTimeAnalyticsFromIncident with {
    briefly "Incident events feeding the ResponseTimeAnalytics projection"
  }
  connector 'DispatchBoard Storage' is from outlet IncidentContext.DispatchBoard.DispatchBoardToRepository to inlet IncidentContext.IncidentRepository.IncidentRepositoryFromDispatchBoard with {
    briefly "DispatchBoard updates on their way to storage"
  }
} with {
  briefly "Incident context"
  described as {
    | The Incident context manages emergency incidents
    | and dispatch operations.
  }
}
