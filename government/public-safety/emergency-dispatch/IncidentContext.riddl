// Emergency Dispatch - Incident Context
context IncidentContext is {
  adaptor FromAVLService from context AVLService is { 
    handler FromAVLServiceHandler is {
      on result AVLService.NearestUnitsResult is {
        do "the model receives nearest units result"
      }
      on result AVLService.UnitLocationResult is {
        do "the model receives unit location result"
      }
      on event AVLService.UnitLocationUpdated is {
        do "the model receives unit location updated"
      }
      on other is {
        error "Unexpected message for adaptor FromAVLService"
      }
    } with {
      briefly "from avl service"
      described as {
        |Carries messages from the external AVLService.
      }
    }
  } with {
    briefly "AVLService integration"
    described as {
      |The model's side of the AVLService conversation.
    }
  }
  adaptor ToAVLService to context AVLService is { 
    handler ToAVLServiceHandler is {
      on query AVLService.FindNearestUnits is {
        do "the model sends find nearest units"
      }
      on query AVLService.GetUnitLocation is {
        do "the model sends get unit location"
      }
      on other is {
        error "Unexpected message for adaptor ToAVLService"
      }
    } with {
      briefly "to avl service"
      described as {
        |Carries messages to the external AVLService.
      }
    }
  } with {
    briefly "AVLService integration"
    described as {
      |The model's side of the AVLService conversation.
    }
  }
  adaptor FromE911Service from context E911Service is { 
    handler FromE911ServiceHandler is {
      on event E911Service.CallAnswered is {
        do "the model receives call answered"
      }
      on event E911Service.CallEnded is {
        do "the model receives call ended"
      }
      on result E911Service.CallRecordingResult is {
        do "the model receives call recording result"
      }
      on event E911Service.IncomingCall is {
        do "the model receives incoming call"
      }
      on other is {
        error "Unexpected message for adaptor FromE911Service"
      }
    } with {
      briefly "from e 911 service"
      described as {
        |Carries messages from the external E911Service.
      }
    }
  } with {
    briefly "E911Service integration"
    described as {
      |The model's side of the E911Service conversation.
    }
  }
  adaptor ToE911Service to context E911Service is { 
    handler ToE911ServiceHandler is {
      on query E911Service.GetCallRecording is {
        do "the model sends get call recording"
      }
      on other is {
        error "Unexpected message for adaptor ToE911Service"
      }
    } with {
      briefly "to e 911 service"
      described as {
        |Carries messages to the external E911Service.
      }
    }
  } with {
    briefly "E911Service integration"
    described as {
      |The model's side of the E911Service conversation.
    }
  }
  adaptor FromGISService from context GISService is { 
    handler FromGISServiceHandler is {
      on result GISService.AddressResult is {
        do "the model receives address result"
      }
      on result GISService.CoordinatesResult is {
        do "the model receives coordinates result"
      }
      on result GISService.DispatchZoneResult is {
        do "the model receives dispatch zone result"
      }
      on result GISService.HazardsResult is {
        do "the model receives hazards result"
      }
      on other is {
        error "Unexpected message for adaptor FromGISService"
      }
    } with {
      briefly "from gis service"
      described as {
        |Carries messages from the external GISService.
      }
    }
  } with {
    briefly "GISService integration"
    described as {
      |The model's side of the GISService conversation.
    }
  }
  adaptor ToGISService to context GISService is { 
    handler ToGISServiceHandler is {
      on query GISService.GetAddressFromCoordinates is {
        do "the model sends get address from coordinates"
      }
      on query GISService.GetCoordinatesFromAddress is {
        do "the model sends get coordinates from address"
      }
      on query GISService.GetDispatchZone is {
        do "the model sends get dispatch zone"
      }
      on query GISService.GetHazards is {
        do "the model sends get hazards"
      }
      on other is {
        error "Unexpected message for adaptor ToGISService"
      }
    } with {
      briefly "to gis service"
      described as {
        |Carries messages to the external GISService.
      }
    }
  } with {
    briefly "GISService integration"
    described as {
      |The model's side of the GISService conversation.
    }
  }
  adaptor FromMDTService from context MDTService is { 
    handler FromMDTServiceHandler is {
      on event MDTService.DispatchAcknowledged is {
        do "the model receives dispatch acknowledged"
      }
      on event MDTService.MessageReceived is {
        do "the model receives message received"
      }
      on other is {
        error "Unexpected message for adaptor FromMDTService"
      }
    } with {
      briefly "from mdt service"
      described as {
        |Carries messages from the external MDTService.
      }
    }
  } with {
    briefly "MDTService integration"
    described as {
      |The model's side of the MDTService conversation.
    }
  }
  adaptor ToMDTService to context MDTService is { 
    handler ToMDTServiceHandler is {
      on command MDTService.SendDispatchNotification is {
        do "the model sends send dispatch notification"
      }
      on command MDTService.SendUnitMessage is {
        do "the model sends send unit message"
      }
      on other is {
        error "Unexpected message for adaptor ToMDTService"
      }
    } with {
      briefly "to mdt service"
      described as {
        |Carries messages to the external MDTService.
      }
    }
  } with {
    briefly "MDTService integration"
    described as {
      |The model's side of the MDTService conversation.
    }
  }
  adaptor FromRMSService from context RMSService is { 
    handler FromRMSServiceHandler is {
      on result RMSService.LocationHistoryResult is {
        do "the model receives location history result"
      }
      on result RMSService.PersonWarningsResult is {
        do "the model receives person warnings result"
      }
      on other is {
        error "Unexpected message for adaptor FromRMSService"
      }
    } with {
      briefly "from rms service"
      described as {
        |Carries messages from the external RMSService.
      }
    }
  } with {
    briefly "RMSService integration"
    described as {
      |The model's side of the RMSService conversation.
    }
  }
  adaptor ToRMSService to context RMSService is { 
    handler ToRMSServiceHandler is {
      on query RMSService.GetLocationHistory is {
        do "the model sends get location history"
      }
      on query RMSService.GetPersonWarnings is {
        do "the model sends get person warnings"
      }
      on other is {
        error "Unexpected message for adaptor ToRMSService"
      }
    } with {
      briefly "to rms service"
      described as {
        |Carries messages to the external RMSService.
      }
    }
  } with {
    briefly "RMSService integration"
    described as {
      |The model's side of the RMSService conversation.
    }
  }
  adaptor FromRadioService from context RadioService is { 
    handler FromRadioServiceHandler is {
      on event RadioService.EmergencyButtonPressed is {
        do "the model receives emergency button pressed"
      }
      on event RadioService.TalkgroupAssigned is {
        do "the model receives talkgroup assigned"
      }
      on other is {
        error "Unexpected message for adaptor FromRadioService"
      }
    } with {
      briefly "from radio service"
      described as {
        |Carries messages from the external RadioService.
      }
    }
  } with {
    briefly "RadioService integration"
    described as {
      |The model's side of the RadioService conversation.
    }
  }
  adaptor ToRadioService to context RadioService is { 
    handler ToRadioServiceHandler is {
      on command RadioService.RequestTalkgroup is {
        do "the model sends request talkgroup"
      }
      on other is {
        error "Unexpected message for adaptor ToRadioService"
      }
    } with {
      briefly "to radio service"
      described as {
        |Carries messages to the external RadioService.
      }
    }
  } with {
    briefly "RadioService integration"
    described as {
      |The model's side of the RadioService conversation.
    }
  }
  include "types.riddl"
  include "Incident.riddl"
  // Repository
  repository IncidentRepository is {
    record StoredIncident is  {
      incidentId: IncidentId with {
        briefly "incidentId"
        described as {
          |The incidentId column of the stored incident row.
        }
      }
    } with {
      briefly "Stored incident row"
      described as {
        |The persistence shape of incident data as this repository stores it.
      }
    }
    schema IncidentData is relational
      of incidents as type StoredIncident
 with {
      briefly "Incident data schema"
      described as {
        |The relational schema persisting incident records for this repository.
      }
    }
    inlet IncidentRepositoryFromIncident is type IncidentEvent    inlet IncidentRepositoryFromDispatchBoard is type IncidentEvent    inlet IncidentRepositoryFromResponseTimeAnalytics is type IncidentEvent    outlet IncidentRepositoryResponses is type Incident.IncidentQueryResult
    query FindIncidentById is  {
      incidentId: IncidentId with {
        briefly "Incident"
        described as {
          |Incident identifier.
        }
      }
    } with {
      briefly "Find incident by ID"
      described as {
        |Retrieves incident by identifier.
      }
    }
    result IncidentResult is  {
      incident: Incident.ActiveStateData with {
        briefly "Incident"
        described as {
          |Incident data.
        }
      }
    } with {
      briefly "Incident result"
      described as {
        |Returns incident data.
      }
    }
    query SearchIncidents is  {
      filterStatus: IncidentStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      filterPriority: IncidentPriority? with {
        briefly "Priority"
        described as {
          |Filter by priority.
        }
      }
      filterIncidentType: IncidentType? with {
        briefly "Type"
        described as {
          |Filter by type.
        }
      }
      fromDate: Date? with {
        briefly "From"
        described as {
          |Start date filter.
        }
      }
      toDate: Date? with {
        briefly "To"
        described as {
          |End date filter.
        }
      }
    } with {
      briefly "Search incidents"
      described as {
        |Searches incidents by criteria.
      }
    }
    result IncidentsResult is  {
      matchingIncidents: Incident.ActiveStateData+ with {
        briefly "Incidents"
        described as {
          |Matching incidents.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Incidents result"
      described as {
        |Returns matching incidents.
      }
    }
    query FindActiveIncidents is  {
      activePriority: IncidentPriority? with {
        briefly "Priority"
        described as {
          |Filter by priority.
        }
      }
      zone: String(1,50)? with {
        briefly "Zone"
        described as {
          |Filter by dispatch zone.
        }
      }
    } with {
      briefly "Find active incidents"
      described as {
        |Finds all active incidents.
      }
    }
    query FindIncidentsByUnit is  {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit identifier.
        }
      }
      activeOnly: Boolean with {
        briefly "Active only"
        described as {
          |Only active incidents.
        }
      }
    } with {
      briefly "Find by unit"
      described as {
        |Finds incidents for a unit.
      }
    }
    query FindIncidentsByLocation is  {
      latitude: Decimal(9,6) with {
        briefly "Latitude"
        described as {
          |Center latitude.
        }
      }
      longitude: Decimal(10,6) with {
        briefly "Longitude"
        described as {
          |Center longitude.
        }
      }
      radiusMiles: Decimal(5,2) with {
        briefly "Radius"
        described as {
          |Search radius in miles.
        }
      }
    } with {
      briefly "Find by location"
      described as {
        |Finds incidents near a location.
      }
    }
    handler IncidentRepositoryHandler is {
      on query GetBoardData is {
        do "read the board data projection"
        yield result BoardDataView
      }
      on query GetAnalyticsData is {
        do "read the analytics data projection"
        yield result AnalyticsDataView
      }
      on query FindIncidentById is {
        yield result IncidentResult
      }
      on query SearchIncidents is {
        yield result IncidentsResult
      }
      on query FindActiveIncidents is {
        yield result IncidentResult
      }
      on query FindIncidentsByUnit is {
        yield result IncidentResult
      }
      on query FindIncidentsByLocation is {
        yield result IncidentResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes incident queries.
      }
    }
  } with {
    briefly "Incident repository"
    described as {
      |Persistence for incident records.
    }
  }
  // Projector for dispatch board
  query GetBoardData is  {
    boardDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which board data to retrieve.
      }
    }
  } with {
    briefly "Get board data"
    described as {
      |Retrieves the board data projection.
    }
  }
  result BoardDataView is  {
    boardData: DispatchBoard.BoardData with {
      briefly "Board data"
      described as {
        |The board data being returned.
      }
    }
  } with {
    briefly "Board data view"
    described as {
      |Read model view carrying the board data projection.
    }
  }
  projector DispatchBoard is {
    updates repository IncidentContext.IncidentRepository
    inlet DispatchBoardFromIncident is type IncidentEvent    outlet DispatchBoardOut is type IncidentEvent
    record BoardData is  {
      activeIncidents: ActiveIncidentSummary+ with {
        briefly "Active"
        described as {
          |Active incidents.
        }
      }
      pendingUnits: UnitSummary+ with {
        briefly "Pending"
        described as {
          |Units waiting dispatch.
        }
      }
      boardDispatchedUnits: UnitSummary+ with {
        briefly "Dispatched"
        described as {
          |Units on calls.
        }
      }
      availableUnits: UnitSummary+ with {
        briefly "Available"
        described as {
          |Available units.
        }
      }
    } with {
      briefly "Board data"
      described as {
        |Dispatch board display data.
      }
    }
    record ActiveIncidentSummary is  {
      incidentId: IncidentId with {
        briefly "Incident"
        described as {
          |Incident ID.
        }
      }
      summaryPriority: IncidentPriority with {
        briefly "Priority"
        described as {
          |Priority level.
        }
      }
      summaryIncidentType: IncidentType with {
        briefly "Type"
        described as {
          |Incident type.
        }
      }
      summaryLocation: String(1,200) with {
        briefly "Location"
        described as {
          |Location summary.
        }
      }
      summaryStatus: IncidentStatus with {
        briefly "Status"
        described as {
          |Current status.
        }
      }
      unitsAssigned: Natural with {
        briefly "Units"
        described as {
          |Units assigned.
        }
      }
      elapsedMinutes: Natural with {
        briefly "Elapsed"
        described as {
          |Minutes since creation.
        }
      }
    } with {
      briefly "Incident summary"
      described as {
        |Summary for dispatch board.
      }
    }
    record UnitSummary is  {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
      unitNumber: String(1,20) with {
        briefly "Number"
        described as {
          |Unit number.
        }
      }
      summaryUnitType: UnitType with {
        briefly "Type"
        described as {
          |Unit type.
        }
      }
      summaryUnitStatus: UnitStatus with {
        briefly "Status"
        described as {
          |Current status.
        }
      }
      currentCall: IncidentId? with {
        briefly "Call"
        described as {
          |Current incident.
        }
      }
    } with {
      briefly "Unit summary"
      described as {
        |Unit status summary.
      }
    }
    handler BoardHandler is {
      on event Incident.IncidentCreated is {
        tell event Incident.IncidentCreated to repository IncidentContext.IncidentRepository
      }
      on event Incident.UnitDispatched is {
        tell event Incident.UnitDispatched to repository IncidentContext.IncidentRepository
      }
      on event Incident.UnitEnRoute is {
        tell event Incident.UnitEnRoute to repository IncidentContext.IncidentRepository
      }
      on event Incident.UnitArrived is {
        tell event Incident.UnitArrived to repository IncidentContext.IncidentRepository
      }
      on event Incident.UnitCleared is {
        tell event Incident.UnitCleared to repository IncidentContext.IncidentRepository
      }
      on event Incident.IncidentClosed is {
        tell event Incident.IncidentClosed to repository IncidentContext.IncidentRepository
      }
      on event Incident.IncidentCancelled is {
        tell event Incident.IncidentCancelled to repository IncidentContext.IncidentRepository
      }
    } with {
      briefly "Processes board events"
      described as {
        |Updates dispatch board from events.
      }
    }
  } with {
    briefly "Dispatch board"
    described as {
      |Projects real-time dispatch status.
    }
  }
  // Projector for response time analytics
  query GetAnalyticsData is  {
    analyticsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which analytics data to retrieve.
      }
    }
  } with {
    briefly "Get analytics data"
    described as {
      |Retrieves the analytics data projection.
    }
  }
  result AnalyticsDataView is  {
    analyticsData: ResponseTimeAnalytics.AnalyticsData with {
      briefly "Analytics data"
      described as {
        |The analytics data being returned.
      }
    }
  } with {
    briefly "Analytics data view"
    described as {
      |Read model view carrying the analytics data projection.
    }
  }
  projector ResponseTimeAnalytics is {
    updates repository IncidentContext.IncidentRepository
    inlet ResponseTimeAnalyticsFromIncident is type IncidentEvent    outlet ResponseTimeAnalyticsOut is type IncidentEvent
    record AnalyticsData is  {
      averageDispatchTime: Decimal(6,2) with {
        briefly "Dispatch time"
        described as {
          |Average dispatch time (seconds).
        }
      }
      averageEnRouteTime: Decimal(6,2) with {
        briefly "En route time"
        described as {
          |Average time to go en route (seconds).
        }
      }
      averageResponseTime: Decimal(6,2) with {
        briefly "Response time"
        described as {
          |Average total response time (seconds).
        }
      }
      averageOnSceneTime: Decimal(6,2) with {
        briefly "On scene time"
        described as {
          |Average time on scene (minutes).
        }
      }
      incidentsByPriority: PriorityMetrics+ with {
        briefly "By priority"
        described as {
          |Metrics by priority level.
        }
      }
      incidentsByType: TypeMetrics+ with {
        briefly "By type"
        described as {
          |Metrics by incident type.
        }
      }
    } with {
      briefly "Analytics data"
      described as {
        |Response time metrics.
      }
    }
    record PriorityMetrics is  {
      metricPriority: IncidentPriority with {
        briefly "Priority"
        described as {
          |Priority level.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Incident count.
        }
      }
      avgResponseSeconds: Decimal(6,2) with {
        briefly "Avg response"
        described as {
          |Average response time.
        }
      }
    } with {
      briefly "Priority metrics"
      described as {
        |Metrics for priority level.
      }
    }
    record TypeMetrics is  {
      metricIncidentType: IncidentType with {
        briefly "Type"
        described as {
          |Incident type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Incident count.
        }
      }
      avgResponseSeconds: Decimal(6,2) with {
        briefly "Avg response"
        described as {
          |Average response time.
        }
      }
    } with {
      briefly "Type metrics"
      described as {
        |Metrics for incident type.
      }
    }
    handler AnalyticsHandler is {
      on event Incident.IncidentCreated is {
        tell event Incident.IncidentCreated to repository IncidentContext.IncidentRepository
      }
      on event Incident.UnitDispatched is {
        tell event Incident.UnitDispatched to repository IncidentContext.IncidentRepository
      }
      on event Incident.UnitEnRoute is {
        tell event Incident.UnitEnRoute to repository IncidentContext.IncidentRepository
      }
      on event Incident.UnitArrived is {
        tell event Incident.UnitArrived to repository IncidentContext.IncidentRepository
      }
      on event Incident.IncidentClosed is {
        tell event Incident.IncidentClosed to repository IncidentContext.IncidentRepository
      }
    } with {
      briefly "Processes analytics events"
      described as {
        |Updates response time analytics.
      }
    }
  } with {
    briefly "Response time analytics"
    described as {
      |Projects response time metrics for reporting.
    }
  }
  // ---- Event publication for Incident ----
  type IncidentEvent is one of {
    IncidentContext.Incident.IncidentCreated or IncidentContext.Incident.IncidentDetailsUpdated or IncidentContext.Incident.UnitDispatched or IncidentContext.Incident.UnitRecalled or IncidentContext.Incident.UnitEnRoute or IncidentContext.Incident.UnitArrived or IncidentContext.Incident.UnitCleared or IncidentContext.Incident.NoteAdded or IncidentContext.Incident.PriorityUpgraded or IncidentContext.Incident.PriorityDowngraded or IncidentContext.Incident.IncidentsLinked or IncidentContext.Incident.IncidentClosed or IncidentContext.Incident.IncidentCancelled or IncidentContext.Incident.IncidentReopened
  } with {
    briefly "Incident event alternation"
    described as {
      |Union of all Incident events, for streaming and event-sourced
      |persistence.
    }
  }
  processor IncidentEventSource as source is {
    outlet IncidentEvents is type IncidentEvent
    handler IncidentSourceHandler is {
      on event Incident.IncidentCreated is {
        send event Incident.IncidentCreated to outlet IncidentEvents
      }
      on event Incident.IncidentDetailsUpdated is {
        send event Incident.IncidentDetailsUpdated to outlet IncidentEvents
      }
      on event Incident.UnitDispatched is {
        send event Incident.UnitDispatched to outlet IncidentEvents
      }
      on event Incident.UnitRecalled is {
        send event Incident.UnitRecalled to outlet IncidentEvents
      }
      on event Incident.UnitEnRoute is {
        send event Incident.UnitEnRoute to outlet IncidentEvents
      }
      on event Incident.UnitArrived is {
        send event Incident.UnitArrived to outlet IncidentEvents
      }
      on event Incident.UnitCleared is {
        send event Incident.UnitCleared to outlet IncidentEvents
      }
      on event Incident.NoteAdded is {
        send event Incident.NoteAdded to outlet IncidentEvents
      }
      on event Incident.PriorityUpgraded is {
        send event Incident.PriorityUpgraded to outlet IncidentEvents
      }
      on event Incident.PriorityDowngraded is {
        send event Incident.PriorityDowngraded to outlet IncidentEvents
      }
      on event Incident.IncidentsLinked is {
        send event Incident.IncidentsLinked to outlet IncidentEvents
      }
      on event Incident.IncidentClosed is {
        send event Incident.IncidentClosed to outlet IncidentEvents
      }
      on event Incident.IncidentCancelled is {
        send event Incident.IncidentCancelled to outlet IncidentEvents
      }
      on event Incident.IncidentReopened is {
        send event Incident.IncidentReopened to outlet IncidentEvents
      }
      on other is {
        error "Unexpected message for source IncidentEventSource"
      }
    } with {
      briefly "Incident source handler"
      described as {
        |Publishes Incident events onto the outlet.
      }
    }
  } with {
    briefly "Incident event source"
    described as {
      |Publishes Incident entity events into the streaming topology.
    }
  }
  processor IncidentEventSink as sink is {
    inlet IncidentInlet is type IncidentEvent    handler IncidentSinkHandler is {
      on event Incident.IncidentCreated is {
        tell event Incident.IncidentCreated to repository IncidentContext.IncidentRepository
      }
      on event Incident.IncidentDetailsUpdated is {
        tell event Incident.IncidentDetailsUpdated to repository IncidentContext.IncidentRepository
      }
      on event Incident.UnitDispatched is {
        tell event Incident.UnitDispatched to repository IncidentContext.IncidentRepository
      }
      on event Incident.UnitRecalled is {
        tell event Incident.UnitRecalled to repository IncidentContext.IncidentRepository
      }
      on event Incident.UnitEnRoute is {
        tell event Incident.UnitEnRoute to repository IncidentContext.IncidentRepository
      }
      on event Incident.UnitArrived is {
        tell event Incident.UnitArrived to repository IncidentContext.IncidentRepository
      }
      on event Incident.UnitCleared is {
        tell event Incident.UnitCleared to repository IncidentContext.IncidentRepository
      }
      on event Incident.NoteAdded is {
        tell event Incident.NoteAdded to repository IncidentContext.IncidentRepository
      }
      on event Incident.PriorityUpgraded is {
        tell event Incident.PriorityUpgraded to repository IncidentContext.IncidentRepository
      }
      on event Incident.PriorityDowngraded is {
        tell event Incident.PriorityDowngraded to repository IncidentContext.IncidentRepository
      }
      on event Incident.IncidentsLinked is {
        tell event Incident.IncidentsLinked to repository IncidentContext.IncidentRepository
      }
      on event Incident.IncidentClosed is {
        tell event Incident.IncidentClosed to repository IncidentContext.IncidentRepository
      }
      on event Incident.IncidentCancelled is {
        tell event Incident.IncidentCancelled to repository IncidentContext.IncidentRepository
      }
      on event Incident.IncidentReopened is {
        tell event Incident.IncidentReopened to repository IncidentContext.IncidentRepository
      }
      on other is {
        error "Unexpected message for sink IncidentEventSink"
      }
    } with {
      briefly "Incident sink handler"
      described as {
        |Persists Incident events via the repository.
      }
    }
  } with {
    briefly "Incident event sink"
    described as {
      |Receives Incident events for persistence.
    }
  }
  connector IncidentEventFlow is from outlet IncidentContext.IncidentEventSource.IncidentEvents to inlet IncidentContext.IncidentEventSink.IncidentInlet with {
    briefly "Incident event flow"
    described as {
      |Connects the Incident source to its sink.
    }
  }
  processor IncidentEventSplit is {
    inlet IncidentEventSplitIn is type IncidentEvent    outlet IncidentEventSplitToIncidentRepository is type IncidentEvent
    outlet IncidentEventSplitToDispatchBoard is type IncidentEvent
    outlet IncidentEventSplitToResponseTimeAnalytics is type IncidentEvent
    handler IncidentEventSplitHandler is {
      on event Incident.IncidentCreated is {
        send event Incident.IncidentCreated to outlet IncidentEventSplitToIncidentRepository
        send event Incident.IncidentCreated to outlet IncidentEventSplitToDispatchBoard
        send event Incident.IncidentCreated to outlet IncidentEventSplitToResponseTimeAnalytics
        tell event Incident.IncidentCreated to entity IncidentContext.Incident
      }
      on event Incident.IncidentDetailsUpdated is {
        send event Incident.IncidentDetailsUpdated to outlet IncidentEventSplitToIncidentRepository
        send event Incident.IncidentDetailsUpdated to outlet IncidentEventSplitToDispatchBoard
        send event Incident.IncidentDetailsUpdated to outlet IncidentEventSplitToResponseTimeAnalytics
        tell event Incident.IncidentDetailsUpdated to entity IncidentContext.Incident
      }
      on event Incident.UnitDispatched is {
        send event Incident.UnitDispatched to outlet IncidentEventSplitToIncidentRepository
        send event Incident.UnitDispatched to outlet IncidentEventSplitToDispatchBoard
        send event Incident.UnitDispatched to outlet IncidentEventSplitToResponseTimeAnalytics
        tell event Incident.UnitDispatched to entity IncidentContext.Incident
      }
      on event Incident.UnitRecalled is {
        send event Incident.UnitRecalled to outlet IncidentEventSplitToIncidentRepository
        send event Incident.UnitRecalled to outlet IncidentEventSplitToDispatchBoard
        send event Incident.UnitRecalled to outlet IncidentEventSplitToResponseTimeAnalytics
        tell event Incident.UnitRecalled to entity IncidentContext.Incident
      }
      on event Incident.UnitEnRoute is {
        send event Incident.UnitEnRoute to outlet IncidentEventSplitToIncidentRepository
        send event Incident.UnitEnRoute to outlet IncidentEventSplitToDispatchBoard
        send event Incident.UnitEnRoute to outlet IncidentEventSplitToResponseTimeAnalytics
        tell event Incident.UnitEnRoute to entity IncidentContext.Incident
      }
      on event Incident.UnitArrived is {
        send event Incident.UnitArrived to outlet IncidentEventSplitToIncidentRepository
        send event Incident.UnitArrived to outlet IncidentEventSplitToDispatchBoard
        send event Incident.UnitArrived to outlet IncidentEventSplitToResponseTimeAnalytics
        tell event Incident.UnitArrived to entity IncidentContext.Incident
      }
      on event Incident.UnitCleared is {
        send event Incident.UnitCleared to outlet IncidentEventSplitToIncidentRepository
        send event Incident.UnitCleared to outlet IncidentEventSplitToDispatchBoard
        send event Incident.UnitCleared to outlet IncidentEventSplitToResponseTimeAnalytics
        tell event Incident.UnitCleared to entity IncidentContext.Incident
      }
      on event Incident.NoteAdded is {
        send event Incident.NoteAdded to outlet IncidentEventSplitToIncidentRepository
        send event Incident.NoteAdded to outlet IncidentEventSplitToDispatchBoard
        send event Incident.NoteAdded to outlet IncidentEventSplitToResponseTimeAnalytics
        tell event Incident.NoteAdded to entity IncidentContext.Incident
      }
      on event Incident.PriorityUpgraded is {
        send event Incident.PriorityUpgraded to outlet IncidentEventSplitToIncidentRepository
        send event Incident.PriorityUpgraded to outlet IncidentEventSplitToDispatchBoard
        send event Incident.PriorityUpgraded to outlet IncidentEventSplitToResponseTimeAnalytics
        tell event Incident.PriorityUpgraded to entity IncidentContext.Incident
      }
      on event Incident.PriorityDowngraded is {
        send event Incident.PriorityDowngraded to outlet IncidentEventSplitToIncidentRepository
        send event Incident.PriorityDowngraded to outlet IncidentEventSplitToDispatchBoard
        send event Incident.PriorityDowngraded to outlet IncidentEventSplitToResponseTimeAnalytics
        tell event Incident.PriorityDowngraded to entity IncidentContext.Incident
      }
      on event Incident.IncidentsLinked is {
        send event Incident.IncidentsLinked to outlet IncidentEventSplitToIncidentRepository
        send event Incident.IncidentsLinked to outlet IncidentEventSplitToDispatchBoard
        send event Incident.IncidentsLinked to outlet IncidentEventSplitToResponseTimeAnalytics
        tell event Incident.IncidentsLinked to entity IncidentContext.Incident
      }
      on event Incident.IncidentClosed is {
        send event Incident.IncidentClosed to outlet IncidentEventSplitToIncidentRepository
        send event Incident.IncidentClosed to outlet IncidentEventSplitToDispatchBoard
        send event Incident.IncidentClosed to outlet IncidentEventSplitToResponseTimeAnalytics
        tell event Incident.IncidentClosed to entity IncidentContext.Incident
      }
      on event Incident.IncidentCancelled is {
        send event Incident.IncidentCancelled to outlet IncidentEventSplitToIncidentRepository
        send event Incident.IncidentCancelled to outlet IncidentEventSplitToDispatchBoard
        send event Incident.IncidentCancelled to outlet IncidentEventSplitToResponseTimeAnalytics
        tell event Incident.IncidentCancelled to entity IncidentContext.Incident
      }
      on event Incident.IncidentReopened is {
        send event Incident.IncidentReopened to outlet IncidentEventSplitToIncidentRepository
        send event Incident.IncidentReopened to outlet IncidentEventSplitToDispatchBoard
        send event Incident.IncidentReopened to outlet IncidentEventSplitToResponseTimeAnalytics
        tell event Incident.IncidentReopened to entity IncidentContext.Incident
      }
      on other is {
        error "Unexpected message for processor IncidentEventSplit"
      }
    } with {
      briefly "Incident event fan-out handler"
      described as {
        |Delivers each Incident event to all of its consumers.
      }
    }
  } with {
    briefly "Incident event fan-out"
    described as {
      |Fans Incident events out to the repository and projectors.
    }
  }
  connector LinkIncidentToIncidentEventSplit is from outlet IncidentContext.Incident.IncidentEvents2 to inlet IncidentContext.IncidentEventSplit.IncidentEventSplitIn with {
    briefly "LinkIncidentToIncidentEventSplit"
  }
  connector LinkIncidentEventSplitToIncidentRepository is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToIncidentRepository to inlet IncidentContext.IncidentRepository.IncidentRepositoryFromIncident with {
    briefly "LinkIncidentEventSplitToIncidentRepository"
  }
  connector LinkIncidentEventSplitToDispatchBoard is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToDispatchBoard to inlet IncidentContext.DispatchBoard.DispatchBoardFromIncident with {
    briefly "LinkIncidentEventSplitToDispatchBoard"
  }
  connector LinkIncidentEventSplitToResponseTimeAnalytics is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToResponseTimeAnalytics to inlet IncidentContext.ResponseTimeAnalytics.ResponseTimeAnalyticsFromIncident with {
    briefly "LinkIncidentEventSplitToResponseTimeAnalytics"
  }
  connector LinkDispatchBoardToIncidentRepository is from outlet IncidentContext.DispatchBoard.DispatchBoardOut to inlet IncidentContext.IncidentRepository.IncidentRepositoryFromDispatchBoard with {
    briefly "LinkDispatchBoardToIncidentRepository"
  }
  connector LinkResponseTimeAnalyticsToIncidentRepository is from outlet IncidentContext.ResponseTimeAnalytics.ResponseTimeAnalyticsOut to inlet IncidentContext.IncidentRepository.IncidentRepositoryFromResponseTimeAnalytics with {
    briefly "LinkResponseTimeAnalyticsToIncidentRepository"
  }
} with {
  briefly "Incident context"
  described as {
    | The Incident context manages emergency incidents
    | and dispatch operations.
  }
}
