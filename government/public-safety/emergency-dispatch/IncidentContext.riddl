// Emergency Dispatch - Incident Context
context IncidentContext as router is {
  inlet IncidentCommandStreamIn is type IncidentCommand  outlet IncidentCommandStreamOut is type IncidentCommand
  inlet IncidentQueryResultStreamIn is result Incident.IncidentQueryResult  outlet IncidentQueryResultStreamOut is result Incident.IncidentQueryResult
  handler IncidentContextBoundary is {
    on createIncident: command Incident.CreateIncident is {
      send createIncident to outlet IncidentContext.IncidentCommandStreamOut
    }
    on updateIncidentDetails: command Incident.UpdateIncidentDetails is {
      send updateIncidentDetails to outlet IncidentContext.IncidentCommandStreamOut
    }
    on dispatchUnit: command Incident.DispatchUnit is {
      send dispatchUnit to outlet IncidentContext.IncidentCommandStreamOut
    }
    on recallUnit: command Incident.RecallUnit is {
      send recallUnit to outlet IncidentContext.IncidentCommandStreamOut
    }
    on markUnitEnRoute: command Incident.MarkUnitEnRoute is {
      send markUnitEnRoute to outlet IncidentContext.IncidentCommandStreamOut
    }
    on markUnitArrived: command Incident.MarkUnitArrived is {
      send markUnitArrived to outlet IncidentContext.IncidentCommandStreamOut
    }
    on clearUnit: command Incident.ClearUnit is {
      send clearUnit to outlet IncidentContext.IncidentCommandStreamOut
    }
    on addNote: command Incident.AddNote is {
      send addNote to outlet IncidentContext.IncidentCommandStreamOut
    }
    on upgradePriority: command Incident.UpgradePriority is {
      send upgradePriority to outlet IncidentContext.IncidentCommandStreamOut
    }
    on downgradePriority: command Incident.DowngradePriority is {
      send downgradePriority to outlet IncidentContext.IncidentCommandStreamOut
    }
    on linkIncidents: command Incident.LinkIncidents is {
      send linkIncidents to outlet IncidentContext.IncidentCommandStreamOut
    }
    on closeIncident: command Incident.CloseIncident is {
      send closeIncident to outlet IncidentContext.IncidentCommandStreamOut
    }
    on cancelIncident: command Incident.CancelIncident is {
      send cancelIncident to outlet IncidentContext.IncidentCommandStreamOut
    }
    on reopenIncident: command Incident.ReopenIncident is {
      send reopenIncident to outlet IncidentContext.IncidentCommandStreamOut
    }
    on incidentQueryResult: result Incident.IncidentQueryResult is {
      send incidentQueryResult to outlet IncidentContext.IncidentQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the IncidentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'IncidentCommand Stream Intake' is from outlet IncidentContext.IncidentCommandStreamOut to inlet IncidentContext.Incident.IncidentCommands  connector 'IncidentQueryResult Stream Egress' is from outlet IncidentContext.IncidentRepository.IncidentRepositoryResponses to inlet IncidentContext.IncidentQueryResultStreamIn  adaptor FromAVLService from context AVLService is { 
    handler FromAVLServiceHandler is {
      on result AVLService.NearestUnitsResult is {
        do "the model receives nearest units result"
      }
      on result AVLService.UnitLocationResult is {
        do "the model receives unit location result"
      }
      on event AVLService.UnitLocationUpdated is {
        do "the model receives unit location updated"
      }
      on other is {
        error "Unexpected message for adaptor FromAVLService"
      }
    } with {
      briefly "from avl service"
      described as {
        |Carries messages from the external AVLService.
      }
    }
  } with {
    briefly "AVLService integration"
    described as {
      |The model's side of the AVLService conversation.
    }
  }
  adaptor ToAVLService to context AVLService is { 
    handler ToAVLServiceHandler is {
      on query AVLService.FindNearestUnits is {
        do "the model sends find nearest units"
      }
      on query AVLService.GetUnitLocation is {
        do "the model sends get unit location"
      }
      on other is {
        error "Unexpected message for adaptor ToAVLService"
      }
    } with {
      briefly "to avl service"
      described as {
        |Carries messages to the external AVLService.
      }
    }
  } with {
    briefly "AVLService integration"
    described as {
      |The model's side of the AVLService conversation.
    }
  }
  adaptor FromE911Service from context E911Service is { 
    handler FromE911ServiceHandler is {
      on event E911Service.CallAnswered is {
        do "the model receives call answered"
      }
      on event E911Service.CallEnded is {
        do "the model receives call ended"
      }
      on result E911Service.CallRecordingResult is {
        do "the model receives call recording result"
      }
      on event E911Service.IncomingCall is {
        do "the model receives incoming call"
      }
      on other is {
        error "Unexpected message for adaptor FromE911Service"
      }
    } with {
      briefly "from e 911 service"
      described as {
        |Carries messages from the external E911Service.
      }
    }
  } with {
    briefly "E911Service integration"
    described as {
      |The model's side of the E911Service conversation.
    }
  }
  adaptor ToE911Service to context E911Service is { 
    handler ToE911ServiceHandler is {
      on query E911Service.GetCallRecording is {
        do "the model sends get call recording"
      }
      on other is {
        error "Unexpected message for adaptor ToE911Service"
      }
    } with {
      briefly "to e 911 service"
      described as {
        |Carries messages to the external E911Service.
      }
    }
  } with {
    briefly "E911Service integration"
    described as {
      |The model's side of the E911Service conversation.
    }
  }
  adaptor FromGISService from context GISService is { 
    handler FromGISServiceHandler is {
      on result GISService.AddressResult is {
        do "the model receives address result"
      }
      on result GISService.CoordinatesResult is {
        do "the model receives coordinates result"
      }
      on result GISService.DispatchZoneResult is {
        do "the model receives dispatch zone result"
      }
      on result GISService.HazardsResult is {
        do "the model receives hazards result"
      }
      on other is {
        error "Unexpected message for adaptor FromGISService"
      }
    } with {
      briefly "from gis service"
      described as {
        |Carries messages from the external GISService.
      }
    }
  } with {
    briefly "GISService integration"
    described as {
      |The model's side of the GISService conversation.
    }
  }
  adaptor ToGISService to context GISService is { 
    handler ToGISServiceHandler is {
      on query GISService.GetAddressFromCoordinates is {
        do "the model sends get address from coordinates"
      }
      on query GISService.GetCoordinatesFromAddress is {
        do "the model sends get coordinates from address"
      }
      on query GISService.GetDispatchZone is {
        do "the model sends get dispatch zone"
      }
      on query GISService.GetHazards is {
        do "the model sends get hazards"
      }
      on other is {
        error "Unexpected message for adaptor ToGISService"
      }
    } with {
      briefly "to gis service"
      described as {
        |Carries messages to the external GISService.
      }
    }
  } with {
    briefly "GISService integration"
    described as {
      |The model's side of the GISService conversation.
    }
  }
  adaptor FromMDTService from context MDTService is { 
    handler FromMDTServiceHandler is {
      on event MDTService.DispatchAcknowledged is {
        do "the model receives dispatch acknowledged"
      }
      on event MDTService.MessageReceived is {
        do "the model receives message received"
      }
      on other is {
        error "Unexpected message for adaptor FromMDTService"
      }
    } with {
      briefly "from mdt service"
      described as {
        |Carries messages from the external MDTService.
      }
    }
  } with {
    briefly "MDTService integration"
    described as {
      |The model's side of the MDTService conversation.
    }
  }
  adaptor ToMDTService to context MDTService is { 
    handler ToMDTServiceHandler is {
      on command MDTService.SendDispatchNotification is {
        do "the model sends send dispatch notification"
      }
      on command MDTService.SendUnitMessage is {
        do "the model sends send unit message"
      }
      on other is {
        error "Unexpected message for adaptor ToMDTService"
      }
    } with {
      briefly "to mdt service"
      described as {
        |Carries messages to the external MDTService.
      }
    }
  } with {
    briefly "MDTService integration"
    described as {
      |The model's side of the MDTService conversation.
    }
  }
  adaptor FromRMSService from context RMSService is { 
    handler FromRMSServiceHandler is {
      on result RMSService.LocationHistoryResult is {
        do "the model receives location history result"
      }
      on result RMSService.PersonWarningsResult is {
        do "the model receives person warnings result"
      }
      on other is {
        error "Unexpected message for adaptor FromRMSService"
      }
    } with {
      briefly "from rms service"
      described as {
        |Carries messages from the external RMSService.
      }
    }
  } with {
    briefly "RMSService integration"
    described as {
      |The model's side of the RMSService conversation.
    }
  }
  adaptor ToRMSService to context RMSService is { 
    handler ToRMSServiceHandler is {
      on query RMSService.GetLocationHistory is {
        do "the model sends get location history"
      }
      on query RMSService.GetPersonWarnings is {
        do "the model sends get person warnings"
      }
      on other is {
        error "Unexpected message for adaptor ToRMSService"
      }
    } with {
      briefly "to rms service"
      described as {
        |Carries messages to the external RMSService.
      }
    }
  } with {
    briefly "RMSService integration"
    described as {
      |The model's side of the RMSService conversation.
    }
  }
  adaptor FromRadioService from context RadioService is { 
    handler FromRadioServiceHandler is {
      on event RadioService.EmergencyButtonPressed is {
        do "the model receives emergency button pressed"
      }
      on event RadioService.TalkgroupAssigned is {
        do "the model receives talkgroup assigned"
      }
      on other is {
        error "Unexpected message for adaptor FromRadioService"
      }
    } with {
      briefly "from radio service"
      described as {
        |Carries messages from the external RadioService.
      }
    }
  } with {
    briefly "RadioService integration"
    described as {
      |The model's side of the RadioService conversation.
    }
  }
  adaptor ToRadioService to context RadioService is { 
    handler ToRadioServiceHandler is {
      on command RadioService.RequestTalkgroup is {
        do "the model sends request talkgroup"
      }
      on other is {
        error "Unexpected message for adaptor ToRadioService"
      }
    } with {
      briefly "to radio service"
      described as {
        |Carries messages to the external RadioService.
      }
    }
  } with {
    briefly "RadioService integration"
    described as {
      |The model's side of the RadioService conversation.
    }
  }
  include "types.riddl"
  include "Incident.riddl"
  // Repository
  type IncidentRepositoryCommand is one of {
    IncidentContext.IncidentRepository.PersistIncidentCancelled or IncidentContext.IncidentRepository.PersistIncidentClosed or IncidentContext.IncidentRepository.PersistIncidentCreated or IncidentContext.IncidentRepository.PersistIncidentDetailsUpdated or IncidentContext.IncidentRepository.PersistIncidentReopened or IncidentContext.IncidentRepository.PersistIncidentsLinked or IncidentContext.IncidentRepository.PersistNoteAdded or IncidentContext.IncidentRepository.PersistPriorityDowngraded or IncidentContext.IncidentRepository.PersistPriorityUpgraded or IncidentContext.IncidentRepository.PersistUnitArrived or IncidentContext.IncidentRepository.PersistUnitCleared or IncidentContext.IncidentRepository.PersistUnitDispatched or IncidentContext.IncidentRepository.PersistUnitEnRoute or IncidentContext.IncidentRepository.PersistUnitRecalled
  } with {
    briefly "Anything that writes IncidentRepository"
    described as {
      |The persistence commands IncidentRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository IncidentRepository as flow is {
    inlet IncidentRepositoryFromDispatchBoard is type IncidentRepositoryCommand    command PersistIncidentDetailsUpdated is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncidentDetailsUpdated applies to.
        }
      }
    } with {
      briefly "Persist IncidentDetailsUpdated"
      described as {
        |Instructs this repository to apply IncidentDetailsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentReopened is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncidentReopened applies to.
        }
      }
    } with {
      briefly "Persist IncidentReopened"
      described as {
        |Instructs this repository to apply IncidentReopened to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentsLinked is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncidentsLinked applies to.
        }
      }
    } with {
      briefly "Persist IncidentsLinked"
      described as {
        |Instructs this repository to apply IncidentsLinked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistNoteAdded is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row NoteAdded applies to.
        }
      }
    } with {
      briefly "Persist NoteAdded"
      described as {
        |Instructs this repository to apply NoteAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPriorityDowngraded is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row PriorityDowngraded applies to.
        }
      }
    } with {
      briefly "Persist PriorityDowngraded"
      described as {
        |Instructs this repository to apply PriorityDowngraded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPriorityUpgraded is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row PriorityUpgraded applies to.
        }
      }
    } with {
      briefly "Persist PriorityUpgraded"
      described as {
        |Instructs this repository to apply PriorityUpgraded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUnitRecalled is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row UnitRecalled applies to.
        }
      }
    } with {
      briefly "Persist UnitRecalled"
      described as {
        |Instructs this repository to apply UnitRecalled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentCancelled is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncidentCancelled applies to.
        }
      }
    } with {
      briefly "Persist IncidentCancelled"
      described as {
        |Instructs this repository to apply IncidentCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentClosed is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncidentClosed applies to.
        }
      }
    } with {
      briefly "Persist IncidentClosed"
      described as {
        |Instructs this repository to apply IncidentClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentCreated is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncidentCreated applies to.
        }
      }
    } with {
      briefly "Persist IncidentCreated"
      described as {
        |Instructs this repository to apply IncidentCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUnitArrived is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row UnitArrived applies to.
        }
      }
    } with {
      briefly "Persist UnitArrived"
      described as {
        |Instructs this repository to apply UnitArrived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUnitCleared is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row UnitCleared applies to.
        }
      }
    } with {
      briefly "Persist UnitCleared"
      described as {
        |Instructs this repository to apply UnitCleared to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUnitDispatched is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row UnitDispatched applies to.
        }
      }
    } with {
      briefly "Persist UnitDispatched"
      described as {
        |Instructs this repository to apply UnitDispatched to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUnitEnRoute is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row UnitEnRoute applies to.
        }
      }
    } with {
      briefly "Persist UnitEnRoute"
      described as {
        |Instructs this repository to apply UnitEnRoute to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredIncident is  {
      incidentId: IncidentId with {
        briefly "incidentId"
        described as {
          |The incidentId column of the stored incident row.
        }
      }
    } with {
      briefly "Stored incident row"
      described as {
        |The persistence shape of incident data as this repository stores it.
      }
    }
    schema IncidentData is relational
      of incidents as record StoredIncident
        index on field StoredIncident.incidentId
 with {
      briefly "Incident data schema"
      described as {
        |The relational schema persisting incident records for this repository.
      }
    }
    outlet IncidentRepositoryResponses is result Incident.IncidentQueryResult
    query FindIncidentById replies result IncidentResult is  {
      incidentId: IncidentId with {
        briefly "Incident"
        described as {
          |Incident identifier.
        }
      }
    } with {
      briefly "Find incident by ID"
      described as {
        |Retrieves incident by identifier.
      }
    }
    result IncidentResult is  {
      incident: Incident.ActiveStateData with {
        briefly "Incident"
        described as {
          |Incident data.
        }
      }
    } with {
      briefly "Incident result"
      described as {
        |Returns incident data.
      }
    }
    query SearchIncidents replies result IncidentsResult is  {
      filterStatus: IncidentStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      filterPriority: IncidentPriority? with {
        briefly "Priority"
        described as {
          |Filter by priority.
        }
      }
      filterIncidentType: IncidentType? with {
        briefly "Type"
        described as {
          |Filter by type.
        }
      }
      fromDate: Date? with {
        briefly "From"
        described as {
          |Start date filter.
        }
      }
      toDate: Date? with {
        briefly "To"
        described as {
          |End date filter.
        }
      }
    } with {
      briefly "Search incidents"
      described as {
        |Searches incidents by criteria.
      }
    }
    result IncidentsResult is  {
      matchingIncidents: Incident.ActiveStateData+ with {
        briefly "Incidents"
        described as {
          |Matching incidents.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Incidents result"
      described as {
        |Returns matching incidents.
      }
    }
    query FindActiveIncidents replies result IncidentResult is  {
      activePriority: IncidentPriority? with {
        briefly "Priority"
        described as {
          |Filter by priority.
        }
      }
      zone: String(1,50)? with {
        briefly "Zone"
        described as {
          |Filter by dispatch zone.
        }
      }
    } with {
      briefly "Find active incidents"
      described as {
        |Finds all active incidents.
      }
    }
    query FindIncidentsByUnit replies result IncidentResult is  {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit identifier.
        }
      }
      activeOnly: Boolean with {
        briefly "Active only"
        described as {
          |Only active incidents.
        }
      }
    } with {
      briefly "Find by unit"
      described as {
        |Finds incidents for a unit.
      }
    }
    query FindIncidentsByLocation replies result IncidentResult is  {
      latitude: Decimal(9,6) with {
        briefly "Latitude"
        described as {
          |Center latitude.
        }
      }
      longitude: Decimal(10,6) with {
        briefly "Longitude"
        described as {
          |Center longitude.
        }
      }
      radiusMiles: Decimal(5,2) with {
        briefly "Radius"
        described as {
          |Search radius in miles.
        }
      }
    } with {
      briefly "Find by location"
      described as {
        |Finds incidents near a location.
      }
    }
    handler IncidentRepositoryHandler is {
      on persistIncidentDetailsUpdated: command PersistIncidentDetailsUpdated is {
        do "apply IncidentDetailsUpdated to the stored row"
      }
      on persistIncidentReopened: command PersistIncidentReopened is {
        do "apply IncidentReopened to the stored row"
      }
      on persistIncidentsLinked: command PersistIncidentsLinked is {
        do "apply IncidentsLinked to the stored row"
      }
      on persistNoteAdded: command PersistNoteAdded is {
        do "apply NoteAdded to the stored row"
      }
      on persistPriorityDowngraded: command PersistPriorityDowngraded is {
        do "apply PriorityDowngraded to the stored row"
      }
      on persistPriorityUpgraded: command PersistPriorityUpgraded is {
        do "apply PriorityUpgraded to the stored row"
      }
      on persistUnitRecalled: command PersistUnitRecalled is {
        do "apply UnitRecalled to the stored row"
      }
      on persistIncidentCancelled: command PersistIncidentCancelled is {
        do "apply IncidentCancelled to the stored row"
      }
      on persistIncidentClosed: command PersistIncidentClosed is {
        do "apply IncidentClosed to the stored row"
      }
      on persistIncidentCreated: command PersistIncidentCreated is {
        do "apply IncidentCreated to the stored row"
      }
      on persistUnitArrived: command PersistUnitArrived is {
        do "apply UnitArrived to the stored row"
      }
      on persistUnitCleared: command PersistUnitCleared is {
        do "apply UnitCleared to the stored row"
      }
      on persistUnitDispatched: command PersistUnitDispatched is {
        do "apply UnitDispatched to the stored row"
      }
      on persistUnitEnRoute: command PersistUnitEnRoute is {
        do "apply UnitEnRoute to the stored row"
      }
      on query GetBoardData is {
        let boardDataView: type BoardDataView = prompt("read the board data projection")
        reply boardDataView
      }
      on query GetAnalyticsData is {
        let analyticsDataView: type AnalyticsDataView = prompt("read the analytics data projection")
        reply analyticsDataView
      }
      on query FindIncidentById is {
        let incidentResult: type IncidentResult = prompt("read the incident from the store")
        reply incidentResult
      }
      on query SearchIncidents is {
        let incidentsResult: type IncidentsResult = prompt("read the incidents from the store")
        reply incidentsResult
      }
      on query FindActiveIncidents is {
        let incidentResult: type IncidentResult = prompt("read the incident from the store")
        reply incidentResult
      }
      on query FindIncidentsByUnit is {
        let incidentResult: type IncidentResult = prompt("read the incident from the store")
        reply incidentResult
      }
      on query FindIncidentsByLocation is {
        let incidentResult: type IncidentResult = prompt("read the incident from the store")
        reply incidentResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes incident queries.
      }
    }
  } with {
    briefly "Incident repository"
    described as {
      |Persistence for incident records.
    }
  }
  // Projector for dispatch board
  query GetBoardData replies result BoardDataView is  {
    boardDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which board data to retrieve.
      }
    }
  } with {
    briefly "Get board data"
    described as {
      |Retrieves the board data projection.
    }
  }
  result BoardDataView is  {
    boardData: DispatchBoard.BoardData with {
      briefly "Board data"
      described as {
        |The board data being returned.
      }
    }
  } with {
    briefly "Board data view"
    described as {
      |Read model view carrying the board data projection.
    }
  }
  projector DispatchBoard as flow is {
    updates repository IncidentContext.IncidentRepository
    outlet DispatchBoardToRepository is type IncidentRepositoryCommand
    inlet DispatchBoardFromIncident is type IncidentEvent    record BoardData is  {
      activeIncidents: ActiveIncidentSummary+ with {
        briefly "Active"
        described as {
          |Active incidents.
        }
      }
      pendingUnits: UnitSummary+ with {
        briefly "Pending"
        described as {
          |Units waiting dispatch.
        }
      }
      boardDispatchedUnits: UnitSummary+ with {
        briefly "Dispatched"
        described as {
          |Units on calls.
        }
      }
      availableUnits: UnitSummary+ with {
        briefly "Available"
        described as {
          |Available units.
        }
      }
    } with {
      briefly "Board data"
      described as {
        |Dispatch board display data.
      }
    }
    record ActiveIncidentSummary is  {
      incidentId: IncidentId with {
        briefly "Incident"
        described as {
          |Incident ID.
        }
      }
      summaryPriority: IncidentPriority with {
        briefly "Priority"
        described as {
          |Priority level.
        }
      }
      summaryIncidentType: IncidentType with {
        briefly "Type"
        described as {
          |Incident type.
        }
      }
      summaryLocation: String(1,200) with {
        briefly "Location"
        described as {
          |Location summary.
        }
      }
      summaryStatus: IncidentStatus with {
        briefly "Status"
        described as {
          |Current status.
        }
      }
      unitsAssigned: Natural with {
        briefly "Units"
        described as {
          |Units assigned.
        }
      }
      elapsedMinutes: Natural with {
        briefly "Elapsed"
        described as {
          |Minutes since creation.
        }
      }
    } with {
      briefly "Incident summary"
      described as {
        |Summary for dispatch board.
      }
    }
    record UnitSummary is  {
      unitId: UnitId with {
        briefly "Unit"
        described as {
          |Unit ID.
        }
      }
      unitNumber: String(1,20) with {
        briefly "Number"
        described as {
          |Unit number.
        }
      }
      summaryUnitType: UnitType with {
        briefly "Type"
        described as {
          |Unit type.
        }
      }
      summaryUnitStatus: UnitStatus with {
        briefly "Status"
        described as {
          |Current status.
        }
      }
      currentCall: IncidentId? with {
        briefly "Call"
        described as {
          |Current incident.
        }
      }
    } with {
      briefly "Unit summary"
      described as {
        |Unit status summary.
      }
    }
    handler BoardHandler is {
      on incidentDetailsUpdated: event Incident.IncidentDetailsUpdated is {
        tell command IncidentContext.IncidentRepository.PersistIncidentDetailsUpdated(incidentId = incidentDetailsUpdated.incidentId) to repository IncidentContext.IncidentRepository
        do "apply IncidentDetailsUpdated to the DispatchBoard projection"
      }
      on incidentReopened: event Incident.IncidentReopened is {
        tell command IncidentContext.IncidentRepository.PersistIncidentReopened(incidentId = incidentReopened.incidentId) to repository IncidentContext.IncidentRepository
        do "apply IncidentReopened to the DispatchBoard projection"
      }
      on incidentsLinked: event Incident.IncidentsLinked is {
        tell command IncidentContext.IncidentRepository.PersistIncidentsLinked(incidentId = incidentsLinked.incidentId) to repository IncidentContext.IncidentRepository
        do "apply IncidentsLinked to the DispatchBoard projection"
      }
      on noteAdded: event Incident.NoteAdded is {
        tell command IncidentContext.IncidentRepository.PersistNoteAdded(incidentId = noteAdded.incidentId) to repository IncidentContext.IncidentRepository
        do "apply NoteAdded to the DispatchBoard projection"
      }
      on priorityDowngraded: event Incident.PriorityDowngraded is {
        tell command IncidentContext.IncidentRepository.PersistPriorityDowngraded(incidentId = priorityDowngraded.incidentId) to repository IncidentContext.IncidentRepository
        do "apply PriorityDowngraded to the DispatchBoard projection"
      }
      on priorityUpgraded: event Incident.PriorityUpgraded is {
        tell command IncidentContext.IncidentRepository.PersistPriorityUpgraded(incidentId = priorityUpgraded.incidentId) to repository IncidentContext.IncidentRepository
        do "apply PriorityUpgraded to the DispatchBoard projection"
      }
      on unitRecalled: event Incident.UnitRecalled is {
        tell command IncidentContext.IncidentRepository.PersistUnitRecalled(incidentId = unitRecalled.incidentId) to repository IncidentContext.IncidentRepository
        do "apply UnitRecalled to the DispatchBoard projection"
      }
      on incidentCreated: event Incident.IncidentCreated is {
        tell command IncidentContext.IncidentRepository.PersistIncidentCreated(incidentId = incidentCreated.incidentId) to repository IncidentContext.IncidentRepository
      }
      on unitDispatched: event Incident.UnitDispatched is {
        tell command IncidentContext.IncidentRepository.PersistUnitDispatched(incidentId = unitDispatched.incidentId) to repository IncidentContext.IncidentRepository
      }
      on unitEnRoute: event Incident.UnitEnRoute is {
        tell command IncidentContext.IncidentRepository.PersistUnitEnRoute(incidentId = unitEnRoute.incidentId) to repository IncidentContext.IncidentRepository
      }
      on unitArrived: event Incident.UnitArrived is {
        tell command IncidentContext.IncidentRepository.PersistUnitArrived(incidentId = unitArrived.incidentId) to repository IncidentContext.IncidentRepository
      }
      on unitCleared: event Incident.UnitCleared is {
        tell command IncidentContext.IncidentRepository.PersistUnitCleared(incidentId = unitCleared.incidentId) to repository IncidentContext.IncidentRepository
      }
      on incidentClosed: event Incident.IncidentClosed is {
        tell command IncidentContext.IncidentRepository.PersistIncidentClosed(incidentId = incidentClosed.incidentId) to repository IncidentContext.IncidentRepository
      }
      on incidentCancelled: event Incident.IncidentCancelled is {
        tell command IncidentContext.IncidentRepository.PersistIncidentCancelled(incidentId = incidentCancelled.incidentId) to repository IncidentContext.IncidentRepository
      }
    } with {
      briefly "Processes board events"
      described as {
        |Updates dispatch board from events.
      }
    }
  } with {
    briefly "Dispatch board"
    described as {
      |Projects real-time dispatch status.
    }
  }
  // Projector for response time analytics
  query GetAnalyticsData replies result AnalyticsDataView is  {
    analyticsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which analytics data to retrieve.
      }
    }
  } with {
    briefly "Get analytics data"
    described as {
      |Retrieves the analytics data projection.
    }
  }
  result AnalyticsDataView is  {
    analyticsData: ResponseTimeAnalytics.AnalyticsData with {
      briefly "Analytics data"
      described as {
        |The analytics data being returned.
      }
    }
  } with {
    briefly "Analytics data view"
    described as {
      |Read model view carrying the analytics data projection.
    }
  }
  projector ResponseTimeAnalytics as sink is {
    updates repository IncidentContext.IncidentRepository
    inlet ResponseTimeAnalyticsFromIncident is type IncidentEvent    record AnalyticsData is  {
      averageDispatchTime: Decimal(6,2) with {
        briefly "Dispatch time"
        described as {
          |Average dispatch time (seconds).
        }
      }
      averageEnRouteTime: Decimal(6,2) with {
        briefly "En route time"
        described as {
          |Average time to go en route (seconds).
        }
      }
      averageResponseTime: Decimal(6,2) with {
        briefly "Response time"
        described as {
          |Average total response time (seconds).
        }
      }
      averageOnSceneTime: Decimal(6,2) with {
        briefly "On scene time"
        described as {
          |Average time on scene (minutes).
        }
      }
      incidentsByPriority: PriorityMetrics+ with {
        briefly "By priority"
        described as {
          |Metrics by priority level.
        }
      }
      incidentsByType: TypeMetrics+ with {
        briefly "By type"
        described as {
          |Metrics by incident type.
        }
      }
    } with {
      briefly "Analytics data"
      described as {
        |Response time metrics.
      }
    }
    record PriorityMetrics is  {
      metricPriority: IncidentPriority with {
        briefly "Priority"
        described as {
          |Priority level.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Incident count.
        }
      }
      avgResponseSeconds: Decimal(6,2) with {
        briefly "Avg response"
        described as {
          |Average response time.
        }
      }
    } with {
      briefly "Priority metrics"
      described as {
        |Metrics for priority level.
      }
    }
    record TypeMetrics is  {
      metricIncidentType: IncidentType with {
        briefly "Type"
        described as {
          |Incident type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Incident count.
        }
      }
      avgResponseSeconds: Decimal(6,2) with {
        briefly "Avg response"
        described as {
          |Average response time.
        }
      }
    } with {
      briefly "Type metrics"
      described as {
        |Metrics for incident type.
      }
    }
    handler AnalyticsHandler is {
      on incidentCancelled: event Incident.IncidentCancelled is {
        tell command IncidentContext.IncidentRepository.PersistIncidentCancelled(incidentId = incidentCancelled.incidentId) to repository IncidentContext.IncidentRepository
        do "apply IncidentCancelled to the ResponseTimeAnalytics projection"
      }
      on incidentDetailsUpdated: event Incident.IncidentDetailsUpdated is {
        tell command IncidentContext.IncidentRepository.PersistIncidentDetailsUpdated(incidentId = incidentDetailsUpdated.incidentId) to repository IncidentContext.IncidentRepository
        do "apply IncidentDetailsUpdated to the ResponseTimeAnalytics projection"
      }
      on incidentReopened: event Incident.IncidentReopened is {
        tell command IncidentContext.IncidentRepository.PersistIncidentReopened(incidentId = incidentReopened.incidentId) to repository IncidentContext.IncidentRepository
        do "apply IncidentReopened to the ResponseTimeAnalytics projection"
      }
      on incidentsLinked: event Incident.IncidentsLinked is {
        tell command IncidentContext.IncidentRepository.PersistIncidentsLinked(incidentId = incidentsLinked.incidentId) to repository IncidentContext.IncidentRepository
        do "apply IncidentsLinked to the ResponseTimeAnalytics projection"
      }
      on noteAdded: event Incident.NoteAdded is {
        tell command IncidentContext.IncidentRepository.PersistNoteAdded(incidentId = noteAdded.incidentId) to repository IncidentContext.IncidentRepository
        do "apply NoteAdded to the ResponseTimeAnalytics projection"
      }
      on priorityDowngraded: event Incident.PriorityDowngraded is {
        tell command IncidentContext.IncidentRepository.PersistPriorityDowngraded(incidentId = priorityDowngraded.incidentId) to repository IncidentContext.IncidentRepository
        do "apply PriorityDowngraded to the ResponseTimeAnalytics projection"
      }
      on priorityUpgraded: event Incident.PriorityUpgraded is {
        tell command IncidentContext.IncidentRepository.PersistPriorityUpgraded(incidentId = priorityUpgraded.incidentId) to repository IncidentContext.IncidentRepository
        do "apply PriorityUpgraded to the ResponseTimeAnalytics projection"
      }
      on unitCleared: event Incident.UnitCleared is {
        tell command IncidentContext.IncidentRepository.PersistUnitCleared(incidentId = unitCleared.incidentId) to repository IncidentContext.IncidentRepository
        do "apply UnitCleared to the ResponseTimeAnalytics projection"
      }
      on unitRecalled: event Incident.UnitRecalled is {
        tell command IncidentContext.IncidentRepository.PersistUnitRecalled(incidentId = unitRecalled.incidentId) to repository IncidentContext.IncidentRepository
        do "apply UnitRecalled to the ResponseTimeAnalytics projection"
      }
      on incidentCreated: event Incident.IncidentCreated is {
        tell command IncidentContext.IncidentRepository.PersistIncidentCreated(incidentId = incidentCreated.incidentId) to repository IncidentContext.IncidentRepository
      }
      on unitDispatched: event Incident.UnitDispatched is {
        tell command IncidentContext.IncidentRepository.PersistUnitDispatched(incidentId = unitDispatched.incidentId) to repository IncidentContext.IncidentRepository
      }
      on unitEnRoute: event Incident.UnitEnRoute is {
        tell command IncidentContext.IncidentRepository.PersistUnitEnRoute(incidentId = unitEnRoute.incidentId) to repository IncidentContext.IncidentRepository
      }
      on unitArrived: event Incident.UnitArrived is {
        tell command IncidentContext.IncidentRepository.PersistUnitArrived(incidentId = unitArrived.incidentId) to repository IncidentContext.IncidentRepository
      }
      on incidentClosed: event Incident.IncidentClosed is {
        tell command IncidentContext.IncidentRepository.PersistIncidentClosed(incidentId = incidentClosed.incidentId) to repository IncidentContext.IncidentRepository
      }
    } with {
      briefly "Processes analytics events"
      described as {
        |Updates response time analytics.
      }
    }
  } with {
    briefly "Response time analytics"
    described as {
      |Projects response time metrics for reporting.
    }
  }
  // ---- Event publication for Incident ----
  type IncidentEvent is one of {
    IncidentContext.Incident.IncidentCreated or IncidentContext.Incident.IncidentDetailsUpdated or IncidentContext.Incident.UnitDispatched or IncidentContext.Incident.UnitRecalled or IncidentContext.Incident.UnitEnRoute or IncidentContext.Incident.UnitArrived or IncidentContext.Incident.UnitCleared or IncidentContext.Incident.NoteAdded or IncidentContext.Incident.PriorityUpgraded or IncidentContext.Incident.PriorityDowngraded or IncidentContext.Incident.IncidentsLinked or IncidentContext.Incident.IncidentClosed or IncidentContext.Incident.IncidentCancelled or IncidentContext.Incident.IncidentReopened
  } with {
    briefly "Incident event alternation"
    described as {
      |Union of all Incident events, for streaming and event-sourced
      |persistence.
    }
  }
  processor IncidentEventSplit as split is {
    inlet IncidentEventSplitIn is type IncidentEvent    outlet IncidentEventSplitToDispatchBoard is type IncidentEvent
    outlet IncidentEventSplitToResponseTimeAnalytics is type IncidentEvent
    handler IncidentEventSplitHandler is {
      on incidentCreated: event Incident.IncidentCreated is {
        send incidentCreated to outlet IncidentEventSplitToDispatchBoard
        send incidentCreated to outlet IncidentEventSplitToResponseTimeAnalytics
        tell incidentCreated to entity IncidentContext.Incident
      }
      on incidentDetailsUpdated: event Incident.IncidentDetailsUpdated is {
        send incidentDetailsUpdated to outlet IncidentEventSplitToDispatchBoard
        send incidentDetailsUpdated to outlet IncidentEventSplitToResponseTimeAnalytics
        tell incidentDetailsUpdated to entity IncidentContext.Incident
      }
      on unitDispatched: event Incident.UnitDispatched is {
        send unitDispatched to outlet IncidentEventSplitToDispatchBoard
        send unitDispatched to outlet IncidentEventSplitToResponseTimeAnalytics
        tell unitDispatched to entity IncidentContext.Incident
      }
      on unitRecalled: event Incident.UnitRecalled is {
        send unitRecalled to outlet IncidentEventSplitToDispatchBoard
        send unitRecalled to outlet IncidentEventSplitToResponseTimeAnalytics
        tell unitRecalled to entity IncidentContext.Incident
      }
      on unitEnRoute: event Incident.UnitEnRoute is {
        send unitEnRoute to outlet IncidentEventSplitToDispatchBoard
        send unitEnRoute to outlet IncidentEventSplitToResponseTimeAnalytics
        tell unitEnRoute to entity IncidentContext.Incident
      }
      on unitArrived: event Incident.UnitArrived is {
        send unitArrived to outlet IncidentEventSplitToDispatchBoard
        send unitArrived to outlet IncidentEventSplitToResponseTimeAnalytics
        tell unitArrived to entity IncidentContext.Incident
      }
      on unitCleared: event Incident.UnitCleared is {
        send unitCleared to outlet IncidentEventSplitToDispatchBoard
        send unitCleared to outlet IncidentEventSplitToResponseTimeAnalytics
        tell unitCleared to entity IncidentContext.Incident
      }
      on noteAdded: event Incident.NoteAdded is {
        send noteAdded to outlet IncidentEventSplitToDispatchBoard
        send noteAdded to outlet IncidentEventSplitToResponseTimeAnalytics
        tell noteAdded to entity IncidentContext.Incident
      }
      on priorityUpgraded: event Incident.PriorityUpgraded is {
        send priorityUpgraded to outlet IncidentEventSplitToDispatchBoard
        send priorityUpgraded to outlet IncidentEventSplitToResponseTimeAnalytics
        tell priorityUpgraded to entity IncidentContext.Incident
      }
      on priorityDowngraded: event Incident.PriorityDowngraded is {
        send priorityDowngraded to outlet IncidentEventSplitToDispatchBoard
        send priorityDowngraded to outlet IncidentEventSplitToResponseTimeAnalytics
        tell priorityDowngraded to entity IncidentContext.Incident
      }
      on incidentsLinked: event Incident.IncidentsLinked is {
        send incidentsLinked to outlet IncidentEventSplitToDispatchBoard
        send incidentsLinked to outlet IncidentEventSplitToResponseTimeAnalytics
        tell incidentsLinked to entity IncidentContext.Incident by incidentId
      }
      on incidentClosed: event Incident.IncidentClosed is {
        send incidentClosed to outlet IncidentEventSplitToDispatchBoard
        send incidentClosed to outlet IncidentEventSplitToResponseTimeAnalytics
        tell incidentClosed to entity IncidentContext.Incident
      }
      on incidentCancelled: event Incident.IncidentCancelled is {
        send incidentCancelled to outlet IncidentEventSplitToDispatchBoard
        send incidentCancelled to outlet IncidentEventSplitToResponseTimeAnalytics
        tell incidentCancelled to entity IncidentContext.Incident
      }
      on incidentReopened: event Incident.IncidentReopened is {
        send incidentReopened to outlet IncidentEventSplitToDispatchBoard
        send incidentReopened to outlet IncidentEventSplitToResponseTimeAnalytics
        tell incidentReopened to entity IncidentContext.Incident
      }
      on other is {
        error "Unexpected message for processor IncidentEventSplit"
      }
    } with {
      briefly "Incident event fan-out handler"
      described as {
        |Delivers each Incident event to all of its consumers.
      }
    }
  } with {
    briefly "Incident event fan-out"
    described as {
      |Fans Incident events out to the repository and projectors.
    }
  }
  connector 'IncidentEvent Stream' is from outlet IncidentContext.Incident.IncidentEvents2 to inlet IncidentContext.IncidentEventSplit.IncidentEventSplitIn with {
    briefly "Incident events, fanned out to storage and read models"
  }
  connector 'DispatchBoard Feed' is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToDispatchBoard to inlet IncidentContext.DispatchBoard.DispatchBoardFromIncident with {
    briefly "Incident events feeding the DispatchBoard projection"
  }
  connector 'ResponseTimeAnalytics Feed' is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToResponseTimeAnalytics to inlet IncidentContext.ResponseTimeAnalytics.ResponseTimeAnalyticsFromIncident with {
    briefly "Incident events feeding the ResponseTimeAnalytics projection"
  }
  connector 'DispatchBoard Storage' is from outlet IncidentContext.DispatchBoard.DispatchBoardToRepository to inlet IncidentContext.IncidentRepository.IncidentRepositoryFromDispatchBoard with {
    briefly "DispatchBoard updates on their way to storage"
  }
} with {
  briefly "Incident context"
  described as {
    | The Incident context manages emergency incidents
    | and dispatch operations.
  }
}
