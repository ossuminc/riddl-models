        described as {
          |Which stored row IncidentClosed applies to.
        }
      }
      disposition: DispositionCode? with {
        briefly "Disposition"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      closedBy: DispatcherId? with {
        briefly "Closed by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      closedAt: TimeStamp? with {
        briefly "Closed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist IncidentClosed"
      described as {
        |Instructs this repository to apply IncidentClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentCreated is {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncidentCreated applies to.
        }
      }
      call: CallInfo? with {
        briefly "Call"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      details: IncidentDetails? with {
        briefly "Details"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdBy: DispatcherId? with {
        briefly "Created by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist IncidentCreated"
      described as {
        |Instructs this repository to apply IncidentCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUnitArrived is {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row UnitArrived applies to.
        }
      }
      unitId: UnitId? with {
        briefly "Unit id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      arrivedAt: TimeStamp? with {
        briefly "Arrived at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist UnitArrived"
      described as {
        |Instructs this repository to apply UnitArrived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUnitCleared is {
      incidentId: IncidentId with {
