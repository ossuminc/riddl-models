// Licensing Domain Model
// Professional and business license management
domain Licensing is {
  persistent connector 'ExamAdministrationServiceReply Stream' is from outlet ExamAdministrationService.ExamAdministrationServiceRepliesOut to inlet LicenseContext.ToExamAdministrationService.ToExamAdministrationServiceReplies with {
    briefly "What ExamAdministrationService answers LicenseContext"
  }
  persistent connector 'ContinuingEducationServiceReply Stream' is from outlet ContinuingEducationService.ContinuingEducationServiceRepliesOut to inlet LicenseContext.ToContinuingEducationService.ToContinuingEducationServiceReplies with {
    briefly "What ContinuingEducationService answers LicenseContext"
  }
  persistent connector 'BackgroundCheckServiceReply Stream' is from outlet BackgroundCheckService.BackgroundCheckServiceRepliesOut to inlet LicenseContext.ToBackgroundCheckService.ToBackgroundCheckServiceReplies with {
    briefly "What BackgroundCheckService answers LicenseContext"
  }
  persistent connector 'BackgroundCheckServiceEvent Stream' is from outlet BackgroundCheckService.BackgroundCheckServiceEventsOut to inlet LicenseContext.FromBackgroundCheckService.FromBackgroundCheckServiceIn with {
    briefly "What BackgroundCheckService tells LicenseContext, unasked"
  }
  persistent connector 'ContinuingEducationServiceEvent Stream' is from outlet ContinuingEducationService.ContinuingEducationServiceEventsOut to inlet LicenseContext.FromContinuingEducationService.FromContinuingEducationServiceIn with {
    briefly "What ContinuingEducationService tells LicenseContext, unasked"
  }
  persistent connector 'CredentialVerificationServiceEvent Stream' is from outlet CredentialVerificationService.CredentialVerificationServiceEventsOut to inlet LicenseContext.FromCredentialVerificationService.FromCredentialVerificationServiceIn with {
    briefly "What CredentialVerificationService tells LicenseContext, unasked"
  }
  persistent connector 'ExamAdministrationServiceEvent Stream' is from outlet ExamAdministrationService.ExamAdministrationServiceEventsOut to inlet LicenseContext.FromExamAdministrationService.FromExamAdministrationServiceIn with {
    briefly "What ExamAdministrationService tells LicenseContext, unasked"
  }
  persistent connector 'PaymentProcessingServiceEvent Stream' is from outlet PaymentProcessingService.PaymentProcessingServiceEventsOut to inlet LicenseContext.FromPaymentProcessingService.FromPaymentProcessingServiceIn with {
    briefly "What PaymentProcessingService tells LicenseContext, unasked"
  }
  persistent connector 'ContinuingEducationServiceRequest Stream' is from outlet LicenseContext.ToContinuingEducationService.ToContinuingEducationServiceOut to inlet ContinuingEducationService.ContinuingEducationServiceRequests with {
    briefly "What LicenseContext asks ContinuingEducationService to send"
  }
  persistent connector 'ExamAdministrationServiceRequest Stream' is from outlet LicenseContext.ToExamAdministrationService.ToExamAdministrationServiceOut to inlet ExamAdministrationService.ExamAdministrationServiceRequests with {
    briefly "What LicenseContext asks ExamAdministrationService to send"
  }
  persistent connector 'CredentialVerificationServiceRequest Stream' is from outlet LicenseContext.ToCredentialVerificationService.ToCredentialVerificationServiceOut to inlet CredentialVerificationService.CredentialVerificationServiceRequests with {
    briefly "What LicenseContext asks CredentialVerificationService to send"
  }
  persistent connector 'BackgroundCheckServiceRequest Stream' is from outlet LicenseContext.ToBackgroundCheckService.ToBackgroundCheckServiceOut to inlet BackgroundCheckService.BackgroundCheckServiceRequests with {
    briefly "What LicenseContext asks BackgroundCheckService to send"
  }
  persistent connector 'PaymentProcessingServiceRequest Stream' is from outlet LicenseContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut to inlet PaymentProcessingService.PaymentProcessingServiceRequests with {
    briefly "What LicenseContext asks PaymentProcessingService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet LicenseContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What LicenseContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Applicant is "person applying for a license" with {
    briefly "Applicant"
    described as {
      |Individual or business seeking licensure.
    }
  }
  user LicensingOfficer is "person processing license applications" with {
    briefly "Licensing Officer"
    described as {
      |Staff reviewing and issuing licenses.
    }
  }
  user BoardMember is "person on licensing board" with {
    briefly "Board Member"
    described as {
      |Member of professional licensing board.
    }
  }
  epic LicensingEpic is {
    user Applicant wants to "to obtain a professional license" so that "they can legally practice their profession"
    case ApplyForLicense is {
      user Applicant wants to "to submit a license application" so that "they can be considered for licensure"
      step is "Applicant submits" "application with documents" "online" with {
        briefly "Submit application"
        described as {
          |Complete application form.
        }
      }
      step take input LicensingApp.LicensingScreen.SubmitApplicationInput from user Applicant with {
        briefly "Submit"
        described as {
          |File the application.
        }
      }
      step is "Staff reviews" "and processes" "application" with {
        briefly "Review"
        described as {
          |Evaluate application.
        }
      }
    } with {
      briefly "Apply for license"
      described as {
        |License application workflow.
      }
    }
  } with {
    briefly "Professional licensing"
    described as {
      | Epic covering license applications, renewals,
      | and enforcement actions.
    }
  }
  include "LicenseContext.riddl"
  include "external-contexts.riddl"
  application context LicensingApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in Licensing are delivered.
      }
    }
    group LicensingScreen is {
      input SubmitApplicationInput acquires command LicenseContext.License.SubmitApplication with {
        briefly "Submit application control"
        described as {
          |The control through which a user submits the submit application request.
        }
      }
    } with {
      briefly "Licensing screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppLicenseCommands is type LicenseContext.License.LicenseCommand
    inlet AppLicenseRepositoryResponses is result LicenseContext.License.LicenseQueryResult    handler LicensingAppHandler is {
      on other is {
        error "Unexpected message for application context LicensingApp"
      }
    } with {
      briefly "LicensingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "LicensingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'LicenseCommand Stream' is from outlet LicensingApp.AppLicenseCommands to inlet LicenseContext.LicenseCommandStreamIn with {
    briefly "License commands from the application"
  }
  persistent connector 'LicenseQueryResult Stream' is from outlet LicenseContext.LicenseQueryResultStreamOut to inlet LicensingApp.AppLicenseRepositoryResponses with {
    briefly "License query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet LicensingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Licensing domain"
  described as {
    | The Licensing domain handles professional
    | and business license management.
  }
}
