// Licensing Domain Model
// Professional and business license management
domain Licensing is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Applicant is "person applying for a license" with {
    briefly "Applicant"
    described as {
      |Individual or business seeking licensure.
    }
  }
  user LicensingOfficer is "person processing license applications" with {
    briefly "Licensing Officer"
    described as {
      |Staff reviewing and issuing licenses.
    }
  }
  user BoardMember is "person on licensing board" with {
    briefly "Board Member"
    described as {
      |Member of professional licensing board.
    }
  }
  epic LicensingEpic is {
    user Applicant wants to "to obtain a professional license" so that "they can legally practice their profession"
    case ApplyForLicense is {
      user Applicant wants to "to submit a license application" so that "they can be considered for licensure"
      step is "Applicant submits" "application with documents" "online" with {
        briefly "Submit application"
        described as {
          |Complete application form.
        }
      }
      step take input LicensingApp.LicensingScreen.SubmitApplicationInput from user Applicant with {
        briefly "Submit"
        described as {
          |File the application.
        }
      }
      step is "Staff reviews" "and processes" "application" with {
        briefly "Review"
        described as {
          |Evaluate application.
        }
      }
    } with {
      briefly "Apply for license"
      described as {
        |License application workflow.
      }
    }
  } with {
    briefly "Professional licensing"
    described as {
      | Epic covering license applications, renewals,
      | and enforcement actions.
    }
  }
  include "LicenseContext.riddl"
  include "external-contexts.riddl"
  application context LicensingApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in Licensing are delivered.
      }
    }
    group LicensingScreen is {
      input SubmitApplicationInput acquires command LicenseContext.License.SubmitApplication with {
        briefly "Submit application control"
        described as {
          |The control through which a user submits the submit application request.
        }
      }
    } with {
      briefly "Licensing screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppLicenseCommands is type LicenseContext.License.LicenseCommand
    inlet AppLicenseRepositoryResponses is type LicenseContext.License.LicenseQueryResult    handler LicensingAppHandler is {
      on other is {
        error "Unexpected message for application context LicensingApp"
      }
    } with {
      briefly "LicensingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "LicensingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'LicenseCommand Stream' is from outlet LicensingApp.AppLicenseCommands to inlet LicenseContext.License.LicenseCommands with {
    option persistent()
    briefly "License commands from the application"
  }
  connector 'LicenseQueryResult Stream' is from outlet LicenseContext.LicenseRepository.LicenseRepositoryResponses to inlet LicensingApp.AppLicenseRepositoryResponses with {
    option persistent()
    briefly "License query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet LicensingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Licensing domain"
  described as {
    | The Licensing domain handles professional
    | and business license management.
  }
}
