// Licensing - License Context
context LicenseContext is {
  include "types.riddl"
  include "License.riddl"
  // Repository
  repository LicenseRepository is {
    schema LicenseData is relational
      of licenses as type License
      with {
      briefly "License data schema"
      described as {
        |The relational schema persisting license records for this repository.
      }
    }
    inlet LicenseRepositoryFromLicense is type LicenseEvent
    inlet LicenseRepositoryFromLicenseAnalytics is type LicenseEvent
    inlet LicenseRepositoryFromPublicLicenseDirectory is type LicenseEvent
    outlet LicenseRepositoryResponses is type License.LicenseQueryResult
    query FindLicenseById is  {
      licenseId: LicenseId with {
        briefly "License"
        described as {
          |License identifier.
        }
      }
    } with {
      briefly "Find license by ID"
      described as {
        |Retrieves license by identifier.
      }
    }
    result LicenseResult is  {
      license: License.ActiveStateData with {
        briefly "License"
        described as {
          |License data.
        }
      }
    } with {
      briefly "License result"
      described as {
        |Returns license data.
      }
    }
    query SearchLicenses is  {
      filterProfession: String(1,200)? with {
        briefly "Profession"
        described as {
          |Filter by profession.
        }
      }
      filterLicenseType: LicenseType? with {
        briefly "Type"
        described as {
          |Filter by license type.
        }
      }
      filterStatus: LicenseStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      filterCity: String(1,100)? with {
        briefly "City"
        described as {
          |Filter by city.
        }
      }
      filterState: String(2,50)? with {
        briefly "State"
        described as {
          |Filter by state.
        }
      }
    } with {
      briefly "Search licenses"
      described as {
        |Searches licenses by criteria.
      }
    }
    result LicensesResult is  {
      licenses: License.ActiveStateData+ with {
        briefly "Licenses"
        described as {
          |Matching licenses.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Licenses result"
      described as {
        |Returns matching licenses.
      }
    }
    query FindByApplicant is  {
      applicantId: ApplicantId with {
        briefly "Applicant"
        described as {
          |Applicant identifier.
        }
      }
    } with {
      briefly "Find by applicant"
      described as {
        |Finds licenses for applicant.
      }
    }
    query FindExpiringLicenses is  {
      expirationBefore: Date with {
        briefly "Before"
        described as {
          |Expiration cutoff date.
        }
      }
      filterProfession: String(1,200)? with {
        briefly "Profession"
        described as {
          |Filter by profession.
        }
      }
    } with {
      briefly "Find expiring licenses"
      described as {
        |Finds licenses expiring before date.
      }
    }
    query FindByDisciplinaryStatus is  {
      hasActiveAction: Boolean with {
        briefly "Active action"
        described as {
          |Has active disciplinary action.
        }
      }
      actionType: DisciplinaryAction? with {
        briefly "Action type"
        described as {
          |Filter by action type.
        }
      }
    } with {
      briefly "Find by disciplinary status"
      described as {
        |Finds licenses with disciplinary history.
      }
    }
    handler LicenseRepositoryHandler is {
      on query FindLicenseById is {
        yield result LicenseResult
      }
      on query SearchLicenses is {
        yield result LicenseResult
      }
      on query FindByApplicant is {
        yield result LicenseResult
      }
      on query FindExpiringLicenses is {
        yield result LicenseResult
      }
      on query FindByDisciplinaryStatus is {
        yield result LicenseResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes license queries.
      }
    }
  } with {
    briefly "License repository"
    described as {
      |Persistence for license records.
    }
  }
  // Projector for analytics
  projector LicenseAnalytics is {
    inlet LicenseAnalyticsFromLicense is type LicenseEvent
    outlet LicenseAnalyticsOut is type LicenseEvent
    updates repository LicenseContext.LicenseRepository
    record AnalyticsData is  {
      totalApplications: Natural with {
        briefly "Applications"
        described as {
          |Total applications.
        }
      }
      pendingApplications: Natural with {
        briefly "Pending"
        described as {
          |Pending applications.
        }
      }
      approvedApplications: Natural with {
        briefly "Approved"
        described as {
          |Approved applications.
        }
      }
      deniedApplications: Natural with {
        briefly "Denied"
        described as {
          |Denied applications.
        }
      }
      activeLicenses: Natural with {
        briefly "Active"
        described as {
          |Active licenses.
        }
      }
      suspendedLicenses: Natural with {
        briefly "Suspended"
        described as {
          |Suspended licenses.
        }
      }
      revokedLicenses: Natural with {
        briefly "Revoked"
        described as {
          |Revoked licenses.
        }
      }
      expiringThisMonth: Natural with {
        briefly "Expiring"
        described as {
          |Expiring this month.
        }
      }
      totalRenewalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Renewal revenue.
        }
      }
      openComplaints: Natural with {
        briefly "Complaints"
        described as {
          |Open complaints.
        }
      }
      averageProcessingDays: Decimal(5,2) with {
        briefly "Processing days"
        described as {
          |Average processing time.
        }
      }
      applicationsByProfession: ProfessionCount+ with {
        briefly "By profession"
        described as {
          |Applications by profession.
        }
      }
    } with {
      briefly "Analytics data"
      described as {
        |License analytics metrics.
      }
    }
    record ProfessionCount is  {
      professionName: String(1,200) with {
        briefly "Profession"
        described as {
          |Profession name.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Application count.
        }
      }
    } with {
      briefly "Profession count"
      described as {
        |Count by profession.
      }
    }
    handler AnalyticsHandler is {
      on event License.ApplicationSubmitted is {
        tell event License.ApplicationSubmitted to repository LicenseContext.LicenseRepository
      }
      on event License.ApplicationApproved is {
        tell event License.ApplicationApproved to repository LicenseContext.LicenseRepository
      }
      on event License.ApplicationDenied is {
        tell event License.ApplicationDenied to repository LicenseContext.LicenseRepository
      }
      on event License.LicenseRenewed is {
        tell event License.LicenseRenewed to repository LicenseContext.LicenseRepository
      }
      on event License.LicenseSuspended is {
        tell event License.LicenseSuspended to repository LicenseContext.LicenseRepository
      }
      on event License.LicenseRevoked is {
        tell event License.LicenseRevoked to repository LicenseContext.LicenseRepository
      }
      on event License.ComplaintFiled is {
        tell event License.ComplaintFiled to repository LicenseContext.LicenseRepository
      }
      on event License.PaymentProcessed is {
        tell event License.PaymentProcessed to repository LicenseContext.LicenseRepository
      }
    } with {
      briefly "Processes analytics events"
      described as {
        |Updates analytics from license events.
      }
    }
  } with {
    briefly "License analytics"
    described as {
      |Projects license metrics for reporting.
    }
  }
  // Projector for public license lookup
  projector PublicLicenseDirectory is {
    inlet PublicLicenseDirectoryFromLicense is type LicenseEvent
    outlet PublicLicenseDirectoryOut is type LicenseEvent
    updates repository LicenseContext.LicenseRepository
    record DirectoryEntry is  {
      licenseNumber: String(1,50) with {
        briefly "Number"
        described as {
          |License number.
        }
      }
      directoryProfession: String(1,200) with {
        briefly "Profession"
        described as {
          |Licensed profession.
        }
      }
      licenseeName: String(1,200) with {
        briefly "Name"
        described as {
          |Licensee name.
        }
      }
      directoryCity: String(1,100) with {
        briefly "City"
        described as {
          |City.
        }
      }
      directoryState: String(2,50) with {
        briefly "State"
        described as {
          |State.
        }
      }
      directoryStatus: LicenseStatus with {
        briefly "Status"
        described as {
          |License status.
        }
      }
      issueDate: Date with {
        briefly "Issued"
        described as {
          |Issue date.
        }
      }
      expirationDate: Date with {
        briefly "Expires"
        described as {
          |Expiration date.
        }
      }
      hasPublicDisciplinaryAction: Boolean with {
        briefly "Disciplinary"
        described as {
          |Has public disciplinary action.
        }
      }
    } with {
      briefly "Directory entry"
      described as {
        |Public license information.
      }
    }
    handler DirectoryHandler is {
      on event License.ApplicationApproved is {
        tell event License.ApplicationApproved to repository LicenseContext.LicenseRepository
      }
      on event License.LicenseRenewed is {
        tell event License.LicenseRenewed to repository LicenseContext.LicenseRepository
      }
      on event License.LicenseSuspended is {
        tell event License.LicenseSuspended to repository LicenseContext.LicenseRepository
      }
      on event License.LicenseRevoked is {
        tell event License.LicenseRevoked to repository LicenseContext.LicenseRepository
      }
      on event License.LicenseReinstated is {
        tell event License.LicenseReinstated to repository LicenseContext.LicenseRepository
      }
      on event License.DisciplinaryActionRecorded is {
        tell event License.DisciplinaryActionRecorded to repository LicenseContext.LicenseRepository
      }
    } with {
      briefly "Processes directory events"
      described as {
        |Updates public directory from license events.
      }
    }
  } with {
    briefly "Public license directory"
    described as {
      |Projects public license verification data.
    }
  }
  // ---- Event publication for License ----
  type LicenseEvent is one of {
    LicenseContext.License.ApplicationSubmitted,
    LicenseContext.License.ApplicationUpdated,
    LicenseContext.License.AdditionalInfoRequested,
    LicenseContext.License.CredentialsVerified,
    LicenseContext.License.ExamResultRecorded,
    LicenseContext.License.ApplicationApproved,
    LicenseContext.License.ApplicationDenied,
    LicenseContext.License.PaymentProcessed,
    LicenseContext.License.LicenseRenewed,
    LicenseContext.License.ComplaintFiled,
    LicenseContext.License.DisciplinaryActionRecorded,
    LicenseContext.License.LicenseSuspended,
    LicenseContext.License.LicenseRevoked,
    LicenseContext.License.LicenseReinstated
  } with {
    briefly "License event alternation"
    described as {
      |Union of all License events, for streaming and event-sourced
      |persistence.
    }
  }
  processor LicenseEventSource as source is {
    outlet LicenseEvents is type LicenseEvent
    handler LicenseSourceHandler is {
      on event License.ApplicationSubmitted is {
        send event License.ApplicationSubmitted to outlet LicenseEvents
      }
      on event License.ApplicationUpdated is {
        send event License.ApplicationUpdated to outlet LicenseEvents
      }
      on event License.AdditionalInfoRequested is {
        send event License.AdditionalInfoRequested to outlet LicenseEvents
      }
      on event License.CredentialsVerified is {
        send event License.CredentialsVerified to outlet LicenseEvents
      }
      on event License.ExamResultRecorded is {
        send event License.ExamResultRecorded to outlet LicenseEvents
      }
      on event License.ApplicationApproved is {
        send event License.ApplicationApproved to outlet LicenseEvents
      }
      on event License.ApplicationDenied is {
        send event License.ApplicationDenied to outlet LicenseEvents
      }
      on event License.PaymentProcessed is {
        send event License.PaymentProcessed to outlet LicenseEvents
      }
      on event License.LicenseRenewed is {
        send event License.LicenseRenewed to outlet LicenseEvents
      }
      on event License.ComplaintFiled is {
        send event License.ComplaintFiled to outlet LicenseEvents
      }
      on event License.DisciplinaryActionRecorded is {
        send event License.DisciplinaryActionRecorded to outlet LicenseEvents
      }
      on event License.LicenseSuspended is {
        send event License.LicenseSuspended to outlet LicenseEvents
      }
      on event License.LicenseRevoked is {
        send event License.LicenseRevoked to outlet LicenseEvents
      }
      on event License.LicenseReinstated is {
        send event License.LicenseReinstated to outlet LicenseEvents
      }
      on other is {
        error "Unexpected message for source LicenseEventSource"
      }
    } with {
      briefly "License source handler"
      described as {
        |Publishes License events onto the outlet.
      }
    }
  } with {
    briefly "License event source"
    described as {
      |Publishes License entity events into the streaming topology.
    }
  }
  processor LicenseEventSink as sink is {
    inlet LicenseInlet is type LicenseEvent
    handler LicenseSinkHandler is {
      on event License.ApplicationSubmitted is {
        tell event License.ApplicationSubmitted to repository LicenseContext.LicenseRepository
      }
      on event License.ApplicationUpdated is {
        tell event License.ApplicationUpdated to repository LicenseContext.LicenseRepository
      }
      on event License.AdditionalInfoRequested is {
        tell event License.AdditionalInfoRequested to repository LicenseContext.LicenseRepository
      }
      on event License.CredentialsVerified is {
        tell event License.CredentialsVerified to repository LicenseContext.LicenseRepository
      }
      on event License.ExamResultRecorded is {
        tell event License.ExamResultRecorded to repository LicenseContext.LicenseRepository
      }
      on event License.ApplicationApproved is {
        tell event License.ApplicationApproved to repository LicenseContext.LicenseRepository
      }
      on event License.ApplicationDenied is {
        tell event License.ApplicationDenied to repository LicenseContext.LicenseRepository
      }
      on event License.PaymentProcessed is {
        tell event License.PaymentProcessed to repository LicenseContext.LicenseRepository
      }
      on event License.LicenseRenewed is {
        tell event License.LicenseRenewed to repository LicenseContext.LicenseRepository
      }
      on event License.ComplaintFiled is {
        tell event License.ComplaintFiled to repository LicenseContext.LicenseRepository
      }
      on event License.DisciplinaryActionRecorded is {
        tell event License.DisciplinaryActionRecorded to repository LicenseContext.LicenseRepository
      }
      on event License.LicenseSuspended is {
        tell event License.LicenseSuspended to repository LicenseContext.LicenseRepository
      }
      on event License.LicenseRevoked is {
        tell event License.LicenseRevoked to repository LicenseContext.LicenseRepository
      }
      on event License.LicenseReinstated is {
        tell event License.LicenseReinstated to repository LicenseContext.LicenseRepository
      }
      on other is {
        error "Unexpected message for sink LicenseEventSink"
      }
    } with {
      briefly "License sink handler"
      described as {
        |Persists License events via the repository.
      }
    }
  } with {
    briefly "License event sink"
    described as {
      |Receives License events for persistence.
    }
  }
  connector LicenseEventFlow is {
    from outlet LicenseContext.LicenseEventSource.LicenseEvents to
      inlet LicenseContext.LicenseEventSink.LicenseInlet
  } with {
    briefly "License event flow"
    described as {
      |Connects the License source to its sink.
    }
  }
  processor LicenseEventSplit is {
    inlet LicenseEventSplitIn is type LicenseEvent
    outlet LicenseEventSplitToLicenseRepository is type LicenseEvent
    outlet LicenseEventSplitToLicenseAnalytics is type LicenseEvent
    outlet LicenseEventSplitToPublicLicenseDirectory is type LicenseEvent
    handler LicenseEventSplitHandler is {
      on event License.ApplicationSubmitted is {
        send event License.ApplicationSubmitted to outlet LicenseEventSplitToLicenseRepository
        send event License.ApplicationSubmitted to outlet LicenseEventSplitToLicenseAnalytics
        send event License.ApplicationSubmitted to outlet LicenseEventSplitToPublicLicenseDirectory
        tell event License.ApplicationSubmitted to entity LicenseContext.License
      }
      on event License.ApplicationUpdated is {
        send event License.ApplicationUpdated to outlet LicenseEventSplitToLicenseRepository
        send event License.ApplicationUpdated to outlet LicenseEventSplitToLicenseAnalytics
        send event License.ApplicationUpdated to outlet LicenseEventSplitToPublicLicenseDirectory
        tell event License.ApplicationUpdated to entity LicenseContext.License
      }
      on event License.AdditionalInfoRequested is {
        send event License.AdditionalInfoRequested to outlet LicenseEventSplitToLicenseRepository
        send event License.AdditionalInfoRequested to outlet LicenseEventSplitToLicenseAnalytics
        send event License.AdditionalInfoRequested to outlet LicenseEventSplitToPublicLicenseDirectory
        tell event License.AdditionalInfoRequested to entity LicenseContext.License
      }
      on event License.CredentialsVerified is {
        send event License.CredentialsVerified to outlet LicenseEventSplitToLicenseRepository
        send event License.CredentialsVerified to outlet LicenseEventSplitToLicenseAnalytics
        send event License.CredentialsVerified to outlet LicenseEventSplitToPublicLicenseDirectory
        tell event License.CredentialsVerified to entity LicenseContext.License
      }
      on event License.ExamResultRecorded is {
        send event License.ExamResultRecorded to outlet LicenseEventSplitToLicenseRepository
        send event License.ExamResultRecorded to outlet LicenseEventSplitToLicenseAnalytics
        send event License.ExamResultRecorded to outlet LicenseEventSplitToPublicLicenseDirectory
        tell event License.ExamResultRecorded to entity LicenseContext.License
      }
      on event License.ApplicationApproved is {
        send event License.ApplicationApproved to outlet LicenseEventSplitToLicenseRepository
        send event License.ApplicationApproved to outlet LicenseEventSplitToLicenseAnalytics
        send event License.ApplicationApproved to outlet LicenseEventSplitToPublicLicenseDirectory
        tell event License.ApplicationApproved to entity LicenseContext.License
      }
      on event License.ApplicationDenied is {
        send event License.ApplicationDenied to outlet LicenseEventSplitToLicenseRepository
        send event License.ApplicationDenied to outlet LicenseEventSplitToLicenseAnalytics
        send event License.ApplicationDenied to outlet LicenseEventSplitToPublicLicenseDirectory
        tell event License.ApplicationDenied to entity LicenseContext.License
      }
      on event License.PaymentProcessed is {
        send event License.PaymentProcessed to outlet LicenseEventSplitToLicenseRepository
        send event License.PaymentProcessed to outlet LicenseEventSplitToLicenseAnalytics
        send event License.PaymentProcessed to outlet LicenseEventSplitToPublicLicenseDirectory
        tell event License.PaymentProcessed to entity LicenseContext.License
      }
      on event License.LicenseRenewed is {
        send event License.LicenseRenewed to outlet LicenseEventSplitToLicenseRepository
        send event License.LicenseRenewed to outlet LicenseEventSplitToLicenseAnalytics
        send event License.LicenseRenewed to outlet LicenseEventSplitToPublicLicenseDirectory
        tell event License.LicenseRenewed to entity LicenseContext.License
      }
      on event License.ComplaintFiled is {
        send event License.ComplaintFiled to outlet LicenseEventSplitToLicenseRepository
        send event License.ComplaintFiled to outlet LicenseEventSplitToLicenseAnalytics
        send event License.ComplaintFiled to outlet LicenseEventSplitToPublicLicenseDirectory
        tell event License.ComplaintFiled to entity LicenseContext.License
      }
      on event License.DisciplinaryActionRecorded is {
        send event License.DisciplinaryActionRecorded to outlet LicenseEventSplitToLicenseRepository
        send event License.DisciplinaryActionRecorded to outlet LicenseEventSplitToLicenseAnalytics
        send event License.DisciplinaryActionRecorded to outlet LicenseEventSplitToPublicLicenseDirectory
        tell event License.DisciplinaryActionRecorded to entity LicenseContext.License
      }
      on event License.LicenseSuspended is {
        send event License.LicenseSuspended to outlet LicenseEventSplitToLicenseRepository
        send event License.LicenseSuspended to outlet LicenseEventSplitToLicenseAnalytics
        send event License.LicenseSuspended to outlet LicenseEventSplitToPublicLicenseDirectory
        tell event License.LicenseSuspended to entity LicenseContext.License
      }
      on event License.LicenseRevoked is {
        send event License.LicenseRevoked to outlet LicenseEventSplitToLicenseRepository
        send event License.LicenseRevoked to outlet LicenseEventSplitToLicenseAnalytics
        send event License.LicenseRevoked to outlet LicenseEventSplitToPublicLicenseDirectory
        tell event License.LicenseRevoked to entity LicenseContext.License
      }
      on event License.LicenseReinstated is {
        send event License.LicenseReinstated to outlet LicenseEventSplitToLicenseRepository
        send event License.LicenseReinstated to outlet LicenseEventSplitToLicenseAnalytics
        send event License.LicenseReinstated to outlet LicenseEventSplitToPublicLicenseDirectory
        tell event License.LicenseReinstated to entity LicenseContext.License
      }
      on other is {
        error "Unexpected message for processor LicenseEventSplit"
      }
    } with {
      briefly "License event fan-out handler"
      described as {
        |Delivers each License event to all of its consumers.
      }
    }
  } with {
    briefly "License event fan-out"
    described as {
      |Fans License events out to the repository and projectors.
    }
  }
  connector LinkLicenseToLicenseEventSplit is {
    from outlet LicenseContext.License.LicenseEvents2 to
      inlet LicenseContext.LicenseEventSplit.LicenseEventSplitIn
  } with {
    briefly "LinkLicenseToLicenseEventSplit"
  }
  connector LinkLicenseEventSplitToLicenseRepository is {
    from outlet LicenseContext.LicenseEventSplit.LicenseEventSplitToLicenseRepository to
      inlet LicenseContext.LicenseRepository.LicenseRepositoryFromLicense
  } with {
    briefly "LinkLicenseEventSplitToLicenseRepository"
  }
  connector LinkLicenseEventSplitToLicenseAnalytics is {
    from outlet LicenseContext.LicenseEventSplit.LicenseEventSplitToLicenseAnalytics to
      inlet LicenseContext.LicenseAnalytics.LicenseAnalyticsFromLicense
  } with {
    briefly "LinkLicenseEventSplitToLicenseAnalytics"
  }
  connector LinkLicenseEventSplitToPublicLicenseDirectory is {
    from outlet LicenseContext.LicenseEventSplit.LicenseEventSplitToPublicLicenseDirectory to
      inlet LicenseContext.PublicLicenseDirectory.PublicLicenseDirectoryFromLicense
  } with {
    briefly "LinkLicenseEventSplitToPublicLicenseDirectory"
  }
  connector LinkLicenseAnalyticsToLicenseRepository is {
    from outlet LicenseContext.LicenseAnalytics.LicenseAnalyticsOut to
      inlet LicenseContext.LicenseRepository.LicenseRepositoryFromLicenseAnalytics
  } with {
    briefly "LinkLicenseAnalyticsToLicenseRepository"
  }
  connector LinkPublicLicenseDirectoryToLicenseRepository is {
    from outlet LicenseContext.PublicLicenseDirectory.PublicLicenseDirectoryOut to
      inlet LicenseContext.LicenseRepository.LicenseRepositoryFromPublicLicenseDirectory
  } with {
    briefly "LinkPublicLicenseDirectoryToLicenseRepository"
  }
} with {
  briefly "License context"
  described as {
    | The License context manages professional
    | and business license processing.
  }
}
