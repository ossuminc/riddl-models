// Licensing - License Context
context LicenseContext as router is {
  inlet LicenseCommandStreamIn is type LicenseCommand  outlet LicenseCommandStreamOut is type LicenseCommand
  inlet LicenseQueryResultStreamIn is type License.LicenseQueryResult  outlet LicenseQueryResultStreamOut is type License.LicenseQueryResult
  handler LicenseContextBoundary is {
    on submitApplication: command License.SubmitApplication is {
      send submitApplication to outlet LicenseContext.LicenseCommandStreamOut
    }
    on updateApplication: command License.UpdateApplication is {
      send updateApplication to outlet LicenseContext.LicenseCommandStreamOut
    }
    on requestAdditionalInfo: command License.RequestAdditionalInfo is {
      send requestAdditionalInfo to outlet LicenseContext.LicenseCommandStreamOut
    }
    on verifyCredentials: command License.VerifyCredentials is {
      send verifyCredentials to outlet LicenseContext.LicenseCommandStreamOut
    }
    on recordExamResult: command License.RecordExamResult is {
      send recordExamResult to outlet LicenseContext.LicenseCommandStreamOut
    }
    on approveApplication: command License.ApproveApplication is {
      send approveApplication to outlet LicenseContext.LicenseCommandStreamOut
    }
    on denyApplication: command License.DenyApplication is {
      send denyApplication to outlet LicenseContext.LicenseCommandStreamOut
    }
    on processPayment: command License.ProcessPayment is {
      send processPayment to outlet LicenseContext.LicenseCommandStreamOut
    }
    on renewLicense: command License.RenewLicense is {
      send renewLicense to outlet LicenseContext.LicenseCommandStreamOut
    }
    on fileComplaint: command License.FileComplaint is {
      send fileComplaint to outlet LicenseContext.LicenseCommandStreamOut
    }
    on recordDisciplinaryAction: command License.RecordDisciplinaryAction is {
      send recordDisciplinaryAction to outlet LicenseContext.LicenseCommandStreamOut
    }
    on suspendLicense: command License.SuspendLicense is {
      send suspendLicense to outlet LicenseContext.LicenseCommandStreamOut
    }
    on revokeLicense: command License.RevokeLicense is {
      send revokeLicense to outlet LicenseContext.LicenseCommandStreamOut
    }
    on reinstateLicense: command License.ReinstateLicense is {
      send reinstateLicense to outlet LicenseContext.LicenseCommandStreamOut
    }
    on licenseQueryResult: result License.LicenseQueryResult is {
      send licenseQueryResult to outlet LicenseContext.LicenseQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the LicenseContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'LicenseCommand Stream Intake' is from outlet LicenseContext.LicenseCommandStreamOut to inlet LicenseContext.License.LicenseCommands  connector 'LicenseQueryResult Stream Egress' is from outlet LicenseContext.LicenseRepository.LicenseRepositoryResponses to inlet LicenseContext.LicenseQueryResultStreamIn  adaptor FromBackgroundCheckService from context BackgroundCheckService is { 
    handler FromBackgroundCheckServiceHandler is {
      on event BackgroundCheckService.BackgroundCheckCompleted is {
        do "the model receives background check completed"
      }
      on result BackgroundCheckService.CheckStatusResult is {
        do "the model receives check status result"
      }
      on other is {
        error "Unexpected message for adaptor FromBackgroundCheckService"
      }
    } with {
      briefly "from background check service"
      described as {
        |Carries messages from the external BackgroundCheckService.
      }
    }
  } with {
    briefly "BackgroundCheckService integration"
    described as {
      |The model's side of the BackgroundCheckService conversation.
    }
  }
  adaptor ToBackgroundCheckService to context BackgroundCheckService is { 
    handler ToBackgroundCheckServiceHandler is {
      on query BackgroundCheckService.GetCheckStatus is {
        do "the model sends get check status"
      }
      on command BackgroundCheckService.RequestBackgroundCheck is {
        do "the model sends request background check"
      }
      on other is {
        error "Unexpected message for adaptor ToBackgroundCheckService"
      }
    } with {
      briefly "to background check service"
      described as {
        |Carries messages to the external BackgroundCheckService.
      }
    }
  } with {
    briefly "BackgroundCheckService integration"
    described as {
      |The model's side of the BackgroundCheckService conversation.
    }
  }
  adaptor FromContinuingEducationService from context ContinuingEducationService is { 
    handler FromContinuingEducationServiceHandler is {
      on event ContinuingEducationService.CECreditRecorded is {
        do "the model receives ce credit recorded"
      }
      on result ContinuingEducationService.CECreditsResult is {
        do "the model receives ce credits result"
      }
      on other is {
        error "Unexpected message for adaptor FromContinuingEducationService"
      }
    } with {
      briefly "from continuing education service"
      described as {
        |Carries messages from the external ContinuingEducationService.
      }
    }
  } with {
    briefly "ContinuingEducationService integration"
    described as {
      |The model's side of the ContinuingEducationService conversation.
    }
  }
  adaptor ToContinuingEducationService to context ContinuingEducationService is { 
    handler ToContinuingEducationServiceHandler is {
      on query ContinuingEducationService.GetCECredits is {
        do "the model sends get ce credits"
      }
      on other is {
        error "Unexpected message for adaptor ToContinuingEducationService"
      }
    } with {
      briefly "to continuing education service"
      described as {
        |Carries messages to the external ContinuingEducationService.
      }
    }
  } with {
    briefly "ContinuingEducationService integration"
    described as {
      |The model's side of the ContinuingEducationService conversation.
    }
  }
  adaptor FromCredentialVerificationService from context CredentialVerificationService is { 
    handler FromCredentialVerificationServiceHandler is {
      on event CredentialVerificationService.EducationVerified is {
        do "the model receives education verified"
      }
      on event CredentialVerificationService.EmploymentVerified is {
        do "the model receives employment verified"
      }
      on event CredentialVerificationService.OtherStateLicenseVerified is {
        do "the model receives other state license verified"
      }
      on other is {
        error "Unexpected message for adaptor FromCredentialVerificationService"
      }
    } with {
      briefly "from credential verification service"
      described as {
        |Carries messages from the external CredentialVerificationService.
      }
    }
  } with {
    briefly "CredentialVerificationService integration"
    described as {
      |The model's side of the CredentialVerificationService conversation.
    }
  }
  adaptor ToCredentialVerificationService to context CredentialVerificationService is { 
    handler ToCredentialVerificationServiceHandler is {
      on command CredentialVerificationService.VerifyEducation is {
        do "the model sends verify education"
      }
      on command CredentialVerificationService.VerifyEmployment is {
        do "the model sends verify employment"
      }
      on command CredentialVerificationService.VerifyOtherStateLicense is {
        do "the model sends verify other state license"
      }
      on other is {
        error "Unexpected message for adaptor ToCredentialVerificationService"
      }
    } with {
      briefly "to credential verification service"
      described as {
        |Carries messages to the external CredentialVerificationService.
      }
    }
  } with {
    briefly "CredentialVerificationService integration"
    described as {
      |The model's side of the CredentialVerificationService conversation.
    }
  }
  adaptor FromExamAdministrationService from context ExamAdministrationService is { 
    handler FromExamAdministrationServiceHandler is {
      on result ExamAdministrationService.AvailableDatesResult is {
        do "the model receives available dates result"
      }
      on event ExamAdministrationService.ExamResultReceived is {
        do "the model receives exam result received"
      }
      on event ExamAdministrationService.ExamScheduled is {
        do "the model receives exam scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromExamAdministrationService"
      }
    } with {
      briefly "from exam administration service"
      described as {
        |Carries messages from the external ExamAdministrationService.
      }
    }
  } with {
    briefly "ExamAdministrationService integration"
    described as {
      |The model's side of the ExamAdministrationService conversation.
    }
  }
  adaptor ToExamAdministrationService to context ExamAdministrationService is { 
    handler ToExamAdministrationServiceHandler is {
      on query ExamAdministrationService.GetAvailableExamDates is {
        do "the model sends get available exam dates"
      }
      on command ExamAdministrationService.ScheduleExam is {
        do "the model sends schedule exam"
      }
      on other is {
        error "Unexpected message for adaptor ToExamAdministrationService"
      }
    } with {
      briefly "to exam administration service"
      described as {
        |Carries messages to the external ExamAdministrationService.
      }
    }
  } with {
    briefly "ExamAdministrationService integration"
    described as {
      |The model's side of the ExamAdministrationService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on event NotificationService.RenewalReminderSent is {
        do "the model receives renewal reminder sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendApplicationNotification is {
        do "the model sends send application notification"
      }
      on command NotificationService.SendRenewalReminder is {
        do "the model sends send renewal reminder"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.PaymentFailed is {
        do "the model receives payment failed"
      }
      on event PaymentProcessingService.PaymentSucceeded is {
        do "the model receives payment succeeded"
      }
      on event PaymentProcessingService.RefundProcessed is {
        do "the model receives refund processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.ProcessFeePayment is {
        do "the model sends process fee payment"
      }
      on command PaymentProcessingService.RefundPayment is {
        do "the model sends refund payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  include "types.riddl"
  include "License.riddl"
  // Repository
  repository LicenseRepository as merge is {
    command PersistApplicationApproved is  {
      licenseId: LicenseId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApplicationApproved applies to.
        }
      }
    } with {
      briefly "Persist ApplicationApproved"
      described as {
        |Instructs this repository to apply ApplicationApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistApplicationDenied is  {
      licenseId: LicenseId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApplicationDenied applies to.
        }
      }
    } with {
      briefly "Persist ApplicationDenied"
      described as {
        |Instructs this repository to apply ApplicationDenied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistApplicationSubmitted is  {
      licenseId: LicenseId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApplicationSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ApplicationSubmitted"
      described as {
        |Instructs this repository to apply ApplicationSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistComplaintFiled is  {
      licenseId: LicenseId with {
        briefly "Row addressed"
        described as {
          |Which stored row ComplaintFiled applies to.
        }
      }
    } with {
      briefly "Persist ComplaintFiled"
      described as {
        |Instructs this repository to apply ComplaintFiled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDisciplinaryActionRecorded is  {
      licenseId: LicenseId with {
        briefly "Row addressed"
        described as {
          |Which stored row DisciplinaryActionRecorded applies to.
        }
      }
    } with {
      briefly "Persist DisciplinaryActionRecorded"
      described as {
        |Instructs this repository to apply DisciplinaryActionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLicenseReinstated is  {
      licenseId: LicenseId with {
        briefly "Row addressed"
        described as {
          |Which stored row LicenseReinstated applies to.
        }
      }
    } with {
      briefly "Persist LicenseReinstated"
      described as {
        |Instructs this repository to apply LicenseReinstated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLicenseRenewed is  {
      licenseId: LicenseId with {
        briefly "Row addressed"
        described as {
          |Which stored row LicenseRenewed applies to.
        }
      }
    } with {
      briefly "Persist LicenseRenewed"
      described as {
        |Instructs this repository to apply LicenseRenewed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLicenseRevoked is  {
      licenseId: LicenseId with {
        briefly "Row addressed"
        described as {
          |Which stored row LicenseRevoked applies to.
        }
      }
    } with {
      briefly "Persist LicenseRevoked"
      described as {
        |Instructs this repository to apply LicenseRevoked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLicenseSuspended is  {
      licenseId: LicenseId with {
        briefly "Row addressed"
        described as {
          |Which stored row LicenseSuspended applies to.
        }
      }
    } with {
      briefly "Persist LicenseSuspended"
      described as {
        |Instructs this repository to apply LicenseSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentProcessed is  {
      licenseId: LicenseId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentProcessed applies to.
        }
      }
    } with {
      briefly "Persist PaymentProcessed"
      described as {
        |Instructs this repository to apply PaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredLicense is  {
      licenseId: LicenseId with {
        briefly "licenseId"
        described as {
          |The licenseId column of the stored license row.
        }
      }
    } with {
      briefly "Stored license row"
      described as {
        |The persistence shape of license data as this repository stores it.
      }
    }
    schema LicenseData is relational
      of licenses as type StoredLicense
        index on field StoredLicense.licenseId
 with {
      briefly "License data schema"
      described as {
        |The relational schema persisting license records for this repository.
      }
    }
    inlet LicenseRepositoryFromLicense is type LicenseEvent    inlet LicenseRepositoryFromLicenseAnalytics is type LicenseEvent    inlet LicenseRepositoryFromPublicLicenseDirectory is type LicenseEvent    outlet LicenseRepositoryResponses is type License.LicenseQueryResult
    query FindLicenseById is  {
      licenseId: LicenseId with {
        briefly "License"
        described as {
          |License identifier.
        }
      }
    } with {
      briefly "Find license by ID"
      described as {
        |Retrieves license by identifier.
      }
    }
    result LicenseResult is  {
      license: License.ActiveStateData with {
        briefly "License"
        described as {
          |License data.
        }
      }
    } with {
      briefly "License result"
      described as {
        |Returns license data.
      }
    }
    query SearchLicenses is  {
      filterProfession: String(1,200)? with {
        briefly "Profession"
        described as {
          |Filter by profession.
        }
      }
      filterLicenseType: LicenseType? with {
        briefly "Type"
        described as {
          |Filter by license type.
        }
      }
      filterStatus: LicenseStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      filterCity: String(1,100)? with {
        briefly "City"
        described as {
          |Filter by city.
        }
      }
      filterState: String(2,50)? with {
        briefly "State"
        described as {
          |Filter by state.
        }
      }
    } with {
      briefly "Search licenses"
      described as {
        |Searches licenses by criteria.
      }
    }
    result LicensesResult is  {
      licenses: License.ActiveStateData+ with {
        briefly "Licenses"
        described as {
          |Matching licenses.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Licenses result"
      described as {
        |Returns matching licenses.
      }
    }
    query FindByApplicant is  {
      applicantId: ApplicantId with {
        briefly "Applicant"
        described as {
          |Applicant identifier.
        }
      }
    } with {
      briefly "Find by applicant"
      described as {
        |Finds licenses for applicant.
      }
    }
    query FindExpiringLicenses is  {
      expirationBefore: Date with {
        briefly "Before"
        described as {
          |Expiration cutoff date.
        }
      }
      filterProfession: String(1,200)? with {
        briefly "Profession"
        described as {
          |Filter by profession.
        }
      }
    } with {
      briefly "Find expiring licenses"
      described as {
        |Finds licenses expiring before date.
      }
    }
    query FindByDisciplinaryStatus is  {
      hasActiveAction: Boolean with {
        briefly "Active action"
        described as {
          |Has active disciplinary action.
        }
      }
      actionType: DisciplinaryAction? with {
        briefly "Action type"
        described as {
          |Filter by action type.
        }
      }
    } with {
      briefly "Find by disciplinary status"
      described as {
        |Finds licenses with disciplinary history.
      }
    }
    handler LicenseRepositoryHandler is {
      on persistApplicationApproved: command PersistApplicationApproved is {
        do "apply ApplicationApproved to the stored row"
      }
      on persistApplicationDenied: command PersistApplicationDenied is {
        do "apply ApplicationDenied to the stored row"
      }
      on persistApplicationSubmitted: command PersistApplicationSubmitted is {
        do "apply ApplicationSubmitted to the stored row"
      }
      on persistComplaintFiled: command PersistComplaintFiled is {
        do "apply ComplaintFiled to the stored row"
      }
      on persistDisciplinaryActionRecorded: command PersistDisciplinaryActionRecorded is {
        do "apply DisciplinaryActionRecorded to the stored row"
      }
      on persistLicenseReinstated: command PersistLicenseReinstated is {
        do "apply LicenseReinstated to the stored row"
      }
      on persistLicenseRenewed: command PersistLicenseRenewed is {
        do "apply LicenseRenewed to the stored row"
      }
      on persistLicenseRevoked: command PersistLicenseRevoked is {
        do "apply LicenseRevoked to the stored row"
      }
      on persistLicenseSuspended: command PersistLicenseSuspended is {
        do "apply LicenseSuspended to the stored row"
      }
      on persistPaymentProcessed: command PersistPaymentProcessed is {
        do "apply PaymentProcessed to the stored row"
      }
      on query GetAnalyticsData is {
        let analyticsDataView: type AnalyticsDataView = prompt("read the analytics data projection")
        reply analyticsDataView
      }
      on query GetDirectoryEntry is {
        let directoryEntryView: type DirectoryEntryView = prompt("read the directory entry projection")
        reply directoryEntryView
      }
      on query FindLicenseById is {
        let licenseResult: type LicenseResult = prompt("read the license from the store")
        reply licenseResult
      }
      on query SearchLicenses is {
        let licensesResult: type LicensesResult = prompt("read the licenses from the store")
        reply licensesResult
      }
      on query FindByApplicant is {
        let licensesResult: type LicensesResult = prompt("read the licenses that by applicant asks for")
        reply licensesResult
      }
      on query FindExpiringLicenses is {
        let licenseResult: type LicenseResult = prompt("read the license from the store")
        reply licenseResult
      }
      on query FindByDisciplinaryStatus is {
        let licensesResult: type LicensesResult = prompt("read the licenses that by disciplinary status asks for")
        reply licensesResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes license queries.
      }
    }
  } with {
    briefly "License repository"
    described as {
      |Persistence for license records.
    }
  }
  // Projector for analytics
  query GetAnalyticsData is  {
    analyticsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which analytics data to retrieve.
      }
    }
  } with {
    briefly "Get analytics data"
    described as {
      |Retrieves the analytics data projection.
    }
  }
  result AnalyticsDataView is  {
    analyticsData: LicenseAnalytics.AnalyticsData with {
      briefly "Analytics data"
      described as {
        |The analytics data being returned.
      }
    }
  } with {
    briefly "Analytics data view"
    described as {
      |Read model view carrying the analytics data projection.
    }
  }
  projector LicenseAnalytics as flow is {
    updates repository LicenseContext.LicenseRepository
    inlet LicenseAnalyticsFromLicense is type LicenseEvent    outlet LicenseAnalyticsOut is type LicenseEvent
    record AnalyticsData is  {
      totalApplications: Natural with {
        briefly "Applications"
        described as {
          |Total applications.
        }
      }
      pendingApplications: Natural with {
        briefly "Pending"
        described as {
          |Pending applications.
        }
      }
      approvedApplications: Natural with {
        briefly "Approved"
        described as {
          |Approved applications.
        }
      }
      deniedApplications: Natural with {
        briefly "Denied"
        described as {
          |Denied applications.
        }
      }
      activeLicenses: Natural with {
        briefly "Active"
        described as {
          |Active licenses.
        }
      }
      suspendedLicenses: Natural with {
        briefly "Suspended"
        described as {
          |Suspended licenses.
        }
      }
      revokedLicenses: Natural with {
        briefly "Revoked"
        described as {
          |Revoked licenses.
        }
      }
      expiringThisMonth: Natural with {
        briefly "Expiring"
        described as {
          |Expiring this month.
        }
      }
      totalRenewalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Renewal revenue.
        }
      }
      openComplaints: Natural with {
        briefly "Complaints"
        described as {
          |Open complaints.
        }
      }
      averageProcessingDays: Decimal(5,2) with {
        briefly "Processing days"
        described as {
          |Average processing time.
        }
      }
      applicationsByProfession: ProfessionCount+ with {
        briefly "By profession"
        described as {
          |Applications by profession.
        }
      }
    } with {
      briefly "Analytics data"
      described as {
        |License analytics metrics.
      }
    }
    record ProfessionCount is  {
      professionName: String(1,200) with {
        briefly "Profession"
        described as {
          |Profession name.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Application count.
        }
      }
    } with {
      briefly "Profession count"
      described as {
        |Count by profession.
      }
    }
    handler AnalyticsHandler is {
      on applicationSubmitted: event License.ApplicationSubmitted is {
        tell command LicenseContext.LicenseRepository.PersistApplicationSubmitted(licenseId = applicationSubmitted.licenseId) to repository LicenseContext.LicenseRepository
      }
      on applicationApproved: event License.ApplicationApproved is {
        tell command LicenseContext.LicenseRepository.PersistApplicationApproved(licenseId = applicationApproved.licenseId) to repository LicenseContext.LicenseRepository
      }
      on applicationDenied: event License.ApplicationDenied is {
        tell command LicenseContext.LicenseRepository.PersistApplicationDenied(licenseId = applicationDenied.licenseId) to repository LicenseContext.LicenseRepository
      }
      on licenseRenewed: event License.LicenseRenewed is {
        tell command LicenseContext.LicenseRepository.PersistLicenseRenewed(licenseId = licenseRenewed.licenseId) to repository LicenseContext.LicenseRepository
      }
      on licenseSuspended: event License.LicenseSuspended is {
        tell command LicenseContext.LicenseRepository.PersistLicenseSuspended(licenseId = licenseSuspended.licenseId) to repository LicenseContext.LicenseRepository
      }
      on licenseRevoked: event License.LicenseRevoked is {
        tell command LicenseContext.LicenseRepository.PersistLicenseRevoked(licenseId = licenseRevoked.licenseId) to repository LicenseContext.LicenseRepository
      }
      on complaintFiled: event License.ComplaintFiled is {
        tell command LicenseContext.LicenseRepository.PersistComplaintFiled(licenseId = complaintFiled.licenseId) to repository LicenseContext.LicenseRepository
      }
      on paymentProcessed: event License.PaymentProcessed is {
        tell command LicenseContext.LicenseRepository.PersistPaymentProcessed(licenseId = paymentProcessed.licenseId) to repository LicenseContext.LicenseRepository
      }
    } with {
      briefly "Processes analytics events"
      described as {
        |Updates analytics from license events.
      }
    }
  } with {
    briefly "License analytics"
    described as {
      |Projects license metrics for reporting.
    }
  }
  // Projector for public license lookup
  query GetDirectoryEntry is  {
    directoryEntryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which directory entry to retrieve.
      }
    }
  } with {
    briefly "Get directory entry"
    described as {
      |Retrieves the directory entry projection.
    }
  }
  result DirectoryEntryView is  {
    directoryEntry: PublicLicenseDirectory.DirectoryEntry with {
      briefly "Directory entry"
      described as {
        |The directory entry being returned.
      }
    }
  } with {
    briefly "Directory entry view"
    described as {
      |Read model view carrying the directory entry projection.
    }
  }
  projector PublicLicenseDirectory as flow is {
    updates repository LicenseContext.LicenseRepository
    inlet PublicLicenseDirectoryFromLicense is type LicenseEvent    outlet PublicLicenseDirectoryOut is type LicenseEvent
    record DirectoryEntry is  {
      licenseNumber: String(1,50) with {
        briefly "Number"
        described as {
          |License number.
        }
      }
      directoryProfession: String(1,200) with {
        briefly "Profession"
        described as {
          |Licensed profession.
        }
      }
      licenseeName: String(1,200) with {
        briefly "Name"
        described as {
          |Licensee name.
        }
      }
      directoryCity: String(1,100) with {
        briefly "City"
        described as {
          |City.
        }
      }
      directoryState: String(2,50) with {
        briefly "State"
        described as {
          |State.
        }
      }
      directoryStatus: LicenseStatus with {
        briefly "Status"
        described as {
          |License status.
        }
      }
      issueDate: Date with {
        briefly "Issued"
        described as {
          |Issue date.
        }
      }
      expirationDate: Date with {
        briefly "Expires"
        described as {
          |Expiration date.
        }
      }
      hasPublicDisciplinaryAction: Boolean with {
        briefly "Disciplinary"
        described as {
          |Has public disciplinary action.
        }
      }
    } with {
      briefly "Directory entry"
      described as {
        |Public license information.
      }
    }
    handler DirectoryHandler is {
      on applicationApproved: event License.ApplicationApproved is {
        tell command LicenseContext.LicenseRepository.PersistApplicationApproved(licenseId = applicationApproved.licenseId) to repository LicenseContext.LicenseRepository
      }
      on licenseRenewed: event License.LicenseRenewed is {
        tell command LicenseContext.LicenseRepository.PersistLicenseRenewed(licenseId = licenseRenewed.licenseId) to repository LicenseContext.LicenseRepository
      }
      on licenseSuspended: event License.LicenseSuspended is {
        tell command LicenseContext.LicenseRepository.PersistLicenseSuspended(licenseId = licenseSuspended.licenseId) to repository LicenseContext.LicenseRepository
      }
      on licenseRevoked: event License.LicenseRevoked is {
        tell command LicenseContext.LicenseRepository.PersistLicenseRevoked(licenseId = licenseRevoked.licenseId) to repository LicenseContext.LicenseRepository
      }
      on licenseReinstated: event License.LicenseReinstated is {
        tell command LicenseContext.LicenseRepository.PersistLicenseReinstated(licenseId = licenseReinstated.licenseId) to repository LicenseContext.LicenseRepository
      }
      on disciplinaryActionRecorded: event License.DisciplinaryActionRecorded is {
        tell command LicenseContext.LicenseRepository.PersistDisciplinaryActionRecorded(licenseId = disciplinaryActionRecorded.licenseId) to repository LicenseContext.LicenseRepository
      }
    } with {
      briefly "Processes directory events"
      described as {
        |Updates public directory from license events.
      }
    }
  } with {
    briefly "Public license directory"
    described as {
      |Projects public license verification data.
    }
  }
  // ---- Event publication for License ----
  type LicenseEvent is one of {
    LicenseContext.License.ApplicationSubmitted or LicenseContext.License.ApplicationUpdated or LicenseContext.License.AdditionalInfoRequested or LicenseContext.License.CredentialsVerified or LicenseContext.License.ExamResultRecorded or LicenseContext.License.ApplicationApproved or LicenseContext.License.ApplicationDenied or LicenseContext.License.PaymentProcessed or LicenseContext.License.LicenseRenewed or LicenseContext.License.ComplaintFiled or LicenseContext.License.DisciplinaryActionRecorded or LicenseContext.License.LicenseSuspended or LicenseContext.License.LicenseRevoked or LicenseContext.License.LicenseReinstated
  } with {
    briefly "License event alternation"
    described as {
      |Union of all License events, for streaming and event-sourced
      |persistence.
    }
  }
  processor LicenseEventSource as source is {
    outlet LicenseEvents is type LicenseEvent
    handler LicenseSourceHandler is {
      on applicationSubmitted: event License.ApplicationSubmitted is {
        send applicationSubmitted to outlet LicenseEvents
      }
      on applicationUpdated: event License.ApplicationUpdated is {
        send applicationUpdated to outlet LicenseEvents
      }
      on additionalInfoRequested: event License.AdditionalInfoRequested is {
        send additionalInfoRequested to outlet LicenseEvents
      }
      on credentialsVerifiedEvent: event License.CredentialsVerified is {
        send credentialsVerifiedEvent to outlet LicenseEvents
      }
      on examResultRecorded: event License.ExamResultRecorded is {
        send examResultRecorded to outlet LicenseEvents
      }
      on applicationApproved: event License.ApplicationApproved is {
        send applicationApproved to outlet LicenseEvents
      }
      on applicationDenied: event License.ApplicationDenied is {
        send applicationDenied to outlet LicenseEvents
      }
      on paymentProcessed: event License.PaymentProcessed is {
        send paymentProcessed to outlet LicenseEvents
      }
      on licenseRenewed: event License.LicenseRenewed is {
        send licenseRenewed to outlet LicenseEvents
      }
      on complaintFiled: event License.ComplaintFiled is {
        send complaintFiled to outlet LicenseEvents
      }
      on disciplinaryActionRecorded: event License.DisciplinaryActionRecorded is {
        send disciplinaryActionRecorded to outlet LicenseEvents
      }
      on licenseSuspended: event License.LicenseSuspended is {
        send licenseSuspended to outlet LicenseEvents
      }
      on licenseRevoked: event License.LicenseRevoked is {
        send licenseRevoked to outlet LicenseEvents
      }
      on licenseReinstated: event License.LicenseReinstated is {
        send licenseReinstated to outlet LicenseEvents
      }
      on other is {
        error "Unexpected message for source LicenseEventSource"
      }
    } with {
      briefly "License source handler"
      described as {
        |Publishes License events onto the outlet.
      }
    }
  } with {
    briefly "License event source"
    described as {
      |Publishes License entity events into the streaming topology.
    }
  }
  processor LicenseEventSink as sink is {
    inlet LicenseInlet is type LicenseEvent    handler LicenseSinkHandler is {
      on applicationSubmitted: event License.ApplicationSubmitted is {
        tell applicationSubmitted to repository LicenseContext.LicenseRepository
      }
      on applicationUpdated: event License.ApplicationUpdated is {
        tell applicationUpdated to repository LicenseContext.LicenseRepository
      }
      on additionalInfoRequested: event License.AdditionalInfoRequested is {
        tell additionalInfoRequested to repository LicenseContext.LicenseRepository
      }
      on credentialsVerifiedEvent: event License.CredentialsVerified is {
        tell credentialsVerifiedEvent to repository LicenseContext.LicenseRepository
      }
      on examResultRecorded: event License.ExamResultRecorded is {
        tell examResultRecorded to repository LicenseContext.LicenseRepository
      }
      on applicationApproved: event License.ApplicationApproved is {
        tell applicationApproved to repository LicenseContext.LicenseRepository
      }
      on applicationDenied: event License.ApplicationDenied is {
        tell applicationDenied to repository LicenseContext.LicenseRepository
      }
      on paymentProcessed: event License.PaymentProcessed is {
        tell paymentProcessed to repository LicenseContext.LicenseRepository
      }
      on licenseRenewed: event License.LicenseRenewed is {
        tell licenseRenewed to repository LicenseContext.LicenseRepository
      }
      on complaintFiled: event License.ComplaintFiled is {
        tell complaintFiled to repository LicenseContext.LicenseRepository
      }
      on disciplinaryActionRecorded: event License.DisciplinaryActionRecorded is {
        tell disciplinaryActionRecorded to repository LicenseContext.LicenseRepository
      }
      on licenseSuspended: event License.LicenseSuspended is {
        tell licenseSuspended to repository LicenseContext.LicenseRepository
      }
      on licenseRevoked: event License.LicenseRevoked is {
        tell licenseRevoked to repository LicenseContext.LicenseRepository
      }
      on licenseReinstated: event License.LicenseReinstated is {
        tell licenseReinstated to repository LicenseContext.LicenseRepository
      }
      on other is {
        error "Unexpected message for sink LicenseEventSink"
      }
    } with {
      briefly "License sink handler"
      described as {
        |Persists License events via the repository.
      }
    }
  } with {
    briefly "License event sink"
    described as {
      |Receives License events for persistence.
    }
  }
  connector LicenseEventFlow is from outlet LicenseContext.LicenseEventSource.LicenseEvents to inlet LicenseContext.LicenseEventSink.LicenseInlet with {
    briefly "License event flow"
    described as {
      |Connects the License source to its sink.
    }
  }
  processor LicenseEventSplit as split is {
    inlet LicenseEventSplitIn is type LicenseEvent    outlet LicenseEventSplitToLicenseRepository is type LicenseEvent
    outlet LicenseEventSplitToLicenseAnalytics is type LicenseEvent
    outlet LicenseEventSplitToPublicLicenseDirectory is type LicenseEvent
    handler LicenseEventSplitHandler is {
      on applicationSubmitted: event License.ApplicationSubmitted is {
        send applicationSubmitted to outlet LicenseEventSplitToLicenseRepository
        send applicationSubmitted to outlet LicenseEventSplitToLicenseAnalytics
        send applicationSubmitted to outlet LicenseEventSplitToPublicLicenseDirectory
        tell applicationSubmitted to entity LicenseContext.License
      }
      on applicationUpdated: event License.ApplicationUpdated is {
        send applicationUpdated to outlet LicenseEventSplitToLicenseRepository
        send applicationUpdated to outlet LicenseEventSplitToLicenseAnalytics
        send applicationUpdated to outlet LicenseEventSplitToPublicLicenseDirectory
        tell applicationUpdated to entity LicenseContext.License
      }
      on additionalInfoRequested: event License.AdditionalInfoRequested is {
        send additionalInfoRequested to outlet LicenseEventSplitToLicenseRepository
        send additionalInfoRequested to outlet LicenseEventSplitToLicenseAnalytics
        send additionalInfoRequested to outlet LicenseEventSplitToPublicLicenseDirectory
        tell additionalInfoRequested to entity LicenseContext.License
      }
      on credentialsVerifiedEvent: event License.CredentialsVerified is {
        send credentialsVerifiedEvent to outlet LicenseEventSplitToLicenseRepository
        send credentialsVerifiedEvent to outlet LicenseEventSplitToLicenseAnalytics
        send credentialsVerifiedEvent to outlet LicenseEventSplitToPublicLicenseDirectory
        tell credentialsVerifiedEvent to entity LicenseContext.License
      }
      on examResultRecorded: event License.ExamResultRecorded is {
        send examResultRecorded to outlet LicenseEventSplitToLicenseRepository
        send examResultRecorded to outlet LicenseEventSplitToLicenseAnalytics
        send examResultRecorded to outlet LicenseEventSplitToPublicLicenseDirectory
        tell examResultRecorded to entity LicenseContext.License
      }
      on applicationApproved: event License.ApplicationApproved is {
        send applicationApproved to outlet LicenseEventSplitToLicenseRepository
        send applicationApproved to outlet LicenseEventSplitToLicenseAnalytics
        send applicationApproved to outlet LicenseEventSplitToPublicLicenseDirectory
        tell applicationApproved to entity LicenseContext.License
      }
      on applicationDenied: event License.ApplicationDenied is {
        send applicationDenied to outlet LicenseEventSplitToLicenseRepository
        send applicationDenied to outlet LicenseEventSplitToLicenseAnalytics
        send applicationDenied to outlet LicenseEventSplitToPublicLicenseDirectory
        tell applicationDenied to entity LicenseContext.License
      }
      on paymentProcessed: event License.PaymentProcessed is {
        send paymentProcessed to outlet LicenseEventSplitToLicenseRepository
        send paymentProcessed to outlet LicenseEventSplitToLicenseAnalytics
        send paymentProcessed to outlet LicenseEventSplitToPublicLicenseDirectory
        tell paymentProcessed to entity LicenseContext.License
      }
      on licenseRenewed: event License.LicenseRenewed is {
        send licenseRenewed to outlet LicenseEventSplitToLicenseRepository
        send licenseRenewed to outlet LicenseEventSplitToLicenseAnalytics
        send licenseRenewed to outlet LicenseEventSplitToPublicLicenseDirectory
        tell licenseRenewed to entity LicenseContext.License
      }
      on complaintFiled: event License.ComplaintFiled is {
        send complaintFiled to outlet LicenseEventSplitToLicenseRepository
        send complaintFiled to outlet LicenseEventSplitToLicenseAnalytics
        send complaintFiled to outlet LicenseEventSplitToPublicLicenseDirectory
        tell complaintFiled to entity LicenseContext.License
      }
      on disciplinaryActionRecorded: event License.DisciplinaryActionRecorded is {
        send disciplinaryActionRecorded to outlet LicenseEventSplitToLicenseRepository
        send disciplinaryActionRecorded to outlet LicenseEventSplitToLicenseAnalytics
        send disciplinaryActionRecorded to outlet LicenseEventSplitToPublicLicenseDirectory
        tell disciplinaryActionRecorded to entity LicenseContext.License
      }
      on licenseSuspended: event License.LicenseSuspended is {
        send licenseSuspended to outlet LicenseEventSplitToLicenseRepository
        send licenseSuspended to outlet LicenseEventSplitToLicenseAnalytics
        send licenseSuspended to outlet LicenseEventSplitToPublicLicenseDirectory
        tell licenseSuspended to entity LicenseContext.License
      }
      on licenseRevoked: event License.LicenseRevoked is {
        send licenseRevoked to outlet LicenseEventSplitToLicenseRepository
        send licenseRevoked to outlet LicenseEventSplitToLicenseAnalytics
        send licenseRevoked to outlet LicenseEventSplitToPublicLicenseDirectory
        tell licenseRevoked to entity LicenseContext.License
      }
      on licenseReinstated: event License.LicenseReinstated is {
        send licenseReinstated to outlet LicenseEventSplitToLicenseRepository
        send licenseReinstated to outlet LicenseEventSplitToLicenseAnalytics
        send licenseReinstated to outlet LicenseEventSplitToPublicLicenseDirectory
        tell licenseReinstated to entity LicenseContext.License
      }
      on other is {
        error "Unexpected message for processor LicenseEventSplit"
      }
    } with {
      briefly "License event fan-out handler"
      described as {
        |Delivers each License event to all of its consumers.
      }
    }
  } with {
    briefly "License event fan-out"
    described as {
      |Fans License events out to the repository and projectors.
    }
  }
  connector 'LicenseEvent Stream' is from outlet LicenseContext.License.LicenseEvents2 to inlet LicenseContext.LicenseEventSplit.LicenseEventSplitIn with {
    briefly "License events, fanned out to storage and read models"
  }
  connector 'LicenseEvent Storage' is from outlet LicenseContext.LicenseEventSplit.LicenseEventSplitToLicenseRepository to inlet LicenseContext.LicenseRepository.LicenseRepositoryFromLicense with {
    briefly "License events on their way to storage"
  }
  connector 'LicenseAnalytics Feed' is from outlet LicenseContext.LicenseEventSplit.LicenseEventSplitToLicenseAnalytics to inlet LicenseContext.LicenseAnalytics.LicenseAnalyticsFromLicense with {
    briefly "License events feeding the LicenseAnalytics projection"
  }
  connector 'PublicLicenseDirectory Feed' is from outlet LicenseContext.LicenseEventSplit.LicenseEventSplitToPublicLicenseDirectory to inlet LicenseContext.PublicLicenseDirectory.PublicLicenseDirectoryFromLicense with {
    briefly "License events feeding the PublicLicenseDirectory projection"
  }
  connector 'LicenseAnalytics Storage' is from outlet LicenseContext.LicenseAnalytics.LicenseAnalyticsOut to inlet LicenseContext.LicenseRepository.LicenseRepositoryFromLicenseAnalytics with {
    briefly "The LicenseAnalytics projection on its way to storage"
  }
  connector 'PublicLicenseDirectory Storage' is from outlet LicenseContext.PublicLicenseDirectory.PublicLicenseDirectoryOut to inlet LicenseContext.LicenseRepository.LicenseRepositoryFromPublicLicenseDirectory with {
    briefly "The PublicLicenseDirectory projection on its way to storage"
  }
} with {
  briefly "License context"
  described as {
    | The License context manages professional
    | and business license processing.
  }
}
