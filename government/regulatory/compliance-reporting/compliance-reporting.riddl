// Compliance Reporting Domain Model
// Regulatory compliance and reporting management
domain ComplianceReporting is {
  persistent connector 'RegulatoryPortalServiceReply Stream' is from outlet RegulatoryPortalService.RegulatoryPortalServiceRepliesOut to inlet ReportContext.ToRegulatoryPortalService.ToRegulatoryPortalServiceReplies with {
    briefly "What RegulatoryPortalService answers ReportContext"
  }
  persistent connector 'RegulatoryCalendarServiceReply Stream' is from outlet RegulatoryCalendarService.RegulatoryCalendarServiceRepliesOut to inlet ReportContext.ToRegulatoryCalendarService.ToRegulatoryCalendarServiceReplies with {
    briefly "What RegulatoryCalendarService answers ReportContext"
  }
  persistent connector 'DocumentManagementServiceReply Stream' is from outlet DocumentManagementService.DocumentManagementServiceRepliesOut to inlet ReportContext.ToDocumentManagementService.ToDocumentManagementServiceReplies with {
    briefly "What DocumentManagementService answers ReportContext"
  }
  persistent connector 'AuditManagementServiceEvent Stream' is from outlet AuditManagementService.AuditManagementServiceEventsOut to inlet ReportContext.FromAuditManagementService.FromAuditManagementServiceIn with {
    briefly "What AuditManagementService tells ReportContext, unasked"
  }
  persistent connector 'DataCollectionServiceEvent Stream' is from outlet DataCollectionService.DataCollectionServiceEventsOut to inlet ReportContext.FromDataCollectionService.FromDataCollectionServiceIn with {
    briefly "What DataCollectionService tells ReportContext, unasked"
  }
  persistent connector 'DocumentManagementServiceEvent Stream' is from outlet DocumentManagementService.DocumentManagementServiceEventsOut to inlet ReportContext.FromDocumentManagementService.FromDocumentManagementServiceIn with {
    briefly "What DocumentManagementService tells ReportContext, unasked"
  }
  persistent connector 'RegulatoryCalendarServiceEvent Stream' is from outlet RegulatoryCalendarService.RegulatoryCalendarServiceEventsOut to inlet ReportContext.FromRegulatoryCalendarService.FromRegulatoryCalendarServiceIn with {
    briefly "What RegulatoryCalendarService tells ReportContext, unasked"
  }
  persistent connector 'RegulatoryPortalServiceEvent Stream' is from outlet RegulatoryPortalService.RegulatoryPortalServiceEventsOut to inlet ReportContext.FromRegulatoryPortalService.FromRegulatoryPortalServiceIn with {
    briefly "What RegulatoryPortalService tells ReportContext, unasked"
  }
  persistent connector 'DataCollectionServiceRequest Stream' is from outlet ReportContext.ToDataCollectionService.ToDataCollectionServiceOut to inlet DataCollectionService.DataCollectionServiceRequests with {
    briefly "What ReportContext asks DataCollectionService to send"
  }
  persistent connector 'RegulatoryPortalServiceRequest Stream' is from outlet ReportContext.ToRegulatoryPortalService.ToRegulatoryPortalServiceOut to inlet RegulatoryPortalService.RegulatoryPortalServiceRequests with {
    briefly "What ReportContext asks RegulatoryPortalService to send"
  }
  persistent connector 'AuditManagementServiceRequest Stream' is from outlet ReportContext.ToAuditManagementService.ToAuditManagementServiceOut to inlet AuditManagementService.AuditManagementServiceRequests with {
    briefly "What ReportContext asks AuditManagementService to send"
  }
  persistent connector 'DocumentManagementServiceRequest Stream' is from outlet ReportContext.ToDocumentManagementService.ToDocumentManagementServiceOut to inlet DocumentManagementService.DocumentManagementServiceRequests with {
    briefly "What ReportContext asks DocumentManagementService to send"
  }
  persistent connector 'RegulatoryCalendarServiceRequest Stream' is from outlet ReportContext.ToRegulatoryCalendarService.ToRegulatoryCalendarServiceOut to inlet RegulatoryCalendarService.RegulatoryCalendarServiceRequests with {
    briefly "What ReportContext asks RegulatoryCalendarService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet ReportContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What ReportContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ComplianceOfficer is "person managing compliance" with {
    briefly "Compliance Officer"
    described as {
      |Person overseeing regulatory compliance.
    }
  }
  user Regulator is "government agency receiving reports" with {
    briefly "Regulator"
    described as {
      |Regulatory agency.
    }
  }
  user Auditor is "person conducting audits" with {
    briefly "Auditor"
    described as {
      |Person auditing compliance.
    }
  }
  epic ComplianceEpic is {
    user ComplianceOfficer wants to "to manage regulatory reporting" so that "the organization meets compliance requirements"
    case SubmitComplianceReport is {
      user ComplianceOfficer wants to "to submit a required report" so that "regulatory obligations are met"
      step is "Officer gathers" "required data" "from systems" with {
        briefly "Gather data"
        described as {
          |Collect report data.
        }
      }
      step is "Officer validates" "report contents" "for accuracy" with {
        briefly "Validate data"
        described as {
          |Check data accuracy.
        }
      }
      step take input ComplianceReportingApp.ComplianceReportingScreen.SubmitReportInput from user ComplianceOfficer with {
        briefly "Submit report"
        described as {
          |File the report.
        }
      }
      step is "System archives" "submission confirmation" "for audit" with {
        briefly "Archive"
        described as {
          |Store submission record.
        }
      }
    } with {
      briefly "Report submission"
      described as {
        |Submitting regulatory reports.
      }
    }
  } with {
    briefly "Compliance management"
    described as {
      | Epic covering compliance reporting,
      | tracking, and audit management.
    }
  }
  include "ReportContext.riddl"
  include "external-contexts.riddl"
  application context ComplianceReportingApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ComplianceReporting are delivered.
      }
    }
    group ComplianceReportingScreen is {
      input SubmitReportInput acquires command ReportContext.Report.SubmitReport with {
        briefly "Submit report control"
        described as {
          |The control through which a user submits the submit report request.
        }
      }
    } with {
      briefly "Compliance reporting screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppReportCommands is type ReportContext.Report.ReportCommand
    inlet AppReportRepositoryResponses is result ReportContext.Report.ReportResult    handler ComplianceReportingAppHandler is {
      on other is {
        error "Unexpected message for application context ComplianceReportingApp"
      }
    } with {
      briefly "ComplianceReportingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ComplianceReportingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ReportCommand Stream' is from outlet ComplianceReportingApp.AppReportCommands to inlet ReportContext.ReportCommandStreamIn with {
    briefly "Report commands from the application"
  }
  persistent connector 'ReportResult Stream' is from outlet ReportContext.ReportResultStreamOut to inlet ComplianceReportingApp.AppReportRepositoryResponses with {
    briefly "Report query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ComplianceReportingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Compliance reporting domain"
  described as {
    | The ComplianceReporting domain handles regulatory
    | compliance and reporting requirements.
  }
}
