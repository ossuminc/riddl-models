// Compliance Reporting - Report Context
context ReportContext is {
  include "types.riddl"
  include "Report.riddl"
  // Repository for report persistence
  repository ReportRepository is {
    schema ReportData is relational
      of reports as type Report
        index on field Report.reportId
        index on field Report.organization.organizationId
        index on field Report.requirement.requirementId

    handler ReportPersistence is {
      on command Report.CreateReport is {
        tell event Report.ReportCreated to entity ReportContext.Report
        prompt "Store new report"
      }
      on command Report.AddSection is {
        tell event Report.SectionAdded to entity ReportContext.Report
        prompt "Store report section"
      }
      on command Report.UpdateSection is {
        tell event Report.SectionUpdated to entity ReportContext.Report
        prompt "Update section"
      }
      on command Report.SubmitForReview is {
        prompt "Update to in review"
      }
      on command Report.ApproveReport is {
        tell event Report.ReportApproved to entity ReportContext.Report
        prompt "Update to approved"
      }
      on command Report.RejectReport is {
        tell event Report.ReportRejected to entity ReportContext.Report
        prompt "Update to rejected"
      }
      on command Report.SubmitReport is {
        tell event Report.ReportSubmitted to entity ReportContext.Report
        prompt "Update to submitted"
      }
      on command Report.RecordAcknowledgment is {
        prompt "Store receipt"
      }
      on command Report.AmendReport is {
        prompt "Store amendment"
      }
      on command Report.RecordFinding is {
        tell event Report.FindingRecorded to entity ReportContext.Report
        prompt "Store finding"
      }
      on command Report.ResolveFinding is {
        prompt "Update finding resolution"
      }
    } with {
      briefly "Persists report commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Report data persistence"
    described as {
      | The ReportRepository provides persistent storage for
      | reports, submissions, and findings.
    }
  }
  // Projector for compliance analytics
  projector ComplianceAnalytics is {
    updates repository ReportContext.ReportRepository
    record ComplianceStats is  {
      totalReports: Natural with {
        briefly "Total"
        described as {
          |Total reports.
        }
      }
      pendingReports: Natural with {
        briefly "Pending"
        described as {
          |Pending reports.
        }
      }
      submittedOnTime: Natural with {
        briefly "On time"
        described as {
          |Submitted on time.
        }
      }
      lateSubmissions: Natural with {
        briefly "Late"
        described as {
          |Late submissions.
        }
      }
      openFindings: Natural with {
        briefly "Open findings"
        described as {
          |Open compliance findings.
        }
      }
      complianceScore: Decimal(5,2) with {
        briefly "Score"
        described as {
          |Compliance score percent.
        }
      }
    } with {
      briefly "Compliance statistics"
      described as {
        |Compliance reporting metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Report.ReportCreated is {
        tell event Report.ReportCreated to repository ReportContext.ReportRepository
        prompt "Update report counts"
      }
      on event Report.ReportSubmitted is {
        tell event Report.ReportSubmitted to repository ReportContext.ReportRepository
        prompt "Update submission metrics"
      }
      on event Report.FindingRecorded is {
        tell event Report.FindingRecorded to repository ReportContext.ReportRepository
        prompt "Update finding counts"
      }
      on event Report.FindingResolved is {
        tell event Report.FindingResolved to repository ReportContext.ReportRepository
        prompt "Update resolution metrics"
      }
    } with {
      briefly "Maintains compliance analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Compliance analytics projections"
    described as {
      |Maintains compliance reporting analytics data.
    }
  }
  // ---- Event publication for Report ----
  type ReportEvent is one of {
    ReportContext.Report.ReportCreated,
    ReportContext.Report.SectionAdded,
    ReportContext.Report.SectionUpdated,
    ReportContext.Report.SubmittedForReview,
    ReportContext.Report.ReportApproved,
    ReportContext.Report.ReportRejected,
    ReportContext.Report.ReportSubmitted,
    ReportContext.Report.AcknowledgmentReceived,
    ReportContext.Report.ReportAmended,
    ReportContext.Report.FindingRecorded,
    ReportContext.Report.FindingResolved
  } with {
    briefly "Report event alternation"
    described as {
      |Union of all Report events, for streaming and event-sourced
      |persistence.
    }
  }
  source ReportEventSource is {
    outlet ReportEvents is type ReportEvent
    handler ReportSourceHandler is {
      on event Report.ReportCreated is {
        send event Report.ReportCreated to outlet ReportEvents
      }
      on event Report.SectionAdded is {
        send event Report.SectionAdded to outlet ReportEvents
      }
      on event Report.SectionUpdated is {
        send event Report.SectionUpdated to outlet ReportEvents
      }
      on event Report.SubmittedForReview is {
        send event Report.SubmittedForReview to outlet ReportEvents
      }
      on event Report.ReportApproved is {
        send event Report.ReportApproved to outlet ReportEvents
      }
      on event Report.ReportRejected is {
        send event Report.ReportRejected to outlet ReportEvents
      }
      on event Report.ReportSubmitted is {
        send event Report.ReportSubmitted to outlet ReportEvents
      }
      on event Report.AcknowledgmentReceived is {
        send event Report.AcknowledgmentReceived to outlet ReportEvents
      }
      on event Report.ReportAmended is {
        send event Report.ReportAmended to outlet ReportEvents
      }
      on event Report.FindingRecorded is {
        send event Report.FindingRecorded to outlet ReportEvents
      }
      on event Report.FindingResolved is {
        send event Report.FindingResolved to outlet ReportEvents
      }
      on other is {
        error "Unexpected message for source ReportEventSource"
      }
    } with {
      briefly "Report source handler"
      described as {
        |Publishes Report events onto the outlet.
      }
    }
  } with {
    briefly "Report event source"
    described as {
      |Publishes Report entity events into the streaming topology.
    }
  }
  sink ReportEventSink is {
    inlet ReportInlet is type ReportEvent
    handler ReportSinkHandler is {
      on event Report.ReportCreated is {
        tell event Report.ReportCreated to repository ReportContext.ReportRepository
      }
      on event Report.SectionAdded is {
        tell event Report.SectionAdded to repository ReportContext.ReportRepository
      }
      on event Report.SectionUpdated is {
        tell event Report.SectionUpdated to repository ReportContext.ReportRepository
      }
      on event Report.SubmittedForReview is {
        tell event Report.SubmittedForReview to repository ReportContext.ReportRepository
      }
      on event Report.ReportApproved is {
        tell event Report.ReportApproved to repository ReportContext.ReportRepository
      }
      on event Report.ReportRejected is {
        tell event Report.ReportRejected to repository ReportContext.ReportRepository
      }
      on event Report.ReportSubmitted is {
        tell event Report.ReportSubmitted to repository ReportContext.ReportRepository
      }
      on event Report.AcknowledgmentReceived is {
        tell event Report.AcknowledgmentReceived to repository ReportContext.ReportRepository
      }
      on event Report.ReportAmended is {
        tell event Report.ReportAmended to repository ReportContext.ReportRepository
      }
      on event Report.FindingRecorded is {
        tell event Report.FindingRecorded to repository ReportContext.ReportRepository
      }
      on event Report.FindingResolved is {
        tell event Report.FindingResolved to repository ReportContext.ReportRepository
      }
      on other is {
        error "Unexpected message for sink ReportEventSink"
      }
    } with {
      briefly "Report sink handler"
      described as {
        |Persists Report events via the repository.
      }
    }
  } with {
    briefly "Report event sink"
    described as {
      |Receives Report events for persistence.
    }
  }
  connector ReportEventFlow is {
    from outlet ReportContext.ReportEventSource.ReportEvents to
      inlet ReportContext.ReportEventSink.ReportInlet
  } with {
    briefly "Report event flow"
    described as {
      |Connects the Report source to its sink.
    }
  }
} with {
  briefly "Bounded context for compliance reporting"
  described as {
    | The ReportContext is the bounded context for
    | regulatory compliance and reporting.
  }
}
