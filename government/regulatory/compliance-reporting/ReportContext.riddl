// Compliance Reporting - Report Context
context ReportContext as router is {
  inlet ReportCommandStreamIn is type ReportCommand  outlet ReportCommandStreamOut is type ReportCommand
  inlet ReportResultStreamIn is result Report.ReportResult  outlet ReportResultStreamOut is result Report.ReportResult
  handler ReportContextBoundary is {
    on createReport: command Report.CreateReport is {
      send createReport to outlet ReportContext.ReportCommandStreamOut
    }
    on addSection: command Report.AddSection is {
      send addSection to outlet ReportContext.ReportCommandStreamOut
    }
    on updateSection: command Report.UpdateSection is {
      send updateSection to outlet ReportContext.ReportCommandStreamOut
    }
    on submitForReview: command Report.SubmitForReview is {
      send submitForReview to outlet ReportContext.ReportCommandStreamOut
    }
    on approveReport: command Report.ApproveReport is {
      send approveReport to outlet ReportContext.ReportCommandStreamOut
    }
    on rejectReport: command Report.RejectReport is {
      send rejectReport to outlet ReportContext.ReportCommandStreamOut
    }
    on submitReport: command Report.SubmitReport is {
      send submitReport to outlet ReportContext.ReportCommandStreamOut
    }
    on recordAcknowledgment: command Report.RecordAcknowledgment is {
      send recordAcknowledgment to outlet ReportContext.ReportCommandStreamOut
    }
    on amendReport: command Report.AmendReport is {
      send amendReport to outlet ReportContext.ReportCommandStreamOut
    }
    on recordFinding: command Report.RecordFinding is {
      send recordFinding to outlet ReportContext.ReportCommandStreamOut
    }
    on resolveFinding: command Report.ResolveFinding is {
      send resolveFinding to outlet ReportContext.ReportCommandStreamOut
    }
    on reportResult: result Report.ReportResult is {
      send reportResult to outlet ReportContext.ReportResultStreamOut
    }
    on other is {
      error "Unexpected message at the ReportContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ReportCommand Stream Intake' is from outlet ReportContext.ReportCommandStreamOut to inlet ReportContext.Report.ReportCommands  connector 'ReportResult Stream Egress' is from outlet ReportContext.ReportRepository.ReportRepositoryResponses to inlet ReportContext.ReportResultStreamIn  adaptor FromAuditManagementService from context AuditManagementService is { 
    handler FromAuditManagementServiceHandler is {
      on event AuditManagementService.AuditCompleted is {
        do "the model receives audit completed"
      }
      on event AuditManagementService.AuditScheduled is {
        do "the model receives audit scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromAuditManagementService"
      }
    } with {
      briefly "from audit management service"
      described as {
        |Carries messages from the external AuditManagementService.
      }
    }
  } with {
    briefly "AuditManagementService integration"
    described as {
      |The model's side of the AuditManagementService conversation.
    }
  }
  adaptor ToAuditManagementService to context AuditManagementService is { 
    handler ToAuditManagementServiceHandler is {
      on command AuditManagementService.RecordAuditResults is {
        do "the model sends record audit results"
      }
      on command AuditManagementService.ScheduleAudit is {
        do "the model sends schedule audit"
      }
      on other is {
        error "Unexpected message for adaptor ToAuditManagementService"
      }
    } with {
      briefly "to audit management service"
      described as {
        |Carries messages to the external AuditManagementService.
      }
    }
  } with {
    briefly "AuditManagementService integration"
    described as {
      |The model's side of the AuditManagementService conversation.
    }
  }
  adaptor FromDataCollectionService from context DataCollectionService is { 
    handler FromDataCollectionServiceHandler is {
      on event DataCollectionService.DataCollected is {
        do "the model receives data collected"
      }
      on event DataCollectionService.DataCollectionFailed is {
        do "the model receives data collection failed"
      }
      on other is {
        error "Unexpected message for adaptor FromDataCollectionService"
      }
    } with {
      briefly "from data collection service"
      described as {
        |Carries messages from the external DataCollectionService.
      }
    }
  } with {
    briefly "DataCollectionService integration"
    described as {
      |The model's side of the DataCollectionService conversation.
    }
  }
  adaptor ToDataCollectionService to context DataCollectionService is { 
    handler ToDataCollectionServiceHandler is {
      on command DataCollectionService.CollectReportData is {
        do "the model sends collect report data"
      }
      on other is {
        error "Unexpected message for adaptor ToDataCollectionService"
      }
    } with {
      briefly "to data collection service"
      described as {
        |Carries messages to the external DataCollectionService.
      }
    }
  } with {
    briefly "DataCollectionService integration"
    described as {
      |The model's side of the DataCollectionService conversation.
    }
  }
  adaptor FromDocumentManagementService from context DocumentManagementService is { 
    handler FromDocumentManagementServiceHandler is {
      on result DocumentManagementService.DocumentContent is {
        do "the model receives document content"
      }
      on event DocumentManagementService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentManagementService"
      }
    } with {
      briefly "from document management service"
      described as {
        |Carries messages from the external DocumentManagementService.
      }
    }
  } with {
    briefly "DocumentManagementService integration"
    described as {
      |The model's side of the DocumentManagementService conversation.
    }
  }
  adaptor ToDocumentManagementService to context DocumentManagementService is { 
    handler ToDocumentManagementServiceHandler is {
      on query DocumentManagementService.GetDocument is {
        do "the model sends get document"
      }
      on command DocumentManagementService.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentManagementService"
      }
    } with {
      briefly "to document management service"
      described as {
        |Carries messages to the external DocumentManagementService.
      }
    }
  } with {
    briefly "DocumentManagementService integration"
    described as {
      |The model's side of the DocumentManagementService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.ConfirmationSent is {
        do "the model receives confirmation sent"
      }
      on event NotificationService.ReminderSent is {
        do "the model receives reminder sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendDeadlineReminder is {
        do "the model sends send deadline reminder"
      }
      on command NotificationService.SendSubmissionConfirmation is {
        do "the model sends send submission confirmation"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromRegulatoryCalendarService from context RegulatoryCalendarService is { 
    handler FromRegulatoryCalendarServiceHandler is {
      on event RegulatoryCalendarService.SubscriptionCreated is {
        do "the model receives subscription created"
      }
      on result RegulatoryCalendarService.UpcomingDeadlines is {
        do "the model receives upcoming deadlines"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryCalendarService"
      }
    } with {
      briefly "from regulatory calendar service"
      described as {
        |Carries messages from the external RegulatoryCalendarService.
      }
    }
  } with {
    briefly "RegulatoryCalendarService integration"
    described as {
      |The model's side of the RegulatoryCalendarService conversation.
    }
  }
  adaptor ToRegulatoryCalendarService to context RegulatoryCalendarService is { 
    handler ToRegulatoryCalendarServiceHandler is {
      on query RegulatoryCalendarService.GetUpcomingDeadlines is {
        do "the model sends get upcoming deadlines"
      }
      on command RegulatoryCalendarService.SubscribeToUpdates is {
        do "the model sends subscribe to updates"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryCalendarService"
      }
    } with {
      briefly "to regulatory calendar service"
      described as {
        |Carries messages to the external RegulatoryCalendarService.
      }
    }
  } with {
    briefly "RegulatoryCalendarService integration"
    described as {
      |The model's side of the RegulatoryCalendarService conversation.
    }
  }
  adaptor FromRegulatoryPortalService from context RegulatoryPortalService is { 
    handler FromRegulatoryPortalServiceHandler is {
      on event RegulatoryPortalService.FilingRejected is {
        do "the model receives filing rejected"
      }
      on result RegulatoryPortalService.FilingStatus is {
        do "the model receives filing status"
      }
      on event RegulatoryPortalService.FilingSubmitted is {
        do "the model receives filing submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryPortalService"
      }
    } with {
      briefly "from regulatory portal service"
      described as {
        |Carries messages from the external RegulatoryPortalService.
      }
    }
  } with {
    briefly "RegulatoryPortalService integration"
    described as {
      |The model's side of the RegulatoryPortalService conversation.
    }
  }
  adaptor ToRegulatoryPortalService to context RegulatoryPortalService is { 
    handler ToRegulatoryPortalServiceHandler is {
      on query RegulatoryPortalService.GetFilingStatus is {
        do "the model sends get filing status"
      }
      on command RegulatoryPortalService.SubmitFiling is {
        do "the model sends submit filing"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryPortalService"
      }
    } with {
      briefly "to regulatory portal service"
      described as {
        |Carries messages to the external RegulatoryPortalService.
      }
    }
  } with {
    briefly "RegulatoryPortalService integration"
    described as {
      |The model's side of the RegulatoryPortalService conversation.
    }
  }
  include "types.riddl"
  include "Report.riddl"
  // Repository for report persistence
  type ReportRepositoryCommand is one of {
    ReportContext.ReportRepository.PersistAcknowledgmentReceived or ReportContext.ReportRepository.PersistFindingRecorded or ReportContext.ReportRepository.PersistFindingResolved or ReportContext.ReportRepository.PersistReportAmended or ReportContext.ReportRepository.PersistReportApproved or ReportContext.ReportRepository.PersistReportCreated or ReportContext.ReportRepository.PersistReportRejected or ReportContext.ReportRepository.PersistReportSubmitted or ReportContext.ReportRepository.PersistSectionAdded or ReportContext.ReportRepository.PersistSectionUpdated or ReportContext.ReportRepository.PersistSubmittedForReview
  } with {
    briefly "Anything that writes ReportRepository"
    described as {
      |The persistence commands ReportRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ReportRepository as flow is {
    inlet ReportRepositoryFromComplianceAnalytics is type ReportRepositoryCommand    command PersistAcknowledgmentReceived is  {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row AcknowledgmentReceived applies to.
        }
      }
    } with {
      briefly "Persist AcknowledgmentReceived"
      described as {
        |Instructs this repository to apply AcknowledgmentReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportAmended is  {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportAmended applies to.
        }
      }
    } with {
      briefly "Persist ReportAmended"
      described as {
        |Instructs this repository to apply ReportAmended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportApproved is  {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportApproved applies to.
        }
      }
    } with {
      briefly "Persist ReportApproved"
      described as {
        |Instructs this repository to apply ReportApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportRejected is  {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportRejected applies to.
        }
      }
    } with {
      briefly "Persist ReportRejected"
      described as {
        |Instructs this repository to apply ReportRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSectionAdded is  {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row SectionAdded applies to.
        }
      }
    } with {
      briefly "Persist SectionAdded"
      described as {
        |Instructs this repository to apply SectionAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSectionUpdated is  {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row SectionUpdated applies to.
        }
      }
    } with {
      briefly "Persist SectionUpdated"
      described as {
        |Instructs this repository to apply SectionUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubmittedForReview is  {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubmittedForReview applies to.
        }
      }
    } with {
      briefly "Persist SubmittedForReview"
      described as {
        |Instructs this repository to apply SubmittedForReview to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFindingRecorded is  {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row FindingRecorded applies to.
        }
      }
    } with {
      briefly "Persist FindingRecorded"
      described as {
        |Instructs this repository to apply FindingRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFindingResolved is  {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row FindingResolved applies to.
        }
      }
    } with {
      briefly "Persist FindingResolved"
      described as {
        |Instructs this repository to apply FindingResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportCreated is  {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportCreated applies to.
        }
      }
    } with {
      briefly "Persist ReportCreated"
      described as {
        |Instructs this repository to apply ReportCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportSubmitted is  {
      reportId: ReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ReportSubmitted"
      described as {
        |Instructs this repository to apply ReportSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ReportRepositoryResponses is result Report.ReportResult
    record StoredReport is  {
      reportId: ReportId with {
        briefly "reportId"
        described as {
          |The reportId column of the stored report row.
        }
      }
      organization: OrganizationInfo with {
        briefly "organization"
        described as {
          |The organization column of the stored report row.
        }
      }
      requirement: ComplianceRequirement with {
        briefly "requirement"
        described as {
          |The requirement column of the stored report row.
        }
      }
    } with {
      briefly "Stored report row"
      described as {
        |The persistence shape of report data as this repository stores it.
      }
    }
    schema ReportData is relational
      of reports as record StoredReport
        index on field StoredReport.reportId
        index on field StoredReport.organization.organizationId
        index on field StoredReport.requirement.requirementId
 with {
      briefly "Report data schema"
      described as {
        |The relational schema holding report data for the ReportRepository.
      }
    }
    handler ReportPersistence is {
      on persistAcknowledgmentReceived: command PersistAcknowledgmentReceived is {
        do "apply AcknowledgmentReceived to the stored row"
      }
      on persistReportAmended: command PersistReportAmended is {
        do "apply ReportAmended to the stored row"
      }
      on persistReportApproved: command PersistReportApproved is {
        do "apply ReportApproved to the stored row"
      }
      on persistReportRejected: command PersistReportRejected is {
        do "apply ReportRejected to the stored row"
      }
      on persistSectionAdded: command PersistSectionAdded is {
        do "apply SectionAdded to the stored row"
      }
      on persistSectionUpdated: command PersistSectionUpdated is {
        do "apply SectionUpdated to the stored row"
      }
      on persistSubmittedForReview: command PersistSubmittedForReview is {
        do "apply SubmittedForReview to the stored row"
      }
      on persistFindingRecorded: command PersistFindingRecorded is {
        do "apply FindingRecorded to the stored row"
      }
      on persistFindingResolved: command PersistFindingResolved is {
        do "apply FindingResolved to the stored row"
      }
      on persistReportCreated: command PersistReportCreated is {
        do "apply ReportCreated to the stored row"
      }
      on persistReportSubmitted: command PersistReportSubmitted is {
        do "apply ReportSubmitted to the stored row"
      }
      on query GetComplianceStats is {
        let complianceStatsView: type ComplianceStatsView = prompt("read the compliance stats projection")
        reply complianceStatsView
      }
    } with {
      briefly "Persists report commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Report data persistence"
    described as {
      | The ReportRepository provides persistent storage for
      | reports, submissions, and findings.
    }
  }
  // Projector for compliance analytics
  query GetComplianceStats replies result ComplianceStatsView is  {
    complianceStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which compliance stats to retrieve.
      }
    }
  } with {
    briefly "Get compliance stats"
    described as {
      |Retrieves the compliance stats projection.
    }
  }
  result ComplianceStatsView is  {
    complianceStats: ComplianceAnalytics.ComplianceStats with {
      briefly "Compliance stats"
      described as {
        |The compliance stats being returned.
      }
    }
  } with {
    briefly "Compliance stats view"
    described as {
      |Read model view carrying the compliance stats projection.
    }
  }
  projector ComplianceAnalytics as flow is {
    updates repository ReportContext.ReportRepository
    outlet ComplianceAnalyticsToRepository is type ReportRepositoryCommand
    inlet ComplianceAnalyticsFromReport is type ReportEvent    record ComplianceStats is  {
      totalReports: Natural with {
        briefly "Total"
        described as {
          |Total reports.
        }
      }
      pendingReports: Natural with {
        briefly "Pending"
        described as {
          |Pending reports.
        }
      }
      submittedOnTime: Natural with {
        briefly "On time"
        described as {
          |Submitted on time.
        }
      }
      lateSubmissions: Natural with {
        briefly "Late"
        described as {
          |Late submissions.
        }
      }
      openFindings: Natural with {
        briefly "Open findings"
        described as {
          |Open compliance findings.
        }
      }
      complianceScore: Decimal(5,2) with {
        briefly "Score"
        described as {
          |Compliance score percent.
        }
      }
    } with {
      briefly "Compliance statistics"
      described as {
        |Compliance reporting metrics.
      }
    }
    handler AnalyticsHandler is {
      on acknowledgmentReceived: event Report.AcknowledgmentReceived is {
        tell command ReportContext.ReportRepository.PersistAcknowledgmentReceived(reportId = acknowledgmentReceived.reportId) to repository ReportContext.ReportRepository
        do "apply AcknowledgmentReceived to the ComplianceAnalytics projection"
      }
      on reportAmended: event Report.ReportAmended is {
        tell command ReportContext.ReportRepository.PersistReportAmended(reportId = reportAmended.reportId) to repository ReportContext.ReportRepository
        do "apply ReportAmended to the ComplianceAnalytics projection"
      }
      on reportApproved: event Report.ReportApproved is {
        tell command ReportContext.ReportRepository.PersistReportApproved(reportId = reportApproved.reportId) to repository ReportContext.ReportRepository
        do "apply ReportApproved to the ComplianceAnalytics projection"
      }
      on reportRejected: event Report.ReportRejected is {
        tell command ReportContext.ReportRepository.PersistReportRejected(reportId = reportRejected.reportId) to repository ReportContext.ReportRepository
        do "apply ReportRejected to the ComplianceAnalytics projection"
      }
      on sectionAdded: event Report.SectionAdded is {
        tell command ReportContext.ReportRepository.PersistSectionAdded(reportId = sectionAdded.reportId) to repository ReportContext.ReportRepository
        do "apply SectionAdded to the ComplianceAnalytics projection"
      }
      on sectionUpdated: event Report.SectionUpdated is {
        tell command ReportContext.ReportRepository.PersistSectionUpdated(reportId = sectionUpdated.reportId) to repository ReportContext.ReportRepository
        do "apply SectionUpdated to the ComplianceAnalytics projection"
      }
      on submittedForReview: event Report.SubmittedForReview is {
        tell command ReportContext.ReportRepository.PersistSubmittedForReview(reportId = submittedForReview.reportId) to repository ReportContext.ReportRepository
        do "apply SubmittedForReview to the ComplianceAnalytics projection"
      }
      on reportCreated: event Report.ReportCreated is {
        tell command ReportContext.ReportRepository.PersistReportCreated(reportId = reportCreated.reportId) to repository ReportContext.ReportRepository
        do "Update report counts"
      }
      on reportSubmitted: event Report.ReportSubmitted is {
        tell command ReportContext.ReportRepository.PersistReportSubmitted(reportId = reportSubmitted.reportId) to repository ReportContext.ReportRepository
        do "Update submission metrics"
      }
      on findingRecorded: event Report.FindingRecorded is {
        tell command ReportContext.ReportRepository.PersistFindingRecorded(reportId = findingRecorded.reportId) to repository ReportContext.ReportRepository
        do "Update finding counts"
      }
      on findingResolved: event Report.FindingResolved is {
        tell command ReportContext.ReportRepository.PersistFindingResolved(reportId = findingResolved.reportId) to repository ReportContext.ReportRepository
        do "Update resolution metrics"
      }
    } with {
      briefly "Maintains compliance analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Compliance analytics projections"
    described as {
      |Maintains compliance reporting analytics data.
    }
  }
  // ---- Event publication for Report ----
  type ReportEvent is one of {
    ReportContext.Report.ReportCreated or ReportContext.Report.SectionAdded or ReportContext.Report.SectionUpdated or ReportContext.Report.SubmittedForReview or ReportContext.Report.ReportApproved or ReportContext.Report.ReportRejected or ReportContext.Report.ReportSubmitted or ReportContext.Report.AcknowledgmentReceived or ReportContext.Report.ReportAmended or ReportContext.Report.FindingRecorded or ReportContext.Report.FindingResolved
  } with {
    briefly "Report event alternation"
    described as {
      |Union of all Report events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ReportEventSplit as flow is {
    inlet ReportEventSplitIn is type ReportEvent    outlet ReportEventSplitToComplianceAnalytics is type ReportEvent
    handler ReportEventSplitHandler is {
      on reportCreated: event Report.ReportCreated is {
        send reportCreated to outlet ReportEventSplitToComplianceAnalytics
        tell reportCreated to entity ReportContext.Report
      }
      on sectionAdded: event Report.SectionAdded is {
        send sectionAdded to outlet ReportEventSplitToComplianceAnalytics
        tell sectionAdded to entity ReportContext.Report
      }
      on sectionUpdated: event Report.SectionUpdated is {
        send sectionUpdated to outlet ReportEventSplitToComplianceAnalytics
        tell sectionUpdated to entity ReportContext.Report
      }
      on submittedForReview: event Report.SubmittedForReview is {
        send submittedForReview to outlet ReportEventSplitToComplianceAnalytics
        tell submittedForReview to entity ReportContext.Report
      }
      on reportApproved: event Report.ReportApproved is {
        send reportApproved to outlet ReportEventSplitToComplianceAnalytics
        tell reportApproved to entity ReportContext.Report
      }
      on reportRejected: event Report.ReportRejected is {
        send reportRejected to outlet ReportEventSplitToComplianceAnalytics
        tell reportRejected to entity ReportContext.Report
      }
      on reportSubmitted: event Report.ReportSubmitted is {
        send reportSubmitted to outlet ReportEventSplitToComplianceAnalytics
        tell reportSubmitted to entity ReportContext.Report
      }
      on acknowledgmentReceived: event Report.AcknowledgmentReceived is {
        send acknowledgmentReceived to outlet ReportEventSplitToComplianceAnalytics
        tell acknowledgmentReceived to entity ReportContext.Report
      }
      on reportAmended: event Report.ReportAmended is {
        send reportAmended to outlet ReportEventSplitToComplianceAnalytics
        tell reportAmended to entity ReportContext.Report
      }
      on findingRecorded: event Report.FindingRecorded is {
        send findingRecorded to outlet ReportEventSplitToComplianceAnalytics
        tell findingRecorded to entity ReportContext.Report
      }
      on findingResolved: event Report.FindingResolved is {
        send findingResolved to outlet ReportEventSplitToComplianceAnalytics
        tell findingResolved to entity ReportContext.Report
      }
      on other is {
        error "Unexpected message for processor ReportEventSplit"
      }
    } with {
      briefly "Report event fan-out handler"
      described as {
        |Delivers each Report event to all of its consumers.
      }
    }
  } with {
    briefly "Report event fan-out"
    described as {
      |Fans Report events out to the repository and projectors.
    }
  }
  connector 'ReportEvent Stream' is from outlet ReportContext.Report.ReportEvents2 to inlet ReportContext.ReportEventSplit.ReportEventSplitIn with {
    briefly "Report events, fanned out to storage and read models"
  }
  connector 'ComplianceAnalytics Feed' is from outlet ReportContext.ReportEventSplit.ReportEventSplitToComplianceAnalytics to inlet ReportContext.ComplianceAnalytics.ComplianceAnalyticsFromReport with {
    briefly "Report events feeding the ComplianceAnalytics projection"
  }
  connector 'ComplianceAnalytics Storage' is from outlet ReportContext.ComplianceAnalytics.ComplianceAnalyticsToRepository to inlet ReportContext.ReportRepository.ReportRepositoryFromComplianceAnalytics with {
    briefly "ComplianceAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for compliance reporting"
  described as {
    | The ReportContext is the bounded context for
    | regulatory compliance and reporting.
  }
}
