// Compliance Reporting - Report Context
context ReportContext is {
  adaptor FromAuditManagementService from context AuditManagementService is {
    handler FromAuditManagementServiceHandler is {
      on event AuditManagementService.AuditCompleted is {
        do "the model receives audit completed"
      }
      on event AuditManagementService.AuditScheduled is {
        do "the model receives audit scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromAuditManagementService"
      }
    } with {
      briefly "from audit management service"
      described as {
        |Carries messages from the external AuditManagementService.
      }
    }
  } with {
      briefly "AuditManagementService integration"
    described as {
      |The model's side of the AuditManagementService conversation.
    }
  }
  adaptor ToAuditManagementService to context AuditManagementService is {
    handler ToAuditManagementServiceHandler is {
      on command AuditManagementService.RecordAuditResults is {
        do "the model sends record audit results"
      }
      on command AuditManagementService.ScheduleAudit is {
        do "the model sends schedule audit"
      }
      on other is {
        error "Unexpected message for adaptor ToAuditManagementService"
      }
    } with {
      briefly "to audit management service"
      described as {
        |Carries messages to the external AuditManagementService.
      }
    }
  } with {
      briefly "AuditManagementService integration"
    described as {
      |The model's side of the AuditManagementService conversation.
    }
  }
  adaptor FromDataCollectionService from context DataCollectionService is {
    handler FromDataCollectionServiceHandler is {
      on event DataCollectionService.DataCollected is {
        do "the model receives data collected"
      }
      on event DataCollectionService.DataCollectionFailed is {
        do "the model receives data collection failed"
      }
      on other is {
        error "Unexpected message for adaptor FromDataCollectionService"
      }
    } with {
      briefly "from data collection service"
      described as {
        |Carries messages from the external DataCollectionService.
      }
    }
  } with {
      briefly "DataCollectionService integration"
    described as {
      |The model's side of the DataCollectionService conversation.
    }
  }
  adaptor ToDataCollectionService to context DataCollectionService is {
    handler ToDataCollectionServiceHandler is {
      on command DataCollectionService.CollectReportData is {
        do "the model sends collect report data"
      }
      on other is {
        error "Unexpected message for adaptor ToDataCollectionService"
      }
    } with {
      briefly "to data collection service"
      described as {
        |Carries messages to the external DataCollectionService.
      }
    }
  } with {
      briefly "DataCollectionService integration"
    described as {
      |The model's side of the DataCollectionService conversation.
    }
  }
  adaptor FromDocumentManagementService from context DocumentManagementService is {
    handler FromDocumentManagementServiceHandler is {
      on result DocumentManagementService.DocumentContent is {
        do "the model receives document content"
      }
      on event DocumentManagementService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentManagementService"
      }
    } with {
      briefly "from document management service"
      described as {
        |Carries messages from the external DocumentManagementService.
      }
    }
  } with {
      briefly "DocumentManagementService integration"
    described as {
      |The model's side of the DocumentManagementService conversation.
    }
  }
  adaptor ToDocumentManagementService to context DocumentManagementService is {
    handler ToDocumentManagementServiceHandler is {
      on query DocumentManagementService.GetDocument is {
        do "the model sends get document"
      }
      on command DocumentManagementService.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentManagementService"
      }
    } with {
      briefly "to document management service"
      described as {
        |Carries messages to the external DocumentManagementService.
      }
    }
  } with {
      briefly "DocumentManagementService integration"
    described as {
      |The model's side of the DocumentManagementService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is {
    handler FromNotificationServiceHandler is {
      on event NotificationService.ConfirmationSent is {
        do "the model receives confirmation sent"
      }
      on event NotificationService.ReminderSent is {
        do "the model receives reminder sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is {
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendDeadlineReminder is {
        do "the model sends send deadline reminder"
      }
      on command NotificationService.SendSubmissionConfirmation is {
        do "the model sends send submission confirmation"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromRegulatoryCalendarService from context RegulatoryCalendarService is {
    handler FromRegulatoryCalendarServiceHandler is {
      on event RegulatoryCalendarService.SubscriptionCreated is {
        do "the model receives subscription created"
      }
      on result RegulatoryCalendarService.UpcomingDeadlines is {
        do "the model receives upcoming deadlines"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryCalendarService"
      }
    } with {
      briefly "from regulatory calendar service"
      described as {
        |Carries messages from the external RegulatoryCalendarService.
      }
    }
  } with {
      briefly "RegulatoryCalendarService integration"
    described as {
      |The model's side of the RegulatoryCalendarService conversation.
    }
  }
  adaptor ToRegulatoryCalendarService to context RegulatoryCalendarService is {
    handler ToRegulatoryCalendarServiceHandler is {
      on query RegulatoryCalendarService.GetUpcomingDeadlines is {
        do "the model sends get upcoming deadlines"
      }
      on command RegulatoryCalendarService.SubscribeToUpdates is {
        do "the model sends subscribe to updates"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryCalendarService"
      }
    } with {
      briefly "to regulatory calendar service"
      described as {
        |Carries messages to the external RegulatoryCalendarService.
      }
    }
  } with {
      briefly "RegulatoryCalendarService integration"
    described as {
      |The model's side of the RegulatoryCalendarService conversation.
    }
  }
  adaptor FromRegulatoryPortalService from context RegulatoryPortalService is {
    handler FromRegulatoryPortalServiceHandler is {
      on event RegulatoryPortalService.FilingRejected is {
        do "the model receives filing rejected"
      }
      on result RegulatoryPortalService.FilingStatus is {
        do "the model receives filing status"
      }
      on event RegulatoryPortalService.FilingSubmitted is {
        do "the model receives filing submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryPortalService"
      }
    } with {
      briefly "from regulatory portal service"
      described as {
        |Carries messages from the external RegulatoryPortalService.
      }
    }
  } with {
      briefly "RegulatoryPortalService integration"
    described as {
      |The model's side of the RegulatoryPortalService conversation.
    }
  }
  adaptor ToRegulatoryPortalService to context RegulatoryPortalService is {
    handler ToRegulatoryPortalServiceHandler is {
      on query RegulatoryPortalService.GetFilingStatus is {
        do "the model sends get filing status"
      }
      on command RegulatoryPortalService.SubmitFiling is {
        do "the model sends submit filing"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryPortalService"
      }
    } with {
      briefly "to regulatory portal service"
      described as {
        |Carries messages to the external RegulatoryPortalService.
      }
    }
  } with {
      briefly "RegulatoryPortalService integration"
    described as {
      |The model's side of the RegulatoryPortalService conversation.
    }
  }
  include "types.riddl"
  include "Report.riddl"
  // Repository for report persistence
  repository ReportRepository is {
    inlet ReportRepositoryFromReport is type ReportEvent
    inlet ReportRepositoryFromComplianceAnalytics is type ReportEvent
    outlet ReportRepositoryResponses is type Report.ReportResult
    record StoredReport is {
      reportId: ReportId with {
        briefly "reportId"
        described as {
          |The reportId column of the stored report row.
        }
      }
      organization: OrganizationInfo with {
        briefly "organization"
        described as {
          |The organization column of the stored report row.
        }
      }
      requirement: ComplianceRequirement with {
        briefly "requirement"
        described as {
          |The requirement column of the stored report row.
        }
      }
    } with {
      briefly "Stored report row"
      described as {
        |The persistence shape of report data as this repository stores it.
      }
    }
    schema ReportData is relational
      of reports as type StoredReport
        index on field StoredReport.reportId
        index on field StoredReport.organization.organizationId
        index on field StoredReport.requirement.requirementId
      with {
      briefly "Report data schema"
      described as {
        |The relational schema holding report data for the ReportRepository.
      }
    }

    handler ReportPersistence is {
      on query GetComplianceStats is {
        do "read the compliance stats projection"
        yield result ComplianceStatsView
      }
      on command Report.CreateReport is {
        tell event Report.ReportCreated to entity ReportContext.Report
        do "Store new report"
      }
      on command Report.AddSection is {
        tell event Report.SectionAdded to entity ReportContext.Report
        do "Store report section"
      }
      on command Report.UpdateSection is {
        tell event Report.SectionUpdated to entity ReportContext.Report
        do "Update section"
      }
      on command Report.SubmitForReview is {
        do "Update to in review"
      }
      on command Report.ApproveReport is {
        tell event Report.ReportApproved to entity ReportContext.Report
        do "Update to approved"
      }
      on command Report.RejectReport is {
        tell event Report.ReportRejected to entity ReportContext.Report
        do "Update to rejected"
      }
      on command Report.SubmitReport is {
        tell event Report.ReportSubmitted to entity ReportContext.Report
        do "Update to submitted"
      }
      on command Report.RecordAcknowledgment is {
        do "Store receipt"
      }
      on command Report.AmendReport is {
        do "Store amendment"
      }
      on command Report.RecordFinding is {
        tell event Report.FindingRecorded to entity ReportContext.Report
        do "Store finding"
      }
      on command Report.ResolveFinding is {
        do "Update finding resolution"
      }
    } with {
      briefly "Persists report commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Report data persistence"
    described as {
      | The ReportRepository provides persistent storage for
      | reports, submissions, and findings.
    }
  }
  // Projector for compliance analytics
  query GetComplianceStats is {
    complianceStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which compliance stats to retrieve.
      }
    }
  } with {
    briefly "Get compliance stats"
    described as {
      |Retrieves the compliance stats projection.
    }
  }
  result ComplianceStatsView is {
    complianceStats: ComplianceAnalytics.ComplianceStats with {
      briefly "Compliance stats"
      described as {
        |The compliance stats being returned.
      }
    }
  } with {
    briefly "Compliance stats view"
    described as {
      |Read model view carrying the compliance stats projection.
    }
  }
  projector ComplianceAnalytics is {
    inlet ComplianceAnalyticsFromReport is type ReportEvent
    outlet ComplianceAnalyticsOut is type ReportEvent
    updates repository ReportContext.ReportRepository
    record ComplianceStats is  {
      totalReports: Natural with {
        briefly "Total"
        described as {
          |Total reports.
        }
      }
      pendingReports: Natural with {
        briefly "Pending"
        described as {
          |Pending reports.
        }
      }
      submittedOnTime: Natural with {
        briefly "On time"
        described as {
          |Submitted on time.
        }
      }
      lateSubmissions: Natural with {
        briefly "Late"
        described as {
          |Late submissions.
        }
      }
      openFindings: Natural with {
        briefly "Open findings"
        described as {
          |Open compliance findings.
        }
      }
      complianceScore: Decimal(5,2) with {
        briefly "Score"
        described as {
          |Compliance score percent.
        }
      }
    } with {
      briefly "Compliance statistics"
      described as {
        |Compliance reporting metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Report.ReportCreated is {
        tell event Report.ReportCreated to repository ReportContext.ReportRepository
        do "Update report counts"
      }
      on event Report.ReportSubmitted is {
        tell event Report.ReportSubmitted to repository ReportContext.ReportRepository
        do "Update submission metrics"
      }
      on event Report.FindingRecorded is {
        tell event Report.FindingRecorded to repository ReportContext.ReportRepository
        do "Update finding counts"
      }
      on event Report.FindingResolved is {
        tell event Report.FindingResolved to repository ReportContext.ReportRepository
        do "Update resolution metrics"
      }
    } with {
      briefly "Maintains compliance analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Compliance analytics projections"
    described as {
      |Maintains compliance reporting analytics data.
    }
  }
  // ---- Event publication for Report ----
  type ReportEvent is one of {
    ReportContext.Report.ReportCreated,
    ReportContext.Report.SectionAdded,
    ReportContext.Report.SectionUpdated,
    ReportContext.Report.SubmittedForReview,
    ReportContext.Report.ReportApproved,
    ReportContext.Report.ReportRejected,
    ReportContext.Report.ReportSubmitted,
    ReportContext.Report.AcknowledgmentReceived,
    ReportContext.Report.ReportAmended,
    ReportContext.Report.FindingRecorded,
    ReportContext.Report.FindingResolved
  } with {
    briefly "Report event alternation"
    described as {
      |Union of all Report events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ReportEventSource as source is {
    outlet ReportEvents is type ReportEvent
    handler ReportSourceHandler is {
      on event Report.ReportCreated is {
        send event Report.ReportCreated to outlet ReportEvents
      }
      on event Report.SectionAdded is {
        send event Report.SectionAdded to outlet ReportEvents
      }
      on event Report.SectionUpdated is {
        send event Report.SectionUpdated to outlet ReportEvents
      }
      on event Report.SubmittedForReview is {
        send event Report.SubmittedForReview to outlet ReportEvents
      }
      on event Report.ReportApproved is {
        send event Report.ReportApproved to outlet ReportEvents
      }
      on event Report.ReportRejected is {
        send event Report.ReportRejected to outlet ReportEvents
      }
      on event Report.ReportSubmitted is {
        send event Report.ReportSubmitted to outlet ReportEvents
      }
      on event Report.AcknowledgmentReceived is {
        send event Report.AcknowledgmentReceived to outlet ReportEvents
      }
      on event Report.ReportAmended is {
        send event Report.ReportAmended to outlet ReportEvents
      }
      on event Report.FindingRecorded is {
        send event Report.FindingRecorded to outlet ReportEvents
      }
      on event Report.FindingResolved is {
        send event Report.FindingResolved to outlet ReportEvents
      }
      on other is {
        error "Unexpected message for source ReportEventSource"
      }
    } with {
      briefly "Report source handler"
      described as {
        |Publishes Report events onto the outlet.
      }
    }
  } with {
    briefly "Report event source"
    described as {
      |Publishes Report entity events into the streaming topology.
    }
  }
  processor ReportEventSink as sink is {
    inlet ReportInlet is type ReportEvent
    handler ReportSinkHandler is {
      on event Report.ReportCreated is {
        tell event Report.ReportCreated to repository ReportContext.ReportRepository
      }
      on event Report.SectionAdded is {
        tell event Report.SectionAdded to repository ReportContext.ReportRepository
      }
      on event Report.SectionUpdated is {
        tell event Report.SectionUpdated to repository ReportContext.ReportRepository
      }
      on event Report.SubmittedForReview is {
        tell event Report.SubmittedForReview to repository ReportContext.ReportRepository
      }
      on event Report.ReportApproved is {
        tell event Report.ReportApproved to repository ReportContext.ReportRepository
      }
      on event Report.ReportRejected is {
        tell event Report.ReportRejected to repository ReportContext.ReportRepository
      }
      on event Report.ReportSubmitted is {
        tell event Report.ReportSubmitted to repository ReportContext.ReportRepository
      }
      on event Report.AcknowledgmentReceived is {
        tell event Report.AcknowledgmentReceived to repository ReportContext.ReportRepository
      }
      on event Report.ReportAmended is {
        tell event Report.ReportAmended to repository ReportContext.ReportRepository
      }
      on event Report.FindingRecorded is {
        tell event Report.FindingRecorded to repository ReportContext.ReportRepository
      }
      on event Report.FindingResolved is {
        tell event Report.FindingResolved to repository ReportContext.ReportRepository
      }
      on other is {
        error "Unexpected message for sink ReportEventSink"
      }
    } with {
      briefly "Report sink handler"
      described as {
        |Persists Report events via the repository.
      }
    }
  } with {
    briefly "Report event sink"
    described as {
      |Receives Report events for persistence.
    }
  }
  connector ReportEventFlow is {
    from outlet ReportContext.ReportEventSource.ReportEvents to
      inlet ReportContext.ReportEventSink.ReportInlet
  } with {
    briefly "Report event flow"
    described as {
      |Connects the Report source to its sink.
    }
  }
  processor ReportEventSplit is {
    inlet ReportEventSplitIn is type ReportEvent
    outlet ReportEventSplitToReportRepository is type ReportEvent
    outlet ReportEventSplitToComplianceAnalytics is type ReportEvent
    handler ReportEventSplitHandler is {
      on event Report.ReportCreated is {
        send event Report.ReportCreated to outlet ReportEventSplitToReportRepository
        send event Report.ReportCreated to outlet ReportEventSplitToComplianceAnalytics
        tell event Report.ReportCreated to entity ReportContext.Report
      }
      on event Report.SectionAdded is {
        send event Report.SectionAdded to outlet ReportEventSplitToReportRepository
        send event Report.SectionAdded to outlet ReportEventSplitToComplianceAnalytics
        tell event Report.SectionAdded to entity ReportContext.Report
      }
      on event Report.SectionUpdated is {
        send event Report.SectionUpdated to outlet ReportEventSplitToReportRepository
        send event Report.SectionUpdated to outlet ReportEventSplitToComplianceAnalytics
        tell event Report.SectionUpdated to entity ReportContext.Report
      }
      on event Report.SubmittedForReview is {
        send event Report.SubmittedForReview to outlet ReportEventSplitToReportRepository
        send event Report.SubmittedForReview to outlet ReportEventSplitToComplianceAnalytics
        tell event Report.SubmittedForReview to entity ReportContext.Report
      }
      on event Report.ReportApproved is {
        send event Report.ReportApproved to outlet ReportEventSplitToReportRepository
        send event Report.ReportApproved to outlet ReportEventSplitToComplianceAnalytics
        tell event Report.ReportApproved to entity ReportContext.Report
      }
      on event Report.ReportRejected is {
        send event Report.ReportRejected to outlet ReportEventSplitToReportRepository
        send event Report.ReportRejected to outlet ReportEventSplitToComplianceAnalytics
        tell event Report.ReportRejected to entity ReportContext.Report
      }
      on event Report.ReportSubmitted is {
        send event Report.ReportSubmitted to outlet ReportEventSplitToReportRepository
        send event Report.ReportSubmitted to outlet ReportEventSplitToComplianceAnalytics
        tell event Report.ReportSubmitted to entity ReportContext.Report
      }
      on event Report.AcknowledgmentReceived is {
        send event Report.AcknowledgmentReceived to outlet ReportEventSplitToReportRepository
        send event Report.AcknowledgmentReceived to outlet ReportEventSplitToComplianceAnalytics
        tell event Report.AcknowledgmentReceived to entity ReportContext.Report
      }
      on event Report.ReportAmended is {
        send event Report.ReportAmended to outlet ReportEventSplitToReportRepository
        send event Report.ReportAmended to outlet ReportEventSplitToComplianceAnalytics
        tell event Report.ReportAmended to entity ReportContext.Report
      }
      on event Report.FindingRecorded is {
        send event Report.FindingRecorded to outlet ReportEventSplitToReportRepository
        send event Report.FindingRecorded to outlet ReportEventSplitToComplianceAnalytics
        tell event Report.FindingRecorded to entity ReportContext.Report
      }
      on event Report.FindingResolved is {
        send event Report.FindingResolved to outlet ReportEventSplitToReportRepository
        send event Report.FindingResolved to outlet ReportEventSplitToComplianceAnalytics
        tell event Report.FindingResolved to entity ReportContext.Report
      }
      on other is {
        error "Unexpected message for processor ReportEventSplit"
      }
    } with {
      briefly "Report event fan-out handler"
      described as {
        |Delivers each Report event to all of its consumers.
      }
    }
  } with {
    briefly "Report event fan-out"
    described as {
      |Fans Report events out to the repository and projectors.
    }
  }
  connector LinkReportToReportEventSplit is {
    from outlet ReportContext.Report.ReportEvents2 to
      inlet ReportContext.ReportEventSplit.ReportEventSplitIn
  } with {
    briefly "LinkReportToReportEventSplit"
  }
  connector LinkReportEventSplitToReportRepository is {
    from outlet ReportContext.ReportEventSplit.ReportEventSplitToReportRepository to
      inlet ReportContext.ReportRepository.ReportRepositoryFromReport
  } with {
    briefly "LinkReportEventSplitToReportRepository"
  }
  connector LinkReportEventSplitToComplianceAnalytics is {
    from outlet ReportContext.ReportEventSplit.ReportEventSplitToComplianceAnalytics to
      inlet ReportContext.ComplianceAnalytics.ComplianceAnalyticsFromReport
  } with {
    briefly "LinkReportEventSplitToComplianceAnalytics"
  }
  connector LinkComplianceAnalyticsToReportRepository is {
    from outlet ReportContext.ComplianceAnalytics.ComplianceAnalyticsOut to
      inlet ReportContext.ReportRepository.ReportRepositoryFromComplianceAnalytics
  } with {
    briefly "LinkComplianceAnalyticsToReportRepository"
  }
} with {
  briefly "Bounded context for compliance reporting"
  described as {
    | The ReportContext is the bounded context for
    | regulatory compliance and reporting.
  }
}
