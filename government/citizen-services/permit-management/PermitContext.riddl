// Permit Management - Permit Context
context PermitContext as router is {
  inlet PermitCommandStreamIn is type PermitCommand
  outlet PermitCommandStreamOut is type PermitCommand
  inlet PermitQueryResultStreamIn is type Permit.PermitQueryResult
  outlet PermitQueryResultStreamOut is type Permit.PermitQueryResult
  handler PermitContextBoundary is {
    on submitApplication: command Permit.SubmitApplication is {
      send submitApplication to outlet PermitContext.PermitCommandStreamOut
    }
    on uploadDocument: command Permit.UploadDocument is {
      send uploadDocument to outlet PermitContext.PermitCommandStreamOut
    }
    on assignReviewer: command Permit.AssignReviewer is {
      send assignReviewer to outlet PermitContext.PermitCommandStreamOut
    }
    on submitReview: command Permit.SubmitReview is {
      send submitReview to outlet PermitContext.PermitCommandStreamOut
    }
    on requestCorrections: command Permit.RequestCorrections is {
      send requestCorrections to outlet PermitContext.PermitCommandStreamOut
    }
    on submitCorrections: command Permit.SubmitCorrections is {
      send submitCorrections to outlet PermitContext.PermitCommandStreamOut
    }
    on calculateFees: command Permit.CalculateFees is {
      send calculateFees to outlet PermitContext.PermitCommandStreamOut
    }
    on processPayment: command Permit.ProcessPayment is {
      send processPayment to outlet PermitContext.PermitCommandStreamOut
    }
    on approvePermit: command Permit.ApprovePermit is {
      send approvePermit to outlet PermitContext.PermitCommandStreamOut
    }
    on issuePermit: command Permit.IssuePermit is {
      send issuePermit to outlet PermitContext.PermitCommandStreamOut
    }
    on scheduleInspection: command Permit.ScheduleInspection is {
      send scheduleInspection to outlet PermitContext.PermitCommandStreamOut
    }
    on assignInspector: command Permit.AssignInspector is {
      send assignInspector to outlet PermitContext.PermitCommandStreamOut
    }
    on recordInspection: command Permit.RecordInspection is {
      send recordInspection to outlet PermitContext.PermitCommandStreamOut
    }
    on extendPermit: command Permit.ExtendPermit is {
      send extendPermit to outlet PermitContext.PermitCommandStreamOut
    }
    on closePermit: command Permit.ClosePermit is {
      send closePermit to outlet PermitContext.PermitCommandStreamOut
    }
    on voidPermit: command Permit.VoidPermit is {
      send voidPermit to outlet PermitContext.PermitCommandStreamOut
    }
    on revokePermit: command Permit.RevokePermit is {
      send revokePermit to outlet PermitContext.PermitCommandStreamOut
    }
    on permitQueryResult: result Permit.PermitQueryResult is {
      send permitQueryResult to outlet PermitContext.PermitQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the PermitContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PermitCommand Stream Intake' is from outlet PermitContext.PermitCommandStreamOut to inlet PermitContext.Permit.PermitCommands
  connector 'PermitQueryResult Stream Egress' is from outlet PermitContext.PermitRepository.PermitRepositoryResponses to inlet PermitContext.PermitQueryResultStreamIn
  adaptor FromContractorLicensingService from context ContractorLicensingService is { 
    handler FromContractorLicensingServiceHandler is {
      on result ContractorLicensingService.LicenseVerificationResult is {
        do "the model receives license verification result"
      }
      on other is {
        error "Unexpected message for adaptor FromContractorLicensingService"
      }
    } with {
      briefly "from contractor licensing service"
      described as {
        |Carries messages from the external ContractorLicensingService.
      }
    }
  } with {
    briefly "ContractorLicensingService integration"
    described as {
      |The model's side of the ContractorLicensingService conversation.
    }
  }
  adaptor ToContractorLicensingService to context ContractorLicensingService is { 
    handler ToContractorLicensingServiceHandler is {
      on query ContractorLicensingService.VerifyLicense is {
        do "the model sends verify license"
      }
      on other is {
        error "Unexpected message for adaptor ToContractorLicensingService"
      }
    } with {
      briefly "to contractor licensing service"
      described as {
        |Carries messages to the external ContractorLicensingService.
      }
    }
  } with {
    briefly "ContractorLicensingService integration"
    described as {
      |The model's side of the ContractorLicensingService conversation.
    }
  }
  adaptor FromDocumentStorageService from context DocumentStorageService is { 
    handler FromDocumentStorageServiceHandler is {
      on result DocumentStorageService.DocumentResult is {
        do "the model receives document result"
      }
      on event DocumentStorageService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentStorageService"
      }
    } with {
      briefly "from document storage service"
      described as {
        |Carries messages from the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor ToDocumentStorageService to context DocumentStorageService is { 
    handler ToDocumentStorageServiceHandler is {
      on query DocumentStorageService.RetrieveDocument is {
        do "the model sends retrieve document"
      }
      on command DocumentStorageService.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentStorageService"
      }
    } with {
      briefly "to document storage service"
      described as {
        |Carries messages to the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor FromFeeCalculationService from context FeeCalculationService is { 
    handler FromFeeCalculationServiceHandler is {
      on result FeeCalculationService.PermitFeesResult is {
        do "the model receives permit fees result"
      }
      on other is {
        error "Unexpected message for adaptor FromFeeCalculationService"
      }
    } with {
      briefly "from fee calculation service"
      described as {
        |Carries messages from the external FeeCalculationService.
      }
    }
  } with {
    briefly "FeeCalculationService integration"
    described as {
      |The model's side of the FeeCalculationService conversation.
    }
  }
  adaptor ToFeeCalculationService to context FeeCalculationService is { 
    handler ToFeeCalculationServiceHandler is {
      on query FeeCalculationService.CalculatePermitFees is {
        do "the model sends calculate permit fees"
      }
      on other is {
        error "Unexpected message for adaptor ToFeeCalculationService"
      }
    } with {
      briefly "to fee calculation service"
      described as {
        |Carries messages to the external FeeCalculationService.
      }
    }
  } with {
    briefly "FeeCalculationService integration"
    described as {
      |The model's side of the FeeCalculationService conversation.
    }
  }
  adaptor FromGISService from context GISService is { 
    handler FromGISServiceHandler is {
      on result GISService.ParcelInfoResult is {
        do "the model receives parcel info result"
      }
      on result GISService.ZoningRequirementsResult is {
        do "the model receives zoning requirements result"
      }
      on other is {
        error "Unexpected message for adaptor FromGISService"
      }
    } with {
      briefly "from gis service"
      described as {
        |Carries messages from the external GISService.
      }
    }
  } with {
    briefly "GISService integration"
    described as {
      |The model's side of the GISService conversation.
    }
  }
  adaptor ToGISService to context GISService is { 
    handler ToGISServiceHandler is {
      on query GISService.GetParcelInfo is {
        do "the model sends get parcel info"
      }
      on query GISService.GetZoningRequirements is {
        do "the model sends get zoning requirements"
      }
      on other is {
        error "Unexpected message for adaptor ToGISService"
      }
    } with {
      briefly "to gis service"
      described as {
        |Carries messages to the external GISService.
      }
    }
  } with {
    briefly "GISService integration"
    described as {
      |The model's side of the GISService conversation.
    }
  }
  adaptor FromInspectionSchedulingService from context InspectionSchedulingService is { 
    handler FromInspectionSchedulingServiceHandler is {
      on result InspectionSchedulingService.AvailableSlotsResult is {
        do "the model receives available slots result"
      }
      on event InspectionSchedulingService.InspectionBooked is {
        do "the model receives inspection booked"
      }
      on other is {
        error "Unexpected message for adaptor FromInspectionSchedulingService"
      }
    } with {
      briefly "from inspection scheduling service"
      described as {
        |Carries messages from the external InspectionSchedulingService.
      }
    }
  } with {
    briefly "InspectionSchedulingService integration"
    described as {
      |The model's side of the InspectionSchedulingService conversation.
    }
  }
  adaptor ToInspectionSchedulingService to context InspectionSchedulingService is { 
    handler ToInspectionSchedulingServiceHandler is {
      on command InspectionSchedulingService.BookInspection is {
        do "the model sends book inspection"
      }
      on query InspectionSchedulingService.GetAvailableSlots is {
        do "the model sends get available slots"
      }
      on other is {
        error "Unexpected message for adaptor ToInspectionSchedulingService"
      }
    } with {
      briefly "to inspection scheduling service"
      described as {
        |Carries messages to the external InspectionSchedulingService.
      }
    }
  } with {
    briefly "InspectionSchedulingService integration"
    described as {
      |The model's side of the InspectionSchedulingService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendNotification is {
        do "the model sends send notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.PaymentCompleted is {
        do "the model receives payment completed"
      }
      on event PaymentProcessingService.PaymentFailed is {
        do "the model receives payment failed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.ProcessPermitPayment is {
        do "the model sends process permit payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  include "types.riddl"
  include "Permit.riddl"
  // Repository
  repository PermitRepository as merge is {
    command PersistApplicationSubmitted is {
      permitId: PermitId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApplicationSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ApplicationSubmitted"
      described as {
        |Instructs this repository to apply ApplicationSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInspectionRecorded is {
      permitId: PermitId with {
        briefly "Row addressed"
        described as {
          |Which stored row InspectionRecorded applies to.
        }
      }
    } with {
      briefly "Persist InspectionRecorded"
      described as {
        |Instructs this repository to apply InspectionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentProcessed is {
      permitId: PermitId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentProcessed applies to.
        }
      }
    } with {
      briefly "Persist PaymentProcessed"
      described as {
        |Instructs this repository to apply PaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPermitApproved is {
      permitId: PermitId with {
        briefly "Row addressed"
        described as {
          |Which stored row PermitApproved applies to.
        }
      }
    } with {
      briefly "Persist PermitApproved"
      described as {
        |Instructs this repository to apply PermitApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPermitClosed is {
      permitId: PermitId with {
        briefly "Row addressed"
        described as {
          |Which stored row PermitClosed applies to.
        }
      }
    } with {
      briefly "Persist PermitClosed"
      described as {
        |Instructs this repository to apply PermitClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPermitIssued is {
      permitId: PermitId with {
        briefly "Row addressed"
        described as {
          |Which stored row PermitIssued applies to.
        }
      }
    } with {
      briefly "Persist PermitIssued"
      described as {
        |Instructs this repository to apply PermitIssued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredPermit is  {
      permitId: PermitId with {
        briefly "permitId"
        described as {
          |The permitId column of the stored permit row.
        }
      }
    } with {
      briefly "Stored permit row"
      described as {
        |The persistence shape of permit data as this repository stores it.
      }
    }
    schema PermitData is relational
      of permits as type StoredPermit
        index on field StoredPermit.permitId
 with {
      briefly "Permit data schema"
      described as {
        |The relational schema persisting permit records for this repository.
      }
    }
    inlet PermitRepositoryFromPermit is type PermitEvent    inlet PermitRepositoryFromPermitAnalytics is type PermitEvent    outlet PermitRepositoryResponses is type Permit.PermitQueryResult
    query FindPermitById is  {
      permitId: PermitId with {
        briefly "Permit"
        described as {
          |Permit identifier.
        }
      }
    } with {
      briefly "Find permit by ID"
      described as {
        |Retrieves permit by identifier.
      }
    }
    result PermitResult is  {
      permit: Permit.ActiveStateData with {
        briefly "Permit"
        described as {
          |Permit data.
        }
      }
    } with {
      briefly "Permit result"
      described as {
        |Returns permit data.
      }
    }
    query SearchPermits is  {
      filterPermitType: PermitType? with {
        briefly "Type"
        described as {
          |Filter by type.
        }
      }
      filterStatus: PermitStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      filterParcelId: ParcelId? with {
        briefly "Parcel"
        described as {
          |Filter by parcel.
        }
      }
    } with {
      briefly "Search permits"
      described as {
        |Searches permits by criteria.
      }
    }
    result PermitsResult is  {
      permits: Permit.ActiveStateData+ with {
        briefly "Permits"
        described as {
          |Matching permits.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Permits result"
      described as {
        |Returns matching permits.
      }
    }
    query FindByAddress is  {
      street: String(1,200) with {
        briefly "Street"
        described as {
          |Street address.
        }
      }
      filterCity: String(1,100)? with {
        briefly "City"
        described as {
          |City.
        }
      }
    } with {
      briefly "Find by address"
      described as {
        |Finds permits at address.
      }
    }
    query FindByApplicant is  {
      applicantName: String(1,200) with {
        briefly "Name"
        described as {
          |Applicant name.
        }
      }
    } with {
      briefly "Find by applicant"
      described as {
        |Finds permits for applicant.
      }
    }
    query FindPendingInspections is  {
      filterInspectorId: InspectorId? with {
        briefly "Inspector"
        described as {
          |Filter by inspector.
        }
      }
      filterDate: Date? with {
        briefly "Date"
        described as {
          |Filter by date.
        }
      }
    } with {
      briefly "Find pending inspections"
      described as {
        |Finds scheduled inspections.
      }
    }
    query FindExpiringPermits is  {
      daysUntilExpiration: Natural with {
        briefly "Days"
        described as {
          |Days until expiration.
        }
      }
    } with {
      briefly "Find expiring permits"
      described as {
        |Finds permits expiring soon.
      }
    }
    handler PermitRepositoryHandler is {
      on persistApplicationSubmitted: command PersistApplicationSubmitted is {
        do "apply ApplicationSubmitted to the stored row"
      }
      on persistInspectionRecorded: command PersistInspectionRecorded is {
        do "apply InspectionRecorded to the stored row"
      }
      on persistPaymentProcessed: command PersistPaymentProcessed is {
        do "apply PaymentProcessed to the stored row"
      }
      on persistPermitApproved: command PersistPermitApproved is {
        do "apply PermitApproved to the stored row"
      }
      on persistPermitClosed: command PersistPermitClosed is {
        do "apply PermitClosed to the stored row"
      }
      on persistPermitIssued: command PersistPermitIssued is {
        do "apply PermitIssued to the stored row"
      }
      on query GetAnalyticsData is {
        let analyticsDataView: type AnalyticsDataView = prompt("read the analytics data projection")
        reply analyticsDataView
      }
      on query FindPermitById is {
        let permitResult: type PermitResult = prompt("read the permit from the store")
        reply permitResult
      }
      on query SearchPermits is {
        let permitsResult: type PermitsResult = prompt("read the permits from the store")
        reply permitsResult
      }
      on query FindByAddress is {
        let permitsResult: type PermitsResult = prompt("read the permits that by address asks for")
        reply permitsResult
      }
      on query FindByApplicant is {
        let permitsResult: type PermitsResult = prompt("read the permits that by applicant asks for")
        reply permitsResult
      }
      on query FindPendingInspections is {
        let permitsResult: type PermitsResult = prompt("read the permits that pending inspections asks for")
        reply permitsResult
      }
      on query FindExpiringPermits is {
        let permitResult: type PermitResult = prompt("read the permit from the store")
        reply permitResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes permit queries.
      }
    }
  } with {
    briefly "Permit repository"
    described as {
      |Persistence for permit records.
    }
  }
  // Projector for permit analytics
  query GetAnalyticsData is  {
    analyticsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which analytics data to retrieve.
      }
    }
  } with {
    briefly "Get analytics data"
    described as {
      |Retrieves the analytics data projection.
    }
  }
  result AnalyticsDataView is  {
    analyticsData: PermitAnalytics.AnalyticsData with {
      briefly "Analytics data"
      described as {
        |The analytics data being returned.
      }
    }
  } with {
    briefly "Analytics data view"
    described as {
      |Read model view carrying the analytics data projection.
    }
  }
  projector PermitAnalytics as flow is {
    updates repository PermitContext.PermitRepository
    inlet PermitAnalyticsFromPermit is type PermitEvent    outlet PermitAnalyticsOut is type PermitEvent
    record AnalyticsData is  {
      totalApplications: Natural with {
        briefly "Applications"
        described as {
          |Total applications.
        }
      }
      applicationsByType: TypeCount+ with {
        briefly "By type"
        described as {
          |Applications by type.
        }
      }
      averageReviewDays: Decimal(5,2) with {
        briefly "Avg review"
        described as {
          |Average review time.
        }
      }
      pendingReviews: Natural with {
        briefly "Pending"
        described as {
          |Pending reviews.
        }
      }
      inspectionPassRate: Decimal(5,2) with {
        briefly "Pass rate"
        described as {
          |Inspection pass rate.
        }
      }
      totalFeesCollected: Decimal(12,2) with {
        briefly "Fees"
        described as {
          |Total fees collected.
        }
      }
      permitsByStatus: StatusCount+ with {
        briefly "By status"
        described as {
          |Permits by status.
        }
      }
    } with {
      briefly "Analytics data"
      described as {
        |Permit analytics metrics.
      }
    }
    record TypeCount is  {
      permitType: PermitType with {
        briefly "Type"
        described as {
          |Permit type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Application count.
        }
      }
    } with {
      briefly "Type count"
      described as {
        |Count by permit type.
      }
    }
    record StatusCount is  {
      status: PermitStatus with {
        briefly "Status"
        described as {
          |Permit status.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Permit count.
        }
      }
    } with {
      briefly "Status count"
      described as {
        |Count by status.
      }
    }
    handler AnalyticsHandler is {
      on applicationSubmitted: event Permit.ApplicationSubmitted is {
        tell command PermitContext.PermitRepository.PersistApplicationSubmitted(permitId = applicationSubmitted.permitId) to repository PermitContext.PermitRepository
      }
      on permitApproved: event Permit.PermitApproved is {
        tell command PermitContext.PermitRepository.PersistPermitApproved(permitId = permitApproved.permitId) to repository PermitContext.PermitRepository
      }
      on permitIssued: event Permit.PermitIssued is {
        tell command PermitContext.PermitRepository.PersistPermitIssued(permitId = permitIssued.permitId) to repository PermitContext.PermitRepository
      }
      on inspectionRecorded: event Permit.InspectionRecorded is {
        tell command PermitContext.PermitRepository.PersistInspectionRecorded(permitId = inspectionRecorded.permitId) to repository PermitContext.PermitRepository
      }
      on paymentProcessed: event Permit.PaymentProcessed is {
        tell command PermitContext.PermitRepository.PersistPaymentProcessed(permitId = paymentProcessed.permitId) to repository PermitContext.PermitRepository
      }
      on permitClosed: event Permit.PermitClosed is {
        tell command PermitContext.PermitRepository.PersistPermitClosed(permitId = permitClosed.permitId) to repository PermitContext.PermitRepository
      }
    } with {
      briefly "Processes analytics events"
      described as {
        |Updates permit analytics.
      }
    }
  } with {
    briefly "Permit analytics"
    described as {
      |Projects permit metrics for reporting.
    }
  }
  // ---- Event publication for Permit ----
  type PermitEvent is one of {
    PermitContext.Permit.ApplicationSubmitted or PermitContext.Permit.DocumentUploaded or PermitContext.Permit.ReviewerAssigned or PermitContext.Permit.ReviewSubmitted or PermitContext.Permit.CorrectionsRequested or PermitContext.Permit.CorrectionsSubmitted or PermitContext.Permit.FeesCalculated or PermitContext.Permit.PaymentProcessed or PermitContext.Permit.PermitApproved or PermitContext.Permit.PermitIssued or PermitContext.Permit.InspectionScheduled or PermitContext.Permit.InspectorAssigned or PermitContext.Permit.InspectionRecorded or PermitContext.Permit.PermitExtended or PermitContext.Permit.PermitClosed or PermitContext.Permit.PermitVoided or PermitContext.Permit.PermitRevoked
  } with {
    briefly "Permit event alternation"
    described as {
      |Union of all Permit events, for streaming and event-sourced
      |persistence.
    }
  }
  processor PermitEventSource as source is {
    outlet PermitEvents is type PermitEvent
    handler PermitSourceHandler is {
      on applicationSubmitted: event Permit.ApplicationSubmitted is {
        send applicationSubmitted to outlet PermitEvents
      }
      on documentUploaded: event Permit.DocumentUploaded is {
        send documentUploaded to outlet PermitEvents
      }
      on reviewerAssigned: event Permit.ReviewerAssigned is {
        send reviewerAssigned to outlet PermitEvents
      }
      on reviewSubmitted: event Permit.ReviewSubmitted is {
        send reviewSubmitted to outlet PermitEvents
      }
      on correctionsRequested: event Permit.CorrectionsRequested is {
        send correctionsRequested to outlet PermitEvents
      }
      on correctionsSubmitted: event Permit.CorrectionsSubmitted is {
        send correctionsSubmitted to outlet PermitEvents
      }
      on feesCalculated: event Permit.FeesCalculated is {
        send feesCalculated to outlet PermitEvents
      }
      on paymentProcessed: event Permit.PaymentProcessed is {
        send paymentProcessed to outlet PermitEvents
      }
      on permitApproved: event Permit.PermitApproved is {
        send permitApproved to outlet PermitEvents
      }
      on permitIssued: event Permit.PermitIssued is {
        send permitIssued to outlet PermitEvents
      }
      on inspectionScheduled: event Permit.InspectionScheduled is {
        send inspectionScheduled to outlet PermitEvents
      }
      on inspectorAssigned: event Permit.InspectorAssigned is {
        send inspectorAssigned to outlet PermitEvents
      }
      on inspectionRecorded: event Permit.InspectionRecorded is {
        send inspectionRecorded to outlet PermitEvents
      }
      on permitExtended: event Permit.PermitExtended is {
        send permitExtended to outlet PermitEvents
      }
      on permitClosed: event Permit.PermitClosed is {
        send permitClosed to outlet PermitEvents
      }
      on permitVoided: event Permit.PermitVoided is {
        send permitVoided to outlet PermitEvents
      }
      on permitRevoked: event Permit.PermitRevoked is {
        send permitRevoked to outlet PermitEvents
      }
      on other is {
        error "Unexpected message for source PermitEventSource"
      }
    } with {
      briefly "Permit source handler"
      described as {
        |Publishes Permit events onto the outlet.
      }
    }
  } with {
    briefly "Permit event source"
    described as {
      |Publishes Permit entity events into the streaming topology.
    }
  }
  processor PermitEventSink as sink is {
    inlet PermitInlet is type PermitEvent    handler PermitSinkHandler is {
      on applicationSubmitted: event Permit.ApplicationSubmitted is {
        tell applicationSubmitted to repository PermitContext.PermitRepository
      }
      on documentUploaded: event Permit.DocumentUploaded is {
        tell documentUploaded to repository PermitContext.PermitRepository
      }
      on reviewerAssigned: event Permit.ReviewerAssigned is {
        tell reviewerAssigned to repository PermitContext.PermitRepository
      }
      on reviewSubmitted: event Permit.ReviewSubmitted is {
        tell reviewSubmitted to repository PermitContext.PermitRepository
      }
      on correctionsRequested: event Permit.CorrectionsRequested is {
        tell correctionsRequested to repository PermitContext.PermitRepository
      }
      on correctionsSubmitted: event Permit.CorrectionsSubmitted is {
        tell correctionsSubmitted to repository PermitContext.PermitRepository
      }
      on feesCalculated: event Permit.FeesCalculated is {
        tell feesCalculated to repository PermitContext.PermitRepository
      }
      on paymentProcessed: event Permit.PaymentProcessed is {
        tell paymentProcessed to repository PermitContext.PermitRepository
      }
      on permitApproved: event Permit.PermitApproved is {
        tell permitApproved to repository PermitContext.PermitRepository
      }
      on permitIssued: event Permit.PermitIssued is {
        tell permitIssued to repository PermitContext.PermitRepository
      }
      on inspectionScheduled: event Permit.InspectionScheduled is {
        tell inspectionScheduled to repository PermitContext.PermitRepository
      }
      on inspectorAssigned: event Permit.InspectorAssigned is {
        tell inspectorAssigned to repository PermitContext.PermitRepository
      }
      on inspectionRecorded: event Permit.InspectionRecorded is {
        tell inspectionRecorded to repository PermitContext.PermitRepository
      }
      on permitExtended: event Permit.PermitExtended is {
        tell permitExtended to repository PermitContext.PermitRepository
      }
      on permitClosed: event Permit.PermitClosed is {
        tell permitClosed to repository PermitContext.PermitRepository
      }
      on permitVoided: event Permit.PermitVoided is {
        tell permitVoided to repository PermitContext.PermitRepository
      }
      on permitRevoked: event Permit.PermitRevoked is {
        tell permitRevoked to repository PermitContext.PermitRepository
      }
      on other is {
        error "Unexpected message for sink PermitEventSink"
      }
    } with {
      briefly "Permit sink handler"
      described as {
        |Persists Permit events via the repository.
      }
    }
  } with {
    briefly "Permit event sink"
    described as {
      |Receives Permit events for persistence.
    }
  }
  connector PermitEventFlow is from outlet PermitContext.PermitEventSource.PermitEvents to inlet PermitContext.PermitEventSink.PermitInlet with {
    briefly "Permit event flow"
    described as {
      |Connects the Permit source to its sink.
    }
  }
  processor PermitEventSplit as split is {
    inlet PermitEventSplitIn is type PermitEvent    outlet PermitEventSplitToPermitRepository is type PermitEvent
    outlet PermitEventSplitToPermitAnalytics is type PermitEvent
    handler PermitEventSplitHandler is {
      on applicationSubmitted: event Permit.ApplicationSubmitted is {
        send applicationSubmitted to outlet PermitEventSplitToPermitRepository
        send applicationSubmitted to outlet PermitEventSplitToPermitAnalytics
        tell applicationSubmitted to entity PermitContext.Permit
      }
      on documentUploaded: event Permit.DocumentUploaded is {
        send documentUploaded to outlet PermitEventSplitToPermitRepository
        send documentUploaded to outlet PermitEventSplitToPermitAnalytics
        tell documentUploaded to entity PermitContext.Permit
      }
      on reviewerAssigned: event Permit.ReviewerAssigned is {
        send reviewerAssigned to outlet PermitEventSplitToPermitRepository
        send reviewerAssigned to outlet PermitEventSplitToPermitAnalytics
        tell reviewerAssigned to entity PermitContext.Permit
      }
      on reviewSubmitted: event Permit.ReviewSubmitted is {
        send reviewSubmitted to outlet PermitEventSplitToPermitRepository
        send reviewSubmitted to outlet PermitEventSplitToPermitAnalytics
        tell reviewSubmitted to entity PermitContext.Permit
      }
      on correctionsRequested: event Permit.CorrectionsRequested is {
        send correctionsRequested to outlet PermitEventSplitToPermitRepository
        send correctionsRequested to outlet PermitEventSplitToPermitAnalytics
        tell correctionsRequested to entity PermitContext.Permit
      }
      on correctionsSubmitted: event Permit.CorrectionsSubmitted is {
        send correctionsSubmitted to outlet PermitEventSplitToPermitRepository
        send correctionsSubmitted to outlet PermitEventSplitToPermitAnalytics
        tell correctionsSubmitted to entity PermitContext.Permit
      }
      on feesCalculated: event Permit.FeesCalculated is {
        send feesCalculated to outlet PermitEventSplitToPermitRepository
        send feesCalculated to outlet PermitEventSplitToPermitAnalytics
        tell feesCalculated to entity PermitContext.Permit
      }
      on paymentProcessed: event Permit.PaymentProcessed is {
        send paymentProcessed to outlet PermitEventSplitToPermitRepository
        send paymentProcessed to outlet PermitEventSplitToPermitAnalytics
        tell paymentProcessed to entity PermitContext.Permit
      }
      on permitApproved: event Permit.PermitApproved is {
        send permitApproved to outlet PermitEventSplitToPermitRepository
        send permitApproved to outlet PermitEventSplitToPermitAnalytics
        tell permitApproved to entity PermitContext.Permit
      }
      on permitIssued: event Permit.PermitIssued is {
        send permitIssued to outlet PermitEventSplitToPermitRepository
        send permitIssued to outlet PermitEventSplitToPermitAnalytics
        tell permitIssued to entity PermitContext.Permit
      }
      on inspectionScheduled: event Permit.InspectionScheduled is {
        send inspectionScheduled to outlet PermitEventSplitToPermitRepository
        send inspectionScheduled to outlet PermitEventSplitToPermitAnalytics
        tell inspectionScheduled to entity PermitContext.Permit
      }
      on inspectorAssigned: event Permit.InspectorAssigned is {
        send inspectorAssigned to outlet PermitEventSplitToPermitRepository
        send inspectorAssigned to outlet PermitEventSplitToPermitAnalytics
        tell inspectorAssigned to entity PermitContext.Permit
      }
      on inspectionRecorded: event Permit.InspectionRecorded is {
        send inspectionRecorded to outlet PermitEventSplitToPermitRepository
        send inspectionRecorded to outlet PermitEventSplitToPermitAnalytics
        tell inspectionRecorded to entity PermitContext.Permit
      }
      on permitExtended: event Permit.PermitExtended is {
        send permitExtended to outlet PermitEventSplitToPermitRepository
        send permitExtended to outlet PermitEventSplitToPermitAnalytics
        tell permitExtended to entity PermitContext.Permit
      }
      on permitClosed: event Permit.PermitClosed is {
        send permitClosed to outlet PermitEventSplitToPermitRepository
        send permitClosed to outlet PermitEventSplitToPermitAnalytics
        tell permitClosed to entity PermitContext.Permit
      }
      on permitVoided: event Permit.PermitVoided is {
        send permitVoided to outlet PermitEventSplitToPermitRepository
        send permitVoided to outlet PermitEventSplitToPermitAnalytics
        tell permitVoided to entity PermitContext.Permit
      }
      on permitRevoked: event Permit.PermitRevoked is {
        send permitRevoked to outlet PermitEventSplitToPermitRepository
        send permitRevoked to outlet PermitEventSplitToPermitAnalytics
        tell permitRevoked to entity PermitContext.Permit
      }
      on other is {
        error "Unexpected message for processor PermitEventSplit"
      }
    } with {
      briefly "Permit event fan-out handler"
      described as {
        |Delivers each Permit event to all of its consumers.
      }
    }
  } with {
    briefly "Permit event fan-out"
    described as {
      |Fans Permit events out to the repository and projectors.
    }
  }
  connector 'PermitEvent Stream' is from outlet PermitContext.Permit.PermitEvents2 to inlet PermitContext.PermitEventSplit.PermitEventSplitIn with {
    briefly "Permit events, fanned out to storage and read models"
  }
  connector 'PermitEvent Storage' is from outlet PermitContext.PermitEventSplit.PermitEventSplitToPermitRepository to inlet PermitContext.PermitRepository.PermitRepositoryFromPermit with {
    briefly "Permit events on their way to storage"
  }
  connector 'PermitAnalytics Feed' is from outlet PermitContext.PermitEventSplit.PermitEventSplitToPermitAnalytics to inlet PermitContext.PermitAnalytics.PermitAnalyticsFromPermit with {
    briefly "Permit events feeding the PermitAnalytics projection"
  }
  connector 'PermitAnalytics Storage' is from outlet PermitContext.PermitAnalytics.PermitAnalyticsOut to inlet PermitContext.PermitRepository.PermitRepositoryFromPermitAnalytics with {
    briefly "The PermitAnalytics projection on its way to storage"
  }
} with {
  briefly "Permit context"
  described as {
    | The Permit context manages building and
    | land use permits.
  }
}
