// Permit Management - Permit Context
context PermitContext is {
  adaptor FromContractorLicensingService from context ContractorLicensingService is { 
    handler FromContractorLicensingServiceHandler is {
      on result ContractorLicensingService.LicenseVerificationResult is {
        do "the model receives license verification result"
      }
      on other is {
        error "Unexpected message for adaptor FromContractorLicensingService"
      }
    } with {
      briefly "from contractor licensing service"
      described as {
        |Carries messages from the external ContractorLicensingService.
      }
    }
  } with {
    briefly "ContractorLicensingService integration"
    described as {
      |The model's side of the ContractorLicensingService conversation.
    }
  }
  adaptor ToContractorLicensingService to context ContractorLicensingService is { 
    handler ToContractorLicensingServiceHandler is {
      on query ContractorLicensingService.VerifyLicense is {
        do "the model sends verify license"
      }
      on other is {
        error "Unexpected message for adaptor ToContractorLicensingService"
      }
    } with {
      briefly "to contractor licensing service"
      described as {
        |Carries messages to the external ContractorLicensingService.
      }
    }
  } with {
    briefly "ContractorLicensingService integration"
    described as {
      |The model's side of the ContractorLicensingService conversation.
    }
  }
  adaptor FromDocumentStorageService from context DocumentStorageService is { 
    handler FromDocumentStorageServiceHandler is {
      on result DocumentStorageService.DocumentResult is {
        do "the model receives document result"
      }
      on event DocumentStorageService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentStorageService"
      }
    } with {
      briefly "from document storage service"
      described as {
        |Carries messages from the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor ToDocumentStorageService to context DocumentStorageService is { 
    handler ToDocumentStorageServiceHandler is {
      on query DocumentStorageService.RetrieveDocument is {
        do "the model sends retrieve document"
      }
      on command DocumentStorageService.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentStorageService"
      }
    } with {
      briefly "to document storage service"
      described as {
        |Carries messages to the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor FromFeeCalculationService from context FeeCalculationService is { 
    handler FromFeeCalculationServiceHandler is {
      on result FeeCalculationService.PermitFeesResult is {
        do "the model receives permit fees result"
      }
      on other is {
        error "Unexpected message for adaptor FromFeeCalculationService"
      }
    } with {
      briefly "from fee calculation service"
      described as {
        |Carries messages from the external FeeCalculationService.
      }
    }
  } with {
    briefly "FeeCalculationService integration"
    described as {
      |The model's side of the FeeCalculationService conversation.
    }
  }
  adaptor ToFeeCalculationService to context FeeCalculationService is { 
    handler ToFeeCalculationServiceHandler is {
      on query FeeCalculationService.CalculatePermitFees is {
        do "the model sends calculate permit fees"
      }
      on other is {
        error "Unexpected message for adaptor ToFeeCalculationService"
      }
    } with {
      briefly "to fee calculation service"
      described as {
        |Carries messages to the external FeeCalculationService.
      }
    }
  } with {
    briefly "FeeCalculationService integration"
    described as {
      |The model's side of the FeeCalculationService conversation.
    }
  }
  adaptor FromGISService from context GISService is { 
    handler FromGISServiceHandler is {
      on result GISService.ParcelInfoResult is {
        do "the model receives parcel info result"
      }
      on result GISService.ZoningRequirementsResult is {
        do "the model receives zoning requirements result"
      }
      on other is {
        error "Unexpected message for adaptor FromGISService"
      }
    } with {
      briefly "from gis service"
      described as {
        |Carries messages from the external GISService.
      }
    }
  } with {
    briefly "GISService integration"
    described as {
      |The model's side of the GISService conversation.
    }
  }
  adaptor ToGISService to context GISService is { 
    handler ToGISServiceHandler is {
      on query GISService.GetParcelInfo is {
        do "the model sends get parcel info"
      }
      on query GISService.GetZoningRequirements is {
        do "the model sends get zoning requirements"
      }
      on other is {
        error "Unexpected message for adaptor ToGISService"
      }
    } with {
      briefly "to gis service"
      described as {
        |Carries messages to the external GISService.
      }
    }
  } with {
    briefly "GISService integration"
    described as {
      |The model's side of the GISService conversation.
    }
  }
  adaptor FromInspectionSchedulingService from context InspectionSchedulingService is { 
    handler FromInspectionSchedulingServiceHandler is {
      on result InspectionSchedulingService.AvailableSlotsResult is {
        do "the model receives available slots result"
      }
      on event InspectionSchedulingService.InspectionBooked is {
        do "the model receives inspection booked"
      }
      on other is {
        error "Unexpected message for adaptor FromInspectionSchedulingService"
      }
    } with {
      briefly "from inspection scheduling service"
      described as {
        |Carries messages from the external InspectionSchedulingService.
      }
    }
  } with {
    briefly "InspectionSchedulingService integration"
    described as {
      |The model's side of the InspectionSchedulingService conversation.
    }
  }
  adaptor ToInspectionSchedulingService to context InspectionSchedulingService is { 
    handler ToInspectionSchedulingServiceHandler is {
      on command InspectionSchedulingService.BookInspection is {
        do "the model sends book inspection"
      }
      on query InspectionSchedulingService.GetAvailableSlots is {
        do "the model sends get available slots"
      }
      on other is {
        error "Unexpected message for adaptor ToInspectionSchedulingService"
      }
    } with {
      briefly "to inspection scheduling service"
      described as {
        |Carries messages to the external InspectionSchedulingService.
      }
    }
  } with {
    briefly "InspectionSchedulingService integration"
    described as {
      |The model's side of the InspectionSchedulingService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendNotification is {
        do "the model sends send notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.PaymentCompleted is {
        do "the model receives payment completed"
      }
      on event PaymentProcessingService.PaymentFailed is {
        do "the model receives payment failed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.ProcessPermitPayment is {
        do "the model sends process permit payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  include "types.riddl"
  include "Permit.riddl"
  // Repository
  repository PermitRepository as merge is {
    record StoredPermit is  {
      permitId: PermitId with {
        briefly "permitId"
        described as {
          |The permitId column of the stored permit row.
        }
      }
    } with {
      briefly "Stored permit row"
      described as {
        |The persistence shape of permit data as this repository stores it.
      }
    }
    schema PermitData is relational
      of permits as type StoredPermit
 with {
      briefly "Permit data schema"
      described as {
        |The relational schema persisting permit records for this repository.
      }
    }
    inlet PermitRepositoryFromPermit is type PermitEvent    inlet PermitRepositoryFromPermitAnalytics is type PermitEvent    outlet PermitRepositoryResponses is type Permit.PermitQueryResult
    query FindPermitById is  {
      permitId: PermitId with {
        briefly "Permit"
        described as {
          |Permit identifier.
        }
      }
    } with {
      briefly "Find permit by ID"
      described as {
        |Retrieves permit by identifier.
      }
    }
    result PermitResult is  {
      permit: Permit.ActiveStateData with {
        briefly "Permit"
        described as {
          |Permit data.
        }
      }
    } with {
      briefly "Permit result"
      described as {
        |Returns permit data.
      }
    }
    query SearchPermits is  {
      filterPermitType: PermitType? with {
        briefly "Type"
        described as {
          |Filter by type.
        }
      }
      filterStatus: PermitStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      filterParcelId: ParcelId? with {
        briefly "Parcel"
        described as {
          |Filter by parcel.
        }
      }
    } with {
      briefly "Search permits"
      described as {
        |Searches permits by criteria.
      }
    }
    result PermitsResult is  {
      permits: Permit.ActiveStateData+ with {
        briefly "Permits"
        described as {
          |Matching permits.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Permits result"
      described as {
        |Returns matching permits.
      }
    }
    query FindByAddress is  {
      street: String(1,200) with {
        briefly "Street"
        described as {
          |Street address.
        }
      }
      filterCity: String(1,100)? with {
        briefly "City"
        described as {
          |City.
        }
      }
    } with {
      briefly "Find by address"
      described as {
        |Finds permits at address.
      }
    }
    query FindByApplicant is  {
      applicantName: String(1,200) with {
        briefly "Name"
        described as {
          |Applicant name.
        }
      }
    } with {
      briefly "Find by applicant"
      described as {
        |Finds permits for applicant.
      }
    }
    query FindPendingInspections is  {
      filterInspectorId: InspectorId? with {
        briefly "Inspector"
        described as {
          |Filter by inspector.
        }
      }
      filterDate: Date? with {
        briefly "Date"
        described as {
          |Filter by date.
        }
      }
    } with {
      briefly "Find pending inspections"
      described as {
        |Finds scheduled inspections.
      }
    }
    query FindExpiringPermits is  {
      daysUntilExpiration: Natural with {
        briefly "Days"
        described as {
          |Days until expiration.
        }
      }
    } with {
      briefly "Find expiring permits"
      described as {
        |Finds permits expiring soon.
      }
    }
    handler PermitRepositoryHandler is {
      on query GetAnalyticsData is {
        do "read the analytics data projection"
        reply result AnalyticsDataView
      }
      on query FindPermitById is {
        reply result PermitResult
      }
      on query SearchPermits is {
        reply result PermitsResult
      }
      on query FindByAddress is {
        reply result PermitsResult
      }
      on query FindByApplicant is {
        reply result PermitsResult
      }
      on query FindPendingInspections is {
        reply result PermitsResult
      }
      on query FindExpiringPermits is {
        reply result PermitResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes permit queries.
      }
    }
  } with {
    briefly "Permit repository"
    described as {
      |Persistence for permit records.
    }
  }
  // Projector for permit analytics
  query GetAnalyticsData is  {
    analyticsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which analytics data to retrieve.
      }
    }
  } with {
    briefly "Get analytics data"
    described as {
      |Retrieves the analytics data projection.
    }
  }
  result AnalyticsDataView is  {
    analyticsData: PermitAnalytics.AnalyticsData with {
      briefly "Analytics data"
      described as {
        |The analytics data being returned.
      }
    }
  } with {
    briefly "Analytics data view"
    described as {
      |Read model view carrying the analytics data projection.
    }
  }
  projector PermitAnalytics as flow is {
    updates repository PermitContext.PermitRepository
    inlet PermitAnalyticsFromPermit is type PermitEvent    outlet PermitAnalyticsOut is type PermitEvent
    record AnalyticsData is  {
      totalApplications: Natural with {
        briefly "Applications"
        described as {
          |Total applications.
        }
      }
      applicationsByType: TypeCount+ with {
        briefly "By type"
        described as {
          |Applications by type.
        }
      }
      averageReviewDays: Decimal(5,2) with {
        briefly "Avg review"
        described as {
          |Average review time.
        }
      }
      pendingReviews: Natural with {
        briefly "Pending"
        described as {
          |Pending reviews.
        }
      }
      inspectionPassRate: Decimal(5,2) with {
        briefly "Pass rate"
        described as {
          |Inspection pass rate.
        }
      }
      totalFeesCollected: Decimal(12,2) with {
        briefly "Fees"
        described as {
          |Total fees collected.
        }
      }
      permitsByStatus: StatusCount+ with {
        briefly "By status"
        described as {
          |Permits by status.
        }
      }
    } with {
      briefly "Analytics data"
      described as {
        |Permit analytics metrics.
      }
    }
    record TypeCount is  {
      permitType: PermitType with {
        briefly "Type"
        described as {
          |Permit type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Application count.
        }
      }
    } with {
      briefly "Type count"
      described as {
        |Count by permit type.
      }
    }
    record StatusCount is  {
      status: PermitStatus with {
        briefly "Status"
        described as {
          |Permit status.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Permit count.
        }
      }
    } with {
      briefly "Status count"
      described as {
        |Count by status.
      }
    }
    handler AnalyticsHandler is {
      on event Permit.ApplicationSubmitted is {
        tell event Permit.ApplicationSubmitted to repository PermitContext.PermitRepository
      }
      on event Permit.PermitApproved is {
        tell event Permit.PermitApproved to repository PermitContext.PermitRepository
      }
      on event Permit.PermitIssued is {
        tell event Permit.PermitIssued to repository PermitContext.PermitRepository
      }
      on event Permit.InspectionRecorded is {
        tell event Permit.InspectionRecorded to repository PermitContext.PermitRepository
      }
      on event Permit.PaymentProcessed is {
        tell event Permit.PaymentProcessed to repository PermitContext.PermitRepository
      }
      on event Permit.PermitClosed is {
        tell event Permit.PermitClosed to repository PermitContext.PermitRepository
      }
    } with {
      briefly "Processes analytics events"
      described as {
        |Updates permit analytics.
      }
    }
  } with {
    briefly "Permit analytics"
    described as {
      |Projects permit metrics for reporting.
    }
  }
  // ---- Event publication for Permit ----
  type PermitEvent is one of {
    PermitContext.Permit.ApplicationSubmitted or PermitContext.Permit.DocumentUploaded or PermitContext.Permit.ReviewerAssigned or PermitContext.Permit.ReviewSubmitted or PermitContext.Permit.CorrectionsRequested or PermitContext.Permit.CorrectionsSubmitted or PermitContext.Permit.FeesCalculated or PermitContext.Permit.PaymentProcessed or PermitContext.Permit.PermitApproved or PermitContext.Permit.PermitIssued or PermitContext.Permit.InspectionScheduled or PermitContext.Permit.InspectorAssigned or PermitContext.Permit.InspectionRecorded or PermitContext.Permit.PermitExtended or PermitContext.Permit.PermitClosed or PermitContext.Permit.PermitVoided or PermitContext.Permit.PermitRevoked
  } with {
    briefly "Permit event alternation"
    described as {
      |Union of all Permit events, for streaming and event-sourced
      |persistence.
    }
  }
  processor PermitEventSource as source is {
    outlet PermitEvents is type PermitEvent
    handler PermitSourceHandler is {
      on event Permit.ApplicationSubmitted is {
        send event Permit.ApplicationSubmitted to outlet PermitEvents
      }
      on event Permit.DocumentUploaded is {
        send event Permit.DocumentUploaded to outlet PermitEvents
      }
      on event Permit.ReviewerAssigned is {
        send event Permit.ReviewerAssigned to outlet PermitEvents
      }
      on event Permit.ReviewSubmitted is {
        send event Permit.ReviewSubmitted to outlet PermitEvents
      }
      on event Permit.CorrectionsRequested is {
        send event Permit.CorrectionsRequested to outlet PermitEvents
      }
      on event Permit.CorrectionsSubmitted is {
        send event Permit.CorrectionsSubmitted to outlet PermitEvents
      }
      on event Permit.FeesCalculated is {
        send event Permit.FeesCalculated to outlet PermitEvents
      }
      on event Permit.PaymentProcessed is {
        send event Permit.PaymentProcessed to outlet PermitEvents
      }
      on event Permit.PermitApproved is {
        send event Permit.PermitApproved to outlet PermitEvents
      }
      on event Permit.PermitIssued is {
        send event Permit.PermitIssued to outlet PermitEvents
      }
      on event Permit.InspectionScheduled is {
        send event Permit.InspectionScheduled to outlet PermitEvents
      }
      on event Permit.InspectorAssigned is {
        send event Permit.InspectorAssigned to outlet PermitEvents
      }
      on event Permit.InspectionRecorded is {
        send event Permit.InspectionRecorded to outlet PermitEvents
      }
      on event Permit.PermitExtended is {
        send event Permit.PermitExtended to outlet PermitEvents
      }
      on event Permit.PermitClosed is {
        send event Permit.PermitClosed to outlet PermitEvents
      }
      on event Permit.PermitVoided is {
        send event Permit.PermitVoided to outlet PermitEvents
      }
      on event Permit.PermitRevoked is {
        send event Permit.PermitRevoked to outlet PermitEvents
      }
      on other is {
        error "Unexpected message for source PermitEventSource"
      }
    } with {
      briefly "Permit source handler"
      described as {
        |Publishes Permit events onto the outlet.
      }
    }
  } with {
    briefly "Permit event source"
    described as {
      |Publishes Permit entity events into the streaming topology.
    }
  }
  processor PermitEventSink as sink is {
    inlet PermitInlet is type PermitEvent    handler PermitSinkHandler is {
      on event Permit.ApplicationSubmitted is {
        tell event Permit.ApplicationSubmitted to repository PermitContext.PermitRepository
      }
      on event Permit.DocumentUploaded is {
        tell event Permit.DocumentUploaded to repository PermitContext.PermitRepository
      }
      on event Permit.ReviewerAssigned is {
        tell event Permit.ReviewerAssigned to repository PermitContext.PermitRepository
      }
      on event Permit.ReviewSubmitted is {
        tell event Permit.ReviewSubmitted to repository PermitContext.PermitRepository
      }
      on event Permit.CorrectionsRequested is {
        tell event Permit.CorrectionsRequested to repository PermitContext.PermitRepository
      }
      on event Permit.CorrectionsSubmitted is {
        tell event Permit.CorrectionsSubmitted to repository PermitContext.PermitRepository
      }
      on event Permit.FeesCalculated is {
        tell event Permit.FeesCalculated to repository PermitContext.PermitRepository
      }
      on event Permit.PaymentProcessed is {
        tell event Permit.PaymentProcessed to repository PermitContext.PermitRepository
      }
      on event Permit.PermitApproved is {
        tell event Permit.PermitApproved to repository PermitContext.PermitRepository
      }
      on event Permit.PermitIssued is {
        tell event Permit.PermitIssued to repository PermitContext.PermitRepository
      }
      on event Permit.InspectionScheduled is {
        tell event Permit.InspectionScheduled to repository PermitContext.PermitRepository
      }
      on event Permit.InspectorAssigned is {
        tell event Permit.InspectorAssigned to repository PermitContext.PermitRepository
      }
      on event Permit.InspectionRecorded is {
        tell event Permit.InspectionRecorded to repository PermitContext.PermitRepository
      }
      on event Permit.PermitExtended is {
        tell event Permit.PermitExtended to repository PermitContext.PermitRepository
      }
      on event Permit.PermitClosed is {
        tell event Permit.PermitClosed to repository PermitContext.PermitRepository
      }
      on event Permit.PermitVoided is {
        tell event Permit.PermitVoided to repository PermitContext.PermitRepository
      }
      on event Permit.PermitRevoked is {
        tell event Permit.PermitRevoked to repository PermitContext.PermitRepository
      }
      on other is {
        error "Unexpected message for sink PermitEventSink"
      }
    } with {
      briefly "Permit sink handler"
      described as {
        |Persists Permit events via the repository.
      }
    }
  } with {
    briefly "Permit event sink"
    described as {
      |Receives Permit events for persistence.
    }
  }
  connector PermitEventFlow is from outlet PermitContext.PermitEventSource.PermitEvents to inlet PermitContext.PermitEventSink.PermitInlet with {
    briefly "Permit event flow"
    described as {
      |Connects the Permit source to its sink.
    }
  }
  processor PermitEventSplit as split is {
    inlet PermitEventSplitIn is type PermitEvent    outlet PermitEventSplitToPermitRepository is type PermitEvent
    outlet PermitEventSplitToPermitAnalytics is type PermitEvent
    handler PermitEventSplitHandler is {
      on event Permit.ApplicationSubmitted is {
        send event Permit.ApplicationSubmitted to outlet PermitEventSplitToPermitRepository
        send event Permit.ApplicationSubmitted to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.ApplicationSubmitted to entity PermitContext.Permit
      }
      on event Permit.DocumentUploaded is {
        send event Permit.DocumentUploaded to outlet PermitEventSplitToPermitRepository
        send event Permit.DocumentUploaded to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.DocumentUploaded to entity PermitContext.Permit
      }
      on event Permit.ReviewerAssigned is {
        send event Permit.ReviewerAssigned to outlet PermitEventSplitToPermitRepository
        send event Permit.ReviewerAssigned to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.ReviewerAssigned to entity PermitContext.Permit
      }
      on event Permit.ReviewSubmitted is {
        send event Permit.ReviewSubmitted to outlet PermitEventSplitToPermitRepository
        send event Permit.ReviewSubmitted to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.ReviewSubmitted to entity PermitContext.Permit
      }
      on event Permit.CorrectionsRequested is {
        send event Permit.CorrectionsRequested to outlet PermitEventSplitToPermitRepository
        send event Permit.CorrectionsRequested to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.CorrectionsRequested to entity PermitContext.Permit
      }
      on event Permit.CorrectionsSubmitted is {
        send event Permit.CorrectionsSubmitted to outlet PermitEventSplitToPermitRepository
        send event Permit.CorrectionsSubmitted to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.CorrectionsSubmitted to entity PermitContext.Permit
      }
      on event Permit.FeesCalculated is {
        send event Permit.FeesCalculated to outlet PermitEventSplitToPermitRepository
        send event Permit.FeesCalculated to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.FeesCalculated to entity PermitContext.Permit
      }
      on event Permit.PaymentProcessed is {
        send event Permit.PaymentProcessed to outlet PermitEventSplitToPermitRepository
        send event Permit.PaymentProcessed to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.PaymentProcessed to entity PermitContext.Permit
      }
      on event Permit.PermitApproved is {
        send event Permit.PermitApproved to outlet PermitEventSplitToPermitRepository
        send event Permit.PermitApproved to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.PermitApproved to entity PermitContext.Permit
      }
      on event Permit.PermitIssued is {
        send event Permit.PermitIssued to outlet PermitEventSplitToPermitRepository
        send event Permit.PermitIssued to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.PermitIssued to entity PermitContext.Permit
      }
      on event Permit.InspectionScheduled is {
        send event Permit.InspectionScheduled to outlet PermitEventSplitToPermitRepository
        send event Permit.InspectionScheduled to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.InspectionScheduled to entity PermitContext.Permit
      }
      on event Permit.InspectorAssigned is {
        send event Permit.InspectorAssigned to outlet PermitEventSplitToPermitRepository
        send event Permit.InspectorAssigned to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.InspectorAssigned to entity PermitContext.Permit
      }
      on event Permit.InspectionRecorded is {
        send event Permit.InspectionRecorded to outlet PermitEventSplitToPermitRepository
        send event Permit.InspectionRecorded to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.InspectionRecorded to entity PermitContext.Permit
      }
      on event Permit.PermitExtended is {
        send event Permit.PermitExtended to outlet PermitEventSplitToPermitRepository
        send event Permit.PermitExtended to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.PermitExtended to entity PermitContext.Permit
      }
      on event Permit.PermitClosed is {
        send event Permit.PermitClosed to outlet PermitEventSplitToPermitRepository
        send event Permit.PermitClosed to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.PermitClosed to entity PermitContext.Permit
      }
      on event Permit.PermitVoided is {
        send event Permit.PermitVoided to outlet PermitEventSplitToPermitRepository
        send event Permit.PermitVoided to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.PermitVoided to entity PermitContext.Permit
      }
      on event Permit.PermitRevoked is {
        send event Permit.PermitRevoked to outlet PermitEventSplitToPermitRepository
        send event Permit.PermitRevoked to outlet PermitEventSplitToPermitAnalytics
        tell event Permit.PermitRevoked to entity PermitContext.Permit
      }
      on other is {
        error "Unexpected message for processor PermitEventSplit"
      }
    } with {
      briefly "Permit event fan-out handler"
      described as {
        |Delivers each Permit event to all of its consumers.
      }
    }
  } with {
    briefly "Permit event fan-out"
    described as {
      |Fans Permit events out to the repository and projectors.
    }
  }
  connector 'PermitEvent Stream' is from outlet PermitContext.Permit.PermitEvents2 to inlet PermitContext.PermitEventSplit.PermitEventSplitIn with {
    briefly "Permit events, fanned out to storage and read models"
  }
  connector 'PermitEvent Storage' is from outlet PermitContext.PermitEventSplit.PermitEventSplitToPermitRepository to inlet PermitContext.PermitRepository.PermitRepositoryFromPermit with {
    briefly "Permit events on their way to storage"
  }
  connector 'PermitAnalytics Feed' is from outlet PermitContext.PermitEventSplit.PermitEventSplitToPermitAnalytics to inlet PermitContext.PermitAnalytics.PermitAnalyticsFromPermit with {
    briefly "Permit events feeding the PermitAnalytics projection"
  }
  connector 'PermitAnalytics Storage' is from outlet PermitContext.PermitAnalytics.PermitAnalyticsOut to inlet PermitContext.PermitRepository.PermitRepositoryFromPermitAnalytics with {
    briefly "The PermitAnalytics projection on its way to storage"
  }
} with {
  briefly "Permit context"
  described as {
    | The Permit context manages building and
    | land use permits.
  }
}
