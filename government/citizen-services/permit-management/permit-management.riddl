// Permit Management Domain Model
// Building and land use permit processing
domain PermitManagement is {
  persistent connector 'InspectionSchedulingServiceReply Stream' is from outlet InspectionSchedulingService.InspectionSchedulingServiceRepliesOut to inlet PermitContext.ToInspectionSchedulingService.ToInspectionSchedulingServiceReplies with {
    briefly "What InspectionSchedulingService answers PermitContext"
  }
  persistent connector 'GISServiceReply Stream' is from outlet GISService.GISServiceRepliesOut to inlet PermitContext.ToGISService.ToGISServiceReplies with {
    briefly "What GISService answers PermitContext"
  }
  persistent connector 'FeeCalculationServiceReply Stream' is from outlet FeeCalculationService.FeeCalculationServiceRepliesOut to inlet PermitContext.ToFeeCalculationService.ToFeeCalculationServiceReplies with {
    briefly "What FeeCalculationService answers PermitContext"
  }
  persistent connector 'DocumentStorageServiceReply Stream' is from outlet DocumentStorageService.DocumentStorageServiceRepliesOut to inlet PermitContext.ToDocumentStorageService.ToDocumentStorageServiceReplies with {
    briefly "What DocumentStorageService answers PermitContext"
  }
  persistent connector 'ContractorLicensingServiceReply Stream' is from outlet ContractorLicensingService.ContractorLicensingServiceRepliesOut to inlet PermitContext.ToContractorLicensingService.ToContractorLicensingServiceReplies with {
    briefly "What ContractorLicensingService answers PermitContext"
  }
  persistent connector 'DocumentStorageServiceEvent Stream' is from outlet DocumentStorageService.DocumentStorageServiceEventsOut to inlet PermitContext.FromDocumentStorageService.FromDocumentStorageServiceIn with {
    briefly "What DocumentStorageService tells PermitContext, unasked"
  }
  persistent connector 'InspectionSchedulingServiceEvent Stream' is from outlet InspectionSchedulingService.InspectionSchedulingServiceEventsOut to inlet PermitContext.FromInspectionSchedulingService.FromInspectionSchedulingServiceIn with {
    briefly "What InspectionSchedulingService tells PermitContext, unasked"
  }
  persistent connector 'PaymentProcessingServiceEvent Stream' is from outlet PaymentProcessingService.PaymentProcessingServiceEventsOut to inlet PermitContext.FromPaymentProcessingService.FromPaymentProcessingServiceIn with {
    briefly "What PaymentProcessingService tells PermitContext, unasked"
  }
  persistent connector 'GISServiceRequest Stream' is from outlet PermitContext.ToGISService.ToGISServiceOut to inlet GISService.GISServiceRequests with {
    briefly "What PermitContext asks GISService to send"
  }
  persistent connector 'FeeCalculationServiceRequest Stream' is from outlet PermitContext.ToFeeCalculationService.ToFeeCalculationServiceOut to inlet FeeCalculationService.FeeCalculationServiceRequests with {
    briefly "What PermitContext asks FeeCalculationService to send"
  }
  persistent connector 'ContractorLicensingServiceRequest Stream' is from outlet PermitContext.ToContractorLicensingService.ToContractorLicensingServiceOut to inlet ContractorLicensingService.ContractorLicensingServiceRequests with {
    briefly "What PermitContext asks ContractorLicensingService to send"
  }
  persistent connector 'DocumentStorageServiceRequest Stream' is from outlet PermitContext.ToDocumentStorageService.ToDocumentStorageServiceOut to inlet DocumentStorageService.DocumentStorageServiceRequests with {
    briefly "What PermitContext asks DocumentStorageService to send"
  }
  persistent connector 'InspectionSchedulingServiceRequest Stream' is from outlet PermitContext.ToInspectionSchedulingService.ToInspectionSchedulingServiceOut to inlet InspectionSchedulingService.InspectionSchedulingServiceRequests with {
    briefly "What PermitContext asks InspectionSchedulingService to send"
  }
  persistent connector 'PaymentProcessingServiceRequest Stream' is from outlet PermitContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut to inlet PaymentProcessingService.PaymentProcessingServiceRequests with {
    briefly "What PermitContext asks PaymentProcessingService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet PermitContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What PermitContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Applicant is "person or business applying for permits" with {
    briefly "Applicant"
    described as {
      |Permit applicant.
    }
  }
  user PermitTechnician is "person reviewing permit applications" with {
    briefly "Permit Technician"
    described as {
      |Staff processing permit applications.
    }
  }
  user Inspector is "person conducting field inspections" with {
    briefly "Inspector"
    described as {
      |Building/code inspector.
    }
  }
  user PlanReviewer is "person reviewing plans and drawings" with {
    briefly "Plan Reviewer"
    described as {
      |Technical plan reviewer.
    }
  }
  epic PermitEpic is {
    user Applicant wants to "to obtain necessary permits" so that "they can legally perform construction"
    case ApplyForPermit is {
      user Applicant wants to "to submit a permit application" so that "work can be authorized"
      step is "Applicant submits" "application and plans" "online or at counter" with {
        briefly "Submit"
        described as {
          |File application.
        }
      }
      step take input PermitManagementApp.PermitManagementScreen.SubmitApplicationInput from user Applicant with {
        briefly "Process"
        described as {
          |Process application.
        }
      }
      step is "Staff reviews" "and issues" "permit" with {
        briefly "Issue"
        described as {
          |Issue permit.
        }
      }
    } with {
      briefly "Apply for permit"
      described as {
        |Permit application workflow.
      }
    }
  } with {
    briefly "Permit management"
    described as {
      | Epic covering permit applications,
      | plan review, and inspections.
    }
  }
  include "PermitContext.riddl"
  include "external-contexts.riddl"
  application context PermitManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PermitManagement are delivered.
      }
    }
    group PermitManagementScreen is {
      input SubmitApplicationInput acquires command PermitContext.Permit.SubmitApplication with {
        briefly "Submit application control"
        described as {
          |The control through which a user submits the submit application request.
        }
      }
    } with {
      briefly "Permit management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppPermitCommands is type PermitContext.Permit.PermitCommand
    inlet AppPermitRepositoryResponses is result PermitContext.Permit.PermitQueryResult    handler PermitManagementAppHandler is {
      on other is {
        error "Unexpected message for application context PermitManagementApp"
      }
    } with {
      briefly "PermitManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PermitManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'PermitCommand Stream' is from outlet PermitManagementApp.AppPermitCommands to inlet PermitContext.PermitCommandStreamIn with {
    briefly "Permit commands from the application"
  }
  persistent connector 'PermitQueryResult Stream' is from outlet PermitContext.PermitQueryResultStreamOut to inlet PermitManagementApp.AppPermitRepositoryResponses with {
    briefly "Permit query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PermitManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Permit management domain"
  described as {
    | The Permit Management domain handles building,
    | zoning, and land use permits.
  }
}
