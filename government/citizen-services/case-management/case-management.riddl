// Case Management Domain Model
// Government citizen services case management
domain CaseManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Citizen is "person requesting government services" with {
    briefly "Citizen"
    described as {
      |Individual seeking assistance.
    }
  }
  user CaseWorker is "person managing citizen cases" with {
    briefly "Case Worker"
    described as {
      |Staff handling cases.
    }
  }
  user Supervisor is "person overseeing case operations" with {
    briefly "Supervisor"
    described as {
      |Supervisory staff.
    }
  }
  epic CaseManagementEpic is {
    user Citizen wants to "to receive government assistance" so that "their needs are addressed"
    case RequestServices is {
      user Citizen wants to "to open a case for services" so that "they can receive assistance"
      step is "Citizen submits" "service request" "through portal" with {
        briefly "Submit request"
        described as {
          |Initiate service request.
        }
      }
      step take input CaseManagementApp.CaseManagementScreen.OpenCaseInput from user CaseWorker with {
        briefly "Open case"
        described as {
          |Create the case.
        }
      }
      step is "Case worker processes" "and resolves" "case" with {
        briefly "Process"
        described as {
          |Work the case.
        }
      }
    } with {
      briefly "Request services"
      described as {
        |Service request workflow.
      }
    }
  } with {
    briefly "Case management"
    described as {
      | Epic covering citizen service requests,
      | case processing, and resolution.
    }
  }
  include "CaseContext.riddl"
  include "external-contexts.riddl"
  application context CaseManagementApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CaseManagement are delivered.
      }
    }
    group CaseManagementScreen is {
      input OpenCaseInput acquires command CaseContext.Case.OpenCase with {
        briefly "Open case control"
        described as {
          |The control through which a user submits the open case request.
        }
      }
    } with {
      briefly "Case management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppCaseCommands is type CaseContext.Case.CaseCommand
    inlet AppCaseRepositoryResponses is type CaseContext.Case.CaseQueryResult    handler CaseManagementAppHandler is {
      on other is {
        error "Unexpected message for application context CaseManagementApp"
      }
    } with {
      briefly "CaseManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CaseManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'CaseCommand Stream' is from outlet CaseManagementApp.AppCaseCommands to inlet CaseContext.Case.CaseCommands with {
    option persistent()
    briefly "Case commands from the application"
  }
  connector 'CaseQueryResult Stream' is from outlet CaseContext.CaseRepository.CaseRepositoryResponses to inlet CaseManagementApp.AppCaseRepositoryResponses with {
    option persistent()
    briefly "Case query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CaseManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Case management domain"
  described as {
    | The Case Management domain handles citizen
    | service cases and assistance programs.
  }
}
