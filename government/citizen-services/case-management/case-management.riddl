// Case Management Domain Model
// Government citizen services case management
domain CaseManagement is {
  persistent connector 'IncomeVerificationServiceReply Stream' is from outlet IncomeVerificationService.IncomeVerificationServiceRepliesOut to inlet CaseContext.ToIncomeVerificationService.ToIncomeVerificationServiceReplies with {
    briefly "What IncomeVerificationService answers CaseContext"
  }
  persistent connector 'DocumentManagementServiceReply Stream' is from outlet DocumentManagementService.DocumentManagementServiceRepliesOut to inlet CaseContext.ToDocumentManagementService.ToDocumentManagementServiceReplies with {
    briefly "What DocumentManagementService answers CaseContext"
  }
  persistent connector 'BenefitsIntegrationServiceReply Stream' is from outlet BenefitsIntegrationService.BenefitsIntegrationServiceRepliesOut to inlet CaseContext.ToBenefitsIntegrationService.ToBenefitsIntegrationServiceReplies with {
    briefly "What BenefitsIntegrationService answers CaseContext"
  }
  persistent connector 'AppointmentServiceEvent Stream' is from outlet AppointmentService.AppointmentServiceEventsOut to inlet CaseContext.FromAppointmentService.FromAppointmentServiceIn with {
    briefly "What AppointmentService tells CaseContext, unasked"
  }
  persistent connector 'BenefitsIntegrationServiceEvent Stream' is from outlet BenefitsIntegrationService.BenefitsIntegrationServiceEventsOut to inlet CaseContext.FromBenefitsIntegrationService.FromBenefitsIntegrationServiceIn with {
    briefly "What BenefitsIntegrationService tells CaseContext, unasked"
  }
  persistent connector 'DocumentManagementServiceEvent Stream' is from outlet DocumentManagementService.DocumentManagementServiceEventsOut to inlet CaseContext.FromDocumentManagementService.FromDocumentManagementServiceIn with {
    briefly "What DocumentManagementService tells CaseContext, unasked"
  }
  persistent connector 'IdentityVerificationServiceEvent Stream' is from outlet IdentityVerificationService.IdentityVerificationServiceEventsOut to inlet CaseContext.FromIdentityVerificationService.FromIdentityVerificationServiceIn with {
    briefly "What IdentityVerificationService tells CaseContext, unasked"
  }
  persistent connector 'IncomeVerificationServiceEvent Stream' is from outlet IncomeVerificationService.IncomeVerificationServiceEventsOut to inlet CaseContext.FromIncomeVerificationService.FromIncomeVerificationServiceIn with {
    briefly "What IncomeVerificationService tells CaseContext, unasked"
  }
  persistent connector 'PaymentServiceEvent Stream' is from outlet PaymentService.PaymentServiceEventsOut to inlet CaseContext.FromPaymentService.FromPaymentServiceIn with {
    briefly "What PaymentService tells CaseContext, unasked"
  }
  persistent connector 'BenefitsIntegrationServiceRequest Stream' is from outlet CaseContext.ToBenefitsIntegrationService.ToBenefitsIntegrationServiceOut to inlet BenefitsIntegrationService.BenefitsIntegrationServiceRequests with {
    briefly "What CaseContext asks BenefitsIntegrationService to send"
  }
  persistent connector 'PaymentServiceRequest Stream' is from outlet CaseContext.ToPaymentService.ToPaymentServiceOut to inlet PaymentService.PaymentServiceRequests with {
    briefly "What CaseContext asks PaymentService to send"
  }
  persistent connector 'IncomeVerificationServiceRequest Stream' is from outlet CaseContext.ToIncomeVerificationService.ToIncomeVerificationServiceOut to inlet IncomeVerificationService.IncomeVerificationServiceRequests with {
    briefly "What CaseContext asks IncomeVerificationService to send"
  }
  persistent connector 'IdentityVerificationServiceRequest Stream' is from outlet CaseContext.ToIdentityVerificationService.ToIdentityVerificationServiceOut to inlet IdentityVerificationService.IdentityVerificationServiceRequests with {
    briefly "What CaseContext asks IdentityVerificationService to send"
  }
  persistent connector 'DocumentManagementServiceRequest Stream' is from outlet CaseContext.ToDocumentManagementService.ToDocumentManagementServiceOut to inlet DocumentManagementService.DocumentManagementServiceRequests with {
    briefly "What CaseContext asks DocumentManagementService to send"
  }
  persistent connector 'AppointmentServiceRequest Stream' is from outlet CaseContext.ToAppointmentService.ToAppointmentServiceOut to inlet AppointmentService.AppointmentServiceRequests with {
    briefly "What CaseContext asks AppointmentService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet CaseContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What CaseContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Citizen is "person requesting government services" with {
    briefly "Citizen"
    described as {
      |Individual seeking assistance.
    }
  }
  user CaseWorker is "person managing citizen cases" with {
    briefly "Case Worker"
    described as {
      |Staff handling cases.
    }
  }
  user Supervisor is "person overseeing case operations" with {
    briefly "Supervisor"
    described as {
      |Supervisory staff.
    }
  }
  epic CaseManagementEpic is {
    user Citizen wants to "to receive government assistance" so that "their needs are addressed"
    case RequestServices is {
      user Citizen wants to "to open a case for services" so that "they can receive assistance"
      step is "Citizen submits" "service request" "through portal" with {
        briefly "Submit request"
        described as {
          |Initiate service request.
        }
      }
      step take input CaseManagementApp.CaseManagementScreen.OpenCaseInput from user CaseWorker with {
        briefly "Open case"
        described as {
          |Create the case.
        }
      }
      step is "Case worker processes" "and resolves" "case" with {
        briefly "Process"
        described as {
          |Work the case.
        }
      }
    } with {
      briefly "Request services"
      described as {
        |Service request workflow.
      }
    }
  } with {
    briefly "Case management"
    described as {
      | Epic covering citizen service requests,
      | case processing, and resolution.
    }
  }
  include "CaseContext.riddl"
  include "external-contexts.riddl"
  application context CaseManagementApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CaseManagement are delivered.
      }
    }
    group CaseManagementScreen is {
      input FindPendingApprovalsInput acquires query CaseContext.CaseRepository.FindPendingApprovals with {
        briefly "Find pending approvals control"
        described as {
          |The control through which a user asks the find pending approvals question.
        }
      }
      input FindPendingTasksInput acquires query CaseContext.CaseRepository.FindPendingTasks with {
        briefly "Find pending tasks control"
        described as {
          |The control through which a user asks the find pending tasks question.
        }
      }
      input FindBySSNInput acquires query CaseContext.CaseRepository.FindBySSN with {
        briefly "Find by SSN control"
        described as {
          |The control through which a user asks the find by ssn question.
        }
      }
      input FindByCitizenInput acquires query CaseContext.CaseRepository.FindByCitizen with {
        briefly "Find by citizen control"
        described as {
          |The control through which a user asks the find by citizen question.
        }
      }
      input SearchCasesInput acquires query CaseContext.CaseRepository.SearchCases with {
        briefly "Search cases control"
        described as {
          |The control through which a user asks the search cases question.
        }
      }
      input FindCaseByIdInput acquires query CaseContext.CaseRepository.FindCaseById with {
        briefly "Find case by id control"
        described as {
          |The control through which a user asks the find case by id question.
        }
      }
      input GetStatisticsDataInput acquires query CaseContext.GetStatisticsData with {
        briefly "Get statistics data control"
        described as {
          |The control through which a user asks the get statistics data question.
        }
      }
      input GetAnalyticsDataInput acquires query CaseContext.GetAnalyticsData with {
        briefly "Get analytics data control"
        described as {
          |The control through which a user asks the get analytics data question.
        }
      }
      input FetchCaseInput acquires query CaseContext.Case.FetchCase with {
        briefly "Fetch case control"
        described as {
          |The control through which a user asks the fetch case question.
        }
      }
      input AddHouseholdMemberInput acquires command CaseContext.Case.AddHouseholdMember with {
        briefly "Add household member control"
        described as {
          |The control through which a user submits the add household member request.
        }
      }
      input AddNoteInput acquires command CaseContext.Case.AddNote with {
        briefly "Add note control"
        described as {
          |The control through which a user submits the add note request.
        }
      }
      input ApproveServicesInput acquires command CaseContext.Case.ApproveServices with {
        briefly "Approve services control"
        described as {
          |The control through which a user submits the approve services request.
        }
      }
      input AssignWorkerInput acquires command CaseContext.Case.AssignWorker with {
        briefly "Assign worker control"
        described as {
          |The control through which a user submits the assign worker request.
        }
      }
      input CloseCaseInput acquires command CaseContext.Case.CloseCase with {
        briefly "Close case control"
        described as {
          |The control through which a user submits the close case request.
        }
      }
      input CompleteTaskInput acquires command CaseContext.Case.CompleteTask with {
        briefly "Complete task control"
        described as {
          |The control through which a user submits the complete task request.
        }
      }
      input CreateTaskInput acquires command CaseContext.Case.CreateTask with {
        briefly "Create task control"
        described as {
          |The control through which a user submits the create task request.
        }
      }
      input DenyServicesInput acquires command CaseContext.Case.DenyServices with {
        briefly "Deny services control"
        described as {
          |The control through which a user submits the deny services request.
        }
      }
      input FileAppealInput acquires command CaseContext.Case.FileAppeal with {
        briefly "File appeal control"
        described as {
          |The control through which a user submits the file appeal request.
        }
      }
      input PlaceOnHoldInput acquires command CaseContext.Case.PlaceOnHold with {
        briefly "Place on hold control"
        described as {
          |The control through which a user submits the place on hold request.
        }
      }
      input RemoveHouseholdMemberInput acquires command CaseContext.Case.RemoveHouseholdMember with {
        briefly "Remove household member control"
        described as {
          |The control through which a user submits the remove household member request.
        }
      }
      input ReopenCaseInput acquires command CaseContext.Case.ReopenCase with {
        briefly "Reopen case control"
        described as {
          |The control through which a user submits the reopen case request.
        }
      }
      input ResolveAppealInput acquires command CaseContext.Case.ResolveAppeal with {
        briefly "Resolve appeal control"
        described as {
          |The control through which a user submits the resolve appeal request.
        }
      }
      input ResumeCaseInput acquires command CaseContext.Case.ResumeCase with {
        briefly "Resume case control"
        described as {
          |The control through which a user submits the resume case request.
        }
      }
      input SubmitServiceRequestInput acquires command CaseContext.Case.SubmitServiceRequest with {
        briefly "Submit service request control"
        described as {
          |The control through which a user submits the submit service request request.
        }
      }
      input UpdateCitizenInfoInput acquires command CaseContext.Case.UpdateCitizenInfo with {
        briefly "Update citizen info control"
        described as {
          |The control through which a user submits the update citizen info request.
        }
      }
      input UploadDocumentInput acquires command CaseContext.Case.UploadDocument with {
        briefly "Upload document control"
        described as {
          |The control through which a user submits the upload document request.
        }
      }
      input OpenCaseInput acquires command CaseContext.OpenCase with {
        briefly "Open case control"
        described as {
          |The control through which a user submits the open case request.
        }
      }
    } with {
      briefly "Case management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppCaseRepositoryQueries is type CaseContext.CaseRepository.CaseRepositoryQuery
    inlet AppCaseRepositoryReplies is type CaseContext.CaseRepository.CaseRepositoryReply
    outlet AppCaseQueries is query CaseContext.Case.FetchCase
    outlet AppCaseCommands is type CaseContext.CaseRequest
    inlet AppCaseRepositoryResponses is result CaseContext.Case.CaseQueryResult
    handler CaseManagementAppHandler is {
      on other is {
        error "Unexpected message for application context CaseManagementApp"
      }
    } with {
      briefly "CaseManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CaseManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'CaseRepositoryQuery Stream' is from outlet CaseManagementApp.AppCaseRepositoryQueries to inlet CaseContext.CaseRepositoryQueriesIn with {
    briefly "CaseManagementApp's look-ups of the case repository"
  }
  persistent connector 'CaseRepositoryReply Stream' is from outlet CaseContext.CaseRepositoryRepliesOut to inlet CaseManagementApp.AppCaseRepositoryReplies with {
    briefly "The case repository's answers returned to CaseManagementApp"
  }
  persistent connector 'CaseQuery Stream' is from outlet CaseManagementApp.AppCaseQueries to inlet CaseContext.CaseQueriesIn with {
    briefly "CaseManagementApp's look-ups of the case"
  }
  persistent connector 'CaseCommand Stream' is from outlet CaseManagementApp.AppCaseCommands to inlet CaseContext.CaseCommandStreamIn with {
    briefly "Case commands from the application"
  }
  persistent connector 'CaseQueryResult Stream' is from outlet CaseContext.CaseQueryResultStreamOut to inlet CaseManagementApp.AppCaseRepositoryResponses with {
    briefly "Case query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CaseManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Case management domain"
  described as {
    | The Case Management domain handles citizen
    | service cases and assistance programs.
  }
}
