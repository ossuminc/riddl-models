// Case Management - Case Context
context CaseContext as router is {
  inlet CaseCommandStreamIn is type CaseCommand  outlet CaseCommandStreamOut is type CaseCommand
  inlet CaseQueryResultStreamIn is result Case.CaseQueryResult  outlet CaseQueryResultStreamOut is result Case.CaseQueryResult
  handler CaseContextBoundary is {
    on openCase: command Case.OpenCase is {
      send openCase to outlet CaseContext.CaseCommandStreamOut
    }
    on assignWorker: command Case.AssignWorker is {
      send assignWorker to outlet CaseContext.CaseCommandStreamOut
    }
    on updateCitizenInfo: command Case.UpdateCitizenInfo is {
      send updateCitizenInfo to outlet CaseContext.CaseCommandStreamOut
    }
    on addHouseholdMember: command Case.AddHouseholdMember is {
      send addHouseholdMember to outlet CaseContext.CaseCommandStreamOut
    }
    on removeHouseholdMember: command Case.RemoveHouseholdMember is {
      send removeHouseholdMember to outlet CaseContext.CaseCommandStreamOut
    }
    on recordIncome: command Case.RecordIncome is {
      send recordIncome to outlet CaseContext.CaseCommandStreamOut
    }
    on uploadDocument: command Case.UploadDocument is {
      send uploadDocument to outlet CaseContext.CaseCommandStreamOut
    }
    on submitServiceRequest: command Case.SubmitServiceRequest is {
      send submitServiceRequest to outlet CaseContext.CaseCommandStreamOut
    }
    on determineEligibility: command Case.DetermineEligibility is {
      send determineEligibility to outlet CaseContext.CaseCommandStreamOut
    }
    on addNote: command Case.AddNote is {
      send addNote to outlet CaseContext.CaseCommandStreamOut
    }
    on createTask: command Case.CreateTask is {
      send createTask to outlet CaseContext.CaseCommandStreamOut
    }
    on completeTask: command Case.CompleteTask is {
      send completeTask to outlet CaseContext.CaseCommandStreamOut
    }
    on approveServices: command Case.ApproveServices is {
      send approveServices to outlet CaseContext.CaseCommandStreamOut
    }
    on denyServices: command Case.DenyServices is {
      send denyServices to outlet CaseContext.CaseCommandStreamOut
    }
    on fileAppeal: command Case.FileAppeal is {
      send fileAppeal to outlet CaseContext.CaseCommandStreamOut
    }
    on resolveAppeal: command Case.ResolveAppeal is {
      send resolveAppeal to outlet CaseContext.CaseCommandStreamOut
    }
    on placeOnHold: command Case.PlaceOnHold is {
      send placeOnHold to outlet CaseContext.CaseCommandStreamOut
    }
    on resumeCase: command Case.ResumeCase is {
      send resumeCase to outlet CaseContext.CaseCommandStreamOut
    }
    on closeCase: command Case.CloseCase is {
      send closeCase to outlet CaseContext.CaseCommandStreamOut
    }
    on reopenCase: command Case.ReopenCase is {
      send reopenCase to outlet CaseContext.CaseCommandStreamOut
    }
    on caseQueryResult: result Case.CaseQueryResult is {
      send caseQueryResult to outlet CaseContext.CaseQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the CaseContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CaseCommand Stream Intake' is from outlet CaseContext.CaseCommandStreamOut to inlet CaseContext.Case.CaseCommands  connector 'CaseQueryResult Stream Egress' is from outlet CaseContext.CaseRepository.CaseRepositoryResponses to inlet CaseContext.CaseQueryResultStreamIn  adaptor FromAppointmentService from context AppointmentService is { 
    handler FromAppointmentServiceHandler is {
      on event AppointmentService.AppointmentCancelled is {
        do "the model receives appointment cancelled"
      }
      on event AppointmentService.AppointmentScheduled is {
        do "the model receives appointment scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromAppointmentService"
      }
    } with {
      briefly "from appointment service"
      described as {
        |Carries messages from the external AppointmentService.
      }
    }
  } with {
    briefly "AppointmentService integration"
    described as {
      |The model's side of the AppointmentService conversation.
    }
  }
  adaptor ToAppointmentService to context AppointmentService is { 
    handler ToAppointmentServiceHandler is {
      on command AppointmentService.ScheduleAppointment is {
        do "the model sends schedule appointment"
      }
      on other is {
        error "Unexpected message for adaptor ToAppointmentService"
      }
    } with {
      briefly "to appointment service"
      described as {
        |Carries messages to the external AppointmentService.
      }
    }
  } with {
    briefly "AppointmentService integration"
    described as {
      |The model's side of the AppointmentService conversation.
    }
  }
  adaptor FromBenefitsIntegrationService from context BenefitsIntegrationService is { 
    handler FromBenefitsIntegrationServiceHandler is {
      on event BenefitsIntegrationService.BenefitStatusChanged is {
        do "the model receives benefit status changed"
      }
      on result BenefitsIntegrationService.CurrentBenefitsResult is {
        do "the model receives current benefits result"
      }
      on other is {
        error "Unexpected message for adaptor FromBenefitsIntegrationService"
      }
    } with {
      briefly "from benefits integration service"
      described as {
        |Carries messages from the external BenefitsIntegrationService.
      }
    }
  } with {
    briefly "BenefitsIntegrationService integration"
    described as {
      |The model's side of the BenefitsIntegrationService conversation.
    }
  }
  adaptor ToBenefitsIntegrationService to context BenefitsIntegrationService is { 
    handler ToBenefitsIntegrationServiceHandler is {
      on query BenefitsIntegrationService.GetCurrentBenefits is {
        do "the model sends get current benefits"
      }
      on other is {
        error "Unexpected message for adaptor ToBenefitsIntegrationService"
      }
    } with {
      briefly "to benefits integration service"
      described as {
        |Carries messages to the external BenefitsIntegrationService.
      }
    }
  } with {
    briefly "BenefitsIntegrationService integration"
    described as {
      |The model's side of the BenefitsIntegrationService conversation.
    }
  }
  adaptor FromDocumentManagementService from context DocumentManagementService is { 
    handler FromDocumentManagementServiceHandler is {
      on result DocumentManagementService.DocumentResult is {
        do "the model receives document result"
      }
      on event DocumentManagementService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentManagementService"
      }
    } with {
      briefly "from document management service"
      described as {
        |Carries messages from the external DocumentManagementService.
      }
    }
  } with {
    briefly "DocumentManagementService integration"
    described as {
      |The model's side of the DocumentManagementService conversation.
    }
  }
  adaptor ToDocumentManagementService to context DocumentManagementService is { 
    handler ToDocumentManagementServiceHandler is {
      on query DocumentManagementService.RetrieveDocument is {
        do "the model sends retrieve document"
      }
      on command DocumentManagementService.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentManagementService"
      }
    } with {
      briefly "to document management service"
      described as {
        |Carries messages to the external DocumentManagementService.
      }
    }
  } with {
    briefly "DocumentManagementService integration"
    described as {
      |The model's side of the DocumentManagementService conversation.
    }
  }
  adaptor FromIdentityVerificationService from context IdentityVerificationService is { 
    handler FromIdentityVerificationServiceHandler is {
      on event IdentityVerificationService.IdentityVerified is {
        do "the model receives identity verified"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityVerificationService"
      }
    } with {
      briefly "from identity verification service"
      described as {
        |Carries messages from the external IdentityVerificationService.
      }
    }
  } with {
    briefly "IdentityVerificationService integration"
    described as {
      |The model's side of the IdentityVerificationService conversation.
    }
  }
  adaptor ToIdentityVerificationService to context IdentityVerificationService is { 
    handler ToIdentityVerificationServiceHandler is {
      on command IdentityVerificationService.VerifyIdentity is {
        do "the model sends verify identity"
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityVerificationService"
      }
    } with {
      briefly "to identity verification service"
      described as {
        |Carries messages to the external IdentityVerificationService.
      }
    }
  } with {
    briefly "IdentityVerificationService integration"
    described as {
      |The model's side of the IdentityVerificationService conversation.
    }
  }
  adaptor FromIncomeVerificationService from context IncomeVerificationService is { 
    handler FromIncomeVerificationServiceHandler is {
      on event IncomeVerificationService.EmploymentVerified is {
        do "the model receives employment verified"
      }
      on result IncomeVerificationService.WageHistoryResult is {
        do "the model receives wage history result"
      }
      on other is {
        error "Unexpected message for adaptor FromIncomeVerificationService"
      }
    } with {
      briefly "from income verification service"
      described as {
        |Carries messages from the external IncomeVerificationService.
      }
    }
  } with {
    briefly "IncomeVerificationService integration"
    described as {
      |The model's side of the IncomeVerificationService conversation.
    }
  }
  adaptor ToIncomeVerificationService to context IncomeVerificationService is { 
    handler ToIncomeVerificationServiceHandler is {
      on query IncomeVerificationService.GetWageHistory is {
        do "the model sends get wage history"
      }
      on command IncomeVerificationService.VerifyEmployment is {
        do "the model sends verify employment"
      }
      on other is {
        error "Unexpected message for adaptor ToIncomeVerificationService"
      }
    } with {
      briefly "to income verification service"
      described as {
        |Carries messages to the external IncomeVerificationService.
      }
    }
  } with {
    briefly "IncomeVerificationService integration"
    described as {
      |The model's side of the IncomeVerificationService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendNotification is {
        do "the model sends send notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentService from context PaymentService is { 
    handler FromPaymentServiceHandler is {
      on event PaymentService.BenefitIssued is {
        do "the model receives benefit issued"
      }
      on event PaymentService.PaymentFailed is {
        do "the model receives payment failed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentService"
      }
    } with {
      briefly "from payment service"
      described as {
        |Carries messages from the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor ToPaymentService to context PaymentService is { 
    handler ToPaymentServiceHandler is {
      on command PaymentService.IssueBenefit is {
        do "the model sends issue benefit"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentService"
      }
    } with {
      briefly "to payment service"
      described as {
        |Carries messages to the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  include "types.riddl"
  include "Case.riddl"
  // Repository
  type CaseRepositoryCommand is one of {
    CaseContext.CaseRepository.PersistAppealFiled or CaseContext.CaseRepository.PersistAppealResolved or CaseContext.CaseRepository.PersistCaseClosed or CaseContext.CaseRepository.PersistCaseOpened or CaseContext.CaseRepository.PersistCasePlacedOnHold or CaseContext.CaseRepository.PersistCaseReopened or CaseContext.CaseRepository.PersistCaseResumed or CaseContext.CaseRepository.PersistCitizenInfoUpdated or CaseContext.CaseRepository.PersistDocumentUploaded or CaseContext.CaseRepository.PersistEligibilityDetermined or CaseContext.CaseRepository.PersistHouseholdMemberAdded or CaseContext.CaseRepository.PersistHouseholdMemberRemoved or CaseContext.CaseRepository.PersistIncomeRecorded or CaseContext.CaseRepository.PersistNoteAdded or CaseContext.CaseRepository.PersistServicesApproved or CaseContext.CaseRepository.PersistServicesDenied or CaseContext.CaseRepository.PersistServicesRequested or CaseContext.CaseRepository.PersistTaskCompleted or CaseContext.CaseRepository.PersistTaskCreated or CaseContext.CaseRepository.PersistWorkerAssigned
  } with {
    briefly "Anything that writes CaseRepository"
    described as {
      |The persistence commands CaseRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository CaseRepository as flow is {
    inlet CaseRepositoryFromWorkloadAnalytics is type CaseRepositoryCommand
    command PersistCasePlacedOnHold is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CasePlacedOnHold applies to.
        }
      }
    } with {
      briefly "Persist CasePlacedOnHold"
      described as {
        |Instructs this repository to apply CasePlacedOnHold to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCaseReopened is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseReopened applies to.
        }
      }
    } with {
      briefly "Persist CaseReopened"
      described as {
        |Instructs this repository to apply CaseReopened to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCaseResumed is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseResumed applies to.
        }
      }
    } with {
      briefly "Persist CaseResumed"
      described as {
        |Instructs this repository to apply CaseResumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCitizenInfoUpdated is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CitizenInfoUpdated applies to.
        }
      }
    } with {
      briefly "Persist CitizenInfoUpdated"
      described as {
        |Instructs this repository to apply CitizenInfoUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDocumentUploaded is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row DocumentUploaded applies to.
        }
      }
    } with {
      briefly "Persist DocumentUploaded"
      described as {
        |Instructs this repository to apply DocumentUploaded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEligibilityDetermined is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row EligibilityDetermined applies to.
        }
      }
    } with {
      briefly "Persist EligibilityDetermined"
      described as {
        |Instructs this repository to apply EligibilityDetermined to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHouseholdMemberAdded is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row HouseholdMemberAdded applies to.
        }
      }
    } with {
      briefly "Persist HouseholdMemberAdded"
      described as {
        |Instructs this repository to apply HouseholdMemberAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHouseholdMemberRemoved is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row HouseholdMemberRemoved applies to.
        }
      }
    } with {
      briefly "Persist HouseholdMemberRemoved"
      described as {
        |Instructs this repository to apply HouseholdMemberRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncomeRecorded is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncomeRecorded applies to.
        }
      }
    } with {
      briefly "Persist IncomeRecorded"
      described as {
        |Instructs this repository to apply IncomeRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistNoteAdded is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row NoteAdded applies to.
        }
      }
    } with {
      briefly "Persist NoteAdded"
      described as {
        |Instructs this repository to apply NoteAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAppealFiled is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row AppealFiled applies to.
        }
      }
    } with {
      briefly "Persist AppealFiled"
      described as {
        |Instructs this repository to apply AppealFiled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAppealResolved is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row AppealResolved applies to.
        }
      }
    } with {
      briefly "Persist AppealResolved"
      described as {
        |Instructs this repository to apply AppealResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCaseClosed is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseClosed applies to.
        }
      }
    } with {
      briefly "Persist CaseClosed"
      described as {
        |Instructs this repository to apply CaseClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCaseOpened is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseOpened applies to.
        }
      }
    } with {
      briefly "Persist CaseOpened"
      described as {
        |Instructs this repository to apply CaseOpened to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServicesApproved is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServicesApproved applies to.
        }
      }
    } with {
      briefly "Persist ServicesApproved"
      described as {
        |Instructs this repository to apply ServicesApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServicesDenied is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServicesDenied applies to.
        }
      }
    } with {
      briefly "Persist ServicesDenied"
      described as {
        |Instructs this repository to apply ServicesDenied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServicesRequested is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServicesRequested applies to.
        }
      }
    } with {
      briefly "Persist ServicesRequested"
      described as {
        |Instructs this repository to apply ServicesRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTaskCompleted is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row TaskCompleted applies to.
        }
      }
    } with {
      briefly "Persist TaskCompleted"
      described as {
        |Instructs this repository to apply TaskCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTaskCreated is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row TaskCreated applies to.
        }
      }
    } with {
      briefly "Persist TaskCreated"
      described as {
        |Instructs this repository to apply TaskCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkerAssigned is  {
      caseId: CaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkerAssigned applies to.
        }
      }
    } with {
      briefly "Persist WorkerAssigned"
      described as {
        |Instructs this repository to apply WorkerAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredCase is  {
      caseId: CaseId with {
        briefly "caseId"
        described as {
          |The caseId column of the stored case row.
        }
      }
    } with {
      briefly "Stored case row"
      described as {
        |The persistence shape of case data as this repository stores it.
      }
    }
    schema CaseData is relational
      of cases as record StoredCase
        index on field StoredCase.caseId
 with {
      briefly "Case data schema"
      described as {
        |The relational schema persisting case records for this repository.
      }
    }
    outlet CaseRepositoryResponses is result Case.CaseQueryResult
    query FindCaseById replies result CaseResult is  {
      caseId: CaseId with {
        briefly "Case"
        described as {
          |Case identifier.
        }
      }
    } with {
      briefly "Find case by ID"
      described as {
        |Retrieves case by identifier.
      }
    }
    result CaseResult is  {
      caseObj: Case.ActiveStateData with {
        briefly "Case"
        described as {
          |Case data.
        }
      }
    } with {
      briefly "Case result"
      described as {
        |Returns case data.
      }
    }
    query SearchCases replies result CasesResult is  {
      filterCaseType: CaseType? with {
        briefly "Type"
        described as {
          |Filter by type.
        }
      }
      filterStatus: CaseStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      filterWorkerId: WorkerId? with {
        briefly "Worker"
        described as {
          |Filter by worker.
        }
      }
      filterPriority: CasePriority? with {
        briefly "Priority"
        described as {
          |Filter by priority.
        }
      }
    } with {
      briefly "Search cases"
      described as {
        |Searches cases by criteria.
      }
    }
    result CasesResult is  {
      cases: Case.ActiveStateData+ with {
        briefly "Cases"
        described as {
          |Matching cases.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Cases result"
      described as {
        |Returns matching cases.
      }
    }
    query FindByCitizen replies result CasesResult is  {
      citizenId: CitizenId with {
        briefly "Citizen"
        described as {
          |Citizen identifier.
        }
      }
    } with {
      briefly "Find by citizen"
      described as {
        |Finds cases for a citizen.
      }
    }
    query FindBySSN replies result CasesResult is  {
      ssn: String(9,9) with {
        briefly "SSN"
        described as {
          |Social security number.
        }
      }
    } with {
      briefly "Find by SSN"
      described as {
        |Finds cases by SSN.
      }
    }
    query FindPendingTasks replies result CasesResult is  {
      workerId: WorkerId with {
        briefly "Worker"
        described as {
          |Worker identifier.
        }
      }
    } with {
      briefly "Find pending tasks"
      described as {
        |Finds worker's pending tasks.
      }
    }
    query FindPendingApprovals replies result CasesResult is  {
      supervisorId: WorkerId with {
        briefly "Supervisor"
        described as {
          |Supervisor identifier.
        }
      }
    } with {
      briefly "Find pending approvals"
      described as {
        |Finds cases awaiting approval.
      }
    }
    handler CaseRepositoryHandler is {
      on persistCasePlacedOnHold: command PersistCasePlacedOnHold is {
        do "apply CasePlacedOnHold to the stored row"
      }
      on persistCaseReopened: command PersistCaseReopened is {
        do "apply CaseReopened to the stored row"
      }
      on persistCaseResumed: command PersistCaseResumed is {
        do "apply CaseResumed to the stored row"
      }
      on persistCitizenInfoUpdated: command PersistCitizenInfoUpdated is {
        do "apply CitizenInfoUpdated to the stored row"
      }
      on persistDocumentUploaded: command PersistDocumentUploaded is {
        do "apply DocumentUploaded to the stored row"
      }
      on persistEligibilityDetermined: command PersistEligibilityDetermined is {
        do "apply EligibilityDetermined to the stored row"
      }
      on persistHouseholdMemberAdded: command PersistHouseholdMemberAdded is {
        do "apply HouseholdMemberAdded to the stored row"
      }
      on persistHouseholdMemberRemoved: command PersistHouseholdMemberRemoved is {
        do "apply HouseholdMemberRemoved to the stored row"
      }
      on persistIncomeRecorded: command PersistIncomeRecorded is {
        do "apply IncomeRecorded to the stored row"
      }
      on persistNoteAdded: command PersistNoteAdded is {
        do "apply NoteAdded to the stored row"
      }
      on persistAppealFiled: command PersistAppealFiled is {
        do "apply AppealFiled to the stored row"
      }
      on persistAppealResolved: command PersistAppealResolved is {
        do "apply AppealResolved to the stored row"
      }
      on persistCaseClosed: command PersistCaseClosed is {
        do "apply CaseClosed to the stored row"
      }
      on persistCaseOpened: command PersistCaseOpened is {
        do "apply CaseOpened to the stored row"
      }
      on persistServicesApproved: command PersistServicesApproved is {
        do "apply ServicesApproved to the stored row"
      }
      on persistServicesDenied: command PersistServicesDenied is {
        do "apply ServicesDenied to the stored row"
      }
      on persistServicesRequested: command PersistServicesRequested is {
        do "apply ServicesRequested to the stored row"
      }
      on persistTaskCompleted: command PersistTaskCompleted is {
        do "apply TaskCompleted to the stored row"
      }
      on persistTaskCreated: command PersistTaskCreated is {
        do "apply TaskCreated to the stored row"
      }
      on persistWorkerAssigned: command PersistWorkerAssigned is {
        do "apply WorkerAssigned to the stored row"
      }
      on query GetAnalyticsData is {
        let analyticsDataView: type AnalyticsDataView = prompt("read the analytics data projection")
        reply analyticsDataView
      }
      on query GetStatisticsData is {
        let statisticsDataView: type StatisticsDataView = prompt("read the statistics data projection")
        reply statisticsDataView
      }
      on query FindCaseById is {
        let caseResult: type CaseResult = prompt("read the case from the store")
        reply caseResult
      }
      on query SearchCases is {
        let casesResult: type CasesResult = prompt("read the cases from the store")
        reply casesResult
      }
      on query FindByCitizen is {
        let casesResult: type CasesResult = prompt("read the cases that by citizen asks for")
        reply casesResult
      }
      on query FindBySSN is {
        let casesResult: type CasesResult = prompt("read the cases that by s s n asks for")
        reply casesResult
      }
      on query FindPendingTasks is {
        let casesResult: type CasesResult = prompt("read the cases that pending tasks asks for")
        reply casesResult
      }
      on query FindPendingApprovals is {
        let casesResult: type CasesResult = prompt("read the cases that pending approvals asks for")
        reply casesResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes case queries.
      }
    }
  } with {
    briefly "Case repository"
    described as {
      |Persistence for case records.
    }
  }
  // Projector for workload analytics
  query GetAnalyticsData replies result AnalyticsDataView is  {
    analyticsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which analytics data to retrieve.
      }
    }
  } with {
    briefly "Get analytics data"
    described as {
      |Retrieves the analytics data projection.
    }
  }
  result AnalyticsDataView is  {
    analyticsData: WorkloadAnalytics.AnalyticsData with {
      briefly "Analytics data"
      described as {
        |The analytics data being returned.
      }
    }
  } with {
    briefly "Analytics data view"
    described as {
      |Read model view carrying the analytics data projection.
    }
  }
  projector WorkloadAnalytics as flow is {
    outlet WorkloadAnalyticsToRepository is type CaseRepositoryCommand
    updates repository CaseContext.CaseRepository
    inlet WorkloadAnalyticsFromCase is type CaseEvent
    record AnalyticsData is  {
      totalOpenCases: Natural with {
        briefly "Open"
        described as {
          |Total open cases.
        }
      }
      casesByType: TypeCount+ with {
        briefly "By type"
        described as {
          |Cases by type.
        }
      }
      casesByStatus: StatusCount+ with {
        briefly "By status"
        described as {
          |Cases by status.
        }
      }
      casesByWorker: WorkerCaseload+ with {
        briefly "By worker"
        described as {
          |Cases per worker.
        }
      }
      averageProcessingDays: Decimal(6,2) with {
        briefly "Avg days"
        described as {
          |Average processing time.
        }
      }
      pendingApprovals: Natural with {
        briefly "Pending"
        described as {
          |Awaiting approval.
        }
      }
      overdueTasks: Natural with {
        briefly "Overdue"
        described as {
          |Overdue tasks.
        }
      }
    } with {
      briefly "Analytics data"
      described as {
        |Workload metrics.
      }
    }
    record TypeCount is  {
      caseType: CaseType with {
        briefly "Type"
        described as {
          |Case type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Case count.
        }
      }
    } with {
      briefly "Type count"
      described as {
        |Count by case type.
      }
    }
    record StatusCount is  {
      status: CaseStatus with {
        briefly "Status"
        described as {
          |Case status.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Case count.
        }
      }
    } with {
      briefly "Status count"
      described as {
        |Count by status.
      }
    }
    record WorkerCaseload is  {
      workerId: WorkerId with {
        briefly "Worker"
        described as {
          |Worker ID.
        }
      }
      openCases: Natural with {
        briefly "Open"
        described as {
          |Open cases.
        }
      }
      pendingTasks: Natural with {
        briefly "Tasks"
        described as {
          |Pending tasks.
        }
      }
    } with {
      briefly "Worker caseload"
      described as {
        |Worker's caseload.
      }
    }
    handler AnalyticsHandler is {
      on appealFiled: event Case.AppealFiled is {
        tell command CaseContext.CaseRepository.PersistAppealFiled(caseId = appealFiled.caseId) to repository CaseContext.CaseRepository
        do "apply AppealFiled to the WorkloadAnalytics projection"
      }
      on appealResolved: event Case.AppealResolved is {
        tell command CaseContext.CaseRepository.PersistAppealResolved(caseId = appealResolved.caseId) to repository CaseContext.CaseRepository
        do "apply AppealResolved to the WorkloadAnalytics projection"
      }
      on casePlacedOnHold: event Case.CasePlacedOnHold is {
        tell command CaseContext.CaseRepository.PersistCasePlacedOnHold(caseId = casePlacedOnHold.caseId) to repository CaseContext.CaseRepository
        do "apply CasePlacedOnHold to the WorkloadAnalytics projection"
      }
      on caseReopened: event Case.CaseReopened is {
        tell command CaseContext.CaseRepository.PersistCaseReopened(caseId = caseReopened.caseId) to repository CaseContext.CaseRepository
        do "apply CaseReopened to the WorkloadAnalytics projection"
      }
      on caseResumed: event Case.CaseResumed is {
        tell command CaseContext.CaseRepository.PersistCaseResumed(caseId = caseResumed.caseId) to repository CaseContext.CaseRepository
        do "apply CaseResumed to the WorkloadAnalytics projection"
      }
      on citizenInfoUpdated: event Case.CitizenInfoUpdated is {
        tell command CaseContext.CaseRepository.PersistCitizenInfoUpdated(caseId = citizenInfoUpdated.caseId) to repository CaseContext.CaseRepository
        do "apply CitizenInfoUpdated to the WorkloadAnalytics projection"
      }
      on documentUploaded: event Case.DocumentUploaded is {
        tell command CaseContext.CaseRepository.PersistDocumentUploaded(caseId = documentUploaded.caseId) to repository CaseContext.CaseRepository
        do "apply DocumentUploaded to the WorkloadAnalytics projection"
      }
      on eligibilityDetermined: event Case.EligibilityDetermined is {
        tell command CaseContext.CaseRepository.PersistEligibilityDetermined(caseId = eligibilityDetermined.caseId) to repository CaseContext.CaseRepository
        do "apply EligibilityDetermined to the WorkloadAnalytics projection"
      }
      on householdMemberAdded: event Case.HouseholdMemberAdded is {
        tell command CaseContext.CaseRepository.PersistHouseholdMemberAdded(caseId = householdMemberAdded.caseId) to repository CaseContext.CaseRepository
        do "apply HouseholdMemberAdded to the WorkloadAnalytics projection"
      }
      on householdMemberRemoved: event Case.HouseholdMemberRemoved is {
        tell command CaseContext.CaseRepository.PersistHouseholdMemberRemoved(caseId = householdMemberRemoved.caseId) to repository CaseContext.CaseRepository
        do "apply HouseholdMemberRemoved to the WorkloadAnalytics projection"
      }
      on incomeRecorded: event Case.IncomeRecorded is {
        tell command CaseContext.CaseRepository.PersistIncomeRecorded(caseId = incomeRecorded.caseId) to repository CaseContext.CaseRepository
        do "apply IncomeRecorded to the WorkloadAnalytics projection"
      }
      on noteAdded: event Case.NoteAdded is {
        tell command CaseContext.CaseRepository.PersistNoteAdded(caseId = noteAdded.caseId) to repository CaseContext.CaseRepository
        do "apply NoteAdded to the WorkloadAnalytics projection"
      }
      on servicesApproved: event Case.ServicesApproved is {
        tell command CaseContext.CaseRepository.PersistServicesApproved(caseId = servicesApproved.caseId) to repository CaseContext.CaseRepository
        do "apply ServicesApproved to the WorkloadAnalytics projection"
      }
      on servicesDenied: event Case.ServicesDenied is {
        tell command CaseContext.CaseRepository.PersistServicesDenied(caseId = servicesDenied.caseId) to repository CaseContext.CaseRepository
        do "apply ServicesDenied to the WorkloadAnalytics projection"
      }
      on servicesRequested: event Case.ServicesRequested is {
        tell command CaseContext.CaseRepository.PersistServicesRequested(caseId = servicesRequested.caseId) to repository CaseContext.CaseRepository
        do "apply ServicesRequested to the WorkloadAnalytics projection"
      }
      on caseOpened: event Case.CaseOpened is {
        tell command CaseContext.CaseRepository.PersistCaseOpened(caseId = caseOpened.caseId) to repository CaseContext.CaseRepository
      }
      on workerAssigned: event Case.WorkerAssigned is {
        tell command CaseContext.CaseRepository.PersistWorkerAssigned(caseId = workerAssigned.caseId) to repository CaseContext.CaseRepository
      }
      on taskCreated: event Case.TaskCreated is {
        tell command CaseContext.CaseRepository.PersistTaskCreated(caseId = taskCreated.caseId) to repository CaseContext.CaseRepository
      }
      on taskCompleted: event Case.TaskCompleted is {
        tell command CaseContext.CaseRepository.PersistTaskCompleted(caseId = taskCompleted.caseId) to repository CaseContext.CaseRepository
      }
      on caseClosed: event Case.CaseClosed is {
        tell command CaseContext.CaseRepository.PersistCaseClosed(caseId = caseClosed.caseId) to repository CaseContext.CaseRepository
      }
    } with {
      briefly "Processes analytics events"
      described as {
        |Updates workload analytics.
      }
    }
  } with {
    briefly "Workload analytics"
    described as {
      |Projects workload metrics for management.
    }
  }
  // Projector for program statistics
  query GetStatisticsData replies result StatisticsDataView is  {
    statisticsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which statistics data to retrieve.
      }
    }
  } with {
    briefly "Get statistics data"
    described as {
      |Retrieves the statistics data projection.
    }
  }
  result StatisticsDataView is  {
    statisticsData: ProgramStatistics.StatisticsData with {
      briefly "Statistics data"
      described as {
        |The statistics data being returned.
      }
    }
  } with {
    briefly "Statistics data view"
    described as {
      |Read model view carrying the statistics data projection.
    }
  }
  projector ProgramStatistics as sink is {
    updates repository CaseContext.CaseRepository
    inlet ProgramStatisticsFromCase is type CaseEvent
    record StatisticsData is  {
      programStats: ProgramStat+ with {
        briefly "Stats"
        described as {
          |Per-program statistics.
        }
      }
      totalBenefitsPaid: Decimal(12,2) with {
        briefly "Benefits"
        described as {
          |Total benefits paid.
        }
      }
      approvalRate: Decimal(5,2) with {
        briefly "Approval"
        described as {
          |Approval rate percentage.
        }
      }
      averageBenefit: Decimal(10,2) with {
        briefly "Average"
        described as {
          |Average benefit amount.
        }
      }
      appealCount: Natural with {
        briefly "Appeals"
        described as {
          |Total appeals filed.
        }
      }
      appealSuccessRate: Decimal(5,2) with {
        briefly "Appeal success"
        described as {
          |Appeal success rate.
        }
      }
    } with {
      briefly "Statistics data"
      described as {
        |Program statistics.
      }
    }
    record ProgramStat is  {
      programId: ProgramId with {
        briefly "Program"
        described as {
          |Program ID.
        }
      }
      programName: String(1,200) with {
        briefly "Name"
        described as {
          |Program name.
        }
      }
      applicationsReceived: Natural with {
        briefly "Received"
        described as {
          |Applications received.
        }
      }
      approved: Natural with {
        briefly "Approved"
        described as {
          |Applications approved.
        }
      }
      denied: Natural with {
        briefly "Denied"
        described as {
          |Applications denied.
        }
      }
      totalPaid: Decimal(12,2) with {
        briefly "Paid"
        described as {
          |Total benefits paid.
        }
      }
    } with {
      briefly "Program stat"
      described as {
        |Statistics for program.
      }
    }
    handler StatisticsHandler is {
      on caseClosed: event Case.CaseClosed is {
        tell command CaseContext.CaseRepository.PersistCaseClosed(caseId = caseClosed.caseId) to repository CaseContext.CaseRepository
        do "apply CaseClosed to the ProgramStatistics projection"
      }
      on caseOpened: event Case.CaseOpened is {
        tell command CaseContext.CaseRepository.PersistCaseOpened(caseId = caseOpened.caseId) to repository CaseContext.CaseRepository
        do "apply CaseOpened to the ProgramStatistics projection"
      }
      on casePlacedOnHold: event Case.CasePlacedOnHold is {
        tell command CaseContext.CaseRepository.PersistCasePlacedOnHold(caseId = casePlacedOnHold.caseId) to repository CaseContext.CaseRepository
        do "apply CasePlacedOnHold to the ProgramStatistics projection"
      }
      on caseReopened: event Case.CaseReopened is {
        tell command CaseContext.CaseRepository.PersistCaseReopened(caseId = caseReopened.caseId) to repository CaseContext.CaseRepository
        do "apply CaseReopened to the ProgramStatistics projection"
      }
      on caseResumed: event Case.CaseResumed is {
        tell command CaseContext.CaseRepository.PersistCaseResumed(caseId = caseResumed.caseId) to repository CaseContext.CaseRepository
        do "apply CaseResumed to the ProgramStatistics projection"
      }
      on citizenInfoUpdated: event Case.CitizenInfoUpdated is {
        tell command CaseContext.CaseRepository.PersistCitizenInfoUpdated(caseId = citizenInfoUpdated.caseId) to repository CaseContext.CaseRepository
        do "apply CitizenInfoUpdated to the ProgramStatistics projection"
      }
      on documentUploaded: event Case.DocumentUploaded is {
        tell command CaseContext.CaseRepository.PersistDocumentUploaded(caseId = documentUploaded.caseId) to repository CaseContext.CaseRepository
        do "apply DocumentUploaded to the ProgramStatistics projection"
      }
      on eligibilityDetermined: event Case.EligibilityDetermined is {
        tell command CaseContext.CaseRepository.PersistEligibilityDetermined(caseId = eligibilityDetermined.caseId) to repository CaseContext.CaseRepository
        do "apply EligibilityDetermined to the ProgramStatistics projection"
      }
      on householdMemberAdded: event Case.HouseholdMemberAdded is {
        tell command CaseContext.CaseRepository.PersistHouseholdMemberAdded(caseId = householdMemberAdded.caseId) to repository CaseContext.CaseRepository
        do "apply HouseholdMemberAdded to the ProgramStatistics projection"
      }
      on householdMemberRemoved: event Case.HouseholdMemberRemoved is {
        tell command CaseContext.CaseRepository.PersistHouseholdMemberRemoved(caseId = householdMemberRemoved.caseId) to repository CaseContext.CaseRepository
        do "apply HouseholdMemberRemoved to the ProgramStatistics projection"
      }
      on incomeRecorded: event Case.IncomeRecorded is {
        tell command CaseContext.CaseRepository.PersistIncomeRecorded(caseId = incomeRecorded.caseId) to repository CaseContext.CaseRepository
        do "apply IncomeRecorded to the ProgramStatistics projection"
      }
      on noteAdded: event Case.NoteAdded is {
        tell command CaseContext.CaseRepository.PersistNoteAdded(caseId = noteAdded.caseId) to repository CaseContext.CaseRepository
        do "apply NoteAdded to the ProgramStatistics projection"
      }
      on taskCompleted: event Case.TaskCompleted is {
        tell command CaseContext.CaseRepository.PersistTaskCompleted(caseId = taskCompleted.caseId) to repository CaseContext.CaseRepository
        do "apply TaskCompleted to the ProgramStatistics projection"
      }
      on taskCreated: event Case.TaskCreated is {
        tell command CaseContext.CaseRepository.PersistTaskCreated(caseId = taskCreated.caseId) to repository CaseContext.CaseRepository
        do "apply TaskCreated to the ProgramStatistics projection"
      }
      on workerAssigned: event Case.WorkerAssigned is {
        tell command CaseContext.CaseRepository.PersistWorkerAssigned(caseId = workerAssigned.caseId) to repository CaseContext.CaseRepository
        do "apply WorkerAssigned to the ProgramStatistics projection"
      }
      on servicesRequested: event Case.ServicesRequested is {
        tell command CaseContext.CaseRepository.PersistServicesRequested(caseId = servicesRequested.caseId) to repository CaseContext.CaseRepository
      }
      on servicesApproved: event Case.ServicesApproved is {
        tell command CaseContext.CaseRepository.PersistServicesApproved(caseId = servicesApproved.caseId) to repository CaseContext.CaseRepository
      }
      on servicesDenied: event Case.ServicesDenied is {
        tell command CaseContext.CaseRepository.PersistServicesDenied(caseId = servicesDenied.caseId) to repository CaseContext.CaseRepository
      }
      on appealFiled: event Case.AppealFiled is {
        tell command CaseContext.CaseRepository.PersistAppealFiled(caseId = appealFiled.caseId) to repository CaseContext.CaseRepository
      }
      on appealResolved: event Case.AppealResolved is {
        tell command CaseContext.CaseRepository.PersistAppealResolved(caseId = appealResolved.caseId) to repository CaseContext.CaseRepository
      }
    } with {
      briefly "Processes statistics events"
      described as {
        |Updates program statistics.
      }
    }
  } with {
    briefly "Program statistics"
    described as {
      |Projects program performance metrics.
    }
  }
  // ---- Event publication for Case ----
  type CaseEvent is one of {
    CaseContext.Case.CaseOpened or CaseContext.Case.WorkerAssigned or CaseContext.Case.CitizenInfoUpdated or CaseContext.Case.HouseholdMemberAdded or CaseContext.Case.HouseholdMemberRemoved or CaseContext.Case.IncomeRecorded or CaseContext.Case.DocumentUploaded or CaseContext.Case.ServicesRequested or CaseContext.Case.EligibilityDetermined or CaseContext.Case.NoteAdded or CaseContext.Case.TaskCreated or CaseContext.Case.TaskCompleted or CaseContext.Case.ServicesApproved or CaseContext.Case.ServicesDenied or CaseContext.Case.AppealFiled or CaseContext.Case.AppealResolved or CaseContext.Case.CasePlacedOnHold or CaseContext.Case.CaseResumed or CaseContext.Case.CaseClosed or CaseContext.Case.CaseReopened
  } with {
    briefly "Case event alternation"
    described as {
      |Union of all Case events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CaseEventSplit as split is {
    inlet CaseEventSplitIn is type CaseEvent
    outlet CaseEventSplitToWorkloadAnalytics is type CaseEvent
    outlet CaseEventSplitToProgramStatistics is type CaseEvent
    handler CaseEventSplitHandler is {
      on caseOpened: event Case.CaseOpened is {
        send caseOpened to outlet CaseEventSplitToWorkloadAnalytics
        send caseOpened to outlet CaseEventSplitToProgramStatistics
        tell caseOpened to entity CaseContext.Case
      }
      on workerAssigned: event Case.WorkerAssigned is {
        send workerAssigned to outlet CaseEventSplitToWorkloadAnalytics
        send workerAssigned to outlet CaseEventSplitToProgramStatistics
        tell workerAssigned to entity CaseContext.Case
      }
      on citizenInfoUpdated: event Case.CitizenInfoUpdated is {
        send citizenInfoUpdated to outlet CaseEventSplitToWorkloadAnalytics
        send citizenInfoUpdated to outlet CaseEventSplitToProgramStatistics
        tell citizenInfoUpdated to entity CaseContext.Case
      }
      on householdMemberAdded: event Case.HouseholdMemberAdded is {
        send householdMemberAdded to outlet CaseEventSplitToWorkloadAnalytics
        send householdMemberAdded to outlet CaseEventSplitToProgramStatistics
        tell householdMemberAdded to entity CaseContext.Case
      }
      on householdMemberRemoved: event Case.HouseholdMemberRemoved is {
        send householdMemberRemoved to outlet CaseEventSplitToWorkloadAnalytics
        send householdMemberRemoved to outlet CaseEventSplitToProgramStatistics
        tell householdMemberRemoved to entity CaseContext.Case
      }
      on incomeRecorded: event Case.IncomeRecorded is {
        send incomeRecorded to outlet CaseEventSplitToWorkloadAnalytics
        send incomeRecorded to outlet CaseEventSplitToProgramStatistics
        tell incomeRecorded to entity CaseContext.Case
      }
      on documentUploaded: event Case.DocumentUploaded is {
        send documentUploaded to outlet CaseEventSplitToWorkloadAnalytics
        send documentUploaded to outlet CaseEventSplitToProgramStatistics
        tell documentUploaded to entity CaseContext.Case
      }
      on servicesRequested: event Case.ServicesRequested is {
        send servicesRequested to outlet CaseEventSplitToWorkloadAnalytics
        send servicesRequested to outlet CaseEventSplitToProgramStatistics
        tell servicesRequested to entity CaseContext.Case
      }
      on eligibilityDetermined: event Case.EligibilityDetermined is {
        send eligibilityDetermined to outlet CaseEventSplitToWorkloadAnalytics
        send eligibilityDetermined to outlet CaseEventSplitToProgramStatistics
        tell eligibilityDetermined to entity CaseContext.Case
      }
      on noteAdded: event Case.NoteAdded is {
        send noteAdded to outlet CaseEventSplitToWorkloadAnalytics
        send noteAdded to outlet CaseEventSplitToProgramStatistics
        tell noteAdded to entity CaseContext.Case
      }
      on taskCreated: event Case.TaskCreated is {
        send taskCreated to outlet CaseEventSplitToWorkloadAnalytics
        send taskCreated to outlet CaseEventSplitToProgramStatistics
        tell taskCreated to entity CaseContext.Case
      }
      on taskCompleted: event Case.TaskCompleted is {
        send taskCompleted to outlet CaseEventSplitToWorkloadAnalytics
        send taskCompleted to outlet CaseEventSplitToProgramStatistics
        tell taskCompleted to entity CaseContext.Case
      }
      on servicesApproved: event Case.ServicesApproved is {
        send servicesApproved to outlet CaseEventSplitToWorkloadAnalytics
        send servicesApproved to outlet CaseEventSplitToProgramStatistics
        tell servicesApproved to entity CaseContext.Case
      }
      on servicesDenied: event Case.ServicesDenied is {
        send servicesDenied to outlet CaseEventSplitToWorkloadAnalytics
        send servicesDenied to outlet CaseEventSplitToProgramStatistics
        tell servicesDenied to entity CaseContext.Case
      }
      on appealFiled: event Case.AppealFiled is {
        send appealFiled to outlet CaseEventSplitToWorkloadAnalytics
        send appealFiled to outlet CaseEventSplitToProgramStatistics
        tell appealFiled to entity CaseContext.Case
      }
      on appealResolved: event Case.AppealResolved is {
        send appealResolved to outlet CaseEventSplitToWorkloadAnalytics
        send appealResolved to outlet CaseEventSplitToProgramStatistics
        tell appealResolved to entity CaseContext.Case
      }
      on casePlacedOnHold: event Case.CasePlacedOnHold is {
        send casePlacedOnHold to outlet CaseEventSplitToWorkloadAnalytics
        send casePlacedOnHold to outlet CaseEventSplitToProgramStatistics
        tell casePlacedOnHold to entity CaseContext.Case
      }
      on caseResumed: event Case.CaseResumed is {
        send caseResumed to outlet CaseEventSplitToWorkloadAnalytics
        send caseResumed to outlet CaseEventSplitToProgramStatistics
        tell caseResumed to entity CaseContext.Case
      }
      on caseClosed: event Case.CaseClosed is {
        send caseClosed to outlet CaseEventSplitToWorkloadAnalytics
        send caseClosed to outlet CaseEventSplitToProgramStatistics
        tell caseClosed to entity CaseContext.Case
      }
      on caseReopened: event Case.CaseReopened is {
        send caseReopened to outlet CaseEventSplitToWorkloadAnalytics
        send caseReopened to outlet CaseEventSplitToProgramStatistics
        tell caseReopened to entity CaseContext.Case
      }
      on other is {
        error "Unexpected message for processor CaseEventSplit"
      }
    } with {
      briefly "Case event fan-out handler"
      described as {
        |Delivers each Case event to all of its consumers.
      }
    }
  } with {
    briefly "Case event fan-out"
    described as {
      |Fans Case events out to the repository and projectors.
    }
  }
  connector 'CaseEvent Stream' is from outlet CaseContext.Case.CaseEvents2 to inlet CaseContext.CaseEventSplit.CaseEventSplitIn with {
    briefly "Case events, fanned out to storage and read models"
  }
  connector 'WorkloadAnalytics Feed' is from outlet CaseContext.CaseEventSplit.CaseEventSplitToWorkloadAnalytics to inlet CaseContext.WorkloadAnalytics.WorkloadAnalyticsFromCase with {
    briefly "Case events feeding the WorkloadAnalytics projection"
  }
  connector 'ProgramStatistics Feed' is from outlet CaseContext.CaseEventSplit.CaseEventSplitToProgramStatistics to inlet CaseContext.ProgramStatistics.ProgramStatisticsFromCase with {
    briefly "Case events feeding the ProgramStatistics projection"
  }
  connector 'WorkloadAnalytics Storage' is from outlet CaseContext.WorkloadAnalytics.WorkloadAnalyticsToRepository to inlet CaseContext.CaseRepository.CaseRepositoryFromWorkloadAnalytics with {
    briefly "WorkloadAnalytics updates on their way to storage"
  }
} with {
  briefly "Case context"
  described as {
    | The Case context manages citizen services
    | and assistance cases.
  }
}
