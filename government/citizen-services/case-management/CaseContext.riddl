// Case Management - Case Context
context CaseContext is {
  include "types.riddl"
  include "Case.riddl"
  // Repository
  repository CaseRepository is {
    schema CaseData is relational
      of cases as type Case
      with {
      briefly "Case data schema"
      described as {
        |The relational schema persisting case records for this repository.
      }
    }
    inlet CaseRepositoryFromCase is type CaseEvent
    inlet CaseRepositoryFromWorkloadAnalytics is type CaseEvent
    inlet CaseRepositoryFromProgramStatistics is type CaseEvent
    outlet CaseRepositoryResponses is type Case.CaseQueryResult
    query FindCaseById is  {
      caseId: CaseId with {
        briefly "Case"
        described as {
          |Case identifier.
        }
      }
    } with {
      briefly "Find case by ID"
      described as {
        |Retrieves case by identifier.
      }
    }
    result CaseResult is  {
      caseObj: Case.ActiveStateData with {
        briefly "Case"
        described as {
          |Case data.
        }
      }
    } with {
      briefly "Case result"
      described as {
        |Returns case data.
      }
    }
    query SearchCases is  {
      filterCaseType: CaseType? with {
        briefly "Type"
        described as {
          |Filter by type.
        }
      }
      filterStatus: CaseStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
      filterWorkerId: WorkerId? with {
        briefly "Worker"
        described as {
          |Filter by worker.
        }
      }
      filterPriority: CasePriority? with {
        briefly "Priority"
        described as {
          |Filter by priority.
        }
      }
    } with {
      briefly "Search cases"
      described as {
        |Searches cases by criteria.
      }
    }
    result CasesResult is  {
      cases: Case.ActiveStateData+ with {
        briefly "Cases"
        described as {
          |Matching cases.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Cases result"
      described as {
        |Returns matching cases.
      }
    }
    query FindByCitizen is  {
      citizenId: CitizenId with {
        briefly "Citizen"
        described as {
          |Citizen identifier.
        }
      }
    } with {
      briefly "Find by citizen"
      described as {
        |Finds cases for a citizen.
      }
    }
    query FindBySSN is  {
      ssn: String(9,9) with {
        briefly "SSN"
        described as {
          |Social security number.
        }
      }
    } with {
      briefly "Find by SSN"
      described as {
        |Finds cases by SSN.
      }
    }
    query FindPendingTasks is  {
      workerId: WorkerId with {
        briefly "Worker"
        described as {
          |Worker identifier.
        }
      }
    } with {
      briefly "Find pending tasks"
      described as {
        |Finds worker's pending tasks.
      }
    }
    query FindPendingApprovals is  {
      supervisorId: WorkerId with {
        briefly "Supervisor"
        described as {
          |Supervisor identifier.
        }
      }
    } with {
      briefly "Find pending approvals"
      described as {
        |Finds cases awaiting approval.
      }
    }
    handler CaseRepositoryHandler is {
      on query FindCaseById is {
        yield result CaseResult
      }
      on query SearchCases is {
        yield result CaseResult
      }
      on query FindByCitizen is {
        yield result CaseResult
      }
      on query FindBySSN is {
        yield result CaseResult
      }
      on query FindPendingTasks is {
        yield result CaseResult
      }
      on query FindPendingApprovals is {
        yield result CaseResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes case queries.
      }
    }
  } with {
    briefly "Case repository"
    described as {
      |Persistence for case records.
    }
  }
  // Projector for workload analytics
  projector WorkloadAnalytics is {
    inlet WorkloadAnalyticsFromCase is type CaseEvent
    outlet WorkloadAnalyticsOut is type CaseEvent
    updates repository CaseContext.CaseRepository
    record AnalyticsData is  {
      totalOpenCases: Natural with {
        briefly "Open"
        described as {
          |Total open cases.
        }
      }
      casesByType: TypeCount+ with {
        briefly "By type"
        described as {
          |Cases by type.
        }
      }
      casesByStatus: StatusCount+ with {
        briefly "By status"
        described as {
          |Cases by status.
        }
      }
      casesByWorker: WorkerCaseload+ with {
        briefly "By worker"
        described as {
          |Cases per worker.
        }
      }
      averageProcessingDays: Decimal(6,2) with {
        briefly "Avg days"
        described as {
          |Average processing time.
        }
      }
      pendingApprovals: Natural with {
        briefly "Pending"
        described as {
          |Awaiting approval.
        }
      }
      overdueTasks: Natural with {
        briefly "Overdue"
        described as {
          |Overdue tasks.
        }
      }
    } with {
      briefly "Analytics data"
      described as {
        |Workload metrics.
      }
    }
    record TypeCount is  {
      caseType: CaseType with {
        briefly "Type"
        described as {
          |Case type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Case count.
        }
      }
    } with {
      briefly "Type count"
      described as {
        |Count by case type.
      }
    }
    record StatusCount is  {
      status: CaseStatus with {
        briefly "Status"
        described as {
          |Case status.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Case count.
        }
      }
    } with {
      briefly "Status count"
      described as {
        |Count by status.
      }
    }
    record WorkerCaseload is  {
      workerId: WorkerId with {
        briefly "Worker"
        described as {
          |Worker ID.
        }
      }
      openCases: Natural with {
        briefly "Open"
        described as {
          |Open cases.
        }
      }
      pendingTasks: Natural with {
        briefly "Tasks"
        described as {
          |Pending tasks.
        }
      }
    } with {
      briefly "Worker caseload"
      described as {
        |Worker's caseload.
      }
    }
    handler AnalyticsHandler is {
      on event Case.CaseOpened is {
        tell event Case.CaseOpened to repository CaseContext.CaseRepository
      }
      on event Case.WorkerAssigned is {
        tell event Case.WorkerAssigned to repository CaseContext.CaseRepository
      }
      on event Case.TaskCreated is {
        tell event Case.TaskCreated to repository CaseContext.CaseRepository
      }
      on event Case.TaskCompleted is {
        tell event Case.TaskCompleted to repository CaseContext.CaseRepository
      }
      on event Case.CaseClosed is {
        tell event Case.CaseClosed to repository CaseContext.CaseRepository
      }
    } with {
      briefly "Processes analytics events"
      described as {
        |Updates workload analytics.
      }
    }
  } with {
    briefly "Workload analytics"
    described as {
      |Projects workload metrics for management.
    }
  }
  // Projector for program statistics
  projector ProgramStatistics is {
    inlet ProgramStatisticsFromCase is type CaseEvent
    outlet ProgramStatisticsOut is type CaseEvent
    updates repository CaseContext.CaseRepository
    record StatisticsData is  {
      programStats: ProgramStat+ with {
        briefly "Stats"
        described as {
          |Per-program statistics.
        }
      }
      totalBenefitsPaid: Decimal(12,2) with {
        briefly "Benefits"
        described as {
          |Total benefits paid.
        }
      }
      approvalRate: Decimal(5,2) with {
        briefly "Approval"
        described as {
          |Approval rate percentage.
        }
      }
      averageBenefit: Decimal(10,2) with {
        briefly "Average"
        described as {
          |Average benefit amount.
        }
      }
      appealCount: Natural with {
        briefly "Appeals"
        described as {
          |Total appeals filed.
        }
      }
      appealSuccessRate: Decimal(5,2) with {
        briefly "Appeal success"
        described as {
          |Appeal success rate.
        }
      }
    } with {
      briefly "Statistics data"
      described as {
        |Program statistics.
      }
    }
    record ProgramStat is  {
      programId: ProgramId with {
        briefly "Program"
        described as {
          |Program ID.
        }
      }
      programName: String(1,200) with {
        briefly "Name"
        described as {
          |Program name.
        }
      }
      applicationsReceived: Natural with {
        briefly "Received"
        described as {
          |Applications received.
        }
      }
      approved: Natural with {
        briefly "Approved"
        described as {
          |Applications approved.
        }
      }
      denied: Natural with {
        briefly "Denied"
        described as {
          |Applications denied.
        }
      }
      totalPaid: Decimal(12,2) with {
        briefly "Paid"
        described as {
          |Total benefits paid.
        }
      }
    } with {
      briefly "Program stat"
      described as {
        |Statistics for program.
      }
    }
    handler StatisticsHandler is {
      on event Case.ServicesRequested is {
        tell event Case.ServicesRequested to repository CaseContext.CaseRepository
      }
      on event Case.ServicesApproved is {
        tell event Case.ServicesApproved to repository CaseContext.CaseRepository
      }
      on event Case.ServicesDenied is {
        tell event Case.ServicesDenied to repository CaseContext.CaseRepository
      }
      on event Case.AppealFiled is {
        tell event Case.AppealFiled to repository CaseContext.CaseRepository
      }
      on event Case.AppealResolved is {
        tell event Case.AppealResolved to repository CaseContext.CaseRepository
      }
    } with {
      briefly "Processes statistics events"
      described as {
        |Updates program statistics.
      }
    }
  } with {
    briefly "Program statistics"
    described as {
      |Projects program performance metrics.
    }
  }
  // ---- Event publication for Case ----
  type CaseEvent is one of {
    CaseContext.Case.CaseOpened,
    CaseContext.Case.WorkerAssigned,
    CaseContext.Case.CitizenInfoUpdated,
    CaseContext.Case.HouseholdMemberAdded,
    CaseContext.Case.HouseholdMemberRemoved,
    CaseContext.Case.IncomeRecorded,
    CaseContext.Case.DocumentUploaded,
    CaseContext.Case.ServicesRequested,
    CaseContext.Case.EligibilityDetermined,
    CaseContext.Case.NoteAdded,
    CaseContext.Case.TaskCreated,
    CaseContext.Case.TaskCompleted,
    CaseContext.Case.ServicesApproved,
    CaseContext.Case.ServicesDenied,
    CaseContext.Case.AppealFiled,
    CaseContext.Case.AppealResolved,
    CaseContext.Case.CasePlacedOnHold,
    CaseContext.Case.CaseResumed,
    CaseContext.Case.CaseClosed,
    CaseContext.Case.CaseReopened
  } with {
    briefly "Case event alternation"
    described as {
      |Union of all Case events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CaseEventSource as source is {
    outlet CaseEvents is type CaseEvent
    handler CaseSourceHandler is {
      on event Case.CaseOpened is {
        send event Case.CaseOpened to outlet CaseEvents
      }
      on event Case.WorkerAssigned is {
        send event Case.WorkerAssigned to outlet CaseEvents
      }
      on event Case.CitizenInfoUpdated is {
        send event Case.CitizenInfoUpdated to outlet CaseEvents
      }
      on event Case.HouseholdMemberAdded is {
        send event Case.HouseholdMemberAdded to outlet CaseEvents
      }
      on event Case.HouseholdMemberRemoved is {
        send event Case.HouseholdMemberRemoved to outlet CaseEvents
      }
      on event Case.IncomeRecorded is {
        send event Case.IncomeRecorded to outlet CaseEvents
      }
      on event Case.DocumentUploaded is {
        send event Case.DocumentUploaded to outlet CaseEvents
      }
      on event Case.ServicesRequested is {
        send event Case.ServicesRequested to outlet CaseEvents
      }
      on event Case.EligibilityDetermined is {
        send event Case.EligibilityDetermined to outlet CaseEvents
      }
      on event Case.NoteAdded is {
        send event Case.NoteAdded to outlet CaseEvents
      }
      on event Case.TaskCreated is {
        send event Case.TaskCreated to outlet CaseEvents
      }
      on event Case.TaskCompleted is {
        send event Case.TaskCompleted to outlet CaseEvents
      }
      on event Case.ServicesApproved is {
        send event Case.ServicesApproved to outlet CaseEvents
      }
      on event Case.ServicesDenied is {
        send event Case.ServicesDenied to outlet CaseEvents
      }
      on event Case.AppealFiled is {
        send event Case.AppealFiled to outlet CaseEvents
      }
      on event Case.AppealResolved is {
        send event Case.AppealResolved to outlet CaseEvents
      }
      on event Case.CasePlacedOnHold is {
        send event Case.CasePlacedOnHold to outlet CaseEvents
      }
      on event Case.CaseResumed is {
        send event Case.CaseResumed to outlet CaseEvents
      }
      on event Case.CaseClosed is {
        send event Case.CaseClosed to outlet CaseEvents
      }
      on event Case.CaseReopened is {
        send event Case.CaseReopened to outlet CaseEvents
      }
      on other is {
        error "Unexpected message for source CaseEventSource"
      }
    } with {
      briefly "Case source handler"
      described as {
        |Publishes Case events onto the outlet.
      }
    }
  } with {
    briefly "Case event source"
    described as {
      |Publishes Case entity events into the streaming topology.
    }
  }
  processor CaseEventSink as sink is {
    inlet CaseInlet is type CaseEvent
    handler CaseSinkHandler is {
      on event Case.CaseOpened is {
        tell event Case.CaseOpened to repository CaseContext.CaseRepository
      }
      on event Case.WorkerAssigned is {
        tell event Case.WorkerAssigned to repository CaseContext.CaseRepository
      }
      on event Case.CitizenInfoUpdated is {
        tell event Case.CitizenInfoUpdated to repository CaseContext.CaseRepository
      }
      on event Case.HouseholdMemberAdded is {
        tell event Case.HouseholdMemberAdded to repository CaseContext.CaseRepository
      }
      on event Case.HouseholdMemberRemoved is {
        tell event Case.HouseholdMemberRemoved to repository CaseContext.CaseRepository
      }
      on event Case.IncomeRecorded is {
        tell event Case.IncomeRecorded to repository CaseContext.CaseRepository
      }
      on event Case.DocumentUploaded is {
        tell event Case.DocumentUploaded to repository CaseContext.CaseRepository
      }
      on event Case.ServicesRequested is {
        tell event Case.ServicesRequested to repository CaseContext.CaseRepository
      }
      on event Case.EligibilityDetermined is {
        tell event Case.EligibilityDetermined to repository CaseContext.CaseRepository
      }
      on event Case.NoteAdded is {
        tell event Case.NoteAdded to repository CaseContext.CaseRepository
      }
      on event Case.TaskCreated is {
        tell event Case.TaskCreated to repository CaseContext.CaseRepository
      }
      on event Case.TaskCompleted is {
        tell event Case.TaskCompleted to repository CaseContext.CaseRepository
      }
      on event Case.ServicesApproved is {
        tell event Case.ServicesApproved to repository CaseContext.CaseRepository
      }
      on event Case.ServicesDenied is {
        tell event Case.ServicesDenied to repository CaseContext.CaseRepository
      }
      on event Case.AppealFiled is {
        tell event Case.AppealFiled to repository CaseContext.CaseRepository
      }
      on event Case.AppealResolved is {
        tell event Case.AppealResolved to repository CaseContext.CaseRepository
      }
      on event Case.CasePlacedOnHold is {
        tell event Case.CasePlacedOnHold to repository CaseContext.CaseRepository
      }
      on event Case.CaseResumed is {
        tell event Case.CaseResumed to repository CaseContext.CaseRepository
      }
      on event Case.CaseClosed is {
        tell event Case.CaseClosed to repository CaseContext.CaseRepository
      }
      on event Case.CaseReopened is {
        tell event Case.CaseReopened to repository CaseContext.CaseRepository
      }
      on other is {
        error "Unexpected message for sink CaseEventSink"
      }
    } with {
      briefly "Case sink handler"
      described as {
        |Persists Case events via the repository.
      }
    }
  } with {
    briefly "Case event sink"
    described as {
      |Receives Case events for persistence.
    }
  }
  connector CaseEventFlow is {
    from outlet CaseContext.CaseEventSource.CaseEvents to
      inlet CaseContext.CaseEventSink.CaseInlet
  } with {
    briefly "Case event flow"
    described as {
      |Connects the Case source to its sink.
    }
  }
  processor CaseEventSplit is {
    inlet CaseEventSplitIn is type CaseEvent
    outlet CaseEventSplitToCaseRepository is type CaseEvent
    outlet CaseEventSplitToWorkloadAnalytics is type CaseEvent
    outlet CaseEventSplitToProgramStatistics is type CaseEvent
    handler CaseEventSplitHandler is {
      on event Case.CaseOpened is {
        send event Case.CaseOpened to outlet CaseEventSplitToCaseRepository
        send event Case.CaseOpened to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.CaseOpened to outlet CaseEventSplitToProgramStatistics
        tell event Case.CaseOpened to entity CaseContext.Case
      }
      on event Case.WorkerAssigned is {
        send event Case.WorkerAssigned to outlet CaseEventSplitToCaseRepository
        send event Case.WorkerAssigned to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.WorkerAssigned to outlet CaseEventSplitToProgramStatistics
        tell event Case.WorkerAssigned to entity CaseContext.Case
      }
      on event Case.CitizenInfoUpdated is {
        send event Case.CitizenInfoUpdated to outlet CaseEventSplitToCaseRepository
        send event Case.CitizenInfoUpdated to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.CitizenInfoUpdated to outlet CaseEventSplitToProgramStatistics
        tell event Case.CitizenInfoUpdated to entity CaseContext.Case
      }
      on event Case.HouseholdMemberAdded is {
        send event Case.HouseholdMemberAdded to outlet CaseEventSplitToCaseRepository
        send event Case.HouseholdMemberAdded to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.HouseholdMemberAdded to outlet CaseEventSplitToProgramStatistics
        tell event Case.HouseholdMemberAdded to entity CaseContext.Case
      }
      on event Case.HouseholdMemberRemoved is {
        send event Case.HouseholdMemberRemoved to outlet CaseEventSplitToCaseRepository
        send event Case.HouseholdMemberRemoved to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.HouseholdMemberRemoved to outlet CaseEventSplitToProgramStatistics
        tell event Case.HouseholdMemberRemoved to entity CaseContext.Case
      }
      on event Case.IncomeRecorded is {
        send event Case.IncomeRecorded to outlet CaseEventSplitToCaseRepository
        send event Case.IncomeRecorded to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.IncomeRecorded to outlet CaseEventSplitToProgramStatistics
        tell event Case.IncomeRecorded to entity CaseContext.Case
      }
      on event Case.DocumentUploaded is {
        send event Case.DocumentUploaded to outlet CaseEventSplitToCaseRepository
        send event Case.DocumentUploaded to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.DocumentUploaded to outlet CaseEventSplitToProgramStatistics
        tell event Case.DocumentUploaded to entity CaseContext.Case
      }
      on event Case.ServicesRequested is {
        send event Case.ServicesRequested to outlet CaseEventSplitToCaseRepository
        send event Case.ServicesRequested to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.ServicesRequested to outlet CaseEventSplitToProgramStatistics
        tell event Case.ServicesRequested to entity CaseContext.Case
      }
      on event Case.EligibilityDetermined is {
        send event Case.EligibilityDetermined to outlet CaseEventSplitToCaseRepository
        send event Case.EligibilityDetermined to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.EligibilityDetermined to outlet CaseEventSplitToProgramStatistics
        tell event Case.EligibilityDetermined to entity CaseContext.Case
      }
      on event Case.NoteAdded is {
        send event Case.NoteAdded to outlet CaseEventSplitToCaseRepository
        send event Case.NoteAdded to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.NoteAdded to outlet CaseEventSplitToProgramStatistics
        tell event Case.NoteAdded to entity CaseContext.Case
      }
      on event Case.TaskCreated is {
        send event Case.TaskCreated to outlet CaseEventSplitToCaseRepository
        send event Case.TaskCreated to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.TaskCreated to outlet CaseEventSplitToProgramStatistics
        tell event Case.TaskCreated to entity CaseContext.Case
      }
      on event Case.TaskCompleted is {
        send event Case.TaskCompleted to outlet CaseEventSplitToCaseRepository
        send event Case.TaskCompleted to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.TaskCompleted to outlet CaseEventSplitToProgramStatistics
        tell event Case.TaskCompleted to entity CaseContext.Case
      }
      on event Case.ServicesApproved is {
        send event Case.ServicesApproved to outlet CaseEventSplitToCaseRepository
        send event Case.ServicesApproved to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.ServicesApproved to outlet CaseEventSplitToProgramStatistics
        tell event Case.ServicesApproved to entity CaseContext.Case
      }
      on event Case.ServicesDenied is {
        send event Case.ServicesDenied to outlet CaseEventSplitToCaseRepository
        send event Case.ServicesDenied to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.ServicesDenied to outlet CaseEventSplitToProgramStatistics
        tell event Case.ServicesDenied to entity CaseContext.Case
      }
      on event Case.AppealFiled is {
        send event Case.AppealFiled to outlet CaseEventSplitToCaseRepository
        send event Case.AppealFiled to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.AppealFiled to outlet CaseEventSplitToProgramStatistics
        tell event Case.AppealFiled to entity CaseContext.Case
      }
      on event Case.AppealResolved is {
        send event Case.AppealResolved to outlet CaseEventSplitToCaseRepository
        send event Case.AppealResolved to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.AppealResolved to outlet CaseEventSplitToProgramStatistics
        tell event Case.AppealResolved to entity CaseContext.Case
      }
      on event Case.CasePlacedOnHold is {
        send event Case.CasePlacedOnHold to outlet CaseEventSplitToCaseRepository
        send event Case.CasePlacedOnHold to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.CasePlacedOnHold to outlet CaseEventSplitToProgramStatistics
        tell event Case.CasePlacedOnHold to entity CaseContext.Case
      }
      on event Case.CaseResumed is {
        send event Case.CaseResumed to outlet CaseEventSplitToCaseRepository
        send event Case.CaseResumed to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.CaseResumed to outlet CaseEventSplitToProgramStatistics
        tell event Case.CaseResumed to entity CaseContext.Case
      }
      on event Case.CaseClosed is {
        send event Case.CaseClosed to outlet CaseEventSplitToCaseRepository
        send event Case.CaseClosed to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.CaseClosed to outlet CaseEventSplitToProgramStatistics
        tell event Case.CaseClosed to entity CaseContext.Case
      }
      on event Case.CaseReopened is {
        send event Case.CaseReopened to outlet CaseEventSplitToCaseRepository
        send event Case.CaseReopened to outlet CaseEventSplitToWorkloadAnalytics
        send event Case.CaseReopened to outlet CaseEventSplitToProgramStatistics
        tell event Case.CaseReopened to entity CaseContext.Case
      }
      on other is {
        error "Unexpected message for processor CaseEventSplit"
      }
    } with {
      briefly "Case event fan-out handler"
      described as {
        |Delivers each Case event to all of its consumers.
      }
    }
  } with {
    briefly "Case event fan-out"
    described as {
      |Fans Case events out to the repository and projectors.
    }
  }
  connector LinkCaseToCaseEventSplit is {
    from outlet CaseContext.Case.CaseEvents2 to
      inlet CaseContext.CaseEventSplit.CaseEventSplitIn
  } with {
    briefly "LinkCaseToCaseEventSplit"
  }
  connector LinkCaseEventSplitToCaseRepository is {
    from outlet CaseContext.CaseEventSplit.CaseEventSplitToCaseRepository to
      inlet CaseContext.CaseRepository.CaseRepositoryFromCase
  } with {
    briefly "LinkCaseEventSplitToCaseRepository"
  }
  connector LinkCaseEventSplitToWorkloadAnalytics is {
    from outlet CaseContext.CaseEventSplit.CaseEventSplitToWorkloadAnalytics to
      inlet CaseContext.WorkloadAnalytics.WorkloadAnalyticsFromCase
  } with {
    briefly "LinkCaseEventSplitToWorkloadAnalytics"
  }
  connector LinkCaseEventSplitToProgramStatistics is {
    from outlet CaseContext.CaseEventSplit.CaseEventSplitToProgramStatistics to
      inlet CaseContext.ProgramStatistics.ProgramStatisticsFromCase
  } with {
    briefly "LinkCaseEventSplitToProgramStatistics"
  }
  connector LinkWorkloadAnalyticsToCaseRepository is {
    from outlet CaseContext.WorkloadAnalytics.WorkloadAnalyticsOut to
      inlet CaseContext.CaseRepository.CaseRepositoryFromWorkloadAnalytics
  } with {
    briefly "LinkWorkloadAnalyticsToCaseRepository"
  }
  connector LinkProgramStatisticsToCaseRepository is {
    from outlet CaseContext.ProgramStatistics.ProgramStatisticsOut to
      inlet CaseContext.CaseRepository.CaseRepositoryFromProgramStatistics
  } with {
    briefly "LinkProgramStatisticsToCaseRepository"
  }
} with {
  briefly "Case context"
  described as {
    | The Case context manages citizen services
    | and assistance cases.
  }
}
