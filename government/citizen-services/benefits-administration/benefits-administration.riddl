// Benefits Administration Domain Model
// Government benefits program management
domain BenefitsAdministration is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Beneficiary is "person receiving benefits" with {
    briefly "Beneficiary"
    described as {
      |Individual receiving assistance.
    }
  }
  user BenefitsAgent is "person processing benefits" with {
    briefly "Benefits Agent"
    described as {
      |Staff handling benefit applications.
    }
  }
  user Auditor is "person auditing benefit programs" with {
    briefly "Auditor"
    described as {
      |Program compliance auditor.
    }
  }
  epic BenefitsEpic is {
    user Beneficiary wants to "to receive government benefits" so that "their basic needs are met"
    case ApplyForBenefits is {
      user Beneficiary wants to "to apply for assistance programs" so that "they can receive support"
      step is "Beneficiary completes" "application form" "online or in person" with {
        briefly "Apply"
        described as {
          |Submit application.
        }
      }
      step send command BenefitContext.Benefit.SubmitApplication from user BenefitsAgent to entity BenefitContext.Benefit with {
        briefly "Process"
        described as {
          |Process application.
        }
      }
      step is "Agent determines" "eligibility and" "issues benefits" with {
        briefly "Issue"
        described as {
          |Issue benefits.
        }
      }
    } with {
      briefly "Apply for benefits"
      described as {
        |Benefits application workflow.
      }
    }
  } with {
    briefly "Benefits administration"
    described as {
      | Epic covering benefit applications,
      | eligibility, and payment issuance.
    }
  }
  include "BenefitContext.riddl"
  include "external-contexts.riddl"
  application context BenefitsAdministrationApp is {
    outlet AppBenefitCommands is type BenefitContext.Benefit.BenefitCommand
    inlet AppBenefitRepositoryResponses is type BenefitContext.Benefit.BenefitQueryResult
    handler BenefitsAdministrationAppHandler is {
      on other is {
        error "Unexpected message for application context BenefitsAdministrationApp"
      }
    } with {
      briefly "BenefitsAdministrationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "BenefitsAdministrationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppBenefitCommands is {
    from outlet BenefitsAdministrationApp.AppBenefitCommands to
      inlet BenefitContext.Benefit.BenefitCommands
  } with {
    option is persistent
    briefly "LinkAppBenefitCommands"
  }
  connector LinkAppBenefitRepositoryResponses is {
    from outlet BenefitContext.BenefitRepository.BenefitRepositoryResponses to
      inlet BenefitsAdministrationApp.AppBenefitRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppBenefitRepositoryResponses"
  }
} with {
  briefly "Benefits administration domain"
  described as {
    | The Benefits Administration domain handles
    | government assistance programs.
  }
}
