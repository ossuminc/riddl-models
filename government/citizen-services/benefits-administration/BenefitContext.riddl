// Benefits Administration - Benefit Context
context BenefitContext is {
  include "types.riddl"
  include "Benefit.riddl"
  // Repository
  repository BenefitRepository is {
    query FindBenefitById is  {
      benefitId: BenefitId with {
        briefly "Benefit"
        described as {
          |Benefit identifier.
        }
      }
    } with {
      briefly "Find benefit by ID"
      described as {
        |Retrieves benefit by identifier.
      }
    }
    result BenefitResult is  {
      benefit: Benefit.ActiveStateData with {
        briefly "Benefit"
        described as {
          |Benefit data.
        }
      }
    } with {
      briefly "Benefit result"
      described as {
        |Returns benefit data.
      }
    }
    query SearchBenefits is  {
      filterProgramType: ProgramType? with {
        briefly "Program"
        described as {
          |Filter by program.
        }
      }
      filterStatus: BenefitStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
    } with {
      briefly "Search benefits"
      described as {
        |Searches benefits by criteria.
      }
    }
    result BenefitsResult is  {
      benefits: Benefit.ActiveStateData+ with {
        briefly "Benefits"
        described as {
          |Matching benefits.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Benefits result"
      described as {
        |Returns matching benefits.
      }
    }
    query FindByBeneficiary is  {
      beneficiaryId: BeneficiaryId with {
        briefly "Beneficiary"
        described as {
          |Beneficiary identifier.
        }
      }
    } with {
      briefly "Find by beneficiary"
      described as {
        |Finds benefits for beneficiary.
      }
    }
    query FindBySSN is  {
      ssn: String(9,9) with {
        briefly "SSN"
        described as {
          |Social security number.
        }
      }
    } with {
      briefly "Find by SSN"
      described as {
        |Finds benefits by SSN.
      }
    }
    query FindPendingRecertification is  {
      daysUntilDue: Natural with {
        briefly "Days"
        described as {
          |Days until due.
        }
      }
    } with {
      briefly "Find pending recertification"
      described as {
        |Finds benefits needing recert.
      }
    }
    handler BenefitRepositoryHandler is {
      on query FindBenefitById is {
        reply result BenefitResult
      }
      on query SearchBenefits is {
        reply result BenefitResult
      }
      on query FindByBeneficiary is {
        reply result BenefitResult
      }
      on query FindBySSN is {
        reply result BenefitResult
      }
      on query FindPendingRecertification is {
        reply result BenefitResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes benefit queries.
      }
    }
  } with {
    briefly "Benefit repository"
    described as {
      |Persistence for benefit records.
    }
  }
  // Projector for program analytics
  projector ProgramAnalytics is {
    updates repository BenefitContext.BenefitRepository
    record AnalyticsData is  {
      programStats: ProgramStat+ with {
        briefly "Stats"
        described as {
          |Per-program statistics.
        }
      }
      totalBeneficiaries: Natural with {
        briefly "Beneficiaries"
        described as {
          |Total beneficiaries.
        }
      }
      totalMonthlyPayments: Decimal(14,2) with {
        briefly "Monthly"
        described as {
          |Total monthly payments.
        }
      }
      approvalRate: Decimal(5,2) with {
        briefly "Approval"
        described as {
          |Approval rate.
        }
      }
      pendingApplications: Natural with {
        briefly "Pending"
        described as {
          |Pending applications.
        }
      }
      overdueRecertifications: Natural with {
        briefly "Overdue"
        described as {
          |Overdue recertifications.
        }
      }
    } with {
      briefly "Analytics data"
      described as {
        |Program analytics.
      }
    }
    record ProgramStat is  {
      programType: ProgramType with {
        briefly "Program"
        described as {
          |Program type.
        }
      }
      activeBenefits: Natural with {
        briefly "Active"
        described as {
          |Active benefits.
        }
      }
      monthlyPayments: Decimal(12,2) with {
        briefly "Monthly"
        described as {
          |Monthly payments.
        }
      }
      averageBenefit: Decimal(10,2) with {
        briefly "Average"
        described as {
          |Average benefit.
        }
      }
    } with {
      briefly "Program stat"
      described as {
        |Statistics for program.
      }
    }
    handler AnalyticsHandler is {
      on event Benefit.ApplicationSubmitted is {
        tell event Benefit.ApplicationSubmitted to repository BenefitContext.BenefitRepository
      }
      on event Benefit.BenefitApproved is {
        tell event Benefit.BenefitApproved to repository BenefitContext.BenefitRepository
      }
      on event Benefit.BenefitDenied is {
        tell event Benefit.BenefitDenied to repository BenefitContext.BenefitRepository
      }
      on event Benefit.PaymentIssued is {
        tell event Benefit.PaymentIssued to repository BenefitContext.BenefitRepository
      }
      on event Benefit.BenefitTerminated is {
        tell event Benefit.BenefitTerminated to repository BenefitContext.BenefitRepository
      }
    } with {
      briefly "Processes analytics events"
      described as {
        |Updates program analytics.
      }
    }
  } with {
    briefly "Program analytics"
    described as {
      |Projects program metrics for reporting.
    }
  }
  // ---- Event publication for Benefit ----
  type BenefitEvent is one of {
    BenefitContext.Benefit.ApplicationSubmitted,
    BenefitContext.Benefit.DocumentUploaded,
    BenefitContext.Benefit.DocumentVerified,
    BenefitContext.Benefit.EligibilityDetermined,
    BenefitContext.Benefit.BenefitApproved,
    BenefitContext.Benefit.BenefitDenied,
    BenefitContext.Benefit.PaymentIssued,
    BenefitContext.Benefit.BenefitSuspended,
    BenefitContext.Benefit.BenefitReinstated,
    BenefitContext.Benefit.AppealFiled,
    BenefitContext.Benefit.AppealResolved,
    BenefitContext.Benefit.RecertificationInitiated,
    BenefitContext.Benefit.RecertificationCompleted,
    BenefitContext.Benefit.HouseholdUpdated,
    BenefitContext.Benefit.BenefitTerminated
  } with {
    briefly "Benefit event alternation"
    described as {
      |Union of all Benefit events, for streaming and event-sourced
      |persistence.
    }
  }
  source BenefitEventSource is {
    outlet BenefitEvents is type BenefitEvent
    handler BenefitSourceHandler is {
      on event Benefit.ApplicationSubmitted is {
        send event Benefit.ApplicationSubmitted to outlet BenefitEvents
      }
      on event Benefit.DocumentUploaded is {
        send event Benefit.DocumentUploaded to outlet BenefitEvents
      }
      on event Benefit.DocumentVerified is {
        send event Benefit.DocumentVerified to outlet BenefitEvents
      }
      on event Benefit.EligibilityDetermined is {
        send event Benefit.EligibilityDetermined to outlet BenefitEvents
      }
      on event Benefit.BenefitApproved is {
        send event Benefit.BenefitApproved to outlet BenefitEvents
      }
      on event Benefit.BenefitDenied is {
        send event Benefit.BenefitDenied to outlet BenefitEvents
      }
      on event Benefit.PaymentIssued is {
        send event Benefit.PaymentIssued to outlet BenefitEvents
      }
      on event Benefit.BenefitSuspended is {
        send event Benefit.BenefitSuspended to outlet BenefitEvents
      }
      on event Benefit.BenefitReinstated is {
        send event Benefit.BenefitReinstated to outlet BenefitEvents
      }
      on event Benefit.AppealFiled is {
        send event Benefit.AppealFiled to outlet BenefitEvents
      }
      on event Benefit.AppealResolved is {
        send event Benefit.AppealResolved to outlet BenefitEvents
      }
      on event Benefit.RecertificationInitiated is {
        send event Benefit.RecertificationInitiated to outlet BenefitEvents
      }
      on event Benefit.RecertificationCompleted is {
        send event Benefit.RecertificationCompleted to outlet BenefitEvents
      }
      on event Benefit.HouseholdUpdated is {
        send event Benefit.HouseholdUpdated to outlet BenefitEvents
      }
      on event Benefit.BenefitTerminated is {
        send event Benefit.BenefitTerminated to outlet BenefitEvents
      }
      on other is {
        error "Unexpected message for source BenefitEventSource"
      }
    } with {
      briefly "Benefit source handler"
      described as {
        |Publishes Benefit events onto the outlet.
      }
    }
  } with {
    briefly "Benefit event source"
    described as {
      |Publishes Benefit entity events into the streaming topology.
    }
  }
  sink BenefitEventSink is {
    inlet BenefitInlet is type BenefitEvent
    handler BenefitSinkHandler is {
      on event Benefit.ApplicationSubmitted is {
        tell event Benefit.ApplicationSubmitted to repository BenefitContext.BenefitRepository
      }
      on event Benefit.DocumentUploaded is {
        tell event Benefit.DocumentUploaded to repository BenefitContext.BenefitRepository
      }
      on event Benefit.DocumentVerified is {
        tell event Benefit.DocumentVerified to repository BenefitContext.BenefitRepository
      }
      on event Benefit.EligibilityDetermined is {
        tell event Benefit.EligibilityDetermined to repository BenefitContext.BenefitRepository
      }
      on event Benefit.BenefitApproved is {
        tell event Benefit.BenefitApproved to repository BenefitContext.BenefitRepository
      }
      on event Benefit.BenefitDenied is {
        tell event Benefit.BenefitDenied to repository BenefitContext.BenefitRepository
      }
      on event Benefit.PaymentIssued is {
        tell event Benefit.PaymentIssued to repository BenefitContext.BenefitRepository
      }
      on event Benefit.BenefitSuspended is {
        tell event Benefit.BenefitSuspended to repository BenefitContext.BenefitRepository
      }
      on event Benefit.BenefitReinstated is {
        tell event Benefit.BenefitReinstated to repository BenefitContext.BenefitRepository
      }
      on event Benefit.AppealFiled is {
        tell event Benefit.AppealFiled to repository BenefitContext.BenefitRepository
      }
      on event Benefit.AppealResolved is {
        tell event Benefit.AppealResolved to repository BenefitContext.BenefitRepository
      }
      on event Benefit.RecertificationInitiated is {
        tell event Benefit.RecertificationInitiated to repository BenefitContext.BenefitRepository
      }
      on event Benefit.RecertificationCompleted is {
        tell event Benefit.RecertificationCompleted to repository BenefitContext.BenefitRepository
      }
      on event Benefit.HouseholdUpdated is {
        tell event Benefit.HouseholdUpdated to repository BenefitContext.BenefitRepository
      }
      on event Benefit.BenefitTerminated is {
        tell event Benefit.BenefitTerminated to repository BenefitContext.BenefitRepository
      }
      on other is {
        error "Unexpected message for sink BenefitEventSink"
      }
    } with {
      briefly "Benefit sink handler"
      described as {
        |Persists Benefit events via the repository.
      }
    }
  } with {
    briefly "Benefit event sink"
    described as {
      |Receives Benefit events for persistence.
    }
  }
  connector BenefitEventFlow is {
    from outlet BenefitContext.BenefitEventSource.BenefitEvents to
      inlet BenefitContext.BenefitEventSink.BenefitInlet
  } with {
    briefly "Benefit event flow"
    described as {
      |Connects the Benefit source to its sink.
    }
  }
} with {
  briefly "Benefit context"
  described as {
    | The Benefit context manages government
    | assistance programs.
  }
}
