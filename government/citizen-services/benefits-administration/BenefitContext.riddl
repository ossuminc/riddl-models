// Benefits Administration - Benefit Context
context BenefitContext as router is {
  inlet BenefitCommandStreamIn is type BenefitCommand  outlet BenefitCommandStreamOut is type BenefitCommand
  inlet BenefitQueryResultStreamIn is result Benefit.BenefitQueryResult  outlet BenefitQueryResultStreamOut is result Benefit.BenefitQueryResult
  handler BenefitContextBoundary is {
    on submitApplication: command Benefit.SubmitApplication is {
      send submitApplication to outlet BenefitContext.BenefitCommandStreamOut
    }
    on uploadDocument: command Benefit.UploadDocument is {
      send uploadDocument to outlet BenefitContext.BenefitCommandStreamOut
    }
    on verifyDocument: command Benefit.VerifyDocument is {
      send verifyDocument to outlet BenefitContext.BenefitCommandStreamOut
    }
    on determineEligibility: command Benefit.DetermineEligibility is {
      send determineEligibility to outlet BenefitContext.BenefitCommandStreamOut
    }
    on approveBenefit: command Benefit.ApproveBenefit is {
      send approveBenefit to outlet BenefitContext.BenefitCommandStreamOut
    }
    on denyBenefit: command Benefit.DenyBenefit is {
      send denyBenefit to outlet BenefitContext.BenefitCommandStreamOut
    }
    on issuePay: command Benefit.IssuePay is {
      send issuePay to outlet BenefitContext.BenefitCommandStreamOut
    }
    on suspendBenefit: command Benefit.SuspendBenefit is {
      send suspendBenefit to outlet BenefitContext.BenefitCommandStreamOut
    }
    on reinstatedBenefit: command Benefit.ReinstatedBenefit is {
      send reinstatedBenefit to outlet BenefitContext.BenefitCommandStreamOut
    }
    on fileAppeal: command Benefit.FileAppeal is {
      send fileAppeal to outlet BenefitContext.BenefitCommandStreamOut
    }
    on resolveAppeal: command Benefit.ResolveAppeal is {
      send resolveAppeal to outlet BenefitContext.BenefitCommandStreamOut
    }
    on initiateRecertification: command Benefit.InitiateRecertification is {
      send initiateRecertification to outlet BenefitContext.BenefitCommandStreamOut
    }
    on completeRecertification: command Benefit.CompleteRecertification is {
      send completeRecertification to outlet BenefitContext.BenefitCommandStreamOut
    }
    on updateHousehold: command Benefit.UpdateHousehold is {
      send updateHousehold to outlet BenefitContext.BenefitCommandStreamOut
    }
    on terminateBenefit: command Benefit.TerminateBenefit is {
      send terminateBenefit to outlet BenefitContext.BenefitCommandStreamOut
    }
    on benefitQueryResult: result Benefit.BenefitQueryResult is {
      send benefitQueryResult to outlet BenefitContext.BenefitQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the BenefitContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'BenefitCommand Stream Intake' is from outlet BenefitContext.BenefitCommandStreamOut to inlet BenefitContext.Benefit.BenefitCommands  connector 'BenefitQueryResult Stream Egress' is from outlet BenefitContext.BenefitRepository.BenefitRepositoryResponses to inlet BenefitContext.BenefitQueryResultStreamIn  adaptor FromEBTCardService from context EBTCardService is { 
    handler FromEBTCardServiceHandler is {
      on result EBTCardService.CardBalanceResult is {
        do "the model receives card balance result"
      }
      on event EBTCardService.CardIssued is {
        do "the model receives card issued"
      }
      on event EBTCardService.CardReplaced is {
        do "the model receives card replaced"
      }
      on other is {
        error "Unexpected message for adaptor FromEBTCardService"
      }
    } with {
      briefly "from ebt card service"
      described as {
        |Carries messages from the external EBTCardService.
      }
    }
  } with {
    briefly "EBTCardService integration"
    described as {
      |The model's side of the EBTCardService conversation.
    }
  }
  adaptor ToEBTCardService to context EBTCardService is { 
    handler ToEBTCardServiceHandler is {
      on query EBTCardService.GetCardBalance is {
        do "the model sends get card balance"
      }
      on command EBTCardService.IssueCard is {
        do "the model sends issue card"
      }
      on command EBTCardService.ReplaceCard is {
        do "the model sends replace card"
      }
      on other is {
        error "Unexpected message for adaptor ToEBTCardService"
      }
    } with {
      briefly "to ebt card service"
      described as {
        |Carries messages to the external EBTCardService.
      }
    }
  } with {
    briefly "EBTCardService integration"
    described as {
      |The model's side of the EBTCardService conversation.
    }
  }
  adaptor FromFraudDetectionService from context FraudDetectionService is { 
    handler FromFraudDetectionServiceHandler is {
      on event FraudDetectionService.FraudAlert is {
        do "the model receives fraud alert"
      }
      on event FraudDetectionService.FraudCheckCompleted is {
        do "the model receives fraud check completed"
      }
      on other is {
        error "Unexpected message for adaptor FromFraudDetectionService"
      }
    } with {
      briefly "from fraud detection service"
      described as {
        |Carries messages from the external FraudDetectionService.
      }
    }
  } with {
    briefly "FraudDetectionService integration"
    described as {
      |The model's side of the FraudDetectionService conversation.
    }
  }
  adaptor ToFraudDetectionService to context FraudDetectionService is { 
    handler ToFraudDetectionServiceHandler is {
      on command FraudDetectionService.CheckForFraud is {
        do "the model sends check for fraud"
      }
      on other is {
        error "Unexpected message for adaptor ToFraudDetectionService"
      }
    } with {
      briefly "to fraud detection service"
      described as {
        |Carries messages to the external FraudDetectionService.
      }
    }
  } with {
    briefly "FraudDetectionService integration"
    described as {
      |The model's side of the FraudDetectionService conversation.
    }
  }
  adaptor FromIdentityVerificationService from context IdentityVerificationService is { 
    handler FromIdentityVerificationServiceHandler is {
      on event IdentityVerificationService.IdentityVerified is {
        do "the model receives identity verified"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityVerificationService"
      }
    } with {
      briefly "from identity verification service"
      described as {
        |Carries messages from the external IdentityVerificationService.
      }
    }
  } with {
    briefly "IdentityVerificationService integration"
    described as {
      |The model's side of the IdentityVerificationService conversation.
    }
  }
  adaptor ToIdentityVerificationService to context IdentityVerificationService is { 
    handler ToIdentityVerificationServiceHandler is {
      on command IdentityVerificationService.VerifyIdentity is {
        do "the model sends verify identity"
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityVerificationService"
      }
    } with {
      briefly "to identity verification service"
      described as {
        |Carries messages to the external IdentityVerificationService.
      }
    }
  } with {
    briefly "IdentityVerificationService integration"
    described as {
      |The model's side of the IdentityVerificationService conversation.
    }
  }
  adaptor FromIncomeVerificationService from context IncomeVerificationService is { 
    handler FromIncomeVerificationServiceHandler is {
      on result IncomeVerificationService.WageDataResult is {
        do "the model receives wage data result"
      }
      on other is {
        error "Unexpected message for adaptor FromIncomeVerificationService"
      }
    } with {
      briefly "from income verification service"
      described as {
        |Carries messages from the external IncomeVerificationService.
      }
    }
  } with {
    briefly "IncomeVerificationService integration"
    described as {
      |The model's side of the IncomeVerificationService conversation.
    }
  }
  adaptor ToIncomeVerificationService to context IncomeVerificationService is { 
    handler ToIncomeVerificationServiceHandler is {
      on query IncomeVerificationService.GetWageData is {
        do "the model sends get wage data"
      }
      on other is {
        error "Unexpected message for adaptor ToIncomeVerificationService"
      }
    } with {
      briefly "to income verification service"
      described as {
        |Carries messages to the external IncomeVerificationService.
      }
    }
  } with {
    briefly "IncomeVerificationService integration"
    described as {
      |The model's side of the IncomeVerificationService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendNotification is {
        do "the model sends send notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.PaymentFailed is {
        do "the model receives payment failed"
      }
      on event PaymentProcessingService.PaymentProcessed is {
        do "the model receives payment processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.ProcessPayment is {
        do "the model sends process payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  include "types.riddl"
  include "Benefit.riddl"
  // Repository
  type BenefitRepositoryCommand is one of {
    BenefitContext.BenefitRepository.PersistAppealFiled or BenefitContext.BenefitRepository.PersistAppealResolved or BenefitContext.BenefitRepository.PersistApplicationSubmitted or BenefitContext.BenefitRepository.PersistBenefitApproved or BenefitContext.BenefitRepository.PersistBenefitDenied or BenefitContext.BenefitRepository.PersistBenefitReinstated or BenefitContext.BenefitRepository.PersistBenefitSuspended or BenefitContext.BenefitRepository.PersistBenefitTerminated or BenefitContext.BenefitRepository.PersistDocumentUploaded or BenefitContext.BenefitRepository.PersistDocumentVerified or BenefitContext.BenefitRepository.PersistEligibilityDetermined or BenefitContext.BenefitRepository.PersistHouseholdUpdated or BenefitContext.BenefitRepository.PersistPaymentIssued or BenefitContext.BenefitRepository.PersistRecertificationCompleted or BenefitContext.BenefitRepository.PersistRecertificationInitiated
  } with {
    briefly "Anything that writes BenefitRepository"
    described as {
      |The persistence commands BenefitRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository BenefitRepository as flow is {
    inlet BenefitRepositoryFromProgramAnalytics is type BenefitRepositoryCommand
    command PersistAppealFiled is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row AppealFiled applies to.
        }
      }
    } with {
      briefly "Persist AppealFiled"
      described as {
        |Instructs this repository to apply AppealFiled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAppealResolved is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row AppealResolved applies to.
        }
      }
    } with {
      briefly "Persist AppealResolved"
      described as {
        |Instructs this repository to apply AppealResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBenefitReinstated is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row BenefitReinstated applies to.
        }
      }
    } with {
      briefly "Persist BenefitReinstated"
      described as {
        |Instructs this repository to apply BenefitReinstated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBenefitSuspended is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row BenefitSuspended applies to.
        }
      }
    } with {
      briefly "Persist BenefitSuspended"
      described as {
        |Instructs this repository to apply BenefitSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDocumentUploaded is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row DocumentUploaded applies to.
        }
      }
    } with {
      briefly "Persist DocumentUploaded"
      described as {
        |Instructs this repository to apply DocumentUploaded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDocumentVerified is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row DocumentVerified applies to.
        }
      }
    } with {
      briefly "Persist DocumentVerified"
      described as {
        |Instructs this repository to apply DocumentVerified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEligibilityDetermined is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row EligibilityDetermined applies to.
        }
      }
    } with {
      briefly "Persist EligibilityDetermined"
      described as {
        |Instructs this repository to apply EligibilityDetermined to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHouseholdUpdated is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row HouseholdUpdated applies to.
        }
      }
    } with {
      briefly "Persist HouseholdUpdated"
      described as {
        |Instructs this repository to apply HouseholdUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRecertificationCompleted is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row RecertificationCompleted applies to.
        }
      }
    } with {
      briefly "Persist RecertificationCompleted"
      described as {
        |Instructs this repository to apply RecertificationCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRecertificationInitiated is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row RecertificationInitiated applies to.
        }
      }
    } with {
      briefly "Persist RecertificationInitiated"
      described as {
        |Instructs this repository to apply RecertificationInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistApplicationSubmitted is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApplicationSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ApplicationSubmitted"
      described as {
        |Instructs this repository to apply ApplicationSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBenefitApproved is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row BenefitApproved applies to.
        }
      }
    } with {
      briefly "Persist BenefitApproved"
      described as {
        |Instructs this repository to apply BenefitApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBenefitDenied is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row BenefitDenied applies to.
        }
      }
    } with {
      briefly "Persist BenefitDenied"
      described as {
        |Instructs this repository to apply BenefitDenied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBenefitTerminated is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row BenefitTerminated applies to.
        }
      }
    } with {
      briefly "Persist BenefitTerminated"
      described as {
        |Instructs this repository to apply BenefitTerminated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentIssued is  {
      benefitId: BenefitId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentIssued applies to.
        }
      }
    } with {
      briefly "Persist PaymentIssued"
      described as {
        |Instructs this repository to apply PaymentIssued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredBenefit is  {
      benefitId: BenefitId with {
        briefly "benefitId"
        described as {
          |The benefitId column of the stored benefit row.
        }
      }
    } with {
      briefly "Stored benefit row"
      described as {
        |The persistence shape of benefit data as this repository stores it.
      }
    }
    schema BenefitData is relational
      of benefits as record StoredBenefit
        index on field StoredBenefit.benefitId
 with {
      briefly "Benefit data schema"
      described as {
        |The relational schema persisting benefit records for this repository.
      }
    }
    outlet BenefitRepositoryResponses is result Benefit.BenefitQueryResult
    query FindBenefitById replies result BenefitResult is  {
      benefitId: BenefitId with {
        briefly "Benefit"
        described as {
          |Benefit identifier.
        }
      }
    } with {
      briefly "Find benefit by ID"
      described as {
        |Retrieves benefit by identifier.
      }
    }
    result BenefitResult is  {
      benefit: Benefit.ActiveStateData with {
        briefly "Benefit"
        described as {
          |Benefit data.
        }
      }
    } with {
      briefly "Benefit result"
      described as {
        |Returns benefit data.
      }
    }
    query SearchBenefits replies result BenefitsResult is  {
      filterProgramType: ProgramType? with {
        briefly "Program"
        described as {
          |Filter by program.
        }
      }
      filterStatus: BenefitStatus? with {
        briefly "Status"
        described as {
          |Filter by status.
        }
      }
    } with {
      briefly "Search benefits"
      described as {
        |Searches benefits by criteria.
      }
    }
    result BenefitsResult is  {
      benefits: Benefit.ActiveStateData+ with {
        briefly "Benefits"
        described as {
          |Matching benefits.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Benefits result"
      described as {
        |Returns matching benefits.
      }
    }
    query FindByBeneficiary replies result BenefitsResult is  {
      beneficiaryId: BeneficiaryId with {
        briefly "Beneficiary"
        described as {
          |Beneficiary identifier.
        }
      }
    } with {
      briefly "Find by beneficiary"
      described as {
        |Finds benefits for beneficiary.
      }
    }
    query FindBySSN replies result BenefitsResult is  {
      ssn: String(9,9) with {
        briefly "SSN"
        described as {
          |Social security number.
        }
      }
    } with {
      briefly "Find by SSN"
      described as {
        |Finds benefits by SSN.
      }
    }
    query FindPendingRecertification replies result BenefitsResult is  {
      daysUntilDue: Natural with {
        briefly "Days"
        described as {
          |Days until due.
        }
      }
    } with {
      briefly "Find pending recertification"
      described as {
        |Finds benefits needing recert.
      }
    }
    handler BenefitRepositoryHandler is {
      on persistAppealFiled: command PersistAppealFiled is {
        do "apply AppealFiled to the stored row"
      }
      on persistAppealResolved: command PersistAppealResolved is {
        do "apply AppealResolved to the stored row"
      }
      on persistBenefitReinstated: command PersistBenefitReinstated is {
        do "apply BenefitReinstated to the stored row"
      }
      on persistBenefitSuspended: command PersistBenefitSuspended is {
        do "apply BenefitSuspended to the stored row"
      }
      on persistDocumentUploaded: command PersistDocumentUploaded is {
        do "apply DocumentUploaded to the stored row"
      }
      on persistDocumentVerified: command PersistDocumentVerified is {
        do "apply DocumentVerified to the stored row"
      }
      on persistEligibilityDetermined: command PersistEligibilityDetermined is {
        do "apply EligibilityDetermined to the stored row"
      }
      on persistHouseholdUpdated: command PersistHouseholdUpdated is {
        do "apply HouseholdUpdated to the stored row"
      }
      on persistRecertificationCompleted: command PersistRecertificationCompleted is {
        do "apply RecertificationCompleted to the stored row"
      }
      on persistRecertificationInitiated: command PersistRecertificationInitiated is {
        do "apply RecertificationInitiated to the stored row"
      }
      on persistApplicationSubmitted: command PersistApplicationSubmitted is {
        do "apply ApplicationSubmitted to the stored row"
      }
      on persistBenefitApproved: command PersistBenefitApproved is {
        do "apply BenefitApproved to the stored row"
      }
      on persistBenefitDenied: command PersistBenefitDenied is {
        do "apply BenefitDenied to the stored row"
      }
      on persistBenefitTerminated: command PersistBenefitTerminated is {
        do "apply BenefitTerminated to the stored row"
      }
      on persistPaymentIssued: command PersistPaymentIssued is {
        do "apply PaymentIssued to the stored row"
      }
      on query GetAnalyticsData is {
        let analyticsDataView: type AnalyticsDataView = prompt("read the analytics data projection")
        reply analyticsDataView
      }
      on query FindBenefitById is {
        let benefitResult: type BenefitResult = prompt("read the benefit from the store")
        reply benefitResult
      }
      on query SearchBenefits is {
        let benefitsResult: type BenefitsResult = prompt("read the benefits from the store")
        reply benefitsResult
      }
      on query FindByBeneficiary is {
        let benefitsResult: type BenefitsResult = prompt("read the benefits that by beneficiary asks for")
        reply benefitsResult
      }
      on query FindBySSN is {
        let benefitsResult: type BenefitsResult = prompt("read the benefits that by s s n asks for")
        reply benefitsResult
      }
      on query FindPendingRecertification is {
        let benefitsResult: type BenefitsResult = prompt("read the benefits that pending recertification asks for")
        reply benefitsResult
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes benefit queries.
      }
    }
  } with {
    briefly "Benefit repository"
    described as {
      |Persistence for benefit records.
    }
  }
  // Projector for program analytics
  query GetAnalyticsData replies result AnalyticsDataView is  {
    analyticsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which analytics data to retrieve.
      }
    }
  } with {
    briefly "Get analytics data"
    described as {
      |Retrieves the analytics data projection.
    }
  }
  result AnalyticsDataView is  {
    analyticsData: ProgramAnalytics.AnalyticsData with {
      briefly "Analytics data"
      described as {
        |The analytics data being returned.
      }
    }
  } with {
    briefly "Analytics data view"
    described as {
      |Read model view carrying the analytics data projection.
    }
  }
  projector ProgramAnalytics as flow is {
    outlet ProgramAnalyticsToRepository is type BenefitRepositoryCommand
    updates repository BenefitContext.BenefitRepository
    inlet ProgramAnalyticsFromBenefit is type BenefitEvent
    record AnalyticsData is  {
      programStats: ProgramStat+ with {
        briefly "Stats"
        described as {
          |Per-program statistics.
        }
      }
      totalBeneficiaries: Natural with {
        briefly "Beneficiaries"
        described as {
          |Total beneficiaries.
        }
      }
      totalMonthlyPayments: Decimal(14,2) with {
        briefly "Monthly"
        described as {
          |Total monthly payments.
        }
      }
      approvalRate: Decimal(5,2) with {
        briefly "Approval"
        described as {
          |Approval rate.
        }
      }
      pendingApplications: Natural with {
        briefly "Pending"
        described as {
          |Pending applications.
        }
      }
      overdueRecertifications: Natural with {
        briefly "Overdue"
        described as {
          |Overdue recertifications.
        }
      }
    } with {
      briefly "Analytics data"
      described as {
        |Program analytics.
      }
    }
    record ProgramStat is  {
      programType: ProgramType with {
        briefly "Program"
        described as {
          |Program type.
        }
      }
      activeBenefits: Natural with {
        briefly "Active"
        described as {
          |Active benefits.
        }
      }
      monthlyPayments: Decimal(12,2) with {
        briefly "Monthly"
        described as {
          |Monthly payments.
        }
      }
      averageBenefit: Decimal(10,2) with {
        briefly "Average"
        described as {
          |Average benefit.
        }
      }
    } with {
      briefly "Program stat"
      described as {
        |Statistics for program.
      }
    }
    handler AnalyticsHandler is {
      on appealFiled: event Benefit.AppealFiled is {
        tell command BenefitContext.BenefitRepository.PersistAppealFiled(benefitId = appealFiled.benefitId) to repository BenefitContext.BenefitRepository
        do "apply AppealFiled to the ProgramAnalytics projection"
      }
      on appealResolved: event Benefit.AppealResolved is {
        tell command BenefitContext.BenefitRepository.PersistAppealResolved(benefitId = appealResolved.benefitId) to repository BenefitContext.BenefitRepository
        do "apply AppealResolved to the ProgramAnalytics projection"
      }
      on benefitReinstated: event Benefit.BenefitReinstated is {
        tell command BenefitContext.BenefitRepository.PersistBenefitReinstated(benefitId = benefitReinstated.benefitId) to repository BenefitContext.BenefitRepository
        do "apply BenefitReinstated to the ProgramAnalytics projection"
      }
      on benefitSuspended: event Benefit.BenefitSuspended is {
        tell command BenefitContext.BenefitRepository.PersistBenefitSuspended(benefitId = benefitSuspended.benefitId) to repository BenefitContext.BenefitRepository
        do "apply BenefitSuspended to the ProgramAnalytics projection"
      }
      on documentUploaded: event Benefit.DocumentUploaded is {
        tell command BenefitContext.BenefitRepository.PersistDocumentUploaded(benefitId = documentUploaded.benefitId) to repository BenefitContext.BenefitRepository
        do "apply DocumentUploaded to the ProgramAnalytics projection"
      }
      on documentVerified: event Benefit.DocumentVerified is {
        tell command BenefitContext.BenefitRepository.PersistDocumentVerified(benefitId = documentVerified.benefitId) to repository BenefitContext.BenefitRepository
        do "apply DocumentVerified to the ProgramAnalytics projection"
      }
      on eligibilityDetermined: event Benefit.EligibilityDetermined is {
        tell command BenefitContext.BenefitRepository.PersistEligibilityDetermined(benefitId = eligibilityDetermined.benefitId) to repository BenefitContext.BenefitRepository
        do "apply EligibilityDetermined to the ProgramAnalytics projection"
      }
      on householdUpdated: event Benefit.HouseholdUpdated is {
        tell command BenefitContext.BenefitRepository.PersistHouseholdUpdated(benefitId = householdUpdated.benefitId) to repository BenefitContext.BenefitRepository
        do "apply HouseholdUpdated to the ProgramAnalytics projection"
      }
      on recertificationCompleted: event Benefit.RecertificationCompleted is {
        tell command BenefitContext.BenefitRepository.PersistRecertificationCompleted(benefitId = recertificationCompleted.benefitId) to repository BenefitContext.BenefitRepository
        do "apply RecertificationCompleted to the ProgramAnalytics projection"
      }
      on recertificationInitiated: event Benefit.RecertificationInitiated is {
        tell command BenefitContext.BenefitRepository.PersistRecertificationInitiated(benefitId = recertificationInitiated.benefitId) to repository BenefitContext.BenefitRepository
        do "apply RecertificationInitiated to the ProgramAnalytics projection"
      }
      on applicationSubmitted: event Benefit.ApplicationSubmitted is {
        tell command BenefitContext.BenefitRepository.PersistApplicationSubmitted(benefitId = applicationSubmitted.benefitId) to repository BenefitContext.BenefitRepository
      }
      on benefitApproved: event Benefit.BenefitApproved is {
        tell command BenefitContext.BenefitRepository.PersistBenefitApproved(benefitId = benefitApproved.benefitId) to repository BenefitContext.BenefitRepository
      }
      on benefitDenied: event Benefit.BenefitDenied is {
        tell command BenefitContext.BenefitRepository.PersistBenefitDenied(benefitId = benefitDenied.benefitId) to repository BenefitContext.BenefitRepository
      }
      on paymentIssued: event Benefit.PaymentIssued is {
        tell command BenefitContext.BenefitRepository.PersistPaymentIssued(benefitId = paymentIssued.benefitId) to repository BenefitContext.BenefitRepository
      }
      on benefitTerminated: event Benefit.BenefitTerminated is {
        tell command BenefitContext.BenefitRepository.PersistBenefitTerminated(benefitId = benefitTerminated.benefitId) to repository BenefitContext.BenefitRepository
      }
    } with {
      briefly "Processes analytics events"
      described as {
        |Updates program analytics.
      }
    }
  } with {
    briefly "Program analytics"
    described as {
      |Projects program metrics for reporting.
    }
  }
  // ---- Event publication for Benefit ----
  type BenefitEvent is one of {
    BenefitContext.Benefit.ApplicationSubmitted or BenefitContext.Benefit.DocumentUploaded or BenefitContext.Benefit.DocumentVerified or BenefitContext.Benefit.EligibilityDetermined or BenefitContext.Benefit.BenefitApproved or BenefitContext.Benefit.BenefitDenied or BenefitContext.Benefit.PaymentIssued or BenefitContext.Benefit.BenefitSuspended or BenefitContext.Benefit.BenefitReinstated or BenefitContext.Benefit.AppealFiled or BenefitContext.Benefit.AppealResolved or BenefitContext.Benefit.RecertificationInitiated or BenefitContext.Benefit.RecertificationCompleted or BenefitContext.Benefit.HouseholdUpdated or BenefitContext.Benefit.BenefitTerminated
  } with {
    briefly "Benefit event alternation"
    described as {
      |Union of all Benefit events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BenefitEventSplit as flow is {
    inlet BenefitEventSplitIn is type BenefitEvent
    outlet BenefitEventSplitToProgramAnalytics is type BenefitEvent
    handler BenefitEventSplitHandler is {
      on applicationSubmitted: event Benefit.ApplicationSubmitted is {
        send applicationSubmitted to outlet BenefitEventSplitToProgramAnalytics
        tell applicationSubmitted to entity BenefitContext.Benefit
      }
      on documentUploaded: event Benefit.DocumentUploaded is {
        send documentUploaded to outlet BenefitEventSplitToProgramAnalytics
        tell documentUploaded to entity BenefitContext.Benefit
      }
      on documentVerified: event Benefit.DocumentVerified is {
        send documentVerified to outlet BenefitEventSplitToProgramAnalytics
        tell documentVerified to entity BenefitContext.Benefit
      }
      on eligibilityDetermined: event Benefit.EligibilityDetermined is {
        send eligibilityDetermined to outlet BenefitEventSplitToProgramAnalytics
        tell eligibilityDetermined to entity BenefitContext.Benefit
      }
      on benefitApproved: event Benefit.BenefitApproved is {
        send benefitApproved to outlet BenefitEventSplitToProgramAnalytics
        tell benefitApproved to entity BenefitContext.Benefit
      }
      on benefitDenied: event Benefit.BenefitDenied is {
        send benefitDenied to outlet BenefitEventSplitToProgramAnalytics
        tell benefitDenied to entity BenefitContext.Benefit
      }
      on paymentIssued: event Benefit.PaymentIssued is {
        send paymentIssued to outlet BenefitEventSplitToProgramAnalytics
        tell paymentIssued to entity BenefitContext.Benefit
      }
      on benefitSuspended: event Benefit.BenefitSuspended is {
        send benefitSuspended to outlet BenefitEventSplitToProgramAnalytics
        tell benefitSuspended to entity BenefitContext.Benefit
      }
      on benefitReinstated: event Benefit.BenefitReinstated is {
        send benefitReinstated to outlet BenefitEventSplitToProgramAnalytics
        tell benefitReinstated to entity BenefitContext.Benefit
      }
      on appealFiled: event Benefit.AppealFiled is {
        send appealFiled to outlet BenefitEventSplitToProgramAnalytics
        tell appealFiled to entity BenefitContext.Benefit
      }
      on appealResolved: event Benefit.AppealResolved is {
        send appealResolved to outlet BenefitEventSplitToProgramAnalytics
        tell appealResolved to entity BenefitContext.Benefit
      }
      on recertificationInitiated: event Benefit.RecertificationInitiated is {
        send recertificationInitiated to outlet BenefitEventSplitToProgramAnalytics
        tell recertificationInitiated to entity BenefitContext.Benefit
      }
      on recertificationCompleted: event Benefit.RecertificationCompleted is {
        send recertificationCompleted to outlet BenefitEventSplitToProgramAnalytics
        tell recertificationCompleted to entity BenefitContext.Benefit
      }
      on householdUpdated: event Benefit.HouseholdUpdated is {
        send householdUpdated to outlet BenefitEventSplitToProgramAnalytics
        tell householdUpdated to entity BenefitContext.Benefit
      }
      on benefitTerminated: event Benefit.BenefitTerminated is {
        send benefitTerminated to outlet BenefitEventSplitToProgramAnalytics
        tell benefitTerminated to entity BenefitContext.Benefit
      }
      on other is {
        error "Unexpected message for processor BenefitEventSplit"
      }
    } with {
      briefly "Benefit event fan-out handler"
      described as {
        |Delivers each Benefit event to all of its consumers.
      }
    }
  } with {
    briefly "Benefit event fan-out"
    described as {
      |Fans Benefit events out to the repository and projectors.
    }
  }
  connector 'BenefitEvent Stream' is from outlet BenefitContext.Benefit.BenefitEvents2 to inlet BenefitContext.BenefitEventSplit.BenefitEventSplitIn with {
    briefly "Benefit events, fanned out to storage and read models"
  }
  connector 'ProgramAnalytics Feed' is from outlet BenefitContext.BenefitEventSplit.BenefitEventSplitToProgramAnalytics to inlet BenefitContext.ProgramAnalytics.ProgramAnalyticsFromBenefit with {
    briefly "Benefit events feeding the ProgramAnalytics projection"
  }
  connector 'ProgramAnalytics Storage' is from outlet BenefitContext.ProgramAnalytics.ProgramAnalyticsToRepository to inlet BenefitContext.BenefitRepository.BenefitRepositoryFromProgramAnalytics with {
    briefly "ProgramAnalytics updates on their way to storage"
  }
} with {
  briefly "Benefit context"
  described as {
    | The Benefit context manages government
    | assistance programs.
  }
}
