// API Management - APIProduct Entity
// Core entity managing API lifecycle, versions, and subscriptions
entity APIProduct as flow is {
  type APIProductCommand is one of {
    APIProduct.CreateAPI or APIProduct.PublishVersion or APIProduct.DeprecateVersion or APIProduct.CreateSubscription or APIProduct.RevokeSubscription or APIProduct.UpdateRateLimit
  } with {
    briefly "API product command alternation"
    described as {
      |Commands accepted by the APIProduct entity.
    }
  }
  inlet APIProductCommands is type APIProductCommand  outlet Events is type APIProductEvent
  query FetchAPIProduct is  {
    aPIProductId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the APIProduct to retrieve.
      }
    }
  } with {
    briefly "Get APIProduct"
    described as {
      |Retrieve APIProduct data by identifier.
    }
  }
  result APIProductQueryResult is  {
    aPIProductData: DraftStateData with {
      briefly "APIProduct data"
      described as {
        |The requested APIProduct data.
      }
    }
  } with {
    briefly "APIProduct result"
    described as {
      |Result carrying the requested APIProduct data.
    }
  }
  // Commands
  command CreateAPI is  {
    apiId: APIId
    name: String
    description: String
    basePath: String
    openApiSpec: String
    initialRateLimit: RateLimitPolicy
  } with {
    briefly "Create a new API product"
    described as {
      |Initializes a new API product in draft status with the
      |      provided definition and default rate limiting policy.
    }
  }
  command PublishVersion is  {
    apiId: APIId
    versionId: VersionId
    changelog: String
  } with {
    briefly "Publish a new API version"
    described as {
      |Publishes a version of the API, making it available for
      |      subscription and consumption through the gateway.
    }
  }
  command DeprecateVersion is  {
    apiId: APIId
    versionId: VersionId
    reason: String
    sunsetDate: Date
  } with {
    briefly "Deprecate an API version"
    described as {
      |Marks an API version as deprecated, signaling to consumers
      |      that they should migrate to a newer version before the sunset date.
    }
  }
  command CreateSubscription is  {
    apiId: APIId
    subscriptionId: SubscriptionId
    subscriberId: String
    subscriberName: String
    customRateLimit: RateLimitPolicy?
  } with {
    briefly "Create a new subscription"
    described as {
      |Creates a subscription for a consumer to access the API,
      |      generating an API key and applying rate limits.
    }
  }
  command RevokeSubscription is  {
    apiId: APIId
    subscriptionId: SubscriptionId
    reason: String
  } with {
    briefly "Revoke an existing subscription"
    described as {
      |Immediately revokes a subscription, invalidating the API key
      |      and blocking further access.
    }
  }
  command UpdateRateLimit is  {
    apiId: APIId
    targetSubscriptionId: SubscriptionId?
    newRateLimit: RateLimitPolicy
  } with {
    briefly "Update rate limiting policy"
    described as {
      |Updates the rate limit policy for the API default or a
      |      specific subscription if subscriptionId is provided.
    }
  }
  // Events
  event APICreated is  {
    apiId: APIId
    definition: APIDefinition
    defaultRateLimit: RateLimitPolicy
  } with {
    briefly "API product created"
    described as {
      |Indicates a new API product has been successfully created
      |      and is ready for version publishing.
    }
  }
  event VersionPublished is  {
    apiId: APIId
    version: VersionInfo
  } with {
    briefly "API version published"
    described as {
      |Indicates a new version of the API has been published and
      |      is now available for consumption.
    }
  }
  event VersionDeprecated is  {
    apiId: APIId
    versionId: VersionId
    reason: String
    sunsetDate: Date
  } with {
    briefly "API version deprecated"
    described as {
      |Indicates an API version has been marked for deprecation
      |      with a scheduled sunset date.
    }
  }
  event SubscriptionCreated is  {
    apiId: APIId
    subscription: SubscriptionInfo
  } with {
    briefly "Subscription created"
    described as {
      |Indicates a new subscription has been created with an
      |      active API key.
    }
  }
  event SubscriptionRevoked is  {
    apiId: APIId
    subscriptionId: SubscriptionId
    reason: String
    revokedAt: DateTime
  } with {
    briefly "Subscription revoked"
    described as {
      |Indicates a subscription has been revoked and the API key
      |      is no longer valid.
    }
  }
  event RateLimitUpdated is  {
    apiId: APIId
    targetSubscriptionId: SubscriptionId?
    previousLimit: RateLimitPolicy
    newLimit: RateLimitPolicy
  } with {
    briefly "Rate limit updated"
    described as {
      |Indicates the rate limiting policy has been changed for
      |      the API or a specific subscription.
    }
  }
  // States
  initial state DraftState of record DraftStateData is {
    initial handler DraftStateInitHandler is {
      on query FetchAPIProduct is {
        let aPIProductQueryResult: type APIProductQueryResult = prompt("read the a p i product query from the store")
        tell aPIProductQueryResult to entity APIContext.APIProduct
      }
      on init is {
        set state DraftState to "initialize DraftStateData fields from the creating message"
      }
    } with {
      briefly "DraftState initialization"
      described as {
        |Initializes DraftState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Draft state"
    described as {
      |The draft state of the APIProduct entity, carrying DraftStateData.
    }
  }
  state ActiveState of record ActiveStateData is {
    initial handler ActiveStateInitHandler is {
      on init is {
        set state ActiveState to "initialize ActiveStateData fields from the creating message"
      }
    } with {
      briefly "ActiveState initialization"
      described as {
        |Initializes ActiveState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |The active state of the APIProduct entity, carrying ActiveStateData.
    }
  }
  state DeprecatedState of record DeprecatedStateData is {
    initial handler DeprecatedStateInitHandler is {
      on init is {
        set state DeprecatedState to "initialize DeprecatedStateData fields from the creating message"
      }
    } with {
      briefly "DeprecatedState initialization"
      described as {
        |Initializes DeprecatedState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Deprecated state"
    described as {
      |The deprecated state of the APIProduct entity, carrying DeprecatedStateData.
    }
  }
  state RetiredState of record RetiredStateData is {
    initial handler RetiredStateInitHandler is {
      on init is {
        set state RetiredState to "initialize RetiredStateData fields from the creating message"
      }
    } with {
      briefly "RetiredState initialization"
      described as {
        |Initializes RetiredState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Retired state"
    described as {
      |The retired state of the APIProduct entity, carrying RetiredStateData.
    }
  }
  // Handler
  handler APIProductHandler is {
    on createAPI: command CreateAPI is {
      send event APIProduct.APICreated(apiId = createAPI.apiId) to outlet Events
      let draftStateData: type DraftStateData = prompt("the draft state data that results from create a p i")
      morph entity APIProduct to state DraftState with draftStateData
    }
    on publishVersion: command PublishVersion is {
      send event APIProduct.VersionPublished(apiId = publishVersion.apiId) to outlet Events
      let activeStateData: type ActiveStateData = prompt("the active state data that results from publish version")
      morph entity APIProduct to state ActiveState with activeStateData
    }
    on deprecateVersion: command DeprecateVersion is {
      send event APIProduct.VersionDeprecated(apiId = deprecateVersion.apiId, versionId = deprecateVersion.versionId, reason = deprecateVersion.reason, sunsetDate = deprecateVersion.sunsetDate) to outlet Events
    }
    on createSubscription: command CreateSubscription is {
      send event APIProduct.SubscriptionCreated(apiId = createSubscription.apiId) to outlet Events
    }
    on revokeSubscription: command RevokeSubscription is {
      send event APIProduct.SubscriptionRevoked(apiId = revokeSubscription.apiId, subscriptionId = revokeSubscription.subscriptionId, reason = revokeSubscription.reason) to outlet Events
    }
    on updateRateLimit: command UpdateRateLimit is {
      send event APIProduct.RateLimitUpdated(apiId = updateRateLimit.apiId, targetSubscriptionId = updateRateLimit.targetSubscriptionId) to outlet Events
    }
  } with {
    briefly "Main command handler for APIProduct"
    described as {
      |Processes all commands related to API lifecycle management,
      |      version publishing, subscription management, and rate limiting.
    }
  }
} with {
  briefly "API Product aggregate root"
  described as {
    | The APIProduct entity is the aggregate root for managing the complete
    | lifecycle of an API within the platform. It handles:
    |
    | - API creation and definition management
    | - Version publishing and deprecation
    | - Subscription management with API key generation
    | - Rate limiting policy configuration
    |
    | Each API product progresses through lifecycle states from Draft to
    | Active to optionally Deprecated and finally Retired.
  }
}
