// API Management - APIContext
// Bounded context containing core API management capabilities
context APIContext as router is {
  inlet AppCommandsToAPIProductIn is type APIProductCommand
  outlet AppCommandsToAPIProductOut is type APIProductCommand
  inlet RepositoryResponsesToAppIn is type APIProduct.APIProductQueryResult
  outlet RepositoryResponsesToAppOut is type APIProduct.APIProductQueryResult
  handler APIContextBoundary is {
    on createAPI: command APIProduct.CreateAPI is {
      send createAPI to outlet APIContext.AppCommandsToAPIProductOut
    }
    on publishVersion: command APIProduct.PublishVersion is {
      send publishVersion to outlet APIContext.AppCommandsToAPIProductOut
    }
    on deprecateVersion: command APIProduct.DeprecateVersion is {
      send deprecateVersion to outlet APIContext.AppCommandsToAPIProductOut
    }
    on createSubscription: command APIProduct.CreateSubscription is {
      send createSubscription to outlet APIContext.AppCommandsToAPIProductOut
    }
    on revokeSubscription: command APIProduct.RevokeSubscription is {
      send revokeSubscription to outlet APIContext.AppCommandsToAPIProductOut
    }
    on updateRateLimit: command APIProduct.UpdateRateLimit is {
      send updateRateLimit to outlet APIContext.AppCommandsToAPIProductOut
    }
    on aPIProductQueryResult: result APIProduct.APIProductQueryResult is {
      send aPIProductQueryResult to outlet APIContext.RepositoryResponsesToAppOut
    }
    on other is {
      error "Unexpected message at the APIContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AppCommandsToAPIProduct Intake' is from outlet APIContext.AppCommandsToAPIProductOut to inlet APIContext.APIProduct.APIProductCommands
  connector 'RepositoryResponsesToApp Egress' is from outlet APIContext.APIProductRepository.APIProductResponses to inlet APIContext.RepositoryResponsesToAppIn
  // APIManagementApp is ascribed `as flow`, whose arity is fixed at one
  // inlet and one outlet, so the domain's error sink is hosted here.
  inlet ErrorSink is record Riddl.GeneratorError with {
    option error-sink()
    briefly "Hard error destination"
    described as {
      |Where hard errors raised anywhere in APIManagement are delivered.
    }
  }
  adaptor FromAnalyticsService from context AnalyticsService is { 
    handler FromAnalyticsServiceHandler is {
      on event AnalyticsService.AnalyticsEventReceived is {
        do "the model receives analytics event received"
      }
      on event AnalyticsService.ReportGenerated is {
        do "the model receives report generated"
      }
      on other is {
        error "Unexpected message for adaptor FromAnalyticsService"
      }
    } with {
      briefly "from analytics service"
      described as {
        |Carries messages from the external AnalyticsService.
      }
    }
  } with {
    briefly "AnalyticsService integration"
    described as {
      |The model's side of the AnalyticsService conversation.
    }
  }
  adaptor FromDeveloperPortal from context DeveloperPortal is { 
    handler FromDeveloperPortalHandler is {
      on event DeveloperPortal.APIListingPublished is {
        do "the model receives api listing published"
      }
      on event DeveloperPortal.APIListingRemoved is {
        do "the model receives api listing removed"
      }
      on event DeveloperPortal.APIListingUpdated is {
        do "the model receives api listing updated"
      }
      on event DeveloperPortal.SubscriptionRequested is {
        do "the model receives subscription requested"
      }
      on other is {
        error "Unexpected message for adaptor FromDeveloperPortal"
      }
    } with {
      briefly "from developer portal"
      described as {
        |Carries messages from the external DeveloperPortal.
      }
    }
  } with {
    briefly "DeveloperPortal integration"
    described as {
      |The model's side of the DeveloperPortal conversation.
    }
  }
  adaptor FromGatewayService from context GatewayService is { 
    handler FromGatewayServiceHandler is {
      on event GatewayService.RouteCreated is {
        do "the model receives route created"
      }
      on event GatewayService.RouteRemoved is {
        do "the model receives route removed"
      }
      on event GatewayService.RouteUpdated is {
        do "the model receives route updated"
      }
      on other is {
        error "Unexpected message for adaptor FromGatewayService"
      }
    } with {
      briefly "from gateway service"
      described as {
        |Carries messages from the external GatewayService.
      }
    }
  } with {
    briefly "GatewayService integration"
    described as {
      |The model's side of the GatewayService conversation.
    }
  }
  include "types.riddl"
  include "APIProduct.riddl"
  // Repository for API Products
  repository APIProductRepository as merge is {
    record StoredAPIProduct is  {
      aPIProductId: UUID with {
        briefly "aPIProductId"
        described as {
          |The aPIProductId column of the stored aPIProduct row.
        }
      }
    } with {
      briefly "Stored aPIProduct row"
      described as {
        |The persistence shape of aPIProduct data as this repository stores it.
      }
    }
    schema APIProductData is relational
      of apiproducts as type StoredAPIProduct
 with {
      briefly "Api product data schema"
      described as {
        |The relational schema persisting api product records for this repository.
      }
    }
    inlet FromEntity is type APIProductEvent    inlet FromProjector is type APIProductEvent    outlet APIProductResponses is type APIProduct.APIProductQueryResult
    type APIProductRecord is {
      apiId: APIId
      name: String
      status: APIStatus
      updatedCurrentVersion: VersionId?
      subscriptionCount: Integer
      createdAt: DateTime
      updatedAt: DateTime
    } with {
      briefly "Stored API product record"
      described as {
        |Persistent representation of an API product for querying.
      }
    }
    command StoreAPIProduct is  { record: APIProductRecord } with {
      briefly "Store an API product"
      described as {
        |Persists or updates an API product record.
      }
    }
    command DeleteAPIProduct is  { apiId: APIId } with {
      briefly "Delete an API product"
      described as {
        |Removes an API product record from storage.
      }
    }
    result APIProductResult is  { updatedRecord: APIProductRecord? } with {
      briefly "API product query result"
      described as {
        |Returns the requested API product or nothing if not found.
      }
    }
    result APIProductListResult is  {
      records: APIProductRecord*
      totalCount: Integer
    } with {
      briefly "API product list result"
      described as {
        |Returns a list of API products matching query criteria.
      }
    }
    query GetAPIProductById is  { apiId: APIId } with {
      briefly "Get API product by ID"
      described as {
        |Retrieves a single API product by its identifier.
      }
    }
    query ListAPIProducts is  {
      filterStatus: APIStatus?
      limit: Integer
      offset: Integer
    } with {
      briefly "List API products"
      described as {
        |Lists API products with optional status filter and pagination.
      }
    }
    query SearchAPIProducts is  {
      searchTerm: String
      limit: Integer
    } with {
      briefly "Search API products"
      described as {
        |Searches API products by name or description.
      }
    }
    query GetHourlyMetrics is  {
      apiId: APIId
      startDate: Date
      endDate: Date
    } with {
      briefly "Get hourly usage metrics"
      described as {
        |Retrieves hourly usage metrics for an API over a date range.
      }
    }
    query GetDailySummary is  {
      apiId: APIId
      startDate: Date
      endDate: Date
    } with {
      briefly "Get daily usage summary"
      described as {
        |Retrieves daily aggregated usage summaries.
      }
    }
    query GetTopAPIs is  {
      limit: Integer
      periodDays: Integer
    } with {
      briefly "Get top APIs by usage"
      described as {
        |Returns the most used APIs over the specified period.
      }
    }
    handler APIProductRepositoryHandler is {
      on query GetProjectorState is {
        let projectorStateView: type ProjectorStateView = prompt("read the projector state projection")
        reply projectorStateView
      }
      on command StoreAPIProduct is {
        do "store api product"
      }
      on command DeleteAPIProduct is {
        do "delete api product"
      }
      on query GetAPIProductById is {
        let aPIProductResult: type APIProductResult = prompt("read the a p i product from the store")
        reply aPIProductResult
      }
      on query ListAPIProducts is {
        let aPIProductListResult: type APIProductListResult = prompt("read the a p i product list that a p i products asks for")
        reply aPIProductListResult
      }
      on query SearchAPIProducts is {
        let aPIProductListResult: type APIProductListResult = prompt("read the a p i product list that a p i products asks for")
        reply aPIProductListResult
      }
      on query GetHourlyMetrics is {
        let aPIProductResult: type APIProductResult = prompt("read the a p i product that hourly metrics asks for")
        reply aPIProductResult
      }
      on query GetDailySummary is {
        let aPIProductResult: type APIProductResult = prompt("read the a p i product that daily summary asks for")
        reply aPIProductResult
      }
      on query GetTopAPIs is {
        let aPIProductListResult: type APIProductListResult = prompt("read the a p i product list that top a p is asks for")
        reply aPIProductListResult
      }
    } with {
      briefly "Repository command and query handler"
      described as {
        |Processes storage operations and queries for API products and metrics.
      }
    }
  } with {
    briefly "API Product persistence repository"
    described as {
      |Provides storage and retrieval capabilities for API product
      |      aggregates with support for filtering, pagination, and search.
    }
  }
  // Projector for API Usage Metrics
  query GetProjectorState is  {
    projectorStateKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which projector state to retrieve.
      }
    }
  } with {
    briefly "Get projector state"
    described as {
      |Retrieves the projector state projection.
    }
  }
  result ProjectorStateView is  {
    projectorState: APIUsageMetricsProjector.ProjectorState with {
      briefly "Projector state"
      described as {
        |The projector state being returned.
      }
    }
  } with {
    briefly "Projector state view"
    described as {
      |Read model view carrying the projector state projection.
    }
  }
  projector APIUsageMetricsProjector as flow is {
    updates repository APIContext.APIProductRepository
    inlet IncomingEvents is type APIProductEvent    outlet ToRepository is type APIProductEvent
    record ProjectorState is  { lastUpdated: DateTime } with {
      briefly "Projector internal state"
      described as {
        |Tracks the internal state of the metrics projector.
      }
    }
    handler MetricsProjectionHandler is {
      on versionPublished: event APIProduct.VersionPublished is {
        tell versionPublished to repository APIContext.APIProductRepository
        send versionPublished to outlet ToRepository
      }
      on subscriptionCreated: event APIProduct.SubscriptionCreated is {
        tell subscriptionCreated to repository APIContext.APIProductRepository
        send subscriptionCreated to outlet ToRepository
      }
    } with {
      briefly "Metrics projection handler"
      described as {
        |Processes events to build usage metrics projections.
      }
    }
  } with {
    briefly "API usage metrics projector"
    described as {
      | The APIUsageMetricsProjector maintains a read-optimized view of API
      | usage statistics. It processes events from the analytics service to
      | build aggregated views suitable for:
      |
      | - Real-time usage dashboards
      | - Historical trend analysis
      | - Top API leaderboards
      | - Consumer behavior insights
      |
      | Metrics are aggregated at hourly and daily granularity for efficient
      | querying across different time ranges.
    }
  }
  // ---- Event publication for APIProduct ----
  type APIProductEvent is one of {
    APIContext.APIProduct.APICreated or APIContext.APIProduct.VersionPublished or APIContext.APIProduct.VersionDeprecated or APIContext.APIProduct.SubscriptionCreated or APIContext.APIProduct.SubscriptionRevoked or APIContext.APIProduct.RateLimitUpdated
  } with {
    briefly "APIProduct event alternation"
    described as {
      |Union of all APIProduct events, for streaming and event-sourced
      |persistence.
    }
  }
  processor APIProductEventSplit as split is {
    inlet FromEntity is type APIProductEvent    outlet SplitToRepository is type APIProductEvent
    outlet SplitToProjector is type APIProductEvent
    handler APIProductEventSplitHandler is {
      on aPICreated: event APIProduct.APICreated is {
        send aPICreated to outlet SplitToRepository
        send aPICreated to outlet SplitToProjector
      }
      on versionPublished: event APIProduct.VersionPublished is {
        send versionPublished to outlet SplitToRepository
        send versionPublished to outlet SplitToProjector
      }
      on versionDeprecated: event APIProduct.VersionDeprecated is {
        send versionDeprecated to outlet SplitToRepository
        send versionDeprecated to outlet SplitToProjector
      }
      on subscriptionCreated: event APIProduct.SubscriptionCreated is {
        send subscriptionCreated to outlet SplitToRepository
        send subscriptionCreated to outlet SplitToProjector
      }
      on subscriptionRevoked: event APIProduct.SubscriptionRevoked is {
        send subscriptionRevoked to outlet SplitToRepository
        send subscriptionRevoked to outlet SplitToProjector
      }
      on rateLimitUpdated: event APIProduct.RateLimitUpdated is {
        send rateLimitUpdated to outlet SplitToRepository
        send rateLimitUpdated to outlet SplitToProjector
      }
      on other is {
        error "Unexpected message for processor APIProductEventSplit"
      }
    } with {
      briefly "API product event fan-out"
      described as {
        |Delivers each API product event to both the repository and the
        |usage-metrics projector.
      }
    }
  } with {
    briefly "API product event split"
    described as {
      |Fans API product events out to their consumers.
    }
  }
  connector APIProductEventsToSplit is from outlet APIContext.APIProduct.Events to inlet APIContext.APIProductEventSplit.FromEntity with {
    briefly "Entity events to fan-out"
  }
  connector APIProductSplitToRepository is from outlet APIContext.APIProductEventSplit.SplitToRepository to inlet APIContext.APIProductRepository.FromEntity with {
    briefly "Fan-out to repository"
  }
  connector APIProductSplitToProjector is from outlet APIContext.APIProductEventSplit.SplitToProjector to inlet APIContext.APIUsageMetricsProjector.IncomingEvents with {
    briefly "Fan-out to projector"
  }
  connector APIProductProjectorToRepository is from outlet APIContext.APIUsageMetricsProjector.ToRepository to inlet APIContext.APIProductRepository.FromProjector with {
    briefly "Projector to repository"
  }
} with {
  briefly "API Management bounded context"
  described as {
    | The APIContext is the core bounded context for API management operations.
    | It encapsulates all functionality related to:
    |
    | - API product lifecycle management
    | - Version publishing and deprecation
    | - Subscription and access control
    | - Rate limiting configuration
    | - Usage metrics and analytics
    |
    | This context integrates with external systems including the API Gateway
    | for traffic management, Developer Portal for consumer experience, and
    | Analytics Service for usage insights.
  }
}
