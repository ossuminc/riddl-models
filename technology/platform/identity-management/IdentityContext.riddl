// Identity Management bounded context
context IdentityContext as router is {
  inlet IdentityContextFromDirectoryService is command Identity.DeactivateIdentity with {
    briefly "What FromDirectoryService makes of that service's news"
  }
  connector 'FromDirectoryService Intake' is from outlet IdentityContext.FromDirectoryService.FromDirectoryServiceToIdentityContext to inlet IdentityContext.IdentityContextFromDirectoryService with {
    briefly "What FromDirectoryService makes of that news, on its way in"
  }
  inlet IdentityContextFromMFAProvider is command Identity.CreateSession with {
    briefly "What FromMFAProvider makes of that service's news"
  }
  connector 'FromMFAProvider Intake' is from outlet IdentityContext.FromMFAProvider.FromMFAProviderToIdentityContext to inlet IdentityContext.IdentityContextFromMFAProvider with {
    briefly "What FromMFAProvider makes of that news, on its way in"
  }
  inlet IdentityCommandStreamIn is type IdentityCommand  outlet IdentityCommandStreamOut is type IdentityCommand
  inlet IdentityQueryResultStreamIn is result Identity.IdentityQueryResult  outlet IdentityQueryResultStreamOut is result Identity.IdentityQueryResult
  handler IdentityContextBoundary is {
    on createIdentity: command Identity.CreateIdentity is {
      send createIdentity to outlet IdentityContext.IdentityCommandStreamOut
    }
    on verifyIdentity: command Identity.VerifyIdentity is {
      send verifyIdentity to outlet IdentityContext.IdentityCommandStreamOut
    }
    on addCredential: command Identity.AddCredential is {
      send addCredential to outlet IdentityContext.IdentityCommandStreamOut
    }
    on authenticate: command Identity.Authenticate is {
      send authenticate to outlet IdentityContext.IdentityCommandStreamOut
    }
    on createSession: command Identity.CreateSession is {
      send createSession to outlet IdentityContext.IdentityCommandStreamOut
    }
    on revokeSession: command Identity.RevokeSession is {
      send revokeSession to outlet IdentityContext.IdentityCommandStreamOut
    }
    on deactivateIdentity: command Identity.DeactivateIdentity is {
      send deactivateIdentity to outlet IdentityContext.IdentityCommandStreamOut
    }
    on suspendIdentity: command Identity.SuspendIdentity is {
      send suspendIdentity to outlet IdentityContext.IdentityCommandStreamOut
    }
    on reactivateIdentity: command Identity.ReactivateIdentity is {
      send reactivateIdentity to outlet IdentityContext.IdentityCommandStreamOut
    }
    on identityQueryResult: result Identity.IdentityQueryResult is {
      send identityQueryResult to outlet IdentityContext.IdentityQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the IdentityContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'IdentityCommand Stream Intake' is from outlet IdentityContext.IdentityCommandStreamOut to inlet IdentityContext.Identity.IdentityCommands  connector 'IdentityQueryResult Stream Egress' is from outlet IdentityContext.IdentityRepository.IdentityRepositoryResponses to inlet IdentityContext.IdentityQueryResultStreamIn  adaptor FromAuditService from context AuditService as sink is { 
    inlet FromAuditServiceIn is type AuditService.AuditServiceEvent    handler FromAuditServiceHandler is {
      on auditEntryRecorded: event AuditService.AuditEntryRecorded is {
        do "the audit trail has it; nothing the identity holds changes"
      }
      on securityAlertTriggered: event AuditService.SecurityAlertTriggered is {
        do "a security alert is raised; suspending the identity is a security decision"
      }
      on other is {
        error "Unexpected message for adaptor FromAuditService"
      }
    } with {
      briefly "from audit service"
      described as {
        |Carries messages from the external AuditService.
      }
    }
  } with {
    briefly "AuditService integration"
    described as {
      |The model's side of the AuditService conversation.
    }
  }
  adaptor FromDirectoryService from context DirectoryService as flow is { 
    inlet FromDirectoryServiceIn is type DirectoryService.DirectoryServiceEvent    outlet FromDirectoryServiceToIdentityContext is command Identity.DeactivateIdentity
    handler FromDirectoryServiceHandler is {
      on groupMembershipChanged: event DirectoryService.GroupMembershipChanged is {
        do "the directory's groups changed; the identity carries no groups of its own"
      }
      on userRemoved: event DirectoryService.UserRemoved is {
        let item0: type Identity.DeactivateIdentity = prompt("translate the userRemoved event into a DeactivateIdentity, a user removed from the directory has no identity to keep active")
        send item0 to outlet IdentityContext.FromDirectoryService.FromDirectoryServiceToIdentityContext
      }
      on userSynchronized: event DirectoryService.UserSynchronized is {
        do "the directory's copy is synced; an identity is created when the user first signs in"
      }
      on other is {
        error "Unexpected message for adaptor FromDirectoryService"
      }
    } with {
      briefly "from directory service"
      described as {
        |Carries messages from the external DirectoryService.
      }
    }
  } with {
    briefly "DirectoryService integration"
    described as {
      |The model's side of the DirectoryService conversation.
    }
  }
  adaptor FromMFAProvider from context MFAProvider as flow is { 
    inlet FromMFAProviderIn is type MFAProvider.MFAProviderEvent    outlet FromMFAProviderToIdentityContext is command Identity.CreateSession
    handler FromMFAProviderHandler is {
      on mFAChallengeIssued: event MFAProvider.MFAChallengeIssued is {
        do "the challenge is out; the session waits on the answer"
      }
      on mFAVerificationFailed: event MFAProvider.MFAVerificationFailed is {
        do "the challenge failed; the user tries again and the identity is unchanged"
      }
      on mFAVerificationSucceeded: event MFAProvider.MFAVerificationSucceeded is {
        let item0: type Identity.CreateSession = prompt("translate the mFAVerificationSucceeded event into a CreateSession, a passed challenge is the final gate, so the session opens")
        send item0 to outlet IdentityContext.FromMFAProvider.FromMFAProviderToIdentityContext
      }
      on other is {
        error "Unexpected message for adaptor FromMFAProvider"
      }
    } with {
      briefly "from mfa provider"
      described as {
        |Carries messages from the external MFAProvider.
      }
    }
  } with {
    briefly "MFAProvider integration"
    described as {
      |The model's side of the MFAProvider conversation.
    }
  }
  include "types.riddl"
  include "Identity.riddl"
  type IdentityRepositoryCommand is one of {
    IdentityContext.IdentityRepository.PersistAuthenticationFailed or IdentityContext.IdentityRepository.PersistAuthenticationSucceeded or IdentityContext.IdentityRepository.PersistCredentialAdded or IdentityContext.IdentityRepository.PersistIdentityCreated or IdentityContext.IdentityRepository.PersistIdentityDeactivated or IdentityContext.IdentityRepository.PersistIdentityReactivated or IdentityContext.IdentityRepository.PersistIdentitySuspended or IdentityContext.IdentityRepository.PersistIdentityVerified or IdentityContext.IdentityRepository.PersistSessionCreated or IdentityContext.IdentityRepository.PersistSessionRevoked
  } with {
    briefly "Anything that writes IdentityRepository"
    described as {
      |The persistence commands IdentityRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository IdentityRepository as flow is {
    inlet IdentityRepositoryFromAuthenticationMetrics is type IdentityRepositoryCommand    command PersistCredentialAdded is {
      identityId: IdentityId with {
        briefly "Row addressed"
        described as {
          |Which stored row CredentialAdded applies to.
        }
      }
      credentialId: CredentialId? with {
        briefly "Credential id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      credentialType: CredentialType? with {
        briefly "Credential type"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      addedAt: DateTime? with {
        briefly "Added at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CredentialAdded"
      described as {
        |Instructs this repository to apply CredentialAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIdentityCreated is {
      identityId: IdentityId with {
        briefly "Row addressed"
        described as {
          |Which stored row IdentityCreated applies to.
        }
      }
      email: EmailAddress? with {
        briefly "Email"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      displayName: String? with {
        briefly "Display name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: DateTime? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist IdentityCreated"
      described as {
        |Instructs this repository to apply IdentityCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIdentityDeactivated is {
      identityId: IdentityId with {
        briefly "Row addressed"
        described as {
          |Which stored row IdentityDeactivated applies to.
        }
      }
      deactivatedAt: DateTime? with {
        briefly "Deactivated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      deactivatedBy: IdentityId? with {
        briefly "Deactivated by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist IdentityDeactivated"
      described as {
        |Instructs this repository to apply IdentityDeactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIdentityReactivated is {
      identityId: IdentityId with {
        briefly "Row addressed"
        described as {
          |Which stored row IdentityReactivated applies to.
        }
      }
      reactivatedAt: DateTime? with {
        briefly "Reactivated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reactivatedBy: IdentityId? with {
        briefly "Reactivated by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist IdentityReactivated"
      described as {
        |Instructs this repository to apply IdentityReactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIdentitySuspended is {
      identityId: IdentityId with {
        briefly "Row addressed"
        described as {
          |Which stored row IdentitySuspended applies to.
        }
      }
      suspendedAt: DateTime? with {
        briefly "Suspended at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      suspendedBy: IdentityId? with {
        briefly "Suspended by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist IdentitySuspended"
      described as {
        |Instructs this repository to apply IdentitySuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIdentityVerified is {
      identityId: IdentityId with {
        briefly "Row addressed"
        described as {
          |Which stored row IdentityVerified applies to.
        }
      }
      verificationMethod: VerificationMethod? with {
        briefly "Verification method"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      verifiedAt: DateTime? with {
        briefly "Verified at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist IdentityVerified"
      described as {
        |Instructs this repository to apply IdentityVerified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAuthenticationFailed is {
      identityId: IdentityId with {
        briefly "Row addressed"
        described as {
          |Which stored row AuthenticationFailed applies to.
        }
      }
      credentialType: CredentialType? with {
        briefly "Credential type"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      failureReason: String? with {
        briefly "Failure reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      attemptedAt: DateTime? with {
        briefly "Attempted at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      ipAddress: String? with {
        briefly "Ip address"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist AuthenticationFailed"
      described as {
        |Instructs this repository to apply AuthenticationFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAuthenticationSucceeded is {
      identityId: IdentityId with {
        briefly "Row addressed"
        described as {
          |Which stored row AuthenticationSucceeded applies to.
        }
      }
      credentialType: CredentialType? with {
        briefly "Credential type"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      sessionId: SessionId? with {
        briefly "Session id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      authenticatedAt: DateTime? with {
        briefly "Authenticated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      ipAddress: String? with {
        briefly "Ip address"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist AuthenticationSucceeded"
      described as {
        |Instructs this repository to apply AuthenticationSucceeded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSessionCreated is {
      sessionId: SessionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SessionCreated applies to.
        }
      }
      identityId: IdentityId? with {
        briefly "Identity id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: DateTime? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      expiresAt: DateTime? with {
        briefly "Expires at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SessionCreated"
      described as {
        |Instructs this repository to apply SessionCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSessionRevoked is {
      sessionId: SessionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SessionRevoked applies to.
        }
      }
      identityId: IdentityId? with {
        briefly "Identity id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      revokedAt: DateTime? with {
        briefly "Revoked at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SessionRevoked"
      described as {
        |Instructs this repository to apply SessionRevoked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredIdentity is {
      identityId: IdentityId with {
        briefly "identityId"
        described as {
          |The identityId column of the stored identity row.
        }
      }
      credentialId: CredentialId? with {
        briefly "Credential id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      credentialType: CredentialType? with {
        briefly "Credential type"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      addedAt: DateTime? with {
        briefly "Added at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      email: EmailAddress? with {
        briefly "Email"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      displayName: String? with {
        briefly "Display name"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: DateTime? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      deactivatedAt: DateTime? with {
        briefly "Deactivated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      deactivatedBy: IdentityId? with {
        briefly "Deactivated by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reactivatedAt: DateTime? with {
        briefly "Reactivated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reactivatedBy: IdentityId? with {
        briefly "Reactivated by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      suspendedAt: DateTime? with {
        briefly "Suspended at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      suspendedBy: IdentityId? with {
        briefly "Suspended by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      verificationMethod: VerificationMethod? with {
        briefly "Verification method"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      verifiedAt: DateTime? with {
        briefly "Verified at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      failureReason: String? with {
        briefly "Failure reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      attemptedAt: DateTime? with {
        briefly "Attempted at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      ipAddress: String? with {
        briefly "Ip address"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      sessionId: SessionId? with {
        briefly "Session id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      authenticatedAt: DateTime? with {
        briefly "Authenticated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      expiresAt: DateTime? with {
        briefly "Expires at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      revokedAt: DateTime? with {
        briefly "Revoked at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored identity row"
      described as {
        |The persistence shape of identity data as this repository stores it.
      }
    }
    schema IdentityData is relational
      of identitys as record StoredIdentity
        key on field StoredIdentity.identityId
 with {
      briefly "Identity data schema"
      described as {
        |The relational schema persisting identity records for this repository.
      }
    }
    outlet IdentityRepositoryResponses is result Identity.IdentityQueryResult
    // Query types
    type IdentityQuery is {
      filterEmail: EmailAddress?
      filterStatus: IdentityStatus?
      createdAfter: DateTime?
      createdBefore: DateTime?
    } with {
      briefly "Query parameters for identity search"
      described as {
        |Defines filter criteria for searching identities.
      }
    }
    // Commands
    command StoreIdentity is {
      identity: UserIdentity
      credentials: Credential+
    } with {
      briefly "Store or update an identity"
      described as {
        |Persists an identity record with its credentials.
      }
    }
    command StoreSession is { session: SessionInfo } with {
      briefly "Store a session record"
      described as {
        |Persists a session record.
      }
    }
    command DeleteSession is { sessionId: SessionId } with {
      briefly "Delete a session record"
      described as {
        |Removes a session record from storage.
      }
    }
    // Queries
    query GetIdentityById replies result IdentityResult is { identityId: IdentityId } with {
      briefly "Retrieve identity by ID"
      described as {
        |Fetches a single identity by its unique identifier.
      }
    }
    query GetIdentityByEmail replies result IdentityResult is { email: EmailAddress } with {
      briefly "Retrieve identity by email"
      described as {
        |Fetches a single identity by email address.
      }
    }
    query SearchIdentities replies result IdentityListResult is {
      query: IdentityQuery
      limit: Integer
      offset: Integer
    } with {
      briefly "Search identities with filters"
      described as {
        |Searches identities matching the specified criteria.
      }
    }
    query GetActiveSessions replies result SessionListResult is { identityId: IdentityId } with {
      briefly "Get active sessions for identity"
      described as {
        |Retrieves all active sessions for a given identity.
      }
    }
    // Results
    result IdentityResult is {
      updatedIdentity: UserIdentity?
      credentials: Credential+
    } with {
      briefly "Single identity query result"
      described as {
        |Returns an identity with its credentials if found.
      }
    }
    result IdentityListResult is {
      identities: UserIdentity+
      totalCount: Integer
    } with {
      briefly "Identity search result"
      described as {
        |Returns a paginated list of identities.
      }
    }
    result SessionListResult is { sessions: SessionInfo+ } with {
      briefly "Session query result"
      described as {
        |Returns a list of sessions.
      }
    }
    handler RepositoryHandler is {
      on persistCredentialAdded: command PersistCredentialAdded is {
        update IdentityData.identitys set credentialId = persistCredentialAdded.credentialId, credentialType = persistCredentialAdded.credentialType, addedAt = persistCredentialAdded.addedAt where identityId == persistCredentialAdded.identityId
      }
      on persistIdentityCreated: command PersistIdentityCreated is {
        update IdentityData.identitys set email = persistIdentityCreated.email, displayName = persistIdentityCreated.displayName, createdAt = persistIdentityCreated.createdAt where identityId == persistIdentityCreated.identityId
      }
      on persistIdentityDeactivated: command PersistIdentityDeactivated is {
        update IdentityData.identitys set deactivatedAt = persistIdentityDeactivated.deactivatedAt, reason = persistIdentityDeactivated.reason, deactivatedBy = persistIdentityDeactivated.deactivatedBy where identityId == persistIdentityDeactivated.identityId
      }
      on persistIdentityReactivated: command PersistIdentityReactivated is {
        update IdentityData.identitys set reactivatedAt = persistIdentityReactivated.reactivatedAt, reactivatedBy = persistIdentityReactivated.reactivatedBy where identityId == persistIdentityReactivated.identityId
      }
      on persistIdentitySuspended: command PersistIdentitySuspended is {
        update IdentityData.identitys set suspendedAt = persistIdentitySuspended.suspendedAt, reason = persistIdentitySuspended.reason, suspendedBy = persistIdentitySuspended.suspendedBy where identityId == persistIdentitySuspended.identityId
      }
      on persistIdentityVerified: command PersistIdentityVerified is {
        update IdentityData.identitys set verificationMethod = persistIdentityVerified.verificationMethod, verifiedAt = persistIdentityVerified.verifiedAt where identityId == persistIdentityVerified.identityId
      }
      on persistAuthenticationFailed: command PersistAuthenticationFailed is {
        update IdentityData.identitys set credentialType = persistAuthenticationFailed.credentialType, failureReason = persistAuthenticationFailed.failureReason, attemptedAt = persistAuthenticationFailed.attemptedAt, ipAddress = persistAuthenticationFailed.ipAddress where identityId == persistAuthenticationFailed.identityId
      }
      on persistAuthenticationSucceeded: command PersistAuthenticationSucceeded is {
        update IdentityData.identitys set credentialType = persistAuthenticationSucceeded.credentialType, sessionId = persistAuthenticationSucceeded.sessionId, authenticatedAt = persistAuthenticationSucceeded.authenticatedAt, ipAddress = persistAuthenticationSucceeded.ipAddress where identityId == persistAuthenticationSucceeded.identityId
      }
      on persistSessionCreated: command PersistSessionCreated is {
        update IdentityData.identitys set sessionId = persistSessionCreated.sessionId, createdAt = persistSessionCreated.createdAt, expiresAt = persistSessionCreated.expiresAt where identityId == persistSessionCreated.identityId
      }
      on persistSessionRevoked: command PersistSessionRevoked is {
        update IdentityData.identitys set sessionId = persistSessionRevoked.sessionId, revokedAt = persistSessionRevoked.revokedAt, reason = persistSessionRevoked.reason where identityId == persistSessionRevoked.identityId
      }
      on query GetAuthenticationAttempt is {
        let authenticationAttemptView: type AuthenticationAttemptView = prompt("read the authentication attempt projection")
        reply authenticationAttemptView
      }
      on query GetMetricsSummary is {
        let metricsSummaryView: type MetricsSummaryView = prompt("read the metrics summary projection")
        reply metricsSummaryView
      }
      on query GetFailureAnalysis is {
        let failureAnalysisView: type FailureAnalysisView = prompt("read the failure analysis projection")
        reply failureAnalysisView
      }
      on command StoreIdentity is {
        do "store identity"
      }
      on command StoreSession is {
        do "store session"
      }
      on command DeleteSession is {
        do "delete session"
      }
      on query GetIdentityById is {
        let identityResult: type IdentityResult = prompt("read the identity from the store")
        reply identityResult
      }
      on query GetIdentityByEmail is {
        let identityResult: type IdentityResult = prompt("read the identity from the store")
        reply identityResult
      }
      on query SearchIdentities is {
        let identityListResult: type IdentityListResult = prompt("read the identity list that identities asks for")
        reply identityListResult
      }
      on query GetActiveSessions is {
        let sessionListResult: type SessionListResult = prompt("read the session list that active sessions asks for")
        reply sessionListResult
      }
    } with {
      briefly "Repository command and query handler"
      described as {
        |Handles persistence operations for identity data.
      }
    }
  } with {
    briefly "Identity persistence repository"
    described as {
      | Repository for persisting and querying identity data. Provides
      | storage operations for identities, credentials, and sessions.
      | Supports various query patterns for identity lookup and search.
    }
  }
  query GetAuthenticationAttempt replies result AuthenticationAttemptView is {
    authenticationAttemptKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which authentication attempt to retrieve.
      }
    }
  } with {
    briefly "Get authentication attempt"
    described as {
      |Retrieves the authentication attempt projection.
    }
  }
  result AuthenticationAttemptView is {
    authenticationAttempt: AuthenticationMetrics.AuthenticationAttempt with {
      briefly "Authentication attempt"
      described as {
        |The authentication attempt being returned.
      }
    }
  } with {
    briefly "Authentication attempt view"
    described as {
      |Read model view carrying the authentication attempt projection.
    }
  }
  query GetMetricsSummary replies result MetricsSummaryView is {
    metricsSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which metrics summary to retrieve.
      }
    }
  } with {
    briefly "Get metrics summary"
    described as {
      |Retrieves the metrics summary projection.
    }
  }
  result MetricsSummaryView is {
    metricsSummary: AuthenticationMetrics.MetricsSummary with {
      briefly "Metrics summary"
      described as {
        |The metrics summary being returned.
      }
    }
  } with {
    briefly "Metrics summary view"
    described as {
      |Read model view carrying the metrics summary projection.
    }
  }
  query GetFailureAnalysis replies result FailureAnalysisView is {
    failureAnalysisKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which failure analysis to retrieve.
      }
    }
  } with {
    briefly "Get failure analysis"
    described as {
      |Retrieves the failure analysis projection.
    }
  }
  result FailureAnalysisView is {
    failureAnalysis: AuthenticationMetrics.FailureAnalysis with {
      briefly "Failure analysis"
      described as {
        |The failure analysis being returned.
      }
    }
  } with {
    briefly "Failure analysis view"
    described as {
      |Read model view carrying the failure analysis projection.
    }
  }
  projector AuthenticationMetrics as flow is {
    updates repository IdentityContext.IdentityRepository
    outlet AuthenticationMetricsToRepository is type IdentityRepositoryCommand
    inlet AuthenticationMetricsFromIdentity is type IdentityEvent    // Record types for metrics
    record AuthenticationAttempt is {
      identityId: IdentityId
      credentialType: CredentialType
      success: Boolean
      attemptedAt: DateTime
      ipAddress: String
    } with {
      briefly "Single authentication attempt record"
      described as {
        |Records details of one authentication attempt for metrics.
      }
    }
    record MetricsSummary is {
      totalAttempts: Integer
      successfulAttempts: Integer
      failedAttempts: Integer
      uniqueIdentities: Integer
      periodStart: DateTime
      periodEnd: DateTime
    } with {
      briefly "Aggregated authentication metrics"
      described as {
        |Summary statistics for authentication activity.
      }
    }
    record FailureAnalysis is {
      failureReason: String
      count: Integer
      percentage: Number
    } with {
      briefly "Failure reason breakdown"
      described as {
        |Analysis of authentication failures by reason.
      }
    }
    handler MetricsHandler is {
      on credentialAdded: event Identity.CredentialAdded is {
        tell command IdentityContext.IdentityRepository.PersistCredentialAdded(identityId = credentialAdded.identityId, credentialId = credentialAdded.credentialId, credentialType = credentialAdded.credentialType, addedAt = credentialAdded.addedAt) to repository IdentityContext.IdentityRepository
        do "apply CredentialAdded to the AuthenticationMetrics projection"
      }
      on identityCreated: event Identity.IdentityCreated is {
        tell command IdentityContext.IdentityRepository.PersistIdentityCreated(identityId = identityCreated.identityId, email = identityCreated.email, displayName = identityCreated.displayName, createdAt = identityCreated.createdAt) to repository IdentityContext.IdentityRepository
        do "apply IdentityCreated to the AuthenticationMetrics projection"
      }
      on identityDeactivated: event Identity.IdentityDeactivated is {
        tell command IdentityContext.IdentityRepository.PersistIdentityDeactivated(identityId = identityDeactivated.identityId, deactivatedAt = identityDeactivated.deactivatedAt, reason = identityDeactivated.reason, deactivatedBy = identityDeactivated.deactivatedBy) to repository IdentityContext.IdentityRepository
        do "apply IdentityDeactivated to the AuthenticationMetrics projection"
      }
      on identityReactivated: event Identity.IdentityReactivated is {
        tell command IdentityContext.IdentityRepository.PersistIdentityReactivated(identityId = identityReactivated.identityId, reactivatedAt = identityReactivated.reactivatedAt, reactivatedBy = identityReactivated.reactivatedBy) to repository IdentityContext.IdentityRepository
        do "apply IdentityReactivated to the AuthenticationMetrics projection"
      }
      on identitySuspended: event Identity.IdentitySuspended is {
        tell command IdentityContext.IdentityRepository.PersistIdentitySuspended(identityId = identitySuspended.identityId, suspendedAt = identitySuspended.suspendedAt, reason = identitySuspended.reason, suspendedBy = identitySuspended.suspendedBy) to repository IdentityContext.IdentityRepository
        do "apply IdentitySuspended to the AuthenticationMetrics projection"
      }
      on identityVerified: event Identity.IdentityVerified is {
        tell command IdentityContext.IdentityRepository.PersistIdentityVerified(identityId = identityVerified.identityId, verificationMethod = identityVerified.verificationMethod, verifiedAt = identityVerified.verifiedAt) to repository IdentityContext.IdentityRepository
        do "apply IdentityVerified to the AuthenticationMetrics projection"
      }
      on authenticationSucceeded: event Identity.AuthenticationSucceeded is {
        tell command IdentityContext.IdentityRepository.PersistAuthenticationSucceeded(identityId = authenticationSucceeded.identityId, credentialType = authenticationSucceeded.credentialType, sessionId = authenticationSucceeded.sessionId, authenticatedAt = authenticationSucceeded.authenticatedAt, ipAddress = authenticationSucceeded.ipAddress) to repository IdentityContext.IdentityRepository
      }
      on authenticationFailed: event Identity.AuthenticationFailed is {
        tell command IdentityContext.IdentityRepository.PersistAuthenticationFailed(identityId = authenticationFailed.identityId, credentialType = authenticationFailed.credentialType, failureReason = authenticationFailed.failureReason, attemptedAt = authenticationFailed.attemptedAt, ipAddress = authenticationFailed.ipAddress) to repository IdentityContext.IdentityRepository
      }
      on sessionCreated: event Identity.SessionCreated is {
        tell command IdentityContext.IdentityRepository.PersistSessionCreated(sessionId = sessionCreated.sessionId, identityId = sessionCreated.identityId, createdAt = sessionCreated.createdAt, expiresAt = sessionCreated.expiresAt) to repository IdentityContext.IdentityRepository
      }
      on sessionRevoked: event Identity.SessionRevoked is {
        tell command IdentityContext.IdentityRepository.PersistSessionRevoked(sessionId = sessionRevoked.sessionId, identityId = sessionRevoked.identityId, revokedAt = sessionRevoked.revokedAt, reason = sessionRevoked.reason) to repository IdentityContext.IdentityRepository
      }
    } with {
      briefly "Metrics event handler"
      described as {
        |Processes authentication events to build metrics views.
      }
    }
  } with {
    briefly "Authentication metrics projector"
    described as {
      | Projector that builds read-optimized views of authentication metrics.
      | Tracks authentication attempts, success rates, failure reasons, and
      | session activity for security monitoring and analytics.
    }
  }
  // ---- Event publication for Identity ----
  type IdentityEvent is one of {
    IdentityContext.Identity.IdentityCreated or IdentityContext.Identity.IdentityVerified or IdentityContext.Identity.CredentialAdded or IdentityContext.Identity.AuthenticationSucceeded or IdentityContext.Identity.AuthenticationFailed or IdentityContext.Identity.SessionCreated or IdentityContext.Identity.SessionRevoked or IdentityContext.Identity.IdentityDeactivated or IdentityContext.Identity.IdentitySuspended or IdentityContext.Identity.IdentityReactivated
  } with {
    briefly "Identity event alternation"
    described as {
      |Union of all Identity events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet IdentityEventSplit as flow is {
    inlet IdentityEventSplitIn is type IdentityEvent    outlet IdentityEventSplitToAuthenticationMetrics is type IdentityEvent
    handler IdentityEventSplitHandler is {
      on identityCreated: event Identity.IdentityCreated is {
        send identityCreated to outlet IdentityEventSplitToAuthenticationMetrics
        tell identityCreated to entity IdentityContext.Identity
      }
      on identityVerified: event Identity.IdentityVerified is {
        send identityVerified to outlet IdentityEventSplitToAuthenticationMetrics
        tell identityVerified to entity IdentityContext.Identity
      }
      on credentialAdded: event Identity.CredentialAdded is {
        send credentialAdded to outlet IdentityEventSplitToAuthenticationMetrics
        tell credentialAdded to entity IdentityContext.Identity
      }
      on authenticationSucceeded: event Identity.AuthenticationSucceeded is {
        send authenticationSucceeded to outlet IdentityEventSplitToAuthenticationMetrics
        tell authenticationSucceeded to entity IdentityContext.Identity
      }
      on authenticationFailed: event Identity.AuthenticationFailed is {
        send authenticationFailed to outlet IdentityEventSplitToAuthenticationMetrics
        tell authenticationFailed to entity IdentityContext.Identity
      }
      on sessionCreated: event Identity.SessionCreated is {
        send sessionCreated to outlet IdentityEventSplitToAuthenticationMetrics
        tell sessionCreated to entity IdentityContext.Identity
      }
      on sessionRevoked: event Identity.SessionRevoked is {
        send sessionRevoked to outlet IdentityEventSplitToAuthenticationMetrics
        tell sessionRevoked to entity IdentityContext.Identity
      }
      on identityDeactivated: event Identity.IdentityDeactivated is {
        send identityDeactivated to outlet IdentityEventSplitToAuthenticationMetrics
        tell identityDeactivated to entity IdentityContext.Identity by identityId
      }
      on identitySuspended: event Identity.IdentitySuspended is {
        send identitySuspended to outlet IdentityEventSplitToAuthenticationMetrics
        tell identitySuspended to entity IdentityContext.Identity by identityId
      }
      on identityReactivated: event Identity.IdentityReactivated is {
        send identityReactivated to outlet IdentityEventSplitToAuthenticationMetrics
        tell identityReactivated to entity IdentityContext.Identity by identityId
      }
      on other is {
        error "Unexpected message for processor IdentityEventSplit"
      }
    } with {
      briefly "Identity event fan-out handler"
      described as {
        |Delivers each Identity event to all of its consumers.
      }
    }
  } with {
    briefly "Identity event fan-out"
    described as {
      |Fans Identity events out to the repository and projectors.
    }
  }
  connector 'IdentityEvent Stream' is from outlet IdentityContext.Identity.IdentityEvents2 to inlet IdentityContext.IdentityEventSplit.IdentityEventSplitIn with {
    briefly "Identity events, fanned out to storage and read models"
  }
  connector 'AuthenticationMetrics Feed' is from outlet IdentityContext.IdentityEventSplit.IdentityEventSplitToAuthenticationMetrics to inlet IdentityContext.AuthenticationMetrics.AuthenticationMetricsFromIdentity with {
    briefly "Identity events feeding the AuthenticationMetrics projection"
  }
  connector 'AuthenticationMetrics Storage' is from outlet IdentityContext.AuthenticationMetrics.AuthenticationMetricsToRepository to inlet IdentityContext.IdentityRepository.IdentityRepositoryFromAuthenticationMetrics with {
    briefly "AuthenticationMetrics updates on their way to storage"
  }
} with {
  briefly "Identity Management bounded context"
  described as {
    | The IdentityContext is the bounded context for identity management
    | within the platform. It encapsulates all identity-related functionality
    | including user registration, authentication, session management, and
    | access control. This context integrates with external systems for
    | directory services, multi-factor authentication, and audit logging.
  }
}
