// Identity Management bounded context
context IdentityContext is {
  adaptor FromAuditService from context AuditService is { 
    handler FromAuditServiceHandler is {
      on event AuditService.AuditEntryRecorded is {
        do "the model receives audit entry recorded"
      }
      on event AuditService.SecurityAlertTriggered is {
        do "the model receives security alert triggered"
      }
      on other is {
        error "Unexpected message for adaptor FromAuditService"
      }
    } with {
      briefly "from audit service"
      described as {
        |Carries messages from the external AuditService.
      }
    }
  } with {
    briefly "AuditService integration"
    described as {
      |The model's side of the AuditService conversation.
    }
  }
  adaptor FromDirectoryService from context DirectoryService is { 
    handler FromDirectoryServiceHandler is {
      on event DirectoryService.GroupMembershipChanged is {
        do "the model receives group membership changed"
      }
      on event DirectoryService.UserRemoved is {
        do "the model receives user removed"
      }
      on event DirectoryService.UserSynchronized is {
        do "the model receives user synchronized"
      }
      on other is {
        error "Unexpected message for adaptor FromDirectoryService"
      }
    } with {
      briefly "from directory service"
      described as {
        |Carries messages from the external DirectoryService.
      }
    }
  } with {
    briefly "DirectoryService integration"
    described as {
      |The model's side of the DirectoryService conversation.
    }
  }
  adaptor FromMFAProvider from context MFAProvider is { 
    handler FromMFAProviderHandler is {
      on event MFAProvider.MFAChallengeIssued is {
        do "the model receives mfa challenge issued"
      }
      on event MFAProvider.MFAVerificationFailed is {
        do "the model receives mfa verification failed"
      }
      on event MFAProvider.MFAVerificationSucceeded is {
        do "the model receives mfa verification succeeded"
      }
      on other is {
        error "Unexpected message for adaptor FromMFAProvider"
      }
    } with {
      briefly "from mfa provider"
      described as {
        |Carries messages from the external MFAProvider.
      }
    }
  } with {
    briefly "MFAProvider integration"
    described as {
      |The model's side of the MFAProvider conversation.
    }
  }
  include "types.riddl"
  include "Identity.riddl"
  repository IdentityRepository as merge is {
    record StoredIdentity is  {
      identityId: IdentityId with {
        briefly "identityId"
        described as {
          |The identityId column of the stored identity row.
        }
      }
    } with {
      briefly "Stored identity row"
      described as {
        |The persistence shape of identity data as this repository stores it.
      }
    }
    schema IdentityData is relational
      of identitys as type StoredIdentity
 with {
      briefly "Identity data schema"
      described as {
        |The relational schema persisting identity records for this repository.
      }
    }
    inlet IdentityRepositoryFromIdentity is type IdentityEvent    inlet IdentityRepositoryFromAuthenticationMetrics is type IdentityEvent    outlet IdentityRepositoryResponses is type Identity.IdentityQueryResult
    // Query types
    type IdentityQuery is {
      filterEmail: EmailAddress?
      filterStatus: IdentityStatus?
      createdAfter: DateTime?
      createdBefore: DateTime?
    } with {
      briefly "Query parameters for identity search"
      described as {
        |Defines filter criteria for searching identities.
      }
    }
    type SessionQuery is {
      updatedIdentityId: IdentityId?
      updatedIsActive: Boolean?
      createdAfter: DateTime?
    } with {
      briefly "Query parameters for session search"
      described as {
        |Defines filter criteria for searching sessions.
      }
    }
    // Commands
    command StoreIdentity is  {
      identity: UserIdentity
      credentials: Credential+
    } with {
      briefly "Store or update an identity"
      described as {
        |Persists an identity record with its credentials.
      }
    }
    command StoreSession is  { session: SessionInfo } with {
      briefly "Store a session record"
      described as {
        |Persists a session record.
      }
    }
    command DeleteSession is  { sessionId: SessionId } with {
      briefly "Delete a session record"
      described as {
        |Removes a session record from storage.
      }
    }
    // Queries
    query GetIdentityById is  { identityId: IdentityId } with {
      briefly "Retrieve identity by ID"
      described as {
        |Fetches a single identity by its unique identifier.
      }
    }
    query GetIdentityByEmail is  { email: EmailAddress } with {
      briefly "Retrieve identity by email"
      described as {
        |Fetches a single identity by email address.
      }
    }
    query SearchIdentities is  {
      query: IdentityQuery
      limit: Integer
      offset: Integer
    } with {
      briefly "Search identities with filters"
      described as {
        |Searches identities matching the specified criteria.
      }
    }
    query GetActiveSessions is  { identityId: IdentityId } with {
      briefly "Get active sessions for identity"
      described as {
        |Retrieves all active sessions for a given identity.
      }
    }
    // Results
    result IdentityResult is  {
      updatedIdentity: UserIdentity?
      credentials: Credential+
    } with {
      briefly "Single identity query result"
      described as {
        |Returns an identity with its credentials if found.
      }
    }
    result IdentityListResult is  {
      identities: UserIdentity+
      totalCount: Integer
    } with {
      briefly "Identity search result"
      described as {
        |Returns a paginated list of identities.
      }
    }
    result SessionListResult is  { sessions: SessionInfo+ } with {
      briefly "Session query result"
      described as {
        |Returns a list of sessions.
      }
    }
    handler RepositoryHandler is {
      on query GetAuthenticationAttempt is {
        let authenticationAttemptView: type AuthenticationAttemptView = prompt("read the authentication attempt projection")
        reply authenticationAttemptView
      }
      on query GetMetricsSummary is {
        let metricsSummaryView: type MetricsSummaryView = prompt("read the metrics summary projection")
        reply metricsSummaryView
      }
      on query GetFailureAnalysis is {
        let failureAnalysisView: type FailureAnalysisView = prompt("read the failure analysis projection")
        reply failureAnalysisView
      }
      on command StoreIdentity is {
        do "store identity"
      }
      on command StoreSession is {
        do "store session"
      }
      on command DeleteSession is {
        do "delete session"
      }
      on query GetIdentityById is {
        reply result IdentityResult
      }
      on query GetIdentityByEmail is {
        reply result IdentityResult
      }
      on query SearchIdentities is {
        reply result IdentityListResult
      }
      on query GetActiveSessions is {
        reply result SessionListResult
      }
    } with {
      briefly "Repository command and query handler"
      described as {
        |Handles persistence operations for identity data.
      }
    }
  } with {
    briefly "Identity persistence repository"
    described as {
      | Repository for persisting and querying identity data. Provides
      | storage operations for identities, credentials, and sessions.
      | Supports various query patterns for identity lookup and search.
    }
  }
  query GetAuthenticationAttempt is  {
    authenticationAttemptKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which authentication attempt to retrieve.
      }
    }
  } with {
    briefly "Get authentication attempt"
    described as {
      |Retrieves the authentication attempt projection.
    }
  }
  result AuthenticationAttemptView is  {
    authenticationAttempt: AuthenticationMetrics.AuthenticationAttempt with {
      briefly "Authentication attempt"
      described as {
        |The authentication attempt being returned.
      }
    }
  } with {
    briefly "Authentication attempt view"
    described as {
      |Read model view carrying the authentication attempt projection.
    }
  }
  query GetMetricsSummary is  {
    metricsSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which metrics summary to retrieve.
      }
    }
  } with {
    briefly "Get metrics summary"
    described as {
      |Retrieves the metrics summary projection.
    }
  }
  result MetricsSummaryView is  {
    metricsSummary: AuthenticationMetrics.MetricsSummary with {
      briefly "Metrics summary"
      described as {
        |The metrics summary being returned.
      }
    }
  } with {
    briefly "Metrics summary view"
    described as {
      |Read model view carrying the metrics summary projection.
    }
  }
  query GetFailureAnalysis is  {
    failureAnalysisKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which failure analysis to retrieve.
      }
    }
  } with {
    briefly "Get failure analysis"
    described as {
      |Retrieves the failure analysis projection.
    }
  }
  result FailureAnalysisView is  {
    failureAnalysis: AuthenticationMetrics.FailureAnalysis with {
      briefly "Failure analysis"
      described as {
        |The failure analysis being returned.
      }
    }
  } with {
    briefly "Failure analysis view"
    described as {
      |Read model view carrying the failure analysis projection.
    }
  }
  projector AuthenticationMetrics as flow is {
    updates repository IdentityContext.IdentityRepository
    inlet AuthenticationMetricsFromIdentity is type IdentityEvent    outlet AuthenticationMetricsOut is type IdentityEvent
    // Record types for metrics
    record AuthenticationAttempt is  {
      identityId: IdentityId
      credentialType: CredentialType
      success: Boolean
      attemptedAt: DateTime
      ipAddress: String
    } with {
      briefly "Single authentication attempt record"
      described as {
        |Records details of one authentication attempt for metrics.
      }
    }
    record MetricsSummary is  {
      totalAttempts: Integer
      successfulAttempts: Integer
      failedAttempts: Integer
      uniqueIdentities: Integer
      periodStart: DateTime
      periodEnd: DateTime
    } with {
      briefly "Aggregated authentication metrics"
      described as {
        |Summary statistics for authentication activity.
      }
    }
    record FailureAnalysis is  {
      failureReason: String
      count: Integer
      percentage: Number
    } with {
      briefly "Failure reason breakdown"
      described as {
        |Analysis of authentication failures by reason.
      }
    }
    handler MetricsHandler is {
      on authenticationSucceeded: event Identity.AuthenticationSucceeded is {
        tell authenticationSucceeded to repository IdentityContext.IdentityRepository
      }
      on authenticationFailed: event Identity.AuthenticationFailed is {
        tell authenticationFailed to repository IdentityContext.IdentityRepository
      }
      on sessionCreated: event Identity.SessionCreated is {
        tell sessionCreated to repository IdentityContext.IdentityRepository
      }
      on sessionRevoked: event Identity.SessionRevoked is {
        tell sessionRevoked to repository IdentityContext.IdentityRepository
      }
    } with {
      briefly "Metrics event handler"
      described as {
        |Processes authentication events to build metrics views.
      }
    }
  } with {
    briefly "Authentication metrics projector"
    described as {
      | Projector that builds read-optimized views of authentication metrics.
      | Tracks authentication attempts, success rates, failure reasons, and
      | session activity for security monitoring and analytics.
    }
  }
  // ---- Event publication for Identity ----
  type IdentityEvent is one of {
    IdentityContext.Identity.IdentityCreated or IdentityContext.Identity.IdentityVerified or IdentityContext.Identity.CredentialAdded or IdentityContext.Identity.AuthenticationSucceeded or IdentityContext.Identity.AuthenticationFailed or IdentityContext.Identity.SessionCreated or IdentityContext.Identity.SessionRevoked or IdentityContext.Identity.IdentityDeactivated or IdentityContext.Identity.IdentitySuspended or IdentityContext.Identity.IdentityReactivated
  } with {
    briefly "Identity event alternation"
    described as {
      |Union of all Identity events, for streaming and event-sourced
      |persistence.
    }
  }
  processor IdentityEventSource as source is {
    outlet IdentityEvents is type IdentityEvent
    handler IdentitySourceHandler is {
      on identityCreated: event Identity.IdentityCreated is {
        send identityCreated to outlet IdentityEvents
      }
      on identityVerified: event Identity.IdentityVerified is {
        send identityVerified to outlet IdentityEvents
      }
      on credentialAdded: event Identity.CredentialAdded is {
        send credentialAdded to outlet IdentityEvents
      }
      on authenticationSucceeded: event Identity.AuthenticationSucceeded is {
        send authenticationSucceeded to outlet IdentityEvents
      }
      on authenticationFailed: event Identity.AuthenticationFailed is {
        send authenticationFailed to outlet IdentityEvents
      }
      on sessionCreated: event Identity.SessionCreated is {
        send sessionCreated to outlet IdentityEvents
      }
      on sessionRevoked: event Identity.SessionRevoked is {
        send sessionRevoked to outlet IdentityEvents
      }
      on identityDeactivated: event Identity.IdentityDeactivated is {
        send identityDeactivated to outlet IdentityEvents
      }
      on identitySuspended: event Identity.IdentitySuspended is {
        send identitySuspended to outlet IdentityEvents
      }
      on identityReactivated: event Identity.IdentityReactivated is {
        send identityReactivated to outlet IdentityEvents
      }
      on other is {
        error "Unexpected message for source IdentityEventSource"
      }
    } with {
      briefly "Identity source handler"
      described as {
        |Publishes Identity events onto the outlet.
      }
    }
  } with {
    briefly "Identity event source"
    described as {
      |Publishes Identity entity events into the streaming topology.
    }
  }
  processor IdentityEventSink as sink is {
    inlet IdentityInlet is type IdentityEvent    handler IdentitySinkHandler is {
      on identityCreated: event Identity.IdentityCreated is {
        tell identityCreated to repository IdentityContext.IdentityRepository
      }
      on identityVerified: event Identity.IdentityVerified is {
        tell identityVerified to repository IdentityContext.IdentityRepository
      }
      on credentialAdded: event Identity.CredentialAdded is {
        tell credentialAdded to repository IdentityContext.IdentityRepository
      }
      on authenticationSucceeded: event Identity.AuthenticationSucceeded is {
        tell authenticationSucceeded to repository IdentityContext.IdentityRepository
      }
      on authenticationFailed: event Identity.AuthenticationFailed is {
        tell authenticationFailed to repository IdentityContext.IdentityRepository
      }
      on sessionCreated: event Identity.SessionCreated is {
        tell sessionCreated to repository IdentityContext.IdentityRepository
      }
      on sessionRevoked: event Identity.SessionRevoked is {
        tell sessionRevoked to repository IdentityContext.IdentityRepository
      }
      on identityDeactivated: event Identity.IdentityDeactivated is {
        tell identityDeactivated to repository IdentityContext.IdentityRepository
      }
      on identitySuspended: event Identity.IdentitySuspended is {
        tell identitySuspended to repository IdentityContext.IdentityRepository
      }
      on identityReactivated: event Identity.IdentityReactivated is {
        tell identityReactivated to repository IdentityContext.IdentityRepository
      }
      on other is {
        error "Unexpected message for sink IdentityEventSink"
      }
    } with {
      briefly "Identity sink handler"
      described as {
        |Persists Identity events via the repository.
      }
    }
  } with {
    briefly "Identity event sink"
    described as {
      |Receives Identity events for persistence.
    }
  }
  connector IdentityEventFlow is from outlet IdentityContext.IdentityEventSource.IdentityEvents to inlet IdentityContext.IdentityEventSink.IdentityInlet with {
    briefly "Identity event flow"
    described as {
      |Connects the Identity source to its sink.
    }
  }
  processor IdentityEventSplit as split is {
    inlet IdentityEventSplitIn is type IdentityEvent    outlet IdentityEventSplitToIdentityRepository is type IdentityEvent
    outlet IdentityEventSplitToAuthenticationMetrics is type IdentityEvent
    handler IdentityEventSplitHandler is {
      on identityCreated: event Identity.IdentityCreated is {
        send identityCreated to outlet IdentityEventSplitToIdentityRepository
        send identityCreated to outlet IdentityEventSplitToAuthenticationMetrics
        tell identityCreated to entity IdentityContext.Identity
      }
      on identityVerified: event Identity.IdentityVerified is {
        send identityVerified to outlet IdentityEventSplitToIdentityRepository
        send identityVerified to outlet IdentityEventSplitToAuthenticationMetrics
        tell identityVerified to entity IdentityContext.Identity
      }
      on credentialAdded: event Identity.CredentialAdded is {
        send credentialAdded to outlet IdentityEventSplitToIdentityRepository
        send credentialAdded to outlet IdentityEventSplitToAuthenticationMetrics
        tell credentialAdded to entity IdentityContext.Identity
      }
      on authenticationSucceeded: event Identity.AuthenticationSucceeded is {
        send authenticationSucceeded to outlet IdentityEventSplitToIdentityRepository
        send authenticationSucceeded to outlet IdentityEventSplitToAuthenticationMetrics
        tell authenticationSucceeded to entity IdentityContext.Identity
      }
      on authenticationFailed: event Identity.AuthenticationFailed is {
        send authenticationFailed to outlet IdentityEventSplitToIdentityRepository
        send authenticationFailed to outlet IdentityEventSplitToAuthenticationMetrics
        tell authenticationFailed to entity IdentityContext.Identity
      }
      on sessionCreated: event Identity.SessionCreated is {
        send sessionCreated to outlet IdentityEventSplitToIdentityRepository
        send sessionCreated to outlet IdentityEventSplitToAuthenticationMetrics
        tell sessionCreated to entity IdentityContext.Identity
      }
      on sessionRevoked: event Identity.SessionRevoked is {
        send sessionRevoked to outlet IdentityEventSplitToIdentityRepository
        send sessionRevoked to outlet IdentityEventSplitToAuthenticationMetrics
        tell sessionRevoked to entity IdentityContext.Identity
      }
      on identityDeactivated: event Identity.IdentityDeactivated is {
        send identityDeactivated to outlet IdentityEventSplitToIdentityRepository
        send identityDeactivated to outlet IdentityEventSplitToAuthenticationMetrics
        tell identityDeactivated to entity IdentityContext.Identity by identityId
      }
      on identitySuspended: event Identity.IdentitySuspended is {
        send identitySuspended to outlet IdentityEventSplitToIdentityRepository
        send identitySuspended to outlet IdentityEventSplitToAuthenticationMetrics
        tell identitySuspended to entity IdentityContext.Identity by identityId
      }
      on identityReactivated: event Identity.IdentityReactivated is {
        send identityReactivated to outlet IdentityEventSplitToIdentityRepository
        send identityReactivated to outlet IdentityEventSplitToAuthenticationMetrics
        tell identityReactivated to entity IdentityContext.Identity by identityId
      }
      on other is {
        error "Unexpected message for processor IdentityEventSplit"
      }
    } with {
      briefly "Identity event fan-out handler"
      described as {
        |Delivers each Identity event to all of its consumers.
      }
    }
  } with {
    briefly "Identity event fan-out"
    described as {
      |Fans Identity events out to the repository and projectors.
    }
  }
  connector 'IdentityEvent Stream' is from outlet IdentityContext.Identity.IdentityEvents2 to inlet IdentityContext.IdentityEventSplit.IdentityEventSplitIn with {
    briefly "Identity events, fanned out to storage and read models"
  }
  connector 'IdentityEvent Storage' is from outlet IdentityContext.IdentityEventSplit.IdentityEventSplitToIdentityRepository to inlet IdentityContext.IdentityRepository.IdentityRepositoryFromIdentity with {
    briefly "Identity events on their way to storage"
  }
  connector 'AuthenticationMetrics Feed' is from outlet IdentityContext.IdentityEventSplit.IdentityEventSplitToAuthenticationMetrics to inlet IdentityContext.AuthenticationMetrics.AuthenticationMetricsFromIdentity with {
    briefly "Identity events feeding the AuthenticationMetrics projection"
  }
  connector 'AuthenticationMetrics Storage' is from outlet IdentityContext.AuthenticationMetrics.AuthenticationMetricsOut to inlet IdentityContext.IdentityRepository.IdentityRepositoryFromAuthenticationMetrics with {
    briefly "The AuthenticationMetrics projection on its way to storage"
  }
} with {
  briefly "Identity Management bounded context"
  described as {
    | The IdentityContext is the bounded context for identity management
    | within the platform. It encapsulates all identity-related functionality
    | including user registration, authentication, session management, and
    | access control. This context integrates with external systems for
    | directory services, multi-factor authentication, and audit logging.
  }
}
