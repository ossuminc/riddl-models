// Identity Management bounded context
context IdentityContext is {
  adaptor FromAuditService from context AuditService is {
    handler FromAuditServiceHandler is {
      on event AuditService.AuditEntryRecorded is {
        do "the model receives audit entry recorded"
      }
      on event AuditService.SecurityAlertTriggered is {
        do "the model receives security alert triggered"
      }
      on other is {
        error "Unexpected message for adaptor FromAuditService"
      }
    } with {
      briefly "from audit service"
      described as {
        |Carries messages from the external AuditService.
      }
    }
  } with {
      briefly "AuditService integration"
    described as {
      |The model's side of the AuditService conversation.
    }
  }
  adaptor FromDirectoryService from context DirectoryService is {
    handler FromDirectoryServiceHandler is {
      on event DirectoryService.GroupMembershipChanged is {
        do "the model receives group membership changed"
      }
      on event DirectoryService.UserRemoved is {
        do "the model receives user removed"
      }
      on event DirectoryService.UserSynchronized is {
        do "the model receives user synchronized"
      }
      on other is {
        error "Unexpected message for adaptor FromDirectoryService"
      }
    } with {
      briefly "from directory service"
      described as {
        |Carries messages from the external DirectoryService.
      }
    }
  } with {
      briefly "DirectoryService integration"
    described as {
      |The model's side of the DirectoryService conversation.
    }
  }
  adaptor FromMFAProvider from context MFAProvider is {
    handler FromMFAProviderHandler is {
      on event MFAProvider.MFAChallengeIssued is {
        do "the model receives mfa challenge issued"
      }
      on event MFAProvider.MFAVerificationFailed is {
        do "the model receives mfa verification failed"
      }
      on event MFAProvider.MFAVerificationSucceeded is {
        do "the model receives mfa verification succeeded"
      }
      on other is {
        error "Unexpected message for adaptor FromMFAProvider"
      }
    } with {
      briefly "from mfa provider"
      described as {
        |Carries messages from the external MFAProvider.
      }
    }
  } with {
      briefly "MFAProvider integration"
    described as {
      |The model's side of the MFAProvider conversation.
    }
  }
  include "types.riddl"
  include "Identity.riddl"
  repository IdentityRepository is {
    record StoredIdentity is {
      identityId: IdentityId with {
        briefly "identityId"
        described as {
          |The identityId column of the stored identity row.
        }
      }
    } with {
      briefly "Stored identity row"
      described as {
        |The persistence shape of identity data as this repository stores it.
      }
    }
    schema IdentityData is relational
      of identitys as type StoredIdentity
      with {
      briefly "Identity data schema"
      described as {
        |The relational schema persisting identity records for this repository.
      }
    }
    inlet IdentityRepositoryFromIdentity is type IdentityEvent
    inlet IdentityRepositoryFromAuthenticationMetrics is type IdentityEvent
    outlet IdentityRepositoryResponses is type Identity.IdentityQueryResult
    // Query types
    type IdentityQuery is {
      filterEmail: EmailAddress?
      filterStatus: IdentityStatus?
      createdAfter: DateTime?
      createdBefore: DateTime?
    } with {
      briefly "Query parameters for identity search"
      described as {
        |Defines filter criteria for searching identities.
      }
    }
    type SessionQuery is {
      updatedIdentityId: IdentityId?
      updatedIsActive: Boolean?
      createdAfter: DateTime?
    } with {
      briefly "Query parameters for session search"
      described as {
        |Defines filter criteria for searching sessions.
      }
    }
    // Commands
    command StoreIdentity is  {
      identity: UserIdentity
      credentials: Credential+
    } with {
      briefly "Store or update an identity"
      described as {
        |Persists an identity record with its credentials.
      }
    }
    command StoreSession is  { session: SessionInfo } with {
      briefly "Store a session record"
      described as {
        |Persists a session record.
      }
    }
    command DeleteSession is  { sessionId: SessionId } with {
      briefly "Delete a session record"
      described as {
        |Removes a session record from storage.
      }
    }
    // Queries
    query GetIdentityById is  { identityId: IdentityId } with {
      briefly "Retrieve identity by ID"
      described as {
        |Fetches a single identity by its unique identifier.
      }
    }
    query GetIdentityByEmail is  { email: EmailAddress } with {
      briefly "Retrieve identity by email"
      described as {
        |Fetches a single identity by email address.
      }
    }
    query SearchIdentities is  {
      query: IdentityQuery
      limit: Integer
      offset: Integer
    } with {
      briefly "Search identities with filters"
      described as {
        |Searches identities matching the specified criteria.
      }
    }
    query GetActiveSessions is  { identityId: IdentityId } with {
      briefly "Get active sessions for identity"
      described as {
        |Retrieves all active sessions for a given identity.
      }
    }
    // Results
    result IdentityResult is  {
      updatedIdentity: UserIdentity?
      credentials: Credential+
    } with {
      briefly "Single identity query result"
      described as {
        |Returns an identity with its credentials if found.
      }
    }
    result IdentityListResult is  {
      identities: UserIdentity+
      totalCount: Integer
    } with {
      briefly "Identity search result"
      described as {
        |Returns a paginated list of identities.
      }
    }
    result SessionListResult is  { sessions: SessionInfo+ } with {
      briefly "Session query result"
      described as {
        |Returns a list of sessions.
      }
    }
    handler RepositoryHandler is {
      on command StoreIdentity is {
        do "store identity"
      }
      on command StoreSession is {
        do "store session"
      }
      on command DeleteSession is {
        do "delete session"
      }
      on query GetIdentityById is {
        yield result IdentityResult
      }
      on query SearchIdentities is {
        yield result IdentityResult
      }
      on query GetActiveSessions is {
        yield result IdentityResult
      }
    } with {
      briefly "Repository command and query handler"
      described as {
        |Handles persistence operations for identity data.
      }
    }
  } with {
    briefly "Identity persistence repository"
    described as {
      | Repository for persisting and querying identity data. Provides
      | storage operations for identities, credentials, and sessions.
      | Supports various query patterns for identity lookup and search.
    }
  }
  projector AuthenticationMetrics is {
    inlet AuthenticationMetricsFromIdentity is type IdentityEvent
    outlet AuthenticationMetricsOut is type IdentityEvent
    updates repository IdentityContext.IdentityRepository
    // Record types for metrics
    record AuthenticationAttempt is  {
      identityId: IdentityId
      credentialType: CredentialType
      success: Boolean
      attemptedAt: DateTime
      ipAddress: String
    } with {
      briefly "Single authentication attempt record"
      described as {
        |Records details of one authentication attempt for metrics.
      }
    }
    record MetricsSummary is  {
      totalAttempts: Integer
      successfulAttempts: Integer
      failedAttempts: Integer
      uniqueIdentities: Integer
      periodStart: DateTime
      periodEnd: DateTime
    } with {
      briefly "Aggregated authentication metrics"
      described as {
        |Summary statistics for authentication activity.
      }
    }
    record FailureAnalysis is  {
      failureReason: String
      count: Integer
      percentage: Number
    } with {
      briefly "Failure reason breakdown"
      described as {
        |Analysis of authentication failures by reason.
      }
    }
    handler MetricsHandler is {
      on event Identity.AuthenticationSucceeded is {
        tell event Identity.AuthenticationSucceeded to repository IdentityContext.IdentityRepository
      }
      on event Identity.AuthenticationFailed is {
        tell event Identity.AuthenticationFailed to repository IdentityContext.IdentityRepository
      }
      on event Identity.SessionCreated is {
        tell event Identity.SessionCreated to repository IdentityContext.IdentityRepository
      }
      on event Identity.SessionRevoked is {
        tell event Identity.SessionRevoked to repository IdentityContext.IdentityRepository
      }
    } with {
      briefly "Metrics event handler"
      described as {
        |Processes authentication events to build metrics views.
      }
    }
  } with {
    briefly "Authentication metrics projector"
    described as {
      | Projector that builds read-optimized views of authentication metrics.
      | Tracks authentication attempts, success rates, failure reasons, and
      | session activity for security monitoring and analytics.
    }
  }
  // ---- Event publication for Identity ----
  type IdentityEvent is one of {
    IdentityContext.Identity.IdentityCreated,
    IdentityContext.Identity.IdentityVerified,
    IdentityContext.Identity.CredentialAdded,
    IdentityContext.Identity.AuthenticationSucceeded,
    IdentityContext.Identity.AuthenticationFailed,
    IdentityContext.Identity.SessionCreated,
    IdentityContext.Identity.SessionRevoked,
    IdentityContext.Identity.IdentityDeactivated,
    IdentityContext.Identity.IdentitySuspended,
    IdentityContext.Identity.IdentityReactivated
  } with {
    briefly "Identity event alternation"
    described as {
      |Union of all Identity events, for streaming and event-sourced
      |persistence.
    }
  }
  processor IdentityEventSource as source is {
    outlet IdentityEvents is type IdentityEvent
    handler IdentitySourceHandler is {
      on event Identity.IdentityCreated is {
        send event Identity.IdentityCreated to outlet IdentityEvents
      }
      on event Identity.IdentityVerified is {
        send event Identity.IdentityVerified to outlet IdentityEvents
      }
      on event Identity.CredentialAdded is {
        send event Identity.CredentialAdded to outlet IdentityEvents
      }
      on event Identity.AuthenticationSucceeded is {
        send event Identity.AuthenticationSucceeded to outlet IdentityEvents
      }
      on event Identity.AuthenticationFailed is {
        send event Identity.AuthenticationFailed to outlet IdentityEvents
      }
      on event Identity.SessionCreated is {
        send event Identity.SessionCreated to outlet IdentityEvents
      }
      on event Identity.SessionRevoked is {
        send event Identity.SessionRevoked to outlet IdentityEvents
      }
      on event Identity.IdentityDeactivated is {
        send event Identity.IdentityDeactivated to outlet IdentityEvents
      }
      on event Identity.IdentitySuspended is {
        send event Identity.IdentitySuspended to outlet IdentityEvents
      }
      on event Identity.IdentityReactivated is {
        send event Identity.IdentityReactivated to outlet IdentityEvents
      }
      on other is {
        error "Unexpected message for source IdentityEventSource"
      }
    } with {
      briefly "Identity source handler"
      described as {
        |Publishes Identity events onto the outlet.
      }
    }
  } with {
    briefly "Identity event source"
    described as {
      |Publishes Identity entity events into the streaming topology.
    }
  }
  processor IdentityEventSink as sink is {
    inlet IdentityInlet is type IdentityEvent
    handler IdentitySinkHandler is {
      on event Identity.IdentityCreated is {
        tell event Identity.IdentityCreated to repository IdentityContext.IdentityRepository
      }
      on event Identity.IdentityVerified is {
        tell event Identity.IdentityVerified to repository IdentityContext.IdentityRepository
      }
      on event Identity.CredentialAdded is {
        tell event Identity.CredentialAdded to repository IdentityContext.IdentityRepository
      }
      on event Identity.AuthenticationSucceeded is {
        tell event Identity.AuthenticationSucceeded to repository IdentityContext.IdentityRepository
      }
      on event Identity.AuthenticationFailed is {
        tell event Identity.AuthenticationFailed to repository IdentityContext.IdentityRepository
      }
      on event Identity.SessionCreated is {
        tell event Identity.SessionCreated to repository IdentityContext.IdentityRepository
      }
      on event Identity.SessionRevoked is {
        tell event Identity.SessionRevoked to repository IdentityContext.IdentityRepository
      }
      on event Identity.IdentityDeactivated is {
        tell event Identity.IdentityDeactivated to repository IdentityContext.IdentityRepository
      }
      on event Identity.IdentitySuspended is {
        tell event Identity.IdentitySuspended to repository IdentityContext.IdentityRepository
      }
      on event Identity.IdentityReactivated is {
        tell event Identity.IdentityReactivated to repository IdentityContext.IdentityRepository
      }
      on other is {
        error "Unexpected message for sink IdentityEventSink"
      }
    } with {
      briefly "Identity sink handler"
      described as {
        |Persists Identity events via the repository.
      }
    }
  } with {
    briefly "Identity event sink"
    described as {
      |Receives Identity events for persistence.
    }
  }
  connector IdentityEventFlow is {
    from outlet IdentityContext.IdentityEventSource.IdentityEvents to
      inlet IdentityContext.IdentityEventSink.IdentityInlet
  } with {
    briefly "Identity event flow"
    described as {
      |Connects the Identity source to its sink.
    }
  }
  processor IdentityEventSplit is {
    inlet IdentityEventSplitIn is type IdentityEvent
    outlet IdentityEventSplitToIdentityRepository is type IdentityEvent
    outlet IdentityEventSplitToAuthenticationMetrics is type IdentityEvent
    handler IdentityEventSplitHandler is {
      on event Identity.IdentityCreated is {
        send event Identity.IdentityCreated to outlet IdentityEventSplitToIdentityRepository
        send event Identity.IdentityCreated to outlet IdentityEventSplitToAuthenticationMetrics
        tell event Identity.IdentityCreated to entity IdentityContext.Identity
      }
      on event Identity.IdentityVerified is {
        send event Identity.IdentityVerified to outlet IdentityEventSplitToIdentityRepository
        send event Identity.IdentityVerified to outlet IdentityEventSplitToAuthenticationMetrics
        tell event Identity.IdentityVerified to entity IdentityContext.Identity
      }
      on event Identity.CredentialAdded is {
        send event Identity.CredentialAdded to outlet IdentityEventSplitToIdentityRepository
        send event Identity.CredentialAdded to outlet IdentityEventSplitToAuthenticationMetrics
        tell event Identity.CredentialAdded to entity IdentityContext.Identity
      }
      on event Identity.AuthenticationSucceeded is {
        send event Identity.AuthenticationSucceeded to outlet IdentityEventSplitToIdentityRepository
        send event Identity.AuthenticationSucceeded to outlet IdentityEventSplitToAuthenticationMetrics
        tell event Identity.AuthenticationSucceeded to entity IdentityContext.Identity
      }
      on event Identity.AuthenticationFailed is {
        send event Identity.AuthenticationFailed to outlet IdentityEventSplitToIdentityRepository
        send event Identity.AuthenticationFailed to outlet IdentityEventSplitToAuthenticationMetrics
        tell event Identity.AuthenticationFailed to entity IdentityContext.Identity
      }
      on event Identity.SessionCreated is {
        send event Identity.SessionCreated to outlet IdentityEventSplitToIdentityRepository
        send event Identity.SessionCreated to outlet IdentityEventSplitToAuthenticationMetrics
        tell event Identity.SessionCreated to entity IdentityContext.Identity
      }
      on event Identity.SessionRevoked is {
        send event Identity.SessionRevoked to outlet IdentityEventSplitToIdentityRepository
        send event Identity.SessionRevoked to outlet IdentityEventSplitToAuthenticationMetrics
        tell event Identity.SessionRevoked to entity IdentityContext.Identity
      }
      on event Identity.IdentityDeactivated is {
        send event Identity.IdentityDeactivated to outlet IdentityEventSplitToIdentityRepository
        send event Identity.IdentityDeactivated to outlet IdentityEventSplitToAuthenticationMetrics
        tell event Identity.IdentityDeactivated to entity IdentityContext.Identity
      }
      on event Identity.IdentitySuspended is {
        send event Identity.IdentitySuspended to outlet IdentityEventSplitToIdentityRepository
        send event Identity.IdentitySuspended to outlet IdentityEventSplitToAuthenticationMetrics
        tell event Identity.IdentitySuspended to entity IdentityContext.Identity
      }
      on event Identity.IdentityReactivated is {
        send event Identity.IdentityReactivated to outlet IdentityEventSplitToIdentityRepository
        send event Identity.IdentityReactivated to outlet IdentityEventSplitToAuthenticationMetrics
        tell event Identity.IdentityReactivated to entity IdentityContext.Identity
      }
      on other is {
        error "Unexpected message for processor IdentityEventSplit"
      }
    } with {
      briefly "Identity event fan-out handler"
      described as {
        |Delivers each Identity event to all of its consumers.
      }
    }
  } with {
    briefly "Identity event fan-out"
    described as {
      |Fans Identity events out to the repository and projectors.
    }
  }
  connector LinkIdentityToIdentityEventSplit is {
    from outlet IdentityContext.Identity.IdentityEvents2 to
      inlet IdentityContext.IdentityEventSplit.IdentityEventSplitIn
  } with {
    briefly "LinkIdentityToIdentityEventSplit"
  }
  connector LinkIdentityEventSplitToIdentityRepository is {
    from outlet IdentityContext.IdentityEventSplit.IdentityEventSplitToIdentityRepository to
      inlet IdentityContext.IdentityRepository.IdentityRepositoryFromIdentity
  } with {
    briefly "LinkIdentityEventSplitToIdentityRepository"
  }
  connector LinkIdentityEventSplitToAuthenticationMetrics is {
    from outlet IdentityContext.IdentityEventSplit.IdentityEventSplitToAuthenticationMetrics to
      inlet IdentityContext.AuthenticationMetrics.AuthenticationMetricsFromIdentity
  } with {
    briefly "LinkIdentityEventSplitToAuthenticationMetrics"
  }
  connector LinkAuthenticationMetricsToIdentityRepository is {
    from outlet IdentityContext.AuthenticationMetrics.AuthenticationMetricsOut to
      inlet IdentityContext.IdentityRepository.IdentityRepositoryFromAuthenticationMetrics
  } with {
    briefly "LinkAuthenticationMetricsToIdentityRepository"
  }
} with {
  briefly "Identity Management bounded context"
  described as {
    | The IdentityContext is the bounded context for identity management
    | within the platform. It encapsulates all identity-related functionality
    | including user registration, authentication, session management, and
    | access control. This context integrates with external systems for
    | directory services, multi-factor authentication, and audit logging.
  }
}
