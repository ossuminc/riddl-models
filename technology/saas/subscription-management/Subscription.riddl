// Subscription Management - Subscription Entity
entity Subscription as router is {
  type SubscriptionCommand is one of {
    Subscription.ConvertTrial or Subscription.ChangePlan or Subscription.ApplyDiscount or Subscription.RecordPayment or Subscription.RecordPaymentFailure or Subscription.SuspendSubscription or Subscription.ReactivateSubscription or Subscription.CancelSubscription or Subscription.RenewSubscription
  } with {
    briefly "Subscription command alternation"
    described as {
      |Commands accepted by the Subscription entity.
    }
  }
  inlet SubscriptionQueries is query GetSubscription with {
    briefly "Look-ups of this subscription"
    described as {
      |What SubscriptionManagementApp asks of the subscription, by way of SubscriptionContext.
    }
  }
  outlet SubscriptionReplies is result SubscriptionResult
 with {
    briefly "This subscription's answers"
    described as {
      |What the subscription answers, on its way back to SubscriptionContext.
    }
  }
  inlet SubscriptionCommands is type SubscriptionCommand
  outlet SubscriptionEvents is type SubscriptionEvent
  // Commands
  command ConvertTrial is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription ID"
      described as {
        |Subscription identifier.
      }
    }
    paymentMethod: PaymentMethod with {
      briefly "Payment"
      described as {
        |Payment method.
      }
    }
  } with {
    briefly "Convert trial"
    described as {
      |Converts trial to paid.
    }
  }
  command ChangePlan is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription ID"
      described as {
        |Subscription identifier.
      }
    }
    newPlan: PlanInfo with {
      briefly "New plan"
      described as {
        |New subscription plan.
      }
    }
    effectiveDate: Date with {
      briefly "Effective"
      described as {
        |When change takes effect.
      }
    }
  } with {
    briefly "Change plan"
    described as {
      |Changes subscription plan.
    }
  }
  command ApplyDiscount is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription ID"
      described as {
        |Subscription identifier.
      }
    }
    discount: DiscountInfo with {
      briefly "Discount"
      described as {
        |Discount to apply.
      }
    }
  } with {
    briefly "Apply discount"
    described as {
      |Applies a discount.
    }
  }
  command RecordPayment is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription ID"
      described as {
        |Subscription identifier.
      }
    }
    invoice: InvoiceInfo with {
      briefly "Invoice"
      described as {
        |Paid invoice.
      }
    }
  } with {
    briefly "Record payment"
    described as {
      |Records a payment.
    }
  }
  command RecordPaymentFailure is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription ID"
      described as {
        |Subscription identifier.
      }
    }
    invoiceId: InvoiceId with {
      briefly "Invoice"
      described as {
        |Failed invoice.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Failure reason.
      }
    }
  } with {
    briefly "Record failure"
    described as {
      |Records payment failure.
    }
  }
  command SuspendSubscription is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription ID"
      described as {
        |Subscription identifier.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Suspension reason.
      }
    }
  } with {
    briefly "Suspend subscription"
    described as {
      |Suspends the subscription.
    }
  }
  command ReactivateSubscription is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription ID"
      described as {
        |Subscription identifier.
      }
    }
  } with {
    briefly "Reactivate subscription"
    described as {
      |Reactivates suspended subscription.
    }
  }
  command CancelSubscription is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription ID"
      described as {
        |Subscription identifier.
      }
    }
    cancellation: CancellationInfo with {
      briefly "Cancellation"
      described as {
        |Cancellation details.
      }
    }
  } with {
    briefly "Cancel subscription"
    described as {
      |Cancels the subscription.
    }
  }
  command RenewSubscription is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription ID"
      described as {
        |Subscription identifier.
      }
    }
    renewalDate: Date with {
      briefly "Renewal date"
      described as {
        |New renewal date.
      }
    }
  } with {
    briefly "Renew subscription"
    described as {
      |Renews the subscription.
    }
  }
  // Events
  event SubscriptionCreated is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription"
      described as {
        |Subscription ID.
      }
    }
    customer: CustomerInfo with {
      briefly "Customer"
      described as {
        |Customer info.
      }
    }
    plan: PlanInfo with {
      briefly "Plan"
      described as {
        |Plan info.
      }
    }
    startDate: Date with {
      briefly "Start"
      described as {
        |Start date.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Subscription created"
    described as {
      |Emitted when subscription is created.
    }
  }
  event TrialStarted is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription"
      described as {
        |Subscription ID.
      }
    }
    customer: CustomerInfo with {
      briefly "Customer"
      described as {
        |Customer info.
      }
    }
    plan: PlanInfo with {
      briefly "Plan"
      described as {
        |Trial plan.
      }
    }
    trialEndDate: Date with {
      briefly "Trial end"
      described as {
        |Trial end date.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
  } with {
    briefly "Trial started"
    described as {
      |Emitted when trial begins.
    }
  }
  event TrialConverted is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription"
      described as {
        |Subscription ID.
      }
    }
    convertedAt: TimeStamp with {
      briefly "Converted"
      described as {
        |Conversion time.
      }
    }
  } with {
    briefly "Trial converted"
    described as {
      |Emitted when trial converts to paid.
    }
  }
  event PlanChanged is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription"
      described as {
        |Subscription ID.
      }
    }
    oldPlan: PlanInfo with {
      briefly "Old plan"
      described as {
        |Previous plan.
      }
    }
    newPlan: PlanInfo with {
      briefly "New plan"
      described as {
        |New plan.
      }
    }
    effectiveDate: Date with {
      briefly "Effective"
      described as {
        |Effective date.
      }
    }
    changedAt: TimeStamp with {
      briefly "Changed"
      described as {
        |Change time.
      }
    }
  } with {
    briefly "Plan changed"
    described as {
      |Emitted when plan changes.
    }
  }
  event DiscountApplied is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription"
      described as {
        |Subscription ID.
      }
    }
    discount: DiscountInfo with {
      briefly "Discount"
      described as {
        |Applied discount.
      }
    }
    appliedAt: TimeStamp with {
      briefly "Applied"
      described as {
        |Application time.
      }
    }
  } with {
    briefly "Discount applied"
    described as {
      |Emitted when discount is applied.
    }
  }
  event PaymentReceived is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription"
      described as {
        |Subscription ID.
      }
    }
    invoice: InvoiceInfo with {
      briefly "Invoice"
      described as {
        |Paid invoice.
      }
    }
    receivedAt: TimeStamp with {
      briefly "Received"
      described as {
        |Receipt time.
      }
    }
  } with {
    briefly "Payment received"
    described as {
      |Emitted when payment is received.
    }
  }
  event PaymentFailed is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription"
      described as {
        |Subscription ID.
      }
    }
    invoiceId: InvoiceId with {
      briefly "Invoice"
      described as {
        |Failed invoice.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Failure reason.
      }
    }
    failedAt: TimeStamp with {
      briefly "Failed"
      described as {
        |Failure time.
      }
    }
  } with {
    briefly "Payment failed"
    described as {
      |Emitted when payment fails.
    }
  }
  event SubscriptionSuspended is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription"
      described as {
        |Subscription ID.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Suspension reason.
      }
    }
    suspendedAt: TimeStamp with {
      briefly "Suspended"
      described as {
        |Suspension time.
      }
    }
  } with {
    briefly "Subscription suspended"
    described as {
      |Emitted when subscription is suspended.
    }
  }
  event SubscriptionReactivated is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription"
      described as {
        |Subscription ID.
      }
    }
    reactivatedAt: TimeStamp with {
      briefly "Reactivated"
      described as {
        |Reactivation time.
      }
    }
  } with {
    briefly "Subscription reactivated"
    described as {
      |Emitted when subscription is reactivated.
    }
  }
  event SubscriptionCanceled is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription"
      described as {
        |Subscription ID.
      }
    }
    cancellation: CancellationInfo with {
      briefly "Cancellation"
      described as {
        |Cancellation info.
      }
    }
  } with {
    briefly "Subscription canceled"
    described as {
      |Emitted when subscription is canceled.
    }
  }
  event SubscriptionRenewed is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription"
      described as {
        |Subscription ID.
      }
    }
    renewalDate: Date with {
      briefly "Renewal"
      described as {
        |New renewal date.
      }
    }
    renewedAt: TimeStamp with {
      briefly "Renewed"
      described as {
        |Renewal time.
      }
    }
  } with {
    briefly "Subscription renewed"
    described as {
      |Emitted when subscription renews.
    }
  }
  // State Records
  record ActiveStateData is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription"
      described as {
        |Subscription ID.
      }
    }
    customer: CustomerInfo with {
      briefly "Customer"
      described as {
        |Customer info.
      }
    }
    plan: PlanInfo with {
      briefly "Plan"
      described as {
        |Current plan.
      }
    }
    paymentMethod: PaymentMethod? with {
      briefly "Payment"
      described as {
        |Payment method on file; a trial may have none.
      }
    }
    billing: BillingInfo with {
      briefly "Billing"
      described as {
        |Billing info.
      }
    }
    updatedDiscount: DiscountInfo? with {
      briefly "Discount"
      described as {
        |Active discount.
      }
    }
    invoices: InvoiceInfo* with {
      briefly "Invoices"
      described as {
        |Invoice history.
      }
    }
    status: SubscriptionStatus with {
      briefly "Status"
      described as {
        |Subscription status.
      }
    }
    startDate: Date with {
      briefly "Start"
      described as {
        |Start date.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |State for active subscription.
    }
  }
  record CanceledStateData is {
    subscriptionId: SubscriptionId with {
      briefly "Subscription"
      described as {
        |Subscription ID.
      }
    }
    customer: CustomerInfo with {
      briefly "Customer"
      described as {
        |Customer info.
      }
    }
    cancellation: CancellationInfo with {
      briefly "Cancellation"
      described as {
        |Cancellation info.
      }
    }
  } with {
    briefly "Canceled state"
    described as {
      |State for canceled subscription.
    }
  }
  // Queries
  query GetSubscription replies result SubscriptionResult is {
    subscriptionId: SubscriptionId with {
      briefly "ID"
      described as {
        |Subscription to retrieve.
      }
    }
  } with {
    briefly "Get Subscription"
    described as {
      |Retrieves Subscription data.
    }
  }
  result SubscriptionResult is {
    subscriptionId: SubscriptionId with {
      briefly "ID"
      described as {
        |Subscription identifier.
      }
    }
  } with {
    briefly "Subscription result"
    described as {
      |Subscription data result.
    }
  }
  // States
  state ActiveState of record Subscription.ActiveStateData is {
    initial handler ActiveStateHandler is {
      on cancelSubscription: command CancelSubscription is {
        morph entity SubscriptionContext.Subscription to state SubscriptionContext.Subscription.CanceledState with record Subscription.CanceledStateData(subscriptionId = cancelSubscription.subscriptionId, cancellation = cancelSubscription.cancellation, customer = ActiveStateData.customer)
        tell event SubscriptionCanceled(subscriptionId = cancelSubscription.subscriptionId, cancellation = cancelSubscription.cancellation) to entity SubscriptionContext.Subscription
      }
    } with {
      briefly "While ActiveState"
      described as {
        |The commands and folds accepted while the entity is in ActiveState.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |The entity in Active state.
    }
  }
  state CanceledState of record Subscription.CanceledStateData with {
    briefly "Canceled state"
    described as {
      |The entity in Canceled state.
    }
  }
  // Handler
  handler SubscriptionHandler is {
    on init(customer: type CustomerInfo, plan: type PlanInfo, paymentMethod: type PaymentMethod?, startDate: Date?, trialEndDate: Date?) is {
      when trialEndDate != empty then
        morph entity SubscriptionContext.Subscription to state SubscriptionContext.Subscription.ActiveState with record Subscription.ActiveStateData(subscriptionId = self.id, customer = customer, plan = plan, paymentMethod = empty, billing = prompt("billing on trial terms: nothing charged before trialEndDate"), updatedDiscount = empty, invoices = empty, status = Trial, startDate = prompt("the date the trial begins"))
        tell event TrialStarted(subscriptionId = self.id, customer = customer, plan = plan, trialEndDate = trialEndDate, startedAt = prompt("the started at of this trial started")) to entity SubscriptionContext.Subscription
      else
        morph entity SubscriptionContext.Subscription to state SubscriptionContext.Subscription.ActiveState with record Subscription.ActiveStateData(subscriptionId = self.id, customer = customer, plan = plan, paymentMethod = paymentMethod, startDate = startDate otherwise system.now, billing = prompt("the billing of this active state data"), updatedDiscount = empty, invoices = empty, status = Active)
        tell event SubscriptionCreated(subscriptionId = self.id, customer = customer, plan = plan, startDate = startDate otherwise system.now, createdAt = prompt("the created at of this subscription created")) to entity SubscriptionContext.Subscription
      end
    }
    on convertTrial: command ConvertTrial is {
      tell event TrialConverted(subscriptionId = convertTrial.subscriptionId, convertedAt = system.now) to entity SubscriptionContext.Subscription
    }
    on changePlan: command ChangePlan is {
      tell event PlanChanged(subscriptionId = changePlan.subscriptionId, newPlan = changePlan.newPlan, effectiveDate = changePlan.effectiveDate, oldPlan = prompt("the old plan of this plan changed"), changedAt = system.now) to entity SubscriptionContext.Subscription
    }
    on applyDiscount: command ApplyDiscount is {
      tell event DiscountApplied(subscriptionId = applyDiscount.subscriptionId, discount = applyDiscount.discount, appliedAt = system.now) to entity SubscriptionContext.Subscription
    }
    on recordPayment: command RecordPayment is {
      tell event PaymentReceived(subscriptionId = recordPayment.subscriptionId, invoice = recordPayment.invoice, receivedAt = system.now) to entity SubscriptionContext.Subscription
    }
    on recordPaymentFailure: command RecordPaymentFailure is {
      tell event PaymentFailed(subscriptionId = recordPaymentFailure.subscriptionId, invoiceId = recordPaymentFailure.invoiceId, reason = recordPaymentFailure.reason, failedAt = system.now) to entity SubscriptionContext.Subscription
    }
    on suspendSubscription: command SuspendSubscription is {
      tell event SubscriptionSuspended(subscriptionId = suspendSubscription.subscriptionId, reason = suspendSubscription.reason, suspendedAt = system.now) to entity SubscriptionContext.Subscription
    }
    on reactivateSubscription: command ReactivateSubscription is {
      tell event SubscriptionReactivated(subscriptionId = reactivateSubscription.subscriptionId, reactivatedAt = system.now) to entity SubscriptionContext.Subscription
    }
    on renewSubscription: command RenewSubscription is {
      tell event SubscriptionRenewed(subscriptionId = renewSubscription.subscriptionId, renewalDate = renewSubscription.renewalDate, renewedAt = system.now) to entity SubscriptionContext.Subscription
    }
    on getSubscription: query GetSubscription is {
      reply result SubscriptionResult(subscriptionId = getSubscription.subscriptionId)
    }
    on discountApplied: event DiscountApplied is {
      do "apply DiscountApplied to the subscription so it can be persisted and replayed"
    }
    on paymentFailed: event PaymentFailed is {
      do "apply PaymentFailed to the subscription so it can be persisted and replayed"
    }
    on paymentReceived: event PaymentReceived is {
      do "apply PaymentReceived to the subscription so it can be persisted and replayed"
    }
    on planChanged: event PlanChanged is {
      do "apply PlanChanged to the subscription so it can be persisted and replayed"
    }
    on subscriptionCanceled: event SubscriptionCanceled is {
      do "apply SubscriptionCanceled to the subscription so it can be persisted and replayed"
    }
    on subscriptionCreated: event SubscriptionCreated is {
      do "apply SubscriptionCreated to the subscription so it can be persisted and replayed"
    }
    on subscriptionReactivated: event SubscriptionReactivated is {
      do "apply SubscriptionReactivated to the subscription so it can be persisted and replayed"
    }
    on subscriptionRenewed: event SubscriptionRenewed is {
      do "apply SubscriptionRenewed to the subscription so it can be persisted and replayed"
    }
    on subscriptionSuspended: event SubscriptionSuspended is {
      do "apply SubscriptionSuspended to the subscription so it can be persisted and replayed"
    }
    on trialConverted: event TrialConverted is {
      do "apply TrialConverted to the subscription so it can be persisted and replayed"
    }
    on trialStarted: event TrialStarted is {
      do "apply TrialStarted to the subscription so it can be persisted and replayed"
    }
  } with {
    briefly "Processes subscription commands"
    described as {
      | Handles subscription lifecycle from creation
      | through billing, plan changes, and cancellation.
    }
  }
} with {
  briefly "Subscription aggregate"
  described as {
    | The Subscription entity manages SaaS subscriptions
    | including plans, billing, and lifecycle.
  }
}
