// Subscription Management - Subscription Context
context SubscriptionContext as router is {
  inlet SubscriptionContextFromToUsageMeteringService is command Subscription.RecordPayment with {
    briefly "What ToUsageMeteringService makes of the answers it gets"
  }
  connector 'ToUsageMeteringService Intake' is from outlet SubscriptionContext.ToUsageMeteringService.ToUsageMeteringServiceToSubscriptionContext to inlet SubscriptionContext.SubscriptionContextFromToUsageMeteringService with {
    briefly "Answers translated by ToUsageMeteringService, on their way in"
  }
  type FromPaymentGatewayServiceCommand is one of {
    Subscription.RecordPayment or Subscription.RecordPaymentFailure
  } with {
    briefly "What FromPaymentGatewayService turns that service's news into"
  }
  inlet SubscriptionContextFromPaymentGatewayService is type SubscriptionContext.FromPaymentGatewayServiceCommand with {
    briefly "What FromPaymentGatewayService makes of that service's news"
  }
  connector 'FromPaymentGatewayService Intake' is from outlet SubscriptionContext.FromPaymentGatewayService.FromPaymentGatewayServiceToSubscriptionContext to inlet SubscriptionContext.SubscriptionContextFromPaymentGatewayService with {
    briefly "What FromPaymentGatewayService makes of that news, on its way in"
  }
  inlet SubscriptionCommandStreamIn is type SubscriptionCommand  outlet SubscriptionCommandStreamOut is type SubscriptionCommand
  inlet SubscriptionResultStreamIn is result Subscription.SubscriptionResult  outlet SubscriptionResultStreamOut is result Subscription.SubscriptionResult
  handler SubscriptionContextBoundary is {
    on createSubscription: command Subscription.CreateSubscription is {
      send createSubscription to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on startTrial: command Subscription.StartTrial is {
      send startTrial to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on convertTrial: command Subscription.ConvertTrial is {
      send convertTrial to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on changePlan: command Subscription.ChangePlan is {
      send changePlan to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on applyDiscount: command Subscription.ApplyDiscount is {
      send applyDiscount to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on recordPayment: command Subscription.RecordPayment is {
      send recordPayment to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on recordPaymentFailure: command Subscription.RecordPaymentFailure is {
      send recordPaymentFailure to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on suspendSubscription: command Subscription.SuspendSubscription is {
      send suspendSubscription to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on reactivateSubscription: command Subscription.ReactivateSubscription is {
      send reactivateSubscription to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on cancelSubscription: command Subscription.CancelSubscription is {
      send cancelSubscription to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on renewSubscription: command Subscription.RenewSubscription is {
      send renewSubscription to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on subscriptionResult: result Subscription.SubscriptionResult is {
      send subscriptionResult to outlet SubscriptionContext.SubscriptionResultStreamOut
    }
    on other is {
      error "Unexpected message at the SubscriptionContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'SubscriptionCommand Stream Intake' is from outlet SubscriptionContext.SubscriptionCommandStreamOut to inlet SubscriptionContext.Subscription.SubscriptionCommands  connector 'SubscriptionResult Stream Egress' is from outlet SubscriptionContext.SubscriptionRepository.SubscriptionRepositoryResponses to inlet SubscriptionContext.SubscriptionResultStreamIn  adaptor FromInvoiceService from context InvoiceService as sink is { 
    inlet FromInvoiceServiceIn is event InvoiceService.InvoiceGenerated    handler FromInvoiceServiceHandler is {
      on invoiceGenerated: event InvoiceService.InvoiceGenerated is {
        do "the invoice exists; renewing was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromInvoiceService"
      }
    } with {
      briefly "from invoice service"
      described as {
        |Carries messages from the external InvoiceService.
      }
    }
  } with {
    briefly "InvoiceService integration"
    described as {
      |The model's side of the InvoiceService conversation.
    }
  }
  adaptor ToInvoiceService to context InvoiceService as flow is { 
    inlet ToInvoiceServiceIn is type SubscriptionEvent    outlet ToInvoiceServiceOut is command InvoiceService.GenerateInvoice
    handler ToInvoiceServiceHandler is {
      on subscriptionRenewed: event Subscription.SubscriptionRenewed is {
        let notice: type InvoiceService.GenerateInvoice = prompt("translate the subscriptionRenewed event into a GenerateInvoice for the term just renewed, the renewal being where the period closes and the next becomes billable")
        send notice to outlet SubscriptionContext.ToInvoiceService.ToInvoiceServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToInvoiceService"
      }
    } with {
      briefly "to invoice service"
      described as {
        |Carries messages to the external InvoiceService.
      }
    }
  } with {
    briefly "InvoiceService integration"
    described as {
      |The model's side of the InvoiceService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type SubscriptionEvent    outlet ToNotificationServiceOut is command NotificationService.SendSubscriptionNotification
    handler ToNotificationServiceHandler is {
      on paymentFailed: event PaymentFailed is {
        let notice: type NotificationService.SendSubscriptionNotification = prompt("translate the paymentFailed event into a SendSubscriptionNotification telling the subscriber the charge failed and what happens if it is not fixed, since service depends on it")
        send notice to outlet SubscriptionContext.ToNotificationService.ToNotificationServiceOut
      }
      on subscriptionSuspended: event SubscriptionSuspended is {
        let notice: type NotificationService.SendSubscriptionNotification = prompt("translate the subscriptionSuspended event into a SendSubscriptionNotification telling the subscriber access has stopped, why, and what would restore it")
        send notice to outlet SubscriptionContext.ToNotificationService.ToNotificationServiceOut
      }
      on subscriptionCanceled: event SubscriptionCanceled is {
        let notice: type NotificationService.SendSubscriptionNotification = prompt("translate the subscriptionCanceled event into a SendSubscriptionNotification telling the subscriber the subscription has ended and when access stops")
        send notice to outlet SubscriptionContext.ToNotificationService.ToNotificationServiceOut
      }
      on planChanged: event PlanChanged is {
        let notice: type NotificationService.SendSubscriptionNotification = prompt("translate the planChanged event into a SendSubscriptionNotification telling the subscriber what they are now on and what it costs")
        send notice to outlet SubscriptionContext.ToNotificationService.ToNotificationServiceOut
      }
      on trialConverted: event TrialConverted is {
        let notice: type NotificationService.SendSubscriptionNotification = prompt("translate the trialConverted event into a SendSubscriptionNotification telling the subscriber the trial has become a paid subscription and what will be billed")
        send notice to outlet SubscriptionContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentGatewayService from context PaymentGatewayService as flow is { 
    inlet FromPaymentGatewayServiceIn is type PaymentGatewayService.PaymentGatewayServiceEvent    outlet FromPaymentGatewayServiceToSubscriptionContext is type SubscriptionContext.FromPaymentGatewayServiceCommand
    handler FromPaymentGatewayServiceHandler is {
      on paymentChargeFailed: event PaymentGatewayService.PaymentChargeFailed is {
        let item0: type Subscription.RecordPaymentFailure = prompt("translate the paymentChargeFailed event into a RecordPaymentFailure, a charge the gateway could not take is what the subscription records as a failed payment")
        send item0 to outlet SubscriptionContext.FromPaymentGatewayService.FromPaymentGatewayServiceToSubscriptionContext
      }
      on paymentCharged: event PaymentGatewayService.PaymentCharged is {
        let item0: type Subscription.RecordPayment = prompt("translate the paymentCharged event into a RecordPayment, money actually taken is what the subscription records as paid")
        send item0 to outlet SubscriptionContext.FromPaymentGatewayService.FromPaymentGatewayServiceToSubscriptionContext
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentGatewayService"
      }
    } with {
      briefly "from payment gateway service"
      described as {
        |Carries messages from the external PaymentGatewayService.
      }
    }
  } with {
    briefly "PaymentGatewayService integration"
    described as {
      |The model's side of the PaymentGatewayService conversation.
    }
  }
  adaptor ToPaymentGatewayService to context PaymentGatewayService as flow is { 
    inlet ToPaymentGatewayServiceIn is type SubscriptionEvent    outlet ToPaymentGatewayServiceOut is command PaymentGatewayService.ChargePayment
    handler ToPaymentGatewayServiceHandler is {
      on subscriptionCreated: event Subscription.SubscriptionCreated is {
        let charge: type PaymentGatewayService.ChargePayment = prompt("translate the subscriptionCreated event into a ChargePayment taking the first term the subscriber has just committed to")
        send charge to outlet SubscriptionContext.ToPaymentGatewayService.ToPaymentGatewayServiceOut
      }
      on subscriptionRenewed: event Subscription.SubscriptionRenewed is {
        let charge: type PaymentGatewayService.ChargePayment = prompt("translate the subscriptionRenewed event into a ChargePayment taking the term just renewed")
        send charge to outlet SubscriptionContext.ToPaymentGatewayService.ToPaymentGatewayServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentGatewayService"
      }
    } with {
      briefly "to payment gateway service"
      described as {
        |Carries messages to the external PaymentGatewayService.
      }
    }
  } with {
    briefly "PaymentGatewayService integration"
    described as {
      |The model's side of the PaymentGatewayService conversation.
    }
  }
  adaptor FromProvisioningService from context ProvisioningService as sink is { 
    inlet FromProvisioningServiceIn is type ProvisioningService.ProvisioningServiceEvent    handler FromProvisioningServiceHandler is {
      on accessProvisioned: event ProvisioningService.AccessProvisioned is {
        do "the customer has access; creating the subscription was recorded here"
      }
      on accessRevoked: event ProvisioningService.AccessRevoked is {
        do "access is gone; the cancellation or suspension was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromProvisioningService"
      }
    } with {
      briefly "from provisioning service"
      described as {
        |Carries messages from the external ProvisioningService.
      }
    }
  } with {
    briefly "ProvisioningService integration"
    described as {
      |The model's side of the ProvisioningService conversation.
    }
  }
  adaptor ToProvisioningService to context ProvisioningService as flow is { 
    inlet ToProvisioningServiceIn is type SubscriptionEvent    outlet ToProvisioningServiceOut is type ProvisioningService.ProvisioningServiceCommand
    handler ToProvisioningServiceHandler is {
      on subscriptionCreated: event Subscription.SubscriptionCreated is {
        let item0: type ProvisioningService.ProvisionAccess = prompt("translate the subscriptionCreated event into a ProvisionAccess, a subscription being what entitles someone to the product")
        send item0 to outlet SubscriptionContext.ToProvisioningService.ToProvisioningServiceOut
      }
      on subscriptionCanceled: event Subscription.SubscriptionCanceled is {
        let item0: type ProvisioningService.RevokeAccess = prompt("translate the subscriptionCanceled event into a RevokeAccess, cancellation ending the entitlement")
        send item0 to outlet SubscriptionContext.ToProvisioningService.ToProvisioningServiceOut
      }
      on subscriptionSuspended: event Subscription.SubscriptionSuspended is {
        let item0: type ProvisioningService.RevokeAccess = prompt("translate the subscriptionSuspended event into a RevokeAccess, and suspension ending it provisionally")
        send item0 to outlet SubscriptionContext.ToProvisioningService.ToProvisioningServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToProvisioningService"
      }
    } with {
      briefly "to provisioning service"
      described as {
        |Carries messages to the external ProvisioningService.
      }
    }
  } with {
    briefly "ProvisioningService integration"
    described as {
      |The model's side of the ProvisioningService conversation.
    }
  }
  adaptor ToUsageMeteringService to context UsageMeteringService as router is { 
    outlet ToUsageMeteringServiceToSubscriptionContext is command Subscription.RecordPayment
    inlet ToUsageMeteringServiceIn is type SubscriptionEvent    inlet ToUsageMeteringServiceReplies is result UsageMeteringService.UsageData    outlet ToUsageMeteringServiceOut is query UsageMeteringService.GetUsage
    handler ToUsageMeteringServiceHandler is {
      on subscriptionRenewed: event Subscription.SubscriptionRenewed is {
        let askAnswer: type UsageMeteringService.UsageData = ask query UsageMeteringService.GetUsage of context UsageMeteringService
        do "a renewal needing the usage the period is billed on"
        send command Subscription.RecordPayment(subscriptionId = subscriptionRenewed.subscriptionId, invoice = prompt("the invoice for askAnswer.usageTotalAmount over askAnswer.usageItems")) to outlet SubscriptionContext.ToUsageMeteringService.ToUsageMeteringServiceToSubscriptionContext
      }
      on other is {
        error "Unexpected message for adaptor ToUsageMeteringService"
      }
    } with {
      briefly "to usage metering service"
      described as {
        |Carries messages to the external UsageMeteringService.
      }
    }
  } with {
    briefly "UsageMeteringService integration"
    described as {
      |The model's side of the UsageMeteringService conversation.
    }
  }
  include "types.riddl"
  include "Subscription.riddl"
  // Repository for subscription persistence
  type SubscriptionRepositoryCommand is one of {
    SubscriptionContext.SubscriptionRepository.PersistDiscountApplied or SubscriptionContext.SubscriptionRepository.PersistPaymentFailed or SubscriptionContext.SubscriptionRepository.PersistPaymentReceived or SubscriptionContext.SubscriptionRepository.PersistPlanChanged or SubscriptionContext.SubscriptionRepository.PersistSubscriptionCanceled or SubscriptionContext.SubscriptionRepository.PersistSubscriptionCreated or SubscriptionContext.SubscriptionRepository.PersistSubscriptionReactivated or SubscriptionContext.SubscriptionRepository.PersistSubscriptionRenewed or SubscriptionContext.SubscriptionRepository.PersistSubscriptionSuspended or SubscriptionContext.SubscriptionRepository.PersistTrialConverted or SubscriptionContext.SubscriptionRepository.PersistTrialStarted
  } with {
    briefly "Anything that writes SubscriptionRepository"
    described as {
      |The persistence commands SubscriptionRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository SubscriptionRepository as flow is {
    inlet SubscriptionRepositoryFromSubscriptionAnalytics is type SubscriptionRepositoryCommand    command PersistDiscountApplied is {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row DiscountApplied applies to.
        }
      }
      discount: DiscountInfo? with {
        briefly "Discount"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      appliedAt: TimeStamp? with {
        briefly "Applied at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DiscountApplied"
      described as {
        |Instructs this repository to apply DiscountApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentFailed is {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentFailed applies to.
        }
      }
      invoiceId: InvoiceId? with {
        briefly "Invoice id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String(1,200)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      failedAt: TimeStamp? with {
        briefly "Failed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PaymentFailed"
      described as {
        |Instructs this repository to apply PaymentFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlanChanged is {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlanChanged applies to.
        }
      }
      oldPlan: PlanInfo? with {
        briefly "Old plan"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newPlan: PlanInfo? with {
        briefly "New plan"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      effectiveDate: Date? with {
        briefly "Effective date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      changedAt: TimeStamp? with {
        briefly "Changed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PlanChanged"
      described as {
        |Instructs this repository to apply PlanChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubscriptionReactivated is {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubscriptionReactivated applies to.
        }
      }
      reactivatedAt: TimeStamp? with {
        briefly "Reactivated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SubscriptionReactivated"
      described as {
        |Instructs this repository to apply SubscriptionReactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubscriptionRenewed is {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubscriptionRenewed applies to.
        }
      }
      renewalDate: Date? with {
        briefly "Renewal date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      renewedAt: TimeStamp? with {
        briefly "Renewed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SubscriptionRenewed"
      described as {
        |Instructs this repository to apply SubscriptionRenewed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubscriptionSuspended is {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubscriptionSuspended applies to.
        }
      }
      reason: String(1,200)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      suspendedAt: TimeStamp? with {
        briefly "Suspended at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SubscriptionSuspended"
      described as {
        |Instructs this repository to apply SubscriptionSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrialStarted is {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrialStarted applies to.
        }
      }
      customer: CustomerInfo? with {
        briefly "Customer"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      plan: PlanInfo? with {
        briefly "Plan"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      trialEndDate: Date? with {
        briefly "Trial end date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      startedAt: TimeStamp? with {
        briefly "Started at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TrialStarted"
      described as {
        |Instructs this repository to apply TrialStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentReceived is {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentReceived applies to.
        }
      }
      invoice: InvoiceInfo? with {
        briefly "Invoice"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      receivedAt: TimeStamp? with {
        briefly "Received at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PaymentReceived"
      described as {
        |Instructs this repository to apply PaymentReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubscriptionCanceled is {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubscriptionCanceled applies to.
        }
      }
      cancellation: CancellationInfo? with {
        briefly "Cancellation"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SubscriptionCanceled"
      described as {
        |Instructs this repository to apply SubscriptionCanceled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubscriptionCreated is {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubscriptionCreated applies to.
        }
      }
      customer: CustomerInfo? with {
        briefly "Customer"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      plan: PlanInfo? with {
        briefly "Plan"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      startDate: Date? with {
        briefly "Start date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SubscriptionCreated"
      described as {
        |Instructs this repository to apply SubscriptionCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrialConverted is {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrialConverted applies to.
        }
      }
      convertedAt: TimeStamp? with {
        briefly "Converted at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TrialConverted"
      described as {
        |Instructs this repository to apply TrialConverted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet SubscriptionRepositoryResponses is result Subscription.SubscriptionResult
    record StoredSubscription is {
      subscriptionId: SubscriptionId with {
        briefly "subscriptionId"
        described as {
          |The subscriptionId column of the stored subscription row.
        }
      }
      customer: CustomerInfo with {
        briefly "customer"
        described as {
          |The customer column of the stored subscription row.
        }
      }
      discount: DiscountInfo? with {
        briefly "Discount"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      appliedAt: TimeStamp? with {
        briefly "Applied at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      invoiceId: InvoiceId? with {
        briefly "Invoice id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,200)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      failedAt: TimeStamp? with {
        briefly "Failed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      oldPlan: PlanInfo? with {
        briefly "Old plan"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newPlan: PlanInfo? with {
        briefly "New plan"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      effectiveDate: Date? with {
        briefly "Effective date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      changedAt: TimeStamp? with {
        briefly "Changed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reactivatedAt: TimeStamp? with {
        briefly "Reactivated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      renewalDate: Date? with {
        briefly "Renewal date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      renewedAt: TimeStamp? with {
        briefly "Renewed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      suspendedAt: TimeStamp? with {
        briefly "Suspended at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      plan: PlanInfo? with {
        briefly "Plan"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      trialEndDate: Date? with {
        briefly "Trial end date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      startedAt: TimeStamp? with {
        briefly "Started at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      invoice: InvoiceInfo? with {
        briefly "Invoice"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      receivedAt: TimeStamp? with {
        briefly "Received at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      cancellation: CancellationInfo? with {
        briefly "Cancellation"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      startDate: Date? with {
        briefly "Start date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      convertedAt: TimeStamp? with {
        briefly "Converted at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored subscription row"
      described as {
        |The persistence shape of subscription data as this repository stores it.
      }
    }
    schema SubscriptionData is relational
      of subscriptions as record StoredSubscription
        key on field StoredSubscription.subscriptionId
        index on field StoredSubscription.customer.customerId
 with {
      briefly "Subscription data schema"
      described as {
        |The relational schema holding subscription data for the SubscriptionRepository.
      }
    }
    handler SubscriptionPersistence is {
      on persistDiscountApplied: command PersistDiscountApplied is {
        update SubscriptionData.subscriptions set discount = persistDiscountApplied.discount, appliedAt = persistDiscountApplied.appliedAt where subscriptionId == persistDiscountApplied.subscriptionId
      }
      on persistPaymentFailed: command PersistPaymentFailed is {
        update SubscriptionData.subscriptions set invoiceId = persistPaymentFailed.invoiceId, reason = persistPaymentFailed.reason, failedAt = persistPaymentFailed.failedAt where subscriptionId == persistPaymentFailed.subscriptionId
      }
      on persistPlanChanged: command PersistPlanChanged is {
        update SubscriptionData.subscriptions set oldPlan = persistPlanChanged.oldPlan, newPlan = persistPlanChanged.newPlan, effectiveDate = persistPlanChanged.effectiveDate, changedAt = persistPlanChanged.changedAt where subscriptionId == persistPlanChanged.subscriptionId
      }
      on persistSubscriptionReactivated: command PersistSubscriptionReactivated is {
        update SubscriptionData.subscriptions set reactivatedAt = persistSubscriptionReactivated.reactivatedAt where subscriptionId == persistSubscriptionReactivated.subscriptionId
      }
      on persistSubscriptionRenewed: command PersistSubscriptionRenewed is {
        update SubscriptionData.subscriptions set renewalDate = persistSubscriptionRenewed.renewalDate, renewedAt = persistSubscriptionRenewed.renewedAt where subscriptionId == persistSubscriptionRenewed.subscriptionId
      }
      on persistSubscriptionSuspended: command PersistSubscriptionSuspended is {
        update SubscriptionData.subscriptions set reason = persistSubscriptionSuspended.reason, suspendedAt = persistSubscriptionSuspended.suspendedAt where subscriptionId == persistSubscriptionSuspended.subscriptionId
      }
      on persistTrialStarted: command PersistTrialStarted is {
        update SubscriptionData.subscriptions set customer = persistTrialStarted.customer, plan = persistTrialStarted.plan, trialEndDate = persistTrialStarted.trialEndDate, startedAt = persistTrialStarted.startedAt where subscriptionId == persistTrialStarted.subscriptionId
      }
      on persistPaymentReceived: command PersistPaymentReceived is {
        update SubscriptionData.subscriptions set invoice = persistPaymentReceived.invoice, receivedAt = persistPaymentReceived.receivedAt where subscriptionId == persistPaymentReceived.subscriptionId
      }
      on persistSubscriptionCanceled: command PersistSubscriptionCanceled is {
        update SubscriptionData.subscriptions set cancellation = persistSubscriptionCanceled.cancellation where subscriptionId == persistSubscriptionCanceled.subscriptionId
      }
      on persistSubscriptionCreated: command PersistSubscriptionCreated is {
        update SubscriptionData.subscriptions set customer = persistSubscriptionCreated.customer, plan = persistSubscriptionCreated.plan, startDate = persistSubscriptionCreated.startDate, createdAt = persistSubscriptionCreated.createdAt where subscriptionId == persistSubscriptionCreated.subscriptionId
      }
      on persistTrialConverted: command PersistTrialConverted is {
        update SubscriptionData.subscriptions set convertedAt = persistTrialConverted.convertedAt where subscriptionId == persistTrialConverted.subscriptionId
      }
      on query GetSubscriptionStats is {
        let subscriptionStatsView: type SubscriptionStatsView = prompt("read the subscription stats projection")
        reply subscriptionStatsView
      }
    } with {
      briefly "Persists subscription commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Subscription data persistence"
    described as {
      | The SubscriptionRepository provides persistent storage for
      | subscriptions, billing, and payment history.
    }
  }
  // Projector for subscription analytics
  query GetSubscriptionStats replies result SubscriptionStatsView is {
    subscriptionStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which subscription stats to retrieve.
      }
    }
  } with {
    briefly "Get subscription stats"
    described as {
      |Retrieves the subscription stats projection.
    }
  }
  result SubscriptionStatsView is {
    subscriptionStats: SubscriptionAnalytics.SubscriptionStats with {
      briefly "Subscription stats"
      described as {
        |The subscription stats being returned.
      }
    }
  } with {
    briefly "Subscription stats view"
    described as {
      |Read model view carrying the subscription stats projection.
    }
  }
  projector SubscriptionAnalytics as flow is {
    updates repository SubscriptionContext.SubscriptionRepository
    outlet SubscriptionAnalyticsToRepository is type SubscriptionRepositoryCommand
    inlet SubscriptionAnalyticsFromSubscription is type SubscriptionEvent    record SubscriptionStats is {
      totalSubscriptions: Natural with {
        briefly "Total"
        described as {
          |Total subscriptions.
        }
      }
      activeSubscriptions: Natural with {
        briefly "Active"
        described as {
          |Active subscriptions.
        }
      }
      mrr: Decimal(15,2) with {
        briefly "MRR"
        described as {
          |Monthly recurring revenue.
        }
      }
      arr: Decimal(18,2) with {
        briefly "ARR"
        described as {
          |Annual recurring revenue.
        }
      }
      churnRate: Decimal(5,4) with {
        briefly "Churn"
        described as {
          |Churn rate.
        }
      }
      trialConversionRate: Decimal(5,4) with {
        briefly "Conversion"
        described as {
          |Trial conversion rate.
        }
      }
    } with {
      briefly "Subscription statistics"
      described as {
        |SaaS subscription metrics.
      }
    }
    handler AnalyticsHandler is {
      on discountApplied: event Subscription.DiscountApplied is {
        tell command SubscriptionContext.SubscriptionRepository.PersistDiscountApplied(subscriptionId = discountApplied.subscriptionId, discount = discountApplied.discount, appliedAt = discountApplied.appliedAt) to repository SubscriptionContext.SubscriptionRepository
        do "apply DiscountApplied to the SubscriptionAnalytics projection"
      }
      on paymentFailed: event Subscription.PaymentFailed is {
        tell command SubscriptionContext.SubscriptionRepository.PersistPaymentFailed(subscriptionId = paymentFailed.subscriptionId, invoiceId = paymentFailed.invoiceId, reason = paymentFailed.reason, failedAt = paymentFailed.failedAt) to repository SubscriptionContext.SubscriptionRepository
        do "apply PaymentFailed to the SubscriptionAnalytics projection"
      }
      on planChanged: event Subscription.PlanChanged is {
        tell command SubscriptionContext.SubscriptionRepository.PersistPlanChanged(subscriptionId = planChanged.subscriptionId, oldPlan = planChanged.oldPlan, newPlan = planChanged.newPlan, effectiveDate = planChanged.effectiveDate, changedAt = planChanged.changedAt) to repository SubscriptionContext.SubscriptionRepository
        do "apply PlanChanged to the SubscriptionAnalytics projection"
      }
      on subscriptionReactivated: event Subscription.SubscriptionReactivated is {
        tell command SubscriptionContext.SubscriptionRepository.PersistSubscriptionReactivated(subscriptionId = subscriptionReactivated.subscriptionId, reactivatedAt = subscriptionReactivated.reactivatedAt) to repository SubscriptionContext.SubscriptionRepository
        do "apply SubscriptionReactivated to the SubscriptionAnalytics projection"
      }
      on subscriptionRenewed: event Subscription.SubscriptionRenewed is {
        tell command SubscriptionContext.SubscriptionRepository.PersistSubscriptionRenewed(subscriptionId = subscriptionRenewed.subscriptionId, renewalDate = subscriptionRenewed.renewalDate, renewedAt = subscriptionRenewed.renewedAt) to repository SubscriptionContext.SubscriptionRepository
        do "apply SubscriptionRenewed to the SubscriptionAnalytics projection"
      }
      on subscriptionSuspended: event Subscription.SubscriptionSuspended is {
        tell command SubscriptionContext.SubscriptionRepository.PersistSubscriptionSuspended(subscriptionId = subscriptionSuspended.subscriptionId, reason = subscriptionSuspended.reason, suspendedAt = subscriptionSuspended.suspendedAt) to repository SubscriptionContext.SubscriptionRepository
        do "apply SubscriptionSuspended to the SubscriptionAnalytics projection"
      }
      on trialStarted: event Subscription.TrialStarted is {
        tell command SubscriptionContext.SubscriptionRepository.PersistTrialStarted(subscriptionId = trialStarted.subscriptionId, customer = trialStarted.customer, plan = trialStarted.plan, trialEndDate = trialStarted.trialEndDate, startedAt = trialStarted.startedAt) to repository SubscriptionContext.SubscriptionRepository
        do "apply TrialStarted to the SubscriptionAnalytics projection"
      }
      on subscriptionCreated: event Subscription.SubscriptionCreated is {
        tell command SubscriptionContext.SubscriptionRepository.PersistSubscriptionCreated(subscriptionId = subscriptionCreated.subscriptionId, customer = subscriptionCreated.customer, plan = subscriptionCreated.plan, startDate = subscriptionCreated.startDate, createdAt = subscriptionCreated.createdAt) to repository SubscriptionContext.SubscriptionRepository
      }
      on paymentReceived: event Subscription.PaymentReceived is {
        tell command SubscriptionContext.SubscriptionRepository.PersistPaymentReceived(subscriptionId = paymentReceived.subscriptionId, invoice = paymentReceived.invoice, receivedAt = paymentReceived.receivedAt) to repository SubscriptionContext.SubscriptionRepository
      }
      on subscriptionCanceled: event Subscription.SubscriptionCanceled is {
        tell command SubscriptionContext.SubscriptionRepository.PersistSubscriptionCanceled(subscriptionId = subscriptionCanceled.subscriptionId, cancellation = subscriptionCanceled.cancellation) to repository SubscriptionContext.SubscriptionRepository
      }
      on trialConverted: event Subscription.TrialConverted is {
        tell command SubscriptionContext.SubscriptionRepository.PersistTrialConverted(subscriptionId = trialConverted.subscriptionId, convertedAt = trialConverted.convertedAt) to repository SubscriptionContext.SubscriptionRepository
      }
    } with {
      briefly "Maintains subscription analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Subscription analytics projections"
    described as {
      |Maintains SaaS subscription analytics data.
    }
  }
  // Event streaming infrastructure
  type SubscriptionEvent is one of {
    SubscriptionContext.Subscription.SubscriptionCreated or SubscriptionContext.Subscription.TrialStarted or SubscriptionContext.Subscription.TrialConverted or SubscriptionContext.Subscription.PlanChanged or SubscriptionContext.Subscription.PaymentReceived or SubscriptionContext.Subscription.DiscountApplied or SubscriptionContext.Subscription.PaymentFailed or SubscriptionContext.Subscription.SubscriptionCanceled or SubscriptionContext.Subscription.SubscriptionReactivated or SubscriptionContext.Subscription.SubscriptionRenewed or SubscriptionContext.Subscription.SubscriptionSuspended
  } with {
    briefly "Subscription events"
    described as {
      |Union of all Subscription events for streaming.
    }
  }
  streamlet SubscriptionEventSplit as split is {
    outlet SubscriptionEventSplitToToUsageMeteringService is type SubscriptionEvent
    outlet SubscriptionEventSplitToToProvisioningService is type SubscriptionEvent
    outlet SubscriptionEventSplitToToPaymentGatewayService is type SubscriptionEvent
    outlet SubscriptionEventSplitToToNotificationService is type SubscriptionEvent
    outlet SubscriptionEventSplitToToInvoiceService is type SubscriptionEvent
    inlet SubscriptionEventSplitIn is type SubscriptionEvent    outlet SubscriptionEventSplitToSubscriptionAnalytics is type SubscriptionEvent
    handler SubscriptionEventSplitHandler is {
      on subscriptionCreated: event Subscription.SubscriptionCreated is {
        send subscriptionCreated to outlet SubscriptionEventSplitToSubscriptionAnalytics
        send subscriptionCreated to outlet SubscriptionEventSplitToToProvisioningService
        send subscriptionCreated to outlet SubscriptionEventSplitToToPaymentGatewayService
        tell subscriptionCreated to entity SubscriptionContext.Subscription
      }
      on trialStarted: event Subscription.TrialStarted is {
        send trialStarted to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell trialStarted to entity SubscriptionContext.Subscription
      }
      on trialConverted: event Subscription.TrialConverted is {
        send trialConverted to outlet SubscriptionEventSplitToSubscriptionAnalytics
        send trialConverted to outlet SubscriptionEventSplitToToNotificationService
        tell trialConverted to entity SubscriptionContext.Subscription
      }
      on planChanged: event Subscription.PlanChanged is {
        send planChanged to outlet SubscriptionEventSplitToSubscriptionAnalytics
        send planChanged to outlet SubscriptionEventSplitToToNotificationService
        tell planChanged to entity SubscriptionContext.Subscription
      }
      on discountApplied: event Subscription.DiscountApplied is {
        send discountApplied to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell discountApplied to entity SubscriptionContext.Subscription
      }
      on paymentReceived: event Subscription.PaymentReceived is {
        send paymentReceived to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell paymentReceived to entity SubscriptionContext.Subscription
      }
      on paymentFailed: event Subscription.PaymentFailed is {
        send paymentFailed to outlet SubscriptionEventSplitToSubscriptionAnalytics
        send paymentFailed to outlet SubscriptionEventSplitToToNotificationService
        tell paymentFailed to entity SubscriptionContext.Subscription
      }
      on subscriptionSuspended: event Subscription.SubscriptionSuspended is {
        send subscriptionSuspended to outlet SubscriptionEventSplitToSubscriptionAnalytics
        send subscriptionSuspended to outlet SubscriptionEventSplitToToProvisioningService
        send subscriptionSuspended to outlet SubscriptionEventSplitToToNotificationService
        tell subscriptionSuspended to entity SubscriptionContext.Subscription
      }
      on subscriptionReactivated: event Subscription.SubscriptionReactivated is {
        send subscriptionReactivated to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell subscriptionReactivated to entity SubscriptionContext.Subscription
      }
      on subscriptionCanceled: event Subscription.SubscriptionCanceled is {
        send subscriptionCanceled to outlet SubscriptionEventSplitToSubscriptionAnalytics
        send subscriptionCanceled to outlet SubscriptionEventSplitToToProvisioningService
        send subscriptionCanceled to outlet SubscriptionEventSplitToToNotificationService
        tell subscriptionCanceled to entity SubscriptionContext.Subscription
      }
      on subscriptionRenewed: event Subscription.SubscriptionRenewed is {
        send subscriptionRenewed to outlet SubscriptionEventSplitToSubscriptionAnalytics
        send subscriptionRenewed to outlet SubscriptionEventSplitToToUsageMeteringService
        send subscriptionRenewed to outlet SubscriptionEventSplitToToPaymentGatewayService
        send subscriptionRenewed to outlet SubscriptionEventSplitToToInvoiceService
        tell subscriptionRenewed to entity SubscriptionContext.Subscription
      }
      on other is {
        error "Unexpected message for processor SubscriptionEventSplit"
      }
    } with {
      briefly "Subscription event fan-out handler"
      described as {
        |Delivers each Subscription event to all of its consumers.
      }
    }
  } with {
    briefly "Subscription event fan-out"
    described as {
      |Fans Subscription events out to the repository and projectors.
    }
  }
  connector 'ToUsageMeteringService Feed' is from outlet SubscriptionContext.SubscriptionEventSplit.SubscriptionEventSplitToToUsageMeteringService to inlet SubscriptionContext.ToUsageMeteringService.ToUsageMeteringServiceIn with {
    briefly "The Subscription events ToUsageMeteringService translates, on their way to it"
  }
  connector 'ToProvisioningService Feed' is from outlet SubscriptionContext.SubscriptionEventSplit.SubscriptionEventSplitToToProvisioningService to inlet SubscriptionContext.ToProvisioningService.ToProvisioningServiceIn with {
    briefly "The Subscription events ToProvisioningService translates, on their way to it"
  }
  connector 'ToPaymentGatewayService Feed' is from outlet SubscriptionContext.SubscriptionEventSplit.SubscriptionEventSplitToToPaymentGatewayService to inlet SubscriptionContext.ToPaymentGatewayService.ToPaymentGatewayServiceIn with {
    briefly "The Subscription events ToPaymentGatewayService translates, on their way to it"
  }
  connector 'ToNotificationService Feed' is from outlet SubscriptionContext.SubscriptionEventSplit.SubscriptionEventSplitToToNotificationService to inlet SubscriptionContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The Subscription events ToNotificationService translates, on their way to it"
  }
  connector 'ToInvoiceService Feed' is from outlet SubscriptionContext.SubscriptionEventSplit.SubscriptionEventSplitToToInvoiceService to inlet SubscriptionContext.ToInvoiceService.ToInvoiceServiceIn with {
    briefly "The Subscription events ToInvoiceService translates, on their way to it"
  }
  connector 'SubscriptionEvent Stream' is from outlet SubscriptionContext.Subscription.SubscriptionEvents to inlet SubscriptionContext.SubscriptionEventSplit.SubscriptionEventSplitIn with {
    briefly "Subscription events, fanned out to storage and read models"
  }
  connector 'SubscriptionAnalytics Feed' is from outlet SubscriptionContext.SubscriptionEventSplit.SubscriptionEventSplitToSubscriptionAnalytics to inlet SubscriptionContext.SubscriptionAnalytics.SubscriptionAnalyticsFromSubscription with {
    briefly "Subscription events feeding the SubscriptionAnalytics projection"
  }
  connector 'SubscriptionAnalytics Storage' is from outlet SubscriptionContext.SubscriptionAnalytics.SubscriptionAnalyticsToRepository to inlet SubscriptionContext.SubscriptionRepository.SubscriptionRepositoryFromSubscriptionAnalytics with {
    briefly "SubscriptionAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for subscription management"
  described as {
    | The SubscriptionContext is the bounded context for
    | SaaS subscription billing and lifecycle management.
  }
}
