// Subscription Management - Subscription Context
context SubscriptionContext as router is {
  inlet SubscriptionCommandStreamIn is type SubscriptionCommand  outlet SubscriptionCommandStreamOut is type SubscriptionCommand
  inlet SubscriptionResultStreamIn is type Subscription.SubscriptionResult  outlet SubscriptionResultStreamOut is type Subscription.SubscriptionResult
  handler SubscriptionContextBoundary is {
    on createSubscription: command Subscription.CreateSubscription is {
      send createSubscription to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on startTrial: command Subscription.StartTrial is {
      send startTrial to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on convertTrial: command Subscription.ConvertTrial is {
      send convertTrial to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on changePlan: command Subscription.ChangePlan is {
      send changePlan to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on applyDiscount: command Subscription.ApplyDiscount is {
      send applyDiscount to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on recordPayment: command Subscription.RecordPayment is {
      send recordPayment to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on recordPaymentFailure: command Subscription.RecordPaymentFailure is {
      send recordPaymentFailure to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on suspendSubscription: command Subscription.SuspendSubscription is {
      send suspendSubscription to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on reactivateSubscription: command Subscription.ReactivateSubscription is {
      send reactivateSubscription to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on cancelSubscription: command Subscription.CancelSubscription is {
      send cancelSubscription to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on renewSubscription: command Subscription.RenewSubscription is {
      send renewSubscription to outlet SubscriptionContext.SubscriptionCommandStreamOut
    }
    on subscriptionResult: result Subscription.SubscriptionResult is {
      send subscriptionResult to outlet SubscriptionContext.SubscriptionResultStreamOut
    }
    on other is {
      error "Unexpected message at the SubscriptionContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'SubscriptionCommand Stream Intake' is from outlet SubscriptionContext.SubscriptionCommandStreamOut to inlet SubscriptionContext.Subscription.SubscriptionCommands  connector 'SubscriptionResult Stream Egress' is from outlet SubscriptionContext.SubscriptionRepository.SubscriptionRepositoryResponses to inlet SubscriptionContext.SubscriptionResultStreamIn  adaptor FromInvoiceService from context InvoiceService is { 
    handler FromInvoiceServiceHandler is {
      on event InvoiceService.InvoiceGenerated is {
        do "the model receives invoice generated"
      }
      on other is {
        error "Unexpected message for adaptor FromInvoiceService"
      }
    } with {
      briefly "from invoice service"
      described as {
        |Carries messages from the external InvoiceService.
      }
    }
  } with {
    briefly "InvoiceService integration"
    described as {
      |The model's side of the InvoiceService conversation.
    }
  }
  adaptor ToInvoiceService to context InvoiceService is { 
    handler ToInvoiceServiceHandler is {
      on command InvoiceService.GenerateInvoice is {
        do "the model sends generate invoice"
      }
      on other is {
        error "Unexpected message for adaptor ToInvoiceService"
      }
    } with {
      briefly "to invoice service"
      described as {
        |Carries messages to the external InvoiceService.
      }
    }
  } with {
    briefly "InvoiceService integration"
    described as {
      |The model's side of the InvoiceService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendSubscriptionNotification is {
        do "the model sends send subscription notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentGatewayService from context PaymentGatewayService is { 
    handler FromPaymentGatewayServiceHandler is {
      on event PaymentGatewayService.PaymentChargeFailed is {
        do "the model receives payment charge failed"
      }
      on event PaymentGatewayService.PaymentCharged is {
        do "the model receives payment charged"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentGatewayService"
      }
    } with {
      briefly "from payment gateway service"
      described as {
        |Carries messages from the external PaymentGatewayService.
      }
    }
  } with {
    briefly "PaymentGatewayService integration"
    described as {
      |The model's side of the PaymentGatewayService conversation.
    }
  }
  adaptor ToPaymentGatewayService to context PaymentGatewayService is { 
    handler ToPaymentGatewayServiceHandler is {
      on command PaymentGatewayService.ChargePayment is {
        do "the model sends charge payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentGatewayService"
      }
    } with {
      briefly "to payment gateway service"
      described as {
        |Carries messages to the external PaymentGatewayService.
      }
    }
  } with {
    briefly "PaymentGatewayService integration"
    described as {
      |The model's side of the PaymentGatewayService conversation.
    }
  }
  adaptor FromProvisioningService from context ProvisioningService is { 
    handler FromProvisioningServiceHandler is {
      on event ProvisioningService.AccessProvisioned is {
        do "the model receives access provisioned"
      }
      on event ProvisioningService.AccessRevoked is {
        do "the model receives access revoked"
      }
      on other is {
        error "Unexpected message for adaptor FromProvisioningService"
      }
    } with {
      briefly "from provisioning service"
      described as {
        |Carries messages from the external ProvisioningService.
      }
    }
  } with {
    briefly "ProvisioningService integration"
    described as {
      |The model's side of the ProvisioningService conversation.
    }
  }
  adaptor ToProvisioningService to context ProvisioningService is { 
    handler ToProvisioningServiceHandler is {
      on command ProvisioningService.ProvisionAccess is {
        do "the model sends provision access"
      }
      on command ProvisioningService.RevokeAccess is {
        do "the model sends revoke access"
      }
      on other is {
        error "Unexpected message for adaptor ToProvisioningService"
      }
    } with {
      briefly "to provisioning service"
      described as {
        |Carries messages to the external ProvisioningService.
      }
    }
  } with {
    briefly "ProvisioningService integration"
    described as {
      |The model's side of the ProvisioningService conversation.
    }
  }
  adaptor FromUsageMeteringService from context UsageMeteringService is { 
    handler FromUsageMeteringServiceHandler is {
      on result UsageMeteringService.UsageData is {
        do "the model receives usage data"
      }
      on other is {
        error "Unexpected message for adaptor FromUsageMeteringService"
      }
    } with {
      briefly "from usage metering service"
      described as {
        |Carries messages from the external UsageMeteringService.
      }
    }
  } with {
    briefly "UsageMeteringService integration"
    described as {
      |The model's side of the UsageMeteringService conversation.
    }
  }
  adaptor ToUsageMeteringService to context UsageMeteringService is { 
    handler ToUsageMeteringServiceHandler is {
      on query UsageMeteringService.GetUsage is {
        do "the model sends get usage"
      }
      on other is {
        error "Unexpected message for adaptor ToUsageMeteringService"
      }
    } with {
      briefly "to usage metering service"
      described as {
        |Carries messages to the external UsageMeteringService.
      }
    }
  } with {
    briefly "UsageMeteringService integration"
    described as {
      |The model's side of the UsageMeteringService conversation.
    }
  }
  include "types.riddl"
  include "Subscription.riddl"
  // Repository for subscription persistence
  type SubscriptionRepositoryCommand is one of {
    SubscriptionContext.SubscriptionRepository.PersistDiscountApplied or SubscriptionContext.SubscriptionRepository.PersistPaymentFailed or SubscriptionContext.SubscriptionRepository.PersistPaymentReceived or SubscriptionContext.SubscriptionRepository.PersistPlanChanged or SubscriptionContext.SubscriptionRepository.PersistSubscriptionCanceled or SubscriptionContext.SubscriptionRepository.PersistSubscriptionCreated or SubscriptionContext.SubscriptionRepository.PersistSubscriptionReactivated or SubscriptionContext.SubscriptionRepository.PersistSubscriptionRenewed or SubscriptionContext.SubscriptionRepository.PersistSubscriptionSuspended or SubscriptionContext.SubscriptionRepository.PersistTrialConverted or SubscriptionContext.SubscriptionRepository.PersistTrialStarted
  } with {
    briefly "Anything that writes SubscriptionRepository"
    described as {
      |The persistence commands SubscriptionRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository SubscriptionRepository as flow is {
    inlet SubscriptionRepositoryFromSubscriptionAnalytics is type SubscriptionRepositoryCommand
    command PersistDiscountApplied is  {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row DiscountApplied applies to.
        }
      }
    } with {
      briefly "Persist DiscountApplied"
      described as {
        |Instructs this repository to apply DiscountApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentFailed is  {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentFailed applies to.
        }
      }
    } with {
      briefly "Persist PaymentFailed"
      described as {
        |Instructs this repository to apply PaymentFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlanChanged is  {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlanChanged applies to.
        }
      }
    } with {
      briefly "Persist PlanChanged"
      described as {
        |Instructs this repository to apply PlanChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubscriptionReactivated is  {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubscriptionReactivated applies to.
        }
      }
    } with {
      briefly "Persist SubscriptionReactivated"
      described as {
        |Instructs this repository to apply SubscriptionReactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubscriptionRenewed is  {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubscriptionRenewed applies to.
        }
      }
    } with {
      briefly "Persist SubscriptionRenewed"
      described as {
        |Instructs this repository to apply SubscriptionRenewed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubscriptionSuspended is  {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubscriptionSuspended applies to.
        }
      }
    } with {
      briefly "Persist SubscriptionSuspended"
      described as {
        |Instructs this repository to apply SubscriptionSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrialStarted is  {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrialStarted applies to.
        }
      }
    } with {
      briefly "Persist TrialStarted"
      described as {
        |Instructs this repository to apply TrialStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentReceived is  {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentReceived applies to.
        }
      }
    } with {
      briefly "Persist PaymentReceived"
      described as {
        |Instructs this repository to apply PaymentReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubscriptionCanceled is  {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubscriptionCanceled applies to.
        }
      }
    } with {
      briefly "Persist SubscriptionCanceled"
      described as {
        |Instructs this repository to apply SubscriptionCanceled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubscriptionCreated is  {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubscriptionCreated applies to.
        }
      }
    } with {
      briefly "Persist SubscriptionCreated"
      described as {
        |Instructs this repository to apply SubscriptionCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrialConverted is  {
      subscriptionId: SubscriptionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrialConverted applies to.
        }
      }
    } with {
      briefly "Persist TrialConverted"
      described as {
        |Instructs this repository to apply TrialConverted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet SubscriptionRepositoryResponses is type Subscription.SubscriptionResult
    record StoredSubscription is  {
      subscriptionId: SubscriptionId with {
        briefly "subscriptionId"
        described as {
          |The subscriptionId column of the stored subscription row.
        }
      }
      customer: CustomerInfo with {
        briefly "customer"
        described as {
          |The customer column of the stored subscription row.
        }
      }
    } with {
      briefly "Stored subscription row"
      described as {
        |The persistence shape of subscription data as this repository stores it.
      }
    }
    schema SubscriptionData is relational
      of subscriptions as type StoredSubscription
        index on field StoredSubscription.subscriptionId
        index on field StoredSubscription.customer.customerId
 with {
      briefly "Subscription data schema"
      described as {
        |The relational schema holding subscription data for the SubscriptionRepository.
      }
    }
    handler SubscriptionPersistence is {
      on persistDiscountApplied: command PersistDiscountApplied is {
        do "apply DiscountApplied to the stored row"
      }
      on persistPaymentFailed: command PersistPaymentFailed is {
        do "apply PaymentFailed to the stored row"
      }
      on persistPlanChanged: command PersistPlanChanged is {
        do "apply PlanChanged to the stored row"
      }
      on persistSubscriptionReactivated: command PersistSubscriptionReactivated is {
        do "apply SubscriptionReactivated to the stored row"
      }
      on persistSubscriptionRenewed: command PersistSubscriptionRenewed is {
        do "apply SubscriptionRenewed to the stored row"
      }
      on persistSubscriptionSuspended: command PersistSubscriptionSuspended is {
        do "apply SubscriptionSuspended to the stored row"
      }
      on persistTrialStarted: command PersistTrialStarted is {
        do "apply TrialStarted to the stored row"
      }
      on persistPaymentReceived: command PersistPaymentReceived is {
        do "apply PaymentReceived to the stored row"
      }
      on persistSubscriptionCanceled: command PersistSubscriptionCanceled is {
        do "apply SubscriptionCanceled to the stored row"
      }
      on persistSubscriptionCreated: command PersistSubscriptionCreated is {
        do "apply SubscriptionCreated to the stored row"
      }
      on persistTrialConverted: command PersistTrialConverted is {
        do "apply TrialConverted to the stored row"
      }
      on query GetSubscriptionStats is {
        let subscriptionStatsView: type SubscriptionStatsView = prompt("read the subscription stats projection")
        reply subscriptionStatsView
      }
    } with {
      briefly "Persists subscription commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Subscription data persistence"
    described as {
      | The SubscriptionRepository provides persistent storage for
      | subscriptions, billing, and payment history.
    }
  }
  // Projector for subscription analytics
  query GetSubscriptionStats replies result SubscriptionStatsView is  {
    subscriptionStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which subscription stats to retrieve.
      }
    }
  } with {
    briefly "Get subscription stats"
    described as {
      |Retrieves the subscription stats projection.
    }
  }
  result SubscriptionStatsView is  {
    subscriptionStats: SubscriptionAnalytics.SubscriptionStats with {
      briefly "Subscription stats"
      described as {
        |The subscription stats being returned.
      }
    }
  } with {
    briefly "Subscription stats view"
    described as {
      |Read model view carrying the subscription stats projection.
    }
  }
  projector SubscriptionAnalytics as flow is {
    outlet SubscriptionAnalyticsToRepository is type SubscriptionRepositoryCommand
    updates repository SubscriptionContext.SubscriptionRepository
    inlet SubscriptionAnalyticsFromSubscription is type SubscriptionEvent
    record SubscriptionStats is  {
      totalSubscriptions: Natural with {
        briefly "Total"
        described as {
          |Total subscriptions.
        }
      }
      activeSubscriptions: Natural with {
        briefly "Active"
        described as {
          |Active subscriptions.
        }
      }
      mrr: Decimal(15,2) with {
        briefly "MRR"
        described as {
          |Monthly recurring revenue.
        }
      }
      arr: Decimal(18,2) with {
        briefly "ARR"
        described as {
          |Annual recurring revenue.
        }
      }
      churnRate: Decimal(5,4) with {
        briefly "Churn"
        described as {
          |Churn rate.
        }
      }
      trialConversionRate: Decimal(5,4) with {
        briefly "Conversion"
        described as {
          |Trial conversion rate.
        }
      }
    } with {
      briefly "Subscription statistics"
      described as {
        |SaaS subscription metrics.
      }
    }
    handler AnalyticsHandler is {
      on discountApplied: event Subscription.DiscountApplied is {
        tell command SubscriptionContext.SubscriptionRepository.PersistDiscountApplied(subscriptionId = discountApplied.subscriptionId) to repository SubscriptionContext.SubscriptionRepository
        do "apply DiscountApplied to the SubscriptionAnalytics projection"
      }
      on paymentFailed: event Subscription.PaymentFailed is {
        tell command SubscriptionContext.SubscriptionRepository.PersistPaymentFailed(subscriptionId = paymentFailed.subscriptionId) to repository SubscriptionContext.SubscriptionRepository
        do "apply PaymentFailed to the SubscriptionAnalytics projection"
      }
      on planChanged: event Subscription.PlanChanged is {
        tell command SubscriptionContext.SubscriptionRepository.PersistPlanChanged(subscriptionId = planChanged.subscriptionId) to repository SubscriptionContext.SubscriptionRepository
        do "apply PlanChanged to the SubscriptionAnalytics projection"
      }
      on subscriptionReactivated: event Subscription.SubscriptionReactivated is {
        tell command SubscriptionContext.SubscriptionRepository.PersistSubscriptionReactivated(subscriptionId = subscriptionReactivated.subscriptionId) to repository SubscriptionContext.SubscriptionRepository
        do "apply SubscriptionReactivated to the SubscriptionAnalytics projection"
      }
      on subscriptionRenewed: event Subscription.SubscriptionRenewed is {
        tell command SubscriptionContext.SubscriptionRepository.PersistSubscriptionRenewed(subscriptionId = subscriptionRenewed.subscriptionId) to repository SubscriptionContext.SubscriptionRepository
        do "apply SubscriptionRenewed to the SubscriptionAnalytics projection"
      }
      on subscriptionSuspended: event Subscription.SubscriptionSuspended is {
        tell command SubscriptionContext.SubscriptionRepository.PersistSubscriptionSuspended(subscriptionId = subscriptionSuspended.subscriptionId) to repository SubscriptionContext.SubscriptionRepository
        do "apply SubscriptionSuspended to the SubscriptionAnalytics projection"
      }
      on trialStarted: event Subscription.TrialStarted is {
        tell command SubscriptionContext.SubscriptionRepository.PersistTrialStarted(subscriptionId = trialStarted.subscriptionId) to repository SubscriptionContext.SubscriptionRepository
        do "apply TrialStarted to the SubscriptionAnalytics projection"
      }
      on subscriptionCreated: event Subscription.SubscriptionCreated is {
        tell command SubscriptionContext.SubscriptionRepository.PersistSubscriptionCreated(subscriptionId = subscriptionCreated.subscriptionId) to repository SubscriptionContext.SubscriptionRepository
      }
      on paymentReceived: event Subscription.PaymentReceived is {
        tell command SubscriptionContext.SubscriptionRepository.PersistPaymentReceived(subscriptionId = paymentReceived.subscriptionId) to repository SubscriptionContext.SubscriptionRepository
      }
      on subscriptionCanceled: event Subscription.SubscriptionCanceled is {
        tell command SubscriptionContext.SubscriptionRepository.PersistSubscriptionCanceled(subscriptionId = subscriptionCanceled.subscriptionId) to repository SubscriptionContext.SubscriptionRepository
      }
      on trialConverted: event Subscription.TrialConverted is {
        tell command SubscriptionContext.SubscriptionRepository.PersistTrialConverted(subscriptionId = trialConverted.subscriptionId) to repository SubscriptionContext.SubscriptionRepository
      }
    } with {
      briefly "Maintains subscription analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Subscription analytics projections"
    described as {
      |Maintains SaaS subscription analytics data.
    }
  }
  // Event streaming infrastructure
  type SubscriptionEvent is one of {
    SubscriptionContext.Subscription.SubscriptionCreated or SubscriptionContext.Subscription.TrialStarted or SubscriptionContext.Subscription.TrialConverted or SubscriptionContext.Subscription.PlanChanged or SubscriptionContext.Subscription.PaymentReceived or SubscriptionContext.Subscription.DiscountApplied or SubscriptionContext.Subscription.PaymentFailed or SubscriptionContext.Subscription.SubscriptionCanceled or SubscriptionContext.Subscription.SubscriptionReactivated or SubscriptionContext.Subscription.SubscriptionRenewed or SubscriptionContext.Subscription.SubscriptionSuspended
  } with {
    briefly "Subscription events"
    described as {
      |Union of all Subscription events for streaming.
    }
  }
  processor SubscriptionSource as source is {
    outlet SubscriptionEventOutlet is type SubscriptionEvent
 with {
      briefly "Event outlet"
      described as {
        |Outlet for Subscription events.
      }
    }
    handler SubscriptionSourceHandler is {
      on init is {
        let initializeSubscription: type Subscription.InitializeSubscription = prompt("the initialize subscription that brings this this into existence")
        tell initializeSubscription to entity SubscriptionContext.Subscription
      }
      on subscriptionCreated: event Subscription.SubscriptionCreated is {
        send subscriptionCreated to outlet SubscriptionEventOutlet
      }
      on trialStarted: event Subscription.TrialStarted is {
        send trialStarted to outlet SubscriptionEventOutlet
      }
      on trialConverted: event Subscription.TrialConverted is {
        send trialConverted to outlet SubscriptionEventOutlet
      }
      on planChanged: event Subscription.PlanChanged is {
        send planChanged to outlet SubscriptionEventOutlet
      }
      on paymentReceived: event Subscription.PaymentReceived is {
        send paymentReceived to outlet SubscriptionEventOutlet
      }
      on other is {
        error "Unexpected message for source SubscriptionSource"
      }
    } with {
      briefly "Source handler"
      described as {
        |Handles Subscription events for streaming.
      }
    }
  } with {
    briefly "Subscription event source"
    described as {
      |Publishes Subscription events to the event stream.
    }
  }
  processor SubscriptionSink as sink is {
    inlet SubscriptionEventInlet is type SubscriptionEvent with {
      briefly "Event inlet"
      described as {
        |Inlet for Subscription events.
      }
    }
    handler SubscriptionSinkHandler is {
      on init is { ??? }
      on subscriptionCreated: event Subscription.SubscriptionCreated is {
        tell subscriptionCreated to repository SubscriptionContext.SubscriptionRepository
      }
      on trialStarted: event Subscription.TrialStarted is {
        tell trialStarted to repository SubscriptionContext.SubscriptionRepository
      }
      on trialConverted: event Subscription.TrialConverted is {
        tell trialConverted to repository SubscriptionContext.SubscriptionRepository
      }
      on planChanged: event Subscription.PlanChanged is {
        tell planChanged to repository SubscriptionContext.SubscriptionRepository
      }
      on paymentReceived: event Subscription.PaymentReceived is {
        tell paymentReceived to repository SubscriptionContext.SubscriptionRepository
      }
      on other is {
        error "Unexpected message for sink SubscriptionSink"
      }
    } with {
      briefly "Sink handler"
      described as {
        |Handles incoming Subscription events for persistence.
      }
    }
  } with {
    briefly "Subscription event sink"
    described as {
      |Receives Subscription events for persistence.
    }
  }
  connector SubscriptionEventFlow is from outlet SubscriptionContext.SubscriptionSource.SubscriptionEventOutlet to inlet SubscriptionContext.SubscriptionSink.SubscriptionEventInlet with {
    briefly "Subscription event connector"
    described as {
      |Wires Subscription source to sink for event flow.
    }
  }
  processor SubscriptionEventSplit as flow is {
    inlet SubscriptionEventSplitIn is type SubscriptionEvent
    outlet SubscriptionEventSplitToSubscriptionAnalytics is type SubscriptionEvent
    handler SubscriptionEventSplitHandler is {
      on subscriptionCreated: event Subscription.SubscriptionCreated is {
        send subscriptionCreated to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell subscriptionCreated to entity SubscriptionContext.Subscription
      }
      on trialStarted: event Subscription.TrialStarted is {
        send trialStarted to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell trialStarted to entity SubscriptionContext.Subscription
      }
      on trialConverted: event Subscription.TrialConverted is {
        send trialConverted to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell trialConverted to entity SubscriptionContext.Subscription
      }
      on planChanged: event Subscription.PlanChanged is {
        send planChanged to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell planChanged to entity SubscriptionContext.Subscription
      }
      on discountApplied: event Subscription.DiscountApplied is {
        send discountApplied to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell discountApplied to entity SubscriptionContext.Subscription
      }
      on paymentReceived: event Subscription.PaymentReceived is {
        send paymentReceived to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell paymentReceived to entity SubscriptionContext.Subscription
      }
      on paymentFailed: event Subscription.PaymentFailed is {
        send paymentFailed to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell paymentFailed to entity SubscriptionContext.Subscription
      }
      on subscriptionSuspended: event Subscription.SubscriptionSuspended is {
        send subscriptionSuspended to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell subscriptionSuspended to entity SubscriptionContext.Subscription
      }
      on subscriptionReactivated: event Subscription.SubscriptionReactivated is {
        send subscriptionReactivated to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell subscriptionReactivated to entity SubscriptionContext.Subscription
      }
      on subscriptionCanceled: event Subscription.SubscriptionCanceled is {
        send subscriptionCanceled to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell subscriptionCanceled to entity SubscriptionContext.Subscription
      }
      on subscriptionRenewed: event Subscription.SubscriptionRenewed is {
        send subscriptionRenewed to outlet SubscriptionEventSplitToSubscriptionAnalytics
        tell subscriptionRenewed to entity SubscriptionContext.Subscription
      }
      on other is {
        error "Unexpected message for processor SubscriptionEventSplit"
      }
    } with {
      briefly "Subscription event fan-out handler"
      described as {
        |Delivers each Subscription event to all of its consumers.
      }
    }
  } with {
    briefly "Subscription event fan-out"
    described as {
      |Fans Subscription events out to the repository and projectors.
    }
  }
  connector 'SubscriptionEvent Stream' is from outlet SubscriptionContext.Subscription.SubscriptionEvents to inlet SubscriptionContext.SubscriptionEventSplit.SubscriptionEventSplitIn with {
    briefly "Subscription events, fanned out to storage and read models"
  }
  connector 'SubscriptionAnalytics Feed' is from outlet SubscriptionContext.SubscriptionEventSplit.SubscriptionEventSplitToSubscriptionAnalytics to inlet SubscriptionContext.SubscriptionAnalytics.SubscriptionAnalyticsFromSubscription with {
    briefly "Subscription events feeding the SubscriptionAnalytics projection"
  }
  connector 'SubscriptionAnalytics Storage' is from outlet SubscriptionContext.SubscriptionAnalytics.SubscriptionAnalyticsToRepository to inlet SubscriptionContext.SubscriptionRepository.SubscriptionRepositoryFromSubscriptionAnalytics with {
    briefly "SubscriptionAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for subscription management"
  described as {
    | The SubscriptionContext is the bounded context for
    | SaaS subscription billing and lifecycle management.
  }
}
