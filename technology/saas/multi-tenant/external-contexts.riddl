// Multi-Tenant Management - External Contexts
external context InfrastructureProvisioning as flow is {
  outlet InfrastructureProvisioningEventsOut is event ResourcesProvisioned
 with {
    briefly "What this service tells the model, unasked"
  }
  type InfrastructureProvisioningCommand is one of {
    ProvisionTenantResources or DeprovisionTenantResources
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet InfrastructureProvisioningRequests is type InfrastructureProvisioningCommand with {
    briefly "What this context asks the service to send"
  }
  handler InfrastructureProvisioningBoundary is {
    on command ProvisionTenantResources is {
      let resourcesProvisioned: type ResourcesProvisioned = prompt("the resources provisioned this produces")
      send resourcesProvisioned to outlet InfrastructureProvisioning.InfrastructureProvisioningEventsOut
      do "deliver it to the recipient"
    }
    on command DeprovisionTenantResources is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context InfrastructureProvisioning"
    }
  } with {
    briefly "InfrastructureProvisioning boundary"
  }
  command ProvisionTenantResources is {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    isolationLevel: IsolationLevel with {
      briefly "Isolation"
      described as {
        |Isolation level.
      }
    }
    region: String(1,50) with {
      briefly "Region"
      described as {
        |Cloud region.
      }
    }
  } with {
    briefly "Provision tenant resources"
    described as {
      |Provisions infrastructure.
    }
  }
  event ResourcesProvisioned is {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    databaseEndpoint: String(1,200) with {
      briefly "DB endpoint"
      described as {
        |Database endpoint.
      }
    }
    storageEndpoint: String(1,200) with {
      briefly "Storage"
      described as {
        |Storage endpoint.
      }
    }
    provisionedAt: TimeStamp with {
      briefly "Provisioned"
      described as {
        |Provision time.
      }
    }
  } with {
    briefly "Resources provisioned"
    described as {
      |Emitted when resources ready.
    }
  }
  command DeprovisionTenantResources is {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    retentionDays: Natural with {
      briefly "Retention"
      described as {
        |Data retention days.
      }
    }
  } with {
    briefly "Deprovision tenant resources"
    described as {
      |Removes infrastructure.
    }
  }
} with {
  briefly "External infrastructure provisioning"
  described as {
    |Cloud infrastructure management.
  }
}
external context IdentityProvider as flow is {
  outlet IdentityProviderEventsOut is event RealmCreated
 with {
    briefly "What this service tells the model, unasked"
  }
  type IdentityProviderCommand is one of {
    CreateTenantRealm or CreateTenantUser
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet IdentityProviderRequests is type IdentityProviderCommand with {
    briefly "What this context asks the service to send"
  }
  handler IdentityProviderBoundary is {
    on command CreateTenantRealm is {
      let realmCreated: type RealmCreated = prompt("the realm created this produces")
      send realmCreated to outlet IdentityProvider.IdentityProviderEventsOut
      do "deliver it to the recipient"
    }
    on command CreateTenantUser is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context IdentityProvider"
    }
  } with {
    briefly "IdentityProvider boundary"
  }
  command CreateTenantRealm is {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    realmName: String(1,100) with {
      briefly "Realm"
      described as {
        |Realm name.
      }
    }
    ssoConfig: String(1,2000)? with {
      briefly "SSO"
      described as {
        |SSO configuration.
      }
    }
  } with {
    briefly "Create tenant realm"
    described as {
      |Creates identity realm.
    }
  }
  event RealmCreated is {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    realmId: String(1,100) with {
      briefly "Realm"
      described as {
        |Realm ID.
      }
    }
    loginUrl: URL with {
      briefly "Login"
      described as {
        |Login URL.
      }
    }
  } with {
    briefly "Realm created"
    described as {
      |Emitted when realm created.
    }
  }
  command CreateTenantUser is {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    user: TenantUserInfo with {
      briefly "User"
      described as {
        |User info.
      }
    }
  } with {
    briefly "Create tenant user"
    described as {
      |Creates user in realm.
    }
  }
} with {
  briefly "External identity provider"
  described as {
    |Identity and access management.
  }
}
external context BillingSystem as flow is {
  outlet BillingSystemEventsOut is event BillingAccountCreated
 with {
    briefly "What this service tells the model, unasked"
  }
  type BillingSystemCommand is one of {
    CreateBillingAccount or RecordUsageMetrics or UpdateSubscription
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet BillingSystemRequests is type BillingSystemCommand with {
    briefly "What this context asks the service to send"
  }
  handler BillingSystemBoundary is {
    on command CreateBillingAccount is {
      let billingAccountCreated: type BillingAccountCreated = prompt("the billing account created this produces")
      send billingAccountCreated to outlet BillingSystem.BillingSystemEventsOut
      do "deliver it to the recipient"
    }
    on command RecordUsageMetrics is {
      do "deliver it to the recipient"
    }
    on command UpdateSubscription is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context BillingSystem"
    }
  } with {
    briefly "BillingSystem boundary"
  }
  command CreateBillingAccount is {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    tier: TenantTier with {
      briefly "Tier"
      described as {
        |Service tier.
      }
    }
    billingEmail: EmailAddress with {
      briefly "Email"
      described as {
        |Billing email.
      }
    }
  } with {
    briefly "Create billing account"
    described as {
      |Creates billing account.
    }
  }
  event BillingAccountCreated is {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    accountId: String(1,100) with {
      briefly "Account"
      described as {
        |Billing account ID.
      }
    }
  } with {
    briefly "Billing account created"
    described as {
      |Emitted when account created.
    }
  }
  command UpdateSubscription is {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    newTier: TenantTier with {
      briefly "Tier"
      described as {
        |New tier.
      }
    }
    effectiveDate: Date with {
      briefly "Effective"
      described as {
        |Effective date.
      }
    }
  } with {
    briefly "Update subscription"
    described as {
      |Updates subscription tier.
    }
  }
  command RecordUsageMetrics is {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    usage: TenantUsage with {
      briefly "Usage"
      described as {
        |Usage metrics.
      }
    }
    billingPeriod: String(1,20) with {
      briefly "Period"
      described as {
        |Billing period.
      }
    }
  } with {
    briefly "Record usage metrics"
    described as {
      |Records usage for billing.
    }
  }
} with {
  briefly "External billing system"
  described as {
    |Subscription billing system.
  }
}
external context DomainManagement as flow is {
  type DomainManagementEvent is one of {
    DomainVerified or SSLProvisioned
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet DomainManagementEventsOut is type DomainManagementEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type DomainManagementCommand is one of {
    VerifyDomain or ProvisionSSL
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet DomainManagementRequests is type DomainManagementCommand with {
    briefly "What this context asks the service to send"
  }
  handler DomainManagementBoundary is {
    on command VerifyDomain is {
      let domainVerified: type DomainVerified = prompt("the domain verified this produces")
      send domainVerified to outlet DomainManagement.DomainManagementEventsOut
      do "deliver it to the recipient"
    }
    on command ProvisionSSL is {
      let sSLProvisioned: type SSLProvisioned = prompt("the s s l provisioned this produces")
      send sSLProvisioned to outlet DomainManagement.DomainManagementEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context DomainManagement"
    }
  } with {
    briefly "DomainManagement boundary"
  }
  command VerifyDomain is {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    domainName: String(1,) with {
      briefly "Domain"
      described as {
        |Domain name.
      }
    }
    verificationMethod: String(1,20) with {
      briefly "Method"
      described as {
        |Verification method.
      }
    }
  } with {
    briefly "Verify domain"
    described as {
      |Initiates domain verification.
    }
  }
  event DomainVerified is {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    domainName: String(1,) with {
      briefly "Domain"
      described as {
        |Domain name.
      }
    }
    verifiedAt: TimeStamp with {
      briefly "Verified"
      described as {
        |Verification time.
      }
    }
  } with {
    briefly "Domain verified"
    described as {
      |Emitted when domain verified.
    }
  }
  command ProvisionSSL is {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    domainName: String(1,) with {
      briefly "Domain"
      described as {
        |Domain name.
      }
    }
  } with {
    briefly "Provision SSL"
    described as {
      |Provisions SSL certificate.
    }
  }
  event SSLProvisioned is {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    domainName: String(1,) with {
      briefly "Domain"
      described as {
        |Domain name.
      }
    }
    expiryDate: Date with {
      briefly "Expiry"
      described as {
        |Certificate expiry.
      }
    }
  } with {
    briefly "SSL provisioned"
    described as {
      |Emitted when SSL ready.
    }
  }
} with {
  briefly "External domain management"
  described as {
    |Custom domain and SSL management.
  }
}
