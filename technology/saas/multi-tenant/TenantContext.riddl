// Multi-Tenant Management - Tenant Context
context TenantContext is {
  adaptor FromBillingSystem from context BillingSystem is {
    handler FromBillingSystemHandler is {
      on event BillingSystem.BillingAccountCreated is {
        do "the model receives billing account created"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingSystem"
      }
    } with {
      briefly "from billing system"
      described as {
        |Carries messages from the external BillingSystem.
      }
    }
  } with {
      briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor ToBillingSystem to context BillingSystem is {
    handler ToBillingSystemHandler is {
      on command BillingSystem.CreateBillingAccount is {
        do "the model sends create billing account"
      }
      on command BillingSystem.RecordUsageMetrics is {
        do "the model sends record usage metrics"
      }
      on command BillingSystem.UpdateSubscription is {
        do "the model sends update subscription"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingSystem"
      }
    } with {
      briefly "to billing system"
      described as {
        |Carries messages to the external BillingSystem.
      }
    }
  } with {
      briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor FromDomainManagement from context DomainManagement is {
    handler FromDomainManagementHandler is {
      on event DomainManagement.DomainVerified is {
        do "the model receives domain verified"
      }
      on event DomainManagement.SSLProvisioned is {
        do "the model receives ssl provisioned"
      }
      on other is {
        error "Unexpected message for adaptor FromDomainManagement"
      }
    } with {
      briefly "from domain management"
      described as {
        |Carries messages from the external DomainManagement.
      }
    }
  } with {
      briefly "DomainManagement integration"
    described as {
      |The model's side of the DomainManagement conversation.
    }
  }
  adaptor ToDomainManagement to context DomainManagement is {
    handler ToDomainManagementHandler is {
      on command DomainManagement.ProvisionSSL is {
        do "the model sends provision ssl"
      }
      on command DomainManagement.VerifyDomain is {
        do "the model sends verify domain"
      }
      on other is {
        error "Unexpected message for adaptor ToDomainManagement"
      }
    } with {
      briefly "to domain management"
      described as {
        |Carries messages to the external DomainManagement.
      }
    }
  } with {
      briefly "DomainManagement integration"
    described as {
      |The model's side of the DomainManagement conversation.
    }
  }
  adaptor FromIdentityProvider from context IdentityProvider is {
    handler FromIdentityProviderHandler is {
      on event IdentityProvider.RealmCreated is {
        do "the model receives realm created"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityProvider"
      }
    } with {
      briefly "from identity provider"
      described as {
        |Carries messages from the external IdentityProvider.
      }
    }
  } with {
      briefly "IdentityProvider integration"
    described as {
      |The model's side of the IdentityProvider conversation.
    }
  }
  adaptor ToIdentityProvider to context IdentityProvider is {
    handler ToIdentityProviderHandler is {
      on command IdentityProvider.CreateTenantRealm is {
        do "the model sends create tenant realm"
      }
      on command IdentityProvider.CreateTenantUser is {
        do "the model sends create tenant user"
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityProvider"
      }
    } with {
      briefly "to identity provider"
      described as {
        |Carries messages to the external IdentityProvider.
      }
    }
  } with {
      briefly "IdentityProvider integration"
    described as {
      |The model's side of the IdentityProvider conversation.
    }
  }
  adaptor FromInfrastructureProvisioning from context InfrastructureProvisioning is {
    handler FromInfrastructureProvisioningHandler is {
      on event InfrastructureProvisioning.ResourcesProvisioned is {
        do "the model receives resources provisioned"
      }
      on other is {
        error "Unexpected message for adaptor FromInfrastructureProvisioning"
      }
    } with {
      briefly "from infrastructure provisioning"
      described as {
        |Carries messages from the external InfrastructureProvisioning.
      }
    }
  } with {
      briefly "InfrastructureProvisioning integration"
    described as {
      |The model's side of the InfrastructureProvisioning conversation.
    }
  }
  adaptor ToInfrastructureProvisioning to context InfrastructureProvisioning is {
    handler ToInfrastructureProvisioningHandler is {
      on command InfrastructureProvisioning.DeprovisionTenantResources is {
        do "the model sends deprovision tenant resources"
      }
      on command InfrastructureProvisioning.ProvisionTenantResources is {
        do "the model sends provision tenant resources"
      }
      on other is {
        error "Unexpected message for adaptor ToInfrastructureProvisioning"
      }
    } with {
      briefly "to infrastructure provisioning"
      described as {
        |Carries messages to the external InfrastructureProvisioning.
      }
    }
  } with {
      briefly "InfrastructureProvisioning integration"
    described as {
      |The model's side of the InfrastructureProvisioning conversation.
    }
  }
  include "types.riddl"
  include "Tenant.riddl"
  repository TenantRepository is {
    inlet TenantRepositoryFromTenant is type TenantEvent
    inlet TenantRepositoryFromPlatformAnalytics is type TenantEvent
    outlet TenantRepositoryResponses is type Tenant.TenantResult
    record StoredTenant is {
      tenantId: TenantId with {
        briefly "tenantId"
        described as {
          |The tenantId column of the stored tenant row.
        }
      }
      status: TenantStatus with {
        briefly "status"
        described as {
          |The status column of the stored tenant row.
        }
      }
      tenantInfo: TenantInfo with {
        briefly "tenantInfo"
        described as {
          |The tenantInfo column of the stored tenant row.
        }
      }
    } with {
      briefly "Stored tenant row"
      described as {
        |The persistence shape of tenant data as this repository stores it.
      }
    }
    schema TenantData is relational
      of tenants as type StoredTenant
        index on field StoredTenant.tenantId
        index on field StoredTenant.tenantInfo.subdomain
        index on field StoredTenant.status
        index on field StoredTenant.tenantInfo.tier
      with {
      briefly "Tenant data schema"
      described as {
        |The relational schema holding tenant data for the TenantRepository.
      }
    }

    handler TenantPersistence is {
      on query GetPlatformMetrics is {
        do "read the platform metrics projection"
        yield result PlatformMetricsView
      }
      on command Tenant.ProvisionTenant is {
        tell event Tenant.TenantProvisioned to entity TenantContext.Tenant
      }
      on command Tenant.ActivateTenant is {
        tell event Tenant.TenantActivated to entity TenantContext.Tenant
      }
      on command Tenant.UpdateSettings is {
        tell event Tenant.SettingsUpdated to entity TenantContext.Tenant
      }
      on command Tenant.AddUser is {
        tell event Tenant.UserAdded to entity TenantContext.Tenant
      }
      on command Tenant.RecordUsage is {
        tell event Tenant.UsageRecorded to entity TenantContext.Tenant
      }
      on command Tenant.DeactivateTenant is {
        tell event Tenant.TenantDeactivated to entity TenantContext.Tenant
      }
    } with {
      briefly "Persists tenant commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Tenant data persistence"
    described as {
      |Persistent storage for tenants.
    }
  }
  query GetPlatformMetrics is {
    platformMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which platform metrics to retrieve.
      }
    }
  } with {
    briefly "Get platform metrics"
    described as {
      |Retrieves the platform metrics projection.
    }
  }
  result PlatformMetricsView is {
    platformMetrics: PlatformAnalytics.PlatformMetrics with {
      briefly "Platform metrics"
      described as {
        |The platform metrics being returned.
      }
    }
  } with {
    briefly "Platform metrics view"
    described as {
      |Read model view carrying the platform metrics projection.
    }
  }
  projector PlatformAnalytics is {
    inlet PlatformAnalyticsFromTenant is type TenantEvent
    outlet PlatformAnalyticsOut is type TenantEvent
    updates repository TenantContext.TenantRepository
    record PlatformMetrics is  {
      totalTenants: Natural with {
        briefly "Total"
        described as {
          |Total tenants.
        }
      }
      activeTenants: Natural with {
        briefly "Active"
        described as {
          |Active tenants.
        }
      }
      totalUsers: Natural with {
        briefly "Users"
        described as {
          |Total users.
        }
      }
      totalStorageGB: Decimal(15,2) with {
        briefly "Storage"
        described as {
          |Total storage.
        }
      }
      mrr: Decimal(15,2) with {
        briefly "MRR"
        described as {
          |Monthly recurring revenue.
        }
      }
    } with {
      briefly "Platform metrics"
      described as {
        |Platform-wide metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Tenant.TenantProvisioned is {
        tell event Tenant.TenantProvisioned to repository TenantContext.TenantRepository
      }
      on event Tenant.UserAdded is {
        tell event Tenant.UserAdded to repository TenantContext.TenantRepository
      }
      on event Tenant.UsageRecorded is {
        tell event Tenant.UsageRecorded to repository TenantContext.TenantRepository
      }
      on event Tenant.TierChanged is {
        tell event Tenant.TierChanged to repository TenantContext.TenantRepository
      }
    } with {
      briefly "Maintains platform analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Platform analytics"
    described as {
      |Multi-tenant platform metrics.
    }
  }
  // Event streaming infrastructure
  type TenantEvent is one of {
    TenantContext.Tenant.TenantProvisioned,
    TenantContext.Tenant.TenantActivated,
    TenantContext.Tenant.SettingsUpdated,
    TenantContext.Tenant.UserAdded,
    TenantContext.Tenant.TenantDeactivated
  } with {
    briefly "Tenant events"
    described as {
      |Union of all Tenant events for streaming.
    }
  }
  processor TenantSource as source is {
    outlet TenantEventOutlet is type TenantEvent with {
      briefly "Event outlet"
      described as {
        |Outlet for Tenant events.
      }
    }
    handler TenantSourceHandler is {
      on init is {
        tell command Tenant.InitializeTenant to entity TenantContext.Tenant
      }
      on event Tenant.TenantProvisioned is {
        send event Tenant.TenantProvisioned to outlet TenantEventOutlet
      }
      on event Tenant.TenantActivated is {
        send event Tenant.TenantActivated to outlet TenantEventOutlet
      }
      on event Tenant.SettingsUpdated is {
        send event Tenant.SettingsUpdated to outlet TenantEventOutlet
      }
      on event Tenant.UserAdded is {
        send event Tenant.UserAdded to outlet TenantEventOutlet
      }
      on event Tenant.TenantDeactivated is {
        send event Tenant.TenantDeactivated to outlet TenantEventOutlet
      }
      on other is {
        error "Unexpected message for source TenantSource"
      }
    } with {
      briefly "Source handler"
      described as {
        |Handles Tenant events for streaming.
      }
    }
  } with {
    briefly "Tenant event source"
    described as {
      |Publishes Tenant events to the event stream.
    }
  }
  processor TenantSink as sink is {
    inlet TenantEventInlet is type TenantEvent with {
      briefly "Event inlet"
      described as {
        |Inlet for Tenant events.
      }
    }
    handler TenantSinkHandler is {
      on init is { ??? }
      on event Tenant.TenantProvisioned is {
        tell event Tenant.TenantProvisioned to repository TenantContext.TenantRepository
      }
      on event Tenant.TenantActivated is {
        tell event Tenant.TenantActivated to repository TenantContext.TenantRepository
      }
      on event Tenant.SettingsUpdated is {
        tell event Tenant.SettingsUpdated to repository TenantContext.TenantRepository
      }
      on event Tenant.UserAdded is {
        tell event Tenant.UserAdded to repository TenantContext.TenantRepository
      }
      on event Tenant.TenantDeactivated is {
        tell event Tenant.TenantDeactivated to repository TenantContext.TenantRepository
      }
      on other is {
        error "Unexpected message for sink TenantSink"
      }
    } with {
      briefly "Sink handler"
      described as {
        |Handles incoming Tenant events for persistence.
      }
    }
  } with {
    briefly "Tenant event sink"
    described as {
      |Receives Tenant events for persistence.
    }
  }
  connector TenantEventFlow is {
    from outlet TenantContext.TenantSource.TenantEventOutlet to
      inlet TenantContext.TenantSink.TenantEventInlet
  } with {
    briefly "Tenant event connector"
    described as {
      |Wires Tenant source to sink for event flow.
    }
  }
  processor TenantEventSplit is {
    inlet TenantEventSplitIn is type TenantEvent
    outlet TenantEventSplitToTenantRepository is type TenantEvent
    outlet TenantEventSplitToPlatformAnalytics is type TenantEvent
    handler TenantEventSplitHandler is {
      on event Tenant.TenantProvisioned is {
        send event Tenant.TenantProvisioned to outlet TenantEventSplitToTenantRepository
        send event Tenant.TenantProvisioned to outlet TenantEventSplitToPlatformAnalytics
        tell event Tenant.TenantProvisioned to entity TenantContext.Tenant
      }
      on event Tenant.TenantActivated is {
        send event Tenant.TenantActivated to outlet TenantEventSplitToTenantRepository
        send event Tenant.TenantActivated to outlet TenantEventSplitToPlatformAnalytics
        tell event Tenant.TenantActivated to entity TenantContext.Tenant
      }
      on event Tenant.SettingsUpdated is {
        send event Tenant.SettingsUpdated to outlet TenantEventSplitToTenantRepository
        send event Tenant.SettingsUpdated to outlet TenantEventSplitToPlatformAnalytics
        tell event Tenant.SettingsUpdated to entity TenantContext.Tenant
      }
      on event Tenant.LimitsUpdated is {
        send event Tenant.LimitsUpdated to outlet TenantEventSplitToTenantRepository
        send event Tenant.LimitsUpdated to outlet TenantEventSplitToPlatformAnalytics
        tell event Tenant.LimitsUpdated to entity TenantContext.Tenant
      }
      on event Tenant.TierChanged is {
        send event Tenant.TierChanged to outlet TenantEventSplitToTenantRepository
        send event Tenant.TierChanged to outlet TenantEventSplitToPlatformAnalytics
        tell event Tenant.TierChanged to entity TenantContext.Tenant
      }
      on event Tenant.UserAdded is {
        send event Tenant.UserAdded to outlet TenantEventSplitToTenantRepository
        send event Tenant.UserAdded to outlet TenantEventSplitToPlatformAnalytics
        tell event Tenant.UserAdded to entity TenantContext.Tenant
      }
      on event Tenant.UserRemoved is {
        send event Tenant.UserRemoved to outlet TenantEventSplitToTenantRepository
        send event Tenant.UserRemoved to outlet TenantEventSplitToPlatformAnalytics
        tell event Tenant.UserRemoved to entity TenantContext.Tenant
      }
      on event Tenant.CustomDomainConfigured is {
        send event Tenant.CustomDomainConfigured to outlet TenantEventSplitToTenantRepository
        send event Tenant.CustomDomainConfigured to outlet TenantEventSplitToPlatformAnalytics
        tell event Tenant.CustomDomainConfigured to entity TenantContext.Tenant
      }
      on event Tenant.UsageRecorded is {
        send event Tenant.UsageRecorded to outlet TenantEventSplitToTenantRepository
        send event Tenant.UsageRecorded to outlet TenantEventSplitToPlatformAnalytics
        tell event Tenant.UsageRecorded to entity TenantContext.Tenant
      }
      on event Tenant.TenantSuspended is {
        send event Tenant.TenantSuspended to outlet TenantEventSplitToTenantRepository
        send event Tenant.TenantSuspended to outlet TenantEventSplitToPlatformAnalytics
        tell event Tenant.TenantSuspended to entity TenantContext.Tenant
      }
      on event Tenant.TenantReactivated is {
        send event Tenant.TenantReactivated to outlet TenantEventSplitToTenantRepository
        send event Tenant.TenantReactivated to outlet TenantEventSplitToPlatformAnalytics
        tell event Tenant.TenantReactivated to entity TenantContext.Tenant
      }
      on event Tenant.TenantDeactivated is {
        send event Tenant.TenantDeactivated to outlet TenantEventSplitToTenantRepository
        send event Tenant.TenantDeactivated to outlet TenantEventSplitToPlatformAnalytics
        tell event Tenant.TenantDeactivated to entity TenantContext.Tenant
      }
      on other is {
        error "Unexpected message for processor TenantEventSplit"
      }
    } with {
      briefly "Tenant event fan-out handler"
      described as {
        |Delivers each Tenant event to all of its consumers.
      }
    }
  } with {
    briefly "Tenant event fan-out"
    described as {
      |Fans Tenant events out to the repository and projectors.
    }
  }
  connector LinkTenantToTenantEventSplit is {
    from outlet TenantContext.Tenant.TenantEvents to
      inlet TenantContext.TenantEventSplit.TenantEventSplitIn
  } with {
    briefly "LinkTenantToTenantEventSplit"
  }
  connector LinkTenantEventSplitToTenantRepository is {
    from outlet TenantContext.TenantEventSplit.TenantEventSplitToTenantRepository to
      inlet TenantContext.TenantRepository.TenantRepositoryFromTenant
  } with {
    briefly "LinkTenantEventSplitToTenantRepository"
  }
  connector LinkTenantEventSplitToPlatformAnalytics is {
    from outlet TenantContext.TenantEventSplit.TenantEventSplitToPlatformAnalytics to
      inlet TenantContext.PlatformAnalytics.PlatformAnalyticsFromTenant
  } with {
    briefly "LinkTenantEventSplitToPlatformAnalytics"
  }
  connector LinkPlatformAnalyticsToTenantRepository is {
    from outlet TenantContext.PlatformAnalytics.PlatformAnalyticsOut to
      inlet TenantContext.TenantRepository.TenantRepositoryFromPlatformAnalytics
  } with {
    briefly "LinkPlatformAnalyticsToTenantRepository"
  }
} with {
  briefly "Bounded context for multi-tenant management"
  described as {
    |SaaS multi-tenancy context.
  }
}
