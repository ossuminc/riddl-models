// Multi-Tenant Management - Tenant Context
context TenantContext as router is {
  inlet TenantCommandStreamIn is type TenantCommand  outlet TenantCommandStreamOut is type TenantCommand
  inlet TenantResultStreamIn is result Tenant.TenantResult  outlet TenantResultStreamOut is result Tenant.TenantResult
  handler TenantContextBoundary is {
    on provisionTenant: command Tenant.ProvisionTenant is {
      send provisionTenant to outlet TenantContext.TenantCommandStreamOut
    }
    on activateTenant: command Tenant.ActivateTenant is {
      send activateTenant to outlet TenantContext.TenantCommandStreamOut
    }
    on updateSettings: command Tenant.UpdateSettings is {
      send updateSettings to outlet TenantContext.TenantCommandStreamOut
    }
    on updateLimits: command Tenant.UpdateLimits is {
      send updateLimits to outlet TenantContext.TenantCommandStreamOut
    }
    on changeTier: command Tenant.ChangeTier is {
      send changeTier to outlet TenantContext.TenantCommandStreamOut
    }
    on addUser: command Tenant.AddUser is {
      send addUser to outlet TenantContext.TenantCommandStreamOut
    }
    on removeUser: command Tenant.RemoveUser is {
      send removeUser to outlet TenantContext.TenantCommandStreamOut
    }
    on configureCustomDomain: command Tenant.ConfigureCustomDomain is {
      send configureCustomDomain to outlet TenantContext.TenantCommandStreamOut
    }
    on recordUsage: command Tenant.RecordUsage is {
      send recordUsage to outlet TenantContext.TenantCommandStreamOut
    }
    on suspendTenant: command Tenant.SuspendTenant is {
      send suspendTenant to outlet TenantContext.TenantCommandStreamOut
    }
    on reactivateTenant: command Tenant.ReactivateTenant is {
      send reactivateTenant to outlet TenantContext.TenantCommandStreamOut
    }
    on deactivateTenant: command Tenant.DeactivateTenant is {
      send deactivateTenant to outlet TenantContext.TenantCommandStreamOut
    }
    on tenantResult: result Tenant.TenantResult is {
      send tenantResult to outlet TenantContext.TenantResultStreamOut
    }
    on other is {
      error "Unexpected message at the TenantContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TenantCommand Stream Intake' is from outlet TenantContext.TenantCommandStreamOut to inlet TenantContext.Tenant.TenantCommands  connector 'TenantResult Stream Egress' is from outlet TenantContext.TenantRepository.TenantRepositoryResponses to inlet TenantContext.TenantResultStreamIn  adaptor FromBillingSystem from context BillingSystem as sink is { 
    inlet FromBillingSystemIn is event BillingSystem.BillingAccountCreated    handler FromBillingSystemHandler is {
      on billingAccountCreated: event BillingSystem.BillingAccountCreated is {
        do "billing has the account; provisioning was recorded here and activation waits on the rest"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingSystem"
      }
    } with {
      briefly "from billing system"
      described as {
        |Carries messages from the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor ToBillingSystem to context BillingSystem as flow is { 
    inlet ToBillingSystemIn is type TenantEvent    outlet ToBillingSystemOut is type BillingSystem.BillingSystemCommand
    handler ToBillingSystemHandler is {
      on tenantProvisioned: event Tenant.TenantProvisioned is {
        let notice: type BillingSystem.CreateBillingAccount = prompt("translate the tenantProvisioned event into a CreateBillingAccount for the tenant whose relationship with us has just begun")
        send notice to outlet TenantContext.ToBillingSystem.ToBillingSystemOut
      }
      on usageRecorded: event Tenant.UsageRecorded is {
        let notice: type BillingSystem.RecordUsageMetrics = prompt("translate the usageRecorded event into a RecordUsageMetrics, recorded usage being what a bill is computed from")
        send notice to outlet TenantContext.ToBillingSystem.ToBillingSystemOut
      }
      on tierChanged: event Tenant.TierChanged is {
        let notice: type BillingSystem.UpdateSubscription = prompt("translate the tierChanged event into an UpdateSubscription, a tier being what the subscription charges for")
        send notice to outlet TenantContext.ToBillingSystem.ToBillingSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToBillingSystem"
      }
    } with {
      briefly "to billing system"
      described as {
        |Carries messages to the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor FromDomainManagement from context DomainManagement as sink is { 
    inlet FromDomainManagementIn is type DomainManagement.DomainManagementEvent    handler FromDomainManagementHandler is {
      on domainVerified: event DomainManagement.DomainVerified is {
        do "the domain is verified; configuring it was recorded here"
      }
      on sSLProvisioned: event DomainManagement.SSLProvisioned is {
        do "the certificate is in place; configuring the domain was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromDomainManagement"
      }
    } with {
      briefly "from domain management"
      described as {
        |Carries messages from the external DomainManagement.
      }
    }
  } with {
    briefly "DomainManagement integration"
    described as {
      |The model's side of the DomainManagement conversation.
    }
  }
  adaptor ToDomainManagement to context DomainManagement as flow is { 
    inlet ToDomainManagementIn is type TenantEvent    outlet ToDomainManagementOut is type DomainManagement.DomainManagementCommand
    handler ToDomainManagementHandler is {
      on customDomainConfigured: event Tenant.CustomDomainConfigured is {
        let item0: type DomainManagement.VerifyDomain = prompt("translate the customDomainConfigured event into a VerifyDomain, a configured domain being unproven until checked")
        send item0 to outlet TenantContext.ToDomainManagement.ToDomainManagementOut
        let item1: type DomainManagement.ProvisionSSL = prompt("translate the customDomainConfigured event into a ProvisionSSL, and unusable until it has a certificate")
        send item1 to outlet TenantContext.ToDomainManagement.ToDomainManagementOut
      }
      on other is {
        error "Unexpected message for adaptor ToDomainManagement"
      }
    } with {
      briefly "to domain management"
      described as {
        |Carries messages to the external DomainManagement.
      }
    }
  } with {
    briefly "DomainManagement integration"
    described as {
      |The model's side of the DomainManagement conversation.
    }
  }
  adaptor FromIdentityProvider from context IdentityProvider as sink is { 
    inlet FromIdentityProviderIn is event IdentityProvider.RealmCreated    handler FromIdentityProviderHandler is {
      on realmCreated: event IdentityProvider.RealmCreated is {
        do "the realm exists; provisioning was recorded here and activation waits on the rest"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityProvider"
      }
    } with {
      briefly "from identity provider"
      described as {
        |Carries messages from the external IdentityProvider.
      }
    }
  } with {
    briefly "IdentityProvider integration"
    described as {
      |The model's side of the IdentityProvider conversation.
    }
  }
  adaptor ToIdentityProvider to context IdentityProvider as flow is { 
    inlet ToIdentityProviderIn is type TenantEvent    outlet ToIdentityProviderOut is type IdentityProvider.IdentityProviderCommand
    handler ToIdentityProviderHandler is {
      on tenantProvisioned: event TenantProvisioned is {
        let check0: type IdentityProvider.CreateTenantRealm = prompt("translate the tenantProvisioned event into a CreateTenantRealm giving the tenant its own identity boundary")
        send check0 to outlet TenantContext.ToIdentityProvider.ToIdentityProviderOut
        let check1: type IdentityProvider.CreateTenantUser = prompt("translate the tenantProvisioned event into a CreateTenantUser seeding the realm with its first administrator")
        send check1 to outlet TenantContext.ToIdentityProvider.ToIdentityProviderOut
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityProvider"
      }
    } with {
      briefly "to identity provider"
      described as {
        |Carries messages to the external IdentityProvider.
      }
    }
  } with {
    briefly "IdentityProvider integration"
    described as {
      |The model's side of the IdentityProvider conversation.
    }
  }
  adaptor FromInfrastructureProvisioning from context InfrastructureProvisioning as sink is { 
    inlet FromInfrastructureProvisioningIn is event InfrastructureProvisioning.ResourcesProvisioned    handler FromInfrastructureProvisioningHandler is {
      on resourcesProvisioned: event InfrastructureProvisioning.ResourcesProvisioned is {
        do "the resources exist; activation waits on the realm and billing account too, and is a person's act"
      }
      on other is {
        error "Unexpected message for adaptor FromInfrastructureProvisioning"
      }
    } with {
      briefly "from infrastructure provisioning"
      described as {
        |Carries messages from the external InfrastructureProvisioning.
      }
    }
  } with {
    briefly "InfrastructureProvisioning integration"
    described as {
      |The model's side of the InfrastructureProvisioning conversation.
    }
  }
  adaptor ToInfrastructureProvisioning to context InfrastructureProvisioning as flow is { 
    inlet ToInfrastructureProvisioningIn is type TenantEvent    outlet ToInfrastructureProvisioningOut is type InfrastructureProvisioning.InfrastructureProvisioningCommand
    handler ToInfrastructureProvisioningHandler is {
      on tenantProvisioned: event Tenant.TenantProvisioned is {
        let item0: type InfrastructureProvisioning.ProvisionTenantResources = prompt("translate the tenantProvisioned event into a ProvisionTenantResources, a new tenant being what creates the need for its own resources")
        send item0 to outlet TenantContext.ToInfrastructureProvisioning.ToInfrastructureProvisioningOut
      }
      on tenantDeactivated: event Tenant.TenantDeactivated is {
        let item0: type InfrastructureProvisioning.DeprovisionTenantResources = prompt("translate the tenantDeactivated event into a DeprovisionTenantResources, deactivation ending it")
        send item0 to outlet TenantContext.ToInfrastructureProvisioning.ToInfrastructureProvisioningOut
      }
      on other is {
        error "Unexpected message for adaptor ToInfrastructureProvisioning"
      }
    } with {
      briefly "to infrastructure provisioning"
      described as {
        |Carries messages to the external InfrastructureProvisioning.
      }
    }
  } with {
    briefly "InfrastructureProvisioning integration"
    described as {
      |The model's side of the InfrastructureProvisioning conversation.
    }
  }
  include "types.riddl"
  include "Tenant.riddl"
  type TenantRepositoryCommand is one of {
    TenantContext.TenantRepository.PersistCustomDomainConfigured or TenantContext.TenantRepository.PersistLimitsUpdated or TenantContext.TenantRepository.PersistSettingsUpdated or TenantContext.TenantRepository.PersistTenantActivated or TenantContext.TenantRepository.PersistTenantDeactivated or TenantContext.TenantRepository.PersistTenantProvisioned or TenantContext.TenantRepository.PersistTenantReactivated or TenantContext.TenantRepository.PersistTenantSuspended or TenantContext.TenantRepository.PersistTierChanged or TenantContext.TenantRepository.PersistUsageRecorded or TenantContext.TenantRepository.PersistUserAdded or TenantContext.TenantRepository.PersistUserRemoved
  } with {
    briefly "Anything that writes TenantRepository"
    described as {
      |The persistence commands TenantRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository TenantRepository as flow is {
    inlet TenantRepositoryFromPlatformAnalytics is type TenantRepositoryCommand    command PersistCustomDomainConfigured is {
      tenantId: TenantId with {
        briefly "Row addressed"
        described as {
          |Which stored row CustomDomainConfigured applies to.
        }
      }
      domainName: CustomDomain? with {
        briefly "Domain name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      configuredAt: TimeStamp? with {
        briefly "Configured at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CustomDomainConfigured"
      described as {
        |Instructs this repository to apply CustomDomainConfigured to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLimitsUpdated is {
      tenantId: TenantId with {
        briefly "Row addressed"
        described as {
          |Which stored row LimitsUpdated applies to.
        }
      }
      limits: TenantLimits? with {
        briefly "Limits"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist LimitsUpdated"
      described as {
        |Instructs this repository to apply LimitsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSettingsUpdated is {
      tenantId: TenantId with {
        briefly "Row addressed"
        described as {
          |Which stored row SettingsUpdated applies to.
        }
      }
      settings: TenantSettings? with {
        briefly "Settings"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SettingsUpdated"
      described as {
        |Instructs this repository to apply SettingsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTenantActivated is {
      tenantId: TenantId with {
        briefly "Row addressed"
        described as {
          |Which stored row TenantActivated applies to.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TenantActivated"
      described as {
        |Instructs this repository to apply TenantActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTenantDeactivated is {
      tenantId: TenantId with {
        briefly "Row addressed"
        described as {
          |Which stored row TenantDeactivated applies to.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      deactivatedAt: TimeStamp? with {
        briefly "Deactivated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TenantDeactivated"
      described as {
        |Instructs this repository to apply TenantDeactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTenantReactivated is {
      tenantId: TenantId with {
        briefly "Row addressed"
        described as {
          |Which stored row TenantReactivated applies to.
        }
      }
      reactivatedAt: TimeStamp? with {
        briefly "Reactivated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TenantReactivated"
      described as {
        |Instructs this repository to apply TenantReactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTenantSuspended is {
      tenantId: TenantId with {
        briefly "Row addressed"
        described as {
          |Which stored row TenantSuspended applies to.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      suspendedAt: TimeStamp? with {
        briefly "Suspended at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TenantSuspended"
      described as {
        |Instructs this repository to apply TenantSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUserRemoved is {
      tenantId: TenantId with {
        briefly "Row addressed"
        described as {
          |Which stored row UserRemoved applies to.
        }
      }
      userId: TenantUserId? with {
        briefly "User id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist UserRemoved"
      described as {
        |Instructs this repository to apply UserRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTenantProvisioned is {
      tenantId: TenantId with {
        briefly "Row addressed"
        described as {
          |Which stored row TenantProvisioned applies to.
        }
      }
      tenantInfo: TenantInfo? with {
        briefly "Tenant info"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      provisionedAt: TimeStamp? with {
        briefly "Provisioned at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TenantProvisioned"
      described as {
        |Instructs this repository to apply TenantProvisioned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTierChanged is {
      tenantId: TenantId with {
        briefly "Row addressed"
        described as {
          |Which stored row TierChanged applies to.
        }
      }
      newTier: TenantTier? with {
        briefly "New tier"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      effectiveDate: Date? with {
        briefly "Effective date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TierChanged"
      described as {
        |Instructs this repository to apply TierChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUsageRecorded is {
      tenantId: TenantId with {
        briefly "Row addressed"
        described as {
          |Which stored row UsageRecorded applies to.
        }
      }
      usage: TenantUsage? with {
        briefly "Usage"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist UsageRecorded"
      described as {
        |Instructs this repository to apply UsageRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUserAdded is {
      tenantId: TenantId with {
        briefly "Row addressed"
        described as {
          |Which stored row UserAdded applies to.
        }
      }
      user: TenantUserInfo? with {
        briefly "User"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist UserAdded"
      described as {
        |Instructs this repository to apply UserAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet TenantRepositoryResponses is result Tenant.TenantResult
    record StoredTenant is {
      tenantId: TenantId with {
        briefly "tenantId"
        described as {
          |The tenantId column of the stored tenant row.
        }
      }
      status: TenantStatus with {
        briefly "status"
        described as {
          |The status column of the stored tenant row.
        }
      }
      tenantInfo: TenantInfo with {
        briefly "tenantInfo"
        described as {
          |The tenantInfo column of the stored tenant row.
        }
      }
      domainName: CustomDomain? with {
        briefly "Domain name"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      configuredAt: TimeStamp? with {
        briefly "Configured at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      limits: TenantLimits? with {
        briefly "Limits"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      settings: TenantSettings? with {
        briefly "Settings"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      deactivatedAt: TimeStamp? with {
        briefly "Deactivated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reactivatedAt: TimeStamp? with {
        briefly "Reactivated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      suspendedAt: TimeStamp? with {
        briefly "Suspended at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      userId: TenantUserId? with {
        briefly "User id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      provisionedAt: TimeStamp? with {
        briefly "Provisioned at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newTier: TenantTier? with {
        briefly "New tier"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      effectiveDate: Date? with {
        briefly "Effective date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      usage: TenantUsage? with {
        briefly "Usage"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      user: TenantUserInfo? with {
        briefly "User"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored tenant row"
      described as {
        |The persistence shape of tenant data as this repository stores it.
      }
    }
    schema TenantData is relational
      of tenants as record StoredTenant
        key on field StoredTenant.tenantId
        index on field StoredTenant.tenantInfo.subdomain
        index on field StoredTenant.status
        index on field StoredTenant.tenantInfo.tier
 with {
      briefly "Tenant data schema"
      described as {
        |The relational schema holding tenant data for the TenantRepository.
      }
    }
    handler TenantPersistence is {
      on persistCustomDomainConfigured: command PersistCustomDomainConfigured is {
        update TenantData.tenants set domainName = persistCustomDomainConfigured.domainName, configuredAt = persistCustomDomainConfigured.configuredAt where tenantId == persistCustomDomainConfigured.tenantId
      }
      on persistLimitsUpdated: command PersistLimitsUpdated is {
        update TenantData.tenants set limits = persistLimitsUpdated.limits, updatedAt = persistLimitsUpdated.updatedAt where tenantId == persistLimitsUpdated.tenantId
      }
      on persistSettingsUpdated: command PersistSettingsUpdated is {
        update TenantData.tenants set settings = persistSettingsUpdated.settings, updatedAt = persistSettingsUpdated.updatedAt where tenantId == persistSettingsUpdated.tenantId
      }
      on persistTenantActivated: command PersistTenantActivated is {
        update TenantData.tenants set activatedAt = persistTenantActivated.activatedAt where tenantId == persistTenantActivated.tenantId
      }
      on persistTenantDeactivated: command PersistTenantDeactivated is {
        update TenantData.tenants set reason = persistTenantDeactivated.reason, deactivatedAt = persistTenantDeactivated.deactivatedAt where tenantId == persistTenantDeactivated.tenantId
      }
      on persistTenantReactivated: command PersistTenantReactivated is {
        update TenantData.tenants set reactivatedAt = persistTenantReactivated.reactivatedAt where tenantId == persistTenantReactivated.tenantId
      }
      on persistTenantSuspended: command PersistTenantSuspended is {
        update TenantData.tenants set reason = persistTenantSuspended.reason, suspendedAt = persistTenantSuspended.suspendedAt where tenantId == persistTenantSuspended.tenantId
      }
      on persistUserRemoved: command PersistUserRemoved is {
        update TenantData.tenants set userId = persistUserRemoved.userId, removedAt = persistUserRemoved.removedAt where tenantId == persistUserRemoved.tenantId
      }
      on persistTenantProvisioned: command PersistTenantProvisioned is {
        update TenantData.tenants set tenantInfo = persistTenantProvisioned.tenantInfo, provisionedAt = persistTenantProvisioned.provisionedAt where tenantId == persistTenantProvisioned.tenantId
      }
      on persistTierChanged: command PersistTierChanged is {
        update TenantData.tenants set newTier = persistTierChanged.newTier, effectiveDate = persistTierChanged.effectiveDate where tenantId == persistTierChanged.tenantId
      }
      on persistUsageRecorded: command PersistUsageRecorded is {
        update TenantData.tenants set usage = persistUsageRecorded.usage, recordedAt = persistUsageRecorded.recordedAt where tenantId == persistUsageRecorded.tenantId
      }
      on persistUserAdded: command PersistUserAdded is {
        update TenantData.tenants set user = persistUserAdded.user, addedAt = persistUserAdded.addedAt where tenantId == persistUserAdded.tenantId
      }
      on query GetPlatformMetrics is {
        let platformMetricsView: type PlatformMetricsView = prompt("read the platform metrics projection")
        reply platformMetricsView
      }
    } with {
      briefly "Persists tenant commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Tenant data persistence"
    described as {
      |Persistent storage for tenants.
    }
  }
  query GetPlatformMetrics replies result PlatformMetricsView is {
    platformMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which platform metrics to retrieve.
      }
    }
  } with {
    briefly "Get platform metrics"
    described as {
      |Retrieves the platform metrics projection.
    }
  }
  result PlatformMetricsView is {
    platformMetrics: PlatformAnalytics.PlatformMetrics with {
      briefly "Platform metrics"
      described as {
        |The platform metrics being returned.
      }
    }
  } with {
    briefly "Platform metrics view"
    described as {
      |Read model view carrying the platform metrics projection.
    }
  }
  projector PlatformAnalytics as flow is {
    updates repository TenantContext.TenantRepository
    outlet PlatformAnalyticsToRepository is type TenantRepositoryCommand
    inlet PlatformAnalyticsFromTenant is type TenantEvent    record PlatformMetrics is {
      totalTenants: Natural with {
        briefly "Total"
        described as {
          |Total tenants.
        }
      }
      activeTenants: Natural with {
        briefly "Active"
        described as {
          |Active tenants.
        }
      }
      totalUsers: Natural with {
        briefly "Users"
        described as {
          |Total users.
        }
      }
      totalStorageGB: Decimal(15,2) with {
        briefly "Storage"
        described as {
          |Total storage.
        }
      }
      mrr: Decimal(15,2) with {
        briefly "MRR"
        described as {
          |Monthly recurring revenue.
        }
      }
    } with {
      briefly "Platform metrics"
      described as {
        |Platform-wide metrics.
      }
    }
    handler AnalyticsHandler is {
      on customDomainConfigured: event Tenant.CustomDomainConfigured is {
        tell command TenantContext.TenantRepository.PersistCustomDomainConfigured(tenantId = customDomainConfigured.tenantId, domainName = customDomainConfigured.domainName, configuredAt = customDomainConfigured.configuredAt) to repository TenantContext.TenantRepository
        do "apply CustomDomainConfigured to the PlatformAnalytics projection"
      }
      on limitsUpdated: event Tenant.LimitsUpdated is {
        tell command TenantContext.TenantRepository.PersistLimitsUpdated(tenantId = limitsUpdated.tenantId, limits = limitsUpdated.limits, updatedAt = limitsUpdated.updatedAt) to repository TenantContext.TenantRepository
        do "apply LimitsUpdated to the PlatformAnalytics projection"
      }
      on settingsUpdated: event Tenant.SettingsUpdated is {
        tell command TenantContext.TenantRepository.PersistSettingsUpdated(tenantId = settingsUpdated.tenantId, settings = settingsUpdated.settings, updatedAt = settingsUpdated.updatedAt) to repository TenantContext.TenantRepository
        do "apply SettingsUpdated to the PlatformAnalytics projection"
      }
      on tenantActivated: event Tenant.TenantActivated is {
        tell command TenantContext.TenantRepository.PersistTenantActivated(tenantId = tenantActivated.tenantId, activatedAt = tenantActivated.activatedAt) to repository TenantContext.TenantRepository
        do "apply TenantActivated to the PlatformAnalytics projection"
      }
      on tenantDeactivated: event Tenant.TenantDeactivated is {
        tell command TenantContext.TenantRepository.PersistTenantDeactivated(tenantId = tenantDeactivated.tenantId, reason = tenantDeactivated.reason, deactivatedAt = tenantDeactivated.deactivatedAt) to repository TenantContext.TenantRepository
        do "apply TenantDeactivated to the PlatformAnalytics projection"
      }
      on tenantReactivated: event Tenant.TenantReactivated is {
        tell command TenantContext.TenantRepository.PersistTenantReactivated(tenantId = tenantReactivated.tenantId, reactivatedAt = tenantReactivated.reactivatedAt) to repository TenantContext.TenantRepository
        do "apply TenantReactivated to the PlatformAnalytics projection"
      }
      on tenantSuspended: event Tenant.TenantSuspended is {
        tell command TenantContext.TenantRepository.PersistTenantSuspended(tenantId = tenantSuspended.tenantId, reason = tenantSuspended.reason, suspendedAt = tenantSuspended.suspendedAt) to repository TenantContext.TenantRepository
        do "apply TenantSuspended to the PlatformAnalytics projection"
      }
      on userRemoved: event Tenant.UserRemoved is {
        tell command TenantContext.TenantRepository.PersistUserRemoved(tenantId = userRemoved.tenantId, userId = userRemoved.userId, removedAt = userRemoved.removedAt) to repository TenantContext.TenantRepository
        do "apply UserRemoved to the PlatformAnalytics projection"
      }
      on tenantProvisioned: event Tenant.TenantProvisioned is {
        tell command TenantContext.TenantRepository.PersistTenantProvisioned(tenantId = tenantProvisioned.tenantId, tenantInfo = tenantProvisioned.tenantInfo, provisionedAt = tenantProvisioned.provisionedAt) to repository TenantContext.TenantRepository
      }
      on userAdded: event Tenant.UserAdded is {
        tell command TenantContext.TenantRepository.PersistUserAdded(tenantId = userAdded.tenantId, user = userAdded.user, addedAt = userAdded.addedAt) to repository TenantContext.TenantRepository
      }
      on usageRecorded: event Tenant.UsageRecorded is {
        tell command TenantContext.TenantRepository.PersistUsageRecorded(tenantId = usageRecorded.tenantId, usage = usageRecorded.usage, recordedAt = usageRecorded.recordedAt) to repository TenantContext.TenantRepository
      }
      on tierChanged: event Tenant.TierChanged is {
        tell command TenantContext.TenantRepository.PersistTierChanged(tenantId = tierChanged.tenantId, newTier = tierChanged.newTier, effectiveDate = tierChanged.effectiveDate) to repository TenantContext.TenantRepository
      }
    } with {
      briefly "Maintains platform analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Platform analytics"
    described as {
      |Multi-tenant platform metrics.
    }
  }
  // Event streaming infrastructure
  type TenantEvent is one of {
    TenantContext.Tenant.TenantProvisioned or TenantContext.Tenant.TenantActivated or TenantContext.Tenant.SettingsUpdated or TenantContext.Tenant.UserAdded or TenantContext.Tenant.TenantDeactivated or TenantContext.Tenant.CustomDomainConfigured or TenantContext.Tenant.LimitsUpdated or TenantContext.Tenant.TenantReactivated or TenantContext.Tenant.TenantSuspended or TenantContext.Tenant.TierChanged or TenantContext.Tenant.UsageRecorded or TenantContext.Tenant.UserRemoved
  } with {
    briefly "Tenant events"
    described as {
      |Union of all Tenant events for streaming.
    }
  }
  streamlet TenantEventSplit as split is {
    outlet TenantEventSplitToToInfrastructureProvisioning is type TenantEvent
    outlet TenantEventSplitToToIdentityProvider is type TenantEvent
    outlet TenantEventSplitToToDomainManagement is type TenantEvent
    outlet TenantEventSplitToToBillingSystem is type TenantEvent
    inlet TenantEventSplitIn is type TenantEvent    outlet TenantEventSplitToPlatformAnalytics is type TenantEvent
    handler TenantEventSplitHandler is {
      on tenantProvisioned: event Tenant.TenantProvisioned is {
        send tenantProvisioned to outlet TenantEventSplitToPlatformAnalytics
        send tenantProvisioned to outlet TenantEventSplitToToInfrastructureProvisioning
        send tenantProvisioned to outlet TenantEventSplitToToIdentityProvider
        send tenantProvisioned to outlet TenantEventSplitToToBillingSystem
        tell tenantProvisioned to entity TenantContext.Tenant
      }
      on tenantActivated: event Tenant.TenantActivated is {
        send tenantActivated to outlet TenantEventSplitToPlatformAnalytics
        tell tenantActivated to entity TenantContext.Tenant
      }
      on settingsUpdated: event Tenant.SettingsUpdated is {
        send settingsUpdated to outlet TenantEventSplitToPlatformAnalytics
        tell settingsUpdated to entity TenantContext.Tenant
      }
      on limitsUpdated: event Tenant.LimitsUpdated is {
        send limitsUpdated to outlet TenantEventSplitToPlatformAnalytics
        tell limitsUpdated to entity TenantContext.Tenant
      }
      on tierChanged: event Tenant.TierChanged is {
        send tierChanged to outlet TenantEventSplitToPlatformAnalytics
        send tierChanged to outlet TenantEventSplitToToBillingSystem
        tell tierChanged to entity TenantContext.Tenant
      }
      on userAdded: event Tenant.UserAdded is {
        send userAdded to outlet TenantEventSplitToPlatformAnalytics
        tell userAdded to entity TenantContext.Tenant
      }
      on userRemoved: event Tenant.UserRemoved is {
        send userRemoved to outlet TenantEventSplitToPlatformAnalytics
        tell userRemoved to entity TenantContext.Tenant
      }
      on customDomainConfigured: event Tenant.CustomDomainConfigured is {
        send customDomainConfigured to outlet TenantEventSplitToPlatformAnalytics
        send customDomainConfigured to outlet TenantEventSplitToToDomainManagement
        tell customDomainConfigured to entity TenantContext.Tenant
      }
      on usageRecorded: event Tenant.UsageRecorded is {
        send usageRecorded to outlet TenantEventSplitToPlatformAnalytics
        send usageRecorded to outlet TenantEventSplitToToBillingSystem
        tell usageRecorded to entity TenantContext.Tenant
      }
      on tenantSuspended: event Tenant.TenantSuspended is {
        send tenantSuspended to outlet TenantEventSplitToPlatformAnalytics
        tell tenantSuspended to entity TenantContext.Tenant
      }
      on tenantReactivated: event Tenant.TenantReactivated is {
        send tenantReactivated to outlet TenantEventSplitToPlatformAnalytics
        tell tenantReactivated to entity TenantContext.Tenant
      }
      on tenantDeactivated: event Tenant.TenantDeactivated is {
        send tenantDeactivated to outlet TenantEventSplitToPlatformAnalytics
        send tenantDeactivated to outlet TenantEventSplitToToInfrastructureProvisioning
        tell tenantDeactivated to entity TenantContext.Tenant
      }
      on other is {
        error "Unexpected message for processor TenantEventSplit"
      }
    } with {
      briefly "Tenant event fan-out handler"
      described as {
        |Delivers each Tenant event to all of its consumers.
      }
    }
  } with {
    briefly "Tenant event fan-out"
    described as {
      |Fans Tenant events out to the repository and projectors.
    }
  }
  connector 'ToInfrastructureProvisioning Feed' is from outlet TenantContext.TenantEventSplit.TenantEventSplitToToInfrastructureProvisioning to inlet TenantContext.ToInfrastructureProvisioning.ToInfrastructureProvisioningIn with {
    briefly "The Tenant events ToInfrastructureProvisioning translates, on their way to it"
  }
  connector 'ToIdentityProvider Feed' is from outlet TenantContext.TenantEventSplit.TenantEventSplitToToIdentityProvider to inlet TenantContext.ToIdentityProvider.ToIdentityProviderIn with {
    briefly "The Tenant events ToIdentityProvider translates, on their way to it"
  }
  connector 'ToDomainManagement Feed' is from outlet TenantContext.TenantEventSplit.TenantEventSplitToToDomainManagement to inlet TenantContext.ToDomainManagement.ToDomainManagementIn with {
    briefly "The Tenant events ToDomainManagement translates, on their way to it"
  }
  connector 'ToBillingSystem Feed' is from outlet TenantContext.TenantEventSplit.TenantEventSplitToToBillingSystem to inlet TenantContext.ToBillingSystem.ToBillingSystemIn with {
    briefly "The Tenant events ToBillingSystem translates, on their way to it"
  }
  connector 'TenantEvent Stream' is from outlet TenantContext.Tenant.TenantEvents to inlet TenantContext.TenantEventSplit.TenantEventSplitIn with {
    briefly "Tenant events, fanned out to storage and read models"
  }
  connector 'PlatformAnalytics Feed' is from outlet TenantContext.TenantEventSplit.TenantEventSplitToPlatformAnalytics to inlet TenantContext.PlatformAnalytics.PlatformAnalyticsFromTenant with {
    briefly "Tenant events feeding the PlatformAnalytics projection"
  }
  connector 'PlatformAnalytics Storage' is from outlet TenantContext.PlatformAnalytics.PlatformAnalyticsToRepository to inlet TenantContext.TenantRepository.TenantRepositoryFromPlatformAnalytics with {
    briefly "PlatformAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for multi-tenant management"
  described as {
    |SaaS multi-tenancy context.
  }
}
