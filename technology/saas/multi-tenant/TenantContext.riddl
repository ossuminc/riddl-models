// Multi-Tenant Management - Tenant Context
context TenantContext is {
  adaptor FromBillingSystem from context BillingSystem is { 
    handler FromBillingSystemHandler is {
      on event BillingSystem.BillingAccountCreated is {
        do "the model receives billing account created"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingSystem"
      }
    } with {
      briefly "from billing system"
      described as {
        |Carries messages from the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor ToBillingSystem to context BillingSystem is { 
    handler ToBillingSystemHandler is {
      on command BillingSystem.CreateBillingAccount is {
        do "the model sends create billing account"
      }
      on command BillingSystem.RecordUsageMetrics is {
        do "the model sends record usage metrics"
      }
      on command BillingSystem.UpdateSubscription is {
        do "the model sends update subscription"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingSystem"
      }
    } with {
      briefly "to billing system"
      described as {
        |Carries messages to the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor FromDomainManagement from context DomainManagement is { 
    handler FromDomainManagementHandler is {
      on event DomainManagement.DomainVerified is {
        do "the model receives domain verified"
      }
      on event DomainManagement.SSLProvisioned is {
        do "the model receives ssl provisioned"
      }
      on other is {
        error "Unexpected message for adaptor FromDomainManagement"
      }
    } with {
      briefly "from domain management"
      described as {
        |Carries messages from the external DomainManagement.
      }
    }
  } with {
    briefly "DomainManagement integration"
    described as {
      |The model's side of the DomainManagement conversation.
    }
  }
  adaptor ToDomainManagement to context DomainManagement is { 
    handler ToDomainManagementHandler is {
      on command DomainManagement.ProvisionSSL is {
        do "the model sends provision ssl"
      }
      on command DomainManagement.VerifyDomain is {
        do "the model sends verify domain"
      }
      on other is {
        error "Unexpected message for adaptor ToDomainManagement"
      }
    } with {
      briefly "to domain management"
      described as {
        |Carries messages to the external DomainManagement.
      }
    }
  } with {
    briefly "DomainManagement integration"
    described as {
      |The model's side of the DomainManagement conversation.
    }
  }
  adaptor FromIdentityProvider from context IdentityProvider is { 
    handler FromIdentityProviderHandler is {
      on event IdentityProvider.RealmCreated is {
        do "the model receives realm created"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityProvider"
      }
    } with {
      briefly "from identity provider"
      described as {
        |Carries messages from the external IdentityProvider.
      }
    }
  } with {
    briefly "IdentityProvider integration"
    described as {
      |The model's side of the IdentityProvider conversation.
    }
  }
  adaptor ToIdentityProvider to context IdentityProvider is { 
    handler ToIdentityProviderHandler is {
      on command IdentityProvider.CreateTenantRealm is {
        do "the model sends create tenant realm"
      }
      on command IdentityProvider.CreateTenantUser is {
        do "the model sends create tenant user"
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityProvider"
      }
    } with {
      briefly "to identity provider"
      described as {
        |Carries messages to the external IdentityProvider.
      }
    }
  } with {
    briefly "IdentityProvider integration"
    described as {
      |The model's side of the IdentityProvider conversation.
    }
  }
  adaptor FromInfrastructureProvisioning from context InfrastructureProvisioning is { 
    handler FromInfrastructureProvisioningHandler is {
      on event InfrastructureProvisioning.ResourcesProvisioned is {
        do "the model receives resources provisioned"
      }
      on other is {
        error "Unexpected message for adaptor FromInfrastructureProvisioning"
      }
    } with {
      briefly "from infrastructure provisioning"
      described as {
        |Carries messages from the external InfrastructureProvisioning.
      }
    }
  } with {
    briefly "InfrastructureProvisioning integration"
    described as {
      |The model's side of the InfrastructureProvisioning conversation.
    }
  }
  adaptor ToInfrastructureProvisioning to context InfrastructureProvisioning is { 
    handler ToInfrastructureProvisioningHandler is {
      on command InfrastructureProvisioning.DeprovisionTenantResources is {
        do "the model sends deprovision tenant resources"
      }
      on command InfrastructureProvisioning.ProvisionTenantResources is {
        do "the model sends provision tenant resources"
      }
      on other is {
        error "Unexpected message for adaptor ToInfrastructureProvisioning"
      }
    } with {
      briefly "to infrastructure provisioning"
      described as {
        |Carries messages to the external InfrastructureProvisioning.
      }
    }
  } with {
    briefly "InfrastructureProvisioning integration"
    described as {
      |The model's side of the InfrastructureProvisioning conversation.
    }
  }
  include "types.riddl"
  include "Tenant.riddl"
  repository TenantRepository as merge is {
    inlet TenantRepositoryFromTenant is type TenantEvent    inlet TenantRepositoryFromPlatformAnalytics is type TenantEvent    outlet TenantRepositoryResponses is type Tenant.TenantResult
    record StoredTenant is  {
      tenantId: TenantId with {
        briefly "tenantId"
        described as {
          |The tenantId column of the stored tenant row.
        }
      }
      status: TenantStatus with {
        briefly "status"
        described as {
          |The status column of the stored tenant row.
        }
      }
      tenantInfo: TenantInfo with {
        briefly "tenantInfo"
        described as {
          |The tenantInfo column of the stored tenant row.
        }
      }
    } with {
      briefly "Stored tenant row"
      described as {
        |The persistence shape of tenant data as this repository stores it.
      }
    }
    schema TenantData is relational
      of tenants as type StoredTenant
        index on field StoredTenant.tenantId
        index on field StoredTenant.tenantInfo.subdomain
        index on field StoredTenant.status
        index on field StoredTenant.tenantInfo.tier
 with {
      briefly "Tenant data schema"
      described as {
        |The relational schema holding tenant data for the TenantRepository.
      }
    }
    handler TenantPersistence is {
      on query GetPlatformMetrics is {
        do "read the platform metrics projection"
        reply result PlatformMetricsView
      }
      on provisionTenant: command Tenant.ProvisionTenant is {
        tell event Tenant.TenantProvisioned(tenantId = provisionTenant.tenantId, tenantInfo = provisionTenant.tenantInfo) to entity TenantContext.Tenant
      }
      on activateTenant: command Tenant.ActivateTenant is {
        tell event Tenant.TenantActivated(tenantId = activateTenant.tenantId, activatedAt = activateTenant.activatedAt) to entity TenantContext.Tenant
      }
      on updateSettings: command Tenant.UpdateSettings is {
        tell event Tenant.SettingsUpdated(tenantId = updateSettings.tenantId, settings = updateSettings.settings) to entity TenantContext.Tenant
      }
      on addUser: command Tenant.AddUser is {
        tell event Tenant.UserAdded(tenantId = addUser.tenantId, user = addUser.user) to entity TenantContext.Tenant
      }
      on recordUsage: command Tenant.RecordUsage is {
        tell event Tenant.UsageRecorded(tenantId = recordUsage.tenantId, usage = recordUsage.usage) to entity TenantContext.Tenant
      }
      on deactivateTenant: command Tenant.DeactivateTenant is {
        tell event Tenant.TenantDeactivated(tenantId = deactivateTenant.tenantId, reason = deactivateTenant.reason) to entity TenantContext.Tenant
      }
    } with {
      briefly "Persists tenant commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Tenant data persistence"
    described as {
      |Persistent storage for tenants.
    }
  }
  query GetPlatformMetrics is  {
    platformMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which platform metrics to retrieve.
      }
    }
  } with {
    briefly "Get platform metrics"
    described as {
      |Retrieves the platform metrics projection.
    }
  }
  result PlatformMetricsView is  {
    platformMetrics: PlatformAnalytics.PlatformMetrics with {
      briefly "Platform metrics"
      described as {
        |The platform metrics being returned.
      }
    }
  } with {
    briefly "Platform metrics view"
    described as {
      |Read model view carrying the platform metrics projection.
    }
  }
  projector PlatformAnalytics as flow is {
    updates repository TenantContext.TenantRepository
    inlet PlatformAnalyticsFromTenant is type TenantEvent    outlet PlatformAnalyticsOut is type TenantEvent
    record PlatformMetrics is  {
      totalTenants: Natural with {
        briefly "Total"
        described as {
          |Total tenants.
        }
      }
      activeTenants: Natural with {
        briefly "Active"
        described as {
          |Active tenants.
        }
      }
      totalUsers: Natural with {
        briefly "Users"
        described as {
          |Total users.
        }
      }
      totalStorageGB: Decimal(15,2) with {
        briefly "Storage"
        described as {
          |Total storage.
        }
      }
      mrr: Decimal(15,2) with {
        briefly "MRR"
        described as {
          |Monthly recurring revenue.
        }
      }
    } with {
      briefly "Platform metrics"
      described as {
        |Platform-wide metrics.
      }
    }
    handler AnalyticsHandler is {
      on tenantProvisioned: event Tenant.TenantProvisioned is {
        tell tenantProvisioned to repository TenantContext.TenantRepository
      }
      on userAdded: event Tenant.UserAdded is {
        tell userAdded to repository TenantContext.TenantRepository
      }
      on usageRecorded: event Tenant.UsageRecorded is {
        tell usageRecorded to repository TenantContext.TenantRepository
      }
      on tierChanged: event Tenant.TierChanged is {
        tell tierChanged to repository TenantContext.TenantRepository
      }
    } with {
      briefly "Maintains platform analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Platform analytics"
    described as {
      |Multi-tenant platform metrics.
    }
  }
  // Event streaming infrastructure
  type TenantEvent is one of {
    TenantContext.Tenant.TenantProvisioned or TenantContext.Tenant.TenantActivated or TenantContext.Tenant.SettingsUpdated or TenantContext.Tenant.UserAdded or TenantContext.Tenant.TenantDeactivated
  } with {
    briefly "Tenant events"
    described as {
      |Union of all Tenant events for streaming.
    }
  }
  processor TenantSource as source is {
    outlet TenantEventOutlet is type TenantEvent
 with {
      briefly "Event outlet"
      described as {
        |Outlet for Tenant events.
      }
    }
    handler TenantSourceHandler is {
      on init is {
        tell command Tenant.InitializeTenant to entity TenantContext.Tenant
      }
      on tenantProvisioned: event Tenant.TenantProvisioned is {
        send tenantProvisioned to outlet TenantEventOutlet
      }
      on tenantActivated: event Tenant.TenantActivated is {
        send tenantActivated to outlet TenantEventOutlet
      }
      on settingsUpdated: event Tenant.SettingsUpdated is {
        send settingsUpdated to outlet TenantEventOutlet
      }
      on userAdded: event Tenant.UserAdded is {
        send userAdded to outlet TenantEventOutlet
      }
      on tenantDeactivated: event Tenant.TenantDeactivated is {
        send tenantDeactivated to outlet TenantEventOutlet
      }
      on other is {
        error "Unexpected message for source TenantSource"
      }
    } with {
      briefly "Source handler"
      described as {
        |Handles Tenant events for streaming.
      }
    }
  } with {
    briefly "Tenant event source"
    described as {
      |Publishes Tenant events to the event stream.
    }
  }
  processor TenantSink as sink is {
    inlet TenantEventInlet is type TenantEvent with {
      briefly "Event inlet"
      described as {
        |Inlet for Tenant events.
      }
    }
    handler TenantSinkHandler is {
      on init is { ??? }
      on tenantProvisioned: event Tenant.TenantProvisioned is {
        tell tenantProvisioned to repository TenantContext.TenantRepository
      }
      on tenantActivated: event Tenant.TenantActivated is {
        tell tenantActivated to repository TenantContext.TenantRepository
      }
      on settingsUpdated: event Tenant.SettingsUpdated is {
        tell settingsUpdated to repository TenantContext.TenantRepository
      }
      on userAdded: event Tenant.UserAdded is {
        tell userAdded to repository TenantContext.TenantRepository
      }
      on tenantDeactivated: event Tenant.TenantDeactivated is {
        tell tenantDeactivated to repository TenantContext.TenantRepository
      }
      on other is {
        error "Unexpected message for sink TenantSink"
      }
    } with {
      briefly "Sink handler"
      described as {
        |Handles incoming Tenant events for persistence.
      }
    }
  } with {
    briefly "Tenant event sink"
    described as {
      |Receives Tenant events for persistence.
    }
  }
  connector TenantEventFlow is from outlet TenantContext.TenantSource.TenantEventOutlet to inlet TenantContext.TenantSink.TenantEventInlet with {
    briefly "Tenant event connector"
    described as {
      |Wires Tenant source to sink for event flow.
    }
  }
  processor TenantEventSplit as split is {
    inlet TenantEventSplitIn is type TenantEvent    outlet TenantEventSplitToTenantRepository is type TenantEvent
    outlet TenantEventSplitToPlatformAnalytics is type TenantEvent
    handler TenantEventSplitHandler is {
      on tenantProvisioned: event Tenant.TenantProvisioned is {
        send tenantProvisioned to outlet TenantEventSplitToTenantRepository
        send tenantProvisioned to outlet TenantEventSplitToPlatformAnalytics
        tell tenantProvisioned to entity TenantContext.Tenant
      }
      on tenantActivated: event Tenant.TenantActivated is {
        send tenantActivated to outlet TenantEventSplitToTenantRepository
        send tenantActivated to outlet TenantEventSplitToPlatformAnalytics
        tell tenantActivated to entity TenantContext.Tenant
      }
      on settingsUpdated: event Tenant.SettingsUpdated is {
        send settingsUpdated to outlet TenantEventSplitToTenantRepository
        send settingsUpdated to outlet TenantEventSplitToPlatformAnalytics
        tell settingsUpdated to entity TenantContext.Tenant
      }
      on limitsUpdated: event Tenant.LimitsUpdated is {
        send limitsUpdated to outlet TenantEventSplitToTenantRepository
        send limitsUpdated to outlet TenantEventSplitToPlatformAnalytics
        tell limitsUpdated to entity TenantContext.Tenant
      }
      on tierChanged: event Tenant.TierChanged is {
        send tierChanged to outlet TenantEventSplitToTenantRepository
        send tierChanged to outlet TenantEventSplitToPlatformAnalytics
        tell tierChanged to entity TenantContext.Tenant
      }
      on userAdded: event Tenant.UserAdded is {
        send userAdded to outlet TenantEventSplitToTenantRepository
        send userAdded to outlet TenantEventSplitToPlatformAnalytics
        tell userAdded to entity TenantContext.Tenant
      }
      on userRemoved: event Tenant.UserRemoved is {
        send userRemoved to outlet TenantEventSplitToTenantRepository
        send userRemoved to outlet TenantEventSplitToPlatformAnalytics
        tell userRemoved to entity TenantContext.Tenant
      }
      on customDomainConfigured: event Tenant.CustomDomainConfigured is {
        send customDomainConfigured to outlet TenantEventSplitToTenantRepository
        send customDomainConfigured to outlet TenantEventSplitToPlatformAnalytics
        tell customDomainConfigured to entity TenantContext.Tenant
      }
      on usageRecorded: event Tenant.UsageRecorded is {
        send usageRecorded to outlet TenantEventSplitToTenantRepository
        send usageRecorded to outlet TenantEventSplitToPlatformAnalytics
        tell usageRecorded to entity TenantContext.Tenant
      }
      on tenantSuspended: event Tenant.TenantSuspended is {
        send tenantSuspended to outlet TenantEventSplitToTenantRepository
        send tenantSuspended to outlet TenantEventSplitToPlatformAnalytics
        tell tenantSuspended to entity TenantContext.Tenant
      }
      on tenantReactivated: event Tenant.TenantReactivated is {
        send tenantReactivated to outlet TenantEventSplitToTenantRepository
        send tenantReactivated to outlet TenantEventSplitToPlatformAnalytics
        tell tenantReactivated to entity TenantContext.Tenant
      }
      on tenantDeactivated: event Tenant.TenantDeactivated is {
        send tenantDeactivated to outlet TenantEventSplitToTenantRepository
        send tenantDeactivated to outlet TenantEventSplitToPlatformAnalytics
        tell tenantDeactivated to entity TenantContext.Tenant
      }
      on other is {
        error "Unexpected message for processor TenantEventSplit"
      }
    } with {
      briefly "Tenant event fan-out handler"
      described as {
        |Delivers each Tenant event to all of its consumers.
      }
    }
  } with {
    briefly "Tenant event fan-out"
    described as {
      |Fans Tenant events out to the repository and projectors.
    }
  }
  connector 'TenantEvent Stream' is from outlet TenantContext.Tenant.TenantEvents to inlet TenantContext.TenantEventSplit.TenantEventSplitIn with {
    briefly "Tenant events, fanned out to storage and read models"
  }
  connector 'TenantEvent Storage' is from outlet TenantContext.TenantEventSplit.TenantEventSplitToTenantRepository to inlet TenantContext.TenantRepository.TenantRepositoryFromTenant with {
    briefly "Tenant events on their way to storage"
  }
  connector 'PlatformAnalytics Feed' is from outlet TenantContext.TenantEventSplit.TenantEventSplitToPlatformAnalytics to inlet TenantContext.PlatformAnalytics.PlatformAnalyticsFromTenant with {
    briefly "Tenant events feeding the PlatformAnalytics projection"
  }
  connector 'PlatformAnalytics Storage' is from outlet TenantContext.PlatformAnalytics.PlatformAnalyticsOut to inlet TenantContext.TenantRepository.TenantRepositoryFromPlatformAnalytics with {
    briefly "The PlatformAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for multi-tenant management"
  described as {
    |SaaS multi-tenancy context.
  }
}
