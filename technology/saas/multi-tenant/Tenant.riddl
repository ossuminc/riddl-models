// Multi-Tenant Management - Tenant Entity
entity Tenant as flow is {
  type TenantCommand is one of {
    Tenant.ProvisionTenant or Tenant.ActivateTenant or Tenant.UpdateSettings or Tenant.UpdateLimits or Tenant.ChangeTier or Tenant.AddUser or Tenant.RemoveUser or Tenant.ConfigureCustomDomain or Tenant.RecordUsage or Tenant.SuspendTenant or Tenant.ReactivateTenant or Tenant.DeactivateTenant
  } with {
    briefly "Tenant command alternation"
    described as {
      |Commands accepted by the Tenant entity.
    }
  }
  inlet TenantCommands is type TenantCommand  outlet TenantEvents is type TenantEvent
  command ProvisionTenant is  {
    tenantId: TenantId with {
      briefly "Tenant ID"
      described as {
        |New tenant identifier.
      }
    }
    tenantInfo: TenantInfo with {
      briefly "Info"
      described as {
        |Tenant information.
      }
    }
    limits: TenantLimits with {
      briefly "Limits"
      described as {
        |Resource limits.
      }
    }
  } with {
    briefly "Provision tenant"
    described as {
      |Provisions a new tenant.
    }
  }
  command ActivateTenant is  {
    tenantId: TenantId with {
      briefly "Tenant ID"
      described as {
        |Tenant identifier.
      }
    }
    activatedAt: TimeStamp with {
      briefly "Activated"
      described as {
        |Activation time.
      }
    }
  } with {
    briefly "Activate tenant"
    described as {
      |Activates the tenant.
    }
  }
  command UpdateSettings is  {
    tenantId: TenantId with {
      briefly "Tenant ID"
      described as {
        |Tenant identifier.
      }
    }
    settings: TenantSettings with {
      briefly "Settings"
      described as {
        |New settings.
      }
    }
  } with {
    briefly "Update settings"
    described as {
      |Updates tenant settings.
    }
  }
  command UpdateLimits is  {
    tenantId: TenantId with {
      briefly "Tenant ID"
      described as {
        |Tenant identifier.
      }
    }
    limits: TenantLimits with {
      briefly "Limits"
      described as {
        |New limits.
      }
    }
  } with {
    briefly "Update limits"
    described as {
      |Updates resource limits.
    }
  }
  command ChangeTier is  {
    tenantId: TenantId with {
      briefly "Tenant ID"
      described as {
        |Tenant identifier.
      }
    }
    newTier: TenantTier with {
      briefly "Tier"
      described as {
        |New tier.
      }
    }
    effectiveDate: Date with {
      briefly "Effective"
      described as {
        |Effective date.
      }
    }
  } with {
    briefly "Change tier"
    described as {
      |Changes service tier.
    }
  }
  command AddUser is  {
    tenantId: TenantId with {
      briefly "Tenant ID"
      described as {
        |Tenant identifier.
      }
    }
    user: TenantUserInfo with {
      briefly "User"
      described as {
        |User to add.
      }
    }
  } with {
    briefly "Add user"
    described as {
      |Adds user to tenant.
    }
  }
  command RemoveUser is  {
    tenantId: TenantId with {
      briefly "Tenant ID"
      described as {
        |Tenant identifier.
      }
    }
    userId: TenantUserId with {
      briefly "User"
      described as {
        |User to remove.
      }
    }
  } with {
    briefly "Remove user"
    described as {
      |Removes user from tenant.
    }
  }
  command ConfigureCustomDomain is  {
    tenantId: TenantId with {
      briefly "Tenant ID"
      described as {
        |Tenant identifier.
      }
    }
    domainName: CustomDomain with {
      briefly "Domain"
      described as {
        |Custom domain.
      }
    }
  } with {
    briefly "Configure custom domain"
    described as {
      |Sets up custom domain.
    }
  }
  command RecordUsage is  {
    tenantId: TenantId with {
      briefly "Tenant ID"
      described as {
        |Tenant identifier.
      }
    }
    usage: TenantUsage with {
      briefly "Usage"
      described as {
        |Usage metrics.
      }
    }
  } with {
    briefly "Record usage"
    described as {
      |Records resource usage.
    }
  }
  command SuspendTenant is  {
    tenantId: TenantId with {
      briefly "Tenant ID"
      described as {
        |Tenant identifier.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Suspension reason.
      }
    }
  } with {
    briefly "Suspend tenant"
    described as {
      |Suspends tenant access.
    }
  }
  command ReactivateTenant is  {
    tenantId: TenantId with {
      briefly "Tenant ID"
      described as {
        |Tenant identifier.
      }
    }
  } with {
    briefly "Reactivate tenant"
    described as {
      |Reactivates suspended tenant.
    }
  }
  command DeactivateTenant is  {
    tenantId: TenantId with {
      briefly "Tenant ID"
      described as {
        |Tenant identifier.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Deactivation reason.
      }
    }
  } with {
    briefly "Deactivate tenant"
    described as {
      |Deactivates tenant.
    }
  }
  // Events
  event TenantProvisioned is  {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    tenantInfo: TenantInfo with {
      briefly "Info"
      described as {
        |Tenant info.
      }
    }
    provisionedAt: TimeStamp with {
      briefly "Provisioned"
      described as {
        |Provision time.
      }
    }
  } with {
    briefly "Tenant provisioned"
    described as {
      |Emitted when tenant provisioned.
    }
  }
  event TenantActivated is  {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    activatedAt: TimeStamp with {
      briefly "Activated"
      described as {
        |Activation time.
      }
    }
  } with {
    briefly "Tenant activated"
    described as {
      |Emitted when tenant activated.
    }
  }
  event SettingsUpdated is  {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    settings: TenantSettings with {
      briefly "Settings"
      described as {
        |Settings.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Settings updated"
    described as {
      |Emitted when settings change.
    }
  }
  event LimitsUpdated is  {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    limits: TenantLimits with {
      briefly "Limits"
      described as {
        |Limits.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Limits updated"
    described as {
      |Emitted when limits change.
    }
  }
  event TierChanged is  {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    newTier: TenantTier with {
      briefly "Tier"
      described as {
        |New tier.
      }
    }
    effectiveDate: Date with {
      briefly "Effective"
      described as {
        |Effective date.
      }
    }
  } with {
    briefly "Tier changed"
    described as {
      |Emitted when tier changes.
    }
  }
  event UserAdded is  {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    user: TenantUserInfo with {
      briefly "User"
      described as {
        |User added.
      }
    }
    addedAt: TimeStamp with {
      briefly "Added"
      described as {
        |Add time.
      }
    }
  } with {
    briefly "User added"
    described as {
      |Emitted when user added.
    }
  }
  event UserRemoved is  {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    userId: TenantUserId with {
      briefly "User"
      described as {
        |User removed.
      }
    }
    removedAt: TimeStamp with {
      briefly "Removed"
      described as {
        |Remove time.
      }
    }
  } with {
    briefly "User removed"
    described as {
      |Emitted when user removed.
    }
  }
  event CustomDomainConfigured is  {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    domainName: CustomDomain with {
      briefly "Domain"
      described as {
        |Custom domain.
      }
    }
    configuredAt: TimeStamp with {
      briefly "Configured"
      described as {
        |Config time.
      }
    }
  } with {
    briefly "Custom domain configured"
    described as {
      |Emitted when domain configured.
    }
  }
  event UsageRecorded is  {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    usage: TenantUsage with {
      briefly "Usage"
      described as {
        |Usage.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Usage recorded"
    described as {
      |Emitted when usage recorded.
    }
  }
  event TenantSuspended is  {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason.
      }
    }
    suspendedAt: TimeStamp with {
      briefly "Suspended"
      described as {
        |Suspend time.
      }
    }
  } with {
    briefly "Tenant suspended"
    described as {
      |Emitted when tenant suspended.
    }
  }
  event TenantReactivated is  {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    reactivatedAt: TimeStamp with {
      briefly "Reactivated"
      described as {
        |Reactivate time.
      }
    }
  } with {
    briefly "Tenant reactivated"
    described as {
      |Emitted when tenant reactivated.
    }
  }
  event TenantDeactivated is  {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason.
      }
    }
    deactivatedAt: TimeStamp with {
      briefly "Deactivated"
      described as {
        |Deactivate time.
      }
    }
  } with {
    briefly "Tenant deactivated"
    described as {
      |Emitted when tenant deactivated.
    }
  }
  // States
  record ActiveStateData is  {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    tenantInfo: TenantInfo with {
      briefly "Info"
      described as {
        |Tenant info.
      }
    }
    status: TenantStatus with {
      briefly "Status"
      described as {
        |Tenant status.
      }
    }
    limits: TenantLimits with {
      briefly "Limits"
      described as {
        |Limits.
      }
    }
    updatedSettings: TenantSettings? with {
      briefly "Settings"
      described as {
        |Settings.
      }
    }
    users: TenantUserInfo* with {
      briefly "Users"
      described as {
        |Tenant users.
      }
    }
    customDomain: CustomDomain? with {
      briefly "Domain"
      described as {
        |Custom domain.
      }
    }
    currentUsage: TenantUsage? with {
      briefly "Usage"
      described as {
        |Current usage.
      }
    }
    provisionedAt: TimeStamp with {
      briefly "Provisioned"
      described as {
        |Provision time.
      }
    }
  } with {
    briefly "Active tenant state"
    described as {
      |State for active tenant.
    }
  }
  record DeactivatedStateData is  {
    tenantId: TenantId with {
      briefly "Tenant"
      described as {
        |Tenant ID.
      }
    }
    tenantName: String(1,200) with {
      briefly "Name"
      described as {
        |Tenant name.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Deactivation reason.
      }
    }
    deactivatedAt: TimeStamp with {
      briefly "Deactivated"
      described as {
        |Deactivate time.
      }
    }
  } with {
    briefly "Deactivated tenant state"
    described as {
      |State for deactivated tenant.
    }
  }
  // Queries
  query GetTenant replies result TenantResult is {
    tenantId: TenantId with {
      briefly "ID"
      described as {
        |Tenant to retrieve.
      }
    }
  } with {
    briefly "Get Tenant"
    described as {
      |Retrieves Tenant data.
    }
  }
  result TenantResult is  {
    tenantId: TenantId with {
      briefly "ID"
      described as {
        |Tenant identifier.
      }
    }
  } with {
    briefly "Tenant result"
    described as {
      |Tenant data result.
    }
  }
  initial state ActiveState of record Tenant.ActiveStateData is {
    initial handler ActiveStateInitHandler is {
      on init is {
        set state ActiveState to "initialize from prior event"
      }
    } with {
      briefly "Initializes Active state"
      described as {
        |Handles initialization of the Active state.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |The entity in Active state.
    }
  }
  state DeactivatedState of record Tenant.DeactivatedStateData is {
    initial handler DeactivatedStateInitHandler is {
      on init is {
        set state DeactivatedState to "initialize from prior event"
      }
    } with {
      briefly "Initializes Deactivated state"
      described as {
        |Handles initialization of the Deactivated state.
      }
    }
  } with {
    briefly "Deactivated state"
    described as {
      |The entity in Deactivated state.
    }
  }
  handler TenantHandler is {
    on provisionTenant: command ProvisionTenant is {
      morph entity TenantContext.Tenant to state TenantContext.Tenant.ActiveState with record Tenant.ActiveStateData(tenantId = provisionTenant.tenantId, tenantInfo = provisionTenant.tenantInfo, limits = provisionTenant.limits, status = prompt("the status of this active state data"), updatedSettings = empty, users = empty, customDomain = empty, currentUsage = empty, provisionedAt = prompt("the provisioned at of this active state data"))
      tell event TenantProvisioned(tenantId = provisionTenant.tenantId, tenantInfo = provisionTenant.tenantInfo, provisionedAt = prompt("the provisioned at of this tenant provisioned")) to entity TenantContext.Tenant
    }
    on activateTenant: command ActivateTenant is {
      tell event TenantActivated(tenantId = activateTenant.tenantId, activatedAt = activateTenant.activatedAt) to entity TenantContext.Tenant
    }
    on updateSettings: command UpdateSettings is {
      tell event SettingsUpdated(tenantId = updateSettings.tenantId, settings = updateSettings.settings, updatedAt = prompt("the updated at of this settings updated")) to entity TenantContext.Tenant
    }
    on updateLimits: command UpdateLimits is {
      tell event LimitsUpdated(tenantId = updateLimits.tenantId, limits = updateLimits.limits, updatedAt = prompt("the updated at of this limits updated")) to entity TenantContext.Tenant
    }
    on changeTier: command ChangeTier is {
      tell event TierChanged(tenantId = changeTier.tenantId, newTier = changeTier.newTier, effectiveDate = changeTier.effectiveDate) to entity TenantContext.Tenant
    }
    on addUser: command AddUser is {
      tell event UserAdded(tenantId = addUser.tenantId, user = addUser.user, addedAt = prompt("the added at of this user added")) to entity TenantContext.Tenant
    }
    on removeUser: command RemoveUser is {
      tell event UserRemoved(tenantId = removeUser.tenantId, userId = removeUser.userId, removedAt = prompt("the removed at of this user removed")) to entity TenantContext.Tenant
    }
    on configureCustomDomain: command ConfigureCustomDomain is {
      tell event CustomDomainConfigured(tenantId = configureCustomDomain.tenantId, domainName = configureCustomDomain.domainName, configuredAt = prompt("the configured at of this custom domain configured")) to entity TenantContext.Tenant
    }
    on recordUsage: command RecordUsage is {
      tell event UsageRecorded(tenantId = recordUsage.tenantId, usage = recordUsage.usage, recordedAt = prompt("the recorded at of this usage recorded")) to entity TenantContext.Tenant
    }
    on suspendTenant: command SuspendTenant is {
      tell event TenantSuspended(tenantId = suspendTenant.tenantId, reason = suspendTenant.reason, suspendedAt = prompt("the suspended at of this tenant suspended")) to entity TenantContext.Tenant
    }
    on reactivateTenant: command ReactivateTenant is {
      tell event TenantReactivated(tenantId = reactivateTenant.tenantId, reactivatedAt = prompt("the reactivated at of this tenant reactivated")) to entity TenantContext.Tenant
    }
    on deactivateTenant: command DeactivateTenant is {
      morph entity TenantContext.Tenant to state TenantContext.Tenant.DeactivatedState with record Tenant.DeactivatedStateData(tenantId = deactivateTenant.tenantId, reason = deactivateTenant.reason, tenantName = prompt("the tenant name of this deactivated state data"), deactivatedAt = prompt("the deactivated at of this deactivated state data"))
      tell event TenantDeactivated(tenantId = deactivateTenant.tenantId, reason = deactivateTenant.reason, deactivatedAt = prompt("the deactivated at of this tenant deactivated")) to entity TenantContext.Tenant
    }
    on getTenant: query GetTenant is {
      reply result TenantResult(tenantId = getTenant.tenantId)
    }
      on customDomainConfigured: event CustomDomainConfigured is {
      do "apply CustomDomainConfigured to the tenant so it can be persisted and replayed"
    }
    on limitsUpdated: event LimitsUpdated is {
      do "apply LimitsUpdated to the tenant so it can be persisted and replayed"
    }
    on settingsUpdated: event SettingsUpdated is {
      do "apply SettingsUpdated to the tenant so it can be persisted and replayed"
    }
    on tenantActivated: event TenantActivated is {
      do "apply TenantActivated to the tenant so it can be persisted and replayed"
    }
    on tenantDeactivated: event TenantDeactivated is {
      do "apply TenantDeactivated to the tenant so it can be persisted and replayed"
    }
    on tenantProvisioned: event TenantProvisioned is {
      do "apply TenantProvisioned to the tenant so it can be persisted and replayed"
    }
    on tenantReactivated: event TenantReactivated is {
      do "apply TenantReactivated to the tenant so it can be persisted and replayed"
    }
    on tenantSuspended: event TenantSuspended is {
      do "apply TenantSuspended to the tenant so it can be persisted and replayed"
    }
    on tierChanged: event TierChanged is {
      do "apply TierChanged to the tenant so it can be persisted and replayed"
    }
    on usageRecorded: event UsageRecorded is {
      do "apply UsageRecorded to the tenant so it can be persisted and replayed"
    }
    on userAdded: event UserAdded is {
      do "apply UserAdded to the tenant so it can be persisted and replayed"
    }
    on userRemoved: event UserRemoved is {
      do "apply UserRemoved to the tenant so it can be persisted and replayed"
    }
} with {
    briefly "Processes tenant commands"
    described as {
      |Handles tenant lifecycle.
    }
  }
} with {
  briefly "Tenant aggregate"
  described as {
    |Manages SaaS tenants.
  }
}
