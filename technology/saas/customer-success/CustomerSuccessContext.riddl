// CustomerSuccessContext - Main bounded context for customer success operations
context CustomerSuccessContext is {
  adaptor FromBillingService from context BillingService is { 
    handler FromBillingServiceHandler is {
      on event BillingService.InvoiceOverdue is {
        do "the model receives invoice overdue"
      }
      on event BillingService.InvoicePaid is {
        do "the model receives invoice paid"
      }
      on event BillingService.PaymentMethodFailed is {
        do "the model receives payment method failed"
      }
      on event BillingService.SubscriptionCancellationRequested is {
        do "the model receives subscription cancellation requested"
      }
      on event BillingService.SubscriptionChanged is {
        do "the model receives subscription changed"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromCRMIntegration from context CRMIntegration is { 
    handler FromCRMIntegrationHandler is {
      on event CRMIntegration.AccountSyncedFromCrm is {
        do "the model receives account synced from crm"
      }
      on event CRMIntegration.ContactSyncedFromCrm is {
        do "the model receives contact synced from crm"
      }
      on event CRMIntegration.HealthScorePushedToCrm is {
        do "the model receives health score pushed to crm"
      }
      on event CRMIntegration.OpportunityUpdatedInCrm is {
        do "the model receives opportunity updated in crm"
      }
      on other is {
        error "Unexpected message for adaptor FromCRMIntegration"
      }
    } with {
      briefly "from crm integration"
      described as {
        |Carries messages from the external CRMIntegration.
      }
    }
  } with {
    briefly "CRMIntegration integration"
    described as {
      |The model's side of the CRMIntegration conversation.
    }
  }
  adaptor FromUsageAnalytics from context UsageAnalytics is { 
    handler FromUsageAnalyticsHandler is {
      on event UsageAnalytics.AdoptionScoreUpdated is {
        do "the model receives adoption score updated"
      }
      on event UsageAnalytics.UsageAnomalyDetected is {
        do "the model receives usage anomaly detected"
      }
      on event UsageAnalytics.UsageMetricsCalculated is {
        do "the model receives usage metrics calculated"
      }
      on other is {
        error "Unexpected message for adaptor FromUsageAnalytics"
      }
    } with {
      briefly "from usage analytics"
      described as {
        |Carries messages from the external UsageAnalytics.
      }
    }
  } with {
    briefly "UsageAnalytics integration"
    described as {
      |The model's side of the UsageAnalytics conversation.
    }
  }
  include "types.riddl"
  include "CustomerAccount.riddl"
  // Repository for persisting customer account data
  repository CustomerAccountRepository as merge is {
    record StoredCustomerAccount is  {
      customerAccountId: UUID with {
        briefly "customerAccountId"
        described as {
          |The customerAccountId column of the stored customerAccount row.
        }
      }
    } with {
      briefly "Stored customerAccount row"
      described as {
        |The persistence shape of customerAccount data as this repository stores it.
      }
    }
    schema CustomerAccountData is relational
      of customeraccounts as type StoredCustomerAccount
 with {
      briefly "Customer account data schema"
      described as {
        |The relational schema persisting customer account records for this repository.
      }
    }
    inlet CustomerAccountRepositoryFromCustomerAccount is type CustomerAccountEvent    inlet CustomerAccountRepositoryFromHealthScoreTrendsProjector is type CustomerAccountEvent    inlet CustomerAccountRepositoryFromChurnMetricsProjector is type CustomerAccountEvent    outlet CustomerAccountRepositoryResponses is type CustomerAccount.CustomerAccountResult
    query FindAccountById is  {
      accountId: AccountId with {
        briefly "Account ID"
        described as {
          |Account to retrieve.
        }
      }
    } with {
      briefly "Find account by ID"
      described as {
        |Retrieves a single customer account by its unique ID.
      }
    }
    result AccountFound is  {
      account: CustomerAccount.ActiveStateData with {
        briefly "Account"
        described as {
          |Found account data.
        }
      }
    } with {
      briefly "Account result"
      described as {
        |Contains the requested customer account if found.
      }
    }
    query FindAccountsByHealthStatus is  {
      healthStatus: HealthStatus with {
        briefly "Health status"
        described as {
          |Status to filter by.
        }
      }
      pageNumber: Integer with {
        briefly "Page"
        described as {
          |Page number.
        }
      }
      pageSize: Integer with {
        briefly "Size"
        described as {
          |Page size.
        }
      }
    } with {
      briefly "Find by health status"
      described as {
        |Retrieves all customer accounts with the specified health status.
      }
    }
    query FindAccountsByCsm is  {
      csmId: String(1,50) with {
        briefly "CSM ID"
        described as {
          |CSM to filter by.
        }
      }
      pageNumber: Integer with {
        briefly "Page"
        described as {
          |Page number.
        }
      }
      pageSize: Integer with {
        briefly "Size"
        described as {
          |Page size.
        }
      }
    } with {
      briefly "Find by CSM"
      described as {
        |Retrieves all customer accounts managed by a specific CSM.
      }
    }
    query FindAccountsNearingRenewal is  {
      daysUntilRenewal: Integer with {
        briefly "Days"
        described as {
          |Days until renewal.
        }
      }
      pageNumber: Integer with {
        briefly "Page"
        described as {
          |Page number.
        }
      }
      pageSize: Integer with {
        briefly "Size"
        described as {
          |Page size.
        }
      }
    } with {
      briefly "Find nearing renewal"
      described as {
        |Retrieves accounts with contract end dates within the specified window.
      }
    }
    query FindAtRiskAccounts is  {
      minimumRiskScore: Integer with {
        briefly "Minimum score"
        described as {
          |Minimum risk score threshold.
        }
      }
      pageNumber: Integer with {
        briefly "Page"
        described as {
          |Page number.
        }
      }
      pageSize: Integer with {
        briefly "Size"
        described as {
          |Page size.
        }
      }
    } with {
      briefly "Find at-risk"
      described as {
        |Retrieves accounts with risk scores at or above the threshold.
      }
    }
    result AccountsFound is  {
      accounts: CustomerAccount.ActiveStateData+ with {
        briefly "Accounts"
        described as {
          |Matching accounts.
        }
      }
      totalCount: Integer with {
        briefly "Total"
        described as {
          |Total matching count.
        }
      }
      pageNumber: Integer with {
        briefly "Page"
        described as {
          |Current page.
        }
      }
      pageSize: Integer with {
        briefly "Size"
        described as {
          |Page size.
        }
      }
    } with {
      briefly "Accounts result"
      described as {
        |Contains a paginated list of matching customer accounts.
      }
    }
    handler CustomerAccountRepositoryHandler is {
      on query GetHealthScoreTrendState is {
        do "read the health score trend state projection"
        reply result HealthScoreTrendStateView
      }
      on query GetChurnMetricsState is {
        do "read the churn metrics state projection"
        reply result ChurnMetricsStateView
      }
      on query FindAccountById is {
        tell result AccountFound to entity CustomerSuccessContext.CustomerAccount
      }
      on findAccountsByHealthStatus: query FindAccountsByHealthStatus is {
        tell result AccountsFound(pageNumber = findAccountsByHealthStatus.pageNumber, pageSize = findAccountsByHealthStatus.pageSize) to entity CustomerSuccessContext.CustomerAccount
      }
      on findAccountsByCsm: query FindAccountsByCsm is {
        tell result AccountsFound(pageNumber = findAccountsByCsm.pageNumber, pageSize = findAccountsByCsm.pageSize) to entity CustomerSuccessContext.CustomerAccount
      }
      on findAccountsNearingRenewal: query FindAccountsNearingRenewal is {
        tell result AccountsFound(pageNumber = findAccountsNearingRenewal.pageNumber, pageSize = findAccountsNearingRenewal.pageSize) to entity CustomerSuccessContext.CustomerAccount
      }
      on findAtRiskAccounts: query FindAtRiskAccounts is {
        tell result AccountsFound(pageNumber = findAtRiskAccounts.pageNumber, pageSize = findAtRiskAccounts.pageSize) to entity CustomerSuccessContext.CustomerAccount
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes storage, retrieval, and deletion of customer account data.
      }
    }
  } with {
    briefly "Account repository"
    described as {
      | Provides data access operations for customer account records including
      | CRUD operations and specialized queries for CSM workflows such as
      | finding at-risk accounts or accounts nearing renewal.
    }
  }
  // Projector for health score analytics
  query GetHealthScoreTrendState is  {
    healthScoreTrendStateKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which health score trend state to retrieve.
      }
    }
  } with {
    briefly "Get health score trend state"
    described as {
      |Retrieves the health score trend state projection.
    }
  }
  result HealthScoreTrendStateView is  {
    healthScoreTrendState: HealthScoreTrendsProjector.HealthScoreTrendState with {
      briefly "Health score trend state"
      described as {
        |The health score trend state being returned.
      }
    }
  } with {
    briefly "Health score trend state view"
    described as {
      |Read model view carrying the health score trend state projection.
    }
  }
  projector HealthScoreTrendsProjector as flow is {
    updates repository CustomerSuccessContext.CustomerAccountRepository
    inlet HealthScoreTrendsProjectorFromCustomerAccount is type CustomerAccountEvent    outlet HealthScoreTrendsProjectorOut is type CustomerAccountEvent
    record HealthScoreTrend is  {
      accountId: AccountId with {
        briefly "Account"
        described as {
          |Account ID.
        }
      }
      companyName: String(1,200) with {
        briefly "Company"
        described as {
          |Company name.
        }
      }
      currentScore: Integer with {
        briefly "Current"
        described as {
          |Current score.
        }
      }
      previousScore: Integer with {
        briefly "Previous"
        described as {
          |Previous score.
        }
      }
      scoreChange: Integer with {
        briefly "Change"
        described as {
          |Score change.
        }
      }
      trendDirection: String(1,20) with {
        briefly "Direction"
        described as {
          |Trend direction.
        }
      }
      periodStart: Date with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Period end.
        }
      }
    } with {
      briefly "Health score trend"
      described as {
        |Shows how an account's health score has changed over a period.
      }
    }
    record PortfolioHealthSummary is  {
      totalAccounts: Integer with {
        briefly "Total"
        described as {
          |Total accounts.
        }
      }
      healthyCount: Integer with {
        briefly "Healthy"
        described as {
          |Healthy accounts.
        }
      }
      atRiskCount: Integer with {
        briefly "At-risk"
        described as {
          |At-risk accounts.
        }
      }
      criticalCount: Integer with {
        briefly "Critical"
        described as {
          |Critical accounts.
        }
      }
      newCount: Integer with {
        briefly "New"
        described as {
          |New accounts.
        }
      }
      averageHealthScore: Decimal(5,2) with {
        briefly "Average"
        described as {
          |Average health score.
        }
      }
      totalArrAtRisk: Decimal(14,2) with {
        briefly "ARR at risk"
        described as {
          |Total ARR at risk.
        }
      }
      calculatedAt: TimeStamp with {
        briefly "Calculated"
        described as {
          |Calculation time.
        }
      }
    } with {
      briefly "Portfolio summary"
      described as {
        |Provides a snapshot of health metrics across all managed accounts.
      }
    }
    record HealthScoreTrendState is  {
      trends: HealthScoreTrend+ with {
        briefly "Trends"
        described as {
          |Health trends.
        }
      }
      portfolioSummary: PortfolioHealthSummary with {
        briefly "Summary"
        described as {
          |Portfolio summary.
        }
      }
    } with {
      briefly "Trend state"
      described as {
        |Contains all computed health trends and portfolio summary.
      }
    }
    handler HealthScoreTrendsHandler is {
      on healthScoreUpdated: event CustomerAccount.HealthScoreUpdated is {
        tell healthScoreUpdated to repository CustomerSuccessContext.CustomerAccountRepository
      }
      on accountFlaggedAtRisk: event CustomerAccount.AccountFlaggedAtRisk is {
        tell accountFlaggedAtRisk to repository CustomerSuccessContext.CustomerAccountRepository
      }
      on customerChurned: event CustomerAccount.CustomerChurned is {
        tell customerChurned to repository CustomerSuccessContext.CustomerAccountRepository
      }
    } with {
      briefly "Processes health events"
      described as {
        |Maintains the health score trend projections based on domain events.
      }
    }
  } with {
    briefly "Health score trends"
    described as {
      | Maintains read-optimized views of health score trends over time.
      | Enables CSM leadership to track portfolio health, identify
      | deteriorating accounts, and measure the effectiveness of
      | customer success interventions.
    }
  }
  // Projector for churn analytics
  query GetChurnMetricsState is  {
    churnMetricsStateKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which churn metrics state to retrieve.
      }
    }
  } with {
    briefly "Get churn metrics state"
    described as {
      |Retrieves the churn metrics state projection.
    }
  }
  result ChurnMetricsStateView is  {
    churnMetricsState: ChurnMetricsProjector.ChurnMetricsState with {
      briefly "Churn metrics state"
      described as {
        |The churn metrics state being returned.
      }
    }
  } with {
    briefly "Churn metrics state view"
    described as {
      |Read model view carrying the churn metrics state projection.
    }
  }
  projector ChurnMetricsProjector as flow is {
    updates repository CustomerSuccessContext.CustomerAccountRepository
    inlet ChurnMetricsProjectorFromCustomerAccount is type CustomerAccountEvent    outlet ChurnMetricsProjectorOut is type CustomerAccountEvent
    record ChurnMetric is  {
      period: String(1,20) with {
        briefly "Period"
        described as {
          |Time period name.
        }
      }
      periodStart: Date with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Period end.
        }
      }
      churnedAccounts: Integer with {
        briefly "Churned"
        described as {
          |Accounts churned.
        }
      }
      churnedRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Revenue churned.
        }
      }
      churnRate: Decimal(5,2) with {
        briefly "Rate"
        described as {
          |Churn rate percent.
        }
      }
      topChurnReasons: String(1,200)+ with {
        briefly "Reasons"
        described as {
          |Top churn reasons.
        }
      }
    } with {
      briefly "Churn metric"
      described as {
        |Aggregates churn data for analysis and reporting.
      }
    }
    record ChurnBySegment is  {
      segment: String(1,50) with {
        briefly "Segment"
        described as {
          |Customer segment.
        }
      }
      accountCount: Integer with {
        briefly "Accounts"
        described as {
          |Total accounts.
        }
      }
      churnedCount: Integer with {
        briefly "Churned"
        described as {
          |Churned accounts.
        }
      }
      churnRate: Decimal(5,2) with {
        briefly "Rate"
        described as {
          |Segment churn rate.
        }
      }
      segmentRevenueAtRisk: Decimal(14,2) with {
        briefly "ARR at risk"
        described as {
          |Revenue at risk.
        }
      }
    } with {
      briefly "Churn by segment"
      described as {
        |Shows churn patterns across different customer tiers or segments.
      }
    }
    record ChurnRiskPipeline is  {
      criticalAccounts: Integer with {
        briefly "Critical"
        described as {
          |Critical count.
        }
      }
      criticalArr: Decimal(14,2) with {
        briefly "Critical ARR"
        described as {
          |Critical ARR.
        }
      }
      highRiskAccounts: Integer with {
        briefly "High"
        described as {
          |High risk count.
        }
      }
      highRiskArr: Decimal(14,2) with {
        briefly "High ARR"
        described as {
          |High risk ARR.
        }
      }
      mediumRiskAccounts: Integer with {
        briefly "Medium"
        described as {
          |Medium risk count.
        }
      }
      mediumRiskArr: Decimal(14,2) with {
        briefly "Medium ARR"
        described as {
          |Medium risk ARR.
        }
      }
      lowRiskAccounts: Integer with {
        briefly "Low"
        described as {
          |Low risk count.
        }
      }
      lowRiskArr: Decimal(14,2) with {
        briefly "Low ARR"
        described as {
          |Low risk ARR.
        }
      }
      calculatedAt: TimeStamp with {
        briefly "Calculated"
        described as {
          |Calculation time.
        }
      }
    } with {
      briefly "Risk pipeline"
      described as {
        |Categorizes at-risk accounts by severity and revenue impact.
      }
    }
    record ChurnMetricsState is  {
      monthlyMetrics: ChurnMetric+ with {
        briefly "Monthly"
        described as {
          |Monthly churn metrics.
        }
      }
      segmentBreakdown: ChurnBySegment+ with {
        briefly "Segments"
        described as {
          |Churn by segment.
        }
      }
      riskPipeline: ChurnRiskPipeline with {
        briefly "Pipeline"
        described as {
          |Risk pipeline.
        }
      }
    } with {
      briefly "Churn state"
      described as {
        |Contains all computed churn analytics and risk pipeline.
      }
    }
    handler ChurnMetricsHandler is {
      on customerChurned: event CustomerAccount.CustomerChurned is {
        tell customerChurned to repository CustomerSuccessContext.CustomerAccountRepository
      }
      on accountFlaggedAtRisk: event CustomerAccount.AccountFlaggedAtRisk is {
        tell accountFlaggedAtRisk to repository CustomerSuccessContext.CustomerAccountRepository
      }
      on healthScoreUpdated: event CustomerAccount.HealthScoreUpdated is {
        tell healthScoreUpdated to repository CustomerSuccessContext.CustomerAccountRepository
      }
    } with {
      briefly "Processes churn events"
      described as {
        |Maintains churn analytics based on customer lifecycle events.
      }
    }
  } with {
    briefly "Churn metrics"
    described as {
      | Provides real-time churn analytics including historical churn rates,
      | revenue impact, reason analysis, and current risk pipeline. Essential
      | for executive reporting and strategic retention planning.
    }
  }
  // Event streaming infrastructure
  type CustomerAccountEvent is one of {
    CustomerSuccessContext.CustomerAccount.CustomerOnboarded or CustomerSuccessContext.CustomerAccount.HealthScoreUpdated or CustomerSuccessContext.CustomerAccount.TouchpointRecorded or CustomerSuccessContext.CustomerAccount.AccountFlaggedAtRisk or CustomerSuccessContext.CustomerAccount.CustomerChurned
  } with {
    briefly "CustomerAccount events"
    described as {
      |Union of all CustomerAccount events for streaming.
    }
  }
  processor CustomerAccountSource as source is {
    outlet CustomerAccountEventOutlet is type CustomerAccountEvent
 with {
      briefly "Event outlet"
      described as {
        |Outlet for CustomerAccount events.
      }
    }
    handler CustomerAccountSourceHandler is {
      on init is {
        tell command CustomerAccount.InitializeCustomerAccount to entity CustomerSuccessContext.CustomerAccount
      }
      on customerOnboarded: event CustomerAccount.CustomerOnboarded is {
        send customerOnboarded to outlet CustomerAccountEventOutlet
      }
      on healthScoreUpdated: event CustomerAccount.HealthScoreUpdated is {
        send healthScoreUpdated to outlet CustomerAccountEventOutlet
      }
      on recordedTouchpoint: event CustomerAccount.TouchpointRecorded is {
        send recordedTouchpoint to outlet CustomerAccountEventOutlet
      }
      on accountFlaggedAtRisk: event CustomerAccount.AccountFlaggedAtRisk is {
        send accountFlaggedAtRisk to outlet CustomerAccountEventOutlet
      }
      on customerChurned: event CustomerAccount.CustomerChurned is {
        send customerChurned to outlet CustomerAccountEventOutlet
      }
      on other is {
        error "Unexpected message for source CustomerAccountSource"
      }
    } with {
      briefly "Source handler"
      described as {
        |Handles CustomerAccount events for streaming.
      }
    }
  } with {
    briefly "CustomerAccount event source"
    described as {
      |Publishes CustomerAccount events to the event stream.
    }
  }
  processor CustomerAccountSink as sink is {
    inlet CustomerAccountEventInlet is type CustomerAccountEvent with {
      briefly "Event inlet"
      described as {
        |Inlet for CustomerAccount events.
      }
    }
    handler CustomerAccountSinkHandler is {
      on init is { ??? }
      on customerOnboarded: event CustomerAccount.CustomerOnboarded is {
        tell customerOnboarded to repository CustomerSuccessContext.CustomerAccountRepository
      }
      on healthScoreUpdated: event CustomerAccount.HealthScoreUpdated is {
        tell healthScoreUpdated to repository CustomerSuccessContext.CustomerAccountRepository
      }
      on recordedTouchpoint: event CustomerAccount.TouchpointRecorded is {
        tell recordedTouchpoint to repository CustomerSuccessContext.CustomerAccountRepository
      }
      on accountFlaggedAtRisk: event CustomerAccount.AccountFlaggedAtRisk is {
        tell accountFlaggedAtRisk to repository CustomerSuccessContext.CustomerAccountRepository
      }
      on customerChurned: event CustomerAccount.CustomerChurned is {
        tell customerChurned to repository CustomerSuccessContext.CustomerAccountRepository
      }
      on other is {
        error "Unexpected message for sink CustomerAccountSink"
      }
    } with {
      briefly "Sink handler"
      described as {
        |Handles incoming CustomerAccount events for persistence.
      }
    }
  } with {
    briefly "CustomerAccount event sink"
    described as {
      |Receives CustomerAccount events for persistence.
    }
  }
  connector CustomerAccountEventFlow is from outlet CustomerSuccessContext.CustomerAccountSource.CustomerAccountEventOutlet to inlet CustomerSuccessContext.CustomerAccountSink.CustomerAccountEventInlet with {
    briefly "CustomerAccount event connector"
    described as {
      |Wires CustomerAccount source to sink for event flow.
    }
  }
  processor CustomerAccountEventSplit as split is {
    inlet CustomerAccountEventSplitIn is type CustomerAccountEvent    outlet CustomerAccountEventSplitToCustomerAccountRepository is type CustomerAccountEvent
    outlet CustomerAccountEventSplitToHealthScoreTrendsProjector is type CustomerAccountEvent
    outlet CustomerAccountEventSplitToChurnMetricsProjector is type CustomerAccountEvent
    handler CustomerAccountEventSplitHandler is {
      on customerOnboarded: event CustomerAccount.CustomerOnboarded is {
        send customerOnboarded to outlet CustomerAccountEventSplitToCustomerAccountRepository
        send customerOnboarded to outlet CustomerAccountEventSplitToHealthScoreTrendsProjector
        send customerOnboarded to outlet CustomerAccountEventSplitToChurnMetricsProjector
        tell customerOnboarded to entity CustomerSuccessContext.CustomerAccount
      }
      on healthScoreUpdated: event CustomerAccount.HealthScoreUpdated is {
        send healthScoreUpdated to outlet CustomerAccountEventSplitToCustomerAccountRepository
        send healthScoreUpdated to outlet CustomerAccountEventSplitToHealthScoreTrendsProjector
        send healthScoreUpdated to outlet CustomerAccountEventSplitToChurnMetricsProjector
        tell healthScoreUpdated to entity CustomerSuccessContext.CustomerAccount
      }
      on recordedTouchpoint: event CustomerAccount.TouchpointRecorded is {
        send recordedTouchpoint to outlet CustomerAccountEventSplitToCustomerAccountRepository
        send recordedTouchpoint to outlet CustomerAccountEventSplitToHealthScoreTrendsProjector
        send recordedTouchpoint to outlet CustomerAccountEventSplitToChurnMetricsProjector
        tell recordedTouchpoint to entity CustomerSuccessContext.CustomerAccount
      }
      on accountFlaggedAtRisk: event CustomerAccount.AccountFlaggedAtRisk is {
        send accountFlaggedAtRisk to outlet CustomerAccountEventSplitToCustomerAccountRepository
        send accountFlaggedAtRisk to outlet CustomerAccountEventSplitToHealthScoreTrendsProjector
        send accountFlaggedAtRisk to outlet CustomerAccountEventSplitToChurnMetricsProjector
        tell accountFlaggedAtRisk to entity CustomerSuccessContext.CustomerAccount
      }
      on renewalInitiated: event CustomerAccount.RenewalInitiated is {
        send renewalInitiated to outlet CustomerAccountEventSplitToCustomerAccountRepository
        send renewalInitiated to outlet CustomerAccountEventSplitToHealthScoreTrendsProjector
        send renewalInitiated to outlet CustomerAccountEventSplitToChurnMetricsProjector
        tell renewalInitiated to entity CustomerSuccessContext.CustomerAccount
      }
      on customerChurned: event CustomerAccount.CustomerChurned is {
        send customerChurned to outlet CustomerAccountEventSplitToCustomerAccountRepository
        send customerChurned to outlet CustomerAccountEventSplitToHealthScoreTrendsProjector
        send customerChurned to outlet CustomerAccountEventSplitToChurnMetricsProjector
        tell customerChurned to entity CustomerSuccessContext.CustomerAccount
      }
      on other is {
        error "Unexpected message for processor CustomerAccountEventSplit"
      }
    } with {
      briefly "CustomerAccount event fan-out handler"
      described as {
        |Delivers each CustomerAccount event to all of its consumers.
      }
    }
  } with {
    briefly "CustomerAccount event fan-out"
    described as {
      |Fans CustomerAccount events out to the repository and projectors.
    }
  }
  connector 'CustomerAccountEvent Stream' is from outlet CustomerSuccessContext.CustomerAccount.CustomerAccountEvents to inlet CustomerSuccessContext.CustomerAccountEventSplit.CustomerAccountEventSplitIn with {
    briefly "CustomerAccount events, fanned out to storage and read models"
  }
  connector 'CustomerAccountEvent Storage' is from outlet CustomerSuccessContext.CustomerAccountEventSplit.CustomerAccountEventSplitToCustomerAccountRepository to inlet CustomerSuccessContext.CustomerAccountRepository.CustomerAccountRepositoryFromCustomerAccount with {
    briefly "CustomerAccount events on their way to storage"
  }
  connector 'HealthScoreTrendsProjector Feed' is from outlet CustomerSuccessContext.CustomerAccountEventSplit.CustomerAccountEventSplitToHealthScoreTrendsProjector to inlet CustomerSuccessContext.HealthScoreTrendsProjector.HealthScoreTrendsProjectorFromCustomerAccount with {
    briefly "CustomerAccount events feeding the HealthScoreTrendsProjector projection"
  }
  connector 'ChurnMetricsProjector Feed' is from outlet CustomerSuccessContext.CustomerAccountEventSplit.CustomerAccountEventSplitToChurnMetricsProjector to inlet CustomerSuccessContext.ChurnMetricsProjector.ChurnMetricsProjectorFromCustomerAccount with {
    briefly "CustomerAccount events feeding the ChurnMetricsProjector projection"
  }
  connector 'HealthScoreTrendsProjector Storage' is from outlet CustomerSuccessContext.HealthScoreTrendsProjector.HealthScoreTrendsProjectorOut to inlet CustomerSuccessContext.CustomerAccountRepository.CustomerAccountRepositoryFromHealthScoreTrendsProjector with {
    briefly "The HealthScoreTrendsProjector projection on its way to storage"
  }
  connector 'ChurnMetricsProjector Storage' is from outlet CustomerSuccessContext.ChurnMetricsProjector.ChurnMetricsProjectorOut to inlet CustomerSuccessContext.CustomerAccountRepository.CustomerAccountRepositoryFromChurnMetricsProjector with {
    briefly "The ChurnMetricsProjector projection on its way to storage"
  }
} with {
  briefly "Customer success context"
  described as {
    | The CustomerSuccessContext encapsulates all customer success operations
    | including account management, health scoring, touchpoint tracking, and
    | churn prevention. It provides the core capabilities needed by CSMs to
    | proactively manage customer relationships and drive net revenue retention.
  }
}
