// Tenant Provisioning Domain Model
// Multi-tenant SaaS account provisioning and lifecycle
domain TenantProvisioning is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user TenantAdmin is "person managing tenant configuration" with {
    briefly "Tenant Admin"
    described as {
      |Person administering a tenant.
    }
  }
  user PlatformOperator is "person managing the SaaS platform" with {
    briefly "Platform Operator"
    described as {
      |Person operating the platform.
    }
  }
  user EndUser is "person using the tenant application" with {
    briefly "End User"
    described as {
      |User within a tenant.
    }
  }
  epic TenantEpic is {
    user TenantAdmin wants to "to provision and configure their tenant" so that "their organization can use the platform"
    case ProvisionNewTenant is {
      user TenantAdmin wants to "to create a new tenant account" so that "their organization is onboarded"
      step is "Admin submits" "tenant registration" "with organization details" with {
        briefly "Submit registration"
        described as {
          |Start tenant provisioning.
        }
      }
      step is "System validates" "organization details" "and domain" with {
        briefly "Validate details"
        described as {
          |Check organization info.
        }
      }
      step send command TenantContext.Tenant.CreateTenant from user TenantAdmin to entity TenantContext.Tenant with {
        briefly "Create tenant"
        described as {
          |Provision the tenant.
        }
      }
      step is "System provisions" "infrastructure resources" "for tenant" with {
        briefly "Provision resources"
        described as {
          |Allocate infrastructure.
        }
      }
    } with {
      briefly "New tenant provisioning"
      described as {
        |Onboarding a new organization as a tenant.
      }
    }
  } with {
    briefly "Tenant management"
    described as {
      | Epic covering tenant provisioning, configuration,
      | scaling, and lifecycle management.
    }
  }
  include "TenantContext.riddl"
  include "external-contexts.riddl"
  application context TenantProvisioningApp is {
    outlet AppTenantCommands is type TenantContext.Tenant.TenantCommand
    inlet AppTenantRepositoryResponses is type TenantContext.Tenant.TenantResult
    handler TenantProvisioningAppHandler is {
      on other is {
        error "Unexpected message for application context TenantProvisioningApp"
      }
    } with {
      briefly "TenantProvisioningApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "TenantProvisioningApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppTenantCommands is {
    from outlet TenantProvisioningApp.AppTenantCommands to
      inlet TenantContext.Tenant.TenantCommands
  } with {
    option is persistent
    briefly "LinkAppTenantCommands"
  }
  connector LinkAppTenantRepositoryResponses is {
    from outlet TenantContext.TenantRepository.TenantRepositoryResponses to
      inlet TenantProvisioningApp.AppTenantRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppTenantRepositoryResponses"
  }
} with {
  briefly "Tenant provisioning domain"
  described as {
    | The TenantProvisioning domain handles multi-tenant
    | SaaS account creation, configuration, and lifecycle.
  }
}
