// Tenant Provisioning - Tenant Context
context TenantContext is {
  adaptor FromBillingIntegrationService from context BillingIntegrationService is { 
    handler FromBillingIntegrationServiceHandler is {
      on event BillingIntegrationService.BillingAccountCreated is {
        do "the model receives billing account created"
      }
      on event BillingIntegrationService.BillingTierUpdated is {
        do "the model receives billing tier updated"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingIntegrationService"
      }
    } with {
      briefly "from billing integration service"
      described as {
        |Carries messages from the external BillingIntegrationService.
      }
    }
  } with {
    briefly "BillingIntegrationService integration"
    described as {
      |The model's side of the BillingIntegrationService conversation.
    }
  }
  adaptor ToBillingIntegrationService to context BillingIntegrationService is { 
    handler ToBillingIntegrationServiceHandler is {
      on command BillingIntegrationService.CreateBillingAccount is {
        do "the model sends create billing account"
      }
      on command BillingIntegrationService.UpdateBillingTier is {
        do "the model sends update billing tier"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingIntegrationService"
      }
    } with {
      briefly "to billing integration service"
      described as {
        |Carries messages to the external BillingIntegrationService.
      }
    }
  } with {
    briefly "BillingIntegrationService integration"
    described as {
      |The model's side of the BillingIntegrationService conversation.
    }
  }
  adaptor FromDNSManagementService from context DNSManagementService is { 
    handler FromDNSManagementServiceHandler is {
      on event DNSManagementService.CustomDomainConfigured is {
        do "the model receives custom domain configured"
      }
      on event DNSManagementService.DomainVerificationFailed is {
        do "the model receives domain verification failed"
      }
      on other is {
        error "Unexpected message for adaptor FromDNSManagementService"
      }
    } with {
      briefly "from dns management service"
      described as {
        |Carries messages from the external DNSManagementService.
      }
    }
  } with {
    briefly "DNSManagementService integration"
    described as {
      |The model's side of the DNSManagementService conversation.
    }
  }
  adaptor ToDNSManagementService to context DNSManagementService is { 
    handler ToDNSManagementServiceHandler is {
      on command DNSManagementService.ConfigureCustomDomain is {
        do "the model sends configure custom domain"
      }
      on other is {
        error "Unexpected message for adaptor ToDNSManagementService"
      }
    } with {
      briefly "to dns management service"
      described as {
        |Carries messages to the external DNSManagementService.
      }
    }
  } with {
    briefly "DNSManagementService integration"
    described as {
      |The model's side of the DNSManagementService conversation.
    }
  }
  adaptor FromIdentityProviderService from context IdentityProviderService is { 
    handler FromIdentityProviderServiceHandler is {
      on event IdentityProviderService.SSOConfigured is {
        do "the model receives sso configured"
      }
      on event IdentityProviderService.TenantRealmCreated is {
        do "the model receives tenant realm created"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityProviderService"
      }
    } with {
      briefly "from identity provider service"
      described as {
        |Carries messages from the external IdentityProviderService.
      }
    }
  } with {
    briefly "IdentityProviderService integration"
    described as {
      |The model's side of the IdentityProviderService conversation.
    }
  }
  adaptor ToIdentityProviderService to context IdentityProviderService is { 
    handler ToIdentityProviderServiceHandler is {
      on command IdentityProviderService.ConfigureSSO is {
        do "the model sends configure sso"
      }
      on command IdentityProviderService.CreateTenantRealm is {
        do "the model sends create tenant realm"
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityProviderService"
      }
    } with {
      briefly "to identity provider service"
      described as {
        |Carries messages to the external IdentityProviderService.
      }
    }
  } with {
    briefly "IdentityProviderService integration"
    described as {
      |The model's side of the IdentityProviderService conversation.
    }
  }
  adaptor FromInfrastructureOrchestrator from context InfrastructureOrchestrator is { 
    handler FromInfrastructureOrchestratorHandler is {
      on event InfrastructureOrchestrator.InfrastructureProvisioned is {
        do "the model receives infrastructure provisioned"
      }
      on event InfrastructureOrchestrator.InfrastructureProvisioningFailed is {
        do "the model receives infrastructure provisioning failed"
      }
      on other is {
        error "Unexpected message for adaptor FromInfrastructureOrchestrator"
      }
    } with {
      briefly "from infrastructure orchestrator"
      described as {
        |Carries messages from the external InfrastructureOrchestrator.
      }
    }
  } with {
    briefly "InfrastructureOrchestrator integration"
    described as {
      |The model's side of the InfrastructureOrchestrator conversation.
    }
  }
  adaptor ToInfrastructureOrchestrator to context InfrastructureOrchestrator is { 
    handler ToInfrastructureOrchestratorHandler is {
      on command InfrastructureOrchestrator.ProvisionInfrastructure is {
        do "the model sends provision infrastructure"
      }
      on other is {
        error "Unexpected message for adaptor ToInfrastructureOrchestrator"
      }
    } with {
      briefly "to infrastructure orchestrator"
      described as {
        |Carries messages to the external InfrastructureOrchestrator.
      }
    }
  } with {
    briefly "InfrastructureOrchestrator integration"
    described as {
      |The model's side of the InfrastructureOrchestrator conversation.
    }
  }
  adaptor FromMonitoringService from context MonitoringService is { 
    handler FromMonitoringServiceHandler is {
      on event MonitoringService.MonitoringConfigured is {
        do "the model receives monitoring configured"
      }
      on result MonitoringService.TenantMetrics is {
        do "the model receives tenant metrics"
      }
      on other is {
        error "Unexpected message for adaptor FromMonitoringService"
      }
    } with {
      briefly "from monitoring service"
      described as {
        |Carries messages from the external MonitoringService.
      }
    }
  } with {
    briefly "MonitoringService integration"
    described as {
      |The model's side of the MonitoringService conversation.
    }
  }
  adaptor ToMonitoringService to context MonitoringService is { 
    handler ToMonitoringServiceHandler is {
      on query MonitoringService.GetTenantMetrics is {
        do "the model sends get tenant metrics"
      }
      on command MonitoringService.SetupTenantMonitoring is {
        do "the model sends setup tenant monitoring"
      }
      on other is {
        error "Unexpected message for adaptor ToMonitoringService"
      }
    } with {
      briefly "to monitoring service"
      described as {
        |Carries messages to the external MonitoringService.
      }
    }
  } with {
    briefly "MonitoringService integration"
    described as {
      |The model's side of the MonitoringService conversation.
    }
  }
  include "types.riddl"
  include "Tenant.riddl"
  // Repository for tenant persistence
  repository TenantRepository as merge is {
    inlet TenantRepositoryFromTenant is type TenantEvent    inlet TenantRepositoryFromTenantAnalytics is type TenantEvent    outlet TenantRepositoryResponses is type Tenant.TenantResult
    record StoredTenant is  {
      tenantId: TenantId with {
        briefly "tenantId"
        described as {
          |The tenantId column of the stored tenant row.
        }
      }
      organization: OrganizationInfo with {
        briefly "organization"
        described as {
          |The organization column of the stored tenant row.
        }
      }
    } with {
      briefly "Stored tenant row"
      described as {
        |The persistence shape of tenant data as this repository stores it.
      }
    }
    schema TenantData is relational
      of tenants as type StoredTenant
        index on field StoredTenant.tenantId
        index on field StoredTenant.organization.domainName
 with {
      briefly "Tenant data schema"
      described as {
        |The relational schema holding tenant data for the TenantRepository.
      }
    }
    handler TenantPersistence is {
      on query GetTenantStats is {
        let tenantStatsView: type TenantStatsView = prompt("read the tenant stats projection")
        reply tenantStatsView
      }
      on createTenant: command Tenant.CreateTenant is {
        tell event Tenant.TenantCreated(tenantId = createTenant.tenantId, organization = createTenant.organization, admin = createTenant.admin, configuration = createTenant.configuration) to entity TenantContext.Tenant
      }
      on configureTenant: command Tenant.ConfigureTenant is {
        tell event Tenant.TenantConfigured(tenantId = configureTenant.tenantId, configuration = configureTenant.configuration) to entity TenantContext.Tenant
      }
      on provisionResource: command Tenant.ProvisionResource is {
        tell event Tenant.ResourceProvisioned(tenantId = provisionResource.tenantId) to entity TenantContext.Tenant
      }
      on scaleResource: command Tenant.ScaleResource is {
        tell event Tenant.ResourceScaled(tenantId = scaleResource.tenantId, resourceId = scaleResource.resourceId, scalingPolicy = scaleResource.scalingPolicy) to entity TenantContext.Tenant
      }
      on upgradeTier: command Tenant.UpgradeTier is {
        tell event Tenant.TierUpgraded(tenantId = upgradeTier.tenantId, newTier = upgradeTier.newTier, effectiveDate = upgradeTier.effectiveDate) to entity TenantContext.Tenant
      }
      on suspendTenant: command Tenant.SuspendTenant is {
        tell event Tenant.TenantSuspended(tenantId = suspendTenant.tenantId, reason = suspendTenant.reason) to entity TenantContext.Tenant
      }
      on reactivateTenant: command Tenant.ReactivateTenant is {
        tell event Tenant.TenantReactivated(tenantId = reactivateTenant.tenantId) to entity TenantContext.Tenant
      }
      on decommissionTenant: command Tenant.DecommissionTenant is {
        tell event Tenant.TenantDecommissioned(tenantId = decommissionTenant.tenantId, decommission = decommissionTenant.decommission) to entity TenantContext.Tenant
      }
    } with {
      briefly "Persists tenant commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Tenant data persistence"
    described as {
      | The TenantRepository provides persistent storage for
      | tenants, configuration, and resources.
    }
  }
  // Projector for tenant analytics
  query GetTenantStats is  {
    tenantStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which tenant stats to retrieve.
      }
    }
  } with {
    briefly "Get tenant stats"
    described as {
      |Retrieves the tenant stats projection.
    }
  }
  result TenantStatsView is  {
    tenantStats: TenantAnalytics.TenantStats with {
      briefly "Tenant stats"
      described as {
        |The tenant stats being returned.
      }
    }
  } with {
    briefly "Tenant stats view"
    described as {
      |Read model view carrying the tenant stats projection.
    }
  }
  projector TenantAnalytics as flow is {
    updates repository TenantContext.TenantRepository
    inlet TenantAnalyticsFromTenant is type TenantEvent    outlet TenantAnalyticsOut is type TenantEvent
    record TenantStats is  {
      totalTenants: Natural with {
        briefly "Total"
        described as {
          |Total tenants.
        }
      }
      activeTenants: Natural with {
        briefly "Active"
        described as {
          |Active tenants.
        }
      }
      tenantsByTier: String(1,100)+ with {
        briefly "By tier"
        described as {
          |Counts by tier.
        }
      }
      averageResourcesPerTenant: Decimal(5,2) with {
        briefly "Avg resources"
        described as {
          |Average resources.
        }
      }
      provisioningSuccessRate: Decimal(5,4) with {
        briefly "Success rate"
        described as {
          |Provisioning success.
        }
      }
    } with {
      briefly "Tenant statistics"
      described as {
        |Platform tenant metrics.
      }
    }
    handler AnalyticsHandler is {
      on tenantCreated: event Tenant.TenantCreated is {
        tell tenantCreated to repository TenantContext.TenantRepository
      }
      on resourceProvisioned: event Tenant.ResourceProvisioned is {
        tell resourceProvisioned to repository TenantContext.TenantRepository
      }
      on tierUpgraded: event Tenant.TierUpgraded is {
        tell tierUpgraded to repository TenantContext.TenantRepository
      }
      on tenantDecommissioned: event Tenant.TenantDecommissioned is {
        tell tenantDecommissioned to repository TenantContext.TenantRepository
      }
    } with {
      briefly "Maintains tenant analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Tenant analytics projections"
    described as {
      |Maintains platform tenant analytics data.
    }
  }
  // Event streaming infrastructure
  type TenantEvent is one of {
    TenantContext.Tenant.TenantCreated or TenantContext.Tenant.TenantConfigured or TenantContext.Tenant.ResourceProvisioned or TenantContext.Tenant.ResourceScaled or TenantContext.Tenant.TenantDecommissioned
  } with {
    briefly "Tenant events"
    described as {
      |Union of all Tenant events for streaming.
    }
  }
  processor TenantSource as source is {
    outlet TenantEventOutlet is type TenantEvent
 with {
      briefly "Event outlet"
      described as {
        |Outlet for Tenant events.
      }
    }
    handler TenantSourceHandler is {
      on init is {
        tell command Tenant.InitializeTenant to entity TenantContext.Tenant
      }
      on tenantCreated: event Tenant.TenantCreated is {
        send tenantCreated to outlet TenantEventOutlet
      }
      on tenantConfigured: event Tenant.TenantConfigured is {
        send tenantConfigured to outlet TenantEventOutlet
      }
      on resourceProvisioned: event Tenant.ResourceProvisioned is {
        send resourceProvisioned to outlet TenantEventOutlet
      }
      on resourceScaled: event Tenant.ResourceScaled is {
        send resourceScaled to outlet TenantEventOutlet
      }
      on tenantDecommissioned: event Tenant.TenantDecommissioned is {
        send tenantDecommissioned to outlet TenantEventOutlet
      }
      on other is {
        error "Unexpected message for source TenantSource"
      }
    } with {
      briefly "Source handler"
      described as {
        |Handles Tenant events for streaming.
      }
    }
  } with {
    briefly "Tenant event source"
    described as {
      |Publishes Tenant events to the event stream.
    }
  }
  processor TenantSink as sink is {
    inlet TenantEventInlet is type TenantEvent with {
      briefly "Event inlet"
      described as {
        |Inlet for Tenant events.
      }
    }
    handler TenantSinkHandler is {
      on init is { ??? }
      on tenantCreated: event Tenant.TenantCreated is {
        tell tenantCreated to repository TenantContext.TenantRepository
      }
      on tenantConfigured: event Tenant.TenantConfigured is {
        tell tenantConfigured to repository TenantContext.TenantRepository
      }
      on resourceProvisioned: event Tenant.ResourceProvisioned is {
        tell resourceProvisioned to repository TenantContext.TenantRepository
      }
      on resourceScaled: event Tenant.ResourceScaled is {
        tell resourceScaled to repository TenantContext.TenantRepository
      }
      on tenantDecommissioned: event Tenant.TenantDecommissioned is {
        tell tenantDecommissioned to repository TenantContext.TenantRepository
      }
      on other is {
        error "Unexpected message for sink TenantSink"
      }
    } with {
      briefly "Sink handler"
      described as {
        |Handles incoming Tenant events for persistence.
      }
    }
  } with {
    briefly "Tenant event sink"
    described as {
      |Receives Tenant events for persistence.
    }
  }
  connector TenantEventFlow is from outlet TenantContext.TenantSource.TenantEventOutlet to inlet TenantContext.TenantSink.TenantEventInlet with {
    briefly "Tenant event connector"
    described as {
      |Wires Tenant source to sink for event flow.
    }
  }
  processor TenantEventSplit as split is {
    inlet TenantEventSplitIn is type TenantEvent    outlet TenantEventSplitToTenantRepository is type TenantEvent
    outlet TenantEventSplitToTenantAnalytics is type TenantEvent
    handler TenantEventSplitHandler is {
      on tenantCreated: event Tenant.TenantCreated is {
        send tenantCreated to outlet TenantEventSplitToTenantRepository
        send tenantCreated to outlet TenantEventSplitToTenantAnalytics
        tell tenantCreated to entity TenantContext.Tenant
      }
      on tenantConfigured: event Tenant.TenantConfigured is {
        send tenantConfigured to outlet TenantEventSplitToTenantRepository
        send tenantConfigured to outlet TenantEventSplitToTenantAnalytics
        tell tenantConfigured to entity TenantContext.Tenant
      }
      on resourceProvisioned: event Tenant.ResourceProvisioned is {
        send resourceProvisioned to outlet TenantEventSplitToTenantRepository
        send resourceProvisioned to outlet TenantEventSplitToTenantAnalytics
        tell resourceProvisioned to entity TenantContext.Tenant
      }
      on resourceScaled: event Tenant.ResourceScaled is {
        send resourceScaled to outlet TenantEventSplitToTenantRepository
        send resourceScaled to outlet TenantEventSplitToTenantAnalytics
        tell resourceScaled to entity TenantContext.Tenant
      }
      on tierUpgraded: event Tenant.TierUpgraded is {
        send tierUpgraded to outlet TenantEventSplitToTenantRepository
        send tierUpgraded to outlet TenantEventSplitToTenantAnalytics
        tell tierUpgraded to entity TenantContext.Tenant
      }
      on tenantSuspended: event Tenant.TenantSuspended is {
        send tenantSuspended to outlet TenantEventSplitToTenantRepository
        send tenantSuspended to outlet TenantEventSplitToTenantAnalytics
        tell tenantSuspended to entity TenantContext.Tenant
      }
      on tenantReactivated: event Tenant.TenantReactivated is {
        send tenantReactivated to outlet TenantEventSplitToTenantRepository
        send tenantReactivated to outlet TenantEventSplitToTenantAnalytics
        tell tenantReactivated to entity TenantContext.Tenant
      }
      on tenantDecommissioned: event Tenant.TenantDecommissioned is {
        send tenantDecommissioned to outlet TenantEventSplitToTenantRepository
        send tenantDecommissioned to outlet TenantEventSplitToTenantAnalytics
        tell tenantDecommissioned to entity TenantContext.Tenant
      }
      on other is {
        error "Unexpected message for processor TenantEventSplit"
      }
    } with {
      briefly "Tenant event fan-out handler"
      described as {
        |Delivers each Tenant event to all of its consumers.
      }
    }
  } with {
    briefly "Tenant event fan-out"
    described as {
      |Fans Tenant events out to the repository and projectors.
    }
  }
  connector 'TenantEvent Stream' is from outlet TenantContext.Tenant.TenantEvents to inlet TenantContext.TenantEventSplit.TenantEventSplitIn with {
    briefly "Tenant events, fanned out to storage and read models"
  }
  connector 'TenantEvent Storage' is from outlet TenantContext.TenantEventSplit.TenantEventSplitToTenantRepository to inlet TenantContext.TenantRepository.TenantRepositoryFromTenant with {
    briefly "Tenant events on their way to storage"
  }
  connector 'TenantAnalytics Feed' is from outlet TenantContext.TenantEventSplit.TenantEventSplitToTenantAnalytics to inlet TenantContext.TenantAnalytics.TenantAnalyticsFromTenant with {
    briefly "Tenant events feeding the TenantAnalytics projection"
  }
  connector 'TenantAnalytics Storage' is from outlet TenantContext.TenantAnalytics.TenantAnalyticsOut to inlet TenantContext.TenantRepository.TenantRepositoryFromTenantAnalytics with {
    briefly "The TenantAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for tenant provisioning"
  described as {
    | The TenantContext is the bounded context for
    | multi-tenant SaaS provisioning and management.
  }
}
