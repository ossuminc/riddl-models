// Usage Metering - Meter Context
context MeterContext as router is {
  inlet MeterCommandStreamIn is type MeterCommand
  outlet MeterCommandStreamOut is type MeterCommand
  inlet MeterQueryResultStreamIn is type Meter.MeterQueryResult
  outlet MeterQueryResultStreamOut is type Meter.MeterQueryResult
  handler MeterContextBoundary is {
    on createMeter: command Meter.CreateMeter is {
      send createMeter to outlet MeterContext.MeterCommandStreamOut
    }
    on recordUsageEvent: command Meter.RecordUsageEvent is {
      send recordUsageEvent to outlet MeterContext.MeterCommandStreamOut
    }
    on recordBatchEvents: command Meter.RecordBatchEvents is {
      send recordBatchEvents to outlet MeterContext.MeterCommandStreamOut
    }
    on aggregateUsage: command Meter.AggregateUsage is {
      send aggregateUsage to outlet MeterContext.MeterCommandStreamOut
    }
    on setAlertThreshold: command Meter.SetAlertThreshold is {
      send setAlertThreshold to outlet MeterContext.MeterCommandStreamOut
    }
    on removeAlertThreshold: command Meter.RemoveAlertThreshold is {
      send removeAlertThreshold to outlet MeterContext.MeterCommandStreamOut
    }
    on generateBillingRecord: command Meter.GenerateBillingRecord is {
      send generateBillingRecord to outlet MeterContext.MeterCommandStreamOut
    }
    on adjustUsage: command Meter.AdjustUsage is {
      send adjustUsage to outlet MeterContext.MeterCommandStreamOut
    }
    on pauseMeter: command Meter.PauseMeter is {
      send pauseMeter to outlet MeterContext.MeterCommandStreamOut
    }
    on resumeMeter: command Meter.ResumeMeter is {
      send resumeMeter to outlet MeterContext.MeterCommandStreamOut
    }
    on closeMeter: command Meter.CloseMeter is {
      send closeMeter to outlet MeterContext.MeterCommandStreamOut
    }
    on initializeMeter: command Meter.InitializeMeter is {
      send initializeMeter to outlet MeterContext.MeterCommandStreamOut
    }
    on meterQueryResult: result Meter.MeterQueryResult is {
      send meterQueryResult to outlet MeterContext.MeterQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the MeterContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'MeterCommand Stream Intake' is from outlet MeterContext.MeterCommandStreamOut to inlet MeterContext.Meter.MeterCommands
  connector 'MeterQueryResult Stream Egress' is from outlet MeterContext.MeterRepository.MeterRepositoryResponses to inlet MeterContext.MeterQueryResultStreamIn
  adaptor FromAnalyticsExportService from context AnalyticsExportService is { 
    handler FromAnalyticsExportServiceHandler is {
      on event AnalyticsExportService.ExportCompleted is {
        do "the model receives export completed"
      }
      on other is {
        error "Unexpected message for adaptor FromAnalyticsExportService"
      }
    } with {
      briefly "from analytics export service"
      described as {
        |Carries messages from the external AnalyticsExportService.
      }
    }
  } with {
    briefly "AnalyticsExportService integration"
    described as {
      |The model's side of the AnalyticsExportService conversation.
    }
  }
  adaptor ToAnalyticsExportService to context AnalyticsExportService is { 
    handler ToAnalyticsExportServiceHandler is {
      on command AnalyticsExportService.ExportUsageData is {
        do "the model sends export usage data"
      }
      on other is {
        error "Unexpected message for adaptor ToAnalyticsExportService"
      }
    } with {
      briefly "to analytics export service"
      described as {
        |Carries messages to the external AnalyticsExportService.
      }
    }
  } with {
    briefly "AnalyticsExportService integration"
    described as {
      |The model's side of the AnalyticsExportService conversation.
    }
  }
  adaptor FromBillingService from context BillingService is { 
    handler FromBillingServiceHandler is {
      on event BillingService.InvoiceCreated is {
        do "the model receives invoice created"
      }
      on result BillingService.InvoiceStatusResult is {
        do "the model receives invoice status result"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService is { 
    handler ToBillingServiceHandler is {
      on command BillingService.CreateInvoice is {
        do "the model sends create invoice"
      }
      on query BillingService.GetInvoiceStatus is {
        do "the model sends get invoice status"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromEventIngestionService from context EventIngestionService is { 
    handler FromEventIngestionServiceHandler is {
      on result EventIngestionService.IngestionStatsResult is {
        do "the model receives ingestion stats result"
      }
      on event EventIngestionService.RawUsageReceived is {
        do "the model receives raw usage received"
      }
      on other is {
        error "Unexpected message for adaptor FromEventIngestionService"
      }
    } with {
      briefly "from event ingestion service"
      described as {
        |Carries messages from the external EventIngestionService.
      }
    }
  } with {
    briefly "EventIngestionService integration"
    described as {
      |The model's side of the EventIngestionService conversation.
    }
  }
  adaptor ToEventIngestionService to context EventIngestionService is { 
    handler ToEventIngestionServiceHandler is {
      on query EventIngestionService.GetIngestionStats is {
        do "the model sends get ingestion stats"
      }
      on other is {
        error "Unexpected message for adaptor ToEventIngestionService"
      }
    } with {
      briefly "to event ingestion service"
      described as {
        |Carries messages to the external EventIngestionService.
      }
    }
  } with {
    briefly "EventIngestionService integration"
    described as {
      |The model's side of the EventIngestionService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.AlertSent is {
        do "the model receives alert sent"
      }
      on event NotificationService.SummarySent is {
        do "the model receives summary sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendUsageAlert is {
        do "the model sends send usage alert"
      }
      on command NotificationService.SendUsageSummary is {
        do "the model sends send usage summary"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromSubscriptionService from context SubscriptionService is { 
    handler FromSubscriptionServiceHandler is {
      on event SubscriptionService.SubscriptionChanged is {
        do "the model receives subscription changed"
      }
      on result SubscriptionService.SubscriptionDetailsResult is {
        do "the model receives subscription details result"
      }
      on other is {
        error "Unexpected message for adaptor FromSubscriptionService"
      }
    } with {
      briefly "from subscription service"
      described as {
        |Carries messages from the external SubscriptionService.
      }
    }
  } with {
    briefly "SubscriptionService integration"
    described as {
      |The model's side of the SubscriptionService conversation.
    }
  }
  adaptor ToSubscriptionService to context SubscriptionService is { 
    handler ToSubscriptionServiceHandler is {
      on query SubscriptionService.GetSubscriptionDetails is {
        do "the model sends get subscription details"
      }
      on other is {
        error "Unexpected message for adaptor ToSubscriptionService"
      }
    } with {
      briefly "to subscription service"
      described as {
        |Carries messages to the external SubscriptionService.
      }
    }
  } with {
    briefly "SubscriptionService integration"
    described as {
      |The model's side of the SubscriptionService conversation.
    }
  }
  include "types.riddl"
  include "Meter.riddl"
  // Repository
  repository MeterRepository as merge is {
    record StoredMeter is  {
      meterId: MeterId with {
        briefly "meterId"
        described as {
          |The meterId column of the stored meter row.
        }
      }
    } with {
      briefly "Stored meter row"
      described as {
        |The persistence shape of meter data as this repository stores it.
      }
    }
    schema MeterData is relational
      of meters as type StoredMeter
 with {
      briefly "Meter data schema"
      described as {
        |The relational schema persisting meter records for this repository.
      }
    }
    inlet MeterRepositoryFromMeter is type MeterEvent    inlet MeterRepositoryFromUsageAnalytics is type MeterEvent    outlet MeterRepositoryResponses is type Meter.MeterQueryResult
    query FindMeterById is  {
      meterId: MeterId with {
        briefly "Meter"
        described as {
          |Meter identifier.
        }
      }
    } with {
      briefly "Find meter by ID"
      described as {
        |Retrieves meter by identifier.
      }
    }
    result MeterResult is  {
      meter: Meter.ActiveStateData with {
        briefly "Meter"
        described as {
          |Meter data.
        }
      }
    } with {
      briefly "Meter result"
      described as {
        |Returns meter data.
      }
    }
    query FindByCustomer is  {
      customerId: CustomerId with {
        briefly "Customer"
        described as {
          |Customer identifier.
        }
      }
    } with {
      briefly "Find by customer"
      described as {
        |Finds meters for customer.
      }
    }
    result MetersResult is  {
      meters: Meter.ActiveStateData+ with {
        briefly "Meters"
        described as {
          |Matching meters.
        }
      }
      totalCount: Natural with {
        briefly "Count"
        described as {
          |Total matches.
        }
      }
    } with {
      briefly "Meters result"
      described as {
        |Returns matching meters.
      }
    }
    query FindBySubscription is  {
      subscriptionId: SubscriptionId with {
        briefly "Subscription"
        described as {
          |Subscription identifier.
        }
      }
    } with {
      briefly "Find by subscription"
      described as {
        |Finds meters for subscription.
      }
    }
    query GetCurrentUsage is  {
      meterId: MeterId with {
        briefly "Meter"
        described as {
          |Meter identifier.
        }
      }
    } with {
      briefly "Get current usage"
      described as {
        |Gets current period usage.
      }
    }
    query GetUsageHistory is  {
      meterId: MeterId with {
        briefly "Meter"
        described as {
          |Meter identifier.
        }
      }
      periods: Natural with {
        briefly "Periods"
        described as {
          |Number of periods.
        }
      }
    } with {
      briefly "Get usage history"
      described as {
        |Gets historical usage.
      }
    }
    handler MeterRepositoryHandler is {
      on query GetAnalyticsData is {
        let analyticsDataView: type AnalyticsDataView = prompt("read the analytics data projection")
        reply analyticsDataView
      }
      on query FindMeterById is {
        let meterResult: type MeterResult = prompt("read the meter from the store")
        tell meterResult to entity MeterContext.Meter
      }
      on query FindByCustomer is {
        let metersResult: type MetersResult = prompt("read the meters that by customer asks for")
        tell metersResult to entity MeterContext.Meter
      }
      on query FindBySubscription is {
        let metersResult: type MetersResult = prompt("read the meters that by subscription asks for")
        tell metersResult to entity MeterContext.Meter
      }
      on query GetCurrentUsage is {
        let meterResult: type MeterResult = prompt("read the meter that current usage asks for")
        tell meterResult to entity MeterContext.Meter
      }
      on query GetUsageHistory is {
        let metersResult: type MetersResult = prompt("read the meters that usage history asks for")
        tell metersResult to entity MeterContext.Meter
      }
    } with {
      briefly "Handles repository queries"
      described as {
        |Processes meter queries.
      }
    }
  } with {
    briefly "Meter repository"
    described as {
      |Persistence for meter records.
    }
  }
  // Projector for usage analytics
  query GetAnalyticsData is  {
    analyticsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which analytics data to retrieve.
      }
    }
  } with {
    briefly "Get analytics data"
    described as {
      |Retrieves the analytics data projection.
    }
  }
  result AnalyticsDataView is  {
    analyticsData: UsageAnalytics.AnalyticsData with {
      briefly "Analytics data"
      described as {
        |The analytics data being returned.
      }
    }
  } with {
    briefly "Analytics data view"
    described as {
      |Read model view carrying the analytics data projection.
    }
  }
  projector UsageAnalytics as flow is {
    updates repository MeterContext.MeterRepository
    inlet UsageAnalyticsFromMeter is type MeterEvent    outlet UsageAnalyticsOut is type MeterEvent
    record AnalyticsData is  {
      totalEvents: Natural with {
        briefly "Events"
        described as {
          |Total events recorded.
        }
      }
      totalCustomers: Natural with {
        briefly "Customers"
        described as {
          |Total metered customers.
        }
      }
      usageByMetric: MetricUsage+ with {
        briefly "By metric"
        described as {
          |Usage by metric type.
        }
      }
      topCustomers: CustomerUsage+ with {
        briefly "Top customers"
        described as {
          |Highest usage customers.
        }
      }
      alertsTriggered: Natural with {
        briefly "Alerts"
        described as {
          |Alerts triggered today.
        }
      }
    } with {
      briefly "Analytics data"
      described as {
        |Usage analytics.
      }
    }
    record MetricUsage is  {
      metricType: MetricType with {
        briefly "Metric"
        described as {
          |Metric type.
        }
      }
      aggregatedTotalQuantity: Decimal(18,4) with {
        briefly "Total"
        described as {
          |Total usage.
        }
      }
      eventCount: Natural with {
        briefly "Events"
        described as {
          |Event count.
        }
      }
    } with {
      briefly "Metric usage"
      described as {
        |Usage for metric type.
      }
    }
    record CustomerUsage is  {
      customerId: CustomerId with {
        briefly "Customer"
        described as {
          |Customer ID.
        }
      }
      totalUsage: Decimal(14,4) with {
        briefly "Usage"
        described as {
          |Total usage.
        }
      }
      totalAmount: Decimal(12,2) with {
        briefly "Amount"
        described as {
          |Billable amount.
        }
      }
    } with {
      briefly "Customer usage"
      described as {
        |Usage for customer.
      }
    }
    handler AnalyticsHandler is {
      on usageEventRecorded: event Meter.UsageEventRecorded is {
        tell usageEventRecorded to repository MeterContext.MeterRepository
      }
      on usageAggregated: event Meter.UsageAggregated is {
        tell usageAggregated to repository MeterContext.MeterRepository
      }
      on usageAlertTriggered: event Meter.UsageAlertTriggered is {
        tell usageAlertTriggered to repository MeterContext.MeterRepository
      }
      on billingRecordGenerated: event Meter.BillingRecordGenerated is {
        tell billingRecordGenerated to repository MeterContext.MeterRepository
      }
    } with {
      briefly "Processes analytics events"
      described as {
        |Updates usage analytics.
      }
    }
  } with {
    briefly "Usage analytics"
    described as {
      |Projects usage metrics for reporting.
    }
  }
  // Event streaming infrastructure
  type MeterEvent is one of {
    MeterContext.Meter.MeterCreated or MeterContext.Meter.UsageEventRecorded or MeterContext.Meter.UsageAggregated or MeterContext.Meter.BillingRecordGenerated or MeterContext.Meter.MeterClosed
  } with {
    briefly "Meter events"
    described as {
      |Union of all Meter events for streaming.
    }
  }
  processor MeterSource as source is {
    outlet MeterEventOutlet is type MeterEvent
 with {
      briefly "Event outlet"
      described as {
        |Outlet for Meter events.
      }
    }
    handler MeterSourceHandler is {
      on init is {
        let initializeMeter: type Meter.InitializeMeter = prompt("the initialize meter that brings this this into existence")
        tell initializeMeter to entity MeterContext.Meter
      }
      on meterCreated: event Meter.MeterCreated is {
        send meterCreated to outlet MeterEventOutlet
      }
      on usageEventRecorded: event Meter.UsageEventRecorded is {
        send usageEventRecorded to outlet MeterEventOutlet
      }
      on usageAggregated: event Meter.UsageAggregated is {
        send usageAggregated to outlet MeterEventOutlet
      }
      on billingRecordGenerated: event Meter.BillingRecordGenerated is {
        send billingRecordGenerated to outlet MeterEventOutlet
      }
      on meterClosed: event Meter.MeterClosed is {
        send meterClosed to outlet MeterEventOutlet
      }
      on other is {
        error "Unexpected message for source MeterSource"
      }
    } with {
      briefly "Source handler"
      described as {
        |Handles Meter events for streaming.
      }
    }
  } with {
    briefly "Meter event source"
    described as {
      |Publishes Meter events to the event stream.
    }
  }
  processor MeterSink as sink is {
    inlet MeterEventInlet is type MeterEvent with {
      briefly "Event inlet"
      described as {
        |Inlet for Meter events.
      }
    }
    handler MeterSinkHandler is {
      on init is { ??? }
      on meterCreated: event Meter.MeterCreated is {
        tell meterCreated to repository MeterContext.MeterRepository
      }
      on usageEventRecorded: event Meter.UsageEventRecorded is {
        tell usageEventRecorded to repository MeterContext.MeterRepository
      }
      on usageAggregated: event Meter.UsageAggregated is {
        tell usageAggregated to repository MeterContext.MeterRepository
      }
      on billingRecordGenerated: event Meter.BillingRecordGenerated is {
        tell billingRecordGenerated to repository MeterContext.MeterRepository
      }
      on meterClosed: event Meter.MeterClosed is {
        tell meterClosed to repository MeterContext.MeterRepository
      }
      on other is {
        error "Unexpected message for sink MeterSink"
      }
    } with {
      briefly "Sink handler"
      described as {
        |Handles incoming Meter events for persistence.
      }
    }
  } with {
    briefly "Meter event sink"
    described as {
      |Receives Meter events for persistence.
    }
  }
  connector MeterEventFlow is from outlet MeterContext.MeterSource.MeterEventOutlet to inlet MeterContext.MeterSink.MeterEventInlet with {
    briefly "Meter event connector"
    described as {
      |Wires Meter source to sink for event flow.
    }
  }
  processor MeterEventSplit as split is {
    inlet MeterEventSplitIn is type MeterEvent    outlet MeterEventSplitToMeterRepository is type MeterEvent
    outlet MeterEventSplitToUsageAnalytics is type MeterEvent
    handler MeterEventSplitHandler is {
      on meterCreated: event Meter.MeterCreated is {
        send meterCreated to outlet MeterEventSplitToMeterRepository
        send meterCreated to outlet MeterEventSplitToUsageAnalytics
        tell meterCreated to entity MeterContext.Meter
      }
      on usageEventRecorded: event Meter.UsageEventRecorded is {
        send usageEventRecorded to outlet MeterEventSplitToMeterRepository
        send usageEventRecorded to outlet MeterEventSplitToUsageAnalytics
        tell usageEventRecorded to entity MeterContext.Meter
      }
      on batchEventsRecorded: event Meter.BatchEventsRecorded is {
        send batchEventsRecorded to outlet MeterEventSplitToMeterRepository
        send batchEventsRecorded to outlet MeterEventSplitToUsageAnalytics
        tell batchEventsRecorded to entity MeterContext.Meter
      }
      on usageAggregated: event Meter.UsageAggregated is {
        send usageAggregated to outlet MeterEventSplitToMeterRepository
        send usageAggregated to outlet MeterEventSplitToUsageAnalytics
        tell usageAggregated to entity MeterContext.Meter
      }
      on alertThresholdSet: event Meter.AlertThresholdSet is {
        send alertThresholdSet to outlet MeterEventSplitToMeterRepository
        send alertThresholdSet to outlet MeterEventSplitToUsageAnalytics
        tell alertThresholdSet to entity MeterContext.Meter
      }
      on alertThresholdRemoved: event Meter.AlertThresholdRemoved is {
        send alertThresholdRemoved to outlet MeterEventSplitToMeterRepository
        send alertThresholdRemoved to outlet MeterEventSplitToUsageAnalytics
        tell alertThresholdRemoved to entity MeterContext.Meter
      }
      on usageAlertTriggered: event Meter.UsageAlertTriggered is {
        send usageAlertTriggered to outlet MeterEventSplitToMeterRepository
        send usageAlertTriggered to outlet MeterEventSplitToUsageAnalytics
        tell usageAlertTriggered to entity MeterContext.Meter
      }
      on billingRecordGenerated: event Meter.BillingRecordGenerated is {
        send billingRecordGenerated to outlet MeterEventSplitToMeterRepository
        send billingRecordGenerated to outlet MeterEventSplitToUsageAnalytics
        tell billingRecordGenerated to entity MeterContext.Meter
      }
      on usageAdjusted: event Meter.UsageAdjusted is {
        send usageAdjusted to outlet MeterEventSplitToMeterRepository
        send usageAdjusted to outlet MeterEventSplitToUsageAnalytics
        tell usageAdjusted to entity MeterContext.Meter
      }
      on meterPaused: event Meter.MeterPaused is {
        send meterPaused to outlet MeterEventSplitToMeterRepository
        send meterPaused to outlet MeterEventSplitToUsageAnalytics
        tell meterPaused to entity MeterContext.Meter
      }
      on meterResumed: event Meter.MeterResumed is {
        send meterResumed to outlet MeterEventSplitToMeterRepository
        send meterResumed to outlet MeterEventSplitToUsageAnalytics
        tell meterResumed to entity MeterContext.Meter
      }
      on meterClosed: event Meter.MeterClosed is {
        send meterClosed to outlet MeterEventSplitToMeterRepository
        send meterClosed to outlet MeterEventSplitToUsageAnalytics
        tell meterClosed to entity MeterContext.Meter
      }
      on other is {
        error "Unexpected message for processor MeterEventSplit"
      }
    } with {
      briefly "Meter event fan-out handler"
      described as {
        |Delivers each Meter event to all of its consumers.
      }
    }
  } with {
    briefly "Meter event fan-out"
    described as {
      |Fans Meter events out to the repository and projectors.
    }
  }
  connector 'MeterEvent Stream' is from outlet MeterContext.Meter.MeterEvents to inlet MeterContext.MeterEventSplit.MeterEventSplitIn with {
    briefly "Meter events, fanned out to storage and read models"
  }
  connector 'MeterEvent Storage' is from outlet MeterContext.MeterEventSplit.MeterEventSplitToMeterRepository to inlet MeterContext.MeterRepository.MeterRepositoryFromMeter with {
    briefly "Meter events on their way to storage"
  }
  connector 'UsageAnalytics Feed' is from outlet MeterContext.MeterEventSplit.MeterEventSplitToUsageAnalytics to inlet MeterContext.UsageAnalytics.UsageAnalyticsFromMeter with {
    briefly "Meter events feeding the UsageAnalytics projection"
  }
  connector 'UsageAnalytics Storage' is from outlet MeterContext.UsageAnalytics.UsageAnalyticsOut to inlet MeterContext.MeterRepository.MeterRepositoryFromUsageAnalytics with {
    briefly "The UsageAnalytics projection on its way to storage"
  }
} with {
  briefly "Meter context"
  described as {
    | The Meter context manages usage metering
    | for SaaS applications.
  }
}
