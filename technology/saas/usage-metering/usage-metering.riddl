// Usage Metering Domain Model
// SaaS usage tracking and billing metering
domain UsageMetering is {
  persistent connector 'SubscriptionServiceReply Stream' is from outlet SubscriptionService.SubscriptionServiceRepliesOut to inlet MeterContext.ToSubscriptionService.ToSubscriptionServiceReplies with {
    briefly "What SubscriptionService answers MeterContext"
  }
  persistent connector 'EventIngestionServiceReply Stream' is from outlet EventIngestionService.EventIngestionServiceRepliesOut to inlet MeterContext.ToEventIngestionService.ToEventIngestionServiceReplies with {
    briefly "What EventIngestionService answers MeterContext"
  }
  persistent connector 'BillingServiceReply Stream' is from outlet BillingService.BillingServiceRepliesOut to inlet MeterContext.ToBillingService.ToBillingServiceReplies with {
    briefly "What BillingService answers MeterContext"
  }
  persistent connector 'AnalyticsExportServiceEvent Stream' is from outlet AnalyticsExportService.AnalyticsExportServiceEventsOut to inlet MeterContext.FromAnalyticsExportService.FromAnalyticsExportServiceIn with {
    briefly "What AnalyticsExportService tells MeterContext, unasked"
  }
  persistent connector 'BillingServiceEvent Stream' is from outlet BillingService.BillingServiceEventsOut to inlet MeterContext.FromBillingService.FromBillingServiceIn with {
    briefly "What BillingService tells MeterContext, unasked"
  }
  persistent connector 'EventIngestionServiceEvent Stream' is from outlet EventIngestionService.EventIngestionServiceEventsOut to inlet MeterContext.FromEventIngestionService.FromEventIngestionServiceIn with {
    briefly "What EventIngestionService tells MeterContext, unasked"
  }
  persistent connector 'SubscriptionServiceEvent Stream' is from outlet SubscriptionService.SubscriptionServiceEventsOut to inlet MeterContext.FromSubscriptionService.FromSubscriptionServiceIn with {
    briefly "What SubscriptionService tells MeterContext, unasked"
  }
  persistent connector 'SubscriptionServiceRequest Stream' is from outlet MeterContext.ToSubscriptionService.ToSubscriptionServiceOut to inlet SubscriptionService.SubscriptionServiceRequests with {
    briefly "What MeterContext asks SubscriptionService to send"
  }
  persistent connector 'EventIngestionServiceRequest Stream' is from outlet MeterContext.ToEventIngestionService.ToEventIngestionServiceOut to inlet EventIngestionService.EventIngestionServiceRequests with {
    briefly "What MeterContext asks EventIngestionService to send"
  }
  persistent connector 'AnalyticsExportServiceRequest Stream' is from outlet MeterContext.ToAnalyticsExportService.ToAnalyticsExportServiceOut to inlet AnalyticsExportService.AnalyticsExportServiceRequests with {
    briefly "What MeterContext asks AnalyticsExportService to send"
  }
  persistent connector 'BillingServiceRequest Stream' is from outlet MeterContext.ToBillingService.ToBillingServiceOut to inlet BillingService.BillingServiceRequests with {
    briefly "What MeterContext asks BillingService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet MeterContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What MeterContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Customer is "business using the SaaS product" with {
    briefly "Customer"
    described as {
      |Subscribing customer.
    }
  }
  user BillingAdmin is "person managing billing operations" with {
    briefly "Billing Admin"
    described as {
      |Staff handling billing.
    }
  }
  epic UsageMeteringEpic is {
    user Customer wants to "accurate usage tracking" so that "they pay only for what they use"
    case TrackUsage is {
      user Customer wants to "their usage to be metered" so that "billing is accurate"
      step is "System records" "usage events" "in real time" with {
        briefly "Record"
        described as {
          |Capture usage.
        }
      }
      step take input UsageMeteringApp.UsageMeteringScreen.RecordUsageEventInput from user BillingAdmin with {
        briefly "Meter"
        described as {
          |Meter usage.
        }
      }
      step is "System aggregates" "and bills" "customer" with {
        briefly "Bill"
        described as {
          |Generate invoice.
        }
      }
    } with {
      briefly "Track usage"
      described as {
        |Usage metering workflow.
      }
    }
  } with {
    briefly "Usage metering"
    described as {
      | Epic covering usage events, aggregation,
      | and billing integration.
    }
  }
  include "MeterContext.riddl"
  include "external-contexts.riddl"
  application context UsageMeteringApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in UsageMetering are delivered.
      }
    }
    group UsageMeteringScreen is {
      input RecordUsageEventInput acquires command MeterContext.Meter.RecordUsageEvent with {
        briefly "Record usage event control"
        described as {
          |The control through which a user submits the record usage event request.
        }
      }
    } with {
      briefly "Usage metering screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppMeterCommands is type MeterContext.Meter.MeterCommand
    inlet AppMeterRepositoryResponses is result MeterContext.Meter.MeterQueryResult    handler UsageMeteringAppHandler is {
      on other is {
        error "Unexpected message for application context UsageMeteringApp"
      }
    } with {
      briefly "UsageMeteringApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "UsageMeteringApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'MeterCommand Stream' is from outlet UsageMeteringApp.AppMeterCommands to inlet MeterContext.MeterCommandStreamIn with {
    briefly "Meter commands from the application"
  }
  persistent connector 'MeterQueryResult Stream' is from outlet MeterContext.MeterQueryResultStreamOut to inlet UsageMeteringApp.AppMeterRepositoryResponses with {
    briefly "Meter query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet UsageMeteringApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Usage metering domain"
  described as {
    | The Usage Metering domain handles SaaS
    | usage tracking and billing metering.
  }
}
