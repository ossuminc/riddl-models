// Usage Metering Domain Model
// SaaS usage tracking and billing metering
domain UsageMetering is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Customer is "business using the SaaS product" with {
    briefly "Customer"
    described as {
      |Subscribing customer.
    }
  }
  user BillingAdmin is "person managing billing operations" with {
    briefly "Billing Admin"
    described as {
      |Staff handling billing.
    }
  }
  epic UsageMeteringEpic is {
    user Customer wants to "accurate usage tracking" so that "they pay only for what they use"
    case TrackUsage is {
      user Customer wants to "their usage to be metered" so that "billing is accurate"
      step is "System records" "usage events" "in real time" with {
        briefly "Record"
        described as {
          |Capture usage.
        }
      }
      step take input UsageMeteringApp.UsageMeteringScreen.RecordUsageEventInput from user BillingAdmin with {
        briefly "Meter"
        described as {
          |Meter usage.
        }
      }
      step is "System aggregates" "and bills" "customer" with {
        briefly "Bill"
        described as {
          |Generate invoice.
        }
      }
    } with {
      briefly "Track usage"
      described as {
        |Usage metering workflow.
      }
    }
  } with {
    briefly "Usage metering"
    described as {
      | Epic covering usage events, aggregation,
      | and billing integration.
    }
  }
  include "MeterContext.riddl"
  include "external-contexts.riddl"
  application context UsageMeteringApp is {
    group UsageMeteringScreen is {
      input RecordUsageEventInput acquires command MeterContext.Meter.RecordUsageEvent with {
        briefly "Record usage event control"
        described as {
          |The control through which a user submits the record usage event request.
        }
      }
    } with {
      briefly "Usage metering screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppMeterCommands is type MeterContext.Meter.MeterCommand
    inlet AppMeterRepositoryResponses is type MeterContext.Meter.MeterQueryResult    handler UsageMeteringAppHandler is {
      on other is {
        error "Unexpected message for application context UsageMeteringApp"
      }
    } with {
      briefly "UsageMeteringApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "UsageMeteringApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppMeterCommands is from outlet UsageMeteringApp.AppMeterCommands to inlet MeterContext.Meter.MeterCommands with {
    option persistent()
    briefly "LinkAppMeterCommands"
  }
  connector LinkAppMeterRepositoryResponses is from outlet MeterContext.MeterRepository.MeterRepositoryResponses to inlet UsageMeteringApp.AppMeterRepositoryResponses with {
    option persistent()
    briefly "LinkAppMeterRepositoryResponses"
  }
} with {
  briefly "Usage metering domain"
  described as {
    | The Usage Metering domain handles SaaS
    | usage tracking and billing metering.
  }
}
