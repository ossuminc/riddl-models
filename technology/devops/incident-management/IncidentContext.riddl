// Incident Management Bounded Context
context IncidentContext as router is {
  inlet IncidentCommandStreamIn is type IncidentCommand  outlet IncidentCommandStreamOut is type IncidentCommand
  inlet TranslationFromContextAlertiIn is type AlertingService.AlertEvent  outlet TranslationFromContextAlertiOut is type AlertingService.AlertEvent
  inlet IncidentQueryResultStreamIn is type Incident.IncidentResult  outlet IncidentQueryResultStreamOut is type Incident.IncidentResult
  handler IncidentContextBoundary is {
    on createIncident: command Incident.CreateIncident is {
      send createIncident to outlet IncidentContext.IncidentCommandStreamOut
    }
    on acknowledgeIncident: command Incident.AcknowledgeIncident is {
      send acknowledgeIncident to outlet IncidentContext.IncidentCommandStreamOut
    }
    on escalateIncident: command Incident.EscalateIncident is {
      send escalateIncident to outlet IncidentContext.IncidentCommandStreamOut
    }
    on updateStatus: command Incident.UpdateStatus is {
      send updateStatus to outlet IncidentContext.IncidentCommandStreamOut
    }
    on assignIncidentCommander: command Incident.AssignIncidentCommander is {
      send assignIncidentCommander to outlet IncidentContext.IncidentCommandStreamOut
    }
    on addTimelineEntry: command Incident.AddTimelineEntry is {
      send addTimelineEntry to outlet IncidentContext.IncidentCommandStreamOut
    }
    on resolveIncident: command Incident.ResolveIncident is {
      send resolveIncident to outlet IncidentContext.IncidentCommandStreamOut
    }
    on createPostMortem: command Incident.CreatePostMortem is {
      send createPostMortem to outlet IncidentContext.IncidentCommandStreamOut
    }
    on closeIncident: command Incident.CloseIncident is {
      send closeIncident to outlet IncidentContext.IncidentCommandStreamOut
    }
    on alertTriggered: event AlertTriggered is {
      send alertTriggered to outlet IncidentContext.TranslationFromContextAlertiOut
    }
    on alertResolved: event AlertResolved is {
      send alertResolved to outlet IncidentContext.TranslationFromContextAlertiOut
    }
    on incidentResult: result Incident.IncidentResult is {
      send incidentResult to outlet IncidentContext.IncidentQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the IncidentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'IncidentCommand Stream Intake' is from outlet IncidentContext.IncidentCommandStreamOut to inlet IncidentContext.Incident.IncidentCommands  connector 'Translation From Context AlertingService Intake' is from outlet IncidentContext.TranslationFromContextAlertiOut to inlet IncidentContext.AlertAdapter.IncomingAlertEvents  connector 'IncidentQueryResult Stream Egress' is from outlet IncidentContext.IncidentRepository.IncidentRepositoryResponses to inlet IncidentContext.IncidentQueryResultStreamIn  adaptor FromPagerDutyIntegration from context PagerDutyIntegration is { 
    handler FromPagerDutyIntegrationHandler is {
      on result PagerDutyIntegration.OnCallResult is {
        do "the model receives on call result"
      }
      on other is {
        error "Unexpected message for adaptor FromPagerDutyIntegration"
      }
    } with {
      briefly "from pager duty integration"
      described as {
        |Carries messages from the external PagerDutyIntegration.
      }
    }
    handler InboundPages is {
      on pageAcknowledged: event PagerDutyIntegration.PageAcknowledged is {
        tell command AcknowledgeIncident(incidentId = pageAcknowledged.incidentId, acknowledgedBy = pageAcknowledged.acknowledgedBy) to entity Incident
      }
      on other is {
        error "Unexpected message for adaptor PagerDutyAdapter"
      }
    } with {
      briefly "Handles PagerDuty events"
      described as {
        |Processes page acknowledgments from PagerDuty.
      }
    }
  } with {
    briefly "PagerDutyIntegration integration"
    described as {
      |The model's side of the PagerDutyIntegration conversation.
    }
  }
  include "types.riddl"
  include "Incident.riddl"
  // Repository for incident persistence and queries
  repository IncidentRepository as merge is {
    inlet IncidentRepositoryFromIncident is type IncidentEvent    inlet IncidentRepositoryFromIncidentMetricsProjector is type IncidentEvent    inlet IncidentRepositoryFromIncidentTrendsProjector is type IncidentEvent    outlet IncidentRepositoryResponses is type Incident.IncidentResult
    record StoredIncident is  {
      incidentId: IncidentId with {
        briefly "incidentId"
        described as {
          |The incidentId column of the stored incident row.
        }
      }
      info: IncidentInfo with {
        briefly "info"
        described as {
          |The info column of the stored incident row.
        }
      }
    } with {
      briefly "Stored incident row"
      described as {
        |The persistence shape of incident data as this repository stores it.
      }
    }
    schema IncidentData is relational
      of incidents as type StoredIncident
        index on field StoredIncident.info.status
        index on field StoredIncident.info.severity
        index on field StoredIncident.info.createdAt
 with {
      briefly "Incident data schema"
      described as {
        |The relational schema holding incident data for the IncidentRepository.
      }
    }
    command PersistIncidentCreated is  {
      incidentId: IncidentId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist IncidentCreated"
      described as {
        |Instructs this repository to apply IncidentCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentAcknowledged is  {
      incidentId: IncidentId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist IncidentAcknowledged"
      described as {
        |Instructs this repository to apply IncidentAcknowledged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentCommanderAssigned is  {
      incidentId: IncidentId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist IncidentCommanderAssigned"
      described as {
        |Instructs this repository to apply IncidentCommanderAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTimelineEntryAdded is  {
      incidentId: IncidentId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist TimelineEntryAdded"
      described as {
        |Instructs this repository to apply TimelineEntryAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPostMortemCreated is  {
      incidentId: IncidentId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist PostMortemCreated"
      described as {
        |Instructs this repository to apply PostMortemCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentClosed is  {
      incidentId: IncidentId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist IncidentClosed"
      described as {
        |Instructs this repository to apply IncidentClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentEscalated is  {
      incidentId: IncidentId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist IncidentEscalated"
      described as {
        |Instructs this repository to apply IncidentEscalated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentStatusUpdated is  {
      incidentId: IncidentId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist IncidentStatusUpdated"
      described as {
        |Instructs this repository to apply IncidentStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentResolved is  {
      incidentId: IncidentId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist IncidentResolved"
      described as {
        |Instructs this repository to apply IncidentResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler IncidentPersistence is {
      on query GetMetricsState is {
        let metricsStateView: type MetricsStateView = prompt("read the metrics state projection")
        reply metricsStateView
      }
      on query GetTrendsState is {
        let trendsStateView: type TrendsStateView = prompt("read the trends state projection")
        reply trendsStateView
      }
      on command PersistIncidentCreated is {
        do "Persist new incident to database"
      }
      on command PersistIncidentAcknowledged is {
        do "Update incident with acknowledgment data"
      }
      on command PersistIncidentEscalated is {
        do "Update incident severity and affected services"
      }
      on command PersistIncidentStatusUpdated is {
        do "Update incident status"
      }
      on command PersistIncidentCommanderAssigned is {
        do "Update incident commander assignment"
      }
      on command PersistTimelineEntryAdded is {
        do "Append timeline entry to incident"
      }
      on command PersistIncidentResolved is {
        do "Update incident with resolution data"
      }
      on command PersistPostMortemCreated is {
        do "Store post-mortem linked to incident"
      }
      on command PersistIncidentClosed is {
        do "Update incident to closed status"
      }
    } with {
      briefly "Persists incident events to storage"
      described as {
        |Handles all event-driven persistence operations for incidents.
      }
    }
  } with {
    briefly "Persistent storage for incidents"
    described as {
      | Repository providing CRUD operations and queries for
      | incident records, timelines, and post-mortem documents.
    }
  }
  // Projector for MTTR and incident frequency metrics
  query GetMetricsState is  {
    metricsStateKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which metrics state to retrieve.
      }
    }
  } with {
    briefly "Get metrics state"
    described as {
      |Retrieves the metrics state projection.
    }
  }
  result MetricsStateView is  {
    metricsState: IncidentMetricsProjector.MetricsState with {
      briefly "Metrics state"
      described as {
        |The metrics state being returned.
      }
    }
  } with {
    briefly "Metrics state view"
    described as {
      |Read model view carrying the metrics state projection.
    }
  }
  projector IncidentMetricsProjector as flow is {
    updates repository IncidentContext.IncidentRepository
    inlet IncidentMetricsProjectorFromIncident is type IncidentEvent    outlet IncidentMetricsProjectorOut is type IncidentEvent
    record MetricsState is  {
      totalIncidents: Natural with {
        briefly "Total incidents"
        described as {
          |Count of all incidents tracked.
        }
      }
      incidentsBySeveritySev1: Natural with {
        briefly "Sev1 incidents"
        described as {
          |Count of Sev1 incidents.
        }
      }
      incidentsBySeveritySev2: Natural with {
        briefly "Sev2 incidents"
        described as {
          |Count of Sev2 incidents.
        }
      }
      incidentsBySeveritySev3: Natural with {
        briefly "Sev3 incidents"
        described as {
          |Count of Sev3 incidents.
        }
      }
      incidentsBySeveritySev4: Natural with {
        briefly "Sev4 incidents"
        described as {
          |Count of Sev4 incidents.
        }
      }
      incidentsBySeveritySev5: Natural with {
        briefly "Sev5 incidents"
        described as {
          |Count of Sev5 incidents.
        }
      }
      avgTimeToAcknowledge: Duration with {
        briefly "Average TTA"
        described as {
          |Mean time to acknowledge incidents.
        }
      }
      avgTimeToMitigate: Duration with {
        briefly "Average TTM"
        described as {
          |Mean time to mitigate incidents.
        }
      }
      avgTimeToResolve: Duration with {
        briefly "Average TTR"
        described as {
          |Mean time to resolve incidents.
        }
      }
    } with {
      briefly "Aggregated metrics state"
      described as {
        | Running aggregations of incident metrics for dashboard
        | display and reporting.
      }
    }
    handler MetricsProjectionHandler is {
      on incidentCreated: event Incident.IncidentCreated is {
        tell command IncidentContext.IncidentRepository.PersistIncidentCreated(incidentId = prompt("the incident this IncidentCreated applies to")) to repository IncidentContext.IncidentRepository
        do "Increment incident count for severity level"
      }
      on incidentAcknowledged: event Incident.IncidentAcknowledged is {
        tell command IncidentContext.IncidentRepository.PersistIncidentAcknowledged(incidentId = incidentAcknowledged.incidentId) to repository IncidentContext.IncidentRepository
        do "Calculate and update time-to-acknowledge metrics"
      }
      on incidentResolved: event Incident.IncidentResolved is {
        tell command IncidentContext.IncidentRepository.PersistIncidentResolved(incidentId = incidentResolved.incidentId) to repository IncidentContext.IncidentRepository
        do "Calculate and update time-to-resolve metrics"
      }
      on incidentClosed: event Incident.IncidentClosed is {
        tell command IncidentContext.IncidentRepository.PersistIncidentClosed(incidentId = incidentClosed.incidentId) to repository IncidentContext.IncidentRepository
        do "Finalize metrics for closed incident"
      }
    } with {
      briefly "Updates metrics on incident events"
      described as {
        | Processes incident lifecycle events to maintain
        | up-to-date metrics for MTTR, MTTA, and incident frequency.
      }
    }
  } with {
    briefly "Projects incident metrics for reporting"
    described as {
      | Maintains real-time aggregations of key incident metrics:
      | - MTTA: Mean Time To Acknowledge
      | - MTTM: Mean Time To Mitigate
      | - MTTR: Mean Time To Resolve
      | - Incident frequency by severity
      | - Incident frequency by service
      |
      | These metrics are essential for SRE reporting, capacity planning,
      | and continuous improvement of incident response processes.
    }
  }
  // Projector for incident trends and patterns
  query GetTrendsState is  {
    trendsStateKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which trends state to retrieve.
      }
    }
  } with {
    briefly "Get trends state"
    described as {
      |Retrieves the trends state projection.
    }
  }
  result TrendsStateView is  {
    trendsState: IncidentTrendsProjector.TrendsState with {
      briefly "Trends state"
      described as {
        |The trends state being returned.
      }
    }
  } with {
    briefly "Trends state view"
    described as {
      |Read model view carrying the trends state projection.
    }
  }
  projector IncidentTrendsProjector as flow is {
    updates repository IncidentContext.IncidentRepository
    inlet IncidentTrendsProjectorFromIncident is type IncidentEvent    outlet IncidentTrendsProjectorOut is type IncidentEvent
    record TrendsState is  {
      weeklyIncidentCount: Natural with {
        briefly "Weekly count"
        described as {
          |Incidents in the current week.
        }
      }
      monthlyIncidentCount: Natural with {
        briefly "Monthly count"
        described as {
          |Incidents in the current month.
        }
      }
      topAffectedServices: ServiceId+ with {
        briefly "Top affected services"
        described as {
          |Services with most incidents.
        }
      }
      commonRootCauses: String+ with {
        briefly "Common root causes"
        described as {
          |Frequently occurring root causes.
        }
      }
      sev1Count: Natural with {
        briefly "Sev1 count"
        described as {
          |Sev1 incidents in period.
        }
      }
      sev2Count: Natural with {
        briefly "Sev2 count"
        described as {
          |Sev2 incidents in period.
        }
      }
      sev3Count: Natural with {
        briefly "Sev3 count"
        described as {
          |Sev3 incidents in period.
        }
      }
    } with {
      briefly "Incident trend analysis state"
      described as {
        | Aggregated data for trend analysis including weekly
        | and monthly patterns, most affected services, and common causes.
      }
    }
    handler TrendsProjectionHandler is {
      on incidentCreated: event Incident.IncidentCreated is {
        tell command IncidentContext.IncidentRepository.PersistIncidentCreated(incidentId = prompt("the incident this IncidentCreated applies to")) to repository IncidentContext.IncidentRepository
        do "Update weekly and monthly incident counts"
      }
      on incidentResolved: event Incident.IncidentResolved is {
        tell command IncidentContext.IncidentRepository.PersistIncidentResolved(incidentId = incidentResolved.incidentId) to repository IncidentContext.IncidentRepository
        do "Update resolution trends"
      }
      on postMortemCreated: event Incident.PostMortemCreated is {
        tell command IncidentContext.IncidentRepository.PersistPostMortemCreated(incidentId = postMortemCreated.incidentId) to repository IncidentContext.IncidentRepository
        do "Extract and aggregate root cause patterns"
      }
    } with {
      briefly "Updates trends on incident events"
      described as {
        | Processes incident events to maintain trend data for
        | pattern recognition and proactive improvement.
      }
    }
  } with {
    briefly "Projects incident trends for analysis"
    described as {
      | Analyzes incident patterns over time to identify:
      | - Recurring issues
      | - Problematic services
      | - Common root causes
      | - Seasonal or periodic patterns
      |
      | This data supports proactive reliability improvements and
      | resource allocation decisions.
    }
  }
  // Adaptor for alerting service integration
  adaptor AlertAdapter from context AlertingService as sink is { 
    inlet IncomingAlertEvents is type AlertingService.AlertEvent    handler InboundAlerts is {
      on event AlertingService.AlertTriggered is {
        let createIncident: type CreateIncident = prompt("the create incident that results from alert triggered")
        tell createIncident to entity Incident
      }
      on event AlertingService.AlertResolved is {
        do "Check if incident should be auto-resolved"
      }
      on other is {
        error "Unexpected message for adaptor AlertAdapter"
      }
    } with {
      briefly "Handles alert events from monitoring"
      described as {
        |Processes inbound alerts and creates incidents.
      }
    }
  } with {
    briefly "Translates alerting service events"
    described as {
      | Receives alert events from external monitoring systems
      | and creates incidents in the incident management system.
    }
  }
  // Adaptor for PagerDuty integration
  // Adaptor for Slack integration
  adaptor SlackAdapter from context SlackIntegration is { 
    handler InboundSlack is {
      on event SlackIntegration.ChannelCreated is {
        do "Update incident with communication channel"
      }
      on event SlackIntegration.MessagePosted is {
        do "Log message as timeline entry if relevant"
      }
      on other is {
        error "Unexpected message for adaptor SlackAdapter"
      }
    } with {
      briefly "Handles Slack events"
      described as {
        |Processes Slack channel and message events.
      }
    }
  } with {
    briefly "Translates Slack events"
    described as {
      | Receives events from Slack integration for channel
      | creation and message posting.
    }
  }
  // ---- Event publication for Incident ----
  type IncidentEvent is one of {
    IncidentContext.Incident.IncidentCreated or IncidentContext.Incident.IncidentAcknowledged or IncidentContext.Incident.IncidentEscalated or IncidentContext.Incident.IncidentStatusUpdated or IncidentContext.Incident.IncidentCommanderAssigned or IncidentContext.Incident.TimelineEntryAdded or IncidentContext.Incident.IncidentResolved or IncidentContext.Incident.PostMortemCreated or IncidentContext.Incident.IncidentClosed
  } with {
    briefly "Incident event alternation"
    described as {
      |Union of all Incident events, for streaming and event-sourced
      |persistence.
    }
  }
  processor IncidentEventSource as source is {
    outlet IncidentEvents is type IncidentEvent
    handler IncidentSourceHandler is {
      on incidentCreated: event Incident.IncidentCreated is {
        send incidentCreated to outlet IncidentEvents
      }
      on incidentAcknowledged: event Incident.IncidentAcknowledged is {
        send incidentAcknowledged to outlet IncidentEvents
      }
      on incidentEscalated: event Incident.IncidentEscalated is {
        send incidentEscalated to outlet IncidentEvents
      }
      on incidentStatusUpdated: event Incident.IncidentStatusUpdated is {
        send incidentStatusUpdated to outlet IncidentEvents
      }
      on incidentCommanderAssigned: event Incident.IncidentCommanderAssigned is {
        send incidentCommanderAssigned to outlet IncidentEvents
      }
      on timelineEntryAdded: event Incident.TimelineEntryAdded is {
        send timelineEntryAdded to outlet IncidentEvents
      }
      on incidentResolved: event Incident.IncidentResolved is {
        send incidentResolved to outlet IncidentEvents
      }
      on postMortemCreated: event Incident.PostMortemCreated is {
        send postMortemCreated to outlet IncidentEvents
      }
      on incidentClosed: event Incident.IncidentClosed is {
        send incidentClosed to outlet IncidentEvents
      }
      on other is {
        error "Unexpected message for source IncidentEventSource"
      }
    } with {
      briefly "Incident source handler"
      described as {
        |Publishes Incident events onto the outlet.
      }
    }
  } with {
    briefly "Incident event source"
    described as {
      |Publishes Incident entity events into the streaming topology.
    }
  }
  processor IncidentEventSink as sink is {
    inlet IncidentInlet is type IncidentEvent    handler IncidentSinkHandler is {
      on incidentCreated: event Incident.IncidentCreated is {
        tell incidentCreated to repository IncidentContext.IncidentRepository
      }
      on incidentAcknowledged: event Incident.IncidentAcknowledged is {
        tell incidentAcknowledged to repository IncidentContext.IncidentRepository
      }
      on incidentEscalated: event Incident.IncidentEscalated is {
        tell incidentEscalated to repository IncidentContext.IncidentRepository
      }
      on incidentStatusUpdated: event Incident.IncidentStatusUpdated is {
        tell incidentStatusUpdated to repository IncidentContext.IncidentRepository
      }
      on incidentCommanderAssigned: event Incident.IncidentCommanderAssigned is {
        tell incidentCommanderAssigned to repository IncidentContext.IncidentRepository
      }
      on timelineEntryAdded: event Incident.TimelineEntryAdded is {
        tell timelineEntryAdded to repository IncidentContext.IncidentRepository
      }
      on incidentResolved: event Incident.IncidentResolved is {
        tell incidentResolved to repository IncidentContext.IncidentRepository
      }
      on postMortemCreated: event Incident.PostMortemCreated is {
        tell postMortemCreated to repository IncidentContext.IncidentRepository
      }
      on incidentClosed: event Incident.IncidentClosed is {
        tell incidentClosed to repository IncidentContext.IncidentRepository
      }
      on other is {
        error "Unexpected message for sink IncidentEventSink"
      }
    } with {
      briefly "Incident sink handler"
      described as {
        |Persists Incident events via the repository.
      }
    }
  } with {
    briefly "Incident event sink"
    described as {
      |Receives Incident events for persistence.
    }
  }
  connector IncidentEventFlow is from outlet IncidentContext.IncidentEventSource.IncidentEvents to inlet IncidentContext.IncidentEventSink.IncidentInlet with {
    briefly "Incident event flow"
    described as {
      |Connects the Incident source to its sink.
    }
  }
  processor IncidentEventSplit as split is {
    inlet IncidentEventSplitIn is type IncidentEvent    outlet IncidentEventSplitToIncidentRepository is type IncidentEvent
    outlet IncidentEventSplitToIncidentMetricsProjector is type IncidentEvent
    outlet IncidentEventSplitToIncidentTrendsProjector is type IncidentEvent
    handler IncidentEventSplitHandler is {
      on incidentCreated: event Incident.IncidentCreated is {
        send incidentCreated to outlet IncidentEventSplitToIncidentRepository
        send incidentCreated to outlet IncidentEventSplitToIncidentMetricsProjector
        send incidentCreated to outlet IncidentEventSplitToIncidentTrendsProjector
        tell incidentCreated to entity IncidentContext.Incident
      }
      on incidentAcknowledged: event Incident.IncidentAcknowledged is {
        send incidentAcknowledged to outlet IncidentEventSplitToIncidentRepository
        send incidentAcknowledged to outlet IncidentEventSplitToIncidentMetricsProjector
        send incidentAcknowledged to outlet IncidentEventSplitToIncidentTrendsProjector
        tell incidentAcknowledged to entity IncidentContext.Incident
      }
      on incidentEscalated: event Incident.IncidentEscalated is {
        send incidentEscalated to outlet IncidentEventSplitToIncidentRepository
        send incidentEscalated to outlet IncidentEventSplitToIncidentMetricsProjector
        send incidentEscalated to outlet IncidentEventSplitToIncidentTrendsProjector
        tell incidentEscalated to entity IncidentContext.Incident
      }
      on incidentStatusUpdated: event Incident.IncidentStatusUpdated is {
        send incidentStatusUpdated to outlet IncidentEventSplitToIncidentRepository
        send incidentStatusUpdated to outlet IncidentEventSplitToIncidentMetricsProjector
        send incidentStatusUpdated to outlet IncidentEventSplitToIncidentTrendsProjector
        tell incidentStatusUpdated to entity IncidentContext.Incident
      }
      on incidentCommanderAssigned: event Incident.IncidentCommanderAssigned is {
        send incidentCommanderAssigned to outlet IncidentEventSplitToIncidentRepository
        send incidentCommanderAssigned to outlet IncidentEventSplitToIncidentMetricsProjector
        send incidentCommanderAssigned to outlet IncidentEventSplitToIncidentTrendsProjector
        tell incidentCommanderAssigned to entity IncidentContext.Incident
      }
      on timelineEntryAdded: event Incident.TimelineEntryAdded is {
        send timelineEntryAdded to outlet IncidentEventSplitToIncidentRepository
        send timelineEntryAdded to outlet IncidentEventSplitToIncidentMetricsProjector
        send timelineEntryAdded to outlet IncidentEventSplitToIncidentTrendsProjector
        tell timelineEntryAdded to entity IncidentContext.Incident
      }
      on incidentResolved: event Incident.IncidentResolved is {
        send incidentResolved to outlet IncidentEventSplitToIncidentRepository
        send incidentResolved to outlet IncidentEventSplitToIncidentMetricsProjector
        send incidentResolved to outlet IncidentEventSplitToIncidentTrendsProjector
        tell incidentResolved to entity IncidentContext.Incident
      }
      on postMortemCreated: event Incident.PostMortemCreated is {
        send postMortemCreated to outlet IncidentEventSplitToIncidentRepository
        send postMortemCreated to outlet IncidentEventSplitToIncidentMetricsProjector
        send postMortemCreated to outlet IncidentEventSplitToIncidentTrendsProjector
        tell postMortemCreated to entity IncidentContext.Incident
      }
      on incidentClosed: event Incident.IncidentClosed is {
        send incidentClosed to outlet IncidentEventSplitToIncidentRepository
        send incidentClosed to outlet IncidentEventSplitToIncidentMetricsProjector
        send incidentClosed to outlet IncidentEventSplitToIncidentTrendsProjector
        tell incidentClosed to entity IncidentContext.Incident
      }
      on other is {
        error "Unexpected message for processor IncidentEventSplit"
      }
    } with {
      briefly "Incident event fan-out handler"
      described as {
        |Delivers each Incident event to all of its consumers.
      }
    }
  } with {
    briefly "Incident event fan-out"
    described as {
      |Fans Incident events out to the repository and projectors.
    }
  }
  connector 'IncidentEvent Stream' is from outlet IncidentContext.Incident.IncidentEvents2 to inlet IncidentContext.IncidentEventSplit.IncidentEventSplitIn with {
    briefly "Incident events, fanned out to storage and read models"
  }
  connector 'IncidentEvent Storage' is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToIncidentRepository to inlet IncidentContext.IncidentRepository.IncidentRepositoryFromIncident with {
    briefly "Incident events on their way to storage"
  }
  connector 'IncidentMetricsProjector Feed' is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToIncidentMetricsProjector to inlet IncidentContext.IncidentMetricsProjector.IncidentMetricsProjectorFromIncident with {
    briefly "Incident events feeding the IncidentMetricsProjector projection"
  }
  connector 'IncidentTrendsProjector Feed' is from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToIncidentTrendsProjector to inlet IncidentContext.IncidentTrendsProjector.IncidentTrendsProjectorFromIncident with {
    briefly "Incident events feeding the IncidentTrendsProjector projection"
  }
  connector 'IncidentMetricsProjector Storage' is from outlet IncidentContext.IncidentMetricsProjector.IncidentMetricsProjectorOut to inlet IncidentContext.IncidentRepository.IncidentRepositoryFromIncidentMetricsProjector with {
    briefly "The IncidentMetricsProjector projection on its way to storage"
  }
  connector 'IncidentTrendsProjector Storage' is from outlet IncidentContext.IncidentTrendsProjector.IncidentTrendsProjectorOut to inlet IncidentContext.IncidentRepository.IncidentRepositoryFromIncidentTrendsProjector with {
    briefly "The IncidentTrendsProjector projection on its way to storage"
  }
} with {
  briefly "Bounded context for incident management"
  described as {
    | The Incident Management context handles the full lifecycle of
    | service incidents from detection through resolution and post-mortem.
    |
    | Key capabilities:
    | - Incident creation and tracking
    | - Severity management and escalation
    | - Timeline and audit logging
    | - Post-mortem documentation
    | - Metrics calculation (MTTR, MTTA)
    | - Trend analysis and reporting
    |
    | This context integrates with alerting systems, communication tools,
    | and on-call scheduling to provide a complete incident response
    | platform for DevOps and SRE teams.
  }
}
