// Incident Management Bounded Context
context IncidentContext is {
  inlet IncidentContextFromAlertingService is type AlertingService.AlertEvent
  include "types.riddl"
  include "Incident.riddl"
  // Repository for incident persistence and queries
  repository IncidentRepository is {
    inlet IncidentRepositoryFromIncident is type IncidentEvent
    inlet IncidentRepositoryFromIncidentMetricsProjector is type IncidentEvent
    inlet IncidentRepositoryFromIncidentTrendsProjector is type IncidentEvent
    outlet IncidentRepositoryResponses is type Incident.IncidentResult
    schema IncidentData is relational
      of incidents as type Incident
        index on field Incident.info.status
        index on field Incident.info.severity
        index on field Incident.info.createdAt
      with {
      briefly "Incident data schema"
      described as {
        |The relational schema holding incident data for the IncidentRepository.
      }
    }

    handler IncidentPersistence is {
      on command Incident.CreateIncident is {
        tell event Incident.IncidentCreated to entity IncidentContext.Incident
        do "Persist new incident to database"
      }
      on command Incident.AcknowledgeIncident is {
        tell event Incident.IncidentAcknowledged to entity IncidentContext.Incident
        do "Update incident with acknowledgment data"
      }
      on command Incident.EscalateIncident is {
        do "Update incident severity and affected services"
      }
      on command Incident.UpdateStatus is {
        do "Update incident status"
      }
      on command Incident.AssignIncidentCommander is {
        tell event Incident.IncidentCommanderAssigned to entity IncidentContext.Incident
        do "Update incident commander assignment"
      }
      on command Incident.AddTimelineEntry is {
        tell event Incident.TimelineEntryAdded to entity IncidentContext.Incident
        do "Append timeline entry to incident"
      }
      on command Incident.ResolveIncident is {
        do "Update incident with resolution data"
      }
      on command Incident.CreatePostMortem is {
        tell event Incident.PostMortemCreated to entity IncidentContext.Incident
        do "Store post-mortem linked to incident"
      }
      on command Incident.CloseIncident is {
        tell event Incident.IncidentClosed to entity IncidentContext.Incident
        do "Update incident to closed status"
      }
    } with {
      briefly "Persists incident events to storage"
      described as {
        |Handles all event-driven persistence operations for incidents.
      }
    }
  } with {
    briefly "Persistent storage for incidents"
    described as {
      | Repository providing CRUD operations and queries for
      | incident records, timelines, and post-mortem documents.
    }
  }
  // Projector for MTTR and incident frequency metrics
  projector IncidentMetricsProjector is {
    inlet IncidentMetricsProjectorFromIncident is type IncidentEvent
    outlet IncidentMetricsProjectorOut is type IncidentEvent
    updates repository IncidentContext.IncidentRepository
    record MetricsState is  {
      totalIncidents: Natural with {
        briefly "Total incidents"
        described as {
          |Count of all incidents tracked.
        }
      }
      incidentsBySeveritySev1: Natural with {
        briefly "Sev1 incidents"
        described as {
          |Count of Sev1 incidents.
        }
      }
      incidentsBySeveritySev2: Natural with {
        briefly "Sev2 incidents"
        described as {
          |Count of Sev2 incidents.
        }
      }
      incidentsBySeveritySev3: Natural with {
        briefly "Sev3 incidents"
        described as {
          |Count of Sev3 incidents.
        }
      }
      incidentsBySeveritySev4: Natural with {
        briefly "Sev4 incidents"
        described as {
          |Count of Sev4 incidents.
        }
      }
      incidentsBySeveritySev5: Natural with {
        briefly "Sev5 incidents"
        described as {
          |Count of Sev5 incidents.
        }
      }
      avgTimeToAcknowledge: Duration with {
        briefly "Average TTA"
        described as {
          |Mean time to acknowledge incidents.
        }
      }
      avgTimeToMitigate: Duration with {
        briefly "Average TTM"
        described as {
          |Mean time to mitigate incidents.
        }
      }
      avgTimeToResolve: Duration with {
        briefly "Average TTR"
        described as {
          |Mean time to resolve incidents.
        }
      }
    } with {
      briefly "Aggregated metrics state"
      described as {
        | Running aggregations of incident metrics for dashboard
        | display and reporting.
      }
    }
    handler MetricsProjectionHandler is {
      on event Incident.IncidentCreated is {
        tell event Incident.IncidentCreated to repository IncidentContext.IncidentRepository
        do "Increment incident count for severity level"
      }
      on event Incident.IncidentAcknowledged is {
        tell event Incident.IncidentAcknowledged to repository IncidentContext.IncidentRepository
        do "Calculate and update time-to-acknowledge metrics"
      }
      on event Incident.IncidentResolved is {
        tell event Incident.IncidentResolved to repository IncidentContext.IncidentRepository
        do "Calculate and update time-to-resolve metrics"
      }
      on event Incident.IncidentClosed is {
        tell event Incident.IncidentClosed to repository IncidentContext.IncidentRepository
        do "Finalize metrics for closed incident"
      }
    } with {
      briefly "Updates metrics on incident events"
      described as {
        | Processes incident lifecycle events to maintain
        | up-to-date metrics for MTTR, MTTA, and incident frequency.
      }
    }
  } with {
    briefly "Projects incident metrics for reporting"
    described as {
      | Maintains real-time aggregations of key incident metrics:
      | - MTTA: Mean Time To Acknowledge
      | - MTTM: Mean Time To Mitigate
      | - MTTR: Mean Time To Resolve
      | - Incident frequency by severity
      | - Incident frequency by service
      |
      | These metrics are essential for SRE reporting, capacity planning,
      | and continuous improvement of incident response processes.
    }
  }
  // Projector for incident trends and patterns
  projector IncidentTrendsProjector is {
    inlet IncidentTrendsProjectorFromIncident is type IncidentEvent
    outlet IncidentTrendsProjectorOut is type IncidentEvent
    updates repository IncidentContext.IncidentRepository
    record TrendsState is  {
      weeklyIncidentCount: Natural with {
        briefly "Weekly count"
        described as {
          |Incidents in the current week.
        }
      }
      monthlyIncidentCount: Natural with {
        briefly "Monthly count"
        described as {
          |Incidents in the current month.
        }
      }
      topAffectedServices: ServiceId+ with {
        briefly "Top affected services"
        described as {
          |Services with most incidents.
        }
      }
      commonRootCauses: String+ with {
        briefly "Common root causes"
        described as {
          |Frequently occurring root causes.
        }
      }
      sev1Count: Natural with {
        briefly "Sev1 count"
        described as {
          |Sev1 incidents in period.
        }
      }
      sev2Count: Natural with {
        briefly "Sev2 count"
        described as {
          |Sev2 incidents in period.
        }
      }
      sev3Count: Natural with {
        briefly "Sev3 count"
        described as {
          |Sev3 incidents in period.
        }
      }
    } with {
      briefly "Incident trend analysis state"
      described as {
        | Aggregated data for trend analysis including weekly
        | and monthly patterns, most affected services, and common causes.
      }
    }
    handler TrendsProjectionHandler is {
      on event Incident.IncidentCreated is {
        tell event Incident.IncidentCreated to repository IncidentContext.IncidentRepository
        do "Update weekly and monthly incident counts"
      }
      on event Incident.IncidentResolved is {
        tell event Incident.IncidentResolved to repository IncidentContext.IncidentRepository
        do "Update resolution trends"
      }
      on event Incident.PostMortemCreated is {
        tell event Incident.PostMortemCreated to repository IncidentContext.IncidentRepository
        do "Extract and aggregate root cause patterns"
      }
    } with {
      briefly "Updates trends on incident events"
      described as {
        | Processes incident events to maintain trend data for
        | pattern recognition and proactive improvement.
      }
    }
  } with {
    briefly "Projects incident trends for analysis"
    described as {
      | Analyzes incident patterns over time to identify:
      | - Recurring issues
      | - Problematic services
      | - Common root causes
      | - Seasonal or periodic patterns
      |
      | This data supports proactive reliability improvements and
      | resource allocation decisions.
    }
  }
  // Adaptor for alerting service integration
  adaptor AlertAdapter from context AlertingService is { 
    handler InboundAlerts is {
      on event AlertingService.AlertTriggered is {
        tell command CreateIncident to entity Incident
      }
      on event AlertingService.AlertResolved is {
        do "Check if incident should be auto-resolved"
      }
      on other is {
        error "Unexpected message for adaptor AlertAdapter"
      }
    } with {
      briefly "Handles alert events from monitoring"
      described as {
        |Processes inbound alerts and creates incidents.
      }
    }
  } with {
    briefly "Translates alerting service events"
    described as {
      | Receives alert events from external monitoring systems
      | and creates incidents in the incident management system.
    }
  }
  // Adaptor for PagerDuty integration
  adaptor PagerDutyAdapter from context PagerDutyIntegration is { 
    handler InboundPages is {
      on event PagerDutyIntegration.PageAcknowledged is {
        tell command AcknowledgeIncident to entity Incident
      }
      on other is {
        error "Unexpected message for adaptor PagerDutyAdapter"
      }
    } with {
      briefly "Handles PagerDuty events"
      described as {
        |Processes page acknowledgments from PagerDuty.
      }
    }
  } with {
    briefly "Translates PagerDuty events"
    described as {
      | Receives events from PagerDuty for page acknowledgments
      | and updates incident status accordingly.
    }
  }
  // Adaptor for Slack integration
  adaptor SlackAdapter from context SlackIntegration is { 
    handler InboundSlack is {
      on event SlackIntegration.ChannelCreated is {
        do "Update incident with communication channel"
      }
      on event SlackIntegration.MessagePosted is {
        do "Log message as timeline entry if relevant"
      }
      on other is {
        error "Unexpected message for adaptor SlackAdapter"
      }
    } with {
      briefly "Handles Slack events"
      described as {
        |Processes Slack channel and message events.
      }
    }
  } with {
    briefly "Translates Slack events"
    described as {
      | Receives events from Slack integration for channel
      | creation and message posting.
    }
  }
  // ---- Event publication for Incident ----
  type IncidentEvent is one of {
    IncidentContext.Incident.IncidentCreated,
    IncidentContext.Incident.IncidentAcknowledged,
    IncidentContext.Incident.IncidentEscalated,
    IncidentContext.Incident.IncidentStatusUpdated,
    IncidentContext.Incident.IncidentCommanderAssigned,
    IncidentContext.Incident.TimelineEntryAdded,
    IncidentContext.Incident.IncidentResolved,
    IncidentContext.Incident.PostMortemCreated,
    IncidentContext.Incident.IncidentClosed
  } with {
    briefly "Incident event alternation"
    described as {
      |Union of all Incident events, for streaming and event-sourced
      |persistence.
    }
  }
  processor IncidentEventSource as source is {
    outlet IncidentEvents is type IncidentEvent
    handler IncidentSourceHandler is {
      on event Incident.IncidentCreated is {
        send event Incident.IncidentCreated to outlet IncidentEvents
      }
      on event Incident.IncidentAcknowledged is {
        send event Incident.IncidentAcknowledged to outlet IncidentEvents
      }
      on event Incident.IncidentEscalated is {
        send event Incident.IncidentEscalated to outlet IncidentEvents
      }
      on event Incident.IncidentStatusUpdated is {
        send event Incident.IncidentStatusUpdated to outlet IncidentEvents
      }
      on event Incident.IncidentCommanderAssigned is {
        send event Incident.IncidentCommanderAssigned to outlet IncidentEvents
      }
      on event Incident.TimelineEntryAdded is {
        send event Incident.TimelineEntryAdded to outlet IncidentEvents
      }
      on event Incident.IncidentResolved is {
        send event Incident.IncidentResolved to outlet IncidentEvents
      }
      on event Incident.PostMortemCreated is {
        send event Incident.PostMortemCreated to outlet IncidentEvents
      }
      on event Incident.IncidentClosed is {
        send event Incident.IncidentClosed to outlet IncidentEvents
      }
      on other is {
        error "Unexpected message for source IncidentEventSource"
      }
    } with {
      briefly "Incident source handler"
      described as {
        |Publishes Incident events onto the outlet.
      }
    }
  } with {
    briefly "Incident event source"
    described as {
      |Publishes Incident entity events into the streaming topology.
    }
  }
  processor IncidentEventSink as sink is {
    inlet IncidentInlet is type IncidentEvent
    handler IncidentSinkHandler is {
      on event Incident.IncidentCreated is {
        tell event Incident.IncidentCreated to repository IncidentContext.IncidentRepository
      }
      on event Incident.IncidentAcknowledged is {
        tell event Incident.IncidentAcknowledged to repository IncidentContext.IncidentRepository
      }
      on event Incident.IncidentEscalated is {
        tell event Incident.IncidentEscalated to repository IncidentContext.IncidentRepository
      }
      on event Incident.IncidentStatusUpdated is {
        tell event Incident.IncidentStatusUpdated to repository IncidentContext.IncidentRepository
      }
      on event Incident.IncidentCommanderAssigned is {
        tell event Incident.IncidentCommanderAssigned to repository IncidentContext.IncidentRepository
      }
      on event Incident.TimelineEntryAdded is {
        tell event Incident.TimelineEntryAdded to repository IncidentContext.IncidentRepository
      }
      on event Incident.IncidentResolved is {
        tell event Incident.IncidentResolved to repository IncidentContext.IncidentRepository
      }
      on event Incident.PostMortemCreated is {
        tell event Incident.PostMortemCreated to repository IncidentContext.IncidentRepository
      }
      on event Incident.IncidentClosed is {
        tell event Incident.IncidentClosed to repository IncidentContext.IncidentRepository
      }
      on other is {
        error "Unexpected message for sink IncidentEventSink"
      }
    } with {
      briefly "Incident sink handler"
      described as {
        |Persists Incident events via the repository.
      }
    }
  } with {
    briefly "Incident event sink"
    described as {
      |Receives Incident events for persistence.
    }
  }
  connector IncidentEventFlow is {
    from outlet IncidentContext.IncidentEventSource.IncidentEvents to
      inlet IncidentContext.IncidentEventSink.IncidentInlet
  } with {
    briefly "Incident event flow"
    described as {
      |Connects the Incident source to its sink.
    }
  }
  processor IncidentEventSplit is {
    inlet IncidentEventSplitIn is type IncidentEvent
    outlet IncidentEventSplitToIncidentRepository is type IncidentEvent
    outlet IncidentEventSplitToIncidentMetricsProjector is type IncidentEvent
    outlet IncidentEventSplitToIncidentTrendsProjector is type IncidentEvent
    handler IncidentEventSplitHandler is {
      on event Incident.IncidentCreated is {
        send event Incident.IncidentCreated to outlet IncidentEventSplitToIncidentRepository
        send event Incident.IncidentCreated to outlet IncidentEventSplitToIncidentMetricsProjector
        send event Incident.IncidentCreated to outlet IncidentEventSplitToIncidentTrendsProjector
        tell event Incident.IncidentCreated to entity IncidentContext.Incident
      }
      on event Incident.IncidentAcknowledged is {
        send event Incident.IncidentAcknowledged to outlet IncidentEventSplitToIncidentRepository
        send event Incident.IncidentAcknowledged to outlet IncidentEventSplitToIncidentMetricsProjector
        send event Incident.IncidentAcknowledged to outlet IncidentEventSplitToIncidentTrendsProjector
        tell event Incident.IncidentAcknowledged to entity IncidentContext.Incident
      }
      on event Incident.IncidentEscalated is {
        send event Incident.IncidentEscalated to outlet IncidentEventSplitToIncidentRepository
        send event Incident.IncidentEscalated to outlet IncidentEventSplitToIncidentMetricsProjector
        send event Incident.IncidentEscalated to outlet IncidentEventSplitToIncidentTrendsProjector
        tell event Incident.IncidentEscalated to entity IncidentContext.Incident
      }
      on event Incident.IncidentStatusUpdated is {
        send event Incident.IncidentStatusUpdated to outlet IncidentEventSplitToIncidentRepository
        send event Incident.IncidentStatusUpdated to outlet IncidentEventSplitToIncidentMetricsProjector
        send event Incident.IncidentStatusUpdated to outlet IncidentEventSplitToIncidentTrendsProjector
        tell event Incident.IncidentStatusUpdated to entity IncidentContext.Incident
      }
      on event Incident.IncidentCommanderAssigned is {
        send event Incident.IncidentCommanderAssigned to outlet IncidentEventSplitToIncidentRepository
        send event Incident.IncidentCommanderAssigned to outlet IncidentEventSplitToIncidentMetricsProjector
        send event Incident.IncidentCommanderAssigned to outlet IncidentEventSplitToIncidentTrendsProjector
        tell event Incident.IncidentCommanderAssigned to entity IncidentContext.Incident
      }
      on event Incident.TimelineEntryAdded is {
        send event Incident.TimelineEntryAdded to outlet IncidentEventSplitToIncidentRepository
        send event Incident.TimelineEntryAdded to outlet IncidentEventSplitToIncidentMetricsProjector
        send event Incident.TimelineEntryAdded to outlet IncidentEventSplitToIncidentTrendsProjector
        tell event Incident.TimelineEntryAdded to entity IncidentContext.Incident
      }
      on event Incident.IncidentResolved is {
        send event Incident.IncidentResolved to outlet IncidentEventSplitToIncidentRepository
        send event Incident.IncidentResolved to outlet IncidentEventSplitToIncidentMetricsProjector
        send event Incident.IncidentResolved to outlet IncidentEventSplitToIncidentTrendsProjector
        tell event Incident.IncidentResolved to entity IncidentContext.Incident
      }
      on event Incident.PostMortemCreated is {
        send event Incident.PostMortemCreated to outlet IncidentEventSplitToIncidentRepository
        send event Incident.PostMortemCreated to outlet IncidentEventSplitToIncidentMetricsProjector
        send event Incident.PostMortemCreated to outlet IncidentEventSplitToIncidentTrendsProjector
        tell event Incident.PostMortemCreated to entity IncidentContext.Incident
      }
      on event Incident.IncidentClosed is {
        send event Incident.IncidentClosed to outlet IncidentEventSplitToIncidentRepository
        send event Incident.IncidentClosed to outlet IncidentEventSplitToIncidentMetricsProjector
        send event Incident.IncidentClosed to outlet IncidentEventSplitToIncidentTrendsProjector
        tell event Incident.IncidentClosed to entity IncidentContext.Incident
      }
      on other is {
        error "Unexpected message for processor IncidentEventSplit"
      }
    } with {
      briefly "Incident event fan-out handler"
      described as {
        |Delivers each Incident event to all of its consumers.
      }
    }
  } with {
    briefly "Incident event fan-out"
    described as {
      |Fans Incident events out to the repository and projectors.
    }
  }
  connector LinkIncidentToIncidentEventSplit is {
    from outlet IncidentContext.Incident.IncidentEvents2 to
      inlet IncidentContext.IncidentEventSplit.IncidentEventSplitIn
  } with {
    briefly "LinkIncidentToIncidentEventSplit"
  }
  connector LinkIncidentEventSplitToIncidentRepository is {
    from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToIncidentRepository to
      inlet IncidentContext.IncidentRepository.IncidentRepositoryFromIncident
  } with {
    briefly "LinkIncidentEventSplitToIncidentRepository"
  }
  connector LinkIncidentEventSplitToIncidentMetricsProjector is {
    from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToIncidentMetricsProjector to
      inlet IncidentContext.IncidentMetricsProjector.IncidentMetricsProjectorFromIncident
  } with {
    briefly "LinkIncidentEventSplitToIncidentMetricsProjector"
  }
  connector LinkIncidentEventSplitToIncidentTrendsProjector is {
    from outlet IncidentContext.IncidentEventSplit.IncidentEventSplitToIncidentTrendsProjector to
      inlet IncidentContext.IncidentTrendsProjector.IncidentTrendsProjectorFromIncident
  } with {
    briefly "LinkIncidentEventSplitToIncidentTrendsProjector"
  }
  connector LinkIncidentMetricsProjectorToIncidentRepository is {
    from outlet IncidentContext.IncidentMetricsProjector.IncidentMetricsProjectorOut to
      inlet IncidentContext.IncidentRepository.IncidentRepositoryFromIncidentMetricsProjector
  } with {
    briefly "LinkIncidentMetricsProjectorToIncidentRepository"
  }
  connector LinkIncidentTrendsProjectorToIncidentRepository is {
    from outlet IncidentContext.IncidentTrendsProjector.IncidentTrendsProjectorOut to
      inlet IncidentContext.IncidentRepository.IncidentRepositoryFromIncidentTrendsProjector
  } with {
    briefly "LinkIncidentTrendsProjectorToIncidentRepository"
  }
} with {
  briefly "Bounded context for incident management"
  described as {
    | The Incident Management context handles the full lifecycle of
    | service incidents from detection through resolution and post-mortem.
    |
    | Key capabilities:
    | - Incident creation and tracking
    | - Severity management and escalation
    | - Timeline and audit logging
    | - Post-mortem documentation
    | - Metrics calculation (MTTR, MTTA)
    | - Trend analysis and reporting
    |
    | This context integrates with alerting systems, communication tools,
    | and on-call scheduling to provide a complete incident response
    | platform for DevOps and SRE teams.
  }
}
