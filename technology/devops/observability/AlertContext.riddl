// Observability - Alert Context
context AlertContext as router is {
  inlet AlertCommandStreamIn is type AlertCommand  outlet AlertCommandStreamOut is type AlertCommand
  inlet AlertResultStreamIn is result Alert.AlertResult  outlet AlertResultStreamOut is result Alert.AlertResult
  handler AlertContextBoundary is {
    on createAlert: command Alert.CreateAlert is {
      send createAlert to outlet AlertContext.AlertCommandStreamOut
    }
    on acknowledgeAlert: command Alert.AcknowledgeAlert is {
      send acknowledgeAlert to outlet AlertContext.AlertCommandStreamOut
    }
    on resolveAlert: command Alert.ResolveAlert is {
      send resolveAlert to outlet AlertContext.AlertCommandStreamOut
    }
    on silenceAlert: command Alert.SilenceAlert is {
      send silenceAlert to outlet AlertContext.AlertCommandStreamOut
    }
    on escalateAlert: command Alert.EscalateAlert is {
      send escalateAlert to outlet AlertContext.AlertCommandStreamOut
    }
    on addComment: command Alert.AddComment is {
      send addComment to outlet AlertContext.AlertCommandStreamOut
    }
    on expireAlert: command Alert.ExpireAlert is {
      send expireAlert to outlet AlertContext.AlertCommandStreamOut
    }
    on alertResult: result Alert.AlertResult is {
      send alertResult to outlet AlertContext.AlertResultStreamOut
    }
    on other is {
      error "Unexpected message at the AlertContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AlertCommand Stream Intake' is from outlet AlertContext.AlertCommandStreamOut to inlet AlertContext.Alert.AlertCommands  connector 'AlertResult Stream Egress' is from outlet AlertContext.AlertRepository.AlertRepositoryResponses to inlet AlertContext.AlertResultStreamIn  adaptor FromDashboardService from context DashboardService is { 
    inlet FromDashboardServiceIn is event DashboardService.DashboardCreated    handler FromDashboardServiceHandler is {
      on dashboardCreated: event DashboardService.DashboardCreated is {
        do "the dashboard exists; escalating was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromDashboardService"
      }
    } with {
      briefly "from dashboard service"
      described as {
        |Carries messages from the external DashboardService.
      }
    }
  } with {
    briefly "DashboardService integration"
    described as {
      |The model's side of the DashboardService conversation.
    }
  }
  adaptor ToDashboardService to context DashboardService as flow is { 
    outlet ToDashboardServiceOut is type DashboardService.DashboardServiceRequest
    handler ToDashboardServiceHandler is {
      on alertCreated: event Alert.AlertCreated is {
        let askAnswer: type DashboardService.DashboardConfig = ask query DashboardService.GetDashboard of context DashboardService
        do "a new alert needing the dashboard a responder will be sent to"
      }
      on alertEscalated: event Alert.AlertEscalated is {
        let item0: type DashboardService.CreateDashboard = prompt("translate the alertEscalated event into a CreateDashboard, escalation being when an alert needs somewhere to be watched")
        send item0 to outlet AlertContext.ToDashboardService.ToDashboardServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToDashboardService"
      }
    } with {
      briefly "to dashboard service"
      described as {
        |Carries messages to the external DashboardService.
      }
    }
  } with {
    briefly "DashboardService integration"
    described as {
      |The model's side of the DashboardService conversation.
    }
  }
  adaptor FromDistributedTracingService from context DistributedTracingService is { 
    inlet FromDistributedTracingServiceIn is event DistributedTracingService.SpansIngested    handler FromDistributedTracingServiceHandler is {
      on spansIngested: event DistributedTracingService.SpansIngested is {
        do "the traces are stored; the alert's own state is unchanged"
      }
      on other is {
        error "Unexpected message for adaptor FromDistributedTracingService"
      }
    } with {
      briefly "from distributed tracing service"
      described as {
        |Carries messages from the external DistributedTracingService.
      }
    }
  } with {
    briefly "DistributedTracingService integration"
    described as {
      |The model's side of the DistributedTracingService conversation.
    }
  }
  adaptor ToDistributedTracingService to context DistributedTracingService as flow is { 
    outlet ToDistributedTracingServiceOut is type DistributedTracingService.DistributedTracingServiceRequest
    handler ToDistributedTracingServiceHandler is {
      on alertAcknowledged: event Alert.AlertAcknowledged is {
        let askAnswer: type DistributedTracingService.TraceSearchResult = ask query DistributedTracingService.GetTrace of context DistributedTracingService
        do "an acknowledged alert needing the one trace that shows the failure"
      }
      on alertEscalated: event Alert.AlertEscalated is {
        let askAnswer: type DistributedTracingService.TraceSearchResult = ask query DistributedTracingService.SearchTraces of context DistributedTracingService
        do "an escalation needing the traces around the window that went wrong"
      }
      on alertCreated: event Alert.AlertCreated is {
        let item0: type DistributedTracingService.IngestSpans = prompt("translate the alertCreated event into a IngestSpans, an alert being when traces are worth pulling in")
        send item0 to outlet AlertContext.ToDistributedTracingService.ToDistributedTracingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToDistributedTracingService"
      }
    } with {
      briefly "to distributed tracing service"
      described as {
        |Carries messages to the external DistributedTracingService.
      }
    }
  } with {
    briefly "DistributedTracingService integration"
    described as {
      |The model's side of the DistributedTracingService conversation.
    }
  }
  adaptor FromLogAggregationService from context LogAggregationService is { 
    inlet FromLogAggregationServiceIn is event LogAggregationService.LogsIngested    handler FromLogAggregationServiceHandler is {
      on logsIngested: event LogAggregationService.LogsIngested is {
        do "the logs are stored; the alert's own state is unchanged"
      }
      on other is {
        error "Unexpected message for adaptor FromLogAggregationService"
      }
    } with {
      briefly "from log aggregation service"
      described as {
        |Carries messages from the external LogAggregationService.
      }
    }
  } with {
    briefly "LogAggregationService integration"
    described as {
      |The model's side of the LogAggregationService conversation.
    }
  }
  adaptor ToLogAggregationService to context LogAggregationService as flow is { 
    outlet ToLogAggregationServiceOut is type LogAggregationService.LogAggregationServiceRequest
    handler ToLogAggregationServiceHandler is {
      on alertAcknowledged: event Alert.AlertAcknowledged is {
        let askAnswer: type LogAggregationService.LogSearchResult = ask query LogAggregationService.SearchLogs of context LogAggregationService
        do "an acknowledged alert needing the logs from the window it covers"
      }
      on alertCreated: event Alert.AlertCreated is {
        let item0: type LogAggregationService.IngestLogs = prompt("translate the alertCreated event into a IngestLogs, and when logs are")
        send item0 to outlet AlertContext.ToLogAggregationService.ToLogAggregationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToLogAggregationService"
      }
    } with {
      briefly "to log aggregation service"
      described as {
        |Carries messages to the external LogAggregationService.
      }
    }
  } with {
    briefly "LogAggregationService integration"
    described as {
      |The model's side of the LogAggregationService conversation.
    }
  }
  adaptor FromMetricsCollectionService from context MetricsCollectionService is { 
    inlet FromMetricsCollectionServiceIn is event MetricsCollectionService.MetricsIngested    handler FromMetricsCollectionServiceHandler is {
      on metricsIngested: event MetricsCollectionService.MetricsIngested is {
        do "the metrics are stored; the alert's own state is unchanged"
      }
      on other is {
        error "Unexpected message for adaptor FromMetricsCollectionService"
      }
    } with {
      briefly "from metrics collection service"
      described as {
        |Carries messages from the external MetricsCollectionService.
      }
    }
  } with {
    briefly "MetricsCollectionService integration"
    described as {
      |The model's side of the MetricsCollectionService conversation.
    }
  }
  adaptor ToMetricsCollectionService to context MetricsCollectionService as flow is { 
    outlet ToMetricsCollectionServiceOut is type MetricsCollectionService.MetricsCollectionServiceRequest
    handler ToMetricsCollectionServiceHandler is {
      on alertResolved: event Alert.AlertResolved is {
        let askAnswer: type MetricsCollectionService.MetricQueryResult = ask query MetricsCollectionService.QueryMetrics of context MetricsCollectionService
        do "a resolved alert needing the metrics that show it really recovered"
      }
      on alertCreated: event Alert.AlertCreated is {
        let item0: type MetricsCollectionService.IngestMetrics = prompt("translate the alertCreated event into a IngestMetrics, and when metrics are")
        send item0 to outlet AlertContext.ToMetricsCollectionService.ToMetricsCollectionServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToMetricsCollectionService"
      }
    } with {
      briefly "to metrics collection service"
      described as {
        |Carries messages to the external MetricsCollectionService.
      }
    }
  } with {
    briefly "MetricsCollectionService integration"
    described as {
      |The model's side of the MetricsCollectionService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    inlet FromNotificationServiceIn is type NotificationService.NotificationServiceEvent    handler FromNotificationServiceHandler is {
      on notificationFailed: event NotificationService.NotificationFailed is {
        do "the page did not reach anyone; escalating is the on-call's act"
      }
      on notificationSent: event NotificationService.NotificationSent is {
        do "the on-call has been paged; the alert's own state is unchanged"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    outlet ToNotificationServiceOut is command NotificationService.SendAlertNotification
    handler ToNotificationServiceHandler is {
      on alertCreated: event AlertCreated is {
        let notice: type NotificationService.SendAlertNotification = prompt("translate the alertCreated event into a SendAlertNotification telling the on-call responder an alert is firing, what fired it, and how severe it is")
        send notice to outlet AlertContext.ToNotificationService.ToNotificationServiceOut
      }
      on alertEscalated: event AlertEscalated is {
        let notice: type NotificationService.SendAlertNotification = prompt("translate the alertEscalated event into a SendAlertNotification telling the next responder up that an alert went unacknowledged and is now theirs")
        send notice to outlet AlertContext.ToNotificationService.ToNotificationServiceOut
      }
      on alertResolved: event AlertResolved is {
        let notice: type NotificationService.SendAlertNotification = prompt("translate the alertResolved event into a SendAlertNotification telling the responders the alert has cleared, so nobody keeps working it")
        send notice to outlet AlertContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "Alert.riddl"
  // Repository for alert persistence
  type AlertRepositoryCommand is one of {
    AlertContext.AlertRepository.PersistAlertAcknowledged or AlertContext.AlertRepository.PersistAlertCreated or AlertContext.AlertRepository.PersistAlertEscalated or AlertContext.AlertRepository.PersistAlertExpired or AlertContext.AlertRepository.PersistAlertResolved or AlertContext.AlertRepository.PersistAlertSilenced or AlertContext.AlertRepository.PersistCommentAdded
  } with {
    briefly "Anything that writes AlertRepository"
    described as {
      |The persistence commands AlertRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository AlertRepository as flow is {
    inlet AlertRepositoryFromObservabilityAnalytics is type AlertRepositoryCommand    command PersistAlertEscalated is {
      alertId: AlertId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlertEscalated applies to.
        }
      }
    } with {
      briefly "Persist AlertEscalated"
      described as {
        |Instructs this repository to apply AlertEscalated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAlertExpired is {
      alertId: AlertId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlertExpired applies to.
        }
      }
    } with {
      briefly "Persist AlertExpired"
      described as {
        |Instructs this repository to apply AlertExpired to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAlertSilenced is {
      alertId: AlertId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlertSilenced applies to.
        }
      }
    } with {
      briefly "Persist AlertSilenced"
      described as {
        |Instructs this repository to apply AlertSilenced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCommentAdded is {
      alertId: AlertId with {
        briefly "Row addressed"
        described as {
          |Which stored row CommentAdded applies to.
        }
      }
    } with {
      briefly "Persist CommentAdded"
      described as {
        |Instructs this repository to apply CommentAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAlertAcknowledged is {
      alertId: AlertId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlertAcknowledged applies to.
        }
      }
    } with {
      briefly "Persist AlertAcknowledged"
      described as {
        |Instructs this repository to apply AlertAcknowledged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAlertCreated is {
      alertId: AlertId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlertCreated applies to.
        }
      }
    } with {
      briefly "Persist AlertCreated"
      described as {
        |Instructs this repository to apply AlertCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAlertResolved is {
      alertId: AlertId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlertResolved applies to.
        }
      }
    } with {
      briefly "Persist AlertResolved"
      described as {
        |Instructs this repository to apply AlertResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet AlertRepositoryResponses is result Alert.AlertResult
    record StoredAlert is {
      alertId: AlertId with {
        briefly "alertId"
        described as {
          |The alertId column of the stored alert row.
        }
      }
      rule: AlertRule with {
        briefly "rule"
        described as {
          |The rule column of the stored alert row.
        }
      }
    } with {
      briefly "Stored alert row"
      described as {
        |The persistence shape of alert data as this repository stores it.
      }
    }
    schema AlertData is relational
      of alerts as record StoredAlert
        index on field StoredAlert.alertId
        index on field StoredAlert.rule.severity
 with {
      briefly "Alert data schema"
      described as {
        |The relational schema holding alert data for the AlertRepository.
      }
    }
    handler AlertPersistence is {
      on persistAlertEscalated: command PersistAlertEscalated is {
        do "apply AlertEscalated to the stored row"
      }
      on persistAlertExpired: command PersistAlertExpired is {
        do "apply AlertExpired to the stored row"
      }
      on persistAlertSilenced: command PersistAlertSilenced is {
        do "apply AlertSilenced to the stored row"
      }
      on persistCommentAdded: command PersistCommentAdded is {
        do "apply CommentAdded to the stored row"
      }
      on persistAlertAcknowledged: command PersistAlertAcknowledged is {
        do "apply AlertAcknowledged to the stored row"
      }
      on persistAlertCreated: command PersistAlertCreated is {
        do "apply AlertCreated to the stored row"
      }
      on persistAlertResolved: command PersistAlertResolved is {
        do "apply AlertResolved to the stored row"
      }
      on query GetObservabilityStats is {
        let observabilityStatsView: type ObservabilityStatsView = prompt("read the observability stats projection")
        reply observabilityStatsView
      }
    } with {
      briefly "Persists alert commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Alert data persistence"
    described as {
      | The AlertRepository provides persistent storage for
      | alerts, comments, and resolution history.
    }
  }
  // Projector for observability analytics
  query GetObservabilityStats replies result ObservabilityStatsView is {
    observabilityStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which observability stats to retrieve.
      }
    }
  } with {
    briefly "Get observability stats"
    described as {
      |Retrieves the observability stats projection.
    }
  }
  result ObservabilityStatsView is {
    observabilityStats: ObservabilityAnalytics.ObservabilityStats with {
      briefly "Observability stats"
      described as {
        |The observability stats being returned.
      }
    }
  } with {
    briefly "Observability stats view"
    described as {
      |Read model view carrying the observability stats projection.
    }
  }
  projector ObservabilityAnalytics as flow is {
    updates repository AlertContext.AlertRepository
    outlet ObservabilityAnalyticsToRepository is type AlertRepositoryCommand
    inlet ObservabilityAnalyticsFromAlert is type AlertEvent    record ObservabilityStats is {
      activeAlerts: Natural with {
        briefly "Active"
        described as {
          |Active alerts.
        }
      }
      criticalAlerts: Natural with {
        briefly "Critical"
        described as {
          |Critical alerts.
        }
      }
      alertsToday: Natural with {
        briefly "Today"
        described as {
          |Alerts fired today.
        }
      }
      mttr: Natural with {
        briefly "MTTR"
        described as {
          |Mean time to resolve (minutes).
        }
      }
      acknowledgeRate: Decimal(5,4) with {
        briefly "Ack rate"
        described as {
          |Acknowledgment rate.
        }
      }
    } with {
      briefly "Observability statistics"
      described as {
        |Alert and incident metrics.
      }
    }
    handler AnalyticsHandler is {
      on alertEscalated: event Alert.AlertEscalated is {
        tell command AlertContext.AlertRepository.PersistAlertEscalated(alertId = alertEscalated.alertId) to repository AlertContext.AlertRepository
        do "apply AlertEscalated to the ObservabilityAnalytics projection"
      }
      on alertExpired: event Alert.AlertExpired is {
        tell command AlertContext.AlertRepository.PersistAlertExpired(alertId = alertExpired.alertId) to repository AlertContext.AlertRepository
        do "apply AlertExpired to the ObservabilityAnalytics projection"
      }
      on alertSilenced: event Alert.AlertSilenced is {
        tell command AlertContext.AlertRepository.PersistAlertSilenced(alertId = alertSilenced.alertId) to repository AlertContext.AlertRepository
        do "apply AlertSilenced to the ObservabilityAnalytics projection"
      }
      on commentAdded: event Alert.CommentAdded is {
        tell command AlertContext.AlertRepository.PersistCommentAdded(alertId = commentAdded.alertId) to repository AlertContext.AlertRepository
        do "apply CommentAdded to the ObservabilityAnalytics projection"
      }
      on alertCreated: event Alert.AlertCreated is {
        tell command AlertContext.AlertRepository.PersistAlertCreated(alertId = alertCreated.alertId) to repository AlertContext.AlertRepository
        do "Update alert counts"
      }
      on alertAcknowledged: event Alert.AlertAcknowledged is {
        tell command AlertContext.AlertRepository.PersistAlertAcknowledged(alertId = alertAcknowledged.alertId) to repository AlertContext.AlertRepository
        do "Update ack metrics"
      }
      on alertResolved: event Alert.AlertResolved is {
        tell command AlertContext.AlertRepository.PersistAlertResolved(alertId = alertResolved.alertId) to repository AlertContext.AlertRepository
        do "Update resolution metrics"
      }
    } with {
      briefly "Maintains observability analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Observability analytics projections"
    described as {
      |Maintains alert and incident analytics data.
    }
  }
  // ---- Event publication for Alert ----
  type AlertEvent is one of {
    AlertContext.Alert.AlertCreated or AlertContext.Alert.AlertAcknowledged or AlertContext.Alert.AlertResolved or AlertContext.Alert.AlertSilenced or AlertContext.Alert.AlertEscalated or AlertContext.Alert.CommentAdded or AlertContext.Alert.AlertExpired
  } with {
    briefly "Alert event alternation"
    described as {
      |Union of all Alert events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet AlertEventSplit as flow is {
    inlet AlertEventSplitIn is type AlertEvent    outlet AlertEventSplitToObservabilityAnalytics is type AlertEvent
    handler AlertEventSplitHandler is {
      on alertCreated: event Alert.AlertCreated is {
        send alertCreated to outlet AlertEventSplitToObservabilityAnalytics
        tell alertCreated to entity AlertContext.Alert
      }
      on alertAcknowledged: event Alert.AlertAcknowledged is {
        send alertAcknowledged to outlet AlertEventSplitToObservabilityAnalytics
        tell alertAcknowledged to entity AlertContext.Alert
      }
      on alertResolved: event Alert.AlertResolved is {
        send alertResolved to outlet AlertEventSplitToObservabilityAnalytics
        tell alertResolved to entity AlertContext.Alert
      }
      on alertSilenced: event Alert.AlertSilenced is {
        send alertSilenced to outlet AlertEventSplitToObservabilityAnalytics
        tell alertSilenced to entity AlertContext.Alert
      }
      on alertEscalated: event Alert.AlertEscalated is {
        send alertEscalated to outlet AlertEventSplitToObservabilityAnalytics
        tell alertEscalated to entity AlertContext.Alert
      }
      on commentAdded: event Alert.CommentAdded is {
        send commentAdded to outlet AlertEventSplitToObservabilityAnalytics
        tell commentAdded to entity AlertContext.Alert
      }
      on alertExpired: event Alert.AlertExpired is {
        send alertExpired to outlet AlertEventSplitToObservabilityAnalytics
        tell alertExpired to entity AlertContext.Alert
      }
      on other is {
        error "Unexpected message for processor AlertEventSplit"
      }
    } with {
      briefly "Alert event fan-out handler"
      described as {
        |Delivers each Alert event to all of its consumers.
      }
    }
  } with {
    briefly "Alert event fan-out"
    described as {
      |Fans Alert events out to the repository and projectors.
    }
  }
  connector 'AlertEvent Stream' is from outlet AlertContext.Alert.AlertEvents2 to inlet AlertContext.AlertEventSplit.AlertEventSplitIn with {
    briefly "Alert events, fanned out to storage and read models"
  }
  connector 'ObservabilityAnalytics Feed' is from outlet AlertContext.AlertEventSplit.AlertEventSplitToObservabilityAnalytics to inlet AlertContext.ObservabilityAnalytics.ObservabilityAnalyticsFromAlert with {
    briefly "Alert events feeding the ObservabilityAnalytics projection"
  }
  connector 'ObservabilityAnalytics Storage' is from outlet AlertContext.ObservabilityAnalytics.ObservabilityAnalyticsToRepository to inlet AlertContext.AlertRepository.AlertRepositoryFromObservabilityAnalytics with {
    briefly "ObservabilityAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for alerting"
  described as {
    | The AlertContext is the bounded context for
    | alert management and incident tracking.
  }
}
