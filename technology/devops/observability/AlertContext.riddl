// Observability - Alert Context
context AlertContext is {
  adaptor FromDashboardService from context DashboardService is { 
    handler FromDashboardServiceHandler is {
      on result DashboardService.DashboardConfig is {
        do "the model receives dashboard config"
      }
      on event DashboardService.DashboardCreated is {
        do "the model receives dashboard created"
      }
      on other is {
        error "Unexpected message for adaptor FromDashboardService"
      }
    } with {
      briefly "from dashboard service"
      described as {
        |Carries messages from the external DashboardService.
      }
    }
  } with {
    briefly "DashboardService integration"
    described as {
      |The model's side of the DashboardService conversation.
    }
  }
  adaptor ToDashboardService to context DashboardService is { 
    handler ToDashboardServiceHandler is {
      on command DashboardService.CreateDashboard is {
        do "the model sends create dashboard"
      }
      on query DashboardService.GetDashboard is {
        do "the model sends get dashboard"
      }
      on other is {
        error "Unexpected message for adaptor ToDashboardService"
      }
    } with {
      briefly "to dashboard service"
      described as {
        |Carries messages to the external DashboardService.
      }
    }
  } with {
    briefly "DashboardService integration"
    described as {
      |The model's side of the DashboardService conversation.
    }
  }
  adaptor FromDistributedTracingService from context DistributedTracingService is { 
    handler FromDistributedTracingServiceHandler is {
      on event DistributedTracingService.SpansIngested is {
        do "the model receives spans ingested"
      }
      on result DistributedTracingService.TraceSearchResult is {
        do "the model receives trace search result"
      }
      on other is {
        error "Unexpected message for adaptor FromDistributedTracingService"
      }
    } with {
      briefly "from distributed tracing service"
      described as {
        |Carries messages from the external DistributedTracingService.
      }
    }
  } with {
    briefly "DistributedTracingService integration"
    described as {
      |The model's side of the DistributedTracingService conversation.
    }
  }
  adaptor ToDistributedTracingService to context DistributedTracingService is { 
    handler ToDistributedTracingServiceHandler is {
      on query DistributedTracingService.GetTrace is {
        do "the model sends get trace"
      }
      on command DistributedTracingService.IngestSpans is {
        do "the model sends ingest spans"
      }
      on query DistributedTracingService.SearchTraces is {
        do "the model sends search traces"
      }
      on other is {
        error "Unexpected message for adaptor ToDistributedTracingService"
      }
    } with {
      briefly "to distributed tracing service"
      described as {
        |Carries messages to the external DistributedTracingService.
      }
    }
  } with {
    briefly "DistributedTracingService integration"
    described as {
      |The model's side of the DistributedTracingService conversation.
    }
  }
  adaptor FromLogAggregationService from context LogAggregationService is { 
    handler FromLogAggregationServiceHandler is {
      on result LogAggregationService.LogSearchResult is {
        do "the model receives log search result"
      }
      on event LogAggregationService.LogsIngested is {
        do "the model receives logs ingested"
      }
      on other is {
        error "Unexpected message for adaptor FromLogAggregationService"
      }
    } with {
      briefly "from log aggregation service"
      described as {
        |Carries messages from the external LogAggregationService.
      }
    }
  } with {
    briefly "LogAggregationService integration"
    described as {
      |The model's side of the LogAggregationService conversation.
    }
  }
  adaptor ToLogAggregationService to context LogAggregationService is { 
    handler ToLogAggregationServiceHandler is {
      on command LogAggregationService.IngestLogs is {
        do "the model sends ingest logs"
      }
      on query LogAggregationService.SearchLogs is {
        do "the model sends search logs"
      }
      on other is {
        error "Unexpected message for adaptor ToLogAggregationService"
      }
    } with {
      briefly "to log aggregation service"
      described as {
        |Carries messages to the external LogAggregationService.
      }
    }
  } with {
    briefly "LogAggregationService integration"
    described as {
      |The model's side of the LogAggregationService conversation.
    }
  }
  adaptor FromMetricsCollectionService from context MetricsCollectionService is { 
    handler FromMetricsCollectionServiceHandler is {
      on result MetricsCollectionService.MetricQueryResult is {
        do "the model receives metric query result"
      }
      on event MetricsCollectionService.MetricsIngested is {
        do "the model receives metrics ingested"
      }
      on other is {
        error "Unexpected message for adaptor FromMetricsCollectionService"
      }
    } with {
      briefly "from metrics collection service"
      described as {
        |Carries messages from the external MetricsCollectionService.
      }
    }
  } with {
    briefly "MetricsCollectionService integration"
    described as {
      |The model's side of the MetricsCollectionService conversation.
    }
  }
  adaptor ToMetricsCollectionService to context MetricsCollectionService is { 
    handler ToMetricsCollectionServiceHandler is {
      on command MetricsCollectionService.IngestMetrics is {
        do "the model sends ingest metrics"
      }
      on query MetricsCollectionService.QueryMetrics is {
        do "the model sends query metrics"
      }
      on other is {
        error "Unexpected message for adaptor ToMetricsCollectionService"
      }
    } with {
      briefly "to metrics collection service"
      described as {
        |Carries messages to the external MetricsCollectionService.
      }
    }
  } with {
    briefly "MetricsCollectionService integration"
    described as {
      |The model's side of the MetricsCollectionService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationFailed is {
        do "the model receives notification failed"
      }
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendAlertNotification is {
        do "the model sends send alert notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "Alert.riddl"
  // Repository for alert persistence
  repository AlertRepository as merge is {
    inlet AlertRepositoryFromAlert is type AlertEvent    inlet AlertRepositoryFromObservabilityAnalytics is type AlertEvent    outlet AlertRepositoryResponses is type Alert.AlertResult
    record StoredAlert is  {
      alertId: AlertId with {
        briefly "alertId"
        described as {
          |The alertId column of the stored alert row.
        }
      }
      rule: AlertRule with {
        briefly "rule"
        described as {
          |The rule column of the stored alert row.
        }
      }
    } with {
      briefly "Stored alert row"
      described as {
        |The persistence shape of alert data as this repository stores it.
      }
    }
    schema AlertData is relational
      of alerts as type StoredAlert
        index on field StoredAlert.alertId
        index on field StoredAlert.rule.severity
 with {
      briefly "Alert data schema"
      described as {
        |The relational schema holding alert data for the AlertRepository.
      }
    }
    handler AlertPersistence is {
      on query GetObservabilityStats is {
        do "read the observability stats projection"
        reply result ObservabilityStatsView
      }
      on command Alert.CreateAlert is {
        tell event Alert.AlertCreated to entity AlertContext.Alert
        do "Store new alert"
      }
      on command Alert.AcknowledgeAlert is {
        tell event Alert.AlertAcknowledged to entity AlertContext.Alert
        do "Update acknowledgment status"
      }
      on command Alert.ResolveAlert is {
        do "Update to resolved"
      }
      on command Alert.SilenceAlert is {
        do "Update silence status"
      }
      on command Alert.EscalateAlert is {
        do "Update escalation level"
      }
      on command Alert.AddComment is {
        tell event Alert.CommentAdded to entity AlertContext.Alert
        do "Store alert comment"
      }
      on command Alert.ExpireAlert is {
        do "Update to expired"
      }
    } with {
      briefly "Persists alert commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Alert data persistence"
    described as {
      | The AlertRepository provides persistent storage for
      | alerts, comments, and resolution history.
    }
  }
  // Projector for observability analytics
  query GetObservabilityStats is  {
    observabilityStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which observability stats to retrieve.
      }
    }
  } with {
    briefly "Get observability stats"
    described as {
      |Retrieves the observability stats projection.
    }
  }
  result ObservabilityStatsView is  {
    observabilityStats: ObservabilityAnalytics.ObservabilityStats with {
      briefly "Observability stats"
      described as {
        |The observability stats being returned.
      }
    }
  } with {
    briefly "Observability stats view"
    described as {
      |Read model view carrying the observability stats projection.
    }
  }
  projector ObservabilityAnalytics as flow is {
    updates repository AlertContext.AlertRepository
    inlet ObservabilityAnalyticsFromAlert is type AlertEvent    outlet ObservabilityAnalyticsOut is type AlertEvent
    record ObservabilityStats is  {
      activeAlerts: Natural with {
        briefly "Active"
        described as {
          |Active alerts.
        }
      }
      criticalAlerts: Natural with {
        briefly "Critical"
        described as {
          |Critical alerts.
        }
      }
      alertsToday: Natural with {
        briefly "Today"
        described as {
          |Alerts fired today.
        }
      }
      mttr: Natural with {
        briefly "MTTR"
        described as {
          |Mean time to resolve (minutes).
        }
      }
      acknowledgeRate: Decimal(5,4) with {
        briefly "Ack rate"
        described as {
          |Acknowledgment rate.
        }
      }
    } with {
      briefly "Observability statistics"
      described as {
        |Alert and incident metrics.
      }
    }
    handler AnalyticsHandler is {
      on alertCreated: event Alert.AlertCreated is {
        tell alertCreated to repository AlertContext.AlertRepository
        do "Update alert counts"
      }
      on alertAcknowledged: event Alert.AlertAcknowledged is {
        tell alertAcknowledged to repository AlertContext.AlertRepository
        do "Update ack metrics"
      }
      on alertResolved: event Alert.AlertResolved is {
        tell alertResolved to repository AlertContext.AlertRepository
        do "Update resolution metrics"
      }
    } with {
      briefly "Maintains observability analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Observability analytics projections"
    described as {
      |Maintains alert and incident analytics data.
    }
  }
  // ---- Event publication for Alert ----
  type AlertEvent is one of {
    AlertContext.Alert.AlertCreated or AlertContext.Alert.AlertAcknowledged or AlertContext.Alert.AlertResolved or AlertContext.Alert.AlertSilenced or AlertContext.Alert.AlertEscalated or AlertContext.Alert.CommentAdded or AlertContext.Alert.AlertExpired
  } with {
    briefly "Alert event alternation"
    described as {
      |Union of all Alert events, for streaming and event-sourced
      |persistence.
    }
  }
  processor AlertEventSource as source is {
    outlet AlertEvents is type AlertEvent
    handler AlertSourceHandler is {
      on alertCreated: event Alert.AlertCreated is {
        send alertCreated to outlet AlertEvents
      }
      on alertAcknowledged: event Alert.AlertAcknowledged is {
        send alertAcknowledged to outlet AlertEvents
      }
      on alertResolved: event Alert.AlertResolved is {
        send alertResolved to outlet AlertEvents
      }
      on alertSilenced: event Alert.AlertSilenced is {
        send alertSilenced to outlet AlertEvents
      }
      on alertEscalated: event Alert.AlertEscalated is {
        send alertEscalated to outlet AlertEvents
      }
      on commentAdded: event Alert.CommentAdded is {
        send commentAdded to outlet AlertEvents
      }
      on alertExpired: event Alert.AlertExpired is {
        send alertExpired to outlet AlertEvents
      }
      on other is {
        error "Unexpected message for source AlertEventSource"
      }
    } with {
      briefly "Alert source handler"
      described as {
        |Publishes Alert events onto the outlet.
      }
    }
  } with {
    briefly "Alert event source"
    described as {
      |Publishes Alert entity events into the streaming topology.
    }
  }
  processor AlertEventSink as sink is {
    inlet AlertInlet is type AlertEvent    handler AlertSinkHandler is {
      on alertCreated: event Alert.AlertCreated is {
        tell alertCreated to repository AlertContext.AlertRepository
      }
      on alertAcknowledged: event Alert.AlertAcknowledged is {
        tell alertAcknowledged to repository AlertContext.AlertRepository
      }
      on alertResolved: event Alert.AlertResolved is {
        tell alertResolved to repository AlertContext.AlertRepository
      }
      on alertSilenced: event Alert.AlertSilenced is {
        tell alertSilenced to repository AlertContext.AlertRepository
      }
      on alertEscalated: event Alert.AlertEscalated is {
        tell alertEscalated to repository AlertContext.AlertRepository
      }
      on commentAdded: event Alert.CommentAdded is {
        tell commentAdded to repository AlertContext.AlertRepository
      }
      on alertExpired: event Alert.AlertExpired is {
        tell alertExpired to repository AlertContext.AlertRepository
      }
      on other is {
        error "Unexpected message for sink AlertEventSink"
      }
    } with {
      briefly "Alert sink handler"
      described as {
        |Persists Alert events via the repository.
      }
    }
  } with {
    briefly "Alert event sink"
    described as {
      |Receives Alert events for persistence.
    }
  }
  connector AlertEventFlow is from outlet AlertContext.AlertEventSource.AlertEvents to inlet AlertContext.AlertEventSink.AlertInlet with {
    briefly "Alert event flow"
    described as {
      |Connects the Alert source to its sink.
    }
  }
  processor AlertEventSplit as split is {
    inlet AlertEventSplitIn is type AlertEvent    outlet AlertEventSplitToAlertRepository is type AlertEvent
    outlet AlertEventSplitToObservabilityAnalytics is type AlertEvent
    handler AlertEventSplitHandler is {
      on alertCreated: event Alert.AlertCreated is {
        send alertCreated to outlet AlertEventSplitToAlertRepository
        send alertCreated to outlet AlertEventSplitToObservabilityAnalytics
        tell alertCreated to entity AlertContext.Alert
      }
      on alertAcknowledged: event Alert.AlertAcknowledged is {
        send alertAcknowledged to outlet AlertEventSplitToAlertRepository
        send alertAcknowledged to outlet AlertEventSplitToObservabilityAnalytics
        tell alertAcknowledged to entity AlertContext.Alert
      }
      on alertResolved: event Alert.AlertResolved is {
        send alertResolved to outlet AlertEventSplitToAlertRepository
        send alertResolved to outlet AlertEventSplitToObservabilityAnalytics
        tell alertResolved to entity AlertContext.Alert
      }
      on alertSilenced: event Alert.AlertSilenced is {
        send alertSilenced to outlet AlertEventSplitToAlertRepository
        send alertSilenced to outlet AlertEventSplitToObservabilityAnalytics
        tell alertSilenced to entity AlertContext.Alert
      }
      on alertEscalated: event Alert.AlertEscalated is {
        send alertEscalated to outlet AlertEventSplitToAlertRepository
        send alertEscalated to outlet AlertEventSplitToObservabilityAnalytics
        tell alertEscalated to entity AlertContext.Alert
      }
      on commentAdded: event Alert.CommentAdded is {
        send commentAdded to outlet AlertEventSplitToAlertRepository
        send commentAdded to outlet AlertEventSplitToObservabilityAnalytics
        tell commentAdded to entity AlertContext.Alert
      }
      on alertExpired: event Alert.AlertExpired is {
        send alertExpired to outlet AlertEventSplitToAlertRepository
        send alertExpired to outlet AlertEventSplitToObservabilityAnalytics
        tell alertExpired to entity AlertContext.Alert
      }
      on other is {
        error "Unexpected message for processor AlertEventSplit"
      }
    } with {
      briefly "Alert event fan-out handler"
      described as {
        |Delivers each Alert event to all of its consumers.
      }
    }
  } with {
    briefly "Alert event fan-out"
    described as {
      |Fans Alert events out to the repository and projectors.
    }
  }
  connector 'AlertEvent Stream' is from outlet AlertContext.Alert.AlertEvents2 to inlet AlertContext.AlertEventSplit.AlertEventSplitIn with {
    briefly "Alert events, fanned out to storage and read models"
  }
  connector 'AlertEvent Storage' is from outlet AlertContext.AlertEventSplit.AlertEventSplitToAlertRepository to inlet AlertContext.AlertRepository.AlertRepositoryFromAlert with {
    briefly "Alert events on their way to storage"
  }
  connector 'ObservabilityAnalytics Feed' is from outlet AlertContext.AlertEventSplit.AlertEventSplitToObservabilityAnalytics to inlet AlertContext.ObservabilityAnalytics.ObservabilityAnalyticsFromAlert with {
    briefly "Alert events feeding the ObservabilityAnalytics projection"
  }
  connector 'ObservabilityAnalytics Storage' is from outlet AlertContext.ObservabilityAnalytics.ObservabilityAnalyticsOut to inlet AlertContext.AlertRepository.AlertRepositoryFromObservabilityAnalytics with {
    briefly "The ObservabilityAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for alerting"
  described as {
    | The AlertContext is the bounded context for
    | alert management and incident tracking.
  }
}
