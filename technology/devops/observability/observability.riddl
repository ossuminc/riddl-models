// Observability Domain Model
// Monitoring, logging, tracing, and alerting
domain Observability is {
  persistent connector 'MetricsCollectionServiceReply Stream' is from outlet MetricsCollectionService.MetricsCollectionServiceRepliesOut to inlet AlertContext.ToMetricsCollectionService.ToMetricsCollectionServiceReplies with {
    briefly "What MetricsCollectionService answers AlertContext"
  }
  persistent connector 'LogAggregationServiceReply Stream' is from outlet LogAggregationService.LogAggregationServiceRepliesOut to inlet AlertContext.ToLogAggregationService.ToLogAggregationServiceReplies with {
    briefly "What LogAggregationService answers AlertContext"
  }
  persistent connector 'DistributedTracingServiceReply Stream' is from outlet DistributedTracingService.DistributedTracingServiceRepliesOut to inlet AlertContext.ToDistributedTracingService.ToDistributedTracingServiceReplies with {
    briefly "What DistributedTracingService answers AlertContext"
  }
  persistent connector 'DashboardServiceReply Stream' is from outlet DashboardService.DashboardServiceRepliesOut to inlet AlertContext.ToDashboardService.ToDashboardServiceReplies with {
    briefly "What DashboardService answers AlertContext"
  }
  persistent connector 'DashboardServiceEvent Stream' is from outlet DashboardService.DashboardServiceEventsOut to inlet AlertContext.FromDashboardService.FromDashboardServiceIn with {
    briefly "What DashboardService tells AlertContext, unasked"
  }
  persistent connector 'DistributedTracingServiceEvent Stream' is from outlet DistributedTracingService.DistributedTracingServiceEventsOut to inlet AlertContext.FromDistributedTracingService.FromDistributedTracingServiceIn with {
    briefly "What DistributedTracingService tells AlertContext, unasked"
  }
  persistent connector 'LogAggregationServiceEvent Stream' is from outlet LogAggregationService.LogAggregationServiceEventsOut to inlet AlertContext.FromLogAggregationService.FromLogAggregationServiceIn with {
    briefly "What LogAggregationService tells AlertContext, unasked"
  }
  persistent connector 'MetricsCollectionServiceEvent Stream' is from outlet MetricsCollectionService.MetricsCollectionServiceEventsOut to inlet AlertContext.FromMetricsCollectionService.FromMetricsCollectionServiceIn with {
    briefly "What MetricsCollectionService tells AlertContext, unasked"
  }
  persistent connector 'NotificationServiceEvent Stream' is from outlet NotificationService.NotificationServiceEventsOut to inlet AlertContext.FromNotificationService.FromNotificationServiceIn with {
    briefly "What NotificationService tells AlertContext, unasked"
  }
  persistent connector 'MetricsCollectionServiceRequest Stream' is from outlet AlertContext.ToMetricsCollectionService.ToMetricsCollectionServiceOut to inlet MetricsCollectionService.MetricsCollectionServiceRequests with {
    briefly "What AlertContext asks MetricsCollectionService to send"
  }
  persistent connector 'LogAggregationServiceRequest Stream' is from outlet AlertContext.ToLogAggregationService.ToLogAggregationServiceOut to inlet LogAggregationService.LogAggregationServiceRequests with {
    briefly "What AlertContext asks LogAggregationService to send"
  }
  persistent connector 'DistributedTracingServiceRequest Stream' is from outlet AlertContext.ToDistributedTracingService.ToDistributedTracingServiceOut to inlet DistributedTracingService.DistributedTracingServiceRequests with {
    briefly "What AlertContext asks DistributedTracingService to send"
  }
  persistent connector 'DashboardServiceRequest Stream' is from outlet AlertContext.ToDashboardService.ToDashboardServiceOut to inlet DashboardService.DashboardServiceRequests with {
    briefly "What AlertContext asks DashboardService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet AlertContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What AlertContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user SREEngineer is "person managing system reliability" with {
    briefly "SRE Engineer"
    described as {
      |Person ensuring system reliability.
    }
  }
  user Developer is "person debugging applications" with {
    briefly "Developer"
    described as {
      |Person investigating issues.
    }
  }
  user OnCallEngineer is "person responding to alerts" with {
    briefly "On-Call Engineer"
    described as {
      |Person handling incidents.
    }
  }
  epic ObservabilityEpic is {
    user SREEngineer wants to "to monitor system health" so that "issues are detected and resolved quickly"
    case InvestigateIncident is {
      user OnCallEngineer wants to "to investigate an alert" so that "the root cause is identified"
      step is "Engineer receives" "alert notification" "for anomaly" with {
        briefly "Receive alert"
        described as {
          |Get alert notification.
        }
      }
      step is "Engineer queries" "metrics and logs" "for context" with {
        briefly "Query data"
        described as {
          |Gather observability data.
        }
      }
      step take input ObservabilityApp.ObservabilityScreen.AcknowledgeAlertInput from user OnCallEngineer with {
        briefly "Acknowledge alert"
        described as {
          |Claim the alert.
        }
      }
      step is "Engineer traces" "request flow" "to identify issue" with {
        briefly "Trace request"
        described as {
          |Follow distributed trace.
        }
      }
    } with {
      briefly "Incident investigation"
      described as {
        |Investigating and resolving alerts.
      }
    }
  } with {
    briefly "Observability management"
    described as {
      | Epic covering monitoring, alerting,
      | and incident investigation workflows.
    }
  }
  include "AlertContext.riddl"
  include "external-contexts.riddl"
  application context ObservabilityApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in Observability are delivered.
      }
    }
    group ObservabilityScreen is {
      input AcknowledgeAlertInput acquires command AlertContext.Alert.AcknowledgeAlert with {
        briefly "Acknowledge alert control"
        described as {
          |The control through which a user submits the acknowledge alert request.
        }
      }
    } with {
      briefly "Observability screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppAlertCommands is type AlertContext.Alert.AlertCommand
    inlet AppAlertRepositoryResponses is result AlertContext.Alert.AlertResult    handler ObservabilityAppHandler is {
      on other is {
        error "Unexpected message for application context ObservabilityApp"
      }
    } with {
      briefly "ObservabilityApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ObservabilityApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'AlertCommand Stream' is from outlet ObservabilityApp.AppAlertCommands to inlet AlertContext.AlertCommandStreamIn with {
    briefly "Alert commands from the application"
  }
  persistent connector 'AlertResult Stream' is from outlet AlertContext.AlertResultStreamOut to inlet ObservabilityApp.AppAlertRepositoryResponses with {
    briefly "Alert query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ObservabilityApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Observability domain"
  described as {
    | The Observability domain handles monitoring,
    | logging, tracing, and alerting for systems.
  }
}
