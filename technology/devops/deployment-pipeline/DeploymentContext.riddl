// Deployment Context - Bounded context for deployment management
context DeploymentContext as router is {
  command RegisterEnvironment yields event Environment.EnvironmentRegistered is {
    name: String(1,100) with {
      briefly "Environment name"
      described as {
        |Human-readable name for the environment.
      }
    }
    environmentType: EnvironmentType with {
      briefly "Environment type"
      described as {
        |Classification of the environment.
      }
    }
    clusterEndpoint: URL with {
      briefly "Cluster endpoint"
      described as {
        |URL of the deployment cluster.
      }
    }
  } with {
    briefly "Registers a new deployment environment"
    described as {
      |Creates a new environment that can be targeted by deployments.
    }
  }
  type EnvironmentRequest is one of {
    DeploymentContext.RegisterEnvironment or Environment.EnvironmentCommand
  } with {
    briefly "Environment requests"
    described as {
      |What may be asked of DeploymentContext about a Environment: RegisterEnvironment, which the
      |context does itself by creating one, or any command for an existing one.
    }
  }
  command InitiateDeployment yields event Deployment.DeploymentInitiated is {
    artifactId: ArtifactId with {
      briefly "Artifact reference"
      described as {
        |The artifact to be deployed.
      }
    }
    targetEnvironment: EnvironmentId with {
      briefly "Target environment"
      described as {
        |The environment where the artifact will be deployed.
      }
    }
    deploymentStrategy: DeploymentStrategy with {
      briefly "Deployment strategy"
      described as {
        |How the deployment should be executed.
      }
    }
    healthCheckUrl: URL with {
      briefly "Health check URL"
      described as {
        |Endpoint to verify deployment health.
      }
    }
    timeoutMinutes: Integer with {
      briefly "Timeout"
      described as {
        |Maximum time allowed for deployment in minutes.
      }
    }
    requiresApproval: Boolean with {
      briefly "Requires approval"
      described as {
        |Whether manual approval is needed before execution.
      }
    }
    initiatedBy: String(1,100) with {
      briefly "Initiated by"
      described as {
        |User or system that initiated the deployment.
      }
    }
  } with {
    briefly "Initiates a new deployment request"
    described as {
      | Creates a new deployment with the specified configuration. If the
      | target environment requires approval, the deployment enters the
      | AwaitingApproval state; otherwise it proceeds directly to execution.
    }
  }
  type DeploymentRequest is one of {
    DeploymentContext.InitiateDeployment or Deployment.DeploymentCommand
  } with {
    briefly "Deployment requests"
    described as {
      |What may be asked of DeploymentContext about a Deployment: InitiateDeployment, which the
      |context does itself by creating one, or any command for an existing one.
    }
  }
  inlet DeploymentRepositoryQueriesIn is type DeploymentRepository.DeploymentRepositoryQuery with {
    briefly "Look-ups of the deployment repository"
    described as {
      |DeploymentPipelineApp's look-ups, on their way to the deployment repository.
    }
  }
  outlet DeploymentRepositoryQueriesOut is type DeploymentRepository.DeploymentRepositoryQuery
 with {
    briefly "Look-ups on their way to the deployment repository"
    described as {
      |Each look-up goes to the deployment repository it names.
    }
  }
  inlet DeploymentRepositoryRepliesIn is type DeploymentRepository.DeploymentRepositoryReply with {
    briefly "The deployment repository's answers"
    described as {
      |What the deployment repository answers about itself.
    }
  }
  outlet DeploymentRepositoryRepliesOut is type DeploymentRepository.DeploymentRepositoryReply
 with {
    briefly "Answers to DeploymentPipelineApp"
    described as {
      |The reply leg of DeploymentPipelineApp's look-ups of the deployment repository.
    }
  }
  inlet EnvironmentQueriesIn is query Environment.GetEnvironment with {
    briefly "Look-ups of the environment"
    described as {
      |DeploymentPipelineApp's look-ups, on their way to the environment.
    }
  }
  outlet EnvironmentQueriesOut is query Environment.GetEnvironment
 with {
    briefly "Look-ups on their way to the environment"
    described as {
      |Each look-up goes to the environment it names.
    }
  }
  inlet EnvironmentRepliesIn is result Environment.EnvironmentResult with {
    briefly "The environment's answers"
    described as {
      |What the environment answers about itself.
    }
  }
  outlet EnvironmentRepliesOut is result Environment.EnvironmentResult
 with {
    briefly "Answers to DeploymentPipelineApp"
    described as {
      |The reply leg of DeploymentPipelineApp's look-ups of the environment.
    }
  }
  inlet DeploymentQueriesIn is query Deployment.GetDeployment with {
    briefly "Look-ups of the deployment"
    described as {
      |DeploymentPipelineApp's look-ups, on their way to the deployment.
    }
  }
  outlet DeploymentQueriesOut is query Deployment.GetDeployment
 with {
    briefly "Look-ups on their way to the deployment"
    described as {
      |Each look-up goes to the deployment it names.
    }
  }
  type FromInfrastructureServiceCommand is one of {
    Deployment.FailDeployment or Environment.UpdateEnvironmentArtifact
  } with {
    briefly "What FromInfrastructureService turns that service's news into"
  }
  inlet DeploymentContextFromInfrastructureService is type DeploymentContext.FromInfrastructureServiceCommand with {
    briefly "What FromInfrastructureService makes of that service's news"
  }
  connector 'DeploymentRepositoryQuery Intake' is from outlet DeploymentContext.DeploymentRepositoryQueriesOut to inlet DeploymentContext.DeploymentRepository.DeploymentRepositoryQueries with {
    briefly "Look-ups on their way to the deployment repository"
  }
  connector 'DeploymentRepositoryReply Egress' is from outlet DeploymentContext.DeploymentRepository.DeploymentRepositoryResponses to inlet DeploymentContext.DeploymentRepositoryRepliesIn with {
    briefly "The deployment repository's answers on their way to the boundary"
  }
  connector 'EnvironmentQuery Intake' is from outlet DeploymentContext.EnvironmentQueriesOut to inlet DeploymentContext.Environment.EnvironmentQueries with {
    briefly "Look-ups on their way to the environment"
  }
  connector 'EnvironmentReply Egress' is from outlet DeploymentContext.Environment.EnvironmentReplies to inlet DeploymentContext.EnvironmentRepliesIn with {
    briefly "The environment's answers on their way to the boundary"
  }
  connector 'DeploymentQuery Intake' is from outlet DeploymentContext.DeploymentQueriesOut to inlet DeploymentContext.Deployment.DeploymentQueries with {
    briefly "Look-ups on their way to the deployment"
  }
  connector 'FromInfrastructureService Intake' is from outlet DeploymentContext.FromInfrastructureService.FromInfrastructureServiceToDeploymentContext to inlet DeploymentContext.DeploymentContextFromInfrastructureService with {
    briefly "What FromInfrastructureService makes of that news, on its way in"
  }
  inlet DeploymentContextFromMonitoringService is command Deployment.VerifyDeployment with {
    briefly "What FromMonitoringService makes of that service's news"
  }
  connector 'FromMonitoringService Intake' is from outlet DeploymentContext.FromMonitoringService.FromMonitoringServiceToDeploymentContext to inlet DeploymentContext.DeploymentContextFromMonitoringService with {
    briefly "What FromMonitoringService makes of that news, on its way in"
  }
  inlet DeploymentCommandStreamIn is type DeploymentContext.DeploymentRequest
  outlet DeploymentCommandStreamOut is type DeploymentCommand
  inlet EnvironmentCommandStreamIn is type DeploymentContext.EnvironmentRequest
  outlet EnvironmentCommandStreamOut is type EnvironmentCommand
  inlet DeploymentQueryResultStreamIn is result Deployment.DeploymentQueryResult
  outlet DeploymentQueryResultStreamOut is result Deployment.DeploymentQueryResult
  handler DeploymentContextBoundary is {
    on getDeploymentMetricsSummary: query GetDeploymentMetricsSummary is {
      forward getDeploymentMetricsSummary to outlet DeploymentContext.DeploymentRepositoryQueriesOut
    }
    on findDeploymentById: query DeploymentRepository.FindDeploymentById is {
      forward findDeploymentById to outlet DeploymentContext.DeploymentRepositoryQueriesOut
    }
    on findDeploymentsByEnvironment: query DeploymentRepository.FindDeploymentsByEnvironment is {
      forward findDeploymentsByEnvironment to outlet DeploymentContext.DeploymentRepositoryQueriesOut
    }
    on findDeploymentsByStatus: query DeploymentRepository.FindDeploymentsByStatus is {
      forward findDeploymentsByStatus to outlet DeploymentContext.DeploymentRepositoryQueriesOut
    }
    on findRecentDeployments: query DeploymentRepository.FindRecentDeployments is {
      forward findRecentDeployments to outlet DeploymentContext.DeploymentRepositoryQueriesOut
    }
    on deploymentMetricsSummaryView: result DeploymentMetricsSummaryView is {
      send deploymentMetricsSummaryView to outlet DeploymentContext.DeploymentRepositoryRepliesOut
    }
    on deploymentListResult: result DeploymentRepository.DeploymentListResult is {
      send deploymentListResult to outlet DeploymentContext.DeploymentRepositoryRepliesOut
    }
    on deploymentResult: result DeploymentRepository.DeploymentResult is {
      send deploymentResult to outlet DeploymentContext.DeploymentRepositoryRepliesOut
    }
    on getEnvironment: query Environment.GetEnvironment is {
      forward getEnvironment to outlet DeploymentContext.EnvironmentQueriesOut
    }
    on environmentResult: result Environment.EnvironmentResult is {
      send environmentResult to outlet DeploymentContext.EnvironmentRepliesOut
    }
    on getDeployment: query Deployment.GetDeployment is {
      forward getDeployment to outlet DeploymentContext.DeploymentQueriesOut
    }
    on initiateDeployment: command DeploymentContext.InitiateDeployment is {
      let givenInitiatedAt: type TimeStamp = prompt("the initiated at of this deployment initiated")
      let newDeployment = create entity DeploymentContext.Deployment(artifactId = initiateDeployment.artifactId, targetEnvironment = initiateDeployment.targetEnvironment, initiatedBy = initiateDeployment.initiatedBy, initiatedAt = givenInitiatedAt, deploymentStrategy = initiateDeployment.deploymentStrategy, healthCheckUrl = initiateDeployment.healthCheckUrl, timeoutMinutes = initiateDeployment.timeoutMinutes, requiresApproval = initiateDeployment.requiresApproval)
    }
    on approveDeployment: command Deployment.ApproveDeployment is {
      forward approveDeployment to outlet DeploymentContext.DeploymentCommandStreamOut
    }
    on executeDeployment: command Deployment.ExecuteDeployment is {
      forward executeDeployment to outlet DeploymentContext.DeploymentCommandStreamOut
    }
    on verifyDeployment: command Deployment.VerifyDeployment is {
      forward verifyDeployment to outlet DeploymentContext.DeploymentCommandStreamOut
    }
    on completeDeployment: command Deployment.CompleteDeployment is {
      forward completeDeployment to outlet DeploymentContext.DeploymentCommandStreamOut
    }
    on requestDeploymentApproval: command Deployment.RequestDeploymentApproval is {
      forward requestDeploymentApproval to outlet DeploymentContext.DeploymentCommandStreamOut
    }
    on failDeployment: command Deployment.FailDeployment is {
      forward failDeployment to outlet DeploymentContext.DeploymentCommandStreamOut
    }
    on rollbackDeployment: command Deployment.RollbackDeployment is {
      forward rollbackDeployment to outlet DeploymentContext.DeploymentCommandStreamOut
    }
    on registerEnvironment: command DeploymentContext.RegisterEnvironment is {
      let environmentRegisteredAt: type TimeStamp = system.now
      let newEnvironment = create entity DeploymentContext.Environment(name = registerEnvironment.name, environmentType = registerEnvironment.environmentType, clusterEndpoint = registerEnvironment.clusterEndpoint, registeredAt = environmentRegisteredAt)
      yield event Environment.EnvironmentRegistered(environmentId = newEnvironment, name = registerEnvironment.name, environmentType = registerEnvironment.environmentType, registeredAt = environmentRegisteredAt)
    }
    on updateEnvironmentArtifact: command Environment.UpdateEnvironmentArtifact is {
      forward updateEnvironmentArtifact to outlet DeploymentContext.EnvironmentCommandStreamOut
    }
    on deploymentQueryResult: result Deployment.DeploymentQueryResult is {
      send deploymentQueryResult to outlet DeploymentContext.DeploymentQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the DeploymentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'DeploymentCommand Stream Intake' is from outlet DeploymentContext.DeploymentCommandStreamOut to inlet DeploymentContext.Deployment.DeploymentCommands
  connector 'EnvironmentCommand Stream Intake' is from outlet DeploymentContext.EnvironmentCommandStreamOut to inlet DeploymentContext.Environment.EnvironmentCommands
  connector 'DeploymentQueryResult Stream Egress' is from outlet DeploymentContext.Deployment.DeploymentReplies to inlet DeploymentContext.DeploymentQueryResultStreamIn
  adaptor FromArtifactRegistry from context ArtifactRegistry as sink is { 
    inlet FromArtifactRegistryIn is type ArtifactRegistry.ArtifactRegistryEvent
    handler FromArtifactRegistryHandler is {
      on artifactFetched: event ArtifactRegistry.ArtifactFetched is {
        do "the artifact is in hand; the rollout uses it"
      }
      on artifactValidated: event ArtifactRegistry.ArtifactValidated is {
        do "the artifact checks out; approval is still a person's decision"
      }
      on other is {
        error "Unexpected message for adaptor FromArtifactRegistry"
      }
    } with {
      briefly "from artifact registry"
      described as {
        |Carries messages from the external ArtifactRegistry.
      }
    }
  } with {
    briefly "ArtifactRegistry integration"
    described as {
      |The model's side of the ArtifactRegistry conversation.
    }
  }
  adaptor ToArtifactRegistry to context ArtifactRegistry as flow is { 
    inlet ToArtifactRegistryIn is type DeploymentEvent
    outlet ToArtifactRegistryOut is type ArtifactRegistry.ArtifactRegistryCommand
    handler ToArtifactRegistryHandler is {
      on deploymentInitiated: event Deployment.DeploymentInitiated is {
        let item0: type ArtifactRegistry.ValidateArtifact = prompt("translate the deploymentInitiated event into a ValidateArtifact, an artifact being unfit to approve before it is known intact")
        send item0 to outlet DeploymentContext.ToArtifactRegistry.ToArtifactRegistryOut
      }
      on deploymentStarted: event Deployment.DeploymentStarted is {
        send command ArtifactRegistry.FetchArtifact(artifactId = deploymentStarted.artifactId) to outlet DeploymentContext.ToArtifactRegistry.ToArtifactRegistryOut
      }
      on other is {
        error "Unexpected message for adaptor ToArtifactRegistry"
      }
    } with {
      briefly "to artifact registry"
      described as {
        |Carries messages to the external ArtifactRegistry.
      }
    }
  } with {
    briefly "ArtifactRegistry integration"
    described as {
      |The model's side of the ArtifactRegistry conversation.
    }
  }
  adaptor FromInfrastructureService from context InfrastructureService as merge is { 
    inlet DeploymentAnswers is event Deployment.DeploymentFailed
    inlet EnvironmentAnswers is event Environment.EnvironmentArtifactUpdated
    inlet FromInfrastructureServiceIn is type InfrastructureService.InfrastructureServiceEvent
    outlet FromInfrastructureServiceToDeploymentContext is type DeploymentContext.FromInfrastructureServiceCommand
    handler FromInfrastructureServiceHandler is {
      on infrastructureDeploymentCompleted: event InfrastructureService.InfrastructureDeploymentCompleted is {
        do "the rollout is on the infrastructure; verification follows the health check"
        let updateEnvironmentArtifact: type Environment.UpdateEnvironmentArtifact = prompt("the artifact now deployed to the environment the rollout landed on")
        send updateEnvironmentArtifact to outlet DeploymentContext.FromInfrastructureService.FromInfrastructureServiceToDeploymentContext
      }
      on infrastructureDeploymentFailed: event InfrastructureService.InfrastructureDeploymentFailed is {
        send command Deployment.FailDeployment(deploymentId = prompt("the Deployment whose rollout infrastructureDeploymentFailed.deploymentId names"), failureReason = infrastructureDeploymentFailed.errorMessage) to outlet DeploymentContext.FromInfrastructureService.FromInfrastructureServiceToDeploymentContext
      }
      on infrastructureDeploymentStarted: event InfrastructureService.InfrastructureDeploymentStarted is {
        do "the infrastructure is rolling out; executing was recorded here"
      }
      on deploymentFailed: event Deployment.DeploymentFailed is {
        log deploymentFailed
      }
      on environmentArtifactUpdated: event Environment.EnvironmentArtifactUpdated is {
        log environmentArtifactUpdated
      }
      on other is {
        error "Unexpected message for adaptor FromInfrastructureService"
      }
    } with {
      briefly "from infrastructure service"
      described as {
        |Carries messages from the external InfrastructureService.
      }
    }
  } with {
    briefly "InfrastructureService integration"
    described as {
      |The model's side of the InfrastructureService conversation.
    }
  }
  adaptor ToInfrastructureService to context InfrastructureService as flow is { 
    inlet ToInfrastructureServiceIn is type DeploymentEvent
    outlet ToInfrastructureServiceOut is type InfrastructureService.InfrastructureServiceCommand
    handler ToInfrastructureServiceHandler is {
      on deploymentStarted: event Deployment.DeploymentStarted is {
        let item0: type InfrastructureService.DeployToInfrastructure = prompt("translate the deploymentStarted event into a DeployToInfrastructure, the start being when the infrastructure is actually asked")
        send item0 to outlet DeploymentContext.ToInfrastructureService.ToInfrastructureServiceOut
      }
      on deploymentVerified: event Deployment.DeploymentVerified is {
        let item0: type InfrastructureService.ScaleDeployment = prompt("translate the deploymentVerified event into a ScaleDeployment, verification being what earns a deployment more capacity")
        send item0 to outlet DeploymentContext.ToInfrastructureService.ToInfrastructureServiceOut
      }
      on deploymentRolledBack: event Deployment.DeploymentRolledBack is {
        let item0: type InfrastructureService.TerminateDeployment = prompt("translate the deploymentRolledBack event into a TerminateDeployment, a rollback leaving the old workload to tear down")
        send item0 to outlet DeploymentContext.ToInfrastructureService.ToInfrastructureServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToInfrastructureService"
      }
    } with {
      briefly "to infrastructure service"
      described as {
        |Carries messages to the external InfrastructureService.
      }
    }
  } with {
    briefly "InfrastructureService integration"
    described as {
      |The model's side of the InfrastructureService conversation.
    }
  }
  adaptor FromMonitoringService from context MonitoringService as merge is { 
    inlet DeploymentAnswers is event Deployment.DeploymentVerified
    inlet FromMonitoringServiceIn is type MonitoringService.MonitoringServiceEvent
    outlet FromMonitoringServiceToDeploymentContext is command Deployment.VerifyDeployment
    handler FromMonitoringServiceHandler is {
      on alertTriggered: event MonitoringService.AlertTriggered is {
        do "an alert fired; whether it is the deployment's fault is the engineer's call"
      }
      on healthCheckCompleted: event MonitoringService.HealthCheckCompleted is {
        let item0: type Deployment.VerifyDeployment = prompt("translate the healthCheckCompleted event into a VerifyDeployment, the health check's outcome is what verifies the deployment")
        send item0 to outlet DeploymentContext.FromMonitoringService.FromMonitoringServiceToDeploymentContext
      }
      on serviceRecovered: event MonitoringService.ServiceRecovered is {
        do "the service is healthy again; the deployment's own state is unchanged"
      }
      on deploymentVerified: event Deployment.DeploymentVerified is {
        log deploymentVerified
      }
      on other is {
        error "Unexpected message for adaptor FromMonitoringService"
      }
    } with {
      briefly "from monitoring service"
      described as {
        |Carries messages from the external MonitoringService.
      }
    }
  } with {
    briefly "MonitoringService integration"
    described as {
      |The model's side of the MonitoringService conversation.
    }
  }
  adaptor ToMonitoringService to context MonitoringService as merge is { 
    inlet ToMonitoringServiceFromDeploymentIn is type DeploymentEvent
    inlet ToMonitoringServiceFromEnvironmentIn is type EnvironmentEvent
    outlet ToMonitoringServiceOut is type MonitoringService.MonitoringServiceCommand
    handler ToMonitoringServiceHandler is {
      on deploymentStarted: event Deployment.DeploymentStarted is {
        let item0: type MonitoringService.CheckServiceHealth = prompt("translate the deploymentStarted event into a CheckServiceHealth, a deployment in flight being what must be watched")
        send item0 to outlet DeploymentContext.ToMonitoringService.ToMonitoringServiceOut
      }
      on environmentRegistered: event Environment.EnvironmentRegistered is {
        let item0: type MonitoringService.ConfigureAlerts = prompt("translate the environmentRegistered event into a ConfigureAlerts, a new environment having no alerting until it is given some")
        send item0 to outlet DeploymentContext.ToMonitoringService.ToMonitoringServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToMonitoringService"
      }
    } with {
      briefly "to monitoring service"
      described as {
        |Carries messages to the external MonitoringService.
      }
    }
  } with {
    briefly "MonitoringService integration"
    described as {
      |The model's side of the MonitoringService conversation.
    }
  }
  type EnvironmentId is Id(DeploymentPipeline.DeploymentContext.Environment)  with {
    briefly "Unique identifier for a deployment environment"
    described as {
      |Identifies a specific deployment target environment.
    }
  }
  type DeploymentId is Id(DeploymentPipeline.DeploymentContext.Deployment)  with {
    briefly "Unique identifier for a deployment"
    described as {
      |A unique identifier that tracks a specific deployment instance.
    }
  }
  include "Deployment.riddl"
  entity Environment as router is {
    type EnvironmentCommand is Environment.UpdateEnvironmentArtifact with {
      briefly "Environment command alternation"
      described as {
        |Commands accepted by the Environment entity.
      }
    }
    type EnvironmentEvent is one of {
      Environment.EnvironmentRegistered or Environment.EnvironmentArtifactUpdated
    } with {
      briefly "Environment event alternation"
      described as {
        |Events published by the Environment entity.
      }
    }
    inlet EnvironmentQueries is query GetEnvironment with {
      briefly "Look-ups of this environment"
      described as {
        |What DeploymentPipelineApp asks of the environment, by way of DeploymentContext.
      }
    }
    outlet EnvironmentReplies is result EnvironmentResult
 with {
      briefly "This environment's answers"
      described as {
        |What the environment answers, on its way back to DeploymentContext.
      }
    }
    inlet EnvironmentCommands is type EnvironmentCommand
    outlet EnvironmentEvents is type EnvironmentEvent
    command UpdateEnvironmentArtifact yields event EnvironmentArtifactUpdated is {
      environmentId: EnvironmentId with {
        briefly "Environment identifier"
        described as {
          |The environment being updated.
        }
      }
      artifactId: ArtifactId with {
        briefly "Artifact identifier"
        described as {
          |The newly deployed artifact.
        }
      }
      deployedAt: TimeStamp with {
        briefly "Deployed at"
        described as {
          |When the artifact was deployed.
        }
      }
    } with {
      briefly "Updates the currently deployed artifact"
      described as {
        |Records the artifact currently deployed to this environment.
      }
    }
    event EnvironmentRegistered is {
      environmentId: EnvironmentId with {
        briefly "Environment identifier"
        described as {
          |The registered environment.
        }
      }
      name: String(1,100) with {
        briefly "Name"
        described as {
          |Environment name.
        }
      }
      environmentType: EnvironmentType with {
        briefly "Type"
        described as {
          |Environment classification.
        }
      }
      registeredAt: TimeStamp with {
        briefly "Registered at"
        described as {
          |When the environment was registered.
        }
      }
    } with {
      briefly "A new environment has been registered"
      described as {
        |Records that a new deployment target environment is available.
      }
    }
    event EnvironmentArtifactUpdated is {
      environmentId: EnvironmentId with {
        briefly "Environment identifier"
        described as {
          |The updated environment.
        }
      }
      artifactId: ArtifactId with {
        briefly "Artifact identifier"
        described as {
          |The deployed artifact.
        }
      }
      deployedAt: TimeStamp with {
        briefly "Deployed at"
        described as {
          |When the artifact was deployed.
        }
      }
    } with {
      briefly "Environment artifact has been updated"
      described as {
        |Records that a new artifact was deployed to an environment.
      }
    }
    record ActiveEnvironmentData is {
      environmentId: EnvironmentId with {
        briefly "ID"
        described as {
          |Environment ID.
        }
      }
      name: String(1,100) with {
        briefly "Name"
        described as {
          |Environment name.
        }
      }
      environmentType: EnvironmentType with {
        briefly "Type"
        described as {
          |Environment type.
        }
      }
      clusterEndpoint: URL with {
        briefly "Endpoint"
        described as {
          |Cluster endpoint.
        }
      }
      currentArtifact: ArtifactId? with {
        briefly "Current artifact"
        described as {
          |Currently deployed artifact.
        }
      }
      lastDeployedAt: TimeStamp? with {
        briefly "Last deployed"
        described as {
          |Last deployment time.
        }
      }
    } with {
      briefly "Active environment data"
      described as {
        |State data for an active environment.
      }
    }
    state Active of record Environment.ActiveEnvironmentData with {
      briefly "Active state"
      described as {
        |The entity in Active state.
      }
    }
    query GetEnvironment replies result EnvironmentResult is {
      environmentId: EnvironmentId with {
        briefly "ID"
        described as {
          |Environment to retrieve.
        }
      }
    } with {
      briefly "Get Environment"
      described as {
        |Retrieves Environment data.
      }
    }
    result EnvironmentResult is {
      environmentId: EnvironmentId with {
        briefly "ID"
        described as {
          |Environment identifier.
        }
      }
    } with {
      briefly "Environment result"
      described as {
        |Environment data result.
      }
    }
    initial handler EnvironmentHandler is {
      on init(name: String(1,100), environmentType: type EnvironmentType, clusterEndpoint: URL("https"), registeredAt: TimeStamp) is {
        morph entity DeploymentContext.Environment to state DeploymentContext.Environment.Active with record Environment.ActiveEnvironmentData(environmentId = self.id, name = name, environmentType = environmentType, clusterEndpoint = clusterEndpoint, currentArtifact = empty, lastDeployedAt = empty)
        yield event EnvironmentRegistered(environmentId = self.id, name = name, environmentType = environmentType, registeredAt = registeredAt)
      }
      on environmentArtifactUpdated: event EnvironmentArtifactUpdated is {
        do "apply EnvironmentArtifactUpdated to the environment so it can be persisted and replayed"
      }
      on environmentRegistered: event EnvironmentRegistered is {
        do "apply EnvironmentRegistered to the environment so it can be persisted and replayed"
      }
      on updateEnvironmentArtifact: command UpdateEnvironmentArtifact is {
        yield event EnvironmentArtifactUpdated(environmentId = updateEnvironmentArtifact.environmentId, artifactId = updateEnvironmentArtifact.artifactId, deployedAt = updateEnvironmentArtifact.deployedAt)
      }
      on getEnvironment: query GetEnvironment is {
        reply result EnvironmentResult(environmentId = getEnvironment.environmentId)
      }
    } with {
      briefly "Handles environment management commands"
      described as {
        |Processes commands for environment registration and updates.
      }
    }
  } with {
    briefly "Entity representing a deployment target environment"
    described as {
      | The Environment entity represents a deployment target such as
      | development, staging, or production. It tracks the currently
      | deployed artifact and environment configuration.
    }
  }
  type DeploymentRepositoryCommand is one of {
    DeploymentContext.DeploymentRepository.PersistDeploymentApproved or DeploymentContext.DeploymentRepository.PersistDeploymentAwaitingApproval or DeploymentContext.DeploymentRepository.PersistDeploymentCompleted or DeploymentContext.DeploymentRepository.PersistDeploymentFailed or DeploymentContext.DeploymentRepository.PersistDeploymentInitiated or DeploymentContext.DeploymentRepository.PersistDeploymentRolledBack or DeploymentContext.DeploymentRepository.PersistDeploymentStarted or DeploymentContext.DeploymentRepository.PersistDeploymentVerified or DeploymentContext.DeploymentRepository.PersistEnvironmentArtifactUpdated or DeploymentContext.DeploymentRepository.PersistEnvironmentRegistered
  } with {
    briefly "Anything that writes DeploymentRepository"
    described as {
      |The persistence commands DeploymentRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository DeploymentRepository as merge is {
    type DeploymentRepositoryQuery is one of {
      GetDeploymentMetricsSummary or FindDeploymentById or FindDeploymentsByEnvironment or FindDeploymentsByStatus or FindRecentDeployments
    } with {
      briefly "What may be asked of DeploymentRepository"
      described as {
        |The look-ups the deployment repository answers.
      }
    }
    type DeploymentRepositoryReply is one of {
      DeploymentMetricsSummaryView or DeploymentListResult or DeploymentResult
    } with {
      briefly "What DeploymentRepository answers"
      described as {
        |The answers the deployment repository gives.
