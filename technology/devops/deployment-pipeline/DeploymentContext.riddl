// Deployment Context - Bounded context for deployment management
context DeploymentContext as router is {
  inlet DeploymentCommandStreamIn is type DeploymentCommand  outlet DeploymentCommandStreamOut is type DeploymentCommand
  inlet EnvironmentCommandStreamIn is type EnvironmentCommand  outlet EnvironmentCommandStreamOut is type EnvironmentCommand
  inlet DeploymentQueryResultStreamIn is type Deployment.DeploymentQueryResult  outlet DeploymentQueryResultStreamOut is type Deployment.DeploymentQueryResult
  handler DeploymentContextBoundary is {
    on initiateDeployment: command Deployment.InitiateDeployment is {
      forward initiateDeployment to outlet DeploymentContext.DeploymentCommandStreamOut
    }
    on approveDeployment: command Deployment.ApproveDeployment is {
      forward approveDeployment to outlet DeploymentContext.DeploymentCommandStreamOut
    }
    on executeDeployment: command Deployment.ExecuteDeployment is {
      forward executeDeployment to outlet DeploymentContext.DeploymentCommandStreamOut
    }
    on verifyDeployment: command Deployment.VerifyDeployment is {
      forward verifyDeployment to outlet DeploymentContext.DeploymentCommandStreamOut
    }
    on completeDeployment: command Deployment.CompleteDeployment is {
      forward completeDeployment to outlet DeploymentContext.DeploymentCommandStreamOut
    }
    on rollbackDeployment: command Deployment.RollbackDeployment is {
      forward rollbackDeployment to outlet DeploymentContext.DeploymentCommandStreamOut
    }
    on registerEnvironment: command Environment.RegisterEnvironment is {
      forward registerEnvironment to outlet DeploymentContext.EnvironmentCommandStreamOut
    }
    on updateEnvironmentArtifact: command Environment.UpdateEnvironmentArtifact is {
      forward updateEnvironmentArtifact to outlet DeploymentContext.EnvironmentCommandStreamOut
    }
    on deploymentQueryResult: result Deployment.DeploymentQueryResult is {
      send deploymentQueryResult to outlet DeploymentContext.DeploymentQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the DeploymentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'DeploymentCommand Stream Intake' is from outlet DeploymentContext.DeploymentCommandStreamOut to inlet DeploymentContext.Deployment.DeploymentCommands  connector 'EnvironmentCommand Stream Intake' is from outlet DeploymentContext.EnvironmentCommandStreamOut to inlet DeploymentContext.Environment.EnvironmentCommands  connector 'DeploymentQueryResult Stream Egress' is from outlet DeploymentContext.DeploymentRepository.DeploymentRepositoryResponses to inlet DeploymentContext.DeploymentQueryResultStreamIn  adaptor FromArtifactRegistry from context ArtifactRegistry is { 
    handler FromArtifactRegistryHandler is {
      on event ArtifactRegistry.ArtifactFetched is {
        do "the model receives artifact fetched"
      }
      on event ArtifactRegistry.ArtifactValidated is {
        do "the model receives artifact validated"
      }
      on other is {
        error "Unexpected message for adaptor FromArtifactRegistry"
      }
    } with {
      briefly "from artifact registry"
      described as {
        |Carries messages from the external ArtifactRegistry.
      }
    }
  } with {
    briefly "ArtifactRegistry integration"
    described as {
      |The model's side of the ArtifactRegistry conversation.
    }
  }
  adaptor ToArtifactRegistry to context ArtifactRegistry is { 
    handler ToArtifactRegistryHandler is {
      on command ArtifactRegistry.FetchArtifact is {
        do "the model sends fetch artifact"
      }
      on command ArtifactRegistry.ValidateArtifact is {
        do "the model sends validate artifact"
      }
      on other is {
        error "Unexpected message for adaptor ToArtifactRegistry"
      }
    } with {
      briefly "to artifact registry"
      described as {
        |Carries messages to the external ArtifactRegistry.
      }
    }
  } with {
    briefly "ArtifactRegistry integration"
    described as {
      |The model's side of the ArtifactRegistry conversation.
    }
  }
  adaptor FromInfrastructureService from context InfrastructureService is { 
    handler FromInfrastructureServiceHandler is {
      on event InfrastructureService.InfrastructureDeploymentCompleted is {
        do "the model receives infrastructure deployment completed"
      }
      on event InfrastructureService.InfrastructureDeploymentFailed is {
        do "the model receives infrastructure deployment failed"
      }
      on event InfrastructureService.InfrastructureDeploymentStarted is {
        do "the model receives infrastructure deployment started"
      }
      on other is {
        error "Unexpected message for adaptor FromInfrastructureService"
      }
    } with {
      briefly "from infrastructure service"
      described as {
        |Carries messages from the external InfrastructureService.
      }
    }
  } with {
    briefly "InfrastructureService integration"
    described as {
      |The model's side of the InfrastructureService conversation.
    }
  }
  adaptor ToInfrastructureService to context InfrastructureService is { 
    handler ToInfrastructureServiceHandler is {
      on command InfrastructureService.DeployToInfrastructure is {
        do "the model sends deploy to infrastructure"
      }
      on command InfrastructureService.ScaleDeployment is {
        do "the model sends scale deployment"
      }
      on command InfrastructureService.TerminateDeployment is {
        do "the model sends terminate deployment"
      }
      on other is {
        error "Unexpected message for adaptor ToInfrastructureService"
      }
    } with {
      briefly "to infrastructure service"
      described as {
        |Carries messages to the external InfrastructureService.
      }
    }
  } with {
    briefly "InfrastructureService integration"
    described as {
      |The model's side of the InfrastructureService conversation.
    }
  }
  adaptor FromMonitoringService from context MonitoringService is { 
    handler FromMonitoringServiceHandler is {
      on event MonitoringService.AlertTriggered is {
        do "the model receives alert triggered"
      }
      on event MonitoringService.HealthCheckCompleted is {
        do "the model receives health check completed"
      }
      on event MonitoringService.ServiceRecovered is {
        do "the model receives service recovered"
      }
      on other is {
        error "Unexpected message for adaptor FromMonitoringService"
      }
    } with {
      briefly "from monitoring service"
      described as {
        |Carries messages from the external MonitoringService.
      }
    }
  } with {
    briefly "MonitoringService integration"
    described as {
      |The model's side of the MonitoringService conversation.
    }
  }
  adaptor ToMonitoringService to context MonitoringService is { 
    handler ToMonitoringServiceHandler is {
      on command MonitoringService.CheckServiceHealth is {
        do "the model sends check service health"
      }
      on command MonitoringService.ConfigureAlerts is {
        do "the model sends configure alerts"
      }
      on other is {
        error "Unexpected message for adaptor ToMonitoringService"
      }
    } with {
      briefly "to monitoring service"
      described as {
        |Carries messages to the external MonitoringService.
      }
    }
  } with {
    briefly "MonitoringService integration"
    described as {
      |The model's side of the MonitoringService conversation.
    }
  }
  type EnvironmentId is Id(DeploymentPipeline.DeploymentContext.Environment)  with {
    briefly "Unique identifier for a deployment environment"
    described as {
      |Identifies a specific deployment target environment.
    }
  }
  type DeploymentId is Id(DeploymentPipeline.DeploymentContext.Deployment)  with {
    briefly "Unique identifier for a deployment"
    described as {
      |A unique identifier that tracks a specific deployment instance.
    }
  }
  include "Deployment.riddl"
  entity Environment as flow is {
    type EnvironmentCommand is one of {
      Environment.RegisterEnvironment or Environment.UpdateEnvironmentArtifact
    } with {
      briefly "Environment command alternation"
      described as {
        |Commands accepted by the Environment entity.
      }
    }
    type EnvironmentEvent is one of {
      Environment.EnvironmentRegistered or Environment.EnvironmentArtifactUpdated
    } with {
      briefly "Environment event alternation"
      described as {
        |Events published by the Environment entity.
      }
    }
    inlet EnvironmentCommands is type EnvironmentCommand    outlet EnvironmentEvents is type EnvironmentEvent
    command RegisterEnvironment yields event EnvironmentRegistered is  {
      environmentId: EnvironmentId with {
        briefly "Environment identifier"
        described as {
          |The unique identifier for the environment.
        }
      }
      name: String(1,100) with {
        briefly "Environment name"
        described as {
          |Human-readable name for the environment.
        }
      }
      environmentType: EnvironmentType with {
        briefly "Environment type"
        described as {
          |Classification of the environment.
        }
      }
      clusterEndpoint: URL with {
        briefly "Cluster endpoint"
        described as {
          |URL of the deployment cluster.
        }
      }
    } with {
      briefly "Registers a new deployment environment"
      described as {
        |Creates a new environment that can be targeted by deployments.
      }
    }
    command UpdateEnvironmentArtifact yields event EnvironmentArtifactUpdated is  {
      environmentId: EnvironmentId with {
        briefly "Environment identifier"
        described as {
          |The environment being updated.
        }
      }
      artifactId: ArtifactId with {
        briefly "Artifact identifier"
        described as {
          |The newly deployed artifact.
        }
      }
      deployedAt: TimeStamp with {
        briefly "Deployed at"
        described as {
          |When the artifact was deployed.
        }
      }
    } with {
      briefly "Updates the currently deployed artifact"
      described as {
        |Records the artifact currently deployed to this environment.
      }
    }
    event EnvironmentRegistered is  {
      environmentId: EnvironmentId with {
        briefly "Environment identifier"
        described as {
          |The registered environment.
        }
      }
      name: String(1,100) with {
        briefly "Name"
        described as {
          |Environment name.
        }
      }
      environmentType: EnvironmentType with {
        briefly "Type"
        described as {
          |Environment classification.
        }
      }
      registeredAt: TimeStamp with {
        briefly "Registered at"
        described as {
          |When the environment was registered.
        }
      }
    } with {
      briefly "A new environment has been registered"
      described as {
        |Records that a new deployment target environment is available.
      }
    }
    event EnvironmentArtifactUpdated is  {
      environmentId: EnvironmentId with {
        briefly "Environment identifier"
        described as {
          |The updated environment.
        }
      }
      artifactId: ArtifactId with {
        briefly "Artifact identifier"
        described as {
          |The deployed artifact.
        }
      }
      deployedAt: TimeStamp with {
        briefly "Deployed at"
        described as {
          |When the artifact was deployed.
        }
      }
    } with {
      briefly "Environment artifact has been updated"
      described as {
        |Records that a new artifact was deployed to an environment.
      }
    }
    record ActiveEnvironmentData is  {
      environmentId: EnvironmentId with {
        briefly "ID"
        described as {
          |Environment ID.
        }
      }
      name: String(1,100) with {
        briefly "Name"
        described as {
          |Environment name.
        }
      }
      environmentType: EnvironmentType with {
        briefly "Type"
        described as {
          |Environment type.
        }
      }
      clusterEndpoint: URL with {
        briefly "Endpoint"
        described as {
          |Cluster endpoint.
        }
      }
      currentArtifact: ArtifactId? with {
        briefly "Current artifact"
        described as {
          |Currently deployed artifact.
        }
      }
      lastDeployedAt: TimeStamp? with {
        briefly "Last deployed"
        described as {
          |Last deployment time.
        }
      }
    } with {
      briefly "Active environment data"
      described as {
        |State data for an active environment.
      }
    }
    initial state Active of record Environment.ActiveEnvironmentData is {
      initial handler ActiveInitHandler is {
        on init is {
          set state Active to "initialize from prior event"
        }
      } with {
        briefly "Initializes Active state"
        described as {
          |Handles initialization of the Active state.
        }
      }
    } with {
      briefly "Active state"
      described as {
        |The entity in Active state.
      }
    }
    query GetEnvironment replies result EnvironmentResult is {
      environmentId: EnvironmentId with {
        briefly "ID"
        described as {
          |Environment to retrieve.
        }
      }
    } with {
      briefly "Get Environment"
      described as {
        |Retrieves Environment data.
      }
    }
    result EnvironmentResult is  {
      environmentId: EnvironmentId with {
        briefly "ID"
        described as {
          |Environment identifier.
        }
      }
    } with {
      briefly "Environment result"
      described as {
        |Environment data result.
      }
    }
    initial handler EnvironmentHandler is {
    on environmentArtifactUpdated: event EnvironmentArtifactUpdated is {
      do "apply EnvironmentArtifactUpdated to the environment so it can be persisted and replayed"
    }
    on environmentRegistered: event EnvironmentRegistered is {
      do "apply EnvironmentRegistered to the environment so it can be persisted and replayed"
    }
      on registerEnvironment: command RegisterEnvironment is {
        morph entity Environment to state Environment.Active with record Environment.ActiveEnvironmentData(environmentId = registerEnvironment.environmentId, name = registerEnvironment.name, environmentType = registerEnvironment.environmentType, clusterEndpoint = registerEnvironment.clusterEndpoint, currentArtifact = empty, lastDeployedAt = empty)
        yield event EnvironmentRegistered(environmentId = registerEnvironment.environmentId, name = registerEnvironment.name, environmentType = registerEnvironment.environmentType, registeredAt = prompt("the registered at of this environment registered"))
      }
      on updateEnvironmentArtifact: command UpdateEnvironmentArtifact is {
        yield event EnvironmentArtifactUpdated(environmentId = updateEnvironmentArtifact.environmentId, artifactId = updateEnvironmentArtifact.artifactId, deployedAt = updateEnvironmentArtifact.deployedAt)
      }
      on getEnvironment: query GetEnvironment is {
        reply result EnvironmentResult(environmentId = getEnvironment.environmentId)
      }
    } with {
      briefly "Handles environment management commands"
      described as {
        |Processes commands for environment registration and updates.
      }
    }
  } with {
    briefly "Entity representing a deployment target environment"
    described as {
      | The Environment entity represents a deployment target such as
      | development, staging, or production. It tracks the currently
      | deployed artifact and environment configuration.
    }
  }
  type DeploymentRepositoryCommand is one of {
    DeploymentContext.DeploymentRepository.PersistDeploymentApproved or DeploymentContext.DeploymentRepository.PersistDeploymentAwaitingApproval or DeploymentContext.DeploymentRepository.PersistDeploymentCompleted or DeploymentContext.DeploymentRepository.PersistDeploymentFailed or DeploymentContext.DeploymentRepository.PersistDeploymentInitiated or DeploymentContext.DeploymentRepository.PersistDeploymentRolledBack or DeploymentContext.DeploymentRepository.PersistDeploymentStarted or DeploymentContext.DeploymentRepository.PersistDeploymentVerified or DeploymentContext.DeploymentRepository.PersistEnvironmentArtifactUpdated or DeploymentContext.DeploymentRepository.PersistEnvironmentRegistered
  } with {
    briefly "Anything that writes DeploymentRepository"
    described as {
      |The persistence commands DeploymentRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository DeploymentRepository as flow is {
    inlet DeploymentRepositoryFromDeploymentMetricsProjector is type DeploymentRepositoryCommand
    command PersistDeploymentApproved is  {
      deploymentId: DeploymentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeploymentApproved applies to.
        }
      }
    } with {
      briefly "Persist DeploymentApproved"
      described as {
        |Instructs this repository to apply DeploymentApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeploymentAwaitingApproval is  {
      deploymentId: DeploymentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeploymentAwaitingApproval applies to.
        }
      }
    } with {
      briefly "Persist DeploymentAwaitingApproval"
      described as {
        |Instructs this repository to apply DeploymentAwaitingApproval to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeploymentInitiated is  {
      deploymentId: DeploymentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeploymentInitiated applies to.
        }
      }
    } with {
      briefly "Persist DeploymentInitiated"
      described as {
        |Instructs this repository to apply DeploymentInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeploymentStarted is  {
      deploymentId: DeploymentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeploymentStarted applies to.
        }
      }
    } with {
      briefly "Persist DeploymentStarted"
      described as {
        |Instructs this repository to apply DeploymentStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeploymentVerified is  {
      deploymentId: DeploymentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeploymentVerified applies to.
        }
      }
    } with {
      briefly "Persist DeploymentVerified"
      described as {
        |Instructs this repository to apply DeploymentVerified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEnvironmentArtifactUpdated is  {
      environmentId: EnvironmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row EnvironmentArtifactUpdated applies to.
        }
      }
    } with {
      briefly "Persist EnvironmentArtifactUpdated"
      described as {
        |Instructs this repository to apply EnvironmentArtifactUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEnvironmentRegistered is  {
      environmentId: EnvironmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row EnvironmentRegistered applies to.
        }
      }
    } with {
      briefly "Persist EnvironmentRegistered"
      described as {
        |Instructs this repository to apply EnvironmentRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeploymentCompleted is  {
      deploymentId: DeploymentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeploymentCompleted applies to.
        }
      }
    } with {
      briefly "Persist DeploymentCompleted"
      described as {
        |Instructs this repository to apply DeploymentCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeploymentFailed is  {
      deploymentId: DeploymentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeploymentFailed applies to.
        }
      }
    } with {
      briefly "Persist DeploymentFailed"
      described as {
        |Instructs this repository to apply DeploymentFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeploymentRolledBack is  {
      deploymentId: DeploymentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeploymentRolledBack applies to.
        }
      }
    } with {
      briefly "Persist DeploymentRolledBack"
      described as {
        |Instructs this repository to apply DeploymentRolledBack to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredDeployment is  {
      deploymentId: DeploymentId with {
        briefly "deploymentId"
        described as {
          |The deploymentId column of the stored deployment row.
        }
      }
    } with {
      briefly "Stored deployment row"
      described as {
        |The persistence shape of deployment data as this repository stores it.
      }
    }
    schema DeploymentData is relational
      of deployments as type StoredDeployment
        index on field StoredDeployment.deploymentId
 with {
      briefly "Deployment data schema"
      described as {
        |The relational schema persisting deployment records for this repository.
      }
    }
    outlet DeploymentRepositoryResponses is type Deployment.DeploymentQueryResult
    query FindDeploymentById replies result DeploymentResult is {
      deploymentId: DeploymentId with {
        briefly "Deployment identifier"
        described as {
          |The deployment to find.
        }
      }
    } with {
      briefly "Find a deployment by its ID"
      described as {
        |Retrieves a deployment record by its unique identifier.
      }
    }
    query FindDeploymentsByEnvironment is  {
      environmentId: EnvironmentId with {
        briefly "Environment identifier"
        described as {
          |The target environment.
        }
      }
      limit: Integer? with {
        briefly "Result limit"
        described as {
          |Maximum number of results.
        }
      }
    } with {
      briefly "Find deployments for an environment"
      described as {
        |Retrieves all deployments targeting a specific environment.
      }
    }
    query FindDeploymentsByStatus is  {
      status: DeploymentStatus with {
        briefly "Status filter"
        described as {
          |The status to filter by.
        }
      }
      limit: Integer? with {
        briefly "Result limit"
        described as {
          |Maximum number of results.
        }
      }
    } with {
      briefly "Find deployments by status"
      described as {
        |Retrieves all deployments with a specific status.
      }
    }
    query FindRecentDeployments is  {
      since: TimeStamp with {
        briefly "Since timestamp"
        described as {
          |Find deployments after this time.
        }
      }
      limit: Integer? with {
        briefly "Result limit"
        described as {
          |Maximum number of results.
        }
      }
    } with {
      briefly "Find recent deployments"
      described as {
        |Retrieves deployments initiated after the specified time.
      }
    }
    result DeploymentResult is  {
      deploymentId: DeploymentId with {
        briefly "ID"
        described as {
          |Deployment ID.
        }
      }
      artifactId: ArtifactId with {
        briefly "Artifact"
        described as {
          |Artifact ID.
        }
      }
      targetEnvironment: EnvironmentId with {
        briefly "Environment"
        described as {
          |Target environment.
        }
      }
      status: DeploymentStatus with {
        briefly "Status"
        described as {
          |Current status.
        }
      }
      initiatedBy: String(1,100) with {
        briefly "Initiated by"
        described as {
          |Who initiated.
        }
      }
      initiatedAt: TimeStamp with {
        briefly "Initiated at"
        described as {
          |When initiated.
        }
      }
      updatedCompletedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |When completed.
        }
      }
    } with {
      briefly "Result of a deployment query"
      described as {
        |Contains deployment information returned by queries.
      }
    }
    result DeploymentListResult is  {
      deploymentId: DeploymentId with {
        briefly "Deployment addressed"
        described as {
          |Which deployment this message concerns. Named directly rather
          |than left to a wrapped record, because a nested record cannot say
          |which instance is addressed.
        }
      }
      deployments: DeploymentResult+ with {
        briefly "Deployments"
        described as {
          |List of matching deployments.
        }
      }
      totalCount: Integer with {
        briefly "Total count"
        described as {
          |Total number of matching records.
        }
      }
    } with {
      briefly "Result of a deployment list query"
      described as {
        |Contains a list of deployments matching query criteria.
      }
    }
    handler DeploymentRepositoryHandler is {
      on persistDeploymentApproved: command PersistDeploymentApproved is {
        do "apply DeploymentApproved to the stored row"
      }
      on persistDeploymentAwaitingApproval: command PersistDeploymentAwaitingApproval is {
        do "apply DeploymentAwaitingApproval to the stored row"
      }
      on persistDeploymentInitiated: command PersistDeploymentInitiated is {
        do "apply DeploymentInitiated to the stored row"
      }
      on persistDeploymentStarted: command PersistDeploymentStarted is {
        do "apply DeploymentStarted to the stored row"
      }
      on persistDeploymentVerified: command PersistDeploymentVerified is {
        do "apply DeploymentVerified to the stored row"
      }
      on persistEnvironmentArtifactUpdated: command PersistEnvironmentArtifactUpdated is {
        do "apply EnvironmentArtifactUpdated to the stored row"
      }
      on persistEnvironmentRegistered: command PersistEnvironmentRegistered is {
        do "apply EnvironmentRegistered to the stored row"
      }
      on persistDeploymentCompleted: command PersistDeploymentCompleted is {
        do "apply DeploymentCompleted to the stored row"
      }
      on persistDeploymentFailed: command PersistDeploymentFailed is {
        do "apply DeploymentFailed to the stored row"
      }
      on persistDeploymentRolledBack: command PersistDeploymentRolledBack is {
        do "apply DeploymentRolledBack to the stored row"
      }
      on query GetDeploymentMetricsSummary is {
        let deploymentMetricsSummaryView: type DeploymentMetricsSummaryView = prompt("read the deployment metrics summary projection")
        reply deploymentMetricsSummaryView
      }
      on findDeploymentById: query FindDeploymentById is {
        reply result DeploymentResult(deploymentId = findDeploymentById.deploymentId, artifactId = prompt("the artifact id of this deployment result"), targetEnvironment = prompt("the target environment of this deployment result"), status = prompt("the status of this deployment result"), initiatedBy = prompt("the initiated by of this deployment result"), initiatedAt = prompt("the initiated at of this deployment result"), updatedCompletedAt = empty)
      }
      on query FindDeploymentsByEnvironment is {
        let deploymentListResult: type DeploymentListResult = prompt("read the deployment list that deployments by environment asks for")
        tell deploymentListResult to entity DeploymentContext.Deployment
      }
      on query FindDeploymentsByStatus is {
        let deploymentListResult: type DeploymentListResult = prompt("read the deployment list that deployments by status asks for")
        tell deploymentListResult to entity DeploymentContext.Deployment
      }
      on query FindRecentDeployments is {
        let deploymentListResult: type DeploymentListResult = prompt("read the deployment list that recent deployments asks for")
        tell deploymentListResult to entity DeploymentContext.Deployment
      }
    } with {
      briefly "Handles deployment repository queries"
      described as {
        |Processes queries against the deployment data store.
      }
    }
  } with {
    briefly "Repository for deployment data persistence and queries"
    described as {
      | The DeploymentRepository provides persistence and query capabilities
      | for deployment records. It supports queries by ID, environment,
      | status, and time range to support operational and reporting needs.
    }
  }
  query GetDeploymentMetricsSummary replies result DeploymentMetricsSummaryView is  {
    deploymentMetricsSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which deployment metrics summary to retrieve.
      }
    }
  } with {
    briefly "Get deployment metrics summary"
    described as {
      |Retrieves the deployment metrics summary projection.
    }
  }
  result DeploymentMetricsSummaryView is  {
    deploymentMetricsSummary: DeploymentMetricsProjector.DeploymentMetricsSummary with {
      briefly "Deployment metrics summary"
      described as {
        |The deployment metrics summary being returned.
      }
    }
  } with {
    briefly "Deployment metrics summary view"
    described as {
      |Read model view carrying the deployment metrics summary projection.
    }
  }
  projector DeploymentMetricsProjector as merge is {
    outlet DeploymentMetricsProjectorToRepository is type DeploymentRepositoryCommand
    updates repository DeploymentContext.DeploymentRepository
    inlet DeploymentMetricsProjectorFromDeployment is type DeploymentEvent    inlet DeploymentMetricsProjectorFromEnvironment is type EnvironmentEvent
    record DeploymentMetricsSummary is  {
      environmentId: EnvironmentId with {
        briefly "Environment"
        described as {
          |Environment ID.
        }
      }
      totalDeployments: Integer with {
        briefly "Total"
        described as {
          |Total deployments.
        }
      }
      successfulDeployments: Integer with {
        briefly "Successful"
        described as {
          |Successful deployments.
        }
      }
      failedDeployments: Integer with {
        briefly "Failed"
        described as {
          |Failed deployments.
        }
      }
      rolledBackDeployments: Integer with {
        briefly "Rolled back"
        described as {
          |Rolled back deployments.
        }
      }
      averageDurationMinutes: Integer with {
        briefly "Avg duration"
        described as {
          |Average duration.
        }
      }
      lastDeploymentAt: TimeStamp? with {
        briefly "Last deployment"
        described as {
          |Last deployment time.
        }
      }
    } with {
      briefly "Summary of deployment metrics per environment"
      described as {
        |Aggregated metrics for deployments to a specific environment.
      }
    }
    handler DeploymentMetricsHandler is {
      on deploymentApproved: event Deployment.DeploymentApproved is {
        tell command DeploymentContext.DeploymentRepository.PersistDeploymentApproved(deploymentId = deploymentApproved.deploymentId) to repository DeploymentContext.DeploymentRepository
        do "apply DeploymentApproved to the DeploymentMetricsProjector projection"
      }
      on deploymentAwaitingApproval: event Deployment.DeploymentAwaitingApproval is {
        tell command DeploymentContext.DeploymentRepository.PersistDeploymentAwaitingApproval(deploymentId = deploymentAwaitingApproval.deploymentId) to repository DeploymentContext.DeploymentRepository
        do "apply DeploymentAwaitingApproval to the DeploymentMetricsProjector projection"
      }
      on deploymentInitiated: event Deployment.DeploymentInitiated is {
        tell command DeploymentContext.DeploymentRepository.PersistDeploymentInitiated(deploymentId = deploymentInitiated.deploymentId) to repository DeploymentContext.DeploymentRepository
        do "apply DeploymentInitiated to the DeploymentMetricsProjector projection"
      }
      on deploymentStarted: event Deployment.DeploymentStarted is {
        tell command DeploymentContext.DeploymentRepository.PersistDeploymentStarted(deploymentId = deploymentStarted.deploymentId) to repository DeploymentContext.DeploymentRepository
        do "apply DeploymentStarted to the DeploymentMetricsProjector projection"
      }
      on deploymentVerified: event Deployment.DeploymentVerified is {
        tell command DeploymentContext.DeploymentRepository.PersistDeploymentVerified(deploymentId = deploymentVerified.deploymentId) to repository DeploymentContext.DeploymentRepository
        do "apply DeploymentVerified to the DeploymentMetricsProjector projection"
      }
      on environmentArtifactUpdated: event Environment.EnvironmentArtifactUpdated is {
        tell command DeploymentContext.DeploymentRepository.PersistEnvironmentArtifactUpdated(environmentId = environmentArtifactUpdated.environmentId) to repository DeploymentContext.DeploymentRepository
        do "apply EnvironmentArtifactUpdated to the DeploymentMetricsProjector projection"
      }
      on environmentRegistered: event Environment.EnvironmentRegistered is {
        tell command DeploymentContext.DeploymentRepository.PersistEnvironmentRegistered(environmentId = environmentRegistered.environmentId) to repository DeploymentContext.DeploymentRepository
        do "apply EnvironmentRegistered to the DeploymentMetricsProjector projection"
      }
      on deploymentCompleted: event Deployment.DeploymentCompleted is {
        tell command DeploymentContext.DeploymentRepository.PersistDeploymentCompleted(deploymentId = deploymentCompleted.deploymentId) to repository DeploymentContext.DeploymentRepository
      }
      on deploymentFailed: event Deployment.DeploymentFailed is {
        tell command DeploymentContext.DeploymentRepository.PersistDeploymentFailed(deploymentId = deploymentFailed.deploymentId) to repository DeploymentContext.DeploymentRepository
      }
      on deploymentRolledBack: event Deployment.DeploymentRolledBack is {
        tell command DeploymentContext.DeploymentRepository.PersistDeploymentRolledBack(deploymentId = deploymentRolledBack.deploymentId) to repository DeploymentContext.DeploymentRepository
      }
    } with {
      briefly "Handles events to update deployment metrics"
      described as {
        | Processes deployment events to maintain real-time metrics
        | including success rates, failure counts, and average duration.
      }
    }
  } with {
    briefly "Projector for deployment metrics and analytics"
    described as {
      | The DeploymentMetricsProjector maintains read-optimized views of
      | deployment statistics. It tracks success rates, failure rates,
      | rollback frequency, and deployment duration to support dashboards.
    }
  }
  // Event streaming infrastructure
  type DeploymentEvent is one of {
    DeploymentContext.Deployment.DeploymentInitiated or DeploymentContext.Deployment.DeploymentApproved or DeploymentContext.Deployment.DeploymentStarted or DeploymentContext.Deployment.DeploymentCompleted or DeploymentContext.Deployment.DeploymentFailed or DeploymentContext.Deployment.DeploymentAwaitingApproval or DeploymentContext.Deployment.DeploymentRolledBack or DeploymentContext.Deployment.DeploymentVerified
  } with {
    briefly "Deployment events"
    described as {
      |Union of all Deployment events for streaming.
    }
  }
  processor DeploymentEventSplit as flow is {
    inlet DeploymentEventSplitIn is type DeploymentEvent
    outlet DeploymentEventSplitToDeploymentMetricsProjector is type DeploymentEvent
    handler DeploymentEventSplitHandler is {
      on deploymentInitiated: event Deployment.DeploymentInitiated is {
        send deploymentInitiated to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell deploymentInitiated to entity DeploymentContext.Deployment
      }
      on deploymentAwaitingApproval: event Deployment.DeploymentAwaitingApproval is {
        send deploymentAwaitingApproval to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell deploymentAwaitingApproval to entity DeploymentContext.Deployment
      }
      on deploymentApproved: event Deployment.DeploymentApproved is {
        send deploymentApproved to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell deploymentApproved to entity DeploymentContext.Deployment
      }
      on deploymentStarted: event Deployment.DeploymentStarted is {
        send deploymentStarted to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell deploymentStarted to entity DeploymentContext.Deployment
      }
      on deploymentVerified: event Deployment.DeploymentVerified is {
        send deploymentVerified to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell deploymentVerified to entity DeploymentContext.Deployment
      }
      on deploymentCompleted: event Deployment.DeploymentCompleted is {
        send deploymentCompleted to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell deploymentCompleted to entity DeploymentContext.Deployment
      }
      on deploymentFailed: event Deployment.DeploymentFailed is {
        send deploymentFailed to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell deploymentFailed to entity DeploymentContext.Deployment
      }
      on deploymentRolledBack: event Deployment.DeploymentRolledBack is {
        send deploymentRolledBack to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell deploymentRolledBack to entity DeploymentContext.Deployment
      }
      on other is {
        error "Unexpected message for processor DeploymentEventSplit"
      }
    } with {
      briefly "Deployment event fan-out handler"
      described as {
        |Delivers each Deployment event to all of its consumers.
      }
    }
  } with {
    briefly "Deployment event fan-out"
    described as {
      |Fans Deployment events out to the repository and projectors.
    }
  }
  processor EnvironmentEventSplit as flow is {
    inlet EnvironmentEventSplitIn is type EnvironmentEvent
    outlet EnvironmentEventSplitToDeploymentMetricsProjector is type EnvironmentEvent
    handler EnvironmentEventSplitHandler is {
      on environmentRegistered: event Environment.EnvironmentRegistered is {
        send environmentRegistered to outlet EnvironmentEventSplitToDeploymentMetricsProjector
        tell environmentRegistered to entity DeploymentContext.Environment
      }
      on environmentArtifactUpdated: event Environment.EnvironmentArtifactUpdated is {
        send environmentArtifactUpdated to outlet EnvironmentEventSplitToDeploymentMetricsProjector
        tell environmentArtifactUpdated to entity DeploymentContext.Environment
      }
      on other is {
        error "Unexpected message for processor EnvironmentEventSplit"
      }
    } with {
      briefly "Environment event fan-out handler"
      described as {
        |Delivers each Environment event to all of its consumers.
      }
    }
  } with {
    briefly "Environment event fan-out"
    described as {
      |Fans Environment events out to the repository and projectors.
    }
  }
  connector 'DeploymentEvent Stream' is from outlet DeploymentContext.Deployment.DeploymentEvents to inlet DeploymentContext.DeploymentEventSplit.DeploymentEventSplitIn with {
    briefly "Deployment events, fanned out to storage and read models"
  }
  connector 'DeploymentEvent Feed' is from outlet DeploymentContext.DeploymentEventSplit.DeploymentEventSplitToDeploymentMetricsProjector to inlet DeploymentContext.DeploymentMetricsProjector.DeploymentMetricsProjectorFromDeployment with {
    briefly "DeploymentEvent feeding the DeploymentMetricsProjector projection"
  }
  connector 'EnvironmentEvent Stream' is from outlet DeploymentContext.Environment.EnvironmentEvents to inlet DeploymentContext.EnvironmentEventSplit.EnvironmentEventSplitIn with {
    briefly "Environment events, fanned out to storage and read models"
  }
  connector 'EnvironmentEvent Feed' is from outlet DeploymentContext.EnvironmentEventSplit.EnvironmentEventSplitToDeploymentMetricsProjector to inlet DeploymentContext.DeploymentMetricsProjector.DeploymentMetricsProjectorFromEnvironment with {
    briefly "EnvironmentEvent feeding the DeploymentMetricsProjector projection"
  }
  connector 'DeploymentMetricsProjector Storage' is from outlet DeploymentContext.DeploymentMetricsProjector.DeploymentMetricsProjectorToRepository to inlet DeploymentContext.DeploymentRepository.DeploymentRepositoryFromDeploymentMetricsProjector with {
    briefly "DeploymentMetricsProjector updates on their way to storage"
  }
} with {
  briefly "Bounded context for deployment pipeline management"
  described as {
    | The DeploymentContext is the bounded context containing all
    | capabilities for managing software deployments. It includes the
    | Deployment aggregate, Environment entity, and supporting repository
    | and projector for persistence and analytics.
  }
}
