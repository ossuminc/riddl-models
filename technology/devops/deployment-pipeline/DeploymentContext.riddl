// Deployment Context - Bounded context for deployment management
context DeploymentContext is {
  adaptor FromArtifactRegistry from context ArtifactRegistry is {
    handler FromArtifactRegistryHandler is {
      on event ArtifactRegistry.ArtifactFetched is {
        do "the model receives artifact fetched"
      }
      on event ArtifactRegistry.ArtifactValidated is {
        do "the model receives artifact validated"
      }
      on other is {
        error "Unexpected message for adaptor FromArtifactRegistry"
      }
    } with {
      briefly "from artifact registry"
      described as {
        |Carries messages from the external ArtifactRegistry.
      }
    }
  } with {
      briefly "ArtifactRegistry integration"
    described as {
      |The model's side of the ArtifactRegistry conversation.
    }
  }
  adaptor ToArtifactRegistry to context ArtifactRegistry is {
    handler ToArtifactRegistryHandler is {
      on command ArtifactRegistry.FetchArtifact is {
        do "the model sends fetch artifact"
      }
      on command ArtifactRegistry.ValidateArtifact is {
        do "the model sends validate artifact"
      }
      on other is {
        error "Unexpected message for adaptor ToArtifactRegistry"
      }
    } with {
      briefly "to artifact registry"
      described as {
        |Carries messages to the external ArtifactRegistry.
      }
    }
  } with {
      briefly "ArtifactRegistry integration"
    described as {
      |The model's side of the ArtifactRegistry conversation.
    }
  }
  adaptor FromInfrastructureService from context InfrastructureService is {
    handler FromInfrastructureServiceHandler is {
      on event InfrastructureService.InfrastructureDeploymentCompleted is {
        do "the model receives infrastructure deployment completed"
      }
      on event InfrastructureService.InfrastructureDeploymentFailed is {
        do "the model receives infrastructure deployment failed"
      }
      on event InfrastructureService.InfrastructureDeploymentStarted is {
        do "the model receives infrastructure deployment started"
      }
      on other is {
        error "Unexpected message for adaptor FromInfrastructureService"
      }
    } with {
      briefly "from infrastructure service"
      described as {
        |Carries messages from the external InfrastructureService.
      }
    }
  } with {
      briefly "InfrastructureService integration"
    described as {
      |The model's side of the InfrastructureService conversation.
    }
  }
  adaptor ToInfrastructureService to context InfrastructureService is {
    handler ToInfrastructureServiceHandler is {
      on command InfrastructureService.DeployToInfrastructure is {
        do "the model sends deploy to infrastructure"
      }
      on command InfrastructureService.ScaleDeployment is {
        do "the model sends scale deployment"
      }
      on command InfrastructureService.TerminateDeployment is {
        do "the model sends terminate deployment"
      }
      on other is {
        error "Unexpected message for adaptor ToInfrastructureService"
      }
    } with {
      briefly "to infrastructure service"
      described as {
        |Carries messages to the external InfrastructureService.
      }
    }
  } with {
      briefly "InfrastructureService integration"
    described as {
      |The model's side of the InfrastructureService conversation.
    }
  }
  adaptor FromMonitoringService from context MonitoringService is {
    handler FromMonitoringServiceHandler is {
      on event MonitoringService.AlertTriggered is {
        do "the model receives alert triggered"
      }
      on event MonitoringService.HealthCheckCompleted is {
        do "the model receives health check completed"
      }
      on event MonitoringService.ServiceRecovered is {
        do "the model receives service recovered"
      }
      on other is {
        error "Unexpected message for adaptor FromMonitoringService"
      }
    } with {
      briefly "from monitoring service"
      described as {
        |Carries messages from the external MonitoringService.
      }
    }
  } with {
      briefly "MonitoringService integration"
    described as {
      |The model's side of the MonitoringService conversation.
    }
  }
  adaptor ToMonitoringService to context MonitoringService is {
    handler ToMonitoringServiceHandler is {
      on command MonitoringService.CheckServiceHealth is {
        do "the model sends check service health"
      }
      on command MonitoringService.ConfigureAlerts is {
        do "the model sends configure alerts"
      }
      on other is {
        error "Unexpected message for adaptor ToMonitoringService"
      }
    } with {
      briefly "to monitoring service"
      described as {
        |Carries messages to the external MonitoringService.
      }
    }
  } with {
      briefly "MonitoringService integration"
    described as {
      |The model's side of the MonitoringService conversation.
    }
  }
  type EnvironmentId is Id(DeploymentPipeline.DeploymentContext.Environment)  with {
    briefly "Unique identifier for a deployment environment"
    described as {
      |Identifies a specific deployment target environment.
    }
  }
  type DeploymentId is Id(DeploymentPipeline.DeploymentContext.Deployment)  with {
    briefly "Unique identifier for a deployment"
    described as {
      |A unique identifier that tracks a specific deployment instance.
    }
  }
  include "Deployment.riddl"
  entity Environment is {
    type EnvironmentCommand is one of {
      Environment.RegisterEnvironment,
      Environment.UpdateEnvironmentArtifact
    } with {
      briefly "Environment command alternation"
      described as {
        |Commands accepted by the Environment entity.
      }
    }
    type EnvironmentEvent is one of {
      Environment.EnvironmentRegistered,
      Environment.EnvironmentArtifactUpdated
    } with {
      briefly "Environment event alternation"
      described as {
        |Events published by the Environment entity.
      }
    }
    inlet EnvironmentCommands is type EnvironmentCommand
    outlet EnvironmentEvents is type EnvironmentEvent
    command RegisterEnvironment is  {
      environmentId: EnvironmentId with {
        briefly "Environment identifier"
        described as {
          |The unique identifier for the environment.
        }
      }
      name: String(1,100) with {
        briefly "Environment name"
        described as {
          |Human-readable name for the environment.
        }
      }
      environmentType: EnvironmentType with {
        briefly "Environment type"
        described as {
          |Classification of the environment.
        }
      }
      clusterEndpoint: URL with {
        briefly "Cluster endpoint"
        described as {
          |URL of the deployment cluster.
        }
      }
    } with {
      briefly "Registers a new deployment environment"
      described as {
        |Creates a new environment that can be targeted by deployments.
      }
    }
    command UpdateEnvironmentArtifact is  {
      environmentId: EnvironmentId with {
        briefly "Environment identifier"
        described as {
          |The environment being updated.
        }
      }
      artifactId: ArtifactId with {
        briefly "Artifact identifier"
        described as {
          |The newly deployed artifact.
        }
      }
      deployedAt: TimeStamp with {
        briefly "Deployed at"
        described as {
          |When the artifact was deployed.
        }
      }
    } with {
      briefly "Updates the currently deployed artifact"
      described as {
        |Records the artifact currently deployed to this environment.
      }
    }
    event EnvironmentRegistered is  {
      environmentId: EnvironmentId with {
        briefly "Environment identifier"
        described as {
          |The registered environment.
        }
      }
      name: String(1,100) with {
        briefly "Name"
        described as {
          |Environment name.
        }
      }
      environmentType: EnvironmentType with {
        briefly "Type"
        described as {
          |Environment classification.
        }
      }
      registeredAt: TimeStamp with {
        briefly "Registered at"
        described as {
          |When the environment was registered.
        }
      }
    } with {
      briefly "A new environment has been registered"
      described as {
        |Records that a new deployment target environment is available.
      }
    }
    event EnvironmentArtifactUpdated is  {
      environmentId: EnvironmentId with {
        briefly "Environment identifier"
        described as {
          |The updated environment.
        }
      }
      artifactId: ArtifactId with {
        briefly "Artifact identifier"
        described as {
          |The deployed artifact.
        }
      }
      deployedAt: TimeStamp with {
        briefly "Deployed at"
        described as {
          |When the artifact was deployed.
        }
      }
    } with {
      briefly "Environment artifact has been updated"
      described as {
        |Records that a new artifact was deployed to an environment.
      }
    }
    record ActiveEnvironmentData is  {
      environmentId: EnvironmentId with {
        briefly "ID"
        described as {
          |Environment ID.
        }
      }
      name: String(1,100) with {
        briefly "Name"
        described as {
          |Environment name.
        }
      }
      environmentType: EnvironmentType with {
        briefly "Type"
        described as {
          |Environment type.
        }
      }
      clusterEndpoint: URL with {
        briefly "Endpoint"
        described as {
          |Cluster endpoint.
        }
      }
      currentArtifact: ArtifactId? with {
        briefly "Current artifact"
        described as {
          |Currently deployed artifact.
        }
      }
      lastDeployedAt: TimeStamp? with {
        briefly "Last deployed"
        described as {
          |Last deployment time.
        }
      }
    } with {
      briefly "Active environment data"
      described as {
        |State data for an active environment.
      }
    }
    state Active of record Environment.ActiveEnvironmentData is {
      handler ActiveInitHandler is {
        on init is {
          set state Active to "initialize from prior event"
        }
      } with {
        briefly "Initializes Active state"
        described as {
          |Handles initialization of the Active state.
        }
      }
    } with {
      briefly "Active state"
      described as {
        |The entity in Active state.
      }
    }
    query GetEnvironment is {
      environmentId: EnvironmentId with {
        briefly "ID"
        described as {
          |Environment to retrieve.
        }
      }
    } with {
      briefly "Get Environment"
      described as {
        |Retrieves Environment data.
      }
    }
    result EnvironmentResult is {
      environmentId: EnvironmentId with {
        briefly "ID"
        described as {
          |Environment identifier.
        }
      }
    } with {
      briefly "Environment result"
      described as {
        |Environment data result.
      }
    }
    handler EnvironmentHandler is {
      on command RegisterEnvironment is {
        morph entity Environment to state Environment.Active with record Environment.ActiveEnvironmentData
        tell event EnvironmentRegistered to entity Environment
      }
      on command UpdateEnvironmentArtifact is {
        tell event EnvironmentArtifactUpdated to entity Environment
      }
      on query GetEnvironment is {
        tell result EnvironmentResult to entity DeploymentContext.Environment
      }
    } with {
      briefly "Handles environment management commands"
      described as {
        |Processes commands for environment registration and updates.
      }
    }
  } with {
    briefly "Entity representing a deployment target environment"
    described as {
      | The Environment entity represents a deployment target such as
      | development, staging, or production. It tracks the currently
      | deployed artifact and environment configuration.
    }
  }
  repository DeploymentRepository is {
    schema DeploymentData is relational
      of deployments as type Deployment
      with {
      briefly "Deployment data schema"
      described as {
        |The relational schema persisting deployment records for this repository.
      }
    }
    inlet DeploymentRepositoryFromDeployment is type DeploymentEvent
    inlet DeploymentRepositoryFromEnvironment is type EnvironmentEvent
    inlet DeploymentRepositoryFromDeploymentMetricsProjector is type DeploymentEvent
    outlet DeploymentRepositoryResponses is type Deployment.DeploymentQueryResult
    query FindDeploymentById is  {
      deploymentId: DeploymentId with {
        briefly "Deployment identifier"
        described as {
          |The deployment to find.
        }
      }
    } with {
      briefly "Find a deployment by its ID"
      described as {
        |Retrieves a deployment record by its unique identifier.
      }
    }
    query FindDeploymentsByEnvironment is  {
      environmentId: EnvironmentId with {
        briefly "Environment identifier"
        described as {
          |The target environment.
        }
      }
      limit: Integer? with {
        briefly "Result limit"
        described as {
          |Maximum number of results.
        }
      }
    } with {
      briefly "Find deployments for an environment"
      described as {
        |Retrieves all deployments targeting a specific environment.
      }
    }
    query FindDeploymentsByStatus is  {
      status: DeploymentStatus with {
        briefly "Status filter"
        described as {
          |The status to filter by.
        }
      }
      limit: Integer? with {
        briefly "Result limit"
        described as {
          |Maximum number of results.
        }
      }
    } with {
      briefly "Find deployments by status"
      described as {
        |Retrieves all deployments with a specific status.
      }
    }
    query FindRecentDeployments is  {
      since: TimeStamp with {
        briefly "Since timestamp"
        described as {
          |Find deployments after this time.
        }
      }
      limit: Integer? with {
        briefly "Result limit"
        described as {
          |Maximum number of results.
        }
      }
    } with {
      briefly "Find recent deployments"
      described as {
        |Retrieves deployments initiated after the specified time.
      }
    }
    result DeploymentResult is  {
      deploymentId: DeploymentId with {
        briefly "ID"
        described as {
          |Deployment ID.
        }
      }
      artifactId: ArtifactId with {
        briefly "Artifact"
        described as {
          |Artifact ID.
        }
      }
      targetEnvironment: EnvironmentId with {
        briefly "Environment"
        described as {
          |Target environment.
        }
      }
      status: DeploymentStatus with {
        briefly "Status"
        described as {
          |Current status.
        }
      }
      initiatedBy: String(1,100) with {
        briefly "Initiated by"
        described as {
          |Who initiated.
        }
      }
      initiatedAt: TimeStamp with {
        briefly "Initiated at"
        described as {
          |When initiated.
        }
      }
      updatedCompletedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |When completed.
        }
      }
    } with {
      briefly "Result of a deployment query"
      described as {
        |Contains deployment information returned by queries.
      }
    }
    result DeploymentListResult is  {
      deployments: DeploymentResult+ with {
        briefly "Deployments"
        described as {
          |List of matching deployments.
        }
      }
      totalCount: Integer with {
        briefly "Total count"
        described as {
          |Total number of matching records.
        }
      }
    } with {
      briefly "Result of a deployment list query"
      described as {
        |Contains a list of deployments matching query criteria.
      }
    }
    handler DeploymentRepositoryHandler is {
      on query FindDeploymentById is {
        tell result DeploymentResult to entity DeploymentContext.Deployment
      }
      on query FindDeploymentsByEnvironment is {
        tell result DeploymentListResult to entity DeploymentContext.Deployment
      }
      on query FindDeploymentsByStatus is {
        tell result DeploymentListResult to entity DeploymentContext.Deployment
      }
      on query FindRecentDeployments is {
        tell result DeploymentListResult to entity DeploymentContext.Deployment
      }
    } with {
      briefly "Handles deployment repository queries"
      described as {
        |Processes queries against the deployment data store.
      }
    }
  } with {
    briefly "Repository for deployment data persistence and queries"
    described as {
      | The DeploymentRepository provides persistence and query capabilities
      | for deployment records. It supports queries by ID, environment,
      | status, and time range to support operational and reporting needs.
    }
  }
  projector DeploymentMetricsProjector is {
    inlet DeploymentMetricsProjectorFromDeployment is type DeploymentEvent
    inlet DeploymentMetricsProjectorFromEnvironment is type EnvironmentEvent
    outlet DeploymentMetricsProjectorOut is type DeploymentEvent
    updates repository DeploymentContext.DeploymentRepository
    record DeploymentMetricsSummary is  {
      environmentId: EnvironmentId with {
        briefly "Environment"
        described as {
          |Environment ID.
        }
      }
      totalDeployments: Integer with {
        briefly "Total"
        described as {
          |Total deployments.
        }
      }
      successfulDeployments: Integer with {
        briefly "Successful"
        described as {
          |Successful deployments.
        }
      }
      failedDeployments: Integer with {
        briefly "Failed"
        described as {
          |Failed deployments.
        }
      }
      rolledBackDeployments: Integer with {
        briefly "Rolled back"
        described as {
          |Rolled back deployments.
        }
      }
      averageDurationMinutes: Integer with {
        briefly "Avg duration"
        described as {
          |Average duration.
        }
      }
      lastDeploymentAt: TimeStamp? with {
        briefly "Last deployment"
        described as {
          |Last deployment time.
        }
      }
    } with {
      briefly "Summary of deployment metrics per environment"
      described as {
        |Aggregated metrics for deployments to a specific environment.
      }
    }
    handler DeploymentMetricsHandler is {
      on event Deployment.DeploymentCompleted is {
        tell event Deployment.DeploymentCompleted to repository DeploymentContext.DeploymentRepository
      }
      on event Deployment.DeploymentFailed is {
        tell event Deployment.DeploymentFailed to repository DeploymentContext.DeploymentRepository
      }
      on event Deployment.DeploymentRolledBack is {
        tell event Deployment.DeploymentRolledBack to repository DeploymentContext.DeploymentRepository
      }
    } with {
      briefly "Handles events to update deployment metrics"
      described as {
        | Processes deployment events to maintain real-time metrics
        | including success rates, failure counts, and average duration.
      }
    }
  } with {
    briefly "Projector for deployment metrics and analytics"
    described as {
      | The DeploymentMetricsProjector maintains read-optimized views of
      | deployment statistics. It tracks success rates, failure rates,
      | rollback frequency, and deployment duration to support dashboards.
    }
  }
  // Event streaming infrastructure
  type DeploymentEvent is one of {
    DeploymentContext.Deployment.DeploymentInitiated,
    DeploymentContext.Deployment.DeploymentApproved,
    DeploymentContext.Deployment.DeploymentStarted,
    DeploymentContext.Deployment.DeploymentCompleted,
    DeploymentContext.Deployment.DeploymentFailed
  } with {
    briefly "Deployment events"
    described as {
      |Union of all Deployment events for streaming.
    }
  }
  processor DeploymentSource as source is {
    outlet DeploymentEventOutlet is type DeploymentEvent with {
      briefly "Event outlet"
      described as {
        |Outlet for Deployment events.
      }
    }
    handler DeploymentSourceHandler is {
      on init is {
        tell command Deployment.InitializeDeployment to entity DeploymentContext.Deployment
      }
      on event Deployment.DeploymentInitiated is {
        send event Deployment.DeploymentInitiated to outlet DeploymentEventOutlet
      }
      on event Deployment.DeploymentApproved is {
        send event Deployment.DeploymentApproved to outlet DeploymentEventOutlet
      }
      on event Deployment.DeploymentStarted is {
        send event Deployment.DeploymentStarted to outlet DeploymentEventOutlet
      }
      on event Deployment.DeploymentCompleted is {
        send event Deployment.DeploymentCompleted to outlet DeploymentEventOutlet
      }
      on event Deployment.DeploymentFailed is {
        send event Deployment.DeploymentFailed to outlet DeploymentEventOutlet
      }
      on other is {
        error "Unexpected message for source DeploymentSource"
      }
    } with {
      briefly "Source handler"
      described as {
        |Handles Deployment events for streaming.
      }
    }
  } with {
    briefly "Deployment event source"
    described as {
      |Publishes Deployment events to the event stream.
    }
  }
  processor DeploymentSink as sink is {
    inlet DeploymentEventInlet is type DeploymentEvent with {
      briefly "Event inlet"
      described as {
        |Inlet for Deployment events.
      }
    }
    handler DeploymentSinkHandler is {
      on init is { ??? }
      on event Deployment.DeploymentInitiated is {
        tell event Deployment.DeploymentInitiated to repository DeploymentContext.DeploymentRepository
      }
      on event Deployment.DeploymentApproved is {
        tell event Deployment.DeploymentApproved to repository DeploymentContext.DeploymentRepository
      }
      on event Deployment.DeploymentStarted is {
        tell event Deployment.DeploymentStarted to repository DeploymentContext.DeploymentRepository
      }
      on event Deployment.DeploymentCompleted is {
        tell event Deployment.DeploymentCompleted to repository DeploymentContext.DeploymentRepository
      }
      on event Deployment.DeploymentFailed is {
        tell event Deployment.DeploymentFailed to repository DeploymentContext.DeploymentRepository
      }
      on other is {
        error "Unexpected message for sink DeploymentSink"
      }
    } with {
      briefly "Sink handler"
      described as {
        |Handles incoming Deployment events for persistence.
      }
    }
  } with {
    briefly "Deployment event sink"
    described as {
      |Receives Deployment events for persistence.
    }
  }
  connector DeploymentEventFlow is {
    from outlet DeploymentContext.DeploymentSource.DeploymentEventOutlet to
      inlet DeploymentContext.DeploymentSink.DeploymentEventInlet
  } with {
    briefly "Deployment event connector"
    described as {
      |Wires Deployment source to sink for event flow.
    }
  }
  processor DeploymentEventSplit is {
    inlet DeploymentEventSplitIn is type DeploymentEvent
    outlet DeploymentEventSplitToDeploymentRepository is type DeploymentEvent
    outlet DeploymentEventSplitToDeploymentMetricsProjector is type DeploymentEvent
    handler DeploymentEventSplitHandler is {
      on event Deployment.DeploymentInitiated is {
        send event Deployment.DeploymentInitiated to outlet DeploymentEventSplitToDeploymentRepository
        send event Deployment.DeploymentInitiated to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell event Deployment.DeploymentInitiated to entity DeploymentContext.Deployment
      }
      on event Deployment.DeploymentAwaitingApproval is {
        send event Deployment.DeploymentAwaitingApproval to outlet DeploymentEventSplitToDeploymentRepository
        send event Deployment.DeploymentAwaitingApproval to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell event Deployment.DeploymentAwaitingApproval to entity DeploymentContext.Deployment
      }
      on event Deployment.DeploymentApproved is {
        send event Deployment.DeploymentApproved to outlet DeploymentEventSplitToDeploymentRepository
        send event Deployment.DeploymentApproved to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell event Deployment.DeploymentApproved to entity DeploymentContext.Deployment
      }
      on event Deployment.DeploymentStarted is {
        send event Deployment.DeploymentStarted to outlet DeploymentEventSplitToDeploymentRepository
        send event Deployment.DeploymentStarted to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell event Deployment.DeploymentStarted to entity DeploymentContext.Deployment
      }
      on event Deployment.DeploymentVerified is {
        send event Deployment.DeploymentVerified to outlet DeploymentEventSplitToDeploymentRepository
        send event Deployment.DeploymentVerified to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell event Deployment.DeploymentVerified to entity DeploymentContext.Deployment
      }
      on event Deployment.DeploymentCompleted is {
        send event Deployment.DeploymentCompleted to outlet DeploymentEventSplitToDeploymentRepository
        send event Deployment.DeploymentCompleted to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell event Deployment.DeploymentCompleted to entity DeploymentContext.Deployment
      }
      on event Deployment.DeploymentFailed is {
        send event Deployment.DeploymentFailed to outlet DeploymentEventSplitToDeploymentRepository
        send event Deployment.DeploymentFailed to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell event Deployment.DeploymentFailed to entity DeploymentContext.Deployment
      }
      on event Deployment.DeploymentRolledBack is {
        send event Deployment.DeploymentRolledBack to outlet DeploymentEventSplitToDeploymentRepository
        send event Deployment.DeploymentRolledBack to outlet DeploymentEventSplitToDeploymentMetricsProjector
        tell event Deployment.DeploymentRolledBack to entity DeploymentContext.Deployment
      }
      on other is {
        error "Unexpected message for processor DeploymentEventSplit"
      }
    } with {
      briefly "Deployment event fan-out handler"
      described as {
        |Delivers each Deployment event to all of its consumers.
      }
    }
  } with {
    briefly "Deployment event fan-out"
    described as {
      |Fans Deployment events out to the repository and projectors.
    }
  }
  processor EnvironmentEventSplit is {
    inlet EnvironmentEventSplitIn is type EnvironmentEvent
    outlet EnvironmentEventSplitToDeploymentRepository is type EnvironmentEvent
    outlet EnvironmentEventSplitToDeploymentMetricsProjector is type EnvironmentEvent
    handler EnvironmentEventSplitHandler is {
      on event Environment.EnvironmentRegistered is {
        send event Environment.EnvironmentRegistered to outlet EnvironmentEventSplitToDeploymentRepository
        send event Environment.EnvironmentRegistered to outlet EnvironmentEventSplitToDeploymentMetricsProjector
        tell event Environment.EnvironmentRegistered to entity DeploymentContext.Environment
      }
      on event Environment.EnvironmentArtifactUpdated is {
        send event Environment.EnvironmentArtifactUpdated to outlet EnvironmentEventSplitToDeploymentRepository
        send event Environment.EnvironmentArtifactUpdated to outlet EnvironmentEventSplitToDeploymentMetricsProjector
        tell event Environment.EnvironmentArtifactUpdated to entity DeploymentContext.Environment
      }
      on other is {
        error "Unexpected message for processor EnvironmentEventSplit"
      }
    } with {
      briefly "Environment event fan-out handler"
      described as {
        |Delivers each Environment event to all of its consumers.
      }
    }
  } with {
    briefly "Environment event fan-out"
    described as {
      |Fans Environment events out to the repository and projectors.
    }
  }
  connector LinkDeploymentToDeploymentEventSplit is {
    from outlet DeploymentContext.Deployment.DeploymentEvents to
      inlet DeploymentContext.DeploymentEventSplit.DeploymentEventSplitIn
  } with {
    briefly "LinkDeploymentToDeploymentEventSplit"
  }
  connector LinkDeploymentEventSplitToDeploymentRepository is {
    from outlet DeploymentContext.DeploymentEventSplit.DeploymentEventSplitToDeploymentRepository to
      inlet DeploymentContext.DeploymentRepository.DeploymentRepositoryFromDeployment
  } with {
    briefly "LinkDeploymentEventSplitToDeploymentRepository"
  }
  connector LinkDeploymentEventSplitToDeploymentMetricsProjector is {
    from outlet DeploymentContext.DeploymentEventSplit.DeploymentEventSplitToDeploymentMetricsProjector to
      inlet DeploymentContext.DeploymentMetricsProjector.DeploymentMetricsProjectorFromDeployment
  } with {
    briefly "LinkDeploymentEventSplitToDeploymentMetricsProjector"
  }
  connector LinkEnvironmentToEnvironmentEventSplit is {
    from outlet DeploymentContext.Environment.EnvironmentEvents to
      inlet DeploymentContext.EnvironmentEventSplit.EnvironmentEventSplitIn
  } with {
    briefly "LinkEnvironmentToEnvironmentEventSplit"
  }
  connector LinkEnvironmentEventSplitToDeploymentRepository is {
    from outlet DeploymentContext.EnvironmentEventSplit.EnvironmentEventSplitToDeploymentRepository to
      inlet DeploymentContext.DeploymentRepository.DeploymentRepositoryFromEnvironment
  } with {
    briefly "LinkEnvironmentEventSplitToDeploymentRepository"
  }
  connector LinkEnvironmentEventSplitToDeploymentMetricsProjector is {
    from outlet DeploymentContext.EnvironmentEventSplit.EnvironmentEventSplitToDeploymentMetricsProjector to
      inlet DeploymentContext.DeploymentMetricsProjector.DeploymentMetricsProjectorFromEnvironment
  } with {
    briefly "LinkEnvironmentEventSplitToDeploymentMetricsProjector"
  }
  connector LinkDeploymentMetricsProjectorToDeploymentRepository is {
    from outlet DeploymentContext.DeploymentMetricsProjector.DeploymentMetricsProjectorOut to
      inlet DeploymentContext.DeploymentRepository.DeploymentRepositoryFromDeploymentMetricsProjector
  } with {
    briefly "LinkDeploymentMetricsProjectorToDeploymentRepository"
  }
} with {
  briefly "Bounded context for deployment pipeline management"
  described as {
    | The DeploymentContext is the bounded context containing all
    | capabilities for managing software deployments. It includes the
    | Deployment aggregate, Environment entity, and supporting repository
    | and projector for persistence and analytics.
  }
}
