// Deployment Pipeline - Deployment Entity
// The primary aggregate for deployment lifecycle management
event-sourced entity Deployment as router is {
  type DeploymentCommand is one of {
    Deployment.RequestDeploymentApproval or Deployment.ApproveDeployment or Deployment.ExecuteDeployment or Deployment.VerifyDeployment or Deployment.CompleteDeployment or Deployment.FailDeployment or Deployment.RollbackDeployment
  } with {
    briefly "Deployment command alternation"
    described as {
      |Commands accepted by the Deployment entity.
    }
  }
  inlet DeploymentQueries is query GetDeployment with {
    briefly "Look-ups of this deployment"
    described as {
      |What DeploymentPipelineApp asks of the deployment, by way of DeploymentContext.
    }
  }
  outlet DeploymentReplies is result DeploymentQueryResult
 with {
    briefly "This deployment's answers"
    described as {
      |What the deployment answers, on its way back to DeploymentContext.
    }
  }
  inlet DeploymentCommands is type DeploymentCommand
  outlet DeploymentEvents is type DeploymentEvent
  // Commands
  command ApproveDeployment yields event DeploymentApproved is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The deployment being approved.
      }
    }
    approvedBy: String(1,100) with {
      briefly "Approved by"
      described as {
        |User who approved the deployment.
      }
    }
    approvalNotes: String(1,500)? with {
      briefly "Approval notes"
      described as {
        |Optional notes about the approval decision.
      }
    }
  } with {
    briefly "Approves a pending deployment for execution"
    described as {
      | Records approval for a deployment that requires manual sign-off.
      | Only deployments in AwaitingApproval state can be approved.
    }
  }
  command ExecuteDeployment yields event DeploymentStarted is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The deployment to execute.
      }
    }
  } with {
    briefly "Begins execution of an approved deployment"
    described as {
      | Triggers the actual deployment process for an approved deployment.
      | This initiates communication with infrastructure services.
    }
  }
  command VerifyDeployment yields event DeploymentVerified is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The deployment being verified.
      }
    }
    healthCheckPassed: Boolean with {
      briefly "Health check result"
      described as {
        |Whether the health check passed.
      }
    }
    responseTimeMs: Integer with {
      briefly "Response time"
      described as {
        |Average response time in milliseconds.
      }
    }
    errorRate: Decimal(5,2) with {
      briefly "Error rate"
      described as {
        |Percentage of requests that failed.
      }
    }
    details: String(1,1000) with {
      briefly "Details"
      described as {
        |Additional verification details.
      }
    }
  } with {
    briefly "Records verification results for a deployment"
    described as {
      | Captures the results of post-deployment verification checks.
      | If verification passes, the deployment can be completed.
    }
  }
  command RequestDeploymentApproval yields event DeploymentAwaitingApproval is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The deployment that needs approval.
      }
    }
    targetEnvironment: EnvironmentId with {
      briefly "Target environment"
      described as {
        |The environment whose policy requires the approval.
      }
    }
  } with {
    briefly "Asks for approval before a deployment proceeds"
    described as {
      |Holds a pending deployment until someone approves it, for a target
      |environment that does not accept unapproved changes.
    }
  }
  command FailDeployment yields event DeploymentFailed is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The deployment that failed.
      }
    }
    failureReason: String(1,500) with {
      briefly "Failure reason"
      described as {
        |Why the rollout could not complete.
      }
    }
  } with {
    briefly "Records that a deployment failed"
    described as {
      |Marks a rollout the infrastructure could not complete as failed. Whether
      |to roll back is a separate decision taken from the failed state.
    }
  }
  command CompleteDeployment yields event DeploymentCompleted is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The deployment to complete.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completion time"
      described as {
        |When the deployment completed.
      }
    }
  } with {
    briefly "Marks a deployment as successfully completed"
    described as {
      |Finalizes a deployment after successful verification.
    }
  }
  command RollbackDeployment yields event DeploymentRolledBack is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The deployment to roll back.
      }
    }
    reason: String(1,500) with {
      briefly "Rollback reason"
      described as {
        |Why the rollback was initiated.
      }
    }
    rolledBackBy: String(1,100) with {
      briefly "Rolled back by"
      described as {
        |User or system that initiated the rollback.
      }
    }
    restoreArtifactId: ArtifactId with {
      briefly "Artifact to restore"
      described as {
        |The previous stable artifact the rollback returns the environment to.
      }
    }
  } with {
    briefly "Initiates rollback to the previous deployment"
    described as {
      | Triggers a rollback of the current deployment to the previous
      | stable version. This can be initiated manually or automatically.
    }
  }
  // Events
  event DeploymentInitiated is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The deployment that was initiated.
      }
    }
    artifactId: ArtifactId with {
      briefly "Artifact reference"
      described as {
        |The artifact being deployed.
      }
    }
    targetEnvironment: EnvironmentId with {
      briefly "Target environment"
      described as {
        |Where the artifact will be deployed.
      }
    }
    initiatedBy: String(1,100) with {
      briefly "Initiated by"
      described as {
        |Who initiated the deployment.
      }
    }
    initiatedAt: TimeStamp with {
      briefly "Initiated at"
      described as {
        |When the deployment was initiated.
      }
    }
    deploymentStrategy: DeploymentStrategy with {
      briefly "Deployment strategy"
    }
    healthCheckUrl: URL with {
      briefly "Health check url"
    }
    timeoutMinutes: Integer with {
      briefly "Timeout minutes"
    }
    requiresApproval: Boolean with {
      briefly "Requires approval"
    }
  } with {
    briefly "A deployment has been initiated"
    described as {
      |Records that a new deployment request has been created.
    }
  }
  event DeploymentAwaitingApproval is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The deployment awaiting approval.
      }
    }
    targetEnvironment: EnvironmentId with {
      briefly "Target environment"
      described as {
        |The environment requiring approval.
      }
    }
    requestedAt: TimeStamp with {
      briefly "Requested at"
      described as {
        |When approval was requested.
      }
    }
  } with {
    briefly "A deployment is waiting for approval"
    described as {
      |Indicates that a deployment requires manual approval.
    }
  }
  event DeploymentApproved is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The approved deployment.
      }
    }
    approvedBy: String(1,100) with {
      briefly "Approved by"
      described as {
        |Who approved the deployment.
      }
    }
    approvalNotes: String(1,500)? with {
      briefly "Approval notes"
      described as {
        |Notes from the approver.
      }
    }
    approvedAt: TimeStamp with {
      briefly "Approved at"
      described as {
        |When approval was granted.
      }
    }
  } with {
    briefly "A deployment has been approved"
    described as {
      |Records that a deployment received required approval.
    }
  }
  event DeploymentStarted is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The deployment that started.
      }
    }
    artifactId: ArtifactId with {
      briefly "Artifact reference"
      described as {
        |The artifact being deployed.
      }
    }
    targetEnvironment: EnvironmentId with {
      briefly "Target environment"
      described as {
        |Where deployment is executing.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started at"
      described as {
        |When execution began.
      }
    }
  } with {
    briefly "Deployment execution has started"
    described as {
      |Records that the actual deployment process has begun.
    }
  }
  event DeploymentVerified is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The verified deployment.
      }
    }
    healthCheckPassed: Boolean with {
      briefly "Health check result"
      described as {
        |Whether health checks passed.
      }
    }
    verifiedAt: TimeStamp with {
      briefly "Verified at"
      described as {
        |When verification completed.
      }
    }
  } with {
    briefly "Deployment verification has completed"
    described as {
      |Records the results of post-deployment verification.
    }
  }
  event DeploymentCompleted is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The completed deployment.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed at"
      described as {
        |When deployment completed.
      }
    }
    durationMinutes: Integer with {
      briefly "Duration"
      described as {
        |Total deployment duration in minutes.
      }
    }
  } with {
    briefly "Deployment has completed successfully"
    described as {
      |Records that a deployment has completed all stages.
    }
  }
  event DeploymentFailed is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The failed deployment.
      }
    }
    failureReason: String(1,500) with {
      briefly "Failure reason"
      described as {
        |Why the deployment failed.
      }
    }
    failedAt: TimeStamp with {
      briefly "Failed at"
      described as {
        |When the failure occurred.
      }
    }
  } with {
    briefly "Deployment has failed"
    described as {
      |Records that a deployment failed during execution.
    }
  }
  event DeploymentRolledBack is {
    deploymentId: DeploymentId with {
      briefly "Deployment identifier"
      described as {
        |The rolled back deployment.
      }
    }
    previousArtifactId: ArtifactId with {
      briefly "Previous artifact"
      described as {
        |The artifact that was restored.
      }
    }
    rollbackReason: String(1,500) with {
      briefly "Rollback reason"
      described as {
        |Why the rollback occurred.
      }
    }
    rolledBackBy: String(1,100) with {
      briefly "Rolled back by"
      described as {
        |Who initiated the rollback.
      }
    }
    rolledBackAt: TimeStamp with {
      briefly "Rolled back at"
      described as {
        |When the rollback completed.
      }
    }
  } with {
    briefly "Deployment has been rolled back"
    described as {
      |Records that a deployment was rolled back.
    }
  }
  // State Records
  record PendingData is {
    deploymentId: DeploymentId with {
      briefly "ID"
      described as {
        |Deployment ID.
      }
    }
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |Artifact to deploy.
      }
    }
    targetEnvironment: EnvironmentId with {
      briefly "Environment"
      described as {
        |Target environment.
      }
    }
    deploymentStrategy: DeploymentStrategy with {
      briefly "Strategy"
      described as {
        |Deployment strategy.
      }
    }
    healthCheckUrl: URL with {
      briefly "Health URL"
      described as {
        |Health check endpoint.
      }
    }
    timeoutMinutes: Integer with {
      briefly "Timeout"
      described as {
        |Timeout in minutes.
      }
    }
    requiresApproval: Boolean with {
      briefly "Needs approval"
      described as {
        |Approval required.
      }
    }
    initiatedBy: String(1,100) with {
      briefly "Initiated by"
      described as {
        |Who initiated.
      }
    }
    initiatedAt: TimeStamp with {
      briefly "Initiated at"
      described as {
        |When initiated.
      }
    }
  } with {
    briefly "Initial deployment data"
    described as {
      |State data for a newly created deployment.
    }
  }
  record AwaitingApprovalData is {
    deploymentId: DeploymentId with {
      briefly "ID"
      described as {
        |Deployment ID.
      }
    }
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |Artifact to deploy.
      }
    }
    targetEnvironment: EnvironmentId with {
      briefly "Environment"
      described as {
        |Target environment.
      }
    }
    deploymentStrategy: DeploymentStrategy with {
      briefly "Strategy"
      described as {
        |Deployment strategy.
      }
    }
    healthCheckUrl: URL with {
      briefly "Health URL"
      described as {
        |Health check endpoint.
      }
    }
    timeoutMinutes: Integer with {
      briefly "Timeout"
      described as {
        |Timeout in minutes.
      }
    }
    initiatedBy: String(1,100) with {
      briefly "Initiated by"
      described as {
        |Who initiated.
      }
    }
    initiatedAt: TimeStamp with {
      briefly "Initiated at"
      described as {
        |When initiated.
      }
    }
    awaitingApprovalSince: TimeStamp with {
      briefly "Awaiting since"
      described as {
        |When approval was requested.
      }
    }
  } with {
    briefly "Data for deployment awaiting approval"
    described as {
      |State data for a deployment waiting for manual approval.
    }
  }
  record ApprovedData is {
    deploymentId: DeploymentId with {
      briefly "ID"
      described as {
        |Deployment ID.
      }
    }
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |Artifact to deploy.
      }
    }
    targetEnvironment: EnvironmentId with {
      briefly "Environment"
      described as {
        |Target environment.
      }
    }
    deploymentStrategy: DeploymentStrategy with {
      briefly "Strategy"
      described as {
        |Deployment strategy.
      }
    }
    healthCheckUrl: URL with {
      briefly "Health URL"
      described as {
        |Health check endpoint.
      }
    }
    timeoutMinutes: Integer with {
      briefly "Timeout"
      described as {
        |Timeout in minutes.
      }
    }
    initiatedBy: String(1,100) with {
      briefly "Initiated by"
      described as {
        |Who initiated.
      }
    }
    approvedBy: String(1,100) with {
      briefly "Approved by"
      described as {
        |Who approved.
      }
    }
    approvalNotes: String(1,500)? with {
      briefly "Notes"
      described as {
        |Approval notes.
      }
    }
    approvedAt: TimeStamp with {
      briefly "Approved at"
      described as {
        |When approved.
      }
    }
  } with {
    briefly "Data for approved deployment"
    described as {
      |State data for a deployment that has received approval.
    }
  }
  record InProgressData is {
    deploymentId: DeploymentId with {
      briefly "ID"
      described as {
        |Deployment ID.
      }
    }
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |Artifact being deployed.
      }
    }
    targetEnvironment: EnvironmentId with {
      briefly "Environment"
      described as {
        |Target environment.
      }
    }
    deploymentStrategy: DeploymentStrategy with {
      briefly "Strategy"
      described as {
        |Deployment strategy.
      }
    }
    healthCheckUrl: URL with {
      briefly "Health URL"
      described as {
        |Health check endpoint.
      }
    }
    timeoutMinutes: Integer with {
      briefly "Timeout"
      described as {
        |Timeout in minutes.
      }
    }
    initiatedBy: String(1,100) with {
      briefly "Initiated by"
      described as {
        |Who initiated.
      }
    }
    updatedApprovedBy: String(1,100)? with {
      briefly "Approved by"
      described as {
        |Who approved.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started at"
      described as {
        |When execution started.
      }
    }
    updatedPreviousArtifactId: ArtifactId? with {
      briefly "Previous artifact"
      described as {
        |Previously deployed artifact.
      }
    }
  } with {
    briefly "Data for deployment in progress"
    described as {
      |State data for a deployment currently executing.
    }
  }
  record VerifyingData is {
    deploymentId: DeploymentId with {
      briefly "ID"
      described as {
        |Deployment ID.
      }
    }
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |Artifact deployed.
      }
    }
    targetEnvironment: EnvironmentId with {
      briefly "Environment"
      described as {
        |Target environment.
      }
    }
    healthCheckUrl: URL with {
      briefly "Health URL"
      described as {
        |Health check endpoint.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started at"
      described as {
        |When execution started.
      }
    }
    deployedAt: TimeStamp with {
      briefly "Deployed at"
      described as {
        |When deployment completed.
      }
    }
    updatedPreviousArtifactId: ArtifactId? with {
      briefly "Previous artifact"
      described as {
        |Previously deployed artifact.
      }
    }
  } with {
    briefly "Data for deployment being verified"
    described as {
      |State data for a deployment undergoing verification.
    }
  }
  record CompletedData is {
    deploymentId: DeploymentId with {
      briefly "ID"
      described as {
        |Deployment ID.
      }
    }
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |Artifact deployed.
      }
    }
    targetEnvironment: EnvironmentId with {
      briefly "Environment"
      described as {
        |Target environment.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started at"
      described as {
        |When execution started.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed at"
      described as {
        |When completed.
      }
    }
    durationMinutes: Integer with {
      briefly "Duration"
      described as {
        |Total duration.
      }
    }
    healthCheckPassed: Boolean with {
      briefly "Health passed"
      described as {
        |Verification result.
      }
    }
  } with {
    briefly "Data for completed deployment"
    described as {
      |State data for a successfully completed deployment.
    }
  }
  record FailedData is {
    deploymentId: DeploymentId with {
      briefly "ID"
      described as {
        |Deployment ID.
      }
    }
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |Artifact that failed.
      }
    }
    targetEnvironment: EnvironmentId with {
      briefly "Environment"
      described as {
        |Target environment.
      }
    }
    failureReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why it failed.
      }
    }
    failedAt: TimeStamp with {
      briefly "Failed at"
      described as {
        |When it failed.
      }
    }
  } with {
    briefly "Data for failed deployment"
    described as {
      |State data for a deployment that failed.
    }
  }
  record RolledBackData is {
    deploymentId: DeploymentId with {
      briefly "ID"
      described as {
        |Deployment ID.
      }
    }
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |Artifact that was rolled back.
      }
    }
    targetEnvironment: EnvironmentId with {
      briefly "Environment"
      described as {
        |Target environment.
      }
    }
    previousArtifactId: ArtifactId with {
      briefly "Previous artifact"
      described as {
        |Restored artifact.
      }
    }
    rollbackReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why it was rolled back.
      }
    }
    rolledBackBy: String(1,100) with {
      briefly "Rolled back by"
      described as {
        |Who initiated rollback.
      }
    }
    rolledBackAt: TimeStamp with {
      briefly "Rolled back at"
      described as {
        |When rollback completed.
      }
    }
  } with {
    briefly "Data for rolled back deployment"
    described as {
      |State data for a deployment that was rolled back.
    }
  }
  // Queries
  query GetDeployment replies result DeploymentQueryResult is {
    deploymentId: DeploymentId with {
      briefly "ID"
      described as {
        |Deployment to retrieve.
      }
    }
  } with {
    briefly "Get Deployment"
    described as {
      |Retrieves Deployment data.
    }
  }
  result DeploymentQueryResult is {
    deploymentId: DeploymentId with {
      briefly "ID"
      described as {
        |Deployment identifier.
      }
    }
  } with {
    briefly "Deployment result"
    described as {
      |Deployment data result.
    }
  }
  // States
  state PendingState of record Deployment.PendingData is {
    initial handler PendingStateHandler is {
      on deploymentAwaitingApproval: event DeploymentAwaitingApproval is {
        morph entity Deployment to state Deployment.AwaitingApprovalState with record Deployment.AwaitingApprovalData(deploymentId = deploymentAwaitingApproval.deploymentId, targetEnvironment = deploymentAwaitingApproval.targetEnvironment, awaitingApprovalSince = deploymentAwaitingApproval.requestedAt, artifactId = PendingData.artifactId, deploymentStrategy = PendingData.deploymentStrategy, healthCheckUrl = PendingData.healthCheckUrl, timeoutMinutes = PendingData.timeoutMinutes, initiatedBy = PendingData.initiatedBy, initiatedAt = PendingData.initiatedAt)
      }
      on requestDeploymentApproval: command RequestDeploymentApproval is {
        yield event DeploymentAwaitingApproval(deploymentId = requestDeploymentApproval.deploymentId, targetEnvironment = requestDeploymentApproval.targetEnvironment, requestedAt = system.now)
      }
    } with {
      briefly "While PendingState"
      described as {
        |The commands and folds accepted while the entity is in PendingState.
      }
    }
  } with {
    briefly "Pending state"
    described as {
      |The entity in Pending state.
    }
  }
  state AwaitingApprovalState of record Deployment.AwaitingApprovalData is {
    initial handler AwaitingApprovalStateHandler is {
      on deploymentApproved: event DeploymentApproved is {
        morph entity Deployment to state Deployment.ApprovedState with record Deployment.ApprovedData(deploymentId = deploymentApproved.deploymentId, approvedBy = deploymentApproved.approvedBy, approvalNotes = deploymentApproved.approvalNotes, artifactId = AwaitingApprovalData.artifactId, targetEnvironment = AwaitingApprovalData.targetEnvironment, deploymentStrategy = AwaitingApprovalData.deploymentStrategy, healthCheckUrl = AwaitingApprovalData.healthCheckUrl, timeoutMinutes = AwaitingApprovalData.timeoutMinutes, initiatedBy = AwaitingApprovalData.initiatedBy, approvedAt = deploymentApproved.approvedAt)
      }
      on approveDeployment: command ApproveDeployment is {
        yield event DeploymentApproved(deploymentId = approveDeployment.deploymentId, approvedBy = approveDeployment.approvedBy, approvalNotes = approveDeployment.approvalNotes, approvedAt = system.now)
      }
    } with {
      briefly "While AwaitingApprovalState"
      described as {
        |The commands and folds accepted while the entity is in AwaitingApprovalState.
      }
    }
  } with {
    briefly "AwaitingApproval state"
    described as {
      |The entity in AwaitingApproval state.
    }
  }
  state ApprovedState of record Deployment.ApprovedData is {
    initial handler ApprovedStateHandler is {
      on deploymentStarted: event DeploymentStarted is {
        morph entity Deployment to state Deployment.InProgressState with record Deployment.InProgressData(deploymentId = deploymentStarted.deploymentId, artifactId = deploymentStarted.artifactId, targetEnvironment = deploymentStarted.targetEnvironment, deploymentStrategy = ApprovedData.deploymentStrategy, healthCheckUrl = ApprovedData.healthCheckUrl, timeoutMinutes = ApprovedData.timeoutMinutes, initiatedBy = ApprovedData.initiatedBy, updatedApprovedBy = empty, startedAt = deploymentStarted.startedAt, updatedPreviousArtifactId = empty)
      }
      on executeDeployment: command ExecuteDeployment is {
        yield event DeploymentStarted(deploymentId = executeDeployment.deploymentId, artifactId = Deployment.ApprovedState.artifactId, targetEnvironment = Deployment.ApprovedState.targetEnvironment, startedAt = system.now)
      }
    } with {
      briefly "While ApprovedState"
      described as {
        |The commands and folds accepted while the entity is in ApprovedState.
      }
    }
  } with {
    briefly "Approved state"
    described as {
      |The entity in Approved state.
    }
  }
  state InProgressState of record Deployment.InProgressData is {
    initial handler InProgressStateHandler is {
      on deploymentRolledBack: event DeploymentRolledBack is {
        morph entity Deployment to state Deployment.RolledBackState with record Deployment.RolledBackData(deploymentId = deploymentRolledBack.deploymentId, rolledBackBy = deploymentRolledBack.rolledBackBy, artifactId = InProgressData.artifactId, targetEnvironment = InProgressData.targetEnvironment, previousArtifactId = deploymentRolledBack.previousArtifactId, rollbackReason = deploymentRolledBack.rollbackReason, rolledBackAt = deploymentRolledBack.rolledBackAt)
      }
      on deploymentVerified: event DeploymentVerified is {
        morph entity Deployment to state Deployment.VerifyingState with record Deployment.VerifyingData(deploymentId = deploymentVerified.deploymentId, artifactId = InProgressData.artifactId, targetEnvironment = InProgressData.targetEnvironment, healthCheckUrl = InProgressData.healthCheckUrl, startedAt = InProgressData.startedAt, deployedAt = prompt("the deployed at of this verifying data"), updatedPreviousArtifactId = empty)
      }
      on deploymentFailed: event DeploymentFailed is {
        morph entity Deployment to state Deployment.FailedState with record Deployment.FailedData(deploymentId = deploymentFailed.deploymentId, failureReason = deploymentFailed.failureReason, failedAt = deploymentFailed.failedAt, artifactId = InProgressData.artifactId, targetEnvironment = InProgressData.targetEnvironment)
      }
      on rollbackDeployment: command RollbackDeployment is {
        yield event DeploymentRolledBack(deploymentId = rollbackDeployment.deploymentId, rolledBackBy = rollbackDeployment.rolledBackBy, previousArtifactId = rollbackDeployment.restoreArtifactId, rollbackReason = rollbackDeployment.reason, rolledBackAt = system.now)
      }
      on verifyDeployment: command VerifyDeployment is {
        yield event DeploymentVerified(deploymentId = verifyDeployment.deploymentId, healthCheckPassed = verifyDeployment.healthCheckPassed, verifiedAt = system.now)
      }
      on failDeployment: command FailDeployment is {
        yield event DeploymentFailed(deploymentId = failDeployment.deploymentId, failureReason = failDeployment.failureReason, failedAt = system.now)
      }
    } with {
      briefly "While InProgressState"
      described as {
        |The commands and folds accepted while the entity is in InProgressState.
      }
    }
  } with {
    briefly "InProgress state"
    described as {
      |The entity in InProgress state.
    }
  }
  state VerifyingState of record Deployment.VerifyingData is {
    initial handler VerifyingStateHandler is {
      on deploymentCompleted: event DeploymentCompleted is {
        morph entity Deployment to state Deployment.CompletedState with record Deployment.CompletedData(deploymentId = deploymentCompleted.deploymentId, completedAt = deploymentCompleted.completedAt, artifactId = VerifyingData.artifactId, targetEnvironment = VerifyingData.targetEnvironment, startedAt = VerifyingData.startedAt, durationMinutes = deploymentCompleted.durationMinutes, healthCheckPassed = prompt("the health check passed of this completed data"))
      }
      on deploymentRolledBack: event DeploymentRolledBack is {
        morph entity Deployment to state Deployment.RolledBackState with record Deployment.RolledBackData(deploymentId = deploymentRolledBack.deploymentId, rolledBackBy = deploymentRolledBack.rolledBackBy, artifactId = VerifyingData.artifactId, targetEnvironment = VerifyingData.targetEnvironment, previousArtifactId = deploymentRolledBack.previousArtifactId, rollbackReason = deploymentRolledBack.rollbackReason, rolledBackAt = deploymentRolledBack.rolledBackAt)
      }
      on deploymentFailed: event DeploymentFailed is {
        morph entity Deployment to state Deployment.FailedState with record Deployment.FailedData(deploymentId = deploymentFailed.deploymentId, failureReason = deploymentFailed.failureReason, failedAt = deploymentFailed.failedAt, artifactId = VerifyingData.artifactId, targetEnvironment = VerifyingData.targetEnvironment)
      }
      on completeDeployment: command CompleteDeployment is {
        yield event DeploymentCompleted(deploymentId = completeDeployment.deploymentId, completedAt = completeDeployment.completedAt, durationMinutes = minutes of (completeDeployment.completedAt - Deployment.VerifyingState.startedAt))
      }
      on rollbackDeployment: command RollbackDeployment is {
        yield event DeploymentRolledBack(deploymentId = rollbackDeployment.deploymentId, rolledBackBy = rollbackDeployment.rolledBackBy, previousArtifactId = rollbackDeployment.restoreArtifactId, rollbackReason = rollbackDeployment.reason, rolledBackAt = system.now)
      }
      on failDeployment: command FailDeployment is {
        yield event DeploymentFailed(deploymentId = failDeployment.deploymentId, failureReason = failDeployment.failureReason, failedAt = system.now)
      }
    } with {
      briefly "While VerifyingState"
      described as {
        |The commands and folds accepted while the entity is in VerifyingState.
      }
    }
  } with {
    briefly "Verifying state"
    described as {
      |The entity in Verifying state.
    }
  }
  state CompletedState of record Deployment.CompletedData with {
    briefly "Completed state"
    described as {
      |The entity in Completed state.
    }
  }
  state FailedState of record Deployment.FailedData is {
    initial handler FailedStateHandler is {
      on deploymentRolledBack: event DeploymentRolledBack is {
        morph entity Deployment to state Deployment.RolledBackState with record Deployment.RolledBackData(deploymentId = deploymentRolledBack.deploymentId, rolledBackBy = deploymentRolledBack.rolledBackBy, artifactId = FailedData.artifactId, targetEnvironment = FailedData.targetEnvironment, previousArtifactId = deploymentRolledBack.previousArtifactId, rollbackReason = deploymentRolledBack.rollbackReason, rolledBackAt = deploymentRolledBack.rolledBackAt)
      }
      on rollbackDeployment: command RollbackDeployment is {
        yield event DeploymentRolledBack(deploymentId = rollbackDeployment.deploymentId, rolledBackBy = rollbackDeployment.rolledBackBy, previousArtifactId = rollbackDeployment.restoreArtifactId, rollbackReason = rollbackDeployment.reason, rolledBackAt = system.now)
      }
    } with {
      briefly "While FailedState"
      described as {
        |The commands and folds accepted while the entity is in FailedState.
      }
    }
  } with {
    briefly "Failed state"
    described as {
      |The entity in Failed state.
    }
  }
  state RolledBackState of record Deployment.RolledBackData with {
    briefly "RolledBack state"
    described as {
      |The entity in RolledBack state.
    }
  }
  // Handler
  handler DeploymentHandler is {
    on init(artifactId: type ArtifactId, targetEnvironment: type EnvironmentId, initiatedBy: String(1,100), initiatedAt: TimeStamp, deploymentStrategy: type DeploymentStrategy, healthCheckUrl: URL("https"), timeoutMinutes: Integer, requiresApproval: Boolean) is {
      morph entity Deployment to state Deployment.PendingState with record Deployment.PendingData(deploymentId = self.id, artifactId = artifactId, targetEnvironment = targetEnvironment, deploymentStrategy = deploymentStrategy, healthCheckUrl = healthCheckUrl, timeoutMinutes = timeoutMinutes, requiresApproval = requiresApproval, initiatedBy = initiatedBy, initiatedAt = prompt("the initiated at of this pending data"))
      send event DeploymentInitiated(deploymentId = self.id, artifactId = artifactId, targetEnvironment = targetEnvironment, initiatedBy = initiatedBy, initiatedAt = initiatedAt, deploymentStrategy = deploymentStrategy, healthCheckUrl = healthCheckUrl, timeoutMinutes = timeoutMinutes, requiresApproval = requiresApproval) to outlet DeploymentContext.Deployment.DeploymentEvents
    }
    on getDeployment: query GetDeployment is {
      reply result DeploymentQueryResult(deploymentId = getDeployment.deploymentId)
    }
  } with {
    briefly "Handles deployment lifecycle commands"
    described as {
      | Processes all deployment commands, managing state transitions
      | and emitting appropriate events throughout the deployment lifecycle.
    }
  }
} with {
  briefly "Aggregate entity managing deployment lifecycle"
  described as {
    | The Deployment entity is the core aggregate for managing the complete
    | lifecycle of a software deployment. It tracks deployments from initiation
    | through approval, execution, verification, and completion or rollback.
  }
}
