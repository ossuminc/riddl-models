// Deployment Pipeline Domain
// Software deployment lifecycle from initiation through completion
// // This domain model manages deployments from initial request through approval,
// execution, verification, and completion, including rollback capabilities.
domain DeploymentPipeline is {
  persistent connector 'ArtifactRegistryEvent Stream' is from outlet ArtifactRegistry.ArtifactRegistryEventsOut to inlet DeploymentContext.FromArtifactRegistry.FromArtifactRegistryIn with {
    briefly "What ArtifactRegistry tells DeploymentContext, unasked"
  }
  persistent connector 'InfrastructureServiceEvent Stream' is from outlet InfrastructureService.InfrastructureServiceEventsOut to inlet DeploymentContext.FromInfrastructureService.FromInfrastructureServiceIn with {
    briefly "What InfrastructureService tells DeploymentContext, unasked"
  }
  persistent connector 'MonitoringServiceEvent Stream' is from outlet MonitoringService.MonitoringServiceEventsOut to inlet DeploymentContext.FromMonitoringService.FromMonitoringServiceIn with {
    briefly "What MonitoringService tells DeploymentContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
    organization ="Ossum Inc."
  } with {
    briefly "Organization providing deployment pipeline solutions"
    described as {
      | Ossum Inc. develops reactive, event-driven software solutions
      | for modern DevOps and continuous delivery workflows.
    }
  }
  // Users who interact with this domain
  user ReleaseManager is "Person who approves and manages releases" with {
    briefly "Manages release schedules and deployment approvals"
    described as {
      | The Release Manager oversees the deployment lifecycle, approves
      | production deployments, coordinates release windows, and ensures
      | compliance with change management policies.
    }
  }
  user DevOpsEngineer is "Engineer who configures deployment infrastructure" with {
    briefly "Configures and maintains deployment infrastructure"
    described as {
      | The DevOps Engineer designs deployment pipelines, configures
      | environments, troubleshoots deployment failures, and implements
      | automation for continuous delivery processes.
    }
  }
  user Developer is "Developer who initiates deployments" with {
    briefly "Initiates deployments and monitors application health"
    described as {
      | The Developer triggers deployments from CI/CD pipelines, monitors
      | deployment progress, validates application functionality after
      | deployment, and requests rollbacks when issues are detected.
    }
  }
  // Include domain types
  include "types.riddl"
  // Include the main bounded context
  include "DeploymentContext.riddl"
  // Include external system contexts
  include "external-contexts.riddl"
  // Epic for deployment automation
  epic DeploymentAutomationEpic is {
    user ReleaseManager wants to "automate deployment approvals and tracking" so that "release cycles are faster and audit trails are maintained"
    case AutomateApprovals is {
      user ReleaseManager wants to "configure automated approval rules" so that "deployments to non-production environments proceed automatically"
      step is "Release Manager defines approval rules" "for each environment" "to configure"
      step is "System evaluates deployment request" "against rules" "to determine approval"
      step is "System auto-approves" "if rules permit" "to proceed"
    } with {
      briefly "Automated approval workflow configuration"
      described as {
        | Enable release managers to configure rules that automatically
        | approve deployments to certain environments based on criteria
        | such as environment type, artifact source, or time of day.
      }
    }
    case OrchestrateDeployments is {
      user DevOpsEngineer wants to "orchestrate multi-environment deployments" so that "applications are consistently deployed across all stages"
      step is "DevOps Engineer configures pipeline" "with environment sequence" "to define flow"
      step is "System deploys to each environment" "in sequence" "to promote"
      step is "System verifies each deployment" "before proceeding" "to validate"
    } with {
      briefly "Multi-environment deployment orchestration"
      described as {
        | Enable DevOps engineers to define deployment pipelines that
        | promote artifacts through environments in sequence, with
        | verification gates between each stage.
      }
    }
    case DeployWithConfidence is {
      user Developer wants to "deploy code changes with confidence" so that "features reach production quickly and safely"
      step is "Developer triggers deployment" "from CI/CD" "to initiate"
      step is "System executes deployment" "with chosen strategy" "to deploy"
      step is "System runs verification checks" "and reports status" "to validate"
      step is "Developer initiates rollback" "if issues detected" "to recover"
    } with {
      briefly "Developer deployment confidence workflow"
      described as {
        | Enable developers to deploy their changes knowing that
        | automated verification and easy rollback provide safety
        | nets for catching and recovering from issues.
      }
    }
  } with {
    briefly "Automates the software deployment lifecycle"
    described as {
      | The Deployment Automation epic encompasses all capabilities needed
      | to automate software deployments from development through production.
      | This includes artifact management, environment configuration,
      | deployment orchestration, verification, and rollback procedures.
    }
  }
  application context DeploymentPipelineApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in DeploymentPipeline are delivered.
      }
    }
    group DeploymentPipelineScreen is {
      input FindRecentDeploymentsInput acquires query DeploymentContext.DeploymentRepository.FindRecentDeployments with {
        briefly "Find recent deployments control"
        described as {
          |The control through which a user asks the find recent deployments question.
        }
      }
      input FindDeploymentsByStatusInput acquires query DeploymentContext.DeploymentRepository.FindDeploymentsByStatus with {
        briefly "Find deployments by status control"
        described as {
          |The control through which a user asks the find deployments by status question.
        }
      }
      input FindDeploymentsByEnvironmentInput acquires query DeploymentContext.DeploymentRepository.FindDeploymentsByEnvironment with {
        briefly "Find deployments by environment control"
        described as {
          |The control through which a user asks the find deployments by environment question.
        }
      }
      input FindDeploymentByIdInput acquires query DeploymentContext.DeploymentRepository.FindDeploymentById with {
        briefly "Find deployment by id control"
        described as {
          |The control through which a user asks the find deployment by id question.
        }
      }
      input GetDeploymentMetricsSummaryInput acquires query DeploymentContext.GetDeploymentMetricsSummary with {
        briefly "Get deployment metrics summary control"
        described as {
          |The control through which a user asks the get deployment metrics summary question.
        }
      }
      input GetEnvironmentInput acquires query DeploymentContext.Environment.GetEnvironment with {
        briefly "Get environment control"
        described as {
          |The control through which a user asks the get environment question.
        }
      }
      input GetDeploymentInput acquires query DeploymentContext.Deployment.GetDeployment with {
        briefly "Get deployment control"
        described as {
          |The control through which a user asks the get deployment question.
        }
      }
      input ApproveDeploymentInput acquires command DeploymentContext.Deployment.ApproveDeployment with {
        briefly "Approve deployment control"
        described as {
          |The control through which a user submits the approve deployment request.
        }
      }
      input CompleteDeploymentInput acquires command DeploymentContext.Deployment.CompleteDeployment with {
        briefly "Complete deployment control"
        described as {
          |The control through which a user submits the complete deployment request.
        }
      }
      input ExecuteDeploymentInput acquires command DeploymentContext.Deployment.ExecuteDeployment with {
        briefly "Execute deployment control"
        described as {
          |The control through which a user submits the execute deployment request.
        }
      }
      input RollbackDeploymentInput acquires command DeploymentContext.Deployment.RollbackDeployment with {
        briefly "Rollback deployment control"
        described as {
          |The control through which a user submits the rollback deployment request.
        }
      }
      input InitiateDeploymentInput acquires command DeploymentContext.InitiateDeployment with {
        briefly "Initiate deployment control"
        described as {
          |The control through which a user submits the initiate deployment request.
        }
      }
      output DeploymentInitiatedView presents event DeploymentContext.Deployment.DeploymentInitiated with {
        briefly "The deployment initiated answer"
        described as {
          |What InitiateDeployment brought into being, with the id it was given.
        }
      }
      input RegisterEnvironmentInput acquires command DeploymentContext.RegisterEnvironment with {
        briefly "Register environment control"
        described as {
          |The control through which a user submits the register environment request.
        }
      }
      input RequestDeploymentApprovalInput acquires command DeploymentContext.Deployment.RequestDeploymentApproval with {
        briefly "Request approval control"
        described as {
          |The control through which a release engineer holds a deployment for
          |approval before it proceeds.
        }
      }
    } with {
      briefly "Deployment pipeline screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppDeploymentRepositoryQueries is type DeploymentContext.DeploymentRepository.DeploymentRepositoryQuery
    inlet AppDeploymentRepositoryReplies is type DeploymentContext.DeploymentRepository.DeploymentRepositoryReply
    outlet AppEnvironmentQueries is query DeploymentContext.Environment.GetEnvironment
    inlet AppEnvironmentReplies is result DeploymentContext.Environment.EnvironmentResult
    outlet AppDeploymentQueries is query DeploymentContext.Deployment.GetDeployment
    outlet AppDeploymentCommands is type DeploymentContext.DeploymentRequest
    outlet AppEnvironmentCommands is type DeploymentContext.EnvironmentRequest
    inlet AppDeploymentRepositoryResponses is result DeploymentContext.Deployment.DeploymentQueryResult
    inlet AppDeploymentInitiatedAnswer is event DeploymentContext.Deployment.DeploymentInitiated
    handler DeploymentPipelineAppHandler is {
      on deploymentInitiated: event DeploymentContext.Deployment.DeploymentInitiated is {
        put deploymentInitiated to output DeploymentPipelineApp.DeploymentPipelineScreen.DeploymentInitiatedView
      }
      on other is {
        error "Unexpected message for application context DeploymentPipelineApp"
      }
    } with {
      briefly "DeploymentPipelineApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "DeploymentPipelineApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'MonitoringServiceRequest Stream' is from outlet DeploymentContext.ToMonitoringService.ToMonitoringServiceOut to inlet MonitoringService.MonitoringServiceRequests with {
    briefly "What DeploymentContext asks MonitoringService to send"
  }
  persistent connector 'InfrastructureServiceRequest Stream' is from outlet DeploymentContext.ToInfrastructureService.ToInfrastructureServiceOut to inlet InfrastructureService.InfrastructureServiceRequests with {
    briefly "What DeploymentContext asks InfrastructureService to send"
  }
  persistent connector 'ArtifactRegistryRequest Stream' is from outlet DeploymentContext.ToArtifactRegistry.ToArtifactRegistryOut to inlet ArtifactRegistry.ArtifactRegistryRequests with {
    briefly "What DeploymentContext asks ArtifactRegistry to send"
  }
  persistent connector 'DeploymentInitiated Answer' is from outlet DeploymentContext.DeploymentInitiatedAnswerOut to inlet DeploymentPipelineApp.AppDeploymentInitiatedAnswer with {
    briefly "The deployment initiated answer, back to the screen that issued InitiateDeployment"
  }
  persistent connector 'DeploymentRepositoryQuery Stream' is from outlet DeploymentPipelineApp.AppDeploymentRepositoryQueries to inlet DeploymentContext.DeploymentRepositoryQueriesIn with {
    briefly "DeploymentPipelineApp's look-ups of the deployment repository"
  }
  persistent connector 'DeploymentRepositoryReply Stream' is from outlet DeploymentContext.DeploymentRepositoryRepliesOut to inlet DeploymentPipelineApp.AppDeploymentRepositoryReplies with {
    briefly "The deployment repository's answers returned to DeploymentPipelineApp"
  }
  persistent connector 'EnvironmentQuery Stream' is from outlet DeploymentPipelineApp.AppEnvironmentQueries to inlet DeploymentContext.EnvironmentQueriesIn with {
    briefly "DeploymentPipelineApp's look-ups of the environment"
  }
  persistent connector 'EnvironmentReply Stream' is from outlet DeploymentContext.EnvironmentRepliesOut to inlet DeploymentPipelineApp.AppEnvironmentReplies with {
    briefly "The environment's answers returned to DeploymentPipelineApp"
  }
  persistent connector 'DeploymentQuery Stream' is from outlet DeploymentPipelineApp.AppDeploymentQueries to inlet DeploymentContext.DeploymentQueriesIn with {
    briefly "DeploymentPipelineApp's look-ups of the deployment"
  }
  persistent connector 'DeploymentCommand Stream' is from outlet DeploymentPipelineApp.AppDeploymentCommands to inlet DeploymentContext.DeploymentCommandStreamIn with {
    briefly "Deployment commands from the application"
  }
  persistent connector 'EnvironmentCommand Stream' is from outlet DeploymentPipelineApp.AppEnvironmentCommands to inlet DeploymentContext.EnvironmentCommandStreamIn with {
    briefly "Environment commands from the application"
  }
  persistent connector 'DeploymentQueryResult Stream' is from outlet DeploymentContext.DeploymentQueryResultStreamOut to inlet DeploymentPipelineApp.AppDeploymentRepositoryResponses with {
    briefly "Deployment query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet DeploymentPipelineApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Domain for managing software deployment pipelines"
  described as {
    | The Deployment Pipeline domain models the complete lifecycle of
    | deploying software artifacts across environments. It supports
    | continuous delivery practices including automated deployments,
    | approval workflows, deployment verification, and rollback
    | capabilities for maintaining system reliability.
  }
}
