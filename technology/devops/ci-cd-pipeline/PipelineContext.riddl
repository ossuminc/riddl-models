// CI/CD Pipeline - Pipeline Context
context PipelineContext as router is {
  inlet PipelineContextFromArtifactStorageService is command Pipeline.StoreArtifact with {
    briefly "What FromArtifactStorageService makes of that service's news"
  }
  connector 'FromArtifactStorageService Intake' is from outlet PipelineContext.FromArtifactStorageService.FromArtifactStorageServiceToPipelineContext to inlet PipelineContext.PipelineContextFromArtifactStorageService with {
    briefly "What FromArtifactStorageService makes of that news, on its way in"
  }
  inlet PipelineContextFromDeploymentOrchestratorService is command Pipeline.CompleteStage with {
    briefly "What FromDeploymentOrchestratorService makes of that service's news"
  }
  connector 'FromDeploymentOrchestratorService Intake' is from outlet PipelineContext.FromDeploymentOrchestratorService.FromDeploymentOrchestratorServiceToPipelineContext to inlet PipelineContext.PipelineContextFromDeploymentOrchestratorService with {
    briefly "What FromDeploymentOrchestratorService makes of that news, on its way in"
  }
  inlet PipelineCommandStreamIn is type PipelineCommand  outlet PipelineCommandStreamOut is type PipelineCommand
  inlet PipelineResultStreamIn is result Pipeline.PipelineResult  outlet PipelineResultStreamOut is result Pipeline.PipelineResult
  handler PipelineContextBoundary is {
    on createPipeline: command Pipeline.CreatePipeline is {
      send createPipeline to outlet PipelineContext.PipelineCommandStreamOut
    }
    on startPipeline: command Pipeline.StartPipeline is {
      send startPipeline to outlet PipelineContext.PipelineCommandStreamOut
    }
    on completeStage: command Pipeline.CompleteStage is {
      send completeStage to outlet PipelineContext.PipelineCommandStreamOut
    }
    on storeArtifact: command Pipeline.StoreArtifact is {
      send storeArtifact to outlet PipelineContext.PipelineCommandStreamOut
    }
    on requestApproval: command Pipeline.RequestApproval is {
      send requestApproval to outlet PipelineContext.PipelineCommandStreamOut
    }
    on approveDeployment: command Pipeline.ApproveDeployment is {
      send approveDeployment to outlet PipelineContext.PipelineCommandStreamOut
    }
    on rejectDeployment: command Pipeline.RejectDeployment is {
      send rejectDeployment to outlet PipelineContext.PipelineCommandStreamOut
    }
    on cancelPipeline: command Pipeline.CancelPipeline is {
      send cancelPipeline to outlet PipelineContext.PipelineCommandStreamOut
    }
    on completePipeline: command Pipeline.CompletePipeline is {
      send completePipeline to outlet PipelineContext.PipelineCommandStreamOut
    }
    on pipelineResult: result Pipeline.PipelineResult is {
      send pipelineResult to outlet PipelineContext.PipelineResultStreamOut
    }
    on other is {
      error "Unexpected message at the PipelineContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PipelineCommand Stream Intake' is from outlet PipelineContext.PipelineCommandStreamOut to inlet PipelineContext.Pipeline.PipelineCommands  connector 'PipelineResult Stream Egress' is from outlet PipelineContext.PipelineRepository.PipelineRepositoryResponses to inlet PipelineContext.PipelineResultStreamIn  adaptor FromArtifactStorageService from context ArtifactStorageService as flow is { 
    inlet FromArtifactStorageServiceIn is event ArtifactStorageService.ArtifactUploaded    outlet FromArtifactStorageServiceToPipelineContext is command Pipeline.StoreArtifact
    handler FromArtifactStorageServiceHandler is {
      on artifactUploaded: event ArtifactStorageService.ArtifactUploaded is {
        let item0: type Pipeline.StoreArtifact = prompt("translate the artifactUploaded event into a StoreArtifact, an uploaded artifact and its location are what the pipeline records as stored")
        send item0 to outlet PipelineContext.FromArtifactStorageService.FromArtifactStorageServiceToPipelineContext
      }
      on other is {
        error "Unexpected message for adaptor FromArtifactStorageService"
      }
    } with {
      briefly "from artifact storage service"
      described as {
        |Carries messages from the external ArtifactStorageService.
      }
    }
  } with {
    briefly "ArtifactStorageService integration"
    described as {
      |The model's side of the ArtifactStorageService conversation.
    }
  }
  adaptor ToArtifactStorageService to context ArtifactStorageService as merge is { 
    inlet ToArtifactStorageServiceIn is type PipelineEvent    inlet ToArtifactStorageServiceReplies is result ArtifactStorageService.ArtifactDownloadUrl    outlet ToArtifactStorageServiceOut is type ArtifactStorageService.ArtifactStorageServiceRequest
    handler ToArtifactStorageServiceHandler is {
      on stageCompleted: event StageCompleted is {
        let notice: type ArtifactStorageService.UploadArtifact = prompt("translate the stageCompleted event into an UploadArtifact keeping what the stage built, since later stages and rollbacks need it")
        send notice to outlet PipelineContext.ToArtifactStorageService.ToArtifactStorageServiceOut
      }
      on deploymentApproved: event Pipeline.DeploymentApproved is {
        let askAnswer: type ArtifactStorageService.ArtifactDownloadUrl = ask query ArtifactStorageService.DownloadArtifact of context ArtifactStorageService
        do "an approved deployment needing the artifact it will actually ship"
      }
      on other is {
        error "Unexpected message for adaptor ToArtifactStorageService"
      }
    } with {
      briefly "to artifact storage service"
      described as {
        |Carries messages to the external ArtifactStorageService.
      }
    }
  } with {
    briefly "ArtifactStorageService integration"
    described as {
      |The model's side of the ArtifactStorageService conversation.
    }
  }
  adaptor FromContainerRegistryService from context ContainerRegistryService as sink is { 
    inlet FromContainerRegistryServiceIn is type ContainerRegistryService.ContainerRegistryServiceEvent    handler FromContainerRegistryServiceHandler is {
      on imagePushed: event ContainerRegistryService.ImagePushed is {
        do "the registry has the image; storing the artifact was recorded here"
      }
      on imageScanned: event ContainerRegistryService.ImageScanned is {
        do "the scan is done; a reviewer reads it before approving deployment"
      }
      on other is {
        error "Unexpected message for adaptor FromContainerRegistryService"
      }
    } with {
      briefly "from container registry service"
      described as {
        |Carries messages from the external ContainerRegistryService.
      }
    }
  } with {
    briefly "ContainerRegistryService integration"
    described as {
      |The model's side of the ContainerRegistryService conversation.
    }
  }
  adaptor ToContainerRegistryService to context ContainerRegistryService as flow is { 
    inlet ToContainerRegistryServiceIn is type PipelineEvent    outlet ToContainerRegistryServiceOut is type ContainerRegistryService.ContainerRegistryServiceCommand
    handler ToContainerRegistryServiceHandler is {
      on artifactStored: event Pipeline.ArtifactStored is {
        let item0: type ContainerRegistryService.PushImage = prompt("translate the artifactStored event into a PushImage, a built artifact being what a registry holds")
        send item0 to outlet PipelineContext.ToContainerRegistryService.ToContainerRegistryServiceOut
        let item1: type ContainerRegistryService.ScanImage = prompt("translate the artifactStored event into a ScanImage, and what must be scanned before anyone runs it")
        send item1 to outlet PipelineContext.ToContainerRegistryService.ToContainerRegistryServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToContainerRegistryService"
      }
    } with {
      briefly "to container registry service"
      described as {
        |Carries messages to the external ContainerRegistryService.
      }
    }
  } with {
    briefly "ContainerRegistryService integration"
    described as {
      |The model's side of the ContainerRegistryService conversation.
    }
  }
  adaptor FromDeploymentOrchestratorService from context DeploymentOrchestratorService as flow is { 
    inlet FromDeploymentOrchestratorServiceIn is type DeploymentOrchestratorService.DeploymentOrchestratorServiceEvent    outlet FromDeploymentOrchestratorServiceToPipelineContext is command Pipeline.CompleteStage
    handler FromDeploymentOrchestratorServiceHandler is {
      on deploymentFailed: event DeploymentOrchestratorService.DeploymentFailed is {
        do "the deployment failed; whether to retry, roll back or cancel is the engineer's call"
      }
      on deploymentRolledBack: event DeploymentOrchestratorService.DeploymentRolledBack is {
        do "the environment is back on the previous build; cancelling was recorded here"
      }
      on deploymentStarted: event DeploymentOrchestratorService.DeploymentStarted is {
        do "the rollout has begun; approving it was recorded here"
      }
      on deploymentSucceeded: event DeploymentOrchestratorService.DeploymentSucceeded is {
        let item0: type Pipeline.CompleteStage = prompt("translate the deploymentSucceeded event into a CompleteStage, a deployment that succeeded completes the deploy stage")
        send item0 to outlet PipelineContext.FromDeploymentOrchestratorService.FromDeploymentOrchestratorServiceToPipelineContext
      }
      on other is {
        error "Unexpected message for adaptor FromDeploymentOrchestratorService"
      }
    } with {
      briefly "from deployment orchestrator service"
      described as {
        |Carries messages from the external DeploymentOrchestratorService.
      }
    }
  } with {
    briefly "DeploymentOrchestratorService integration"
    described as {
      |The model's side of the DeploymentOrchestratorService conversation.
    }
  }
  adaptor ToDeploymentOrchestratorService to context DeploymentOrchestratorService as flow is { 
    inlet ToDeploymentOrchestratorServiceIn is type PipelineEvent    outlet ToDeploymentOrchestratorServiceOut is type DeploymentOrchestratorService.DeploymentOrchestratorServiceCommand
    handler ToDeploymentOrchestratorServiceHandler is {
      on deploymentApproved: event Pipeline.DeploymentApproved is {
        let item0: type DeploymentOrchestratorService.DeployToEnvironment = prompt("translate the deploymentApproved event into a DeployToEnvironment, approval being what authorises the change to land")
        send item0 to outlet PipelineContext.ToDeploymentOrchestratorService.ToDeploymentOrchestratorServiceOut
      }
      on pipelineCancelled: event Pipeline.PipelineCancelled is {
        let item0: type DeploymentOrchestratorService.RollbackDeployment = prompt("translate the pipelineCancelled event into a RollbackDeployment, cancellation mid-flight leaving a change to undo")
        send item0 to outlet PipelineContext.ToDeploymentOrchestratorService.ToDeploymentOrchestratorServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToDeploymentOrchestratorService"
      }
    } with {
      briefly "to deployment orchestrator service"
      described as {
        |Carries messages to the external DeploymentOrchestratorService.
      }
    }
  } with {
    briefly "DeploymentOrchestratorService integration"
    described as {
      |The model's side of the DeploymentOrchestratorService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type PipelineEvent    outlet ToNotificationServiceOut is command NotificationService.SendBuildNotification
    handler ToNotificationServiceHandler is {
      on pipelineCompleted: event PipelineCompleted is {
        let notice: type NotificationService.SendBuildNotification = prompt("translate the pipelineCompleted event into a SendBuildNotification telling the committer the pipeline finished and whether their change is deployable")
        send notice to outlet PipelineContext.ToNotificationService.ToNotificationServiceOut
      }
      on pipelineCancelled: event PipelineCancelled is {
        let notice: type NotificationService.SendBuildNotification = prompt("translate the pipelineCancelled event into a SendBuildNotification telling the committer the run was cancelled, so they do not wait on a result")
        send notice to outlet PipelineContext.ToNotificationService.ToNotificationServiceOut
      }
      on approvalRequested: event ApprovalRequested is {
        let notice: type NotificationService.SendBuildNotification = prompt("translate the approvalRequested event into a SendBuildNotification telling the approver a deployment waits on their decision")
        send notice to outlet PipelineContext.ToNotificationService.ToNotificationServiceOut
      }
      on deploymentApproved: event DeploymentApproved is {
        let notice: type NotificationService.SendBuildNotification = prompt("translate the deploymentApproved event into a SendBuildNotification telling the committer the deployment was approved and is proceeding")
        send notice to outlet PipelineContext.ToNotificationService.ToNotificationServiceOut
      }
      on deploymentRejected: event DeploymentRejected is {
        let notice: type NotificationService.SendBuildNotification = prompt("translate the deploymentRejected event into a SendBuildNotification telling the committer the deployment was refused and the recorded reason")
        send notice to outlet PipelineContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromSourceControlService from context SourceControlService as sink is { 
    inlet FromSourceControlServiceIn is type SourceControlService.SourceControlServiceEvent    handler FromSourceControlServiceHandler is {
      on commitStatusSet: event SourceControlService.CommitStatusSet is {
        do "the commit shows our status; the pipeline's own state is unchanged"
      }
      on repositoryFetched: event SourceControlService.RepositoryFetched is {
        do "the source is checked out; the first stage runs on it"
      }
      on other is {
        error "Unexpected message for adaptor FromSourceControlService"
      }
    } with {
      briefly "from source control service"
      described as {
        |Carries messages from the external SourceControlService.
      }
    }
  } with {
    briefly "SourceControlService integration"
    described as {
      |The model's side of the SourceControlService conversation.
    }
  }
  adaptor ToSourceControlService to context SourceControlService as flow is { 
    inlet ToSourceControlServiceIn is type PipelineEvent    outlet ToSourceControlServiceOut is type SourceControlService.SourceControlServiceCommand
    handler ToSourceControlServiceHandler is {
      on pipelineStarted: event Pipeline.PipelineStarted is {
        let item0: type SourceControlService.FetchRepository = prompt("translate the pipelineStarted event into a FetchRepository, a pipeline having nothing to build until the source arrives")
        send item0 to outlet PipelineContext.ToSourceControlService.ToSourceControlServiceOut
      }
      on pipelineCompleted: event Pipeline.PipelineCompleted is {
        let item0: type SourceControlService.SetCommitStatus = prompt("translate the pipelineCompleted event into a SetCommitStatus, the commit being what the result is reported against")
        send item0 to outlet PipelineContext.ToSourceControlService.ToSourceControlServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToSourceControlService"
      }
    } with {
      briefly "to source control service"
      described as {
        |Carries messages to the external SourceControlService.
      }
    }
  } with {
    briefly "SourceControlService integration"
    described as {
      |The model's side of the SourceControlService conversation.
    }
  }
  include "types.riddl"
  include "Pipeline.riddl"
  // Repository for pipeline persistence
  type PipelineRepositoryCommand is one of {
    PipelineContext.PipelineRepository.PersistApprovalRequested or PipelineContext.PipelineRepository.PersistArtifactStored or PipelineContext.PipelineRepository.PersistDeploymentApproved or PipelineContext.PipelineRepository.PersistDeploymentRejected or PipelineContext.PipelineRepository.PersistPipelineCancelled or PipelineContext.PipelineRepository.PersistPipelineCompleted or PipelineContext.PipelineRepository.PersistPipelineCreated or PipelineContext.PipelineRepository.PersistPipelineStarted or PipelineContext.PipelineRepository.PersistStageCompleted
  } with {
    briefly "Anything that writes PipelineRepository"
    described as {
      |The persistence commands PipelineRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository PipelineRepository as flow is {
    inlet PipelineRepositoryFromPipelineAnalytics is type PipelineRepositoryCommand    command PersistApprovalRequested is {
      pipelineId: PipelineId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApprovalRequested applies to.
        }
      }
    } with {
      briefly "Persist ApprovalRequested"
      described as {
        |Instructs this repository to apply ApprovalRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistArtifactStored is {
      pipelineId: PipelineId with {
        briefly "Row addressed"
        described as {
          |Which stored row ArtifactStored applies to.
        }
      }
    } with {
      briefly "Persist ArtifactStored"
      described as {
        |Instructs this repository to apply ArtifactStored to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeploymentRejected is {
      pipelineId: PipelineId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeploymentRejected applies to.
        }
      }
    } with {
      briefly "Persist DeploymentRejected"
      described as {
        |Instructs this repository to apply DeploymentRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPipelineCancelled is {
      pipelineId: PipelineId with {
        briefly "Row addressed"
        described as {
          |Which stored row PipelineCancelled applies to.
        }
      }
    } with {
      briefly "Persist PipelineCancelled"
      described as {
        |Instructs this repository to apply PipelineCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPipelineCreated is {
      pipelineId: PipelineId with {
        briefly "Row addressed"
        described as {
          |Which stored row PipelineCreated applies to.
        }
      }
    } with {
      briefly "Persist PipelineCreated"
      described as {
        |Instructs this repository to apply PipelineCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStageCompleted is {
      pipelineId: PipelineId with {
        briefly "Row addressed"
        described as {
          |Which stored row StageCompleted applies to.
        }
      }
    } with {
      briefly "Persist StageCompleted"
      described as {
        |Instructs this repository to apply StageCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeploymentApproved is {
      pipelineId: PipelineId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeploymentApproved applies to.
        }
      }
    } with {
      briefly "Persist DeploymentApproved"
      described as {
        |Instructs this repository to apply DeploymentApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPipelineCompleted is {
      pipelineId: PipelineId with {
        briefly "Row addressed"
        described as {
          |Which stored row PipelineCompleted applies to.
        }
      }
    } with {
      briefly "Persist PipelineCompleted"
      described as {
        |Instructs this repository to apply PipelineCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPipelineStarted is {
      pipelineId: PipelineId with {
        briefly "Row addressed"
        described as {
          |Which stored row PipelineStarted applies to.
        }
      }
    } with {
      briefly "Persist PipelineStarted"
      described as {
        |Instructs this repository to apply PipelineStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet PipelineRepositoryResponses is result Pipeline.PipelineResult
    record StoredPipeline is {
      pipelineId: PipelineId with {
        briefly "pipelineId"
        described as {
          |The pipelineId column of the stored pipeline row.
        }
      }
      config: PipelineConfig with {
        briefly "config"
        described as {
          |The config column of the stored pipeline row.
        }
      }
    } with {
      briefly "Stored pipeline row"
      described as {
        |The persistence shape of pipeline data as this repository stores it.
      }
    }
    schema PipelineData is relational
      of pipelines as record StoredPipeline
        index on field StoredPipeline.pipelineId
        index on field StoredPipeline.config.repositoryUrl
 with {
      briefly "Pipeline data schema"
      described as {
        |The relational schema holding pipeline data for the PipelineRepository.
      }
    }
    handler PipelinePersistence is {
      on persistApprovalRequested: command PersistApprovalRequested is {
        do "apply ApprovalRequested to the stored row"
      }
      on persistArtifactStored: command PersistArtifactStored is {
        do "apply ArtifactStored to the stored row"
      }
      on persistDeploymentRejected: command PersistDeploymentRejected is {
        do "apply DeploymentRejected to the stored row"
      }
      on persistPipelineCancelled: command PersistPipelineCancelled is {
        do "apply PipelineCancelled to the stored row"
      }
      on persistPipelineCreated: command PersistPipelineCreated is {
        do "apply PipelineCreated to the stored row"
      }
      on persistStageCompleted: command PersistStageCompleted is {
        do "apply StageCompleted to the stored row"
      }
      on persistDeploymentApproved: command PersistDeploymentApproved is {
        do "apply DeploymentApproved to the stored row"
      }
      on persistPipelineCompleted: command PersistPipelineCompleted is {
        do "apply PipelineCompleted to the stored row"
      }
      on persistPipelineStarted: command PersistPipelineStarted is {
        do "apply PipelineStarted to the stored row"
      }
      on query GetPipelineStats is {
        let pipelineStatsView: type PipelineStatsView = prompt("read the pipeline stats projection")
        reply pipelineStatsView
      }
    } with {
      briefly "Persists pipeline commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Pipeline data persistence"
    described as {
      | The PipelineRepository provides persistent storage for
      | pipelines, builds, and artifacts.
    }
  }
  // Projector for pipeline analytics
  query GetPipelineStats replies result PipelineStatsView is {
    pipelineStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which pipeline stats to retrieve.
      }
    }
  } with {
    briefly "Get pipeline stats"
    described as {
      |Retrieves the pipeline stats projection.
    }
  }
  result PipelineStatsView is {
    pipelineStats: PipelineAnalytics.PipelineStats with {
      briefly "Pipeline stats"
      described as {
        |The pipeline stats being returned.
      }
    }
  } with {
    briefly "Pipeline stats view"
    described as {
      |Read model view carrying the pipeline stats projection.
    }
  }
  projector PipelineAnalytics as flow is {
    updates repository PipelineContext.PipelineRepository
    outlet PipelineAnalyticsToRepository is type PipelineRepositoryCommand
    inlet PipelineAnalyticsFromPipeline is type PipelineEvent    record PipelineStats is {
      totalPipelines: Natural with {
        briefly "Total"
        described as {
          |Total pipelines.
        }
      }
      totalBuilds: Natural with {
        briefly "Builds"
        described as {
          |Total builds.
        }
      }
      successRate: Decimal(5,4) with {
        briefly "Success rate"
        described as {
          |Build success rate.
        }
      }
      averageDuration: Natural with {
        briefly "Avg duration"
        described as {
          |Average duration seconds.
        }
      }
      deploymentsToday: Natural with {
        briefly "Deployments"
        described as {
          |Deployments today.
        }
      }
    } with {
      briefly "Pipeline statistics"
      described as {
        |CI/CD pipeline metrics.
      }
    }
    handler AnalyticsHandler is {
      on approvalRequested: event Pipeline.ApprovalRequested is {
        tell command PipelineContext.PipelineRepository.PersistApprovalRequested(pipelineId = approvalRequested.pipelineId) to repository PipelineContext.PipelineRepository
        do "apply ApprovalRequested to the PipelineAnalytics projection"
      }
      on artifactStored: event Pipeline.ArtifactStored is {
        tell command PipelineContext.PipelineRepository.PersistArtifactStored(pipelineId = artifactStored.pipelineId) to repository PipelineContext.PipelineRepository
        do "apply ArtifactStored to the PipelineAnalytics projection"
      }
      on deploymentRejected: event Pipeline.DeploymentRejected is {
        tell command PipelineContext.PipelineRepository.PersistDeploymentRejected(pipelineId = deploymentRejected.pipelineId) to repository PipelineContext.PipelineRepository
        do "apply DeploymentRejected to the PipelineAnalytics projection"
      }
      on pipelineCancelled: event Pipeline.PipelineCancelled is {
        tell command PipelineContext.PipelineRepository.PersistPipelineCancelled(pipelineId = pipelineCancelled.pipelineId) to repository PipelineContext.PipelineRepository
        do "apply PipelineCancelled to the PipelineAnalytics projection"
      }
      on pipelineCreated: event Pipeline.PipelineCreated is {
        tell command PipelineContext.PipelineRepository.PersistPipelineCreated(pipelineId = pipelineCreated.pipelineId) to repository PipelineContext.PipelineRepository
        do "apply PipelineCreated to the PipelineAnalytics projection"
      }
      on stageCompleted: event Pipeline.StageCompleted is {
        tell command PipelineContext.PipelineRepository.PersistStageCompleted(pipelineId = stageCompleted.pipelineId) to repository PipelineContext.PipelineRepository
        do "apply StageCompleted to the PipelineAnalytics projection"
      }
      on pipelineStarted: event Pipeline.PipelineStarted is {
        tell command PipelineContext.PipelineRepository.PersistPipelineStarted(pipelineId = pipelineStarted.pipelineId) to repository PipelineContext.PipelineRepository
      }
      on pipelineCompleted: event Pipeline.PipelineCompleted is {
        tell command PipelineContext.PipelineRepository.PersistPipelineCompleted(pipelineId = pipelineCompleted.pipelineId) to repository PipelineContext.PipelineRepository
      }
      on deploymentApproved: event Pipeline.DeploymentApproved is {
        tell command PipelineContext.PipelineRepository.PersistDeploymentApproved(pipelineId = deploymentApproved.pipelineId) to repository PipelineContext.PipelineRepository
      }
    } with {
      briefly "Maintains pipeline analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Pipeline analytics projections"
    described as {
      |Maintains CI/CD pipeline analytics data.
    }
  }
  // Event streaming infrastructure
  type PipelineEvent is one of {
    PipelineContext.Pipeline.PipelineCreated or PipelineContext.Pipeline.PipelineStarted or PipelineContext.Pipeline.StageCompleted or PipelineContext.Pipeline.PipelineCompleted or PipelineContext.Pipeline.PipelineCancelled or PipelineContext.Pipeline.ApprovalRequested or PipelineContext.Pipeline.ArtifactStored or PipelineContext.Pipeline.DeploymentApproved or PipelineContext.Pipeline.DeploymentRejected
  } with {
    briefly "Pipeline events"
    described as {
      |Union of all Pipeline events for streaming.
    }
  }
  streamlet PipelineEventSplit as split is {
    outlet PipelineEventSplitToToSourceControlService is type PipelineEvent
    outlet PipelineEventSplitToToNotificationService is type PipelineEvent
    outlet PipelineEventSplitToToDeploymentOrchestratorService is type PipelineEvent
    outlet PipelineEventSplitToToContainerRegistryService is type PipelineEvent
    outlet PipelineEventSplitToToArtifactStorageService is type PipelineEvent
    inlet PipelineEventSplitIn is type PipelineEvent    outlet PipelineEventSplitToPipelineAnalytics is type PipelineEvent
    handler PipelineEventSplitHandler is {
      on pipelineCreated: event Pipeline.PipelineCreated is {
        send pipelineCreated to outlet PipelineEventSplitToPipelineAnalytics
        tell pipelineCreated to entity PipelineContext.Pipeline
      }
      on pipelineStarted: event Pipeline.PipelineStarted is {
        send pipelineStarted to outlet PipelineEventSplitToPipelineAnalytics
        send pipelineStarted to outlet PipelineEventSplitToToSourceControlService
        tell pipelineStarted to entity PipelineContext.Pipeline
      }
      on stageCompleted: event Pipeline.StageCompleted is {
        send stageCompleted to outlet PipelineEventSplitToPipelineAnalytics
        send stageCompleted to outlet PipelineEventSplitToToArtifactStorageService
        tell stageCompleted to entity PipelineContext.Pipeline
      }
      on artifactStored: event Pipeline.ArtifactStored is {
        send artifactStored to outlet PipelineEventSplitToPipelineAnalytics
        send artifactStored to outlet PipelineEventSplitToToContainerRegistryService
        tell artifactStored to entity PipelineContext.Pipeline
      }
      on approvalRequested: event Pipeline.ApprovalRequested is {
        send approvalRequested to outlet PipelineEventSplitToPipelineAnalytics
        send approvalRequested to outlet PipelineEventSplitToToNotificationService
        tell approvalRequested to entity PipelineContext.Pipeline
      }
      on deploymentApproved: event Pipeline.DeploymentApproved is {
        send deploymentApproved to outlet PipelineEventSplitToPipelineAnalytics
        send deploymentApproved to outlet PipelineEventSplitToToNotificationService
        send deploymentApproved to outlet PipelineEventSplitToToDeploymentOrchestratorService
        send deploymentApproved to outlet PipelineEventSplitToToArtifactStorageService
        tell deploymentApproved to entity PipelineContext.Pipeline
      }
      on deploymentRejected: event Pipeline.DeploymentRejected is {
        send deploymentRejected to outlet PipelineEventSplitToPipelineAnalytics
        send deploymentRejected to outlet PipelineEventSplitToToNotificationService
        tell deploymentRejected to entity PipelineContext.Pipeline
      }
      on pipelineCancelled: event Pipeline.PipelineCancelled is {
        send pipelineCancelled to outlet PipelineEventSplitToPipelineAnalytics
        send pipelineCancelled to outlet PipelineEventSplitToToNotificationService
        send pipelineCancelled to outlet PipelineEventSplitToToDeploymentOrchestratorService
        tell pipelineCancelled to entity PipelineContext.Pipeline
      }
      on pipelineCompleted: event Pipeline.PipelineCompleted is {
        send pipelineCompleted to outlet PipelineEventSplitToPipelineAnalytics
        send pipelineCompleted to outlet PipelineEventSplitToToSourceControlService
        send pipelineCompleted to outlet PipelineEventSplitToToNotificationService
        tell pipelineCompleted to entity PipelineContext.Pipeline
      }
      on other is {
        error "Unexpected message for processor PipelineEventSplit"
      }
    } with {
      briefly "Pipeline event fan-out handler"
      described as {
        |Delivers each Pipeline event to all of its consumers.
      }
    }
  } with {
    briefly "Pipeline event fan-out"
    described as {
      |Fans Pipeline events out to the repository and projectors.
    }
  }
  connector 'ToSourceControlService Feed' is from outlet PipelineContext.PipelineEventSplit.PipelineEventSplitToToSourceControlService to inlet PipelineContext.ToSourceControlService.ToSourceControlServiceIn with {
    briefly "The Pipeline events ToSourceControlService translates, on their way to it"
  }
  connector 'ToNotificationService Feed' is from outlet PipelineContext.PipelineEventSplit.PipelineEventSplitToToNotificationService to inlet PipelineContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The Pipeline events ToNotificationService translates, on their way to it"
  }
  connector 'ToDeploymentOrchestratorService Feed' is from outlet PipelineContext.PipelineEventSplit.PipelineEventSplitToToDeploymentOrchestratorService to inlet PipelineContext.ToDeploymentOrchestratorService.ToDeploymentOrchestratorServiceIn with {
    briefly "The Pipeline events ToDeploymentOrchestratorService translates, on their way to it"
  }
  connector 'ToContainerRegistryService Feed' is from outlet PipelineContext.PipelineEventSplit.PipelineEventSplitToToContainerRegistryService to inlet PipelineContext.ToContainerRegistryService.ToContainerRegistryServiceIn with {
    briefly "The Pipeline events ToContainerRegistryService translates, on their way to it"
  }
  connector 'ToArtifactStorageService Feed' is from outlet PipelineContext.PipelineEventSplit.PipelineEventSplitToToArtifactStorageService to inlet PipelineContext.ToArtifactStorageService.ToArtifactStorageServiceIn with {
    briefly "The Pipeline events ToArtifactStorageService translates, on their way to it"
  }
  connector 'PipelineEvent Stream' is from outlet PipelineContext.Pipeline.PipelineEvents to inlet PipelineContext.PipelineEventSplit.PipelineEventSplitIn with {
    briefly "Pipeline events, fanned out to storage and read models"
  }
  connector 'PipelineAnalytics Feed' is from outlet PipelineContext.PipelineEventSplit.PipelineEventSplitToPipelineAnalytics to inlet PipelineContext.PipelineAnalytics.PipelineAnalyticsFromPipeline with {
    briefly "Pipeline events feeding the PipelineAnalytics projection"
  }
  connector 'PipelineAnalytics Storage' is from outlet PipelineContext.PipelineAnalytics.PipelineAnalyticsToRepository to inlet PipelineContext.PipelineRepository.PipelineRepositoryFromPipelineAnalytics with {
    briefly "PipelineAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for CI/CD pipelines"
  described as {
    | The PipelineContext is the bounded context for
    | continuous integration and deployment automation.
  }
}
