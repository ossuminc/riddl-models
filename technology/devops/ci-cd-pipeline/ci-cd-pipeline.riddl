// CI/CD Pipeline Domain Model
// Continuous integration and deployment automation
domain CICDPipeline is {
  persistent connector 'ArtifactStorageServiceEvent Stream' is from outlet ArtifactStorageService.ArtifactStorageServiceEventsOut to inlet PipelineContext.FromArtifactStorageService.FromArtifactStorageServiceIn with {
    briefly "What ArtifactStorageService tells PipelineContext, unasked"
  }
  persistent connector 'ContainerRegistryServiceEvent Stream' is from outlet ContainerRegistryService.ContainerRegistryServiceEventsOut to inlet PipelineContext.FromContainerRegistryService.FromContainerRegistryServiceIn with {
    briefly "What ContainerRegistryService tells PipelineContext, unasked"
  }
  persistent connector 'DeploymentOrchestratorServiceEvent Stream' is from outlet DeploymentOrchestratorService.DeploymentOrchestratorServiceEventsOut to inlet PipelineContext.FromDeploymentOrchestratorService.FromDeploymentOrchestratorServiceIn with {
    briefly "What DeploymentOrchestratorService tells PipelineContext, unasked"
  }
  persistent connector 'SourceControlServiceEvent Stream' is from outlet SourceControlService.SourceControlServiceEventsOut to inlet PipelineContext.FromSourceControlService.FromSourceControlServiceIn with {
    briefly "What SourceControlService tells PipelineContext, unasked"
  }
  persistent connector 'ContainerRegistryServiceRequest Stream' is from outlet PipelineContext.ToContainerRegistryService.ToContainerRegistryServiceOut to inlet ContainerRegistryService.ContainerRegistryServiceRequests with {
    briefly "What PipelineContext asks ContainerRegistryService to send"
  }
  persistent connector 'DeploymentOrchestratorServiceRequest Stream' is from outlet PipelineContext.ToDeploymentOrchestratorService.ToDeploymentOrchestratorServiceOut to inlet DeploymentOrchestratorService.DeploymentOrchestratorServiceRequests with {
    briefly "What PipelineContext asks DeploymentOrchestratorService to send"
  }
  persistent connector 'SourceControlServiceRequest Stream' is from outlet PipelineContext.ToSourceControlService.ToSourceControlServiceOut to inlet SourceControlService.SourceControlServiceRequests with {
    briefly "What PipelineContext asks SourceControlService to send"
  }
  persistent connector 'ArtifactStorageServiceRequest Stream' is from outlet PipelineContext.ToArtifactStorageService.ToArtifactStorageServiceOut to inlet ArtifactStorageService.ArtifactStorageServiceRequests with {
    briefly "What PipelineContext asks ArtifactStorageService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet PipelineContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What PipelineContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Developer is "person committing code changes" with {
    briefly "Developer"
    described as {
      |Person writing and committing code.
    }
  }
  user DevOpsEngineer is "person managing pipelines" with {
    briefly "DevOps Engineer"
    described as {
      |Person configuring and maintaining pipelines.
    }
  }
  user ReleaseManager is "person approving deployments" with {
    briefly "Release Manager"
    described as {
      |Person authorizing production releases.
    }
  }
  epic PipelineEpic is {
    user Developer wants to "to deploy code changes reliably" so that "features reach users quickly and safely"
    case TriggerBuild is {
      user Developer wants to "to trigger a build from code commit" so that "changes are validated automatically"
      step is "Developer pushes" "code commit" "to repository" with {
        briefly "Push commit"
        described as {
          |Commit code changes.
        }
      }
      step is "System detects" "commit webhook" "and starts pipeline" with {
        briefly "Detect webhook"
        described as {
          |Trigger pipeline.
        }
      }
      step take input CICDPipelineApp.CICDPipelineScreen.StartPipelineInput from user Developer with {
        briefly "Start pipeline"
        described as {
          |Begin pipeline execution.
        }
      }
      step is "System reports" "build status" "to developer" with {
        briefly "Report status"
        described as {
          |Notify build result.
        }
      }
    } with {
      briefly "Build triggering"
      described as {
        |Automated build from code commit.
      }
    }
  } with {
    briefly "Pipeline management"
    described as {
      | Epic covering CI/CD pipeline execution,
      | build automation, and deployment workflows.
    }
  }
  include "PipelineContext.riddl"
  include "external-contexts.riddl"
  application context CICDPipelineApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CICDPipeline are delivered.
      }
    }
    group CICDPipelineScreen is {
      input StartPipelineInput acquires command PipelineContext.Pipeline.StartPipeline with {
        briefly "Start pipeline control"
        described as {
          |The control through which a user submits the start pipeline request.
        }
      }
    } with {
      briefly "Cicd pipeline screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppPipelineCommands is type PipelineContext.Pipeline.PipelineCommand
    inlet AppPipelineRepositoryResponses is result PipelineContext.Pipeline.PipelineResult    handler CICDPipelineAppHandler is {
      on other is {
        error "Unexpected message for application context CICDPipelineApp"
      }
    } with {
      briefly "CICDPipelineApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CICDPipelineApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'PipelineCommand Stream' is from outlet CICDPipelineApp.AppPipelineCommands to inlet PipelineContext.PipelineCommandStreamIn with {
    briefly "Pipeline commands from the application"
  }
  persistent connector 'PipelineResult Stream' is from outlet PipelineContext.PipelineResultStreamOut to inlet CICDPipelineApp.AppPipelineRepositoryResponses with {
    briefly "Pipeline query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CICDPipelineApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "CI/CD pipeline domain"
  described as {
    | The CICDPipeline domain handles continuous integration
    | and deployment automation for software delivery.
  }
}
