// Infrastructure as Code - Stack Entity
entity Stack as flow is {
  type StackCommand is one of {
    Stack.CreateStack or Stack.PlanStack or Stack.ApplyStack or Stack.DetectDrift or Stack.ReconcileDrift or Stack.UpdateVariables or Stack.DestroyStack or Stack.LockStack or Stack.UnlockStack
  } with {
    briefly "Stack command alternation"
    described as {
      |Commands accepted by the Stack entity.
    }
  }
  inlet StackCommands is type StackCommand  outlet StackEvents2 is type StackEvent
  query GetStack replies result StackResult is  {
    stackId: StackId with {
      briefly "ID"
      described as {
        |Identifier of the Stack to retrieve.
      }
    }
  } with {
    briefly "Get Stack"
    described as {
      |Retrieve Stack data by identifier.
    }
  }
  result StackResult is  {
    stackId: StackId with {
      briefly "Stack addressed"
      described as {
        |Which stack this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    stackData: Stack.ActiveStateData with {
      briefly "Stack data"
      described as {
        |The requested Stack data.
      }
    }
  } with {
    briefly "Stack result"
    described as {
      |Result carrying the requested Stack data.
    }
  }
  // Commands
  command CreateStack is  {
    stackId: StackId with {
      briefly "Stack ID"
      described as {
        |New stack identifier.
      }
    }
    workspace: WorkspaceInfo with {
      briefly "Workspace"
      described as {
        |Workspace configuration.
      }
    }
    config: StackConfiguration with {
      briefly "Configuration"
      described as {
        |Stack configuration.
      }
    }
  } with {
    briefly "Create stack"
    described as {
      |Creates a new infrastructure stack.
    }
  }
  command PlanStack is  {
    stackId: StackId with {
      briefly "Stack ID"
      described as {
        |Stack identifier.
      }
    }
    runId: RunId with {
      briefly "Run ID"
      described as {
        |New run identifier.
      }
    }
  } with {
    briefly "Plan stack"
    described as {
      |Generates execution plan.
    }
  }
  command ApplyStack is  {
    stackId: StackId with {
      briefly "Stack ID"
      described as {
        |Stack identifier.
      }
    }
    runId: RunId with {
      briefly "Run ID"
      described as {
        |Run identifier.
      }
    }
    autoApprove: Boolean with {
      briefly "Auto approve"
      described as {
        |Skip manual approval.
      }
    }
  } with {
    briefly "Apply stack"
    described as {
      |Applies infrastructure changes.
    }
  }
  command DetectDrift is  {
    stackId: StackId with {
      briefly "Stack ID"
      described as {
        |Stack identifier.
      }
    }
  } with {
    briefly "Detect drift"
    described as {
      |Checks for configuration drift.
    }
  }
  command ReconcileDrift is  {
    stackId: StackId with {
      briefly "Stack ID"
      described as {
        |Stack identifier.
      }
    }
    runId: RunId with {
      briefly "Run ID"
      described as {
        |New run identifier.
      }
    }
  } with {
    briefly "Reconcile drift"
    described as {
      |Applies changes to fix drift.
    }
  }
  command UpdateVariables is  {
    stackId: StackId with {
      briefly "Stack ID"
      described as {
        |Stack identifier.
      }
    }
    updatedVariables: String(1,1000)+ with {
      briefly "Variables"
      described as {
        |Updated variables.
      }
    }
  } with {
    briefly "Update variables"
    described as {
      |Updates stack variables.
    }
  }
  command DestroyStack is  {
    stackId: StackId with {
      briefly "Stack ID"
      described as {
        |Stack identifier.
      }
    }
    runId: RunId with {
      briefly "Run ID"
      described as {
        |Destruction run identifier.
      }
    }
    force: Boolean with {
      briefly "Force"
      described as {
        |Force destruction.
      }
    }
  } with {
    briefly "Destroy stack"
    described as {
      |Destroys all stack resources.
    }
  }
  command LockStack is  {
    stackId: StackId with {
      briefly "Stack ID"
      described as {
        |Stack identifier.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Lock reason.
      }
    }
    lockedBy: String(1,200) with {
      briefly "Locked by"
      described as {
        |Person locking.
      }
    }
  } with {
    briefly "Lock stack"
    described as {
      |Locks stack from changes.
    }
  }
  command UnlockStack is  {
    stackId: StackId with {
      briefly "Stack ID"
      described as {
        |Stack identifier.
      }
    }
    unlockedBy: String(1,200) with {
      briefly "Unlocked by"
      described as {
        |Person unlocking.
      }
    }
  } with {
    briefly "Unlock stack"
    described as {
      |Unlocks stack for changes.
    }
  }
  // Events
  event StackCreated is  {
    stackId: StackId with {
      briefly "Stack"
      described as {
        |Stack ID.
      }
    }
    workspace: WorkspaceInfo with {
      briefly "Workspace"
      described as {
        |Workspace config.
      }
    }
    config: StackConfiguration with {
      briefly "Config"
      described as {
        |Stack configuration.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Stack created"
    described as {
      |Emitted when stack is created.
    }
  }
  event PlanGenerated is  {
    stackId: StackId with {
      briefly "Stack"
      described as {
        |Stack ID.
      }
    }
    plan: ExecutionPlan with {
      briefly "Plan"
      described as {
        |Execution plan.
      }
    }
    generatedAt: TimeStamp with {
      briefly "Generated"
      described as {
        |Generation time.
      }
    }
  } with {
    briefly "Plan generated"
    described as {
      |Emitted when plan is generated.
    }
  }
  event StackApplyStarted is  {
    stackId: StackId with {
      briefly "Stack"
      described as {
        |Stack ID.
      }
    }
    runId: RunId with {
      briefly "Run"
      described as {
        |Run ID.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
  } with {
    briefly "Apply started"
    described as {
      |Emitted when apply begins.
    }
  }
  event StackApplyCompleted is  {
    stackId: StackId with {
      briefly "Stack"
      described as {
        |Stack ID.
      }
    }
    result: ApplyResult with {
      briefly "Result"
      described as {
        |Apply result.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Apply completed"
    described as {
      |Emitted when apply finishes.
    }
  }
  event DriftDetected is  {
    stackId: StackId with {
      briefly "Stack"
      described as {
        |Stack ID.
      }
    }
    report: DriftReport with {
      briefly "Report"
      described as {
        |Drift report.
      }
    }
    detectedAt: TimeStamp with {
      briefly "Detected"
      described as {
        |Detection time.
      }
    }
  } with {
    briefly "Drift detected"
    described as {
      |Emitted when drift is found.
    }
  }
  event DriftReconciled is  {
    stackId: StackId with {
      briefly "Stack"
      described as {
        |Stack ID.
      }
    }
    reconciledResources: Natural with {
      briefly "Reconciled"
      described as {
        |Resources reconciled.
      }
    }
    reconciledAt: TimeStamp with {
      briefly "Reconciled"
      described as {
        |Reconciliation time.
      }
    }
  } with {
    briefly "Drift reconciled"
    described as {
      |Emitted when drift is fixed.
    }
  }
  event VariablesUpdated is  {
    stackId: StackId with {
      briefly "Stack"
      described as {
        |Stack ID.
      }
    }
    variableCount: Natural with {
      briefly "Count"
      described as {
        |Variables updated.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Variables updated"
    described as {
      |Emitted when variables change.
    }
  }
  event StackDestroyed is  {
    stackId: StackId with {
      briefly "Stack"
      described as {
        |Stack ID.
      }
    }
    resourcesDestroyed: Natural with {
      briefly "Destroyed"
      described as {
        |Resources destroyed.
      }
    }
    destroyedAt: TimeStamp with {
      briefly "Destroyed"
      described as {
        |Destruction time.
      }
    }
  } with {
    briefly "Stack destroyed"
    described as {
      |Emitted when stack is destroyed.
    }
  }
  event StackLocked is  {
    stackId: StackId with {
      briefly "Stack"
      described as {
        |Stack ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Lock reason.
      }
    }
    lockedBy: String(1,200) with {
      briefly "Locked by"
      described as {
        |Locker.
      }
    }
    lockedAt: TimeStamp with {
      briefly "Locked"
      described as {
        |Lock time.
      }
    }
  } with {
    briefly "Stack locked"
    described as {
      |Emitted when stack is locked.
    }
  }
  event StackUnlocked is  {
    stackId: StackId with {
      briefly "Stack"
      described as {
        |Stack ID.
      }
    }
    unlockedBy: String(1,200) with {
      briefly "Unlocked by"
      described as {
        |Unlocker.
      }
    }
    unlockedAt: TimeStamp with {
      briefly "Unlocked"
      described as {
        |Unlock time.
      }
    }
  } with {
    briefly "Stack unlocked"
    described as {
      |Emitted when stack is unlocked.
    }
  }
  // State Records
  record ActiveStateData is  {
    stackId: StackId with {
      briefly "Stack"
      described as {
        |Stack ID.
      }
    }
    workspace: WorkspaceInfo with {
      briefly "Workspace"
      described as {
        |Workspace config.
      }
    }
    config: StackConfiguration with {
      briefly "Config"
      described as {
        |Stack configuration.
      }
    }
    resources: ResourceState* with {
      briefly "Resources"
      described as {
        |Current resources.
      }
    }
    status: StackStatus with {
      briefly "Status"
      described as {
        |Stack status.
      }
    }
    currentRunId: RunId? with {
      briefly "Current run"
      described as {
        |Current run ID.
      }
    }
    lastPlan: ExecutionPlan? with {
      briefly "Last plan"
      described as {
        |Last execution plan.
      }
    }
    isLocked: Boolean with {
      briefly "Locked"
      described as {
        |Whether stack is locked.
      }
    }
    updatedLockedBy: String(1,200)? with {
      briefly "Locked by"
      described as {
        |Locker identity.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |State for active stack.
    }
  }
  record DestroyedStateData is  {
    stackId: StackId with {
      briefly "Stack"
      described as {
        |Stack ID.
      }
    }
    workspace: WorkspaceInfo with {
      briefly "Workspace"
      described as {
        |Workspace config.
      }
    }
    destroyedAt: TimeStamp with {
      briefly "Destroyed"
      described as {
        |Destruction time.
      }
    }
  } with {
    briefly "Destroyed state"
    described as {
      |State for destroyed stack.
    }
  }
  // States
  initial state ActiveState of record Stack.ActiveStateData is {
    initial handler ActiveStateInitHandler is {
      on query GetStack is {
        let stackResult: type StackResult = prompt("read the stack from the store")
        reply stackResult
      }
      on init is {
        set state ActiveState to "initialize Stack.ActiveStateData fields from the creating message"
      }
    } with {
      briefly "ActiveState initialization"
      described as {
        |Initializes ActiveState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |The active state of the Stack entity, carrying ActiveStateData.
    }
  }
  state DestroyedState of record Stack.DestroyedStateData is {
    initial handler DestroyedStateInitHandler is {
      on init is {
        set state DestroyedState to "initialize Stack.DestroyedStateData fields from the creating message"
      }
    } with {
      briefly "DestroyedState initialization"
      described as {
        |Initializes DestroyedState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Destroyed state"
    described as {
      |The destroyed state of the Stack entity, carrying DestroyedStateData.
    }
  }
  // Handler
  handler StackHandler is {
    on createStack: command CreateStack is {
      morph entity StackContext.Stack to state StackContext.Stack.ActiveState with record Stack.ActiveStateData(stackId = createStack.stackId, workspace = createStack.workspace, config = createStack.config, resources = empty, status = prompt("the status of this active state data"), currentRunId = empty, lastPlan = empty, isLocked = prompt("the is locked of this active state data"), updatedLockedBy = empty, createdAt = prompt("the created at of this active state data"))
      tell event StackCreated(stackId = createStack.stackId, workspace = createStack.workspace, config = createStack.config, createdAt = prompt("the created at of this stack created")) to entity StackContext.Stack
    }
    on planStack: command PlanStack is {
      tell event PlanGenerated(stackId = planStack.stackId, plan = prompt("the plan of this plan generated"), generatedAt = prompt("the generated at of this plan generated")) to entity StackContext.Stack
    }
    on applyStack: command ApplyStack is {
      tell event StackApplyStarted(stackId = applyStack.stackId, runId = applyStack.runId, startedAt = prompt("the started at of this stack apply started")) to entity StackContext.Stack
      tell event StackApplyCompleted(stackId = applyStack.stackId, result = prompt("the result of this stack apply completed"), completedAt = prompt("the completed at of this stack apply completed")) to entity StackContext.Stack
    }
    on detectDrift: command DetectDrift is {
      tell event DriftDetected(stackId = detectDrift.stackId, report = prompt("the report of this drift detected"), detectedAt = prompt("the detected at of this drift detected")) to entity StackContext.Stack
    }
    on reconcileDrift: command ReconcileDrift is {
      tell event DriftReconciled(stackId = reconcileDrift.stackId, reconciledResources = prompt("the reconciled resources of this drift reconciled"), reconciledAt = prompt("the reconciled at of this drift reconciled")) to entity StackContext.Stack
    }
    on updateVariables: command UpdateVariables is {
      tell event VariablesUpdated(stackId = updateVariables.stackId, variableCount = prompt("the variable count of this variables updated"), updatedAt = prompt("the updated at of this variables updated")) to entity StackContext.Stack
    }
    on destroyStack: command DestroyStack is {
      morph entity StackContext.Stack to state StackContext.Stack.DestroyedState with record Stack.DestroyedStateData(stackId = destroyStack.stackId, workspace = prompt("the workspace of this destroyed state data"), destroyedAt = prompt("the destroyed at of this destroyed state data"))
      tell event StackDestroyed(stackId = destroyStack.stackId, resourcesDestroyed = prompt("the resources destroyed of this stack destroyed"), destroyedAt = prompt("the destroyed at of this stack destroyed")) to entity StackContext.Stack
    }
    on lockStack: command LockStack is {
      tell event StackLocked(stackId = lockStack.stackId, reason = lockStack.reason, lockedBy = lockStack.lockedBy, lockedAt = prompt("the locked at of this stack locked")) to entity StackContext.Stack
    }
    on unlockStack: command UnlockStack is {
      tell event StackUnlocked(stackId = unlockStack.stackId, unlockedBy = unlockStack.unlockedBy, unlockedAt = prompt("the unlocked at of this stack unlocked")) to entity StackContext.Stack
    }
    on driftDetected: event DriftDetected is {
      do "apply DriftDetected to the stack so it can be persisted and replayed"
    }
    on driftReconciled: event DriftReconciled is {
      do "apply DriftReconciled to the stack so it can be persisted and replayed"
    }
    on planGenerated: event PlanGenerated is {
      do "apply PlanGenerated to the stack so it can be persisted and replayed"
    }
    on stackApplyCompleted: event StackApplyCompleted is {
      do "apply StackApplyCompleted to the stack so it can be persisted and replayed"
    }
    on stackApplyStarted: event StackApplyStarted is {
      do "apply StackApplyStarted to the stack so it can be persisted and replayed"
    }
    on stackCreated: event StackCreated is {
      do "apply StackCreated to the stack so it can be persisted and replayed"
    }
    on stackDestroyed: event StackDestroyed is {
      do "apply StackDestroyed to the stack so it can be persisted and replayed"
    }
    on stackLocked: event StackLocked is {
      do "apply StackLocked to the stack so it can be persisted and replayed"
    }
    on stackUnlocked: event StackUnlocked is {
      do "apply StackUnlocked to the stack so it can be persisted and replayed"
    }
    on variablesUpdated: event VariablesUpdated is {
      do "apply VariablesUpdated to the stack so it can be persisted and replayed"
    }
  } with {
    briefly "Processes stack commands"
    described as {
      | Handles stack lifecycle from creation
      | through provisioning, drift detection, and destruction.
    }
  }
} with {
  briefly "Stack aggregate"
  described as {
    | The Stack entity manages infrastructure as code
    | stacks, state, and provisioning lifecycle.
  }
}
