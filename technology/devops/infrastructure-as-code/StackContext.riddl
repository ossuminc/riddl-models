// Infrastructure as Code - Stack Context
context StackContext is {
  include "types.riddl"
  include "Stack.riddl"
  // Repository for stack persistence
  repository StackRepository is {
    inlet StackRepositoryFromStack is type StackEvent
    inlet StackRepositoryFromInfrastructureAnalytics is type StackEvent
    outlet StackRepositoryResponses is type Stack.StackResult
    schema StackData is relational
      of stacks as type Stack
        index on field Stack.stackId
        index on field Stack.workspace.environment

    handler StackPersistence is {
      on command Stack.CreateStack is {
        tell event Stack.StackCreated to entity StackContext.Stack
        do "Store new stack"
      }
      on command Stack.PlanStack is {
        do "Store execution plan"
      }
      on command Stack.ApplyStack is {
        do "Store apply start and update stack resources and status"
      }
      on command Stack.DetectDrift is {
        do "Store drift report"
      }
      on command Stack.ReconcileDrift is {
        do "Update drift status"
      }
      on command Stack.UpdateVariables is {
        tell event Stack.VariablesUpdated to entity StackContext.Stack
        do "Update variables"
      }
      on command Stack.DestroyStack is {
        do "Archive stack"
      }
      on command Stack.LockStack is {
        do "Update lock status"
      }
      on command Stack.UnlockStack is {
        do "Clear lock status"
      }
    } with {
      briefly "Persists stack commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Stack data persistence"
    described as {
      | The StackRepository provides persistent storage for
      | stacks, resources, and state history.
    }
  }
  // Projector for infrastructure analytics
  projector InfrastructureAnalytics is {
    inlet InfrastructureAnalyticsFromStack is type StackEvent
    outlet InfrastructureAnalyticsOut is type StackEvent
    updates repository StackContext.StackRepository
    record InfrastructureStats is  {
      totalStacks: Natural with {
        briefly "Total"
        described as {
          |Total stacks.
        }
      }
      activeStacks: Natural with {
        briefly "Active"
        described as {
          |Active stacks.
        }
      }
      totalResources: Natural with {
        briefly "Resources"
        described as {
          |Total resources.
        }
      }
      driftedStacks: Natural with {
        briefly "Drifted"
        described as {
          |Stacks with drift.
        }
      }
      successfulApplies: Natural with {
        briefly "Successful"
        described as {
          |Successful applies today.
        }
      }
      failedApplies: Natural with {
        briefly "Failed"
        described as {
          |Failed applies today.
        }
      }
    } with {
      briefly "Infrastructure statistics"
      described as {
        |IaC metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Stack.StackCreated is {
        tell event Stack.StackCreated to repository StackContext.StackRepository
        do "Update stack counts"
      }
      on event Stack.StackApplyCompleted is {
        tell event Stack.StackApplyCompleted to repository StackContext.StackRepository
        do "Update apply metrics"
      }
      on event Stack.DriftDetected is {
        tell event Stack.DriftDetected to repository StackContext.StackRepository
        do "Update drift metrics"
      }
      on event Stack.StackDestroyed is {
        tell event Stack.StackDestroyed to repository StackContext.StackRepository
        do "Update destruction metrics"
      }
    } with {
      briefly "Maintains infrastructure analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Infrastructure analytics projections"
    described as {
      |Maintains IaC analytics data.
    }
  }
  // ---- Event publication for Stack ----
  type StackEvent is one of {
    StackContext.Stack.StackCreated,
    StackContext.Stack.PlanGenerated,
    StackContext.Stack.StackApplyStarted,
    StackContext.Stack.StackApplyCompleted,
    StackContext.Stack.DriftDetected,
    StackContext.Stack.DriftReconciled,
    StackContext.Stack.VariablesUpdated,
    StackContext.Stack.StackDestroyed,
    StackContext.Stack.StackLocked,
    StackContext.Stack.StackUnlocked
  } with {
    briefly "Stack event alternation"
    described as {
      |Union of all Stack events, for streaming and event-sourced
      |persistence.
    }
  }
  processor StackEventSource as source is {
    outlet StackEvents is type StackEvent
    handler StackSourceHandler is {
      on event Stack.StackCreated is {
        send event Stack.StackCreated to outlet StackEvents
      }
      on event Stack.PlanGenerated is {
        send event Stack.PlanGenerated to outlet StackEvents
      }
      on event Stack.StackApplyStarted is {
        send event Stack.StackApplyStarted to outlet StackEvents
      }
      on event Stack.StackApplyCompleted is {
        send event Stack.StackApplyCompleted to outlet StackEvents
      }
      on event Stack.DriftDetected is {
        send event Stack.DriftDetected to outlet StackEvents
      }
      on event Stack.DriftReconciled is {
        send event Stack.DriftReconciled to outlet StackEvents
      }
      on event Stack.VariablesUpdated is {
        send event Stack.VariablesUpdated to outlet StackEvents
      }
      on event Stack.StackDestroyed is {
        send event Stack.StackDestroyed to outlet StackEvents
      }
      on event Stack.StackLocked is {
        send event Stack.StackLocked to outlet StackEvents
      }
      on event Stack.StackUnlocked is {
        send event Stack.StackUnlocked to outlet StackEvents
      }
      on other is {
        error "Unexpected message for source StackEventSource"
      }
    } with {
      briefly "Stack source handler"
      described as {
        |Publishes Stack events onto the outlet.
      }
    }
  } with {
    briefly "Stack event source"
    described as {
      |Publishes Stack entity events into the streaming topology.
    }
  }
  processor StackEventSink as sink is {
    inlet StackInlet is type StackEvent
    handler StackSinkHandler is {
      on event Stack.StackCreated is {
        tell event Stack.StackCreated to repository StackContext.StackRepository
      }
      on event Stack.PlanGenerated is {
        tell event Stack.PlanGenerated to repository StackContext.StackRepository
      }
      on event Stack.StackApplyStarted is {
        tell event Stack.StackApplyStarted to repository StackContext.StackRepository
      }
      on event Stack.StackApplyCompleted is {
        tell event Stack.StackApplyCompleted to repository StackContext.StackRepository
      }
      on event Stack.DriftDetected is {
        tell event Stack.DriftDetected to repository StackContext.StackRepository
      }
      on event Stack.DriftReconciled is {
        tell event Stack.DriftReconciled to repository StackContext.StackRepository
      }
      on event Stack.VariablesUpdated is {
        tell event Stack.VariablesUpdated to repository StackContext.StackRepository
      }
      on event Stack.StackDestroyed is {
        tell event Stack.StackDestroyed to repository StackContext.StackRepository
      }
      on event Stack.StackLocked is {
        tell event Stack.StackLocked to repository StackContext.StackRepository
      }
      on event Stack.StackUnlocked is {
        tell event Stack.StackUnlocked to repository StackContext.StackRepository
      }
      on other is {
        error "Unexpected message for sink StackEventSink"
      }
    } with {
      briefly "Stack sink handler"
      described as {
        |Persists Stack events via the repository.
      }
    }
  } with {
    briefly "Stack event sink"
    described as {
      |Receives Stack events for persistence.
    }
  }
  connector StackEventFlow is {
    from outlet StackContext.StackEventSource.StackEvents to
      inlet StackContext.StackEventSink.StackInlet
  } with {
    briefly "Stack event flow"
    described as {
      |Connects the Stack source to its sink.
    }
  }
  processor StackEventSplit is {
    inlet StackEventSplitIn is type StackEvent
    outlet StackEventSplitToStackRepository is type StackEvent
    outlet StackEventSplitToInfrastructureAnalytics is type StackEvent
    handler StackEventSplitHandler is {
      on event Stack.StackCreated is {
        send event Stack.StackCreated to outlet StackEventSplitToStackRepository
        send event Stack.StackCreated to outlet StackEventSplitToInfrastructureAnalytics
        tell event Stack.StackCreated to entity StackContext.Stack
      }
      on event Stack.PlanGenerated is {
        send event Stack.PlanGenerated to outlet StackEventSplitToStackRepository
        send event Stack.PlanGenerated to outlet StackEventSplitToInfrastructureAnalytics
        tell event Stack.PlanGenerated to entity StackContext.Stack
      }
      on event Stack.StackApplyStarted is {
        send event Stack.StackApplyStarted to outlet StackEventSplitToStackRepository
        send event Stack.StackApplyStarted to outlet StackEventSplitToInfrastructureAnalytics
        tell event Stack.StackApplyStarted to entity StackContext.Stack
      }
      on event Stack.StackApplyCompleted is {
        send event Stack.StackApplyCompleted to outlet StackEventSplitToStackRepository
        send event Stack.StackApplyCompleted to outlet StackEventSplitToInfrastructureAnalytics
        tell event Stack.StackApplyCompleted to entity StackContext.Stack
      }
      on event Stack.DriftDetected is {
        send event Stack.DriftDetected to outlet StackEventSplitToStackRepository
        send event Stack.DriftDetected to outlet StackEventSplitToInfrastructureAnalytics
        tell event Stack.DriftDetected to entity StackContext.Stack
      }
      on event Stack.DriftReconciled is {
        send event Stack.DriftReconciled to outlet StackEventSplitToStackRepository
        send event Stack.DriftReconciled to outlet StackEventSplitToInfrastructureAnalytics
        tell event Stack.DriftReconciled to entity StackContext.Stack
      }
      on event Stack.VariablesUpdated is {
        send event Stack.VariablesUpdated to outlet StackEventSplitToStackRepository
        send event Stack.VariablesUpdated to outlet StackEventSplitToInfrastructureAnalytics
        tell event Stack.VariablesUpdated to entity StackContext.Stack
      }
      on event Stack.StackDestroyed is {
        send event Stack.StackDestroyed to outlet StackEventSplitToStackRepository
        send event Stack.StackDestroyed to outlet StackEventSplitToInfrastructureAnalytics
        tell event Stack.StackDestroyed to entity StackContext.Stack
      }
      on event Stack.StackLocked is {
        send event Stack.StackLocked to outlet StackEventSplitToStackRepository
        send event Stack.StackLocked to outlet StackEventSplitToInfrastructureAnalytics
        tell event Stack.StackLocked to entity StackContext.Stack
      }
      on event Stack.StackUnlocked is {
        send event Stack.StackUnlocked to outlet StackEventSplitToStackRepository
        send event Stack.StackUnlocked to outlet StackEventSplitToInfrastructureAnalytics
        tell event Stack.StackUnlocked to entity StackContext.Stack
      }
      on other is {
        error "Unexpected message for processor StackEventSplit"
      }
    } with {
      briefly "Stack event fan-out handler"
      described as {
        |Delivers each Stack event to all of its consumers.
      }
    }
  } with {
    briefly "Stack event fan-out"
    described as {
      |Fans Stack events out to the repository and projectors.
    }
  }
  connector LinkStackToStackEventSplit is {
    from outlet StackContext.Stack.StackEvents2 to
      inlet StackContext.StackEventSplit.StackEventSplitIn
  } with {
    briefly "LinkStackToStackEventSplit"
  }
  connector LinkStackEventSplitToStackRepository is {
    from outlet StackContext.StackEventSplit.StackEventSplitToStackRepository to
      inlet StackContext.StackRepository.StackRepositoryFromStack
  } with {
    briefly "LinkStackEventSplitToStackRepository"
  }
  connector LinkStackEventSplitToInfrastructureAnalytics is {
    from outlet StackContext.StackEventSplit.StackEventSplitToInfrastructureAnalytics to
      inlet StackContext.InfrastructureAnalytics.InfrastructureAnalyticsFromStack
  } with {
    briefly "LinkStackEventSplitToInfrastructureAnalytics"
  }
  connector LinkInfrastructureAnalyticsToStackRepository is {
    from outlet StackContext.InfrastructureAnalytics.InfrastructureAnalyticsOut to
      inlet StackContext.StackRepository.StackRepositoryFromInfrastructureAnalytics
  } with {
    briefly "LinkInfrastructureAnalyticsToStackRepository"
  }
} with {
  briefly "Bounded context for infrastructure as code"
  described as {
    | The StackContext is the bounded context for
    | IaC state management and provisioning.
  }
}
