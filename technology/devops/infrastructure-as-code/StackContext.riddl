// Infrastructure as Code - Stack Context
context StackContext as router is {
  type ToModuleRegistryServiceCommand is one of {
    Stack.RecordModule or Stack.UpdateVariables
  } with {
    briefly "What ToModuleRegistryService turns its answers into"
  }
  inlet StackContextFromToCloudProviderService is command Stack.ReconcileDrift with {
    briefly "What ToCloudProviderService makes of the answers it gets"
  }
  connector 'ToCloudProviderService Intake' is from outlet StackContext.ToCloudProviderService.ToCloudProviderServiceToStackContext to inlet StackContext.StackContextFromToCloudProviderService with {
    briefly "Answers translated by ToCloudProviderService, on their way in"
  }
  inlet StackContextFromToModuleRegistryService is type ToModuleRegistryServiceCommand with {
    briefly "What ToModuleRegistryService makes of the answers it gets"
  }
  connector 'ToModuleRegistryService Intake' is from outlet StackContext.ToModuleRegistryService.ToModuleRegistryServiceToStackContext to inlet StackContext.StackContextFromToModuleRegistryService with {
    briefly "Answers translated by ToModuleRegistryService, on their way in"
  }
  inlet StackContextFromToSecretManagerService is command Stack.ApplyStack with {
    briefly "What ToSecretManagerService makes of the answers it gets"
  }
  connector 'ToSecretManagerService Intake' is from outlet StackContext.ToSecretManagerService.ToSecretManagerServiceToStackContext to inlet StackContext.StackContextFromToSecretManagerService with {
    briefly "Answers translated by ToSecretManagerService, on their way in"
  }
  inlet StackContextFromToStateBackendService is command Stack.PlanStack with {
    briefly "What ToStateBackendService makes of the answers it gets"
  }
  connector 'ToStateBackendService Intake' is from outlet StackContext.ToStateBackendService.ToStateBackendServiceToStackContext to inlet StackContext.StackContextFromToStateBackendService with {
    briefly "Answers translated by ToStateBackendService, on their way in"
  }
  inlet StackCommandStreamIn is type StackCommand  outlet StackCommandStreamOut is type StackCommand
  inlet StackResultStreamIn is result Stack.StackResult  outlet StackResultStreamOut is result Stack.StackResult
  handler StackContextBoundary is {
    on recordModule: command Stack.RecordModule is {
      send recordModule to outlet StackContext.StackCommandStreamOut
    }
    on createStack: command Stack.CreateStack is {
      send createStack to outlet StackContext.StackCommandStreamOut
    }
    on planStack: command Stack.PlanStack is {
      send planStack to outlet StackContext.StackCommandStreamOut
    }
    on applyStack: command Stack.ApplyStack is {
      send applyStack to outlet StackContext.StackCommandStreamOut
    }
    on detectDrift: command Stack.DetectDrift is {
      send detectDrift to outlet StackContext.StackCommandStreamOut
    }
    on reconcileDrift: command Stack.ReconcileDrift is {
      send reconcileDrift to outlet StackContext.StackCommandStreamOut
    }
    on updateVariables: command Stack.UpdateVariables is {
      send updateVariables to outlet StackContext.StackCommandStreamOut
    }
    on destroyStack: command Stack.DestroyStack is {
      send destroyStack to outlet StackContext.StackCommandStreamOut
    }
    on lockStack: command Stack.LockStack is {
      send lockStack to outlet StackContext.StackCommandStreamOut
    }
    on unlockStack: command Stack.UnlockStack is {
      send unlockStack to outlet StackContext.StackCommandStreamOut
    }
    on stackResult: result Stack.StackResult is {
      send stackResult to outlet StackContext.StackResultStreamOut
    }
    on other is {
      error "Unexpected message at the StackContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'StackCommand Stream Intake' is from outlet StackContext.StackCommandStreamOut to inlet StackContext.Stack.StackCommands  connector 'StackResult Stream Egress' is from outlet StackContext.StackRepository.StackRepositoryResponses to inlet StackContext.StackResultStreamIn  adaptor FromCloudProviderService from context CloudProviderService as sink is { 
    inlet FromCloudProviderServiceIn is type CloudProviderService.CloudProviderServiceEvent    handler FromCloudProviderServiceHandler is {
      on provisioningFailed: event CloudProviderService.ProvisioningFailed is {
        do "the apply failed; the engineer reads the error before retrying or unlocking"
      }
      on resourceDestroyed: event CloudProviderService.ResourceDestroyed is {
        do "the resource is gone; destroying the stack was recorded here"
      }
      on resourceProvisioned: event CloudProviderService.ResourceProvisioned is {
        do "the resource exists; the apply that created it was recorded here"
      }
      on resourceUpdated: event CloudProviderService.ResourceUpdated is {
        do "the resource matches; reconciling the drift was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromCloudProviderService"
      }
    } with {
      briefly "from cloud provider service"
      described as {
        |Carries messages from the external CloudProviderService.
      }
    }
  } with {
    briefly "CloudProviderService integration"
    described as {
      |The model's side of the CloudProviderService conversation.
    }
  }
  adaptor ToCloudProviderService to context CloudProviderService as router is { 
    outlet ToCloudProviderServiceToStackContext is command Stack.ReconcileDrift
    inlet ToCloudProviderServiceIn is type StackEvent    inlet ToCloudProviderServiceReplies is result CloudProviderService.ResourceCurrentState    outlet ToCloudProviderServiceOut is type CloudProviderService.CloudProviderServiceCommand
    handler ToCloudProviderServiceHandler is {
      on driftDetected: event Stack.DriftDetected is {
        let askAnswer: type CloudProviderService.ResourceCurrentState = ask query CloudProviderService.GetResourceState of context CloudProviderService
        do "drift being the claim that reality and the plan differ, which only the provider can settle"
        when prompt("askAnswer.properties differ from the plan") then
          send command Stack.ReconcileDrift(stackId = driftDetected.stackId, runId = prompt("a new run")) to outlet StackContext.ToCloudProviderService.ToCloudProviderServiceToStackContext
        end
      }
      on stackApplyStarted: event Stack.StackApplyStarted is {
        let item0: type CloudProviderService.ProvisionResource = prompt("translate the stackApplyStarted event into a ProvisionResource, the apply being when the plan stops being hypothetical")
        send item0 to outlet StackContext.ToCloudProviderService.ToCloudProviderServiceOut
      }
      on driftReconciled: event Stack.DriftReconciled is {
        let item0: type CloudProviderService.UpdateResource = prompt("translate the driftReconciled event into a UpdateResource, reconciliation being what changes an existing resource")
        send item0 to outlet StackContext.ToCloudProviderService.ToCloudProviderServiceOut
      }
      on stackDestroyed: event Stack.StackDestroyed is {
        let item0: type CloudProviderService.DestroyResource = prompt("translate the stackDestroyed event into a DestroyResource, destruction of the stack being what removes them")
        send item0 to outlet StackContext.ToCloudProviderService.ToCloudProviderServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToCloudProviderService"
      }
    } with {
      briefly "to cloud provider service"
      described as {
        |Carries messages to the external CloudProviderService.
      }
    }
  } with {
    briefly "CloudProviderService integration"
    described as {
      |The model's side of the CloudProviderService conversation.
    }
  }
  adaptor ToModuleRegistryService to context ModuleRegistryService as router is { 
    outlet ToModuleRegistryServiceToStackContext is type ToModuleRegistryServiceCommand
    inlet ToModuleRegistryServiceIn is type StackEvent    inlet ToModuleRegistryServiceReplies is type ModuleRegistryService.ModuleRegistryServiceReply    outlet ToModuleRegistryServiceOut is type ModuleRegistryService.ModuleRegistryServiceRequest
    handler ToModuleRegistryServiceHandler is {
      on stackCreated: event Stack.StackCreated is {
        let askAnswer: type ModuleRegistryService.ModuleBundle = ask query ModuleRegistryService.GetModule of context ModuleRegistryService
        do "a new stack needing the module it is composed from"
        send command Stack.RecordModule(stackId = stackCreated.stackId, moduleId = prompt("the module id of this record module"), version = prompt("the version of this record module"), checksum = prompt("the checksum of this record module")) to outlet StackContext.ToModuleRegistryService.ToModuleRegistryServiceToStackContext
      }
      on planGenerated: event Stack.PlanGenerated is {
        let askAnswer: type ModuleRegistryService.ModuleVersionList = ask query ModuleRegistryService.ListModuleVersions of context ModuleRegistryService
        do "a plan needing to know which module versions it could pin"
        when prompt("the plan pins an older version than askAnswer.latestVersion") then
          send command Stack.UpdateVariables(stackId = planGenerated.stackId, updatedVariables = prompt("the module pinned to askAnswer.latestVersion")) to outlet StackContext.ToModuleRegistryService.ToModuleRegistryServiceToStackContext
        end
      }
      on other is {
        error "Unexpected message for adaptor ToModuleRegistryService"
      }
    } with {
      briefly "to module registry service"
      described as {
        |Carries messages to the external ModuleRegistryService.
      }
    }
  } with {
    briefly "ModuleRegistryService integration"
    described as {
      |The model's side of the ModuleRegistryService conversation.
    }
  }
  adaptor FromPolicyEngineService from context PolicyEngineService as sink is { 
    inlet FromPolicyEngineServiceIn is event PolicyEngineService.PolicyEvaluated    handler FromPolicyEngineServiceHandler is {
      on policyEvaluated: event PolicyEngineService.PolicyEvaluated is {
        do "the policy verdict is in; applying is the engineer's act"
      }
      on other is {
        error "Unexpected message for adaptor FromPolicyEngineService"
      }
    } with {
      briefly "from policy engine service"
      described as {
        |Carries messages from the external PolicyEngineService.
      }
    }
  } with {
    briefly "PolicyEngineService integration"
    described as {
      |The model's side of the PolicyEngineService conversation.
    }
  }
  adaptor ToPolicyEngineService to context PolicyEngineService as flow is { 
    inlet ToPolicyEngineServiceIn is type StackEvent    outlet ToPolicyEngineServiceOut is command PolicyEngineService.EvaluatePolicy
    handler ToPolicyEngineServiceHandler is {
      on planGenerated: event Stack.PlanGenerated is {
        let item0: type PolicyEngineService.EvaluatePolicy = prompt("translate the planGenerated event into a EvaluatePolicy, a plan being what policy is judged against, before it is applied")
        send item0 to outlet StackContext.ToPolicyEngineService.ToPolicyEngineServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToPolicyEngineService"
      }
    } with {
      briefly "to policy engine service"
      described as {
        |Carries messages to the external PolicyEngineService.
      }
    }
  } with {
    briefly "PolicyEngineService integration"
    described as {
      |The model's side of the PolicyEngineService conversation.
    }
  }
  adaptor FromSecretManagerService from context SecretManagerService as sink is { 
    inlet FromSecretManagerServiceIn is event SecretManagerService.SecretRotated    handler FromSecretManagerServiceHandler is {
      on secretRotated: event SecretManagerService.SecretRotated is {
        do "the secret is rotated; updating the variables was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromSecretManagerService"
      }
    } with {
      briefly "from secret manager service"
      described as {
        |Carries messages from the external SecretManagerService.
      }
    }
  } with {
    briefly "SecretManagerService integration"
    described as {
      |The model's side of the SecretManagerService conversation.
    }
  }
  adaptor ToSecretManagerService to context SecretManagerService as router is { 
    outlet ToSecretManagerServiceToStackContext is command Stack.ApplyStack
    inlet ToSecretManagerServiceIn is type StackEvent    inlet ToSecretManagerServiceReplies is result SecretManagerService.SecretValue    outlet ToSecretManagerServiceOut is type SecretManagerService.SecretManagerServiceRequest
    handler ToSecretManagerServiceHandler is {
      on stackApplyStarted: event Stack.StackApplyStarted is {
        let askAnswer: type SecretManagerService.SecretValue = ask query SecretManagerService.GetSecret of context SecretManagerService
        do "an apply needing the credentials it will authenticate with"
        when prompt("the apply has not yet authenticated with askAnswer.value") then
          send command Stack.ApplyStack(stackId = stackApplyStarted.stackId, runId = stackApplyStarted.runId, autoApprove = prompt("false")) to outlet StackContext.ToSecretManagerService.ToSecretManagerServiceToStackContext
        end
      }
      on variablesUpdated: event Stack.VariablesUpdated is {
        let item0: type SecretManagerService.RotateSecret = prompt("translate the variablesUpdated event into a RotateSecret, a changed variable set being when a secret may have been exposed")
        send item0 to outlet StackContext.ToSecretManagerService.ToSecretManagerServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToSecretManagerService"
      }
    } with {
      briefly "to secret manager service"
      described as {
        |Carries messages to the external SecretManagerService.
      }
    }
  } with {
    briefly "SecretManagerService integration"
    described as {
      |The model's side of the SecretManagerService conversation.
    }
  }
  adaptor FromStateBackendService from context StateBackendService as sink is { 
    inlet FromStateBackendServiceIn is type StateBackendService.StateBackendServiceEvent    handler FromStateBackendServiceHandler is {
      on stateLocked: event StateBackendService.StateLocked is {
        do "the backend holds the lock; locking was recorded here"
      }
      on stateSaved: event StateBackendService.StateSaved is {
        do "the backend has the state; completing the apply was recorded here"
      }
      on stateUnlocked: event StateBackendService.StateUnlocked is {
        do "the backend released the lock; unlocking was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromStateBackendService"
      }
    } with {
      briefly "from state backend service"
      described as {
        |Carries messages from the external StateBackendService.
      }
    }
  } with {
    briefly "StateBackendService integration"
    described as {
      |The model's side of the StateBackendService conversation.
    }
  }
  adaptor ToStateBackendService to context StateBackendService as router is { 
    outlet ToStateBackendServiceToStackContext is command Stack.PlanStack
    inlet ToStateBackendServiceIn is type StackEvent    inlet ToStateBackendServiceReplies is result StateBackendService.StateData    outlet ToStateBackendServiceOut is type StateBackendService.StateBackendServiceCommand
    handler ToStateBackendServiceHandler is {
      on stackApplyStarted: event Stack.StackApplyStarted is {
        let askAnswer: type StateBackendService.StateData = ask query StateBackendService.LoadState of context StateBackendService
        do "an apply needing the state it is diffing against"
        when prompt("askAnswer.stateVersion is newer than the plan's") then
          send command Stack.PlanStack(stackId = stackApplyStarted.stackId, runId = stackApplyStarted.runId) to outlet StackContext.ToStateBackendService.ToStateBackendServiceToStackContext
        end
      }
      on stackLocked: event Stack.StackLocked is {
        let item0: type StateBackendService.LockState = prompt("translate the stackLocked event into a LockState, the lock being the thing itself")
        send item0 to outlet StackContext.ToStateBackendService.ToStateBackendServiceOut
      }
      on stackUnlocked: event Stack.StackUnlocked is {
        let item0: type StateBackendService.UnlockState = prompt("translate the stackUnlocked event into a UnlockState, and the unlock")
        send item0 to outlet StackContext.ToStateBackendService.ToStateBackendServiceOut
      }
      on stackApplyCompleted: event Stack.StackApplyCompleted is {
        let item0: type StateBackendService.SaveState = prompt("translate the stackApplyCompleted event into a SaveState, a finished apply being what changes the state to save")
        send item0 to outlet StackContext.ToStateBackendService.ToStateBackendServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToStateBackendService"
      }
    } with {
      briefly "to state backend service"
      described as {
        |Carries messages to the external StateBackendService.
      }
    }
  } with {
    briefly "StateBackendService integration"
    described as {
      |The model's side of the StateBackendService conversation.
    }
  }
  include "types.riddl"
  include "Stack.riddl"
  // Repository for stack persistence
  type StackRepositoryCommand is one of {
    StackContext.StackRepository.PersistDriftDetected or StackContext.StackRepository.PersistDriftReconciled or StackContext.StackRepository.PersistPlanGenerated or StackContext.StackRepository.PersistStackApplyCompleted or StackContext.StackRepository.PersistStackApplyStarted or StackContext.StackRepository.PersistStackCreated or StackContext.StackRepository.PersistStackDestroyed or StackContext.StackRepository.PersistStackLocked or StackContext.StackRepository.PersistStackUnlocked or StackContext.StackRepository.PersistVariablesUpdated
  } with {
    briefly "Anything that writes StackRepository"
    described as {
      |The persistence commands StackRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository StackRepository as flow is {
    inlet StackRepositoryFromInfrastructureAnalytics is type StackRepositoryCommand    command PersistDriftReconciled is {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row DriftReconciled applies to.
        }
      }
      reconciledResources: Natural? with {
        briefly "Reconciled resources"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reconciledAt: TimeStamp? with {
        briefly "Reconciled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DriftReconciled"
      described as {
        |Instructs this repository to apply DriftReconciled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlanGenerated is {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlanGenerated applies to.
        }
      }
      plan: ExecutionPlan? with {
        briefly "Plan"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      generatedAt: TimeStamp? with {
        briefly "Generated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PlanGenerated"
      described as {
        |Instructs this repository to apply PlanGenerated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStackApplyStarted is {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row StackApplyStarted applies to.
        }
      }
      runId: RunId? with {
        briefly "Run id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      startedAt: TimeStamp? with {
        briefly "Started at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist StackApplyStarted"
      described as {
        |Instructs this repository to apply StackApplyStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStackLocked is {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row StackLocked applies to.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      lockedBy: String(1,200)? with {
        briefly "Locked by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      lockedAt: TimeStamp? with {
        briefly "Locked at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist StackLocked"
      described as {
        |Instructs this repository to apply StackLocked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStackUnlocked is {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row StackUnlocked applies to.
        }
      }
      unlockedBy: String(1,200)? with {
        briefly "Unlocked by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      unlockedAt: TimeStamp? with {
        briefly "Unlocked at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist StackUnlocked"
      described as {
        |Instructs this repository to apply StackUnlocked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVariablesUpdated is {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row VariablesUpdated applies to.
        }
      }
      variableCount: Natural? with {
        briefly "Variable count"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist VariablesUpdated"
      described as {
        |Instructs this repository to apply VariablesUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDriftDetected is {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row DriftDetected applies to.
        }
      }
      report: DriftReport? with {
        briefly "Report"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      detectedAt: TimeStamp? with {
        briefly "Detected at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DriftDetected"
      described as {
        |Instructs this repository to apply DriftDetected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStackApplyCompleted is {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row StackApplyCompleted applies to.
        }
      }
      result: ApplyResult? with {
        briefly "Result"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist StackApplyCompleted"
      described as {
        |Instructs this repository to apply StackApplyCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStackCreated is {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row StackCreated applies to.
        }
      }
      workspace: WorkspaceInfo? with {
        briefly "Workspace"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      config: StackConfiguration? with {
        briefly "Config"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist StackCreated"
      described as {
        |Instructs this repository to apply StackCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStackDestroyed is {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row StackDestroyed applies to.
        }
      }
      resourcesDestroyed: Natural? with {
        briefly "Resources destroyed"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      destroyedAt: TimeStamp? with {
        briefly "Destroyed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist StackDestroyed"
      described as {
        |Instructs this repository to apply StackDestroyed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet StackRepositoryResponses is result Stack.StackResult
    record StoredStack is {
      stackId: StackId with {
        briefly "stackId"
        described as {
          |The stackId column of the stored stack row.
        }
      }
      workspace: WorkspaceInfo with {
        briefly "workspace"
        described as {
          |The workspace column of the stored stack row.
        }
      }
      reconciledResources: Natural? with {
        briefly "Reconciled resources"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reconciledAt: TimeStamp? with {
        briefly "Reconciled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      plan: ExecutionPlan? with {
        briefly "Plan"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      generatedAt: TimeStamp? with {
        briefly "Generated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      runId: RunId? with {
        briefly "Run id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      startedAt: TimeStamp? with {
        briefly "Started at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      lockedBy: String(1,200)? with {
        briefly "Locked by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      lockedAt: TimeStamp? with {
        briefly "Locked at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      unlockedBy: String(1,200)? with {
        briefly "Unlocked by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      unlockedAt: TimeStamp? with {
        briefly "Unlocked at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      variableCount: Natural? with {
        briefly "Variable count"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      report: DriftReport? with {
        briefly "Report"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      detectedAt: TimeStamp? with {
        briefly "Detected at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      result: ApplyResult? with {
        briefly "Result"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      config: StackConfiguration? with {
        briefly "Config"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      resourcesDestroyed: Natural? with {
        briefly "Resources destroyed"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      destroyedAt: TimeStamp? with {
        briefly "Destroyed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored stack row"
      described as {
        |The persistence shape of stack data as this repository stores it.
      }
    }
    schema StackData is relational
      of stacks as record StoredStack
        key on field StoredStack.stackId
        index on field StoredStack.workspace.environment
 with {
      briefly "Stack data schema"
      described as {
        |The relational schema holding stack data for the StackRepository.
      }
    }
    handler StackPersistence is {
      on persistDriftReconciled: command PersistDriftReconciled is {
        update StackData.stacks set reconciledResources = persistDriftReconciled.reconciledResources, reconciledAt = persistDriftReconciled.reconciledAt where stackId == persistDriftReconciled.stackId
      }
      on persistPlanGenerated: command PersistPlanGenerated is {
        update StackData.stacks set plan = persistPlanGenerated.plan, generatedAt = persistPlanGenerated.generatedAt where stackId == persistPlanGenerated.stackId
      }
      on persistStackApplyStarted: command PersistStackApplyStarted is {
        update StackData.stacks set runId = persistStackApplyStarted.runId, startedAt = persistStackApplyStarted.startedAt where stackId == persistStackApplyStarted.stackId
      }
      on persistStackLocked: command PersistStackLocked is {
        update StackData.stacks set reason = persistStackLocked.reason, lockedBy = persistStackLocked.lockedBy, lockedAt = persistStackLocked.lockedAt where stackId == persistStackLocked.stackId
      }
      on persistStackUnlocked: command PersistStackUnlocked is {
        update StackData.stacks set unlockedBy = persistStackUnlocked.unlockedBy, unlockedAt = persistStackUnlocked.unlockedAt where stackId == persistStackUnlocked.stackId
      }
      on persistVariablesUpdated: command PersistVariablesUpdated is {
        update StackData.stacks set variableCount = persistVariablesUpdated.variableCount, updatedAt = persistVariablesUpdated.updatedAt where stackId == persistVariablesUpdated.stackId
      }
      on persistDriftDetected: command PersistDriftDetected is {
        update StackData.stacks set report = persistDriftDetected.report, detectedAt = persistDriftDetected.detectedAt where stackId == persistDriftDetected.stackId
      }
      on persistStackApplyCompleted: command PersistStackApplyCompleted is {
        update StackData.stacks set result = persistStackApplyCompleted.result, completedAt = persistStackApplyCompleted.completedAt where stackId == persistStackApplyCompleted.stackId
      }
      on persistStackCreated: command PersistStackCreated is {
        update StackData.stacks set workspace = persistStackCreated.workspace, config = persistStackCreated.config, createdAt = persistStackCreated.createdAt where stackId == persistStackCreated.stackId
      }
      on persistStackDestroyed: command PersistStackDestroyed is {
        update StackData.stacks set resourcesDestroyed = persistStackDestroyed.resourcesDestroyed, destroyedAt = persistStackDestroyed.destroyedAt where stackId == persistStackDestroyed.stackId
      }
      on query GetInfrastructureStats is {
        let infrastructureStatsView: type InfrastructureStatsView = prompt("read the infrastructure stats projection")
        reply infrastructureStatsView
      }
    } with {
      briefly "Persists stack commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Stack data persistence"
    described as {
      | The StackRepository provides persistent storage for
      | stacks, resources, and state history.
    }
  }
  // Projector for infrastructure analytics
  query GetInfrastructureStats replies result InfrastructureStatsView is {
    infrastructureStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which infrastructure stats to retrieve.
      }
    }
  } with {
    briefly "Get infrastructure stats"
    described as {
      |Retrieves the infrastructure stats projection.
    }
  }
  result InfrastructureStatsView is {
    infrastructureStats: InfrastructureAnalytics.InfrastructureStats with {
      briefly "Infrastructure stats"
      described as {
        |The infrastructure stats being returned.
      }
    }
  } with {
    briefly "Infrastructure stats view"
    described as {
      |Read model view carrying the infrastructure stats projection.
    }
  }
  projector InfrastructureAnalytics as flow is {
    updates repository StackContext.StackRepository
    outlet InfrastructureAnalyticsToRepository is type StackRepositoryCommand
    inlet InfrastructureAnalyticsFromStack is type StackEvent    record InfrastructureStats is {
      totalStacks: Natural with {
        briefly "Total"
        described as {
          |Total stacks.
        }
      }
      activeStacks: Natural with {
        briefly "Active"
        described as {
          |Active stacks.
        }
      }
      totalResources: Natural with {
        briefly "Resources"
        described as {
          |Total resources.
        }
      }
      driftedStacks: Natural with {
        briefly "Drifted"
        described as {
          |Stacks with drift.
        }
      }
      successfulApplies: Natural with {
        briefly "Successful"
        described as {
          |Successful applies today.
        }
      }
      failedApplies: Natural with {
        briefly "Failed"
        described as {
          |Failed applies today.
        }
      }
    } with {
      briefly "Infrastructure statistics"
      described as {
        |IaC metrics.
      }
    }
    handler AnalyticsHandler is {
      on driftReconciled: event Stack.DriftReconciled is {
        tell command StackContext.StackRepository.PersistDriftReconciled(stackId = driftReconciled.stackId, reconciledResources = driftReconciled.reconciledResources, reconciledAt = driftReconciled.reconciledAt) to repository StackContext.StackRepository
        do "apply DriftReconciled to the InfrastructureAnalytics projection"
      }
      on planGenerated: event Stack.PlanGenerated is {
        tell command StackContext.StackRepository.PersistPlanGenerated(stackId = planGenerated.stackId, plan = planGenerated.plan, generatedAt = planGenerated.generatedAt) to repository StackContext.StackRepository
        do "apply PlanGenerated to the InfrastructureAnalytics projection"
      }
      on stackApplyStarted: event Stack.StackApplyStarted is {
        tell command StackContext.StackRepository.PersistStackApplyStarted(stackId = stackApplyStarted.stackId, runId = stackApplyStarted.runId, startedAt = stackApplyStarted.startedAt) to repository StackContext.StackRepository
        do "apply StackApplyStarted to the InfrastructureAnalytics projection"
      }
      on stackLocked: event Stack.StackLocked is {
        tell command StackContext.StackRepository.PersistStackLocked(stackId = stackLocked.stackId, reason = stackLocked.reason, lockedBy = stackLocked.lockedBy, lockedAt = stackLocked.lockedAt) to repository StackContext.StackRepository
        do "apply StackLocked to the InfrastructureAnalytics projection"
      }
      on stackUnlocked: event Stack.StackUnlocked is {
        tell command StackContext.StackRepository.PersistStackUnlocked(stackId = stackUnlocked.stackId, unlockedBy = stackUnlocked.unlockedBy, unlockedAt = stackUnlocked.unlockedAt) to repository StackContext.StackRepository
        do "apply StackUnlocked to the InfrastructureAnalytics projection"
      }
      on variablesUpdated: event Stack.VariablesUpdated is {
        tell command StackContext.StackRepository.PersistVariablesUpdated(stackId = variablesUpdated.stackId, variableCount = variablesUpdated.variableCount, updatedAt = variablesUpdated.updatedAt) to repository StackContext.StackRepository
        do "apply VariablesUpdated to the InfrastructureAnalytics projection"
      }
      on stackCreated: event Stack.StackCreated is {
        tell command StackContext.StackRepository.PersistStackCreated(stackId = stackCreated.stackId, workspace = stackCreated.workspace, config = stackCreated.config, createdAt = stackCreated.createdAt) to repository StackContext.StackRepository
        do "Update stack counts"
      }
      on stackApplyCompleted: event Stack.StackApplyCompleted is {
        tell command StackContext.StackRepository.PersistStackApplyCompleted(stackId = stackApplyCompleted.stackId, result = stackApplyCompleted.result, completedAt = stackApplyCompleted.completedAt) to repository StackContext.StackRepository
        do "Update apply metrics"
      }
      on driftDetected: event Stack.DriftDetected is {
        tell command StackContext.StackRepository.PersistDriftDetected(stackId = driftDetected.stackId, report = driftDetected.report, detectedAt = driftDetected.detectedAt) to repository StackContext.StackRepository
        do "Update drift metrics"
      }
      on stackDestroyed: event Stack.StackDestroyed is {
        tell command StackContext.StackRepository.PersistStackDestroyed(stackId = stackDestroyed.stackId, resourcesDestroyed = stackDestroyed.resourcesDestroyed, destroyedAt = stackDestroyed.destroyedAt) to repository StackContext.StackRepository
        do "Update destruction metrics"
      }
      on moduleRecorded: event Stack.ModuleRecorded is {
        do "a module recorded changes nothing this projector keeps"
      }
    } with {
      briefly "Maintains infrastructure analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Infrastructure analytics projections"
    described as {
      |Maintains IaC analytics data.
    }
  }
  // ---- Event publication for Stack ----
  type StackEvent is one of {
    StackContext.Stack.StackCreated or StackContext.Stack.PlanGenerated or StackContext.Stack.StackApplyStarted or StackContext.Stack.StackApplyCompleted or StackContext.Stack.DriftDetected or StackContext.Stack.DriftReconciled or StackContext.Stack.VariablesUpdated or StackContext.Stack.StackDestroyed or StackContext.Stack.StackLocked or StackContext.Stack.StackUnlocked or StackContext.Stack.ModuleRecorded
  } with {
    briefly "Stack event alternation"
    described as {
      |Union of all Stack events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet StackEventSplit as split is {
    outlet StackEventSplitToToStateBackendService is type StackEvent
    outlet StackEventSplitToToSecretManagerService is type StackEvent
    outlet StackEventSplitToToPolicyEngineService is type StackEvent
    outlet StackEventSplitToToModuleRegistryService is type StackEvent
    outlet StackEventSplitToToCloudProviderService is type StackEvent
    inlet StackEventSplitIn is type StackEvent    outlet StackEventSplitToInfrastructureAnalytics is type StackEvent
    handler StackEventSplitHandler is {
      on stackCreated: event Stack.StackCreated is {
        send stackCreated to outlet StackEventSplitToInfrastructureAnalytics
        send stackCreated to outlet StackEventSplitToToModuleRegistryService
        tell stackCreated to entity StackContext.Stack
      }
      on planGenerated: event Stack.PlanGenerated is {
        send planGenerated to outlet StackEventSplitToInfrastructureAnalytics
        send planGenerated to outlet StackEventSplitToToPolicyEngineService
        send planGenerated to outlet StackEventSplitToToModuleRegistryService
        tell planGenerated to entity StackContext.Stack
      }
      on stackApplyStarted: event Stack.StackApplyStarted is {
        send stackApplyStarted to outlet StackEventSplitToInfrastructureAnalytics
        send stackApplyStarted to outlet StackEventSplitToToStateBackendService
        send stackApplyStarted to outlet StackEventSplitToToSecretManagerService
        send stackApplyStarted to outlet StackEventSplitToToCloudProviderService
        tell stackApplyStarted to entity StackContext.Stack
      }
      on stackApplyCompleted: event Stack.StackApplyCompleted is {
        send stackApplyCompleted to outlet StackEventSplitToInfrastructureAnalytics
        send stackApplyCompleted to outlet StackEventSplitToToStateBackendService
        tell stackApplyCompleted to entity StackContext.Stack
      }
      on driftDetected: event Stack.DriftDetected is {
        send driftDetected to outlet StackEventSplitToInfrastructureAnalytics
        send driftDetected to outlet StackEventSplitToToCloudProviderService
        tell driftDetected to entity StackContext.Stack
      }
      on driftReconciled: event Stack.DriftReconciled is {
        send driftReconciled to outlet StackEventSplitToInfrastructureAnalytics
        send driftReconciled to outlet StackEventSplitToToCloudProviderService
        tell driftReconciled to entity StackContext.Stack
      }
      on variablesUpdated: event Stack.VariablesUpdated is {
        send variablesUpdated to outlet StackEventSplitToInfrastructureAnalytics
        send variablesUpdated to outlet StackEventSplitToToSecretManagerService
        tell variablesUpdated to entity StackContext.Stack
      }
      on stackDestroyed: event Stack.StackDestroyed is {
        send stackDestroyed to outlet StackEventSplitToInfrastructureAnalytics
        send stackDestroyed to outlet StackEventSplitToToCloudProviderService
        tell stackDestroyed to entity StackContext.Stack
      }
      on stackLocked: event Stack.StackLocked is {
        send stackLocked to outlet StackEventSplitToInfrastructureAnalytics
        send stackLocked to outlet StackEventSplitToToStateBackendService
        tell stackLocked to entity StackContext.Stack
      }
      on stackUnlocked: event Stack.StackUnlocked is {
        send stackUnlocked to outlet StackEventSplitToInfrastructureAnalytics
        send stackUnlocked to outlet StackEventSplitToToStateBackendService
        tell stackUnlocked to entity StackContext.Stack
      }
      on moduleRecorded: event Stack.ModuleRecorded is {
        send moduleRecorded to outlet StackEventSplitToInfrastructureAnalytics
        send moduleRecorded to outlet StackEventSplitToToStateBackendService
        tell moduleRecorded to entity StackContext.Stack
      }
      on other is {
        error "Unexpected message for processor StackEventSplit"
      }
    } with {
      briefly "Stack event fan-out handler"
      described as {
        |Delivers each Stack event to all of its consumers.
      }
    }
  } with {
    briefly "Stack event fan-out"
    described as {
      |Fans Stack events out to the repository and projectors.
    }
  }
  connector 'ToStateBackendService Feed' is from outlet StackContext.StackEventSplit.StackEventSplitToToStateBackendService to inlet StackContext.ToStateBackendService.ToStateBackendServiceIn with {
    briefly "The Stack events ToStateBackendService translates, on their way to it"
  }
  connector 'ToSecretManagerService Feed' is from outlet StackContext.StackEventSplit.StackEventSplitToToSecretManagerService to inlet StackContext.ToSecretManagerService.ToSecretManagerServiceIn with {
    briefly "The Stack events ToSecretManagerService translates, on their way to it"
  }
  connector 'ToPolicyEngineService Feed' is from outlet StackContext.StackEventSplit.StackEventSplitToToPolicyEngineService to inlet StackContext.ToPolicyEngineService.ToPolicyEngineServiceIn with {
    briefly "The Stack events ToPolicyEngineService translates, on their way to it"
  }
  connector 'ToModuleRegistryService Feed' is from outlet StackContext.StackEventSplit.StackEventSplitToToModuleRegistryService to inlet StackContext.ToModuleRegistryService.ToModuleRegistryServiceIn with {
    briefly "The Stack events ToModuleRegistryService translates, on their way to it"
  }
  connector 'ToCloudProviderService Feed' is from outlet StackContext.StackEventSplit.StackEventSplitToToCloudProviderService to inlet StackContext.ToCloudProviderService.ToCloudProviderServiceIn with {
    briefly "The Stack events ToCloudProviderService translates, on their way to it"
  }
  connector 'StackEvent Stream' is from outlet StackContext.Stack.StackEvents2 to inlet StackContext.StackEventSplit.StackEventSplitIn with {
    briefly "Stack events, fanned out to storage and read models"
  }
  connector 'InfrastructureAnalytics Feed' is from outlet StackContext.StackEventSplit.StackEventSplitToInfrastructureAnalytics to inlet StackContext.InfrastructureAnalytics.InfrastructureAnalyticsFromStack with {
    briefly "Stack events feeding the InfrastructureAnalytics projection"
  }
  connector 'InfrastructureAnalytics Storage' is from outlet StackContext.InfrastructureAnalytics.InfrastructureAnalyticsToRepository to inlet StackContext.StackRepository.StackRepositoryFromInfrastructureAnalytics with {
    briefly "InfrastructureAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for infrastructure as code"
  described as {
    | The StackContext is the bounded context for
    | IaC state management and provisioning.
  }
}
