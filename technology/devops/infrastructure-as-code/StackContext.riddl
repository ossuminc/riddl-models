// Infrastructure as Code - Stack Context
context StackContext as router is {
  inlet StackCommandStreamIn is type StackCommand  outlet StackCommandStreamOut is type StackCommand
  inlet StackResultStreamIn is result Stack.StackResult  outlet StackResultStreamOut is result Stack.StackResult
  handler StackContextBoundary is {
    on createStack: command Stack.CreateStack is {
      send createStack to outlet StackContext.StackCommandStreamOut
    }
    on planStack: command Stack.PlanStack is {
      send planStack to outlet StackContext.StackCommandStreamOut
    }
    on applyStack: command Stack.ApplyStack is {
      send applyStack to outlet StackContext.StackCommandStreamOut
    }
    on detectDrift: command Stack.DetectDrift is {
      send detectDrift to outlet StackContext.StackCommandStreamOut
    }
    on reconcileDrift: command Stack.ReconcileDrift is {
      send reconcileDrift to outlet StackContext.StackCommandStreamOut
    }
    on updateVariables: command Stack.UpdateVariables is {
      send updateVariables to outlet StackContext.StackCommandStreamOut
    }
    on destroyStack: command Stack.DestroyStack is {
      send destroyStack to outlet StackContext.StackCommandStreamOut
    }
    on lockStack: command Stack.LockStack is {
      send lockStack to outlet StackContext.StackCommandStreamOut
    }
    on unlockStack: command Stack.UnlockStack is {
      send unlockStack to outlet StackContext.StackCommandStreamOut
    }
    on stackResult: result Stack.StackResult is {
      send stackResult to outlet StackContext.StackResultStreamOut
    }
    on other is {
      error "Unexpected message at the StackContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'StackCommand Stream Intake' is from outlet StackContext.StackCommandStreamOut to inlet StackContext.Stack.StackCommands  connector 'StackResult Stream Egress' is from outlet StackContext.StackRepository.StackRepositoryResponses to inlet StackContext.StackResultStreamIn  adaptor FromCloudProviderService from context CloudProviderService is { 
    handler FromCloudProviderServiceHandler is {
      on event CloudProviderService.ProvisioningFailed is {
        do "the model receives provisioning failed"
      }
      on result CloudProviderService.ResourceCurrentState is {
        do "the model receives resource current state"
      }
      on event CloudProviderService.ResourceDestroyed is {
        do "the model receives resource destroyed"
      }
      on event CloudProviderService.ResourceProvisioned is {
        do "the model receives resource provisioned"
      }
      on event CloudProviderService.ResourceUpdated is {
        do "the model receives resource updated"
      }
      on other is {
        error "Unexpected message for adaptor FromCloudProviderService"
      }
    } with {
      briefly "from cloud provider service"
      described as {
        |Carries messages from the external CloudProviderService.
      }
    }
  } with {
    briefly "CloudProviderService integration"
    described as {
      |The model's side of the CloudProviderService conversation.
    }
  }
  adaptor ToCloudProviderService to context CloudProviderService is { 
    handler ToCloudProviderServiceHandler is {
      on command CloudProviderService.DestroyResource is {
        do "the model sends destroy resource"
      }
      on query CloudProviderService.GetResourceState is {
        do "the model sends get resource state"
      }
      on command CloudProviderService.ProvisionResource is {
        do "the model sends provision resource"
      }
      on command CloudProviderService.UpdateResource is {
        do "the model sends update resource"
      }
      on other is {
        error "Unexpected message for adaptor ToCloudProviderService"
      }
    } with {
      briefly "to cloud provider service"
      described as {
        |Carries messages to the external CloudProviderService.
      }
    }
  } with {
    briefly "CloudProviderService integration"
    described as {
      |The model's side of the CloudProviderService conversation.
    }
  }
  adaptor FromModuleRegistryService from context ModuleRegistryService is { 
    handler FromModuleRegistryServiceHandler is {
      on result ModuleRegistryService.ModuleBundle is {
        do "the model receives module bundle"
      }
      on result ModuleRegistryService.ModuleVersionList is {
        do "the model receives module version list"
      }
      on other is {
        error "Unexpected message for adaptor FromModuleRegistryService"
      }
    } with {
      briefly "from module registry service"
      described as {
        |Carries messages from the external ModuleRegistryService.
      }
    }
  } with {
    briefly "ModuleRegistryService integration"
    described as {
      |The model's side of the ModuleRegistryService conversation.
    }
  }
  adaptor ToModuleRegistryService to context ModuleRegistryService is { 
    handler ToModuleRegistryServiceHandler is {
      on query ModuleRegistryService.GetModule is {
        do "the model sends get module"
      }
      on query ModuleRegistryService.ListModuleVersions is {
        do "the model sends list module versions"
      }
      on other is {
        error "Unexpected message for adaptor ToModuleRegistryService"
      }
    } with {
      briefly "to module registry service"
      described as {
        |Carries messages to the external ModuleRegistryService.
      }
    }
  } with {
    briefly "ModuleRegistryService integration"
    described as {
      |The model's side of the ModuleRegistryService conversation.
    }
  }
  adaptor FromPolicyEngineService from context PolicyEngineService is { 
    handler FromPolicyEngineServiceHandler is {
      on event PolicyEngineService.PolicyEvaluated is {
        do "the model receives policy evaluated"
      }
      on other is {
        error "Unexpected message for adaptor FromPolicyEngineService"
      }
    } with {
      briefly "from policy engine service"
      described as {
        |Carries messages from the external PolicyEngineService.
      }
    }
  } with {
    briefly "PolicyEngineService integration"
    described as {
      |The model's side of the PolicyEngineService conversation.
    }
  }
  adaptor ToPolicyEngineService to context PolicyEngineService is { 
    handler ToPolicyEngineServiceHandler is {
      on command PolicyEngineService.EvaluatePolicy is {
        do "the model sends evaluate policy"
      }
      on other is {
        error "Unexpected message for adaptor ToPolicyEngineService"
      }
    } with {
      briefly "to policy engine service"
      described as {
        |Carries messages to the external PolicyEngineService.
      }
    }
  } with {
    briefly "PolicyEngineService integration"
    described as {
      |The model's side of the PolicyEngineService conversation.
    }
  }
  adaptor FromSecretManagerService from context SecretManagerService is { 
    handler FromSecretManagerServiceHandler is {
      on event SecretManagerService.SecretRotated is {
        do "the model receives secret rotated"
      }
      on result SecretManagerService.SecretValue is {
        do "the model receives secret value"
      }
      on other is {
        error "Unexpected message for adaptor FromSecretManagerService"
      }
    } with {
      briefly "from secret manager service"
      described as {
        |Carries messages from the external SecretManagerService.
      }
    }
  } with {
    briefly "SecretManagerService integration"
    described as {
      |The model's side of the SecretManagerService conversation.
    }
  }
  adaptor ToSecretManagerService to context SecretManagerService is { 
    handler ToSecretManagerServiceHandler is {
      on query SecretManagerService.GetSecret is {
        do "the model sends get secret"
      }
      on command SecretManagerService.RotateSecret is {
        do "the model sends rotate secret"
      }
      on other is {
        error "Unexpected message for adaptor ToSecretManagerService"
      }
    } with {
      briefly "to secret manager service"
      described as {
        |Carries messages to the external SecretManagerService.
      }
    }
  } with {
    briefly "SecretManagerService integration"
    described as {
      |The model's side of the SecretManagerService conversation.
    }
  }
  adaptor FromStateBackendService from context StateBackendService is { 
    handler FromStateBackendServiceHandler is {
      on result StateBackendService.StateData is {
        do "the model receives state data"
      }
      on event StateBackendService.StateLocked is {
        do "the model receives state locked"
      }
      on event StateBackendService.StateSaved is {
        do "the model receives state saved"
      }
      on event StateBackendService.StateUnlocked is {
        do "the model receives state unlocked"
      }
      on other is {
        error "Unexpected message for adaptor FromStateBackendService"
      }
    } with {
      briefly "from state backend service"
      described as {
        |Carries messages from the external StateBackendService.
      }
    }
  } with {
    briefly "StateBackendService integration"
    described as {
      |The model's side of the StateBackendService conversation.
    }
  }
  adaptor ToStateBackendService to context StateBackendService is { 
    handler ToStateBackendServiceHandler is {
      on query StateBackendService.LoadState is {
        do "the model sends load state"
      }
      on command StateBackendService.LockState is {
        do "the model sends lock state"
      }
      on command StateBackendService.SaveState is {
        do "the model sends save state"
      }
      on command StateBackendService.UnlockState is {
        do "the model sends unlock state"
      }
      on other is {
        error "Unexpected message for adaptor ToStateBackendService"
      }
    } with {
      briefly "to state backend service"
      described as {
        |Carries messages to the external StateBackendService.
      }
    }
  } with {
    briefly "StateBackendService integration"
    described as {
      |The model's side of the StateBackendService conversation.
    }
  }
  include "types.riddl"
  include "Stack.riddl"
  // Repository for stack persistence
  type StackRepositoryCommand is one of {
    StackContext.StackRepository.PersistDriftDetected or StackContext.StackRepository.PersistDriftReconciled or StackContext.StackRepository.PersistPlanGenerated or StackContext.StackRepository.PersistStackApplyCompleted or StackContext.StackRepository.PersistStackApplyStarted or StackContext.StackRepository.PersistStackCreated or StackContext.StackRepository.PersistStackDestroyed or StackContext.StackRepository.PersistStackLocked or StackContext.StackRepository.PersistStackUnlocked or StackContext.StackRepository.PersistVariablesUpdated
  } with {
    briefly "Anything that writes StackRepository"
    described as {
      |The persistence commands StackRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository StackRepository as flow is {
    inlet StackRepositoryFromInfrastructureAnalytics is type StackRepositoryCommand
    command PersistDriftReconciled is  {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row DriftReconciled applies to.
        }
      }
    } with {
      briefly "Persist DriftReconciled"
      described as {
        |Instructs this repository to apply DriftReconciled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlanGenerated is  {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlanGenerated applies to.
        }
      }
    } with {
      briefly "Persist PlanGenerated"
      described as {
        |Instructs this repository to apply PlanGenerated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStackApplyStarted is  {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row StackApplyStarted applies to.
        }
      }
    } with {
      briefly "Persist StackApplyStarted"
      described as {
        |Instructs this repository to apply StackApplyStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStackLocked is  {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row StackLocked applies to.
        }
      }
    } with {
      briefly "Persist StackLocked"
      described as {
        |Instructs this repository to apply StackLocked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStackUnlocked is  {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row StackUnlocked applies to.
        }
      }
    } with {
      briefly "Persist StackUnlocked"
      described as {
        |Instructs this repository to apply StackUnlocked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVariablesUpdated is  {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row VariablesUpdated applies to.
        }
      }
    } with {
      briefly "Persist VariablesUpdated"
      described as {
        |Instructs this repository to apply VariablesUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDriftDetected is  {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row DriftDetected applies to.
        }
      }
    } with {
      briefly "Persist DriftDetected"
      described as {
        |Instructs this repository to apply DriftDetected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStackApplyCompleted is  {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row StackApplyCompleted applies to.
        }
      }
    } with {
      briefly "Persist StackApplyCompleted"
      described as {
        |Instructs this repository to apply StackApplyCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStackCreated is  {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row StackCreated applies to.
        }
      }
    } with {
      briefly "Persist StackCreated"
      described as {
        |Instructs this repository to apply StackCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStackDestroyed is  {
      stackId: StackId with {
        briefly "Row addressed"
        described as {
          |Which stored row StackDestroyed applies to.
        }
      }
    } with {
      briefly "Persist StackDestroyed"
      described as {
        |Instructs this repository to apply StackDestroyed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet StackRepositoryResponses is result Stack.StackResult
    record StoredStack is  {
      stackId: StackId with {
        briefly "stackId"
        described as {
          |The stackId column of the stored stack row.
        }
      }
      workspace: WorkspaceInfo with {
        briefly "workspace"
        described as {
          |The workspace column of the stored stack row.
        }
      }
    } with {
      briefly "Stored stack row"
      described as {
        |The persistence shape of stack data as this repository stores it.
      }
    }
    schema StackData is relational
      of stacks as record StoredStack
        index on field StoredStack.stackId
        index on field StoredStack.workspace.environment
 with {
      briefly "Stack data schema"
      described as {
        |The relational schema holding stack data for the StackRepository.
      }
    }
    handler StackPersistence is {
      on persistDriftReconciled: command PersistDriftReconciled is {
        do "apply DriftReconciled to the stored row"
      }
      on persistPlanGenerated: command PersistPlanGenerated is {
        do "apply PlanGenerated to the stored row"
      }
      on persistStackApplyStarted: command PersistStackApplyStarted is {
        do "apply StackApplyStarted to the stored row"
      }
      on persistStackLocked: command PersistStackLocked is {
        do "apply StackLocked to the stored row"
      }
      on persistStackUnlocked: command PersistStackUnlocked is {
        do "apply StackUnlocked to the stored row"
      }
      on persistVariablesUpdated: command PersistVariablesUpdated is {
        do "apply VariablesUpdated to the stored row"
      }
      on persistDriftDetected: command PersistDriftDetected is {
        do "apply DriftDetected to the stored row"
      }
      on persistStackApplyCompleted: command PersistStackApplyCompleted is {
        do "apply StackApplyCompleted to the stored row"
      }
      on persistStackCreated: command PersistStackCreated is {
        do "apply StackCreated to the stored row"
      }
      on persistStackDestroyed: command PersistStackDestroyed is {
        do "apply StackDestroyed to the stored row"
      }
      on query GetInfrastructureStats is {
        let infrastructureStatsView: type InfrastructureStatsView = prompt("read the infrastructure stats projection")
        reply infrastructureStatsView
      }
    } with {
      briefly "Persists stack commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Stack data persistence"
    described as {
      | The StackRepository provides persistent storage for
      | stacks, resources, and state history.
    }
  }
  // Projector for infrastructure analytics
  query GetInfrastructureStats replies result InfrastructureStatsView is  {
    infrastructureStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which infrastructure stats to retrieve.
      }
    }
  } with {
    briefly "Get infrastructure stats"
    described as {
      |Retrieves the infrastructure stats projection.
    }
  }
  result InfrastructureStatsView is  {
    infrastructureStats: InfrastructureAnalytics.InfrastructureStats with {
      briefly "Infrastructure stats"
      described as {
        |The infrastructure stats being returned.
      }
    }
  } with {
    briefly "Infrastructure stats view"
    described as {
      |Read model view carrying the infrastructure stats projection.
    }
  }
  projector InfrastructureAnalytics as flow is {
    outlet InfrastructureAnalyticsToRepository is type StackRepositoryCommand
    updates repository StackContext.StackRepository
    inlet InfrastructureAnalyticsFromStack is type StackEvent
    record InfrastructureStats is  {
      totalStacks: Natural with {
        briefly "Total"
        described as {
          |Total stacks.
        }
      }
      activeStacks: Natural with {
        briefly "Active"
        described as {
          |Active stacks.
        }
      }
      totalResources: Natural with {
        briefly "Resources"
        described as {
          |Total resources.
        }
      }
      driftedStacks: Natural with {
        briefly "Drifted"
        described as {
          |Stacks with drift.
        }
      }
      successfulApplies: Natural with {
        briefly "Successful"
        described as {
          |Successful applies today.
        }
      }
      failedApplies: Natural with {
        briefly "Failed"
        described as {
          |Failed applies today.
        }
      }
    } with {
      briefly "Infrastructure statistics"
      described as {
        |IaC metrics.
      }
    }
    handler AnalyticsHandler is {
      on driftReconciled: event Stack.DriftReconciled is {
        tell command StackContext.StackRepository.PersistDriftReconciled(stackId = driftReconciled.stackId) to repository StackContext.StackRepository
        do "apply DriftReconciled to the InfrastructureAnalytics projection"
      }
      on planGenerated: event Stack.PlanGenerated is {
        tell command StackContext.StackRepository.PersistPlanGenerated(stackId = planGenerated.stackId) to repository StackContext.StackRepository
        do "apply PlanGenerated to the InfrastructureAnalytics projection"
      }
      on stackApplyStarted: event Stack.StackApplyStarted is {
        tell command StackContext.StackRepository.PersistStackApplyStarted(stackId = stackApplyStarted.stackId) to repository StackContext.StackRepository
        do "apply StackApplyStarted to the InfrastructureAnalytics projection"
      }
      on stackLocked: event Stack.StackLocked is {
        tell command StackContext.StackRepository.PersistStackLocked(stackId = stackLocked.stackId) to repository StackContext.StackRepository
        do "apply StackLocked to the InfrastructureAnalytics projection"
      }
      on stackUnlocked: event Stack.StackUnlocked is {
        tell command StackContext.StackRepository.PersistStackUnlocked(stackId = stackUnlocked.stackId) to repository StackContext.StackRepository
        do "apply StackUnlocked to the InfrastructureAnalytics projection"
      }
      on variablesUpdated: event Stack.VariablesUpdated is {
        tell command StackContext.StackRepository.PersistVariablesUpdated(stackId = variablesUpdated.stackId) to repository StackContext.StackRepository
        do "apply VariablesUpdated to the InfrastructureAnalytics projection"
      }
      on stackCreated: event Stack.StackCreated is {
        tell command StackContext.StackRepository.PersistStackCreated(stackId = stackCreated.stackId) to repository StackContext.StackRepository
        do "Update stack counts"
      }
      on stackApplyCompleted: event Stack.StackApplyCompleted is {
        tell command StackContext.StackRepository.PersistStackApplyCompleted(stackId = stackApplyCompleted.stackId) to repository StackContext.StackRepository
        do "Update apply metrics"
      }
      on driftDetected: event Stack.DriftDetected is {
        tell command StackContext.StackRepository.PersistDriftDetected(stackId = driftDetected.stackId) to repository StackContext.StackRepository
        do "Update drift metrics"
      }
      on stackDestroyed: event Stack.StackDestroyed is {
        tell command StackContext.StackRepository.PersistStackDestroyed(stackId = stackDestroyed.stackId) to repository StackContext.StackRepository
        do "Update destruction metrics"
      }
    } with {
      briefly "Maintains infrastructure analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Infrastructure analytics projections"
    described as {
      |Maintains IaC analytics data.
    }
  }
  // ---- Event publication for Stack ----
  type StackEvent is one of {
    StackContext.Stack.StackCreated or StackContext.Stack.PlanGenerated or StackContext.Stack.StackApplyStarted or StackContext.Stack.StackApplyCompleted or StackContext.Stack.DriftDetected or StackContext.Stack.DriftReconciled or StackContext.Stack.VariablesUpdated or StackContext.Stack.StackDestroyed or StackContext.Stack.StackLocked or StackContext.Stack.StackUnlocked
  } with {
    briefly "Stack event alternation"
    described as {
      |Union of all Stack events, for streaming and event-sourced
      |persistence.
    }
  }
  processor StackEventSplit as flow is {
    inlet StackEventSplitIn is type StackEvent
    outlet StackEventSplitToInfrastructureAnalytics is type StackEvent
    handler StackEventSplitHandler is {
      on stackCreated: event Stack.StackCreated is {
        send stackCreated to outlet StackEventSplitToInfrastructureAnalytics
        tell stackCreated to entity StackContext.Stack
      }
      on planGenerated: event Stack.PlanGenerated is {
        send planGenerated to outlet StackEventSplitToInfrastructureAnalytics
        tell planGenerated to entity StackContext.Stack
      }
      on stackApplyStarted: event Stack.StackApplyStarted is {
        send stackApplyStarted to outlet StackEventSplitToInfrastructureAnalytics
        tell stackApplyStarted to entity StackContext.Stack
      }
      on stackApplyCompleted: event Stack.StackApplyCompleted is {
        send stackApplyCompleted to outlet StackEventSplitToInfrastructureAnalytics
        tell stackApplyCompleted to entity StackContext.Stack
      }
      on driftDetected: event Stack.DriftDetected is {
        send driftDetected to outlet StackEventSplitToInfrastructureAnalytics
        tell driftDetected to entity StackContext.Stack
      }
      on driftReconciled: event Stack.DriftReconciled is {
        send driftReconciled to outlet StackEventSplitToInfrastructureAnalytics
        tell driftReconciled to entity StackContext.Stack
      }
      on variablesUpdated: event Stack.VariablesUpdated is {
        send variablesUpdated to outlet StackEventSplitToInfrastructureAnalytics
        tell variablesUpdated to entity StackContext.Stack
      }
      on stackDestroyed: event Stack.StackDestroyed is {
        send stackDestroyed to outlet StackEventSplitToInfrastructureAnalytics
        tell stackDestroyed to entity StackContext.Stack
      }
      on stackLocked: event Stack.StackLocked is {
        send stackLocked to outlet StackEventSplitToInfrastructureAnalytics
        tell stackLocked to entity StackContext.Stack
      }
      on stackUnlocked: event Stack.StackUnlocked is {
        send stackUnlocked to outlet StackEventSplitToInfrastructureAnalytics
        tell stackUnlocked to entity StackContext.Stack
      }
      on other is {
        error "Unexpected message for processor StackEventSplit"
      }
    } with {
      briefly "Stack event fan-out handler"
      described as {
        |Delivers each Stack event to all of its consumers.
      }
    }
  } with {
    briefly "Stack event fan-out"
    described as {
      |Fans Stack events out to the repository and projectors.
    }
  }
  connector 'StackEvent Stream' is from outlet StackContext.Stack.StackEvents2 to inlet StackContext.StackEventSplit.StackEventSplitIn with {
    briefly "Stack events, fanned out to storage and read models"
  }
  connector 'InfrastructureAnalytics Feed' is from outlet StackContext.StackEventSplit.StackEventSplitToInfrastructureAnalytics to inlet StackContext.InfrastructureAnalytics.InfrastructureAnalyticsFromStack with {
    briefly "Stack events feeding the InfrastructureAnalytics projection"
  }
  connector 'InfrastructureAnalytics Storage' is from outlet StackContext.InfrastructureAnalytics.InfrastructureAnalyticsToRepository to inlet StackContext.StackRepository.StackRepositoryFromInfrastructureAnalytics with {
    briefly "InfrastructureAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for infrastructure as code"
  described as {
    | The StackContext is the bounded context for
    | IaC state management and provisioning.
  }
}
