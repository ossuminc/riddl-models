// Infrastructure as Code Domain Model
// IaC state management and provisioning
domain InfrastructureAsCode is {
  persistent connector 'StateBackendServiceReply Stream' is from outlet StateBackendService.StateBackendServiceRepliesOut to inlet StackContext.ToStateBackendService.ToStateBackendServiceReplies with {
    briefly "What StateBackendService answers StackContext"
  }
  persistent connector 'SecretManagerServiceReply Stream' is from outlet SecretManagerService.SecretManagerServiceRepliesOut to inlet StackContext.ToSecretManagerService.ToSecretManagerServiceReplies with {
    briefly "What SecretManagerService answers StackContext"
  }
  persistent connector 'ModuleRegistryServiceReply Stream' is from outlet ModuleRegistryService.ModuleRegistryServiceRepliesOut to inlet StackContext.ToModuleRegistryService.ToModuleRegistryServiceReplies with {
    briefly "What ModuleRegistryService answers StackContext"
  }
  persistent connector 'CloudProviderServiceReply Stream' is from outlet CloudProviderService.CloudProviderServiceRepliesOut to inlet StackContext.ToCloudProviderService.ToCloudProviderServiceReplies with {
    briefly "What CloudProviderService answers StackContext"
  }
  persistent connector 'CloudProviderServiceEvent Stream' is from outlet CloudProviderService.CloudProviderServiceEventsOut to inlet StackContext.FromCloudProviderService.FromCloudProviderServiceIn with {
    briefly "What CloudProviderService tells StackContext, unasked"
  }
  persistent connector 'PolicyEngineServiceEvent Stream' is from outlet PolicyEngineService.PolicyEngineServiceEventsOut to inlet StackContext.FromPolicyEngineService.FromPolicyEngineServiceIn with {
    briefly "What PolicyEngineService tells StackContext, unasked"
  }
  persistent connector 'SecretManagerServiceEvent Stream' is from outlet SecretManagerService.SecretManagerServiceEventsOut to inlet StackContext.FromSecretManagerService.FromSecretManagerServiceIn with {
    briefly "What SecretManagerService tells StackContext, unasked"
  }
  persistent connector 'StateBackendServiceEvent Stream' is from outlet StateBackendService.StateBackendServiceEventsOut to inlet StackContext.FromStateBackendService.FromStateBackendServiceIn with {
    briefly "What StateBackendService tells StackContext, unasked"
  }
  persistent connector 'ModuleRegistryServiceRequest Stream' is from outlet StackContext.ToModuleRegistryService.ToModuleRegistryServiceOut to inlet ModuleRegistryService.ModuleRegistryServiceRequests with {
    briefly "What StackContext asks ModuleRegistryService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user PlatformEngineer is "person managing infrastructure code" with {
    briefly "Platform Engineer"
    described as {
      |Person writing and maintaining IaC.
    }
  }
  user CloudArchitect is "person designing infrastructure" with {
    briefly "Cloud Architect"
    described as {
      |Person designing cloud architecture.
    }
  }
  user Operator is "person executing infrastructure changes" with {
    briefly "Operator"
    described as {
      |Person applying infrastructure changes.
    }
  }
  epic InfrastructureEpic is {
    user PlatformEngineer wants to "to manage infrastructure as code" so that "infrastructure is repeatable and version controlled"
    case ApplyInfrastructure is {
      user PlatformEngineer wants to "to apply infrastructure changes" so that "cloud resources match the desired state"
      step is "Engineer reviews" "infrastructure plan" "for changes" with {
        briefly "Review plan"
        described as {
          |Review proposed changes.
        }
      }
      step is "System validates" "state consistency" "and dependencies" with {
        briefly "Validate state"
        described as {
          |Check state consistency.
        }
      }
      step take input InfrastructureAsCodeApp.InfrastructureAsCodeScreen.ApplyStackInput from user PlatformEngineer with {
        briefly "Apply stack"
        described as {
          |Apply infrastructure changes.
        }
      }
      step is "System reports" "deployment status" "to engineer" with {
        briefly "Report status"
        described as {
          |Show deployment result.
        }
      }
    } with {
      briefly "Infrastructure application"
      described as {
        |Applying IaC changes to cloud.
      }
    }
  } with {
    briefly "Infrastructure management"
    described as {
      | Epic covering infrastructure provisioning,
      | state management, and drift detection.
    }
  }
  include "StackContext.riddl"
  include "external-contexts.riddl"
  application context InfrastructureAsCodeApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in InfrastructureAsCode are delivered.
      }
    }
    group InfrastructureAsCodeScreen is {
      input ApplyStackInput acquires command StackContext.Stack.ApplyStack with {
        briefly "Apply stack control"
        described as {
          |The control through which a user submits the apply stack request.
        }
      }
    } with {
      briefly "Infrastructure as code screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppStackCommands is type StackContext.Stack.StackCommand
    inlet AppStackRepositoryResponses is result StackContext.Stack.StackResult    handler InfrastructureAsCodeAppHandler is {
      on other is {
        error "Unexpected message for application context InfrastructureAsCodeApp"
      }
    } with {
      briefly "InfrastructureAsCodeApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "InfrastructureAsCodeApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'StateBackendServiceRequest Stream' is from outlet StackContext.ToStateBackendService.ToStateBackendServiceOut to inlet StateBackendService.StateBackendServiceRequests with {
    briefly "What StackContext asks StateBackendService to send"
  }
  persistent connector 'SecretManagerServiceRequest Stream' is from outlet StackContext.ToSecretManagerService.ToSecretManagerServiceOut to inlet SecretManagerService.SecretManagerServiceRequests with {
    briefly "What StackContext asks SecretManagerService to send"
  }
  persistent connector 'CloudProviderServiceRequest Stream' is from outlet StackContext.ToCloudProviderService.ToCloudProviderServiceOut to inlet CloudProviderService.CloudProviderServiceRequests with {
    briefly "What StackContext asks CloudProviderService to send"
  }
  persistent connector 'PolicyEngineServiceRequest Stream' is from outlet StackContext.ToPolicyEngineService.ToPolicyEngineServiceOut to inlet PolicyEngineService.PolicyEngineServiceRequests with {
    briefly "What StackContext asks PolicyEngineService to send"
  }
  persistent connector 'StackCommand Stream' is from outlet InfrastructureAsCodeApp.AppStackCommands to inlet StackContext.StackCommandStreamIn with {
    briefly "Stack commands from the application"
  }
  persistent connector 'StackResult Stream' is from outlet StackContext.StackResultStreamOut to inlet InfrastructureAsCodeApp.AppStackRepositoryResponses with {
    briefly "Stack query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet InfrastructureAsCodeApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Infrastructure as Code domain"
  described as {
    | The InfrastructureAsCode domain handles IaC
    | state management, provisioning, and drift detection.
  }
}
