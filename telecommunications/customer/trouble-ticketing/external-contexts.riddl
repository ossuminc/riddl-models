// Trouble Ticketing - External Contexts
external context NetworkDiagnostics as flow is {
  outlet NetworkDiagnosticsEventsOut is event DiagnosticsComplete
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet NetworkDiagnosticsRequests is command RunDiagnostics with {
    briefly "What this context asks the service to send"
  }
  handler NetworkDiagnosticsBoundary is {
    on command RunDiagnostics is {
      let diagnosticsComplete: type DiagnosticsComplete = prompt("the diagnostics complete this produces")
      send diagnosticsComplete to outlet NetworkDiagnostics.NetworkDiagnosticsEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context NetworkDiagnostics"
    }
  } with {
    briefly "NetworkDiagnostics boundary"
  }
  command RunDiagnostics is {
    accountNumber: AccountNumber with {
      briefly "Account"
      described as {
        |Customer account.
      }
    }
    testTypes: String(1,50)+ with {
      briefly "Tests"
      described as {
        |Diagnostic tests.
      }
    }
  } with {
    briefly "Run diagnostics"
    described as {
      |Runs network diagnostics.
    }
  }
  event DiagnosticsComplete is {
    accountNumber: AccountNumber with {
      briefly "Account"
      described as {
        |Customer account.
      }
    }
    results: DiagnosticResult+ with {
      briefly "Results"
      described as {
        |Test results.
      }
    }
    overallHealth: String(1,20) with {
      briefly "Health"
      described as {
        |Overall health.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Diagnostics complete"
    described as {
      |Emitted when tests finish.
    }
  }
} with {
  briefly "External network diagnostics"
  described as {
    |Automated diagnostic testing.
  }
}
external context DispatchSystem as flow is {
  type DispatchSystemEvent is one of {
    DispatchCompleted or DispatchScheduled or TechnicianArrived
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet DispatchSystemEventsOut is type DispatchSystemEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet DispatchSystemRequests is command ScheduleDispatch with {
    briefly "What this context asks the service to send"
  }
  handler DispatchSystemBoundary is {
    on command ScheduleDispatch is {
      let dispatchScheduled: type DispatchScheduled = prompt("the dispatch scheduled this produces")
      send dispatchScheduled to outlet DispatchSystem.DispatchSystemEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context DispatchSystem"
    }
  } with {
    briefly "DispatchSystem boundary"
  }
  command ScheduleDispatch is {
    ticketId: TicketId with {
      briefly "Ticket"
      described as {
        |Ticket ID.
      }
    }
    serviceAddress: String(1,500) with {
      briefly "Address"
      described as {
        |Service address.
      }
    }
    issueCategory: IssueCategory with {
      briefly "Category"
      described as {
        |Issue type.
      }
    }
    preferredWindow: TimeStamp with {
      briefly "Window"
      described as {
        |Preferred time.
      }
    }
  } with {
    briefly "Schedule dispatch"
    described as {
      |Schedules field technician.
    }
  }
  event DispatchScheduled is {
    ticketId: TicketId with {
      briefly "Ticket"
      described as {
        |Ticket ID.
      }
    }
    dispatch: DispatchInfo with {
      briefly "Dispatch"
      described as {
        |Dispatch details.
      }
    }
    scheduledAt: TimeStamp with {
      briefly "Scheduled"
      described as {
        |Schedule time.
      }
    }
  } with {
    briefly "Dispatch scheduled"
    described as {
      |Emitted when dispatch created.
    }
  }
  event TechnicianArrived is {
    dispatchId: UUID with {
      briefly "Dispatch"
      described as {
        |Dispatch ID.
      }
    }
    arrivedAt: TimeStamp with {
      briefly "Arrived"
      described as {
        |Arrival time.
      }
    }
  } with {
    briefly "Technician arrived"
    described as {
      |Emitted when tech on site.
    }
  }
  event DispatchCompleted is {
    dispatchId: UUID with {
      briefly "Dispatch"
      described as {
        |Dispatch ID.
      }
    }
    workPerformed: String(1,2000) with {
      briefly "Work"
      described as {
        |Work performed.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Dispatch completed"
    described as {
      |Emitted when field work done.
    }
  }
} with {
  briefly "External dispatch system"
  described as {
    |Field workforce management.
  }
}
external context CustomerNotification as flow is {
  outlet CustomerNotificationEventsOut is event UpdateSent
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet CustomerNotificationRequests is command SendTicketUpdate with {
    briefly "What this context asks the service to send"
  }
  handler CustomerNotificationBoundary is {
    on command SendTicketUpdate is {
      let updateSent: type UpdateSent = prompt("the update sent this produces")
      send updateSent to outlet CustomerNotification.CustomerNotificationEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context CustomerNotification"
    }
  } with {
    briefly "CustomerNotification boundary"
  }
  command SendTicketUpdate is {
    ticketId: TicketId with {
      briefly "Ticket"
      described as {
        |Ticket ID.
      }
    }
    customer: CustomerInfo with {
      briefly "Customer"
      described as {
        |Customer info.
      }
    }
    updateType: String(1,50) with {
      briefly "Type"
      described as {
        |Update type.
      }
    }
    message: String(1,2000) with {
      briefly "Message"
      described as {
        |Update message.
      }
    }
  } with {
    briefly "Send ticket update"
    described as {
      |Notifies customer of update.
    }
  }
  event UpdateSent is {
    ticketId: TicketId with {
      briefly "Ticket"
      described as {
        |Ticket ID.
      }
    }
    channel: String(1,20) with {
      briefly "Channel"
      described as {
        |SMS, email, etc.
      }
    }
    sentAt: TimeStamp with {
      briefly "Sent"
      described as {
        |Send time.
      }
    }
  } with {
    briefly "Update sent"
    described as {
      |Emitted when notification sent.
    }
  }
} with {
  briefly "External customer notification"
  described as {
    |Customer messaging service.
  }
}
external context KnowledgeBase as flow is {
  outlet KnowledgeBaseEventsOut is event SolutionsFound
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet KnowledgeBaseRequests is command SearchSolutions with {
    briefly "What this context asks the service to send"
  }
  handler KnowledgeBaseBoundary is {
    on command SearchSolutions is {
      let solutionsFound: type SolutionsFound = prompt("the solutions found this produces")
      send solutionsFound to outlet KnowledgeBase.KnowledgeBaseEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context KnowledgeBase"
    }
  } with {
    briefly "KnowledgeBase boundary"
  }
  command SearchSolutions is {
    issueDescription: String(1,1000) with {
      briefly "Issue"
      described as {
        |Issue description.
      }
    }
    category: IssueCategory with {
      briefly "Category"
      described as {
        |Issue category.
      }
    }
  } with {
    briefly "Search solutions"
    described as {
      |Searches knowledge base.
    }
  }
  event SolutionsFound is {
    solutions: String(1,2000)+ with {
      briefly "Solutions"
      described as {
        |Matching solutions.
      }
    }
    articleIds: String(1,50)+ with {
      briefly "Articles"
      described as {
        |Article IDs.
      }
    }
    foundAt: TimeStamp with {
      briefly "Found"
      described as {
        |Search time.
      }
    }
  } with {
    briefly "Solutions found"
    described as {
      |Emitted when solutions located.
    }
  }
} with {
  briefly "External knowledge base"
  described as {
    |Solution knowledge repository.
  }
}
external context CRM as flow is {
  outlet CRMEventsOut is event CustomerHistoryRetrieved
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet CRMRequests is command GetCustomerHistory with {
    briefly "What this context asks the service to send"
  }
  handler CRMBoundary is {
    on command GetCustomerHistory is {
      let customerHistoryRetrieved: type CustomerHistoryRetrieved = prompt("the customer history retrieved this produces")
      send customerHistoryRetrieved to outlet CRM.CRMEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context CRM"
    }
  } with {
    briefly "CRM boundary"
  }
  command GetCustomerHistory is {
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
  } with {
    briefly "Get customer history"
    described as {
      |Retrieves customer history.
    }
  }
  event CustomerHistoryRetrieved is {
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    previousTickets: Natural with {
      briefly "Tickets"
      described as {
        |Previous ticket count.
      }
    }
    accountStatus: String(1,50) with {
      briefly "Status"
      described as {
        |Account status.
      }
    }
    customerSince: Date with {
      briefly "Since"
      described as {
        |Customer since.
      }
    }
    ltv: Decimal(12,2)? with {
      briefly "LTV"
      described as {
        |Lifetime value.
      }
    }
  } with {
    briefly "Customer history retrieved"
    described as {
      |Emitted when history available.
    }
  }
} with {
  briefly "External CRM"
  described as {
    |Customer relationship management.
  }
}
