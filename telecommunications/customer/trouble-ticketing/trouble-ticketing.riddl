// Trouble Ticketing Domain Model
// Customer service issue tracking and resolution
domain TroubleTicketing is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Customer is "person reporting service issues" with {
    briefly "Customer"
    described as {
      |Subscriber experiencing problems.
    }
  }
  user SupportAgent is "person handling customer issues" with {
    briefly "Support Agent"
    described as {
      |Front-line support staff.
    }
  }
  user FieldTechnician is "person performing on-site repairs" with {
    briefly "Field Technician"
    described as {
      |Dispatched for field work.
    }
  }
  epic IssueResolution is {
    user Customer wants to "to report and track service issues" so that "problems are resolved quickly"
    case ReportIssue is {
      user Customer wants to "to report a service problem" so that "it can be diagnosed and fixed"
      step is "Customer describes" "the issue" "and symptoms" with {
        briefly "Describe issue"
        described as {
          |Report problem.
        }
      }
      step is "System creates" "trouble ticket" "with priority" with {
        briefly "Create ticket"
        described as {
          |Log issue.
        }
      }
    } with {
      briefly "Report service issue"
      described as {
        |Issue reporting workflow.
      }
    }
  } with {
    briefly "Issue resolution"
    described as {
      |Epic for trouble ticketing.
    }
  }
  include "TicketContext.riddl"
  include "external-contexts.riddl"
  application context TroubleTicketingApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in TroubleTicketing are delivered.
      }
    }
    outlet AppTroubleTicketCommands is type TicketContext.TroubleTicket.TroubleTicketCommand
    inlet AppTicketRepositoryResponses is type TicketContext.TroubleTicket.TroubleTicketResult    handler TroubleTicketingAppHandler is {
      on other is {
        error "Unexpected message for application context TroubleTicketingApp"
      }
    } with {
      briefly "TroubleTicketingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "TroubleTicketingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'TroubleTicketCommand Stream' is from outlet TroubleTicketingApp.AppTroubleTicketCommands to inlet TicketContext.TroubleTicketCommandStreamIn with {
    briefly "TroubleTicket commands from the application"
  }
  persistent connector 'TicketResult Stream' is from outlet TicketContext.TicketResultStreamOut to inlet TroubleTicketingApp.AppTicketRepositoryResponses with {
    briefly "Ticket query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet TroubleTicketingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Trouble ticketing domain"
  described as {
    |Customer issue tracking and resolution.
  }
}
