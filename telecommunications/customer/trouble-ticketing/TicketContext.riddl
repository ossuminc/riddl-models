// Trouble Ticketing - Ticket Context
context TicketContext as router is {
  inlet TroubleTicketCommandStreamIn is type TroubleTicketCommand  outlet TroubleTicketCommandStreamOut is type TroubleTicketCommand
  inlet TicketResultStreamIn is result TroubleTicket.TroubleTicketResult  outlet TicketResultStreamOut is result TroubleTicket.TroubleTicketResult
  handler TicketContextBoundary is {
    on createTicket: command TroubleTicket.CreateTicket is {
      send createTicket to outlet TicketContext.TroubleTicketCommandStreamOut
    }
    on assignTicket: command TroubleTicket.AssignTicket is {
      send assignTicket to outlet TicketContext.TroubleTicketCommandStreamOut
    }
    on addDiagnostic: command TroubleTicket.AddDiagnostic is {
      send addDiagnostic to outlet TicketContext.TroubleTicketCommandStreamOut
    }
    on addWorkNote: command TroubleTicket.AddWorkNote is {
      send addWorkNote to outlet TicketContext.TroubleTicketCommandStreamOut
    }
    on dispatchTechnician: command TroubleTicket.DispatchTechnician is {
      send dispatchTechnician to outlet TicketContext.TroubleTicketCommandStreamOut
    }
    on updateDispatchStatus: command TroubleTicket.UpdateDispatchStatus is {
      send updateDispatchStatus to outlet TicketContext.TroubleTicketCommandStreamOut
    }
    on escalateTicket: command TroubleTicket.EscalateTicket is {
      send escalateTicket to outlet TicketContext.TroubleTicketCommandStreamOut
    }
    on updatePriority: command TroubleTicket.UpdatePriority is {
      send updatePriority to outlet TicketContext.TroubleTicketCommandStreamOut
    }
    on pendTicket: command TroubleTicket.PendTicket is {
      send pendTicket to outlet TicketContext.TroubleTicketCommandStreamOut
    }
    on resolveTicket: command TroubleTicket.ResolveTicket is {
      send resolveTicket to outlet TicketContext.TroubleTicketCommandStreamOut
    }
    on closeTicket: command TroubleTicket.CloseTicket is {
      send closeTicket to outlet TicketContext.TroubleTicketCommandStreamOut
    }
    on reopenTicket: command TroubleTicket.ReopenTicket is {
      send reopenTicket to outlet TicketContext.TroubleTicketCommandStreamOut
    }
    on troubleTicketResult: result TroubleTicket.TroubleTicketResult is {
      send troubleTicketResult to outlet TicketContext.TicketResultStreamOut
    }
    on other is {
      error "Unexpected message at the TicketContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TroubleTicketCommand Stream Intake' is from outlet TicketContext.TroubleTicketCommandStreamOut to inlet TicketContext.TroubleTicket.TroubleTicketCommands  connector 'TicketResult Stream Egress' is from outlet TicketContext.TicketRepository.TicketRepositoryResponses to inlet TicketContext.TicketResultStreamIn  adaptor FromCRM from context CRM is { 
    handler FromCRMHandler is {
      on event CRM.CustomerHistoryRetrieved is {
        do "the model receives customer history retrieved"
      }
      on other is {
        error "Unexpected message for adaptor FromCRM"
      }
    } with {
      briefly "from crm"
      described as {
        |Carries messages from the external CRM.
      }
    }
  } with {
    briefly "CRM integration"
    described as {
      |The model's side of the CRM conversation.
    }
  }
  adaptor ToCRM to context CRM is { 
    handler ToCRMHandler is {
      on command CRM.GetCustomerHistory is {
        do "the model sends get customer history"
      }
      on other is {
        error "Unexpected message for adaptor ToCRM"
      }
    } with {
      briefly "to crm"
      described as {
        |Carries messages to the external CRM.
      }
    }
  } with {
    briefly "CRM integration"
    described as {
      |The model's side of the CRM conversation.
    }
  }
  adaptor FromCustomerNotification from context CustomerNotification is { 
    handler FromCustomerNotificationHandler is {
      on event CustomerNotification.UpdateSent is {
        do "the model receives update sent"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerNotification"
      }
    } with {
      briefly "from customer notification"
      described as {
        |Carries messages from the external CustomerNotification.
      }
    }
  } with {
    briefly "CustomerNotification integration"
    described as {
      |The model's side of the CustomerNotification conversation.
    }
  }
  adaptor ToCustomerNotification to context CustomerNotification is { 
    handler ToCustomerNotificationHandler is {
      on command CustomerNotification.SendTicketUpdate is {
        do "the model sends send ticket update"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerNotification"
      }
    } with {
      briefly "to customer notification"
      described as {
        |Carries messages to the external CustomerNotification.
      }
    }
  } with {
    briefly "CustomerNotification integration"
    described as {
      |The model's side of the CustomerNotification conversation.
    }
  }
  adaptor FromDispatchSystem from context DispatchSystem is { 
    handler FromDispatchSystemHandler is {
      on event DispatchSystem.DispatchCompleted is {
        do "the model receives dispatch completed"
      }
      on event DispatchSystem.DispatchScheduled is {
        do "the model receives dispatch scheduled"
      }
      on event DispatchSystem.TechnicianArrived is {
        do "the model receives technician arrived"
      }
      on other is {
        error "Unexpected message for adaptor FromDispatchSystem"
      }
    } with {
      briefly "from dispatch system"
      described as {
        |Carries messages from the external DispatchSystem.
      }
    }
  } with {
    briefly "DispatchSystem integration"
    described as {
      |The model's side of the DispatchSystem conversation.
    }
  }
  adaptor ToDispatchSystem to context DispatchSystem is { 
    handler ToDispatchSystemHandler is {
      on command DispatchSystem.ScheduleDispatch is {
        do "the model sends schedule dispatch"
      }
      on other is {
        error "Unexpected message for adaptor ToDispatchSystem"
      }
    } with {
      briefly "to dispatch system"
      described as {
        |Carries messages to the external DispatchSystem.
      }
    }
  } with {
    briefly "DispatchSystem integration"
    described as {
      |The model's side of the DispatchSystem conversation.
    }
  }
  adaptor FromKnowledgeBase from context KnowledgeBase is { 
    handler FromKnowledgeBaseHandler is {
      on event KnowledgeBase.SolutionsFound is {
        do "the model receives solutions found"
      }
      on other is {
        error "Unexpected message for adaptor FromKnowledgeBase"
      }
    } with {
      briefly "from knowledge base"
      described as {
        |Carries messages from the external KnowledgeBase.
      }
    }
  } with {
    briefly "KnowledgeBase integration"
    described as {
      |The model's side of the KnowledgeBase conversation.
    }
  }
  adaptor ToKnowledgeBase to context KnowledgeBase is { 
    handler ToKnowledgeBaseHandler is {
      on command KnowledgeBase.SearchSolutions is {
        do "the model sends search solutions"
      }
      on other is {
        error "Unexpected message for adaptor ToKnowledgeBase"
      }
    } with {
      briefly "to knowledge base"
      described as {
        |Carries messages to the external KnowledgeBase.
      }
    }
  } with {
    briefly "KnowledgeBase integration"
    described as {
      |The model's side of the KnowledgeBase conversation.
    }
  }
  adaptor FromNetworkDiagnostics from context NetworkDiagnostics is { 
    handler FromNetworkDiagnosticsHandler is {
      on event NetworkDiagnostics.DiagnosticsComplete is {
        do "the model receives diagnostics complete"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkDiagnostics"
      }
    } with {
      briefly "from network diagnostics"
      described as {
        |Carries messages from the external NetworkDiagnostics.
      }
    }
  } with {
    briefly "NetworkDiagnostics integration"
    described as {
      |The model's side of the NetworkDiagnostics conversation.
    }
  }
  adaptor ToNetworkDiagnostics to context NetworkDiagnostics is { 
    handler ToNetworkDiagnosticsHandler is {
      on command NetworkDiagnostics.RunDiagnostics is {
        do "the model sends run diagnostics"
      }
      on other is {
        error "Unexpected message for adaptor ToNetworkDiagnostics"
      }
    } with {
      briefly "to network diagnostics"
      described as {
        |Carries messages to the external NetworkDiagnostics.
      }
    }
  } with {
    briefly "NetworkDiagnostics integration"
    described as {
      |The model's side of the NetworkDiagnostics conversation.
    }
  }
  include "types.riddl"
  include "TroubleTicket.riddl"
  type TicketRepositoryCommand is one of {
    TicketContext.TicketRepository.PersistDiagnosticAdded or TicketContext.TicketRepository.PersistDispatchStatusUpdated or TicketContext.TicketRepository.PersistPriorityUpdated or TicketContext.TicketRepository.PersistTechnicianDispatched or TicketContext.TicketRepository.PersistTicketAssigned or TicketContext.TicketRepository.PersistTicketClosed or TicketContext.TicketRepository.PersistTicketCreated or TicketContext.TicketRepository.PersistTicketEscalated or TicketContext.TicketRepository.PersistTicketPended or TicketContext.TicketRepository.PersistTicketReopened or TicketContext.TicketRepository.PersistTicketResolved or TicketContext.TicketRepository.PersistWorkNoteAdded
  } with {
    briefly "Anything that writes TicketRepository"
    described as {
      |The persistence commands TicketRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository TicketRepository as flow is {
    inlet TicketRepositoryFromTicketAnalytics is type TicketRepositoryCommand    command PersistDiagnosticAdded is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row DiagnosticAdded applies to.
        }
      }
    } with {
      briefly "Persist DiagnosticAdded"
      described as {
        |Instructs this repository to apply DiagnosticAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDispatchStatusUpdated is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row DispatchStatusUpdated applies to.
        }
      }
    } with {
      briefly "Persist DispatchStatusUpdated"
      described as {
        |Instructs this repository to apply DispatchStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPriorityUpdated is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row PriorityUpdated applies to.
        }
      }
    } with {
      briefly "Persist PriorityUpdated"
      described as {
        |Instructs this repository to apply PriorityUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTechnicianDispatched is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TechnicianDispatched applies to.
        }
      }
    } with {
      briefly "Persist TechnicianDispatched"
      described as {
        |Instructs this repository to apply TechnicianDispatched to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketAssigned is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketAssigned applies to.
        }
      }
    } with {
      briefly "Persist TicketAssigned"
      described as {
        |Instructs this repository to apply TicketAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketPended is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketPended applies to.
        }
      }
    } with {
      briefly "Persist TicketPended"
      described as {
        |Instructs this repository to apply TicketPended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketReopened is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketReopened applies to.
        }
      }
    } with {
      briefly "Persist TicketReopened"
      described as {
        |Instructs this repository to apply TicketReopened to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkNoteAdded is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkNoteAdded applies to.
        }
      }
    } with {
      briefly "Persist WorkNoteAdded"
      described as {
        |Instructs this repository to apply WorkNoteAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketClosed is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketClosed applies to.
        }
      }
    } with {
      briefly "Persist TicketClosed"
      described as {
        |Instructs this repository to apply TicketClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketCreated is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketCreated applies to.
        }
      }
    } with {
      briefly "Persist TicketCreated"
      described as {
        |Instructs this repository to apply TicketCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketEscalated is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketEscalated applies to.
        }
      }
    } with {
      briefly "Persist TicketEscalated"
      described as {
        |Instructs this repository to apply TicketEscalated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketResolved is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketResolved applies to.
        }
      }
    } with {
      briefly "Persist TicketResolved"
      described as {
        |Instructs this repository to apply TicketResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet TicketRepositoryResponses is result TroubleTicket.TroubleTicketResult
    record StoredTroubleTicket is {
      troubleTicketId: UUID with {
        briefly "troubleTicketId"
        described as {
          |The troubleTicketId column of the stored troubleTicket row.
        }
      }
      assignedTo: String(1,100) with {
        briefly "assignedTo"
        described as {
          |The assignedTo column of the stored troubleTicket row.
        }
      }
      customer: CustomerInfo with {
        briefly "customer"
        described as {
          |The customer column of the stored troubleTicket row.
        }
      }
      priority: TicketPriority with {
        briefly "priority"
        described as {
          |The priority column of the stored troubleTicket row.
        }
      }
      status: TicketStatus with {
        briefly "status"
        described as {
          |The status column of the stored troubleTicket row.
        }
      }
    } with {
      briefly "Stored troubleTicket row"
      described as {
        |The persistence shape of troubleTicket data as this repository stores it.
      }
    }
    schema TicketData is relational
      of tickets as record StoredTroubleTicket
        index on field StoredTroubleTicket.customer.accountNumber
        index on field StoredTroubleTicket.status
        index on field StoredTroubleTicket.priority
        index on field StoredTroubleTicket.assignedTo
 with {
      briefly "Ticket data schema"
      described as {
        |The relational schema holding ticket data for the TicketRepository.
      }
    }
    handler TicketPersistence is {
      on persistDiagnosticAdded: command PersistDiagnosticAdded is {
        do "apply DiagnosticAdded to the stored row"
      }
      on persistDispatchStatusUpdated: command PersistDispatchStatusUpdated is {
        do "apply DispatchStatusUpdated to the stored row"
      }
      on persistPriorityUpdated: command PersistPriorityUpdated is {
        do "apply PriorityUpdated to the stored row"
      }
      on persistTechnicianDispatched: command PersistTechnicianDispatched is {
        do "apply TechnicianDispatched to the stored row"
      }
      on persistTicketAssigned: command PersistTicketAssigned is {
        do "apply TicketAssigned to the stored row"
      }
      on persistTicketPended: command PersistTicketPended is {
        do "apply TicketPended to the stored row"
      }
      on persistTicketReopened: command PersistTicketReopened is {
        do "apply TicketReopened to the stored row"
      }
      on persistWorkNoteAdded: command PersistWorkNoteAdded is {
        do "apply WorkNoteAdded to the stored row"
      }
      on persistTicketClosed: command PersistTicketClosed is {
        do "apply TicketClosed to the stored row"
      }
      on persistTicketCreated: command PersistTicketCreated is {
        do "apply TicketCreated to the stored row"
      }
      on persistTicketEscalated: command PersistTicketEscalated is {
        do "apply TicketEscalated to the stored row"
      }
      on persistTicketResolved: command PersistTicketResolved is {
        do "apply TicketResolved to the stored row"
      }
      on query GetSupportMetrics is {
        let supportMetricsView: type SupportMetricsView = prompt("read the support metrics projection")
        reply supportMetricsView
      }
    } with {
      briefly "Persists ticket commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Ticket data persistence"
    described as {
      |Persistent storage for tickets.
    }
  }
  query GetSupportMetrics replies result SupportMetricsView is {
    supportMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which support metrics to retrieve.
      }
    }
  } with {
    briefly "Get support metrics"
    described as {
      |Retrieves the support metrics projection.
    }
  }
  result SupportMetricsView is {
    supportMetrics: TicketAnalytics.SupportMetrics with {
      briefly "Support metrics"
      described as {
        |The support metrics being returned.
      }
    }
  } with {
    briefly "Support metrics view"
    described as {
      |Read model view carrying the support metrics projection.
    }
  }
  projector TicketAnalytics as flow is {
    updates repository TicketContext.TicketRepository
    outlet TicketAnalyticsToRepository is type TicketRepositoryCommand
    inlet TicketAnalyticsFromTroubleTicket is type TroubleTicketEvent    record SupportMetrics is {
      openTickets: Natural with {
        briefly "Open"
        described as {
          |Open tickets.
        }
      }
      resolvedToday: Natural with {
        briefly "Resolved"
        described as {
          |Resolved today.
        }
      }
      avgResolutionTime: Decimal(8,2) with {
        briefly "Avg time"
        described as {
          |Avg resolution hours.
        }
      }
      slaCompliance: Decimal(5,2) with {
        briefly "SLA"
        described as {
          |SLA compliance %.
        }
      }
      escalationRate: Decimal(5,2) with {
        briefly "Escalations"
        described as {
          |Escalation rate.
        }
      }
      avgCSAT: Decimal(3,2) with {
        briefly "CSAT"
        described as {
          |Avg satisfaction.
        }
      }
    } with {
      briefly "Support metrics"
      described as {
        |Customer support metrics.
      }
    }
    handler AnalyticsHandler is {
      on diagnosticAdded: event TroubleTicket.DiagnosticAdded is {
        tell command TicketContext.TicketRepository.PersistDiagnosticAdded(ticketId = diagnosticAdded.ticketId) to repository TicketContext.TicketRepository
        do "apply DiagnosticAdded to the TicketAnalytics projection"
      }
      on dispatchStatusUpdated: event TroubleTicket.DispatchStatusUpdated is {
        tell command TicketContext.TicketRepository.PersistDispatchStatusUpdated(ticketId = dispatchStatusUpdated.ticketId) to repository TicketContext.TicketRepository
        do "apply DispatchStatusUpdated to the TicketAnalytics projection"
      }
      on priorityUpdated: event TroubleTicket.PriorityUpdated is {
        tell command TicketContext.TicketRepository.PersistPriorityUpdated(ticketId = priorityUpdated.ticketId) to repository TicketContext.TicketRepository
        do "apply PriorityUpdated to the TicketAnalytics projection"
      }
      on technicianDispatched: event TroubleTicket.TechnicianDispatched is {
        tell command TicketContext.TicketRepository.PersistTechnicianDispatched(ticketId = technicianDispatched.ticketId) to repository TicketContext.TicketRepository
        do "apply TechnicianDispatched to the TicketAnalytics projection"
      }
      on ticketAssigned: event TroubleTicket.TicketAssigned is {
        tell command TicketContext.TicketRepository.PersistTicketAssigned(ticketId = ticketAssigned.ticketId) to repository TicketContext.TicketRepository
        do "apply TicketAssigned to the TicketAnalytics projection"
      }
      on ticketPended: event TroubleTicket.TicketPended is {
        tell command TicketContext.TicketRepository.PersistTicketPended(ticketId = ticketPended.ticketId) to repository TicketContext.TicketRepository
        do "apply TicketPended to the TicketAnalytics projection"
      }
      on ticketReopened: event TroubleTicket.TicketReopened is {
        tell command TicketContext.TicketRepository.PersistTicketReopened(ticketId = ticketReopened.ticketId) to repository TicketContext.TicketRepository
        do "apply TicketReopened to the TicketAnalytics projection"
      }
      on workNoteAdded: event TroubleTicket.WorkNoteAdded is {
        tell command TicketContext.TicketRepository.PersistWorkNoteAdded(ticketId = workNoteAdded.ticketId) to repository TicketContext.TicketRepository
        do "apply WorkNoteAdded to the TicketAnalytics projection"
      }
      on ticketCreated: event TroubleTicket.TicketCreated is {
        tell command TicketContext.TicketRepository.PersistTicketCreated(ticketId = ticketCreated.ticketId) to repository TicketContext.TicketRepository
        do "Increment open count"
      }
      on ticketResolved: event TroubleTicket.TicketResolved is {
        tell command TicketContext.TicketRepository.PersistTicketResolved(ticketId = ticketResolved.ticketId) to repository TicketContext.TicketRepository
        do "Track resolution time"
      }
      on ticketEscalated: event TroubleTicket.TicketEscalated is {
        tell command TicketContext.TicketRepository.PersistTicketEscalated(ticketId = ticketEscalated.ticketId) to repository TicketContext.TicketRepository
        do "Track escalation"
      }
      on ticketClosed: event TroubleTicket.TicketClosed is {
        tell command TicketContext.TicketRepository.PersistTicketClosed(ticketId = ticketClosed.ticketId) to repository TicketContext.TicketRepository
        do "Update satisfaction metrics"
      }
    } with {
      briefly "Maintains support analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Ticket analytics"
    described as {
      |Support performance tracking.
    }
  }
  // ---- Event publication for TroubleTicket ----
  type TroubleTicketEvent is one of {
    TicketContext.TroubleTicket.TicketCreated or TicketContext.TroubleTicket.TicketAssigned or TicketContext.TroubleTicket.DiagnosticAdded or TicketContext.TroubleTicket.WorkNoteAdded or TicketContext.TroubleTicket.TechnicianDispatched or TicketContext.TroubleTicket.DispatchStatusUpdated or TicketContext.TroubleTicket.TicketEscalated or TicketContext.TroubleTicket.PriorityUpdated or TicketContext.TroubleTicket.TicketPended or TicketContext.TroubleTicket.TicketResolved or TicketContext.TroubleTicket.TicketClosed or TicketContext.TroubleTicket.TicketReopened
  } with {
    briefly "TroubleTicket event alternation"
    described as {
      |Union of all TroubleTicket events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet TroubleTicketEventSplit as flow is {
    inlet TroubleTicketEventSplitIn is type TroubleTicketEvent    outlet TroubleTicketEventSplitToTicketAnalytics is type TroubleTicketEvent
    handler TroubleTicketEventSplitHandler is {
      on ticketCreated: event TroubleTicket.TicketCreated is {
        send ticketCreated to outlet TroubleTicketEventSplitToTicketAnalytics
        tell ticketCreated to entity TicketContext.TroubleTicket
      }
      on ticketAssigned: event TroubleTicket.TicketAssigned is {
        send ticketAssigned to outlet TroubleTicketEventSplitToTicketAnalytics
        tell ticketAssigned to entity TicketContext.TroubleTicket
      }
      on diagnosticAdded: event TroubleTicket.DiagnosticAdded is {
        send diagnosticAdded to outlet TroubleTicketEventSplitToTicketAnalytics
        tell diagnosticAdded to entity TicketContext.TroubleTicket
      }
      on workNoteAdded: event TroubleTicket.WorkNoteAdded is {
        send workNoteAdded to outlet TroubleTicketEventSplitToTicketAnalytics
        tell workNoteAdded to entity TicketContext.TroubleTicket
      }
      on technicianDispatched: event TroubleTicket.TechnicianDispatched is {
        send technicianDispatched to outlet TroubleTicketEventSplitToTicketAnalytics
        tell technicianDispatched to entity TicketContext.TroubleTicket
      }
      on dispatchStatusUpdated: event TroubleTicket.DispatchStatusUpdated is {
        send dispatchStatusUpdated to outlet TroubleTicketEventSplitToTicketAnalytics
        tell dispatchStatusUpdated to entity TicketContext.TroubleTicket
      }
      on ticketEscalated: event TroubleTicket.TicketEscalated is {
        send ticketEscalated to outlet TroubleTicketEventSplitToTicketAnalytics
        tell ticketEscalated to entity TicketContext.TroubleTicket
      }
      on priorityUpdated: event TroubleTicket.PriorityUpdated is {
        send priorityUpdated to outlet TroubleTicketEventSplitToTicketAnalytics
        tell priorityUpdated to entity TicketContext.TroubleTicket
      }
      on ticketPended: event TroubleTicket.TicketPended is {
        send ticketPended to outlet TroubleTicketEventSplitToTicketAnalytics
        tell ticketPended to entity TicketContext.TroubleTicket
      }
      on ticketResolved: event TroubleTicket.TicketResolved is {
        send ticketResolved to outlet TroubleTicketEventSplitToTicketAnalytics
        tell ticketResolved to entity TicketContext.TroubleTicket
      }
      on ticketClosed: event TroubleTicket.TicketClosed is {
        send ticketClosed to outlet TroubleTicketEventSplitToTicketAnalytics
        tell ticketClosed to entity TicketContext.TroubleTicket
      }
      on ticketReopened: event TroubleTicket.TicketReopened is {
        send ticketReopened to outlet TroubleTicketEventSplitToTicketAnalytics
        tell ticketReopened to entity TicketContext.TroubleTicket
      }
      on other is {
        error "Unexpected message for processor TroubleTicketEventSplit"
      }
    } with {
      briefly "TroubleTicket event fan-out handler"
      described as {
        |Delivers each TroubleTicket event to all of its consumers.
      }
    }
  } with {
    briefly "TroubleTicket event fan-out"
    described as {
      |Fans TroubleTicket events out to the repository and projectors.
    }
  }
  connector 'TroubleTicketEvent Stream' is from outlet TicketContext.TroubleTicket.TroubleTicketEvents2 to inlet TicketContext.TroubleTicketEventSplit.TroubleTicketEventSplitIn with {
    briefly "TroubleTicket events, fanned out to storage and read models"
  }
  connector 'TicketAnalytics Feed' is from outlet TicketContext.TroubleTicketEventSplit.TroubleTicketEventSplitToTicketAnalytics to inlet TicketContext.TicketAnalytics.TicketAnalyticsFromTroubleTicket with {
    briefly "TroubleTicket events feeding the TicketAnalytics projection"
  }
  connector 'TicketAnalytics Storage' is from outlet TicketContext.TicketAnalytics.TicketAnalyticsToRepository to inlet TicketContext.TicketRepository.TicketRepositoryFromTicketAnalytics with {
    briefly "TicketAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for trouble ticketing"
  described as {
    |Customer support context.
  }
}
