// Trouble Ticketing - Ticket Context
context TicketContext is {
  include "types.riddl"
  include "TroubleTicket.riddl"
  repository TicketRepository is {
    schema TicketData is relational
      of tickets as type TroubleTicket
        index on field TroubleTicket.customer.accountNumber
        index on field TroubleTicket.status
        index on field TroubleTicket.priority
        index on field TroubleTicket.assignedTo

    handler TicketPersistence is {
      on command TroubleTicket.CreateTicket is {
        tell event TroubleTicket.TicketCreated to entity TicketContext.TroubleTicket
        prompt "Store new ticket record"
      }
      on command TroubleTicket.AssignTicket is {
        tell event TroubleTicket.TicketAssigned to entity TicketContext.TroubleTicket
        prompt "Update ticket assignment"
      }
      on command TroubleTicket.AddDiagnostic is {
        tell event TroubleTicket.DiagnosticAdded to entity TicketContext.TroubleTicket
        prompt "Store diagnostic result"
      }
      on command TroubleTicket.AddWorkNote is {
        tell event TroubleTicket.WorkNoteAdded to entity TicketContext.TroubleTicket
        prompt "Store work note"
      }
      on command TroubleTicket.DispatchTechnician is {
        prompt "Store dispatch info"
      }
      on command TroubleTicket.EscalateTicket is {
        prompt "Update escalation status"
      }
      on command TroubleTicket.ResolveTicket is {
        prompt "Store resolution"
      }
      on command TroubleTicket.CloseTicket is {
        tell event TroubleTicket.TicketClosed to entity TicketContext.TroubleTicket
        prompt "Archive ticket"
      }
    } with {
      briefly "Persists ticket commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Ticket data persistence"
    described as {
      |Persistent storage for tickets.
    }
  }
  projector TicketAnalytics is {
    updates repository TicketContext.TicketRepository
    record SupportMetrics is  {
      openTickets: Natural with {
        briefly "Open"
        described as {
          |Open tickets.
        }
      }
      resolvedToday: Natural with {
        briefly "Resolved"
        described as {
          |Resolved today.
        }
      }
      avgResolutionTime: Decimal(8,2) with {
        briefly "Avg time"
        described as {
          |Avg resolution hours.
        }
      }
      slaCompliance: Decimal(5,2) with {
        briefly "SLA"
        described as {
          |SLA compliance %.
        }
      }
      escalationRate: Decimal(5,2) with {
        briefly "Escalations"
        described as {
          |Escalation rate.
        }
      }
      avgCSAT: Decimal(3,2) with {
        briefly "CSAT"
        described as {
          |Avg satisfaction.
        }
      }
    } with {
      briefly "Support metrics"
      described as {
        |Customer support metrics.
      }
    }
    handler AnalyticsHandler is {
      on event TroubleTicket.TicketCreated is {
        tell event TroubleTicket.TicketCreated to repository TicketContext.TicketRepository
        prompt "Increment open count"
      }
      on event TroubleTicket.TicketResolved is {
        tell event TroubleTicket.TicketResolved to repository TicketContext.TicketRepository
        prompt "Track resolution time"
      }
      on event TroubleTicket.TicketEscalated is {
        tell event TroubleTicket.TicketEscalated to repository TicketContext.TicketRepository
        prompt "Track escalation"
      }
      on event TroubleTicket.TicketClosed is {
        tell event TroubleTicket.TicketClosed to repository TicketContext.TicketRepository
        prompt "Update satisfaction metrics"
      }
    } with {
      briefly "Maintains support analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Ticket analytics"
    described as {
      |Support performance tracking.
    }
  }
  // ---- Event publication for TroubleTicket ----
  type TroubleTicketEvent is one of {
    TicketContext.TroubleTicket.TicketCreated,
    TicketContext.TroubleTicket.TicketAssigned,
    TicketContext.TroubleTicket.DiagnosticAdded,
    TicketContext.TroubleTicket.WorkNoteAdded,
    TicketContext.TroubleTicket.TechnicianDispatched,
    TicketContext.TroubleTicket.DispatchStatusUpdated,
    TicketContext.TroubleTicket.TicketEscalated,
    TicketContext.TroubleTicket.PriorityUpdated,
    TicketContext.TroubleTicket.TicketPended,
    TicketContext.TroubleTicket.TicketResolved,
    TicketContext.TroubleTicket.TicketClosed,
    TicketContext.TroubleTicket.TicketReopened
  } with {
    briefly "TroubleTicket event alternation"
    described as {
      |Union of all TroubleTicket events, for streaming and event-sourced
      |persistence.
    }
  }
  source TroubleTicketEventSource is {
    outlet TroubleTicketEvents is type TroubleTicketEvent
    handler TroubleTicketSourceHandler is {
      on event TroubleTicket.TicketCreated is {
        send event TroubleTicket.TicketCreated to outlet TroubleTicketEvents
      }
      on event TroubleTicket.TicketAssigned is {
        send event TroubleTicket.TicketAssigned to outlet TroubleTicketEvents
      }
      on event TroubleTicket.DiagnosticAdded is {
        send event TroubleTicket.DiagnosticAdded to outlet TroubleTicketEvents
      }
      on event TroubleTicket.WorkNoteAdded is {
        send event TroubleTicket.WorkNoteAdded to outlet TroubleTicketEvents
      }
      on event TroubleTicket.TechnicianDispatched is {
        send event TroubleTicket.TechnicianDispatched to outlet TroubleTicketEvents
      }
      on event TroubleTicket.DispatchStatusUpdated is {
        send event TroubleTicket.DispatchStatusUpdated to outlet TroubleTicketEvents
      }
      on event TroubleTicket.TicketEscalated is {
        send event TroubleTicket.TicketEscalated to outlet TroubleTicketEvents
      }
      on event TroubleTicket.PriorityUpdated is {
        send event TroubleTicket.PriorityUpdated to outlet TroubleTicketEvents
      }
      on event TroubleTicket.TicketPended is {
        send event TroubleTicket.TicketPended to outlet TroubleTicketEvents
      }
      on event TroubleTicket.TicketResolved is {
        send event TroubleTicket.TicketResolved to outlet TroubleTicketEvents
      }
      on event TroubleTicket.TicketClosed is {
        send event TroubleTicket.TicketClosed to outlet TroubleTicketEvents
      }
      on event TroubleTicket.TicketReopened is {
        send event TroubleTicket.TicketReopened to outlet TroubleTicketEvents
      }
      on other is {
        error "Unexpected message for source TroubleTicketEventSource"
      }
    } with {
      briefly "TroubleTicket source handler"
      described as {
        |Publishes TroubleTicket events onto the outlet.
      }
    }
  } with {
    briefly "TroubleTicket event source"
    described as {
      |Publishes TroubleTicket entity events into the streaming topology.
    }
  }
  sink TroubleTicketEventSink is {
    inlet TroubleTicketInlet is type TroubleTicketEvent
    handler TroubleTicketSinkHandler is {
      on event TroubleTicket.TicketCreated is {
        tell event TroubleTicket.TicketCreated to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.TicketAssigned is {
        tell event TroubleTicket.TicketAssigned to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.DiagnosticAdded is {
        tell event TroubleTicket.DiagnosticAdded to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.WorkNoteAdded is {
        tell event TroubleTicket.WorkNoteAdded to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.TechnicianDispatched is {
        tell event TroubleTicket.TechnicianDispatched to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.DispatchStatusUpdated is {
        tell event TroubleTicket.DispatchStatusUpdated to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.TicketEscalated is {
        tell event TroubleTicket.TicketEscalated to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.PriorityUpdated is {
        tell event TroubleTicket.PriorityUpdated to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.TicketPended is {
        tell event TroubleTicket.TicketPended to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.TicketResolved is {
        tell event TroubleTicket.TicketResolved to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.TicketClosed is {
        tell event TroubleTicket.TicketClosed to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.TicketReopened is {
        tell event TroubleTicket.TicketReopened to repository TicketContext.TicketRepository
      }
      on other is {
        error "Unexpected message for sink TroubleTicketEventSink"
      }
    } with {
      briefly "TroubleTicket sink handler"
      described as {
        |Persists TroubleTicket events via the repository.
      }
    }
  } with {
    briefly "TroubleTicket event sink"
    described as {
      |Receives TroubleTicket events for persistence.
    }
  }
  connector TroubleTicketEventFlow is {
    from outlet TicketContext.TroubleTicketEventSource.TroubleTicketEvents to
      inlet TicketContext.TroubleTicketEventSink.TroubleTicketInlet
  } with {
    briefly "TroubleTicket event flow"
    described as {
      |Connects the TroubleTicket source to its sink.
    }
  }
} with {
  briefly "Bounded context for trouble ticketing"
  described as {
    |Customer support context.
  }
}
