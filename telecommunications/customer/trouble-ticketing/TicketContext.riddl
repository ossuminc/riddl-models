// Trouble Ticketing - Ticket Context
context TicketContext is {
  adaptor FromCRM from context CRM is { 
    handler FromCRMHandler is {
      on event CRM.CustomerHistoryRetrieved is {
        do "the model receives customer history retrieved"
      }
      on other is {
        error "Unexpected message for adaptor FromCRM"
      }
    } with {
      briefly "from crm"
      described as {
        |Carries messages from the external CRM.
      }
    }
  } with {
    briefly "CRM integration"
    described as {
      |The model's side of the CRM conversation.
    }
  }
  adaptor ToCRM to context CRM is { 
    handler ToCRMHandler is {
      on command CRM.GetCustomerHistory is {
        do "the model sends get customer history"
      }
      on other is {
        error "Unexpected message for adaptor ToCRM"
      }
    } with {
      briefly "to crm"
      described as {
        |Carries messages to the external CRM.
      }
    }
  } with {
    briefly "CRM integration"
    described as {
      |The model's side of the CRM conversation.
    }
  }
  adaptor FromCustomerNotification from context CustomerNotification is { 
    handler FromCustomerNotificationHandler is {
      on event CustomerNotification.UpdateSent is {
        do "the model receives update sent"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerNotification"
      }
    } with {
      briefly "from customer notification"
      described as {
        |Carries messages from the external CustomerNotification.
      }
    }
  } with {
    briefly "CustomerNotification integration"
    described as {
      |The model's side of the CustomerNotification conversation.
    }
  }
  adaptor ToCustomerNotification to context CustomerNotification is { 
    handler ToCustomerNotificationHandler is {
      on command CustomerNotification.SendTicketUpdate is {
        do "the model sends send ticket update"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerNotification"
      }
    } with {
      briefly "to customer notification"
      described as {
        |Carries messages to the external CustomerNotification.
      }
    }
  } with {
    briefly "CustomerNotification integration"
    described as {
      |The model's side of the CustomerNotification conversation.
    }
  }
  adaptor FromDispatchSystem from context DispatchSystem is { 
    handler FromDispatchSystemHandler is {
      on event DispatchSystem.DispatchCompleted is {
        do "the model receives dispatch completed"
      }
      on event DispatchSystem.DispatchScheduled is {
        do "the model receives dispatch scheduled"
      }
      on event DispatchSystem.TechnicianArrived is {
        do "the model receives technician arrived"
      }
      on other is {
        error "Unexpected message for adaptor FromDispatchSystem"
      }
    } with {
      briefly "from dispatch system"
      described as {
        |Carries messages from the external DispatchSystem.
      }
    }
  } with {
    briefly "DispatchSystem integration"
    described as {
      |The model's side of the DispatchSystem conversation.
    }
  }
  adaptor ToDispatchSystem to context DispatchSystem is { 
    handler ToDispatchSystemHandler is {
      on command DispatchSystem.ScheduleDispatch is {
        do "the model sends schedule dispatch"
      }
      on other is {
        error "Unexpected message for adaptor ToDispatchSystem"
      }
    } with {
      briefly "to dispatch system"
      described as {
        |Carries messages to the external DispatchSystem.
      }
    }
  } with {
    briefly "DispatchSystem integration"
    described as {
      |The model's side of the DispatchSystem conversation.
    }
  }
  adaptor FromKnowledgeBase from context KnowledgeBase is { 
    handler FromKnowledgeBaseHandler is {
      on event KnowledgeBase.SolutionsFound is {
        do "the model receives solutions found"
      }
      on other is {
        error "Unexpected message for adaptor FromKnowledgeBase"
      }
    } with {
      briefly "from knowledge base"
      described as {
        |Carries messages from the external KnowledgeBase.
      }
    }
  } with {
    briefly "KnowledgeBase integration"
    described as {
      |The model's side of the KnowledgeBase conversation.
    }
  }
  adaptor ToKnowledgeBase to context KnowledgeBase is { 
    handler ToKnowledgeBaseHandler is {
      on command KnowledgeBase.SearchSolutions is {
        do "the model sends search solutions"
      }
      on other is {
        error "Unexpected message for adaptor ToKnowledgeBase"
      }
    } with {
      briefly "to knowledge base"
      described as {
        |Carries messages to the external KnowledgeBase.
      }
    }
  } with {
    briefly "KnowledgeBase integration"
    described as {
      |The model's side of the KnowledgeBase conversation.
    }
  }
  adaptor FromNetworkDiagnostics from context NetworkDiagnostics is { 
    handler FromNetworkDiagnosticsHandler is {
      on event NetworkDiagnostics.DiagnosticsComplete is {
        do "the model receives diagnostics complete"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkDiagnostics"
      }
    } with {
      briefly "from network diagnostics"
      described as {
        |Carries messages from the external NetworkDiagnostics.
      }
    }
  } with {
    briefly "NetworkDiagnostics integration"
    described as {
      |The model's side of the NetworkDiagnostics conversation.
    }
  }
  adaptor ToNetworkDiagnostics to context NetworkDiagnostics is { 
    handler ToNetworkDiagnosticsHandler is {
      on command NetworkDiagnostics.RunDiagnostics is {
        do "the model sends run diagnostics"
      }
      on other is {
        error "Unexpected message for adaptor ToNetworkDiagnostics"
      }
    } with {
      briefly "to network diagnostics"
      described as {
        |Carries messages to the external NetworkDiagnostics.
      }
    }
  } with {
    briefly "NetworkDiagnostics integration"
    described as {
      |The model's side of the NetworkDiagnostics conversation.
    }
  }
  include "types.riddl"
  include "TroubleTicket.riddl"
  repository TicketRepository as merge is {
    inlet TicketRepositoryFromTroubleTicket is type TroubleTicketEvent    inlet TicketRepositoryFromTicketAnalytics is type TroubleTicketEvent    outlet TicketRepositoryResponses is type TroubleTicket.TroubleTicketResult
    record StoredTroubleTicket is  {
      troubleTicketId: UUID with {
        briefly "troubleTicketId"
        described as {
          |The troubleTicketId column of the stored troubleTicket row.
        }
      }
      assignedTo: String(1,100) with {
        briefly "assignedTo"
        described as {
          |The assignedTo column of the stored troubleTicket row.
        }
      }
      customer: CustomerInfo with {
        briefly "customer"
        described as {
          |The customer column of the stored troubleTicket row.
        }
      }
      priority: TicketPriority with {
        briefly "priority"
        described as {
          |The priority column of the stored troubleTicket row.
        }
      }
      status: TicketStatus with {
        briefly "status"
        described as {
          |The status column of the stored troubleTicket row.
        }
      }
    } with {
      briefly "Stored troubleTicket row"
      described as {
        |The persistence shape of troubleTicket data as this repository stores it.
      }
    }
    schema TicketData is relational
      of tickets as type StoredTroubleTicket
        index on field StoredTroubleTicket.customer.accountNumber
        index on field StoredTroubleTicket.status
        index on field StoredTroubleTicket.priority
        index on field StoredTroubleTicket.assignedTo
 with {
      briefly "Ticket data schema"
      described as {
        |The relational schema holding ticket data for the TicketRepository.
      }
    }
    handler TicketPersistence is {
      on query GetSupportMetrics is {
        do "read the support metrics projection"
        reply result SupportMetricsView
      }
      on command TroubleTicket.CreateTicket is {
        tell event TroubleTicket.TicketCreated to entity TicketContext.TroubleTicket
        do "Store new ticket record"
      }
      on command TroubleTicket.AssignTicket is {
        tell event TroubleTicket.TicketAssigned to entity TicketContext.TroubleTicket
        do "Update ticket assignment"
      }
      on command TroubleTicket.AddDiagnostic is {
        tell event TroubleTicket.DiagnosticAdded to entity TicketContext.TroubleTicket
        do "Store diagnostic result"
      }
      on command TroubleTicket.AddWorkNote is {
        tell event TroubleTicket.WorkNoteAdded to entity TicketContext.TroubleTicket
        do "Store work note"
      }
      on command TroubleTicket.DispatchTechnician is {
        do "Store dispatch info"
      }
      on command TroubleTicket.EscalateTicket is {
        do "Update escalation status"
      }
      on command TroubleTicket.ResolveTicket is {
        do "Store resolution"
      }
      on command TroubleTicket.CloseTicket is {
        tell event TroubleTicket.TicketClosed to entity TicketContext.TroubleTicket
        do "Archive ticket"
      }
    } with {
      briefly "Persists ticket commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Ticket data persistence"
    described as {
      |Persistent storage for tickets.
    }
  }
  query GetSupportMetrics is  {
    supportMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which support metrics to retrieve.
      }
    }
  } with {
    briefly "Get support metrics"
    described as {
      |Retrieves the support metrics projection.
    }
  }
  result SupportMetricsView is  {
    supportMetrics: TicketAnalytics.SupportMetrics with {
      briefly "Support metrics"
      described as {
        |The support metrics being returned.
      }
    }
  } with {
    briefly "Support metrics view"
    described as {
      |Read model view carrying the support metrics projection.
    }
  }
  projector TicketAnalytics as flow is {
    updates repository TicketContext.TicketRepository
    inlet TicketAnalyticsFromTroubleTicket is type TroubleTicketEvent    outlet TicketAnalyticsOut is type TroubleTicketEvent
    record SupportMetrics is  {
      openTickets: Natural with {
        briefly "Open"
        described as {
          |Open tickets.
        }
      }
      resolvedToday: Natural with {
        briefly "Resolved"
        described as {
          |Resolved today.
        }
      }
      avgResolutionTime: Decimal(8,2) with {
        briefly "Avg time"
        described as {
          |Avg resolution hours.
        }
      }
      slaCompliance: Decimal(5,2) with {
        briefly "SLA"
        described as {
          |SLA compliance %.
        }
      }
      escalationRate: Decimal(5,2) with {
        briefly "Escalations"
        described as {
          |Escalation rate.
        }
      }
      avgCSAT: Decimal(3,2) with {
        briefly "CSAT"
        described as {
          |Avg satisfaction.
        }
      }
    } with {
      briefly "Support metrics"
      described as {
        |Customer support metrics.
      }
    }
    handler AnalyticsHandler is {
      on event TroubleTicket.TicketCreated is {
        tell event TroubleTicket.TicketCreated to repository TicketContext.TicketRepository
        do "Increment open count"
      }
      on event TroubleTicket.TicketResolved is {
        tell event TroubleTicket.TicketResolved to repository TicketContext.TicketRepository
        do "Track resolution time"
      }
      on event TroubleTicket.TicketEscalated is {
        tell event TroubleTicket.TicketEscalated to repository TicketContext.TicketRepository
        do "Track escalation"
      }
      on event TroubleTicket.TicketClosed is {
        tell event TroubleTicket.TicketClosed to repository TicketContext.TicketRepository
        do "Update satisfaction metrics"
      }
    } with {
      briefly "Maintains support analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Ticket analytics"
    described as {
      |Support performance tracking.
    }
  }
  // ---- Event publication for TroubleTicket ----
  type TroubleTicketEvent is one of {
    TicketContext.TroubleTicket.TicketCreated or TicketContext.TroubleTicket.TicketAssigned or TicketContext.TroubleTicket.DiagnosticAdded or TicketContext.TroubleTicket.WorkNoteAdded or TicketContext.TroubleTicket.TechnicianDispatched or TicketContext.TroubleTicket.DispatchStatusUpdated or TicketContext.TroubleTicket.TicketEscalated or TicketContext.TroubleTicket.PriorityUpdated or TicketContext.TroubleTicket.TicketPended or TicketContext.TroubleTicket.TicketResolved or TicketContext.TroubleTicket.TicketClosed or TicketContext.TroubleTicket.TicketReopened
  } with {
    briefly "TroubleTicket event alternation"
    described as {
      |Union of all TroubleTicket events, for streaming and event-sourced
      |persistence.
    }
  }
  processor TroubleTicketEventSource as source is {
    outlet TroubleTicketEvents is type TroubleTicketEvent
    handler TroubleTicketSourceHandler is {
      on event TroubleTicket.TicketCreated is {
        send event TroubleTicket.TicketCreated to outlet TroubleTicketEvents
      }
      on event TroubleTicket.TicketAssigned is {
        send event TroubleTicket.TicketAssigned to outlet TroubleTicketEvents
      }
      on event TroubleTicket.DiagnosticAdded is {
        send event TroubleTicket.DiagnosticAdded to outlet TroubleTicketEvents
      }
      on event TroubleTicket.WorkNoteAdded is {
        send event TroubleTicket.WorkNoteAdded to outlet TroubleTicketEvents
      }
      on event TroubleTicket.TechnicianDispatched is {
        send event TroubleTicket.TechnicianDispatched to outlet TroubleTicketEvents
      }
      on event TroubleTicket.DispatchStatusUpdated is {
        send event TroubleTicket.DispatchStatusUpdated to outlet TroubleTicketEvents
      }
      on event TroubleTicket.TicketEscalated is {
        send event TroubleTicket.TicketEscalated to outlet TroubleTicketEvents
      }
      on event TroubleTicket.PriorityUpdated is {
        send event TroubleTicket.PriorityUpdated to outlet TroubleTicketEvents
      }
      on event TroubleTicket.TicketPended is {
        send event TroubleTicket.TicketPended to outlet TroubleTicketEvents
      }
      on event TroubleTicket.TicketResolved is {
        send event TroubleTicket.TicketResolved to outlet TroubleTicketEvents
      }
      on event TroubleTicket.TicketClosed is {
        send event TroubleTicket.TicketClosed to outlet TroubleTicketEvents
      }
      on event TroubleTicket.TicketReopened is {
        send event TroubleTicket.TicketReopened to outlet TroubleTicketEvents
      }
      on other is {
        error "Unexpected message for source TroubleTicketEventSource"
      }
    } with {
      briefly "TroubleTicket source handler"
      described as {
        |Publishes TroubleTicket events onto the outlet.
      }
    }
  } with {
    briefly "TroubleTicket event source"
    described as {
      |Publishes TroubleTicket entity events into the streaming topology.
    }
  }
  processor TroubleTicketEventSink as sink is {
    inlet TroubleTicketInlet is type TroubleTicketEvent    handler TroubleTicketSinkHandler is {
      on event TroubleTicket.TicketCreated is {
        tell event TroubleTicket.TicketCreated to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.TicketAssigned is {
        tell event TroubleTicket.TicketAssigned to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.DiagnosticAdded is {
        tell event TroubleTicket.DiagnosticAdded to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.WorkNoteAdded is {
        tell event TroubleTicket.WorkNoteAdded to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.TechnicianDispatched is {
        tell event TroubleTicket.TechnicianDispatched to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.DispatchStatusUpdated is {
        tell event TroubleTicket.DispatchStatusUpdated to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.TicketEscalated is {
        tell event TroubleTicket.TicketEscalated to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.PriorityUpdated is {
        tell event TroubleTicket.PriorityUpdated to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.TicketPended is {
        tell event TroubleTicket.TicketPended to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.TicketResolved is {
        tell event TroubleTicket.TicketResolved to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.TicketClosed is {
        tell event TroubleTicket.TicketClosed to repository TicketContext.TicketRepository
      }
      on event TroubleTicket.TicketReopened is {
        tell event TroubleTicket.TicketReopened to repository TicketContext.TicketRepository
      }
      on other is {
        error "Unexpected message for sink TroubleTicketEventSink"
      }
    } with {
      briefly "TroubleTicket sink handler"
      described as {
        |Persists TroubleTicket events via the repository.
      }
    }
  } with {
    briefly "TroubleTicket event sink"
    described as {
      |Receives TroubleTicket events for persistence.
    }
  }
  connector TroubleTicketEventFlow is from outlet TicketContext.TroubleTicketEventSource.TroubleTicketEvents to inlet TicketContext.TroubleTicketEventSink.TroubleTicketInlet with {
    briefly "TroubleTicket event flow"
    described as {
      |Connects the TroubleTicket source to its sink.
    }
  }
  processor TroubleTicketEventSplit as split is {
    inlet TroubleTicketEventSplitIn is type TroubleTicketEvent    outlet TroubleTicketEventSplitToTicketRepository is type TroubleTicketEvent
    outlet TroubleTicketEventSplitToTicketAnalytics is type TroubleTicketEvent
    handler TroubleTicketEventSplitHandler is {
      on event TroubleTicket.TicketCreated is {
        send event TroubleTicket.TicketCreated to outlet TroubleTicketEventSplitToTicketRepository
        send event TroubleTicket.TicketCreated to outlet TroubleTicketEventSplitToTicketAnalytics
        tell event TroubleTicket.TicketCreated to entity TicketContext.TroubleTicket
      }
      on event TroubleTicket.TicketAssigned is {
        send event TroubleTicket.TicketAssigned to outlet TroubleTicketEventSplitToTicketRepository
        send event TroubleTicket.TicketAssigned to outlet TroubleTicketEventSplitToTicketAnalytics
        tell event TroubleTicket.TicketAssigned to entity TicketContext.TroubleTicket
      }
      on event TroubleTicket.DiagnosticAdded is {
        send event TroubleTicket.DiagnosticAdded to outlet TroubleTicketEventSplitToTicketRepository
        send event TroubleTicket.DiagnosticAdded to outlet TroubleTicketEventSplitToTicketAnalytics
        tell event TroubleTicket.DiagnosticAdded to entity TicketContext.TroubleTicket
      }
      on event TroubleTicket.WorkNoteAdded is {
        send event TroubleTicket.WorkNoteAdded to outlet TroubleTicketEventSplitToTicketRepository
        send event TroubleTicket.WorkNoteAdded to outlet TroubleTicketEventSplitToTicketAnalytics
        tell event TroubleTicket.WorkNoteAdded to entity TicketContext.TroubleTicket
      }
      on event TroubleTicket.TechnicianDispatched is {
        send event TroubleTicket.TechnicianDispatched to outlet TroubleTicketEventSplitToTicketRepository
        send event TroubleTicket.TechnicianDispatched to outlet TroubleTicketEventSplitToTicketAnalytics
        tell event TroubleTicket.TechnicianDispatched to entity TicketContext.TroubleTicket
      }
      on event TroubleTicket.DispatchStatusUpdated is {
        send event TroubleTicket.DispatchStatusUpdated to outlet TroubleTicketEventSplitToTicketRepository
        send event TroubleTicket.DispatchStatusUpdated to outlet TroubleTicketEventSplitToTicketAnalytics
        tell event TroubleTicket.DispatchStatusUpdated to entity TicketContext.TroubleTicket
      }
      on event TroubleTicket.TicketEscalated is {
        send event TroubleTicket.TicketEscalated to outlet TroubleTicketEventSplitToTicketRepository
        send event TroubleTicket.TicketEscalated to outlet TroubleTicketEventSplitToTicketAnalytics
        tell event TroubleTicket.TicketEscalated to entity TicketContext.TroubleTicket
      }
      on event TroubleTicket.PriorityUpdated is {
        send event TroubleTicket.PriorityUpdated to outlet TroubleTicketEventSplitToTicketRepository
        send event TroubleTicket.PriorityUpdated to outlet TroubleTicketEventSplitToTicketAnalytics
        tell event TroubleTicket.PriorityUpdated to entity TicketContext.TroubleTicket
      }
      on event TroubleTicket.TicketPended is {
        send event TroubleTicket.TicketPended to outlet TroubleTicketEventSplitToTicketRepository
        send event TroubleTicket.TicketPended to outlet TroubleTicketEventSplitToTicketAnalytics
        tell event TroubleTicket.TicketPended to entity TicketContext.TroubleTicket
      }
      on event TroubleTicket.TicketResolved is {
        send event TroubleTicket.TicketResolved to outlet TroubleTicketEventSplitToTicketRepository
        send event TroubleTicket.TicketResolved to outlet TroubleTicketEventSplitToTicketAnalytics
        tell event TroubleTicket.TicketResolved to entity TicketContext.TroubleTicket
      }
      on event TroubleTicket.TicketClosed is {
        send event TroubleTicket.TicketClosed to outlet TroubleTicketEventSplitToTicketRepository
        send event TroubleTicket.TicketClosed to outlet TroubleTicketEventSplitToTicketAnalytics
        tell event TroubleTicket.TicketClosed to entity TicketContext.TroubleTicket
      }
      on event TroubleTicket.TicketReopened is {
        send event TroubleTicket.TicketReopened to outlet TroubleTicketEventSplitToTicketRepository
        send event TroubleTicket.TicketReopened to outlet TroubleTicketEventSplitToTicketAnalytics
        tell event TroubleTicket.TicketReopened to entity TicketContext.TroubleTicket
      }
      on other is {
        error "Unexpected message for processor TroubleTicketEventSplit"
      }
    } with {
      briefly "TroubleTicket event fan-out handler"
      described as {
        |Delivers each TroubleTicket event to all of its consumers.
      }
    }
  } with {
    briefly "TroubleTicket event fan-out"
    described as {
      |Fans TroubleTicket events out to the repository and projectors.
    }
  }
  connector 'TroubleTicketEvent Stream' is from outlet TicketContext.TroubleTicket.TroubleTicketEvents2 to inlet TicketContext.TroubleTicketEventSplit.TroubleTicketEventSplitIn with {
    briefly "TroubleTicket events, fanned out to storage and read models"
  }
  connector 'TroubleTicketEvent Storage' is from outlet TicketContext.TroubleTicketEventSplit.TroubleTicketEventSplitToTicketRepository to inlet TicketContext.TicketRepository.TicketRepositoryFromTroubleTicket with {
    briefly "TroubleTicket events on their way to storage"
  }
  connector 'TicketAnalytics Feed' is from outlet TicketContext.TroubleTicketEventSplit.TroubleTicketEventSplitToTicketAnalytics to inlet TicketContext.TicketAnalytics.TicketAnalyticsFromTroubleTicket with {
    briefly "TroubleTicket events feeding the TicketAnalytics projection"
  }
  connector 'TicketAnalytics Storage' is from outlet TicketContext.TicketAnalytics.TicketAnalyticsOut to inlet TicketContext.TicketRepository.TicketRepositoryFromTicketAnalytics with {
    briefly "The TicketAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for trouble ticketing"
  described as {
    |Customer support context.
  }
}
