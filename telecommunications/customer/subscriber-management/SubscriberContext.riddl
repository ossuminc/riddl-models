// Subscriber Management - Subscriber Context
context SubscriberContext as router is {
  inlet SubscriberCommandStreamIn is type SubscriberCommand  outlet SubscriberCommandStreamOut is type SubscriberCommand
  inlet SubscriberResultStreamIn is result Subscriber.SubscriberResult  outlet SubscriberResultStreamOut is result Subscriber.SubscriberResult
  handler SubscriberContextBoundary is {
    on createSubscriber: command Subscriber.CreateSubscriber is {
      send createSubscriber to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on addServiceLine: command Subscriber.AddServiceLine is {
      send addServiceLine to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on activateService: command Subscriber.ActivateService is {
      send activateService to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on changePlan: command Subscriber.ChangePlan is {
      send changePlan to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on assignDevice: command Subscriber.AssignDevice is {
      send assignDevice to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on updateContact: command Subscriber.UpdateContact is {
      send updateContact to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on suspendService: command Subscriber.SuspendService is {
      send suspendService to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on resumeService: command Subscriber.ResumeService is {
      send resumeService to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on disconnectService: command Subscriber.DisconnectService is {
      send disconnectService to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on cancelAccount: command Subscriber.CancelAccount is {
      send cancelAccount to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on createSupportTicket: command Subscriber.CreateSupportTicket is {
      send createSupportTicket to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on subscriberResult: result Subscriber.SubscriberResult is {
      send subscriberResult to outlet SubscriberContext.SubscriberResultStreamOut
    }
    on other is {
      error "Unexpected message at the SubscriberContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'SubscriberCommand Stream Intake' is from outlet SubscriberContext.SubscriberCommandStreamOut to inlet SubscriberContext.Subscriber.SubscriberCommands  connector 'SubscriberResult Stream Egress' is from outlet SubscriberContext.SubscriberRepository.SubscriberRepositoryResponses to inlet SubscriberContext.SubscriberResultStreamIn  adaptor FromBillingSystem from context BillingSystem is { 
    handler FromBillingSystemHandler is {
      on result BillingSystem.AccountBalance is {
        do "the model receives account balance"
      }
      on event BillingSystem.BillingAccountCreated is {
        do "the model receives billing account created"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingSystem"
      }
    } with {
      briefly "from billing system"
      described as {
        |Carries messages from the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor ToBillingSystem to context BillingSystem is { 
    handler ToBillingSystemHandler is {
      on command BillingSystem.AddCharges is {
        do "the model sends add charges"
      }
      on command BillingSystem.CreateBillingAccount is {
        do "the model sends create billing account"
      }
      on query BillingSystem.GetAccountBalance is {
        do "the model sends get account balance"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingSystem"
      }
    } with {
      briefly "to billing system"
      described as {
        |Carries messages to the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor FromCRMSystem from context CRMSystem is { 
    handler FromCRMSystemHandler is {
      on result CRMSystem.CustomerHistory is {
        do "the model receives customer history"
      }
      on other is {
        error "Unexpected message for adaptor FromCRMSystem"
      }
    } with {
      briefly "from crm system"
      described as {
        |Carries messages from the external CRMSystem.
      }
    }
  } with {
    briefly "CRMSystem integration"
    described as {
      |The model's side of the CRMSystem conversation.
    }
  }
  adaptor ToCRMSystem to context CRMSystem is { 
    handler ToCRMSystemHandler is {
      on command CRMSystem.CreateCustomerRecord is {
        do "the model sends create customer record"
      }
      on query CRMSystem.GetCustomerHistory is {
        do "the model sends get customer history"
      }
      on command CRMSystem.LogInteraction is {
        do "the model sends log interaction"
      }
      on other is {
        error "Unexpected message for adaptor ToCRMSystem"
      }
    } with {
      briefly "to crm system"
      described as {
        |Carries messages to the external CRMSystem.
      }
    }
  } with {
    briefly "CRMSystem integration"
    described as {
      |The model's side of the CRMSystem conversation.
    }
  }
  adaptor FromDeviceManagement from context DeviceManagement is { 
    handler FromDeviceManagementHandler is {
      on event DeviceManagement.DeviceRegistered is {
        do "the model receives device registered"
      }
      on other is {
        error "Unexpected message for adaptor FromDeviceManagement"
      }
    } with {
      briefly "from device management"
      described as {
        |Carries messages from the external DeviceManagement.
      }
    }
  } with {
    briefly "DeviceManagement integration"
    described as {
      |The model's side of the DeviceManagement conversation.
    }
  }
  adaptor ToDeviceManagement to context DeviceManagement is { 
    handler ToDeviceManagementHandler is {
      on command DeviceManagement.ActivateSIM is {
        do "the model sends activate sim"
      }
      on command DeviceManagement.RegisterDevice is {
        do "the model sends register device"
      }
      on other is {
        error "Unexpected message for adaptor ToDeviceManagement"
      }
    } with {
      briefly "to device management"
      described as {
        |Carries messages to the external DeviceManagement.
      }
    }
  } with {
    briefly "DeviceManagement integration"
    described as {
      |The model's side of the DeviceManagement conversation.
    }
  }
  adaptor FromNetworkProvisioning from context NetworkProvisioning is { 
    handler FromNetworkProvisioningHandler is {
      on event NetworkProvisioning.ServiceProvisioned is {
        do "the model receives service provisioned"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkProvisioning"
      }
    } with {
      briefly "from network provisioning"
      described as {
        |Carries messages from the external NetworkProvisioning.
      }
    }
  } with {
    briefly "NetworkProvisioning integration"
    described as {
      |The model's side of the NetworkProvisioning conversation.
    }
  }
  adaptor ToNetworkProvisioning to context NetworkProvisioning is { 
    handler ToNetworkProvisioningHandler is {
      on command NetworkProvisioning.DeprovisionService is {
        do "the model sends deprovision service"
      }
      on command NetworkProvisioning.ProvisionService is {
        do "the model sends provision service"
      }
      on other is {
        error "Unexpected message for adaptor ToNetworkProvisioning"
      }
    } with {
      briefly "to network provisioning"
      described as {
        |Carries messages to the external NetworkProvisioning.
      }
    }
  } with {
    briefly "NetworkProvisioning integration"
    described as {
      |The model's side of the NetworkProvisioning conversation.
    }
  }
  include "types.riddl"
  include "Subscriber.riddl"
  type SubscriberRepositoryCommand is one of {
    SubscriberContext.SubscriberRepository.PersistAccountCancelled or SubscriberContext.SubscriberRepository.PersistContactUpdated or SubscriberContext.SubscriberRepository.PersistDeviceAssigned or SubscriberContext.SubscriberRepository.PersistPlanChanged or SubscriberContext.SubscriberRepository.PersistServiceActivated or SubscriberContext.SubscriberRepository.PersistServiceDisconnected or SubscriberContext.SubscriberRepository.PersistServiceLineAdded or SubscriberContext.SubscriberRepository.PersistServiceResumed or SubscriberContext.SubscriberRepository.PersistServiceSuspended or SubscriberContext.SubscriberRepository.PersistSubscriberCreated or SubscriberContext.SubscriberRepository.PersistSupportTicketCreated
  } with {
    briefly "Anything that writes SubscriberRepository"
    described as {
      |The persistence commands SubscriberRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository SubscriberRepository as flow is {
    inlet SubscriberRepositoryFromSubscriberAnalytics is type SubscriberRepositoryCommand    command PersistContactUpdated is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContactUpdated applies to.
        }
      }
    } with {
      briefly "Persist ContactUpdated"
      described as {
        |Instructs this repository to apply ContactUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeviceAssigned is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeviceAssigned applies to.
        }
      }
    } with {
      briefly "Persist DeviceAssigned"
      described as {
        |Instructs this repository to apply DeviceAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceActivated is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceActivated applies to.
        }
      }
    } with {
      briefly "Persist ServiceActivated"
      described as {
        |Instructs this repository to apply ServiceActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceDisconnected is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceDisconnected applies to.
        }
      }
    } with {
      briefly "Persist ServiceDisconnected"
      described as {
        |Instructs this repository to apply ServiceDisconnected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceLineAdded is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceLineAdded applies to.
        }
      }
    } with {
      briefly "Persist ServiceLineAdded"
      described as {
        |Instructs this repository to apply ServiceLineAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceResumed is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceResumed applies to.
        }
      }
    } with {
      briefly "Persist ServiceResumed"
      described as {
        |Instructs this repository to apply ServiceResumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceSuspended is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceSuspended applies to.
        }
      }
    } with {
      briefly "Persist ServiceSuspended"
      described as {
        |Instructs this repository to apply ServiceSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSupportTicketCreated is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row SupportTicketCreated applies to.
        }
      }
    } with {
      briefly "Persist SupportTicketCreated"
      described as {
        |Instructs this repository to apply SupportTicketCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountCancelled is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountCancelled applies to.
        }
      }
    } with {
      briefly "Persist AccountCancelled"
      described as {
        |Instructs this repository to apply AccountCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlanChanged is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlanChanged applies to.
        }
      }
    } with {
      briefly "Persist PlanChanged"
      described as {
        |Instructs this repository to apply PlanChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubscriberCreated is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubscriberCreated applies to.
        }
      }
    } with {
      briefly "Persist SubscriberCreated"
      described as {
        |Instructs this repository to apply SubscriberCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet SubscriberRepositoryResponses is result Subscriber.SubscriberResult
    record StoredSubscriber is {
      subscriberId: SubscriberId with {
        briefly "subscriberId"
        described as {
          |The subscriberId column of the stored subscriber row.
        }
      }
      accountId: AccountId with {
        briefly "accountId"
        described as {
          |The accountId column of the stored subscriber row.
        }
      }
      contactInfo: ContactInfo with {
        briefly "contactInfo"
        described as {
          |The contactInfo column of the stored subscriber row.
        }
      }
      status: SubscriberStatus with {
        briefly "status"
        described as {
          |The status column of the stored subscriber row.
        }
      }
    } with {
      briefly "Stored subscriber row"
      described as {
        |The persistence shape of subscriber data as this repository stores it.
      }
    }
    schema SubscriberData is relational
      of subscribers as record StoredSubscriber
        index on field StoredSubscriber.subscriberId
        index on field StoredSubscriber.accountId
        index on field StoredSubscriber.status
        index on field StoredSubscriber.contactInfo.email
 with {
      briefly "Subscriber data schema"
      described as {
        |The relational schema holding subscriber data for the SubscriberRepository.
      }
    }
    handler SubscriberPersistence is {
      on persistContactUpdated: command PersistContactUpdated is {
        do "apply ContactUpdated to the stored row"
      }
      on persistDeviceAssigned: command PersistDeviceAssigned is {
        do "apply DeviceAssigned to the stored row"
      }
      on persistServiceActivated: command PersistServiceActivated is {
        do "apply ServiceActivated to the stored row"
      }
      on persistServiceDisconnected: command PersistServiceDisconnected is {
        do "apply ServiceDisconnected to the stored row"
      }
      on persistServiceLineAdded: command PersistServiceLineAdded is {
        do "apply ServiceLineAdded to the stored row"
      }
      on persistServiceResumed: command PersistServiceResumed is {
        do "apply ServiceResumed to the stored row"
      }
      on persistServiceSuspended: command PersistServiceSuspended is {
        do "apply ServiceSuspended to the stored row"
      }
      on persistSupportTicketCreated: command PersistSupportTicketCreated is {
        do "apply SupportTicketCreated to the stored row"
      }
      on persistAccountCancelled: command PersistAccountCancelled is {
        do "apply AccountCancelled to the stored row"
      }
      on persistPlanChanged: command PersistPlanChanged is {
        do "apply PlanChanged to the stored row"
      }
      on persistSubscriberCreated: command PersistSubscriberCreated is {
        do "apply SubscriberCreated to the stored row"
      }
      on query GetSubscriberMetrics is {
        let subscriberMetricsView: type SubscriberMetricsView = prompt("read the subscriber metrics projection")
        reply subscriberMetricsView
      }
    } with {
      briefly "Persists subscriber commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Subscriber data persistence"
    described as {
      |Persistent storage for subscribers.
    }
  }
  query GetSubscriberMetrics replies result SubscriberMetricsView is {
    subscriberMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which subscriber metrics to retrieve.
      }
    }
  } with {
    briefly "Get subscriber metrics"
    described as {
      |Retrieves the subscriber metrics projection.
    }
  }
  result SubscriberMetricsView is {
    subscriberMetrics: SubscriberAnalytics.SubscriberMetrics with {
      briefly "Subscriber metrics"
      described as {
        |The subscriber metrics being returned.
      }
    }
  } with {
    briefly "Subscriber metrics view"
    described as {
      |Read model view carrying the subscriber metrics projection.
    }
  }
  projector SubscriberAnalytics as flow is {
    updates repository SubscriberContext.SubscriberRepository
    outlet SubscriberAnalyticsToRepository is type SubscriberRepositoryCommand
    inlet SubscriberAnalyticsFromSubscriber is type SubscriberEvent    record SubscriberMetrics is {
      totalSubscribers: Natural with {
        briefly "Total"
        described as {
          |Total subscribers.
        }
      }
      activeSubscribers: Natural with {
        briefly "Active"
        described as {
          |Active subscribers.
        }
      }
      newSubscribersThisMonth: Natural with {
        briefly "New"
        described as {
          |New this month.
        }
      }
      churnedThisMonth: Natural with {
        briefly "Churned"
        described as {
          |Churned this month.
        }
      }
      averageRevenuePerUser: Decimal(8,2) with {
        briefly "ARPU"
        described as {
          |Average revenue per user.
        }
      }
    } with {
      briefly "Subscriber metrics"
      described as {
        |Subscriber analytics.
      }
    }
    handler AnalyticsHandler is {
      on contactUpdated: event Subscriber.ContactUpdated is {
        tell command SubscriberContext.SubscriberRepository.PersistContactUpdated(subscriberId = contactUpdated.subscriberId) to repository SubscriberContext.SubscriberRepository
        do "apply ContactUpdated to the SubscriberAnalytics projection"
      }
      on deviceAssigned: event Subscriber.DeviceAssigned is {
        tell command SubscriberContext.SubscriberRepository.PersistDeviceAssigned(subscriberId = deviceAssigned.subscriberId) to repository SubscriberContext.SubscriberRepository
        do "apply DeviceAssigned to the SubscriberAnalytics projection"
      }
      on serviceActivated: event Subscriber.ServiceActivated is {
        tell command SubscriberContext.SubscriberRepository.PersistServiceActivated(subscriberId = serviceActivated.subscriberId) to repository SubscriberContext.SubscriberRepository
        do "apply ServiceActivated to the SubscriberAnalytics projection"
      }
      on serviceDisconnected: event Subscriber.ServiceDisconnected is {
        tell command SubscriberContext.SubscriberRepository.PersistServiceDisconnected(subscriberId = serviceDisconnected.subscriberId) to repository SubscriberContext.SubscriberRepository
        do "apply ServiceDisconnected to the SubscriberAnalytics projection"
      }
      on serviceLineAdded: event Subscriber.ServiceLineAdded is {
        tell command SubscriberContext.SubscriberRepository.PersistServiceLineAdded(subscriberId = serviceLineAdded.subscriberId) to repository SubscriberContext.SubscriberRepository
        do "apply ServiceLineAdded to the SubscriberAnalytics projection"
      }
      on serviceResumed: event Subscriber.ServiceResumed is {
        tell command SubscriberContext.SubscriberRepository.PersistServiceResumed(subscriberId = serviceResumed.subscriberId) to repository SubscriberContext.SubscriberRepository
        do "apply ServiceResumed to the SubscriberAnalytics projection"
      }
      on serviceSuspended: event Subscriber.ServiceSuspended is {
        tell command SubscriberContext.SubscriberRepository.PersistServiceSuspended(subscriberId = serviceSuspended.subscriberId) to repository SubscriberContext.SubscriberRepository
        do "apply ServiceSuspended to the SubscriberAnalytics projection"
      }
      on supportTicketCreated: event Subscriber.SupportTicketCreated is {
        tell command SubscriberContext.SubscriberRepository.PersistSupportTicketCreated(subscriberId = supportTicketCreated.subscriberId) to repository SubscriberContext.SubscriberRepository
        do "apply SupportTicketCreated to the SubscriberAnalytics projection"
      }
      on subscriberCreated: event Subscriber.SubscriberCreated is {
        tell command SubscriberContext.SubscriberRepository.PersistSubscriberCreated(subscriberId = subscriberCreated.subscriberId) to repository SubscriberContext.SubscriberRepository
        do "Increment total and new subscriber counts"
      }
      on accountCancelled: event Subscriber.AccountCancelled is {
        tell command SubscriberContext.SubscriberRepository.PersistAccountCancelled(subscriberId = accountCancelled.subscriberId) to repository SubscriberContext.SubscriberRepository
        do "Decrement active and increment churned"
      }
      on planChanged: event Subscriber.PlanChanged is {
        tell command SubscriberContext.SubscriberRepository.PersistPlanChanged(subscriberId = planChanged.subscriberId) to repository SubscriberContext.SubscriberRepository
        do "Recalculate ARPU"
      }
    } with {
      briefly "Maintains subscriber analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Subscriber analytics"
    described as {
      |Subscriber metrics and KPIs.
    }
  }
  // ---- Event publication for Subscriber ----
  type SubscriberEvent is one of {
    SubscriberContext.Subscriber.SubscriberCreated or SubscriberContext.Subscriber.ServiceLineAdded or SubscriberContext.Subscriber.ServiceActivated or SubscriberContext.Subscriber.PlanChanged or SubscriberContext.Subscriber.DeviceAssigned or SubscriberContext.Subscriber.ContactUpdated or SubscriberContext.Subscriber.ServiceSuspended or SubscriberContext.Subscriber.ServiceResumed or SubscriberContext.Subscriber.ServiceDisconnected or SubscriberContext.Subscriber.AccountCancelled or SubscriberContext.Subscriber.SupportTicketCreated
  } with {
    briefly "Subscriber event alternation"
    described as {
      |Union of all Subscriber events, for streaming and event-sourced
      |persistence.
    }
  }
  processor SubscriberEventSplit as flow is {
    inlet SubscriberEventSplitIn is type SubscriberEvent    outlet SubscriberEventSplitToSubscriberAnalytics is type SubscriberEvent
    handler SubscriberEventSplitHandler is {
      on subscriberCreated: event Subscriber.SubscriberCreated is {
        send subscriberCreated to outlet SubscriberEventSplitToSubscriberAnalytics
        tell subscriberCreated to entity SubscriberContext.Subscriber
      }
      on serviceLineAdded: event Subscriber.ServiceLineAdded is {
        send serviceLineAdded to outlet SubscriberEventSplitToSubscriberAnalytics
        tell serviceLineAdded to entity SubscriberContext.Subscriber
      }
      on serviceActivated: event Subscriber.ServiceActivated is {
        send serviceActivated to outlet SubscriberEventSplitToSubscriberAnalytics
        tell serviceActivated to entity SubscriberContext.Subscriber
      }
      on planChanged: event Subscriber.PlanChanged is {
        send planChanged to outlet SubscriberEventSplitToSubscriberAnalytics
        tell planChanged to entity SubscriberContext.Subscriber
      }
      on deviceAssigned: event Subscriber.DeviceAssigned is {
        send deviceAssigned to outlet SubscriberEventSplitToSubscriberAnalytics
        tell deviceAssigned to entity SubscriberContext.Subscriber
      }
      on contactUpdated: event Subscriber.ContactUpdated is {
        send contactUpdated to outlet SubscriberEventSplitToSubscriberAnalytics
        tell contactUpdated to entity SubscriberContext.Subscriber
      }
      on serviceSuspended: event Subscriber.ServiceSuspended is {
        send serviceSuspended to outlet SubscriberEventSplitToSubscriberAnalytics
        tell serviceSuspended to entity SubscriberContext.Subscriber
      }
      on serviceResumed: event Subscriber.ServiceResumed is {
        send serviceResumed to outlet SubscriberEventSplitToSubscriberAnalytics
        tell serviceResumed to entity SubscriberContext.Subscriber
      }
      on serviceDisconnected: event Subscriber.ServiceDisconnected is {
        send serviceDisconnected to outlet SubscriberEventSplitToSubscriberAnalytics
        tell serviceDisconnected to entity SubscriberContext.Subscriber
      }
      on accountCancelled: event Subscriber.AccountCancelled is {
        send accountCancelled to outlet SubscriberEventSplitToSubscriberAnalytics
        tell accountCancelled to entity SubscriberContext.Subscriber
      }
      on supportTicketCreated: event Subscriber.SupportTicketCreated is {
        send supportTicketCreated to outlet SubscriberEventSplitToSubscriberAnalytics
        tell supportTicketCreated to entity SubscriberContext.Subscriber
      }
      on other is {
        error "Unexpected message for processor SubscriberEventSplit"
      }
    } with {
      briefly "Subscriber event fan-out handler"
      described as {
        |Delivers each Subscriber event to all of its consumers.
      }
    }
  } with {
    briefly "Subscriber event fan-out"
    described as {
      |Fans Subscriber events out to the repository and projectors.
    }
  }
  connector 'SubscriberEvent Stream' is from outlet SubscriberContext.Subscriber.SubscriberEvents2 to inlet SubscriberContext.SubscriberEventSplit.SubscriberEventSplitIn with {
    briefly "Subscriber events, fanned out to storage and read models"
  }
  connector 'SubscriberAnalytics Feed' is from outlet SubscriberContext.SubscriberEventSplit.SubscriberEventSplitToSubscriberAnalytics to inlet SubscriberContext.SubscriberAnalytics.SubscriberAnalyticsFromSubscriber with {
    briefly "Subscriber events feeding the SubscriberAnalytics projection"
  }
  connector 'SubscriberAnalytics Storage' is from outlet SubscriberContext.SubscriberAnalytics.SubscriberAnalyticsToRepository to inlet SubscriberContext.SubscriberRepository.SubscriberRepositoryFromSubscriberAnalytics with {
    briefly "SubscriberAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for subscriber management"
  described as {
    |Telecom subscriber account context.
  }
}
