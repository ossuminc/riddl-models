// Subscriber Management - Subscriber Context
context SubscriberContext is {
  adaptor FromBillingSystem from context BillingSystem is { 
    handler FromBillingSystemHandler is {
      on result BillingSystem.AccountBalance is {
        do "the model receives account balance"
      }
      on event BillingSystem.BillingAccountCreated is {
        do "the model receives billing account created"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingSystem"
      }
    } with {
      briefly "from billing system"
      described as {
        |Carries messages from the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor ToBillingSystem to context BillingSystem is { 
    handler ToBillingSystemHandler is {
      on command BillingSystem.AddCharges is {
        do "the model sends add charges"
      }
      on command BillingSystem.CreateBillingAccount is {
        do "the model sends create billing account"
      }
      on query BillingSystem.GetAccountBalance is {
        do "the model sends get account balance"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingSystem"
      }
    } with {
      briefly "to billing system"
      described as {
        |Carries messages to the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor FromCRMSystem from context CRMSystem is { 
    handler FromCRMSystemHandler is {
      on result CRMSystem.CustomerHistory is {
        do "the model receives customer history"
      }
      on other is {
        error "Unexpected message for adaptor FromCRMSystem"
      }
    } with {
      briefly "from crm system"
      described as {
        |Carries messages from the external CRMSystem.
      }
    }
  } with {
    briefly "CRMSystem integration"
    described as {
      |The model's side of the CRMSystem conversation.
    }
  }
  adaptor ToCRMSystem to context CRMSystem is { 
    handler ToCRMSystemHandler is {
      on command CRMSystem.CreateCustomerRecord is {
        do "the model sends create customer record"
      }
      on query CRMSystem.GetCustomerHistory is {
        do "the model sends get customer history"
      }
      on command CRMSystem.LogInteraction is {
        do "the model sends log interaction"
      }
      on other is {
        error "Unexpected message for adaptor ToCRMSystem"
      }
    } with {
      briefly "to crm system"
      described as {
        |Carries messages to the external CRMSystem.
      }
    }
  } with {
    briefly "CRMSystem integration"
    described as {
      |The model's side of the CRMSystem conversation.
    }
  }
  adaptor FromDeviceManagement from context DeviceManagement is { 
    handler FromDeviceManagementHandler is {
      on event DeviceManagement.DeviceRegistered is {
        do "the model receives device registered"
      }
      on other is {
        error "Unexpected message for adaptor FromDeviceManagement"
      }
    } with {
      briefly "from device management"
      described as {
        |Carries messages from the external DeviceManagement.
      }
    }
  } with {
    briefly "DeviceManagement integration"
    described as {
      |The model's side of the DeviceManagement conversation.
    }
  }
  adaptor ToDeviceManagement to context DeviceManagement is { 
    handler ToDeviceManagementHandler is {
      on command DeviceManagement.ActivateSIM is {
        do "the model sends activate sim"
      }
      on command DeviceManagement.RegisterDevice is {
        do "the model sends register device"
      }
      on other is {
        error "Unexpected message for adaptor ToDeviceManagement"
      }
    } with {
      briefly "to device management"
      described as {
        |Carries messages to the external DeviceManagement.
      }
    }
  } with {
    briefly "DeviceManagement integration"
    described as {
      |The model's side of the DeviceManagement conversation.
    }
  }
  adaptor FromNetworkProvisioning from context NetworkProvisioning is { 
    handler FromNetworkProvisioningHandler is {
      on event NetworkProvisioning.ServiceProvisioned is {
        do "the model receives service provisioned"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkProvisioning"
      }
    } with {
      briefly "from network provisioning"
      described as {
        |Carries messages from the external NetworkProvisioning.
      }
    }
  } with {
    briefly "NetworkProvisioning integration"
    described as {
      |The model's side of the NetworkProvisioning conversation.
    }
  }
  adaptor ToNetworkProvisioning to context NetworkProvisioning is { 
    handler ToNetworkProvisioningHandler is {
      on command NetworkProvisioning.DeprovisionService is {
        do "the model sends deprovision service"
      }
      on command NetworkProvisioning.ProvisionService is {
        do "the model sends provision service"
      }
      on other is {
        error "Unexpected message for adaptor ToNetworkProvisioning"
      }
    } with {
      briefly "to network provisioning"
      described as {
        |Carries messages to the external NetworkProvisioning.
      }
    }
  } with {
    briefly "NetworkProvisioning integration"
    described as {
      |The model's side of the NetworkProvisioning conversation.
    }
  }
  include "types.riddl"
  include "Subscriber.riddl"
  repository SubscriberRepository as merge is {
    inlet SubscriberRepositoryFromSubscriber is type SubscriberEvent    inlet SubscriberRepositoryFromSubscriberAnalytics is type SubscriberEvent    outlet SubscriberRepositoryResponses is type Subscriber.SubscriberResult
    record StoredSubscriber is  {
      subscriberId: SubscriberId with {
        briefly "subscriberId"
        described as {
          |The subscriberId column of the stored subscriber row.
        }
      }
      accountId: AccountId with {
        briefly "accountId"
        described as {
          |The accountId column of the stored subscriber row.
        }
      }
      contactInfo: ContactInfo with {
        briefly "contactInfo"
        described as {
          |The contactInfo column of the stored subscriber row.
        }
      }
      status: SubscriberStatus with {
        briefly "status"
        described as {
          |The status column of the stored subscriber row.
        }
      }
    } with {
      briefly "Stored subscriber row"
      described as {
        |The persistence shape of subscriber data as this repository stores it.
      }
    }
    schema SubscriberData is relational
      of subscribers as type StoredSubscriber
        index on field StoredSubscriber.subscriberId
        index on field StoredSubscriber.accountId
        index on field StoredSubscriber.status
        index on field StoredSubscriber.contactInfo.email
 with {
      briefly "Subscriber data schema"
      described as {
        |The relational schema holding subscriber data for the SubscriberRepository.
      }
    }
    handler SubscriberPersistence is {
      on query GetSubscriberMetrics is {
        let subscriberMetricsView: SubscriberMetricsView = prompt("read the subscriber metrics projection")
        reply subscriberMetricsView
      }
      on createSubscriber: command Subscriber.CreateSubscriber is {
        tell event Subscriber.SubscriberCreated(subscriberId = createSubscriber.subscriberId, accountId = createSubscriber.accountId, accountType = createSubscriber.accountType) to entity SubscriberContext.Subscriber
        do "Store new subscriber record"
      }
      on addServiceLine: command Subscriber.AddServiceLine is {
        tell event Subscriber.ServiceLineAdded(subscriberId = addServiceLine.subscriberId, serviceLine = addServiceLine.serviceLine) to entity SubscriberContext.Subscriber
        do "Store service line"
      }
      on command Subscriber.ActivateService is {
        do "Update line to active"
      }
      on command Subscriber.ChangePlan is {
        do "Update service plan"
      }
      on suspendService: command Subscriber.SuspendService is {
        tell event Subscriber.ServiceSuspended(subscriberId = suspendService.subscriberId, reason = suspendService.reason, suspendedAt = suspendService.suspendedAt) to entity SubscriberContext.Subscriber
        do "Update subscriber to suspended"
      }
      on cancelAccount: command Subscriber.CancelAccount is {
        tell event Subscriber.AccountCancelled(subscriberId = cancelAccount.subscriberId, reason = cancelAccount.reason) to entity SubscriberContext.Subscriber
        do "Update subscriber to cancelled"
      }
    } with {
      briefly "Persists subscriber commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Subscriber data persistence"
    described as {
      |Persistent storage for subscribers.
    }
  }
  query GetSubscriberMetrics is  {
    subscriberMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which subscriber metrics to retrieve.
      }
    }
  } with {
    briefly "Get subscriber metrics"
    described as {
      |Retrieves the subscriber metrics projection.
    }
  }
  result SubscriberMetricsView is  {
    subscriberMetrics: SubscriberAnalytics.SubscriberMetrics with {
      briefly "Subscriber metrics"
      described as {
        |The subscriber metrics being returned.
      }
    }
  } with {
    briefly "Subscriber metrics view"
    described as {
      |Read model view carrying the subscriber metrics projection.
    }
  }
  projector SubscriberAnalytics as flow is {
    updates repository SubscriberContext.SubscriberRepository
    inlet SubscriberAnalyticsFromSubscriber is type SubscriberEvent    outlet SubscriberAnalyticsOut is type SubscriberEvent
    record SubscriberMetrics is  {
      totalSubscribers: Natural with {
        briefly "Total"
        described as {
          |Total subscribers.
        }
      }
      activeSubscribers: Natural with {
        briefly "Active"
        described as {
          |Active subscribers.
        }
      }
      newSubscribersThisMonth: Natural with {
        briefly "New"
        described as {
          |New this month.
        }
      }
      churnedThisMonth: Natural with {
        briefly "Churned"
        described as {
          |Churned this month.
        }
      }
      averageRevenuePerUser: Decimal(8,2) with {
        briefly "ARPU"
        described as {
          |Average revenue per user.
        }
      }
    } with {
      briefly "Subscriber metrics"
      described as {
        |Subscriber analytics.
      }
    }
    handler AnalyticsHandler is {
      on subscriberCreated: event Subscriber.SubscriberCreated is {
        tell subscriberCreated to repository SubscriberContext.SubscriberRepository
        do "Increment total and new subscriber counts"
      }
      on accountCancelled: event Subscriber.AccountCancelled is {
        tell accountCancelled to repository SubscriberContext.SubscriberRepository
        do "Decrement active and increment churned"
      }
      on planChanged: event Subscriber.PlanChanged is {
        tell planChanged to repository SubscriberContext.SubscriberRepository
        do "Recalculate ARPU"
      }
    } with {
      briefly "Maintains subscriber analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Subscriber analytics"
    described as {
      |Subscriber metrics and KPIs.
    }
  }
  // ---- Event publication for Subscriber ----
  type SubscriberEvent is one of {
    SubscriberContext.Subscriber.SubscriberCreated or SubscriberContext.Subscriber.ServiceLineAdded or SubscriberContext.Subscriber.ServiceActivated or SubscriberContext.Subscriber.PlanChanged or SubscriberContext.Subscriber.DeviceAssigned or SubscriberContext.Subscriber.ContactUpdated or SubscriberContext.Subscriber.ServiceSuspended or SubscriberContext.Subscriber.ServiceResumed or SubscriberContext.Subscriber.ServiceDisconnected or SubscriberContext.Subscriber.AccountCancelled or SubscriberContext.Subscriber.SupportTicketCreated
  } with {
    briefly "Subscriber event alternation"
    described as {
      |Union of all Subscriber events, for streaming and event-sourced
      |persistence.
    }
  }
  processor SubscriberEventSource as source is {
    outlet SubscriberEvents is type SubscriberEvent
    handler SubscriberSourceHandler is {
      on subscriberCreated: event Subscriber.SubscriberCreated is {
        send subscriberCreated to outlet SubscriberEvents
      }
      on serviceLineAdded: event Subscriber.ServiceLineAdded is {
        send serviceLineAdded to outlet SubscriberEvents
      }
      on serviceActivated: event Subscriber.ServiceActivated is {
        send serviceActivated to outlet SubscriberEvents
      }
      on planChanged: event Subscriber.PlanChanged is {
        send planChanged to outlet SubscriberEvents
      }
      on deviceAssigned: event Subscriber.DeviceAssigned is {
        send deviceAssigned to outlet SubscriberEvents
      }
      on contactUpdated: event Subscriber.ContactUpdated is {
        send contactUpdated to outlet SubscriberEvents
      }
      on serviceSuspended: event Subscriber.ServiceSuspended is {
        send serviceSuspended to outlet SubscriberEvents
      }
      on serviceResumed: event Subscriber.ServiceResumed is {
        send serviceResumed to outlet SubscriberEvents
      }
      on serviceDisconnected: event Subscriber.ServiceDisconnected is {
        send serviceDisconnected to outlet SubscriberEvents
      }
      on accountCancelled: event Subscriber.AccountCancelled is {
        send accountCancelled to outlet SubscriberEvents
      }
      on supportTicketCreated: event Subscriber.SupportTicketCreated is {
        send supportTicketCreated to outlet SubscriberEvents
      }
      on other is {
        error "Unexpected message for source SubscriberEventSource"
      }
    } with {
      briefly "Subscriber source handler"
      described as {
        |Publishes Subscriber events onto the outlet.
      }
    }
  } with {
    briefly "Subscriber event source"
    described as {
      |Publishes Subscriber entity events into the streaming topology.
    }
  }
  processor SubscriberEventSink as sink is {
    inlet SubscriberInlet is type SubscriberEvent    handler SubscriberSinkHandler is {
      on subscriberCreated: event Subscriber.SubscriberCreated is {
        tell subscriberCreated to repository SubscriberContext.SubscriberRepository
      }
      on serviceLineAdded: event Subscriber.ServiceLineAdded is {
        tell serviceLineAdded to repository SubscriberContext.SubscriberRepository
      }
      on serviceActivated: event Subscriber.ServiceActivated is {
        tell serviceActivated to repository SubscriberContext.SubscriberRepository
      }
      on planChanged: event Subscriber.PlanChanged is {
        tell planChanged to repository SubscriberContext.SubscriberRepository
      }
      on deviceAssigned: event Subscriber.DeviceAssigned is {
        tell deviceAssigned to repository SubscriberContext.SubscriberRepository
      }
      on contactUpdated: event Subscriber.ContactUpdated is {
        tell contactUpdated to repository SubscriberContext.SubscriberRepository
      }
      on serviceSuspended: event Subscriber.ServiceSuspended is {
        tell serviceSuspended to repository SubscriberContext.SubscriberRepository
      }
      on serviceResumed: event Subscriber.ServiceResumed is {
        tell serviceResumed to repository SubscriberContext.SubscriberRepository
      }
      on serviceDisconnected: event Subscriber.ServiceDisconnected is {
        tell serviceDisconnected to repository SubscriberContext.SubscriberRepository
      }
      on accountCancelled: event Subscriber.AccountCancelled is {
        tell accountCancelled to repository SubscriberContext.SubscriberRepository
      }
      on supportTicketCreated: event Subscriber.SupportTicketCreated is {
        tell supportTicketCreated to repository SubscriberContext.SubscriberRepository
      }
      on other is {
        error "Unexpected message for sink SubscriberEventSink"
      }
    } with {
      briefly "Subscriber sink handler"
      described as {
        |Persists Subscriber events via the repository.
      }
    }
  } with {
    briefly "Subscriber event sink"
    described as {
      |Receives Subscriber events for persistence.
    }
  }
  connector SubscriberEventFlow is from outlet SubscriberContext.SubscriberEventSource.SubscriberEvents to inlet SubscriberContext.SubscriberEventSink.SubscriberInlet with {
    briefly "Subscriber event flow"
    described as {
      |Connects the Subscriber source to its sink.
    }
  }
  processor SubscriberEventSplit as split is {
    inlet SubscriberEventSplitIn is type SubscriberEvent    outlet SubscriberEventSplitToSubscriberRepository is type SubscriberEvent
    outlet SubscriberEventSplitToSubscriberAnalytics is type SubscriberEvent
    handler SubscriberEventSplitHandler is {
      on subscriberCreated: event Subscriber.SubscriberCreated is {
        send subscriberCreated to outlet SubscriberEventSplitToSubscriberRepository
        send subscriberCreated to outlet SubscriberEventSplitToSubscriberAnalytics
        tell subscriberCreated to entity SubscriberContext.Subscriber
      }
      on serviceLineAdded: event Subscriber.ServiceLineAdded is {
        send serviceLineAdded to outlet SubscriberEventSplitToSubscriberRepository
        send serviceLineAdded to outlet SubscriberEventSplitToSubscriberAnalytics
        tell serviceLineAdded to entity SubscriberContext.Subscriber
      }
      on serviceActivated: event Subscriber.ServiceActivated is {
        send serviceActivated to outlet SubscriberEventSplitToSubscriberRepository
        send serviceActivated to outlet SubscriberEventSplitToSubscriberAnalytics
        tell serviceActivated to entity SubscriberContext.Subscriber
      }
      on planChanged: event Subscriber.PlanChanged is {
        send planChanged to outlet SubscriberEventSplitToSubscriberRepository
        send planChanged to outlet SubscriberEventSplitToSubscriberAnalytics
        tell planChanged to entity SubscriberContext.Subscriber
      }
      on deviceAssigned: event Subscriber.DeviceAssigned is {
        send deviceAssigned to outlet SubscriberEventSplitToSubscriberRepository
        send deviceAssigned to outlet SubscriberEventSplitToSubscriberAnalytics
        tell deviceAssigned to entity SubscriberContext.Subscriber
      }
      on contactUpdated: event Subscriber.ContactUpdated is {
        send contactUpdated to outlet SubscriberEventSplitToSubscriberRepository
        send contactUpdated to outlet SubscriberEventSplitToSubscriberAnalytics
        tell contactUpdated to entity SubscriberContext.Subscriber
      }
      on serviceSuspended: event Subscriber.ServiceSuspended is {
        send serviceSuspended to outlet SubscriberEventSplitToSubscriberRepository
        send serviceSuspended to outlet SubscriberEventSplitToSubscriberAnalytics
        tell serviceSuspended to entity SubscriberContext.Subscriber
      }
      on serviceResumed: event Subscriber.ServiceResumed is {
        send serviceResumed to outlet SubscriberEventSplitToSubscriberRepository
        send serviceResumed to outlet SubscriberEventSplitToSubscriberAnalytics
        tell serviceResumed to entity SubscriberContext.Subscriber
      }
      on serviceDisconnected: event Subscriber.ServiceDisconnected is {
        send serviceDisconnected to outlet SubscriberEventSplitToSubscriberRepository
        send serviceDisconnected to outlet SubscriberEventSplitToSubscriberAnalytics
        tell serviceDisconnected to entity SubscriberContext.Subscriber
      }
      on accountCancelled: event Subscriber.AccountCancelled is {
        send accountCancelled to outlet SubscriberEventSplitToSubscriberRepository
        send accountCancelled to outlet SubscriberEventSplitToSubscriberAnalytics
        tell accountCancelled to entity SubscriberContext.Subscriber
      }
      on supportTicketCreated: event Subscriber.SupportTicketCreated is {
        send supportTicketCreated to outlet SubscriberEventSplitToSubscriberRepository
        send supportTicketCreated to outlet SubscriberEventSplitToSubscriberAnalytics
        tell supportTicketCreated to entity SubscriberContext.Subscriber
      }
      on other is {
        error "Unexpected message for processor SubscriberEventSplit"
      }
    } with {
      briefly "Subscriber event fan-out handler"
      described as {
        |Delivers each Subscriber event to all of its consumers.
      }
    }
  } with {
    briefly "Subscriber event fan-out"
    described as {
      |Fans Subscriber events out to the repository and projectors.
    }
  }
  connector 'SubscriberEvent Stream' is from outlet SubscriberContext.Subscriber.SubscriberEvents2 to inlet SubscriberContext.SubscriberEventSplit.SubscriberEventSplitIn with {
    briefly "Subscriber events, fanned out to storage and read models"
  }
  connector 'SubscriberEvent Storage' is from outlet SubscriberContext.SubscriberEventSplit.SubscriberEventSplitToSubscriberRepository to inlet SubscriberContext.SubscriberRepository.SubscriberRepositoryFromSubscriber with {
    briefly "Subscriber events on their way to storage"
  }
  connector 'SubscriberAnalytics Feed' is from outlet SubscriberContext.SubscriberEventSplit.SubscriberEventSplitToSubscriberAnalytics to inlet SubscriberContext.SubscriberAnalytics.SubscriberAnalyticsFromSubscriber with {
    briefly "Subscriber events feeding the SubscriberAnalytics projection"
  }
  connector 'SubscriberAnalytics Storage' is from outlet SubscriberContext.SubscriberAnalytics.SubscriberAnalyticsOut to inlet SubscriberContext.SubscriberRepository.SubscriberRepositoryFromSubscriberAnalytics with {
    briefly "The SubscriberAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for subscriber management"
  described as {
    |Telecom subscriber account context.
  }
}
