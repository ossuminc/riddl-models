// Subscriber Management - Subscriber Context
context SubscriberContext is {
  include "types.riddl"
  include "Subscriber.riddl"
  repository SubscriberRepository is {
    schema SubscriberData is relational
      of subscribers as type Subscriber
        index on field Subscriber.subscriberId
        index on field Subscriber.accountId
        index on field Subscriber.status
        index on field Subscriber.contactInfo.email

    handler SubscriberPersistence is {
      on command Subscriber.CreateSubscriber is {
        tell event Subscriber.SubscriberCreated to entity SubscriberContext.Subscriber
        prompt "Store new subscriber record"
      }
      on command Subscriber.AddServiceLine is {
        tell event Subscriber.ServiceLineAdded to entity SubscriberContext.Subscriber
        prompt "Store service line"
      }
      on command Subscriber.ActivateService is {
        prompt "Update line to active"
      }
      on command Subscriber.ChangePlan is {
        prompt "Update service plan"
      }
      on command Subscriber.SuspendService is {
        tell event Subscriber.ServiceSuspended to entity SubscriberContext.Subscriber
        prompt "Update subscriber to suspended"
      }
      on command Subscriber.CancelAccount is {
        tell event Subscriber.AccountCancelled to entity SubscriberContext.Subscriber
        prompt "Update subscriber to cancelled"
      }
    } with {
      briefly "Persists subscriber commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Subscriber data persistence"
    described as {
      |Persistent storage for subscribers.
    }
  }
  projector SubscriberAnalytics is {
    updates repository SubscriberContext.SubscriberRepository
    record SubscriberMetrics is  {
      totalSubscribers: Natural with {
        briefly "Total"
        described as {
          |Total subscribers.
        }
      }
      activeSubscribers: Natural with {
        briefly "Active"
        described as {
          |Active subscribers.
        }
      }
      newSubscribersThisMonth: Natural with {
        briefly "New"
        described as {
          |New this month.
        }
      }
      churnedThisMonth: Natural with {
        briefly "Churned"
        described as {
          |Churned this month.
        }
      }
      averageRevenuePerUser: Decimal(8,2) with {
        briefly "ARPU"
        described as {
          |Average revenue per user.
        }
      }
    } with {
      briefly "Subscriber metrics"
      described as {
        |Subscriber analytics.
      }
    }
    handler AnalyticsHandler is {
      on event Subscriber.SubscriberCreated is {
        tell event Subscriber.SubscriberCreated to repository SubscriberContext.SubscriberRepository
        prompt "Increment total and new subscriber counts"
      }
      on event Subscriber.AccountCancelled is {
        tell event Subscriber.AccountCancelled to repository SubscriberContext.SubscriberRepository
        prompt "Decrement active and increment churned"
      }
      on event Subscriber.PlanChanged is {
        tell event Subscriber.PlanChanged to repository SubscriberContext.SubscriberRepository
        prompt "Recalculate ARPU"
      }
    } with {
      briefly "Maintains subscriber analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Subscriber analytics"
    described as {
      |Subscriber metrics and KPIs.
    }
  }
  // ---- Event publication for Subscriber ----
  type SubscriberEvent is one of {
    SubscriberContext.Subscriber.SubscriberCreated,
    SubscriberContext.Subscriber.ServiceLineAdded,
    SubscriberContext.Subscriber.ServiceActivated,
    SubscriberContext.Subscriber.PlanChanged,
    SubscriberContext.Subscriber.DeviceAssigned,
    SubscriberContext.Subscriber.ContactUpdated,
    SubscriberContext.Subscriber.ServiceSuspended,
    SubscriberContext.Subscriber.ServiceResumed,
    SubscriberContext.Subscriber.ServiceDisconnected,
    SubscriberContext.Subscriber.AccountCancelled,
    SubscriberContext.Subscriber.SupportTicketCreated
  } with {
    briefly "Subscriber event alternation"
    described as {
      |Union of all Subscriber events, for streaming and event-sourced
      |persistence.
    }
  }
  processor SubscriberEventSource as source is {
    outlet SubscriberEvents is type SubscriberEvent
    handler SubscriberSourceHandler is {
      on event Subscriber.SubscriberCreated is {
        send event Subscriber.SubscriberCreated to outlet SubscriberEvents
      }
      on event Subscriber.ServiceLineAdded is {
        send event Subscriber.ServiceLineAdded to outlet SubscriberEvents
      }
      on event Subscriber.ServiceActivated is {
        send event Subscriber.ServiceActivated to outlet SubscriberEvents
      }
      on event Subscriber.PlanChanged is {
        send event Subscriber.PlanChanged to outlet SubscriberEvents
      }
      on event Subscriber.DeviceAssigned is {
        send event Subscriber.DeviceAssigned to outlet SubscriberEvents
      }
      on event Subscriber.ContactUpdated is {
        send event Subscriber.ContactUpdated to outlet SubscriberEvents
      }
      on event Subscriber.ServiceSuspended is {
        send event Subscriber.ServiceSuspended to outlet SubscriberEvents
      }
      on event Subscriber.ServiceResumed is {
        send event Subscriber.ServiceResumed to outlet SubscriberEvents
      }
      on event Subscriber.ServiceDisconnected is {
        send event Subscriber.ServiceDisconnected to outlet SubscriberEvents
      }
      on event Subscriber.AccountCancelled is {
        send event Subscriber.AccountCancelled to outlet SubscriberEvents
      }
      on event Subscriber.SupportTicketCreated is {
        send event Subscriber.SupportTicketCreated to outlet SubscriberEvents
      }
      on other is {
        error "Unexpected message for source SubscriberEventSource"
      }
    } with {
      briefly "Subscriber source handler"
      described as {
        |Publishes Subscriber events onto the outlet.
      }
    }
  } with {
    briefly "Subscriber event source"
    described as {
      |Publishes Subscriber entity events into the streaming topology.
    }
  }
  processor SubscriberEventSink as sink is {
    inlet SubscriberInlet is type SubscriberEvent
    handler SubscriberSinkHandler is {
      on event Subscriber.SubscriberCreated is {
        tell event Subscriber.SubscriberCreated to repository SubscriberContext.SubscriberRepository
      }
      on event Subscriber.ServiceLineAdded is {
        tell event Subscriber.ServiceLineAdded to repository SubscriberContext.SubscriberRepository
      }
      on event Subscriber.ServiceActivated is {
        tell event Subscriber.ServiceActivated to repository SubscriberContext.SubscriberRepository
      }
      on event Subscriber.PlanChanged is {
        tell event Subscriber.PlanChanged to repository SubscriberContext.SubscriberRepository
      }
      on event Subscriber.DeviceAssigned is {
        tell event Subscriber.DeviceAssigned to repository SubscriberContext.SubscriberRepository
      }
      on event Subscriber.ContactUpdated is {
        tell event Subscriber.ContactUpdated to repository SubscriberContext.SubscriberRepository
      }
      on event Subscriber.ServiceSuspended is {
        tell event Subscriber.ServiceSuspended to repository SubscriberContext.SubscriberRepository
      }
      on event Subscriber.ServiceResumed is {
        tell event Subscriber.ServiceResumed to repository SubscriberContext.SubscriberRepository
      }
      on event Subscriber.ServiceDisconnected is {
        tell event Subscriber.ServiceDisconnected to repository SubscriberContext.SubscriberRepository
      }
      on event Subscriber.AccountCancelled is {
        tell event Subscriber.AccountCancelled to repository SubscriberContext.SubscriberRepository
      }
      on event Subscriber.SupportTicketCreated is {
        tell event Subscriber.SupportTicketCreated to repository SubscriberContext.SubscriberRepository
      }
      on other is {
        error "Unexpected message for sink SubscriberEventSink"
      }
    } with {
      briefly "Subscriber sink handler"
      described as {
        |Persists Subscriber events via the repository.
      }
    }
  } with {
    briefly "Subscriber event sink"
    described as {
      |Receives Subscriber events for persistence.
    }
  }
  connector SubscriberEventFlow is {
    from outlet SubscriberContext.SubscriberEventSource.SubscriberEvents to
      inlet SubscriberContext.SubscriberEventSink.SubscriberInlet
  } with {
    briefly "Subscriber event flow"
    described as {
      |Connects the Subscriber source to its sink.
    }
  }
} with {
  briefly "Bounded context for subscriber management"
  described as {
    |Telecom subscriber account context.
  }
}
