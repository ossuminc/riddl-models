// Subscriber Management - Subscriber Context
context SubscriberContext as router is {
  inlet SubscriberContextFromToBillingSystem is command Subscriber.SuspendService with {
    briefly "What ToBillingSystem makes of the answers it gets"
  }
  connector 'ToBillingSystem Intake' is from outlet SubscriberContext.ToBillingSystem.ToBillingSystemToSubscriberContext to inlet SubscriberContext.SubscriberContextFromToBillingSystem with {
    briefly "Answers translated by ToBillingSystem, on their way in"
  }
  inlet SubscriberContextFromToCRMSystem is command Subscriber.CreateSupportTicket with {
    briefly "What ToCRMSystem makes of the answers it gets"
  }
  connector 'ToCRMSystem Intake' is from outlet SubscriberContext.ToCRMSystem.ToCRMSystemToSubscriberContext to inlet SubscriberContext.SubscriberContextFromToCRMSystem with {
    briefly "Answers translated by ToCRMSystem, on their way in"
  }
  inlet SubscriberContextFromNetworkProvisioning is command Subscriber.ActivateService with {
    briefly "What FromNetworkProvisioning makes of that service's news"
  }
  connector 'FromNetworkProvisioning Intake' is from outlet SubscriberContext.FromNetworkProvisioning.FromNetworkProvisioningToSubscriberContext to inlet SubscriberContext.SubscriberContextFromNetworkProvisioning with {
    briefly "What FromNetworkProvisioning makes of that news, on its way in"
  }
  inlet SubscriberCommandStreamIn is type SubscriberCommand  outlet SubscriberCommandStreamOut is type SubscriberCommand
  inlet SubscriberResultStreamIn is result Subscriber.SubscriberResult  outlet SubscriberResultStreamOut is result Subscriber.SubscriberResult
  handler SubscriberContextBoundary is {
    on createSubscriber: command Subscriber.CreateSubscriber is {
      send createSubscriber to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on addServiceLine: command Subscriber.AddServiceLine is {
      send addServiceLine to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on activateService: command Subscriber.ActivateService is {
      send activateService to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on changePlan: command Subscriber.ChangePlan is {
      send changePlan to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on assignDevice: command Subscriber.AssignDevice is {
      send assignDevice to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on updateContact: command Subscriber.UpdateContact is {
      send updateContact to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on suspendService: command Subscriber.SuspendService is {
      send suspendService to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on resumeService: command Subscriber.ResumeService is {
      send resumeService to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on disconnectService: command Subscriber.DisconnectService is {
      send disconnectService to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on cancelAccount: command Subscriber.CancelAccount is {
      send cancelAccount to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on createSupportTicket: command Subscriber.CreateSupportTicket is {
      send createSupportTicket to outlet SubscriberContext.SubscriberCommandStreamOut
    }
    on subscriberResult: result Subscriber.SubscriberResult is {
      send subscriberResult to outlet SubscriberContext.SubscriberResultStreamOut
    }
    on other is {
      error "Unexpected message at the SubscriberContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'SubscriberCommand Stream Intake' is from outlet SubscriberContext.SubscriberCommandStreamOut to inlet SubscriberContext.Subscriber.SubscriberCommands  connector 'SubscriberResult Stream Egress' is from outlet SubscriberContext.SubscriberRepository.SubscriberRepositoryResponses to inlet SubscriberContext.SubscriberResultStreamIn  adaptor FromBillingSystem from context BillingSystem as sink is { 
    inlet FromBillingSystemIn is event BillingSystem.BillingAccountCreated    handler FromBillingSystemHandler is {
      on billingAccountCreated: event BillingSystem.BillingAccountCreated is {
        do "billing has the account; creating the subscriber was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingSystem"
      }
    } with {
      briefly "from billing system"
      described as {
        |Carries messages from the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor ToBillingSystem to context BillingSystem as router is { 
    outlet ToBillingSystemToSubscriberContext is command Subscriber.SuspendService
    inlet ToBillingSystemIn is type SubscriberEvent    inlet ToBillingSystemReplies is result BillingSystem.AccountBalance    outlet ToBillingSystemOut is type BillingSystem.BillingSystemCommand
    handler ToBillingSystemHandler is {
      on subscriberCreated: event Subscriber.SubscriberCreated is {
        let account: type BillingSystem.CreateBillingAccount = prompt("translate the subscriberCreated event into a CreateBillingAccount for the subscriber whose relationship with us has just begun")
        send account to outlet SubscriberContext.ToBillingSystem.ToBillingSystemOut
      }
      on serviceActivated: event Subscriber.ServiceActivated is {
        let notice: type BillingSystem.AddCharges = prompt("translate the serviceActivated event into an AddCharges billing the subscriber for the service that has just started accruing")
        send notice to outlet SubscriberContext.ToBillingSystem.ToBillingSystemOut
      }
      on planChanged: event Subscriber.PlanChanged is {
        let notice: type BillingSystem.AddCharges = prompt("translate the planChanged event into an AddCharges billing the difference the subscriber has committed to by moving plans")
        send notice to outlet SubscriberContext.ToBillingSystem.ToBillingSystemOut
      }
      on supportTicketCreated: event Subscriber.SupportTicketCreated is {
        let askAnswer: type BillingSystem.AccountBalance = ask query BillingSystem.GetAccountBalance of context BillingSystem
        do "an agent needing what the subscriber owes before they talk"
        when prompt("askAnswer.pastDueAmount is greater than zero") then
          send command Subscriber.SuspendService(subscriberId = supportTicketCreated.subscriberId, reason = prompt("past due askAnswer.pastDueAmount"), suspendedAt = prompt("now")) to outlet SubscriberContext.ToBillingSystem.ToBillingSystemToSubscriberContext
        end
      }
      on other is {
        error "Unexpected message for adaptor ToBillingSystem"
      }
    } with {
      briefly "to billing system"
      described as {
        |Carries messages to the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor ToCRMSystem to context CRMSystem as router is { 
    outlet ToCRMSystemToSubscriberContext is command Subscriber.CreateSupportTicket
    inlet ToCRMSystemIn is type SubscriberEvent    inlet ToCRMSystemReplies is result CRMSystem.CustomerHistory    outlet ToCRMSystemOut is type CRMSystem.CRMSystemCommand
    handler ToCRMSystemHandler is {
      on subscriberCreated: event Subscriber.SubscriberCreated is {
        let item0: type CRMSystem.CreateCustomerRecord = prompt("translate the subscriberCreated event into a CreateCustomerRecord, a new subscriber being a customer the CRM does not yet hold")
        send item0 to outlet SubscriberContext.ToCRMSystem.ToCRMSystemOut
      }
      on supportTicketCreated: event Subscriber.SupportTicketCreated is {
        let askAnswer: type CRMSystem.CustomerHistory = ask query CRMSystem.GetCustomerHistory of context CRMSystem
        do "and what has happened to them before"
        when prompt("the ticket lacked the customer's history") then
          send command Subscriber.CreateSupportTicket(subscriberId = supportTicketCreated.subscriberId, ticket = prompt("the ticket annotated with askAnswer.totalInteractions prior contacts and satisfaction askAnswer.satisfactionScore")) to outlet SubscriberContext.ToCRMSystem.ToCRMSystemToSubscriberContext
        end
        let item0: type CRMSystem.LogInteraction = prompt("translate the supportTicketCreated event into a LogInteraction, a support contact being the interaction the CRM must reflect")
        send item0 to outlet SubscriberContext.ToCRMSystem.ToCRMSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToCRMSystem"
      }
    } with {
      briefly "to crm system"
      described as {
        |Carries messages to the external CRMSystem.
      }
    }
  } with {
    briefly "CRMSystem integration"
    described as {
      |The model's side of the CRMSystem conversation.
    }
  }
  adaptor FromDeviceManagement from context DeviceManagement as sink is { 
    inlet FromDeviceManagementIn is event DeviceManagement.DeviceRegistered    handler FromDeviceManagementHandler is {
      on deviceRegistered: event DeviceManagement.DeviceRegistered is {
        do "the device is registered; assigning it was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromDeviceManagement"
      }
    } with {
      briefly "from device management"
      described as {
        |Carries messages from the external DeviceManagement.
      }
    }
  } with {
    briefly "DeviceManagement integration"
    described as {
      |The model's side of the DeviceManagement conversation.
    }
  }
  adaptor ToDeviceManagement to context DeviceManagement as flow is { 
    inlet ToDeviceManagementIn is type SubscriberEvent    outlet ToDeviceManagementOut is type DeviceManagement.DeviceManagementCommand
    handler ToDeviceManagementHandler is {
      on deviceAssigned: event Subscriber.DeviceAssigned is {
        let item0: type DeviceManagement.RegisterDevice = prompt("translate the deviceAssigned event into a RegisterDevice, assignment being when the network must know the handset")
        send item0 to outlet SubscriberContext.ToDeviceManagement.ToDeviceManagementOut
        let item1: type DeviceManagement.ActivateSIM = prompt("translate the deviceAssigned event into a ActivateSIM, and when its SIM must be turned on")
        send item1 to outlet SubscriberContext.ToDeviceManagement.ToDeviceManagementOut
      }
      on other is {
        error "Unexpected message for adaptor ToDeviceManagement"
      }
    } with {
      briefly "to device management"
      described as {
        |Carries messages to the external DeviceManagement.
      }
    }
  } with {
    briefly "DeviceManagement integration"
    described as {
      |The model's side of the DeviceManagement conversation.
    }
  }
  adaptor FromNetworkProvisioning from context NetworkProvisioning as flow is { 
    inlet FromNetworkProvisioningIn is event NetworkProvisioning.ServiceProvisioned    outlet FromNetworkProvisioningToSubscriberContext is command Subscriber.ActivateService
    handler FromNetworkProvisioningHandler is {
      on serviceProvisioned: event NetworkProvisioning.ServiceProvisioned is {
        let item0: type Subscriber.ActivateService = prompt("translate the serviceProvisioned event into a ActivateService, a service the network has provisioned is the one activated on the subscriber")
        send item0 to outlet SubscriberContext.FromNetworkProvisioning.FromNetworkProvisioningToSubscriberContext
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkProvisioning"
      }
    } with {
      briefly "from network provisioning"
      described as {
        |Carries messages from the external NetworkProvisioning.
      }
    }
  } with {
    briefly "NetworkProvisioning integration"
    described as {
      |The model's side of the NetworkProvisioning conversation.
    }
  }
  adaptor ToNetworkProvisioning to context NetworkProvisioning as flow is { 
    inlet ToNetworkProvisioningIn is type SubscriberEvent    outlet ToNetworkProvisioningOut is type NetworkProvisioning.NetworkProvisioningCommand
    handler ToNetworkProvisioningHandler is {
      on serviceLineAdded: event Subscriber.ServiceLineAdded is {
        let item0: type NetworkProvisioning.ProvisionService = prompt("translate the serviceLineAdded event into a ProvisionService, a new line being what the network must be told to carry")
        send item0 to outlet SubscriberContext.ToNetworkProvisioning.ToNetworkProvisioningOut
      }
      on serviceDisconnected: event Subscriber.ServiceDisconnected is {
        let item0: type NetworkProvisioning.DeprovisionService = prompt("translate the serviceDisconnected event into a DeprovisionService, disconnection being what it must be told to stop")
        send item0 to outlet SubscriberContext.ToNetworkProvisioning.ToNetworkProvisioningOut
      }
      on other is {
        error "Unexpected message for adaptor ToNetworkProvisioning"
      }
    } with {
      briefly "to network provisioning"
      described as {
        |Carries messages to the external NetworkProvisioning.
      }
    }
  } with {
    briefly "NetworkProvisioning integration"
    described as {
      |The model's side of the NetworkProvisioning conversation.
    }
  }
  include "types.riddl"
  include "Subscriber.riddl"
  type SubscriberRepositoryCommand is one of {
    SubscriberContext.SubscriberRepository.PersistAccountCancelled or SubscriberContext.SubscriberRepository.PersistContactUpdated or SubscriberContext.SubscriberRepository.PersistDeviceAssigned or SubscriberContext.SubscriberRepository.PersistPlanChanged or SubscriberContext.SubscriberRepository.PersistServiceActivated or SubscriberContext.SubscriberRepository.PersistServiceDisconnected or SubscriberContext.SubscriberRepository.PersistServiceLineAdded or SubscriberContext.SubscriberRepository.PersistServiceResumed or SubscriberContext.SubscriberRepository.PersistServiceSuspended or SubscriberContext.SubscriberRepository.PersistSubscriberCreated or SubscriberContext.SubscriberRepository.PersistSupportTicketCreated
  } with {
    briefly "Anything that writes SubscriberRepository"
    described as {
      |The persistence commands SubscriberRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository SubscriberRepository as flow is {
    inlet SubscriberRepositoryFromSubscriberAnalytics is type SubscriberRepositoryCommand    command PersistContactUpdated is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContactUpdated applies to.
        }
      }
      contactInfo: ContactInfo? with {
        briefly "Contact info"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ContactUpdated"
      described as {
        |Instructs this repository to apply ContactUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeviceAssigned is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeviceAssigned applies to.
        }
      }
      lineId: ServiceLineId? with {
        briefly "Line id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      device: DeviceInfo? with {
        briefly "Device"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DeviceAssigned"
      described as {
        |Instructs this repository to apply DeviceAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceActivated is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceActivated applies to.
        }
      }
      lineId: ServiceLineId? with {
        briefly "Line id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ServiceActivated"
      described as {
        |Instructs this repository to apply ServiceActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceDisconnected is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceDisconnected applies to.
        }
      }
      lineId: ServiceLineId? with {
        briefly "Line id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      disconnectedAt: TimeStamp? with {
        briefly "Disconnected at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ServiceDisconnected"
      described as {
        |Instructs this repository to apply ServiceDisconnected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceLineAdded is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceLineAdded applies to.
        }
      }
      serviceLine: ServiceLine? with {
        briefly "Service line"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ServiceLineAdded"
      described as {
        |Instructs this repository to apply ServiceLineAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceResumed is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceResumed applies to.
        }
      }
      resumedAt: TimeStamp? with {
        briefly "Resumed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ServiceResumed"
      described as {
        |Instructs this repository to apply ServiceResumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceSuspended is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceSuspended applies to.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      suspendedAt: TimeStamp? with {
        briefly "Suspended at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ServiceSuspended"
      described as {
        |Instructs this repository to apply ServiceSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSupportTicketCreated is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row SupportTicketCreated applies to.
        }
      }
      ticket: SupportTicket? with {
        briefly "Ticket"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SupportTicketCreated"
      described as {
        |Instructs this repository to apply SupportTicketCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountCancelled is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountCancelled applies to.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist AccountCancelled"
      described as {
        |Instructs this repository to apply AccountCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlanChanged is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlanChanged applies to.
        }
      }
      lineId: ServiceLineId? with {
        briefly "Line id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newPlan: ServicePlan? with {
        briefly "New plan"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      effectiveDate: Date? with {
        briefly "Effective date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PlanChanged"
      described as {
        |Instructs this repository to apply PlanChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubscriberCreated is {
      subscriberId: SubscriberId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubscriberCreated applies to.
        }
      }
      accountId: AccountId? with {
        briefly "Account id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      accountType: AccountType? with {
        briefly "Account type"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SubscriberCreated"
      described as {
        |Instructs this repository to apply SubscriberCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet SubscriberRepositoryResponses is result Subscriber.SubscriberResult
    record StoredSubscriber is {
      subscriberId: SubscriberId with {
        briefly "subscriberId"
        described as {
          |The subscriberId column of the stored subscriber row.
        }
      }
      accountId: AccountId with {
        briefly "accountId"
        described as {
          |The accountId column of the stored subscriber row.
        }
      }
      contactInfo: ContactInfo with {
        briefly "contactInfo"
        described as {
          |The contactInfo column of the stored subscriber row.
        }
      }
      status: SubscriberStatus with {
        briefly "status"
        described as {
          |The status column of the stored subscriber row.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      lineId: ServiceLineId? with {
        briefly "Line id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      device: DeviceInfo? with {
        briefly "Device"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      disconnectedAt: TimeStamp? with {
        briefly "Disconnected at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      serviceLine: ServiceLine? with {
        briefly "Service line"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      resumedAt: TimeStamp? with {
        briefly "Resumed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      suspendedAt: TimeStamp? with {
        briefly "Suspended at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      ticket: SupportTicket? with {
        briefly "Ticket"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newPlan: ServicePlan? with {
        briefly "New plan"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      effectiveDate: Date? with {
        briefly "Effective date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      accountType: AccountType? with {
        briefly "Account type"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored subscriber row"
      described as {
        |The persistence shape of subscriber data as this repository stores it.
      }
    }
    schema SubscriberData is relational
      of subscribers as record StoredSubscriber
        key on field StoredSubscriber.subscriberId
        index on field StoredSubscriber.accountId
        index on field StoredSubscriber.status
        index on field StoredSubscriber.contactInfo.email
 with {
      briefly "Subscriber data schema"
      described as {
        |The relational schema holding subscriber data for the SubscriberRepository.
      }
    }
    handler SubscriberPersistence is {
      on persistContactUpdated: command PersistContactUpdated is {
        update SubscriberData.subscribers set contactInfo = persistContactUpdated.contactInfo, updatedAt = persistContactUpdated.updatedAt where subscriberId == persistContactUpdated.subscriberId
      }
      on persistDeviceAssigned: command PersistDeviceAssigned is {
        update SubscriberData.subscribers set lineId = persistDeviceAssigned.lineId, device = persistDeviceAssigned.device, assignedAt = persistDeviceAssigned.assignedAt where subscriberId == persistDeviceAssigned.subscriberId
      }
      on persistServiceActivated: command PersistServiceActivated is {
        update SubscriberData.subscribers set lineId = persistServiceActivated.lineId, activatedAt = persistServiceActivated.activatedAt where subscriberId == persistServiceActivated.subscriberId
      }
      on persistServiceDisconnected: command PersistServiceDisconnected is {
        update SubscriberData.subscribers set lineId = persistServiceDisconnected.lineId, reason = persistServiceDisconnected.reason, disconnectedAt = persistServiceDisconnected.disconnectedAt where subscriberId == persistServiceDisconnected.subscriberId
      }
      on persistServiceLineAdded: command PersistServiceLineAdded is {
        update SubscriberData.subscribers set serviceLine = persistServiceLineAdded.serviceLine, addedAt = persistServiceLineAdded.addedAt where subscriberId == persistServiceLineAdded.subscriberId
      }
      on persistServiceResumed: command PersistServiceResumed is {
        update SubscriberData.subscribers set resumedAt = persistServiceResumed.resumedAt where subscriberId == persistServiceResumed.subscriberId
      }
      on persistServiceSuspended: command PersistServiceSuspended is {
        update SubscriberData.subscribers set reason = persistServiceSuspended.reason, suspendedAt = persistServiceSuspended.suspendedAt where subscriberId == persistServiceSuspended.subscriberId
      }
      on persistSupportTicketCreated: command PersistSupportTicketCreated is {
        update SubscriberData.subscribers set ticket = persistSupportTicketCreated.ticket where subscriberId == persistSupportTicketCreated.subscriberId
      }
      on persistAccountCancelled: command PersistAccountCancelled is {
        update SubscriberData.subscribers set reason = persistAccountCancelled.reason, cancelledAt = persistAccountCancelled.cancelledAt where subscriberId == persistAccountCancelled.subscriberId
      }
      on persistPlanChanged: command PersistPlanChanged is {
        update SubscriberData.subscribers set lineId = persistPlanChanged.lineId, newPlan = persistPlanChanged.newPlan, effectiveDate = persistPlanChanged.effectiveDate where subscriberId == persistPlanChanged.subscriberId
      }
      on persistSubscriberCreated: command PersistSubscriberCreated is {
        update SubscriberData.subscribers set accountId = persistSubscriberCreated.accountId, accountType = persistSubscriberCreated.accountType, createdAt = persistSubscriberCreated.createdAt where subscriberId == persistSubscriberCreated.subscriberId
      }
      on query GetSubscriberMetrics is {
        let subscriberMetricsView: type SubscriberMetricsView = prompt("read the subscriber metrics projection")
        reply subscriberMetricsView
      }
    } with {
      briefly "Persists subscriber commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Subscriber data persistence"
    described as {
      |Persistent storage for subscribers.
    }
  }
  query GetSubscriberMetrics replies result SubscriberMetricsView is {
    subscriberMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which subscriber metrics to retrieve.
      }
    }
  } with {
    briefly "Get subscriber metrics"
    described as {
      |Retrieves the subscriber metrics projection.
    }
  }
  result SubscriberMetricsView is {
    subscriberMetrics: SubscriberAnalytics.SubscriberMetrics with {
      briefly "Subscriber metrics"
      described as {
        |The subscriber metrics being returned.
      }
    }
  } with {
    briefly "Subscriber metrics view"
    described as {
      |Read model view carrying the subscriber metrics projection.
    }
  }
  projector SubscriberAnalytics as flow is {
    updates repository SubscriberContext.SubscriberRepository
    outlet SubscriberAnalyticsToRepository is type SubscriberRepositoryCommand
    inlet SubscriberAnalyticsFromSubscriber is type SubscriberEvent    record SubscriberMetrics is {
      totalSubscribers: Natural with {
        briefly "Total"
        described as {
          |Total subscribers.
        }
      }
      activeSubscribers: Natural with {
        briefly "Active"
        described as {
          |Active subscribers.
        }
      }
      newSubscribersThisMonth: Natural with {
        briefly "New"
        described as {
          |New this month.
        }
      }
      churnedThisMonth: Natural with {
        briefly "Churned"
        described as {
          |Churned this month.
        }
      }
      averageRevenuePerUser: Decimal(8,2) with {
        briefly "ARPU"
        described as {
          |Average revenue per user.
        }
      }
    } with {
      briefly "Subscriber metrics"
      described as {
        |Subscriber analytics.
      }
    }
    handler AnalyticsHandler is {
      on contactUpdated: event Subscriber.ContactUpdated is {
        tell command SubscriberContext.SubscriberRepository.PersistContactUpdated(subscriberId = contactUpdated.subscriberId, contactInfo = contactUpdated.contactInfo, updatedAt = contactUpdated.updatedAt) to repository SubscriberContext.SubscriberRepository
        do "apply ContactUpdated to the SubscriberAnalytics projection"
      }
      on deviceAssigned: event Subscriber.DeviceAssigned is {
        tell command SubscriberContext.SubscriberRepository.PersistDeviceAssigned(subscriberId = deviceAssigned.subscriberId, lineId = deviceAssigned.lineId, device = deviceAssigned.device, assignedAt = deviceAssigned.assignedAt) to repository SubscriberContext.SubscriberRepository
        do "apply DeviceAssigned to the SubscriberAnalytics projection"
      }
      on serviceActivated: event Subscriber.ServiceActivated is {
        tell command SubscriberContext.SubscriberRepository.PersistServiceActivated(subscriberId = serviceActivated.subscriberId, lineId = serviceActivated.lineId, activatedAt = serviceActivated.activatedAt) to repository SubscriberContext.SubscriberRepository
        do "apply ServiceActivated to the SubscriberAnalytics projection"
      }
      on serviceDisconnected: event Subscriber.ServiceDisconnected is {
        tell command SubscriberContext.SubscriberRepository.PersistServiceDisconnected(subscriberId = serviceDisconnected.subscriberId, lineId = serviceDisconnected.lineId, reason = serviceDisconnected.reason, disconnectedAt = serviceDisconnected.disconnectedAt) to repository SubscriberContext.SubscriberRepository
        do "apply ServiceDisconnected to the SubscriberAnalytics projection"
      }
      on serviceLineAdded: event Subscriber.ServiceLineAdded is {
        tell command SubscriberContext.SubscriberRepository.PersistServiceLineAdded(subscriberId = serviceLineAdded.subscriberId, serviceLine = serviceLineAdded.serviceLine, addedAt = serviceLineAdded.addedAt) to repository SubscriberContext.SubscriberRepository
        do "apply ServiceLineAdded to the SubscriberAnalytics projection"
      }
      on serviceResumed: event Subscriber.ServiceResumed is {
        tell command SubscriberContext.SubscriberRepository.PersistServiceResumed(subscriberId = serviceResumed.subscriberId, resumedAt = serviceResumed.resumedAt) to repository SubscriberContext.SubscriberRepository
        do "apply ServiceResumed to the SubscriberAnalytics projection"
      }
      on serviceSuspended: event Subscriber.ServiceSuspended is {
        tell command SubscriberContext.SubscriberRepository.PersistServiceSuspended(subscriberId = serviceSuspended.subscriberId, reason = serviceSuspended.reason, suspendedAt = serviceSuspended.suspendedAt) to repository SubscriberContext.SubscriberRepository
        do "apply ServiceSuspended to the SubscriberAnalytics projection"
      }
      on supportTicketCreated: event Subscriber.SupportTicketCreated is {
        tell command SubscriberContext.SubscriberRepository.PersistSupportTicketCreated(subscriberId = supportTicketCreated.subscriberId, ticket = supportTicketCreated.ticket) to repository SubscriberContext.SubscriberRepository
        do "apply SupportTicketCreated to the SubscriberAnalytics projection"
      }
      on subscriberCreated: event Subscriber.SubscriberCreated is {
        tell command SubscriberContext.SubscriberRepository.PersistSubscriberCreated(subscriberId = subscriberCreated.subscriberId, accountId = subscriberCreated.accountId, accountType = subscriberCreated.accountType, createdAt = subscriberCreated.createdAt) to repository SubscriberContext.SubscriberRepository
        do "Increment total and new subscriber counts"
      }
      on accountCancelled: event Subscriber.AccountCancelled is {
        tell command SubscriberContext.SubscriberRepository.PersistAccountCancelled(subscriberId = accountCancelled.subscriberId, reason = accountCancelled.reason, cancelledAt = accountCancelled.cancelledAt) to repository SubscriberContext.SubscriberRepository
        do "Decrement active and increment churned"
      }
      on planChanged: event Subscriber.PlanChanged is {
        tell command SubscriberContext.SubscriberRepository.PersistPlanChanged(subscriberId = planChanged.subscriberId, lineId = planChanged.lineId, newPlan = planChanged.newPlan, effectiveDate = planChanged.effectiveDate) to repository SubscriberContext.SubscriberRepository
        do "Recalculate ARPU"
      }
    } with {
      briefly "Maintains subscriber analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Subscriber analytics"
    described as {
      |Subscriber metrics and KPIs.
    }
  }
  // ---- Event publication for Subscriber ----
  type SubscriberEvent is one of {
    SubscriberContext.Subscriber.SubscriberCreated or SubscriberContext.Subscriber.ServiceLineAdded or SubscriberContext.Subscriber.ServiceActivated or SubscriberContext.Subscriber.PlanChanged or SubscriberContext.Subscriber.DeviceAssigned or SubscriberContext.Subscriber.ContactUpdated or SubscriberContext.Subscriber.ServiceSuspended or SubscriberContext.Subscriber.ServiceResumed or SubscriberContext.Subscriber.ServiceDisconnected or SubscriberContext.Subscriber.AccountCancelled or SubscriberContext.Subscriber.SupportTicketCreated
  } with {
    briefly "Subscriber event alternation"
    described as {
      |Union of all Subscriber events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet SubscriberEventSplit as split is {
    outlet SubscriberEventSplitToToNetworkProvisioning is type SubscriberEvent
    outlet SubscriberEventSplitToToDeviceManagement is type SubscriberEvent
    outlet SubscriberEventSplitToToCRMSystem is type SubscriberEvent
    outlet SubscriberEventSplitToToBillingSystem is type SubscriberEvent
    inlet SubscriberEventSplitIn is type SubscriberEvent    outlet SubscriberEventSplitToSubscriberAnalytics is type SubscriberEvent
    handler SubscriberEventSplitHandler is {
      on subscriberCreated: event Subscriber.SubscriberCreated is {
        send subscriberCreated to outlet SubscriberEventSplitToSubscriberAnalytics
        send subscriberCreated to outlet SubscriberEventSplitToToCRMSystem
        send subscriberCreated to outlet SubscriberEventSplitToToBillingSystem
        tell subscriberCreated to entity SubscriberContext.Subscriber
      }
      on serviceLineAdded: event Subscriber.ServiceLineAdded is {
        send serviceLineAdded to outlet SubscriberEventSplitToSubscriberAnalytics
        send serviceLineAdded to outlet SubscriberEventSplitToToNetworkProvisioning
        tell serviceLineAdded to entity SubscriberContext.Subscriber
      }
      on serviceActivated: event Subscriber.ServiceActivated is {
        send serviceActivated to outlet SubscriberEventSplitToSubscriberAnalytics
        send serviceActivated to outlet SubscriberEventSplitToToBillingSystem
        tell serviceActivated to entity SubscriberContext.Subscriber
      }
      on planChanged: event Subscriber.PlanChanged is {
        send planChanged to outlet SubscriberEventSplitToSubscriberAnalytics
        send planChanged to outlet SubscriberEventSplitToToBillingSystem
        tell planChanged to entity SubscriberContext.Subscriber
      }
      on deviceAssigned: event Subscriber.DeviceAssigned is {
        send deviceAssigned to outlet SubscriberEventSplitToSubscriberAnalytics
        send deviceAssigned to outlet SubscriberEventSplitToToDeviceManagement
        tell deviceAssigned to entity SubscriberContext.Subscriber
      }
      on contactUpdated: event Subscriber.ContactUpdated is {
        send contactUpdated to outlet SubscriberEventSplitToSubscriberAnalytics
        tell contactUpdated to entity SubscriberContext.Subscriber
      }
      on serviceSuspended: event Subscriber.ServiceSuspended is {
        send serviceSuspended to outlet SubscriberEventSplitToSubscriberAnalytics
        tell serviceSuspended to entity SubscriberContext.Subscriber
      }
      on serviceResumed: event Subscriber.ServiceResumed is {
        send serviceResumed to outlet SubscriberEventSplitToSubscriberAnalytics
        tell serviceResumed to entity SubscriberContext.Subscriber
      }
      on serviceDisconnected: event Subscriber.ServiceDisconnected is {
        send serviceDisconnected to outlet SubscriberEventSplitToSubscriberAnalytics
        send serviceDisconnected to outlet SubscriberEventSplitToToNetworkProvisioning
        tell serviceDisconnected to entity SubscriberContext.Subscriber
      }
      on accountCancelled: event Subscriber.AccountCancelled is {
        send accountCancelled to outlet SubscriberEventSplitToSubscriberAnalytics
        tell accountCancelled to entity SubscriberContext.Subscriber
      }
      on supportTicketCreated: event Subscriber.SupportTicketCreated is {
        send supportTicketCreated to outlet SubscriberEventSplitToSubscriberAnalytics
        send supportTicketCreated to outlet SubscriberEventSplitToToCRMSystem
        send supportTicketCreated to outlet SubscriberEventSplitToToBillingSystem
        tell supportTicketCreated to entity SubscriberContext.Subscriber
      }
      on other is {
        error "Unexpected message for processor SubscriberEventSplit"
      }
    } with {
      briefly "Subscriber event fan-out handler"
      described as {
        |Delivers each Subscriber event to all of its consumers.
      }
    }
  } with {
    briefly "Subscriber event fan-out"
    described as {
      |Fans Subscriber events out to the repository and projectors.
    }
  }
  connector 'ToNetworkProvisioning Feed' is from outlet SubscriberContext.SubscriberEventSplit.SubscriberEventSplitToToNetworkProvisioning to inlet SubscriberContext.ToNetworkProvisioning.ToNetworkProvisioningIn with {
    briefly "The Subscriber events ToNetworkProvisioning translates, on their way to it"
  }
  connector 'ToDeviceManagement Feed' is from outlet SubscriberContext.SubscriberEventSplit.SubscriberEventSplitToToDeviceManagement to inlet SubscriberContext.ToDeviceManagement.ToDeviceManagementIn with {
    briefly "The Subscriber events ToDeviceManagement translates, on their way to it"
  }
  connector 'ToCRMSystem Feed' is from outlet SubscriberContext.SubscriberEventSplit.SubscriberEventSplitToToCRMSystem to inlet SubscriberContext.ToCRMSystem.ToCRMSystemIn with {
    briefly "The Subscriber events ToCRMSystem translates, on their way to it"
  }
  connector 'ToBillingSystem Feed' is from outlet SubscriberContext.SubscriberEventSplit.SubscriberEventSplitToToBillingSystem to inlet SubscriberContext.ToBillingSystem.ToBillingSystemIn with {
    briefly "The Subscriber events ToBillingSystem translates, on their way to it"
  }
  connector 'SubscriberEvent Stream' is from outlet SubscriberContext.Subscriber.SubscriberEvents2 to inlet SubscriberContext.SubscriberEventSplit.SubscriberEventSplitIn with {
    briefly "Subscriber events, fanned out to storage and read models"
  }
  connector 'SubscriberAnalytics Feed' is from outlet SubscriberContext.SubscriberEventSplit.SubscriberEventSplitToSubscriberAnalytics to inlet SubscriberContext.SubscriberAnalytics.SubscriberAnalyticsFromSubscriber with {
    briefly "Subscriber events feeding the SubscriberAnalytics projection"
  }
  connector 'SubscriberAnalytics Storage' is from outlet SubscriberContext.SubscriberAnalytics.SubscriberAnalyticsToRepository to inlet SubscriberContext.SubscriberRepository.SubscriberRepositoryFromSubscriberAnalytics with {
    briefly "SubscriberAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for subscriber management"
  described as {
    |Telecom subscriber account context.
  }
}
