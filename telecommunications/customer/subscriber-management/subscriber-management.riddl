// Subscriber Management Domain Model
// Telecom customer and subscription management
domain SubscriberManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user CustomerServiceRep is "person handling customer requests" with {
    briefly "Customer Service Rep"
    described as {
      |Representative assisting subscribers.
    }
  }
  user AccountManager is "person managing business accounts" with {
    briefly "Account Manager"
    described as {
      |Manager overseeing account relationships.
    }
  }
  user SubscriberUser is "person using telecom services" with {
    briefly "Subscriber"
    described as {
      |Customer with active subscription.
    }
  }
  epic SubscriberLifecycleManagement is {
    user CustomerServiceRep wants to "to manage subscriber accounts" so that "customers have great service experiences"
    case OnboardNewSubscriber is {
      user CustomerServiceRep wants to "to onboard new subscribers" so that "customers can start using services"
      step is "Rep creates" "subscriber account" "with profile" with {
        briefly "Create account"
        described as {
          |Set up subscriber.
        }
      }
      step is "System provisions" "services and devices" "for subscriber" with {
        briefly "Provision services"
        described as {
          |Activate services.
        }
      }
    } with {
      briefly "Onboard new subscriber"
      described as {
        |Setting up new customers.
      }
    }
  } with {
    briefly "Subscriber lifecycle management"
    described as {
      |Epic for subscriber operations.
    }
  }
  include "SubscriberContext.riddl"
  include "external-contexts.riddl"
  application context SubscriberManagementApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in SubscriberManagement are delivered.
      }
    }
    outlet AppSubscriberCommands is type SubscriberContext.Subscriber.SubscriberCommand
    inlet AppSubscriberRepositoryResponses is type SubscriberContext.Subscriber.SubscriberResult    handler SubscriberManagementAppHandler is {
      on other is {
        error "Unexpected message for application context SubscriberManagementApp"
      }
    } with {
      briefly "SubscriberManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "SubscriberManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'SubscriberCommand Stream' is from outlet SubscriberManagementApp.AppSubscriberCommands to inlet SubscriberContext.Subscriber.SubscriberCommands with {
    briefly "Subscriber commands from the application"
  }
  persistent connector 'SubscriberResult Stream' is from outlet SubscriberContext.SubscriberRepository.SubscriberRepositoryResponses to inlet SubscriberManagementApp.AppSubscriberRepositoryResponses with {
    briefly "Subscriber query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet SubscriberManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Subscriber management domain"
  described as {
    |Telecom subscriber account management.
  }
}
