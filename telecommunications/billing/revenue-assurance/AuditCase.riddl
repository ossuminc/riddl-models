// Revenue Assurance - AuditCase Entity
entity AuditCase as flow is {
  type AuditCaseCommand is one of {
    AuditCase.OpenAuditCase or AuditCase.ReconcileRecords or AuditCase.RecordDiscrepancy or AuditCase.EscalateCase or AuditCase.ResolveCase or AuditCase.CloseCase or AuditCase.CancelCase
  } with {
    briefly "AuditCase command alternation"
    described as {
      |Commands accepted by the AuditCase entity.
    }
  }
  inlet AuditCaseCommands is type AuditCaseCommand  outlet AuditCaseEvents2 is type AuditCaseEvent
  query GetAuditCase replies result AuditCaseResult is {
    auditCaseId: AuditCaseId with {
      briefly "ID"
      described as {
        |Identifier of the AuditCase to retrieve.
      }
    }
  } with {
    briefly "Get AuditCase"
    described as {
      |Retrieve AuditCase data by identifier.
    }
  }
  result AuditCaseResult is  {
    auditCaseId: AuditCaseId with {
      briefly "AuditCase addressed"
      described as {
        |Which auditcase this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    auditCaseData: AuditCase.ActiveCaseData with {
      briefly "AuditCase data"
      described as {
        |The requested AuditCase data.
      }
    }
  } with {
    briefly "AuditCase result"
    described as {
      |Result carrying the requested AuditCase data.
    }
  }
  command OpenAuditCase is  {
    caseId: AuditCaseId with {
      briefly "Case ID"
      described as {
        |New audit case identifier.
      }
    }
    caseInfo: AuditCaseInfo with {
      briefly "Case info"
      described as {
        |Audit case details.
      }
    }
  } with {
    briefly "Open audit case"
    described as {
      |Opens a new audit case for investigation.
    }
  }
  command ReconcileRecords is  {
    caseId: AuditCaseId with {
      briefly "Case ID"
      described as {
        |Audit case identifier.
      }
    }
    billingRecords: BillingRecord+ with {
      briefly "Billing records"
      described as {
        |Billing records to reconcile.
      }
    }
    usageRecords: UsageRecord+ with {
      briefly "Usage records"
      described as {
        |Network usage records to reconcile.
      }
    }
  } with {
    briefly "Reconcile records"
    described as {
      |Reconciles billing records against network usage.
    }
  }
  command RecordDiscrepancy is  {
    caseId: AuditCaseId with {
      briefly "Case ID"
      described as {
        |Audit case identifier.
      }
    }
    reconciliationResults: ReconciliationResult+ with {
      briefly "Results"
      described as {
        |Reconciliation results with discrepancies.
      }
    }
    totalVariance: Decimal(12,2) with {
      briefly "Total variance"
      described as {
        |Total monetary variance found.
      }
    }
  } with {
    briefly "Record discrepancy"
    described as {
      |Records discrepancies found during reconciliation.
    }
  }
  command EscalateCase is  {
    caseId: AuditCaseId with {
      briefly "Case ID"
      described as {
        |Audit case identifier.
      }
    }
    escalatedTo: String(1,100) with {
      briefly "Escalated to"
      described as {
        |Person or team to escalate to.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason for escalation.
      }
    }
  } with {
    briefly "Escalate case"
    described as {
      |Escalates audit case to management.
    }
  }
  command ResolveCase is  {
    caseId: AuditCaseId with {
      briefly "Case ID"
      described as {
        |Audit case identifier.
      }
    }
    resolution: ResolutionDetails with {
      briefly "Resolution"
      described as {
        |Resolution details.
      }
    }
  } with {
    briefly "Resolve case"
    described as {
      |Resolves an audit case with corrective action.
    }
  }
  command CloseCase is  {
    caseId: AuditCaseId with {
      briefly "Case ID"
      described as {
        |Audit case identifier.
      }
    }
    closedBy: String(1,100) with {
      briefly "Closed by"
      described as {
        |Person closing the case.
      }
    }
    summary: String(1,2000) with {
      briefly "Summary"
      described as {
        |Closing summary.
      }
    }
  } with {
    briefly "Close case"
    described as {
      |Closes a resolved audit case.
    }
  }
  command CancelCase is  {
    caseId: AuditCaseId with {
      briefly "Case ID"
      described as {
        |Audit case identifier.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
  } with {
    briefly "Cancel case"
    described as {
      |Cancels an audit case.
    }
  }
  // Events
  event AuditCaseOpened is  {
    caseId: AuditCaseId with {
      briefly "Case"
      described as {
        |Case ID.
      }
    }
    caseInfo: AuditCaseInfo with {
      briefly "Info"
      described as {
        |Case info.
      }
    }
    openedAt: TimeStamp with {
      briefly "Opened"
      described as {
        |Opening time.
      }
    }
  } with {
    briefly "Audit case opened"
    described as {
      |Emitted when an audit case is opened.
    }
  }
  event RecordsReconciled is  {
    caseId: AuditCaseId with {
      briefly "Case"
      described as {
        |Case ID.
      }
    }
    recordCount: Natural with {
      briefly "Count"
      described as {
        |Records reconciled.
      }
    }
    matchedCount: Natural with {
      briefly "Matched"
      described as {
        |Records matched.
      }
    }
    reconciledAt: TimeStamp with {
      briefly "Reconciled"
      described as {
        |Reconciliation time.
      }
    }
  } with {
    briefly "Records reconciled"
    described as {
      |Emitted when billing and usage records are reconciled.
    }
  }
  event DiscrepancyRecorded is  {
    caseId: AuditCaseId with {
      briefly "Case"
      described as {
        |Case ID.
      }
    }
    totalVariance: Decimal(12,2) with {
      briefly "Variance"
      described as {
        |Total variance.
      }
    }
    discrepancyCount: Natural with {
      briefly "Count"
      described as {
        |Discrepancy count.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Recording time.
      }
    }
  } with {
    briefly "Discrepancy recorded"
    described as {
      |Emitted when discrepancies are recorded.
    }
  }
  event CaseEscalated is  {
    caseId: AuditCaseId with {
      briefly "Case"
      described as {
        |Case ID.
      }
    }
    escalatedTo: String(1,100) with {
      briefly "To"
      described as {
        |Escalation target.
      }
    }
    escalatedAt: TimeStamp with {
      briefly "Escalated"
      described as {
        |Escalation time.
      }
    }
  } with {
    briefly "Case escalated"
    described as {
      |Emitted when audit case is escalated.
    }
  }
  event CaseResolved is  {
    caseId: AuditCaseId with {
      briefly "Case"
      described as {
        |Case ID.
      }
    }
    resolution: ResolutionDetails with {
      briefly "Resolution"
      described as {
        |Resolution details.
      }
    }
    resolvedAt: TimeStamp with {
      briefly "Resolved"
      described as {
        |Resolution time.
      }
    }
  } with {
    briefly "Case resolved"
    described as {
      |Emitted when audit case is resolved.
    }
  }
  event CaseClosed is  {
    caseId: AuditCaseId with {
      briefly "Case"
      described as {
        |Case ID.
      }
    }
    closedBy: String(1,100) with {
      briefly "By"
      described as {
        |Person closing.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed"
      described as {
        |Closing time.
      }
    }
  } with {
    briefly "Case closed"
    described as {
      |Emitted when audit case is closed.
    }
  }
  event CaseCancelled is  {
    caseId: AuditCaseId with {
      briefly "Case"
      described as {
        |Case ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancel reason.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancel time.
      }
    }
  } with {
    briefly "Case cancelled"
    described as {
      |Emitted when audit case is cancelled.
    }
  }
  // States
  record ActiveCaseData is  {
    caseId: AuditCaseId with {
      briefly "Case"
      described as {
        |Case ID.
      }
    }
    caseInfo: AuditCaseInfo with {
      briefly "Info"
      described as {
        |Case info.
      }
    }
    status: CaseStatus with {
      briefly "Status"
      described as {
        |Case status.
      }
    }
    updatedReconciliationResults: ReconciliationResult* with {
      briefly "Results"
      described as {
        |Reconciliation results.
      }
    }
    updatedTotalVariance: Decimal(12,2)? with {
      briefly "Variance"
      described as {
        |Total variance found.
      }
    }
    updatedEscalatedTo: String(1,100)? with {
      briefly "Escalated to"
      described as {
        |Escalation target.
      }
    }
    openedAt: TimeStamp with {
      briefly "Opened"
      described as {
        |Opening time.
      }
    }
  } with {
    briefly "Active case state"
    described as {
      |State for an active audit case.
    }
  }
  record ClosedCaseData is  {
    caseId: AuditCaseId with {
      briefly "Case"
      described as {
        |Case ID.
      }
    }
    resolution: ResolutionDetails with {
      briefly "Resolution"
      described as {
        |Resolution details.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed"
      described as {
        |Closing time.
      }
    }
  } with {
    briefly "Closed case state"
    described as {
      |State for a closed audit case.
    }
  }
  initial state ActiveCaseState of record AuditCase.ActiveCaseData is {
    initial handler ActiveCaseStateInitHandler is {
      on query GetAuditCase is {
        let auditCaseResult: type AuditCaseResult = prompt("read the audit case from the store")
        reply auditCaseResult
      }
      on init is {
        set state ActiveCaseState to "initialize AuditCase.ActiveCaseData fields from the creating message"
      }
    } with {
      briefly "ActiveCaseState initialization"
      described as {
        |Initializes ActiveCaseState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Active case state"
    described as {
      |The active case state of the AuditCase entity, carrying ActiveCaseData.
    }
  }
  state ClosedCaseState of record AuditCase.ClosedCaseData with {
    briefly "Closed case state"
    described as {
      |The closed case state of the AuditCase entity, carrying ClosedCaseData.
    }
  }
  handler AuditCaseHandler is {
    on init is {
      set state ClosedCaseState to "initialize AuditCase.ClosedCaseData fields from the creating message"
    }
    on openAuditCase: command OpenAuditCase is {
      morph entity RevenueAssuranceContext.AuditCase to state RevenueAssuranceContext.AuditCase.ActiveCaseState with record AuditCase.ActiveCaseData(caseId = openAuditCase.caseId, caseInfo = openAuditCase.caseInfo, status = prompt("the status of this active case data"), updatedReconciliationResults = empty, updatedTotalVariance = empty, updatedEscalatedTo = empty, openedAt = prompt("the opened at of this active case data"))
      tell event AuditCaseOpened(caseId = openAuditCase.caseId, caseInfo = openAuditCase.caseInfo, openedAt = prompt("the opened at of this audit case opened")) to entity RevenueAssuranceContext.AuditCase
    }
    on reconcileRecords: command ReconcileRecords is {
      tell event RecordsReconciled(caseId = reconcileRecords.caseId, recordCount = prompt("the record count of this records reconciled"), matchedCount = prompt("the matched count of this records reconciled"), reconciledAt = prompt("the reconciled at of this records reconciled")) to entity RevenueAssuranceContext.AuditCase
    }
    on recordDiscrepancy: command RecordDiscrepancy is {
      tell event DiscrepancyRecorded(caseId = recordDiscrepancy.caseId, totalVariance = recordDiscrepancy.totalVariance, discrepancyCount = prompt("the discrepancy count of this discrepancy recorded"), recordedAt = prompt("the recorded at of this discrepancy recorded")) to entity RevenueAssuranceContext.AuditCase
    }
    on escalateCase: command EscalateCase is {
      tell event CaseEscalated(caseId = escalateCase.caseId, escalatedTo = escalateCase.escalatedTo, escalatedAt = prompt("the escalated at of this case escalated")) to entity RevenueAssuranceContext.AuditCase
    }
    on resolveCase: command ResolveCase is {
      tell event CaseResolved(caseId = resolveCase.caseId, resolution = resolveCase.resolution, resolvedAt = prompt("the resolved at of this case resolved")) to entity RevenueAssuranceContext.AuditCase
    }
    on closeCase: command CloseCase is {
      morph entity RevenueAssuranceContext.AuditCase to state RevenueAssuranceContext.AuditCase.ClosedCaseState with record AuditCase.ClosedCaseData(caseId = closeCase.caseId, resolution = prompt("the resolution of this closed case data"), closedAt = prompt("the closed at of this closed case data"))
      tell event CaseClosed(caseId = closeCase.caseId, closedBy = closeCase.closedBy, closedAt = prompt("the closed at of this case closed")) to entity RevenueAssuranceContext.AuditCase
    }
    on cancelCase: command CancelCase is {
      tell event CaseCancelled(caseId = cancelCase.caseId, reason = cancelCase.reason, cancelledAt = prompt("the cancelled at of this case cancelled")) to entity RevenueAssuranceContext.AuditCase
    }
      on auditCaseOpened: event AuditCaseOpened is {
      do "apply AuditCaseOpened to the auditCase so it can be persisted and replayed"
    }
    on caseCancelled: event CaseCancelled is {
      do "apply CaseCancelled to the auditCase so it can be persisted and replayed"
    }
    on caseClosed: event CaseClosed is {
      do "apply CaseClosed to the auditCase so it can be persisted and replayed"
    }
    on caseEscalated: event CaseEscalated is {
      do "apply CaseEscalated to the auditCase so it can be persisted and replayed"
    }
    on caseResolved: event CaseResolved is {
      do "apply CaseResolved to the auditCase so it can be persisted and replayed"
    }
    on discrepancyRecorded: event DiscrepancyRecorded is {
      do "apply DiscrepancyRecorded to the auditCase so it can be persisted and replayed"
    }
    on recordsReconciled: event RecordsReconciled is {
      do "apply RecordsReconciled to the auditCase so it can be persisted and replayed"
    }
} with {
    briefly "Processes audit case commands"
    described as {
      |Handles audit case lifecycle.
    }
  }
} with {
  briefly "AuditCase aggregate"
  described as {
    |Manages revenue assurance audit cases.
  }
}
