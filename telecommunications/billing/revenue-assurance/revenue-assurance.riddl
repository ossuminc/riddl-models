// Revenue Assurance Domain Model
// Telecom revenue leakage detection and billing reconciliation
domain RevenueAssurance is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user RevenueAnalyst is "person analyzing billing discrepancies" with {
    briefly "Revenue Analyst"
    described as {
      |Analyst detecting revenue leakage and billing issues.
    }
  }
  user AuditManager is "person managing audit cases" with {
    briefly "Audit Manager"
    described as {
      |Manager overseeing revenue assurance audit cases.
    }
  }
  user ReconciliationAgent is "person reconciling billing and usage records" with {
    briefly "Reconciliation Agent"
    described as {
      |Agent reconciling billing records against network usage.
    }
  }
  epic RevenueLeakageDetection is {
    user RevenueAnalyst wants to "to detect revenue leakage" so that "unbilled or underbilled services are identified and recovered"
    case InvestigateDiscrepancy is {
      user RevenueAnalyst wants to "to investigate a billing discrepancy" so that "revenue leakage is identified and corrected"
      step is "Analyst opens" "audit case" "for discrepancy" with {
        briefly "Open case"
        described as {
          |Create audit case.
        }
      }
      step is "System reconciles" "billing records" "against network usage" with {
        briefly "Reconcile"
        described as {
          |Compare billing to usage.
        }
      }
    } with {
      briefly "Investigate billing discrepancy"
      described as {
        |Investigating and resolving billing discrepancies.
      }
    }
  } with {
    briefly "Revenue leakage detection"
    described as {
      |Epic for detecting and resolving revenue leakage.
    }
  }
  include "RevenueAssuranceContext.riddl"
  include "external-contexts.riddl"
  application context RevenueAssuranceApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in RevenueAssurance are delivered.
      }
    }
    outlet AppAuditCaseCommands is type RevenueAssuranceContext.AuditCase.AuditCaseCommand
    inlet AppAuditCaseRepositoryResponses is type RevenueAssuranceContext.AuditCase.AuditCaseResult    handler RevenueAssuranceAppHandler is {
      on other is {
        error "Unexpected message for application context RevenueAssuranceApp"
      }
    } with {
      briefly "RevenueAssuranceApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "RevenueAssuranceApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'AuditCaseCommand Stream' is from outlet RevenueAssuranceApp.AppAuditCaseCommands to inlet RevenueAssuranceContext.AuditCase.AuditCaseCommands with {
    briefly "AuditCase commands from the application"
  }
  persistent connector 'AuditCaseResult Stream' is from outlet RevenueAssuranceContext.AuditCaseRepository.AuditCaseRepositoryResponses to inlet RevenueAssuranceApp.AppAuditCaseRepositoryResponses with {
    briefly "AuditCase query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet RevenueAssuranceApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Revenue assurance domain"
  described as {
    |Telecom revenue leakage detection and billing reconciliation.
  }
}
