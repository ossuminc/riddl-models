// Revenue Assurance - Revenue Assurance Context
context RevenueAssuranceContext is {
  adaptor FromBillingSystem from context BillingSystem is { 
    handler FromBillingSystemHandler is {
      on event BillingSystem.BillingAdjusted is {
        do "the model receives billing adjusted"
      }
      on result BillingSystem.BillingRecordsResult is {
        do "the model receives billing records result"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingSystem"
      }
    } with {
      briefly "from billing system"
      described as {
        |Carries messages from the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor ToBillingSystem to context BillingSystem is { 
    handler ToBillingSystemHandler is {
      on command BillingSystem.AdjustBilling is {
        do "the model sends adjust billing"
      }
      on query BillingSystem.GetBillingRecords is {
        do "the model sends get billing records"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingSystem"
      }
    } with {
      briefly "to billing system"
      described as {
        |Carries messages to the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor FromNetworkUsageSystem from context NetworkUsageSystem is { 
    handler FromNetworkUsageSystemHandler is {
      on result NetworkUsageSystem.UnbilledServicesResult is {
        do "the model receives unbilled services result"
      }
      on result NetworkUsageSystem.UsageRecordsResult is {
        do "the model receives usage records result"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkUsageSystem"
      }
    } with {
      briefly "from network usage system"
      described as {
        |Carries messages from the external NetworkUsageSystem.
      }
    }
  } with {
    briefly "NetworkUsageSystem integration"
    described as {
      |The model's side of the NetworkUsageSystem conversation.
    }
  }
  adaptor ToNetworkUsageSystem to context NetworkUsageSystem is { 
    handler ToNetworkUsageSystemHandler is {
      on query NetworkUsageSystem.GetUnbilledServices is {
        do "the model sends get unbilled services"
      }
      on query NetworkUsageSystem.GetUsageRecords is {
        do "the model sends get usage records"
      }
      on other is {
        error "Unexpected message for adaptor ToNetworkUsageSystem"
      }
    } with {
      briefly "to network usage system"
      described as {
        |Carries messages to the external NetworkUsageSystem.
      }
    }
  } with {
    briefly "NetworkUsageSystem integration"
    described as {
      |The model's side of the NetworkUsageSystem conversation.
    }
  }
  include "types.riddl"
  include "AuditCase.riddl"
  repository AuditCaseRepository is {
    inlet AuditCaseRepositoryFromAuditCase is type AuditCaseEvent    inlet AuditCaseRepositoryFromRevenueAssuranceMetrics is type AuditCaseEvent    outlet AuditCaseRepositoryResponses is type AuditCase.AuditCaseResult
    record StoredAuditCase is  {
      auditCaseId: AuditCaseId with {
        briefly "auditCaseId"
        described as {
          |The auditCaseId column of the stored auditCase row.
        }
      }
      caseId: AuditCaseId with {
        briefly "caseId"
        described as {
          |The caseId column of the stored auditCase row.
        }
      }
      caseInfo: AuditCaseInfo with {
        briefly "caseInfo"
        described as {
          |The caseInfo column of the stored auditCase row.
        }
      }
      status: CaseStatus with {
        briefly "status"
        described as {
          |The status column of the stored auditCase row.
        }
      }
    } with {
      briefly "Stored auditCase row"
      described as {
        |The persistence shape of auditCase data as this repository stores it.
      }
    }
    schema AuditCaseData is relational
      of auditCases as type StoredAuditCase
        index on field StoredAuditCase.caseId
        index on field StoredAuditCase.caseInfo.customerId
        index on field StoredAuditCase.status
 with {
      briefly "Audit case data schema"
      described as {
        |The relational schema holding audit case data for the AuditCaseRepository.
      }
    }
    handler AuditCasePersistence is {
      on query GetLeakageMetrics is {
        do "read the leakage metrics projection"
        yield result LeakageMetricsView
      }
      on command AuditCase.OpenAuditCase is {
        tell event AuditCase.AuditCaseOpened to entity RevenueAssuranceContext.AuditCase
        do "Store new audit case"
      }
      on command AuditCase.ReconcileRecords is {
        do "Update case with reconciliation results"
      }
      on command AuditCase.RecordDiscrepancy is {
        tell event AuditCase.DiscrepancyRecorded to entity RevenueAssuranceContext.AuditCase
        do "Store discrepancy details"
      }
      on command AuditCase.EscalateCase is {
        do "Update case escalation status"
      }
      on command AuditCase.ResolveCase is {
        do "Update case with resolution"
      }
      on command AuditCase.CloseCase is {
        tell event AuditCase.CaseClosed to entity RevenueAssuranceContext.AuditCase
        do "Update case to closed"
      }
    } with {
      briefly "Persists audit case events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Audit case data persistence"
    described as {
      |Persistent storage for audit cases.
    }
  }
  query GetLeakageMetrics is  {
    leakageMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which leakage metrics to retrieve.
      }
    }
  } with {
    briefly "Get leakage metrics"
    described as {
      |Retrieves the leakage metrics projection.
    }
  }
  result LeakageMetricsView is  {
    leakageMetrics: RevenueAssuranceMetrics.LeakageMetrics with {
      briefly "Leakage metrics"
      described as {
        |The leakage metrics being returned.
      }
    }
  } with {
    briefly "Leakage metrics view"
    described as {
      |Read model view carrying the leakage metrics projection.
    }
  }
  projector RevenueAssuranceMetrics is {
    updates repository RevenueAssuranceContext.AuditCaseRepository
    inlet RevenueAssuranceMetricsFromAuditCase is type AuditCaseEvent    outlet RevenueAssuranceMetricsOut is type AuditCaseEvent
    record LeakageMetrics is  {
      casesOpened: Natural with {
        briefly "Opened"
        described as {
          |Cases opened.
        }
      }
      casesResolved: Natural with {
        briefly "Resolved"
        described as {
          |Cases resolved.
        }
      }
      casesEscalated: Natural with {
        briefly "Escalated"
        described as {
          |Cases escalated.
        }
      }
      totalVarianceDetected: Decimal(14,2) with {
        briefly "Total variance"
        described as {
          |Total variance detected.
        }
      }
      totalRecoveredAmount: Decimal(14,2) with {
        briefly "Recovered"
        described as {
          |Total recovered amount.
        }
      }
    } with {
      briefly "Leakage metrics"
      described as {
        |Revenue leakage detection metrics.
      }
    }
    handler MetricsHandler is {
      on event AuditCase.AuditCaseOpened is {
        tell event AuditCase.AuditCaseOpened to repository RevenueAssuranceContext.AuditCaseRepository
        do "Increment cases opened"
      }
      on event AuditCase.DiscrepancyRecorded is {
        tell event AuditCase.DiscrepancyRecorded to repository RevenueAssuranceContext.AuditCaseRepository
        do "Add to total variance detected"
      }
      on event AuditCase.CaseEscalated is {
        tell event AuditCase.CaseEscalated to repository RevenueAssuranceContext.AuditCaseRepository
        do "Increment cases escalated"
      }
      on event AuditCase.CaseResolved is {
        tell event AuditCase.CaseResolved to repository RevenueAssuranceContext.AuditCaseRepository
        do "Increment cases resolved and update recovered amount"
      }
    } with {
      briefly "Maintains revenue assurance metrics"
      described as {
        |Projects events into leakage metrics.
      }
    }
  } with {
    briefly "Revenue assurance metrics"
    described as {
      |Revenue leakage detection analytics.
    }
  }
  // ---- Event publication for AuditCase ----
  type AuditCaseEvent is one of {
    RevenueAssuranceContext.AuditCase.AuditCaseOpened or RevenueAssuranceContext.AuditCase.RecordsReconciled or RevenueAssuranceContext.AuditCase.DiscrepancyRecorded or RevenueAssuranceContext.AuditCase.CaseEscalated or RevenueAssuranceContext.AuditCase.CaseResolved or RevenueAssuranceContext.AuditCase.CaseClosed or RevenueAssuranceContext.AuditCase.CaseCancelled
  } with {
    briefly "AuditCase event alternation"
    described as {
      |Union of all AuditCase events, for streaming and event-sourced
      |persistence.
    }
  }
  processor AuditCaseEventSource as source is {
    outlet AuditCaseEvents is type AuditCaseEvent
    handler AuditCaseSourceHandler is {
      on event AuditCase.AuditCaseOpened is {
        send event AuditCase.AuditCaseOpened to outlet AuditCaseEvents
      }
      on event AuditCase.RecordsReconciled is {
        send event AuditCase.RecordsReconciled to outlet AuditCaseEvents
      }
      on event AuditCase.DiscrepancyRecorded is {
        send event AuditCase.DiscrepancyRecorded to outlet AuditCaseEvents
      }
      on event AuditCase.CaseEscalated is {
        send event AuditCase.CaseEscalated to outlet AuditCaseEvents
      }
      on event AuditCase.CaseResolved is {
        send event AuditCase.CaseResolved to outlet AuditCaseEvents
      }
      on event AuditCase.CaseClosed is {
        send event AuditCase.CaseClosed to outlet AuditCaseEvents
      }
      on event AuditCase.CaseCancelled is {
        send event AuditCase.CaseCancelled to outlet AuditCaseEvents
      }
      on other is {
        error "Unexpected message for source AuditCaseEventSource"
      }
    } with {
      briefly "AuditCase source handler"
      described as {
        |Publishes AuditCase events onto the outlet.
      }
    }
  } with {
    briefly "AuditCase event source"
    described as {
      |Publishes AuditCase entity events into the streaming topology.
    }
  }
  processor AuditCaseEventSink as sink is {
    inlet AuditCaseInlet is type AuditCaseEvent    handler AuditCaseSinkHandler is {
      on event AuditCase.AuditCaseOpened is {
        tell event AuditCase.AuditCaseOpened to repository RevenueAssuranceContext.AuditCaseRepository
      }
      on event AuditCase.RecordsReconciled is {
        tell event AuditCase.RecordsReconciled to repository RevenueAssuranceContext.AuditCaseRepository
      }
      on event AuditCase.DiscrepancyRecorded is {
        tell event AuditCase.DiscrepancyRecorded to repository RevenueAssuranceContext.AuditCaseRepository
      }
      on event AuditCase.CaseEscalated is {
        tell event AuditCase.CaseEscalated to repository RevenueAssuranceContext.AuditCaseRepository
      }
      on event AuditCase.CaseResolved is {
        tell event AuditCase.CaseResolved to repository RevenueAssuranceContext.AuditCaseRepository
      }
      on event AuditCase.CaseClosed is {
        tell event AuditCase.CaseClosed to repository RevenueAssuranceContext.AuditCaseRepository
      }
      on event AuditCase.CaseCancelled is {
        tell event AuditCase.CaseCancelled to repository RevenueAssuranceContext.AuditCaseRepository
      }
      on other is {
        error "Unexpected message for sink AuditCaseEventSink"
      }
    } with {
      briefly "AuditCase sink handler"
      described as {
        |Persists AuditCase events via the repository.
      }
    }
  } with {
    briefly "AuditCase event sink"
    described as {
      |Receives AuditCase events for persistence.
    }
  }
  connector AuditCaseEventFlow is from outlet RevenueAssuranceContext.AuditCaseEventSource.AuditCaseEvents to inlet RevenueAssuranceContext.AuditCaseEventSink.AuditCaseInlet with {
    briefly "AuditCase event flow"
    described as {
      |Connects the AuditCase source to its sink.
    }
  }
  processor AuditCaseEventSplit is {
    inlet AuditCaseEventSplitIn is type AuditCaseEvent    outlet AuditCaseEventSplitToAuditCaseRepository is type AuditCaseEvent
    outlet AuditCaseEventSplitToRevenueAssuranceMetrics is type AuditCaseEvent
    handler AuditCaseEventSplitHandler is {
      on event AuditCase.AuditCaseOpened is {
        send event AuditCase.AuditCaseOpened to outlet AuditCaseEventSplitToAuditCaseRepository
        send event AuditCase.AuditCaseOpened to outlet AuditCaseEventSplitToRevenueAssuranceMetrics
        tell event AuditCase.AuditCaseOpened to entity RevenueAssuranceContext.AuditCase
      }
      on event AuditCase.RecordsReconciled is {
        send event AuditCase.RecordsReconciled to outlet AuditCaseEventSplitToAuditCaseRepository
        send event AuditCase.RecordsReconciled to outlet AuditCaseEventSplitToRevenueAssuranceMetrics
        tell event AuditCase.RecordsReconciled to entity RevenueAssuranceContext.AuditCase
      }
      on event AuditCase.DiscrepancyRecorded is {
        send event AuditCase.DiscrepancyRecorded to outlet AuditCaseEventSplitToAuditCaseRepository
        send event AuditCase.DiscrepancyRecorded to outlet AuditCaseEventSplitToRevenueAssuranceMetrics
        tell event AuditCase.DiscrepancyRecorded to entity RevenueAssuranceContext.AuditCase
      }
      on event AuditCase.CaseEscalated is {
        send event AuditCase.CaseEscalated to outlet AuditCaseEventSplitToAuditCaseRepository
        send event AuditCase.CaseEscalated to outlet AuditCaseEventSplitToRevenueAssuranceMetrics
        tell event AuditCase.CaseEscalated to entity RevenueAssuranceContext.AuditCase
      }
      on event AuditCase.CaseResolved is {
        send event AuditCase.CaseResolved to outlet AuditCaseEventSplitToAuditCaseRepository
        send event AuditCase.CaseResolved to outlet AuditCaseEventSplitToRevenueAssuranceMetrics
        tell event AuditCase.CaseResolved to entity RevenueAssuranceContext.AuditCase
      }
      on event AuditCase.CaseClosed is {
        send event AuditCase.CaseClosed to outlet AuditCaseEventSplitToAuditCaseRepository
        send event AuditCase.CaseClosed to outlet AuditCaseEventSplitToRevenueAssuranceMetrics
        tell event AuditCase.CaseClosed to entity RevenueAssuranceContext.AuditCase
      }
      on event AuditCase.CaseCancelled is {
        send event AuditCase.CaseCancelled to outlet AuditCaseEventSplitToAuditCaseRepository
        send event AuditCase.CaseCancelled to outlet AuditCaseEventSplitToRevenueAssuranceMetrics
        tell event AuditCase.CaseCancelled to entity RevenueAssuranceContext.AuditCase
      }
      on other is {
        error "Unexpected message for processor AuditCaseEventSplit"
      }
    } with {
      briefly "AuditCase event fan-out handler"
      described as {
        |Delivers each AuditCase event to all of its consumers.
      }
    }
  } with {
    briefly "AuditCase event fan-out"
    described as {
      |Fans AuditCase events out to the repository and projectors.
    }
  }
  connector 'AuditCaseEvent Stream' is from outlet RevenueAssuranceContext.AuditCase.AuditCaseEvents2 to inlet RevenueAssuranceContext.AuditCaseEventSplit.AuditCaseEventSplitIn with {
    briefly "AuditCase events, fanned out to storage and read models"
  }
  connector 'AuditCaseEvent Storage' is from outlet RevenueAssuranceContext.AuditCaseEventSplit.AuditCaseEventSplitToAuditCaseRepository to inlet RevenueAssuranceContext.AuditCaseRepository.AuditCaseRepositoryFromAuditCase with {
    briefly "AuditCase events on their way to storage"
  }
  connector 'RevenueAssuranceMetrics Feed' is from outlet RevenueAssuranceContext.AuditCaseEventSplit.AuditCaseEventSplitToRevenueAssuranceMetrics to inlet RevenueAssuranceContext.RevenueAssuranceMetrics.RevenueAssuranceMetricsFromAuditCase with {
    briefly "AuditCase events feeding the RevenueAssuranceMetrics projection"
  }
  connector 'RevenueAssuranceMetrics Storage' is from outlet RevenueAssuranceContext.RevenueAssuranceMetrics.RevenueAssuranceMetricsOut to inlet RevenueAssuranceContext.AuditCaseRepository.AuditCaseRepositoryFromRevenueAssuranceMetrics with {
    briefly "The RevenueAssuranceMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for revenue assurance"
  described as {
    |Telecom revenue assurance and leakage detection context.
  }
}
