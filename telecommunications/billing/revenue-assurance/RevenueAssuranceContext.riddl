// Revenue Assurance - Revenue Assurance Context
context RevenueAssuranceContext as router is {
  inlet AuditCaseCommandStreamIn is type AuditCaseCommand  outlet AuditCaseCommandStreamOut is type AuditCaseCommand
  inlet AuditCaseResultStreamIn is result AuditCase.AuditCaseResult  outlet AuditCaseResultStreamOut is result AuditCase.AuditCaseResult
  handler RevenueAssuranceContextBoundary is {
    on openAuditCase: command AuditCase.OpenAuditCase is {
      send openAuditCase to outlet RevenueAssuranceContext.AuditCaseCommandStreamOut
    }
    on reconcileRecords: command AuditCase.ReconcileRecords is {
      send reconcileRecords to outlet RevenueAssuranceContext.AuditCaseCommandStreamOut
    }
    on recordDiscrepancy: command AuditCase.RecordDiscrepancy is {
      send recordDiscrepancy to outlet RevenueAssuranceContext.AuditCaseCommandStreamOut
    }
    on escalateCase: command AuditCase.EscalateCase is {
      send escalateCase to outlet RevenueAssuranceContext.AuditCaseCommandStreamOut
    }
    on resolveCase: command AuditCase.ResolveCase is {
      send resolveCase to outlet RevenueAssuranceContext.AuditCaseCommandStreamOut
    }
    on closeCase: command AuditCase.CloseCase is {
      send closeCase to outlet RevenueAssuranceContext.AuditCaseCommandStreamOut
    }
    on cancelCase: command AuditCase.CancelCase is {
      send cancelCase to outlet RevenueAssuranceContext.AuditCaseCommandStreamOut
    }
    on auditCaseResult: result AuditCase.AuditCaseResult is {
      send auditCaseResult to outlet RevenueAssuranceContext.AuditCaseResultStreamOut
    }
    on other is {
      error "Unexpected message at the RevenueAssuranceContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AuditCaseCommand Stream Intake' is from outlet RevenueAssuranceContext.AuditCaseCommandStreamOut to inlet RevenueAssuranceContext.AuditCase.AuditCaseCommands  connector 'AuditCaseResult Stream Egress' is from outlet RevenueAssuranceContext.AuditCaseRepository.AuditCaseRepositoryResponses to inlet RevenueAssuranceContext.AuditCaseResultStreamIn  adaptor FromBillingSystem from context BillingSystem is { 
    handler FromBillingSystemHandler is {
      on event BillingSystem.BillingAdjusted is {
        do "the model receives billing adjusted"
      }
      on result BillingSystem.BillingRecordsResult is {
        do "the model receives billing records result"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingSystem"
      }
    } with {
      briefly "from billing system"
      described as {
        |Carries messages from the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor ToBillingSystem to context BillingSystem is { 
    handler ToBillingSystemHandler is {
      on command BillingSystem.AdjustBilling is {
        do "the model sends adjust billing"
      }
      on query BillingSystem.GetBillingRecords is {
        do "the model sends get billing records"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingSystem"
      }
    } with {
      briefly "to billing system"
      described as {
        |Carries messages to the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor FromNetworkUsageSystem from context NetworkUsageSystem is { 
    handler FromNetworkUsageSystemHandler is {
      on result NetworkUsageSystem.UnbilledServicesResult is {
        do "the model receives unbilled services result"
      }
      on result NetworkUsageSystem.UsageRecordsResult is {
        do "the model receives usage records result"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkUsageSystem"
      }
    } with {
      briefly "from network usage system"
      described as {
        |Carries messages from the external NetworkUsageSystem.
      }
    }
  } with {
    briefly "NetworkUsageSystem integration"
    described as {
      |The model's side of the NetworkUsageSystem conversation.
    }
  }
  adaptor ToNetworkUsageSystem to context NetworkUsageSystem is { 
    handler ToNetworkUsageSystemHandler is {
      on query NetworkUsageSystem.GetUnbilledServices is {
        do "the model sends get unbilled services"
      }
      on query NetworkUsageSystem.GetUsageRecords is {
        do "the model sends get usage records"
      }
      on other is {
        error "Unexpected message for adaptor ToNetworkUsageSystem"
      }
    } with {
      briefly "to network usage system"
      described as {
        |Carries messages to the external NetworkUsageSystem.
      }
    }
  } with {
    briefly "NetworkUsageSystem integration"
    described as {
      |The model's side of the NetworkUsageSystem conversation.
    }
  }
  include "types.riddl"
  include "AuditCase.riddl"
  type AuditCaseRepositoryCommand is one of {
    RevenueAssuranceContext.AuditCaseRepository.PersistAuditCaseOpened or RevenueAssuranceContext.AuditCaseRepository.PersistCaseCancelled or RevenueAssuranceContext.AuditCaseRepository.PersistCaseClosed or RevenueAssuranceContext.AuditCaseRepository.PersistCaseEscalated or RevenueAssuranceContext.AuditCaseRepository.PersistCaseResolved or RevenueAssuranceContext.AuditCaseRepository.PersistDiscrepancyRecorded or RevenueAssuranceContext.AuditCaseRepository.PersistRecordsReconciled
  } with {
    briefly "Anything that writes AuditCaseRepository"
    described as {
      |The persistence commands AuditCaseRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository AuditCaseRepository as flow is {
    inlet AuditCaseRepositoryFromRevenueAssuranceMetrics is type AuditCaseRepositoryCommand    command PersistCaseCancelled is {
      caseId: AuditCaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseCancelled applies to.
        }
      }
    } with {
      briefly "Persist CaseCancelled"
      described as {
        |Instructs this repository to apply CaseCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCaseClosed is {
      caseId: AuditCaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseClosed applies to.
        }
      }
    } with {
      briefly "Persist CaseClosed"
      described as {
        |Instructs this repository to apply CaseClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRecordsReconciled is {
      caseId: AuditCaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row RecordsReconciled applies to.
        }
      }
    } with {
      briefly "Persist RecordsReconciled"
      described as {
        |Instructs this repository to apply RecordsReconciled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAuditCaseOpened is {
      caseId: AuditCaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row AuditCaseOpened applies to.
        }
      }
    } with {
      briefly "Persist AuditCaseOpened"
      described as {
        |Instructs this repository to apply AuditCaseOpened to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCaseEscalated is {
      caseId: AuditCaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseEscalated applies to.
        }
      }
    } with {
      briefly "Persist CaseEscalated"
      described as {
        |Instructs this repository to apply CaseEscalated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCaseResolved is {
      caseId: AuditCaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CaseResolved applies to.
        }
      }
    } with {
      briefly "Persist CaseResolved"
      described as {
        |Instructs this repository to apply CaseResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDiscrepancyRecorded is {
      caseId: AuditCaseId with {
        briefly "Row addressed"
        described as {
          |Which stored row DiscrepancyRecorded applies to.
        }
      }
    } with {
      briefly "Persist DiscrepancyRecorded"
      described as {
        |Instructs this repository to apply DiscrepancyRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet AuditCaseRepositoryResponses is result AuditCase.AuditCaseResult
    record StoredAuditCase is {
      auditCaseId: AuditCaseId with {
        briefly "auditCaseId"
        described as {
          |The auditCaseId column of the stored auditCase row.
        }
      }
      caseId: AuditCaseId with {
        briefly "caseId"
        described as {
          |The caseId column of the stored auditCase row.
        }
      }
      caseInfo: AuditCaseInfo with {
        briefly "caseInfo"
        described as {
          |The caseInfo column of the stored auditCase row.
        }
      }
      status: CaseStatus with {
        briefly "status"
        described as {
          |The status column of the stored auditCase row.
        }
      }
    } with {
      briefly "Stored auditCase row"
      described as {
        |The persistence shape of auditCase data as this repository stores it.
      }
    }
    schema AuditCaseData is relational
      of auditCases as record StoredAuditCase
        index on field StoredAuditCase.caseId
        index on field StoredAuditCase.caseInfo.customerId
        index on field StoredAuditCase.status
 with {
      briefly "Audit case data schema"
      described as {
        |The relational schema holding audit case data for the AuditCaseRepository.
      }
    }
    handler AuditCasePersistence is {
      on persistCaseCancelled: command PersistCaseCancelled is {
        do "apply CaseCancelled to the stored row"
      }
      on persistCaseClosed: command PersistCaseClosed is {
        do "apply CaseClosed to the stored row"
      }
      on persistRecordsReconciled: command PersistRecordsReconciled is {
        do "apply RecordsReconciled to the stored row"
      }
      on persistAuditCaseOpened: command PersistAuditCaseOpened is {
        do "apply AuditCaseOpened to the stored row"
      }
      on persistCaseEscalated: command PersistCaseEscalated is {
        do "apply CaseEscalated to the stored row"
      }
      on persistCaseResolved: command PersistCaseResolved is {
        do "apply CaseResolved to the stored row"
      }
      on persistDiscrepancyRecorded: command PersistDiscrepancyRecorded is {
        do "apply DiscrepancyRecorded to the stored row"
      }
      on query GetLeakageMetrics is {
        let leakageMetricsView: type LeakageMetricsView = prompt("read the leakage metrics projection")
        reply leakageMetricsView
      }
    } with {
      briefly "Persists audit case events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Audit case data persistence"
    described as {
      |Persistent storage for audit cases.
    }
  }
  query GetLeakageMetrics replies result LeakageMetricsView is {
    leakageMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which leakage metrics to retrieve.
      }
    }
  } with {
    briefly "Get leakage metrics"
    described as {
      |Retrieves the leakage metrics projection.
    }
  }
  result LeakageMetricsView is {
    leakageMetrics: RevenueAssuranceMetrics.LeakageMetrics with {
      briefly "Leakage metrics"
      described as {
        |The leakage metrics being returned.
      }
    }
  } with {
    briefly "Leakage metrics view"
    described as {
      |Read model view carrying the leakage metrics projection.
    }
  }
  projector RevenueAssuranceMetrics as flow is {
    updates repository RevenueAssuranceContext.AuditCaseRepository
    outlet RevenueAssuranceMetricsToRepository is type AuditCaseRepositoryCommand
    inlet RevenueAssuranceMetricsFromAuditCase is type AuditCaseEvent    record LeakageMetrics is {
      casesOpened: Natural with {
        briefly "Opened"
        described as {
          |Cases opened.
        }
      }
      casesResolved: Natural with {
        briefly "Resolved"
        described as {
          |Cases resolved.
        }
      }
      casesEscalated: Natural with {
        briefly "Escalated"
        described as {
          |Cases escalated.
        }
      }
      totalVarianceDetected: Decimal(14,2) with {
        briefly "Total variance"
        described as {
          |Total variance detected.
        }
      }
      totalRecoveredAmount: Decimal(14,2) with {
        briefly "Recovered"
        described as {
          |Total recovered amount.
        }
      }
    } with {
      briefly "Leakage metrics"
      described as {
        |Revenue leakage detection metrics.
      }
    }
    handler MetricsHandler is {
      on caseCancelled: event AuditCase.CaseCancelled is {
        tell command RevenueAssuranceContext.AuditCaseRepository.PersistCaseCancelled(caseId = caseCancelled.caseId) to repository RevenueAssuranceContext.AuditCaseRepository
        do "apply CaseCancelled to the RevenueAssuranceMetrics projection"
      }
      on caseClosed: event AuditCase.CaseClosed is {
        tell command RevenueAssuranceContext.AuditCaseRepository.PersistCaseClosed(caseId = caseClosed.caseId) to repository RevenueAssuranceContext.AuditCaseRepository
        do "apply CaseClosed to the RevenueAssuranceMetrics projection"
      }
      on recordsReconciled: event AuditCase.RecordsReconciled is {
        tell command RevenueAssuranceContext.AuditCaseRepository.PersistRecordsReconciled(caseId = recordsReconciled.caseId) to repository RevenueAssuranceContext.AuditCaseRepository
        do "apply RecordsReconciled to the RevenueAssuranceMetrics projection"
      }
      on auditCaseOpened: event AuditCase.AuditCaseOpened is {
        tell command RevenueAssuranceContext.AuditCaseRepository.PersistAuditCaseOpened(caseId = auditCaseOpened.caseId) to repository RevenueAssuranceContext.AuditCaseRepository
        do "Increment cases opened"
      }
      on discrepancyRecorded: event AuditCase.DiscrepancyRecorded is {
        tell command RevenueAssuranceContext.AuditCaseRepository.PersistDiscrepancyRecorded(caseId = discrepancyRecorded.caseId) to repository RevenueAssuranceContext.AuditCaseRepository
        do "Add to total variance detected"
      }
      on caseEscalated: event AuditCase.CaseEscalated is {
        tell command RevenueAssuranceContext.AuditCaseRepository.PersistCaseEscalated(caseId = caseEscalated.caseId) to repository RevenueAssuranceContext.AuditCaseRepository
        do "Increment cases escalated"
      }
      on caseResolved: event AuditCase.CaseResolved is {
        tell command RevenueAssuranceContext.AuditCaseRepository.PersistCaseResolved(caseId = caseResolved.caseId) to repository RevenueAssuranceContext.AuditCaseRepository
        do "Increment cases resolved and update recovered amount"
      }
    } with {
      briefly "Maintains revenue assurance metrics"
      described as {
        |Projects events into leakage metrics.
      }
    }
  } with {
    briefly "Revenue assurance metrics"
    described as {
      |Revenue leakage detection analytics.
    }
  }
  // ---- Event publication for AuditCase ----
  type AuditCaseEvent is one of {
    RevenueAssuranceContext.AuditCase.AuditCaseOpened or RevenueAssuranceContext.AuditCase.RecordsReconciled or RevenueAssuranceContext.AuditCase.DiscrepancyRecorded or RevenueAssuranceContext.AuditCase.CaseEscalated or RevenueAssuranceContext.AuditCase.CaseResolved or RevenueAssuranceContext.AuditCase.CaseClosed or RevenueAssuranceContext.AuditCase.CaseCancelled
  } with {
    briefly "AuditCase event alternation"
    described as {
      |Union of all AuditCase events, for streaming and event-sourced
      |persistence.
    }
  }
  processor AuditCaseEventSplit as flow is {
    inlet AuditCaseEventSplitIn is type AuditCaseEvent    outlet AuditCaseEventSplitToRevenueAssuranceMetrics is type AuditCaseEvent
    handler AuditCaseEventSplitHandler is {
      on auditCaseOpened: event AuditCase.AuditCaseOpened is {
        send auditCaseOpened to outlet AuditCaseEventSplitToRevenueAssuranceMetrics
        tell auditCaseOpened to entity RevenueAssuranceContext.AuditCase
      }
      on recordsReconciled: event AuditCase.RecordsReconciled is {
        send recordsReconciled to outlet AuditCaseEventSplitToRevenueAssuranceMetrics
        tell recordsReconciled to entity RevenueAssuranceContext.AuditCase
      }
      on discrepancyRecorded: event AuditCase.DiscrepancyRecorded is {
        send discrepancyRecorded to outlet AuditCaseEventSplitToRevenueAssuranceMetrics
        tell discrepancyRecorded to entity RevenueAssuranceContext.AuditCase
      }
      on caseEscalated: event AuditCase.CaseEscalated is {
        send caseEscalated to outlet AuditCaseEventSplitToRevenueAssuranceMetrics
        tell caseEscalated to entity RevenueAssuranceContext.AuditCase
      }
      on caseResolved: event AuditCase.CaseResolved is {
        send caseResolved to outlet AuditCaseEventSplitToRevenueAssuranceMetrics
        tell caseResolved to entity RevenueAssuranceContext.AuditCase
      }
      on caseClosed: event AuditCase.CaseClosed is {
        send caseClosed to outlet AuditCaseEventSplitToRevenueAssuranceMetrics
        tell caseClosed to entity RevenueAssuranceContext.AuditCase
      }
      on caseCancelled: event AuditCase.CaseCancelled is {
        send caseCancelled to outlet AuditCaseEventSplitToRevenueAssuranceMetrics
        tell caseCancelled to entity RevenueAssuranceContext.AuditCase
      }
      on other is {
        error "Unexpected message for processor AuditCaseEventSplit"
      }
    } with {
      briefly "AuditCase event fan-out handler"
      described as {
        |Delivers each AuditCase event to all of its consumers.
      }
    }
  } with {
    briefly "AuditCase event fan-out"
    described as {
      |Fans AuditCase events out to the repository and projectors.
    }
  }
  connector 'AuditCaseEvent Stream' is from outlet RevenueAssuranceContext.AuditCase.AuditCaseEvents2 to inlet RevenueAssuranceContext.AuditCaseEventSplit.AuditCaseEventSplitIn with {
    briefly "AuditCase events, fanned out to storage and read models"
  }
  connector 'RevenueAssuranceMetrics Feed' is from outlet RevenueAssuranceContext.AuditCaseEventSplit.AuditCaseEventSplitToRevenueAssuranceMetrics to inlet RevenueAssuranceContext.RevenueAssuranceMetrics.RevenueAssuranceMetricsFromAuditCase with {
    briefly "AuditCase events feeding the RevenueAssuranceMetrics projection"
  }
  connector 'RevenueAssuranceMetrics Storage' is from outlet RevenueAssuranceContext.RevenueAssuranceMetrics.RevenueAssuranceMetricsToRepository to inlet RevenueAssuranceContext.AuditCaseRepository.AuditCaseRepositoryFromRevenueAssuranceMetrics with {
    briefly "RevenueAssuranceMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for revenue assurance"
  described as {
    |Telecom revenue assurance and leakage detection context.
  }
}
