// Billing Account Entity for Usage Billing Domain
aggregate event-sourced entity BillingAccount as flow is {
  type BillingAccountCommand is one of {
    BillingAccount.CreateAccount or BillingAccount.UpdateCustomerInfo or BillingAccount.ChangeRatePlan or BillingAccount.RecordUsage or BillingAccount.GenerateInvoice or BillingAccount.ApplyPayment or BillingAccount.ApplyCredit or BillingAccount.SuspendAccount or BillingAccount.ReactivateAccount or BillingAccount.CloseAccount
  } with {
    briefly "BillingAccount command alternation"
    described as {
      |Commands accepted by the BillingAccount entity.
    }
  }
  inlet BillingAccountCommands is type BillingAccountCommand  outlet BillingAccountEvents2 is type BillingAccountEvent
  query GetBillingAccount replies result BillingAccountResult is {
    accountId: AccountId with {
      briefly "ID"
      described as {
        |Identifier of the BillingAccount to retrieve.
      }
    }
  } with {
    briefly "Get BillingAccount"
    described as {
      |Retrieve BillingAccount data by identifier.
    }
  }
  result BillingAccountResult is  {
    billingAccountId: AccountId with {
      briefly "BillingAccount addressed"
      described as {
        |Which billingaccount this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    billingAccountData: BillingAccount.PendingActivationData with {
      briefly "BillingAccount data"
      described as {
        |The requested BillingAccount data.
      }
    }
  } with {
    briefly "BillingAccount result"
    described as {
      |Result carrying the requested BillingAccount data.
    }
  }
  // === Commands ===
  command CreateAccount yields event AccountCreated is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    customer: CustomerInfo with {
      briefly "Customer"
      described as {
        |Customer info.
      }
    }
    ratePlanId: RatePlanId with {
      briefly "Plan"
      described as {
        |Rate plan.
      }
    }
    paymentMethod: PaymentMethod with {
      briefly "Method"
      described as {
        |Payment method.
      }
    }
  } with {
    briefly "Create a new billing account"
    described as {
      |Establishes a new customer billing account with initial settings.
    }
  }
  command UpdateCustomerInfo yields event CustomerInfoUpdated is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    customer: CustomerInfo with {
      briefly "Customer"
      described as {
        |Customer info.
      }
    }
  } with {
    briefly "Update customer contact information"
    described as {
      |Modifies the customer details associated with the account.
    }
  }
  command ChangeRatePlan yields event RatePlanChanged is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    newRatePlanId: RatePlanId with {
      briefly "Plan"
      described as {
        |New rate plan.
      }
    }
    effectiveDate: Date with {
      briefly "Effective"
      described as {
        |Effective date.
      }
    }
  } with {
    briefly "Change the rate plan for the account"
    described as {
      |Switches the customer to a different pricing plan.
    }
  }
  command RecordUsage yields event UsageRecorded is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    usageRecordId: UsageRecordId with {
      briefly "Record"
      described as {
        |Usage record.
      }
    }
  } with {
    briefly "Record a usage event for the account"
    described as {
      |Adds a metered usage record to be rated and billed.
    }
  }
  command GenerateInvoice yields event InvoiceGenerated is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    billingPeriodStart: Date with {
      briefly "Start"
      described as {
        |Period start.
      }
    }
    billingPeriodEnd: Date with {
      briefly "End"
      described as {
        |Period end.
      }
    }
  } with {
    briefly "Generate an invoice for a billing period"
    described as {
      |Creates an invoice aggregating usage and charges for the period.
    }
  }
  command ApplyPayment yields event PaymentApplied is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    payment: PaymentRecord with {
      briefly "Payment"
      described as {
        |Payment details.
      }
    }
  } with {
    briefly "Apply a payment to the account"
    described as {
      |Records a payment received against an outstanding invoice.
    }
  }
  command ApplyCredit yields event CreditApplied is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    amount: MonetaryAmount with {
      briefly "Amount"
      described as {
        |Credit amount.
      }
    }
    reason: String with {
      briefly "Reason"
      described as {
        |Credit reason.
      }
    }
    targetInvoiceId: InvoiceId? with {
      briefly "Invoice"
      described as {
        |Target invoice.
      }
    }
  } with {
    briefly "Apply a credit adjustment to the account"
    described as {
      |Adds a credit to the account balance, optionally against a specific invoice.
    }
  }
  command SuspendAccount yields event AccountSuspended is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    reason: String with {
      briefly "Reason"
      described as {
        |Suspension reason.
      }
    }
  } with {
    briefly "Suspend the billing account"
    described as {
      |Suspends the account, typically due to non-payment.
    }
  }
  command ReactivateAccount yields event AccountReactivated is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
  } with {
    briefly "Reactivate a suspended account"
    described as {
      |Restores an account to active status after issue resolution.
    }
  }
  command CloseAccount yields event AccountClosed is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    reason: String with {
      briefly "Reason"
      described as {
        |Closure reason.
      }
    }
    finalBillDate: Date with {
      briefly "Final"
      described as {
        |Final bill date.
      }
    }
  } with {
    briefly "Close the billing account"
    described as {
      |Permanently closes the account and generates a final bill.
    }
  }
  // === Events ===
  event AccountCreated is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    customer: CustomerInfo with {
      briefly "Customer"
      described as {
        |Customer info.
      }
    }
    ratePlanId: RatePlanId with {
      briefly "Plan"
      described as {
        |Rate plan.
      }
    }
    paymentMethod: PaymentMethod with {
      briefly "Method"
      described as {
        |Payment method.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Billing account was created"
    described as {
      |Indicates a new billing account has been established.
    }
  }
  event CustomerInfoUpdated is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    customer: CustomerInfo with {
      briefly "Customer"
      described as {
        |Customer info.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Customer information was updated"
    described as {
      |Indicates customer contact details have been modified.
    }
  }
  event RatePlanChanged is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    previousPlanId: RatePlanId with {
      briefly "Previous"
      described as {
        |Previous plan.
      }
    }
    newPlanId: RatePlanId with {
      briefly "New"
      described as {
        |New plan.
      }
    }
    effectiveDate: Date with {
      briefly "Effective"
      described as {
        |Effective date.
      }
    }
  } with {
    briefly "Rate plan was changed"
    described as {
      |Indicates the customer has been moved to a different pricing plan.
    }
  }
  event UsageRecorded is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    usageRecordId: UsageRecordId with {
      briefly "Record"
      described as {
        |Usage record.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Usage event was recorded"
    described as {
      |Indicates a metered usage event has been captured for billing.
    }
  }
  event InvoiceGenerated is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    invoiceId: InvoiceId with {
      briefly "Invoice"
      described as {
        |Invoice identifier.
      }
    }
    generatedAt: TimeStamp with {
      briefly "Generated"
      described as {
        |Generation time.
      }
    }
  } with {
    briefly "Invoice was generated"
    described as {
      |Indicates an invoice has been created for the billing period.
    }
  }
  event PaymentApplied is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    payment: PaymentRecord with {
      briefly "Payment"
      described as {
        |Payment details.
      }
    }
    newBalance: MonetaryAmount with {
      briefly "Balance"
      described as {
        |New balance.
      }
    }
  } with {
    briefly "Payment was applied"
    described as {
      |Indicates a payment has been received and applied to the account.
    }
  }
  event CreditApplied is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    amount: MonetaryAmount with {
      briefly "Amount"
      described as {
        |Credit amount.
      }
    }
    reason: String with {
      briefly "Reason"
      described as {
        |Credit reason.
      }
    }
    targetInvoiceId: InvoiceId? with {
      briefly "Invoice"
      described as {
        |Target invoice.
      }
    }
    newBalance: MonetaryAmount with {
      briefly "Balance"
      described as {
        |New balance.
      }
    }
  } with {
    briefly "Credit was applied"
    described as {
      |Indicates a credit adjustment has been made to the account.
    }
  }
  event AccountSuspended is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    reason: String with {
      briefly "Reason"
      described as {
        |Suspension reason.
      }
    }
    suspendedAt: TimeStamp with {
      briefly "Suspended"
      described as {
        |Suspension time.
      }
    }
  } with {
    briefly "Account was suspended"
    described as {
      |Indicates the account has been suspended.
    }
  }
  event AccountReactivated is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    reactivatedAt: TimeStamp with {
      briefly "Reactivated"
      described as {
        |Reactivation time.
      }
    }
  } with {
    briefly "Account was reactivated"
    described as {
      |Indicates a suspended account has been restored to active status.
    }
  }
  event AccountClosed is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    reason: String with {
      briefly "Reason"
      described as {
        |Closure reason.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed"
      described as {
        |Closure time.
      }
    }
    finalBalance: MonetaryAmount with {
      briefly "Balance"
      described as {
        |Final balance.
      }
    }
  } with {
    briefly "Account was closed"
    described as {
      |Indicates the account has been permanently closed.
    }
  }
  // === State Records ===
  record PendingActivationData is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    customer: CustomerInfo with {
      briefly "Customer"
      described as {
        |Customer info.
      }
    }
    ratePlanId: RatePlanId with {
      briefly "Plan"
      described as {
        |Rate plan.
      }
    }
    paymentMethod: PaymentMethod with {
      briefly "Method"
      described as {
        |Payment method.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Pending activation state data"
    described as {
      |Initial state when account is created but not yet active.
    }
  }
  record ActiveData is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    customer: CustomerInfo with {
      briefly "Customer"
      described as {
        |Customer info.
      }
    }
    ratePlanId: RatePlanId with {
      briefly "Plan"
      described as {
        |Rate plan.
      }
    }
    paymentMethod: PaymentMethod with {
      briefly "Method"
      described as {
        |Payment method.
      }
    }
    currentBalance: MonetaryAmount with {
      briefly "Balance"
      described as {
        |Current balance.
      }
    }
    activatedAt: TimeStamp with {
      briefly "Activated"
      described as {
        |Activation time.
      }
    }
  } with {
    briefly "Active state data"
    described as {
      | The normal operating state where the customer can use services,
      | usage is being tracked, and invoices can be generated.
    }
  }
  record SuspendedData is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    customer: CustomerInfo with {
      briefly "Customer"
      described as {
        |Customer info.
      }
    }
    ratePlanId: RatePlanId with {
      briefly "Plan"
      described as {
        |Rate plan.
      }
    }
    paymentMethod: PaymentMethod with {
      briefly "Method"
      described as {
        |Payment method.
      }
    }
    currentBalance: MonetaryAmount with {
      briefly "Balance"
      described as {
        |Current balance.
      }
    }
    suspendedAt: TimeStamp with {
      briefly "Suspended"
      described as {
        |Suspension time.
      }
    }
    suspensionReason: String with {
      briefly "Reason"
      described as {
        |Suspension reason.
      }
    }
  } with {
    briefly "Suspended state data"
    described as {
      | The account is blocked from incurring new usage, typically due to
      | non-payment or policy violations. Existing balances remain due.
    }
  }
  record ClosedData is  {
    accountId: AccountId with {
      briefly "Account"
      described as {
        |Account identifier.
      }
    }
    customer: CustomerInfo with {
      briefly "Customer"
      described as {
        |Customer info.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed"
      described as {
        |Closure time.
      }
    }
    closureReason: String with {
      briefly "Reason"
      described as {
        |Closure reason.
      }
    }
    finalBalance: MonetaryAmount with {
      briefly "Balance"
      described as {
        |Final balance.
      }
    }
  } with {
    briefly "Closed state data"
    described as {
      |Terminal state after account closure with historical records retained.
    }
  }
  // === States ===
  initial state PendingActivation of record BillingAccount.PendingActivationData is {
    initial handler PendingActivationInitHandler is {
      on query GetBillingAccount is {
        let billingAccountResult: type BillingAccountResult = prompt("read the billing account from the store")
        reply billingAccountResult
      }
      on init is {
        let accountCreated: type AccountCreated = prompt("the account created that brings this billing account into existence")
        yield accountCreated
      }
    } with {
      briefly "PendingActivation initialization"
      described as {
        |Initializes PendingActivation from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Pending activation"
    described as {
      |The pending activation of the BillingAccount entity, carrying PendingActivationData.
    }
  }
  state ActiveState of record BillingAccount.ActiveData is {
    initial handler ActiveStateInitHandler is {
      on init is {
        let accountReactivated: type AccountReactivated = prompt("the account reactivated that brings this billing account into existence")
        yield accountReactivated
      }
    } with {
      briefly "ActiveState initialization"
      described as {
        |Initializes ActiveState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |The active state of the BillingAccount entity, carrying ActiveData.
    }
  }
  state SuspendedState of record BillingAccount.SuspendedData is {
    initial handler SuspendedStateInitHandler is {
      on init is {
        let accountSuspended: type AccountSuspended = prompt("the account suspended that brings this billing account into existence")
        yield accountSuspended
      }
    } with {
      briefly "SuspendedState initialization"
      described as {
        |Initializes SuspendedState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Suspended state"
    described as {
      |The suspended state of the BillingAccount entity, carrying SuspendedData.
    }
  }
  state ClosedState of record BillingAccount.ClosedData is {
    initial handler ClosedStateInitHandler is {
      on init is {
        let accountClosed: type AccountClosed = prompt("the account closed that brings this billing account into existence")
        yield accountClosed
      }
    } with {
      briefly "ClosedState initialization"
      described as {
        |Initializes ClosedState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Closed state"
    described as {
      |The closed state of the BillingAccount entity, carrying ClosedData.
    }
  }
  // === Handler ===
  handler BillingAccountHandler is {
    on createAccount: command CreateAccount is {
      yield event AccountCreated(accountId = createAccount.accountId, customer = createAccount.customer, ratePlanId = createAccount.ratePlanId, paymentMethod = createAccount.paymentMethod)
    }
    on updateCustomerInfo: command UpdateCustomerInfo is {
      yield event CustomerInfoUpdated(accountId = updateCustomerInfo.accountId, customer = updateCustomerInfo.customer)
    }
    on changeRatePlan: command ChangeRatePlan is {
      yield event RatePlanChanged(accountId = changeRatePlan.accountId, effectiveDate = changeRatePlan.effectiveDate)
    }
    on recordUsage: command RecordUsage is {
      yield event UsageRecorded(accountId = recordUsage.accountId, usageRecordId = recordUsage.usageRecordId)
    }
    on generateInvoice: command GenerateInvoice is {
      yield event InvoiceGenerated(accountId = generateInvoice.accountId)
    }
    on applyPayment: command ApplyPayment is {
      yield event PaymentApplied(accountId = applyPayment.accountId, payment = applyPayment.payment)
    }
    on applyCredit: command ApplyCredit is {
      yield event CreditApplied(accountId = applyCredit.accountId, amount = applyCredit.amount, reason = applyCredit.reason, targetInvoiceId = applyCredit.targetInvoiceId)
    }
    on suspendAccount: command SuspendAccount is {
      yield event AccountSuspended(accountId = suspendAccount.accountId, reason = suspendAccount.reason)
    }
    on reactivateAccount: command ReactivateAccount is {
      yield event AccountReactivated(accountId = reactivateAccount.accountId)
    }
    on closeAccount: command CloseAccount is {
      yield event AccountClosed(accountId = closeAccount.accountId, reason = closeAccount.reason)
    }
    on accountCreated: event AccountCreated is {
      morph entity BillingContext.BillingAccount to state BillingContext.BillingAccount.PendingActivation with record BillingAccount.PendingActivationData(accountId = accountCreated.accountId, customer = accountCreated.customer, ratePlanId = accountCreated.ratePlanId, paymentMethod = accountCreated.paymentMethod, createdAt = accountCreated.createdAt)
      set state PendingActivation to "initialize BillingAccount.PendingActivationData fields from the creating message"
    }
    on event CustomerInfoUpdated is {
      do "apply CustomerInfoUpdated to the current state"
    }
    on event RatePlanChanged is {
      do "apply RatePlanChanged to the current state"
    }
    on event UsageRecorded is {
      do "apply UsageRecorded to the current state"
    }
    on event InvoiceGenerated is {
      do "apply InvoiceGenerated to the current state"
    }
    on event PaymentApplied is {
      do "apply PaymentApplied to the current state"
    }
    on event CreditApplied is {
      do "apply CreditApplied to the current state"
    }
    on accountSuspended: event AccountSuspended is {
      morph entity BillingContext.BillingAccount to state BillingContext.BillingAccount.SuspendedState with record BillingAccount.SuspendedData(accountId = accountSuspended.accountId, suspendedAt = accountSuspended.suspendedAt)
      set state SuspendedState to "initialize BillingAccount.SuspendedData fields from the creating message"
    }
    on accountReactivated: event AccountReactivated is {
      morph entity BillingContext.BillingAccount to state BillingContext.BillingAccount.ActiveState with record BillingAccount.ActiveData(accountId = accountReactivated.accountId)
      set state ActiveState to "initialize BillingAccount.ActiveData fields from the creating message"
    }
    on accountClosed: event AccountClosed is {
      morph entity BillingContext.BillingAccount to state BillingContext.BillingAccount.ClosedState with record BillingAccount.ClosedData(accountId = accountClosed.accountId, closedAt = accountClosed.closedAt, finalBalance = accountClosed.finalBalance)
      set state ClosedState to "initialize BillingAccount.ClosedData fields from the creating message"
    }
  } with {
    briefly "Command handler for BillingAccount entity"
    described as {
      | Processes all commands for the BillingAccount entity, managing state
      | transitions and emitting appropriate events for downstream processing.
    }
  }
} with {
  briefly "Billing account aggregate root"
  described as {
    | The BillingAccount entity is the aggregate root for customer billing.
    | It maintains account status, tracks unbilled usage, manages invoices,
    | and records payments. It follows event sourcing patterns for full
    | auditability of all billing activities.
  }
}
