// Billing Context - Bounded Context for Usage Billing
context BillingContext as router is {
  inlet BillingAccountCommandStreamIn is type BillingAccountCommand  outlet BillingAccountCommandStreamOut is type BillingAccountCommand
  inlet BillingAccountResultStreamIn is result BillingAccount.BillingAccountResult  outlet BillingAccountResultStreamOut is result BillingAccount.BillingAccountResult
  handler BillingContextBoundary is {
    on createAccount: command BillingAccount.CreateAccount is {
      forward createAccount to outlet BillingContext.BillingAccountCommandStreamOut
    }
    on updateCustomerInfo: command BillingAccount.UpdateCustomerInfo is {
      forward updateCustomerInfo to outlet BillingContext.BillingAccountCommandStreamOut
    }
    on changeRatePlan: command BillingAccount.ChangeRatePlan is {
      forward changeRatePlan to outlet BillingContext.BillingAccountCommandStreamOut
    }
    on recordUsage: command BillingAccount.RecordUsage is {
      forward recordUsage to outlet BillingContext.BillingAccountCommandStreamOut
    }
    on generateInvoice: command BillingAccount.GenerateInvoice is {
      forward generateInvoice to outlet BillingContext.BillingAccountCommandStreamOut
    }
    on applyPayment: command BillingAccount.ApplyPayment is {
      forward applyPayment to outlet BillingContext.BillingAccountCommandStreamOut
    }
    on applyCredit: command BillingAccount.ApplyCredit is {
      forward applyCredit to outlet BillingContext.BillingAccountCommandStreamOut
    }
    on suspendAccount: command BillingAccount.SuspendAccount is {
      forward suspendAccount to outlet BillingContext.BillingAccountCommandStreamOut
    }
    on reactivateAccount: command BillingAccount.ReactivateAccount is {
      forward reactivateAccount to outlet BillingContext.BillingAccountCommandStreamOut
    }
    on closeAccount: command BillingAccount.CloseAccount is {
      forward closeAccount to outlet BillingContext.BillingAccountCommandStreamOut
    }
    on billingAccountResult: result BillingAccount.BillingAccountResult is {
      send billingAccountResult to outlet BillingContext.BillingAccountResultStreamOut
    }
    on other is {
      error "Unexpected message at the BillingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'BillingAccountCommand Stream Intake' is from outlet BillingContext.BillingAccountCommandStreamOut to inlet BillingContext.BillingAccount.BillingAccountCommands  connector 'BillingAccountResult Stream Egress' is from outlet BillingContext.BillingAccountRepository.BillingAccountRepositoryResponses to inlet BillingContext.BillingAccountResultStreamIn  adaptor FromCustomerPortal from context CustomerPortal is { 
    handler FromCustomerPortalHandler is {
      on event CustomerPortal.CustomerDisputedCharge is {
        do "the model receives customer disputed charge"
      }
      on event CustomerPortal.CustomerInitiatedPayment is {
        do "the model receives customer initiated payment"
      }
      on event CustomerPortal.CustomerViewedBill is {
        do "the model receives customer viewed bill"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerPortal"
      }
    } with {
      briefly "from customer portal"
      described as {
        |Carries messages from the external CustomerPortal.
      }
    }
  } with {
    briefly "CustomerPortal integration"
    described as {
      |The model's side of the CustomerPortal conversation.
    }
  }
  adaptor FromNetworkMediation from context NetworkMediation is { 
    handler FromNetworkMediationHandler is {
      on event NetworkMediation.CDRBatchReady is {
        do "the model receives cdr batch ready"
      }
      on event NetworkMediation.CDRReceived is {
        do "the model receives cdr received"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkMediation"
      }
    } with {
      briefly "from network mediation"
      described as {
        |Carries messages from the external NetworkMediation.
      }
    }
  } with {
    briefly "NetworkMediation integration"
    described as {
      |The model's side of the NetworkMediation conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.InvoiceEmailSent is {
        do "the model receives invoice email sent"
      }
      on event NotificationService.PaymentReminderSent is {
        do "the model receives payment reminder sent"
      }
      on event NotificationService.SuspensionNoticeSent is {
        do "the model receives suspension notice sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentGateway from context PaymentGateway is { 
    handler FromPaymentGatewayHandler is {
      on event PaymentGateway.PaymentFailed is {
        do "the model receives payment failed"
      }
      on event PaymentGateway.PaymentProcessed is {
        do "the model receives payment processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentGateway"
      }
    } with {
      briefly "from payment gateway"
      described as {
        |Carries messages from the external PaymentGateway.
      }
    }
  } with {
    briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor FromRatingEngine from context RatingEngine is { 
    handler FromRatingEngineHandler is {
      on event RatingEngine.RatingError is {
        do "the model receives rating error"
      }
      on event RatingEngine.UsageRated is {
        do "the model receives usage rated"
      }
      on other is {
        error "Unexpected message for adaptor FromRatingEngine"
      }
    } with {
      briefly "from rating engine"
      described as {
        |Carries messages from the external RatingEngine.
      }
    }
  } with {
    briefly "RatingEngine integration"
    described as {
      |The model's side of the RatingEngine conversation.
    }
  }
  adaptor FromTaxCalculation from context TaxCalculation is { 
    handler FromTaxCalculationHandler is {
      on event TaxCalculation.TaxesCalculated is {
        do "the model receives taxes calculated"
      }
      on other is {
        error "Unexpected message for adaptor FromTaxCalculation"
      }
    } with {
      briefly "from tax calculation"
      described as {
        |Carries messages from the external TaxCalculation.
      }
    }
  } with {
    briefly "TaxCalculation integration"
    described as {
      |The model's side of the TaxCalculation conversation.
    }
  }
  type AccountId is Id(BillingContext.BillingAccount)  with {
    briefly "Unique identifier for a billing account"
    described as {
      |References a specific customer billing account in the system.
    }
  }
  include "BillingAccount.riddl"
  // === Event Union Type ===
  // === Repository ===
  type BillingAccountRepositoryCommand is one of {
    BillingContext.BillingAccountRepository.PersistAccountClosed or BillingContext.BillingAccountRepository.PersistAccountCreated or BillingContext.BillingAccountRepository.PersistAccountReactivated or BillingContext.BillingAccountRepository.PersistAccountSuspended or BillingContext.BillingAccountRepository.PersistCreditApplied or BillingContext.BillingAccountRepository.PersistCustomerInfoUpdated or BillingContext.BillingAccountRepository.PersistInvoiceGenerated or BillingContext.BillingAccountRepository.PersistPaymentApplied or BillingContext.BillingAccountRepository.PersistRatePlanChanged or BillingContext.BillingAccountRepository.PersistUsageRecorded
  } with {
    briefly "Anything that writes BillingAccountRepository"
    described as {
      |The persistence commands BillingAccountRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository BillingAccountRepository as flow is {
    inlet BillingAccountRepositoryFromAccountSummaryProjector is type BillingAccountRepositoryCommand
    command PersistAccountClosed is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountClosed applies to.
        }
      }
    } with {
      briefly "Persist AccountClosed"
      described as {
        |Instructs this repository to apply AccountClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountCreated is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountCreated applies to.
        }
      }
    } with {
      briefly "Persist AccountCreated"
      described as {
        |Instructs this repository to apply AccountCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountReactivated is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountReactivated applies to.
        }
      }
    } with {
      briefly "Persist AccountReactivated"
      described as {
        |Instructs this repository to apply AccountReactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountSuspended is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountSuspended applies to.
        }
      }
    } with {
      briefly "Persist AccountSuspended"
      described as {
        |Instructs this repository to apply AccountSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCreditApplied is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row CreditApplied applies to.
        }
      }
    } with {
      briefly "Persist CreditApplied"
      described as {
        |Instructs this repository to apply CreditApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCustomerInfoUpdated is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row CustomerInfoUpdated applies to.
        }
      }
    } with {
      briefly "Persist CustomerInfoUpdated"
      described as {
        |Instructs this repository to apply CustomerInfoUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInvoiceGenerated is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row InvoiceGenerated applies to.
        }
      }
    } with {
      briefly "Persist InvoiceGenerated"
      described as {
        |Instructs this repository to apply InvoiceGenerated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentApplied is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentApplied applies to.
        }
      }
    } with {
      briefly "Persist PaymentApplied"
      described as {
        |Instructs this repository to apply PaymentApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRatePlanChanged is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row RatePlanChanged applies to.
        }
      }
    } with {
      briefly "Persist RatePlanChanged"
      described as {
        |Instructs this repository to apply RatePlanChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUsageRecorded is  {
      accountId: AccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row UsageRecorded applies to.
        }
      }
    } with {
      briefly "Persist UsageRecorded"
      described as {
        |Instructs this repository to apply UsageRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredBillingAccount is  {
      billingAccountId: UUID with {
        briefly "billingAccountId"
        described as {
          |The billingAccountId column of the stored billingAccount row.
        }
      }
    } with {
      briefly "Stored billingAccount row"
      described as {
        |The persistence shape of billingAccount data as this repository stores it.
      }
    }
    schema BillingAccountData is relational
      of billingaccounts as record StoredBillingAccount
        index on field StoredBillingAccount.billingAccountId
 with {
      briefly "Billing account data schema"
      described as {
        |The relational schema persisting billing account records for this repository.
      }
    }
    outlet BillingAccountRepositoryResponses is result BillingAccount.BillingAccountResult
    query FindAccountById replies result AccountResult is  {
      accountId: AccountId with {
        briefly "Account"
        described as {
          |Account identifier.
        }
      }
    } with {
      briefly "Find account by ID"
      described as {
        |Retrieves a billing account by its unique identifier.
      }
    }
    result AccountResult is  {
      accountId: AccountId with {
        briefly "Account"
        described as {
          |Account found.
        }
      }
    } with {
      briefly "Account query result"
      described as {
        |Returns the requested billing account.
      }
    }
    query FindAccountsByStatus replies result AccountsResult is  {
      status: AccountStatus with {
        briefly "Status"
        described as {
          |Account status.
        }
      }
    } with {
      briefly "Find accounts by status"
      described as {
        |Retrieves all accounts matching the specified status.
      }
    }
    result AccountsResult is  {
      accountIds: AccountId+ with {
        briefly "Accounts"
        described as {
          |Matching accounts.
        }
      }
    } with {
      briefly "Multiple accounts result"
      described as {
        |Returns a list of billing accounts.
      }
    }
    query FindOverdueAccounts replies result AccountsResult is  {
      asOfDate: Date with {
        briefly "Date"
        described as {
          |As of date.
        }
      }
    } with {
      briefly "Find accounts with overdue invoices"
      described as {
        |Retrieves accounts that have invoices past due date.
      }
    }
    query FindAccountsByCustomer replies result AccountsResult is  {
      email: EmailAddress with {
        briefly "Email"
        described as {
          |Customer email.
        }
      }
    } with {
      briefly "Find accounts by customer email"
      described as {
        |Retrieves accounts associated with a customer email address.
      }
    }
    query GetUsageForPeriod replies result UsageResult is  {
      accountId: AccountId with {
        briefly "Account"
        described as {
          |Account identifier.
        }
      }
      startDate: Date with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      endDate: Date with {
        briefly "End"
        described as {
          |Period end.
        }
      }
    } with {
      briefly "Get usage records for a billing period"
      described as {
        |Retrieves all usage records for an account within a date range.
      }
    }
    result UsageResult is  {
      usageRecords: UsageRecordId+ with {
        briefly "Records"
        described as {
          |Usage records.
        }
      }
    } with {
      briefly "Usage query result"
      described as {
        |Returns usage records for the specified period.
      }
    }
    query GetInvoiceHistory replies result InvoiceHistoryResult is  {
      accountId: AccountId with {
        briefly "Account"
        described as {
          |Account identifier.
        }
      }
      limit: Integer with {
        briefly "Limit"
        described as {
          |Max results.
        }
      }
    } with {
      briefly "Get invoice history for account"
      described as {
        |Retrieves recent invoices for the account.
      }
    }
    result InvoiceHistoryResult is  {
      invoices: InvoiceId+ with {
        briefly "Invoices"
        described as {
          |Invoice identifiers.
        }
      }
    } with {
      briefly "Invoice history result"
      described as {
        |Returns a list of invoice identifiers.
      }
    }
    handler RepositoryHandler is {
      on persistAccountClosed: command PersistAccountClosed is {
        do "apply AccountClosed to the stored row"
      }
      on persistAccountCreated: command PersistAccountCreated is {
        do "apply AccountCreated to the stored row"
      }
      on persistAccountReactivated: command PersistAccountReactivated is {
        do "apply AccountReactivated to the stored row"
      }
      on persistAccountSuspended: command PersistAccountSuspended is {
        do "apply AccountSuspended to the stored row"
      }
      on persistCreditApplied: command PersistCreditApplied is {
        do "apply CreditApplied to the stored row"
      }
      on persistCustomerInfoUpdated: command PersistCustomerInfoUpdated is {
        do "apply CustomerInfoUpdated to the stored row"
      }
      on persistInvoiceGenerated: command PersistInvoiceGenerated is {
        do "apply InvoiceGenerated to the stored row"
      }
      on persistPaymentApplied: command PersistPaymentApplied is {
        do "apply PaymentApplied to the stored row"
      }
      on persistRatePlanChanged: command PersistRatePlanChanged is {
        do "apply RatePlanChanged to the stored row"
      }
      on persistUsageRecorded: command PersistUsageRecorded is {
        do "apply UsageRecorded to the stored row"
      }
      on query GetAccountSummaryView is {
        let accountSummaryViewView: type AccountSummaryViewView = prompt("read the account summary view projection")
        reply accountSummaryViewView
      }
      on query GetDailyRevenueView is {
        let dailyRevenueViewView: type DailyRevenueViewView = prompt("read the daily revenue view projection")
        reply dailyRevenueViewView
      }
      on findAccountById: query FindAccountById is {
        reply result AccountResult(accountId = findAccountById.accountId)
      }
      on query FindAccountsByStatus is {
        let accountsResult: type AccountsResult = prompt("read the accounts from the store")
        reply accountsResult
      }
      on query FindOverdueAccounts is {
        let accountsResult: type AccountsResult = prompt("read the accounts from the store")
        reply accountsResult
      }
      on query FindAccountsByCustomer is {
        let accountsResult: type AccountsResult = prompt("read the accounts from the store")
        reply accountsResult
      }
      on query GetUsageForPeriod is {
        let usageResult: type UsageResult = prompt("read the usage from the store")
        reply usageResult
      }
      on query GetInvoiceHistory is {
        let invoiceHistoryResult: type InvoiceHistoryResult = prompt("read the invoice history from the store")
        reply invoiceHistoryResult
      }
    } with {
      briefly "Query handler for billing account repository"
      described as {
        |Handles all query operations for billing accounts.
      }
    }
  } with {
    briefly "Repository for billing account persistence"
    described as {
      | Provides persistence and query capabilities for billing accounts.
      | Supports lookups by ID, status, customer, and date ranges for
      | usage and invoice retrieval.
    }
  }
  // === Projector for Read Models ===
  query GetAccountSummaryView replies result AccountSummaryViewView is  {
    accountSummaryViewKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which account summary view to retrieve.
      }
    }
  } with {
    briefly "Get account summary view"
    described as {
      |Retrieves the account summary view projection.
    }
  }
  result AccountSummaryViewView is  {
    accountSummaryView: AccountSummaryProjector.AccountSummaryView with {
      briefly "Account summary view"
      described as {
        |The account summary view being returned.
      }
    }
  } with {
    briefly "Account summary view view"
    described as {
      |Read model view carrying the account summary view projection.
    }
  }
  projector AccountSummaryProjector as flow is {
    outlet AccountSummaryProjectorToRepository is type BillingAccountRepositoryCommand
    updates repository BillingContext.BillingAccountRepository
    inlet AccountSummaryProjectorFromBillingAccount is type BillingAccountEvent
    record AccountSummaryView is  {
      accountId: AccountId with {
        briefly "Account"
        described as {
          |Account identifier.
        }
      }
      customerName: String with {
        briefly "Name"
        described as {
          |Customer name.
        }
      }
      customerEmail: EmailAddress with {
        briefly "Email"
        described as {
          |Customer email.
        }
      }
      ratePlanName: String with {
        briefly "Plan"
        described as {
          |Rate plan name.
        }
      }
      accountStatus: AccountStatus with {
        briefly "Status"
        described as {
          |Account status.
        }
      }
      currentBalance: MonetaryAmount with {
        briefly "Balance"
        described as {
          |Current balance.
        }
      }
      unbilledUsageAmount: MonetaryAmount with {
        briefly "Unbilled"
        described as {
          |Unbilled usage.
        }
      }
      lastPaymentDate: Date? with {
        briefly "Last paid"
        described as {
          |Last payment date.
        }
      }
      lastPaymentAmount: MonetaryAmount? with {
        briefly "Last amount"
        described as {
          |Last payment.
        }
      }
      lastInvoiceDate: Date? with {
        briefly "Last invoice"
        described as {
          |Last invoice date.
        }
      }
      lastInvoiceAmount: MonetaryAmount? with {
        briefly "Invoice amount"
        described as {
          |Last invoice amount.
        }
      }
      daysPastDue: Integer with {
        briefly "Past due"
        described as {
          |Days past due.
        }
      }
    } with {
      briefly "Denormalized account summary view"
      described as {
        | A read-optimized view of account status for dashboards and
        | customer service screens. Updated from account events.
      }
    }
    handler AccountSummaryHandler is {
      on accountCreated: event BillingAccount.AccountCreated is {
        tell command BillingContext.BillingAccountRepository.PersistAccountCreated(accountId = accountCreated.accountId) to repository BillingContext.BillingAccountRepository
      }
      on customerInfoUpdated: event BillingAccount.CustomerInfoUpdated is {
        tell command BillingContext.BillingAccountRepository.PersistCustomerInfoUpdated(accountId = customerInfoUpdated.accountId) to repository BillingContext.BillingAccountRepository
      }
      on ratePlanChanged: event BillingAccount.RatePlanChanged is {
        tell command BillingContext.BillingAccountRepository.PersistRatePlanChanged(accountId = ratePlanChanged.accountId) to repository BillingContext.BillingAccountRepository
      }
      on usageRecorded: event BillingAccount.UsageRecorded is {
        tell command BillingContext.BillingAccountRepository.PersistUsageRecorded(accountId = usageRecorded.accountId) to repository BillingContext.BillingAccountRepository
      }
      on invoiceGenerated: event BillingAccount.InvoiceGenerated is {
        tell command BillingContext.BillingAccountRepository.PersistInvoiceGenerated(accountId = invoiceGenerated.accountId) to repository BillingContext.BillingAccountRepository
      }
      on paymentApplied: event BillingAccount.PaymentApplied is {
        tell command BillingContext.BillingAccountRepository.PersistPaymentApplied(accountId = paymentApplied.accountId) to repository BillingContext.BillingAccountRepository
      }
      on creditApplied: event BillingAccount.CreditApplied is {
        tell command BillingContext.BillingAccountRepository.PersistCreditApplied(accountId = creditApplied.accountId) to repository BillingContext.BillingAccountRepository
      }
      on accountSuspended: event BillingAccount.AccountSuspended is {
        tell command BillingContext.BillingAccountRepository.PersistAccountSuspended(accountId = accountSuspended.accountId) to repository BillingContext.BillingAccountRepository
      }
      on accountReactivated: event BillingAccount.AccountReactivated is {
        tell command BillingContext.BillingAccountRepository.PersistAccountReactivated(accountId = accountReactivated.accountId) to repository BillingContext.BillingAccountRepository
      }
      on accountClosed: event BillingAccount.AccountClosed is {
        tell command BillingContext.BillingAccountRepository.PersistAccountClosed(accountId = accountClosed.accountId) to repository BillingContext.BillingAccountRepository
      }
    } with {
      briefly "Event handler for account summary projection"
      described as {
        |Processes account events to maintain the summary read model.
      }
    }
  } with {
    briefly "Projector for account summary read model"
    described as {
      | Maintains a denormalized, read-optimized view of account status.
      | This CQRS read model is updated from account events and provides
      | fast access for dashboards, reports, and customer service screens.
    }
  }
  // === Revenue Analytics Projector ===
  query GetDailyRevenueView replies result DailyRevenueViewView is  {
    dailyRevenueViewKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily revenue view to retrieve.
      }
    }
  } with {
    briefly "Get daily revenue view"
    described as {
      |Retrieves the daily revenue view projection.
    }
  }
  result DailyRevenueViewView is  {
    dailyRevenueView: RevenueAnalyticsProjector.DailyRevenueView with {
      briefly "Daily revenue view"
      described as {
        |The daily revenue view being returned.
      }
    }
  } with {
    briefly "Daily revenue view view"
    described as {
      |Read model view carrying the daily revenue view projection.
    }
  }
  projector RevenueAnalyticsProjector as sink is {
    updates repository BillingContext.BillingAccountRepository
    inlet RevenueAnalyticsProjectorFromBillingAccount is type BillingAccountEvent
    record DailyRevenueView is  {
      date: Date with {
        briefly "Date"
        described as {
          |Revenue date.
        }
      }
      totalInvoiced: MonetaryAmount with {
        briefly "Invoiced"
        described as {
          |Total invoiced.
        }
      }
      totalCollected: MonetaryAmount with {
        briefly "Collected"
        described as {
          |Total collected.
        }
      }
      invoiceCount: Integer with {
        briefly "Invoices"
        described as {
          |Invoice count.
        }
      }
      paymentCount: Integer with {
        briefly "Payments"
        described as {
          |Payment count.
        }
      }
      averageInvoiceAmount: MonetaryAmount with {
        briefly "Average"
        described as {
          |Average invoice.
        }
      }
      usageByType: UsageTypeBreakdown+ with {
        briefly "Breakdown"
        described as {
          |Usage breakdown.
        }
      }
    } with {
      briefly "Daily revenue metrics"
      described as {
        |Aggregated revenue data for a single day.
      }
    }
    record UsageTypeBreakdown is  {
      usageType: UsageType with {
        briefly "Type"
        described as {
          |Usage type.
        }
      }
      totalUsage: Number with {
        briefly "Usage"
        described as {
          |Total usage.
        }
      }
      totalRevenue: MonetaryAmount with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
    } with {
      briefly "Usage breakdown by type"
      described as {
        |Revenue and volume for a specific usage category.
      }
    }
    handler RevenueHandler is {
      on accountClosed: event BillingAccount.AccountClosed is {
        tell command BillingContext.BillingAccountRepository.PersistAccountClosed(accountId = accountClosed.accountId) to repository BillingContext.BillingAccountRepository
        do "apply AccountClosed to the RevenueAnalyticsProjector projection"
      }
      on accountCreated: event BillingAccount.AccountCreated is {
        tell command BillingContext.BillingAccountRepository.PersistAccountCreated(accountId = accountCreated.accountId) to repository BillingContext.BillingAccountRepository
        do "apply AccountCreated to the RevenueAnalyticsProjector projection"
      }
      on accountReactivated: event BillingAccount.AccountReactivated is {
        tell command BillingContext.BillingAccountRepository.PersistAccountReactivated(accountId = accountReactivated.accountId) to repository BillingContext.BillingAccountRepository
        do "apply AccountReactivated to the RevenueAnalyticsProjector projection"
      }
      on accountSuspended: event BillingAccount.AccountSuspended is {
        tell command BillingContext.BillingAccountRepository.PersistAccountSuspended(accountId = accountSuspended.accountId) to repository BillingContext.BillingAccountRepository
        do "apply AccountSuspended to the RevenueAnalyticsProjector projection"
      }
      on creditApplied: event BillingAccount.CreditApplied is {
        tell command BillingContext.BillingAccountRepository.PersistCreditApplied(accountId = creditApplied.accountId) to repository BillingContext.BillingAccountRepository
        do "apply CreditApplied to the RevenueAnalyticsProjector projection"
      }
      on customerInfoUpdated: event BillingAccount.CustomerInfoUpdated is {
        tell command BillingContext.BillingAccountRepository.PersistCustomerInfoUpdated(accountId = customerInfoUpdated.accountId) to repository BillingContext.BillingAccountRepository
        do "apply CustomerInfoUpdated to the RevenueAnalyticsProjector projection"
      }
      on ratePlanChanged: event BillingAccount.RatePlanChanged is {
        tell command BillingContext.BillingAccountRepository.PersistRatePlanChanged(accountId = ratePlanChanged.accountId) to repository BillingContext.BillingAccountRepository
        do "apply RatePlanChanged to the RevenueAnalyticsProjector projection"
      }
      on invoiceGenerated: event BillingAccount.InvoiceGenerated is {
        tell command BillingContext.BillingAccountRepository.PersistInvoiceGenerated(accountId = invoiceGenerated.accountId) to repository BillingContext.BillingAccountRepository
      }
      on paymentApplied: event BillingAccount.PaymentApplied is {
        tell command BillingContext.BillingAccountRepository.PersistPaymentApplied(accountId = paymentApplied.accountId) to repository BillingContext.BillingAccountRepository
      }
      on usageRecorded: event BillingAccount.UsageRecorded is {
        tell command BillingContext.BillingAccountRepository.PersistUsageRecorded(accountId = usageRecorded.accountId) to repository BillingContext.BillingAccountRepository
      }
    } with {
      briefly "Event handler for revenue analytics"
      described as {
        |Processes billing events to maintain revenue metrics.
      }
    }
  } with {
    briefly "Projector for revenue analytics read model"
    described as {
      | Maintains aggregated revenue metrics for business intelligence
      | and financial reporting. Tracks invoiced and collected revenue
      | with breakdowns by usage type.
    }
  }
  // ---- Event publication for BillingAccount ----
  type BillingAccountEvent is one of {
    BillingContext.BillingAccount.AccountCreated or BillingContext.BillingAccount.CustomerInfoUpdated or BillingContext.BillingAccount.RatePlanChanged or BillingContext.BillingAccount.UsageRecorded or BillingContext.BillingAccount.InvoiceGenerated or BillingContext.BillingAccount.PaymentApplied or BillingContext.BillingAccount.CreditApplied or BillingContext.BillingAccount.AccountSuspended or BillingContext.BillingAccount.AccountReactivated or BillingContext.BillingAccount.AccountClosed
  } with {
    briefly "BillingAccount event alternation"
    described as {
      |Union of all BillingAccount events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BillingAccountEventSplit as split is {
    inlet BillingAccountEventSplitIn is type BillingAccountEvent
    outlet BillingAccountEventSplitToAccountSummaryProjector is type BillingAccountEvent
    outlet BillingAccountEventSplitToRevenueAnalyticsProjector is type BillingAccountEvent
    handler BillingAccountEventSplitHandler is {
      on accountCreated: event BillingAccount.AccountCreated is {
        send accountCreated to outlet BillingAccountEventSplitToAccountSummaryProjector
        send accountCreated to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell accountCreated to entity BillingContext.BillingAccount
      }
      on customerInfoUpdated: event BillingAccount.CustomerInfoUpdated is {
        send customerInfoUpdated to outlet BillingAccountEventSplitToAccountSummaryProjector
        send customerInfoUpdated to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell customerInfoUpdated to entity BillingContext.BillingAccount
      }
      on ratePlanChanged: event BillingAccount.RatePlanChanged is {
        send ratePlanChanged to outlet BillingAccountEventSplitToAccountSummaryProjector
        send ratePlanChanged to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell ratePlanChanged to entity BillingContext.BillingAccount
      }
      on usageRecorded: event BillingAccount.UsageRecorded is {
        send usageRecorded to outlet BillingAccountEventSplitToAccountSummaryProjector
        send usageRecorded to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell usageRecorded to entity BillingContext.BillingAccount
      }
      on invoiceGenerated: event BillingAccount.InvoiceGenerated is {
        send invoiceGenerated to outlet BillingAccountEventSplitToAccountSummaryProjector
        send invoiceGenerated to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell invoiceGenerated to entity BillingContext.BillingAccount
      }
      on paymentApplied: event BillingAccount.PaymentApplied is {
        send paymentApplied to outlet BillingAccountEventSplitToAccountSummaryProjector
        send paymentApplied to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell paymentApplied to entity BillingContext.BillingAccount
      }
      on creditApplied: event BillingAccount.CreditApplied is {
        send creditApplied to outlet BillingAccountEventSplitToAccountSummaryProjector
        send creditApplied to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell creditApplied to entity BillingContext.BillingAccount
      }
      on accountSuspended: event BillingAccount.AccountSuspended is {
        send accountSuspended to outlet BillingAccountEventSplitToAccountSummaryProjector
        send accountSuspended to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell accountSuspended to entity BillingContext.BillingAccount
      }
      on accountReactivated: event BillingAccount.AccountReactivated is {
        send accountReactivated to outlet BillingAccountEventSplitToAccountSummaryProjector
        send accountReactivated to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell accountReactivated to entity BillingContext.BillingAccount
      }
      on accountClosed: event BillingAccount.AccountClosed is {
        send accountClosed to outlet BillingAccountEventSplitToAccountSummaryProjector
        send accountClosed to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell accountClosed to entity BillingContext.BillingAccount
      }
      on other is {
        error "Unexpected message for processor BillingAccountEventSplit"
      }
    } with {
      briefly "BillingAccount event fan-out handler"
      described as {
        |Delivers each BillingAccount event to all of its consumers.
      }
    }
  } with {
    briefly "BillingAccount event fan-out"
    described as {
      |Fans BillingAccount events out to the repository and projectors.
    }
  }
  connector 'BillingAccountEvent Stream' is from outlet BillingContext.BillingAccount.BillingAccountEvents2 to inlet BillingContext.BillingAccountEventSplit.BillingAccountEventSplitIn with {
    briefly "BillingAccount events, fanned out to storage and read models"
  }
  connector 'AccountSummaryProjector Feed' is from outlet BillingContext.BillingAccountEventSplit.BillingAccountEventSplitToAccountSummaryProjector to inlet BillingContext.AccountSummaryProjector.AccountSummaryProjectorFromBillingAccount with {
    briefly "BillingAccount events feeding the AccountSummaryProjector projection"
  }
  connector 'RevenueAnalyticsProjector Feed' is from outlet BillingContext.BillingAccountEventSplit.BillingAccountEventSplitToRevenueAnalyticsProjector to inlet BillingContext.RevenueAnalyticsProjector.RevenueAnalyticsProjectorFromBillingAccount with {
    briefly "BillingAccount events feeding the RevenueAnalyticsProjector projection"
  }
  connector 'AccountSummaryProjector Storage' is from outlet BillingContext.AccountSummaryProjector.AccountSummaryProjectorToRepository to inlet BillingContext.BillingAccountRepository.BillingAccountRepositoryFromAccountSummaryProjector with {
    briefly "AccountSummaryProjector updates on their way to storage"
  }
} with {
  briefly "Bounded context for telecommunications usage billing"
  described as {
    | The BillingContext encapsulates all billing-related functionality
    | including account management, usage tracking, invoice generation,
    | and payment processing. It provides repositories for persistence
    | and projectors for read-optimized views supporting dashboards
    | and analytics.
  }
}
