// Billing Context - Bounded Context for Usage Billing
context BillingContext is {
  adaptor FromCustomerPortal from context CustomerPortal is { 
    handler FromCustomerPortalHandler is {
      on event CustomerPortal.CustomerDisputedCharge is {
        do "the model receives customer disputed charge"
      }
      on event CustomerPortal.CustomerInitiatedPayment is {
        do "the model receives customer initiated payment"
      }
      on event CustomerPortal.CustomerViewedBill is {
        do "the model receives customer viewed bill"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerPortal"
      }
    } with {
      briefly "from customer portal"
      described as {
        |Carries messages from the external CustomerPortal.
      }
    }
  } with {
    briefly "CustomerPortal integration"
    described as {
      |The model's side of the CustomerPortal conversation.
    }
  }
  adaptor FromNetworkMediation from context NetworkMediation is { 
    handler FromNetworkMediationHandler is {
      on event NetworkMediation.CDRBatchReady is {
        do "the model receives cdr batch ready"
      }
      on event NetworkMediation.CDRReceived is {
        do "the model receives cdr received"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkMediation"
      }
    } with {
      briefly "from network mediation"
      described as {
        |Carries messages from the external NetworkMediation.
      }
    }
  } with {
    briefly "NetworkMediation integration"
    described as {
      |The model's side of the NetworkMediation conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.InvoiceEmailSent is {
        do "the model receives invoice email sent"
      }
      on event NotificationService.PaymentReminderSent is {
        do "the model receives payment reminder sent"
      }
      on event NotificationService.SuspensionNoticeSent is {
        do "the model receives suspension notice sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentGateway from context PaymentGateway is { 
    handler FromPaymentGatewayHandler is {
      on event PaymentGateway.PaymentFailed is {
        do "the model receives payment failed"
      }
      on event PaymentGateway.PaymentProcessed is {
        do "the model receives payment processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentGateway"
      }
    } with {
      briefly "from payment gateway"
      described as {
        |Carries messages from the external PaymentGateway.
      }
    }
  } with {
    briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor FromRatingEngine from context RatingEngine is { 
    handler FromRatingEngineHandler is {
      on event RatingEngine.RatingError is {
        do "the model receives rating error"
      }
      on event RatingEngine.UsageRated is {
        do "the model receives usage rated"
      }
      on other is {
        error "Unexpected message for adaptor FromRatingEngine"
      }
    } with {
      briefly "from rating engine"
      described as {
        |Carries messages from the external RatingEngine.
      }
    }
  } with {
    briefly "RatingEngine integration"
    described as {
      |The model's side of the RatingEngine conversation.
    }
  }
  adaptor FromTaxCalculation from context TaxCalculation is { 
    handler FromTaxCalculationHandler is {
      on event TaxCalculation.TaxesCalculated is {
        do "the model receives taxes calculated"
      }
      on other is {
        error "Unexpected message for adaptor FromTaxCalculation"
      }
    } with {
      briefly "from tax calculation"
      described as {
        |Carries messages from the external TaxCalculation.
      }
    }
  } with {
    briefly "TaxCalculation integration"
    described as {
      |The model's side of the TaxCalculation conversation.
    }
  }
  type AccountId is Id(BillingContext.BillingAccount)  with {
    briefly "Unique identifier for a billing account"
    described as {
      |References a specific customer billing account in the system.
    }
  }
  include "BillingAccount.riddl"
  // === Event Union Type ===
  type AccountEvent is one of {
    BillingAccount.AccountCreated or BillingAccount.CustomerInfoUpdated or BillingAccount.RatePlanChanged or BillingAccount.UsageRecorded or BillingAccount.InvoiceGenerated or BillingAccount.PaymentApplied or BillingAccount.CreditApplied or BillingAccount.AccountSuspended or BillingAccount.AccountReactivated or BillingAccount.AccountClosed
  } with {
    briefly "Union of all account events"
    described as {
      |All events that can be emitted by the BillingAccount entity.
    }
  }
  // === Repository ===
  repository BillingAccountRepository as merge is {
    record StoredBillingAccount is  {
      billingAccountId: UUID with {
        briefly "billingAccountId"
        described as {
          |The billingAccountId column of the stored billingAccount row.
        }
      }
    } with {
      briefly "Stored billingAccount row"
      described as {
        |The persistence shape of billingAccount data as this repository stores it.
      }
    }
    schema BillingAccountData is relational
      of billingaccounts as type StoredBillingAccount
 with {
      briefly "Billing account data schema"
      described as {
        |The relational schema persisting billing account records for this repository.
      }
    }
    inlet BillingAccountRepositoryFromBillingAccount is type BillingAccountEvent    inlet BillingAccountRepositoryFromAccountSummaryProjector is type BillingAccountEvent    inlet BillingAccountRepositoryFromRevenueAnalyticsProjector is type BillingAccountEvent    outlet BillingAccountRepositoryResponses is type BillingAccount.BillingAccountResult
    query FindAccountById is  {
      accountId: AccountId with {
        briefly "Account"
        described as {
          |Account identifier.
        }
      }
    } with {
      briefly "Find account by ID"
      described as {
        |Retrieves a billing account by its unique identifier.
      }
    }
    result AccountResult is  {
      accountId: AccountId with {
        briefly "Account"
        described as {
          |Account found.
        }
      }
    } with {
      briefly "Account query result"
      described as {
        |Returns the requested billing account.
      }
    }
    query FindAccountsByStatus is  {
      status: AccountStatus with {
        briefly "Status"
        described as {
          |Account status.
        }
      }
    } with {
      briefly "Find accounts by status"
      described as {
        |Retrieves all accounts matching the specified status.
      }
    }
    result AccountsResult is  {
      accountIds: AccountId+ with {
        briefly "Accounts"
        described as {
          |Matching accounts.
        }
      }
    } with {
      briefly "Multiple accounts result"
      described as {
        |Returns a list of billing accounts.
      }
    }
    query FindOverdueAccounts is  {
      asOfDate: Date with {
        briefly "Date"
        described as {
          |As of date.
        }
      }
    } with {
      briefly "Find accounts with overdue invoices"
      described as {
        |Retrieves accounts that have invoices past due date.
      }
    }
    query FindAccountsByCustomer is  {
      email: EmailAddress with {
        briefly "Email"
        described as {
          |Customer email.
        }
      }
    } with {
      briefly "Find accounts by customer email"
      described as {
        |Retrieves accounts associated with a customer email address.
      }
    }
    query GetUsageForPeriod is  {
      accountId: AccountId with {
        briefly "Account"
        described as {
          |Account identifier.
        }
      }
      startDate: Date with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      endDate: Date with {
        briefly "End"
        described as {
          |Period end.
        }
      }
    } with {
      briefly "Get usage records for a billing period"
      described as {
        |Retrieves all usage records for an account within a date range.
      }
    }
    result UsageResult is  {
      usageRecords: UsageRecordId+ with {
        briefly "Records"
        described as {
          |Usage records.
        }
      }
    } with {
      briefly "Usage query result"
      described as {
        |Returns usage records for the specified period.
      }
    }
    query GetInvoiceHistory is  {
      accountId: AccountId with {
        briefly "Account"
        described as {
          |Account identifier.
        }
      }
      limit: Integer with {
        briefly "Limit"
        described as {
          |Max results.
        }
      }
    } with {
      briefly "Get invoice history for account"
      described as {
        |Retrieves recent invoices for the account.
      }
    }
    result InvoiceHistoryResult is  {
      invoices: InvoiceId+ with {
        briefly "Invoices"
        described as {
          |Invoice identifiers.
        }
      }
    } with {
      briefly "Invoice history result"
      described as {
        |Returns a list of invoice identifiers.
      }
    }
    handler RepositoryHandler is {
      on query GetAccountSummaryView is {
        do "read the account summary view projection"
        yield result AccountSummaryViewView
      }
      on query GetDailyRevenueView is {
        do "read the daily revenue view projection"
        yield result DailyRevenueViewView
      }
      on query FindAccountById is {
        yield result AccountResult
      }
      on query FindAccountsByStatus is {
        yield result AccountsResult
      }
      on query FindOverdueAccounts is {
        yield result AccountsResult
      }
      on query FindAccountsByCustomer is {
        yield result AccountsResult
      }
      on query GetUsageForPeriod is {
        yield result UsageResult
      }
      on query GetInvoiceHistory is {
        yield result InvoiceHistoryResult
      }
    } with {
      briefly "Query handler for billing account repository"
      described as {
        |Handles all query operations for billing accounts.
      }
    }
  } with {
    briefly "Repository for billing account persistence"
    described as {
      | Provides persistence and query capabilities for billing accounts.
      | Supports lookups by ID, status, customer, and date ranges for
      | usage and invoice retrieval.
    }
  }
  // === Projector for Read Models ===
  query GetAccountSummaryView is  {
    accountSummaryViewKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which account summary view to retrieve.
      }
    }
  } with {
    briefly "Get account summary view"
    described as {
      |Retrieves the account summary view projection.
    }
  }
  result AccountSummaryViewView is  {
    accountSummaryView: AccountSummaryProjector.AccountSummaryView with {
      briefly "Account summary view"
      described as {
        |The account summary view being returned.
      }
    }
  } with {
    briefly "Account summary view view"
    described as {
      |Read model view carrying the account summary view projection.
    }
  }
  projector AccountSummaryProjector as flow is {
    updates repository BillingContext.BillingAccountRepository
    inlet AccountSummaryProjectorFromBillingAccount is type BillingAccountEvent    outlet AccountSummaryProjectorOut is type BillingAccountEvent
    record AccountSummaryView is  {
      accountId: AccountId with {
        briefly "Account"
        described as {
          |Account identifier.
        }
      }
      customerName: String with {
        briefly "Name"
        described as {
          |Customer name.
        }
      }
      customerEmail: EmailAddress with {
        briefly "Email"
        described as {
          |Customer email.
        }
      }
      ratePlanName: String with {
        briefly "Plan"
        described as {
          |Rate plan name.
        }
      }
      accountStatus: AccountStatus with {
        briefly "Status"
        described as {
          |Account status.
        }
      }
      currentBalance: MonetaryAmount with {
        briefly "Balance"
        described as {
          |Current balance.
        }
      }
      unbilledUsageAmount: MonetaryAmount with {
        briefly "Unbilled"
        described as {
          |Unbilled usage.
        }
      }
      lastPaymentDate: Date? with {
        briefly "Last paid"
        described as {
          |Last payment date.
        }
      }
      lastPaymentAmount: MonetaryAmount? with {
        briefly "Last amount"
        described as {
          |Last payment.
        }
      }
      lastInvoiceDate: Date? with {
        briefly "Last invoice"
        described as {
          |Last invoice date.
        }
      }
      lastInvoiceAmount: MonetaryAmount? with {
        briefly "Invoice amount"
        described as {
          |Last invoice amount.
        }
      }
      daysPastDue: Integer with {
        briefly "Past due"
        described as {
          |Days past due.
        }
      }
    } with {
      briefly "Denormalized account summary view"
      described as {
        | A read-optimized view of account status for dashboards and
        | customer service screens. Updated from account events.
      }
    }
    handler AccountSummaryHandler is {
      on event BillingAccount.AccountCreated is {
        tell event BillingAccount.AccountCreated to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.CustomerInfoUpdated is {
        tell event BillingAccount.CustomerInfoUpdated to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.RatePlanChanged is {
        tell event BillingAccount.RatePlanChanged to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.UsageRecorded is {
        tell event BillingAccount.UsageRecorded to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.InvoiceGenerated is {
        tell event BillingAccount.InvoiceGenerated to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.PaymentApplied is {
        tell event BillingAccount.PaymentApplied to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.CreditApplied is {
        tell event BillingAccount.CreditApplied to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.AccountSuspended is {
        tell event BillingAccount.AccountSuspended to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.AccountReactivated is {
        tell event BillingAccount.AccountReactivated to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.AccountClosed is {
        tell event BillingAccount.AccountClosed to repository BillingContext.BillingAccountRepository
      }
    } with {
      briefly "Event handler for account summary projection"
      described as {
        |Processes account events to maintain the summary read model.
      }
    }
  } with {
    briefly "Projector for account summary read model"
    described as {
      | Maintains a denormalized, read-optimized view of account status.
      | This CQRS read model is updated from account events and provides
      | fast access for dashboards, reports, and customer service screens.
    }
  }
  // === Revenue Analytics Projector ===
  query GetDailyRevenueView is  {
    dailyRevenueViewKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily revenue view to retrieve.
      }
    }
  } with {
    briefly "Get daily revenue view"
    described as {
      |Retrieves the daily revenue view projection.
    }
  }
  result DailyRevenueViewView is  {
    dailyRevenueView: RevenueAnalyticsProjector.DailyRevenueView with {
      briefly "Daily revenue view"
      described as {
        |The daily revenue view being returned.
      }
    }
  } with {
    briefly "Daily revenue view view"
    described as {
      |Read model view carrying the daily revenue view projection.
    }
  }
  projector RevenueAnalyticsProjector as flow is {
    updates repository BillingContext.BillingAccountRepository
    inlet RevenueAnalyticsProjectorFromBillingAccount is type BillingAccountEvent    outlet RevenueAnalyticsProjectorOut is type BillingAccountEvent
    record DailyRevenueView is  {
      date: Date with {
        briefly "Date"
        described as {
          |Revenue date.
        }
      }
      totalInvoiced: MonetaryAmount with {
        briefly "Invoiced"
        described as {
          |Total invoiced.
        }
      }
      totalCollected: MonetaryAmount with {
        briefly "Collected"
        described as {
          |Total collected.
        }
      }
      invoiceCount: Integer with {
        briefly "Invoices"
        described as {
          |Invoice count.
        }
      }
      paymentCount: Integer with {
        briefly "Payments"
        described as {
          |Payment count.
        }
      }
      averageInvoiceAmount: MonetaryAmount with {
        briefly "Average"
        described as {
          |Average invoice.
        }
      }
      usageByType: UsageTypeBreakdown+ with {
        briefly "Breakdown"
        described as {
          |Usage breakdown.
        }
      }
    } with {
      briefly "Daily revenue metrics"
      described as {
        |Aggregated revenue data for a single day.
      }
    }
    record UsageTypeBreakdown is  {
      usageType: UsageType with {
        briefly "Type"
        described as {
          |Usage type.
        }
      }
      totalUsage: Number with {
        briefly "Usage"
        described as {
          |Total usage.
        }
      }
      totalRevenue: MonetaryAmount with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
    } with {
      briefly "Usage breakdown by type"
      described as {
        |Revenue and volume for a specific usage category.
      }
    }
    handler RevenueHandler is {
      on event BillingAccount.InvoiceGenerated is {
        tell event BillingAccount.InvoiceGenerated to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.PaymentApplied is {
        tell event BillingAccount.PaymentApplied to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.UsageRecorded is {
        tell event BillingAccount.UsageRecorded to repository BillingContext.BillingAccountRepository
      }
    } with {
      briefly "Event handler for revenue analytics"
      described as {
        |Processes billing events to maintain revenue metrics.
      }
    }
  } with {
    briefly "Projector for revenue analytics read model"
    described as {
      | Maintains aggregated revenue metrics for business intelligence
      | and financial reporting. Tracks invoiced and collected revenue
      | with breakdowns by usage type.
    }
  }
  // ---- Event publication for BillingAccount ----
  type BillingAccountEvent is one of {
    BillingContext.BillingAccount.AccountCreated or BillingContext.BillingAccount.CustomerInfoUpdated or BillingContext.BillingAccount.RatePlanChanged or BillingContext.BillingAccount.UsageRecorded or BillingContext.BillingAccount.InvoiceGenerated or BillingContext.BillingAccount.PaymentApplied or BillingContext.BillingAccount.CreditApplied or BillingContext.BillingAccount.AccountSuspended or BillingContext.BillingAccount.AccountReactivated or BillingContext.BillingAccount.AccountClosed
  } with {
    briefly "BillingAccount event alternation"
    described as {
      |Union of all BillingAccount events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BillingAccountEventSource as source is {
    outlet BillingAccountEvents is type BillingAccountEvent
    handler BillingAccountSourceHandler is {
      on event BillingAccount.AccountCreated is {
        send event BillingAccount.AccountCreated to outlet BillingAccountEvents
      }
      on event BillingAccount.CustomerInfoUpdated is {
        send event BillingAccount.CustomerInfoUpdated to outlet BillingAccountEvents
      }
      on event BillingAccount.RatePlanChanged is {
        send event BillingAccount.RatePlanChanged to outlet BillingAccountEvents
      }
      on event BillingAccount.UsageRecorded is {
        send event BillingAccount.UsageRecorded to outlet BillingAccountEvents
      }
      on event BillingAccount.InvoiceGenerated is {
        send event BillingAccount.InvoiceGenerated to outlet BillingAccountEvents
      }
      on event BillingAccount.PaymentApplied is {
        send event BillingAccount.PaymentApplied to outlet BillingAccountEvents
      }
      on event BillingAccount.CreditApplied is {
        send event BillingAccount.CreditApplied to outlet BillingAccountEvents
      }
      on event BillingAccount.AccountSuspended is {
        send event BillingAccount.AccountSuspended to outlet BillingAccountEvents
      }
      on event BillingAccount.AccountReactivated is {
        send event BillingAccount.AccountReactivated to outlet BillingAccountEvents
      }
      on event BillingAccount.AccountClosed is {
        send event BillingAccount.AccountClosed to outlet BillingAccountEvents
      }
      on other is {
        error "Unexpected message for source BillingAccountEventSource"
      }
    } with {
      briefly "BillingAccount source handler"
      described as {
        |Publishes BillingAccount events onto the outlet.
      }
    }
  } with {
    briefly "BillingAccount event source"
    described as {
      |Publishes BillingAccount entity events into the streaming topology.
    }
  }
  processor BillingAccountEventSink as sink is {
    inlet BillingAccountInlet is type BillingAccountEvent    handler BillingAccountSinkHandler is {
      on event BillingAccount.AccountCreated is {
        tell event BillingAccount.AccountCreated to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.CustomerInfoUpdated is {
        tell event BillingAccount.CustomerInfoUpdated to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.RatePlanChanged is {
        tell event BillingAccount.RatePlanChanged to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.UsageRecorded is {
        tell event BillingAccount.UsageRecorded to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.InvoiceGenerated is {
        tell event BillingAccount.InvoiceGenerated to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.PaymentApplied is {
        tell event BillingAccount.PaymentApplied to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.CreditApplied is {
        tell event BillingAccount.CreditApplied to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.AccountSuspended is {
        tell event BillingAccount.AccountSuspended to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.AccountReactivated is {
        tell event BillingAccount.AccountReactivated to repository BillingContext.BillingAccountRepository
      }
      on event BillingAccount.AccountClosed is {
        tell event BillingAccount.AccountClosed to repository BillingContext.BillingAccountRepository
      }
      on other is {
        error "Unexpected message for sink BillingAccountEventSink"
      }
    } with {
      briefly "BillingAccount sink handler"
      described as {
        |Persists BillingAccount events via the repository.
      }
    }
  } with {
    briefly "BillingAccount event sink"
    described as {
      |Receives BillingAccount events for persistence.
    }
  }
  connector BillingAccountEventFlow is from outlet BillingContext.BillingAccountEventSource.BillingAccountEvents to inlet BillingContext.BillingAccountEventSink.BillingAccountInlet with {
    briefly "BillingAccount event flow"
    described as {
      |Connects the BillingAccount source to its sink.
    }
  }
  processor BillingAccountEventSplit as split is {
    inlet BillingAccountEventSplitIn is type BillingAccountEvent    outlet BillingAccountEventSplitToBillingAccountRepository is type BillingAccountEvent
    outlet BillingAccountEventSplitToAccountSummaryProjector is type BillingAccountEvent
    outlet BillingAccountEventSplitToRevenueAnalyticsProjector is type BillingAccountEvent
    handler BillingAccountEventSplitHandler is {
      on event BillingAccount.AccountCreated is {
        send event BillingAccount.AccountCreated to outlet BillingAccountEventSplitToBillingAccountRepository
        send event BillingAccount.AccountCreated to outlet BillingAccountEventSplitToAccountSummaryProjector
        send event BillingAccount.AccountCreated to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell event BillingAccount.AccountCreated to entity BillingContext.BillingAccount
      }
      on event BillingAccount.CustomerInfoUpdated is {
        send event BillingAccount.CustomerInfoUpdated to outlet BillingAccountEventSplitToBillingAccountRepository
        send event BillingAccount.CustomerInfoUpdated to outlet BillingAccountEventSplitToAccountSummaryProjector
        send event BillingAccount.CustomerInfoUpdated to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell event BillingAccount.CustomerInfoUpdated to entity BillingContext.BillingAccount
      }
      on event BillingAccount.RatePlanChanged is {
        send event BillingAccount.RatePlanChanged to outlet BillingAccountEventSplitToBillingAccountRepository
        send event BillingAccount.RatePlanChanged to outlet BillingAccountEventSplitToAccountSummaryProjector
        send event BillingAccount.RatePlanChanged to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell event BillingAccount.RatePlanChanged to entity BillingContext.BillingAccount
      }
      on event BillingAccount.UsageRecorded is {
        send event BillingAccount.UsageRecorded to outlet BillingAccountEventSplitToBillingAccountRepository
        send event BillingAccount.UsageRecorded to outlet BillingAccountEventSplitToAccountSummaryProjector
        send event BillingAccount.UsageRecorded to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell event BillingAccount.UsageRecorded to entity BillingContext.BillingAccount
      }
      on event BillingAccount.InvoiceGenerated is {
        send event BillingAccount.InvoiceGenerated to outlet BillingAccountEventSplitToBillingAccountRepository
        send event BillingAccount.InvoiceGenerated to outlet BillingAccountEventSplitToAccountSummaryProjector
        send event BillingAccount.InvoiceGenerated to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell event BillingAccount.InvoiceGenerated to entity BillingContext.BillingAccount
      }
      on event BillingAccount.PaymentApplied is {
        send event BillingAccount.PaymentApplied to outlet BillingAccountEventSplitToBillingAccountRepository
        send event BillingAccount.PaymentApplied to outlet BillingAccountEventSplitToAccountSummaryProjector
        send event BillingAccount.PaymentApplied to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell event BillingAccount.PaymentApplied to entity BillingContext.BillingAccount
      }
      on event BillingAccount.CreditApplied is {
        send event BillingAccount.CreditApplied to outlet BillingAccountEventSplitToBillingAccountRepository
        send event BillingAccount.CreditApplied to outlet BillingAccountEventSplitToAccountSummaryProjector
        send event BillingAccount.CreditApplied to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell event BillingAccount.CreditApplied to entity BillingContext.BillingAccount
      }
      on event BillingAccount.AccountSuspended is {
        send event BillingAccount.AccountSuspended to outlet BillingAccountEventSplitToBillingAccountRepository
        send event BillingAccount.AccountSuspended to outlet BillingAccountEventSplitToAccountSummaryProjector
        send event BillingAccount.AccountSuspended to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell event BillingAccount.AccountSuspended to entity BillingContext.BillingAccount
      }
      on event BillingAccount.AccountReactivated is {
        send event BillingAccount.AccountReactivated to outlet BillingAccountEventSplitToBillingAccountRepository
        send event BillingAccount.AccountReactivated to outlet BillingAccountEventSplitToAccountSummaryProjector
        send event BillingAccount.AccountReactivated to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell event BillingAccount.AccountReactivated to entity BillingContext.BillingAccount
      }
      on event BillingAccount.AccountClosed is {
        send event BillingAccount.AccountClosed to outlet BillingAccountEventSplitToBillingAccountRepository
        send event BillingAccount.AccountClosed to outlet BillingAccountEventSplitToAccountSummaryProjector
        send event BillingAccount.AccountClosed to outlet BillingAccountEventSplitToRevenueAnalyticsProjector
        tell event BillingAccount.AccountClosed to entity BillingContext.BillingAccount
      }
      on other is {
        error "Unexpected message for processor BillingAccountEventSplit"
      }
    } with {
      briefly "BillingAccount event fan-out handler"
      described as {
        |Delivers each BillingAccount event to all of its consumers.
      }
    }
  } with {
    briefly "BillingAccount event fan-out"
    described as {
      |Fans BillingAccount events out to the repository and projectors.
    }
  }
  connector 'BillingAccountEvent Stream' is from outlet BillingContext.BillingAccount.BillingAccountEvents2 to inlet BillingContext.BillingAccountEventSplit.BillingAccountEventSplitIn with {
    briefly "BillingAccount events, fanned out to storage and read models"
  }
  connector 'BillingAccountEvent Storage' is from outlet BillingContext.BillingAccountEventSplit.BillingAccountEventSplitToBillingAccountRepository to inlet BillingContext.BillingAccountRepository.BillingAccountRepositoryFromBillingAccount with {
    briefly "BillingAccount events on their way to storage"
  }
  connector 'AccountSummaryProjector Feed' is from outlet BillingContext.BillingAccountEventSplit.BillingAccountEventSplitToAccountSummaryProjector to inlet BillingContext.AccountSummaryProjector.AccountSummaryProjectorFromBillingAccount with {
    briefly "BillingAccount events feeding the AccountSummaryProjector projection"
  }
  connector 'RevenueAnalyticsProjector Feed' is from outlet BillingContext.BillingAccountEventSplit.BillingAccountEventSplitToRevenueAnalyticsProjector to inlet BillingContext.RevenueAnalyticsProjector.RevenueAnalyticsProjectorFromBillingAccount with {
    briefly "BillingAccount events feeding the RevenueAnalyticsProjector projection"
  }
  connector 'AccountSummaryProjector Storage' is from outlet BillingContext.AccountSummaryProjector.AccountSummaryProjectorOut to inlet BillingContext.BillingAccountRepository.BillingAccountRepositoryFromAccountSummaryProjector with {
    briefly "The AccountSummaryProjector projection on its way to storage"
  }
  connector 'RevenueAnalyticsProjector Storage' is from outlet BillingContext.RevenueAnalyticsProjector.RevenueAnalyticsProjectorOut to inlet BillingContext.BillingAccountRepository.BillingAccountRepositoryFromRevenueAnalyticsProjector with {
    briefly "The RevenueAnalyticsProjector projection on its way to storage"
  }
} with {
  briefly "Bounded context for telecommunications usage billing"
  described as {
    | The BillingContext encapsulates all billing-related functionality
    | including account management, usage tracking, invoice generation,
    | and payment processing. It provides repositories for persistence
    | and projectors for read-optimized views supporting dashboards
    | and analytics.
  }
}
