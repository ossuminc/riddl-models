// Usage Rating - Rating Context
context RatingContext is {
  include "types.riddl"
  include "UsageRecord.riddl"
  repository RatingRepository is {
    inlet RatingRepositoryFromUsageRecord is type UsageRecordEvent
    inlet RatingRepositoryFromRatingMetrics is type UsageRecordEvent
    outlet RatingRepositoryResponses is type UsageRecord.UsageRecordResult
    schema RatingData is relational
      of usageRecords as type UsageRecord
        index on field UsageRecord.usageRecordId
        index on field UsageRecord.accountId
        index on field UsageRecord.status
      with {
      briefly "Rating data schema"
      described as {
        |The relational schema holding rating data for the RatingRepository.
      }
    }

    handler RatingPersistence is {
      on command UsageRecord.SubmitUsageRecord is {
        tell event UsageRecord.UsageRecordSubmitted to entity RatingContext.UsageRecord
        do "Store new usage record"
      }
      on command UsageRecord.ValidateUsageRecord is {
        do "Update record to validated"
      }
      on command UsageRecord.ApplyRatePlan is {
        do "Store applied rate plan"
      }
      on command UsageRecord.CalculateCharges is {
        do "Store calculated charges"
      }
      on command UsageRecord.SubmitToBilling is {
        do "Update record to billed"
      }
    } with {
      briefly "Persists rating commands"
      described as {
        |Handles command-driven persistence for rating.
      }
    }
  } with {
    briefly "Rating data persistence"
    described as {
      |Persistent storage for usage rating.
    }
  }
  projector RatingMetrics is {
    inlet RatingMetricsFromUsageRecord is type UsageRecordEvent
    outlet RatingMetricsOut is type UsageRecordEvent
    updates repository RatingContext.RatingRepository
    record UsageMetrics is  {
      recordsReceived: Natural with {
        briefly "Received"
        described as {
          |Records received.
        }
      }
      recordsRated: Natural with {
        briefly "Rated"
        described as {
          |Records rated.
        }
      }
      recordsRejected: Natural with {
        briefly "Rejected"
        described as {
          |Records rejected.
        }
      }
      totalRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Total rated revenue.
        }
      }
      averageChargeAmount: Decimal(10,2) with {
        briefly "Avg charge"
        described as {
          |Average charge amount.
        }
      }
    } with {
      briefly "Usage metrics"
      described as {
        |Usage rating processing metrics.
      }
    }
    handler MetricsHandler is {
      on event UsageRecord.UsageRecordSubmitted is {
        tell event UsageRecord.UsageRecordSubmitted to repository RatingContext.RatingRepository
        do "Increment records received"
      }
      on event UsageRecord.ChargesCalculated is {
        tell event UsageRecord.ChargesCalculated to repository RatingContext.RatingRepository
        do "Increment records rated and accumulate revenue"
      }
      on event UsageRecord.UsageRecordRejected is {
        tell event UsageRecord.UsageRecordRejected to repository RatingContext.RatingRepository
        do "Increment records rejected"
      }
    } with {
      briefly "Maintains rating metrics"
      described as {
        |Projects events into rating metrics.
      }
    }
  } with {
    briefly "Rating metrics"
    described as {
      |Usage rating analytics and reporting.
    }
  }
  // ---- Event publication for UsageRecord ----
  type UsageRecordEvent is one of {
    RatingContext.UsageRecord.UsageRecordSubmitted,
    RatingContext.UsageRecord.UsageRecordValidated,
    RatingContext.UsageRecord.RatePlanApplied,
    RatingContext.UsageRecord.ChargesCalculated,
    RatingContext.UsageRecord.UsageRecordBilled,
    RatingContext.UsageRecord.UsageRecordDisputed,
    RatingContext.UsageRecord.UsageRecordRejected
  } with {
    briefly "UsageRecord event alternation"
    described as {
      |Union of all UsageRecord events, for streaming and event-sourced
      |persistence.
    }
  }
  processor UsageRecordEventSource as source is {
    outlet UsageRecordEvents is type UsageRecordEvent
    handler UsageRecordSourceHandler is {
      on event UsageRecord.UsageRecordSubmitted is {
        send event UsageRecord.UsageRecordSubmitted to outlet UsageRecordEvents
      }
      on event UsageRecord.UsageRecordValidated is {
        send event UsageRecord.UsageRecordValidated to outlet UsageRecordEvents
      }
      on event UsageRecord.RatePlanApplied is {
        send event UsageRecord.RatePlanApplied to outlet UsageRecordEvents
      }
      on event UsageRecord.ChargesCalculated is {
        send event UsageRecord.ChargesCalculated to outlet UsageRecordEvents
      }
      on event UsageRecord.UsageRecordBilled is {
        send event UsageRecord.UsageRecordBilled to outlet UsageRecordEvents
      }
      on event UsageRecord.UsageRecordDisputed is {
        send event UsageRecord.UsageRecordDisputed to outlet UsageRecordEvents
      }
      on event UsageRecord.UsageRecordRejected is {
        send event UsageRecord.UsageRecordRejected to outlet UsageRecordEvents
      }
      on other is {
        error "Unexpected message for source UsageRecordEventSource"
      }
    } with {
      briefly "UsageRecord source handler"
      described as {
        |Publishes UsageRecord events onto the outlet.
      }
    }
  } with {
    briefly "UsageRecord event source"
    described as {
      |Publishes UsageRecord entity events into the streaming topology.
    }
  }
  processor UsageRecordEventSink as sink is {
    inlet UsageRecordInlet is type UsageRecordEvent
    handler UsageRecordSinkHandler is {
      on event UsageRecord.UsageRecordSubmitted is {
        tell event UsageRecord.UsageRecordSubmitted to repository RatingContext.RatingRepository
      }
      on event UsageRecord.UsageRecordValidated is {
        tell event UsageRecord.UsageRecordValidated to repository RatingContext.RatingRepository
      }
      on event UsageRecord.RatePlanApplied is {
        tell event UsageRecord.RatePlanApplied to repository RatingContext.RatingRepository
      }
      on event UsageRecord.ChargesCalculated is {
        tell event UsageRecord.ChargesCalculated to repository RatingContext.RatingRepository
      }
      on event UsageRecord.UsageRecordBilled is {
        tell event UsageRecord.UsageRecordBilled to repository RatingContext.RatingRepository
      }
      on event UsageRecord.UsageRecordDisputed is {
        tell event UsageRecord.UsageRecordDisputed to repository RatingContext.RatingRepository
      }
      on event UsageRecord.UsageRecordRejected is {
        tell event UsageRecord.UsageRecordRejected to repository RatingContext.RatingRepository
      }
      on other is {
        error "Unexpected message for sink UsageRecordEventSink"
      }
    } with {
      briefly "UsageRecord sink handler"
      described as {
        |Persists UsageRecord events via the repository.
      }
    }
  } with {
    briefly "UsageRecord event sink"
    described as {
      |Receives UsageRecord events for persistence.
    }
  }
  connector UsageRecordEventFlow is {
    from outlet RatingContext.UsageRecordEventSource.UsageRecordEvents to
      inlet RatingContext.UsageRecordEventSink.UsageRecordInlet
  } with {
    briefly "UsageRecord event flow"
    described as {
      |Connects the UsageRecord source to its sink.
    }
  }
  processor UsageRecordEventSplit is {
    inlet UsageRecordEventSplitIn is type UsageRecordEvent
    outlet UsageRecordEventSplitToRatingRepository is type UsageRecordEvent
    outlet UsageRecordEventSplitToRatingMetrics is type UsageRecordEvent
    handler UsageRecordEventSplitHandler is {
      on event UsageRecord.UsageRecordSubmitted is {
        send event UsageRecord.UsageRecordSubmitted to outlet UsageRecordEventSplitToRatingRepository
        send event UsageRecord.UsageRecordSubmitted to outlet UsageRecordEventSplitToRatingMetrics
        tell event UsageRecord.UsageRecordSubmitted to entity RatingContext.UsageRecord
      }
      on event UsageRecord.UsageRecordValidated is {
        send event UsageRecord.UsageRecordValidated to outlet UsageRecordEventSplitToRatingRepository
        send event UsageRecord.UsageRecordValidated to outlet UsageRecordEventSplitToRatingMetrics
        tell event UsageRecord.UsageRecordValidated to entity RatingContext.UsageRecord
      }
      on event UsageRecord.RatePlanApplied is {
        send event UsageRecord.RatePlanApplied to outlet UsageRecordEventSplitToRatingRepository
        send event UsageRecord.RatePlanApplied to outlet UsageRecordEventSplitToRatingMetrics
        tell event UsageRecord.RatePlanApplied to entity RatingContext.UsageRecord
      }
      on event UsageRecord.ChargesCalculated is {
        send event UsageRecord.ChargesCalculated to outlet UsageRecordEventSplitToRatingRepository
        send event UsageRecord.ChargesCalculated to outlet UsageRecordEventSplitToRatingMetrics
        tell event UsageRecord.ChargesCalculated to entity RatingContext.UsageRecord
      }
      on event UsageRecord.UsageRecordBilled is {
        send event UsageRecord.UsageRecordBilled to outlet UsageRecordEventSplitToRatingRepository
        send event UsageRecord.UsageRecordBilled to outlet UsageRecordEventSplitToRatingMetrics
        tell event UsageRecord.UsageRecordBilled to entity RatingContext.UsageRecord
      }
      on event UsageRecord.UsageRecordDisputed is {
        send event UsageRecord.UsageRecordDisputed to outlet UsageRecordEventSplitToRatingRepository
        send event UsageRecord.UsageRecordDisputed to outlet UsageRecordEventSplitToRatingMetrics
        tell event UsageRecord.UsageRecordDisputed to entity RatingContext.UsageRecord
      }
      on event UsageRecord.UsageRecordRejected is {
        send event UsageRecord.UsageRecordRejected to outlet UsageRecordEventSplitToRatingRepository
        send event UsageRecord.UsageRecordRejected to outlet UsageRecordEventSplitToRatingMetrics
        tell event UsageRecord.UsageRecordRejected to entity RatingContext.UsageRecord
      }
      on other is {
        error "Unexpected message for processor UsageRecordEventSplit"
      }
    } with {
      briefly "UsageRecord event fan-out handler"
      described as {
        |Delivers each UsageRecord event to all of its consumers.
      }
    }
  } with {
    briefly "UsageRecord event fan-out"
    described as {
      |Fans UsageRecord events out to the repository and projectors.
    }
  }
  connector LinkUsageRecordToUsageRecordEventSplit is {
    from outlet RatingContext.UsageRecord.UsageRecordEvents2 to
      inlet RatingContext.UsageRecordEventSplit.UsageRecordEventSplitIn
  } with {
    briefly "LinkUsageRecordToUsageRecordEventSplit"
  }
  connector LinkUsageRecordEventSplitToRatingRepository is {
    from outlet RatingContext.UsageRecordEventSplit.UsageRecordEventSplitToRatingRepository to
      inlet RatingContext.RatingRepository.RatingRepositoryFromUsageRecord
  } with {
    briefly "LinkUsageRecordEventSplitToRatingRepository"
  }
  connector LinkUsageRecordEventSplitToRatingMetrics is {
    from outlet RatingContext.UsageRecordEventSplit.UsageRecordEventSplitToRatingMetrics to
      inlet RatingContext.RatingMetrics.RatingMetricsFromUsageRecord
  } with {
    briefly "LinkUsageRecordEventSplitToRatingMetrics"
  }
  connector LinkRatingMetricsToRatingRepository is {
    from outlet RatingContext.RatingMetrics.RatingMetricsOut to
      inlet RatingContext.RatingRepository.RatingRepositoryFromRatingMetrics
  } with {
    briefly "LinkRatingMetricsToRatingRepository"
  }
} with {
  briefly "Bounded context for usage rating"
  described as {
    |Telecom usage rating and charge calculation context.
  }
}
