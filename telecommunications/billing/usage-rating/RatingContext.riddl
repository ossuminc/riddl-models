// Usage Rating - Rating Context
context RatingContext as router is {
  inlet RatingContextFromToBillingSystem is command UsageRecord.ApplyRatePlan with {
    briefly "What ToBillingSystem makes of the answers it gets"
  }
  connector 'ToBillingSystem Intake' is from outlet RatingContext.ToBillingSystem.ToBillingSystemToRatingContext to inlet RatingContext.RatingContextFromToBillingSystem with {
    briefly "Answers translated by ToBillingSystem, on their way in"
  }
  inlet RatingContextFromToNetworkMediationSystem is command UsageRecord.DisputeUsageRecord with {
    briefly "What ToNetworkMediationSystem makes of the answers it gets"
  }
  connector 'ToNetworkMediationSystem Intake' is from outlet RatingContext.ToNetworkMediationSystem.ToNetworkMediationSystemToRatingContext to inlet RatingContext.RatingContextFromToNetworkMediationSystem with {
    briefly "Answers translated by ToNetworkMediationSystem, on their way in"
  }
  inlet RatingContextFromBillingSystem is command UsageRecord.SubmitToBilling with {
    briefly "What FromBillingSystem makes of that service's news"
  }
  connector 'FromBillingSystem Intake' is from outlet RatingContext.FromBillingSystem.FromBillingSystemToRatingContext to inlet RatingContext.RatingContextFromBillingSystem with {
    briefly "What FromBillingSystem makes of that news, on its way in"
  }
  inlet UsageRecordCommandStreamIn is type UsageRecordCommand  outlet UsageRecordCommandStreamOut is type UsageRecordCommand
  inlet UsageRecordResultStreamIn is result UsageRecord.UsageRecordResult  outlet UsageRecordResultStreamOut is result UsageRecord.UsageRecordResult
  handler RatingContextBoundary is {
    on submitUsageRecord: command UsageRecord.SubmitUsageRecord is {
      send submitUsageRecord to outlet RatingContext.UsageRecordCommandStreamOut
    }
    on validateUsageRecord: command UsageRecord.ValidateUsageRecord is {
      send validateUsageRecord to outlet RatingContext.UsageRecordCommandStreamOut
    }
    on applyRatePlan: command UsageRecord.ApplyRatePlan is {
      send applyRatePlan to outlet RatingContext.UsageRecordCommandStreamOut
    }
    on calculateCharges: command UsageRecord.CalculateCharges is {
      send calculateCharges to outlet RatingContext.UsageRecordCommandStreamOut
    }
    on submitToBilling: command UsageRecord.SubmitToBilling is {
      send submitToBilling to outlet RatingContext.UsageRecordCommandStreamOut
    }
    on disputeUsageRecord: command UsageRecord.DisputeUsageRecord is {
      send disputeUsageRecord to outlet RatingContext.UsageRecordCommandStreamOut
    }
    on rejectUsageRecord: command UsageRecord.RejectUsageRecord is {
      send rejectUsageRecord to outlet RatingContext.UsageRecordCommandStreamOut
    }
    on usageRecordResult: result UsageRecord.UsageRecordResult is {
      send usageRecordResult to outlet RatingContext.UsageRecordResultStreamOut
    }
    on other is {
      error "Unexpected message at the RatingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'UsageRecordCommand Stream Intake' is from outlet RatingContext.UsageRecordCommandStreamOut to inlet RatingContext.UsageRecord.UsageRecordCommands  connector 'UsageRecordResult Stream Egress' is from outlet RatingContext.RatingRepository.RatingRepositoryResponses to inlet RatingContext.UsageRecordResultStreamIn  adaptor FromBillingSystem from context BillingSystem as flow is { 
    inlet FromBillingSystemIn is event BillingSystem.RatedUsageAccepted    outlet FromBillingSystemToRatingContext is command UsageRecord.SubmitToBilling
    handler FromBillingSystemHandler is {
      on ratedUsageAccepted: event BillingSystem.RatedUsageAccepted is {
        let item0: type UsageRecord.SubmitToBilling = prompt("translate the ratedUsageAccepted event into a SubmitToBilling, billing accepting the rated usage is what marks the record submitted")
        send item0 to outlet RatingContext.FromBillingSystem.FromBillingSystemToRatingContext
      }
      on other is {
        error "Unexpected message for adaptor FromBillingSystem"
      }
    } with {
      briefly "from billing system"
      described as {
        |Carries messages from the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor ToBillingSystem to context BillingSystem as router is { 
    outlet ToBillingSystemToRatingContext is command UsageRecord.ApplyRatePlan
    inlet ToBillingSystemIn is type UsageRecordEvent    inlet ToBillingSystemReplies is result BillingSystem.AccountRatePlan    outlet ToBillingSystemOut is type BillingSystem.BillingSystemRequest
    handler ToBillingSystemHandler is {
      on usageRecordValidated: event UsageRecord.UsageRecordValidated is {
        let askAnswer: type BillingSystem.AccountRatePlan = ask query BillingSystem.GetAccountRatePlan of context BillingSystem
        do "a validated record needing the plan its charges will be figured from"
        send command UsageRecord.ApplyRatePlan(usageRecordId = usageRecordValidated.usageRecordId, ratePlan = askAnswer.ratePlan) to outlet RatingContext.ToBillingSystem.ToBillingSystemToRatingContext
      }
      on chargesCalculated: event UsageRecord.ChargesCalculated is {
        let item0: type BillingSystem.SubmitRatedUsage = prompt("translate the chargesCalculated event into a SubmitRatedUsage, calculated charges being what billing needs")
        send item0 to outlet RatingContext.ToBillingSystem.ToBillingSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToBillingSystem"
      }
    } with {
      briefly "to billing system"
      described as {
        |Carries messages to the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor FromNetworkMediationSystem from context NetworkMediationSystem as sink is { 
    inlet FromNetworkMediationSystemIn is event NetworkMediationSystem.CallDetailRecordReceived    handler FromNetworkMediationSystemHandler is {
      on callDetailRecordReceived: event NetworkMediationSystem.CallDetailRecordReceived is {
        do "mediation has the record; validating it was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkMediationSystem"
      }
    } with {
      briefly "from network mediation system"
      described as {
        |Carries messages from the external NetworkMediationSystem.
      }
    }
  } with {
    briefly "NetworkMediationSystem integration"
    described as {
      |The model's side of the NetworkMediationSystem conversation.
    }
  }
  adaptor ToNetworkMediationSystem to context NetworkMediationSystem as router is { 
    outlet ToNetworkMediationSystemToRatingContext is command UsageRecord.DisputeUsageRecord
    inlet ToNetworkMediationSystemIn is type UsageRecordEvent    inlet ToNetworkMediationSystemReplies is result NetworkMediationSystem.MediationStatus    outlet ToNetworkMediationSystemOut is type NetworkMediationSystem.NetworkMediationSystemRequest
    handler ToNetworkMediationSystemHandler is {
      on usageRecordRejected: event UsageRecord.UsageRecordRejected is {
        let askAnswer: type NetworkMediationSystem.MediationStatus = ask query NetworkMediationSystem.GetMediationStatus of context NetworkMediationSystem
        do "a rejected record needing mediation's account of what it sent"
        when prompt("askAnswer.mediationStatus contradicts the rejection") then
          send command UsageRecord.DisputeUsageRecord(usageRecordId = usageRecordRejected.usageRecordId, reason = prompt("mediation says askAnswer.mediationStatus, which contradicts the rejection")) to outlet RatingContext.ToNetworkMediationSystem.ToNetworkMediationSystemToRatingContext
        end
      }
      on usageRecordValidated: event UsageRecord.UsageRecordValidated is {
        let item0: type NetworkMediationSystem.SendCallDetailRecord = prompt("translate the usageRecordValidated event into a SendCallDetailRecord, a validated record being what is fit to pass on")
        send item0 to outlet RatingContext.ToNetworkMediationSystem.ToNetworkMediationSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToNetworkMediationSystem"
      }
    } with {
      briefly "to network mediation system"
      described as {
        |Carries messages to the external NetworkMediationSystem.
      }
    }
  } with {
    briefly "NetworkMediationSystem integration"
    described as {
      |The model's side of the NetworkMediationSystem conversation.
    }
  }
  include "types.riddl"
  include "UsageRecord.riddl"
  type RatingRepositoryCommand is one of {
    RatingContext.RatingRepository.PersistChargesCalculated or RatingContext.RatingRepository.PersistRatePlanApplied or RatingContext.RatingRepository.PersistUsageRecordBilled or RatingContext.RatingRepository.PersistUsageRecordDisputed or RatingContext.RatingRepository.PersistUsageRecordRejected or RatingContext.RatingRepository.PersistUsageRecordSubmitted or RatingContext.RatingRepository.PersistUsageRecordValidated
  } with {
    briefly "Anything that writes RatingRepository"
    described as {
      |The persistence commands RatingRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository RatingRepository as flow is {
    inlet RatingRepositoryFromRatingMetrics is type RatingRepositoryCommand    command PersistRatePlanApplied is {
      usageRecordId: UsageRecordId with {
        briefly "Row addressed"
        described as {
          |Which stored row RatePlanApplied applies to.
        }
      }
      ratePlanId: RatePlanId? with {
        briefly "Rate plan id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      appliedAt: TimeStamp? with {
        briefly "Applied at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist RatePlanApplied"
      described as {
        |Instructs this repository to apply RatePlanApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUsageRecordBilled is {
      usageRecordId: UsageRecordId with {
        briefly "Row addressed"
        described as {
          |Which stored row UsageRecordBilled applies to.
        }
      }
      submittedAt: TimeStamp? with {
        briefly "Submitted at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist UsageRecordBilled"
      described as {
        |Instructs this repository to apply UsageRecordBilled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUsageRecordDisputed is {
      usageRecordId: UsageRecordId with {
        briefly "Row addressed"
        described as {
          |Which stored row UsageRecordDisputed applies to.
        }
      }
      reason: String(3,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      disputedAt: TimeStamp? with {
        briefly "Disputed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist UsageRecordDisputed"
      described as {
        |Instructs this repository to apply UsageRecordDisputed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUsageRecordValidated is {
      usageRecordId: UsageRecordId with {
        briefly "Row addressed"
        described as {
          |Which stored row UsageRecordValidated applies to.
        }
      }
      validatedAt: TimeStamp? with {
        briefly "Validated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist UsageRecordValidated"
      described as {
        |Instructs this repository to apply UsageRecordValidated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistChargesCalculated is {
      usageRecordId: UsageRecordId with {
        briefly "Row addressed"
        described as {
          |Which stored row ChargesCalculated applies to.
        }
      }
      totalAmount: Decimal(10,2)? with {
        briefly "Total amount"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      chargeCount: Natural? with {
        briefly "Charge count"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      calculatedAt: TimeStamp? with {
        briefly "Calculated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ChargesCalculated"
      described as {
        |Instructs this repository to apply ChargesCalculated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUsageRecordRejected is {
      usageRecordId: UsageRecordId with {
        briefly "Row addressed"
        described as {
          |Which stored row UsageRecordRejected applies to.
        }
      }
      rejection: RejectionReason? with {
        briefly "Rejection"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      rejectedAt: TimeStamp? with {
        briefly "Rejected at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist UsageRecordRejected"
      described as {
        |Instructs this repository to apply UsageRecordRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUsageRecordSubmitted is {
      usageRecordId: UsageRecordId with {
        briefly "Row addressed"
        described as {
          |Which stored row UsageRecordSubmitted applies to.
        }
      }
      accountId: AccountId? with {
        briefly "Account id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      submittedAt: TimeStamp? with {
        briefly "Submitted at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist UsageRecordSubmitted"
      described as {
        |Instructs this repository to apply UsageRecordSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet RatingRepositoryResponses is result UsageRecord.UsageRecordResult
    record StoredUsageRecord is {
      usageRecordId: UsageRecordId with {
        briefly "usageRecordId"
        described as {
          |The usageRecordId column of the stored usageRecord row.
        }
      }
      accountId: AccountId with {
        briefly "accountId"
        described as {
          |The accountId column of the stored usageRecord row.
        }
      }
      status: RatingStatus with {
        briefly "status"
        described as {
          |The status column of the stored usageRecord row.
        }
      }
      ratePlanId: RatePlanId? with {
        briefly "Rate plan id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      appliedAt: TimeStamp? with {
        briefly "Applied at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      submittedAt: TimeStamp? with {
        briefly "Submitted at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(3,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      disputedAt: TimeStamp? with {
        briefly "Disputed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      validatedAt: TimeStamp? with {
        briefly "Validated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      totalAmount: Decimal(10,2)? with {
        briefly "Total amount"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      chargeCount: Natural? with {
        briefly "Charge count"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      calculatedAt: TimeStamp? with {
        briefly "Calculated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      rejection: RejectionReason? with {
        briefly "Rejection"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      rejectedAt: TimeStamp? with {
        briefly "Rejected at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored usageRecord row"
      described as {
        |The persistence shape of usageRecord data as this repository stores it.
      }
    }
    schema RatingData is relational
      of usageRecords as record StoredUsageRecord
        key on field StoredUsageRecord.usageRecordId
        index on field StoredUsageRecord.accountId
        index on field StoredUsageRecord.status
 with {
      briefly "Rating data schema"
      described as {
        |The relational schema holding rating data for the RatingRepository.
      }
    }
    handler RatingPersistence is {
      on persistRatePlanApplied: command PersistRatePlanApplied is {
        update RatingData.usageRecords set ratePlanId = persistRatePlanApplied.ratePlanId, appliedAt = persistRatePlanApplied.appliedAt where usageRecordId == persistRatePlanApplied.usageRecordId
      }
      on persistUsageRecordBilled: command PersistUsageRecordBilled is {
        update RatingData.usageRecords set submittedAt = persistUsageRecordBilled.submittedAt where usageRecordId == persistUsageRecordBilled.usageRecordId
      }
      on persistUsageRecordDisputed: command PersistUsageRecordDisputed is {
        update RatingData.usageRecords set reason = persistUsageRecordDisputed.reason, disputedAt = persistUsageRecordDisputed.disputedAt where usageRecordId == persistUsageRecordDisputed.usageRecordId
      }
      on persistUsageRecordValidated: command PersistUsageRecordValidated is {
        update RatingData.usageRecords set validatedAt = persistUsageRecordValidated.validatedAt where usageRecordId == persistUsageRecordValidated.usageRecordId
      }
      on persistChargesCalculated: command PersistChargesCalculated is {
        update RatingData.usageRecords set totalAmount = persistChargesCalculated.totalAmount, chargeCount = persistChargesCalculated.chargeCount, calculatedAt = persistChargesCalculated.calculatedAt where usageRecordId == persistChargesCalculated.usageRecordId
      }
      on persistUsageRecordRejected: command PersistUsageRecordRejected is {
        update RatingData.usageRecords set rejection = persistUsageRecordRejected.rejection, rejectedAt = persistUsageRecordRejected.rejectedAt where usageRecordId == persistUsageRecordRejected.usageRecordId
      }
      on persistUsageRecordSubmitted: command PersistUsageRecordSubmitted is {
        update RatingData.usageRecords set accountId = persistUsageRecordSubmitted.accountId, submittedAt = persistUsageRecordSubmitted.submittedAt where usageRecordId == persistUsageRecordSubmitted.usageRecordId
      }
      on query GetUsageMetrics is {
        let usageMetricsView: type UsageMetricsView = prompt("read the usage metrics projection")
        reply usageMetricsView
      }
    } with {
      briefly "Persists rating commands"
      described as {
        |Handles command-driven persistence for rating.
      }
    }
  } with {
    briefly "Rating data persistence"
    described as {
      |Persistent storage for usage rating.
    }
  }
  query GetUsageMetrics replies result UsageMetricsView is {
    usageMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which usage metrics to retrieve.
      }
    }
  } with {
    briefly "Get usage metrics"
    described as {
      |Retrieves the usage metrics projection.
    }
  }
  result UsageMetricsView is {
    usageMetrics: RatingMetrics.UsageMetrics with {
      briefly "Usage metrics"
      described as {
        |The usage metrics being returned.
      }
    }
  } with {
    briefly "Usage metrics view"
    described as {
      |Read model view carrying the usage metrics projection.
    }
  }
  projector RatingMetrics as flow is {
    updates repository RatingContext.RatingRepository
    outlet RatingMetricsToRepository is type RatingRepositoryCommand
    inlet RatingMetricsFromUsageRecord is type UsageRecordEvent    record UsageMetrics is {
      recordsReceived: Natural with {
        briefly "Received"
        described as {
          |Records received.
        }
      }
      recordsRated: Natural with {
        briefly "Rated"
        described as {
          |Records rated.
        }
      }
      recordsRejected: Natural with {
        briefly "Rejected"
        described as {
          |Records rejected.
        }
      }
      totalRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Total rated revenue.
        }
      }
      averageChargeAmount: Decimal(10,2) with {
        briefly "Avg charge"
        described as {
          |Average charge amount.
        }
      }
    } with {
      briefly "Usage metrics"
      described as {
        |Usage rating processing metrics.
      }
    }
    handler MetricsHandler is {
      on ratePlanApplied: event UsageRecord.RatePlanApplied is {
        tell command RatingContext.RatingRepository.PersistRatePlanApplied(usageRecordId = ratePlanApplied.usageRecordId, ratePlanId = ratePlanApplied.ratePlanId, appliedAt = ratePlanApplied.appliedAt) to repository RatingContext.RatingRepository
        do "apply RatePlanApplied to the RatingMetrics projection"
      }
      on usageRecordBilled: event UsageRecord.UsageRecordBilled is {
        tell command RatingContext.RatingRepository.PersistUsageRecordBilled(usageRecordId = usageRecordBilled.usageRecordId, submittedAt = usageRecordBilled.submittedAt) to repository RatingContext.RatingRepository
        do "apply UsageRecordBilled to the RatingMetrics projection"
      }
      on usageRecordDisputed: event UsageRecord.UsageRecordDisputed is {
        tell command RatingContext.RatingRepository.PersistUsageRecordDisputed(usageRecordId = usageRecordDisputed.usageRecordId, reason = usageRecordDisputed.reason, disputedAt = usageRecordDisputed.disputedAt) to repository RatingContext.RatingRepository
        do "apply UsageRecordDisputed to the RatingMetrics projection"
      }
      on usageRecordValidated: event UsageRecord.UsageRecordValidated is {
        tell command RatingContext.RatingRepository.PersistUsageRecordValidated(usageRecordId = usageRecordValidated.usageRecordId, validatedAt = usageRecordValidated.validatedAt) to repository RatingContext.RatingRepository
        do "apply UsageRecordValidated to the RatingMetrics projection"
      }
      on usageRecordSubmitted: event UsageRecord.UsageRecordSubmitted is {
        tell command RatingContext.RatingRepository.PersistUsageRecordSubmitted(usageRecordId = usageRecordSubmitted.usageRecordId, accountId = usageRecordSubmitted.accountId, submittedAt = usageRecordSubmitted.submittedAt) to repository RatingContext.RatingRepository
        do "Increment records received"
      }
      on chargesCalculated: event UsageRecord.ChargesCalculated is {
        tell command RatingContext.RatingRepository.PersistChargesCalculated(usageRecordId = chargesCalculated.usageRecordId, totalAmount = chargesCalculated.totalAmount, chargeCount = chargesCalculated.chargeCount, calculatedAt = chargesCalculated.calculatedAt) to repository RatingContext.RatingRepository
        do "Increment records rated and accumulate revenue"
      }
      on usageRecordRejected: event UsageRecord.UsageRecordRejected is {
        tell command RatingContext.RatingRepository.PersistUsageRecordRejected(usageRecordId = usageRecordRejected.usageRecordId, rejection = usageRecordRejected.rejection, rejectedAt = usageRecordRejected.rejectedAt) to repository RatingContext.RatingRepository
        do "Increment records rejected"
      }
    } with {
      briefly "Maintains rating metrics"
      described as {
        |Projects events into rating metrics.
      }
    }
  } with {
    briefly "Rating metrics"
    described as {
      |Usage rating analytics and reporting.
    }
  }
  // ---- Event publication for UsageRecord ----
  type UsageRecordEvent is one of {
    RatingContext.UsageRecord.UsageRecordSubmitted or RatingContext.UsageRecord.UsageRecordValidated or RatingContext.UsageRecord.RatePlanApplied or RatingContext.UsageRecord.ChargesCalculated or RatingContext.UsageRecord.UsageRecordBilled or RatingContext.UsageRecord.UsageRecordDisputed or RatingContext.UsageRecord.UsageRecordRejected
  } with {
    briefly "UsageRecord event alternation"
    described as {
      |Union of all UsageRecord events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet UsageRecordEventSplit as split is {
    outlet UsageRecordEventSplitToToNetworkMediationSystem is type UsageRecordEvent
    outlet UsageRecordEventSplitToToBillingSystem is type UsageRecordEvent
    inlet UsageRecordEventSplitIn is type UsageRecordEvent    outlet UsageRecordEventSplitToRatingMetrics is type UsageRecordEvent
    handler UsageRecordEventSplitHandler is {
      on usageRecordSubmitted: event UsageRecord.UsageRecordSubmitted is {
        send usageRecordSubmitted to outlet UsageRecordEventSplitToRatingMetrics
        tell usageRecordSubmitted to entity RatingContext.UsageRecord
      }
      on usageRecordValidated: event UsageRecord.UsageRecordValidated is {
        send usageRecordValidated to outlet UsageRecordEventSplitToRatingMetrics
        send usageRecordValidated to outlet UsageRecordEventSplitToToNetworkMediationSystem
        send usageRecordValidated to outlet UsageRecordEventSplitToToBillingSystem
        tell usageRecordValidated to entity RatingContext.UsageRecord
      }
      on ratePlanApplied: event UsageRecord.RatePlanApplied is {
        send ratePlanApplied to outlet UsageRecordEventSplitToRatingMetrics
        tell ratePlanApplied to entity RatingContext.UsageRecord
      }
      on chargesCalculated: event UsageRecord.ChargesCalculated is {
        send chargesCalculated to outlet UsageRecordEventSplitToRatingMetrics
        send chargesCalculated to outlet UsageRecordEventSplitToToBillingSystem
        tell chargesCalculated to entity RatingContext.UsageRecord
      }
      on usageRecordBilled: event UsageRecord.UsageRecordBilled is {
        send usageRecordBilled to outlet UsageRecordEventSplitToRatingMetrics
        tell usageRecordBilled to entity RatingContext.UsageRecord
      }
      on usageRecordDisputed: event UsageRecord.UsageRecordDisputed is {
        send usageRecordDisputed to outlet UsageRecordEventSplitToRatingMetrics
        tell usageRecordDisputed to entity RatingContext.UsageRecord
      }
      on usageRecordRejected: event UsageRecord.UsageRecordRejected is {
        send usageRecordRejected to outlet UsageRecordEventSplitToRatingMetrics
        send usageRecordRejected to outlet UsageRecordEventSplitToToNetworkMediationSystem
        tell usageRecordRejected to entity RatingContext.UsageRecord
      }
      on other is {
        error "Unexpected message for processor UsageRecordEventSplit"
      }
    } with {
      briefly "UsageRecord event fan-out handler"
      described as {
        |Delivers each UsageRecord event to all of its consumers.
      }
    }
  } with {
    briefly "UsageRecord event fan-out"
    described as {
      |Fans UsageRecord events out to the repository and projectors.
    }
  }
  connector 'ToNetworkMediationSystem Feed' is from outlet RatingContext.UsageRecordEventSplit.UsageRecordEventSplitToToNetworkMediationSystem to inlet RatingContext.ToNetworkMediationSystem.ToNetworkMediationSystemIn with {
    briefly "The UsageRecord events ToNetworkMediationSystem translates, on their way to it"
  }
  connector 'ToBillingSystem Feed' is from outlet RatingContext.UsageRecordEventSplit.UsageRecordEventSplitToToBillingSystem to inlet RatingContext.ToBillingSystem.ToBillingSystemIn with {
    briefly "The UsageRecord events ToBillingSystem translates, on their way to it"
  }
  connector 'UsageRecordEvent Stream' is from outlet RatingContext.UsageRecord.UsageRecordEvents2 to inlet RatingContext.UsageRecordEventSplit.UsageRecordEventSplitIn with {
    briefly "UsageRecord events, fanned out to storage and read models"
  }
  connector 'RatingMetrics Feed' is from outlet RatingContext.UsageRecordEventSplit.UsageRecordEventSplitToRatingMetrics to inlet RatingContext.RatingMetrics.RatingMetricsFromUsageRecord with {
    briefly "UsageRecord events feeding the RatingMetrics projection"
  }
  connector 'RatingMetrics Storage' is from outlet RatingContext.RatingMetrics.RatingMetricsToRepository to inlet RatingContext.RatingRepository.RatingRepositoryFromRatingMetrics with {
    briefly "RatingMetrics updates on their way to storage"
  }
} with {
