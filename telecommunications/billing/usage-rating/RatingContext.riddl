// Usage Rating - Rating Context
context RatingContext is {
  adaptor FromBillingSystem from context BillingSystem is { 
    handler FromBillingSystemHandler is {
      on result BillingSystem.AccountRatePlan is {
        do "the model receives account rate plan"
      }
      on event BillingSystem.RatedUsageAccepted is {
        do "the model receives rated usage accepted"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingSystem"
      }
    } with {
      briefly "from billing system"
      described as {
        |Carries messages from the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor ToBillingSystem to context BillingSystem is { 
    handler ToBillingSystemHandler is {
      on query BillingSystem.GetAccountRatePlan is {
        do "the model sends get account rate plan"
      }
      on command BillingSystem.SubmitRatedUsage is {
        do "the model sends submit rated usage"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingSystem"
      }
    } with {
      briefly "to billing system"
      described as {
        |Carries messages to the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor FromNetworkMediationSystem from context NetworkMediationSystem is { 
    handler FromNetworkMediationSystemHandler is {
      on event NetworkMediationSystem.CallDetailRecordReceived is {
        do "the model receives call detail record received"
      }
      on result NetworkMediationSystem.MediationStatus is {
        do "the model receives mediation status"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkMediationSystem"
      }
    } with {
      briefly "from network mediation system"
      described as {
        |Carries messages from the external NetworkMediationSystem.
      }
    }
  } with {
    briefly "NetworkMediationSystem integration"
    described as {
      |The model's side of the NetworkMediationSystem conversation.
    }
  }
  adaptor ToNetworkMediationSystem to context NetworkMediationSystem is { 
    handler ToNetworkMediationSystemHandler is {
      on query NetworkMediationSystem.GetMediationStatus is {
        do "the model sends get mediation status"
      }
      on command NetworkMediationSystem.SendCallDetailRecord is {
        do "the model sends send call detail record"
      }
      on other is {
        error "Unexpected message for adaptor ToNetworkMediationSystem"
      }
    } with {
      briefly "to network mediation system"
      described as {
        |Carries messages to the external NetworkMediationSystem.
      }
    }
  } with {
    briefly "NetworkMediationSystem integration"
    described as {
      |The model's side of the NetworkMediationSystem conversation.
    }
  }
  include "types.riddl"
  include "UsageRecord.riddl"
  repository RatingRepository as merge is {
    inlet RatingRepositoryFromUsageRecord is type UsageRecordEvent    inlet RatingRepositoryFromRatingMetrics is type UsageRecordEvent    outlet RatingRepositoryResponses is type UsageRecord.UsageRecordResult
    record StoredUsageRecord is  {
      usageRecordId: UsageRecordId with {
        briefly "usageRecordId"
        described as {
          |The usageRecordId column of the stored usageRecord row.
        }
      }
      accountId: AccountId with {
        briefly "accountId"
        described as {
          |The accountId column of the stored usageRecord row.
        }
      }
      status: RatingStatus with {
        briefly "status"
        described as {
          |The status column of the stored usageRecord row.
        }
      }
    } with {
      briefly "Stored usageRecord row"
      described as {
        |The persistence shape of usageRecord data as this repository stores it.
      }
    }
    schema RatingData is relational
      of usageRecords as type StoredUsageRecord
        index on field StoredUsageRecord.usageRecordId
        index on field StoredUsageRecord.accountId
        index on field StoredUsageRecord.status
 with {
      briefly "Rating data schema"
      described as {
        |The relational schema holding rating data for the RatingRepository.
      }
    }
    handler RatingPersistence is {
      on query GetUsageMetrics is {
        let usageMetricsView: type UsageMetricsView = prompt("read the usage metrics projection")
        reply usageMetricsView
      }
      on submitUsageRecord: command UsageRecord.SubmitUsageRecord is {
        tell event UsageRecord.UsageRecordSubmitted(usageRecordId = submitUsageRecord.usageRecordId, accountId = submitUsageRecord.accountId) to entity RatingContext.UsageRecord
        do "Store new usage record"
      }
      on command UsageRecord.ValidateUsageRecord is {
        do "Update record to validated"
      }
      on command UsageRecord.ApplyRatePlan is {
        do "Store applied rate plan"
      }
      on command UsageRecord.CalculateCharges is {
        do "Store calculated charges"
      }
      on command UsageRecord.SubmitToBilling is {
        do "Update record to billed"
      }
    } with {
      briefly "Persists rating commands"
      described as {
        |Handles command-driven persistence for rating.
      }
    }
  } with {
    briefly "Rating data persistence"
    described as {
      |Persistent storage for usage rating.
    }
  }
  query GetUsageMetrics is  {
    usageMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which usage metrics to retrieve.
      }
    }
  } with {
    briefly "Get usage metrics"
    described as {
      |Retrieves the usage metrics projection.
    }
  }
  result UsageMetricsView is  {
    usageMetrics: RatingMetrics.UsageMetrics with {
      briefly "Usage metrics"
      described as {
        |The usage metrics being returned.
      }
    }
  } with {
    briefly "Usage metrics view"
    described as {
      |Read model view carrying the usage metrics projection.
    }
  }
  projector RatingMetrics as flow is {
    updates repository RatingContext.RatingRepository
    inlet RatingMetricsFromUsageRecord is type UsageRecordEvent    outlet RatingMetricsOut is type UsageRecordEvent
    record UsageMetrics is  {
      recordsReceived: Natural with {
        briefly "Received"
        described as {
          |Records received.
        }
      }
      recordsRated: Natural with {
        briefly "Rated"
        described as {
          |Records rated.
        }
      }
      recordsRejected: Natural with {
        briefly "Rejected"
        described as {
          |Records rejected.
        }
      }
      totalRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Total rated revenue.
        }
      }
      averageChargeAmount: Decimal(10,2) with {
        briefly "Avg charge"
        described as {
          |Average charge amount.
        }
      }
    } with {
      briefly "Usage metrics"
      described as {
        |Usage rating processing metrics.
      }
    }
    handler MetricsHandler is {
      on usageRecordSubmitted: event UsageRecord.UsageRecordSubmitted is {
        tell usageRecordSubmitted to repository RatingContext.RatingRepository
        do "Increment records received"
      }
      on chargesCalculated: event UsageRecord.ChargesCalculated is {
        tell chargesCalculated to repository RatingContext.RatingRepository
        do "Increment records rated and accumulate revenue"
      }
      on usageRecordRejected: event UsageRecord.UsageRecordRejected is {
        tell usageRecordRejected to repository RatingContext.RatingRepository
        do "Increment records rejected"
      }
    } with {
      briefly "Maintains rating metrics"
      described as {
        |Projects events into rating metrics.
      }
    }
  } with {
    briefly "Rating metrics"
    described as {
      |Usage rating analytics and reporting.
    }
  }
  // ---- Event publication for UsageRecord ----
  type UsageRecordEvent is one of {
    RatingContext.UsageRecord.UsageRecordSubmitted or RatingContext.UsageRecord.UsageRecordValidated or RatingContext.UsageRecord.RatePlanApplied or RatingContext.UsageRecord.ChargesCalculated or RatingContext.UsageRecord.UsageRecordBilled or RatingContext.UsageRecord.UsageRecordDisputed or RatingContext.UsageRecord.UsageRecordRejected
  } with {
    briefly "UsageRecord event alternation"
    described as {
      |Union of all UsageRecord events, for streaming and event-sourced
      |persistence.
    }
  }
  processor UsageRecordEventSource as source is {
    outlet UsageRecordEvents is type UsageRecordEvent
    handler UsageRecordSourceHandler is {
      on usageRecordSubmitted: event UsageRecord.UsageRecordSubmitted is {
        send usageRecordSubmitted to outlet UsageRecordEvents
      }
      on usageRecordValidated: event UsageRecord.UsageRecordValidated is {
        send usageRecordValidated to outlet UsageRecordEvents
      }
      on ratePlanApplied: event UsageRecord.RatePlanApplied is {
        send ratePlanApplied to outlet UsageRecordEvents
      }
      on chargesCalculated: event UsageRecord.ChargesCalculated is {
        send chargesCalculated to outlet UsageRecordEvents
      }
      on usageRecordBilled: event UsageRecord.UsageRecordBilled is {
        send usageRecordBilled to outlet UsageRecordEvents
      }
      on usageRecordDisputed: event UsageRecord.UsageRecordDisputed is {
        send usageRecordDisputed to outlet UsageRecordEvents
      }
      on usageRecordRejected: event UsageRecord.UsageRecordRejected is {
        send usageRecordRejected to outlet UsageRecordEvents
      }
      on other is {
        error "Unexpected message for source UsageRecordEventSource"
      }
    } with {
      briefly "UsageRecord source handler"
      described as {
        |Publishes UsageRecord events onto the outlet.
      }
    }
  } with {
    briefly "UsageRecord event source"
    described as {
      |Publishes UsageRecord entity events into the streaming topology.
    }
  }
  processor UsageRecordEventSink as sink is {
    inlet UsageRecordInlet is type UsageRecordEvent    handler UsageRecordSinkHandler is {
      on usageRecordSubmitted: event UsageRecord.UsageRecordSubmitted is {
        tell usageRecordSubmitted to repository RatingContext.RatingRepository
      }
      on usageRecordValidated: event UsageRecord.UsageRecordValidated is {
        tell usageRecordValidated to repository RatingContext.RatingRepository
      }
      on ratePlanApplied: event UsageRecord.RatePlanApplied is {
        tell ratePlanApplied to repository RatingContext.RatingRepository
      }
      on chargesCalculated: event UsageRecord.ChargesCalculated is {
        tell chargesCalculated to repository RatingContext.RatingRepository
      }
      on usageRecordBilled: event UsageRecord.UsageRecordBilled is {
        tell usageRecordBilled to repository RatingContext.RatingRepository
      }
      on usageRecordDisputed: event UsageRecord.UsageRecordDisputed is {
        tell usageRecordDisputed to repository RatingContext.RatingRepository
      }
      on usageRecordRejected: event UsageRecord.UsageRecordRejected is {
        tell usageRecordRejected to repository RatingContext.RatingRepository
      }
      on other is {
        error "Unexpected message for sink UsageRecordEventSink"
      }
    } with {
      briefly "UsageRecord sink handler"
      described as {
        |Persists UsageRecord events via the repository.
      }
    }
  } with {
    briefly "UsageRecord event sink"
    described as {
      |Receives UsageRecord events for persistence.
    }
  }
  connector UsageRecordEventFlow is from outlet RatingContext.UsageRecordEventSource.UsageRecordEvents to inlet RatingContext.UsageRecordEventSink.UsageRecordInlet with {
    briefly "UsageRecord event flow"
    described as {
      |Connects the UsageRecord source to its sink.
    }
  }
  processor UsageRecordEventSplit as split is {
    inlet UsageRecordEventSplitIn is type UsageRecordEvent    outlet UsageRecordEventSplitToRatingRepository is type UsageRecordEvent
    outlet UsageRecordEventSplitToRatingMetrics is type UsageRecordEvent
    handler UsageRecordEventSplitHandler is {
      on usageRecordSubmitted: event UsageRecord.UsageRecordSubmitted is {
        send usageRecordSubmitted to outlet UsageRecordEventSplitToRatingRepository
        send usageRecordSubmitted to outlet UsageRecordEventSplitToRatingMetrics
        tell usageRecordSubmitted to entity RatingContext.UsageRecord
      }
      on usageRecordValidated: event UsageRecord.UsageRecordValidated is {
        send usageRecordValidated to outlet UsageRecordEventSplitToRatingRepository
        send usageRecordValidated to outlet UsageRecordEventSplitToRatingMetrics
        tell usageRecordValidated to entity RatingContext.UsageRecord
      }
      on ratePlanApplied: event UsageRecord.RatePlanApplied is {
        send ratePlanApplied to outlet UsageRecordEventSplitToRatingRepository
        send ratePlanApplied to outlet UsageRecordEventSplitToRatingMetrics
        tell ratePlanApplied to entity RatingContext.UsageRecord
      }
      on chargesCalculated: event UsageRecord.ChargesCalculated is {
        send chargesCalculated to outlet UsageRecordEventSplitToRatingRepository
        send chargesCalculated to outlet UsageRecordEventSplitToRatingMetrics
        tell chargesCalculated to entity RatingContext.UsageRecord
      }
      on usageRecordBilled: event UsageRecord.UsageRecordBilled is {
        send usageRecordBilled to outlet UsageRecordEventSplitToRatingRepository
        send usageRecordBilled to outlet UsageRecordEventSplitToRatingMetrics
        tell usageRecordBilled to entity RatingContext.UsageRecord
      }
      on usageRecordDisputed: event UsageRecord.UsageRecordDisputed is {
        send usageRecordDisputed to outlet UsageRecordEventSplitToRatingRepository
        send usageRecordDisputed to outlet UsageRecordEventSplitToRatingMetrics
        tell usageRecordDisputed to entity RatingContext.UsageRecord
      }
      on usageRecordRejected: event UsageRecord.UsageRecordRejected is {
        send usageRecordRejected to outlet UsageRecordEventSplitToRatingRepository
        send usageRecordRejected to outlet UsageRecordEventSplitToRatingMetrics
        tell usageRecordRejected to entity RatingContext.UsageRecord
      }
      on other is {
        error "Unexpected message for processor UsageRecordEventSplit"
      }
    } with {
      briefly "UsageRecord event fan-out handler"
      described as {
        |Delivers each UsageRecord event to all of its consumers.
      }
    }
  } with {
    briefly "UsageRecord event fan-out"
    described as {
      |Fans UsageRecord events out to the repository and projectors.
    }
  }
  connector 'UsageRecordEvent Stream' is from outlet RatingContext.UsageRecord.UsageRecordEvents2 to inlet RatingContext.UsageRecordEventSplit.UsageRecordEventSplitIn with {
    briefly "UsageRecord events, fanned out to storage and read models"
  }
  connector 'UsageRecordEvent Storage' is from outlet RatingContext.UsageRecordEventSplit.UsageRecordEventSplitToRatingRepository to inlet RatingContext.RatingRepository.RatingRepositoryFromUsageRecord with {
    briefly "UsageRecord events on their way to storage"
  }
  connector 'RatingMetrics Feed' is from outlet RatingContext.UsageRecordEventSplit.UsageRecordEventSplitToRatingMetrics to inlet RatingContext.RatingMetrics.RatingMetricsFromUsageRecord with {
    briefly "UsageRecord events feeding the RatingMetrics projection"
  }
  connector 'RatingMetrics Storage' is from outlet RatingContext.RatingMetrics.RatingMetricsOut to inlet RatingContext.RatingRepository.RatingRepositoryFromRatingMetrics with {
    briefly "The RatingMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for usage rating"
  described as {
    |Telecom usage rating and charge calculation context.
  }
}
