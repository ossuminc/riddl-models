// Usage Rating Domain Model
// Telecom usage rating and charge calculation
domain UsageRating is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user RatingAnalyst is "person monitoring usage rating processes" with {
    briefly "Rating Analyst"
    described as {
      |Analyst overseeing CDR processing and rating.
    }
  }
  user BillingOperator is "person managing billing operations" with {
    briefly "Billing Operator"
    described as {
      |Operator handling billing workflows.
    }
  }
  user RevenueManager is "person analyzing revenue and rate plans" with {
    briefly "Revenue Manager"
    described as {
      |Manager overseeing rate plans and revenue.
    }
  }
  epic UsageProcessing is {
    user RatingAnalyst wants to "to rate telecom usage records" so that "accurate charges are calculated for billing"
    case RateCallDetailRecord is {
      user RatingAnalyst wants to "to process and rate a CDR" so that "usage charges are computed correctly"
      step is "System receives" "call detail record" "from mediation" with {
        briefly "Receive CDR"
        described as {
          |Ingest raw CDR.
        }
      }
      step is "System applies" "rate plan" "to calculate charges" with {
        briefly "Apply rate"
        described as {
          |Rate the usage.
        }
      }
    } with {
      briefly "Rate a call detail record"
      described as {
        |Processing and rating a single CDR.
      }
    }
  } with {
    briefly "Usage processing"
    described as {
      |Epic for processing and rating telecom usage.
    }
  }
  include "RatingContext.riddl"
  include "external-contexts.riddl"
  application context UsageRatingApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in UsageRating are delivered.
      }
    }
    outlet AppUsageRecordCommands is type RatingContext.UsageRecord.UsageRecordCommand
    inlet AppRatingRepositoryResponses is type RatingContext.UsageRecord.UsageRecordResult    handler UsageRatingAppHandler is {
      on other is {
        error "Unexpected message for application context UsageRatingApp"
      }
    } with {
      briefly "UsageRatingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "UsageRatingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'UsageRecordCommand Stream' is from outlet UsageRatingApp.AppUsageRecordCommands to inlet RatingContext.UsageRecordCommandStreamIn with {
    briefly "UsageRecord commands from the application"
  }
  persistent connector 'UsageRecordResult Stream' is from outlet RatingContext.UsageRecordResultStreamOut to inlet UsageRatingApp.AppRatingRepositoryResponses with {
    briefly "Rating query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet UsageRatingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Usage rating domain"
  described as {
    |Telecom usage rating and charge calculation.
  }
}
