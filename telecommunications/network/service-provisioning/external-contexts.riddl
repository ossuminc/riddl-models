// Service Provisioning - External Contexts
external context NetworkInventorySystem as sink is {
  type NetworkInventorySystemRequest is one of {
    ReserveResources or GetAvailableResources
  } with {
    briefly "Everything this service can be asked"
  }
  inlet NetworkInventorySystemRequests is type NetworkInventorySystemRequest with {
    briefly "What this context asks the service to send"
  }
  handler NetworkInventorySystemBoundary is {
    on query GetAvailableResources is {
      let askAnswer: type AvailableResources = prompt("look up what GetAvailableResources asks for")
      reply askAnswer
    }
    on command ReserveResources is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context NetworkInventorySystem"
    }
  } with {
    briefly "NetworkInventorySystem boundary"
  }
  query GetAvailableResources replies result AvailableResources is {
    serviceAddress: String(1,300) with {
      briefly "Address"
      described as {
        |Service address.
      }
    }
    serviceType: ServiceType with {
      briefly "Type"
      described as {
        |Service type.
      }
    }
  } with {
    briefly "Get available resources"
    described as {
      |Finds available network resources.
    }
  }
  result AvailableResources is {
    resources: NetworkResource+ with {
      briefly "Resources"
      described as {
        |Available resources.
      }
    }
    hasCapacity: Boolean with {
      briefly "Capacity"
      described as {
        |Has capacity.
      }
    }
  } with {
    briefly "Available resources"
    described as {
      |Network resource availability.
    }
  }
  command ReserveResources is {
    orderId: ServiceOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    resources: NetworkResource+ with {
      briefly "Resources"
      described as {
        |Resources to reserve.
      }
    }
  } with {
    briefly "Reserve resources"
    described as {
      |Reserves network resources.
    }
  }
  event ResourcesReserved is {
    orderId: ServiceOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    reservedAt: TimeStamp with {
      briefly "Reserved"
      described as {
        |Reservation time.
      }
    }
  } with {
    briefly "Resources reserved"
    described as {
      |Emitted when resources are reserved.
    }
  }
} with {
  briefly "External network inventory"
  described as {
    |Network inventory management system.
  }
}
external context NetworkElementManager as sink is {
  type NetworkElementManagerRequest is one of {
    ConfigureElement or GetElementStatus
  } with {
    briefly "Everything this service can be asked"
  }
  inlet NetworkElementManagerRequests is type NetworkElementManagerRequest with {
    briefly "What this context asks the service to send"
  }
  handler NetworkElementManagerBoundary is {
    on query GetElementStatus is {
      let askAnswer: type ElementStatus = prompt("look up what GetElementStatus asks for")
      reply askAnswer
    }
    on command ConfigureElement is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context NetworkElementManager"
    }
  } with {
    briefly "NetworkElementManager boundary"
  }
  command ConfigureElement is {
    elementId: NetworkElementId with {
      briefly "Element"
      described as {
        |Element ID.
      }
    }
    configuration: String(1,5000) with {
      briefly "Config"
      described as {
        |Configuration commands.
      }
    }
  } with {
    briefly "Configure element"
    described as {
      |Configures network element.
    }
  }
  event ElementConfigured is {
    elementId: NetworkElementId with {
      briefly "Element"
      described as {
        |Element ID.
      }
    }
    configuredAt: TimeStamp with {
      briefly "Configured"
      described as {
        |Configuration time.
      }
    }
    success: Boolean with {
      briefly "Success"
      described as {
        |Configuration success.
      }
    }
  } with {
    briefly "Element configured"
    described as {
      |Emitted when element is configured.
    }
  }
  query GetElementStatus replies result ElementStatus is {
    elementId: NetworkElementId with {
      briefly "Element"
      described as {
        |Element ID.
      }
    }
  } with {
    briefly "Get element status"
    described as {
      |Gets network element status.
    }
  }
  result ElementStatus is {
    elementId: NetworkElementId with {
      briefly "Element"
      described as {
        |Element ID.
      }
    }
    elementStatus: String(1,50) with {
      briefly "Status"
      described as {
        |Element status.
      }
    }
    lastContact: TimeStamp with {
      briefly "Contact"
      described as {
        |Last contact time.
      }
    }
  } with {
    briefly "Element status"
    described as {
      |Network element status.
    }
  }
} with {
  briefly "External network element manager"
  described as {
    |Network element management system.
  }
}
external context ServiceTestingSystem as sink is {
  inlet ServiceTestingSystemRequests is command RunServiceTest with {
    briefly "What this context asks the service to send"
  }
  handler ServiceTestingSystemBoundary is {
    on command RunServiceTest is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context ServiceTestingSystem"
    }
  } with {
    briefly "ServiceTestingSystem boundary"
  }
  command RunServiceTest is {
    orderId: ServiceOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    testType: String(1,100) with {
      briefly "Type"
      described as {
        |Test type.
      }
    }
    serviceSpec: ServiceSpec with {
      briefly "Spec"
      described as {
        |Service spec.
      }
    }
  } with {
    briefly "Run service test"
    described as {
      |Runs automated service test.
    }
  }
  event TestCompleted is {
    orderId: ServiceOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    result: TestResult with {
      briefly "Result"
      described as {
        |Test result.
      }
    }
  } with {
    briefly "Test completed"
    described as {
      |Emitted when test completes.
    }
  }
} with {
  briefly "External service testing"
  described as {
    |Automated service testing system.
  }
}
