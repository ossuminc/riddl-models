// Service Provisioning - Provisioning Context
context ProvisioningContext is {
  include "types.riddl"
  include "ServiceOrder.riddl"
  repository ProvisioningRepository is {
    schema ProvisioningData is relational
      of serviceOrders as type ServiceOrder
        index on field ServiceOrder.orderId
        index on field ServiceOrder.orderInfo.customerId
        index on field ServiceOrder.status

    handler ProvisioningPersistence is {
      on command ServiceOrder.CreateOrder is {
        tell event ServiceOrder.OrderCreated to entity ProvisioningContext.ServiceOrder
        prompt "Store new service order"
      }
      on command ServiceOrder.ValidateOrder is {
        prompt "Update order to validated"
      }
      on command ServiceOrder.DesignService is {
        prompt "Store service design"
      }
      on command ServiceOrder.RecordTaskCompletion is {
        prompt "Update task status"
      }
      on command ServiceOrder.ActivateService is {
        prompt "Update order to activated"
      }
    } with {
      briefly "Persists provisioning commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Provisioning data persistence"
    described as {
      |Persistent storage for provisioning.
    }
  }
  projector ProvisioningMetrics is {
    updates repository ProvisioningContext.ProvisioningRepository
    record OrderMetrics is  {
      ordersReceived: Natural with {
        briefly "Received"
        described as {
          |Orders received.
        }
      }
      ordersActivated: Natural with {
        briefly "Activated"
        described as {
          |Orders activated.
        }
      }
      ordersFailed: Natural with {
        briefly "Failed"
        described as {
          |Orders failed.
        }
      }
      averageProvisioningTime: Decimal(8,2) with {
        briefly "Avg time"
        described as {
          |Average provisioning hours.
        }
      }
    } with {
      briefly "Order metrics"
      described as {
        |Order processing metrics.
      }
    }
    handler MetricsHandler is {
      on event ServiceOrder.OrderCreated is {
        tell event ServiceOrder.OrderCreated to repository ProvisioningContext.ProvisioningRepository
        prompt "Increment orders received"
      }
      on event ServiceOrder.ServiceActivated is {
        tell event ServiceOrder.ServiceActivated to repository ProvisioningContext.ProvisioningRepository
        prompt "Increment orders activated and calculate time"
      }
      on event ServiceOrder.OrderFailed is {
        tell event ServiceOrder.OrderFailed to repository ProvisioningContext.ProvisioningRepository
        prompt "Increment orders failed"
      }
    } with {
      briefly "Maintains provisioning metrics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Provisioning metrics"
    described as {
      |Service provisioning analytics.
    }
  }
  // ---- Event publication for ServiceOrder ----
  type ServiceOrderEvent is one of {
    ProvisioningContext.ServiceOrder.OrderCreated,
    ProvisioningContext.ServiceOrder.OrderValidated,
    ProvisioningContext.ServiceOrder.ServiceDesigned,
    ProvisioningContext.ServiceOrder.ProvisioningStarted,
    ProvisioningContext.ServiceOrder.TaskCompleted,
    ProvisioningContext.ServiceOrder.ServiceTested,
    ProvisioningContext.ServiceOrder.ServiceActivated,
    ProvisioningContext.ServiceOrder.OrderFailed,
    ProvisioningContext.ServiceOrder.OrderCancelled
  } with {
    briefly "ServiceOrder event alternation"
    described as {
      |Union of all ServiceOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  source ServiceOrderEventSource is {
    outlet ServiceOrderEvents is type ServiceOrderEvent
    handler ServiceOrderSourceHandler is {
      on event ServiceOrder.OrderCreated is {
        send event ServiceOrder.OrderCreated to outlet ServiceOrderEvents
      }
      on event ServiceOrder.OrderValidated is {
        send event ServiceOrder.OrderValidated to outlet ServiceOrderEvents
      }
      on event ServiceOrder.ServiceDesigned is {
        send event ServiceOrder.ServiceDesigned to outlet ServiceOrderEvents
      }
      on event ServiceOrder.ProvisioningStarted is {
        send event ServiceOrder.ProvisioningStarted to outlet ServiceOrderEvents
      }
      on event ServiceOrder.TaskCompleted is {
        send event ServiceOrder.TaskCompleted to outlet ServiceOrderEvents
      }
      on event ServiceOrder.ServiceTested is {
        send event ServiceOrder.ServiceTested to outlet ServiceOrderEvents
      }
      on event ServiceOrder.ServiceActivated is {
        send event ServiceOrder.ServiceActivated to outlet ServiceOrderEvents
      }
      on event ServiceOrder.OrderFailed is {
        send event ServiceOrder.OrderFailed to outlet ServiceOrderEvents
      }
      on event ServiceOrder.OrderCancelled is {
        send event ServiceOrder.OrderCancelled to outlet ServiceOrderEvents
      }
      on other is {
        error "Unexpected message for source ServiceOrderEventSource"
      }
    } with {
      briefly "ServiceOrder source handler"
      described as {
        |Publishes ServiceOrder events onto the outlet.
      }
    }
  } with {
    briefly "ServiceOrder event source"
    described as {
      |Publishes ServiceOrder entity events into the streaming topology.
    }
  }
  sink ServiceOrderEventSink is {
    inlet ServiceOrderInlet is type ServiceOrderEvent
    handler ServiceOrderSinkHandler is {
      on event ServiceOrder.OrderCreated is {
        tell event ServiceOrder.OrderCreated to repository ProvisioningContext.ProvisioningRepository
      }
      on event ServiceOrder.OrderValidated is {
        tell event ServiceOrder.OrderValidated to repository ProvisioningContext.ProvisioningRepository
      }
      on event ServiceOrder.ServiceDesigned is {
        tell event ServiceOrder.ServiceDesigned to repository ProvisioningContext.ProvisioningRepository
      }
      on event ServiceOrder.ProvisioningStarted is {
        tell event ServiceOrder.ProvisioningStarted to repository ProvisioningContext.ProvisioningRepository
      }
      on event ServiceOrder.TaskCompleted is {
        tell event ServiceOrder.TaskCompleted to repository ProvisioningContext.ProvisioningRepository
      }
      on event ServiceOrder.ServiceTested is {
        tell event ServiceOrder.ServiceTested to repository ProvisioningContext.ProvisioningRepository
      }
      on event ServiceOrder.ServiceActivated is {
        tell event ServiceOrder.ServiceActivated to repository ProvisioningContext.ProvisioningRepository
      }
      on event ServiceOrder.OrderFailed is {
        tell event ServiceOrder.OrderFailed to repository ProvisioningContext.ProvisioningRepository
      }
      on event ServiceOrder.OrderCancelled is {
        tell event ServiceOrder.OrderCancelled to repository ProvisioningContext.ProvisioningRepository
      }
      on other is {
        error "Unexpected message for sink ServiceOrderEventSink"
      }
    } with {
      briefly "ServiceOrder sink handler"
      described as {
        |Persists ServiceOrder events via the repository.
      }
    }
  } with {
    briefly "ServiceOrder event sink"
    described as {
      |Receives ServiceOrder events for persistence.
    }
  }
  connector ServiceOrderEventFlow is {
    from outlet ProvisioningContext.ServiceOrderEventSource.ServiceOrderEvents to
      inlet ProvisioningContext.ServiceOrderEventSink.ServiceOrderInlet
  } with {
    briefly "ServiceOrder event flow"
    described as {
      |Connects the ServiceOrder source to its sink.
    }
  }
} with {
  briefly "Bounded context for service provisioning"
  described as {
    |Telecom service provisioning context.
  }
}
