// Service Provisioning - Provisioning Context
context ProvisioningContext as router is {
  inlet ServiceOrderCommandStreamIn is type ServiceOrderCommand  outlet ServiceOrderCommandStreamOut is type ServiceOrderCommand
  inlet ServiceOrderResultStreamIn is result ServiceOrder.ServiceOrderResult  outlet ServiceOrderResultStreamOut is result ServiceOrder.ServiceOrderResult
  handler ProvisioningContextBoundary is {
    on createOrder: command ServiceOrder.CreateOrder is {
      send createOrder to outlet ProvisioningContext.ServiceOrderCommandStreamOut
    }
    on validateOrder: command ServiceOrder.ValidateOrder is {
      send validateOrder to outlet ProvisioningContext.ServiceOrderCommandStreamOut
    }
    on designService: command ServiceOrder.DesignService is {
      send designService to outlet ProvisioningContext.ServiceOrderCommandStreamOut
    }
    on executeProvisioning: command ServiceOrder.ExecuteProvisioning is {
      send executeProvisioning to outlet ProvisioningContext.ServiceOrderCommandStreamOut
    }
    on recordTaskCompletion: command ServiceOrder.RecordTaskCompletion is {
      send recordTaskCompletion to outlet ProvisioningContext.ServiceOrderCommandStreamOut
    }
    on testService: command ServiceOrder.TestService is {
      send testService to outlet ProvisioningContext.ServiceOrderCommandStreamOut
    }
    on activateService: command ServiceOrder.ActivateService is {
      send activateService to outlet ProvisioningContext.ServiceOrderCommandStreamOut
    }
    on failOrder: command ServiceOrder.FailOrder is {
      send failOrder to outlet ProvisioningContext.ServiceOrderCommandStreamOut
    }
    on cancelOrder: command ServiceOrder.CancelOrder is {
      send cancelOrder to outlet ProvisioningContext.ServiceOrderCommandStreamOut
    }
    on serviceOrderResult: result ServiceOrder.ServiceOrderResult is {
      send serviceOrderResult to outlet ProvisioningContext.ServiceOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the ProvisioningContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ServiceOrderCommand Stream Intake' is from outlet ProvisioningContext.ServiceOrderCommandStreamOut to inlet ProvisioningContext.ServiceOrder.ServiceOrderCommands  connector 'ServiceOrderResult Stream Egress' is from outlet ProvisioningContext.ProvisioningRepository.ProvisioningRepositoryResponses to inlet ProvisioningContext.ServiceOrderResultStreamIn  adaptor FromNetworkElementManager from context NetworkElementManager is { 
    handler FromNetworkElementManagerHandler is {
      on event NetworkElementManager.ElementConfigured is {
        do "the model receives element configured"
      }
      on result NetworkElementManager.ElementStatus is {
        do "the model receives element status"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkElementManager"
      }
    } with {
      briefly "from network element manager"
      described as {
        |Carries messages from the external NetworkElementManager.
      }
    }
  } with {
    briefly "NetworkElementManager integration"
    described as {
      |The model's side of the NetworkElementManager conversation.
    }
  }
  adaptor ToNetworkElementManager to context NetworkElementManager is { 
    handler ToNetworkElementManagerHandler is {
      on command NetworkElementManager.ConfigureElement is {
        do "the model sends configure element"
      }
      on query NetworkElementManager.GetElementStatus is {
        do "the model sends get element status"
      }
      on other is {
        error "Unexpected message for adaptor ToNetworkElementManager"
      }
    } with {
      briefly "to network element manager"
      described as {
        |Carries messages to the external NetworkElementManager.
      }
    }
  } with {
    briefly "NetworkElementManager integration"
    described as {
      |The model's side of the NetworkElementManager conversation.
    }
  }
  adaptor FromNetworkInventorySystem from context NetworkInventorySystem is { 
    handler FromNetworkInventorySystemHandler is {
      on result NetworkInventorySystem.AvailableResources is {
        do "the model receives available resources"
      }
      on event NetworkInventorySystem.ResourcesReserved is {
        do "the model receives resources reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkInventorySystem"
      }
    } with {
      briefly "from network inventory system"
      described as {
        |Carries messages from the external NetworkInventorySystem.
      }
    }
  } with {
    briefly "NetworkInventorySystem integration"
    described as {
      |The model's side of the NetworkInventorySystem conversation.
    }
  }
  adaptor ToNetworkInventorySystem to context NetworkInventorySystem is { 
    handler ToNetworkInventorySystemHandler is {
      on query NetworkInventorySystem.GetAvailableResources is {
        do "the model sends get available resources"
      }
      on command NetworkInventorySystem.ReserveResources is {
        do "the model sends reserve resources"
      }
      on other is {
        error "Unexpected message for adaptor ToNetworkInventorySystem"
      }
    } with {
      briefly "to network inventory system"
      described as {
        |Carries messages to the external NetworkInventorySystem.
      }
    }
  } with {
    briefly "NetworkInventorySystem integration"
    described as {
      |The model's side of the NetworkInventorySystem conversation.
    }
  }
  adaptor FromServiceTestingSystem from context ServiceTestingSystem is { 
    handler FromServiceTestingSystemHandler is {
      on event ServiceTestingSystem.TestCompleted is {
        do "the model receives test completed"
      }
      on other is {
        error "Unexpected message for adaptor FromServiceTestingSystem"
      }
    } with {
      briefly "from service testing system"
      described as {
        |Carries messages from the external ServiceTestingSystem.
      }
    }
  } with {
    briefly "ServiceTestingSystem integration"
    described as {
      |The model's side of the ServiceTestingSystem conversation.
    }
  }
  adaptor ToServiceTestingSystem to context ServiceTestingSystem is { 
    handler ToServiceTestingSystemHandler is {
      on command ServiceTestingSystem.RunServiceTest is {
        do "the model sends run service test"
      }
      on other is {
        error "Unexpected message for adaptor ToServiceTestingSystem"
      }
    } with {
      briefly "to service testing system"
      described as {
        |Carries messages to the external ServiceTestingSystem.
      }
    }
  } with {
    briefly "ServiceTestingSystem integration"
    described as {
      |The model's side of the ServiceTestingSystem conversation.
    }
  }
  include "types.riddl"
  include "ServiceOrder.riddl"
  type ProvisioningRepositoryCommand is one of {
    ProvisioningContext.ProvisioningRepository.PersistOrderCancelled or ProvisioningContext.ProvisioningRepository.PersistOrderCreated or ProvisioningContext.ProvisioningRepository.PersistOrderFailed or ProvisioningContext.ProvisioningRepository.PersistOrderValidated or ProvisioningContext.ProvisioningRepository.PersistProvisioningStarted or ProvisioningContext.ProvisioningRepository.PersistServiceActivated or ProvisioningContext.ProvisioningRepository.PersistServiceDesigned or ProvisioningContext.ProvisioningRepository.PersistServiceTested or ProvisioningContext.ProvisioningRepository.PersistTaskCompleted
  } with {
    briefly "Anything that writes ProvisioningRepository"
    described as {
      |The persistence commands ProvisioningRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ProvisioningRepository as flow is {
    inlet ProvisioningRepositoryFromProvisioningMetrics is type ProvisioningRepositoryCommand    command PersistOrderCancelled is {
      orderId: ServiceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCancelled applies to.
        }
      }
    } with {
      briefly "Persist OrderCancelled"
      described as {
        |Instructs this repository to apply OrderCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderValidated is {
      orderId: ServiceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderValidated applies to.
        }
      }
    } with {
      briefly "Persist OrderValidated"
      described as {
        |Instructs this repository to apply OrderValidated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProvisioningStarted is {
      orderId: ServiceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProvisioningStarted applies to.
        }
      }
    } with {
      briefly "Persist ProvisioningStarted"
      described as {
        |Instructs this repository to apply ProvisioningStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceDesigned is {
      orderId: ServiceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceDesigned applies to.
        }
      }
    } with {
      briefly "Persist ServiceDesigned"
      described as {
        |Instructs this repository to apply ServiceDesigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceTested is {
      orderId: ServiceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceTested applies to.
        }
      }
    } with {
      briefly "Persist ServiceTested"
      described as {
        |Instructs this repository to apply ServiceTested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTaskCompleted is {
      orderId: ServiceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row TaskCompleted applies to.
        }
      }
    } with {
      briefly "Persist TaskCompleted"
      described as {
        |Instructs this repository to apply TaskCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderCreated is {
      orderId: ServiceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCreated applies to.
        }
      }
    } with {
      briefly "Persist OrderCreated"
      described as {
        |Instructs this repository to apply OrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderFailed is {
      orderId: ServiceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderFailed applies to.
        }
      }
    } with {
      briefly "Persist OrderFailed"
      described as {
        |Instructs this repository to apply OrderFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceActivated is {
      orderId: ServiceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceActivated applies to.
        }
      }
    } with {
      briefly "Persist ServiceActivated"
      described as {
        |Instructs this repository to apply ServiceActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ProvisioningRepositoryResponses is result ServiceOrder.ServiceOrderResult
    record StoredServiceOrder is {
      serviceOrderId: ServiceOrderId with {
        briefly "serviceOrderId"
        described as {
          |The serviceOrderId column of the stored serviceOrder row.
        }
      }
      orderId: ServiceOrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored serviceOrder row.
        }
      }
      orderInfo: ServiceOrderInfo with {
        briefly "orderInfo"
        described as {
          |The orderInfo column of the stored serviceOrder row.
        }
      }
      status: OrderStatus with {
        briefly "status"
        described as {
          |The status column of the stored serviceOrder row.
        }
      }
    } with {
      briefly "Stored serviceOrder row"
      described as {
        |The persistence shape of serviceOrder data as this repository stores it.
      }
    }
    schema ProvisioningData is relational
      of serviceOrders as record StoredServiceOrder
        index on field StoredServiceOrder.orderId
        index on field StoredServiceOrder.orderInfo.customerId
        index on field StoredServiceOrder.status
 with {
      briefly "Provisioning data schema"
      described as {
        |The relational schema holding provisioning data for the ProvisioningRepository.
      }
    }
    handler ProvisioningPersistence is {
      on persistOrderCancelled: command PersistOrderCancelled is {
        do "apply OrderCancelled to the stored row"
      }
      on persistOrderValidated: command PersistOrderValidated is {
        do "apply OrderValidated to the stored row"
      }
      on persistProvisioningStarted: command PersistProvisioningStarted is {
        do "apply ProvisioningStarted to the stored row"
      }
      on persistServiceDesigned: command PersistServiceDesigned is {
        do "apply ServiceDesigned to the stored row"
      }
      on persistServiceTested: command PersistServiceTested is {
        do "apply ServiceTested to the stored row"
      }
      on persistTaskCompleted: command PersistTaskCompleted is {
        do "apply TaskCompleted to the stored row"
      }
      on persistOrderCreated: command PersistOrderCreated is {
        do "apply OrderCreated to the stored row"
      }
      on persistOrderFailed: command PersistOrderFailed is {
        do "apply OrderFailed to the stored row"
      }
      on persistServiceActivated: command PersistServiceActivated is {
        do "apply ServiceActivated to the stored row"
      }
      on query GetOrderMetrics is {
        let orderMetricsView: type OrderMetricsView = prompt("read the order metrics projection")
        reply orderMetricsView
      }
    } with {
      briefly "Persists provisioning commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Provisioning data persistence"
    described as {
      |Persistent storage for provisioning.
    }
  }
  query GetOrderMetrics replies result OrderMetricsView is {
    orderMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which order metrics to retrieve.
      }
    }
  } with {
    briefly "Get order metrics"
    described as {
      |Retrieves the order metrics projection.
    }
  }
  result OrderMetricsView is {
    orderMetrics: ProvisioningMetrics.OrderMetrics with {
      briefly "Order metrics"
      described as {
        |The order metrics being returned.
      }
    }
  } with {
    briefly "Order metrics view"
    described as {
      |Read model view carrying the order metrics projection.
    }
  }
  projector ProvisioningMetrics as flow is {
    updates repository ProvisioningContext.ProvisioningRepository
    outlet ProvisioningMetricsToRepository is type ProvisioningRepositoryCommand
    inlet ProvisioningMetricsFromServiceOrder is type ServiceOrderEvent    record OrderMetrics is {
      ordersReceived: Natural with {
        briefly "Received"
        described as {
          |Orders received.
        }
      }
      ordersActivated: Natural with {
        briefly "Activated"
        described as {
          |Orders activated.
        }
      }
      ordersFailed: Natural with {
        briefly "Failed"
        described as {
          |Orders failed.
        }
      }
      averageProvisioningTime: Decimal(8,2) with {
        briefly "Avg time"
        described as {
          |Average provisioning hours.
        }
      }
    } with {
      briefly "Order metrics"
      described as {
        |Order processing metrics.
      }
    }
    handler MetricsHandler is {
      on orderCancelled: event ServiceOrder.OrderCancelled is {
        tell command ProvisioningContext.ProvisioningRepository.PersistOrderCancelled(orderId = orderCancelled.orderId) to repository ProvisioningContext.ProvisioningRepository
        do "apply OrderCancelled to the ProvisioningMetrics projection"
      }
      on orderValidated: event ServiceOrder.OrderValidated is {
        tell command ProvisioningContext.ProvisioningRepository.PersistOrderValidated(orderId = orderValidated.orderId) to repository ProvisioningContext.ProvisioningRepository
        do "apply OrderValidated to the ProvisioningMetrics projection"
      }
      on provisioningStarted: event ServiceOrder.ProvisioningStarted is {
        tell command ProvisioningContext.ProvisioningRepository.PersistProvisioningStarted(orderId = provisioningStarted.orderId) to repository ProvisioningContext.ProvisioningRepository
        do "apply ProvisioningStarted to the ProvisioningMetrics projection"
      }
      on serviceDesigned: event ServiceOrder.ServiceDesigned is {
        tell command ProvisioningContext.ProvisioningRepository.PersistServiceDesigned(orderId = serviceDesigned.orderId) to repository ProvisioningContext.ProvisioningRepository
        do "apply ServiceDesigned to the ProvisioningMetrics projection"
      }
      on serviceTested: event ServiceOrder.ServiceTested is {
        tell command ProvisioningContext.ProvisioningRepository.PersistServiceTested(orderId = serviceTested.orderId) to repository ProvisioningContext.ProvisioningRepository
        do "apply ServiceTested to the ProvisioningMetrics projection"
      }
      on taskCompleted: event ServiceOrder.TaskCompleted is {
        tell command ProvisioningContext.ProvisioningRepository.PersistTaskCompleted(orderId = taskCompleted.orderId) to repository ProvisioningContext.ProvisioningRepository
        do "apply TaskCompleted to the ProvisioningMetrics projection"
      }
      on orderCreated: event ServiceOrder.OrderCreated is {
        tell command ProvisioningContext.ProvisioningRepository.PersistOrderCreated(orderId = orderCreated.orderId) to repository ProvisioningContext.ProvisioningRepository
        do "Increment orders received"
      }
      on serviceActivated: event ServiceOrder.ServiceActivated is {
        tell command ProvisioningContext.ProvisioningRepository.PersistServiceActivated(orderId = serviceActivated.orderId) to repository ProvisioningContext.ProvisioningRepository
        do "Increment orders activated and calculate time"
      }
      on orderFailed: event ServiceOrder.OrderFailed is {
        tell command ProvisioningContext.ProvisioningRepository.PersistOrderFailed(orderId = orderFailed.orderId) to repository ProvisioningContext.ProvisioningRepository
        do "Increment orders failed"
      }
    } with {
      briefly "Maintains provisioning metrics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Provisioning metrics"
    described as {
      |Service provisioning analytics.
    }
  }
  // ---- Event publication for ServiceOrder ----
  type ServiceOrderEvent is one of {
    ProvisioningContext.ServiceOrder.OrderCreated or ProvisioningContext.ServiceOrder.OrderValidated or ProvisioningContext.ServiceOrder.ServiceDesigned or ProvisioningContext.ServiceOrder.ProvisioningStarted or ProvisioningContext.ServiceOrder.TaskCompleted or ProvisioningContext.ServiceOrder.ServiceTested or ProvisioningContext.ServiceOrder.ServiceActivated or ProvisioningContext.ServiceOrder.OrderFailed or ProvisioningContext.ServiceOrder.OrderCancelled
  } with {
    briefly "ServiceOrder event alternation"
    described as {
      |Union of all ServiceOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet ServiceOrderEventSplit as flow is {
    inlet ServiceOrderEventSplitIn is type ServiceOrderEvent    outlet ServiceOrderEventSplitToProvisioningMetrics is type ServiceOrderEvent
    handler ServiceOrderEventSplitHandler is {
      on orderCreated: event ServiceOrder.OrderCreated is {
        send orderCreated to outlet ServiceOrderEventSplitToProvisioningMetrics
        tell orderCreated to entity ProvisioningContext.ServiceOrder
      }
      on orderValidated: event ServiceOrder.OrderValidated is {
        send orderValidated to outlet ServiceOrderEventSplitToProvisioningMetrics
        tell orderValidated to entity ProvisioningContext.ServiceOrder
      }
      on serviceDesigned: event ServiceOrder.ServiceDesigned is {
        send serviceDesigned to outlet ServiceOrderEventSplitToProvisioningMetrics
        tell serviceDesigned to entity ProvisioningContext.ServiceOrder
      }
      on provisioningStarted: event ServiceOrder.ProvisioningStarted is {
        send provisioningStarted to outlet ServiceOrderEventSplitToProvisioningMetrics
        tell provisioningStarted to entity ProvisioningContext.ServiceOrder
      }
      on taskCompleted: event ServiceOrder.TaskCompleted is {
        send taskCompleted to outlet ServiceOrderEventSplitToProvisioningMetrics
        tell taskCompleted to entity ProvisioningContext.ServiceOrder
      }
      on serviceTested: event ServiceOrder.ServiceTested is {
        send serviceTested to outlet ServiceOrderEventSplitToProvisioningMetrics
        tell serviceTested to entity ProvisioningContext.ServiceOrder
      }
      on serviceActivated: event ServiceOrder.ServiceActivated is {
        send serviceActivated to outlet ServiceOrderEventSplitToProvisioningMetrics
        tell serviceActivated to entity ProvisioningContext.ServiceOrder
      }
      on orderFailed: event ServiceOrder.OrderFailed is {
        send orderFailed to outlet ServiceOrderEventSplitToProvisioningMetrics
        tell orderFailed to entity ProvisioningContext.ServiceOrder
      }
      on orderCancelled: event ServiceOrder.OrderCancelled is {
        send orderCancelled to outlet ServiceOrderEventSplitToProvisioningMetrics
        tell orderCancelled to entity ProvisioningContext.ServiceOrder
      }
      on other is {
        error "Unexpected message for processor ServiceOrderEventSplit"
      }
    } with {
      briefly "ServiceOrder event fan-out handler"
      described as {
        |Delivers each ServiceOrder event to all of its consumers.
      }
    }
  } with {
    briefly "ServiceOrder event fan-out"
    described as {
      |Fans ServiceOrder events out to the repository and projectors.
    }
  }
  connector 'ServiceOrderEvent Stream' is from outlet ProvisioningContext.ServiceOrder.ServiceOrderEvents2 to inlet ProvisioningContext.ServiceOrderEventSplit.ServiceOrderEventSplitIn with {
    briefly "ServiceOrder events, fanned out to storage and read models"
  }
  connector 'ProvisioningMetrics Feed' is from outlet ProvisioningContext.ServiceOrderEventSplit.ServiceOrderEventSplitToProvisioningMetrics to inlet ProvisioningContext.ProvisioningMetrics.ProvisioningMetricsFromServiceOrder with {
    briefly "ServiceOrder events feeding the ProvisioningMetrics projection"
  }
  connector 'ProvisioningMetrics Storage' is from outlet ProvisioningContext.ProvisioningMetrics.ProvisioningMetricsToRepository to inlet ProvisioningContext.ProvisioningRepository.ProvisioningRepositoryFromProvisioningMetrics with {
    briefly "ProvisioningMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for service provisioning"
  described as {
    |Telecom service provisioning context.
  }
}
