// Equipment Inventory - Inventory Context
context InventoryContext is {
  include "types.riddl"
  include "EquipmentItem.riddl"
  repository InventoryRepository is {
    inlet InventoryRepositoryFromEquipmentItem is type EquipmentItemEvent
    inlet InventoryRepositoryFromInventoryDashboard is type EquipmentItemEvent
    outlet InventoryRepositoryResponses is type EquipmentItem.EquipmentItemResult
    schema InventoryData is relational
      of equipmentItems as type EquipmentItem
        index on field EquipmentItem.details.serialNumber
        index on field EquipmentItem.details.category
        index on field EquipmentItem.status

    handler InventoryPersistence is {
      on command EquipmentItem.RegisterEquipment is {
        do "Store new equipment item"
      }
      on command EquipmentItem.ReceiveEquipment is {
        tell event EquipmentItem.EquipmentReceived to entity InventoryContext.EquipmentItem
        do "Update item to received"
      }
      on command EquipmentItem.AllocateEquipment is {
        do "Update item allocation and site"
      }
      on command EquipmentItem.InstallEquipment is {
        do "Update item to installed"
      }
      on command EquipmentItem.RecordMaintenance is {
        tell event EquipmentItem.MaintenanceRecorded to entity InventoryContext.EquipmentItem
        do "Append maintenance record"
      }
      on command EquipmentItem.UpdateFirmware is {
        tell event EquipmentItem.FirmwareUpdated to entity InventoryContext.EquipmentItem
        do "Append firmware update record"
      }
      on command EquipmentItem.DecommissionEquipment is {
        do "Update item to decommissioned"
      }
      on command EquipmentItem.DisposeEquipment is {
        do "Update item to disposed"
      }
    } with {
      briefly "Persists inventory commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Inventory data persistence"
    described as {
      |Persistent storage for equipment inventory.
    }
  }
  projector InventoryDashboard is {
    inlet InventoryDashboardFromEquipmentItem is type EquipmentItemEvent
    outlet InventoryDashboardOut is type EquipmentItemEvent
    updates repository InventoryContext.InventoryRepository
    record InventoryMetrics is  {
      totalItems: Natural with {
        briefly "Total"
        described as {
          |Total equipment items.
        }
      }
      inServiceCount: Natural with {
        briefly "In service"
        described as {
          |Items currently in service.
        }
      }
      inWarehouseCount: Natural with {
        briefly "In warehouse"
        described as {
          |Items in warehouse.
        }
      }
      maintenanceCount: Natural with {
        briefly "In maintenance"
        described as {
          |Items under maintenance.
        }
      }
      decommissionedCount: Natural with {
        briefly "Decommissioned"
        described as {
          |Items decommissioned.
        }
      }
    } with {
      briefly "Inventory metrics"
      described as {
        |Equipment inventory metrics.
      }
    }
    handler DashboardHandler is {
      on event EquipmentItem.EquipmentRegistered is {
        tell event EquipmentItem.EquipmentRegistered to repository InventoryContext.InventoryRepository
        do "Increment total items"
      }
      on event EquipmentItem.EquipmentInstalled is {
        tell event EquipmentItem.EquipmentInstalled to repository InventoryContext.InventoryRepository
        do "Increment in-service count"
      }
      on event EquipmentItem.EquipmentDecommissioned is {
        tell event EquipmentItem.EquipmentDecommissioned to repository InventoryContext.InventoryRepository
        do "Increment decommissioned count"
      }
    } with {
      briefly "Maintains inventory dashboard"
      described as {
        |Projects events into dashboard metrics.
      }
    }
  } with {
    briefly "Inventory dashboard"
    described as {
      |Equipment inventory analytics.
    }
  }
  // ---- Event publication for EquipmentItem ----
  type EquipmentItemEvent is one of {
    InventoryContext.EquipmentItem.EquipmentRegistered,
    InventoryContext.EquipmentItem.EquipmentReceived,
    InventoryContext.EquipmentItem.EquipmentAllocated,
    InventoryContext.EquipmentItem.EquipmentInstalled,
    InventoryContext.EquipmentItem.MaintenanceRecorded,
    InventoryContext.EquipmentItem.FirmwareUpdated,
    InventoryContext.EquipmentItem.EquipmentDecommissioned,
    InventoryContext.EquipmentItem.EquipmentDisposed
  } with {
    briefly "EquipmentItem event alternation"
    described as {
      |Union of all EquipmentItem events, for streaming and event-sourced
      |persistence.
    }
  }
  processor EquipmentItemEventSource as source is {
    outlet EquipmentItemEvents is type EquipmentItemEvent
    handler EquipmentItemSourceHandler is {
      on event EquipmentItem.EquipmentRegistered is {
        send event EquipmentItem.EquipmentRegistered to outlet EquipmentItemEvents
      }
      on event EquipmentItem.EquipmentReceived is {
        send event EquipmentItem.EquipmentReceived to outlet EquipmentItemEvents
      }
      on event EquipmentItem.EquipmentAllocated is {
        send event EquipmentItem.EquipmentAllocated to outlet EquipmentItemEvents
      }
      on event EquipmentItem.EquipmentInstalled is {
        send event EquipmentItem.EquipmentInstalled to outlet EquipmentItemEvents
      }
      on event EquipmentItem.MaintenanceRecorded is {
        send event EquipmentItem.MaintenanceRecorded to outlet EquipmentItemEvents
      }
      on event EquipmentItem.FirmwareUpdated is {
        send event EquipmentItem.FirmwareUpdated to outlet EquipmentItemEvents
      }
      on event EquipmentItem.EquipmentDecommissioned is {
        send event EquipmentItem.EquipmentDecommissioned to outlet EquipmentItemEvents
      }
      on event EquipmentItem.EquipmentDisposed is {
        send event EquipmentItem.EquipmentDisposed to outlet EquipmentItemEvents
      }
      on other is {
        error "Unexpected message for source EquipmentItemEventSource"
      }
    } with {
      briefly "EquipmentItem source handler"
      described as {
        |Publishes EquipmentItem events onto the outlet.
      }
    }
  } with {
    briefly "EquipmentItem event source"
    described as {
      |Publishes EquipmentItem entity events into the streaming topology.
    }
  }
  processor EquipmentItemEventSink as sink is {
    inlet EquipmentItemInlet is type EquipmentItemEvent
    handler EquipmentItemSinkHandler is {
      on event EquipmentItem.EquipmentRegistered is {
        tell event EquipmentItem.EquipmentRegistered to repository InventoryContext.InventoryRepository
      }
      on event EquipmentItem.EquipmentReceived is {
        tell event EquipmentItem.EquipmentReceived to repository InventoryContext.InventoryRepository
      }
      on event EquipmentItem.EquipmentAllocated is {
        tell event EquipmentItem.EquipmentAllocated to repository InventoryContext.InventoryRepository
      }
      on event EquipmentItem.EquipmentInstalled is {
        tell event EquipmentItem.EquipmentInstalled to repository InventoryContext.InventoryRepository
      }
      on event EquipmentItem.MaintenanceRecorded is {
        tell event EquipmentItem.MaintenanceRecorded to repository InventoryContext.InventoryRepository
      }
      on event EquipmentItem.FirmwareUpdated is {
        tell event EquipmentItem.FirmwareUpdated to repository InventoryContext.InventoryRepository
      }
      on event EquipmentItem.EquipmentDecommissioned is {
        tell event EquipmentItem.EquipmentDecommissioned to repository InventoryContext.InventoryRepository
      }
      on event EquipmentItem.EquipmentDisposed is {
        tell event EquipmentItem.EquipmentDisposed to repository InventoryContext.InventoryRepository
      }
      on other is {
        error "Unexpected message for sink EquipmentItemEventSink"
      }
    } with {
      briefly "EquipmentItem sink handler"
      described as {
        |Persists EquipmentItem events via the repository.
      }
    }
  } with {
    briefly "EquipmentItem event sink"
    described as {
      |Receives EquipmentItem events for persistence.
    }
  }
  connector EquipmentItemEventFlow is {
    from outlet InventoryContext.EquipmentItemEventSource.EquipmentItemEvents to
      inlet InventoryContext.EquipmentItemEventSink.EquipmentItemInlet
  } with {
    briefly "EquipmentItem event flow"
    described as {
      |Connects the EquipmentItem source to its sink.
    }
  }
  processor EquipmentItemEventSplit is {
    inlet EquipmentItemEventSplitIn is type EquipmentItemEvent
    outlet EquipmentItemEventSplitToInventoryRepository is type EquipmentItemEvent
    outlet EquipmentItemEventSplitToInventoryDashboard is type EquipmentItemEvent
    handler EquipmentItemEventSplitHandler is {
      on event EquipmentItem.EquipmentRegistered is {
        send event EquipmentItem.EquipmentRegistered to outlet EquipmentItemEventSplitToInventoryRepository
        send event EquipmentItem.EquipmentRegistered to outlet EquipmentItemEventSplitToInventoryDashboard
        tell event EquipmentItem.EquipmentRegistered to entity InventoryContext.EquipmentItem
      }
      on event EquipmentItem.EquipmentReceived is {
        send event EquipmentItem.EquipmentReceived to outlet EquipmentItemEventSplitToInventoryRepository
        send event EquipmentItem.EquipmentReceived to outlet EquipmentItemEventSplitToInventoryDashboard
        tell event EquipmentItem.EquipmentReceived to entity InventoryContext.EquipmentItem
      }
      on event EquipmentItem.EquipmentAllocated is {
        send event EquipmentItem.EquipmentAllocated to outlet EquipmentItemEventSplitToInventoryRepository
        send event EquipmentItem.EquipmentAllocated to outlet EquipmentItemEventSplitToInventoryDashboard
        tell event EquipmentItem.EquipmentAllocated to entity InventoryContext.EquipmentItem
      }
      on event EquipmentItem.EquipmentInstalled is {
        send event EquipmentItem.EquipmentInstalled to outlet EquipmentItemEventSplitToInventoryRepository
        send event EquipmentItem.EquipmentInstalled to outlet EquipmentItemEventSplitToInventoryDashboard
        tell event EquipmentItem.EquipmentInstalled to entity InventoryContext.EquipmentItem
      }
      on event EquipmentItem.MaintenanceRecorded is {
        send event EquipmentItem.MaintenanceRecorded to outlet EquipmentItemEventSplitToInventoryRepository
        send event EquipmentItem.MaintenanceRecorded to outlet EquipmentItemEventSplitToInventoryDashboard
        tell event EquipmentItem.MaintenanceRecorded to entity InventoryContext.EquipmentItem
      }
      on event EquipmentItem.FirmwareUpdated is {
        send event EquipmentItem.FirmwareUpdated to outlet EquipmentItemEventSplitToInventoryRepository
        send event EquipmentItem.FirmwareUpdated to outlet EquipmentItemEventSplitToInventoryDashboard
        tell event EquipmentItem.FirmwareUpdated to entity InventoryContext.EquipmentItem
      }
      on event EquipmentItem.EquipmentDecommissioned is {
        send event EquipmentItem.EquipmentDecommissioned to outlet EquipmentItemEventSplitToInventoryRepository
        send event EquipmentItem.EquipmentDecommissioned to outlet EquipmentItemEventSplitToInventoryDashboard
        tell event EquipmentItem.EquipmentDecommissioned to entity InventoryContext.EquipmentItem
      }
      on event EquipmentItem.EquipmentDisposed is {
        send event EquipmentItem.EquipmentDisposed to outlet EquipmentItemEventSplitToInventoryRepository
        send event EquipmentItem.EquipmentDisposed to outlet EquipmentItemEventSplitToInventoryDashboard
        tell event EquipmentItem.EquipmentDisposed to entity InventoryContext.EquipmentItem
      }
      on other is {
        error "Unexpected message for processor EquipmentItemEventSplit"
      }
    } with {
      briefly "EquipmentItem event fan-out handler"
      described as {
        |Delivers each EquipmentItem event to all of its consumers.
      }
    }
  } with {
    briefly "EquipmentItem event fan-out"
    described as {
      |Fans EquipmentItem events out to the repository and projectors.
    }
  }
  connector LinkEquipmentItemToEquipmentItemEventSplit is {
    from outlet InventoryContext.EquipmentItem.EquipmentItemEvents2 to
      inlet InventoryContext.EquipmentItemEventSplit.EquipmentItemEventSplitIn
  } with {
    briefly "LinkEquipmentItemToEquipmentItemEventSplit"
  }
  connector LinkEquipmentItemEventSplitToInventoryRepository is {
    from outlet InventoryContext.EquipmentItemEventSplit.EquipmentItemEventSplitToInventoryRepository to
      inlet InventoryContext.InventoryRepository.InventoryRepositoryFromEquipmentItem
  } with {
    briefly "LinkEquipmentItemEventSplitToInventoryRepository"
  }
  connector LinkEquipmentItemEventSplitToInventoryDashboard is {
    from outlet InventoryContext.EquipmentItemEventSplit.EquipmentItemEventSplitToInventoryDashboard to
      inlet InventoryContext.InventoryDashboard.InventoryDashboardFromEquipmentItem
  } with {
    briefly "LinkEquipmentItemEventSplitToInventoryDashboard"
  }
  connector LinkInventoryDashboardToInventoryRepository is {
    from outlet InventoryContext.InventoryDashboard.InventoryDashboardOut to
      inlet InventoryContext.InventoryRepository.InventoryRepositoryFromInventoryDashboard
  } with {
    briefly "LinkInventoryDashboardToInventoryRepository"
  }
} with {
  briefly "Bounded context for equipment inventory"
  described as {
    |Network equipment inventory management context.
  }
}
