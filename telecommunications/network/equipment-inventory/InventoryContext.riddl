// Equipment Inventory - Inventory Context
context InventoryContext as router is {
  inlet EquipmentItemCommandStreamIn is type EquipmentItemCommand
  outlet EquipmentItemCommandStreamOut is type EquipmentItemCommand
  inlet StockItemResultStreamIn is type EquipmentItem.EquipmentItemResult
  outlet StockItemResultStreamOut is type EquipmentItem.EquipmentItemResult
  handler InventoryContextBoundary is {
    on registerEquipment: command EquipmentItem.RegisterEquipment is {
      send registerEquipment to outlet InventoryContext.EquipmentItemCommandStreamOut
    }
    on receiveEquipment: command EquipmentItem.ReceiveEquipment is {
      send receiveEquipment to outlet InventoryContext.EquipmentItemCommandStreamOut
    }
    on allocateEquipment: command EquipmentItem.AllocateEquipment is {
      send allocateEquipment to outlet InventoryContext.EquipmentItemCommandStreamOut
    }
    on installEquipment: command EquipmentItem.InstallEquipment is {
      send installEquipment to outlet InventoryContext.EquipmentItemCommandStreamOut
    }
    on recordMaintenance: command EquipmentItem.RecordMaintenance is {
      send recordMaintenance to outlet InventoryContext.EquipmentItemCommandStreamOut
    }
    on updateFirmware: command EquipmentItem.UpdateFirmware is {
      send updateFirmware to outlet InventoryContext.EquipmentItemCommandStreamOut
    }
    on decommissionEquipment: command EquipmentItem.DecommissionEquipment is {
      send decommissionEquipment to outlet InventoryContext.EquipmentItemCommandStreamOut
    }
    on disposeEquipment: command EquipmentItem.DisposeEquipment is {
      send disposeEquipment to outlet InventoryContext.EquipmentItemCommandStreamOut
    }
    on equipmentItemResult: result EquipmentItem.EquipmentItemResult is {
      send equipmentItemResult to outlet InventoryContext.StockItemResultStreamOut
    }
    on other is {
      error "Unexpected message at the InventoryContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'EquipmentItemCommand Stream Intake' is from outlet InventoryContext.EquipmentItemCommandStreamOut to inlet InventoryContext.EquipmentItem.EquipmentItemCommands
  connector 'StockItemResult Stream Egress' is from outlet InventoryContext.InventoryRepository.InventoryRepositoryResponses to inlet InventoryContext.StockItemResultStreamIn
  adaptor FromNetworkManagementSystem from context NetworkManagementSystem is { 
    handler FromNetworkManagementSystemHandler is {
      on event NetworkManagementSystem.NetworkElementRegistered is {
        do "the model receives network element registered"
      }
      on result NetworkManagementSystem.NetworkTopology is {
        do "the model receives network topology"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkManagementSystem"
      }
    } with {
      briefly "from network management system"
      described as {
        |Carries messages from the external NetworkManagementSystem.
      }
    }
  } with {
    briefly "NetworkManagementSystem integration"
    described as {
      |The model's side of the NetworkManagementSystem conversation.
    }
  }
  adaptor ToNetworkManagementSystem to context NetworkManagementSystem is { 
    handler ToNetworkManagementSystemHandler is {
      on query NetworkManagementSystem.GetNetworkTopology is {
        do "the model sends get network topology"
      }
      on command NetworkManagementSystem.RegisterNetworkElement is {
        do "the model sends register network element"
      }
      on other is {
        error "Unexpected message for adaptor ToNetworkManagementSystem"
      }
    } with {
      briefly "to network management system"
      described as {
        |Carries messages to the external NetworkManagementSystem.
      }
    }
  } with {
    briefly "NetworkManagementSystem integration"
    described as {
      |The model's side of the NetworkManagementSystem conversation.
    }
  }
  adaptor FromProcurementSystem from context ProcurementSystem is { 
    handler FromProcurementSystemHandler is {
      on event ProcurementSystem.PurchaseOrderConfirmed is {
        do "the model receives purchase order confirmed"
      }
      on result ProcurementSystem.VendorCatalog is {
        do "the model receives vendor catalog"
      }
      on other is {
        error "Unexpected message for adaptor FromProcurementSystem"
      }
    } with {
      briefly "from procurement system"
      described as {
        |Carries messages from the external ProcurementSystem.
      }
    }
  } with {
    briefly "ProcurementSystem integration"
    described as {
      |The model's side of the ProcurementSystem conversation.
    }
  }
  adaptor ToProcurementSystem to context ProcurementSystem is { 
    handler ToProcurementSystemHandler is {
      on query ProcurementSystem.GetVendorCatalog is {
        do "the model sends get vendor catalog"
      }
      on command ProcurementSystem.SubmitPurchaseOrder is {
        do "the model sends submit purchase order"
      }
      on other is {
        error "Unexpected message for adaptor ToProcurementSystem"
      }
    } with {
      briefly "to procurement system"
      described as {
        |Carries messages to the external ProcurementSystem.
      }
    }
  } with {
    briefly "ProcurementSystem integration"
    described as {
      |The model's side of the ProcurementSystem conversation.
    }
  }
  include "types.riddl"
  include "EquipmentItem.riddl"
  repository InventoryRepository as merge is {
    command PersistEquipmentDecommissioned is {
      itemId: EquipmentItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row EquipmentDecommissioned applies to.
        }
      }
    } with {
      briefly "Persist EquipmentDecommissioned"
      described as {
        |Instructs this repository to apply EquipmentDecommissioned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEquipmentInstalled is {
      itemId: EquipmentItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row EquipmentInstalled applies to.
        }
      }
    } with {
      briefly "Persist EquipmentInstalled"
      described as {
        |Instructs this repository to apply EquipmentInstalled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEquipmentRegistered is {
      itemId: EquipmentItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row EquipmentRegistered applies to.
        }
      }
    } with {
      briefly "Persist EquipmentRegistered"
      described as {
        |Instructs this repository to apply EquipmentRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet InventoryRepositoryFromEquipmentItem is type EquipmentItemEvent    inlet InventoryRepositoryFromInventoryDashboard is type EquipmentItemEvent    outlet InventoryRepositoryResponses is type EquipmentItem.EquipmentItemResult
    record StoredEquipmentItem is  {
      equipmentItemId: EquipmentItemId with {
        briefly "equipmentItemId"
        described as {
          |The equipmentItemId column of the stored equipmentItem row.
        }
      }
      details: EquipmentDetails with {
        briefly "details"
        described as {
          |The details column of the stored equipmentItem row.
        }
      }
      status: EquipmentStatus with {
        briefly "status"
        described as {
          |The status column of the stored equipmentItem row.
        }
      }
    } with {
      briefly "Stored equipmentItem row"
      described as {
        |The persistence shape of equipmentItem data as this repository stores it.
      }
    }
    schema InventoryData is relational
      of equipmentItems as type StoredEquipmentItem
        index on field StoredEquipmentItem.details.serialNumber
        index on field StoredEquipmentItem.details.category
        index on field StoredEquipmentItem.status
 with {
      briefly "Inventory data schema"
      described as {
        |The relational schema holding inventory data for the InventoryRepository.
      }
    }
    handler InventoryPersistence is {
      on persistEquipmentDecommissioned: command PersistEquipmentDecommissioned is {
        do "apply EquipmentDecommissioned to the stored row"
      }
      on persistEquipmentInstalled: command PersistEquipmentInstalled is {
        do "apply EquipmentInstalled to the stored row"
      }
      on persistEquipmentRegistered: command PersistEquipmentRegistered is {
        do "apply EquipmentRegistered to the stored row"
      }
      on query GetInventoryMetrics is {
        let inventoryMetricsView: type InventoryMetricsView = prompt("read the inventory metrics projection")
        reply inventoryMetricsView
      }
      on command EquipmentItem.RegisterEquipment is {
        do "Store new equipment item"
      }
      on receiveEquipment: command EquipmentItem.ReceiveEquipment is {
        tell event EquipmentItem.EquipmentReceived(itemId = receiveEquipment.itemId, condition = receiveEquipment.condition, receivedAt = receiveEquipment.receivedAt) to entity InventoryContext.EquipmentItem
        do "Update item to received"
      }
      on command EquipmentItem.AllocateEquipment is {
        do "Update item allocation and site"
      }
      on command EquipmentItem.InstallEquipment is {
        do "Update item to installed"
      }
      on recordMaintenance: command EquipmentItem.RecordMaintenance is {
        tell event EquipmentItem.MaintenanceRecorded(itemId = recordMaintenance.itemId, maintenance = recordMaintenance.maintenance) to entity InventoryContext.EquipmentItem
        do "Append maintenance record"
      }
      on updateFirmware: command EquipmentItem.UpdateFirmware is {
        tell event EquipmentItem.FirmwareUpdated(itemId = updateFirmware.itemId, update = updateFirmware.update) to entity InventoryContext.EquipmentItem
        do "Append firmware update record"
      }
      on command EquipmentItem.DecommissionEquipment is {
        do "Update item to decommissioned"
      }
      on command EquipmentItem.DisposeEquipment is {
        do "Update item to disposed"
      }
    } with {
      briefly "Persists inventory commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Inventory data persistence"
    described as {
      |Persistent storage for equipment inventory.
    }
  }
  query GetInventoryMetrics is  {
    inventoryMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which inventory metrics to retrieve.
      }
    }
  } with {
    briefly "Get inventory metrics"
    described as {
      |Retrieves the inventory metrics projection.
    }
  }
  result InventoryMetricsView is  {
    inventoryMetrics: InventoryDashboard.InventoryMetrics with {
      briefly "Inventory metrics"
      described as {
        |The inventory metrics being returned.
      }
    }
  } with {
    briefly "Inventory metrics view"
    described as {
      |Read model view carrying the inventory metrics projection.
    }
  }
  projector InventoryDashboard as flow is {
    updates repository InventoryContext.InventoryRepository
    inlet InventoryDashboardFromEquipmentItem is type EquipmentItemEvent    outlet InventoryDashboardOut is type EquipmentItemEvent
    record InventoryMetrics is  {
      totalItems: Natural with {
        briefly "Total"
        described as {
          |Total equipment items.
        }
      }
      inServiceCount: Natural with {
        briefly "In service"
        described as {
          |Items currently in service.
        }
      }
      inWarehouseCount: Natural with {
        briefly "In warehouse"
        described as {
          |Items in warehouse.
        }
      }
      maintenanceCount: Natural with {
        briefly "In maintenance"
        described as {
          |Items under maintenance.
        }
      }
      decommissionedCount: Natural with {
        briefly "Decommissioned"
        described as {
          |Items decommissioned.
        }
      }
    } with {
      briefly "Inventory metrics"
      described as {
        |Equipment inventory metrics.
      }
    }
    handler DashboardHandler is {
      on equipmentRegistered: event EquipmentItem.EquipmentRegistered is {
        tell command InventoryContext.InventoryRepository.PersistEquipmentRegistered(itemId = equipmentRegistered.itemId) to repository InventoryContext.InventoryRepository
        do "Increment total items"
      }
      on equipmentInstalled: event EquipmentItem.EquipmentInstalled is {
        tell command InventoryContext.InventoryRepository.PersistEquipmentInstalled(itemId = equipmentInstalled.itemId) to repository InventoryContext.InventoryRepository
        do "Increment in-service count"
      }
      on equipmentDecommissioned: event EquipmentItem.EquipmentDecommissioned is {
        tell command InventoryContext.InventoryRepository.PersistEquipmentDecommissioned(itemId = equipmentDecommissioned.itemId) to repository InventoryContext.InventoryRepository
        do "Increment decommissioned count"
      }
    } with {
      briefly "Maintains inventory dashboard"
      described as {
        |Projects events into dashboard metrics.
      }
    }
  } with {
    briefly "Inventory dashboard"
    described as {
      |Equipment inventory analytics.
    }
  }
  // ---- Event publication for EquipmentItem ----
  type EquipmentItemEvent is one of {
    InventoryContext.EquipmentItem.EquipmentRegistered or InventoryContext.EquipmentItem.EquipmentReceived or InventoryContext.EquipmentItem.EquipmentAllocated or InventoryContext.EquipmentItem.EquipmentInstalled or InventoryContext.EquipmentItem.MaintenanceRecorded or InventoryContext.EquipmentItem.FirmwareUpdated or InventoryContext.EquipmentItem.EquipmentDecommissioned or InventoryContext.EquipmentItem.EquipmentDisposed
  } with {
    briefly "EquipmentItem event alternation"
    described as {
      |Union of all EquipmentItem events, for streaming and event-sourced
      |persistence.
    }
  }
  processor EquipmentItemEventSource as source is {
    outlet EquipmentItemEvents is type EquipmentItemEvent
    handler EquipmentItemSourceHandler is {
      on equipmentRegistered: event EquipmentItem.EquipmentRegistered is {
        send equipmentRegistered to outlet EquipmentItemEvents
      }
      on equipmentReceived: event EquipmentItem.EquipmentReceived is {
        send equipmentReceived to outlet EquipmentItemEvents
      }
      on equipmentAllocated: event EquipmentItem.EquipmentAllocated is {
        send equipmentAllocated to outlet EquipmentItemEvents
      }
      on equipmentInstalled: event EquipmentItem.EquipmentInstalled is {
        send equipmentInstalled to outlet EquipmentItemEvents
      }
      on maintenanceRecorded: event EquipmentItem.MaintenanceRecorded is {
        send maintenanceRecorded to outlet EquipmentItemEvents
      }
      on firmwareUpdated: event EquipmentItem.FirmwareUpdated is {
        send firmwareUpdated to outlet EquipmentItemEvents
      }
      on equipmentDecommissioned: event EquipmentItem.EquipmentDecommissioned is {
        send equipmentDecommissioned to outlet EquipmentItemEvents
      }
      on equipmentDisposed: event EquipmentItem.EquipmentDisposed is {
        send equipmentDisposed to outlet EquipmentItemEvents
      }
      on other is {
        error "Unexpected message for source EquipmentItemEventSource"
      }
    } with {
      briefly "EquipmentItem source handler"
      described as {
        |Publishes EquipmentItem events onto the outlet.
      }
    }
  } with {
    briefly "EquipmentItem event source"
    described as {
      |Publishes EquipmentItem entity events into the streaming topology.
    }
  }
  processor EquipmentItemEventSink as sink is {
    inlet EquipmentItemInlet is type EquipmentItemEvent    handler EquipmentItemSinkHandler is {
      on equipmentRegistered: event EquipmentItem.EquipmentRegistered is {
        tell equipmentRegistered to repository InventoryContext.InventoryRepository
      }
      on equipmentReceived: event EquipmentItem.EquipmentReceived is {
        tell equipmentReceived to repository InventoryContext.InventoryRepository
      }
      on equipmentAllocated: event EquipmentItem.EquipmentAllocated is {
        tell equipmentAllocated to repository InventoryContext.InventoryRepository
      }
      on equipmentInstalled: event EquipmentItem.EquipmentInstalled is {
        tell equipmentInstalled to repository InventoryContext.InventoryRepository
      }
      on maintenanceRecorded: event EquipmentItem.MaintenanceRecorded is {
        tell maintenanceRecorded to repository InventoryContext.InventoryRepository
      }
      on firmwareUpdated: event EquipmentItem.FirmwareUpdated is {
        tell firmwareUpdated to repository InventoryContext.InventoryRepository
      }
      on equipmentDecommissioned: event EquipmentItem.EquipmentDecommissioned is {
        tell equipmentDecommissioned to repository InventoryContext.InventoryRepository
      }
      on equipmentDisposed: event EquipmentItem.EquipmentDisposed is {
        tell equipmentDisposed to repository InventoryContext.InventoryRepository
      }
      on other is {
        error "Unexpected message for sink EquipmentItemEventSink"
      }
    } with {
      briefly "EquipmentItem sink handler"
      described as {
        |Persists EquipmentItem events via the repository.
      }
    }
  } with {
    briefly "EquipmentItem event sink"
    described as {
      |Receives EquipmentItem events for persistence.
    }
  }
  connector EquipmentItemEventFlow is from outlet InventoryContext.EquipmentItemEventSource.EquipmentItemEvents to inlet InventoryContext.EquipmentItemEventSink.EquipmentItemInlet with {
    briefly "EquipmentItem event flow"
    described as {
      |Connects the EquipmentItem source to its sink.
    }
  }
  processor EquipmentItemEventSplit as split is {
    inlet EquipmentItemEventSplitIn is type EquipmentItemEvent    outlet EquipmentItemEventSplitToInventoryRepository is type EquipmentItemEvent
    outlet EquipmentItemEventSplitToInventoryDashboard is type EquipmentItemEvent
    handler EquipmentItemEventSplitHandler is {
      on equipmentRegistered: event EquipmentItem.EquipmentRegistered is {
        send equipmentRegistered to outlet EquipmentItemEventSplitToInventoryRepository
        send equipmentRegistered to outlet EquipmentItemEventSplitToInventoryDashboard
        tell equipmentRegistered to entity InventoryContext.EquipmentItem
      }
      on equipmentReceived: event EquipmentItem.EquipmentReceived is {
        send equipmentReceived to outlet EquipmentItemEventSplitToInventoryRepository
        send equipmentReceived to outlet EquipmentItemEventSplitToInventoryDashboard
        tell equipmentReceived to entity InventoryContext.EquipmentItem
      }
      on equipmentAllocated: event EquipmentItem.EquipmentAllocated is {
        send equipmentAllocated to outlet EquipmentItemEventSplitToInventoryRepository
        send equipmentAllocated to outlet EquipmentItemEventSplitToInventoryDashboard
        tell equipmentAllocated to entity InventoryContext.EquipmentItem
      }
      on equipmentInstalled: event EquipmentItem.EquipmentInstalled is {
        send equipmentInstalled to outlet EquipmentItemEventSplitToInventoryRepository
        send equipmentInstalled to outlet EquipmentItemEventSplitToInventoryDashboard
        tell equipmentInstalled to entity InventoryContext.EquipmentItem
      }
      on maintenanceRecorded: event EquipmentItem.MaintenanceRecorded is {
        send maintenanceRecorded to outlet EquipmentItemEventSplitToInventoryRepository
        send maintenanceRecorded to outlet EquipmentItemEventSplitToInventoryDashboard
        tell maintenanceRecorded to entity InventoryContext.EquipmentItem
      }
      on firmwareUpdated: event EquipmentItem.FirmwareUpdated is {
        send firmwareUpdated to outlet EquipmentItemEventSplitToInventoryRepository
        send firmwareUpdated to outlet EquipmentItemEventSplitToInventoryDashboard
        tell firmwareUpdated to entity InventoryContext.EquipmentItem
      }
      on equipmentDecommissioned: event EquipmentItem.EquipmentDecommissioned is {
        send equipmentDecommissioned to outlet EquipmentItemEventSplitToInventoryRepository
        send equipmentDecommissioned to outlet EquipmentItemEventSplitToInventoryDashboard
        tell equipmentDecommissioned to entity InventoryContext.EquipmentItem
      }
      on equipmentDisposed: event EquipmentItem.EquipmentDisposed is {
        send equipmentDisposed to outlet EquipmentItemEventSplitToInventoryRepository
        send equipmentDisposed to outlet EquipmentItemEventSplitToInventoryDashboard
        tell equipmentDisposed to entity InventoryContext.EquipmentItem
      }
      on other is {
        error "Unexpected message for processor EquipmentItemEventSplit"
      }
    } with {
      briefly "EquipmentItem event fan-out handler"
      described as {
        |Delivers each EquipmentItem event to all of its consumers.
      }
    }
  } with {
    briefly "EquipmentItem event fan-out"
    described as {
      |Fans EquipmentItem events out to the repository and projectors.
    }
  }
  connector 'EquipmentItemEvent Stream' is from outlet InventoryContext.EquipmentItem.EquipmentItemEvents2 to inlet InventoryContext.EquipmentItemEventSplit.EquipmentItemEventSplitIn with {
    briefly "EquipmentItem events, fanned out to storage and read models"
  }
  connector 'EquipmentItemEvent Storage' is from outlet InventoryContext.EquipmentItemEventSplit.EquipmentItemEventSplitToInventoryRepository to inlet InventoryContext.InventoryRepository.InventoryRepositoryFromEquipmentItem with {
    briefly "EquipmentItem events on their way to storage"
  }
  connector 'InventoryDashboard Feed' is from outlet InventoryContext.EquipmentItemEventSplit.EquipmentItemEventSplitToInventoryDashboard to inlet InventoryContext.InventoryDashboard.InventoryDashboardFromEquipmentItem with {
    briefly "EquipmentItem events feeding the InventoryDashboard projection"
  }
  connector 'InventoryDashboard Storage' is from outlet InventoryContext.InventoryDashboard.InventoryDashboardOut to inlet InventoryContext.InventoryRepository.InventoryRepositoryFromInventoryDashboard with {
    briefly "The InventoryDashboard projection on its way to storage"
  }
} with {
  briefly "Bounded context for equipment inventory"
  described as {
    |Network equipment inventory management context.
  }
}
