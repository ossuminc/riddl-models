// Equipment Inventory - EquipmentItem Entity
entity EquipmentItem as router is {
  type EquipmentItemCommand is one of {
    EquipmentItem.ReceiveEquipment or EquipmentItem.AllocateEquipment or EquipmentItem.InstallEquipment or EquipmentItem.RecordMaintenance or EquipmentItem.UpdateFirmware or EquipmentItem.DecommissionEquipment or EquipmentItem.DisposeEquipment
  } with {
    briefly "EquipmentItem command alternation"
    described as {
      |Commands accepted by the EquipmentItem entity.
    }
  }
  inlet EquipmentItemQueries is query GetEquipmentItem with {
    briefly "Look-ups of this equipment item"
    described as {
      |What EquipmentInventoryApp asks of the equipment item, by way of InventoryContext.
    }
  }
  outlet EquipmentItemReplies is result EquipmentItemResult
 with {
    briefly "This equipment item's answers"
    described as {
      |What the equipment item answers, on its way back to InventoryContext.
    }
  }
  inlet EquipmentItemCommands is type EquipmentItemCommand
  outlet EquipmentItemEvents2 is type EquipmentItemEvent
  query GetEquipmentItem replies result EquipmentItemResult is {
    equipmentItemId: EquipmentItemId with {
      briefly "ID"
      described as {
        |Identifier of the EquipmentItem to retrieve.
      }
    }
  } with {
    briefly "Get EquipmentItem"
    described as {
      |Retrieve EquipmentItem data by identifier.
    }
  }
  result EquipmentItemResult is {
    equipmentItemId: EquipmentItemId with {
      briefly "EquipmentItem addressed"
      described as {
        |Which equipmentitem this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    equipmentItemData: EquipmentItem.ActiveItemData with {
      briefly "EquipmentItem data"
      described as {
        |The requested EquipmentItem data.
      }
    }
  } with {
    briefly "EquipmentItem result"
    described as {
      |Result carrying the requested EquipmentItem data.
    }
  }
  command ReceiveEquipment is {
    itemId: EquipmentItemId with {
      briefly "Item ID"
      described as {
        |Equipment item identifier.
      }
    }
    receivedAt: TimeStamp with {
      briefly "Received"
      described as {
        |Receipt timestamp.
      }
    }
    condition: EquipmentCondition with {
      briefly "Condition"
      described as {
        |Condition on receipt.
      }
    }
    warehouseLocation: String(1,100) with {
      briefly "Location"
      described as {
        |Warehouse storage location.
      }
    }
  } with {
    briefly "Receive equipment"
    described as {
      |Records equipment receipt at warehouse.
    }
  }
  command AllocateEquipment is {
    itemId: EquipmentItemId with {
      briefly "Item ID"
      described as {
        |Equipment item identifier.
      }
    }
    site: SiteLocation with {
      briefly "Site"
      described as {
        |Target installation site.
      }
    }
    allocatedBy: String(1,200) with {
      briefly "Allocated by"
      described as {
        |Person allocating equipment.
      }
    }
  } with {
    briefly "Allocate equipment"
    described as {
      |Allocates equipment to a site.
    }
  }
  command InstallEquipment is {
    itemId: EquipmentItemId with {
      briefly "Item ID"
      described as {
        |Equipment item identifier.
      }
    }
    installedBy: String(1,200) with {
      briefly "Installed by"
      described as {
        |Technician who installed.
      }
    }
    installedAt: TimeStamp with {
      briefly "Installed"
      described as {
        |Installation timestamp.
      }
    }
    updatedIpAddress: String(1,50)? with {
      briefly "IP address"
      described as {
        |Assigned IP address.
      }
    }
    hostname: String(1,200)? with {
      briefly "Hostname"
      described as {
        |Assigned hostname.
      }
    }
  } with {
    briefly "Install equipment"
    described as {
      |Records equipment installation at site.
    }
  }
  command RecordMaintenance is {
    itemId: EquipmentItemId with {
      briefly "Item ID"
      described as {
        |Equipment item identifier.
      }
    }
    maintenance: MaintenanceRecord with {
      briefly "Maintenance"
      described as {
        |Maintenance details.
      }
    }
  } with {
    briefly "Record maintenance"
    described as {
      |Records maintenance activity.
    }
  }
  command UpdateFirmware is {
    itemId: EquipmentItemId with {
      briefly "Item ID"
      described as {
        |Equipment item identifier.
      }
    }
    update: FirmwareUpdate with {
      briefly "Update"
      described as {
        |Firmware update details.
      }
    }
  } with {
    briefly "Update firmware"
    described as {
      |Records firmware update.
    }
  }
  command DecommissionEquipment is {
    itemId: EquipmentItemId with {
      briefly "Item ID"
      described as {
        |Equipment item identifier.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Decommission reason.
      }
    }
    decommissionedBy: String(1,200) with {
      briefly "Decommissioned by"
      described as {
        |Person decommissioning.
      }
    }
  } with {
    briefly "Decommission equipment"
    described as {
      |Takes equipment out of service.
    }
  }
  command DisposeEquipment is {
    itemId: EquipmentItemId with {
      briefly "Item ID"
      described as {
        |Equipment item identifier.
      }
    }
    disposalMethod: String(1,200) with {
      briefly "Method"
      described as {
        |Disposal method.
      }
    }
    disposedAt: TimeStamp with {
      briefly "Disposed"
      described as {
        |Disposal timestamp.
      }
    }
  } with {
    briefly "Dispose equipment"
    described as {
      |Records equipment disposal.
    }
  }
  // Events
  event EquipmentRegistered is {
    itemId: EquipmentItemId with {
      briefly "Item"
      described as {
        |Item ID.
      }
    }
    details: EquipmentDetails with {
      briefly "Details"
      described as {
        |Equipment details.
      }
    }
    registeredAt: TimeStamp with {
      briefly "Registered"
      described as {
        |Registration time.
      }
    }
  } with {
    briefly "Equipment registered"
    described as {
      |Emitted when equipment is registered.
    }
  }
  event EquipmentReceived is {
    itemId: EquipmentItemId with {
      briefly "Item"
      described as {
        |Item ID.
      }
    }
    condition: EquipmentCondition with {
      briefly "Condition"
      described as {
        |Receipt condition.
      }
    }
    receivedAt: TimeStamp with {
      briefly "Received"
      described as {
        |Receipt time.
      }
    }
  } with {
    briefly "Equipment received"
    described as {
      |Emitted when equipment is received.
    }
  }
  event EquipmentAllocated is {
    itemId: EquipmentItemId with {
      briefly "Item"
      described as {
        |Item ID.
      }
    }
    site: SiteLocation with {
      briefly "Site"
      described as {
        |Target site.
      }
    }
    allocatedAt: TimeStamp with {
      briefly "Allocated"
      described as {
        |Allocation time.
      }
    }
  } with {
    briefly "Equipment allocated"
    described as {
      |Emitted when equipment is allocated to a site.
    }
  }
  event EquipmentInstalled is {
    itemId: EquipmentItemId with {
      briefly "Item"
      described as {
        |Item ID.
      }
    }
    installedAt: TimeStamp with {
      briefly "Installed"
      described as {
        |Installation time.
      }
    }
  } with {
    briefly "Equipment installed"
    described as {
      |Emitted when equipment is installed.
    }
  }
  event MaintenanceRecorded is {
    itemId: EquipmentItemId with {
      briefly "Item"
      described as {
        |Item ID.
      }
    }
    maintenance: MaintenanceRecord with {
      briefly "Maintenance"
      described as {
        |Maintenance details.
      }
    }
  } with {
    briefly "Maintenance recorded"
    described as {
      |Emitted when maintenance is recorded.
    }
  }
  event FirmwareUpdated is {
    itemId: EquipmentItemId with {
      briefly "Item"
      described as {
        |Item ID.
      }
    }
    update: FirmwareUpdate with {
      briefly "Update"
      described as {
        |Update details.
      }
    }
  } with {
    briefly "Firmware updated"
    described as {
      |Emitted when firmware is updated.
    }
  }
  event EquipmentDecommissioned is {
    itemId: EquipmentItemId with {
      briefly "Item"
      described as {
        |Item ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Decommission reason.
      }
    }
    decommissionedAt: TimeStamp with {
      briefly "Decommissioned"
      described as {
        |Decommission time.
      }
    }
  } with {
    briefly "Equipment decommissioned"
    described as {
      |Emitted when equipment is decommissioned.
    }
  }
  event EquipmentDisposed is {
    itemId: EquipmentItemId with {
      briefly "Item"
      described as {
        |Item ID.
      }
    }
    disposalMethod: String(1,200) with {
      briefly "Method"
      described as {
        |Disposal method.
      }
    }
    disposedAt: TimeStamp with {
      briefly "Disposed"
      described as {
        |Disposal time.
      }
    }
  } with {
    briefly "Equipment disposed"
    described as {
      |Emitted when equipment is disposed.
    }
  }
  // States
  record ActiveItemData is {
    itemId: EquipmentItemId with {
      briefly "Item"
      described as {
        |Item ID.
      }
    }
    details: EquipmentDetails with {
      briefly "Details"
      described as {
        |Equipment details.
      }
    }
    status: EquipmentStatus with {
      briefly "Status"
      described as {
        |Current status.
      }
    }
    condition: EquipmentCondition with {
      briefly "Condition"
      described as {
        |Physical condition.
      }
    }
    location: SiteLocation? with {
      briefly "Location"
      described as {
        |Current location.
      }
    }
    maintenanceHistory: MaintenanceRecord* with {
      briefly "Maintenance"
      described as {
        |Maintenance history.
      }
    }
    firmwareHistory: FirmwareUpdate* with {
      briefly "Firmware"
      described as {
        |Firmware update history.
      }
    }
    vendorId: VendorId with {
      briefly "Vendor"
      described as {
        |Vendor.
      }
    }
    registeredAt: TimeStamp with {
      briefly "Registered"
      described as {
        |Registration time.
      }
    }
  } with {
    briefly "Active equipment state"
    described as {
      |State for active equipment item.
    }
  }
  record DisposedItemData is {
    itemId: EquipmentItemId with {
      briefly "Item"
      described as {
        |Item ID.
      }
    }
    details: EquipmentDetails with {
      briefly "Details"
      described as {
        |Equipment details.
      }
    }
    disposalMethod: String(1,200) with {
      briefly "Method"
      described as {
        |Disposal method.
      }
    }
    disposedAt: TimeStamp with {
      briefly "Disposed"
      described as {
        |Disposal time.
      }
    }
  } with {
    briefly "Disposed equipment state"
    described as {
      |State for disposed equipment.
    }
  }
  state ActiveItemState of record EquipmentItem.ActiveItemData is {
    initial handler ActiveItemStateInitHandler is {
      on query GetEquipmentItem is {
        let equipmentItemResult: type EquipmentItemResult = prompt("read the equipment item from the store")
        reply equipmentItemResult
      }
    } with {
      briefly "ActiveItemState initialization"
      described as {
        |Initializes ActiveItemState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Active item state"
    described as {
      |The active item state of the EquipmentItem entity, carrying ActiveItemData.
    }
  }
  state DisposedItemState of record EquipmentItem.DisposedItemData with {
    briefly "Disposed item state"
    described as {
      |The disposed item state of the EquipmentItem entity, carrying DisposedItemData.
    }
  }
  handler EquipmentItemHandler is {
    on init(details: type EquipmentDetails, vendorId: type VendorId) is {
      morph entity InventoryContext.EquipmentItem to state InventoryContext.EquipmentItem.ActiveItemState with record EquipmentItem.ActiveItemData(itemId = self.id, details = details, vendorId = vendorId, status = prompt("the status of this active item data"), condition = prompt("the condition of this active item data"), location = empty, maintenanceHistory = empty, firmwareHistory = empty, registeredAt = prompt("the registered at of this active item data"))
      tell event EquipmentRegistered(itemId = self.id, details = details, registeredAt = prompt("the registered at of this equipment registered")) to entity InventoryContext.EquipmentItem
    }
    on receiveEquipment: command ReceiveEquipment is {
      tell event EquipmentReceived(itemId = receiveEquipment.itemId, condition = receiveEquipment.condition, receivedAt = receiveEquipment.receivedAt) to entity InventoryContext.EquipmentItem
    }
    on allocateEquipment: command AllocateEquipment is {
      tell event EquipmentAllocated(itemId = allocateEquipment.itemId, site = allocateEquipment.site, allocatedAt = system.now) to entity InventoryContext.EquipmentItem
    }
    on installEquipment: command InstallEquipment is {
      tell event EquipmentInstalled(itemId = installEquipment.itemId, installedAt = installEquipment.installedAt) to entity InventoryContext.EquipmentItem
    }
    on recordMaintenance: command RecordMaintenance is {
      tell event MaintenanceRecorded(itemId = recordMaintenance.itemId, maintenance = recordMaintenance.maintenance) to entity InventoryContext.EquipmentItem
    }
    on updateFirmware: command UpdateFirmware is {
      tell event FirmwareUpdated(itemId = updateFirmware.itemId, update = updateFirmware.update) to entity InventoryContext.EquipmentItem
    }
    on decommissionEquipment: command DecommissionEquipment is {
      tell event EquipmentDecommissioned(itemId = decommissionEquipment.itemId, reason = decommissionEquipment.reason, decommissionedAt = system.now) to entity InventoryContext.EquipmentItem
    }
    on disposeEquipment: command DisposeEquipment is {
      morph entity InventoryContext.EquipmentItem to state InventoryContext.EquipmentItem.DisposedItemState with record EquipmentItem.DisposedItemData(itemId = disposeEquipment.itemId, disposalMethod = disposeEquipment.disposalMethod, disposedAt = disposeEquipment.disposedAt, details = prompt("the details of this disposed item data"))
      tell event EquipmentDisposed(itemId = disposeEquipment.itemId, disposalMethod = disposeEquipment.disposalMethod, disposedAt = disposeEquipment.disposedAt) to entity InventoryContext.EquipmentItem
    }
    on equipmentAllocated: event EquipmentAllocated is {
      do "apply EquipmentAllocated to the equipmentItem so it can be persisted and replayed"
    }
    on equipmentDecommissioned: event EquipmentDecommissioned is {
      do "apply EquipmentDecommissioned to the equipmentItem so it can be persisted and replayed"
    }
    on equipmentDisposed: event EquipmentDisposed is {
      do "apply EquipmentDisposed to the equipmentItem so it can be persisted and replayed"
    }
    on equipmentInstalled: event EquipmentInstalled is {
      do "apply EquipmentInstalled to the equipmentItem so it can be persisted and replayed"
    }
    on equipmentReceived: event EquipmentReceived is {
      do "apply EquipmentReceived to the equipmentItem so it can be persisted and replayed"
    }
    on equipmentRegistered: event EquipmentRegistered is {
      do "apply EquipmentRegistered to the equipmentItem so it can be persisted and replayed"
    }
    on firmwareUpdated: event FirmwareUpdated is {
      do "apply FirmwareUpdated to the equipmentItem so it can be persisted and replayed"
    }
    on maintenanceRecorded: event MaintenanceRecorded is {
      do "apply MaintenanceRecorded to the equipmentItem so it can be persisted and replayed"
    }
  } with {
    briefly "Processes equipment commands"
    described as {
      |Handles equipment lifecycle commands.
    }
  }
} with {
  briefly "EquipmentItem aggregate"
  described as {
    |Manages network equipment items.
  }
}
