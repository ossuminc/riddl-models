// Network Monitoring Domain Model
// Telecommunications network health and performance
domain NetworkMonitoring is {
  persistent connector 'ConfigBackupEvent Stream' is from outlet ConfigBackup.ConfigBackupEventsOut to inlet MonitoringContext.FromConfigBackup.FromConfigBackupIn with {
    briefly "What ConfigBackup tells MonitoringContext, unasked"
  }
  persistent connector 'SNMPCollectorEvent Stream' is from outlet SNMPCollector.SNMPCollectorEventsOut to inlet MonitoringContext.FromSNMPCollector.FromSNMPCollectorIn with {
    briefly "What SNMPCollector tells MonitoringContext, unasked"
  }
  persistent connector 'SyslogReceiverEvent Stream' is from outlet SyslogReceiver.SyslogReceiverEventsOut to inlet MonitoringContext.FromSyslogReceiver.FromSyslogReceiverIn with {
    briefly "What SyslogReceiver tells MonitoringContext, unasked"
  }
  persistent connector 'TopologyDiscoveryEvent Stream' is from outlet TopologyDiscovery.TopologyDiscoveryEventsOut to inlet MonitoringContext.FromTopologyDiscovery.FromTopologyDiscoveryIn with {
    briefly "What TopologyDiscovery tells MonitoringContext, unasked"
  }
  persistent connector 'TopologyDiscoveryRequest Stream' is from outlet MonitoringContext.ToTopologyDiscovery.ToTopologyDiscoveryOut to inlet TopologyDiscovery.TopologyDiscoveryRequests with {
    briefly "What MonitoringContext asks TopologyDiscovery to send"
  }
  persistent connector 'SNMPCollectorRequest Stream' is from outlet MonitoringContext.ToSNMPCollector.ToSNMPCollectorOut to inlet SNMPCollector.SNMPCollectorRequests with {
    briefly "What MonitoringContext asks SNMPCollector to send"
  }
  persistent connector 'ConfigBackupRequest Stream' is from outlet MonitoringContext.ToConfigBackup.ToConfigBackupOut to inlet ConfigBackup.ConfigBackupRequests with {
    briefly "What MonitoringContext asks ConfigBackup to send"
  }
  persistent connector 'AlertNotificationRequest Stream' is from outlet MonitoringContext.ToAlertNotification.ToAlertNotificationOut to inlet AlertNotification.AlertNotificationRequests with {
    briefly "What MonitoringContext asks AlertNotification to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user NOCEngineer is "person monitoring network operations" with {
    briefly "NOC Engineer"
    described as {
      |Network operations center engineer.
    }
  }
  user NetworkAdmin is "person administering network devices" with {
    briefly "Network Admin"
    described as {
      |Manages network infrastructure.
    }
  }
  user ServiceManager is "person overseeing service quality" with {
    briefly "Service Manager"
    described as {
      |Ensures service level agreements.
    }
  }
  epic NetworkOperations is {
    user NOCEngineer wants to "to monitor network health" so that "issues are detected and resolved quickly"
    case MonitorHealth is {
      user NOCEngineer wants to "to see real-time network status" so that "problems are identified immediately"
      step is "System collects" "device metrics" "continuously" with {
        briefly "Collect metrics"
        described as {
          |Gather data.
        }
      }
      step is "System alerts" "on anomalies" "or thresholds" with {
        briefly "Alert anomalies"
        described as {
          |Trigger alerts.
        }
      }
    } with {
      briefly "Monitor network health"
      described as {
        |Real-time monitoring workflow.
      }
    }
  } with {
    briefly "Network operations"
    described as {
      |Epic for network monitoring.
    }
  }
  include "MonitoringContext.riddl"
  include "external-contexts.riddl"
  application context NetworkMonitoringApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in NetworkMonitoring are delivered.
      }
    }
    outlet AppNetworkDeviceCommands is type MonitoringContext.NetworkDevice.NetworkDeviceCommand
    inlet AppDeviceRepositoryResponses is result MonitoringContext.NetworkDevice.NetworkDeviceResult    handler NetworkMonitoringAppHandler is {
      on other is {
        error "Unexpected message for application context NetworkMonitoringApp"
      }
    } with {
      briefly "NetworkMonitoringApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "NetworkMonitoringApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'NetworkDeviceCommand Stream' is from outlet NetworkMonitoringApp.AppNetworkDeviceCommands to inlet MonitoringContext.NetworkDeviceCommandStreamIn with {
    briefly "NetworkDevice commands from the application"
  }
  persistent connector 'NetworkDeviceResult Stream' is from outlet MonitoringContext.NetworkDeviceResultStreamOut to inlet NetworkMonitoringApp.AppDeviceRepositoryResponses with {
    briefly "Device query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet NetworkMonitoringApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term AlertThreshold is "The threshold beyond which the system alerts on anomalies."
  briefly "Network monitoring domain"
  described as {
    |Telecom network health and performance.
  }
}
