// Network Monitoring - Monitoring Context
context MonitoringContext is {
  adaptor FromAlertNotification from context AlertNotification is { 
    handler FromAlertNotificationHandler is {
      on event AlertNotification.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromAlertNotification"
      }
    } with {
      briefly "from alert notification"
      described as {
        |Carries messages from the external AlertNotification.
      }
    }
  } with {
    briefly "AlertNotification integration"
    described as {
      |The model's side of the AlertNotification conversation.
    }
  }
  adaptor ToAlertNotification to context AlertNotification is { 
    handler ToAlertNotificationHandler is {
      on command AlertNotification.SendAlertNotification is {
        do "the model sends send alert notification"
      }
      on other is {
        error "Unexpected message for adaptor ToAlertNotification"
      }
    } with {
      briefly "to alert notification"
      described as {
        |Carries messages to the external AlertNotification.
      }
    }
  } with {
    briefly "AlertNotification integration"
    described as {
      |The model's side of the AlertNotification conversation.
    }
  }
  adaptor FromConfigBackup from context ConfigBackup is { 
    handler FromConfigBackupHandler is {
      on event ConfigBackup.ConfigBackedUp is {
        do "the model receives config backed up"
      }
      on event ConfigBackup.ConfigsCompared is {
        do "the model receives configs compared"
      }
      on other is {
        error "Unexpected message for adaptor FromConfigBackup"
      }
    } with {
      briefly "from config backup"
      described as {
        |Carries messages from the external ConfigBackup.
      }
    }
  } with {
    briefly "ConfigBackup integration"
    described as {
      |The model's side of the ConfigBackup conversation.
    }
  }
  adaptor ToConfigBackup to context ConfigBackup is { 
    handler ToConfigBackupHandler is {
      on command ConfigBackup.BackupDeviceConfig is {
        do "the model sends backup device config"
      }
      on command ConfigBackup.CompareConfigs is {
        do "the model sends compare configs"
      }
      on other is {
        error "Unexpected message for adaptor ToConfigBackup"
      }
    } with {
      briefly "to config backup"
      described as {
        |Carries messages to the external ConfigBackup.
      }
    }
  } with {
    briefly "ConfigBackup integration"
    described as {
      |The model's side of the ConfigBackup conversation.
    }
  }
  adaptor FromSNMPCollector from context SNMPCollector is { 
    handler FromSNMPCollectorHandler is {
      on event SNMPCollector.SNMPDataCollected is {
        do "the model receives snmp data collected"
      }
      on event SNMPCollector.SNMPPollFailed is {
        do "the model receives snmp poll failed"
      }
      on other is {
        error "Unexpected message for adaptor FromSNMPCollector"
      }
    } with {
      briefly "from snmp collector"
      described as {
        |Carries messages from the external SNMPCollector.
      }
    }
  } with {
    briefly "SNMPCollector integration"
    described as {
      |The model's side of the SNMPCollector conversation.
    }
  }
  adaptor ToSNMPCollector to context SNMPCollector is { 
    handler ToSNMPCollectorHandler is {
      on command SNMPCollector.PollDevice is {
        do "the model sends poll device"
      }
      on other is {
        error "Unexpected message for adaptor ToSNMPCollector"
      }
    } with {
      briefly "to snmp collector"
      described as {
        |Carries messages to the external SNMPCollector.
      }
    }
  } with {
    briefly "SNMPCollector integration"
    described as {
      |The model's side of the SNMPCollector conversation.
    }
  }
  adaptor FromSyslogReceiver from context SyslogReceiver is { 
    handler FromSyslogReceiverHandler is {
      on event SyslogReceiver.SyslogReceived is {
        do "the model receives syslog received"
      }
      on other is {
        error "Unexpected message for adaptor FromSyslogReceiver"
      }
    } with {
      briefly "from syslog receiver"
      described as {
        |Carries messages from the external SyslogReceiver.
      }
    }
  } with {
    briefly "SyslogReceiver integration"
    described as {
      |The model's side of the SyslogReceiver conversation.
    }
  }
  adaptor FromTopologyDiscovery from context TopologyDiscovery is { 
    handler FromTopologyDiscoveryHandler is {
      on event TopologyDiscovery.TopologyDiscovered is {
        do "the model receives topology discovered"
      }
      on other is {
        error "Unexpected message for adaptor FromTopologyDiscovery"
      }
    } with {
      briefly "from topology discovery"
      described as {
        |Carries messages from the external TopologyDiscovery.
      }
    }
  } with {
    briefly "TopologyDiscovery integration"
    described as {
      |The model's side of the TopologyDiscovery conversation.
    }
  }
  adaptor ToTopologyDiscovery to context TopologyDiscovery is { 
    handler ToTopologyDiscoveryHandler is {
      on command TopologyDiscovery.DiscoverTopology is {
        do "the model sends discover topology"
      }
      on other is {
        error "Unexpected message for adaptor ToTopologyDiscovery"
      }
    } with {
      briefly "to topology discovery"
      described as {
        |Carries messages to the external TopologyDiscovery.
      }
    }
  } with {
    briefly "TopologyDiscovery integration"
    described as {
      |The model's side of the TopologyDiscovery conversation.
    }
  }
  include "types.riddl"
  include "NetworkDevice.riddl"
  repository DeviceRepository as merge is {
    inlet DeviceRepositoryFromNetworkDevice is type NetworkDeviceEvent    inlet DeviceRepositoryFromNetworkAnalytics is type NetworkDeviceEvent    outlet DeviceRepositoryResponses is type NetworkDevice.NetworkDeviceResult
    record StoredNetworkDevice is  {
      networkDeviceId: UUID with {
        briefly "networkDeviceId"
        described as {
          |The networkDeviceId column of the stored networkDevice row.
        }
      }
      deviceInfo: DeviceInfo with {
        briefly "deviceInfo"
        described as {
          |The deviceInfo column of the stored networkDevice row.
        }
      }
      deviceType: DeviceType with {
        briefly "deviceType"
        described as {
          |The deviceType column of the stored networkDevice row.
        }
      }
      status: DeviceStatus with {
        briefly "status"
        described as {
          |The status column of the stored networkDevice row.
        }
      }
    } with {
      briefly "Stored networkDevice row"
      described as {
        |The persistence shape of networkDevice data as this repository stores it.
      }
    }
    schema DeviceData is relational
      of devices as type StoredNetworkDevice
        index on field StoredNetworkDevice.deviceInfo.hostname
        index on field StoredNetworkDevice.deviceInfo.ipAddress
        index on field StoredNetworkDevice.status
        index on field StoredNetworkDevice.deviceType
 with {
      briefly "Device data schema"
      described as {
        |The relational schema holding device data for the DeviceRepository.
      }
    }
    handler DevicePersistence is {
      on query GetNetworkMetrics is {
        do "read the network metrics projection"
        yield result NetworkMetricsView
      }
      on command NetworkDevice.RegisterDevice is {
        do "Store new device record"
      }
      on command NetworkDevice.UpdateDeviceInfo is {
        tell event NetworkDevice.DeviceInfoUpdated to entity MonitoringContext.NetworkDevice
        do "Update device information"
      }
      on command NetworkDevice.ConfigureThresholds is {
        do "Store threshold configuration"
      }
      on command NetworkDevice.RecordMetrics is {
        tell event NetworkDevice.MetricsRecorded to entity MonitoringContext.NetworkDevice
        do "Store metrics snapshot"
      }
      on command NetworkDevice.RaiseAlert is {
        do "Store alert record"
      }
      on command NetworkDevice.AcknowledgeAlert is {
        tell event NetworkDevice.AlertAcknowledged to entity MonitoringContext.NetworkDevice
        do "Update alert status"
      }
      on command NetworkDevice.ResolveAlert is {
        do "Close alert record"
      }
      on command NetworkDevice.DecommissionDevice is {
        do "Archive device record"
      }
    } with {
      briefly "Persists device commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Device data persistence"
    described as {
      |Persistent storage for devices.
    }
  }
  query GetNetworkMetrics is  {
    networkMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which network metrics to retrieve.
      }
    }
  } with {
    briefly "Get network metrics"
    described as {
      |Retrieves the network metrics projection.
    }
  }
  result NetworkMetricsView is  {
    networkMetrics: NetworkAnalytics.NetworkMetrics with {
      briefly "Network metrics"
      described as {
        |The network metrics being returned.
      }
    }
  } with {
    briefly "Network metrics view"
    described as {
      |Read model view carrying the network metrics projection.
    }
  }
  projector NetworkAnalytics as flow is {
    updates repository MonitoringContext.DeviceRepository
    inlet NetworkAnalyticsFromNetworkDevice is type NetworkDeviceEvent    outlet NetworkAnalyticsOut is type NetworkDeviceEvent
    record NetworkMetrics is  {
      totalDevices: Natural with {
        briefly "Total"
        described as {
          |Total devices.
        }
      }
      onlineDevices: Natural with {
        briefly "Online"
        described as {
          |Online devices.
        }
      }
      activeAlertCount: Natural with {
        briefly "Alerts"
        described as {
          |Active alerts.
        }
      }
      criticalAlerts: Natural with {
        briefly "Critical"
        described as {
          |Critical alerts.
        }
      }
      averageLatency: Decimal(8,2) with {
        briefly "Latency"
        described as {
          |Avg latency.
        }
      }
      networkAvailability: Decimal(5,2) with {
        briefly "Availability"
        described as {
          |Availability %.
        }
      }
    } with {
      briefly "Network metrics"
      described as {
        |Network-wide metrics.
      }
    }
    handler AnalyticsHandler is {
      on event NetworkDevice.DeviceRegistered is {
        tell event NetworkDevice.DeviceRegistered to repository MonitoringContext.DeviceRepository
        do "Increment device count"
      }
      on event NetworkDevice.MetricsRecorded is {
        tell event NetworkDevice.MetricsRecorded to repository MonitoringContext.DeviceRepository
        do "Update network statistics"
      }
      on event NetworkDevice.AlertRaised is {
        tell event NetworkDevice.AlertRaised to repository MonitoringContext.DeviceRepository
        do "Increment alert count"
      }
      on event NetworkDevice.AlertResolved is {
        tell event NetworkDevice.AlertResolved to repository MonitoringContext.DeviceRepository
        do "Decrement alert count"
      }
      on event NetworkDevice.DeviceMarkedOffline is {
        tell event NetworkDevice.DeviceMarkedOffline to repository MonitoringContext.DeviceRepository
        do "Update availability"
      }
    } with {
      briefly "Maintains network analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Network analytics"
    described as {
      |Network performance tracking.
    }
  }
  // ---- Event publication for NetworkDevice ----
  type NetworkDeviceEvent is one of {
    MonitoringContext.NetworkDevice.DeviceRegistered or MonitoringContext.NetworkDevice.DeviceInfoUpdated or MonitoringContext.NetworkDevice.ThresholdsConfigured or MonitoringContext.NetworkDevice.MetricsRecorded or MonitoringContext.NetworkDevice.AlertRaised or MonitoringContext.NetworkDevice.AlertAcknowledged or MonitoringContext.NetworkDevice.AlertResolved or MonitoringContext.NetworkDevice.MaintenanceScheduled or MonitoringContext.NetworkDevice.MaintenanceEnded or MonitoringContext.NetworkDevice.DeviceMarkedOffline or MonitoringContext.NetworkDevice.DeviceDecommissioned
  } with {
    briefly "NetworkDevice event alternation"
    described as {
      |Union of all NetworkDevice events, for streaming and event-sourced
      |persistence.
    }
  }
  processor NetworkDeviceEventSource as source is {
    outlet NetworkDeviceEvents is type NetworkDeviceEvent
    handler NetworkDeviceSourceHandler is {
      on event NetworkDevice.DeviceRegistered is {
        send event NetworkDevice.DeviceRegistered to outlet NetworkDeviceEvents
      }
      on event NetworkDevice.DeviceInfoUpdated is {
        send event NetworkDevice.DeviceInfoUpdated to outlet NetworkDeviceEvents
      }
      on event NetworkDevice.ThresholdsConfigured is {
        send event NetworkDevice.ThresholdsConfigured to outlet NetworkDeviceEvents
      }
      on event NetworkDevice.MetricsRecorded is {
        send event NetworkDevice.MetricsRecorded to outlet NetworkDeviceEvents
      }
      on event NetworkDevice.AlertRaised is {
        send event NetworkDevice.AlertRaised to outlet NetworkDeviceEvents
      }
      on event NetworkDevice.AlertAcknowledged is {
        send event NetworkDevice.AlertAcknowledged to outlet NetworkDeviceEvents
      }
      on event NetworkDevice.AlertResolved is {
        send event NetworkDevice.AlertResolved to outlet NetworkDeviceEvents
      }
      on event NetworkDevice.MaintenanceScheduled is {
        send event NetworkDevice.MaintenanceScheduled to outlet NetworkDeviceEvents
      }
      on event NetworkDevice.MaintenanceEnded is {
        send event NetworkDevice.MaintenanceEnded to outlet NetworkDeviceEvents
      }
      on event NetworkDevice.DeviceMarkedOffline is {
        send event NetworkDevice.DeviceMarkedOffline to outlet NetworkDeviceEvents
      }
      on event NetworkDevice.DeviceDecommissioned is {
        send event NetworkDevice.DeviceDecommissioned to outlet NetworkDeviceEvents
      }
      on other is {
        error "Unexpected message for source NetworkDeviceEventSource"
      }
    } with {
      briefly "NetworkDevice source handler"
      described as {
        |Publishes NetworkDevice events onto the outlet.
      }
    }
  } with {
    briefly "NetworkDevice event source"
    described as {
      |Publishes NetworkDevice entity events into the streaming topology.
    }
  }
  processor NetworkDeviceEventSink as sink is {
    inlet NetworkDeviceInlet is type NetworkDeviceEvent    handler NetworkDeviceSinkHandler is {
      on event NetworkDevice.DeviceRegistered is {
        tell event NetworkDevice.DeviceRegistered to repository MonitoringContext.DeviceRepository
      }
      on event NetworkDevice.DeviceInfoUpdated is {
        tell event NetworkDevice.DeviceInfoUpdated to repository MonitoringContext.DeviceRepository
      }
      on event NetworkDevice.ThresholdsConfigured is {
        tell event NetworkDevice.ThresholdsConfigured to repository MonitoringContext.DeviceRepository
      }
      on event NetworkDevice.MetricsRecorded is {
        tell event NetworkDevice.MetricsRecorded to repository MonitoringContext.DeviceRepository
      }
      on event NetworkDevice.AlertRaised is {
        tell event NetworkDevice.AlertRaised to repository MonitoringContext.DeviceRepository
      }
      on event NetworkDevice.AlertAcknowledged is {
        tell event NetworkDevice.AlertAcknowledged to repository MonitoringContext.DeviceRepository
      }
      on event NetworkDevice.AlertResolved is {
        tell event NetworkDevice.AlertResolved to repository MonitoringContext.DeviceRepository
      }
      on event NetworkDevice.MaintenanceScheduled is {
        tell event NetworkDevice.MaintenanceScheduled to repository MonitoringContext.DeviceRepository
      }
      on event NetworkDevice.MaintenanceEnded is {
        tell event NetworkDevice.MaintenanceEnded to repository MonitoringContext.DeviceRepository
      }
      on event NetworkDevice.DeviceMarkedOffline is {
        tell event NetworkDevice.DeviceMarkedOffline to repository MonitoringContext.DeviceRepository
      }
      on event NetworkDevice.DeviceDecommissioned is {
        tell event NetworkDevice.DeviceDecommissioned to repository MonitoringContext.DeviceRepository
      }
      on other is {
        error "Unexpected message for sink NetworkDeviceEventSink"
      }
    } with {
      briefly "NetworkDevice sink handler"
      described as {
        |Persists NetworkDevice events via the repository.
      }
    }
  } with {
    briefly "NetworkDevice event sink"
    described as {
      |Receives NetworkDevice events for persistence.
    }
  }
  connector NetworkDeviceEventFlow is from outlet MonitoringContext.NetworkDeviceEventSource.NetworkDeviceEvents to inlet MonitoringContext.NetworkDeviceEventSink.NetworkDeviceInlet with {
    briefly "NetworkDevice event flow"
    described as {
      |Connects the NetworkDevice source to its sink.
    }
  }
  processor NetworkDeviceEventSplit as split is {
    inlet NetworkDeviceEventSplitIn is type NetworkDeviceEvent    outlet NetworkDeviceEventSplitToDeviceRepository is type NetworkDeviceEvent
    outlet NetworkDeviceEventSplitToNetworkAnalytics is type NetworkDeviceEvent
    handler NetworkDeviceEventSplitHandler is {
      on event NetworkDevice.DeviceRegistered is {
        send event NetworkDevice.DeviceRegistered to outlet NetworkDeviceEventSplitToDeviceRepository
        send event NetworkDevice.DeviceRegistered to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell event NetworkDevice.DeviceRegistered to entity MonitoringContext.NetworkDevice
      }
      on event NetworkDevice.DeviceInfoUpdated is {
        send event NetworkDevice.DeviceInfoUpdated to outlet NetworkDeviceEventSplitToDeviceRepository
        send event NetworkDevice.DeviceInfoUpdated to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell event NetworkDevice.DeviceInfoUpdated to entity MonitoringContext.NetworkDevice
      }
      on event NetworkDevice.ThresholdsConfigured is {
        send event NetworkDevice.ThresholdsConfigured to outlet NetworkDeviceEventSplitToDeviceRepository
        send event NetworkDevice.ThresholdsConfigured to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell event NetworkDevice.ThresholdsConfigured to entity MonitoringContext.NetworkDevice
      }
      on event NetworkDevice.MetricsRecorded is {
        send event NetworkDevice.MetricsRecorded to outlet NetworkDeviceEventSplitToDeviceRepository
        send event NetworkDevice.MetricsRecorded to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell event NetworkDevice.MetricsRecorded to entity MonitoringContext.NetworkDevice
      }
      on event NetworkDevice.AlertRaised is {
        send event NetworkDevice.AlertRaised to outlet NetworkDeviceEventSplitToDeviceRepository
        send event NetworkDevice.AlertRaised to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell event NetworkDevice.AlertRaised to entity MonitoringContext.NetworkDevice
      }
      on event NetworkDevice.AlertAcknowledged is {
        send event NetworkDevice.AlertAcknowledged to outlet NetworkDeviceEventSplitToDeviceRepository
        send event NetworkDevice.AlertAcknowledged to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell event NetworkDevice.AlertAcknowledged to entity MonitoringContext.NetworkDevice
      }
      on event NetworkDevice.AlertResolved is {
        send event NetworkDevice.AlertResolved to outlet NetworkDeviceEventSplitToDeviceRepository
        send event NetworkDevice.AlertResolved to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell event NetworkDevice.AlertResolved to entity MonitoringContext.NetworkDevice
      }
      on event NetworkDevice.MaintenanceScheduled is {
        send event NetworkDevice.MaintenanceScheduled to outlet NetworkDeviceEventSplitToDeviceRepository
        send event NetworkDevice.MaintenanceScheduled to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell event NetworkDevice.MaintenanceScheduled to entity MonitoringContext.NetworkDevice
      }
      on event NetworkDevice.MaintenanceEnded is {
        send event NetworkDevice.MaintenanceEnded to outlet NetworkDeviceEventSplitToDeviceRepository
        send event NetworkDevice.MaintenanceEnded to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell event NetworkDevice.MaintenanceEnded to entity MonitoringContext.NetworkDevice
      }
      on event NetworkDevice.DeviceMarkedOffline is {
        send event NetworkDevice.DeviceMarkedOffline to outlet NetworkDeviceEventSplitToDeviceRepository
        send event NetworkDevice.DeviceMarkedOffline to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell event NetworkDevice.DeviceMarkedOffline to entity MonitoringContext.NetworkDevice
      }
      on event NetworkDevice.DeviceDecommissioned is {
        send event NetworkDevice.DeviceDecommissioned to outlet NetworkDeviceEventSplitToDeviceRepository
        send event NetworkDevice.DeviceDecommissioned to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell event NetworkDevice.DeviceDecommissioned to entity MonitoringContext.NetworkDevice
      }
      on other is {
        error "Unexpected message for processor NetworkDeviceEventSplit"
      }
    } with {
      briefly "NetworkDevice event fan-out handler"
      described as {
        |Delivers each NetworkDevice event to all of its consumers.
      }
    }
  } with {
    briefly "NetworkDevice event fan-out"
    described as {
      |Fans NetworkDevice events out to the repository and projectors.
    }
  }
  connector 'NetworkDeviceEvent Stream' is from outlet MonitoringContext.NetworkDevice.NetworkDeviceEvents2 to inlet MonitoringContext.NetworkDeviceEventSplit.NetworkDeviceEventSplitIn with {
    briefly "NetworkDevice events, fanned out to storage and read models"
  }
  connector 'NetworkDeviceEvent Storage' is from outlet MonitoringContext.NetworkDeviceEventSplit.NetworkDeviceEventSplitToDeviceRepository to inlet MonitoringContext.DeviceRepository.DeviceRepositoryFromNetworkDevice with {
    briefly "NetworkDevice events on their way to storage"
  }
  connector 'NetworkAnalytics Feed' is from outlet MonitoringContext.NetworkDeviceEventSplit.NetworkDeviceEventSplitToNetworkAnalytics to inlet MonitoringContext.NetworkAnalytics.NetworkAnalyticsFromNetworkDevice with {
    briefly "NetworkDevice events feeding the NetworkAnalytics projection"
  }
  connector 'NetworkAnalytics Storage' is from outlet MonitoringContext.NetworkAnalytics.NetworkAnalyticsOut to inlet MonitoringContext.DeviceRepository.DeviceRepositoryFromNetworkAnalytics with {
    briefly "The NetworkAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for network monitoring"
  described as {
    |Network operations context.
  }
}
