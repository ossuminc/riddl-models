// Network Monitoring - Monitoring Context
context MonitoringContext as router is {
  inlet NetworkDeviceCommandStreamIn is type NetworkDeviceCommand  outlet NetworkDeviceCommandStreamOut is type NetworkDeviceCommand
  inlet NetworkDeviceResultStreamIn is type NetworkDevice.NetworkDeviceResult  outlet NetworkDeviceResultStreamOut is type NetworkDevice.NetworkDeviceResult
  handler MonitoringContextBoundary is {
    on registerDevice: command NetworkDevice.RegisterDevice is {
      send registerDevice to outlet MonitoringContext.NetworkDeviceCommandStreamOut
    }
    on updateDeviceInfo: command NetworkDevice.UpdateDeviceInfo is {
      send updateDeviceInfo to outlet MonitoringContext.NetworkDeviceCommandStreamOut
    }
    on configureThresholds: command NetworkDevice.ConfigureThresholds is {
      send configureThresholds to outlet MonitoringContext.NetworkDeviceCommandStreamOut
    }
    on recordMetrics: command NetworkDevice.RecordMetrics is {
      send recordMetrics to outlet MonitoringContext.NetworkDeviceCommandStreamOut
    }
    on raiseAlert: command NetworkDevice.RaiseAlert is {
      send raiseAlert to outlet MonitoringContext.NetworkDeviceCommandStreamOut
    }
    on acknowledgeAlert: command NetworkDevice.AcknowledgeAlert is {
      send acknowledgeAlert to outlet MonitoringContext.NetworkDeviceCommandStreamOut
    }
    on resolveAlert: command NetworkDevice.ResolveAlert is {
      send resolveAlert to outlet MonitoringContext.NetworkDeviceCommandStreamOut
    }
    on scheduleMaintenance: command NetworkDevice.ScheduleMaintenance is {
      send scheduleMaintenance to outlet MonitoringContext.NetworkDeviceCommandStreamOut
    }
    on endMaintenance: command NetworkDevice.EndMaintenance is {
      send endMaintenance to outlet MonitoringContext.NetworkDeviceCommandStreamOut
    }
    on markOffline: command NetworkDevice.MarkOffline is {
      send markOffline to outlet MonitoringContext.NetworkDeviceCommandStreamOut
    }
    on decommissionDevice: command NetworkDevice.DecommissionDevice is {
      send decommissionDevice to outlet MonitoringContext.NetworkDeviceCommandStreamOut
    }
    on networkDeviceResult: result NetworkDevice.NetworkDeviceResult is {
      send networkDeviceResult to outlet MonitoringContext.NetworkDeviceResultStreamOut
    }
    on other is {
      error "Unexpected message at the MonitoringContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'NetworkDeviceCommand Stream Intake' is from outlet MonitoringContext.NetworkDeviceCommandStreamOut to inlet MonitoringContext.NetworkDevice.NetworkDeviceCommands  connector 'NetworkDeviceResult Stream Egress' is from outlet MonitoringContext.DeviceRepository.DeviceRepositoryResponses to inlet MonitoringContext.NetworkDeviceResultStreamIn  adaptor FromAlertNotification from context AlertNotification is { 
    handler FromAlertNotificationHandler is {
      on event AlertNotification.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromAlertNotification"
      }
    } with {
      briefly "from alert notification"
      described as {
        |Carries messages from the external AlertNotification.
      }
    }
  } with {
    briefly "AlertNotification integration"
    described as {
      |The model's side of the AlertNotification conversation.
    }
  }
  adaptor ToAlertNotification to context AlertNotification is { 
    handler ToAlertNotificationHandler is {
      on command AlertNotification.SendAlertNotification is {
        do "the model sends send alert notification"
      }
      on other is {
        error "Unexpected message for adaptor ToAlertNotification"
      }
    } with {
      briefly "to alert notification"
      described as {
        |Carries messages to the external AlertNotification.
      }
    }
  } with {
    briefly "AlertNotification integration"
    described as {
      |The model's side of the AlertNotification conversation.
    }
  }
  adaptor FromConfigBackup from context ConfigBackup is { 
    handler FromConfigBackupHandler is {
      on event ConfigBackup.ConfigBackedUp is {
        do "the model receives config backed up"
      }
      on event ConfigBackup.ConfigsCompared is {
        do "the model receives configs compared"
      }
      on other is {
        error "Unexpected message for adaptor FromConfigBackup"
      }
    } with {
      briefly "from config backup"
      described as {
        |Carries messages from the external ConfigBackup.
      }
    }
  } with {
    briefly "ConfigBackup integration"
    described as {
      |The model's side of the ConfigBackup conversation.
    }
  }
  adaptor ToConfigBackup to context ConfigBackup is { 
    handler ToConfigBackupHandler is {
      on command ConfigBackup.BackupDeviceConfig is {
        do "the model sends backup device config"
      }
      on command ConfigBackup.CompareConfigs is {
        do "the model sends compare configs"
      }
      on other is {
        error "Unexpected message for adaptor ToConfigBackup"
      }
    } with {
      briefly "to config backup"
      described as {
        |Carries messages to the external ConfigBackup.
      }
    }
  } with {
    briefly "ConfigBackup integration"
    described as {
      |The model's side of the ConfigBackup conversation.
    }
  }
  adaptor FromSNMPCollector from context SNMPCollector is { 
    handler FromSNMPCollectorHandler is {
      on event SNMPCollector.SNMPDataCollected is {
        do "the model receives snmp data collected"
      }
      on event SNMPCollector.SNMPPollFailed is {
        do "the model receives snmp poll failed"
      }
      on other is {
        error "Unexpected message for adaptor FromSNMPCollector"
      }
    } with {
      briefly "from snmp collector"
      described as {
        |Carries messages from the external SNMPCollector.
      }
    }
  } with {
    briefly "SNMPCollector integration"
    described as {
      |The model's side of the SNMPCollector conversation.
    }
  }
  adaptor ToSNMPCollector to context SNMPCollector is { 
    handler ToSNMPCollectorHandler is {
      on command SNMPCollector.PollDevice is {
        do "the model sends poll device"
      }
      on other is {
        error "Unexpected message for adaptor ToSNMPCollector"
      }
    } with {
      briefly "to snmp collector"
      described as {
        |Carries messages to the external SNMPCollector.
      }
    }
  } with {
    briefly "SNMPCollector integration"
    described as {
      |The model's side of the SNMPCollector conversation.
    }
  }
  adaptor FromSyslogReceiver from context SyslogReceiver is { 
    handler FromSyslogReceiverHandler is {
      on event SyslogReceiver.SyslogReceived is {
        do "the model receives syslog received"
      }
      on other is {
        error "Unexpected message for adaptor FromSyslogReceiver"
      }
    } with {
      briefly "from syslog receiver"
      described as {
        |Carries messages from the external SyslogReceiver.
      }
    }
  } with {
    briefly "SyslogReceiver integration"
    described as {
      |The model's side of the SyslogReceiver conversation.
    }
  }
  adaptor FromTopologyDiscovery from context TopologyDiscovery is { 
    handler FromTopologyDiscoveryHandler is {
      on event TopologyDiscovery.TopologyDiscovered is {
        do "the model receives topology discovered"
      }
      on other is {
        error "Unexpected message for adaptor FromTopologyDiscovery"
      }
    } with {
      briefly "from topology discovery"
      described as {
        |Carries messages from the external TopologyDiscovery.
      }
    }
  } with {
    briefly "TopologyDiscovery integration"
    described as {
      |The model's side of the TopologyDiscovery conversation.
    }
  }
  adaptor ToTopologyDiscovery to context TopologyDiscovery is { 
    handler ToTopologyDiscoveryHandler is {
      on command TopologyDiscovery.DiscoverTopology is {
        do "the model sends discover topology"
      }
      on other is {
        error "Unexpected message for adaptor ToTopologyDiscovery"
      }
    } with {
      briefly "to topology discovery"
      described as {
        |Carries messages to the external TopologyDiscovery.
      }
    }
  } with {
    briefly "TopologyDiscovery integration"
    described as {
      |The model's side of the TopologyDiscovery conversation.
    }
  }
  include "types.riddl"
  include "NetworkDevice.riddl"
  type DeviceRepositoryCommand is one of {
    MonitoringContext.DeviceRepository.PersistAlertAcknowledged or MonitoringContext.DeviceRepository.PersistAlertRaised or MonitoringContext.DeviceRepository.PersistAlertResolved or MonitoringContext.DeviceRepository.PersistDeviceDecommissioned or MonitoringContext.DeviceRepository.PersistDeviceInfoUpdated or MonitoringContext.DeviceRepository.PersistDeviceMarkedOffline or MonitoringContext.DeviceRepository.PersistDeviceRegistered or MonitoringContext.DeviceRepository.PersistMaintenanceEnded or MonitoringContext.DeviceRepository.PersistMaintenanceScheduled or MonitoringContext.DeviceRepository.PersistMetricsRecorded or MonitoringContext.DeviceRepository.PersistThresholdsConfigured
  } with {
    briefly "Anything that writes DeviceRepository"
    described as {
      |The persistence commands DeviceRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository DeviceRepository as flow is {
    inlet DeviceRepositoryFromNetworkAnalytics is type DeviceRepositoryCommand
    command PersistAlertAcknowledged is  {
      deviceId: DeviceId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlertAcknowledged applies to.
        }
      }
    } with {
      briefly "Persist AlertAcknowledged"
      described as {
        |Instructs this repository to apply AlertAcknowledged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeviceDecommissioned is  {
      deviceId: DeviceId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeviceDecommissioned applies to.
        }
      }
    } with {
      briefly "Persist DeviceDecommissioned"
      described as {
        |Instructs this repository to apply DeviceDecommissioned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeviceInfoUpdated is  {
      deviceId: DeviceId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeviceInfoUpdated applies to.
        }
      }
    } with {
      briefly "Persist DeviceInfoUpdated"
      described as {
        |Instructs this repository to apply DeviceInfoUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceEnded is  {
      deviceId: DeviceId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceEnded applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceEnded"
      described as {
        |Instructs this repository to apply MaintenanceEnded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceScheduled is  {
      deviceId: DeviceId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceScheduled applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceScheduled"
      described as {
        |Instructs this repository to apply MaintenanceScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistThresholdsConfigured is  {
      deviceId: DeviceId with {
        briefly "Row addressed"
        described as {
          |Which stored row ThresholdsConfigured applies to.
        }
      }
    } with {
      briefly "Persist ThresholdsConfigured"
      described as {
        |Instructs this repository to apply ThresholdsConfigured to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAlertRaised is  {
      deviceId: DeviceId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlertRaised applies to.
        }
      }
    } with {
      briefly "Persist AlertRaised"
      described as {
        |Instructs this repository to apply AlertRaised to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAlertResolved is  {
      deviceId: DeviceId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlertResolved applies to.
        }
      }
    } with {
      briefly "Persist AlertResolved"
      described as {
        |Instructs this repository to apply AlertResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeviceMarkedOffline is  {
      deviceId: DeviceId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeviceMarkedOffline applies to.
        }
      }
    } with {
      briefly "Persist DeviceMarkedOffline"
      described as {
        |Instructs this repository to apply DeviceMarkedOffline to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeviceRegistered is  {
      deviceId: DeviceId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeviceRegistered applies to.
        }
      }
    } with {
      briefly "Persist DeviceRegistered"
      described as {
        |Instructs this repository to apply DeviceRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMetricsRecorded is  {
      deviceId: DeviceId with {
        briefly "Row addressed"
        described as {
          |Which stored row MetricsRecorded applies to.
        }
      }
    } with {
      briefly "Persist MetricsRecorded"
      described as {
        |Instructs this repository to apply MetricsRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet DeviceRepositoryResponses is type NetworkDevice.NetworkDeviceResult
    record StoredNetworkDevice is  {
      networkDeviceId: UUID with {
        briefly "networkDeviceId"
        described as {
          |The networkDeviceId column of the stored networkDevice row.
        }
      }
      deviceInfo: DeviceInfo with {
        briefly "deviceInfo"
        described as {
          |The deviceInfo column of the stored networkDevice row.
        }
      }
      deviceType: DeviceType with {
        briefly "deviceType"
        described as {
          |The deviceType column of the stored networkDevice row.
        }
      }
      status: DeviceStatus with {
        briefly "status"
        described as {
          |The status column of the stored networkDevice row.
        }
      }
    } with {
      briefly "Stored networkDevice row"
      described as {
        |The persistence shape of networkDevice data as this repository stores it.
      }
    }
    schema DeviceData is relational
      of devices as type StoredNetworkDevice
        index on field StoredNetworkDevice.deviceInfo.hostname
        index on field StoredNetworkDevice.deviceInfo.ipAddress
        index on field StoredNetworkDevice.status
        index on field StoredNetworkDevice.deviceType
 with {
      briefly "Device data schema"
      described as {
        |The relational schema holding device data for the DeviceRepository.
      }
    }
    handler DevicePersistence is {
      on persistAlertAcknowledged: command PersistAlertAcknowledged is {
        do "apply AlertAcknowledged to the stored row"
      }
      on persistDeviceDecommissioned: command PersistDeviceDecommissioned is {
        do "apply DeviceDecommissioned to the stored row"
      }
      on persistDeviceInfoUpdated: command PersistDeviceInfoUpdated is {
        do "apply DeviceInfoUpdated to the stored row"
      }
      on persistMaintenanceEnded: command PersistMaintenanceEnded is {
        do "apply MaintenanceEnded to the stored row"
      }
      on persistMaintenanceScheduled: command PersistMaintenanceScheduled is {
        do "apply MaintenanceScheduled to the stored row"
      }
      on persistThresholdsConfigured: command PersistThresholdsConfigured is {
        do "apply ThresholdsConfigured to the stored row"
      }
      on persistAlertRaised: command PersistAlertRaised is {
        do "apply AlertRaised to the stored row"
      }
      on persistAlertResolved: command PersistAlertResolved is {
        do "apply AlertResolved to the stored row"
      }
      on persistDeviceMarkedOffline: command PersistDeviceMarkedOffline is {
        do "apply DeviceMarkedOffline to the stored row"
      }
      on persistDeviceRegistered: command PersistDeviceRegistered is {
        do "apply DeviceRegistered to the stored row"
      }
      on persistMetricsRecorded: command PersistMetricsRecorded is {
        do "apply MetricsRecorded to the stored row"
      }
      on query GetNetworkMetrics is {
        let networkMetricsView: type NetworkMetricsView = prompt("read the network metrics projection")
        reply networkMetricsView
      }
    } with {
      briefly "Persists device commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Device data persistence"
    described as {
      |Persistent storage for devices.
    }
  }
  query GetNetworkMetrics replies result NetworkMetricsView is  {
    networkMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which network metrics to retrieve.
      }
    }
  } with {
    briefly "Get network metrics"
    described as {
      |Retrieves the network metrics projection.
    }
  }
  result NetworkMetricsView is  {
    networkMetrics: NetworkAnalytics.NetworkMetrics with {
      briefly "Network metrics"
      described as {
        |The network metrics being returned.
      }
    }
  } with {
    briefly "Network metrics view"
    described as {
      |Read model view carrying the network metrics projection.
    }
  }
  projector NetworkAnalytics as flow is {
    outlet NetworkAnalyticsToRepository is type DeviceRepositoryCommand
    updates repository MonitoringContext.DeviceRepository
    inlet NetworkAnalyticsFromNetworkDevice is type NetworkDeviceEvent
    record NetworkMetrics is  {
      totalDevices: Natural with {
        briefly "Total"
        described as {
          |Total devices.
        }
      }
      onlineDevices: Natural with {
        briefly "Online"
        described as {
          |Online devices.
        }
      }
      activeAlertCount: Natural with {
        briefly "Alerts"
        described as {
          |Active alerts.
        }
      }
      criticalAlerts: Natural with {
        briefly "Critical"
        described as {
          |Critical alerts.
        }
      }
      averageLatency: Decimal(8,2) with {
        briefly "Latency"
        described as {
          |Avg latency.
        }
      }
      networkAvailability: Decimal(5,2) with {
        briefly "Availability"
        described as {
          |Availability %.
        }
      }
    } with {
      briefly "Network metrics"
      described as {
        |Network-wide metrics.
      }
    }
    handler AnalyticsHandler is {
      on alertAcknowledged: event NetworkDevice.AlertAcknowledged is {
        tell command MonitoringContext.DeviceRepository.PersistAlertAcknowledged(deviceId = alertAcknowledged.deviceId) to repository MonitoringContext.DeviceRepository
        do "apply AlertAcknowledged to the NetworkAnalytics projection"
      }
      on deviceDecommissioned: event NetworkDevice.DeviceDecommissioned is {
        tell command MonitoringContext.DeviceRepository.PersistDeviceDecommissioned(deviceId = deviceDecommissioned.deviceId) to repository MonitoringContext.DeviceRepository
        do "apply DeviceDecommissioned to the NetworkAnalytics projection"
      }
      on deviceInfoUpdated: event NetworkDevice.DeviceInfoUpdated is {
        tell command MonitoringContext.DeviceRepository.PersistDeviceInfoUpdated(deviceId = deviceInfoUpdated.deviceId) to repository MonitoringContext.DeviceRepository
        do "apply DeviceInfoUpdated to the NetworkAnalytics projection"
      }
      on maintenanceEnded: event NetworkDevice.MaintenanceEnded is {
        tell command MonitoringContext.DeviceRepository.PersistMaintenanceEnded(deviceId = maintenanceEnded.deviceId) to repository MonitoringContext.DeviceRepository
        do "apply MaintenanceEnded to the NetworkAnalytics projection"
      }
      on maintenanceScheduled: event NetworkDevice.MaintenanceScheduled is {
        tell command MonitoringContext.DeviceRepository.PersistMaintenanceScheduled(deviceId = maintenanceScheduled.deviceId) to repository MonitoringContext.DeviceRepository
        do "apply MaintenanceScheduled to the NetworkAnalytics projection"
      }
      on thresholdsConfigured: event NetworkDevice.ThresholdsConfigured is {
        tell command MonitoringContext.DeviceRepository.PersistThresholdsConfigured(deviceId = thresholdsConfigured.deviceId) to repository MonitoringContext.DeviceRepository
        do "apply ThresholdsConfigured to the NetworkAnalytics projection"
      }
      on deviceRegistered: event NetworkDevice.DeviceRegistered is {
        tell command MonitoringContext.DeviceRepository.PersistDeviceRegistered(deviceId = deviceRegistered.deviceId) to repository MonitoringContext.DeviceRepository
        do "Increment device count"
      }
      on metricsRecorded: event NetworkDevice.MetricsRecorded is {
        tell command MonitoringContext.DeviceRepository.PersistMetricsRecorded(deviceId = metricsRecorded.deviceId) to repository MonitoringContext.DeviceRepository
        do "Update network statistics"
      }
      on alertRaised: event NetworkDevice.AlertRaised is {
        tell command MonitoringContext.DeviceRepository.PersistAlertRaised(deviceId = alertRaised.deviceId) to repository MonitoringContext.DeviceRepository
        do "Increment alert count"
      }
      on alertResolved: event NetworkDevice.AlertResolved is {
        tell command MonitoringContext.DeviceRepository.PersistAlertResolved(deviceId = alertResolved.deviceId) to repository MonitoringContext.DeviceRepository
        do "Decrement alert count"
      }
      on deviceMarkedOffline: event NetworkDevice.DeviceMarkedOffline is {
        tell command MonitoringContext.DeviceRepository.PersistDeviceMarkedOffline(deviceId = deviceMarkedOffline.deviceId) to repository MonitoringContext.DeviceRepository
        do "Update availability"
      }
    } with {
      briefly "Maintains network analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Network analytics"
    described as {
      |Network performance tracking.
    }
  }
  // ---- Event publication for NetworkDevice ----
  type NetworkDeviceEvent is one of {
    MonitoringContext.NetworkDevice.DeviceRegistered or MonitoringContext.NetworkDevice.DeviceInfoUpdated or MonitoringContext.NetworkDevice.ThresholdsConfigured or MonitoringContext.NetworkDevice.MetricsRecorded or MonitoringContext.NetworkDevice.AlertRaised or MonitoringContext.NetworkDevice.AlertAcknowledged or MonitoringContext.NetworkDevice.AlertResolved or MonitoringContext.NetworkDevice.MaintenanceScheduled or MonitoringContext.NetworkDevice.MaintenanceEnded or MonitoringContext.NetworkDevice.DeviceMarkedOffline or MonitoringContext.NetworkDevice.DeviceDecommissioned
  } with {
    briefly "NetworkDevice event alternation"
    described as {
      |Union of all NetworkDevice events, for streaming and event-sourced
      |persistence.
    }
  }
  processor NetworkDeviceEventSplit as flow is {
    inlet NetworkDeviceEventSplitIn is type NetworkDeviceEvent
    outlet NetworkDeviceEventSplitToNetworkAnalytics is type NetworkDeviceEvent
    handler NetworkDeviceEventSplitHandler is {
      on deviceRegistered: event NetworkDevice.DeviceRegistered is {
        send deviceRegistered to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell deviceRegistered to entity MonitoringContext.NetworkDevice
      }
      on deviceInfoUpdated: event NetworkDevice.DeviceInfoUpdated is {
        send deviceInfoUpdated to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell deviceInfoUpdated to entity MonitoringContext.NetworkDevice
      }
      on thresholdsConfigured: event NetworkDevice.ThresholdsConfigured is {
        send thresholdsConfigured to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell thresholdsConfigured to entity MonitoringContext.NetworkDevice
      }
      on metricsRecorded: event NetworkDevice.MetricsRecorded is {
        send metricsRecorded to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell metricsRecorded to entity MonitoringContext.NetworkDevice
      }
      on alertRaised: event NetworkDevice.AlertRaised is {
        send alertRaised to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell alertRaised to entity MonitoringContext.NetworkDevice
      }
      on alertAcknowledged: event NetworkDevice.AlertAcknowledged is {
        send alertAcknowledged to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell alertAcknowledged to entity MonitoringContext.NetworkDevice
      }
      on alertResolved: event NetworkDevice.AlertResolved is {
        send alertResolved to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell alertResolved to entity MonitoringContext.NetworkDevice
      }
      on maintenanceScheduled: event NetworkDevice.MaintenanceScheduled is {
        send maintenanceScheduled to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell maintenanceScheduled to entity MonitoringContext.NetworkDevice
      }
      on maintenanceEnded: event NetworkDevice.MaintenanceEnded is {
        send maintenanceEnded to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell maintenanceEnded to entity MonitoringContext.NetworkDevice
      }
      on deviceMarkedOffline: event NetworkDevice.DeviceMarkedOffline is {
        send deviceMarkedOffline to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell deviceMarkedOffline to entity MonitoringContext.NetworkDevice
      }
      on deviceDecommissioned: event NetworkDevice.DeviceDecommissioned is {
        send deviceDecommissioned to outlet NetworkDeviceEventSplitToNetworkAnalytics
        tell deviceDecommissioned to entity MonitoringContext.NetworkDevice
      }
      on other is {
        error "Unexpected message for processor NetworkDeviceEventSplit"
      }
    } with {
      briefly "NetworkDevice event fan-out handler"
      described as {
        |Delivers each NetworkDevice event to all of its consumers.
      }
    }
  } with {
    briefly "NetworkDevice event fan-out"
    described as {
      |Fans NetworkDevice events out to the repository and projectors.
    }
  }
  connector 'NetworkDeviceEvent Stream' is from outlet MonitoringContext.NetworkDevice.NetworkDeviceEvents2 to inlet MonitoringContext.NetworkDeviceEventSplit.NetworkDeviceEventSplitIn with {
    briefly "NetworkDevice events, fanned out to storage and read models"
  }
  connector 'NetworkAnalytics Feed' is from outlet MonitoringContext.NetworkDeviceEventSplit.NetworkDeviceEventSplitToNetworkAnalytics to inlet MonitoringContext.NetworkAnalytics.NetworkAnalyticsFromNetworkDevice with {
    briefly "NetworkDevice events feeding the NetworkAnalytics projection"
  }
  connector 'NetworkAnalytics Storage' is from outlet MonitoringContext.NetworkAnalytics.NetworkAnalyticsToRepository to inlet MonitoringContext.DeviceRepository.DeviceRepositoryFromNetworkAnalytics with {
    briefly "NetworkAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for network monitoring"
  described as {
    |Network operations context.
  }
}
