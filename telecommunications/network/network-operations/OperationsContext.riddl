// Network Operations - Operations Context
context OperationsContext as router is {
  inlet NetworkIncidentCommandStreamIn is type NetworkIncidentCommand  outlet NetworkIncidentCommandStreamOut is type NetworkIncidentCommand
  inlet NetworkIncidentResultStreamIn is result NetworkIncident.NetworkIncidentResult  outlet NetworkIncidentResultStreamOut is result NetworkIncident.NetworkIncidentResult
  handler OperationsContextBoundary is {
    on createIncident: command NetworkIncident.CreateIncident is {
      send createIncident to outlet OperationsContext.NetworkIncidentCommandStreamOut
    }
    on acknowledgeIncident: command NetworkIncident.AcknowledgeIncident is {
      send acknowledgeIncident to outlet OperationsContext.NetworkIncidentCommandStreamOut
    }
    on startInvestigation: command NetworkIncident.StartInvestigation is {
      send startInvestigation to outlet OperationsContext.NetworkIncidentCommandStreamOut
    }
    on escalateIncident: command NetworkIncident.EscalateIncident is {
      send escalateIncident to outlet OperationsContext.NetworkIncidentCommandStreamOut
    }
    on beginMitigation: command NetworkIncident.BeginMitigation is {
      send beginMitigation to outlet OperationsContext.NetworkIncidentCommandStreamOut
    }
    on resolveIncident: command NetworkIncident.ResolveIncident is {
      send resolveIncident to outlet OperationsContext.NetworkIncidentCommandStreamOut
    }
    on closeIncident: command NetworkIncident.CloseIncident is {
      send closeIncident to outlet OperationsContext.NetworkIncidentCommandStreamOut
    }
    on addTimelineEntry: command NetworkIncident.AddTimelineEntry is {
      send addTimelineEntry to outlet OperationsContext.NetworkIncidentCommandStreamOut
    }
    on networkIncidentResult: result NetworkIncident.NetworkIncidentResult is {
      send networkIncidentResult to outlet OperationsContext.NetworkIncidentResultStreamOut
    }
    on other is {
      error "Unexpected message at the OperationsContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'NetworkIncidentCommand Stream Intake' is from outlet OperationsContext.NetworkIncidentCommandStreamOut to inlet OperationsContext.NetworkIncident.NetworkIncidentCommands  connector 'NetworkIncidentResult Stream Egress' is from outlet OperationsContext.OperationsRepository.OperationsRepositoryResponses to inlet OperationsContext.NetworkIncidentResultStreamIn  adaptor FromCapacityPlanningSystem from context CapacityPlanningSystem is { 
    handler FromCapacityPlanningSystemHandler is {
      on result CapacityPlanningSystem.CapacityForecast is {
        do "the model receives capacity forecast"
      }
      on event CapacityPlanningSystem.CapacityThresholdBreached is {
        do "the model receives capacity threshold breached"
      }
      on other is {
        error "Unexpected message for adaptor FromCapacityPlanningSystem"
      }
    } with {
      briefly "from capacity planning system"
      described as {
        |Carries messages from the external CapacityPlanningSystem.
      }
    }
  } with {
    briefly "CapacityPlanningSystem integration"
    described as {
      |The model's side of the CapacityPlanningSystem conversation.
    }
  }
  adaptor ToCapacityPlanningSystem to context CapacityPlanningSystem is { 
    handler ToCapacityPlanningSystemHandler is {
      on query CapacityPlanningSystem.GetCapacityForecast is {
        do "the model sends get capacity forecast"
      }
      on other is {
        error "Unexpected message for adaptor ToCapacityPlanningSystem"
      }
    } with {
      briefly "to capacity planning system"
      described as {
        |Carries messages to the external CapacityPlanningSystem.
      }
    }
  } with {
    briefly "CapacityPlanningSystem integration"
    described as {
      |The model's side of the CapacityPlanningSystem conversation.
    }
  }
  adaptor FromChangeManagementSystem from context ChangeManagementSystem is { 
    handler FromChangeManagementSystemHandler is {
      on event ChangeManagementSystem.ChangeApproved is {
        do "the model receives change approved"
      }
      on event ChangeManagementSystem.ChangeCompleted is {
        do "the model receives change completed"
      }
      on other is {
        error "Unexpected message for adaptor FromChangeManagementSystem"
      }
    } with {
      briefly "from change management system"
      described as {
        |Carries messages from the external ChangeManagementSystem.
      }
    }
  } with {
    briefly "ChangeManagementSystem integration"
    described as {
      |The model's side of the ChangeManagementSystem conversation.
    }
  }
  adaptor ToChangeManagementSystem to context ChangeManagementSystem is { 
    handler ToChangeManagementSystemHandler is {
      on command ChangeManagementSystem.SubmitChangeRequest is {
        do "the model sends submit change request"
      }
      on other is {
        error "Unexpected message for adaptor ToChangeManagementSystem"
      }
    } with {
      briefly "to change management system"
      described as {
        |Carries messages to the external ChangeManagementSystem.
      }
    }
  } with {
    briefly "ChangeManagementSystem integration"
    described as {
      |The model's side of the ChangeManagementSystem conversation.
    }
  }
  adaptor FromNetworkMonitoringSystem from context NetworkMonitoringSystem is { 
    handler FromNetworkMonitoringSystemHandler is {
      on event NetworkMonitoringSystem.AlarmCleared is {
        do "the model receives alarm cleared"
      }
      on event NetworkMonitoringSystem.AlarmRaised is {
        do "the model receives alarm raised"
      }
      on result NetworkMonitoringSystem.ElementHealthStatus is {
        do "the model receives element health status"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkMonitoringSystem"
      }
    } with {
      briefly "from network monitoring system"
      described as {
        |Carries messages from the external NetworkMonitoringSystem.
      }
    }
  } with {
    briefly "NetworkMonitoringSystem integration"
    described as {
      |The model's side of the NetworkMonitoringSystem conversation.
    }
  }
  adaptor ToNetworkMonitoringSystem to context NetworkMonitoringSystem is { 
    handler ToNetworkMonitoringSystemHandler is {
      on query NetworkMonitoringSystem.GetElementHealth is {
        do "the model sends get element health"
      }
      on other is {
        error "Unexpected message for adaptor ToNetworkMonitoringSystem"
      }
    } with {
      briefly "to network monitoring system"
      described as {
        |Carries messages to the external NetworkMonitoringSystem.
      }
    }
  } with {
    briefly "NetworkMonitoringSystem integration"
    described as {
      |The model's side of the NetworkMonitoringSystem conversation.
    }
  }
  include "types.riddl"
  include "NetworkIncident.riddl"
  type OperationsRepositoryCommand is one of {
    OperationsContext.OperationsRepository.PersistIncidentAcknowledged or OperationsContext.OperationsRepository.PersistIncidentClosed or OperationsContext.OperationsRepository.PersistIncidentCreated or OperationsContext.OperationsRepository.PersistIncidentEscalated or OperationsContext.OperationsRepository.PersistIncidentResolved or OperationsContext.OperationsRepository.PersistInvestigationStarted or OperationsContext.OperationsRepository.PersistMitigationStarted or OperationsContext.OperationsRepository.PersistTimelineEntryAdded
  } with {
    briefly "Anything that writes OperationsRepository"
    described as {
      |The persistence commands OperationsRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository OperationsRepository as flow is {
    inlet OperationsRepositoryFromOperationsMetrics is type OperationsRepositoryCommand    command PersistInvestigationStarted is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row InvestigationStarted applies to.
        }
      }
    } with {
      briefly "Persist InvestigationStarted"
      described as {
        |Instructs this repository to apply InvestigationStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMitigationStarted is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row MitigationStarted applies to.
        }
      }
    } with {
      briefly "Persist MitigationStarted"
      described as {
        |Instructs this repository to apply MitigationStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTimelineEntryAdded is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row TimelineEntryAdded applies to.
        }
      }
    } with {
      briefly "Persist TimelineEntryAdded"
      described as {
        |Instructs this repository to apply TimelineEntryAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentAcknowledged is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncidentAcknowledged applies to.
        }
      }
    } with {
      briefly "Persist IncidentAcknowledged"
      described as {
        |Instructs this repository to apply IncidentAcknowledged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentClosed is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncidentClosed applies to.
        }
      }
    } with {
      briefly "Persist IncidentClosed"
      described as {
        |Instructs this repository to apply IncidentClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentCreated is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncidentCreated applies to.
        }
      }
    } with {
      briefly "Persist IncidentCreated"
      described as {
        |Instructs this repository to apply IncidentCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentEscalated is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncidentEscalated applies to.
        }
      }
    } with {
      briefly "Persist IncidentEscalated"
      described as {
        |Instructs this repository to apply IncidentEscalated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentResolved is  {
      incidentId: IncidentId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncidentResolved applies to.
        }
      }
    } with {
      briefly "Persist IncidentResolved"
      described as {
        |Instructs this repository to apply IncidentResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet OperationsRepositoryResponses is result NetworkIncident.NetworkIncidentResult
    record StoredNetworkIncident is  {
      networkIncidentId: UUID with {
        briefly "networkIncidentId"
        described as {
          |The networkIncidentId column of the stored networkIncident row.
        }
      }
      incidentId: IncidentId with {
        briefly "incidentId"
        described as {
          |The incidentId column of the stored networkIncident row.
        }
      }
      incidentInfo: IncidentInfo with {
        briefly "incidentInfo"
        described as {
          |The incidentInfo column of the stored networkIncident row.
        }
      }
      status: IncidentStatus with {
        briefly "status"
        described as {
          |The status column of the stored networkIncident row.
        }
      }
    } with {
      briefly "Stored networkIncident row"
      described as {
        |The persistence shape of networkIncident data as this repository stores it.
      }
    }
    schema OperationsData is relational
      of incidents as record StoredNetworkIncident
        index on field StoredNetworkIncident.incidentId
        index on field StoredNetworkIncident.status
        index on field StoredNetworkIncident.incidentInfo.severity
 with {
      briefly "Operations data schema"
      described as {
        |The relational schema holding operations data for the OperationsRepository.
      }
    }
    handler OperationsPersistence is {
      on persistInvestigationStarted: command PersistInvestigationStarted is {
        do "apply InvestigationStarted to the stored row"
      }
      on persistMitigationStarted: command PersistMitigationStarted is {
        do "apply MitigationStarted to the stored row"
      }
      on persistTimelineEntryAdded: command PersistTimelineEntryAdded is {
        do "apply TimelineEntryAdded to the stored row"
      }
      on persistIncidentAcknowledged: command PersistIncidentAcknowledged is {
        do "apply IncidentAcknowledged to the stored row"
      }
      on persistIncidentClosed: command PersistIncidentClosed is {
        do "apply IncidentClosed to the stored row"
      }
      on persistIncidentCreated: command PersistIncidentCreated is {
        do "apply IncidentCreated to the stored row"
      }
      on persistIncidentEscalated: command PersistIncidentEscalated is {
        do "apply IncidentEscalated to the stored row"
      }
      on persistIncidentResolved: command PersistIncidentResolved is {
        do "apply IncidentResolved to the stored row"
      }
      on query GetIncidentMetrics is {
        let incidentMetricsView: type IncidentMetricsView = prompt("read the incident metrics projection")
        reply incidentMetricsView
      }
    } with {
      briefly "Persists operations commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Operations data persistence"
    described as {
      |Persistent storage for network operations.
    }
  }
  query GetIncidentMetrics replies result IncidentMetricsView is  {
    incidentMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which incident metrics to retrieve.
      }
    }
  } with {
    briefly "Get incident metrics"
    described as {
      |Retrieves the incident metrics projection.
    }
  }
  result IncidentMetricsView is  {
    incidentMetrics: OperationsMetrics.IncidentMetrics with {
      briefly "Incident metrics"
      described as {
        |The incident metrics being returned.
      }
    }
  } with {
    briefly "Incident metrics view"
    described as {
      |Read model view carrying the incident metrics projection.
    }
  }
  projector OperationsMetrics as flow is {
    updates repository OperationsContext.OperationsRepository
    outlet OperationsMetricsToRepository is type OperationsRepositoryCommand
    inlet OperationsMetricsFromNetworkIncident is type NetworkIncidentEvent    record IncidentMetrics is  {
      totalIncidents: Natural with {
        briefly "Total"
        described as {
          |Total incidents.
        }
      }
      activeIncidents: Natural with {
        briefly "Active"
        described as {
          |Active incidents.
        }
      }
      criticalIncidents: Natural with {
        briefly "Critical"
        described as {
          |Critical incidents.
        }
      }
      meanTimeToAcknowledge: Decimal(8,2) with {
        briefly "MTTA"
        described as {
          |Mean time to acknowledge in minutes.
        }
      }
      meanTimeToResolve: Decimal(8,2) with {
        briefly "MTTR"
        described as {
          |Mean time to resolve in minutes.
        }
      }
      escalationRate: Decimal(5,2) with {
        briefly "Escalation rate"
        described as {
          |Percentage of incidents escalated.
        }
      }
    } with {
      briefly "Incident metrics"
      described as {
        |NOC incident analytics.
      }
    }
    handler MetricsHandler is {
      on investigationStarted: event NetworkIncident.InvestigationStarted is {
        tell command OperationsContext.OperationsRepository.PersistInvestigationStarted(incidentId = investigationStarted.incidentId) to repository OperationsContext.OperationsRepository
        do "apply InvestigationStarted to the OperationsMetrics projection"
      }
      on mitigationStarted: event NetworkIncident.MitigationStarted is {
        tell command OperationsContext.OperationsRepository.PersistMitigationStarted(incidentId = mitigationStarted.incidentId) to repository OperationsContext.OperationsRepository
        do "apply MitigationStarted to the OperationsMetrics projection"
      }
      on timelineEntryAdded: event NetworkIncident.TimelineEntryAdded is {
        tell command OperationsContext.OperationsRepository.PersistTimelineEntryAdded(incidentId = timelineEntryAdded.incidentId) to repository OperationsContext.OperationsRepository
        do "apply TimelineEntryAdded to the OperationsMetrics projection"
      }
      on incidentCreated: event NetworkIncident.IncidentCreated is {
        tell command OperationsContext.OperationsRepository.PersistIncidentCreated(incidentId = incidentCreated.incidentId) to repository OperationsContext.OperationsRepository
        do "Increment total and active incidents"
      }
      on incidentAcknowledged: event NetworkIncident.IncidentAcknowledged is {
        tell command OperationsContext.OperationsRepository.PersistIncidentAcknowledged(incidentId = incidentAcknowledged.incidentId) to repository OperationsContext.OperationsRepository
        do "Calculate acknowledge time and update MTTA"
      }
      on incidentEscalated: event NetworkIncident.IncidentEscalated is {
        tell command OperationsContext.OperationsRepository.PersistIncidentEscalated(incidentId = incidentEscalated.incidentId) to repository OperationsContext.OperationsRepository
        do "Increment escalation count and update rate"
      }
      on incidentResolved: event NetworkIncident.IncidentResolved is {
        tell command OperationsContext.OperationsRepository.PersistIncidentResolved(incidentId = incidentResolved.incidentId) to repository OperationsContext.OperationsRepository
        do "Calculate resolve time and update MTTR"
      }
      on incidentClosed: event NetworkIncident.IncidentClosed is {
        tell command OperationsContext.OperationsRepository.PersistIncidentClosed(incidentId = incidentClosed.incidentId) to repository OperationsContext.OperationsRepository
        do "Decrement active incidents"
      }
    } with {
      briefly "Maintains operations metrics"
      described as {
        |Projects events into NOC metrics.
      }
    }
  } with {
    briefly "Operations metrics"
    described as {
      |Network operations analytics.
    }
  }
  // ---- Event publication for NetworkIncident ----
  type NetworkIncidentEvent is one of {
    OperationsContext.NetworkIncident.IncidentCreated or OperationsContext.NetworkIncident.IncidentAcknowledged or OperationsContext.NetworkIncident.InvestigationStarted or OperationsContext.NetworkIncident.IncidentEscalated or OperationsContext.NetworkIncident.MitigationStarted or OperationsContext.NetworkIncident.IncidentResolved or OperationsContext.NetworkIncident.IncidentClosed or OperationsContext.NetworkIncident.TimelineEntryAdded
  } with {
    briefly "NetworkIncident event alternation"
    described as {
      |Union of all NetworkIncident events, for streaming and event-sourced
      |persistence.
    }
  }
  processor NetworkIncidentEventSplit as flow is {
    inlet NetworkIncidentEventSplitIn is type NetworkIncidentEvent    outlet NetworkIncidentEventSplitToOperationsMetrics is type NetworkIncidentEvent
    handler NetworkIncidentEventSplitHandler is {
      on incidentCreated: event NetworkIncident.IncidentCreated is {
        send incidentCreated to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell incidentCreated to entity OperationsContext.NetworkIncident
      }
      on incidentAcknowledged: event NetworkIncident.IncidentAcknowledged is {
        send incidentAcknowledged to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell incidentAcknowledged to entity OperationsContext.NetworkIncident
      }
      on investigationStarted: event NetworkIncident.InvestigationStarted is {
        send investigationStarted to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell investigationStarted to entity OperationsContext.NetworkIncident
      }
      on incidentEscalated: event NetworkIncident.IncidentEscalated is {
        send incidentEscalated to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell incidentEscalated to entity OperationsContext.NetworkIncident
      }
      on mitigationStarted: event NetworkIncident.MitigationStarted is {
        send mitigationStarted to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell mitigationStarted to entity OperationsContext.NetworkIncident
      }
      on incidentResolved: event NetworkIncident.IncidentResolved is {
        send incidentResolved to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell incidentResolved to entity OperationsContext.NetworkIncident
      }
      on incidentClosed: event NetworkIncident.IncidentClosed is {
        send incidentClosed to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell incidentClosed to entity OperationsContext.NetworkIncident
      }
      on timelineEntryAdded: event NetworkIncident.TimelineEntryAdded is {
        send timelineEntryAdded to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell timelineEntryAdded to entity OperationsContext.NetworkIncident
      }
      on other is {
        error "Unexpected message for processor NetworkIncidentEventSplit"
      }
    } with {
      briefly "NetworkIncident event fan-out handler"
      described as {
        |Delivers each NetworkIncident event to all of its consumers.
      }
    }
  } with {
    briefly "NetworkIncident event fan-out"
    described as {
      |Fans NetworkIncident events out to the repository and projectors.
    }
  }
  connector 'NetworkIncidentEvent Stream' is from outlet OperationsContext.NetworkIncident.NetworkIncidentEvents2 to inlet OperationsContext.NetworkIncidentEventSplit.NetworkIncidentEventSplitIn with {
    briefly "NetworkIncident events, fanned out to storage and read models"
  }
  connector 'OperationsMetrics Feed' is from outlet OperationsContext.NetworkIncidentEventSplit.NetworkIncidentEventSplitToOperationsMetrics to inlet OperationsContext.OperationsMetrics.OperationsMetricsFromNetworkIncident with {
    briefly "NetworkIncident events feeding the OperationsMetrics projection"
  }
  connector 'OperationsMetrics Storage' is from outlet OperationsContext.OperationsMetrics.OperationsMetricsToRepository to inlet OperationsContext.OperationsRepository.OperationsRepositoryFromOperationsMetrics with {
    briefly "OperationsMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for network operations"
  described as {
    |Network operations center management context.
  }
}
