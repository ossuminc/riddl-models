// Network Operations - Operations Context
context OperationsContext is {
  adaptor FromCapacityPlanningSystem from context CapacityPlanningSystem is { 
    handler FromCapacityPlanningSystemHandler is {
      on result CapacityPlanningSystem.CapacityForecast is {
        do "the model receives capacity forecast"
      }
      on event CapacityPlanningSystem.CapacityThresholdBreached is {
        do "the model receives capacity threshold breached"
      }
      on other is {
        error "Unexpected message for adaptor FromCapacityPlanningSystem"
      }
    } with {
      briefly "from capacity planning system"
      described as {
        |Carries messages from the external CapacityPlanningSystem.
      }
    }
  } with {
    briefly "CapacityPlanningSystem integration"
    described as {
      |The model's side of the CapacityPlanningSystem conversation.
    }
  }
  adaptor ToCapacityPlanningSystem to context CapacityPlanningSystem is { 
    handler ToCapacityPlanningSystemHandler is {
      on query CapacityPlanningSystem.GetCapacityForecast is {
        do "the model sends get capacity forecast"
      }
      on other is {
        error "Unexpected message for adaptor ToCapacityPlanningSystem"
      }
    } with {
      briefly "to capacity planning system"
      described as {
        |Carries messages to the external CapacityPlanningSystem.
      }
    }
  } with {
    briefly "CapacityPlanningSystem integration"
    described as {
      |The model's side of the CapacityPlanningSystem conversation.
    }
  }
  adaptor FromChangeManagementSystem from context ChangeManagementSystem is { 
    handler FromChangeManagementSystemHandler is {
      on event ChangeManagementSystem.ChangeApproved is {
        do "the model receives change approved"
      }
      on event ChangeManagementSystem.ChangeCompleted is {
        do "the model receives change completed"
      }
      on other is {
        error "Unexpected message for adaptor FromChangeManagementSystem"
      }
    } with {
      briefly "from change management system"
      described as {
        |Carries messages from the external ChangeManagementSystem.
      }
    }
  } with {
    briefly "ChangeManagementSystem integration"
    described as {
      |The model's side of the ChangeManagementSystem conversation.
    }
  }
  adaptor ToChangeManagementSystem to context ChangeManagementSystem is { 
    handler ToChangeManagementSystemHandler is {
      on command ChangeManagementSystem.SubmitChangeRequest is {
        do "the model sends submit change request"
      }
      on other is {
        error "Unexpected message for adaptor ToChangeManagementSystem"
      }
    } with {
      briefly "to change management system"
      described as {
        |Carries messages to the external ChangeManagementSystem.
      }
    }
  } with {
    briefly "ChangeManagementSystem integration"
    described as {
      |The model's side of the ChangeManagementSystem conversation.
    }
  }
  adaptor FromNetworkMonitoringSystem from context NetworkMonitoringSystem is { 
    handler FromNetworkMonitoringSystemHandler is {
      on event NetworkMonitoringSystem.AlarmCleared is {
        do "the model receives alarm cleared"
      }
      on event NetworkMonitoringSystem.AlarmRaised is {
        do "the model receives alarm raised"
      }
      on result NetworkMonitoringSystem.ElementHealthStatus is {
        do "the model receives element health status"
      }
      on other is {
        error "Unexpected message for adaptor FromNetworkMonitoringSystem"
      }
    } with {
      briefly "from network monitoring system"
      described as {
        |Carries messages from the external NetworkMonitoringSystem.
      }
    }
  } with {
    briefly "NetworkMonitoringSystem integration"
    described as {
      |The model's side of the NetworkMonitoringSystem conversation.
    }
  }
  adaptor ToNetworkMonitoringSystem to context NetworkMonitoringSystem is { 
    handler ToNetworkMonitoringSystemHandler is {
      on query NetworkMonitoringSystem.GetElementHealth is {
        do "the model sends get element health"
      }
      on other is {
        error "Unexpected message for adaptor ToNetworkMonitoringSystem"
      }
    } with {
      briefly "to network monitoring system"
      described as {
        |Carries messages to the external NetworkMonitoringSystem.
      }
    }
  } with {
    briefly "NetworkMonitoringSystem integration"
    described as {
      |The model's side of the NetworkMonitoringSystem conversation.
    }
  }
  include "types.riddl"
  include "NetworkIncident.riddl"
  repository OperationsRepository is {
    inlet OperationsRepositoryFromNetworkIncident is type NetworkIncidentEvent    inlet OperationsRepositoryFromOperationsMetrics is type NetworkIncidentEvent    outlet OperationsRepositoryResponses is type NetworkIncident.NetworkIncidentResult
    record StoredNetworkIncident is  {
      networkIncidentId: UUID with {
        briefly "networkIncidentId"
        described as {
          |The networkIncidentId column of the stored networkIncident row.
        }
      }
      incidentId: IncidentId with {
        briefly "incidentId"
        described as {
          |The incidentId column of the stored networkIncident row.
        }
      }
      incidentInfo: IncidentInfo with {
        briefly "incidentInfo"
        described as {
          |The incidentInfo column of the stored networkIncident row.
        }
      }
      status: IncidentStatus with {
        briefly "status"
        described as {
          |The status column of the stored networkIncident row.
        }
      }
    } with {
      briefly "Stored networkIncident row"
      described as {
        |The persistence shape of networkIncident data as this repository stores it.
      }
    }
    schema OperationsData is relational
      of incidents as type StoredNetworkIncident
        index on field StoredNetworkIncident.incidentId
        index on field StoredNetworkIncident.status
        index on field StoredNetworkIncident.incidentInfo.severity
 with {
      briefly "Operations data schema"
      described as {
        |The relational schema holding operations data for the OperationsRepository.
      }
    }
    handler OperationsPersistence is {
      on query GetIncidentMetrics is {
        do "read the incident metrics projection"
        yield result IncidentMetricsView
      }
      on command NetworkIncident.CreateIncident is {
        tell event NetworkIncident.IncidentCreated to entity OperationsContext.NetworkIncident
        do "Store new network incident"
      }
      on command NetworkIncident.AcknowledgeIncident is {
        tell event NetworkIncident.IncidentAcknowledged to entity OperationsContext.NetworkIncident
        do "Update incident to acknowledged"
      }
      on command NetworkIncident.StartInvestigation is {
        tell event NetworkIncident.InvestigationStarted to entity OperationsContext.NetworkIncident
        do "Update incident with investigator"
      }
      on command NetworkIncident.EscalateIncident is {
        do "Record escalation details"
      }
      on command NetworkIncident.ResolveIncident is {
        do "Update incident with resolution"
      }
      on command NetworkIncident.CloseIncident is {
        tell event NetworkIncident.IncidentClosed to entity OperationsContext.NetworkIncident
        do "Update incident to closed"
      }
    } with {
      briefly "Persists operations commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Operations data persistence"
    described as {
      |Persistent storage for network operations.
    }
  }
  query GetIncidentMetrics is  {
    incidentMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which incident metrics to retrieve.
      }
    }
  } with {
    briefly "Get incident metrics"
    described as {
      |Retrieves the incident metrics projection.
    }
  }
  result IncidentMetricsView is  {
    incidentMetrics: OperationsMetrics.IncidentMetrics with {
      briefly "Incident metrics"
      described as {
        |The incident metrics being returned.
      }
    }
  } with {
    briefly "Incident metrics view"
    described as {
      |Read model view carrying the incident metrics projection.
    }
  }
  projector OperationsMetrics is {
    updates repository OperationsContext.OperationsRepository
    inlet OperationsMetricsFromNetworkIncident is type NetworkIncidentEvent    outlet OperationsMetricsOut is type NetworkIncidentEvent
    record IncidentMetrics is  {
      totalIncidents: Natural with {
        briefly "Total"
        described as {
          |Total incidents.
        }
      }
      activeIncidents: Natural with {
        briefly "Active"
        described as {
          |Active incidents.
        }
      }
      criticalIncidents: Natural with {
        briefly "Critical"
        described as {
          |Critical incidents.
        }
      }
      meanTimeToAcknowledge: Decimal(8,2) with {
        briefly "MTTA"
        described as {
          |Mean time to acknowledge in minutes.
        }
      }
      meanTimeToResolve: Decimal(8,2) with {
        briefly "MTTR"
        described as {
          |Mean time to resolve in minutes.
        }
      }
      escalationRate: Decimal(5,2) with {
        briefly "Escalation rate"
        described as {
          |Percentage of incidents escalated.
        }
      }
    } with {
      briefly "Incident metrics"
      described as {
        |NOC incident analytics.
      }
    }
    handler MetricsHandler is {
      on event NetworkIncident.IncidentCreated is {
        tell event NetworkIncident.IncidentCreated to repository OperationsContext.OperationsRepository
        do "Increment total and active incidents"
      }
      on event NetworkIncident.IncidentAcknowledged is {
        tell event NetworkIncident.IncidentAcknowledged to repository OperationsContext.OperationsRepository
        do "Calculate acknowledge time and update MTTA"
      }
      on event NetworkIncident.IncidentEscalated is {
        tell event NetworkIncident.IncidentEscalated to repository OperationsContext.OperationsRepository
        do "Increment escalation count and update rate"
      }
      on event NetworkIncident.IncidentResolved is {
        tell event NetworkIncident.IncidentResolved to repository OperationsContext.OperationsRepository
        do "Calculate resolve time and update MTTR"
      }
      on event NetworkIncident.IncidentClosed is {
        tell event NetworkIncident.IncidentClosed to repository OperationsContext.OperationsRepository
        do "Decrement active incidents"
      }
    } with {
      briefly "Maintains operations metrics"
      described as {
        |Projects events into NOC metrics.
      }
    }
  } with {
    briefly "Operations metrics"
    described as {
      |Network operations analytics.
    }
  }
  // ---- Event publication for NetworkIncident ----
  type NetworkIncidentEvent is one of {
    OperationsContext.NetworkIncident.IncidentCreated or OperationsContext.NetworkIncident.IncidentAcknowledged or OperationsContext.NetworkIncident.InvestigationStarted or OperationsContext.NetworkIncident.IncidentEscalated or OperationsContext.NetworkIncident.MitigationStarted or OperationsContext.NetworkIncident.IncidentResolved or OperationsContext.NetworkIncident.IncidentClosed or OperationsContext.NetworkIncident.TimelineEntryAdded
  } with {
    briefly "NetworkIncident event alternation"
    described as {
      |Union of all NetworkIncident events, for streaming and event-sourced
      |persistence.
    }
  }
  processor NetworkIncidentEventSource as source is {
    outlet NetworkIncidentEvents is type NetworkIncidentEvent
    handler NetworkIncidentSourceHandler is {
      on event NetworkIncident.IncidentCreated is {
        send event NetworkIncident.IncidentCreated to outlet NetworkIncidentEvents
      }
      on event NetworkIncident.IncidentAcknowledged is {
        send event NetworkIncident.IncidentAcknowledged to outlet NetworkIncidentEvents
      }
      on event NetworkIncident.InvestigationStarted is {
        send event NetworkIncident.InvestigationStarted to outlet NetworkIncidentEvents
      }
      on event NetworkIncident.IncidentEscalated is {
        send event NetworkIncident.IncidentEscalated to outlet NetworkIncidentEvents
      }
      on event NetworkIncident.MitigationStarted is {
        send event NetworkIncident.MitigationStarted to outlet NetworkIncidentEvents
      }
      on event NetworkIncident.IncidentResolved is {
        send event NetworkIncident.IncidentResolved to outlet NetworkIncidentEvents
      }
      on event NetworkIncident.IncidentClosed is {
        send event NetworkIncident.IncidentClosed to outlet NetworkIncidentEvents
      }
      on event NetworkIncident.TimelineEntryAdded is {
        send event NetworkIncident.TimelineEntryAdded to outlet NetworkIncidentEvents
      }
      on other is {
        error "Unexpected message for source NetworkIncidentEventSource"
      }
    } with {
      briefly "NetworkIncident source handler"
      described as {
        |Publishes NetworkIncident events onto the outlet.
      }
    }
  } with {
    briefly "NetworkIncident event source"
    described as {
      |Publishes NetworkIncident entity events into the streaming topology.
    }
  }
  processor NetworkIncidentEventSink as sink is {
    inlet NetworkIncidentInlet is type NetworkIncidentEvent    handler NetworkIncidentSinkHandler is {
      on event NetworkIncident.IncidentCreated is {
        tell event NetworkIncident.IncidentCreated to repository OperationsContext.OperationsRepository
      }
      on event NetworkIncident.IncidentAcknowledged is {
        tell event NetworkIncident.IncidentAcknowledged to repository OperationsContext.OperationsRepository
      }
      on event NetworkIncident.InvestigationStarted is {
        tell event NetworkIncident.InvestigationStarted to repository OperationsContext.OperationsRepository
      }
      on event NetworkIncident.IncidentEscalated is {
        tell event NetworkIncident.IncidentEscalated to repository OperationsContext.OperationsRepository
      }
      on event NetworkIncident.MitigationStarted is {
        tell event NetworkIncident.MitigationStarted to repository OperationsContext.OperationsRepository
      }
      on event NetworkIncident.IncidentResolved is {
        tell event NetworkIncident.IncidentResolved to repository OperationsContext.OperationsRepository
      }
      on event NetworkIncident.IncidentClosed is {
        tell event NetworkIncident.IncidentClosed to repository OperationsContext.OperationsRepository
      }
      on event NetworkIncident.TimelineEntryAdded is {
        tell event NetworkIncident.TimelineEntryAdded to repository OperationsContext.OperationsRepository
      }
      on other is {
        error "Unexpected message for sink NetworkIncidentEventSink"
      }
    } with {
      briefly "NetworkIncident sink handler"
      described as {
        |Persists NetworkIncident events via the repository.
      }
    }
  } with {
    briefly "NetworkIncident event sink"
    described as {
      |Receives NetworkIncident events for persistence.
    }
  }
  connector NetworkIncidentEventFlow is from outlet OperationsContext.NetworkIncidentEventSource.NetworkIncidentEvents to inlet OperationsContext.NetworkIncidentEventSink.NetworkIncidentInlet with {
    briefly "NetworkIncident event flow"
    described as {
      |Connects the NetworkIncident source to its sink.
    }
  }
  processor NetworkIncidentEventSplit is {
    inlet NetworkIncidentEventSplitIn is type NetworkIncidentEvent    outlet NetworkIncidentEventSplitToOperationsRepository is type NetworkIncidentEvent
    outlet NetworkIncidentEventSplitToOperationsMetrics is type NetworkIncidentEvent
    handler NetworkIncidentEventSplitHandler is {
      on event NetworkIncident.IncidentCreated is {
        send event NetworkIncident.IncidentCreated to outlet NetworkIncidentEventSplitToOperationsRepository
        send event NetworkIncident.IncidentCreated to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell event NetworkIncident.IncidentCreated to entity OperationsContext.NetworkIncident
      }
      on event NetworkIncident.IncidentAcknowledged is {
        send event NetworkIncident.IncidentAcknowledged to outlet NetworkIncidentEventSplitToOperationsRepository
        send event NetworkIncident.IncidentAcknowledged to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell event NetworkIncident.IncidentAcknowledged to entity OperationsContext.NetworkIncident
      }
      on event NetworkIncident.InvestigationStarted is {
        send event NetworkIncident.InvestigationStarted to outlet NetworkIncidentEventSplitToOperationsRepository
        send event NetworkIncident.InvestigationStarted to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell event NetworkIncident.InvestigationStarted to entity OperationsContext.NetworkIncident
      }
      on event NetworkIncident.IncidentEscalated is {
        send event NetworkIncident.IncidentEscalated to outlet NetworkIncidentEventSplitToOperationsRepository
        send event NetworkIncident.IncidentEscalated to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell event NetworkIncident.IncidentEscalated to entity OperationsContext.NetworkIncident
      }
      on event NetworkIncident.MitigationStarted is {
        send event NetworkIncident.MitigationStarted to outlet NetworkIncidentEventSplitToOperationsRepository
        send event NetworkIncident.MitigationStarted to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell event NetworkIncident.MitigationStarted to entity OperationsContext.NetworkIncident
      }
      on event NetworkIncident.IncidentResolved is {
        send event NetworkIncident.IncidentResolved to outlet NetworkIncidentEventSplitToOperationsRepository
        send event NetworkIncident.IncidentResolved to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell event NetworkIncident.IncidentResolved to entity OperationsContext.NetworkIncident
      }
      on event NetworkIncident.IncidentClosed is {
        send event NetworkIncident.IncidentClosed to outlet NetworkIncidentEventSplitToOperationsRepository
        send event NetworkIncident.IncidentClosed to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell event NetworkIncident.IncidentClosed to entity OperationsContext.NetworkIncident
      }
      on event NetworkIncident.TimelineEntryAdded is {
        send event NetworkIncident.TimelineEntryAdded to outlet NetworkIncidentEventSplitToOperationsRepository
        send event NetworkIncident.TimelineEntryAdded to outlet NetworkIncidentEventSplitToOperationsMetrics
        tell event NetworkIncident.TimelineEntryAdded to entity OperationsContext.NetworkIncident
      }
      on other is {
        error "Unexpected message for processor NetworkIncidentEventSplit"
      }
    } with {
      briefly "NetworkIncident event fan-out handler"
      described as {
        |Delivers each NetworkIncident event to all of its consumers.
      }
    }
  } with {
    briefly "NetworkIncident event fan-out"
    described as {
      |Fans NetworkIncident events out to the repository and projectors.
    }
  }
  connector LinkNetworkIncidentToNetworkIncidentEventSplit is from outlet OperationsContext.NetworkIncident.NetworkIncidentEvents2 to inlet OperationsContext.NetworkIncidentEventSplit.NetworkIncidentEventSplitIn with {
    briefly "LinkNetworkIncidentToNetworkIncidentEventSplit"
  }
  connector LinkNetworkIncidentEventSplitToOperationsRepository is from outlet OperationsContext.NetworkIncidentEventSplit.NetworkIncidentEventSplitToOperationsRepository to inlet OperationsContext.OperationsRepository.OperationsRepositoryFromNetworkIncident with {
    briefly "LinkNetworkIncidentEventSplitToOperationsRepository"
  }
  connector LinkNetworkIncidentEventSplitToOperationsMetrics is from outlet OperationsContext.NetworkIncidentEventSplit.NetworkIncidentEventSplitToOperationsMetrics to inlet OperationsContext.OperationsMetrics.OperationsMetricsFromNetworkIncident with {
    briefly "LinkNetworkIncidentEventSplitToOperationsMetrics"
  }
  connector LinkOperationsMetricsToOperationsRepository is from outlet OperationsContext.OperationsMetrics.OperationsMetricsOut to inlet OperationsContext.OperationsRepository.OperationsRepositoryFromOperationsMetrics with {
    briefly "LinkOperationsMetricsToOperationsRepository"
  }
} with {
  briefly "Bounded context for network operations"
  described as {
    |Network operations center management context.
  }
}
