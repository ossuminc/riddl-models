// Network Operations - Operations Context
context OperationsContext is {
  include "types.riddl"
  include "NetworkIncident.riddl"
  repository OperationsRepository is {
    schema OperationsData is relational
      of incidents as type NetworkIncident
        index on field NetworkIncident.incidentId
        index on field NetworkIncident.status
        index on field NetworkIncident.incidentInfo.severity

    handler OperationsPersistence is {
      on command NetworkIncident.CreateIncident is {
        tell event NetworkIncident.IncidentCreated to entity OperationsContext.NetworkIncident
        prompt "Store new network incident"
      }
      on command NetworkIncident.AcknowledgeIncident is {
        tell event NetworkIncident.IncidentAcknowledged to entity OperationsContext.NetworkIncident
        prompt "Update incident to acknowledged"
      }
      on command NetworkIncident.StartInvestigation is {
        tell event NetworkIncident.InvestigationStarted to entity OperationsContext.NetworkIncident
        prompt "Update incident with investigator"
      }
      on command NetworkIncident.EscalateIncident is {
        prompt "Record escalation details"
      }
      on command NetworkIncident.ResolveIncident is {
        prompt "Update incident with resolution"
      }
      on command NetworkIncident.CloseIncident is {
        tell event NetworkIncident.IncidentClosed to entity OperationsContext.NetworkIncident
        prompt "Update incident to closed"
      }
    } with {
      briefly "Persists operations commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Operations data persistence"
    described as {
      |Persistent storage for network operations.
    }
  }
  projector OperationsMetrics is {
    updates repository OperationsContext.OperationsRepository
    record IncidentMetrics is  {
      totalIncidents: Natural with {
        briefly "Total"
        described as {
          |Total incidents.
        }
      }
      activeIncidents: Natural with {
        briefly "Active"
        described as {
          |Active incidents.
        }
      }
      criticalIncidents: Natural with {
        briefly "Critical"
        described as {
          |Critical incidents.
        }
      }
      meanTimeToAcknowledge: Decimal(8,2) with {
        briefly "MTTA"
        described as {
          |Mean time to acknowledge in minutes.
        }
      }
      meanTimeToResolve: Decimal(8,2) with {
        briefly "MTTR"
        described as {
          |Mean time to resolve in minutes.
        }
      }
      escalationRate: Decimal(5,2) with {
        briefly "Escalation rate"
        described as {
          |Percentage of incidents escalated.
        }
      }
    } with {
      briefly "Incident metrics"
      described as {
        |NOC incident analytics.
      }
    }
    handler MetricsHandler is {
      on event NetworkIncident.IncidentCreated is {
        tell event NetworkIncident.IncidentCreated to repository OperationsContext.OperationsRepository
        prompt "Increment total and active incidents"
      }
      on event NetworkIncident.IncidentAcknowledged is {
        tell event NetworkIncident.IncidentAcknowledged to repository OperationsContext.OperationsRepository
        prompt "Calculate acknowledge time and update MTTA"
      }
      on event NetworkIncident.IncidentEscalated is {
        tell event NetworkIncident.IncidentEscalated to repository OperationsContext.OperationsRepository
        prompt "Increment escalation count and update rate"
      }
      on event NetworkIncident.IncidentResolved is {
        tell event NetworkIncident.IncidentResolved to repository OperationsContext.OperationsRepository
        prompt "Calculate resolve time and update MTTR"
      }
      on event NetworkIncident.IncidentClosed is {
        tell event NetworkIncident.IncidentClosed to repository OperationsContext.OperationsRepository
        prompt "Decrement active incidents"
      }
    } with {
      briefly "Maintains operations metrics"
      described as {
        |Projects events into NOC metrics.
      }
    }
  } with {
    briefly "Operations metrics"
    described as {
      |Network operations analytics.
    }
  }
  // ---- Event publication for NetworkIncident ----
  type NetworkIncidentEvent is one of {
    OperationsContext.NetworkIncident.IncidentCreated,
    OperationsContext.NetworkIncident.IncidentAcknowledged,
    OperationsContext.NetworkIncident.InvestigationStarted,
    OperationsContext.NetworkIncident.IncidentEscalated,
    OperationsContext.NetworkIncident.MitigationStarted,
    OperationsContext.NetworkIncident.IncidentResolved,
    OperationsContext.NetworkIncident.IncidentClosed,
    OperationsContext.NetworkIncident.TimelineEntryAdded
  } with {
    briefly "NetworkIncident event alternation"
    described as {
      |Union of all NetworkIncident events, for streaming and event-sourced
      |persistence.
    }
  }
  source NetworkIncidentEventSource is {
    outlet NetworkIncidentEvents is type NetworkIncidentEvent
    handler NetworkIncidentSourceHandler is {
      on event NetworkIncident.IncidentCreated is {
        send event NetworkIncident.IncidentCreated to outlet NetworkIncidentEvents
      }
      on event NetworkIncident.IncidentAcknowledged is {
        send event NetworkIncident.IncidentAcknowledged to outlet NetworkIncidentEvents
      }
      on event NetworkIncident.InvestigationStarted is {
        send event NetworkIncident.InvestigationStarted to outlet NetworkIncidentEvents
      }
      on event NetworkIncident.IncidentEscalated is {
        send event NetworkIncident.IncidentEscalated to outlet NetworkIncidentEvents
      }
      on event NetworkIncident.MitigationStarted is {
        send event NetworkIncident.MitigationStarted to outlet NetworkIncidentEvents
      }
      on event NetworkIncident.IncidentResolved is {
        send event NetworkIncident.IncidentResolved to outlet NetworkIncidentEvents
      }
      on event NetworkIncident.IncidentClosed is {
        send event NetworkIncident.IncidentClosed to outlet NetworkIncidentEvents
      }
      on event NetworkIncident.TimelineEntryAdded is {
        send event NetworkIncident.TimelineEntryAdded to outlet NetworkIncidentEvents
      }
      on other is {
        error "Unexpected message for source NetworkIncidentEventSource"
      }
    } with {
      briefly "NetworkIncident source handler"
      described as {
        |Publishes NetworkIncident events onto the outlet.
      }
    }
  } with {
    briefly "NetworkIncident event source"
    described as {
      |Publishes NetworkIncident entity events into the streaming topology.
    }
  }
  sink NetworkIncidentEventSink is {
    inlet NetworkIncidentInlet is type NetworkIncidentEvent
    handler NetworkIncidentSinkHandler is {
      on event NetworkIncident.IncidentCreated is {
        tell event NetworkIncident.IncidentCreated to repository OperationsContext.OperationsRepository
      }
      on event NetworkIncident.IncidentAcknowledged is {
        tell event NetworkIncident.IncidentAcknowledged to repository OperationsContext.OperationsRepository
      }
      on event NetworkIncident.InvestigationStarted is {
        tell event NetworkIncident.InvestigationStarted to repository OperationsContext.OperationsRepository
      }
      on event NetworkIncident.IncidentEscalated is {
        tell event NetworkIncident.IncidentEscalated to repository OperationsContext.OperationsRepository
      }
      on event NetworkIncident.MitigationStarted is {
        tell event NetworkIncident.MitigationStarted to repository OperationsContext.OperationsRepository
      }
      on event NetworkIncident.IncidentResolved is {
        tell event NetworkIncident.IncidentResolved to repository OperationsContext.OperationsRepository
      }
      on event NetworkIncident.IncidentClosed is {
        tell event NetworkIncident.IncidentClosed to repository OperationsContext.OperationsRepository
      }
      on event NetworkIncident.TimelineEntryAdded is {
        tell event NetworkIncident.TimelineEntryAdded to repository OperationsContext.OperationsRepository
      }
      on other is {
        error "Unexpected message for sink NetworkIncidentEventSink"
      }
    } with {
      briefly "NetworkIncident sink handler"
      described as {
        |Persists NetworkIncident events via the repository.
      }
    }
  } with {
    briefly "NetworkIncident event sink"
    described as {
      |Receives NetworkIncident events for persistence.
    }
  }
  connector NetworkIncidentEventFlow is {
    from outlet OperationsContext.NetworkIncidentEventSource.NetworkIncidentEvents to
      inlet OperationsContext.NetworkIncidentEventSink.NetworkIncidentInlet
  } with {
    briefly "NetworkIncident event flow"
    described as {
      |Connects the NetworkIncident source to its sink.
    }
  }
} with {
  briefly "Bounded context for network operations"
  described as {
    |Network operations center management context.
  }
}
