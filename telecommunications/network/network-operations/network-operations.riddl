// Network Operations Domain Model
// NOC management for telecom providers
domain NetworkOperations is {
  persistent connector 'NetworkMonitoringSystemReply Stream' is from outlet NetworkMonitoringSystem.NetworkMonitoringSystemRepliesOut to inlet OperationsContext.ToNetworkMonitoringSystem.ToNetworkMonitoringSystemReplies with {
    briefly "What NetworkMonitoringSystem answers OperationsContext"
  }
  persistent connector 'CapacityPlanningSystemReply Stream' is from outlet CapacityPlanningSystem.CapacityPlanningSystemRepliesOut to inlet OperationsContext.ToCapacityPlanningSystem.ToCapacityPlanningSystemReplies with {
    briefly "What CapacityPlanningSystem answers OperationsContext"
  }
  persistent connector 'CapacityPlanningSystemEvent Stream' is from outlet CapacityPlanningSystem.CapacityPlanningSystemEventsOut to inlet OperationsContext.FromCapacityPlanningSystem.FromCapacityPlanningSystemIn with {
    briefly "What CapacityPlanningSystem tells OperationsContext, unasked"
  }
  persistent connector 'ChangeManagementSystemEvent Stream' is from outlet ChangeManagementSystem.ChangeManagementSystemEventsOut to inlet OperationsContext.FromChangeManagementSystem.FromChangeManagementSystemIn with {
    briefly "What ChangeManagementSystem tells OperationsContext, unasked"
  }
  persistent connector 'NetworkMonitoringSystemEvent Stream' is from outlet NetworkMonitoringSystem.NetworkMonitoringSystemEventsOut to inlet OperationsContext.FromNetworkMonitoringSystem.FromNetworkMonitoringSystemIn with {
    briefly "What NetworkMonitoringSystem tells OperationsContext, unasked"
  }
  persistent connector 'NetworkMonitoringSystemRequest Stream' is from outlet OperationsContext.ToNetworkMonitoringSystem.ToNetworkMonitoringSystemOut to inlet NetworkMonitoringSystem.NetworkMonitoringSystemRequests with {
    briefly "What OperationsContext asks NetworkMonitoringSystem to send"
  }
  persistent connector 'CapacityPlanningSystemRequest Stream' is from outlet OperationsContext.ToCapacityPlanningSystem.ToCapacityPlanningSystemOut to inlet CapacityPlanningSystem.CapacityPlanningSystemRequests with {
    briefly "What OperationsContext asks CapacityPlanningSystem to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user NOCOperator is "person monitoring network health" with {
    briefly "NOC Operator"
    described as {
      |Operator monitoring network operations center.
    }
  }
  user IncidentManager is "person managing network incidents" with {
    briefly "Incident Manager"
    described as {
      |Manager coordinating incident resolution.
    }
  }
  user CapacityPlanner is "person planning network capacity" with {
    briefly "Capacity Planner"
    described as {
      |Engineer planning network capacity.
    }
  }
  epic IncidentManagement is {
    user NOCOperator wants to "to manage network incidents" so that "service disruptions are resolved quickly"
    case HandleNetworkIncident is {
      user NOCOperator wants to "to handle a network incident" so that "affected services are restored"
      step is "Operator detects" "network anomaly" "from monitoring" with {
        briefly "Detect anomaly"
        described as {
          |Detect network issue.
        }
      }
      step is "System creates" "incident record" "for tracking" with {
        briefly "Create incident"
        described as {
          |Log the incident.
        }
      }
      step is "Operator escalates" "incident" "if unresolved" with {
        briefly "Escalate"
        described as {
          |Escalate as needed.
        }
      }
    } with {
      briefly "Handle network incident"
      described as {
        |Detecting and resolving network incidents.
      }
    }
  } with {
    briefly "Incident management"
    described as {
      |Epic for network incident lifecycle.
    }
  }
  include "OperationsContext.riddl"
  include "external-contexts.riddl"
  application context NetworkOperationsApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in NetworkOperations are delivered.
      }
    }
    group NetworkOperationsScreen is {
      input GetIncidentMetricsInput acquires query OperationsContext.GetIncidentMetrics with {
        briefly "Get incident metrics control"
        described as {
          |The control through which a user asks the get incident metrics question.
        }
      }
      input GetNetworkIncidentInput acquires query OperationsContext.NetworkIncident.GetNetworkIncident with {
        briefly "Get network incident control"
        described as {
          |The control through which a user asks the get network incident question.
        }
      }
      input AcknowledgeIncidentInput acquires command OperationsContext.NetworkIncident.AcknowledgeIncident with {
        briefly "Acknowledge incident control"
        described as {
          |The control through which a user submits the acknowledge incident request.
        }
      }
      input BeginMitigationInput acquires command OperationsContext.NetworkIncident.BeginMitigation with {
        briefly "Begin mitigation control"
        described as {
          |The control through which a user submits the begin mitigation request.
        }
      }
      input CloseIncidentInput acquires command OperationsContext.NetworkIncident.CloseIncident with {
        briefly "Close incident control"
        described as {
          |The control through which a user submits the close incident request.
        }
      }
      input EscalateIncidentInput acquires command OperationsContext.NetworkIncident.EscalateIncident with {
        briefly "Escalate incident control"
        described as {
          |The control through which a user submits the escalate incident request.
        }
      }
      input ResolveIncidentInput acquires command OperationsContext.NetworkIncident.ResolveIncident with {
        briefly "Resolve incident control"
        described as {
          |The control through which a user submits the resolve incident request.
        }
      }
    } with {
      briefly "Network operations screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppOperationsRepositoryQueries is query OperationsContext.GetIncidentMetrics
    inlet AppOperationsRepositoryReplies is result OperationsContext.IncidentMetricsView
    outlet AppNetworkIncidentQueries is query OperationsContext.NetworkIncident.GetNetworkIncident
    outlet AppNetworkIncidentCommands is type OperationsContext.NetworkIncidentRequest
    inlet AppOperationsRepositoryResponses is result OperationsContext.NetworkIncident.NetworkIncidentResult
    handler NetworkOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context NetworkOperationsApp"
      }
    } with {
      briefly "NetworkOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "NetworkOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ChangeManagementSystemRequest Stream' is from outlet OperationsContext.ToChangeManagementSystem.ToChangeManagementSystemOut to inlet ChangeManagementSystem.ChangeManagementSystemRequests with {
    briefly "What OperationsContext asks ChangeManagementSystem to send"
  }
  persistent connector 'OperationsRepositoryQuery Stream' is from outlet NetworkOperationsApp.AppOperationsRepositoryQueries to inlet OperationsContext.OperationsRepositoryQueriesIn with {
    briefly "NetworkOperationsApp's look-ups of the operations repository"
  }
  persistent connector 'OperationsRepositoryReply Stream' is from outlet OperationsContext.OperationsRepositoryRepliesOut to inlet NetworkOperationsApp.AppOperationsRepositoryReplies with {
    briefly "The operations repository's answers returned to NetworkOperationsApp"
  }
  persistent connector 'NetworkIncidentQuery Stream' is from outlet NetworkOperationsApp.AppNetworkIncidentQueries to inlet OperationsContext.NetworkIncidentQueriesIn with {
    briefly "NetworkOperationsApp's look-ups of the network incident"
  }
  persistent connector 'NetworkIncidentCommand Stream' is from outlet NetworkOperationsApp.AppNetworkIncidentCommands to inlet OperationsContext.NetworkIncidentCommandStreamIn with {
    briefly "NetworkIncident commands from the application"
  }
  persistent connector 'NetworkIncidentResult Stream' is from outlet OperationsContext.NetworkIncidentResultStreamOut to inlet NetworkOperationsApp.AppOperationsRepositoryResponses with {
    briefly "Operations query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet NetworkOperationsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Network operations domain"
  described as {
    |NOC management for telecom providers.
  }
}
