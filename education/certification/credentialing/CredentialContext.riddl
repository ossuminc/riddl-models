// Credentialing - Credential Context
context CredentialContext is {
  include "types.riddl"
  include "Credential.riddl"
  // Repository for credential persistence
  repository CredentialRepository is {
    inlet CredentialRepositoryFromCredential is type CredentialEvent
    inlet CredentialRepositoryFromCredentialAnalytics is type CredentialEvent
    outlet CredentialRepositoryResponses is type Credential.CredentialResult
    schema CredentialData is relational
      of credentials as type Credential
        index on field Credential.credentialId
        index on field Credential.candidateId
      with {
      briefly "Credential data schema"
      described as {
        |The relational schema holding credential data for the CredentialRepository.
      }
    }

    handler CredentialPersistence is {
      on command Credential.CreateApplication is {
        tell event Credential.ApplicationCreated to entity CredentialContext.Credential
        do "Store application record"
      }
      on command Credential.SubmitDocument is {
        tell event Credential.DocumentSubmitted to entity CredentialContext.Credential
        do "Store document record"
      }
      on command Credential.ReviewApplication is {
        do "Update application status"
      }
      on command Credential.ScheduleExamination is {
        tell event Credential.ExaminationScheduled to entity CredentialContext.Credential
        do "Store exam attempt"
      }
      on command Credential.RecordExamResult is {
        tell event Credential.ExamResultRecorded to entity CredentialContext.Credential
        do "Update exam result"
      }
      on command Credential.IssueCredential is {
        tell event Credential.CredentialIssued to entity CredentialContext.Credential
        do "Store credential record"
      }
      on command Credential.SuspendCredential is {
        tell event Credential.CredentialSuspended to entity CredentialContext.Credential
        do "Update credential status"
      }
      on command Credential.RevokeCredential is {
        do "Update credential status"
      }
      on command Credential.RecordContinuingEducation is {
        tell event Credential.ContinuingEducationRecorded to entity CredentialContext.Credential
        do "Store CE record"
      }
      on command Credential.RenewCredential is {
        do "Update credential expiration"
      }
    } with {
      briefly "Persists credential commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Credential data persistence"
    described as {
      | The CredentialRepository provides persistent storage for
      | credentials, applications, and verification history.
    }
  }
  // Projector for credential analytics
  projector CredentialAnalytics is {
    inlet CredentialAnalyticsFromCredential is type CredentialEvent
    outlet CredentialAnalyticsOut is type CredentialEvent
    updates repository CredentialContext.CredentialRepository
    record CredentialStats is  {
      programId: ProgramId with {
        briefly "Program"
        described as {
          |Program ID.
        }
      }
      totalIssued: Natural with {
        briefly "Issued"
        described as {
          |Total issued.
        }
      }
      totalActive: Natural with {
        briefly "Active"
        described as {
          |Currently active.
        }
      }
      passRate: Decimal(5,2) with {
        briefly "Pass rate"
        described as {
          |Exam pass rate.
        }
      }
      renewalRate: Decimal(5,2) with {
        briefly "Renewal rate"
        described as {
          |Renewal rate.
        }
      }
    } with {
      briefly "Credential statistics"
      described as {
        |Program credential metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Credential.CredentialIssued is {
        tell event Credential.CredentialIssued to repository CredentialContext.CredentialRepository
        do "Update issuance counts"
      }
      on event Credential.ExamResultRecorded is {
        tell event Credential.ExamResultRecorded to repository CredentialContext.CredentialRepository
        do "Update pass rate metrics"
      }
      on event Credential.CredentialRenewed is {
        tell event Credential.CredentialRenewed to repository CredentialContext.CredentialRepository
        do "Update renewal metrics"
      }
      on event Credential.CredentialRevoked is {
        tell event Credential.CredentialRevoked to repository CredentialContext.CredentialRepository
        do "Update active counts"
      }
    } with {
      briefly "Maintains credential analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Credential analytics projections"
    described as {
      |Maintains credential analytics data.
    }
  }
  // ---- Event publication for Credential ----
  type CredentialEvent is one of {
    CredentialContext.Credential.ApplicationCreated,
    CredentialContext.Credential.DocumentSubmitted,
    CredentialContext.Credential.ApplicationReviewed,
    CredentialContext.Credential.ExaminationScheduled,
    CredentialContext.Credential.ExamResultRecorded,
    CredentialContext.Credential.CredentialIssued,
    CredentialContext.Credential.CredentialSuspended,
    CredentialContext.Credential.CredentialRevoked,
    CredentialContext.Credential.ContinuingEducationRecorded,
    CredentialContext.Credential.CredentialRenewed,
    CredentialContext.Credential.CredentialVerified
  } with {
    briefly "Credential event alternation"
    described as {
      |Union of all Credential events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CredentialEventSource as source is {
    outlet CredentialEvents is type CredentialEvent
    handler CredentialSourceHandler is {
      on event Credential.ApplicationCreated is {
        send event Credential.ApplicationCreated to outlet CredentialEvents
      }
      on event Credential.DocumentSubmitted is {
        send event Credential.DocumentSubmitted to outlet CredentialEvents
      }
      on event Credential.ApplicationReviewed is {
        send event Credential.ApplicationReviewed to outlet CredentialEvents
      }
      on event Credential.ExaminationScheduled is {
        send event Credential.ExaminationScheduled to outlet CredentialEvents
      }
      on event Credential.ExamResultRecorded is {
        send event Credential.ExamResultRecorded to outlet CredentialEvents
      }
      on event Credential.CredentialIssued is {
        send event Credential.CredentialIssued to outlet CredentialEvents
      }
      on event Credential.CredentialSuspended is {
        send event Credential.CredentialSuspended to outlet CredentialEvents
      }
      on event Credential.CredentialRevoked is {
        send event Credential.CredentialRevoked to outlet CredentialEvents
      }
      on event Credential.ContinuingEducationRecorded is {
        send event Credential.ContinuingEducationRecorded to outlet CredentialEvents
      }
      on event Credential.CredentialRenewed is {
        send event Credential.CredentialRenewed to outlet CredentialEvents
      }
      on event Credential.CredentialVerified is {
        send event Credential.CredentialVerified to outlet CredentialEvents
      }
      on other is {
        error "Unexpected message for source CredentialEventSource"
      }
    } with {
      briefly "Credential source handler"
      described as {
        |Publishes Credential events onto the outlet.
      }
    }
  } with {
    briefly "Credential event source"
    described as {
      |Publishes Credential entity events into the streaming topology.
    }
  }
  processor CredentialEventSink as sink is {
    inlet CredentialInlet is type CredentialEvent
    handler CredentialSinkHandler is {
      on event Credential.ApplicationCreated is {
        tell event Credential.ApplicationCreated to repository CredentialContext.CredentialRepository
      }
      on event Credential.DocumentSubmitted is {
        tell event Credential.DocumentSubmitted to repository CredentialContext.CredentialRepository
      }
      on event Credential.ApplicationReviewed is {
        tell event Credential.ApplicationReviewed to repository CredentialContext.CredentialRepository
      }
      on event Credential.ExaminationScheduled is {
        tell event Credential.ExaminationScheduled to repository CredentialContext.CredentialRepository
      }
      on event Credential.ExamResultRecorded is {
        tell event Credential.ExamResultRecorded to repository CredentialContext.CredentialRepository
      }
      on event Credential.CredentialIssued is {
        tell event Credential.CredentialIssued to repository CredentialContext.CredentialRepository
      }
      on event Credential.CredentialSuspended is {
        tell event Credential.CredentialSuspended to repository CredentialContext.CredentialRepository
      }
      on event Credential.CredentialRevoked is {
        tell event Credential.CredentialRevoked to repository CredentialContext.CredentialRepository
      }
      on event Credential.ContinuingEducationRecorded is {
        tell event Credential.ContinuingEducationRecorded to repository CredentialContext.CredentialRepository
      }
      on event Credential.CredentialRenewed is {
        tell event Credential.CredentialRenewed to repository CredentialContext.CredentialRepository
      }
      on event Credential.CredentialVerified is {
        tell event Credential.CredentialVerified to repository CredentialContext.CredentialRepository
      }
      on other is {
        error "Unexpected message for sink CredentialEventSink"
      }
    } with {
      briefly "Credential sink handler"
      described as {
        |Persists Credential events via the repository.
      }
    }
  } with {
    briefly "Credential event sink"
    described as {
      |Receives Credential events for persistence.
    }
  }
  connector CredentialEventFlow is {
    from outlet CredentialContext.CredentialEventSource.CredentialEvents to
      inlet CredentialContext.CredentialEventSink.CredentialInlet
  } with {
    briefly "Credential event flow"
    described as {
      |Connects the Credential source to its sink.
    }
  }
  processor CredentialEventSplit is {
    inlet CredentialEventSplitIn is type CredentialEvent
    outlet CredentialEventSplitToCredentialRepository is type CredentialEvent
    outlet CredentialEventSplitToCredentialAnalytics is type CredentialEvent
    handler CredentialEventSplitHandler is {
      on event Credential.ApplicationCreated is {
        send event Credential.ApplicationCreated to outlet CredentialEventSplitToCredentialRepository
        send event Credential.ApplicationCreated to outlet CredentialEventSplitToCredentialAnalytics
        tell event Credential.ApplicationCreated to entity CredentialContext.Credential
      }
      on event Credential.DocumentSubmitted is {
        send event Credential.DocumentSubmitted to outlet CredentialEventSplitToCredentialRepository
        send event Credential.DocumentSubmitted to outlet CredentialEventSplitToCredentialAnalytics
        tell event Credential.DocumentSubmitted to entity CredentialContext.Credential
      }
      on event Credential.ApplicationReviewed is {
        send event Credential.ApplicationReviewed to outlet CredentialEventSplitToCredentialRepository
        send event Credential.ApplicationReviewed to outlet CredentialEventSplitToCredentialAnalytics
        tell event Credential.ApplicationReviewed to entity CredentialContext.Credential
      }
      on event Credential.ExaminationScheduled is {
        send event Credential.ExaminationScheduled to outlet CredentialEventSplitToCredentialRepository
        send event Credential.ExaminationScheduled to outlet CredentialEventSplitToCredentialAnalytics
        tell event Credential.ExaminationScheduled to entity CredentialContext.Credential
      }
      on event Credential.ExamResultRecorded is {
        send event Credential.ExamResultRecorded to outlet CredentialEventSplitToCredentialRepository
        send event Credential.ExamResultRecorded to outlet CredentialEventSplitToCredentialAnalytics
        tell event Credential.ExamResultRecorded to entity CredentialContext.Credential
      }
      on event Credential.CredentialIssued is {
        send event Credential.CredentialIssued to outlet CredentialEventSplitToCredentialRepository
        send event Credential.CredentialIssued to outlet CredentialEventSplitToCredentialAnalytics
        tell event Credential.CredentialIssued to entity CredentialContext.Credential
      }
      on event Credential.CredentialSuspended is {
        send event Credential.CredentialSuspended to outlet CredentialEventSplitToCredentialRepository
        send event Credential.CredentialSuspended to outlet CredentialEventSplitToCredentialAnalytics
        tell event Credential.CredentialSuspended to entity CredentialContext.Credential
      }
      on event Credential.CredentialRevoked is {
        send event Credential.CredentialRevoked to outlet CredentialEventSplitToCredentialRepository
        send event Credential.CredentialRevoked to outlet CredentialEventSplitToCredentialAnalytics
        tell event Credential.CredentialRevoked to entity CredentialContext.Credential
      }
      on event Credential.ContinuingEducationRecorded is {
        send event Credential.ContinuingEducationRecorded to outlet CredentialEventSplitToCredentialRepository
        send event Credential.ContinuingEducationRecorded to outlet CredentialEventSplitToCredentialAnalytics
        tell event Credential.ContinuingEducationRecorded to entity CredentialContext.Credential
      }
      on event Credential.CredentialRenewed is {
        send event Credential.CredentialRenewed to outlet CredentialEventSplitToCredentialRepository
        send event Credential.CredentialRenewed to outlet CredentialEventSplitToCredentialAnalytics
        tell event Credential.CredentialRenewed to entity CredentialContext.Credential
      }
      on event Credential.CredentialVerified is {
        send event Credential.CredentialVerified to outlet CredentialEventSplitToCredentialRepository
        send event Credential.CredentialVerified to outlet CredentialEventSplitToCredentialAnalytics
        tell event Credential.CredentialVerified to entity CredentialContext.Credential
      }
      on other is {
        error "Unexpected message for processor CredentialEventSplit"
      }
    } with {
      briefly "Credential event fan-out handler"
      described as {
        |Delivers each Credential event to all of its consumers.
      }
    }
  } with {
    briefly "Credential event fan-out"
    described as {
      |Fans Credential events out to the repository and projectors.
    }
  }
  connector LinkCredentialToCredentialEventSplit is {
    from outlet CredentialContext.Credential.CredentialEvents2 to
      inlet CredentialContext.CredentialEventSplit.CredentialEventSplitIn
  } with {
    briefly "LinkCredentialToCredentialEventSplit"
  }
  connector LinkCredentialEventSplitToCredentialRepository is {
    from outlet CredentialContext.CredentialEventSplit.CredentialEventSplitToCredentialRepository to
      inlet CredentialContext.CredentialRepository.CredentialRepositoryFromCredential
  } with {
    briefly "LinkCredentialEventSplitToCredentialRepository"
  }
  connector LinkCredentialEventSplitToCredentialAnalytics is {
    from outlet CredentialContext.CredentialEventSplit.CredentialEventSplitToCredentialAnalytics to
      inlet CredentialContext.CredentialAnalytics.CredentialAnalyticsFromCredential
  } with {
    briefly "LinkCredentialEventSplitToCredentialAnalytics"
  }
  connector LinkCredentialAnalyticsToCredentialRepository is {
    from outlet CredentialContext.CredentialAnalytics.CredentialAnalyticsOut to
      inlet CredentialContext.CredentialRepository.CredentialRepositoryFromCredentialAnalytics
  } with {
    briefly "LinkCredentialAnalyticsToCredentialRepository"
  }
} with {
  briefly "Bounded context for credentialing"
  described as {
    | The CredentialContext is the bounded context for professional
    | certification, licensing, and credential verification.
  }
}
