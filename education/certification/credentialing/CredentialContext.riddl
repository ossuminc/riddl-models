// Credentialing - Credential Context
context CredentialContext as router is {
  inlet CredentialCommandStreamIn is type CredentialCommand  outlet CredentialCommandStreamOut is type CredentialCommand
  inlet CredentialResultStreamIn is result Credential.CredentialResult  outlet CredentialResultStreamOut is result Credential.CredentialResult
  handler CredentialContextBoundary is {
    on createApplication: command Credential.CreateApplication is {
      send createApplication to outlet CredentialContext.CredentialCommandStreamOut
    }
    on submitDocument: command Credential.SubmitDocument is {
      send submitDocument to outlet CredentialContext.CredentialCommandStreamOut
    }
    on reviewApplication: command Credential.ReviewApplication is {
      send reviewApplication to outlet CredentialContext.CredentialCommandStreamOut
    }
    on scheduleExamination: command Credential.ScheduleExamination is {
      send scheduleExamination to outlet CredentialContext.CredentialCommandStreamOut
    }
    on recordExamResult: command Credential.RecordExamResult is {
      send recordExamResult to outlet CredentialContext.CredentialCommandStreamOut
    }
    on issueCredential: command Credential.IssueCredential is {
      send issueCredential to outlet CredentialContext.CredentialCommandStreamOut
    }
    on suspendCredential: command Credential.SuspendCredential is {
      send suspendCredential to outlet CredentialContext.CredentialCommandStreamOut
    }
    on revokeCredential: command Credential.RevokeCredential is {
      send revokeCredential to outlet CredentialContext.CredentialCommandStreamOut
    }
    on recordContinuingEducation: command Credential.RecordContinuingEducation is {
      send recordContinuingEducation to outlet CredentialContext.CredentialCommandStreamOut
    }
    on renewCredential: command Credential.RenewCredential is {
      send renewCredential to outlet CredentialContext.CredentialCommandStreamOut
    }
    on verifyCredential: command Credential.VerifyCredential is {
      send verifyCredential to outlet CredentialContext.CredentialCommandStreamOut
    }
    on credentialResult: result Credential.CredentialResult is {
      send credentialResult to outlet CredentialContext.CredentialResultStreamOut
    }
    on other is {
      error "Unexpected message at the CredentialContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CredentialCommand Stream Intake' is from outlet CredentialContext.CredentialCommandStreamOut to inlet CredentialContext.Credential.CredentialCommands  connector 'CredentialResult Stream Egress' is from outlet CredentialContext.CredentialRepository.CredentialRepositoryResponses to inlet CredentialContext.CredentialResultStreamIn  adaptor FromBackgroundCheckService from context BackgroundCheckService is { 
    handler FromBackgroundCheckServiceHandler is {
      on event BackgroundCheckService.BackgroundCheckCompleted is {
        do "the model receives background check completed"
      }
      on other is {
        error "Unexpected message for adaptor FromBackgroundCheckService"
      }
    } with {
      briefly "from background check service"
      described as {
        |Carries messages from the external BackgroundCheckService.
      }
    }
  } with {
    briefly "BackgroundCheckService integration"
    described as {
      |The model's side of the BackgroundCheckService conversation.
    }
  }
  adaptor ToBackgroundCheckService to context BackgroundCheckService is { 
    handler ToBackgroundCheckServiceHandler is {
      on command BackgroundCheckService.InitiateBackgroundCheck is {
        do "the model sends initiate background check"
      }
      on other is {
        error "Unexpected message for adaptor ToBackgroundCheckService"
      }
    } with {
      briefly "to background check service"
      described as {
        |Carries messages to the external BackgroundCheckService.
      }
    }
  } with {
    briefly "BackgroundCheckService integration"
    described as {
      |The model's side of the BackgroundCheckService conversation.
    }
  }
  adaptor FromDigitalCredentialService from context DigitalCredentialService is { 
    handler FromDigitalCredentialServiceHandler is {
      on event DigitalCredentialService.DigitalBadgeIssued is {
        do "the model receives digital badge issued"
      }
      on other is {
        error "Unexpected message for adaptor FromDigitalCredentialService"
      }
    } with {
      briefly "from digital credential service"
      described as {
        |Carries messages from the external DigitalCredentialService.
      }
    }
  } with {
    briefly "DigitalCredentialService integration"
    described as {
      |The model's side of the DigitalCredentialService conversation.
    }
  }
  adaptor ToDigitalCredentialService to context DigitalCredentialService is { 
    handler ToDigitalCredentialServiceHandler is {
      on command DigitalCredentialService.IssueDigitalBadge is {
        do "the model sends issue digital badge"
      }
      on other is {
        error "Unexpected message for adaptor ToDigitalCredentialService"
      }
    } with {
      briefly "to digital credential service"
      described as {
        |Carries messages to the external DigitalCredentialService.
      }
    }
  } with {
    briefly "DigitalCredentialService integration"
    described as {
      |The model's side of the DigitalCredentialService conversation.
    }
  }
  adaptor FromExaminationService from context ExaminationService is { 
    handler FromExaminationServiceHandler is {
      on event ExaminationService.ExamCompleted is {
        do "the model receives exam completed"
      }
      on other is {
        error "Unexpected message for adaptor FromExaminationService"
      }
    } with {
      briefly "from examination service"
      described as {
        |Carries messages from the external ExaminationService.
      }
    }
  } with {
    briefly "ExaminationService integration"
    described as {
      |The model's side of the ExaminationService conversation.
    }
  }
  adaptor ToExaminationService to context ExaminationService is { 
    handler ToExaminationServiceHandler is {
      on command ExaminationService.ScheduleExam is {
        do "the model sends schedule exam"
      }
      on other is {
        error "Unexpected message for adaptor ToExaminationService"
      }
    } with {
      briefly "to examination service"
      described as {
        |Carries messages to the external ExaminationService.
      }
    }
  } with {
    briefly "ExaminationService integration"
    described as {
      |The model's side of the ExaminationService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendApplicationUpdate is {
        do "the model sends send application update"
      }
      on command NotificationService.SendExpirationReminder is {
        do "the model sends send expiration reminder"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentService from context PaymentService is { 
    handler FromPaymentServiceHandler is {
      on event PaymentService.PaymentReceived is {
        do "the model receives payment received"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentService"
      }
    } with {
      briefly "from payment service"
      described as {
        |Carries messages from the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor ToPaymentService to context PaymentService is { 
    handler ToPaymentServiceHandler is {
      on command PaymentService.ProcessApplicationFee is {
        do "the model sends process application fee"
      }
      on command PaymentService.ProcessRenewalFee is {
        do "the model sends process renewal fee"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentService"
      }
    } with {
      briefly "to payment service"
      described as {
        |Carries messages to the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  include "types.riddl"
  include "Credential.riddl"
  // Repository for credential persistence
  type CredentialRepositoryCommand is one of {
    CredentialContext.CredentialRepository.PersistApplicationCreated or CredentialContext.CredentialRepository.PersistApplicationReviewed or CredentialContext.CredentialRepository.PersistContinuingEducationRecorded or CredentialContext.CredentialRepository.PersistCredentialIssued or CredentialContext.CredentialRepository.PersistCredentialRenewed or CredentialContext.CredentialRepository.PersistCredentialRevoked or CredentialContext.CredentialRepository.PersistCredentialSuspended or CredentialContext.CredentialRepository.PersistCredentialVerified or CredentialContext.CredentialRepository.PersistDocumentSubmitted or CredentialContext.CredentialRepository.PersistExamResultRecorded or CredentialContext.CredentialRepository.PersistExaminationScheduled
  } with {
    briefly "Anything that writes CredentialRepository"
    described as {
      |The persistence commands CredentialRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository CredentialRepository as flow is {
    inlet CredentialRepositoryFromCredentialAnalytics is type CredentialRepositoryCommand    command PersistApplicationCreated is  {
      credentialId: CredentialId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApplicationCreated applies to.
        }
      }
    } with {
      briefly "Persist ApplicationCreated"
      described as {
        |Instructs this repository to apply ApplicationCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistApplicationReviewed is  {
      credentialId: CredentialId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApplicationReviewed applies to.
        }
      }
    } with {
      briefly "Persist ApplicationReviewed"
      described as {
        |Instructs this repository to apply ApplicationReviewed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContinuingEducationRecorded is  {
      credentialId: CredentialId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContinuingEducationRecorded applies to.
        }
      }
    } with {
      briefly "Persist ContinuingEducationRecorded"
      described as {
        |Instructs this repository to apply ContinuingEducationRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCredentialSuspended is  {
      credentialId: CredentialId with {
        briefly "Row addressed"
        described as {
          |Which stored row CredentialSuspended applies to.
        }
      }
    } with {
      briefly "Persist CredentialSuspended"
      described as {
        |Instructs this repository to apply CredentialSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCredentialVerified is  {
      credentialId: CredentialId with {
        briefly "Row addressed"
        described as {
          |Which stored row CredentialVerified applies to.
        }
      }
    } with {
      briefly "Persist CredentialVerified"
      described as {
        |Instructs this repository to apply CredentialVerified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDocumentSubmitted is  {
      credentialId: CredentialId with {
        briefly "Row addressed"
        described as {
          |Which stored row DocumentSubmitted applies to.
        }
      }
    } with {
      briefly "Persist DocumentSubmitted"
      described as {
        |Instructs this repository to apply DocumentSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExaminationScheduled is  {
      credentialId: CredentialId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExaminationScheduled applies to.
        }
      }
    } with {
      briefly "Persist ExaminationScheduled"
      described as {
        |Instructs this repository to apply ExaminationScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCredentialIssued is  {
      credentialId: CredentialId with {
        briefly "Row addressed"
        described as {
          |Which stored row CredentialIssued applies to.
        }
      }
    } with {
      briefly "Persist CredentialIssued"
      described as {
        |Instructs this repository to apply CredentialIssued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCredentialRenewed is  {
      credentialId: CredentialId with {
        briefly "Row addressed"
        described as {
          |Which stored row CredentialRenewed applies to.
        }
      }
    } with {
      briefly "Persist CredentialRenewed"
      described as {
        |Instructs this repository to apply CredentialRenewed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCredentialRevoked is  {
      credentialId: CredentialId with {
        briefly "Row addressed"
        described as {
          |Which stored row CredentialRevoked applies to.
        }
      }
    } with {
      briefly "Persist CredentialRevoked"
      described as {
        |Instructs this repository to apply CredentialRevoked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExamResultRecorded is  {
      attemptId: UUID with {
        briefly "Row addressed"
        described as {
          |Which stored row ExamResultRecorded applies to.
        }
      }
    } with {
      briefly "Persist ExamResultRecorded"
      described as {
        |Instructs this repository to apply ExamResultRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet CredentialRepositoryResponses is result Credential.CredentialResult
    record StoredCredential is  {
      credentialId: CredentialId with {
        briefly "credentialId"
        described as {
          |The credentialId column of the stored credential row.
        }
      }
      candidateId: CandidateId with {
        briefly "candidateId"
        described as {
          |The candidateId column of the stored credential row.
        }
      }
    } with {
      briefly "Stored credential row"
      described as {
        |The persistence shape of credential data as this repository stores it.
      }
    }
    schema CredentialData is relational
      of credentials as record StoredCredential
        index on field StoredCredential.credentialId
        index on field StoredCredential.candidateId
 with {
      briefly "Credential data schema"
      described as {
        |The relational schema holding credential data for the CredentialRepository.
      }
    }
    handler CredentialPersistence is {
      on persistApplicationCreated: command PersistApplicationCreated is {
        do "apply ApplicationCreated to the stored row"
      }
      on persistApplicationReviewed: command PersistApplicationReviewed is {
        do "apply ApplicationReviewed to the stored row"
      }
      on persistContinuingEducationRecorded: command PersistContinuingEducationRecorded is {
        do "apply ContinuingEducationRecorded to the stored row"
      }
      on persistCredentialSuspended: command PersistCredentialSuspended is {
        do "apply CredentialSuspended to the stored row"
      }
      on persistCredentialVerified: command PersistCredentialVerified is {
        do "apply CredentialVerified to the stored row"
      }
      on persistDocumentSubmitted: command PersistDocumentSubmitted is {
        do "apply DocumentSubmitted to the stored row"
      }
      on persistExaminationScheduled: command PersistExaminationScheduled is {
        do "apply ExaminationScheduled to the stored row"
      }
      on persistCredentialIssued: command PersistCredentialIssued is {
        do "apply CredentialIssued to the stored row"
      }
      on persistCredentialRenewed: command PersistCredentialRenewed is {
        do "apply CredentialRenewed to the stored row"
      }
      on persistCredentialRevoked: command PersistCredentialRevoked is {
        do "apply CredentialRevoked to the stored row"
      }
      on persistExamResultRecorded: command PersistExamResultRecorded is {
        do "apply ExamResultRecorded to the stored row"
      }
      on query GetCredentialStats is {
        let credentialStatsView: type CredentialStatsView = prompt("read the credential stats projection")
        reply credentialStatsView
      }
    } with {
      briefly "Persists credential commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Credential data persistence"
    described as {
      | The CredentialRepository provides persistent storage for
      | credentials, applications, and verification history.
    }
  }
  // Projector for credential analytics
  query GetCredentialStats replies result CredentialStatsView is  {
    credentialStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which credential stats to retrieve.
      }
    }
  } with {
    briefly "Get credential stats"
    described as {
      |Retrieves the credential stats projection.
    }
  }
  result CredentialStatsView is  {
    credentialStats: CredentialAnalytics.CredentialStats with {
      briefly "Credential stats"
      described as {
        |The credential stats being returned.
      }
    }
  } with {
    briefly "Credential stats view"
    described as {
      |Read model view carrying the credential stats projection.
    }
  }
  projector CredentialAnalytics as flow is {
    updates repository CredentialContext.CredentialRepository
    outlet CredentialAnalyticsToRepository is type CredentialRepositoryCommand
    inlet CredentialAnalyticsFromCredential is type CredentialEvent    record CredentialStats is  {
      programId: ProgramId with {
        briefly "Program"
        described as {
          |Program ID.
        }
      }
      totalIssued: Natural with {
        briefly "Issued"
        described as {
          |Total issued.
        }
      }
      totalActive: Natural with {
        briefly "Active"
        described as {
          |Currently active.
        }
      }
      passRate: Decimal(5,2) with {
        briefly "Pass rate"
        described as {
          |Exam pass rate.
        }
      }
      renewalRate: Decimal(5,2) with {
        briefly "Renewal rate"
        described as {
          |Renewal rate.
        }
      }
    } with {
      briefly "Credential statistics"
      described as {
        |Program credential metrics.
      }
    }
    handler AnalyticsHandler is {
      on applicationCreated: event Credential.ApplicationCreated is {
        tell command CredentialContext.CredentialRepository.PersistApplicationCreated(credentialId = applicationCreated.credentialId) to repository CredentialContext.CredentialRepository
        do "apply ApplicationCreated to the CredentialAnalytics projection"
      }
      on applicationReviewed: event Credential.ApplicationReviewed is {
        tell command CredentialContext.CredentialRepository.PersistApplicationReviewed(credentialId = applicationReviewed.credentialId) to repository CredentialContext.CredentialRepository
        do "apply ApplicationReviewed to the CredentialAnalytics projection"
      }
      on continuingEducationRecorded: event Credential.ContinuingEducationRecorded is {
        tell command CredentialContext.CredentialRepository.PersistContinuingEducationRecorded(credentialId = continuingEducationRecorded.credentialId) to repository CredentialContext.CredentialRepository
        do "apply ContinuingEducationRecorded to the CredentialAnalytics projection"
      }
      on credentialSuspended: event Credential.CredentialSuspended is {
        tell command CredentialContext.CredentialRepository.PersistCredentialSuspended(credentialId = credentialSuspended.credentialId) to repository CredentialContext.CredentialRepository
        do "apply CredentialSuspended to the CredentialAnalytics projection"
      }
      on credentialVerified: event Credential.CredentialVerified is {
        tell command CredentialContext.CredentialRepository.PersistCredentialVerified(credentialId = credentialVerified.credentialId) to repository CredentialContext.CredentialRepository
        do "apply CredentialVerified to the CredentialAnalytics projection"
      }
      on documentSubmitted: event Credential.DocumentSubmitted is {
        tell command CredentialContext.CredentialRepository.PersistDocumentSubmitted(credentialId = documentSubmitted.credentialId) to repository CredentialContext.CredentialRepository
        do "apply DocumentSubmitted to the CredentialAnalytics projection"
      }
      on examinationScheduled: event Credential.ExaminationScheduled is {
        tell command CredentialContext.CredentialRepository.PersistExaminationScheduled(credentialId = examinationScheduled.credentialId) to repository CredentialContext.CredentialRepository
        do "apply ExaminationScheduled to the CredentialAnalytics projection"
      }
      on credentialIssued: event Credential.CredentialIssued is {
        tell command CredentialContext.CredentialRepository.PersistCredentialIssued(credentialId = credentialIssued.credentialId) to repository CredentialContext.CredentialRepository
        do "Update issuance counts"
      }
      on examResultRecorded: event Credential.ExamResultRecorded is {
        tell command CredentialContext.CredentialRepository.PersistExamResultRecorded(attemptId = examResultRecorded.attemptId) to repository CredentialContext.CredentialRepository
        do "Update pass rate metrics"
      }
      on credentialRenewed: event Credential.CredentialRenewed is {
        tell command CredentialContext.CredentialRepository.PersistCredentialRenewed(credentialId = credentialRenewed.credentialId) to repository CredentialContext.CredentialRepository
        do "Update renewal metrics"
      }
      on credentialRevoked: event Credential.CredentialRevoked is {
        tell command CredentialContext.CredentialRepository.PersistCredentialRevoked(credentialId = credentialRevoked.credentialId) to repository CredentialContext.CredentialRepository
        do "Update active counts"
      }
    } with {
      briefly "Maintains credential analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Credential analytics projections"
    described as {
      |Maintains credential analytics data.
    }
  }
  // ---- Event publication for Credential ----
  type CredentialEvent is one of {
    CredentialContext.Credential.ApplicationCreated or CredentialContext.Credential.DocumentSubmitted or CredentialContext.Credential.ApplicationReviewed or CredentialContext.Credential.ExaminationScheduled or CredentialContext.Credential.ExamResultRecorded or CredentialContext.Credential.CredentialIssued or CredentialContext.Credential.CredentialSuspended or CredentialContext.Credential.CredentialRevoked or CredentialContext.Credential.ContinuingEducationRecorded or CredentialContext.Credential.CredentialRenewed or CredentialContext.Credential.CredentialVerified
  } with {
    briefly "Credential event alternation"
    described as {
      |Union of all Credential events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CredentialEventSplit as flow is {
    inlet CredentialEventSplitIn is type CredentialEvent    outlet CredentialEventSplitToCredentialAnalytics is type CredentialEvent
    handler CredentialEventSplitHandler is {
      on applicationCreated: event Credential.ApplicationCreated is {
        send applicationCreated to outlet CredentialEventSplitToCredentialAnalytics
        tell applicationCreated to entity CredentialContext.Credential
      }
      on documentSubmitted: event Credential.DocumentSubmitted is {
        send documentSubmitted to outlet CredentialEventSplitToCredentialAnalytics
        tell documentSubmitted to entity CredentialContext.Credential
      }
      on applicationReviewed: event Credential.ApplicationReviewed is {
        send applicationReviewed to outlet CredentialEventSplitToCredentialAnalytics
        tell applicationReviewed to entity CredentialContext.Credential
      }
      on examinationScheduled: event Credential.ExaminationScheduled is {
        send examinationScheduled to outlet CredentialEventSplitToCredentialAnalytics
        tell examinationScheduled to entity CredentialContext.Credential
      }
      on examResultRecorded: event Credential.ExamResultRecorded is {
        send examResultRecorded to outlet CredentialEventSplitToCredentialAnalytics
        tell examResultRecorded to entity CredentialContext.Credential
      }
      on credentialIssued: event Credential.CredentialIssued is {
        send credentialIssued to outlet CredentialEventSplitToCredentialAnalytics
        tell credentialIssued to entity CredentialContext.Credential
      }
      on credentialSuspended: event Credential.CredentialSuspended is {
        send credentialSuspended to outlet CredentialEventSplitToCredentialAnalytics
        tell credentialSuspended to entity CredentialContext.Credential
      }
      on credentialRevoked: event Credential.CredentialRevoked is {
        send credentialRevoked to outlet CredentialEventSplitToCredentialAnalytics
        tell credentialRevoked to entity CredentialContext.Credential
      }
      on continuingEducationRecorded: event Credential.ContinuingEducationRecorded is {
        send continuingEducationRecorded to outlet CredentialEventSplitToCredentialAnalytics
        tell continuingEducationRecorded to entity CredentialContext.Credential
      }
      on credentialRenewed: event Credential.CredentialRenewed is {
        send credentialRenewed to outlet CredentialEventSplitToCredentialAnalytics
        tell credentialRenewed to entity CredentialContext.Credential
      }
      on credentialVerified: event Credential.CredentialVerified is {
        send credentialVerified to outlet CredentialEventSplitToCredentialAnalytics
        tell credentialVerified to entity CredentialContext.Credential
      }
      on other is {
        error "Unexpected message for processor CredentialEventSplit"
      }
    } with {
      briefly "Credential event fan-out handler"
      described as {
        |Delivers each Credential event to all of its consumers.
      }
    }
  } with {
    briefly "Credential event fan-out"
    described as {
      |Fans Credential events out to the repository and projectors.
    }
  }
  connector 'CredentialEvent Stream' is from outlet CredentialContext.Credential.CredentialEvents2 to inlet CredentialContext.CredentialEventSplit.CredentialEventSplitIn with {
    briefly "Credential events, fanned out to storage and read models"
  }
  connector 'CredentialAnalytics Feed' is from outlet CredentialContext.CredentialEventSplit.CredentialEventSplitToCredentialAnalytics to inlet CredentialContext.CredentialAnalytics.CredentialAnalyticsFromCredential with {
    briefly "Credential events feeding the CredentialAnalytics projection"
  }
  connector 'CredentialAnalytics Storage' is from outlet CredentialContext.CredentialAnalytics.CredentialAnalyticsToRepository to inlet CredentialContext.CredentialRepository.CredentialRepositoryFromCredentialAnalytics with {
    briefly "CredentialAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for credentialing"
  described as {
    | The CredentialContext is the bounded context for professional
    | certification, licensing, and credential verification.
  }
}
