// Competency Management - Competency Entity
entity Competency as flow is {
  type CompetencyCommand is one of {
    Competency.CreateCompetency or Competency.UpdateCompetency or Competency.CreateFramework or Competency.AssignCompetency or Competency.RecordAssessment or Competency.UpdateAssessmentStatus or Competency.CreateDevelopmentPlan or Competency.AddDevelopmentActivity or Competency.CompleteDevelopmentActivity or Competency.UpdateCompetencyLevel or Competency.IdentifySkillGaps
  } with {
    briefly "Competency command alternation"
    described as {
      |Commands accepted by the Competency entity.
    }
  }
  inlet CompetencyCommands is type CompetencyCommand  outlet CompetencyEvents2 is type CompetencyEvent
  query GetCompetency replies result CompetencyResult is {
    competencyId: CompetencyId with {
      briefly "ID"
      described as {
        |Identifier of the Competency to retrieve.
      }
    }
  } with {
    briefly "Get Competency"
    described as {
      |Retrieve Competency data by identifier.
    }
  }
  result CompetencyResult is {
    competencyId: CompetencyId with {
      briefly "Competency addressed"
      described as {
        |Which competency this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    competencyData: Competency.CompetencyLibraryData with {
      briefly "Competency data"
      described as {
        |The requested Competency data.
      }
    }
  } with {
    briefly "Competency result"
    described as {
      |Result carrying the requested Competency data.
    }
  }
  // Commands
  command CreateCompetency is {
    competencyId: CompetencyId with {
      briefly "Competency ID"
      described as {
        |New competency identifier.
      }
    }
    definition: CompetencyDefinition with {
      briefly "Definition"
      described as {
        |Competency definition.
      }
    }
  } with {
    briefly "Create competency"
    described as {
      |Creates a new competency definition.
    }
  }
  command UpdateCompetency is {
    competencyId: CompetencyId with {
      briefly "Competency ID"
      described as {
        |Competency to update.
      }
    }
    definition: CompetencyDefinition with {
      briefly "Definition"
      described as {
        |Updated definition.
      }
    }
  } with {
    briefly "Update competency"
    described as {
      |Updates competency definition.
    }
  }
  command CreateFramework is {
    competencyId: CompetencyId with {
      briefly "Competency ID"
      described as {
        |Identifies the Competency instance this message addresses.
      }
    }
    framework: CompetencyFramework with {
      briefly "Framework"
      described as {
        |Framework to create.
      }
    }
  } with {
    briefly "Create framework"
    described as {
      |Creates competency framework.
    }
  }
  command AssignCompetency is {
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    competencyId: CompetencyId with {
      briefly "Competency"
      described as {
        |Competency ID.
      }
    }
    targetLevel: CompetencyLevel with {
      briefly "Target"
      described as {
        |Target level.
      }
    }
  } with {
    briefly "Assign competency"
    described as {
      |Assigns competency requirement to employee.
    }
  }
  command RecordAssessment is {
    competencyId: CompetencyId with {
      briefly "Competency ID"
      described as {
        |Identifies the Competency instance this message addresses.
      }
    }
    assessment: CompetencyAssessment with {
      briefly "Assessment"
      described as {
        |Assessment details.
      }
    }
  } with {
    briefly "Record assessment"
    described as {
      |Records competency assessment.
    }
  }
  command UpdateAssessmentStatus is {
    competencyId: CompetencyId with {
      briefly "Competency ID"
      described as {
        |Identifies the Competency instance this message addresses.
      }
    }
    assessmentId: AssessmentId with {
      briefly "Assessment ID"
      described as {
        |Assessment to update.
      }
    }
    status: AssessmentStatus with {
      briefly "Status"
      described as {
        |New status.
      }
    }
  } with {
    briefly "Update assessment"
    described as {
      |Updates assessment status.
    }
  }
  command CreateDevelopmentPlan is {
    competencyId: CompetencyId with {
      briefly "Competency ID"
      described as {
        |Identifies the Competency instance this message addresses.
      }
    }
    plan: DevelopmentPlan with {
      briefly "Plan"
      described as {
        |Development plan.
      }
    }
  } with {
    briefly "Create plan"
    described as {
      |Creates development plan.
    }
  }
  command AddDevelopmentActivity is {
    competencyId: CompetencyId with {
      briefly "Competency ID"
      described as {
        |Identifies the Competency instance this message addresses.
      }
    }
    planId: DevelopmentPlanId with {
      briefly "Plan ID"
      described as {
        |Plan ID.
      }
    }
    activity: DevelopmentActivity with {
      briefly "Activity"
      described as {
        |Activity to add.
      }
    }
  } with {
    briefly "Add activity"
    described as {
      |Adds development activity.
    }
  }
  command CompleteDevelopmentActivity is {
    competencyId: CompetencyId with {
      briefly "Competency ID"
      described as {
        |Identifies the Competency instance this message addresses.
      }
    }
    planId: DevelopmentPlanId with {
      briefly "Plan ID"
      described as {
        |Plan ID.
      }
    }
    activityId: UUID with {
      briefly "Activity ID"
      described as {
        |Activity to complete.
      }
    }
    outcome: String(1,1000)? with {
      briefly "Outcome"
      described as {
        |Activity outcome.
      }
    }
  } with {
    briefly "Complete activity"
    described as {
      |Marks activity as completed.
    }
  }
  command UpdateCompetencyLevel is {
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    competencyId: CompetencyId with {
      briefly "Competency"
      described as {
        |Competency ID.
      }
    }
    newLevel: CompetencyLevel with {
      briefly "Level"
      described as {
        |New proficiency level.
      }
    }
    evidence: String(1,1000) with {
      briefly "Evidence"
      described as {
        |Supporting evidence.
      }
    }
  } with {
    briefly "Update level"
    described as {
      |Updates employee competency level.
    }
  }
  command IdentifySkillGaps is {
    competencyId: CompetencyId with {
      briefly "Competency ID"
      described as {
        |Identifies the Competency instance this message addresses.
      }
    }
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    frameworkId: FrameworkId with {
      briefly "Framework"
      described as {
        |Reference framework.
      }
    }
  } with {
    briefly "Identify gaps"
    described as {
      |Identifies competency gaps.
    }
  }
  // Events
  event CompetencyCreated is {
    competencyId: CompetencyId with {
      briefly "Competency"
      described as {
        |Competency ID.
      }
    }
    definition: CompetencyDefinition with {
      briefly "Definition"
      described as {
        |Competency definition.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Competency was created"
    described as {
      |Emitted when competency is defined.
    }
  }
  event CompetencyUpdated is {
    competencyId: CompetencyId with {
      briefly "Competency"
      described as {
        |Competency ID.
      }
    }
    definition: CompetencyDefinition with {
      briefly "Definition"
      described as {
        |Updated definition.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Competency was updated"
    described as {
      |Emitted when competency is updated.
    }
  }
  event FrameworkCreated is {
    competencyId: CompetencyId with {
      briefly "Competency addressed"
      described as {
        |Which competency this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    framework: CompetencyFramework with {
      briefly "Framework"
      described as {
        |Created framework.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Framework was created"
    described as {
      |Emitted when framework is created.
    }
  }
  event CompetencyAssigned is {
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    competencyId: CompetencyId with {
      briefly "Competency"
      described as {
        |Competency ID.
      }
    }
    targetLevel: CompetencyLevel with {
      briefly "Target"
      described as {
        |Target level.
      }
    }
    assignedAt: TimeStamp with {
      briefly "Assigned"
      described as {
        |Assignment time.
      }
    }
  } with {
    briefly "Competency was assigned"
    described as {
      |Emitted when competency is assigned.
    }
  }
  event AssessmentRecorded is {
    competencyId: CompetencyId with {
      briefly "Competency addressed"
      described as {
        |Which competency this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    assessment: CompetencyAssessment with {
      briefly "Assessment"
      described as {
        |Assessment details.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Assessment was recorded"
    described as {
      |Emitted when assessment is completed.
    }
  }
  event AssessmentStatusUpdated is {
    competencyId: CompetencyId with {
      briefly "Competency addressed"
      described as {
        |Which competency this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    assessmentId: AssessmentId with {
      briefly "Assessment"
      described as {
        |Assessment ID.
      }
    }
    status: AssessmentStatus with {
      briefly "Status"
      described as {
        |New status.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Assessment status was updated"
    described as {
      |Emitted when assessment status changes.
    }
  }
  event DevelopmentPlanCreated is {
    competencyId: CompetencyId with {
      briefly "Competency addressed"
      described as {
        |Which competency this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    plan: DevelopmentPlan with {
      briefly "Plan"
      described as {
        |Created plan.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Plan was created"
    described as {
      |Emitted when plan is created.
    }
  }
  event DevelopmentActivityAdded is {
    competencyId: CompetencyId with {
      briefly "Competency addressed"
      described as {
        |Which competency this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    planId: DevelopmentPlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    activity: DevelopmentActivity with {
      briefly "Activity"
      described as {
        |Added activity.
      }
    }
    addedAt: TimeStamp with {
      briefly "Added"
      described as {
        |Add time.
      }
    }
  } with {
    briefly "Activity was added"
    described as {
      |Emitted when activity is added.
    }
  }
  event DevelopmentActivityCompleted is {
    competencyId: CompetencyId with {
      briefly "Competency addressed"
      described as {
        |Which competency this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    planId: DevelopmentPlanId with {
      briefly "Plan"
      described as {
        |Plan ID.
      }
    }
    activityId: UUID with {
      briefly "Activity"
      described as {
        |Activity ID.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Activity was completed"
    described as {
      |Emitted when activity is completed.
    }
  }
  event CompetencyLevelUpdated is {
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    competencyId: CompetencyId with {
      briefly "Competency"
      described as {
        |Competency ID.
      }
    }
    newLevel: CompetencyLevel with {
      briefly "Level"
      described as {
        |New level.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Level was updated"
    described as {
      |Emitted when level changes.
    }
  }
  event SkillGapsIdentified is {
    competencyId: CompetencyId with {
      briefly "Competency addressed"
      described as {
        |Which competency this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    gaps: SkillGap+ with {
      briefly "Gaps"
      described as {
        |Identified gaps.
      }
    }
    identifiedAt: TimeStamp with {
      briefly "Identified"
      described as {
        |Identification time.
      }
    }
  } with {
    briefly "Gaps were identified"
    described as {
      |Emitted when gaps are analyzed.
    }
  }
  // State Records
  record CompetencyLibraryData is {
    competencyDefinitions: CompetencyDefinition+ with {
      briefly "Competencies"
      described as {
        |All competencies.
      }
    }
    frameworks: CompetencyFramework+ with {
      briefly "Frameworks"
      described as {
        |All frameworks.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Competency library data"
    described as {
      |State data for competency library.
    }
  }
  record EmployeeCompetencyData is {
    employeeId: EmployeeId with {
      briefly "Employee"
      described as {
        |Employee ID.
      }
    }
    employeeCompetencies: EmployeeCompetency+ with {
      briefly "Competencies"
      described as {
        |Employee competencies.
      }
    }
    assessments: CompetencyAssessment+ with {
      briefly "Assessments"
      described as {
        |Assessment history.
      }
    }
    developmentPlans: DevelopmentPlan+ with {
      briefly "Plans"
      described as {
        |Development plans.
      }
    }
    gaps: SkillGap+ with {
      briefly "Gaps"
      described as {
        |Current gaps.
      }
    }
  } with {
    briefly "Employee competency data"
    described as {
      |State data for employee competencies.
    }
  }
  // States
  initial state LibraryState of record Competency.CompetencyLibraryData is {
    initial handler LibraryStateInitHandler is {
      on query GetCompetency is {
        let competencyResult: type CompetencyResult = prompt("read the competency from the store")
        reply competencyResult
      }
      on init is {
        set state LibraryState to "initialize from prior event"
      }
    } with {
      briefly "LibraryState init handler"
      described as {
        |Initializes the LibraryState state.
      }
    }
  } with {
    briefly "LibraryState state"
    described as {
      |The LibraryState state of the Competency.
    }
  }
  state EmployeeState of record Competency.EmployeeCompetencyData is {
    initial handler EmployeeStateInitHandler is {
      on init is {
        set state EmployeeState to "initialize from prior event"
      }
    } with {
      briefly "EmployeeState init handler"
      described as {
        |Initializes the EmployeeState state.
      }
    }
  } with {
    briefly "EmployeeState state"
    described as {
      |The EmployeeState state of the Competency.
    }
  }
  // Handler
  handler CompetencyHandler is {
    on createCompetency: command CreateCompetency is {
      let competencyLibraryData: type Competency.CompetencyLibraryData = prompt("the competency library data that results from create competency")
      morph entity CompetencyContext.Competency to state CompetencyContext.Competency.LibraryState with competencyLibraryData
      tell event CompetencyCreated(competencyId = createCompetency.competencyId, definition = createCompetency.definition, createdAt = prompt("the created at of this competency created")) to entity CompetencyContext.Competency
    }
    on updateCompetency: command UpdateCompetency is {
      tell event CompetencyUpdated(competencyId = updateCompetency.competencyId, definition = updateCompetency.definition, updatedAt = prompt("the updated at of this competency updated")) to entity CompetencyContext.Competency
    }
    on createFramework: command CreateFramework is {
      tell event FrameworkCreated(framework = createFramework.framework, competencyId = prompt("the competency id of this framework created"), createdAt = prompt("the created at of this framework created")) to entity CompetencyContext.Competency
    }
    on assignCompetency: command AssignCompetency is {
      tell event CompetencyAssigned(employeeId = assignCompetency.employeeId, competencyId = assignCompetency.competencyId, targetLevel = assignCompetency.targetLevel, assignedAt = prompt("the assigned at of this competency assigned")) to entity CompetencyContext.Competency
    }
    on recordAssessment: command RecordAssessment is {
      tell event AssessmentRecorded(assessment = recordAssessment.assessment, competencyId = prompt("the competency id of this assessment recorded"), recordedAt = prompt("the recorded at of this assessment recorded")) to entity CompetencyContext.Competency
    }
    on updateAssessmentStatus: command UpdateAssessmentStatus is {
      tell event AssessmentStatusUpdated(assessmentId = updateAssessmentStatus.assessmentId, status = updateAssessmentStatus.status, competencyId = prompt("the competency id of this assessment status updated"), updatedAt = prompt("the updated at of this assessment status updated")) to entity CompetencyContext.Competency
    }
    on createDevelopmentPlan: command CreateDevelopmentPlan is {
      tell event DevelopmentPlanCreated(plan = createDevelopmentPlan.plan, competencyId = prompt("the competency id of this development plan created"), createdAt = prompt("the created at of this development plan created")) to entity CompetencyContext.Competency
    }
    on addDevelopmentActivity: command AddDevelopmentActivity is {
      tell event DevelopmentActivityAdded(planId = addDevelopmentActivity.planId, activity = addDevelopmentActivity.activity, competencyId = prompt("the competency id of this development activity added"), addedAt = prompt("the added at of this development activity added")) to entity CompetencyContext.Competency
    }
    on completeDevelopmentActivity: command CompleteDevelopmentActivity is {
      tell event DevelopmentActivityCompleted(planId = completeDevelopmentActivity.planId, activityId = completeDevelopmentActivity.activityId, competencyId = prompt("the competency id of this development activity completed"), completedAt = prompt("the completed at of this development activity completed")) to entity CompetencyContext.Competency
    }
    on updateCompetencyLevel: command UpdateCompetencyLevel is {
      tell event CompetencyLevelUpdated(employeeId = updateCompetencyLevel.employeeId, competencyId = updateCompetencyLevel.competencyId, newLevel = updateCompetencyLevel.newLevel, updatedAt = prompt("the updated at of this competency level updated")) to entity CompetencyContext.Competency
    }
    on identifySkillGaps: command IdentifySkillGaps is {
      tell event SkillGapsIdentified(employeeId = identifySkillGaps.employeeId, competencyId = prompt("the competency id of this skill gaps identified"), gaps = prompt("the gaps of this skill gaps identified"), identifiedAt = prompt("the identified at of this skill gaps identified")) to entity CompetencyContext.Competency
    }
    on assessmentRecorded: event AssessmentRecorded is {
      do "apply AssessmentRecorded to the competency so it can be persisted and replayed"
    }
    on assessmentStatusUpdated: event AssessmentStatusUpdated is {
      do "apply AssessmentStatusUpdated to the competency so it can be persisted and replayed"
    }
    on competencyAssigned: event CompetencyAssigned is {
      do "apply CompetencyAssigned to the competency so it can be persisted and replayed"
    }
    on competencyCreated: event CompetencyCreated is {
      do "apply CompetencyCreated to the competency so it can be persisted and replayed"
    }
    on competencyLevelUpdated: event CompetencyLevelUpdated is {
      do "apply CompetencyLevelUpdated to the competency so it can be persisted and replayed"
    }
    on competencyUpdated: event CompetencyUpdated is {
      do "apply CompetencyUpdated to the competency so it can be persisted and replayed"
    }
    on developmentActivityAdded: event DevelopmentActivityAdded is {
      do "apply DevelopmentActivityAdded to the competency so it can be persisted and replayed"
    }
    on developmentActivityCompleted: event DevelopmentActivityCompleted is {
      do "apply DevelopmentActivityCompleted to the competency so it can be persisted and replayed"
    }
    on developmentPlanCreated: event DevelopmentPlanCreated is {
      do "apply DevelopmentPlanCreated to the competency so it can be persisted and replayed"
    }
    on frameworkCreated: event FrameworkCreated is {
      do "apply FrameworkCreated to the competency so it can be persisted and replayed"
    }
    on skillGapsIdentified: event SkillGapsIdentified is {
      do "apply SkillGapsIdentified to the competency so it can be persisted and replayed"
    }
  } with {
    briefly "Processes competency commands"
    described as {
      | Handles competency lifecycle including definition,
      | assessment, development planning, and gap analysis.
    }
  }
} with {
  briefly "Competency aggregate"
  described as {
    | The Competency entity manages competency definitions,
    | employee skills, assessments, and development plans.
  }
}
