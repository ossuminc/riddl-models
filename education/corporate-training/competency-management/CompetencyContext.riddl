// Competency Management - Competency Context
context CompetencyContext as router is {
  inlet CompetencyContextFromCareerService is command Competency.CreateDevelopmentPlan with {
    briefly "What FromCareerService makes of that service's news"
  }
  connector 'FromCareerService Intake' is from outlet CompetencyContext.FromCareerService.FromCareerServiceToCompetencyContext to inlet CompetencyContext.CompetencyContextFromCareerService with {
    briefly "What FromCareerService makes of that news, on its way in"
  }
  inlet CompetencyContextFromHRISService is command Competency.AssignCompetency with {
    briefly "What FromHRISService makes of that service's news"
  }
  connector 'FromHRISService Intake' is from outlet CompetencyContext.FromHRISService.FromHRISServiceToCompetencyContext to inlet CompetencyContext.CompetencyContextFromHRISService with {
    briefly "What FromHRISService makes of that news, on its way in"
  }
  inlet CompetencyContextFromLearningService is command Competency.CompleteDevelopmentActivity with {
    briefly "What FromLearningService makes of that service's news"
  }
  connector 'FromLearningService Intake' is from outlet CompetencyContext.FromLearningService.FromLearningServiceToCompetencyContext to inlet CompetencyContext.CompetencyContextFromLearningService with {
    briefly "What FromLearningService makes of that news, on its way in"
  }
  inlet CompetencyContextFromPerformanceService is command Competency.RecordAssessment with {
    briefly "What FromPerformanceService makes of that service's news"
  }
  connector 'FromPerformanceService Intake' is from outlet CompetencyContext.FromPerformanceService.FromPerformanceServiceToCompetencyContext to inlet CompetencyContext.CompetencyContextFromPerformanceService with {
    briefly "What FromPerformanceService makes of that news, on its way in"
  }
  inlet CompetencyCommandStreamIn is type CompetencyCommand  outlet CompetencyCommandStreamOut is type CompetencyCommand
  inlet CompetencyResultStreamIn is result Competency.CompetencyResult  outlet CompetencyResultStreamOut is result Competency.CompetencyResult
  handler CompetencyContextBoundary is {
    on createCompetency: command Competency.CreateCompetency is {
      send createCompetency to outlet CompetencyContext.CompetencyCommandStreamOut
    }
    on updateCompetency: command Competency.UpdateCompetency is {
      send updateCompetency to outlet CompetencyContext.CompetencyCommandStreamOut
    }
    on createFramework: command Competency.CreateFramework is {
      send createFramework to outlet CompetencyContext.CompetencyCommandStreamOut
    }
    on assignCompetency: command Competency.AssignCompetency is {
      send assignCompetency to outlet CompetencyContext.CompetencyCommandStreamOut
      let due: type Competency.AssessmentReminderDue = prompt("an AssessmentReminderDue naming this employee and the assessment due date it is scheduled against, to be reconsidered when that date arrives")
      send due to outlet CompetencyContext.CompetencyCommandStreamOut at assignCompetency.assessmentDueDate
    }
    on recordAssessment: command Competency.RecordAssessment is {
      send recordAssessment to outlet CompetencyContext.CompetencyCommandStreamOut
    }
    on updateAssessmentStatus: command Competency.UpdateAssessmentStatus is {
      send updateAssessmentStatus to outlet CompetencyContext.CompetencyCommandStreamOut
    }
    on createDevelopmentPlan: command Competency.CreateDevelopmentPlan is {
      send createDevelopmentPlan to outlet CompetencyContext.CompetencyCommandStreamOut
    }
    on addDevelopmentActivity: command Competency.AddDevelopmentActivity is {
      send addDevelopmentActivity to outlet CompetencyContext.CompetencyCommandStreamOut
    }
    on completeDevelopmentActivity: command Competency.CompleteDevelopmentActivity is {
      send completeDevelopmentActivity to outlet CompetencyContext.CompetencyCommandStreamOut
    }
    on updateCompetencyLevel: command Competency.UpdateCompetencyLevel is {
      send updateCompetencyLevel to outlet CompetencyContext.CompetencyCommandStreamOut
    }
    on identifySkillGaps: command Competency.IdentifySkillGaps is {
      send identifySkillGaps to outlet CompetencyContext.CompetencyCommandStreamOut
    }
    on competencyResult: result Competency.CompetencyResult is {
      send competencyResult to outlet CompetencyContext.CompetencyResultStreamOut
    }
    on other is {
      error "Unexpected message at the CompetencyContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CompetencyCommand Stream Intake' is from outlet CompetencyContext.CompetencyCommandStreamOut to inlet CompetencyContext.Competency.CompetencyCommands  connector 'CompetencyResult Stream Egress' is from outlet CompetencyContext.CompetencyRepository.CompetencyRepositoryResponses to inlet CompetencyContext.CompetencyResultStreamIn  adaptor FromCareerService from context CareerService as flow is { 
    inlet FromCareerServiceIn is event CareerService.CareerPathIdentified    outlet FromCareerServiceToCompetencyContext is command Competency.CreateDevelopmentPlan
    handler FromCareerServiceHandler is {
      on careerPathIdentified: event CareerService.CareerPathIdentified is {
        let item0: type Competency.CreateDevelopmentPlan = prompt("translate the careerPathIdentified event into a CreateDevelopmentPlan, a career path is only real once there is a plan to develop toward it")
        send item0 to outlet CompetencyContext.FromCareerService.FromCareerServiceToCompetencyContext
      }
      on other is {
        error "Unexpected message for adaptor FromCareerService"
      }
    } with {
      briefly "from career service"
      described as {
        |Carries messages from the external CareerService.
      }
    }
  } with {
    briefly "CareerService integration"
    described as {
      |The model's side of the CareerService conversation.
    }
  }
  adaptor ToCareerService to context CareerService as flow is { 
    outlet ToCareerServiceOut is command CareerService.IdentifyCareerPath
    handler ToCareerServiceHandler is {
      on skillGapsIdentified: event Competency.SkillGapsIdentified is {
        let item0: type CareerService.IdentifyCareerPath = prompt("translate the skillGapsIdentified event into a IdentifyCareerPath, a path being drawn from the gaps rather than from the role")
        send item0 to outlet CompetencyContext.ToCareerService.ToCareerServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToCareerService"
      }
    } with {
      briefly "to career service"
      described as {
        |Carries messages to the external CareerService.
      }
    }
  } with {
    briefly "CareerService integration"
    described as {
      |The model's side of the CareerService conversation.
    }
  }
  adaptor FromHRISService from context HRISService as flow is { 
    inlet FromHRISServiceIn is type HRISService.HRISServiceEvent    outlet FromHRISServiceToCompetencyContext is command Competency.AssignCompetency
    handler FromHRISServiceHandler is {
      on employeeHired: event HRISService.EmployeeHired is {
        let item0: type Competency.AssignCompetency = prompt("translate the employeeHired event into a AssignCompetency, a new hire needs the competencies their role requires before anything can be assessed")
        send item0 to outlet CompetencyContext.FromHRISService.FromHRISServiceToCompetencyContext
      }
      on employeeRoleChanged: event HRISService.EmployeeRoleChanged is {
        let item0: type Competency.AssignCompetency = prompt("translate the employeeRoleChanged event into a AssignCompetency, a changed role changes which competencies are expected")
        send item0 to outlet CompetencyContext.FromHRISService.FromHRISServiceToCompetencyContext
      }
      on other is {
        error "Unexpected message for adaptor FromHRISService"
      }
    } with {
      briefly "from hris service"
      described as {
        |Carries messages from the external HRISService.
      }
    }
  } with {
    briefly "HRISService integration"
    described as {
      |The model's side of the HRISService conversation.
    }
  }
  adaptor FromLearningService from context LearningService as flow is { 
    inlet FromLearningServiceIn is event LearningService.TrainingCompleted    outlet FromLearningServiceToCompetencyContext is command Competency.CompleteDevelopmentActivity
    handler FromLearningServiceHandler is {
      on trainingCompleted: event LearningService.TrainingCompleted is {
        let item0: type Competency.CompleteDevelopmentActivity = prompt("translate the trainingCompleted event into a CompleteDevelopmentActivity, training finished is the development activity closing")
        send item0 to outlet CompetencyContext.FromLearningService.FromLearningServiceToCompetencyContext
      }
      on other is {
        error "Unexpected message for adaptor FromLearningService"
      }
    } with {
      briefly "from learning service"
      described as {
        |Carries messages from the external LearningService.
      }
    }
  } with {
    briefly "LearningService integration"
    described as {
      |The model's side of the LearningService conversation.
    }
  }
  adaptor ToLearningService to context LearningService as flow is { 
    outlet ToLearningServiceOut is command LearningService.RecommendTraining
    handler ToLearningServiceHandler is {
      on skillGapsIdentified: event Competency.SkillGapsIdentified is {
        let item0: type LearningService.RecommendTraining = prompt("translate the skillGapsIdentified event into a RecommendTraining, the gaps being what training is chosen against")
        send item0 to outlet CompetencyContext.ToLearningService.ToLearningServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToLearningService"
      }
    } with {
      briefly "to learning service"
      described as {
        |Carries messages to the external LearningService.
      }
    }
  } with {
    briefly "LearningService integration"
    described as {
      |The model's side of the LearningService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    outlet ToNotificationServiceOut is type NotificationService.NotificationServiceCommand
    handler ToNotificationServiceHandler is {
      on assessmentReminderRaised: event Competency.AssessmentReminderRaised is {
        let reminder: type NotificationService.SendAssessmentReminder = prompt("translate the assessmentReminderRaised event into a SendAssessmentReminder telling the employee their assessment is falling due; the schedule was set when the competency was assigned and the assignment was re-checked at fire time, so this sends without deciding again")
        send reminder to outlet CompetencyContext.ToNotificationService.ToNotificationServiceOut
      }
      on developmentPlanCreated: event DevelopmentPlanCreated is {
        let notice: type NotificationService.SendDevelopmentUpdate = prompt("translate the developmentPlanCreated event into a SendDevelopmentUpdate telling the employee a development plan now exists for them and what it targets")
        send notice to outlet CompetencyContext.ToNotificationService.ToNotificationServiceOut
      }
      on skillGapsIdentified: event SkillGapsIdentified is {
        let notice: type NotificationService.SendDevelopmentUpdate = prompt("translate the skillGapsIdentified event into a SendDevelopmentUpdate telling the employee which gaps were found, since the plan's activities follow from them")
        send notice to outlet CompetencyContext.ToNotificationService.ToNotificationServiceOut
      }
      on assessmentRecorded: event AssessmentRecorded is {
        let notice: type NotificationService.SendDevelopmentUpdate = prompt("translate the assessmentRecorded event into a SendDevelopmentUpdate telling the employee their assessment result and the level they were judged at")
        send notice to outlet CompetencyContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPerformanceService from context PerformanceService as flow is { 
    inlet FromPerformanceServiceIn is type PerformanceService.PerformanceServiceEvent    outlet FromPerformanceServiceToCompetencyContext is command Competency.RecordAssessment
    handler FromPerformanceServiceHandler is {
      on goalSet: event PerformanceService.GoalSet is {
        do "goals are set in performance management; competency work follows from assessment, not from the goal"
      }
      on performanceReviewCompleted: event PerformanceService.PerformanceReviewCompleted is {
        let item0: type Competency.RecordAssessment = prompt("translate the performanceReviewCompleted event into a RecordAssessment, a completed review carries the judgement a competency assessment records")
        send item0 to outlet CompetencyContext.FromPerformanceService.FromPerformanceServiceToCompetencyContext
      }
      on other is {
        error "Unexpected message for adaptor FromPerformanceService"
      }
    } with {
      briefly "from performance service"
      described as {
        |Carries messages from the external PerformanceService.
      }
    }
  } with {
    briefly "PerformanceService integration"
    described as {
      |The model's side of the PerformanceService conversation.
    }
  }
  include "types.riddl"
  include "Competency.riddl"
  // Repository for competency persistence
  type CompetencyRepositoryCommand is one of {
    CompetencyContext.CompetencyRepository.PersistAssessmentRecorded or CompetencyContext.CompetencyRepository.PersistAssessmentStatusUpdated or CompetencyContext.CompetencyRepository.PersistCompetencyAssigned or CompetencyContext.CompetencyRepository.PersistCompetencyCreated or CompetencyContext.CompetencyRepository.PersistCompetencyLevelUpdated or CompetencyContext.CompetencyRepository.PersistCompetencyUpdated or CompetencyContext.CompetencyRepository.PersistDevelopmentActivityAdded or CompetencyContext.CompetencyRepository.PersistDevelopmentActivityCompleted or CompetencyContext.CompetencyRepository.PersistDevelopmentPlanCreated or CompetencyContext.CompetencyRepository.PersistFrameworkCreated or CompetencyContext.CompetencyRepository.PersistSkillGapsIdentified
  } with {
    briefly "Anything that writes CompetencyRepository"
    described as {
      |The persistence commands CompetencyRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository CompetencyRepository as flow is {
    inlet CompetencyRepositoryFromCompetencyAnalytics is type CompetencyRepositoryCommand    command PersistAssessmentStatusUpdated is {
      competencyId: CompetencyId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssessmentStatusUpdated applies to.
        }
      }
    } with {
      briefly "Persist AssessmentStatusUpdated"
      described as {
        |Instructs this repository to apply AssessmentStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCompetencyCreated is {
      competencyId: CompetencyId with {
        briefly "Row addressed"
        described as {
          |Which stored row CompetencyCreated applies to.
        }
      }
    } with {
      briefly "Persist CompetencyCreated"
      described as {
        |Instructs this repository to apply CompetencyCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCompetencyUpdated is {
      competencyId: CompetencyId with {
        briefly "Row addressed"
        described as {
          |Which stored row CompetencyUpdated applies to.
        }
      }
    } with {
      briefly "Persist CompetencyUpdated"
      described as {
        |Instructs this repository to apply CompetencyUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDevelopmentActivityAdded is {
      competencyId: CompetencyId with {
        briefly "Row addressed"
        described as {
          |Which stored row DevelopmentActivityAdded applies to.
        }
      }
    } with {
      briefly "Persist DevelopmentActivityAdded"
      described as {
        |Instructs this repository to apply DevelopmentActivityAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDevelopmentActivityCompleted is {
      competencyId: CompetencyId with {
        briefly "Row addressed"
        described as {
          |Which stored row DevelopmentActivityCompleted applies to.
        }
      }
    } with {
      briefly "Persist DevelopmentActivityCompleted"
      described as {
        |Instructs this repository to apply DevelopmentActivityCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDevelopmentPlanCreated is {
      competencyId: CompetencyId with {
        briefly "Row addressed"
        described as {
          |Which stored row DevelopmentPlanCreated applies to.
        }
      }
    } with {
      briefly "Persist DevelopmentPlanCreated"
      described as {
        |Instructs this repository to apply DevelopmentPlanCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFrameworkCreated is {
      competencyId: CompetencyId with {
        briefly "Row addressed"
        described as {
          |Which stored row FrameworkCreated applies to.
        }
      }
    } with {
      briefly "Persist FrameworkCreated"
      described as {
        |Instructs this repository to apply FrameworkCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAssessmentRecorded is {
      assessment: CompetencyAssessment with {
        briefly "Row addressed"
        described as {
          |Which stored row AssessmentRecorded applies to.
        }
      }
    } with {
      briefly "Persist AssessmentRecorded"
      described as {
        |Instructs this repository to apply AssessmentRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCompetencyAssigned is {
      employeeId: EmployeeId with {
        briefly "Row addressed"
        described as {
          |Which stored row CompetencyAssigned applies to.
        }
      }
    } with {
      briefly "Persist CompetencyAssigned"
      described as {
        |Instructs this repository to apply CompetencyAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCompetencyLevelUpdated is {
      employeeId: EmployeeId with {
        briefly "Row addressed"
        described as {
          |Which stored row CompetencyLevelUpdated applies to.
        }
      }
    } with {
      briefly "Persist CompetencyLevelUpdated"
      described as {
        |Instructs this repository to apply CompetencyLevelUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSkillGapsIdentified is {
      employeeId: EmployeeId with {
        briefly "Row addressed"
        described as {
          |Which stored row SkillGapsIdentified applies to.
        }
      }
    } with {
      briefly "Persist SkillGapsIdentified"
      described as {
        |Instructs this repository to apply SkillGapsIdentified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet CompetencyRepositoryResponses is result Competency.CompetencyResult
    record StoredCompetency is {
      competencyId: CompetencyId with {
        briefly "competencyId"
        described as {
          |The competencyId column of the stored competency row.
        }
      }
      definition: CompetencyDefinition with {
        briefly "definition"
        described as {
          |The definition column of the stored competency row.
        }
      }
    } with {
      briefly "Stored competency row"
      described as {
        |The persistence shape of competency data as this repository stores it.
      }
    }
    schema CompetencyData is relational
      of competencies as record StoredCompetency
        index on field StoredCompetency.competencyId
        index on field StoredCompetency.definition.category
 with {
      briefly "Competency data schema"
      described as {
        |The relational schema holding competency data for the CompetencyRepository.
      }
    }
    handler CompetencyPersistence is {
      on persistAssessmentStatusUpdated: command PersistAssessmentStatusUpdated is {
        do "apply AssessmentStatusUpdated to the stored row"
      }
      on persistCompetencyCreated: command PersistCompetencyCreated is {
        do "apply CompetencyCreated to the stored row"
      }
      on persistCompetencyUpdated: command PersistCompetencyUpdated is {
        do "apply CompetencyUpdated to the stored row"
      }
      on persistDevelopmentActivityAdded: command PersistDevelopmentActivityAdded is {
        do "apply DevelopmentActivityAdded to the stored row"
      }
      on persistDevelopmentActivityCompleted: command PersistDevelopmentActivityCompleted is {
        do "apply DevelopmentActivityCompleted to the stored row"
      }
      on persistDevelopmentPlanCreated: command PersistDevelopmentPlanCreated is {
        do "apply DevelopmentPlanCreated to the stored row"
      }
      on persistFrameworkCreated: command PersistFrameworkCreated is {
        do "apply FrameworkCreated to the stored row"
      }
      on persistAssessmentRecorded: command PersistAssessmentRecorded is {
        do "apply AssessmentRecorded to the stored row"
      }
      on persistCompetencyAssigned: command PersistCompetencyAssigned is {
        do "apply CompetencyAssigned to the stored row"
      }
      on persistCompetencyLevelUpdated: command PersistCompetencyLevelUpdated is {
        do "apply CompetencyLevelUpdated to the stored row"
      }
      on persistSkillGapsIdentified: command PersistSkillGapsIdentified is {
        do "apply SkillGapsIdentified to the stored row"
      }
      on query GetCompetencyStats is {
        let competencyStatsView: type CompetencyStatsView = prompt("read the competency stats projection")
        reply competencyStatsView
      }
    } with {
      briefly "Persists competency commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Competency data persistence"
    described as {
      | The CompetencyRepository provides persistent storage for
      | competencies, assessments, and development plans.
    }
  }
  // Projector for competency analytics
  query GetCompetencyStats replies result CompetencyStatsView is {
    competencyStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which competency stats to retrieve.
      }
    }
  } with {
    briefly "Get competency stats"
    described as {
      |Retrieves the competency stats projection.
    }
  }
  result CompetencyStatsView is {
    competencyStats: CompetencyAnalytics.CompetencyStats with {
      briefly "Competency stats"
      described as {
        |The competency stats being returned.
      }
    }
  } with {
    briefly "Competency stats view"
    described as {
      |Read model view carrying the competency stats projection.
    }
  }
  projector CompetencyAnalytics as flow is {
    updates repository CompetencyContext.CompetencyRepository
    outlet CompetencyAnalyticsToRepository is type CompetencyRepositoryCommand
    inlet CompetencyAnalyticsFromCompetency is type CompetencyEvent    record CompetencyStats is {
      competencyId: CompetencyId with {
        briefly "Competency"
        described as {
          |Competency ID.
        }
      }
      employeeCount: Natural with {
        briefly "Employees"
        described as {
          |Employees with competency.
        }
      }
      averageLevel: Decimal(3,2) with {
        briefly "Avg level"
        described as {
          |Average proficiency.
        }
      }
      gapCount: Natural with {
        briefly "Gaps"
        described as {
          |Employees with gaps.
        }
      }
    } with {
      briefly "Competency statistics"
      described as {
        |Competency metrics.
      }
    }
    handler AnalyticsHandler is {
      on assessmentStatusUpdated: event Competency.AssessmentStatusUpdated is {
        tell command CompetencyContext.CompetencyRepository.PersistAssessmentStatusUpdated(competencyId = assessmentStatusUpdated.competencyId) to repository CompetencyContext.CompetencyRepository
        do "apply AssessmentStatusUpdated to the CompetencyAnalytics projection"
      }
      on competencyCreated: event Competency.CompetencyCreated is {
        tell command CompetencyContext.CompetencyRepository.PersistCompetencyCreated(competencyId = competencyCreated.competencyId) to repository CompetencyContext.CompetencyRepository
        do "apply CompetencyCreated to the CompetencyAnalytics projection"
      }
      on competencyUpdated: event Competency.CompetencyUpdated is {
        tell command CompetencyContext.CompetencyRepository.PersistCompetencyUpdated(competencyId = competencyUpdated.competencyId) to repository CompetencyContext.CompetencyRepository
        do "apply CompetencyUpdated to the CompetencyAnalytics projection"
      }
      on developmentActivityAdded: event Competency.DevelopmentActivityAdded is {
        tell command CompetencyContext.CompetencyRepository.PersistDevelopmentActivityAdded(competencyId = developmentActivityAdded.competencyId) to repository CompetencyContext.CompetencyRepository
        do "apply DevelopmentActivityAdded to the CompetencyAnalytics projection"
      }
      on developmentActivityCompleted: event Competency.DevelopmentActivityCompleted is {
        tell command CompetencyContext.CompetencyRepository.PersistDevelopmentActivityCompleted(competencyId = developmentActivityCompleted.competencyId) to repository CompetencyContext.CompetencyRepository
        do "apply DevelopmentActivityCompleted to the CompetencyAnalytics projection"
      }
      on developmentPlanCreated: event Competency.DevelopmentPlanCreated is {
        tell command CompetencyContext.CompetencyRepository.PersistDevelopmentPlanCreated(competencyId = developmentPlanCreated.competencyId) to repository CompetencyContext.CompetencyRepository
        do "apply DevelopmentPlanCreated to the CompetencyAnalytics projection"
      }
      on frameworkCreated: event Competency.FrameworkCreated is {
        tell command CompetencyContext.CompetencyRepository.PersistFrameworkCreated(competencyId = frameworkCreated.competencyId) to repository CompetencyContext.CompetencyRepository
        do "apply FrameworkCreated to the CompetencyAnalytics projection"
      }
      on competencyAssigned: event Competency.CompetencyAssigned is {
        tell command CompetencyContext.CompetencyRepository.PersistCompetencyAssigned(employeeId = competencyAssigned.employeeId) to repository CompetencyContext.CompetencyRepository
        do "Update employee counts"
      }
      on assessmentRecorded: event Competency.AssessmentRecorded is {
        tell command CompetencyContext.CompetencyRepository.PersistAssessmentRecorded(assessment = assessmentRecorded.assessment) to repository CompetencyContext.CompetencyRepository
        do "Update assessment metrics"
      }
      on competencyLevelUpdated: event Competency.CompetencyLevelUpdated is {
        tell command CompetencyContext.CompetencyRepository.PersistCompetencyLevelUpdated(employeeId = competencyLevelUpdated.employeeId) to repository CompetencyContext.CompetencyRepository
        do "Update level metrics"
      }
      on skillGapsIdentified: event Competency.SkillGapsIdentified is {
        tell command CompetencyContext.CompetencyRepository.PersistSkillGapsIdentified(employeeId = skillGapsIdentified.employeeId) to repository CompetencyContext.CompetencyRepository
        do "Update gap metrics"
      }
    } with {
      briefly "Maintains competency analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Competency analytics projections"
    described as {
      |Maintains competency analytics data.
    }
  }
  // ---- Event publication for Competency ----
  type CompetencyEvent is one of {
    CompetencyContext.Competency.CompetencyCreated or CompetencyContext.Competency.CompetencyUpdated or CompetencyContext.Competency.FrameworkCreated or CompetencyContext.Competency.CompetencyAssigned or CompetencyContext.Competency.AssessmentRecorded or CompetencyContext.Competency.AssessmentStatusUpdated or CompetencyContext.Competency.DevelopmentPlanCreated or CompetencyContext.Competency.DevelopmentActivityAdded or CompetencyContext.Competency.DevelopmentActivityCompleted or CompetencyContext.Competency.CompetencyLevelUpdated or CompetencyContext.Competency.SkillGapsIdentified
  } with {
    briefly "Competency event alternation"
    described as {
      |Union of all Competency events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet CompetencyEventSplit as flow is {
    inlet CompetencyEventSplitIn is type CompetencyEvent    outlet CompetencyEventSplitToCompetencyAnalytics is type CompetencyEvent
    handler CompetencyEventSplitHandler is {
      on competencyCreated: event Competency.CompetencyCreated is {
        send competencyCreated to outlet CompetencyEventSplitToCompetencyAnalytics
        tell competencyCreated to entity CompetencyContext.Competency
      }
      on competencyUpdated: event Competency.CompetencyUpdated is {
        send competencyUpdated to outlet CompetencyEventSplitToCompetencyAnalytics
        tell competencyUpdated to entity CompetencyContext.Competency
      }
      on frameworkCreated: event Competency.FrameworkCreated is {
        send frameworkCreated to outlet CompetencyEventSplitToCompetencyAnalytics
        tell frameworkCreated to entity CompetencyContext.Competency
      }
      on competencyAssigned: event Competency.CompetencyAssigned is {
        send competencyAssigned to outlet CompetencyEventSplitToCompetencyAnalytics
        tell competencyAssigned to entity CompetencyContext.Competency
      }
      on assessmentRecorded: event Competency.AssessmentRecorded is {
        send assessmentRecorded to outlet CompetencyEventSplitToCompetencyAnalytics
        tell assessmentRecorded to entity CompetencyContext.Competency
      }
      on assessmentStatusUpdated: event Competency.AssessmentStatusUpdated is {
        send assessmentStatusUpdated to outlet CompetencyEventSplitToCompetencyAnalytics
        tell assessmentStatusUpdated to entity CompetencyContext.Competency
      }
      on developmentPlanCreated: event Competency.DevelopmentPlanCreated is {
        send developmentPlanCreated to outlet CompetencyEventSplitToCompetencyAnalytics
        tell developmentPlanCreated to entity CompetencyContext.Competency
      }
      on developmentActivityAdded: event Competency.DevelopmentActivityAdded is {
        send developmentActivityAdded to outlet CompetencyEventSplitToCompetencyAnalytics
        tell developmentActivityAdded to entity CompetencyContext.Competency
      }
      on developmentActivityCompleted: event Competency.DevelopmentActivityCompleted is {
        send developmentActivityCompleted to outlet CompetencyEventSplitToCompetencyAnalytics
        tell developmentActivityCompleted to entity CompetencyContext.Competency
      }
      on competencyLevelUpdated: event Competency.CompetencyLevelUpdated is {
        send competencyLevelUpdated to outlet CompetencyEventSplitToCompetencyAnalytics
        tell competencyLevelUpdated to entity CompetencyContext.Competency
      }
      on skillGapsIdentified: event Competency.SkillGapsIdentified is {
        send skillGapsIdentified to outlet CompetencyEventSplitToCompetencyAnalytics
        tell skillGapsIdentified to entity CompetencyContext.Competency
      }
      on other is {
        error "Unexpected message for processor CompetencyEventSplit"
      }
    } with {
      briefly "Competency event fan-out handler"
      described as {
        |Delivers each Competency event to all of its consumers.
      }
    }
  } with {
    briefly "Competency event fan-out"
    described as {
      |Fans Competency events out to the repository and projectors.
    }
  }
  connector 'CompetencyEvent Stream' is from outlet CompetencyContext.Competency.CompetencyEvents2 to inlet CompetencyContext.CompetencyEventSplit.CompetencyEventSplitIn with {
    briefly "Competency events, fanned out to storage and read models"
  }
  connector 'CompetencyAnalytics Feed' is from outlet CompetencyContext.CompetencyEventSplit.CompetencyEventSplitToCompetencyAnalytics to inlet CompetencyContext.CompetencyAnalytics.CompetencyAnalyticsFromCompetency with {
    briefly "Competency events feeding the CompetencyAnalytics projection"
  }
  connector 'CompetencyAnalytics Storage' is from outlet CompetencyContext.CompetencyAnalytics.CompetencyAnalyticsToRepository to inlet CompetencyContext.CompetencyRepository.CompetencyRepositoryFromCompetencyAnalytics with {
    briefly "CompetencyAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for competency management"
  described as {
    | The CompetencyContext is the bounded context for employee
    | skills, competency frameworks, and development tracking.
  }
}
