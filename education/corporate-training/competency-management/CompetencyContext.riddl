// Competency Management - Competency Context
context CompetencyContext is {
  adaptor FromCareerService from context CareerService is {
    handler FromCareerServiceHandler is {
      on event CareerService.CareerPathIdentified is {
        do "the model receives career path identified"
      }
      on other is {
        error "Unexpected message for adaptor FromCareerService"
      }
    } with {
      briefly "from career service"
      described as {
        |Carries messages from the external CareerService.
      }
    }
  } with {
      briefly "CareerService integration"
    described as {
      |The model's side of the CareerService conversation.
    }
  }
  adaptor ToCareerService to context CareerService is {
    handler ToCareerServiceHandler is {
      on command CareerService.IdentifyCareerPath is {
        do "the model sends identify career path"
      }
      on other is {
        error "Unexpected message for adaptor ToCareerService"
      }
    } with {
      briefly "to career service"
      described as {
        |Carries messages to the external CareerService.
      }
    }
  } with {
      briefly "CareerService integration"
    described as {
      |The model's side of the CareerService conversation.
    }
  }
  adaptor FromHRISService from context HRISService is {
    handler FromHRISServiceHandler is {
      on event HRISService.EmployeeHired is {
        do "the model receives employee hired"
      }
      on event HRISService.EmployeeRoleChanged is {
        do "the model receives employee role changed"
      }
      on other is {
        error "Unexpected message for adaptor FromHRISService"
      }
    } with {
      briefly "from hris service"
      described as {
        |Carries messages from the external HRISService.
      }
    }
  } with {
      briefly "HRISService integration"
    described as {
      |The model's side of the HRISService conversation.
    }
  }
  adaptor FromLearningService from context LearningService is {
    handler FromLearningServiceHandler is {
      on event LearningService.TrainingCompleted is {
        do "the model receives training completed"
      }
      on other is {
        error "Unexpected message for adaptor FromLearningService"
      }
    } with {
      briefly "from learning service"
      described as {
        |Carries messages from the external LearningService.
      }
    }
  } with {
      briefly "LearningService integration"
    described as {
      |The model's side of the LearningService conversation.
    }
  }
  adaptor ToLearningService to context LearningService is {
    handler ToLearningServiceHandler is {
      on command LearningService.RecommendTraining is {
        do "the model sends recommend training"
      }
      on other is {
        error "Unexpected message for adaptor ToLearningService"
      }
    } with {
      briefly "to learning service"
      described as {
        |Carries messages to the external LearningService.
      }
    }
  } with {
      briefly "LearningService integration"
    described as {
      |The model's side of the LearningService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is {
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is {
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendAssessmentReminder is {
        do "the model sends send assessment reminder"
      }
      on command NotificationService.SendDevelopmentUpdate is {
        do "the model sends send development update"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPerformanceService from context PerformanceService is {
    handler FromPerformanceServiceHandler is {
      on event PerformanceService.GoalSet is {
        do "the model receives goal set"
      }
      on event PerformanceService.PerformanceReviewCompleted is {
        do "the model receives performance review completed"
      }
      on other is {
        error "Unexpected message for adaptor FromPerformanceService"
      }
    } with {
      briefly "from performance service"
      described as {
        |Carries messages from the external PerformanceService.
      }
    }
  } with {
      briefly "PerformanceService integration"
    described as {
      |The model's side of the PerformanceService conversation.
    }
  }
  include "types.riddl"
  include "Competency.riddl"
  // Repository for competency persistence
  repository CompetencyRepository is {
    inlet CompetencyRepositoryFromCompetency is type CompetencyEvent
    inlet CompetencyRepositoryFromCompetencyAnalytics is type CompetencyEvent
    outlet CompetencyRepositoryResponses is type Competency.CompetencyResult
    record StoredCompetency is {
      competencyId: CompetencyId with {
        briefly "competencyId"
        described as {
          |The competencyId column of the stored competency row.
        }
      }
      definition: CompetencyDefinition with {
        briefly "definition"
        described as {
          |The definition column of the stored competency row.
        }
      }
    } with {
      briefly "Stored competency row"
      described as {
        |The persistence shape of competency data as this repository stores it.
      }
    }
    schema CompetencyData is relational
      of competencies as type StoredCompetency
        index on field StoredCompetency.competencyId
        index on field StoredCompetency.definition.category
      with {
      briefly "Competency data schema"
      described as {
        |The relational schema holding competency data for the CompetencyRepository.
      }
    }

    handler CompetencyPersistence is {
      on command Competency.CreateCompetency is {
        tell event Competency.CompetencyCreated to entity CompetencyContext.Competency
        do "Store competency definition"
      }
      on command Competency.UpdateCompetency is {
        tell event Competency.CompetencyUpdated to entity CompetencyContext.Competency
        do "Update competency definition"
      }
      on command Competency.CreateFramework is {
        tell event Competency.FrameworkCreated to entity CompetencyContext.Competency
        do "Store framework"
      }
      on command Competency.AssignCompetency is {
        tell event Competency.CompetencyAssigned to entity CompetencyContext.Competency
        do "Store employee assignment"
      }
      on command Competency.RecordAssessment is {
        tell event Competency.AssessmentRecorded to entity CompetencyContext.Competency
        do "Store assessment record"
      }
      on command Competency.CreateDevelopmentPlan is {
        tell event Competency.DevelopmentPlanCreated to entity CompetencyContext.Competency
        do "Store development plan"
      }
      on command Competency.CompleteDevelopmentActivity is {
        tell event Competency.DevelopmentActivityCompleted to entity CompetencyContext.Competency
        do "Update activity status"
      }
      on command Competency.UpdateCompetencyLevel is {
        tell event Competency.CompetencyLevelUpdated to entity CompetencyContext.Competency
        do "Update employee level"
      }
      on command Competency.IdentifySkillGaps is {
        do "Store gap analysis"
      }
    } with {
      briefly "Persists competency commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Competency data persistence"
    described as {
      | The CompetencyRepository provides persistent storage for
      | competencies, assessments, and development plans.
    }
  }
  // Projector for competency analytics
  projector CompetencyAnalytics is {
    inlet CompetencyAnalyticsFromCompetency is type CompetencyEvent
    outlet CompetencyAnalyticsOut is type CompetencyEvent
    updates repository CompetencyContext.CompetencyRepository
    record CompetencyStats is  {
      competencyId: CompetencyId with {
        briefly "Competency"
        described as {
          |Competency ID.
        }
      }
      employeeCount: Natural with {
        briefly "Employees"
        described as {
          |Employees with competency.
        }
      }
      averageLevel: Decimal(3,2) with {
        briefly "Avg level"
        described as {
          |Average proficiency.
        }
      }
      gapCount: Natural with {
        briefly "Gaps"
        described as {
          |Employees with gaps.
        }
      }
    } with {
      briefly "Competency statistics"
      described as {
        |Competency metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Competency.CompetencyAssigned is {
        tell event Competency.CompetencyAssigned to repository CompetencyContext.CompetencyRepository
        do "Update employee counts"
      }
      on event Competency.AssessmentRecorded is {
        tell event Competency.AssessmentRecorded to repository CompetencyContext.CompetencyRepository
        do "Update assessment metrics"
      }
      on event Competency.CompetencyLevelUpdated is {
        tell event Competency.CompetencyLevelUpdated to repository CompetencyContext.CompetencyRepository
        do "Update level metrics"
      }
      on event Competency.SkillGapsIdentified is {
        tell event Competency.SkillGapsIdentified to repository CompetencyContext.CompetencyRepository
        do "Update gap metrics"
      }
    } with {
      briefly "Maintains competency analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Competency analytics projections"
    described as {
      |Maintains competency analytics data.
    }
  }
  // ---- Event publication for Competency ----
  type CompetencyEvent is one of {
    CompetencyContext.Competency.CompetencyCreated,
    CompetencyContext.Competency.CompetencyUpdated,
    CompetencyContext.Competency.FrameworkCreated,
    CompetencyContext.Competency.CompetencyAssigned,
    CompetencyContext.Competency.AssessmentRecorded,
    CompetencyContext.Competency.AssessmentStatusUpdated,
    CompetencyContext.Competency.DevelopmentPlanCreated,
    CompetencyContext.Competency.DevelopmentActivityAdded,
    CompetencyContext.Competency.DevelopmentActivityCompleted,
    CompetencyContext.Competency.CompetencyLevelUpdated,
    CompetencyContext.Competency.SkillGapsIdentified
  } with {
    briefly "Competency event alternation"
    described as {
      |Union of all Competency events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CompetencyEventSource as source is {
    outlet CompetencyEvents is type CompetencyEvent
    handler CompetencySourceHandler is {
      on event Competency.CompetencyCreated is {
        send event Competency.CompetencyCreated to outlet CompetencyEvents
      }
      on event Competency.CompetencyUpdated is {
        send event Competency.CompetencyUpdated to outlet CompetencyEvents
      }
      on event Competency.FrameworkCreated is {
        send event Competency.FrameworkCreated to outlet CompetencyEvents
      }
      on event Competency.CompetencyAssigned is {
        send event Competency.CompetencyAssigned to outlet CompetencyEvents
      }
      on event Competency.AssessmentRecorded is {
        send event Competency.AssessmentRecorded to outlet CompetencyEvents
      }
      on event Competency.AssessmentStatusUpdated is {
        send event Competency.AssessmentStatusUpdated to outlet CompetencyEvents
      }
      on event Competency.DevelopmentPlanCreated is {
        send event Competency.DevelopmentPlanCreated to outlet CompetencyEvents
      }
      on event Competency.DevelopmentActivityAdded is {
        send event Competency.DevelopmentActivityAdded to outlet CompetencyEvents
      }
      on event Competency.DevelopmentActivityCompleted is {
        send event Competency.DevelopmentActivityCompleted to outlet CompetencyEvents
      }
      on event Competency.CompetencyLevelUpdated is {
        send event Competency.CompetencyLevelUpdated to outlet CompetencyEvents
      }
      on event Competency.SkillGapsIdentified is {
        send event Competency.SkillGapsIdentified to outlet CompetencyEvents
      }
      on other is {
        error "Unexpected message for source CompetencyEventSource"
      }
    } with {
      briefly "Competency source handler"
      described as {
        |Publishes Competency events onto the outlet.
      }
    }
  } with {
    briefly "Competency event source"
    described as {
      |Publishes Competency entity events into the streaming topology.
    }
  }
  processor CompetencyEventSink as sink is {
    inlet CompetencyInlet is type CompetencyEvent
    handler CompetencySinkHandler is {
      on event Competency.CompetencyCreated is {
        tell event Competency.CompetencyCreated to repository CompetencyContext.CompetencyRepository
      }
      on event Competency.CompetencyUpdated is {
        tell event Competency.CompetencyUpdated to repository CompetencyContext.CompetencyRepository
      }
      on event Competency.FrameworkCreated is {
        tell event Competency.FrameworkCreated to repository CompetencyContext.CompetencyRepository
      }
      on event Competency.CompetencyAssigned is {
        tell event Competency.CompetencyAssigned to repository CompetencyContext.CompetencyRepository
      }
      on event Competency.AssessmentRecorded is {
        tell event Competency.AssessmentRecorded to repository CompetencyContext.CompetencyRepository
      }
      on event Competency.AssessmentStatusUpdated is {
        tell event Competency.AssessmentStatusUpdated to repository CompetencyContext.CompetencyRepository
      }
      on event Competency.DevelopmentPlanCreated is {
        tell event Competency.DevelopmentPlanCreated to repository CompetencyContext.CompetencyRepository
      }
      on event Competency.DevelopmentActivityAdded is {
        tell event Competency.DevelopmentActivityAdded to repository CompetencyContext.CompetencyRepository
      }
      on event Competency.DevelopmentActivityCompleted is {
        tell event Competency.DevelopmentActivityCompleted to repository CompetencyContext.CompetencyRepository
      }
      on event Competency.CompetencyLevelUpdated is {
        tell event Competency.CompetencyLevelUpdated to repository CompetencyContext.CompetencyRepository
      }
      on event Competency.SkillGapsIdentified is {
        tell event Competency.SkillGapsIdentified to repository CompetencyContext.CompetencyRepository
      }
      on other is {
        error "Unexpected message for sink CompetencyEventSink"
      }
    } with {
      briefly "Competency sink handler"
      described as {
        |Persists Competency events via the repository.
      }
    }
  } with {
    briefly "Competency event sink"
    described as {
      |Receives Competency events for persistence.
    }
  }
  connector CompetencyEventFlow is {
    from outlet CompetencyContext.CompetencyEventSource.CompetencyEvents to
      inlet CompetencyContext.CompetencyEventSink.CompetencyInlet
  } with {
    briefly "Competency event flow"
    described as {
      |Connects the Competency source to its sink.
    }
  }
  processor CompetencyEventSplit is {
    inlet CompetencyEventSplitIn is type CompetencyEvent
    outlet CompetencyEventSplitToCompetencyRepository is type CompetencyEvent
    outlet CompetencyEventSplitToCompetencyAnalytics is type CompetencyEvent
    handler CompetencyEventSplitHandler is {
      on event Competency.CompetencyCreated is {
        send event Competency.CompetencyCreated to outlet CompetencyEventSplitToCompetencyRepository
        send event Competency.CompetencyCreated to outlet CompetencyEventSplitToCompetencyAnalytics
        tell event Competency.CompetencyCreated to entity CompetencyContext.Competency
      }
      on event Competency.CompetencyUpdated is {
        send event Competency.CompetencyUpdated to outlet CompetencyEventSplitToCompetencyRepository
        send event Competency.CompetencyUpdated to outlet CompetencyEventSplitToCompetencyAnalytics
        tell event Competency.CompetencyUpdated to entity CompetencyContext.Competency
      }
      on event Competency.FrameworkCreated is {
        send event Competency.FrameworkCreated to outlet CompetencyEventSplitToCompetencyRepository
        send event Competency.FrameworkCreated to outlet CompetencyEventSplitToCompetencyAnalytics
        tell event Competency.FrameworkCreated to entity CompetencyContext.Competency
      }
      on event Competency.CompetencyAssigned is {
        send event Competency.CompetencyAssigned to outlet CompetencyEventSplitToCompetencyRepository
        send event Competency.CompetencyAssigned to outlet CompetencyEventSplitToCompetencyAnalytics
        tell event Competency.CompetencyAssigned to entity CompetencyContext.Competency
      }
      on event Competency.AssessmentRecorded is {
        send event Competency.AssessmentRecorded to outlet CompetencyEventSplitToCompetencyRepository
        send event Competency.AssessmentRecorded to outlet CompetencyEventSplitToCompetencyAnalytics
        tell event Competency.AssessmentRecorded to entity CompetencyContext.Competency
      }
      on event Competency.AssessmentStatusUpdated is {
        send event Competency.AssessmentStatusUpdated to outlet CompetencyEventSplitToCompetencyRepository
        send event Competency.AssessmentStatusUpdated to outlet CompetencyEventSplitToCompetencyAnalytics
        tell event Competency.AssessmentStatusUpdated to entity CompetencyContext.Competency
      }
      on event Competency.DevelopmentPlanCreated is {
        send event Competency.DevelopmentPlanCreated to outlet CompetencyEventSplitToCompetencyRepository
        send event Competency.DevelopmentPlanCreated to outlet CompetencyEventSplitToCompetencyAnalytics
        tell event Competency.DevelopmentPlanCreated to entity CompetencyContext.Competency
      }
      on event Competency.DevelopmentActivityAdded is {
        send event Competency.DevelopmentActivityAdded to outlet CompetencyEventSplitToCompetencyRepository
        send event Competency.DevelopmentActivityAdded to outlet CompetencyEventSplitToCompetencyAnalytics
        tell event Competency.DevelopmentActivityAdded to entity CompetencyContext.Competency
      }
      on event Competency.DevelopmentActivityCompleted is {
        send event Competency.DevelopmentActivityCompleted to outlet CompetencyEventSplitToCompetencyRepository
        send event Competency.DevelopmentActivityCompleted to outlet CompetencyEventSplitToCompetencyAnalytics
        tell event Competency.DevelopmentActivityCompleted to entity CompetencyContext.Competency
      }
      on event Competency.CompetencyLevelUpdated is {
        send event Competency.CompetencyLevelUpdated to outlet CompetencyEventSplitToCompetencyRepository
        send event Competency.CompetencyLevelUpdated to outlet CompetencyEventSplitToCompetencyAnalytics
        tell event Competency.CompetencyLevelUpdated to entity CompetencyContext.Competency
      }
      on event Competency.SkillGapsIdentified is {
        send event Competency.SkillGapsIdentified to outlet CompetencyEventSplitToCompetencyRepository
        send event Competency.SkillGapsIdentified to outlet CompetencyEventSplitToCompetencyAnalytics
        tell event Competency.SkillGapsIdentified to entity CompetencyContext.Competency
      }
      on other is {
        error "Unexpected message for processor CompetencyEventSplit"
      }
    } with {
      briefly "Competency event fan-out handler"
      described as {
        |Delivers each Competency event to all of its consumers.
      }
    }
  } with {
    briefly "Competency event fan-out"
    described as {
      |Fans Competency events out to the repository and projectors.
    }
  }
  connector LinkCompetencyToCompetencyEventSplit is {
    from outlet CompetencyContext.Competency.CompetencyEvents2 to
      inlet CompetencyContext.CompetencyEventSplit.CompetencyEventSplitIn
  } with {
    briefly "LinkCompetencyToCompetencyEventSplit"
  }
  connector LinkCompetencyEventSplitToCompetencyRepository is {
    from outlet CompetencyContext.CompetencyEventSplit.CompetencyEventSplitToCompetencyRepository to
      inlet CompetencyContext.CompetencyRepository.CompetencyRepositoryFromCompetency
  } with {
    briefly "LinkCompetencyEventSplitToCompetencyRepository"
  }
  connector LinkCompetencyEventSplitToCompetencyAnalytics is {
    from outlet CompetencyContext.CompetencyEventSplit.CompetencyEventSplitToCompetencyAnalytics to
      inlet CompetencyContext.CompetencyAnalytics.CompetencyAnalyticsFromCompetency
  } with {
    briefly "LinkCompetencyEventSplitToCompetencyAnalytics"
  }
  connector LinkCompetencyAnalyticsToCompetencyRepository is {
    from outlet CompetencyContext.CompetencyAnalytics.CompetencyAnalyticsOut to
      inlet CompetencyContext.CompetencyRepository.CompetencyRepositoryFromCompetencyAnalytics
  } with {
    briefly "LinkCompetencyAnalyticsToCompetencyRepository"
  }
} with {
  briefly "Bounded context for competency management"
  described as {
    | The CompetencyContext is the bounded context for employee
    | skills, competency frameworks, and development tracking.
  }
}
