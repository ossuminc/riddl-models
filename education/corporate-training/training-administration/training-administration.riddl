// Training Administration Domain Model
// Corporate training programs, scheduling, and compliance tracking
domain TrainingAdministration is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user TrainingAdmin is "administrator managing training programs" with {
    briefly "Training Admin"
    described as {
      |Staff managing corporate training.
    }
  }
  user Trainer is "instructor delivering training sessions" with {
    briefly "Trainer"
    described as {
      |Person delivering training content.
    }
  }
  user Trainee is "employee taking training courses" with {
    briefly "Trainee"
    described as {
      |Person receiving training.
    }
  }
  epic TrainingDeliveryEpic is {
    user Trainee wants to "to complete required training" so that "they can meet compliance and development requirements"
    case CompleteTrainingSession is {
      user Trainee wants to "to attend and complete a training session" so that "they can record training completion"
      step is "Trainee registers" "for scheduled session" "based on availability" with {
        briefly "Register"
        described as {
          |Trainee signs up.
        }
      }
      step is "System confirms" "registration and sends" "session details" with {
        briefly "Confirm"
        described as {
          |Registration confirmed.
        }
      }
      step take input TrainingAdministrationApp.TrainingAdministrationScreen.RecordAttendanceInput from user Trainer with {
        briefly "Record attendance"
        described as {
          |Mark participation.
        }
      }
      step is "System updates" "training records" "and compliance status" with {
        briefly "Update records"
        described as {
          |Records are updated.
        }
      }
    } with {
      briefly "Training session workflow"
      described as {
        |Standard flow for training session completion.
      }
    }
  } with {
    briefly "Training delivery processing"
    described as {
      | Epic covering training session delivery from
      | registration through completion and record keeping.
    }
  }
  include "TrainingContext.riddl"
  include "external-contexts.riddl"
  application context TrainingAdministrationApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in TrainingAdministration are delivered.
      }
    }
    group TrainingAdministrationScreen is {
      input RecordAttendanceInput acquires command TrainingContext.Training.RecordAttendance with {
        briefly "Record attendance control"
        described as {
          |The control through which a user submits the record attendance request.
        }
      }
    } with {
      briefly "Training administration screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppTrainingCommands is type TrainingContext.Training.TrainingCommand
    inlet AppTrainingRepositoryResponses is type TrainingContext.Training.TrainingResult    handler TrainingAdministrationAppHandler is {
      on other is {
        error "Unexpected message for application context TrainingAdministrationApp"
      }
    } with {
      briefly "TrainingAdministrationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "TrainingAdministrationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'TrainingCommand Stream' is from outlet TrainingAdministrationApp.AppTrainingCommands to inlet TrainingContext.Training.TrainingCommands with {
    option persistent()
    briefly "Training commands from the application"
  }
  connector 'TrainingResult Stream' is from outlet TrainingContext.TrainingRepository.TrainingRepositoryResponses to inlet TrainingAdministrationApp.AppTrainingRepositoryResponses with {
    option persistent()
    briefly "Training query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet TrainingAdministrationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Training administration domain"
  described as {
    | The TrainingAdministration domain handles corporate training
    | programs, scheduling, delivery, and compliance tracking.
  }
}
