// Training Administration - Training Context
context TrainingContext is {
  adaptor FromCalendarService from context CalendarService is {
    handler FromCalendarServiceHandler is {
      on event CalendarService.CalendarEventCreated is {
        do "the model receives calendar event created"
      }
      on other is {
        error "Unexpected message for adaptor FromCalendarService"
      }
    } with {
      briefly "from calendar service"
      described as {
        |Carries messages from the external CalendarService.
      }
    }
  } with {
      briefly "CalendarService integration"
    described as {
      |The model's side of the CalendarService conversation.
    }
  }
  adaptor ToCalendarService to context CalendarService is {
    handler ToCalendarServiceHandler is {
      on command CalendarService.CreateCalendarEvent is {
        do "the model sends create calendar event"
      }
      on other is {
        error "Unexpected message for adaptor ToCalendarService"
      }
    } with {
      briefly "to calendar service"
      described as {
        |Carries messages to the external CalendarService.
      }
    }
  } with {
      briefly "CalendarService integration"
    described as {
      |The model's side of the CalendarService conversation.
    }
  }
  adaptor FromCertificateService from context CertificateService is {
    handler FromCertificateServiceHandler is {
      on event CertificateService.CertificateGenerated is {
        do "the model receives certificate generated"
      }
      on other is {
        error "Unexpected message for adaptor FromCertificateService"
      }
    } with {
      briefly "from certificate service"
      described as {
        |Carries messages from the external CertificateService.
      }
    }
  } with {
      briefly "CertificateService integration"
    described as {
      |The model's side of the CertificateService conversation.
    }
  }
  adaptor ToCertificateService to context CertificateService is {
    handler ToCertificateServiceHandler is {
      on command CertificateService.GenerateCertificate is {
        do "the model sends generate certificate"
      }
      on other is {
        error "Unexpected message for adaptor ToCertificateService"
      }
    } with {
      briefly "to certificate service"
      described as {
        |Carries messages to the external CertificateService.
      }
    }
  } with {
      briefly "CertificateService integration"
    described as {
      |The model's side of the CertificateService conversation.
    }
  }
  adaptor FromHRISService from context HRISService is {
    handler FromHRISServiceHandler is {
      on event HRISService.EmployeeDepartmentChanged is {
        do "the model receives employee department changed"
      }
      on event HRISService.EmployeeHired is {
        do "the model receives employee hired"
      }
      on other is {
        error "Unexpected message for adaptor FromHRISService"
      }
    } with {
      briefly "from hris service"
      described as {
        |Carries messages from the external HRISService.
      }
    }
  } with {
      briefly "HRISService integration"
    described as {
      |The model's side of the HRISService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is {
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is {
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendComplianceAlert is {
        do "the model sends send compliance alert"
      }
      on command NotificationService.SendSessionReminder is {
        do "the model sends send session reminder"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromRoomReservationService from context RoomReservationService is {
    handler FromRoomReservationServiceHandler is {
      on event RoomReservationService.RoomReserved is {
        do "the model receives room reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromRoomReservationService"
      }
    } with {
      briefly "from room reservation service"
      described as {
        |Carries messages from the external RoomReservationService.
      }
    }
  } with {
      briefly "RoomReservationService integration"
    described as {
      |The model's side of the RoomReservationService conversation.
    }
  }
  adaptor ToRoomReservationService to context RoomReservationService is {
    handler ToRoomReservationServiceHandler is {
      on command RoomReservationService.ReserveRoom is {
        do "the model sends reserve room"
      }
      on other is {
        error "Unexpected message for adaptor ToRoomReservationService"
      }
    } with {
      briefly "to room reservation service"
      described as {
        |Carries messages to the external RoomReservationService.
      }
    }
  } with {
      briefly "RoomReservationService integration"
    described as {
      |The model's side of the RoomReservationService conversation.
    }
  }
  adaptor FromVideoConferenceService from context VideoConferenceService is {
    handler FromVideoConferenceServiceHandler is {
      on event VideoConferenceService.MeetingCreated is {
        do "the model receives meeting created"
      }
      on other is {
        error "Unexpected message for adaptor FromVideoConferenceService"
      }
    } with {
      briefly "from video conference service"
      described as {
        |Carries messages from the external VideoConferenceService.
      }
    }
  } with {
      briefly "VideoConferenceService integration"
    described as {
      |The model's side of the VideoConferenceService conversation.
    }
  }
  adaptor ToVideoConferenceService to context VideoConferenceService is {
    handler ToVideoConferenceServiceHandler is {
      on command VideoConferenceService.CreateMeeting is {
        do "the model sends create meeting"
      }
      on other is {
        error "Unexpected message for adaptor ToVideoConferenceService"
      }
    } with {
      briefly "to video conference service"
      described as {
        |Carries messages to the external VideoConferenceService.
      }
    }
  } with {
      briefly "VideoConferenceService integration"
    described as {
      |The model's side of the VideoConferenceService conversation.
    }
  }
  include "types.riddl"
  include "Training.riddl"
  // Repository for training persistence
  repository TrainingRepository is {
    inlet TrainingRepositoryFromTraining is type TrainingEvent
    inlet TrainingRepositoryFromTrainingAnalytics is type TrainingEvent
    outlet TrainingRepositoryResponses is type Training.TrainingResult
    schema TrainingData is relational
      of trainings as type Training
        index on field Training.trainingId
        index on field Training.program.title
      with {
      briefly "Training data schema"
      described as {
        |The relational schema holding training data for the TrainingRepository.
      }
    }

    handler TrainingPersistence is {
      on command Training.CreateTrainingProgram is {
        tell event Training.TrainingProgramCreated to entity TrainingContext.Training
        do "Store training program"
      }
      on command Training.UpdateTrainingProgram is {
        tell event Training.TrainingProgramUpdated to entity TrainingContext.Training
        do "Update training program"
      }
      on command Training.ScheduleSession is {
        tell event Training.SessionScheduled to entity TrainingContext.Training
        do "Store session record"
      }
      on command Training.CancelSession is {
        tell event Training.SessionCancelled to entity TrainingContext.Training
        do "Update session status"
      }
      on command Training.RegisterTrainee is {
        do "Store registration"
      }
      on command Training.RecordAttendance is {
        tell event Training.AttendanceRecorded to entity TrainingContext.Training
        do "Update attendance record"
      }
      on command Training.CompleteSession is {
        tell event Training.SessionCompleted to entity TrainingContext.Training
        do "Update session completion"
      }
      on command Training.RecordCompletion is {
        do "Store completion record"
      }
    } with {
      briefly "Persists training commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Training data persistence"
    described as {
      | The TrainingRepository provides persistent storage for
      | training programs, sessions, and completion records.
    }
  }
  // Projector for training analytics
  projector TrainingAnalytics is {
    inlet TrainingAnalyticsFromTraining is type TrainingEvent
    outlet TrainingAnalyticsOut is type TrainingEvent
    updates repository TrainingContext.TrainingRepository
    record TrainingStats is  {
      trainingId: TrainingId with {
        briefly "Training"
        described as {
          |Training ID.
        }
      }
      totalSessions: Natural with {
        briefly "Sessions"
        described as {
          |Total sessions.
        }
      }
      totalEnrollments: Natural with {
        briefly "Enrollments"
        described as {
          |Total enrolled.
        }
      }
      completionRate: Decimal(5,2) with {
        briefly "Completion"
        described as {
          |Completion rate.
        }
      }
      averageScore: Decimal(5,2) with {
        briefly "Avg score"
        described as {
          |Average score.
        }
      }
    } with {
      briefly "Training statistics"
      described as {
        |Training program metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Training.SessionScheduled is {
        tell event Training.SessionScheduled to repository TrainingContext.TrainingRepository
        do "Update session counts"
      }
      on event Training.TraineeRegistered is {
        tell event Training.TraineeRegistered to repository TrainingContext.TrainingRepository
        do "Update enrollment counts"
      }
      on event Training.TrainingCompleted is {
        tell event Training.TrainingCompleted to repository TrainingContext.TrainingRepository
        do "Update completion metrics"
      }
      on event Training.ComplianceReportGenerated is {
        tell event Training.ComplianceReportGenerated to repository TrainingContext.TrainingRepository
        do "Store compliance metrics"
      }
    } with {
      briefly "Maintains training analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Training analytics projections"
    described as {
      |Maintains training analytics data.
    }
  }
  // ---- Event publication for Training ----
  type TrainingEvent is one of {
    TrainingContext.Training.TrainingProgramCreated,
    TrainingContext.Training.TrainingProgramUpdated,
    TrainingContext.Training.TrainingProgramActivated,
    TrainingContext.Training.TrainingProgramRetired,
    TrainingContext.Training.SessionScheduled,
    TrainingContext.Training.SessionCancelled,
    TrainingContext.Training.TraineeRegistered,
    TrainingContext.Training.RegistrationCancelled,
    TrainingContext.Training.AttendanceRecorded,
    TrainingContext.Training.SessionCompleted,
    TrainingContext.Training.TrainingCompleted,
    TrainingContext.Training.ComplianceReportGenerated
  } with {
    briefly "Training event alternation"
    described as {
      |Union of all Training events, for streaming and event-sourced
      |persistence.
    }
  }
  processor TrainingEventSource as source is {
    outlet TrainingEvents is type TrainingEvent
    handler TrainingSourceHandler is {
      on event Training.TrainingProgramCreated is {
        send event Training.TrainingProgramCreated to outlet TrainingEvents
      }
      on event Training.TrainingProgramUpdated is {
        send event Training.TrainingProgramUpdated to outlet TrainingEvents
      }
      on event Training.TrainingProgramActivated is {
        send event Training.TrainingProgramActivated to outlet TrainingEvents
      }
      on event Training.TrainingProgramRetired is {
        send event Training.TrainingProgramRetired to outlet TrainingEvents
      }
      on event Training.SessionScheduled is {
        send event Training.SessionScheduled to outlet TrainingEvents
      }
      on event Training.SessionCancelled is {
        send event Training.SessionCancelled to outlet TrainingEvents
      }
      on event Training.TraineeRegistered is {
        send event Training.TraineeRegistered to outlet TrainingEvents
      }
      on event Training.RegistrationCancelled is {
        send event Training.RegistrationCancelled to outlet TrainingEvents
      }
      on event Training.AttendanceRecorded is {
        send event Training.AttendanceRecorded to outlet TrainingEvents
      }
      on event Training.SessionCompleted is {
        send event Training.SessionCompleted to outlet TrainingEvents
      }
      on event Training.TrainingCompleted is {
        send event Training.TrainingCompleted to outlet TrainingEvents
      }
      on event Training.ComplianceReportGenerated is {
        send event Training.ComplianceReportGenerated to outlet TrainingEvents
      }
      on other is {
        error "Unexpected message for source TrainingEventSource"
      }
    } with {
      briefly "Training source handler"
      described as {
        |Publishes Training events onto the outlet.
      }
    }
  } with {
    briefly "Training event source"
    described as {
      |Publishes Training entity events into the streaming topology.
    }
  }
  processor TrainingEventSink as sink is {
    inlet TrainingInlet is type TrainingEvent
    handler TrainingSinkHandler is {
      on event Training.TrainingProgramCreated is {
        tell event Training.TrainingProgramCreated to repository TrainingContext.TrainingRepository
      }
      on event Training.TrainingProgramUpdated is {
        tell event Training.TrainingProgramUpdated to repository TrainingContext.TrainingRepository
      }
      on event Training.TrainingProgramActivated is {
        tell event Training.TrainingProgramActivated to repository TrainingContext.TrainingRepository
      }
      on event Training.TrainingProgramRetired is {
        tell event Training.TrainingProgramRetired to repository TrainingContext.TrainingRepository
      }
      on event Training.SessionScheduled is {
        tell event Training.SessionScheduled to repository TrainingContext.TrainingRepository
      }
      on event Training.SessionCancelled is {
        tell event Training.SessionCancelled to repository TrainingContext.TrainingRepository
      }
      on event Training.TraineeRegistered is {
        tell event Training.TraineeRegistered to repository TrainingContext.TrainingRepository
      }
      on event Training.RegistrationCancelled is {
        tell event Training.RegistrationCancelled to repository TrainingContext.TrainingRepository
      }
      on event Training.AttendanceRecorded is {
        tell event Training.AttendanceRecorded to repository TrainingContext.TrainingRepository
      }
      on event Training.SessionCompleted is {
        tell event Training.SessionCompleted to repository TrainingContext.TrainingRepository
      }
      on event Training.TrainingCompleted is {
        tell event Training.TrainingCompleted to repository TrainingContext.TrainingRepository
      }
      on event Training.ComplianceReportGenerated is {
        tell event Training.ComplianceReportGenerated to repository TrainingContext.TrainingRepository
      }
      on other is {
        error "Unexpected message for sink TrainingEventSink"
      }
    } with {
      briefly "Training sink handler"
      described as {
        |Persists Training events via the repository.
      }
    }
  } with {
    briefly "Training event sink"
    described as {
      |Receives Training events for persistence.
    }
  }
  connector TrainingEventFlow is {
    from outlet TrainingContext.TrainingEventSource.TrainingEvents to
      inlet TrainingContext.TrainingEventSink.TrainingInlet
  } with {
    briefly "Training event flow"
    described as {
      |Connects the Training source to its sink.
    }
  }
  processor TrainingEventSplit is {
    inlet TrainingEventSplitIn is type TrainingEvent
    outlet TrainingEventSplitToTrainingRepository is type TrainingEvent
    outlet TrainingEventSplitToTrainingAnalytics is type TrainingEvent
    handler TrainingEventSplitHandler is {
      on event Training.TrainingProgramCreated is {
        send event Training.TrainingProgramCreated to outlet TrainingEventSplitToTrainingRepository
        send event Training.TrainingProgramCreated to outlet TrainingEventSplitToTrainingAnalytics
        tell event Training.TrainingProgramCreated to entity TrainingContext.Training
      }
      on event Training.TrainingProgramUpdated is {
        send event Training.TrainingProgramUpdated to outlet TrainingEventSplitToTrainingRepository
        send event Training.TrainingProgramUpdated to outlet TrainingEventSplitToTrainingAnalytics
        tell event Training.TrainingProgramUpdated to entity TrainingContext.Training
      }
      on event Training.TrainingProgramActivated is {
        send event Training.TrainingProgramActivated to outlet TrainingEventSplitToTrainingRepository
        send event Training.TrainingProgramActivated to outlet TrainingEventSplitToTrainingAnalytics
        tell event Training.TrainingProgramActivated to entity TrainingContext.Training
      }
      on event Training.TrainingProgramRetired is {
        send event Training.TrainingProgramRetired to outlet TrainingEventSplitToTrainingRepository
        send event Training.TrainingProgramRetired to outlet TrainingEventSplitToTrainingAnalytics
        tell event Training.TrainingProgramRetired to entity TrainingContext.Training
      }
      on event Training.SessionScheduled is {
        send event Training.SessionScheduled to outlet TrainingEventSplitToTrainingRepository
        send event Training.SessionScheduled to outlet TrainingEventSplitToTrainingAnalytics
        tell event Training.SessionScheduled to entity TrainingContext.Training
      }
      on event Training.SessionCancelled is {
        send event Training.SessionCancelled to outlet TrainingEventSplitToTrainingRepository
        send event Training.SessionCancelled to outlet TrainingEventSplitToTrainingAnalytics
        tell event Training.SessionCancelled to entity TrainingContext.Training
      }
      on event Training.TraineeRegistered is {
        send event Training.TraineeRegistered to outlet TrainingEventSplitToTrainingRepository
        send event Training.TraineeRegistered to outlet TrainingEventSplitToTrainingAnalytics
        tell event Training.TraineeRegistered to entity TrainingContext.Training
      }
      on event Training.RegistrationCancelled is {
        send event Training.RegistrationCancelled to outlet TrainingEventSplitToTrainingRepository
        send event Training.RegistrationCancelled to outlet TrainingEventSplitToTrainingAnalytics
        tell event Training.RegistrationCancelled to entity TrainingContext.Training
      }
      on event Training.AttendanceRecorded is {
        send event Training.AttendanceRecorded to outlet TrainingEventSplitToTrainingRepository
        send event Training.AttendanceRecorded to outlet TrainingEventSplitToTrainingAnalytics
        tell event Training.AttendanceRecorded to entity TrainingContext.Training
      }
      on event Training.SessionCompleted is {
        send event Training.SessionCompleted to outlet TrainingEventSplitToTrainingRepository
        send event Training.SessionCompleted to outlet TrainingEventSplitToTrainingAnalytics
        tell event Training.SessionCompleted to entity TrainingContext.Training
      }
      on event Training.TrainingCompleted is {
        send event Training.TrainingCompleted to outlet TrainingEventSplitToTrainingRepository
        send event Training.TrainingCompleted to outlet TrainingEventSplitToTrainingAnalytics
        tell event Training.TrainingCompleted to entity TrainingContext.Training
      }
      on event Training.ComplianceReportGenerated is {
        send event Training.ComplianceReportGenerated to outlet TrainingEventSplitToTrainingRepository
        send event Training.ComplianceReportGenerated to outlet TrainingEventSplitToTrainingAnalytics
        tell event Training.ComplianceReportGenerated to entity TrainingContext.Training
      }
      on other is {
        error "Unexpected message for processor TrainingEventSplit"
      }
    } with {
      briefly "Training event fan-out handler"
      described as {
        |Delivers each Training event to all of its consumers.
      }
    }
  } with {
    briefly "Training event fan-out"
    described as {
      |Fans Training events out to the repository and projectors.
    }
  }
  connector LinkTrainingToTrainingEventSplit is {
    from outlet TrainingContext.Training.TrainingEvents2 to
      inlet TrainingContext.TrainingEventSplit.TrainingEventSplitIn
  } with {
    briefly "LinkTrainingToTrainingEventSplit"
  }
  connector LinkTrainingEventSplitToTrainingRepository is {
    from outlet TrainingContext.TrainingEventSplit.TrainingEventSplitToTrainingRepository to
      inlet TrainingContext.TrainingRepository.TrainingRepositoryFromTraining
  } with {
    briefly "LinkTrainingEventSplitToTrainingRepository"
  }
  connector LinkTrainingEventSplitToTrainingAnalytics is {
    from outlet TrainingContext.TrainingEventSplit.TrainingEventSplitToTrainingAnalytics to
      inlet TrainingContext.TrainingAnalytics.TrainingAnalyticsFromTraining
  } with {
    briefly "LinkTrainingEventSplitToTrainingAnalytics"
  }
  connector LinkTrainingAnalyticsToTrainingRepository is {
    from outlet TrainingContext.TrainingAnalytics.TrainingAnalyticsOut to
      inlet TrainingContext.TrainingRepository.TrainingRepositoryFromTrainingAnalytics
  } with {
    briefly "LinkTrainingAnalyticsToTrainingRepository"
  }
} with {
  briefly "Bounded context for training administration"
  described as {
    | The TrainingContext is the bounded context for corporate
    | training programs, scheduling, and compliance tracking.
  }
}
