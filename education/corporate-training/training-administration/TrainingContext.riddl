// Training Administration - Training Context
context TrainingContext as router is {
  inlet TrainingCommandStreamIn is type TrainingCommand  outlet TrainingCommandStreamOut is type TrainingCommand
  inlet TrainingResultStreamIn is result Training.TrainingResult  outlet TrainingResultStreamOut is result Training.TrainingResult
  handler TrainingContextBoundary is {
    on createTrainingProgram: command Training.CreateTrainingProgram is {
      send createTrainingProgram to outlet TrainingContext.TrainingCommandStreamOut
    }
    on updateTrainingProgram: command Training.UpdateTrainingProgram is {
      send updateTrainingProgram to outlet TrainingContext.TrainingCommandStreamOut
    }
    on activateTrainingProgram: command Training.ActivateTrainingProgram is {
      send activateTrainingProgram to outlet TrainingContext.TrainingCommandStreamOut
    }
    on retireTrainingProgram: command Training.RetireTrainingProgram is {
      send retireTrainingProgram to outlet TrainingContext.TrainingCommandStreamOut
    }
    on scheduleSession: command Training.ScheduleSession is {
      send scheduleSession to outlet TrainingContext.TrainingCommandStreamOut
    }
    on cancelSession: command Training.CancelSession is {
      send cancelSession to outlet TrainingContext.TrainingCommandStreamOut
    }
    on registerTrainee: command Training.RegisterTrainee is {
      send registerTrainee to outlet TrainingContext.TrainingCommandStreamOut
    }
    on cancelRegistration: command Training.CancelRegistration is {
      send cancelRegistration to outlet TrainingContext.TrainingCommandStreamOut
    }
    on recordAttendance: command Training.RecordAttendance is {
      send recordAttendance to outlet TrainingContext.TrainingCommandStreamOut
    }
    on completeSession: command Training.CompleteSession is {
      send completeSession to outlet TrainingContext.TrainingCommandStreamOut
    }
    on recordCompletion: command Training.RecordCompletion is {
      send recordCompletion to outlet TrainingContext.TrainingCommandStreamOut
    }
    on generateComplianceReport: command Training.GenerateComplianceReport is {
      send generateComplianceReport to outlet TrainingContext.TrainingCommandStreamOut
    }
    on trainingResult: result Training.TrainingResult is {
      send trainingResult to outlet TrainingContext.TrainingResultStreamOut
    }
    on other is {
      error "Unexpected message at the TrainingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TrainingCommand Stream Intake' is from outlet TrainingContext.TrainingCommandStreamOut to inlet TrainingContext.Training.TrainingCommands  connector 'TrainingResult Stream Egress' is from outlet TrainingContext.TrainingRepository.TrainingRepositoryResponses to inlet TrainingContext.TrainingResultStreamIn  adaptor FromCalendarService from context CalendarService is { 
    handler FromCalendarServiceHandler is {
      on event CalendarService.CalendarEventCreated is {
        do "the model receives calendar event created"
      }
      on other is {
        error "Unexpected message for adaptor FromCalendarService"
      }
    } with {
      briefly "from calendar service"
      described as {
        |Carries messages from the external CalendarService.
      }
    }
  } with {
    briefly "CalendarService integration"
    described as {
      |The model's side of the CalendarService conversation.
    }
  }
  adaptor ToCalendarService to context CalendarService is { 
    handler ToCalendarServiceHandler is {
      on command CalendarService.CreateCalendarEvent is {
        do "the model sends create calendar event"
      }
      on other is {
        error "Unexpected message for adaptor ToCalendarService"
      }
    } with {
      briefly "to calendar service"
      described as {
        |Carries messages to the external CalendarService.
      }
    }
  } with {
    briefly "CalendarService integration"
    described as {
      |The model's side of the CalendarService conversation.
    }
  }
  adaptor FromCertificateService from context CertificateService is { 
    handler FromCertificateServiceHandler is {
      on event CertificateService.CertificateGenerated is {
        do "the model receives certificate generated"
      }
      on other is {
        error "Unexpected message for adaptor FromCertificateService"
      }
    } with {
      briefly "from certificate service"
      described as {
        |Carries messages from the external CertificateService.
      }
    }
  } with {
    briefly "CertificateService integration"
    described as {
      |The model's side of the CertificateService conversation.
    }
  }
  adaptor ToCertificateService to context CertificateService is { 
    handler ToCertificateServiceHandler is {
      on command CertificateService.GenerateCertificate is {
        do "the model sends generate certificate"
      }
      on other is {
        error "Unexpected message for adaptor ToCertificateService"
      }
    } with {
      briefly "to certificate service"
      described as {
        |Carries messages to the external CertificateService.
      }
    }
  } with {
    briefly "CertificateService integration"
    described as {
      |The model's side of the CertificateService conversation.
    }
  }
  adaptor FromHRISService from context HRISService is { 
    handler FromHRISServiceHandler is {
      on event HRISService.EmployeeDepartmentChanged is {
        do "the model receives employee department changed"
      }
      on event HRISService.EmployeeHired is {
        do "the model receives employee hired"
      }
      on other is {
        error "Unexpected message for adaptor FromHRISService"
      }
    } with {
      briefly "from hris service"
      described as {
        |Carries messages from the external HRISService.
      }
    }
  } with {
    briefly "HRISService integration"
    described as {
      |The model's side of the HRISService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendComplianceAlert is {
        do "the model sends send compliance alert"
      }
      on command NotificationService.SendSessionReminder is {
        do "the model sends send session reminder"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromRoomReservationService from context RoomReservationService is { 
    handler FromRoomReservationServiceHandler is {
      on event RoomReservationService.RoomReserved is {
        do "the model receives room reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromRoomReservationService"
      }
    } with {
      briefly "from room reservation service"
      described as {
        |Carries messages from the external RoomReservationService.
      }
    }
  } with {
    briefly "RoomReservationService integration"
    described as {
      |The model's side of the RoomReservationService conversation.
    }
  }
  adaptor ToRoomReservationService to context RoomReservationService is { 
    handler ToRoomReservationServiceHandler is {
      on command RoomReservationService.ReserveRoom is {
        do "the model sends reserve room"
      }
      on other is {
        error "Unexpected message for adaptor ToRoomReservationService"
      }
    } with {
      briefly "to room reservation service"
      described as {
        |Carries messages to the external RoomReservationService.
      }
    }
  } with {
    briefly "RoomReservationService integration"
    described as {
      |The model's side of the RoomReservationService conversation.
    }
  }
  adaptor FromVideoConferenceService from context VideoConferenceService is { 
    handler FromVideoConferenceServiceHandler is {
      on event VideoConferenceService.MeetingCreated is {
        do "the model receives meeting created"
      }
      on other is {
        error "Unexpected message for adaptor FromVideoConferenceService"
      }
    } with {
      briefly "from video conference service"
      described as {
        |Carries messages from the external VideoConferenceService.
      }
    }
  } with {
    briefly "VideoConferenceService integration"
    described as {
      |The model's side of the VideoConferenceService conversation.
    }
  }
  adaptor ToVideoConferenceService to context VideoConferenceService is { 
    handler ToVideoConferenceServiceHandler is {
      on command VideoConferenceService.CreateMeeting is {
        do "the model sends create meeting"
      }
      on other is {
        error "Unexpected message for adaptor ToVideoConferenceService"
      }
    } with {
      briefly "to video conference service"
      described as {
        |Carries messages to the external VideoConferenceService.
      }
    }
  } with {
    briefly "VideoConferenceService integration"
    described as {
      |The model's side of the VideoConferenceService conversation.
    }
  }
  include "types.riddl"
  include "Training.riddl"
  // Repository for training persistence
  type TrainingRepositoryCommand is one of {
    TrainingContext.TrainingRepository.PersistAttendanceRecorded or TrainingContext.TrainingRepository.PersistComplianceReportGenerated or TrainingContext.TrainingRepository.PersistRegistrationCancelled or TrainingContext.TrainingRepository.PersistSessionCancelled or TrainingContext.TrainingRepository.PersistSessionCompleted or TrainingContext.TrainingRepository.PersistSessionScheduled or TrainingContext.TrainingRepository.PersistTraineeRegistered or TrainingContext.TrainingRepository.PersistTrainingCompleted or TrainingContext.TrainingRepository.PersistTrainingProgramActivated or TrainingContext.TrainingRepository.PersistTrainingProgramCreated or TrainingContext.TrainingRepository.PersistTrainingProgramRetired or TrainingContext.TrainingRepository.PersistTrainingProgramUpdated
  } with {
    briefly "Anything that writes TrainingRepository"
    described as {
      |The persistence commands TrainingRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository TrainingRepository as flow is {
    inlet TrainingRepositoryFromTrainingAnalytics is type TrainingRepositoryCommand    command PersistAttendanceRecorded is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row AttendanceRecorded applies to.
        }
      }
    } with {
      briefly "Persist AttendanceRecorded"
      described as {
        |Instructs this repository to apply AttendanceRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRegistrationCancelled is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row RegistrationCancelled applies to.
        }
      }
    } with {
      briefly "Persist RegistrationCancelled"
      described as {
        |Instructs this repository to apply RegistrationCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSessionCancelled is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row SessionCancelled applies to.
        }
      }
    } with {
      briefly "Persist SessionCancelled"
      described as {
        |Instructs this repository to apply SessionCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSessionCompleted is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row SessionCompleted applies to.
        }
      }
    } with {
      briefly "Persist SessionCompleted"
      described as {
        |Instructs this repository to apply SessionCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrainingProgramActivated is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrainingProgramActivated applies to.
        }
      }
    } with {
      briefly "Persist TrainingProgramActivated"
      described as {
        |Instructs this repository to apply TrainingProgramActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrainingProgramCreated is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrainingProgramCreated applies to.
        }
      }
    } with {
      briefly "Persist TrainingProgramCreated"
      described as {
        |Instructs this repository to apply TrainingProgramCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrainingProgramRetired is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrainingProgramRetired applies to.
        }
      }
    } with {
      briefly "Persist TrainingProgramRetired"
      described as {
        |Instructs this repository to apply TrainingProgramRetired to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrainingProgramUpdated is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrainingProgramUpdated applies to.
        }
      }
    } with {
      briefly "Persist TrainingProgramUpdated"
      described as {
        |Instructs this repository to apply TrainingProgramUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistComplianceReportGenerated is {
      report: ComplianceReport with {
        briefly "Row addressed"
        described as {
          |Which stored row ComplianceReportGenerated applies to.
        }
      }
    } with {
      briefly "Persist ComplianceReportGenerated"
      described as {
        |Instructs this repository to apply ComplianceReportGenerated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSessionScheduled is {
      session: TrainingSession with {
        briefly "Row addressed"
        described as {
          |Which stored row SessionScheduled applies to.
        }
      }
    } with {
      briefly "Persist SessionScheduled"
      described as {
        |Instructs this repository to apply SessionScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTraineeRegistered is {
      sessionId: SessionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TraineeRegistered applies to.
        }
      }
    } with {
      briefly "Persist TraineeRegistered"
      described as {
        |Instructs this repository to apply TraineeRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrainingCompleted is {
      traineeId: TraineeId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrainingCompleted applies to.
        }
      }
    } with {
      briefly "Persist TrainingCompleted"
      described as {
        |Instructs this repository to apply TrainingCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet TrainingRepositoryResponses is result Training.TrainingResult
    record StoredTraining is {
      trainingId: TrainingId with {
        briefly "trainingId"
        described as {
          |The trainingId column of the stored training row.
        }
      }
      program: TrainingProgram with {
        briefly "program"
        described as {
          |The program column of the stored training row.
        }
      }
    } with {
      briefly "Stored training row"
      described as {
        |The persistence shape of training data as this repository stores it.
      }
    }
    schema TrainingData is relational
      of trainings as record StoredTraining
        index on field StoredTraining.trainingId
        index on field StoredTraining.program.title
 with {
      briefly "Training data schema"
      described as {
        |The relational schema holding training data for the TrainingRepository.
      }
    }
    handler TrainingPersistence is {
      on persistAttendanceRecorded: command PersistAttendanceRecorded is {
        do "apply AttendanceRecorded to the stored row"
      }
      on persistRegistrationCancelled: command PersistRegistrationCancelled is {
        do "apply RegistrationCancelled to the stored row"
      }
      on persistSessionCancelled: command PersistSessionCancelled is {
        do "apply SessionCancelled to the stored row"
      }
      on persistSessionCompleted: command PersistSessionCompleted is {
        do "apply SessionCompleted to the stored row"
      }
      on persistTrainingProgramActivated: command PersistTrainingProgramActivated is {
        do "apply TrainingProgramActivated to the stored row"
      }
      on persistTrainingProgramCreated: command PersistTrainingProgramCreated is {
        do "apply TrainingProgramCreated to the stored row"
      }
      on persistTrainingProgramRetired: command PersistTrainingProgramRetired is {
        do "apply TrainingProgramRetired to the stored row"
      }
      on persistTrainingProgramUpdated: command PersistTrainingProgramUpdated is {
        do "apply TrainingProgramUpdated to the stored row"
      }
      on persistComplianceReportGenerated: command PersistComplianceReportGenerated is {
        do "apply ComplianceReportGenerated to the stored row"
      }
      on persistSessionScheduled: command PersistSessionScheduled is {
        do "apply SessionScheduled to the stored row"
      }
      on persistTraineeRegistered: command PersistTraineeRegistered is {
        do "apply TraineeRegistered to the stored row"
      }
      on persistTrainingCompleted: command PersistTrainingCompleted is {
        do "apply TrainingCompleted to the stored row"
      }
      on query GetTrainingStats is {
        let trainingStatsView: type TrainingStatsView = prompt("read the training stats projection")
        reply trainingStatsView
      }
    } with {
      briefly "Persists training commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Training data persistence"
    described as {
      | The TrainingRepository provides persistent storage for
      | training programs, sessions, and completion records.
    }
  }
  // Projector for training analytics
  query GetTrainingStats replies result TrainingStatsView is {
    trainingStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which training stats to retrieve.
      }
    }
  } with {
    briefly "Get training stats"
    described as {
      |Retrieves the training stats projection.
    }
  }
  result TrainingStatsView is {
    trainingStats: TrainingAnalytics.TrainingStats with {
      briefly "Training stats"
      described as {
        |The training stats being returned.
      }
    }
  } with {
    briefly "Training stats view"
    described as {
      |Read model view carrying the training stats projection.
    }
  }
  projector TrainingAnalytics as flow is {
    updates repository TrainingContext.TrainingRepository
    outlet TrainingAnalyticsToRepository is type TrainingRepositoryCommand
    inlet TrainingAnalyticsFromTraining is type TrainingEvent    record TrainingStats is {
      trainingId: TrainingId with {
        briefly "Training"
        described as {
          |Training ID.
        }
      }
      totalSessions: Natural with {
        briefly "Sessions"
        described as {
          |Total sessions.
        }
      }
      totalEnrollments: Natural with {
        briefly "Enrollments"
        described as {
          |Total enrolled.
        }
      }
      completionRate: Decimal(5,2) with {
        briefly "Completion"
        described as {
          |Completion rate.
        }
      }
      averageScore: Decimal(5,2) with {
        briefly "Avg score"
        described as {
          |Average score.
        }
      }
    } with {
      briefly "Training statistics"
      described as {
        |Training program metrics.
      }
    }
    handler AnalyticsHandler is {
      on attendanceRecorded: event Training.AttendanceRecorded is {
        tell command TrainingContext.TrainingRepository.PersistAttendanceRecorded(trainingId = attendanceRecorded.trainingId) to repository TrainingContext.TrainingRepository
        do "apply AttendanceRecorded to the TrainingAnalytics projection"
      }
      on registrationCancelled: event Training.RegistrationCancelled is {
        tell command TrainingContext.TrainingRepository.PersistRegistrationCancelled(trainingId = registrationCancelled.trainingId) to repository TrainingContext.TrainingRepository
        do "apply RegistrationCancelled to the TrainingAnalytics projection"
      }
      on sessionCancelled: event Training.SessionCancelled is {
        tell command TrainingContext.TrainingRepository.PersistSessionCancelled(trainingId = sessionCancelled.trainingId) to repository TrainingContext.TrainingRepository
        do "apply SessionCancelled to the TrainingAnalytics projection"
      }
      on sessionCompleted: event Training.SessionCompleted is {
        tell command TrainingContext.TrainingRepository.PersistSessionCompleted(trainingId = sessionCompleted.trainingId) to repository TrainingContext.TrainingRepository
        do "apply SessionCompleted to the TrainingAnalytics projection"
      }
      on trainingProgramActivated: event Training.TrainingProgramActivated is {
        tell command TrainingContext.TrainingRepository.PersistTrainingProgramActivated(trainingId = trainingProgramActivated.trainingId) to repository TrainingContext.TrainingRepository
        do "apply TrainingProgramActivated to the TrainingAnalytics projection"
      }
      on trainingProgramCreated: event Training.TrainingProgramCreated is {
        tell command TrainingContext.TrainingRepository.PersistTrainingProgramCreated(trainingId = trainingProgramCreated.trainingId) to repository TrainingContext.TrainingRepository
        do "apply TrainingProgramCreated to the TrainingAnalytics projection"
      }
      on trainingProgramRetired: event Training.TrainingProgramRetired is {
        tell command TrainingContext.TrainingRepository.PersistTrainingProgramRetired(trainingId = trainingProgramRetired.trainingId) to repository TrainingContext.TrainingRepository
        do "apply TrainingProgramRetired to the TrainingAnalytics projection"
      }
      on trainingProgramUpdated: event Training.TrainingProgramUpdated is {
        tell command TrainingContext.TrainingRepository.PersistTrainingProgramUpdated(trainingId = trainingProgramUpdated.trainingId) to repository TrainingContext.TrainingRepository
        do "apply TrainingProgramUpdated to the TrainingAnalytics projection"
      }
      on sessionScheduled: event Training.SessionScheduled is {
        tell command TrainingContext.TrainingRepository.PersistSessionScheduled(session = sessionScheduled.session) to repository TrainingContext.TrainingRepository
        do "Update session counts"
      }
      on traineeRegistered: event Training.TraineeRegistered is {
        tell command TrainingContext.TrainingRepository.PersistTraineeRegistered(sessionId = traineeRegistered.sessionId) to repository TrainingContext.TrainingRepository
        do "Update enrollment counts"
      }
      on trainingCompleted: event Training.TrainingCompleted is {
        tell command TrainingContext.TrainingRepository.PersistTrainingCompleted(traineeId = trainingCompleted.traineeId) to repository TrainingContext.TrainingRepository
        do "Update completion metrics"
      }
      on complianceReportGenerated: event Training.ComplianceReportGenerated is {
        tell command TrainingContext.TrainingRepository.PersistComplianceReportGenerated(report = complianceReportGenerated.report) to repository TrainingContext.TrainingRepository
        do "Store compliance metrics"
      }
    } with {
      briefly "Maintains training analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Training analytics projections"
    described as {
      |Maintains training analytics data.
    }
  }
  // ---- Event publication for Training ----
  type TrainingEvent is one of {
    TrainingContext.Training.TrainingProgramCreated or TrainingContext.Training.TrainingProgramUpdated or TrainingContext.Training.TrainingProgramActivated or TrainingContext.Training.TrainingProgramRetired or TrainingContext.Training.SessionScheduled or TrainingContext.Training.SessionCancelled or TrainingContext.Training.TraineeRegistered or TrainingContext.Training.RegistrationCancelled or TrainingContext.Training.AttendanceRecorded or TrainingContext.Training.SessionCompleted or TrainingContext.Training.TrainingCompleted or TrainingContext.Training.ComplianceReportGenerated
  } with {
    briefly "Training event alternation"
    described as {
      |Union of all Training events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet TrainingEventSplit as flow is {
    inlet TrainingEventSplitIn is type TrainingEvent    outlet TrainingEventSplitToTrainingAnalytics is type TrainingEvent
    handler TrainingEventSplitHandler is {
      on trainingProgramCreated: event Training.TrainingProgramCreated is {
        send trainingProgramCreated to outlet TrainingEventSplitToTrainingAnalytics
        tell trainingProgramCreated to entity TrainingContext.Training
      }
      on trainingProgramUpdated: event Training.TrainingProgramUpdated is {
        send trainingProgramUpdated to outlet TrainingEventSplitToTrainingAnalytics
        tell trainingProgramUpdated to entity TrainingContext.Training
      }
      on trainingProgramActivated: event Training.TrainingProgramActivated is {
        send trainingProgramActivated to outlet TrainingEventSplitToTrainingAnalytics
        tell trainingProgramActivated to entity TrainingContext.Training
      }
      on trainingProgramRetired: event Training.TrainingProgramRetired is {
        send trainingProgramRetired to outlet TrainingEventSplitToTrainingAnalytics
        tell trainingProgramRetired to entity TrainingContext.Training
      }
      on sessionScheduled: event Training.SessionScheduled is {
        send sessionScheduled to outlet TrainingEventSplitToTrainingAnalytics
        tell sessionScheduled to entity TrainingContext.Training
      }
      on sessionCancelled: event Training.SessionCancelled is {
        send sessionCancelled to outlet TrainingEventSplitToTrainingAnalytics
        tell sessionCancelled to entity TrainingContext.Training
      }
      on traineeRegistered: event Training.TraineeRegistered is {
        send traineeRegistered to outlet TrainingEventSplitToTrainingAnalytics
        tell traineeRegistered to entity TrainingContext.Training
      }
      on registrationCancelled: event Training.RegistrationCancelled is {
        send registrationCancelled to outlet TrainingEventSplitToTrainingAnalytics
        tell registrationCancelled to entity TrainingContext.Training
      }
      on attendanceRecorded: event Training.AttendanceRecorded is {
        send attendanceRecorded to outlet TrainingEventSplitToTrainingAnalytics
        tell attendanceRecorded to entity TrainingContext.Training
      }
      on sessionCompleted: event Training.SessionCompleted is {
        send sessionCompleted to outlet TrainingEventSplitToTrainingAnalytics
        tell sessionCompleted to entity TrainingContext.Training
      }
      on trainingCompleted: event Training.TrainingCompleted is {
        send trainingCompleted to outlet TrainingEventSplitToTrainingAnalytics
        tell trainingCompleted to entity TrainingContext.Training
      }
      on complianceReportGenerated: event Training.ComplianceReportGenerated is {
        send complianceReportGenerated to outlet TrainingEventSplitToTrainingAnalytics
        tell complianceReportGenerated to entity TrainingContext.Training
      }
      on other is {
        error "Unexpected message for processor TrainingEventSplit"
      }
    } with {
      briefly "Training event fan-out handler"
      described as {
        |Delivers each Training event to all of its consumers.
      }
    }
  } with {
    briefly "Training event fan-out"
    described as {
      |Fans Training events out to the repository and projectors.
    }
  }
  connector 'TrainingEvent Stream' is from outlet TrainingContext.Training.TrainingEvents2 to inlet TrainingContext.TrainingEventSplit.TrainingEventSplitIn with {
    briefly "Training events, fanned out to storage and read models"
  }
  connector 'TrainingAnalytics Feed' is from outlet TrainingContext.TrainingEventSplit.TrainingEventSplitToTrainingAnalytics to inlet TrainingContext.TrainingAnalytics.TrainingAnalyticsFromTraining with {
    briefly "Training events feeding the TrainingAnalytics projection"
  }
  connector 'TrainingAnalytics Storage' is from outlet TrainingContext.TrainingAnalytics.TrainingAnalyticsToRepository to inlet TrainingContext.TrainingRepository.TrainingRepositoryFromTrainingAnalytics with {
    briefly "TrainingAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for training administration"
  described as {
    | The TrainingContext is the bounded context for corporate
    | training programs, scheduling, and compliance tracking.
  }
}
