// Training Administration - Training Context
context TrainingContext as router is {
  inlet TrainingCommandStreamIn is type TrainingCommand  outlet TrainingCommandStreamOut is type TrainingCommand
  inlet TrainingResultStreamIn is result Training.TrainingResult  outlet TrainingResultStreamOut is result Training.TrainingResult
  handler TrainingContextBoundary is {
    on createTrainingProgram: command Training.CreateTrainingProgram is {
      send createTrainingProgram to outlet TrainingContext.TrainingCommandStreamOut
    }
    on updateTrainingProgram: command Training.UpdateTrainingProgram is {
      send updateTrainingProgram to outlet TrainingContext.TrainingCommandStreamOut
    }
    on activateTrainingProgram: command Training.ActivateTrainingProgram is {
      send activateTrainingProgram to outlet TrainingContext.TrainingCommandStreamOut
    }
    on retireTrainingProgram: command Training.RetireTrainingProgram is {
      send retireTrainingProgram to outlet TrainingContext.TrainingCommandStreamOut
    }
    on scheduleSession: command Training.ScheduleSession is {
      send scheduleSession to outlet TrainingContext.TrainingCommandStreamOut
    }
    on cancelSession: command Training.CancelSession is {
      send cancelSession to outlet TrainingContext.TrainingCommandStreamOut
    }
    on registerTrainee: command Training.RegisterTrainee is {
      send registerTrainee to outlet TrainingContext.TrainingCommandStreamOut
    }
    on cancelRegistration: command Training.CancelRegistration is {
      send cancelRegistration to outlet TrainingContext.TrainingCommandStreamOut
    }
    on recordAttendance: command Training.RecordAttendance is {
      send recordAttendance to outlet TrainingContext.TrainingCommandStreamOut
    }
    on completeSession: command Training.CompleteSession is {
      send completeSession to outlet TrainingContext.TrainingCommandStreamOut
    }
    on recordCompletion: command Training.RecordCompletion is {
      send recordCompletion to outlet TrainingContext.TrainingCommandStreamOut
    }
    on generateComplianceReport: command Training.GenerateComplianceReport is {
      send generateComplianceReport to outlet TrainingContext.TrainingCommandStreamOut
    }
    on trainingResult: result Training.TrainingResult is {
      send trainingResult to outlet TrainingContext.TrainingResultStreamOut
    }
    on other is {
      error "Unexpected message at the TrainingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TrainingCommand Stream Intake' is from outlet TrainingContext.TrainingCommandStreamOut to inlet TrainingContext.Training.TrainingCommands  connector 'TrainingResult Stream Egress' is from outlet TrainingContext.TrainingRepository.TrainingRepositoryResponses to inlet TrainingContext.TrainingResultStreamIn  adaptor FromCalendarService from context CalendarService as sink is { 
    inlet FromCalendarServiceIn is event CalendarService.CalendarEventCreated    handler FromCalendarServiceHandler is {
      on calendarEventCreated: event CalendarService.CalendarEventCreated is {
        do "the calendar entry exists; the session was scheduled before it was asked for"
      }
      on other is {
        error "Unexpected message for adaptor FromCalendarService"
      }
    } with {
      briefly "from calendar service"
      described as {
        |Carries messages from the external CalendarService.
      }
    }
  } with {
    briefly "CalendarService integration"
    described as {
      |The model's side of the CalendarService conversation.
    }
  }
  adaptor ToCalendarService to context CalendarService as flow is { 
    inlet ToCalendarServiceIn is type TrainingEvent    outlet ToCalendarServiceOut is command CalendarService.CreateCalendarEvent
    handler ToCalendarServiceHandler is {
      on sessionScheduled: event Training.SessionScheduled is {
        let request: type CalendarService.CreateCalendarEvent = prompt("translate the sessionScheduled event into a CreateCalendarEvent putting the session in the trainer's and trainees' calendars")
        send request to outlet TrainingContext.ToCalendarService.ToCalendarServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToCalendarService"
      }
    } with {
      briefly "to calendar service"
      described as {
        |Carries messages to the external CalendarService.
      }
    }
  } with {
    briefly "CalendarService integration"
    described as {
      |The model's side of the CalendarService conversation.
    }
  }
  adaptor FromCertificateService from context CertificateService as sink is { 
    inlet FromCertificateServiceIn is event CertificateService.CertificateGenerated    handler FromCertificateServiceHandler is {
      on certificateGenerated: event CertificateService.CertificateGenerated is {
        do "the certificate is made; completion was recorded here first"
      }
      on other is {
        error "Unexpected message for adaptor FromCertificateService"
      }
    } with {
      briefly "from certificate service"
      described as {
        |Carries messages from the external CertificateService.
      }
    }
  } with {
    briefly "CertificateService integration"
    described as {
      |The model's side of the CertificateService conversation.
    }
  }
  adaptor ToCertificateService to context CertificateService as flow is { 
    inlet ToCertificateServiceIn is type TrainingEvent    outlet ToCertificateServiceOut is command CertificateService.GenerateCertificate
    handler ToCertificateServiceHandler is {
      on trainingCompleted: event Training.TrainingCompleted is {
        let item0: type CertificateService.GenerateCertificate = prompt("translate the trainingCompleted event into a GenerateCertificate, completion being what a certificate attests")
        send item0 to outlet TrainingContext.ToCertificateService.ToCertificateServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToCertificateService"
      }
    } with {
      briefly "to certificate service"
      described as {
        |Carries messages to the external CertificateService.
      }
    }
  } with {
    briefly "CertificateService integration"
    described as {
      |The model's side of the CertificateService conversation.
    }
  }
  adaptor FromHRISService from context HRISService as sink is { 
    inlet FromHRISServiceIn is type HRISService.HRISServiceEvent    handler FromHRISServiceHandler is {
      on employeeDepartmentChanged: event HRISService.EmployeeDepartmentChanged is {
        do "a department change affects which programmes apply; registrations already made stand"
      }
      on employeeHired: event HRISService.EmployeeHired is {
        do "a new employee may later be registered for training; hiring alone registers nobody"
      }
      on other is {
        error "Unexpected message for adaptor FromHRISService"
      }
    } with {
      briefly "from hris service"
      described as {
        |Carries messages from the external HRISService.
      }
    }
  } with {
    briefly "HRISService integration"
    described as {
      |The model's side of the HRISService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type TrainingEvent    outlet ToNotificationServiceOut is type NotificationService.NotificationServiceCommand
    handler ToNotificationServiceHandler is {
      on sessionCancelled: event SessionCancelled is {
        let msg: type NotificationService.SendComplianceAlert = prompt("translate the sessionCancelled event into a SendComplianceAlert for its recipient")
        send msg to outlet TrainingContext.ToNotificationService.ToNotificationServiceOut
      }
      on traineeRegistered: event TraineeRegistered is {
        let reminder: type NotificationService.SendSessionReminder = prompt("translate the traineeRegistered event into a SendSessionReminder carrying the session's scheduled start, so the service can raise it before the trainee is due to attend — this hands over a deadline to schedule against, it is not itself the reminder")
        send reminder to outlet TrainingContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromRoomReservationService from context RoomReservationService as sink is { 
    inlet FromRoomReservationServiceIn is event RoomReservationService.RoomReserved    handler FromRoomReservationServiceHandler is {
      on roomReserved: event RoomReservationService.RoomReserved is {
        do "the room is held; the session was scheduled before the room was asked for"
      }
      on other is {
        error "Unexpected message for adaptor FromRoomReservationService"
      }
    } with {
      briefly "from room reservation service"
      described as {
        |Carries messages from the external RoomReservationService.
      }
    }
  } with {
    briefly "RoomReservationService integration"
    described as {
      |The model's side of the RoomReservationService conversation.
    }
  }
  adaptor ToRoomReservationService to context RoomReservationService as flow is { 
    inlet ToRoomReservationServiceIn is type TrainingEvent    outlet ToRoomReservationServiceOut is command RoomReservationService.ReserveRoom
    handler ToRoomReservationServiceHandler is {
      on sessionScheduled: event Training.SessionScheduled is {
        let item0: type RoomReservationService.ReserveRoom = prompt("translate the sessionScheduled event into a ReserveRoom, a scheduled session needing a room to be held in")
        send item0 to outlet TrainingContext.ToRoomReservationService.ToRoomReservationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToRoomReservationService"
      }
    } with {
      briefly "to room reservation service"
      described as {
        |Carries messages to the external RoomReservationService.
      }
    }
  } with {
    briefly "RoomReservationService integration"
    described as {
      |The model's side of the RoomReservationService conversation.
    }
  }
  adaptor FromVideoConferenceService from context VideoConferenceService as sink is { 
    inlet FromVideoConferenceServiceIn is event VideoConferenceService.MeetingCreated    handler FromVideoConferenceServiceHandler is {
      on meetingCreated: event VideoConferenceService.MeetingCreated is {
        do "the meeting link exists; the session it serves was already scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromVideoConferenceService"
      }
    } with {
      briefly "from video conference service"
      described as {
        |Carries messages from the external VideoConferenceService.
      }
    }
  } with {
    briefly "VideoConferenceService integration"
    described as {
      |The model's side of the VideoConferenceService conversation.
    }
  }
  adaptor ToVideoConferenceService to context VideoConferenceService as flow is { 
    inlet ToVideoConferenceServiceIn is type TrainingEvent    outlet ToVideoConferenceServiceOut is command VideoConferenceService.CreateMeeting
    handler ToVideoConferenceServiceHandler is {
      on sessionScheduled: event Training.SessionScheduled is {
        let item0: type VideoConferenceService.CreateMeeting = prompt("translate the sessionScheduled event into a CreateMeeting, a scheduled session needing somewhere to be held")
        send item0 to outlet TrainingContext.ToVideoConferenceService.ToVideoConferenceServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToVideoConferenceService"
      }
    } with {
      briefly "to video conference service"
      described as {
        |Carries messages to the external VideoConferenceService.
      }
    }
  } with {
    briefly "VideoConferenceService integration"
    described as {
      |The model's side of the VideoConferenceService conversation.
    }
  }
  include "types.riddl"
  include "Training.riddl"
  // Repository for training persistence
  type TrainingRepositoryCommand is one of {
    TrainingContext.TrainingRepository.PersistAttendanceRecorded or TrainingContext.TrainingRepository.PersistComplianceReportGenerated or TrainingContext.TrainingRepository.PersistRegistrationCancelled or TrainingContext.TrainingRepository.PersistSessionCancelled or TrainingContext.TrainingRepository.PersistSessionCompleted or TrainingContext.TrainingRepository.PersistSessionScheduled or TrainingContext.TrainingRepository.PersistTraineeRegistered or TrainingContext.TrainingRepository.PersistTrainingCompleted or TrainingContext.TrainingRepository.PersistTrainingProgramActivated or TrainingContext.TrainingRepository.PersistTrainingProgramCreated or TrainingContext.TrainingRepository.PersistTrainingProgramRetired or TrainingContext.TrainingRepository.PersistTrainingProgramUpdated
  } with {
    briefly "Anything that writes TrainingRepository"
    described as {
      |The persistence commands TrainingRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository TrainingRepository as flow is {
    inlet TrainingRepositoryFromTrainingAnalytics is type TrainingRepositoryCommand    command PersistAttendanceRecorded is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row AttendanceRecorded applies to.
        }
      }
      sessionId: SessionId? with {
        briefly "Session id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      traineeId: TraineeId? with {
        briefly "Trainee id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      attended: Boolean? with {
        briefly "Attended"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist AttendanceRecorded"
      described as {
        |Instructs this repository to apply AttendanceRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRegistrationCancelled is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row RegistrationCancelled applies to.
        }
      }
      registrationId: RegistrationId? with {
        briefly "Registration id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist RegistrationCancelled"
      described as {
        |Instructs this repository to apply RegistrationCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSessionCancelled is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row SessionCancelled applies to.
        }
      }
      sessionId: SessionId? with {
        briefly "Session id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SessionCancelled"
      described as {
        |Instructs this repository to apply SessionCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSessionCompleted is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row SessionCompleted applies to.
        }
      }
      sessionId: SessionId? with {
        briefly "Session id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SessionCompleted"
      described as {
        |Instructs this repository to apply SessionCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrainingProgramActivated is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrainingProgramActivated applies to.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TrainingProgramActivated"
      described as {
        |Instructs this repository to apply TrainingProgramActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrainingProgramCreated is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrainingProgramCreated applies to.
        }
      }
      program: TrainingProgram? with {
        briefly "Program"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TrainingProgramCreated"
      described as {
        |Instructs this repository to apply TrainingProgramCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrainingProgramRetired is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrainingProgramRetired applies to.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      retiredAt: TimeStamp? with {
        briefly "Retired at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TrainingProgramRetired"
      described as {
        |Instructs this repository to apply TrainingProgramRetired to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrainingProgramUpdated is {
      trainingId: TrainingId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrainingProgramUpdated applies to.
        }
      }
      program: TrainingProgram? with {
        briefly "Program"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TrainingProgramUpdated"
      described as {
        |Instructs this repository to apply TrainingProgramUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistComplianceReportGenerated is {
      report: ComplianceReport with {
        briefly "Row addressed"
        described as {
          |Which stored row ComplianceReportGenerated applies to.
        }
      }
      trainingId: TrainingId? with {
        briefly "Training id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      generatedAt: TimeStamp? with {
        briefly "Generated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ComplianceReportGenerated"
      described as {
        |Instructs this repository to apply ComplianceReportGenerated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSessionScheduled is {
      session: TrainingSession with {
        briefly "Row addressed"
        described as {
          |Which stored row SessionScheduled applies to.
        }
      }
      trainingId: TrainingId? with {
        briefly "Training id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      scheduledAt: TimeStamp? with {
        briefly "Scheduled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SessionScheduled"
      described as {
        |Instructs this repository to apply SessionScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTraineeRegistered is {
      sessionId: SessionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TraineeRegistered applies to.
        }
      }
      trainingId: TrainingId? with {
        briefly "Training id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      traineeId: TraineeId? with {
        briefly "Trainee id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      registrationId: RegistrationId? with {
        briefly "Registration id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      registeredAt: TimeStamp? with {
        briefly "Registered at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      scheduledStart: TimeStamp? with {
        briefly "Scheduled start"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TraineeRegistered"
      described as {
        |Instructs this repository to apply TraineeRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrainingCompleted is {
      traineeId: TraineeId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrainingCompleted applies to.
        }
      }
      trainingId: TrainingId? with {
        briefly "Training id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      passed: Boolean? with {
        briefly "Passed"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TrainingCompleted"
      described as {
        |Instructs this repository to apply TrainingCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet TrainingRepositoryResponses is result Training.TrainingResult
    record StoredTraining is {
      trainingId: TrainingId with {
        briefly "trainingId"
        described as {
          |The trainingId column of the stored training row.
        }
      }
      program: TrainingProgram with {
        briefly "program"
        described as {
          |The program column of the stored training row.
        }
      }
      sessionId: SessionId? with {
        briefly "Session id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      traineeId: TraineeId? with {
        briefly "Trainee id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      attended: Boolean? with {
        briefly "Attended"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      registrationId: RegistrationId? with {
        briefly "Registration id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      retiredAt: TimeStamp? with {
        briefly "Retired at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      report: ComplianceReport? with {
        briefly "Report"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      generatedAt: TimeStamp? with {
        briefly "Generated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      session: TrainingSession? with {
        briefly "Session"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      scheduledAt: TimeStamp? with {
        briefly "Scheduled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      registeredAt: TimeStamp? with {
        briefly "Registered at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      scheduledStart: TimeStamp? with {
        briefly "Scheduled start"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      passed: Boolean? with {
        briefly "Passed"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored training row"
      described as {
        |The persistence shape of training data as this repository stores it.
      }
    }
    schema TrainingData is relational
      of trainings as record StoredTraining
        key on field StoredTraining.trainingId
        index on field StoredTraining.program.title
 with {
      briefly "Training data schema"
      described as {
        |The relational schema holding training data for the TrainingRepository.
      }
    }
    handler TrainingPersistence is {
      on persistAttendanceRecorded: command PersistAttendanceRecorded is {
        update TrainingData.trainings set sessionId = persistAttendanceRecorded.sessionId, traineeId = persistAttendanceRecorded.traineeId, attended = persistAttendanceRecorded.attended, recordedAt = persistAttendanceRecorded.recordedAt where trainingId == persistAttendanceRecorded.trainingId
      }
      on persistRegistrationCancelled: command PersistRegistrationCancelled is {
        update TrainingData.trainings set registrationId = persistRegistrationCancelled.registrationId, cancelledAt = persistRegistrationCancelled.cancelledAt where trainingId == persistRegistrationCancelled.trainingId
      }
      on persistSessionCancelled: command PersistSessionCancelled is {
        update TrainingData.trainings set sessionId = persistSessionCancelled.sessionId, reason = persistSessionCancelled.reason, cancelledAt = persistSessionCancelled.cancelledAt where trainingId == persistSessionCancelled.trainingId
      }
      on persistSessionCompleted: command PersistSessionCompleted is {
        update TrainingData.trainings set sessionId = persistSessionCompleted.sessionId, completedAt = persistSessionCompleted.completedAt where trainingId == persistSessionCompleted.trainingId
      }
      on persistTrainingProgramActivated: command PersistTrainingProgramActivated is {
        update TrainingData.trainings set activatedAt = persistTrainingProgramActivated.activatedAt where trainingId == persistTrainingProgramActivated.trainingId
      }
      on persistTrainingProgramCreated: command PersistTrainingProgramCreated is {
        update TrainingData.trainings set program = persistTrainingProgramCreated.program, createdAt = persistTrainingProgramCreated.createdAt where trainingId == persistTrainingProgramCreated.trainingId
      }
      on persistTrainingProgramRetired: command PersistTrainingProgramRetired is {
        update TrainingData.trainings set reason = persistTrainingProgramRetired.reason, retiredAt = persistTrainingProgramRetired.retiredAt where trainingId == persistTrainingProgramRetired.trainingId
      }
      on persistTrainingProgramUpdated: command PersistTrainingProgramUpdated is {
        update TrainingData.trainings set program = persistTrainingProgramUpdated.program, updatedAt = persistTrainingProgramUpdated.updatedAt where trainingId == persistTrainingProgramUpdated.trainingId
      }
      on persistComplianceReportGenerated: command PersistComplianceReportGenerated is {
        update TrainingData.trainings set report = persistComplianceReportGenerated.report, generatedAt = persistComplianceReportGenerated.generatedAt where trainingId == persistComplianceReportGenerated.trainingId
      }
      on persistSessionScheduled: command PersistSessionScheduled is {
        update TrainingData.trainings set session = persistSessionScheduled.session, scheduledAt = persistSessionScheduled.scheduledAt where trainingId == persistSessionScheduled.trainingId
      }
      on persistTraineeRegistered: command PersistTraineeRegistered is {
        update TrainingData.trainings set sessionId = persistTraineeRegistered.sessionId, traineeId = persistTraineeRegistered.traineeId, registrationId = persistTraineeRegistered.registrationId, registeredAt = persistTraineeRegistered.registeredAt, scheduledStart = persistTraineeRegistered.scheduledStart where trainingId == persistTraineeRegistered.trainingId
      }
      on persistTrainingCompleted: command PersistTrainingCompleted is {
        update TrainingData.trainings set traineeId = persistTrainingCompleted.traineeId, passed = persistTrainingCompleted.passed, completedAt = persistTrainingCompleted.completedAt where trainingId == persistTrainingCompleted.trainingId
      }
      on query GetTrainingStats is {
        let trainingStatsView: type TrainingStatsView = prompt("read the training stats projection")
        reply trainingStatsView
      }
    } with {
      briefly "Persists training commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Training data persistence"
    described as {
      | The TrainingRepository provides persistent storage for
      | training programs, sessions, and completion records.
    }
  }
  // Projector for training analytics
  query GetTrainingStats replies result TrainingStatsView is {
    trainingStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which training stats to retrieve.
      }
    }
  } with {
    briefly "Get training stats"
    described as {
      |Retrieves the training stats projection.
    }
  }
  result TrainingStatsView is {
    trainingStats: TrainingAnalytics.TrainingStats with {
      briefly "Training stats"
      described as {
        |The training stats being returned.
      }
    }
  } with {
    briefly "Training stats view"
    described as {
      |Read model view carrying the training stats projection.
    }
  }
  projector TrainingAnalytics as flow is {
    updates repository TrainingContext.TrainingRepository
    outlet TrainingAnalyticsToRepository is type TrainingRepositoryCommand
    inlet TrainingAnalyticsFromTraining is type TrainingEvent    record TrainingStats is {
      trainingId: TrainingId with {
        briefly "Training"
        described as {
          |Training ID.
        }
      }
      totalSessions: Natural with {
        briefly "Sessions"
        described as {
          |Total sessions.
        }
      }
      totalEnrollments: Natural with {
        briefly "Enrollments"
        described as {
          |Total enrolled.
        }
      }
      completionRate: Decimal(5,2) with {
        briefly "Completion"
        described as {
          |Completion rate.
        }
      }
      averageScore: Decimal(5,2) with {
        briefly "Avg score"
        described as {
          |Average score.
        }
      }
    } with {
      briefly "Training statistics"
      described as {
        |Training program metrics.
      }
    }
    handler AnalyticsHandler is {
      on attendanceRecorded: event Training.AttendanceRecorded is {
        tell command TrainingContext.TrainingRepository.PersistAttendanceRecorded(trainingId = attendanceRecorded.trainingId, sessionId = attendanceRecorded.sessionId, traineeId = attendanceRecorded.traineeId, attended = attendanceRecorded.attended, recordedAt = attendanceRecorded.recordedAt) to repository TrainingContext.TrainingRepository
        do "apply AttendanceRecorded to the TrainingAnalytics projection"
      }
      on registrationCancelled: event Training.RegistrationCancelled is {
        tell command TrainingContext.TrainingRepository.PersistRegistrationCancelled(trainingId = registrationCancelled.trainingId, registrationId = registrationCancelled.registrationId, cancelledAt = registrationCancelled.cancelledAt) to repository TrainingContext.TrainingRepository
        do "apply RegistrationCancelled to the TrainingAnalytics projection"
      }
      on sessionCancelled: event Training.SessionCancelled is {
        tell command TrainingContext.TrainingRepository.PersistSessionCancelled(trainingId = sessionCancelled.trainingId, sessionId = sessionCancelled.sessionId, reason = sessionCancelled.reason, cancelledAt = sessionCancelled.cancelledAt) to repository TrainingContext.TrainingRepository
        do "apply SessionCancelled to the TrainingAnalytics projection"
      }
      on sessionCompleted: event Training.SessionCompleted is {
        tell command TrainingContext.TrainingRepository.PersistSessionCompleted(trainingId = sessionCompleted.trainingId, sessionId = sessionCompleted.sessionId, completedAt = sessionCompleted.completedAt) to repository TrainingContext.TrainingRepository
        do "apply SessionCompleted to the TrainingAnalytics projection"
      }
      on trainingProgramActivated: event Training.TrainingProgramActivated is {
        tell command TrainingContext.TrainingRepository.PersistTrainingProgramActivated(trainingId = trainingProgramActivated.trainingId, activatedAt = trainingProgramActivated.activatedAt) to repository TrainingContext.TrainingRepository
        do "apply TrainingProgramActivated to the TrainingAnalytics projection"
      }
      on trainingProgramCreated: event Training.TrainingProgramCreated is {
        tell command TrainingContext.TrainingRepository.PersistTrainingProgramCreated(trainingId = trainingProgramCreated.trainingId, program = trainingProgramCreated.program, createdAt = trainingProgramCreated.createdAt) to repository TrainingContext.TrainingRepository
        do "apply TrainingProgramCreated to the TrainingAnalytics projection"
      }
      on trainingProgramRetired: event Training.TrainingProgramRetired is {
        tell command TrainingContext.TrainingRepository.PersistTrainingProgramRetired(trainingId = trainingProgramRetired.trainingId, reason = trainingProgramRetired.reason, retiredAt = trainingProgramRetired.retiredAt) to repository TrainingContext.TrainingRepository
        do "apply TrainingProgramRetired to the TrainingAnalytics projection"
      }
      on trainingProgramUpdated: event Training.TrainingProgramUpdated is {
        tell command TrainingContext.TrainingRepository.PersistTrainingProgramUpdated(trainingId = trainingProgramUpdated.trainingId, program = trainingProgramUpdated.program, updatedAt = trainingProgramUpdated.updatedAt) to repository TrainingContext.TrainingRepository
        do "apply TrainingProgramUpdated to the TrainingAnalytics projection"
      }
      on sessionScheduled: event Training.SessionScheduled is {
        tell command TrainingContext.TrainingRepository.PersistSessionScheduled(session = sessionScheduled.session, trainingId = sessionScheduled.trainingId, scheduledAt = sessionScheduled.scheduledAt) to repository TrainingContext.TrainingRepository
        do "Update session counts"
      }
      on traineeRegistered: event Training.TraineeRegistered is {
        tell command TrainingContext.TrainingRepository.PersistTraineeRegistered(sessionId = traineeRegistered.sessionId, trainingId = traineeRegistered.trainingId, traineeId = traineeRegistered.traineeId, registrationId = traineeRegistered.registrationId, registeredAt = traineeRegistered.registeredAt, scheduledStart = traineeRegistered.scheduledStart) to repository TrainingContext.TrainingRepository
        do "Update enrollment counts"
      }
      on trainingCompleted: event Training.TrainingCompleted is {
        tell command TrainingContext.TrainingRepository.PersistTrainingCompleted(traineeId = trainingCompleted.traineeId, trainingId = trainingCompleted.trainingId, passed = trainingCompleted.passed, completedAt = trainingCompleted.completedAt) to repository TrainingContext.TrainingRepository
        do "Update completion metrics"
      }
      on complianceReportGenerated: event Training.ComplianceReportGenerated is {
        tell command TrainingContext.TrainingRepository.PersistComplianceReportGenerated(report = complianceReportGenerated.report, trainingId = complianceReportGenerated.trainingId, generatedAt = complianceReportGenerated.generatedAt) to repository TrainingContext.TrainingRepository
        do "Store compliance metrics"
      }
    } with {
      briefly "Maintains training analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Training analytics projections"
    described as {
      |Maintains training analytics data.
    }
  }
  // ---- Event publication for Training ----
  type TrainingEvent is one of {
    TrainingContext.Training.TrainingProgramCreated or TrainingContext.Training.TrainingProgramUpdated or TrainingContext.Training.TrainingProgramActivated or TrainingContext.Training.TrainingProgramRetired or TrainingContext.Training.SessionScheduled or TrainingContext.Training.SessionCancelled or TrainingContext.Training.TraineeRegistered or TrainingContext.Training.RegistrationCancelled or TrainingContext.Training.AttendanceRecorded or TrainingContext.Training.SessionCompleted or TrainingContext.Training.TrainingCompleted or TrainingContext.Training.ComplianceReportGenerated
  } with {
    briefly "Training event alternation"
    described as {
      |Union of all Training events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet TrainingEventSplit as split is {
    outlet TrainingEventSplitToToVideoConferenceService is type TrainingEvent
    outlet TrainingEventSplitToToRoomReservationService is type TrainingEvent
    outlet TrainingEventSplitToToNotificationService is type TrainingEvent
    outlet TrainingEventSplitToToCertificateService is type TrainingEvent
    outlet TrainingEventSplitToToCalendarService is type TrainingEvent
    inlet TrainingEventSplitIn is type TrainingEvent    outlet TrainingEventSplitToTrainingAnalytics is type TrainingEvent
    handler TrainingEventSplitHandler is {
      on trainingProgramCreated: event Training.TrainingProgramCreated is {
        send trainingProgramCreated to outlet TrainingEventSplitToTrainingAnalytics
        tell trainingProgramCreated to entity TrainingContext.Training
      }
      on trainingProgramUpdated: event Training.TrainingProgramUpdated is {
        send trainingProgramUpdated to outlet TrainingEventSplitToTrainingAnalytics
        tell trainingProgramUpdated to entity TrainingContext.Training
      }
      on trainingProgramActivated: event Training.TrainingProgramActivated is {
        send trainingProgramActivated to outlet TrainingEventSplitToTrainingAnalytics
        tell trainingProgramActivated to entity TrainingContext.Training
      }
      on trainingProgramRetired: event Training.TrainingProgramRetired is {
        send trainingProgramRetired to outlet TrainingEventSplitToTrainingAnalytics
        tell trainingProgramRetired to entity TrainingContext.Training
      }
      on sessionScheduled: event Training.SessionScheduled is {
        send sessionScheduled to outlet TrainingEventSplitToTrainingAnalytics
        send sessionScheduled to outlet TrainingEventSplitToToVideoConferenceService
        send sessionScheduled to outlet TrainingEventSplitToToRoomReservationService
        send sessionScheduled to outlet TrainingEventSplitToToCalendarService
        tell sessionScheduled to entity TrainingContext.Training
      }
      on sessionCancelled: event Training.SessionCancelled is {
        send sessionCancelled to outlet TrainingEventSplitToTrainingAnalytics
        send sessionCancelled to outlet TrainingEventSplitToToNotificationService
        tell sessionCancelled to entity TrainingContext.Training
      }
      on traineeRegistered: event Training.TraineeRegistered is {
        send traineeRegistered to outlet TrainingEventSplitToTrainingAnalytics
        send traineeRegistered to outlet TrainingEventSplitToToNotificationService
        tell traineeRegistered to entity TrainingContext.Training
      }
      on registrationCancelled: event Training.RegistrationCancelled is {
        send registrationCancelled to outlet TrainingEventSplitToTrainingAnalytics
        tell registrationCancelled to entity TrainingContext.Training
      }
      on attendanceRecorded: event Training.AttendanceRecorded is {
        send attendanceRecorded to outlet TrainingEventSplitToTrainingAnalytics
        tell attendanceRecorded to entity TrainingContext.Training
      }
      on sessionCompleted: event Training.SessionCompleted is {
        send sessionCompleted to outlet TrainingEventSplitToTrainingAnalytics
        tell sessionCompleted to entity TrainingContext.Training
      }
      on trainingCompleted: event Training.TrainingCompleted is {
        send trainingCompleted to outlet TrainingEventSplitToTrainingAnalytics
        send trainingCompleted to outlet TrainingEventSplitToToCertificateService
        tell trainingCompleted to entity TrainingContext.Training
      }
      on complianceReportGenerated: event Training.ComplianceReportGenerated is {
        send complianceReportGenerated to outlet TrainingEventSplitToTrainingAnalytics
        tell complianceReportGenerated to entity TrainingContext.Training
      }
      on other is {
        error "Unexpected message for processor TrainingEventSplit"
      }
    } with {
      briefly "Training event fan-out handler"
      described as {
        |Delivers each Training event to all of its consumers.
      }
    }
  } with {
    briefly "Training event fan-out"
    described as {
      |Fans Training events out to the repository and projectors.
    }
  }
  connector 'ToVideoConferenceService Feed' is from outlet TrainingContext.TrainingEventSplit.TrainingEventSplitToToVideoConferenceService to inlet TrainingContext.ToVideoConferenceService.ToVideoConferenceServiceIn with {
    briefly "The Training events ToVideoConferenceService translates, on their way to it"
  }
  connector 'ToRoomReservationService Feed' is from outlet TrainingContext.TrainingEventSplit.TrainingEventSplitToToRoomReservationService to inlet TrainingContext.ToRoomReservationService.ToRoomReservationServiceIn with {
    briefly "The Training events ToRoomReservationService translates, on their way to it"
  }
  connector 'ToNotificationService Feed' is from outlet TrainingContext.TrainingEventSplit.TrainingEventSplitToToNotificationService to inlet TrainingContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The Training events ToNotificationService translates, on their way to it"
  }
  connector 'ToCertificateService Feed' is from outlet TrainingContext.TrainingEventSplit.TrainingEventSplitToToCertificateService to inlet TrainingContext.ToCertificateService.ToCertificateServiceIn with {
    briefly "The Training events ToCertificateService translates, on their way to it"
  }
  connector 'ToCalendarService Feed' is from outlet TrainingContext.TrainingEventSplit.TrainingEventSplitToToCalendarService to inlet TrainingContext.ToCalendarService.ToCalendarServiceIn with {
    briefly "The Training events ToCalendarService translates, on their way to it"
  }
  connector 'TrainingEvent Stream' is from outlet TrainingContext.Training.TrainingEvents2 to inlet TrainingContext.TrainingEventSplit.TrainingEventSplitIn with {
    briefly "Training events, fanned out to storage and read models"
  }
  connector 'TrainingAnalytics Feed' is from outlet TrainingContext.TrainingEventSplit.TrainingEventSplitToTrainingAnalytics to inlet TrainingContext.TrainingAnalytics.TrainingAnalyticsFromTraining with {
    briefly "Training events feeding the TrainingAnalytics projection"
  }
  connector 'TrainingAnalytics Storage' is from outlet TrainingContext.TrainingAnalytics.TrainingAnalyticsToRepository to inlet TrainingContext.TrainingRepository.TrainingRepositoryFromTrainingAnalytics with {
    briefly "TrainingAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for training administration"
  described as {
    | The TrainingContext is the bounded context for corporate
    | training programs, scheduling, and compliance tracking.
  }
}
