// Learning Management - LearnerEnrollment aggregate
entity LearnerEnrollment as flow is {
  inlet LearnerEnrollmentCommands is type LearnerEnrollmentCommand  outlet LearnerEnrollmentEvents is type LearnerEnrollmentEvent
  type LearnerEnrollmentEvent is one of {
    LearnerEnrollment.LearnerEnrollmentOpened or LearnerEnrollment.LearnerActivityRecorded or LearnerEnrollment.LearnerEnrollmentCompleted or LearnerEnrollment.LearnerWentQuiet
  } with {
    briefly "Learner enrollment event alternation"
    described as {
      |Everything one learner's enrollment can report.
    }
  }
  query GetLearnerEnrollment replies result LearnerEnrollmentResult is {
    learnerEnrollmentId: LearnerEnrollmentId with {
      briefly "ID"
      described as {
        |Identifier of the enrollment to retrieve.
      }
    }
  } with {
    briefly "Get learner enrollment"
    described as {
      |Reads one learner's progress on one course.
    }
  }
  result LearnerEnrollmentResult is {
    learnerEnrollmentId: LearnerEnrollmentId with {
      briefly "ID"
      described as {
        |The enrollment read.
      }
    }
    lastActivityAt: TimeStamp with {
      briefly "Last activity"
      described as {
        |When the learner last did anything on this course.
      }
    }
  } with {
    briefly "Learner enrollment result"
    described as {
      |What a read of one enrollment returns.
    }
  }
  type LearnerEnrollmentCommand is one of {
    LearnerEnrollment.OpenLearnerEnrollment or LearnerEnrollment.RecordLearnerActivity or LearnerEnrollment.CompleteLearnerEnrollment or LearnerEnrollment.NudgeLearner
  } with {
    briefly "Enrollment command alternation"
    described as {
      |Everything one learner's enrollment can be asked to do.
    }
  }
  command OpenLearnerEnrollment is {
    learnerEnrollmentId: LearnerEnrollmentId with {
      briefly "Enrollment"
      described as {
        |The enrollment being opened.
      }
    }
    learnerId: LearnerId with {
      briefly "Learner"
      described as {
        |The learner this enrollment belongs to.
      }
    }
    courseId: CourseId with {
      briefly "Course"
      described as {
        |The course the learner has enrolled in.
      }
    }
  } with {
    briefly "Open an enrollment for one learner on one course"
    described as {
      |Raised when a learner joins a course. The enrollment is the aggregate
      |that tracks that one learner's progress, which the course cannot do
      |because a course serves many learners at once.
    }
  }
  command RecordLearnerActivity is {
    learnerEnrollmentId: LearnerEnrollmentId with {
      briefly "Enrollment"
      described as {
        |The enrollment the learner acted on.
      }
    }
    activityAt: TimeStamp with {
      briefly "When"
      described as {
        |When the learner did something on this course.
      }
    }
  } with {
    briefly "Record that the learner did something on this course"
    described as {
      |Any activity at all — opening a module, submitting an assessment,
      |recording progress. It exists so that silence is measurable: the
      |enrollment's quiescence window is what has not happened since the
      |last one of these.
    }
  }
  command CompleteLearnerEnrollment is {
    learnerEnrollmentId: LearnerEnrollmentId with {
      briefly "Enrollment"
      described as {
        |The enrollment being completed.
      }
    }
    completedAt: TimeStamp with {
      briefly "When"
      described as {
        |When the learner finished the course.
      }
    }
  } with {
    briefly "Complete the enrollment"
    described as {
      |The learner has finished. A completed enrollment is no longer nudged,
      |which is why completion changes the state rather than only recording
      |a fact.
    }
  }
  command NudgeLearner is {
    learnerEnrollmentId: LearnerEnrollmentId with {
      briefly "Enrollment"
      described as {
        |The enrollment that has gone quiet.
      }
    }
    learnerId: LearnerId with {
      briefly "Learner"
      described as {
        |The learner to nudge.
      }
    }
    courseId: CourseId with {
      briefly "Course"
      described as {
        |The course they have stopped working on.
      }
    }
  } with {
    briefly "Nudge a learner who has stopped progressing"
    described as {
      |Sent by the enrollment to itself when its quiescence window elapses.
      |Nothing else sends it: the only thing that can observe an absence of
      |activity is the aggregate the activity would have reached.
    }
  }
  event LearnerEnrollmentOpened is {
    learnerEnrollmentId: LearnerEnrollmentId with {
      briefly "Enrollment"
      described as {
        |The enrollment that was opened.
      }
    }
    learnerId: LearnerId with {
      briefly "Learner"
      described as {
        |The learner enrolled.
      }
    }
    courseId: CourseId with {
      briefly "Course"
      described as {
        |The course enrolled in.
      }
    }
  } with {
    briefly "An enrollment was opened"
    described as {
      |A learner has joined a course and their progress is now tracked.
    }
  }
  event LearnerActivityRecorded is {
    learnerEnrollmentId: LearnerEnrollmentId with {
      briefly "Enrollment"
      described as {
        |The enrollment the learner acted on.
      }
    }
    activityAt: TimeStamp with {
      briefly "When"
      described as {
        |When the activity happened.
      }
    }
  } with {
    briefly "The learner did something on this course"
    described as {
      |Recorded so that the enrollment's silence has a starting point.
    }
  }
  event LearnerEnrollmentCompleted is {
    learnerEnrollmentId: LearnerEnrollmentId with {
      briefly "Enrollment"
      described as {
        |The enrollment that completed.
      }
    }
    completedAt: TimeStamp with {
      briefly "When"
      described as {
        |When the learner finished.
      }
    }
  } with {
    briefly "The learner finished the course"
    described as {
      |Ends the enrollment's active life, and with it the nudging.
    }
  }
  event LearnerWentQuiet is {
    learnerEnrollmentId: LearnerEnrollmentId with {
      briefly "Enrollment"
      described as {
        |The enrollment that went quiet.
      }
    }
    learnerId: LearnerId with {
      briefly "Learner"
      described as {
        |The learner who stopped.
      }
    }
    courseId: CourseId with {
      briefly "Course"
      described as {
        |The course they stopped working on.
      }
    }
  } with {
    briefly "A learner stopped progressing on a course"
    described as {
      |Raised when the enrollment's quiescence window elapses with no
      |activity. It is the enrollment's judgement that the learner has
      |stalled, not the notifier's, which is why the fact is recorded here
      |and translated to a reminder at the boundary.
    }
  }
  record ActiveLearnerEnrollmentData is {
    learnerEnrollmentId: LearnerEnrollmentId with {
      briefly "Enrollment"
      described as {
        |The enrollment this record represents.
      }
    }
    learnerId: LearnerId with {
      briefly "Learner"
      described as {
        |The enrolled learner.
      }
    }
    courseId: CourseId with {
      briefly "Course"
      described as {
        |The course being taken.
      }
    }
    lastActivityAt: TimeStamp with {
      briefly "Last activity"
      described as {
        |When the learner last did anything on this course.
      }
    }
  } with {
    briefly "Active enrollment data"
    described as {
      |What an enrollment holds while the learner is still working.
    }
  }
  record CompletedLearnerEnrollmentData is {
    learnerEnrollmentId: LearnerEnrollmentId with {
      briefly "Enrollment"
      described as {
        |The enrollment this record represents.
      }
    }
    completedAt: TimeStamp with {
      briefly "When"
      described as {
        |When the learner finished.
      }
    }
  } with {
    briefly "Completed enrollment data"
    described as {
      |What an enrollment holds once the learner has finished.
    }
  }
  initial state ActiveState of record LearnerEnrollment.ActiveLearnerEnrollmentData is {
    initial handler ActiveStateInitHandler is {
      on init is {
        set state ActiveState to "initialize LearnerEnrollment.ActiveLearnerEnrollmentData fields from the creating message"
      }
      on quiescence "14 days" is {
        tell command NudgeLearner(learnerEnrollmentId = self.id, learnerId = prompt("the learner on this enrollment"), courseId = prompt("the course this enrollment is for")) to entity LearningContext.LearnerEnrollment
      }
    } with {
      briefly "ActiveState initialization"
      described as {
        |Initializes ActiveState, and carries the quiescence window that
        |decides a learner has stalled. The clause is armed only while the
        |enrollment is active, so a completed course is never nudged.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |The learner is enrolled and has not finished.
    }
  }
  state CompletedState of record LearnerEnrollment.CompletedLearnerEnrollmentData is {
    initial handler CompletedStateInitHandler is {
      on init is {
        set state CompletedState to "initialize from prior event"
      }
      on other is {
        error "A completed enrollment accepts no further messages"
      }
    } with {
      briefly "Completed state init handler"
      described as {
        |A completed enrollment does nothing further, and notably carries no
        |quiescence clause: silence after completion means finished, not
        |stalled.
      }
    }
  } with {
    briefly "Completed state"
    described as {
      |The learner has finished the course.
    }
  }
  handler LearnerEnrollmentHandler is {
    on openEnrollment: command OpenLearnerEnrollment is {
      tell event LearnerEnrollmentOpened(learnerEnrollmentId = openEnrollment.learnerEnrollmentId, learnerId = openEnrollment.learnerId, courseId = openEnrollment.courseId) to entity LearningContext.LearnerEnrollment
    }
    on recordLearnerActivity: command RecordLearnerActivity is {
      tell event LearnerActivityRecorded(learnerEnrollmentId = recordLearnerActivity.learnerEnrollmentId, activityAt = recordLearnerActivity.activityAt) to entity LearningContext.LearnerEnrollment
    }
    on completeEnrollment: command CompleteLearnerEnrollment is {
      morph entity LearningContext.LearnerEnrollment to state LearningContext.LearnerEnrollment.CompletedState with record LearnerEnrollment.CompletedLearnerEnrollmentData(learnerEnrollmentId = completeEnrollment.learnerEnrollmentId, completedAt = completeEnrollment.completedAt)
      tell event LearnerEnrollmentCompleted(learnerEnrollmentId = completeEnrollment.learnerEnrollmentId, completedAt = completeEnrollment.completedAt) to entity LearningContext.LearnerEnrollment
    }
    on nudgeLearner: command NudgeLearner is {
      tell event LearnerWentQuiet(learnerEnrollmentId = nudgeLearner.learnerEnrollmentId, learnerId = nudgeLearner.learnerId, courseId = nudgeLearner.courseId) to entity LearningContext.LearnerEnrollment
    }
    on enrollmentOpened: event LearnerEnrollmentOpened is {
      do "apply LearnerEnrollmentOpened to the enrollment so it can be persisted and replayed"
    }
    on learnerActivityRecorded: event LearnerActivityRecorded is {
      do "apply LearnerActivityRecorded to the enrollment so it can be persisted and replayed"
    }
    on enrollmentCompleted: event LearnerEnrollmentCompleted is {
      do "apply LearnerEnrollmentCompleted to the enrollment so it can be persisted and replayed"
    }
    on learnerWentQuiet: event LearnerWentQuiet is {
      do "apply LearnerWentQuiet to the enrollment so it can be persisted and replayed"
      send learnerWentQuiet to outlet LearnerEnrollmentEvents
    }
    on query GetLearnerEnrollment is {
      let learnerEnrollmentResult: type LearnerEnrollmentResult = prompt("read this learner's enrollment from the store")
      reply learnerEnrollmentResult
    }
    on other is {
      error "Unexpected message for entity LearnerEnrollment"
    }
  } with {
    briefly "Enrollment handler"
    described as {
      |Handles the enrollment's commands and applies its events.
    }
  }
} with {
  briefly "One learner's progress on one course"
  described as {
    |The aggregate a per-learner clock can attach to. Course serves many
    |learners at once, so a quiescence window there would mean nobody
    |touched the course rather than that one learner stalled.
  }
}
