// Learning Management - Learning Context
context LearningContext is {
  include "types.riddl"
  include "Course.riddl"
  // Repository for course persistence
  repository CourseRepository is {
    schema CourseData is relational
      of courses as type Course
        index on field Course.courseId
        index on field Course.info.title

    handler CoursePersistence is {
      on command Course.CreateCourse is {
        tell event Course.CourseCreated to entity LearningContext.Course
        prompt "Store new course record"
      }
      on command Course.AddModule is {
        tell event Course.ModuleAdded to entity LearningContext.Course
        prompt "Store module record"
      }
      on command Course.AddContent is {
        tell event Course.ContentAdded to entity LearningContext.Course
        prompt "Store content record"
      }
      on command Course.EnrollLearner is {
        prompt "Store enrollment record"
      }
      on command Course.RecordProgress is {
        tell event Course.ProgressRecorded to entity LearningContext.Course
        prompt "Update progress record"
      }
      on command Course.GradeAssessment is {
        prompt "Store grade record"
      }
      on command Course.CompleteCourse is {
        tell event Course.CourseCompleted to entity LearningContext.Course
        prompt "Update enrollment completion"
      }
    } with {
      briefly "Persists course commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Course data persistence"
    described as {
      | The CourseRepository provides persistent storage for
      | courses, modules, content, and learner progress.
    }
  }
  // Projector for learning analytics
  projector LearningAnalytics is {
    updates repository LearningContext.CourseRepository
    record ProgressSummary is  {
      courseId: CourseId with {
        briefly "Course"
        described as {
          |Course ID.
        }
      }
      totalEnrollments: Natural with {
        briefly "Enrollments"
        described as {
          |Total enrollments.
        }
      }
      completionRate: Decimal(5,2) with {
        briefly "Completion"
        described as {
          |Completion rate.
        }
      }
      averageScore: Decimal(5,2) with {
        briefly "Avg score"
        described as {
          |Average assessment score.
        }
      }
      averageTimeToComplete: Duration with {
        briefly "Avg time"
        described as {
          |Average completion time.
        }
      }
    } with {
      briefly "Progress summary"
      described as {
        |Course progress metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Course.LearnerEnrolled is {
        tell event Course.LearnerEnrolled to repository LearningContext.CourseRepository
        prompt "Update enrollment counts"
      }
      on event Course.ProgressRecorded is {
        tell event Course.ProgressRecorded to repository LearningContext.CourseRepository
        prompt "Update progress metrics"
      }
      on event Course.AssessmentGraded is {
        tell event Course.AssessmentGraded to repository LearningContext.CourseRepository
        prompt "Update score analytics"
      }
      on event Course.CourseCompleted is {
        tell event Course.CourseCompleted to repository LearningContext.CourseRepository
        prompt "Update completion metrics"
      }
    } with {
      briefly "Maintains learning analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Learning analytics projections"
    described as {
      |Maintains learning analytics data.
    }
  }
  // ---- Event publication for Course ----
  type CourseEvent is one of {
    LearningContext.Course.CourseCreated,
    LearningContext.Course.CourseUpdated,
    LearningContext.Course.ModuleAdded,
    LearningContext.Course.ModuleUpdated,
    LearningContext.Course.ModuleRemoved,
    LearningContext.Course.ContentAdded,
    LearningContext.Course.CoursePublished,
    LearningContext.Course.CourseArchived,
    LearningContext.Course.LearnerEnrolled,
    LearningContext.Course.ProgressRecorded,
    LearningContext.Course.AssessmentSubmitted,
    LearningContext.Course.AssessmentGraded,
    LearningContext.Course.CourseCompleted
  } with {
    briefly "Course event alternation"
    described as {
      |Union of all Course events, for streaming and event-sourced
      |persistence.
    }
  }
  source CourseEventSource is {
    outlet CourseEvents is type CourseEvent
    handler CourseSourceHandler is {
      on event Course.CourseCreated is {
        send event Course.CourseCreated to outlet CourseEvents
      }
      on event Course.CourseUpdated is {
        send event Course.CourseUpdated to outlet CourseEvents
      }
      on event Course.ModuleAdded is {
        send event Course.ModuleAdded to outlet CourseEvents
      }
      on event Course.ModuleUpdated is {
        send event Course.ModuleUpdated to outlet CourseEvents
      }
      on event Course.ModuleRemoved is {
        send event Course.ModuleRemoved to outlet CourseEvents
      }
      on event Course.ContentAdded is {
        send event Course.ContentAdded to outlet CourseEvents
      }
      on event Course.CoursePublished is {
        send event Course.CoursePublished to outlet CourseEvents
      }
      on event Course.CourseArchived is {
        send event Course.CourseArchived to outlet CourseEvents
      }
      on event Course.LearnerEnrolled is {
        send event Course.LearnerEnrolled to outlet CourseEvents
      }
      on event Course.ProgressRecorded is {
        send event Course.ProgressRecorded to outlet CourseEvents
      }
      on event Course.AssessmentSubmitted is {
        send event Course.AssessmentSubmitted to outlet CourseEvents
      }
      on event Course.AssessmentGraded is {
        send event Course.AssessmentGraded to outlet CourseEvents
      }
      on event Course.CourseCompleted is {
        send event Course.CourseCompleted to outlet CourseEvents
      }
      on other is {
        error "Unexpected message for source CourseEventSource"
      }
    } with {
      briefly "Course source handler"
      described as {
        |Publishes Course events onto the outlet.
      }
    }
  } with {
    briefly "Course event source"
    described as {
      |Publishes Course entity events into the streaming topology.
    }
  }
  sink CourseEventSink is {
    inlet CourseInlet is type CourseEvent
    handler CourseSinkHandler is {
      on event Course.CourseCreated is {
        tell event Course.CourseCreated to repository LearningContext.CourseRepository
      }
      on event Course.CourseUpdated is {
        tell event Course.CourseUpdated to repository LearningContext.CourseRepository
      }
      on event Course.ModuleAdded is {
        tell event Course.ModuleAdded to repository LearningContext.CourseRepository
      }
      on event Course.ModuleUpdated is {
        tell event Course.ModuleUpdated to repository LearningContext.CourseRepository
      }
      on event Course.ModuleRemoved is {
        tell event Course.ModuleRemoved to repository LearningContext.CourseRepository
      }
      on event Course.ContentAdded is {
        tell event Course.ContentAdded to repository LearningContext.CourseRepository
      }
      on event Course.CoursePublished is {
        tell event Course.CoursePublished to repository LearningContext.CourseRepository
      }
      on event Course.CourseArchived is {
        tell event Course.CourseArchived to repository LearningContext.CourseRepository
      }
      on event Course.LearnerEnrolled is {
        tell event Course.LearnerEnrolled to repository LearningContext.CourseRepository
      }
      on event Course.ProgressRecorded is {
        tell event Course.ProgressRecorded to repository LearningContext.CourseRepository
      }
      on event Course.AssessmentSubmitted is {
        tell event Course.AssessmentSubmitted to repository LearningContext.CourseRepository
      }
      on event Course.AssessmentGraded is {
        tell event Course.AssessmentGraded to repository LearningContext.CourseRepository
      }
      on event Course.CourseCompleted is {
        tell event Course.CourseCompleted to repository LearningContext.CourseRepository
      }
      on other is {
        error "Unexpected message for sink CourseEventSink"
      }
    } with {
      briefly "Course sink handler"
      described as {
        |Persists Course events via the repository.
      }
    }
  } with {
    briefly "Course event sink"
    described as {
      |Receives Course events for persistence.
    }
  }
  connector CourseEventFlow is {
    from outlet LearningContext.CourseEventSource.CourseEvents to
      inlet LearningContext.CourseEventSink.CourseInlet
  } with {
    briefly "Course event flow"
    described as {
      |Connects the Course source to its sink.
    }
  }
} with {
  briefly "Bounded context for learning management"
  described as {
    | The LearningContext is the bounded context for online
    | course delivery, content management, and learner engagement.
  }
}
