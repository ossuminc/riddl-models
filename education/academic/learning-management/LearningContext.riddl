// Learning Management - Learning Context
context LearningContext as router is {
  inlet CourseCommandStreamIn is type CourseCommand  outlet CourseCommandStreamOut is type CourseCommand
  inlet CourseResultStreamIn is type Course.CourseResult  outlet CourseResultStreamOut is type Course.CourseResult
  handler LearningContextBoundary is {
    on createCourse: command Course.CreateCourse is {
      send createCourse to outlet LearningContext.CourseCommandStreamOut
    }
    on updateCourse: command Course.UpdateCourse is {
      send updateCourse to outlet LearningContext.CourseCommandStreamOut
    }
    on addModule: command Course.AddModule is {
      send addModule to outlet LearningContext.CourseCommandStreamOut
    }
    on updateModule: command Course.UpdateModule is {
      send updateModule to outlet LearningContext.CourseCommandStreamOut
    }
    on removeModule: command Course.RemoveModule is {
      send removeModule to outlet LearningContext.CourseCommandStreamOut
    }
    on addContent: command Course.AddContent is {
      send addContent to outlet LearningContext.CourseCommandStreamOut
    }
    on publishCourse: command Course.PublishCourse is {
      send publishCourse to outlet LearningContext.CourseCommandStreamOut
    }
    on archiveCourse: command Course.ArchiveCourse is {
      send archiveCourse to outlet LearningContext.CourseCommandStreamOut
    }
    on enrollLearner: command Course.EnrollLearner is {
      send enrollLearner to outlet LearningContext.CourseCommandStreamOut
    }
    on recordProgress: command Course.RecordProgress is {
      send recordProgress to outlet LearningContext.CourseCommandStreamOut
    }
    on submitAssessment: command Course.SubmitAssessment is {
      send submitAssessment to outlet LearningContext.CourseCommandStreamOut
    }
    on gradeAssessment: command Course.GradeAssessment is {
      send gradeAssessment to outlet LearningContext.CourseCommandStreamOut
    }
    on completeCourse: command Course.CompleteCourse is {
      send completeCourse to outlet LearningContext.CourseCommandStreamOut
    }
    on courseResult: result Course.CourseResult is {
      send courseResult to outlet LearningContext.CourseResultStreamOut
    }
    on other is {
      error "Unexpected message at the LearningContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CourseCommand Stream Intake' is from outlet LearningContext.CourseCommandStreamOut to inlet LearningContext.Course.CourseCommands  connector 'CourseResult Stream Egress' is from outlet LearningContext.CourseRepository.CourseRepositoryResponses to inlet LearningContext.CourseResultStreamIn  adaptor FromCertificationService from context CertificationService is { 
    handler FromCertificationServiceHandler is {
      on event CertificationService.CertificateIssued is {
        do "the model receives certificate issued"
      }
      on other is {
        error "Unexpected message for adaptor FromCertificationService"
      }
    } with {
      briefly "from certification service"
      described as {
        |Carries messages from the external CertificationService.
      }
    }
  } with {
    briefly "CertificationService integration"
    described as {
      |The model's side of the CertificationService conversation.
    }
  }
  adaptor ToCertificationService to context CertificationService is { 
    handler ToCertificationServiceHandler is {
      on command CertificationService.IssueCertificate is {
        do "the model sends issue certificate"
      }
      on other is {
        error "Unexpected message for adaptor ToCertificationService"
      }
    } with {
      briefly "to certification service"
      described as {
        |Carries messages to the external CertificationService.
      }
    }
  } with {
    briefly "CertificationService integration"
    described as {
      |The model's side of the CertificationService conversation.
    }
  }
  adaptor FromContentDeliveryService from context ContentDeliveryService is { 
    handler FromContentDeliveryServiceHandler is {
      on event ContentDeliveryService.ContentStreamed is {
        do "the model receives content streamed"
      }
      on other is {
        error "Unexpected message for adaptor FromContentDeliveryService"
      }
    } with {
      briefly "from content delivery service"
      described as {
        |Carries messages from the external ContentDeliveryService.
      }
    }
  } with {
    briefly "ContentDeliveryService integration"
    described as {
      |The model's side of the ContentDeliveryService conversation.
    }
  }
  adaptor ToContentDeliveryService to context ContentDeliveryService is { 
    handler ToContentDeliveryServiceHandler is {
      on command ContentDeliveryService.StreamContent is {
        do "the model sends stream content"
      }
      on other is {
        error "Unexpected message for adaptor ToContentDeliveryService"
      }
    } with {
      briefly "to content delivery service"
      described as {
        |Carries messages to the external ContentDeliveryService.
      }
    }
  } with {
    briefly "ContentDeliveryService integration"
    described as {
      |The model's side of the ContentDeliveryService conversation.
    }
  }
  adaptor FromIdentityService from context IdentityService is { 
    handler FromIdentityServiceHandler is {
      on event IdentityService.LearnerAuthenticated is {
        do "the model receives learner authenticated"
      }
      on event IdentityService.SessionExpired is {
        do "the model receives session expired"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityService"
      }
    } with {
      briefly "from identity service"
      described as {
        |Carries messages from the external IdentityService.
      }
    }
  } with {
    briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendCourseCompletion is {
        do "the model sends send course completion"
      }
      on command NotificationService.SendProgressReminder is {
        do "the model sends send progress reminder"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "Course.riddl"
  // Repository for course persistence
  type CourseRepositoryCommand is one of {
    LearningContext.CourseRepository.PersistAssessmentGraded or LearningContext.CourseRepository.PersistAssessmentSubmitted or LearningContext.CourseRepository.PersistContentAdded or LearningContext.CourseRepository.PersistCourseArchived or LearningContext.CourseRepository.PersistCourseCompleted or LearningContext.CourseRepository.PersistCourseCreated or LearningContext.CourseRepository.PersistCoursePublished or LearningContext.CourseRepository.PersistCourseUpdated or LearningContext.CourseRepository.PersistLearnerEnrolled or LearningContext.CourseRepository.PersistModuleAdded or LearningContext.CourseRepository.PersistModuleRemoved or LearningContext.CourseRepository.PersistModuleUpdated or LearningContext.CourseRepository.PersistProgressRecorded
  } with {
    briefly "Anything that writes CourseRepository"
    described as {
      |The persistence commands CourseRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository CourseRepository as flow is {
    inlet CourseRepositoryFromLearningAnalytics is type CourseRepositoryCommand
    command PersistAssessmentSubmitted is  {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssessmentSubmitted applies to.
        }
      }
    } with {
      briefly "Persist AssessmentSubmitted"
      described as {
        |Instructs this repository to apply AssessmentSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContentAdded is  {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContentAdded applies to.
        }
      }
    } with {
      briefly "Persist ContentAdded"
      described as {
        |Instructs this repository to apply ContentAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCourseArchived is  {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CourseArchived applies to.
        }
      }
    } with {
      briefly "Persist CourseArchived"
      described as {
        |Instructs this repository to apply CourseArchived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCourseCreated is  {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CourseCreated applies to.
        }
      }
    } with {
      briefly "Persist CourseCreated"
      described as {
        |Instructs this repository to apply CourseCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCoursePublished is  {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CoursePublished applies to.
        }
      }
    } with {
      briefly "Persist CoursePublished"
      described as {
        |Instructs this repository to apply CoursePublished to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCourseUpdated is  {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CourseUpdated applies to.
        }
      }
    } with {
      briefly "Persist CourseUpdated"
      described as {
        |Instructs this repository to apply CourseUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistModuleAdded is  {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row ModuleAdded applies to.
        }
      }
    } with {
      briefly "Persist ModuleAdded"
      described as {
        |Instructs this repository to apply ModuleAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistModuleRemoved is  {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row ModuleRemoved applies to.
        }
      }
    } with {
      briefly "Persist ModuleRemoved"
      described as {
        |Instructs this repository to apply ModuleRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistModuleUpdated is  {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row ModuleUpdated applies to.
        }
      }
    } with {
      briefly "Persist ModuleUpdated"
      described as {
        |Instructs this repository to apply ModuleUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAssessmentGraded is  {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssessmentGraded applies to.
        }
      }
    } with {
      briefly "Persist AssessmentGraded"
      described as {
        |Instructs this repository to apply AssessmentGraded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCourseCompleted is  {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CourseCompleted applies to.
        }
      }
    } with {
      briefly "Persist CourseCompleted"
      described as {
        |Instructs this repository to apply CourseCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLearnerEnrolled is  {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row LearnerEnrolled applies to.
        }
      }
    } with {
      briefly "Persist LearnerEnrolled"
      described as {
        |Instructs this repository to apply LearnerEnrolled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProgressRecorded is  {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProgressRecorded applies to.
        }
      }
    } with {
      briefly "Persist ProgressRecorded"
      described as {
        |Instructs this repository to apply ProgressRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet CourseRepositoryResponses is type Course.CourseResult
    record StoredCourse is  {
      courseId: CourseId with {
        briefly "courseId"
        described as {
          |The courseId column of the stored course row.
        }
      }
      info: CourseInfo with {
        briefly "info"
        described as {
          |The info column of the stored course row.
        }
      }
    } with {
      briefly "Stored course row"
      described as {
        |The persistence shape of course data as this repository stores it.
      }
    }
    schema CourseData is relational
      of courses as type StoredCourse
        index on field StoredCourse.courseId
        index on field StoredCourse.info.title
 with {
      briefly "Course data schema"
      described as {
        |The relational schema holding course data for the CourseRepository.
      }
    }
    handler CoursePersistence is {
      on persistAssessmentSubmitted: command PersistAssessmentSubmitted is {
        do "apply AssessmentSubmitted to the stored row"
      }
      on persistContentAdded: command PersistContentAdded is {
        do "apply ContentAdded to the stored row"
      }
      on persistCourseArchived: command PersistCourseArchived is {
        do "apply CourseArchived to the stored row"
      }
      on persistCourseCreated: command PersistCourseCreated is {
        do "apply CourseCreated to the stored row"
      }
      on persistCoursePublished: command PersistCoursePublished is {
        do "apply CoursePublished to the stored row"
      }
      on persistCourseUpdated: command PersistCourseUpdated is {
        do "apply CourseUpdated to the stored row"
      }
      on persistModuleAdded: command PersistModuleAdded is {
        do "apply ModuleAdded to the stored row"
      }
      on persistModuleRemoved: command PersistModuleRemoved is {
        do "apply ModuleRemoved to the stored row"
      }
      on persistModuleUpdated: command PersistModuleUpdated is {
        do "apply ModuleUpdated to the stored row"
      }
      on persistAssessmentGraded: command PersistAssessmentGraded is {
        do "apply AssessmentGraded to the stored row"
      }
      on persistCourseCompleted: command PersistCourseCompleted is {
        do "apply CourseCompleted to the stored row"
      }
      on persistLearnerEnrolled: command PersistLearnerEnrolled is {
        do "apply LearnerEnrolled to the stored row"
      }
      on persistProgressRecorded: command PersistProgressRecorded is {
        do "apply ProgressRecorded to the stored row"
      }
      on query GetProgressSummary is {
        let progressSummaryView: type ProgressSummaryView = prompt("read the progress summary projection")
        reply progressSummaryView
      }
    } with {
      briefly "Persists course commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Course data persistence"
    described as {
      | The CourseRepository provides persistent storage for
      | courses, modules, content, and learner progress.
    }
  }
  // Projector for learning analytics
  query GetProgressSummary replies result ProgressSummaryView is  {
    progressSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which progress summary to retrieve.
      }
    }
  } with {
    briefly "Get progress summary"
    described as {
      |Retrieves the progress summary projection.
    }
  }
  result ProgressSummaryView is  {
    progressSummary: LearningAnalytics.ProgressSummary with {
      briefly "Progress summary"
      described as {
        |The progress summary being returned.
      }
    }
  } with {
    briefly "Progress summary view"
    described as {
      |Read model view carrying the progress summary projection.
    }
  }
  projector LearningAnalytics as flow is {
    outlet LearningAnalyticsToRepository is type CourseRepositoryCommand
    updates repository LearningContext.CourseRepository
    inlet LearningAnalyticsFromCourse is type CourseEvent
    record ProgressSummary is  {
      courseId: CourseId with {
        briefly "Course"
        described as {
          |Course ID.
        }
      }
      totalEnrollments: Natural with {
        briefly "Enrollments"
        described as {
          |Total enrollments.
        }
      }
      completionRate: Decimal(5,2) with {
        briefly "Completion"
        described as {
          |Completion rate.
        }
      }
      averageScore: Decimal(5,2) with {
        briefly "Avg score"
        described as {
          |Average assessment score.
        }
      }
      averageTimeToComplete: Duration with {
        briefly "Avg time"
        described as {
          |Average completion time.
        }
      }
    } with {
      briefly "Progress summary"
      described as {
        |Course progress metrics.
      }
    }
    handler AnalyticsHandler is {
      on assessmentSubmitted: event Course.AssessmentSubmitted is {
        tell command LearningContext.CourseRepository.PersistAssessmentSubmitted(courseId = assessmentSubmitted.courseId) to repository LearningContext.CourseRepository
        do "apply AssessmentSubmitted to the LearningAnalytics projection"
      }
      on contentAdded: event Course.ContentAdded is {
        tell command LearningContext.CourseRepository.PersistContentAdded(courseId = contentAdded.courseId) to repository LearningContext.CourseRepository
        do "apply ContentAdded to the LearningAnalytics projection"
      }
      on courseArchived: event Course.CourseArchived is {
        tell command LearningContext.CourseRepository.PersistCourseArchived(courseId = courseArchived.courseId) to repository LearningContext.CourseRepository
        do "apply CourseArchived to the LearningAnalytics projection"
      }
      on courseCreated: event Course.CourseCreated is {
        tell command LearningContext.CourseRepository.PersistCourseCreated(courseId = courseCreated.courseId) to repository LearningContext.CourseRepository
        do "apply CourseCreated to the LearningAnalytics projection"
      }
      on coursePublished: event Course.CoursePublished is {
        tell command LearningContext.CourseRepository.PersistCoursePublished(courseId = coursePublished.courseId) to repository LearningContext.CourseRepository
        do "apply CoursePublished to the LearningAnalytics projection"
      }
      on courseUpdated: event Course.CourseUpdated is {
        tell command LearningContext.CourseRepository.PersistCourseUpdated(courseId = courseUpdated.courseId) to repository LearningContext.CourseRepository
        do "apply CourseUpdated to the LearningAnalytics projection"
      }
      on moduleAdded: event Course.ModuleAdded is {
        tell command LearningContext.CourseRepository.PersistModuleAdded(courseId = moduleAdded.courseId) to repository LearningContext.CourseRepository
        do "apply ModuleAdded to the LearningAnalytics projection"
      }
      on moduleRemoved: event Course.ModuleRemoved is {
        tell command LearningContext.CourseRepository.PersistModuleRemoved(courseId = moduleRemoved.courseId) to repository LearningContext.CourseRepository
        do "apply ModuleRemoved to the LearningAnalytics projection"
      }
      on moduleUpdated: event Course.ModuleUpdated is {
        tell command LearningContext.CourseRepository.PersistModuleUpdated(courseId = moduleUpdated.courseId) to repository LearningContext.CourseRepository
        do "apply ModuleUpdated to the LearningAnalytics projection"
      }
      on learnerEnrolled: event Course.LearnerEnrolled is {
        tell command LearningContext.CourseRepository.PersistLearnerEnrolled(courseId = learnerEnrolled.courseId) to repository LearningContext.CourseRepository
        do "Update enrollment counts"
      }
      on progressRecorded: event Course.ProgressRecorded is {
        tell command LearningContext.CourseRepository.PersistProgressRecorded(courseId = progressRecorded.courseId) to repository LearningContext.CourseRepository
        do "Update progress metrics"
      }
      on assessmentGraded: event Course.AssessmentGraded is {
        tell command LearningContext.CourseRepository.PersistAssessmentGraded(courseId = assessmentGraded.courseId) to repository LearningContext.CourseRepository
        do "Update score analytics"
      }
      on courseCompleted: event Course.CourseCompleted is {
        tell command LearningContext.CourseRepository.PersistCourseCompleted(courseId = courseCompleted.courseId) to repository LearningContext.CourseRepository
        do "Update completion metrics"
      }
    } with {
      briefly "Maintains learning analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Learning analytics projections"
    described as {
      |Maintains learning analytics data.
    }
  }
  // ---- Event publication for Course ----
  type CourseEvent is one of {
    LearningContext.Course.CourseCreated or LearningContext.Course.CourseUpdated or LearningContext.Course.ModuleAdded or LearningContext.Course.ModuleUpdated or LearningContext.Course.ModuleRemoved or LearningContext.Course.ContentAdded or LearningContext.Course.CoursePublished or LearningContext.Course.CourseArchived or LearningContext.Course.LearnerEnrolled or LearningContext.Course.ProgressRecorded or LearningContext.Course.AssessmentSubmitted or LearningContext.Course.AssessmentGraded or LearningContext.Course.CourseCompleted
  } with {
    briefly "Course event alternation"
    described as {
      |Union of all Course events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CourseEventSplit as flow is {
    inlet CourseEventSplitIn is type CourseEvent
    outlet CourseEventSplitToLearningAnalytics is type CourseEvent
    handler CourseEventSplitHandler is {
      on courseCreated: event Course.CourseCreated is {
        send courseCreated to outlet CourseEventSplitToLearningAnalytics
        tell courseCreated to entity LearningContext.Course
      }
      on courseUpdated: event Course.CourseUpdated is {
        send courseUpdated to outlet CourseEventSplitToLearningAnalytics
        tell courseUpdated to entity LearningContext.Course
      }
      on moduleAdded: event Course.ModuleAdded is {
        send moduleAdded to outlet CourseEventSplitToLearningAnalytics
        tell moduleAdded to entity LearningContext.Course
      }
      on moduleUpdated: event Course.ModuleUpdated is {
        send moduleUpdated to outlet CourseEventSplitToLearningAnalytics
        tell moduleUpdated to entity LearningContext.Course
      }
      on moduleRemoved: event Course.ModuleRemoved is {
        send moduleRemoved to outlet CourseEventSplitToLearningAnalytics
        tell moduleRemoved to entity LearningContext.Course
      }
      on contentAdded: event Course.ContentAdded is {
        send contentAdded to outlet CourseEventSplitToLearningAnalytics
        tell contentAdded to entity LearningContext.Course
      }
      on coursePublished: event Course.CoursePublished is {
        send coursePublished to outlet CourseEventSplitToLearningAnalytics
        tell coursePublished to entity LearningContext.Course
      }
      on courseArchived: event Course.CourseArchived is {
        send courseArchived to outlet CourseEventSplitToLearningAnalytics
        tell courseArchived to entity LearningContext.Course
      }
      on learnerEnrolled: event Course.LearnerEnrolled is {
        send learnerEnrolled to outlet CourseEventSplitToLearningAnalytics
        tell learnerEnrolled to entity LearningContext.Course
      }
      on progressRecorded: event Course.ProgressRecorded is {
        send progressRecorded to outlet CourseEventSplitToLearningAnalytics
        tell progressRecorded to entity LearningContext.Course
      }
      on assessmentSubmitted: event Course.AssessmentSubmitted is {
        send assessmentSubmitted to outlet CourseEventSplitToLearningAnalytics
        tell assessmentSubmitted to entity LearningContext.Course
      }
      on assessmentGraded: event Course.AssessmentGraded is {
        send assessmentGraded to outlet CourseEventSplitToLearningAnalytics
        tell assessmentGraded to entity LearningContext.Course
      }
      on courseCompleted: event Course.CourseCompleted is {
        send courseCompleted to outlet CourseEventSplitToLearningAnalytics
        tell courseCompleted to entity LearningContext.Course
      }
      on other is {
        error "Unexpected message for processor CourseEventSplit"
      }
    } with {
      briefly "Course event fan-out handler"
      described as {
        |Delivers each Course event to all of its consumers.
      }
    }
  } with {
    briefly "Course event fan-out"
    described as {
      |Fans Course events out to the repository and projectors.
    }
  }
  connector 'CourseEvent Stream' is from outlet LearningContext.Course.CourseEvents2 to inlet LearningContext.CourseEventSplit.CourseEventSplitIn with {
    briefly "Course events, fanned out to storage and read models"
  }
  connector 'LearningAnalytics Feed' is from outlet LearningContext.CourseEventSplit.CourseEventSplitToLearningAnalytics to inlet LearningContext.LearningAnalytics.LearningAnalyticsFromCourse with {
    briefly "Course events feeding the LearningAnalytics projection"
  }
  connector 'LearningAnalytics Storage' is from outlet LearningContext.LearningAnalytics.LearningAnalyticsToRepository to inlet LearningContext.CourseRepository.CourseRepositoryFromLearningAnalytics with {
    briefly "LearningAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for learning management"
  described as {
    | The LearningContext is the bounded context for online
    | course delivery, content management, and learner engagement.
  }
}
