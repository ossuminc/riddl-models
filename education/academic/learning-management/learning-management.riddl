// Learning Management System Domain Model
// Online course delivery, content management, and learner engagement
domain LearningManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Instructor is "faculty creating and teaching courses" with {
    briefly "Instructor"
    described as {
      |Person who creates and delivers course content.
    }
  }
  user Learner is "student taking online courses" with {
    briefly "Learner"
    described as {
      |Person enrolled in and taking courses.
    }
  }
  user ContentAdmin is "administrator managing learning content" with {
    briefly "Content Admin"
    described as {
      |Staff managing content library and courses.
    }
  }
  epic CourseCompletionEpic is {
    user Learner wants to "to complete courses and track progress" so that "they can achieve learning objectives"
    case CompleteCourseModule is {
      user Learner wants to "to work through course modules" so that "they can learn the material"
      step is "Learner accesses course" "in learning portal" "at their convenience" with {
        briefly "Access course"
        described as {
          |Learner opens course.
        }
      }
      step is "Learner views content" "including videos and readings" "for current module" with {
        briefly "View content"
        described as {
          |Learner consumes content.
        }
      }
      step take input LearningManagementApp.LearningManagementScreen.RecordProgressInput from user Learner with {
        briefly "Record progress"
        described as {
          |System tracks completion.
        }
      }
      step is "System updates progress" "and unlocks next content" "based on completion" with {
        briefly "Update progress"
        described as {
          |System advances learner.
        }
      }
    } with {
      briefly "Module completion workflow"
      described as {
        |Standard flow for completing course modules.
      }
    }
  } with {
    briefly "Course completion processing"
    described as {
      | Epic covering learner progress through courses
      | including content consumption and assessment completion.
    }
  }
  include "LearningContext.riddl"
  include "external-contexts.riddl"
  application context LearningManagementApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in LearningManagement are delivered.
      }
    }
    group LearningManagementScreen is {
      input RecordProgressInput acquires command LearningContext.Course.RecordProgress with {
        briefly "Record progress control"
        described as {
          |The control through which a user submits the record progress request.
        }
      }
    } with {
      briefly "Learning management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppCourseCommands is type LearningContext.Course.CourseCommand
    inlet AppCourseRepositoryResponses is type LearningContext.Course.CourseResult    handler LearningManagementAppHandler is {
      on other is {
        error "Unexpected message for application context LearningManagementApp"
      }
    } with {
      briefly "LearningManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "LearningManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'CourseCommand Stream' is from outlet LearningManagementApp.AppCourseCommands to inlet LearningContext.Course.CourseCommands with {
    option persistent()
    briefly "Course commands from the application"
  }
  connector 'CourseResult Stream' is from outlet LearningContext.CourseRepository.CourseRepositoryResponses to inlet LearningManagementApp.AppCourseRepositoryResponses with {
    option persistent()
    briefly "Course query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet LearningManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Learning management domain"
  described as {
    | The LearningManagement domain handles online course
    | delivery, content management, and learner engagement.
  }
}
