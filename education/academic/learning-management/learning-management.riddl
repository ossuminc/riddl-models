// Learning Management System Domain Model
// Online course delivery, content management, and learner engagement
domain LearningManagement is {
  persistent connector 'CertificationServiceEvent Stream' is from outlet CertificationService.CertificationServiceEventsOut to inlet LearningContext.FromCertificationService.FromCertificationServiceIn with {
    briefly "What CertificationService tells LearningContext, unasked"
  }
  persistent connector 'ContentDeliveryServiceEvent Stream' is from outlet ContentDeliveryService.ContentDeliveryServiceEventsOut to inlet LearningContext.FromContentDeliveryService.FromContentDeliveryServiceIn with {
    briefly "What ContentDeliveryService tells LearningContext, unasked"
  }
  persistent connector 'IdentityServiceEvent Stream' is from outlet IdentityService.IdentityServiceEventsOut to inlet LearningContext.FromIdentityService.FromIdentityServiceIn with {
    briefly "What IdentityService tells LearningContext, unasked"
  }
  persistent connector 'CertificationServiceRequest Stream' is from outlet LearningContext.ToCertificationService.ToCertificationServiceOut to inlet CertificationService.CertificationServiceRequests with {
    briefly "What LearningContext asks CertificationService to send"
  }
  persistent connector 'ContentDeliveryServiceRequest Stream' is from outlet LearningContext.ToContentDeliveryService.ToContentDeliveryServiceOut to inlet ContentDeliveryService.ContentDeliveryServiceRequests with {
    briefly "What LearningContext asks ContentDeliveryService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet LearningContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What LearningContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Instructor is "faculty creating and teaching courses" with {
    briefly "Instructor"
    described as {
      |Person who creates and delivers course content.
    }
  }
  user Learner is "student taking online courses" with {
    briefly "Learner"
    described as {
      |Person enrolled in and taking courses.
    }
  }
  user ContentAdmin is "administrator managing learning content" with {
    briefly "Content Admin"
    described as {
      |Staff managing content library and courses.
    }
  }
  epic CourseCompletionEpic is {
    user Learner wants to "to complete courses and track progress" so that "they can achieve learning objectives"
    case CompleteCourseModule is {
      user Learner wants to "to work through course modules" so that "they can learn the material"
      step is "Learner accesses course" "in learning portal" "at their convenience" with {
        briefly "Access course"
        described as {
          |Learner opens course.
        }
      }
      step is "Learner views content" "including videos and readings" "for current module" with {
        briefly "View content"
        described as {
          |Learner consumes content.
        }
      }
      step take input LearningManagementApp.LearningManagementScreen.RecordProgressInput from user Learner with {
        briefly "Record progress"
        described as {
          |System tracks completion.
        }
      }
      step is "System updates progress" "and unlocks next content" "based on completion" with {
        briefly "Update progress"
        described as {
          |System advances learner.
        }
      }
    } with {
      briefly "Module completion workflow"
      described as {
        |Standard flow for completing course modules.
      }
    }
  } with {
    briefly "Course completion processing"
    described as {
      | Epic covering learner progress through courses
      | including content consumption and assessment completion.
    }
  }
  include "LearningContext.riddl"
  include "external-contexts.riddl"
  application context LearningManagementApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in LearningManagement are delivered.
      }
    }
    group LearningManagementScreen is {
      input GetProgressSummaryInput acquires query LearningContext.GetProgressSummary with {
        briefly "Get progress summary control"
        described as {
          |The control through which a user asks the get progress summary question.
        }
      }
      input GetLearnerEnrollmentInput acquires query LearningContext.LearnerEnrollment.GetLearnerEnrollment with {
        briefly "Get learner enrollment control"
        described as {
          |The control through which a user asks the get learner enrollment question.
        }
      }
      input GetCourseInput acquires query LearningContext.Course.GetCourse with {
        briefly "Get course control"
        described as {
          |The control through which a user asks the get course question.
        }
      }
      input AddContentInput acquires command LearningContext.Course.AddContent with {
        briefly "Add content control"
        described as {
          |The control through which a user submits the add content request.
        }
      }
      input AddModuleInput acquires command LearningContext.Course.AddModule with {
        briefly "Add module control"
        described as {
          |The control through which a user submits the add module request.
        }
      }
      input ArchiveCourseInput acquires command LearningContext.Course.ArchiveCourse with {
        briefly "Archive course control"
        described as {
          |The control through which a user submits the archive course request.
        }
      }
      input CompleteCourseInput acquires command LearningContext.Course.CompleteCourse with {
        briefly "Complete course control"
        described as {
          |The control through which a user submits the complete course request.
        }
      }
      input EnrollLearnerInput acquires command LearningContext.Course.EnrollLearner with {
        briefly "Enroll learner control"
        described as {
          |The control through which a user submits the enroll learner request.
        }
      }
      input GradeAssessmentInput acquires command LearningContext.Course.GradeAssessment with {
        briefly "Grade assessment control"
        described as {
          |The control through which a user submits the grade assessment request.
        }
      }
      input PublishCourseInput acquires command LearningContext.Course.PublishCourse with {
        briefly "Publish course control"
        described as {
          |The control through which a user submits the publish course request.
        }
      }
      input RemoveModuleInput acquires command LearningContext.Course.RemoveModule with {
        briefly "Remove module control"
        described as {
          |The control through which a user submits the remove module request.
        }
      }
      input SubmitAssessmentInput acquires command LearningContext.Course.SubmitAssessment with {
        briefly "Submit assessment control"
        described as {
          |The control through which a user submits the submit assessment request.
        }
      }
      input UpdateCourseInput acquires command LearningContext.Course.UpdateCourse with {
        briefly "Update course control"
        described as {
          |The control through which a user submits the update course request.
        }
      }
      input UpdateModuleInput acquires command LearningContext.Course.UpdateModule with {
        briefly "Update module control"
        described as {
          |The control through which a user submits the update module request.
        }
      }
      input CreateCourseInput acquires command LearningContext.CreateCourse with {
        briefly "Create course control"
        described as {
          |The control through which a user submits the create course request.
        }
      }
      input OpenLearnerEnrollmentInput acquires command LearningContext.OpenLearnerEnrollment with {
        briefly "Open learner enrollment control"
        described as {
          |The control through which a user submits the open learner enrollment request.
        }
      }
      input RecordProgressInput acquires command LearningContext.Course.RecordProgress with {
        briefly "Record progress control"
        described as {
          |The control through which a user submits the record progress request.
        }
      }
    } with {
      briefly "Learning management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppCourseRepositoryQueries is query LearningContext.GetProgressSummary
    inlet AppCourseRepositoryReplies is result LearningContext.ProgressSummaryView
    outlet AppLearnerEnrollmentQueries is query LearningContext.LearnerEnrollment.GetLearnerEnrollment
    inlet AppLearnerEnrollmentReplies is result LearningContext.LearnerEnrollment.LearnerEnrollmentResult
    outlet AppCourseQueries is query LearningContext.Course.GetCourse
    outlet AppCourseCommands is type LearningContext.CourseRequest
    outlet AppLearnerEnrollmentCommands is type LearningContext.LearnerEnrollmentRequest
    inlet AppCourseRepositoryResponses is result LearningContext.Course.CourseResult
    handler LearningManagementAppHandler is {
      on other is {
        error "Unexpected message for application context LearningManagementApp"
      }
    } with {
      briefly "LearningManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "LearningManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'CourseRepositoryQuery Stream' is from outlet LearningManagementApp.AppCourseRepositoryQueries to inlet LearningContext.CourseRepositoryQueriesIn with {
    briefly "LearningManagementApp's look-ups of the course repository"
  }
  persistent connector 'CourseRepositoryReply Stream' is from outlet LearningContext.CourseRepositoryRepliesOut to inlet LearningManagementApp.AppCourseRepositoryReplies with {
    briefly "The course repository's answers returned to LearningManagementApp"
  }
  persistent connector 'LearnerEnrollmentQuery Stream' is from outlet LearningManagementApp.AppLearnerEnrollmentQueries to inlet LearningContext.LearnerEnrollmentQueriesIn with {
    briefly "LearningManagementApp's look-ups of the learner enrollment"
  }
  persistent connector 'LearnerEnrollmentReply Stream' is from outlet LearningContext.LearnerEnrollmentRepliesOut to inlet LearningManagementApp.AppLearnerEnrollmentReplies with {
    briefly "The learner enrollment's answers returned to LearningManagementApp"
  }
  persistent connector 'CourseQuery Stream' is from outlet LearningManagementApp.AppCourseQueries to inlet LearningContext.CourseQueriesIn with {
    briefly "LearningManagementApp's look-ups of the course"
  }
  persistent connector 'LearnerEnrollmentCommand Stream' is from outlet LearningManagementApp.AppLearnerEnrollmentCommands to inlet LearningContext.LearnerEnrollmentCommandStreamIn with {
    briefly "What the app asks one learner's enrollment to do"
  }
  persistent connector 'CourseCommand Stream' is from outlet LearningManagementApp.AppCourseCommands to inlet LearningContext.CourseCommandStreamIn with {
    briefly "Course commands from the application"
  }
  persistent connector 'CourseResult Stream' is from outlet LearningContext.CourseResultStreamOut to inlet LearningManagementApp.AppCourseRepositoryResponses with {
    briefly "Course query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet LearningManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Learning management domain"
  described as {
    | The LearningManagement domain handles online course
    | delivery, content management, and learner engagement.
  }
}
