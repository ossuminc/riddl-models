// Course Management - Course Context
context CourseContext is {
  include "types.riddl"
  include "Course.riddl"
  // Repository for course persistence
  repository CourseRepository is {
    inlet CourseRepositoryFromCourse is type CourseEvent
    inlet CourseRepositoryFromEnrollmentAnalytics is type CourseEvent
    outlet CourseRepositoryResponses is type Course.CourseResult
    schema CourseData is relational
      of courses as type Course
        index on field Course.courseId
        index on field Course.info.courseCode

    handler CoursePersistence is {
      on command Course.CreateCourse is {
        tell event Course.CourseCreated to entity CourseContext.Course
        do "Store new course record"
      }
      on command Course.ScheduleSection is {
        tell event Course.SectionScheduled to entity CourseContext.Course
        do "Store section record"
      }
      on command Course.EnrollStudent is {
        do "Store enrollment record"
      }
      on command Course.RecordGrade is {
        tell event Course.GradeRecorded to entity CourseContext.Course
        do "Update enrollment with grade"
      }
      on command Course.CompleteSection is {
        tell event Course.SectionCompleted to entity CourseContext.Course
        do "Update section status"
      }
    } with {
      briefly "Persists course commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Course data persistence"
    described as {
      | The CourseRepository provides persistent storage for
      | courses, sections, and enrollments.
    }
  }
  // Projector for enrollment analytics
  projector EnrollmentAnalytics is {
    inlet EnrollmentAnalyticsFromCourse is type CourseEvent
    outlet EnrollmentAnalyticsOut is type CourseEvent
    updates repository CourseContext.CourseRepository
    record EnrollmentSummary is  {
      termId: TermId with {
        briefly "Term"
        described as {
          |Academic term.
        }
      }
      totalEnrollments: Natural with {
        briefly "Total"
        described as {
          |Total enrollments.
        }
      }
      averageClassSize: Decimal(5,2) with {
        briefly "Avg size"
        described as {
          |Average class size.
        }
      }
      fillRate: Decimal(5,2) with {
        briefly "Fill rate"
        described as {
          |Capacity utilization.
        }
      }
    } with {
      briefly "Enrollment summary"
      described as {
        |Term enrollment metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Course.StudentEnrolled is {
        tell event Course.StudentEnrolled to repository CourseContext.CourseRepository
        do "Update enrollment counts"
      }
      on event Course.StudentDropped is {
        tell event Course.StudentDropped to repository CourseContext.CourseRepository
        do "Update enrollment counts"
      }
      on event Course.SectionCancelled is {
        tell event Course.SectionCancelled to repository CourseContext.CourseRepository
        do "Adjust capacity metrics"
      }
    } with {
      briefly "Maintains enrollment analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Enrollment analytics projections"
    described as {
      |Maintains enrollment analytics data.
    }
  }
  // ---- Event publication for Course ----
  type CourseEvent is one of {
    CourseContext.Course.CourseCreated,
    CourseContext.Course.CourseUpdated,
    CourseContext.Course.CourseActivated,
    CourseContext.Course.CourseDeactivated,
    CourseContext.Course.SectionScheduled,
    CourseContext.Course.SectionCancelled,
    CourseContext.Course.StudentEnrolled,
    CourseContext.Course.StudentDropped,
    CourseContext.Course.GradeRecorded,
    CourseContext.Course.SectionCompleted
  } with {
    briefly "Course event alternation"
    described as {
      |Union of all Course events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CourseEventSource as source is {
    outlet CourseEvents is type CourseEvent
    handler CourseSourceHandler is {
      on event Course.CourseCreated is {
        send event Course.CourseCreated to outlet CourseEvents
      }
      on event Course.CourseUpdated is {
        send event Course.CourseUpdated to outlet CourseEvents
      }
      on event Course.CourseActivated is {
        send event Course.CourseActivated to outlet CourseEvents
      }
      on event Course.CourseDeactivated is {
        send event Course.CourseDeactivated to outlet CourseEvents
      }
      on event Course.SectionScheduled is {
        send event Course.SectionScheduled to outlet CourseEvents
      }
      on event Course.SectionCancelled is {
        send event Course.SectionCancelled to outlet CourseEvents
      }
      on event Course.StudentEnrolled is {
        send event Course.StudentEnrolled to outlet CourseEvents
      }
      on event Course.StudentDropped is {
        send event Course.StudentDropped to outlet CourseEvents
      }
      on event Course.GradeRecorded is {
        send event Course.GradeRecorded to outlet CourseEvents
      }
      on event Course.SectionCompleted is {
        send event Course.SectionCompleted to outlet CourseEvents
      }
      on other is {
        error "Unexpected message for source CourseEventSource"
      }
    } with {
      briefly "Course source handler"
      described as {
        |Publishes Course events onto the outlet.
      }
    }
  } with {
    briefly "Course event source"
    described as {
      |Publishes Course entity events into the streaming topology.
    }
  }
  processor CourseEventSink as sink is {
    inlet CourseInlet is type CourseEvent
    handler CourseSinkHandler is {
      on event Course.CourseCreated is {
        tell event Course.CourseCreated to repository CourseContext.CourseRepository
      }
      on event Course.CourseUpdated is {
        tell event Course.CourseUpdated to repository CourseContext.CourseRepository
      }
      on event Course.CourseActivated is {
        tell event Course.CourseActivated to repository CourseContext.CourseRepository
      }
      on event Course.CourseDeactivated is {
        tell event Course.CourseDeactivated to repository CourseContext.CourseRepository
      }
      on event Course.SectionScheduled is {
        tell event Course.SectionScheduled to repository CourseContext.CourseRepository
      }
      on event Course.SectionCancelled is {
        tell event Course.SectionCancelled to repository CourseContext.CourseRepository
      }
      on event Course.StudentEnrolled is {
        tell event Course.StudentEnrolled to repository CourseContext.CourseRepository
      }
      on event Course.StudentDropped is {
        tell event Course.StudentDropped to repository CourseContext.CourseRepository
      }
      on event Course.GradeRecorded is {
        tell event Course.GradeRecorded to repository CourseContext.CourseRepository
      }
      on event Course.SectionCompleted is {
        tell event Course.SectionCompleted to repository CourseContext.CourseRepository
      }
      on other is {
        error "Unexpected message for sink CourseEventSink"
      }
    } with {
      briefly "Course sink handler"
      described as {
        |Persists Course events via the repository.
      }
    }
  } with {
    briefly "Course event sink"
    described as {
      |Receives Course events for persistence.
    }
  }
  connector CourseEventFlow is {
    from outlet CourseContext.CourseEventSource.CourseEvents to
      inlet CourseContext.CourseEventSink.CourseInlet
  } with {
    briefly "Course event flow"
    described as {
      |Connects the Course source to its sink.
    }
  }
  processor CourseEventSplit is {
    inlet CourseEventSplitIn is type CourseEvent
    outlet CourseEventSplitToCourseRepository is type CourseEvent
    outlet CourseEventSplitToEnrollmentAnalytics is type CourseEvent
    handler CourseEventSplitHandler is {
      on event Course.CourseCreated is {
        send event Course.CourseCreated to outlet CourseEventSplitToCourseRepository
        send event Course.CourseCreated to outlet CourseEventSplitToEnrollmentAnalytics
        tell event Course.CourseCreated to entity CourseContext.Course
      }
      on event Course.CourseUpdated is {
        send event Course.CourseUpdated to outlet CourseEventSplitToCourseRepository
        send event Course.CourseUpdated to outlet CourseEventSplitToEnrollmentAnalytics
        tell event Course.CourseUpdated to entity CourseContext.Course
      }
      on event Course.CourseActivated is {
        send event Course.CourseActivated to outlet CourseEventSplitToCourseRepository
        send event Course.CourseActivated to outlet CourseEventSplitToEnrollmentAnalytics
        tell event Course.CourseActivated to entity CourseContext.Course
      }
      on event Course.CourseDeactivated is {
        send event Course.CourseDeactivated to outlet CourseEventSplitToCourseRepository
        send event Course.CourseDeactivated to outlet CourseEventSplitToEnrollmentAnalytics
        tell event Course.CourseDeactivated to entity CourseContext.Course
      }
      on event Course.SectionScheduled is {
        send event Course.SectionScheduled to outlet CourseEventSplitToCourseRepository
        send event Course.SectionScheduled to outlet CourseEventSplitToEnrollmentAnalytics
        tell event Course.SectionScheduled to entity CourseContext.Course
      }
      on event Course.SectionCancelled is {
        send event Course.SectionCancelled to outlet CourseEventSplitToCourseRepository
        send event Course.SectionCancelled to outlet CourseEventSplitToEnrollmentAnalytics
        tell event Course.SectionCancelled to entity CourseContext.Course
      }
      on event Course.StudentEnrolled is {
        send event Course.StudentEnrolled to outlet CourseEventSplitToCourseRepository
        send event Course.StudentEnrolled to outlet CourseEventSplitToEnrollmentAnalytics
        tell event Course.StudentEnrolled to entity CourseContext.Course
      }
      on event Course.StudentDropped is {
        send event Course.StudentDropped to outlet CourseEventSplitToCourseRepository
        send event Course.StudentDropped to outlet CourseEventSplitToEnrollmentAnalytics
        tell event Course.StudentDropped to entity CourseContext.Course
      }
      on event Course.GradeRecorded is {
        send event Course.GradeRecorded to outlet CourseEventSplitToCourseRepository
        send event Course.GradeRecorded to outlet CourseEventSplitToEnrollmentAnalytics
        tell event Course.GradeRecorded to entity CourseContext.Course
      }
      on event Course.SectionCompleted is {
        send event Course.SectionCompleted to outlet CourseEventSplitToCourseRepository
        send event Course.SectionCompleted to outlet CourseEventSplitToEnrollmentAnalytics
        tell event Course.SectionCompleted to entity CourseContext.Course
      }
      on other is {
        error "Unexpected message for processor CourseEventSplit"
      }
    } with {
      briefly "Course event fan-out handler"
      described as {
        |Delivers each Course event to all of its consumers.
      }
    }
  } with {
    briefly "Course event fan-out"
    described as {
      |Fans Course events out to the repository and projectors.
    }
  }
  connector LinkCourseToCourseEventSplit is {
    from outlet CourseContext.Course.CourseEvents2 to
      inlet CourseContext.CourseEventSplit.CourseEventSplitIn
  } with {
    briefly "LinkCourseToCourseEventSplit"
  }
  connector LinkCourseEventSplitToCourseRepository is {
    from outlet CourseContext.CourseEventSplit.CourseEventSplitToCourseRepository to
      inlet CourseContext.CourseRepository.CourseRepositoryFromCourse
  } with {
    briefly "LinkCourseEventSplitToCourseRepository"
  }
  connector LinkCourseEventSplitToEnrollmentAnalytics is {
    from outlet CourseContext.CourseEventSplit.CourseEventSplitToEnrollmentAnalytics to
      inlet CourseContext.EnrollmentAnalytics.EnrollmentAnalyticsFromCourse
  } with {
    briefly "LinkCourseEventSplitToEnrollmentAnalytics"
  }
  connector LinkEnrollmentAnalyticsToCourseRepository is {
    from outlet CourseContext.EnrollmentAnalytics.EnrollmentAnalyticsOut to
      inlet CourseContext.CourseRepository.CourseRepositoryFromEnrollmentAnalytics
  } with {
    briefly "LinkEnrollmentAnalyticsToCourseRepository"
  }
} with {
  briefly "Bounded context for course management"
  described as {
    | The CourseContext is the bounded context for academic
    | course catalog, scheduling, and enrollment.
  }
}
