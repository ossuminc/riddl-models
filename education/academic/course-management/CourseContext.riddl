// Course Management - Course Context
context CourseContext as router is {
  inlet CourseContextFromStudentInformationService is command Course.DropStudent with {
    briefly "What FromStudentInformationService makes of that service's news"
  }
  connector 'FromStudentInformationService Intake' is from outlet CourseContext.FromStudentInformationService.FromStudentInformationServiceToCourseContext to inlet CourseContext.CourseContextFromStudentInformationService with {
    briefly "What FromStudentInformationService makes of that news, on its way in"
  }
  inlet CourseCommandStreamIn is type CourseCommand  outlet CourseCommandStreamOut is type CourseCommand
  inlet CourseResultStreamIn is result Course.CourseResult  outlet CourseResultStreamOut is result Course.CourseResult
  handler CourseContextBoundary is {
    on createCourse: command Course.CreateCourse is {
      send createCourse to outlet CourseContext.CourseCommandStreamOut
    }
    on updateCourse: command Course.UpdateCourse is {
      send updateCourse to outlet CourseContext.CourseCommandStreamOut
    }
    on activateCourse: command Course.ActivateCourse is {
      send activateCourse to outlet CourseContext.CourseCommandStreamOut
    }
    on deactivateCourse: command Course.DeactivateCourse is {
      send deactivateCourse to outlet CourseContext.CourseCommandStreamOut
    }
    on scheduleSection: command Course.ScheduleSection is {
      send scheduleSection to outlet CourseContext.CourseCommandStreamOut
    }
    on cancelSection: command Course.CancelSection is {
      send cancelSection to outlet CourseContext.CourseCommandStreamOut
    }
    on enrollStudent: command Course.EnrollStudent is {
      send enrollStudent to outlet CourseContext.CourseCommandStreamOut
    }
    on dropStudent: command Course.DropStudent is {
      send dropStudent to outlet CourseContext.CourseCommandStreamOut
    }
    on recordGrade: command Course.RecordGrade is {
      send recordGrade to outlet CourseContext.CourseCommandStreamOut
    }
    on completeSection: command Course.CompleteSection is {
      send completeSection to outlet CourseContext.CourseCommandStreamOut
    }
    on courseResult: result Course.CourseResult is {
      send courseResult to outlet CourseContext.CourseResultStreamOut
    }
    on other is {
      error "Unexpected message at the CourseContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CourseCommand Stream Intake' is from outlet CourseContext.CourseCommandStreamOut to inlet CourseContext.Course.CourseCommands  connector 'CourseResult Stream Egress' is from outlet CourseContext.CourseRepository.CourseRepositoryResponses to inlet CourseContext.CourseResultStreamIn  adaptor FromFacultyService from context FacultyService as sink is { 
    inlet FromFacultyServiceIn is type FacultyService.FacultyServiceEvent    handler FromFacultyServiceHandler is {
      on instructorAssigned: event FacultyService.InstructorAssigned is {
        do "who teaches is decided in the faculty system; the section carries that assignment when it is next scheduled or updated"
      }
      on instructorAvailabilityUpdated: event FacultyService.InstructorAvailabilityUpdated is {
        do "availability shapes future scheduling; a section already scheduled does not move because of it"
      }
      on other is {
        error "Unexpected message for adaptor FromFacultyService"
      }
    } with {
      briefly "from faculty service"
      described as {
        |Carries messages from the external FacultyService.
      }
    }
  } with {
    briefly "FacultyService integration"
    described as {
      |The model's side of the FacultyService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type CourseEvent    outlet ToNotificationServiceOut is type NotificationService.NotificationServiceCommand
    handler ToNotificationServiceHandler is {
      on studentEnrolled: event StudentEnrolled is {
        let msg: type NotificationService.SendEnrollmentConfirmation = prompt("translate the studentEnrolled event into a SendEnrollmentConfirmation for the customer")
        send msg to outlet CourseContext.ToNotificationService.ToNotificationServiceOut
      }
      on studentDropped: event StudentDropped is {
        let notice: type NotificationService.SendWaitlistNotification = prompt("translate the studentDropped event into a SendWaitlistNotification telling the next waitlisted student a seat has opened and how long they have to claim it")
        send notice to outlet CourseContext.ToNotificationService.ToNotificationServiceOut
      }
      on sectionCancelled: event SectionCancelled is {
        let notice: type NotificationService.SendWaitlistNotification = prompt("translate the sectionCancelled event into a SendWaitlistNotification telling waitlisted students the section will not run, so they stop waiting for it")
        send notice to outlet CourseContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromRoomSchedulingService from context RoomSchedulingService as sink is { 
    inlet FromRoomSchedulingServiceIn is event RoomSchedulingService.RoomReserved    handler FromRoomSchedulingServiceHandler is {
      on roomReserved: event RoomSchedulingService.RoomReserved is {
        do "the room is held; the section was scheduled before the room was asked for"
      }
      on other is {
        error "Unexpected message for adaptor FromRoomSchedulingService"
      }
    } with {
      briefly "from room scheduling service"
      described as {
        |Carries messages from the external RoomSchedulingService.
      }
    }
  } with {
    briefly "RoomSchedulingService integration"
    described as {
      |The model's side of the RoomSchedulingService conversation.
    }
  }
  adaptor ToRoomSchedulingService to context RoomSchedulingService as flow is { 
    inlet ToRoomSchedulingServiceIn is type CourseEvent    outlet ToRoomSchedulingServiceOut is command RoomSchedulingService.ReserveRoom
    handler ToRoomSchedulingServiceHandler is {
      on sectionScheduled: event Course.SectionScheduled is {
        let request: type RoomSchedulingService.ReserveRoom = prompt("translate the sectionScheduled event into a ReserveRoom holding the teaching space the section needs")
        send request to outlet CourseContext.ToRoomSchedulingService.ToRoomSchedulingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToRoomSchedulingService"
      }
    } with {
      briefly "to room scheduling service"
      described as {
        |Carries messages to the external RoomSchedulingService.
      }
    }
  } with {
    briefly "RoomSchedulingService integration"
    described as {
      |The model's side of the RoomSchedulingService conversation.
    }
  }
  adaptor FromStudentInformationService from context StudentInformationService as flow is { 
    inlet FromStudentInformationServiceIn is type StudentInformationService.StudentInformationServiceEvent    outlet FromStudentInformationServiceToCourseContext is command Course.DropStudent
    handler FromStudentInformationServiceHandler is {
      on studentRegistered: event StudentInformationService.StudentRegistered is {
        do "registration makes a student eligible to enrol; enrolling in a section is a separate act"
      }
      on studentStatusChanged: event StudentInformationService.StudentStatusChanged is {
        let item0: type Course.DropStudent = prompt("translate the studentStatusChanged event into a DropStudent, a student who is no longer active cannot hold a seat in a section")
        send item0 to outlet CourseContext.FromStudentInformationService.FromStudentInformationServiceToCourseContext
      }
      on other is {
        error "Unexpected message for adaptor FromStudentInformationService"
      }
    } with {
      briefly "from student information service"
      described as {
        |Carries messages from the external StudentInformationService.
      }
    }
  } with {
    briefly "StudentInformationService integration"
    described as {
      |The model's side of the StudentInformationService conversation.
    }
  }
  include "types.riddl"
  include "Course.riddl"
  // Repository for course persistence
  type CourseRepositoryCommand is one of {
    CourseContext.CourseRepository.PersistCourseActivated or CourseContext.CourseRepository.PersistCourseCreated or CourseContext.CourseRepository.PersistCourseDeactivated or CourseContext.CourseRepository.PersistCourseUpdated or CourseContext.CourseRepository.PersistGradeRecorded or CourseContext.CourseRepository.PersistSectionCancelled or CourseContext.CourseRepository.PersistSectionCompleted or CourseContext.CourseRepository.PersistSectionScheduled or CourseContext.CourseRepository.PersistStudentDropped or CourseContext.CourseRepository.PersistStudentEnrolled
  } with {
    briefly "Anything that writes CourseRepository"
    described as {
      |The persistence commands CourseRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository CourseRepository as flow is {
    inlet CourseRepositoryFromEnrollmentAnalytics is type CourseRepositoryCommand    command PersistCourseActivated is {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CourseActivated applies to.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CourseActivated"
      described as {
        |Instructs this repository to apply CourseActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCourseCreated is {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CourseCreated applies to.
        }
      }
      info: CourseInfo? with {
        briefly "Info"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CourseCreated"
      described as {
        |Instructs this repository to apply CourseCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCourseDeactivated is {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CourseDeactivated applies to.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      deactivatedAt: TimeStamp? with {
        briefly "Deactivated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CourseDeactivated"
      described as {
        |Instructs this repository to apply CourseDeactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCourseUpdated is {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row CourseUpdated applies to.
        }
      }
      info: CourseInfo? with {
        briefly "Info"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CourseUpdated"
      described as {
        |Instructs this repository to apply CourseUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistGradeRecorded is {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row GradeRecorded applies to.
        }
      }
      sectionId: SectionId? with {
        briefly "Section id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      studentId: StudentId? with {
        briefly "Student id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      grade: String(1,5)? with {
        briefly "Grade"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist GradeRecorded"
      described as {
        |Instructs this repository to apply GradeRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSectionCompleted is {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row SectionCompleted applies to.
        }
      }
      sectionId: SectionId? with {
        briefly "Section id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SectionCompleted"
      described as {
        |Instructs this repository to apply SectionCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSectionScheduled is {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row SectionScheduled applies to.
        }
      }
      section: Section? with {
        briefly "Section"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      scheduledAt: TimeStamp? with {
        briefly "Scheduled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SectionScheduled"
      described as {
        |Instructs this repository to apply SectionScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSectionCancelled is {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row SectionCancelled applies to.
        }
      }
      sectionId: SectionId? with {
        briefly "Section id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SectionCancelled"
      described as {
        |Instructs this repository to apply SectionCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStudentDropped is {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row StudentDropped applies to.
        }
      }
      sectionId: SectionId? with {
        briefly "Section id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      studentId: StudentId? with {
        briefly "Student id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      droppedAt: TimeStamp? with {
        briefly "Dropped at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist StudentDropped"
      described as {
        |Instructs this repository to apply StudentDropped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStudentEnrolled is {
      courseId: CourseId with {
        briefly "Row addressed"
        described as {
          |Which stored row StudentEnrolled applies to.
        }
      }
      sectionId: SectionId? with {
        briefly "Section id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      studentId: StudentId? with {
        briefly "Student id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      enrolledAt: TimeStamp? with {
        briefly "Enrolled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist StudentEnrolled"
      described as {
        |Instructs this repository to apply StudentEnrolled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet CourseRepositoryResponses is result Course.CourseResult
    record StoredCourse is {
      courseId: CourseId with {
        briefly "courseId"
        described as {
          |The courseId column of the stored course row.
        }
      }
      info: CourseInfo with {
        briefly "info"
        described as {
          |The info column of the stored course row.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      deactivatedAt: TimeStamp? with {
        briefly "Deactivated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      sectionId: SectionId? with {
        briefly "Section id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      studentId: StudentId? with {
        briefly "Student id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      grade: String(1,5)? with {
        briefly "Grade"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      section: Section? with {
        briefly "Section"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      scheduledAt: TimeStamp? with {
        briefly "Scheduled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      droppedAt: TimeStamp? with {
        briefly "Dropped at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      enrolledAt: TimeStamp? with {
        briefly "Enrolled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored course row"
      described as {
        |The persistence shape of course data as this repository stores it.
      }
    }
    schema CourseData is relational
      of courses as record StoredCourse
        key on field StoredCourse.courseId
        index on field StoredCourse.info.courseCode
 with {
      briefly "Course data schema"
      described as {
        |The relational schema holding course data for the CourseRepository.
      }
    }
    handler CoursePersistence is {
      on persistCourseActivated: command PersistCourseActivated is {
        update CourseData.courses set activatedAt = persistCourseActivated.activatedAt where courseId == persistCourseActivated.courseId
      }
      on persistCourseCreated: command PersistCourseCreated is {
        update CourseData.courses set info = persistCourseCreated.info, createdAt = persistCourseCreated.createdAt where courseId == persistCourseCreated.courseId
      }
      on persistCourseDeactivated: command PersistCourseDeactivated is {
        update CourseData.courses set reason = persistCourseDeactivated.reason, deactivatedAt = persistCourseDeactivated.deactivatedAt where courseId == persistCourseDeactivated.courseId
      }
      on persistCourseUpdated: command PersistCourseUpdated is {
        update CourseData.courses set info = persistCourseUpdated.info, updatedAt = persistCourseUpdated.updatedAt where courseId == persistCourseUpdated.courseId
      }
      on persistGradeRecorded: command PersistGradeRecorded is {
        update CourseData.courses set sectionId = persistGradeRecorded.sectionId, studentId = persistGradeRecorded.studentId, grade = persistGradeRecorded.grade, recordedAt = persistGradeRecorded.recordedAt where courseId == persistGradeRecorded.courseId
      }
      on persistSectionCompleted: command PersistSectionCompleted is {
        update CourseData.courses set sectionId = persistSectionCompleted.sectionId, completedAt = persistSectionCompleted.completedAt where courseId == persistSectionCompleted.courseId
      }
      on persistSectionScheduled: command PersistSectionScheduled is {
        update CourseData.courses set section = persistSectionScheduled.section, scheduledAt = persistSectionScheduled.scheduledAt where courseId == persistSectionScheduled.courseId
      }
      on persistSectionCancelled: command PersistSectionCancelled is {
        update CourseData.courses set sectionId = persistSectionCancelled.sectionId, reason = persistSectionCancelled.reason, cancelledAt = persistSectionCancelled.cancelledAt where courseId == persistSectionCancelled.courseId
      }
      on persistStudentDropped: command PersistStudentDropped is {
        update CourseData.courses set sectionId = persistStudentDropped.sectionId, studentId = persistStudentDropped.studentId, droppedAt = persistStudentDropped.droppedAt where courseId == persistStudentDropped.courseId
      }
      on persistStudentEnrolled: command PersistStudentEnrolled is {
        update CourseData.courses set sectionId = persistStudentEnrolled.sectionId, studentId = persistStudentEnrolled.studentId, enrolledAt = persistStudentEnrolled.enrolledAt where courseId == persistStudentEnrolled.courseId
      }
      on query GetEnrollmentSummary is {
        let enrollmentSummaryView: type EnrollmentSummaryView = prompt("read the enrollment summary projection")
        reply enrollmentSummaryView
      }
    } with {
      briefly "Persists course commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Course data persistence"
    described as {
      | The CourseRepository provides persistent storage for
      | courses, sections, and enrollments.
    }
  }
  // Projector for enrollment analytics
  query GetEnrollmentSummary replies result EnrollmentSummaryView is {
    enrollmentSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which enrollment summary to retrieve.
      }
    }
  } with {
    briefly "Get enrollment summary"
    described as {
      |Retrieves the enrollment summary projection.
    }
  }
  result EnrollmentSummaryView is {
    enrollmentSummary: EnrollmentAnalytics.EnrollmentSummary with {
      briefly "Enrollment summary"
      described as {
        |The enrollment summary being returned.
      }
    }
  } with {
    briefly "Enrollment summary view"
    described as {
      |Read model view carrying the enrollment summary projection.
    }
  }
  projector EnrollmentAnalytics as flow is {
    updates repository CourseContext.CourseRepository
    outlet EnrollmentAnalyticsToRepository is type CourseRepositoryCommand
    inlet EnrollmentAnalyticsFromCourse is type CourseEvent    record EnrollmentSummary is {
      termId: TermId with {
        briefly "Term"
        described as {
          |Academic term.
        }
      }
      totalEnrollments: Natural with {
        briefly "Total"
        described as {
          |Total enrollments.
        }
      }
      averageClassSize: Decimal(5,2) with {
        briefly "Avg size"
        described as {
          |Average class size.
        }
      }
      fillRate: Decimal(5,2) with {
        briefly "Fill rate"
        described as {
          |Capacity utilization.
        }
      }
    } with {
      briefly "Enrollment summary"
      described as {
        |Term enrollment metrics.
      }
    }
    handler AnalyticsHandler is {
      on courseActivated: event Course.CourseActivated is {
        tell command CourseContext.CourseRepository.PersistCourseActivated(courseId = courseActivated.courseId, activatedAt = courseActivated.activatedAt) to repository CourseContext.CourseRepository
        do "apply CourseActivated to the EnrollmentAnalytics projection"
      }
      on courseCreated: event Course.CourseCreated is {
        tell command CourseContext.CourseRepository.PersistCourseCreated(courseId = courseCreated.courseId, info = courseCreated.info, createdAt = courseCreated.createdAt) to repository CourseContext.CourseRepository
        do "apply CourseCreated to the EnrollmentAnalytics projection"
      }
      on courseDeactivated: event Course.CourseDeactivated is {
        tell command CourseContext.CourseRepository.PersistCourseDeactivated(courseId = courseDeactivated.courseId, reason = courseDeactivated.reason, deactivatedAt = courseDeactivated.deactivatedAt) to repository CourseContext.CourseRepository
        do "apply CourseDeactivated to the EnrollmentAnalytics projection"
      }
      on courseUpdated: event Course.CourseUpdated is {
        tell command CourseContext.CourseRepository.PersistCourseUpdated(courseId = courseUpdated.courseId, info = courseUpdated.info, updatedAt = courseUpdated.updatedAt) to repository CourseContext.CourseRepository
        do "apply CourseUpdated to the EnrollmentAnalytics projection"
      }
      on gradeRecorded: event Course.GradeRecorded is {
        tell command CourseContext.CourseRepository.PersistGradeRecorded(courseId = gradeRecorded.courseId, sectionId = gradeRecorded.sectionId, studentId = gradeRecorded.studentId, grade = gradeRecorded.grade, recordedAt = gradeRecorded.recordedAt) to repository CourseContext.CourseRepository
        do "apply GradeRecorded to the EnrollmentAnalytics projection"
      }
      on sectionCompleted: event Course.SectionCompleted is {
        tell command CourseContext.CourseRepository.PersistSectionCompleted(courseId = sectionCompleted.courseId, sectionId = sectionCompleted.sectionId, completedAt = sectionCompleted.completedAt) to repository CourseContext.CourseRepository
        do "apply SectionCompleted to the EnrollmentAnalytics projection"
      }
      on sectionScheduled: event Course.SectionScheduled is {
        tell command CourseContext.CourseRepository.PersistSectionScheduled(courseId = sectionScheduled.courseId, section = sectionScheduled.section, scheduledAt = sectionScheduled.scheduledAt) to repository CourseContext.CourseRepository
        do "apply SectionScheduled to the EnrollmentAnalytics projection"
      }
      on studentEnrolled: event Course.StudentEnrolled is {
        tell command CourseContext.CourseRepository.PersistStudentEnrolled(courseId = studentEnrolled.courseId, sectionId = studentEnrolled.sectionId, studentId = studentEnrolled.studentId, enrolledAt = studentEnrolled.enrolledAt) to repository CourseContext.CourseRepository
        do "Update enrollment counts"
      }
      on studentDropped: event Course.StudentDropped is {
        tell command CourseContext.CourseRepository.PersistStudentDropped(courseId = studentDropped.courseId, sectionId = studentDropped.sectionId, studentId = studentDropped.studentId, droppedAt = studentDropped.droppedAt) to repository CourseContext.CourseRepository
        do "Update enrollment counts"
      }
      on sectionCancelled: event Course.SectionCancelled is {
        tell command CourseContext.CourseRepository.PersistSectionCancelled(courseId = sectionCancelled.courseId, sectionId = sectionCancelled.sectionId, reason = sectionCancelled.reason, cancelledAt = sectionCancelled.cancelledAt) to repository CourseContext.CourseRepository
        do "Adjust capacity metrics"
      }
    } with {
      briefly "Maintains enrollment analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Enrollment analytics projections"
    described as {
      |Maintains enrollment analytics data.
    }
  }
  // ---- Event publication for Course ----
  type CourseEvent is one of {
    CourseContext.Course.CourseCreated or CourseContext.Course.CourseUpdated or CourseContext.Course.CourseActivated or CourseContext.Course.CourseDeactivated or CourseContext.Course.SectionScheduled or CourseContext.Course.SectionCancelled or CourseContext.Course.StudentEnrolled or CourseContext.Course.StudentDropped or CourseContext.Course.GradeRecorded or CourseContext.Course.SectionCompleted
  } with {
    briefly "Course event alternation"
    described as {
      |Union of all Course events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet CourseEventSplit as split is {
    outlet CourseEventSplitToToRoomSchedulingService is type CourseEvent
    outlet CourseEventSplitToToNotificationService is type CourseEvent
    inlet CourseEventSplitIn is type CourseEvent    outlet CourseEventSplitToEnrollmentAnalytics is type CourseEvent
    handler CourseEventSplitHandler is {
      on courseCreated: event Course.CourseCreated is {
        send courseCreated to outlet CourseEventSplitToEnrollmentAnalytics
        tell courseCreated to entity CourseContext.Course
      }
      on courseUpdated: event Course.CourseUpdated is {
        send courseUpdated to outlet CourseEventSplitToEnrollmentAnalytics
        tell courseUpdated to entity CourseContext.Course
      }
      on courseActivated: event Course.CourseActivated is {
        send courseActivated to outlet CourseEventSplitToEnrollmentAnalytics
        tell courseActivated to entity CourseContext.Course
      }
      on courseDeactivated: event Course.CourseDeactivated is {
        send courseDeactivated to outlet CourseEventSplitToEnrollmentAnalytics
        tell courseDeactivated to entity CourseContext.Course
      }
      on sectionScheduled: event Course.SectionScheduled is {
        send sectionScheduled to outlet CourseEventSplitToEnrollmentAnalytics
        send sectionScheduled to outlet CourseEventSplitToToRoomSchedulingService
        tell sectionScheduled to entity CourseContext.Course
      }
      on sectionCancelled: event Course.SectionCancelled is {
        send sectionCancelled to outlet CourseEventSplitToEnrollmentAnalytics
        send sectionCancelled to outlet CourseEventSplitToToNotificationService
        tell sectionCancelled to entity CourseContext.Course
      }
      on studentEnrolled: event Course.StudentEnrolled is {
        send studentEnrolled to outlet CourseEventSplitToEnrollmentAnalytics
        send studentEnrolled to outlet CourseEventSplitToToNotificationService
        tell studentEnrolled to entity CourseContext.Course
      }
      on studentDropped: event Course.StudentDropped is {
        send studentDropped to outlet CourseEventSplitToEnrollmentAnalytics
        send studentDropped to outlet CourseEventSplitToToNotificationService
        tell studentDropped to entity CourseContext.Course
      }
      on gradeRecorded: event Course.GradeRecorded is {
        send gradeRecorded to outlet CourseEventSplitToEnrollmentAnalytics
        tell gradeRecorded to entity CourseContext.Course
      }
      on sectionCompleted: event Course.SectionCompleted is {
        send sectionCompleted to outlet CourseEventSplitToEnrollmentAnalytics
        tell sectionCompleted to entity CourseContext.Course
      }
      on other is {
        error "Unexpected message for processor CourseEventSplit"
      }
    } with {
      briefly "Course event fan-out handler"
      described as {
        |Delivers each Course event to all of its consumers.
      }
    }
  } with {
    briefly "Course event fan-out"
    described as {
      |Fans Course events out to the repository and projectors.
    }
  }
  connector 'ToRoomSchedulingService Feed' is from outlet CourseContext.CourseEventSplit.CourseEventSplitToToRoomSchedulingService to inlet CourseContext.ToRoomSchedulingService.ToRoomSchedulingServiceIn with {
    briefly "The Course events ToRoomSchedulingService translates, on their way to it"
  }
  connector 'ToNotificationService Feed' is from outlet CourseContext.CourseEventSplit.CourseEventSplitToToNotificationService to inlet CourseContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The Course events ToNotificationService translates, on their way to it"
  }
  connector 'CourseEvent Stream' is from outlet CourseContext.Course.CourseEvents2 to inlet CourseContext.CourseEventSplit.CourseEventSplitIn with {
    briefly "Course events, fanned out to storage and read models"
  }
  connector 'EnrollmentAnalytics Feed' is from outlet CourseContext.CourseEventSplit.CourseEventSplitToEnrollmentAnalytics to inlet CourseContext.EnrollmentAnalytics.EnrollmentAnalyticsFromCourse with {
    briefly "Course events feeding the EnrollmentAnalytics projection"
  }
  connector 'EnrollmentAnalytics Storage' is from outlet CourseContext.EnrollmentAnalytics.EnrollmentAnalyticsToRepository to inlet CourseContext.CourseRepository.CourseRepositoryFromEnrollmentAnalytics with {
    briefly "EnrollmentAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for course management"
  described as {
    | The CourseContext is the bounded context for academic
    | course catalog, scheduling, and enrollment.
  }
}
