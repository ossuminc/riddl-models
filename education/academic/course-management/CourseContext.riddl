// Course Management - Course Context
context CourseContext is {
  adaptor FromFacultyService from context FacultyService is { 
    handler FromFacultyServiceHandler is {
      on event FacultyService.InstructorAssigned is {
        do "the model receives instructor assigned"
      }
      on event FacultyService.InstructorAvailabilityUpdated is {
        do "the model receives instructor availability updated"
      }
      on other is {
        error "Unexpected message for adaptor FromFacultyService"
      }
    } with {
      briefly "from faculty service"
      described as {
        |Carries messages from the external FacultyService.
      }
    }
  } with {
    briefly "FacultyService integration"
    described as {
      |The model's side of the FacultyService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendEnrollmentConfirmation is {
        do "the model sends send enrollment confirmation"
      }
      on command NotificationService.SendWaitlistNotification is {
        do "the model sends send waitlist notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromRoomSchedulingService from context RoomSchedulingService is { 
    handler FromRoomSchedulingServiceHandler is {
      on event RoomSchedulingService.RoomReserved is {
        do "the model receives room reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromRoomSchedulingService"
      }
    } with {
      briefly "from room scheduling service"
      described as {
        |Carries messages from the external RoomSchedulingService.
      }
    }
  } with {
    briefly "RoomSchedulingService integration"
    described as {
      |The model's side of the RoomSchedulingService conversation.
    }
  }
  adaptor ToRoomSchedulingService to context RoomSchedulingService is { 
    handler ToRoomSchedulingServiceHandler is {
      on command RoomSchedulingService.ReserveRoom is {
        do "the model sends reserve room"
      }
      on other is {
        error "Unexpected message for adaptor ToRoomSchedulingService"
      }
    } with {
      briefly "to room scheduling service"
      described as {
        |Carries messages to the external RoomSchedulingService.
      }
    }
  } with {
    briefly "RoomSchedulingService integration"
    described as {
      |The model's side of the RoomSchedulingService conversation.
    }
  }
  adaptor FromStudentInformationService from context StudentInformationService is { 
    handler FromStudentInformationServiceHandler is {
      on event StudentInformationService.StudentRegistered is {
        do "the model receives student registered"
      }
      on event StudentInformationService.StudentStatusChanged is {
        do "the model receives student status changed"
      }
      on other is {
        error "Unexpected message for adaptor FromStudentInformationService"
      }
    } with {
      briefly "from student information service"
      described as {
        |Carries messages from the external StudentInformationService.
      }
    }
  } with {
    briefly "StudentInformationService integration"
    described as {
      |The model's side of the StudentInformationService conversation.
    }
  }
  include "types.riddl"
  include "Course.riddl"
  // Repository for course persistence
  repository CourseRepository as merge is {
    inlet CourseRepositoryFromCourse is type CourseEvent    inlet CourseRepositoryFromEnrollmentAnalytics is type CourseEvent    outlet CourseRepositoryResponses is type Course.CourseResult
    record StoredCourse is  {
      courseId: CourseId with {
        briefly "courseId"
        described as {
          |The courseId column of the stored course row.
        }
      }
      info: CourseInfo with {
        briefly "info"
        described as {
          |The info column of the stored course row.
        }
      }
    } with {
      briefly "Stored course row"
      described as {
        |The persistence shape of course data as this repository stores it.
      }
    }
    schema CourseData is relational
      of courses as type StoredCourse
        index on field StoredCourse.courseId
        index on field StoredCourse.info.courseCode
 with {
      briefly "Course data schema"
      described as {
        |The relational schema holding course data for the CourseRepository.
      }
    }
    handler CoursePersistence is {
      on query GetEnrollmentSummary is {
        do "read the enrollment summary projection"
        reply result EnrollmentSummaryView
      }
      on command Course.CreateCourse is {
        tell event Course.CourseCreated to entity CourseContext.Course
        do "Store new course record"
      }
      on command Course.ScheduleSection is {
        tell event Course.SectionScheduled to entity CourseContext.Course
        do "Store section record"
      }
      on command Course.EnrollStudent is {
        do "Store enrollment record"
      }
      on command Course.RecordGrade is {
        tell event Course.GradeRecorded to entity CourseContext.Course
        do "Update enrollment with grade"
      }
      on command Course.CompleteSection is {
        tell event Course.SectionCompleted to entity CourseContext.Course
        do "Update section status"
      }
    } with {
      briefly "Persists course commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Course data persistence"
    described as {
      | The CourseRepository provides persistent storage for
      | courses, sections, and enrollments.
    }
  }
  // Projector for enrollment analytics
  query GetEnrollmentSummary is  {
    enrollmentSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which enrollment summary to retrieve.
      }
    }
  } with {
    briefly "Get enrollment summary"
    described as {
      |Retrieves the enrollment summary projection.
    }
  }
  result EnrollmentSummaryView is  {
    enrollmentSummary: EnrollmentAnalytics.EnrollmentSummary with {
      briefly "Enrollment summary"
      described as {
        |The enrollment summary being returned.
      }
    }
  } with {
    briefly "Enrollment summary view"
    described as {
      |Read model view carrying the enrollment summary projection.
    }
  }
  projector EnrollmentAnalytics as flow is {
    updates repository CourseContext.CourseRepository
    inlet EnrollmentAnalyticsFromCourse is type CourseEvent    outlet EnrollmentAnalyticsOut is type CourseEvent
    record EnrollmentSummary is  {
      termId: TermId with {
        briefly "Term"
        described as {
          |Academic term.
        }
      }
      totalEnrollments: Natural with {
        briefly "Total"
        described as {
          |Total enrollments.
        }
      }
      averageClassSize: Decimal(5,2) with {
        briefly "Avg size"
        described as {
          |Average class size.
        }
      }
      fillRate: Decimal(5,2) with {
        briefly "Fill rate"
        described as {
          |Capacity utilization.
        }
      }
    } with {
      briefly "Enrollment summary"
      described as {
        |Term enrollment metrics.
      }
    }
    handler AnalyticsHandler is {
      on studentEnrolled: event Course.StudentEnrolled is {
        tell studentEnrolled to repository CourseContext.CourseRepository
        do "Update enrollment counts"
      }
      on studentDropped: event Course.StudentDropped is {
        tell studentDropped to repository CourseContext.CourseRepository
        do "Update enrollment counts"
      }
      on sectionCancelled: event Course.SectionCancelled is {
        tell sectionCancelled to repository CourseContext.CourseRepository
        do "Adjust capacity metrics"
      }
    } with {
      briefly "Maintains enrollment analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Enrollment analytics projections"
    described as {
      |Maintains enrollment analytics data.
    }
  }
  // ---- Event publication for Course ----
  type CourseEvent is one of {
    CourseContext.Course.CourseCreated or CourseContext.Course.CourseUpdated or CourseContext.Course.CourseActivated or CourseContext.Course.CourseDeactivated or CourseContext.Course.SectionScheduled or CourseContext.Course.SectionCancelled or CourseContext.Course.StudentEnrolled or CourseContext.Course.StudentDropped or CourseContext.Course.GradeRecorded or CourseContext.Course.SectionCompleted
  } with {
    briefly "Course event alternation"
    described as {
      |Union of all Course events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CourseEventSource as source is {
    outlet CourseEvents is type CourseEvent
    handler CourseSourceHandler is {
      on courseCreated: event Course.CourseCreated is {
        send courseCreated to outlet CourseEvents
      }
      on courseUpdated: event Course.CourseUpdated is {
        send courseUpdated to outlet CourseEvents
      }
      on courseActivated: event Course.CourseActivated is {
        send courseActivated to outlet CourseEvents
      }
      on courseDeactivated: event Course.CourseDeactivated is {
        send courseDeactivated to outlet CourseEvents
      }
      on sectionScheduled: event Course.SectionScheduled is {
        send sectionScheduled to outlet CourseEvents
      }
      on sectionCancelled: event Course.SectionCancelled is {
        send sectionCancelled to outlet CourseEvents
      }
      on studentEnrolled: event Course.StudentEnrolled is {
        send studentEnrolled to outlet CourseEvents
      }
      on studentDropped: event Course.StudentDropped is {
        send studentDropped to outlet CourseEvents
      }
      on gradeRecorded: event Course.GradeRecorded is {
        send gradeRecorded to outlet CourseEvents
      }
      on sectionCompleted: event Course.SectionCompleted is {
        send sectionCompleted to outlet CourseEvents
      }
      on other is {
        error "Unexpected message for source CourseEventSource"
      }
    } with {
      briefly "Course source handler"
      described as {
        |Publishes Course events onto the outlet.
      }
    }
  } with {
    briefly "Course event source"
    described as {
      |Publishes Course entity events into the streaming topology.
    }
  }
  processor CourseEventSink as sink is {
    inlet CourseInlet is type CourseEvent    handler CourseSinkHandler is {
      on courseCreated: event Course.CourseCreated is {
        tell courseCreated to repository CourseContext.CourseRepository
      }
      on courseUpdated: event Course.CourseUpdated is {
        tell courseUpdated to repository CourseContext.CourseRepository
      }
      on courseActivated: event Course.CourseActivated is {
        tell courseActivated to repository CourseContext.CourseRepository
      }
      on courseDeactivated: event Course.CourseDeactivated is {
        tell courseDeactivated to repository CourseContext.CourseRepository
      }
      on sectionScheduled: event Course.SectionScheduled is {
        tell sectionScheduled to repository CourseContext.CourseRepository
      }
      on sectionCancelled: event Course.SectionCancelled is {
        tell sectionCancelled to repository CourseContext.CourseRepository
      }
      on studentEnrolled: event Course.StudentEnrolled is {
        tell studentEnrolled to repository CourseContext.CourseRepository
      }
      on studentDropped: event Course.StudentDropped is {
        tell studentDropped to repository CourseContext.CourseRepository
      }
      on gradeRecorded: event Course.GradeRecorded is {
        tell gradeRecorded to repository CourseContext.CourseRepository
      }
      on sectionCompleted: event Course.SectionCompleted is {
        tell sectionCompleted to repository CourseContext.CourseRepository
      }
      on other is {
        error "Unexpected message for sink CourseEventSink"
      }
    } with {
      briefly "Course sink handler"
      described as {
        |Persists Course events via the repository.
      }
    }
  } with {
    briefly "Course event sink"
    described as {
      |Receives Course events for persistence.
    }
  }
  connector CourseEventFlow is from outlet CourseContext.CourseEventSource.CourseEvents to inlet CourseContext.CourseEventSink.CourseInlet with {
    briefly "Course event flow"
    described as {
      |Connects the Course source to its sink.
    }
  }
  processor CourseEventSplit as split is {
    inlet CourseEventSplitIn is type CourseEvent    outlet CourseEventSplitToCourseRepository is type CourseEvent
    outlet CourseEventSplitToEnrollmentAnalytics is type CourseEvent
    handler CourseEventSplitHandler is {
      on courseCreated: event Course.CourseCreated is {
        send courseCreated to outlet CourseEventSplitToCourseRepository
        send courseCreated to outlet CourseEventSplitToEnrollmentAnalytics
        tell courseCreated to entity CourseContext.Course
      }
      on courseUpdated: event Course.CourseUpdated is {
        send courseUpdated to outlet CourseEventSplitToCourseRepository
        send courseUpdated to outlet CourseEventSplitToEnrollmentAnalytics
        tell courseUpdated to entity CourseContext.Course
      }
      on courseActivated: event Course.CourseActivated is {
        send courseActivated to outlet CourseEventSplitToCourseRepository
        send courseActivated to outlet CourseEventSplitToEnrollmentAnalytics
        tell courseActivated to entity CourseContext.Course
      }
      on courseDeactivated: event Course.CourseDeactivated is {
        send courseDeactivated to outlet CourseEventSplitToCourseRepository
        send courseDeactivated to outlet CourseEventSplitToEnrollmentAnalytics
        tell courseDeactivated to entity CourseContext.Course
      }
      on sectionScheduled: event Course.SectionScheduled is {
        send sectionScheduled to outlet CourseEventSplitToCourseRepository
        send sectionScheduled to outlet CourseEventSplitToEnrollmentAnalytics
        tell sectionScheduled to entity CourseContext.Course
      }
      on sectionCancelled: event Course.SectionCancelled is {
        send sectionCancelled to outlet CourseEventSplitToCourseRepository
        send sectionCancelled to outlet CourseEventSplitToEnrollmentAnalytics
        tell sectionCancelled to entity CourseContext.Course
      }
      on studentEnrolled: event Course.StudentEnrolled is {
        send studentEnrolled to outlet CourseEventSplitToCourseRepository
        send studentEnrolled to outlet CourseEventSplitToEnrollmentAnalytics
        tell studentEnrolled to entity CourseContext.Course
      }
      on studentDropped: event Course.StudentDropped is {
        send studentDropped to outlet CourseEventSplitToCourseRepository
        send studentDropped to outlet CourseEventSplitToEnrollmentAnalytics
        tell studentDropped to entity CourseContext.Course
      }
      on gradeRecorded: event Course.GradeRecorded is {
        send gradeRecorded to outlet CourseEventSplitToCourseRepository
        send gradeRecorded to outlet CourseEventSplitToEnrollmentAnalytics
        tell gradeRecorded to entity CourseContext.Course
      }
      on sectionCompleted: event Course.SectionCompleted is {
        send sectionCompleted to outlet CourseEventSplitToCourseRepository
        send sectionCompleted to outlet CourseEventSplitToEnrollmentAnalytics
        tell sectionCompleted to entity CourseContext.Course
      }
      on other is {
        error "Unexpected message for processor CourseEventSplit"
      }
    } with {
      briefly "Course event fan-out handler"
      described as {
        |Delivers each Course event to all of its consumers.
      }
    }
  } with {
    briefly "Course event fan-out"
    described as {
      |Fans Course events out to the repository and projectors.
    }
  }
  connector 'CourseEvent Stream' is from outlet CourseContext.Course.CourseEvents2 to inlet CourseContext.CourseEventSplit.CourseEventSplitIn with {
    briefly "Course events, fanned out to storage and read models"
  }
  connector 'CourseEvent Storage' is from outlet CourseContext.CourseEventSplit.CourseEventSplitToCourseRepository to inlet CourseContext.CourseRepository.CourseRepositoryFromCourse with {
    briefly "Course events on their way to storage"
  }
  connector 'EnrollmentAnalytics Feed' is from outlet CourseContext.CourseEventSplit.CourseEventSplitToEnrollmentAnalytics to inlet CourseContext.EnrollmentAnalytics.EnrollmentAnalyticsFromCourse with {
    briefly "Course events feeding the EnrollmentAnalytics projection"
  }
  connector 'EnrollmentAnalytics Storage' is from outlet CourseContext.EnrollmentAnalytics.EnrollmentAnalyticsOut to inlet CourseContext.CourseRepository.CourseRepositoryFromEnrollmentAnalytics with {
    briefly "The EnrollmentAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for course management"
  described as {
    | The CourseContext is the bounded context for academic
    | course catalog, scheduling, and enrollment.
  }
}
