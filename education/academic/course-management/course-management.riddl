// Course Management Domain Model
// Academic course catalog, scheduling, and enrollment
domain CourseManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Registrar is "staff managing course catalog" with {
    briefly "Registrar"
    described as {
      |Staff responsible for course administration.
    }
  }
  user Instructor is "faculty teaching courses" with {
    briefly "Instructor"
    described as {
      |Faculty member assigned to teach.
    }
  }
  user Student is "student enrolling in courses" with {
    briefly "Student"
    described as {
      |Person taking courses.
    }
  }
  epic CourseEnrollmentEpic is {
    user Student wants to "to enroll in courses" so that "they can complete their academic program"
    case EnrollInCourse is {
      user Student wants to "to register for a specific course" so that "they can attend and earn credit"
      step is "Student searches course catalog" "for available courses" "matching requirements" with {
        briefly "Search catalog"
        described as {
          |Student finds courses.
        }
      }
      step is "Student checks prerequisites" "and seat availability" "for selected course" with {
        briefly "Check prereqs"
        described as {
          |Student verifies eligibility.
        }
      }
      step take input CourseManagementApp.CourseManagementScreen.EnrollStudentInput from user Student with {
        briefly "Enroll"
        described as {
          |Send enrollment command.
        }
      }
      step is "System confirms enrollment" "and updates student schedule" "and roster" with {
        briefly "Confirm"
        described as {
          |System confirms enrollment.
        }
      }
    } with {
      briefly "Course enrollment workflow"
      described as {
        |Standard flow for course registration.
      }
    }
  } with {
    briefly "Course enrollment processing"
    described as {
      | Epic covering course enrollment from catalog search
      | through registration and confirmation.
    }
  }
  include "CourseContext.riddl"
  include "external-contexts.riddl"
  application context CourseManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CourseManagement are delivered.
      }
    }
    group CourseManagementScreen is {
      input EnrollStudentInput acquires command CourseContext.Course.EnrollStudent with {
        briefly "Enroll student control"
        described as {
          |The control through which a user submits the enroll student request.
        }
      }
    } with {
      briefly "Course management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppCourseCommands is type CourseContext.Course.CourseCommand
    inlet AppCourseRepositoryResponses is result CourseContext.Course.CourseResult    handler CourseManagementAppHandler is {
      on other is {
        error "Unexpected message for application context CourseManagementApp"
      }
    } with {
      briefly "CourseManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CourseManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'CourseCommand Stream' is from outlet CourseManagementApp.AppCourseCommands to inlet CourseContext.CourseCommandStreamIn with {
    briefly "Course commands from the application"
  }
  persistent connector 'CourseResult Stream' is from outlet CourseContext.CourseResultStreamOut to inlet CourseManagementApp.AppCourseRepositoryResponses with {
    briefly "Course query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CourseManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Course management domain"
  described as {
    | The CourseManagement domain handles academic course
    | catalog, scheduling, sections, and enrollment.
  }
}
