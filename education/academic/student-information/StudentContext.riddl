// Student Information - Student Context
context StudentContext as router is {
  inlet StudentCommandStreamIn is type StudentCommand  outlet StudentCommandStreamOut is type StudentCommand
  inlet StudentResultStreamIn is type Student.StudentResult  outlet StudentResultStreamOut is type Student.StudentResult
  handler StudentContextBoundary is {
    on registerStudent: command Student.RegisterStudent is {
      send registerStudent to outlet StudentContext.StudentCommandStreamOut
    }
    on updateStudentInfo: command Student.UpdateStudentInfo is {
      send updateStudentInfo to outlet StudentContext.StudentCommandStreamOut
    }
    on enrollInProgram: command Student.EnrollInProgram is {
      send enrollInProgram to outlet StudentContext.StudentCommandStreamOut
    }
    on changeEnrollmentStatus: command Student.ChangeEnrollmentStatus is {
      send changeEnrollmentStatus to outlet StudentContext.StudentCommandStreamOut
    }
    on recordCourse: command Student.RecordCourse is {
      send recordCourse to outlet StudentContext.StudentCommandStreamOut
    }
    on updateGrade: command Student.UpdateGrade is {
      send updateGrade to outlet StudentContext.StudentCommandStreamOut
    }
    on placeHold: command Student.PlaceHold is {
      send placeHold to outlet StudentContext.StudentCommandStreamOut
    }
    on releaseHold: command Student.ReleaseHold is {
      send releaseHold to outlet StudentContext.StudentCommandStreamOut
    }
    on assignAdvisor: command Student.AssignAdvisor is {
      send assignAdvisor to outlet StudentContext.StudentCommandStreamOut
    }
    on updateAcademicStanding: command Student.UpdateAcademicStanding is {
      send updateAcademicStanding to outlet StudentContext.StudentCommandStreamOut
    }
    on graduate: command Student.Graduate is {
      send graduate to outlet StudentContext.StudentCommandStreamOut
    }
    on studentResult: result Student.StudentResult is {
      send studentResult to outlet StudentContext.StudentResultStreamOut
    }
    on other is {
      error "Unexpected message at the StudentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'StudentCommand Stream Intake' is from outlet StudentContext.StudentCommandStreamOut to inlet StudentContext.Student.StudentCommands  connector 'StudentResult Stream Egress' is from outlet StudentContext.StudentRepository.StudentRepositoryResponses to inlet StudentContext.StudentResultStreamIn  adaptor FromAdmissionsService from context AdmissionsService is { 
    handler FromAdmissionsServiceHandler is {
      on event AdmissionsService.AdmissionDecisionMade is {
        do "the model receives admission decision made"
      }
      on event AdmissionsService.ApplicationReceived is {
        do "the model receives application received"
      }
      on other is {
        error "Unexpected message for adaptor FromAdmissionsService"
      }
    } with {
      briefly "from admissions service"
      described as {
        |Carries messages from the external AdmissionsService.
      }
    }
  } with {
    briefly "AdmissionsService integration"
    described as {
      |The model's side of the AdmissionsService conversation.
    }
  }
  adaptor FromFinancialAidService from context FinancialAidService is { 
    handler FromFinancialAidServiceHandler is {
      on event FinancialAidService.AidStatusChanged is {
        do "the model receives aid status changed"
      }
      on event FinancialAidService.FinancialAidAwarded is {
        do "the model receives financial aid awarded"
      }
      on other is {
        error "Unexpected message for adaptor FromFinancialAidService"
      }
    } with {
      briefly "from financial aid service"
      described as {
        |Carries messages from the external FinancialAidService.
      }
    }
  } with {
    briefly "FinancialAidService integration"
    described as {
      |The model's side of the FinancialAidService conversation.
    }
  }
  adaptor FromIdentityService from context IdentityService is { 
    handler FromIdentityServiceHandler is {
      on event IdentityService.IdentityVerified is {
        do "the model receives identity verified"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityService"
      }
    } with {
      briefly "from identity service"
      described as {
        |Carries messages from the external IdentityService.
      }
    }
  } with {
    briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor ToIdentityService to context IdentityService is { 
    handler ToIdentityServiceHandler is {
      on command IdentityService.VerifyIdentity is {
        do "the model sends verify identity"
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityService"
      }
    } with {
      briefly "to identity service"
      described as {
        |Carries messages to the external IdentityService.
      }
    }
  } with {
    briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor FromTranscriptService from context TranscriptService is { 
    handler FromTranscriptServiceHandler is {
      on event TranscriptService.TranscriptDelivered is {
        do "the model receives transcript delivered"
      }
      on event TranscriptService.TranscriptGenerated is {
        do "the model receives transcript generated"
      }
      on other is {
        error "Unexpected message for adaptor FromTranscriptService"
      }
    } with {
      briefly "from transcript service"
      described as {
        |Carries messages from the external TranscriptService.
      }
    }
  } with {
    briefly "TranscriptService integration"
    described as {
      |The model's side of the TranscriptService conversation.
    }
  }
  adaptor ToTranscriptService to context TranscriptService is { 
    handler ToTranscriptServiceHandler is {
      on command TranscriptService.RequestTranscript is {
        do "the model sends request transcript"
      }
      on other is {
        error "Unexpected message for adaptor ToTranscriptService"
      }
    } with {
      briefly "to transcript service"
      described as {
        |Carries messages to the external TranscriptService.
      }
    }
  } with {
    briefly "TranscriptService integration"
    described as {
      |The model's side of the TranscriptService conversation.
    }
  }
  include "types.riddl"
  include "Student.riddl"
  // Repository for student persistence
  type StudentRepositoryCommand is one of {
    StudentContext.StudentRepository.PersistAcademicStandingUpdated or StudentContext.StudentRepository.PersistAdvisorAssigned or StudentContext.StudentRepository.PersistCourseRecorded or StudentContext.StudentRepository.PersistGradeUpdated or StudentContext.StudentRepository.PersistHoldPlaced or StudentContext.StudentRepository.PersistHoldReleased or StudentContext.StudentRepository.PersistProgramEnrolled or StudentContext.StudentRepository.PersistStatusChanged or StudentContext.StudentRepository.PersistStudentGraduated or StudentContext.StudentRepository.PersistStudentInfoUpdated or StudentContext.StudentRepository.PersistStudentRegistered
  } with {
    briefly "Anything that writes StudentRepository"
    described as {
      |The persistence commands StudentRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository StudentRepository as flow is {
    inlet StudentRepositoryFromEnrollmentAnalytics is type StudentRepositoryCommand
    command PersistAcademicStandingUpdated is  {
      studentId: StudentId with {
        briefly "Row addressed"
        described as {
          |Which stored row AcademicStandingUpdated applies to.
        }
      }
    } with {
      briefly "Persist AcademicStandingUpdated"
      described as {
        |Instructs this repository to apply AcademicStandingUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAdvisorAssigned is  {
      studentId: StudentId with {
        briefly "Row addressed"
        described as {
          |Which stored row AdvisorAssigned applies to.
        }
      }
    } with {
      briefly "Persist AdvisorAssigned"
      described as {
        |Instructs this repository to apply AdvisorAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCourseRecorded is  {
      studentId: StudentId with {
        briefly "Row addressed"
        described as {
          |Which stored row CourseRecorded applies to.
        }
      }
    } with {
      briefly "Persist CourseRecorded"
      described as {
        |Instructs this repository to apply CourseRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHoldPlaced is  {
      studentId: StudentId with {
        briefly "Row addressed"
        described as {
          |Which stored row HoldPlaced applies to.
        }
      }
    } with {
      briefly "Persist HoldPlaced"
      described as {
        |Instructs this repository to apply HoldPlaced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHoldReleased is  {
      studentId: StudentId with {
        briefly "Row addressed"
        described as {
          |Which stored row HoldReleased applies to.
        }
      }
    } with {
      briefly "Persist HoldReleased"
      described as {
        |Instructs this repository to apply HoldReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStudentInfoUpdated is  {
      studentId: StudentId with {
        briefly "Row addressed"
        described as {
          |Which stored row StudentInfoUpdated applies to.
        }
      }
    } with {
      briefly "Persist StudentInfoUpdated"
      described as {
        |Instructs this repository to apply StudentInfoUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistGradeUpdated is  {
      studentId: StudentId with {
        briefly "Row addressed"
        described as {
          |Which stored row GradeUpdated applies to.
        }
      }
    } with {
      briefly "Persist GradeUpdated"
      described as {
        |Instructs this repository to apply GradeUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProgramEnrolled is  {
      studentId: StudentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProgramEnrolled applies to.
        }
      }
    } with {
      briefly "Persist ProgramEnrolled"
      described as {
        |Instructs this repository to apply ProgramEnrolled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStatusChanged is  {
      studentId: StudentId with {
        briefly "Row addressed"
        described as {
          |Which stored row StatusChanged applies to.
        }
      }
    } with {
      briefly "Persist StatusChanged"
      described as {
        |Instructs this repository to apply StatusChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStudentGraduated is  {
      studentId: StudentId with {
        briefly "Row addressed"
        described as {
          |Which stored row StudentGraduated applies to.
        }
      }
    } with {
      briefly "Persist StudentGraduated"
      described as {
        |Instructs this repository to apply StudentGraduated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStudentRegistered is  {
      studentId: StudentId with {
        briefly "Row addressed"
        described as {
          |Which stored row StudentRegistered applies to.
        }
      }
    } with {
      briefly "Persist StudentRegistered"
      described as {
        |Instructs this repository to apply StudentRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet StudentRepositoryResponses is type Student.StudentResult
    record StoredStudent is  {
      studentId: StudentId with {
        briefly "studentId"
        described as {
          |The studentId column of the stored student row.
        }
      }
      lastName: String(1,100) with {
        briefly "lastName"
        described as {
          |The lastName column of the stored student row; indexed for lookup.
        }
      }
    } with {
      briefly "Stored student row"
      described as {
        |The persistence shape of student data as this repository stores it.
      }
    }
    schema StudentData is relational
      of students as type StoredStudent
        index on field StoredStudent.studentId
        index on field StoredStudent.lastName
 with {
      briefly "Student data schema"
      described as {
        |The relational schema holding student data for the StudentRepository.
      }
    }
    handler StudentPersistence is {
      on persistAcademicStandingUpdated: command PersistAcademicStandingUpdated is {
        do "apply AcademicStandingUpdated to the stored row"
      }
      on persistAdvisorAssigned: command PersistAdvisorAssigned is {
        do "apply AdvisorAssigned to the stored row"
      }
      on persistCourseRecorded: command PersistCourseRecorded is {
        do "apply CourseRecorded to the stored row"
      }
      on persistHoldPlaced: command PersistHoldPlaced is {
        do "apply HoldPlaced to the stored row"
      }
      on persistHoldReleased: command PersistHoldReleased is {
        do "apply HoldReleased to the stored row"
      }
      on persistStudentInfoUpdated: command PersistStudentInfoUpdated is {
        do "apply StudentInfoUpdated to the stored row"
      }
      on persistGradeUpdated: command PersistGradeUpdated is {
        do "apply GradeUpdated to the stored row"
      }
      on persistProgramEnrolled: command PersistProgramEnrolled is {
        do "apply ProgramEnrolled to the stored row"
      }
      on persistStatusChanged: command PersistStatusChanged is {
        do "apply StatusChanged to the stored row"
      }
      on persistStudentGraduated: command PersistStudentGraduated is {
        do "apply StudentGraduated to the stored row"
      }
      on persistStudentRegistered: command PersistStudentRegistered is {
        do "apply StudentRegistered to the stored row"
      }
      on query GetEnrollmentStats is {
        let enrollmentStatsView: type EnrollmentStatsView = prompt("read the enrollment stats projection")
        reply enrollmentStatsView
      }
    } with {
      briefly "Persists student commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Student data persistence"
    described as {
      | The StudentRepository provides persistent storage for
      | student records, courses, and academic history.
    }
  }
  // Projector for enrollment analytics
  query GetEnrollmentStats replies result EnrollmentStatsView is  {
    enrollmentStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which enrollment stats to retrieve.
      }
    }
  } with {
    briefly "Get enrollment stats"
    described as {
      |Retrieves the enrollment stats projection.
    }
  }
  result EnrollmentStatsView is  {
    enrollmentStats: EnrollmentAnalytics.EnrollmentStats with {
      briefly "Enrollment stats"
      described as {
        |The enrollment stats being returned.
      }
    }
  } with {
    briefly "Enrollment stats view"
    described as {
      |Read model view carrying the enrollment stats projection.
    }
  }
  projector EnrollmentAnalytics as flow is {
    outlet EnrollmentAnalyticsToRepository is type StudentRepositoryCommand
    updates repository StudentContext.StudentRepository
    inlet EnrollmentAnalyticsFromStudent is type StudentEvent
    record EnrollmentStats is  {
      programId: ProgramId with {
        briefly "Program"
        described as {
          |Academic program.
        }
      }
      totalEnrolled: Natural with {
        briefly "Enrolled"
        described as {
          |Total enrolled.
        }
      }
      averageGpa: Decimal(4,2) with {
        briefly "Avg GPA"
        described as {
          |Average GPA.
        }
      }
      graduationRate: Decimal(5,2) with {
        briefly "Grad rate"
        described as {
          |Graduation rate.
        }
      }
      retentionRate: Decimal(5,2) with {
        briefly "Retention"
        described as {
          |Retention rate.
        }
      }
    } with {
      briefly "Enrollment statistics"
      described as {
        |Program enrollment metrics.
      }
    }
    handler AnalyticsHandler is {
      on academicStandingUpdated: event Student.AcademicStandingUpdated is {
        tell command StudentContext.StudentRepository.PersistAcademicStandingUpdated(studentId = academicStandingUpdated.studentId) to repository StudentContext.StudentRepository
        do "apply AcademicStandingUpdated to the EnrollmentAnalytics projection"
      }
      on advisorAssigned: event Student.AdvisorAssigned is {
        tell command StudentContext.StudentRepository.PersistAdvisorAssigned(studentId = advisorAssigned.studentId) to repository StudentContext.StudentRepository
        do "apply AdvisorAssigned to the EnrollmentAnalytics projection"
      }
      on courseRecorded: event Student.CourseRecorded is {
        tell command StudentContext.StudentRepository.PersistCourseRecorded(studentId = courseRecorded.studentId) to repository StudentContext.StudentRepository
        do "apply CourseRecorded to the EnrollmentAnalytics projection"
      }
      on holdPlaced: event Student.HoldPlaced is {
        tell command StudentContext.StudentRepository.PersistHoldPlaced(studentId = holdPlaced.studentId) to repository StudentContext.StudentRepository
        do "apply HoldPlaced to the EnrollmentAnalytics projection"
      }
      on holdReleased: event Student.HoldReleased is {
        tell command StudentContext.StudentRepository.PersistHoldReleased(studentId = holdReleased.studentId) to repository StudentContext.StudentRepository
        do "apply HoldReleased to the EnrollmentAnalytics projection"
      }
      on studentInfoUpdated: event Student.StudentInfoUpdated is {
        tell command StudentContext.StudentRepository.PersistStudentInfoUpdated(studentId = studentInfoUpdated.studentId) to repository StudentContext.StudentRepository
        do "apply StudentInfoUpdated to the EnrollmentAnalytics projection"
      }
      on studentRegistered: event StudentContext.Student.StudentRegistered is {
        tell command StudentContext.StudentRepository.PersistStudentRegistered(studentId = studentRegistered.studentId) to repository StudentContext.StudentRepository
        do "Update enrollment counts"
      }
      on programEnrolled: event StudentContext.Student.ProgramEnrolled is {
        tell command StudentContext.StudentRepository.PersistProgramEnrolled(studentId = programEnrolled.studentId) to repository StudentContext.StudentRepository
        do "Update program metrics"
      }
      on gradeUpdated: event StudentContext.Student.GradeUpdated is {
        tell command StudentContext.StudentRepository.PersistGradeUpdated(studentId = gradeUpdated.studentId) to repository StudentContext.StudentRepository
        do "Update GPA metrics"
      }
      on studentGraduated: event StudentContext.Student.StudentGraduated is {
        tell command StudentContext.StudentRepository.PersistStudentGraduated(studentId = studentGraduated.studentId) to repository StudentContext.StudentRepository
        do "Update graduation metrics"
      }
      on statusChanged: event StudentContext.Student.StatusChanged is {
        tell command StudentContext.StudentRepository.PersistStatusChanged(studentId = statusChanged.studentId) to repository StudentContext.StudentRepository
        do "Update retention metrics"
      }
    } with {
      briefly "Maintains enrollment analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Enrollment analytics projections"
    described as {
      |Maintains enrollment analytics data.
    }
  }
  // ---- Event publication for Student ----
  type StudentEvent is one of {
    StudentContext.Student.StudentRegistered or StudentContext.Student.StudentInfoUpdated or StudentContext.Student.ProgramEnrolled or StudentContext.Student.StatusChanged or StudentContext.Student.CourseRecorded or StudentContext.Student.GradeUpdated or StudentContext.Student.HoldPlaced or StudentContext.Student.HoldReleased or StudentContext.Student.AdvisorAssigned or StudentContext.Student.AcademicStandingUpdated or StudentContext.Student.StudentGraduated
  } with {
    briefly "Student event alternation"
    described as {
      |Union of all Student events, for streaming and event-sourced
      |persistence.
    }
  }
  processor StudentEventSplit as flow is {
    inlet StudentEventSplitIn is type StudentEvent
    outlet StudentEventSplitToEnrollmentAnalytics is type StudentEvent
    handler StudentEventSplitHandler is {
      on studentRegistered: event Student.StudentRegistered is {
        send studentRegistered to outlet StudentEventSplitToEnrollmentAnalytics
        tell studentRegistered to entity StudentContext.Student
      }
      on studentInfoUpdated: event Student.StudentInfoUpdated is {
        send studentInfoUpdated to outlet StudentEventSplitToEnrollmentAnalytics
        tell studentInfoUpdated to entity StudentContext.Student
      }
      on programEnrolled: event Student.ProgramEnrolled is {
        send programEnrolled to outlet StudentEventSplitToEnrollmentAnalytics
        tell programEnrolled to entity StudentContext.Student
      }
      on statusChanged: event Student.StatusChanged is {
        send statusChanged to outlet StudentEventSplitToEnrollmentAnalytics
        tell statusChanged to entity StudentContext.Student
      }
      on courseRecorded: event Student.CourseRecorded is {
        send courseRecorded to outlet StudentEventSplitToEnrollmentAnalytics
        tell courseRecorded to entity StudentContext.Student
      }
      on gradeUpdated: event Student.GradeUpdated is {
        send gradeUpdated to outlet StudentEventSplitToEnrollmentAnalytics
        tell gradeUpdated to entity StudentContext.Student
      }
      on holdPlaced: event Student.HoldPlaced is {
        send holdPlaced to outlet StudentEventSplitToEnrollmentAnalytics
        tell holdPlaced to entity StudentContext.Student
      }
      on holdReleased: event Student.HoldReleased is {
        send holdReleased to outlet StudentEventSplitToEnrollmentAnalytics
        tell holdReleased to entity StudentContext.Student
      }
      on advisorAssigned: event Student.AdvisorAssigned is {
        send advisorAssigned to outlet StudentEventSplitToEnrollmentAnalytics
        tell advisorAssigned to entity StudentContext.Student
      }
      on academicStandingUpdated: event Student.AcademicStandingUpdated is {
        send academicStandingUpdated to outlet StudentEventSplitToEnrollmentAnalytics
        tell academicStandingUpdated to entity StudentContext.Student
      }
      on studentGraduated: event Student.StudentGraduated is {
        send studentGraduated to outlet StudentEventSplitToEnrollmentAnalytics
        tell studentGraduated to entity StudentContext.Student
      }
      on other is {
        error "Unexpected message for processor StudentEventSplit"
      }
    } with {
      briefly "Student event fan-out handler"
      described as {
        |Delivers each Student event to all of its consumers.
      }
    }
  } with {
    briefly "Student event fan-out"
    described as {
      |Fans Student events out to the repository and projectors.
    }
  }
  connector 'StudentEvent Stream' is from outlet StudentContext.Student.StudentEvents2 to inlet StudentContext.StudentEventSplit.StudentEventSplitIn with {
    briefly "Student events, fanned out to storage and read models"
  }
  connector 'EnrollmentAnalytics Feed' is from outlet StudentContext.StudentEventSplit.StudentEventSplitToEnrollmentAnalytics to inlet StudentContext.EnrollmentAnalytics.EnrollmentAnalyticsFromStudent with {
    briefly "Student events feeding the EnrollmentAnalytics projection"
  }
  connector 'EnrollmentAnalytics Storage' is from outlet StudentContext.EnrollmentAnalytics.EnrollmentAnalyticsToRepository to inlet StudentContext.StudentRepository.StudentRepositoryFromEnrollmentAnalytics with {
    briefly "EnrollmentAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for student information"
  described as {
    | The StudentContext is the bounded context for student
    | records, academic history, and administrative functions.
  }
}
