// Student Information - Student Context
context StudentContext is {
  include "types.riddl"
  include "Student.riddl"
  // Repository for student persistence
  repository StudentRepository is {
    inlet StudentRepositoryFromStudent is type StudentEvent
    inlet StudentRepositoryFromEnrollmentAnalytics is type StudentEvent
    outlet StudentRepositoryResponses is type Student.StudentResult
    schema StudentData is relational
      of students as type StudentContext.Student
        index on field StudentContext.Student.studentId
        index on field StudentContext.Student.info.lastName

    handler StudentPersistence is {
      on command Student.RegisterStudent is {
        prompt "Store new student record"
      }
      on command Student.UpdateStudentInfo is {
        tell event Student.StudentInfoUpdated to entity StudentContext.Student
        prompt "Update student info"
      }
      on command Student.EnrollInProgram is {
        prompt "Store program enrollment"
      }
      on command Student.RecordCourse is {
        tell event Student.CourseRecorded to entity StudentContext.Student
        prompt "Store course record"
      }
      on command Student.UpdateGrade is {
        tell event Student.GradeUpdated to entity StudentContext.Student
        prompt "Update grade record"
      }
      on command Student.PlaceHold is {
        tell event Student.HoldPlaced to entity StudentContext.Student
        prompt "Store hold record"
      }
      on command Student.ReleaseHold is {
        tell event Student.HoldReleased to entity StudentContext.Student
        prompt "Update hold status"
      }
      on command Student.Graduate is {
        prompt "Update graduation status"
      }
    } with {
      briefly "Persists student commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Student data persistence"
    described as {
      | The StudentRepository provides persistent storage for
      | student records, courses, and academic history.
    }
  }
  // Projector for enrollment analytics
  projector EnrollmentAnalytics is {
    inlet EnrollmentAnalyticsFromStudent is type StudentEvent
    outlet EnrollmentAnalyticsOut is type StudentEvent
    updates repository StudentContext.StudentRepository
    record EnrollmentStats is  {
      programId: ProgramId with {
        briefly "Program"
        described as {
          |Academic program.
        }
      }
      totalEnrolled: Natural with {
        briefly "Enrolled"
        described as {
          |Total enrolled.
        }
      }
      averageGpa: Decimal(4,2) with {
        briefly "Avg GPA"
        described as {
          |Average GPA.
        }
      }
      graduationRate: Decimal(5,2) with {
        briefly "Grad rate"
        described as {
          |Graduation rate.
        }
      }
      retentionRate: Decimal(5,2) with {
        briefly "Retention"
        described as {
          |Retention rate.
        }
      }
    } with {
      briefly "Enrollment statistics"
      described as {
        |Program enrollment metrics.
      }
    }
    handler AnalyticsHandler is {
      on event StudentContext.Student.StudentRegistered is {
        tell event StudentContext.Student.StudentRegistered to repository StudentContext.StudentRepository
        prompt "Update enrollment counts"
      }
      on event StudentContext.Student.ProgramEnrolled is {
        tell event StudentContext.Student.ProgramEnrolled to repository StudentContext.StudentRepository
        prompt "Update program metrics"
      }
      on event StudentContext.Student.GradeUpdated is {
        tell event StudentContext.Student.GradeUpdated to repository StudentContext.StudentRepository
        prompt "Update GPA metrics"
      }
      on event StudentContext.Student.StudentGraduated is {
        tell event StudentContext.Student.StudentGraduated to repository StudentContext.StudentRepository
        prompt "Update graduation metrics"
      }
      on event StudentContext.Student.StatusChanged is {
        tell event StudentContext.Student.StatusChanged to repository StudentContext.StudentRepository
        prompt "Update retention metrics"
      }
    } with {
      briefly "Maintains enrollment analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Enrollment analytics projections"
    described as {
      |Maintains enrollment analytics data.
    }
  }
  // ---- Event publication for Student ----
  type StudentEvent is one of {
    StudentContext.Student.StudentRegistered,
    StudentContext.Student.StudentInfoUpdated,
    StudentContext.Student.ProgramEnrolled,
    StudentContext.Student.StatusChanged,
    StudentContext.Student.CourseRecorded,
    StudentContext.Student.GradeUpdated,
    StudentContext.Student.HoldPlaced,
    StudentContext.Student.HoldReleased,
    StudentContext.Student.AdvisorAssigned,
    StudentContext.Student.AcademicStandingUpdated,
    StudentContext.Student.StudentGraduated
  } with {
    briefly "Student event alternation"
    described as {
      |Union of all Student events, for streaming and event-sourced
      |persistence.
    }
  }
  processor StudentEventSource as source is {
    outlet StudentEvents is type StudentEvent
    handler StudentSourceHandler is {
      on event Student.StudentRegistered is {
        send event Student.StudentRegistered to outlet StudentEvents
      }
      on event Student.StudentInfoUpdated is {
        send event Student.StudentInfoUpdated to outlet StudentEvents
      }
      on event Student.ProgramEnrolled is {
        send event Student.ProgramEnrolled to outlet StudentEvents
      }
      on event Student.StatusChanged is {
        send event Student.StatusChanged to outlet StudentEvents
      }
      on event Student.CourseRecorded is {
        send event Student.CourseRecorded to outlet StudentEvents
      }
      on event Student.GradeUpdated is {
        send event Student.GradeUpdated to outlet StudentEvents
      }
      on event Student.HoldPlaced is {
        send event Student.HoldPlaced to outlet StudentEvents
      }
      on event Student.HoldReleased is {
        send event Student.HoldReleased to outlet StudentEvents
      }
      on event Student.AdvisorAssigned is {
        send event Student.AdvisorAssigned to outlet StudentEvents
      }
      on event Student.AcademicStandingUpdated is {
        send event Student.AcademicStandingUpdated to outlet StudentEvents
      }
      on event Student.StudentGraduated is {
        send event Student.StudentGraduated to outlet StudentEvents
      }
      on other is {
        error "Unexpected message for source StudentEventSource"
      }
    } with {
      briefly "Student source handler"
      described as {
        |Publishes Student events onto the outlet.
      }
    }
  } with {
    briefly "Student event source"
    described as {
      |Publishes Student entity events into the streaming topology.
    }
  }
  processor StudentEventSink as sink is {
    inlet StudentInlet is type StudentEvent
    handler StudentSinkHandler is {
      on event Student.StudentRegistered is {
        tell event Student.StudentRegistered to repository StudentContext.StudentRepository
      }
      on event Student.StudentInfoUpdated is {
        tell event Student.StudentInfoUpdated to repository StudentContext.StudentRepository
      }
      on event Student.ProgramEnrolled is {
        tell event Student.ProgramEnrolled to repository StudentContext.StudentRepository
      }
      on event Student.StatusChanged is {
        tell event Student.StatusChanged to repository StudentContext.StudentRepository
      }
      on event Student.CourseRecorded is {
        tell event Student.CourseRecorded to repository StudentContext.StudentRepository
      }
      on event Student.GradeUpdated is {
        tell event Student.GradeUpdated to repository StudentContext.StudentRepository
      }
      on event Student.HoldPlaced is {
        tell event Student.HoldPlaced to repository StudentContext.StudentRepository
      }
      on event Student.HoldReleased is {
        tell event Student.HoldReleased to repository StudentContext.StudentRepository
      }
      on event Student.AdvisorAssigned is {
        tell event Student.AdvisorAssigned to repository StudentContext.StudentRepository
      }
      on event Student.AcademicStandingUpdated is {
        tell event Student.AcademicStandingUpdated to repository StudentContext.StudentRepository
      }
      on event Student.StudentGraduated is {
        tell event Student.StudentGraduated to repository StudentContext.StudentRepository
      }
      on other is {
        error "Unexpected message for sink StudentEventSink"
      }
    } with {
      briefly "Student sink handler"
      described as {
        |Persists Student events via the repository.
      }
    }
  } with {
    briefly "Student event sink"
    described as {
      |Receives Student events for persistence.
    }
  }
  connector StudentEventFlow is {
    from outlet StudentContext.StudentEventSource.StudentEvents to
      inlet StudentContext.StudentEventSink.StudentInlet
  } with {
    briefly "Student event flow"
    described as {
      |Connects the Student source to its sink.
    }
  }
  processor StudentEventSplit is {
    inlet StudentEventSplitIn is type StudentEvent
    outlet StudentEventSplitToStudentRepository is type StudentEvent
    outlet StudentEventSplitToEnrollmentAnalytics is type StudentEvent
    handler StudentEventSplitHandler is {
      on event Student.StudentRegistered is {
        send event Student.StudentRegistered to outlet StudentEventSplitToStudentRepository
        send event Student.StudentRegistered to outlet StudentEventSplitToEnrollmentAnalytics
        tell event Student.StudentRegistered to entity StudentContext.Student
      }
      on event Student.StudentInfoUpdated is {
        send event Student.StudentInfoUpdated to outlet StudentEventSplitToStudentRepository
        send event Student.StudentInfoUpdated to outlet StudentEventSplitToEnrollmentAnalytics
        tell event Student.StudentInfoUpdated to entity StudentContext.Student
      }
      on event Student.ProgramEnrolled is {
        send event Student.ProgramEnrolled to outlet StudentEventSplitToStudentRepository
        send event Student.ProgramEnrolled to outlet StudentEventSplitToEnrollmentAnalytics
        tell event Student.ProgramEnrolled to entity StudentContext.Student
      }
      on event Student.StatusChanged is {
        send event Student.StatusChanged to outlet StudentEventSplitToStudentRepository
        send event Student.StatusChanged to outlet StudentEventSplitToEnrollmentAnalytics
        tell event Student.StatusChanged to entity StudentContext.Student
      }
      on event Student.CourseRecorded is {
        send event Student.CourseRecorded to outlet StudentEventSplitToStudentRepository
        send event Student.CourseRecorded to outlet StudentEventSplitToEnrollmentAnalytics
        tell event Student.CourseRecorded to entity StudentContext.Student
      }
      on event Student.GradeUpdated is {
        send event Student.GradeUpdated to outlet StudentEventSplitToStudentRepository
        send event Student.GradeUpdated to outlet StudentEventSplitToEnrollmentAnalytics
        tell event Student.GradeUpdated to entity StudentContext.Student
      }
      on event Student.HoldPlaced is {
        send event Student.HoldPlaced to outlet StudentEventSplitToStudentRepository
        send event Student.HoldPlaced to outlet StudentEventSplitToEnrollmentAnalytics
        tell event Student.HoldPlaced to entity StudentContext.Student
      }
      on event Student.HoldReleased is {
        send event Student.HoldReleased to outlet StudentEventSplitToStudentRepository
        send event Student.HoldReleased to outlet StudentEventSplitToEnrollmentAnalytics
        tell event Student.HoldReleased to entity StudentContext.Student
      }
      on event Student.AdvisorAssigned is {
        send event Student.AdvisorAssigned to outlet StudentEventSplitToStudentRepository
        send event Student.AdvisorAssigned to outlet StudentEventSplitToEnrollmentAnalytics
        tell event Student.AdvisorAssigned to entity StudentContext.Student
      }
      on event Student.AcademicStandingUpdated is {
        send event Student.AcademicStandingUpdated to outlet StudentEventSplitToStudentRepository
        send event Student.AcademicStandingUpdated to outlet StudentEventSplitToEnrollmentAnalytics
        tell event Student.AcademicStandingUpdated to entity StudentContext.Student
      }
      on event Student.StudentGraduated is {
        send event Student.StudentGraduated to outlet StudentEventSplitToStudentRepository
        send event Student.StudentGraduated to outlet StudentEventSplitToEnrollmentAnalytics
        tell event Student.StudentGraduated to entity StudentContext.Student
      }
      on other is {
        error "Unexpected message for processor StudentEventSplit"
      }
    } with {
      briefly "Student event fan-out handler"
      described as {
        |Delivers each Student event to all of its consumers.
      }
    }
  } with {
    briefly "Student event fan-out"
    described as {
      |Fans Student events out to the repository and projectors.
    }
  }
  connector LinkStudentToStudentEventSplit is {
    from outlet StudentContext.Student.StudentEvents2 to
      inlet StudentContext.StudentEventSplit.StudentEventSplitIn
  } with {
    briefly "LinkStudentToStudentEventSplit"
  }
  connector LinkStudentEventSplitToStudentRepository is {
    from outlet StudentContext.StudentEventSplit.StudentEventSplitToStudentRepository to
      inlet StudentContext.StudentRepository.StudentRepositoryFromStudent
  } with {
    briefly "LinkStudentEventSplitToStudentRepository"
  }
  connector LinkStudentEventSplitToEnrollmentAnalytics is {
    from outlet StudentContext.StudentEventSplit.StudentEventSplitToEnrollmentAnalytics to
      inlet StudentContext.EnrollmentAnalytics.EnrollmentAnalyticsFromStudent
  } with {
    briefly "LinkStudentEventSplitToEnrollmentAnalytics"
  }
  connector LinkEnrollmentAnalyticsToStudentRepository is {
    from outlet StudentContext.EnrollmentAnalytics.EnrollmentAnalyticsOut to
      inlet StudentContext.StudentRepository.StudentRepositoryFromEnrollmentAnalytics
  } with {
    briefly "LinkEnrollmentAnalyticsToStudentRepository"
  }
} with {
  briefly "Bounded context for student information"
  described as {
    | The StudentContext is the bounded context for student
    | records, academic history, and administrative functions.
  }
}
