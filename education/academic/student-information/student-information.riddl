// Student Information System Domain Model
// Student records, academic history, and administrative functions
domain StudentInformation is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Registrar is "staff managing student records" with {
    briefly "Registrar"
    described as {
      |Staff responsible for student administration.
    }
  }
  user Advisor is "academic advisor guiding students" with {
    briefly "Advisor"
    described as {
      |Faculty member advising students.
    }
  }
  user StudentUser is "student accessing their records" with {
    briefly "Student User"
    described as {
      |Person enrolled in academic programs.
    }
  }
  epic StudentRegistrationEpic is {
    user Student wants to "to register and maintain their academic records" so that "they can pursue their educational goals"
    case RegisterNewStudent is {
      user Registrar wants to "to register a new student" so that "they can begin their academic program"
      step is "Registrar receives" "student application materials" "for processing" with {
        briefly "Receive application"
        described as {
          |Application arrives.
        }
      }
      step is "Registrar verifies" "identity and credentials" "against requirements" with {
        briefly "Verify credentials"
        described as {
          |Check documents.
        }
      }
      step take input StudentInformationApp.StudentInformationScreen.RegisterStudentInput from user Registrar with {
        briefly "Register"
        described as {
          |Create student record.
        }
      }
      step is "System creates student" "record and assigns" "student ID" with {
        briefly "Create record"
        described as {
          |System creates student.
        }
      }
    } with {
      briefly "Student registration workflow"
      described as {
        |Standard flow for new student registration.
      }
    }
  } with {
    briefly "Student registration processing"
    described as {
      | Epic covering student registration from application
      | through record creation and program enrollment.
    }
  }
  include "StudentContext.riddl"
  include "external-contexts.riddl"
  application context StudentInformationApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in StudentInformation are delivered.
      }
    }
    group StudentInformationScreen is {
      input RegisterStudentInput acquires command StudentContext.Student.RegisterStudent with {
        briefly "Register student control"
        described as {
          |The control through which a user submits the register student request.
        }
      }
    } with {
      briefly "Student information screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppStudentCommands is type StudentContext.Student.StudentCommand
    inlet AppStudentRepositoryResponses is result StudentContext.Student.StudentResult    handler StudentInformationAppHandler is {
      on other is {
        error "Unexpected message for application context StudentInformationApp"
      }
    } with {
      briefly "StudentInformationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "StudentInformationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'StudentCommand Stream' is from outlet StudentInformationApp.AppStudentCommands to inlet StudentContext.StudentCommandStreamIn with {
    briefly "Student commands from the application"
  }
  persistent connector 'StudentResult Stream' is from outlet StudentContext.StudentResultStreamOut to inlet StudentInformationApp.AppStudentRepositoryResponses with {
    briefly "Student query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet StudentInformationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Student information domain"
  described as {
    | The StudentInformation domain handles student records,
    | academic history, and administrative functions.
  }
}
