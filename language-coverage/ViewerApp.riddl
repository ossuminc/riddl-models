// The viewer application.
// Its group is where `shown by` (body) and `figma` (metadata) are
// exercised, and its context metadata carries `described at`.
application context SurveyViewer as flow is {
  outlet AppStationCommands is type Cartography.SurveyStation.StationCommand
  inlet AppStationResponses is type Cartography.SurveyStation.StationResult  command ShowStationUnderReview is  {
    reviewedStationId: Cartography.StationId with {
      briefly "Station to display"
      described as {
        |Which station the surveyor has opened for review.
      }
    }
  } with {
    briefly "Show a station"
    described as {
      |Put a station on screen so its readings can be reviewed.
    }
  }
  group MapPanel is {
    shown by { https://ossum.tech/mockups/survey-map }
    input StationSelector acquires command SurveyViewer.ShowStationUnderReview with {
      briefly "Station selector"
      described as {
        |Where a surveyor picks the station to review.
      }
    }
    input RecordReadingInput acquires command Cartography.SurveyStation.RecordReading with {
      briefly "Reading entry control"
      described as {
        |Where a surveyor enters a reading taken in the field.
      }
    }
    output StationSummaryView presents result Cartography.SurveyStation.StationResult with {
      briefly "Station summary display"
      described as {
        |Shows what a station's readings add up to, including the values
        |the summary computes rather than stores.
      }
    }
  } with {
    briefly "Map panel"
    figma "SurveyViewerMockups" node "12:340"
    described as {
      |The one screen this application has: pick a station, enter a
      |reading, read the summary back.
    }
  }
} with {
  briefly "Survey viewer application"
  described at https://ossum.tech/docs/riddl
}
