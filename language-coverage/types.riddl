// Type expressions a restaurant cannot justify.
// Each one here exists because the corpus otherwise never reaches it.
type StationId is Id(Cartography.SurveyStation)  with {
  briefly "Survey station identifier"
  described as {
    |Identifies one survey station, the fixed installation that takes
    |readings for a patch of terrain.
  }
}
type RegionCode is String(2,8) with {
  briefly "Survey region code"
  described as {
    |The map sheet a station reports under. Regions are the unit the
    |national grid publishes on, so tallies roll up by region rather than
    |by station.
  }
}
type SpeciesCode is String(3,12) with {
  briefly "Species code"
  described as {
    |A code from the national species register, recorded when a survey
    |sights something living rather than measuring the ground.
  }
}
type Elevation is Decimal(9,2) with {
  briefly "Elevation in metres"
  described as {
    |Height above the vertical datum, in metres to two places. Two places
    |because the instruments resolve to a centimetre and claiming more
    |would be false precision.
  }
}
type SurveyNetwork is graph of StationId with {
  briefly "The sightline network between stations"
  described as {
    |Which stations can see which others. A graph rather than a list
    |because sightlines are pairwise and a station's usefulness depends on
    |what it connects to, not on where it sits in an ordering.
  }
}
type ElevationTile is table of Elevation of [ 256, 256 ] with {
  briefly "A 256 by 256 raster of elevations"
  described as {
    |One tile of the elevation raster: a fixed 256 by 256 grid of heights
    |covering a square of ground. A table rather than a sequence because
    |the two indices are northing and easting, and flattening them would
    |lose which is which.
  }
}
type SampleTally is replica of Natural with {
  briefly "Sample count, replicated across field devices"
  described as {
    |How many readings a station has taken. A replica because field
    |devices tally readings while out of contact and reconcile on return,
    |so the count must merge without a central arbiter.
  }
}
type RegionTally is replica of mapping from RegionCode to Natural with {
  briefly "Per-region sample counts, replicated"
  described as {
    |The same tally broken down by region. Replicated for the same reason
    |and merged the same way, one counter per region rather than one
    |overall.
  }
}
type ObservedSpecies is replica of set of SpeciesCode with {
  briefly "Species sighted, replicated"
  described as {
    |Which species a station has recorded sighting. A set because a second
    |sighting of the same species adds nothing, and replicated because two
    |devices may sight different things before they reconcile.
  }
}
record SurveySummary is  {
  sampleTotal: Natural with {
    briefly "Total readings taken"
    described as {
      |Every reading this station has contributed, after the replicated
      |tallies have merged.
    }
  }
  highestElevation: Elevation with {
    briefly "Highest reading"
    described as {
      |The greatest elevation this station has measured, kept because the
      |summit of a sheet is what the published map is checked against.
    }
  }
  sampleCount(): Natural with {
    briefly "Readings taken, computed"
    described as {
      |The reading count derived from the station's own tallies rather than
      |read from a stored field, so a summary cannot disagree with the
      |tallies it was built from.
    }
  }
  meanElevation(precision: Natural): Elevation with {
    briefly "Mean elevation to a given precision"
    described as {
      |The average of this station's readings, rounded to the requested
      |number of decimal places. Precision is an argument because a field
      |check and a published sheet want different roundings of the same
      |underlying data.
    }
  }
} with {
  briefly "Derived view of a station's readings"
  described as {
    |What a station's readings add up to. It carries both stored fields and
    |methods that compute from the station's tallies, which is the
    |distinction this record exists to show.
  }
}
