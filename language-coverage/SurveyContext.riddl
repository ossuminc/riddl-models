// The survey bounded context.
// Its metadata block is where the three `attachment` forms and the
// `described in file` description form are exercised.
context Cartography as router is {
  command CommissionStation yields event SurveyStation.StationCommissioned is {
    regionCode: RegionCode with {
      briefly "Region the station reports under"
      described as {
        |The map sheet this station's readings roll up into.
      }
    }
  } with {
    briefly "Commission a survey station"
    described as {
      |Bring a newly installed station into service so it may take
      |readings.
    }
  }
  type SurveyStationRequest is one of {
    Cartography.CommissionStation or SurveyStation.StationCommand
  } with {
    briefly "SurveyStation requests"
    described as {
      |What may be asked of Cartography about a SurveyStation: CommissionStation, which the
      |context does itself by creating one, or any command for an existing one.
    }
  }
  inlet SurveyStationQueriesIn is query SurveyStation.GetSurveyStation with {
    briefly "Look-ups of the survey station"
    described as {
      |SurveyViewer's look-ups, on their way to the survey station.
    }
  }
  outlet SurveyStationQueriesOut is query SurveyStation.GetSurveyStation
 with {
    briefly "Look-ups on their way to the survey station"
    described as {
      |Each look-up goes to the survey station it names.
    }
  }
  inlet SurveyStationRepliesIn is result SurveyStation.StationResult with {
    briefly "The survey station's answers"
    described as {
      |What the survey station answers about itself.
    }
  }
  inlet StationRepositoryQueriesIn is query SurveyStation.GetStation with {
    briefly "Look-ups of the station repository"
    described as {
      |SurveyViewer's look-ups, on their way to the station repository.
    }
  }
  outlet StationRepositoryQueriesOut is query SurveyStation.GetStation
 with {
    briefly "Look-ups on their way to the station repository"
    described as {
      |Each look-up goes to the station repository it names.
    }
  }
  inlet StationCommandStreamIn is type Cartography.SurveyStationRequest
  outlet StationCommandStreamOut is type StationCommand
  inlet StationResultStreamIn is result SurveyStation.StationResult
  outlet StationResultStreamOut is result SurveyStation.StationResult
  inlet ResurveyRequestsIn is command ScheduleResurvey
  outlet ResurveyDue is command ScheduleResurvey
  handler CartographyBoundary is {
    on getSurveyStation: query SurveyStation.GetSurveyStation is {
      forward getSurveyStation to outlet Cartography.SurveyStationQueriesOut
    }
    on getStation: query SurveyStation.GetStation is {
      forward getStation to outlet Cartography.StationRepositoryQueriesOut
    }
    on commissionStation: command CommissionStation is {
      let newSurveyStation = create entity Cartography.SurveyStation(regionCode = commissionStation.regionCode)
      yield event SurveyStation.StationCommissioned(stationId = newSurveyStation, regionCode = commissionStation.regionCode)
    }
    on recordReading: command RecordReading is {
      forward recordReading to outlet Cartography.StationCommandStreamOut
    }
    on retireStation: command RetireStation is {
      forward retireStation to outlet Cartography.StationCommandStreamOut
    }
    on stationResult: result SurveyStation.StationResult is {
      send stationResult to outlet Cartography.StationResultStreamOut
    }
    on scheduleResurvey: command ScheduleResurvey is {
      send command ScheduleResurvey(stationId = scheduleResurvey.stationId, resurveyAt = scheduleResurvey.resurveyAt) to outlet Cartography.ResurveyDue at scheduleResurvey.resurveyAt
    }
    on other is {
      error "Unexpected message at the Cartography boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'SurveyStationQuery Intake' is from outlet Cartography.SurveyStationQueriesOut to inlet Cartography.SurveyStation.SurveyStationQueries with {
    briefly "Look-ups on their way to the survey station"
  }
  connector 'SurveyStationReply Egress' is from outlet Cartography.SurveyStation.SurveyStationReplies to inlet Cartography.SurveyStationRepliesIn with {
    briefly "The survey station's answers on their way to the boundary"
  }
  connector 'StationRepositoryQuery Intake' is from outlet Cartography.StationRepositoryQueriesOut to inlet Cartography.StationRepository.StationRepositoryQueries with {
    briefly "Look-ups on their way to the station repository"
  }
  connector 'StationCommand Stream Intake' is from outlet Cartography.StationCommandStreamOut to inlet Cartography.SurveyStation.StationCommands
  connector 'StationResult Stream Egress' is from outlet Cartography.StationRepository.StationRepositoryResponses to inlet Cartography.StationResultStreamIn
  include "types.riddl"
  include "SurveyStation.riddl"
  repository StationRepository as merge is {
    inlet StationRepositoryQueries is query SurveyStation.GetStation with {
      briefly "Look-ups of this station repository"
      described as {
        |What SurveyViewer asks of the station repository, by way of Cartography.
      }
    }
    inlet StationRepositoryFromStationEventLog is type Cartography.StationLogCommand
    inlet StationRepositoryResurveySchedule is command ScheduleResurvey
    outlet StationRepositoryResponses is result SurveyStation.StationResult
    record StoredStation is {
      stationId: StationId with {
        briefly "stationId"
        described as {
          |The stationId column of the stored station row.
        }
      }
      regionCode: RegionCode with {
        briefly "regionCode"
        described as {
          |The regionCode column of the stored station row.
        }
      }
    } with {
      briefly "Stored station row"
      described as {
        |The persistence shape of station data as this repository stores
        |it.
      }
    }
    schema StationData is relational
      of stations as record StoredStation
        key on field StoredStation.stationId
        index on field StoredStation.regionCode
 with {
      briefly "Station data schema"
      described as {
        |Relational schema for persisting station rows, indexed by station
        |and by the region a station reports under.
      }
    }
    command PersistStationCommissioned is {
      stationId: StationId with {
        briefly "ID"
        described as {
          |The stored row to write.
        }
      }
    } with {
      briefly "Persist StationCommissioned"
      described as {
        |Instructs this repository to apply StationCommissioned to the
        |stored row. A persistence command, not a domain command: it
        |declares no `yields` because storing a row records no new entity
        |state.
      }
    }
    command PersistStationRetired is {
      stationId: StationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist StationRetired"
      described as {
        |Instructs this repository to apply StationRetired to the stored
        |row. A persistence command, not a domain command: it declares no
        |`yields` because storing a row records no new entity state.
      }
    }
    handler StationPersistence is {
      on persistStationCommissioned: command PersistStationCommissioned is {
        store record StoredStation(stationId = persistStationCommissioned.stationId, regionCode = prompt("the regionCode of this row")) in StationData.stations
      }
      on command PersistStationRetired is {
        do "delete the row from StationData.stations where stationId
          matches, because a retired station is published from the
          archive rather than the live sheet"
      }
      on query SurveyStation.GetStation is {
        let stationResult: type SurveyStation.StationResult = prompt("look up the stored station row by GetStation.queriedStationId")
        reply stationResult
      }
      on command LogStationEvent is {
        do "append the station event to the Cartography event log"
      }
      on command ScheduleResurvey is {
        do "record that the station is due for resurvey, so the revisit
          stands in the schedule rather than only in the delivery that
          woke it"
      }
    } with {
      briefly "Station persistence"
      described as {
        |Writes station rows and answers the station summary query.
      }
    }
  } with {
    briefly "Station repository"
    described as {
      |Stores station rows and answers queries about them.
    }
  }
  // ---- Resurvey scheduling ----
  // The `send ... at` construct needs a message carrying an instant, and
  // this is the one honest reason a survey has for holding one.
  command ScheduleResurvey is {
    stationId: StationId with {
      briefly "Station to revisit"
      described as {
        |The station whose patch of ground is to be surveyed again.
      }
    }
    resurveyAt: TimeStamp with {
      briefly "When the revisit falls due"
      described as {
        |The instant the resurvey becomes due. An instant rather than a
        |date because the grid publishes revisit windows to the minute and
        |a station on a tidal flat is only reachable inside one.
      }
    }
  } with {
    briefly "Schedule a resurvey"
    described as {
      |Ask that a station be revisited at a stated instant. The request is
      |made now and delivered then, which is why it carries the instant
      |rather than being issued when the instant arrives.
    }
  }
  // ---- Local event log for station events ----
  command LogStationEvent is {
    loggedStationId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the station the logged event concerns.
      }
    }
    loggedStationEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |The event's name, recorded as text because the log keeps every
        |kind of station event in one place and must not bind to any
        |single event's shape.
      }
    }
  } with {
    briefly "Log station event"
    described as {
      |Append a published station event to this context's event log.
    }
  }
  type StationLogCommand is one of {
    LogStationEvent or StationRepository.PersistStationCommissioned or StationRepository.PersistStationRetired
  } with {
    briefly "What the station event log writes"
    described as {
      |Every station event is logged; commissioning and retirement also
      |write the live station row the GetStation look-up reads.
    }
  }
  streamlet StationEventLog as flow is {
    inlet IncomingStationLog is type SurveyStation.StationEvent
    outlet StationEventLogToRepository is type Cartography.StationLogCommand
    handler StationLogIntake is {
      on stationCommissioned: event SurveyStation.StationCommissioned is {
        send command StationRepository.PersistStationCommissioned(stationId = stationCommissioned.stationId) to outlet Cartography.StationEventLog.StationEventLogToRepository
        let logStationEvent: type LogStationEvent = prompt("the log entry for this commissioning")
        send logStationEvent to outlet Cartography.StationEventLog.StationEventLogToRepository
      }
      on stationRetired: event SurveyStation.StationRetired is {
        send command StationRepository.PersistStationRetired(stationId = stationRetired.stationId) to outlet Cartography.StationEventLog.StationEventLogToRepository
        let logStationEvent: type LogStationEvent = prompt("the log entry for this retirement")
        send logStationEvent to outlet Cartography.StationEventLog.StationEventLogToRepository
      }
      on other is {
        let logStationEvent: type LogStationEvent = prompt("the log station event to issue for this this")
        send logStationEvent to outlet Cartography.StationEventLog.StationEventLogToRepository
        do "append the station event to the context event log"
      }
    } with {
      briefly "Station log intake"
      described as {
        |Routes every published station event into the context's own
        |durable event log.
      }
    }
  } with {
    briefly "Station event log"
    described as {
      |Durable local log of the station events this context publishes.
    }
  }
  connector 'StationEventLog Storage' is from outlet Cartography.StationEventLog.StationEventLogToRepository to inlet Cartography.StationRepository.StationRepositoryFromStationEventLog with {
    briefly "Logged station events on their way to storage"
  }
  connector 'ScheduleResurvey Storage' is from outlet Cartography.ResurveyDue to inlet Cartography.StationRepository.StationRepositoryResurveySchedule with {
    briefly "Due resurvey requests on their way to storage"
    described as {
      |Carries a resurvey request from the boundary to the ledger. The
      |boundary publishes it at the instant the request named, so what
      |arrives here is a revisit that has fallen due, not one being asked
      |for.
    }
  }
  connector StationToLog is from outlet Cartography.SurveyStation.StationEvents to inlet Cartography.StationEventLog.IncomingStationLog with {
    briefly "Station events to the context log"
    described as {
      |Wires published station events into the context's event log.
    }
  }
} with {
  briefly "Terrain survey context"
  described in file "survey-protocol.md"
  attachment ULID is "01ARZ3NDEKTSV4RRFFQ69G5FAV"
  attachment SurveyProtocol is text/markdown in file "survey-protocol.md"
  attachment DatumNote is text/plain as "All elevations are relative to the national vertical datum, not to sea level."
}
