// The one entity in the coverage model. It exists to give the exotic type
// expressions somewhere real to live, and to carry a second state so the
// `morph` here has somewhere to go.
aggregate event-sourced entity SurveyStation as flow is {
  inlet StationCommands is type StationCommand  outlet StationEvents is type StationEvent
  // ---- Commands ----
  command CommissionStation yields event StationCommissioned is  {
    stationId: StationId with {
      briefly "Station being commissioned"
      described as {
        |Identifier assigned to the new station when the crew installs it.
      }
    }
    regionCode: RegionCode with {
      briefly "Region the station reports under"
      described as {
        |The map sheet this station's readings roll up into.
      }
    }
  } with {
    briefly "Commission a survey station"
    described as {
      |Bring a newly installed station into service so it may take
      |readings.
    }
  }
  command RecordReading yields event ReadingRecorded is  {
    stationId: StationId with {
      briefly "Station reporting"
      described as {
        |The station that took this reading.
      }
    }
    readingElevation: Elevation with {
      briefly "Elevation measured"
      described as {
        |The height the instrument resolved for this reading.
      }
    }
    sightedSpecies: SpeciesCode? with {
      briefly "Species sighted, if any"
      described as {
        |Recorded only when the crew sights something living during the
        |reading, which is why it is optional rather than a second command.
      }
    }
  } with {
    briefly "Record one survey reading"
    described as {
      |Add a single instrument reading to the station's tallies.
    }
  }
  command RetireStation yields event StationRetired is  {
    stationId: StationId with {
      briefly "Station being retired"
      described as {
        |The station leaving service.
      }
    }
    retirementReason: String(1,200) with {
      briefly "Why it is being retired"
      described as {
        |Why the station is leaving service, kept because a station retired
        |for damage is reinstated differently from one the grid no longer
        |needs.
      }
    }
  } with {
    briefly "Retire a survey station"
    described as {
      |Take a station out of service. Its readings remain published; only
      |new ones stop.
    }
  }
  // ---- Query and result ----
  query GetStation replies result StationResult is  {
    queriedStationId: StationId with {
      briefly "Station being asked about"
      described as {
        |Which station the caller wants the summary of.
      }
    }
  } with {
    briefly "Ask for a station's summary"
    described as {
      |Read a station's current summary without changing it.
    }
  }
  result StationResult is  {
    stationId: StationId with {
      briefly "Station answered about"
      described as {
        |The station this answer concerns.
      }
    }
    stationSummary: SurveySummary with {
      briefly "The station's summary"
      described as {
        |What the station's readings add up to, including the computed
        |values rather than only the stored ones.
      }
    }
  } with {
    briefly "A station summary answer"
    described as {
      |The answer to GetStation.
    }
  }
  // ---- Events ----
  event StationCommissioned is  {
    stationId: StationId with {
      briefly "Station commissioned"
      described as {
        |The station now in service.
      }
    }
    regionCode: RegionCode with {
      briefly "Region it reports under"
      described as {
        |The map sheet it was commissioned into.
      }
    }
  } with {
    briefly "A station entered service"
    described as {
      |Recorded when a station is commissioned.
    }
  }
  event ReadingRecorded is  {
    stationId: StationId with {
      briefly "Station that reported"
      described as {
        |The station whose tallies moved.
      }
    }
    readingElevation: Elevation with {
      briefly "Elevation measured"
      described as {
        |The height recorded by this reading.
      }
    }
  } with {
    briefly "A reading was recorded"
    described as {
      |Recorded when a station adds a reading to its tallies.
    }
  }
  event StationRetired is  {
    stationId: StationId with {
      briefly "Station retired"
      described as {
        |The station that left service.
      }
    }
    retirementReason: String(1,200) with {
      briefly "Why it was retired"
      described as {
        |Why it left service.
      }
    }
  } with {
    briefly "A station left service"
    described as {
      |Recorded when a station is retired.
    }
  }
  // ---- Alternations carried by the ports ----
  type StationCommand is one of {
    CommissionStation or RecordReading or RetireStation
  } with {
    briefly "Every command this entity accepts"
    described as {
      |What arrives on the station's command inlet.
    }
  }
  type StationEvent is one of {
    StationCommissioned or ReadingRecorded or StationRetired
  } with {
    briefly "Every event this entity publishes"
    described as {
      |What leaves on the station's event outlet.
    }
  }
  // ---- State records ----
  record CommissionedData is  {
    stationId: StationId with {
      briefly "This station"
      described as {
        |Identifier of the station in service.
      }
    }
    regionCode: RegionCode with {
      briefly "Region reported under"
      described as {
        |The map sheet the station's readings roll up into.
      }
    }
    sightlines: SurveyNetwork with {
      briefly "Stations within sight"
      described as {
        |The sightline network this station participates in.
      }
    }
    elevationTile: ElevationTile with {
      briefly "The raster this station fills"
      described as {
        |The 256 by 256 patch of ground this station's readings populate.
      }
    }
    sampleTally: SampleTally with {
      briefly "Readings taken"
      described as {
        |The replicated count of readings, merged from every field device
        |that has reported.
      }
    }
    regionTally: RegionTally with {
      briefly "Readings taken per region"
      described as {
        |The same count broken down by map sheet.
      }
    }
    observedSpecies: ObservedSpecies with {
      briefly "Species sighted here"
      described as {
        |Everything sighted at this station, merged across devices.
      }
    }
    stationSummary: SurveySummary with {
      briefly "What the readings add up to"
      described as {
        |The derived view, carrying both stored fields and computed
        |methods.
      }
    }
  } with {
    briefly "A commissioned station's state"
    described as {
      |Everything a station in service holds.
    }
  }
  record RetiredData is  {
    stationId: StationId with {
      briefly "This station"
      described as {
        |Identifier of the retired station.
      }
    }
    retirementReason: String(1,200) with {
      briefly "Why it was retired"
      described as {
        |Why it left service, kept so reinstatement can be judged.
      }
    }
    finalSummary: SurveySummary with {
      briefly "Summary at retirement"
      described as {
        |What the station's readings added up to when it left service.
        |Frozen: a retired station takes no further readings.
      }
    }
  } with {
    briefly "A retired station's state"
    described as {
      |What remains of a station after it leaves service.
    }
  }
  // ---- States ----
  initial state Commissioned of record SurveyStation.CommissionedData is {
    initial handler CommissionedHandler is {
      on init is {
        let stationCommissioned: type StationCommissioned = prompt("the station commissioned that brings this survey station into existence")
        yield stationCommissioned
      }
      on commissionStation: command CommissionStation is {
        yield event StationCommissioned(stationId = commissionStation.stationId, regionCode = commissionStation.regionCode)
        send event StationCommissioned(stationId = commissionStation.stationId, regionCode = commissionStation.regionCode) to outlet Cartography.SurveyStation.StationEvents
      }
      on recordReading: command RecordReading is {
        yield event ReadingRecorded(stationId = recordReading.stationId, readingElevation = recordReading.readingElevation)
        send event ReadingRecorded(stationId = recordReading.stationId, readingElevation = recordReading.readingElevation) to outlet Cartography.SurveyStation.StationEvents
      }
      on retireStation: command RetireStation is {
        yield event StationRetired(stationId = retireStation.stationId, retirementReason = retireStation.retirementReason)
        send event StationRetired(stationId = retireStation.stationId, retirementReason = retireStation.retirementReason) to outlet Cartography.SurveyStation.StationEvents
      }
      on event StationCommissioned is {
        set state SurveyStation.Commissioned to "stationId, regionCode,
          sightlines = empty, elevationTile = empty,
          sampleTally = 0, regionTally = empty,
          observedSpecies = empty,
          stationSummary = empty"
      }
      on event ReadingRecorded is {
        set field CommissionedData.sampleTally to "the merged tally, one higher for this device"
        set field CommissionedData.elevationTile to "the tile with this reading placed at its northing and easting"
      }
      on stationRetired: event StationRetired is {
        morph entity Cartography.SurveyStation to state Cartography.SurveyStation.Retired with record SurveyStation.RetiredData(stationId = stationRetired.stationId, retirementReason = stationRetired.retirementReason)
      }
    } with {
      briefly "Commissioned station handler"
      described as {
        |Handles a station in service: readings accumulate and retirement
        |moves it to its final state.
      }
    }
  } with {
    briefly "In service"
    described as {
      |The station is installed, commissioned and taking readings.
    }
  }
  state Retired of record SurveyStation.RetiredData is {
    initial handler RetiredHandler is {
      on other is {
        error "A retired station takes no further readings"
      }
    } with {
      briefly "Retired station handler"
      described as {
        |Refuses everything. A retired station is kept for its published
        |readings, not to accept new ones.
      }
    }
  } with {
    briefly "Out of service"
    described as {
      |The station has been retired. Its readings stand; it takes no more.
    }
  }
} with {
  briefly "A survey station"
  described as {
    |One installation taking elevation readings for a patch of terrain. It
    |is the only entity here, and it exists so the replicated tallies, the
    |sightline graph and the elevation raster have a place they are
    |actually used rather than merely declared.
  }
}
