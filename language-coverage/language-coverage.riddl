// A module wrapper, which is what `nebula` was deprecated in favour of.
// This is the only place in the corpus that uses one.
module LanguageCoverage is {
  domain TerrainSurvey is {
    author OssumInc is {
      name = "Ossum Inc."
      email = "info@ossuminc.com"
    } with {
      briefly "Author of this model"
      described as {
        |Ossum Inc., creators of RIDDL.
      }
    }
    version 1 with {
      briefly "Version of the coverage model"
      described as {
        |Bumped when the set of constructs this model covers changes, so a
        |consumer can tell whether the coverage it read still holds.
      }
    }
    include "SurveyContext.riddl"
    include "ViewerApp.riddl"
    // The domain's own error destination, as every domain here has.
    context SurveyOperations as sink is {
      inlet ErrorSink is record Riddl.GeneratorError with {
        option error-sink()
        briefly "Hard error destination"
        described as {
          |Where hard errors raised in this domain are delivered.
        }
      }
    } with {
      briefly "Domain-wide operational concerns"
      described as {
        |The survey as a whole, above any one context.
      }
    }
    connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet SurveyOperations.ErrorSink with {
      briefly "Hard errors to the domain error sink"
      described as {
        |No modelled component emits a GeneratorError; generators do, at
        |run time. ForeverEmpty states that honestly rather than inventing
        |a producer.
      }
    }
    persistent connector 'StationCommand Stream' is from outlet SurveyViewer.AppStationCommands to inlet Cartography.StationCommandStreamIn with {
      briefly "Commands from the viewer to the station"
      described as {
        |Carries what a surveyor asks for to the entity that decides it.
      }
    }
    persistent connector 'StationResult Stream' is from outlet Cartography.StationResultStreamOut to inlet SurveyViewer.AppStationResponses with {
      briefly "Station summaries back to the viewer"
      described as {
        |Carries the repository's answers back to the screen that asked.
      }
    }
  } with {
    briefly "Terrain survey"
    described as {
      |A deliberately synthetic domain. It models a national terrain
      |survey only as far as is needed to give the RIDDL constructs a
      |restaurant cannot justify somewhere honest to live: a sightline
      |graph, an elevation raster, replicated field tallies, computed
      |summary methods, attached specification documents, and descriptions
      |that live outside the model.
      |
      |It is a companion to reactive-bbq, not a competitor to it. Read
      |reactive-bbq for how to model a business; read this for the
      |constructs that model does not reach.
    }
  }
} with {
  briefly "Language coverage module"
  described as {
    |Wraps the coverage domain in a `module`, which is both the root
    |construct being covered and the canonical replacement for the
    |deprecated anonymous `nebula`.
  }
}
