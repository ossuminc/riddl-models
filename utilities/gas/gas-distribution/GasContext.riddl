// Gas Distribution - Gas Context
context GasContext is {
  adaptor FromCustomerNotification from context CustomerNotification is { 
    handler FromCustomerNotificationHandler is {
      on event CustomerNotification.AlertSent is {
        do "the model receives alert sent"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerNotification"
      }
    } with {
      briefly "from customer notification"
      described as {
        |Carries messages from the external CustomerNotification.
      }
    }
  } with {
    briefly "CustomerNotification integration"
    described as {
      |The model's side of the CustomerNotification conversation.
    }
  }
  adaptor ToCustomerNotification to context CustomerNotification is { 
    handler ToCustomerNotificationHandler is {
      on command CustomerNotification.SendServiceAlert is {
        do "the model sends send service alert"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerNotification"
      }
    } with {
      briefly "to customer notification"
      described as {
        |Carries messages to the external CustomerNotification.
      }
    }
  } with {
    briefly "CustomerNotification integration"
    described as {
      |The model's side of the CustomerNotification conversation.
    }
  }
  adaptor FromEmergencyDispatch from context EmergencyDispatch is { 
    handler FromEmergencyDispatchHandler is {
      on event EmergencyDispatch.CrewArrived is {
        do "the model receives crew arrived"
      }
      on event EmergencyDispatch.CrewDispatched is {
        do "the model receives crew dispatched"
      }
      on other is {
        error "Unexpected message for adaptor FromEmergencyDispatch"
      }
    } with {
      briefly "from emergency dispatch"
      described as {
        |Carries messages from the external EmergencyDispatch.
      }
    }
  } with {
    briefly "EmergencyDispatch integration"
    described as {
      |The model's side of the EmergencyDispatch conversation.
    }
  }
  adaptor ToEmergencyDispatch to context EmergencyDispatch is { 
    handler ToEmergencyDispatchHandler is {
      on command EmergencyDispatch.DispatchEmergencyCrew is {
        do "the model sends dispatch emergency crew"
      }
      on other is {
        error "Unexpected message for adaptor ToEmergencyDispatch"
      }
    } with {
      briefly "to emergency dispatch"
      described as {
        |Carries messages to the external EmergencyDispatch.
      }
    }
  } with {
    briefly "EmergencyDispatch integration"
    described as {
      |The model's side of the EmergencyDispatch conversation.
    }
  }
  adaptor FromPipelineSCADA from context PipelineSCADA is { 
    handler FromPipelineSCADAHandler is {
      on result PipelineSCADA.RealtimePressure is {
        do "the model receives realtime pressure"
      }
      on event PipelineSCADA.RegulatorAdjusted is {
        do "the model receives regulator adjusted"
      }
      on other is {
        error "Unexpected message for adaptor FromPipelineSCADA"
      }
    } with {
      briefly "from pipeline scada"
      described as {
        |Carries messages from the external PipelineSCADA.
      }
    }
  } with {
    briefly "PipelineSCADA integration"
    described as {
      |The model's side of the PipelineSCADA conversation.
    }
  }
  adaptor ToPipelineSCADA to context PipelineSCADA is { 
    handler ToPipelineSCADAHandler is {
      on command PipelineSCADA.AdjustRegulator is {
        do "the model sends adjust regulator"
      }
      on query PipelineSCADA.GetRealtimePressure is {
        do "the model sends get realtime pressure"
      }
      on other is {
        error "Unexpected message for adaptor ToPipelineSCADA"
      }
    } with {
      briefly "to pipeline scada"
      described as {
        |Carries messages to the external PipelineSCADA.
      }
    }
  } with {
    briefly "PipelineSCADA integration"
    described as {
      |The model's side of the PipelineSCADA conversation.
    }
  }
  adaptor FromRegulatoryCompliance from context RegulatoryCompliance is { 
    handler FromRegulatoryComplianceHandler is {
      on event RegulatoryCompliance.ReportAcknowledged is {
        do "the model receives report acknowledged"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryCompliance"
      }
    } with {
      briefly "from regulatory compliance"
      described as {
        |Carries messages from the external RegulatoryCompliance.
      }
    }
  } with {
    briefly "RegulatoryCompliance integration"
    described as {
      |The model's side of the RegulatoryCompliance conversation.
    }
  }
  adaptor ToRegulatoryCompliance to context RegulatoryCompliance is { 
    handler ToRegulatoryComplianceHandler is {
      on command RegulatoryCompliance.SubmitInspectionReport is {
        do "the model sends submit inspection report"
      }
      on command RegulatoryCompliance.SubmitLeakReport is {
        do "the model sends submit leak report"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryCompliance"
      }
    } with {
      briefly "to regulatory compliance"
      described as {
        |Carries messages to the external RegulatoryCompliance.
      }
    }
  } with {
    briefly "RegulatoryCompliance integration"
    described as {
      |The model's side of the RegulatoryCompliance conversation.
    }
  }
  include "types.riddl"
  include "District.riddl"
  repository GasRepository is {
    inlet GasRepositoryFromDistrict is type DistrictEvent    inlet GasRepositoryFromSafetyMetrics is type DistrictEvent    outlet GasRepositoryResponses is type District.DistrictResult
    record StoredDistrict is  {
      districtId: DistrictId with {
        briefly "districtId"
        described as {
          |The districtId column of the stored district row.
        }
      }
      districtName: String(1,100) with {
        briefly "districtName"
        described as {
          |The districtName column of the stored district row.
        }
      }
      status: DistrictStatus with {
        briefly "status"
        described as {
          |The status column of the stored district row.
        }
      }
    } with {
      briefly "Stored district row"
      described as {
        |The persistence shape of district data as this repository stores it.
      }
    }
    schema GasData is relational
      of districts as type StoredDistrict
        index on field StoredDistrict.districtId
        index on field StoredDistrict.status
        index on field StoredDistrict.districtName
 with {
      briefly "Gas data schema"
      described as {
        |The relational schema holding gas data for the GasRepository.
      }
    }
    handler GasPersistence is {
      on query GetDistrictSafety is {
        do "read the district safety projection"
        yield result DistrictSafetyView
      }
      on command District.CreateDistrict is {
        tell event District.DistrictCreated to entity GasContext.District
        do "Store new district record"
      }
      on command District.RecordPressureReading is {
        tell event District.PressureReadingRecorded to entity GasContext.District
        do "Store pressure reading"
      }
      on command District.ReportLeak is {
        do "Store leak report"
      }
      on command District.ScheduleMaintenance is {
        tell event District.MaintenanceScheduled to entity GasContext.District
        do "Store maintenance schedule"
      }
      on command District.RecordInspection is {
        tell event District.InspectionRecorded to entity GasContext.District
        do "Store inspection record"
      }
      on command District.UpdateStatus is {
        tell event District.StatusUpdated to entity GasContext.District
        do "Update district status"
      }
    } with {
      briefly "Persists gas commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Gas data persistence"
    described as {
      |Persistent storage for gas operations.
    }
  }
  query GetDistrictSafety is  {
    districtSafetyKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which district safety to retrieve.
      }
    }
  } with {
    briefly "Get district safety"
    described as {
      |Retrieves the district safety projection.
    }
  }
  result DistrictSafetyView is  {
    districtSafety: SafetyMetrics.DistrictSafety with {
      briefly "District safety"
      described as {
        |The district safety being returned.
      }
    }
  } with {
    briefly "District safety view"
    described as {
      |Read model view carrying the district safety projection.
    }
  }
  projector SafetyMetrics is {
    updates repository GasContext.GasRepository
    inlet SafetyMetricsFromDistrict is type DistrictEvent    outlet SafetyMetricsOut is type DistrictEvent
    record DistrictSafety is  {
      districtId: DistrictId with {
        briefly "District"
        described as {
          |District ID.
        }
      }
      openLeaks: Natural with {
        briefly "Open leaks"
        described as {
          |Open leak count.
        }
      }
      leaksRepaired: Natural with {
        briefly "Repaired"
        described as {
          |Leaks repaired.
        }
      }
      inspectionsPassed: Natural with {
        briefly "Passed"
        described as {
          |Inspections passed.
        }
      }
      inspectionsFailed: Natural with {
        briefly "Failed"
        described as {
          |Inspections failed.
        }
      }
      daysWithoutIncident: Natural with {
        briefly "Days safe"
        described as {
          |Days without incident.
        }
      }
    } with {
      briefly "District safety"
      described as {
        |Safety metrics by district.
      }
    }
    handler SafetyHandler is {
      on event District.LeakReported is {
        tell event District.LeakReported to repository GasContext.GasRepository
        do "Increment open leaks count"
      }
      on event District.InspectionRecorded is {
        tell event District.InspectionRecorded to repository GasContext.GasRepository
        do "Update inspection statistics"
      }
      on event District.StatusUpdated is {
        tell event District.StatusUpdated to repository GasContext.GasRepository
        do "Update safety incident tracking"
      }
    } with {
      briefly "Maintains safety metrics"
      described as {
        |Projects events into safety metrics.
      }
    }
  } with {
    briefly "Safety metrics"
    described as {
      |Gas safety monitoring.
    }
  }
  // ---- Event publication for District ----
  type DistrictEvent is one of {
    GasContext.District.DistrictCreated or GasContext.District.PressureReadingRecorded or GasContext.District.LeakReported or GasContext.District.OdorComplaintReceived or GasContext.District.MaintenanceScheduled or GasContext.District.InspectionRecorded or GasContext.District.SectionIsolated or GasContext.District.SectionRestored or GasContext.District.StatusUpdated
  } with {
    briefly "District event alternation"
    described as {
      |Union of all District events, for streaming and event-sourced
      |persistence.
    }
  }
  processor DistrictEventSource as source is {
    outlet DistrictEvents is type DistrictEvent
    handler DistrictSourceHandler is {
      on event District.DistrictCreated is {
        send event District.DistrictCreated to outlet DistrictEvents
      }
      on event District.PressureReadingRecorded is {
        send event District.PressureReadingRecorded to outlet DistrictEvents
      }
      on event District.LeakReported is {
        send event District.LeakReported to outlet DistrictEvents
      }
      on event District.OdorComplaintReceived is {
        send event District.OdorComplaintReceived to outlet DistrictEvents
      }
      on event District.MaintenanceScheduled is {
        send event District.MaintenanceScheduled to outlet DistrictEvents
      }
      on event District.InspectionRecorded is {
        send event District.InspectionRecorded to outlet DistrictEvents
      }
      on event District.SectionIsolated is {
        send event District.SectionIsolated to outlet DistrictEvents
      }
      on event District.SectionRestored is {
        send event District.SectionRestored to outlet DistrictEvents
      }
      on event District.StatusUpdated is {
        send event District.StatusUpdated to outlet DistrictEvents
      }
      on other is {
        error "Unexpected message for source DistrictEventSource"
      }
    } with {
      briefly "District source handler"
      described as {
        |Publishes District events onto the outlet.
      }
    }
  } with {
    briefly "District event source"
    described as {
      |Publishes District entity events into the streaming topology.
    }
  }
  processor DistrictEventSink as sink is {
    inlet DistrictInlet is type DistrictEvent    handler DistrictSinkHandler is {
      on event District.DistrictCreated is {
        tell event District.DistrictCreated to repository GasContext.GasRepository
      }
      on event District.PressureReadingRecorded is {
        tell event District.PressureReadingRecorded to repository GasContext.GasRepository
      }
      on event District.LeakReported is {
        tell event District.LeakReported to repository GasContext.GasRepository
      }
      on event District.OdorComplaintReceived is {
        tell event District.OdorComplaintReceived to repository GasContext.GasRepository
      }
      on event District.MaintenanceScheduled is {
        tell event District.MaintenanceScheduled to repository GasContext.GasRepository
      }
      on event District.InspectionRecorded is {
        tell event District.InspectionRecorded to repository GasContext.GasRepository
      }
      on event District.SectionIsolated is {
        tell event District.SectionIsolated to repository GasContext.GasRepository
      }
      on event District.SectionRestored is {
        tell event District.SectionRestored to repository GasContext.GasRepository
      }
      on event District.StatusUpdated is {
        tell event District.StatusUpdated to repository GasContext.GasRepository
      }
      on other is {
        error "Unexpected message for sink DistrictEventSink"
      }
    } with {
      briefly "District sink handler"
      described as {
        |Persists District events via the repository.
      }
    }
  } with {
    briefly "District event sink"
    described as {
      |Receives District events for persistence.
    }
  }
  connector DistrictEventFlow is from outlet GasContext.DistrictEventSource.DistrictEvents to inlet GasContext.DistrictEventSink.DistrictInlet with {
    briefly "District event flow"
    described as {
      |Connects the District source to its sink.
    }
  }
  processor DistrictEventSplit is {
    inlet DistrictEventSplitIn is type DistrictEvent    outlet DistrictEventSplitToGasRepository is type DistrictEvent
    outlet DistrictEventSplitToSafetyMetrics is type DistrictEvent
    handler DistrictEventSplitHandler is {
      on event District.DistrictCreated is {
        send event District.DistrictCreated to outlet DistrictEventSplitToGasRepository
        send event District.DistrictCreated to outlet DistrictEventSplitToSafetyMetrics
        tell event District.DistrictCreated to entity GasContext.District
      }
      on event District.PressureReadingRecorded is {
        send event District.PressureReadingRecorded to outlet DistrictEventSplitToGasRepository
        send event District.PressureReadingRecorded to outlet DistrictEventSplitToSafetyMetrics
        tell event District.PressureReadingRecorded to entity GasContext.District
      }
      on event District.LeakReported is {
        send event District.LeakReported to outlet DistrictEventSplitToGasRepository
        send event District.LeakReported to outlet DistrictEventSplitToSafetyMetrics
        tell event District.LeakReported to entity GasContext.District
      }
      on event District.OdorComplaintReceived is {
        send event District.OdorComplaintReceived to outlet DistrictEventSplitToGasRepository
        send event District.OdorComplaintReceived to outlet DistrictEventSplitToSafetyMetrics
        tell event District.OdorComplaintReceived to entity GasContext.District
      }
      on event District.MaintenanceScheduled is {
        send event District.MaintenanceScheduled to outlet DistrictEventSplitToGasRepository
        send event District.MaintenanceScheduled to outlet DistrictEventSplitToSafetyMetrics
        tell event District.MaintenanceScheduled to entity GasContext.District
      }
      on event District.InspectionRecorded is {
        send event District.InspectionRecorded to outlet DistrictEventSplitToGasRepository
        send event District.InspectionRecorded to outlet DistrictEventSplitToSafetyMetrics
        tell event District.InspectionRecorded to entity GasContext.District
      }
      on event District.SectionIsolated is {
        send event District.SectionIsolated to outlet DistrictEventSplitToGasRepository
        send event District.SectionIsolated to outlet DistrictEventSplitToSafetyMetrics
        tell event District.SectionIsolated to entity GasContext.District
      }
      on event District.SectionRestored is {
        send event District.SectionRestored to outlet DistrictEventSplitToGasRepository
        send event District.SectionRestored to outlet DistrictEventSplitToSafetyMetrics
        tell event District.SectionRestored to entity GasContext.District
      }
      on event District.StatusUpdated is {
        send event District.StatusUpdated to outlet DistrictEventSplitToGasRepository
        send event District.StatusUpdated to outlet DistrictEventSplitToSafetyMetrics
        tell event District.StatusUpdated to entity GasContext.District
      }
      on other is {
        error "Unexpected message for processor DistrictEventSplit"
      }
    } with {
      briefly "District event fan-out handler"
      described as {
        |Delivers each District event to all of its consumers.
      }
    }
  } with {
    briefly "District event fan-out"
    described as {
      |Fans District events out to the repository and projectors.
    }
  }
  connector 'DistrictEvent Stream' is from outlet GasContext.District.DistrictEvents2 to inlet GasContext.DistrictEventSplit.DistrictEventSplitIn with {
    briefly "District events, fanned out to storage and read models"
  }
  connector 'DistrictEvent Storage' is from outlet GasContext.DistrictEventSplit.DistrictEventSplitToGasRepository to inlet GasContext.GasRepository.GasRepositoryFromDistrict with {
    briefly "District events on their way to storage"
  }
  connector 'SafetyMetrics Feed' is from outlet GasContext.DistrictEventSplit.DistrictEventSplitToSafetyMetrics to inlet GasContext.SafetyMetrics.SafetyMetricsFromDistrict with {
    briefly "District events feeding the SafetyMetrics projection"
  }
  connector 'SafetyMetrics Storage' is from outlet GasContext.SafetyMetrics.SafetyMetricsOut to inlet GasContext.GasRepository.GasRepositoryFromSafetyMetrics with {
    briefly "The SafetyMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for gas distribution"
  described as {
    |Natural gas distribution context.
  }
}
