// Gas Distribution - Gas Context
context GasContext as router is {
  inlet DistrictCommandStreamIn is type DistrictCommand  outlet DistrictCommandStreamOut is type DistrictCommand
  inlet DistrictResultStreamIn is result District.DistrictResult  outlet DistrictResultStreamOut is result District.DistrictResult
  handler GasContextBoundary is {
    on createDistrict: command District.CreateDistrict is {
      send createDistrict to outlet GasContext.DistrictCommandStreamOut
    }
    on recordPressureReading: command District.RecordPressureReading is {
      send recordPressureReading to outlet GasContext.DistrictCommandStreamOut
    }
    on reportLeak: command District.ReportLeak is {
      send reportLeak to outlet GasContext.DistrictCommandStreamOut
    }
    on reportOdorComplaint: command District.ReportOdorComplaint is {
      send reportOdorComplaint to outlet GasContext.DistrictCommandStreamOut
    }
    on scheduleMaintenance: command District.ScheduleMaintenance is {
      send scheduleMaintenance to outlet GasContext.DistrictCommandStreamOut
    }
    on recordInspection: command District.RecordInspection is {
      send recordInspection to outlet GasContext.DistrictCommandStreamOut
    }
    on isolateSection: command District.IsolateSection is {
      send isolateSection to outlet GasContext.DistrictCommandStreamOut
    }
    on restoreSection: command District.RestoreSection is {
      send restoreSection to outlet GasContext.DistrictCommandStreamOut
    }
    on updateStatus: command District.UpdateStatus is {
      send updateStatus to outlet GasContext.DistrictCommandStreamOut
    }
    on districtResult: result District.DistrictResult is {
      send districtResult to outlet GasContext.DistrictResultStreamOut
    }
    on other is {
      error "Unexpected message at the GasContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'DistrictCommand Stream Intake' is from outlet GasContext.DistrictCommandStreamOut to inlet GasContext.District.DistrictCommands  connector 'DistrictResult Stream Egress' is from outlet GasContext.GasRepository.GasRepositoryResponses to inlet GasContext.DistrictResultStreamIn  adaptor ToCustomerNotification to context CustomerNotification as flow is { 
    inlet ToCustomerNotificationIn is type DistrictEvent    outlet ToCustomerNotificationOut is command CustomerNotification.SendServiceAlert
    handler ToCustomerNotificationHandler is {
      on leakReported: event LeakReported is {
        let alert: type CustomerNotification.SendServiceAlert = prompt("translate the leakReported event into a SendServiceAlert warning the customers served by the affected main that gas service is at risk and what to do now, without disclosing the reporter")
        send alert to outlet GasContext.ToCustomerNotification.ToCustomerNotificationOut
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerNotification"
      }
    } with {
      briefly "to customer notification"
      described as {
        |Carries messages to the external CustomerNotification.
      }
    }
  } with {
    briefly "CustomerNotification integration"
    described as {
      |The model's side of the CustomerNotification conversation.
    }
  }
  adaptor FromEmergencyDispatch from context EmergencyDispatch as sink is { 
    inlet FromEmergencyDispatchIn is type EmergencyDispatch.EmergencyDispatchEvent    handler FromEmergencyDispatchHandler is {
      on crewArrived: event EmergencyDispatch.CrewArrived is {
        do "the crew is on site; isolating the section is their act"
      }
      on crewDispatched: event EmergencyDispatch.CrewDispatched is {
        do "the crew is on its way; reporting the leak was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromEmergencyDispatch"
      }
    } with {
      briefly "from emergency dispatch"
      described as {
        |Carries messages from the external EmergencyDispatch.
      }
    }
  } with {
    briefly "EmergencyDispatch integration"
    described as {
      |The model's side of the EmergencyDispatch conversation.
    }
  }
  adaptor ToEmergencyDispatch to context EmergencyDispatch as flow is { 
    inlet ToEmergencyDispatchIn is type DistrictEvent    outlet ToEmergencyDispatchOut is command EmergencyDispatch.DispatchEmergencyCrew
    handler ToEmergencyDispatchHandler is {
      on leakReported: event District.LeakReported is {
        let dispatch: type EmergencyDispatch.DispatchEmergencyCrew = prompt("translate the leakReported event into a DispatchEmergencyCrew, a reported leak being the one thing that must not wait")
        send dispatch to outlet GasContext.ToEmergencyDispatch.ToEmergencyDispatchOut
      }
      on other is {
        error "Unexpected message for adaptor ToEmergencyDispatch"
      }
    } with {
      briefly "to emergency dispatch"
      described as {
        |Carries messages to the external EmergencyDispatch.
      }
    }
  } with {
    briefly "EmergencyDispatch integration"
    described as {
      |The model's side of the EmergencyDispatch conversation.
    }
  }
  adaptor FromPipelineSCADA from context PipelineSCADA as sink is { 
    inlet FromPipelineSCADAIn is event PipelineSCADA.RegulatorAdjusted    handler FromPipelineSCADAHandler is {
      on regulatorAdjusted: event PipelineSCADA.RegulatorAdjusted is {
        do "the regulator has moved; the pressure reading that called for it was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromPipelineSCADA"
      }
    } with {
      briefly "from pipeline scada"
      described as {
        |Carries messages from the external PipelineSCADA.
      }
    }
  } with {
    briefly "PipelineSCADA integration"
    described as {
      |The model's side of the PipelineSCADA conversation.
    }
  }
  adaptor ToPipelineSCADA to context PipelineSCADA as merge is { 
    inlet ToPipelineSCADAIn is type DistrictEvent    inlet ToPipelineSCADAReplies is result PipelineSCADA.RealtimePressure    outlet ToPipelineSCADAOut is type PipelineSCADA.PipelineSCADARequest
    handler ToPipelineSCADAHandler is {
      on leakReported: event District.LeakReported is {
        let askAnswer: type PipelineSCADA.RealtimePressure = ask query PipelineSCADA.GetRealtimePressure of context PipelineSCADA
        do "a reported leak needing live pressure to locate and size it"
      }
      on pressureReadingRecorded: event District.PressureReadingRecorded is {
        let item0: type PipelineSCADA.AdjustRegulator = prompt("translate the pressureReadingRecorded event into a AdjustRegulator, a pressure reading being what a regulator is trimmed against")
        send item0 to outlet GasContext.ToPipelineSCADA.ToPipelineSCADAOut
      }
      on other is {
        error "Unexpected message for adaptor ToPipelineSCADA"
      }
    } with {
      briefly "to pipeline scada"
      described as {
        |Carries messages to the external PipelineSCADA.
      }
    }
  } with {
    briefly "PipelineSCADA integration"
    described as {
      |The model's side of the PipelineSCADA conversation.
    }
  }
  adaptor FromRegulatoryCompliance from context RegulatoryCompliance as sink is { 
    inlet FromRegulatoryComplianceIn is event RegulatoryCompliance.ReportAcknowledged    handler FromRegulatoryComplianceHandler is {
      on reportAcknowledged: event RegulatoryCompliance.ReportAcknowledged is {
        do "the regulator has the report; the inspection was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryCompliance"
      }
    } with {
      briefly "from regulatory compliance"
      described as {
        |Carries messages from the external RegulatoryCompliance.
      }
    }
  } with {
    briefly "RegulatoryCompliance integration"
    described as {
      |The model's side of the RegulatoryCompliance conversation.
    }
  }
  adaptor ToRegulatoryCompliance to context RegulatoryCompliance as flow is { 
    inlet ToRegulatoryComplianceIn is type DistrictEvent    outlet ToRegulatoryComplianceOut is type RegulatoryCompliance.RegulatoryComplianceCommand
    handler ToRegulatoryComplianceHandler is {
      on inspectionRecorded: event InspectionRecorded is {
        let item0: type RegulatoryCompliance.SubmitInspectionReport = prompt("translate the inspectionRecorded event into a SubmitInspectionReport passing the inspection to the regulator")
        send item0 to outlet GasContext.ToRegulatoryCompliance.ToRegulatoryComplianceOut
        let item1: type RegulatoryCompliance.SubmitLeakReport = prompt("translate the inspectionRecorded event into a SubmitLeakReport where the inspection found one")
        send item1 to outlet GasContext.ToRegulatoryCompliance.ToRegulatoryComplianceOut
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryCompliance"
      }
    } with {
      briefly "to regulatory compliance"
      described as {
        |Carries messages to the external RegulatoryCompliance.
      }
    }
  } with {
    briefly "RegulatoryCompliance integration"
    described as {
      |The model's side of the RegulatoryCompliance conversation.
    }
  }
  include "types.riddl"
  include "District.riddl"
  type GasRepositoryCommand is one of {
    GasContext.GasRepository.PersistDistrictCreated or GasContext.GasRepository.PersistInspectionRecorded or GasContext.GasRepository.PersistLeakReported or GasContext.GasRepository.PersistMaintenanceScheduled or GasContext.GasRepository.PersistOdorComplaintReceived or GasContext.GasRepository.PersistPressureReadingRecorded or GasContext.GasRepository.PersistSectionIsolated or GasContext.GasRepository.PersistSectionRestored or GasContext.GasRepository.PersistStatusUpdated
  } with {
    briefly "Anything that writes GasRepository"
    described as {
      |The persistence commands GasRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository GasRepository as flow is {
    inlet GasRepositoryFromSafetyMetrics is type GasRepositoryCommand    command PersistDistrictCreated is {
      districtId: DistrictId with {
        briefly "Row addressed"
        described as {
          |Which stored row DistrictCreated applies to.
        }
      }
    } with {
      briefly "Persist DistrictCreated"
      described as {
        |Instructs this repository to apply DistrictCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceScheduled is {
      districtId: DistrictId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceScheduled applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceScheduled"
      described as {
        |Instructs this repository to apply MaintenanceScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOdorComplaintReceived is {
      districtId: DistrictId with {
        briefly "Row addressed"
        described as {
          |Which stored row OdorComplaintReceived applies to.
        }
      }
    } with {
      briefly "Persist OdorComplaintReceived"
      described as {
        |Instructs this repository to apply OdorComplaintReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPressureReadingRecorded is {
      districtId: DistrictId with {
        briefly "Row addressed"
        described as {
          |Which stored row PressureReadingRecorded applies to.
        }
      }
    } with {
      briefly "Persist PressureReadingRecorded"
      described as {
        |Instructs this repository to apply PressureReadingRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSectionIsolated is {
      districtId: DistrictId with {
        briefly "Row addressed"
        described as {
          |Which stored row SectionIsolated applies to.
        }
      }
    } with {
      briefly "Persist SectionIsolated"
      described as {
        |Instructs this repository to apply SectionIsolated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSectionRestored is {
      districtId: DistrictId with {
        briefly "Row addressed"
        described as {
          |Which stored row SectionRestored applies to.
        }
      }
    } with {
      briefly "Persist SectionRestored"
      described as {
        |Instructs this repository to apply SectionRestored to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInspectionRecorded is {
      districtId: DistrictId with {
        briefly "Row addressed"
        described as {
          |Which stored row InspectionRecorded applies to.
        }
      }
    } with {
      briefly "Persist InspectionRecorded"
      described as {
        |Instructs this repository to apply InspectionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLeakReported is {
      districtId: DistrictId with {
        briefly "Row addressed"
        described as {
          |Which stored row LeakReported applies to.
        }
      }
    } with {
      briefly "Persist LeakReported"
      described as {
        |Instructs this repository to apply LeakReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStatusUpdated is {
      districtId: DistrictId with {
        briefly "Row addressed"
        described as {
          |Which stored row StatusUpdated applies to.
        }
      }
    } with {
      briefly "Persist StatusUpdated"
      described as {
        |Instructs this repository to apply StatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet GasRepositoryResponses is result District.DistrictResult
    record StoredDistrict is {
      districtId: DistrictId with {
        briefly "districtId"
        described as {
          |The districtId column of the stored district row.
        }
      }
      districtName: String(1,100) with {
        briefly "districtName"
        described as {
          |The districtName column of the stored district row.
        }
      }
      status: DistrictStatus with {
        briefly "status"
        described as {
          |The status column of the stored district row.
        }
      }
    } with {
      briefly "Stored district row"
      described as {
        |The persistence shape of district data as this repository stores it.
      }
    }
    schema GasData is relational
      of districts as record StoredDistrict
        index on field StoredDistrict.districtId
        index on field StoredDistrict.status
        index on field StoredDistrict.districtName
 with {
      briefly "Gas data schema"
      described as {
        |The relational schema holding gas data for the GasRepository.
      }
    }
    handler GasPersistence is {
      on persistDistrictCreated: command PersistDistrictCreated is {
        do "apply DistrictCreated to the stored row"
      }
      on persistMaintenanceScheduled: command PersistMaintenanceScheduled is {
        do "apply MaintenanceScheduled to the stored row"
      }
      on persistOdorComplaintReceived: command PersistOdorComplaintReceived is {
        do "apply OdorComplaintReceived to the stored row"
      }
      on persistPressureReadingRecorded: command PersistPressureReadingRecorded is {
        do "apply PressureReadingRecorded to the stored row"
      }
      on persistSectionIsolated: command PersistSectionIsolated is {
        do "apply SectionIsolated to the stored row"
      }
      on persistSectionRestored: command PersistSectionRestored is {
        do "apply SectionRestored to the stored row"
      }
      on persistInspectionRecorded: command PersistInspectionRecorded is {
        do "apply InspectionRecorded to the stored row"
      }
      on persistLeakReported: command PersistLeakReported is {
        do "apply LeakReported to the stored row"
      }
      on persistStatusUpdated: command PersistStatusUpdated is {
        do "apply StatusUpdated to the stored row"
      }
      on query GetDistrictSafety is {
        let districtSafetyView: type DistrictSafetyView = prompt("read the district safety projection")
        reply districtSafetyView
      }
    } with {
      briefly "Persists gas commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Gas data persistence"
    described as {
      |Persistent storage for gas operations.
    }
  }
  query GetDistrictSafety replies result DistrictSafetyView is {
    districtSafetyKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which district safety to retrieve.
      }
    }
  } with {
    briefly "Get district safety"
    described as {
      |Retrieves the district safety projection.
    }
  }
  result DistrictSafetyView is {
    districtSafety: SafetyMetrics.DistrictSafety with {
      briefly "District safety"
      described as {
        |The district safety being returned.
      }
    }
  } with {
    briefly "District safety view"
    described as {
      |Read model view carrying the district safety projection.
    }
  }
  projector SafetyMetrics as flow is {
    updates repository GasContext.GasRepository
    outlet SafetyMetricsToRepository is type GasRepositoryCommand
    inlet SafetyMetricsFromDistrict is type DistrictEvent    record DistrictSafety is {
      districtId: DistrictId with {
        briefly "District"
        described as {
          |District ID.
        }
      }
      openLeaks: Natural with {
        briefly "Open leaks"
        described as {
          |Open leak count.
        }
      }
      leaksRepaired: Natural with {
        briefly "Repaired"
        described as {
          |Leaks repaired.
        }
      }
      inspectionsPassed: Natural with {
        briefly "Passed"
        described as {
          |Inspections passed.
        }
      }
      inspectionsFailed: Natural with {
        briefly "Failed"
        described as {
          |Inspections failed.
        }
      }
      daysWithoutIncident: Natural with {
        briefly "Days safe"
        described as {
          |Days without incident.
        }
      }
    } with {
      briefly "District safety"
      described as {
        |Safety metrics by district.
      }
    }
    handler SafetyHandler is {
      on districtCreated: event District.DistrictCreated is {
        tell command GasContext.GasRepository.PersistDistrictCreated(districtId = districtCreated.districtId) to repository GasContext.GasRepository
        do "apply DistrictCreated to the SafetyMetrics projection"
      }
      on maintenanceScheduled: event District.MaintenanceScheduled is {
        tell command GasContext.GasRepository.PersistMaintenanceScheduled(districtId = maintenanceScheduled.districtId) to repository GasContext.GasRepository
        do "apply MaintenanceScheduled to the SafetyMetrics projection"
      }
      on odorComplaintReceived: event District.OdorComplaintReceived is {
        tell command GasContext.GasRepository.PersistOdorComplaintReceived(districtId = odorComplaintReceived.districtId) to repository GasContext.GasRepository
        do "apply OdorComplaintReceived to the SafetyMetrics projection"
      }
      on pressureReadingRecorded: event District.PressureReadingRecorded is {
        tell command GasContext.GasRepository.PersistPressureReadingRecorded(districtId = pressureReadingRecorded.districtId) to repository GasContext.GasRepository
        do "apply PressureReadingRecorded to the SafetyMetrics projection"
      }
      on sectionIsolated: event District.SectionIsolated is {
        tell command GasContext.GasRepository.PersistSectionIsolated(districtId = sectionIsolated.districtId) to repository GasContext.GasRepository
        do "apply SectionIsolated to the SafetyMetrics projection"
      }
      on sectionRestored: event District.SectionRestored is {
        tell command GasContext.GasRepository.PersistSectionRestored(districtId = sectionRestored.districtId) to repository GasContext.GasRepository
        do "apply SectionRestored to the SafetyMetrics projection"
      }
      on leakReported: event District.LeakReported is {
        tell command GasContext.GasRepository.PersistLeakReported(districtId = leakReported.districtId) to repository GasContext.GasRepository
        do "Increment open leaks count"
      }
      on inspectionRecorded: event District.InspectionRecorded is {
        tell command GasContext.GasRepository.PersistInspectionRecorded(districtId = inspectionRecorded.districtId) to repository GasContext.GasRepository
        do "Update inspection statistics"
      }
      on statusUpdated: event District.StatusUpdated is {
        tell command GasContext.GasRepository.PersistStatusUpdated(districtId = statusUpdated.districtId) to repository GasContext.GasRepository
        do "Update safety incident tracking"
      }
    } with {
      briefly "Maintains safety metrics"
      described as {
        |Projects events into safety metrics.
      }
    }
  } with {
    briefly "Safety metrics"
    described as {
      |Gas safety monitoring.
    }
  }
  // ---- Event publication for District ----
  type DistrictEvent is one of {
    GasContext.District.DistrictCreated or GasContext.District.PressureReadingRecorded or GasContext.District.LeakReported or GasContext.District.OdorComplaintReceived or GasContext.District.MaintenanceScheduled or GasContext.District.InspectionRecorded or GasContext.District.SectionIsolated or GasContext.District.SectionRestored or GasContext.District.StatusUpdated
  } with {
    briefly "District event alternation"
    described as {
      |Union of all District events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet DistrictEventSplit as split is {
    outlet DistrictEventSplitToToRegulatoryCompliance is type DistrictEvent
    outlet DistrictEventSplitToToPipelineSCADA is type DistrictEvent
    outlet DistrictEventSplitToToEmergencyDispatch is type DistrictEvent
    outlet DistrictEventSplitToToCustomerNotification is type DistrictEvent
    inlet DistrictEventSplitIn is type DistrictEvent    outlet DistrictEventSplitToSafetyMetrics is type DistrictEvent
    handler DistrictEventSplitHandler is {
      on districtCreated: event District.DistrictCreated is {
        send districtCreated to outlet DistrictEventSplitToSafetyMetrics
        tell districtCreated to entity GasContext.District
      }
      on pressureReadingRecorded: event District.PressureReadingRecorded is {
        send pressureReadingRecorded to outlet DistrictEventSplitToSafetyMetrics
        send pressureReadingRecorded to outlet DistrictEventSplitToToPipelineSCADA
        tell pressureReadingRecorded to entity GasContext.District
      }
      on leakReported: event District.LeakReported is {
        send leakReported to outlet DistrictEventSplitToSafetyMetrics
        send leakReported to outlet DistrictEventSplitToToPipelineSCADA
        send leakReported to outlet DistrictEventSplitToToEmergencyDispatch
        send leakReported to outlet DistrictEventSplitToToCustomerNotification
        tell leakReported to entity GasContext.District
      }
      on odorComplaintReceived: event District.OdorComplaintReceived is {
        send odorComplaintReceived to outlet DistrictEventSplitToSafetyMetrics
        tell odorComplaintReceived to entity GasContext.District
      }
      on maintenanceScheduled: event District.MaintenanceScheduled is {
        send maintenanceScheduled to outlet DistrictEventSplitToSafetyMetrics
        tell maintenanceScheduled to entity GasContext.District
      }
      on inspectionRecorded: event District.InspectionRecorded is {
        send inspectionRecorded to outlet DistrictEventSplitToSafetyMetrics
        send inspectionRecorded to outlet DistrictEventSplitToToRegulatoryCompliance
        tell inspectionRecorded to entity GasContext.District
      }
      on sectionIsolated: event District.SectionIsolated is {
        send sectionIsolated to outlet DistrictEventSplitToSafetyMetrics
        tell sectionIsolated to entity GasContext.District
      }
      on sectionRestored: event District.SectionRestored is {
        send sectionRestored to outlet DistrictEventSplitToSafetyMetrics
        tell sectionRestored to entity GasContext.District
      }
      on statusUpdated: event District.StatusUpdated is {
        send statusUpdated to outlet DistrictEventSplitToSafetyMetrics
        tell statusUpdated to entity GasContext.District
      }
      on other is {
        error "Unexpected message for processor DistrictEventSplit"
      }
    } with {
      briefly "District event fan-out handler"
      described as {
        |Delivers each District event to all of its consumers.
      }
    }
  } with {
    briefly "District event fan-out"
    described as {
      |Fans District events out to the repository and projectors.
    }
  }
  connector 'ToRegulatoryCompliance Feed' is from outlet GasContext.DistrictEventSplit.DistrictEventSplitToToRegulatoryCompliance to inlet GasContext.ToRegulatoryCompliance.ToRegulatoryComplianceIn with {
    briefly "The District events ToRegulatoryCompliance translates, on their way to it"
  }
  connector 'ToPipelineSCADA Feed' is from outlet GasContext.DistrictEventSplit.DistrictEventSplitToToPipelineSCADA to inlet GasContext.ToPipelineSCADA.ToPipelineSCADAIn with {
    briefly "The District events ToPipelineSCADA translates, on their way to it"
  }
  connector 'ToEmergencyDispatch Feed' is from outlet GasContext.DistrictEventSplit.DistrictEventSplitToToEmergencyDispatch to inlet GasContext.ToEmergencyDispatch.ToEmergencyDispatchIn with {
    briefly "The District events ToEmergencyDispatch translates, on their way to it"
  }
  connector 'ToCustomerNotification Feed' is from outlet GasContext.DistrictEventSplit.DistrictEventSplitToToCustomerNotification to inlet GasContext.ToCustomerNotification.ToCustomerNotificationIn with {
    briefly "The District events ToCustomerNotification translates, on their way to it"
  }
  connector 'DistrictEvent Stream' is from outlet GasContext.District.DistrictEvents2 to inlet GasContext.DistrictEventSplit.DistrictEventSplitIn with {
    briefly "District events, fanned out to storage and read models"
  }
  connector 'SafetyMetrics Feed' is from outlet GasContext.DistrictEventSplit.DistrictEventSplitToSafetyMetrics to inlet GasContext.SafetyMetrics.SafetyMetricsFromDistrict with {
    briefly "District events feeding the SafetyMetrics projection"
  }
  connector 'SafetyMetrics Storage' is from outlet GasContext.SafetyMetrics.SafetyMetricsToRepository to inlet GasContext.GasRepository.GasRepositoryFromSafetyMetrics with {
    briefly "SafetyMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for gas distribution"
  described as {
    |Natural gas distribution context.
  }
}
