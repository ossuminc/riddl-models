// Gas Distribution Domain Model
// Natural gas distribution system management
domain GasDistribution is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user GasOperator is "person managing gas distribution" with {
    briefly "Gas Operator"
    described as {
      |Operator monitoring gas network.
    }
  }
  user SafetyInspector is "person conducting safety inspections" with {
    briefly "Safety Inspector"
    described as {
      |Inspector ensuring safety compliance.
    }
  }
  user FieldTechnician is "person performing field maintenance" with {
    briefly "Field Technician"
    described as {
      |Technician maintaining infrastructure.
    }
  }
  epic GasNetworkManagement is {
    user GasOperator wants to "to maintain safe gas distribution" so that "customers receive reliable gas service"
    case MonitorPressure is {
      user GasOperator wants to "to monitor network pressure" so that "safe delivery is maintained"
      step is "Operator monitors" "pressure readings" "across network" with {
        briefly "Monitor pressure"
        described as {
          |Track pressure.
        }
      }
      step is "System alerts" "on anomalies" "for response" with {
        briefly "Alert anomalies"
        described as {
          |Detect issues.
        }
      }
    } with {
      briefly "Monitor network pressure"
      described as {
        |Maintaining distribution pressure.
      }
    }
  } with {
    briefly "Gas network management"
    described as {
      |Epic for gas distribution.
    }
  }
  include "GasContext.riddl"
  include "external-contexts.riddl"
  application context GasDistributionApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in GasDistribution are delivered.
      }
    }
    outlet AppDistrictCommands is type GasContext.District.DistrictCommand
    inlet AppGasRepositoryResponses is type GasContext.District.DistrictResult    handler GasDistributionAppHandler is {
      on other is {
        error "Unexpected message for application context GasDistributionApp"
      }
    } with {
      briefly "GasDistributionApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "GasDistributionApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'DistrictCommand Stream' is from outlet GasDistributionApp.AppDistrictCommands to inlet GasContext.District.DistrictCommands with {
    briefly "District commands from the application"
  }
  persistent connector 'DistrictResult Stream' is from outlet GasContext.GasRepository.GasRepositoryResponses to inlet GasDistributionApp.AppGasRepositoryResponses with {
    briefly "Gas query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet GasDistributionApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term PressureAlert is  "An alert raised on anomalies in the distribution network for response." 
  briefly "Gas distribution domain"
  described as {
    |Natural gas distribution management.
  }
}
