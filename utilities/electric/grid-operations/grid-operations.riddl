// Grid Operations Domain Model
// Electric utility grid management
domain GridOperations is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user GridOperator is "person managing grid operations" with {
    briefly "Grid Operator"
    described as {
      |Operator monitoring and controlling the grid.
    }
  }
  user DispatchController is "person dispatching generation resources" with {
    briefly "Dispatch Controller"
    described as {
      |Controller managing generation dispatch.
    }
  }
  user OutageCoordinator is "person managing outage response" with {
    briefly "Outage Coordinator"
    described as {
      |Coordinator handling outage restoration.
    }
  }
  epic GridManagement is {
    user GridOperator wants to "to maintain grid stability" so that "reliable power is delivered to customers"
    case ManageLoad is {
      user GridOperator wants to "to balance load and generation" so that "grid frequency remains stable"
      step is "Operator monitors" "load demand" "and generation" with {
        briefly "Monitor load"
        described as {
          |Track demand.
        }
      }
      step is "System adjusts" "generation dispatch" "to match load" with {
        briefly "Adjust dispatch"
        described as {
          |Balance grid.
        }
      }
    } with {
      briefly "Manage grid load"
      described as {
        |Balancing load and generation.
      }
    }
  } with {
    briefly "Grid management"
    described as {
      |Epic for electric grid operations.
    }
  }
  include "GridContext.riddl"
  include "external-contexts.riddl"
  application context GridOperationsApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in GridOperations are delivered.
      }
    }
    outlet AppGridSectionCommands is type GridContext.GridSection.GridSectionCommand
    inlet AppGridRepositoryResponses is result GridContext.GridSection.GridSectionResult    handler GridOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context GridOperationsApp"
      }
    } with {
      briefly "GridOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "GridOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'GridSectionCommand Stream' is from outlet GridOperationsApp.AppGridSectionCommands to inlet GridContext.GridSectionCommandStreamIn with {
    briefly "GridSection commands from the application"
  }
  persistent connector 'GridSectionResult Stream' is from outlet GridContext.GridSectionResultStreamOut to inlet GridOperationsApp.AppGridRepositoryResponses with {
    briefly "Grid query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet GridOperationsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Grid operations domain"
  described as {
    |Electric utility grid management and control.
  }
}
