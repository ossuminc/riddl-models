// Grid Operations - Grid Context
context GridContext is {
  include "types.riddl"
  include "GridSection.riddl"
  repository GridRepository is {
    inlet GridRepositoryFromGridSection is type GridSectionEvent
    inlet GridRepositoryFromGridAnalytics is type GridSectionEvent
    outlet GridRepositoryResponses is type GridSection.GridSectionResult
    schema GridData is relational
      of gridSections as type GridSection
        index on field GridSection.sectionId
        index on field GridSection.substationId
        index on field GridSection.status

    handler GridPersistence is {
      on command GridSection.CreateSection is {
        tell event GridSection.SectionCreated to entity GridContext.GridSection
        prompt "Store new grid section"
      }
      on command GridSection.RecordLoad is {
        tell event GridSection.LoadRecorded to entity GridContext.GridSection
        prompt "Store load reading"
      }
      on command GridSection.ReportOutage is {
        prompt "Store outage event"
      }
      on command GridSection.RestoreService is {
        prompt "Update outage as restored"
      }
      on command GridSection.ExecuteSwitching is {
        prompt "Store switching order"
      }
    } with {
      briefly "Persists grid commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Grid data persistence"
    described as {
      |Persistent storage for grid operations.
    }
  }
  projector GridAnalytics is {
    inlet GridAnalyticsFromGridSection is type GridSectionEvent
    outlet GridAnalyticsOut is type GridSectionEvent
    updates repository GridContext.GridRepository
    record ReliabilityMetrics is  {
      saidi: Decimal(8,2) with {
        briefly "SAIDI"
        described as {
          |System average interruption duration index.
        }
      }
      saifi: Decimal(6,4) with {
        briefly "SAIFI"
        described as {
          |System average interruption frequency index.
        }
      }
      caidi: Decimal(8,2) with {
        briefly "CAIDI"
        described as {
          |Customer average interruption duration.
        }
      }
      asai: Decimal(7,5) with {
        briefly "ASAI"
        described as {
          |Average service availability index.
        }
      }
    } with {
      briefly "Reliability metrics"
      described as {
        |Grid reliability indices.
      }
    }
    record LoadProfile is  {
      peakLoadMW: Decimal(10,2) with {
        briefly "Peak"
        described as {
          |Peak load MW.
        }
      }
      averageLoadMW: Decimal(10,2) with {
        briefly "Average"
        described as {
          |Average load MW.
        }
      }
      loadFactor: Decimal(5,4) with {
        briefly "Load factor"
        described as {
          |Load factor.
        }
      }
    } with {
      briefly "Load profile"
      described as {
        |Load profile metrics.
      }
    }
    handler AnalyticsHandler is {
      on event GridSection.LoadRecorded is {
        tell event GridSection.LoadRecorded to repository GridContext.GridRepository
        prompt "Update load analytics"
      }
      on event GridSection.ServiceRestored is {
        tell event GridSection.ServiceRestored to repository GridContext.GridRepository
        prompt "Calculate reliability metrics"
      }
    } with {
      briefly "Maintains grid analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Grid analytics"
    described as {
      |Grid performance analytics.
    }
  }
  // ---- Event publication for GridSection ----
  type GridSectionEvent is one of {
    GridContext.GridSection.SectionCreated,
    GridContext.GridSection.LoadRecorded,
    GridContext.GridSection.OutageReported,
    GridContext.GridSection.CrewDispatched,
    GridContext.GridSection.OutageStatusUpdated,
    GridContext.GridSection.ServiceRestored,
    GridContext.GridSection.SwitchingExecuted,
    GridContext.GridSection.MaintenanceModeSet,
    GridContext.GridSection.ReturnedToService
  } with {
    briefly "GridSection event alternation"
    described as {
      |Union of all GridSection events, for streaming and event-sourced
      |persistence.
    }
  }
  processor GridSectionEventSource as source is {
    outlet GridSectionEvents is type GridSectionEvent
    handler GridSectionSourceHandler is {
      on event GridSection.SectionCreated is {
        send event GridSection.SectionCreated to outlet GridSectionEvents
      }
      on event GridSection.LoadRecorded is {
        send event GridSection.LoadRecorded to outlet GridSectionEvents
      }
      on event GridSection.OutageReported is {
        send event GridSection.OutageReported to outlet GridSectionEvents
      }
      on event GridSection.CrewDispatched is {
        send event GridSection.CrewDispatched to outlet GridSectionEvents
      }
      on event GridSection.OutageStatusUpdated is {
        send event GridSection.OutageStatusUpdated to outlet GridSectionEvents
      }
      on event GridSection.ServiceRestored is {
        send event GridSection.ServiceRestored to outlet GridSectionEvents
      }
      on event GridSection.SwitchingExecuted is {
        send event GridSection.SwitchingExecuted to outlet GridSectionEvents
      }
      on event GridSection.MaintenanceModeSet is {
        send event GridSection.MaintenanceModeSet to outlet GridSectionEvents
      }
      on event GridSection.ReturnedToService is {
        send event GridSection.ReturnedToService to outlet GridSectionEvents
      }
      on other is {
        error "Unexpected message for source GridSectionEventSource"
      }
    } with {
      briefly "GridSection source handler"
      described as {
        |Publishes GridSection events onto the outlet.
      }
    }
  } with {
    briefly "GridSection event source"
    described as {
      |Publishes GridSection entity events into the streaming topology.
    }
  }
  processor GridSectionEventSink as sink is {
    inlet GridSectionInlet is type GridSectionEvent
    handler GridSectionSinkHandler is {
      on event GridSection.SectionCreated is {
        tell event GridSection.SectionCreated to repository GridContext.GridRepository
      }
      on event GridSection.LoadRecorded is {
        tell event GridSection.LoadRecorded to repository GridContext.GridRepository
      }
      on event GridSection.OutageReported is {
        tell event GridSection.OutageReported to repository GridContext.GridRepository
      }
      on event GridSection.CrewDispatched is {
        tell event GridSection.CrewDispatched to repository GridContext.GridRepository
      }
      on event GridSection.OutageStatusUpdated is {
        tell event GridSection.OutageStatusUpdated to repository GridContext.GridRepository
      }
      on event GridSection.ServiceRestored is {
        tell event GridSection.ServiceRestored to repository GridContext.GridRepository
      }
      on event GridSection.SwitchingExecuted is {
        tell event GridSection.SwitchingExecuted to repository GridContext.GridRepository
      }
      on event GridSection.MaintenanceModeSet is {
        tell event GridSection.MaintenanceModeSet to repository GridContext.GridRepository
      }
      on event GridSection.ReturnedToService is {
        tell event GridSection.ReturnedToService to repository GridContext.GridRepository
      }
      on other is {
        error "Unexpected message for sink GridSectionEventSink"
      }
    } with {
      briefly "GridSection sink handler"
      described as {
        |Persists GridSection events via the repository.
      }
    }
  } with {
    briefly "GridSection event sink"
    described as {
      |Receives GridSection events for persistence.
    }
  }
  connector GridSectionEventFlow is {
    from outlet GridContext.GridSectionEventSource.GridSectionEvents to
      inlet GridContext.GridSectionEventSink.GridSectionInlet
  } with {
    briefly "GridSection event flow"
    described as {
      |Connects the GridSection source to its sink.
    }
  }
  processor GridSectionEventSplit is {
    inlet GridSectionEventSplitIn is type GridSectionEvent
    outlet GridSectionEventSplitToGridRepository is type GridSectionEvent
    outlet GridSectionEventSplitToGridAnalytics is type GridSectionEvent
    handler GridSectionEventSplitHandler is {
      on event GridSection.SectionCreated is {
        send event GridSection.SectionCreated to outlet GridSectionEventSplitToGridRepository
        send event GridSection.SectionCreated to outlet GridSectionEventSplitToGridAnalytics
        tell event GridSection.SectionCreated to entity GridContext.GridSection
      }
      on event GridSection.LoadRecorded is {
        send event GridSection.LoadRecorded to outlet GridSectionEventSplitToGridRepository
        send event GridSection.LoadRecorded to outlet GridSectionEventSplitToGridAnalytics
        tell event GridSection.LoadRecorded to entity GridContext.GridSection
      }
      on event GridSection.OutageReported is {
        send event GridSection.OutageReported to outlet GridSectionEventSplitToGridRepository
        send event GridSection.OutageReported to outlet GridSectionEventSplitToGridAnalytics
        tell event GridSection.OutageReported to entity GridContext.GridSection
      }
      on event GridSection.CrewDispatched is {
        send event GridSection.CrewDispatched to outlet GridSectionEventSplitToGridRepository
        send event GridSection.CrewDispatched to outlet GridSectionEventSplitToGridAnalytics
        tell event GridSection.CrewDispatched to entity GridContext.GridSection
      }
      on event GridSection.OutageStatusUpdated is {
        send event GridSection.OutageStatusUpdated to outlet GridSectionEventSplitToGridRepository
        send event GridSection.OutageStatusUpdated to outlet GridSectionEventSplitToGridAnalytics
        tell event GridSection.OutageStatusUpdated to entity GridContext.GridSection
      }
      on event GridSection.ServiceRestored is {
        send event GridSection.ServiceRestored to outlet GridSectionEventSplitToGridRepository
        send event GridSection.ServiceRestored to outlet GridSectionEventSplitToGridAnalytics
        tell event GridSection.ServiceRestored to entity GridContext.GridSection
      }
      on event GridSection.SwitchingExecuted is {
        send event GridSection.SwitchingExecuted to outlet GridSectionEventSplitToGridRepository
        send event GridSection.SwitchingExecuted to outlet GridSectionEventSplitToGridAnalytics
        tell event GridSection.SwitchingExecuted to entity GridContext.GridSection
      }
      on event GridSection.MaintenanceModeSet is {
        send event GridSection.MaintenanceModeSet to outlet GridSectionEventSplitToGridRepository
        send event GridSection.MaintenanceModeSet to outlet GridSectionEventSplitToGridAnalytics
        tell event GridSection.MaintenanceModeSet to entity GridContext.GridSection
      }
      on event GridSection.ReturnedToService is {
        send event GridSection.ReturnedToService to outlet GridSectionEventSplitToGridRepository
        send event GridSection.ReturnedToService to outlet GridSectionEventSplitToGridAnalytics
        tell event GridSection.ReturnedToService to entity GridContext.GridSection
      }
      on other is {
        error "Unexpected message for processor GridSectionEventSplit"
      }
    } with {
      briefly "GridSection event fan-out handler"
      described as {
        |Delivers each GridSection event to all of its consumers.
      }
    }
  } with {
    briefly "GridSection event fan-out"
    described as {
      |Fans GridSection events out to the repository and projectors.
    }
  }
  connector LinkGridSectionToGridSectionEventSplit is {
    from outlet GridContext.GridSection.GridSectionEvents2 to
      inlet GridContext.GridSectionEventSplit.GridSectionEventSplitIn
  } with {
    briefly "LinkGridSectionToGridSectionEventSplit"
  }
  connector LinkGridSectionEventSplitToGridRepository is {
    from outlet GridContext.GridSectionEventSplit.GridSectionEventSplitToGridRepository to
      inlet GridContext.GridRepository.GridRepositoryFromGridSection
  } with {
    briefly "LinkGridSectionEventSplitToGridRepository"
  }
  connector LinkGridSectionEventSplitToGridAnalytics is {
    from outlet GridContext.GridSectionEventSplit.GridSectionEventSplitToGridAnalytics to
      inlet GridContext.GridAnalytics.GridAnalyticsFromGridSection
  } with {
    briefly "LinkGridSectionEventSplitToGridAnalytics"
  }
  connector LinkGridAnalyticsToGridRepository is {
    from outlet GridContext.GridAnalytics.GridAnalyticsOut to
      inlet GridContext.GridRepository.GridRepositoryFromGridAnalytics
  } with {
    briefly "LinkGridAnalyticsToGridRepository"
  }
} with {
  briefly "Bounded context for grid operations"
  described as {
    |Electric grid management context.
  }
}
