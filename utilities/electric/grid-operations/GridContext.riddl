// Grid Operations - Grid Context
context GridContext as router is {
  inlet GridSectionCommandStreamIn is type GridSectionCommand  outlet GridSectionCommandStreamOut is type GridSectionCommand
  inlet GridSectionResultStreamIn is result GridSection.GridSectionResult  outlet GridSectionResultStreamOut is result GridSection.GridSectionResult
  handler GridContextBoundary is {
    on createSection: command GridSection.CreateSection is {
      send createSection to outlet GridContext.GridSectionCommandStreamOut
    }
    on recordLoad: command GridSection.RecordLoad is {
      send recordLoad to outlet GridContext.GridSectionCommandStreamOut
    }
    on reportOutage: command GridSection.ReportOutage is {
      send reportOutage to outlet GridContext.GridSectionCommandStreamOut
    }
    on dispatchCrew: command GridSection.DispatchCrew is {
      send dispatchCrew to outlet GridContext.GridSectionCommandStreamOut
    }
    on updateOutageStatus: command GridSection.UpdateOutageStatus is {
      send updateOutageStatus to outlet GridContext.GridSectionCommandStreamOut
    }
    on restoreService: command GridSection.RestoreService is {
      send restoreService to outlet GridContext.GridSectionCommandStreamOut
    }
    on executeSwitching: command GridSection.ExecuteSwitching is {
      send executeSwitching to outlet GridContext.GridSectionCommandStreamOut
    }
    on setMaintenanceMode: command GridSection.SetMaintenanceMode is {
      send setMaintenanceMode to outlet GridContext.GridSectionCommandStreamOut
    }
    on returnToService: command GridSection.ReturnToService is {
      send returnToService to outlet GridContext.GridSectionCommandStreamOut
    }
    on gridSectionResult: result GridSection.GridSectionResult is {
      send gridSectionResult to outlet GridContext.GridSectionResultStreamOut
    }
    on other is {
      error "Unexpected message at the GridContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'GridSectionCommand Stream Intake' is from outlet GridContext.GridSectionCommandStreamOut to inlet GridContext.GridSection.GridSectionCommands  connector 'GridSectionResult Stream Egress' is from outlet GridContext.GridRepository.GridRepositoryResponses to inlet GridContext.GridSectionResultStreamIn  adaptor FromEnergyMarketSystem from context EnergyMarketSystem as flow is { 
    inlet FromEnergyMarketSystemIn is event EnergyMarketSystem.BidSubmitted    handler FromEnergyMarketSystemHandler is {
      on bidSubmitted: event EnergyMarketSystem.BidSubmitted is {
        do "the market has the bid; the load that sized it was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromEnergyMarketSystem"
      }
    } with {
      briefly "from energy market system"
      described as {
        |Carries messages from the external EnergyMarketSystem.
      }
    }
  } with {
    briefly "EnergyMarketSystem integration"
    described as {
      |The model's side of the EnergyMarketSystem conversation.
    }
  }
  adaptor ToEnergyMarketSystem to context EnergyMarketSystem as flow is { 
    outlet ToEnergyMarketSystemOut is type EnergyMarketSystem.EnergyMarketSystemRequest
    handler ToEnergyMarketSystemHandler is {
      on switchingExecuted: event GridSection.SwitchingExecuted is {
        let askAnswer: type EnergyMarketSystem.MarketPrices = ask query EnergyMarketSystem.GetMarketPrices of context EnergyMarketSystem
        do "a switching action needing the price of the energy it moves"
      }
      on loadRecorded: event GridSection.LoadRecorded is {
        let item0: type EnergyMarketSystem.SubmitGenerationBid = prompt("translate the loadRecorded event into a SubmitGenerationBid, recorded load being what a generation bid is sized against")
        send item0 to outlet GridContext.ToEnergyMarketSystem.ToEnergyMarketSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToEnergyMarketSystem"
      }
    } with {
      briefly "to energy market system"
      described as {
        |Carries messages to the external EnergyMarketSystem.
      }
    }
  } with {
    briefly "EnergyMarketSystem integration"
    described as {
      |The model's side of the EnergyMarketSystem conversation.
    }
  }
  adaptor FromOutageManagementSystem from context OutageManagementSystem as flow is { 
    inlet FromOutageManagementSystemIn is event OutageManagementSystem.TicketCreated    handler FromOutageManagementSystemHandler is {
      on ticketCreated: event OutageManagementSystem.TicketCreated is {
        do "the outage system has the ticket; reporting the outage was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromOutageManagementSystem"
      }
    } with {
      briefly "from outage management system"
      described as {
        |Carries messages from the external OutageManagementSystem.
      }
    }
  } with {
    briefly "OutageManagementSystem integration"
    described as {
      |The model's side of the OutageManagementSystem conversation.
    }
  }
  adaptor ToOutageManagementSystem to context OutageManagementSystem as flow is { 
    outlet ToOutageManagementSystemOut is type OutageManagementSystem.OutageManagementSystemRequest
    handler ToOutageManagementSystemHandler is {
      on serviceRestored: event GridSection.ServiceRestored is {
        let askAnswer: type OutageManagementSystem.OutageStatusInfo = ask query OutageManagementSystem.GetOutageStatus of context OutageManagementSystem
        do "a restoration needing the outage system's own account of what is still dark"
      }
      on outageReported: event GridSection.OutageReported is {
        let item0: type OutageManagementSystem.CreateOutageTicket = prompt("translate the outageReported event into a CreateOutageTicket, the report being what a ticket tracks")
        send item0 to outlet GridContext.ToOutageManagementSystem.ToOutageManagementSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToOutageManagementSystem"
      }
    } with {
      briefly "to outage management system"
      described as {
        |Carries messages to the external OutageManagementSystem.
      }
    }
  } with {
    briefly "OutageManagementSystem integration"
    described as {
      |The model's side of the OutageManagementSystem conversation.
    }
  }
  adaptor FromSCADASystem from context SCADASystem as flow is { 
    inlet FromSCADASystemIn is event SCADASystem.ControlCommandExecuted    handler FromSCADASystemHandler is {
      on controlCommandExecuted: event SCADASystem.ControlCommandExecuted is {
        do "the field device has switched; executing the switching was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromSCADASystem"
      }
    } with {
      briefly "from scada system"
      described as {
        |Carries messages from the external SCADASystem.
      }
    }
  } with {
    briefly "SCADASystem integration"
    described as {
      |The model's side of the SCADASystem conversation.
    }
  }
  adaptor ToSCADASystem to context SCADASystem as flow is { 
    outlet ToSCADASystemOut is type SCADASystem.SCADASystemRequest
    handler ToSCADASystemHandler is {
      on switchingExecuted: event GridSection.SwitchingExecuted is {
        let askAnswer: type SCADASystem.RealTimeData = ask query SCADASystem.GetRealTimeData of context SCADASystem
        do "switching needing live telemetry to confirm the network followed"
      }
      on outageReported: event GridSection.OutageReported is {
        let item0: type SCADASystem.SendControlCommand = prompt("translate the outageReported event into a SendControlCommand, an outage needing the section isolated rather than merely logged")
        send item0 to outlet GridContext.ToSCADASystem.ToSCADASystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToSCADASystem"
      }
    } with {
      briefly "to scada system"
      described as {
        |Carries messages to the external SCADASystem.
      }
    }
  } with {
    briefly "SCADASystem integration"
    described as {
      |The model's side of the SCADASystem conversation.
    }
  }
  include "types.riddl"
  include "GridSection.riddl"
  type GridRepositoryCommand is one of {
    GridContext.GridRepository.PersistCrewDispatched or GridContext.GridRepository.PersistLoadRecorded or GridContext.GridRepository.PersistMaintenanceModeSet or GridContext.GridRepository.PersistOutageReported or GridContext.GridRepository.PersistOutageStatusUpdated or GridContext.GridRepository.PersistReturnedToService or GridContext.GridRepository.PersistSectionCreated or GridContext.GridRepository.PersistServiceRestored or GridContext.GridRepository.PersistSwitchingExecuted
  } with {
    briefly "Anything that writes GridRepository"
    described as {
      |The persistence commands GridRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository GridRepository as flow is {
    inlet GridRepositoryFromGridAnalytics is type GridRepositoryCommand    command PersistCrewDispatched is {
      sectionId: GridSectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row CrewDispatched applies to.
        }
      }
    } with {
      briefly "Persist CrewDispatched"
      described as {
        |Instructs this repository to apply CrewDispatched to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceModeSet is {
      sectionId: GridSectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceModeSet applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceModeSet"
      described as {
        |Instructs this repository to apply MaintenanceModeSet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOutageReported is {
      sectionId: GridSectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row OutageReported applies to.
        }
      }
    } with {
      briefly "Persist OutageReported"
      described as {
        |Instructs this repository to apply OutageReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOutageStatusUpdated is {
      sectionId: GridSectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row OutageStatusUpdated applies to.
        }
      }
    } with {
      briefly "Persist OutageStatusUpdated"
      described as {
        |Instructs this repository to apply OutageStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnedToService is {
      sectionId: GridSectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnedToService applies to.
        }
      }
    } with {
      briefly "Persist ReturnedToService"
      described as {
        |Instructs this repository to apply ReturnedToService to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSectionCreated is {
      sectionId: GridSectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SectionCreated applies to.
        }
      }
    } with {
      briefly "Persist SectionCreated"
      described as {
        |Instructs this repository to apply SectionCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSwitchingExecuted is {
      sectionId: GridSectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SwitchingExecuted applies to.
        }
      }
    } with {
      briefly "Persist SwitchingExecuted"
      described as {
        |Instructs this repository to apply SwitchingExecuted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLoadRecorded is {
      sectionId: GridSectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row LoadRecorded applies to.
        }
      }
    } with {
      briefly "Persist LoadRecorded"
      described as {
        |Instructs this repository to apply LoadRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceRestored is {
      sectionId: GridSectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceRestored applies to.
        }
      }
    } with {
      briefly "Persist ServiceRestored"
      described as {
        |Instructs this repository to apply ServiceRestored to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet GridRepositoryResponses is result GridSection.GridSectionResult
    record StoredGridSection is {
      gridSectionId: GridSectionId with {
        briefly "gridSectionId"
        described as {
          |The gridSectionId column of the stored gridSection row.
        }
      }
      sectionId: GridSectionId with {
        briefly "sectionId"
        described as {
          |The sectionId column of the stored gridSection row.
        }
      }
      status: OutageStatus with {
        briefly "status"
        described as {
          |The status column of the stored gridSection row.
        }
      }
      substationId: SubstationId with {
        briefly "substationId"
        described as {
          |The substationId column of the stored gridSection row.
        }
      }
    } with {
      briefly "Stored gridSection row"
      described as {
        |The persistence shape of gridSection data as this repository stores it.
      }
    }
    schema GridData is relational
      of gridSections as record StoredGridSection
        index on field StoredGridSection.sectionId
        index on field StoredGridSection.substationId
        index on field StoredGridSection.status
 with {
      briefly "Grid data schema"
      described as {
        |The relational schema holding grid data for the GridRepository.
      }
    }
    handler GridPersistence is {
      on persistCrewDispatched: command PersistCrewDispatched is {
        do "apply CrewDispatched to the stored row"
      }
      on persistMaintenanceModeSet: command PersistMaintenanceModeSet is {
        do "apply MaintenanceModeSet to the stored row"
      }
      on persistOutageReported: command PersistOutageReported is {
        do "apply OutageReported to the stored row"
      }
      on persistOutageStatusUpdated: command PersistOutageStatusUpdated is {
        do "apply OutageStatusUpdated to the stored row"
      }
      on persistReturnedToService: command PersistReturnedToService is {
        do "apply ReturnedToService to the stored row"
      }
      on persistSectionCreated: command PersistSectionCreated is {
        do "apply SectionCreated to the stored row"
      }
      on persistSwitchingExecuted: command PersistSwitchingExecuted is {
        do "apply SwitchingExecuted to the stored row"
      }
      on persistLoadRecorded: command PersistLoadRecorded is {
        do "apply LoadRecorded to the stored row"
      }
      on persistServiceRestored: command PersistServiceRestored is {
        do "apply ServiceRestored to the stored row"
      }
      on query GetReliabilityMetrics is {
        let reliabilityMetricsView: type ReliabilityMetricsView = prompt("read the reliability metrics projection")
        reply reliabilityMetricsView
      }
      on query GetLoadProfile is {
        let loadProfileView: type LoadProfileView = prompt("read the load profile projection")
        reply loadProfileView
      }
    } with {
      briefly "Persists grid commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Grid data persistence"
    described as {
      |Persistent storage for grid operations.
    }
  }
  query GetReliabilityMetrics replies result ReliabilityMetricsView is {
    reliabilityMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which reliability metrics to retrieve.
      }
    }
  } with {
    briefly "Get reliability metrics"
    described as {
      |Retrieves the reliability metrics projection.
    }
  }
  result ReliabilityMetricsView is {
    reliabilityMetrics: GridAnalytics.ReliabilityMetrics with {
      briefly "Reliability metrics"
      described as {
        |The reliability metrics being returned.
      }
    }
  } with {
    briefly "Reliability metrics view"
    described as {
      |Read model view carrying the reliability metrics projection.
    }
  }
  query GetLoadProfile replies result LoadProfileView is {
    loadProfileKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which load profile to retrieve.
      }
    }
  } with {
    briefly "Get load profile"
    described as {
      |Retrieves the load profile projection.
    }
  }
  result LoadProfileView is {
    loadProfile: GridAnalytics.LoadProfile with {
      briefly "Load profile"
      described as {
        |The load profile being returned.
      }
    }
  } with {
    briefly "Load profile view"
    described as {
      |Read model view carrying the load profile projection.
    }
  }
  projector GridAnalytics as flow is {
    updates repository GridContext.GridRepository
    outlet GridAnalyticsToRepository is type GridRepositoryCommand
    inlet GridAnalyticsFromGridSection is type GridSectionEvent    record ReliabilityMetrics is {
      saidi: Decimal(8,2) with {
        briefly "SAIDI"
        described as {
          |System average interruption duration index.
        }
      }
      saifi: Decimal(6,4) with {
        briefly "SAIFI"
        described as {
          |System average interruption frequency index.
        }
      }
      caidi: Decimal(8,2) with {
        briefly "CAIDI"
        described as {
          |Customer average interruption duration.
        }
      }
      asai: Decimal(7,5) with {
        briefly "ASAI"
        described as {
          |Average service availability index.
        }
      }
    } with {
      briefly "Reliability metrics"
      described as {
        |Grid reliability indices.
      }
    }
    record LoadProfile is {
      peakLoadMW: Decimal(10,2) with {
        briefly "Peak"
        described as {
          |Peak load MW.
        }
      }
      averageLoadMW: Decimal(10,2) with {
        briefly "Average"
        described as {
          |Average load MW.
        }
      }
      loadFactor: Decimal(5,4) with {
        briefly "Load factor"
        described as {
          |Load factor.
        }
      }
    } with {
      briefly "Load profile"
      described as {
        |Load profile metrics.
      }
    }
    handler AnalyticsHandler is {
      on crewDispatched: event GridSection.CrewDispatched is {
        tell command GridContext.GridRepository.PersistCrewDispatched(sectionId = crewDispatched.sectionId) to repository GridContext.GridRepository
        do "apply CrewDispatched to the GridAnalytics projection"
      }
      on maintenanceModeSet: event GridSection.MaintenanceModeSet is {
        tell command GridContext.GridRepository.PersistMaintenanceModeSet(sectionId = maintenanceModeSet.sectionId) to repository GridContext.GridRepository
        do "apply MaintenanceModeSet to the GridAnalytics projection"
      }
      on outageReported: event GridSection.OutageReported is {
        tell command GridContext.GridRepository.PersistOutageReported(sectionId = outageReported.sectionId) to repository GridContext.GridRepository
        do "apply OutageReported to the GridAnalytics projection"
      }
      on outageStatusUpdated: event GridSection.OutageStatusUpdated is {
        tell command GridContext.GridRepository.PersistOutageStatusUpdated(sectionId = outageStatusUpdated.sectionId) to repository GridContext.GridRepository
        do "apply OutageStatusUpdated to the GridAnalytics projection"
      }
      on returnedToService: event GridSection.ReturnedToService is {
        tell command GridContext.GridRepository.PersistReturnedToService(sectionId = returnedToService.sectionId) to repository GridContext.GridRepository
        do "apply ReturnedToService to the GridAnalytics projection"
      }
      on sectionCreated: event GridSection.SectionCreated is {
        tell command GridContext.GridRepository.PersistSectionCreated(sectionId = sectionCreated.sectionId) to repository GridContext.GridRepository
        do "apply SectionCreated to the GridAnalytics projection"
      }
      on switchingExecuted: event GridSection.SwitchingExecuted is {
        tell command GridContext.GridRepository.PersistSwitchingExecuted(sectionId = switchingExecuted.sectionId) to repository GridContext.GridRepository
        do "apply SwitchingExecuted to the GridAnalytics projection"
      }
      on loadRecorded: event GridSection.LoadRecorded is {
        tell command GridContext.GridRepository.PersistLoadRecorded(sectionId = loadRecorded.sectionId) to repository GridContext.GridRepository
        do "Update load analytics"
      }
      on serviceRestored: event GridSection.ServiceRestored is {
        tell command GridContext.GridRepository.PersistServiceRestored(sectionId = serviceRestored.sectionId) to repository GridContext.GridRepository
        do "Calculate reliability metrics"
      }
    } with {
      briefly "Maintains grid analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Grid analytics"
    described as {
      |Grid performance analytics.
    }
  }
  // ---- Event publication for GridSection ----
  type GridSectionEvent is one of {
    GridContext.GridSection.SectionCreated or GridContext.GridSection.LoadRecorded or GridContext.GridSection.OutageReported or GridContext.GridSection.CrewDispatched or GridContext.GridSection.OutageStatusUpdated or GridContext.GridSection.ServiceRestored or GridContext.GridSection.SwitchingExecuted or GridContext.GridSection.MaintenanceModeSet or GridContext.GridSection.ReturnedToService
  } with {
    briefly "GridSection event alternation"
    described as {
      |Union of all GridSection events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet GridSectionEventSplit as flow is {
    inlet GridSectionEventSplitIn is type GridSectionEvent    outlet GridSectionEventSplitToGridAnalytics is type GridSectionEvent
    handler GridSectionEventSplitHandler is {
      on sectionCreated: event GridSection.SectionCreated is {
        send sectionCreated to outlet GridSectionEventSplitToGridAnalytics
        tell sectionCreated to entity GridContext.GridSection
      }
      on loadRecorded: event GridSection.LoadRecorded is {
        send loadRecorded to outlet GridSectionEventSplitToGridAnalytics
        tell loadRecorded to entity GridContext.GridSection
      }
      on outageReported: event GridSection.OutageReported is {
        send outageReported to outlet GridSectionEventSplitToGridAnalytics
        tell outageReported to entity GridContext.GridSection
      }
      on crewDispatched: event GridSection.CrewDispatched is {
        send crewDispatched to outlet GridSectionEventSplitToGridAnalytics
        tell crewDispatched to entity GridContext.GridSection
      }
      on outageStatusUpdated: event GridSection.OutageStatusUpdated is {
        send outageStatusUpdated to outlet GridSectionEventSplitToGridAnalytics
        tell outageStatusUpdated to entity GridContext.GridSection
      }
      on serviceRestored: event GridSection.ServiceRestored is {
        send serviceRestored to outlet GridSectionEventSplitToGridAnalytics
        tell serviceRestored to entity GridContext.GridSection
      }
      on switchingExecuted: event GridSection.SwitchingExecuted is {
        send switchingExecuted to outlet GridSectionEventSplitToGridAnalytics
        tell switchingExecuted to entity GridContext.GridSection
      }
      on maintenanceModeSet: event GridSection.MaintenanceModeSet is {
        send maintenanceModeSet to outlet GridSectionEventSplitToGridAnalytics
        tell maintenanceModeSet to entity GridContext.GridSection
      }
      on returnedToService: event GridSection.ReturnedToService is {
        send returnedToService to outlet GridSectionEventSplitToGridAnalytics
        tell returnedToService to entity GridContext.GridSection
      }
      on other is {
        error "Unexpected message for processor GridSectionEventSplit"
      }
    } with {
      briefly "GridSection event fan-out handler"
      described as {
        |Delivers each GridSection event to all of its consumers.
      }
    }
  } with {
    briefly "GridSection event fan-out"
    described as {
      |Fans GridSection events out to the repository and projectors.
    }
  }
  connector 'GridSectionEvent Stream' is from outlet GridContext.GridSection.GridSectionEvents2 to inlet GridContext.GridSectionEventSplit.GridSectionEventSplitIn with {
    briefly "GridSection events, fanned out to storage and read models"
  }
  connector 'GridAnalytics Feed' is from outlet GridContext.GridSectionEventSplit.GridSectionEventSplitToGridAnalytics to inlet GridContext.GridAnalytics.GridAnalyticsFromGridSection with {
    briefly "GridSection events feeding the GridAnalytics projection"
  }
  connector 'GridAnalytics Storage' is from outlet GridContext.GridAnalytics.GridAnalyticsToRepository to inlet GridContext.GridRepository.GridRepositoryFromGridAnalytics with {
    briefly "GridAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for grid operations"
  described as {
    |Electric grid management context.
  }
}
