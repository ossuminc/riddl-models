// Outage Management - Outage Context
context OutageContext is {
  include "types.riddl"
  include "OutageEvent.riddl"
  repository OutageRepository is {
    schema OutageData is relational
      of outageEvents as type OutageEvent
        index on field OutageEvent.outageId
        index on field OutageEvent.outageInfo.feederId
        index on field OutageEvent.status

    handler OutagePersistence is {
      on command OutageEvent.ReportOutage is {
        prompt "Store new outage event"
      }
      on command OutageEvent.ConfirmOutage is {
        tell event OutageEvent.OutageConfirmed to entity OutageContext.OutageEvent
        prompt "Update outage to confirmed"
      }
      on command OutageEvent.DispatchCrew is {
        prompt "Store crew dispatch record"
      }
      on command OutageEvent.RestorePower is {
        prompt "Update outage to restored"
      }
      on command OutageEvent.CloseOutage is {
        tell event OutageEvent.OutageClosed to entity OutageContext.OutageEvent
        prompt "Update outage to closed with analysis"
      }
    } with {
      briefly "Persists outage commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Outage data persistence"
    described as {
      |Persistent storage for outage events.
    }
  }
  projector OutageMetrics is {
    updates repository OutageContext.OutageRepository
    record OutageMetricsData is  {
      outagesReported: Natural with {
        briefly "Reported"
        described as {
          |Outages reported.
        }
      }
      outagesRestored: Natural with {
        briefly "Restored"
        described as {
          |Outages restored.
        }
      }
      outagesCancelled: Natural with {
        briefly "Cancelled"
        described as {
          |Outages cancelled.
        }
      }
      averageRestorationTime: Decimal(8,2) with {
        briefly "Avg time"
        described as {
          |Average restoration time in minutes.
        }
      }
    } with {
      briefly "Outage metrics"
      described as {
        |Outage processing metrics.
      }
    }
    handler MetricsHandler is {
      on event OutageEvent.OutageReported is {
        tell event OutageEvent.OutageReported to repository OutageContext.OutageRepository
        prompt "Increment outages reported"
      }
      on event OutageEvent.PowerRestored is {
        tell event OutageEvent.PowerRestored to repository OutageContext.OutageRepository
        prompt "Increment outages restored and calculate restoration time"
      }
      on event OutageEvent.OutageCancelled is {
        tell event OutageEvent.OutageCancelled to repository OutageContext.OutageRepository
        prompt "Increment outages cancelled"
      }
    } with {
      briefly "Maintains outage metrics"
      described as {
        |Projects events into outage metrics.
      }
    }
  } with {
    briefly "Outage metrics"
    described as {
      |Outage management analytics.
    }
  }
  // ---- Event publication for OutageEvent ----
  type OutageEventEvent is one of {
    OutageContext.OutageEvent.OutageReported,
    OutageContext.OutageEvent.OutageConfirmed,
    OutageContext.OutageEvent.CrewDispatched,
    OutageContext.OutageEvent.CrewArrived,
    OutageContext.OutageEvent.RestorationStarted,
    OutageContext.OutageEvent.RestorationStepCompleted,
    OutageContext.OutageEvent.PowerRestored,
    OutageContext.OutageEvent.CustomersNotified,
    OutageContext.OutageEvent.OutageClosed,
    OutageContext.OutageEvent.OutageCancelled
  } with {
    briefly "OutageEvent event alternation"
    described as {
      |Union of all OutageEvent events, for streaming and event-sourced
      |persistence.
    }
  }
  source OutageEventEventSource is {
    outlet OutageEventEvents is type OutageEventEvent
    handler OutageEventSourceHandler is {
      on event OutageEvent.OutageReported is {
        send event OutageEvent.OutageReported to outlet OutageEventEvents
      }
      on event OutageEvent.OutageConfirmed is {
        send event OutageEvent.OutageConfirmed to outlet OutageEventEvents
      }
      on event OutageEvent.CrewDispatched is {
        send event OutageEvent.CrewDispatched to outlet OutageEventEvents
      }
      on event OutageEvent.CrewArrived is {
        send event OutageEvent.CrewArrived to outlet OutageEventEvents
      }
      on event OutageEvent.RestorationStarted is {
        send event OutageEvent.RestorationStarted to outlet OutageEventEvents
      }
      on event OutageEvent.RestorationStepCompleted is {
        send event OutageEvent.RestorationStepCompleted to outlet OutageEventEvents
      }
      on event OutageEvent.PowerRestored is {
        send event OutageEvent.PowerRestored to outlet OutageEventEvents
      }
      on event OutageEvent.CustomersNotified is {
        send event OutageEvent.CustomersNotified to outlet OutageEventEvents
      }
      on event OutageEvent.OutageClosed is {
        send event OutageEvent.OutageClosed to outlet OutageEventEvents
      }
      on event OutageEvent.OutageCancelled is {
        send event OutageEvent.OutageCancelled to outlet OutageEventEvents
      }
      on other is {
        error "Unexpected message for source OutageEventEventSource"
      }
    } with {
      briefly "OutageEvent source handler"
      described as {
        |Publishes OutageEvent events onto the outlet.
      }
    }
  } with {
    briefly "OutageEvent event source"
    described as {
      |Publishes OutageEvent entity events into the streaming topology.
    }
  }
  sink OutageEventEventSink is {
    inlet OutageEventInlet is type OutageEventEvent
    handler OutageEventSinkHandler is {
      on event OutageEvent.OutageReported is {
        tell event OutageEvent.OutageReported to repository OutageContext.OutageRepository
      }
      on event OutageEvent.OutageConfirmed is {
        tell event OutageEvent.OutageConfirmed to repository OutageContext.OutageRepository
      }
      on event OutageEvent.CrewDispatched is {
        tell event OutageEvent.CrewDispatched to repository OutageContext.OutageRepository
      }
      on event OutageEvent.CrewArrived is {
        tell event OutageEvent.CrewArrived to repository OutageContext.OutageRepository
      }
      on event OutageEvent.RestorationStarted is {
        tell event OutageEvent.RestorationStarted to repository OutageContext.OutageRepository
      }
      on event OutageEvent.RestorationStepCompleted is {
        tell event OutageEvent.RestorationStepCompleted to repository OutageContext.OutageRepository
      }
      on event OutageEvent.PowerRestored is {
        tell event OutageEvent.PowerRestored to repository OutageContext.OutageRepository
      }
      on event OutageEvent.CustomersNotified is {
        tell event OutageEvent.CustomersNotified to repository OutageContext.OutageRepository
      }
      on event OutageEvent.OutageClosed is {
        tell event OutageEvent.OutageClosed to repository OutageContext.OutageRepository
      }
      on event OutageEvent.OutageCancelled is {
        tell event OutageEvent.OutageCancelled to repository OutageContext.OutageRepository
      }
      on other is {
        error "Unexpected message for sink OutageEventEventSink"
      }
    } with {
      briefly "OutageEvent sink handler"
      described as {
        |Persists OutageEvent events via the repository.
      }
    }
  } with {
    briefly "OutageEvent event sink"
    described as {
      |Receives OutageEvent events for persistence.
    }
  }
  connector OutageEventEventFlow is {
    from outlet OutageContext.OutageEventEventSource.OutageEventEvents to
      inlet OutageContext.OutageEventEventSink.OutageEventInlet
  } with {
    briefly "OutageEvent event flow"
    described as {
      |Connects the OutageEvent source to its sink.
    }
  }
} with {
  briefly "Bounded context for outage management"
  described as {
    |Electric utility outage management context.
  }
}
