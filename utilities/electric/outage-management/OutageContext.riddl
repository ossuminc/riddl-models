// Outage Management - Outage Context
context OutageContext as router is {
  inlet OutageContextFromToCrewDispatchSystem is command OutageEvent.DispatchCrew with {
    briefly "What ToCrewDispatchSystem makes of the answers it gets"
  }
  connector 'ToCrewDispatchSystem Intake' is from outlet OutageContext.ToCrewDispatchSystem.ToCrewDispatchSystemToOutageContext to inlet OutageContext.OutageContextFromToCrewDispatchSystem with {
    briefly "Answers translated by ToCrewDispatchSystem, on their way in"
  }
  inlet OutageContextFromToSCADASystem is command OutageEvent.ConfirmOutage with {
    briefly "What ToSCADASystem makes of the answers it gets"
  }
  connector 'ToSCADASystem Intake' is from outlet OutageContext.ToSCADASystem.ToSCADASystemToOutageContext to inlet OutageContext.OutageContextFromToSCADASystem with {
    briefly "Answers translated by ToSCADASystem, on their way in"
  }
  inlet OutageContextFromCrewDispatchSystem is command OutageEvent.DispatchCrew with {
    briefly "What FromCrewDispatchSystem makes of that service's news"
  }
  connector 'FromCrewDispatchSystem Intake' is from outlet OutageContext.FromCrewDispatchSystem.FromCrewDispatchSystemToOutageContext to inlet OutageContext.OutageContextFromCrewDispatchSystem with {
    briefly "What FromCrewDispatchSystem makes of that news, on its way in"
  }
  inlet OutageContextFromSCADASystem is command OutageEvent.ReportOutage with {
    briefly "What FromSCADASystem makes of that service's news"
  }
  connector 'FromSCADASystem Intake' is from outlet OutageContext.FromSCADASystem.FromSCADASystemToOutageContext to inlet OutageContext.OutageContextFromSCADASystem with {
    briefly "What FromSCADASystem makes of that news, on its way in"
  }
  inlet OutageEventCommandStreamIn is type OutageEventCommand  outlet OutageEventCommandStreamOut is type OutageEventCommand
  inlet OutageEventResultStreamIn is result OutageEvent.OutageEventResult  outlet OutageEventResultStreamOut is result OutageEvent.OutageEventResult
  handler OutageContextBoundary is {
    on reportOutage: command OutageEvent.ReportOutage is {
      send reportOutage to outlet OutageContext.OutageEventCommandStreamOut
    }
    on confirmOutage: command OutageEvent.ConfirmOutage is {
      send confirmOutage to outlet OutageContext.OutageEventCommandStreamOut
    }
    on dispatchCrew: command OutageEvent.DispatchCrew is {
      send dispatchCrew to outlet OutageContext.OutageEventCommandStreamOut
    }
    on recordCrewArrival: command OutageEvent.RecordCrewArrival is {
      send recordCrewArrival to outlet OutageContext.OutageEventCommandStreamOut
    }
    on beginRestoration: command OutageEvent.BeginRestoration is {
      send beginRestoration to outlet OutageContext.OutageEventCommandStreamOut
    }
    on completeRestorationStep: command OutageEvent.CompleteRestorationStep is {
      send completeRestorationStep to outlet OutageContext.OutageEventCommandStreamOut
    }
    on restorePower: command OutageEvent.RestorePower is {
      send restorePower to outlet OutageContext.OutageEventCommandStreamOut
    }
    on notifyCustomers: command OutageEvent.NotifyCustomers is {
      send notifyCustomers to outlet OutageContext.OutageEventCommandStreamOut
    }
    on closeOutage: command OutageEvent.CloseOutage is {
      send closeOutage to outlet OutageContext.OutageEventCommandStreamOut
    }
    on cancelOutage: command OutageEvent.CancelOutage is {
      send cancelOutage to outlet OutageContext.OutageEventCommandStreamOut
    }
    on outageEventResult: result OutageEvent.OutageEventResult is {
      send outageEventResult to outlet OutageContext.OutageEventResultStreamOut
    }
    on other is {
      error "Unexpected message at the OutageContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'OutageEventCommand Stream Intake' is from outlet OutageContext.OutageEventCommandStreamOut to inlet OutageContext.OutageEvent.OutageEventCommands  connector 'OutageEventResult Stream Egress' is from outlet OutageContext.OutageRepository.OutageRepositoryResponses to inlet OutageContext.OutageEventResultStreamIn  adaptor FromCrewDispatchSystem from context CrewDispatchSystem as flow is { 
    inlet FromCrewDispatchSystemIn is type CrewDispatchSystem.CrewDispatchSystemEvent    outlet FromCrewDispatchSystemToOutageContext is command OutageEvent.DispatchCrew
    handler FromCrewDispatchSystemHandler is {
      on crewAssigned: event CrewDispatchSystem.CrewAssigned is {
        let item0: type OutageEvent.DispatchCrew = prompt("translate the crewAssigned event into a DispatchCrew, the crew dispatch assigns is the one the outage records as dispatched")
        send item0 to outlet OutageContext.FromCrewDispatchSystem.FromCrewDispatchSystemToOutageContext
      }
      on crewReleased: event CrewDispatchSystem.CrewReleased is {
        do "the crew is free; restoring power was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromCrewDispatchSystem"
      }
    } with {
      briefly "from crew dispatch system"
      described as {
        |Carries messages from the external CrewDispatchSystem.
      }
    }
  } with {
    briefly "CrewDispatchSystem integration"
    described as {
      |The model's side of the CrewDispatchSystem conversation.
    }
  }
  adaptor ToCrewDispatchSystem to context CrewDispatchSystem as router is { 
    outlet ToCrewDispatchSystemToOutageContext is command OutageEvent.DispatchCrew
    inlet ToCrewDispatchSystemIn is type OutageEventEvent    inlet ToCrewDispatchSystemReplies is result CrewDispatchSystem.AvailableCrews    outlet ToCrewDispatchSystemOut is type CrewDispatchSystem.CrewDispatchSystemCommand
    handler ToCrewDispatchSystemHandler is {
      on outageConfirmed: event OutageEvent.OutageConfirmed is {
        let askAnswer: type CrewDispatchSystem.AvailableCrews = ask query CrewDispatchSystem.GetAvailableCrews of context CrewDispatchSystem
        do "a confirmed outage needing a crew who can be sent"
        when prompt("askAnswer.crews is not empty") then
          send command OutageEvent.DispatchCrew(outageId = outageConfirmed.outageId, assignment = prompt("the first of askAnswer.crews, arriving in askAnswer.estimatedArrival")) to outlet OutageContext.ToCrewDispatchSystem.ToCrewDispatchSystemToOutageContext
        end
        let notice: type CrewDispatchSystem.AssignCrew = prompt("translate the outageConfirmed event into an AssignCrew sending a gang to a fault now known to be real")
        send notice to outlet OutageContext.ToCrewDispatchSystem.ToCrewDispatchSystemOut
      }
      on powerRestored: event OutageEvent.PowerRestored is {
        let release: type CrewDispatchSystem.ReleaseCrew = prompt("translate the powerRestored event into a ReleaseCrew freeing the gang for the next job")
        send release to outlet OutageContext.ToCrewDispatchSystem.ToCrewDispatchSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToCrewDispatchSystem"
      }
    } with {
      briefly "to crew dispatch system"
      described as {
        |Carries messages to the external CrewDispatchSystem.
      }
    }
  } with {
    briefly "CrewDispatchSystem integration"
    described as {
      |The model's side of the CrewDispatchSystem conversation.
    }
  }
  adaptor FromSCADASystem from context SCADASystem as flow is { 
    inlet FromSCADASystemIn is type SCADASystem.SCADASystemEvent    outlet FromSCADASystemToOutageContext is command OutageEvent.ReportOutage
    handler FromSCADASystemHandler is {
      on feederIsolated: event SCADASystem.FeederIsolated is {
        do "the feeder is isolated; confirming the outage was recorded here and restoration follows"
      }
      on outageDetected: event SCADASystem.OutageDetected is {
        let item0: type OutageEvent.ReportOutage = prompt("translate the outageDetected event into a ReportOutage, an outage SCADA detects is reported by the instrument that saw it")
        send item0 to outlet OutageContext.FromSCADASystem.FromSCADASystemToOutageContext
      }
      on other is {
        error "Unexpected message for adaptor FromSCADASystem"
      }
    } with {
      briefly "from scada system"
      described as {
        |Carries messages from the external SCADASystem.
      }
    }
  } with {
    briefly "SCADASystem integration"
    described as {
      |The model's side of the SCADASystem conversation.
    }
  }
  adaptor ToSCADASystem to context SCADASystem as router is { 
    outlet ToSCADASystemToOutageContext is command OutageEvent.ConfirmOutage
    inlet ToSCADASystemIn is type OutageEventEvent    inlet ToSCADASystemReplies is result SCADASystem.FeederStatus    outlet ToSCADASystemOut is type SCADASystem.SCADASystemRequest
    handler ToSCADASystemHandler is {
      on outageReported: event OutageEvent.OutageReported is {
        let askAnswer: type SCADASystem.FeederStatus = ask query SCADASystem.GetFeederStatus of context SCADASystem
        do "a reported outage needing the feeder's own state before a crew is sent"
        when prompt("askAnswer.feederStatus confirms the outage") then
          send command OutageEvent.ConfirmOutage(outageId = outageReported.outageId, confirmedBy = prompt("SCADA"), cause = prompt("feeder askAnswer.feederStatus at askAnswer.voltage volts")) to outlet OutageContext.ToSCADASystem.ToSCADASystemToOutageContext
        end
      }
      on outageConfirmed: event OutageEvent.OutageConfirmed is {
        let item0: type SCADASystem.IsolateFeeder = prompt("translate the outageConfirmed event into a IsolateFeeder, a confirmed outage needing the feeder isolated before crews approach")
        send item0 to outlet OutageContext.ToSCADASystem.ToSCADASystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToSCADASystem"
      }
    } with {
      briefly "to scada system"
      described as {
        |Carries messages to the external SCADASystem.
      }
    }
  } with {
    briefly "SCADASystem integration"
    described as {
      |The model's side of the SCADASystem conversation.
    }
  }
  include "types.riddl"
  include "OutageEvent.riddl"
  type OutageRepositoryCommand is one of {
    OutageContext.OutageRepository.PersistCrewArrived or OutageContext.OutageRepository.PersistCrewDispatched or OutageContext.OutageRepository.PersistCustomersNotified or OutageContext.OutageRepository.PersistOutageCancelled or OutageContext.OutageRepository.PersistOutageClosed or OutageContext.OutageRepository.PersistOutageConfirmed or OutageContext.OutageRepository.PersistOutageReported or OutageContext.OutageRepository.PersistPowerRestored or OutageContext.OutageRepository.PersistRestorationStarted or OutageContext.OutageRepository.PersistRestorationStepCompleted
  } with {
    briefly "Anything that writes OutageRepository"
    described as {
      |The persistence commands OutageRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository OutageRepository as flow is {
    inlet OutageRepositoryFromOutageMetrics is type OutageRepositoryCommand    command PersistCrewArrived is {
      outageId: OutageEventId with {
        briefly "Row addressed"
        described as {
          |Which stored row CrewArrived applies to.
        }
      }
    } with {
      briefly "Persist CrewArrived"
      described as {
        |Instructs this repository to apply CrewArrived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCrewDispatched is {
      outageId: OutageEventId with {
        briefly "Row addressed"
        described as {
          |Which stored row CrewDispatched applies to.
        }
      }
    } with {
      briefly "Persist CrewDispatched"
      described as {
        |Instructs this repository to apply CrewDispatched to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCustomersNotified is {
      outageId: OutageEventId with {
        briefly "Row addressed"
        described as {
          |Which stored row CustomersNotified applies to.
        }
      }
    } with {
      briefly "Persist CustomersNotified"
      described as {
        |Instructs this repository to apply CustomersNotified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOutageClosed is {
      outageId: OutageEventId with {
        briefly "Row addressed"
        described as {
          |Which stored row OutageClosed applies to.
        }
      }
    } with {
      briefly "Persist OutageClosed"
      described as {
        |Instructs this repository to apply OutageClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOutageConfirmed is {
      outageId: OutageEventId with {
        briefly "Row addressed"
        described as {
          |Which stored row OutageConfirmed applies to.
        }
      }
    } with {
      briefly "Persist OutageConfirmed"
      described as {
        |Instructs this repository to apply OutageConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRestorationStarted is {
      outageId: OutageEventId with {
        briefly "Row addressed"
        described as {
          |Which stored row RestorationStarted applies to.
        }
      }
    } with {
      briefly "Persist RestorationStarted"
      described as {
        |Instructs this repository to apply RestorationStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRestorationStepCompleted is {
      outageId: OutageEventId with {
        briefly "Row addressed"
        described as {
          |Which stored row RestorationStepCompleted applies to.
        }
      }
    } with {
      briefly "Persist RestorationStepCompleted"
      described as {
        |Instructs this repository to apply RestorationStepCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOutageCancelled is {
      outageId: OutageEventId with {
        briefly "Row addressed"
        described as {
          |Which stored row OutageCancelled applies to.
        }
      }
    } with {
      briefly "Persist OutageCancelled"
      described as {
        |Instructs this repository to apply OutageCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOutageReported is {
      outageId: OutageEventId with {
        briefly "Row addressed"
        described as {
          |Which stored row OutageReported applies to.
        }
      }
    } with {
      briefly "Persist OutageReported"
      described as {
        |Instructs this repository to apply OutageReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPowerRestored is {
      outageId: OutageEventId with {
        briefly "Row addressed"
        described as {
          |Which stored row PowerRestored applies to.
        }
      }
    } with {
      briefly "Persist PowerRestored"
      described as {
        |Instructs this repository to apply PowerRestored to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet OutageRepositoryResponses is result OutageEvent.OutageEventResult
    record StoredOutageEvent is {
      outageEventId: OutageEventId with {
        briefly "outageEventId"
        described as {
          |The outageEventId column of the stored outageEvent row.
        }
      }
      outageId: OutageEventId with {
        briefly "outageId"
        described as {
          |The outageId column of the stored outageEvent row.
        }
      }
      outageInfo: OutageInfo with {
        briefly "outageInfo"
        described as {
          |The outageInfo column of the stored outageEvent row.
        }
      }
      status: OutageStatus with {
        briefly "status"
        described as {
          |The status column of the stored outageEvent row.
        }
      }
    } with {
      briefly "Stored outageEvent row"
      described as {
        |The persistence shape of outageEvent data as this repository stores it.
      }
    }
    schema OutageData is relational
      of outageEvents as record StoredOutageEvent
        index on field StoredOutageEvent.outageId
        index on field StoredOutageEvent.outageInfo.feederId
        index on field StoredOutageEvent.status
 with {
      briefly "Outage data schema"
      described as {
        |The relational schema holding outage data for the OutageRepository.
      }
    }
    handler OutagePersistence is {
      on persistCrewArrived: command PersistCrewArrived is {
        do "apply CrewArrived to the stored row"
      }
      on persistCrewDispatched: command PersistCrewDispatched is {
        do "apply CrewDispatched to the stored row"
      }
      on persistCustomersNotified: command PersistCustomersNotified is {
        do "apply CustomersNotified to the stored row"
      }
      on persistOutageClosed: command PersistOutageClosed is {
        do "apply OutageClosed to the stored row"
      }
      on persistOutageConfirmed: command PersistOutageConfirmed is {
        do "apply OutageConfirmed to the stored row"
      }
      on persistRestorationStarted: command PersistRestorationStarted is {
        do "apply RestorationStarted to the stored row"
      }
      on persistRestorationStepCompleted: command PersistRestorationStepCompleted is {
        do "apply RestorationStepCompleted to the stored row"
      }
      on persistOutageCancelled: command PersistOutageCancelled is {
        do "apply OutageCancelled to the stored row"
      }
      on persistOutageReported: command PersistOutageReported is {
        do "apply OutageReported to the stored row"
      }
      on persistPowerRestored: command PersistPowerRestored is {
        do "apply PowerRestored to the stored row"
      }
      on query GetOutageMetricsData is {
        let outageMetricsDataView: type OutageMetricsDataView = prompt("read the outage metrics data projection")
        reply outageMetricsDataView
      }
    } with {
      briefly "Persists outage commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Outage data persistence"
    described as {
      |Persistent storage for outage events.
    }
  }
  query GetOutageMetricsData replies result OutageMetricsDataView is {
    outageMetricsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which outage metrics data to retrieve.
      }
    }
  } with {
    briefly "Get outage metrics data"
    described as {
      |Retrieves the outage metrics data projection.
    }
  }
  result OutageMetricsDataView is {
    outageMetricsData: OutageMetrics.OutageMetricsData with {
      briefly "Outage metrics data"
      described as {
        |The outage metrics data being returned.
      }
    }
  } with {
    briefly "Outage metrics data view"
    described as {
      |Read model view carrying the outage metrics data projection.
    }
  }
  projector OutageMetrics as flow is {
    updates repository OutageContext.OutageRepository
    outlet OutageMetricsToRepository is type OutageRepositoryCommand
    inlet OutageMetricsFromOutageEvent is type OutageEventEvent    record OutageMetricsData is {
      outagesReported: Natural with {
        briefly "Reported"
        described as {
          |Outages reported.
        }
      }
      outagesRestored: Natural with {
        briefly "Restored"
        described as {
          |Outages restored.
        }
      }
      outagesCancelled: Natural with {
        briefly "Cancelled"
        described as {
          |Outages cancelled.
        }
      }
      averageRestorationTime: Decimal(8,2) with {
        briefly "Avg time"
        described as {
          |Average restoration time in minutes.
        }
      }
    } with {
      briefly "Outage metrics"
      described as {
        |Outage processing metrics.
      }
    }
    handler MetricsHandler is {
      on crewArrived: event OutageEvent.CrewArrived is {
        tell command OutageContext.OutageRepository.PersistCrewArrived(outageId = crewArrived.outageId) to repository OutageContext.OutageRepository
        do "apply CrewArrived to the OutageMetrics projection"
      }
      on crewDispatched: event OutageEvent.CrewDispatched is {
        tell command OutageContext.OutageRepository.PersistCrewDispatched(outageId = crewDispatched.outageId) to repository OutageContext.OutageRepository
        do "apply CrewDispatched to the OutageMetrics projection"
      }
      on customersNotified: event OutageEvent.CustomersNotified is {
        tell command OutageContext.OutageRepository.PersistCustomersNotified(outageId = customersNotified.outageId) to repository OutageContext.OutageRepository
        do "apply CustomersNotified to the OutageMetrics projection"
      }
      on outageClosed: event OutageEvent.OutageClosed is {
        tell command OutageContext.OutageRepository.PersistOutageClosed(outageId = outageClosed.outageId) to repository OutageContext.OutageRepository
        do "apply OutageClosed to the OutageMetrics projection"
      }
      on outageConfirmed: event OutageEvent.OutageConfirmed is {
        tell command OutageContext.OutageRepository.PersistOutageConfirmed(outageId = outageConfirmed.outageId) to repository OutageContext.OutageRepository
        do "apply OutageConfirmed to the OutageMetrics projection"
      }
      on restorationStarted: event OutageEvent.RestorationStarted is {
        tell command OutageContext.OutageRepository.PersistRestorationStarted(outageId = restorationStarted.outageId) to repository OutageContext.OutageRepository
        do "apply RestorationStarted to the OutageMetrics projection"
      }
      on restorationStepCompleted: event OutageEvent.RestorationStepCompleted is {
        tell command OutageContext.OutageRepository.PersistRestorationStepCompleted(outageId = restorationStepCompleted.outageId) to repository OutageContext.OutageRepository
        do "apply RestorationStepCompleted to the OutageMetrics projection"
      }
      on outageReported: event OutageEvent.OutageReported is {
        tell command OutageContext.OutageRepository.PersistOutageReported(outageId = outageReported.outageId) to repository OutageContext.OutageRepository
        do "Increment outages reported"
      }
      on powerRestored: event OutageEvent.PowerRestored is {
        tell command OutageContext.OutageRepository.PersistPowerRestored(outageId = powerRestored.outageId) to repository OutageContext.OutageRepository
        do "Increment outages restored and calculate restoration time"
      }
      on outageCancelled: event OutageEvent.OutageCancelled is {
        tell command OutageContext.OutageRepository.PersistOutageCancelled(outageId = outageCancelled.outageId) to repository OutageContext.OutageRepository
        do "Increment outages cancelled"
      }
    } with {
      briefly "Maintains outage metrics"
      described as {
        |Projects events into outage metrics.
      }
    }
  } with {
    briefly "Outage metrics"
    described as {
      |Outage management analytics.
    }
  }
  // ---- Event publication for OutageEvent ----
  type OutageEventEvent is one of {
    OutageContext.OutageEvent.OutageReported or OutageContext.OutageEvent.OutageConfirmed or OutageContext.OutageEvent.CrewDispatched or OutageContext.OutageEvent.CrewArrived or OutageContext.OutageEvent.RestorationStarted or OutageContext.OutageEvent.RestorationStepCompleted or OutageContext.OutageEvent.PowerRestored or OutageContext.OutageEvent.CustomersNotified or OutageContext.OutageEvent.OutageClosed or OutageContext.OutageEvent.OutageCancelled
  } with {
    briefly "OutageEvent event alternation"
    described as {
      |Union of all OutageEvent events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet OutageEventEventSplit as split is {
    outlet OutageEventEventSplitToToSCADASystem is type OutageEventEvent
    outlet OutageEventEventSplitToToCrewDispatchSystem is type OutageEventEvent
    inlet OutageEventEventSplitIn is type OutageEventEvent    outlet OutageEventEventSplitToOutageMetrics is type OutageEventEvent
    handler OutageEventEventSplitHandler is {
      on outageReported: event OutageEvent.OutageReported is {
        send outageReported to outlet OutageEventEventSplitToOutageMetrics
        send outageReported to outlet OutageEventEventSplitToToSCADASystem
        tell outageReported to entity OutageContext.OutageEvent
      }
      on outageConfirmed: event OutageEvent.OutageConfirmed is {
        send outageConfirmed to outlet OutageEventEventSplitToOutageMetrics
        send outageConfirmed to outlet OutageEventEventSplitToToSCADASystem
        send outageConfirmed to outlet OutageEventEventSplitToToCrewDispatchSystem
        tell outageConfirmed to entity OutageContext.OutageEvent
      }
      on crewDispatched: event OutageEvent.CrewDispatched is {
        send crewDispatched to outlet OutageEventEventSplitToOutageMetrics
        tell crewDispatched to entity OutageContext.OutageEvent
      }
      on crewArrived: event OutageEvent.CrewArrived is {
        send crewArrived to outlet OutageEventEventSplitToOutageMetrics
        tell crewArrived to entity OutageContext.OutageEvent
      }
      on restorationStarted: event OutageEvent.RestorationStarted is {
        send restorationStarted to outlet OutageEventEventSplitToOutageMetrics
        tell restorationStarted to entity OutageContext.OutageEvent
      }
      on restorationStepCompleted: event OutageEvent.RestorationStepCompleted is {
        send restorationStepCompleted to outlet OutageEventEventSplitToOutageMetrics
        tell restorationStepCompleted to entity OutageContext.OutageEvent
      }
      on powerRestored: event OutageEvent.PowerRestored is {
        send powerRestored to outlet OutageEventEventSplitToOutageMetrics
        send powerRestored to outlet OutageEventEventSplitToToCrewDispatchSystem
        tell powerRestored to entity OutageContext.OutageEvent
      }
      on customersNotified: event OutageEvent.CustomersNotified is {
        send customersNotified to outlet OutageEventEventSplitToOutageMetrics
        tell customersNotified to entity OutageContext.OutageEvent
      }
      on outageClosed: event OutageEvent.OutageClosed is {
        send outageClosed to outlet OutageEventEventSplitToOutageMetrics
        tell outageClosed to entity OutageContext.OutageEvent
      }
      on outageCancelled: event OutageEvent.OutageCancelled is {
        send outageCancelled to outlet OutageEventEventSplitToOutageMetrics
        tell outageCancelled to entity OutageContext.OutageEvent
      }
      on other is {
        error "Unexpected message for processor OutageEventEventSplit"
      }
    } with {
      briefly "OutageEvent event fan-out handler"
      described as {
        |Delivers each OutageEvent event to all of its consumers.
      }
    }
  } with {
    briefly "OutageEvent event fan-out"
    described as {
      |Fans OutageEvent events out to the repository and projectors.
    }
  }
  connector 'ToSCADASystem Feed' is from outlet OutageContext.OutageEventEventSplit.OutageEventEventSplitToToSCADASystem to inlet OutageContext.ToSCADASystem.ToSCADASystemIn with {
    briefly "The OutageEvent events ToSCADASystem translates, on their way to it"
  }
  connector 'ToCrewDispatchSystem Feed' is from outlet OutageContext.OutageEventEventSplit.OutageEventEventSplitToToCrewDispatchSystem to inlet OutageContext.ToCrewDispatchSystem.ToCrewDispatchSystemIn with {
    briefly "The OutageEvent events ToCrewDispatchSystem translates, on their way to it"
  }
  connector 'OutageEventEvent Stream' is from outlet OutageContext.OutageEvent.OutageEventEvents2 to inlet OutageContext.OutageEventEventSplit.OutageEventEventSplitIn with {
    briefly "OutageEvent events, fanned out to storage and read models"
  }
  connector 'OutageMetrics Feed' is from outlet OutageContext.OutageEventEventSplit.OutageEventEventSplitToOutageMetrics to inlet OutageContext.OutageMetrics.OutageMetricsFromOutageEvent with {
    briefly "OutageEvent events feeding the OutageMetrics projection"
  }
  connector 'OutageMetrics Storage' is from outlet OutageContext.OutageMetrics.OutageMetricsToRepository to inlet OutageContext.OutageRepository.OutageRepositoryFromOutageMetrics with {
    briefly "OutageMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for outage management"
  described as {
    |Electric utility outage management context.
  }
}
