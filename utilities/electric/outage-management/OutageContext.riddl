// Outage Management - Outage Context
context OutageContext is {
  adaptor FromCrewDispatchSystem from context CrewDispatchSystem is {
    handler FromCrewDispatchSystemHandler is {
      on result CrewDispatchSystem.AvailableCrews is {
        do "the model receives available crews"
      }
      on event CrewDispatchSystem.CrewAssigned is {
        do "the model receives crew assigned"
      }
      on event CrewDispatchSystem.CrewReleased is {
        do "the model receives crew released"
      }
      on other is {
        error "Unexpected message for adaptor FromCrewDispatchSystem"
      }
    } with {
      briefly "from crew dispatch system"
      described as {
        |Carries messages from the external CrewDispatchSystem.
      }
    }
  } with {
      briefly "CrewDispatchSystem integration"
    described as {
      |The model's side of the CrewDispatchSystem conversation.
    }
  }
  adaptor ToCrewDispatchSystem to context CrewDispatchSystem is {
    handler ToCrewDispatchSystemHandler is {
      on command CrewDispatchSystem.AssignCrew is {
        do "the model sends assign crew"
      }
      on query CrewDispatchSystem.GetAvailableCrews is {
        do "the model sends get available crews"
      }
      on command CrewDispatchSystem.ReleaseCrew is {
        do "the model sends release crew"
      }
      on other is {
        error "Unexpected message for adaptor ToCrewDispatchSystem"
      }
    } with {
      briefly "to crew dispatch system"
      described as {
        |Carries messages to the external CrewDispatchSystem.
      }
    }
  } with {
      briefly "CrewDispatchSystem integration"
    described as {
      |The model's side of the CrewDispatchSystem conversation.
    }
  }
  adaptor FromSCADASystem from context SCADASystem is {
    handler FromSCADASystemHandler is {
      on event SCADASystem.FeederIsolated is {
        do "the model receives feeder isolated"
      }
      on result SCADASystem.FeederStatus is {
        do "the model receives feeder status"
      }
      on event SCADASystem.OutageDetected is {
        do "the model receives outage detected"
      }
      on other is {
        error "Unexpected message for adaptor FromSCADASystem"
      }
    } with {
      briefly "from scada system"
      described as {
        |Carries messages from the external SCADASystem.
      }
    }
  } with {
      briefly "SCADASystem integration"
    described as {
      |The model's side of the SCADASystem conversation.
    }
  }
  adaptor ToSCADASystem to context SCADASystem is {
    handler ToSCADASystemHandler is {
      on query SCADASystem.GetFeederStatus is {
        do "the model sends get feeder status"
      }
      on command SCADASystem.IsolateFeeder is {
        do "the model sends isolate feeder"
      }
      on other is {
        error "Unexpected message for adaptor ToSCADASystem"
      }
    } with {
      briefly "to scada system"
      described as {
        |Carries messages to the external SCADASystem.
      }
    }
  } with {
      briefly "SCADASystem integration"
    described as {
      |The model's side of the SCADASystem conversation.
    }
  }
  include "types.riddl"
  include "OutageEvent.riddl"
  repository OutageRepository is {
    inlet OutageRepositoryFromOutageEvent is type OutageEventEvent
    inlet OutageRepositoryFromOutageMetrics is type OutageEventEvent
    outlet OutageRepositoryResponses is type OutageEvent.OutageEventResult
    record StoredOutageEvent is {
      outageEventId: OutageEventId with {
        briefly "outageEventId"
        described as {
          |The outageEventId column of the stored outageEvent row.
        }
      }
      outageId: OutageEventId with {
        briefly "outageId"
        described as {
          |The outageId column of the stored outageEvent row.
        }
      }
      outageInfo: OutageInfo with {
        briefly "outageInfo"
        described as {
          |The outageInfo column of the stored outageEvent row.
        }
      }
      status: OutageStatus with {
        briefly "status"
        described as {
          |The status column of the stored outageEvent row.
        }
      }
    } with {
      briefly "Stored outageEvent row"
      described as {
        |The persistence shape of outageEvent data as this repository stores it.
      }
    }
    schema OutageData is relational
      of outageEvents as type StoredOutageEvent
        index on field StoredOutageEvent.outageId
        index on field StoredOutageEvent.outageInfo.feederId
        index on field StoredOutageEvent.status
      with {
      briefly "Outage data schema"
      described as {
        |The relational schema holding outage data for the OutageRepository.
      }
    }

    handler OutagePersistence is {
      on command OutageEvent.ReportOutage is {
        do "Store new outage event"
      }
      on command OutageEvent.ConfirmOutage is {
        tell event OutageEvent.OutageConfirmed to entity OutageContext.OutageEvent
        do "Update outage to confirmed"
      }
      on command OutageEvent.DispatchCrew is {
        do "Store crew dispatch record"
      }
      on command OutageEvent.RestorePower is {
        do "Update outage to restored"
      }
      on command OutageEvent.CloseOutage is {
        tell event OutageEvent.OutageClosed to entity OutageContext.OutageEvent
        do "Update outage to closed with analysis"
      }
    } with {
      briefly "Persists outage commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Outage data persistence"
    described as {
      |Persistent storage for outage events.
    }
  }
  projector OutageMetrics is {
    inlet OutageMetricsFromOutageEvent is type OutageEventEvent
    outlet OutageMetricsOut is type OutageEventEvent
    updates repository OutageContext.OutageRepository
    record OutageMetricsData is  {
      outagesReported: Natural with {
        briefly "Reported"
        described as {
          |Outages reported.
        }
      }
      outagesRestored: Natural with {
        briefly "Restored"
        described as {
          |Outages restored.
        }
      }
      outagesCancelled: Natural with {
        briefly "Cancelled"
        described as {
          |Outages cancelled.
        }
      }
      averageRestorationTime: Decimal(8,2) with {
        briefly "Avg time"
        described as {
          |Average restoration time in minutes.
        }
      }
    } with {
      briefly "Outage metrics"
      described as {
        |Outage processing metrics.
      }
    }
    handler MetricsHandler is {
      on event OutageEvent.OutageReported is {
        tell event OutageEvent.OutageReported to repository OutageContext.OutageRepository
        do "Increment outages reported"
      }
      on event OutageEvent.PowerRestored is {
        tell event OutageEvent.PowerRestored to repository OutageContext.OutageRepository
        do "Increment outages restored and calculate restoration time"
      }
      on event OutageEvent.OutageCancelled is {
        tell event OutageEvent.OutageCancelled to repository OutageContext.OutageRepository
        do "Increment outages cancelled"
      }
    } with {
      briefly "Maintains outage metrics"
      described as {
        |Projects events into outage metrics.
      }
    }
  } with {
    briefly "Outage metrics"
    described as {
      |Outage management analytics.
    }
  }
  // ---- Event publication for OutageEvent ----
  type OutageEventEvent is one of {
    OutageContext.OutageEvent.OutageReported,
    OutageContext.OutageEvent.OutageConfirmed,
    OutageContext.OutageEvent.CrewDispatched,
    OutageContext.OutageEvent.CrewArrived,
    OutageContext.OutageEvent.RestorationStarted,
    OutageContext.OutageEvent.RestorationStepCompleted,
    OutageContext.OutageEvent.PowerRestored,
    OutageContext.OutageEvent.CustomersNotified,
    OutageContext.OutageEvent.OutageClosed,
    OutageContext.OutageEvent.OutageCancelled
  } with {
    briefly "OutageEvent event alternation"
    described as {
      |Union of all OutageEvent events, for streaming and event-sourced
      |persistence.
    }
  }
  processor OutageEventEventSource as source is {
    outlet OutageEventEvents is type OutageEventEvent
    handler OutageEventSourceHandler is {
      on event OutageEvent.OutageReported is {
        send event OutageEvent.OutageReported to outlet OutageEventEvents
      }
      on event OutageEvent.OutageConfirmed is {
        send event OutageEvent.OutageConfirmed to outlet OutageEventEvents
      }
      on event OutageEvent.CrewDispatched is {
        send event OutageEvent.CrewDispatched to outlet OutageEventEvents
      }
      on event OutageEvent.CrewArrived is {
        send event OutageEvent.CrewArrived to outlet OutageEventEvents
      }
      on event OutageEvent.RestorationStarted is {
        send event OutageEvent.RestorationStarted to outlet OutageEventEvents
      }
      on event OutageEvent.RestorationStepCompleted is {
        send event OutageEvent.RestorationStepCompleted to outlet OutageEventEvents
      }
      on event OutageEvent.PowerRestored is {
        send event OutageEvent.PowerRestored to outlet OutageEventEvents
      }
      on event OutageEvent.CustomersNotified is {
        send event OutageEvent.CustomersNotified to outlet OutageEventEvents
      }
      on event OutageEvent.OutageClosed is {
        send event OutageEvent.OutageClosed to outlet OutageEventEvents
      }
      on event OutageEvent.OutageCancelled is {
        send event OutageEvent.OutageCancelled to outlet OutageEventEvents
      }
      on other is {
        error "Unexpected message for source OutageEventEventSource"
      }
    } with {
      briefly "OutageEvent source handler"
      described as {
        |Publishes OutageEvent events onto the outlet.
      }
    }
  } with {
    briefly "OutageEvent event source"
    described as {
      |Publishes OutageEvent entity events into the streaming topology.
    }
  }
  processor OutageEventEventSink as sink is {
    inlet OutageEventInlet is type OutageEventEvent
    handler OutageEventSinkHandler is {
      on event OutageEvent.OutageReported is {
        tell event OutageEvent.OutageReported to repository OutageContext.OutageRepository
      }
      on event OutageEvent.OutageConfirmed is {
        tell event OutageEvent.OutageConfirmed to repository OutageContext.OutageRepository
      }
      on event OutageEvent.CrewDispatched is {
        tell event OutageEvent.CrewDispatched to repository OutageContext.OutageRepository
      }
      on event OutageEvent.CrewArrived is {
        tell event OutageEvent.CrewArrived to repository OutageContext.OutageRepository
      }
      on event OutageEvent.RestorationStarted is {
        tell event OutageEvent.RestorationStarted to repository OutageContext.OutageRepository
      }
      on event OutageEvent.RestorationStepCompleted is {
        tell event OutageEvent.RestorationStepCompleted to repository OutageContext.OutageRepository
      }
      on event OutageEvent.PowerRestored is {
        tell event OutageEvent.PowerRestored to repository OutageContext.OutageRepository
      }
      on event OutageEvent.CustomersNotified is {
        tell event OutageEvent.CustomersNotified to repository OutageContext.OutageRepository
      }
      on event OutageEvent.OutageClosed is {
        tell event OutageEvent.OutageClosed to repository OutageContext.OutageRepository
      }
      on event OutageEvent.OutageCancelled is {
        tell event OutageEvent.OutageCancelled to repository OutageContext.OutageRepository
      }
      on other is {
        error "Unexpected message for sink OutageEventEventSink"
      }
    } with {
      briefly "OutageEvent sink handler"
      described as {
        |Persists OutageEvent events via the repository.
      }
    }
  } with {
    briefly "OutageEvent event sink"
    described as {
      |Receives OutageEvent events for persistence.
    }
  }
  connector OutageEventEventFlow is {
    from outlet OutageContext.OutageEventEventSource.OutageEventEvents to
      inlet OutageContext.OutageEventEventSink.OutageEventInlet
  } with {
    briefly "OutageEvent event flow"
    described as {
      |Connects the OutageEvent source to its sink.
    }
  }
  processor OutageEventEventSplit is {
    inlet OutageEventEventSplitIn is type OutageEventEvent
    outlet OutageEventEventSplitToOutageRepository is type OutageEventEvent
    outlet OutageEventEventSplitToOutageMetrics is type OutageEventEvent
    handler OutageEventEventSplitHandler is {
      on event OutageEvent.OutageReported is {
        send event OutageEvent.OutageReported to outlet OutageEventEventSplitToOutageRepository
        send event OutageEvent.OutageReported to outlet OutageEventEventSplitToOutageMetrics
        tell event OutageEvent.OutageReported to entity OutageContext.OutageEvent
      }
      on event OutageEvent.OutageConfirmed is {
        send event OutageEvent.OutageConfirmed to outlet OutageEventEventSplitToOutageRepository
        send event OutageEvent.OutageConfirmed to outlet OutageEventEventSplitToOutageMetrics
        tell event OutageEvent.OutageConfirmed to entity OutageContext.OutageEvent
      }
      on event OutageEvent.CrewDispatched is {
        send event OutageEvent.CrewDispatched to outlet OutageEventEventSplitToOutageRepository
        send event OutageEvent.CrewDispatched to outlet OutageEventEventSplitToOutageMetrics
        tell event OutageEvent.CrewDispatched to entity OutageContext.OutageEvent
      }
      on event OutageEvent.CrewArrived is {
        send event OutageEvent.CrewArrived to outlet OutageEventEventSplitToOutageRepository
        send event OutageEvent.CrewArrived to outlet OutageEventEventSplitToOutageMetrics
        tell event OutageEvent.CrewArrived to entity OutageContext.OutageEvent
      }
      on event OutageEvent.RestorationStarted is {
        send event OutageEvent.RestorationStarted to outlet OutageEventEventSplitToOutageRepository
        send event OutageEvent.RestorationStarted to outlet OutageEventEventSplitToOutageMetrics
        tell event OutageEvent.RestorationStarted to entity OutageContext.OutageEvent
      }
      on event OutageEvent.RestorationStepCompleted is {
        send event OutageEvent.RestorationStepCompleted to outlet OutageEventEventSplitToOutageRepository
        send event OutageEvent.RestorationStepCompleted to outlet OutageEventEventSplitToOutageMetrics
        tell event OutageEvent.RestorationStepCompleted to entity OutageContext.OutageEvent
      }
      on event OutageEvent.PowerRestored is {
        send event OutageEvent.PowerRestored to outlet OutageEventEventSplitToOutageRepository
        send event OutageEvent.PowerRestored to outlet OutageEventEventSplitToOutageMetrics
        tell event OutageEvent.PowerRestored to entity OutageContext.OutageEvent
      }
      on event OutageEvent.CustomersNotified is {
        send event OutageEvent.CustomersNotified to outlet OutageEventEventSplitToOutageRepository
        send event OutageEvent.CustomersNotified to outlet OutageEventEventSplitToOutageMetrics
        tell event OutageEvent.CustomersNotified to entity OutageContext.OutageEvent
      }
      on event OutageEvent.OutageClosed is {
        send event OutageEvent.OutageClosed to outlet OutageEventEventSplitToOutageRepository
        send event OutageEvent.OutageClosed to outlet OutageEventEventSplitToOutageMetrics
        tell event OutageEvent.OutageClosed to entity OutageContext.OutageEvent
      }
      on event OutageEvent.OutageCancelled is {
        send event OutageEvent.OutageCancelled to outlet OutageEventEventSplitToOutageRepository
        send event OutageEvent.OutageCancelled to outlet OutageEventEventSplitToOutageMetrics
        tell event OutageEvent.OutageCancelled to entity OutageContext.OutageEvent
      }
      on other is {
        error "Unexpected message for processor OutageEventEventSplit"
      }
    } with {
      briefly "OutageEvent event fan-out handler"
      described as {
        |Delivers each OutageEvent event to all of its consumers.
      }
    }
  } with {
    briefly "OutageEvent event fan-out"
    described as {
      |Fans OutageEvent events out to the repository and projectors.
    }
  }
  connector LinkOutageEventToOutageEventEventSplit is {
    from outlet OutageContext.OutageEvent.OutageEventEvents2 to
      inlet OutageContext.OutageEventEventSplit.OutageEventEventSplitIn
  } with {
    briefly "LinkOutageEventToOutageEventEventSplit"
  }
  connector LinkOutageEventEventSplitToOutageRepository is {
    from outlet OutageContext.OutageEventEventSplit.OutageEventEventSplitToOutageRepository to
      inlet OutageContext.OutageRepository.OutageRepositoryFromOutageEvent
  } with {
    briefly "LinkOutageEventEventSplitToOutageRepository"
  }
  connector LinkOutageEventEventSplitToOutageMetrics is {
    from outlet OutageContext.OutageEventEventSplit.OutageEventEventSplitToOutageMetrics to
      inlet OutageContext.OutageMetrics.OutageMetricsFromOutageEvent
  } with {
    briefly "LinkOutageEventEventSplitToOutageMetrics"
  }
  connector LinkOutageMetricsToOutageRepository is {
    from outlet OutageContext.OutageMetrics.OutageMetricsOut to
      inlet OutageContext.OutageRepository.OutageRepositoryFromOutageMetrics
  } with {
    briefly "LinkOutageMetricsToOutageRepository"
  }
} with {
  briefly "Bounded context for outage management"
  described as {
    |Electric utility outage management context.
  }
}
