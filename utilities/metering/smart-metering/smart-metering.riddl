// Smart Metering Domain Model
// Advanced metering infrastructure management
domain SmartMetering is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user MeteringManager is "person overseeing meter infrastructure" with {
    briefly "Metering Manager"
    described as {
      |Manager of metering systems.
    }
  }
  user FieldTechnician is "person installing and maintaining meters" with {
    briefly "Field Technician"
    described as {
      |Technician performing meter work.
    }
  }
  user BillingAnalyst is "person validating meter data" with {
    briefly "Billing Analyst"
    described as {
      |Analyst reviewing meter readings.
    }
  }
  epic SmartMeterManagement is {
    user MeteringManager wants to "to manage smart meter infrastructure" so that "accurate consumption data is collected"
    case CollectMeterData is {
      user MeteringManager wants to "to collect meter readings" so that "customer usage is recorded"
      step is "System polls" "smart meters" "for readings" with {
        briefly "Poll meters"
        described as {
          |Request readings.
        }
      }
      step is "System validates" "reading data" "for accuracy" with {
        briefly "Validate data"
        described as {
          |Check readings.
        }
      }
    } with {
      briefly "Collect meter data"
      described as {
        |Gathering meter readings.
      }
    }
  } with {
    briefly "Smart meter management"
    described as {
      |Epic for metering operations.
    }
  }
  include "MeteringContext.riddl"
  include "external-contexts.riddl"
  application context SmartMeteringApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in SmartMetering are delivered.
      }
    }
    outlet AppMeterCommands is type MeteringContext.Meter.MeterCommand
    inlet AppMeteringRepositoryResponses is type MeteringContext.Meter.MeterResult    handler SmartMeteringAppHandler is {
      on other is {
        error "Unexpected message for application context SmartMeteringApp"
      }
    } with {
      briefly "SmartMeteringApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "SmartMeteringApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector MeterCommandStream is from outlet SmartMeteringApp.AppMeterCommands to inlet MeteringContext.Meter.MeterCommands with {
    option persistent()
    briefly "Meter commands from the application"
  }
  connector MeteringQueryResults is from outlet MeteringContext.MeteringRepository.MeteringRepositoryResponses to inlet SmartMeteringApp.AppMeteringRepositoryResponses with {
    option persistent()
    briefly "Metering query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet SmartMeteringApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Smart metering domain"
  described as {
    |Advanced metering infrastructure.
  }
}
