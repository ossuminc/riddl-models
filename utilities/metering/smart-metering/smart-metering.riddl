// Smart Metering Domain Model
// Advanced metering infrastructure management
domain SmartMetering is {
  persistent connector 'MeterDataManagementReply Stream' is from outlet MeterDataManagement.MeterDataManagementRepliesOut to inlet MeteringContext.ToMeterDataManagement.ToMeterDataManagementReplies with {
    briefly "What MeterDataManagement answers MeteringContext"
  }
  persistent connector 'HeadEndSystemReply Stream' is from outlet HeadEndSystem.HeadEndSystemRepliesOut to inlet MeteringContext.ToHeadEndSystem.ToHeadEndSystemReplies with {
    briefly "What HeadEndSystem answers MeteringContext"
  }
  persistent connector 'BillingSystemEvent Stream' is from outlet BillingSystem.BillingSystemEventsOut to inlet MeteringContext.FromBillingSystem.FromBillingSystemIn with {
    briefly "What BillingSystem tells MeteringContext, unasked"
  }
  persistent connector 'HeadEndSystemEvent Stream' is from outlet HeadEndSystem.HeadEndSystemEventsOut to inlet MeteringContext.FromHeadEndSystem.FromHeadEndSystemIn with {
    briefly "What HeadEndSystem tells MeteringContext, unasked"
  }
  persistent connector 'OutageManagementEvent Stream' is from outlet OutageManagement.OutageManagementEventsOut to inlet MeteringContext.FromOutageManagement.FromOutageManagementIn with {
    briefly "What OutageManagement tells MeteringContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user MeteringManager is "person overseeing meter infrastructure" with {
    briefly "Metering Manager"
    described as {
      |Manager of metering systems.
    }
  }
  user FieldTechnician is "person installing and maintaining meters" with {
    briefly "Field Technician"
    described as {
      |Technician performing meter work.
    }
  }
  user BillingAnalyst is "person validating meter data" with {
    briefly "Billing Analyst"
    described as {
      |Analyst reviewing meter readings.
    }
  }
  epic SmartMeterManagement is {
    user MeteringManager wants to "to manage smart meter infrastructure" so that "accurate consumption data is collected"
    case CollectMeterData is {
      user MeteringManager wants to "to collect meter readings" so that "customer usage is recorded"
      step is "System polls" "smart meters" "for readings" with {
        briefly "Poll meters"
        described as {
          |Request readings.
        }
      }
      step is "System validates" "reading data" "for accuracy" with {
        briefly "Validate data"
        described as {
          |Check readings.
        }
      }
    } with {
      briefly "Collect meter data"
      described as {
        |Gathering meter readings.
      }
    }
  } with {
    briefly "Smart meter management"
    described as {
      |Epic for metering operations.
    }
  }
  include "MeteringContext.riddl"
  include "external-contexts.riddl"
  application context SmartMeteringApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in SmartMetering are delivered.
      }
    }
    group SmartMeteringScreen is {
      input GetNetworkHealthInput acquires query MeteringContext.GetNetworkHealth with {
        briefly "Get network health control"
        described as {
          |The control through which a user asks the get network health question.
        }
      }
      input GetMeterInput acquires query MeteringContext.Meter.GetMeter with {
        briefly "Get meter control"
        described as {
          |The control through which a user asks the get meter question.
        }
      }
      input InstallMeterInput acquires command MeteringContext.InstallMeter with {
        briefly "Install meter control"
        described as {
          |The control through which a user submits the install meter request.
        }
      }
      input ActivateMeterInput acquires command MeteringContext.Meter.ActivateMeter with {
        briefly "Activate meter control"
        described as {
          |The control through which a user submits the activate meter request.
        }
      }
      input DecommissionMeterInput acquires command MeteringContext.Meter.DecommissionMeter with {
        briefly "Decommission meter control"
        described as {
          |The control through which a user submits the decommission meter request.
        }
      }
      input DisconnectMeterInput acquires command MeteringContext.Meter.DisconnectMeter with {
        briefly "Disconnect meter control"
        described as {
          |The control through which a user submits the disconnect meter request.
        }
      }
      input ReconnectMeterInput acquires command MeteringContext.Meter.ReconnectMeter with {
        briefly "Reconnect meter control"
        described as {
          |The control through which a user submits the reconnect meter request.
        }
      }
      input ResolveAlertInput acquires command MeteringContext.Meter.ResolveAlert with {
        briefly "Resolve alert control"
        described as {
          |The control through which a user submits the resolve alert request.
        }
      }
      input ScheduleMaintenanceInput acquires command MeteringContext.Meter.ScheduleMaintenance with {
        briefly "Schedule maintenance control"
        described as {
          |The control through which a user submits the schedule maintenance request.
        }
      }
    } with {
      briefly "Smart metering screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppMeteringRepositoryQueries is query MeteringContext.GetNetworkHealth
    inlet AppMeteringRepositoryReplies is result MeteringContext.NetworkHealthView
    outlet AppMeterQueries is query MeteringContext.Meter.GetMeter
    outlet AppMeterCommands is type MeteringContext.MeterRequest
    inlet AppMeteringRepositoryResponses is result MeteringContext.Meter.MeterResult
    handler SmartMeteringAppHandler is {
      on other is {
        error "Unexpected message for application context SmartMeteringApp"
      }
    } with {
      briefly "SmartMeteringApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "SmartMeteringApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'HeadEndSystemRequest Stream' is from outlet MeteringContext.ToHeadEndSystem.ToHeadEndSystemOut to inlet HeadEndSystem.HeadEndSystemRequests with {
    briefly "What MeteringContext asks HeadEndSystem to send"
  }
  persistent connector 'OutageManagementRequest Stream' is from outlet MeteringContext.ToOutageManagement.ToOutageManagementOut to inlet OutageManagement.OutageManagementRequests with {
    briefly "What MeteringContext asks OutageManagement to send"
  }
  persistent connector 'BillingSystemRequest Stream' is from outlet MeteringContext.ToBillingSystem.ToBillingSystemOut to inlet BillingSystem.BillingSystemRequests with {
    briefly "What MeteringContext asks BillingSystem to send"
  }
  persistent connector 'MeterDataManagementRequest Stream' is from outlet MeteringContext.ToMeterDataManagement.ToMeterDataManagementOut to inlet MeterDataManagement.MeterDataManagementRequests with {
    briefly "What MeteringContext asks MeterDataManagement to send"
  }
  persistent connector 'MeteringRepositoryQuery Stream' is from outlet SmartMeteringApp.AppMeteringRepositoryQueries to inlet MeteringContext.MeteringRepositoryQueriesIn with {
    briefly "SmartMeteringApp's look-ups of the metering repository"
  }
  persistent connector 'MeteringRepositoryReply Stream' is from outlet MeteringContext.MeteringRepositoryRepliesOut to inlet SmartMeteringApp.AppMeteringRepositoryReplies with {
    briefly "The metering repository's answers returned to SmartMeteringApp"
  }
  persistent connector 'MeterQuery Stream' is from outlet SmartMeteringApp.AppMeterQueries to inlet MeteringContext.MeterQueriesIn with {
    briefly "SmartMeteringApp's look-ups of the meter"
  }
  persistent connector 'MeterCommand Stream' is from outlet SmartMeteringApp.AppMeterCommands to inlet MeteringContext.MeterCommandStreamIn with {
    briefly "Meter commands from the application"
  }
  persistent connector 'MeterResult Stream' is from outlet MeteringContext.MeterResultStreamOut to inlet SmartMeteringApp.AppMeteringRepositoryResponses with {
    briefly "Metering query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet SmartMeteringApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Smart metering domain"
  described as {
    |Advanced metering infrastructure.
  }
}
