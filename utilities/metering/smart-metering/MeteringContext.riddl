// Smart Metering - Metering Context
context MeteringContext as router is {
  inlet MeterCommandStreamIn is type MeterCommand  outlet MeterCommandStreamOut is type MeterCommand
  inlet MeterResultStreamIn is result Meter.MeterResult  outlet MeterResultStreamOut is result Meter.MeterResult
  handler MeteringContextBoundary is {
    on installMeter: command Meter.InstallMeter is {
      send installMeter to outlet MeteringContext.MeterCommandStreamOut
    }
    on activateMeter: command Meter.ActivateMeter is {
      send activateMeter to outlet MeteringContext.MeterCommandStreamOut
    }
    on recordReading: command Meter.RecordReading is {
      send recordReading to outlet MeteringContext.MeterCommandStreamOut
    }
    on recordIntervalData: command Meter.RecordIntervalData is {
      send recordIntervalData to outlet MeteringContext.MeterCommandStreamOut
    }
    on raiseAlert: command Meter.RaiseAlert is {
      send raiseAlert to outlet MeteringContext.MeterCommandStreamOut
    }
    on resolveAlert: command Meter.ResolveAlert is {
      send resolveAlert to outlet MeteringContext.MeterCommandStreamOut
    }
    on updateCommunication: command Meter.UpdateCommunication is {
      send updateCommunication to outlet MeteringContext.MeterCommandStreamOut
    }
    on scheduleMaintenance: command Meter.ScheduleMaintenance is {
      send scheduleMaintenance to outlet MeteringContext.MeterCommandStreamOut
    }
    on disconnectMeter: command Meter.DisconnectMeter is {
      send disconnectMeter to outlet MeteringContext.MeterCommandStreamOut
    }
    on reconnectMeter: command Meter.ReconnectMeter is {
      send reconnectMeter to outlet MeteringContext.MeterCommandStreamOut
    }
    on decommissionMeter: command Meter.DecommissionMeter is {
      send decommissionMeter to outlet MeteringContext.MeterCommandStreamOut
    }
    on meterResult: result Meter.MeterResult is {
      send meterResult to outlet MeteringContext.MeterResultStreamOut
    }
    on other is {
      error "Unexpected message at the MeteringContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'MeterCommand Stream Intake' is from outlet MeteringContext.MeterCommandStreamOut to inlet MeteringContext.Meter.MeterCommands  connector 'MeterResult Stream Egress' is from outlet MeteringContext.MeteringRepository.MeteringRepositoryResponses to inlet MeteringContext.MeterResultStreamIn  adaptor FromBillingSystem from context BillingSystem is { 
    handler FromBillingSystemHandler is {
      on event BillingSystem.UsageAccepted is {
        do "the model receives usage accepted"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingSystem"
      }
    } with {
      briefly "from billing system"
      described as {
        |Carries messages from the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor ToBillingSystem to context BillingSystem is { 
    handler ToBillingSystemHandler is {
      on command BillingSystem.SubmitValidatedUsage is {
        do "the model sends submit validated usage"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingSystem"
      }
    } with {
      briefly "to billing system"
      described as {
        |Carries messages to the external BillingSystem.
      }
    }
  } with {
    briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor FromHeadEndSystem from context HeadEndSystem is { 
    handler FromHeadEndSystemHandler is {
      on event HeadEndSystem.MeterResponseReceived is {
        do "the model receives meter response received"
      }
      on result HeadEndSystem.MeterStatusResult is {
        do "the model receives meter status result"
      }
      on other is {
        error "Unexpected message for adaptor FromHeadEndSystem"
      }
    } with {
      briefly "from head end system"
      described as {
        |Carries messages from the external HeadEndSystem.
      }
    }
  } with {
    briefly "HeadEndSystem integration"
    described as {
      |The model's side of the HeadEndSystem conversation.
    }
  }
  adaptor ToHeadEndSystem to context HeadEndSystem is { 
    handler ToHeadEndSystemHandler is {
      on query HeadEndSystem.GetMeterStatus is {
        do "the model sends get meter status"
      }
      on command HeadEndSystem.PollMeter is {
        do "the model sends poll meter"
      }
      on command HeadEndSystem.SendDisconnectCommand is {
        do "the model sends send disconnect command"
      }
      on command HeadEndSystem.SendReconnectCommand is {
        do "the model sends send reconnect command"
      }
      on other is {
        error "Unexpected message for adaptor ToHeadEndSystem"
      }
    } with {
      briefly "to head end system"
      described as {
        |Carries messages to the external HeadEndSystem.
      }
    }
  } with {
    briefly "HeadEndSystem integration"
    described as {
      |The model's side of the HeadEndSystem conversation.
    }
  }
  adaptor FromMeterDataManagement from context MeterDataManagement is { 
    handler FromMeterDataManagementHandler is {
      on result MeterDataManagement.ValidationResult is {
        do "the model receives validation result"
      }
      on other is {
        error "Unexpected message for adaptor FromMeterDataManagement"
      }
    } with {
      briefly "from meter data management"
      described as {
        |Carries messages from the external MeterDataManagement.
      }
    }
  } with {
    briefly "MeterDataManagement integration"
    described as {
      |The model's side of the MeterDataManagement conversation.
    }
  }
  adaptor ToMeterDataManagement to context MeterDataManagement is { 
    handler ToMeterDataManagementHandler is {
      on command MeterDataManagement.EstimateMissing is {
        do "the model sends estimate missing"
      }
      on query MeterDataManagement.GetValidation is {
        do "the model sends get validation"
      }
      on command MeterDataManagement.ValidateReading is {
        do "the model sends validate reading"
      }
      on other is {
        error "Unexpected message for adaptor ToMeterDataManagement"
      }
    } with {
      briefly "to meter data management"
      described as {
        |Carries messages to the external MeterDataManagement.
      }
    }
  } with {
    briefly "MeterDataManagement integration"
    described as {
      |The model's side of the MeterDataManagement conversation.
    }
  }
  adaptor FromOutageManagement from context OutageManagement is { 
    handler FromOutageManagementHandler is {
      on event OutageManagement.OutageConfirmed is {
        do "the model receives outage confirmed"
      }
      on other is {
        error "Unexpected message for adaptor FromOutageManagement"
      }
    } with {
      briefly "from outage management"
      described as {
        |Carries messages from the external OutageManagement.
      }
    }
  } with {
    briefly "OutageManagement integration"
    described as {
      |The model's side of the OutageManagement conversation.
    }
  }
  adaptor ToOutageManagement to context OutageManagement is { 
    handler ToOutageManagementHandler is {
      on command OutageManagement.ReportMeterOutage is {
        do "the model sends report meter outage"
      }
      on command OutageManagement.ReportRestoration is {
        do "the model sends report restoration"
      }
      on other is {
        error "Unexpected message for adaptor ToOutageManagement"
      }
    } with {
      briefly "to outage management"
      described as {
        |Carries messages to the external OutageManagement.
      }
    }
  } with {
    briefly "OutageManagement integration"
    described as {
      |The model's side of the OutageManagement conversation.
    }
  }
  include "types.riddl"
  include "Meter.riddl"
  type MeteringRepositoryCommand is one of {
    MeteringContext.MeteringRepository.PersistAlertRaised or MeteringContext.MeteringRepository.PersistAlertResolved or MeteringContext.MeteringRepository.PersistCommunicationUpdated or MeteringContext.MeteringRepository.PersistIntervalDataRecorded or MeteringContext.MeteringRepository.PersistMaintenanceScheduled or MeteringContext.MeteringRepository.PersistMeterActivated or MeteringContext.MeteringRepository.PersistMeterDecommissioned or MeteringContext.MeteringRepository.PersistMeterDisconnected or MeteringContext.MeteringRepository.PersistMeterInstalled or MeteringContext.MeteringRepository.PersistMeterReconnected or MeteringContext.MeteringRepository.PersistReadingRecorded
  } with {
    briefly "Anything that writes MeteringRepository"
    described as {
      |The persistence commands MeteringRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository MeteringRepository as flow is {
    inlet MeteringRepositoryFromMeteringAnalytics is type MeteringRepositoryCommand    command PersistIntervalDataRecorded is {
      meterId: MeterId with {
        briefly "Row addressed"
        described as {
          |Which stored row IntervalDataRecorded applies to.
        }
      }
    } with {
      briefly "Persist IntervalDataRecorded"
      described as {
        |Instructs this repository to apply IntervalDataRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceScheduled is {
      meterId: MeterId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceScheduled applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceScheduled"
      described as {
        |Instructs this repository to apply MaintenanceScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMeterActivated is {
      meterId: MeterId with {
        briefly "Row addressed"
        described as {
          |Which stored row MeterActivated applies to.
        }
      }
    } with {
      briefly "Persist MeterActivated"
      described as {
        |Instructs this repository to apply MeterActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMeterDecommissioned is {
      meterId: MeterId with {
        briefly "Row addressed"
        described as {
          |Which stored row MeterDecommissioned applies to.
        }
      }
    } with {
      briefly "Persist MeterDecommissioned"
      described as {
        |Instructs this repository to apply MeterDecommissioned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMeterDisconnected is {
      meterId: MeterId with {
        briefly "Row addressed"
        described as {
          |Which stored row MeterDisconnected applies to.
        }
      }
    } with {
      briefly "Persist MeterDisconnected"
      described as {
        |Instructs this repository to apply MeterDisconnected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMeterReconnected is {
      meterId: MeterId with {
        briefly "Row addressed"
        described as {
          |Which stored row MeterReconnected applies to.
        }
      }
    } with {
      briefly "Persist MeterReconnected"
      described as {
        |Instructs this repository to apply MeterReconnected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReadingRecorded is {
      meterId: MeterId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReadingRecorded applies to.
        }
      }
    } with {
      briefly "Persist ReadingRecorded"
      described as {
        |Instructs this repository to apply ReadingRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAlertRaised is {
      meterId: MeterId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlertRaised applies to.
        }
      }
    } with {
      briefly "Persist AlertRaised"
      described as {
        |Instructs this repository to apply AlertRaised to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAlertResolved is {
      meterId: MeterId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlertResolved applies to.
        }
      }
    } with {
      briefly "Persist AlertResolved"
      described as {
        |Instructs this repository to apply AlertResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCommunicationUpdated is {
      meterId: MeterId with {
        briefly "Row addressed"
        described as {
          |Which stored row CommunicationUpdated applies to.
        }
      }
    } with {
      briefly "Persist CommunicationUpdated"
      described as {
        |Instructs this repository to apply CommunicationUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMeterInstalled is {
      meterId: MeterId with {
        briefly "Row addressed"
        described as {
          |Which stored row MeterInstalled applies to.
        }
      }
    } with {
      briefly "Persist MeterInstalled"
      described as {
        |Instructs this repository to apply MeterInstalled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet MeteringRepositoryResponses is result Meter.MeterResult
    record StoredMeter is {
      meterId: MeterId with {
        briefly "meterId"
        described as {
          |The meterId column of the stored meter row.
        }
      }
      accountId: AccountId with {
        briefly "accountId"
        described as {
          |The accountId column of the stored meter row.
        }
      }
      meterInfo: MeterInfo with {
        briefly "meterInfo"
        described as {
          |The meterInfo column of the stored meter row.
        }
      }
      status: MeterStatus with {
        briefly "status"
        described as {
          |The status column of the stored meter row.
        }
      }
    } with {
      briefly "Stored meter row"
      described as {
        |The persistence shape of meter data as this repository stores it.
      }
    }
    schema MeteringData is relational
      of meters as record StoredMeter
        index on field StoredMeter.meterId
        index on field StoredMeter.accountId
        index on field StoredMeter.status
        index on field StoredMeter.meterInfo.serialNumber
 with {
      briefly "Metering data schema"
      described as {
        |The relational schema holding metering data for the MeteringRepository.
      }
    }
    handler MeteringPersistence is {
      on persistIntervalDataRecorded: command PersistIntervalDataRecorded is {
        do "apply IntervalDataRecorded to the stored row"
      }
      on persistMaintenanceScheduled: command PersistMaintenanceScheduled is {
        do "apply MaintenanceScheduled to the stored row"
      }
      on persistMeterActivated: command PersistMeterActivated is {
        do "apply MeterActivated to the stored row"
      }
      on persistMeterDecommissioned: command PersistMeterDecommissioned is {
        do "apply MeterDecommissioned to the stored row"
      }
      on persistMeterDisconnected: command PersistMeterDisconnected is {
        do "apply MeterDisconnected to the stored row"
      }
      on persistMeterReconnected: command PersistMeterReconnected is {
        do "apply MeterReconnected to the stored row"
      }
      on persistReadingRecorded: command PersistReadingRecorded is {
        do "apply ReadingRecorded to the stored row"
      }
      on persistAlertRaised: command PersistAlertRaised is {
        do "apply AlertRaised to the stored row"
      }
      on persistAlertResolved: command PersistAlertResolved is {
        do "apply AlertResolved to the stored row"
      }
      on persistCommunicationUpdated: command PersistCommunicationUpdated is {
        do "apply CommunicationUpdated to the stored row"
      }
      on persistMeterInstalled: command PersistMeterInstalled is {
        do "apply MeterInstalled to the stored row"
      }
      on query GetNetworkHealth is {
        let networkHealthView: type NetworkHealthView = prompt("read the network health projection")
        reply networkHealthView
      }
    } with {
      briefly "Persists metering commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Metering data persistence"
    described as {
      |Persistent storage for meters.
    }
  }
  query GetNetworkHealth replies result NetworkHealthView is {
    networkHealthKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which network health to retrieve.
      }
    }
  } with {
    briefly "Get network health"
    described as {
      |Retrieves the network health projection.
    }
  }
  result NetworkHealthView is {
    networkHealth: MeteringAnalytics.NetworkHealth with {
      briefly "Network health"
      described as {
        |The network health being returned.
      }
    }
  } with {
    briefly "Network health view"
    described as {
      |Read model view carrying the network health projection.
    }
  }
  projector MeteringAnalytics as flow is {
    updates repository MeteringContext.MeteringRepository
    outlet MeteringAnalyticsToRepository is type MeteringRepositoryCommand
    inlet MeteringAnalyticsFromMeter is type MeterEvent    record NetworkHealth is {
      totalMeters: Natural with {
        briefly "Total"
        described as {
          |Total meters.
        }
      }
      activeMeters: Natural with {
        briefly "Active"
        described as {
          |Active meters.
        }
      }
      communicatingMeters: Natural with {
        briefly "Communicating"
        described as {
          |Meters online.
        }
      }
      alertCount: Natural with {
        briefly "Alerts"
        described as {
          |Active alerts.
        }
      }
      avgSignalStrength: Decimal(5,2) with {
        briefly "Signal"
        described as {
          |Avg signal strength.
        }
      }
    } with {
      briefly "Network health"
      described as {
        |AMI network health metrics.
      }
    }
    handler AnalyticsHandler is {
      on intervalDataRecorded: event Meter.IntervalDataRecorded is {
        tell command MeteringContext.MeteringRepository.PersistIntervalDataRecorded(meterId = intervalDataRecorded.meterId) to repository MeteringContext.MeteringRepository
        do "apply IntervalDataRecorded to the MeteringAnalytics projection"
      }
      on maintenanceScheduled: event Meter.MaintenanceScheduled is {
        tell command MeteringContext.MeteringRepository.PersistMaintenanceScheduled(meterId = maintenanceScheduled.meterId) to repository MeteringContext.MeteringRepository
        do "apply MaintenanceScheduled to the MeteringAnalytics projection"
      }
      on meterActivated: event Meter.MeterActivated is {
        tell command MeteringContext.MeteringRepository.PersistMeterActivated(meterId = meterActivated.meterId) to repository MeteringContext.MeteringRepository
        do "apply MeterActivated to the MeteringAnalytics projection"
      }
      on meterDecommissioned: event Meter.MeterDecommissioned is {
        tell command MeteringContext.MeteringRepository.PersistMeterDecommissioned(meterId = meterDecommissioned.meterId) to repository MeteringContext.MeteringRepository
        do "apply MeterDecommissioned to the MeteringAnalytics projection"
      }
      on meterDisconnected: event Meter.MeterDisconnected is {
        tell command MeteringContext.MeteringRepository.PersistMeterDisconnected(meterId = meterDisconnected.meterId) to repository MeteringContext.MeteringRepository
        do "apply MeterDisconnected to the MeteringAnalytics projection"
      }
      on meterReconnected: event Meter.MeterReconnected is {
        tell command MeteringContext.MeteringRepository.PersistMeterReconnected(meterId = meterReconnected.meterId) to repository MeteringContext.MeteringRepository
        do "apply MeterReconnected to the MeteringAnalytics projection"
      }
      on readingRecorded: event Meter.ReadingRecorded is {
        tell command MeteringContext.MeteringRepository.PersistReadingRecorded(meterId = readingRecorded.meterId) to repository MeteringContext.MeteringRepository
        do "apply ReadingRecorded to the MeteringAnalytics projection"
      }
      on meterInstalled: event Meter.MeterInstalled is {
        tell command MeteringContext.MeteringRepository.PersistMeterInstalled(meterId = meterInstalled.meterId) to repository MeteringContext.MeteringRepository
        do "Update meter counts"
      }
      on communicationUpdated: event Meter.CommunicationUpdated is {
        tell command MeteringContext.MeteringRepository.PersistCommunicationUpdated(meterId = communicationUpdated.meterId) to repository MeteringContext.MeteringRepository
        do "Update communication statistics"
      }
      on alertRaised: event Meter.AlertRaised is {
        tell command MeteringContext.MeteringRepository.PersistAlertRaised(meterId = alertRaised.meterId) to repository MeteringContext.MeteringRepository
        do "Increment alert count"
      }
      on alertResolved: event Meter.AlertResolved is {
        tell command MeteringContext.MeteringRepository.PersistAlertResolved(meterId = alertResolved.meterId) to repository MeteringContext.MeteringRepository
        do "Decrement alert count"
      }
    } with {
      briefly "Maintains metering analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Metering analytics"
    described as {
      |AMI network monitoring.
    }
  }
  // ---- Event publication for Meter ----
  type MeterEvent is one of {
    MeteringContext.Meter.MeterInstalled or MeteringContext.Meter.MeterActivated or MeteringContext.Meter.ReadingRecorded or MeteringContext.Meter.IntervalDataRecorded or MeteringContext.Meter.AlertRaised or MeteringContext.Meter.AlertResolved or MeteringContext.Meter.CommunicationUpdated or MeteringContext.Meter.MaintenanceScheduled or MeteringContext.Meter.MeterDisconnected or MeteringContext.Meter.MeterReconnected or MeteringContext.Meter.MeterDecommissioned
  } with {
    briefly "Meter event alternation"
    described as {
      |Union of all Meter events, for streaming and event-sourced
      |persistence.
    }
  }
  processor MeterEventSplit as flow is {
    inlet MeterEventSplitIn is type MeterEvent    outlet MeterEventSplitToMeteringAnalytics is type MeterEvent
    handler MeterEventSplitHandler is {
      on meterInstalled: event Meter.MeterInstalled is {
        send meterInstalled to outlet MeterEventSplitToMeteringAnalytics
        tell meterInstalled to entity MeteringContext.Meter
      }
      on meterActivated: event Meter.MeterActivated is {
        send meterActivated to outlet MeterEventSplitToMeteringAnalytics
        tell meterActivated to entity MeteringContext.Meter
      }
      on readingRecorded: event Meter.ReadingRecorded is {
        send readingRecorded to outlet MeterEventSplitToMeteringAnalytics
        tell readingRecorded to entity MeteringContext.Meter
      }
      on intervalDataRecorded: event Meter.IntervalDataRecorded is {
        send intervalDataRecorded to outlet MeterEventSplitToMeteringAnalytics
        tell intervalDataRecorded to entity MeteringContext.Meter
      }
      on alertRaised: event Meter.AlertRaised is {
        send alertRaised to outlet MeterEventSplitToMeteringAnalytics
        tell alertRaised to entity MeteringContext.Meter
      }
      on alertResolved: event Meter.AlertResolved is {
        send alertResolved to outlet MeterEventSplitToMeteringAnalytics
        tell alertResolved to entity MeteringContext.Meter
      }
      on communicationUpdated: event Meter.CommunicationUpdated is {
        send communicationUpdated to outlet MeterEventSplitToMeteringAnalytics
        tell communicationUpdated to entity MeteringContext.Meter
      }
      on maintenanceScheduled: event Meter.MaintenanceScheduled is {
        send maintenanceScheduled to outlet MeterEventSplitToMeteringAnalytics
        tell maintenanceScheduled to entity MeteringContext.Meter
      }
      on meterDisconnected: event Meter.MeterDisconnected is {
        send meterDisconnected to outlet MeterEventSplitToMeteringAnalytics
        tell meterDisconnected to entity MeteringContext.Meter
      }
      on meterReconnected: event Meter.MeterReconnected is {
        send meterReconnected to outlet MeterEventSplitToMeteringAnalytics
        tell meterReconnected to entity MeteringContext.Meter
      }
      on meterDecommissioned: event Meter.MeterDecommissioned is {
        send meterDecommissioned to outlet MeterEventSplitToMeteringAnalytics
        tell meterDecommissioned to entity MeteringContext.Meter
      }
      on other is {
        error "Unexpected message for processor MeterEventSplit"
      }
    } with {
      briefly "Meter event fan-out handler"
      described as {
        |Delivers each Meter event to all of its consumers.
      }
    }
  } with {
    briefly "Meter event fan-out"
    described as {
      |Fans Meter events out to the repository and projectors.
    }
  }
  connector 'MeterEvent Stream' is from outlet MeteringContext.Meter.MeterEvents2 to inlet MeteringContext.MeterEventSplit.MeterEventSplitIn with {
    briefly "Meter events, fanned out to storage and read models"
  }
  connector 'MeteringAnalytics Feed' is from outlet MeteringContext.MeterEventSplit.MeterEventSplitToMeteringAnalytics to inlet MeteringContext.MeteringAnalytics.MeteringAnalyticsFromMeter with {
    briefly "Meter events feeding the MeteringAnalytics projection"
  }
  connector 'MeteringAnalytics Storage' is from outlet MeteringContext.MeteringAnalytics.MeteringAnalyticsToRepository to inlet MeteringContext.MeteringRepository.MeteringRepositoryFromMeteringAnalytics with {
    briefly "MeteringAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for smart metering"
  described as {
    |Advanced metering infrastructure context.
  }
}
