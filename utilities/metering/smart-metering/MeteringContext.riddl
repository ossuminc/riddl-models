// Smart Metering - Metering Context
context MeteringContext is {
  adaptor FromBillingSystem from context BillingSystem is {
    handler FromBillingSystemHandler is {
      on event BillingSystem.UsageAccepted is {
        do "the model receives usage accepted"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingSystem"
      }
    } with {
      briefly "from billing system"
      described as {
        |Carries messages from the external BillingSystem.
      }
    }
  } with {
      briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor ToBillingSystem to context BillingSystem is {
    handler ToBillingSystemHandler is {
      on command BillingSystem.SubmitValidatedUsage is {
        do "the model sends submit validated usage"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingSystem"
      }
    } with {
      briefly "to billing system"
      described as {
        |Carries messages to the external BillingSystem.
      }
    }
  } with {
      briefly "BillingSystem integration"
    described as {
      |The model's side of the BillingSystem conversation.
    }
  }
  adaptor FromHeadEndSystem from context HeadEndSystem is {
    handler FromHeadEndSystemHandler is {
      on event HeadEndSystem.MeterResponseReceived is {
        do "the model receives meter response received"
      }
      on result HeadEndSystem.MeterStatusResult is {
        do "the model receives meter status result"
      }
      on other is {
        error "Unexpected message for adaptor FromHeadEndSystem"
      }
    } with {
      briefly "from head end system"
      described as {
        |Carries messages from the external HeadEndSystem.
      }
    }
  } with {
      briefly "HeadEndSystem integration"
    described as {
      |The model's side of the HeadEndSystem conversation.
    }
  }
  adaptor ToHeadEndSystem to context HeadEndSystem is {
    handler ToHeadEndSystemHandler is {
      on query HeadEndSystem.GetMeterStatus is {
        do "the model sends get meter status"
      }
      on command HeadEndSystem.PollMeter is {
        do "the model sends poll meter"
      }
      on command HeadEndSystem.SendDisconnectCommand is {
        do "the model sends send disconnect command"
      }
      on command HeadEndSystem.SendReconnectCommand is {
        do "the model sends send reconnect command"
      }
      on other is {
        error "Unexpected message for adaptor ToHeadEndSystem"
      }
    } with {
      briefly "to head end system"
      described as {
        |Carries messages to the external HeadEndSystem.
      }
    }
  } with {
      briefly "HeadEndSystem integration"
    described as {
      |The model's side of the HeadEndSystem conversation.
    }
  }
  adaptor FromMeterDataManagement from context MeterDataManagement is {
    handler FromMeterDataManagementHandler is {
      on result MeterDataManagement.ValidationResult is {
        do "the model receives validation result"
      }
      on other is {
        error "Unexpected message for adaptor FromMeterDataManagement"
      }
    } with {
      briefly "from meter data management"
      described as {
        |Carries messages from the external MeterDataManagement.
      }
    }
  } with {
      briefly "MeterDataManagement integration"
    described as {
      |The model's side of the MeterDataManagement conversation.
    }
  }
  adaptor ToMeterDataManagement to context MeterDataManagement is {
    handler ToMeterDataManagementHandler is {
      on command MeterDataManagement.EstimateMissing is {
        do "the model sends estimate missing"
      }
      on query MeterDataManagement.GetValidation is {
        do "the model sends get validation"
      }
      on command MeterDataManagement.ValidateReading is {
        do "the model sends validate reading"
      }
      on other is {
        error "Unexpected message for adaptor ToMeterDataManagement"
      }
    } with {
      briefly "to meter data management"
      described as {
        |Carries messages to the external MeterDataManagement.
      }
    }
  } with {
      briefly "MeterDataManagement integration"
    described as {
      |The model's side of the MeterDataManagement conversation.
    }
  }
  adaptor FromOutageManagement from context OutageManagement is {
    handler FromOutageManagementHandler is {
      on event OutageManagement.OutageConfirmed is {
        do "the model receives outage confirmed"
      }
      on other is {
        error "Unexpected message for adaptor FromOutageManagement"
      }
    } with {
      briefly "from outage management"
      described as {
        |Carries messages from the external OutageManagement.
      }
    }
  } with {
      briefly "OutageManagement integration"
    described as {
      |The model's side of the OutageManagement conversation.
    }
  }
  adaptor ToOutageManagement to context OutageManagement is {
    handler ToOutageManagementHandler is {
      on command OutageManagement.ReportMeterOutage is {
        do "the model sends report meter outage"
      }
      on command OutageManagement.ReportRestoration is {
        do "the model sends report restoration"
      }
      on other is {
        error "Unexpected message for adaptor ToOutageManagement"
      }
    } with {
      briefly "to outage management"
      described as {
        |Carries messages to the external OutageManagement.
      }
    }
  } with {
      briefly "OutageManagement integration"
    described as {
      |The model's side of the OutageManagement conversation.
    }
  }
  include "types.riddl"
  include "Meter.riddl"
  repository MeteringRepository is {
    inlet MeteringRepositoryFromMeter is type MeterEvent
    inlet MeteringRepositoryFromMeteringAnalytics is type MeterEvent
    outlet MeteringRepositoryResponses is type Meter.MeterResult
    record StoredMeter is {
      meterId: MeterId with {
        briefly "meterId"
        described as {
          |The meterId column of the stored meter row.
        }
      }
      accountId: AccountId with {
        briefly "accountId"
        described as {
          |The accountId column of the stored meter row.
        }
      }
      meterInfo: MeterInfo with {
        briefly "meterInfo"
        described as {
          |The meterInfo column of the stored meter row.
        }
      }
      status: MeterStatus with {
        briefly "status"
        described as {
          |The status column of the stored meter row.
        }
      }
    } with {
      briefly "Stored meter row"
      described as {
        |The persistence shape of meter data as this repository stores it.
      }
    }
    schema MeteringData is relational
      of meters as type StoredMeter
        index on field StoredMeter.meterId
        index on field StoredMeter.accountId
        index on field StoredMeter.status
        index on field StoredMeter.meterInfo.serialNumber
      with {
      briefly "Metering data schema"
      described as {
        |The relational schema holding metering data for the MeteringRepository.
      }
    }

    handler MeteringPersistence is {
      on query GetNetworkHealth is {
        do "read the network health projection"
        yield result NetworkHealthView
      }
      on command Meter.InstallMeter is {
        do "Store new meter record"
      }
      on command Meter.RecordReading is {
        tell event Meter.ReadingRecorded to entity MeteringContext.Meter
        do "Store meter reading"
      }
      on command Meter.RecordIntervalData is {
        tell event Meter.IntervalDataRecorded to entity MeteringContext.Meter
        do "Store interval data"
      }
      on command Meter.RaiseAlert is {
        do "Store meter alert"
      }
      on command Meter.DecommissionMeter is {
        do "Update meter to decommissioned"
      }
    } with {
      briefly "Persists metering commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Metering data persistence"
    described as {
      |Persistent storage for meters.
    }
  }
  query GetNetworkHealth is {
    networkHealthKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which network health to retrieve.
      }
    }
  } with {
    briefly "Get network health"
    described as {
      |Retrieves the network health projection.
    }
  }
  result NetworkHealthView is {
    networkHealth: MeteringAnalytics.NetworkHealth with {
      briefly "Network health"
      described as {
        |The network health being returned.
      }
    }
  } with {
    briefly "Network health view"
    described as {
      |Read model view carrying the network health projection.
    }
  }
  projector MeteringAnalytics is {
    inlet MeteringAnalyticsFromMeter is type MeterEvent
    outlet MeteringAnalyticsOut is type MeterEvent
    updates repository MeteringContext.MeteringRepository
    record NetworkHealth is  {
      totalMeters: Natural with {
        briefly "Total"
        described as {
          |Total meters.
        }
      }
      activeMeters: Natural with {
        briefly "Active"
        described as {
          |Active meters.
        }
      }
      communicatingMeters: Natural with {
        briefly "Communicating"
        described as {
          |Meters online.
        }
      }
      alertCount: Natural with {
        briefly "Alerts"
        described as {
          |Active alerts.
        }
      }
      avgSignalStrength: Decimal(5,2) with {
        briefly "Signal"
        described as {
          |Avg signal strength.
        }
      }
    } with {
      briefly "Network health"
      described as {
        |AMI network health metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Meter.MeterInstalled is {
        tell event Meter.MeterInstalled to repository MeteringContext.MeteringRepository
        do "Update meter counts"
      }
      on event Meter.CommunicationUpdated is {
        tell event Meter.CommunicationUpdated to repository MeteringContext.MeteringRepository
        do "Update communication statistics"
      }
      on event Meter.AlertRaised is {
        tell event Meter.AlertRaised to repository MeteringContext.MeteringRepository
        do "Increment alert count"
      }
      on event Meter.AlertResolved is {
        tell event Meter.AlertResolved to repository MeteringContext.MeteringRepository
        do "Decrement alert count"
      }
    } with {
      briefly "Maintains metering analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Metering analytics"
    described as {
      |AMI network monitoring.
    }
  }
  // ---- Event publication for Meter ----
  type MeterEvent is one of {
    MeteringContext.Meter.MeterInstalled,
    MeteringContext.Meter.MeterActivated,
    MeteringContext.Meter.ReadingRecorded,
    MeteringContext.Meter.IntervalDataRecorded,
    MeteringContext.Meter.AlertRaised,
    MeteringContext.Meter.AlertResolved,
    MeteringContext.Meter.CommunicationUpdated,
    MeteringContext.Meter.MaintenanceScheduled,
    MeteringContext.Meter.MeterDisconnected,
    MeteringContext.Meter.MeterReconnected,
    MeteringContext.Meter.MeterDecommissioned
  } with {
    briefly "Meter event alternation"
    described as {
      |Union of all Meter events, for streaming and event-sourced
      |persistence.
    }
  }
  processor MeterEventSource as source is {
    outlet MeterEvents is type MeterEvent
    handler MeterSourceHandler is {
      on event Meter.MeterInstalled is {
        send event Meter.MeterInstalled to outlet MeterEvents
      }
      on event Meter.MeterActivated is {
        send event Meter.MeterActivated to outlet MeterEvents
      }
      on event Meter.ReadingRecorded is {
        send event Meter.ReadingRecorded to outlet MeterEvents
      }
      on event Meter.IntervalDataRecorded is {
        send event Meter.IntervalDataRecorded to outlet MeterEvents
      }
      on event Meter.AlertRaised is {
        send event Meter.AlertRaised to outlet MeterEvents
      }
      on event Meter.AlertResolved is {
        send event Meter.AlertResolved to outlet MeterEvents
      }
      on event Meter.CommunicationUpdated is {
        send event Meter.CommunicationUpdated to outlet MeterEvents
      }
      on event Meter.MaintenanceScheduled is {
        send event Meter.MaintenanceScheduled to outlet MeterEvents
      }
      on event Meter.MeterDisconnected is {
        send event Meter.MeterDisconnected to outlet MeterEvents
      }
      on event Meter.MeterReconnected is {
        send event Meter.MeterReconnected to outlet MeterEvents
      }
      on event Meter.MeterDecommissioned is {
        send event Meter.MeterDecommissioned to outlet MeterEvents
      }
      on other is {
        error "Unexpected message for source MeterEventSource"
      }
    } with {
      briefly "Meter source handler"
      described as {
        |Publishes Meter events onto the outlet.
      }
    }
  } with {
    briefly "Meter event source"
    described as {
      |Publishes Meter entity events into the streaming topology.
    }
  }
  processor MeterEventSink as sink is {
    inlet MeterInlet is type MeterEvent
    handler MeterSinkHandler is {
      on event Meter.MeterInstalled is {
        tell event Meter.MeterInstalled to repository MeteringContext.MeteringRepository
      }
      on event Meter.MeterActivated is {
        tell event Meter.MeterActivated to repository MeteringContext.MeteringRepository
      }
      on event Meter.ReadingRecorded is {
        tell event Meter.ReadingRecorded to repository MeteringContext.MeteringRepository
      }
      on event Meter.IntervalDataRecorded is {
        tell event Meter.IntervalDataRecorded to repository MeteringContext.MeteringRepository
      }
      on event Meter.AlertRaised is {
        tell event Meter.AlertRaised to repository MeteringContext.MeteringRepository
      }
      on event Meter.AlertResolved is {
        tell event Meter.AlertResolved to repository MeteringContext.MeteringRepository
      }
      on event Meter.CommunicationUpdated is {
        tell event Meter.CommunicationUpdated to repository MeteringContext.MeteringRepository
      }
      on event Meter.MaintenanceScheduled is {
        tell event Meter.MaintenanceScheduled to repository MeteringContext.MeteringRepository
      }
      on event Meter.MeterDisconnected is {
        tell event Meter.MeterDisconnected to repository MeteringContext.MeteringRepository
      }
      on event Meter.MeterReconnected is {
        tell event Meter.MeterReconnected to repository MeteringContext.MeteringRepository
      }
      on event Meter.MeterDecommissioned is {
        tell event Meter.MeterDecommissioned to repository MeteringContext.MeteringRepository
      }
      on other is {
        error "Unexpected message for sink MeterEventSink"
      }
    } with {
      briefly "Meter sink handler"
      described as {
        |Persists Meter events via the repository.
      }
    }
  } with {
    briefly "Meter event sink"
    described as {
      |Receives Meter events for persistence.
    }
  }
  connector MeterEventFlow is {
    from outlet MeteringContext.MeterEventSource.MeterEvents to
      inlet MeteringContext.MeterEventSink.MeterInlet
  } with {
    briefly "Meter event flow"
    described as {
      |Connects the Meter source to its sink.
    }
  }
  processor MeterEventSplit is {
    inlet MeterEventSplitIn is type MeterEvent
    outlet MeterEventSplitToMeteringRepository is type MeterEvent
    outlet MeterEventSplitToMeteringAnalytics is type MeterEvent
    handler MeterEventSplitHandler is {
      on event Meter.MeterInstalled is {
        send event Meter.MeterInstalled to outlet MeterEventSplitToMeteringRepository
        send event Meter.MeterInstalled to outlet MeterEventSplitToMeteringAnalytics
        tell event Meter.MeterInstalled to entity MeteringContext.Meter
      }
      on event Meter.MeterActivated is {
        send event Meter.MeterActivated to outlet MeterEventSplitToMeteringRepository
        send event Meter.MeterActivated to outlet MeterEventSplitToMeteringAnalytics
        tell event Meter.MeterActivated to entity MeteringContext.Meter
      }
      on event Meter.ReadingRecorded is {
        send event Meter.ReadingRecorded to outlet MeterEventSplitToMeteringRepository
        send event Meter.ReadingRecorded to outlet MeterEventSplitToMeteringAnalytics
        tell event Meter.ReadingRecorded to entity MeteringContext.Meter
      }
      on event Meter.IntervalDataRecorded is {
        send event Meter.IntervalDataRecorded to outlet MeterEventSplitToMeteringRepository
        send event Meter.IntervalDataRecorded to outlet MeterEventSplitToMeteringAnalytics
        tell event Meter.IntervalDataRecorded to entity MeteringContext.Meter
      }
      on event Meter.AlertRaised is {
        send event Meter.AlertRaised to outlet MeterEventSplitToMeteringRepository
        send event Meter.AlertRaised to outlet MeterEventSplitToMeteringAnalytics
        tell event Meter.AlertRaised to entity MeteringContext.Meter
      }
      on event Meter.AlertResolved is {
        send event Meter.AlertResolved to outlet MeterEventSplitToMeteringRepository
        send event Meter.AlertResolved to outlet MeterEventSplitToMeteringAnalytics
        tell event Meter.AlertResolved to entity MeteringContext.Meter
      }
      on event Meter.CommunicationUpdated is {
        send event Meter.CommunicationUpdated to outlet MeterEventSplitToMeteringRepository
        send event Meter.CommunicationUpdated to outlet MeterEventSplitToMeteringAnalytics
        tell event Meter.CommunicationUpdated to entity MeteringContext.Meter
      }
      on event Meter.MaintenanceScheduled is {
        send event Meter.MaintenanceScheduled to outlet MeterEventSplitToMeteringRepository
        send event Meter.MaintenanceScheduled to outlet MeterEventSplitToMeteringAnalytics
        tell event Meter.MaintenanceScheduled to entity MeteringContext.Meter
      }
      on event Meter.MeterDisconnected is {
        send event Meter.MeterDisconnected to outlet MeterEventSplitToMeteringRepository
        send event Meter.MeterDisconnected to outlet MeterEventSplitToMeteringAnalytics
        tell event Meter.MeterDisconnected to entity MeteringContext.Meter
      }
      on event Meter.MeterReconnected is {
        send event Meter.MeterReconnected to outlet MeterEventSplitToMeteringRepository
        send event Meter.MeterReconnected to outlet MeterEventSplitToMeteringAnalytics
        tell event Meter.MeterReconnected to entity MeteringContext.Meter
      }
      on event Meter.MeterDecommissioned is {
        send event Meter.MeterDecommissioned to outlet MeterEventSplitToMeteringRepository
        send event Meter.MeterDecommissioned to outlet MeterEventSplitToMeteringAnalytics
        tell event Meter.MeterDecommissioned to entity MeteringContext.Meter
      }
      on other is {
        error "Unexpected message for processor MeterEventSplit"
      }
    } with {
      briefly "Meter event fan-out handler"
      described as {
        |Delivers each Meter event to all of its consumers.
      }
    }
  } with {
    briefly "Meter event fan-out"
    described as {
      |Fans Meter events out to the repository and projectors.
    }
  }
  connector LinkMeterToMeterEventSplit is {
    from outlet MeteringContext.Meter.MeterEvents2 to
      inlet MeteringContext.MeterEventSplit.MeterEventSplitIn
  } with {
    briefly "LinkMeterToMeterEventSplit"
  }
  connector LinkMeterEventSplitToMeteringRepository is {
    from outlet MeteringContext.MeterEventSplit.MeterEventSplitToMeteringRepository to
      inlet MeteringContext.MeteringRepository.MeteringRepositoryFromMeter
  } with {
    briefly "LinkMeterEventSplitToMeteringRepository"
  }
  connector LinkMeterEventSplitToMeteringAnalytics is {
    from outlet MeteringContext.MeterEventSplit.MeterEventSplitToMeteringAnalytics to
      inlet MeteringContext.MeteringAnalytics.MeteringAnalyticsFromMeter
  } with {
    briefly "LinkMeterEventSplitToMeteringAnalytics"
  }
  connector LinkMeteringAnalyticsToMeteringRepository is {
    from outlet MeteringContext.MeteringAnalytics.MeteringAnalyticsOut to
      inlet MeteringContext.MeteringRepository.MeteringRepositoryFromMeteringAnalytics
  } with {
    briefly "LinkMeteringAnalyticsToMeteringRepository"
  }
} with {
  briefly "Bounded context for smart metering"
  described as {
    |Advanced metering infrastructure context.
  }
}
