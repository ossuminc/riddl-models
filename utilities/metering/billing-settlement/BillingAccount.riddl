// Billing Settlement - BillingAccount Entity
entity BillingAccount as flow is {
  type BillingAccountCommand is one of {
    BillingAccount.CreateAccount or BillingAccount.SubmitMeterReading or BillingAccount.CalculateUsage or BillingAccount.GenerateBill or BillingAccount.RecordPayment or BillingAccount.InitiateSettlement or BillingAccount.DisputeBill or BillingAccount.CloseAccount
  } with {
    briefly "BillingAccount command alternation"
    described as {
      |Commands accepted by the BillingAccount entity.
    }
  }
  inlet BillingAccountCommands is type BillingAccountCommand  outlet BillingAccountEvents2 is type BillingAccountEvent
  query GetBillingAccount replies result BillingAccountResult is  {
    billingAccountId: BillingAccountId with {
      briefly "ID"
      described as {
        |Identifier of the BillingAccount to retrieve.
      }
    }
  } with {
    briefly "Get BillingAccount"
    described as {
      |Retrieve BillingAccount data by identifier.
    }
  }
  result BillingAccountResult is  {
    billingAccountId: BillingAccountId with {
      briefly "BillingAccount addressed"
      described as {
        |Which billingaccount this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    billingAccountData: BillingAccount.ActiveStateData with {
      briefly "BillingAccount data"
      described as {
        |The requested BillingAccount data.
      }
    }
  } with {
    briefly "BillingAccount result"
    described as {
      |Result carrying the requested BillingAccount data.
    }
  }
  command CreateAccount is  {
    accountId: BillingAccountId with {
      briefly "Account ID"
      described as {
        |New billing account identifier.
      }
    }
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer identifier.
      }
    }
    meterId: MeterId with {
      briefly "Meter"
      described as {
        |Associated meter identifier.
      }
    }
    rateSchedule: RateSchedule with {
      briefly "Rate"
      described as {
        |Applicable rate schedule.
      }
    }
    serviceAddress: String(3,300) with {
      briefly "Address"
      described as {
        |Service address.
      }
    }
  } with {
    briefly "Create account"
    described as {
      |Creates a new billing account.
    }
  }
  command SubmitMeterReading is  {
    accountId: BillingAccountId with {
      briefly "Account ID"
      described as {
        |Billing account identifier.
      }
    }
    reading: MeterReading with {
      briefly "Reading"
      described as {
        |Meter reading data.
      }
    }
  } with {
    briefly "Submit meter reading"
    described as {
      |Submits a meter reading for validation.
    }
  }
  command CalculateUsage is  {
    accountId: BillingAccountId with {
      briefly "Account ID"
      described as {
        |Billing account identifier.
      }
    }
    periodStart: Date with {
      briefly "Start"
      described as {
        |Billing period start.
      }
    }
    periodEnd: Date with {
      briefly "End"
      described as {
        |Billing period end.
      }
    }
  } with {
    briefly "Calculate usage"
    described as {
      |Calculates usage for a billing period.
    }
  }
  command GenerateBill is  {
    accountId: BillingAccountId with {
      briefly "Account ID"
      described as {
        |Billing account identifier.
      }
    }
    usage: UsageCalculation with {
      briefly "Usage"
      described as {
        |Calculated usage data.
      }
    }
    rateSchedule: RateSchedule with {
      briefly "Rate"
      described as {
        |Rate schedule to apply.
      }
    }
  } with {
    briefly "Generate bill"
    described as {
      |Generates a bill from usage and rates.
    }
  }
  command RecordPayment is  {
    accountId: BillingAccountId with {
      briefly "Account ID"
      described as {
        |Billing account identifier.
      }
    }
    payment: PaymentRecord with {
      briefly "Payment"
      described as {
        |Payment details.
      }
    }
  } with {
    briefly "Record payment"
    described as {
      |Records a payment against an invoice.
    }
  }
  command InitiateSettlement is  {
    accountId: BillingAccountId with {
      briefly "Account ID"
      described as {
        |Billing account identifier.
      }
    }
    settlement: SupplierSettlement with {
      briefly "Settlement"
      described as {
        |Supplier settlement details.
      }
    }
  } with {
    briefly "Initiate settlement"
    described as {
      |Initiates settlement with energy supplier.
    }
  }
  command DisputeBill is  {
    accountId: BillingAccountId with {
      briefly "Account ID"
      described as {
        |Billing account identifier.
      }
    }
    invoiceId: InvoiceId with {
      briefly "Invoice"
      described as {
        |Disputed invoice identifier.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Dispute reason.
      }
    }
  } with {
    briefly "Dispute bill"
    described as {
      |Records a billing dispute.
    }
  }
  command CloseAccount is  {
    accountId: BillingAccountId with {
      briefly "Account ID"
      described as {
        |Billing account identifier.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Closure reason.
      }
    }
    finalReadingDate: Date with {
      briefly "Final reading"
      described as {
        |Date of final meter reading.
      }
    }
  } with {
    briefly "Close account"
    described as {
      |Closes a billing account.
    }
  }
  // Events
  event AccountCreated is  {
    accountId: BillingAccountId with {
      briefly "Account"
      described as {
        |Account ID.
      }
    }
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Account created"
    described as {
      |Emitted when billing account is created.
    }
  }
  event MeterReadingSubmitted is  {
    accountId: BillingAccountId with {
      briefly "Account"
      described as {
        |Account ID.
      }
    }
    reading: MeterReading with {
      briefly "Reading"
      described as {
        |Meter reading.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Meter reading submitted"
    described as {
      |Emitted when meter reading is submitted.
    }
  }
  event UsageCalculated is  {
    accountId: BillingAccountId with {
      briefly "Account"
      described as {
        |Account ID.
      }
    }
    usage: UsageCalculation with {
      briefly "Usage"
      described as {
        |Usage data.
      }
    }
    calculatedAt: TimeStamp with {
      briefly "Calculated"
      described as {
        |Calculation time.
      }
    }
  } with {
    briefly "Usage calculated"
    described as {
      |Emitted when usage is calculated.
    }
  }
  event BillGenerated is  {
    accountId: BillingAccountId with {
      briefly "Account"
      described as {
        |Account ID.
      }
    }
    invoice: InvoiceSummary with {
      briefly "Invoice"
      described as {
        |Invoice summary.
      }
    }
    generatedAt: TimeStamp with {
      briefly "Generated"
      described as {
        |Generation time.
      }
    }
  } with {
    briefly "Bill generated"
    described as {
      |Emitted when a bill is generated.
    }
  }
  event PaymentRecorded is  {
    accountId: BillingAccountId with {
      briefly "Account"
      described as {
        |Account ID.
      }
    }
    payment: PaymentRecord with {
      briefly "Payment"
      described as {
        |Payment record.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Recording time.
      }
    }
  } with {
    briefly "Payment recorded"
    described as {
      |Emitted when payment is recorded.
    }
  }
  event SettlementInitiated is  {
    accountId: BillingAccountId with {
      briefly "Account"
      described as {
        |Account ID.
      }
    }
    settlement: SupplierSettlement with {
      briefly "Settlement"
      described as {
        |Settlement data.
      }
    }
    initiatedAt: TimeStamp with {
      briefly "Initiated"
      described as {
        |Initiation time.
      }
    }
  } with {
    briefly "Settlement initiated"
    described as {
      |Emitted when supplier settlement is initiated.
    }
  }
  event BillDisputed is  {
    accountId: BillingAccountId with {
      briefly "Account"
      described as {
        |Account ID.
      }
    }
    invoiceId: InvoiceId with {
      briefly "Invoice"
      described as {
        |Invoice ID.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Dispute reason.
      }
    }
    disputedAt: TimeStamp with {
      briefly "Disputed"
      described as {
        |Dispute time.
      }
    }
  } with {
    briefly "Bill disputed"
    described as {
      |Emitted when a bill is disputed.
    }
  }
  event AccountClosed is  {
    accountId: BillingAccountId with {
      briefly "Account"
      described as {
        |Account ID.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Closure reason.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed"
      described as {
        |Closure time.
      }
    }
  } with {
    briefly "Account closed"
    described as {
      |Emitted when billing account is closed.
    }
  }
  // States
  record ActiveStateData is  {
    accountId: BillingAccountId with {
      briefly "Account"
      described as {
        |Account ID.
      }
    }
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    meterId: MeterId with {
      briefly "Meter"
      described as {
        |Meter ID.
      }
    }
    rateSchedule: RateSchedule with {
      briefly "Rate"
      described as {
        |Rate schedule.
      }
    }
    serviceAddress: String(3,300) with {
      briefly "Address"
      described as {
        |Service address.
      }
    }
    status: AccountStatus with {
      briefly "Status"
      described as {
        |Account status.
      }
    }
    meterReadings: MeterReading* with {
      briefly "Readings"
      described as {
        |Meter readings.
      }
    }
    invoices: InvoiceSummary* with {
      briefly "Invoices"
      described as {
        |Generated invoices.
      }
    }
    payments: PaymentRecord* with {
      briefly "Payments"
      described as {
        |Payment records.
      }
    }
    settlements: SupplierSettlement* with {
      briefly "Settlements"
      described as {
        |Supplier settlements.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Active account state"
    described as {
      |State for an active billing account.
    }
  }
  record ClosedStateData is  {
    accountId: BillingAccountId with {
      briefly "Account"
      described as {
        |Account ID.
      }
    }
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed"
      described as {
        |Closure time.
      }
    }
    finalBalance: Decimal(10,2) with {
      briefly "Balance"
      described as {
        |Final balance.
      }
    }
  } with {
    briefly "Closed account state"
    described as {
      |State for a closed billing account.
    }
  }
  initial state ActiveState of record BillingAccount.ActiveStateData is {
    initial handler ActiveStateInitHandler is {
      on query GetBillingAccount is {
        let billingAccountResult: type BillingAccountResult = prompt("read the billing account from the store")
        reply billingAccountResult
      }
      on init is {
        set state ActiveState to "initialize BillingAccount.ActiveStateData fields from the creating message"
      }
    } with {
      briefly "ActiveState initialization"
      described as {
        |Initializes ActiveState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |The active state of the BillingAccount entity, carrying ActiveStateData.
    }
  }
  state ClosedState of record BillingAccount.ClosedStateData with {
    briefly "Closed state"
    described as {
      |The closed state of the BillingAccount entity, carrying ClosedStateData.
    }
  }
  handler BillingAccountHandler is {
    on init is {
      set state ClosedState to "initialize BillingAccount.ClosedStateData fields from the creating message"
    }
    on createAccount: command CreateAccount is {
      morph entity BillingSettlementContext.BillingAccount to state BillingSettlementContext.BillingAccount.ActiveState with record BillingAccount.ActiveStateData(accountId = createAccount.accountId, customerId = createAccount.customerId, meterId = createAccount.meterId, rateSchedule = createAccount.rateSchedule, serviceAddress = createAccount.serviceAddress, status = prompt("the status of this active state data"), meterReadings = empty, invoices = empty, payments = empty, settlements = empty, createdAt = prompt("the created at of this active state data"))
      tell event AccountCreated(accountId = createAccount.accountId, customerId = createAccount.customerId, createdAt = prompt("the created at of this account created")) to entity BillingSettlementContext.BillingAccount
    }
    on submitMeterReading: command SubmitMeterReading is {
      tell event MeterReadingSubmitted(accountId = submitMeterReading.accountId, reading = submitMeterReading.reading, submittedAt = prompt("the submitted at of this meter reading submitted")) to entity BillingSettlementContext.BillingAccount
    }
    on calculateUsage: command CalculateUsage is {
      tell event UsageCalculated(accountId = calculateUsage.accountId, usage = prompt("the usage of this usage calculated"), calculatedAt = prompt("the calculated at of this usage calculated")) to entity BillingSettlementContext.BillingAccount
    }
    on generateBill: command GenerateBill is {
      tell event BillGenerated(accountId = generateBill.accountId, invoice = prompt("the invoice of this bill generated"), generatedAt = prompt("the generated at of this bill generated")) to entity BillingSettlementContext.BillingAccount
    }
    on recordPayment: command RecordPayment is {
      tell event PaymentRecorded(accountId = recordPayment.accountId, payment = recordPayment.payment, recordedAt = prompt("the recorded at of this payment recorded")) to entity BillingSettlementContext.BillingAccount
    }
    on initiateSettlement: command InitiateSettlement is {
      tell event SettlementInitiated(accountId = initiateSettlement.accountId, settlement = initiateSettlement.settlement, initiatedAt = prompt("the initiated at of this settlement initiated")) to entity BillingSettlementContext.BillingAccount
    }
    on disputeBill: command DisputeBill is {
      tell event BillDisputed(accountId = disputeBill.accountId, invoiceId = disputeBill.invoiceId, reason = disputeBill.reason, disputedAt = prompt("the disputed at of this bill disputed")) to entity BillingSettlementContext.BillingAccount
    }
    on closeAccount: command CloseAccount is {
      morph entity BillingSettlementContext.BillingAccount to state BillingSettlementContext.BillingAccount.ClosedState with record BillingAccount.ClosedStateData(accountId = closeAccount.accountId, customerId = prompt("the customer id of this closed state data"), closedAt = prompt("the closed at of this closed state data"), finalBalance = prompt("the final balance of this closed state data"))
      tell event AccountClosed(accountId = closeAccount.accountId, reason = closeAccount.reason, closedAt = prompt("the closed at of this account closed")) to entity BillingSettlementContext.BillingAccount
    }
    on accountClosed: event AccountClosed is {
      do "apply AccountClosed to the billingAccount so it can be persisted and replayed"
    }
    on accountCreated: event AccountCreated is {
      do "apply AccountCreated to the billingAccount so it can be persisted and replayed"
    }
    on billDisputed: event BillDisputed is {
      do "apply BillDisputed to the billingAccount so it can be persisted and replayed"
    }
    on billGenerated: event BillGenerated is {
      do "apply BillGenerated to the billingAccount so it can be persisted and replayed"
    }
    on meterReadingSubmitted: event MeterReadingSubmitted is {
      do "apply MeterReadingSubmitted to the billingAccount so it can be persisted and replayed"
    }
    on paymentRecorded: event PaymentRecorded is {
      do "apply PaymentRecorded to the billingAccount so it can be persisted and replayed"
    }
    on settlementInitiated: event SettlementInitiated is {
      do "apply SettlementInitiated to the billingAccount so it can be persisted and replayed"
    }
    on usageCalculated: event UsageCalculated is {
      do "apply UsageCalculated to the billingAccount so it can be persisted and replayed"
    }
  } with {
    briefly "Processes billing account commands"
    described as {
      |Handles billing account lifecycle.
    }
  }
} with {
  briefly "BillingAccount aggregate"
  described as {
    |Manages utility billing accounts.
  }
}
