// Billing Settlement Domain Model
// Utility billing settlement, meter data validation, and energy supplier settlement
domain BillingSettlement is {
  persistent connector 'MeterDataSystemReply Stream' is from outlet MeterDataSystem.MeterDataSystemRepliesOut to inlet BillingSettlementContext.ToMeterDataSystem.ToMeterDataSystemReplies with {
    briefly "What MeterDataSystem answers BillingSettlementContext"
  }
  persistent connector 'EnergySupplierGatewayReply Stream' is from outlet EnergySupplierGateway.EnergySupplierGatewayRepliesOut to inlet BillingSettlementContext.ToEnergySupplierGateway.ToEnergySupplierGatewayReplies with {
    briefly "What EnergySupplierGateway answers BillingSettlementContext"
  }
  persistent connector 'EnergySupplierGatewayEvent Stream' is from outlet EnergySupplierGateway.EnergySupplierGatewayEventsOut to inlet BillingSettlementContext.FromEnergySupplierGateway.FromEnergySupplierGatewayIn with {
    briefly "What EnergySupplierGateway tells BillingSettlementContext, unasked"
  }
  persistent connector 'MeterDataSystemEvent Stream' is from outlet MeterDataSystem.MeterDataSystemEventsOut to inlet BillingSettlementContext.FromMeterDataSystem.FromMeterDataSystemIn with {
    briefly "What MeterDataSystem tells BillingSettlementContext, unasked"
  }
  persistent connector 'PaymentProcessorEvent Stream' is from outlet PaymentProcessor.PaymentProcessorEventsOut to inlet BillingSettlementContext.FromPaymentProcessor.FromPaymentProcessorIn with {
    briefly "What PaymentProcessor tells BillingSettlementContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user BillingAnalyst is "person reviewing and approving utility bills" with {
    briefly "Billing Analyst"
    described as {
      |Analyst reviewing meter data and billing accuracy.
    }
  }
  user SettlementOfficer is "person managing supplier settlements" with {
    briefly "Settlement Officer"
    described as {
      |Officer handling energy supplier payment reconciliation.
    }
  }
  user CustomerAccountRep is "person assisting customers with billing" with {
    briefly "Customer Account Rep"
    described as {
      |Representative helping customers with billing inquiries.
    }
  }
  epic BillGeneration is {
    user BillingAnalyst wants to "to generate accurate utility bills" so that "customers are billed correctly for their energy usage"
    case GenerateMonthlyBill is {
      user BillingAnalyst wants to "to generate a monthly bill" so that "customer receives an accurate invoice"
      step is "System validates" "meter readings" "for billing period" with {
        briefly "Validate readings"
        described as {
          |Validate meter data.
        }
      }
      step is "System calculates" "usage and charges" "from rate schedule" with {
        briefly "Calculate charges"
        described as {
          |Apply rate schedule.
        }
      }
    } with {
      briefly "Generate monthly bill"
      described as {
        |Creating a monthly utility bill from meter data.
      }
    }
  } with {
    briefly "Bill generation"
    described as {
      |Epic for utility billing settlement.
    }
  }
  include "BillingSettlementContext.riddl"
  include "external-contexts.riddl"
  application context BillingSettlementApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in BillingSettlement are delivered.
      }
    }
    group BillingSettlementScreen is {
      input GetRevenueMetricsInput acquires query BillingSettlementContext.GetRevenueMetrics with {
        briefly "Get revenue metrics control"
        described as {
          |The control through which a user asks the get revenue metrics question.
        }
      }
      input GetBillingAccountInput acquires query BillingSettlementContext.BillingAccount.GetBillingAccount with {
        briefly "Get billing account control"
        described as {
          |The control through which a user asks the get billing account question.
        }
      }
      input CloseAccountInput acquires command BillingSettlementContext.BillingAccount.CloseAccount with {
        briefly "Close account control"
        described as {
          |The control through which a user submits the close account request.
        }
      }
      input DisputeBillInput acquires command BillingSettlementContext.BillingAccount.DisputeBill with {
        briefly "Dispute bill control"
        described as {
          |The control through which a user submits the dispute bill request.
        }
      }
      input InitiateSettlementInput acquires command BillingSettlementContext.BillingAccount.InitiateSettlement with {
        briefly "Initiate settlement control"
        described as {
          |The control through which a user submits the initiate settlement request.
        }
      }
      input CreateAccountInput acquires command BillingSettlementContext.CreateAccount with {
        briefly "Create account control"
        described as {
          |The control through which a user submits the create account request.
        }
      }
    } with {
      briefly "Billing settlement screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppBillingRepositoryQueries is query BillingSettlementContext.GetRevenueMetrics
    inlet AppBillingRepositoryReplies is result BillingSettlementContext.RevenueMetricsView
    outlet AppBillingAccountQueries is query BillingSettlementContext.BillingAccount.GetBillingAccount
    outlet AppBillingAccountCommands is type BillingSettlementContext.BillingAccountRequest
    inlet AppBillingRepositoryResponses is result BillingSettlementContext.BillingAccount.BillingAccountResult
    handler BillingSettlementAppHandler is {
      on other is {
        error "Unexpected message for application context BillingSettlementApp"
      }
    } with {
      briefly "BillingSettlementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "BillingSettlementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'MeterDataSystemRequest Stream' is from outlet BillingSettlementContext.ToMeterDataSystem.ToMeterDataSystemOut to inlet MeterDataSystem.MeterDataSystemRequests with {
    briefly "What BillingSettlementContext asks MeterDataSystem to send"
  }
  persistent connector 'EnergySupplierGatewayRequest Stream' is from outlet BillingSettlementContext.ToEnergySupplierGateway.ToEnergySupplierGatewayOut to inlet EnergySupplierGateway.EnergySupplierGatewayRequests with {
    briefly "What BillingSettlementContext asks EnergySupplierGateway to send"
  }
  persistent connector 'PaymentProcessorRequest Stream' is from outlet BillingSettlementContext.ToPaymentProcessor.ToPaymentProcessorOut to inlet PaymentProcessor.PaymentProcessorRequests with {
    briefly "What BillingSettlementContext asks PaymentProcessor to send"
  }
  persistent connector 'BillingRepositoryQuery Stream' is from outlet BillingSettlementApp.AppBillingRepositoryQueries to inlet BillingSettlementContext.BillingRepositoryQueriesIn with {
    briefly "BillingSettlementApp's look-ups of the billing repository"
  }
  persistent connector 'BillingRepositoryReply Stream' is from outlet BillingSettlementContext.BillingRepositoryRepliesOut to inlet BillingSettlementApp.AppBillingRepositoryReplies with {
    briefly "The billing repository's answers returned to BillingSettlementApp"
  }
  persistent connector 'BillingAccountQuery Stream' is from outlet BillingSettlementApp.AppBillingAccountQueries to inlet BillingSettlementContext.BillingAccountQueriesIn with {
    briefly "BillingSettlementApp's look-ups of the billing account"
  }
  persistent connector 'BillingAccountCommand Stream' is from outlet BillingSettlementApp.AppBillingAccountCommands to inlet BillingSettlementContext.BillingAccountCommandStreamIn with {
    briefly "BillingAccount commands from the application"
  }
  persistent connector 'BillingAccountResult Stream' is from outlet BillingSettlementContext.BillingAccountResultStreamOut to inlet BillingSettlementApp.AppBillingRepositoryResponses with {
    briefly "Billing query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet BillingSettlementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term RateSchedule is "The schedule of rates applied to usage to compute charges."
  briefly "Billing settlement domain"
  described as {
    |Utility billing settlement and energy supplier reconciliation.
  }
}
