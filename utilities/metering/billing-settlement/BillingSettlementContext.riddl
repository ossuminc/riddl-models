// Billing Settlement - Billing Settlement Context
context BillingSettlementContext as router is {
  inlet BillingSettlementContextFromMeterDataSystem is command BillingAccount.CalculateUsage with {
    briefly "What FromMeterDataSystem makes of that service's news"
  }
  connector 'FromMeterDataSystem Intake' is from outlet BillingSettlementContext.FromMeterDataSystem.FromMeterDataSystemToBillingSettlementContext to inlet BillingSettlementContext.BillingSettlementContextFromMeterDataSystem with {
    briefly "What FromMeterDataSystem makes of that news, on its way in"
  }
  inlet BillingSettlementContextFromPaymentProcessor is command BillingAccount.RecordPayment with {
    briefly "What FromPaymentProcessor makes of that service's news"
  }
  connector 'FromPaymentProcessor Intake' is from outlet BillingSettlementContext.FromPaymentProcessor.FromPaymentProcessorToBillingSettlementContext to inlet BillingSettlementContext.BillingSettlementContextFromPaymentProcessor with {
    briefly "What FromPaymentProcessor makes of that news, on its way in"
  }
  inlet BillingAccountCommandStreamIn is type BillingAccountCommand  outlet BillingAccountCommandStreamOut is type BillingAccountCommand
  inlet BillingAccountResultStreamIn is result BillingAccount.BillingAccountResult  outlet BillingAccountResultStreamOut is result BillingAccount.BillingAccountResult
  handler BillingSettlementContextBoundary is {
    on createAccount: command BillingAccount.CreateAccount is {
      send createAccount to outlet BillingSettlementContext.BillingAccountCommandStreamOut
    }
    on submitMeterReading: command BillingAccount.SubmitMeterReading is {
      send submitMeterReading to outlet BillingSettlementContext.BillingAccountCommandStreamOut
    }
    on calculateUsage: command BillingAccount.CalculateUsage is {
      send calculateUsage to outlet BillingSettlementContext.BillingAccountCommandStreamOut
    }
    on generateBill: command BillingAccount.GenerateBill is {
      send generateBill to outlet BillingSettlementContext.BillingAccountCommandStreamOut
    }
    on recordPayment: command BillingAccount.RecordPayment is {
      send recordPayment to outlet BillingSettlementContext.BillingAccountCommandStreamOut
    }
    on initiateSettlement: command BillingAccount.InitiateSettlement is {
      send initiateSettlement to outlet BillingSettlementContext.BillingAccountCommandStreamOut
    }
    on disputeBill: command BillingAccount.DisputeBill is {
      send disputeBill to outlet BillingSettlementContext.BillingAccountCommandStreamOut
    }
    on closeAccount: command BillingAccount.CloseAccount is {
      send closeAccount to outlet BillingSettlementContext.BillingAccountCommandStreamOut
    }
    on billingAccountResult: result BillingAccount.BillingAccountResult is {
      send billingAccountResult to outlet BillingSettlementContext.BillingAccountResultStreamOut
    }
    on other is {
      error "Unexpected message at the BillingSettlementContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'BillingAccountCommand Stream Intake' is from outlet BillingSettlementContext.BillingAccountCommandStreamOut to inlet BillingSettlementContext.BillingAccount.BillingAccountCommands  connector 'BillingAccountResult Stream Egress' is from outlet BillingSettlementContext.BillingRepository.BillingRepositoryResponses to inlet BillingSettlementContext.BillingAccountResultStreamIn  adaptor FromEnergySupplierGateway from context EnergySupplierGateway as sink is { 
    inlet FromEnergySupplierGatewayIn is event EnergySupplierGateway.SettlementConfirmed    handler FromEnergySupplierGatewayHandler is {
      on settlementConfirmed: event EnergySupplierGateway.SettlementConfirmed is {
        do "the supplier has confirmed; initiating settlement was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromEnergySupplierGateway"
      }
    } with {
      briefly "from energy supplier gateway"
      described as {
        |Carries messages from the external EnergySupplierGateway.
      }
    }
  } with {
    briefly "EnergySupplierGateway integration"
    described as {
      |The model's side of the EnergySupplierGateway conversation.
    }
  }
  adaptor ToEnergySupplierGateway to context EnergySupplierGateway as merge is { 
    inlet ToEnergySupplierGatewayIn is type BillingAccountEvent    inlet ToEnergySupplierGatewayReplies is result EnergySupplierGateway.SupplierRates    outlet ToEnergySupplierGatewayOut is type EnergySupplierGateway.EnergySupplierGatewayRequest
    handler ToEnergySupplierGatewayHandler is {
      on settlementInitiated: event BillingAccount.SettlementInitiated is {
        let submission: type EnergySupplierGateway.SubmitSettlement = prompt("translate the settlementInitiated event into a SubmitSettlement putting the period's reconciled volumes to the supplier")
        send submission to outlet BillingSettlementContext.ToEnergySupplierGateway.ToEnergySupplierGatewayOut
      }
      on usageCalculated: event BillingAccount.UsageCalculated is {
        let askAnswer: type EnergySupplierGateway.SupplierRates = ask query EnergySupplierGateway.GetSupplierRates of context EnergySupplierGateway
        do "calculated usage needing the supplier's rates to turn into money"
      }
      on other is {
        error "Unexpected message for adaptor ToEnergySupplierGateway"
      }
    } with {
      briefly "to energy supplier gateway"
      described as {
        |Carries messages to the external EnergySupplierGateway.
      }
    }
  } with {
    briefly "EnergySupplierGateway integration"
    described as {
      |The model's side of the EnergySupplierGateway conversation.
    }
  }
  adaptor FromMeterDataSystem from context MeterDataSystem as flow is { 
    inlet FromMeterDataSystemIn is event MeterDataSystem.MeterDataValidated    outlet FromMeterDataSystemToBillingSettlementContext is command BillingAccount.CalculateUsage
    handler FromMeterDataSystemHandler is {
      on meterDataValidated: event MeterDataSystem.MeterDataValidated is {
        let item0: type BillingAccount.CalculateUsage = prompt("translate the meterDataValidated event into a CalculateUsage, validated meter data is what usage is calculated from")
        send item0 to outlet BillingSettlementContext.FromMeterDataSystem.FromMeterDataSystemToBillingSettlementContext
      }
      on other is {
        error "Unexpected message for adaptor FromMeterDataSystem"
      }
    } with {
      briefly "from meter data system"
      described as {
        |Carries messages from the external MeterDataSystem.
      }
    }
  } with {
    briefly "MeterDataSystem integration"
    described as {
      |The model's side of the MeterDataSystem conversation.
    }
  }
  adaptor ToMeterDataSystem to context MeterDataSystem as merge is { 
    inlet ToMeterDataSystemIn is type BillingAccountEvent    inlet ToMeterDataSystemReplies is result MeterDataSystem.MeterReadings    outlet ToMeterDataSystemOut is type MeterDataSystem.MeterDataSystemRequest
    handler ToMeterDataSystemHandler is {
      on billDisputed: event BillingAccount.BillDisputed is {
        let askAnswer: type MeterDataSystem.MeterReadings = ask query MeterDataSystem.GetMeterReadings of context MeterDataSystem
        do "a disputed bill needing the readings it was built from"
      }
      on meterReadingSubmitted: event BillingAccount.MeterReadingSubmitted is {
        let item0: type MeterDataSystem.ValidateMeterData = prompt("translate the meterReadingSubmitted event into a ValidateMeterData, a submitted reading being unbillable until it is trusted")
        send item0 to outlet BillingSettlementContext.ToMeterDataSystem.ToMeterDataSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToMeterDataSystem"
      }
    } with {
      briefly "to meter data system"
      described as {
        |Carries messages to the external MeterDataSystem.
      }
    }
  } with {
    briefly "MeterDataSystem integration"
    described as {
      |The model's side of the MeterDataSystem conversation.
    }
  }
  adaptor FromPaymentProcessor from context PaymentProcessor as flow is { 
    inlet FromPaymentProcessorIn is type PaymentProcessor.PaymentProcessorEvent    outlet FromPaymentProcessorToBillingSettlementContext is command BillingAccount.RecordPayment
    handler FromPaymentProcessorHandler is {
      on paymentProcessed: event PaymentProcessor.PaymentProcessed is {
        let item0: type BillingAccount.RecordPayment = prompt("translate the paymentProcessed event into a RecordPayment, money the processor actually took is what the account records as paid")
        send item0 to outlet BillingSettlementContext.FromPaymentProcessor.FromPaymentProcessorToBillingSettlementContext
      }
      on refundIssued: event PaymentProcessor.RefundIssued is {
        do "the refund has gone; disputing the bill was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessor"
      }
    } with {
      briefly "from payment processor"
      described as {
        |Carries messages from the external PaymentProcessor.
      }
    }
  } with {
    briefly "PaymentProcessor integration"
    described as {
      |The model's side of the PaymentProcessor conversation.
    }
  }
  adaptor ToPaymentProcessor to context PaymentProcessor as flow is { 
    inlet ToPaymentProcessorIn is type BillingAccountEvent    outlet ToPaymentProcessorOut is type PaymentProcessor.PaymentProcessorCommand
    handler ToPaymentProcessorHandler is {
      on billGenerated: event BillingAccount.BillGenerated is {
        let notice: type PaymentProcessor.ProcessPayment = prompt("translate the billGenerated event into a ProcessPayment collecting what the customer owes on the bill just raised")
        send notice to outlet BillingSettlementContext.ToPaymentProcessor.ToPaymentProcessorOut
      }
      on billDisputed: event BillingAccount.BillDisputed is {
        let notice: type PaymentProcessor.IssueRefund = prompt("translate the billDisputed event into an IssueRefund returning what was taken on the disputed invoice, which the dispute has released the customer from owing")
        send notice to outlet BillingSettlementContext.ToPaymentProcessor.ToPaymentProcessorOut
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessor"
      }
    } with {
      briefly "to payment processor"
      described as {
        |Carries messages to the external PaymentProcessor.
      }
    }
  } with {
    briefly "PaymentProcessor integration"
    described as {
      |The model's side of the PaymentProcessor conversation.
    }
  }
  include "types.riddl"
  include "BillingAccount.riddl"
  type BillingRepositoryCommand is one of {
    BillingSettlementContext.BillingRepository.PersistAccountClosed or BillingSettlementContext.BillingRepository.PersistAccountCreated or BillingSettlementContext.BillingRepository.PersistBillDisputed or BillingSettlementContext.BillingRepository.PersistBillGenerated or BillingSettlementContext.BillingRepository.PersistMeterReadingSubmitted or BillingSettlementContext.BillingRepository.PersistPaymentRecorded or BillingSettlementContext.BillingRepository.PersistSettlementInitiated or BillingSettlementContext.BillingRepository.PersistUsageCalculated
  } with {
    briefly "Anything that writes BillingRepository"
    described as {
      |The persistence commands BillingRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository BillingRepository as flow is {
    inlet BillingRepositoryFromBillingMetrics is type BillingRepositoryCommand    command PersistAccountClosed is {
      accountId: BillingAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountClosed applies to.
        }
      }
    } with {
      briefly "Persist AccountClosed"
      described as {
        |Instructs this repository to apply AccountClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountCreated is {
      accountId: BillingAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountCreated applies to.
        }
      }
    } with {
      briefly "Persist AccountCreated"
      described as {
        |Instructs this repository to apply AccountCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBillDisputed is {
      accountId: BillingAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row BillDisputed applies to.
        }
      }
    } with {
      briefly "Persist BillDisputed"
      described as {
        |Instructs this repository to apply BillDisputed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMeterReadingSubmitted is {
      accountId: BillingAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row MeterReadingSubmitted applies to.
        }
      }
    } with {
      briefly "Persist MeterReadingSubmitted"
      described as {
        |Instructs this repository to apply MeterReadingSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUsageCalculated is {
      accountId: BillingAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row UsageCalculated applies to.
        }
      }
    } with {
      briefly "Persist UsageCalculated"
      described as {
        |Instructs this repository to apply UsageCalculated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBillGenerated is {
      accountId: BillingAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row BillGenerated applies to.
        }
      }
    } with {
      briefly "Persist BillGenerated"
      described as {
        |Instructs this repository to apply BillGenerated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentRecorded is {
      accountId: BillingAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentRecorded applies to.
        }
      }
    } with {
      briefly "Persist PaymentRecorded"
      described as {
        |Instructs this repository to apply PaymentRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSettlementInitiated is {
      accountId: BillingAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row SettlementInitiated applies to.
        }
      }
    } with {
      briefly "Persist SettlementInitiated"
      described as {
        |Instructs this repository to apply SettlementInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet BillingRepositoryResponses is result BillingAccount.BillingAccountResult
    record StoredBillingAccount is {
      billingAccountId: BillingAccountId with {
        briefly "billingAccountId"
        described as {
          |The billingAccountId column of the stored billingAccount row.
        }
      }
      accountId: BillingAccountId with {
        briefly "accountId"
        described as {
          |The accountId column of the stored billingAccount row.
        }
      }
      customerId: CustomerId with {
        briefly "customerId"
        described as {
          |The customerId column of the stored billingAccount row.
        }
      }
      status: AccountStatus with {
        briefly "status"
        described as {
          |The status column of the stored billingAccount row.
        }
      }
    } with {
      briefly "Stored billingAccount row"
      described as {
        |The persistence shape of billingAccount data as this repository stores it.
      }
    }
    schema BillingData is relational
      of billingAccounts as record StoredBillingAccount
        index on field StoredBillingAccount.accountId
        index on field StoredBillingAccount.customerId
        index on field StoredBillingAccount.status
 with {
      briefly "Billing data schema"
      described as {
        |The relational schema holding billing data for the BillingRepository.
      }
    }
    handler BillingPersistence is {
      on persistAccountClosed: command PersistAccountClosed is {
        do "apply AccountClosed to the stored row"
      }
      on persistAccountCreated: command PersistAccountCreated is {
        do "apply AccountCreated to the stored row"
      }
      on persistBillDisputed: command PersistBillDisputed is {
        do "apply BillDisputed to the stored row"
      }
      on persistMeterReadingSubmitted: command PersistMeterReadingSubmitted is {
        do "apply MeterReadingSubmitted to the stored row"
      }
      on persistUsageCalculated: command PersistUsageCalculated is {
        do "apply UsageCalculated to the stored row"
      }
      on persistBillGenerated: command PersistBillGenerated is {
        do "apply BillGenerated to the stored row"
      }
      on persistPaymentRecorded: command PersistPaymentRecorded is {
        do "apply PaymentRecorded to the stored row"
      }
      on persistSettlementInitiated: command PersistSettlementInitiated is {
        do "apply SettlementInitiated to the stored row"
      }
      on query GetRevenueMetrics is {
        let revenueMetricsView: type RevenueMetricsView = prompt("read the revenue metrics projection")
        reply revenueMetricsView
      }
    } with {
      briefly "Persists billing commands"
      described as {
        |Handles event-driven billing persistence.
      }
    }
  } with {
    briefly "Billing data persistence"
    described as {
      |Persistent storage for billing accounts.
    }
  }
  query GetRevenueMetrics replies result RevenueMetricsView is {
    revenueMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which revenue metrics to retrieve.
      }
    }
  } with {
    briefly "Get revenue metrics"
    described as {
      |Retrieves the revenue metrics projection.
    }
  }
  result RevenueMetricsView is {
    revenueMetrics: BillingMetrics.RevenueMetrics with {
      briefly "Revenue metrics"
      described as {
        |The revenue metrics being returned.
      }
    }
  } with {
    briefly "Revenue metrics view"
    described as {
      |Read model view carrying the revenue metrics projection.
    }
  }
  projector BillingMetrics as flow is {
    updates repository BillingSettlementContext.BillingRepository
    outlet BillingMetricsToRepository is type BillingRepositoryCommand
    inlet BillingMetricsFromBillingAccount is type BillingAccountEvent    record RevenueMetrics is {
      totalBillsGenerated: Natural with {
        briefly "Bills"
        described as {
          |Total bills generated.
        }
      }
      totalRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Total revenue billed.
        }
      }
      totalPaymentsReceived: Decimal(14,2) with {
        briefly "Payments"
        described as {
          |Total payments received.
        }
      }
      outstandingBalance: Decimal(14,2) with {
        briefly "Outstanding"
        described as {
          |Outstanding balance.
        }
      }
      settlementsCompleted: Natural with {
        briefly "Settlements"
        described as {
          |Settlements completed.
        }
      }
    } with {
      briefly "Revenue metrics"
      described as {
        |Billing revenue metrics.
      }
    }
    handler MetricsHandler is {
      on accountClosed: event BillingAccount.AccountClosed is {
        tell command BillingSettlementContext.BillingRepository.PersistAccountClosed(accountId = accountClosed.accountId) to repository BillingSettlementContext.BillingRepository
        do "apply AccountClosed to the BillingMetrics projection"
      }
      on accountCreated: event BillingAccount.AccountCreated is {
        tell command BillingSettlementContext.BillingRepository.PersistAccountCreated(accountId = accountCreated.accountId) to repository BillingSettlementContext.BillingRepository
        do "apply AccountCreated to the BillingMetrics projection"
      }
      on billDisputed: event BillingAccount.BillDisputed is {
        tell command BillingSettlementContext.BillingRepository.PersistBillDisputed(accountId = billDisputed.accountId) to repository BillingSettlementContext.BillingRepository
        do "apply BillDisputed to the BillingMetrics projection"
      }
      on meterReadingSubmitted: event BillingAccount.MeterReadingSubmitted is {
        tell command BillingSettlementContext.BillingRepository.PersistMeterReadingSubmitted(accountId = meterReadingSubmitted.accountId) to repository BillingSettlementContext.BillingRepository
        do "apply MeterReadingSubmitted to the BillingMetrics projection"
      }
      on usageCalculated: event BillingAccount.UsageCalculated is {
        tell command BillingSettlementContext.BillingRepository.PersistUsageCalculated(accountId = usageCalculated.accountId) to repository BillingSettlementContext.BillingRepository
        do "apply UsageCalculated to the BillingMetrics projection"
      }
      on billGenerated: event BillingAccount.BillGenerated is {
        tell command BillingSettlementContext.BillingRepository.PersistBillGenerated(accountId = billGenerated.accountId) to repository BillingSettlementContext.BillingRepository
        do "Increment bills generated and add to total revenue"
      }
      on paymentRecorded: event BillingAccount.PaymentRecorded is {
        tell command BillingSettlementContext.BillingRepository.PersistPaymentRecorded(accountId = paymentRecorded.accountId) to repository BillingSettlementContext.BillingRepository
        do "Add to payments received and reduce outstanding balance"
      }
      on settlementInitiated: event BillingAccount.SettlementInitiated is {
        tell command BillingSettlementContext.BillingRepository.PersistSettlementInitiated(accountId = settlementInitiated.accountId) to repository BillingSettlementContext.BillingRepository
        do "Increment settlements completed"
      }
    } with {
      briefly "Maintains billing metrics"
      described as {
        |Projects billing events into revenue metrics.
      }
    }
  } with {
    briefly "Billing metrics"
    described as {
      |Billing and revenue analytics.
    }
  }
  // ---- Event publication for BillingAccount ----
  type BillingAccountEvent is one of {
    BillingSettlementContext.BillingAccount.AccountCreated or BillingSettlementContext.BillingAccount.MeterReadingSubmitted or BillingSettlementContext.BillingAccount.UsageCalculated or BillingSettlementContext.BillingAccount.BillGenerated or BillingSettlementContext.BillingAccount.PaymentRecorded or BillingSettlementContext.BillingAccount.SettlementInitiated or BillingSettlementContext.BillingAccount.BillDisputed or BillingSettlementContext.BillingAccount.AccountClosed
  } with {
    briefly "BillingAccount event alternation"
    described as {
      |Union of all BillingAccount events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet BillingAccountEventSplit as split is {
    outlet BillingAccountEventSplitToToPaymentProcessor is type BillingAccountEvent
    outlet BillingAccountEventSplitToToMeterDataSystem is type BillingAccountEvent
    outlet BillingAccountEventSplitToToEnergySupplierGateway is type BillingAccountEvent
    inlet BillingAccountEventSplitIn is type BillingAccountEvent    outlet BillingAccountEventSplitToBillingMetrics is type BillingAccountEvent
    handler BillingAccountEventSplitHandler is {
      on accountCreated: event BillingAccount.AccountCreated is {
        send accountCreated to outlet BillingAccountEventSplitToBillingMetrics
        tell accountCreated to entity BillingSettlementContext.BillingAccount
      }
      on meterReadingSubmitted: event BillingAccount.MeterReadingSubmitted is {
        send meterReadingSubmitted to outlet BillingAccountEventSplitToBillingMetrics
        send meterReadingSubmitted to outlet BillingAccountEventSplitToToMeterDataSystem
        tell meterReadingSubmitted to entity BillingSettlementContext.BillingAccount
      }
      on usageCalculated: event BillingAccount.UsageCalculated is {
        send usageCalculated to outlet BillingAccountEventSplitToBillingMetrics
        send usageCalculated to outlet BillingAccountEventSplitToToEnergySupplierGateway
        tell usageCalculated to entity BillingSettlementContext.BillingAccount
      }
      on billGenerated: event BillingAccount.BillGenerated is {
        send billGenerated to outlet BillingAccountEventSplitToBillingMetrics
        send billGenerated to outlet BillingAccountEventSplitToToPaymentProcessor
        tell billGenerated to entity BillingSettlementContext.BillingAccount
      }
      on paymentRecorded: event BillingAccount.PaymentRecorded is {
        send paymentRecorded to outlet BillingAccountEventSplitToBillingMetrics
        tell paymentRecorded to entity BillingSettlementContext.BillingAccount
      }
      on settlementInitiated: event BillingAccount.SettlementInitiated is {
        send settlementInitiated to outlet BillingAccountEventSplitToBillingMetrics
        send settlementInitiated to outlet BillingAccountEventSplitToToEnergySupplierGateway
        tell settlementInitiated to entity BillingSettlementContext.BillingAccount
      }
      on billDisputed: event BillingAccount.BillDisputed is {
        send billDisputed to outlet BillingAccountEventSplitToBillingMetrics
        send billDisputed to outlet BillingAccountEventSplitToToPaymentProcessor
        send billDisputed to outlet BillingAccountEventSplitToToMeterDataSystem
        tell billDisputed to entity BillingSettlementContext.BillingAccount
      }
      on accountClosed: event BillingAccount.AccountClosed is {
        send accountClosed to outlet BillingAccountEventSplitToBillingMetrics
        tell accountClosed to entity BillingSettlementContext.BillingAccount
      }
      on other is {
        error "Unexpected message for processor BillingAccountEventSplit"
      }
    } with {
      briefly "BillingAccount event fan-out handler"
      described as {
        |Delivers each BillingAccount event to all of its consumers.
      }
    }
  } with {
    briefly "BillingAccount event fan-out"
    described as {
      |Fans BillingAccount events out to the repository and projectors.
    }
  }
  connector 'ToPaymentProcessor Feed' is from outlet BillingSettlementContext.BillingAccountEventSplit.BillingAccountEventSplitToToPaymentProcessor to inlet BillingSettlementContext.ToPaymentProcessor.ToPaymentProcessorIn with {
    briefly "The BillingAccount events ToPaymentProcessor translates, on their way to it"
  }
  connector 'ToMeterDataSystem Feed' is from outlet BillingSettlementContext.BillingAccountEventSplit.BillingAccountEventSplitToToMeterDataSystem to inlet BillingSettlementContext.ToMeterDataSystem.ToMeterDataSystemIn with {
    briefly "The BillingAccount events ToMeterDataSystem translates, on their way to it"
  }
  connector 'ToEnergySupplierGateway Feed' is from outlet BillingSettlementContext.BillingAccountEventSplit.BillingAccountEventSplitToToEnergySupplierGateway to inlet BillingSettlementContext.ToEnergySupplierGateway.ToEnergySupplierGatewayIn with {
    briefly "The BillingAccount events ToEnergySupplierGateway translates, on their way to it"
  }
  connector 'BillingAccountEvent Stream' is from outlet BillingSettlementContext.BillingAccount.BillingAccountEvents2 to inlet BillingSettlementContext.BillingAccountEventSplit.BillingAccountEventSplitIn with {
    briefly "BillingAccount events, fanned out to storage and read models"
  }
  connector 'BillingMetrics Feed' is from outlet BillingSettlementContext.BillingAccountEventSplit.BillingAccountEventSplitToBillingMetrics to inlet BillingSettlementContext.BillingMetrics.BillingMetricsFromBillingAccount with {
    briefly "BillingAccount events feeding the BillingMetrics projection"
  }
  connector 'BillingMetrics Storage' is from outlet BillingSettlementContext.BillingMetrics.BillingMetricsToRepository to inlet BillingSettlementContext.BillingRepository.BillingRepositoryFromBillingMetrics with {
    briefly "BillingMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for billing settlement"
  described as {
    |Utility billing settlement context.
  }
}
