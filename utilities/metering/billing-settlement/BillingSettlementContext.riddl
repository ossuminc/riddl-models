// Billing Settlement - Billing Settlement Context
context BillingSettlementContext is {
  adaptor FromEnergySupplierGateway from context EnergySupplierGateway is { 
    handler FromEnergySupplierGatewayHandler is {
      on event EnergySupplierGateway.SettlementConfirmed is {
        do "the model receives settlement confirmed"
      }
      on result EnergySupplierGateway.SupplierRates is {
        do "the model receives supplier rates"
      }
      on other is {
        error "Unexpected message for adaptor FromEnergySupplierGateway"
      }
    } with {
      briefly "from energy supplier gateway"
      described as {
        |Carries messages from the external EnergySupplierGateway.
      }
    }
  } with {
    briefly "EnergySupplierGateway integration"
    described as {
      |The model's side of the EnergySupplierGateway conversation.
    }
  }
  adaptor ToEnergySupplierGateway to context EnergySupplierGateway is { 
    handler ToEnergySupplierGatewayHandler is {
      on query EnergySupplierGateway.GetSupplierRates is {
        do "the model sends get supplier rates"
      }
      on command EnergySupplierGateway.SubmitSettlement is {
        do "the model sends submit settlement"
      }
      on other is {
        error "Unexpected message for adaptor ToEnergySupplierGateway"
      }
    } with {
      briefly "to energy supplier gateway"
      described as {
        |Carries messages to the external EnergySupplierGateway.
      }
    }
  } with {
    briefly "EnergySupplierGateway integration"
    described as {
      |The model's side of the EnergySupplierGateway conversation.
    }
  }
  adaptor FromMeterDataSystem from context MeterDataSystem is { 
    handler FromMeterDataSystemHandler is {
      on event MeterDataSystem.MeterDataValidated is {
        do "the model receives meter data validated"
      }
      on result MeterDataSystem.MeterReadings is {
        do "the model receives meter readings"
      }
      on other is {
        error "Unexpected message for adaptor FromMeterDataSystem"
      }
    } with {
      briefly "from meter data system"
      described as {
        |Carries messages from the external MeterDataSystem.
      }
    }
  } with {
    briefly "MeterDataSystem integration"
    described as {
      |The model's side of the MeterDataSystem conversation.
    }
  }
  adaptor ToMeterDataSystem to context MeterDataSystem is { 
    handler ToMeterDataSystemHandler is {
      on query MeterDataSystem.GetMeterReadings is {
        do "the model sends get meter readings"
      }
      on command MeterDataSystem.ValidateMeterData is {
        do "the model sends validate meter data"
      }
      on other is {
        error "Unexpected message for adaptor ToMeterDataSystem"
      }
    } with {
      briefly "to meter data system"
      described as {
        |Carries messages to the external MeterDataSystem.
      }
    }
  } with {
    briefly "MeterDataSystem integration"
    described as {
      |The model's side of the MeterDataSystem conversation.
    }
  }
  adaptor FromPaymentProcessor from context PaymentProcessor is { 
    handler FromPaymentProcessorHandler is {
      on event PaymentProcessor.PaymentProcessed is {
        do "the model receives payment processed"
      }
      on event PaymentProcessor.RefundIssued is {
        do "the model receives refund issued"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessor"
      }
    } with {
      briefly "from payment processor"
      described as {
        |Carries messages from the external PaymentProcessor.
      }
    }
  } with {
    briefly "PaymentProcessor integration"
    described as {
      |The model's side of the PaymentProcessor conversation.
    }
  }
  adaptor ToPaymentProcessor to context PaymentProcessor is { 
    handler ToPaymentProcessorHandler is {
      on command PaymentProcessor.IssueRefund is {
        do "the model sends issue refund"
      }
      on command PaymentProcessor.ProcessPayment is {
        do "the model sends process payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessor"
      }
    } with {
      briefly "to payment processor"
      described as {
        |Carries messages to the external PaymentProcessor.
      }
    }
  } with {
    briefly "PaymentProcessor integration"
    described as {
      |The model's side of the PaymentProcessor conversation.
    }
  }
  include "types.riddl"
  include "BillingAccount.riddl"
  repository BillingRepository is {
    inlet BillingRepositoryFromBillingAccount is type BillingAccountEvent    inlet BillingRepositoryFromBillingMetrics is type BillingAccountEvent    outlet BillingRepositoryResponses is type BillingAccount.BillingAccountResult
    record StoredBillingAccount is  {
      billingAccountId: BillingAccountId with {
        briefly "billingAccountId"
        described as {
          |The billingAccountId column of the stored billingAccount row.
        }
      }
      accountId: BillingAccountId with {
        briefly "accountId"
        described as {
          |The accountId column of the stored billingAccount row.
        }
      }
      customerId: CustomerId with {
        briefly "customerId"
        described as {
          |The customerId column of the stored billingAccount row.
        }
      }
      status: AccountStatus with {
        briefly "status"
        described as {
          |The status column of the stored billingAccount row.
        }
      }
    } with {
      briefly "Stored billingAccount row"
      described as {
        |The persistence shape of billingAccount data as this repository stores it.
      }
    }
    schema BillingData is relational
      of billingAccounts as type StoredBillingAccount
        index on field StoredBillingAccount.accountId
        index on field StoredBillingAccount.customerId
        index on field StoredBillingAccount.status
 with {
      briefly "Billing data schema"
      described as {
        |The relational schema holding billing data for the BillingRepository.
      }
    }
    handler BillingPersistence is {
      on query GetRevenueMetrics is {
        do "read the revenue metrics projection"
        yield result RevenueMetricsView
      }
      on command BillingAccount.CreateAccount is {
        tell event BillingAccount.AccountCreated to entity BillingSettlementContext.BillingAccount
        do "Store new billing account"
      }
      on command BillingAccount.SubmitMeterReading is {
        tell event BillingAccount.MeterReadingSubmitted to entity BillingSettlementContext.BillingAccount
        do "Store validated meter reading"
      }
      on command BillingAccount.CalculateUsage is {
        do "Store usage calculation"
      }
      on command BillingAccount.GenerateBill is {
        do "Store generated invoice"
      }
      on command BillingAccount.RecordPayment is {
        tell event BillingAccount.PaymentRecorded to entity BillingSettlementContext.BillingAccount
        do "Store payment record"
      }
      on command BillingAccount.InitiateSettlement is {
        tell event BillingAccount.SettlementInitiated to entity BillingSettlementContext.BillingAccount
        do "Store supplier settlement"
      }
    } with {
      briefly "Persists billing commands"
      described as {
        |Handles event-driven billing persistence.
      }
    }
  } with {
    briefly "Billing data persistence"
    described as {
      |Persistent storage for billing accounts.
    }
  }
  query GetRevenueMetrics is  {
    revenueMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which revenue metrics to retrieve.
      }
    }
  } with {
    briefly "Get revenue metrics"
    described as {
      |Retrieves the revenue metrics projection.
    }
  }
  result RevenueMetricsView is  {
    revenueMetrics: BillingMetrics.RevenueMetrics with {
      briefly "Revenue metrics"
      described as {
        |The revenue metrics being returned.
      }
    }
  } with {
    briefly "Revenue metrics view"
    described as {
      |Read model view carrying the revenue metrics projection.
    }
  }
  projector BillingMetrics is {
    updates repository BillingSettlementContext.BillingRepository
    inlet BillingMetricsFromBillingAccount is type BillingAccountEvent    outlet BillingMetricsOut is type BillingAccountEvent
    record RevenueMetrics is  {
      totalBillsGenerated: Natural with {
        briefly "Bills"
        described as {
          |Total bills generated.
        }
      }
      totalRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Total revenue billed.
        }
      }
      totalPaymentsReceived: Decimal(14,2) with {
        briefly "Payments"
        described as {
          |Total payments received.
        }
      }
      outstandingBalance: Decimal(14,2) with {
        briefly "Outstanding"
        described as {
          |Outstanding balance.
        }
      }
      settlementsCompleted: Natural with {
        briefly "Settlements"
        described as {
          |Settlements completed.
        }
      }
    } with {
      briefly "Revenue metrics"
      described as {
        |Billing revenue metrics.
      }
    }
    handler MetricsHandler is {
      on event BillingAccount.BillGenerated is {
        tell event BillingAccount.BillGenerated to repository BillingSettlementContext.BillingRepository
        do "Increment bills generated and add to total revenue"
      }
      on event BillingAccount.PaymentRecorded is {
        tell event BillingAccount.PaymentRecorded to repository BillingSettlementContext.BillingRepository
        do "Add to payments received and reduce outstanding balance"
      }
      on event BillingAccount.SettlementInitiated is {
        tell event BillingAccount.SettlementInitiated to repository BillingSettlementContext.BillingRepository
        do "Increment settlements completed"
      }
    } with {
      briefly "Maintains billing metrics"
      described as {
        |Projects billing events into revenue metrics.
      }
    }
  } with {
    briefly "Billing metrics"
    described as {
      |Billing and revenue analytics.
    }
  }
  // ---- Event publication for BillingAccount ----
  type BillingAccountEvent is one of {
    BillingSettlementContext.BillingAccount.AccountCreated or BillingSettlementContext.BillingAccount.MeterReadingSubmitted or BillingSettlementContext.BillingAccount.UsageCalculated or BillingSettlementContext.BillingAccount.BillGenerated or BillingSettlementContext.BillingAccount.PaymentRecorded or BillingSettlementContext.BillingAccount.SettlementInitiated or BillingSettlementContext.BillingAccount.BillDisputed or BillingSettlementContext.BillingAccount.AccountClosed
  } with {
    briefly "BillingAccount event alternation"
    described as {
      |Union of all BillingAccount events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BillingAccountEventSource as source is {
    outlet BillingAccountEvents is type BillingAccountEvent
    handler BillingAccountSourceHandler is {
      on event BillingAccount.AccountCreated is {
        send event BillingAccount.AccountCreated to outlet BillingAccountEvents
      }
      on event BillingAccount.MeterReadingSubmitted is {
        send event BillingAccount.MeterReadingSubmitted to outlet BillingAccountEvents
      }
      on event BillingAccount.UsageCalculated is {
        send event BillingAccount.UsageCalculated to outlet BillingAccountEvents
      }
      on event BillingAccount.BillGenerated is {
        send event BillingAccount.BillGenerated to outlet BillingAccountEvents
      }
      on event BillingAccount.PaymentRecorded is {
        send event BillingAccount.PaymentRecorded to outlet BillingAccountEvents
      }
      on event BillingAccount.SettlementInitiated is {
        send event BillingAccount.SettlementInitiated to outlet BillingAccountEvents
      }
      on event BillingAccount.BillDisputed is {
        send event BillingAccount.BillDisputed to outlet BillingAccountEvents
      }
      on event BillingAccount.AccountClosed is {
        send event BillingAccount.AccountClosed to outlet BillingAccountEvents
      }
      on other is {
        error "Unexpected message for source BillingAccountEventSource"
      }
    } with {
      briefly "BillingAccount source handler"
      described as {
        |Publishes BillingAccount events onto the outlet.
      }
    }
  } with {
    briefly "BillingAccount event source"
    described as {
      |Publishes BillingAccount entity events into the streaming topology.
    }
  }
  processor BillingAccountEventSink as sink is {
    inlet BillingAccountInlet is type BillingAccountEvent    handler BillingAccountSinkHandler is {
      on event BillingAccount.AccountCreated is {
        tell event BillingAccount.AccountCreated to repository BillingSettlementContext.BillingRepository
      }
      on event BillingAccount.MeterReadingSubmitted is {
        tell event BillingAccount.MeterReadingSubmitted to repository BillingSettlementContext.BillingRepository
      }
      on event BillingAccount.UsageCalculated is {
        tell event BillingAccount.UsageCalculated to repository BillingSettlementContext.BillingRepository
      }
      on event BillingAccount.BillGenerated is {
        tell event BillingAccount.BillGenerated to repository BillingSettlementContext.BillingRepository
      }
      on event BillingAccount.PaymentRecorded is {
        tell event BillingAccount.PaymentRecorded to repository BillingSettlementContext.BillingRepository
      }
      on event BillingAccount.SettlementInitiated is {
        tell event BillingAccount.SettlementInitiated to repository BillingSettlementContext.BillingRepository
      }
      on event BillingAccount.BillDisputed is {
        tell event BillingAccount.BillDisputed to repository BillingSettlementContext.BillingRepository
      }
      on event BillingAccount.AccountClosed is {
        tell event BillingAccount.AccountClosed to repository BillingSettlementContext.BillingRepository
      }
      on other is {
        error "Unexpected message for sink BillingAccountEventSink"
      }
    } with {
      briefly "BillingAccount sink handler"
      described as {
        |Persists BillingAccount events via the repository.
      }
    }
  } with {
    briefly "BillingAccount event sink"
    described as {
      |Receives BillingAccount events for persistence.
    }
  }
  connector BillingAccountEventFlow is from outlet BillingSettlementContext.BillingAccountEventSource.BillingAccountEvents to inlet BillingSettlementContext.BillingAccountEventSink.BillingAccountInlet with {
    briefly "BillingAccount event flow"
    described as {
      |Connects the BillingAccount source to its sink.
    }
  }
  processor BillingAccountEventSplit is {
    inlet BillingAccountEventSplitIn is type BillingAccountEvent    outlet BillingAccountEventSplitToBillingRepository is type BillingAccountEvent
    outlet BillingAccountEventSplitToBillingMetrics is type BillingAccountEvent
    handler BillingAccountEventSplitHandler is {
      on event BillingAccount.AccountCreated is {
        send event BillingAccount.AccountCreated to outlet BillingAccountEventSplitToBillingRepository
        send event BillingAccount.AccountCreated to outlet BillingAccountEventSplitToBillingMetrics
        tell event BillingAccount.AccountCreated to entity BillingSettlementContext.BillingAccount
      }
      on event BillingAccount.MeterReadingSubmitted is {
        send event BillingAccount.MeterReadingSubmitted to outlet BillingAccountEventSplitToBillingRepository
        send event BillingAccount.MeterReadingSubmitted to outlet BillingAccountEventSplitToBillingMetrics
        tell event BillingAccount.MeterReadingSubmitted to entity BillingSettlementContext.BillingAccount
      }
      on event BillingAccount.UsageCalculated is {
        send event BillingAccount.UsageCalculated to outlet BillingAccountEventSplitToBillingRepository
        send event BillingAccount.UsageCalculated to outlet BillingAccountEventSplitToBillingMetrics
        tell event BillingAccount.UsageCalculated to entity BillingSettlementContext.BillingAccount
      }
      on event BillingAccount.BillGenerated is {
        send event BillingAccount.BillGenerated to outlet BillingAccountEventSplitToBillingRepository
        send event BillingAccount.BillGenerated to outlet BillingAccountEventSplitToBillingMetrics
        tell event BillingAccount.BillGenerated to entity BillingSettlementContext.BillingAccount
      }
      on event BillingAccount.PaymentRecorded is {
        send event BillingAccount.PaymentRecorded to outlet BillingAccountEventSplitToBillingRepository
        send event BillingAccount.PaymentRecorded to outlet BillingAccountEventSplitToBillingMetrics
        tell event BillingAccount.PaymentRecorded to entity BillingSettlementContext.BillingAccount
      }
      on event BillingAccount.SettlementInitiated is {
        send event BillingAccount.SettlementInitiated to outlet BillingAccountEventSplitToBillingRepository
        send event BillingAccount.SettlementInitiated to outlet BillingAccountEventSplitToBillingMetrics
        tell event BillingAccount.SettlementInitiated to entity BillingSettlementContext.BillingAccount
      }
      on event BillingAccount.BillDisputed is {
        send event BillingAccount.BillDisputed to outlet BillingAccountEventSplitToBillingRepository
        send event BillingAccount.BillDisputed to outlet BillingAccountEventSplitToBillingMetrics
        tell event BillingAccount.BillDisputed to entity BillingSettlementContext.BillingAccount
      }
      on event BillingAccount.AccountClosed is {
        send event BillingAccount.AccountClosed to outlet BillingAccountEventSplitToBillingRepository
        send event BillingAccount.AccountClosed to outlet BillingAccountEventSplitToBillingMetrics
        tell event BillingAccount.AccountClosed to entity BillingSettlementContext.BillingAccount
      }
      on other is {
        error "Unexpected message for processor BillingAccountEventSplit"
      }
    } with {
      briefly "BillingAccount event fan-out handler"
      described as {
        |Delivers each BillingAccount event to all of its consumers.
      }
    }
  } with {
    briefly "BillingAccount event fan-out"
    described as {
      |Fans BillingAccount events out to the repository and projectors.
    }
  }
  connector BillingAccountEventStream is from outlet BillingSettlementContext.BillingAccount.BillingAccountEvents2 to inlet BillingSettlementContext.BillingAccountEventSplit.BillingAccountEventSplitIn with {
    briefly "BillingAccount events, fanned out to storage and read models"
  }
  connector BillingAccountEventStorage is from outlet BillingSettlementContext.BillingAccountEventSplit.BillingAccountEventSplitToBillingRepository to inlet BillingSettlementContext.BillingRepository.BillingRepositoryFromBillingAccount with {
    briefly "BillingAccount events on their way to storage"
  }
  connector BillingMetricsFeed is from outlet BillingSettlementContext.BillingAccountEventSplit.BillingAccountEventSplitToBillingMetrics to inlet BillingSettlementContext.BillingMetrics.BillingMetricsFromBillingAccount with {
    briefly "BillingAccount events feeding the BillingMetrics projection"
  }
  connector BillingMetricsStorage is from outlet BillingSettlementContext.BillingMetrics.BillingMetricsOut to inlet BillingSettlementContext.BillingRepository.BillingRepositoryFromBillingMetrics with {
    briefly "The BillingMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for billing settlement"
  described as {
    |Utility billing settlement context.
  }
}
