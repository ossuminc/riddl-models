// Water Distribution - Water Context
context WaterContext is {
  adaptor FromCustomerNotificationService from context CustomerNotificationService is { 
    handler FromCustomerNotificationServiceHandler is {
      on event CustomerNotificationService.NoticesSent is {
        do "the model receives notices sent"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerNotificationService"
      }
    } with {
      briefly "from customer notification service"
      described as {
        |Carries messages from the external CustomerNotificationService.
      }
    }
  } with {
    briefly "CustomerNotificationService integration"
    described as {
      |The model's side of the CustomerNotificationService conversation.
    }
  }
  adaptor ToCustomerNotificationService to context CustomerNotificationService is { 
    handler ToCustomerNotificationServiceHandler is {
      on command CustomerNotificationService.SendBoilWaterNotice is {
        do "the model sends send boil water notice"
      }
      on command CustomerNotificationService.SendMaintenanceAlert is {
        do "the model sends send maintenance alert"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerNotificationService"
      }
    } with {
      briefly "to customer notification service"
      described as {
        |Carries messages to the external CustomerNotificationService.
      }
    }
  } with {
    briefly "CustomerNotificationService integration"
    described as {
      |The model's side of the CustomerNotificationService conversation.
    }
  }
  adaptor FromLaboratoryService from context LaboratoryService is { 
    handler FromLaboratoryServiceHandler is {
      on event LaboratoryService.ResultsAvailable is {
        do "the model receives results available"
      }
      on event LaboratoryService.SampleReceived is {
        do "the model receives sample received"
      }
      on other is {
        error "Unexpected message for adaptor FromLaboratoryService"
      }
    } with {
      briefly "from laboratory service"
      described as {
        |Carries messages from the external LaboratoryService.
      }
    }
  } with {
    briefly "LaboratoryService integration"
    described as {
      |The model's side of the LaboratoryService conversation.
    }
  }
  adaptor ToLaboratoryService to context LaboratoryService is { 
    handler ToLaboratoryServiceHandler is {
      on command LaboratoryService.SubmitSampleForTesting is {
        do "the model sends submit sample for testing"
      }
      on other is {
        error "Unexpected message for adaptor ToLaboratoryService"
      }
    } with {
      briefly "to laboratory service"
      described as {
        |Carries messages to the external LaboratoryService.
      }
    }
  } with {
    briefly "LaboratoryService integration"
    described as {
      |The model's side of the LaboratoryService conversation.
    }
  }
  adaptor FromRegulatoryReportingService from context RegulatoryReportingService is { 
    handler FromRegulatoryReportingServiceHandler is {
      on event RegulatoryReportingService.ReportSubmitted is {
        do "the model receives report submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryReportingService"
      }
    } with {
      briefly "from regulatory reporting service"
      described as {
        |Carries messages from the external RegulatoryReportingService.
      }
    }
  } with {
    briefly "RegulatoryReportingService integration"
    described as {
      |The model's side of the RegulatoryReportingService conversation.
    }
  }
  adaptor ToRegulatoryReportingService to context RegulatoryReportingService is { 
    handler ToRegulatoryReportingServiceHandler is {
      on command RegulatoryReportingService.SubmitAnnualReport is {
        do "the model sends submit annual report"
      }
      on command RegulatoryReportingService.SubmitComplianceReport is {
        do "the model sends submit compliance report"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryReportingService"
      }
    } with {
      briefly "to regulatory reporting service"
      described as {
        |Carries messages to the external RegulatoryReportingService.
      }
    }
  } with {
    briefly "RegulatoryReportingService integration"
    described as {
      |The model's side of the RegulatoryReportingService conversation.
    }
  }
  include "types.riddl"
  include "DistributionZone.riddl"
  repository WaterRepository as merge is {
    inlet WaterRepositoryFromDistributionZone is type DistributionZoneEvent    inlet WaterRepositoryFromWaterQualityAnalytics is type DistributionZoneEvent    outlet WaterRepositoryResponses is type DistributionZone.DistributionZoneResult
    record StoredDistributionZone is  {
      distributionZoneId: DistributionZoneId with {
        briefly "distributionZoneId"
        described as {
          |The distributionZoneId column of the stored distributionZone row.
        }
      }
      qualityStatus: WaterQualityStatus with {
        briefly "qualityStatus"
        described as {
          |The qualityStatus column of the stored distributionZone row.
        }
      }
      status: ZoneStatus with {
        briefly "status"
        described as {
          |The status column of the stored distributionZone row.
        }
      }
      zoneId: DistributionZoneId with {
        briefly "zoneId"
        described as {
          |The zoneId column of the stored distributionZone row.
        }
      }
    } with {
      briefly "Stored distributionZone row"
      described as {
        |The persistence shape of distributionZone data as this repository stores it.
      }
    }
    schema WaterData is relational
      of distributionZones as type StoredDistributionZone
        index on field StoredDistributionZone.zoneId
        index on field StoredDistributionZone.status
        index on field StoredDistributionZone.qualityStatus
 with {
      briefly "Water data schema"
      described as {
        |The relational schema holding water data for the WaterRepository.
      }
    }
    handler WaterPersistence is {
      on query GetComplianceMetrics is {
        do "read the compliance metrics projection"
        reply result ComplianceMetricsView
      }
      on query GetSystemPerformance is {
        do "read the system performance projection"
        reply result SystemPerformanceView
      }
      on command DistributionZone.CreateZone is {
        tell event DistributionZone.ZoneCreated to entity WaterContext.DistributionZone
        do "Store new distribution zone"
      }
      on command DistributionZone.RecordPressure is {
        tell event DistributionZone.PressureRecorded to entity WaterContext.DistributionZone
        do "Store pressure reading"
      }
      on command DistributionZone.SubmitQualitySample is {
        tell event DistributionZone.QualitySampleSubmitted to entity WaterContext.DistributionZone
        do "Store quality sample"
      }
      on command DistributionZone.ReportLeak is {
        do "Store leak report"
      }
      on command DistributionZone.IssueBoilWaterAdvisory is {
        tell event DistributionZone.BoilWaterAdvisoryIssued to entity WaterContext.DistributionZone
        do "Update zone status to advisory"
      }
      on command DistributionZone.LiftBoilWaterAdvisory is {
        tell event DistributionZone.BoilWaterAdvisoryLifted to entity WaterContext.DistributionZone
        do "Update zone status to normal"
      }
    } with {
      briefly "Persists water commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Water data persistence"
    described as {
      |Persistent storage for water operations.
    }
  }
  query GetComplianceMetrics is  {
    complianceMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which compliance metrics to retrieve.
      }
    }
  } with {
    briefly "Get compliance metrics"
    described as {
      |Retrieves the compliance metrics projection.
    }
  }
  result ComplianceMetricsView is  {
    complianceMetrics: WaterQualityAnalytics.ComplianceMetrics with {
      briefly "Compliance metrics"
      described as {
        |The compliance metrics being returned.
      }
    }
  } with {
    briefly "Compliance metrics view"
    described as {
      |Read model view carrying the compliance metrics projection.
    }
  }
  query GetSystemPerformance is  {
    systemPerformanceKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which system performance to retrieve.
      }
    }
  } with {
    briefly "Get system performance"
    described as {
      |Retrieves the system performance projection.
    }
  }
  result SystemPerformanceView is  {
    systemPerformance: WaterQualityAnalytics.SystemPerformance with {
      briefly "System performance"
      described as {
        |The system performance being returned.
      }
    }
  } with {
    briefly "System performance view"
    described as {
      |Read model view carrying the system performance projection.
    }
  }
  projector WaterQualityAnalytics as flow is {
    updates repository WaterContext.WaterRepository
    inlet WaterQualityAnalyticsFromDistributionZone is type DistributionZoneEvent    outlet WaterQualityAnalyticsOut is type DistributionZoneEvent
    record ComplianceMetrics is  {
      samplesTaken: Natural with {
        briefly "Samples"
        described as {
          |Total samples.
        }
      }
      compliantSamples: Natural with {
        briefly "Compliant"
        described as {
          |Compliant samples.
        }
      }
      complianceRate: Decimal(5,2) with {
        briefly "Rate"
        described as {
          |Compliance rate.
        }
      }
      violationCount: Natural with {
        briefly "Violations"
        described as {
          |Violation count.
        }
      }
    } with {
      briefly "Compliance metrics"
      described as {
        |Water quality compliance.
      }
    }
    record SystemPerformance is  {
      averagePressurePSI: Decimal(6,2) with {
        briefly "Avg pressure"
        described as {
          |Average pressure.
        }
      }
      leaksReported: Natural with {
        briefly "Leaks"
        described as {
          |Leaks reported.
        }
      }
      waterLossPercent: Decimal(5,2) with {
        briefly "Loss"
        described as {
          |Water loss percentage.
        }
      }
    } with {
      briefly "System performance"
      described as {
        |System performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on qualitySampleSubmitted: event DistributionZone.QualitySampleSubmitted is {
        tell qualitySampleSubmitted to repository WaterContext.WaterRepository
        do "Update compliance metrics"
      }
      on pressureRecorded: event DistributionZone.PressureRecorded is {
        tell pressureRecorded to repository WaterContext.WaterRepository
        do "Update pressure analytics"
      }
      on leakReported: event DistributionZone.LeakReported is {
        tell leakReported to repository WaterContext.WaterRepository
        do "Update leak metrics"
      }
    } with {
      briefly "Maintains water analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Water quality analytics"
    described as {
      |Water system analytics.
    }
  }
  // ---- Event publication for DistributionZone ----
  type DistributionZoneEvent is one of {
    WaterContext.DistributionZone.ZoneCreated or WaterContext.DistributionZone.PressureRecorded or WaterContext.DistributionZone.QualitySampleSubmitted or WaterContext.DistributionZone.LeakReported or WaterContext.DistributionZone.MaintenanceScheduled or WaterContext.DistributionZone.BoilWaterAdvisoryIssued or WaterContext.DistributionZone.BoilWaterAdvisoryLifted or WaterContext.DistributionZone.ReservoirLevelUpdated
  } with {
    briefly "DistributionZone event alternation"
    described as {
      |Union of all DistributionZone events, for streaming and event-sourced
      |persistence.
    }
  }
  processor DistributionZoneEventSource as source is {
    outlet DistributionZoneEvents is type DistributionZoneEvent
    handler DistributionZoneSourceHandler is {
      on zoneCreated: event DistributionZone.ZoneCreated is {
        send zoneCreated to outlet DistributionZoneEvents
      }
      on pressureRecorded: event DistributionZone.PressureRecorded is {
        send pressureRecorded to outlet DistributionZoneEvents
      }
      on qualitySampleSubmitted: event DistributionZone.QualitySampleSubmitted is {
        send qualitySampleSubmitted to outlet DistributionZoneEvents
      }
      on leakReported: event DistributionZone.LeakReported is {
        send leakReported to outlet DistributionZoneEvents
      }
      on maintenanceScheduled: event DistributionZone.MaintenanceScheduled is {
        send maintenanceScheduled to outlet DistributionZoneEvents
      }
      on boilWaterAdvisoryIssued: event DistributionZone.BoilWaterAdvisoryIssued is {
        send boilWaterAdvisoryIssued to outlet DistributionZoneEvents
      }
      on boilWaterAdvisoryLifted: event DistributionZone.BoilWaterAdvisoryLifted is {
        send boilWaterAdvisoryLifted to outlet DistributionZoneEvents
      }
      on reservoirLevelUpdated: event DistributionZone.ReservoirLevelUpdated is {
        send reservoirLevelUpdated to outlet DistributionZoneEvents
      }
      on other is {
        error "Unexpected message for source DistributionZoneEventSource"
      }
    } with {
      briefly "DistributionZone source handler"
      described as {
        |Publishes DistributionZone events onto the outlet.
      }
    }
  } with {
    briefly "DistributionZone event source"
    described as {
      |Publishes DistributionZone entity events into the streaming topology.
    }
  }
  processor DistributionZoneEventSink as sink is {
    inlet DistributionZoneInlet is type DistributionZoneEvent    handler DistributionZoneSinkHandler is {
      on zoneCreated: event DistributionZone.ZoneCreated is {
        tell zoneCreated to repository WaterContext.WaterRepository
      }
      on pressureRecorded: event DistributionZone.PressureRecorded is {
        tell pressureRecorded to repository WaterContext.WaterRepository
      }
      on qualitySampleSubmitted: event DistributionZone.QualitySampleSubmitted is {
        tell qualitySampleSubmitted to repository WaterContext.WaterRepository
      }
      on leakReported: event DistributionZone.LeakReported is {
        tell leakReported to repository WaterContext.WaterRepository
      }
      on maintenanceScheduled: event DistributionZone.MaintenanceScheduled is {
        tell maintenanceScheduled to repository WaterContext.WaterRepository
      }
      on boilWaterAdvisoryIssued: event DistributionZone.BoilWaterAdvisoryIssued is {
        tell boilWaterAdvisoryIssued to repository WaterContext.WaterRepository
      }
      on boilWaterAdvisoryLifted: event DistributionZone.BoilWaterAdvisoryLifted is {
        tell boilWaterAdvisoryLifted to repository WaterContext.WaterRepository
      }
      on reservoirLevelUpdated: event DistributionZone.ReservoirLevelUpdated is {
        tell reservoirLevelUpdated to repository WaterContext.WaterRepository
      }
      on other is {
        error "Unexpected message for sink DistributionZoneEventSink"
      }
    } with {
      briefly "DistributionZone sink handler"
      described as {
        |Persists DistributionZone events via the repository.
      }
    }
  } with {
    briefly "DistributionZone event sink"
    described as {
      |Receives DistributionZone events for persistence.
    }
  }
  connector DistributionZoneEventFlow is from outlet WaterContext.DistributionZoneEventSource.DistributionZoneEvents to inlet WaterContext.DistributionZoneEventSink.DistributionZoneInlet with {
    briefly "DistributionZone event flow"
    described as {
      |Connects the DistributionZone source to its sink.
    }
  }
  processor DistributionZoneEventSplit as split is {
    inlet DistributionZoneEventSplitIn is type DistributionZoneEvent    outlet DistributionZoneEventSplitToWaterRepository is type DistributionZoneEvent
    outlet DistributionZoneEventSplitToWaterQualityAnalytics is type DistributionZoneEvent
    handler DistributionZoneEventSplitHandler is {
      on zoneCreated: event DistributionZone.ZoneCreated is {
        send zoneCreated to outlet DistributionZoneEventSplitToWaterRepository
        send zoneCreated to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell zoneCreated to entity WaterContext.DistributionZone
      }
      on pressureRecorded: event DistributionZone.PressureRecorded is {
        send pressureRecorded to outlet DistributionZoneEventSplitToWaterRepository
        send pressureRecorded to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell pressureRecorded to entity WaterContext.DistributionZone
      }
      on qualitySampleSubmitted: event DistributionZone.QualitySampleSubmitted is {
        send qualitySampleSubmitted to outlet DistributionZoneEventSplitToWaterRepository
        send qualitySampleSubmitted to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell qualitySampleSubmitted to entity WaterContext.DistributionZone
      }
      on leakReported: event DistributionZone.LeakReported is {
        send leakReported to outlet DistributionZoneEventSplitToWaterRepository
        send leakReported to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell leakReported to entity WaterContext.DistributionZone
      }
      on maintenanceScheduled: event DistributionZone.MaintenanceScheduled is {
        send maintenanceScheduled to outlet DistributionZoneEventSplitToWaterRepository
        send maintenanceScheduled to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell maintenanceScheduled to entity WaterContext.DistributionZone
      }
      on boilWaterAdvisoryIssued: event DistributionZone.BoilWaterAdvisoryIssued is {
        send boilWaterAdvisoryIssued to outlet DistributionZoneEventSplitToWaterRepository
        send boilWaterAdvisoryIssued to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell boilWaterAdvisoryIssued to entity WaterContext.DistributionZone
      }
      on boilWaterAdvisoryLifted: event DistributionZone.BoilWaterAdvisoryLifted is {
        send boilWaterAdvisoryLifted to outlet DistributionZoneEventSplitToWaterRepository
        send boilWaterAdvisoryLifted to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell boilWaterAdvisoryLifted to entity WaterContext.DistributionZone
      }
      on reservoirLevelUpdated: event DistributionZone.ReservoirLevelUpdated is {
        send reservoirLevelUpdated to outlet DistributionZoneEventSplitToWaterRepository
        send reservoirLevelUpdated to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell reservoirLevelUpdated to entity WaterContext.DistributionZone
      }
      on other is {
        error "Unexpected message for processor DistributionZoneEventSplit"
      }
    } with {
      briefly "DistributionZone event fan-out handler"
      described as {
        |Delivers each DistributionZone event to all of its consumers.
      }
    }
  } with {
    briefly "DistributionZone event fan-out"
    described as {
      |Fans DistributionZone events out to the repository and projectors.
    }
  }
  connector 'DistributionZoneEvent Stream' is from outlet WaterContext.DistributionZone.DistributionZoneEvents2 to inlet WaterContext.DistributionZoneEventSplit.DistributionZoneEventSplitIn with {
    briefly "DistributionZone events, fanned out to storage and read models"
  }
  connector 'DistributionZoneEvent Storage' is from outlet WaterContext.DistributionZoneEventSplit.DistributionZoneEventSplitToWaterRepository to inlet WaterContext.WaterRepository.WaterRepositoryFromDistributionZone with {
    briefly "DistributionZone events on their way to storage"
  }
  connector 'WaterQualityAnalytics Feed' is from outlet WaterContext.DistributionZoneEventSplit.DistributionZoneEventSplitToWaterQualityAnalytics to inlet WaterContext.WaterQualityAnalytics.WaterQualityAnalyticsFromDistributionZone with {
    briefly "DistributionZone events feeding the WaterQualityAnalytics projection"
  }
  connector 'WaterQualityAnalytics Storage' is from outlet WaterContext.WaterQualityAnalytics.WaterQualityAnalyticsOut to inlet WaterContext.WaterRepository.WaterRepositoryFromWaterQualityAnalytics with {
    briefly "The WaterQualityAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for water distribution"
  described as {
    |Water distribution management context.
  }
}
