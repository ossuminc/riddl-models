// Water Distribution - Water Context
context WaterContext is {
  include "types.riddl"
  include "DistributionZone.riddl"
  repository WaterRepository is {
    inlet WaterRepositoryFromDistributionZone is type DistributionZoneEvent
    inlet WaterRepositoryFromWaterQualityAnalytics is type DistributionZoneEvent
    outlet WaterRepositoryResponses is type DistributionZone.DistributionZoneResult
    schema WaterData is relational
      of distributionZones as type DistributionZone
        index on field DistributionZone.zoneId
        index on field DistributionZone.status
        index on field DistributionZone.qualityStatus

    handler WaterPersistence is {
      on command DistributionZone.CreateZone is {
        tell event DistributionZone.ZoneCreated to entity WaterContext.DistributionZone
        do "Store new distribution zone"
      }
      on command DistributionZone.RecordPressure is {
        tell event DistributionZone.PressureRecorded to entity WaterContext.DistributionZone
        do "Store pressure reading"
      }
      on command DistributionZone.SubmitQualitySample is {
        tell event DistributionZone.QualitySampleSubmitted to entity WaterContext.DistributionZone
        do "Store quality sample"
      }
      on command DistributionZone.ReportLeak is {
        do "Store leak report"
      }
      on command DistributionZone.IssueBoilWaterAdvisory is {
        tell event DistributionZone.BoilWaterAdvisoryIssued to entity WaterContext.DistributionZone
        do "Update zone status to advisory"
      }
      on command DistributionZone.LiftBoilWaterAdvisory is {
        tell event DistributionZone.BoilWaterAdvisoryLifted to entity WaterContext.DistributionZone
        do "Update zone status to normal"
      }
    } with {
      briefly "Persists water commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Water data persistence"
    described as {
      |Persistent storage for water operations.
    }
  }
  projector WaterQualityAnalytics is {
    inlet WaterQualityAnalyticsFromDistributionZone is type DistributionZoneEvent
    outlet WaterQualityAnalyticsOut is type DistributionZoneEvent
    updates repository WaterContext.WaterRepository
    record ComplianceMetrics is  {
      samplesTaken: Natural with {
        briefly "Samples"
        described as {
          |Total samples.
        }
      }
      compliantSamples: Natural with {
        briefly "Compliant"
        described as {
          |Compliant samples.
        }
      }
      complianceRate: Decimal(5,2) with {
        briefly "Rate"
        described as {
          |Compliance rate.
        }
      }
      violationCount: Natural with {
        briefly "Violations"
        described as {
          |Violation count.
        }
      }
    } with {
      briefly "Compliance metrics"
      described as {
        |Water quality compliance.
      }
    }
    record SystemPerformance is  {
      averagePressurePSI: Decimal(6,2) with {
        briefly "Avg pressure"
        described as {
          |Average pressure.
        }
      }
      leaksReported: Natural with {
        briefly "Leaks"
        described as {
          |Leaks reported.
        }
      }
      waterLossPercent: Decimal(5,2) with {
        briefly "Loss"
        described as {
          |Water loss percentage.
        }
      }
    } with {
      briefly "System performance"
      described as {
        |System performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on event DistributionZone.QualitySampleSubmitted is {
        tell event DistributionZone.QualitySampleSubmitted to repository WaterContext.WaterRepository
        do "Update compliance metrics"
      }
      on event DistributionZone.PressureRecorded is {
        tell event DistributionZone.PressureRecorded to repository WaterContext.WaterRepository
        do "Update pressure analytics"
      }
      on event DistributionZone.LeakReported is {
        tell event DistributionZone.LeakReported to repository WaterContext.WaterRepository
        do "Update leak metrics"
      }
    } with {
      briefly "Maintains water analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Water quality analytics"
    described as {
      |Water system analytics.
    }
  }
  // ---- Event publication for DistributionZone ----
  type DistributionZoneEvent is one of {
    WaterContext.DistributionZone.ZoneCreated,
    WaterContext.DistributionZone.PressureRecorded,
    WaterContext.DistributionZone.QualitySampleSubmitted,
    WaterContext.DistributionZone.LeakReported,
    WaterContext.DistributionZone.MaintenanceScheduled,
    WaterContext.DistributionZone.BoilWaterAdvisoryIssued,
    WaterContext.DistributionZone.BoilWaterAdvisoryLifted,
    WaterContext.DistributionZone.ReservoirLevelUpdated
  } with {
    briefly "DistributionZone event alternation"
    described as {
      |Union of all DistributionZone events, for streaming and event-sourced
      |persistence.
    }
  }
  processor DistributionZoneEventSource as source is {
    outlet DistributionZoneEvents is type DistributionZoneEvent
    handler DistributionZoneSourceHandler is {
      on event DistributionZone.ZoneCreated is {
        send event DistributionZone.ZoneCreated to outlet DistributionZoneEvents
      }
      on event DistributionZone.PressureRecorded is {
        send event DistributionZone.PressureRecorded to outlet DistributionZoneEvents
      }
      on event DistributionZone.QualitySampleSubmitted is {
        send event DistributionZone.QualitySampleSubmitted to outlet DistributionZoneEvents
      }
      on event DistributionZone.LeakReported is {
        send event DistributionZone.LeakReported to outlet DistributionZoneEvents
      }
      on event DistributionZone.MaintenanceScheduled is {
        send event DistributionZone.MaintenanceScheduled to outlet DistributionZoneEvents
      }
      on event DistributionZone.BoilWaterAdvisoryIssued is {
        send event DistributionZone.BoilWaterAdvisoryIssued to outlet DistributionZoneEvents
      }
      on event DistributionZone.BoilWaterAdvisoryLifted is {
        send event DistributionZone.BoilWaterAdvisoryLifted to outlet DistributionZoneEvents
      }
      on event DistributionZone.ReservoirLevelUpdated is {
        send event DistributionZone.ReservoirLevelUpdated to outlet DistributionZoneEvents
      }
      on other is {
        error "Unexpected message for source DistributionZoneEventSource"
      }
    } with {
      briefly "DistributionZone source handler"
      described as {
        |Publishes DistributionZone events onto the outlet.
      }
    }
  } with {
    briefly "DistributionZone event source"
    described as {
      |Publishes DistributionZone entity events into the streaming topology.
    }
  }
  processor DistributionZoneEventSink as sink is {
    inlet DistributionZoneInlet is type DistributionZoneEvent
    handler DistributionZoneSinkHandler is {
      on event DistributionZone.ZoneCreated is {
        tell event DistributionZone.ZoneCreated to repository WaterContext.WaterRepository
      }
      on event DistributionZone.PressureRecorded is {
        tell event DistributionZone.PressureRecorded to repository WaterContext.WaterRepository
      }
      on event DistributionZone.QualitySampleSubmitted is {
        tell event DistributionZone.QualitySampleSubmitted to repository WaterContext.WaterRepository
      }
      on event DistributionZone.LeakReported is {
        tell event DistributionZone.LeakReported to repository WaterContext.WaterRepository
      }
      on event DistributionZone.MaintenanceScheduled is {
        tell event DistributionZone.MaintenanceScheduled to repository WaterContext.WaterRepository
      }
      on event DistributionZone.BoilWaterAdvisoryIssued is {
        tell event DistributionZone.BoilWaterAdvisoryIssued to repository WaterContext.WaterRepository
      }
      on event DistributionZone.BoilWaterAdvisoryLifted is {
        tell event DistributionZone.BoilWaterAdvisoryLifted to repository WaterContext.WaterRepository
      }
      on event DistributionZone.ReservoirLevelUpdated is {
        tell event DistributionZone.ReservoirLevelUpdated to repository WaterContext.WaterRepository
      }
      on other is {
        error "Unexpected message for sink DistributionZoneEventSink"
      }
    } with {
      briefly "DistributionZone sink handler"
      described as {
        |Persists DistributionZone events via the repository.
      }
    }
  } with {
    briefly "DistributionZone event sink"
    described as {
      |Receives DistributionZone events for persistence.
    }
  }
  connector DistributionZoneEventFlow is {
    from outlet WaterContext.DistributionZoneEventSource.DistributionZoneEvents to
      inlet WaterContext.DistributionZoneEventSink.DistributionZoneInlet
  } with {
    briefly "DistributionZone event flow"
    described as {
      |Connects the DistributionZone source to its sink.
    }
  }
  processor DistributionZoneEventSplit is {
    inlet DistributionZoneEventSplitIn is type DistributionZoneEvent
    outlet DistributionZoneEventSplitToWaterRepository is type DistributionZoneEvent
    outlet DistributionZoneEventSplitToWaterQualityAnalytics is type DistributionZoneEvent
    handler DistributionZoneEventSplitHandler is {
      on event DistributionZone.ZoneCreated is {
        send event DistributionZone.ZoneCreated to outlet DistributionZoneEventSplitToWaterRepository
        send event DistributionZone.ZoneCreated to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell event DistributionZone.ZoneCreated to entity WaterContext.DistributionZone
      }
      on event DistributionZone.PressureRecorded is {
        send event DistributionZone.PressureRecorded to outlet DistributionZoneEventSplitToWaterRepository
        send event DistributionZone.PressureRecorded to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell event DistributionZone.PressureRecorded to entity WaterContext.DistributionZone
      }
      on event DistributionZone.QualitySampleSubmitted is {
        send event DistributionZone.QualitySampleSubmitted to outlet DistributionZoneEventSplitToWaterRepository
        send event DistributionZone.QualitySampleSubmitted to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell event DistributionZone.QualitySampleSubmitted to entity WaterContext.DistributionZone
      }
      on event DistributionZone.LeakReported is {
        send event DistributionZone.LeakReported to outlet DistributionZoneEventSplitToWaterRepository
        send event DistributionZone.LeakReported to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell event DistributionZone.LeakReported to entity WaterContext.DistributionZone
      }
      on event DistributionZone.MaintenanceScheduled is {
        send event DistributionZone.MaintenanceScheduled to outlet DistributionZoneEventSplitToWaterRepository
        send event DistributionZone.MaintenanceScheduled to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell event DistributionZone.MaintenanceScheduled to entity WaterContext.DistributionZone
      }
      on event DistributionZone.BoilWaterAdvisoryIssued is {
        send event DistributionZone.BoilWaterAdvisoryIssued to outlet DistributionZoneEventSplitToWaterRepository
        send event DistributionZone.BoilWaterAdvisoryIssued to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell event DistributionZone.BoilWaterAdvisoryIssued to entity WaterContext.DistributionZone
      }
      on event DistributionZone.BoilWaterAdvisoryLifted is {
        send event DistributionZone.BoilWaterAdvisoryLifted to outlet DistributionZoneEventSplitToWaterRepository
        send event DistributionZone.BoilWaterAdvisoryLifted to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell event DistributionZone.BoilWaterAdvisoryLifted to entity WaterContext.DistributionZone
      }
      on event DistributionZone.ReservoirLevelUpdated is {
        send event DistributionZone.ReservoirLevelUpdated to outlet DistributionZoneEventSplitToWaterRepository
        send event DistributionZone.ReservoirLevelUpdated to outlet DistributionZoneEventSplitToWaterQualityAnalytics
        tell event DistributionZone.ReservoirLevelUpdated to entity WaterContext.DistributionZone
      }
      on other is {
        error "Unexpected message for processor DistributionZoneEventSplit"
      }
    } with {
      briefly "DistributionZone event fan-out handler"
      described as {
        |Delivers each DistributionZone event to all of its consumers.
      }
    }
  } with {
    briefly "DistributionZone event fan-out"
    described as {
      |Fans DistributionZone events out to the repository and projectors.
    }
  }
  connector LinkDistributionZoneToDistributionZoneEventSplit is {
    from outlet WaterContext.DistributionZone.DistributionZoneEvents2 to
      inlet WaterContext.DistributionZoneEventSplit.DistributionZoneEventSplitIn
  } with {
    briefly "LinkDistributionZoneToDistributionZoneEventSplit"
  }
  connector LinkDistributionZoneEventSplitToWaterRepository is {
    from outlet WaterContext.DistributionZoneEventSplit.DistributionZoneEventSplitToWaterRepository to
      inlet WaterContext.WaterRepository.WaterRepositoryFromDistributionZone
  } with {
    briefly "LinkDistributionZoneEventSplitToWaterRepository"
  }
  connector LinkDistributionZoneEventSplitToWaterQualityAnalytics is {
    from outlet WaterContext.DistributionZoneEventSplit.DistributionZoneEventSplitToWaterQualityAnalytics to
      inlet WaterContext.WaterQualityAnalytics.WaterQualityAnalyticsFromDistributionZone
  } with {
    briefly "LinkDistributionZoneEventSplitToWaterQualityAnalytics"
  }
  connector LinkWaterQualityAnalyticsToWaterRepository is {
    from outlet WaterContext.WaterQualityAnalytics.WaterQualityAnalyticsOut to
      inlet WaterContext.WaterRepository.WaterRepositoryFromWaterQualityAnalytics
  } with {
    briefly "LinkWaterQualityAnalyticsToWaterRepository"
  }
} with {
  briefly "Bounded context for water distribution"
  described as {
    |Water distribution management context.
  }
}
