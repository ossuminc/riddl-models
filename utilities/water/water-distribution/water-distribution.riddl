// Water Distribution Domain Model
// Municipal water distribution system
domain WaterDistribution is {
  persistent connector 'LaboratoryServiceEvent Stream' is from outlet LaboratoryService.LaboratoryServiceEventsOut to inlet WaterContext.FromLaboratoryService.FromLaboratoryServiceIn with {
    briefly "What LaboratoryService tells WaterContext, unasked"
  }
  persistent connector 'RegulatoryReportingServiceEvent Stream' is from outlet RegulatoryReportingService.RegulatoryReportingServiceEventsOut to inlet WaterContext.FromRegulatoryReportingService.FromRegulatoryReportingServiceIn with {
    briefly "What RegulatoryReportingService tells WaterContext, unasked"
  }
  persistent connector 'LaboratoryServiceRequest Stream' is from outlet WaterContext.ToLaboratoryService.ToLaboratoryServiceOut to inlet LaboratoryService.LaboratoryServiceRequests with {
    briefly "What WaterContext asks LaboratoryService to send"
  }
  persistent connector 'RegulatoryReportingServiceRequest Stream' is from outlet WaterContext.ToRegulatoryReportingService.ToRegulatoryReportingServiceOut to inlet RegulatoryReportingService.RegulatoryReportingServiceRequests with {
    briefly "What WaterContext asks RegulatoryReportingService to send"
  }
  persistent connector 'CustomerNotificationServiceRequest Stream' is from outlet WaterContext.ToCustomerNotificationService.ToCustomerNotificationServiceOut to inlet CustomerNotificationService.CustomerNotificationServiceRequests with {
    briefly "What WaterContext asks CustomerNotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user WaterOperator is "person managing water system" with {
    briefly "Water Operator"
    described as {
      |Operator managing distribution system.
    }
  }
  user QualityTechnician is "person testing water quality" with {
    briefly "Quality Technician"
    described as {
      |Technician performing water quality testing.
    }
  }
  user MaintenanceCrew is "team performing pipe maintenance" with {
    briefly "Maintenance Crew"
    described as {
      |Crew performing repairs and maintenance.
    }
  }
  epic WaterSystemManagement is {
    user WaterOperator wants to "to maintain water distribution" so that "safe water is delivered to customers"
    case MonitorPressure is {
      user WaterOperator wants to "to maintain system pressure" so that "customers receive adequate flow"
      step is "Operator monitors" "pressure readings" "across zones" with {
        briefly "Monitor pressure"
        described as {
          |Track pressure.
        }
      }
      step is "System adjusts" "pump operations" "as needed" with {
        briefly "Adjust pumps"
        described as {
          |Maintain pressure.
        }
      }
    } with {
      briefly "Monitor system pressure"
      described as {
        |Maintaining distribution pressure.
      }
    }
  } with {
    briefly "Water system management"
    described as {
      |Epic for water distribution.
    }
  }
  include "WaterContext.riddl"
  include "external-contexts.riddl"
  application context WaterDistributionApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in WaterDistribution are delivered.
      }
    }
    group WaterDistributionScreen is {
      input CreateZoneInput acquires command WaterContext.CreateZone with {
        briefly "Create zone control"
        described as {
          |The control through which a user submits the create zone request.
        }
      }
      input IssueBoilWaterAdvisoryInput acquires command WaterContext.DistributionZone.IssueBoilWaterAdvisory with {
        briefly "Issue boil water advisory control"
        described as {
          |The control through which a user submits the issue boil water advisory request.
        }
      }
      input LiftBoilWaterAdvisoryInput acquires command WaterContext.DistributionZone.LiftBoilWaterAdvisory with {
        briefly "Lift boil water advisory control"
        described as {
          |The control through which a user submits the lift boil water advisory request.
        }
      }
      input ReportLeakInput acquires command WaterContext.DistributionZone.ReportLeak with {
        briefly "Report leak control"
        described as {
          |The control through which a user submits the report leak request.
        }
      }
      input ScheduleMaintenanceInput acquires command WaterContext.DistributionZone.ScheduleMaintenance with {
        briefly "Schedule maintenance control"
        described as {
          |The control through which a user submits the schedule maintenance request.
        }
      }
      input SubmitQualitySampleInput acquires command WaterContext.DistributionZone.SubmitQualitySample with {
        briefly "Submit quality sample control"
        described as {
          |The control through which a user submits the submit quality sample request.
        }
      }
    } with {
      briefly "Water distribution screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppDistributionZoneCommands is type WaterContext.DistributionZoneRequest
    inlet AppWaterRepositoryResponses is result WaterContext.DistributionZone.DistributionZoneResult
    handler WaterDistributionAppHandler is {
      on other is {
        error "Unexpected message for application context WaterDistributionApp"
      }
    } with {
      briefly "WaterDistributionApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "WaterDistributionApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'DistributionZoneCommand Stream' is from outlet WaterDistributionApp.AppDistributionZoneCommands to inlet WaterContext.DistributionZoneCommandStreaIn with {
    briefly "DistributionZone commands from the application"
  }
  persistent connector 'DistributionZoneResult Stream' is from outlet WaterContext.DistributionZoneResultStreamOut to inlet WaterDistributionApp.AppWaterRepositoryResponses with {
    briefly "Water query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet WaterDistributionApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Water distribution domain"
  described as {
    |Municipal water distribution management.
  }
}
