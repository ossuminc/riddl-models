// Water Distribution Domain Model
// Municipal water distribution system
domain WaterDistribution is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user WaterOperator is "person managing water system" with {
    briefly "Water Operator"
    described as {
      |Operator managing distribution system.
    }
  }
  user QualityTechnician is "person testing water quality" with {
    briefly "Quality Technician"
    described as {
      |Technician performing water quality testing.
    }
  }
  user MaintenanceCrew is "team performing pipe maintenance" with {
    briefly "Maintenance Crew"
    described as {
      |Crew performing repairs and maintenance.
    }
  }
  epic WaterSystemManagement is {
    user WaterOperator wants to "to maintain water distribution" so that "safe water is delivered to customers"
    case MonitorPressure is {
      user WaterOperator wants to "to maintain system pressure" so that "customers receive adequate flow"
      step is "Operator monitors" "pressure readings" "across zones" with {
        briefly "Monitor pressure"
        described as {
          |Track pressure.
        }
      }
      step is "System adjusts" "pump operations" "as needed" with {
        briefly "Adjust pumps"
        described as {
          |Maintain pressure.
        }
      }
    } with {
      briefly "Monitor system pressure"
      described as {
        |Maintaining distribution pressure.
      }
    }
  } with {
    briefly "Water system management"
    described as {
      |Epic for water distribution.
    }
  }
  include "WaterContext.riddl"
  include "external-contexts.riddl"
  application context WaterDistributionApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in WaterDistribution are delivered.
      }
    }
    outlet AppDistributionZoneCommands is type WaterContext.DistributionZone.DistributionZoneCommand
    inlet AppWaterRepositoryResponses is type WaterContext.DistributionZone.DistributionZoneResult    handler WaterDistributionAppHandler is {
      on other is {
        error "Unexpected message for application context WaterDistributionApp"
      }
    } with {
      briefly "WaterDistributionApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "WaterDistributionApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'DistributionZoneCommand Stream' is from outlet WaterDistributionApp.AppDistributionZoneCommands to inlet WaterContext.DistributionZone.DistributionZoneCommands with {
    option persistent()
    briefly "DistributionZone commands from the application"
  }
  connector 'DistributionZoneResult Stream' is from outlet WaterContext.WaterRepository.WaterRepositoryResponses to inlet WaterDistributionApp.AppWaterRepositoryResponses with {
    option persistent()
    briefly "Water query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet WaterDistributionApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Water distribution domain"
  described as {
    |Municipal water distribution management.
  }
}
