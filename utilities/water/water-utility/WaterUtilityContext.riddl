// Water Utility - Water Utility Context
context WaterUtilityContext is {
  include "types.riddl"
  include "WaterSystem.riddl"
  repository WaterUtilityRepository is {
    inlet WaterUtilityRepositoryFromWaterSystem is type WaterSystemEvent
    inlet WaterUtilityRepositoryFromWaterUtilityMetrics is type WaterSystemEvent
    outlet WaterUtilityRepositoryResponses is type WaterSystem.WaterSystemResult
    schema WaterUtilityData is relational
      of waterSystems as type WaterSystem
        index on field WaterSystem.systemId
        index on field WaterSystem.status
        index on field WaterSystem.systemName

    handler WaterUtilityPersistence is {
      on command WaterSystem.RegisterSystem is {
        prompt "Store new water system"
      }
      on command WaterSystem.UpdateTreatmentStatus is {
        tell event WaterSystem.TreatmentStatusUpdated to entity WaterUtilityContext.WaterSystem
        prompt "Update treatment plant status"
      }
      on command WaterSystem.RecordQualityTest is {
        tell event WaterSystem.QualityTestRecorded to entity WaterUtilityContext.WaterSystem
        prompt "Store quality test result"
      }
      on command WaterSystem.ReportLeak is {
        prompt "Store leak report"
      }
      on command WaterSystem.ResolveLeak is {
        prompt "Update leak report as resolved"
      }
      on command WaterSystem.SubmitComplianceReport is {
        tell event WaterSystem.ComplianceReportSubmitted to entity WaterUtilityContext.WaterSystem
        prompt "Store compliance report"
      }
    } with {
      briefly "Persists water utility events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Water utility data persistence"
    described as {
      |Persistent storage for water utility data.
    }
  }
  projector WaterUtilityMetrics is {
    inlet WaterUtilityMetricsFromWaterSystem is type WaterSystemEvent
    outlet WaterUtilityMetricsOut is type WaterSystemEvent
    updates repository WaterUtilityContext.WaterUtilityRepository
    record SystemMetrics is  {
      totalSystems: Natural with {
        briefly "Systems"
        described as {
          |Total registered systems.
        }
      }
      qualityTestsRun: Natural with {
        briefly "Tests"
        described as {
          |Quality tests performed.
        }
      }
      qualityTestsFailed: Natural with {
        briefly "Failed"
        described as {
          |Quality tests failed.
        }
      }
      activeLeakCount: Natural with {
        briefly "Leaks"
        described as {
          |Active leak count.
        }
      }
      leaksResolved: Natural with {
        briefly "Resolved"
        described as {
          |Leaks resolved.
        }
      }
      alertsRaised: Natural with {
        briefly "Alerts"
        described as {
          |Alerts raised.
        }
      }
      complianceReportsSubmitted: Natural with {
        briefly "Reports"
        described as {
          |Compliance reports submitted.
        }
      }
    } with {
      briefly "System metrics"
      described as {
        |Water utility operational metrics.
      }
    }
    handler MetricsHandler is {
      on event WaterSystem.SystemRegistered is {
        tell event WaterSystem.SystemRegistered to repository WaterUtilityContext.WaterUtilityRepository
        prompt "Increment total systems"
      }
      on event WaterSystem.QualityTestRecorded is {
        tell event WaterSystem.QualityTestRecorded to repository WaterUtilityContext.WaterUtilityRepository
        prompt "Increment quality tests and check failures"
      }
      on event WaterSystem.LeakReported is {
        tell event WaterSystem.LeakReported to repository WaterUtilityContext.WaterUtilityRepository
        prompt "Increment active leaks"
      }
      on event WaterSystem.LeakResolved is {
        tell event WaterSystem.LeakResolved to repository WaterUtilityContext.WaterUtilityRepository
        prompt "Decrement active leaks increment resolved"
      }
      on event WaterSystem.AlertRaised is {
        tell event WaterSystem.AlertRaised to repository WaterUtilityContext.WaterUtilityRepository
        prompt "Increment alerts raised"
      }
      on event WaterSystem.ComplianceReportSubmitted is {
        tell event WaterSystem.ComplianceReportSubmitted to repository WaterUtilityContext.WaterUtilityRepository
        prompt "Increment compliance reports submitted"
      }
    } with {
      briefly "Maintains water utility metrics"
      described as {
        |Projects events into operational metrics.
      }
    }
  } with {
    briefly "Water utility metrics"
    described as {
      |Water utility operational analytics.
    }
  }
  // ---- Event publication for WaterSystem ----
  type WaterSystemEvent is one of {
    WaterUtilityContext.WaterSystem.SystemRegistered,
    WaterUtilityContext.WaterSystem.TreatmentStatusUpdated,
    WaterUtilityContext.WaterSystem.QualityTestRecorded,
    WaterUtilityContext.WaterSystem.PressureUpdated,
    WaterUtilityContext.WaterSystem.LeakReported,
    WaterUtilityContext.WaterSystem.LeakResolved,
    WaterUtilityContext.WaterSystem.AlertRaised,
    WaterUtilityContext.WaterSystem.ComplianceReportSubmitted,
    WaterUtilityContext.WaterSystem.SystemShutdown,
    WaterUtilityContext.WaterSystem.SystemRestored
  } with {
    briefly "WaterSystem event alternation"
    described as {
      |Union of all WaterSystem events, for streaming and event-sourced
      |persistence.
    }
  }
  processor WaterSystemEventSource as source is {
    outlet WaterSystemEvents is type WaterSystemEvent
    handler WaterSystemSourceHandler is {
      on event WaterSystem.SystemRegistered is {
        send event WaterSystem.SystemRegistered to outlet WaterSystemEvents
      }
      on event WaterSystem.TreatmentStatusUpdated is {
        send event WaterSystem.TreatmentStatusUpdated to outlet WaterSystemEvents
      }
      on event WaterSystem.QualityTestRecorded is {
        send event WaterSystem.QualityTestRecorded to outlet WaterSystemEvents
      }
      on event WaterSystem.PressureUpdated is {
        send event WaterSystem.PressureUpdated to outlet WaterSystemEvents
      }
      on event WaterSystem.LeakReported is {
        send event WaterSystem.LeakReported to outlet WaterSystemEvents
      }
      on event WaterSystem.LeakResolved is {
        send event WaterSystem.LeakResolved to outlet WaterSystemEvents
      }
      on event WaterSystem.AlertRaised is {
        send event WaterSystem.AlertRaised to outlet WaterSystemEvents
      }
      on event WaterSystem.ComplianceReportSubmitted is {
        send event WaterSystem.ComplianceReportSubmitted to outlet WaterSystemEvents
      }
      on event WaterSystem.SystemShutdown is {
        send event WaterSystem.SystemShutdown to outlet WaterSystemEvents
      }
      on event WaterSystem.SystemRestored is {
        send event WaterSystem.SystemRestored to outlet WaterSystemEvents
      }
      on other is {
        error "Unexpected message for source WaterSystemEventSource"
      }
    } with {
      briefly "WaterSystem source handler"
      described as {
        |Publishes WaterSystem events onto the outlet.
      }
    }
  } with {
    briefly "WaterSystem event source"
    described as {
      |Publishes WaterSystem entity events into the streaming topology.
    }
  }
  processor WaterSystemEventSink as sink is {
    inlet WaterSystemInlet is type WaterSystemEvent
    handler WaterSystemSinkHandler is {
      on event WaterSystem.SystemRegistered is {
        tell event WaterSystem.SystemRegistered to repository WaterUtilityContext.WaterUtilityRepository
      }
      on event WaterSystem.TreatmentStatusUpdated is {
        tell event WaterSystem.TreatmentStatusUpdated to repository WaterUtilityContext.WaterUtilityRepository
      }
      on event WaterSystem.QualityTestRecorded is {
        tell event WaterSystem.QualityTestRecorded to repository WaterUtilityContext.WaterUtilityRepository
      }
      on event WaterSystem.PressureUpdated is {
        tell event WaterSystem.PressureUpdated to repository WaterUtilityContext.WaterUtilityRepository
      }
      on event WaterSystem.LeakReported is {
        tell event WaterSystem.LeakReported to repository WaterUtilityContext.WaterUtilityRepository
      }
      on event WaterSystem.LeakResolved is {
        tell event WaterSystem.LeakResolved to repository WaterUtilityContext.WaterUtilityRepository
      }
      on event WaterSystem.AlertRaised is {
        tell event WaterSystem.AlertRaised to repository WaterUtilityContext.WaterUtilityRepository
      }
      on event WaterSystem.ComplianceReportSubmitted is {
        tell event WaterSystem.ComplianceReportSubmitted to repository WaterUtilityContext.WaterUtilityRepository
      }
      on event WaterSystem.SystemShutdown is {
        tell event WaterSystem.SystemShutdown to repository WaterUtilityContext.WaterUtilityRepository
      }
      on event WaterSystem.SystemRestored is {
        tell event WaterSystem.SystemRestored to repository WaterUtilityContext.WaterUtilityRepository
      }
      on other is {
        error "Unexpected message for sink WaterSystemEventSink"
      }
    } with {
      briefly "WaterSystem sink handler"
      described as {
        |Persists WaterSystem events via the repository.
      }
    }
  } with {
    briefly "WaterSystem event sink"
    described as {
      |Receives WaterSystem events for persistence.
    }
  }
  connector WaterSystemEventFlow is {
    from outlet WaterUtilityContext.WaterSystemEventSource.WaterSystemEvents to
      inlet WaterUtilityContext.WaterSystemEventSink.WaterSystemInlet
  } with {
    briefly "WaterSystem event flow"
    described as {
      |Connects the WaterSystem source to its sink.
    }
  }
  processor WaterSystemEventSplit is {
    inlet WaterSystemEventSplitIn is type WaterSystemEvent
    outlet WaterSystemEventSplitToWaterUtilityRepository is type WaterSystemEvent
    outlet WaterSystemEventSplitToWaterUtilityMetrics is type WaterSystemEvent
    handler WaterSystemEventSplitHandler is {
      on event WaterSystem.SystemRegistered is {
        send event WaterSystem.SystemRegistered to outlet WaterSystemEventSplitToWaterUtilityRepository
        send event WaterSystem.SystemRegistered to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell event WaterSystem.SystemRegistered to entity WaterUtilityContext.WaterSystem
      }
      on event WaterSystem.TreatmentStatusUpdated is {
        send event WaterSystem.TreatmentStatusUpdated to outlet WaterSystemEventSplitToWaterUtilityRepository
        send event WaterSystem.TreatmentStatusUpdated to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell event WaterSystem.TreatmentStatusUpdated to entity WaterUtilityContext.WaterSystem
      }
      on event WaterSystem.QualityTestRecorded is {
        send event WaterSystem.QualityTestRecorded to outlet WaterSystemEventSplitToWaterUtilityRepository
        send event WaterSystem.QualityTestRecorded to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell event WaterSystem.QualityTestRecorded to entity WaterUtilityContext.WaterSystem
      }
      on event WaterSystem.PressureUpdated is {
        send event WaterSystem.PressureUpdated to outlet WaterSystemEventSplitToWaterUtilityRepository
        send event WaterSystem.PressureUpdated to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell event WaterSystem.PressureUpdated to entity WaterUtilityContext.WaterSystem
      }
      on event WaterSystem.LeakReported is {
        send event WaterSystem.LeakReported to outlet WaterSystemEventSplitToWaterUtilityRepository
        send event WaterSystem.LeakReported to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell event WaterSystem.LeakReported to entity WaterUtilityContext.WaterSystem
      }
      on event WaterSystem.LeakResolved is {
        send event WaterSystem.LeakResolved to outlet WaterSystemEventSplitToWaterUtilityRepository
        send event WaterSystem.LeakResolved to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell event WaterSystem.LeakResolved to entity WaterUtilityContext.WaterSystem
      }
      on event WaterSystem.AlertRaised is {
        send event WaterSystem.AlertRaised to outlet WaterSystemEventSplitToWaterUtilityRepository
        send event WaterSystem.AlertRaised to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell event WaterSystem.AlertRaised to entity WaterUtilityContext.WaterSystem
      }
      on event WaterSystem.ComplianceReportSubmitted is {
        send event WaterSystem.ComplianceReportSubmitted to outlet WaterSystemEventSplitToWaterUtilityRepository
        send event WaterSystem.ComplianceReportSubmitted to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell event WaterSystem.ComplianceReportSubmitted to entity WaterUtilityContext.WaterSystem
      }
      on event WaterSystem.SystemShutdown is {
        send event WaterSystem.SystemShutdown to outlet WaterSystemEventSplitToWaterUtilityRepository
        send event WaterSystem.SystemShutdown to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell event WaterSystem.SystemShutdown to entity WaterUtilityContext.WaterSystem
      }
      on event WaterSystem.SystemRestored is {
        send event WaterSystem.SystemRestored to outlet WaterSystemEventSplitToWaterUtilityRepository
        send event WaterSystem.SystemRestored to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell event WaterSystem.SystemRestored to entity WaterUtilityContext.WaterSystem
      }
      on other is {
        error "Unexpected message for processor WaterSystemEventSplit"
      }
    } with {
      briefly "WaterSystem event fan-out handler"
      described as {
        |Delivers each WaterSystem event to all of its consumers.
      }
    }
  } with {
    briefly "WaterSystem event fan-out"
    described as {
      |Fans WaterSystem events out to the repository and projectors.
    }
  }
  connector LinkWaterSystemToWaterSystemEventSplit is {
    from outlet WaterUtilityContext.WaterSystem.WaterSystemEvents2 to
      inlet WaterUtilityContext.WaterSystemEventSplit.WaterSystemEventSplitIn
  } with {
    briefly "LinkWaterSystemToWaterSystemEventSplit"
  }
  connector LinkWaterSystemEventSplitToWaterUtilityRepository is {
    from outlet WaterUtilityContext.WaterSystemEventSplit.WaterSystemEventSplitToWaterUtilityRepository to
      inlet WaterUtilityContext.WaterUtilityRepository.WaterUtilityRepositoryFromWaterSystem
  } with {
    briefly "LinkWaterSystemEventSplitToWaterUtilityRepository"
  }
  connector LinkWaterSystemEventSplitToWaterUtilityMetrics is {
    from outlet WaterUtilityContext.WaterSystemEventSplit.WaterSystemEventSplitToWaterUtilityMetrics to
      inlet WaterUtilityContext.WaterUtilityMetrics.WaterUtilityMetricsFromWaterSystem
  } with {
    briefly "LinkWaterSystemEventSplitToWaterUtilityMetrics"
  }
  connector LinkWaterUtilityMetricsToWaterUtilityRepository is {
    from outlet WaterUtilityContext.WaterUtilityMetrics.WaterUtilityMetricsOut to
      inlet WaterUtilityContext.WaterUtilityRepository.WaterUtilityRepositoryFromWaterUtilityMetrics
  } with {
    briefly "LinkWaterUtilityMetricsToWaterUtilityRepository"
  }
} with {
  briefly "Bounded context for water utility management"
  described as {
    |Water utility treatment, distribution, and compliance context.
  }
}
