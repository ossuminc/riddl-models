// Water Utility - Water Utility Context
context WaterUtilityContext as router is {
  inlet WaterSystemCommandStreamIn is type WaterSystemCommand  outlet WaterSystemCommandStreamOut is type WaterSystemCommand
  inlet WaterSystemResultStreamIn is type WaterSystem.WaterSystemResult  outlet WaterSystemResultStreamOut is type WaterSystem.WaterSystemResult
  handler WaterUtilityContextBoundary is {
    on registerSystem: command WaterSystem.RegisterSystem is {
      send registerSystem to outlet WaterUtilityContext.WaterSystemCommandStreamOut
    }
    on updateTreatmentStatus: command WaterSystem.UpdateTreatmentStatus is {
      send updateTreatmentStatus to outlet WaterUtilityContext.WaterSystemCommandStreamOut
    }
    on recordQualityTest: command WaterSystem.RecordQualityTest is {
      send recordQualityTest to outlet WaterUtilityContext.WaterSystemCommandStreamOut
    }
    on updatePressure: command WaterSystem.UpdatePressure is {
      send updatePressure to outlet WaterUtilityContext.WaterSystemCommandStreamOut
    }
    on reportLeak: command WaterSystem.ReportLeak is {
      send reportLeak to outlet WaterUtilityContext.WaterSystemCommandStreamOut
    }
    on resolveLeak: command WaterSystem.ResolveLeak is {
      send resolveLeak to outlet WaterUtilityContext.WaterSystemCommandStreamOut
    }
    on raiseAlert: command WaterSystem.RaiseAlert is {
      send raiseAlert to outlet WaterUtilityContext.WaterSystemCommandStreamOut
    }
    on submitComplianceReport: command WaterSystem.SubmitComplianceReport is {
      send submitComplianceReport to outlet WaterUtilityContext.WaterSystemCommandStreamOut
    }
    on shutdownSystem: command WaterSystem.ShutdownSystem is {
      send shutdownSystem to outlet WaterUtilityContext.WaterSystemCommandStreamOut
    }
    on restoreSystem: command WaterSystem.RestoreSystem is {
      send restoreSystem to outlet WaterUtilityContext.WaterSystemCommandStreamOut
    }
    on waterSystemResult: result WaterSystem.WaterSystemResult is {
      send waterSystemResult to outlet WaterUtilityContext.WaterSystemResultStreamOut
    }
    on other is {
      error "Unexpected message at the WaterUtilityContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'WaterSystemCommand Stream Intake' is from outlet WaterUtilityContext.WaterSystemCommandStreamOut to inlet WaterUtilityContext.WaterSystem.WaterSystemCommands  connector 'WaterSystemResult Stream Egress' is from outlet WaterUtilityContext.WaterUtilityRepository.WaterUtilityRepositoryResponses to inlet WaterUtilityContext.WaterSystemResultStreamIn  adaptor FromRegulatoryReporting from context RegulatoryReporting is { 
    handler FromRegulatoryReportingHandler is {
      on result RegulatoryReporting.ComplianceRequirements is {
        do "the model receives compliance requirements"
      }
      on event RegulatoryReporting.ReportSubmitted is {
        do "the model receives report submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryReporting"
      }
    } with {
      briefly "from regulatory reporting"
      described as {
        |Carries messages from the external RegulatoryReporting.
      }
    }
  } with {
    briefly "RegulatoryReporting integration"
    described as {
      |The model's side of the RegulatoryReporting conversation.
    }
  }
  adaptor ToRegulatoryReporting to context RegulatoryReporting is { 
    handler ToRegulatoryReportingHandler is {
      on query RegulatoryReporting.GetComplianceRequirements is {
        do "the model sends get compliance requirements"
      }
      on command RegulatoryReporting.SubmitReport is {
        do "the model sends submit report"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryReporting"
      }
    } with {
      briefly "to regulatory reporting"
      described as {
        |Carries messages to the external RegulatoryReporting.
      }
    }
  } with {
    briefly "RegulatoryReporting integration"
    described as {
      |The model's side of the RegulatoryReporting conversation.
    }
  }
  adaptor FromSCADASystem from context SCADASystem is { 
    handler FromSCADASystemHandler is {
      on event SCADASystem.ControlSignalSent is {
        do "the model receives control signal sent"
      }
      on result SCADASystem.SensorReadings is {
        do "the model receives sensor readings"
      }
      on other is {
        error "Unexpected message for adaptor FromSCADASystem"
      }
    } with {
      briefly "from scada system"
      described as {
        |Carries messages from the external SCADASystem.
      }
    }
  } with {
    briefly "SCADASystem integration"
    described as {
      |The model's side of the SCADASystem conversation.
    }
  }
  adaptor ToSCADASystem to context SCADASystem is { 
    handler ToSCADASystemHandler is {
      on query SCADASystem.GetSensorReadings is {
        do "the model sends get sensor readings"
      }
      on command SCADASystem.SendControlSignal is {
        do "the model sends send control signal"
      }
      on other is {
        error "Unexpected message for adaptor ToSCADASystem"
      }
    } with {
      briefly "to scada system"
      described as {
        |Carries messages to the external SCADASystem.
      }
    }
  } with {
    briefly "SCADASystem integration"
    described as {
      |The model's side of the SCADASystem conversation.
    }
  }
  include "types.riddl"
  include "WaterSystem.riddl"
  type WaterUtilityRepositoryCommand is one of {
    WaterUtilityContext.WaterUtilityRepository.PersistAlertRaised or WaterUtilityContext.WaterUtilityRepository.PersistComplianceReportSubmitted or WaterUtilityContext.WaterUtilityRepository.PersistLeakReported or WaterUtilityContext.WaterUtilityRepository.PersistLeakResolved or WaterUtilityContext.WaterUtilityRepository.PersistPressureUpdated or WaterUtilityContext.WaterUtilityRepository.PersistQualityTestRecorded or WaterUtilityContext.WaterUtilityRepository.PersistSystemRegistered or WaterUtilityContext.WaterUtilityRepository.PersistSystemRestored or WaterUtilityContext.WaterUtilityRepository.PersistSystemShutdown or WaterUtilityContext.WaterUtilityRepository.PersistTreatmentStatusUpdated
  } with {
    briefly "Anything that writes WaterUtilityRepository"
    described as {
      |The persistence commands WaterUtilityRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository WaterUtilityRepository as flow is {
    inlet WaterUtilityRepositoryFromWaterUtilityMetrics is type WaterUtilityRepositoryCommand
    command PersistPressureUpdated is  {
      systemId: WaterSystemId with {
        briefly "Row addressed"
        described as {
          |Which stored row PressureUpdated applies to.
        }
      }
    } with {
      briefly "Persist PressureUpdated"
      described as {
        |Instructs this repository to apply PressureUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSystemRestored is  {
      systemId: WaterSystemId with {
        briefly "Row addressed"
        described as {
          |Which stored row SystemRestored applies to.
        }
      }
    } with {
      briefly "Persist SystemRestored"
      described as {
        |Instructs this repository to apply SystemRestored to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSystemShutdown is  {
      systemId: WaterSystemId with {
        briefly "Row addressed"
        described as {
          |Which stored row SystemShutdown applies to.
        }
      }
    } with {
      briefly "Persist SystemShutdown"
      described as {
        |Instructs this repository to apply SystemShutdown to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTreatmentStatusUpdated is  {
      systemId: WaterSystemId with {
        briefly "Row addressed"
        described as {
          |Which stored row TreatmentStatusUpdated applies to.
        }
      }
    } with {
      briefly "Persist TreatmentStatusUpdated"
      described as {
        |Instructs this repository to apply TreatmentStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAlertRaised is  {
      systemId: WaterSystemId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlertRaised applies to.
        }
      }
    } with {
      briefly "Persist AlertRaised"
      described as {
        |Instructs this repository to apply AlertRaised to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistComplianceReportSubmitted is  {
      systemId: WaterSystemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ComplianceReportSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ComplianceReportSubmitted"
      described as {
        |Instructs this repository to apply ComplianceReportSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLeakReported is  {
      systemId: WaterSystemId with {
        briefly "Row addressed"
        described as {
          |Which stored row LeakReported applies to.
        }
      }
    } with {
      briefly "Persist LeakReported"
      described as {
        |Instructs this repository to apply LeakReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLeakResolved is  {
      systemId: WaterSystemId with {
        briefly "Row addressed"
        described as {
          |Which stored row LeakResolved applies to.
        }
      }
    } with {
      briefly "Persist LeakResolved"
      described as {
        |Instructs this repository to apply LeakResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistQualityTestRecorded is  {
      systemId: WaterSystemId with {
        briefly "Row addressed"
        described as {
          |Which stored row QualityTestRecorded applies to.
        }
      }
    } with {
      briefly "Persist QualityTestRecorded"
      described as {
        |Instructs this repository to apply QualityTestRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSystemRegistered is  {
      systemId: WaterSystemId with {
        briefly "Row addressed"
        described as {
          |Which stored row SystemRegistered applies to.
        }
      }
    } with {
      briefly "Persist SystemRegistered"
      described as {
        |Instructs this repository to apply SystemRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet WaterUtilityRepositoryResponses is type WaterSystem.WaterSystemResult
    record StoredWaterSystem is  {
      waterSystemId: WaterSystemId with {
        briefly "waterSystemId"
        described as {
          |The waterSystemId column of the stored waterSystem row.
        }
      }
      status: SystemStatus with {
        briefly "status"
        described as {
          |The status column of the stored waterSystem row.
        }
      }
      systemId: WaterSystemId with {
        briefly "systemId"
        described as {
          |The systemId column of the stored waterSystem row.
        }
      }
      systemName: String(3,200) with {
        briefly "systemName"
        described as {
          |The systemName column of the stored waterSystem row.
        }
      }
    } with {
      briefly "Stored waterSystem row"
      described as {
        |The persistence shape of waterSystem data as this repository stores it.
      }
    }
    schema WaterUtilityData is relational
      of waterSystems as type StoredWaterSystem
        index on field StoredWaterSystem.systemId
        index on field StoredWaterSystem.status
        index on field StoredWaterSystem.systemName
 with {
      briefly "Water utility data schema"
      described as {
        |The relational schema holding water utility data for the WaterUtilityRepository.
      }
    }
    handler WaterUtilityPersistence is {
      on persistPressureUpdated: command PersistPressureUpdated is {
        do "apply PressureUpdated to the stored row"
      }
      on persistSystemRestored: command PersistSystemRestored is {
        do "apply SystemRestored to the stored row"
      }
      on persistSystemShutdown: command PersistSystemShutdown is {
        do "apply SystemShutdown to the stored row"
      }
      on persistTreatmentStatusUpdated: command PersistTreatmentStatusUpdated is {
        do "apply TreatmentStatusUpdated to the stored row"
      }
      on persistAlertRaised: command PersistAlertRaised is {
        do "apply AlertRaised to the stored row"
      }
      on persistComplianceReportSubmitted: command PersistComplianceReportSubmitted is {
        do "apply ComplianceReportSubmitted to the stored row"
      }
      on persistLeakReported: command PersistLeakReported is {
        do "apply LeakReported to the stored row"
      }
      on persistLeakResolved: command PersistLeakResolved is {
        do "apply LeakResolved to the stored row"
      }
      on persistQualityTestRecorded: command PersistQualityTestRecorded is {
        do "apply QualityTestRecorded to the stored row"
      }
      on persistSystemRegistered: command PersistSystemRegistered is {
        do "apply SystemRegistered to the stored row"
      }
      on query GetSystemMetrics is {
        let systemMetricsView: type SystemMetricsView = prompt("read the system metrics projection")
        reply systemMetricsView
      }
    } with {
      briefly "Persists water utility events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Water utility data persistence"
    described as {
      |Persistent storage for water utility data.
    }
  }
  query GetSystemMetrics replies result SystemMetricsView is  {
    systemMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which system metrics to retrieve.
      }
    }
  } with {
    briefly "Get system metrics"
    described as {
      |Retrieves the system metrics projection.
    }
  }
  result SystemMetricsView is  {
    systemMetrics: WaterUtilityMetrics.SystemMetrics with {
      briefly "System metrics"
      described as {
        |The system metrics being returned.
      }
    }
  } with {
    briefly "System metrics view"
    described as {
      |Read model view carrying the system metrics projection.
    }
  }
  projector WaterUtilityMetrics as flow is {
    outlet WaterUtilityMetricsToRepository is type WaterUtilityRepositoryCommand
    updates repository WaterUtilityContext.WaterUtilityRepository
    inlet WaterUtilityMetricsFromWaterSystem is type WaterSystemEvent
    record SystemMetrics is  {
      totalSystems: Natural with {
        briefly "Systems"
        described as {
          |Total registered systems.
        }
      }
      qualityTestsRun: Natural with {
        briefly "Tests"
        described as {
          |Quality tests performed.
        }
      }
      qualityTestsFailed: Natural with {
        briefly "Failed"
        described as {
          |Quality tests failed.
        }
      }
      activeLeakCount: Natural with {
        briefly "Leaks"
        described as {
          |Active leak count.
        }
      }
      leaksResolved: Natural with {
        briefly "Resolved"
        described as {
          |Leaks resolved.
        }
      }
      alertsRaised: Natural with {
        briefly "Alerts"
        described as {
          |Alerts raised.
        }
      }
      complianceReportsSubmitted: Natural with {
        briefly "Reports"
        described as {
          |Compliance reports submitted.
        }
      }
    } with {
      briefly "System metrics"
      described as {
        |Water utility operational metrics.
      }
    }
    handler MetricsHandler is {
      on pressureUpdated: event WaterSystem.PressureUpdated is {
        tell command WaterUtilityContext.WaterUtilityRepository.PersistPressureUpdated(systemId = pressureUpdated.systemId) to repository WaterUtilityContext.WaterUtilityRepository
        do "apply PressureUpdated to the WaterUtilityMetrics projection"
      }
      on systemRestored: event WaterSystem.SystemRestored is {
        tell command WaterUtilityContext.WaterUtilityRepository.PersistSystemRestored(systemId = systemRestored.systemId) to repository WaterUtilityContext.WaterUtilityRepository
        do "apply SystemRestored to the WaterUtilityMetrics projection"
      }
      on systemShutdown: event WaterSystem.SystemShutdown is {
        tell command WaterUtilityContext.WaterUtilityRepository.PersistSystemShutdown(systemId = systemShutdown.systemId) to repository WaterUtilityContext.WaterUtilityRepository
        do "apply SystemShutdown to the WaterUtilityMetrics projection"
      }
      on treatmentStatusUpdated: event WaterSystem.TreatmentStatusUpdated is {
        tell command WaterUtilityContext.WaterUtilityRepository.PersistTreatmentStatusUpdated(systemId = treatmentStatusUpdated.systemId) to repository WaterUtilityContext.WaterUtilityRepository
        do "apply TreatmentStatusUpdated to the WaterUtilityMetrics projection"
      }
      on systemRegistered: event WaterSystem.SystemRegistered is {
        tell command WaterUtilityContext.WaterUtilityRepository.PersistSystemRegistered(systemId = systemRegistered.systemId) to repository WaterUtilityContext.WaterUtilityRepository
        do "Increment total systems"
      }
      on qualityTestRecorded: event WaterSystem.QualityTestRecorded is {
        tell command WaterUtilityContext.WaterUtilityRepository.PersistQualityTestRecorded(systemId = qualityTestRecorded.systemId) to repository WaterUtilityContext.WaterUtilityRepository
        do "Increment quality tests and check failures"
      }
      on leakReported: event WaterSystem.LeakReported is {
        tell command WaterUtilityContext.WaterUtilityRepository.PersistLeakReported(systemId = leakReported.systemId) to repository WaterUtilityContext.WaterUtilityRepository
        do "Increment active leaks"
      }
      on leakResolved: event WaterSystem.LeakResolved is {
        tell command WaterUtilityContext.WaterUtilityRepository.PersistLeakResolved(systemId = leakResolved.systemId) to repository WaterUtilityContext.WaterUtilityRepository
        do "Decrement active leaks increment resolved"
      }
      on alertRaised: event WaterSystem.AlertRaised is {
        tell command WaterUtilityContext.WaterUtilityRepository.PersistAlertRaised(systemId = alertRaised.systemId) to repository WaterUtilityContext.WaterUtilityRepository
        do "Increment alerts raised"
      }
      on complianceReportSubmitted: event WaterSystem.ComplianceReportSubmitted is {
        tell command WaterUtilityContext.WaterUtilityRepository.PersistComplianceReportSubmitted(systemId = complianceReportSubmitted.systemId) to repository WaterUtilityContext.WaterUtilityRepository
        do "Increment compliance reports submitted"
      }
    } with {
      briefly "Maintains water utility metrics"
      described as {
        |Projects events into operational metrics.
      }
    }
  } with {
    briefly "Water utility metrics"
    described as {
      |Water utility operational analytics.
    }
  }
  // ---- Event publication for WaterSystem ----
  type WaterSystemEvent is one of {
    WaterUtilityContext.WaterSystem.SystemRegistered or WaterUtilityContext.WaterSystem.TreatmentStatusUpdated or WaterUtilityContext.WaterSystem.QualityTestRecorded or WaterUtilityContext.WaterSystem.PressureUpdated or WaterUtilityContext.WaterSystem.LeakReported or WaterUtilityContext.WaterSystem.LeakResolved or WaterUtilityContext.WaterSystem.AlertRaised or WaterUtilityContext.WaterSystem.ComplianceReportSubmitted or WaterUtilityContext.WaterSystem.SystemShutdown or WaterUtilityContext.WaterSystem.SystemRestored
  } with {
    briefly "WaterSystem event alternation"
    described as {
      |Union of all WaterSystem events, for streaming and event-sourced
      |persistence.
    }
  }
  processor WaterSystemEventSplit as flow is {
    inlet WaterSystemEventSplitIn is type WaterSystemEvent
    outlet WaterSystemEventSplitToWaterUtilityMetrics is type WaterSystemEvent
    handler WaterSystemEventSplitHandler is {
      on systemRegistered: event WaterSystem.SystemRegistered is {
        send systemRegistered to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell systemRegistered to entity WaterUtilityContext.WaterSystem
      }
      on treatmentStatusUpdated: event WaterSystem.TreatmentStatusUpdated is {
        send treatmentStatusUpdated to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell treatmentStatusUpdated to entity WaterUtilityContext.WaterSystem
      }
      on qualityTestRecorded: event WaterSystem.QualityTestRecorded is {
        send qualityTestRecorded to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell qualityTestRecorded to entity WaterUtilityContext.WaterSystem
      }
      on pressureUpdated: event WaterSystem.PressureUpdated is {
        send pressureUpdated to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell pressureUpdated to entity WaterUtilityContext.WaterSystem
      }
      on leakReported: event WaterSystem.LeakReported is {
        send leakReported to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell leakReported to entity WaterUtilityContext.WaterSystem
      }
      on leakResolved: event WaterSystem.LeakResolved is {
        send leakResolved to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell leakResolved to entity WaterUtilityContext.WaterSystem
      }
      on alertRaised: event WaterSystem.AlertRaised is {
        send alertRaised to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell alertRaised to entity WaterUtilityContext.WaterSystem
      }
      on complianceReportSubmitted: event WaterSystem.ComplianceReportSubmitted is {
        send complianceReportSubmitted to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell complianceReportSubmitted to entity WaterUtilityContext.WaterSystem
      }
      on systemShutdown: event WaterSystem.SystemShutdown is {
        send systemShutdown to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell systemShutdown to entity WaterUtilityContext.WaterSystem
      }
      on systemRestored: event WaterSystem.SystemRestored is {
        send systemRestored to outlet WaterSystemEventSplitToWaterUtilityMetrics
        tell systemRestored to entity WaterUtilityContext.WaterSystem
      }
      on other is {
        error "Unexpected message for processor WaterSystemEventSplit"
      }
    } with {
      briefly "WaterSystem event fan-out handler"
      described as {
        |Delivers each WaterSystem event to all of its consumers.
      }
    }
  } with {
    briefly "WaterSystem event fan-out"
    described as {
      |Fans WaterSystem events out to the repository and projectors.
    }
  }
  connector 'WaterSystemEvent Stream' is from outlet WaterUtilityContext.WaterSystem.WaterSystemEvents2 to inlet WaterUtilityContext.WaterSystemEventSplit.WaterSystemEventSplitIn with {
    briefly "WaterSystem events, fanned out to storage and read models"
  }
  connector 'WaterUtilityMetrics Feed' is from outlet WaterUtilityContext.WaterSystemEventSplit.WaterSystemEventSplitToWaterUtilityMetrics to inlet WaterUtilityContext.WaterUtilityMetrics.WaterUtilityMetricsFromWaterSystem with {
    briefly "WaterSystem events feeding the WaterUtilityMetrics projection"
  }
  connector 'WaterUtilityMetrics Storage' is from outlet WaterUtilityContext.WaterUtilityMetrics.WaterUtilityMetricsToRepository to inlet WaterUtilityContext.WaterUtilityRepository.WaterUtilityRepositoryFromWaterUtilityMetrics with {
    briefly "WaterUtilityMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for water utility management"
  described as {
    |Water utility treatment, distribution, and compliance context.
  }
}
