// Water Utility Domain Model
// Water treatment, distribution, quality, and compliance management
domain WaterUtility is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user PlantOperator is "person managing water treatment operations" with {
    briefly "Plant Operator"
    described as {
      |Operator managing treatment plant processes.
    }
  }
  user DistributionEngineer is "person monitoring the distribution network" with {
    briefly "Distribution Engineer"
    described as {
      |Engineer overseeing water distribution infrastructure.
    }
  }
  user QualityAnalyst is "person performing water quality testing" with {
    briefly "Quality Analyst"
    described as {
      |Analyst conducting water quality assessments.
    }
  }
  user ComplianceOfficer is "person managing regulatory reporting" with {
    briefly "Compliance Officer"
    described as {
      |Officer ensuring regulatory compliance.
    }
  }
  epic WaterSystemManagement is {
    user PlantOperator wants to "to monitor and manage water system operations" so that "safe clean water is delivered to customers"
    case MonitorWaterSystem is {
      user PlantOperator wants to "to monitor the water system" so that "treatment and distribution operate correctly"
      step is "Operator reviews" "system telemetry" "from SCADA" with {
        briefly "Review telemetry"
        described as {
          |Check system readings.
        }
      }
      step is "System detects" "anomalies" "in water parameters" with {
        briefly "Detect anomalies"
        described as {
          |Identify issues.
        }
      }
    } with {
      briefly "Monitor water system"
      described as {
        |Monitoring water treatment and distribution.
      }
    }
  } with {
    briefly "Water system management"
    described as {
      |Epic for water utility operations management.
    }
  }
  include "WaterUtilityContext.riddl"
  include "external-contexts.riddl"
  application context WaterUtilityApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in WaterUtility are delivered.
      }
    }
    outlet AppWaterSystemCommands is type WaterUtilityContext.WaterSystem.WaterSystemCommand
    inlet AppWaterUtilityRepositoryResponses is type WaterUtilityContext.WaterSystem.WaterSystemResult    handler WaterUtilityAppHandler is {
      on other is {
        error "Unexpected message for application context WaterUtilityApp"
      }
    } with {
      briefly "WaterUtilityApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "WaterUtilityApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'WaterSystemCommand Stream' is from outlet WaterUtilityApp.AppWaterSystemCommands to inlet WaterUtilityContext.WaterSystem.WaterSystemCommands with {
    option persistent()
    briefly "WaterSystem commands from the application"
  }
  connector 'WaterSystemResult Stream' is from outlet WaterUtilityContext.WaterUtilityRepository.WaterUtilityRepositoryResponses to inlet WaterUtilityApp.AppWaterUtilityRepositoryResponses with {
    option persistent()
    briefly "WaterUtility query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet WaterUtilityApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Water utility management domain"
  described as {
    |Water treatment, distribution, quality, and compliance.
  }
}
