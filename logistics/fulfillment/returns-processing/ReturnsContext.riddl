// Returns Processing - Returns Context
context ReturnsContext as router is {
  inlet ReturnCommandStreamIn is type ReturnCommand  outlet ReturnCommandStreamOut is type ReturnCommand
  inlet ReturnResultStreamIn is type Return.ReturnResult  outlet ReturnResultStreamOut is type Return.ReturnResult
  handler ReturnsContextBoundary is {
    on requestReturn: command Return.RequestReturn is {
      send requestReturn to outlet ReturnsContext.ReturnCommandStreamOut
    }
    on authorizeReturn: command Return.AuthorizeReturn is {
      send authorizeReturn to outlet ReturnsContext.ReturnCommandStreamOut
    }
    on generateLabel: command Return.GenerateLabel is {
      send generateLabel to outlet ReturnsContext.ReturnCommandStreamOut
    }
    on recordShipment: command Return.RecordShipment is {
      send recordShipment to outlet ReturnsContext.ReturnCommandStreamOut
    }
    on receiveReturn: command Return.ReceiveReturn is {
      send receiveReturn to outlet ReturnsContext.ReturnCommandStreamOut
    }
    on inspectItem: command Return.InspectItem is {
      send inspectItem to outlet ReturnsContext.ReturnCommandStreamOut
    }
    on approveReturn: command Return.ApproveReturn is {
      send approveReturn to outlet ReturnsContext.ReturnCommandStreamOut
    }
    on rejectReturn: command Return.RejectReturn is {
      send rejectReturn to outlet ReturnsContext.ReturnCommandStreamOut
    }
    on processRefund: command Return.ProcessRefund is {
      send processRefund to outlet ReturnsContext.ReturnCommandStreamOut
    }
    on disposeItem: command Return.DisposeItem is {
      send disposeItem to outlet ReturnsContext.ReturnCommandStreamOut
    }
    on initializeReturn: command Return.InitializeReturn is {
      send initializeReturn to outlet ReturnsContext.ReturnCommandStreamOut
    }
    on returnResult: result Return.ReturnResult is {
      send returnResult to outlet ReturnsContext.ReturnResultStreamOut
    }
    on other is {
      error "Unexpected message at the ReturnsContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ReturnCommand Stream Intake' is from outlet ReturnsContext.ReturnCommandStreamOut to inlet ReturnsContext.Return.ReturnCommands  connector 'ReturnResult Stream Egress' is from outlet ReturnsContext.ReturnsRepository.ReturnsRepositoryResponses to inlet ReturnsContext.ReturnResultStreamIn  adaptor ToCustomerNotification to context CustomerNotification is { 
    handler ToCustomerNotificationHandler is {
      on command CustomerNotification.SendRefundNotification is {
        do "the model sends send refund notification"
      }
      on command CustomerNotification.SendReturnConfirmation is {
        do "the model sends send return confirmation"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerNotification"
      }
    } with {
      briefly "to customer notification"
      described as {
        |Carries messages to the external CustomerNotification.
      }
    }
  } with {
    briefly "CustomerNotification integration"
    described as {
      |The model's side of the CustomerNotification conversation.
    }
  }
  adaptor FromInventoryManagement from context InventoryManagement is { 
    handler FromInventoryManagementHandler is {
      on event InventoryManagement.InventoryRestocked is {
        do "the model receives inventory restocked"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryManagement"
      }
    } with {
      briefly "from inventory management"
      described as {
        |Carries messages from the external InventoryManagement.
      }
    }
  } with {
    briefly "InventoryManagement integration"
    described as {
      |The model's side of the InventoryManagement conversation.
    }
  }
  adaptor ToInventoryManagement to context InventoryManagement is { 
    handler ToInventoryManagementHandler is {
      on command InventoryManagement.MarkAsDefective is {
        do "the model sends mark as defective"
      }
      on command InventoryManagement.RestockInventory is {
        do "the model sends restock inventory"
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryManagement"
      }
    } with {
      briefly "to inventory management"
      described as {
        |Carries messages to the external InventoryManagement.
      }
    }
  } with {
    briefly "InventoryManagement integration"
    described as {
      |The model's side of the InventoryManagement conversation.
    }
  }
  adaptor FromPaymentGateway from context PaymentGateway is { 
    handler FromPaymentGatewayHandler is {
      on event PaymentGateway.RefundCompleted is {
        do "the model receives refund completed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentGateway"
      }
    } with {
      briefly "from payment gateway"
      described as {
        |Carries messages from the external PaymentGateway.
      }
    }
  } with {
    briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor ToPaymentGateway to context PaymentGateway is { 
    handler ToPaymentGatewayHandler is {
      on command PaymentGateway.IssueStoreCredit is {
        do "the model sends issue store credit"
      }
      on command PaymentGateway.ProcessRefund is {
        do "the model sends process refund"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentGateway"
      }
    } with {
      briefly "to payment gateway"
      described as {
        |Carries messages to the external PaymentGateway.
      }
    }
  } with {
    briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor FromShippingCarrier from context ShippingCarrier is { 
    handler FromShippingCarrierHandler is {
      on result ShippingCarrier.ReturnLabelResult is {
        do "the model receives return label result"
      }
      on result ShippingCarrier.TrackingStatus is {
        do "the model receives tracking status"
      }
      on other is {
        error "Unexpected message for adaptor FromShippingCarrier"
      }
    } with {
      briefly "from shipping carrier"
      described as {
        |Carries messages from the external ShippingCarrier.
      }
    }
  } with {
    briefly "ShippingCarrier integration"
    described as {
      |The model's side of the ShippingCarrier conversation.
    }
  }
  adaptor ToShippingCarrier to context ShippingCarrier is { 
    handler ToShippingCarrierHandler is {
      on command ShippingCarrier.CreateReturnLabel is {
        do "the model sends create return label"
      }
      on query ShippingCarrier.GetTrackingStatus is {
        do "the model sends get tracking status"
      }
      on other is {
        error "Unexpected message for adaptor ToShippingCarrier"
      }
    } with {
      briefly "to shipping carrier"
      described as {
        |Carries messages to the external ShippingCarrier.
      }
    }
  } with {
    briefly "ShippingCarrier integration"
    described as {
      |The model's side of the ShippingCarrier conversation.
    }
  }
  include "types.riddl"
  include "Return.riddl"
  repository ReturnsRepository as merge is {
    command PersistRefundProcessed is  {
      returnId: ReturnId with {
        briefly "Row addressed"
        described as {
          |Which stored row RefundProcessed applies to.
        }
      }
    } with {
      briefly "Persist RefundProcessed"
      described as {
        |Instructs this repository to apply RefundProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnRejected is  {
      returnId: ReturnId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnRejected applies to.
        }
      }
    } with {
      briefly "Persist ReturnRejected"
      described as {
        |Instructs this repository to apply ReturnRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnRequested is  {
      returnId: ReturnId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnRequested applies to.
        }
      }
    } with {
      briefly "Persist ReturnRequested"
      described as {
        |Instructs this repository to apply ReturnRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet ReturnsRepositoryFromReturn is type ReturnEvent    inlet ReturnsRepositoryFromReturnsAnalytics is type ReturnEvent    outlet ReturnsRepositoryResponses is type Return.ReturnResult
    record StoredReturn is  {
      returnId: ReturnId with {
        briefly "returnId"
        described as {
          |The returnId column of the stored return row.
        }
      }
      orderId: OrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored return row.
        }
      }
      rmaNumber: RMANumber with {
        briefly "rmaNumber"
        described as {
          |The rmaNumber column of the stored return row.
        }
      }
      status: ReturnStatus with {
        briefly "status"
        described as {
          |The status column of the stored return row.
        }
      }
    } with {
      briefly "Stored return row"
      described as {
        |The persistence shape of return data as this repository stores it.
      }
    }
    schema ReturnsData is relational
      of returns as type StoredReturn
        index on field StoredReturn.returnId
        index on field StoredReturn.orderId
        index on field StoredReturn.status
        index on field StoredReturn.rmaNumber
 with {
      briefly "Returns data schema"
      described as {
        |The relational schema holding returns data for the ReturnsRepository.
      }
    }
    handler ReturnsPersistence is {
      on persistRefundProcessed: command PersistRefundProcessed is {
        do "apply RefundProcessed to the stored row"
      }
      on persistReturnRejected: command PersistReturnRejected is {
        do "apply ReturnRejected to the stored row"
      }
      on persistReturnRequested: command PersistReturnRequested is {
        do "apply ReturnRequested to the stored row"
      }
      on query GetReturnsMetrics is {
        let returnsMetricsView: type ReturnsMetricsView = prompt("read the returns metrics projection")
        reply returnsMetricsView
      }
      on requestReturn: command Return.RequestReturn is {
        tell event Return.ReturnRequested(returnId = requestReturn.returnId, orderId = requestReturn.orderId) to entity ReturnsContext.Return
      }
      on authorizeReturn: command Return.AuthorizeReturn is {
        tell event Return.ReturnAuthorized(returnId = authorizeReturn.returnId, rmaNumber = authorizeReturn.rmaNumber) to entity ReturnsContext.Return
      }
      on receiveReturn: command Return.ReceiveReturn is {
        tell event Return.ReturnReceived(returnId = receiveReturn.returnId, receivedAt = receiveReturn.receivedAt) to entity ReturnsContext.Return
      }
      on inspectItem: command Return.InspectItem is {
        tell event Return.ItemInspected(returnId = inspectItem.returnId, sku = inspectItem.sku, inspection = inspectItem.inspection) to entity ReturnsContext.Return
      }
      on command Return.ProcessRefund is {
        let refundProcessed: type Return.RefundProcessed = prompt("the refund processed that results from process refund")
        tell refundProcessed to entity ReturnsContext.Return
      }
    } with {
      briefly "Persists return commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Returns data persistence"
    described as {
      |Persistent storage for returns.
    }
  }
  query GetReturnsMetrics is  {
    returnsMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which returns metrics to retrieve.
      }
    }
  } with {
    briefly "Get returns metrics"
    described as {
      |Retrieves the returns metrics projection.
    }
  }
  result ReturnsMetricsView is  {
    returnsMetrics: ReturnsAnalytics.ReturnsMetrics with {
      briefly "Returns metrics"
      described as {
        |The returns metrics being returned.
      }
    }
  } with {
    briefly "Returns metrics view"
    described as {
      |Read model view carrying the returns metrics projection.
    }
  }
  projector ReturnsAnalytics as flow is {
    updates repository ReturnsContext.ReturnsRepository
    inlet ReturnsAnalyticsFromReturn is type ReturnEvent    outlet ReturnsAnalyticsOut is type ReturnEvent
    record ReturnsMetrics is  {
      period: String(1,20) with {
        briefly "Period"
        described as {
          |Time period.
        }
      }
      totalReturns: Natural with {
        briefly "Total"
        described as {
          |Total returns.
        }
      }
      totalRefunded: Decimal(15,2) with {
        briefly "Refunded"
        described as {
          |Total refunded.
        }
      }
      approvalRate: Decimal(5,2) with {
        briefly "Approval"
        described as {
          |Approval rate pct.
        }
      }
      avgProcessingDays: Decimal(5,2) with {
        briefly "Avg days"
        described as {
          |Avg processing days.
        }
      }
      topReason: ReturnReason with {
        briefly "Top reason"
        described as {
          |Most common reason.
        }
      }
    } with {
      briefly "Returns metrics"
      described as {
        |Return processing metrics.
      }
    }
    handler AnalyticsHandler is {
      on returnRequested: event Return.ReturnRequested is {
        tell command ReturnsContext.ReturnsRepository.PersistReturnRequested(returnId = returnRequested.returnId) to repository ReturnsContext.ReturnsRepository
      }
      on refundProcessed: event Return.RefundProcessed is {
        tell command ReturnsContext.ReturnsRepository.PersistRefundProcessed(returnId = refundProcessed.returnId) to repository ReturnsContext.ReturnsRepository
      }
      on returnRejected: event Return.ReturnRejected is {
        tell command ReturnsContext.ReturnsRepository.PersistReturnRejected(returnId = returnRejected.returnId) to repository ReturnsContext.ReturnsRepository
      }
    } with {
      briefly "Maintains returns analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Returns analytics"
    described as {
      |Returns processing analysis.
    }
  }
  type ReturnEvent is one of {
    ReturnsContext.Return.ReturnRequested or ReturnsContext.Return.RefundProcessed or ReturnsContext.Return.ReturnRejected or ReturnsContext.Return.ItemDisposed or ReturnsContext.Return.ItemInspected or ReturnsContext.Return.LabelGenerated or ReturnsContext.Return.ReturnApproved or ReturnsContext.Return.ReturnAuthorized or ReturnsContext.Return.ReturnReceived or ReturnsContext.Return.ShipmentRecorded
  } with {
    briefly "Return event union"
    described as {
      |Union of Return events for streaming.
    }
  }
  processor ReturnEventSource as source is {
    outlet ReturnEvents is type ReturnEvent
    handler ReturnEventEmitter is {
      on init is {
        let initializeReturn: type Return.InitializeReturn = prompt("the initialize return that brings this this into existence")
        tell initializeReturn to entity ReturnsContext.Return
      }
      on other is {
        error "Unexpected message for source ReturnEventSource"
      }
      on returnRequested: event Return.ReturnRequested is {
        send returnRequested to outlet ReturnEvents
      }
      on refundProcessed: event Return.RefundProcessed is {
        send refundProcessed to outlet ReturnEvents
      }
      on returnRejected: event Return.ReturnRejected is {
        send returnRejected to outlet ReturnEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits Return events to the stream.
      }
    }
  } with {
    briefly "Return event source"
    described as {
      |Publishes Return events to the event stream.
    }
  }
  processor ReturnEventSink as sink is {
    inlet IncomingReturnEvents is type ReturnEvent    handler ReturnEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink ReturnEventSink"
      }
      on returnRequested: event Return.ReturnRequested is {
        tell returnRequested to repository ReturnsContext.ReturnsRepository
      }
      on refundProcessed: event Return.RefundProcessed is {
        tell refundProcessed to repository ReturnsContext.ReturnsRepository
      }
      on returnRejected: event Return.ReturnRejected is {
        tell returnRejected to repository ReturnsContext.ReturnsRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives Return events for persistence.
      }
    }
  } with {
    briefly "Return event sink"
    described as {
      |Receives Return events from streaming.
    }
  }
  connector ReturnEventPipeline is from outlet ReturnsContext.ReturnEventSource.ReturnEvents to inlet ReturnsContext.ReturnEventSink.IncomingReturnEvents with {
    briefly "Return event pipeline"
    described as {
      |Wires Return event source to sink.
    }
  }
  processor ReturnEventSplit as split is {
    inlet ReturnEventSplitIn is type ReturnEvent    outlet ReturnEventSplitToReturnsRepository is type ReturnEvent
    outlet ReturnEventSplitToReturnsAnalytics is type ReturnEvent
    handler ReturnEventSplitHandler is {
      on returnRequested: event Return.ReturnRequested is {
        send returnRequested to outlet ReturnEventSplitToReturnsRepository
        send returnRequested to outlet ReturnEventSplitToReturnsAnalytics
        tell returnRequested to entity ReturnsContext.Return
      }
      on returnAuthorized: event Return.ReturnAuthorized is {
        send returnAuthorized to outlet ReturnEventSplitToReturnsRepository
        send returnAuthorized to outlet ReturnEventSplitToReturnsAnalytics
        tell returnAuthorized to entity ReturnsContext.Return
      }
      on labelGenerated: event Return.LabelGenerated is {
        send labelGenerated to outlet ReturnEventSplitToReturnsRepository
        send labelGenerated to outlet ReturnEventSplitToReturnsAnalytics
        tell labelGenerated to entity ReturnsContext.Return
      }
      on shipmentRecorded: event Return.ShipmentRecorded is {
        send shipmentRecorded to outlet ReturnEventSplitToReturnsRepository
        send shipmentRecorded to outlet ReturnEventSplitToReturnsAnalytics
        tell shipmentRecorded to entity ReturnsContext.Return
      }
      on returnReceived: event Return.ReturnReceived is {
        send returnReceived to outlet ReturnEventSplitToReturnsRepository
        send returnReceived to outlet ReturnEventSplitToReturnsAnalytics
        tell returnReceived to entity ReturnsContext.Return
      }
      on itemInspected: event Return.ItemInspected is {
        send itemInspected to outlet ReturnEventSplitToReturnsRepository
        send itemInspected to outlet ReturnEventSplitToReturnsAnalytics
        tell itemInspected to entity ReturnsContext.Return
      }
      on returnApproved: event Return.ReturnApproved is {
        send returnApproved to outlet ReturnEventSplitToReturnsRepository
        send returnApproved to outlet ReturnEventSplitToReturnsAnalytics
        tell returnApproved to entity ReturnsContext.Return
      }
      on returnRejected: event Return.ReturnRejected is {
        send returnRejected to outlet ReturnEventSplitToReturnsRepository
        send returnRejected to outlet ReturnEventSplitToReturnsAnalytics
        tell returnRejected to entity ReturnsContext.Return
      }
      on refundProcessed: event Return.RefundProcessed is {
        send refundProcessed to outlet ReturnEventSplitToReturnsRepository
        send refundProcessed to outlet ReturnEventSplitToReturnsAnalytics
        tell refundProcessed to entity ReturnsContext.Return
      }
      on itemDisposed: event Return.ItemDisposed is {
        send itemDisposed to outlet ReturnEventSplitToReturnsRepository
        send itemDisposed to outlet ReturnEventSplitToReturnsAnalytics
        tell itemDisposed to entity ReturnsContext.Return
      }
      on other is {
        error "Unexpected message for processor ReturnEventSplit"
      }
    } with {
      briefly "Return event fan-out handler"
      described as {
        |Delivers each Return event to all of its consumers.
      }
    }
  } with {
    briefly "Return event fan-out"
    described as {
      |Fans Return events out to the repository and projectors.
    }
  }
  connector 'ReturnEvent Stream' is from outlet ReturnsContext.Return.ReturnEvents2 to inlet ReturnsContext.ReturnEventSplit.ReturnEventSplitIn with {
    briefly "Return events, fanned out to storage and read models"
  }
  connector 'ReturnEvent Storage' is from outlet ReturnsContext.ReturnEventSplit.ReturnEventSplitToReturnsRepository to inlet ReturnsContext.ReturnsRepository.ReturnsRepositoryFromReturn with {
    briefly "Return events on their way to storage"
  }
  connector 'ReturnsAnalytics Feed' is from outlet ReturnsContext.ReturnEventSplit.ReturnEventSplitToReturnsAnalytics to inlet ReturnsContext.ReturnsAnalytics.ReturnsAnalyticsFromReturn with {
    briefly "Return events feeding the ReturnsAnalytics projection"
  }
  connector 'ReturnsAnalytics Storage' is from outlet ReturnsContext.ReturnsAnalytics.ReturnsAnalyticsOut to inlet ReturnsContext.ReturnsRepository.ReturnsRepositoryFromReturnsAnalytics with {
    briefly "The ReturnsAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for returns processing"
  described as {
    |Product returns management context.
  }
}
