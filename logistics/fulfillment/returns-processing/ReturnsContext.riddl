// Returns Processing - Returns Context
context ReturnsContext is {
  adaptor ToCustomerNotification to context CustomerNotification is {
    handler ToCustomerNotificationHandler is {
      on command CustomerNotification.SendRefundNotification is {
        do "the model sends send refund notification"
      }
      on command CustomerNotification.SendReturnConfirmation is {
        do "the model sends send return confirmation"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerNotification"
      }
    } with {
      briefly "to customer notification"
      described as {
        |Carries messages to the external CustomerNotification.
      }
    }
  } with {
      briefly "CustomerNotification integration"
    described as {
      |The model's side of the CustomerNotification conversation.
    }
  }
  adaptor FromInventoryManagement from context InventoryManagement is {
    handler FromInventoryManagementHandler is {
      on event InventoryManagement.InventoryRestocked is {
        do "the model receives inventory restocked"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryManagement"
      }
    } with {
      briefly "from inventory management"
      described as {
        |Carries messages from the external InventoryManagement.
      }
    }
  } with {
      briefly "InventoryManagement integration"
    described as {
      |The model's side of the InventoryManagement conversation.
    }
  }
  adaptor ToInventoryManagement to context InventoryManagement is {
    handler ToInventoryManagementHandler is {
      on command InventoryManagement.MarkAsDefective is {
        do "the model sends mark as defective"
      }
      on command InventoryManagement.RestockInventory is {
        do "the model sends restock inventory"
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryManagement"
      }
    } with {
      briefly "to inventory management"
      described as {
        |Carries messages to the external InventoryManagement.
      }
    }
  } with {
      briefly "InventoryManagement integration"
    described as {
      |The model's side of the InventoryManagement conversation.
    }
  }
  adaptor FromPaymentGateway from context PaymentGateway is {
    handler FromPaymentGatewayHandler is {
      on event PaymentGateway.RefundCompleted is {
        do "the model receives refund completed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentGateway"
      }
    } with {
      briefly "from payment gateway"
      described as {
        |Carries messages from the external PaymentGateway.
      }
    }
  } with {
      briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor ToPaymentGateway to context PaymentGateway is {
    handler ToPaymentGatewayHandler is {
      on command PaymentGateway.IssueStoreCredit is {
        do "the model sends issue store credit"
      }
      on command PaymentGateway.ProcessRefund is {
        do "the model sends process refund"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentGateway"
      }
    } with {
      briefly "to payment gateway"
      described as {
        |Carries messages to the external PaymentGateway.
      }
    }
  } with {
      briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor FromShippingCarrier from context ShippingCarrier is {
    handler FromShippingCarrierHandler is {
      on result ShippingCarrier.ReturnLabelResult is {
        do "the model receives return label result"
      }
      on result ShippingCarrier.TrackingStatus is {
        do "the model receives tracking status"
      }
      on other is {
        error "Unexpected message for adaptor FromShippingCarrier"
      }
    } with {
      briefly "from shipping carrier"
      described as {
        |Carries messages from the external ShippingCarrier.
      }
    }
  } with {
      briefly "ShippingCarrier integration"
    described as {
      |The model's side of the ShippingCarrier conversation.
    }
  }
  adaptor ToShippingCarrier to context ShippingCarrier is {
    handler ToShippingCarrierHandler is {
      on command ShippingCarrier.CreateReturnLabel is {
        do "the model sends create return label"
      }
      on query ShippingCarrier.GetTrackingStatus is {
        do "the model sends get tracking status"
      }
      on other is {
        error "Unexpected message for adaptor ToShippingCarrier"
      }
    } with {
      briefly "to shipping carrier"
      described as {
        |Carries messages to the external ShippingCarrier.
      }
    }
  } with {
      briefly "ShippingCarrier integration"
    described as {
      |The model's side of the ShippingCarrier conversation.
    }
  }
  include "types.riddl"
  include "Return.riddl"
  repository ReturnsRepository is {
    inlet ReturnsRepositoryFromReturn is type ReturnEvent
    inlet ReturnsRepositoryFromReturnsAnalytics is type ReturnEvent
    outlet ReturnsRepositoryResponses is type Return.ReturnResult
    record StoredReturn is {
      returnId: ReturnId with {
        briefly "returnId"
        described as {
          |The returnId column of the stored return row.
        }
      }
      orderId: OrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored return row.
        }
      }
      rmaNumber: RMANumber with {
        briefly "rmaNumber"
        described as {
          |The rmaNumber column of the stored return row.
        }
      }
      status: ReturnStatus with {
        briefly "status"
        described as {
          |The status column of the stored return row.
        }
      }
    } with {
      briefly "Stored return row"
      described as {
        |The persistence shape of return data as this repository stores it.
      }
    }
    schema ReturnsData is relational
      of returns as type StoredReturn
        index on field StoredReturn.returnId
        index on field StoredReturn.orderId
        index on field StoredReturn.status
        index on field StoredReturn.rmaNumber
      with {
      briefly "Returns data schema"
      described as {
        |The relational schema holding returns data for the ReturnsRepository.
      }
    }

    handler ReturnsPersistence is {
      on command Return.RequestReturn is {
        tell event Return.ReturnRequested to entity ReturnsContext.Return
      }
      on command Return.AuthorizeReturn is {
        tell event Return.ReturnAuthorized to entity ReturnsContext.Return
      }
      on command Return.ReceiveReturn is {
        tell event Return.ReturnReceived to entity ReturnsContext.Return
      }
      on command Return.InspectItem is {
        tell event Return.ItemInspected to entity ReturnsContext.Return
      }
      on command Return.ProcessRefund is {
        tell event Return.RefundProcessed to entity ReturnsContext.Return
      }
    } with {
      briefly "Persists return commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Returns data persistence"
    described as {
      |Persistent storage for returns.
    }
  }
  projector ReturnsAnalytics is {
    inlet ReturnsAnalyticsFromReturn is type ReturnEvent
    outlet ReturnsAnalyticsOut is type ReturnEvent
    updates repository ReturnsContext.ReturnsRepository
    record ReturnsMetrics is  {
      period: String(1,20) with {
        briefly "Period"
        described as {
          |Time period.
        }
      }
      totalReturns: Natural with {
        briefly "Total"
        described as {
          |Total returns.
        }
      }
      totalRefunded: Decimal(15,2) with {
        briefly "Refunded"
        described as {
          |Total refunded.
        }
      }
      approvalRate: Decimal(5,2) with {
        briefly "Approval"
        described as {
          |Approval rate pct.
        }
      }
      avgProcessingDays: Decimal(5,2) with {
        briefly "Avg days"
        described as {
          |Avg processing days.
        }
      }
      topReason: ReturnReason with {
        briefly "Top reason"
        described as {
          |Most common reason.
        }
      }
    } with {
      briefly "Returns metrics"
      described as {
        |Return processing metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Return.ReturnRequested is {
        tell event Return.ReturnRequested to repository ReturnsContext.ReturnsRepository
      }
      on event Return.RefundProcessed is {
        tell event Return.RefundProcessed to repository ReturnsContext.ReturnsRepository
      }
      on event Return.ReturnRejected is {
        tell event Return.ReturnRejected to repository ReturnsContext.ReturnsRepository
      }
    } with {
      briefly "Maintains returns analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Returns analytics"
    described as {
      |Returns processing analysis.
    }
  }
  type ReturnEvent is one of {
    ReturnsContext.Return.ReturnRequested,
    ReturnsContext.Return.RefundProcessed,
    ReturnsContext.Return.ReturnRejected
  } with {
    briefly "Return event union"
    described as {
      |Union of Return events for streaming.
    }
  }
  processor ReturnEventSource as source is {
    outlet ReturnEvents is type ReturnEvent
    handler ReturnEventEmitter is {
      on init is { tell command Return.InitializeReturn to entity ReturnsContext.Return }
      on other is {
        error "Unexpected message for source ReturnEventSource"
      }
      on event Return.ReturnRequested is {
        send event Return.ReturnRequested to outlet ReturnEvents
      }
      on event Return.RefundProcessed is {
        send event Return.RefundProcessed to outlet ReturnEvents
      }
      on event Return.ReturnRejected is {
        send event Return.ReturnRejected to outlet ReturnEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits Return events to the stream.
      }
    }
  } with {
    briefly "Return event source"
    described as {
      |Publishes Return events to the event stream.
    }
  }
  processor ReturnEventSink as sink is {
    inlet IncomingReturnEvents is type ReturnEvent
    handler ReturnEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink ReturnEventSink"
      }
      on event Return.ReturnRequested is {
        tell event Return.ReturnRequested to repository ReturnsContext.ReturnsRepository
      }
      on event Return.RefundProcessed is {
        tell event Return.RefundProcessed to repository ReturnsContext.ReturnsRepository
      }
      on event Return.ReturnRejected is {
        tell event Return.ReturnRejected to repository ReturnsContext.ReturnsRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives Return events for persistence.
      }
    }
  } with {
    briefly "Return event sink"
    described as {
      |Receives Return events from streaming.
    }
  }
  connector ReturnEventPipeline is {
    from outlet ReturnsContext.ReturnEventSource.ReturnEvents to inlet ReturnsContext.ReturnEventSink.IncomingReturnEvents
  } with {
    briefly "Return event pipeline"
    described as {
      |Wires Return event source to sink.
    }
  }
  processor ReturnEventSplit is {
    inlet ReturnEventSplitIn is type ReturnEvent
    outlet ReturnEventSplitToReturnsRepository is type ReturnEvent
    outlet ReturnEventSplitToReturnsAnalytics is type ReturnEvent
    handler ReturnEventSplitHandler is {
      on event Return.ReturnRequested is {
        send event Return.ReturnRequested to outlet ReturnEventSplitToReturnsRepository
        send event Return.ReturnRequested to outlet ReturnEventSplitToReturnsAnalytics
        tell event Return.ReturnRequested to entity ReturnsContext.Return
      }
      on event Return.ReturnAuthorized is {
        send event Return.ReturnAuthorized to outlet ReturnEventSplitToReturnsRepository
        send event Return.ReturnAuthorized to outlet ReturnEventSplitToReturnsAnalytics
        tell event Return.ReturnAuthorized to entity ReturnsContext.Return
      }
      on event Return.LabelGenerated is {
        send event Return.LabelGenerated to outlet ReturnEventSplitToReturnsRepository
        send event Return.LabelGenerated to outlet ReturnEventSplitToReturnsAnalytics
        tell event Return.LabelGenerated to entity ReturnsContext.Return
      }
      on event Return.ShipmentRecorded is {
        send event Return.ShipmentRecorded to outlet ReturnEventSplitToReturnsRepository
        send event Return.ShipmentRecorded to outlet ReturnEventSplitToReturnsAnalytics
        tell event Return.ShipmentRecorded to entity ReturnsContext.Return
      }
      on event Return.ReturnReceived is {
        send event Return.ReturnReceived to outlet ReturnEventSplitToReturnsRepository
        send event Return.ReturnReceived to outlet ReturnEventSplitToReturnsAnalytics
        tell event Return.ReturnReceived to entity ReturnsContext.Return
      }
      on event Return.ItemInspected is {
        send event Return.ItemInspected to outlet ReturnEventSplitToReturnsRepository
        send event Return.ItemInspected to outlet ReturnEventSplitToReturnsAnalytics
        tell event Return.ItemInspected to entity ReturnsContext.Return
      }
      on event Return.ReturnApproved is {
        send event Return.ReturnApproved to outlet ReturnEventSplitToReturnsRepository
        send event Return.ReturnApproved to outlet ReturnEventSplitToReturnsAnalytics
        tell event Return.ReturnApproved to entity ReturnsContext.Return
      }
      on event Return.ReturnRejected is {
        send event Return.ReturnRejected to outlet ReturnEventSplitToReturnsRepository
        send event Return.ReturnRejected to outlet ReturnEventSplitToReturnsAnalytics
        tell event Return.ReturnRejected to entity ReturnsContext.Return
      }
      on event Return.RefundProcessed is {
        send event Return.RefundProcessed to outlet ReturnEventSplitToReturnsRepository
        send event Return.RefundProcessed to outlet ReturnEventSplitToReturnsAnalytics
        tell event Return.RefundProcessed to entity ReturnsContext.Return
      }
      on event Return.ItemDisposed is {
        send event Return.ItemDisposed to outlet ReturnEventSplitToReturnsRepository
        send event Return.ItemDisposed to outlet ReturnEventSplitToReturnsAnalytics
        tell event Return.ItemDisposed to entity ReturnsContext.Return
      }
      on other is {
        error "Unexpected message for processor ReturnEventSplit"
      }
    } with {
      briefly "Return event fan-out handler"
      described as {
        |Delivers each Return event to all of its consumers.
      }
    }
  } with {
    briefly "Return event fan-out"
    described as {
      |Fans Return events out to the repository and projectors.
    }
  }
  connector LinkReturnToReturnEventSplit is {
    from outlet ReturnsContext.Return.ReturnEvents2 to
      inlet ReturnsContext.ReturnEventSplit.ReturnEventSplitIn
  } with {
    briefly "LinkReturnToReturnEventSplit"
  }
  connector LinkReturnEventSplitToReturnsRepository is {
    from outlet ReturnsContext.ReturnEventSplit.ReturnEventSplitToReturnsRepository to
      inlet ReturnsContext.ReturnsRepository.ReturnsRepositoryFromReturn
  } with {
    briefly "LinkReturnEventSplitToReturnsRepository"
  }
  connector LinkReturnEventSplitToReturnsAnalytics is {
    from outlet ReturnsContext.ReturnEventSplit.ReturnEventSplitToReturnsAnalytics to
      inlet ReturnsContext.ReturnsAnalytics.ReturnsAnalyticsFromReturn
  } with {
    briefly "LinkReturnEventSplitToReturnsAnalytics"
  }
  connector LinkReturnsAnalyticsToReturnsRepository is {
    from outlet ReturnsContext.ReturnsAnalytics.ReturnsAnalyticsOut to
      inlet ReturnsContext.ReturnsRepository.ReturnsRepositoryFromReturnsAnalytics
  } with {
    briefly "LinkReturnsAnalyticsToReturnsRepository"
  }
} with {
  briefly "Bounded context for returns processing"
  described as {
    |Product returns management context.
  }
}
