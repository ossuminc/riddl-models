// Returns Processing Domain Model
// Product returns and reverse logistics
domain ReturnsProcessing is {
  persistent connector 'ShippingCarrierReply Stream' is from outlet ShippingCarrier.ShippingCarrierRepliesOut to inlet ReturnsContext.ToShippingCarrier.ToShippingCarrierReplies with {
    briefly "What ShippingCarrier answers ReturnsContext"
  }
  persistent connector 'ShippingCarrierEvent Stream' is from outlet ShippingCarrier.ShippingCarrierEventsOut to inlet ReturnsContext.FromShippingCarrier.FromShippingCarrierIn with {
    briefly "What ShippingCarrier tells ReturnsContext, unasked"
  }
  persistent connector 'InventoryManagementEvent Stream' is from outlet InventoryManagement.InventoryManagementEventsOut to inlet ReturnsContext.FromInventoryManagement.FromInventoryManagementIn with {
    briefly "What InventoryManagement tells ReturnsContext, unasked"
  }
  persistent connector 'PaymentGatewayEvent Stream' is from outlet PaymentGateway.PaymentGatewayEventsOut to inlet ReturnsContext.FromPaymentGateway.FromPaymentGatewayIn with {
    briefly "What PaymentGateway tells ReturnsContext, unasked"
  }
  persistent connector 'ShippingCarrierRequest Stream' is from outlet ReturnsContext.ToShippingCarrier.ToShippingCarrierOut to inlet ShippingCarrier.ShippingCarrierRequests with {
    briefly "What ReturnsContext asks ShippingCarrier to send"
  }
  persistent connector 'InventoryManagementRequest Stream' is from outlet ReturnsContext.ToInventoryManagement.ToInventoryManagementOut to inlet InventoryManagement.InventoryManagementRequests with {
    briefly "What ReturnsContext asks InventoryManagement to send"
  }
  persistent connector 'PaymentGatewayRequest Stream' is from outlet ReturnsContext.ToPaymentGateway.ToPaymentGatewayOut to inlet PaymentGateway.PaymentGatewayRequests with {
    briefly "What ReturnsContext asks PaymentGateway to send"
  }
  persistent connector 'CustomerNotificationRequest Stream' is from outlet ReturnsContext.ToCustomerNotification.ToCustomerNotificationOut to inlet CustomerNotification.CustomerNotificationRequests with {
    briefly "What ReturnsContext asks CustomerNotification to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ReturnsProcessor is "person handling return items" with {
    briefly "Returns Processor"
    described as {
      |Worker processing returned items.
    }
  }
  user QualityInspector is "person inspecting returned items" with {
    briefly "Quality Inspector"
    described as {
      |Inspector evaluating item condition.
    }
  }
  user CustomerServiceAgent is "person handling return requests" with {
    briefly "Customer Service Agent"
    described as {
      |Agent managing customer returns.
    }
  }
  epic ReturnsManagement is {
    user CustomerServiceAgent wants to "to process returns efficiently" so that "customers have a good return experience"
    case ProcessReturn is {
      user CustomerServiceAgent wants to "to handle a customer return" so that "the customer receives their refund"
      step is "Agent creates" "return authorization" "for customer" with {
        briefly "Create RMA"
        described as {
          |Issue return auth.
        }
      }
      step is "System tracks" "return shipment" "to warehouse" with {
        briefly "Track return"
        described as {
          |Monitor shipment.
        }
      }
    } with {
      briefly "Process return"
      described as {
        |Handling customer returns.
      }
    }
  } with {
    briefly "Returns management"
    described as {
      |Epic for returns processing.
    }
  }
  include "ReturnsContext.riddl"
  include "external-contexts.riddl"
  application context ReturnsProcessingApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ReturnsProcessing are delivered.
      }
    }
    outlet AppReturnCommands is type ReturnsContext.Return.ReturnCommand
    inlet AppReturnsRepositoryResponses is result ReturnsContext.Return.ReturnResult    handler ReturnsProcessingAppHandler is {
      on other is {
        error "Unexpected message for application context ReturnsProcessingApp"
      }
    } with {
      briefly "ReturnsProcessingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ReturnsProcessingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ReturnCommand Stream' is from outlet ReturnsProcessingApp.AppReturnCommands to inlet ReturnsContext.ReturnCommandStreamIn with {
    briefly "Return commands from the application"
  }
  persistent connector 'ReturnResult Stream' is from outlet ReturnsContext.ReturnResultStreamOut to inlet ReturnsProcessingApp.AppReturnsRepositoryResponses with {
    briefly "Returns query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ReturnsProcessingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Returns processing domain"
  described as {
    |Product returns and reverse logistics.
  }
}
