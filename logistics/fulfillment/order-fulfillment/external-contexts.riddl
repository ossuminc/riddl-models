// Order Fulfillment - External Contexts
external context CarrierSystem as split is {
  type CarrierSystemReply is one of {
    ShipmentRates or TrackingStatus
  } with {
    briefly "Everything this service answers"
  }
  outlet CarrierSystemRepliesOut is type CarrierSystemReply
 with {
    briefly "What this service answers, on its way back"
  }
  outlet CarrierSystemEventsOut is event ShipmentBooked
 with {
    briefly "What this service tells the model, unasked"
  }
  type CarrierSystemCommand is one of {
    GetShipmentRates or BookShipment or GetTrackingStatus
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet CarrierSystemRequests is type CarrierSystemCommand with {
    briefly "What this context asks the service to send"
  }
  handler CarrierSystemBoundary is {
    on query GetTrackingStatus is {
      let askAnswer: type TrackingStatus = prompt("look up what GetTrackingStatus asks for")
      reply askAnswer
    }
    on query GetShipmentRates is {
      let askAnswer: type ShipmentRates = prompt("look up what GetShipmentRates asks for")
      reply askAnswer
    }
    on command BookShipment is {
      let shipmentBooked: type ShipmentBooked = prompt("the shipment booked this produces")
      send shipmentBooked to outlet CarrierSystem.CarrierSystemEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context CarrierSystem"
    }
  } with {
    briefly "CarrierSystem boundary"
  }
  query GetShipmentRates replies result ShipmentRates is {
    warehouseId: WarehouseId with {
      briefly "Warehouse"
      described as {
        |Origin warehouse.
      }
    }
    destination: AddressInfo with {
      briefly "Destination"
      described as {
        |Delivery address.
      }
    }
    packages: PackageInfo+ with {
      briefly "Packages"
      described as {
        |Packages to ship.
      }
    }
    priority: ShipmentPriority with {
      briefly "Priority"
      described as {
        |Shipping priority.
      }
    }
  } with {
    briefly "Request shipment rates"
    described as {
      |Requests carrier rate quotes.
    }
  }
  result ShipmentRates is {
    options: CarrierSelection+ with {
      briefly "Options"
      described as {
        |Available carrier options.
      }
    }
  } with {
    briefly "Shipment rates"
    described as {
      |Carrier rate quote results.
    }
  }
  command BookShipment is {
    orderId: FulfillmentOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    carrier: CarrierSelection with {
      briefly "Carrier"
      described as {
        |Selected carrier.
      }
    }
    packages: PackageInfo+ with {
      briefly "Packages"
      described as {
        |Packages to ship.
      }
    }
  } with {
    briefly "Book shipment"
    described as {
      |Books a shipment with the carrier.
    }
  }
  event ShipmentBooked is {
    orderId: FulfillmentOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    tracking: TrackingInfo with {
      briefly "Tracking"
      described as {
        |Tracking info.
      }
    }
  } with {
    briefly "Shipment booked"
    described as {
      |Emitted when shipment is booked with carrier.
    }
  }
  query GetTrackingStatus replies result TrackingStatus is {
    trackingNumber: String(1,100) with {
      briefly "Tracking"
      described as {
        |Tracking number.
      }
    }
  } with {
    briefly "Get tracking status"
    described as {
      |Gets current shipment tracking status.
    }
  }
  result TrackingStatus is {
    trackingNumber: String(1,100) with {
      briefly "Tracking"
      described as {
        |Tracking number.
      }
    }
    currentLocation: String(1,200) with {
      briefly "Location"
      described as {
        |Current location.
      }
    }
    shipmentStatus: String(1,50) with {
      briefly "Status"
      described as {
        |Shipment status.
      }
    }
    estimatedDelivery: Date? with {
      briefly "ETA"
      described as {
        |Estimated delivery.
      }
    }
  } with {
    briefly "Tracking status"
    described as {
      |Current shipment tracking status.
    }
  }
} with {
  briefly "External carrier system"
  described as {
    |Shipping carrier integration system.
  }
}
external context WarehouseSystem as split is {
  outlet WarehouseSystemRepliesOut is result InventoryAvailability
 with {
    briefly "What this service answers, on its way back"
  }
  type WarehouseSystemEvent is one of {
    InventoryReleased or InventoryReserved
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet WarehouseSystemEventsOut is type WarehouseSystemEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type WarehouseSystemCommand is one of {
    ReleaseInventory or ReserveInventory or CheckInventoryAvailability
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet WarehouseSystemRequests is type WarehouseSystemCommand with {
    briefly "What this context asks the service to send"
  }
  handler WarehouseSystemBoundary is {
    on query CheckInventoryAvailability is {
      let askAnswer: type InventoryAvailability = prompt("look up what CheckInventoryAvailability asks for")
      reply askAnswer
    }
    on command ReleaseInventory is {
      let inventoryReleased: type InventoryReleased = prompt("the inventory released this produces")
      send inventoryReleased to outlet WarehouseSystem.WarehouseSystemEventsOut
      do "deliver it to the recipient"
    }
    on command ReserveInventory is {
      let inventoryReserved: type InventoryReserved = prompt("the inventory reserved this produces")
      send inventoryReserved to outlet WarehouseSystem.WarehouseSystemEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context WarehouseSystem"
    }
  } with {
    briefly "WarehouseSystem boundary"
  }
  query CheckInventoryAvailability replies result InventoryAvailability is {
    warehouseId: WarehouseId with {
      briefly "Warehouse"
      described as {
        |Warehouse ID.
      }
    }
    items: OrderLineItem+ with {
      briefly "Items"
      described as {
        |Items to check.
      }
    }
  } with {
    briefly "Check inventory availability"
    described as {
      |Checks item availability in warehouse.
    }
  }
  result InventoryAvailability is {
    available: Boolean with {
      briefly "Available"
      described as {
        |All items available.
      }
    }
    unavailableItems: String(1,50)* with {
      briefly "Unavailable"
      described as {
        |Unavailable SKUs.
      }
    }
  } with {
    briefly "Inventory availability"
    described as {
      |Warehouse inventory availability result.
    }
  }
  command ReserveInventory is {
    orderId: FulfillmentOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    warehouseId: WarehouseId with {
      briefly "Warehouse"
      described as {
        |Warehouse ID.
      }
    }
    items: OrderLineItem+ with {
      briefly "Items"
      described as {
        |Items to reserve.
      }
    }
  } with {
    briefly "Reserve inventory"
    described as {
      |Reserves inventory for a fulfillment order.
    }
  }
  event InventoryReserved is {
    orderId: FulfillmentOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    reservedAt: TimeStamp with {
      briefly "Reserved"
      described as {
        |Reservation time.
      }
    }
  } with {
    briefly "Inventory reserved"
    described as {
      |Emitted when inventory is reserved.
    }
  }
  command ReleaseInventory is {
    orderId: FulfillmentOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    warehouseId: WarehouseId with {
      briefly "Warehouse"
      described as {
        |Warehouse ID.
      }
    }
  } with {
    briefly "Release inventory"
    described as {
      |Releases reserved inventory on cancellation.
    }
  }
  event InventoryReleased is {
    orderId: FulfillmentOrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    releasedAt: TimeStamp with {
      briefly "Released"
      described as {
        |Release time.
      }
    }
  } with {
    briefly "Inventory released"
    described as {
      |Emitted when reserved inventory is released.
    }
  }
} with {
  briefly "External warehouse system"
  described as {
    |Warehouse management and inventory system.
  }
}
