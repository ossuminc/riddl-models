// Order Fulfillment - Fulfillment Context
context FulfillmentContext as router is {
  inlet FulfillmentOrderCommandStreaIn is type FulfillmentOrderCommand  outlet FulfillmentOrderCommandStreaOut is type FulfillmentOrderCommand
  inlet FulfillmentOrderResultStreamIn is type FulfillmentOrder.FulfillmentOrderResult  outlet FulfillmentOrderResultStreamOut is type FulfillmentOrder.FulfillmentOrderResult
  handler FulfillmentContextBoundary is {
    on createFulfillmentOrder: command FulfillmentOrder.CreateFulfillmentOrder is {
      send createFulfillmentOrder to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on allocateInventory: command FulfillmentOrder.AllocateInventory is {
      send allocateInventory to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on recordPickCompletion: command FulfillmentOrder.RecordPickCompletion is {
      send recordPickCompletion to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on packOrder: command FulfillmentOrder.PackOrder is {
      send packOrder to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on selectCarrier: command FulfillmentOrder.SelectCarrier is {
      send selectCarrier to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on createShippingLabel: command FulfillmentOrder.CreateShippingLabel is {
      send createShippingLabel to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on shipOrder: command FulfillmentOrder.ShipOrder is {
      send shipOrder to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on updateShipmentStatus: command FulfillmentOrder.UpdateShipmentStatus is {
      send updateShipmentStatus to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on confirmDelivery: command FulfillmentOrder.ConfirmDelivery is {
      send confirmDelivery to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on failDelivery: command FulfillmentOrder.FailDelivery is {
      send failDelivery to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on cancelFulfillment: command FulfillmentOrder.CancelFulfillment is {
      send cancelFulfillment to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on fulfillmentOrderResult: result FulfillmentOrder.FulfillmentOrderResult is {
      send fulfillmentOrderResult to outlet FulfillmentContext.FulfillmentOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the FulfillmentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'FulfillmentOrderCommand Stream Intake' is from outlet FulfillmentContext.FulfillmentOrderCommandStreaOut to inlet FulfillmentContext.FulfillmentOrder.FulfillmentOrderCommands  connector 'FulfillmentOrderResult Stream Egress' is from outlet FulfillmentContext.FulfillmentRepository.FulfillmentRepositoryResponses to inlet FulfillmentContext.FulfillmentOrderResultStreamIn  adaptor FromCarrierSystem from context CarrierSystem is { 
    handler FromCarrierSystemHandler is {
      on event CarrierSystem.ShipmentBooked is {
        do "the model receives shipment booked"
      }
      on result CarrierSystem.ShipmentRates is {
        do "the model receives shipment rates"
      }
      on result CarrierSystem.TrackingStatus is {
        do "the model receives tracking status"
      }
      on other is {
        error "Unexpected message for adaptor FromCarrierSystem"
      }
    } with {
      briefly "from carrier system"
      described as {
        |Carries messages from the external CarrierSystem.
      }
    }
  } with {
    briefly "CarrierSystem integration"
    described as {
      |The model's side of the CarrierSystem conversation.
    }
  }
  adaptor ToCarrierSystem to context CarrierSystem is { 
    handler ToCarrierSystemHandler is {
      on command CarrierSystem.BookShipment is {
        do "the model sends book shipment"
      }
      on query CarrierSystem.GetTrackingStatus is {
        do "the model sends get tracking status"
      }
      on command CarrierSystem.RequestShipmentRates is {
        do "the model sends request shipment rates"
      }
      on other is {
        error "Unexpected message for adaptor ToCarrierSystem"
      }
    } with {
      briefly "to carrier system"
      described as {
        |Carries messages to the external CarrierSystem.
      }
    }
  } with {
    briefly "CarrierSystem integration"
    described as {
      |The model's side of the CarrierSystem conversation.
    }
  }
  adaptor FromWarehouseSystem from context WarehouseSystem is { 
    handler FromWarehouseSystemHandler is {
      on result WarehouseSystem.InventoryAvailability is {
        do "the model receives inventory availability"
      }
      on event WarehouseSystem.InventoryReleased is {
        do "the model receives inventory released"
      }
      on event WarehouseSystem.InventoryReserved is {
        do "the model receives inventory reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromWarehouseSystem"
      }
    } with {
      briefly "from warehouse system"
      described as {
        |Carries messages from the external WarehouseSystem.
      }
    }
  } with {
    briefly "WarehouseSystem integration"
    described as {
      |The model's side of the WarehouseSystem conversation.
    }
  }
  adaptor ToWarehouseSystem to context WarehouseSystem is { 
    handler ToWarehouseSystemHandler is {
      on query WarehouseSystem.CheckInventoryAvailability is {
        do "the model sends check inventory availability"
      }
      on command WarehouseSystem.ReleaseInventory is {
        do "the model sends release inventory"
      }
      on command WarehouseSystem.ReserveInventory is {
        do "the model sends reserve inventory"
      }
      on other is {
        error "Unexpected message for adaptor ToWarehouseSystem"
      }
    } with {
      briefly "to warehouse system"
      described as {
        |Carries messages to the external WarehouseSystem.
      }
    }
  } with {
    briefly "WarehouseSystem integration"
    described as {
      |The model's side of the WarehouseSystem conversation.
    }
  }
  include "types.riddl"
  include "FulfillmentOrder.riddl"
  type FulfillmentRepositoryCommand is one of {
    FulfillmentContext.FulfillmentRepository.PersistCarrierSelected or FulfillmentContext.FulfillmentRepository.PersistDeliveryConfirmed or FulfillmentContext.FulfillmentRepository.PersistDeliveryFailed or FulfillmentContext.FulfillmentRepository.PersistFulfillmentCancelled or FulfillmentContext.FulfillmentRepository.PersistFulfillmentOrderCreated or FulfillmentContext.FulfillmentRepository.PersistInventoryAllocated or FulfillmentContext.FulfillmentRepository.PersistItemPicked or FulfillmentContext.FulfillmentRepository.PersistOrderPacked or FulfillmentContext.FulfillmentRepository.PersistOrderShipped or FulfillmentContext.FulfillmentRepository.PersistShipmentStatusUpdated or FulfillmentContext.FulfillmentRepository.PersistShippingLabelCreated
  } with {
    briefly "Anything that writes FulfillmentRepository"
    described as {
      |The persistence commands FulfillmentRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository FulfillmentRepository as flow is {
    inlet FulfillmentRepositoryFromFulfillmentMetrics is type FulfillmentRepositoryCommand
    command PersistCarrierSelected is  {
      orderId: FulfillmentOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row CarrierSelected applies to.
        }
      }
    } with {
      briefly "Persist CarrierSelected"
      described as {
        |Instructs this repository to apply CarrierSelected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFulfillmentCancelled is  {
      orderId: FulfillmentOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row FulfillmentCancelled applies to.
        }
      }
    } with {
      briefly "Persist FulfillmentCancelled"
      described as {
        |Instructs this repository to apply FulfillmentCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInventoryAllocated is  {
      orderId: FulfillmentOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryAllocated applies to.
        }
      }
    } with {
      briefly "Persist InventoryAllocated"
      described as {
        |Instructs this repository to apply InventoryAllocated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemPicked is  {
      orderId: FulfillmentOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemPicked applies to.
        }
      }
    } with {
      briefly "Persist ItemPicked"
      described as {
        |Instructs this repository to apply ItemPicked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderPacked is  {
      orderId: FulfillmentOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderPacked applies to.
        }
      }
    } with {
      briefly "Persist OrderPacked"
      described as {
        |Instructs this repository to apply OrderPacked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentStatusUpdated is  {
      orderId: FulfillmentOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShipmentStatusUpdated applies to.
        }
      }
    } with {
      briefly "Persist ShipmentStatusUpdated"
      described as {
        |Instructs this repository to apply ShipmentStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShippingLabelCreated is  {
      orderId: FulfillmentOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShippingLabelCreated applies to.
        }
      }
    } with {
      briefly "Persist ShippingLabelCreated"
      described as {
        |Instructs this repository to apply ShippingLabelCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryConfirmed is  {
      orderId: FulfillmentOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryConfirmed applies to.
        }
      }
    } with {
      briefly "Persist DeliveryConfirmed"
      described as {
        |Instructs this repository to apply DeliveryConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryFailed is  {
      orderId: FulfillmentOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryFailed applies to.
        }
      }
    } with {
      briefly "Persist DeliveryFailed"
      described as {
        |Instructs this repository to apply DeliveryFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFulfillmentOrderCreated is  {
      orderId: FulfillmentOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row FulfillmentOrderCreated applies to.
        }
      }
    } with {
      briefly "Persist FulfillmentOrderCreated"
      described as {
        |Instructs this repository to apply FulfillmentOrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderShipped is  {
      orderId: FulfillmentOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderShipped applies to.
        }
      }
    } with {
      briefly "Persist OrderShipped"
      described as {
        |Instructs this repository to apply OrderShipped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet FulfillmentRepositoryResponses is type FulfillmentOrder.FulfillmentOrderResult
    record StoredFulfillmentOrder is  {
      fulfillmentOrderId: FulfillmentOrderId with {
        briefly "fulfillmentOrderId"
        described as {
          |The fulfillmentOrderId column of the stored fulfillmentOrder row.
        }
      }
      orderId: FulfillmentOrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored fulfillmentOrder row.
        }
      }
      orderInfo: FulfillmentOrderInfo with {
        briefly "orderInfo"
        described as {
          |The orderInfo column of the stored fulfillmentOrder row.
        }
      }
      status: FulfillmentStatus with {
        briefly "status"
        described as {
          |The status column of the stored fulfillmentOrder row.
        }
      }
    } with {
      briefly "Stored fulfillmentOrder row"
      described as {
        |The persistence shape of fulfillmentOrder data as this repository stores it.
      }
    }
    schema FulfillmentData is relational
      of fulfillmentOrders as type StoredFulfillmentOrder
        index on field StoredFulfillmentOrder.orderId
        index on field StoredFulfillmentOrder.orderInfo.customerId
        index on field StoredFulfillmentOrder.status
 with {
      briefly "Fulfillment data schema"
      described as {
        |The relational schema holding fulfillment data for the FulfillmentRepository.
      }
    }
    handler FulfillmentPersistence is {
      on persistCarrierSelected: command PersistCarrierSelected is {
        do "apply CarrierSelected to the stored row"
      }
      on persistFulfillmentCancelled: command PersistFulfillmentCancelled is {
        do "apply FulfillmentCancelled to the stored row"
      }
      on persistInventoryAllocated: command PersistInventoryAllocated is {
        do "apply InventoryAllocated to the stored row"
      }
      on persistItemPicked: command PersistItemPicked is {
        do "apply ItemPicked to the stored row"
      }
      on persistOrderPacked: command PersistOrderPacked is {
        do "apply OrderPacked to the stored row"
      }
      on persistShipmentStatusUpdated: command PersistShipmentStatusUpdated is {
        do "apply ShipmentStatusUpdated to the stored row"
      }
      on persistShippingLabelCreated: command PersistShippingLabelCreated is {
        do "apply ShippingLabelCreated to the stored row"
      }
      on persistDeliveryConfirmed: command PersistDeliveryConfirmed is {
        do "apply DeliveryConfirmed to the stored row"
      }
      on persistDeliveryFailed: command PersistDeliveryFailed is {
        do "apply DeliveryFailed to the stored row"
      }
      on persistFulfillmentOrderCreated: command PersistFulfillmentOrderCreated is {
        do "apply FulfillmentOrderCreated to the stored row"
      }
      on persistOrderShipped: command PersistOrderShipped is {
        do "apply OrderShipped to the stored row"
      }
      on query GetOrderMetrics is {
        let orderMetricsView: type OrderMetricsView = prompt("read the order metrics projection")
        reply orderMetricsView
      }
    } with {
      briefly "Persists fulfillment commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Fulfillment data persistence"
    described as {
      |Persistent storage for fulfillment orders.
    }
  }
  query GetOrderMetrics replies result OrderMetricsView is  {
    orderMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which order metrics to retrieve.
      }
    }
  } with {
    briefly "Get order metrics"
    described as {
      |Retrieves the order metrics projection.
    }
  }
  result OrderMetricsView is  {
    orderMetrics: FulfillmentMetrics.OrderMetrics with {
      briefly "Order metrics"
      described as {
        |The order metrics being returned.
      }
    }
  } with {
    briefly "Order metrics view"
    described as {
      |Read model view carrying the order metrics projection.
    }
  }
  projector FulfillmentMetrics as flow is {
    outlet FulfillmentMetricsToRepository is type FulfillmentRepositoryCommand
    updates repository FulfillmentContext.FulfillmentRepository
    inlet FulfillmentMetricsFromFulfillmentOrder is type FulfillmentOrderEvent
    record OrderMetrics is  {
      ordersReceived: Natural with {
        briefly "Received"
        described as {
          |Orders received.
        }
      }
      ordersShipped: Natural with {
        briefly "Shipped"
        described as {
          |Orders shipped.
        }
      }
      ordersDelivered: Natural with {
        briefly "Delivered"
        described as {
          |Orders delivered.
        }
      }
      ordersFailed: Natural with {
        briefly "Failed"
        described as {
          |Orders with failed delivery.
        }
      }
      averageFulfillmentTime: Decimal(8,2) with {
        briefly "Avg time"
        described as {
          |Average fulfillment hours.
        }
      }
    } with {
      briefly "Order metrics"
      described as {
        |Fulfillment processing metrics.
      }
    }
    handler MetricsHandler is {
      on carrierSelected: event FulfillmentOrder.CarrierSelected is {
        tell command FulfillmentContext.FulfillmentRepository.PersistCarrierSelected(orderId = carrierSelected.orderId) to repository FulfillmentContext.FulfillmentRepository
        do "apply CarrierSelected to the FulfillmentMetrics projection"
      }
      on fulfillmentCancelled: event FulfillmentOrder.FulfillmentCancelled is {
        tell command FulfillmentContext.FulfillmentRepository.PersistFulfillmentCancelled(orderId = fulfillmentCancelled.orderId) to repository FulfillmentContext.FulfillmentRepository
        do "apply FulfillmentCancelled to the FulfillmentMetrics projection"
      }
      on inventoryAllocated: event FulfillmentOrder.InventoryAllocated is {
        tell command FulfillmentContext.FulfillmentRepository.PersistInventoryAllocated(orderId = inventoryAllocated.orderId) to repository FulfillmentContext.FulfillmentRepository
        do "apply InventoryAllocated to the FulfillmentMetrics projection"
      }
      on itemPicked: event FulfillmentOrder.ItemPicked is {
        tell command FulfillmentContext.FulfillmentRepository.PersistItemPicked(orderId = itemPicked.orderId) to repository FulfillmentContext.FulfillmentRepository
        do "apply ItemPicked to the FulfillmentMetrics projection"
      }
      on orderPacked: event FulfillmentOrder.OrderPacked is {
        tell command FulfillmentContext.FulfillmentRepository.PersistOrderPacked(orderId = orderPacked.orderId) to repository FulfillmentContext.FulfillmentRepository
        do "apply OrderPacked to the FulfillmentMetrics projection"
      }
      on shipmentStatusUpdated: event FulfillmentOrder.ShipmentStatusUpdated is {
        tell command FulfillmentContext.FulfillmentRepository.PersistShipmentStatusUpdated(orderId = shipmentStatusUpdated.orderId) to repository FulfillmentContext.FulfillmentRepository
        do "apply ShipmentStatusUpdated to the FulfillmentMetrics projection"
      }
      on shippingLabelCreated: event FulfillmentOrder.ShippingLabelCreated is {
        tell command FulfillmentContext.FulfillmentRepository.PersistShippingLabelCreated(orderId = shippingLabelCreated.orderId) to repository FulfillmentContext.FulfillmentRepository
        do "apply ShippingLabelCreated to the FulfillmentMetrics projection"
      }
      on fulfillmentOrderCreated: event FulfillmentOrder.FulfillmentOrderCreated is {
        tell command FulfillmentContext.FulfillmentRepository.PersistFulfillmentOrderCreated(orderId = fulfillmentOrderCreated.orderId) to repository FulfillmentContext.FulfillmentRepository
      }
      on orderShipped: event FulfillmentOrder.OrderShipped is {
        tell command FulfillmentContext.FulfillmentRepository.PersistOrderShipped(orderId = orderShipped.orderId) to repository FulfillmentContext.FulfillmentRepository
      }
      on deliveryConfirmed: event FulfillmentOrder.DeliveryConfirmed is {
        tell command FulfillmentContext.FulfillmentRepository.PersistDeliveryConfirmed(orderId = deliveryConfirmed.orderId) to repository FulfillmentContext.FulfillmentRepository
      }
      on deliveryFailed: event FulfillmentOrder.DeliveryFailed is {
        tell command FulfillmentContext.FulfillmentRepository.PersistDeliveryFailed(orderId = deliveryFailed.orderId) to repository FulfillmentContext.FulfillmentRepository
      }
    } with {
      briefly "Maintains fulfillment metrics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Fulfillment metrics"
    described as {
      |Order fulfillment analytics.
    }
  }
  type FulfillmentOrderEvent is one of {
    FulfillmentContext.FulfillmentOrder.FulfillmentOrderCreated or FulfillmentContext.FulfillmentOrder.OrderShipped or FulfillmentContext.FulfillmentOrder.DeliveryConfirmed or FulfillmentContext.FulfillmentOrder.CarrierSelected or FulfillmentContext.FulfillmentOrder.DeliveryFailed or FulfillmentContext.FulfillmentOrder.FulfillmentCancelled or FulfillmentContext.FulfillmentOrder.InventoryAllocated or FulfillmentContext.FulfillmentOrder.ItemPicked or FulfillmentContext.FulfillmentOrder.OrderPacked or FulfillmentContext.FulfillmentOrder.ShipmentStatusUpdated or FulfillmentContext.FulfillmentOrder.ShippingLabelCreated
  } with {
    briefly "FulfillmentOrder event union"
    described as {
      |Union of FulfillmentOrder events for streaming.
    }
  }
  processor FulfillmentOrderEventSplit as flow is {
    inlet FulfillmentOrderEventSplitIn is type FulfillmentOrderEvent
    outlet FulfillmentOrderEventSplitToFulfillmentMetrics is type FulfillmentOrderEvent
    handler FulfillmentOrderEventSplitHandler is {
      on fulfillmentOrderCreated: event FulfillmentOrder.FulfillmentOrderCreated is {
        send fulfillmentOrderCreated to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell fulfillmentOrderCreated to entity FulfillmentContext.FulfillmentOrder
      }
      on inventoryAllocated: event FulfillmentOrder.InventoryAllocated is {
        send inventoryAllocated to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell inventoryAllocated to entity FulfillmentContext.FulfillmentOrder
      }
      on itemPicked: event FulfillmentOrder.ItemPicked is {
        send itemPicked to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell itemPicked to entity FulfillmentContext.FulfillmentOrder
      }
      on orderPacked: event FulfillmentOrder.OrderPacked is {
        send orderPacked to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell orderPacked to entity FulfillmentContext.FulfillmentOrder
      }
      on carrierSelected: event FulfillmentOrder.CarrierSelected is {
        send carrierSelected to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell carrierSelected to entity FulfillmentContext.FulfillmentOrder
      }
      on shippingLabelCreated: event FulfillmentOrder.ShippingLabelCreated is {
        send shippingLabelCreated to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell shippingLabelCreated to entity FulfillmentContext.FulfillmentOrder
      }
      on orderShipped: event FulfillmentOrder.OrderShipped is {
        send orderShipped to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell orderShipped to entity FulfillmentContext.FulfillmentOrder
      }
      on shipmentStatusUpdated: event FulfillmentOrder.ShipmentStatusUpdated is {
        send shipmentStatusUpdated to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell shipmentStatusUpdated to entity FulfillmentContext.FulfillmentOrder
      }
      on deliveryConfirmed: event FulfillmentOrder.DeliveryConfirmed is {
        send deliveryConfirmed to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell deliveryConfirmed to entity FulfillmentContext.FulfillmentOrder
      }
      on deliveryFailed: event FulfillmentOrder.DeliveryFailed is {
        send deliveryFailed to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell deliveryFailed to entity FulfillmentContext.FulfillmentOrder
      }
      on fulfillmentCancelled: event FulfillmentOrder.FulfillmentCancelled is {
        send fulfillmentCancelled to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell fulfillmentCancelled to entity FulfillmentContext.FulfillmentOrder
      }
      on other is {
        error "Unexpected message for processor FulfillmentOrderEventSplit"
      }
    } with {
      briefly "FulfillmentOrder event fan-out handler"
      described as {
        |Delivers each FulfillmentOrder event to all of its consumers.
      }
    }
  } with {
    briefly "FulfillmentOrder event fan-out"
    described as {
      |Fans FulfillmentOrder events out to the repository and projectors.
    }
  }
  connector 'FulfillmentOrderEvent Stream' is from outlet FulfillmentContext.FulfillmentOrder.FulfillmentOrderEvents2 to inlet FulfillmentContext.FulfillmentOrderEventSplit.FulfillmentOrderEventSplitIn with {
    briefly "FulfillmentOrder events, fanned out to storage and read models"
  }
  connector 'FulfillmentMetrics Feed' is from outlet FulfillmentContext.FulfillmentOrderEventSplit.FulfillmentOrderEventSplitToFulfillmentMetrics to inlet FulfillmentContext.FulfillmentMetrics.FulfillmentMetricsFromFulfillmentOrder with {
    briefly "FulfillmentOrder events feeding the FulfillmentMetrics projection"
  }
  connector 'FulfillmentMetrics Storage' is from outlet FulfillmentContext.FulfillmentMetrics.FulfillmentMetricsToRepository to inlet FulfillmentContext.FulfillmentRepository.FulfillmentRepositoryFromFulfillmentMetrics with {
    briefly "FulfillmentMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for order fulfillment"
  described as {
    |Order fulfillment operations context.
  }
}
