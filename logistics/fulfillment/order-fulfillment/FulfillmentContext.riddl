// Order Fulfillment - Fulfillment Context
context FulfillmentContext is {
  include "types.riddl"
  include "FulfillmentOrder.riddl"
  repository FulfillmentRepository is {
    inlet FulfillmentRepositoryFromFulfillmentOrder is type FulfillmentOrderEvent
    inlet FulfillmentRepositoryFromFulfillmentMetrics is type FulfillmentOrderEvent
    outlet FulfillmentRepositoryResponses is type FulfillmentOrder.FulfillmentOrderResult
    schema FulfillmentData is relational
      of fulfillmentOrders as type FulfillmentOrder
        index on field FulfillmentOrder.orderId
        index on field FulfillmentOrder.orderInfo.customerId
        index on field FulfillmentOrder.status
      with {
      briefly "Fulfillment data schema"
      described as {
        |The relational schema holding fulfillment data for the FulfillmentRepository.
      }
    }

    handler FulfillmentPersistence is {
      on command FulfillmentOrder.CreateFulfillmentOrder is {
        tell event FulfillmentOrder.FulfillmentOrderCreated to entity FulfillmentContext.FulfillmentOrder
      }
      on command FulfillmentOrder.AllocateInventory is {
        tell event FulfillmentOrder.InventoryAllocated to entity FulfillmentContext.FulfillmentOrder
      }
      on command FulfillmentOrder.PackOrder is {
        tell event FulfillmentOrder.OrderPacked to entity FulfillmentContext.FulfillmentOrder
      }
      on command FulfillmentOrder.ShipOrder is {
        tell event FulfillmentOrder.OrderShipped to entity FulfillmentContext.FulfillmentOrder
      }
      on command FulfillmentOrder.ConfirmDelivery is {
        tell event FulfillmentOrder.DeliveryConfirmed to entity FulfillmentContext.FulfillmentOrder
      }
    } with {
      briefly "Persists fulfillment commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Fulfillment data persistence"
    described as {
      |Persistent storage for fulfillment orders.
    }
  }
  projector FulfillmentMetrics is {
    inlet FulfillmentMetricsFromFulfillmentOrder is type FulfillmentOrderEvent
    outlet FulfillmentMetricsOut is type FulfillmentOrderEvent
    updates repository FulfillmentContext.FulfillmentRepository
    record OrderMetrics is  {
      ordersReceived: Natural with {
        briefly "Received"
        described as {
          |Orders received.
        }
      }
      ordersShipped: Natural with {
        briefly "Shipped"
        described as {
          |Orders shipped.
        }
      }
      ordersDelivered: Natural with {
        briefly "Delivered"
        described as {
          |Orders delivered.
        }
      }
      ordersFailed: Natural with {
        briefly "Failed"
        described as {
          |Orders with failed delivery.
        }
      }
      averageFulfillmentTime: Decimal(8,2) with {
        briefly "Avg time"
        described as {
          |Average fulfillment hours.
        }
      }
    } with {
      briefly "Order metrics"
      described as {
        |Fulfillment processing metrics.
      }
    }
    handler MetricsHandler is {
      on event FulfillmentOrder.FulfillmentOrderCreated is {
        tell event FulfillmentOrder.FulfillmentOrderCreated to repository FulfillmentContext.FulfillmentRepository
      }
      on event FulfillmentOrder.OrderShipped is {
        tell event FulfillmentOrder.OrderShipped to repository FulfillmentContext.FulfillmentRepository
      }
      on event FulfillmentOrder.DeliveryConfirmed is {
        tell event FulfillmentOrder.DeliveryConfirmed to repository FulfillmentContext.FulfillmentRepository
      }
      on event FulfillmentOrder.DeliveryFailed is {
        tell event FulfillmentOrder.DeliveryFailed to repository FulfillmentContext.FulfillmentRepository
      }
    } with {
      briefly "Maintains fulfillment metrics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Fulfillment metrics"
    described as {
      |Order fulfillment analytics.
    }
  }
  type FulfillmentOrderEvent is one of {
    FulfillmentContext.FulfillmentOrder.FulfillmentOrderCreated,
    FulfillmentContext.FulfillmentOrder.OrderShipped,
    FulfillmentContext.FulfillmentOrder.DeliveryConfirmed
  } with {
    briefly "FulfillmentOrder event union"
    described as {
      |Union of FulfillmentOrder events for streaming.
    }
  }
  processor FulfillmentOrderEventSource as source is {
    outlet FulfillmentOrderEvents is type FulfillmentOrderEvent
    handler FulfillmentOrderEventEmitter is {
      on init is { tell command FulfillmentOrder.InitializeFulfillmentOrder to entity FulfillmentContext.FulfillmentOrder }
      on other is {
        error "Unexpected message for source FulfillmentOrderEventSource"
      }
      on event FulfillmentOrder.FulfillmentOrderCreated is {
        send event FulfillmentOrder.FulfillmentOrderCreated to outlet FulfillmentOrderEvents
      }
      on event FulfillmentOrder.OrderShipped is {
        send event FulfillmentOrder.OrderShipped to outlet FulfillmentOrderEvents
      }
      on event FulfillmentOrder.DeliveryConfirmed is {
        send event FulfillmentOrder.DeliveryConfirmed to outlet FulfillmentOrderEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits FulfillmentOrder events to the stream.
      }
    }
  } with {
    briefly "FulfillmentOrder event source"
    described as {
      |Publishes FulfillmentOrder events to the event stream.
    }
  }
  processor FulfillmentOrderEventSink as sink is {
    inlet IncomingFulfillmentOrderEvents is type FulfillmentOrderEvent
    handler FulfillmentOrderEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink FulfillmentOrderEventSink"
      }
      on event FulfillmentOrder.FulfillmentOrderCreated is {
        tell event FulfillmentOrder.FulfillmentOrderCreated to repository FulfillmentContext.FulfillmentRepository
      }
      on event FulfillmentOrder.OrderShipped is {
        tell event FulfillmentOrder.OrderShipped to repository FulfillmentContext.FulfillmentRepository
      }
      on event FulfillmentOrder.DeliveryConfirmed is {
        tell event FulfillmentOrder.DeliveryConfirmed to repository FulfillmentContext.FulfillmentRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives FulfillmentOrder events for persistence.
      }
    }
  } with {
    briefly "FulfillmentOrder event sink"
    described as {
      |Receives FulfillmentOrder events from streaming.
    }
  }
  connector FulfillmentOrderEventPipeline is {
    from outlet FulfillmentContext.FulfillmentOrderEventSource.FulfillmentOrderEvents to inlet FulfillmentContext.FulfillmentOrderEventSink.IncomingFulfillmentOrderEvents
  } with {
    briefly "FulfillmentOrder event pipeline"
    described as {
      |Wires FulfillmentOrder event source to sink.
    }
  }
  processor FulfillmentOrderEventSplit is {
    inlet FulfillmentOrderEventSplitIn is type FulfillmentOrderEvent
    outlet FulfillmentOrderEventSplitToFulfillmentRepository is type FulfillmentOrderEvent
    outlet FulfillmentOrderEventSplitToFulfillmentMetrics is type FulfillmentOrderEvent
    handler FulfillmentOrderEventSplitHandler is {
      on event FulfillmentOrder.FulfillmentOrderCreated is {
        send event FulfillmentOrder.FulfillmentOrderCreated to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send event FulfillmentOrder.FulfillmentOrderCreated to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell event FulfillmentOrder.FulfillmentOrderCreated to entity FulfillmentContext.FulfillmentOrder
      }
      on event FulfillmentOrder.InventoryAllocated is {
        send event FulfillmentOrder.InventoryAllocated to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send event FulfillmentOrder.InventoryAllocated to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell event FulfillmentOrder.InventoryAllocated to entity FulfillmentContext.FulfillmentOrder
      }
      on event FulfillmentOrder.ItemPicked is {
        send event FulfillmentOrder.ItemPicked to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send event FulfillmentOrder.ItemPicked to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell event FulfillmentOrder.ItemPicked to entity FulfillmentContext.FulfillmentOrder
      }
      on event FulfillmentOrder.OrderPacked is {
        send event FulfillmentOrder.OrderPacked to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send event FulfillmentOrder.OrderPacked to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell event FulfillmentOrder.OrderPacked to entity FulfillmentContext.FulfillmentOrder
      }
      on event FulfillmentOrder.CarrierSelected is {
        send event FulfillmentOrder.CarrierSelected to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send event FulfillmentOrder.CarrierSelected to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell event FulfillmentOrder.CarrierSelected to entity FulfillmentContext.FulfillmentOrder
      }
      on event FulfillmentOrder.ShippingLabelCreated is {
        send event FulfillmentOrder.ShippingLabelCreated to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send event FulfillmentOrder.ShippingLabelCreated to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell event FulfillmentOrder.ShippingLabelCreated to entity FulfillmentContext.FulfillmentOrder
      }
      on event FulfillmentOrder.OrderShipped is {
        send event FulfillmentOrder.OrderShipped to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send event FulfillmentOrder.OrderShipped to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell event FulfillmentOrder.OrderShipped to entity FulfillmentContext.FulfillmentOrder
      }
      on event FulfillmentOrder.ShipmentStatusUpdated is {
        send event FulfillmentOrder.ShipmentStatusUpdated to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send event FulfillmentOrder.ShipmentStatusUpdated to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell event FulfillmentOrder.ShipmentStatusUpdated to entity FulfillmentContext.FulfillmentOrder
      }
      on event FulfillmentOrder.DeliveryConfirmed is {
        send event FulfillmentOrder.DeliveryConfirmed to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send event FulfillmentOrder.DeliveryConfirmed to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell event FulfillmentOrder.DeliveryConfirmed to entity FulfillmentContext.FulfillmentOrder
      }
      on event FulfillmentOrder.DeliveryFailed is {
        send event FulfillmentOrder.DeliveryFailed to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send event FulfillmentOrder.DeliveryFailed to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell event FulfillmentOrder.DeliveryFailed to entity FulfillmentContext.FulfillmentOrder
      }
      on event FulfillmentOrder.FulfillmentCancelled is {
        send event FulfillmentOrder.FulfillmentCancelled to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send event FulfillmentOrder.FulfillmentCancelled to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell event FulfillmentOrder.FulfillmentCancelled to entity FulfillmentContext.FulfillmentOrder
      }
      on other is {
        error "Unexpected message for processor FulfillmentOrderEventSplit"
      }
    } with {
      briefly "FulfillmentOrder event fan-out handler"
      described as {
        |Delivers each FulfillmentOrder event to all of its consumers.
      }
    }
  } with {
    briefly "FulfillmentOrder event fan-out"
    described as {
      |Fans FulfillmentOrder events out to the repository and projectors.
    }
  }
  connector LinkFulfillmentOrderToFulfillmentOrderEventSplit is {
    from outlet FulfillmentContext.FulfillmentOrder.FulfillmentOrderEvents2 to
      inlet FulfillmentContext.FulfillmentOrderEventSplit.FulfillmentOrderEventSplitIn
  } with {
    briefly "LinkFulfillmentOrderToFulfillmentOrderEventSplit"
  }
  connector LinkFulfillmentOrderEventSplitToFulfillmentRepository is {
    from outlet FulfillmentContext.FulfillmentOrderEventSplit.FulfillmentOrderEventSplitToFulfillmentRepository to
      inlet FulfillmentContext.FulfillmentRepository.FulfillmentRepositoryFromFulfillmentOrder
  } with {
    briefly "LinkFulfillmentOrderEventSplitToFulfillmentRepository"
  }
  connector LinkFulfillmentOrderEventSplitToFulfillmentMetrics is {
    from outlet FulfillmentContext.FulfillmentOrderEventSplit.FulfillmentOrderEventSplitToFulfillmentMetrics to
      inlet FulfillmentContext.FulfillmentMetrics.FulfillmentMetricsFromFulfillmentOrder
  } with {
    briefly "LinkFulfillmentOrderEventSplitToFulfillmentMetrics"
  }
  connector LinkFulfillmentMetricsToFulfillmentRepository is {
    from outlet FulfillmentContext.FulfillmentMetrics.FulfillmentMetricsOut to
      inlet FulfillmentContext.FulfillmentRepository.FulfillmentRepositoryFromFulfillmentMetrics
  } with {
    briefly "LinkFulfillmentMetricsToFulfillmentRepository"
  }
} with {
  briefly "Bounded context for order fulfillment"
  described as {
    |Order fulfillment operations context.
  }
}
