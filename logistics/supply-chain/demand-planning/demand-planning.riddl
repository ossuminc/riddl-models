// Demand Planning Domain Model
// Supply chain demand forecasting and planning
domain DemandPlanning is {
  persistent connector 'ERPIntegrationEvent Stream' is from outlet ERPIntegration.ERPIntegrationEventsOut to inlet ForecastContext.FromERPIntegration.FromERPIntegrationIn with {
    briefly "What ERPIntegration tells ForecastContext, unasked"
  }
  persistent connector 'ForecastingEngineEvent Stream' is from outlet ForecastingEngine.ForecastingEngineEventsOut to inlet ForecastContext.FromForecastingEngine.FromForecastingEngineIn with {
    briefly "What ForecastingEngine tells ForecastContext, unasked"
  }
  persistent connector 'MarketIntelligenceEvent Stream' is from outlet MarketIntelligence.MarketIntelligenceEventsOut to inlet ForecastContext.FromMarketIntelligence.FromMarketIntelligenceIn with {
    briefly "What MarketIntelligence tells ForecastContext, unasked"
  }
  persistent connector 'SalesInputEvent Stream' is from outlet SalesInput.SalesInputEventsOut to inlet ForecastContext.FromSalesInput.FromSalesInputIn with {
    briefly "What SalesInput tells ForecastContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user DemandPlanner is "person managing demand forecasts" with {
    briefly "Demand Planner"
    described as {
      |Creates and adjusts demand forecasts.
    }
  }
  user SupplyChainManager is "person overseeing supply chain" with {
    briefly "Supply Chain Manager"
    described as {
      |Manages overall supply chain operations.
    }
  }
  user SalesRep is "person providing sales input" with {
    briefly "Sales Representative"
    described as {
      |Provides sales intelligence for forecasts.
    }
  }
  epic DemandForecasting is {
    user DemandPlanner wants to "to create accurate demand forecasts" so that "inventory and production can be optimized"
    case CreateForecastUseCase is {
      user DemandPlanner wants to "to generate demand forecast" so that "future demand is predicted accurately"
      step is "System analyzes" "historical data" "and trends" with {
        briefly "Analyze history"
        described as {
          |Review past demand.
        }
      }
      step is "System generates" "forecast" "with confidence intervals" with {
        briefly "Generate forecast"
        described as {
          |Predict demand.
        }
      }
    } with {
      briefly "Create forecast"
      described as {
        |Demand forecast generation.
      }
    }
  } with {
    briefly "Demand forecasting"
    described as {
      |Epic for demand planning.
    }
  }
  include "ForecastContext.riddl"
  include "external-contexts.riddl"
  application context DemandPlanningApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in DemandPlanning are delivered.
      }
    }
    group DemandPlanningScreen is {
      input GetPlanningMetricsInput acquires query ForecastContext.GetPlanningMetrics with {
        briefly "Get planning metrics control"
        described as {
          |The control through which a user asks the get planning metrics question.
        }
      }
      input GetForecastInput acquires query ForecastContext.Forecast.GetForecast with {
        briefly "Get forecast control"
        described as {
          |The control through which a user asks the get forecast question.
        }
      }
      input CreateForecastInput acquires command ForecastContext.CreateForecast with {
        briefly "Create forecast control"
        described as {
          |The control through which a user submits the create forecast request.
        }
      }
      input ActivateForecastInput acquires command ForecastContext.Forecast.ActivateForecast with {
        briefly "Activate forecast control"
        described as {
          |The control through which a user submits the activate forecast request.
        }
      }
      input AddLocationForecastInput acquires command ForecastContext.Forecast.AddLocationForecast with {
        briefly "Add location forecast control"
        described as {
          |The control through which a user submits the add location forecast request.
        }
      }
      input AdjustForecastInput acquires command ForecastContext.Forecast.AdjustForecast with {
        briefly "Adjust forecast control"
        described as {
          |The control through which a user submits the adjust forecast request.
        }
      }
      input ApproveForecastInput acquires command ForecastContext.Forecast.ApproveForecast with {
        briefly "Approve forecast control"
        described as {
          |The control through which a user submits the approve forecast request.
        }
      }
      input ArchiveForecastInput acquires command ForecastContext.Forecast.ArchiveForecast with {
        briefly "Archive forecast control"
        described as {
          |The control through which a user submits the archive forecast request.
        }
      }
      input CalculateAccuracyInput acquires command ForecastContext.Forecast.CalculateAccuracy with {
        briefly "Calculate accuracy control"
        described as {
          |The control through which a user submits the calculate accuracy request.
        }
      }
      input SubmitForReviewInput acquires command ForecastContext.Forecast.SubmitForReview with {
        briefly "Submit for review control"
        described as {
          |The control through which a user submits the submit for review request.
        }
      }
      input SupersedeForecastInput acquires command ForecastContext.Forecast.SupersedeForecast with {
        briefly "Supersede forecast control"
        described as {
          |The control through which a user submits the supersede forecast request.
        }
      }
    } with {
      briefly "Demand planning screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppForecastRepositoryQueries is query ForecastContext.GetPlanningMetrics
    inlet AppForecastRepositoryReplies is result ForecastContext.PlanningMetricsView
    outlet AppForecastQueries is query ForecastContext.Forecast.GetForecast
    outlet AppForecastCommands is type ForecastContext.ForecastRequest
    inlet AppForecastRepositoryResponses is result ForecastContext.Forecast.ForecastResult
    handler DemandPlanningAppHandler is {
      on other is {
        error "Unexpected message for application context DemandPlanningApp"
      }
    } with {
      briefly "DemandPlanningApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "DemandPlanningApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'SalesInputRequest Stream' is from outlet ForecastContext.ToSalesInput.ToSalesInputOut to inlet SalesInput.SalesInputRequests with {
    briefly "What ForecastContext asks SalesInput to send"
  }
  persistent connector 'ForecastingEngineRequest Stream' is from outlet ForecastContext.ToForecastingEngine.ToForecastingEngineOut to inlet ForecastingEngine.ForecastingEngineRequests with {
    briefly "What ForecastContext asks ForecastingEngine to send"
  }
  persistent connector 'MarketIntelligenceRequest Stream' is from outlet ForecastContext.ToMarketIntelligence.ToMarketIntelligenceOut to inlet MarketIntelligence.MarketIntelligenceRequests with {
    briefly "What ForecastContext asks MarketIntelligence to send"
  }
  persistent connector 'ERPIntegrationRequest Stream' is from outlet ForecastContext.ToERPIntegration.ToERPIntegrationOut to inlet ERPIntegration.ERPIntegrationRequests with {
    briefly "What ForecastContext asks ERPIntegration to send"
  }
  persistent connector 'ForecastRepositoryQuery Stream' is from outlet DemandPlanningApp.AppForecastRepositoryQueries to inlet ForecastContext.ForecastRepositoryQueriesIn with {
    briefly "DemandPlanningApp's look-ups of the forecast repository"
  }
  persistent connector 'ForecastRepositoryReply Stream' is from outlet ForecastContext.ForecastRepositoryRepliesOut to inlet DemandPlanningApp.AppForecastRepositoryReplies with {
    briefly "The forecast repository's answers returned to DemandPlanningApp"
  }
  persistent connector 'ForecastQuery Stream' is from outlet DemandPlanningApp.AppForecastQueries to inlet ForecastContext.ForecastQueriesIn with {
    briefly "DemandPlanningApp's look-ups of the forecast"
  }
  persistent connector 'ForecastCommand Stream' is from outlet DemandPlanningApp.AppForecastCommands to inlet ForecastContext.ForecastCommandStreamIn with {
    briefly "Forecast commands from the application"
  }
  persistent connector 'ForecastResult Stream' is from outlet ForecastContext.ForecastResultStreamOut to inlet DemandPlanningApp.AppForecastRepositoryResponses with {
    briefly "Forecast query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet DemandPlanningApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Demand planning domain"
  described as {
    |Supply chain demand forecasting.
  }
}
