// Demand Planning - Forecast Context
context ForecastContext as router is {
  inlet ForecastCommandStreamIn is type ForecastCommand  outlet ForecastCommandStreamOut is type ForecastCommand
  inlet ForecastResultStreamIn is type Forecast.ForecastResult  outlet ForecastResultStreamOut is type Forecast.ForecastResult
  handler ForecastContextBoundary is {
    on createForecast: command Forecast.CreateForecast is {
      send createForecast to outlet ForecastContext.ForecastCommandStreamOut
    }
    on generateStatisticalForecast: command Forecast.GenerateStatisticalForecast is {
      send generateStatisticalForecast to outlet ForecastContext.ForecastCommandStreamOut
    }
    on addLocationForecast: command Forecast.AddLocationForecast is {
      send addLocationForecast to outlet ForecastContext.ForecastCommandStreamOut
    }
    on adjustForecast: command Forecast.AdjustForecast is {
      send adjustForecast to outlet ForecastContext.ForecastCommandStreamOut
    }
    on addConsensusInput: command Forecast.AddConsensusInput is {
      send addConsensusInput to outlet ForecastContext.ForecastCommandStreamOut
    }
    on submitForReview: command Forecast.SubmitForReview is {
      send submitForReview to outlet ForecastContext.ForecastCommandStreamOut
    }
    on approveForecast: command Forecast.ApproveForecast is {
      send approveForecast to outlet ForecastContext.ForecastCommandStreamOut
    }
    on activateForecast: command Forecast.ActivateForecast is {
      send activateForecast to outlet ForecastContext.ForecastCommandStreamOut
    }
    on recordActuals: command Forecast.RecordActuals is {
      send recordActuals to outlet ForecastContext.ForecastCommandStreamOut
    }
    on calculateAccuracy: command Forecast.CalculateAccuracy is {
      send calculateAccuracy to outlet ForecastContext.ForecastCommandStreamOut
    }
    on supersedeForecast: command Forecast.SupersedeForecast is {
      send supersedeForecast to outlet ForecastContext.ForecastCommandStreamOut
    }
    on archiveForecast: command Forecast.ArchiveForecast is {
      send archiveForecast to outlet ForecastContext.ForecastCommandStreamOut
    }
    on initializeForecast: command Forecast.InitializeForecast is {
      send initializeForecast to outlet ForecastContext.ForecastCommandStreamOut
    }
    on forecastResult: result Forecast.ForecastResult is {
      send forecastResult to outlet ForecastContext.ForecastResultStreamOut
    }
    on other is {
      error "Unexpected message at the ForecastContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ForecastCommand Stream Intake' is from outlet ForecastContext.ForecastCommandStreamOut to inlet ForecastContext.Forecast.ForecastCommands  connector 'ForecastResult Stream Egress' is from outlet ForecastContext.ForecastRepository.ForecastRepositoryResponses to inlet ForecastContext.ForecastResultStreamIn  adaptor FromERPIntegration from context ERPIntegration is { 
    handler FromERPIntegrationHandler is {
      on event ERPIntegration.ForecastPublished is {
        do "the model receives forecast published"
      }
      on event ERPIntegration.HistoricalDemandFetched is {
        do "the model receives historical demand fetched"
      }
      on other is {
        error "Unexpected message for adaptor FromERPIntegration"
      }
    } with {
      briefly "from erp integration"
      described as {
        |Carries messages from the external ERPIntegration.
      }
    }
  } with {
    briefly "ERPIntegration integration"
    described as {
      |The model's side of the ERPIntegration conversation.
    }
  }
  adaptor ToERPIntegration to context ERPIntegration is { 
    handler ToERPIntegrationHandler is {
      on command ERPIntegration.FetchHistoricalDemand is {
        do "the model sends fetch historical demand"
      }
      on command ERPIntegration.PublishForecast is {
        do "the model sends publish forecast"
      }
      on other is {
        error "Unexpected message for adaptor ToERPIntegration"
      }
    } with {
      briefly "to erp integration"
      described as {
        |Carries messages to the external ERPIntegration.
      }
    }
  } with {
    briefly "ERPIntegration integration"
    described as {
      |The model's side of the ERPIntegration conversation.
    }
  }
  adaptor FromForecastingEngine from context ForecastingEngine is { 
    handler FromForecastingEngineHandler is {
      on event ForecastingEngine.MLForecastGenerated is {
        do "the model receives ml forecast generated"
      }
      on event ForecastingEngine.TimeSeriesAnalysisComplete is {
        do "the model receives time series analysis complete"
      }
      on other is {
        error "Unexpected message for adaptor FromForecastingEngine"
      }
    } with {
      briefly "from forecasting engine"
      described as {
        |Carries messages from the external ForecastingEngine.
      }
    }
  } with {
    briefly "ForecastingEngine integration"
    described as {
      |The model's side of the ForecastingEngine conversation.
    }
  }
  adaptor ToForecastingEngine to context ForecastingEngine is { 
    handler ToForecastingEngineHandler is {
      on command ForecastingEngine.GenerateMLForecast is {
        do "the model sends generate ml forecast"
      }
      on command ForecastingEngine.RunTimeSeriesAnalysis is {
        do "the model sends run time series analysis"
      }
      on other is {
        error "Unexpected message for adaptor ToForecastingEngine"
      }
    } with {
      briefly "to forecasting engine"
      described as {
        |Carries messages to the external ForecastingEngine.
      }
    }
  } with {
    briefly "ForecastingEngine integration"
    described as {
      |The model's side of the ForecastingEngine conversation.
    }
  }
  adaptor FromMarketIntelligence from context MarketIntelligence is { 
    handler FromMarketIntelligenceHandler is {
      on event MarketIntelligence.CompetitorActivityReceived is {
        do "the model receives competitor activity received"
      }
      on event MarketIntelligence.MarketTrendsReceived is {
        do "the model receives market trends received"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketIntelligence"
      }
    } with {
      briefly "from market intelligence"
      described as {
        |Carries messages from the external MarketIntelligence.
      }
    }
  } with {
    briefly "MarketIntelligence integration"
    described as {
      |The model's side of the MarketIntelligence conversation.
    }
  }
  adaptor ToMarketIntelligence to context MarketIntelligence is { 
    handler ToMarketIntelligenceHandler is {
      on command MarketIntelligence.GetCompetitorActivity is {
        do "the model sends get competitor activity"
      }
      on command MarketIntelligence.GetMarketTrends is {
        do "the model sends get market trends"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketIntelligence"
      }
    } with {
      briefly "to market intelligence"
      described as {
        |Carries messages to the external MarketIntelligence.
      }
    }
  } with {
    briefly "MarketIntelligence integration"
    described as {
      |The model's side of the MarketIntelligence conversation.
    }
  }
  adaptor FromSalesInput from context SalesInput is { 
    handler FromSalesInputHandler is {
      on event SalesInput.SalesForecastReceived is {
        do "the model receives sales forecast received"
      }
      on event SalesInput.SalesForecastRequested is {
        do "the model receives sales forecast requested"
      }
      on other is {
        error "Unexpected message for adaptor FromSalesInput"
      }
    } with {
      briefly "from sales input"
      described as {
        |Carries messages from the external SalesInput.
      }
    }
  } with {
    briefly "SalesInput integration"
    described as {
      |The model's side of the SalesInput conversation.
    }
  }
  adaptor ToSalesInput to context SalesInput is { 
    handler ToSalesInputHandler is {
      on command SalesInput.RequestSalesForecast is {
        do "the model sends request sales forecast"
      }
      on other is {
        error "Unexpected message for adaptor ToSalesInput"
      }
    } with {
      briefly "to sales input"
      described as {
        |Carries messages to the external SalesInput.
      }
    }
  } with {
    briefly "SalesInput integration"
    described as {
      |The model's side of the SalesInput conversation.
    }
  }
  include "types.riddl"
  include "Forecast.riddl"
  repository ForecastRepository as merge is {
    command PersistAccuracyCalculated is  {
      forecastId: ForecastId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccuracyCalculated applies to.
        }
      }
    } with {
      briefly "Persist AccuracyCalculated"
      described as {
        |Instructs this repository to apply AccuracyCalculated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistForecastActivated is  {
      forecastId: ForecastId with {
        briefly "Row addressed"
        described as {
          |Which stored row ForecastActivated applies to.
        }
      }
    } with {
      briefly "Persist ForecastActivated"
      described as {
        |Instructs this repository to apply ForecastActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistForecastAdjusted is  {
      forecastId: ForecastId with {
        briefly "Row addressed"
        described as {
          |Which stored row ForecastAdjusted applies to.
        }
      }
    } with {
      briefly "Persist ForecastAdjusted"
      described as {
        |Instructs this repository to apply ForecastAdjusted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistForecastCreated is  {
      forecastId: ForecastId with {
        briefly "Row addressed"
        described as {
          |Which stored row ForecastCreated applies to.
        }
      }
    } with {
      briefly "Persist ForecastCreated"
      described as {
        |Instructs this repository to apply ForecastCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet ForecastRepositoryFromForecast is type ForecastEvent    inlet ForecastRepositoryFromForecastAnalytics is type ForecastEvent    outlet ForecastRepositoryResponses is type Forecast.ForecastResult
    record StoredForecast is  {
      forecastId: ForecastId with {
        briefly "forecastId"
        described as {
          |The forecastId column of the stored forecast row.
        }
      }
      horizon: PlanningHorizon with {
        briefly "horizon"
        described as {
          |The horizon column of the stored forecast row.
        }
      }
      method: ForecastMethod with {
        briefly "method"
        described as {
          |The method column of the stored forecast row.
        }
      }
      status: ForecastStatus with {
        briefly "status"
        described as {
          |The status column of the stored forecast row.
        }
      }
    } with {
      briefly "Stored forecast row"
      described as {
        |The persistence shape of forecast data as this repository stores it.
      }
    }
    schema ForecastData is relational
      of forecasts as type StoredForecast
        index on field StoredForecast.status
        index on field StoredForecast.horizon.startDate
        index on field StoredForecast.method
 with {
      briefly "Forecast data schema"
      described as {
        |The relational schema holding forecast data for the ForecastRepository.
      }
    }
    handler ForecastPersistence is {
      on persistAccuracyCalculated: command PersistAccuracyCalculated is {
        do "apply AccuracyCalculated to the stored row"
      }
      on persistForecastActivated: command PersistForecastActivated is {
        do "apply ForecastActivated to the stored row"
      }
      on persistForecastAdjusted: command PersistForecastAdjusted is {
        do "apply ForecastAdjusted to the stored row"
      }
      on persistForecastCreated: command PersistForecastCreated is {
        do "apply ForecastCreated to the stored row"
      }
      on query GetPlanningMetrics is {
        let planningMetricsView: type PlanningMetricsView = prompt("read the planning metrics projection")
        reply planningMetricsView
      }
      on createForecast: command Forecast.CreateForecast is {
        tell event Forecast.ForecastCreated(forecastId = createForecast.forecastId, name = createForecast.name, horizon = createForecast.horizon, method = createForecast.method) to entity ForecastContext.Forecast
      }
      on generateStatisticalForecast: command Forecast.GenerateStatisticalForecast is {
        tell event Forecast.StatisticalForecastGenerated(forecastId = generateStatisticalForecast.forecastId) to entity ForecastContext.Forecast
      }
      on addLocationForecast: command Forecast.AddLocationForecast is {
        tell event Forecast.LocationForecastAdded(forecastId = addLocationForecast.forecastId) to entity ForecastContext.Forecast
      }
      on adjustForecast: command Forecast.AdjustForecast is {
        tell event Forecast.ForecastAdjusted(forecastId = adjustForecast.forecastId, adjustment = adjustForecast.adjustment) to entity ForecastContext.Forecast
      }
      on addConsensusInput: command Forecast.AddConsensusInput is {
        tell event Forecast.ConsensusInputAdded(forecastId = addConsensusInput.forecastId, input = addConsensusInput.input) to entity ForecastContext.Forecast
      }
      on approveForecast: command Forecast.ApproveForecast is {
        tell event Forecast.ForecastApproved(forecastId = approveForecast.forecastId, approvedBy = approveForecast.approvedBy) to entity ForecastContext.Forecast
      }
      on activateForecast: command Forecast.ActivateForecast is {
        tell event Forecast.ForecastActivated(forecastId = activateForecast.forecastId, activatedBy = activateForecast.activatedBy) to entity ForecastContext.Forecast
      }
      on calculateAccuracy: command Forecast.CalculateAccuracy is {
        tell event Forecast.AccuracyCalculated(forecastId = calculateAccuracy.forecastId) to entity ForecastContext.Forecast
      }
      on archiveForecast: command Forecast.ArchiveForecast is {
        tell event Forecast.ForecastArchived(forecastId = archiveForecast.forecastId) to entity ForecastContext.Forecast
      }
    } with {
      briefly "Persists forecast commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Forecast data persistence"
    described as {
      |Persistent storage for forecasts.
    }
  }
  query GetPlanningMetrics is  {
    planningMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which planning metrics to retrieve.
      }
    }
  } with {
    briefly "Get planning metrics"
    described as {
      |Retrieves the planning metrics projection.
    }
  }
  result PlanningMetricsView is  {
    planningMetrics: ForecastAnalytics.PlanningMetrics with {
      briefly "Planning metrics"
      described as {
        |The planning metrics being returned.
      }
    }
  } with {
    briefly "Planning metrics view"
    described as {
      |Read model view carrying the planning metrics projection.
    }
  }
  projector ForecastAnalytics as flow is {
    updates repository ForecastContext.ForecastRepository
    inlet ForecastAnalyticsFromForecast is type ForecastEvent    outlet ForecastAnalyticsOut is type ForecastEvent
    record PlanningMetrics is  {
      activeForecastCount: Natural with {
        briefly "Active"
        described as {
          |Active forecasts.
        }
      }
      averageMAPE: Decimal(5,2) with {
        briefly "Avg MAPE"
        described as {
          |Average MAPE.
        }
      }
      bestPerformingMethod: String(1,50) with {
        briefly "Best method"
        described as {
          |Best method.
        }
      }
      totalAdjustmentCount: Natural with {
        briefly "Adjustments"
        described as {
          |Total adjustments.
        }
      }
      consensusAccuracy: Decimal(5,2) with {
        briefly "Consensus"
        described as {
          |Consensus accuracy.
        }
      }
    } with {
      briefly "Planning metrics"
      described as {
        |Demand planning metrics.
      }
    }
    handler AnalyticsHandler is {
      on forecastCreated: event Forecast.ForecastCreated is {
        tell command ForecastContext.ForecastRepository.PersistForecastCreated(forecastId = forecastCreated.forecastId) to repository ForecastContext.ForecastRepository
      }
      on forecastActivated: event Forecast.ForecastActivated is {
        tell command ForecastContext.ForecastRepository.PersistForecastActivated(forecastId = forecastActivated.forecastId) to repository ForecastContext.ForecastRepository
      }
      on accuracyCalculated: event Forecast.AccuracyCalculated is {
        tell command ForecastContext.ForecastRepository.PersistAccuracyCalculated(forecastId = accuracyCalculated.forecastId) to repository ForecastContext.ForecastRepository
      }
      on forecastAdjusted: event Forecast.ForecastAdjusted is {
        tell command ForecastContext.ForecastRepository.PersistForecastAdjusted(forecastId = forecastAdjusted.forecastId) to repository ForecastContext.ForecastRepository
      }
    } with {
      briefly "Maintains planning analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Forecast analytics"
    described as {
      |Demand planning performance.
    }
  }
  type ForecastEvent is one of {
    ForecastContext.Forecast.ForecastCreated or ForecastContext.Forecast.ForecastActivated or ForecastContext.Forecast.ForecastArchived or ForecastContext.Forecast.AccuracyCalculated or ForecastContext.Forecast.ActualsRecorded or ForecastContext.Forecast.ConsensusInputAdded or ForecastContext.Forecast.ForecastAdjusted or ForecastContext.Forecast.ForecastApproved or ForecastContext.Forecast.ForecastSubmittedForReview or ForecastContext.Forecast.ForecastSuperseded or ForecastContext.Forecast.LocationForecastAdded or ForecastContext.Forecast.StatisticalForecastGenerated
  } with {
    briefly "Forecast event union"
    described as {
      |Union of Forecast events for streaming.
    }
  }
  processor ForecastEventSource as source is {
    outlet ForecastEvents is type ForecastEvent
    handler ForecastEventEmitter is {
      on init is {
        let initializeForecast: type Forecast.InitializeForecast = prompt("the initialize forecast that brings this this into existence")
        tell initializeForecast to entity ForecastContext.Forecast
      }
      on other is {
        error "Unexpected message for source ForecastEventSource"
      }
      on forecastCreated: event Forecast.ForecastCreated is {
        send forecastCreated to outlet ForecastEvents
      }
      on forecastActivated: event Forecast.ForecastActivated is {
        send forecastActivated to outlet ForecastEvents
      }
      on forecastArchived: event Forecast.ForecastArchived is {
        send forecastArchived to outlet ForecastEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits Forecast events to the stream.
      }
    }
  } with {
    briefly "Forecast event source"
    described as {
      |Publishes Forecast events to the event stream.
    }
  }
  processor ForecastEventSink as sink is {
    inlet IncomingForecastEvents is type ForecastEvent    handler ForecastEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink ForecastEventSink"
      }
      on forecastCreated: event Forecast.ForecastCreated is {
        tell forecastCreated to repository ForecastContext.ForecastRepository
      }
      on forecastActivated: event Forecast.ForecastActivated is {
        tell forecastActivated to repository ForecastContext.ForecastRepository
      }
      on forecastArchived: event Forecast.ForecastArchived is {
        tell forecastArchived to repository ForecastContext.ForecastRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives Forecast events for persistence.
      }
    }
  } with {
    briefly "Forecast event sink"
    described as {
      |Receives Forecast events from streaming.
    }
  }
  connector ForecastEventPipeline is from outlet ForecastContext.ForecastEventSource.ForecastEvents to inlet ForecastContext.ForecastEventSink.IncomingForecastEvents with {
    briefly "Forecast event pipeline"
    described as {
      |Wires Forecast event source to sink.
    }
  }
  processor ForecastEventSplit as split is {
    inlet ForecastEventSplitIn is type ForecastEvent    outlet ForecastEventSplitToForecastRepository is type ForecastEvent
    outlet ForecastEventSplitToForecastAnalytics is type ForecastEvent
    handler ForecastEventSplitHandler is {
      on forecastCreated: event Forecast.ForecastCreated is {
        send forecastCreated to outlet ForecastEventSplitToForecastRepository
        send forecastCreated to outlet ForecastEventSplitToForecastAnalytics
        tell forecastCreated to entity ForecastContext.Forecast
      }
      on statisticalForecastGenerated: event Forecast.StatisticalForecastGenerated is {
        send statisticalForecastGenerated to outlet ForecastEventSplitToForecastRepository
        send statisticalForecastGenerated to outlet ForecastEventSplitToForecastAnalytics
        tell statisticalForecastGenerated to entity ForecastContext.Forecast
      }
      on locationForecastAdded: event Forecast.LocationForecastAdded is {
        send locationForecastAdded to outlet ForecastEventSplitToForecastRepository
        send locationForecastAdded to outlet ForecastEventSplitToForecastAnalytics
        tell locationForecastAdded to entity ForecastContext.Forecast
      }
      on forecastAdjusted: event Forecast.ForecastAdjusted is {
        send forecastAdjusted to outlet ForecastEventSplitToForecastRepository
        send forecastAdjusted to outlet ForecastEventSplitToForecastAnalytics
        tell forecastAdjusted to entity ForecastContext.Forecast
      }
      on consensusInputAdded: event Forecast.ConsensusInputAdded is {
        send consensusInputAdded to outlet ForecastEventSplitToForecastRepository
        send consensusInputAdded to outlet ForecastEventSplitToForecastAnalytics
        tell consensusInputAdded to entity ForecastContext.Forecast
      }
      on forecastSubmittedForReview: event Forecast.ForecastSubmittedForReview is {
        send forecastSubmittedForReview to outlet ForecastEventSplitToForecastRepository
        send forecastSubmittedForReview to outlet ForecastEventSplitToForecastAnalytics
        tell forecastSubmittedForReview to entity ForecastContext.Forecast
      }
      on forecastApproved: event Forecast.ForecastApproved is {
        send forecastApproved to outlet ForecastEventSplitToForecastRepository
        send forecastApproved to outlet ForecastEventSplitToForecastAnalytics
        tell forecastApproved to entity ForecastContext.Forecast
      }
      on forecastActivated: event Forecast.ForecastActivated is {
        send forecastActivated to outlet ForecastEventSplitToForecastRepository
        send forecastActivated to outlet ForecastEventSplitToForecastAnalytics
        tell forecastActivated to entity ForecastContext.Forecast
      }
      on actualsRecorded: event Forecast.ActualsRecorded is {
        send actualsRecorded to outlet ForecastEventSplitToForecastRepository
        send actualsRecorded to outlet ForecastEventSplitToForecastAnalytics
        tell actualsRecorded to entity ForecastContext.Forecast
      }
      on accuracyCalculated: event Forecast.AccuracyCalculated is {
        send accuracyCalculated to outlet ForecastEventSplitToForecastRepository
        send accuracyCalculated to outlet ForecastEventSplitToForecastAnalytics
        tell accuracyCalculated to entity ForecastContext.Forecast
      }
      on forecastSuperseded: event Forecast.ForecastSuperseded is {
        send forecastSuperseded to outlet ForecastEventSplitToForecastRepository
        send forecastSuperseded to outlet ForecastEventSplitToForecastAnalytics
        tell forecastSuperseded to entity ForecastContext.Forecast by forecastId
      }
      on forecastArchived: event Forecast.ForecastArchived is {
        send forecastArchived to outlet ForecastEventSplitToForecastRepository
        send forecastArchived to outlet ForecastEventSplitToForecastAnalytics
        tell forecastArchived to entity ForecastContext.Forecast
      }
      on other is {
        error "Unexpected message for processor ForecastEventSplit"
      }
    } with {
      briefly "Forecast event fan-out handler"
      described as {
        |Delivers each Forecast event to all of its consumers.
      }
    }
  } with {
    briefly "Forecast event fan-out"
    described as {
      |Fans Forecast events out to the repository and projectors.
    }
  }
  connector 'ForecastEvent Stream' is from outlet ForecastContext.Forecast.ForecastEvents2 to inlet ForecastContext.ForecastEventSplit.ForecastEventSplitIn with {
    briefly "Forecast events, fanned out to storage and read models"
  }
  connector 'ForecastEvent Storage' is from outlet ForecastContext.ForecastEventSplit.ForecastEventSplitToForecastRepository to inlet ForecastContext.ForecastRepository.ForecastRepositoryFromForecast with {
    briefly "Forecast events on their way to storage"
  }
  connector 'ForecastAnalytics Feed' is from outlet ForecastContext.ForecastEventSplit.ForecastEventSplitToForecastAnalytics to inlet ForecastContext.ForecastAnalytics.ForecastAnalyticsFromForecast with {
    briefly "Forecast events feeding the ForecastAnalytics projection"
  }
  connector 'ForecastAnalytics Storage' is from outlet ForecastContext.ForecastAnalytics.ForecastAnalyticsOut to inlet ForecastContext.ForecastRepository.ForecastRepositoryFromForecastAnalytics with {
    briefly "The ForecastAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for demand planning"
  described as {
    |Demand forecasting context.
  }
}
