// Demand Planning - Forecast Context
context ForecastContext is {
  adaptor FromERPIntegration from context ERPIntegration is { 
    handler FromERPIntegrationHandler is {
      on event ERPIntegration.ForecastPublished is {
        do "the model receives forecast published"
      }
      on event ERPIntegration.HistoricalDemandFetched is {
        do "the model receives historical demand fetched"
      }
      on other is {
        error "Unexpected message for adaptor FromERPIntegration"
      }
    } with {
      briefly "from erp integration"
      described as {
        |Carries messages from the external ERPIntegration.
      }
    }
  } with {
    briefly "ERPIntegration integration"
    described as {
      |The model's side of the ERPIntegration conversation.
    }
  }
  adaptor ToERPIntegration to context ERPIntegration is { 
    handler ToERPIntegrationHandler is {
      on command ERPIntegration.FetchHistoricalDemand is {
        do "the model sends fetch historical demand"
      }
      on command ERPIntegration.PublishForecast is {
        do "the model sends publish forecast"
      }
      on other is {
        error "Unexpected message for adaptor ToERPIntegration"
      }
    } with {
      briefly "to erp integration"
      described as {
        |Carries messages to the external ERPIntegration.
      }
    }
  } with {
    briefly "ERPIntegration integration"
    described as {
      |The model's side of the ERPIntegration conversation.
    }
  }
  adaptor FromForecastingEngine from context ForecastingEngine is { 
    handler FromForecastingEngineHandler is {
      on event ForecastingEngine.MLForecastGenerated is {
        do "the model receives ml forecast generated"
      }
      on event ForecastingEngine.TimeSeriesAnalysisComplete is {
        do "the model receives time series analysis complete"
      }
      on other is {
        error "Unexpected message for adaptor FromForecastingEngine"
      }
    } with {
      briefly "from forecasting engine"
      described as {
        |Carries messages from the external ForecastingEngine.
      }
    }
  } with {
    briefly "ForecastingEngine integration"
    described as {
      |The model's side of the ForecastingEngine conversation.
    }
  }
  adaptor ToForecastingEngine to context ForecastingEngine is { 
    handler ToForecastingEngineHandler is {
      on command ForecastingEngine.GenerateMLForecast is {
        do "the model sends generate ml forecast"
      }
      on command ForecastingEngine.RunTimeSeriesAnalysis is {
        do "the model sends run time series analysis"
      }
      on other is {
        error "Unexpected message for adaptor ToForecastingEngine"
      }
    } with {
      briefly "to forecasting engine"
      described as {
        |Carries messages to the external ForecastingEngine.
      }
    }
  } with {
    briefly "ForecastingEngine integration"
    described as {
      |The model's side of the ForecastingEngine conversation.
    }
  }
  adaptor FromMarketIntelligence from context MarketIntelligence is { 
    handler FromMarketIntelligenceHandler is {
      on event MarketIntelligence.CompetitorActivityReceived is {
        do "the model receives competitor activity received"
      }
      on event MarketIntelligence.MarketTrendsReceived is {
        do "the model receives market trends received"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketIntelligence"
      }
    } with {
      briefly "from market intelligence"
      described as {
        |Carries messages from the external MarketIntelligence.
      }
    }
  } with {
    briefly "MarketIntelligence integration"
    described as {
      |The model's side of the MarketIntelligence conversation.
    }
  }
  adaptor ToMarketIntelligence to context MarketIntelligence is { 
    handler ToMarketIntelligenceHandler is {
      on command MarketIntelligence.GetCompetitorActivity is {
        do "the model sends get competitor activity"
      }
      on command MarketIntelligence.GetMarketTrends is {
        do "the model sends get market trends"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketIntelligence"
      }
    } with {
      briefly "to market intelligence"
      described as {
        |Carries messages to the external MarketIntelligence.
      }
    }
  } with {
    briefly "MarketIntelligence integration"
    described as {
      |The model's side of the MarketIntelligence conversation.
    }
  }
  adaptor FromSalesInput from context SalesInput is { 
    handler FromSalesInputHandler is {
      on event SalesInput.SalesForecastReceived is {
        do "the model receives sales forecast received"
      }
      on event SalesInput.SalesForecastRequested is {
        do "the model receives sales forecast requested"
      }
      on other is {
        error "Unexpected message for adaptor FromSalesInput"
      }
    } with {
      briefly "from sales input"
      described as {
        |Carries messages from the external SalesInput.
      }
    }
  } with {
    briefly "SalesInput integration"
    described as {
      |The model's side of the SalesInput conversation.
    }
  }
  adaptor ToSalesInput to context SalesInput is { 
    handler ToSalesInputHandler is {
      on command SalesInput.RequestSalesForecast is {
        do "the model sends request sales forecast"
      }
      on other is {
        error "Unexpected message for adaptor ToSalesInput"
      }
    } with {
      briefly "to sales input"
      described as {
        |Carries messages to the external SalesInput.
      }
    }
  } with {
    briefly "SalesInput integration"
    described as {
      |The model's side of the SalesInput conversation.
    }
  }
  include "types.riddl"
  include "Forecast.riddl"
  repository ForecastRepository is {
    inlet ForecastRepositoryFromForecast is type ForecastEvent    inlet ForecastRepositoryFromForecastAnalytics is type ForecastEvent    outlet ForecastRepositoryResponses is type Forecast.ForecastResult
    record StoredForecast is  {
      forecastId: ForecastId with {
        briefly "forecastId"
        described as {
          |The forecastId column of the stored forecast row.
        }
      }
      horizon: PlanningHorizon with {
        briefly "horizon"
        described as {
          |The horizon column of the stored forecast row.
        }
      }
      method: ForecastMethod with {
        briefly "method"
        described as {
          |The method column of the stored forecast row.
        }
      }
      status: ForecastStatus with {
        briefly "status"
        described as {
          |The status column of the stored forecast row.
        }
      }
    } with {
      briefly "Stored forecast row"
      described as {
        |The persistence shape of forecast data as this repository stores it.
      }
    }
    schema ForecastData is relational
      of forecasts as type StoredForecast
        index on field StoredForecast.status
        index on field StoredForecast.horizon.startDate
        index on field StoredForecast.method
 with {
      briefly "Forecast data schema"
      described as {
        |The relational schema holding forecast data for the ForecastRepository.
      }
    }
    handler ForecastPersistence is {
      on query GetPlanningMetrics is {
        do "read the planning metrics projection"
        yield result PlanningMetricsView
      }
      on command Forecast.CreateForecast is {
        tell event Forecast.ForecastCreated to entity ForecastContext.Forecast
      }
      on command Forecast.GenerateStatisticalForecast is {
        tell event Forecast.StatisticalForecastGenerated to entity ForecastContext.Forecast
      }
      on command Forecast.AddLocationForecast is {
        tell event Forecast.LocationForecastAdded to entity ForecastContext.Forecast
      }
      on command Forecast.AdjustForecast is {
        tell event Forecast.ForecastAdjusted to entity ForecastContext.Forecast
      }
      on command Forecast.AddConsensusInput is {
        tell event Forecast.ConsensusInputAdded to entity ForecastContext.Forecast
      }
      on command Forecast.ApproveForecast is {
        tell event Forecast.ForecastApproved to entity ForecastContext.Forecast
      }
      on command Forecast.ActivateForecast is {
        tell event Forecast.ForecastActivated to entity ForecastContext.Forecast
      }
      on command Forecast.CalculateAccuracy is {
        tell event Forecast.AccuracyCalculated to entity ForecastContext.Forecast
      }
      on command Forecast.ArchiveForecast is {
        tell event Forecast.ForecastArchived to entity ForecastContext.Forecast
      }
    } with {
      briefly "Persists forecast commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Forecast data persistence"
    described as {
      |Persistent storage for forecasts.
    }
  }
  query GetPlanningMetrics is  {
    planningMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which planning metrics to retrieve.
      }
    }
  } with {
    briefly "Get planning metrics"
    described as {
      |Retrieves the planning metrics projection.
    }
  }
  result PlanningMetricsView is  {
    planningMetrics: ForecastAnalytics.PlanningMetrics with {
      briefly "Planning metrics"
      described as {
        |The planning metrics being returned.
      }
    }
  } with {
    briefly "Planning metrics view"
    described as {
      |Read model view carrying the planning metrics projection.
    }
  }
  projector ForecastAnalytics is {
    updates repository ForecastContext.ForecastRepository
    inlet ForecastAnalyticsFromForecast is type ForecastEvent    outlet ForecastAnalyticsOut is type ForecastEvent
    record PlanningMetrics is  {
      activeForecastCount: Natural with {
        briefly "Active"
        described as {
          |Active forecasts.
        }
      }
      averageMAPE: Decimal(5,2) with {
        briefly "Avg MAPE"
        described as {
          |Average MAPE.
        }
      }
      bestPerformingMethod: String(1,50) with {
        briefly "Best method"
        described as {
          |Best method.
        }
      }
      totalAdjustmentCount: Natural with {
        briefly "Adjustments"
        described as {
          |Total adjustments.
        }
      }
      consensusAccuracy: Decimal(5,2) with {
        briefly "Consensus"
        described as {
          |Consensus accuracy.
        }
      }
    } with {
      briefly "Planning metrics"
      described as {
        |Demand planning metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Forecast.ForecastCreated is {
        tell event Forecast.ForecastCreated to repository ForecastContext.ForecastRepository
      }
      on event Forecast.ForecastActivated is {
        tell event Forecast.ForecastActivated to repository ForecastContext.ForecastRepository
      }
      on event Forecast.AccuracyCalculated is {
        tell event Forecast.AccuracyCalculated to repository ForecastContext.ForecastRepository
      }
      on event Forecast.ForecastAdjusted is {
        tell event Forecast.ForecastAdjusted to repository ForecastContext.ForecastRepository
      }
    } with {
      briefly "Maintains planning analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Forecast analytics"
    described as {
      |Demand planning performance.
    }
  }
  type ForecastEvent is one of {
    ForecastContext.Forecast.ForecastCreated or ForecastContext.Forecast.ForecastActivated or ForecastContext.Forecast.ForecastArchived
  } with {
    briefly "Forecast event union"
    described as {
      |Union of Forecast events for streaming.
    }
  }
  processor ForecastEventSource as source is {
    outlet ForecastEvents is type ForecastEvent
    handler ForecastEventEmitter is {
      on init is {
        tell command Forecast.InitializeForecast to entity ForecastContext.Forecast
      }
      on other is {
        error "Unexpected message for source ForecastEventSource"
      }
      on event Forecast.ForecastCreated is {
        send event Forecast.ForecastCreated to outlet ForecastEvents
      }
      on event Forecast.ForecastActivated is {
        send event Forecast.ForecastActivated to outlet ForecastEvents
      }
      on event Forecast.ForecastArchived is {
        send event Forecast.ForecastArchived to outlet ForecastEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits Forecast events to the stream.
      }
    }
  } with {
    briefly "Forecast event source"
    described as {
      |Publishes Forecast events to the event stream.
    }
  }
  processor ForecastEventSink as sink is {
    inlet IncomingForecastEvents is type ForecastEvent    handler ForecastEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink ForecastEventSink"
      }
      on event Forecast.ForecastCreated is {
        tell event Forecast.ForecastCreated to repository ForecastContext.ForecastRepository
      }
      on event Forecast.ForecastActivated is {
        tell event Forecast.ForecastActivated to repository ForecastContext.ForecastRepository
      }
      on event Forecast.ForecastArchived is {
        tell event Forecast.ForecastArchived to repository ForecastContext.ForecastRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives Forecast events for persistence.
      }
    }
  } with {
    briefly "Forecast event sink"
    described as {
      |Receives Forecast events from streaming.
    }
  }
  connector ForecastEventPipeline is from outlet ForecastContext.ForecastEventSource.ForecastEvents to inlet ForecastContext.ForecastEventSink.IncomingForecastEvents with {
    briefly "Forecast event pipeline"
    described as {
      |Wires Forecast event source to sink.
    }
  }
  processor ForecastEventSplit is {
    inlet ForecastEventSplitIn is type ForecastEvent    outlet ForecastEventSplitToForecastRepository is type ForecastEvent
    outlet ForecastEventSplitToForecastAnalytics is type ForecastEvent
    handler ForecastEventSplitHandler is {
      on event Forecast.ForecastCreated is {
        send event Forecast.ForecastCreated to outlet ForecastEventSplitToForecastRepository
        send event Forecast.ForecastCreated to outlet ForecastEventSplitToForecastAnalytics
        tell event Forecast.ForecastCreated to entity ForecastContext.Forecast
      }
      on event Forecast.StatisticalForecastGenerated is {
        send event Forecast.StatisticalForecastGenerated to outlet ForecastEventSplitToForecastRepository
        send event Forecast.StatisticalForecastGenerated to outlet ForecastEventSplitToForecastAnalytics
        tell event Forecast.StatisticalForecastGenerated to entity ForecastContext.Forecast
      }
      on event Forecast.LocationForecastAdded is {
        send event Forecast.LocationForecastAdded to outlet ForecastEventSplitToForecastRepository
        send event Forecast.LocationForecastAdded to outlet ForecastEventSplitToForecastAnalytics
        tell event Forecast.LocationForecastAdded to entity ForecastContext.Forecast
      }
      on event Forecast.ForecastAdjusted is {
        send event Forecast.ForecastAdjusted to outlet ForecastEventSplitToForecastRepository
        send event Forecast.ForecastAdjusted to outlet ForecastEventSplitToForecastAnalytics
        tell event Forecast.ForecastAdjusted to entity ForecastContext.Forecast
      }
      on event Forecast.ConsensusInputAdded is {
        send event Forecast.ConsensusInputAdded to outlet ForecastEventSplitToForecastRepository
        send event Forecast.ConsensusInputAdded to outlet ForecastEventSplitToForecastAnalytics
        tell event Forecast.ConsensusInputAdded to entity ForecastContext.Forecast
      }
      on event Forecast.ForecastSubmittedForReview is {
        send event Forecast.ForecastSubmittedForReview to outlet ForecastEventSplitToForecastRepository
        send event Forecast.ForecastSubmittedForReview to outlet ForecastEventSplitToForecastAnalytics
        tell event Forecast.ForecastSubmittedForReview to entity ForecastContext.Forecast
      }
      on event Forecast.ForecastApproved is {
        send event Forecast.ForecastApproved to outlet ForecastEventSplitToForecastRepository
        send event Forecast.ForecastApproved to outlet ForecastEventSplitToForecastAnalytics
        tell event Forecast.ForecastApproved to entity ForecastContext.Forecast
      }
      on event Forecast.ForecastActivated is {
        send event Forecast.ForecastActivated to outlet ForecastEventSplitToForecastRepository
        send event Forecast.ForecastActivated to outlet ForecastEventSplitToForecastAnalytics
        tell event Forecast.ForecastActivated to entity ForecastContext.Forecast
      }
      on event Forecast.ActualsRecorded is {
        send event Forecast.ActualsRecorded to outlet ForecastEventSplitToForecastRepository
        send event Forecast.ActualsRecorded to outlet ForecastEventSplitToForecastAnalytics
        tell event Forecast.ActualsRecorded to entity ForecastContext.Forecast
      }
      on event Forecast.AccuracyCalculated is {
        send event Forecast.AccuracyCalculated to outlet ForecastEventSplitToForecastRepository
        send event Forecast.AccuracyCalculated to outlet ForecastEventSplitToForecastAnalytics
        tell event Forecast.AccuracyCalculated to entity ForecastContext.Forecast
      }
      on event Forecast.ForecastSuperseded is {
        send event Forecast.ForecastSuperseded to outlet ForecastEventSplitToForecastRepository
        send event Forecast.ForecastSuperseded to outlet ForecastEventSplitToForecastAnalytics
        tell event Forecast.ForecastSuperseded to entity ForecastContext.Forecast
      }
      on event Forecast.ForecastArchived is {
        send event Forecast.ForecastArchived to outlet ForecastEventSplitToForecastRepository
        send event Forecast.ForecastArchived to outlet ForecastEventSplitToForecastAnalytics
        tell event Forecast.ForecastArchived to entity ForecastContext.Forecast
      }
      on other is {
        error "Unexpected message for processor ForecastEventSplit"
      }
    } with {
      briefly "Forecast event fan-out handler"
      described as {
        |Delivers each Forecast event to all of its consumers.
      }
    }
  } with {
    briefly "Forecast event fan-out"
    described as {
      |Fans Forecast events out to the repository and projectors.
    }
  }
  connector LinkForecastToForecastEventSplit is from outlet ForecastContext.Forecast.ForecastEvents2 to inlet ForecastContext.ForecastEventSplit.ForecastEventSplitIn with {
    briefly "LinkForecastToForecastEventSplit"
  }
  connector LinkForecastEventSplitToForecastRepository is from outlet ForecastContext.ForecastEventSplit.ForecastEventSplitToForecastRepository to inlet ForecastContext.ForecastRepository.ForecastRepositoryFromForecast with {
    briefly "LinkForecastEventSplitToForecastRepository"
  }
  connector LinkForecastEventSplitToForecastAnalytics is from outlet ForecastContext.ForecastEventSplit.ForecastEventSplitToForecastAnalytics to inlet ForecastContext.ForecastAnalytics.ForecastAnalyticsFromForecast with {
    briefly "LinkForecastEventSplitToForecastAnalytics"
  }
  connector LinkForecastAnalyticsToForecastRepository is from outlet ForecastContext.ForecastAnalytics.ForecastAnalyticsOut to inlet ForecastContext.ForecastRepository.ForecastRepositoryFromForecastAnalytics with {
    briefly "LinkForecastAnalyticsToForecastRepository"
  }
} with {
  briefly "Bounded context for demand planning"
  described as {
    |Demand forecasting context.
  }
}
