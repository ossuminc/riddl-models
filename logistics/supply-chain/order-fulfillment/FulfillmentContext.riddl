// Order Fulfillment - Fulfillment Context
context FulfillmentContext as router is {
  inlet FulfillmentOrderCommandStreaIn is type FulfillmentOrderCommand  outlet FulfillmentOrderCommandStreaOut is type FulfillmentOrderCommand
  inlet FulfillmentOrderResultStreamIn is type FulfillmentOrder.FulfillmentOrderResult  outlet FulfillmentOrderResultStreamOut is type FulfillmentOrder.FulfillmentOrderResult
  handler FulfillmentContextBoundary is {
    on createOrder: command FulfillmentOrder.CreateOrder is {
      send createOrder to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on allocateInventory: command FulfillmentOrder.AllocateInventory is {
      send allocateInventory to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on assignPickTasks: command FulfillmentOrder.AssignPickTasks is {
      send assignPickTasks to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on recordPick: command FulfillmentOrder.RecordPick is {
      send recordPick to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on completePicking: command FulfillmentOrder.CompletePicking is {
      send completePicking to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on packOrder: command FulfillmentOrder.PackOrder is {
      send packOrder to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on shipOrder: command FulfillmentOrder.ShipOrder is {
      send shipOrder to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on confirmDelivery: command FulfillmentOrder.ConfirmDelivery is {
      send confirmDelivery to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on placeOnHold: command FulfillmentOrder.PlaceOnHold is {
      send placeOnHold to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on cancelOrder: command FulfillmentOrder.CancelOrder is {
      send cancelOrder to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on initializeFulfillmentOrder: command FulfillmentOrder.InitializeFulfillmentOrder is {
      send initializeFulfillmentOrder to outlet FulfillmentContext.FulfillmentOrderCommandStreaOut
    }
    on fulfillmentOrderResult: result FulfillmentOrder.FulfillmentOrderResult is {
      send fulfillmentOrderResult to outlet FulfillmentContext.FulfillmentOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the FulfillmentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'FulfillmentOrderCommand Stream Intake' is from outlet FulfillmentContext.FulfillmentOrderCommandStreaOut to inlet FulfillmentContext.FulfillmentOrder.FulfillmentOrderCommands  connector 'FulfillmentOrderResult Stream Egress' is from outlet FulfillmentContext.FulfillmentRepository.FulfillmentRepositoryResponses to inlet FulfillmentContext.FulfillmentOrderResultStreamIn  adaptor ToCustomerNotification to context CustomerNotification is { 
    handler ToCustomerNotificationHandler is {
      on command CustomerNotification.SendDeliveryNotification is {
        do "the model sends send delivery notification"
      }
      on command CustomerNotification.SendShipmentNotification is {
        do "the model sends send shipment notification"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerNotification"
      }
    } with {
      briefly "to customer notification"
      described as {
        |Carries messages to the external CustomerNotification.
      }
    }
  } with {
    briefly "CustomerNotification integration"
    described as {
      |The model's side of the CustomerNotification conversation.
    }
  }
  adaptor FromInventoryManagement from context InventoryManagement is { 
    handler FromInventoryManagementHandler is {
      on result InventoryManagement.InventoryAvailability is {
        do "the model receives inventory availability"
      }
      on event InventoryManagement.InventoryReserved is {
        do "the model receives inventory reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryManagement"
      }
    } with {
      briefly "from inventory management"
      described as {
        |Carries messages from the external InventoryManagement.
      }
    }
  } with {
    briefly "InventoryManagement integration"
    described as {
      |The model's side of the InventoryManagement conversation.
    }
  }
  adaptor ToInventoryManagement to context InventoryManagement is { 
    handler ToInventoryManagementHandler is {
      on query InventoryManagement.CheckAvailability is {
        do "the model sends check availability"
      }
      on command InventoryManagement.ReserveInventory is {
        do "the model sends reserve inventory"
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryManagement"
      }
    } with {
      briefly "to inventory management"
      described as {
        |Carries messages to the external InventoryManagement.
      }
    }
  } with {
    briefly "InventoryManagement integration"
    described as {
      |The model's side of the InventoryManagement conversation.
    }
  }
  adaptor FromOrderManagement from context OrderManagement is { 
    handler FromOrderManagementHandler is {
      on event OrderManagement.SalesOrderReceived is {
        do "the model receives sales order received"
      }
      on other is {
        error "Unexpected message for adaptor FromOrderManagement"
      }
    } with {
      briefly "from order management"
      described as {
        |Carries messages from the external OrderManagement.
      }
    }
  } with {
    briefly "OrderManagement integration"
    described as {
      |The model's side of the OrderManagement conversation.
    }
  }
  adaptor ToOrderManagement to context OrderManagement is { 
    handler ToOrderManagementHandler is {
      on command OrderManagement.UpdateOrderStatus is {
        do "the model sends update order status"
      }
      on other is {
        error "Unexpected message for adaptor ToOrderManagement"
      }
    } with {
      briefly "to order management"
      described as {
        |Carries messages to the external OrderManagement.
      }
    }
  } with {
    briefly "OrderManagement integration"
    described as {
      |The model's side of the OrderManagement conversation.
    }
  }
  adaptor FromShippingCarrier from context ShippingCarrier is { 
    handler FromShippingCarrierHandler is {
      on event ShippingCarrier.ShipmentCreated is {
        do "the model receives shipment created"
      }
      on result ShippingCarrier.ShippingRates is {
        do "the model receives shipping rates"
      }
      on other is {
        error "Unexpected message for adaptor FromShippingCarrier"
      }
    } with {
      briefly "from shipping carrier"
      described as {
        |Carries messages from the external ShippingCarrier.
      }
    }
  } with {
    briefly "ShippingCarrier integration"
    described as {
      |The model's side of the ShippingCarrier conversation.
    }
  }
  adaptor ToShippingCarrier to context ShippingCarrier is { 
    handler ToShippingCarrierHandler is {
      on command ShippingCarrier.CreateShipment is {
        do "the model sends create shipment"
      }
      on query ShippingCarrier.GetShippingRates is {
        do "the model sends get shipping rates"
      }
      on other is {
        error "Unexpected message for adaptor ToShippingCarrier"
      }
    } with {
      briefly "to shipping carrier"
      described as {
        |Carries messages to the external ShippingCarrier.
      }
    }
  } with {
    briefly "ShippingCarrier integration"
    described as {
      |The model's side of the ShippingCarrier conversation.
    }
  }
  include "types.riddl"
  include "FulfillmentOrder.riddl"
  repository FulfillmentRepository as merge is {
    command PersistDeliveryConfirmed is  {
      orderId: FulfillmentOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryConfirmed applies to.
        }
      }
    } with {
      briefly "Persist DeliveryConfirmed"
      described as {
        |Instructs this repository to apply DeliveryConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderCreated is  {
      orderId: FulfillmentOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCreated applies to.
        }
      }
    } with {
      briefly "Persist OrderCreated"
      described as {
        |Instructs this repository to apply OrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderShipped is  {
      orderId: FulfillmentOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderShipped applies to.
        }
      }
    } with {
      briefly "Persist OrderShipped"
      described as {
        |Instructs this repository to apply OrderShipped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet FulfillmentRepositoryFromFulfillmentOrder is type FulfillmentOrderEvent    inlet FulfillmentRepositoryFromFulfillmentMetrics is type FulfillmentOrderEvent    outlet FulfillmentRepositoryResponses is type FulfillmentOrder.FulfillmentOrderResult
    record StoredFulfillmentOrder is  {
      fulfillmentOrderId: FulfillmentOrderId with {
        briefly "fulfillmentOrderId"
        described as {
          |The fulfillmentOrderId column of the stored fulfillmentOrder row.
        }
      }
      orderId: FulfillmentOrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored fulfillmentOrder row.
        }
      }
      salesOrderId: SalesOrderId with {
        briefly "salesOrderId"
        described as {
          |The salesOrderId column of the stored fulfillmentOrder row.
        }
      }
      status: OrderStatus with {
        briefly "status"
        described as {
          |The status column of the stored fulfillmentOrder row.
        }
      }
      warehouseId: WarehouseId with {
        briefly "warehouseId"
        described as {
          |The warehouseId column of the stored fulfillmentOrder row.
        }
      }
    } with {
      briefly "Stored fulfillmentOrder row"
      described as {
        |The persistence shape of fulfillmentOrder data as this repository stores it.
      }
    }
    schema FulfillmentData is relational
      of orders as type StoredFulfillmentOrder
        index on field StoredFulfillmentOrder.orderId
        index on field StoredFulfillmentOrder.salesOrderId
        index on field StoredFulfillmentOrder.status
        index on field StoredFulfillmentOrder.warehouseId
 with {
      briefly "Fulfillment data schema"
      described as {
        |The relational schema holding fulfillment data for the FulfillmentRepository.
      }
    }
    handler FulfillmentPersistence is {
      on persistDeliveryConfirmed: command PersistDeliveryConfirmed is {
        do "apply DeliveryConfirmed to the stored row"
      }
      on persistOrderCreated: command PersistOrderCreated is {
        do "apply OrderCreated to the stored row"
      }
      on persistOrderShipped: command PersistOrderShipped is {
        do "apply OrderShipped to the stored row"
      }
      on query GetWarehouseMetrics is {
        let warehouseMetricsView: type WarehouseMetricsView = prompt("read the warehouse metrics projection")
        reply warehouseMetricsView
      }
      on createOrder: command FulfillmentOrder.CreateOrder is {
        tell event FulfillmentOrder.OrderCreated(orderId = createOrder.orderId, salesOrderId = createOrder.salesOrderId, priority = createOrder.priority) to entity FulfillmentContext.FulfillmentOrder
      }
      on allocateInventory: command FulfillmentOrder.AllocateInventory is {
        tell event FulfillmentOrder.InventoryAllocated(orderId = allocateInventory.orderId) to entity FulfillmentContext.FulfillmentOrder
      }
      on recordPick: command FulfillmentOrder.RecordPick is {
        tell event FulfillmentOrder.ItemPicked(orderId = recordPick.orderId, taskId = recordPick.taskId, quantityPicked = recordPick.quantityPicked, pickedAt = recordPick.pickedAt) to entity FulfillmentContext.FulfillmentOrder
      }
      on packOrder: command FulfillmentOrder.PackOrder is {
        tell event FulfillmentOrder.OrderPacked(orderId = packOrder.orderId, packingSlip = packOrder.packingSlip) to entity FulfillmentContext.FulfillmentOrder
      }
      on shipOrder: command FulfillmentOrder.ShipOrder is {
        tell event FulfillmentOrder.OrderShipped(orderId = shipOrder.orderId, shipment = shipOrder.shipment) to entity FulfillmentContext.FulfillmentOrder
      }
      on confirmDelivery: command FulfillmentOrder.ConfirmDelivery is {
        tell event FulfillmentOrder.DeliveryConfirmed(orderId = confirmDelivery.orderId, deliveredAt = confirmDelivery.deliveredAt) to entity FulfillmentContext.FulfillmentOrder
      }
    } with {
      briefly "Persists fulfillment commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Fulfillment data persistence"
    described as {
      |Persistent storage for orders.
    }
  }
  query GetWarehouseMetrics is  {
    warehouseMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which warehouse metrics to retrieve.
      }
    }
  } with {
    briefly "Get warehouse metrics"
    described as {
      |Retrieves the warehouse metrics projection.
    }
  }
  result WarehouseMetricsView is  {
    warehouseMetrics: FulfillmentMetrics.WarehouseMetrics with {
      briefly "Warehouse metrics"
      described as {
        |The warehouse metrics being returned.
      }
    }
  } with {
    briefly "Warehouse metrics view"
    described as {
      |Read model view carrying the warehouse metrics projection.
    }
  }
  projector FulfillmentMetrics as flow is {
    updates repository FulfillmentContext.FulfillmentRepository
    inlet FulfillmentMetricsFromFulfillmentOrder is type FulfillmentOrderEvent    outlet FulfillmentMetricsOut is type FulfillmentOrderEvent
    record WarehouseMetrics is  {
      warehouseId: WarehouseId with {
        briefly "Warehouse"
        described as {
          |Warehouse ID.
        }
      }
      ordersProcessed: Natural with {
        briefly "Processed"
        described as {
          |Orders processed.
        }
      }
      ordersShipped: Natural with {
        briefly "Shipped"
        described as {
          |Orders shipped.
        }
      }
      avgFulfillmentTime: Decimal(6,2) with {
        briefly "Avg time"
        described as {
          |Avg fulfillment hours.
        }
      }
      onTimeRate: Decimal(5,2) with {
        briefly "On time"
        described as {
          |On-time percentage.
        }
      }
      pickAccuracy: Decimal(5,2) with {
        briefly "Accuracy"
        described as {
          |Pick accuracy pct.
        }
      }
    } with {
      briefly "Warehouse metrics"
      described as {
        |Fulfillment metrics by warehouse.
      }
    }
    handler MetricsHandler is {
      on orderCreated: event FulfillmentOrder.OrderCreated is {
        tell command FulfillmentContext.FulfillmentRepository.PersistOrderCreated(orderId = orderCreated.orderId) to repository FulfillmentContext.FulfillmentRepository
      }
      on orderShipped: event FulfillmentOrder.OrderShipped is {
        tell command FulfillmentContext.FulfillmentRepository.PersistOrderShipped(orderId = orderShipped.orderId) to repository FulfillmentContext.FulfillmentRepository
      }
      on deliveryConfirmed: event FulfillmentOrder.DeliveryConfirmed is {
        tell command FulfillmentContext.FulfillmentRepository.PersistDeliveryConfirmed(orderId = deliveryConfirmed.orderId) to repository FulfillmentContext.FulfillmentRepository
      }
    } with {
      briefly "Maintains fulfillment metrics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Fulfillment metrics"
    described as {
      |Order fulfillment analytics.
    }
  }
  type FulfillmentOrderEvent is one of {
    FulfillmentContext.FulfillmentOrder.OrderCreated or FulfillmentContext.FulfillmentOrder.OrderShipped or FulfillmentContext.FulfillmentOrder.DeliveryConfirmed or FulfillmentContext.FulfillmentOrder.InventoryAllocated or FulfillmentContext.FulfillmentOrder.ItemPicked or FulfillmentContext.FulfillmentOrder.OrderCancelled or FulfillmentContext.FulfillmentOrder.OrderPacked or FulfillmentContext.FulfillmentOrder.OrderPlacedOnHold or FulfillmentContext.FulfillmentOrder.PickTasksAssigned or FulfillmentContext.FulfillmentOrder.PickingCompleted
  } with {
    briefly "FulfillmentOrder event union"
    described as {
      |Union of FulfillmentOrder events for streaming.
    }
  }
  processor FulfillmentOrderEventSource as source is {
    outlet FulfillmentOrderEvents is type FulfillmentOrderEvent
    handler FulfillmentOrderEventEmitter is {
      on init is {
        let initializeFulfillmentOrder: type FulfillmentOrder.InitializeFulfillmentOrder = prompt("the initialize fulfillment order that brings this this into existence")
        tell initializeFulfillmentOrder to entity FulfillmentContext.FulfillmentOrder
      }
      on other is {
        error "Unexpected message for source FulfillmentOrderEventSource"
      }
      on orderCreated: event FulfillmentOrder.OrderCreated is {
        send orderCreated to outlet FulfillmentOrderEvents
      }
      on orderShipped: event FulfillmentOrder.OrderShipped is {
        send orderShipped to outlet FulfillmentOrderEvents
      }
      on deliveryConfirmed: event FulfillmentOrder.DeliveryConfirmed is {
        send deliveryConfirmed to outlet FulfillmentOrderEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits FulfillmentOrder events to the stream.
      }
    }
  } with {
    briefly "FulfillmentOrder event source"
    described as {
      |Publishes FulfillmentOrder events to the event stream.
    }
  }
  processor FulfillmentOrderEventSink as sink is {
    inlet IncomingFulfillmentOrderEvents is type FulfillmentOrderEvent    handler FulfillmentOrderEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink FulfillmentOrderEventSink"
      }
      on orderCreated: event FulfillmentOrder.OrderCreated is {
        tell orderCreated to repository FulfillmentContext.FulfillmentRepository
      }
      on orderShipped: event FulfillmentOrder.OrderShipped is {
        tell orderShipped to repository FulfillmentContext.FulfillmentRepository
      }
      on deliveryConfirmed: event FulfillmentOrder.DeliveryConfirmed is {
        tell deliveryConfirmed to repository FulfillmentContext.FulfillmentRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives FulfillmentOrder events for persistence.
      }
    }
  } with {
    briefly "FulfillmentOrder event sink"
    described as {
      |Receives FulfillmentOrder events from streaming.
    }
  }
  connector FulfillmentOrderEventPipeline is from outlet FulfillmentContext.FulfillmentOrderEventSource.FulfillmentOrderEvents to inlet FulfillmentContext.FulfillmentOrderEventSink.IncomingFulfillmentOrderEvents with {
    briefly "FulfillmentOrder event pipeline"
    described as {
      |Wires FulfillmentOrder event source to sink.
    }
  }
  processor FulfillmentOrderEventSplit as split is {
    inlet FulfillmentOrderEventSplitIn is type FulfillmentOrderEvent    outlet FulfillmentOrderEventSplitToFulfillmentRepository is type FulfillmentOrderEvent
    outlet FulfillmentOrderEventSplitToFulfillmentMetrics is type FulfillmentOrderEvent
    handler FulfillmentOrderEventSplitHandler is {
      on orderCreated: event FulfillmentOrder.OrderCreated is {
        send orderCreated to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send orderCreated to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell orderCreated to entity FulfillmentContext.FulfillmentOrder
      }
      on inventoryAllocated: event FulfillmentOrder.InventoryAllocated is {
        send inventoryAllocated to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send inventoryAllocated to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell inventoryAllocated to entity FulfillmentContext.FulfillmentOrder
      }
      on pickTasksAssigned: event FulfillmentOrder.PickTasksAssigned is {
        send pickTasksAssigned to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send pickTasksAssigned to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell pickTasksAssigned to entity FulfillmentContext.FulfillmentOrder
      }
      on itemPicked: event FulfillmentOrder.ItemPicked is {
        send itemPicked to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send itemPicked to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell itemPicked to entity FulfillmentContext.FulfillmentOrder
      }
      on pickingCompleted: event FulfillmentOrder.PickingCompleted is {
        send pickingCompleted to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send pickingCompleted to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell pickingCompleted to entity FulfillmentContext.FulfillmentOrder
      }
      on orderPacked: event FulfillmentOrder.OrderPacked is {
        send orderPacked to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send orderPacked to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell orderPacked to entity FulfillmentContext.FulfillmentOrder
      }
      on orderShipped: event FulfillmentOrder.OrderShipped is {
        send orderShipped to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send orderShipped to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell orderShipped to entity FulfillmentContext.FulfillmentOrder
      }
      on deliveryConfirmed: event FulfillmentOrder.DeliveryConfirmed is {
        send deliveryConfirmed to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send deliveryConfirmed to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell deliveryConfirmed to entity FulfillmentContext.FulfillmentOrder
      }
      on orderPlacedOnHold: event FulfillmentOrder.OrderPlacedOnHold is {
        send orderPlacedOnHold to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send orderPlacedOnHold to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell orderPlacedOnHold to entity FulfillmentContext.FulfillmentOrder
      }
      on orderCancelled: event FulfillmentOrder.OrderCancelled is {
        send orderCancelled to outlet FulfillmentOrderEventSplitToFulfillmentRepository
        send orderCancelled to outlet FulfillmentOrderEventSplitToFulfillmentMetrics
        tell orderCancelled to entity FulfillmentContext.FulfillmentOrder
      }
      on other is {
        error "Unexpected message for processor FulfillmentOrderEventSplit"
      }
    } with {
      briefly "FulfillmentOrder event fan-out handler"
      described as {
        |Delivers each FulfillmentOrder event to all of its consumers.
      }
    }
  } with {
    briefly "FulfillmentOrder event fan-out"
    described as {
      |Fans FulfillmentOrder events out to the repository and projectors.
    }
  }
  connector 'FulfillmentOrderEvent Stream' is from outlet FulfillmentContext.FulfillmentOrder.FulfillmentOrderEvents2 to inlet FulfillmentContext.FulfillmentOrderEventSplit.FulfillmentOrderEventSplitIn with {
    briefly "FulfillmentOrder events, fanned out to storage and read models"
  }
  connector 'FulfillmentOrderEvent Storage' is from outlet FulfillmentContext.FulfillmentOrderEventSplit.FulfillmentOrderEventSplitToFulfillmentRepository to inlet FulfillmentContext.FulfillmentRepository.FulfillmentRepositoryFromFulfillmentOrder with {
    briefly "FulfillmentOrder events on their way to storage"
  }
  connector 'FulfillmentMetrics Feed' is from outlet FulfillmentContext.FulfillmentOrderEventSplit.FulfillmentOrderEventSplitToFulfillmentMetrics to inlet FulfillmentContext.FulfillmentMetrics.FulfillmentMetricsFromFulfillmentOrder with {
    briefly "FulfillmentOrder events feeding the FulfillmentMetrics projection"
  }
  connector 'FulfillmentMetrics Storage' is from outlet FulfillmentContext.FulfillmentMetrics.FulfillmentMetricsOut to inlet FulfillmentContext.FulfillmentRepository.FulfillmentRepositoryFromFulfillmentMetrics with {
    briefly "The FulfillmentMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for order fulfillment"
  described as {
    |Supply chain fulfillment context.
  }
}
