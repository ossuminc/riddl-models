// Order Fulfillment Domain Model
// Supply chain order processing and fulfillment
domain OrderFulfillment is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user FulfillmentManager is "person overseeing fulfillment operations" with {
    briefly "Fulfillment Manager"
    described as {
      |Manager coordinating order processing.
    }
  }
  user WarehouseWorker is "person picking and packing orders" with {
    briefly "Warehouse Worker"
    described as {
      |Worker executing fulfillment tasks.
    }
  }
  user ShippingCoordinator is "person arranging shipments" with {
    briefly "Shipping Coordinator"
    described as {
      |Coordinator managing shipments.
    }
  }
  epic OrderFulfillmentProcess is {
    user FulfillmentManager wants to "to process orders efficiently" so that "customers receive orders on time"
    case FulfillOrder is {
      user FulfillmentManager wants to "to fulfill customer orders" so that "products are delivered accurately"
      step is "System allocates" "inventory to orders" "by priority" with {
        briefly "Allocate inventory"
        described as {
          |Reserve stock.
        }
      }
      step is "Worker picks" "items from warehouse" "for packing" with {
        briefly "Pick items"
        described as {
          |Retrieve products.
        }
      }
    } with {
      briefly "Fulfill order"
      described as {
        |Processing customer orders.
      }
    }
  } with {
    briefly "Order fulfillment process"
    described as {
      |Epic for fulfillment operations.
    }
  }
  include "FulfillmentContext.riddl"
  include "external-contexts.riddl"
  application context OrderFulfillmentApp is {
    outlet AppFulfillmentOrderCommands is type FulfillmentContext.FulfillmentOrder.FulfillmentOrderCommand
    inlet AppFulfillmentRepositoryResponses is type FulfillmentContext.FulfillmentOrder.FulfillmentOrderResult
    handler OrderFulfillmentAppHandler is {
      on other is {
        error "Unexpected message for application context OrderFulfillmentApp"
      }
    } with {
      briefly "OrderFulfillmentApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "OrderFulfillmentApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppFulfillmentOrderCommands is {
    from outlet OrderFulfillmentApp.AppFulfillmentOrderCommands to
      inlet FulfillmentContext.FulfillmentOrder.FulfillmentOrderCommands
  } with {
    option is persistent
    briefly "LinkAppFulfillmentOrderCommands"
  }
  connector LinkAppFulfillmentRepositoryResponses is {
    from outlet FulfillmentContext.FulfillmentRepository.FulfillmentRepositoryResponses to
      inlet OrderFulfillmentApp.AppFulfillmentRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppFulfillmentRepositoryResponses"
  }
} with {
  briefly "Order fulfillment domain"
  described as {
    |Supply chain order fulfillment management.
  }
}
