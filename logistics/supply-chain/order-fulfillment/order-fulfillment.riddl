// Order Fulfillment Domain Model
// Supply chain order processing and fulfillment
domain OrderFulfillment is {
  persistent connector 'InventoryManagementEvent Stream' is from outlet InventoryManagement.InventoryManagementEventsOut to inlet FulfillmentContext.FromInventoryManagement.FromInventoryManagementIn with {
    briefly "What InventoryManagement tells FulfillmentContext, unasked"
  }
  persistent connector 'OrderManagementEvent Stream' is from outlet OrderManagement.OrderManagementEventsOut to inlet FulfillmentContext.FromOrderManagement.FromOrderManagementIn with {
    briefly "What OrderManagement tells FulfillmentContext, unasked"
  }
  persistent connector 'ShippingCarrierEvent Stream' is from outlet ShippingCarrier.ShippingCarrierEventsOut to inlet FulfillmentContext.FromShippingCarrier.FromShippingCarrierIn with {
    briefly "What ShippingCarrier tells FulfillmentContext, unasked"
  }
  persistent connector 'InventoryManagementRequest Stream' is from outlet FulfillmentContext.ToInventoryManagement.ToInventoryManagementOut to inlet InventoryManagement.InventoryManagementRequests with {
    briefly "What FulfillmentContext asks InventoryManagement to send"
  }
  persistent connector 'ShippingCarrierRequest Stream' is from outlet FulfillmentContext.ToShippingCarrier.ToShippingCarrierOut to inlet ShippingCarrier.ShippingCarrierRequests with {
    briefly "What FulfillmentContext asks ShippingCarrier to send"
  }
  persistent connector 'OrderManagementRequest Stream' is from outlet FulfillmentContext.ToOrderManagement.ToOrderManagementOut to inlet OrderManagement.OrderManagementRequests with {
    briefly "What FulfillmentContext asks OrderManagement to send"
  }
  persistent connector 'CustomerNotificationRequest Stream' is from outlet FulfillmentContext.ToCustomerNotification.ToCustomerNotificationOut to inlet CustomerNotification.CustomerNotificationRequests with {
    briefly "What FulfillmentContext asks CustomerNotification to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user FulfillmentManager is "person overseeing fulfillment operations" with {
    briefly "Fulfillment Manager"
    described as {
      |Manager coordinating order processing.
    }
  }
  user WarehouseWorker is "person picking and packing orders" with {
    briefly "Warehouse Worker"
    described as {
      |Worker executing fulfillment tasks.
    }
  }
  user ShippingCoordinator is "person arranging shipments" with {
    briefly "Shipping Coordinator"
    described as {
      |Coordinator managing shipments.
    }
  }
  epic OrderFulfillmentProcess is {
    user FulfillmentManager wants to "to process orders efficiently" so that "customers receive orders on time"
    case FulfillOrder is {
      user FulfillmentManager wants to "to fulfill customer orders" so that "products are delivered accurately"
      step is "System allocates" "inventory to orders" "by priority" with {
        briefly "Allocate inventory"
        described as {
          |Reserve stock.
        }
      }
      step is "Worker picks" "items from warehouse" "for packing" with {
        briefly "Pick items"
        described as {
          |Retrieve products.
        }
      }
    } with {
      briefly "Fulfill order"
      described as {
        |Processing customer orders.
      }
    }
  } with {
    briefly "Order fulfillment process"
    described as {
      |Epic for fulfillment operations.
    }
  }
  include "FulfillmentContext.riddl"
  include "external-contexts.riddl"
  application context OrderFulfillmentApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in OrderFulfillment are delivered.
      }
    }
    outlet AppFulfillmentOrderCommands is type FulfillmentContext.FulfillmentOrder.FulfillmentOrderCommand
    inlet AppFulfillmentRepositoryResponses is result FulfillmentContext.FulfillmentOrder.FulfillmentOrderResult    handler OrderFulfillmentAppHandler is {
      on other is {
        error "Unexpected message for application context OrderFulfillmentApp"
      }
    } with {
      briefly "OrderFulfillmentApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "OrderFulfillmentApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'FulfillmentOrderCommand Stream' is from outlet OrderFulfillmentApp.AppFulfillmentOrderCommands to inlet FulfillmentContext.FulfillmentOrderCommandStreaIn with {
    briefly "FulfillmentOrder commands from the application"
  }
  persistent connector 'FulfillmentOrderResult Stream' is from outlet FulfillmentContext.FulfillmentOrderResultStreamOut to inlet OrderFulfillmentApp.AppFulfillmentRepositoryResponses with {
    briefly "Fulfillment query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet OrderFulfillmentApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Order fulfillment domain"
  described as {
    |Supply chain order fulfillment management.
  }
}
