// Supplier Management - Supplier Context
context SupplierContext is {
  adaptor FromComplianceRegistry from context ComplianceRegistry is { 
    handler FromComplianceRegistryHandler is {
      on event ComplianceRegistry.ComplianceReportFiled is {
        do "the model receives compliance report filed"
      }
      on result ComplianceRegistry.ComplianceResult is {
        do "the model receives compliance result"
      }
      on other is {
        error "Unexpected message for adaptor FromComplianceRegistry"
      }
    } with {
      briefly "from compliance registry"
      described as {
        |Carries messages from the external ComplianceRegistry.
      }
    }
  } with {
    briefly "ComplianceRegistry integration"
    described as {
      |The model's side of the ComplianceRegistry conversation.
    }
  }
  adaptor ToComplianceRegistry to context ComplianceRegistry is { 
    handler ToComplianceRegistryHandler is {
      on query ComplianceRegistry.CheckCompliance is {
        do "the model sends check compliance"
      }
      on command ComplianceRegistry.SubmitComplianceReport is {
        do "the model sends submit compliance report"
      }
      on other is {
        error "Unexpected message for adaptor ToComplianceRegistry"
      }
    } with {
      briefly "to compliance registry"
      described as {
        |Carries messages to the external ComplianceRegistry.
      }
    }
  } with {
    briefly "ComplianceRegistry integration"
    described as {
      |The model's side of the ComplianceRegistry conversation.
    }
  }
  adaptor FromProcurementSystem from context ProcurementSystem is { 
    handler FromProcurementSystemHandler is {
      on event ProcurementSystem.PurchaseOrderCreated is {
        do "the model receives purchase order created"
      }
      on result ProcurementSystem.SupplierSpend is {
        do "the model receives supplier spend"
      }
      on other is {
        error "Unexpected message for adaptor FromProcurementSystem"
      }
    } with {
      briefly "from procurement system"
      described as {
        |Carries messages from the external ProcurementSystem.
      }
    }
  } with {
    briefly "ProcurementSystem integration"
    described as {
      |The model's side of the ProcurementSystem conversation.
    }
  }
  adaptor ToProcurementSystem to context ProcurementSystem is { 
    handler ToProcurementSystemHandler is {
      on command ProcurementSystem.CreatePurchaseOrder is {
        do "the model sends create purchase order"
      }
      on query ProcurementSystem.GetSupplierSpend is {
        do "the model sends get supplier spend"
      }
      on other is {
        error "Unexpected message for adaptor ToProcurementSystem"
      }
    } with {
      briefly "to procurement system"
      described as {
        |Carries messages to the external ProcurementSystem.
      }
    }
  } with {
    briefly "ProcurementSystem integration"
    described as {
      |The model's side of the ProcurementSystem conversation.
    }
  }
  include "types.riddl"
  include "Supplier.riddl"
  repository SupplierRepository as merge is {
    inlet SupplierRepositoryFromSupplier is type SupplierEvent    inlet SupplierRepositoryFromSupplierMetrics is type SupplierEvent    outlet SupplierRepositoryResponses is type Supplier.SupplierResult
    record StoredSupplier is  {
      supplierId: SupplierId with {
        briefly "supplierId"
        described as {
          |The supplierId column of the stored supplier row.
        }
      }
      status: SupplierStatus with {
        briefly "status"
        described as {
          |The status column of the stored supplier row.
        }
      }
      supplierInfo: SupplierInfo with {
        briefly "supplierInfo"
        described as {
          |The supplierInfo column of the stored supplier row.
        }
      }
    } with {
      briefly "Stored supplier row"
      described as {
        |The persistence shape of supplier data as this repository stores it.
      }
    }
    schema SupplierData is relational
      of suppliers as type StoredSupplier
        index on field StoredSupplier.supplierId
        index on field StoredSupplier.supplierInfo.category
        index on field StoredSupplier.status
 with {
      briefly "Supplier data schema"
      described as {
        |The relational schema holding supplier data for the SupplierRepository.
      }
    }
    handler SupplierPersistence is {
      on query GetSupplierDashboard is {
        do "read the supplier dashboard projection"
        yield result SupplierDashboardView
      }
      on command Supplier.RegisterSupplier is {
        tell event Supplier.SupplierRegistered to entity SupplierContext.Supplier
      }
      on command Supplier.QualifySupplier is {
        tell event Supplier.SupplierQualified to entity SupplierContext.Supplier
      }
      on command Supplier.ActivateSupplier is {
        tell event Supplier.SupplierActivated to entity SupplierContext.Supplier
      }
      on command Supplier.AssignContract is {
        tell event Supplier.ContractAssigned to entity SupplierContext.Supplier
      }
      on command Supplier.RecordPerformance is {
        tell event Supplier.PerformanceRecorded to entity SupplierContext.Supplier
      }
      on command Supplier.AddCertification is {
        tell event Supplier.CertificationAdded to entity SupplierContext.Supplier
      }
      on command Supplier.AssessRisk is {
        tell event Supplier.RiskAssessed to entity SupplierContext.Supplier
      }
      on command Supplier.SuspendSupplier is {
        tell event Supplier.SupplierSuspended to entity SupplierContext.Supplier
      }
      on command Supplier.DisqualifySupplier is {
        tell event Supplier.SupplierDisqualified to entity SupplierContext.Supplier
      }
      on command Supplier.ReinstateSupplier is {
        tell event Supplier.SupplierReinstated to entity SupplierContext.Supplier
      }
    } with {
      briefly "Persists supplier commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Supplier data persistence"
    described as {
      |Persistent storage for suppliers.
    }
  }
  query GetSupplierDashboard is  {
    supplierDashboardKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which supplier dashboard to retrieve.
      }
    }
  } with {
    briefly "Get supplier dashboard"
    described as {
      |Retrieves the supplier dashboard projection.
    }
  }
  result SupplierDashboardView is  {
    supplierDashboard: SupplierMetrics.SupplierDashboard with {
      briefly "Supplier dashboard"
      described as {
        |The supplier dashboard being returned.
      }
    }
  } with {
    briefly "Supplier dashboard view"
    described as {
      |Read model view carrying the supplier dashboard projection.
    }
  }
  projector SupplierMetrics as flow is {
    updates repository SupplierContext.SupplierRepository
    inlet SupplierMetricsFromSupplier is type SupplierEvent    outlet SupplierMetricsOut is type SupplierEvent
    record SupplierDashboard is  {
      totalSuppliers: Natural with {
        briefly "Total"
        described as {
          |Total registered suppliers.
        }
      }
      activeSuppliers: Natural with {
        briefly "Active"
        described as {
          |Active suppliers.
        }
      }
      suspendedSuppliers: Natural with {
        briefly "Suspended"
        described as {
          |Suspended suppliers.
        }
      }
      averagePerformance: Decimal(5,2) with {
        briefly "Avg score"
        described as {
          |Average performance score.
        }
      }
      highRiskCount: Natural with {
        briefly "High risk"
        described as {
          |High risk suppliers.
        }
      }
    } with {
      briefly "Supplier dashboard"
      described as {
        |Supplier management dashboard metrics.
      }
    }
    handler MetricsHandler is {
      on event Supplier.SupplierRegistered is {
        tell event Supplier.SupplierRegistered to repository SupplierContext.SupplierRepository
      }
      on event Supplier.SupplierActivated is {
        tell event Supplier.SupplierActivated to repository SupplierContext.SupplierRepository
      }
      on event Supplier.PerformanceRecorded is {
        tell event Supplier.PerformanceRecorded to repository SupplierContext.SupplierRepository
      }
      on event Supplier.RiskAssessed is {
        tell event Supplier.RiskAssessed to repository SupplierContext.SupplierRepository
      }
      on event Supplier.SupplierSuspended is {
        tell event Supplier.SupplierSuspended to repository SupplierContext.SupplierRepository
      }
      on event Supplier.SupplierDisqualified is {
        tell event Supplier.SupplierDisqualified to repository SupplierContext.SupplierRepository
      }
    } with {
      briefly "Maintains supplier metrics"
      described as {
        |Projects events into dashboard metrics.
      }
    }
  } with {
    briefly "Supplier metrics"
    described as {
      |Supplier management analytics and dashboard.
    }
  }
  type SupplierEvent is one of {
    SupplierContext.Supplier.SupplierRegistered or SupplierContext.Supplier.SupplierActivated or SupplierContext.Supplier.SupplierDisqualified
  } with {
    briefly "Supplier event union"
    described as {
      |Union of Supplier events for streaming.
    }
  }
  processor SupplierEventSource as source is {
    outlet SupplierEvents is type SupplierEvent
    handler SupplierEventEmitter is {
      on init is {
        tell command Supplier.InitializeSupplier to entity SupplierContext.Supplier
      }
      on other is {
        error "Unexpected message for source SupplierEventSource"
      }
      on event Supplier.SupplierRegistered is {
        send event Supplier.SupplierRegistered to outlet SupplierEvents
      }
      on event Supplier.SupplierActivated is {
        send event Supplier.SupplierActivated to outlet SupplierEvents
      }
      on event Supplier.SupplierDisqualified is {
        send event Supplier.SupplierDisqualified to outlet SupplierEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits Supplier events to the stream.
      }
    }
  } with {
    briefly "Supplier event source"
    described as {
      |Publishes Supplier events to the event stream.
    }
  }
  processor SupplierEventSink as sink is {
    inlet IncomingSupplierEvents is type SupplierEvent    handler SupplierEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink SupplierEventSink"
      }
      on event Supplier.SupplierRegistered is {
        tell event Supplier.SupplierRegistered to repository SupplierContext.SupplierRepository
      }
      on event Supplier.SupplierActivated is {
        tell event Supplier.SupplierActivated to repository SupplierContext.SupplierRepository
      }
      on event Supplier.SupplierDisqualified is {
        tell event Supplier.SupplierDisqualified to repository SupplierContext.SupplierRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives Supplier events for persistence.
      }
    }
  } with {
    briefly "Supplier event sink"
    described as {
      |Receives Supplier events from streaming.
    }
  }
  connector SupplierEventPipeline is from outlet SupplierContext.SupplierEventSource.SupplierEvents to inlet SupplierContext.SupplierEventSink.IncomingSupplierEvents with {
    briefly "Supplier event pipeline"
    described as {
      |Wires Supplier event source to sink.
    }
  }
  processor SupplierEventSplit as split is {
    inlet SupplierEventSplitIn is type SupplierEvent    outlet SupplierEventSplitToSupplierRepository is type SupplierEvent
    outlet SupplierEventSplitToSupplierMetrics is type SupplierEvent
    handler SupplierEventSplitHandler is {
      on event Supplier.SupplierRegistered is {
        send event Supplier.SupplierRegistered to outlet SupplierEventSplitToSupplierRepository
        send event Supplier.SupplierRegistered to outlet SupplierEventSplitToSupplierMetrics
        tell event Supplier.SupplierRegistered to entity SupplierContext.Supplier
      }
      on event Supplier.SupplierQualified is {
        send event Supplier.SupplierQualified to outlet SupplierEventSplitToSupplierRepository
        send event Supplier.SupplierQualified to outlet SupplierEventSplitToSupplierMetrics
        tell event Supplier.SupplierQualified to entity SupplierContext.Supplier
      }
      on event Supplier.SupplierActivated is {
        send event Supplier.SupplierActivated to outlet SupplierEventSplitToSupplierRepository
        send event Supplier.SupplierActivated to outlet SupplierEventSplitToSupplierMetrics
        tell event Supplier.SupplierActivated to entity SupplierContext.Supplier
      }
      on event Supplier.ContractAssigned is {
        send event Supplier.ContractAssigned to outlet SupplierEventSplitToSupplierRepository
        send event Supplier.ContractAssigned to outlet SupplierEventSplitToSupplierMetrics
        tell event Supplier.ContractAssigned to entity SupplierContext.Supplier
      }
      on event Supplier.PerformanceRecorded is {
        send event Supplier.PerformanceRecorded to outlet SupplierEventSplitToSupplierRepository
        send event Supplier.PerformanceRecorded to outlet SupplierEventSplitToSupplierMetrics
        tell event Supplier.PerformanceRecorded to entity SupplierContext.Supplier
      }
      on event Supplier.CertificationAdded is {
        send event Supplier.CertificationAdded to outlet SupplierEventSplitToSupplierRepository
        send event Supplier.CertificationAdded to outlet SupplierEventSplitToSupplierMetrics
        tell event Supplier.CertificationAdded to entity SupplierContext.Supplier
      }
      on event Supplier.RiskAssessed is {
        send event Supplier.RiskAssessed to outlet SupplierEventSplitToSupplierRepository
        send event Supplier.RiskAssessed to outlet SupplierEventSplitToSupplierMetrics
        tell event Supplier.RiskAssessed to entity SupplierContext.Supplier
      }
      on event Supplier.SupplierSuspended is {
        send event Supplier.SupplierSuspended to outlet SupplierEventSplitToSupplierRepository
        send event Supplier.SupplierSuspended to outlet SupplierEventSplitToSupplierMetrics
        tell event Supplier.SupplierSuspended to entity SupplierContext.Supplier
      }
      on event Supplier.SupplierDisqualified is {
        send event Supplier.SupplierDisqualified to outlet SupplierEventSplitToSupplierRepository
        send event Supplier.SupplierDisqualified to outlet SupplierEventSplitToSupplierMetrics
        tell event Supplier.SupplierDisqualified to entity SupplierContext.Supplier
      }
      on event Supplier.SupplierReinstated is {
        send event Supplier.SupplierReinstated to outlet SupplierEventSplitToSupplierRepository
        send event Supplier.SupplierReinstated to outlet SupplierEventSplitToSupplierMetrics
        tell event Supplier.SupplierReinstated to entity SupplierContext.Supplier
      }
      on other is {
        error "Unexpected message for processor SupplierEventSplit"
      }
    } with {
      briefly "Supplier event fan-out handler"
      described as {
        |Delivers each Supplier event to all of its consumers.
      }
    }
  } with {
    briefly "Supplier event fan-out"
    described as {
      |Fans Supplier events out to the repository and projectors.
    }
  }
  connector 'SupplierEvent Stream' is from outlet SupplierContext.Supplier.SupplierEvents2 to inlet SupplierContext.SupplierEventSplit.SupplierEventSplitIn with {
    briefly "Supplier events, fanned out to storage and read models"
  }
  connector 'SupplierEvent Storage' is from outlet SupplierContext.SupplierEventSplit.SupplierEventSplitToSupplierRepository to inlet SupplierContext.SupplierRepository.SupplierRepositoryFromSupplier with {
    briefly "Supplier events on their way to storage"
  }
  connector 'SupplierMetrics Feed' is from outlet SupplierContext.SupplierEventSplit.SupplierEventSplitToSupplierMetrics to inlet SupplierContext.SupplierMetrics.SupplierMetricsFromSupplier with {
    briefly "Supplier events feeding the SupplierMetrics projection"
  }
  connector 'SupplierMetrics Storage' is from outlet SupplierContext.SupplierMetrics.SupplierMetricsOut to inlet SupplierContext.SupplierRepository.SupplierRepositoryFromSupplierMetrics with {
    briefly "The SupplierMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for supplier management"
  described as {
    |Supplier lifecycle and relationship management context.
  }
}
