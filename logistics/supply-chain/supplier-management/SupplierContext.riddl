// Supplier Management - Supplier Context
context SupplierContext as router is {
  inlet SupplierContextFromToComplianceRegistry is command Supplier.QualifySupplier with {
    briefly "What ToComplianceRegistry makes of the answers it gets"
  }
  connector 'ToComplianceRegistry Intake' is from outlet SupplierContext.ToComplianceRegistry.ToComplianceRegistryToSupplierContext to inlet SupplierContext.SupplierContextFromToComplianceRegistry with {
    briefly "Answers translated by ToComplianceRegistry, on their way in"
  }
  inlet SupplierContextFromToProcurementSystem is command Supplier.RecordPerformance with {
    briefly "What ToProcurementSystem makes of the answers it gets"
  }
  connector 'ToProcurementSystem Intake' is from outlet SupplierContext.ToProcurementSystem.ToProcurementSystemToSupplierContext to inlet SupplierContext.SupplierContextFromToProcurementSystem with {
    briefly "Answers translated by ToProcurementSystem, on their way in"
  }
  inlet SupplierCommandStreamIn is type SupplierCommand  outlet SupplierCommandStreamOut is type SupplierCommand
  inlet SupplierResultStreamIn is result Supplier.SupplierResult  outlet SupplierResultStreamOut is result Supplier.SupplierResult
  handler SupplierContextBoundary is {
    on registerSupplier: command Supplier.RegisterSupplier is {
      send registerSupplier to outlet SupplierContext.SupplierCommandStreamOut
    }
    on qualifySupplier: command Supplier.QualifySupplier is {
      send qualifySupplier to outlet SupplierContext.SupplierCommandStreamOut
    }
    on activateSupplier: command Supplier.ActivateSupplier is {
      send activateSupplier to outlet SupplierContext.SupplierCommandStreamOut
    }
    on assignContract: command Supplier.AssignContract is {
      send assignContract to outlet SupplierContext.SupplierCommandStreamOut
    }
    on recordPerformance: command Supplier.RecordPerformance is {
      send recordPerformance to outlet SupplierContext.SupplierCommandStreamOut
    }
    on addCertification: command Supplier.AddCertification is {
      send addCertification to outlet SupplierContext.SupplierCommandStreamOut
    }
    on assessRisk: command Supplier.AssessRisk is {
      send assessRisk to outlet SupplierContext.SupplierCommandStreamOut
    }
    on suspendSupplier: command Supplier.SuspendSupplier is {
      send suspendSupplier to outlet SupplierContext.SupplierCommandStreamOut
    }
    on disqualifySupplier: command Supplier.DisqualifySupplier is {
      send disqualifySupplier to outlet SupplierContext.SupplierCommandStreamOut
    }
    on reinstateSupplier: command Supplier.ReinstateSupplier is {
      send reinstateSupplier to outlet SupplierContext.SupplierCommandStreamOut
    }
    on supplierResult: result Supplier.SupplierResult is {
      send supplierResult to outlet SupplierContext.SupplierResultStreamOut
    }
    on other is {
      error "Unexpected message at the SupplierContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'SupplierCommand Stream Intake' is from outlet SupplierContext.SupplierCommandStreamOut to inlet SupplierContext.Supplier.SupplierCommands  connector 'SupplierResult Stream Egress' is from outlet SupplierContext.SupplierRepository.SupplierRepositoryResponses to inlet SupplierContext.SupplierResultStreamIn  adaptor FromComplianceRegistry from context ComplianceRegistry as sink is { 
    inlet FromComplianceRegistryIn is event ComplianceRegistry.ComplianceReportFiled    handler FromComplianceRegistryHandler is {
      on complianceReportFiled: event ComplianceRegistry.ComplianceReportFiled is {
        do "the registry has the report; adding the certification was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromComplianceRegistry"
      }
    } with {
      briefly "from compliance registry"
      described as {
        |Carries messages from the external ComplianceRegistry.
      }
    }
  } with {
    briefly "ComplianceRegistry integration"
    described as {
      |The model's side of the ComplianceRegistry conversation.
    }
  }
  adaptor ToComplianceRegistry to context ComplianceRegistry as router is { 
    outlet ToComplianceRegistryToSupplierContext is command Supplier.QualifySupplier
    inlet ToComplianceRegistryIn is type SupplierEvent    inlet ToComplianceRegistryReplies is result ComplianceRegistry.ComplianceResult    outlet ToComplianceRegistryOut is type ComplianceRegistry.ComplianceRegistryRequest
    handler ToComplianceRegistryHandler is {
      on certificationAdded: event CertificationAdded is {
        let item0: type ComplianceRegistry.SubmitComplianceReport = prompt("translate the certificationAdded event into a SubmitComplianceReport registering the certification the supplier now claims")
        send item0 to outlet SupplierContext.ToComplianceRegistry.ToComplianceRegistryOut
      }
      on supplierRegistered: event Supplier.SupplierRegistered is {
        let askAnswer: type ComplianceRegistry.ComplianceResult = ask query ComplianceRegistry.CheckCompliance of context ComplianceRegistry
        do "a new supplier being unqualified until it is checked"
        when prompt("askAnswer.complianceStatus is compliant") then
          send command Supplier.QualifySupplier(supplierId = supplierRegistered.supplierId, criteria = prompt("the compliance criteria askAnswer checked"), qualifiedBy = prompt("the compliance registry")) to outlet SupplierContext.ToComplianceRegistry.ToComplianceRegistryToSupplierContext
        end
      }
      on other is {
        error "Unexpected message for adaptor ToComplianceRegistry"
      }
    } with {
      briefly "to compliance registry"
      described as {
        |Carries messages to the external ComplianceRegistry.
      }
    }
  } with {
    briefly "ComplianceRegistry integration"
    described as {
      |The model's side of the ComplianceRegistry conversation.
    }
  }
  adaptor FromProcurementSystem from context ProcurementSystem as sink is { 
    inlet FromProcurementSystemIn is event ProcurementSystem.PurchaseOrderCreated    handler FromProcurementSystemHandler is {
      on purchaseOrderCreated: event ProcurementSystem.PurchaseOrderCreated is {
        do "the purchase order exists; assigning the contract was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromProcurementSystem"
      }
    } with {
      briefly "from procurement system"
      described as {
        |Carries messages from the external ProcurementSystem.
      }
    }
  } with {
    briefly "ProcurementSystem integration"
    described as {
      |The model's side of the ProcurementSystem conversation.
    }
  }
  adaptor ToProcurementSystem to context ProcurementSystem as router is { 
    outlet ToProcurementSystemToSupplierContext is command Supplier.RecordPerformance
    inlet ToProcurementSystemIn is type SupplierEvent    inlet ToProcurementSystemReplies is result ProcurementSystem.SupplierSpend    outlet ToProcurementSystemOut is type ProcurementSystem.ProcurementSystemRequest
    handler ToProcurementSystemHandler is {
      on performanceRecorded: event Supplier.PerformanceRecorded is {
        let askAnswer: type ProcurementSystem.SupplierSpend = ask query ProcurementSystem.GetSupplierSpend of context ProcurementSystem
        do "performance being judged partly on what was spent"
        when prompt("the recorded score did not weigh spend") then
          send command Supplier.RecordPerformance(supplierId = performanceRecorded.supplierId, score = prompt("the score weighted by askAnswer.totalSpend over askAnswer.orderCount")) to outlet SupplierContext.ToProcurementSystem.ToProcurementSystemToSupplierContext
        end
      }
      on contractAssigned: event Supplier.ContractAssigned is {
        let item0: type ProcurementSystem.CreatePurchaseOrder = prompt("translate the contractAssigned event into a CreatePurchaseOrder, a contract being what a purchase order draws against")
        send item0 to outlet SupplierContext.ToProcurementSystem.ToProcurementSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToProcurementSystem"
      }
    } with {
      briefly "to procurement system"
      described as {
        |Carries messages to the external ProcurementSystem.
      }
    }
  } with {
    briefly "ProcurementSystem integration"
    described as {
      |The model's side of the ProcurementSystem conversation.
    }
  }
  include "types.riddl"
  include "Supplier.riddl"
  type SupplierRepositoryCommand is one of {
    SupplierContext.SupplierRepository.PersistCertificationAdded or SupplierContext.SupplierRepository.PersistContractAssigned or SupplierContext.SupplierRepository.PersistPerformanceRecorded or SupplierContext.SupplierRepository.PersistRiskAssessed or SupplierContext.SupplierRepository.PersistSupplierActivated or SupplierContext.SupplierRepository.PersistSupplierDisqualified or SupplierContext.SupplierRepository.PersistSupplierQualified or SupplierContext.SupplierRepository.PersistSupplierRegistered or SupplierContext.SupplierRepository.PersistSupplierReinstated or SupplierContext.SupplierRepository.PersistSupplierSuspended
  } with {
    briefly "Anything that writes SupplierRepository"
    described as {
      |The persistence commands SupplierRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository SupplierRepository as flow is {
    inlet SupplierRepositoryFromSupplierMetrics is type SupplierRepositoryCommand    command PersistCertificationAdded is {
      supplierId: SupplierId with {
        briefly "Row addressed"
        described as {
          |Which stored row CertificationAdded applies to.
        }
      }
      certification: CertificationInfo? with {
        briefly "Certification"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CertificationAdded"
      described as {
        |Instructs this repository to apply CertificationAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContractAssigned is {
      supplierId: SupplierId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContractAssigned applies to.
        }
      }
      contract: ContractInfo? with {
        briefly "Contract"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ContractAssigned"
      described as {
        |Instructs this repository to apply ContractAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSupplierQualified is {
      supplierId: SupplierId with {
        briefly "Row addressed"
        described as {
          |Which stored row SupplierQualified applies to.
        }
      }
      criteria: QualificationCriteria? with {
        briefly "Criteria"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      qualifiedAt: TimeStamp? with {
        briefly "Qualified at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SupplierQualified"
      described as {
        |Instructs this repository to apply SupplierQualified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSupplierReinstated is {
      supplierId: SupplierId with {
        briefly "Row addressed"
        described as {
          |Which stored row SupplierReinstated applies to.
        }
      }
      reinstatedAt: TimeStamp? with {
        briefly "Reinstated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SupplierReinstated"
      described as {
        |Instructs this repository to apply SupplierReinstated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPerformanceRecorded is {
      supplierId: SupplierId with {
        briefly "Row addressed"
        described as {
          |Which stored row PerformanceRecorded applies to.
        }
      }
      score: PerformanceScore? with {
        briefly "Score"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PerformanceRecorded"
      described as {
        |Instructs this repository to apply PerformanceRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRiskAssessed is {
      supplierId: SupplierId with {
        briefly "Row addressed"
        described as {
          |Which stored row RiskAssessed applies to.
        }
      }
      assessment: RiskAssessment? with {
        briefly "Assessment"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      assessedAt: TimeStamp? with {
        briefly "Assessed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist RiskAssessed"
      described as {
        |Instructs this repository to apply RiskAssessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSupplierActivated is {
      supplierId: SupplierId with {
        briefly "Row addressed"
        described as {
          |Which stored row SupplierActivated applies to.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SupplierActivated"
      described as {
        |Instructs this repository to apply SupplierActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSupplierDisqualified is {
      supplierId: SupplierId with {
        briefly "Row addressed"
        described as {
          |Which stored row SupplierDisqualified applies to.
        }
      }
      reason: String(3,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      disqualifiedAt: TimeStamp? with {
        briefly "Disqualified at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SupplierDisqualified"
      described as {
        |Instructs this repository to apply SupplierDisqualified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSupplierRegistered is {
      supplierId: SupplierId with {
        briefly "Row addressed"
        described as {
          |Which stored row SupplierRegistered applies to.
        }
      }
      supplierInfo: SupplierInfo? with {
        briefly "Supplier info"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      registeredAt: TimeStamp? with {
        briefly "Registered at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SupplierRegistered"
      described as {
        |Instructs this repository to apply SupplierRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSupplierSuspended is {
      supplierId: SupplierId with {
        briefly "Row addressed"
        described as {
          |Which stored row SupplierSuspended applies to.
        }
      }
      reason: String(3,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      suspendedAt: TimeStamp? with {
        briefly "Suspended at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SupplierSuspended"
      described as {
        |Instructs this repository to apply SupplierSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet SupplierRepositoryResponses is result Supplier.SupplierResult
    record StoredSupplier is {
      supplierId: SupplierId with {
        briefly "supplierId"
        described as {
          |The supplierId column of the stored supplier row.
        }
      }
      status: SupplierStatus with {
        briefly "status"
        described as {
          |The status column of the stored supplier row.
        }
      }
      supplierInfo: SupplierInfo with {
        briefly "supplierInfo"
        described as {
          |The supplierInfo column of the stored supplier row.
        }
      }
      certification: CertificationInfo? with {
        briefly "Certification"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      contract: ContractInfo? with {
        briefly "Contract"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      criteria: QualificationCriteria? with {
        briefly "Criteria"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      qualifiedAt: TimeStamp? with {
        briefly "Qualified at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reinstatedAt: TimeStamp? with {
        briefly "Reinstated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      score: PerformanceScore? with {
        briefly "Score"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      assessment: RiskAssessment? with {
        briefly "Assessment"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      assessedAt: TimeStamp? with {
        briefly "Assessed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(3,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      disqualifiedAt: TimeStamp? with {
        briefly "Disqualified at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      registeredAt: TimeStamp? with {
        briefly "Registered at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      suspendedAt: TimeStamp? with {
        briefly "Suspended at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored supplier row"
      described as {
        |The persistence shape of supplier data as this repository stores it.
      }
    }
    schema SupplierData is relational
      of suppliers as record StoredSupplier
        key on field StoredSupplier.supplierId
        index on field StoredSupplier.supplierInfo.category
        index on field StoredSupplier.status
 with {
      briefly "Supplier data schema"
      described as {
        |The relational schema holding supplier data for the SupplierRepository.
      }
    }
    handler SupplierPersistence is {
      on persistCertificationAdded: command PersistCertificationAdded is {
        update SupplierData.suppliers set certification = persistCertificationAdded.certification, addedAt = persistCertificationAdded.addedAt where supplierId == persistCertificationAdded.supplierId
      }
      on persistContractAssigned: command PersistContractAssigned is {
        update SupplierData.suppliers set contract = persistContractAssigned.contract, assignedAt = persistContractAssigned.assignedAt where supplierId == persistContractAssigned.supplierId
      }
      on persistSupplierQualified: command PersistSupplierQualified is {
        update SupplierData.suppliers set criteria = persistSupplierQualified.criteria, qualifiedAt = persistSupplierQualified.qualifiedAt where supplierId == persistSupplierQualified.supplierId
      }
      on persistSupplierReinstated: command PersistSupplierReinstated is {
        update SupplierData.suppliers set reinstatedAt = persistSupplierReinstated.reinstatedAt where supplierId == persistSupplierReinstated.supplierId
      }
      on persistPerformanceRecorded: command PersistPerformanceRecorded is {
        update SupplierData.suppliers set score = persistPerformanceRecorded.score, recordedAt = persistPerformanceRecorded.recordedAt where supplierId == persistPerformanceRecorded.supplierId
      }
      on persistRiskAssessed: command PersistRiskAssessed is {
        update SupplierData.suppliers set assessment = persistRiskAssessed.assessment, assessedAt = persistRiskAssessed.assessedAt where supplierId == persistRiskAssessed.supplierId
      }
      on persistSupplierActivated: command PersistSupplierActivated is {
        update SupplierData.suppliers set activatedAt = persistSupplierActivated.activatedAt where supplierId == persistSupplierActivated.supplierId
      }
      on persistSupplierDisqualified: command PersistSupplierDisqualified is {
        update SupplierData.suppliers set reason = persistSupplierDisqualified.reason, disqualifiedAt = persistSupplierDisqualified.disqualifiedAt where supplierId == persistSupplierDisqualified.supplierId
      }
      on persistSupplierRegistered: command PersistSupplierRegistered is {
        update SupplierData.suppliers set supplierInfo = persistSupplierRegistered.supplierInfo, registeredAt = persistSupplierRegistered.registeredAt where supplierId == persistSupplierRegistered.supplierId
      }
      on persistSupplierSuspended: command PersistSupplierSuspended is {
        update SupplierData.suppliers set reason = persistSupplierSuspended.reason, suspendedAt = persistSupplierSuspended.suspendedAt where supplierId == persistSupplierSuspended.supplierId
      }
      on query GetSupplierDashboard is {
        let supplierDashboardView: type SupplierDashboardView = prompt("read the supplier dashboard projection")
        reply supplierDashboardView
      }
    } with {
      briefly "Persists supplier commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Supplier data persistence"
    described as {
      |Persistent storage for suppliers.
    }
  }
  query GetSupplierDashboard replies result SupplierDashboardView is {
    supplierDashboardKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which supplier dashboard to retrieve.
      }
    }
  } with {
    briefly "Get supplier dashboard"
    described as {
      |Retrieves the supplier dashboard projection.
    }
  }
  result SupplierDashboardView is {
    supplierDashboard: SupplierMetrics.SupplierDashboard with {
      briefly "Supplier dashboard"
      described as {
        |The supplier dashboard being returned.
      }
    }
  } with {
    briefly "Supplier dashboard view"
    described as {
      |Read model view carrying the supplier dashboard projection.
    }
  }
  projector SupplierMetrics as flow is {
    updates repository SupplierContext.SupplierRepository
    outlet SupplierMetricsToRepository is type SupplierRepositoryCommand
    inlet SupplierMetricsFromSupplier is type SupplierEvent    record SupplierDashboard is {
      totalSuppliers: Natural with {
        briefly "Total"
        described as {
          |Total registered suppliers.
        }
      }
      activeSuppliers: Natural with {
        briefly "Active"
        described as {
          |Active suppliers.
        }
      }
      suspendedSuppliers: Natural with {
        briefly "Suspended"
        described as {
          |Suspended suppliers.
        }
      }
      averagePerformance: Decimal(5,2) with {
        briefly "Avg score"
        described as {
          |Average performance score.
        }
      }
      highRiskCount: Natural with {
        briefly "High risk"
        described as {
          |High risk suppliers.
        }
      }
    } with {
      briefly "Supplier dashboard"
      described as {
        |Supplier management dashboard metrics.
      }
    }
    handler MetricsHandler is {
      on certificationAdded: event Supplier.CertificationAdded is {
        tell command SupplierContext.SupplierRepository.PersistCertificationAdded(supplierId = certificationAdded.supplierId, certification = certificationAdded.certification, addedAt = certificationAdded.addedAt) to repository SupplierContext.SupplierRepository
        do "apply CertificationAdded to the SupplierMetrics projection"
      }
      on contractAssigned: event Supplier.ContractAssigned is {
        tell command SupplierContext.SupplierRepository.PersistContractAssigned(supplierId = contractAssigned.supplierId, contract = contractAssigned.contract, assignedAt = contractAssigned.assignedAt) to repository SupplierContext.SupplierRepository
        do "apply ContractAssigned to the SupplierMetrics projection"
      }
      on supplierQualified: event Supplier.SupplierQualified is {
        tell command SupplierContext.SupplierRepository.PersistSupplierQualified(supplierId = supplierQualified.supplierId, criteria = supplierQualified.criteria, qualifiedAt = supplierQualified.qualifiedAt) to repository SupplierContext.SupplierRepository
        do "apply SupplierQualified to the SupplierMetrics projection"
      }
      on supplierReinstated: event Supplier.SupplierReinstated is {
        tell command SupplierContext.SupplierRepository.PersistSupplierReinstated(supplierId = supplierReinstated.supplierId, reinstatedAt = supplierReinstated.reinstatedAt) to repository SupplierContext.SupplierRepository
        do "apply SupplierReinstated to the SupplierMetrics projection"
      }
      on supplierRegistered: event Supplier.SupplierRegistered is {
        tell command SupplierContext.SupplierRepository.PersistSupplierRegistered(supplierId = supplierRegistered.supplierId, supplierInfo = supplierRegistered.supplierInfo, registeredAt = supplierRegistered.registeredAt) to repository SupplierContext.SupplierRepository
      }
      on supplierActivated: event Supplier.SupplierActivated is {
        tell command SupplierContext.SupplierRepository.PersistSupplierActivated(supplierId = supplierActivated.supplierId, activatedAt = supplierActivated.activatedAt) to repository SupplierContext.SupplierRepository
      }
      on performanceRecorded: event Supplier.PerformanceRecorded is {
        tell command SupplierContext.SupplierRepository.PersistPerformanceRecorded(supplierId = performanceRecorded.supplierId, score = performanceRecorded.score, recordedAt = performanceRecorded.recordedAt) to repository SupplierContext.SupplierRepository
      }
      on riskAssessed: event Supplier.RiskAssessed is {
        tell command SupplierContext.SupplierRepository.PersistRiskAssessed(supplierId = riskAssessed.supplierId, assessment = riskAssessed.assessment, assessedAt = riskAssessed.assessedAt) to repository SupplierContext.SupplierRepository
      }
      on supplierSuspended: event Supplier.SupplierSuspended is {
        tell command SupplierContext.SupplierRepository.PersistSupplierSuspended(supplierId = supplierSuspended.supplierId, reason = supplierSuspended.reason, suspendedAt = supplierSuspended.suspendedAt) to repository SupplierContext.SupplierRepository
      }
      on supplierDisqualified: event Supplier.SupplierDisqualified is {
        tell command SupplierContext.SupplierRepository.PersistSupplierDisqualified(supplierId = supplierDisqualified.supplierId, reason = supplierDisqualified.reason, disqualifiedAt = supplierDisqualified.disqualifiedAt) to repository SupplierContext.SupplierRepository
      }
    } with {
      briefly "Maintains supplier metrics"
      described as {
        |Projects events into dashboard metrics.
      }
    }
  } with {
    briefly "Supplier metrics"
    described as {
      |Supplier management analytics and dashboard.
    }
  }
  type SupplierEvent is one of {
    SupplierContext.Supplier.SupplierRegistered or SupplierContext.Supplier.SupplierActivated or SupplierContext.Supplier.SupplierDisqualified or SupplierContext.Supplier.CertificationAdded or SupplierContext.Supplier.ContractAssigned or SupplierContext.Supplier.PerformanceRecorded or SupplierContext.Supplier.RiskAssessed or SupplierContext.Supplier.SupplierQualified or SupplierContext.Supplier.SupplierReinstated or SupplierContext.Supplier.SupplierSuspended
  } with {
    briefly "Supplier event union"
    described as {
      |Union of Supplier events for streaming.
    }
  }
  streamlet SupplierEventSplit as split is {
    outlet SupplierEventSplitToToProcurementSystem is type SupplierEvent
    outlet SupplierEventSplitToToComplianceRegistry is type SupplierEvent
    inlet SupplierEventSplitIn is type SupplierEvent    outlet SupplierEventSplitToSupplierMetrics is type SupplierEvent
    handler SupplierEventSplitHandler is {
      on supplierRegistered: event Supplier.SupplierRegistered is {
        send supplierRegistered to outlet SupplierEventSplitToSupplierMetrics
        send supplierRegistered to outlet SupplierEventSplitToToComplianceRegistry
        tell supplierRegistered to entity SupplierContext.Supplier
      }
      on supplierQualified: event Supplier.SupplierQualified is {
        send supplierQualified to outlet SupplierEventSplitToSupplierMetrics
        tell supplierQualified to entity SupplierContext.Supplier
      }
      on supplierActivated: event Supplier.SupplierActivated is {
        send supplierActivated to outlet SupplierEventSplitToSupplierMetrics
        tell supplierActivated to entity SupplierContext.Supplier
      }
      on contractAssigned: event Supplier.ContractAssigned is {
        send contractAssigned to outlet SupplierEventSplitToSupplierMetrics
        send contractAssigned to outlet SupplierEventSplitToToProcurementSystem
        tell contractAssigned to entity SupplierContext.Supplier
      }
      on performanceRecorded: event Supplier.PerformanceRecorded is {
        send performanceRecorded to outlet SupplierEventSplitToSupplierMetrics
        send performanceRecorded to outlet SupplierEventSplitToToProcurementSystem
        tell performanceRecorded to entity SupplierContext.Supplier
      }
      on certificationAdded: event Supplier.CertificationAdded is {
        send certificationAdded to outlet SupplierEventSplitToSupplierMetrics
        send certificationAdded to outlet SupplierEventSplitToToComplianceRegistry
        tell certificationAdded to entity SupplierContext.Supplier
      }
      on riskAssessed: event Supplier.RiskAssessed is {
        send riskAssessed to outlet SupplierEventSplitToSupplierMetrics
        tell riskAssessed to entity SupplierContext.Supplier
      }
      on supplierSuspended: event Supplier.SupplierSuspended is {
        send supplierSuspended to outlet SupplierEventSplitToSupplierMetrics
        tell supplierSuspended to entity SupplierContext.Supplier
      }
      on supplierDisqualified: event Supplier.SupplierDisqualified is {
        send supplierDisqualified to outlet SupplierEventSplitToSupplierMetrics
        tell supplierDisqualified to entity SupplierContext.Supplier
      }
      on supplierReinstated: event Supplier.SupplierReinstated is {
        send supplierReinstated to outlet SupplierEventSplitToSupplierMetrics
        tell supplierReinstated to entity SupplierContext.Supplier
      }
      on other is {
        error "Unexpected message for processor SupplierEventSplit"
      }
    } with {
      briefly "Supplier event fan-out handler"
      described as {
        |Delivers each Supplier event to all of its consumers.
      }
    }
  } with {
    briefly "Supplier event fan-out"
    described as {
      |Fans Supplier events out to the repository and projectors.
    }
  }
  connector 'ToProcurementSystem Feed' is from outlet SupplierContext.SupplierEventSplit.SupplierEventSplitToToProcurementSystem to inlet SupplierContext.ToProcurementSystem.ToProcurementSystemIn with {
    briefly "The Supplier events ToProcurementSystem translates, on their way to it"
  }
  connector 'ToComplianceRegistry Feed' is from outlet SupplierContext.SupplierEventSplit.SupplierEventSplitToToComplianceRegistry to inlet SupplierContext.ToComplianceRegistry.ToComplianceRegistryIn with {
    briefly "The Supplier events ToComplianceRegistry translates, on their way to it"
  }
  connector 'SupplierEvent Stream' is from outlet SupplierContext.Supplier.SupplierEvents2 to inlet SupplierContext.SupplierEventSplit.SupplierEventSplitIn with {
    briefly "Supplier events, fanned out to storage and read models"
  }
  connector 'SupplierMetrics Feed' is from outlet SupplierContext.SupplierEventSplit.SupplierEventSplitToSupplierMetrics to inlet SupplierContext.SupplierMetrics.SupplierMetricsFromSupplier with {
    briefly "Supplier events feeding the SupplierMetrics projection"
  }
  connector 'SupplierMetrics Storage' is from outlet SupplierContext.SupplierMetrics.SupplierMetricsToRepository to inlet SupplierContext.SupplierRepository.SupplierRepositoryFromSupplierMetrics with {
    briefly "SupplierMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for supplier management"
  described as {
    |Supplier lifecycle and relationship management context.
  }
}
