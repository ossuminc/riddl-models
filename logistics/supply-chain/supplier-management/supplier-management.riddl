// Supplier Management Domain Model
// Supplier onboarding, qualification, performance, and compliance
domain SupplierManagement is {
  persistent connector 'ProcurementSystemReply Stream' is from outlet ProcurementSystem.ProcurementSystemRepliesOut to inlet SupplierContext.ToProcurementSystem.ToProcurementSystemReplies with {
    briefly "What ProcurementSystem answers SupplierContext"
  }
  persistent connector 'ComplianceRegistryReply Stream' is from outlet ComplianceRegistry.ComplianceRegistryRepliesOut to inlet SupplierContext.ToComplianceRegistry.ToComplianceRegistryReplies with {
    briefly "What ComplianceRegistry answers SupplierContext"
  }
  persistent connector 'ComplianceRegistryEvent Stream' is from outlet ComplianceRegistry.ComplianceRegistryEventsOut to inlet SupplierContext.FromComplianceRegistry.FromComplianceRegistryIn with {
    briefly "What ComplianceRegistry tells SupplierContext, unasked"
  }
  persistent connector 'ProcurementSystemEvent Stream' is from outlet ProcurementSystem.ProcurementSystemEventsOut to inlet SupplierContext.FromProcurementSystem.FromProcurementSystemIn with {
    briefly "What ProcurementSystem tells SupplierContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ProcurementManager is "person managing supplier relationships" with {
    briefly "Procurement Manager"
    described as {
      |Manager overseeing supplier selection and contracts.
    }
  }
  user ComplianceOfficer is "person ensuring supplier compliance" with {
    briefly "Compliance Officer"
    described as {
      |Officer tracking regulatory and policy compliance.
    }
  }
  user QualityAnalyst is "person evaluating supplier performance" with {
    briefly "Quality Analyst"
    described as {
      |Analyst scoring and reviewing supplier performance.
    }
  }
  epic SupplierOnboarding is {
    user ProcurementManager wants to "to onboard and qualify new suppliers" so that "the organization has vetted supply chain partners"
    case OnboardNewSupplier is {
      user ProcurementManager wants to "to register a new supplier" so that "the supplier can be evaluated and contracted"
      step is "Manager submits" "supplier application" "with documents" with {
        briefly "Submit application"
        described as {
          |Register supplier details.
        }
      }
      step is "System qualifies" "supplier credentials" "against criteria" with {
        briefly "Qualify supplier"
        described as {
          |Evaluate supplier qualifications.
        }
      }
    } with {
      briefly "Onboard new supplier"
      described as {
        |Registering and qualifying a new supplier.
      }
    }
  } with {
    briefly "Supplier onboarding"
    described as {
      |Epic for supplier registration and qualification.
    }
  }
  include "SupplierContext.riddl"
  include "external-contexts.riddl"
  application context SupplierManagementApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in SupplierManagement are delivered.
      }
    }
    group SupplierManagementScreen is {
      input GetSupplierDashboardInput acquires query SupplierContext.GetSupplierDashboard with {
        briefly "Get supplier dashboard control"
        described as {
          |The control through which a user asks the get supplier dashboard question.
        }
      }
      input GetSupplierInput acquires query SupplierContext.Supplier.GetSupplier with {
        briefly "Get supplier control"
        described as {
          |The control through which a user asks the get supplier question.
        }
      }
      input RegisterSupplierInput acquires command SupplierContext.RegisterSupplier with {
        briefly "Register supplier control"
        described as {
          |The control through which a user submits the register supplier request.
        }
      }
      input ActivateSupplierInput acquires command SupplierContext.Supplier.ActivateSupplier with {
        briefly "Activate supplier control"
        described as {
          |The control through which a user submits the activate supplier request.
        }
      }
      input AddCertificationInput acquires command SupplierContext.Supplier.AddCertification with {
        briefly "Add certification control"
        described as {
          |The control through which a user submits the add certification request.
        }
      }
      input AssessRiskInput acquires command SupplierContext.Supplier.AssessRisk with {
        briefly "Assess risk control"
        described as {
          |The control through which a user submits the assess risk request.
        }
      }
      input AssignContractInput acquires command SupplierContext.Supplier.AssignContract with {
        briefly "Assign contract control"
        described as {
          |The control through which a user submits the assign contract request.
        }
      }
      input DisqualifySupplierInput acquires command SupplierContext.Supplier.DisqualifySupplier with {
        briefly "Disqualify supplier control"
        described as {
          |The control through which a user submits the disqualify supplier request.
        }
      }
      input ReinstateSupplierInput acquires command SupplierContext.Supplier.ReinstateSupplier with {
        briefly "Reinstate supplier control"
        described as {
          |The control through which a user submits the reinstate supplier request.
        }
      }
      input SuspendSupplierInput acquires command SupplierContext.Supplier.SuspendSupplier with {
        briefly "Suspend supplier control"
        described as {
          |The control through which a user submits the suspend supplier request.
        }
      }
    } with {
      briefly "Supplier management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppSupplierRepositoryQueries is query SupplierContext.GetSupplierDashboard
    inlet AppSupplierRepositoryReplies is result SupplierContext.SupplierDashboardView
    outlet AppSupplierQueries is query SupplierContext.Supplier.GetSupplier
    outlet AppSupplierCommands is type SupplierContext.SupplierRequest
    inlet AppSupplierRepositoryResponses is result SupplierContext.Supplier.SupplierResult
    handler SupplierManagementAppHandler is {
      on other is {
        error "Unexpected message for application context SupplierManagementApp"
      }
    } with {
      briefly "SupplierManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "SupplierManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ProcurementSystemRequest Stream' is from outlet SupplierContext.ToProcurementSystem.ToProcurementSystemOut to inlet ProcurementSystem.ProcurementSystemRequests with {
    briefly "What SupplierContext asks ProcurementSystem to send"
  }
  persistent connector 'ComplianceRegistryRequest Stream' is from outlet SupplierContext.ToComplianceRegistry.ToComplianceRegistryOut to inlet ComplianceRegistry.ComplianceRegistryRequests with {
    briefly "What SupplierContext asks ComplianceRegistry to send"
  }
  persistent connector 'SupplierRepositoryQuery Stream' is from outlet SupplierManagementApp.AppSupplierRepositoryQueries to inlet SupplierContext.SupplierRepositoryQueriesIn with {
    briefly "SupplierManagementApp's look-ups of the supplier repository"
  }
  persistent connector 'SupplierRepositoryReply Stream' is from outlet SupplierContext.SupplierRepositoryRepliesOut to inlet SupplierManagementApp.AppSupplierRepositoryReplies with {
    briefly "The supplier repository's answers returned to SupplierManagementApp"
  }
  persistent connector 'SupplierQuery Stream' is from outlet SupplierManagementApp.AppSupplierQueries to inlet SupplierContext.SupplierQueriesIn with {
    briefly "SupplierManagementApp's look-ups of the supplier"
  }
  persistent connector 'SupplierCommand Stream' is from outlet SupplierManagementApp.AppSupplierCommands to inlet SupplierContext.SupplierCommandStreamIn with {
    briefly "Supplier commands from the application"
  }
  persistent connector 'SupplierResult Stream' is from outlet SupplierContext.SupplierResultStreamOut to inlet SupplierManagementApp.AppSupplierRepositoryResponses with {
    briefly "Supplier query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet SupplierManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Supplier management domain"
  described as {
    |Supplier onboarding, qualification, performance, and compliance.
  }
}
