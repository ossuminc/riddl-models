// Supplier Management Domain Model
// Supplier onboarding, qualification, performance, and compliance
domain SupplierManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ProcurementManager is "person managing supplier relationships" with {
    briefly "Procurement Manager"
    described as {
      |Manager overseeing supplier selection and contracts.
    }
  }
  user ComplianceOfficer is "person ensuring supplier compliance" with {
    briefly "Compliance Officer"
    described as {
      |Officer tracking regulatory and policy compliance.
    }
  }
  user QualityAnalyst is "person evaluating supplier performance" with {
    briefly "Quality Analyst"
    described as {
      |Analyst scoring and reviewing supplier performance.
    }
  }
  epic SupplierOnboarding is {
    user ProcurementManager wants to "to onboard and qualify new suppliers" so that "the organization has vetted supply chain partners"
    case OnboardNewSupplier is {
      user ProcurementManager wants to "to register a new supplier" so that "the supplier can be evaluated and contracted"
      step is "Manager submits" "supplier application" "with documents" with {
        briefly "Submit application"
        described as {
          |Register supplier details.
        }
      }
      step is "System qualifies" "supplier credentials" "against criteria" with {
        briefly "Qualify supplier"
        described as {
          |Evaluate supplier qualifications.
        }
      }
    } with {
      briefly "Onboard new supplier"
      described as {
        |Registering and qualifying a new supplier.
      }
    }
  } with {
    briefly "Supplier onboarding"
    described as {
      |Epic for supplier registration and qualification.
    }
  }
  include "SupplierContext.riddl"
  include "external-contexts.riddl"
  application context SupplierManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in SupplierManagement are delivered.
      }
    }
    outlet AppSupplierCommands is type SupplierContext.Supplier.SupplierCommand
    inlet AppSupplierRepositoryResponses is type SupplierContext.Supplier.SupplierResult    handler SupplierManagementAppHandler is {
      on other is {
        error "Unexpected message for application context SupplierManagementApp"
      }
    } with {
      briefly "SupplierManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "SupplierManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'SupplierCommand Stream' is from outlet SupplierManagementApp.AppSupplierCommands to inlet SupplierContext.SupplierCommandStreamIn with {
    briefly "Supplier commands from the application"
  }
  persistent connector 'SupplierResult Stream' is from outlet SupplierContext.SupplierResultStreamOut to inlet SupplierManagementApp.AppSupplierRepositoryResponses with {
    briefly "Supplier query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet SupplierManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Supplier management domain"
  described as {
    |Supplier onboarding, qualification, performance, and compliance.
  }
}
