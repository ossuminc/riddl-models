// Supplier Management - External Contexts
external context ComplianceRegistry as split is {
  outlet ComplianceRegistryRepliesOut is result ComplianceResult
 with {
    briefly "What this service answers, on its way back"
  }
  outlet ComplianceRegistryEventsOut is event ComplianceReportFiled
 with {
    briefly "What this service tells the model, unasked"
  }
  type ComplianceRegistryRequest is one of {
    SubmitComplianceReport or CheckCompliance
  } with {
    briefly "Everything this service can be asked"
  }
  inlet ComplianceRegistryRequests is type ComplianceRegistryRequest with {
    briefly "What this context asks the service to send"
  }
  handler ComplianceRegistryBoundary is {
    on query CheckCompliance is {
      let askAnswer: type ComplianceResult = prompt("look up what CheckCompliance asks for")
      reply askAnswer
    }
    on command SubmitComplianceReport is {
      let complianceReportFiled: type ComplianceReportFiled = prompt("the compliance report filed this produces")
      send complianceReportFiled to outlet ComplianceRegistry.ComplianceRegistryEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context ComplianceRegistry"
    }
  } with {
    briefly "ComplianceRegistry boundary"
  }
  query CheckCompliance replies result ComplianceResult is {
    supplierId: SupplierId with {
      briefly "Supplier"
      described as {
        |Supplier ID.
      }
    }
    regulationType: String(3,100) with {
      briefly "Type"
      described as {
        |Regulation type.
      }
    }
  } with {
    briefly "Check compliance"
    described as {
      |Checks supplier regulatory compliance.
    }
  }
  result ComplianceResult is {
    supplierId: SupplierId with {
      briefly "Supplier"
      described as {
        |Supplier ID.
      }
    }
    complianceStatus: ComplianceStatus with {
      briefly "Status"
      described as {
        |Compliance status.
      }
    }
    details: String(3,1000) with {
      briefly "Details"
      described as {
        |Compliance details.
      }
    }
    checkedAt: TimeStamp with {
      briefly "Checked"
      described as {
        |Check timestamp.
      }
    }
  } with {
    briefly "Compliance result"
    described as {
      |Supplier compliance check result.
    }
  }
  command SubmitComplianceReport is {
    supplierId: SupplierId with {
      briefly "Supplier"
      described as {
        |Supplier ID.
      }
    }
    reportType: String(3,100) with {
      briefly "Type"
      described as {
        |Report type.
      }
    }
    reportData: String(3,5000) with {
      briefly "Data"
      described as {
        |Report content.
      }
    }
  } with {
    briefly "Submit compliance report"
    described as {
      |Submits a compliance report for a supplier.
    }
  }
  event ComplianceReportFiled is {
    supplierId: SupplierId with {
      briefly "Supplier"
      described as {
        |Supplier ID.
      }
    }
    reportType: String(3,100) with {
      briefly "Type"
      described as {
        |Report type.
      }
    }
    filedAt: TimeStamp with {
      briefly "Filed"
      described as {
        |Filing timestamp.
      }
    }
  } with {
    briefly "Compliance report filed"
    described as {
      |Emitted when a compliance report is filed.
    }
  }
} with {
  briefly "External compliance registry"
  described as {
    |Regulatory compliance management system.
  }
}
external context ProcurementSystem as split is {
  outlet ProcurementSystemRepliesOut is result SupplierSpend
 with {
    briefly "What this service answers, on its way back"
  }
  outlet ProcurementSystemEventsOut is event PurchaseOrderCreated
 with {
    briefly "What this service tells the model, unasked"
  }
  type ProcurementSystemRequest is one of {
    CreatePurchaseOrder or GetSupplierSpend
  } with {
    briefly "Everything this service can be asked"
  }
  inlet ProcurementSystemRequests is type ProcurementSystemRequest with {
    briefly "What this context asks the service to send"
  }
  handler ProcurementSystemBoundary is {
    on query GetSupplierSpend is {
      let askAnswer: type SupplierSpend = prompt("look up what GetSupplierSpend asks for")
      reply askAnswer
    }
    on command CreatePurchaseOrder is {
      let purchaseOrderCreated: type PurchaseOrderCreated = prompt("the purchase order created this produces")
      send purchaseOrderCreated to outlet ProcurementSystem.ProcurementSystemEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context ProcurementSystem"
    }
  } with {
    briefly "ProcurementSystem boundary"
  }
  command CreatePurchaseOrder is {
    supplierId: SupplierId with {
      briefly "Supplier"
      described as {
        |Supplier ID.
      }
    }
    orderAmount: Decimal(12,2) with {
      briefly "Amount"
      described as {
        |Order amount.
      }
    }
    items: String(3,2000) with {
      briefly "Items"
      described as {
        |Ordered items description.
      }
    }
    deliveryDate: Date with {
      briefly "Delivery"
      described as {
        |Requested delivery date.
      }
    }
  } with {
    briefly "Create purchase order"
    described as {
      |Creates a purchase order for a supplier.
    }
  }
  event PurchaseOrderCreated is {
    supplierId: SupplierId with {
      briefly "Supplier"
      described as {
        |Supplier ID.
      }
    }
    orderId: UUID with {
      briefly "Order"
      described as {
        |Purchase order ID.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation timestamp.
      }
    }
  } with {
    briefly "Purchase order created"
    described as {
      |Emitted when a purchase order is created.
    }
  }
  query GetSupplierSpend replies result SupplierSpend is {
    supplierId: SupplierId with {
      briefly "Supplier"
      described as {
        |Supplier ID.
      }
    }
    fromDate: Date with {
      briefly "From"
      described as {
        |Start date.
      }
    }
    toDate: Date with {
      briefly "To"
      described as {
        |End date.
      }
    }
  } with {
    briefly "Get supplier spend"
    described as {
      |Retrieves spend history for a supplier.
    }
  }
  result SupplierSpend is {
    supplierId: SupplierId with {
      briefly "Supplier"
      described as {
        |Supplier ID.
      }
    }
    totalSpend: Decimal(14,2) with {
      briefly "Total"
      described as {
        |Total spend amount.
      }
    }
    orderCount: Natural with {
      briefly "Orders"
      described as {
        |Number of orders.
      }
    }
  } with {
    briefly "Supplier spend"
    described as {
      |Supplier spend summary.
    }
  }
} with {
  briefly "External procurement system"
  described as {
    |Enterprise procurement and purchasing system.
  }
}
