// Inventory Control - Inventory Control Context
context InventoryControlContext as router is {
  inlet InventoryItemCommandStreamIn is type InventoryItemCommand  outlet InventoryItemCommandStreamOut is type InventoryItemCommand
  inlet StockItemResultStreamIn is result InventoryItem.InventoryItemResult  outlet StockItemResultStreamOut is result InventoryItem.InventoryItemResult
  handler InventoryControlContextBoundary is {
    on createInventoryItem: command InventoryItem.CreateInventoryItem is {
      send createInventoryItem to outlet InventoryControlContext.InventoryItemCommandStreamOut
    }
    on adjustQuantity: command InventoryItem.AdjustQuantity is {
      send adjustQuantity to outlet InventoryControlContext.InventoryItemCommandStreamOut
    }
    on reserveStock: command InventoryItem.ReserveStock is {
      send reserveStock to outlet InventoryControlContext.InventoryItemCommandStreamOut
    }
    on releaseReservation: command InventoryItem.ReleaseReservation is {
      send releaseReservation to outlet InventoryControlContext.InventoryItemCommandStreamOut
    }
    on recordCycleCount: command InventoryItem.RecordCycleCount is {
      send recordCycleCount to outlet InventoryControlContext.InventoryItemCommandStreamOut
    }
    on relocateItem: command InventoryItem.RelocateItem is {
      send relocateItem to outlet InventoryControlContext.InventoryItemCommandStreamOut
    }
    on triggerReplenishment: command InventoryItem.TriggerReplenishment is {
      send triggerReplenishment to outlet InventoryControlContext.InventoryItemCommandStreamOut
    }
    on quarantineStock: command InventoryItem.QuarantineStock is {
      send quarantineStock to outlet InventoryControlContext.InventoryItemCommandStreamOut
    }
    on deactivateItem: command InventoryItem.DeactivateItem is {
      send deactivateItem to outlet InventoryControlContext.InventoryItemCommandStreamOut
    }
    on inventoryItemResult: result InventoryItem.InventoryItemResult is {
      send inventoryItemResult to outlet InventoryControlContext.StockItemResultStreamOut
    }
    on other is {
      error "Unexpected message at the InventoryControlContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'InventoryItemCommand Stream Intake' is from outlet InventoryControlContext.InventoryItemCommandStreamOut to inlet InventoryControlContext.InventoryItem.InventoryItemCommands  connector 'StockItemResult Stream Egress' is from outlet InventoryControlContext.InventoryRepository.InventoryRepositoryResponses to inlet InventoryControlContext.StockItemResultStreamIn  adaptor FromERPSystem from context ERPSystem is { 
    handler FromERPSystemHandler is {
      on event ERPSystem.InventoryLevelsSynced is {
        do "the model receives inventory levels synced"
      }
      on result ERPSystem.ProductInfo is {
        do "the model receives product info"
      }
      on other is {
        error "Unexpected message for adaptor FromERPSystem"
      }
    } with {
      briefly "from erp system"
      described as {
        |Carries messages from the external ERPSystem.
      }
    }
  } with {
    briefly "ERPSystem integration"
    described as {
      |The model's side of the ERPSystem conversation.
    }
  }
  adaptor ToERPSystem to context ERPSystem is { 
    handler ToERPSystemHandler is {
      on query ERPSystem.GetProductInfo is {
        do "the model sends get product info"
      }
      on command ERPSystem.SyncInventoryLevels is {
        do "the model sends sync inventory levels"
      }
      on other is {
        error "Unexpected message for adaptor ToERPSystem"
      }
    } with {
      briefly "to erp system"
      described as {
        |Carries messages to the external ERPSystem.
      }
    }
  } with {
    briefly "ERPSystem integration"
    described as {
      |The model's side of the ERPSystem conversation.
    }
  }
  adaptor FromPurchasingSystem from context PurchasingSystem is { 
    handler FromPurchasingSystemHandler is {
      on event PurchasingSystem.PurchaseOrderCreated is {
        do "the model receives purchase order created"
      }
      on result PurchasingSystem.PurchaseOrderStatus is {
        do "the model receives purchase order status"
      }
      on other is {
        error "Unexpected message for adaptor FromPurchasingSystem"
      }
    } with {
      briefly "from purchasing system"
      described as {
        |Carries messages from the external PurchasingSystem.
      }
    }
  } with {
    briefly "PurchasingSystem integration"
    described as {
      |The model's side of the PurchasingSystem conversation.
    }
  }
  adaptor ToPurchasingSystem to context PurchasingSystem is { 
    handler ToPurchasingSystemHandler is {
      on command PurchasingSystem.CreatePurchaseOrder is {
        do "the model sends create purchase order"
      }
      on query PurchasingSystem.GetPurchaseOrderStatus is {
        do "the model sends get purchase order status"
      }
      on other is {
        error "Unexpected message for adaptor ToPurchasingSystem"
      }
    } with {
      briefly "to purchasing system"
      described as {
        |Carries messages to the external PurchasingSystem.
      }
    }
  } with {
    briefly "PurchasingSystem integration"
    described as {
      |The model's side of the PurchasingSystem conversation.
    }
  }
  include "types.riddl"
  include "InventoryItem.riddl"
  type InventoryRepositoryCommand is one of {
    InventoryControlContext.InventoryRepository.PersistCycleCountRecorded or InventoryControlContext.InventoryRepository.PersistInventoryItemCreated or InventoryControlContext.InventoryRepository.PersistItemDeactivated or InventoryControlContext.InventoryRepository.PersistItemRelocated or InventoryControlContext.InventoryRepository.PersistQuantityAdjusted or InventoryControlContext.InventoryRepository.PersistReplenishmentTriggered or InventoryControlContext.InventoryRepository.PersistReservationReleased or InventoryControlContext.InventoryRepository.PersistStockQuarantined or InventoryControlContext.InventoryRepository.PersistStockReserved
  } with {
    briefly "Anything that writes InventoryRepository"
    described as {
      |The persistence commands InventoryRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository InventoryRepository as flow is {
    inlet InventoryRepositoryFromInventoryAccuracyMetrics is type InventoryRepositoryCommand    command PersistInventoryItemCreated is {
      itemId: InventoryItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryItemCreated applies to.
        }
      }
    } with {
      briefly "Persist InventoryItemCreated"
      described as {
        |Instructs this repository to apply InventoryItemCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemDeactivated is {
      itemId: InventoryItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemDeactivated applies to.
        }
      }
    } with {
      briefly "Persist ItemDeactivated"
      described as {
        |Instructs this repository to apply ItemDeactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemRelocated is {
      itemId: InventoryItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemRelocated applies to.
        }
      }
    } with {
      briefly "Persist ItemRelocated"
      described as {
        |Instructs this repository to apply ItemRelocated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationReleased is {
      itemId: InventoryItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationReleased applies to.
        }
      }
    } with {
      briefly "Persist ReservationReleased"
      described as {
        |Instructs this repository to apply ReservationReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStockQuarantined is {
      itemId: InventoryItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row StockQuarantined applies to.
        }
      }
    } with {
      briefly "Persist StockQuarantined"
      described as {
        |Instructs this repository to apply StockQuarantined to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStockReserved is {
      itemId: InventoryItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row StockReserved applies to.
        }
      }
    } with {
      briefly "Persist StockReserved"
      described as {
        |Instructs this repository to apply StockReserved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCycleCountRecorded is {
      itemId: InventoryItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row CycleCountRecorded applies to.
        }
      }
    } with {
      briefly "Persist CycleCountRecorded"
      described as {
        |Instructs this repository to apply CycleCountRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistQuantityAdjusted is {
      itemId: InventoryItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row QuantityAdjusted applies to.
        }
      }
    } with {
      briefly "Persist QuantityAdjusted"
      described as {
        |Instructs this repository to apply QuantityAdjusted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReplenishmentTriggered is {
      itemId: InventoryItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReplenishmentTriggered applies to.
        }
      }
    } with {
      briefly "Persist ReplenishmentTriggered"
      described as {
        |Instructs this repository to apply ReplenishmentTriggered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet InventoryRepositoryResponses is result InventoryItem.InventoryItemResult
    record StoredInventoryItem is {
      inventoryItemId: InventoryItemId with {
        briefly "inventoryItemId"
        described as {
          |The inventoryItemId column of the stored inventoryItem row.
        }
      }
      itemId: InventoryItemId with {
        briefly "itemId"
        described as {
          |The itemId column of the stored inventoryItem row.
        }
      }
      itemInfo: InventoryItemInfo with {
        briefly "itemInfo"
        described as {
          |The itemInfo column of the stored inventoryItem row.
        }
      }
      status: ItemStatus with {
        briefly "status"
        described as {
          |The status column of the stored inventoryItem row.
        }
      }
    } with {
      briefly "Stored inventoryItem row"
      described as {
        |The persistence shape of inventoryItem data as this repository stores it.
      }
    }
    schema InventoryData is relational
      of inventoryItems as record StoredInventoryItem
        index on field StoredInventoryItem.itemId
        index on field StoredInventoryItem.itemInfo.productId
        index on field StoredInventoryItem.itemInfo.warehouseId
        index on field StoredInventoryItem.status
 with {
      briefly "Inventory data schema"
      described as {
        |The relational schema holding inventory data for the InventoryRepository.
      }
    }
    handler InventoryPersistence is {
      on persistInventoryItemCreated: command PersistInventoryItemCreated is {
        do "apply InventoryItemCreated to the stored row"
      }
      on persistItemDeactivated: command PersistItemDeactivated is {
        do "apply ItemDeactivated to the stored row"
      }
      on persistItemRelocated: command PersistItemRelocated is {
        do "apply ItemRelocated to the stored row"
      }
      on persistReservationReleased: command PersistReservationReleased is {
        do "apply ReservationReleased to the stored row"
      }
      on persistStockQuarantined: command PersistStockQuarantined is {
        do "apply StockQuarantined to the stored row"
      }
      on persistStockReserved: command PersistStockReserved is {
        do "apply StockReserved to the stored row"
      }
      on persistCycleCountRecorded: command PersistCycleCountRecorded is {
        do "apply CycleCountRecorded to the stored row"
      }
      on persistQuantityAdjusted: command PersistQuantityAdjusted is {
        do "apply QuantityAdjusted to the stored row"
      }
      on persistReplenishmentTriggered: command PersistReplenishmentTriggered is {
        do "apply ReplenishmentTriggered to the stored row"
      }
      on query GetWarehouseAccuracy is {
        let warehouseAccuracyView: type WarehouseAccuracyView = prompt("read the warehouse accuracy projection")
        reply warehouseAccuracyView
      }
    } with {
      briefly "Persists inventory commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Inventory data persistence"
    described as {
      |Persistent storage for inventory items.
    }
  }
  query GetWarehouseAccuracy replies result WarehouseAccuracyView is {
    warehouseAccuracyKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which warehouse accuracy to retrieve.
      }
    }
  } with {
    briefly "Get warehouse accuracy"
    described as {
      |Retrieves the warehouse accuracy projection.
    }
  }
  result WarehouseAccuracyView is {
    warehouseAccuracy: InventoryAccuracyMetrics.WarehouseAccuracy with {
      briefly "Warehouse accuracy"
      described as {
        |The warehouse accuracy being returned.
      }
    }
  } with {
    briefly "Warehouse accuracy view"
    described as {
      |Read model view carrying the warehouse accuracy projection.
    }
  }
  projector InventoryAccuracyMetrics as flow is {
    updates repository InventoryControlContext.InventoryRepository
    outlet InventoryAccuracyMetricsToRepository is type InventoryRepositoryCommand
    inlet InventoryAccuracyMetricsFromInventoryItem is type InventoryItemEvent    record WarehouseAccuracy is {
      totalItemsCounted: Natural with {
        briefly "Counted"
        described as {
          |Items counted.
        }
      }
      accurateCount: Natural with {
        briefly "Accurate"
        described as {
          |Accurate counts.
        }
      }
      varianceCount: Natural with {
        briefly "Variances"
        described as {
          |Counts with variance.
        }
      }
      accuracyPercentage: Decimal(5,2) with {
        briefly "Accuracy"
        described as {
          |Accuracy percentage.
        }
      }
      totalAdjustments: Natural with {
        briefly "Adjustments"
        described as {
          |Total adjustments made.
        }
      }
    } with {
      briefly "Warehouse accuracy"
      described as {
        |Warehouse inventory accuracy metrics.
      }
    }
    handler AccuracyMetricsHandler is {
      on inventoryItemCreated: event InventoryItem.InventoryItemCreated is {
        tell command InventoryControlContext.InventoryRepository.PersistInventoryItemCreated(itemId = inventoryItemCreated.itemId) to repository InventoryControlContext.InventoryRepository
        do "apply InventoryItemCreated to the InventoryAccuracyMetrics projection"
      }
      on itemDeactivated: event InventoryItem.ItemDeactivated is {
        tell command InventoryControlContext.InventoryRepository.PersistItemDeactivated(itemId = itemDeactivated.itemId) to repository InventoryControlContext.InventoryRepository
        do "apply ItemDeactivated to the InventoryAccuracyMetrics projection"
      }
      on itemRelocated: event InventoryItem.ItemRelocated is {
        tell command InventoryControlContext.InventoryRepository.PersistItemRelocated(itemId = itemRelocated.itemId) to repository InventoryControlContext.InventoryRepository
        do "apply ItemRelocated to the InventoryAccuracyMetrics projection"
      }
      on reservationReleased: event InventoryItem.ReservationReleased is {
        tell command InventoryControlContext.InventoryRepository.PersistReservationReleased(itemId = reservationReleased.itemId) to repository InventoryControlContext.InventoryRepository
        do "apply ReservationReleased to the InventoryAccuracyMetrics projection"
      }
      on stockQuarantined: event InventoryItem.StockQuarantined is {
        tell command InventoryControlContext.InventoryRepository.PersistStockQuarantined(itemId = stockQuarantined.itemId) to repository InventoryControlContext.InventoryRepository
        do "apply StockQuarantined to the InventoryAccuracyMetrics projection"
      }
      on stockReserved: event InventoryItem.StockReserved is {
        tell command InventoryControlContext.InventoryRepository.PersistStockReserved(itemId = stockReserved.itemId) to repository InventoryControlContext.InventoryRepository
        do "apply StockReserved to the InventoryAccuracyMetrics projection"
      }
      on cycleCountRecorded: event InventoryItem.CycleCountRecorded is {
        tell command InventoryControlContext.InventoryRepository.PersistCycleCountRecorded(itemId = cycleCountRecorded.itemId) to repository InventoryControlContext.InventoryRepository
      }
      on quantityAdjusted: event InventoryItem.QuantityAdjusted is {
        tell command InventoryControlContext.InventoryRepository.PersistQuantityAdjusted(itemId = quantityAdjusted.itemId) to repository InventoryControlContext.InventoryRepository
      }
      on replenishmentTriggered: event InventoryItem.ReplenishmentTriggered is {
        tell command InventoryControlContext.InventoryRepository.PersistReplenishmentTriggered(itemId = replenishmentTriggered.itemId) to repository InventoryControlContext.InventoryRepository
      }
    } with {
      briefly "Maintains accuracy metrics"
      described as {
        |Projects events into accuracy metrics.
      }
    }
  } with {
    briefly "Inventory accuracy metrics"
    described as {
      |Inventory accuracy and count analytics.
    }
  }
  type InventoryItemEvent is one of {
    InventoryControlContext.InventoryItem.InventoryItemCreated or InventoryControlContext.InventoryItem.QuantityAdjusted or InventoryControlContext.InventoryItem.ItemDeactivated or InventoryControlContext.InventoryItem.CycleCountRecorded or InventoryControlContext.InventoryItem.ItemRelocated or InventoryControlContext.InventoryItem.ReplenishmentTriggered or InventoryControlContext.InventoryItem.ReservationReleased or InventoryControlContext.InventoryItem.StockQuarantined or InventoryControlContext.InventoryItem.StockReserved
  } with {
    briefly "InventoryItem event union"
    described as {
      |Union of InventoryItem events for streaming.
    }
  }
  processor InventoryItemEventSplit as flow is {
    inlet InventoryItemEventSplitIn is type InventoryItemEvent    outlet InventoryItemEventSplitToInventoryAccuracyMetrics is type InventoryItemEvent
    handler InventoryItemEventSplitHandler is {
      on inventoryItemCreated: event InventoryItem.InventoryItemCreated is {
        send inventoryItemCreated to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell inventoryItemCreated to entity InventoryControlContext.InventoryItem
      }
      on quantityAdjusted: event InventoryItem.QuantityAdjusted is {
        send quantityAdjusted to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell quantityAdjusted to entity InventoryControlContext.InventoryItem
      }
      on stockReserved: event InventoryItem.StockReserved is {
        send stockReserved to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell stockReserved to entity InventoryControlContext.InventoryItem
      }
      on reservationReleased: event InventoryItem.ReservationReleased is {
        send reservationReleased to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell reservationReleased to entity InventoryControlContext.InventoryItem
      }
      on cycleCountRecorded: event InventoryItem.CycleCountRecorded is {
        send cycleCountRecorded to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell cycleCountRecorded to entity InventoryControlContext.InventoryItem
      }
      on itemRelocated: event InventoryItem.ItemRelocated is {
        send itemRelocated to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell itemRelocated to entity InventoryControlContext.InventoryItem
      }
      on replenishmentTriggered: event InventoryItem.ReplenishmentTriggered is {
        send replenishmentTriggered to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell replenishmentTriggered to entity InventoryControlContext.InventoryItem
      }
      on stockQuarantined: event InventoryItem.StockQuarantined is {
        send stockQuarantined to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell stockQuarantined to entity InventoryControlContext.InventoryItem
      }
      on itemDeactivated: event InventoryItem.ItemDeactivated is {
        send itemDeactivated to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell itemDeactivated to entity InventoryControlContext.InventoryItem
      }
      on other is {
        error "Unexpected message for processor InventoryItemEventSplit"
      }
    } with {
      briefly "InventoryItem event fan-out handler"
      described as {
        |Delivers each InventoryItem event to all of its consumers.
      }
    }
  } with {
    briefly "InventoryItem event fan-out"
    described as {
      |Fans InventoryItem events out to the repository and projectors.
    }
  }
  connector 'InventoryItemEvent Stream' is from outlet InventoryControlContext.InventoryItem.InventoryItemEvents2 to inlet InventoryControlContext.InventoryItemEventSplit.InventoryItemEventSplitIn with {
    briefly "InventoryItem events, fanned out to storage and read models"
  }
  connector 'InventoryAccuracyMetrics Feed' is from outlet InventoryControlContext.InventoryItemEventSplit.InventoryItemEventSplitToInventoryAccuracyMetrics to inlet InventoryControlContext.InventoryAccuracyMetrics.InventoryAccuracyMetricsFromInventoryItem with {
    briefly "InventoryItem events feeding the InventoryAccuracyMetrics projection"
  }
  connector 'InventoryAccuracyMetrics Storage' is from outlet InventoryControlContext.InventoryAccuracyMetrics.InventoryAccuracyMetricsToRepository to inlet InventoryControlContext.InventoryRepository.InventoryRepositoryFromInventoryAccuracyMetrics with {
    briefly "InventoryAccuracyMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for inventory control"
  described as {
    |Warehouse inventory control context.
  }
}
