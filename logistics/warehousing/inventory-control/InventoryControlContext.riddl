// Inventory Control - Inventory Control Context
context InventoryControlContext is {
  adaptor FromERPSystem from context ERPSystem is { 
    handler FromERPSystemHandler is {
      on event ERPSystem.InventoryLevelsSynced is {
        do "the model receives inventory levels synced"
      }
      on result ERPSystem.ProductInfo is {
        do "the model receives product info"
      }
      on other is {
        error "Unexpected message for adaptor FromERPSystem"
      }
    } with {
      briefly "from erp system"
      described as {
        |Carries messages from the external ERPSystem.
      }
    }
  } with {
    briefly "ERPSystem integration"
    described as {
      |The model's side of the ERPSystem conversation.
    }
  }
  adaptor ToERPSystem to context ERPSystem is { 
    handler ToERPSystemHandler is {
      on query ERPSystem.GetProductInfo is {
        do "the model sends get product info"
      }
      on command ERPSystem.SyncInventoryLevels is {
        do "the model sends sync inventory levels"
      }
      on other is {
        error "Unexpected message for adaptor ToERPSystem"
      }
    } with {
      briefly "to erp system"
      described as {
        |Carries messages to the external ERPSystem.
      }
    }
  } with {
    briefly "ERPSystem integration"
    described as {
      |The model's side of the ERPSystem conversation.
    }
  }
  adaptor FromPurchasingSystem from context PurchasingSystem is { 
    handler FromPurchasingSystemHandler is {
      on event PurchasingSystem.PurchaseOrderCreated is {
        do "the model receives purchase order created"
      }
      on result PurchasingSystem.PurchaseOrderStatus is {
        do "the model receives purchase order status"
      }
      on other is {
        error "Unexpected message for adaptor FromPurchasingSystem"
      }
    } with {
      briefly "from purchasing system"
      described as {
        |Carries messages from the external PurchasingSystem.
      }
    }
  } with {
    briefly "PurchasingSystem integration"
    described as {
      |The model's side of the PurchasingSystem conversation.
    }
  }
  adaptor ToPurchasingSystem to context PurchasingSystem is { 
    handler ToPurchasingSystemHandler is {
      on command PurchasingSystem.CreatePurchaseOrder is {
        do "the model sends create purchase order"
      }
      on query PurchasingSystem.GetPurchaseOrderStatus is {
        do "the model sends get purchase order status"
      }
      on other is {
        error "Unexpected message for adaptor ToPurchasingSystem"
      }
    } with {
      briefly "to purchasing system"
      described as {
        |Carries messages to the external PurchasingSystem.
      }
    }
  } with {
    briefly "PurchasingSystem integration"
    described as {
      |The model's side of the PurchasingSystem conversation.
    }
  }
  include "types.riddl"
  include "InventoryItem.riddl"
  repository InventoryRepository is {
    inlet InventoryRepositoryFromInventoryItem is type InventoryItemEvent    inlet InventoryRepositoryFromInventoryAccuracyMetrics is type InventoryItemEvent    outlet InventoryRepositoryResponses is type InventoryItem.InventoryItemResult
    record StoredInventoryItem is  {
      inventoryItemId: InventoryItemId with {
        briefly "inventoryItemId"
        described as {
          |The inventoryItemId column of the stored inventoryItem row.
        }
      }
      itemId: InventoryItemId with {
        briefly "itemId"
        described as {
          |The itemId column of the stored inventoryItem row.
        }
      }
      itemInfo: InventoryItemInfo with {
        briefly "itemInfo"
        described as {
          |The itemInfo column of the stored inventoryItem row.
        }
      }
      status: ItemStatus with {
        briefly "status"
        described as {
          |The status column of the stored inventoryItem row.
        }
      }
    } with {
      briefly "Stored inventoryItem row"
      described as {
        |The persistence shape of inventoryItem data as this repository stores it.
      }
    }
    schema InventoryData is relational
      of inventoryItems as type StoredInventoryItem
        index on field StoredInventoryItem.itemId
        index on field StoredInventoryItem.itemInfo.productId
        index on field StoredInventoryItem.itemInfo.warehouseId
        index on field StoredInventoryItem.status
 with {
      briefly "Inventory data schema"
      described as {
        |The relational schema holding inventory data for the InventoryRepository.
      }
    }
    handler InventoryPersistence is {
      on query GetWarehouseAccuracy is {
        do "read the warehouse accuracy projection"
        yield result WarehouseAccuracyView
      }
      on command InventoryItem.CreateInventoryItem is {
        tell event InventoryItem.InventoryItemCreated to entity InventoryControlContext.InventoryItem
      }
      on command InventoryItem.AdjustQuantity is {
        tell event InventoryItem.QuantityAdjusted to entity InventoryControlContext.InventoryItem
      }
      on command InventoryItem.ReserveStock is {
        tell event InventoryItem.StockReserved to entity InventoryControlContext.InventoryItem
      }
      on command InventoryItem.RecordCycleCount is {
        tell event InventoryItem.CycleCountRecorded to entity InventoryControlContext.InventoryItem
      }
      on command InventoryItem.RelocateItem is {
        tell event InventoryItem.ItemRelocated to entity InventoryControlContext.InventoryItem
      }
      on command InventoryItem.DeactivateItem is {
        tell event InventoryItem.ItemDeactivated to entity InventoryControlContext.InventoryItem
      }
    } with {
      briefly "Persists inventory commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Inventory data persistence"
    described as {
      |Persistent storage for inventory items.
    }
  }
  query GetWarehouseAccuracy is  {
    warehouseAccuracyKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which warehouse accuracy to retrieve.
      }
    }
  } with {
    briefly "Get warehouse accuracy"
    described as {
      |Retrieves the warehouse accuracy projection.
    }
  }
  result WarehouseAccuracyView is  {
    warehouseAccuracy: InventoryAccuracyMetrics.WarehouseAccuracy with {
      briefly "Warehouse accuracy"
      described as {
        |The warehouse accuracy being returned.
      }
    }
  } with {
    briefly "Warehouse accuracy view"
    described as {
      |Read model view carrying the warehouse accuracy projection.
    }
  }
  projector InventoryAccuracyMetrics is {
    updates repository InventoryControlContext.InventoryRepository
    inlet InventoryAccuracyMetricsFromInventoryItem is type InventoryItemEvent    outlet InventoryAccuracyMetricsOut is type InventoryItemEvent
    record WarehouseAccuracy is  {
      totalItemsCounted: Natural with {
        briefly "Counted"
        described as {
          |Items counted.
        }
      }
      accurateCount: Natural with {
        briefly "Accurate"
        described as {
          |Accurate counts.
        }
      }
      varianceCount: Natural with {
        briefly "Variances"
        described as {
          |Counts with variance.
        }
      }
      accuracyPercentage: Decimal(5,2) with {
        briefly "Accuracy"
        described as {
          |Accuracy percentage.
        }
      }
      totalAdjustments: Natural with {
        briefly "Adjustments"
        described as {
          |Total adjustments made.
        }
      }
    } with {
      briefly "Warehouse accuracy"
      described as {
        |Warehouse inventory accuracy metrics.
      }
    }
    handler AccuracyMetricsHandler is {
      on event InventoryItem.CycleCountRecorded is {
        tell event InventoryItem.CycleCountRecorded to repository InventoryControlContext.InventoryRepository
      }
      on event InventoryItem.QuantityAdjusted is {
        tell event InventoryItem.QuantityAdjusted to repository InventoryControlContext.InventoryRepository
      }
      on event InventoryItem.ReplenishmentTriggered is {
        tell event InventoryItem.ReplenishmentTriggered to repository InventoryControlContext.InventoryRepository
      }
    } with {
      briefly "Maintains accuracy metrics"
      described as {
        |Projects events into accuracy metrics.
      }
    }
  } with {
    briefly "Inventory accuracy metrics"
    described as {
      |Inventory accuracy and count analytics.
    }
  }
  type InventoryItemEvent is one of {
    InventoryControlContext.InventoryItem.InventoryItemCreated or InventoryControlContext.InventoryItem.QuantityAdjusted or InventoryControlContext.InventoryItem.ItemDeactivated
  } with {
    briefly "InventoryItem event union"
    described as {
      |Union of InventoryItem events for streaming.
    }
  }
  processor InventoryItemEventSource as source is {
    outlet InventoryItemEvents is type InventoryItemEvent
    handler InventoryItemEventEmitter is {
      on init is {
        tell command InventoryItem.InitializeInventoryItem to entity InventoryControlContext.InventoryItem
      }
      on other is {
        error "Unexpected message for source InventoryItemEventSource"
      }
      on event InventoryItem.InventoryItemCreated is {
        send event InventoryItem.InventoryItemCreated to outlet InventoryItemEvents
      }
      on event InventoryItem.QuantityAdjusted is {
        send event InventoryItem.QuantityAdjusted to outlet InventoryItemEvents
      }
      on event InventoryItem.ItemDeactivated is {
        send event InventoryItem.ItemDeactivated to outlet InventoryItemEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits InventoryItem events to the stream.
      }
    }
  } with {
    briefly "InventoryItem event source"
    described as {
      |Publishes InventoryItem events to the event stream.
    }
  }
  processor InventoryItemEventSink as sink is {
    inlet IncomingInventoryItemEvents is type InventoryItemEvent    handler InventoryItemEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink InventoryItemEventSink"
      }
      on event InventoryItem.InventoryItemCreated is {
        tell event InventoryItem.InventoryItemCreated to repository InventoryControlContext.InventoryRepository
      }
      on event InventoryItem.QuantityAdjusted is {
        tell event InventoryItem.QuantityAdjusted to repository InventoryControlContext.InventoryRepository
      }
      on event InventoryItem.ItemDeactivated is {
        tell event InventoryItem.ItemDeactivated to repository InventoryControlContext.InventoryRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives InventoryItem events for persistence.
      }
    }
  } with {
    briefly "InventoryItem event sink"
    described as {
      |Receives InventoryItem events from streaming.
    }
  }
  connector InventoryItemEventPipeline is from outlet InventoryControlContext.InventoryItemEventSource.InventoryItemEvents to inlet InventoryControlContext.InventoryItemEventSink.IncomingInventoryItemEvents with {
    briefly "InventoryItem event pipeline"
    described as {
      |Wires InventoryItem event source to sink.
    }
  }
  processor InventoryItemEventSplit is {
    inlet InventoryItemEventSplitIn is type InventoryItemEvent    outlet InventoryItemEventSplitToInventoryRepository is type InventoryItemEvent
    outlet InventoryItemEventSplitToInventoryAccuracyMetrics is type InventoryItemEvent
    handler InventoryItemEventSplitHandler is {
      on event InventoryItem.InventoryItemCreated is {
        send event InventoryItem.InventoryItemCreated to outlet InventoryItemEventSplitToInventoryRepository
        send event InventoryItem.InventoryItemCreated to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell event InventoryItem.InventoryItemCreated to entity InventoryControlContext.InventoryItem
      }
      on event InventoryItem.QuantityAdjusted is {
        send event InventoryItem.QuantityAdjusted to outlet InventoryItemEventSplitToInventoryRepository
        send event InventoryItem.QuantityAdjusted to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell event InventoryItem.QuantityAdjusted to entity InventoryControlContext.InventoryItem
      }
      on event InventoryItem.StockReserved is {
        send event InventoryItem.StockReserved to outlet InventoryItemEventSplitToInventoryRepository
        send event InventoryItem.StockReserved to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell event InventoryItem.StockReserved to entity InventoryControlContext.InventoryItem
      }
      on event InventoryItem.ReservationReleased is {
        send event InventoryItem.ReservationReleased to outlet InventoryItemEventSplitToInventoryRepository
        send event InventoryItem.ReservationReleased to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell event InventoryItem.ReservationReleased to entity InventoryControlContext.InventoryItem
      }
      on event InventoryItem.CycleCountRecorded is {
        send event InventoryItem.CycleCountRecorded to outlet InventoryItemEventSplitToInventoryRepository
        send event InventoryItem.CycleCountRecorded to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell event InventoryItem.CycleCountRecorded to entity InventoryControlContext.InventoryItem
      }
      on event InventoryItem.ItemRelocated is {
        send event InventoryItem.ItemRelocated to outlet InventoryItemEventSplitToInventoryRepository
        send event InventoryItem.ItemRelocated to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell event InventoryItem.ItemRelocated to entity InventoryControlContext.InventoryItem
      }
      on event InventoryItem.ReplenishmentTriggered is {
        send event InventoryItem.ReplenishmentTriggered to outlet InventoryItemEventSplitToInventoryRepository
        send event InventoryItem.ReplenishmentTriggered to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell event InventoryItem.ReplenishmentTriggered to entity InventoryControlContext.InventoryItem
      }
      on event InventoryItem.StockQuarantined is {
        send event InventoryItem.StockQuarantined to outlet InventoryItemEventSplitToInventoryRepository
        send event InventoryItem.StockQuarantined to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell event InventoryItem.StockQuarantined to entity InventoryControlContext.InventoryItem
      }
      on event InventoryItem.ItemDeactivated is {
        send event InventoryItem.ItemDeactivated to outlet InventoryItemEventSplitToInventoryRepository
        send event InventoryItem.ItemDeactivated to outlet InventoryItemEventSplitToInventoryAccuracyMetrics
        tell event InventoryItem.ItemDeactivated to entity InventoryControlContext.InventoryItem
      }
      on other is {
        error "Unexpected message for processor InventoryItemEventSplit"
      }
    } with {
      briefly "InventoryItem event fan-out handler"
      described as {
        |Delivers each InventoryItem event to all of its consumers.
      }
    }
  } with {
    briefly "InventoryItem event fan-out"
    described as {
      |Fans InventoryItem events out to the repository and projectors.
    }
  }
  connector 'InventoryItemEvent Stream' is from outlet InventoryControlContext.InventoryItem.InventoryItemEvents2 to inlet InventoryControlContext.InventoryItemEventSplit.InventoryItemEventSplitIn with {
    briefly "InventoryItem events, fanned out to storage and read models"
  }
  connector 'InventoryItemEvent Storage' is from outlet InventoryControlContext.InventoryItemEventSplit.InventoryItemEventSplitToInventoryRepository to inlet InventoryControlContext.InventoryRepository.InventoryRepositoryFromInventoryItem with {
    briefly "InventoryItem events on their way to storage"
  }
  connector 'InventoryAccuracyMetrics Feed' is from outlet InventoryControlContext.InventoryItemEventSplit.InventoryItemEventSplitToInventoryAccuracyMetrics to inlet InventoryControlContext.InventoryAccuracyMetrics.InventoryAccuracyMetricsFromInventoryItem with {
    briefly "InventoryItem events feeding the InventoryAccuracyMetrics projection"
  }
  connector 'InventoryAccuracyMetrics Storage' is from outlet InventoryControlContext.InventoryAccuracyMetrics.InventoryAccuracyMetricsOut to inlet InventoryControlContext.InventoryRepository.InventoryRepositoryFromInventoryAccuracyMetrics with {
    briefly "The InventoryAccuracyMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for inventory control"
  described as {
    |Warehouse inventory control context.
  }
}
