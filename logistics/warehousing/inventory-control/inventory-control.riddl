// Inventory Control Domain Model
// Warehouse inventory management, counting, and accuracy tracking
domain InventoryControl is {
  persistent connector 'PurchasingSystemReply Stream' is from outlet PurchasingSystem.PurchasingSystemRepliesOut to inlet InventoryControlContext.ToPurchasingSystem.ToPurchasingSystemReplies with {
    briefly "What PurchasingSystem answers InventoryControlContext"
  }
  persistent connector 'ERPSystemReply Stream' is from outlet ERPSystem.ERPSystemRepliesOut to inlet InventoryControlContext.ToERPSystem.ToERPSystemReplies with {
    briefly "What ERPSystem answers InventoryControlContext"
  }
  persistent connector 'ERPSystemEvent Stream' is from outlet ERPSystem.ERPSystemEventsOut to inlet InventoryControlContext.FromERPSystem.FromERPSystemIn with {
    briefly "What ERPSystem tells InventoryControlContext, unasked"
  }
  persistent connector 'PurchasingSystemEvent Stream' is from outlet PurchasingSystem.PurchasingSystemEventsOut to inlet InventoryControlContext.FromPurchasingSystem.FromPurchasingSystemIn with {
    briefly "What PurchasingSystem tells InventoryControlContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user WarehouseManager is "person overseeing warehouse operations" with {
    briefly "Warehouse Manager"
    described as {
      |Manager responsible for inventory accuracy.
    }
  }
  user InventoryClerk is "person performing stock counts and adjustments" with {
    briefly "Inventory Clerk"
    described as {
      |Clerk handling physical inventory tasks.
    }
  }
  user SystemOperator is "person monitoring inventory systems" with {
    briefly "System Operator"
    described as {
      |Operator managing inventory control systems.
    }
  }
  epic InventoryAccuracyManagement is {
    user WarehouseManager wants to "to maintain accurate inventory records" so that "warehouse operations run efficiently and orders are fulfilled"
    case PerformCycleCount is {
      user InventoryClerk wants to "to perform a cycle count" so that "inventory accuracy is verified"
      step is "Clerk selects" "bin locations" "for counting" with {
        briefly "Select bins"
        described as {
          |Choose bins to count.
        }
      }
      step is "System records" "count results" "and adjustments" with {
        briefly "Record count"
        described as {
          |Capture count data.
        }
      }
    } with {
      briefly "Perform cycle count"
      described as {
        |Counting inventory in selected bin locations.
      }
    }
  } with {
    briefly "Inventory accuracy management"
    described as {
      |Epic for maintaining warehouse inventory accuracy.
    }
  }
  include "InventoryControlContext.riddl"
  include "external-contexts.riddl"
  application context InventoryControlApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in InventoryControl are delivered.
      }
    }
    group InventoryControlScreen is {
      input GetWarehouseAccuracyInput acquires query InventoryControlContext.GetWarehouseAccuracy with {
        briefly "Get warehouse accuracy control"
        described as {
          |The control through which a user asks the get warehouse accuracy question.
        }
      }
      input GetInventoryItemInput acquires query InventoryControlContext.InventoryItem.GetInventoryItem with {
        briefly "Get inventory item control"
        described as {
          |The control through which a user asks the get inventory item question.
        }
      }
      input CreateInventoryItemInput acquires command InventoryControlContext.CreateInventoryItem with {
        briefly "Create inventory item control"
        described as {
          |The control through which a user submits the create inventory item request.
        }
      }
      input AdjustQuantityInput acquires command InventoryControlContext.InventoryItem.AdjustQuantity with {
        briefly "Adjust quantity control"
        described as {
          |The control through which a user submits the adjust quantity request.
        }
      }
      input DeactivateItemInput acquires command InventoryControlContext.InventoryItem.DeactivateItem with {
        briefly "Deactivate item control"
        described as {
          |The control through which a user submits the deactivate item request.
        }
      }
      input QuarantineStockInput acquires command InventoryControlContext.InventoryItem.QuarantineStock with {
        briefly "Quarantine stock control"
        described as {
          |The control through which a user submits the quarantine stock request.
        }
      }
      input RecordCycleCountInput acquires command InventoryControlContext.InventoryItem.RecordCycleCount with {
        briefly "Record cycle count control"
        described as {
          |The control through which a user submits the record cycle count request.
        }
      }
      input ReleaseReservationInput acquires command InventoryControlContext.InventoryItem.ReleaseReservation with {
        briefly "Release reservation control"
        described as {
          |The control through which a user submits the release reservation request.
        }
      }
      input RelocateItemInput acquires command InventoryControlContext.InventoryItem.RelocateItem with {
        briefly "Relocate item control"
        described as {
          |The control through which a user submits the relocate item request.
        }
      }
      input ReserveStockInput acquires command InventoryControlContext.InventoryItem.ReserveStock with {
        briefly "Reserve stock control"
        described as {
          |The control through which a user submits the reserve stock request.
        }
      }
    } with {
      briefly "Inventory control screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppInventoryRepositoryQueries is query InventoryControlContext.GetWarehouseAccuracy
    inlet AppInventoryRepositoryReplies is result InventoryControlContext.WarehouseAccuracyView
    outlet AppInventoryItemQueries is query InventoryControlContext.InventoryItem.GetInventoryItem
    outlet AppInventoryItemCommands is type InventoryControlContext.InventoryItemRequest
    inlet AppInventoryRepositoryResponses is result InventoryControlContext.InventoryItem.InventoryItemResult
    handler InventoryControlAppHandler is {
      on other is {
        error "Unexpected message for application context InventoryControlApp"
      }
    } with {
      briefly "InventoryControlApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "InventoryControlApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'PurchasingSystemRequest Stream' is from outlet InventoryControlContext.ToPurchasingSystem.ToPurchasingSystemOut to inlet PurchasingSystem.PurchasingSystemRequests with {
    briefly "What InventoryControlContext asks PurchasingSystem to send"
  }
  persistent connector 'ERPSystemRequest Stream' is from outlet InventoryControlContext.ToERPSystem.ToERPSystemOut to inlet ERPSystem.ERPSystemRequests with {
    briefly "What InventoryControlContext asks ERPSystem to send"
  }
  persistent connector 'InventoryRepositoryQuery Stream' is from outlet InventoryControlApp.AppInventoryRepositoryQueries to inlet InventoryControlContext.InventoryRepositoryQueriesIn with {
    briefly "InventoryControlApp's look-ups of the inventory repository"
  }
  persistent connector 'InventoryRepositoryReply Stream' is from outlet InventoryControlContext.InventoryRepositoryRepliesOut to inlet InventoryControlApp.AppInventoryRepositoryReplies with {
    briefly "The inventory repository's answers returned to InventoryControlApp"
  }
  persistent connector 'InventoryItemQuery Stream' is from outlet InventoryControlApp.AppInventoryItemQueries to inlet InventoryControlContext.InventoryItemQueriesIn with {
    briefly "InventoryControlApp's look-ups of the inventory item"
  }
  persistent connector 'InventoryItemCommand Stream' is from outlet InventoryControlApp.AppInventoryItemCommands to inlet InventoryControlContext.InventoryItemCommandStreamIn with {
    briefly "InventoryItem commands from the application"
  }
  persistent connector 'StockItemResult Stream' is from outlet InventoryControlContext.StockItemResultStreamOut to inlet InventoryControlApp.AppInventoryRepositoryResponses with {
    briefly "Inventory query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet InventoryControlApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Inventory control domain"
  described as {
    |Warehouse inventory management and accuracy tracking.
  }
}
