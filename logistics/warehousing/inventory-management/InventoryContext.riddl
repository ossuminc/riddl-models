// Inventory Management - Inventory Context
context InventoryContext is {
  include "types.riddl"
  include "Inventory.riddl"
  // Repository for inventory persistence
  repository InventoryRepository is {
    inlet InventoryRepositoryFromInventory is type InventoryEvent
    inlet InventoryRepositoryFromInventoryAnalytics is type InventoryEvent
    outlet InventoryRepositoryResponses is type Inventory.InventoryResult
    schema InventoryData is relational
      of inventories as type Inventory
        index on field Inventory.inventoryId
        index on field Inventory.product.sku
        index on field Inventory.location.locationId
      with {
      briefly "Inventory data schema"
      described as {
        |The relational schema holding inventory data for the InventoryRepository.
      }
    }

    handler InventoryPersistence is {
      on command Inventory.InitializeInventory is {
        tell event Inventory.InventoryInitialized to entity InventoryContext.Inventory
      }
      on command Inventory.ReceiveStock is {
        tell event Inventory.StockReceived to entity InventoryContext.Inventory
      }
      on command Inventory.ReserveStock is {
        tell event Inventory.StockReserved to entity InventoryContext.Inventory
      }
      on command Inventory.ReleaseReservation is {
        tell event Inventory.ReservationReleased to entity InventoryContext.Inventory
      }
      on command Inventory.AllocateStock is {
        tell event Inventory.StockAllocated to entity InventoryContext.Inventory
      }
      on command Inventory.PickStock is {
        tell event Inventory.StockPicked to entity InventoryContext.Inventory
      }
      on command Inventory.TransferStock is {
        tell event Inventory.StockTransferred to entity InventoryContext.Inventory
      }
      on command Inventory.AdjustStock is {
        tell event Inventory.StockAdjusted to entity InventoryContext.Inventory
      }
      on command Inventory.CycleCount is {
        tell event Inventory.CycleCountRecorded to entity InventoryContext.Inventory
      }
      on command Inventory.RequestReplenishment is {
        tell event Inventory.ReplenishmentRequested to entity InventoryContext.Inventory
      }
    } with {
      briefly "Persists inventory commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Inventory data persistence"
    described as {
      | The InventoryRepository provides persistent storage for
      | inventory, movements, and reservations.
    }
  }
  // Projector for inventory analytics
  projector InventoryAnalytics is {
    inlet InventoryAnalyticsFromInventory is type InventoryEvent
    outlet InventoryAnalyticsOut is type InventoryEvent
    updates repository InventoryContext.InventoryRepository
    record InventoryStats is  {
      totalSKUs: Natural with {
        briefly "SKUs"
        described as {
          |Total SKUs.
        }
      }
      totalUnits: Natural with {
        briefly "Units"
        described as {
          |Total units.
        }
      }
      totalValue: Decimal(15,2) with {
        briefly "Value"
        described as {
          |Total inventory value.
        }
      }
      turnoverRate: Decimal(5,2) with {
        briefly "Turnover"
        described as {
          |Inventory turnover rate.
        }
      }
      stockAccuracy: Decimal(5,4) with {
        briefly "Accuracy"
        described as {
          |Stock accuracy rate.
        }
      }
      lowStockItems: Natural with {
        briefly "Low stock"
        described as {
          |Items below reorder point.
        }
      }
    } with {
      briefly "Inventory statistics"
      described as {
        |Warehouse inventory metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Inventory.StockReceived is {
        tell event Inventory.StockReceived to repository InventoryContext.InventoryRepository
      }
      on event Inventory.StockPicked is {
        tell event Inventory.StockPicked to repository InventoryContext.InventoryRepository
      }
      on event Inventory.CycleCountRecorded is {
        tell event Inventory.CycleCountRecorded to repository InventoryContext.InventoryRepository
      }
      on event Inventory.StockAdjusted is {
        tell event Inventory.StockAdjusted to repository InventoryContext.InventoryRepository
      }
    } with {
      briefly "Maintains inventory analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Inventory analytics projections"
    described as {
      |Maintains warehouse inventory analytics data.
    }
  }
  type InventoryEvent is one of {
    InventoryContext.Inventory.InventoryInitialized,
    InventoryContext.Inventory.StockReceived,
    InventoryContext.Inventory.StockPicked
  } with {
    briefly "Inventory event union"
    described as {
      |Union of Inventory events for streaming.
    }
  }
  processor InventoryEventSource as source is {
    outlet InventoryEvents is type InventoryEvent
    handler InventoryEventEmitter is {
      on init is { tell command Inventory.InitializeInventoryEntity to entity InventoryContext.Inventory }
      on other is {
        error "Unexpected message for source InventoryEventSource"
      }
      on event Inventory.InventoryInitialized is {
        send event Inventory.InventoryInitialized to outlet InventoryEvents
      }
      on event Inventory.StockReceived is {
        send event Inventory.StockReceived to outlet InventoryEvents
      }
      on event Inventory.StockPicked is {
        send event Inventory.StockPicked to outlet InventoryEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits Inventory events to the stream.
      }
    }
  } with {
    briefly "Inventory event source"
    described as {
      |Publishes Inventory events to the event stream.
    }
  }
  processor InventoryEventSink as sink is {
    inlet IncomingInventoryEvents is type InventoryEvent
    handler InventoryEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink InventoryEventSink"
      }
      on event Inventory.InventoryInitialized is {
        tell event Inventory.InventoryInitialized to repository InventoryContext.InventoryRepository
      }
      on event Inventory.StockReceived is {
        tell event Inventory.StockReceived to repository InventoryContext.InventoryRepository
      }
      on event Inventory.StockPicked is {
        tell event Inventory.StockPicked to repository InventoryContext.InventoryRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives Inventory events for persistence.
      }
    }
  } with {
    briefly "Inventory event sink"
    described as {
      |Receives Inventory events from streaming.
    }
  }
  connector InventoryEventPipeline is {
    from outlet InventoryContext.InventoryEventSource.InventoryEvents to inlet InventoryContext.InventoryEventSink.IncomingInventoryEvents
  } with {
    briefly "Inventory event pipeline"
    described as {
      |Wires Inventory event source to sink.
    }
  }
  processor InventoryEventSplit is {
    inlet InventoryEventSplitIn is type InventoryEvent
    outlet InventoryEventSplitToInventoryRepository is type InventoryEvent
    outlet InventoryEventSplitToInventoryAnalytics is type InventoryEvent
    handler InventoryEventSplitHandler is {
      on event Inventory.InventoryInitialized is {
        send event Inventory.InventoryInitialized to outlet InventoryEventSplitToInventoryRepository
        send event Inventory.InventoryInitialized to outlet InventoryEventSplitToInventoryAnalytics
        tell event Inventory.InventoryInitialized to entity InventoryContext.Inventory
      }
      on event Inventory.StockReceived is {
        send event Inventory.StockReceived to outlet InventoryEventSplitToInventoryRepository
        send event Inventory.StockReceived to outlet InventoryEventSplitToInventoryAnalytics
        tell event Inventory.StockReceived to entity InventoryContext.Inventory
      }
      on event Inventory.StockReserved is {
        send event Inventory.StockReserved to outlet InventoryEventSplitToInventoryRepository
        send event Inventory.StockReserved to outlet InventoryEventSplitToInventoryAnalytics
        tell event Inventory.StockReserved to entity InventoryContext.Inventory
      }
      on event Inventory.ReservationReleased is {
        send event Inventory.ReservationReleased to outlet InventoryEventSplitToInventoryRepository
        send event Inventory.ReservationReleased to outlet InventoryEventSplitToInventoryAnalytics
        tell event Inventory.ReservationReleased to entity InventoryContext.Inventory
      }
      on event Inventory.StockAllocated is {
        send event Inventory.StockAllocated to outlet InventoryEventSplitToInventoryRepository
        send event Inventory.StockAllocated to outlet InventoryEventSplitToInventoryAnalytics
        tell event Inventory.StockAllocated to entity InventoryContext.Inventory
      }
      on event Inventory.StockPicked is {
        send event Inventory.StockPicked to outlet InventoryEventSplitToInventoryRepository
        send event Inventory.StockPicked to outlet InventoryEventSplitToInventoryAnalytics
        tell event Inventory.StockPicked to entity InventoryContext.Inventory
      }
      on event Inventory.StockTransferred is {
        send event Inventory.StockTransferred to outlet InventoryEventSplitToInventoryRepository
        send event Inventory.StockTransferred to outlet InventoryEventSplitToInventoryAnalytics
        tell event Inventory.StockTransferred to entity InventoryContext.Inventory
      }
      on event Inventory.StockAdjusted is {
        send event Inventory.StockAdjusted to outlet InventoryEventSplitToInventoryRepository
        send event Inventory.StockAdjusted to outlet InventoryEventSplitToInventoryAnalytics
        tell event Inventory.StockAdjusted to entity InventoryContext.Inventory
      }
      on event Inventory.CycleCountRecorded is {
        send event Inventory.CycleCountRecorded to outlet InventoryEventSplitToInventoryRepository
        send event Inventory.CycleCountRecorded to outlet InventoryEventSplitToInventoryAnalytics
        tell event Inventory.CycleCountRecorded to entity InventoryContext.Inventory
      }
      on event Inventory.ReplenishmentRequested is {
        send event Inventory.ReplenishmentRequested to outlet InventoryEventSplitToInventoryRepository
        send event Inventory.ReplenishmentRequested to outlet InventoryEventSplitToInventoryAnalytics
        tell event Inventory.ReplenishmentRequested to entity InventoryContext.Inventory
      }
      on other is {
        error "Unexpected message for processor InventoryEventSplit"
      }
    } with {
      briefly "Inventory event fan-out handler"
      described as {
        |Delivers each Inventory event to all of its consumers.
      }
    }
  } with {
    briefly "Inventory event fan-out"
    described as {
      |Fans Inventory events out to the repository and projectors.
    }
  }
  connector LinkInventoryToInventoryEventSplit is {
    from outlet InventoryContext.Inventory.InventoryEvents2 to
      inlet InventoryContext.InventoryEventSplit.InventoryEventSplitIn
  } with {
    briefly "LinkInventoryToInventoryEventSplit"
  }
  connector LinkInventoryEventSplitToInventoryRepository is {
    from outlet InventoryContext.InventoryEventSplit.InventoryEventSplitToInventoryRepository to
      inlet InventoryContext.InventoryRepository.InventoryRepositoryFromInventory
  } with {
    briefly "LinkInventoryEventSplitToInventoryRepository"
  }
  connector LinkInventoryEventSplitToInventoryAnalytics is {
    from outlet InventoryContext.InventoryEventSplit.InventoryEventSplitToInventoryAnalytics to
      inlet InventoryContext.InventoryAnalytics.InventoryAnalyticsFromInventory
  } with {
    briefly "LinkInventoryEventSplitToInventoryAnalytics"
  }
  connector LinkInventoryAnalyticsToInventoryRepository is {
    from outlet InventoryContext.InventoryAnalytics.InventoryAnalyticsOut to
      inlet InventoryContext.InventoryRepository.InventoryRepositoryFromInventoryAnalytics
  } with {
    briefly "LinkInventoryAnalyticsToInventoryRepository"
  }
} with {
  briefly "Bounded context for inventory management"
  described as {
    | The InventoryContext is the bounded context for
    | warehouse inventory tracking and control.
  }
}
