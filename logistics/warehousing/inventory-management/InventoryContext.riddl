// Inventory Management - Inventory Context
context InventoryContext as router is {
  inlet InventoryCommandStreamIn is type InventoryCommand  outlet InventoryCommandStreamOut is type InventoryCommand
  inlet StockItemResultStreamIn is result Inventory.InventoryResult  outlet StockItemResultStreamOut is result Inventory.InventoryResult
  handler InventoryContextBoundary is {
    on initializeInventory: command Inventory.InitializeInventory is {
      send initializeInventory to outlet InventoryContext.InventoryCommandStreamOut
    }
    on receiveStock: command Inventory.ReceiveStock is {
      send receiveStock to outlet InventoryContext.InventoryCommandStreamOut
    }
    on reserveStock: command Inventory.ReserveStock is {
      send reserveStock to outlet InventoryContext.InventoryCommandStreamOut
    }
    on releaseReservation: command Inventory.ReleaseReservation is {
      send releaseReservation to outlet InventoryContext.InventoryCommandStreamOut
    }
    on allocateStock: command Inventory.AllocateStock is {
      send allocateStock to outlet InventoryContext.InventoryCommandStreamOut
    }
    on pickStock: command Inventory.PickStock is {
      send pickStock to outlet InventoryContext.InventoryCommandStreamOut
    }
    on transferStock: command Inventory.TransferStock is {
      send transferStock to outlet InventoryContext.InventoryCommandStreamOut
    }
    on adjustStock: command Inventory.AdjustStock is {
      send adjustStock to outlet InventoryContext.InventoryCommandStreamOut
    }
    on cycleCount: command Inventory.CycleCount is {
      send cycleCount to outlet InventoryContext.InventoryCommandStreamOut
    }
    on requestReplenishment: command Inventory.RequestReplenishment is {
      send requestReplenishment to outlet InventoryContext.InventoryCommandStreamOut
    }
    on inventoryResult: result Inventory.InventoryResult is {
      send inventoryResult to outlet InventoryContext.StockItemResultStreamOut
    }
    on other is {
      error "Unexpected message at the InventoryContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'InventoryCommand Stream Intake' is from outlet InventoryContext.InventoryCommandStreamOut to inlet InventoryContext.Inventory.InventoryCommands  connector 'StockItemResult Stream Egress' is from outlet InventoryContext.InventoryRepository.InventoryRepositoryResponses to inlet InventoryContext.StockItemResultStreamIn  adaptor FromBarcodeService from context BarcodeService is { 
    handler FromBarcodeServiceHandler is {
      on result BarcodeService.BarcodeData is {
        do "the model receives barcode data"
      }
      on event BarcodeService.LabelGenerated is {
        do "the model receives label generated"
      }
      on other is {
        error "Unexpected message for adaptor FromBarcodeService"
      }
    } with {
      briefly "from barcode service"
      described as {
        |Carries messages from the external BarcodeService.
      }
    }
  } with {
    briefly "BarcodeService integration"
    described as {
      |The model's side of the BarcodeService conversation.
    }
  }
  adaptor ToBarcodeService to context BarcodeService is { 
    handler ToBarcodeServiceHandler is {
      on command BarcodeService.GenerateLabel is {
        do "the model sends generate label"
      }
      on query BarcodeService.GetBarcode is {
        do "the model sends get barcode"
      }
      on command BarcodeService.ScanBarcode is {
        do "the model sends scan barcode"
      }
      on other is {
        error "Unexpected message for adaptor ToBarcodeService"
      }
    } with {
      briefly "to barcode service"
      described as {
        |Carries messages to the external BarcodeService.
      }
    }
  } with {
    briefly "BarcodeService integration"
    described as {
      |The model's side of the BarcodeService conversation.
    }
  }
  adaptor FromOrderManagementService from context OrderManagementService is { 
    handler FromOrderManagementServiceHandler is {
      on event OrderManagementService.AllocationNotified is {
        do "the model receives allocation notified"
      }
      on event OrderManagementService.AllocationRequested is {
        do "the model receives allocation requested"
      }
      on other is {
        error "Unexpected message for adaptor FromOrderManagementService"
      }
    } with {
      briefly "from order management service"
      described as {
        |Carries messages from the external OrderManagementService.
      }
    }
  } with {
    briefly "OrderManagementService integration"
    described as {
      |The model's side of the OrderManagementService conversation.
    }
  }
  adaptor ToOrderManagementService to context OrderManagementService is { 
    handler ToOrderManagementServiceHandler is {
      on command OrderManagementService.NotifyAllocationComplete is {
        do "the model sends notify allocation complete"
      }
      on command OrderManagementService.RequestInventoryAllocation is {
        do "the model sends request inventory allocation"
      }
      on other is {
        error "Unexpected message for adaptor ToOrderManagementService"
      }
    } with {
      briefly "to order management service"
      described as {
        |Carries messages to the external OrderManagementService.
      }
    }
  } with {
    briefly "OrderManagementService integration"
    described as {
      |The model's side of the OrderManagementService conversation.
    }
  }
  adaptor FromProcurementService from context ProcurementService is { 
    handler FromProcurementServiceHandler is {
      on event ProcurementService.PurchaseOrderCreated is {
        do "the model receives purchase order created"
      }
      on result ProcurementService.PurchaseOrderStatus is {
        do "the model receives purchase order status"
      }
      on other is {
        error "Unexpected message for adaptor FromProcurementService"
      }
    } with {
      briefly "from procurement service"
      described as {
        |Carries messages from the external ProcurementService.
      }
    }
  } with {
    briefly "ProcurementService integration"
    described as {
      |The model's side of the ProcurementService conversation.
    }
  }
  adaptor ToProcurementService to context ProcurementService is { 
    handler ToProcurementServiceHandler is {
      on command ProcurementService.CreatePurchaseOrder is {
        do "the model sends create purchase order"
      }
      on query ProcurementService.GetPurchaseOrderStatus is {
        do "the model sends get purchase order status"
      }
      on other is {
        error "Unexpected message for adaptor ToProcurementService"
      }
    } with {
      briefly "to procurement service"
      described as {
        |Carries messages to the external ProcurementService.
      }
    }
  } with {
    briefly "ProcurementService integration"
    described as {
      |The model's side of the ProcurementService conversation.
    }
  }
  adaptor FromQualityControlService from context QualityControlService is { 
    handler FromQualityControlServiceHandler is {
      on event QualityControlService.InspectionCompleted is {
        do "the model receives inspection completed"
      }
      on event QualityControlService.InspectionStarted is {
        do "the model receives inspection started"
      }
      on other is {
        error "Unexpected message for adaptor FromQualityControlService"
      }
    } with {
      briefly "from quality control service"
      described as {
        |Carries messages from the external QualityControlService.
      }
    }
  } with {
    briefly "QualityControlService integration"
    described as {
      |The model's side of the QualityControlService conversation.
    }
  }
  adaptor ToQualityControlService to context QualityControlService is { 
    handler ToQualityControlServiceHandler is {
      on command QualityControlService.InspectReceipt is {
        do "the model sends inspect receipt"
      }
      on command QualityControlService.RecordInspectionResult is {
        do "the model sends record inspection result"
      }
      on other is {
        error "Unexpected message for adaptor ToQualityControlService"
      }
    } with {
      briefly "to quality control service"
      described as {
        |Carries messages to the external QualityControlService.
      }
    }
  } with {
    briefly "QualityControlService integration"
    described as {
      |The model's side of the QualityControlService conversation.
    }
  }
  adaptor FromShippingService from context ShippingService is { 
    handler FromShippingServiceHandler is {
      on event ShippingService.ShipmentConfirmed is {
        do "the model receives shipment confirmed"
      }
      on event ShippingService.ShipmentCreated is {
        do "the model receives shipment created"
      }
      on other is {
        error "Unexpected message for adaptor FromShippingService"
      }
    } with {
      briefly "from shipping service"
      described as {
        |Carries messages from the external ShippingService.
      }
    }
  } with {
    briefly "ShippingService integration"
    described as {
      |The model's side of the ShippingService conversation.
    }
  }
  adaptor ToShippingService to context ShippingService is { 
    handler ToShippingServiceHandler is {
      on command ShippingService.ConfirmShipment is {
        do "the model sends confirm shipment"
      }
      on command ShippingService.CreateShipment is {
        do "the model sends create shipment"
      }
      on other is {
        error "Unexpected message for adaptor ToShippingService"
      }
    } with {
      briefly "to shipping service"
      described as {
        |Carries messages to the external ShippingService.
      }
    }
  } with {
    briefly "ShippingService integration"
    described as {
      |The model's side of the ShippingService conversation.
    }
  }
  adaptor FromWarehouseManagementService from context WarehouseManagementService is { 
    handler FromWarehouseManagementServiceHandler is {
      on result WarehouseManagementService.LocationCapacity is {
        do "the model receives location capacity"
      }
      on result WarehouseManagementService.SlottingRecommendation is {
        do "the model receives slotting recommendation"
      }
      on other is {
        error "Unexpected message for adaptor FromWarehouseManagementService"
      }
    } with {
      briefly "from warehouse management service"
      described as {
        |Carries messages from the external WarehouseManagementService.
      }
    }
  } with {
    briefly "WarehouseManagementService integration"
    described as {
      |The model's side of the WarehouseManagementService conversation.
    }
  }
  adaptor ToWarehouseManagementService to context WarehouseManagementService is { 
    handler ToWarehouseManagementServiceHandler is {
      on query WarehouseManagementService.GetLocationCapacity is {
        do "the model sends get location capacity"
      }
      on command WarehouseManagementService.OptimizeSlotting is {
        do "the model sends optimize slotting"
      }
      on other is {
        error "Unexpected message for adaptor ToWarehouseManagementService"
      }
    } with {
      briefly "to warehouse management service"
      described as {
        |Carries messages to the external WarehouseManagementService.
      }
    }
  } with {
    briefly "WarehouseManagementService integration"
    described as {
      |The model's side of the WarehouseManagementService conversation.
    }
  }
  include "types.riddl"
  include "Inventory.riddl"
  // Repository for inventory persistence
  type InventoryRepositoryCommand is one of {
    InventoryContext.InventoryRepository.PersistCycleCountRecorded or InventoryContext.InventoryRepository.PersistInventoryInitialized or InventoryContext.InventoryRepository.PersistReplenishmentRequested or InventoryContext.InventoryRepository.PersistReservationReleased or InventoryContext.InventoryRepository.PersistStockAdjusted or InventoryContext.InventoryRepository.PersistStockAllocated or InventoryContext.InventoryRepository.PersistStockPicked or InventoryContext.InventoryRepository.PersistStockReceived or InventoryContext.InventoryRepository.PersistStockReserved or InventoryContext.InventoryRepository.PersistStockTransferred
  } with {
    briefly "Anything that writes InventoryRepository"
    described as {
      |The persistence commands InventoryRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository InventoryRepository as flow is {
    inlet InventoryRepositoryFromInventoryAnalytics is type InventoryRepositoryCommand    command PersistInventoryInitialized is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryInitialized applies to.
        }
      }
    } with {
      briefly "Persist InventoryInitialized"
      described as {
        |Instructs this repository to apply InventoryInitialized to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReplenishmentRequested is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReplenishmentRequested applies to.
        }
      }
    } with {
      briefly "Persist ReplenishmentRequested"
      described as {
        |Instructs this repository to apply ReplenishmentRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationReleased is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationReleased applies to.
        }
      }
    } with {
      briefly "Persist ReservationReleased"
      described as {
        |Instructs this repository to apply ReservationReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStockAllocated is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row StockAllocated applies to.
        }
      }
    } with {
      briefly "Persist StockAllocated"
      described as {
        |Instructs this repository to apply StockAllocated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStockReserved is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row StockReserved applies to.
        }
      }
    } with {
      briefly "Persist StockReserved"
      described as {
        |Instructs this repository to apply StockReserved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStockTransferred is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row StockTransferred applies to.
        }
      }
    } with {
      briefly "Persist StockTransferred"
      described as {
        |Instructs this repository to apply StockTransferred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCycleCountRecorded is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row CycleCountRecorded applies to.
        }
      }
    } with {
      briefly "Persist CycleCountRecorded"
      described as {
        |Instructs this repository to apply CycleCountRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStockAdjusted is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row StockAdjusted applies to.
        }
      }
    } with {
      briefly "Persist StockAdjusted"
      described as {
        |Instructs this repository to apply StockAdjusted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStockPicked is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row StockPicked applies to.
        }
      }
    } with {
      briefly "Persist StockPicked"
      described as {
        |Instructs this repository to apply StockPicked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStockReceived is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row StockReceived applies to.
        }
      }
    } with {
      briefly "Persist StockReceived"
      described as {
        |Instructs this repository to apply StockReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet InventoryRepositoryResponses is result Inventory.InventoryResult
    record StoredInventory is {
      inventoryId: InventoryId with {
        briefly "inventoryId"
        described as {
          |The inventoryId column of the stored inventory row.
        }
      }
      location: LocationInfo with {
        briefly "location"
        described as {
          |The location column of the stored inventory row.
        }
      }
      product: ProductInfo with {
        briefly "product"
        described as {
          |The product column of the stored inventory row.
        }
      }
    } with {
      briefly "Stored inventory row"
      described as {
        |The persistence shape of inventory data as this repository stores it.
      }
    }
    schema InventoryData is relational
      of inventories as record StoredInventory
        index on field StoredInventory.inventoryId
        index on field StoredInventory.product.sku
        index on field StoredInventory.location.locationId
 with {
      briefly "Inventory data schema"
      described as {
        |The relational schema holding inventory data for the InventoryRepository.
      }
    }
    handler InventoryPersistence is {
      on persistInventoryInitialized: command PersistInventoryInitialized is {
        do "apply InventoryInitialized to the stored row"
      }
      on persistReplenishmentRequested: command PersistReplenishmentRequested is {
        do "apply ReplenishmentRequested to the stored row"
      }
      on persistReservationReleased: command PersistReservationReleased is {
        do "apply ReservationReleased to the stored row"
      }
      on persistStockAllocated: command PersistStockAllocated is {
        do "apply StockAllocated to the stored row"
      }
      on persistStockReserved: command PersistStockReserved is {
        do "apply StockReserved to the stored row"
      }
      on persistStockTransferred: command PersistStockTransferred is {
        do "apply StockTransferred to the stored row"
      }
      on persistCycleCountRecorded: command PersistCycleCountRecorded is {
        do "apply CycleCountRecorded to the stored row"
      }
      on persistStockAdjusted: command PersistStockAdjusted is {
        do "apply StockAdjusted to the stored row"
      }
      on persistStockPicked: command PersistStockPicked is {
        do "apply StockPicked to the stored row"
      }
      on persistStockReceived: command PersistStockReceived is {
        do "apply StockReceived to the stored row"
      }
      on query GetInventoryStats is {
        let inventoryStatsView: type InventoryStatsView = prompt("read the inventory stats projection")
        reply inventoryStatsView
      }
    } with {
      briefly "Persists inventory commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Inventory data persistence"
    described as {
      | The InventoryRepository provides persistent storage for
      | inventory, movements, and reservations.
    }
  }
  // Projector for inventory analytics
  query GetInventoryStats replies result InventoryStatsView is {
    inventoryStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which inventory stats to retrieve.
      }
    }
  } with {
    briefly "Get inventory stats"
    described as {
      |Retrieves the inventory stats projection.
    }
  }
  result InventoryStatsView is {
    inventoryStats: InventoryAnalytics.InventoryStats with {
      briefly "Inventory stats"
      described as {
        |The inventory stats being returned.
      }
    }
  } with {
    briefly "Inventory stats view"
    described as {
      |Read model view carrying the inventory stats projection.
    }
  }
  projector InventoryAnalytics as flow is {
    updates repository InventoryContext.InventoryRepository
    outlet InventoryAnalyticsToRepository is type InventoryRepositoryCommand
    inlet InventoryAnalyticsFromInventory is type InventoryEvent    record InventoryStats is {
      totalSKUs: Natural with {
        briefly "SKUs"
        described as {
          |Total SKUs.
        }
      }
      totalUnits: Natural with {
        briefly "Units"
        described as {
          |Total units.
        }
      }
      totalValue: Decimal(15,2) with {
        briefly "Value"
        described as {
          |Total inventory value.
        }
      }
      turnoverRate: Decimal(5,2) with {
        briefly "Turnover"
        described as {
          |Inventory turnover rate.
        }
      }
      stockAccuracy: Decimal(5,4) with {
        briefly "Accuracy"
        described as {
          |Stock accuracy rate.
        }
      }
      lowStockItems: Natural with {
        briefly "Low stock"
        described as {
          |Items below reorder point.
        }
      }
    } with {
      briefly "Inventory statistics"
      described as {
        |Warehouse inventory metrics.
      }
    }
    handler AnalyticsHandler is {
      on inventoryInitialized: event Inventory.InventoryInitialized is {
        tell command InventoryContext.InventoryRepository.PersistInventoryInitialized(inventoryId = inventoryInitialized.inventoryId) to repository InventoryContext.InventoryRepository
        do "apply InventoryInitialized to the InventoryAnalytics projection"
      }
      on replenishmentRequested: event Inventory.ReplenishmentRequested is {
        tell command InventoryContext.InventoryRepository.PersistReplenishmentRequested(inventoryId = replenishmentRequested.inventoryId) to repository InventoryContext.InventoryRepository
        do "apply ReplenishmentRequested to the InventoryAnalytics projection"
      }
      on reservationReleased: event Inventory.ReservationReleased is {
        tell command InventoryContext.InventoryRepository.PersistReservationReleased(inventoryId = reservationReleased.inventoryId) to repository InventoryContext.InventoryRepository
        do "apply ReservationReleased to the InventoryAnalytics projection"
      }
      on stockAllocated: event Inventory.StockAllocated is {
        tell command InventoryContext.InventoryRepository.PersistStockAllocated(inventoryId = stockAllocated.inventoryId) to repository InventoryContext.InventoryRepository
        do "apply StockAllocated to the InventoryAnalytics projection"
      }
      on stockReserved: event Inventory.StockReserved is {
        tell command InventoryContext.InventoryRepository.PersistStockReserved(inventoryId = stockReserved.inventoryId) to repository InventoryContext.InventoryRepository
        do "apply StockReserved to the InventoryAnalytics projection"
      }
      on stockTransferred: event Inventory.StockTransferred is {
        tell command InventoryContext.InventoryRepository.PersistStockTransferred(inventoryId = stockTransferred.inventoryId) to repository InventoryContext.InventoryRepository
        do "apply StockTransferred to the InventoryAnalytics projection"
      }
      on stockReceived: event Inventory.StockReceived is {
        tell command InventoryContext.InventoryRepository.PersistStockReceived(inventoryId = stockReceived.inventoryId) to repository InventoryContext.InventoryRepository
      }
      on stockPicked: event Inventory.StockPicked is {
        tell command InventoryContext.InventoryRepository.PersistStockPicked(inventoryId = stockPicked.inventoryId) to repository InventoryContext.InventoryRepository
      }
      on cycleCountRecorded: event Inventory.CycleCountRecorded is {
        tell command InventoryContext.InventoryRepository.PersistCycleCountRecorded(inventoryId = cycleCountRecorded.inventoryId) to repository InventoryContext.InventoryRepository
      }
      on stockAdjusted: event Inventory.StockAdjusted is {
        tell command InventoryContext.InventoryRepository.PersistStockAdjusted(inventoryId = stockAdjusted.inventoryId) to repository InventoryContext.InventoryRepository
      }
    } with {
      briefly "Maintains inventory analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Inventory analytics projections"
    described as {
      |Maintains warehouse inventory analytics data.
    }
  }
  type InventoryEvent is one of {
    InventoryContext.Inventory.InventoryInitialized or InventoryContext.Inventory.StockReceived or InventoryContext.Inventory.StockPicked or InventoryContext.Inventory.CycleCountRecorded or InventoryContext.Inventory.ReplenishmentRequested or InventoryContext.Inventory.ReservationReleased or InventoryContext.Inventory.StockAdjusted or InventoryContext.Inventory.StockAllocated or InventoryContext.Inventory.StockReserved or InventoryContext.Inventory.StockTransferred
  } with {
    briefly "Inventory event union"
    described as {
      |Union of Inventory events for streaming.
    }
  }
  processor InventoryEventSplit as flow is {
    inlet InventoryEventSplitIn is type InventoryEvent    outlet InventoryEventSplitToInventoryAnalytics is type InventoryEvent
    handler InventoryEventSplitHandler is {
      on inventoryInitialized: event Inventory.InventoryInitialized is {
        send inventoryInitialized to outlet InventoryEventSplitToInventoryAnalytics
        tell inventoryInitialized to entity InventoryContext.Inventory
      }
      on stockReceived: event Inventory.StockReceived is {
        send stockReceived to outlet InventoryEventSplitToInventoryAnalytics
        tell stockReceived to entity InventoryContext.Inventory
      }
      on stockReserved: event Inventory.StockReserved is {
        send stockReserved to outlet InventoryEventSplitToInventoryAnalytics
        tell stockReserved to entity InventoryContext.Inventory
      }
      on reservationReleased: event Inventory.ReservationReleased is {
        send reservationReleased to outlet InventoryEventSplitToInventoryAnalytics
        tell reservationReleased to entity InventoryContext.Inventory
      }
      on stockAllocated: event Inventory.StockAllocated is {
        send stockAllocated to outlet InventoryEventSplitToInventoryAnalytics
        tell stockAllocated to entity InventoryContext.Inventory
      }
      on stockPicked: event Inventory.StockPicked is {
        send stockPicked to outlet InventoryEventSplitToInventoryAnalytics
        tell stockPicked to entity InventoryContext.Inventory
      }
      on stockTransferred: event Inventory.StockTransferred is {
        send stockTransferred to outlet InventoryEventSplitToInventoryAnalytics
        tell stockTransferred to entity InventoryContext.Inventory
      }
      on stockAdjusted: event Inventory.StockAdjusted is {
        send stockAdjusted to outlet InventoryEventSplitToInventoryAnalytics
        tell stockAdjusted to entity InventoryContext.Inventory
      }
      on cycleCountRecorded: event Inventory.CycleCountRecorded is {
        send cycleCountRecorded to outlet InventoryEventSplitToInventoryAnalytics
        tell cycleCountRecorded to entity InventoryContext.Inventory
      }
      on replenishmentRequested: event Inventory.ReplenishmentRequested is {
        send replenishmentRequested to outlet InventoryEventSplitToInventoryAnalytics
        tell replenishmentRequested to entity InventoryContext.Inventory
      }
      on other is {
        error "Unexpected message for processor InventoryEventSplit"
      }
    } with {
      briefly "Inventory event fan-out handler"
      described as {
        |Delivers each Inventory event to all of its consumers.
      }
    }
  } with {
    briefly "Inventory event fan-out"
    described as {
      |Fans Inventory events out to the repository and projectors.
    }
  }
  connector 'InventoryEvent Stream' is from outlet InventoryContext.Inventory.InventoryEvents2 to inlet InventoryContext.InventoryEventSplit.InventoryEventSplitIn with {
    briefly "Inventory events, fanned out to storage and read models"
  }
  connector 'InventoryAnalytics Feed' is from outlet InventoryContext.InventoryEventSplit.InventoryEventSplitToInventoryAnalytics to inlet InventoryContext.InventoryAnalytics.InventoryAnalyticsFromInventory with {
    briefly "Inventory events feeding the InventoryAnalytics projection"
  }
  connector 'InventoryAnalytics Storage' is from outlet InventoryContext.InventoryAnalytics.InventoryAnalyticsToRepository to inlet InventoryContext.InventoryRepository.InventoryRepositoryFromInventoryAnalytics with {
    briefly "InventoryAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for inventory management"
  described as {
    | The InventoryContext is the bounded context for
    | warehouse inventory tracking and control.
  }
}
