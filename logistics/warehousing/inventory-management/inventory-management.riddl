// Inventory Management Domain Model
// Warehouse inventory tracking and stock control
domain InventoryManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user WarehouseManager is "person managing warehouse operations" with {
    briefly "Warehouse Manager"
    described as {
      |Person overseeing inventory.
    }
  }
  user InventoryClerk is "person handling stock movements" with {
    briefly "Inventory Clerk"
    described as {
      |Person receiving and picking items.
    }
  }
  user ProcurementOfficer is "person managing replenishment" with {
    briefly "Procurement Officer"
    described as {
      |Person ordering stock.
    }
  }
  epic InventoryEpic is {
    user WarehouseManager wants to "to track and control inventory" so that "stock levels are optimized"
    case ReceiveStockUseCase is {
      user InventoryClerk wants to "to receive incoming shipment" so that "inventory is updated accurately"
      step is "Clerk verifies" "shipment against PO" "for accuracy" with {
        briefly "Verify shipment"
        described as {
          |Check items received.
        }
      }
      step is "Clerk inspects" "product quality" "for defects" with {
        briefly "Inspect quality"
        described as {
          |Quality check items.
        }
      }
      step take input InventoryManagementApp.InventoryManagementScreen.ReceiveStockInput from user InventoryClerk with {
        briefly "Receive stock"
        described as {
          |Record receipt.
        }
      }
      step is "System updates" "inventory levels" "and locations" with {
        briefly "Update inventory"
        described as {
          |Adjust stock counts.
        }
      }
    } with {
      briefly "Stock receiving"
      described as {
        |Receiving incoming inventory.
      }
    }
  } with {
    briefly "Inventory management"
    described as {
      | Epic covering inventory receiving,
      | tracking, picking, and replenishment.
    }
  }
  include "InventoryContext.riddl"
  include "external-contexts.riddl"
  application context InventoryManagementApp is {
    group InventoryManagementScreen is {
      input ReceiveStockInput acquires command InventoryContext.Inventory.ReceiveStock with {
        briefly "Receive stock control"
        described as {
          |The control through which a user submits the receive stock request.
        }
      }
    } with {
      briefly "Inventory management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppInventoryCommands is type InventoryContext.Inventory.InventoryCommand
    inlet AppInventoryRepositoryResponses is type InventoryContext.Inventory.InventoryResult    handler InventoryManagementAppHandler is {
      on other is {
        error "Unexpected message for application context InventoryManagementApp"
      }
    } with {
      briefly "InventoryManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "InventoryManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppInventoryCommands is from outlet InventoryManagementApp.AppInventoryCommands to inlet InventoryContext.Inventory.InventoryCommands with {
    option persistent()
    briefly "LinkAppInventoryCommands"
  }
  connector LinkAppInventoryRepositoryResponses is from outlet InventoryContext.InventoryRepository.InventoryRepositoryResponses to inlet InventoryManagementApp.AppInventoryRepositoryResponses with {
    option persistent()
    briefly "LinkAppInventoryRepositoryResponses"
  }
} with {
  briefly "Inventory management domain"
  described as {
    | The InventoryManagement domain handles warehouse
    | inventory tracking and stock control.
  }
}
