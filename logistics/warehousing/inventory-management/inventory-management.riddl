// Inventory Management Domain Model
// Warehouse inventory tracking and stock control
domain InventoryManagement is {
  persistent connector 'BarcodeServiceEvent Stream' is from outlet BarcodeService.BarcodeServiceEventsOut to inlet InventoryContext.FromBarcodeService.FromBarcodeServiceIn with {
    briefly "What BarcodeService tells InventoryContext, unasked"
  }
  persistent connector 'OrderManagementServiceEvent Stream' is from outlet OrderManagementService.OrderManagementServiceEventsOut to inlet InventoryContext.FromOrderManagementService.FromOrderManagementServiceIn with {
    briefly "What OrderManagementService tells InventoryContext, unasked"
  }
  persistent connector 'ProcurementServiceEvent Stream' is from outlet ProcurementService.ProcurementServiceEventsOut to inlet InventoryContext.FromProcurementService.FromProcurementServiceIn with {
    briefly "What ProcurementService tells InventoryContext, unasked"
  }
  persistent connector 'QualityControlServiceEvent Stream' is from outlet QualityControlService.QualityControlServiceEventsOut to inlet InventoryContext.FromQualityControlService.FromQualityControlServiceIn with {
    briefly "What QualityControlService tells InventoryContext, unasked"
  }
  persistent connector 'ShippingServiceEvent Stream' is from outlet ShippingService.ShippingServiceEventsOut to inlet InventoryContext.FromShippingService.FromShippingServiceIn with {
    briefly "What ShippingService tells InventoryContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user WarehouseManager is "person managing warehouse operations" with {
    briefly "Warehouse Manager"
    described as {
      |Person overseeing inventory.
    }
  }
  user InventoryClerk is "person handling stock movements" with {
    briefly "Inventory Clerk"
    described as {
      |Person receiving and picking items.
    }
  }
  user ProcurementOfficer is "person managing replenishment" with {
    briefly "Procurement Officer"
    described as {
      |Person ordering stock.
    }
  }
  epic InventoryEpic is {
    user WarehouseManager wants to "to track and control inventory" so that "stock levels are optimized"
    case ReceiveStockUseCase is {
      user InventoryClerk wants to "to receive incoming shipment" so that "inventory is updated accurately"
      step is "Clerk verifies" "shipment against PO" "for accuracy" with {
        briefly "Verify shipment"
        described as {
          |Check items received.
        }
      }
      step is "Clerk inspects" "product quality" "for defects" with {
        briefly "Inspect quality"
        described as {
          |Quality check items.
        }
      }
      step take input InventoryManagementApp.InventoryManagementScreen.ReceiveStockInput from user InventoryClerk with {
        briefly "Receive stock"
        described as {
          |Record receipt.
        }
      }
      step is "System updates" "inventory levels" "and locations" with {
        briefly "Update inventory"
        described as {
          |Adjust stock counts.
        }
      }
    } with {
      briefly "Stock receiving"
      described as {
        |Receiving incoming inventory.
      }
    }
  } with {
    briefly "Inventory management"
    described as {
      | Epic covering inventory receiving,
      | tracking, picking, and replenishment.
    }
  }
  include "InventoryContext.riddl"
  include "external-contexts.riddl"
  application context InventoryManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in InventoryManagement are delivered.
      }
    }
    group InventoryManagementScreen is {
      input ReceiveStockInput acquires command InventoryContext.Inventory.ReceiveStock with {
        briefly "Receive stock control"
        described as {
          |The control through which a user submits the receive stock request.
        }
      }
    } with {
      briefly "Inventory management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppInventoryCommands is type InventoryContext.Inventory.InventoryCommand
    inlet AppInventoryRepositoryResponses is result InventoryContext.Inventory.InventoryResult    handler InventoryManagementAppHandler is {
      on other is {
        error "Unexpected message for application context InventoryManagementApp"
      }
    } with {
      briefly "InventoryManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "InventoryManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'OrderManagementServiceRequest Stream' is from outlet InventoryContext.ToOrderManagementService.ToOrderManagementServiceOut to inlet OrderManagementService.OrderManagementServiceRequests with {
    briefly "What InventoryContext asks OrderManagementService to send"
  }
  persistent connector 'BarcodeServiceRequest Stream' is from outlet InventoryContext.ToBarcodeService.ToBarcodeServiceOut to inlet BarcodeService.BarcodeServiceRequests with {
    briefly "What InventoryContext asks BarcodeService to send"
  }
  persistent connector 'ShippingServiceRequest Stream' is from outlet InventoryContext.ToShippingService.ToShippingServiceOut to inlet ShippingService.ShippingServiceRequests with {
    briefly "What InventoryContext asks ShippingService to send"
  }
  persistent connector 'ProcurementServiceRequest Stream' is from outlet InventoryContext.ToProcurementService.ToProcurementServiceOut to inlet ProcurementService.ProcurementServiceRequests with {
    briefly "What InventoryContext asks ProcurementService to send"
  }
  persistent connector 'QualityControlServiceRequest Stream' is from outlet InventoryContext.ToQualityControlService.ToQualityControlServiceOut to inlet QualityControlService.QualityControlServiceRequests with {
    briefly "What InventoryContext asks QualityControlService to send"
  }
  persistent connector 'WarehouseManagementServiceRequest Stream' is from outlet InventoryContext.ToWarehouseManagementService.ToWarehouseManagementServiceOut to inlet WarehouseManagementService.WarehouseManagementServiceRequests with {
    briefly "What InventoryContext asks WarehouseManagementService to send"
  }
  persistent connector 'InventoryCommand Stream' is from outlet InventoryManagementApp.AppInventoryCommands to inlet InventoryContext.InventoryCommandStreamIn with {
    briefly "Inventory commands from the application"
  }
  persistent connector 'StockItemResult Stream' is from outlet InventoryContext.StockItemResultStreamOut to inlet InventoryManagementApp.AppInventoryRepositoryResponses with {
    briefly "Inventory query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet InventoryManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Inventory management domain"
  described as {
    | The InventoryManagement domain handles warehouse
    | inventory tracking and stock control.
  }
}
