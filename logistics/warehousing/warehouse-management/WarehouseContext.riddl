// Warehouse Context - Bounded context for warehouse operations
context WarehouseContext as router is {
  inlet WarehouseContextFromToProductCatalogContext is command Inventory.RecordProductDetails with {
    briefly "What ToProductCatalogContext makes of the answers it gets"
  }
  connector 'ToProductCatalogContext Intake' is from outlet WarehouseContext.ToProductCatalogContext.ToProductCatalogContextToWarehouseContext to inlet WarehouseContext.WarehouseContextFromToProductCatalogContext with {
    briefly "Answers translated by ToProductCatalogContext, on their way in"
  }
  type FromOrderManagementContextCommand is one of {
    Inventory.ReleaseReservation or Inventory.ReserveInventory
  } with {
    briefly "What FromOrderManagementContext turns that service's news into"
  }
  inlet WarehouseContextFromOrderManagementContext is type WarehouseContext.FromOrderManagementContextCommand with {
    briefly "What FromOrderManagementContext makes of that service's news"
  }
  connector 'FromOrderManagementContext Intake' is from outlet WarehouseContext.FromOrderManagementContext.FromOrderManagementContextToWarehouseContext to inlet WarehouseContext.WarehouseContextFromOrderManagementContext with {
    briefly "What FromOrderManagementContext makes of that news, on its way in"
  }
  inlet WarehouseContextFromPurchasingContext is command Inventory.ReceiveInventory with {
    briefly "What FromPurchasingContext makes of that service's news"
  }
  connector 'FromPurchasingContext Intake' is from outlet WarehouseContext.FromPurchasingContext.FromPurchasingContextToWarehouseContext to inlet WarehouseContext.WarehouseContextFromPurchasingContext with {
    briefly "What FromPurchasingContext makes of that news, on its way in"
  }
  inlet InventoryCommandStreamIn is type InventoryCommand  outlet InventoryCommandStreamOut is type InventoryCommand
  inlet StockItemResultStreamIn is result Inventory.InventoryEntityResult  outlet StockItemResultStreamOut is result Inventory.InventoryEntityResult
  handler WarehouseContextBoundary is {
    on recordProductDetails: command Inventory.RecordProductDetails is {
      forward recordProductDetails to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on receiveInventory: command Inventory.ReceiveInventory is {
      forward receiveInventory to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on adjustInventory: command Inventory.AdjustInventory is {
      forward adjustInventory to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on reserveInventory: command Inventory.ReserveInventory is {
      forward reserveInventory to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on releaseReservation: command Inventory.ReleaseReservation is {
      forward releaseReservation to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on transferInventory: command Inventory.TransferInventory is {
      forward transferInventory to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on updateLocation: command Inventory.UpdateLocation is {
      forward updateLocation to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on shipInventory: command Inventory.ShipInventory is {
      forward shipInventory to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on quarantineInventory: command Inventory.QuarantineInventory is {
      forward quarantineInventory to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on releaseFromQuarantine: command Inventory.ReleaseFromQuarantine is {
      forward releaseFromQuarantine to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on inventoryEntityResult: result Inventory.InventoryEntityResult is {
      send inventoryEntityResult to outlet WarehouseContext.StockItemResultStreamOut
    }
    on other is {
      error "Unexpected message at the WarehouseContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'InventoryCommand Stream Intake' is from outlet WarehouseContext.InventoryCommandStreamOut to inlet WarehouseContext.Inventory.InventoryCommands  connector 'StockItemResult Stream Egress' is from outlet WarehouseContext.InventoryRepository.InventoryRepositoryResponses to inlet WarehouseContext.StockItemResultStreamIn  adaptor FromInventoryPlanningContext from context InventoryPlanningContext as sink is { 
    inlet FromInventoryPlanningContextIn is type InventoryPlanningContext.InventoryPlanningContextEvent    handler FromInventoryPlanningContextHandler is {
      on demandForecastUpdated: event InventoryPlanningContext.DemandForecastUpdated is {
        do "planning's forecast moved; nothing the warehouse holds changes until an order or purchase order follows"
      }
      on reorderPointUpdated: event InventoryPlanningContext.ReorderPointUpdated is {
        do "the reorder point moved; replenishment is purchasing's act"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryPlanningContext"
      }
    } with {
      briefly "from inventory planning context"
      described as {
        |Carries messages from the external InventoryPlanningContext.
      }
    }
  } with {
    briefly "InventoryPlanningContext integration"
    described as {
      |The model's side of the InventoryPlanningContext conversation.
    }
  }
  adaptor FromOrderManagementContext from context OrderManagementContext as flow is { 
    inlet FromOrderManagementContextIn is type OrderManagementContext.OrderManagementContextEvent    outlet FromOrderManagementContextToWarehouseContext is type WarehouseContext.FromOrderManagementContextCommand
    handler FromOrderManagementContextHandler is {
      on orderCancelled: event OrderManagementContext.OrderCancelled is {
        let item0: type Inventory.ReleaseReservation = prompt("translate the orderCancelled event into a ReleaseReservation, a cancelled order no longer needs the stock held for it")
        send item0 to outlet WarehouseContext.FromOrderManagementContext.FromOrderManagementContextToWarehouseContext
      }
      on orderCreated: event OrderManagementContext.OrderCreated is {
        let item0: type Inventory.ReserveInventory = prompt("translate the orderCreated event into a ReserveInventory, a new order's lines are what stock is held for")
        send item0 to outlet WarehouseContext.FromOrderManagementContext.FromOrderManagementContextToWarehouseContext
      }
      on orderShipmentRequested: event OrderManagementContext.OrderShipmentRequested is {
        do "order management wants it shipped by the date; the stock leaves when the warehouse ships it"
      }
      on other is {
        error "Unexpected message for adaptor FromOrderManagementContext"
      }
    } with {
      briefly "from order management context"
      described as {
        |Carries messages from the external OrderManagementContext.
      }
    }
  } with {
    briefly "OrderManagementContext integration"
    described as {
      |The model's side of the OrderManagementContext conversation.
    }
  }
  adaptor ToProductCatalogContext to context ProductCatalogContext as router is { 
    outlet ToProductCatalogContextToWarehouseContext is command Inventory.RecordProductDetails
    inlet ToProductCatalogContextIn is type InventoryEvent    inlet ToProductCatalogContextReplies is result ProductCatalogContext.ProductDetailsResult    outlet ToProductCatalogContextOut is query ProductCatalogContext.GetProductDetails
    handler ToProductCatalogContextHandler is {
      on inventoryReceived: event Inventory.InventoryReceived is {
        let askAnswer: type ProductCatalogContext.ProductDetailsResult = ask query ProductCatalogContext.GetProductDetails of context ProductCatalogContext
        do "received stock needing the catalogue's dimensions and handling rules"
        send command Inventory.RecordProductDetails(inventoryId = inventoryReceived.inventoryId, productName = prompt("the product name of this record product details"), sku = prompt("the sku of this record product details"), weight = prompt("the weight of this record product details")) to outlet WarehouseContext.ToProductCatalogContext.ToProductCatalogContextToWarehouseContext
      }
      on other is {
        error "Unexpected message for adaptor ToProductCatalogContext"
      }
    } with {
      briefly "to product catalog context"
      described as {
        |Carries messages to the external ProductCatalogContext.
      }
    }
  } with {
    briefly "ProductCatalogContext integration"
    described as {
      |The model's side of the ProductCatalogContext conversation.
    }
  }
  adaptor FromPurchasingContext from context PurchasingContext as flow is { 
    inlet FromPurchasingContextIn is type PurchasingContext.PurchasingContextEvent    outlet FromPurchasingContextToWarehouseContext is command Inventory.ReceiveInventory
    handler FromPurchasingContextHandler is {
      on inboundShipmentArrived: event PurchasingContext.InboundShipmentArrived is {
        let item0: type Inventory.ReceiveInventory = prompt("translate the inboundShipmentArrived event into a ReceiveInventory, a shipment at the dock is what the warehouse receives against its purchase order")
        send item0 to outlet WarehouseContext.FromPurchasingContext.FromPurchasingContextToWarehouseContext
      }
      on purchaseOrderReceived: event PurchasingContext.PurchaseOrderReceived is {
        do "a purchase order is placed; stock is received when the shipment arrives"
      }
      on other is {
        error "Unexpected message for adaptor FromPurchasingContext"
      }
    } with {
      briefly "from purchasing context"
      described as {
        |Carries messages from the external PurchasingContext.
      }
    }
  } with {
    briefly "PurchasingContext integration"
    described as {
      |The model's side of the PurchasingContext conversation.
    }
  }
  adaptor FromShippingContext from context ShippingContext as sink is { 
    inlet FromShippingContextIn is type ShippingContext.ShippingContextEvent    handler FromShippingContextHandler is {
      on shipmentDelivered: event ShippingContext.ShipmentDelivered is {
        do "the goods reached the customer; the stock left when it was shipped"
      }
      on shipmentDispatched: event ShippingContext.ShipmentDispatched is {
        do "the carrier has taken the shipment; shipping the stock was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromShippingContext"
      }
    } with {
      briefly "from shipping context"
      described as {
        |Carries messages from the external ShippingContext.
      }
    }
  } with {
    briefly "ShippingContext integration"
    described as {
      |The model's side of the ShippingContext conversation.
    }
  }
  adaptor ToShippingContext to context ShippingContext as flow is { 
    inlet ToShippingContextIn is type InventoryEvent    outlet ToShippingContextOut is command ShippingContext.CreateShipment
    handler ToShippingContextHandler is {
      on inventoryReserved: event Inventory.InventoryReserved is {
        let item0: type ShippingContext.CreateShipment = prompt("translate the inventoryReserved event into a CreateShipment, reservation being what commits stock to a shipment")
        send item0 to outlet WarehouseContext.ToShippingContext.ToShippingContextOut
      }
      on other is {
        error "Unexpected message for adaptor ToShippingContext"
      }
    } with {
      briefly "to shipping context"
      described as {
        |Carries messages to the external ShippingContext.
      }
    }
  } with {
    briefly "ShippingContext integration"
    described as {
      |The model's side of the ShippingContext conversation.
    }
  }
  // Include type definitions
  include "types.riddl"
  // Include the Inventory entity
  include "Inventory.riddl"
  // Repository for inventory persistence and queries
  type InventoryRepositoryCommand is one of {
    WarehouseContext.InventoryRepository.PersistInventoryAdjusted or WarehouseContext.InventoryRepository.PersistInventoryQuarantined or WarehouseContext.InventoryRepository.PersistInventoryReceived or WarehouseContext.InventoryRepository.PersistInventoryReleasedFromQuarantine or WarehouseContext.InventoryRepository.PersistInventoryReserved or WarehouseContext.InventoryRepository.PersistInventoryShipped or WarehouseContext.InventoryRepository.PersistInventoryTransferred or WarehouseContext.InventoryRepository.PersistLocationUpdated or WarehouseContext.InventoryRepository.PersistReservationReleased
  } with {
    briefly "Anything that writes InventoryRepository"
    described as {
      |The persistence commands InventoryRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository InventoryRepository as flow is {
    inlet InventoryRepositoryFromInventoryProjector is type InventoryRepositoryCommand    command PersistLocationUpdated is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row LocationUpdated applies to.
        }
      }
      previousLocationId: LocationId? with {
        briefly "Previous location id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newLocationId: LocationId? with {
        briefly "New location id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      movedBy: String(1,100)? with {
        briefly "Moved by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      timestamp: TimeStamp? with {
        briefly "Timestamp"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist LocationUpdated"
      described as {
        |Instructs this repository to apply LocationUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInventoryAdjusted is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryAdjusted applies to.
        }
      }
      previousQuantity: Integer? with {
        briefly "Previous quantity"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newQuantity: Integer? with {
        briefly "New quantity"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      adjustmentQuantity: Integer? with {
        briefly "Adjustment quantity"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      adjustedBy: String(1,100)? with {
        briefly "Adjusted by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      timestamp: TimeStamp? with {
        briefly "Timestamp"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist InventoryAdjusted"
      described as {
        |Instructs this repository to apply InventoryAdjusted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInventoryQuarantined is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
