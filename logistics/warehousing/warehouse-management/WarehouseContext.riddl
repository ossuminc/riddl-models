        }
      }
    } with {
      briefly "Persist InventoryShipped"
      described as {
        |Instructs this repository to apply InventoryShipped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInventoryTransferred is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryTransferred applies to.
        }
      }
      fromLocationId: LocationId? with {
        briefly "From location id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      toLocationId: LocationId? with {
        briefly "To location id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      quantity: Integer? with {
        briefly "Quantity"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      transferredBy: String(1,100)? with {
        briefly "Transferred by"
        described as {
