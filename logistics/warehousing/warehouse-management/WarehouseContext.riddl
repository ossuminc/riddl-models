      }
    }
    record StoredInventory is {
      inventoryId: InventoryId with {
        briefly "inventoryId"
        described as {
          |The inventoryId column of the stored inventory row.
        }
      }
      previousLocationId: LocationId? with {
        briefly "Previous location id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newLocationId: LocationId? with {
        briefly "New location id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      movedBy: String(1,100)? with {
