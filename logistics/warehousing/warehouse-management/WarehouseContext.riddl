        }
      }
      adjustedBy: String(1,100)? with {
        briefly "Adjusted by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      quarantinedBy: String(1,100)? with {
        briefly "Quarantined by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      productId: ProductId? with {
        briefly "Product id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      locationId: LocationId? with {
        briefly "Location id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      quantity: Integer? with {
        briefly "Quantity"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      unitOfMeasure: UnitOfMeasure? with {
        briefly "Unit of measure"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      lotNumber: String(,50)? with {
        briefly "Lot number"
