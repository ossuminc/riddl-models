    } with {
      briefly "Persist InventoryQuarantined"
      described as {
        |Instructs this repository to apply InventoryQuarantined to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInventoryReceived is {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryReceived applies to.
        }
      }
      productId: ProductId? with {
        briefly "Product id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      locationId: LocationId? with {
        briefly "Location id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      quantity: Integer? with {
        briefly "Quantity"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      unitOfMeasure: UnitOfMeasure? with {
        briefly "Unit of measure"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      lotNumber: String(,50)? with {
        briefly "Lot number"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      expirationDate: Date? with {
        briefly "Expiration date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      shipmentId: ShipmentId? with {
        briefly "Shipment id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      receivedBy: String(1,100)? with {
        briefly "Received by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      timestamp: TimeStamp? with {
        briefly "Timestamp"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
