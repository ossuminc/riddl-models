// Warehouse Context - Bounded context for warehouse operations
context WarehouseContext as router is {
  inlet InventoryCommandStreamIn is type InventoryCommand  outlet InventoryCommandStreamOut is type InventoryCommand
  inlet StockItemResultStreamIn is type Inventory.InventoryEntityResult  outlet StockItemResultStreamOut is type Inventory.InventoryEntityResult
  handler WarehouseContextBoundary is {
    on receiveInventory: command Inventory.ReceiveInventory is {
      forward receiveInventory to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on adjustInventory: command Inventory.AdjustInventory is {
      forward adjustInventory to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on reserveInventory: command Inventory.ReserveInventory is {
      forward reserveInventory to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on releaseReservation: command Inventory.ReleaseReservation is {
      forward releaseReservation to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on transferInventory: command Inventory.TransferInventory is {
      forward transferInventory to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on updateLocation: command Inventory.UpdateLocation is {
      forward updateLocation to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on shipInventory: command Inventory.ShipInventory is {
      forward shipInventory to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on quarantineInventory: command Inventory.QuarantineInventory is {
      forward quarantineInventory to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on releaseFromQuarantine: command Inventory.ReleaseFromQuarantine is {
      forward releaseFromQuarantine to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on initializeInventory: command Inventory.InitializeInventory is {
      send initializeInventory to outlet WarehouseContext.InventoryCommandStreamOut
    }
    on inventoryEntityResult: result Inventory.InventoryEntityResult is {
      send inventoryEntityResult to outlet WarehouseContext.StockItemResultStreamOut
    }
    on other is {
      error "Unexpected message at the WarehouseContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'InventoryCommand Stream Intake' is from outlet WarehouseContext.InventoryCommandStreamOut to inlet WarehouseContext.Inventory.InventoryCommands  connector 'StockItemResult Stream Egress' is from outlet WarehouseContext.InventoryRepository.InventoryRepositoryResponses to inlet WarehouseContext.StockItemResultStreamIn  adaptor FromInventoryPlanningContext from context InventoryPlanningContext is { 
    handler FromInventoryPlanningContextHandler is {
      on event InventoryPlanningContext.DemandForecastUpdated is {
        do "the model receives demand forecast updated"
      }
      on event InventoryPlanningContext.ReorderPointUpdated is {
        do "the model receives reorder point updated"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryPlanningContext"
      }
    } with {
      briefly "from inventory planning context"
      described as {
        |Carries messages from the external InventoryPlanningContext.
      }
    }
  } with {
    briefly "InventoryPlanningContext integration"
    described as {
      |The model's side of the InventoryPlanningContext conversation.
    }
  }
  adaptor FromOrderManagementContext from context OrderManagementContext is { 
    handler FromOrderManagementContextHandler is {
      on event OrderManagementContext.OrderCancelled is {
        do "the model receives order cancelled"
      }
      on event OrderManagementContext.OrderCreated is {
        do "the model receives order created"
      }
      on event OrderManagementContext.OrderShipmentRequested is {
        do "the model receives order shipment requested"
      }
      on other is {
        error "Unexpected message for adaptor FromOrderManagementContext"
      }
    } with {
      briefly "from order management context"
      described as {
        |Carries messages from the external OrderManagementContext.
      }
    }
  } with {
    briefly "OrderManagementContext integration"
    described as {
      |The model's side of the OrderManagementContext conversation.
    }
  }
  adaptor FromProductCatalogContext from context ProductCatalogContext is { 
    handler FromProductCatalogContextHandler is {
      on result ProductCatalogContext.ProductDetailsResult is {
        do "the model receives product details result"
      }
      on other is {
        error "Unexpected message for adaptor FromProductCatalogContext"
      }
    } with {
      briefly "from product catalog context"
      described as {
        |Carries messages from the external ProductCatalogContext.
      }
    }
  } with {
    briefly "ProductCatalogContext integration"
    described as {
      |The model's side of the ProductCatalogContext conversation.
    }
  }
  adaptor ToProductCatalogContext to context ProductCatalogContext is { 
    handler ToProductCatalogContextHandler is {
      on query ProductCatalogContext.GetProductDetails is {
        do "the model sends get product details"
      }
      on other is {
        error "Unexpected message for adaptor ToProductCatalogContext"
      }
    } with {
      briefly "to product catalog context"
      described as {
        |Carries messages to the external ProductCatalogContext.
      }
    }
  } with {
    briefly "ProductCatalogContext integration"
    described as {
      |The model's side of the ProductCatalogContext conversation.
    }
  }
  adaptor FromPurchasingContext from context PurchasingContext is { 
    handler FromPurchasingContextHandler is {
      on event PurchasingContext.InboundShipmentArrived is {
        do "the model receives inbound shipment arrived"
      }
      on event PurchasingContext.PurchaseOrderReceived is {
        do "the model receives purchase order received"
      }
      on other is {
        error "Unexpected message for adaptor FromPurchasingContext"
      }
    } with {
      briefly "from purchasing context"
      described as {
        |Carries messages from the external PurchasingContext.
      }
    }
  } with {
    briefly "PurchasingContext integration"
    described as {
      |The model's side of the PurchasingContext conversation.
    }
  }
  adaptor FromShippingContext from context ShippingContext is { 
    handler FromShippingContextHandler is {
      on event ShippingContext.ShipmentDelivered is {
        do "the model receives shipment delivered"
      }
      on event ShippingContext.ShipmentDispatched is {
        do "the model receives shipment dispatched"
      }
      on other is {
        error "Unexpected message for adaptor FromShippingContext"
      }
    } with {
      briefly "from shipping context"
      described as {
        |Carries messages from the external ShippingContext.
      }
    }
  } with {
    briefly "ShippingContext integration"
    described as {
      |The model's side of the ShippingContext conversation.
    }
  }
  adaptor ToShippingContext to context ShippingContext is { 
    handler ToShippingContextHandler is {
      on command ShippingContext.CreateShipment is {
        do "the model sends create shipment"
      }
      on other is {
        error "Unexpected message for adaptor ToShippingContext"
      }
    } with {
      briefly "to shipping context"
      described as {
        |Carries messages to the external ShippingContext.
      }
    }
  } with {
    briefly "ShippingContext integration"
    described as {
      |The model's side of the ShippingContext conversation.
    }
  }
  // Include type definitions
  include "types.riddl"
  // Include the Inventory entity
  include "Inventory.riddl"
  // Repository for inventory persistence and queries
  repository InventoryRepository as merge is {
    command PersistInventoryAdjusted is  {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryAdjusted applies to.
        }
      }
    } with {
      briefly "Persist InventoryAdjusted"
      described as {
        |Instructs this repository to apply InventoryAdjusted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInventoryQuarantined is  {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryQuarantined applies to.
        }
      }
    } with {
      briefly "Persist InventoryQuarantined"
      described as {
        |Instructs this repository to apply InventoryQuarantined to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInventoryReceived is  {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryReceived applies to.
        }
      }
    } with {
      briefly "Persist InventoryReceived"
      described as {
        |Instructs this repository to apply InventoryReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInventoryReleasedFromQuarantine is  {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryReleasedFromQuarantine applies to.
        }
      }
    } with {
      briefly "Persist InventoryReleasedFromQuarantine"
      described as {
        |Instructs this repository to apply InventoryReleasedFromQuarantine to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInventoryReserved is  {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryReserved applies to.
        }
      }
    } with {
      briefly "Persist InventoryReserved"
      described as {
        |Instructs this repository to apply InventoryReserved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInventoryShipped is  {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryShipped applies to.
        }
      }
    } with {
      briefly "Persist InventoryShipped"
      described as {
        |Instructs this repository to apply InventoryShipped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInventoryTransferred is  {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryTransferred applies to.
        }
      }
    } with {
      briefly "Persist InventoryTransferred"
      described as {
        |Instructs this repository to apply InventoryTransferred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationReleased is  {
      inventoryId: InventoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationReleased applies to.
        }
      }
    } with {
      briefly "Persist ReservationReleased"
      described as {
        |Instructs this repository to apply ReservationReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredInventory is  {
      inventoryId: InventoryId with {
        briefly "inventoryId"
        described as {
          |The inventoryId column of the stored inventory row.
        }
      }
    } with {
      briefly "Stored inventory row"
      described as {
        |The persistence shape of inventory data as this repository stores it.
      }
    }
    schema InventoryData is relational
      of inventorys as type StoredInventory
        index on field StoredInventory.inventoryId
 with {
      briefly "Inventory data schema"
      described as {
        |The relational schema persisting inventory records for this repository.
      }
    }
    inlet InventoryRepositoryFromInventory is type InventoryEvent    inlet InventoryRepositoryFromInventoryProjector is type InventoryEvent    outlet InventoryRepositoryResponses is type Inventory.InventoryEntityResult
    // Queries
    query GetInventoryById is  { inventoryId: InventoryId } with {
      briefly "Retrieve inventory by its unique identifier"
      described as {
        |Fetches a single inventory record by its ID.
      }
    }
    result InventoryResult is  {
      inventoryId: InventoryId with {
        briefly "Inventory addressed"
        described as {
          |Which inventory this message concerns.
        }
      }
      inventory: InventoryInfo?
    } with {
      briefly "Result of inventory lookup"
      described as {
        |Returns the inventory record if found, or empty if not found.
      }
    }
    query GetInventoryByProduct is  { productId: ProductId } with {
      briefly "Retrieve all inventory for a product"
      described as {
        |Fetches all inventory records across all locations for a given product.
      }
    }
    result InventoryListResult is  {
      inventoryId: InventoryId with {
        briefly "Inventory addressed"
        described as {
          |Which inventory this message concerns.
        }
      }
      inventories: InventoryInfo*
    } with {
      briefly "List of inventory records"
      described as {
        |Returns zero or more inventory records matching the query criteria.
      }
    }
    query GetInventoryByLocation is  { locationId: LocationId } with {
      briefly "Retrieve all inventory at a location"
      described as {
        |Fetches all inventory records stored at a specific warehouse location.
      }
    }
    query GetLowStockInventory is  {
      warehouseId: WarehouseId
      threshold: Integer
    } with {
      briefly "Find inventory below reorder threshold"
      described as {
        |Retrieves all inventory items with available quantity below the specified threshold.
      }
    }
    result LowStockResult is  {
      inventoryId: InventoryId with {
        briefly "Inventory addressed"
        described as {
          |Which inventory this message concerns.
        }
      }
      alerts: LowStockAlert*
    } with {
      briefly "List of low stock alerts"
      described as {
        |Returns low stock alerts for items below threshold.
      }
    }
    query GetInventoryMovementHistory is  {
      inventoryId: InventoryId
      fromDate: Date
      toDate: Date
    } with {
      briefly "Retrieve movement history for inventory"
      described as {
        |Fetches all movement records for an inventory item within a date range.
      }
    }
    result MovementHistoryResult is  {
      inventoryId: InventoryId with {
        briefly "Inventory addressed"
        described as {
          |Which inventory this message concerns.
        }
      }
      movements: MovementRecord*
    } with {
      briefly "List of movement records"
      described as {
        |Returns the movement history for the specified inventory.
      }
    }
    // Handler for queries
    handler InventoryQueryHandler is {
      on persistInventoryAdjusted: command PersistInventoryAdjusted is {
        do "apply InventoryAdjusted to the stored row"
      }
      on persistInventoryQuarantined: command PersistInventoryQuarantined is {
        do "apply InventoryQuarantined to the stored row"
      }
      on persistInventoryReceived: command PersistInventoryReceived is {
        do "apply InventoryReceived to the stored row"
      }
      on persistInventoryReleasedFromQuarantine: command PersistInventoryReleasedFromQuarantine is {
        do "apply InventoryReleasedFromQuarantine to the stored row"
      }
      on persistInventoryReserved: command PersistInventoryReserved is {
        do "apply InventoryReserved to the stored row"
      }
      on persistInventoryShipped: command PersistInventoryShipped is {
        do "apply InventoryShipped to the stored row"
      }
      on persistInventoryTransferred: command PersistInventoryTransferred is {
        do "apply InventoryTransferred to the stored row"
      }
      on persistReservationReleased: command PersistReservationReleased is {
        do "apply ReservationReleased to the stored row"
      }
      on query GetInventoryLevelProjection is {
        let inventoryLevelProjectionView: type InventoryLevelProjectionView = prompt("read the inventory level projection projection")
        reply inventoryLevelProjectionView
      }
      on query GetLocationUtilizationProjection is {
        let locationUtilizationProjectionView: type LocationUtilizationProjectionView = prompt("read the location utilization projection projection")
        reply locationUtilizationProjectionView
      }
      on query GetMovementSummaryProjection is {
        let movementSummaryProjectionView: type MovementSummaryProjectionView = prompt("read the movement summary projection projection")
        reply movementSummaryProjectionView
      }
      on query GetInventoryById is {
        let inventoryResult: type InventoryResult = prompt("read the inventory from the store")
        tell inventoryResult to entity WarehouseContext.Inventory
      }
      on query GetInventoryByProduct is {
        let inventoryListResult: type InventoryListResult = prompt("read the inventory list that inventory by product asks for")
        tell inventoryListResult to entity WarehouseContext.Inventory
      }
      on query GetInventoryByLocation is {
        let inventoryListResult: type InventoryListResult = prompt("read the inventory list that inventory by location asks for")
        tell inventoryListResult to entity WarehouseContext.Inventory
      }
      on query GetLowStockInventory is {
        let lowStockResult: type LowStockResult = prompt("read the low stock from the store")
        tell lowStockResult to entity WarehouseContext.Inventory
      }
      on query GetInventoryMovementHistory is {
        let movementHistoryResult: type MovementHistoryResult = prompt("read the movement history from the store")
        tell movementHistoryResult to entity WarehouseContext.Inventory
      }
    } with {
      briefly "Handles inventory query requests"
      described as {
        |Processes queries against the inventory data store and returns results.
      }
    }
  } with {
    briefly "Repository for inventory data access"
    described as {
      | Provides persistence and query capabilities for inventory data.
      | Supports queries by ID, product, location, and various filtering
      | criteria for operational reporting.
    }
  }
  // Projector for inventory analytics and reporting views
  query GetInventoryLevelProjection replies result InventoryLevelProjectionView is  {
    inventoryLevelProjectionKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which inventory level projection to retrieve.
      }
    }
  } with {
    briefly "Get inventory level projection"
    described as {
      |Retrieves the inventory level projection projection.
    }
  }
  result InventoryLevelProjectionView is  {
    inventoryLevelProjection: InventoryProjector.InventoryLevelProjection with {
      briefly "Inventory level projection"
      described as {
        |The inventory level projection being returned.
      }
    }
  } with {
    briefly "Inventory level projection view"
    described as {
      |Read model view carrying the inventory level projection projection.
    }
  }
  query GetLocationUtilizationProjection replies result LocationUtilizationProjectionView is  {
    locationUtilizationProjectionKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which location utilization projection to retrieve.
      }
    }
  } with {
    briefly "Get location utilization projection"
    described as {
      |Retrieves the location utilization projection projection.
    }
  }
  result LocationUtilizationProjectionView is  {
    locationUtilizationProjection: InventoryProjector.LocationUtilizationProjection with {
      briefly "Location utilization projection"
      described as {
        |The location utilization projection being returned.
      }
    }
  } with {
    briefly "Location utilization projection view"
    described as {
      |Read model view carrying the location utilization projection projection.
    }
  }
  query GetMovementSummaryProjection replies result MovementSummaryProjectionView is  {
    movementSummaryProjectionKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which movement summary projection to retrieve.
      }
    }
  } with {
    briefly "Get movement summary projection"
    described as {
      |Retrieves the movement summary projection projection.
    }
  }
  result MovementSummaryProjectionView is  {
    movementSummaryProjection: InventoryProjector.MovementSummaryProjection with {
      briefly "Movement summary projection"
      described as {
        |The movement summary projection being returned.
      }
    }
  } with {
    briefly "Movement summary projection view"
    described as {
      |Read model view carrying the movement summary projection projection.
    }
  }
  projector InventoryProjector as flow is {
    updates repository WarehouseContext.InventoryRepository
    inlet InventoryProjectorFromInventory is type InventoryEvent    outlet InventoryProjectorOut is type InventoryEvent
    // Record types for projections
    record InventoryLevelProjection is  {
      productId: ProductId
      productName: String(1,200)
      totalOnHand: Integer
      totalAvailable: Integer
      totalReserved: Integer
      totalQuarantined: Integer
      locationCount: Integer
      lastUpdated: TimeStamp
    } with {
      briefly "Aggregated inventory levels by product"
      described as {
        |Provides a consolidated view of inventory quantities across all locations for reporting.
      }
    }
    record LocationUtilizationProjection is  {
      locationId: LocationId
      warehouseId: WarehouseId
      locationType: LocationType
      maxCapacity: Integer
      currentUtilization: Integer
      utilizationPercent: Number
      itemCount: Integer
    } with {
      briefly "Location capacity utilization"
      described as {
        |Shows how much of each location's capacity is being used.
      }
    }
    record MovementSummaryProjection is  {
      warehouseId: WarehouseId
      periodStart: Date
      periodEnd: Date
      totalReceipts: Integer
      totalShipments: Integer
      totalTransfers: Integer
      totalAdjustments: Integer
      netChange: Integer
    } with {
      briefly "Summary of inventory movements"
      described as {
        |Aggregates inventory movement activity over a time period for reporting.
      }
    }
    // Handler for processing inventory events into projections
    handler ProjectionHandler is {
      on inventoryReceived: event Inventory.InventoryReceived is {
        tell command WarehouseContext.InventoryRepository.PersistInventoryReceived(inventoryId = inventoryReceived.inventoryId) to repository WarehouseContext.InventoryRepository
      }
      on inventoryShipped: event Inventory.InventoryShipped is {
        tell command WarehouseContext.InventoryRepository.PersistInventoryShipped(inventoryId = inventoryShipped.inventoryId) to repository WarehouseContext.InventoryRepository
      }
      on inventoryTransferred: event Inventory.InventoryTransferred is {
        tell command WarehouseContext.InventoryRepository.PersistInventoryTransferred(inventoryId = inventoryTransferred.inventoryId) to repository WarehouseContext.InventoryRepository
      }
      on inventoryAdjusted: event Inventory.InventoryAdjusted is {
        tell command WarehouseContext.InventoryRepository.PersistInventoryAdjusted(inventoryId = inventoryAdjusted.inventoryId) to repository WarehouseContext.InventoryRepository
      }
      on inventoryReserved: event Inventory.InventoryReserved is {
        tell command WarehouseContext.InventoryRepository.PersistInventoryReserved(inventoryId = inventoryReserved.inventoryId) to repository WarehouseContext.InventoryRepository
      }
      on reservationReleased: event Inventory.ReservationReleased is {
        tell command WarehouseContext.InventoryRepository.PersistReservationReleased(inventoryId = reservationReleased.inventoryId) to repository WarehouseContext.InventoryRepository
      }
      on inventoryQuarantined: event Inventory.InventoryQuarantined is {
        tell command WarehouseContext.InventoryRepository.PersistInventoryQuarantined(inventoryId = inventoryQuarantined.inventoryId) to repository WarehouseContext.InventoryRepository
      }
      on inventoryReleasedFromQuarantine: event Inventory.InventoryReleasedFromQuarantine is {
        tell command WarehouseContext.InventoryRepository.PersistInventoryReleasedFromQuarantine(inventoryId = inventoryReleasedFromQuarantine.inventoryId) to repository WarehouseContext.InventoryRepository
      }
    } with {
      briefly "Processes events into read-optimized projections"
      described as {
        | Subscribes to inventory events and maintains denormalized read
        | models optimized for reporting and analytics queries.
      }
    }
  } with {
    briefly "Maintains read-optimized inventory views"
    described as {
      | The InventoryProjector subscribes to inventory events and maintains
      | denormalized views optimized for reporting, dashboards, and analytics.
      | It provides aggregated views by product, location utilization metrics,
      | and movement summaries for operational visibility.
    }
  }
  type InventoryEvent is one of {
    WarehouseContext.Inventory.InventoryReceived or WarehouseContext.Inventory.InventoryShipped or WarehouseContext.Inventory.InventoryAdjusted or WarehouseContext.Inventory.InventoryQuarantined or WarehouseContext.Inventory.InventoryReleasedFromQuarantine or WarehouseContext.Inventory.InventoryReserved or WarehouseContext.Inventory.InventoryTransferred or WarehouseContext.Inventory.LocationUpdated or WarehouseContext.Inventory.ReservationReleased
  } with {
    briefly "Inventory event union"
    described as {
      |Union of Inventory events for streaming.
    }
  }
  processor InventoryEventSource as source is {
    outlet InventoryEvents is type InventoryEvent
    handler InventoryEventEmitter is {
      on init is {
        let initializeInventory: type Inventory.InitializeInventory = prompt("the initialize inventory that brings this this into existence")
        tell initializeInventory to entity WarehouseContext.Inventory
      }
      on other is {
        error "Unexpected message for source InventoryEventSource"
      }
      on inventoryReceived: event Inventory.InventoryReceived is {
        send inventoryReceived to outlet InventoryEvents
      }
      on inventoryShipped: event Inventory.InventoryShipped is {
        send inventoryShipped to outlet InventoryEvents
      }
      on inventoryAdjusted: event Inventory.InventoryAdjusted is {
        send inventoryAdjusted to outlet InventoryEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits Inventory events to the stream.
      }
    }
  } with {
    briefly "Inventory event source"
    described as {
      |Publishes Inventory events to the event stream.
    }
  }
  processor InventoryEventSink as sink is {
    inlet IncomingInventoryEvents is type InventoryEvent    handler InventoryEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink InventoryEventSink"
      }
      on inventoryReceived: event Inventory.InventoryReceived is {
        tell inventoryReceived to repository WarehouseContext.InventoryRepository
      }
      on inventoryShipped: event Inventory.InventoryShipped is {
        tell inventoryShipped to repository WarehouseContext.InventoryRepository
      }
      on inventoryAdjusted: event Inventory.InventoryAdjusted is {
        tell inventoryAdjusted to repository WarehouseContext.InventoryRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives Inventory events for persistence.
      }
    }
  } with {
    briefly "Inventory event sink"
    described as {
      |Receives Inventory events from streaming.
    }
  }
  connector InventoryEventPipeline is from outlet WarehouseContext.InventoryEventSource.InventoryEvents to inlet WarehouseContext.InventoryEventSink.IncomingInventoryEvents with {
    briefly "Inventory event pipeline"
    described as {
      |Wires Inventory event source to sink.
    }
  }
  processor InventoryEventSplit as split is {
    inlet InventoryEventSplitIn is type InventoryEvent    outlet InventoryEventSplitToInventoryRepository is type InventoryEvent
    outlet InventoryEventSplitToInventoryProjector is type InventoryEvent
    handler InventoryEventSplitHandler is {
      on inventoryReceived: event Inventory.InventoryReceived is {
        send inventoryReceived to outlet InventoryEventSplitToInventoryRepository
        send inventoryReceived to outlet InventoryEventSplitToInventoryProjector
        tell inventoryReceived to entity WarehouseContext.Inventory
      }
      on inventoryAdjusted: event Inventory.InventoryAdjusted is {
        send inventoryAdjusted to outlet InventoryEventSplitToInventoryRepository
        send inventoryAdjusted to outlet InventoryEventSplitToInventoryProjector
        tell inventoryAdjusted to entity WarehouseContext.Inventory
      }
      on inventoryReserved: event Inventory.InventoryReserved is {
        send inventoryReserved to outlet InventoryEventSplitToInventoryRepository
        send inventoryReserved to outlet InventoryEventSplitToInventoryProjector
        tell inventoryReserved to entity WarehouseContext.Inventory
      }
      on reservationReleased: event Inventory.ReservationReleased is {
        send reservationReleased to outlet InventoryEventSplitToInventoryRepository
        send reservationReleased to outlet InventoryEventSplitToInventoryProjector
        tell reservationReleased to entity WarehouseContext.Inventory
      }
      on inventoryTransferred: event Inventory.InventoryTransferred is {
        send inventoryTransferred to outlet InventoryEventSplitToInventoryRepository
        send inventoryTransferred to outlet InventoryEventSplitToInventoryProjector
        tell inventoryTransferred to entity WarehouseContext.Inventory
      }
      on locationUpdated: event Inventory.LocationUpdated is {
        send locationUpdated to outlet InventoryEventSplitToInventoryRepository
        send locationUpdated to outlet InventoryEventSplitToInventoryProjector
        tell locationUpdated to entity WarehouseContext.Inventory
      }
      on inventoryShipped: event Inventory.InventoryShipped is {
        send inventoryShipped to outlet InventoryEventSplitToInventoryRepository
        send inventoryShipped to outlet InventoryEventSplitToInventoryProjector
        tell inventoryShipped to entity WarehouseContext.Inventory
      }
      on inventoryQuarantined: event Inventory.InventoryQuarantined is {
        send inventoryQuarantined to outlet InventoryEventSplitToInventoryRepository
        send inventoryQuarantined to outlet InventoryEventSplitToInventoryProjector
        tell inventoryQuarantined to entity WarehouseContext.Inventory
      }
      on inventoryReleasedFromQuarantine: event Inventory.InventoryReleasedFromQuarantine is {
        send inventoryReleasedFromQuarantine to outlet InventoryEventSplitToInventoryRepository
        send inventoryReleasedFromQuarantine to outlet InventoryEventSplitToInventoryProjector
        tell inventoryReleasedFromQuarantine to entity WarehouseContext.Inventory
      }
      on other is {
        error "Unexpected message for processor InventoryEventSplit"
      }
    } with {
      briefly "Inventory event fan-out handler"
      described as {
        |Delivers each Inventory event to all of its consumers.
      }
    }
  } with {
    briefly "Inventory event fan-out"
    described as {
      |Fans Inventory events out to the repository and projectors.
    }
  }
  connector 'InventoryEvent Stream' is from outlet WarehouseContext.Inventory.InventoryEvents2 to inlet WarehouseContext.InventoryEventSplit.InventoryEventSplitIn with {
    briefly "Inventory events, fanned out to storage and read models"
  }
  connector 'InventoryEvent Storage' is from outlet WarehouseContext.InventoryEventSplit.InventoryEventSplitToInventoryRepository to inlet WarehouseContext.InventoryRepository.InventoryRepositoryFromInventory with {
    briefly "Inventory events on their way to storage"
  }
  connector 'InventoryProjector Feed' is from outlet WarehouseContext.InventoryEventSplit.InventoryEventSplitToInventoryProjector to inlet WarehouseContext.InventoryProjector.InventoryProjectorFromInventory with {
    briefly "Inventory events feeding the InventoryProjector projection"
  }
  connector 'InventoryProjector Storage' is from outlet WarehouseContext.InventoryProjector.InventoryProjectorOut to inlet WarehouseContext.InventoryRepository.InventoryRepositoryFromInventoryProjector with {
    briefly "The InventoryProjector projection on its way to storage"
  }
} with {
  briefly "Bounded context for warehouse operations"
  described as {
    | The WarehouseContext is the primary bounded context for warehouse
    | management operations. It contains the Inventory entity for tracking
    | stock, repositories for data access, and projectors for maintaining
    | read-optimized views. This context coordinates all inventory movements
    | within the warehouse.
  }
}
