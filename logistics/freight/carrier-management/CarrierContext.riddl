// Carrier Management - Carrier Context
context CarrierContext as router is {
  inlet CarrierCommandStreamIn is type CarrierCommand  outlet CarrierCommandStreamOut is type CarrierCommand
  inlet CarrierResultStreamIn is result Carrier.CarrierResult  outlet CarrierResultStreamOut is result Carrier.CarrierResult
  handler CarrierContextBoundary is {
    on registerCarrier: command Carrier.RegisterCarrier is {
      send registerCarrier to outlet CarrierContext.CarrierCommandStreamOut
    }
    on verifyCredentials: command Carrier.VerifyCredentials is {
      send verifyCredentials to outlet CarrierContext.CarrierCommandStreamOut
    }
    on addInsurance: command Carrier.AddInsurance is {
      send addInsurance to outlet CarrierContext.CarrierCommandStreamOut
    }
    on updateInsurance: command Carrier.UpdateInsurance is {
      send updateInsurance to outlet CarrierContext.CarrierCommandStreamOut
    }
    on defineServiceArea: command Carrier.DefineServiceArea is {
      send defineServiceArea to outlet CarrierContext.CarrierCommandStreamOut
    }
    on addRate: command Carrier.AddRate is {
      send addRate to outlet CarrierContext.CarrierCommandStreamOut
    }
    on updateRate: command Carrier.UpdateRate is {
      send updateRate to outlet CarrierContext.CarrierCommandStreamOut
    }
    on activateCarrier: command Carrier.ActivateCarrier is {
      send activateCarrier to outlet CarrierContext.CarrierCommandStreamOut
    }
    on suspendCarrier: command Carrier.SuspendCarrier is {
      send suspendCarrier to outlet CarrierContext.CarrierCommandStreamOut
    }
    on reinstateCarrier: command Carrier.ReinstateCarrier is {
      send reinstateCarrier to outlet CarrierContext.CarrierCommandStreamOut
    }
    on recordPerformance: command Carrier.RecordPerformance is {
      send recordPerformance to outlet CarrierContext.CarrierCommandStreamOut
    }
    on updateCapacity: command Carrier.UpdateCapacity is {
      send updateCapacity to outlet CarrierContext.CarrierCommandStreamOut
    }
    on terminateCarrier: command Carrier.TerminateCarrier is {
      send terminateCarrier to outlet CarrierContext.CarrierCommandStreamOut
    }
    on carrierResult: result Carrier.CarrierResult is {
      send carrierResult to outlet CarrierContext.CarrierResultStreamOut
    }
    on other is {
      error "Unexpected message at the CarrierContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CarrierCommand Stream Intake' is from outlet CarrierContext.CarrierCommandStreamOut to inlet CarrierContext.Carrier.CarrierCommands  connector 'CarrierResult Stream Egress' is from outlet CarrierContext.CarrierRepository.CarrierRepositoryResponses to inlet CarrierContext.CarrierResultStreamIn  adaptor FromInsuranceVerification from context InsuranceVerification as sink is { 
    inlet FromInsuranceVerificationIn is event InsuranceVerification.InsuranceVerified    handler FromInsuranceVerificationHandler is {
      on insuranceVerified: event InsuranceVerification.InsuranceVerified is {
        do "the cover checks out; it is one of three checks a person weighs before verifying credentials"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceVerification"
      }
    } with {
      briefly "from insurance verification"
      described as {
        |Carries messages from the external InsuranceVerification.
      }
    }
  } with {
    briefly "InsuranceVerification integration"
    described as {
      |The model's side of the InsuranceVerification conversation.
    }
  }
  adaptor ToInsuranceVerification to context InsuranceVerification as flow is { 
    inlet ToInsuranceVerificationIn is type CarrierEvent    outlet ToInsuranceVerificationOut is command InsuranceVerification.VerifyInsuranceCoverage
    handler ToInsuranceVerificationHandler is {
      on insuranceAdded: event InsuranceAdded is {
        let check0: type InsuranceVerification.VerifyInsuranceCoverage = prompt("translate the insuranceAdded event into a VerifyInsuranceCoverage, a certificate being an assertion until it is checked")
        send check0 to outlet CarrierContext.ToInsuranceVerification.ToInsuranceVerificationOut
      }
      on other is {
        error "Unexpected message for adaptor ToInsuranceVerification"
      }
    } with {
      briefly "to insurance verification"
      described as {
        |Carries messages to the external InsuranceVerification.
      }
    }
  } with {
    briefly "InsuranceVerification integration"
    described as {
      |The model's side of the InsuranceVerification conversation.
    }
  }
  adaptor FromLoadBoard from context LoadBoard as sink is { 
    inlet FromLoadBoardIn is type LoadBoard.LoadBoardEvent    handler FromLoadBoardHandler is {
      on carrierBidReceived: event LoadBoard.CarrierBidReceived is {
        do "a carrier has bid on the load; accepting a bid is a decision and the rate is added when agreed"
      }
      on loadPosted: event LoadBoard.LoadPosted is {
        do "the board shows the load; the capacity that put it there was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromLoadBoard"
      }
    } with {
      briefly "from load board"
      described as {
        |Carries messages from the external LoadBoard.
      }
    }
  } with {
    briefly "LoadBoard integration"
    described as {
      |The model's side of the LoadBoard conversation.
    }
  }
  adaptor ToLoadBoard to context LoadBoard as flow is { 
    inlet ToLoadBoardIn is type CarrierEvent    outlet ToLoadBoardOut is command LoadBoard.PostLoad
    handler ToLoadBoardHandler is {
      on capacityUpdated: event Carrier.CapacityUpdated is {
        let item0: type LoadBoard.PostLoad = prompt("translate the capacityUpdated event into a PostLoad, spare capacity being what a load board exists to match")
        send item0 to outlet CarrierContext.ToLoadBoard.ToLoadBoardOut
      }
      on other is {
        error "Unexpected message for adaptor ToLoadBoard"
      }
    } with {
      briefly "to load board"
      described as {
        |Carries messages to the external LoadBoard.
      }
    }
  } with {
    briefly "LoadBoard integration"
    described as {
      |The model's side of the LoadBoard conversation.
    }
  }
  adaptor FromRateQuoting from context RateQuoting as sink is { 
    inlet FromRateQuotingIn is event RateQuoting.QuoteReceived    handler FromRateQuotingHandler is {
      on quoteReceived: event RateQuoting.QuoteReceived is {
        do "the quote is in; a rate is added when it is agreed, not when it is quoted"
      }
      on other is {
        error "Unexpected message for adaptor FromRateQuoting"
      }
    } with {
      briefly "from rate quoting"
      described as {
        |Carries messages from the external RateQuoting.
      }
    }
  } with {
    briefly "RateQuoting integration"
    described as {
      |The model's side of the RateQuoting conversation.
    }
  }
  adaptor ToRateQuoting to context RateQuoting as flow is { 
    inlet ToRateQuotingIn is type CarrierEvent    outlet ToRateQuotingOut is command RateQuoting.GetCarrierQuote
    handler ToRateQuotingHandler is {
      on carrierActivated: event Carrier.CarrierActivated is {
        let item0: type RateQuoting.GetCarrierQuote = prompt("translate the carrierActivated event into a GetCarrierQuote, a carrier becoming quotable when it enters service")
        send item0 to outlet CarrierContext.ToRateQuoting.ToRateQuotingOut
      }
      on other is {
        error "Unexpected message for adaptor ToRateQuoting"
      }
    } with {
      briefly "to rate quoting"
      described as {
        |Carries messages to the external RateQuoting.
      }
    }
  } with {
    briefly "RateQuoting integration"
    described as {
      |The model's side of the RateQuoting conversation.
    }
  }
  adaptor FromSaferWeb from context SaferWeb as sink is { 
    inlet FromSaferWebIn is type SaferWeb.SaferWebEvent    handler FromSaferWebHandler is {
      on dOTVerified: event SaferWeb.DOTVerified is {
        do "the DOT number checks out; it is one of three checks a person weighs before verifying credentials"
      }
      on safetyRecordRetrieved: event SaferWeb.SafetyRecordRetrieved is {
        do "the safety record is in; it is one of three checks a person weighs before verifying credentials"
      }
      on other is {
        error "Unexpected message for adaptor FromSaferWeb"
      }
    } with {
      briefly "from safer web"
      described as {
        |Carries messages from the external SaferWeb.
      }
    }
  } with {
    briefly "SaferWeb integration"
    described as {
      |The model's side of the SaferWeb conversation.
    }
  }
  adaptor ToSaferWeb to context SaferWeb as flow is { 
    inlet ToSaferWebIn is type CarrierEvent    outlet ToSaferWebOut is type SaferWeb.SaferWebCommand
    handler ToSaferWebHandler is {
      on carrierRegistered: event Carrier.CarrierRegistered is {
        let item0: type SaferWeb.VerifyDOTNumber = prompt("translate the carrierRegistered event into a VerifyDOTNumber, a carrier's authority having to be known before it may be used")
        send item0 to outlet CarrierContext.ToSaferWeb.ToSaferWebOut
        let item1: type SaferWeb.CheckSafetyRecord = prompt("translate the carrierRegistered event into a CheckSafetyRecord, its safety record having to be known for the same reason")
        send item1 to outlet CarrierContext.ToSaferWeb.ToSaferWebOut
      }
      on other is {
        error "Unexpected message for adaptor ToSaferWeb"
      }
    } with {
      briefly "to safer web"
      described as {
        |Carries messages to the external SaferWeb.
      }
    }
  } with {
    briefly "SaferWeb integration"
    described as {
      |The model's side of the SaferWeb conversation.
    }
  }
  include "types.riddl"
  include "Carrier.riddl"
  type CarrierRepositoryCommand is one of {
    CarrierContext.CarrierRepository.PersistCapacityUpdated or CarrierContext.CarrierRepository.PersistCarrierActivated or CarrierContext.CarrierRepository.PersistCarrierRegistered or CarrierContext.CarrierRepository.PersistCarrierReinstated or CarrierContext.CarrierRepository.PersistCarrierSuspended or CarrierContext.CarrierRepository.PersistCarrierTerminated or CarrierContext.CarrierRepository.PersistCredentialsVerified or CarrierContext.CarrierRepository.PersistInsuranceAdded or CarrierContext.CarrierRepository.PersistInsuranceUpdated or CarrierContext.CarrierRepository.PersistPerformanceRecorded or CarrierContext.CarrierRepository.PersistRateAdded or CarrierContext.CarrierRepository.PersistRateUpdated or CarrierContext.CarrierRepository.PersistServiceAreaDefined
  } with {
    briefly "Anything that writes CarrierRepository"
    described as {
      |The persistence commands CarrierRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository CarrierRepository as flow is {
    inlet CarrierRepositoryFromCarrierPerformance is type CarrierRepositoryCommand    command PersistCapacityUpdated is {
      carrierId: CarrierId with {
        briefly "Row addressed"
        described as {
          |Which stored row CapacityUpdated applies to.
        }
      }
      capacity: CapacityInfo? with {
        briefly "Capacity"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CapacityUpdated"
      described as {
        |Instructs this repository to apply CapacityUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCarrierReinstated is {
      carrierId: CarrierId with {
        briefly "Row addressed"
        described as {
          |Which stored row CarrierReinstated applies to.
        }
      }
      reinstatedBy: String(1,100)? with {
        briefly "Reinstated by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reinstatedAt: TimeStamp? with {
        briefly "Reinstated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CarrierReinstated"
      described as {
        |Instructs this repository to apply CarrierReinstated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCarrierSuspended is {
      carrierId: CarrierId with {
        briefly "Row addressed"
        described as {
          |Which stored row CarrierSuspended applies to.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      suspendedAt: TimeStamp? with {
        briefly "Suspended at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CarrierSuspended"
      described as {
        |Instructs this repository to apply CarrierSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCredentialsVerified is {
      carrierId: CarrierId with {
        briefly "Row addressed"
        described as {
          |Which stored row CredentialsVerified applies to.
        }
      }
      verifiedBy: String(1,100)? with {
        briefly "Verified by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      verifiedAt: TimeStamp? with {
        briefly "Verified at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CredentialsVerified"
      described as {
        |Instructs this repository to apply CredentialsVerified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInsuranceAdded is {
      carrierId: CarrierId with {
        briefly "Row addressed"
        described as {
          |Which stored row InsuranceAdded applies to.
        }
      }
      policy: InsurancePolicy? with {
        briefly "Policy"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist InsuranceAdded"
      described as {
        |Instructs this repository to apply InsuranceAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInsuranceUpdated is {
      carrierId: CarrierId with {
        briefly "Row addressed"
        described as {
          |Which stored row InsuranceUpdated applies to.
        }
      }
      policy: InsurancePolicy? with {
        briefly "Policy"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist InsuranceUpdated"
      described as {
        |Instructs this repository to apply InsuranceUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRateAdded is {
      carrierId: CarrierId with {
        briefly "Row addressed"
        described as {
          |Which stored row RateAdded applies to.
        }
      }
      rate: RateInfo? with {
        briefly "Rate"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist RateAdded"
      described as {
        |Instructs this repository to apply RateAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRateUpdated is {
      carrierId: CarrierId with {
        briefly "Row addressed"
        described as {
          |Which stored row RateUpdated applies to.
        }
      }
      rate: RateInfo? with {
        briefly "Rate"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist RateUpdated"
      described as {
        |Instructs this repository to apply RateUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceAreaDefined is {
      carrierId: CarrierId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceAreaDefined applies to.
        }
      }
      serviceArea: ServiceArea? with {
        briefly "Service area"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      definedAt: TimeStamp? with {
        briefly "Defined at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ServiceAreaDefined"
      described as {
        |Instructs this repository to apply ServiceAreaDefined to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCarrierActivated is {
      carrierId: CarrierId with {
        briefly "Row addressed"
        described as {
          |Which stored row CarrierActivated applies to.
        }
      }
      activatedBy: String(1,100)? with {
        briefly "Activated by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CarrierActivated"
      described as {
        |Instructs this repository to apply CarrierActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCarrierRegistered is {
      carrierId: CarrierId with {
        briefly "Row addressed"
        described as {
          |Which stored row CarrierRegistered applies to.
        }
      }
      carrierInfo: CarrierInfo? with {
        briefly "Carrier info"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      carrierType: CarrierType? with {
        briefly "Carrier type"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      registeredAt: TimeStamp? with {
        briefly "Registered at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CarrierRegistered"
      described as {
        |Instructs this repository to apply CarrierRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCarrierTerminated is {
      carrierId: CarrierId with {
        briefly "Row addressed"
        described as {
          |Which stored row CarrierTerminated applies to.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      terminatedAt: TimeStamp? with {
        briefly "Terminated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CarrierTerminated"
      described as {
        |Instructs this repository to apply CarrierTerminated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPerformanceRecorded is {
      carrierId: CarrierId with {
        briefly "Row addressed"
        described as {
          |Which stored row PerformanceRecorded applies to.
        }
      }
      metrics: PerformanceMetrics? with {
        briefly "Metrics"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      periodEnd: Date? with {
        briefly "Period end"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PerformanceRecorded"
      described as {
        |Instructs this repository to apply PerformanceRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet CarrierRepositoryResponses is result Carrier.CarrierResult
    record StoredCarrier is {
      carrierId: CarrierId with {
        briefly "carrierId"
        described as {
          |The carrierId column of the stored carrier row.
        }
      }
      carrierInfo: CarrierInfo with {
        briefly "carrierInfo"
        described as {
          |The carrierInfo column of the stored carrier row.
        }
      }
      carrierType: CarrierType with {
        briefly "carrierType"
        described as {
          |The carrierType column of the stored carrier row.
        }
      }
      status: CarrierStatus with {
        briefly "status"
        described as {
          |The status column of the stored carrier row.
        }
      }
      capacity: CapacityInfo? with {
        briefly "Capacity"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reinstatedBy: String(1,100)? with {
        briefly "Reinstated by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reinstatedAt: TimeStamp? with {
        briefly "Reinstated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      suspendedAt: TimeStamp? with {
        briefly "Suspended at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      verifiedBy: String(1,100)? with {
        briefly "Verified by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      verifiedAt: TimeStamp? with {
        briefly "Verified at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      policy: InsurancePolicy? with {
        briefly "Policy"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      rate: RateInfo? with {
        briefly "Rate"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      serviceArea: ServiceArea? with {
        briefly "Service area"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      definedAt: TimeStamp? with {
        briefly "Defined at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      activatedBy: String(1,100)? with {
        briefly "Activated by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      registeredAt: TimeStamp? with {
        briefly "Registered at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      terminatedAt: TimeStamp? with {
        briefly "Terminated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      metrics: PerformanceMetrics? with {
        briefly "Metrics"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      periodEnd: Date? with {
        briefly "Period end"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored carrier row"
      described as {
        |The persistence shape of carrier data as this repository stores it.
      }
    }
    schema CarrierData is relational
      of carriers as record StoredCarrier
        key on field StoredCarrier.carrierId
        index on field StoredCarrier.carrierInfo.dotNumber
        index on field StoredCarrier.carrierInfo.scac
        index on field StoredCarrier.status
        index on field StoredCarrier.carrierType
 with {
      briefly "Carrier data schema"
      described as {
        |The relational schema holding carrier data for the CarrierRepository.
      }
    }
    handler CarrierPersistence is {
      on persistCapacityUpdated: command PersistCapacityUpdated is {
        update CarrierData.carriers set capacity = persistCapacityUpdated.capacity, updatedAt = persistCapacityUpdated.updatedAt where carrierId == persistCapacityUpdated.carrierId
      }
      on persistCarrierReinstated: command PersistCarrierReinstated is {
        update CarrierData.carriers set reinstatedBy = persistCarrierReinstated.reinstatedBy, reinstatedAt = persistCarrierReinstated.reinstatedAt where carrierId == persistCarrierReinstated.carrierId
      }
      on persistCarrierSuspended: command PersistCarrierSuspended is {
        update CarrierData.carriers set reason = persistCarrierSuspended.reason, suspendedAt = persistCarrierSuspended.suspendedAt where carrierId == persistCarrierSuspended.carrierId
      }
      on persistCredentialsVerified: command PersistCredentialsVerified is {
        update CarrierData.carriers set verifiedBy = persistCredentialsVerified.verifiedBy, verifiedAt = persistCredentialsVerified.verifiedAt where carrierId == persistCredentialsVerified.carrierId
      }
      on persistInsuranceAdded: command PersistInsuranceAdded is {
        update CarrierData.carriers set policy = persistInsuranceAdded.policy, addedAt = persistInsuranceAdded.addedAt where carrierId == persistInsuranceAdded.carrierId
      }
      on persistInsuranceUpdated: command PersistInsuranceUpdated is {
        update CarrierData.carriers set policy = persistInsuranceUpdated.policy, updatedAt = persistInsuranceUpdated.updatedAt where carrierId == persistInsuranceUpdated.carrierId
      }
      on persistRateAdded: command PersistRateAdded is {
        update CarrierData.carriers set rate = persistRateAdded.rate, addedAt = persistRateAdded.addedAt where carrierId == persistRateAdded.carrierId
      }
      on persistRateUpdated: command PersistRateUpdated is {
        update CarrierData.carriers set rate = persistRateUpdated.rate, updatedAt = persistRateUpdated.updatedAt where carrierId == persistRateUpdated.carrierId
      }
      on persistServiceAreaDefined: command PersistServiceAreaDefined is {
        update CarrierData.carriers set serviceArea = persistServiceAreaDefined.serviceArea, definedAt = persistServiceAreaDefined.definedAt where carrierId == persistServiceAreaDefined.carrierId
      }
      on persistCarrierActivated: command PersistCarrierActivated is {
        update CarrierData.carriers set activatedBy = persistCarrierActivated.activatedBy, activatedAt = persistCarrierActivated.activatedAt where carrierId == persistCarrierActivated.carrierId
      }
      on persistCarrierRegistered: command PersistCarrierRegistered is {
        update CarrierData.carriers set carrierInfo = persistCarrierRegistered.carrierInfo, carrierType = persistCarrierRegistered.carrierType, registeredAt = persistCarrierRegistered.registeredAt where carrierId == persistCarrierRegistered.carrierId
      }
      on persistCarrierTerminated: command PersistCarrierTerminated is {
        update CarrierData.carriers set reason = persistCarrierTerminated.reason, terminatedAt = persistCarrierTerminated.terminatedAt where carrierId == persistCarrierTerminated.carrierId
      }
      on persistPerformanceRecorded: command PersistPerformanceRecorded is {
        update CarrierData.carriers set metrics = persistPerformanceRecorded.metrics, periodEnd = persistPerformanceRecorded.periodEnd, recordedAt = persistPerformanceRecorded.recordedAt where carrierId == persistPerformanceRecorded.carrierId
      }
      on query GetCarrierRankings is {
        let carrierRankingsView: type CarrierRankingsView = prompt("read the carrier rankings projection")
        reply carrierRankingsView
      }
    } with {
      briefly "Persists carrier commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Carrier data persistence"
    described as {
      |Persistent storage for carriers.
    }
  }
  query GetCarrierRankings replies result CarrierRankingsView is {
    carrierRankingsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which carrier rankings to retrieve.
      }
    }
  } with {
    briefly "Get carrier rankings"
    described as {
      |Retrieves the carrier rankings projection.
    }
  }
  result CarrierRankingsView is {
    carrierRankings: CarrierPerformance.CarrierRankings with {
      briefly "Carrier rankings"
      described as {
        |The carrier rankings being returned.
      }
    }
  } with {
    briefly "Carrier rankings view"
    described as {
      |Read model view carrying the carrier rankings projection.
    }
  }
  projector CarrierPerformance as flow is {
    updates repository CarrierContext.CarrierRepository
    outlet CarrierPerformanceToRepository is type CarrierRepositoryCommand
    inlet CarrierPerformanceFromCarrier is type CarrierEvent    record CarrierRankings is {
      totalCarriers: Natural with {
        briefly "Total"
        described as {
          |Total carriers.
        }
      }
      activeCarriers: Natural with {
        briefly "Active"
        described as {
          |Active carriers.
        }
      }
      topPerformers: String(1,200)+ with {
        briefly "Top"
        described as {
          |Top carriers.
        }
      }
      averageOnTimeRate: Decimal(5,2) with {
        briefly "On-time"
        described as {
          |Avg on-time rate.
        }
      }
      averageClaimsRatio: Decimal(5,4) with {
        briefly "Claims"
        described as {
          |Avg claims ratio.
        }
      }
    } with {
      briefly "Carrier rankings"
      described as {
        |Carrier performance rankings.
      }
    }
    handler PerformanceHandler is {
      on capacityUpdated: event Carrier.CapacityUpdated is {
        tell command CarrierContext.CarrierRepository.PersistCapacityUpdated(carrierId = capacityUpdated.carrierId, capacity = capacityUpdated.capacity, updatedAt = capacityUpdated.updatedAt) to repository CarrierContext.CarrierRepository
        do "apply CapacityUpdated to the CarrierPerformance projection"
      }
      on carrierReinstated: event Carrier.CarrierReinstated is {
        tell command CarrierContext.CarrierRepository.PersistCarrierReinstated(carrierId = carrierReinstated.carrierId, reinstatedBy = carrierReinstated.reinstatedBy, reinstatedAt = carrierReinstated.reinstatedAt) to repository CarrierContext.CarrierRepository
        do "apply CarrierReinstated to the CarrierPerformance projection"
      }
      on carrierSuspended: event Carrier.CarrierSuspended is {
        tell command CarrierContext.CarrierRepository.PersistCarrierSuspended(carrierId = carrierSuspended.carrierId, reason = carrierSuspended.reason, suspendedAt = carrierSuspended.suspendedAt) to repository CarrierContext.CarrierRepository
        do "apply CarrierSuspended to the CarrierPerformance projection"
      }
      on credentialsVerifiedEvt: event Carrier.CredentialsVerified is {
        tell command CarrierContext.CarrierRepository.PersistCredentialsVerified(carrierId = credentialsVerifiedEvt.carrierId, verifiedBy = credentialsVerifiedEvt.verifiedBy, verifiedAt = credentialsVerifiedEvt.verifiedAt) to repository CarrierContext.CarrierRepository
        do "apply CredentialsVerified to the CarrierPerformance projection"
      }
      on insuranceAdded: event Carrier.InsuranceAdded is {
        tell command CarrierContext.CarrierRepository.PersistInsuranceAdded(carrierId = insuranceAdded.carrierId, policy = insuranceAdded.policy, addedAt = insuranceAdded.addedAt) to repository CarrierContext.CarrierRepository
        do "apply InsuranceAdded to the CarrierPerformance projection"
      }
      on insuranceUpdated: event Carrier.InsuranceUpdated is {
        tell command CarrierContext.CarrierRepository.PersistInsuranceUpdated(carrierId = insuranceUpdated.carrierId, policy = insuranceUpdated.policy, updatedAt = insuranceUpdated.updatedAt) to repository CarrierContext.CarrierRepository
        do "apply InsuranceUpdated to the CarrierPerformance projection"
      }
      on rateAdded: event Carrier.RateAdded is {
        tell command CarrierContext.CarrierRepository.PersistRateAdded(carrierId = rateAdded.carrierId, rate = rateAdded.rate, addedAt = rateAdded.addedAt) to repository CarrierContext.CarrierRepository
        do "apply RateAdded to the CarrierPerformance projection"
      }
      on rateUpdated: event Carrier.RateUpdated is {
        tell command CarrierContext.CarrierRepository.PersistRateUpdated(carrierId = rateUpdated.carrierId, rate = rateUpdated.rate, updatedAt = rateUpdated.updatedAt) to repository CarrierContext.CarrierRepository
        do "apply RateUpdated to the CarrierPerformance projection"
      }
      on serviceAreaDefined: event Carrier.ServiceAreaDefined is {
        tell command CarrierContext.CarrierRepository.PersistServiceAreaDefined(carrierId = serviceAreaDefined.carrierId, serviceArea = serviceAreaDefined.serviceArea, definedAt = serviceAreaDefined.definedAt) to repository CarrierContext.CarrierRepository
        do "apply ServiceAreaDefined to the CarrierPerformance projection"
      }
      on carrierRegistered: event Carrier.CarrierRegistered is {
        tell command CarrierContext.CarrierRepository.PersistCarrierRegistered(carrierId = carrierRegistered.carrierId, carrierInfo = carrierRegistered.carrierInfo, carrierType = carrierRegistered.carrierType, registeredAt = carrierRegistered.registeredAt) to repository CarrierContext.CarrierRepository
      }
      on carrierActivated: event Carrier.CarrierActivated is {
        tell command CarrierContext.CarrierRepository.PersistCarrierActivated(carrierId = carrierActivated.carrierId, activatedBy = carrierActivated.activatedBy, activatedAt = carrierActivated.activatedAt) to repository CarrierContext.CarrierRepository
      }
      on performanceRecorded: event Carrier.PerformanceRecorded is {
        tell command CarrierContext.CarrierRepository.PersistPerformanceRecorded(carrierId = performanceRecorded.carrierId, metrics = performanceRecorded.metrics, periodEnd = performanceRecorded.periodEnd, recordedAt = performanceRecorded.recordedAt) to repository CarrierContext.CarrierRepository
      }
      on carrierTerminated: event Carrier.CarrierTerminated is {
        tell command CarrierContext.CarrierRepository.PersistCarrierTerminated(carrierId = carrierTerminated.carrierId, reason = carrierTerminated.reason, terminatedAt = carrierTerminated.terminatedAt) to repository CarrierContext.CarrierRepository
      }
    } with {
      briefly "Maintains carrier rankings"
      described as {
        |Projects events into rankings.
      }
    }
  } with {
    briefly "Carrier performance analytics"
    described as {
      |Carrier performance tracking.
    }
  }
  type CarrierEvent is one of {
    CarrierContext.Carrier.CarrierRegistered or CarrierContext.Carrier.CarrierActivated or CarrierContext.Carrier.CarrierTerminated or CarrierContext.Carrier.CapacityUpdated or CarrierContext.Carrier.CarrierReinstated or CarrierContext.Carrier.CarrierSuspended or CarrierContext.Carrier.CredentialsVerified or CarrierContext.Carrier.InsuranceAdded or CarrierContext.Carrier.InsuranceUpdated or CarrierContext.Carrier.PerformanceRecorded or CarrierContext.Carrier.RateAdded or CarrierContext.Carrier.RateUpdated or CarrierContext.Carrier.ServiceAreaDefined
  } with {
    briefly "Carrier event union"
    described as {
      |Union of Carrier events for streaming.
    }
  }
  streamlet CarrierEventSplit as split is {
    outlet CarrierEventSplitToToSaferWeb is type CarrierEvent
    outlet CarrierEventSplitToToRateQuoting is type CarrierEvent
    outlet CarrierEventSplitToToLoadBoard is type CarrierEvent
    outlet CarrierEventSplitToToInsuranceVerification is type CarrierEvent
    inlet CarrierEventSplitIn is type CarrierEvent    outlet CarrierEventSplitToCarrierPerformance is type CarrierEvent
    handler CarrierEventSplitHandler is {
      on carrierRegistered: event Carrier.CarrierRegistered is {
        send carrierRegistered to outlet CarrierEventSplitToCarrierPerformance
        send carrierRegistered to outlet CarrierEventSplitToToSaferWeb
        tell carrierRegistered to entity CarrierContext.Carrier
      }
      on credentialsVerifiedEvent: event Carrier.CredentialsVerified is {
        send credentialsVerifiedEvent to outlet CarrierEventSplitToCarrierPerformance
        tell credentialsVerifiedEvent to entity CarrierContext.Carrier
      }
      on insuranceAdded: event Carrier.InsuranceAdded is {
        send insuranceAdded to outlet CarrierEventSplitToCarrierPerformance
        send insuranceAdded to outlet CarrierEventSplitToToInsuranceVerification
        tell insuranceAdded to entity CarrierContext.Carrier
      }
      on insuranceUpdated: event Carrier.InsuranceUpdated is {
        send insuranceUpdated to outlet CarrierEventSplitToCarrierPerformance
        tell insuranceUpdated to entity CarrierContext.Carrier
      }
      on serviceAreaDefined: event Carrier.ServiceAreaDefined is {
        send serviceAreaDefined to outlet CarrierEventSplitToCarrierPerformance
        tell serviceAreaDefined to entity CarrierContext.Carrier
      }
      on rateAdded: event Carrier.RateAdded is {
        send rateAdded to outlet CarrierEventSplitToCarrierPerformance
        tell rateAdded to entity CarrierContext.Carrier
      }
      on rateUpdated: event Carrier.RateUpdated is {
        send rateUpdated to outlet CarrierEventSplitToCarrierPerformance
        tell rateUpdated to entity CarrierContext.Carrier
      }
      on carrierActivated: event Carrier.CarrierActivated is {
        send carrierActivated to outlet CarrierEventSplitToCarrierPerformance
        send carrierActivated to outlet CarrierEventSplitToToRateQuoting
        tell carrierActivated to entity CarrierContext.Carrier
      }
      on carrierSuspended: event Carrier.CarrierSuspended is {
        send carrierSuspended to outlet CarrierEventSplitToCarrierPerformance
        tell carrierSuspended to entity CarrierContext.Carrier
      }
      on carrierReinstated: event Carrier.CarrierReinstated is {
        send carrierReinstated to outlet CarrierEventSplitToCarrierPerformance
        tell carrierReinstated to entity CarrierContext.Carrier
      }
      on performanceRecorded: event Carrier.PerformanceRecorded is {
        send performanceRecorded to outlet CarrierEventSplitToCarrierPerformance
        tell performanceRecorded to entity CarrierContext.Carrier
      }
      on capacityUpdated: event Carrier.CapacityUpdated is {
        send capacityUpdated to outlet CarrierEventSplitToCarrierPerformance
        send capacityUpdated to outlet CarrierEventSplitToToLoadBoard
        tell capacityUpdated to entity CarrierContext.Carrier
      }
      on carrierTerminated: event Carrier.CarrierTerminated is {
        send carrierTerminated to outlet CarrierEventSplitToCarrierPerformance
        tell carrierTerminated to entity CarrierContext.Carrier
      }
      on other is {
        error "Unexpected message for processor CarrierEventSplit"
      }
    } with {
      briefly "Carrier event fan-out handler"
      described as {
        |Delivers each Carrier event to all of its consumers.
      }
    }
  } with {
    briefly "Carrier event fan-out"
    described as {
      |Fans Carrier events out to the repository and projectors.
    }
  }
  connector 'ToSaferWeb Feed' is from outlet CarrierContext.CarrierEventSplit.CarrierEventSplitToToSaferWeb to inlet CarrierContext.ToSaferWeb.ToSaferWebIn with {
    briefly "The Carrier events ToSaferWeb translates, on their way to it"
  }
  connector 'ToRateQuoting Feed' is from outlet CarrierContext.CarrierEventSplit.CarrierEventSplitToToRateQuoting to inlet CarrierContext.ToRateQuoting.ToRateQuotingIn with {
    briefly "The Carrier events ToRateQuoting translates, on their way to it"
  }
  connector 'ToLoadBoard Feed' is from outlet CarrierContext.CarrierEventSplit.CarrierEventSplitToToLoadBoard to inlet CarrierContext.ToLoadBoard.ToLoadBoardIn with {
    briefly "The Carrier events ToLoadBoard translates, on their way to it"
  }
  connector 'ToInsuranceVerification Feed' is from outlet CarrierContext.CarrierEventSplit.CarrierEventSplitToToInsuranceVerification to inlet CarrierContext.ToInsuranceVerification.ToInsuranceVerificationIn with {
    briefly "The Carrier events ToInsuranceVerification translates, on their way to it"
  }
  connector 'CarrierEvent Stream' is from outlet CarrierContext.Carrier.CarrierEvents2 to inlet CarrierContext.CarrierEventSplit.CarrierEventSplitIn with {
    briefly "Carrier events, fanned out to storage and read models"
  }
  connector 'CarrierPerformance Feed' is from outlet CarrierContext.CarrierEventSplit.CarrierEventSplitToCarrierPerformance to inlet CarrierContext.CarrierPerformance.CarrierPerformanceFromCarrier with {
    briefly "Carrier events feeding the CarrierPerformance projection"
  }
  connector 'CarrierPerformance Storage' is from outlet CarrierContext.CarrierPerformance.CarrierPerformanceToRepository to inlet CarrierContext.CarrierRepository.CarrierRepositoryFromCarrierPerformance with {
    briefly "CarrierPerformance updates on their way to storage"
  }
} with {
  briefly "Bounded context for carrier management"
  described as {
    |Freight carrier management context.
  }
}
