// Carrier Management - Carrier Context
context CarrierContext is {
  adaptor FromInsuranceVerification from context InsuranceVerification is { 
    handler FromInsuranceVerificationHandler is {
      on event InsuranceVerification.InsuranceVerified is {
        do "the model receives insurance verified"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceVerification"
      }
    } with {
      briefly "from insurance verification"
      described as {
        |Carries messages from the external InsuranceVerification.
      }
    }
  } with {
    briefly "InsuranceVerification integration"
    described as {
      |The model's side of the InsuranceVerification conversation.
    }
  }
  adaptor ToInsuranceVerification to context InsuranceVerification is { 
    handler ToInsuranceVerificationHandler is {
      on command InsuranceVerification.VerifyInsuranceCoverage is {
        do "the model sends verify insurance coverage"
      }
      on other is {
        error "Unexpected message for adaptor ToInsuranceVerification"
      }
    } with {
      briefly "to insurance verification"
      described as {
        |Carries messages to the external InsuranceVerification.
      }
    }
  } with {
    briefly "InsuranceVerification integration"
    described as {
      |The model's side of the InsuranceVerification conversation.
    }
  }
  adaptor FromLoadBoard from context LoadBoard is { 
    handler FromLoadBoardHandler is {
      on event LoadBoard.CarrierBidReceived is {
        do "the model receives carrier bid received"
      }
      on event LoadBoard.LoadPosted is {
        do "the model receives load posted"
      }
      on other is {
        error "Unexpected message for adaptor FromLoadBoard"
      }
    } with {
      briefly "from load board"
      described as {
        |Carries messages from the external LoadBoard.
      }
    }
  } with {
    briefly "LoadBoard integration"
    described as {
      |The model's side of the LoadBoard conversation.
    }
  }
  adaptor ToLoadBoard to context LoadBoard is { 
    handler ToLoadBoardHandler is {
      on command LoadBoard.PostLoad is {
        do "the model sends post load"
      }
      on other is {
        error "Unexpected message for adaptor ToLoadBoard"
      }
    } with {
      briefly "to load board"
      described as {
        |Carries messages to the external LoadBoard.
      }
    }
  } with {
    briefly "LoadBoard integration"
    described as {
      |The model's side of the LoadBoard conversation.
    }
  }
  adaptor FromRateQuoting from context RateQuoting is { 
    handler FromRateQuotingHandler is {
      on event RateQuoting.QuoteReceived is {
        do "the model receives quote received"
      }
      on other is {
        error "Unexpected message for adaptor FromRateQuoting"
      }
    } with {
      briefly "from rate quoting"
      described as {
        |Carries messages from the external RateQuoting.
      }
    }
  } with {
    briefly "RateQuoting integration"
    described as {
      |The model's side of the RateQuoting conversation.
    }
  }
  adaptor ToRateQuoting to context RateQuoting is { 
    handler ToRateQuotingHandler is {
      on command RateQuoting.GetCarrierQuote is {
        do "the model sends get carrier quote"
      }
      on other is {
        error "Unexpected message for adaptor ToRateQuoting"
      }
    } with {
      briefly "to rate quoting"
      described as {
        |Carries messages to the external RateQuoting.
      }
    }
  } with {
    briefly "RateQuoting integration"
    described as {
      |The model's side of the RateQuoting conversation.
    }
  }
  adaptor FromSaferWeb from context SaferWeb is { 
    handler FromSaferWebHandler is {
      on event SaferWeb.DOTVerified is {
        do "the model receives dot verified"
      }
      on event SaferWeb.SafetyRecordRetrieved is {
        do "the model receives safety record retrieved"
      }
      on other is {
        error "Unexpected message for adaptor FromSaferWeb"
      }
    } with {
      briefly "from safer web"
      described as {
        |Carries messages from the external SaferWeb.
      }
    }
  } with {
    briefly "SaferWeb integration"
    described as {
      |The model's side of the SaferWeb conversation.
    }
  }
  adaptor ToSaferWeb to context SaferWeb is { 
    handler ToSaferWebHandler is {
      on command SaferWeb.CheckSafetyRecord is {
        do "the model sends check safety record"
      }
      on command SaferWeb.VerifyDOTNumber is {
        do "the model sends verify dot number"
      }
      on other is {
        error "Unexpected message for adaptor ToSaferWeb"
      }
    } with {
      briefly "to safer web"
      described as {
        |Carries messages to the external SaferWeb.
      }
    }
  } with {
    briefly "SaferWeb integration"
    described as {
      |The model's side of the SaferWeb conversation.
    }
  }
  include "types.riddl"
  include "Carrier.riddl"
  repository CarrierRepository as merge is {
    inlet CarrierRepositoryFromCarrier is type CarrierEvent    inlet CarrierRepositoryFromCarrierPerformance is type CarrierEvent    outlet CarrierRepositoryResponses is type Carrier.CarrierResult
    record StoredCarrier is  {
      carrierId: CarrierId with {
        briefly "carrierId"
        described as {
          |The carrierId column of the stored carrier row.
        }
      }
      carrierInfo: CarrierInfo with {
        briefly "carrierInfo"
        described as {
          |The carrierInfo column of the stored carrier row.
        }
      }
      carrierType: CarrierType with {
        briefly "carrierType"
        described as {
          |The carrierType column of the stored carrier row.
        }
      }
      status: CarrierStatus with {
        briefly "status"
        described as {
          |The status column of the stored carrier row.
        }
      }
    } with {
      briefly "Stored carrier row"
      described as {
        |The persistence shape of carrier data as this repository stores it.
      }
    }
    schema CarrierData is relational
      of carriers as type StoredCarrier
        index on field StoredCarrier.carrierInfo.dotNumber
        index on field StoredCarrier.carrierInfo.scac
        index on field StoredCarrier.status
        index on field StoredCarrier.carrierType
 with {
      briefly "Carrier data schema"
      described as {
        |The relational schema holding carrier data for the CarrierRepository.
      }
    }
    handler CarrierPersistence is {
      on query GetCarrierRankings is {
        let carrierRankingsView: type CarrierRankingsView = prompt("read the carrier rankings projection")
        reply carrierRankingsView
      }
      on registerCarrier: command Carrier.RegisterCarrier is {
        tell event Carrier.CarrierRegistered(carrierId = registerCarrier.carrierId, carrierInfo = registerCarrier.carrierInfo, carrierType = registerCarrier.carrierType) to entity CarrierContext.Carrier
      }
      on verifyCredentials: command Carrier.VerifyCredentials is {
        tell event Carrier.CredentialsVerified(carrierId = verifyCredentials.carrierId, verifiedBy = verifyCredentials.verifiedBy) to entity CarrierContext.Carrier
      }
      on addInsurance: command Carrier.AddInsurance is {
        tell event Carrier.InsuranceAdded(carrierId = addInsurance.carrierId, policy = addInsurance.policy) to entity CarrierContext.Carrier
      }
      on updateInsurance: command Carrier.UpdateInsurance is {
        tell event Carrier.InsuranceUpdated(carrierId = updateInsurance.carrierId, policy = updateInsurance.policy) to entity CarrierContext.Carrier
      }
      on defineServiceArea: command Carrier.DefineServiceArea is {
        tell event Carrier.ServiceAreaDefined(carrierId = defineServiceArea.carrierId, serviceArea = defineServiceArea.serviceArea) to entity CarrierContext.Carrier
      }
      on addRate: command Carrier.AddRate is {
        tell event Carrier.RateAdded(carrierId = addRate.carrierId, rate = addRate.rate) to entity CarrierContext.Carrier
      }
      on activateCarrier: command Carrier.ActivateCarrier is {
        tell event Carrier.CarrierActivated(carrierId = activateCarrier.carrierId, activatedBy = activateCarrier.activatedBy) to entity CarrierContext.Carrier
      }
      on suspendCarrier: command Carrier.SuspendCarrier is {
        tell event Carrier.CarrierSuspended(carrierId = suspendCarrier.carrierId, reason = suspendCarrier.reason) to entity CarrierContext.Carrier
      }
      on recordPerformance: command Carrier.RecordPerformance is {
        tell event Carrier.PerformanceRecorded(carrierId = recordPerformance.carrierId, metrics = recordPerformance.metrics, periodEnd = recordPerformance.periodEnd) to entity CarrierContext.Carrier
      }
      on terminateCarrier: command Carrier.TerminateCarrier is {
        tell event Carrier.CarrierTerminated(carrierId = terminateCarrier.carrierId, reason = terminateCarrier.reason) to entity CarrierContext.Carrier
      }
    } with {
      briefly "Persists carrier commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Carrier data persistence"
    described as {
      |Persistent storage for carriers.
    }
  }
  query GetCarrierRankings is  {
    carrierRankingsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which carrier rankings to retrieve.
      }
    }
  } with {
    briefly "Get carrier rankings"
    described as {
      |Retrieves the carrier rankings projection.
    }
  }
  result CarrierRankingsView is  {
    carrierRankings: CarrierPerformance.CarrierRankings with {
      briefly "Carrier rankings"
      described as {
        |The carrier rankings being returned.
      }
    }
  } with {
    briefly "Carrier rankings view"
    described as {
      |Read model view carrying the carrier rankings projection.
    }
  }
  projector CarrierPerformance as flow is {
    updates repository CarrierContext.CarrierRepository
    inlet CarrierPerformanceFromCarrier is type CarrierEvent    outlet CarrierPerformanceOut is type CarrierEvent
    record CarrierRankings is  {
      totalCarriers: Natural with {
        briefly "Total"
        described as {
          |Total carriers.
        }
      }
      activeCarriers: Natural with {
        briefly "Active"
        described as {
          |Active carriers.
        }
      }
      topPerformers: String(1,200)+ with {
        briefly "Top"
        described as {
          |Top carriers.
        }
      }
      averageOnTimeRate: Decimal(5,2) with {
        briefly "On-time"
        described as {
          |Avg on-time rate.
        }
      }
      averageClaimsRatio: Decimal(5,4) with {
        briefly "Claims"
        described as {
          |Avg claims ratio.
        }
      }
    } with {
      briefly "Carrier rankings"
      described as {
        |Carrier performance rankings.
      }
    }
    handler PerformanceHandler is {
      on carrierRegistered: event Carrier.CarrierRegistered is {
        tell carrierRegistered to repository CarrierContext.CarrierRepository
      }
      on carrierActivated: event Carrier.CarrierActivated is {
        tell carrierActivated to repository CarrierContext.CarrierRepository
      }
      on performanceRecorded: event Carrier.PerformanceRecorded is {
        tell performanceRecorded to repository CarrierContext.CarrierRepository
      }
      on carrierTerminated: event Carrier.CarrierTerminated is {
        tell carrierTerminated to repository CarrierContext.CarrierRepository
      }
    } with {
      briefly "Maintains carrier rankings"
      described as {
        |Projects events into rankings.
      }
    }
  } with {
    briefly "Carrier performance analytics"
    described as {
      |Carrier performance tracking.
    }
  }
  type CarrierEvent is one of {
    CarrierContext.Carrier.CarrierRegistered or CarrierContext.Carrier.CarrierActivated or CarrierContext.Carrier.CarrierTerminated
  } with {
    briefly "Carrier event union"
    described as {
      |Union of Carrier events for streaming.
    }
  }
  processor CarrierEventSource as source is {
    outlet CarrierEvents is type CarrierEvent
    handler CarrierEventEmitter is {
      on init is {
        let initializeCarrier: type Carrier.InitializeCarrier = prompt("the initialize carrier that brings this this into existence")
        tell initializeCarrier to entity CarrierContext.Carrier
      }
      on other is {
        error "Unexpected message for source CarrierEventSource"
      }
      on carrierRegistered: event Carrier.CarrierRegistered is {
        send carrierRegistered to outlet CarrierEvents
      }
      on carrierActivated: event Carrier.CarrierActivated is {
        send carrierActivated to outlet CarrierEvents
      }
      on carrierTerminated: event Carrier.CarrierTerminated is {
        send carrierTerminated to outlet CarrierEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits Carrier events to the stream.
      }
    }
  } with {
    briefly "Carrier event source"
    described as {
      |Publishes Carrier events to the event stream.
    }
  }
  processor CarrierEventSink as sink is {
    inlet IncomingCarrierEvents is type CarrierEvent    handler CarrierEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink CarrierEventSink"
      }
      on carrierRegistered: event Carrier.CarrierRegistered is {
        tell carrierRegistered to repository CarrierContext.CarrierRepository
      }
      on carrierActivated: event Carrier.CarrierActivated is {
        tell carrierActivated to repository CarrierContext.CarrierRepository
      }
      on carrierTerminated: event Carrier.CarrierTerminated is {
        tell carrierTerminated to repository CarrierContext.CarrierRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives Carrier events for persistence.
      }
    }
  } with {
    briefly "Carrier event sink"
    described as {
      |Receives Carrier events from streaming.
    }
  }
  connector CarrierEventPipeline is from outlet CarrierContext.CarrierEventSource.CarrierEvents to inlet CarrierContext.CarrierEventSink.IncomingCarrierEvents with {
    briefly "Carrier event pipeline"
    described as {
      |Wires Carrier event source to sink.
    }
  }
  processor CarrierEventSplit as split is {
    inlet CarrierEventSplitIn is type CarrierEvent    outlet CarrierEventSplitToCarrierRepository is type CarrierEvent
    outlet CarrierEventSplitToCarrierPerformance is type CarrierEvent
    handler CarrierEventSplitHandler is {
      on carrierRegistered: event Carrier.CarrierRegistered is {
        send carrierRegistered to outlet CarrierEventSplitToCarrierRepository
        send carrierRegistered to outlet CarrierEventSplitToCarrierPerformance
        tell carrierRegistered to entity CarrierContext.Carrier
      }
      on credentialsVerifiedEvent: event Carrier.CredentialsVerified is {
        send credentialsVerifiedEvent to outlet CarrierEventSplitToCarrierRepository
        send credentialsVerifiedEvent to outlet CarrierEventSplitToCarrierPerformance
        tell credentialsVerifiedEvent to entity CarrierContext.Carrier
      }
      on insuranceAdded: event Carrier.InsuranceAdded is {
        send insuranceAdded to outlet CarrierEventSplitToCarrierRepository
        send insuranceAdded to outlet CarrierEventSplitToCarrierPerformance
        tell insuranceAdded to entity CarrierContext.Carrier
      }
      on insuranceUpdated: event Carrier.InsuranceUpdated is {
        send insuranceUpdated to outlet CarrierEventSplitToCarrierRepository
        send insuranceUpdated to outlet CarrierEventSplitToCarrierPerformance
        tell insuranceUpdated to entity CarrierContext.Carrier
      }
      on serviceAreaDefined: event Carrier.ServiceAreaDefined is {
        send serviceAreaDefined to outlet CarrierEventSplitToCarrierRepository
        send serviceAreaDefined to outlet CarrierEventSplitToCarrierPerformance
        tell serviceAreaDefined to entity CarrierContext.Carrier
      }
      on rateAdded: event Carrier.RateAdded is {
        send rateAdded to outlet CarrierEventSplitToCarrierRepository
        send rateAdded to outlet CarrierEventSplitToCarrierPerformance
        tell rateAdded to entity CarrierContext.Carrier
      }
      on rateUpdated: event Carrier.RateUpdated is {
        send rateUpdated to outlet CarrierEventSplitToCarrierRepository
        send rateUpdated to outlet CarrierEventSplitToCarrierPerformance
        tell rateUpdated to entity CarrierContext.Carrier
      }
      on carrierActivated: event Carrier.CarrierActivated is {
        send carrierActivated to outlet CarrierEventSplitToCarrierRepository
        send carrierActivated to outlet CarrierEventSplitToCarrierPerformance
        tell carrierActivated to entity CarrierContext.Carrier
      }
      on carrierSuspended: event Carrier.CarrierSuspended is {
        send carrierSuspended to outlet CarrierEventSplitToCarrierRepository
        send carrierSuspended to outlet CarrierEventSplitToCarrierPerformance
        tell carrierSuspended to entity CarrierContext.Carrier
      }
      on carrierReinstated: event Carrier.CarrierReinstated is {
        send carrierReinstated to outlet CarrierEventSplitToCarrierRepository
        send carrierReinstated to outlet CarrierEventSplitToCarrierPerformance
        tell carrierReinstated to entity CarrierContext.Carrier
      }
      on performanceRecorded: event Carrier.PerformanceRecorded is {
        send performanceRecorded to outlet CarrierEventSplitToCarrierRepository
        send performanceRecorded to outlet CarrierEventSplitToCarrierPerformance
        tell performanceRecorded to entity CarrierContext.Carrier
      }
      on capacityUpdated: event Carrier.CapacityUpdated is {
        send capacityUpdated to outlet CarrierEventSplitToCarrierRepository
        send capacityUpdated to outlet CarrierEventSplitToCarrierPerformance
        tell capacityUpdated to entity CarrierContext.Carrier
      }
      on carrierTerminated: event Carrier.CarrierTerminated is {
        send carrierTerminated to outlet CarrierEventSplitToCarrierRepository
        send carrierTerminated to outlet CarrierEventSplitToCarrierPerformance
        tell carrierTerminated to entity CarrierContext.Carrier
      }
      on other is {
        error "Unexpected message for processor CarrierEventSplit"
      }
    } with {
      briefly "Carrier event fan-out handler"
      described as {
        |Delivers each Carrier event to all of its consumers.
      }
    }
  } with {
    briefly "Carrier event fan-out"
    described as {
      |Fans Carrier events out to the repository and projectors.
    }
  }
  connector 'CarrierEvent Stream' is from outlet CarrierContext.Carrier.CarrierEvents2 to inlet CarrierContext.CarrierEventSplit.CarrierEventSplitIn with {
    briefly "Carrier events, fanned out to storage and read models"
  }
  connector 'CarrierEvent Storage' is from outlet CarrierContext.CarrierEventSplit.CarrierEventSplitToCarrierRepository to inlet CarrierContext.CarrierRepository.CarrierRepositoryFromCarrier with {
    briefly "Carrier events on their way to storage"
  }
  connector 'CarrierPerformance Feed' is from outlet CarrierContext.CarrierEventSplit.CarrierEventSplitToCarrierPerformance to inlet CarrierContext.CarrierPerformance.CarrierPerformanceFromCarrier with {
    briefly "Carrier events feeding the CarrierPerformance projection"
  }
  connector 'CarrierPerformance Storage' is from outlet CarrierContext.CarrierPerformance.CarrierPerformanceOut to inlet CarrierContext.CarrierRepository.CarrierRepositoryFromCarrierPerformance with {
    briefly "The CarrierPerformance projection on its way to storage"
  }
} with {
  briefly "Bounded context for carrier management"
  described as {
    |Freight carrier management context.
  }
}
