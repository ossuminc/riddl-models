// Carrier Management Domain Model
// Freight carrier onboarding and performance management
domain CarrierManagement is {
  persistent connector 'InsuranceVerificationEvent Stream' is from outlet InsuranceVerification.InsuranceVerificationEventsOut to inlet CarrierContext.FromInsuranceVerification.FromInsuranceVerificationIn with {
    briefly "What InsuranceVerification tells CarrierContext, unasked"
  }
  persistent connector 'LoadBoardEvent Stream' is from outlet LoadBoard.LoadBoardEventsOut to inlet CarrierContext.FromLoadBoard.FromLoadBoardIn with {
    briefly "What LoadBoard tells CarrierContext, unasked"
  }
  persistent connector 'RateQuotingEvent Stream' is from outlet RateQuoting.RateQuotingEventsOut to inlet CarrierContext.FromRateQuoting.FromRateQuotingIn with {
    briefly "What RateQuoting tells CarrierContext, unasked"
  }
  persistent connector 'SaferWebEvent Stream' is from outlet SaferWeb.SaferWebEventsOut to inlet CarrierContext.FromSaferWeb.FromSaferWebIn with {
    briefly "What SaferWeb tells CarrierContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user CarrierManager is "person managing carrier relationships" with {
    briefly "Carrier Manager"
    described as {
      |Manages carrier contracts and performance.
    }
  }
  user Shipper is "person selecting carriers for shipments" with {
    briefly "Shipper"
    described as {
      |Selects carriers for freight.
    }
  }
  user CarrierRep is "person representing a carrier company" with {
    briefly "Carrier Rep"
    described as {
      |Carrier company representative.
    }
  }
  epic CarrierOnboarding is {
    user CarrierManager wants to "to onboard qualified carriers" so that "shipping capacity is available"
    case OnboardCarrier is {
      user CarrierManager wants to "to register new carriers" so that "they can be used for shipments"
      step is "Manager validates" "carrier credentials" "and insurance" with {
        briefly "Validate carrier"
        described as {
          |Check credentials.
        }
      }
      step is "System activates" "carrier account" "for assignments" with {
        briefly "Activate carrier"
        described as {
          |Enable carrier.
        }
      }
    } with {
      briefly "Onboard carrier"
      described as {
        |New carrier registration.
      }
    }
  } with {
    briefly "Carrier onboarding"
    described as {
      |Epic for carrier management.
    }
  }
  include "CarrierContext.riddl"
  include "external-contexts.riddl"
  application context CarrierManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CarrierManagement are delivered.
      }
    }
    outlet AppCarrierCommands is type CarrierContext.Carrier.CarrierCommand
    inlet AppCarrierRepositoryResponses is result CarrierContext.Carrier.CarrierResult    handler CarrierManagementAppHandler is {
      on other is {
        error "Unexpected message for application context CarrierManagementApp"
      }
    } with {
      briefly "CarrierManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CarrierManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'LoadBoardRequest Stream' is from outlet CarrierContext.ToLoadBoard.ToLoadBoardOut to inlet LoadBoard.LoadBoardRequests with {
    briefly "What CarrierContext asks LoadBoard to send"
  }
  persistent connector 'RateQuotingRequest Stream' is from outlet CarrierContext.ToRateQuoting.ToRateQuotingOut to inlet RateQuoting.RateQuotingRequests with {
    briefly "What CarrierContext asks RateQuoting to send"
  }
  persistent connector 'SaferWebRequest Stream' is from outlet CarrierContext.ToSaferWeb.ToSaferWebOut to inlet SaferWeb.SaferWebRequests with {
    briefly "What CarrierContext asks SaferWeb to send"
  }
  persistent connector 'InsuranceVerificationRequest Stream' is from outlet CarrierContext.ToInsuranceVerification.ToInsuranceVerificationOut to inlet InsuranceVerification.InsuranceVerificationRequests with {
    briefly "What CarrierContext asks InsuranceVerification to send"
  }
  persistent connector 'CarrierCommand Stream' is from outlet CarrierManagementApp.AppCarrierCommands to inlet CarrierContext.CarrierCommandStreamIn with {
    briefly "Carrier commands from the application"
  }
  persistent connector 'CarrierResult Stream' is from outlet CarrierContext.CarrierResultStreamOut to inlet CarrierManagementApp.AppCarrierRepositoryResponses with {
    briefly "Carrier query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CarrierManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Carrier management domain"
  described as {
    |Freight carrier onboarding and performance.
  }
}
