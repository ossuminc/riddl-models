// Last Mile Delivery - Delivery Context
context DeliveryContext is {
  adaptor FromCustomerNotification from context CustomerNotification is { 
    handler FromCustomerNotificationHandler is {
      on event CustomerNotification.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerNotification"
      }
    } with {
      briefly "from customer notification"
      described as {
        |Carries messages from the external CustomerNotification.
      }
    }
  } with {
    briefly "CustomerNotification integration"
    described as {
      |The model's side of the CustomerNotification conversation.
    }
  }
  adaptor ToCustomerNotification to context CustomerNotification is { 
    handler ToCustomerNotificationHandler is {
      on command CustomerNotification.SendDeliveryNotification is {
        do "the model sends send delivery notification"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerNotification"
      }
    } with {
      briefly "to customer notification"
      described as {
        |Carries messages to the external CustomerNotification.
      }
    }
  } with {
    briefly "CustomerNotification integration"
    described as {
      |The model's side of the CustomerNotification conversation.
    }
  }
  adaptor FromDriverMobile from context DriverMobile is { 
    handler FromDriverMobileHandler is {
      on event DriverMobile.DriverLocationUpdated is {
        do "the model receives driver location updated"
      }
      on event DriverMobile.RouteReceived is {
        do "the model receives route received"
      }
      on other is {
        error "Unexpected message for adaptor FromDriverMobile"
      }
    } with {
      briefly "from driver mobile"
      described as {
        |Carries messages from the external DriverMobile.
      }
    }
  } with {
    briefly "DriverMobile integration"
    described as {
      |The model's side of the DriverMobile conversation.
    }
  }
  adaptor ToDriverMobile to context DriverMobile is { 
    handler ToDriverMobileHandler is {
      on command DriverMobile.SendRouteToDriver is {
        do "the model sends send route to driver"
      }
      on other is {
        error "Unexpected message for adaptor ToDriverMobile"
      }
    } with {
      briefly "to driver mobile"
      described as {
        |Carries messages to the external DriverMobile.
      }
    }
  } with {
    briefly "DriverMobile integration"
    described as {
      |The model's side of the DriverMobile conversation.
    }
  }
  adaptor FromGeocodingService from context GeocodingService is { 
    handler FromGeocodingServiceHandler is {
      on event GeocodingService.AddressGeocoded is {
        do "the model receives address geocoded"
      }
      on event GeocodingService.LocationResolved is {
        do "the model receives location resolved"
      }
      on other is {
        error "Unexpected message for adaptor FromGeocodingService"
      }
    } with {
      briefly "from geocoding service"
      described as {
        |Carries messages from the external GeocodingService.
      }
    }
  } with {
    briefly "GeocodingService integration"
    described as {
      |The model's side of the GeocodingService conversation.
    }
  }
  adaptor ToGeocodingService to context GeocodingService is { 
    handler ToGeocodingServiceHandler is {
      on command GeocodingService.GeocodeAddress is {
        do "the model sends geocode address"
      }
      on command GeocodingService.ReverseGeocode is {
        do "the model sends reverse geocode"
      }
      on other is {
        error "Unexpected message for adaptor ToGeocodingService"
      }
    } with {
      briefly "to geocoding service"
      described as {
        |Carries messages to the external GeocodingService.
      }
    }
  } with {
    briefly "GeocodingService integration"
    described as {
      |The model's side of the GeocodingService conversation.
    }
  }
  adaptor FromProofCapture from context ProofCapture is { 
    handler FromProofCaptureHandler is {
      on event ProofCapture.PhotoCaptured is {
        do "the model receives photo captured"
      }
      on event ProofCapture.SignatureCaptured is {
        do "the model receives signature captured"
      }
      on other is {
        error "Unexpected message for adaptor FromProofCapture"
      }
    } with {
      briefly "from proof capture"
      described as {
        |Carries messages from the external ProofCapture.
      }
    }
  } with {
    briefly "ProofCapture integration"
    described as {
      |The model's side of the ProofCapture conversation.
    }
  }
  adaptor ToProofCapture to context ProofCapture is { 
    handler ToProofCaptureHandler is {
      on command ProofCapture.CapturePhoto is {
        do "the model sends capture photo"
      }
      on command ProofCapture.CaptureSignature is {
        do "the model sends capture signature"
      }
      on other is {
        error "Unexpected message for adaptor ToProofCapture"
      }
    } with {
      briefly "to proof capture"
      described as {
        |Carries messages to the external ProofCapture.
      }
    }
  } with {
    briefly "ProofCapture integration"
    described as {
      |The model's side of the ProofCapture conversation.
    }
  }
  adaptor FromRouteOptimization from context RouteOptimization is { 
    handler FromRouteOptimizationHandler is {
      on event RouteOptimization.ETAsRecalculated is {
        do "the model receives et as recalculated"
      }
      on event RouteOptimization.RouteOptimized is {
        do "the model receives route optimized"
      }
      on other is {
        error "Unexpected message for adaptor FromRouteOptimization"
      }
    } with {
      briefly "from route optimization"
      described as {
        |Carries messages from the external RouteOptimization.
      }
    }
  } with {
    briefly "RouteOptimization integration"
    described as {
      |The model's side of the RouteOptimization conversation.
    }
  }
  adaptor ToRouteOptimization to context RouteOptimization is { 
    handler ToRouteOptimizationHandler is {
      on command RouteOptimization.OptimizeRoute is {
        do "the model sends optimize route"
      }
      on command RouteOptimization.RecalculateETA is {
        do "the model sends recalculate eta"
      }
      on other is {
        error "Unexpected message for adaptor ToRouteOptimization"
      }
    } with {
      briefly "to route optimization"
      described as {
        |Carries messages to the external RouteOptimization.
      }
    }
  } with {
    briefly "RouteOptimization integration"
    described as {
      |The model's side of the RouteOptimization conversation.
    }
  }
  include "types.riddl"
  include "Delivery.riddl"
  repository DeliveryRepository as merge is {
    inlet DeliveryRepositoryFromDelivery is type DeliveryEvent    inlet DeliveryRepositoryFromDeliveryAnalytics is type DeliveryEvent    outlet DeliveryRepositoryResponses is type Delivery.DeliveryResult
    record StoredDelivery is  {
      deliveryId: DeliveryId with {
        briefly "deliveryId"
        described as {
          |The deliveryId column of the stored delivery row.
        }
      }
      address: Address with {
        briefly "address"
        described as {
          |The address column of the stored delivery row.
        }
      }
      packageInfo: PackageInfo with {
        briefly "packageInfo"
        described as {
          |The packageInfo column of the stored delivery row.
        }
      }
      routeId: RouteId with {
        briefly "routeId"
        described as {
          |The routeId column of the stored delivery row.
        }
      }
      status: DeliveryStatus with {
        briefly "status"
        described as {
          |The status column of the stored delivery row.
        }
      }
    } with {
      briefly "Stored delivery row"
      described as {
        |The persistence shape of delivery data as this repository stores it.
      }
    }
    schema DeliveryData is relational
      of deliveries as type StoredDelivery
        index on field StoredDelivery.packageInfo.trackingNumber
        index on field StoredDelivery.status
        index on field StoredDelivery.routeId
        index on field StoredDelivery.address.postalCode
 with {
      briefly "Delivery data schema"
      described as {
        |The relational schema holding delivery data for the DeliveryRepository.
      }
    }
    handler DeliveryPersistence is {
      on query GetDailyMetrics is {
        let dailyMetricsView: type DailyMetricsView = prompt("read the daily metrics projection")
        reply dailyMetricsView
      }
      on createDelivery: command Delivery.CreateDelivery is {
        tell event Delivery.DeliveryCreated(deliveryId = createDelivery.deliveryId, packageInfo = createDelivery.packageInfo, address = createDelivery.address, priority = createDelivery.priority) to entity DeliveryContext.Delivery
      }
      on assignToRoute: command Delivery.AssignToRoute is {
        tell event Delivery.AssignedToRoute(deliveryId = assignToRoute.deliveryId, routeId = assignToRoute.routeId, driver = assignToRoute.driver, stopNumber = assignToRoute.stopNumber, estimatedArrival = assignToRoute.estimatedArrival) to entity DeliveryContext.Delivery
      }
      on markOutForDelivery: command Delivery.MarkOutForDelivery is {
        tell event Delivery.MarkedOutForDelivery(deliveryId = markOutForDelivery.deliveryId, departedAt = markOutForDelivery.departedAt) to entity DeliveryContext.Delivery
      }
      on updateETA: command Delivery.UpdateETA is {
        tell event Delivery.ETAUpdated(deliveryId = updateETA.deliveryId, newETA = updateETA.newETA) to entity DeliveryContext.Delivery
      }
      on attemptDelivery: command Delivery.AttemptDelivery is {
        tell event Delivery.DeliveryAttempted(deliveryId = attemptDelivery.deliveryId, attempt = attemptDelivery.attempt) to entity DeliveryContext.Delivery
      }
      on completeDelivery: command Delivery.CompleteDelivery is {
        tell event Delivery.DeliveryCompleted(deliveryId = completeDelivery.deliveryId, proof = completeDelivery.proof) to entity DeliveryContext.Delivery
      }
      on failDelivery: command Delivery.FailDelivery is {
        tell event Delivery.DeliveryFailed(deliveryId = failDelivery.deliveryId, reason = failDelivery.reason, action = failDelivery.action) to entity DeliveryContext.Delivery
      }
      on rescheduleDelivery: command Delivery.RescheduleDelivery is {
        tell event Delivery.DeliveryRescheduled(deliveryId = rescheduleDelivery.deliveryId, newWindow = rescheduleDelivery.newWindow) to entity DeliveryContext.Delivery
      }
    } with {
      briefly "Persists delivery commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Delivery data persistence"
    described as {
      |Persistent storage for deliveries.
    }
  }
  query GetDailyMetrics is  {
    dailyMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily metrics to retrieve.
      }
    }
  } with {
    briefly "Get daily metrics"
    described as {
      |Retrieves the daily metrics projection.
    }
  }
  result DailyMetricsView is  {
    dailyMetrics: DeliveryAnalytics.DailyMetrics with {
      briefly "Daily metrics"
      described as {
        |The daily metrics being returned.
      }
    }
  } with {
    briefly "Daily metrics view"
    described as {
      |Read model view carrying the daily metrics projection.
    }
  }
  projector DeliveryAnalytics as flow is {
    updates repository DeliveryContext.DeliveryRepository
    inlet DeliveryAnalyticsFromDelivery is type DeliveryEvent    outlet DeliveryAnalyticsOut is type DeliveryEvent
    record DailyMetrics is  {
      totalDeliveries: Natural with {
        briefly "Total"
        described as {
          |Total deliveries.
        }
      }
      completed: Natural with {
        briefly "Completed"
        described as {
          |Completed.
        }
      }
      failed: Natural with {
        briefly "Failed"
        described as {
          |Failed.
        }
      }
      onTimeRate: Decimal(5,2) with {
        briefly "On-time"
        described as {
          |On-time rate.
        }
      }
      averageAttemptsPerDelivery: Decimal(3,2) with {
        briefly "Attempts"
        described as {
          |Avg attempts.
        }
      }
      firstAttemptSuccessRate: Decimal(5,2) with {
        briefly "First attempt"
        described as {
          |First attempt success.
        }
      }
    } with {
      briefly "Daily metrics"
      described as {
        |Daily delivery metrics.
      }
    }
    handler AnalyticsHandler is {
      on deliveryCreated: event Delivery.DeliveryCreated is {
        tell deliveryCreated to repository DeliveryContext.DeliveryRepository
      }
      on deliveryCompleted: event Delivery.DeliveryCompleted is {
        tell deliveryCompleted to repository DeliveryContext.DeliveryRepository
      }
      on deliveryFailed: event Delivery.DeliveryFailed is {
        tell deliveryFailed to repository DeliveryContext.DeliveryRepository
      }
      on deliveryAttempted: event Delivery.DeliveryAttempted is {
        tell deliveryAttempted to repository DeliveryContext.DeliveryRepository
      }
    } with {
      briefly "Maintains delivery analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Delivery analytics"
    described as {
      |Delivery performance tracking.
    }
  }
  type DeliveryEvent is one of {
    DeliveryContext.Delivery.DeliveryCreated or DeliveryContext.Delivery.DeliveryCompleted or DeliveryContext.Delivery.DeliveryFailed
  } with {
    briefly "Delivery event union"
    described as {
      |Union of Delivery events for streaming.
    }
  }
  processor DeliveryEventSource as source is {
    outlet DeliveryEvents is type DeliveryEvent
    handler DeliveryEventEmitter is {
      on init is {
        tell command Delivery.InitializeDelivery to entity DeliveryContext.Delivery
      }
      on other is {
        error "Unexpected message for source DeliveryEventSource"
      }
      on deliveryCreated: event Delivery.DeliveryCreated is {
        send deliveryCreated to outlet DeliveryEvents
      }
      on deliveryCompleted: event Delivery.DeliveryCompleted is {
        send deliveryCompleted to outlet DeliveryEvents
      }
      on deliveryFailed: event Delivery.DeliveryFailed is {
        send deliveryFailed to outlet DeliveryEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits Delivery events to the stream.
      }
    }
  } with {
    briefly "Delivery event source"
    described as {
      |Publishes Delivery events to the event stream.
    }
  }
  processor DeliveryEventSink as sink is {
    inlet IncomingDeliveryEvents is type DeliveryEvent    handler DeliveryEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink DeliveryEventSink"
      }
      on deliveryCreated: event Delivery.DeliveryCreated is {
        tell deliveryCreated to repository DeliveryContext.DeliveryRepository
      }
      on deliveryCompleted: event Delivery.DeliveryCompleted is {
        tell deliveryCompleted to repository DeliveryContext.DeliveryRepository
      }
      on deliveryFailed: event Delivery.DeliveryFailed is {
        tell deliveryFailed to repository DeliveryContext.DeliveryRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives Delivery events for persistence.
      }
    }
  } with {
    briefly "Delivery event sink"
    described as {
      |Receives Delivery events from streaming.
    }
  }
  connector DeliveryEventPipeline is from outlet DeliveryContext.DeliveryEventSource.DeliveryEvents to inlet DeliveryContext.DeliveryEventSink.IncomingDeliveryEvents with {
    briefly "Delivery event pipeline"
    described as {
      |Wires Delivery event source to sink.
    }
  }
  processor DeliveryEventSplit as split is {
    inlet DeliveryEventSplitIn is type DeliveryEvent    outlet DeliveryEventSplitToDeliveryRepository is type DeliveryEvent
    outlet DeliveryEventSplitToDeliveryAnalytics is type DeliveryEvent
    handler DeliveryEventSplitHandler is {
      on deliveryCreated: event Delivery.DeliveryCreated is {
        send deliveryCreated to outlet DeliveryEventSplitToDeliveryRepository
        send deliveryCreated to outlet DeliveryEventSplitToDeliveryAnalytics
        tell deliveryCreated to entity DeliveryContext.Delivery
      }
      on assignedToRoute: event Delivery.AssignedToRoute is {
        send assignedToRoute to outlet DeliveryEventSplitToDeliveryRepository
        send assignedToRoute to outlet DeliveryEventSplitToDeliveryAnalytics
        tell assignedToRoute to entity DeliveryContext.Delivery
      }
      on markedOutForDelivery: event Delivery.MarkedOutForDelivery is {
        send markedOutForDelivery to outlet DeliveryEventSplitToDeliveryRepository
        send markedOutForDelivery to outlet DeliveryEventSplitToDeliveryAnalytics
        tell markedOutForDelivery to entity DeliveryContext.Delivery
      }
      on eTAUpdated: event Delivery.ETAUpdated is {
        send eTAUpdated to outlet DeliveryEventSplitToDeliveryRepository
        send eTAUpdated to outlet DeliveryEventSplitToDeliveryAnalytics
        tell eTAUpdated to entity DeliveryContext.Delivery
      }
      on deliveryAttempted: event Delivery.DeliveryAttempted is {
        send deliveryAttempted to outlet DeliveryEventSplitToDeliveryRepository
        send deliveryAttempted to outlet DeliveryEventSplitToDeliveryAnalytics
        tell deliveryAttempted to entity DeliveryContext.Delivery
      }
      on deliveryCompleted: event Delivery.DeliveryCompleted is {
        send deliveryCompleted to outlet DeliveryEventSplitToDeliveryRepository
        send deliveryCompleted to outlet DeliveryEventSplitToDeliveryAnalytics
        tell deliveryCompleted to entity DeliveryContext.Delivery
      }
      on deliveryFailed: event Delivery.DeliveryFailed is {
        send deliveryFailed to outlet DeliveryEventSplitToDeliveryRepository
        send deliveryFailed to outlet DeliveryEventSplitToDeliveryAnalytics
        tell deliveryFailed to entity DeliveryContext.Delivery
      }
      on deliveryRescheduled: event Delivery.DeliveryRescheduled is {
        send deliveryRescheduled to outlet DeliveryEventSplitToDeliveryRepository
        send deliveryRescheduled to outlet DeliveryEventSplitToDeliveryAnalytics
        tell deliveryRescheduled to entity DeliveryContext.Delivery
      }
      on returnInitiated: event Delivery.ReturnInitiated is {
        send returnInitiated to outlet DeliveryEventSplitToDeliveryRepository
        send returnInitiated to outlet DeliveryEventSplitToDeliveryAnalytics
        tell returnInitiated to entity DeliveryContext.Delivery
      }
      on other is {
        error "Unexpected message for processor DeliveryEventSplit"
      }
    } with {
      briefly "Delivery event fan-out handler"
      described as {
        |Delivers each Delivery event to all of its consumers.
      }
    }
  } with {
    briefly "Delivery event fan-out"
    described as {
      |Fans Delivery events out to the repository and projectors.
    }
  }
  connector 'DeliveryEvent Stream' is from outlet DeliveryContext.Delivery.DeliveryEvents2 to inlet DeliveryContext.DeliveryEventSplit.DeliveryEventSplitIn with {
    briefly "Delivery events, fanned out to storage and read models"
  }
  connector 'DeliveryEvent Storage' is from outlet DeliveryContext.DeliveryEventSplit.DeliveryEventSplitToDeliveryRepository to inlet DeliveryContext.DeliveryRepository.DeliveryRepositoryFromDelivery with {
    briefly "Delivery events on their way to storage"
  }
  connector 'DeliveryAnalytics Feed' is from outlet DeliveryContext.DeliveryEventSplit.DeliveryEventSplitToDeliveryAnalytics to inlet DeliveryContext.DeliveryAnalytics.DeliveryAnalyticsFromDelivery with {
    briefly "Delivery events feeding the DeliveryAnalytics projection"
  }
  connector 'DeliveryAnalytics Storage' is from outlet DeliveryContext.DeliveryAnalytics.DeliveryAnalyticsOut to inlet DeliveryContext.DeliveryRepository.DeliveryRepositoryFromDeliveryAnalytics with {
    briefly "The DeliveryAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for last mile delivery"
  described as {
    |Final delivery operations context.
  }
}
