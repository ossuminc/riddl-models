// Last Mile Delivery - Delivery Context
context DeliveryContext as router is {
  inlet DeliveryContextFromRouteOptimization is command Delivery.UpdateETA with {
    briefly "What FromRouteOptimization makes of that service's news"
  }
  connector 'FromRouteOptimization Intake' is from outlet DeliveryContext.FromRouteOptimization.FromRouteOptimizationToDeliveryContext to inlet DeliveryContext.DeliveryContextFromRouteOptimization with {
    briefly "What FromRouteOptimization makes of that news, on its way in"
  }
  inlet DeliveryCommandStreamIn is type DeliveryCommand  outlet DeliveryCommandStreamOut is type DeliveryCommand
  inlet DeliveryOrderResultStreamIn is result Delivery.DeliveryResult  outlet DeliveryOrderResultStreamOut is result Delivery.DeliveryResult
  handler DeliveryContextBoundary is {
    on createDelivery: command Delivery.CreateDelivery is {
      send createDelivery to outlet DeliveryContext.DeliveryCommandStreamOut
    }
    on assignToRoute: command Delivery.AssignToRoute is {
      send assignToRoute to outlet DeliveryContext.DeliveryCommandStreamOut
    }
    on markOutForDelivery: command Delivery.MarkOutForDelivery is {
      send markOutForDelivery to outlet DeliveryContext.DeliveryCommandStreamOut
    }
    on updateETA: command Delivery.UpdateETA is {
      send updateETA to outlet DeliveryContext.DeliveryCommandStreamOut
    }
    on attemptDelivery: command Delivery.AttemptDelivery is {
      send attemptDelivery to outlet DeliveryContext.DeliveryCommandStreamOut
    }
    on completeDelivery: command Delivery.CompleteDelivery is {
      send completeDelivery to outlet DeliveryContext.DeliveryCommandStreamOut
    }
    on failDelivery: command Delivery.FailDelivery is {
      send failDelivery to outlet DeliveryContext.DeliveryCommandStreamOut
    }
    on rescheduleDelivery: command Delivery.RescheduleDelivery is {
      send rescheduleDelivery to outlet DeliveryContext.DeliveryCommandStreamOut
    }
    on returnToSender: command Delivery.ReturnToSender is {
      send returnToSender to outlet DeliveryContext.DeliveryCommandStreamOut
    }
    on deliveryResult: result Delivery.DeliveryResult is {
      send deliveryResult to outlet DeliveryContext.DeliveryOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the DeliveryContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'DeliveryCommand Stream Intake' is from outlet DeliveryContext.DeliveryCommandStreamOut to inlet DeliveryContext.Delivery.DeliveryCommands  connector 'DeliveryOrderResult Stream Egress' is from outlet DeliveryContext.DeliveryRepository.DeliveryRepositoryResponses to inlet DeliveryContext.DeliveryOrderResultStreamIn  adaptor ToCustomerNotification to context CustomerNotification as flow is { 
    inlet ToCustomerNotificationIn is type DeliveryEvent    outlet ToCustomerNotificationOut is command CustomerNotification.SendDeliveryNotification
    handler ToCustomerNotificationHandler is {
      on etaUpdated: event ETAUpdated is {
        when prompt("the new ETA differs materially from what the customer was last told, rather than drifting by minutes") then
          let notice: type CustomerNotification.SendDeliveryNotification = prompt("translate the etaUpdated event into a SendDeliveryNotification giving the customer the revised arrival window, which replaces the one they were last given")
          send notice to outlet DeliveryContext.ToCustomerNotification.ToCustomerNotificationOut
        end
      }
      on markedOutForDelivery: event MarkedOutForDelivery is {
        let notice: type CustomerNotification.SendDeliveryNotification = prompt("translate the markedOutForDelivery event into a SendDeliveryNotification telling the customer the parcel is on the vehicle today, so they can arrange to receive it")
        send notice to outlet DeliveryContext.ToCustomerNotification.ToCustomerNotificationOut
      }
      on deliveryCompleted: event DeliveryCompleted is {
        let notice: type CustomerNotification.SendDeliveryNotification = prompt("translate the deliveryCompleted event into a SendDeliveryNotification telling the customer the parcel has been delivered and where it was left")
        send notice to outlet DeliveryContext.ToCustomerNotification.ToCustomerNotificationOut
      }
      on deliveryFailed: event DeliveryFailed is {
        let notice: type CustomerNotification.SendDeliveryNotification = prompt("translate the deliveryFailed event into a SendDeliveryNotification telling the customer the attempt failed, why, and what happens next")
        send notice to outlet DeliveryContext.ToCustomerNotification.ToCustomerNotificationOut
      }
      on deliveryRescheduled: event DeliveryRescheduled is {
        let notice: type CustomerNotification.SendDeliveryNotification = prompt("translate the deliveryRescheduled event into a SendDeliveryNotification telling the customer the new delivery date, replacing the one they were given")
        send notice to outlet DeliveryContext.ToCustomerNotification.ToCustomerNotificationOut
      }
      on returnInitiated: event ReturnInitiated is {
        let notice: type CustomerNotification.SendDeliveryNotification = prompt("translate the returnInitiated event into a SendDeliveryNotification telling the customer the parcel is going back to the sender")
        send notice to outlet DeliveryContext.ToCustomerNotification.ToCustomerNotificationOut
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerNotification"
      }
    } with {
      briefly "to customer notification"
      described as {
        |Carries messages to the external CustomerNotification.
      }
    }
  } with {
    briefly "CustomerNotification integration"
    described as {
      |The model's side of the CustomerNotification conversation.
    }
  }
  adaptor FromDriverMobile from context DriverMobile as sink is { 
    inlet FromDriverMobileIn is type DriverMobile.DriverMobileEvent    handler FromDriverMobileHandler is {
      on driverLocationUpdated: event DriverMobile.DriverLocationUpdated is {
        do "the driver moved; the ETA is recalculated by the optimiser, not on every ping"
      }
      on routeReceived: event DriverMobile.RouteReceived is {
        do "the driver has the route; assigning it was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromDriverMobile"
      }
    } with {
      briefly "from driver mobile"
      described as {
        |Carries messages from the external DriverMobile.
      }
    }
  } with {
    briefly "DriverMobile integration"
    described as {
      |The model's side of the DriverMobile conversation.
    }
  }
  adaptor ToDriverMobile to context DriverMobile as flow is { 
    inlet ToDriverMobileIn is type DeliveryEvent    outlet ToDriverMobileOut is command DriverMobile.SendRouteToDriver
    handler ToDriverMobileHandler is {
      on assignedToRoute: event Delivery.AssignedToRoute is {
        let item0: type DriverMobile.SendRouteToDriver = prompt("translate the assignedToRoute event into a SendRouteToDriver, assignment being when a driver has somewhere to go")
        send item0 to outlet DeliveryContext.ToDriverMobile.ToDriverMobileOut
      }
      on other is {
        error "Unexpected message for adaptor ToDriverMobile"
      }
    } with {
      briefly "to driver mobile"
      described as {
        |Carries messages to the external DriverMobile.
      }
    }
  } with {
    briefly "DriverMobile integration"
    described as {
      |The model's side of the DriverMobile conversation.
    }
  }
  adaptor FromGeocodingService from context GeocodingService as sink is { 
    inlet FromGeocodingServiceIn is type GeocodingService.GeocodingServiceEvent    handler FromGeocodingServiceHandler is {
      on addressGeocoded: event GeocodingService.AddressGeocoded is {
        do "the address has coordinates; the delivery keeps the address and the optimiser uses the point"
      }
      on locationResolved: event GeocodingService.LocationResolved is {
        do "the attempt has a place name; the attempt itself was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromGeocodingService"
      }
    } with {
      briefly "from geocoding service"
      described as {
        |Carries messages from the external GeocodingService.
      }
    }
  } with {
    briefly "GeocodingService integration"
    described as {
      |The model's side of the GeocodingService conversation.
    }
  }
  adaptor ToGeocodingService to context GeocodingService as flow is { 
    inlet ToGeocodingServiceIn is type DeliveryEvent    outlet ToGeocodingServiceOut is type GeocodingService.GeocodingServiceCommand
    handler ToGeocodingServiceHandler is {
      on deliveryCreated: event Delivery.DeliveryCreated is {
        let item0: type GeocodingService.GeocodeAddress = prompt("translate the deliveryCreated event into a GeocodeAddress, an address being unroutable as text")
        send item0 to outlet DeliveryContext.ToGeocodingService.ToGeocodingServiceOut
      }
      on deliveryAttempted: event Delivery.DeliveryAttempted is {
        let item0: type GeocodingService.ReverseGeocode = prompt("translate the deliveryAttempted event into a ReverseGeocode, an attempt recording a position that must be turned back into a place")
        send item0 to outlet DeliveryContext.ToGeocodingService.ToGeocodingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToGeocodingService"
      }
    } with {
      briefly "to geocoding service"
      described as {
        |Carries messages to the external GeocodingService.
      }
    }
  } with {
    briefly "GeocodingService integration"
    described as {
      |The model's side of the GeocodingService conversation.
    }
  }
  adaptor FromProofCapture from context ProofCapture as sink is { 
    inlet FromProofCaptureIn is type ProofCapture.ProofCaptureEvent    handler FromProofCaptureHandler is {
      on photoCaptured: event ProofCapture.PhotoCaptured is {
        do "the photo is stored; the failed attempt it evidences was recorded here"
      }
      on signatureCaptured: event ProofCapture.SignatureCaptured is {
        do "the signature is stored; completing the delivery was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromProofCapture"
      }
    } with {
      briefly "from proof capture"
      described as {
        |Carries messages from the external ProofCapture.
      }
    }
  } with {
    briefly "ProofCapture integration"
    described as {
      |The model's side of the ProofCapture conversation.
    }
  }
  adaptor ToProofCapture to context ProofCapture as flow is { 
    inlet ToProofCaptureIn is type DeliveryEvent    outlet ToProofCaptureOut is type ProofCapture.ProofCaptureCommand
    handler ToProofCaptureHandler is {
      on deliveryCompleted: event Delivery.DeliveryCompleted is {
        let item0: type ProofCapture.CaptureSignature = prompt("translate the deliveryCompleted event into a CaptureSignature, delivery being the moment proof can be taken")
        send item0 to outlet DeliveryContext.ToProofCapture.ToProofCaptureOut
      }
      on deliveryFailed: event Delivery.DeliveryFailed is {
        let item0: type ProofCapture.CapturePhoto = prompt("translate the deliveryFailed event into a CapturePhoto, and a failed attempt being the moment it must be")
        send item0 to outlet DeliveryContext.ToProofCapture.ToProofCaptureOut
      }
      on other is {
        error "Unexpected message for adaptor ToProofCapture"
      }
    } with {
      briefly "to proof capture"
      described as {
        |Carries messages to the external ProofCapture.
      }
    }
  } with {
    briefly "ProofCapture integration"
    described as {
      |The model's side of the ProofCapture conversation.
    }
  }
  adaptor FromRouteOptimization from context RouteOptimization as flow is { 
    inlet FromRouteOptimizationIn is type RouteOptimization.RouteOptimizationEvent    outlet FromRouteOptimizationToDeliveryContext is command Delivery.UpdateETA
    handler FromRouteOptimizationHandler is {
      on eTAsRecalculated: event RouteOptimization.ETAsRecalculated is {
        let item0: type Delivery.UpdateETA = prompt("translate the eTAsRecalculated event into a UpdateETA, the optimiser's recalculated ETA is the one the delivery must show")
        send item0 to outlet DeliveryContext.FromRouteOptimization.FromRouteOptimizationToDeliveryContext
      }
      on routeOptimized: event RouteOptimization.RouteOptimized is {
        do "the route is optimised; the assignment that asked for it was recorded first"
      }
      on other is {
        error "Unexpected message for adaptor FromRouteOptimization"
      }
    } with {
      briefly "from route optimization"
      described as {
        |Carries messages from the external RouteOptimization.
      }
    }
  } with {
    briefly "RouteOptimization integration"
    described as {
      |The model's side of the RouteOptimization conversation.
    }
  }
  adaptor ToRouteOptimization to context RouteOptimization as flow is { 
    inlet ToRouteOptimizationIn is type DeliveryEvent    outlet ToRouteOptimizationOut is type RouteOptimization.RouteOptimizationCommand
    handler ToRouteOptimizationHandler is {
      on assignedToRoute: event Delivery.AssignedToRoute is {
        let plan: type RouteOptimization.OptimizeRoute = prompt("translate the assignedToRoute event into an OptimizeRoute re-planning the run now this drop is on it")
        send plan to outlet DeliveryContext.ToRouteOptimization.ToRouteOptimizationOut
      }
      on deliveryAttempted: event Delivery.DeliveryAttempted is {
        let estimate: type RouteOptimization.RecalculateETA = prompt("translate the deliveryAttempted event into a RecalculateETA, an attempt having moved every drop after it")
        send estimate to outlet DeliveryContext.ToRouteOptimization.ToRouteOptimizationOut
      }
      on other is {
        error "Unexpected message for adaptor ToRouteOptimization"
      }
    } with {
      briefly "to route optimization"
      described as {
        |Carries messages to the external RouteOptimization.
      }
    }
  } with {
    briefly "RouteOptimization integration"
    described as {
      |The model's side of the RouteOptimization conversation.
    }
  }
  include "types.riddl"
  include "Delivery.riddl"
  type DeliveryRepositoryCommand is one of {
    DeliveryContext.DeliveryRepository.PersistAssignedToRoute or DeliveryContext.DeliveryRepository.PersistDeliveryAttempted or DeliveryContext.DeliveryRepository.PersistDeliveryCompleted or DeliveryContext.DeliveryRepository.PersistDeliveryCreated or DeliveryContext.DeliveryRepository.PersistDeliveryFailed or DeliveryContext.DeliveryRepository.PersistDeliveryRescheduled or DeliveryContext.DeliveryRepository.PersistETAUpdated or DeliveryContext.DeliveryRepository.PersistMarkedOutForDelivery or DeliveryContext.DeliveryRepository.PersistReturnInitiated
  } with {
    briefly "Anything that writes DeliveryRepository"
    described as {
      |The persistence commands DeliveryRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository DeliveryRepository as flow is {
    inlet DeliveryRepositoryFromDeliveryAnalytics is type DeliveryRepositoryCommand    command PersistAssignedToRoute is {
      deliveryId: DeliveryId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssignedToRoute applies to.
        }
      }
    } with {
      briefly "Persist AssignedToRoute"
      described as {
        |Instructs this repository to apply AssignedToRoute to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryRescheduled is {
      deliveryId: DeliveryId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryRescheduled applies to.
        }
      }
    } with {
      briefly "Persist DeliveryRescheduled"
      described as {
        |Instructs this repository to apply DeliveryRescheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistETAUpdated is {
      deliveryId: DeliveryId with {
        briefly "Row addressed"
        described as {
          |Which stored row ETAUpdated applies to.
        }
      }
    } with {
      briefly "Persist ETAUpdated"
      described as {
        |Instructs this repository to apply ETAUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMarkedOutForDelivery is {
      deliveryId: DeliveryId with {
        briefly "Row addressed"
        described as {
          |Which stored row MarkedOutForDelivery applies to.
        }
      }
    } with {
      briefly "Persist MarkedOutForDelivery"
      described as {
        |Instructs this repository to apply MarkedOutForDelivery to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnInitiated is {
      deliveryId: DeliveryId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnInitiated applies to.
        }
      }
    } with {
      briefly "Persist ReturnInitiated"
      described as {
        |Instructs this repository to apply ReturnInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryAttempted is {
      deliveryId: DeliveryId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryAttempted applies to.
        }
      }
    } with {
      briefly "Persist DeliveryAttempted"
      described as {
        |Instructs this repository to apply DeliveryAttempted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryCompleted is {
      deliveryId: DeliveryId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryCompleted applies to.
        }
      }
    } with {
      briefly "Persist DeliveryCompleted"
      described as {
        |Instructs this repository to apply DeliveryCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryCreated is {
      deliveryId: DeliveryId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryCreated applies to.
        }
      }
    } with {
      briefly "Persist DeliveryCreated"
      described as {
        |Instructs this repository to apply DeliveryCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryFailed is {
      deliveryId: DeliveryId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryFailed applies to.
        }
      }
    } with {
      briefly "Persist DeliveryFailed"
      described as {
        |Instructs this repository to apply DeliveryFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet DeliveryRepositoryResponses is result Delivery.DeliveryResult
    record StoredDelivery is {
      deliveryId: DeliveryId with {
        briefly "deliveryId"
        described as {
          |The deliveryId column of the stored delivery row.
        }
      }
      address: Address with {
        briefly "address"
        described as {
          |The address column of the stored delivery row.
        }
      }
      packageInfo: PackageInfo with {
        briefly "packageInfo"
        described as {
          |The packageInfo column of the stored delivery row.
        }
      }
      routeId: RouteId with {
        briefly "routeId"
        described as {
          |The routeId column of the stored delivery row.
        }
      }
      status: DeliveryStatus with {
        briefly "status"
        described as {
          |The status column of the stored delivery row.
        }
      }
    } with {
      briefly "Stored delivery row"
      described as {
        |The persistence shape of delivery data as this repository stores it.
      }
    }
    schema DeliveryData is relational
      of deliveries as record StoredDelivery
        index on field StoredDelivery.packageInfo.trackingNumber
        index on field StoredDelivery.status
        index on field StoredDelivery.routeId
        index on field StoredDelivery.address.postalCode
 with {
      briefly "Delivery data schema"
      described as {
        |The relational schema holding delivery data for the DeliveryRepository.
      }
    }
    handler DeliveryPersistence is {
      on persistAssignedToRoute: command PersistAssignedToRoute is {
        do "apply AssignedToRoute to the stored row"
      }
      on persistDeliveryRescheduled: command PersistDeliveryRescheduled is {
        do "apply DeliveryRescheduled to the stored row"
      }
      on persistETAUpdated: command PersistETAUpdated is {
        do "apply ETAUpdated to the stored row"
      }
      on persistMarkedOutForDelivery: command PersistMarkedOutForDelivery is {
        do "apply MarkedOutForDelivery to the stored row"
      }
      on persistReturnInitiated: command PersistReturnInitiated is {
        do "apply ReturnInitiated to the stored row"
      }
      on persistDeliveryAttempted: command PersistDeliveryAttempted is {
        do "apply DeliveryAttempted to the stored row"
      }
      on persistDeliveryCompleted: command PersistDeliveryCompleted is {
        do "apply DeliveryCompleted to the stored row"
      }
      on persistDeliveryCreated: command PersistDeliveryCreated is {
        do "apply DeliveryCreated to the stored row"
      }
      on persistDeliveryFailed: command PersistDeliveryFailed is {
        do "apply DeliveryFailed to the stored row"
      }
      on query GetDailyMetrics is {
        let dailyMetricsView: type DailyMetricsView = prompt("read the daily metrics projection")
        reply dailyMetricsView
      }
    } with {
      briefly "Persists delivery commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Delivery data persistence"
    described as {
      |Persistent storage for deliveries.
    }
  }
  query GetDailyMetrics replies result DailyMetricsView is {
    dailyMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily metrics to retrieve.
      }
    }
  } with {
    briefly "Get daily metrics"
    described as {
      |Retrieves the daily metrics projection.
    }
  }
  result DailyMetricsView is {
    dailyMetrics: DeliveryAnalytics.DailyMetrics with {
      briefly "Daily metrics"
      described as {
        |The daily metrics being returned.
      }
    }
  } with {
    briefly "Daily metrics view"
    described as {
      |Read model view carrying the daily metrics projection.
    }
  }
  projector DeliveryAnalytics as flow is {
    updates repository DeliveryContext.DeliveryRepository
    outlet DeliveryAnalyticsToRepository is type DeliveryRepositoryCommand
    inlet DeliveryAnalyticsFromDelivery is type DeliveryEvent    record DailyMetrics is {
      totalDeliveries: Natural with {
        briefly "Total"
        described as {
          |Total deliveries.
        }
      }
      completed: Natural with {
        briefly "Completed"
        described as {
          |Completed.
        }
      }
      failed: Natural with {
        briefly "Failed"
        described as {
          |Failed.
        }
      }
      onTimeRate: Decimal(5,2) with {
        briefly "On-time"
        described as {
          |On-time rate.
        }
      }
      averageAttemptsPerDelivery: Decimal(3,2) with {
        briefly "Attempts"
        described as {
          |Avg attempts.
        }
      }
      firstAttemptSuccessRate: Decimal(5,2) with {
        briefly "First attempt"
        described as {
          |First attempt success.
        }
      }
    } with {
      briefly "Daily metrics"
      described as {
        |Daily delivery metrics.
      }
    }
    handler AnalyticsHandler is {
      on assignedToRoute: event Delivery.AssignedToRoute is {
        tell command DeliveryContext.DeliveryRepository.PersistAssignedToRoute(deliveryId = assignedToRoute.deliveryId) to repository DeliveryContext.DeliveryRepository
        do "apply AssignedToRoute to the DeliveryAnalytics projection"
      }
      on deliveryRescheduled: event Delivery.DeliveryRescheduled is {
        tell command DeliveryContext.DeliveryRepository.PersistDeliveryRescheduled(deliveryId = deliveryRescheduled.deliveryId) to repository DeliveryContext.DeliveryRepository
        do "apply DeliveryRescheduled to the DeliveryAnalytics projection"
      }
      on eTAUpdated: event Delivery.ETAUpdated is {
        tell command DeliveryContext.DeliveryRepository.PersistETAUpdated(deliveryId = eTAUpdated.deliveryId) to repository DeliveryContext.DeliveryRepository
        do "apply ETAUpdated to the DeliveryAnalytics projection"
      }
      on markedOutForDelivery: event Delivery.MarkedOutForDelivery is {
        tell command DeliveryContext.DeliveryRepository.PersistMarkedOutForDelivery(deliveryId = markedOutForDelivery.deliveryId) to repository DeliveryContext.DeliveryRepository
        do "apply MarkedOutForDelivery to the DeliveryAnalytics projection"
      }
      on returnInitiated: event Delivery.ReturnInitiated is {
        tell command DeliveryContext.DeliveryRepository.PersistReturnInitiated(deliveryId = returnInitiated.deliveryId) to repository DeliveryContext.DeliveryRepository
        do "apply ReturnInitiated to the DeliveryAnalytics projection"
      }
      on deliveryCreated: event Delivery.DeliveryCreated is {
        tell command DeliveryContext.DeliveryRepository.PersistDeliveryCreated(deliveryId = deliveryCreated.deliveryId) to repository DeliveryContext.DeliveryRepository
      }
      on deliveryCompleted: event Delivery.DeliveryCompleted is {
        tell command DeliveryContext.DeliveryRepository.PersistDeliveryCompleted(deliveryId = deliveryCompleted.deliveryId) to repository DeliveryContext.DeliveryRepository
      }
      on deliveryFailed: event Delivery.DeliveryFailed is {
        tell command DeliveryContext.DeliveryRepository.PersistDeliveryFailed(deliveryId = deliveryFailed.deliveryId) to repository DeliveryContext.DeliveryRepository
      }
      on deliveryAttempted: event Delivery.DeliveryAttempted is {
        tell command DeliveryContext.DeliveryRepository.PersistDeliveryAttempted(deliveryId = deliveryAttempted.deliveryId) to repository DeliveryContext.DeliveryRepository
      }
    } with {
      briefly "Maintains delivery analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Delivery analytics"
    described as {
      |Delivery performance tracking.
    }
  }
  type DeliveryEvent is one of {
    DeliveryContext.Delivery.DeliveryCreated or DeliveryContext.Delivery.DeliveryCompleted or DeliveryContext.Delivery.DeliveryFailed or DeliveryContext.Delivery.AssignedToRoute or DeliveryContext.Delivery.DeliveryAttempted or DeliveryContext.Delivery.DeliveryRescheduled or DeliveryContext.Delivery.ETAUpdated or DeliveryContext.Delivery.MarkedOutForDelivery or DeliveryContext.Delivery.ReturnInitiated
  } with {
    briefly "Delivery event union"
    described as {
      |Union of Delivery events for streaming.
    }
  }
  streamlet DeliveryEventSplit as split is {
    outlet DeliveryEventSplitToToRouteOptimization is type DeliveryEvent
    outlet DeliveryEventSplitToToProofCapture is type DeliveryEvent
    outlet DeliveryEventSplitToToGeocodingService is type DeliveryEvent
    outlet DeliveryEventSplitToToDriverMobile is type DeliveryEvent
    outlet DeliveryEventSplitToToCustomerNotification is type DeliveryEvent
    inlet DeliveryEventSplitIn is type DeliveryEvent    outlet DeliveryEventSplitToDeliveryAnalytics is type DeliveryEvent
    handler DeliveryEventSplitHandler is {
      on deliveryCreated: event Delivery.DeliveryCreated is {
        send deliveryCreated to outlet DeliveryEventSplitToDeliveryAnalytics
        send deliveryCreated to outlet DeliveryEventSplitToToGeocodingService
        tell deliveryCreated to entity DeliveryContext.Delivery
      }
      on assignedToRoute: event Delivery.AssignedToRoute is {
        send assignedToRoute to outlet DeliveryEventSplitToDeliveryAnalytics
        send assignedToRoute to outlet DeliveryEventSplitToToRouteOptimization
        send assignedToRoute to outlet DeliveryEventSplitToToDriverMobile
        tell assignedToRoute to entity DeliveryContext.Delivery
      }
      on markedOutForDelivery: event Delivery.MarkedOutForDelivery is {
        send markedOutForDelivery to outlet DeliveryEventSplitToDeliveryAnalytics
        send markedOutForDelivery to outlet DeliveryEventSplitToToCustomerNotification
        tell markedOutForDelivery to entity DeliveryContext.Delivery
      }
      on eTAUpdated: event Delivery.ETAUpdated is {
        send eTAUpdated to outlet DeliveryEventSplitToDeliveryAnalytics
        send eTAUpdated to outlet DeliveryEventSplitToToCustomerNotification
        tell eTAUpdated to entity DeliveryContext.Delivery
      }
      on deliveryAttempted: event Delivery.DeliveryAttempted is {
        send deliveryAttempted to outlet DeliveryEventSplitToDeliveryAnalytics
        send deliveryAttempted to outlet DeliveryEventSplitToToRouteOptimization
        send deliveryAttempted to outlet DeliveryEventSplitToToGeocodingService
        tell deliveryAttempted to entity DeliveryContext.Delivery
      }
      on deliveryCompleted: event Delivery.DeliveryCompleted is {
        send deliveryCompleted to outlet DeliveryEventSplitToDeliveryAnalytics
        send deliveryCompleted to outlet DeliveryEventSplitToToProofCapture
        send deliveryCompleted to outlet DeliveryEventSplitToToCustomerNotification
        tell deliveryCompleted to entity DeliveryContext.Delivery
      }
      on deliveryFailed: event Delivery.DeliveryFailed is {
        send deliveryFailed to outlet DeliveryEventSplitToDeliveryAnalytics
        send deliveryFailed to outlet DeliveryEventSplitToToProofCapture
        send deliveryFailed to outlet DeliveryEventSplitToToCustomerNotification
        tell deliveryFailed to entity DeliveryContext.Delivery
      }
      on deliveryRescheduled: event Delivery.DeliveryRescheduled is {
        send deliveryRescheduled to outlet DeliveryEventSplitToDeliveryAnalytics
        send deliveryRescheduled to outlet DeliveryEventSplitToToCustomerNotification
        tell deliveryRescheduled to entity DeliveryContext.Delivery
      }
      on returnInitiated: event Delivery.ReturnInitiated is {
        send returnInitiated to outlet DeliveryEventSplitToDeliveryAnalytics
        send returnInitiated to outlet DeliveryEventSplitToToCustomerNotification
        tell returnInitiated to entity DeliveryContext.Delivery
      }
      on other is {
        error "Unexpected message for processor DeliveryEventSplit"
      }
    } with {
      briefly "Delivery event fan-out handler"
      described as {
        |Delivers each Delivery event to all of its consumers.
      }
    }
  } with {
    briefly "Delivery event fan-out"
    described as {
      |Fans Delivery events out to the repository and projectors.
    }
  }
  connector 'ToRouteOptimization Feed' is from outlet DeliveryContext.DeliveryEventSplit.DeliveryEventSplitToToRouteOptimization to inlet DeliveryContext.ToRouteOptimization.ToRouteOptimizationIn with {
    briefly "The Delivery events ToRouteOptimization translates, on their way to it"
  }
  connector 'ToProofCapture Feed' is from outlet DeliveryContext.DeliveryEventSplit.DeliveryEventSplitToToProofCapture to inlet DeliveryContext.ToProofCapture.ToProofCaptureIn with {
    briefly "The Delivery events ToProofCapture translates, on their way to it"
  }
  connector 'ToGeocodingService Feed' is from outlet DeliveryContext.DeliveryEventSplit.DeliveryEventSplitToToGeocodingService to inlet DeliveryContext.ToGeocodingService.ToGeocodingServiceIn with {
    briefly "The Delivery events ToGeocodingService translates, on their way to it"
  }
  connector 'ToDriverMobile Feed' is from outlet DeliveryContext.DeliveryEventSplit.DeliveryEventSplitToToDriverMobile to inlet DeliveryContext.ToDriverMobile.ToDriverMobileIn with {
    briefly "The Delivery events ToDriverMobile translates, on their way to it"
  }
  connector 'ToCustomerNotification Feed' is from outlet DeliveryContext.DeliveryEventSplit.DeliveryEventSplitToToCustomerNotification to inlet DeliveryContext.ToCustomerNotification.ToCustomerNotificationIn with {
    briefly "The Delivery events ToCustomerNotification translates, on their way to it"
  }
  connector 'DeliveryEvent Stream' is from outlet DeliveryContext.Delivery.DeliveryEvents2 to inlet DeliveryContext.DeliveryEventSplit.DeliveryEventSplitIn with {
    briefly "Delivery events, fanned out to storage and read models"
  }
  connector 'DeliveryAnalytics Feed' is from outlet DeliveryContext.DeliveryEventSplit.DeliveryEventSplitToDeliveryAnalytics to inlet DeliveryContext.DeliveryAnalytics.DeliveryAnalyticsFromDelivery with {
    briefly "Delivery events feeding the DeliveryAnalytics projection"
  }
  connector 'DeliveryAnalytics Storage' is from outlet DeliveryContext.DeliveryAnalytics.DeliveryAnalyticsToRepository to inlet DeliveryContext.DeliveryRepository.DeliveryRepositoryFromDeliveryAnalytics with {
    briefly "DeliveryAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for last mile delivery"
  described as {
    |Final delivery operations context.
  }
}
