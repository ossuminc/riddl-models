// Last Mile Delivery Domain Model
// Final delivery operations and route optimization
domain LastMileDelivery is {
  persistent connector 'DriverMobileEvent Stream' is from outlet DriverMobile.DriverMobileEventsOut to inlet DeliveryContext.FromDriverMobile.FromDriverMobileIn with {
    briefly "What DriverMobile tells DeliveryContext, unasked"
  }
  persistent connector 'GeocodingServiceEvent Stream' is from outlet GeocodingService.GeocodingServiceEventsOut to inlet DeliveryContext.FromGeocodingService.FromGeocodingServiceIn with {
    briefly "What GeocodingService tells DeliveryContext, unasked"
  }
  persistent connector 'ProofCaptureEvent Stream' is from outlet ProofCapture.ProofCaptureEventsOut to inlet DeliveryContext.FromProofCapture.FromProofCaptureIn with {
    briefly "What ProofCapture tells DeliveryContext, unasked"
  }
  persistent connector 'RouteOptimizationEvent Stream' is from outlet RouteOptimization.RouteOptimizationEventsOut to inlet DeliveryContext.FromRouteOptimization.FromRouteOptimizationIn with {
    briefly "What RouteOptimization tells DeliveryContext, unasked"
  }
  persistent connector 'GeocodingServiceRequest Stream' is from outlet DeliveryContext.ToGeocodingService.ToGeocodingServiceOut to inlet GeocodingService.GeocodingServiceRequests with {
    briefly "What DeliveryContext asks GeocodingService to send"
  }
  persistent connector 'DriverMobileRequest Stream' is from outlet DeliveryContext.ToDriverMobile.ToDriverMobileOut to inlet DriverMobile.DriverMobileRequests with {
    briefly "What DeliveryContext asks DriverMobile to send"
  }
  persistent connector 'ProofCaptureRequest Stream' is from outlet DeliveryContext.ToProofCapture.ToProofCaptureOut to inlet ProofCapture.ProofCaptureRequests with {
    briefly "What DeliveryContext asks ProofCapture to send"
  }
  persistent connector 'RouteOptimizationRequest Stream' is from outlet DeliveryContext.ToRouteOptimization.ToRouteOptimizationOut to inlet RouteOptimization.RouteOptimizationRequests with {
    briefly "What DeliveryContext asks RouteOptimization to send"
  }
  persistent connector 'CustomerNotificationRequest Stream' is from outlet DeliveryContext.ToCustomerNotification.ToCustomerNotificationOut to inlet CustomerNotification.CustomerNotificationRequests with {
    briefly "What DeliveryContext asks CustomerNotification to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Dispatcher is "person managing delivery routes" with {
    briefly "Dispatcher"
    described as {
      |Plans and assigns delivery routes.
    }
  }
  user Driver is "person delivering packages" with {
    briefly "Driver"
    described as {
      |Performs package deliveries.
    }
  }
  user Customer is "person receiving delivery" with {
    briefly "Customer"
    described as {
      |End recipient of package.
    }
  }
  epic DeliveryOperations is {
    user Dispatcher wants to "to optimize delivery routes" so that "drivers complete deliveries efficiently"
    case PlanRoute is {
      user Dispatcher wants to "to create optimized routes" so that "drivers minimize travel time"
      step is "System assigns" "packages to drivers" "by area" with {
        briefly "Assign packages"
        described as {
          |Group by zone.
        }
      }
      step is "System optimizes" "route sequence" "for efficiency" with {
        briefly "Optimize route"
        described as {
          |Calculate best path.
        }
      }
    } with {
      briefly "Plan delivery route"
      described as {
        |Route planning and optimization.
      }
    }
  } with {
    briefly "Delivery operations"
    described as {
      |Epic for last mile delivery.
    }
  }
  include "DeliveryContext.riddl"
  include "external-contexts.riddl"
  application context LastMileDeliveryApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in LastMileDelivery are delivered.
      }
    }
    outlet AppDeliveryCommands is type DeliveryContext.Delivery.DeliveryCommand
    inlet AppDeliveryRepositoryResponses is result DeliveryContext.Delivery.DeliveryResult    handler LastMileDeliveryAppHandler is {
      on other is {
        error "Unexpected message for application context LastMileDeliveryApp"
      }
    } with {
      briefly "LastMileDeliveryApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "LastMileDeliveryApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'DeliveryCommand Stream' is from outlet LastMileDeliveryApp.AppDeliveryCommands to inlet DeliveryContext.DeliveryCommandStreamIn with {
    briefly "Delivery commands from the application"
  }
  persistent connector 'DeliveryOrderResult Stream' is from outlet DeliveryContext.DeliveryOrderResultStreamOut to inlet LastMileDeliveryApp.AppDeliveryRepositoryResponses with {
    briefly "Delivery query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet LastMileDeliveryApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term DeliveryArea is "The geographic area to which packages are assigned for drivers."
  briefly "Last mile delivery domain"
  described as {
    |Final delivery operations and routing.
  }
}
