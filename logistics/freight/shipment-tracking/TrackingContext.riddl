// Shipment Tracking - Tracking Context
context TrackingContext as router is {
  inlet TrackingContextFromCarrierIntegration is command Shipment.AddTrackingEvent with {
    briefly "What FromCarrierIntegration makes of that service's news"
  }
  connector 'FromCarrierIntegration Intake' is from outlet TrackingContext.FromCarrierIntegration.FromCarrierIntegrationToTrackingContext to inlet TrackingContext.TrackingContextFromCarrierIntegration with {
    briefly "What FromCarrierIntegration makes of that news, on its way in"
  }
  inlet ShipmentCommandStreamIn is type ShipmentCommand  outlet ShipmentCommandStreamOut is type ShipmentCommand
  inlet ShipmentResultStreamIn is result Shipment.ShipmentResult  outlet ShipmentResultStreamOut is result Shipment.ShipmentResult
  handler TrackingContextBoundary is {
    on createShipment: command Shipment.CreateShipment is {
      send createShipment to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on recordPickup: command Shipment.RecordPickup is {
      send recordPickup to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on addTrackingEvent: command Shipment.AddTrackingEvent is {
      send addTrackingEvent to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on updateLocation: command Shipment.UpdateLocation is {
      send updateLocation to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on updateETA: command Shipment.UpdateETA is {
      send updateETA to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on markOutForDelivery: command Shipment.MarkOutForDelivery is {
      send markOutForDelivery to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on recordDelivery: command Shipment.RecordDelivery is {
      send recordDelivery to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on reportException: command Shipment.ReportException is {
      send reportException to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on resolveException: command Shipment.ResolveException is {
      send resolveException to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on initiateReturn: command Shipment.InitiateReturn is {
      send initiateReturn to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on shipmentResult: result Shipment.ShipmentResult is {
      send shipmentResult to outlet TrackingContext.ShipmentResultStreamOut
    }
    on other is {
      error "Unexpected message at the TrackingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ShipmentCommand Stream Intake' is from outlet TrackingContext.ShipmentCommandStreamOut to inlet TrackingContext.Shipment.ShipmentCommands  connector 'ShipmentResult Stream Egress' is from outlet TrackingContext.ShipmentRepository.ShipmentRepositoryResponses to inlet TrackingContext.ShipmentResultStreamIn  adaptor FromCarrierIntegration from context CarrierIntegration as flow is { 
    inlet FromCarrierIntegrationIn is type CarrierIntegration.CarrierIntegrationEvent    outlet FromCarrierIntegrationToTrackingContext is command Shipment.AddTrackingEvent
    handler FromCarrierIntegrationHandler is {
      on pickupScheduled: event CarrierIntegration.PickupScheduled is {
        do "the carrier will collect; the pickup is recorded when it happens"
      }
      on trackingUpdateReceived: event CarrierIntegration.TrackingUpdateReceived is {
        let item0: type Shipment.AddTrackingEvent = prompt("translate the trackingUpdateReceived event into a AddTrackingEvent, what the carrier reports is the tracking history the shipment shows")
        send item0 to outlet TrackingContext.FromCarrierIntegration.FromCarrierIntegrationToTrackingContext
      }
      on other is {
        error "Unexpected message for adaptor FromCarrierIntegration"
      }
    } with {
      briefly "from carrier integration"
      described as {
        |Carries messages from the external CarrierIntegration.
      }
    }
  } with {
    briefly "CarrierIntegration integration"
    described as {
      |The model's side of the CarrierIntegration conversation.
    }
  }
  adaptor ToCarrierIntegration to context CarrierIntegration as flow is { 
    inlet ToCarrierIntegrationIn is type ShipmentEvent    outlet ToCarrierIntegrationOut is type CarrierIntegration.CarrierIntegrationCommand
    handler ToCarrierIntegrationHandler is {
      on shipmentCreated: event Shipment.ShipmentCreated is {
        let item0: type CarrierIntegration.RequestPickup = prompt("translate the shipmentCreated event into a RequestPickup, the shipment being what a collection is arranged for")
        send item0 to outlet TrackingContext.ToCarrierIntegration.ToCarrierIntegrationOut
      }
      on pickupRecorded: event Shipment.PickupRecorded is {
        let item0: type CarrierIntegration.GetTrackingUpdate = prompt("translate the pickupRecorded event into a GetTrackingUpdate, collection being when the carrier starts having something to say")
        send item0 to outlet TrackingContext.ToCarrierIntegration.ToCarrierIntegrationOut
      }
      on other is {
        error "Unexpected message for adaptor ToCarrierIntegration"
      }
    } with {
      briefly "to carrier integration"
      described as {
        |Carries messages to the external CarrierIntegration.
      }
    }
  } with {
    briefly "CarrierIntegration integration"
    described as {
      |The model's side of the CarrierIntegration conversation.
    }
  }
  adaptor FromGeolocationService from context GeolocationService as sink is { 
    inlet FromGeolocationServiceIn is type GeolocationService.GeolocationServiceEvent    handler FromGeolocationServiceHandler is {
      on addressGeocoded: event GeolocationService.AddressGeocoded is {
        do "the address has coordinates; the shipment keeps the address"
      }
      on routeCalculated: event GeolocationService.RouteCalculated is {
        do "the route is planned; the ETA is updated as the carrier reports progress"
      }
      on other is {
        error "Unexpected message for adaptor FromGeolocationService"
      }
    } with {
      briefly "from geolocation service"
      described as {
        |Carries messages from the external GeolocationService.
      }
    }
  } with {
    briefly "GeolocationService integration"
    described as {
      |The model's side of the GeolocationService conversation.
    }
  }
  adaptor ToGeolocationService to context GeolocationService as flow is { 
    inlet ToGeolocationServiceIn is type ShipmentEvent    outlet ToGeolocationServiceOut is type GeolocationService.GeolocationServiceCommand
    handler ToGeolocationServiceHandler is {
      on shipmentCreated: event Shipment.ShipmentCreated is {
        let item0: type GeolocationService.GeocodeAddress = prompt("translate the shipmentCreated event into a GeocodeAddress, an address being unroutable as text")
        send item0 to outlet TrackingContext.ToGeolocationService.ToGeolocationServiceOut
      }
      on pickupRecorded: event Shipment.PickupRecorded is {
        let item0: type GeolocationService.CalculateRoute = prompt("translate the pickupRecorded event into a CalculateRoute, the route being knowable only once the origin is real")
        send item0 to outlet TrackingContext.ToGeolocationService.ToGeolocationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToGeolocationService"
      }
    } with {
      briefly "to geolocation service"
      described as {
        |Carries messages to the external GeolocationService.
      }
    }
  } with {
    briefly "GeolocationService integration"
    described as {
      |The model's side of the GeolocationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type ShipmentEvent    outlet ToNotificationServiceOut is command NotificationService.SendShipmentNotification
    handler ToNotificationServiceHandler is {
      on exceptionReported: event ExceptionReported is {
        let notice: type NotificationService.SendShipmentNotification = prompt("translate the exceptionReported event into a SendShipmentNotification telling the shipper something has gone wrong with the shipment and what it is")
        send notice to outlet TrackingContext.ToNotificationService.ToNotificationServiceOut
      }
      on exceptionResolved: event ExceptionResolved is {
        let notice: type NotificationService.SendShipmentNotification = prompt("translate the exceptionResolved event into a SendShipmentNotification telling the shipper the problem is cleared and the shipment is moving again")
        send notice to outlet TrackingContext.ToNotificationService.ToNotificationServiceOut
      }
      on etaUpdated: event ETAUpdated is {
        when prompt("the new ETA differs materially from what the consignee was last told, rather than drifting by minutes") then
          let notice: type NotificationService.SendShipmentNotification = prompt("translate the etaUpdated event into a SendShipmentNotification giving the consignee the revised arrival window, which replaces the one they were last given")
          send notice to outlet TrackingContext.ToNotificationService.ToNotificationServiceOut
        end
      }
      on markedOutForDelivery: event MarkedOutForDelivery is {
        let notice: type NotificationService.SendShipmentNotification = prompt("translate the markedOutForDelivery event into a SendShipmentNotification telling the consignee the shipment is out for delivery today")
        send notice to outlet TrackingContext.ToNotificationService.ToNotificationServiceOut
      }
      on deliveryRecorded: event DeliveryRecorded is {
        let notice: type NotificationService.SendShipmentNotification = prompt("translate the deliveryRecorded event into a SendShipmentNotification telling the shipper and consignee the shipment has been delivered")
        send notice to outlet TrackingContext.ToNotificationService.ToNotificationServiceOut
      }
      on returnInitiated: event ReturnInitiated is {
        let notice: type NotificationService.SendShipmentNotification = prompt("translate the returnInitiated event into a SendShipmentNotification telling the shipper the shipment is coming back and why")
        send notice to outlet TrackingContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "Shipment.riddl"
  type ShipmentRepositoryCommand is one of {
    TrackingContext.ShipmentRepository.PersistDeliveryRecorded or TrackingContext.ShipmentRepository.PersistETAUpdated or TrackingContext.ShipmentRepository.PersistExceptionReported or TrackingContext.ShipmentRepository.PersistExceptionResolved or TrackingContext.ShipmentRepository.PersistLocationUpdated or TrackingContext.ShipmentRepository.PersistMarkedOutForDelivery or TrackingContext.ShipmentRepository.PersistPickupRecorded or TrackingContext.ShipmentRepository.PersistReturnInitiated or TrackingContext.ShipmentRepository.PersistShipmentCreated or TrackingContext.ShipmentRepository.PersistTrackingEventAdded
  } with {
    briefly "Anything that writes ShipmentRepository"
    described as {
      |The persistence commands ShipmentRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ShipmentRepository as flow is {
    inlet ShipmentRepositoryFromShipmentAnalytics is type ShipmentRepositoryCommand    command PersistETAUpdated is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ETAUpdated applies to.
        }
      }
      deliveryWindow: DeliveryWindow? with {
        briefly "Delivery window"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ETAUpdated"
      described as {
        |Instructs this repository to apply ETAUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExceptionResolved is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExceptionResolved applies to.
        }
      }
      resolution: String(1,500)? with {
        briefly "Resolution"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newStatus: ShipmentStatus? with {
        briefly "New status"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      resolvedAt: TimeStamp? with {
        briefly "Resolved at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ExceptionResolved"
      described as {
        |Instructs this repository to apply ExceptionResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLocationUpdated is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row LocationUpdated applies to.
        }
      }
      location: String(1,200)? with {
        briefly "Location"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      geoLocation: GeoLocation? with {
        briefly "Geo location"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      timestamp: TimeStamp? with {
        briefly "Timestamp"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist LocationUpdated"
      described as {
        |Instructs this repository to apply LocationUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMarkedOutForDelivery is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row MarkedOutForDelivery applies to.
        }
      }
      vehicleId: String(1,50)? with {
        briefly "Vehicle id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      driverName: String(1,100)? with {
        briefly "Driver name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      timestamp: TimeStamp? with {
        briefly "Timestamp"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MarkedOutForDelivery"
      described as {
        |Instructs this repository to apply MarkedOutForDelivery to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPickupRecorded is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row PickupRecorded applies to.
        }
      }
      pickedUpAt: TimeStamp? with {
        briefly "Picked up at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      location: String(1,200)? with {
        briefly "Location"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PickupRecorded"
      described as {
        |Instructs this repository to apply PickupRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnInitiated is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnInitiated applies to.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      initiatedAt: TimeStamp? with {
        briefly "Initiated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReturnInitiated"
      described as {
        |Instructs this repository to apply ReturnInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrackingEventAdded is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrackingEventAdded applies to.
        }
      }
      event: TrackingEvent? with {
        briefly "Event"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TrackingEventAdded"
      described as {
        |Instructs this repository to apply TrackingEventAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryRecorded is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryRecorded applies to.
        }
      }
      deliveredAt: TimeStamp? with {
        briefly "Delivered at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      signedBy: String(1,100)? with {
        briefly "Signed by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DeliveryRecorded"
      described as {
        |Instructs this repository to apply DeliveryRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExceptionReported is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExceptionReported applies to.
        }
      }
      exception: ExceptionInfo? with {
        briefly "Exception"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ExceptionReported"
      described as {
        |Instructs this repository to apply ExceptionReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentCreated is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShipmentCreated applies to.
        }
      }
      trackingNumber: TrackingNumber? with {
        briefly "Tracking number"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      shipper: PartyInfo? with {
        briefly "Shipper"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      consignee: PartyInfo? with {
        briefly "Consignee"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ShipmentCreated"
      described as {
        |Instructs this repository to apply ShipmentCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ShipmentRepositoryResponses is result Shipment.ShipmentResult
    record StoredShipment is {
      shipmentId: ShipmentId with {
        briefly "shipmentId"
        described as {
          |The shipmentId column of the stored shipment row.
        }
      }
      consignee: PartyInfo with {
        briefly "consignee"
        described as {
          |The consignee column of the stored shipment row.
        }
      }
      status: ShipmentStatus with {
        briefly "status"
        described as {
          |The status column of the stored shipment row.
        }
      }
      trackingNumber: TrackingNumber with {
        briefly "trackingNumber"
        described as {
          |The trackingNumber column of the stored shipment row.
        }
      }
      deliveryWindow: DeliveryWindow? with {
        briefly "Delivery window"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      resolution: String(1,500)? with {
        briefly "Resolution"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newStatus: ShipmentStatus? with {
        briefly "New status"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      resolvedAt: TimeStamp? with {
        briefly "Resolved at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      location: String(1,200)? with {
        briefly "Location"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      geoLocation: GeoLocation? with {
        briefly "Geo location"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      timestamp: TimeStamp? with {
        briefly "Timestamp"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      vehicleId: String(1,50)? with {
        briefly "Vehicle id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      driverName: String(1,100)? with {
        briefly "Driver name"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      pickedUpAt: TimeStamp? with {
        briefly "Picked up at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      initiatedAt: TimeStamp? with {
        briefly "Initiated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      event: TrackingEvent? with {
        briefly "Event"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      deliveredAt: TimeStamp? with {
        briefly "Delivered at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      signedBy: String(1,100)? with {
        briefly "Signed by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      exception: ExceptionInfo? with {
        briefly "Exception"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      shipper: PartyInfo? with {
        briefly "Shipper"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored shipment row"
      described as {
        |The persistence shape of shipment data as this repository stores it.
      }
    }
    schema ShipmentData is relational
      of shipments as record StoredShipment
        key on field StoredShipment.shipmentId
        index on field StoredShipment.trackingNumber
        index on field StoredShipment.status
        index on field StoredShipment.consignee.address.postalCode
 with {
      briefly "Shipment data schema"
      described as {
        |The relational schema holding shipment data for the ShipmentRepository.
      }
    }
    handler ShipmentPersistence is {
      on persistETAUpdated: command PersistETAUpdated is {
        update ShipmentData.shipments set deliveryWindow = persistETAUpdated.deliveryWindow, updatedAt = persistETAUpdated.updatedAt where shipmentId == persistETAUpdated.shipmentId
      }
      on persistExceptionResolved: command PersistExceptionResolved is {
        update ShipmentData.shipments set resolution = persistExceptionResolved.resolution, newStatus = persistExceptionResolved.newStatus, resolvedAt = persistExceptionResolved.resolvedAt where shipmentId == persistExceptionResolved.shipmentId
      }
      on persistLocationUpdated: command PersistLocationUpdated is {
        update ShipmentData.shipments set location = persistLocationUpdated.location, geoLocation = persistLocationUpdated.geoLocation, timestamp = persistLocationUpdated.timestamp where shipmentId == persistLocationUpdated.shipmentId
      }
      on persistMarkedOutForDelivery: command PersistMarkedOutForDelivery is {
        update ShipmentData.shipments set vehicleId = persistMarkedOutForDelivery.vehicleId, driverName = persistMarkedOutForDelivery.driverName, timestamp = persistMarkedOutForDelivery.timestamp where shipmentId == persistMarkedOutForDelivery.shipmentId
      }
      on persistPickupRecorded: command PersistPickupRecorded is {
        update ShipmentData.shipments set pickedUpAt = persistPickupRecorded.pickedUpAt, location = persistPickupRecorded.location where shipmentId == persistPickupRecorded.shipmentId
      }
      on persistReturnInitiated: command PersistReturnInitiated is {
        update ShipmentData.shipments set reason = persistReturnInitiated.reason, initiatedAt = persistReturnInitiated.initiatedAt where shipmentId == persistReturnInitiated.shipmentId
      }
      on persistTrackingEventAdded: command PersistTrackingEventAdded is {
        update ShipmentData.shipments set event = persistTrackingEventAdded.event where shipmentId == persistTrackingEventAdded.shipmentId
      }
      on persistDeliveryRecorded: command PersistDeliveryRecorded is {
        update ShipmentData.shipments set deliveredAt = persistDeliveryRecorded.deliveredAt, signedBy = persistDeliveryRecorded.signedBy where shipmentId == persistDeliveryRecorded.shipmentId
      }
      on persistExceptionReported: command PersistExceptionReported is {
        update ShipmentData.shipments set exception = persistExceptionReported.exception where shipmentId == persistExceptionReported.shipmentId
      }
      on persistShipmentCreated: command PersistShipmentCreated is {
        update ShipmentData.shipments set trackingNumber = persistShipmentCreated.trackingNumber, shipper = persistShipmentCreated.shipper, consignee = persistShipmentCreated.consignee, createdAt = persistShipmentCreated.createdAt where shipmentId == persistShipmentCreated.shipmentId
      }
      on query GetDeliveryMetrics is {
        let deliveryMetricsView: type DeliveryMetricsView = prompt("read the delivery metrics projection")
        reply deliveryMetricsView
      }
    } with {
      briefly "Persists shipment commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Shipment data persistence"
    described as {
      |Persistent storage for shipments.
    }
  }
  query GetDeliveryMetrics replies result DeliveryMetricsView is {
    deliveryMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which delivery metrics to retrieve.
      }
    }
  } with {
    briefly "Get delivery metrics"
    described as {
      |Retrieves the delivery metrics projection.
    }
  }
  result DeliveryMetricsView is {
    deliveryMetrics: ShipmentAnalytics.DeliveryMetrics with {
      briefly "Delivery metrics"
      described as {
        |The delivery metrics being returned.
      }
    }
  } with {
    briefly "Delivery metrics view"
    described as {
      |Read model view carrying the delivery metrics projection.
    }
  }
  projector ShipmentAnalytics as flow is {
    updates repository TrackingContext.ShipmentRepository
    outlet ShipmentAnalyticsToRepository is type ShipmentRepositoryCommand
    inlet ShipmentAnalyticsFromShipment is type ShipmentEvent    record DeliveryMetrics is {
      totalShipments: Natural with {
        briefly "Total"
        described as {
          |Total shipments.
        }
      }
      inTransit: Natural with {
        briefly "In transit"
        described as {
          |Currently in transit.
        }
      }
      deliveredToday: Natural with {
        briefly "Delivered"
        described as {
          |Delivered today.
        }
      }
      onTimeRate: Decimal(5,2) with {
        briefly "On-time"
        described as {
          |On-time delivery rate.
        }
      }
      averageTransitDays: Decimal(5,2) with {
        briefly "Transit time"
        described as {
          |Average transit days.
        }
      }
      exceptionRate: Decimal(5,2) with {
        briefly "Exceptions"
        described as {
          |Exception rate.
        }
      }
    } with {
      briefly "Delivery metrics"
      described as {
        |Delivery performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on eTAUpdated: event Shipment.ETAUpdated is {
        tell command TrackingContext.ShipmentRepository.PersistETAUpdated(shipmentId = eTAUpdated.shipmentId, deliveryWindow = eTAUpdated.deliveryWindow, updatedAt = eTAUpdated.updatedAt) to repository TrackingContext.ShipmentRepository
        do "apply ETAUpdated to the ShipmentAnalytics projection"
      }
      on exceptionResolved: event Shipment.ExceptionResolved is {
        tell command TrackingContext.ShipmentRepository.PersistExceptionResolved(shipmentId = exceptionResolved.shipmentId, resolution = exceptionResolved.resolution, newStatus = exceptionResolved.newStatus, resolvedAt = exceptionResolved.resolvedAt) to repository TrackingContext.ShipmentRepository
        do "apply ExceptionResolved to the ShipmentAnalytics projection"
      }
      on locationUpdated: event Shipment.LocationUpdated is {
        tell command TrackingContext.ShipmentRepository.PersistLocationUpdated(shipmentId = locationUpdated.shipmentId, location = locationUpdated.location, geoLocation = locationUpdated.geoLocation, timestamp = locationUpdated.timestamp) to repository TrackingContext.ShipmentRepository
        do "apply LocationUpdated to the ShipmentAnalytics projection"
      }
      on markedOutForDelivery: event Shipment.MarkedOutForDelivery is {
        tell command TrackingContext.ShipmentRepository.PersistMarkedOutForDelivery(shipmentId = markedOutForDelivery.shipmentId, vehicleId = markedOutForDelivery.vehicleId, driverName = markedOutForDelivery.driverName, timestamp = markedOutForDelivery.timestamp) to repository TrackingContext.ShipmentRepository
        do "apply MarkedOutForDelivery to the ShipmentAnalytics projection"
      }
      on pickupRecorded: event Shipment.PickupRecorded is {
        tell command TrackingContext.ShipmentRepository.PersistPickupRecorded(shipmentId = pickupRecorded.shipmentId, pickedUpAt = pickupRecorded.pickedUpAt, location = pickupRecorded.location) to repository TrackingContext.ShipmentRepository
        do "apply PickupRecorded to the ShipmentAnalytics projection"
      }
      on returnInitiated: event Shipment.ReturnInitiated is {
        tell command TrackingContext.ShipmentRepository.PersistReturnInitiated(shipmentId = returnInitiated.shipmentId, reason = returnInitiated.reason, initiatedAt = returnInitiated.initiatedAt) to repository TrackingContext.ShipmentRepository
        do "apply ReturnInitiated to the ShipmentAnalytics projection"
      }
      on trackingEventAdded: event Shipment.TrackingEventAdded is {
        tell command TrackingContext.ShipmentRepository.PersistTrackingEventAdded(shipmentId = trackingEventAdded.shipmentId, event = trackingEventAdded.event) to repository TrackingContext.ShipmentRepository
        do "apply TrackingEventAdded to the ShipmentAnalytics projection"
      }
      on shipmentCreated: event Shipment.ShipmentCreated is {
        tell command TrackingContext.ShipmentRepository.PersistShipmentCreated(shipmentId = shipmentCreated.shipmentId, trackingNumber = shipmentCreated.trackingNumber, shipper = shipmentCreated.shipper, consignee = shipmentCreated.consignee, createdAt = shipmentCreated.createdAt) to repository TrackingContext.ShipmentRepository
      }
      on deliveryRecorded: event Shipment.DeliveryRecorded is {
        tell command TrackingContext.ShipmentRepository.PersistDeliveryRecorded(shipmentId = deliveryRecorded.shipmentId, deliveredAt = deliveryRecorded.deliveredAt, signedBy = deliveryRecorded.signedBy) to repository TrackingContext.ShipmentRepository
      }
      on exceptionReported: event Shipment.ExceptionReported is {
        tell command TrackingContext.ShipmentRepository.PersistExceptionReported(shipmentId = exceptionReported.shipmentId, exception = exceptionReported.exception) to repository TrackingContext.ShipmentRepository
      }
    } with {
      briefly "Maintains delivery analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Shipment analytics"
    described as {
      |Delivery performance tracking.
    }
  }
  type ShipmentEvent is one of {
    TrackingContext.Shipment.ShipmentCreated or TrackingContext.Shipment.DeliveryRecorded or TrackingContext.Shipment.ExceptionReported or TrackingContext.Shipment.ETAUpdated or TrackingContext.Shipment.ExceptionResolved or TrackingContext.Shipment.LocationUpdated or TrackingContext.Shipment.MarkedOutForDelivery or TrackingContext.Shipment.PickupRecorded or TrackingContext.Shipment.ReturnInitiated or TrackingContext.Shipment.TrackingEventAdded
  } with {
    briefly "Shipment event union"
    described as {
      |Union of Shipment events for streaming.
    }
  }
  streamlet ShipmentEventSplit as split is {
    outlet ShipmentEventSplitToToNotificationService is type ShipmentEvent
    outlet ShipmentEventSplitToToGeolocationService is type ShipmentEvent
    outlet ShipmentEventSplitToToCarrierIntegration is type ShipmentEvent
    inlet ShipmentEventSplitIn is type ShipmentEvent    outlet ShipmentEventSplitToShipmentAnalytics is type ShipmentEvent
    handler ShipmentEventSplitHandler is {
      on shipmentCreated: event Shipment.ShipmentCreated is {
        send shipmentCreated to outlet ShipmentEventSplitToShipmentAnalytics
        send shipmentCreated to outlet ShipmentEventSplitToToGeolocationService
        send shipmentCreated to outlet ShipmentEventSplitToToCarrierIntegration
        tell shipmentCreated to entity TrackingContext.Shipment
      }
      on pickupRecorded: event Shipment.PickupRecorded is {
        send pickupRecorded to outlet ShipmentEventSplitToShipmentAnalytics
        send pickupRecorded to outlet ShipmentEventSplitToToGeolocationService
        send pickupRecorded to outlet ShipmentEventSplitToToCarrierIntegration
        tell pickupRecorded to entity TrackingContext.Shipment
      }
      on trackingEventAdded: event Shipment.TrackingEventAdded is {
        send trackingEventAdded to outlet ShipmentEventSplitToShipmentAnalytics
        tell trackingEventAdded to entity TrackingContext.Shipment
      }
      on locationUpdated: event Shipment.LocationUpdated is {
        send locationUpdated to outlet ShipmentEventSplitToShipmentAnalytics
        tell locationUpdated to entity TrackingContext.Shipment
      }
      on eTAUpdated: event Shipment.ETAUpdated is {
        send eTAUpdated to outlet ShipmentEventSplitToShipmentAnalytics
        send eTAUpdated to outlet ShipmentEventSplitToToNotificationService
        tell eTAUpdated to entity TrackingContext.Shipment
      }
      on markedOutForDelivery: event Shipment.MarkedOutForDelivery is {
        send markedOutForDelivery to outlet ShipmentEventSplitToShipmentAnalytics
        send markedOutForDelivery to outlet ShipmentEventSplitToToNotificationService
        tell markedOutForDelivery to entity TrackingContext.Shipment
      }
      on deliveryRecorded: event Shipment.DeliveryRecorded is {
        send deliveryRecorded to outlet ShipmentEventSplitToShipmentAnalytics
        send deliveryRecorded to outlet ShipmentEventSplitToToNotificationService
        tell deliveryRecorded to entity TrackingContext.Shipment
      }
      on exceptionReported: event Shipment.ExceptionReported is {
        send exceptionReported to outlet ShipmentEventSplitToShipmentAnalytics
        send exceptionReported to outlet ShipmentEventSplitToToNotificationService
        tell exceptionReported to entity TrackingContext.Shipment
      }
      on exceptionResolved: event Shipment.ExceptionResolved is {
        send exceptionResolved to outlet ShipmentEventSplitToShipmentAnalytics
        send exceptionResolved to outlet ShipmentEventSplitToToNotificationService
        tell exceptionResolved to entity TrackingContext.Shipment
      }
      on returnInitiated: event Shipment.ReturnInitiated is {
        send returnInitiated to outlet ShipmentEventSplitToShipmentAnalytics
        send returnInitiated to outlet ShipmentEventSplitToToNotificationService
        tell returnInitiated to entity TrackingContext.Shipment
      }
      on other is {
        error "Unexpected message for processor ShipmentEventSplit"
      }
    } with {
      briefly "Shipment event fan-out handler"
      described as {
        |Delivers each Shipment event to all of its consumers.
      }
    }
  } with {
    briefly "Shipment event fan-out"
    described as {
      |Fans Shipment events out to the repository and projectors.
    }
  }
  connector 'ToNotificationService Feed' is from outlet TrackingContext.ShipmentEventSplit.ShipmentEventSplitToToNotificationService to inlet TrackingContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The Shipment events ToNotificationService translates, on their way to it"
  }
  connector 'ToGeolocationService Feed' is from outlet TrackingContext.ShipmentEventSplit.ShipmentEventSplitToToGeolocationService to inlet TrackingContext.ToGeolocationService.ToGeolocationServiceIn with {
    briefly "The Shipment events ToGeolocationService translates, on their way to it"
  }
  connector 'ToCarrierIntegration Feed' is from outlet TrackingContext.ShipmentEventSplit.ShipmentEventSplitToToCarrierIntegration to inlet TrackingContext.ToCarrierIntegration.ToCarrierIntegrationIn with {
    briefly "The Shipment events ToCarrierIntegration translates, on their way to it"
  }
  connector 'ShipmentStreamEvent Stream' is from outlet TrackingContext.Shipment.ShipmentEvents2 to inlet TrackingContext.ShipmentEventSplit.ShipmentEventSplitIn with {
    briefly "Shipment events, fanned out to storage and read models"
  }
  connector 'ShipmentAnalytics Feed' is from outlet TrackingContext.ShipmentEventSplit.ShipmentEventSplitToShipmentAnalytics to inlet TrackingContext.ShipmentAnalytics.ShipmentAnalyticsFromShipment with {
    briefly "Shipment events feeding the ShipmentAnalytics projection"
  }
  connector 'ShipmentAnalytics Storage' is from outlet TrackingContext.ShipmentAnalytics.ShipmentAnalyticsToRepository to inlet TrackingContext.ShipmentRepository.ShipmentRepositoryFromShipmentAnalytics with {
    briefly "ShipmentAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for shipment tracking"
  described as {
    |Freight visibility context.
  }
}
