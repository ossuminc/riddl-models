// Shipment Tracking - Tracking Context
context TrackingContext is {
  include "types.riddl"
  include "Shipment.riddl"
  repository ShipmentRepository is {
    inlet ShipmentRepositoryFromShipment is type ShipmentEvent
    inlet ShipmentRepositoryFromShipmentAnalytics is type ShipmentEvent
    outlet ShipmentRepositoryResponses is type Shipment.ShipmentResult
    schema ShipmentData is relational
      of shipments as type Shipment
        index on field Shipment.trackingNumber
        index on field Shipment.status
        index on field Shipment.consignee.address.postalCode
      with {
      briefly "Shipment data schema"
      described as {
        |The relational schema holding shipment data for the ShipmentRepository.
      }
    }

    handler ShipmentPersistence is {
      on command Shipment.CreateShipment is {
        tell event Shipment.ShipmentCreated to entity TrackingContext.Shipment
      }
      on command Shipment.RecordPickup is {
        tell event Shipment.PickupRecorded to entity TrackingContext.Shipment
      }
      on command Shipment.AddTrackingEvent is {
        tell event Shipment.TrackingEventAdded to entity TrackingContext.Shipment
      }
      on command Shipment.UpdateLocation is {
        tell event Shipment.LocationUpdated to entity TrackingContext.Shipment
      }
      on command Shipment.UpdateETA is {
        tell event Shipment.ETAUpdated to entity TrackingContext.Shipment
      }
      on command Shipment.RecordDelivery is {
        tell event Shipment.DeliveryRecorded to entity TrackingContext.Shipment
      }
      on command Shipment.ReportException is {
        tell event Shipment.ExceptionReported to entity TrackingContext.Shipment
      }
    } with {
      briefly "Persists shipment commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Shipment data persistence"
    described as {
      |Persistent storage for shipments.
    }
  }
  projector ShipmentAnalytics is {
    inlet ShipmentAnalyticsFromShipment is type ShipmentEvent
    outlet ShipmentAnalyticsOut is type ShipmentEvent
    updates repository TrackingContext.ShipmentRepository
    record DeliveryMetrics is  {
      totalShipments: Natural with {
        briefly "Total"
        described as {
          |Total shipments.
        }
      }
      inTransit: Natural with {
        briefly "In transit"
        described as {
          |Currently in transit.
        }
      }
      deliveredToday: Natural with {
        briefly "Delivered"
        described as {
          |Delivered today.
        }
      }
      onTimeRate: Decimal(5,2) with {
        briefly "On-time"
        described as {
          |On-time delivery rate.
        }
      }
      averageTransitDays: Decimal(5,2) with {
        briefly "Transit time"
        described as {
          |Average transit days.
        }
      }
      exceptionRate: Decimal(5,2) with {
        briefly "Exceptions"
        described as {
          |Exception rate.
        }
      }
    } with {
      briefly "Delivery metrics"
      described as {
        |Delivery performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Shipment.ShipmentCreated is {
        tell event Shipment.ShipmentCreated to repository TrackingContext.ShipmentRepository
      }
      on event Shipment.DeliveryRecorded is {
        tell event Shipment.DeliveryRecorded to repository TrackingContext.ShipmentRepository
      }
      on event Shipment.ExceptionReported is {
        tell event Shipment.ExceptionReported to repository TrackingContext.ShipmentRepository
      }
    } with {
      briefly "Maintains delivery analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Shipment analytics"
    described as {
      |Delivery performance tracking.
    }
  }
  type ShipmentEvent is one of {
    TrackingContext.Shipment.ShipmentCreated,
    TrackingContext.Shipment.DeliveryRecorded,
    TrackingContext.Shipment.ExceptionReported
  } with {
    briefly "Shipment event union"
    described as {
      |Union of Shipment events for streaming.
    }
  }
  processor ShipmentEventSource as source is {
    outlet ShipmentEvents is type ShipmentEvent
    handler ShipmentEventEmitter is {
      on init is { tell command Shipment.InitializeShipment to entity TrackingContext.Shipment }
      on other is {
        error "Unexpected message for source ShipmentEventSource"
      }
      on event Shipment.ShipmentCreated is {
        send event Shipment.ShipmentCreated to outlet ShipmentEvents
      }
      on event Shipment.DeliveryRecorded is {
        send event Shipment.DeliveryRecorded to outlet ShipmentEvents
      }
      on event Shipment.ExceptionReported is {
        send event Shipment.ExceptionReported to outlet ShipmentEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits Shipment events to the stream.
      }
    }
  } with {
    briefly "Shipment event source"
    described as {
      |Publishes Shipment events to the event stream.
    }
  }
  processor ShipmentEventSink as sink is {
    inlet IncomingShipmentEvents is type ShipmentEvent
    handler ShipmentEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink ShipmentEventSink"
      }
      on event Shipment.ShipmentCreated is {
        tell event Shipment.ShipmentCreated to repository TrackingContext.ShipmentRepository
      }
      on event Shipment.DeliveryRecorded is {
        tell event Shipment.DeliveryRecorded to repository TrackingContext.ShipmentRepository
      }
      on event Shipment.ExceptionReported is {
        tell event Shipment.ExceptionReported to repository TrackingContext.ShipmentRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives Shipment events for persistence.
      }
    }
  } with {
    briefly "Shipment event sink"
    described as {
      |Receives Shipment events from streaming.
    }
  }
  connector ShipmentEventPipeline is {
    from outlet TrackingContext.ShipmentEventSource.ShipmentEvents to inlet TrackingContext.ShipmentEventSink.IncomingShipmentEvents
  } with {
    briefly "Shipment event pipeline"
    described as {
      |Wires Shipment event source to sink.
    }
  }
  processor ShipmentEventSplit is {
    inlet ShipmentEventSplitIn is type ShipmentEvent
    outlet ShipmentEventSplitToShipmentRepository is type ShipmentEvent
    outlet ShipmentEventSplitToShipmentAnalytics is type ShipmentEvent
    handler ShipmentEventSplitHandler is {
      on event Shipment.ShipmentCreated is {
        send event Shipment.ShipmentCreated to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.ShipmentCreated to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.ShipmentCreated to entity TrackingContext.Shipment
      }
      on event Shipment.PickupRecorded is {
        send event Shipment.PickupRecorded to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.PickupRecorded to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.PickupRecorded to entity TrackingContext.Shipment
      }
      on event Shipment.TrackingEventAdded is {
        send event Shipment.TrackingEventAdded to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.TrackingEventAdded to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.TrackingEventAdded to entity TrackingContext.Shipment
      }
      on event Shipment.LocationUpdated is {
        send event Shipment.LocationUpdated to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.LocationUpdated to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.LocationUpdated to entity TrackingContext.Shipment
      }
      on event Shipment.ETAUpdated is {
        send event Shipment.ETAUpdated to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.ETAUpdated to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.ETAUpdated to entity TrackingContext.Shipment
      }
      on event Shipment.MarkedOutForDelivery is {
        send event Shipment.MarkedOutForDelivery to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.MarkedOutForDelivery to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.MarkedOutForDelivery to entity TrackingContext.Shipment
      }
      on event Shipment.DeliveryRecorded is {
        send event Shipment.DeliveryRecorded to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.DeliveryRecorded to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.DeliveryRecorded to entity TrackingContext.Shipment
      }
      on event Shipment.ExceptionReported is {
        send event Shipment.ExceptionReported to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.ExceptionReported to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.ExceptionReported to entity TrackingContext.Shipment
      }
      on event Shipment.ExceptionResolved is {
        send event Shipment.ExceptionResolved to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.ExceptionResolved to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.ExceptionResolved to entity TrackingContext.Shipment
      }
      on event Shipment.ReturnInitiated is {
        send event Shipment.ReturnInitiated to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.ReturnInitiated to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.ReturnInitiated to entity TrackingContext.Shipment
      }
      on other is {
        error "Unexpected message for processor ShipmentEventSplit"
      }
    } with {
      briefly "Shipment event fan-out handler"
      described as {
        |Delivers each Shipment event to all of its consumers.
      }
    }
  } with {
    briefly "Shipment event fan-out"
    described as {
      |Fans Shipment events out to the repository and projectors.
    }
  }
  connector LinkShipmentToShipmentEventSplit is {
    from outlet TrackingContext.Shipment.ShipmentEvents2 to
      inlet TrackingContext.ShipmentEventSplit.ShipmentEventSplitIn
  } with {
    briefly "LinkShipmentToShipmentEventSplit"
  }
  connector LinkShipmentEventSplitToShipmentRepository is {
    from outlet TrackingContext.ShipmentEventSplit.ShipmentEventSplitToShipmentRepository to
      inlet TrackingContext.ShipmentRepository.ShipmentRepositoryFromShipment
  } with {
    briefly "LinkShipmentEventSplitToShipmentRepository"
  }
  connector LinkShipmentEventSplitToShipmentAnalytics is {
    from outlet TrackingContext.ShipmentEventSplit.ShipmentEventSplitToShipmentAnalytics to
      inlet TrackingContext.ShipmentAnalytics.ShipmentAnalyticsFromShipment
  } with {
    briefly "LinkShipmentEventSplitToShipmentAnalytics"
  }
  connector LinkShipmentAnalyticsToShipmentRepository is {
    from outlet TrackingContext.ShipmentAnalytics.ShipmentAnalyticsOut to
      inlet TrackingContext.ShipmentRepository.ShipmentRepositoryFromShipmentAnalytics
  } with {
    briefly "LinkShipmentAnalyticsToShipmentRepository"
  }
} with {
  briefly "Bounded context for shipment tracking"
  described as {
    |Freight visibility context.
  }
}
