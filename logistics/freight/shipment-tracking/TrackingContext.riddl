// Shipment Tracking - Tracking Context
context TrackingContext is {
  adaptor FromCarrierIntegration from context CarrierIntegration is { 
    handler FromCarrierIntegrationHandler is {
      on event CarrierIntegration.PickupScheduled is {
        do "the model receives pickup scheduled"
      }
      on event CarrierIntegration.TrackingUpdateReceived is {
        do "the model receives tracking update received"
      }
      on other is {
        error "Unexpected message for adaptor FromCarrierIntegration"
      }
    } with {
      briefly "from carrier integration"
      described as {
        |Carries messages from the external CarrierIntegration.
      }
    }
  } with {
    briefly "CarrierIntegration integration"
    described as {
      |The model's side of the CarrierIntegration conversation.
    }
  }
  adaptor ToCarrierIntegration to context CarrierIntegration is { 
    handler ToCarrierIntegrationHandler is {
      on command CarrierIntegration.GetTrackingUpdate is {
        do "the model sends get tracking update"
      }
      on command CarrierIntegration.RequestPickup is {
        do "the model sends request pickup"
      }
      on other is {
        error "Unexpected message for adaptor ToCarrierIntegration"
      }
    } with {
      briefly "to carrier integration"
      described as {
        |Carries messages to the external CarrierIntegration.
      }
    }
  } with {
    briefly "CarrierIntegration integration"
    described as {
      |The model's side of the CarrierIntegration conversation.
    }
  }
  adaptor FromGeolocationService from context GeolocationService is { 
    handler FromGeolocationServiceHandler is {
      on event GeolocationService.AddressGeocoded is {
        do "the model receives address geocoded"
      }
      on event GeolocationService.RouteCalculated is {
        do "the model receives route calculated"
      }
      on other is {
        error "Unexpected message for adaptor FromGeolocationService"
      }
    } with {
      briefly "from geolocation service"
      described as {
        |Carries messages from the external GeolocationService.
      }
    }
  } with {
    briefly "GeolocationService integration"
    described as {
      |The model's side of the GeolocationService conversation.
    }
  }
  adaptor ToGeolocationService to context GeolocationService is { 
    handler ToGeolocationServiceHandler is {
      on command GeolocationService.CalculateRoute is {
        do "the model sends calculate route"
      }
      on command GeolocationService.GeocodeAddress is {
        do "the model sends geocode address"
      }
      on other is {
        error "Unexpected message for adaptor ToGeolocationService"
      }
    } with {
      briefly "to geolocation service"
      described as {
        |Carries messages to the external GeolocationService.
      }
    }
  } with {
    briefly "GeolocationService integration"
    described as {
      |The model's side of the GeolocationService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendShipmentNotification is {
        do "the model sends send shipment notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "Shipment.riddl"
  repository ShipmentRepository is {
    inlet ShipmentRepositoryFromShipment is type ShipmentEvent    inlet ShipmentRepositoryFromShipmentAnalytics is type ShipmentEvent    outlet ShipmentRepositoryResponses is type Shipment.ShipmentResult
    record StoredShipment is  {
      shipmentId: ShipmentId with {
        briefly "shipmentId"
        described as {
          |The shipmentId column of the stored shipment row.
        }
      }
      consignee: PartyInfo with {
        briefly "consignee"
        described as {
          |The consignee column of the stored shipment row.
        }
      }
      status: ShipmentStatus with {
        briefly "status"
        described as {
          |The status column of the stored shipment row.
        }
      }
      trackingNumber: TrackingNumber with {
        briefly "trackingNumber"
        described as {
          |The trackingNumber column of the stored shipment row.
        }
      }
    } with {
      briefly "Stored shipment row"
      described as {
        |The persistence shape of shipment data as this repository stores it.
      }
    }
    schema ShipmentData is relational
      of shipments as type StoredShipment
        index on field StoredShipment.trackingNumber
        index on field StoredShipment.status
        index on field StoredShipment.consignee.address.postalCode
 with {
      briefly "Shipment data schema"
      described as {
        |The relational schema holding shipment data for the ShipmentRepository.
      }
    }
    handler ShipmentPersistence is {
      on query GetDeliveryMetrics is {
        do "read the delivery metrics projection"
        yield result DeliveryMetricsView
      }
      on command Shipment.CreateShipment is {
        tell event Shipment.ShipmentCreated to entity TrackingContext.Shipment
      }
      on command Shipment.RecordPickup is {
        tell event Shipment.PickupRecorded to entity TrackingContext.Shipment
      }
      on command Shipment.AddTrackingEvent is {
        tell event Shipment.TrackingEventAdded to entity TrackingContext.Shipment
      }
      on command Shipment.UpdateLocation is {
        tell event Shipment.LocationUpdated to entity TrackingContext.Shipment
      }
      on command Shipment.UpdateETA is {
        tell event Shipment.ETAUpdated to entity TrackingContext.Shipment
      }
      on command Shipment.RecordDelivery is {
        tell event Shipment.DeliveryRecorded to entity TrackingContext.Shipment
      }
      on command Shipment.ReportException is {
        tell event Shipment.ExceptionReported to entity TrackingContext.Shipment
      }
    } with {
      briefly "Persists shipment commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Shipment data persistence"
    described as {
      |Persistent storage for shipments.
    }
  }
  query GetDeliveryMetrics is  {
    deliveryMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which delivery metrics to retrieve.
      }
    }
  } with {
    briefly "Get delivery metrics"
    described as {
      |Retrieves the delivery metrics projection.
    }
  }
  result DeliveryMetricsView is  {
    deliveryMetrics: ShipmentAnalytics.DeliveryMetrics with {
      briefly "Delivery metrics"
      described as {
        |The delivery metrics being returned.
      }
    }
  } with {
    briefly "Delivery metrics view"
    described as {
      |Read model view carrying the delivery metrics projection.
    }
  }
  projector ShipmentAnalytics is {
    updates repository TrackingContext.ShipmentRepository
    inlet ShipmentAnalyticsFromShipment is type ShipmentEvent    outlet ShipmentAnalyticsOut is type ShipmentEvent
    record DeliveryMetrics is  {
      totalShipments: Natural with {
        briefly "Total"
        described as {
          |Total shipments.
        }
      }
      inTransit: Natural with {
        briefly "In transit"
        described as {
          |Currently in transit.
        }
      }
      deliveredToday: Natural with {
        briefly "Delivered"
        described as {
          |Delivered today.
        }
      }
      onTimeRate: Decimal(5,2) with {
        briefly "On-time"
        described as {
          |On-time delivery rate.
        }
      }
      averageTransitDays: Decimal(5,2) with {
        briefly "Transit time"
        described as {
          |Average transit days.
        }
      }
      exceptionRate: Decimal(5,2) with {
        briefly "Exceptions"
        described as {
          |Exception rate.
        }
      }
    } with {
      briefly "Delivery metrics"
      described as {
        |Delivery performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Shipment.ShipmentCreated is {
        tell event Shipment.ShipmentCreated to repository TrackingContext.ShipmentRepository
      }
      on event Shipment.DeliveryRecorded is {
        tell event Shipment.DeliveryRecorded to repository TrackingContext.ShipmentRepository
      }
      on event Shipment.ExceptionReported is {
        tell event Shipment.ExceptionReported to repository TrackingContext.ShipmentRepository
      }
    } with {
      briefly "Maintains delivery analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Shipment analytics"
    described as {
      |Delivery performance tracking.
    }
  }
  type ShipmentEvent is one of {
    TrackingContext.Shipment.ShipmentCreated or TrackingContext.Shipment.DeliveryRecorded or TrackingContext.Shipment.ExceptionReported
  } with {
    briefly "Shipment event union"
    described as {
      |Union of Shipment events for streaming.
    }
  }
  processor ShipmentEventSource as source is {
    outlet ShipmentEvents is type ShipmentEvent
    handler ShipmentEventEmitter is {
      on init is {
        tell command Shipment.InitializeShipment to entity TrackingContext.Shipment
      }
      on other is {
        error "Unexpected message for source ShipmentEventSource"
      }
      on event Shipment.ShipmentCreated is {
        send event Shipment.ShipmentCreated to outlet ShipmentEvents
      }
      on event Shipment.DeliveryRecorded is {
        send event Shipment.DeliveryRecorded to outlet ShipmentEvents
      }
      on event Shipment.ExceptionReported is {
        send event Shipment.ExceptionReported to outlet ShipmentEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits Shipment events to the stream.
      }
    }
  } with {
    briefly "Shipment event source"
    described as {
      |Publishes Shipment events to the event stream.
    }
  }
  processor ShipmentEventSink as sink is {
    inlet IncomingShipmentEvents is type ShipmentEvent    handler ShipmentEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink ShipmentEventSink"
      }
      on event Shipment.ShipmentCreated is {
        tell event Shipment.ShipmentCreated to repository TrackingContext.ShipmentRepository
      }
      on event Shipment.DeliveryRecorded is {
        tell event Shipment.DeliveryRecorded to repository TrackingContext.ShipmentRepository
      }
      on event Shipment.ExceptionReported is {
        tell event Shipment.ExceptionReported to repository TrackingContext.ShipmentRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives Shipment events for persistence.
      }
    }
  } with {
    briefly "Shipment event sink"
    described as {
      |Receives Shipment events from streaming.
    }
  }
  connector ShipmentEventPipeline is from outlet TrackingContext.ShipmentEventSource.ShipmentEvents to inlet TrackingContext.ShipmentEventSink.IncomingShipmentEvents with {
    briefly "Shipment event pipeline"
    described as {
      |Wires Shipment event source to sink.
    }
  }
  processor ShipmentEventSplit is {
    inlet ShipmentEventSplitIn is type ShipmentEvent    outlet ShipmentEventSplitToShipmentRepository is type ShipmentEvent
    outlet ShipmentEventSplitToShipmentAnalytics is type ShipmentEvent
    handler ShipmentEventSplitHandler is {
      on event Shipment.ShipmentCreated is {
        send event Shipment.ShipmentCreated to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.ShipmentCreated to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.ShipmentCreated to entity TrackingContext.Shipment
      }
      on event Shipment.PickupRecorded is {
        send event Shipment.PickupRecorded to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.PickupRecorded to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.PickupRecorded to entity TrackingContext.Shipment
      }
      on event Shipment.TrackingEventAdded is {
        send event Shipment.TrackingEventAdded to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.TrackingEventAdded to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.TrackingEventAdded to entity TrackingContext.Shipment
      }
      on event Shipment.LocationUpdated is {
        send event Shipment.LocationUpdated to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.LocationUpdated to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.LocationUpdated to entity TrackingContext.Shipment
      }
      on event Shipment.ETAUpdated is {
        send event Shipment.ETAUpdated to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.ETAUpdated to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.ETAUpdated to entity TrackingContext.Shipment
      }
      on event Shipment.MarkedOutForDelivery is {
        send event Shipment.MarkedOutForDelivery to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.MarkedOutForDelivery to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.MarkedOutForDelivery to entity TrackingContext.Shipment
      }
      on event Shipment.DeliveryRecorded is {
        send event Shipment.DeliveryRecorded to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.DeliveryRecorded to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.DeliveryRecorded to entity TrackingContext.Shipment
      }
      on event Shipment.ExceptionReported is {
        send event Shipment.ExceptionReported to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.ExceptionReported to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.ExceptionReported to entity TrackingContext.Shipment
      }
      on event Shipment.ExceptionResolved is {
        send event Shipment.ExceptionResolved to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.ExceptionResolved to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.ExceptionResolved to entity TrackingContext.Shipment
      }
      on event Shipment.ReturnInitiated is {
        send event Shipment.ReturnInitiated to outlet ShipmentEventSplitToShipmentRepository
        send event Shipment.ReturnInitiated to outlet ShipmentEventSplitToShipmentAnalytics
        tell event Shipment.ReturnInitiated to entity TrackingContext.Shipment
      }
      on other is {
        error "Unexpected message for processor ShipmentEventSplit"
      }
    } with {
      briefly "Shipment event fan-out handler"
      described as {
        |Delivers each Shipment event to all of its consumers.
      }
    }
  } with {
    briefly "Shipment event fan-out"
    described as {
      |Fans Shipment events out to the repository and projectors.
    }
  }
  connector ShipmentEventStream is from outlet TrackingContext.Shipment.ShipmentEvents2 to inlet TrackingContext.ShipmentEventSplit.ShipmentEventSplitIn with {
    briefly "Shipment events, fanned out to storage and read models"
  }
  connector ShipmentEventStorage is from outlet TrackingContext.ShipmentEventSplit.ShipmentEventSplitToShipmentRepository to inlet TrackingContext.ShipmentRepository.ShipmentRepositoryFromShipment with {
    briefly "Shipment events on their way to storage"
  }
  connector ShipmentAnalyticsFeed is from outlet TrackingContext.ShipmentEventSplit.ShipmentEventSplitToShipmentAnalytics to inlet TrackingContext.ShipmentAnalytics.ShipmentAnalyticsFromShipment with {
    briefly "Shipment events feeding the ShipmentAnalytics projection"
  }
  connector ShipmentAnalyticsStorage is from outlet TrackingContext.ShipmentAnalytics.ShipmentAnalyticsOut to inlet TrackingContext.ShipmentRepository.ShipmentRepositoryFromShipmentAnalytics with {
    briefly "The ShipmentAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for shipment tracking"
  described as {
    |Freight visibility context.
  }
}
