// Shipment Tracking - Tracking Context
context TrackingContext as router is {
  inlet ShipmentCommandStreamIn is type ShipmentCommand  outlet ShipmentCommandStreamOut is type ShipmentCommand
  inlet ShipmentResultStreamIn is type Shipment.ShipmentResult  outlet ShipmentResultStreamOut is type Shipment.ShipmentResult
  handler TrackingContextBoundary is {
    on createShipment: command Shipment.CreateShipment is {
      send createShipment to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on recordPickup: command Shipment.RecordPickup is {
      send recordPickup to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on addTrackingEvent: command Shipment.AddTrackingEvent is {
      send addTrackingEvent to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on updateLocation: command Shipment.UpdateLocation is {
      send updateLocation to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on updateETA: command Shipment.UpdateETA is {
      send updateETA to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on markOutForDelivery: command Shipment.MarkOutForDelivery is {
      send markOutForDelivery to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on recordDelivery: command Shipment.RecordDelivery is {
      send recordDelivery to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on reportException: command Shipment.ReportException is {
      send reportException to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on resolveException: command Shipment.ResolveException is {
      send resolveException to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on initiateReturn: command Shipment.InitiateReturn is {
      send initiateReturn to outlet TrackingContext.ShipmentCommandStreamOut
    }
    on shipmentResult: result Shipment.ShipmentResult is {
      send shipmentResult to outlet TrackingContext.ShipmentResultStreamOut
    }
    on other is {
      error "Unexpected message at the TrackingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ShipmentCommand Stream Intake' is from outlet TrackingContext.ShipmentCommandStreamOut to inlet TrackingContext.Shipment.ShipmentCommands  connector 'ShipmentResult Stream Egress' is from outlet TrackingContext.ShipmentRepository.ShipmentRepositoryResponses to inlet TrackingContext.ShipmentResultStreamIn  adaptor FromCarrierIntegration from context CarrierIntegration is { 
    handler FromCarrierIntegrationHandler is {
      on event CarrierIntegration.PickupScheduled is {
        do "the model receives pickup scheduled"
      }
      on event CarrierIntegration.TrackingUpdateReceived is {
        do "the model receives tracking update received"
      }
      on other is {
        error "Unexpected message for adaptor FromCarrierIntegration"
      }
    } with {
      briefly "from carrier integration"
      described as {
        |Carries messages from the external CarrierIntegration.
      }
    }
  } with {
    briefly "CarrierIntegration integration"
    described as {
      |The model's side of the CarrierIntegration conversation.
    }
  }
  adaptor ToCarrierIntegration to context CarrierIntegration is { 
    handler ToCarrierIntegrationHandler is {
      on command CarrierIntegration.GetTrackingUpdate is {
        do "the model sends get tracking update"
      }
      on command CarrierIntegration.RequestPickup is {
        do "the model sends request pickup"
      }
      on other is {
        error "Unexpected message for adaptor ToCarrierIntegration"
      }
    } with {
      briefly "to carrier integration"
      described as {
        |Carries messages to the external CarrierIntegration.
      }
    }
  } with {
    briefly "CarrierIntegration integration"
    described as {
      |The model's side of the CarrierIntegration conversation.
    }
  }
  adaptor FromGeolocationService from context GeolocationService is { 
    handler FromGeolocationServiceHandler is {
      on event GeolocationService.AddressGeocoded is {
        do "the model receives address geocoded"
      }
      on event GeolocationService.RouteCalculated is {
        do "the model receives route calculated"
      }
      on other is {
        error "Unexpected message for adaptor FromGeolocationService"
      }
    } with {
      briefly "from geolocation service"
      described as {
        |Carries messages from the external GeolocationService.
      }
    }
  } with {
    briefly "GeolocationService integration"
    described as {
      |The model's side of the GeolocationService conversation.
    }
  }
  adaptor ToGeolocationService to context GeolocationService is { 
    handler ToGeolocationServiceHandler is {
      on command GeolocationService.CalculateRoute is {
        do "the model sends calculate route"
      }
      on command GeolocationService.GeocodeAddress is {
        do "the model sends geocode address"
      }
      on other is {
        error "Unexpected message for adaptor ToGeolocationService"
      }
    } with {
      briefly "to geolocation service"
      described as {
        |Carries messages to the external GeolocationService.
      }
    }
  } with {
    briefly "GeolocationService integration"
    described as {
      |The model's side of the GeolocationService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendShipmentNotification is {
        do "the model sends send shipment notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "Shipment.riddl"
  type ShipmentRepositoryCommand is one of {
    TrackingContext.ShipmentRepository.PersistDeliveryRecorded or TrackingContext.ShipmentRepository.PersistETAUpdated or TrackingContext.ShipmentRepository.PersistExceptionReported or TrackingContext.ShipmentRepository.PersistExceptionResolved or TrackingContext.ShipmentRepository.PersistLocationUpdated or TrackingContext.ShipmentRepository.PersistMarkedOutForDelivery or TrackingContext.ShipmentRepository.PersistPickupRecorded or TrackingContext.ShipmentRepository.PersistReturnInitiated or TrackingContext.ShipmentRepository.PersistShipmentCreated or TrackingContext.ShipmentRepository.PersistTrackingEventAdded
  } with {
    briefly "Anything that writes ShipmentRepository"
    described as {
      |The persistence commands ShipmentRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ShipmentRepository as flow is {
    inlet ShipmentRepositoryFromShipmentAnalytics is type ShipmentRepositoryCommand
    command PersistETAUpdated is  {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ETAUpdated applies to.
        }
      }
    } with {
      briefly "Persist ETAUpdated"
      described as {
        |Instructs this repository to apply ETAUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExceptionResolved is  {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExceptionResolved applies to.
        }
      }
    } with {
      briefly "Persist ExceptionResolved"
      described as {
        |Instructs this repository to apply ExceptionResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLocationUpdated is  {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row LocationUpdated applies to.
        }
      }
    } with {
      briefly "Persist LocationUpdated"
      described as {
        |Instructs this repository to apply LocationUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMarkedOutForDelivery is  {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row MarkedOutForDelivery applies to.
        }
      }
    } with {
      briefly "Persist MarkedOutForDelivery"
      described as {
        |Instructs this repository to apply MarkedOutForDelivery to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPickupRecorded is  {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row PickupRecorded applies to.
        }
      }
    } with {
      briefly "Persist PickupRecorded"
      described as {
        |Instructs this repository to apply PickupRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnInitiated is  {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnInitiated applies to.
        }
      }
    } with {
      briefly "Persist ReturnInitiated"
      described as {
        |Instructs this repository to apply ReturnInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrackingEventAdded is  {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrackingEventAdded applies to.
        }
      }
    } with {
      briefly "Persist TrackingEventAdded"
      described as {
        |Instructs this repository to apply TrackingEventAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryRecorded is  {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryRecorded applies to.
        }
      }
    } with {
      briefly "Persist DeliveryRecorded"
      described as {
        |Instructs this repository to apply DeliveryRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExceptionReported is  {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExceptionReported applies to.
        }
      }
    } with {
      briefly "Persist ExceptionReported"
      described as {
        |Instructs this repository to apply ExceptionReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentCreated is  {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShipmentCreated applies to.
        }
      }
    } with {
      briefly "Persist ShipmentCreated"
      described as {
        |Instructs this repository to apply ShipmentCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ShipmentRepositoryResponses is type Shipment.ShipmentResult
    record StoredShipment is  {
      shipmentId: ShipmentId with {
        briefly "shipmentId"
        described as {
          |The shipmentId column of the stored shipment row.
        }
      }
      consignee: PartyInfo with {
        briefly "consignee"
        described as {
          |The consignee column of the stored shipment row.
        }
      }
      status: ShipmentStatus with {
        briefly "status"
        described as {
          |The status column of the stored shipment row.
        }
      }
      trackingNumber: TrackingNumber with {
        briefly "trackingNumber"
        described as {
          |The trackingNumber column of the stored shipment row.
        }
      }
    } with {
      briefly "Stored shipment row"
      described as {
        |The persistence shape of shipment data as this repository stores it.
      }
    }
    schema ShipmentData is relational
      of shipments as type StoredShipment
        index on field StoredShipment.trackingNumber
        index on field StoredShipment.status
        index on field StoredShipment.consignee.address.postalCode
 with {
      briefly "Shipment data schema"
      described as {
        |The relational schema holding shipment data for the ShipmentRepository.
      }
    }
    handler ShipmentPersistence is {
      on persistETAUpdated: command PersistETAUpdated is {
        do "apply ETAUpdated to the stored row"
      }
      on persistExceptionResolved: command PersistExceptionResolved is {
        do "apply ExceptionResolved to the stored row"
      }
      on persistLocationUpdated: command PersistLocationUpdated is {
        do "apply LocationUpdated to the stored row"
      }
      on persistMarkedOutForDelivery: command PersistMarkedOutForDelivery is {
        do "apply MarkedOutForDelivery to the stored row"
      }
      on persistPickupRecorded: command PersistPickupRecorded is {
        do "apply PickupRecorded to the stored row"
      }
      on persistReturnInitiated: command PersistReturnInitiated is {
        do "apply ReturnInitiated to the stored row"
      }
      on persistTrackingEventAdded: command PersistTrackingEventAdded is {
        do "apply TrackingEventAdded to the stored row"
      }
      on persistDeliveryRecorded: command PersistDeliveryRecorded is {
        do "apply DeliveryRecorded to the stored row"
      }
      on persistExceptionReported: command PersistExceptionReported is {
        do "apply ExceptionReported to the stored row"
      }
      on persistShipmentCreated: command PersistShipmentCreated is {
        do "apply ShipmentCreated to the stored row"
      }
      on query GetDeliveryMetrics is {
        let deliveryMetricsView: type DeliveryMetricsView = prompt("read the delivery metrics projection")
        reply deliveryMetricsView
      }
    } with {
      briefly "Persists shipment commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Shipment data persistence"
    described as {
      |Persistent storage for shipments.
    }
  }
  query GetDeliveryMetrics replies result DeliveryMetricsView is  {
    deliveryMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which delivery metrics to retrieve.
      }
    }
  } with {
    briefly "Get delivery metrics"
    described as {
      |Retrieves the delivery metrics projection.
    }
  }
  result DeliveryMetricsView is  {
    deliveryMetrics: ShipmentAnalytics.DeliveryMetrics with {
      briefly "Delivery metrics"
      described as {
        |The delivery metrics being returned.
      }
    }
  } with {
    briefly "Delivery metrics view"
    described as {
      |Read model view carrying the delivery metrics projection.
    }
  }
  projector ShipmentAnalytics as flow is {
    outlet ShipmentAnalyticsToRepository is type ShipmentRepositoryCommand
    updates repository TrackingContext.ShipmentRepository
    inlet ShipmentAnalyticsFromShipment is type ShipmentEvent
    record DeliveryMetrics is  {
      totalShipments: Natural with {
        briefly "Total"
        described as {
          |Total shipments.
        }
      }
      inTransit: Natural with {
        briefly "In transit"
        described as {
          |Currently in transit.
        }
      }
      deliveredToday: Natural with {
        briefly "Delivered"
        described as {
          |Delivered today.
        }
      }
      onTimeRate: Decimal(5,2) with {
        briefly "On-time"
        described as {
          |On-time delivery rate.
        }
      }
      averageTransitDays: Decimal(5,2) with {
        briefly "Transit time"
        described as {
          |Average transit days.
        }
      }
      exceptionRate: Decimal(5,2) with {
        briefly "Exceptions"
        described as {
          |Exception rate.
        }
      }
    } with {
      briefly "Delivery metrics"
      described as {
        |Delivery performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on eTAUpdated: event Shipment.ETAUpdated is {
        tell command TrackingContext.ShipmentRepository.PersistETAUpdated(shipmentId = eTAUpdated.shipmentId) to repository TrackingContext.ShipmentRepository
        do "apply ETAUpdated to the ShipmentAnalytics projection"
      }
      on exceptionResolved: event Shipment.ExceptionResolved is {
        tell command TrackingContext.ShipmentRepository.PersistExceptionResolved(shipmentId = exceptionResolved.shipmentId) to repository TrackingContext.ShipmentRepository
        do "apply ExceptionResolved to the ShipmentAnalytics projection"
      }
      on locationUpdated: event Shipment.LocationUpdated is {
        tell command TrackingContext.ShipmentRepository.PersistLocationUpdated(shipmentId = locationUpdated.shipmentId) to repository TrackingContext.ShipmentRepository
        do "apply LocationUpdated to the ShipmentAnalytics projection"
      }
      on markedOutForDelivery: event Shipment.MarkedOutForDelivery is {
        tell command TrackingContext.ShipmentRepository.PersistMarkedOutForDelivery(shipmentId = markedOutForDelivery.shipmentId) to repository TrackingContext.ShipmentRepository
        do "apply MarkedOutForDelivery to the ShipmentAnalytics projection"
      }
      on pickupRecorded: event Shipment.PickupRecorded is {
        tell command TrackingContext.ShipmentRepository.PersistPickupRecorded(shipmentId = pickupRecorded.shipmentId) to repository TrackingContext.ShipmentRepository
        do "apply PickupRecorded to the ShipmentAnalytics projection"
      }
      on returnInitiated: event Shipment.ReturnInitiated is {
        tell command TrackingContext.ShipmentRepository.PersistReturnInitiated(shipmentId = returnInitiated.shipmentId) to repository TrackingContext.ShipmentRepository
        do "apply ReturnInitiated to the ShipmentAnalytics projection"
      }
      on trackingEventAdded: event Shipment.TrackingEventAdded is {
        tell command TrackingContext.ShipmentRepository.PersistTrackingEventAdded(shipmentId = trackingEventAdded.shipmentId) to repository TrackingContext.ShipmentRepository
        do "apply TrackingEventAdded to the ShipmentAnalytics projection"
      }
      on shipmentCreated: event Shipment.ShipmentCreated is {
        tell command TrackingContext.ShipmentRepository.PersistShipmentCreated(shipmentId = shipmentCreated.shipmentId) to repository TrackingContext.ShipmentRepository
      }
      on deliveryRecorded: event Shipment.DeliveryRecorded is {
        tell command TrackingContext.ShipmentRepository.PersistDeliveryRecorded(shipmentId = deliveryRecorded.shipmentId) to repository TrackingContext.ShipmentRepository
      }
      on exceptionReported: event Shipment.ExceptionReported is {
        tell command TrackingContext.ShipmentRepository.PersistExceptionReported(shipmentId = exceptionReported.shipmentId) to repository TrackingContext.ShipmentRepository
      }
    } with {
      briefly "Maintains delivery analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Shipment analytics"
    described as {
      |Delivery performance tracking.
    }
  }
  type ShipmentEvent is one of {
    TrackingContext.Shipment.ShipmentCreated or TrackingContext.Shipment.DeliveryRecorded or TrackingContext.Shipment.ExceptionReported or TrackingContext.Shipment.ETAUpdated or TrackingContext.Shipment.ExceptionResolved or TrackingContext.Shipment.LocationUpdated or TrackingContext.Shipment.MarkedOutForDelivery or TrackingContext.Shipment.PickupRecorded or TrackingContext.Shipment.ReturnInitiated or TrackingContext.Shipment.TrackingEventAdded
  } with {
    briefly "Shipment event union"
    described as {
      |Union of Shipment events for streaming.
    }
  }
  processor ShipmentEventSplit as flow is {
    inlet ShipmentEventSplitIn is type ShipmentEvent
    outlet ShipmentEventSplitToShipmentAnalytics is type ShipmentEvent
    handler ShipmentEventSplitHandler is {
      on shipmentCreated: event Shipment.ShipmentCreated is {
        send shipmentCreated to outlet ShipmentEventSplitToShipmentAnalytics
        tell shipmentCreated to entity TrackingContext.Shipment
      }
      on pickupRecorded: event Shipment.PickupRecorded is {
        send pickupRecorded to outlet ShipmentEventSplitToShipmentAnalytics
        tell pickupRecorded to entity TrackingContext.Shipment
      }
      on trackingEventAdded: event Shipment.TrackingEventAdded is {
        send trackingEventAdded to outlet ShipmentEventSplitToShipmentAnalytics
        tell trackingEventAdded to entity TrackingContext.Shipment
      }
      on locationUpdated: event Shipment.LocationUpdated is {
        send locationUpdated to outlet ShipmentEventSplitToShipmentAnalytics
        tell locationUpdated to entity TrackingContext.Shipment
      }
      on eTAUpdated: event Shipment.ETAUpdated is {
        send eTAUpdated to outlet ShipmentEventSplitToShipmentAnalytics
        tell eTAUpdated to entity TrackingContext.Shipment
      }
      on markedOutForDelivery: event Shipment.MarkedOutForDelivery is {
        send markedOutForDelivery to outlet ShipmentEventSplitToShipmentAnalytics
        tell markedOutForDelivery to entity TrackingContext.Shipment
      }
      on deliveryRecorded: event Shipment.DeliveryRecorded is {
        send deliveryRecorded to outlet ShipmentEventSplitToShipmentAnalytics
        tell deliveryRecorded to entity TrackingContext.Shipment
      }
      on exceptionReported: event Shipment.ExceptionReported is {
        send exceptionReported to outlet ShipmentEventSplitToShipmentAnalytics
        tell exceptionReported to entity TrackingContext.Shipment
      }
      on exceptionResolved: event Shipment.ExceptionResolved is {
        send exceptionResolved to outlet ShipmentEventSplitToShipmentAnalytics
        tell exceptionResolved to entity TrackingContext.Shipment
      }
      on returnInitiated: event Shipment.ReturnInitiated is {
        send returnInitiated to outlet ShipmentEventSplitToShipmentAnalytics
        tell returnInitiated to entity TrackingContext.Shipment
      }
      on other is {
        error "Unexpected message for processor ShipmentEventSplit"
      }
    } with {
      briefly "Shipment event fan-out handler"
      described as {
        |Delivers each Shipment event to all of its consumers.
      }
    }
  } with {
    briefly "Shipment event fan-out"
    described as {
      |Fans Shipment events out to the repository and projectors.
    }
  }
  connector 'ShipmentStreamEvent Stream' is from outlet TrackingContext.Shipment.ShipmentEvents2 to inlet TrackingContext.ShipmentEventSplit.ShipmentEventSplitIn with {
    briefly "Shipment events, fanned out to storage and read models"
  }
  connector 'ShipmentAnalytics Feed' is from outlet TrackingContext.ShipmentEventSplit.ShipmentEventSplitToShipmentAnalytics to inlet TrackingContext.ShipmentAnalytics.ShipmentAnalyticsFromShipment with {
    briefly "Shipment events feeding the ShipmentAnalytics projection"
  }
  connector 'ShipmentAnalytics Storage' is from outlet TrackingContext.ShipmentAnalytics.ShipmentAnalyticsToRepository to inlet TrackingContext.ShipmentRepository.ShipmentRepositoryFromShipmentAnalytics with {
    briefly "ShipmentAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for shipment tracking"
  described as {
    |Freight visibility context.
  }
}
