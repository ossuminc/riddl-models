// Shipment Tracking Domain Model
// Freight shipment visibility and tracking
domain ShipmentTracking is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Shipper is "person or company sending goods" with {
    briefly "Shipper"
    described as {
      |Party originating the shipment.
    }
  }
  user Consignee is "person or company receiving goods" with {
    briefly "Consignee"
    described as {
      |Party receiving the shipment.
    }
  }
  user Carrier is "person or company transporting goods" with {
    briefly "Carrier"
    described as {
      |Party providing transportation services.
    }
  }
  epic ShipmentVisibility is {
    user Shipper wants to "to track shipment location and status" so that "delivery progress is visible in real-time"
    case TrackShipment is {
      user Shipper wants to "to view current shipment location" so that "they can monitor delivery progress"
      step is "User queries" "shipment status" "by tracking number" with {
        briefly "Query status"
        described as {
          |Look up shipment.
        }
      }
      step is "System returns" "current location" "and ETA" with {
        briefly "Return location"
        described as {
          |Show tracking info.
        }
      }
    } with {
      briefly "Track shipment"
      described as {
        |Real-time shipment tracking.
      }
    }
  } with {
    briefly "Shipment visibility"
    described as {
      |Epic for tracking shipments.
    }
  }
  include "TrackingContext.riddl"
  include "external-contexts.riddl"
  application context ShipmentTrackingApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ShipmentTracking are delivered.
      }
    }
    outlet AppShipmentCommands is type TrackingContext.Shipment.ShipmentCommand
    inlet AppShipmentRepositoryResponses is type TrackingContext.Shipment.ShipmentResult    handler ShipmentTrackingAppHandler is {
      on other is {
        error "Unexpected message for application context ShipmentTrackingApp"
      }
    } with {
      briefly "ShipmentTrackingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ShipmentTrackingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'ShipmentCommand Stream' is from outlet ShipmentTrackingApp.AppShipmentCommands to inlet TrackingContext.Shipment.ShipmentCommands with {
    option persistent()
    briefly "Shipment commands from the application"
  }
  connector 'ShipmentResult Stream' is from outlet TrackingContext.ShipmentRepository.ShipmentRepositoryResponses to inlet ShipmentTrackingApp.AppShipmentRepositoryResponses with {
    option persistent()
    briefly "Shipment query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ShipmentTrackingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Shipment tracking domain"
  described as {
    |Freight shipment visibility and tracking.
  }
}
