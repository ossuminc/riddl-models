// Farm Management - Farm Context
context FarmContext is {
  adaptor FromMarketPricing from context MarketPricing is { 
    handler FromMarketPricingHandler is {
      on result MarketPricing.CropPrice is {
        do "the model receives crop price"
      }
      on result MarketPricing.PriceForecast is {
        do "the model receives price forecast"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketPricing"
      }
    } with {
      briefly "from market pricing"
      described as {
        |Carries messages from the external MarketPricing.
      }
    }
  } with {
    briefly "MarketPricing integration"
    described as {
      |The model's side of the MarketPricing conversation.
    }
  }
  adaptor ToMarketPricing to context MarketPricing is { 
    handler ToMarketPricingHandler is {
      on query MarketPricing.GetCropPrice is {
        do "the model sends get crop price"
      }
      on query MarketPricing.GetPriceForecast is {
        do "the model sends get price forecast"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketPricing"
      }
    } with {
      briefly "to market pricing"
      described as {
        |Carries messages to the external MarketPricing.
      }
    }
  } with {
    briefly "MarketPricing integration"
    described as {
      |The model's side of the MarketPricing conversation.
    }
  }
  adaptor FromWeatherService from context WeatherService is { 
    handler FromWeatherServiceHandler is {
      on result WeatherService.HistoricalWeather is {
        do "the model receives historical weather"
      }
      on result WeatherService.WeatherForecast is {
        do "the model receives weather forecast"
      }
      on other is {
        error "Unexpected message for adaptor FromWeatherService"
      }
    } with {
      briefly "from weather service"
      described as {
        |Carries messages from the external WeatherService.
      }
    }
  } with {
    briefly "WeatherService integration"
    described as {
      |The model's side of the WeatherService conversation.
    }
  }
  adaptor ToWeatherService to context WeatherService is { 
    handler ToWeatherServiceHandler is {
      on query WeatherService.GetForecast is {
        do "the model sends get forecast"
      }
      on query WeatherService.GetHistoricalWeather is {
        do "the model sends get historical weather"
      }
      on other is {
        error "Unexpected message for adaptor ToWeatherService"
      }
    } with {
      briefly "to weather service"
      described as {
        |Carries messages to the external WeatherService.
      }
    }
  } with {
    briefly "WeatherService integration"
    described as {
      |The model's side of the WeatherService conversation.
    }
  }
  include "types.riddl"
  include "FarmField.riddl"
  repository FarmRepository is {
    inlet FarmRepositoryFromFarmField is type FarmFieldEvent    inlet FarmRepositoryFromFarmMetrics is type FarmFieldEvent    outlet FarmRepositoryResponses is type FarmField.FarmFieldResult
    record StoredFarmField is  {
      farmFieldId: FarmFieldId with {
        briefly "farmFieldId"
        described as {
          |The farmFieldId column of the stored farmField row.
        }
      }
      fieldId: FarmFieldId with {
        briefly "fieldId"
        described as {
          |The fieldId column of the stored farmField row.
        }
      }
      fieldInfo: FieldInfo with {
        briefly "fieldInfo"
        described as {
          |The fieldInfo column of the stored farmField row.
        }
      }
      status: FieldStatus with {
        briefly "status"
        described as {
          |The status column of the stored farmField row.
        }
      }
    } with {
      briefly "Stored farmField row"
      described as {
        |The persistence shape of farmField data as this repository stores it.
      }
    }
    schema FarmData is relational
      of farmFields as type StoredFarmField
        index on field StoredFarmField.fieldId
        index on field StoredFarmField.fieldInfo.farmId
        index on field StoredFarmField.status
 with {
      briefly "Farm data schema"
      described as {
        |The relational schema holding farm data for the FarmRepository.
      }
    }
    handler FarmPersistence is {
      on query GetFieldMetrics is {
        do "read the field metrics projection"
        yield result FieldMetricsView
      }
      on command FarmField.CreateField is {
        tell event FarmField.FieldCreated to entity FarmContext.FarmField
        do "Store new farm field"
      }
      on command FarmField.SchedulePlanting is {
        tell event FarmField.PlantingScheduled to entity FarmContext.FarmField
        do "Store planting plan for field"
      }
      on command FarmField.RecordPlanting is {
        tell event FarmField.PlantingRecorded to entity FarmContext.FarmField
        do "Update field to planted status"
      }
      on command FarmField.RecordSoilReading is {
        tell event FarmField.SoilReadingRecorded to entity FarmContext.FarmField
        do "Append soil reading to field"
      }
      on command FarmField.CompleteIrrigation is {
        tell event FarmField.IrrigationCompleted to entity FarmContext.FarmField
        do "Record irrigation completion"
      }
      on command FarmField.RecordHarvest is {
        tell event FarmField.HarvestRecorded to entity FarmContext.FarmField
        do "Store harvest results"
      }
      on command FarmField.SetFieldFallow is {
        tell event FarmField.FieldSetFallow to entity FarmContext.FarmField
        do "Update field to fallow status"
      }
    } with {
      briefly "Persists farm commands"
      described as {
        |Handles command-driven persistence for farm data.
      }
    }
  } with {
    briefly "Farm data persistence"
    described as {
      |Persistent storage for farm field data.
    }
  }
  query GetFieldMetrics is  {
    fieldMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which field metrics to retrieve.
      }
    }
  } with {
    briefly "Get field metrics"
    described as {
      |Retrieves the field metrics projection.
    }
  }
  result FieldMetricsView is  {
    fieldMetrics: FarmMetrics.FieldMetrics with {
      briefly "Field metrics"
      described as {
        |The field metrics being returned.
      }
    }
  } with {
    briefly "Field metrics view"
    described as {
      |Read model view carrying the field metrics projection.
    }
  }
  projector FarmMetrics is {
    updates repository FarmContext.FarmRepository
    inlet FarmMetricsFromFarmField is type FarmFieldEvent    outlet FarmMetricsOut is type FarmFieldEvent
    record FieldMetrics is  {
      totalFields: Natural with {
        briefly "Total"
        described as {
          |Total fields registered.
        }
      }
      fieldsPlanted: Natural with {
        briefly "Planted"
        described as {
          |Fields currently planted.
        }
      }
      fieldsHarvested: Natural with {
        briefly "Harvested"
        described as {
          |Fields harvested this season.
        }
      }
      fieldsFallow: Natural with {
        briefly "Fallow"
        described as {
          |Fields currently fallow.
        }
      }
      averageYieldKgPerHa: Decimal(10,2) with {
        briefly "Avg yield"
        described as {
          |Average yield in kg per hectare.
        }
      }
      totalWaterUsageLiters: Decimal(14,2) with {
        briefly "Water usage"
        described as {
          |Total water usage in liters.
        }
      }
    } with {
      briefly "Field metrics"
      described as {
        |Farm field operational metrics.
      }
    }
    handler MetricsHandler is {
      on event FarmField.FieldCreated is {
        tell event FarmField.FieldCreated to repository FarmContext.FarmRepository
        do "Increment total fields count"
      }
      on event FarmField.PlantingRecorded is {
        tell event FarmField.PlantingRecorded to repository FarmContext.FarmRepository
        do "Increment fields planted count"
      }
      on event FarmField.IrrigationCompleted is {
        tell event FarmField.IrrigationCompleted to repository FarmContext.FarmRepository
        do "Add water volume to total usage"
      }
      on event FarmField.HarvestRecorded is {
        tell event FarmField.HarvestRecorded to repository FarmContext.FarmRepository
        do "Increment fields harvested and update average yield"
      }
      on event FarmField.FieldSetFallow is {
        tell event FarmField.FieldSetFallow to repository FarmContext.FarmRepository
        do "Increment fields fallow count"
      }
    } with {
      briefly "Maintains farm metrics"
      described as {
        |Projects events into farm operational metrics.
      }
    }
  } with {
    briefly "Farm metrics"
    described as {
      |Farm operations analytics and yield tracking.
    }
  }
  // ---- Event publication for FarmField ----
  type FarmFieldEvent is one of {
    FarmContext.FarmField.FieldCreated or FarmContext.FarmField.PlantingScheduled or FarmContext.FarmField.PlantingRecorded or FarmContext.FarmField.SoilReadingRecorded or FarmContext.FarmField.IrrigationScheduled or FarmContext.FarmField.IrrigationCompleted or FarmContext.FarmField.EquipmentAssigned or FarmContext.FarmField.EquipmentReleased or FarmContext.FarmField.HarvestPlanned or FarmContext.FarmField.HarvestRecorded or FarmContext.FarmField.FieldSetFallow
  } with {
    briefly "FarmField event alternation"
    described as {
      |Union of all FarmField events, for streaming and event-sourced
      |persistence.
    }
  }
  processor FarmFieldEventSource as source is {
    outlet FarmFieldEvents is type FarmFieldEvent
    handler FarmFieldSourceHandler is {
      on event FarmField.FieldCreated is {
        send event FarmField.FieldCreated to outlet FarmFieldEvents
      }
      on event FarmField.PlantingScheduled is {
        send event FarmField.PlantingScheduled to outlet FarmFieldEvents
      }
      on event FarmField.PlantingRecorded is {
        send event FarmField.PlantingRecorded to outlet FarmFieldEvents
      }
      on event FarmField.SoilReadingRecorded is {
        send event FarmField.SoilReadingRecorded to outlet FarmFieldEvents
      }
      on event FarmField.IrrigationScheduled is {
        send event FarmField.IrrigationScheduled to outlet FarmFieldEvents
      }
      on event FarmField.IrrigationCompleted is {
        send event FarmField.IrrigationCompleted to outlet FarmFieldEvents
      }
      on event FarmField.EquipmentAssigned is {
        send event FarmField.EquipmentAssigned to outlet FarmFieldEvents
      }
      on event FarmField.EquipmentReleased is {
        send event FarmField.EquipmentReleased to outlet FarmFieldEvents
      }
      on event FarmField.HarvestPlanned is {
        send event FarmField.HarvestPlanned to outlet FarmFieldEvents
      }
      on event FarmField.HarvestRecorded is {
        send event FarmField.HarvestRecorded to outlet FarmFieldEvents
      }
      on event FarmField.FieldSetFallow is {
        send event FarmField.FieldSetFallow to outlet FarmFieldEvents
      }
      on other is {
        error "Unexpected message for source FarmFieldEventSource"
      }
    } with {
      briefly "FarmField source handler"
      described as {
        |Publishes FarmField events onto the outlet.
      }
    }
  } with {
    briefly "FarmField event source"
    described as {
      |Publishes FarmField entity events into the streaming topology.
    }
  }
  processor FarmFieldEventSink as sink is {
    inlet FarmFieldInlet is type FarmFieldEvent    handler FarmFieldSinkHandler is {
      on event FarmField.FieldCreated is {
        tell event FarmField.FieldCreated to repository FarmContext.FarmRepository
      }
      on event FarmField.PlantingScheduled is {
        tell event FarmField.PlantingScheduled to repository FarmContext.FarmRepository
      }
      on event FarmField.PlantingRecorded is {
        tell event FarmField.PlantingRecorded to repository FarmContext.FarmRepository
      }
      on event FarmField.SoilReadingRecorded is {
        tell event FarmField.SoilReadingRecorded to repository FarmContext.FarmRepository
      }
      on event FarmField.IrrigationScheduled is {
        tell event FarmField.IrrigationScheduled to repository FarmContext.FarmRepository
      }
      on event FarmField.IrrigationCompleted is {
        tell event FarmField.IrrigationCompleted to repository FarmContext.FarmRepository
      }
      on event FarmField.EquipmentAssigned is {
        tell event FarmField.EquipmentAssigned to repository FarmContext.FarmRepository
      }
      on event FarmField.EquipmentReleased is {
        tell event FarmField.EquipmentReleased to repository FarmContext.FarmRepository
      }
      on event FarmField.HarvestPlanned is {
        tell event FarmField.HarvestPlanned to repository FarmContext.FarmRepository
      }
      on event FarmField.HarvestRecorded is {
        tell event FarmField.HarvestRecorded to repository FarmContext.FarmRepository
      }
      on event FarmField.FieldSetFallow is {
        tell event FarmField.FieldSetFallow to repository FarmContext.FarmRepository
      }
      on other is {
        error "Unexpected message for sink FarmFieldEventSink"
      }
    } with {
      briefly "FarmField sink handler"
      described as {
        |Persists FarmField events via the repository.
      }
    }
  } with {
    briefly "FarmField event sink"
    described as {
      |Receives FarmField events for persistence.
    }
  }
  connector FarmFieldEventFlow is from outlet FarmContext.FarmFieldEventSource.FarmFieldEvents to inlet FarmContext.FarmFieldEventSink.FarmFieldInlet with {
    briefly "FarmField event flow"
    described as {
      |Connects the FarmField source to its sink.
    }
  }
  processor FarmFieldEventSplit is {
    inlet FarmFieldEventSplitIn is type FarmFieldEvent    outlet FarmFieldEventSplitToFarmRepository is type FarmFieldEvent
    outlet FarmFieldEventSplitToFarmMetrics is type FarmFieldEvent
    handler FarmFieldEventSplitHandler is {
      on event FarmField.FieldCreated is {
        send event FarmField.FieldCreated to outlet FarmFieldEventSplitToFarmRepository
        send event FarmField.FieldCreated to outlet FarmFieldEventSplitToFarmMetrics
        tell event FarmField.FieldCreated to entity FarmContext.FarmField
      }
      on event FarmField.PlantingScheduled is {
        send event FarmField.PlantingScheduled to outlet FarmFieldEventSplitToFarmRepository
        send event FarmField.PlantingScheduled to outlet FarmFieldEventSplitToFarmMetrics
        tell event FarmField.PlantingScheduled to entity FarmContext.FarmField
      }
      on event FarmField.PlantingRecorded is {
        send event FarmField.PlantingRecorded to outlet FarmFieldEventSplitToFarmRepository
        send event FarmField.PlantingRecorded to outlet FarmFieldEventSplitToFarmMetrics
        tell event FarmField.PlantingRecorded to entity FarmContext.FarmField
      }
      on event FarmField.SoilReadingRecorded is {
        send event FarmField.SoilReadingRecorded to outlet FarmFieldEventSplitToFarmRepository
        send event FarmField.SoilReadingRecorded to outlet FarmFieldEventSplitToFarmMetrics
        tell event FarmField.SoilReadingRecorded to entity FarmContext.FarmField
      }
      on event FarmField.IrrigationScheduled is {
        send event FarmField.IrrigationScheduled to outlet FarmFieldEventSplitToFarmRepository
        send event FarmField.IrrigationScheduled to outlet FarmFieldEventSplitToFarmMetrics
        tell event FarmField.IrrigationScheduled to entity FarmContext.FarmField
      }
      on event FarmField.IrrigationCompleted is {
        send event FarmField.IrrigationCompleted to outlet FarmFieldEventSplitToFarmRepository
        send event FarmField.IrrigationCompleted to outlet FarmFieldEventSplitToFarmMetrics
        tell event FarmField.IrrigationCompleted to entity FarmContext.FarmField
      }
      on event FarmField.EquipmentAssigned is {
        send event FarmField.EquipmentAssigned to outlet FarmFieldEventSplitToFarmRepository
        send event FarmField.EquipmentAssigned to outlet FarmFieldEventSplitToFarmMetrics
        tell event FarmField.EquipmentAssigned to entity FarmContext.FarmField
      }
      on event FarmField.EquipmentReleased is {
        send event FarmField.EquipmentReleased to outlet FarmFieldEventSplitToFarmRepository
        send event FarmField.EquipmentReleased to outlet FarmFieldEventSplitToFarmMetrics
        tell event FarmField.EquipmentReleased to entity FarmContext.FarmField
      }
      on event FarmField.HarvestPlanned is {
        send event FarmField.HarvestPlanned to outlet FarmFieldEventSplitToFarmRepository
        send event FarmField.HarvestPlanned to outlet FarmFieldEventSplitToFarmMetrics
        tell event FarmField.HarvestPlanned to entity FarmContext.FarmField
      }
      on event FarmField.HarvestRecorded is {
        send event FarmField.HarvestRecorded to outlet FarmFieldEventSplitToFarmRepository
        send event FarmField.HarvestRecorded to outlet FarmFieldEventSplitToFarmMetrics
        tell event FarmField.HarvestRecorded to entity FarmContext.FarmField
      }
      on event FarmField.FieldSetFallow is {
        send event FarmField.FieldSetFallow to outlet FarmFieldEventSplitToFarmRepository
        send event FarmField.FieldSetFallow to outlet FarmFieldEventSplitToFarmMetrics
        tell event FarmField.FieldSetFallow to entity FarmContext.FarmField
      }
      on other is {
        error "Unexpected message for processor FarmFieldEventSplit"
      }
    } with {
      briefly "FarmField event fan-out handler"
      described as {
        |Delivers each FarmField event to all of its consumers.
      }
    }
  } with {
    briefly "FarmField event fan-out"
    described as {
      |Fans FarmField events out to the repository and projectors.
    }
  }
  connector LinkFarmFieldToFarmFieldEventSplit is from outlet FarmContext.FarmField.FarmFieldEvents2 to inlet FarmContext.FarmFieldEventSplit.FarmFieldEventSplitIn with {
    briefly "LinkFarmFieldToFarmFieldEventSplit"
  }
  connector LinkFarmFieldEventSplitToFarmRepository is from outlet FarmContext.FarmFieldEventSplit.FarmFieldEventSplitToFarmRepository to inlet FarmContext.FarmRepository.FarmRepositoryFromFarmField with {
    briefly "LinkFarmFieldEventSplitToFarmRepository"
  }
  connector LinkFarmFieldEventSplitToFarmMetrics is from outlet FarmContext.FarmFieldEventSplit.FarmFieldEventSplitToFarmMetrics to inlet FarmContext.FarmMetrics.FarmMetricsFromFarmField with {
    briefly "LinkFarmFieldEventSplitToFarmMetrics"
  }
  connector LinkFarmMetricsToFarmRepository is from outlet FarmContext.FarmMetrics.FarmMetricsOut to inlet FarmContext.FarmRepository.FarmRepositoryFromFarmMetrics with {
    briefly "LinkFarmMetricsToFarmRepository"
  }
} with {
  briefly "Bounded context for farm management"
  described as {
    |Farm field management bounded context.
  }
}
