// Farm Management - Farm Context
context FarmContext as router is {
  inlet FarmFieldCommandStreamIn is type FarmFieldCommand  outlet FarmFieldCommandStreamOut is type FarmFieldCommand
  inlet FarmFieldResultStreamIn is result FarmField.FarmFieldResult  outlet FarmFieldResultStreamOut is result FarmField.FarmFieldResult
  handler FarmContextBoundary is {
    on createField: command FarmField.CreateField is {
      send createField to outlet FarmContext.FarmFieldCommandStreamOut
    }
    on schedulePlanting: command FarmField.SchedulePlanting is {
      send schedulePlanting to outlet FarmContext.FarmFieldCommandStreamOut
    }
    on recordPlanting: command FarmField.RecordPlanting is {
      send recordPlanting to outlet FarmContext.FarmFieldCommandStreamOut
    }
    on recordSoilReading: command FarmField.RecordSoilReading is {
      send recordSoilReading to outlet FarmContext.FarmFieldCommandStreamOut
    }
    on scheduleIrrigation: command FarmField.ScheduleIrrigation is {
      send scheduleIrrigation to outlet FarmContext.FarmFieldCommandStreamOut
    }
    on completeIrrigation: command FarmField.CompleteIrrigation is {
      send completeIrrigation to outlet FarmContext.FarmFieldCommandStreamOut
    }
    on assignEquipment: command FarmField.AssignEquipment is {
      send assignEquipment to outlet FarmContext.FarmFieldCommandStreamOut
    }
    on releaseEquipment: command FarmField.ReleaseEquipment is {
      send releaseEquipment to outlet FarmContext.FarmFieldCommandStreamOut
    }
    on planHarvest: command FarmField.PlanHarvest is {
      send planHarvest to outlet FarmContext.FarmFieldCommandStreamOut
    }
    on recordHarvest: command FarmField.RecordHarvest is {
      send recordHarvest to outlet FarmContext.FarmFieldCommandStreamOut
    }
    on setFieldFallow: command FarmField.SetFieldFallow is {
      send setFieldFallow to outlet FarmContext.FarmFieldCommandStreamOut
    }
    on farmFieldResult: result FarmField.FarmFieldResult is {
      send farmFieldResult to outlet FarmContext.FarmFieldResultStreamOut
    }
    on other is {
      error "Unexpected message at the FarmContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'FarmFieldCommand Stream Intake' is from outlet FarmContext.FarmFieldCommandStreamOut to inlet FarmContext.FarmField.FarmFieldCommands  connector 'FarmFieldResult Stream Egress' is from outlet FarmContext.FarmRepository.FarmRepositoryResponses to inlet FarmContext.FarmFieldResultStreamIn  adaptor FromMarketPricing from context MarketPricing is { 
    handler FromMarketPricingHandler is {
      on result MarketPricing.CropPrice is {
        do "the model receives crop price"
      }
      on result MarketPricing.PriceForecast is {
        do "the model receives price forecast"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketPricing"
      }
    } with {
      briefly "from market pricing"
      described as {
        |Carries messages from the external MarketPricing.
      }
    }
  } with {
    briefly "MarketPricing integration"
    described as {
      |The model's side of the MarketPricing conversation.
    }
  }
  adaptor ToMarketPricing to context MarketPricing is { 
    handler ToMarketPricingHandler is {
      on query MarketPricing.GetCropPrice is {
        do "the model sends get crop price"
      }
      on query MarketPricing.GetPriceForecast is {
        do "the model sends get price forecast"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketPricing"
      }
    } with {
      briefly "to market pricing"
      described as {
        |Carries messages to the external MarketPricing.
      }
    }
  } with {
    briefly "MarketPricing integration"
    described as {
      |The model's side of the MarketPricing conversation.
    }
  }
  adaptor FromWeatherService from context WeatherService is { 
    handler FromWeatherServiceHandler is {
      on result WeatherService.HistoricalWeather is {
        do "the model receives historical weather"
      }
      on result WeatherService.WeatherForecast is {
        do "the model receives weather forecast"
      }
      on other is {
        error "Unexpected message for adaptor FromWeatherService"
      }
    } with {
      briefly "from weather service"
      described as {
        |Carries messages from the external WeatherService.
      }
    }
  } with {
    briefly "WeatherService integration"
    described as {
      |The model's side of the WeatherService conversation.
    }
  }
  adaptor ToWeatherService to context WeatherService is { 
    handler ToWeatherServiceHandler is {
      on query WeatherService.GetForecast is {
        do "the model sends get forecast"
      }
      on query WeatherService.GetHistoricalWeather is {
        do "the model sends get historical weather"
      }
      on other is {
        error "Unexpected message for adaptor ToWeatherService"
      }
    } with {
      briefly "to weather service"
      described as {
        |Carries messages to the external WeatherService.
      }
    }
  } with {
    briefly "WeatherService integration"
    described as {
      |The model's side of the WeatherService conversation.
    }
  }
  include "types.riddl"
  include "FarmField.riddl"
  type FarmRepositoryCommand is one of {
    FarmContext.FarmRepository.PersistEquipmentAssigned or FarmContext.FarmRepository.PersistEquipmentReleased or FarmContext.FarmRepository.PersistFieldCreated or FarmContext.FarmRepository.PersistFieldSetFallow or FarmContext.FarmRepository.PersistHarvestPlanned or FarmContext.FarmRepository.PersistHarvestRecorded or FarmContext.FarmRepository.PersistIrrigationCompleted or FarmContext.FarmRepository.PersistIrrigationScheduled or FarmContext.FarmRepository.PersistPlantingRecorded or FarmContext.FarmRepository.PersistPlantingScheduled or FarmContext.FarmRepository.PersistSoilReadingRecorded
  } with {
    briefly "Anything that writes FarmRepository"
    described as {
      |The persistence commands FarmRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository FarmRepository as flow is {
    inlet FarmRepositoryFromFarmMetrics is type FarmRepositoryCommand    command PersistEquipmentAssigned is {
      fieldId: FarmFieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row EquipmentAssigned applies to.
        }
      }
    } with {
      briefly "Persist EquipmentAssigned"
      described as {
        |Instructs this repository to apply EquipmentAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEquipmentReleased is {
      fieldId: FarmFieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row EquipmentReleased applies to.
        }
      }
    } with {
      briefly "Persist EquipmentReleased"
      described as {
        |Instructs this repository to apply EquipmentReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHarvestPlanned is {
      fieldId: FarmFieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row HarvestPlanned applies to.
        }
      }
    } with {
      briefly "Persist HarvestPlanned"
      described as {
        |Instructs this repository to apply HarvestPlanned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIrrigationScheduled is {
      fieldId: FarmFieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row IrrigationScheduled applies to.
        }
      }
    } with {
      briefly "Persist IrrigationScheduled"
      described as {
        |Instructs this repository to apply IrrigationScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlantingScheduled is {
      fieldId: FarmFieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlantingScheduled applies to.
        }
      }
    } with {
      briefly "Persist PlantingScheduled"
      described as {
        |Instructs this repository to apply PlantingScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSoilReadingRecorded is {
      fieldId: FarmFieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row SoilReadingRecorded applies to.
        }
      }
    } with {
      briefly "Persist SoilReadingRecorded"
      described as {
        |Instructs this repository to apply SoilReadingRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFieldCreated is {
      fieldId: FarmFieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row FieldCreated applies to.
        }
      }
    } with {
      briefly "Persist FieldCreated"
      described as {
        |Instructs this repository to apply FieldCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFieldSetFallow is {
      fieldId: FarmFieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row FieldSetFallow applies to.
        }
      }
    } with {
      briefly "Persist FieldSetFallow"
      described as {
        |Instructs this repository to apply FieldSetFallow to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHarvestRecorded is {
      fieldId: FarmFieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row HarvestRecorded applies to.
        }
      }
    } with {
      briefly "Persist HarvestRecorded"
      described as {
        |Instructs this repository to apply HarvestRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIrrigationCompleted is {
      fieldId: FarmFieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row IrrigationCompleted applies to.
        }
      }
    } with {
      briefly "Persist IrrigationCompleted"
      described as {
        |Instructs this repository to apply IrrigationCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlantingRecorded is {
      fieldId: FarmFieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlantingRecorded applies to.
        }
      }
    } with {
      briefly "Persist PlantingRecorded"
      described as {
        |Instructs this repository to apply PlantingRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet FarmRepositoryResponses is result FarmField.FarmFieldResult
    record StoredFarmField is {
      farmFieldId: FarmFieldId with {
        briefly "farmFieldId"
        described as {
          |The farmFieldId column of the stored farmField row.
        }
      }
      fieldId: FarmFieldId with {
        briefly "fieldId"
        described as {
          |The fieldId column of the stored farmField row.
        }
      }
      fieldInfo: FieldInfo with {
        briefly "fieldInfo"
        described as {
          |The fieldInfo column of the stored farmField row.
        }
      }
      status: FieldStatus with {
        briefly "status"
        described as {
          |The status column of the stored farmField row.
        }
      }
    } with {
      briefly "Stored farmField row"
      described as {
        |The persistence shape of farmField data as this repository stores it.
      }
    }
    schema FarmData is relational
      of farmFields as record StoredFarmField
        index on field StoredFarmField.fieldId
        index on field StoredFarmField.fieldInfo.farmId
        index on field StoredFarmField.status
 with {
      briefly "Farm data schema"
      described as {
        |The relational schema holding farm data for the FarmRepository.
      }
    }
    handler FarmPersistence is {
      on persistEquipmentAssigned: command PersistEquipmentAssigned is {
        do "apply EquipmentAssigned to the stored row"
      }
      on persistEquipmentReleased: command PersistEquipmentReleased is {
        do "apply EquipmentReleased to the stored row"
      }
      on persistHarvestPlanned: command PersistHarvestPlanned is {
        do "apply HarvestPlanned to the stored row"
      }
      on persistIrrigationScheduled: command PersistIrrigationScheduled is {
        do "apply IrrigationScheduled to the stored row"
      }
      on persistPlantingScheduled: command PersistPlantingScheduled is {
        do "apply PlantingScheduled to the stored row"
      }
      on persistSoilReadingRecorded: command PersistSoilReadingRecorded is {
        do "apply SoilReadingRecorded to the stored row"
      }
      on persistFieldCreated: command PersistFieldCreated is {
        do "apply FieldCreated to the stored row"
      }
      on persistFieldSetFallow: command PersistFieldSetFallow is {
        do "apply FieldSetFallow to the stored row"
      }
      on persistHarvestRecorded: command PersistHarvestRecorded is {
        do "apply HarvestRecorded to the stored row"
      }
      on persistIrrigationCompleted: command PersistIrrigationCompleted is {
        do "apply IrrigationCompleted to the stored row"
      }
      on persistPlantingRecorded: command PersistPlantingRecorded is {
        do "apply PlantingRecorded to the stored row"
      }
      on query GetFieldMetrics is {
        let fieldMetricsView: type FieldMetricsView = prompt("read the field metrics projection")
        reply fieldMetricsView
      }
    } with {
      briefly "Persists farm commands"
      described as {
        |Handles command-driven persistence for farm data.
      }
    }
  } with {
    briefly "Farm data persistence"
    described as {
      |Persistent storage for farm field data.
    }
  }
  query GetFieldMetrics replies result FieldMetricsView is {
    fieldMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which field metrics to retrieve.
      }
    }
  } with {
    briefly "Get field metrics"
    described as {
      |Retrieves the field metrics projection.
    }
  }
  result FieldMetricsView is {
    fieldMetrics: FarmMetrics.FieldMetrics with {
      briefly "Field metrics"
      described as {
        |The field metrics being returned.
      }
    }
  } with {
    briefly "Field metrics view"
    described as {
      |Read model view carrying the field metrics projection.
    }
  }
  projector FarmMetrics as flow is {
    updates repository FarmContext.FarmRepository
    outlet FarmMetricsToRepository is type FarmRepositoryCommand
    inlet FarmMetricsFromFarmField is type FarmFieldEvent    record FieldMetrics is {
      totalFields: Natural with {
        briefly "Total"
        described as {
          |Total fields registered.
        }
      }
      fieldsPlanted: Natural with {
        briefly "Planted"
        described as {
          |Fields currently planted.
        }
      }
      fieldsHarvested: Natural with {
        briefly "Harvested"
        described as {
          |Fields harvested this season.
        }
      }
      fieldsFallow: Natural with {
        briefly "Fallow"
        described as {
          |Fields currently fallow.
        }
      }
      averageYieldKgPerHa: Decimal(10,2) with {
        briefly "Avg yield"
        described as {
          |Average yield in kg per hectare.
        }
      }
      totalWaterUsageLiters: Decimal(14,2) with {
        briefly "Water usage"
        described as {
          |Total water usage in liters.
        }
      }
    } with {
      briefly "Field metrics"
      described as {
        |Farm field operational metrics.
      }
    }
    handler MetricsHandler is {
      on equipmentAssigned: event FarmField.EquipmentAssigned is {
        tell command FarmContext.FarmRepository.PersistEquipmentAssigned(fieldId = equipmentAssigned.fieldId) to repository FarmContext.FarmRepository
        do "apply EquipmentAssigned to the FarmMetrics projection"
      }
      on equipmentReleased: event FarmField.EquipmentReleased is {
        tell command FarmContext.FarmRepository.PersistEquipmentReleased(fieldId = equipmentReleased.fieldId) to repository FarmContext.FarmRepository
        do "apply EquipmentReleased to the FarmMetrics projection"
      }
      on harvestPlanned: event FarmField.HarvestPlanned is {
        tell command FarmContext.FarmRepository.PersistHarvestPlanned(fieldId = harvestPlanned.fieldId) to repository FarmContext.FarmRepository
        do "apply HarvestPlanned to the FarmMetrics projection"
      }
      on irrigationScheduled: event FarmField.IrrigationScheduled is {
        tell command FarmContext.FarmRepository.PersistIrrigationScheduled(fieldId = irrigationScheduled.fieldId) to repository FarmContext.FarmRepository
        do "apply IrrigationScheduled to the FarmMetrics projection"
      }
      on plantingScheduled: event FarmField.PlantingScheduled is {
        tell command FarmContext.FarmRepository.PersistPlantingScheduled(fieldId = plantingScheduled.fieldId) to repository FarmContext.FarmRepository
        do "apply PlantingScheduled to the FarmMetrics projection"
      }
      on soilReadingRecorded: event FarmField.SoilReadingRecorded is {
        tell command FarmContext.FarmRepository.PersistSoilReadingRecorded(fieldId = soilReadingRecorded.fieldId) to repository FarmContext.FarmRepository
        do "apply SoilReadingRecorded to the FarmMetrics projection"
      }
      on fieldCreated: event FarmField.FieldCreated is {
        tell command FarmContext.FarmRepository.PersistFieldCreated(fieldId = fieldCreated.fieldId) to repository FarmContext.FarmRepository
        do "Increment total fields count"
      }
      on plantingRecorded: event FarmField.PlantingRecorded is {
        tell command FarmContext.FarmRepository.PersistPlantingRecorded(fieldId = plantingRecorded.fieldId) to repository FarmContext.FarmRepository
        do "Increment fields planted count"
      }
      on irrigationCompleted: event FarmField.IrrigationCompleted is {
        tell command FarmContext.FarmRepository.PersistIrrigationCompleted(fieldId = irrigationCompleted.fieldId) to repository FarmContext.FarmRepository
        do "Add water volume to total usage"
      }
      on harvestRecorded: event FarmField.HarvestRecorded is {
        tell command FarmContext.FarmRepository.PersistHarvestRecorded(fieldId = harvestRecorded.fieldId) to repository FarmContext.FarmRepository
        do "Increment fields harvested and update average yield"
      }
      on fieldSetFallow: event FarmField.FieldSetFallow is {
        tell command FarmContext.FarmRepository.PersistFieldSetFallow(fieldId = fieldSetFallow.fieldId) to repository FarmContext.FarmRepository
        do "Increment fields fallow count"
      }
    } with {
      briefly "Maintains farm metrics"
      described as {
        |Projects events into farm operational metrics.
      }
    }
  } with {
    briefly "Farm metrics"
    described as {
      |Farm operations analytics and yield tracking.
    }
  }
  // ---- Event publication for FarmField ----
  type FarmFieldEvent is one of {
    FarmContext.FarmField.FieldCreated or FarmContext.FarmField.PlantingScheduled or FarmContext.FarmField.PlantingRecorded or FarmContext.FarmField.SoilReadingRecorded or FarmContext.FarmField.IrrigationScheduled or FarmContext.FarmField.IrrigationCompleted or FarmContext.FarmField.EquipmentAssigned or FarmContext.FarmField.EquipmentReleased or FarmContext.FarmField.HarvestPlanned or FarmContext.FarmField.HarvestRecorded or FarmContext.FarmField.FieldSetFallow
  } with {
    briefly "FarmField event alternation"
    described as {
      |Union of all FarmField events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet FarmFieldEventSplit as flow is {
    inlet FarmFieldEventSplitIn is type FarmFieldEvent    outlet FarmFieldEventSplitToFarmMetrics is type FarmFieldEvent
    handler FarmFieldEventSplitHandler is {
      on fieldCreated: event FarmField.FieldCreated is {
        send fieldCreated to outlet FarmFieldEventSplitToFarmMetrics
        tell fieldCreated to entity FarmContext.FarmField
      }
      on plantingScheduled: event FarmField.PlantingScheduled is {
        send plantingScheduled to outlet FarmFieldEventSplitToFarmMetrics
        tell plantingScheduled to entity FarmContext.FarmField
      }
      on plantingRecorded: event FarmField.PlantingRecorded is {
        send plantingRecorded to outlet FarmFieldEventSplitToFarmMetrics
        tell plantingRecorded to entity FarmContext.FarmField
      }
      on soilReadingRecorded: event FarmField.SoilReadingRecorded is {
        send soilReadingRecorded to outlet FarmFieldEventSplitToFarmMetrics
        tell soilReadingRecorded to entity FarmContext.FarmField
      }
      on irrigationScheduled: event FarmField.IrrigationScheduled is {
        send irrigationScheduled to outlet FarmFieldEventSplitToFarmMetrics
        tell irrigationScheduled to entity FarmContext.FarmField
      }
      on irrigationCompleted: event FarmField.IrrigationCompleted is {
        send irrigationCompleted to outlet FarmFieldEventSplitToFarmMetrics
        tell irrigationCompleted to entity FarmContext.FarmField
      }
      on equipmentAssigned: event FarmField.EquipmentAssigned is {
        send equipmentAssigned to outlet FarmFieldEventSplitToFarmMetrics
        tell equipmentAssigned to entity FarmContext.FarmField
      }
      on equipmentReleased: event FarmField.EquipmentReleased is {
        send equipmentReleased to outlet FarmFieldEventSplitToFarmMetrics
        tell equipmentReleased to entity FarmContext.FarmField
      }
      on harvestPlanned: event FarmField.HarvestPlanned is {
        send harvestPlanned to outlet FarmFieldEventSplitToFarmMetrics
        tell harvestPlanned to entity FarmContext.FarmField
      }
      on harvestRecorded: event FarmField.HarvestRecorded is {
        send harvestRecorded to outlet FarmFieldEventSplitToFarmMetrics
        tell harvestRecorded to entity FarmContext.FarmField
      }
      on fieldSetFallow: event FarmField.FieldSetFallow is {
        send fieldSetFallow to outlet FarmFieldEventSplitToFarmMetrics
        tell fieldSetFallow to entity FarmContext.FarmField
      }
      on other is {
        error "Unexpected message for processor FarmFieldEventSplit"
      }
    } with {
      briefly "FarmField event fan-out handler"
      described as {
        |Delivers each FarmField event to all of its consumers.
      }
    }
  } with {
    briefly "FarmField event fan-out"
    described as {
      |Fans FarmField events out to the repository and projectors.
    }
  }
  connector 'FarmFieldEvent Stream' is from outlet FarmContext.FarmField.FarmFieldEvents2 to inlet FarmContext.FarmFieldEventSplit.FarmFieldEventSplitIn with {
    briefly "FarmField events, fanned out to storage and read models"
  }
  connector 'FarmMetrics Feed' is from outlet FarmContext.FarmFieldEventSplit.FarmFieldEventSplitToFarmMetrics to inlet FarmContext.FarmMetrics.FarmMetricsFromFarmField with {
    briefly "FarmField events feeding the FarmMetrics projection"
  }
  connector 'FarmMetrics Storage' is from outlet FarmContext.FarmMetrics.FarmMetricsToRepository to inlet FarmContext.FarmRepository.FarmRepositoryFromFarmMetrics with {
    briefly "FarmMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for farm management"
  described as {
    |Farm field management bounded context.
  }
}
