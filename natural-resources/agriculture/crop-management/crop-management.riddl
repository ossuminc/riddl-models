// Crop Management Domain Model
// Agricultural crop production and field management
domain CropManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user FarmManager is "person overseeing farm operations" with {
    briefly "Farm Manager"
    described as {
      |Manager coordinating crop production.
    }
  }
  user Agronomist is "person advising on crop practices" with {
    briefly "Agronomist"
    described as {
      |Specialist in crop science.
    }
  }
  user FieldWorker is "person performing field operations" with {
    briefly "Field Worker"
    described as {
      |Worker executing field tasks.
    }
  }
  epic CropProductionManagement is {
    user FarmManager wants to "to manage crop production" so that "yields are maximized and costs controlled"
    case PlanCropSeason is {
      user FarmManager wants to "to plan the growing season" so that "fields are optimally utilized"
      step is "Manager selects" "crops for each field" "based on rotation" with {
        briefly "Select crops"
        described as {
          |Choose crop varieties.
        }
      }
      step is "System schedules" "planting windows" "by field" with {
        briefly "Schedule planting"
        described as {
          |Plan planting dates.
        }
      }
    } with {
      briefly "Plan crop season"
      described as {
        |Planning annual crop production.
      }
    }
  } with {
    briefly "Crop production management"
    described as {
      |Epic for agricultural operations.
    }
  }
  include "CropContext.riddl"
  include "external-contexts.riddl"
  application context CropManagementApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CropManagement are delivered.
      }
    }
    outlet AppFieldCommands is type CropContext.Field.FieldCommand
    inlet AppCropRepositoryResponses is type CropContext.Field.FieldResult    handler CropManagementAppHandler is {
      on other is {
        error "Unexpected message for application context CropManagementApp"
      }
    } with {
      briefly "CropManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CropManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector FieldCommandStream is from outlet CropManagementApp.AppFieldCommands to inlet CropContext.Field.FieldCommands with {
    option persistent()
    briefly "Field commands from the application"
  }
  connector CropQueryResults is from outlet CropContext.CropRepository.CropRepositoryResponses to inlet CropManagementApp.AppCropRepositoryResponses with {
    option persistent()
    briefly "Crop query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CropManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Crop management domain"
  described as {
    |Agricultural crop production management.
  }
}
