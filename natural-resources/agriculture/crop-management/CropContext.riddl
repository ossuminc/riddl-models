// Crop Management - Crop Context
context CropContext as router is {
  inlet FieldCommandStreamIn is type FieldCommand  outlet FieldCommandStreamOut is type FieldCommand
  inlet FieldResultStreamIn is type Field.FieldResult  outlet FieldResultStreamOut is type Field.FieldResult
  handler CropContextBoundary is {
    on registerField: command Field.RegisterField is {
      send registerField to outlet CropContext.FieldCommandStreamOut
    }
    on prepareField: command Field.PrepareField is {
      send prepareField to outlet CropContext.FieldCommandStreamOut
    }
    on plantCrop: command Field.PlantCrop is {
      send plantCrop to outlet CropContext.FieldCommandStreamOut
    }
    on recordApplication: command Field.RecordApplication is {
      send recordApplication to outlet CropContext.FieldCommandStreamOut
    }
    on recordScouting: command Field.RecordScouting is {
      send recordScouting to outlet CropContext.FieldCommandStreamOut
    }
    on recordIrrigation: command Field.RecordIrrigation is {
      send recordIrrigation to outlet CropContext.FieldCommandStreamOut
    }
    on beginHarvest: command Field.BeginHarvest is {
      send beginHarvest to outlet CropContext.FieldCommandStreamOut
    }
    on recordHarvest: command Field.RecordHarvest is {
      send recordHarvest to outlet CropContext.FieldCommandStreamOut
    }
    on completeHarvest: command Field.CompleteHarvest is {
      send completeHarvest to outlet CropContext.FieldCommandStreamOut
    }
    on setFallow: command Field.SetFallow is {
      send setFallow to outlet CropContext.FieldCommandStreamOut
    }
    on fieldResult: result Field.FieldResult is {
      send fieldResult to outlet CropContext.FieldResultStreamOut
    }
    on other is {
      error "Unexpected message at the CropContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'FieldCommand Stream Intake' is from outlet CropContext.FieldCommandStreamOut to inlet CropContext.Field.FieldCommands  connector 'FieldResult Stream Egress' is from outlet CropContext.CropRepository.CropRepositoryResponses to inlet CropContext.FieldResultStreamIn  adaptor FromEquipmentTracking from context EquipmentTracking is { 
    handler FromEquipmentTrackingHandler is {
      on result EquipmentTracking.EquipmentLocation is {
        do "the model receives equipment location"
      }
      on other is {
        error "Unexpected message for adaptor FromEquipmentTracking"
      }
    } with {
      briefly "from equipment tracking"
      described as {
        |Carries messages from the external EquipmentTracking.
      }
    }
  } with {
    briefly "EquipmentTracking integration"
    described as {
      |The model's side of the EquipmentTracking conversation.
    }
  }
  adaptor ToEquipmentTracking to context EquipmentTracking is { 
    handler ToEquipmentTrackingHandler is {
      on query EquipmentTracking.GetEquipmentLocation is {
        do "the model sends get equipment location"
      }
      on other is {
        error "Unexpected message for adaptor ToEquipmentTracking"
      }
    } with {
      briefly "to equipment tracking"
      described as {
        |Carries messages to the external EquipmentTracking.
      }
    }
  } with {
    briefly "EquipmentTracking integration"
    described as {
      |The model's side of the EquipmentTracking conversation.
    }
  }
  adaptor FromMarketPrices from context MarketPrices is { 
    handler FromMarketPricesHandler is {
      on result MarketPrices.CropPriceInfo is {
        do "the model receives crop price info"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketPrices"
      }
    } with {
      briefly "from market prices"
      described as {
        |Carries messages from the external MarketPrices.
      }
    }
  } with {
    briefly "MarketPrices integration"
    described as {
      |The model's side of the MarketPrices conversation.
    }
  }
  adaptor ToMarketPrices to context MarketPrices is { 
    handler ToMarketPricesHandler is {
      on query MarketPrices.GetCropPrices is {
        do "the model sends get crop prices"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketPrices"
      }
    } with {
      briefly "to market prices"
      described as {
        |Carries messages to the external MarketPrices.
      }
    }
  } with {
    briefly "MarketPrices integration"
    described as {
      |The model's side of the MarketPrices conversation.
    }
  }
  adaptor FromSoilTesting from context SoilTesting is { 
    handler FromSoilTestingHandler is {
      on event SoilTesting.SoilResultsReceived is {
        do "the model receives soil results received"
      }
      on other is {
        error "Unexpected message for adaptor FromSoilTesting"
      }
    } with {
      briefly "from soil testing"
      described as {
        |Carries messages from the external SoilTesting.
      }
    }
  } with {
    briefly "SoilTesting integration"
    described as {
      |The model's side of the SoilTesting conversation.
    }
  }
  adaptor ToSoilTesting to context SoilTesting is { 
    handler ToSoilTestingHandler is {
      on command SoilTesting.SubmitSoilSample is {
        do "the model sends submit soil sample"
      }
      on other is {
        error "Unexpected message for adaptor ToSoilTesting"
      }
    } with {
      briefly "to soil testing"
      described as {
        |Carries messages to the external SoilTesting.
      }
    }
  } with {
    briefly "SoilTesting integration"
    described as {
      |The model's side of the SoilTesting conversation.
    }
  }
  adaptor FromWeatherService from context WeatherService is { 
    handler FromWeatherServiceHandler is {
      on result WeatherService.HistoricalWeather is {
        do "the model receives historical weather"
      }
      on result WeatherService.WeatherForecast is {
        do "the model receives weather forecast"
      }
      on other is {
        error "Unexpected message for adaptor FromWeatherService"
      }
    } with {
      briefly "from weather service"
      described as {
        |Carries messages from the external WeatherService.
      }
    }
  } with {
    briefly "WeatherService integration"
    described as {
      |The model's side of the WeatherService conversation.
    }
  }
  adaptor ToWeatherService to context WeatherService is { 
    handler ToWeatherServiceHandler is {
      on query WeatherService.GetForecast is {
        do "the model sends get forecast"
      }
      on query WeatherService.GetHistoricalWeather is {
        do "the model sends get historical weather"
      }
      on other is {
        error "Unexpected message for adaptor ToWeatherService"
      }
    } with {
      briefly "to weather service"
      described as {
        |Carries messages to the external WeatherService.
      }
    }
  } with {
    briefly "WeatherService integration"
    described as {
      |The model's side of the WeatherService conversation.
    }
  }
  include "types.riddl"
  include "Field.riddl"
  type CropRepositoryCommand is one of {
    CropContext.CropRepository.PersistApplicationRecorded or CropContext.CropRepository.PersistCropPlanted or CropContext.CropRepository.PersistFieldPrepared or CropContext.CropRepository.PersistFieldRegistered or CropContext.CropRepository.PersistFieldSetFallow or CropContext.CropRepository.PersistHarvestCompleted or CropContext.CropRepository.PersistHarvestRecorded or CropContext.CropRepository.PersistHarvestStarted or CropContext.CropRepository.PersistIrrigationRecorded or CropContext.CropRepository.PersistScoutingRecorded
  } with {
    briefly "Anything that writes CropRepository"
    described as {
      |The persistence commands CropRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository CropRepository as flow is {
    inlet CropRepositoryFromYieldAnalytics is type CropRepositoryCommand
    command PersistApplicationRecorded is  {
      fieldId: FieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApplicationRecorded applies to.
        }
      }
    } with {
      briefly "Persist ApplicationRecorded"
      described as {
        |Instructs this repository to apply ApplicationRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFieldPrepared is  {
      fieldId: FieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row FieldPrepared applies to.
        }
      }
    } with {
      briefly "Persist FieldPrepared"
      described as {
        |Instructs this repository to apply FieldPrepared to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFieldRegistered is  {
      fieldId: FieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row FieldRegistered applies to.
        }
      }
    } with {
      briefly "Persist FieldRegistered"
      described as {
        |Instructs this repository to apply FieldRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFieldSetFallow is  {
      fieldId: FieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row FieldSetFallow applies to.
        }
      }
    } with {
      briefly "Persist FieldSetFallow"
      described as {
        |Instructs this repository to apply FieldSetFallow to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHarvestRecorded is  {
      fieldId: FieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row HarvestRecorded applies to.
        }
      }
    } with {
      briefly "Persist HarvestRecorded"
      described as {
        |Instructs this repository to apply HarvestRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHarvestStarted is  {
      fieldId: FieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row HarvestStarted applies to.
        }
      }
    } with {
      briefly "Persist HarvestStarted"
      described as {
        |Instructs this repository to apply HarvestStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIrrigationRecorded is  {
      fieldId: FieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row IrrigationRecorded applies to.
        }
      }
    } with {
      briefly "Persist IrrigationRecorded"
      described as {
        |Instructs this repository to apply IrrigationRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistScoutingRecorded is  {
      fieldId: FieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row ScoutingRecorded applies to.
        }
      }
    } with {
      briefly "Persist ScoutingRecorded"
      described as {
        |Instructs this repository to apply ScoutingRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCropPlanted is  {
      fieldId: FieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row CropPlanted applies to.
        }
      }
    } with {
      briefly "Persist CropPlanted"
      described as {
        |Instructs this repository to apply CropPlanted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHarvestCompleted is  {
      fieldId: FieldId with {
        briefly "Row addressed"
        described as {
          |Which stored row HarvestCompleted applies to.
        }
      }
    } with {
      briefly "Persist HarvestCompleted"
      described as {
        |Instructs this repository to apply HarvestCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet CropRepositoryResponses is type Field.FieldResult
    record StoredField is  {
      fieldId: FieldId with {
        briefly "fieldId"
        described as {
          |The fieldId column of the stored field row.
        }
      }
      currentCrop: CropId? with {
        briefly "currentCrop"
        described as {
          |The currentCrop column of the stored field row.
        }
      }
      seasonId: SeasonId with {
        briefly "seasonId"
        described as {
          |The seasonId column of the stored field row.
        }
      }
      status: FieldStatus with {
        briefly "status"
        described as {
          |The status column of the stored field row.
        }
      }
    } with {
      briefly "Stored field row"
      described as {
        |The persistence shape of field data as this repository stores it.
      }
    }
    schema CropData is relational
      of fields as type StoredField
        index on field StoredField.fieldId
        index on field StoredField.seasonId
        index on field StoredField.status
        index on field StoredField.currentCrop
 with {
      briefly "Crop data schema"
      described as {
        |The relational schema holding crop data for the CropRepository.
      }
    }
    handler CropPersistence is {
      on persistApplicationRecorded: command PersistApplicationRecorded is {
        do "apply ApplicationRecorded to the stored row"
      }
      on persistFieldPrepared: command PersistFieldPrepared is {
        do "apply FieldPrepared to the stored row"
      }
      on persistFieldRegistered: command PersistFieldRegistered is {
        do "apply FieldRegistered to the stored row"
      }
      on persistFieldSetFallow: command PersistFieldSetFallow is {
        do "apply FieldSetFallow to the stored row"
      }
      on persistHarvestRecorded: command PersistHarvestRecorded is {
        do "apply HarvestRecorded to the stored row"
      }
      on persistHarvestStarted: command PersistHarvestStarted is {
        do "apply HarvestStarted to the stored row"
      }
      on persistIrrigationRecorded: command PersistIrrigationRecorded is {
        do "apply IrrigationRecorded to the stored row"
      }
      on persistScoutingRecorded: command PersistScoutingRecorded is {
        do "apply ScoutingRecorded to the stored row"
      }
      on persistCropPlanted: command PersistCropPlanted is {
        do "apply CropPlanted to the stored row"
      }
      on persistHarvestCompleted: command PersistHarvestCompleted is {
        do "apply HarvestCompleted to the stored row"
      }
      on query GetSeasonYield is {
        let seasonYieldView: type SeasonYieldView = prompt("read the season yield projection")
        reply seasonYieldView
      }
    } with {
      briefly "Persists crop commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Crop data persistence"
    described as {
      |Persistent storage for fields and crops.
    }
  }
  query GetSeasonYield replies result SeasonYieldView is  {
    seasonYieldKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which season yield to retrieve.
      }
    }
  } with {
    briefly "Get season yield"
    described as {
      |Retrieves the season yield projection.
    }
  }
  result SeasonYieldView is  {
    seasonYield: YieldAnalytics.SeasonYield with {
      briefly "Season yield"
      described as {
        |The season yield being returned.
      }
    }
  } with {
    briefly "Season yield view"
    described as {
      |Read model view carrying the season yield projection.
    }
  }
  projector YieldAnalytics as flow is {
    outlet YieldAnalyticsToRepository is type CropRepositoryCommand
    updates repository CropContext.CropRepository
    inlet YieldAnalyticsFromField is type FieldEvent
    record SeasonYield is  {
      seasonId: SeasonId with {
        briefly "Season"
        described as {
          |Season ID.
        }
      }
      cropId: CropId with {
        briefly "Crop"
        described as {
          |Crop ID.
        }
      }
      totalAcres: Decimal(10,2) with {
        briefly "Acres"
        described as {
          |Total acres.
        }
      }
      aggregateTotalYield: Decimal(15,2) with {
        briefly "Yield"
        described as {
          |Total yield.
        }
      }
      averageYieldPerAcre: Decimal(8,2) with {
        briefly "Avg yield"
        described as {
          |Average yield per acre.
        }
      }
      fieldCount: Natural with {
        briefly "Fields"
        described as {
          |Number of fields.
        }
      }
    } with {
      briefly "Season yield"
      described as {
        |Yield summary by season and crop.
      }
    }
    handler AnalyticsHandler is {
      on applicationRecorded: event Field.ApplicationRecorded is {
        tell command CropContext.CropRepository.PersistApplicationRecorded(fieldId = applicationRecorded.fieldId) to repository CropContext.CropRepository
        do "apply ApplicationRecorded to the YieldAnalytics projection"
      }
      on fieldPrepared: event Field.FieldPrepared is {
        tell command CropContext.CropRepository.PersistFieldPrepared(fieldId = fieldPrepared.fieldId) to repository CropContext.CropRepository
        do "apply FieldPrepared to the YieldAnalytics projection"
      }
      on fieldRegistered: event Field.FieldRegistered is {
        tell command CropContext.CropRepository.PersistFieldRegistered(fieldId = fieldRegistered.fieldId) to repository CropContext.CropRepository
        do "apply FieldRegistered to the YieldAnalytics projection"
      }
      on fieldSetFallow: event Field.FieldSetFallow is {
        tell command CropContext.CropRepository.PersistFieldSetFallow(fieldId = fieldSetFallow.fieldId) to repository CropContext.CropRepository
        do "apply FieldSetFallow to the YieldAnalytics projection"
      }
      on harvestRecorded: event Field.HarvestRecorded is {
        tell command CropContext.CropRepository.PersistHarvestRecorded(fieldId = harvestRecorded.fieldId) to repository CropContext.CropRepository
        do "apply HarvestRecorded to the YieldAnalytics projection"
      }
      on harvestStarted: event Field.HarvestStarted is {
        tell command CropContext.CropRepository.PersistHarvestStarted(fieldId = harvestStarted.fieldId) to repository CropContext.CropRepository
        do "apply HarvestStarted to the YieldAnalytics projection"
      }
      on irrigationRecorded: event Field.IrrigationRecorded is {
        tell command CropContext.CropRepository.PersistIrrigationRecorded(fieldId = irrigationRecorded.fieldId) to repository CropContext.CropRepository
        do "apply IrrigationRecorded to the YieldAnalytics projection"
      }
      on scoutingRecorded: event Field.ScoutingRecorded is {
        tell command CropContext.CropRepository.PersistScoutingRecorded(fieldId = scoutingRecorded.fieldId) to repository CropContext.CropRepository
        do "apply ScoutingRecorded to the YieldAnalytics projection"
      }
      on cropPlanted: event Field.CropPlanted is {
        tell command CropContext.CropRepository.PersistCropPlanted(fieldId = cropPlanted.fieldId) to repository CropContext.CropRepository
        do "Track acres planted by crop"
      }
      on harvestCompleted: event Field.HarvestCompleted is {
        tell command CropContext.CropRepository.PersistHarvestCompleted(fieldId = harvestCompleted.fieldId) to repository CropContext.CropRepository
        do "Aggregate yields by crop and season"
      }
    } with {
      briefly "Maintains yield analytics"
      described as {
        |Projects events into yield analytics.
      }
    }
  } with {
    briefly "Yield analytics"
    described as {
      |Crop yield analysis and reporting.
    }
  }
  // ---- Event publication for Field ----
  type FieldEvent is one of {
    CropContext.Field.FieldRegistered or CropContext.Field.FieldPrepared or CropContext.Field.CropPlanted or CropContext.Field.ApplicationRecorded or CropContext.Field.ScoutingRecorded or CropContext.Field.IrrigationRecorded or CropContext.Field.HarvestStarted or CropContext.Field.HarvestRecorded or CropContext.Field.HarvestCompleted or CropContext.Field.FieldSetFallow
  } with {
    briefly "Field event alternation"
    described as {
      |Union of all Field events, for streaming and event-sourced
      |persistence.
    }
  }
  processor FieldEventSplit as flow is {
    inlet FieldEventSplitIn is type FieldEvent
    outlet FieldEventSplitToYieldAnalytics is type FieldEvent
    handler FieldEventSplitHandler is {
      on fieldRegistered: event Field.FieldRegistered is {
        send fieldRegistered to outlet FieldEventSplitToYieldAnalytics
        tell fieldRegistered to entity CropContext.Field
      }
      on fieldPrepared: event Field.FieldPrepared is {
        send fieldPrepared to outlet FieldEventSplitToYieldAnalytics
        tell fieldPrepared to entity CropContext.Field
      }
      on cropPlanted: event Field.CropPlanted is {
        send cropPlanted to outlet FieldEventSplitToYieldAnalytics
        tell cropPlanted to entity CropContext.Field
      }
      on applicationRecorded: event Field.ApplicationRecorded is {
        send applicationRecorded to outlet FieldEventSplitToYieldAnalytics
        tell applicationRecorded to entity CropContext.Field
      }
      on scoutingRecorded: event Field.ScoutingRecorded is {
        send scoutingRecorded to outlet FieldEventSplitToYieldAnalytics
        tell scoutingRecorded to entity CropContext.Field
      }
      on irrigationRecorded: event Field.IrrigationRecorded is {
        send irrigationRecorded to outlet FieldEventSplitToYieldAnalytics
        tell irrigationRecorded to entity CropContext.Field
      }
      on harvestStarted: event Field.HarvestStarted is {
        send harvestStarted to outlet FieldEventSplitToYieldAnalytics
        tell harvestStarted to entity CropContext.Field
      }
      on harvestRecorded: event Field.HarvestRecorded is {
        send harvestRecorded to outlet FieldEventSplitToYieldAnalytics
        tell harvestRecorded to entity CropContext.Field
      }
      on harvestCompleted: event Field.HarvestCompleted is {
        send harvestCompleted to outlet FieldEventSplitToYieldAnalytics
        tell harvestCompleted to entity CropContext.Field
      }
      on fieldSetFallow: event Field.FieldSetFallow is {
        send fieldSetFallow to outlet FieldEventSplitToYieldAnalytics
        tell fieldSetFallow to entity CropContext.Field
      }
      on other is {
        error "Unexpected message for processor FieldEventSplit"
      }
    } with {
      briefly "Field event fan-out handler"
      described as {
        |Delivers each Field event to all of its consumers.
      }
    }
  } with {
    briefly "Field event fan-out"
    described as {
      |Fans Field events out to the repository and projectors.
    }
  }
  connector 'FieldEvent Stream' is from outlet CropContext.Field.FieldEvents2 to inlet CropContext.FieldEventSplit.FieldEventSplitIn with {
    briefly "Field events, fanned out to storage and read models"
  }
  connector 'YieldAnalytics Feed' is from outlet CropContext.FieldEventSplit.FieldEventSplitToYieldAnalytics to inlet CropContext.YieldAnalytics.YieldAnalyticsFromField with {
    briefly "Field events feeding the YieldAnalytics projection"
  }
  connector 'YieldAnalytics Storage' is from outlet CropContext.YieldAnalytics.YieldAnalyticsToRepository to inlet CropContext.CropRepository.CropRepositoryFromYieldAnalytics with {
    briefly "YieldAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for crop management"
  described as {
    |Agricultural crop production context.
  }
}
