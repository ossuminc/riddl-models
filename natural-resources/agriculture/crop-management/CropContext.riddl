// Crop Management - Crop Context
context CropContext is {
  include "types.riddl"
  include "Field.riddl"
  repository CropRepository is {
    inlet CropRepositoryFromField is type FieldEvent
    inlet CropRepositoryFromYieldAnalytics is type FieldEvent
    outlet CropRepositoryResponses is type Field.FieldResult
    schema CropData is relational
      of fields as type Field
        index on field Field.fieldId
        index on field Field.seasonId
        index on field Field.status
        index on field Field.currentCrop

    handler CropPersistence is {
      on command Field.RegisterField is {
        do "Store new field record"
      }
      on command Field.PlantCrop is {
        do "Update field with planting data"
      }
      on command Field.RecordApplication is {
        tell event Field.ApplicationRecorded to entity CropContext.Field
        do "Store application record"
      }
      on command Field.RecordScouting is {
        tell event Field.ScoutingRecorded to entity CropContext.Field
        do "Store scouting report"
      }
      on command Field.RecordHarvest is {
        tell event Field.HarvestRecorded to entity CropContext.Field
        do "Store harvest record"
      }
      on command Field.CompleteHarvest is {
        tell event Field.HarvestCompleted to entity CropContext.Field
        do "Update field to harvested status"
      }
    } with {
      briefly "Persists crop commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Crop data persistence"
    described as {
      |Persistent storage for fields and crops.
    }
  }
  projector YieldAnalytics is {
    inlet YieldAnalyticsFromField is type FieldEvent
    outlet YieldAnalyticsOut is type FieldEvent
    updates repository CropContext.CropRepository
    record SeasonYield is  {
      seasonId: SeasonId with {
        briefly "Season"
        described as {
          |Season ID.
        }
      }
      cropId: CropId with {
        briefly "Crop"
        described as {
          |Crop ID.
        }
      }
      totalAcres: Decimal(10,2) with {
        briefly "Acres"
        described as {
          |Total acres.
        }
      }
      aggregateTotalYield: Decimal(15,2) with {
        briefly "Yield"
        described as {
          |Total yield.
        }
      }
      averageYieldPerAcre: Decimal(8,2) with {
        briefly "Avg yield"
        described as {
          |Average yield per acre.
        }
      }
      fieldCount: Natural with {
        briefly "Fields"
        described as {
          |Number of fields.
        }
      }
    } with {
      briefly "Season yield"
      described as {
        |Yield summary by season and crop.
      }
    }
    handler AnalyticsHandler is {
      on event Field.CropPlanted is {
        tell event Field.CropPlanted to repository CropContext.CropRepository
        do "Track acres planted by crop"
      }
      on event Field.HarvestCompleted is {
        tell event Field.HarvestCompleted to repository CropContext.CropRepository
        do "Aggregate yields by crop and season"
      }
    } with {
      briefly "Maintains yield analytics"
      described as {
        |Projects events into yield analytics.
      }
    }
  } with {
    briefly "Yield analytics"
    described as {
      |Crop yield analysis and reporting.
    }
  }
  // ---- Event publication for Field ----
  type FieldEvent is one of {
    CropContext.Field.FieldRegistered,
    CropContext.Field.FieldPrepared,
    CropContext.Field.CropPlanted,
    CropContext.Field.ApplicationRecorded,
    CropContext.Field.ScoutingRecorded,
    CropContext.Field.IrrigationRecorded,
    CropContext.Field.HarvestStarted,
    CropContext.Field.HarvestRecorded,
    CropContext.Field.HarvestCompleted,
    CropContext.Field.FieldSetFallow
  } with {
    briefly "Field event alternation"
    described as {
      |Union of all Field events, for streaming and event-sourced
      |persistence.
    }
  }
  processor FieldEventSource as source is {
    outlet FieldEvents is type FieldEvent
    handler FieldSourceHandler is {
      on event Field.FieldRegistered is {
        send event Field.FieldRegistered to outlet FieldEvents
      }
      on event Field.FieldPrepared is {
        send event Field.FieldPrepared to outlet FieldEvents
      }
      on event Field.CropPlanted is {
        send event Field.CropPlanted to outlet FieldEvents
      }
      on event Field.ApplicationRecorded is {
        send event Field.ApplicationRecorded to outlet FieldEvents
      }
      on event Field.ScoutingRecorded is {
        send event Field.ScoutingRecorded to outlet FieldEvents
      }
      on event Field.IrrigationRecorded is {
        send event Field.IrrigationRecorded to outlet FieldEvents
      }
      on event Field.HarvestStarted is {
        send event Field.HarvestStarted to outlet FieldEvents
      }
      on event Field.HarvestRecorded is {
        send event Field.HarvestRecorded to outlet FieldEvents
      }
      on event Field.HarvestCompleted is {
        send event Field.HarvestCompleted to outlet FieldEvents
      }
      on event Field.FieldSetFallow is {
        send event Field.FieldSetFallow to outlet FieldEvents
      }
      on other is {
        error "Unexpected message for source FieldEventSource"
      }
    } with {
      briefly "Field source handler"
      described as {
        |Publishes Field events onto the outlet.
      }
    }
  } with {
    briefly "Field event source"
    described as {
      |Publishes Field entity events into the streaming topology.
    }
  }
  processor FieldEventSink as sink is {
    inlet FieldInlet is type FieldEvent
    handler FieldSinkHandler is {
      on event Field.FieldRegistered is {
        tell event Field.FieldRegistered to repository CropContext.CropRepository
      }
      on event Field.FieldPrepared is {
        tell event Field.FieldPrepared to repository CropContext.CropRepository
      }
      on event Field.CropPlanted is {
        tell event Field.CropPlanted to repository CropContext.CropRepository
      }
      on event Field.ApplicationRecorded is {
        tell event Field.ApplicationRecorded to repository CropContext.CropRepository
      }
      on event Field.ScoutingRecorded is {
        tell event Field.ScoutingRecorded to repository CropContext.CropRepository
      }
      on event Field.IrrigationRecorded is {
        tell event Field.IrrigationRecorded to repository CropContext.CropRepository
      }
      on event Field.HarvestStarted is {
        tell event Field.HarvestStarted to repository CropContext.CropRepository
      }
      on event Field.HarvestRecorded is {
        tell event Field.HarvestRecorded to repository CropContext.CropRepository
      }
      on event Field.HarvestCompleted is {
        tell event Field.HarvestCompleted to repository CropContext.CropRepository
      }
      on event Field.FieldSetFallow is {
        tell event Field.FieldSetFallow to repository CropContext.CropRepository
      }
      on other is {
        error "Unexpected message for sink FieldEventSink"
      }
    } with {
      briefly "Field sink handler"
      described as {
        |Persists Field events via the repository.
      }
    }
  } with {
    briefly "Field event sink"
    described as {
      |Receives Field events for persistence.
    }
  }
  connector FieldEventFlow is {
    from outlet CropContext.FieldEventSource.FieldEvents to
      inlet CropContext.FieldEventSink.FieldInlet
  } with {
    briefly "Field event flow"
    described as {
      |Connects the Field source to its sink.
    }
  }
  processor FieldEventSplit is {
    inlet FieldEventSplitIn is type FieldEvent
    outlet FieldEventSplitToCropRepository is type FieldEvent
    outlet FieldEventSplitToYieldAnalytics is type FieldEvent
    handler FieldEventSplitHandler is {
      on event Field.FieldRegistered is {
        send event Field.FieldRegistered to outlet FieldEventSplitToCropRepository
        send event Field.FieldRegistered to outlet FieldEventSplitToYieldAnalytics
        tell event Field.FieldRegistered to entity CropContext.Field
      }
      on event Field.FieldPrepared is {
        send event Field.FieldPrepared to outlet FieldEventSplitToCropRepository
        send event Field.FieldPrepared to outlet FieldEventSplitToYieldAnalytics
        tell event Field.FieldPrepared to entity CropContext.Field
      }
      on event Field.CropPlanted is {
        send event Field.CropPlanted to outlet FieldEventSplitToCropRepository
        send event Field.CropPlanted to outlet FieldEventSplitToYieldAnalytics
        tell event Field.CropPlanted to entity CropContext.Field
      }
      on event Field.ApplicationRecorded is {
        send event Field.ApplicationRecorded to outlet FieldEventSplitToCropRepository
        send event Field.ApplicationRecorded to outlet FieldEventSplitToYieldAnalytics
        tell event Field.ApplicationRecorded to entity CropContext.Field
      }
      on event Field.ScoutingRecorded is {
        send event Field.ScoutingRecorded to outlet FieldEventSplitToCropRepository
        send event Field.ScoutingRecorded to outlet FieldEventSplitToYieldAnalytics
        tell event Field.ScoutingRecorded to entity CropContext.Field
      }
      on event Field.IrrigationRecorded is {
        send event Field.IrrigationRecorded to outlet FieldEventSplitToCropRepository
        send event Field.IrrigationRecorded to outlet FieldEventSplitToYieldAnalytics
        tell event Field.IrrigationRecorded to entity CropContext.Field
      }
      on event Field.HarvestStarted is {
        send event Field.HarvestStarted to outlet FieldEventSplitToCropRepository
        send event Field.HarvestStarted to outlet FieldEventSplitToYieldAnalytics
        tell event Field.HarvestStarted to entity CropContext.Field
      }
      on event Field.HarvestRecorded is {
        send event Field.HarvestRecorded to outlet FieldEventSplitToCropRepository
        send event Field.HarvestRecorded to outlet FieldEventSplitToYieldAnalytics
        tell event Field.HarvestRecorded to entity CropContext.Field
      }
      on event Field.HarvestCompleted is {
        send event Field.HarvestCompleted to outlet FieldEventSplitToCropRepository
        send event Field.HarvestCompleted to outlet FieldEventSplitToYieldAnalytics
        tell event Field.HarvestCompleted to entity CropContext.Field
      }
      on event Field.FieldSetFallow is {
        send event Field.FieldSetFallow to outlet FieldEventSplitToCropRepository
        send event Field.FieldSetFallow to outlet FieldEventSplitToYieldAnalytics
        tell event Field.FieldSetFallow to entity CropContext.Field
      }
      on other is {
        error "Unexpected message for processor FieldEventSplit"
      }
    } with {
      briefly "Field event fan-out handler"
      described as {
        |Delivers each Field event to all of its consumers.
      }
    }
  } with {
    briefly "Field event fan-out"
    described as {
      |Fans Field events out to the repository and projectors.
    }
  }
  connector LinkFieldToFieldEventSplit is {
    from outlet CropContext.Field.FieldEvents2 to
      inlet CropContext.FieldEventSplit.FieldEventSplitIn
  } with {
    briefly "LinkFieldToFieldEventSplit"
  }
  connector LinkFieldEventSplitToCropRepository is {
    from outlet CropContext.FieldEventSplit.FieldEventSplitToCropRepository to
      inlet CropContext.CropRepository.CropRepositoryFromField
  } with {
    briefly "LinkFieldEventSplitToCropRepository"
  }
  connector LinkFieldEventSplitToYieldAnalytics is {
    from outlet CropContext.FieldEventSplit.FieldEventSplitToYieldAnalytics to
      inlet CropContext.YieldAnalytics.YieldAnalyticsFromField
  } with {
    briefly "LinkFieldEventSplitToYieldAnalytics"
  }
  connector LinkYieldAnalyticsToCropRepository is {
    from outlet CropContext.YieldAnalytics.YieldAnalyticsOut to
      inlet CropContext.CropRepository.CropRepositoryFromYieldAnalytics
  } with {
    briefly "LinkYieldAnalyticsToCropRepository"
  }
} with {
  briefly "Bounded context for crop management"
  described as {
    |Agricultural crop production context.
  }
}
