// Crop Management - Crop Context
context CropContext is {
  adaptor FromEquipmentTracking from context EquipmentTracking is { 
    handler FromEquipmentTrackingHandler is {
      on result EquipmentTracking.EquipmentLocation is {
        do "the model receives equipment location"
      }
      on other is {
        error "Unexpected message for adaptor FromEquipmentTracking"
      }
    } with {
      briefly "from equipment tracking"
      described as {
        |Carries messages from the external EquipmentTracking.
      }
    }
  } with {
    briefly "EquipmentTracking integration"
    described as {
      |The model's side of the EquipmentTracking conversation.
    }
  }
  adaptor ToEquipmentTracking to context EquipmentTracking is { 
    handler ToEquipmentTrackingHandler is {
      on query EquipmentTracking.GetEquipmentLocation is {
        do "the model sends get equipment location"
      }
      on other is {
        error "Unexpected message for adaptor ToEquipmentTracking"
      }
    } with {
      briefly "to equipment tracking"
      described as {
        |Carries messages to the external EquipmentTracking.
      }
    }
  } with {
    briefly "EquipmentTracking integration"
    described as {
      |The model's side of the EquipmentTracking conversation.
    }
  }
  adaptor FromMarketPrices from context MarketPrices is { 
    handler FromMarketPricesHandler is {
      on result MarketPrices.CropPriceInfo is {
        do "the model receives crop price info"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketPrices"
      }
    } with {
      briefly "from market prices"
      described as {
        |Carries messages from the external MarketPrices.
      }
    }
  } with {
    briefly "MarketPrices integration"
    described as {
      |The model's side of the MarketPrices conversation.
    }
  }
  adaptor ToMarketPrices to context MarketPrices is { 
    handler ToMarketPricesHandler is {
      on query MarketPrices.GetCropPrices is {
        do "the model sends get crop prices"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketPrices"
      }
    } with {
      briefly "to market prices"
      described as {
        |Carries messages to the external MarketPrices.
      }
    }
  } with {
    briefly "MarketPrices integration"
    described as {
      |The model's side of the MarketPrices conversation.
    }
  }
  adaptor FromSoilTesting from context SoilTesting is { 
    handler FromSoilTestingHandler is {
      on event SoilTesting.SoilResultsReceived is {
        do "the model receives soil results received"
      }
      on other is {
        error "Unexpected message for adaptor FromSoilTesting"
      }
    } with {
      briefly "from soil testing"
      described as {
        |Carries messages from the external SoilTesting.
      }
    }
  } with {
    briefly "SoilTesting integration"
    described as {
      |The model's side of the SoilTesting conversation.
    }
  }
  adaptor ToSoilTesting to context SoilTesting is { 
    handler ToSoilTestingHandler is {
      on command SoilTesting.SubmitSoilSample is {
        do "the model sends submit soil sample"
      }
      on other is {
        error "Unexpected message for adaptor ToSoilTesting"
      }
    } with {
      briefly "to soil testing"
      described as {
        |Carries messages to the external SoilTesting.
      }
    }
  } with {
    briefly "SoilTesting integration"
    described as {
      |The model's side of the SoilTesting conversation.
    }
  }
  adaptor FromWeatherService from context WeatherService is { 
    handler FromWeatherServiceHandler is {
      on result WeatherService.HistoricalWeather is {
        do "the model receives historical weather"
      }
      on result WeatherService.WeatherForecast is {
        do "the model receives weather forecast"
      }
      on other is {
        error "Unexpected message for adaptor FromWeatherService"
      }
    } with {
      briefly "from weather service"
      described as {
        |Carries messages from the external WeatherService.
      }
    }
  } with {
    briefly "WeatherService integration"
    described as {
      |The model's side of the WeatherService conversation.
    }
  }
  adaptor ToWeatherService to context WeatherService is { 
    handler ToWeatherServiceHandler is {
      on query WeatherService.GetForecast is {
        do "the model sends get forecast"
      }
      on query WeatherService.GetHistoricalWeather is {
        do "the model sends get historical weather"
      }
      on other is {
        error "Unexpected message for adaptor ToWeatherService"
      }
    } with {
      briefly "to weather service"
      described as {
        |Carries messages to the external WeatherService.
      }
    }
  } with {
    briefly "WeatherService integration"
    described as {
      |The model's side of the WeatherService conversation.
    }
  }
  include "types.riddl"
  include "Field.riddl"
  repository CropRepository as merge is {
    inlet CropRepositoryFromField is type FieldEvent    inlet CropRepositoryFromYieldAnalytics is type FieldEvent    outlet CropRepositoryResponses is type Field.FieldResult
    record StoredField is  {
      fieldId: FieldId with {
        briefly "fieldId"
        described as {
          |The fieldId column of the stored field row.
        }
      }
      currentCrop: CropId? with {
        briefly "currentCrop"
        described as {
          |The currentCrop column of the stored field row.
        }
      }
      seasonId: SeasonId with {
        briefly "seasonId"
        described as {
          |The seasonId column of the stored field row.
        }
      }
      status: FieldStatus with {
        briefly "status"
        described as {
          |The status column of the stored field row.
        }
      }
    } with {
      briefly "Stored field row"
      described as {
        |The persistence shape of field data as this repository stores it.
      }
    }
    schema CropData is relational
      of fields as type StoredField
        index on field StoredField.fieldId
        index on field StoredField.seasonId
        index on field StoredField.status
        index on field StoredField.currentCrop
 with {
      briefly "Crop data schema"
      described as {
        |The relational schema holding crop data for the CropRepository.
      }
    }
    handler CropPersistence is {
      on query GetSeasonYield is {
        do "read the season yield projection"
        yield result SeasonYieldView
      }
      on command Field.RegisterField is {
        do "Store new field record"
      }
      on command Field.PlantCrop is {
        do "Update field with planting data"
      }
      on command Field.RecordApplication is {
        tell event Field.ApplicationRecorded to entity CropContext.Field
        do "Store application record"
      }
      on command Field.RecordScouting is {
        tell event Field.ScoutingRecorded to entity CropContext.Field
        do "Store scouting report"
      }
      on command Field.RecordHarvest is {
        tell event Field.HarvestRecorded to entity CropContext.Field
        do "Store harvest record"
      }
      on command Field.CompleteHarvest is {
        tell event Field.HarvestCompleted to entity CropContext.Field
        do "Update field to harvested status"
      }
    } with {
      briefly "Persists crop commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Crop data persistence"
    described as {
      |Persistent storage for fields and crops.
    }
  }
  query GetSeasonYield is  {
    seasonYieldKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which season yield to retrieve.
      }
    }
  } with {
    briefly "Get season yield"
    described as {
      |Retrieves the season yield projection.
    }
  }
  result SeasonYieldView is  {
    seasonYield: YieldAnalytics.SeasonYield with {
      briefly "Season yield"
      described as {
        |The season yield being returned.
      }
    }
  } with {
    briefly "Season yield view"
    described as {
      |Read model view carrying the season yield projection.
    }
  }
  projector YieldAnalytics as flow is {
    updates repository CropContext.CropRepository
    inlet YieldAnalyticsFromField is type FieldEvent    outlet YieldAnalyticsOut is type FieldEvent
    record SeasonYield is  {
      seasonId: SeasonId with {
        briefly "Season"
        described as {
          |Season ID.
        }
      }
      cropId: CropId with {
        briefly "Crop"
        described as {
          |Crop ID.
        }
      }
      totalAcres: Decimal(10,2) with {
        briefly "Acres"
        described as {
          |Total acres.
        }
      }
      aggregateTotalYield: Decimal(15,2) with {
        briefly "Yield"
        described as {
          |Total yield.
        }
      }
      averageYieldPerAcre: Decimal(8,2) with {
        briefly "Avg yield"
        described as {
          |Average yield per acre.
        }
      }
      fieldCount: Natural with {
        briefly "Fields"
        described as {
          |Number of fields.
        }
      }
    } with {
      briefly "Season yield"
      described as {
        |Yield summary by season and crop.
      }
    }
    handler AnalyticsHandler is {
      on event Field.CropPlanted is {
        tell event Field.CropPlanted to repository CropContext.CropRepository
        do "Track acres planted by crop"
      }
      on event Field.HarvestCompleted is {
        tell event Field.HarvestCompleted to repository CropContext.CropRepository
        do "Aggregate yields by crop and season"
      }
    } with {
      briefly "Maintains yield analytics"
      described as {
        |Projects events into yield analytics.
      }
    }
  } with {
    briefly "Yield analytics"
    described as {
      |Crop yield analysis and reporting.
    }
  }
  // ---- Event publication for Field ----
  type FieldEvent is one of {
    CropContext.Field.FieldRegistered or CropContext.Field.FieldPrepared or CropContext.Field.CropPlanted or CropContext.Field.ApplicationRecorded or CropContext.Field.ScoutingRecorded or CropContext.Field.IrrigationRecorded or CropContext.Field.HarvestStarted or CropContext.Field.HarvestRecorded or CropContext.Field.HarvestCompleted or CropContext.Field.FieldSetFallow
  } with {
    briefly "Field event alternation"
    described as {
      |Union of all Field events, for streaming and event-sourced
      |persistence.
    }
  }
  processor FieldEventSource as source is {
    outlet FieldEvents is type FieldEvent
    handler FieldSourceHandler is {
      on event Field.FieldRegistered is {
        send event Field.FieldRegistered to outlet FieldEvents
      }
      on event Field.FieldPrepared is {
        send event Field.FieldPrepared to outlet FieldEvents
      }
      on event Field.CropPlanted is {
        send event Field.CropPlanted to outlet FieldEvents
      }
      on event Field.ApplicationRecorded is {
        send event Field.ApplicationRecorded to outlet FieldEvents
      }
      on event Field.ScoutingRecorded is {
        send event Field.ScoutingRecorded to outlet FieldEvents
      }
      on event Field.IrrigationRecorded is {
        send event Field.IrrigationRecorded to outlet FieldEvents
      }
      on event Field.HarvestStarted is {
        send event Field.HarvestStarted to outlet FieldEvents
      }
      on event Field.HarvestRecorded is {
        send event Field.HarvestRecorded to outlet FieldEvents
      }
      on event Field.HarvestCompleted is {
        send event Field.HarvestCompleted to outlet FieldEvents
      }
      on event Field.FieldSetFallow is {
        send event Field.FieldSetFallow to outlet FieldEvents
      }
      on other is {
        error "Unexpected message for source FieldEventSource"
      }
    } with {
      briefly "Field source handler"
      described as {
        |Publishes Field events onto the outlet.
      }
    }
  } with {
    briefly "Field event source"
    described as {
      |Publishes Field entity events into the streaming topology.
    }
  }
  processor FieldEventSink as sink is {
    inlet FieldInlet is type FieldEvent    handler FieldSinkHandler is {
      on event Field.FieldRegistered is {
        tell event Field.FieldRegistered to repository CropContext.CropRepository
      }
      on event Field.FieldPrepared is {
        tell event Field.FieldPrepared to repository CropContext.CropRepository
      }
      on event Field.CropPlanted is {
        tell event Field.CropPlanted to repository CropContext.CropRepository
      }
      on event Field.ApplicationRecorded is {
        tell event Field.ApplicationRecorded to repository CropContext.CropRepository
      }
      on event Field.ScoutingRecorded is {
        tell event Field.ScoutingRecorded to repository CropContext.CropRepository
      }
      on event Field.IrrigationRecorded is {
        tell event Field.IrrigationRecorded to repository CropContext.CropRepository
      }
      on event Field.HarvestStarted is {
        tell event Field.HarvestStarted to repository CropContext.CropRepository
      }
      on event Field.HarvestRecorded is {
        tell event Field.HarvestRecorded to repository CropContext.CropRepository
      }
      on event Field.HarvestCompleted is {
        tell event Field.HarvestCompleted to repository CropContext.CropRepository
      }
      on event Field.FieldSetFallow is {
        tell event Field.FieldSetFallow to repository CropContext.CropRepository
      }
      on other is {
        error "Unexpected message for sink FieldEventSink"
      }
    } with {
      briefly "Field sink handler"
      described as {
        |Persists Field events via the repository.
      }
    }
  } with {
    briefly "Field event sink"
    described as {
      |Receives Field events for persistence.
    }
  }
  connector FieldEventFlow is from outlet CropContext.FieldEventSource.FieldEvents to inlet CropContext.FieldEventSink.FieldInlet with {
    briefly "Field event flow"
    described as {
      |Connects the Field source to its sink.
    }
  }
  processor FieldEventSplit as split is {
    inlet FieldEventSplitIn is type FieldEvent    outlet FieldEventSplitToCropRepository is type FieldEvent
    outlet FieldEventSplitToYieldAnalytics is type FieldEvent
    handler FieldEventSplitHandler is {
      on event Field.FieldRegistered is {
        send event Field.FieldRegistered to outlet FieldEventSplitToCropRepository
        send event Field.FieldRegistered to outlet FieldEventSplitToYieldAnalytics
        tell event Field.FieldRegistered to entity CropContext.Field
      }
      on event Field.FieldPrepared is {
        send event Field.FieldPrepared to outlet FieldEventSplitToCropRepository
        send event Field.FieldPrepared to outlet FieldEventSplitToYieldAnalytics
        tell event Field.FieldPrepared to entity CropContext.Field
      }
      on event Field.CropPlanted is {
        send event Field.CropPlanted to outlet FieldEventSplitToCropRepository
        send event Field.CropPlanted to outlet FieldEventSplitToYieldAnalytics
        tell event Field.CropPlanted to entity CropContext.Field
      }
      on event Field.ApplicationRecorded is {
        send event Field.ApplicationRecorded to outlet FieldEventSplitToCropRepository
        send event Field.ApplicationRecorded to outlet FieldEventSplitToYieldAnalytics
        tell event Field.ApplicationRecorded to entity CropContext.Field
      }
      on event Field.ScoutingRecorded is {
        send event Field.ScoutingRecorded to outlet FieldEventSplitToCropRepository
        send event Field.ScoutingRecorded to outlet FieldEventSplitToYieldAnalytics
        tell event Field.ScoutingRecorded to entity CropContext.Field
      }
      on event Field.IrrigationRecorded is {
        send event Field.IrrigationRecorded to outlet FieldEventSplitToCropRepository
        send event Field.IrrigationRecorded to outlet FieldEventSplitToYieldAnalytics
        tell event Field.IrrigationRecorded to entity CropContext.Field
      }
      on event Field.HarvestStarted is {
        send event Field.HarvestStarted to outlet FieldEventSplitToCropRepository
        send event Field.HarvestStarted to outlet FieldEventSplitToYieldAnalytics
        tell event Field.HarvestStarted to entity CropContext.Field
      }
      on event Field.HarvestRecorded is {
        send event Field.HarvestRecorded to outlet FieldEventSplitToCropRepository
        send event Field.HarvestRecorded to outlet FieldEventSplitToYieldAnalytics
        tell event Field.HarvestRecorded to entity CropContext.Field
      }
      on event Field.HarvestCompleted is {
        send event Field.HarvestCompleted to outlet FieldEventSplitToCropRepository
        send event Field.HarvestCompleted to outlet FieldEventSplitToYieldAnalytics
        tell event Field.HarvestCompleted to entity CropContext.Field
      }
      on event Field.FieldSetFallow is {
        send event Field.FieldSetFallow to outlet FieldEventSplitToCropRepository
        send event Field.FieldSetFallow to outlet FieldEventSplitToYieldAnalytics
        tell event Field.FieldSetFallow to entity CropContext.Field
      }
      on other is {
        error "Unexpected message for processor FieldEventSplit"
      }
    } with {
      briefly "Field event fan-out handler"
      described as {
        |Delivers each Field event to all of its consumers.
      }
    }
  } with {
    briefly "Field event fan-out"
    described as {
      |Fans Field events out to the repository and projectors.
    }
  }
  connector 'FieldEvent Stream' is from outlet CropContext.Field.FieldEvents2 to inlet CropContext.FieldEventSplit.FieldEventSplitIn with {
    briefly "Field events, fanned out to storage and read models"
  }
  connector 'FieldEvent Storage' is from outlet CropContext.FieldEventSplit.FieldEventSplitToCropRepository to inlet CropContext.CropRepository.CropRepositoryFromField with {
    briefly "Field events on their way to storage"
  }
  connector 'YieldAnalytics Feed' is from outlet CropContext.FieldEventSplit.FieldEventSplitToYieldAnalytics to inlet CropContext.YieldAnalytics.YieldAnalyticsFromField with {
    briefly "Field events feeding the YieldAnalytics projection"
  }
  connector 'YieldAnalytics Storage' is from outlet CropContext.YieldAnalytics.YieldAnalyticsOut to inlet CropContext.CropRepository.CropRepositoryFromYieldAnalytics with {
    briefly "The YieldAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for crop management"
  described as {
    |Agricultural crop production context.
  }
}
