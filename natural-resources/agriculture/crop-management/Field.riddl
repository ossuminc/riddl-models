// Crop Management - Field Entity
entity Field as flow is {
  type FieldCommand is one of {
    Field.RegisterField or Field.PrepareField or Field.PlantCrop or Field.RecordApplication or Field.RecordScouting or Field.RecordIrrigation or Field.BeginHarvest or Field.RecordHarvest or Field.CompleteHarvest or Field.SetFallow or Field.RecordHarvestValue or Field.RecordEquipmentPosition
  } with {
    briefly "Field command alternation"
    described as {
      |Commands accepted by the Field entity.
    }
  }
  inlet FieldCommands is type FieldCommand  outlet FieldEvents2 is type FieldEvent
  query GetField replies result FieldResult is {
    fieldId: FieldId with {
      briefly "ID"
      described as {
        |Identifier of the Field to retrieve.
      }
    }
  } with {
    briefly "Get Field"
    described as {
      |Retrieve Field data by identifier.
    }
  }
  result FieldResult is {
    fieldId: FieldId with {
      briefly "Field addressed"
      described as {
        |Which field this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    fieldData: Field.ActiveStateData with {
      briefly "Field data"
      described as {
        |The requested Field data.
      }
    }
  } with {
    briefly "Field result"
    described as {
      |Result carrying the requested Field data.
    }
  }
  command RegisterField is {
    fieldId: FieldId with {
      briefly "Field ID"
      described as {
        |New field identifier.
      }
    }
    fieldInfo: FieldInfo with {
      briefly "Info"
      described as {
        |Field information.
      }
    }
    seasonId: SeasonId with {
      briefly "Season"
      described as {
        |Current season.
      }
    }
  } with {
    briefly "Register field"
    described as {
      |Registers a new field.
    }
  }
  command PrepareField is {
    fieldId: FieldId with {
      briefly "Field ID"
      described as {
        |Field identifier.
      }
    }
    preparationDate: Date with {
      briefly "Date"
      described as {
        |Preparation date.
      }
    }
    tillageMethod: String(1,100) with {
      briefly "Tillage"
      described as {
        |Tillage method used.
      }
    }
  } with {
    briefly "Prepare field"
    described as {
      |Prepares field for planting.
    }
  }
  command PlantCrop is {
    fieldId: FieldId with {
      briefly "Field ID"
      described as {
        |Field identifier.
      }
    }
    planting: PlantingRecord with {
      briefly "Planting"
      described as {
        |Planting details.
      }
    }
  } with {
    briefly "Plant crop"
    described as {
      |Records crop planting.
    }
  }
  command RecordApplication is {
    fieldId: FieldId with {
      briefly "Field ID"
      described as {
        |Field identifier.
      }
    }
    application: ApplicationRecord with {
      briefly "Application"
      described as {
        |Application details.
      }
    }
  } with {
    briefly "Record application"
    described as {
      |Records chemical or fertilizer application.
    }
  }
  command RecordScouting is {
    fieldId: FieldId with {
      briefly "Field ID"
      described as {
        |Field identifier.
      }
    }
    report: ScoutingReport with {
      briefly "Report"
      described as {
        |Scouting report.
      }
    }
  } with {
    briefly "Record scouting"
    described as {
      |Records field scouting report.
    }
  }
  command RecordIrrigation is {
    fieldId: FieldId with {
      briefly "Field ID"
      described as {
        |Field identifier.
      }
    }
    irrigationDate: Date with {
      briefly "Date"
      described as {
        |Irrigation date.
      }
    }
    acreInches: Decimal(6,2) with {
      briefly "Amount"
      described as {
        |Acre-inches applied.
      }
    }
    method: String(1,50) with {
      briefly "Method"
      described as {
        |Irrigation method.
      }
    }
  } with {
    briefly "Record irrigation"
    described as {
      |Records irrigation event.
    }
  }
  command BeginHarvest is {
    fieldId: FieldId with {
      briefly "Field ID"
      described as {
        |Field identifier.
      }
    }
    startDate: Date with {
      briefly "Start date"
      described as {
        |Harvest start date.
      }
    }
  } with {
    briefly "Begin harvest"
    described as {
      |Starts harvest operations.
    }
  }
  command RecordHarvest is {
    fieldId: FieldId with {
      briefly "Field ID"
      described as {
        |Field identifier.
      }
    }
    harvest: HarvestRecord with {
      briefly "Harvest"
      described as {
        |Harvest data.
      }
    }
  } with {
    briefly "Record harvest"
    described as {
      |Records harvest results.
    }
  }
  command CompleteHarvest is {
    fieldId: FieldId with {
      briefly "Field ID"
      described as {
        |Field identifier.
      }
    }
    completionDate: Date with {
      briefly "Date"
      described as {
        |Completion date.
      }
    }
    totalYield: Decimal(12,2) with {
      briefly "Total yield"
      described as {
        |Total field yield.
      }
    }
  } with {
    briefly "Complete harvest"
    described as {
      |Completes harvest for season.
    }
  }
  command SetFallow is {
    fieldId: FieldId with {
      briefly "Field ID"
      described as {
        |Field identifier.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Fallow reason.
      }
    }
  } with {
    briefly "Set fallow"
    described as {
      |Sets field to fallow.
    }
  }
  command RecordHarvestValue is {
    fieldId: FieldId with {
      briefly "field addressed"
      described as {
        |Field addressed.
      }
    }
    spotPrice: Decimal(8,2) with {
      briefly "spot price"
      described as {
        |Spot price.
      }
    }
    priceUnit: String(1,20) with {
      briefly "price unit"
      described as {
        |Price unit.
      }
    }
    asOf: TimeStamp with {
      briefly "as of"
      described as {
        |As of.
      }
    }
  } with {
    briefly "Record harvest value"
    described as {
      |Carries an answer obtained from an external service into the field.
    }
  }
  command RecordEquipmentPosition is {
    fieldId: FieldId with {
      briefly "field addressed"
      described as {
        |Field addressed.
      }
    }
    equipmentId: UUID with {
      briefly "equipment id"
      described as {
        |Equipment id.
      }
    }
    latitude: Decimal(10,7) with {
      briefly "latitude"
      described as {
        |Latitude.
      }
    }
    longitude: Decimal(10,7) with {
      briefly "longitude"
      described as {
        |Longitude.
      }
    }
  } with {
    briefly "Record equipment position"
    described as {
      |Carries an answer obtained from an external service into the field.
    }
  }
  // Events
  event FieldRegistered is {
    fieldId: FieldId with {
      briefly "Field"
      described as {
        |Field ID.
      }
    }
    fieldInfo: FieldInfo with {
      briefly "Info"
      described as {
        |Field info.
      }
    }
    registeredAt: TimeStamp with {
      briefly "Registered"
      described as {
        |Registration time.
      }
    }
  } with {
    briefly "Field registered"
    described as {
      |Emitted when field is registered.
    }
  }
  event FieldPrepared is {
    fieldId: FieldId with {
      briefly "Field"
      described as {
        |Field ID.
      }
    }
    preparationDate: Date with {
      briefly "Date"
      described as {
        |Prep date.
      }
    }
    tillageMethod: String(1,100) with {
      briefly "Method"
      described as {
        |Tillage method.
      }
    }
  } with {
    briefly "Field prepared"
    described as {
      |Emitted when field is prepared.
    }
  }
  event CropPlanted is {
    fieldId: FieldId with {
      briefly "Field"
      described as {
        |Field ID.
      }
    }
    planting: PlantingRecord with {
      briefly "Planting"
      described as {
        |Planting record.
      }
    }
    plantedAt: TimeStamp with {
      briefly "Planted"
      described as {
        |Planting time.
      }
    }
  } with {
    briefly "Crop planted"
    described as {
      |Emitted when crop is planted.
    }
  }
  event ApplicationRecorded is {
    fieldId: FieldId with {
      briefly "Field"
      described as {
        |Field ID.
      }
    }
    application: ApplicationRecord with {
      briefly "Application"
      described as {
        |Application.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Application recorded"
    described as {
      |Emitted when application is recorded.
    }
  }
  event ScoutingRecorded is {
    fieldId: FieldId with {
      briefly "Field"
      described as {
        |Field ID.
      }
    }
    report: ScoutingReport with {
      briefly "Report"
      described as {
        |Scouting report.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Scouting recorded"
    described as {
      |Emitted when scouting is recorded.
    }
  }
  event IrrigationRecorded is {
    fieldId: FieldId with {
      briefly "Field"
      described as {
        |Field ID.
      }
    }
    irrigationDate: Date with {
      briefly "Date"
      described as {
        |Irrigation date.
      }
    }
    acreInches: Decimal(6,2) with {
      briefly "Amount"
      described as {
        |Amount applied.
      }
    }
  } with {
    briefly "Irrigation recorded"
    described as {
      |Emitted when irrigation is recorded.
    }
  }
  event HarvestStarted is {
    fieldId: FieldId with {
      briefly "Field"
      described as {
        |Field ID.
      }
    }
    startDate: Date with {
      briefly "Start"
      described as {
        |Start date.
      }
    }
  } with {
    briefly "Harvest started"
    described as {
      |Emitted when harvest begins.
    }
  }
  event HarvestRecorded is {
    fieldId: FieldId with {
      briefly "Field"
      described as {
        |Field ID.
      }
    }
    harvest: HarvestRecord with {
      briefly "Harvest"
      described as {
        |Harvest data.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Harvest recorded"
    described as {
      |Emitted when harvest is recorded.
    }
  }
  event HarvestCompleted is {
    fieldId: FieldId with {
      briefly "Field"
      described as {
        |Field ID.
      }
    }
    totalYield: Decimal(12,2) with {
      briefly "Yield"
      described as {
        |Total yield.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Harvest completed"
    described as {
      |Emitted when harvest is complete.
    }
  }
  event FieldSetFallow is {
    fieldId: FieldId with {
      briefly "Field"
      described as {
        |Field ID.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Fallow reason.
      }
    }
    setAt: TimeStamp with {
      briefly "Set"
      described as {
        |Set time.
      }
    }
  } with {
    briefly "Field set fallow"
    described as {
      |Emitted when field is set fallow.
    }
  }
  event HarvestValueRecorded is {
    fieldId: FieldId with {
      briefly "field addressed"
      described as {
        |Field addressed.
      }
    }
    spotPrice: Decimal(8,2) with {
      briefly "spot price"
      described as {
        |Spot price.
      }
    }
    priceUnit: String(1,20) with {
      briefly "price unit"
      described as {
        |Price unit.
      }
    }
    asOf: TimeStamp with {
      briefly "as of"
      described as {
        |As of.
      }
    }
    recordedAt: TimeStamp with {
      briefly "when it was recorded"
      described as {
        |When it was recorded.
      }
    }
  } with {
    briefly "Harvest value recorded"
    described as {
      |Emitted when record harvest value has been applied.
    }
  }
  event EquipmentPositionRecorded is {
    fieldId: FieldId with {
      briefly "field addressed"
      described as {
        |Field addressed.
      }
    }
    equipmentId: UUID with {
      briefly "equipment id"
      described as {
        |Equipment id.
      }
    }
    latitude: Decimal(10,7) with {
      briefly "latitude"
      described as {
        |Latitude.
      }
    }
    longitude: Decimal(10,7) with {
      briefly "longitude"
      described as {
        |Longitude.
      }
    }
    recordedAt: TimeStamp with {
      briefly "when it was recorded"
      described as {
        |When it was recorded.
      }
    }
  } with {
    briefly "Equipment position recorded"
    described as {
      |Emitted when record equipment position has been applied.
    }
  }
  // States
  record ActiveStateData is {
    fieldId: FieldId with {
      briefly "Field"
      described as {
        |Field ID.
      }
    }
    fieldInfo: FieldInfo with {
      briefly "Info"
      described as {
        |Field info.
      }
    }
    seasonId: SeasonId with {
      briefly "Season"
      described as {
        |Current season.
      }
    }
    status: FieldStatus with {
      briefly "Status"
      described as {
        |Current status.
      }
    }
    currentCrop: CropId? with {
      briefly "Crop"
      described as {
        |Current crop.
      }
    }
    updatedPlanting: PlantingRecord? with {
      briefly "Planting"
      described as {
        |Planting record.
      }
    }
    applications: ApplicationRecord* with {
      briefly "Applications"
      described as {
        |Application history.
      }
    }
    scoutingReports: ScoutingReport* with {
      briefly "Scouting"
      described as {
        |Scouting reports.
      }
    }
    registeredAt: TimeStamp with {
      briefly "Registered"
      described as {
        |Registration time.
      }
    }
  } with {
    briefly "Active field state"
    described as {
      |State for active field.
    }
  }
  record HarvestedStateData is {
    fieldId: FieldId with {
      briefly "Field"
      described as {
        |Field ID.
      }
    }
    seasonId: SeasonId with {
      briefly "Season"
      described as {
        |Season ID.
      }
    }
    totalYield: Decimal(12,2) with {
      briefly "Yield"
      described as {
        |Total yield.
      }
    }
    harvestCompletedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Harvested field state"
    described as {
      |State after harvest completion.
    }
  }
  initial state ActiveState of record Field.ActiveStateData is {
    initial handler ActiveStateInitHandler is {
      on query GetField is {
        let fieldResult: type FieldResult = prompt("read the field from the store")
        reply fieldResult
      }
      on init is {
        set state ActiveState to "initialize Field.ActiveStateData fields from the creating message"
      }
    } with {
      briefly "ActiveState initialization"
      described as {
        |Initializes ActiveState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |The active state of the Field entity, carrying ActiveStateData.
    }
  }
  state HarvestedState of record Field.HarvestedStateData with {
    briefly "Harvested state"
    described as {
      |The harvested state of the Field entity, carrying HarvestedStateData.
    }
  }
  handler FieldHandler is {
    on init is {
      set state HarvestedState to "initialize Field.HarvestedStateData fields from the creating message"
    }
    on registerField: command RegisterField is {
      morph entity CropContext.Field to state CropContext.Field.ActiveState with record Field.ActiveStateData(fieldId = registerField.fieldId, fieldInfo = registerField.fieldInfo, seasonId = registerField.seasonId, status = prompt("the status of this active state data"), currentCrop = empty, updatedPlanting = empty, applications = empty, scoutingReports = empty, registeredAt = prompt("the registered at of this active state data"))
      tell event FieldRegistered(fieldId = registerField.fieldId, fieldInfo = registerField.fieldInfo, registeredAt = prompt("the registered at of this field registered")) to entity CropContext.Field
    }
    on prepareField: command PrepareField is {
      tell event FieldPrepared(fieldId = prepareField.fieldId, preparationDate = prepareField.preparationDate, tillageMethod = prepareField.tillageMethod) to entity CropContext.Field
    }
    on plantCrop: command PlantCrop is {
      tell event CropPlanted(fieldId = plantCrop.fieldId, planting = plantCrop.planting, plantedAt = prompt("the planted at of this crop planted")) to entity CropContext.Field
    }
    on recordApplication: command RecordApplication is {
      tell event ApplicationRecorded(fieldId = recordApplication.fieldId, application = recordApplication.application, recordedAt = prompt("the recorded at of this application recorded")) to entity CropContext.Field
    }
    on recordScouting: command RecordScouting is {
      tell event ScoutingRecorded(fieldId = recordScouting.fieldId, report = recordScouting.report, recordedAt = prompt("the recorded at of this scouting recorded")) to entity CropContext.Field
    }
    on recordIrrigation: command RecordIrrigation is {
      tell event IrrigationRecorded(fieldId = recordIrrigation.fieldId, irrigationDate = recordIrrigation.irrigationDate, acreInches = recordIrrigation.acreInches) to entity CropContext.Field
    }
    on beginHarvest: command BeginHarvest is {
      tell event HarvestStarted(fieldId = beginHarvest.fieldId, startDate = beginHarvest.startDate) to entity CropContext.Field
    }
    on recordHarvest: command RecordHarvest is {
      tell event HarvestRecorded(fieldId = recordHarvest.fieldId, harvest = recordHarvest.harvest, recordedAt = prompt("the recorded at of this harvest recorded")) to entity CropContext.Field
    }
    on completeHarvest: command CompleteHarvest is {
      morph entity CropContext.Field to state CropContext.Field.HarvestedState with record Field.HarvestedStateData(fieldId = completeHarvest.fieldId, totalYield = completeHarvest.totalYield, seasonId = prompt("the season id of this harvested state data"), harvestCompletedAt = prompt("the harvest completed at of this harvested state data"))
      tell event HarvestCompleted(fieldId = completeHarvest.fieldId, totalYield = completeHarvest.totalYield, completedAt = prompt("the completed at of this harvest completed")) to entity CropContext.Field
    }
    on setFallow: command SetFallow is {
      tell event FieldSetFallow(fieldId = setFallow.fieldId, reason = setFallow.reason, setAt = prompt("the set at of this field set fallow")) to entity CropContext.Field
    }
    on recordHarvestValue: command RecordHarvestValue is {
      tell event HarvestValueRecorded(fieldId = recordHarvestValue.fieldId, spotPrice = recordHarvestValue.spotPrice, priceUnit = recordHarvestValue.priceUnit, asOf = recordHarvestValue.asOf, recordedAt = prompt("now")) to entity CropContext.Field
    }
    on recordEquipmentPosition: command RecordEquipmentPosition is {
      tell event EquipmentPositionRecorded(fieldId = recordEquipmentPosition.fieldId, equipmentId = recordEquipmentPosition.equipmentId, latitude = recordEquipmentPosition.latitude, longitude = recordEquipmentPosition.longitude, recordedAt = prompt("now")) to entity CropContext.Field
    }
    on applicationRecorded: event ApplicationRecorded is {
      do "apply ApplicationRecorded to the field so it can be persisted and replayed"
    }
    on cropPlanted: event CropPlanted is {
      do "apply CropPlanted to the field so it can be persisted and replayed"
    }
    on fieldPrepared: event FieldPrepared is {
      do "apply FieldPrepared to the field so it can be persisted and replayed"
    }
    on fieldRegistered: event FieldRegistered is {
      do "apply FieldRegistered to the field so it can be persisted and replayed"
    }
    on fieldSetFallow: event FieldSetFallow is {
      do "apply FieldSetFallow to the field so it can be persisted and replayed"
    }
    on harvestCompleted: event HarvestCompleted is {
      do "apply HarvestCompleted to the field so it can be persisted and replayed"
    }
    on harvestRecorded: event HarvestRecorded is {
      do "apply HarvestRecorded to the field so it can be persisted and replayed"
    }
    on harvestStarted: event HarvestStarted is {
      do "apply HarvestStarted to the field so it can be persisted and replayed"
    }
    on irrigationRecorded: event IrrigationRecorded is {
      do "apply IrrigationRecorded to the field so it can be persisted and replayed"
    }
    on scoutingRecorded: event ScoutingRecorded is {
      do "apply ScoutingRecorded to the field so it can be persisted and replayed"
    }
    on harvestValueRecorded: event HarvestValueRecorded is {
      do "apply HarvestValueRecorded to the field so it can be persisted and replayed"
    }
    on equipmentPositionRecorded: event EquipmentPositionRecorded is {
      do "apply EquipmentPositionRecorded to the field so it can be persisted and replayed"
    }
  } with {
    briefly "Processes field commands"
    described as {
      |Handles field lifecycle.
    }
  }
} with {
  briefly "Field aggregate"
  described as {
    |Manages agricultural fields.
  }
}
