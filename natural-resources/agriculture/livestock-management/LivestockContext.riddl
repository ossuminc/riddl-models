// Livestock Management - Livestock Context
context LivestockContext is {
  include "types.riddl"
  include "LivestockAnimal.riddl"
  repository LivestockRepository is {
    inlet LivestockRepositoryFromLivestockAnimal is type LivestockAnimalEvent
    inlet LivestockRepositoryFromHerdMetrics is type LivestockAnimalEvent
    outlet LivestockRepositoryResponses is type LivestockAnimal.LivestockAnimalResult
    schema LivestockData is relational
      of livestockAnimals as type LivestockAnimal
        index on field LivestockAnimal.animalId
        index on field LivestockAnimal.animalInfo.herdId
        index on field LivestockAnimal.healthStatus

    handler LivestockPersistence is {
      on command LivestockAnimal.RegisterAnimal is {
        prompt "Store new animal record"
      }
      on command LivestockAnimal.RecordWeight is {
        tell event LivestockAnimal.WeightRecorded to entity LivestockContext.LivestockAnimal
        prompt "Append weight measurement"
      }
      on command LivestockAnimal.RecordVetVisit is {
        tell event LivestockAnimal.VetVisitRecorded to entity LivestockContext.LivestockAnimal
        prompt "Append veterinary record"
      }
      on command LivestockAnimal.UpdateHealthStatus is {
        tell event LivestockAnimal.HealthStatusUpdated to entity LivestockContext.LivestockAnimal
        prompt "Update health status"
      }
      on command LivestockAnimal.RecordBreeding is {
        tell event LivestockAnimal.BreedingRecorded to entity LivestockContext.LivestockAnimal
        prompt "Append breeding record"
      }
      on command LivestockAnimal.SellAnimal is {
        prompt "Update animal to sold status"
      }
    } with {
      briefly "Persists livestock commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Livestock data persistence"
    described as {
      |Persistent storage for livestock data.
    }
  }
  projector HerdMetrics is {
    inlet HerdMetricsFromLivestockAnimal is type LivestockAnimalEvent
    outlet HerdMetricsOut is type LivestockAnimalEvent
    updates repository LivestockContext.LivestockRepository
    record HerdMetricsData is  {
      totalAnimals: Natural with {
        briefly "Total"
        described as {
          |Total active animals.
        }
      }
      totalSold: Natural with {
        briefly "Sold"
        described as {
          |Total animals sold.
        }
      }
      totalDeceased: Natural with {
        briefly "Deceased"
        described as {
          |Total deceased animals.
        }
      }
      averageWeight: Decimal(8,2) with {
        briefly "Avg weight"
        described as {
          |Average weight in kilograms.
        }
      }
      breedingCount: Natural with {
        briefly "Breeding"
        described as {
          |Animals in breeding program.
        }
      }
    } with {
      briefly "Herd metrics"
      described as {
        |Aggregate herd statistics.
      }
    }
    handler HerdMetricsHandler is {
      on event LivestockAnimal.AnimalRegistered is {
        tell event LivestockAnimal.AnimalRegistered to repository LivestockContext.LivestockRepository
        prompt "Increment total animals"
      }
      on event LivestockAnimal.WeightRecorded is {
        tell event LivestockAnimal.WeightRecorded to repository LivestockContext.LivestockRepository
        prompt "Recalculate average weight"
      }
      on event LivestockAnimal.AnimalSold is {
        tell event LivestockAnimal.AnimalSold to repository LivestockContext.LivestockRepository
        prompt "Increment sold and decrement active"
      }
      on event LivestockAnimal.DeathRecorded is {
        tell event LivestockAnimal.DeathRecorded to repository LivestockContext.LivestockRepository
        prompt "Increment deceased and decrement active"
      }
    } with {
      briefly "Maintains herd metrics"
      described as {
        |Projects events into herd statistics.
      }
    }
  } with {
    briefly "Herd metrics"
    described as {
      |Livestock herd analytics.
    }
  }
  // ---- Event publication for LivestockAnimal ----
  type LivestockAnimalEvent is one of {
    LivestockContext.LivestockAnimal.AnimalRegistered,
    LivestockContext.LivestockAnimal.WeightRecorded,
    LivestockContext.LivestockAnimal.VetVisitRecorded,
    LivestockContext.LivestockAnimal.HealthStatusUpdated,
    LivestockContext.LivestockAnimal.BreedingRecorded,
    LivestockContext.LivestockAnimal.FeedingRecorded,
    LivestockContext.LivestockAnimal.HerdTransferred,
    LivestockContext.LivestockAnimal.AnimalSold,
    LivestockContext.LivestockAnimal.DeathRecorded
  } with {
    briefly "LivestockAnimal event alternation"
    described as {
      |Union of all LivestockAnimal events, for streaming and event-sourced
      |persistence.
    }
  }
  processor LivestockAnimalEventSource as source is {
    outlet LivestockAnimalEvents is type LivestockAnimalEvent
    handler LivestockAnimalSourceHandler is {
      on event LivestockAnimal.AnimalRegistered is {
        send event LivestockAnimal.AnimalRegistered to outlet LivestockAnimalEvents
      }
      on event LivestockAnimal.WeightRecorded is {
        send event LivestockAnimal.WeightRecorded to outlet LivestockAnimalEvents
      }
      on event LivestockAnimal.VetVisitRecorded is {
        send event LivestockAnimal.VetVisitRecorded to outlet LivestockAnimalEvents
      }
      on event LivestockAnimal.HealthStatusUpdated is {
        send event LivestockAnimal.HealthStatusUpdated to outlet LivestockAnimalEvents
      }
      on event LivestockAnimal.BreedingRecorded is {
        send event LivestockAnimal.BreedingRecorded to outlet LivestockAnimalEvents
      }
      on event LivestockAnimal.FeedingRecorded is {
        send event LivestockAnimal.FeedingRecorded to outlet LivestockAnimalEvents
      }
      on event LivestockAnimal.HerdTransferred is {
        send event LivestockAnimal.HerdTransferred to outlet LivestockAnimalEvents
      }
      on event LivestockAnimal.AnimalSold is {
        send event LivestockAnimal.AnimalSold to outlet LivestockAnimalEvents
      }
      on event LivestockAnimal.DeathRecorded is {
        send event LivestockAnimal.DeathRecorded to outlet LivestockAnimalEvents
      }
      on other is {
        error "Unexpected message for source LivestockAnimalEventSource"
      }
    } with {
      briefly "LivestockAnimal source handler"
      described as {
        |Publishes LivestockAnimal events onto the outlet.
      }
    }
  } with {
    briefly "LivestockAnimal event source"
    described as {
      |Publishes LivestockAnimal entity events into the streaming topology.
    }
  }
  processor LivestockAnimalEventSink as sink is {
    inlet LivestockAnimalInlet is type LivestockAnimalEvent
    handler LivestockAnimalSinkHandler is {
      on event LivestockAnimal.AnimalRegistered is {
        tell event LivestockAnimal.AnimalRegistered to repository LivestockContext.LivestockRepository
      }
      on event LivestockAnimal.WeightRecorded is {
        tell event LivestockAnimal.WeightRecorded to repository LivestockContext.LivestockRepository
      }
      on event LivestockAnimal.VetVisitRecorded is {
        tell event LivestockAnimal.VetVisitRecorded to repository LivestockContext.LivestockRepository
      }
      on event LivestockAnimal.HealthStatusUpdated is {
        tell event LivestockAnimal.HealthStatusUpdated to repository LivestockContext.LivestockRepository
      }
      on event LivestockAnimal.BreedingRecorded is {
        tell event LivestockAnimal.BreedingRecorded to repository LivestockContext.LivestockRepository
      }
      on event LivestockAnimal.FeedingRecorded is {
        tell event LivestockAnimal.FeedingRecorded to repository LivestockContext.LivestockRepository
      }
      on event LivestockAnimal.HerdTransferred is {
        tell event LivestockAnimal.HerdTransferred to repository LivestockContext.LivestockRepository
      }
      on event LivestockAnimal.AnimalSold is {
        tell event LivestockAnimal.AnimalSold to repository LivestockContext.LivestockRepository
      }
      on event LivestockAnimal.DeathRecorded is {
        tell event LivestockAnimal.DeathRecorded to repository LivestockContext.LivestockRepository
      }
      on other is {
        error "Unexpected message for sink LivestockAnimalEventSink"
      }
    } with {
      briefly "LivestockAnimal sink handler"
      described as {
        |Persists LivestockAnimal events via the repository.
      }
    }
  } with {
    briefly "LivestockAnimal event sink"
    described as {
      |Receives LivestockAnimal events for persistence.
    }
  }
  connector LivestockAnimalEventFlow is {
    from outlet LivestockContext.LivestockAnimalEventSource.LivestockAnimalEvents to
      inlet LivestockContext.LivestockAnimalEventSink.LivestockAnimalInlet
  } with {
    briefly "LivestockAnimal event flow"
    described as {
      |Connects the LivestockAnimal source to its sink.
    }
  }
  processor LivestockAnimalEventSplit is {
    inlet LivestockAnimalEventSplitIn is type LivestockAnimalEvent
    outlet LivestockAnimalEventSplitToLivestockRepository is type LivestockAnimalEvent
    outlet LivestockAnimalEventSplitToHerdMetrics is type LivestockAnimalEvent
    handler LivestockAnimalEventSplitHandler is {
      on event LivestockAnimal.AnimalRegistered is {
        send event LivestockAnimal.AnimalRegistered to outlet LivestockAnimalEventSplitToLivestockRepository
        send event LivestockAnimal.AnimalRegistered to outlet LivestockAnimalEventSplitToHerdMetrics
        tell event LivestockAnimal.AnimalRegistered to entity LivestockContext.LivestockAnimal
      }
      on event LivestockAnimal.WeightRecorded is {
        send event LivestockAnimal.WeightRecorded to outlet LivestockAnimalEventSplitToLivestockRepository
        send event LivestockAnimal.WeightRecorded to outlet LivestockAnimalEventSplitToHerdMetrics
        tell event LivestockAnimal.WeightRecorded to entity LivestockContext.LivestockAnimal
      }
      on event LivestockAnimal.VetVisitRecorded is {
        send event LivestockAnimal.VetVisitRecorded to outlet LivestockAnimalEventSplitToLivestockRepository
        send event LivestockAnimal.VetVisitRecorded to outlet LivestockAnimalEventSplitToHerdMetrics
        tell event LivestockAnimal.VetVisitRecorded to entity LivestockContext.LivestockAnimal
      }
      on event LivestockAnimal.HealthStatusUpdated is {
        send event LivestockAnimal.HealthStatusUpdated to outlet LivestockAnimalEventSplitToLivestockRepository
        send event LivestockAnimal.HealthStatusUpdated to outlet LivestockAnimalEventSplitToHerdMetrics
        tell event LivestockAnimal.HealthStatusUpdated to entity LivestockContext.LivestockAnimal
      }
      on event LivestockAnimal.BreedingRecorded is {
        send event LivestockAnimal.BreedingRecorded to outlet LivestockAnimalEventSplitToLivestockRepository
        send event LivestockAnimal.BreedingRecorded to outlet LivestockAnimalEventSplitToHerdMetrics
        tell event LivestockAnimal.BreedingRecorded to entity LivestockContext.LivestockAnimal
      }
      on event LivestockAnimal.FeedingRecorded is {
        send event LivestockAnimal.FeedingRecorded to outlet LivestockAnimalEventSplitToLivestockRepository
        send event LivestockAnimal.FeedingRecorded to outlet LivestockAnimalEventSplitToHerdMetrics
        tell event LivestockAnimal.FeedingRecorded to entity LivestockContext.LivestockAnimal
      }
      on event LivestockAnimal.HerdTransferred is {
        send event LivestockAnimal.HerdTransferred to outlet LivestockAnimalEventSplitToLivestockRepository
        send event LivestockAnimal.HerdTransferred to outlet LivestockAnimalEventSplitToHerdMetrics
        tell event LivestockAnimal.HerdTransferred to entity LivestockContext.LivestockAnimal
      }
      on event LivestockAnimal.AnimalSold is {
        send event LivestockAnimal.AnimalSold to outlet LivestockAnimalEventSplitToLivestockRepository
        send event LivestockAnimal.AnimalSold to outlet LivestockAnimalEventSplitToHerdMetrics
        tell event LivestockAnimal.AnimalSold to entity LivestockContext.LivestockAnimal
      }
      on event LivestockAnimal.DeathRecorded is {
        send event LivestockAnimal.DeathRecorded to outlet LivestockAnimalEventSplitToLivestockRepository
        send event LivestockAnimal.DeathRecorded to outlet LivestockAnimalEventSplitToHerdMetrics
        tell event LivestockAnimal.DeathRecorded to entity LivestockContext.LivestockAnimal
      }
      on other is {
        error "Unexpected message for processor LivestockAnimalEventSplit"
      }
    } with {
      briefly "LivestockAnimal event fan-out handler"
      described as {
        |Delivers each LivestockAnimal event to all of its consumers.
      }
    }
  } with {
    briefly "LivestockAnimal event fan-out"
    described as {
      |Fans LivestockAnimal events out to the repository and projectors.
    }
  }
  connector LinkLivestockAnimalToLivestockAnimalEventSplit is {
    from outlet LivestockContext.LivestockAnimal.LivestockAnimalEvents2 to
      inlet LivestockContext.LivestockAnimalEventSplit.LivestockAnimalEventSplitIn
  } with {
    briefly "LinkLivestockAnimalToLivestockAnimalEventSplit"
  }
  connector LinkLivestockAnimalEventSplitToLivestockRepository is {
    from outlet LivestockContext.LivestockAnimalEventSplit.LivestockAnimalEventSplitToLivestockRepository to
      inlet LivestockContext.LivestockRepository.LivestockRepositoryFromLivestockAnimal
  } with {
    briefly "LinkLivestockAnimalEventSplitToLivestockRepository"
  }
  connector LinkLivestockAnimalEventSplitToHerdMetrics is {
    from outlet LivestockContext.LivestockAnimalEventSplit.LivestockAnimalEventSplitToHerdMetrics to
      inlet LivestockContext.HerdMetrics.HerdMetricsFromLivestockAnimal
  } with {
    briefly "LinkLivestockAnimalEventSplitToHerdMetrics"
  }
  connector LinkHerdMetricsToLivestockRepository is {
    from outlet LivestockContext.HerdMetrics.HerdMetricsOut to
      inlet LivestockContext.LivestockRepository.LivestockRepositoryFromHerdMetrics
  } with {
    briefly "LinkHerdMetricsToLivestockRepository"
  }
} with {
  briefly "Bounded context for livestock management"
  described as {
    |Livestock tracking and management context.
  }
}
