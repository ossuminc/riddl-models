// Livestock Management - Livestock Context
context LivestockContext as router is {
  inlet LivestockAnimalCommandStreamIn is type LivestockAnimalCommand  outlet LivestockAnimalCommandStreamOut is type LivestockAnimalCommand
  inlet LivestockAnimalResultStreamIn is type LivestockAnimal.LivestockAnimalResult  outlet LivestockAnimalResultStreamOut is type LivestockAnimal.LivestockAnimalResult
  handler LivestockContextBoundary is {
    on registerAnimal: command LivestockAnimal.RegisterAnimal is {
      send registerAnimal to outlet LivestockContext.LivestockAnimalCommandStreamOut
    }
    on recordWeight: command LivestockAnimal.RecordWeight is {
      send recordWeight to outlet LivestockContext.LivestockAnimalCommandStreamOut
    }
    on recordVetVisit: command LivestockAnimal.RecordVetVisit is {
      send recordVetVisit to outlet LivestockContext.LivestockAnimalCommandStreamOut
    }
    on updateHealthStatus: command LivestockAnimal.UpdateHealthStatus is {
      send updateHealthStatus to outlet LivestockContext.LivestockAnimalCommandStreamOut
    }
    on recordBreeding: command LivestockAnimal.RecordBreeding is {
      send recordBreeding to outlet LivestockContext.LivestockAnimalCommandStreamOut
    }
    on recordFeeding: command LivestockAnimal.RecordFeeding is {
      send recordFeeding to outlet LivestockContext.LivestockAnimalCommandStreamOut
    }
    on transferHerd: command LivestockAnimal.TransferHerd is {
      send transferHerd to outlet LivestockContext.LivestockAnimalCommandStreamOut
    }
    on sellAnimal: command LivestockAnimal.SellAnimal is {
      send sellAnimal to outlet LivestockContext.LivestockAnimalCommandStreamOut
    }
    on recordDeath: command LivestockAnimal.RecordDeath is {
      send recordDeath to outlet LivestockContext.LivestockAnimalCommandStreamOut
    }
    on livestockAnimalResult: result LivestockAnimal.LivestockAnimalResult is {
      send livestockAnimalResult to outlet LivestockContext.LivestockAnimalResultStreamOut
    }
    on other is {
      error "Unexpected message at the LivestockContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'LivestockAnimalCommand Stream Intake' is from outlet LivestockContext.LivestockAnimalCommandStreamOut to inlet LivestockContext.LivestockAnimal.LivestockAnimalCommands  connector 'LivestockAnimalResult Stream Egress' is from outlet LivestockContext.LivestockRepository.LivestockRepositoryResponses to inlet LivestockContext.LivestockAnimalResultStreamIn  adaptor FromMarketExchange from context MarketExchange is { 
    handler FromMarketExchangeHandler is {
      on event MarketExchange.AnimalListed is {
        do "the model receives animal listed"
      }
      on result MarketExchange.MarketPrices is {
        do "the model receives market prices"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketExchange"
      }
    } with {
      briefly "from market exchange"
      described as {
        |Carries messages from the external MarketExchange.
      }
    }
  } with {
    briefly "MarketExchange integration"
    described as {
      |The model's side of the MarketExchange conversation.
    }
  }
  adaptor ToMarketExchange to context MarketExchange is { 
    handler ToMarketExchangeHandler is {
      on query MarketExchange.GetMarketPrices is {
        do "the model sends get market prices"
      }
      on command MarketExchange.ListAnimalForSale is {
        do "the model sends list animal for sale"
      }
      on other is {
        error "Unexpected message for adaptor ToMarketExchange"
      }
    } with {
      briefly "to market exchange"
      described as {
        |Carries messages to the external MarketExchange.
      }
    }
  } with {
    briefly "MarketExchange integration"
    described as {
      |The model's side of the MarketExchange conversation.
    }
  }
  adaptor FromVeterinarySystem from context VeterinarySystem is { 
    handler FromVeterinarySystemHandler is {
      on event VeterinarySystem.InspectionScheduled is {
        do "the model receives inspection scheduled"
      }
      on result VeterinarySystem.VaccinationHistory is {
        do "the model receives vaccination history"
      }
      on other is {
        error "Unexpected message for adaptor FromVeterinarySystem"
      }
    } with {
      briefly "from veterinary system"
      described as {
        |Carries messages from the external VeterinarySystem.
      }
    }
  } with {
    briefly "VeterinarySystem integration"
    described as {
      |The model's side of the VeterinarySystem conversation.
    }
  }
  adaptor ToVeterinarySystem to context VeterinarySystem is { 
    handler ToVeterinarySystemHandler is {
      on query VeterinarySystem.GetVaccinationHistory is {
        do "the model sends get vaccination history"
      }
      on command VeterinarySystem.RequestVetInspection is {
        do "the model sends request vet inspection"
      }
      on other is {
        error "Unexpected message for adaptor ToVeterinarySystem"
      }
    } with {
      briefly "to veterinary system"
      described as {
        |Carries messages to the external VeterinarySystem.
      }
    }
  } with {
    briefly "VeterinarySystem integration"
    described as {
      |The model's side of the VeterinarySystem conversation.
    }
  }
  include "types.riddl"
  include "LivestockAnimal.riddl"
  type LivestockRepositoryCommand is one of {
    LivestockContext.LivestockRepository.PersistAnimalRegistered or LivestockContext.LivestockRepository.PersistAnimalSold or LivestockContext.LivestockRepository.PersistBreedingRecorded or LivestockContext.LivestockRepository.PersistDeathRecorded or LivestockContext.LivestockRepository.PersistFeedingRecorded or LivestockContext.LivestockRepository.PersistHealthStatusUpdated or LivestockContext.LivestockRepository.PersistHerdTransferred or LivestockContext.LivestockRepository.PersistVetVisitRecorded or LivestockContext.LivestockRepository.PersistWeightRecorded
  } with {
    briefly "Anything that writes LivestockRepository"
    described as {
      |The persistence commands LivestockRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository LivestockRepository as flow is {
    inlet LivestockRepositoryFromHerdMetrics is type LivestockRepositoryCommand
    command PersistBreedingRecorded is  {
      animalId: AnimalId with {
        briefly "Row addressed"
        described as {
          |Which stored row BreedingRecorded applies to.
        }
      }
    } with {
      briefly "Persist BreedingRecorded"
      described as {
        |Instructs this repository to apply BreedingRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFeedingRecorded is  {
      animalId: AnimalId with {
        briefly "Row addressed"
        described as {
          |Which stored row FeedingRecorded applies to.
        }
      }
    } with {
      briefly "Persist FeedingRecorded"
      described as {
        |Instructs this repository to apply FeedingRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHealthStatusUpdated is  {
      animalId: AnimalId with {
        briefly "Row addressed"
        described as {
          |Which stored row HealthStatusUpdated applies to.
        }
      }
    } with {
      briefly "Persist HealthStatusUpdated"
      described as {
        |Instructs this repository to apply HealthStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHerdTransferred is  {
      animalId: AnimalId with {
        briefly "Row addressed"
        described as {
          |Which stored row HerdTransferred applies to.
        }
      }
    } with {
      briefly "Persist HerdTransferred"
      described as {
        |Instructs this repository to apply HerdTransferred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVetVisitRecorded is  {
      animalId: AnimalId with {
        briefly "Row addressed"
        described as {
          |Which stored row VetVisitRecorded applies to.
        }
      }
    } with {
      briefly "Persist VetVisitRecorded"
      described as {
        |Instructs this repository to apply VetVisitRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAnimalRegistered is  {
      animalId: AnimalId with {
        briefly "Row addressed"
        described as {
          |Which stored row AnimalRegistered applies to.
        }
      }
    } with {
      briefly "Persist AnimalRegistered"
      described as {
        |Instructs this repository to apply AnimalRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAnimalSold is  {
      animalId: AnimalId with {
        briefly "Row addressed"
        described as {
          |Which stored row AnimalSold applies to.
        }
      }
    } with {
      briefly "Persist AnimalSold"
      described as {
        |Instructs this repository to apply AnimalSold to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeathRecorded is  {
      animalId: AnimalId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeathRecorded applies to.
        }
      }
    } with {
      briefly "Persist DeathRecorded"
      described as {
        |Instructs this repository to apply DeathRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWeightRecorded is  {
      animalId: AnimalId with {
        briefly "Row addressed"
        described as {
          |Which stored row WeightRecorded applies to.
        }
      }
    } with {
      briefly "Persist WeightRecorded"
      described as {
        |Instructs this repository to apply WeightRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet LivestockRepositoryResponses is type LivestockAnimal.LivestockAnimalResult
    record StoredLivestockAnimal is  {
      livestockAnimalId: UUID with {
        briefly "livestockAnimalId"
        described as {
          |The livestockAnimalId column of the stored livestockAnimal row.
        }
      }
      animalId: AnimalId with {
        briefly "animalId"
        described as {
          |The animalId column of the stored livestockAnimal row.
        }
      }
      animalInfo: AnimalInfo with {
        briefly "animalInfo"
        described as {
          |The animalInfo column of the stored livestockAnimal row.
        }
      }
      healthStatus: HealthStatus with {
        briefly "healthStatus"
        described as {
          |The healthStatus column of the stored livestockAnimal row.
        }
      }
    } with {
      briefly "Stored livestockAnimal row"
      described as {
        |The persistence shape of livestockAnimal data as this repository stores it.
      }
    }
    schema LivestockData is relational
      of livestockAnimals as type StoredLivestockAnimal
        index on field StoredLivestockAnimal.animalId
        index on field StoredLivestockAnimal.animalInfo.herdId
        index on field StoredLivestockAnimal.healthStatus
 with {
      briefly "Livestock data schema"
      described as {
        |The relational schema holding livestock data for the LivestockRepository.
      }
    }
    handler LivestockPersistence is {
      on persistBreedingRecorded: command PersistBreedingRecorded is {
        do "apply BreedingRecorded to the stored row"
      }
      on persistFeedingRecorded: command PersistFeedingRecorded is {
        do "apply FeedingRecorded to the stored row"
      }
      on persistHealthStatusUpdated: command PersistHealthStatusUpdated is {
        do "apply HealthStatusUpdated to the stored row"
      }
      on persistHerdTransferred: command PersistHerdTransferred is {
        do "apply HerdTransferred to the stored row"
      }
      on persistVetVisitRecorded: command PersistVetVisitRecorded is {
        do "apply VetVisitRecorded to the stored row"
      }
      on persistAnimalRegistered: command PersistAnimalRegistered is {
        do "apply AnimalRegistered to the stored row"
      }
      on persistAnimalSold: command PersistAnimalSold is {
        do "apply AnimalSold to the stored row"
      }
      on persistDeathRecorded: command PersistDeathRecorded is {
        do "apply DeathRecorded to the stored row"
      }
      on persistWeightRecorded: command PersistWeightRecorded is {
        do "apply WeightRecorded to the stored row"
      }
      on query GetHerdMetricsData is {
        let herdMetricsDataView: type HerdMetricsDataView = prompt("read the herd metrics data projection")
        reply herdMetricsDataView
      }
    } with {
      briefly "Persists livestock commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Livestock data persistence"
    described as {
      |Persistent storage for livestock data.
    }
  }
  query GetHerdMetricsData replies result HerdMetricsDataView is  {
    herdMetricsDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which herd metrics data to retrieve.
      }
    }
  } with {
    briefly "Get herd metrics data"
    described as {
      |Retrieves the herd metrics data projection.
    }
  }
  result HerdMetricsDataView is  {
    herdMetricsData: HerdMetrics.HerdMetricsData with {
      briefly "Herd metrics data"
      described as {
        |The herd metrics data being returned.
      }
    }
  } with {
    briefly "Herd metrics data view"
    described as {
      |Read model view carrying the herd metrics data projection.
    }
  }
  projector HerdMetrics as flow is {
    outlet HerdMetricsToRepository is type LivestockRepositoryCommand
    updates repository LivestockContext.LivestockRepository
    inlet HerdMetricsFromLivestockAnimal is type LivestockAnimalEvent
    record HerdMetricsData is  {
      totalAnimals: Natural with {
        briefly "Total"
        described as {
          |Total active animals.
        }
      }
      totalSold: Natural with {
        briefly "Sold"
        described as {
          |Total animals sold.
        }
      }
      totalDeceased: Natural with {
        briefly "Deceased"
        described as {
          |Total deceased animals.
        }
      }
      averageWeight: Decimal(8,2) with {
        briefly "Avg weight"
        described as {
          |Average weight in kilograms.
        }
      }
      breedingCount: Natural with {
        briefly "Breeding"
        described as {
          |Animals in breeding program.
        }
      }
    } with {
      briefly "Herd metrics"
      described as {
        |Aggregate herd statistics.
      }
    }
    handler HerdMetricsHandler is {
      on breedingRecorded: event LivestockAnimal.BreedingRecorded is {
        tell command LivestockContext.LivestockRepository.PersistBreedingRecorded(animalId = breedingRecorded.animalId) to repository LivestockContext.LivestockRepository
        do "apply BreedingRecorded to the HerdMetrics projection"
      }
      on feedingRecorded: event LivestockAnimal.FeedingRecorded is {
        tell command LivestockContext.LivestockRepository.PersistFeedingRecorded(animalId = feedingRecorded.animalId) to repository LivestockContext.LivestockRepository
        do "apply FeedingRecorded to the HerdMetrics projection"
      }
      on healthStatusUpdated: event LivestockAnimal.HealthStatusUpdated is {
        tell command LivestockContext.LivestockRepository.PersistHealthStatusUpdated(animalId = healthStatusUpdated.animalId) to repository LivestockContext.LivestockRepository
        do "apply HealthStatusUpdated to the HerdMetrics projection"
      }
      on herdTransferred: event LivestockAnimal.HerdTransferred is {
        tell command LivestockContext.LivestockRepository.PersistHerdTransferred(animalId = herdTransferred.animalId) to repository LivestockContext.LivestockRepository
        do "apply HerdTransferred to the HerdMetrics projection"
      }
      on vetVisitRecorded: event LivestockAnimal.VetVisitRecorded is {
        tell command LivestockContext.LivestockRepository.PersistVetVisitRecorded(animalId = vetVisitRecorded.animalId) to repository LivestockContext.LivestockRepository
        do "apply VetVisitRecorded to the HerdMetrics projection"
      }
      on animalRegistered: event LivestockAnimal.AnimalRegistered is {
        tell command LivestockContext.LivestockRepository.PersistAnimalRegistered(animalId = animalRegistered.animalId) to repository LivestockContext.LivestockRepository
        do "Increment total animals"
      }
      on weightRecorded: event LivestockAnimal.WeightRecorded is {
        tell command LivestockContext.LivestockRepository.PersistWeightRecorded(animalId = weightRecorded.animalId) to repository LivestockContext.LivestockRepository
        do "Recalculate average weight"
      }
      on animalSold: event LivestockAnimal.AnimalSold is {
        tell command LivestockContext.LivestockRepository.PersistAnimalSold(animalId = animalSold.animalId) to repository LivestockContext.LivestockRepository
        do "Increment sold and decrement active"
      }
      on deathRecorded: event LivestockAnimal.DeathRecorded is {
        tell command LivestockContext.LivestockRepository.PersistDeathRecorded(animalId = deathRecorded.animalId) to repository LivestockContext.LivestockRepository
        do "Increment deceased and decrement active"
      }
    } with {
      briefly "Maintains herd metrics"
      described as {
        |Projects events into herd statistics.
      }
    }
  } with {
    briefly "Herd metrics"
    described as {
      |Livestock herd analytics.
    }
  }
  // ---- Event publication for LivestockAnimal ----
  type LivestockAnimalEvent is one of {
    LivestockContext.LivestockAnimal.AnimalRegistered or LivestockContext.LivestockAnimal.WeightRecorded or LivestockContext.LivestockAnimal.VetVisitRecorded or LivestockContext.LivestockAnimal.HealthStatusUpdated or LivestockContext.LivestockAnimal.BreedingRecorded or LivestockContext.LivestockAnimal.FeedingRecorded or LivestockContext.LivestockAnimal.HerdTransferred or LivestockContext.LivestockAnimal.AnimalSold or LivestockContext.LivestockAnimal.DeathRecorded
  } with {
    briefly "LivestockAnimal event alternation"
    described as {
      |Union of all LivestockAnimal events, for streaming and event-sourced
      |persistence.
    }
  }
  processor LivestockAnimalEventSplit as flow is {
    inlet LivestockAnimalEventSplitIn is type LivestockAnimalEvent
    outlet LivestockAnimalEventSplitToHerdMetrics is type LivestockAnimalEvent
    handler LivestockAnimalEventSplitHandler is {
      on animalRegistered: event LivestockAnimal.AnimalRegistered is {
        send animalRegistered to outlet LivestockAnimalEventSplitToHerdMetrics
        tell animalRegistered to entity LivestockContext.LivestockAnimal
      }
      on weightRecorded: event LivestockAnimal.WeightRecorded is {
        send weightRecorded to outlet LivestockAnimalEventSplitToHerdMetrics
        tell weightRecorded to entity LivestockContext.LivestockAnimal
      }
      on vetVisitRecorded: event LivestockAnimal.VetVisitRecorded is {
        send vetVisitRecorded to outlet LivestockAnimalEventSplitToHerdMetrics
        tell vetVisitRecorded to entity LivestockContext.LivestockAnimal
      }
      on healthStatusUpdated: event LivestockAnimal.HealthStatusUpdated is {
        send healthStatusUpdated to outlet LivestockAnimalEventSplitToHerdMetrics
        tell healthStatusUpdated to entity LivestockContext.LivestockAnimal
      }
      on breedingRecorded: event LivestockAnimal.BreedingRecorded is {
        send breedingRecorded to outlet LivestockAnimalEventSplitToHerdMetrics
        tell breedingRecorded to entity LivestockContext.LivestockAnimal
      }
      on feedingRecorded: event LivestockAnimal.FeedingRecorded is {
        send feedingRecorded to outlet LivestockAnimalEventSplitToHerdMetrics
        tell feedingRecorded to entity LivestockContext.LivestockAnimal
      }
      on herdTransferred: event LivestockAnimal.HerdTransferred is {
        send herdTransferred to outlet LivestockAnimalEventSplitToHerdMetrics
        tell herdTransferred to entity LivestockContext.LivestockAnimal
      }
      on animalSold: event LivestockAnimal.AnimalSold is {
        send animalSold to outlet LivestockAnimalEventSplitToHerdMetrics
        tell animalSold to entity LivestockContext.LivestockAnimal
      }
      on deathRecorded: event LivestockAnimal.DeathRecorded is {
        send deathRecorded to outlet LivestockAnimalEventSplitToHerdMetrics
        tell deathRecorded to entity LivestockContext.LivestockAnimal
      }
      on other is {
        error "Unexpected message for processor LivestockAnimalEventSplit"
      }
    } with {
      briefly "LivestockAnimal event fan-out handler"
      described as {
        |Delivers each LivestockAnimal event to all of its consumers.
      }
    }
  } with {
    briefly "LivestockAnimal event fan-out"
    described as {
      |Fans LivestockAnimal events out to the repository and projectors.
    }
  }
  connector 'LivestockAnimalEvent Stream' is from outlet LivestockContext.LivestockAnimal.LivestockAnimalEvents2 to inlet LivestockContext.LivestockAnimalEventSplit.LivestockAnimalEventSplitIn with {
    briefly "LivestockAnimal events, fanned out to storage and read models"
  }
  connector 'HerdMetrics Feed' is from outlet LivestockContext.LivestockAnimalEventSplit.LivestockAnimalEventSplitToHerdMetrics to inlet LivestockContext.HerdMetrics.HerdMetricsFromLivestockAnimal with {
    briefly "LivestockAnimal events feeding the HerdMetrics projection"
  }
  connector 'HerdMetrics Storage' is from outlet LivestockContext.HerdMetrics.HerdMetricsToRepository to inlet LivestockContext.LivestockRepository.LivestockRepositoryFromHerdMetrics with {
    briefly "HerdMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for livestock management"
  described as {
    |Livestock tracking and management context.
  }
}
