// Livestock Management Domain Model
// Herd tracking, breeding, veterinary, feed, and sales management
domain LivestockManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user RanchManager is "person overseeing livestock operations" with {
    briefly "Ranch Manager"
    described as {
      |Manager responsible for overall herd operations.
    }
  }
  user Veterinarian is "person providing animal health care" with {
    briefly "Veterinarian"
    described as {
      |Veterinary professional treating animals.
    }
  }
  user FeedOperator is "person managing feed and nutrition" with {
    briefly "Feed Operator"
    described as {
      |Operator handling feed inventory and schedules.
    }
  }
  epic HerdManagement is {
    user RanchManager wants to "to track and manage livestock" so that "herd health and productivity are optimized"
    case RegisterNewAnimal is {
      user RanchManager wants to "to register a new animal in the herd" so that "the animal is tracked from intake onward"
      step is "Manager enters" "animal details" "into system" with {
        briefly "Enter details"
        described as {
          |Record animal info.
        }
      }
      step is "System registers" "the animal" "in the herd" with {
        briefly "Register animal"
        described as {
          |Create animal record.
        }
      }
    } with {
      briefly "Register new animal"
      described as {
        |Registering a new animal into the herd.
      }
    }
  } with {
    briefly "Herd management"
    described as {
      |Epic for livestock tracking and management.
    }
  }
  include "LivestockContext.riddl"
  include "external-contexts.riddl"
  application context LivestockManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in LivestockManagement are delivered.
      }
    }
    outlet AppLivestockAnimalCommands is type LivestockContext.LivestockAnimal.LivestockAnimalCommand
    inlet AppLivestockRepositoryResponses is type LivestockContext.LivestockAnimal.LivestockAnimalResult    handler LivestockManagementAppHandler is {
      on other is {
        error "Unexpected message for application context LivestockManagementApp"
      }
    } with {
      briefly "LivestockManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "LivestockManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'LivestockAnimalCommand Stream' is from outlet LivestockManagementApp.AppLivestockAnimalCommands to inlet LivestockContext.LivestockAnimalCommandStreamIn with {
    briefly "LivestockAnimal commands from the application"
  }
  persistent connector 'LivestockAnimalResult Stream' is from outlet LivestockContext.LivestockAnimalResultStreamOut to inlet LivestockManagementApp.AppLivestockRepositoryResponses with {
    briefly "Livestock query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet LivestockManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Livestock management domain"
  described as {
    |Herd tracking, breeding, veterinary, feed, and sales.
  }
}
