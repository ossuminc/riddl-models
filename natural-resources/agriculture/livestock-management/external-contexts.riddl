// Livestock Management - External Contexts
external context VeterinarySystem as flow is {
  outlet VeterinarySystemEventsOut is event InspectionScheduled
 with {
    briefly "What this service tells the model, unasked"
  }
  type VeterinarySystemRequest is one of {
    RequestVetInspection or GetVaccinationHistory
  } with {
    briefly "Everything this service can be asked"
  }
  inlet VeterinarySystemRequests is type VeterinarySystemRequest with {
    briefly "What this context asks the service to send"
  }
  handler VeterinarySystemBoundary is {
    on query GetVaccinationHistory is {
      let askAnswer: type VaccinationHistory = prompt("look up what GetVaccinationHistory asks for")
      reply askAnswer
    }
    on command RequestVetInspection is {
      let inspectionScheduled: type InspectionScheduled = prompt("the inspection scheduled this produces")
      send inspectionScheduled to outlet VeterinarySystem.VeterinarySystemEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context VeterinarySystem"
    }
  } with {
    briefly "VeterinarySystem boundary"
  }
  command RequestVetInspection is {
    animalId: AnimalId with {
      briefly "Animal"
      described as {
        |Animal ID.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Reason for inspection.
      }
    }
    urgency: String(3,50) with {
      briefly "Urgency"
      described as {
        |Inspection urgency.
      }
    }
  } with {
    briefly "Request vet inspection"
    described as {
      |Requests a veterinary inspection.
    }
  }
  event InspectionScheduled is {
    animalId: AnimalId with {
      briefly "Animal"
      described as {
        |Animal ID.
      }
    }
    scheduledDate: Date with {
      briefly "Scheduled"
      described as {
        |Scheduled inspection date.
      }
    }
    veterinarian: String(3,100) with {
      briefly "Vet"
      described as {
        |Assigned veterinarian.
      }
    }
  } with {
    briefly "Inspection scheduled"
    described as {
      |Emitted when inspection is scheduled.
    }
  }
  query GetVaccinationHistory replies result VaccinationHistory is {
    animalId: AnimalId with {
      briefly "Animal"
      described as {
        |Animal ID.
      }
    }
  } with {
    briefly "Get vaccination history"
    described as {
      |Retrieves vaccination records.
    }
  }
  result VaccinationHistory is {
    animalId: AnimalId with {
      briefly "Animal"
      described as {
        |Animal ID.
      }
    }
    vaccinations: String(3,200)+ with {
      briefly "Vaccinations"
      described as {
        |Vaccination records.
      }
    }
  } with {
    briefly "Vaccination history"
    described as {
      |Animal vaccination records.
    }
  }
} with {
  briefly "External veterinary system"
  described as {
    |Veterinary clinic management system.
  }
}
external context MarketExchange as flow is {
  outlet MarketExchangeEventsOut is event AnimalListed
 with {
    briefly "What this service tells the model, unasked"
  }
  type MarketExchangeRequest is one of {
    ListAnimalForSale or GetMarketPrices
  } with {
    briefly "Everything this service can be asked"
  }
  inlet MarketExchangeRequests is type MarketExchangeRequest with {
    briefly "What this context asks the service to send"
  }
  handler MarketExchangeBoundary is {
    on query GetMarketPrices is {
      let askAnswer: type MarketPrices = prompt("look up what GetMarketPrices asks for")
      reply askAnswer
    }
    on command ListAnimalForSale is {
      let animalListed: type AnimalListed = prompt("the animal listed this produces")
      send animalListed to outlet MarketExchange.MarketExchangeEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context MarketExchange"
    }
  } with {
    briefly "MarketExchange boundary"
  }
  command ListAnimalForSale is {
    animalId: AnimalId with {
      briefly "Animal"
      described as {
        |Animal ID.
      }
    }
    species: Species with {
      briefly "Species"
      described as {
        |Animal species.
      }
    }
    breed: String(3,100) with {
      briefly "Breed"
      described as {
        |Animal breed.
      }
    }
    weight: Decimal(8,2) with {
      briefly "Weight"
      described as {
        |Animal weight.
      }
    }
    askingPrice: Decimal(10,2) with {
      briefly "Price"
      described as {
        |Asking price.
      }
    }
  } with {
    briefly "List animal for sale"
    described as {
      |Lists an animal on the market exchange.
    }
  }
  event AnimalListed is {
    animalId: AnimalId with {
      briefly "Animal"
      described as {
        |Animal ID.
      }
    }
    listingId: UUID with {
      briefly "Listing"
      described as {
        |Market listing ID.
      }
    }
    listedAt: TimeStamp with {
      briefly "Listed"
      described as {
        |Listing time.
      }
    }
  } with {
    briefly "Animal listed"
    described as {
      |Emitted when animal is listed for sale.
    }
  }
  query GetMarketPrices replies result MarketPrices is {
    species: Species with {
      briefly "Species"
      described as {
        |Animal species.
      }
    }
    breed: String(3,100) with {
      briefly "Breed"
      described as {
        |Animal breed.
      }
    }
  } with {
    briefly "Get market prices"
    described as {
      |Gets current market prices.
    }
  }
  result MarketPrices is {
    species: Species with {
      briefly "Species"
      described as {
        |Animal species.
      }
    }
    averagePrice: Decimal(10,2) with {
      briefly "Avg price"
      described as {
        |Average market price.
      }
    }
    pricePerKg: Decimal(8,2) with {
      briefly "Price per kg"
      described as {
        |Price per kilogram.
      }
    }
  } with {
    briefly "Market prices"
    described as {
      |Current market price information.
    }
  }
} with {
  briefly "External market exchange"
  described as {
    |Livestock market and auction exchange.
  }
}
