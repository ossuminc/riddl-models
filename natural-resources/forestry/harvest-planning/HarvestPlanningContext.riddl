// Harvest Planning - Harvest Planning Context
context HarvestPlanningContext is {
  include "types.riddl"
  include "HarvestBlock.riddl"
  repository HarvestPlanningRepository is {
    inlet HarvestPlanningRepositoryFromHarvestBlock is type HarvestBlockEvent
    inlet HarvestPlanningRepositoryFromHarvestMetrics is type HarvestBlockEvent
    outlet HarvestPlanningRepositoryResponses is type HarvestBlock.HarvestBlockResult
    schema HarvestPlanningData is relational
      of harvestBlocks as type HarvestBlock
        index on field HarvestBlock.blockId
        index on field HarvestBlock.standAssessment.standId
        index on field HarvestBlock.status
      with {
      briefly "Harvest planning data schema"
      described as {
        |The relational schema holding harvest planning data for the HarvestPlanningRepository.
      }
    }

    handler HarvestPlanningPersistence is {
      on command HarvestBlock.CreateHarvestBlock is {
        tell event HarvestBlock.HarvestBlockCreated to entity HarvestPlanningContext.HarvestBlock
        do "Store new harvest block"
      }
      on command HarvestBlock.DelineateBlock is {
        do "Update block boundary"
      }
      on command HarvestBlock.RecordReviewOutcome is {
        tell event HarvestBlock.ReviewOutcomeRecorded to entity HarvestPlanningContext.HarvestBlock
        do "Store environmental review outcome"
      }
      on command HarvestBlock.ScheduleHarvest is {
        tell event HarvestBlock.HarvestScheduled to entity HarvestPlanningContext.HarvestBlock
        do "Store harvest schedule"
      }
      on command HarvestBlock.CompleteHarvest is {
        tell event HarvestBlock.HarvestCompleted to entity HarvestPlanningContext.HarvestBlock
        do "Update block to completed"
      }
      on command HarvestBlock.PlanReforestation is {
        do "Store reforestation plan"
      }
    } with {
      briefly "Persists harvest planning events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Harvest planning data persistence"
    described as {
      |Persistent storage for harvest planning.
    }
  }
  projector HarvestMetrics is {
    inlet HarvestMetricsFromHarvestBlock is type HarvestBlockEvent
    outlet HarvestMetricsOut is type HarvestBlockEvent
    updates repository HarvestPlanningContext.HarvestPlanningRepository
    record BlockMetrics is  {
      blocksProposed: Natural with {
        briefly "Proposed"
        described as {
          |Blocks proposed.
        }
      }
      blocksApproved: Natural with {
        briefly "Approved"
        described as {
          |Blocks approved.
        }
      }
      blocksCompleted: Natural with {
        briefly "Completed"
        described as {
          |Blocks harvested.
        }
      }
      blocksRejected: Natural with {
        briefly "Rejected"
        described as {
          |Blocks rejected.
        }
      }
      totalVolumeHarvested: Decimal(12,2) with {
        briefly "Volume"
        described as {
          |Total volume harvested.
        }
      }
      averageBlockArea: Decimal(8,2) with {
        briefly "Avg area"
        described as {
          |Average block area in hectares.
        }
      }
    } with {
      briefly "Block metrics"
      described as {
        |Harvest block processing metrics.
      }
    }
    handler MetricsHandler is {
      on event HarvestBlock.HarvestBlockCreated is {
        tell event HarvestBlock.HarvestBlockCreated to repository HarvestPlanningContext.HarvestPlanningRepository
        do "Increment blocks proposed"
      }
      on event HarvestBlock.ReviewOutcomeRecorded is {
        tell event HarvestBlock.ReviewOutcomeRecorded to repository HarvestPlanningContext.HarvestPlanningRepository
        do "Increment blocks approved or rejected"
      }
      on event HarvestBlock.HarvestCompleted is {
        tell event HarvestBlock.HarvestCompleted to repository HarvestPlanningContext.HarvestPlanningRepository
        do "Increment blocks completed and add volume"
      }
    } with {
      briefly "Maintains harvest metrics"
      described as {
        |Projects events into harvest metrics.
      }
    }
  } with {
    briefly "Harvest metrics"
    described as {
      |Harvest planning analytics.
    }
  }
  // ---- Event publication for HarvestBlock ----
  type HarvestBlockEvent is one of {
    HarvestPlanningContext.HarvestBlock.HarvestBlockCreated,
    HarvestPlanningContext.HarvestBlock.BlockDelineated,
    HarvestPlanningContext.HarvestBlock.EnvironmentalReviewSubmitted,
    HarvestPlanningContext.HarvestBlock.ReviewOutcomeRecorded,
    HarvestPlanningContext.HarvestBlock.HarvestScheduled,
    HarvestPlanningContext.HarvestBlock.ContractorAssigned,
    HarvestPlanningContext.HarvestBlock.HarvestBegan,
    HarvestPlanningContext.HarvestBlock.HarvestCompleted,
    HarvestPlanningContext.HarvestBlock.ReforestationPlanned,
    HarvestPlanningContext.HarvestBlock.BlockRejected
  } with {
    briefly "HarvestBlock event alternation"
    described as {
      |Union of all HarvestBlock events, for streaming and event-sourced
      |persistence.
    }
  }
  processor HarvestBlockEventSource as source is {
    outlet HarvestBlockEvents is type HarvestBlockEvent
    handler HarvestBlockSourceHandler is {
      on event HarvestBlock.HarvestBlockCreated is {
        send event HarvestBlock.HarvestBlockCreated to outlet HarvestBlockEvents
      }
      on event HarvestBlock.BlockDelineated is {
        send event HarvestBlock.BlockDelineated to outlet HarvestBlockEvents
      }
      on event HarvestBlock.EnvironmentalReviewSubmitted is {
        send event HarvestBlock.EnvironmentalReviewSubmitted to outlet HarvestBlockEvents
      }
      on event HarvestBlock.ReviewOutcomeRecorded is {
        send event HarvestBlock.ReviewOutcomeRecorded to outlet HarvestBlockEvents
      }
      on event HarvestBlock.HarvestScheduled is {
        send event HarvestBlock.HarvestScheduled to outlet HarvestBlockEvents
      }
      on event HarvestBlock.ContractorAssigned is {
        send event HarvestBlock.ContractorAssigned to outlet HarvestBlockEvents
      }
      on event HarvestBlock.HarvestBegan is {
        send event HarvestBlock.HarvestBegan to outlet HarvestBlockEvents
      }
      on event HarvestBlock.HarvestCompleted is {
        send event HarvestBlock.HarvestCompleted to outlet HarvestBlockEvents
      }
      on event HarvestBlock.ReforestationPlanned is {
        send event HarvestBlock.ReforestationPlanned to outlet HarvestBlockEvents
      }
      on event HarvestBlock.BlockRejected is {
        send event HarvestBlock.BlockRejected to outlet HarvestBlockEvents
      }
      on other is {
        error "Unexpected message for source HarvestBlockEventSource"
      }
    } with {
      briefly "HarvestBlock source handler"
      described as {
        |Publishes HarvestBlock events onto the outlet.
      }
    }
  } with {
    briefly "HarvestBlock event source"
    described as {
      |Publishes HarvestBlock entity events into the streaming topology.
    }
  }
  processor HarvestBlockEventSink as sink is {
    inlet HarvestBlockInlet is type HarvestBlockEvent
    handler HarvestBlockSinkHandler is {
      on event HarvestBlock.HarvestBlockCreated is {
        tell event HarvestBlock.HarvestBlockCreated to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on event HarvestBlock.BlockDelineated is {
        tell event HarvestBlock.BlockDelineated to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on event HarvestBlock.EnvironmentalReviewSubmitted is {
        tell event HarvestBlock.EnvironmentalReviewSubmitted to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on event HarvestBlock.ReviewOutcomeRecorded is {
        tell event HarvestBlock.ReviewOutcomeRecorded to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on event HarvestBlock.HarvestScheduled is {
        tell event HarvestBlock.HarvestScheduled to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on event HarvestBlock.ContractorAssigned is {
        tell event HarvestBlock.ContractorAssigned to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on event HarvestBlock.HarvestBegan is {
        tell event HarvestBlock.HarvestBegan to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on event HarvestBlock.HarvestCompleted is {
        tell event HarvestBlock.HarvestCompleted to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on event HarvestBlock.ReforestationPlanned is {
        tell event HarvestBlock.ReforestationPlanned to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on event HarvestBlock.BlockRejected is {
        tell event HarvestBlock.BlockRejected to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on other is {
        error "Unexpected message for sink HarvestBlockEventSink"
      }
    } with {
      briefly "HarvestBlock sink handler"
      described as {
        |Persists HarvestBlock events via the repository.
      }
    }
  } with {
    briefly "HarvestBlock event sink"
    described as {
      |Receives HarvestBlock events for persistence.
    }
  }
  connector HarvestBlockEventFlow is {
    from outlet HarvestPlanningContext.HarvestBlockEventSource.HarvestBlockEvents to
      inlet HarvestPlanningContext.HarvestBlockEventSink.HarvestBlockInlet
  } with {
    briefly "HarvestBlock event flow"
    described as {
      |Connects the HarvestBlock source to its sink.
    }
  }
  processor HarvestBlockEventSplit is {
    inlet HarvestBlockEventSplitIn is type HarvestBlockEvent
    outlet HarvestBlockEventSplitToHarvestPlanningRepository is type HarvestBlockEvent
    outlet HarvestBlockEventSplitToHarvestMetrics is type HarvestBlockEvent
    handler HarvestBlockEventSplitHandler is {
      on event HarvestBlock.HarvestBlockCreated is {
        send event HarvestBlock.HarvestBlockCreated to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send event HarvestBlock.HarvestBlockCreated to outlet HarvestBlockEventSplitToHarvestMetrics
        tell event HarvestBlock.HarvestBlockCreated to entity HarvestPlanningContext.HarvestBlock
      }
      on event HarvestBlock.BlockDelineated is {
        send event HarvestBlock.BlockDelineated to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send event HarvestBlock.BlockDelineated to outlet HarvestBlockEventSplitToHarvestMetrics
        tell event HarvestBlock.BlockDelineated to entity HarvestPlanningContext.HarvestBlock
      }
      on event HarvestBlock.EnvironmentalReviewSubmitted is {
        send event HarvestBlock.EnvironmentalReviewSubmitted to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send event HarvestBlock.EnvironmentalReviewSubmitted to outlet HarvestBlockEventSplitToHarvestMetrics
        tell event HarvestBlock.EnvironmentalReviewSubmitted to entity HarvestPlanningContext.HarvestBlock
      }
      on event HarvestBlock.ReviewOutcomeRecorded is {
        send event HarvestBlock.ReviewOutcomeRecorded to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send event HarvestBlock.ReviewOutcomeRecorded to outlet HarvestBlockEventSplitToHarvestMetrics
        tell event HarvestBlock.ReviewOutcomeRecorded to entity HarvestPlanningContext.HarvestBlock
      }
      on event HarvestBlock.HarvestScheduled is {
        send event HarvestBlock.HarvestScheduled to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send event HarvestBlock.HarvestScheduled to outlet HarvestBlockEventSplitToHarvestMetrics
        tell event HarvestBlock.HarvestScheduled to entity HarvestPlanningContext.HarvestBlock
      }
      on event HarvestBlock.ContractorAssigned is {
        send event HarvestBlock.ContractorAssigned to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send event HarvestBlock.ContractorAssigned to outlet HarvestBlockEventSplitToHarvestMetrics
        tell event HarvestBlock.ContractorAssigned to entity HarvestPlanningContext.HarvestBlock
      }
      on event HarvestBlock.HarvestBegan is {
        send event HarvestBlock.HarvestBegan to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send event HarvestBlock.HarvestBegan to outlet HarvestBlockEventSplitToHarvestMetrics
        tell event HarvestBlock.HarvestBegan to entity HarvestPlanningContext.HarvestBlock
      }
      on event HarvestBlock.HarvestCompleted is {
        send event HarvestBlock.HarvestCompleted to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send event HarvestBlock.HarvestCompleted to outlet HarvestBlockEventSplitToHarvestMetrics
        tell event HarvestBlock.HarvestCompleted to entity HarvestPlanningContext.HarvestBlock
      }
      on event HarvestBlock.ReforestationPlanned is {
        send event HarvestBlock.ReforestationPlanned to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send event HarvestBlock.ReforestationPlanned to outlet HarvestBlockEventSplitToHarvestMetrics
        tell event HarvestBlock.ReforestationPlanned to entity HarvestPlanningContext.HarvestBlock
      }
      on event HarvestBlock.BlockRejected is {
        send event HarvestBlock.BlockRejected to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send event HarvestBlock.BlockRejected to outlet HarvestBlockEventSplitToHarvestMetrics
        tell event HarvestBlock.BlockRejected to entity HarvestPlanningContext.HarvestBlock
      }
      on other is {
        error "Unexpected message for processor HarvestBlockEventSplit"
      }
    } with {
      briefly "HarvestBlock event fan-out handler"
      described as {
        |Delivers each HarvestBlock event to all of its consumers.
      }
    }
  } with {
    briefly "HarvestBlock event fan-out"
    described as {
      |Fans HarvestBlock events out to the repository and projectors.
    }
  }
  connector LinkHarvestBlockToHarvestBlockEventSplit is {
    from outlet HarvestPlanningContext.HarvestBlock.HarvestBlockEvents2 to
      inlet HarvestPlanningContext.HarvestBlockEventSplit.HarvestBlockEventSplitIn
  } with {
    briefly "LinkHarvestBlockToHarvestBlockEventSplit"
  }
  connector LinkHarvestBlockEventSplitToHarvestPlanningRepository is {
    from outlet HarvestPlanningContext.HarvestBlockEventSplit.HarvestBlockEventSplitToHarvestPlanningRepository to
      inlet HarvestPlanningContext.HarvestPlanningRepository.HarvestPlanningRepositoryFromHarvestBlock
  } with {
    briefly "LinkHarvestBlockEventSplitToHarvestPlanningRepository"
  }
  connector LinkHarvestBlockEventSplitToHarvestMetrics is {
    from outlet HarvestPlanningContext.HarvestBlockEventSplit.HarvestBlockEventSplitToHarvestMetrics to
      inlet HarvestPlanningContext.HarvestMetrics.HarvestMetricsFromHarvestBlock
  } with {
    briefly "LinkHarvestBlockEventSplitToHarvestMetrics"
  }
  connector LinkHarvestMetricsToHarvestPlanningRepository is {
    from outlet HarvestPlanningContext.HarvestMetrics.HarvestMetricsOut to
      inlet HarvestPlanningContext.HarvestPlanningRepository.HarvestPlanningRepositoryFromHarvestMetrics
  } with {
    briefly "LinkHarvestMetricsToHarvestPlanningRepository"
  }
} with {
  briefly "Bounded context for harvest planning"
  described as {
    |Forestry harvest planning context.
  }
}
