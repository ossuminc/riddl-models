// Harvest Planning - Harvest Planning Context
context HarvestPlanningContext as router is {
  inlet HarvestBlockCommandStreamIn is type HarvestBlockCommand  outlet HarvestBlockCommandStreamOut is type HarvestBlockCommand
  inlet HarvestBlockResultStreamIn is result HarvestBlock.HarvestBlockResult  outlet HarvestBlockResultStreamOut is result HarvestBlock.HarvestBlockResult
  handler HarvestPlanningContextBoundary is {
    on createHarvestBlock: command HarvestBlock.CreateHarvestBlock is {
      send createHarvestBlock to outlet HarvestPlanningContext.HarvestBlockCommandStreamOut
    }
    on delineateBlock: command HarvestBlock.DelineateBlock is {
      send delineateBlock to outlet HarvestPlanningContext.HarvestBlockCommandStreamOut
    }
    on submitEnvironmentalReview: command HarvestBlock.SubmitEnvironmentalReview is {
      send submitEnvironmentalReview to outlet HarvestPlanningContext.HarvestBlockCommandStreamOut
    }
    on recordReviewOutcome: command HarvestBlock.RecordReviewOutcome is {
      send recordReviewOutcome to outlet HarvestPlanningContext.HarvestBlockCommandStreamOut
    }
    on scheduleHarvest: command HarvestBlock.ScheduleHarvest is {
      send scheduleHarvest to outlet HarvestPlanningContext.HarvestBlockCommandStreamOut
    }
    on assignContractor: command HarvestBlock.AssignContractor is {
      send assignContractor to outlet HarvestPlanningContext.HarvestBlockCommandStreamOut
    }
    on beginHarvest: command HarvestBlock.BeginHarvest is {
      send beginHarvest to outlet HarvestPlanningContext.HarvestBlockCommandStreamOut
    }
    on completeHarvest: command HarvestBlock.CompleteHarvest is {
      send completeHarvest to outlet HarvestPlanningContext.HarvestBlockCommandStreamOut
    }
    on planReforestation: command HarvestBlock.PlanReforestation is {
      send planReforestation to outlet HarvestPlanningContext.HarvestBlockCommandStreamOut
    }
    on rejectBlock: command HarvestBlock.RejectBlock is {
      send rejectBlock to outlet HarvestPlanningContext.HarvestBlockCommandStreamOut
    }
    on harvestBlockResult: result HarvestBlock.HarvestBlockResult is {
      send harvestBlockResult to outlet HarvestPlanningContext.HarvestBlockResultStreamOut
    }
    on other is {
      error "Unexpected message at the HarvestPlanningContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'HarvestBlockCommand Stream Intake' is from outlet HarvestPlanningContext.HarvestBlockCommandStreamOut to inlet HarvestPlanningContext.HarvestBlock.HarvestBlockCommands  connector 'HarvestBlockResult Stream Egress' is from outlet HarvestPlanningContext.HarvestPlanningRepository.HarvestPlanningRepositoryResponses to inlet HarvestPlanningContext.HarvestBlockResultStreamIn  adaptor FromContractorRegistry from context ContractorRegistry is { 
    handler FromContractorRegistryHandler is {
      on result ContractorRegistry.AvailableContractors is {
        do "the model receives available contractors"
      }
      on event ContractorRegistry.ContractorAssignmentRegistered is {
        do "the model receives contractor assignment registered"
      }
      on other is {
        error "Unexpected message for adaptor FromContractorRegistry"
      }
    } with {
      briefly "from contractor registry"
      described as {
        |Carries messages from the external ContractorRegistry.
      }
    }
  } with {
    briefly "ContractorRegistry integration"
    described as {
      |The model's side of the ContractorRegistry conversation.
    }
  }
  adaptor ToContractorRegistry to context ContractorRegistry is { 
    handler ToContractorRegistryHandler is {
      on query ContractorRegistry.FindAvailableContractors is {
        do "the model sends find available contractors"
      }
      on command ContractorRegistry.RegisterContractorAssignment is {
        do "the model sends register contractor assignment"
      }
      on other is {
        error "Unexpected message for adaptor ToContractorRegistry"
      }
    } with {
      briefly "to contractor registry"
      described as {
        |Carries messages to the external ContractorRegistry.
      }
    }
  } with {
    briefly "ContractorRegistry integration"
    described as {
      |The model's side of the ContractorRegistry conversation.
    }
  }
  adaptor FromEnvironmentalAgency from context EnvironmentalAgency is { 
    handler FromEnvironmentalAgencyHandler is {
      on event EnvironmentalAgency.EnvironmentalReviewCompleted is {
        do "the model receives environmental review completed"
      }
      on result EnvironmentalAgency.SpeciesAtRiskReport is {
        do "the model receives species at risk report"
      }
      on other is {
        error "Unexpected message for adaptor FromEnvironmentalAgency"
      }
    } with {
      briefly "from environmental agency"
      described as {
        |Carries messages from the external EnvironmentalAgency.
      }
    }
  } with {
    briefly "EnvironmentalAgency integration"
    described as {
      |The model's side of the EnvironmentalAgency conversation.
    }
  }
  adaptor ToEnvironmentalAgency to context EnvironmentalAgency is { 
    handler ToEnvironmentalAgencyHandler is {
      on query EnvironmentalAgency.GetSpeciesAtRisk is {
        do "the model sends get species at risk"
      }
      on command EnvironmentalAgency.RequestEnvironmentalReview is {
        do "the model sends request environmental review"
      }
      on other is {
        error "Unexpected message for adaptor ToEnvironmentalAgency"
      }
    } with {
      briefly "to environmental agency"
      described as {
        |Carries messages to the external EnvironmentalAgency.
      }
    }
  } with {
    briefly "EnvironmentalAgency integration"
    described as {
      |The model's side of the EnvironmentalAgency conversation.
    }
  }
  include "types.riddl"
  include "HarvestBlock.riddl"
  type HarvestPlanningRepositoryCommand is one of {
    HarvestPlanningContext.HarvestPlanningRepository.PersistBlockDelineated or HarvestPlanningContext.HarvestPlanningRepository.PersistBlockRejected or HarvestPlanningContext.HarvestPlanningRepository.PersistContractorAssigned or HarvestPlanningContext.HarvestPlanningRepository.PersistEnvironmentalReviewSubmitted or HarvestPlanningContext.HarvestPlanningRepository.PersistHarvestBegan or HarvestPlanningContext.HarvestPlanningRepository.PersistHarvestBlockCreated or HarvestPlanningContext.HarvestPlanningRepository.PersistHarvestCompleted or HarvestPlanningContext.HarvestPlanningRepository.PersistHarvestScheduled or HarvestPlanningContext.HarvestPlanningRepository.PersistReforestationPlanned or HarvestPlanningContext.HarvestPlanningRepository.PersistReviewOutcomeRecorded
  } with {
    briefly "Anything that writes HarvestPlanningRepository"
    described as {
      |The persistence commands HarvestPlanningRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository HarvestPlanningRepository as flow is {
    inlet HarvestPlanningRepositoryFromHarvestMetrics is type HarvestPlanningRepositoryCommand    command PersistBlockDelineated is {
      blockId: HarvestBlockId with {
        briefly "Row addressed"
        described as {
          |Which stored row BlockDelineated applies to.
        }
      }
    } with {
      briefly "Persist BlockDelineated"
      described as {
        |Instructs this repository to apply BlockDelineated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBlockRejected is {
      blockId: HarvestBlockId with {
        briefly "Row addressed"
        described as {
          |Which stored row BlockRejected applies to.
        }
      }
    } with {
      briefly "Persist BlockRejected"
      described as {
        |Instructs this repository to apply BlockRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContractorAssigned is {
      blockId: HarvestBlockId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContractorAssigned applies to.
        }
      }
    } with {
      briefly "Persist ContractorAssigned"
      described as {
        |Instructs this repository to apply ContractorAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEnvironmentalReviewSubmitted is {
      blockId: HarvestBlockId with {
        briefly "Row addressed"
        described as {
          |Which stored row EnvironmentalReviewSubmitted applies to.
        }
      }
    } with {
      briefly "Persist EnvironmentalReviewSubmitted"
      described as {
        |Instructs this repository to apply EnvironmentalReviewSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHarvestBegan is {
      blockId: HarvestBlockId with {
        briefly "Row addressed"
        described as {
          |Which stored row HarvestBegan applies to.
        }
      }
    } with {
      briefly "Persist HarvestBegan"
      described as {
        |Instructs this repository to apply HarvestBegan to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHarvestScheduled is {
      blockId: HarvestBlockId with {
        briefly "Row addressed"
        described as {
          |Which stored row HarvestScheduled applies to.
        }
      }
    } with {
      briefly "Persist HarvestScheduled"
      described as {
        |Instructs this repository to apply HarvestScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReforestationPlanned is {
      blockId: HarvestBlockId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReforestationPlanned applies to.
        }
      }
    } with {
      briefly "Persist ReforestationPlanned"
      described as {
        |Instructs this repository to apply ReforestationPlanned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHarvestBlockCreated is {
      blockId: HarvestBlockId with {
        briefly "Row addressed"
        described as {
          |Which stored row HarvestBlockCreated applies to.
        }
      }
    } with {
      briefly "Persist HarvestBlockCreated"
      described as {
        |Instructs this repository to apply HarvestBlockCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHarvestCompleted is {
      blockId: HarvestBlockId with {
        briefly "Row addressed"
        described as {
          |Which stored row HarvestCompleted applies to.
        }
      }
    } with {
      briefly "Persist HarvestCompleted"
      described as {
        |Instructs this repository to apply HarvestCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReviewOutcomeRecorded is {
      blockId: HarvestBlockId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReviewOutcomeRecorded applies to.
        }
      }
    } with {
      briefly "Persist ReviewOutcomeRecorded"
      described as {
        |Instructs this repository to apply ReviewOutcomeRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet HarvestPlanningRepositoryResponses is result HarvestBlock.HarvestBlockResult
    record StoredHarvestBlock is {
      harvestBlockId: HarvestBlockId with {
        briefly "harvestBlockId"
        described as {
          |The harvestBlockId column of the stored harvestBlock row.
        }
      }
      blockId: HarvestBlockId with {
        briefly "blockId"
        described as {
          |The blockId column of the stored harvestBlock row.
        }
      }
      standAssessment: StandAssessment with {
        briefly "standAssessment"
        described as {
          |The standAssessment column of the stored harvestBlock row.
        }
      }
      status: BlockStatus with {
        briefly "status"
        described as {
          |The status column of the stored harvestBlock row.
        }
      }
    } with {
      briefly "Stored harvestBlock row"
      described as {
        |The persistence shape of harvestBlock data as this repository stores it.
      }
    }
    schema HarvestPlanningData is relational
      of harvestBlocks as record StoredHarvestBlock
        index on field StoredHarvestBlock.blockId
        index on field StoredHarvestBlock.standAssessment.standId
        index on field StoredHarvestBlock.status
 with {
      briefly "Harvest planning data schema"
      described as {
        |The relational schema holding harvest planning data for the HarvestPlanningRepository.
      }
    }
    handler HarvestPlanningPersistence is {
      on persistBlockDelineated: command PersistBlockDelineated is {
        do "apply BlockDelineated to the stored row"
      }
      on persistBlockRejected: command PersistBlockRejected is {
        do "apply BlockRejected to the stored row"
      }
      on persistContractorAssigned: command PersistContractorAssigned is {
        do "apply ContractorAssigned to the stored row"
      }
      on persistEnvironmentalReviewSubmitted: command PersistEnvironmentalReviewSubmitted is {
        do "apply EnvironmentalReviewSubmitted to the stored row"
      }
      on persistHarvestBegan: command PersistHarvestBegan is {
        do "apply HarvestBegan to the stored row"
      }
      on persistHarvestScheduled: command PersistHarvestScheduled is {
        do "apply HarvestScheduled to the stored row"
      }
      on persistReforestationPlanned: command PersistReforestationPlanned is {
        do "apply ReforestationPlanned to the stored row"
      }
      on persistHarvestBlockCreated: command PersistHarvestBlockCreated is {
        do "apply HarvestBlockCreated to the stored row"
      }
      on persistHarvestCompleted: command PersistHarvestCompleted is {
        do "apply HarvestCompleted to the stored row"
      }
      on persistReviewOutcomeRecorded: command PersistReviewOutcomeRecorded is {
        do "apply ReviewOutcomeRecorded to the stored row"
      }
      on query GetBlockMetrics is {
        let blockMetricsView: type BlockMetricsView = prompt("read the block metrics projection")
        reply blockMetricsView
      }
    } with {
      briefly "Persists harvest planning events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Harvest planning data persistence"
    described as {
      |Persistent storage for harvest planning.
    }
  }
  query GetBlockMetrics replies result BlockMetricsView is {
    blockMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which block metrics to retrieve.
      }
    }
  } with {
    briefly "Get block metrics"
    described as {
      |Retrieves the block metrics projection.
    }
  }
  result BlockMetricsView is {
    blockMetrics: HarvestMetrics.BlockMetrics with {
      briefly "Block metrics"
      described as {
        |The block metrics being returned.
      }
    }
  } with {
    briefly "Block metrics view"
    described as {
      |Read model view carrying the block metrics projection.
    }
  }
  projector HarvestMetrics as flow is {
    updates repository HarvestPlanningContext.HarvestPlanningRepository
    outlet HarvestMetricsToRepository is type HarvestPlanningRepositoryCommand
    inlet HarvestMetricsFromHarvestBlock is type HarvestBlockEvent    record BlockMetrics is {
      blocksProposed: Natural with {
        briefly "Proposed"
        described as {
          |Blocks proposed.
        }
      }
      blocksApproved: Natural with {
        briefly "Approved"
        described as {
          |Blocks approved.
        }
      }
      blocksCompleted: Natural with {
        briefly "Completed"
        described as {
          |Blocks harvested.
        }
      }
      blocksRejected: Natural with {
        briefly "Rejected"
        described as {
          |Blocks rejected.
        }
      }
      totalVolumeHarvested: Decimal(12,2) with {
        briefly "Volume"
        described as {
          |Total volume harvested.
        }
      }
      averageBlockArea: Decimal(8,2) with {
        briefly "Avg area"
        described as {
          |Average block area in hectares.
        }
      }
    } with {
      briefly "Block metrics"
      described as {
        |Harvest block processing metrics.
      }
    }
    handler MetricsHandler is {
      on blockDelineated: event HarvestBlock.BlockDelineated is {
        tell command HarvestPlanningContext.HarvestPlanningRepository.PersistBlockDelineated(blockId = blockDelineated.blockId) to repository HarvestPlanningContext.HarvestPlanningRepository
        do "apply BlockDelineated to the HarvestMetrics projection"
      }
      on blockRejected: event HarvestBlock.BlockRejected is {
        tell command HarvestPlanningContext.HarvestPlanningRepository.PersistBlockRejected(blockId = blockRejected.blockId) to repository HarvestPlanningContext.HarvestPlanningRepository
        do "apply BlockRejected to the HarvestMetrics projection"
      }
      on contractorAssigned: event HarvestBlock.ContractorAssigned is {
        tell command HarvestPlanningContext.HarvestPlanningRepository.PersistContractorAssigned(blockId = contractorAssigned.blockId) to repository HarvestPlanningContext.HarvestPlanningRepository
        do "apply ContractorAssigned to the HarvestMetrics projection"
      }
      on environmentalReviewSubmitted: event HarvestBlock.EnvironmentalReviewSubmitted is {
        tell command HarvestPlanningContext.HarvestPlanningRepository.PersistEnvironmentalReviewSubmitted(blockId = environmentalReviewSubmitted.blockId) to repository HarvestPlanningContext.HarvestPlanningRepository
        do "apply EnvironmentalReviewSubmitted to the HarvestMetrics projection"
      }
      on harvestBegan: event HarvestBlock.HarvestBegan is {
        tell command HarvestPlanningContext.HarvestPlanningRepository.PersistHarvestBegan(blockId = harvestBegan.blockId) to repository HarvestPlanningContext.HarvestPlanningRepository
        do "apply HarvestBegan to the HarvestMetrics projection"
      }
      on harvestScheduled: event HarvestBlock.HarvestScheduled is {
        tell command HarvestPlanningContext.HarvestPlanningRepository.PersistHarvestScheduled(blockId = harvestScheduled.blockId) to repository HarvestPlanningContext.HarvestPlanningRepository
        do "apply HarvestScheduled to the HarvestMetrics projection"
      }
      on reforestationPlanned: event HarvestBlock.ReforestationPlanned is {
        tell command HarvestPlanningContext.HarvestPlanningRepository.PersistReforestationPlanned(blockId = reforestationPlanned.blockId) to repository HarvestPlanningContext.HarvestPlanningRepository
        do "apply ReforestationPlanned to the HarvestMetrics projection"
      }
      on harvestBlockCreated: event HarvestBlock.HarvestBlockCreated is {
        tell command HarvestPlanningContext.HarvestPlanningRepository.PersistHarvestBlockCreated(blockId = harvestBlockCreated.blockId) to repository HarvestPlanningContext.HarvestPlanningRepository
        do "Increment blocks proposed"
      }
      on reviewOutcomeRecorded: event HarvestBlock.ReviewOutcomeRecorded is {
        tell command HarvestPlanningContext.HarvestPlanningRepository.PersistReviewOutcomeRecorded(blockId = reviewOutcomeRecorded.blockId) to repository HarvestPlanningContext.HarvestPlanningRepository
        do "Increment blocks approved or rejected"
      }
      on harvestCompleted: event HarvestBlock.HarvestCompleted is {
        tell command HarvestPlanningContext.HarvestPlanningRepository.PersistHarvestCompleted(blockId = harvestCompleted.blockId) to repository HarvestPlanningContext.HarvestPlanningRepository
        do "Increment blocks completed and add volume"
      }
    } with {
      briefly "Maintains harvest metrics"
      described as {
        |Projects events into harvest metrics.
      }
    }
  } with {
    briefly "Harvest metrics"
    described as {
      |Harvest planning analytics.
    }
  }
  // ---- Event publication for HarvestBlock ----
  type HarvestBlockEvent is one of {
    HarvestPlanningContext.HarvestBlock.HarvestBlockCreated or HarvestPlanningContext.HarvestBlock.BlockDelineated or HarvestPlanningContext.HarvestBlock.EnvironmentalReviewSubmitted or HarvestPlanningContext.HarvestBlock.ReviewOutcomeRecorded or HarvestPlanningContext.HarvestBlock.HarvestScheduled or HarvestPlanningContext.HarvestBlock.ContractorAssigned or HarvestPlanningContext.HarvestBlock.HarvestBegan or HarvestPlanningContext.HarvestBlock.HarvestCompleted or HarvestPlanningContext.HarvestBlock.ReforestationPlanned or HarvestPlanningContext.HarvestBlock.BlockRejected
  } with {
    briefly "HarvestBlock event alternation"
    described as {
      |Union of all HarvestBlock events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet HarvestBlockEventSplit as flow is {
    inlet HarvestBlockEventSplitIn is type HarvestBlockEvent    outlet HarvestBlockEventSplitToHarvestMetrics is type HarvestBlockEvent
    handler HarvestBlockEventSplitHandler is {
      on harvestBlockCreated: event HarvestBlock.HarvestBlockCreated is {
        send harvestBlockCreated to outlet HarvestBlockEventSplitToHarvestMetrics
        tell harvestBlockCreated to entity HarvestPlanningContext.HarvestBlock
      }
      on blockDelineated: event HarvestBlock.BlockDelineated is {
        send blockDelineated to outlet HarvestBlockEventSplitToHarvestMetrics
        tell blockDelineated to entity HarvestPlanningContext.HarvestBlock
      }
      on environmentalReviewSubmitted: event HarvestBlock.EnvironmentalReviewSubmitted is {
        send environmentalReviewSubmitted to outlet HarvestBlockEventSplitToHarvestMetrics
        tell environmentalReviewSubmitted to entity HarvestPlanningContext.HarvestBlock
      }
      on reviewOutcomeRecorded: event HarvestBlock.ReviewOutcomeRecorded is {
        send reviewOutcomeRecorded to outlet HarvestBlockEventSplitToHarvestMetrics
        tell reviewOutcomeRecorded to entity HarvestPlanningContext.HarvestBlock
      }
      on harvestScheduled: event HarvestBlock.HarvestScheduled is {
        send harvestScheduled to outlet HarvestBlockEventSplitToHarvestMetrics
        tell harvestScheduled to entity HarvestPlanningContext.HarvestBlock
      }
      on contractorAssigned: event HarvestBlock.ContractorAssigned is {
        send contractorAssigned to outlet HarvestBlockEventSplitToHarvestMetrics
        tell contractorAssigned to entity HarvestPlanningContext.HarvestBlock
      }
      on harvestBegan: event HarvestBlock.HarvestBegan is {
        send harvestBegan to outlet HarvestBlockEventSplitToHarvestMetrics
        tell harvestBegan to entity HarvestPlanningContext.HarvestBlock
      }
      on harvestCompleted: event HarvestBlock.HarvestCompleted is {
        send harvestCompleted to outlet HarvestBlockEventSplitToHarvestMetrics
        tell harvestCompleted to entity HarvestPlanningContext.HarvestBlock
      }
      on reforestationPlanned: event HarvestBlock.ReforestationPlanned is {
        send reforestationPlanned to outlet HarvestBlockEventSplitToHarvestMetrics
        tell reforestationPlanned to entity HarvestPlanningContext.HarvestBlock
      }
      on blockRejected: event HarvestBlock.BlockRejected is {
        send blockRejected to outlet HarvestBlockEventSplitToHarvestMetrics
        tell blockRejected to entity HarvestPlanningContext.HarvestBlock
      }
      on other is {
        error "Unexpected message for processor HarvestBlockEventSplit"
      }
    } with {
      briefly "HarvestBlock event fan-out handler"
      described as {
        |Delivers each HarvestBlock event to all of its consumers.
      }
    }
  } with {
    briefly "HarvestBlock event fan-out"
    described as {
      |Fans HarvestBlock events out to the repository and projectors.
    }
  }
  connector 'HarvestBlockEvent Stream' is from outlet HarvestPlanningContext.HarvestBlock.HarvestBlockEvents2 to inlet HarvestPlanningContext.HarvestBlockEventSplit.HarvestBlockEventSplitIn with {
    briefly "HarvestBlock events, fanned out to storage and read models"
  }
  connector 'HarvestMetrics Feed' is from outlet HarvestPlanningContext.HarvestBlockEventSplit.HarvestBlockEventSplitToHarvestMetrics to inlet HarvestPlanningContext.HarvestMetrics.HarvestMetricsFromHarvestBlock with {
    briefly "HarvestBlock events feeding the HarvestMetrics projection"
  }
  connector 'HarvestMetrics Storage' is from outlet HarvestPlanningContext.HarvestMetrics.HarvestMetricsToRepository to inlet HarvestPlanningContext.HarvestPlanningRepository.HarvestPlanningRepositoryFromHarvestMetrics with {
    briefly "HarvestMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for harvest planning"
  described as {
    |Forestry harvest planning context.
  }
}
