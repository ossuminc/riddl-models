// Harvest Planning - Harvest Planning Context
context HarvestPlanningContext is {
  adaptor FromContractorRegistry from context ContractorRegistry is { 
    handler FromContractorRegistryHandler is {
      on result ContractorRegistry.AvailableContractors is {
        do "the model receives available contractors"
      }
      on event ContractorRegistry.ContractorAssignmentRegistered is {
        do "the model receives contractor assignment registered"
      }
      on other is {
        error "Unexpected message for adaptor FromContractorRegistry"
      }
    } with {
      briefly "from contractor registry"
      described as {
        |Carries messages from the external ContractorRegistry.
      }
    }
  } with {
    briefly "ContractorRegistry integration"
    described as {
      |The model's side of the ContractorRegistry conversation.
    }
  }
  adaptor ToContractorRegistry to context ContractorRegistry is { 
    handler ToContractorRegistryHandler is {
      on query ContractorRegistry.FindAvailableContractors is {
        do "the model sends find available contractors"
      }
      on command ContractorRegistry.RegisterContractorAssignment is {
        do "the model sends register contractor assignment"
      }
      on other is {
        error "Unexpected message for adaptor ToContractorRegistry"
      }
    } with {
      briefly "to contractor registry"
      described as {
        |Carries messages to the external ContractorRegistry.
      }
    }
  } with {
    briefly "ContractorRegistry integration"
    described as {
      |The model's side of the ContractorRegistry conversation.
    }
  }
  adaptor FromEnvironmentalAgency from context EnvironmentalAgency is { 
    handler FromEnvironmentalAgencyHandler is {
      on event EnvironmentalAgency.EnvironmentalReviewCompleted is {
        do "the model receives environmental review completed"
      }
      on result EnvironmentalAgency.SpeciesAtRiskReport is {
        do "the model receives species at risk report"
      }
      on other is {
        error "Unexpected message for adaptor FromEnvironmentalAgency"
      }
    } with {
      briefly "from environmental agency"
      described as {
        |Carries messages from the external EnvironmentalAgency.
      }
    }
  } with {
    briefly "EnvironmentalAgency integration"
    described as {
      |The model's side of the EnvironmentalAgency conversation.
    }
  }
  adaptor ToEnvironmentalAgency to context EnvironmentalAgency is { 
    handler ToEnvironmentalAgencyHandler is {
      on query EnvironmentalAgency.GetSpeciesAtRisk is {
        do "the model sends get species at risk"
      }
      on command EnvironmentalAgency.RequestEnvironmentalReview is {
        do "the model sends request environmental review"
      }
      on other is {
        error "Unexpected message for adaptor ToEnvironmentalAgency"
      }
    } with {
      briefly "to environmental agency"
      described as {
        |Carries messages to the external EnvironmentalAgency.
      }
    }
  } with {
    briefly "EnvironmentalAgency integration"
    described as {
      |The model's side of the EnvironmentalAgency conversation.
    }
  }
  include "types.riddl"
  include "HarvestBlock.riddl"
  repository HarvestPlanningRepository as merge is {
    inlet HarvestPlanningRepositoryFromHarvestBlock is type HarvestBlockEvent    inlet HarvestPlanningRepositoryFromHarvestMetrics is type HarvestBlockEvent    outlet HarvestPlanningRepositoryResponses is type HarvestBlock.HarvestBlockResult
    record StoredHarvestBlock is  {
      harvestBlockId: HarvestBlockId with {
        briefly "harvestBlockId"
        described as {
          |The harvestBlockId column of the stored harvestBlock row.
        }
      }
      blockId: HarvestBlockId with {
        briefly "blockId"
        described as {
          |The blockId column of the stored harvestBlock row.
        }
      }
      standAssessment: StandAssessment with {
        briefly "standAssessment"
        described as {
          |The standAssessment column of the stored harvestBlock row.
        }
      }
      status: BlockStatus with {
        briefly "status"
        described as {
          |The status column of the stored harvestBlock row.
        }
      }
    } with {
      briefly "Stored harvestBlock row"
      described as {
        |The persistence shape of harvestBlock data as this repository stores it.
      }
    }
    schema HarvestPlanningData is relational
      of harvestBlocks as type StoredHarvestBlock
        index on field StoredHarvestBlock.blockId
        index on field StoredHarvestBlock.standAssessment.standId
        index on field StoredHarvestBlock.status
 with {
      briefly "Harvest planning data schema"
      described as {
        |The relational schema holding harvest planning data for the HarvestPlanningRepository.
      }
    }
    handler HarvestPlanningPersistence is {
      on query GetBlockMetrics is {
        let blockMetricsView: BlockMetricsView = prompt("read the block metrics projection")
        reply blockMetricsView
      }
      on createHarvestBlock: command HarvestBlock.CreateHarvestBlock is {
        tell event HarvestBlock.HarvestBlockCreated(blockId = createHarvestBlock.blockId, standAssessment = createHarvestBlock.standAssessment) to entity HarvestPlanningContext.HarvestBlock
        do "Store new harvest block"
      }
      on command HarvestBlock.DelineateBlock is {
        do "Update block boundary"
      }
      on recordReviewOutcome: command HarvestBlock.RecordReviewOutcome is {
        tell event HarvestBlock.ReviewOutcomeRecorded(blockId = recordReviewOutcome.blockId) to entity HarvestPlanningContext.HarvestBlock
        do "Store environmental review outcome"
      }
      on scheduleHarvest: command HarvestBlock.ScheduleHarvest is {
        tell event HarvestBlock.HarvestScheduled(blockId = scheduleHarvest.blockId, schedule = scheduleHarvest.schedule) to entity HarvestPlanningContext.HarvestBlock
        do "Store harvest schedule"
      }
      on completeHarvest: command HarvestBlock.CompleteHarvest is {
        tell event HarvestBlock.HarvestCompleted(blockId = completeHarvest.blockId, actualVolume = completeHarvest.actualVolume) to entity HarvestPlanningContext.HarvestBlock
        do "Update block to completed"
      }
      on command HarvestBlock.PlanReforestation is {
        do "Store reforestation plan"
      }
    } with {
      briefly "Persists harvest planning events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Harvest planning data persistence"
    described as {
      |Persistent storage for harvest planning.
    }
  }
  query GetBlockMetrics is  {
    blockMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which block metrics to retrieve.
      }
    }
  } with {
    briefly "Get block metrics"
    described as {
      |Retrieves the block metrics projection.
    }
  }
  result BlockMetricsView is  {
    blockMetrics: HarvestMetrics.BlockMetrics with {
      briefly "Block metrics"
      described as {
        |The block metrics being returned.
      }
    }
  } with {
    briefly "Block metrics view"
    described as {
      |Read model view carrying the block metrics projection.
    }
  }
  projector HarvestMetrics as flow is {
    updates repository HarvestPlanningContext.HarvestPlanningRepository
    inlet HarvestMetricsFromHarvestBlock is type HarvestBlockEvent    outlet HarvestMetricsOut is type HarvestBlockEvent
    record BlockMetrics is  {
      blocksProposed: Natural with {
        briefly "Proposed"
        described as {
          |Blocks proposed.
        }
      }
      blocksApproved: Natural with {
        briefly "Approved"
        described as {
          |Blocks approved.
        }
      }
      blocksCompleted: Natural with {
        briefly "Completed"
        described as {
          |Blocks harvested.
        }
      }
      blocksRejected: Natural with {
        briefly "Rejected"
        described as {
          |Blocks rejected.
        }
      }
      totalVolumeHarvested: Decimal(12,2) with {
        briefly "Volume"
        described as {
          |Total volume harvested.
        }
      }
      averageBlockArea: Decimal(8,2) with {
        briefly "Avg area"
        described as {
          |Average block area in hectares.
        }
      }
    } with {
      briefly "Block metrics"
      described as {
        |Harvest block processing metrics.
      }
    }
    handler MetricsHandler is {
      on harvestBlockCreated: event HarvestBlock.HarvestBlockCreated is {
        tell harvestBlockCreated to repository HarvestPlanningContext.HarvestPlanningRepository
        do "Increment blocks proposed"
      }
      on reviewOutcomeRecorded: event HarvestBlock.ReviewOutcomeRecorded is {
        tell reviewOutcomeRecorded to repository HarvestPlanningContext.HarvestPlanningRepository
        do "Increment blocks approved or rejected"
      }
      on harvestCompleted: event HarvestBlock.HarvestCompleted is {
        tell harvestCompleted to repository HarvestPlanningContext.HarvestPlanningRepository
        do "Increment blocks completed and add volume"
      }
    } with {
      briefly "Maintains harvest metrics"
      described as {
        |Projects events into harvest metrics.
      }
    }
  } with {
    briefly "Harvest metrics"
    described as {
      |Harvest planning analytics.
    }
  }
  // ---- Event publication for HarvestBlock ----
  type HarvestBlockEvent is one of {
    HarvestPlanningContext.HarvestBlock.HarvestBlockCreated or HarvestPlanningContext.HarvestBlock.BlockDelineated or HarvestPlanningContext.HarvestBlock.EnvironmentalReviewSubmitted or HarvestPlanningContext.HarvestBlock.ReviewOutcomeRecorded or HarvestPlanningContext.HarvestBlock.HarvestScheduled or HarvestPlanningContext.HarvestBlock.ContractorAssigned or HarvestPlanningContext.HarvestBlock.HarvestBegan or HarvestPlanningContext.HarvestBlock.HarvestCompleted or HarvestPlanningContext.HarvestBlock.ReforestationPlanned or HarvestPlanningContext.HarvestBlock.BlockRejected
  } with {
    briefly "HarvestBlock event alternation"
    described as {
      |Union of all HarvestBlock events, for streaming and event-sourced
      |persistence.
    }
  }
  processor HarvestBlockEventSource as source is {
    outlet HarvestBlockEvents is type HarvestBlockEvent
    handler HarvestBlockSourceHandler is {
      on harvestBlockCreated: event HarvestBlock.HarvestBlockCreated is {
        send harvestBlockCreated to outlet HarvestBlockEvents
      }
      on blockDelineated: event HarvestBlock.BlockDelineated is {
        send blockDelineated to outlet HarvestBlockEvents
      }
      on environmentalReviewSubmitted: event HarvestBlock.EnvironmentalReviewSubmitted is {
        send environmentalReviewSubmitted to outlet HarvestBlockEvents
      }
      on reviewOutcomeRecorded: event HarvestBlock.ReviewOutcomeRecorded is {
        send reviewOutcomeRecorded to outlet HarvestBlockEvents
      }
      on harvestScheduled: event HarvestBlock.HarvestScheduled is {
        send harvestScheduled to outlet HarvestBlockEvents
      }
      on contractorAssigned: event HarvestBlock.ContractorAssigned is {
        send contractorAssigned to outlet HarvestBlockEvents
      }
      on harvestBegan: event HarvestBlock.HarvestBegan is {
        send harvestBegan to outlet HarvestBlockEvents
      }
      on harvestCompleted: event HarvestBlock.HarvestCompleted is {
        send harvestCompleted to outlet HarvestBlockEvents
      }
      on reforestationPlanned: event HarvestBlock.ReforestationPlanned is {
        send reforestationPlanned to outlet HarvestBlockEvents
      }
      on blockRejected: event HarvestBlock.BlockRejected is {
        send blockRejected to outlet HarvestBlockEvents
      }
      on other is {
        error "Unexpected message for source HarvestBlockEventSource"
      }
    } with {
      briefly "HarvestBlock source handler"
      described as {
        |Publishes HarvestBlock events onto the outlet.
      }
    }
  } with {
    briefly "HarvestBlock event source"
    described as {
      |Publishes HarvestBlock entity events into the streaming topology.
    }
  }
  processor HarvestBlockEventSink as sink is {
    inlet HarvestBlockInlet is type HarvestBlockEvent    handler HarvestBlockSinkHandler is {
      on harvestBlockCreated: event HarvestBlock.HarvestBlockCreated is {
        tell harvestBlockCreated to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on blockDelineated: event HarvestBlock.BlockDelineated is {
        tell blockDelineated to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on environmentalReviewSubmitted: event HarvestBlock.EnvironmentalReviewSubmitted is {
        tell environmentalReviewSubmitted to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on reviewOutcomeRecorded: event HarvestBlock.ReviewOutcomeRecorded is {
        tell reviewOutcomeRecorded to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on harvestScheduled: event HarvestBlock.HarvestScheduled is {
        tell harvestScheduled to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on contractorAssigned: event HarvestBlock.ContractorAssigned is {
        tell contractorAssigned to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on harvestBegan: event HarvestBlock.HarvestBegan is {
        tell harvestBegan to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on harvestCompleted: event HarvestBlock.HarvestCompleted is {
        tell harvestCompleted to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on reforestationPlanned: event HarvestBlock.ReforestationPlanned is {
        tell reforestationPlanned to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on blockRejected: event HarvestBlock.BlockRejected is {
        tell blockRejected to repository HarvestPlanningContext.HarvestPlanningRepository
      }
      on other is {
        error "Unexpected message for sink HarvestBlockEventSink"
      }
    } with {
      briefly "HarvestBlock sink handler"
      described as {
        |Persists HarvestBlock events via the repository.
      }
    }
  } with {
    briefly "HarvestBlock event sink"
    described as {
      |Receives HarvestBlock events for persistence.
    }
  }
  connector HarvestBlockEventFlow is from outlet HarvestPlanningContext.HarvestBlockEventSource.HarvestBlockEvents to inlet HarvestPlanningContext.HarvestBlockEventSink.HarvestBlockInlet with {
    briefly "HarvestBlock event flow"
    described as {
      |Connects the HarvestBlock source to its sink.
    }
  }
  processor HarvestBlockEventSplit as split is {
    inlet HarvestBlockEventSplitIn is type HarvestBlockEvent    outlet HarvestBlockEventSplitToHarvestPlanningRepository is type HarvestBlockEvent
    outlet HarvestBlockEventSplitToHarvestMetrics is type HarvestBlockEvent
    handler HarvestBlockEventSplitHandler is {
      on harvestBlockCreated: event HarvestBlock.HarvestBlockCreated is {
        send harvestBlockCreated to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send harvestBlockCreated to outlet HarvestBlockEventSplitToHarvestMetrics
        tell harvestBlockCreated to entity HarvestPlanningContext.HarvestBlock
      }
      on blockDelineated: event HarvestBlock.BlockDelineated is {
        send blockDelineated to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send blockDelineated to outlet HarvestBlockEventSplitToHarvestMetrics
        tell blockDelineated to entity HarvestPlanningContext.HarvestBlock
      }
      on environmentalReviewSubmitted: event HarvestBlock.EnvironmentalReviewSubmitted is {
        send environmentalReviewSubmitted to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send environmentalReviewSubmitted to outlet HarvestBlockEventSplitToHarvestMetrics
        tell environmentalReviewSubmitted to entity HarvestPlanningContext.HarvestBlock
      }
      on reviewOutcomeRecorded: event HarvestBlock.ReviewOutcomeRecorded is {
        send reviewOutcomeRecorded to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send reviewOutcomeRecorded to outlet HarvestBlockEventSplitToHarvestMetrics
        tell reviewOutcomeRecorded to entity HarvestPlanningContext.HarvestBlock
      }
      on harvestScheduled: event HarvestBlock.HarvestScheduled is {
        send harvestScheduled to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send harvestScheduled to outlet HarvestBlockEventSplitToHarvestMetrics
        tell harvestScheduled to entity HarvestPlanningContext.HarvestBlock
      }
      on contractorAssigned: event HarvestBlock.ContractorAssigned is {
        send contractorAssigned to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send contractorAssigned to outlet HarvestBlockEventSplitToHarvestMetrics
        tell contractorAssigned to entity HarvestPlanningContext.HarvestBlock
      }
      on harvestBegan: event HarvestBlock.HarvestBegan is {
        send harvestBegan to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send harvestBegan to outlet HarvestBlockEventSplitToHarvestMetrics
        tell harvestBegan to entity HarvestPlanningContext.HarvestBlock
      }
      on harvestCompleted: event HarvestBlock.HarvestCompleted is {
        send harvestCompleted to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send harvestCompleted to outlet HarvestBlockEventSplitToHarvestMetrics
        tell harvestCompleted to entity HarvestPlanningContext.HarvestBlock
      }
      on reforestationPlanned: event HarvestBlock.ReforestationPlanned is {
        send reforestationPlanned to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send reforestationPlanned to outlet HarvestBlockEventSplitToHarvestMetrics
        tell reforestationPlanned to entity HarvestPlanningContext.HarvestBlock
      }
      on blockRejected: event HarvestBlock.BlockRejected is {
        send blockRejected to outlet HarvestBlockEventSplitToHarvestPlanningRepository
        send blockRejected to outlet HarvestBlockEventSplitToHarvestMetrics
        tell blockRejected to entity HarvestPlanningContext.HarvestBlock
      }
      on other is {
        error "Unexpected message for processor HarvestBlockEventSplit"
      }
    } with {
      briefly "HarvestBlock event fan-out handler"
      described as {
        |Delivers each HarvestBlock event to all of its consumers.
      }
    }
  } with {
    briefly "HarvestBlock event fan-out"
    described as {
      |Fans HarvestBlock events out to the repository and projectors.
    }
  }
  connector 'HarvestBlockEvent Stream' is from outlet HarvestPlanningContext.HarvestBlock.HarvestBlockEvents2 to inlet HarvestPlanningContext.HarvestBlockEventSplit.HarvestBlockEventSplitIn with {
    briefly "HarvestBlock events, fanned out to storage and read models"
  }
  connector 'HarvestBlockEvent Storage' is from outlet HarvestPlanningContext.HarvestBlockEventSplit.HarvestBlockEventSplitToHarvestPlanningRepository to inlet HarvestPlanningContext.HarvestPlanningRepository.HarvestPlanningRepositoryFromHarvestBlock with {
    briefly "HarvestBlock events on their way to storage"
  }
  connector 'HarvestMetrics Feed' is from outlet HarvestPlanningContext.HarvestBlockEventSplit.HarvestBlockEventSplitToHarvestMetrics to inlet HarvestPlanningContext.HarvestMetrics.HarvestMetricsFromHarvestBlock with {
    briefly "HarvestBlock events feeding the HarvestMetrics projection"
  }
  connector 'HarvestMetrics Storage' is from outlet HarvestPlanningContext.HarvestMetrics.HarvestMetricsOut to inlet HarvestPlanningContext.HarvestPlanningRepository.HarvestPlanningRepositoryFromHarvestMetrics with {
    briefly "The HarvestMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for harvest planning"
  described as {
    |Forestry harvest planning context.
  }
}
