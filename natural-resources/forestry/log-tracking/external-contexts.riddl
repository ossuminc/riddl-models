// Log Tracking - External Contexts
external context TransportSystem as split is {
  outlet TransportSystemRepliesOut is result TransportStatus
 with {
    briefly "What this service answers, on its way back"
  }
  outlet TransportSystemEventsOut is event TruckDispatched
 with {
    briefly "What this service tells the model, unasked"
  }
  type TransportSystemRequest is one of {
    DispatchTruck or GetTransportStatus
  } with {
    briefly "Everything this service can be asked"
  }
  inlet TransportSystemRequests is type TransportSystemRequest with {
    briefly "What this context asks the service to send"
  }
  handler TransportSystemBoundary is {
    on query GetTransportStatus is {
      let askAnswer: type TransportStatus = prompt("look up what GetTransportStatus asks for")
      reply askAnswer
    }
    on command DispatchTruck is {
      let truckDispatched: type TruckDispatched = prompt("the truck dispatched this produces")
      send truckDispatched to outlet TransportSystem.TransportSystemEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context TransportSystem"
    }
  } with {
    briefly "TransportSystem boundary"
  }
  command DispatchTruck is {
    transportId: TransportId with {
      briefly "Transport"
      described as {
        |Transport ID.
      }
    }
    truckNumber: String(3,50) with {
      briefly "Truck"
      described as {
        |Truck number.
      }
    }
    harvestSiteId: HarvestSiteId with {
      briefly "Site"
      described as {
        |Harvest site ID.
      }
    }
    destinationMill: SawmillId with {
      briefly "Destination"
      described as {
        |Sawmill ID.
      }
    }
  } with {
    briefly "Dispatch truck"
    described as {
      |Dispatches a truck to a harvest site for log pickup.
    }
  }
  event TruckDispatched is {
    transportId: TransportId with {
      briefly "Transport"
      described as {
        |Transport ID.
      }
    }
    dispatchedAt: TimeStamp with {
      briefly "Dispatched"
      described as {
        |Dispatch time.
      }
    }
  } with {
    briefly "Truck dispatched"
    described as {
      |Emitted when a truck is dispatched.
    }
  }
  query GetTransportStatus replies result TransportStatus is {
    transportId: TransportId with {
      briefly "Transport"
      described as {
        |Transport ID.
      }
    }
  } with {
    briefly "Get transport status"
    described as {
      |Gets current transport shipment status.
    }
  }
  result TransportStatus is {
    transportId: TransportId with {
      briefly "Transport"
      described as {
        |Transport ID.
      }
    }
    transportStatus: String(3,50) with {
      briefly "Status"
      described as {
        |Transport status.
      }
    }
    currentLocation: String(3,200)? with {
      briefly "Location"
      described as {
        |Current GPS location.
      }
    }
    updatedEstimatedArrival: TimeStamp? with {
      briefly "ETA"
      described as {
        |Estimated arrival.
      }
    }
  } with {
    briefly "Transport status"
    described as {
      |Current transport shipment status.
    }
  }
} with {
  briefly "External transport system"
  described as {
    |Truck dispatch and transport tracking system.
  }
}
external context SawmillSystem as split is {
  outlet SawmillSystemRepliesOut is result MillCapacity
 with {
    briefly "What this service answers, on its way back"
  }
  outlet SawmillSystemEventsOut is event LoadReceived
 with {
    briefly "What this service tells the model, unasked"
  }
  type SawmillSystemRequest is one of {
    NotifyIncomingLoad or GetMillCapacity
  } with {
    briefly "Everything this service can be asked"
  }
  inlet SawmillSystemRequests is type SawmillSystemRequest with {
    briefly "What this context asks the service to send"
  }
  handler SawmillSystemBoundary is {
    on query GetMillCapacity is {
      let askAnswer: type MillCapacity = prompt("look up what GetMillCapacity asks for")
      reply askAnswer
    }
    on command NotifyIncomingLoad is {
      let loadReceived: type LoadReceived = prompt("the load received this produces")
      send loadReceived to outlet SawmillSystem.SawmillSystemEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context SawmillSystem"
    }
  } with {
    briefly "SawmillSystem boundary"
  }
  command NotifyIncomingLoad is {
    transportId: TransportId with {
      briefly "Transport"
      described as {
        |Transport ID.
      }
    }
    sawmillId: SawmillId with {
      briefly "Sawmill"
      described as {
        |Sawmill ID.
      }
    }
    logCount: Natural with {
      briefly "Count"
      described as {
        |Number of logs.
      }
    }
    estimatedArrival: TimeStamp with {
      briefly "ETA"
      described as {
        |Estimated arrival.
      }
    }
  } with {
    briefly "Notify incoming load"
    described as {
      |Notifies sawmill of an incoming log shipment.
    }
  }
  event LoadReceived is {
    transportId: TransportId with {
      briefly "Transport"
      described as {
        |Transport ID.
      }
    }
    sawmillId: SawmillId with {
      briefly "Sawmill"
      described as {
        |Sawmill ID.
      }
    }
    receivedAt: TimeStamp with {
      briefly "Received"
      described as {
        |Reception time.
      }
    }
  } with {
    briefly "Load received"
    described as {
      |Emitted when sawmill receives a log shipment.
    }
  }
  query GetMillCapacity replies result MillCapacity is {
    sawmillId: SawmillId with {
      briefly "Sawmill"
      described as {
        |Sawmill ID.
      }
    }
  } with {
    briefly "Get mill capacity"
    described as {
      |Gets current sawmill receiving capacity.
    }
  }
  result MillCapacity is {
    sawmillId: SawmillId with {
      briefly "Sawmill"
      described as {
        |Sawmill ID.
      }
    }
    availableSlots: Natural with {
      briefly "Slots"
      described as {
        |Available receiving slots.
      }
    }
    nextAvailable: TimeStamp with {
      briefly "Next"
      described as {
        |Next available time.
      }
    }
  } with {
    briefly "Mill capacity"
    described as {
      |Sawmill receiving capacity information.
    }
  }
} with {
  briefly "External sawmill system"
  described as {
    |Sawmill receiving and processing system.
  }
}
external context RegulatorySystem as split is {
  outlet RegulatorySystemRepliesOut is result PermitVerification
 with {
    briefly "What this service answers, on its way back"
  }
  outlet RegulatorySystemEventsOut is event ReportAccepted
 with {
    briefly "What this service tells the model, unasked"
  }
  type RegulatorySystemRequest is one of {
    SubmitHarvestReport or VerifyPermit
  } with {
    briefly "Everything this service can be asked"
  }
  inlet RegulatorySystemRequests is type RegulatorySystemRequest with {
    briefly "What this context asks the service to send"
  }
  handler RegulatorySystemBoundary is {
    on query VerifyPermit is {
      let askAnswer: type PermitVerification = prompt("look up what VerifyPermit asks for")
      reply askAnswer
    }
    on command SubmitHarvestReport is {
      let reportAccepted: type ReportAccepted = prompt("the report accepted this produces")
      send reportAccepted to outlet RegulatorySystem.RegulatorySystemEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context RegulatorySystem"
    }
  } with {
    briefly "RegulatorySystem boundary"
  }
  command SubmitHarvestReport is {
    harvestSiteId: HarvestSiteId with {
      briefly "Site"
      described as {
        |Harvest site ID.
      }
    }
    logCount: Natural with {
      briefly "Count"
      described as {
        |Number of logs harvested.
      }
    }
    totalVolume: Decimal(12,4) with {
      briefly "Volume"
      described as {
        |Total volume harvested.
      }
    }
    reportPeriod: String(3,50) with {
      briefly "Period"
      described as {
        |Reporting period.
      }
    }
  } with {
    briefly "Submit harvest report"
    described as {
      |Submits harvest volume report to regulatory authority.
    }
  }
  event ReportAccepted is {
    harvestSiteId: HarvestSiteId with {
      briefly "Site"
      described as {
        |Harvest site ID.
      }
    }
    acceptedAt: TimeStamp with {
      briefly "Accepted"
      described as {
        |Acceptance time.
      }
    }
    referenceNumber: String(3,100) with {
      briefly "Reference"
      described as {
        |Report reference number.
      }
    }
  } with {
    briefly "Report accepted"
    described as {
      |Emitted when harvest report is accepted by regulator.
    }
  }
  query VerifyPermit replies result PermitVerification is {
    harvestPermit: String(3,100) with {
      briefly "Permit"
      described as {
        |Harvest permit number.
      }
    }
  } with {
    briefly "Verify permit"
    described as {
      |Verifies a harvest permit with regulatory authority.
    }
  }
  result PermitVerification is {
    harvestPermit: String(3,100) with {
      briefly "Permit"
      described as {
        |Harvest permit number.
      }
    }
    isValid: Boolean with {
      briefly "Valid"
      described as {
        |Permit validity.
      }
    }
    expiresAt: Date? with {
      briefly "Expires"
      described as {
        |Permit expiration date.
      }
    }
    allowedSpecies: String(3,50)* with {
      briefly "Species"
      described as {
        |Permitted species.
      }
    }
  } with {
    briefly "Permit verification"
    described as {
      |Harvest permit verification result.
    }
  }
} with {
  briefly "External regulatory system"
  described as {
    |Government regulatory and compliance system.
  }
}
