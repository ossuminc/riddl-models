// Log Tracking - Log Tracking Context
context LogTrackingContext as router is {
  inlet TimberLogCommandStreamIn is type TimberLogCommand  outlet TimberLogCommandStreamOut is type TimberLogCommand
  inlet TimberLogResultStreamIn is type TimberLog.TimberLogResult  outlet TimberLogResultStreamOut is type TimberLog.TimberLogResult
  handler LogTrackingContextBoundary is {
    on registerLog: command TimberLog.RegisterLog is {
      send registerLog to outlet LogTrackingContext.TimberLogCommandStreamOut
    }
    on scaleLog: command TimberLog.ScaleLog is {
      send scaleLog to outlet LogTrackingContext.TimberLogCommandStreamOut
    }
    on loadForTransport: command TimberLog.LoadForTransport is {
      send loadForTransport to outlet LogTrackingContext.TimberLogCommandStreamOut
    }
    on markInTransit: command TimberLog.MarkInTransit is {
      send markInTransit to outlet LogTrackingContext.TimberLogCommandStreamOut
    }
    on recordDelivery: command TimberLog.RecordDelivery is {
      send recordDelivery to outlet LogTrackingContext.TimberLogCommandStreamOut
    }
    on rejectLog: command TimberLog.RejectLog is {
      send rejectLog to outlet LogTrackingContext.TimberLogCommandStreamOut
    }
    on quarantineLog: command TimberLog.QuarantineLog is {
      send quarantineLog to outlet LogTrackingContext.TimberLogCommandStreamOut
    }
    on attachComplianceDocument: command TimberLog.AttachComplianceDocument is {
      send attachComplianceDocument to outlet LogTrackingContext.TimberLogCommandStreamOut
    }
    on timberLogResult: result TimberLog.TimberLogResult is {
      send timberLogResult to outlet LogTrackingContext.TimberLogResultStreamOut
    }
    on other is {
      error "Unexpected message at the LogTrackingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TimberLogCommand Stream Intake' is from outlet LogTrackingContext.TimberLogCommandStreamOut to inlet LogTrackingContext.TimberLog.TimberLogCommands  connector 'TimberLogResult Stream Egress' is from outlet LogTrackingContext.LogTrackingRepository.LogTrackingRepositoryResponses to inlet LogTrackingContext.TimberLogResultStreamIn  adaptor FromRegulatorySystem from context RegulatorySystem is { 
    handler FromRegulatorySystemHandler is {
      on result RegulatorySystem.PermitVerification is {
        do "the model receives permit verification"
      }
      on event RegulatorySystem.ReportAccepted is {
        do "the model receives report accepted"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatorySystem"
      }
    } with {
      briefly "from regulatory system"
      described as {
        |Carries messages from the external RegulatorySystem.
      }
    }
  } with {
    briefly "RegulatorySystem integration"
    described as {
      |The model's side of the RegulatorySystem conversation.
    }
  }
  adaptor ToRegulatorySystem to context RegulatorySystem is { 
    handler ToRegulatorySystemHandler is {
      on command RegulatorySystem.SubmitHarvestReport is {
        do "the model sends submit harvest report"
      }
      on query RegulatorySystem.VerifyPermit is {
        do "the model sends verify permit"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatorySystem"
      }
    } with {
      briefly "to regulatory system"
      described as {
        |Carries messages to the external RegulatorySystem.
      }
    }
  } with {
    briefly "RegulatorySystem integration"
    described as {
      |The model's side of the RegulatorySystem conversation.
    }
  }
  adaptor FromSawmillSystem from context SawmillSystem is { 
    handler FromSawmillSystemHandler is {
      on event SawmillSystem.LoadReceived is {
        do "the model receives load received"
      }
      on result SawmillSystem.MillCapacity is {
        do "the model receives mill capacity"
      }
      on other is {
        error "Unexpected message for adaptor FromSawmillSystem"
      }
    } with {
      briefly "from sawmill system"
      described as {
        |Carries messages from the external SawmillSystem.
      }
    }
  } with {
    briefly "SawmillSystem integration"
    described as {
      |The model's side of the SawmillSystem conversation.
    }
  }
  adaptor ToSawmillSystem to context SawmillSystem is { 
    handler ToSawmillSystemHandler is {
      on query SawmillSystem.GetMillCapacity is {
        do "the model sends get mill capacity"
      }
      on command SawmillSystem.NotifyIncomingLoad is {
        do "the model sends notify incoming load"
      }
      on other is {
        error "Unexpected message for adaptor ToSawmillSystem"
      }
    } with {
      briefly "to sawmill system"
      described as {
        |Carries messages to the external SawmillSystem.
      }
    }
  } with {
    briefly "SawmillSystem integration"
    described as {
      |The model's side of the SawmillSystem conversation.
    }
  }
  adaptor FromTransportSystem from context TransportSystem is { 
    handler FromTransportSystemHandler is {
      on result TransportSystem.TransportStatus is {
        do "the model receives transport status"
      }
      on event TransportSystem.TruckDispatched is {
        do "the model receives truck dispatched"
      }
      on other is {
        error "Unexpected message for adaptor FromTransportSystem"
      }
    } with {
      briefly "from transport system"
      described as {
        |Carries messages from the external TransportSystem.
      }
    }
  } with {
    briefly "TransportSystem integration"
    described as {
      |The model's side of the TransportSystem conversation.
    }
  }
  adaptor ToTransportSystem to context TransportSystem is { 
    handler ToTransportSystemHandler is {
      on command TransportSystem.DispatchTruck is {
        do "the model sends dispatch truck"
      }
      on query TransportSystem.GetTransportStatus is {
        do "the model sends get transport status"
      }
      on other is {
        error "Unexpected message for adaptor ToTransportSystem"
      }
    } with {
      briefly "to transport system"
      described as {
        |Carries messages to the external TransportSystem.
      }
    }
  } with {
    briefly "TransportSystem integration"
    described as {
      |The model's side of the TransportSystem conversation.
    }
  }
  include "types.riddl"
  include "TimberLog.riddl"
  type LogTrackingRepositoryCommand is one of {
    LogTrackingContext.LogTrackingRepository.PersistComplianceDocumentAttached or LogTrackingContext.LogTrackingRepository.PersistLogDelivered or LogTrackingContext.LogTrackingRepository.PersistLogInTransit or LogTrackingContext.LogTrackingRepository.PersistLogLoaded or LogTrackingContext.LogTrackingRepository.PersistLogQuarantined or LogTrackingContext.LogTrackingRepository.PersistLogRegistered or LogTrackingContext.LogTrackingRepository.PersistLogRejected or LogTrackingContext.LogTrackingRepository.PersistLogScaled
  } with {
    briefly "Anything that writes LogTrackingRepository"
    described as {
      |The persistence commands LogTrackingRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository LogTrackingRepository as flow is {
    inlet LogTrackingRepositoryFromLogTrackingMetrics is type LogTrackingRepositoryCommand
    command PersistComplianceDocumentAttached is  {
      logId: TimberLogId with {
        briefly "Row addressed"
        described as {
          |Which stored row ComplianceDocumentAttached applies to.
        }
      }
    } with {
      briefly "Persist ComplianceDocumentAttached"
      described as {
        |Instructs this repository to apply ComplianceDocumentAttached to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLogInTransit is  {
      logId: TimberLogId with {
        briefly "Row addressed"
        described as {
          |Which stored row LogInTransit applies to.
        }
      }
    } with {
      briefly "Persist LogInTransit"
      described as {
        |Instructs this repository to apply LogInTransit to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLogLoaded is  {
      logId: TimberLogId with {
        briefly "Row addressed"
        described as {
          |Which stored row LogLoaded applies to.
        }
      }
    } with {
      briefly "Persist LogLoaded"
      described as {
        |Instructs this repository to apply LogLoaded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLogQuarantined is  {
      logId: TimberLogId with {
        briefly "Row addressed"
        described as {
          |Which stored row LogQuarantined applies to.
        }
      }
    } with {
      briefly "Persist LogQuarantined"
      described as {
        |Instructs this repository to apply LogQuarantined to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLogDelivered is  {
      logId: TimberLogId with {
        briefly "Row addressed"
        described as {
          |Which stored row LogDelivered applies to.
        }
      }
    } with {
      briefly "Persist LogDelivered"
      described as {
        |Instructs this repository to apply LogDelivered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLogRegistered is  {
      logId: TimberLogId with {
        briefly "Row addressed"
        described as {
          |Which stored row LogRegistered applies to.
        }
      }
    } with {
      briefly "Persist LogRegistered"
      described as {
        |Instructs this repository to apply LogRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLogRejected is  {
      logId: TimberLogId with {
        briefly "Row addressed"
        described as {
          |Which stored row LogRejected applies to.
        }
      }
    } with {
      briefly "Persist LogRejected"
      described as {
        |Instructs this repository to apply LogRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLogScaled is  {
      logId: TimberLogId with {
        briefly "Row addressed"
        described as {
          |Which stored row LogScaled applies to.
        }
      }
    } with {
      briefly "Persist LogScaled"
      described as {
        |Instructs this repository to apply LogScaled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet LogTrackingRepositoryResponses is type TimberLog.TimberLogResult
    record StoredTimberLog is  {
      timberLogId: TimberLogId with {
        briefly "timberLogId"
        described as {
          |The timberLogId column of the stored timberLog row.
        }
      }
      fellingInfo: FellingInfo with {
        briefly "fellingInfo"
        described as {
          |The fellingInfo column of the stored timberLog row.
        }
      }
      logId: TimberLogId with {
        briefly "logId"
        described as {
          |The logId column of the stored timberLog row.
        }
      }
      status: LogStatus with {
        briefly "status"
        described as {
          |The status column of the stored timberLog row.
        }
      }
    } with {
      briefly "Stored timberLog row"
      described as {
        |The persistence shape of timberLog data as this repository stores it.
      }
    }
    schema LogTrackingData is relational
      of timberLogs as type StoredTimberLog
        index on field StoredTimberLog.logId
        index on field StoredTimberLog.fellingInfo.harvestSiteId
        index on field StoredTimberLog.status
 with {
      briefly "Log tracking data schema"
      described as {
        |The relational schema holding log tracking data for the LogTrackingRepository.
      }
    }
    handler LogTrackingPersistence is {
      on persistComplianceDocumentAttached: command PersistComplianceDocumentAttached is {
        do "apply ComplianceDocumentAttached to the stored row"
      }
      on persistLogInTransit: command PersistLogInTransit is {
        do "apply LogInTransit to the stored row"
      }
      on persistLogLoaded: command PersistLogLoaded is {
        do "apply LogLoaded to the stored row"
      }
      on persistLogQuarantined: command PersistLogQuarantined is {
        do "apply LogQuarantined to the stored row"
      }
      on persistLogDelivered: command PersistLogDelivered is {
        do "apply LogDelivered to the stored row"
      }
      on persistLogRegistered: command PersistLogRegistered is {
        do "apply LogRegistered to the stored row"
      }
      on persistLogRejected: command PersistLogRejected is {
        do "apply LogRejected to the stored row"
      }
      on persistLogScaled: command PersistLogScaled is {
        do "apply LogScaled to the stored row"
      }
      on query GetVolumeMetrics is {
        let volumeMetricsView: type VolumeMetricsView = prompt("read the volume metrics projection")
        reply volumeMetricsView
      }
    } with {
      briefly "Persists log tracking events"
      described as {
        |Handles command-driven persistence for timber logs.
      }
    }
  } with {
    briefly "Log tracking data persistence"
    described as {
      |Persistent storage for timber log tracking.
    }
  }
  query GetVolumeMetrics replies result VolumeMetricsView is  {
    volumeMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which volume metrics to retrieve.
      }
    }
  } with {
    briefly "Get volume metrics"
    described as {
      |Retrieves the volume metrics projection.
    }
  }
  result VolumeMetricsView is  {
    volumeMetrics: LogTrackingMetrics.VolumeMetrics with {
      briefly "Volume metrics"
      described as {
        |The volume metrics being returned.
      }
    }
  } with {
    briefly "Volume metrics view"
    described as {
      |Read model view carrying the volume metrics projection.
    }
  }
  projector LogTrackingMetrics as flow is {
    outlet LogTrackingMetricsToRepository is type LogTrackingRepositoryCommand
    updates repository LogTrackingContext.LogTrackingRepository
    inlet LogTrackingMetricsFromTimberLog is type TimberLogEvent
    record VolumeMetrics is  {
      logsRegistered: Natural with {
        briefly "Registered"
        described as {
          |Total logs registered.
        }
      }
      logsDelivered: Natural with {
        briefly "Delivered"
        described as {
          |Total logs delivered.
        }
      }
      logsRejected: Natural with {
        briefly "Rejected"
        described as {
          |Total logs rejected.
        }
      }
      totalVolumeCubicMeters: Decimal(12,4) with {
        briefly "Total volume"
        described as {
          |Total volume in cubic meters.
        }
      }
      averageGradeScore: Decimal(4,2) with {
        briefly "Avg grade"
        described as {
          |Average grade quality score.
        }
      }
    } with {
      briefly "Volume metrics"
      described as {
        |Log volume and quality metrics.
      }
    }
    handler MetricsHandler is {
      on complianceDocumentAttached: event TimberLog.ComplianceDocumentAttached is {
        tell command LogTrackingContext.LogTrackingRepository.PersistComplianceDocumentAttached(logId = complianceDocumentAttached.logId) to repository LogTrackingContext.LogTrackingRepository
        do "apply ComplianceDocumentAttached to the LogTrackingMetrics projection"
      }
      on logInTransit: event TimberLog.LogInTransit is {
        tell command LogTrackingContext.LogTrackingRepository.PersistLogInTransit(logId = logInTransit.logId) to repository LogTrackingContext.LogTrackingRepository
        do "apply LogInTransit to the LogTrackingMetrics projection"
      }
      on logLoaded: event TimberLog.LogLoaded is {
        tell command LogTrackingContext.LogTrackingRepository.PersistLogLoaded(logId = logLoaded.logId) to repository LogTrackingContext.LogTrackingRepository
        do "apply LogLoaded to the LogTrackingMetrics projection"
      }
      on logQuarantined: event TimberLog.LogQuarantined is {
        tell command LogTrackingContext.LogTrackingRepository.PersistLogQuarantined(logId = logQuarantined.logId) to repository LogTrackingContext.LogTrackingRepository
        do "apply LogQuarantined to the LogTrackingMetrics projection"
      }
      on logRegistered: event TimberLog.LogRegistered is {
        tell command LogTrackingContext.LogTrackingRepository.PersistLogRegistered(logId = logRegistered.logId) to repository LogTrackingContext.LogTrackingRepository
        do "Increment logs registered"
      }
      on logDelivered: event TimberLog.LogDelivered is {
        tell command LogTrackingContext.LogTrackingRepository.PersistLogDelivered(logId = logDelivered.logId) to repository LogTrackingContext.LogTrackingRepository
        do "Increment logs delivered and update volume totals"
      }
      on logRejected: event TimberLog.LogRejected is {
        tell command LogTrackingContext.LogTrackingRepository.PersistLogRejected(logId = logRejected.logId) to repository LogTrackingContext.LogTrackingRepository
        do "Increment logs rejected"
      }
      on logScaled: event TimberLog.LogScaled is {
        tell command LogTrackingContext.LogTrackingRepository.PersistLogScaled(logId = logScaled.logId) to repository LogTrackingContext.LogTrackingRepository
        do "Update volume and grade metrics"
      }
    } with {
      briefly "Maintains log tracking metrics"
      described as {
        |Projects events into volume and quality metrics.
      }
    }
  } with {
    briefly "Log tracking metrics"
    described as {
      |Forestry log tracking analytics.
    }
  }
  // ---- Event publication for TimberLog ----
  type TimberLogEvent is one of {
    LogTrackingContext.TimberLog.LogRegistered or LogTrackingContext.TimberLog.LogScaled or LogTrackingContext.TimberLog.LogLoaded or LogTrackingContext.TimberLog.LogInTransit or LogTrackingContext.TimberLog.LogDelivered or LogTrackingContext.TimberLog.LogRejected or LogTrackingContext.TimberLog.LogQuarantined or LogTrackingContext.TimberLog.ComplianceDocumentAttached
  } with {
    briefly "TimberLog event alternation"
    described as {
      |Union of all TimberLog events, for streaming and event-sourced
      |persistence.
    }
  }
  processor TimberLogEventSplit as flow is {
    inlet TimberLogEventSplitIn is type TimberLogEvent
    outlet TimberLogEventSplitToLogTrackingMetrics is type TimberLogEvent
    handler TimberLogEventSplitHandler is {
      on logRegistered: event TimberLog.LogRegistered is {
        send logRegistered to outlet TimberLogEventSplitToLogTrackingMetrics
        tell logRegistered to entity LogTrackingContext.TimberLog
      }
      on logScaled: event TimberLog.LogScaled is {
        send logScaled to outlet TimberLogEventSplitToLogTrackingMetrics
        tell logScaled to entity LogTrackingContext.TimberLog
      }
      on logLoaded: event TimberLog.LogLoaded is {
        send logLoaded to outlet TimberLogEventSplitToLogTrackingMetrics
        tell logLoaded to entity LogTrackingContext.TimberLog
      }
      on logInTransit: event TimberLog.LogInTransit is {
        send logInTransit to outlet TimberLogEventSplitToLogTrackingMetrics
        tell logInTransit to entity LogTrackingContext.TimberLog
      }
      on logDelivered: event TimberLog.LogDelivered is {
        send logDelivered to outlet TimberLogEventSplitToLogTrackingMetrics
        tell logDelivered to entity LogTrackingContext.TimberLog
      }
      on logRejected: event TimberLog.LogRejected is {
        send logRejected to outlet TimberLogEventSplitToLogTrackingMetrics
        tell logRejected to entity LogTrackingContext.TimberLog
      }
      on logQuarantined: event TimberLog.LogQuarantined is {
        send logQuarantined to outlet TimberLogEventSplitToLogTrackingMetrics
        tell logQuarantined to entity LogTrackingContext.TimberLog
      }
      on complianceDocumentAttached: event TimberLog.ComplianceDocumentAttached is {
        send complianceDocumentAttached to outlet TimberLogEventSplitToLogTrackingMetrics
        tell complianceDocumentAttached to entity LogTrackingContext.TimberLog
      }
      on other is {
        error "Unexpected message for processor TimberLogEventSplit"
      }
    } with {
      briefly "TimberLog event fan-out handler"
      described as {
        |Delivers each TimberLog event to all of its consumers.
      }
    }
  } with {
    briefly "TimberLog event fan-out"
    described as {
      |Fans TimberLog events out to the repository and projectors.
    }
  }
  connector 'TimberLogEvent Stream' is from outlet LogTrackingContext.TimberLog.TimberLogEvents2 to inlet LogTrackingContext.TimberLogEventSplit.TimberLogEventSplitIn with {
    briefly "TimberLog events, fanned out to storage and read models"
  }
  connector 'LogTrackingMetrics Feed' is from outlet LogTrackingContext.TimberLogEventSplit.TimberLogEventSplitToLogTrackingMetrics to inlet LogTrackingContext.LogTrackingMetrics.LogTrackingMetricsFromTimberLog with {
    briefly "TimberLog events feeding the LogTrackingMetrics projection"
  }
  connector 'LogTrackingMetrics Storage' is from outlet LogTrackingContext.LogTrackingMetrics.LogTrackingMetricsToRepository to inlet LogTrackingContext.LogTrackingRepository.LogTrackingRepositoryFromLogTrackingMetrics with {
    briefly "LogTrackingMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for log tracking"
  described as {
    |Forestry log tracking from felling through transport to sawmill.
  }
}
