// Log Tracking - Log Tracking Context
context LogTrackingContext is {
  adaptor FromRegulatorySystem from context RegulatorySystem is { 
    handler FromRegulatorySystemHandler is {
      on result RegulatorySystem.PermitVerification is {
        do "the model receives permit verification"
      }
      on event RegulatorySystem.ReportAccepted is {
        do "the model receives report accepted"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatorySystem"
      }
    } with {
      briefly "from regulatory system"
      described as {
        |Carries messages from the external RegulatorySystem.
      }
    }
  } with {
    briefly "RegulatorySystem integration"
    described as {
      |The model's side of the RegulatorySystem conversation.
    }
  }
  adaptor ToRegulatorySystem to context RegulatorySystem is { 
    handler ToRegulatorySystemHandler is {
      on command RegulatorySystem.SubmitHarvestReport is {
        do "the model sends submit harvest report"
      }
      on query RegulatorySystem.VerifyPermit is {
        do "the model sends verify permit"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatorySystem"
      }
    } with {
      briefly "to regulatory system"
      described as {
        |Carries messages to the external RegulatorySystem.
      }
    }
  } with {
    briefly "RegulatorySystem integration"
    described as {
      |The model's side of the RegulatorySystem conversation.
    }
  }
  adaptor FromSawmillSystem from context SawmillSystem is { 
    handler FromSawmillSystemHandler is {
      on event SawmillSystem.LoadReceived is {
        do "the model receives load received"
      }
      on result SawmillSystem.MillCapacity is {
        do "the model receives mill capacity"
      }
      on other is {
        error "Unexpected message for adaptor FromSawmillSystem"
      }
    } with {
      briefly "from sawmill system"
      described as {
        |Carries messages from the external SawmillSystem.
      }
    }
  } with {
    briefly "SawmillSystem integration"
    described as {
      |The model's side of the SawmillSystem conversation.
    }
  }
  adaptor ToSawmillSystem to context SawmillSystem is { 
    handler ToSawmillSystemHandler is {
      on query SawmillSystem.GetMillCapacity is {
        do "the model sends get mill capacity"
      }
      on command SawmillSystem.NotifyIncomingLoad is {
        do "the model sends notify incoming load"
      }
      on other is {
        error "Unexpected message for adaptor ToSawmillSystem"
      }
    } with {
      briefly "to sawmill system"
      described as {
        |Carries messages to the external SawmillSystem.
      }
    }
  } with {
    briefly "SawmillSystem integration"
    described as {
      |The model's side of the SawmillSystem conversation.
    }
  }
  adaptor FromTransportSystem from context TransportSystem is { 
    handler FromTransportSystemHandler is {
      on result TransportSystem.TransportStatus is {
        do "the model receives transport status"
      }
      on event TransportSystem.TruckDispatched is {
        do "the model receives truck dispatched"
      }
      on other is {
        error "Unexpected message for adaptor FromTransportSystem"
      }
    } with {
      briefly "from transport system"
      described as {
        |Carries messages from the external TransportSystem.
      }
    }
  } with {
    briefly "TransportSystem integration"
    described as {
      |The model's side of the TransportSystem conversation.
    }
  }
  adaptor ToTransportSystem to context TransportSystem is { 
    handler ToTransportSystemHandler is {
      on command TransportSystem.DispatchTruck is {
        do "the model sends dispatch truck"
      }
      on query TransportSystem.GetTransportStatus is {
        do "the model sends get transport status"
      }
      on other is {
        error "Unexpected message for adaptor ToTransportSystem"
      }
    } with {
      briefly "to transport system"
      described as {
        |Carries messages to the external TransportSystem.
      }
    }
  } with {
    briefly "TransportSystem integration"
    described as {
      |The model's side of the TransportSystem conversation.
    }
  }
  include "types.riddl"
  include "TimberLog.riddl"
  repository LogTrackingRepository is {
    inlet LogTrackingRepositoryFromTimberLog is type TimberLogEvent    inlet LogTrackingRepositoryFromLogTrackingMetrics is type TimberLogEvent    outlet LogTrackingRepositoryResponses is type TimberLog.TimberLogResult
    record StoredTimberLog is  {
      timberLogId: TimberLogId with {
        briefly "timberLogId"
        described as {
          |The timberLogId column of the stored timberLog row.
        }
      }
      fellingInfo: FellingInfo with {
        briefly "fellingInfo"
        described as {
          |The fellingInfo column of the stored timberLog row.
        }
      }
      logId: TimberLogId with {
        briefly "logId"
        described as {
          |The logId column of the stored timberLog row.
        }
      }
      status: LogStatus with {
        briefly "status"
        described as {
          |The status column of the stored timberLog row.
        }
      }
    } with {
      briefly "Stored timberLog row"
      described as {
        |The persistence shape of timberLog data as this repository stores it.
      }
    }
    schema LogTrackingData is relational
      of timberLogs as type StoredTimberLog
        index on field StoredTimberLog.logId
        index on field StoredTimberLog.fellingInfo.harvestSiteId
        index on field StoredTimberLog.status
 with {
      briefly "Log tracking data schema"
      described as {
        |The relational schema holding log tracking data for the LogTrackingRepository.
      }
    }
    handler LogTrackingPersistence is {
      on query GetVolumeMetrics is {
        do "read the volume metrics projection"
        yield result VolumeMetricsView
      }
      on command TimberLog.RegisterLog is {
        do "Store new timber log"
      }
      on command TimberLog.ScaleLog is {
        do "Update log with scaling measurement"
      }
      on command TimberLog.LoadForTransport is {
        do "Update log with transport info"
      }
      on command TimberLog.RecordDelivery is {
        do "Update log to delivered status"
      }
      on command TimberLog.RejectLog is {
        tell event TimberLog.LogRejected to entity LogTrackingContext.TimberLog
        do "Update log to rejected status"
      }
      on command TimberLog.AttachComplianceDocument is {
        do "Store compliance document for log"
      }
    } with {
      briefly "Persists log tracking events"
      described as {
        |Handles command-driven persistence for timber logs.
      }
    }
  } with {
    briefly "Log tracking data persistence"
    described as {
      |Persistent storage for timber log tracking.
    }
  }
  query GetVolumeMetrics is  {
    volumeMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which volume metrics to retrieve.
      }
    }
  } with {
    briefly "Get volume metrics"
    described as {
      |Retrieves the volume metrics projection.
    }
  }
  result VolumeMetricsView is  {
    volumeMetrics: LogTrackingMetrics.VolumeMetrics with {
      briefly "Volume metrics"
      described as {
        |The volume metrics being returned.
      }
    }
  } with {
    briefly "Volume metrics view"
    described as {
      |Read model view carrying the volume metrics projection.
    }
  }
  projector LogTrackingMetrics is {
    updates repository LogTrackingContext.LogTrackingRepository
    inlet LogTrackingMetricsFromTimberLog is type TimberLogEvent    outlet LogTrackingMetricsOut is type TimberLogEvent
    record VolumeMetrics is  {
      logsRegistered: Natural with {
        briefly "Registered"
        described as {
          |Total logs registered.
        }
      }
      logsDelivered: Natural with {
        briefly "Delivered"
        described as {
          |Total logs delivered.
        }
      }
      logsRejected: Natural with {
        briefly "Rejected"
        described as {
          |Total logs rejected.
        }
      }
      totalVolumeCubicMeters: Decimal(12,4) with {
        briefly "Total volume"
        described as {
          |Total volume in cubic meters.
        }
      }
      averageGradeScore: Decimal(4,2) with {
        briefly "Avg grade"
        described as {
          |Average grade quality score.
        }
      }
    } with {
      briefly "Volume metrics"
      described as {
        |Log volume and quality metrics.
      }
    }
    handler MetricsHandler is {
      on event TimberLog.LogRegistered is {
        tell event TimberLog.LogRegistered to repository LogTrackingContext.LogTrackingRepository
        do "Increment logs registered"
      }
      on event TimberLog.LogDelivered is {
        tell event TimberLog.LogDelivered to repository LogTrackingContext.LogTrackingRepository
        do "Increment logs delivered and update volume totals"
      }
      on event TimberLog.LogRejected is {
        tell event TimberLog.LogRejected to repository LogTrackingContext.LogTrackingRepository
        do "Increment logs rejected"
      }
      on event TimberLog.LogScaled is {
        tell event TimberLog.LogScaled to repository LogTrackingContext.LogTrackingRepository
        do "Update volume and grade metrics"
      }
    } with {
      briefly "Maintains log tracking metrics"
      described as {
        |Projects events into volume and quality metrics.
      }
    }
  } with {
    briefly "Log tracking metrics"
    described as {
      |Forestry log tracking analytics.
    }
  }
  // ---- Event publication for TimberLog ----
  type TimberLogEvent is one of {
    LogTrackingContext.TimberLog.LogRegistered or LogTrackingContext.TimberLog.LogScaled or LogTrackingContext.TimberLog.LogLoaded or LogTrackingContext.TimberLog.LogInTransit or LogTrackingContext.TimberLog.LogDelivered or LogTrackingContext.TimberLog.LogRejected or LogTrackingContext.TimberLog.LogQuarantined or LogTrackingContext.TimberLog.ComplianceDocumentAttached
  } with {
    briefly "TimberLog event alternation"
    described as {
      |Union of all TimberLog events, for streaming and event-sourced
      |persistence.
    }
  }
  processor TimberLogEventSource as source is {
    outlet TimberLogEvents is type TimberLogEvent
    handler TimberLogSourceHandler is {
      on event TimberLog.LogRegistered is {
        send event TimberLog.LogRegistered to outlet TimberLogEvents
      }
      on event TimberLog.LogScaled is {
        send event TimberLog.LogScaled to outlet TimberLogEvents
      }
      on event TimberLog.LogLoaded is {
        send event TimberLog.LogLoaded to outlet TimberLogEvents
      }
      on event TimberLog.LogInTransit is {
        send event TimberLog.LogInTransit to outlet TimberLogEvents
      }
      on event TimberLog.LogDelivered is {
        send event TimberLog.LogDelivered to outlet TimberLogEvents
      }
      on event TimberLog.LogRejected is {
        send event TimberLog.LogRejected to outlet TimberLogEvents
      }
      on event TimberLog.LogQuarantined is {
        send event TimberLog.LogQuarantined to outlet TimberLogEvents
      }
      on event TimberLog.ComplianceDocumentAttached is {
        send event TimberLog.ComplianceDocumentAttached to outlet TimberLogEvents
      }
      on other is {
        error "Unexpected message for source TimberLogEventSource"
      }
    } with {
      briefly "TimberLog source handler"
      described as {
        |Publishes TimberLog events onto the outlet.
      }
    }
  } with {
    briefly "TimberLog event source"
    described as {
      |Publishes TimberLog entity events into the streaming topology.
    }
  }
  processor TimberLogEventSink as sink is {
    inlet TimberLogInlet is type TimberLogEvent    handler TimberLogSinkHandler is {
      on event TimberLog.LogRegistered is {
        tell event TimberLog.LogRegistered to repository LogTrackingContext.LogTrackingRepository
      }
      on event TimberLog.LogScaled is {
        tell event TimberLog.LogScaled to repository LogTrackingContext.LogTrackingRepository
      }
      on event TimberLog.LogLoaded is {
        tell event TimberLog.LogLoaded to repository LogTrackingContext.LogTrackingRepository
      }
      on event TimberLog.LogInTransit is {
        tell event TimberLog.LogInTransit to repository LogTrackingContext.LogTrackingRepository
      }
      on event TimberLog.LogDelivered is {
        tell event TimberLog.LogDelivered to repository LogTrackingContext.LogTrackingRepository
      }
      on event TimberLog.LogRejected is {
        tell event TimberLog.LogRejected to repository LogTrackingContext.LogTrackingRepository
      }
      on event TimberLog.LogQuarantined is {
        tell event TimberLog.LogQuarantined to repository LogTrackingContext.LogTrackingRepository
      }
      on event TimberLog.ComplianceDocumentAttached is {
        tell event TimberLog.ComplianceDocumentAttached to repository LogTrackingContext.LogTrackingRepository
      }
      on other is {
        error "Unexpected message for sink TimberLogEventSink"
      }
    } with {
      briefly "TimberLog sink handler"
      described as {
        |Persists TimberLog events via the repository.
      }
    }
  } with {
    briefly "TimberLog event sink"
    described as {
      |Receives TimberLog events for persistence.
    }
  }
  connector TimberLogEventFlow is from outlet LogTrackingContext.TimberLogEventSource.TimberLogEvents to inlet LogTrackingContext.TimberLogEventSink.TimberLogInlet with {
    briefly "TimberLog event flow"
    described as {
      |Connects the TimberLog source to its sink.
    }
  }
  processor TimberLogEventSplit is {
    inlet TimberLogEventSplitIn is type TimberLogEvent    outlet TimberLogEventSplitToLogTrackingRepository is type TimberLogEvent
    outlet TimberLogEventSplitToLogTrackingMetrics is type TimberLogEvent
    handler TimberLogEventSplitHandler is {
      on event TimberLog.LogRegistered is {
        send event TimberLog.LogRegistered to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.LogRegistered to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.LogRegistered to entity LogTrackingContext.TimberLog
      }
      on event TimberLog.LogScaled is {
        send event TimberLog.LogScaled to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.LogScaled to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.LogScaled to entity LogTrackingContext.TimberLog
      }
      on event TimberLog.LogLoaded is {
        send event TimberLog.LogLoaded to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.LogLoaded to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.LogLoaded to entity LogTrackingContext.TimberLog
      }
      on event TimberLog.LogInTransit is {
        send event TimberLog.LogInTransit to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.LogInTransit to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.LogInTransit to entity LogTrackingContext.TimberLog
      }
      on event TimberLog.LogDelivered is {
        send event TimberLog.LogDelivered to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.LogDelivered to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.LogDelivered to entity LogTrackingContext.TimberLog
      }
      on event TimberLog.LogRejected is {
        send event TimberLog.LogRejected to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.LogRejected to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.LogRejected to entity LogTrackingContext.TimberLog
      }
      on event TimberLog.LogQuarantined is {
        send event TimberLog.LogQuarantined to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.LogQuarantined to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.LogQuarantined to entity LogTrackingContext.TimberLog
      }
      on event TimberLog.ComplianceDocumentAttached is {
        send event TimberLog.ComplianceDocumentAttached to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.ComplianceDocumentAttached to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.ComplianceDocumentAttached to entity LogTrackingContext.TimberLog
      }
      on other is {
        error "Unexpected message for processor TimberLogEventSplit"
      }
    } with {
      briefly "TimberLog event fan-out handler"
      described as {
        |Delivers each TimberLog event to all of its consumers.
      }
    }
  } with {
    briefly "TimberLog event fan-out"
    described as {
      |Fans TimberLog events out to the repository and projectors.
    }
  }
  connector TimberLogEventStream is from outlet LogTrackingContext.TimberLog.TimberLogEvents2 to inlet LogTrackingContext.TimberLogEventSplit.TimberLogEventSplitIn with {
    briefly "TimberLog events, fanned out to storage and read models"
  }
  connector TimberLogEventStorage is from outlet LogTrackingContext.TimberLogEventSplit.TimberLogEventSplitToLogTrackingRepository to inlet LogTrackingContext.LogTrackingRepository.LogTrackingRepositoryFromTimberLog with {
    briefly "TimberLog events on their way to storage"
  }
  connector LogTrackingMetricsFeed is from outlet LogTrackingContext.TimberLogEventSplit.TimberLogEventSplitToLogTrackingMetrics to inlet LogTrackingContext.LogTrackingMetrics.LogTrackingMetricsFromTimberLog with {
    briefly "TimberLog events feeding the LogTrackingMetrics projection"
  }
  connector LogTrackingMetricsStorage is from outlet LogTrackingContext.LogTrackingMetrics.LogTrackingMetricsOut to inlet LogTrackingContext.LogTrackingRepository.LogTrackingRepositoryFromLogTrackingMetrics with {
    briefly "The LogTrackingMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for log tracking"
  described as {
    |Forestry log tracking from felling through transport to sawmill.
  }
}
