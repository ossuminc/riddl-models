// Log Tracking - Log Tracking Context
context LogTrackingContext is {
  include "types.riddl"
  include "TimberLog.riddl"
  repository LogTrackingRepository is {
    inlet LogTrackingRepositoryFromTimberLog is type TimberLogEvent
    inlet LogTrackingRepositoryFromLogTrackingMetrics is type TimberLogEvent
    outlet LogTrackingRepositoryResponses is type TimberLog.TimberLogResult
    schema LogTrackingData is relational
      of timberLogs as type TimberLog
        index on field TimberLog.logId
        index on field TimberLog.fellingInfo.harvestSiteId
        index on field TimberLog.status
      with {
      briefly "Log tracking data schema"
      described as {
        |The relational schema holding log tracking data for the LogTrackingRepository.
      }
    }

    handler LogTrackingPersistence is {
      on command TimberLog.RegisterLog is {
        do "Store new timber log"
      }
      on command TimberLog.ScaleLog is {
        do "Update log with scaling measurement"
      }
      on command TimberLog.LoadForTransport is {
        do "Update log with transport info"
      }
      on command TimberLog.RecordDelivery is {
        do "Update log to delivered status"
      }
      on command TimberLog.RejectLog is {
        tell event TimberLog.LogRejected to entity LogTrackingContext.TimberLog
        do "Update log to rejected status"
      }
      on command TimberLog.AttachComplianceDocument is {
        do "Store compliance document for log"
      }
    } with {
      briefly "Persists log tracking events"
      described as {
        |Handles command-driven persistence for timber logs.
      }
    }
  } with {
    briefly "Log tracking data persistence"
    described as {
      |Persistent storage for timber log tracking.
    }
  }
  projector LogTrackingMetrics is {
    inlet LogTrackingMetricsFromTimberLog is type TimberLogEvent
    outlet LogTrackingMetricsOut is type TimberLogEvent
    updates repository LogTrackingContext.LogTrackingRepository
    record VolumeMetrics is  {
      logsRegistered: Natural with {
        briefly "Registered"
        described as {
          |Total logs registered.
        }
      }
      logsDelivered: Natural with {
        briefly "Delivered"
        described as {
          |Total logs delivered.
        }
      }
      logsRejected: Natural with {
        briefly "Rejected"
        described as {
          |Total logs rejected.
        }
      }
      totalVolumeCubicMeters: Decimal(12,4) with {
        briefly "Total volume"
        described as {
          |Total volume in cubic meters.
        }
      }
      averageGradeScore: Decimal(4,2) with {
        briefly "Avg grade"
        described as {
          |Average grade quality score.
        }
      }
    } with {
      briefly "Volume metrics"
      described as {
        |Log volume and quality metrics.
      }
    }
    handler MetricsHandler is {
      on event TimberLog.LogRegistered is {
        tell event TimberLog.LogRegistered to repository LogTrackingContext.LogTrackingRepository
        do "Increment logs registered"
      }
      on event TimberLog.LogDelivered is {
        tell event TimberLog.LogDelivered to repository LogTrackingContext.LogTrackingRepository
        do "Increment logs delivered and update volume totals"
      }
      on event TimberLog.LogRejected is {
        tell event TimberLog.LogRejected to repository LogTrackingContext.LogTrackingRepository
        do "Increment logs rejected"
      }
      on event TimberLog.LogScaled is {
        tell event TimberLog.LogScaled to repository LogTrackingContext.LogTrackingRepository
        do "Update volume and grade metrics"
      }
    } with {
      briefly "Maintains log tracking metrics"
      described as {
        |Projects events into volume and quality metrics.
      }
    }
  } with {
    briefly "Log tracking metrics"
    described as {
      |Forestry log tracking analytics.
    }
  }
  // ---- Event publication for TimberLog ----
  type TimberLogEvent is one of {
    LogTrackingContext.TimberLog.LogRegistered,
    LogTrackingContext.TimberLog.LogScaled,
    LogTrackingContext.TimberLog.LogLoaded,
    LogTrackingContext.TimberLog.LogInTransit,
    LogTrackingContext.TimberLog.LogDelivered,
    LogTrackingContext.TimberLog.LogRejected,
    LogTrackingContext.TimberLog.LogQuarantined,
    LogTrackingContext.TimberLog.ComplianceDocumentAttached
  } with {
    briefly "TimberLog event alternation"
    described as {
      |Union of all TimberLog events, for streaming and event-sourced
      |persistence.
    }
  }
  processor TimberLogEventSource as source is {
    outlet TimberLogEvents is type TimberLogEvent
    handler TimberLogSourceHandler is {
      on event TimberLog.LogRegistered is {
        send event TimberLog.LogRegistered to outlet TimberLogEvents
      }
      on event TimberLog.LogScaled is {
        send event TimberLog.LogScaled to outlet TimberLogEvents
      }
      on event TimberLog.LogLoaded is {
        send event TimberLog.LogLoaded to outlet TimberLogEvents
      }
      on event TimberLog.LogInTransit is {
        send event TimberLog.LogInTransit to outlet TimberLogEvents
      }
      on event TimberLog.LogDelivered is {
        send event TimberLog.LogDelivered to outlet TimberLogEvents
      }
      on event TimberLog.LogRejected is {
        send event TimberLog.LogRejected to outlet TimberLogEvents
      }
      on event TimberLog.LogQuarantined is {
        send event TimberLog.LogQuarantined to outlet TimberLogEvents
      }
      on event TimberLog.ComplianceDocumentAttached is {
        send event TimberLog.ComplianceDocumentAttached to outlet TimberLogEvents
      }
      on other is {
        error "Unexpected message for source TimberLogEventSource"
      }
    } with {
      briefly "TimberLog source handler"
      described as {
        |Publishes TimberLog events onto the outlet.
      }
    }
  } with {
    briefly "TimberLog event source"
    described as {
      |Publishes TimberLog entity events into the streaming topology.
    }
  }
  processor TimberLogEventSink as sink is {
    inlet TimberLogInlet is type TimberLogEvent
    handler TimberLogSinkHandler is {
      on event TimberLog.LogRegistered is {
        tell event TimberLog.LogRegistered to repository LogTrackingContext.LogTrackingRepository
      }
      on event TimberLog.LogScaled is {
        tell event TimberLog.LogScaled to repository LogTrackingContext.LogTrackingRepository
      }
      on event TimberLog.LogLoaded is {
        tell event TimberLog.LogLoaded to repository LogTrackingContext.LogTrackingRepository
      }
      on event TimberLog.LogInTransit is {
        tell event TimberLog.LogInTransit to repository LogTrackingContext.LogTrackingRepository
      }
      on event TimberLog.LogDelivered is {
        tell event TimberLog.LogDelivered to repository LogTrackingContext.LogTrackingRepository
      }
      on event TimberLog.LogRejected is {
        tell event TimberLog.LogRejected to repository LogTrackingContext.LogTrackingRepository
      }
      on event TimberLog.LogQuarantined is {
        tell event TimberLog.LogQuarantined to repository LogTrackingContext.LogTrackingRepository
      }
      on event TimberLog.ComplianceDocumentAttached is {
        tell event TimberLog.ComplianceDocumentAttached to repository LogTrackingContext.LogTrackingRepository
      }
      on other is {
        error "Unexpected message for sink TimberLogEventSink"
      }
    } with {
      briefly "TimberLog sink handler"
      described as {
        |Persists TimberLog events via the repository.
      }
    }
  } with {
    briefly "TimberLog event sink"
    described as {
      |Receives TimberLog events for persistence.
    }
  }
  connector TimberLogEventFlow is {
    from outlet LogTrackingContext.TimberLogEventSource.TimberLogEvents to
      inlet LogTrackingContext.TimberLogEventSink.TimberLogInlet
  } with {
    briefly "TimberLog event flow"
    described as {
      |Connects the TimberLog source to its sink.
    }
  }
  processor TimberLogEventSplit is {
    inlet TimberLogEventSplitIn is type TimberLogEvent
    outlet TimberLogEventSplitToLogTrackingRepository is type TimberLogEvent
    outlet TimberLogEventSplitToLogTrackingMetrics is type TimberLogEvent
    handler TimberLogEventSplitHandler is {
      on event TimberLog.LogRegistered is {
        send event TimberLog.LogRegistered to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.LogRegistered to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.LogRegistered to entity LogTrackingContext.TimberLog
      }
      on event TimberLog.LogScaled is {
        send event TimberLog.LogScaled to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.LogScaled to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.LogScaled to entity LogTrackingContext.TimberLog
      }
      on event TimberLog.LogLoaded is {
        send event TimberLog.LogLoaded to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.LogLoaded to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.LogLoaded to entity LogTrackingContext.TimberLog
      }
      on event TimberLog.LogInTransit is {
        send event TimberLog.LogInTransit to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.LogInTransit to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.LogInTransit to entity LogTrackingContext.TimberLog
      }
      on event TimberLog.LogDelivered is {
        send event TimberLog.LogDelivered to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.LogDelivered to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.LogDelivered to entity LogTrackingContext.TimberLog
      }
      on event TimberLog.LogRejected is {
        send event TimberLog.LogRejected to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.LogRejected to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.LogRejected to entity LogTrackingContext.TimberLog
      }
      on event TimberLog.LogQuarantined is {
        send event TimberLog.LogQuarantined to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.LogQuarantined to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.LogQuarantined to entity LogTrackingContext.TimberLog
      }
      on event TimberLog.ComplianceDocumentAttached is {
        send event TimberLog.ComplianceDocumentAttached to outlet TimberLogEventSplitToLogTrackingRepository
        send event TimberLog.ComplianceDocumentAttached to outlet TimberLogEventSplitToLogTrackingMetrics
        tell event TimberLog.ComplianceDocumentAttached to entity LogTrackingContext.TimberLog
      }
      on other is {
        error "Unexpected message for processor TimberLogEventSplit"
      }
    } with {
      briefly "TimberLog event fan-out handler"
      described as {
        |Delivers each TimberLog event to all of its consumers.
      }
    }
  } with {
    briefly "TimberLog event fan-out"
    described as {
      |Fans TimberLog events out to the repository and projectors.
    }
  }
  connector LinkTimberLogToTimberLogEventSplit is {
    from outlet LogTrackingContext.TimberLog.TimberLogEvents2 to
      inlet LogTrackingContext.TimberLogEventSplit.TimberLogEventSplitIn
  } with {
    briefly "LinkTimberLogToTimberLogEventSplit"
  }
  connector LinkTimberLogEventSplitToLogTrackingRepository is {
    from outlet LogTrackingContext.TimberLogEventSplit.TimberLogEventSplitToLogTrackingRepository to
      inlet LogTrackingContext.LogTrackingRepository.LogTrackingRepositoryFromTimberLog
  } with {
    briefly "LinkTimberLogEventSplitToLogTrackingRepository"
  }
  connector LinkTimberLogEventSplitToLogTrackingMetrics is {
    from outlet LogTrackingContext.TimberLogEventSplit.TimberLogEventSplitToLogTrackingMetrics to
      inlet LogTrackingContext.LogTrackingMetrics.LogTrackingMetricsFromTimberLog
  } with {
    briefly "LinkTimberLogEventSplitToLogTrackingMetrics"
  }
  connector LinkLogTrackingMetricsToLogTrackingRepository is {
    from outlet LogTrackingContext.LogTrackingMetrics.LogTrackingMetricsOut to
      inlet LogTrackingContext.LogTrackingRepository.LogTrackingRepositoryFromLogTrackingMetrics
  } with {
    briefly "LinkLogTrackingMetricsToLogTrackingRepository"
  }
} with {
  briefly "Bounded context for log tracking"
  described as {
    |Forestry log tracking from felling through transport to sawmill.
  }
}
