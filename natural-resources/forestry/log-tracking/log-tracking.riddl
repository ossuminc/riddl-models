// Log Tracking Domain Model
// Forestry log tracking from felling through transport to sawmill
domain LogTracking is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ForestryOperator is "person managing timber harvesting operations" with {
    briefly "Forestry Operator"
    described as {
      |Operator overseeing log felling and processing.
    }
  }
  user LogScaler is "person measuring and grading logs" with {
    briefly "Log Scaler"
    described as {
      |Scaler performing volume measurement and grading.
    }
  }
  user TransportDriver is "person transporting logs to sawmill" with {
    briefly "Transport Driver"
    described as {
      |Driver hauling logs from harvest site to mill.
    }
  }
  user ComplianceOfficer is "person ensuring regulatory compliance" with {
    briefly "Compliance Officer"
    described as {
      |Officer verifying chain of custody and documentation.
    }
  }
  epic LogLifecycle is {
    user ForestryOperator wants to "to track logs from felling to sawmill" so that "chain of custody is maintained and compliance is ensured"
    case TrackNewLog is {
      user ForestryOperator wants to "to register a newly felled log" so that "the log enters the tracking system"
      step is "Operator records" "log felling details" "at harvest site" with {
        briefly "Record felling"
        described as {
          |Register felled log.
        }
      }
      step is "Scaler grades" "log quality and volume" "for the log" with {
        briefly "Grade log"
        described as {
          |Measure and grade log.
        }
      }
    } with {
      briefly "Track new log"
      described as {
        |Registering and grading a newly felled log.
      }
    }
  } with {
    briefly "Log lifecycle tracking"
    described as {
      |Epic for tracking logs from felling to sawmill delivery.
    }
  }
  include "LogTrackingContext.riddl"
  include "external-contexts.riddl"
  application context LogTrackingApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in LogTracking are delivered.
      }
    }
    outlet AppTimberLogCommands is type LogTrackingContext.TimberLog.TimberLogCommand
    inlet AppLogTrackingRepositoryResponses is result LogTrackingContext.TimberLog.TimberLogResult    handler LogTrackingAppHandler is {
      on other is {
        error "Unexpected message for application context LogTrackingApp"
      }
    } with {
      briefly "LogTrackingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "LogTrackingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'TimberLogCommand Stream' is from outlet LogTrackingApp.AppTimberLogCommands to inlet LogTrackingContext.TimberLogCommandStreamIn with {
    briefly "TimberLog commands from the application"
  }
  persistent connector 'TimberLogResult Stream' is from outlet LogTrackingContext.TimberLogResultStreamOut to inlet LogTrackingApp.AppLogTrackingRepositoryResponses with {
    briefly "LogTracking query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet LogTrackingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Log tracking domain"
  described as {
    |Forestry log tracking from felling through transport to sawmill.
  }
}
