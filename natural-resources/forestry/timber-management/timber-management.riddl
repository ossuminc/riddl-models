// Timber Management Domain Model
// Forest timber operations and harvest management
domain TimberManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Forester is "person managing forest resources" with {
    briefly "Forester"
    described as {
      |Professional managing timber stands.
    }
  }
  user HarvestManager is "person coordinating harvest operations" with {
    briefly "Harvest Manager"
    described as {
      |Manager overseeing timber harvest.
    }
  }
  user LoggingCrew is "team performing logging operations" with {
    briefly "Logging Crew"
    described as {
      |Crew executing harvest activities.
    }
  }
  epic TimberHarvestManagement is {
    user Forester wants to "to manage timber resources sustainably" so that "forest value is maximized over time"
    case PlanTimberSale is {
      user Forester wants to "to plan a timber sale" so that "harvest operations are coordinated"
      step is "Forester assesses" "stand inventory" "for sale planning" with {
        briefly "Assess inventory"
        described as {
          |Evaluate timber.
        }
      }
      step is "System generates" "harvest plan" "with boundaries" with {
        briefly "Generate plan"
        described as {
          |Create harvest plan.
        }
      }
    } with {
      briefly "Plan timber sale"
      described as {
        |Planning timber harvest operations.
      }
    }
  } with {
    briefly "Timber harvest management"
    described as {
      |Epic for forest operations.
    }
  }
  include "TimberContext.riddl"
  include "external-contexts.riddl"
  application context TimberManagementApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in TimberManagement are delivered.
      }
    }
    outlet AppStandCommands is type TimberContext.Stand.StandCommand
    inlet AppTimberRepositoryResponses is type TimberContext.Stand.StandResult    handler TimberManagementAppHandler is {
      on other is {
        error "Unexpected message for application context TimberManagementApp"
      }
    } with {
      briefly "TimberManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "TimberManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'StandCommand Stream' is from outlet TimberManagementApp.AppStandCommands to inlet TimberContext.Stand.StandCommands with {
    option persistent()
    briefly "Stand commands from the application"
  }
  connector 'StandResult Stream' is from outlet TimberContext.TimberRepository.TimberRepositoryResponses to inlet TimberManagementApp.AppTimberRepositoryResponses with {
    option persistent()
    briefly "Timber query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet TimberManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Timber management domain"
  described as {
    |Forest timber operations management.
  }
}
