// Timber Management - Timber Context
context TimberContext is {
  include "types.riddl"
  include "Stand.riddl"
  repository TimberRepository is {
    schema TimberData is relational
      of stands as type Stand
        index on field Stand.standId
        index on field Stand.status
        index on field Stand.standInfo.speciesType

    handler TimberPersistence is {
      on command Stand.RegisterStand is {
        prompt "Store new stand record"
      }
      on command Stand.RecordCruise is {
        tell event Stand.CruiseRecorded to entity TimberContext.Stand
        prompt "Update stand with cruise data"
      }
      on command Stand.RecordTimberSale is {
        tell event Stand.TimberSaleRecorded to entity TimberContext.Stand
        prompt "Store timber sale record"
      }
      on command Stand.BeginHarvest is {
        prompt "Update stand to harvesting status"
      }
      on command Stand.RecordLoad is {
        tell event Stand.LoadRecorded to entity TimberContext.Stand
        prompt "Store harvest load record"
      }
      on command Stand.CompleteHarvest is {
        tell event Stand.HarvestCompleted to entity TimberContext.Stand
        prompt "Update stand with harvest totals"
      }
      on command Stand.RecordPlanting is {
        tell event Stand.PlantingRecorded to entity TimberContext.Stand
        prompt "Update stand to regenerating status"
      }
    } with {
      briefly "Persists timber commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Timber data persistence"
    described as {
      |Persistent storage for timber stands.
    }
  }
  projector HarvestAnalytics is {
    updates repository TimberContext.TimberRepository
    record HarvestSummary is  {
      year: Natural with {
        briefly "Year"
        described as {
          |Harvest year.
        }
      }
      totalVolumeMBF: Decimal(15,2) with {
        briefly "Volume MBF"
        described as {
          |Total board feet.
        }
      }
      totalRevenue: Decimal(15,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      acresHarvested: Decimal(10,2) with {
        briefly "Acres"
        described as {
          |Acres harvested.
        }
      }
      standCount: Natural with {
        briefly "Stands"
        described as {
          |Number of stands.
        }
      }
    } with {
      briefly "Harvest summary"
      described as {
        |Annual harvest summary.
      }
    }
    handler AnalyticsHandler is {
      on event Stand.LoadRecorded is {
        tell event Stand.LoadRecorded to repository TimberContext.TimberRepository
        prompt "Aggregate volume by year and product"
      }
      on event Stand.HarvestCompleted is {
        tell event Stand.HarvestCompleted to repository TimberContext.TimberRepository
        prompt "Update harvest totals and calculate revenue"
      }
    } with {
      briefly "Maintains harvest analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Harvest analytics"
    described as {
      |Timber harvest analysis.
    }
  }
  // ---- Event publication for Stand ----
  type StandEvent is one of {
    TimberContext.Stand.StandRegistered,
    TimberContext.Stand.CruiseRecorded,
    TimberContext.Stand.HarvestPlanned,
    TimberContext.Stand.TimberSaleRecorded,
    TimberContext.Stand.HarvestStarted,
    TimberContext.Stand.LoadRecorded,
    TimberContext.Stand.HarvestCompleted,
    TimberContext.Stand.RegenerationPlanned,
    TimberContext.Stand.PlantingRecorded,
    TimberContext.Stand.GrowthUpdated
  } with {
    briefly "Stand event alternation"
    described as {
      |Union of all Stand events, for streaming and event-sourced
      |persistence.
    }
  }
  processor StandEventSource as source is {
    outlet StandEvents is type StandEvent
    handler StandSourceHandler is {
      on event Stand.StandRegistered is {
        send event Stand.StandRegistered to outlet StandEvents
      }
      on event Stand.CruiseRecorded is {
        send event Stand.CruiseRecorded to outlet StandEvents
      }
      on event Stand.HarvestPlanned is {
        send event Stand.HarvestPlanned to outlet StandEvents
      }
      on event Stand.TimberSaleRecorded is {
        send event Stand.TimberSaleRecorded to outlet StandEvents
      }
      on event Stand.HarvestStarted is {
        send event Stand.HarvestStarted to outlet StandEvents
      }
      on event Stand.LoadRecorded is {
        send event Stand.LoadRecorded to outlet StandEvents
      }
      on event Stand.HarvestCompleted is {
        send event Stand.HarvestCompleted to outlet StandEvents
      }
      on event Stand.RegenerationPlanned is {
        send event Stand.RegenerationPlanned to outlet StandEvents
      }
      on event Stand.PlantingRecorded is {
        send event Stand.PlantingRecorded to outlet StandEvents
      }
      on event Stand.GrowthUpdated is {
        send event Stand.GrowthUpdated to outlet StandEvents
      }
      on other is {
        error "Unexpected message for source StandEventSource"
      }
    } with {
      briefly "Stand source handler"
      described as {
        |Publishes Stand events onto the outlet.
      }
    }
  } with {
    briefly "Stand event source"
    described as {
      |Publishes Stand entity events into the streaming topology.
    }
  }
  processor StandEventSink as sink is {
    inlet StandInlet is type StandEvent
    handler StandSinkHandler is {
      on event Stand.StandRegistered is {
        tell event Stand.StandRegistered to repository TimberContext.TimberRepository
      }
      on event Stand.CruiseRecorded is {
        tell event Stand.CruiseRecorded to repository TimberContext.TimberRepository
      }
      on event Stand.HarvestPlanned is {
        tell event Stand.HarvestPlanned to repository TimberContext.TimberRepository
      }
      on event Stand.TimberSaleRecorded is {
        tell event Stand.TimberSaleRecorded to repository TimberContext.TimberRepository
      }
      on event Stand.HarvestStarted is {
        tell event Stand.HarvestStarted to repository TimberContext.TimberRepository
      }
      on event Stand.LoadRecorded is {
        tell event Stand.LoadRecorded to repository TimberContext.TimberRepository
      }
      on event Stand.HarvestCompleted is {
        tell event Stand.HarvestCompleted to repository TimberContext.TimberRepository
      }
      on event Stand.RegenerationPlanned is {
        tell event Stand.RegenerationPlanned to repository TimberContext.TimberRepository
      }
      on event Stand.PlantingRecorded is {
        tell event Stand.PlantingRecorded to repository TimberContext.TimberRepository
      }
      on event Stand.GrowthUpdated is {
        tell event Stand.GrowthUpdated to repository TimberContext.TimberRepository
      }
      on other is {
        error "Unexpected message for sink StandEventSink"
      }
    } with {
      briefly "Stand sink handler"
      described as {
        |Persists Stand events via the repository.
      }
    }
  } with {
    briefly "Stand event sink"
    described as {
      |Receives Stand events for persistence.
    }
  }
  connector StandEventFlow is {
    from outlet TimberContext.StandEventSource.StandEvents to
      inlet TimberContext.StandEventSink.StandInlet
  } with {
    briefly "Stand event flow"
    described as {
      |Connects the Stand source to its sink.
    }
  }
} with {
  briefly "Bounded context for timber management"
  described as {
    |Forest timber operations context.
  }
}
