// Timber Management - Timber Context
context TimberContext as router is {
  inlet StandCommandStreamIn is type StandCommand  outlet StandCommandStreamOut is type StandCommand
  inlet StandResultStreamIn is result Stand.StandResult  outlet StandResultStreamOut is result Stand.StandResult
  handler TimberContextBoundary is {
    on registerStand: command Stand.RegisterStand is {
      send registerStand to outlet TimberContext.StandCommandStreamOut
    }
    on recordCruise: command Stand.RecordCruise is {
      send recordCruise to outlet TimberContext.StandCommandStreamOut
    }
    on planHarvest: command Stand.PlanHarvest is {
      send planHarvest to outlet TimberContext.StandCommandStreamOut
    }
    on recordTimberSale: command Stand.RecordTimberSale is {
      send recordTimberSale to outlet TimberContext.StandCommandStreamOut
    }
    on beginHarvest: command Stand.BeginHarvest is {
      send beginHarvest to outlet TimberContext.StandCommandStreamOut
    }
    on recordLoad: command Stand.RecordLoad is {
      send recordLoad to outlet TimberContext.StandCommandStreamOut
    }
    on completeHarvest: command Stand.CompleteHarvest is {
      send completeHarvest to outlet TimberContext.StandCommandStreamOut
    }
    on planRegeneration: command Stand.PlanRegeneration is {
      send planRegeneration to outlet TimberContext.StandCommandStreamOut
    }
    on recordPlanting: command Stand.RecordPlanting is {
      send recordPlanting to outlet TimberContext.StandCommandStreamOut
    }
    on updateGrowth: command Stand.UpdateGrowth is {
      send updateGrowth to outlet TimberContext.StandCommandStreamOut
    }
    on standResult: result Stand.StandResult is {
      send standResult to outlet TimberContext.StandResultStreamOut
    }
    on other is {
      error "Unexpected message at the TimberContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'StandCommand Stream Intake' is from outlet TimberContext.StandCommandStreamOut to inlet TimberContext.Stand.StandCommands  connector 'StandResult Stream Egress' is from outlet TimberContext.TimberRepository.TimberRepositoryResponses to inlet TimberContext.StandResultStreamIn  adaptor FromForestryRegulator from context ForestryRegulator is { 
    handler FromForestryRegulatorHandler is {
      on event ForestryRegulator.HarvestApproved is {
        do "the model receives harvest approved"
      }
      on other is {
        error "Unexpected message for adaptor FromForestryRegulator"
      }
    } with {
      briefly "from forestry regulator"
      described as {
        |Carries messages from the external ForestryRegulator.
      }
    }
  } with {
    briefly "ForestryRegulator integration"
    described as {
      |The model's side of the ForestryRegulator conversation.
    }
  }
  adaptor ToForestryRegulator to context ForestryRegulator is { 
    handler ToForestryRegulatorHandler is {
      on command ForestryRegulator.SubmitHarvestNotification is {
        do "the model sends submit harvest notification"
      }
      on command ForestryRegulator.SubmitReforestationReport is {
        do "the model sends submit reforestation report"
      }
      on other is {
        error "Unexpected message for adaptor ToForestryRegulator"
      }
    } with {
      briefly "to forestry regulator"
      described as {
        |Carries messages to the external ForestryRegulator.
      }
    }
  } with {
    briefly "ForestryRegulator integration"
    described as {
      |The model's side of the ForestryRegulator conversation.
    }
  }
  adaptor FromLoggingContractor from context LoggingContractor is { 
    handler FromLoggingContractorHandler is {
      on result LoggingContractor.CrewAvailability is {
        do "the model receives crew availability"
      }
      on other is {
        error "Unexpected message for adaptor FromLoggingContractor"
      }
    } with {
      briefly "from logging contractor"
      described as {
        |Carries messages from the external LoggingContractor.
      }
    }
  } with {
    briefly "LoggingContractor integration"
    described as {
      |The model's side of the LoggingContractor conversation.
    }
  }
  adaptor ToLoggingContractor to context LoggingContractor is { 
    handler ToLoggingContractorHandler is {
      on command LoggingContractor.AssignCrew is {
        do "the model sends assign crew"
      }
      on query LoggingContractor.GetCrewAvailability is {
        do "the model sends get crew availability"
      }
      on other is {
        error "Unexpected message for adaptor ToLoggingContractor"
      }
    } with {
      briefly "to logging contractor"
      described as {
        |Carries messages to the external LoggingContractor.
      }
    }
  } with {
    briefly "LoggingContractor integration"
    described as {
      |The model's side of the LoggingContractor conversation.
    }
  }
  adaptor FromNurserySupplier from context NurserySupplier is { 
    handler FromNurserySupplierHandler is {
      on result NurserySupplier.SeedlingAvailability is {
        do "the model receives seedling availability"
      }
      on other is {
        error "Unexpected message for adaptor FromNurserySupplier"
      }
    } with {
      briefly "from nursery supplier"
      described as {
        |Carries messages from the external NurserySupplier.
      }
    }
  } with {
    briefly "NurserySupplier integration"
    described as {
      |The model's side of the NurserySupplier conversation.
    }
  }
  adaptor ToNurserySupplier to context NurserySupplier is { 
    handler ToNurserySupplierHandler is {
      on query NurserySupplier.GetSeedlingAvailability is {
        do "the model sends get seedling availability"
      }
      on command NurserySupplier.OrderSeedlings is {
        do "the model sends order seedlings"
      }
      on other is {
        error "Unexpected message for adaptor ToNurserySupplier"
      }
    } with {
      briefly "to nursery supplier"
      described as {
        |Carries messages to the external NurserySupplier.
      }
    }
  } with {
    briefly "NurserySupplier integration"
    described as {
      |The model's side of the NurserySupplier conversation.
    }
  }
  adaptor FromTimberBuyer from context TimberBuyer is { 
    handler FromTimberBuyerHandler is {
      on result TimberBuyer.TimberPrices is {
        do "the model receives timber prices"
      }
      on other is {
        error "Unexpected message for adaptor FromTimberBuyer"
      }
    } with {
      briefly "from timber buyer"
      described as {
        |Carries messages from the external TimberBuyer.
      }
    }
  } with {
    briefly "TimberBuyer integration"
    described as {
      |The model's side of the TimberBuyer conversation.
    }
  }
  adaptor ToTimberBuyer to context TimberBuyer is { 
    handler ToTimberBuyerHandler is {
      on query TimberBuyer.GetCurrentPrices is {
        do "the model sends get current prices"
      }
      on command TimberBuyer.SubmitBid is {
        do "the model sends submit bid"
      }
      on other is {
        error "Unexpected message for adaptor ToTimberBuyer"
      }
    } with {
      briefly "to timber buyer"
      described as {
        |Carries messages to the external TimberBuyer.
      }
    }
  } with {
    briefly "TimberBuyer integration"
    described as {
      |The model's side of the TimberBuyer conversation.
    }
  }
  include "types.riddl"
  include "Stand.riddl"
  type TimberRepositoryCommand is one of {
    TimberContext.TimberRepository.PersistCruiseRecorded or TimberContext.TimberRepository.PersistGrowthUpdated or TimberContext.TimberRepository.PersistHarvestCompleted or TimberContext.TimberRepository.PersistHarvestPlanned or TimberContext.TimberRepository.PersistHarvestStarted or TimberContext.TimberRepository.PersistLoadRecorded or TimberContext.TimberRepository.PersistPlantingRecorded or TimberContext.TimberRepository.PersistRegenerationPlanned or TimberContext.TimberRepository.PersistStandRegistered or TimberContext.TimberRepository.PersistTimberSaleRecorded
  } with {
    briefly "Anything that writes TimberRepository"
    described as {
      |The persistence commands TimberRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository TimberRepository as flow is {
    inlet TimberRepositoryFromHarvestAnalytics is type TimberRepositoryCommand
    command PersistCruiseRecorded is  {
      standId: StandId with {
        briefly "Row addressed"
        described as {
          |Which stored row CruiseRecorded applies to.
        }
      }
    } with {
      briefly "Persist CruiseRecorded"
      described as {
        |Instructs this repository to apply CruiseRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistGrowthUpdated is  {
      standId: StandId with {
        briefly "Row addressed"
        described as {
          |Which stored row GrowthUpdated applies to.
        }
      }
    } with {
      briefly "Persist GrowthUpdated"
      described as {
        |Instructs this repository to apply GrowthUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHarvestPlanned is  {
      standId: StandId with {
        briefly "Row addressed"
        described as {
          |Which stored row HarvestPlanned applies to.
        }
      }
    } with {
      briefly "Persist HarvestPlanned"
      described as {
        |Instructs this repository to apply HarvestPlanned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHarvestStarted is  {
      standId: StandId with {
        briefly "Row addressed"
        described as {
          |Which stored row HarvestStarted applies to.
        }
      }
    } with {
      briefly "Persist HarvestStarted"
      described as {
        |Instructs this repository to apply HarvestStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlantingRecorded is  {
      standId: StandId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlantingRecorded applies to.
        }
      }
    } with {
      briefly "Persist PlantingRecorded"
      described as {
        |Instructs this repository to apply PlantingRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRegenerationPlanned is  {
      standId: StandId with {
        briefly "Row addressed"
        described as {
          |Which stored row RegenerationPlanned applies to.
        }
      }
    } with {
      briefly "Persist RegenerationPlanned"
      described as {
        |Instructs this repository to apply RegenerationPlanned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStandRegistered is  {
      standId: StandId with {
        briefly "Row addressed"
        described as {
          |Which stored row StandRegistered applies to.
        }
      }
    } with {
      briefly "Persist StandRegistered"
      described as {
        |Instructs this repository to apply StandRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTimberSaleRecorded is  {
      standId: StandId with {
        briefly "Row addressed"
        described as {
          |Which stored row TimberSaleRecorded applies to.
        }
      }
    } with {
      briefly "Persist TimberSaleRecorded"
      described as {
        |Instructs this repository to apply TimberSaleRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHarvestCompleted is  {
      standId: StandId with {
        briefly "Row addressed"
        described as {
          |Which stored row HarvestCompleted applies to.
        }
      }
    } with {
      briefly "Persist HarvestCompleted"
      described as {
        |Instructs this repository to apply HarvestCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLoadRecorded is  {
      standId: StandId with {
        briefly "Row addressed"
        described as {
          |Which stored row LoadRecorded applies to.
        }
      }
    } with {
      briefly "Persist LoadRecorded"
      described as {
        |Instructs this repository to apply LoadRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet TimberRepositoryResponses is result Stand.StandResult
    record StoredStand is  {
      standId: StandId with {
        briefly "standId"
        described as {
          |The standId column of the stored stand row.
        }
      }
      standInfo: StandInfo with {
        briefly "standInfo"
        described as {
          |The standInfo column of the stored stand row.
        }
      }
      status: StandStatus with {
        briefly "status"
        described as {
          |The status column of the stored stand row.
        }
      }
    } with {
      briefly "Stored stand row"
      described as {
        |The persistence shape of stand data as this repository stores it.
      }
    }
    schema TimberData is relational
      of stands as record StoredStand
        index on field StoredStand.standId
        index on field StoredStand.status
        index on field StoredStand.standInfo.speciesType
 with {
      briefly "Timber data schema"
      described as {
        |The relational schema holding timber data for the TimberRepository.
      }
    }
    handler TimberPersistence is {
      on persistCruiseRecorded: command PersistCruiseRecorded is {
        do "apply CruiseRecorded to the stored row"
      }
      on persistGrowthUpdated: command PersistGrowthUpdated is {
        do "apply GrowthUpdated to the stored row"
      }
      on persistHarvestPlanned: command PersistHarvestPlanned is {
        do "apply HarvestPlanned to the stored row"
      }
      on persistHarvestStarted: command PersistHarvestStarted is {
        do "apply HarvestStarted to the stored row"
      }
      on persistPlantingRecorded: command PersistPlantingRecorded is {
        do "apply PlantingRecorded to the stored row"
      }
      on persistRegenerationPlanned: command PersistRegenerationPlanned is {
        do "apply RegenerationPlanned to the stored row"
      }
      on persistStandRegistered: command PersistStandRegistered is {
        do "apply StandRegistered to the stored row"
      }
      on persistTimberSaleRecorded: command PersistTimberSaleRecorded is {
        do "apply TimberSaleRecorded to the stored row"
      }
      on persistHarvestCompleted: command PersistHarvestCompleted is {
        do "apply HarvestCompleted to the stored row"
      }
      on persistLoadRecorded: command PersistLoadRecorded is {
        do "apply LoadRecorded to the stored row"
      }
      on query GetHarvestSummary is {
        let harvestSummaryView: type HarvestSummaryView = prompt("read the harvest summary projection")
        reply harvestSummaryView
      }
    } with {
      briefly "Persists timber commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Timber data persistence"
    described as {
      |Persistent storage for timber stands.
    }
  }
  query GetHarvestSummary replies result HarvestSummaryView is  {
    harvestSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which harvest summary to retrieve.
      }
    }
  } with {
    briefly "Get harvest summary"
    described as {
      |Retrieves the harvest summary projection.
    }
  }
  result HarvestSummaryView is  {
    harvestSummary: HarvestAnalytics.HarvestSummary with {
      briefly "Harvest summary"
      described as {
        |The harvest summary being returned.
      }
    }
  } with {
    briefly "Harvest summary view"
    described as {
      |Read model view carrying the harvest summary projection.
    }
  }
  projector HarvestAnalytics as flow is {
    outlet HarvestAnalyticsToRepository is type TimberRepositoryCommand
    updates repository TimberContext.TimberRepository
    inlet HarvestAnalyticsFromStand is type StandEvent
    record HarvestSummary is  {
      year: Natural with {
        briefly "Year"
        described as {
          |Harvest year.
        }
      }
      totalVolumeMBF: Decimal(15,2) with {
        briefly "Volume MBF"
        described as {
          |Total board feet.
        }
      }
      totalRevenue: Decimal(15,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      acresHarvested: Decimal(10,2) with {
        briefly "Acres"
        described as {
          |Acres harvested.
        }
      }
      standCount: Natural with {
        briefly "Stands"
        described as {
          |Number of stands.
        }
      }
    } with {
      briefly "Harvest summary"
      described as {
        |Annual harvest summary.
      }
    }
    handler AnalyticsHandler is {
      on cruiseRecorded: event Stand.CruiseRecorded is {
        tell command TimberContext.TimberRepository.PersistCruiseRecorded(standId = cruiseRecorded.standId) to repository TimberContext.TimberRepository
        do "apply CruiseRecorded to the HarvestAnalytics projection"
      }
      on growthUpdated: event Stand.GrowthUpdated is {
        tell command TimberContext.TimberRepository.PersistGrowthUpdated(standId = growthUpdated.standId) to repository TimberContext.TimberRepository
        do "apply GrowthUpdated to the HarvestAnalytics projection"
      }
      on harvestPlanned: event Stand.HarvestPlanned is {
        tell command TimberContext.TimberRepository.PersistHarvestPlanned(standId = harvestPlanned.standId) to repository TimberContext.TimberRepository
        do "apply HarvestPlanned to the HarvestAnalytics projection"
      }
      on harvestStarted: event Stand.HarvestStarted is {
        tell command TimberContext.TimberRepository.PersistHarvestStarted(standId = harvestStarted.standId) to repository TimberContext.TimberRepository
        do "apply HarvestStarted to the HarvestAnalytics projection"
      }
      on plantingRecorded: event Stand.PlantingRecorded is {
        tell command TimberContext.TimberRepository.PersistPlantingRecorded(standId = plantingRecorded.standId) to repository TimberContext.TimberRepository
        do "apply PlantingRecorded to the HarvestAnalytics projection"
      }
      on regenerationPlanned: event Stand.RegenerationPlanned is {
        tell command TimberContext.TimberRepository.PersistRegenerationPlanned(standId = regenerationPlanned.standId) to repository TimberContext.TimberRepository
        do "apply RegenerationPlanned to the HarvestAnalytics projection"
      }
      on standRegistered: event Stand.StandRegistered is {
        tell command TimberContext.TimberRepository.PersistStandRegistered(standId = standRegistered.standId) to repository TimberContext.TimberRepository
        do "apply StandRegistered to the HarvestAnalytics projection"
      }
      on timberSaleRecorded: event Stand.TimberSaleRecorded is {
        tell command TimberContext.TimberRepository.PersistTimberSaleRecorded(standId = timberSaleRecorded.standId) to repository TimberContext.TimberRepository
        do "apply TimberSaleRecorded to the HarvestAnalytics projection"
      }
      on loadRecorded: event Stand.LoadRecorded is {
        tell command TimberContext.TimberRepository.PersistLoadRecorded(standId = loadRecorded.standId) to repository TimberContext.TimberRepository
        do "Aggregate volume by year and product"
      }
      on harvestCompleted: event Stand.HarvestCompleted is {
        tell command TimberContext.TimberRepository.PersistHarvestCompleted(standId = harvestCompleted.standId) to repository TimberContext.TimberRepository
        do "Update harvest totals and calculate revenue"
      }
    } with {
      briefly "Maintains harvest analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Harvest analytics"
    described as {
      |Timber harvest analysis.
    }
  }
  // ---- Event publication for Stand ----
  type StandEvent is one of {
    TimberContext.Stand.StandRegistered or TimberContext.Stand.CruiseRecorded or TimberContext.Stand.HarvestPlanned or TimberContext.Stand.TimberSaleRecorded or TimberContext.Stand.HarvestStarted or TimberContext.Stand.LoadRecorded or TimberContext.Stand.HarvestCompleted or TimberContext.Stand.RegenerationPlanned or TimberContext.Stand.PlantingRecorded or TimberContext.Stand.GrowthUpdated
  } with {
    briefly "Stand event alternation"
    described as {
      |Union of all Stand events, for streaming and event-sourced
      |persistence.
    }
  }
  processor StandEventSplit as flow is {
    inlet StandEventSplitIn is type StandEvent
    outlet StandEventSplitToHarvestAnalytics is type StandEvent
    handler StandEventSplitHandler is {
      on standRegistered: event Stand.StandRegistered is {
        send standRegistered to outlet StandEventSplitToHarvestAnalytics
        tell standRegistered to entity TimberContext.Stand
      }
      on cruiseRecorded: event Stand.CruiseRecorded is {
        send cruiseRecorded to outlet StandEventSplitToHarvestAnalytics
        tell cruiseRecorded to entity TimberContext.Stand
      }
      on harvestPlanned: event Stand.HarvestPlanned is {
        send harvestPlanned to outlet StandEventSplitToHarvestAnalytics
        tell harvestPlanned to entity TimberContext.Stand
      }
      on timberSaleRecorded: event Stand.TimberSaleRecorded is {
        send timberSaleRecorded to outlet StandEventSplitToHarvestAnalytics
        tell timberSaleRecorded to entity TimberContext.Stand
      }
      on harvestStarted: event Stand.HarvestStarted is {
        send harvestStarted to outlet StandEventSplitToHarvestAnalytics
        tell harvestStarted to entity TimberContext.Stand
      }
      on loadRecorded: event Stand.LoadRecorded is {
        send loadRecorded to outlet StandEventSplitToHarvestAnalytics
        tell loadRecorded to entity TimberContext.Stand
      }
      on harvestCompleted: event Stand.HarvestCompleted is {
        send harvestCompleted to outlet StandEventSplitToHarvestAnalytics
        tell harvestCompleted to entity TimberContext.Stand
      }
      on regenerationPlanned: event Stand.RegenerationPlanned is {
        send regenerationPlanned to outlet StandEventSplitToHarvestAnalytics
        tell regenerationPlanned to entity TimberContext.Stand
      }
      on plantingRecorded: event Stand.PlantingRecorded is {
        send plantingRecorded to outlet StandEventSplitToHarvestAnalytics
        tell plantingRecorded to entity TimberContext.Stand
      }
      on growthUpdated: event Stand.GrowthUpdated is {
        send growthUpdated to outlet StandEventSplitToHarvestAnalytics
        tell growthUpdated to entity TimberContext.Stand
      }
      on other is {
        error "Unexpected message for processor StandEventSplit"
      }
    } with {
      briefly "Stand event fan-out handler"
      described as {
        |Delivers each Stand event to all of its consumers.
      }
    }
  } with {
    briefly "Stand event fan-out"
    described as {
      |Fans Stand events out to the repository and projectors.
    }
  }
  connector 'StandEvent Stream' is from outlet TimberContext.Stand.StandEvents2 to inlet TimberContext.StandEventSplit.StandEventSplitIn with {
    briefly "Stand events, fanned out to storage and read models"
  }
  connector 'HarvestAnalytics Feed' is from outlet TimberContext.StandEventSplit.StandEventSplitToHarvestAnalytics to inlet TimberContext.HarvestAnalytics.HarvestAnalyticsFromStand with {
    briefly "Stand events feeding the HarvestAnalytics projection"
  }
  connector 'HarvestAnalytics Storage' is from outlet TimberContext.HarvestAnalytics.HarvestAnalyticsToRepository to inlet TimberContext.TimberRepository.TimberRepositoryFromHarvestAnalytics with {
    briefly "HarvestAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for timber management"
  described as {
    |Forest timber operations context.
  }
}
