// Well Management Domain Model
// Oil and gas well lifecycle management
domain WellManagement is {
  persistent connector 'SCADAReply Stream' is from outlet SCADA.SCADARepliesOut to inlet WellContext.ToSCADA.ToSCADAReplies with {
    briefly "What SCADA answers WellContext"
  }
  persistent connector 'LandManagementReply Stream' is from outlet LandManagement.LandManagementRepliesOut to inlet WellContext.ToLandManagement.ToLandManagementReplies with {
    briefly "What LandManagement answers WellContext"
  }
  persistent connector 'ProductionAccountingEvent Stream' is from outlet ProductionAccounting.ProductionAccountingEventsOut to inlet WellContext.FromProductionAccounting.FromProductionAccountingIn with {
    briefly "What ProductionAccounting tells WellContext, unasked"
  }
  persistent connector 'RegulatorySystemEvent Stream' is from outlet RegulatorySystem.RegulatorySystemEventsOut to inlet WellContext.FromRegulatorySystem.FromRegulatorySystemIn with {
    briefly "What RegulatorySystem tells WellContext, unasked"
  }
  persistent connector 'SCADARequest Stream' is from outlet WellContext.ToSCADA.ToSCADAOut to inlet SCADA.SCADARequests with {
    briefly "What WellContext asks SCADA to send"
  }
  persistent connector 'LandManagementRequest Stream' is from outlet WellContext.ToLandManagement.ToLandManagementOut to inlet LandManagement.LandManagementRequests with {
    briefly "What WellContext asks LandManagement to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user DrillingEngineer is "person overseeing drilling operations" with {
    briefly "Drilling Engineer"
    described as {
      |Engineer managing well drilling.
    }
  }
  user ProductionEngineer is "person managing well production" with {
    briefly "Production Engineer"
    described as {
      |Engineer optimizing well output.
    }
  }
  user FieldOperator is "person performing field operations" with {
    briefly "Field Operator"
    described as {
      |Operator working at well site.
    }
  }
  epic WellLifecycleManagement is {
    user DrillingEngineer wants to "to manage well drilling and completion" so that "wells are drilled safely and efficiently"
    case DrillNewWell is {
      user DrillingEngineer wants to "to drill a new well" so that "hydrocarbon reserves can be extracted"
      step is "Engineer plans" "drilling program" "for well" with {
        briefly "Plan drilling"
        described as {
          |Create drilling plan.
        }
      }
      step is "System tracks" "drilling progress" "to completion" with {
        briefly "Track drilling"
        described as {
          |Monitor operations.
        }
      }
    } with {
      briefly "Drill new well"
      described as {
        |Managing new well drilling.
      }
    }
  } with {
    briefly "Well lifecycle management"
    described as {
      |Epic for well operations.
    }
  }
  include "WellContext.riddl"
  include "external-contexts.riddl"
  application context WellManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in WellManagement are delivered.
      }
    }
    outlet AppWellCommands is type WellContext.Well.WellCommand
    inlet AppWellRepositoryResponses is result WellContext.Well.WellResult    handler WellManagementAppHandler is {
      on other is {
        error "Unexpected message for application context WellManagementApp"
      }
    } with {
      briefly "WellManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "WellManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ProductionAccountingRequest Stream' is from outlet WellContext.ToProductionAccounting.ToProductionAccountingOut to inlet ProductionAccounting.ProductionAccountingRequests with {
    briefly "What WellContext asks ProductionAccounting to send"
  }
  persistent connector 'RegulatorySystemRequest Stream' is from outlet WellContext.ToRegulatorySystem.ToRegulatorySystemOut to inlet RegulatorySystem.RegulatorySystemRequests with {
    briefly "What WellContext asks RegulatorySystem to send"
  }
  persistent connector 'WellCommand Stream' is from outlet WellManagementApp.AppWellCommands to inlet WellContext.WellCommandStreamIn with {
    briefly "Well commands from the application"
  }
  persistent connector 'WellResult Stream' is from outlet WellContext.WellResultStreamOut to inlet WellManagementApp.AppWellRepositoryResponses with {
    briefly "Well query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet WellManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Well management domain"
  described as {
    |Oil and gas well lifecycle management.
  }
}
