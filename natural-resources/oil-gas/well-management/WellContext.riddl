// Well Management - Well Context
context WellContext is {
  adaptor FromLandManagement from context LandManagement is { 
    handler FromLandManagementHandler is {
      on result LandManagement.LeaseInfo is {
        do "the model receives lease info"
      }
      on other is {
        error "Unexpected message for adaptor FromLandManagement"
      }
    } with {
      briefly "from land management"
      described as {
        |Carries messages from the external LandManagement.
      }
    }
  } with {
    briefly "LandManagement integration"
    described as {
      |The model's side of the LandManagement conversation.
    }
  }
  adaptor ToLandManagement to context LandManagement is { 
    handler ToLandManagementHandler is {
      on query LandManagement.GetLeaseInfo is {
        do "the model sends get lease info"
      }
      on other is {
        error "Unexpected message for adaptor ToLandManagement"
      }
    } with {
      briefly "to land management"
      described as {
        |Carries messages to the external LandManagement.
      }
    }
  } with {
    briefly "LandManagement integration"
    described as {
      |The model's side of the LandManagement conversation.
    }
  }
  adaptor FromProductionAccounting from context ProductionAccounting is { 
    handler FromProductionAccountingHandler is {
      on event ProductionAccounting.SalesRecorded is {
        do "the model receives sales recorded"
      }
      on other is {
        error "Unexpected message for adaptor FromProductionAccounting"
      }
    } with {
      briefly "from production accounting"
      described as {
        |Carries messages from the external ProductionAccounting.
      }
    }
  } with {
    briefly "ProductionAccounting integration"
    described as {
      |The model's side of the ProductionAccounting conversation.
    }
  }
  adaptor ToProductionAccounting to context ProductionAccounting is { 
    handler ToProductionAccountingHandler is {
      on command ProductionAccounting.RecordSales is {
        do "the model sends record sales"
      }
      on other is {
        error "Unexpected message for adaptor ToProductionAccounting"
      }
    } with {
      briefly "to production accounting"
      described as {
        |Carries messages to the external ProductionAccounting.
      }
    }
  } with {
    briefly "ProductionAccounting integration"
    described as {
      |The model's side of the ProductionAccounting conversation.
    }
  }
  adaptor FromRegulatorySystem from context RegulatorySystem is { 
    handler FromRegulatorySystemHandler is {
      on event RegulatorySystem.PermitDecisionReceived is {
        do "the model receives permit decision received"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatorySystem"
      }
    } with {
      briefly "from regulatory system"
      described as {
        |Carries messages from the external RegulatorySystem.
      }
    }
  } with {
    briefly "RegulatorySystem integration"
    described as {
      |The model's side of the RegulatorySystem conversation.
    }
  }
  adaptor ToRegulatorySystem to context RegulatorySystem is { 
    handler ToRegulatorySystemHandler is {
      on command RegulatorySystem.SubmitPermitApplication is {
        do "the model sends submit permit application"
      }
      on command RegulatorySystem.SubmitProductionReport is {
        do "the model sends submit production report"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatorySystem"
      }
    } with {
      briefly "to regulatory system"
      described as {
        |Carries messages to the external RegulatorySystem.
      }
    }
  } with {
    briefly "RegulatorySystem integration"
    described as {
      |The model's side of the RegulatorySystem conversation.
    }
  }
  adaptor FromSCADA from context SCADA is { 
    handler FromSCADAHandler is {
      on result SCADA.WellTelemetry is {
        do "the model receives well telemetry"
      }
      on other is {
        error "Unexpected message for adaptor FromSCADA"
      }
    } with {
      briefly "from scada"
      described as {
        |Carries messages from the external SCADA.
      }
    }
  } with {
    briefly "SCADA integration"
    described as {
      |The model's side of the SCADA conversation.
    }
  }
  adaptor ToSCADA to context SCADA is { 
    handler ToSCADAHandler is {
      on query SCADA.GetWellTelemetry is {
        do "the model sends get well telemetry"
      }
      on other is {
        error "Unexpected message for adaptor ToSCADA"
      }
    } with {
      briefly "to scada"
      described as {
        |Carries messages to the external SCADA.
      }
    }
  } with {
    briefly "SCADA integration"
    described as {
      |The model's side of the SCADA conversation.
    }
  }
  include "types.riddl"
  include "Well.riddl"
  repository WellRepository as merge is {
    inlet WellRepositoryFromWell is type WellEvent    inlet WellRepositoryFromProductionAnalytics is type WellEvent    outlet WellRepositoryResponses is type Well.WellResult
    record StoredWell is  {
      wellId: WellId with {
        briefly "wellId"
        described as {
          |The wellId column of the stored well row.
        }
      }
      fieldId: FieldId with {
        briefly "fieldId"
        described as {
          |The fieldId column of the stored well row.
        }
      }
      leaseId: LeaseId with {
        briefly "leaseId"
        described as {
          |The leaseId column of the stored well row.
        }
      }
      status: WellStatus with {
        briefly "status"
        described as {
          |The status column of the stored well row.
        }
      }
    } with {
      briefly "Stored well row"
      described as {
        |The persistence shape of well data as this repository stores it.
      }
    }
    schema WellData is relational
      of wells as type StoredWell
        index on field StoredWell.wellId
        index on field StoredWell.leaseId
        index on field StoredWell.fieldId
        index on field StoredWell.status
 with {
      briefly "Well data schema"
      described as {
        |The relational schema holding well data for the WellRepository.
      }
    }
    handler WellPersistence is {
      on query GetFieldProduction is {
        do "read the field production projection"
        reply result FieldProductionView
      }
      on command Well.PlanWell is {
        do "Store new well record"
      }
      on command Well.ApprovePermit is {
        tell event Well.PermitApproved to entity WellContext.Well
        do "Update well permit information"
      }
      on command Well.SpudWell is {
        do "Update well to drilling status"
      }
      on command Well.CompleteWell is {
        tell event Well.WellCompleted to entity WellContext.Well
        do "Store well completion data"
      }
      on command Well.BringOnline is {
        do "Update well to producing status"
      }
      on command Well.RecordProduction is {
        tell event Well.ProductionRecorded to entity WellContext.Well
        do "Store production record"
      }
      on command Well.AbandonWell is {
        do "Update well to abandoned status"
      }
    } with {
      briefly "Persists well commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Well data persistence"
    described as {
      |Persistent storage for wells.
    }
  }
  query GetFieldProduction is  {
    fieldProductionKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which field production to retrieve.
      }
    }
  } with {
    briefly "Get field production"
    described as {
      |Retrieves the field production projection.
    }
  }
  result FieldProductionView is  {
    fieldProduction: ProductionAnalytics.FieldProduction with {
      briefly "Field production"
      described as {
        |The field production being returned.
      }
    }
  } with {
    briefly "Field production view"
    described as {
      |Read model view carrying the field production projection.
    }
  }
  projector ProductionAnalytics as flow is {
    updates repository WellContext.WellRepository
    inlet ProductionAnalyticsFromWell is type WellEvent    outlet ProductionAnalyticsOut is type WellEvent
    record FieldProduction is  {
      fieldId: FieldId with {
        briefly "Field"
        described as {
          |Field ID.
        }
      }
      totalOilBBL: Decimal(15,2) with {
        briefly "Oil"
        described as {
          |Total oil barrels.
        }
      }
      totalGasMCF: Decimal(15,2) with {
        briefly "Gas"
        described as {
          |Total gas MCF.
        }
      }
      activeWells: Natural with {
        briefly "Active"
        described as {
          |Active well count.
        }
      }
      averageIPRate: Decimal(10,2) with {
        briefly "Avg IP"
        described as {
          |Average initial potential.
        }
      }
    } with {
      briefly "Field production"
      described as {
        |Production by field.
      }
    }
    handler AnalyticsHandler is {
      on event Well.ProductionRecorded is {
        tell event Well.ProductionRecorded to repository WellContext.WellRepository
        do "Aggregate production by field"
      }
      on event Well.WellBroughtOnline is {
        tell event Well.WellBroughtOnline to repository WellContext.WellRepository
        do "Increment active well count and record IP"
      }
      on event Well.WellShutIn is {
        tell event Well.WellShutIn to repository WellContext.WellRepository
        do "Decrement active well count"
      }
      on event Well.WellAbandoned is {
        tell event Well.WellAbandoned to repository WellContext.WellRepository
        do "Update field statistics"
      }
    } with {
      briefly "Maintains production analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Production analytics"
    described as {
      |Well and field production analysis.
    }
  }
  // ---- Event publication for Well ----
  type WellEvent is one of {
    WellContext.Well.WellPlanned or WellContext.Well.PermitSubmitted or WellContext.Well.PermitApproved or WellContext.Well.WellSpudded or WellContext.Well.DrillingProgressUpdated or WellContext.Well.WellCompleted or WellContext.Well.WellBroughtOnline or WellContext.Well.ProductionRecorded or WellContext.Well.WellShutIn or WellContext.Well.WorkoverStarted or WellContext.Well.WorkoverCompleted or WellContext.Well.WellAbandoned
  } with {
    briefly "Well event alternation"
    described as {
      |Union of all Well events, for streaming and event-sourced
      |persistence.
    }
  }
  processor WellEventSource as source is {
    outlet WellEvents is type WellEvent
    handler WellSourceHandler is {
      on event Well.WellPlanned is {
        send event Well.WellPlanned to outlet WellEvents
      }
      on event Well.PermitSubmitted is {
        send event Well.PermitSubmitted to outlet WellEvents
      }
      on event Well.PermitApproved is {
        send event Well.PermitApproved to outlet WellEvents
      }
      on event Well.WellSpudded is {
        send event Well.WellSpudded to outlet WellEvents
      }
      on event Well.DrillingProgressUpdated is {
        send event Well.DrillingProgressUpdated to outlet WellEvents
      }
      on event Well.WellCompleted is {
        send event Well.WellCompleted to outlet WellEvents
      }
      on event Well.WellBroughtOnline is {
        send event Well.WellBroughtOnline to outlet WellEvents
      }
      on event Well.ProductionRecorded is {
        send event Well.ProductionRecorded to outlet WellEvents
      }
      on event Well.WellShutIn is {
        send event Well.WellShutIn to outlet WellEvents
      }
      on event Well.WorkoverStarted is {
        send event Well.WorkoverStarted to outlet WellEvents
      }
      on event Well.WorkoverCompleted is {
        send event Well.WorkoverCompleted to outlet WellEvents
      }
      on event Well.WellAbandoned is {
        send event Well.WellAbandoned to outlet WellEvents
      }
      on other is {
        error "Unexpected message for source WellEventSource"
      }
    } with {
      briefly "Well source handler"
      described as {
        |Publishes Well events onto the outlet.
      }
    }
  } with {
    briefly "Well event source"
    described as {
      |Publishes Well entity events into the streaming topology.
    }
  }
  processor WellEventSink as sink is {
    inlet WellInlet is type WellEvent    handler WellSinkHandler is {
      on event Well.WellPlanned is {
        tell event Well.WellPlanned to repository WellContext.WellRepository
      }
      on event Well.PermitSubmitted is {
        tell event Well.PermitSubmitted to repository WellContext.WellRepository
      }
      on event Well.PermitApproved is {
        tell event Well.PermitApproved to repository WellContext.WellRepository
      }
      on event Well.WellSpudded is {
        tell event Well.WellSpudded to repository WellContext.WellRepository
      }
      on event Well.DrillingProgressUpdated is {
        tell event Well.DrillingProgressUpdated to repository WellContext.WellRepository
      }
      on event Well.WellCompleted is {
        tell event Well.WellCompleted to repository WellContext.WellRepository
      }
      on event Well.WellBroughtOnline is {
        tell event Well.WellBroughtOnline to repository WellContext.WellRepository
      }
      on event Well.ProductionRecorded is {
        tell event Well.ProductionRecorded to repository WellContext.WellRepository
      }
      on event Well.WellShutIn is {
        tell event Well.WellShutIn to repository WellContext.WellRepository
      }
      on event Well.WorkoverStarted is {
        tell event Well.WorkoverStarted to repository WellContext.WellRepository
      }
      on event Well.WorkoverCompleted is {
        tell event Well.WorkoverCompleted to repository WellContext.WellRepository
      }
      on event Well.WellAbandoned is {
        tell event Well.WellAbandoned to repository WellContext.WellRepository
      }
      on other is {
        error "Unexpected message for sink WellEventSink"
      }
    } with {
      briefly "Well sink handler"
      described as {
        |Persists Well events via the repository.
      }
    }
  } with {
    briefly "Well event sink"
    described as {
      |Receives Well events for persistence.
    }
  }
  connector WellEventFlow is from outlet WellContext.WellEventSource.WellEvents to inlet WellContext.WellEventSink.WellInlet with {
    briefly "Well event flow"
    described as {
      |Connects the Well source to its sink.
    }
  }
  processor WellEventSplit as split is {
    inlet WellEventSplitIn is type WellEvent    outlet WellEventSplitToWellRepository is type WellEvent
    outlet WellEventSplitToProductionAnalytics is type WellEvent
    handler WellEventSplitHandler is {
      on event Well.WellPlanned is {
        send event Well.WellPlanned to outlet WellEventSplitToWellRepository
        send event Well.WellPlanned to outlet WellEventSplitToProductionAnalytics
        tell event Well.WellPlanned to entity WellContext.Well
      }
      on event Well.PermitSubmitted is {
        send event Well.PermitSubmitted to outlet WellEventSplitToWellRepository
        send event Well.PermitSubmitted to outlet WellEventSplitToProductionAnalytics
        tell event Well.PermitSubmitted to entity WellContext.Well
      }
      on event Well.PermitApproved is {
        send event Well.PermitApproved to outlet WellEventSplitToWellRepository
        send event Well.PermitApproved to outlet WellEventSplitToProductionAnalytics
        tell event Well.PermitApproved to entity WellContext.Well
      }
      on event Well.WellSpudded is {
        send event Well.WellSpudded to outlet WellEventSplitToWellRepository
        send event Well.WellSpudded to outlet WellEventSplitToProductionAnalytics
        tell event Well.WellSpudded to entity WellContext.Well
      }
      on event Well.DrillingProgressUpdated is {
        send event Well.DrillingProgressUpdated to outlet WellEventSplitToWellRepository
        send event Well.DrillingProgressUpdated to outlet WellEventSplitToProductionAnalytics
        tell event Well.DrillingProgressUpdated to entity WellContext.Well
      }
      on event Well.WellCompleted is {
        send event Well.WellCompleted to outlet WellEventSplitToWellRepository
        send event Well.WellCompleted to outlet WellEventSplitToProductionAnalytics
        tell event Well.WellCompleted to entity WellContext.Well
      }
      on event Well.WellBroughtOnline is {
        send event Well.WellBroughtOnline to outlet WellEventSplitToWellRepository
        send event Well.WellBroughtOnline to outlet WellEventSplitToProductionAnalytics
        tell event Well.WellBroughtOnline to entity WellContext.Well
      }
      on event Well.ProductionRecorded is {
        send event Well.ProductionRecorded to outlet WellEventSplitToWellRepository
        send event Well.ProductionRecorded to outlet WellEventSplitToProductionAnalytics
        tell event Well.ProductionRecorded to entity WellContext.Well
      }
      on event Well.WellShutIn is {
        send event Well.WellShutIn to outlet WellEventSplitToWellRepository
        send event Well.WellShutIn to outlet WellEventSplitToProductionAnalytics
        tell event Well.WellShutIn to entity WellContext.Well
      }
      on event Well.WorkoverStarted is {
        send event Well.WorkoverStarted to outlet WellEventSplitToWellRepository
        send event Well.WorkoverStarted to outlet WellEventSplitToProductionAnalytics
        tell event Well.WorkoverStarted to entity WellContext.Well
      }
      on event Well.WorkoverCompleted is {
        send event Well.WorkoverCompleted to outlet WellEventSplitToWellRepository
        send event Well.WorkoverCompleted to outlet WellEventSplitToProductionAnalytics
        tell event Well.WorkoverCompleted to entity WellContext.Well
      }
      on event Well.WellAbandoned is {
        send event Well.WellAbandoned to outlet WellEventSplitToWellRepository
        send event Well.WellAbandoned to outlet WellEventSplitToProductionAnalytics
        tell event Well.WellAbandoned to entity WellContext.Well
      }
      on other is {
        error "Unexpected message for processor WellEventSplit"
      }
    } with {
      briefly "Well event fan-out handler"
      described as {
        |Delivers each Well event to all of its consumers.
      }
    }
  } with {
    briefly "Well event fan-out"
    described as {
      |Fans Well events out to the repository and projectors.
    }
  }
  connector 'WellEvent Stream' is from outlet WellContext.Well.WellEvents2 to inlet WellContext.WellEventSplit.WellEventSplitIn with {
    briefly "Well events, fanned out to storage and read models"
  }
  connector 'WellEvent Storage' is from outlet WellContext.WellEventSplit.WellEventSplitToWellRepository to inlet WellContext.WellRepository.WellRepositoryFromWell with {
    briefly "Well events on their way to storage"
  }
  connector 'ProductionAnalytics Feed' is from outlet WellContext.WellEventSplit.WellEventSplitToProductionAnalytics to inlet WellContext.ProductionAnalytics.ProductionAnalyticsFromWell with {
    briefly "Well events feeding the ProductionAnalytics projection"
  }
  connector 'ProductionAnalytics Storage' is from outlet WellContext.ProductionAnalytics.ProductionAnalyticsOut to inlet WellContext.WellRepository.WellRepositoryFromProductionAnalytics with {
    briefly "The ProductionAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for well management"
  described as {
    |Oil and gas well lifecycle context.
  }
}
