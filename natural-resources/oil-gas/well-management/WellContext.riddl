// Well Management - Well Context
context WellContext as router is {
  inlet WellContextFromToLandManagement is command Well.SubmitForPermit with {
    briefly "What ToLandManagement makes of the answers it gets"
  }
  connector 'ToLandManagement Intake' is from outlet WellContext.ToLandManagement.ToLandManagementToWellContext to inlet WellContext.WellContextFromToLandManagement with {
    briefly "Answers translated by ToLandManagement, on their way in"
  }
  inlet WellContextFromToSCADA is command Well.RecordProduction with {
    briefly "What ToSCADA makes of the answers it gets"
  }
  connector 'ToSCADA Intake' is from outlet WellContext.ToSCADA.ToSCADAToWellContext to inlet WellContext.WellContextFromToSCADA with {
    briefly "Answers translated by ToSCADA, on their way in"
  }
  inlet WellContextFromRegulatorySystem is command Well.ApprovePermit with {
    briefly "What FromRegulatorySystem makes of that service's news"
  }
  connector 'FromRegulatorySystem Intake' is from outlet WellContext.FromRegulatorySystem.FromRegulatorySystemToWellContext to inlet WellContext.WellContextFromRegulatorySystem with {
    briefly "What FromRegulatorySystem makes of that news, on its way in"
  }
  inlet WellCommandStreamIn is type WellCommand  outlet WellCommandStreamOut is type WellCommand
  inlet WellResultStreamIn is result Well.WellResult  outlet WellResultStreamOut is result Well.WellResult
  handler WellContextBoundary is {
    on planWell: command Well.PlanWell is {
      send planWell to outlet WellContext.WellCommandStreamOut
    }
    on submitForPermit: command Well.SubmitForPermit is {
      send submitForPermit to outlet WellContext.WellCommandStreamOut
    }
    on approvePermit: command Well.ApprovePermit is {
      send approvePermit to outlet WellContext.WellCommandStreamOut
    }
    on spudWell: command Well.SpudWell is {
      send spudWell to outlet WellContext.WellCommandStreamOut
    }
    on updateDrillingProgress: command Well.UpdateDrillingProgress is {
      send updateDrillingProgress to outlet WellContext.WellCommandStreamOut
    }
    on completeWell: command Well.CompleteWell is {
      send completeWell to outlet WellContext.WellCommandStreamOut
    }
    on bringOnline: command Well.BringOnline is {
      send bringOnline to outlet WellContext.WellCommandStreamOut
    }
    on recordProduction: command Well.RecordProduction is {
      send recordProduction to outlet WellContext.WellCommandStreamOut
    }
    on shutinWell: command Well.ShutinWell is {
      send shutinWell to outlet WellContext.WellCommandStreamOut
    }
    on startWorkover: command Well.StartWorkover is {
      send startWorkover to outlet WellContext.WellCommandStreamOut
    }
    on completeWorkover: command Well.CompleteWorkover is {
      send completeWorkover to outlet WellContext.WellCommandStreamOut
    }
    on abandonWell: command Well.AbandonWell is {
      send abandonWell to outlet WellContext.WellCommandStreamOut
    }
    on wellResult: result Well.WellResult is {
      send wellResult to outlet WellContext.WellResultStreamOut
    }
    on other is {
      error "Unexpected message at the WellContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'WellCommand Stream Intake' is from outlet WellContext.WellCommandStreamOut to inlet WellContext.Well.WellCommands  connector 'WellResult Stream Egress' is from outlet WellContext.WellRepository.WellRepositoryResponses to inlet WellContext.WellResultStreamIn  adaptor ToLandManagement to context LandManagement as router is { 
    outlet ToLandManagementToWellContext is command Well.SubmitForPermit
    inlet ToLandManagementIn is type WellEvent    inlet ToLandManagementReplies is result LandManagement.LeaseInfo    outlet ToLandManagementOut is query LandManagement.GetLeaseInfo
    handler ToLandManagementHandler is {
      on wellPlanned: event Well.WellPlanned is {
        let askAnswer: type LandManagement.LeaseInfo = ask query LandManagement.GetLeaseInfo of context LandManagement
        do "a planned well needing the lease that permits it"
        when prompt("askAnswer.expirationDate has not passed") then
          send command Well.SubmitForPermit(wellId = wellPlanned.wellId, regulatoryAgency = prompt("the agency for askAnswer.leaseName"), submittedAt = prompt("now")) to outlet WellContext.ToLandManagement.ToLandManagementToWellContext
        end
      }
      on other is {
        error "Unexpected message for adaptor ToLandManagement"
      }
    } with {
      briefly "to land management"
      described as {
        |Carries messages to the external LandManagement.
      }
    }
  } with {
    briefly "LandManagement integration"
    described as {
      |The model's side of the LandManagement conversation.
    }
  }
  adaptor FromProductionAccounting from context ProductionAccounting as sink is { 
    inlet FromProductionAccountingIn is event ProductionAccounting.SalesRecorded    handler FromProductionAccountingHandler is {
      on salesRecorded: event ProductionAccounting.SalesRecorded is {
        do "accounting has the sale; the production was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromProductionAccounting"
      }
    } with {
      briefly "from production accounting"
      described as {
        |Carries messages from the external ProductionAccounting.
      }
    }
  } with {
    briefly "ProductionAccounting integration"
    described as {
      |The model's side of the ProductionAccounting conversation.
    }
  }
  adaptor ToProductionAccounting to context ProductionAccounting as flow is { 
    inlet ToProductionAccountingIn is type WellEvent    outlet ToProductionAccountingOut is command ProductionAccounting.RecordSales
    handler ToProductionAccountingHandler is {
      on productionRecorded: event Well.ProductionRecorded is {
        let item0: type ProductionAccounting.RecordSales = prompt("translate the productionRecorded event into a RecordSales, recorded production being what fixes the volume sold")
        send item0 to outlet WellContext.ToProductionAccounting.ToProductionAccountingOut
      }
      on other is {
        error "Unexpected message for adaptor ToProductionAccounting"
      }
    } with {
      briefly "to production accounting"
      described as {
        |Carries messages to the external ProductionAccounting.
      }
    }
  } with {
    briefly "ProductionAccounting integration"
    described as {
      |The model's side of the ProductionAccounting conversation.
    }
  }
  adaptor FromRegulatorySystem from context RegulatorySystem as flow is { 
    inlet FromRegulatorySystemIn is event RegulatorySystem.PermitDecisionReceived    outlet FromRegulatorySystemToWellContext is command Well.ApprovePermit
    handler FromRegulatorySystemHandler is {
      on permitDecisionReceived: event RegulatorySystem.PermitDecisionReceived is {
        let item0: type Well.ApprovePermit = prompt("translate the permitDecisionReceived event into a ApprovePermit, a decision in the well's favour is what approves its permit")
        send item0 to outlet WellContext.FromRegulatorySystem.FromRegulatorySystemToWellContext
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatorySystem"
      }
    } with {
      briefly "from regulatory system"
      described as {
        |Carries messages from the external RegulatorySystem.
      }
    }
  } with {
    briefly "RegulatorySystem integration"
    described as {
      |The model's side of the RegulatorySystem conversation.
    }
  }
  adaptor ToRegulatorySystem to context RegulatorySystem as flow is { 
    inlet ToRegulatorySystemIn is type WellEvent    outlet ToRegulatorySystemOut is type RegulatorySystem.RegulatorySystemCommand
    handler ToRegulatorySystemHandler is {
      on productionRecorded: event ProductionRecorded is {
        let item0: type RegulatorySystem.SubmitPermitApplication = prompt("translate the productionRecorded event into a SubmitPermitApplication where continued production needs fresh authority")
        send item0 to outlet WellContext.ToRegulatorySystem.ToRegulatorySystemOut
        let item1: type RegulatorySystem.SubmitProductionReport = prompt("translate the productionRecorded event into a SubmitProductionReport declaring what the well produced")
        send item1 to outlet WellContext.ToRegulatorySystem.ToRegulatorySystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatorySystem"
      }
    } with {
      briefly "to regulatory system"
      described as {
        |Carries messages to the external RegulatorySystem.
      }
    }
  } with {
    briefly "RegulatorySystem integration"
    described as {
      |The model's side of the RegulatorySystem conversation.
    }
  }
  adaptor ToSCADA to context SCADA as router is { 
    outlet ToSCADAToWellContext is command Well.RecordProduction
    inlet ToSCADAIn is type WellEvent    inlet ToSCADAReplies is result SCADA.WellTelemetry    outlet ToSCADAOut is query SCADA.GetWellTelemetry
    handler ToSCADAHandler is {
      on productionRecorded: event Well.ProductionRecorded is {
        let askAnswer: type SCADA.WellTelemetry = ask query SCADA.GetWellTelemetry of context SCADA
        do "recorded production needing the instrument readings behind the number"
        when prompt("the recorded production disagrees with askAnswer.flowRate") then
          send command Well.RecordProduction(wellId = productionRecorded.wellId, production = prompt("the production reconciled to askAnswer.flowRate")) to outlet WellContext.ToSCADA.ToSCADAToWellContext
        end
      }
      on other is {
        error "Unexpected message for adaptor ToSCADA"
      }
    } with {
      briefly "to scada"
      described as {
        |Carries messages to the external SCADA.
      }
    }
  } with {
    briefly "SCADA integration"
    described as {
      |The model's side of the SCADA conversation.
    }
  }
  include "types.riddl"
  include "Well.riddl"
  type WellRepositoryCommand is one of {
    WellContext.WellRepository.PersistDrillingProgressUpdated or WellContext.WellRepository.PersistPermitApproved or WellContext.WellRepository.PersistPermitSubmitted or WellContext.WellRepository.PersistProductionRecorded or WellContext.WellRepository.PersistWellAbandoned or WellContext.WellRepository.PersistWellBroughtOnline or WellContext.WellRepository.PersistWellCompleted or WellContext.WellRepository.PersistWellPlanned or WellContext.WellRepository.PersistWellShutIn or WellContext.WellRepository.PersistWellSpudded or WellContext.WellRepository.PersistWorkoverCompleted or WellContext.WellRepository.PersistWorkoverStarted
  } with {
    briefly "Anything that writes WellRepository"
    described as {
      |The persistence commands WellRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository WellRepository as flow is {
    inlet WellRepositoryFromProductionAnalytics is type WellRepositoryCommand    command PersistDrillingProgressUpdated is {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row DrillingProgressUpdated applies to.
        }
      }
      progress: DrillingProgress? with {
        briefly "Progress"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DrillingProgressUpdated"
      described as {
        |Instructs this repository to apply DrillingProgressUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPermitApproved is {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row PermitApproved applies to.
        }
      }
      permitNumber: String(1,100)? with {
        briefly "Permit number"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      approvedAt: TimeStamp? with {
        briefly "Approved at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PermitApproved"
      described as {
        |Instructs this repository to apply PermitApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPermitSubmitted is {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row PermitSubmitted applies to.
        }
      }
      regulatoryAgency: String(1,100)? with {
        briefly "Regulatory agency"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      submittedAt: TimeStamp? with {
        briefly "Submitted at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PermitSubmitted"
      described as {
        |Instructs this repository to apply PermitSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWellCompleted is {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WellCompleted applies to.
        }
      }
      completion: CompletionData? with {
        briefly "Completion"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist WellCompleted"
      described as {
        |Instructs this repository to apply WellCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWellPlanned is {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WellPlanned applies to.
        }
      }
      wellName: String(1,200)? with {
        briefly "Well name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      location: WellLocation? with {
        briefly "Location"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      plannedAt: TimeStamp? with {
        briefly "Planned at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist WellPlanned"
      described as {
        |Instructs this repository to apply WellPlanned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWellSpudded is {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WellSpudded applies to.
        }
      }
      spudDate: Date? with {
        briefly "Spud date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      rigId: String(1,100)? with {
        briefly "Rig id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist WellSpudded"
      described as {
        |Instructs this repository to apply WellSpudded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkoverCompleted is {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkoverCompleted applies to.
        }
      }
      workorderId: UUID? with {
        briefly "Workorder id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      success: Boolean? with {
        briefly "Success"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist WorkoverCompleted"
      described as {
        |Instructs this repository to apply WorkoverCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkoverStarted is {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkoverStarted applies to.
        }
      }
      workorderId: UUID? with {
        briefly "Workorder id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      workType: String(1,100)? with {
        briefly "Work type"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      startedAt: TimeStamp? with {
        briefly "Started at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist WorkoverStarted"
      described as {
        |Instructs this repository to apply WorkoverStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProductionRecorded is {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProductionRecorded applies to.
        }
      }
      production: ProductionData? with {
        briefly "Production"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ProductionRecorded"
      described as {
        |Instructs this repository to apply ProductionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWellAbandoned is {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WellAbandoned applies to.
        }
      }
      abandonmentDate: Date? with {
        briefly "Abandonment date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist WellAbandoned"
      described as {
        |Instructs this repository to apply WellAbandoned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWellBroughtOnline is {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WellBroughtOnline applies to.
        }
      }
      firstProductionDate: Date? with {
        briefly "First production date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      hydrocarbonType: HydrocarbonType? with {
        briefly "Hydrocarbon type"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist WellBroughtOnline"
      described as {
        |Instructs this repository to apply WellBroughtOnline to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWellShutIn is {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WellShutIn applies to.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      shutinDate: Date? with {
        briefly "Shutin date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist WellShutIn"
      described as {
        |Instructs this repository to apply WellShutIn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet WellRepositoryResponses is result Well.WellResult
    record StoredWell is {
      wellId: WellId with {
        briefly "wellId"
        described as {
          |The wellId column of the stored well row.
        }
      }
      fieldId: FieldId with {
        briefly "fieldId"
        described as {
          |The fieldId column of the stored well row.
        }
      }
      leaseId: LeaseId with {
        briefly "leaseId"
        described as {
          |The leaseId column of the stored well row.
        }
      }
      status: WellStatus with {
        briefly "status"
        described as {
          |The status column of the stored well row.
        }
      }
      progress: DrillingProgress? with {
        briefly "Progress"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      permitNumber: String(1,100)? with {
        briefly "Permit number"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      approvedAt: TimeStamp? with {
        briefly "Approved at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      regulatoryAgency: String(1,100)? with {
        briefly "Regulatory agency"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      submittedAt: TimeStamp? with {
        briefly "Submitted at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      completion: CompletionData? with {
        briefly "Completion"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      wellName: String(1,200)? with {
        briefly "Well name"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      location: WellLocation? with {
        briefly "Location"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      plannedAt: TimeStamp? with {
        briefly "Planned at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      spudDate: Date? with {
        briefly "Spud date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      rigId: String(1,100)? with {
        briefly "Rig id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      workorderId: UUID? with {
        briefly "Workorder id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      success: Boolean? with {
        briefly "Success"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      workType: String(1,100)? with {
        briefly "Work type"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      startedAt: TimeStamp? with {
        briefly "Started at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      production: ProductionData? with {
        briefly "Production"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      abandonmentDate: Date? with {
        briefly "Abandonment date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      firstProductionDate: Date? with {
        briefly "First production date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      hydrocarbonType: HydrocarbonType? with {
        briefly "Hydrocarbon type"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      shutinDate: Date? with {
        briefly "Shutin date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored well row"
      described as {
        |The persistence shape of well data as this repository stores it.
      }
    }
    schema WellData is relational
      of wells as record StoredWell
        key on field StoredWell.wellId
        index on field StoredWell.leaseId
        index on field StoredWell.fieldId
        index on field StoredWell.status
 with {
      briefly "Well data schema"
      described as {
        |The relational schema holding well data for the WellRepository.
      }
    }
    handler WellPersistence is {
      on persistDrillingProgressUpdated: command PersistDrillingProgressUpdated is {
        update WellData.wells set progress = persistDrillingProgressUpdated.progress, updatedAt = persistDrillingProgressUpdated.updatedAt where wellId == persistDrillingProgressUpdated.wellId
      }
      on persistPermitApproved: command PersistPermitApproved is {
        update WellData.wells set permitNumber = persistPermitApproved.permitNumber, approvedAt = persistPermitApproved.approvedAt where wellId == persistPermitApproved.wellId
      }
      on persistPermitSubmitted: command PersistPermitSubmitted is {
        update WellData.wells set regulatoryAgency = persistPermitSubmitted.regulatoryAgency, submittedAt = persistPermitSubmitted.submittedAt where wellId == persistPermitSubmitted.wellId
      }
      on persistWellCompleted: command PersistWellCompleted is {
        update WellData.wells set completion = persistWellCompleted.completion where wellId == persistWellCompleted.wellId
      }
      on persistWellPlanned: command PersistWellPlanned is {
        update WellData.wells set wellName = persistWellPlanned.wellName, location = persistWellPlanned.location, plannedAt = persistWellPlanned.plannedAt where wellId == persistWellPlanned.wellId
      }
      on persistWellSpudded: command PersistWellSpudded is {
        update WellData.wells set spudDate = persistWellSpudded.spudDate, rigId = persistWellSpudded.rigId where wellId == persistWellSpudded.wellId
      }
      on persistWorkoverCompleted: command PersistWorkoverCompleted is {
        update WellData.wells set workorderId = persistWorkoverCompleted.workorderId, success = persistWorkoverCompleted.success, completedAt = persistWorkoverCompleted.completedAt where wellId == persistWorkoverCompleted.wellId
      }
      on persistWorkoverStarted: command PersistWorkoverStarted is {
        update WellData.wells set workorderId = persistWorkoverStarted.workorderId, workType = persistWorkoverStarted.workType, startedAt = persistWorkoverStarted.startedAt where wellId == persistWorkoverStarted.wellId
      }
      on persistProductionRecorded: command PersistProductionRecorded is {
        update WellData.wells set production = persistProductionRecorded.production, recordedAt = persistProductionRecorded.recordedAt where wellId == persistProductionRecorded.wellId
      }
      on persistWellAbandoned: command PersistWellAbandoned is {
        update WellData.wells set abandonmentDate = persistWellAbandoned.abandonmentDate, reason = persistWellAbandoned.reason where wellId == persistWellAbandoned.wellId
      }
      on persistWellBroughtOnline: command PersistWellBroughtOnline is {
        update WellData.wells set firstProductionDate = persistWellBroughtOnline.firstProductionDate, hydrocarbonType = persistWellBroughtOnline.hydrocarbonType where wellId == persistWellBroughtOnline.wellId
      }
      on persistWellShutIn: command PersistWellShutIn is {
        update WellData.wells set reason = persistWellShutIn.reason, shutinDate = persistWellShutIn.shutinDate where wellId == persistWellShutIn.wellId
      }
      on query GetFieldProduction is {
        let fieldProductionView: type FieldProductionView = prompt("read the field production projection")
        reply fieldProductionView
      }
    } with {
      briefly "Persists well commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Well data persistence"
    described as {
      |Persistent storage for wells.
    }
  }
  query GetFieldProduction replies result FieldProductionView is {
    fieldProductionKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which field production to retrieve.
      }
    }
  } with {
    briefly "Get field production"
    described as {
      |Retrieves the field production projection.
    }
  }
  result FieldProductionView is {
    fieldProduction: ProductionAnalytics.FieldProduction with {
      briefly "Field production"
      described as {
        |The field production being returned.
      }
    }
  } with {
    briefly "Field production view"
    described as {
      |Read model view carrying the field production projection.
    }
  }
  projector ProductionAnalytics as flow is {
    updates repository WellContext.WellRepository
    outlet ProductionAnalyticsToRepository is type WellRepositoryCommand
    inlet ProductionAnalyticsFromWell is type WellEvent    record FieldProduction is {
      fieldId: FieldId with {
        briefly "Field"
        described as {
          |Field ID.
        }
      }
      totalOilBBL: Decimal(15,2) with {
        briefly "Oil"
        described as {
          |Total oil barrels.
        }
      }
      totalGasMCF: Decimal(15,2) with {
        briefly "Gas"
        described as {
          |Total gas MCF.
        }
      }
      activeWells: Natural with {
        briefly "Active"
        described as {
          |Active well count.
        }
      }
      averageIPRate: Decimal(10,2) with {
        briefly "Avg IP"
        described as {
          |Average initial potential.
        }
      }
    } with {
      briefly "Field production"
      described as {
        |Production by field.
      }
    }
    handler AnalyticsHandler is {
      on drillingProgressUpdated: event Well.DrillingProgressUpdated is {
        tell command WellContext.WellRepository.PersistDrillingProgressUpdated(wellId = drillingProgressUpdated.wellId, progress = drillingProgressUpdated.progress, updatedAt = drillingProgressUpdated.updatedAt) to repository WellContext.WellRepository
        do "apply DrillingProgressUpdated to the ProductionAnalytics projection"
      }
      on permitApproved: event Well.PermitApproved is {
        tell command WellContext.WellRepository.PersistPermitApproved(wellId = permitApproved.wellId, permitNumber = permitApproved.permitNumber, approvedAt = permitApproved.approvedAt) to repository WellContext.WellRepository
        do "apply PermitApproved to the ProductionAnalytics projection"
      }
      on permitSubmitted: event Well.PermitSubmitted is {
        tell command WellContext.WellRepository.PersistPermitSubmitted(wellId = permitSubmitted.wellId, regulatoryAgency = permitSubmitted.regulatoryAgency, submittedAt = permitSubmitted.submittedAt) to repository WellContext.WellRepository
        do "apply PermitSubmitted to the ProductionAnalytics projection"
      }
      on wellCompleted: event Well.WellCompleted is {
        tell command WellContext.WellRepository.PersistWellCompleted(wellId = wellCompleted.wellId, completion = wellCompleted.completion) to repository WellContext.WellRepository
        do "apply WellCompleted to the ProductionAnalytics projection"
      }
      on wellPlanned: event Well.WellPlanned is {
        tell command WellContext.WellRepository.PersistWellPlanned(wellId = wellPlanned.wellId, wellName = wellPlanned.wellName, location = wellPlanned.location, plannedAt = wellPlanned.plannedAt) to repository WellContext.WellRepository
        do "apply WellPlanned to the ProductionAnalytics projection"
      }
      on wellSpudded: event Well.WellSpudded is {
        tell command WellContext.WellRepository.PersistWellSpudded(wellId = wellSpudded.wellId, spudDate = wellSpudded.spudDate, rigId = wellSpudded.rigId) to repository WellContext.WellRepository
        do "apply WellSpudded to the ProductionAnalytics projection"
      }
      on workoverCompleted: event Well.WorkoverCompleted is {
        tell command WellContext.WellRepository.PersistWorkoverCompleted(wellId = workoverCompleted.wellId, workorderId = workoverCompleted.workorderId, success = workoverCompleted.success, completedAt = workoverCompleted.completedAt) to repository WellContext.WellRepository
        do "apply WorkoverCompleted to the ProductionAnalytics projection"
      }
      on workoverStarted: event Well.WorkoverStarted is {
        tell command WellContext.WellRepository.PersistWorkoverStarted(wellId = workoverStarted.wellId, workorderId = workoverStarted.workorderId, workType = workoverStarted.workType, startedAt = workoverStarted.startedAt) to repository WellContext.WellRepository
        do "apply WorkoverStarted to the ProductionAnalytics projection"
      }
      on productionRecorded: event Well.ProductionRecorded is {
        tell command WellContext.WellRepository.PersistProductionRecorded(wellId = productionRecorded.wellId, production = productionRecorded.production, recordedAt = productionRecorded.recordedAt) to repository WellContext.WellRepository
        do "Aggregate production by field"
      }
      on wellBroughtOnline: event Well.WellBroughtOnline is {
        tell command WellContext.WellRepository.PersistWellBroughtOnline(wellId = wellBroughtOnline.wellId, firstProductionDate = wellBroughtOnline.firstProductionDate, hydrocarbonType = wellBroughtOnline.hydrocarbonType) to repository WellContext.WellRepository
        do "Increment active well count and record IP"
      }
      on wellShutIn: event Well.WellShutIn is {
        tell command WellContext.WellRepository.PersistWellShutIn(wellId = wellShutIn.wellId, reason = wellShutIn.reason, shutinDate = wellShutIn.shutinDate) to repository WellContext.WellRepository
        do "Decrement active well count"
      }
      on wellAbandoned: event Well.WellAbandoned is {
        tell command WellContext.WellRepository.PersistWellAbandoned(wellId = wellAbandoned.wellId, abandonmentDate = wellAbandoned.abandonmentDate, reason = wellAbandoned.reason) to repository WellContext.WellRepository
        do "Update field statistics"
      }
    } with {
      briefly "Maintains production analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Production analytics"
    described as {
      |Well and field production analysis.
    }
  }
  // ---- Event publication for Well ----
  type WellEvent is one of {
    WellContext.Well.WellPlanned or WellContext.Well.PermitSubmitted or WellContext.Well.PermitApproved or WellContext.Well.WellSpudded or WellContext.Well.DrillingProgressUpdated or WellContext.Well.WellCompleted or WellContext.Well.WellBroughtOnline or WellContext.Well.ProductionRecorded or WellContext.Well.WellShutIn or WellContext.Well.WorkoverStarted or WellContext.Well.WorkoverCompleted or WellContext.Well.WellAbandoned
  } with {
    briefly "Well event alternation"
    described as {
      |Union of all Well events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet WellEventSplit as split is {
    outlet WellEventSplitToToSCADA is type WellEvent
    outlet WellEventSplitToToRegulatorySystem is type WellEvent
    outlet WellEventSplitToToProductionAccounting is type WellEvent
    outlet WellEventSplitToToLandManagement is type WellEvent
    inlet WellEventSplitIn is type WellEvent    outlet WellEventSplitToProductionAnalytics is type WellEvent
    handler WellEventSplitHandler is {
      on wellPlanned: event Well.WellPlanned is {
        send wellPlanned to outlet WellEventSplitToProductionAnalytics
        send wellPlanned to outlet WellEventSplitToToLandManagement
        tell wellPlanned to entity WellContext.Well
      }
      on permitSubmitted: event Well.PermitSubmitted is {
        send permitSubmitted to outlet WellEventSplitToProductionAnalytics
        tell permitSubmitted to entity WellContext.Well
      }
      on permitApproved: event Well.PermitApproved is {
        send permitApproved to outlet WellEventSplitToProductionAnalytics
        tell permitApproved to entity WellContext.Well
      }
      on wellSpudded: event Well.WellSpudded is {
        send wellSpudded to outlet WellEventSplitToProductionAnalytics
        tell wellSpudded to entity WellContext.Well
      }
      on drillingProgressUpdated: event Well.DrillingProgressUpdated is {
        send drillingProgressUpdated to outlet WellEventSplitToProductionAnalytics
        tell drillingProgressUpdated to entity WellContext.Well
      }
      on wellCompleted: event Well.WellCompleted is {
        send wellCompleted to outlet WellEventSplitToProductionAnalytics
        tell wellCompleted to entity WellContext.Well
      }
      on wellBroughtOnline: event Well.WellBroughtOnline is {
        send wellBroughtOnline to outlet WellEventSplitToProductionAnalytics
        tell wellBroughtOnline to entity WellContext.Well
      }
      on productionRecorded: event Well.ProductionRecorded is {
        send productionRecorded to outlet WellEventSplitToProductionAnalytics
        send productionRecorded to outlet WellEventSplitToToSCADA
        send productionRecorded to outlet WellEventSplitToToRegulatorySystem
        send productionRecorded to outlet WellEventSplitToToProductionAccounting
        tell productionRecorded to entity WellContext.Well
      }
      on wellShutIn: event Well.WellShutIn is {
        send wellShutIn to outlet WellEventSplitToProductionAnalytics
        tell wellShutIn to entity WellContext.Well
      }
      on workoverStarted: event Well.WorkoverStarted is {
        send workoverStarted to outlet WellEventSplitToProductionAnalytics
        tell workoverStarted to entity WellContext.Well
      }
      on workoverCompleted: event Well.WorkoverCompleted is {
        send workoverCompleted to outlet WellEventSplitToProductionAnalytics
        tell workoverCompleted to entity WellContext.Well
      }
      on wellAbandoned: event Well.WellAbandoned is {
        send wellAbandoned to outlet WellEventSplitToProductionAnalytics
        tell wellAbandoned to entity WellContext.Well
      }
      on other is {
        error "Unexpected message for processor WellEventSplit"
      }
    } with {
      briefly "Well event fan-out handler"
      described as {
        |Delivers each Well event to all of its consumers.
      }
    }
  } with {
    briefly "Well event fan-out"
    described as {
      |Fans Well events out to the repository and projectors.
    }
  }
  connector 'ToSCADA Feed' is from outlet WellContext.WellEventSplit.WellEventSplitToToSCADA to inlet WellContext.ToSCADA.ToSCADAIn with {
    briefly "The Well events ToSCADA translates, on their way to it"
  }
  connector 'ToRegulatorySystem Feed' is from outlet WellContext.WellEventSplit.WellEventSplitToToRegulatorySystem to inlet WellContext.ToRegulatorySystem.ToRegulatorySystemIn with {
    briefly "The Well events ToRegulatorySystem translates, on their way to it"
  }
  connector 'ToProductionAccounting Feed' is from outlet WellContext.WellEventSplit.WellEventSplitToToProductionAccounting to inlet WellContext.ToProductionAccounting.ToProductionAccountingIn with {
    briefly "The Well events ToProductionAccounting translates, on their way to it"
  }
  connector 'ToLandManagement Feed' is from outlet WellContext.WellEventSplit.WellEventSplitToToLandManagement to inlet WellContext.ToLandManagement.ToLandManagementIn with {
    briefly "The Well events ToLandManagement translates, on their way to it"
  }
  connector 'WellEvent Stream' is from outlet WellContext.Well.WellEvents2 to inlet WellContext.WellEventSplit.WellEventSplitIn with {
    briefly "Well events, fanned out to storage and read models"
  }
  connector 'ProductionAnalytics Feed' is from outlet WellContext.WellEventSplit.WellEventSplitToProductionAnalytics to inlet WellContext.ProductionAnalytics.ProductionAnalyticsFromWell with {
    briefly "Well events feeding the ProductionAnalytics projection"
  }
  connector 'ProductionAnalytics Storage' is from outlet WellContext.ProductionAnalytics.ProductionAnalyticsToRepository to inlet WellContext.WellRepository.WellRepositoryFromProductionAnalytics with {
    briefly "ProductionAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for well management"
  described as {
    |Oil and gas well lifecycle context.
  }
}
