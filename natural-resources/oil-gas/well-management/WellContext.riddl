// Well Management - Well Context
context WellContext as router is {
  inlet WellCommandStreamIn is type WellCommand  outlet WellCommandStreamOut is type WellCommand
  inlet WellResultStreamIn is type Well.WellResult  outlet WellResultStreamOut is type Well.WellResult
  handler WellContextBoundary is {
    on planWell: command Well.PlanWell is {
      send planWell to outlet WellContext.WellCommandStreamOut
    }
    on submitForPermit: command Well.SubmitForPermit is {
      send submitForPermit to outlet WellContext.WellCommandStreamOut
    }
    on approvePermit: command Well.ApprovePermit is {
      send approvePermit to outlet WellContext.WellCommandStreamOut
    }
    on spudWell: command Well.SpudWell is {
      send spudWell to outlet WellContext.WellCommandStreamOut
    }
    on updateDrillingProgress: command Well.UpdateDrillingProgress is {
      send updateDrillingProgress to outlet WellContext.WellCommandStreamOut
    }
    on completeWell: command Well.CompleteWell is {
      send completeWell to outlet WellContext.WellCommandStreamOut
    }
    on bringOnline: command Well.BringOnline is {
      send bringOnline to outlet WellContext.WellCommandStreamOut
    }
    on recordProduction: command Well.RecordProduction is {
      send recordProduction to outlet WellContext.WellCommandStreamOut
    }
    on shutinWell: command Well.ShutinWell is {
      send shutinWell to outlet WellContext.WellCommandStreamOut
    }
    on startWorkover: command Well.StartWorkover is {
      send startWorkover to outlet WellContext.WellCommandStreamOut
    }
    on completeWorkover: command Well.CompleteWorkover is {
      send completeWorkover to outlet WellContext.WellCommandStreamOut
    }
    on abandonWell: command Well.AbandonWell is {
      send abandonWell to outlet WellContext.WellCommandStreamOut
    }
    on wellResult: result Well.WellResult is {
      send wellResult to outlet WellContext.WellResultStreamOut
    }
    on other is {
      error "Unexpected message at the WellContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'WellCommand Stream Intake' is from outlet WellContext.WellCommandStreamOut to inlet WellContext.Well.WellCommands  connector 'WellResult Stream Egress' is from outlet WellContext.WellRepository.WellRepositoryResponses to inlet WellContext.WellResultStreamIn  adaptor FromLandManagement from context LandManagement is { 
    handler FromLandManagementHandler is {
      on result LandManagement.LeaseInfo is {
        do "the model receives lease info"
      }
      on other is {
        error "Unexpected message for adaptor FromLandManagement"
      }
    } with {
      briefly "from land management"
      described as {
        |Carries messages from the external LandManagement.
      }
    }
  } with {
    briefly "LandManagement integration"
    described as {
      |The model's side of the LandManagement conversation.
    }
  }
  adaptor ToLandManagement to context LandManagement is { 
    handler ToLandManagementHandler is {
      on query LandManagement.GetLeaseInfo is {
        do "the model sends get lease info"
      }
      on other is {
        error "Unexpected message for adaptor ToLandManagement"
      }
    } with {
      briefly "to land management"
      described as {
        |Carries messages to the external LandManagement.
      }
    }
  } with {
    briefly "LandManagement integration"
    described as {
      |The model's side of the LandManagement conversation.
    }
  }
  adaptor FromProductionAccounting from context ProductionAccounting is { 
    handler FromProductionAccountingHandler is {
      on event ProductionAccounting.SalesRecorded is {
        do "the model receives sales recorded"
      }
      on other is {
        error "Unexpected message for adaptor FromProductionAccounting"
      }
    } with {
      briefly "from production accounting"
      described as {
        |Carries messages from the external ProductionAccounting.
      }
    }
  } with {
    briefly "ProductionAccounting integration"
    described as {
      |The model's side of the ProductionAccounting conversation.
    }
  }
  adaptor ToProductionAccounting to context ProductionAccounting is { 
    handler ToProductionAccountingHandler is {
      on command ProductionAccounting.RecordSales is {
        do "the model sends record sales"
      }
      on other is {
        error "Unexpected message for adaptor ToProductionAccounting"
      }
    } with {
      briefly "to production accounting"
      described as {
        |Carries messages to the external ProductionAccounting.
      }
    }
  } with {
    briefly "ProductionAccounting integration"
    described as {
      |The model's side of the ProductionAccounting conversation.
    }
  }
  adaptor FromRegulatorySystem from context RegulatorySystem is { 
    handler FromRegulatorySystemHandler is {
      on event RegulatorySystem.PermitDecisionReceived is {
        do "the model receives permit decision received"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatorySystem"
      }
    } with {
      briefly "from regulatory system"
      described as {
        |Carries messages from the external RegulatorySystem.
      }
    }
  } with {
    briefly "RegulatorySystem integration"
    described as {
      |The model's side of the RegulatorySystem conversation.
    }
  }
  adaptor ToRegulatorySystem to context RegulatorySystem is { 
    handler ToRegulatorySystemHandler is {
      on command RegulatorySystem.SubmitPermitApplication is {
        do "the model sends submit permit application"
      }
      on command RegulatorySystem.SubmitProductionReport is {
        do "the model sends submit production report"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatorySystem"
      }
    } with {
      briefly "to regulatory system"
      described as {
        |Carries messages to the external RegulatorySystem.
      }
    }
  } with {
    briefly "RegulatorySystem integration"
    described as {
      |The model's side of the RegulatorySystem conversation.
    }
  }
  adaptor FromSCADA from context SCADA is { 
    handler FromSCADAHandler is {
      on result SCADA.WellTelemetry is {
        do "the model receives well telemetry"
      }
      on other is {
        error "Unexpected message for adaptor FromSCADA"
      }
    } with {
      briefly "from scada"
      described as {
        |Carries messages from the external SCADA.
      }
    }
  } with {
    briefly "SCADA integration"
    described as {
      |The model's side of the SCADA conversation.
    }
  }
  adaptor ToSCADA to context SCADA is { 
    handler ToSCADAHandler is {
      on query SCADA.GetWellTelemetry is {
        do "the model sends get well telemetry"
      }
      on other is {
        error "Unexpected message for adaptor ToSCADA"
      }
    } with {
      briefly "to scada"
      described as {
        |Carries messages to the external SCADA.
      }
    }
  } with {
    briefly "SCADA integration"
    described as {
      |The model's side of the SCADA conversation.
    }
  }
  include "types.riddl"
  include "Well.riddl"
  type WellRepositoryCommand is one of {
    WellContext.WellRepository.PersistDrillingProgressUpdated or WellContext.WellRepository.PersistPermitApproved or WellContext.WellRepository.PersistPermitSubmitted or WellContext.WellRepository.PersistProductionRecorded or WellContext.WellRepository.PersistWellAbandoned or WellContext.WellRepository.PersistWellBroughtOnline or WellContext.WellRepository.PersistWellCompleted or WellContext.WellRepository.PersistWellPlanned or WellContext.WellRepository.PersistWellShutIn or WellContext.WellRepository.PersistWellSpudded or WellContext.WellRepository.PersistWorkoverCompleted or WellContext.WellRepository.PersistWorkoverStarted
  } with {
    briefly "Anything that writes WellRepository"
    described as {
      |The persistence commands WellRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository WellRepository as flow is {
    inlet WellRepositoryFromProductionAnalytics is type WellRepositoryCommand
    command PersistDrillingProgressUpdated is  {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row DrillingProgressUpdated applies to.
        }
      }
    } with {
      briefly "Persist DrillingProgressUpdated"
      described as {
        |Instructs this repository to apply DrillingProgressUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPermitApproved is  {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row PermitApproved applies to.
        }
      }
    } with {
      briefly "Persist PermitApproved"
      described as {
        |Instructs this repository to apply PermitApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPermitSubmitted is  {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row PermitSubmitted applies to.
        }
      }
    } with {
      briefly "Persist PermitSubmitted"
      described as {
        |Instructs this repository to apply PermitSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWellCompleted is  {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WellCompleted applies to.
        }
      }
    } with {
      briefly "Persist WellCompleted"
      described as {
        |Instructs this repository to apply WellCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWellPlanned is  {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WellPlanned applies to.
        }
      }
    } with {
      briefly "Persist WellPlanned"
      described as {
        |Instructs this repository to apply WellPlanned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWellSpudded is  {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WellSpudded applies to.
        }
      }
    } with {
      briefly "Persist WellSpudded"
      described as {
        |Instructs this repository to apply WellSpudded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkoverCompleted is  {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkoverCompleted applies to.
        }
      }
    } with {
      briefly "Persist WorkoverCompleted"
      described as {
        |Instructs this repository to apply WorkoverCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkoverStarted is  {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkoverStarted applies to.
        }
      }
    } with {
      briefly "Persist WorkoverStarted"
      described as {
        |Instructs this repository to apply WorkoverStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProductionRecorded is  {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProductionRecorded applies to.
        }
      }
    } with {
      briefly "Persist ProductionRecorded"
      described as {
        |Instructs this repository to apply ProductionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWellAbandoned is  {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WellAbandoned applies to.
        }
      }
    } with {
      briefly "Persist WellAbandoned"
      described as {
        |Instructs this repository to apply WellAbandoned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWellBroughtOnline is  {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WellBroughtOnline applies to.
        }
      }
    } with {
      briefly "Persist WellBroughtOnline"
      described as {
        |Instructs this repository to apply WellBroughtOnline to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWellShutIn is  {
      wellId: WellId with {
        briefly "Row addressed"
        described as {
          |Which stored row WellShutIn applies to.
        }
      }
    } with {
      briefly "Persist WellShutIn"
      described as {
        |Instructs this repository to apply WellShutIn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet WellRepositoryResponses is type Well.WellResult
    record StoredWell is  {
      wellId: WellId with {
        briefly "wellId"
        described as {
          |The wellId column of the stored well row.
        }
      }
      fieldId: FieldId with {
        briefly "fieldId"
        described as {
          |The fieldId column of the stored well row.
        }
      }
      leaseId: LeaseId with {
        briefly "leaseId"
        described as {
          |The leaseId column of the stored well row.
        }
      }
      status: WellStatus with {
        briefly "status"
        described as {
          |The status column of the stored well row.
        }
      }
    } with {
      briefly "Stored well row"
      described as {
        |The persistence shape of well data as this repository stores it.
      }
    }
    schema WellData is relational
      of wells as type StoredWell
        index on field StoredWell.wellId
        index on field StoredWell.leaseId
        index on field StoredWell.fieldId
        index on field StoredWell.status
 with {
      briefly "Well data schema"
      described as {
        |The relational schema holding well data for the WellRepository.
      }
    }
    handler WellPersistence is {
      on persistDrillingProgressUpdated: command PersistDrillingProgressUpdated is {
        do "apply DrillingProgressUpdated to the stored row"
      }
      on persistPermitApproved: command PersistPermitApproved is {
        do "apply PermitApproved to the stored row"
      }
      on persistPermitSubmitted: command PersistPermitSubmitted is {
        do "apply PermitSubmitted to the stored row"
      }
      on persistWellCompleted: command PersistWellCompleted is {
        do "apply WellCompleted to the stored row"
      }
      on persistWellPlanned: command PersistWellPlanned is {
        do "apply WellPlanned to the stored row"
      }
      on persistWellSpudded: command PersistWellSpudded is {
        do "apply WellSpudded to the stored row"
      }
      on persistWorkoverCompleted: command PersistWorkoverCompleted is {
        do "apply WorkoverCompleted to the stored row"
      }
      on persistWorkoverStarted: command PersistWorkoverStarted is {
        do "apply WorkoverStarted to the stored row"
      }
      on persistProductionRecorded: command PersistProductionRecorded is {
        do "apply ProductionRecorded to the stored row"
      }
      on persistWellAbandoned: command PersistWellAbandoned is {
        do "apply WellAbandoned to the stored row"
      }
      on persistWellBroughtOnline: command PersistWellBroughtOnline is {
        do "apply WellBroughtOnline to the stored row"
      }
      on persistWellShutIn: command PersistWellShutIn is {
        do "apply WellShutIn to the stored row"
      }
      on query GetFieldProduction is {
        let fieldProductionView: type FieldProductionView = prompt("read the field production projection")
        reply fieldProductionView
      }
    } with {
      briefly "Persists well commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Well data persistence"
    described as {
      |Persistent storage for wells.
    }
  }
  query GetFieldProduction replies result FieldProductionView is  {
    fieldProductionKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which field production to retrieve.
      }
    }
  } with {
    briefly "Get field production"
    described as {
      |Retrieves the field production projection.
    }
  }
  result FieldProductionView is  {
    fieldProduction: ProductionAnalytics.FieldProduction with {
      briefly "Field production"
      described as {
        |The field production being returned.
      }
    }
  } with {
    briefly "Field production view"
    described as {
      |Read model view carrying the field production projection.
    }
  }
  projector ProductionAnalytics as flow is {
    outlet ProductionAnalyticsToRepository is type WellRepositoryCommand
    updates repository WellContext.WellRepository
    inlet ProductionAnalyticsFromWell is type WellEvent
    record FieldProduction is  {
      fieldId: FieldId with {
        briefly "Field"
        described as {
          |Field ID.
        }
      }
      totalOilBBL: Decimal(15,2) with {
        briefly "Oil"
        described as {
          |Total oil barrels.
        }
      }
      totalGasMCF: Decimal(15,2) with {
        briefly "Gas"
        described as {
          |Total gas MCF.
        }
      }
      activeWells: Natural with {
        briefly "Active"
        described as {
          |Active well count.
        }
      }
      averageIPRate: Decimal(10,2) with {
        briefly "Avg IP"
        described as {
          |Average initial potential.
        }
      }
    } with {
      briefly "Field production"
      described as {
        |Production by field.
      }
    }
    handler AnalyticsHandler is {
      on drillingProgressUpdated: event Well.DrillingProgressUpdated is {
        tell command WellContext.WellRepository.PersistDrillingProgressUpdated(wellId = drillingProgressUpdated.wellId) to repository WellContext.WellRepository
        do "apply DrillingProgressUpdated to the ProductionAnalytics projection"
      }
      on permitApproved: event Well.PermitApproved is {
        tell command WellContext.WellRepository.PersistPermitApproved(wellId = permitApproved.wellId) to repository WellContext.WellRepository
        do "apply PermitApproved to the ProductionAnalytics projection"
      }
      on permitSubmitted: event Well.PermitSubmitted is {
        tell command WellContext.WellRepository.PersistPermitSubmitted(wellId = permitSubmitted.wellId) to repository WellContext.WellRepository
        do "apply PermitSubmitted to the ProductionAnalytics projection"
      }
      on wellCompleted: event Well.WellCompleted is {
        tell command WellContext.WellRepository.PersistWellCompleted(wellId = wellCompleted.wellId) to repository WellContext.WellRepository
        do "apply WellCompleted to the ProductionAnalytics projection"
      }
      on wellPlanned: event Well.WellPlanned is {
        tell command WellContext.WellRepository.PersistWellPlanned(wellId = wellPlanned.wellId) to repository WellContext.WellRepository
        do "apply WellPlanned to the ProductionAnalytics projection"
      }
      on wellSpudded: event Well.WellSpudded is {
        tell command WellContext.WellRepository.PersistWellSpudded(wellId = wellSpudded.wellId) to repository WellContext.WellRepository
        do "apply WellSpudded to the ProductionAnalytics projection"
      }
      on workoverCompleted: event Well.WorkoverCompleted is {
        tell command WellContext.WellRepository.PersistWorkoverCompleted(wellId = workoverCompleted.wellId) to repository WellContext.WellRepository
        do "apply WorkoverCompleted to the ProductionAnalytics projection"
      }
      on workoverStarted: event Well.WorkoverStarted is {
        tell command WellContext.WellRepository.PersistWorkoverStarted(wellId = workoverStarted.wellId) to repository WellContext.WellRepository
        do "apply WorkoverStarted to the ProductionAnalytics projection"
      }
      on productionRecorded: event Well.ProductionRecorded is {
        tell command WellContext.WellRepository.PersistProductionRecorded(wellId = productionRecorded.wellId) to repository WellContext.WellRepository
        do "Aggregate production by field"
      }
      on wellBroughtOnline: event Well.WellBroughtOnline is {
        tell command WellContext.WellRepository.PersistWellBroughtOnline(wellId = wellBroughtOnline.wellId) to repository WellContext.WellRepository
        do "Increment active well count and record IP"
      }
      on wellShutIn: event Well.WellShutIn is {
        tell command WellContext.WellRepository.PersistWellShutIn(wellId = wellShutIn.wellId) to repository WellContext.WellRepository
        do "Decrement active well count"
      }
      on wellAbandoned: event Well.WellAbandoned is {
        tell command WellContext.WellRepository.PersistWellAbandoned(wellId = wellAbandoned.wellId) to repository WellContext.WellRepository
        do "Update field statistics"
      }
    } with {
      briefly "Maintains production analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Production analytics"
    described as {
      |Well and field production analysis.
    }
  }
  // ---- Event publication for Well ----
  type WellEvent is one of {
    WellContext.Well.WellPlanned or WellContext.Well.PermitSubmitted or WellContext.Well.PermitApproved or WellContext.Well.WellSpudded or WellContext.Well.DrillingProgressUpdated or WellContext.Well.WellCompleted or WellContext.Well.WellBroughtOnline or WellContext.Well.ProductionRecorded or WellContext.Well.WellShutIn or WellContext.Well.WorkoverStarted or WellContext.Well.WorkoverCompleted or WellContext.Well.WellAbandoned
  } with {
    briefly "Well event alternation"
    described as {
      |Union of all Well events, for streaming and event-sourced
      |persistence.
    }
  }
  processor WellEventSplit as flow is {
    inlet WellEventSplitIn is type WellEvent
    outlet WellEventSplitToProductionAnalytics is type WellEvent
    handler WellEventSplitHandler is {
      on wellPlanned: event Well.WellPlanned is {
        send wellPlanned to outlet WellEventSplitToProductionAnalytics
        tell wellPlanned to entity WellContext.Well
      }
      on permitSubmitted: event Well.PermitSubmitted is {
        send permitSubmitted to outlet WellEventSplitToProductionAnalytics
        tell permitSubmitted to entity WellContext.Well
      }
      on permitApproved: event Well.PermitApproved is {
        send permitApproved to outlet WellEventSplitToProductionAnalytics
        tell permitApproved to entity WellContext.Well
      }
      on wellSpudded: event Well.WellSpudded is {
        send wellSpudded to outlet WellEventSplitToProductionAnalytics
        tell wellSpudded to entity WellContext.Well
      }
      on drillingProgressUpdated: event Well.DrillingProgressUpdated is {
        send drillingProgressUpdated to outlet WellEventSplitToProductionAnalytics
        tell drillingProgressUpdated to entity WellContext.Well
      }
      on wellCompleted: event Well.WellCompleted is {
        send wellCompleted to outlet WellEventSplitToProductionAnalytics
        tell wellCompleted to entity WellContext.Well
      }
      on wellBroughtOnline: event Well.WellBroughtOnline is {
        send wellBroughtOnline to outlet WellEventSplitToProductionAnalytics
        tell wellBroughtOnline to entity WellContext.Well
      }
      on productionRecorded: event Well.ProductionRecorded is {
        send productionRecorded to outlet WellEventSplitToProductionAnalytics
        tell productionRecorded to entity WellContext.Well
      }
      on wellShutIn: event Well.WellShutIn is {
        send wellShutIn to outlet WellEventSplitToProductionAnalytics
        tell wellShutIn to entity WellContext.Well
      }
      on workoverStarted: event Well.WorkoverStarted is {
        send workoverStarted to outlet WellEventSplitToProductionAnalytics
        tell workoverStarted to entity WellContext.Well
      }
      on workoverCompleted: event Well.WorkoverCompleted is {
        send workoverCompleted to outlet WellEventSplitToProductionAnalytics
        tell workoverCompleted to entity WellContext.Well
      }
      on wellAbandoned: event Well.WellAbandoned is {
        send wellAbandoned to outlet WellEventSplitToProductionAnalytics
        tell wellAbandoned to entity WellContext.Well
      }
      on other is {
        error "Unexpected message for processor WellEventSplit"
      }
    } with {
      briefly "Well event fan-out handler"
      described as {
        |Delivers each Well event to all of its consumers.
      }
    }
  } with {
    briefly "Well event fan-out"
    described as {
      |Fans Well events out to the repository and projectors.
    }
  }
  connector 'WellEvent Stream' is from outlet WellContext.Well.WellEvents2 to inlet WellContext.WellEventSplit.WellEventSplitIn with {
    briefly "Well events, fanned out to storage and read models"
  }
  connector 'ProductionAnalytics Feed' is from outlet WellContext.WellEventSplit.WellEventSplitToProductionAnalytics to inlet WellContext.ProductionAnalytics.ProductionAnalyticsFromWell with {
    briefly "Well events feeding the ProductionAnalytics projection"
  }
  connector 'ProductionAnalytics Storage' is from outlet WellContext.ProductionAnalytics.ProductionAnalyticsToRepository to inlet WellContext.WellRepository.WellRepositoryFromProductionAnalytics with {
    briefly "ProductionAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for well management"
  described as {
    |Oil and gas well lifecycle context.
  }
}
