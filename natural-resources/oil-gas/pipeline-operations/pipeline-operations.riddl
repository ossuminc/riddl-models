// Pipeline Operations Domain Model
// Oil and gas pipeline monitoring, maintenance, and compliance
domain PipelineOperations is {
  persistent connector 'SCADASystemReply Stream' is from outlet SCADASystem.SCADASystemRepliesOut to inlet PipelineContext.ToSCADASystem.ToSCADASystemReplies with {
    briefly "What SCADASystem answers PipelineContext"
  }
  persistent connector 'RegulatoryPortalReply Stream' is from outlet RegulatoryPortal.RegulatoryPortalRepliesOut to inlet PipelineContext.ToRegulatoryPortal.ToRegulatoryPortalReplies with {
    briefly "What RegulatoryPortal answers PipelineContext"
  }
  persistent connector 'RegulatoryPortalEvent Stream' is from outlet RegulatoryPortal.RegulatoryPortalEventsOut to inlet PipelineContext.FromRegulatoryPortal.FromRegulatoryPortalIn with {
    briefly "What RegulatoryPortal tells PipelineContext, unasked"
  }
  persistent connector 'SCADASystemEvent Stream' is from outlet SCADASystem.SCADASystemEventsOut to inlet PipelineContext.FromSCADASystem.FromSCADASystemIn with {
    briefly "What SCADASystem tells PipelineContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user PipelineOperator is "person monitoring pipeline segments" with {
    briefly "Pipeline Operator"
    described as {
      |Operator monitoring pipeline flow and pressure.
    }
  }
  user MaintenanceEngineer is "person scheduling and performing maintenance" with {
    briefly "Maintenance Engineer"
    described as {
      |Engineer responsible for pipeline maintenance.
    }
  }
  user ComplianceOfficer is "person ensuring regulatory compliance" with {
    briefly "Compliance Officer"
    described as {
      |Officer managing regulatory reporting.
    }
  }
  epic PipelineMonitoring is {
    user PipelineOperator wants to "to monitor pipeline segments" so that "flow rates and pressure stay within safe limits"
    case MonitorSegment is {
      user PipelineOperator wants to "to monitor a pipeline segment" so that "anomalies are detected early"
      step is "Operator reviews" "pipeline telemetry" "from SCADA" with {
        briefly "Review telemetry"
        described as {
          |Check pipeline data.
        }
      }
      step is "System detects" "anomalies" "in flow or pressure" with {
        briefly "Detect anomaly"
        described as {
          |Identify issues.
        }
      }
    } with {
      briefly "Monitor pipeline segment"
      described as {
        |Monitoring pipeline segment health.
      }
    }
  } with {
    briefly "Pipeline monitoring"
    described as {
      |Epic for pipeline segment monitoring operations.
    }
  }
  include "PipelineContext.riddl"
  include "external-contexts.riddl"
  application context PipelineOperationsApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PipelineOperations are delivered.
      }
    }
    group PipelineOperationsScreen is {
      input CommissionSegmentInput acquires command PipelineContext.CommissionSegment with {
        briefly "Commission segment control"
        described as {
          |The control through which a user submits the commission segment request.
        }
      }
      input CompleteMaintenanceInput acquires command PipelineContext.PipelineSegment.CompleteMaintenance with {
        briefly "Complete maintenance control"
        described as {
          |The control through which a user submits the complete maintenance request.
        }
      }
      input DecommissionSegmentInput acquires command PipelineContext.PipelineSegment.DecommissionSegment with {
        briefly "Decommission segment control"
        described as {
          |The control through which a user submits the decommission segment request.
        }
      }
      input FileComplianceReportInput acquires command PipelineContext.PipelineSegment.FileComplianceReport with {
        briefly "File compliance report control"
        described as {
          |The control through which a user submits the file compliance report request.
        }
      }
      input RecordInspectionInput acquires command PipelineContext.PipelineSegment.RecordInspection with {
        briefly "Record inspection control"
        described as {
          |The control through which a user submits the record inspection request.
        }
      }
      input RestartSegmentInput acquires command PipelineContext.PipelineSegment.RestartSegment with {
        briefly "Restart segment control"
        described as {
          |The control through which a user submits the restart segment request.
        }
      }
      input ShutDownSegmentInput acquires command PipelineContext.PipelineSegment.ShutDownSegment with {
        briefly "Shut down segment control"
        described as {
          |The control through which a user submits the shut down segment request.
        }
      }
    } with {
      briefly "Pipeline operations screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppPipelineSegmentCommands is type PipelineContext.PipelineSegmentRequest
    inlet AppPipelineRepositoryResponses is result PipelineContext.PipelineSegment.PipelineSegmentResult
    handler PipelineOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context PipelineOperationsApp"
      }
    } with {
      briefly "PipelineOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PipelineOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'SCADASystemRequest Stream' is from outlet PipelineContext.ToSCADASystem.ToSCADASystemOut to inlet SCADASystem.SCADASystemRequests with {
    briefly "What PipelineContext asks SCADASystem to send"
  }
  persistent connector 'RegulatoryPortalRequest Stream' is from outlet PipelineContext.ToRegulatoryPortal.ToRegulatoryPortalOut to inlet RegulatoryPortal.RegulatoryPortalRequests with {
    briefly "What PipelineContext asks RegulatoryPortal to send"
  }
  persistent connector 'PipelineSegmentCommand Stream' is from outlet PipelineOperationsApp.AppPipelineSegmentCommands to inlet PipelineContext.PipelineSegmentCommandStreamIn with {
    briefly "PipelineSegment commands from the application"
  }
  persistent connector 'PipelineResult Stream' is from outlet PipelineContext.PipelineResultStreamOut to inlet PipelineOperationsApp.AppPipelineRepositoryResponses with {
    briefly "Pipeline query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PipelineOperationsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term PressureAnomaly is "An abnormal flow or pressure reading detected on the pipeline."
  briefly "Pipeline operations domain"
  described as {
    |Oil and gas pipeline monitoring, maintenance, and compliance.
  }
}
