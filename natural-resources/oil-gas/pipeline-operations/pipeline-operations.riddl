// Pipeline Operations Domain Model
// Oil and gas pipeline monitoring, maintenance, and compliance
domain PipelineOperations is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user PipelineOperator is "person monitoring pipeline segments" with {
    briefly "Pipeline Operator"
    described as {
      |Operator monitoring pipeline flow and pressure.
    }
  }
  user MaintenanceEngineer is "person scheduling and performing maintenance" with {
    briefly "Maintenance Engineer"
    described as {
      |Engineer responsible for pipeline maintenance.
    }
  }
  user ComplianceOfficer is "person ensuring regulatory compliance" with {
    briefly "Compliance Officer"
    described as {
      |Officer managing regulatory reporting.
    }
  }
  epic PipelineMonitoring is {
    user PipelineOperator wants to "to monitor pipeline segments" so that "flow rates and pressure stay within safe limits"
    case MonitorSegment is {
      user PipelineOperator wants to "to monitor a pipeline segment" so that "anomalies are detected early"
      step is "Operator reviews" "pipeline telemetry" "from SCADA" with {
        briefly "Review telemetry"
        described as {
          |Check pipeline data.
        }
      }
      step is "System detects" "anomalies" "in flow or pressure" with {
        briefly "Detect anomaly"
        described as {
          |Identify issues.
        }
      }
    } with {
      briefly "Monitor pipeline segment"
      described as {
        |Monitoring pipeline segment health.
      }
    }
  } with {
    briefly "Pipeline monitoring"
    described as {
      |Epic for pipeline segment monitoring operations.
    }
  }
  include "PipelineContext.riddl"
  include "external-contexts.riddl"
  application context PipelineOperationsApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PipelineOperations are delivered.
      }
    }
    outlet AppPipelineSegmentCommands is type PipelineContext.PipelineSegment.PipelineSegmentCommand
    inlet AppPipelineRepositoryResponses is result PipelineContext.PipelineSegment.PipelineSegmentResult    handler PipelineOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context PipelineOperationsApp"
      }
    } with {
      briefly "PipelineOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PipelineOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'PipelineSegmentCommand Stream' is from outlet PipelineOperationsApp.AppPipelineSegmentCommands to inlet PipelineContext.PipelineSegmentCommandStreamIn with {
    briefly "PipelineSegment commands from the application"
  }
  persistent connector 'PipelineResult Stream' is from outlet PipelineContext.PipelineResultStreamOut to inlet PipelineOperationsApp.AppPipelineRepositoryResponses with {
    briefly "Pipeline query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PipelineOperationsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term PressureAnomaly is "An abnormal flow or pressure reading detected on the pipeline."
  briefly "Pipeline operations domain"
  described as {
    |Oil and gas pipeline monitoring, maintenance, and compliance.
  }
}
