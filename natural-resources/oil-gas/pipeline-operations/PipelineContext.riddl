// Pipeline Operations - Pipeline Context
context PipelineContext is {
  adaptor FromRegulatoryPortal from context RegulatoryPortal is {
    handler FromRegulatoryPortalHandler is {
      on result RegulatoryPortal.ComplianceStatus is {
        do "the model receives compliance status"
      }
      on event RegulatoryPortal.FilingSubmitted is {
        do "the model receives filing submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryPortal"
      }
    } with {
      briefly "from regulatory portal"
      described as {
        |Carries messages from the external RegulatoryPortal.
      }
    }
  } with {
      briefly "RegulatoryPortal integration"
    described as {
      |The model's side of the RegulatoryPortal conversation.
    }
  }
  adaptor ToRegulatoryPortal to context RegulatoryPortal is {
    handler ToRegulatoryPortalHandler is {
      on query RegulatoryPortal.GetComplianceStatus is {
        do "the model sends get compliance status"
      }
      on command RegulatoryPortal.SubmitComplianceFiling is {
        do "the model sends submit compliance filing"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryPortal"
      }
    } with {
      briefly "to regulatory portal"
      described as {
        |Carries messages to the external RegulatoryPortal.
      }
    }
  } with {
      briefly "RegulatoryPortal integration"
    described as {
      |The model's side of the RegulatoryPortal conversation.
    }
  }
  adaptor FromSCADASystem from context SCADASystem is {
    handler FromSCADASystemHandler is {
      on event SCADASystem.ControlSignalSent is {
        do "the model receives control signal sent"
      }
      on result SCADASystem.LiveReadings is {
        do "the model receives live readings"
      }
      on other is {
        error "Unexpected message for adaptor FromSCADASystem"
      }
    } with {
      briefly "from scada system"
      described as {
        |Carries messages from the external SCADASystem.
      }
    }
  } with {
      briefly "SCADASystem integration"
    described as {
      |The model's side of the SCADASystem conversation.
    }
  }
  adaptor ToSCADASystem to context SCADASystem is {
    handler ToSCADASystemHandler is {
      on query SCADASystem.GetLiveReadings is {
        do "the model sends get live readings"
      }
      on command SCADASystem.SendControlSignal is {
        do "the model sends send control signal"
      }
      on other is {
        error "Unexpected message for adaptor ToSCADASystem"
      }
    } with {
      briefly "to scada system"
      described as {
        |Carries messages to the external SCADASystem.
      }
    }
  } with {
      briefly "SCADASystem integration"
    described as {
      |The model's side of the SCADASystem conversation.
    }
  }
  include "types.riddl"
  include "PipelineSegment.riddl"
  repository PipelineRepository is {
    inlet PipelineRepositoryFromPipelineSegment is type PipelineSegmentEvent
    inlet PipelineRepositoryFromPipelineMetrics is type PipelineSegmentEvent
    outlet PipelineRepositoryResponses is type PipelineSegment.PipelineSegmentResult
    schema PipelineData is relational
      of pipelineSegments as type PipelineSegment
        index on field PipelineSegment.segmentId
        index on field PipelineSegment.segmentInfo.pipelineId
        index on field PipelineSegment.status
      with {
      briefly "Pipeline data schema"
      described as {
        |The relational schema holding pipeline data for the PipelineRepository.
      }
    }

    handler PipelinePersistence is {
      on command PipelineSegment.CommissionSegment is {
        do "Store new pipeline segment"
      }
      on command PipelineSegment.RecordFlowReading is {
        tell event PipelineSegment.FlowReadingRecorded to entity PipelineContext.PipelineSegment
        do "Update latest flow reading"
      }
      on command PipelineSegment.ReportLeakIndicator is {
        do "Store leak indicator"
      }
      on command PipelineSegment.CompleteMaintenance is {
        tell event PipelineSegment.MaintenanceCompleted to entity PipelineContext.PipelineSegment
        do "Update maintenance record"
      }
      on command PipelineSegment.RecordInspection is {
        tell event PipelineSegment.InspectionRecorded to entity PipelineContext.PipelineSegment
        do "Store inspection report"
      }
      on command PipelineSegment.ShutDownSegment is {
        tell event PipelineSegment.SegmentShutDown to entity PipelineContext.PipelineSegment
        do "Update segment to shut down"
      }
    } with {
      briefly "Persists pipeline commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Pipeline data persistence"
    described as {
      |Persistent storage for pipeline operations.
    }
  }
  projector PipelineMetrics is {
    inlet PipelineMetricsFromPipelineSegment is type PipelineSegmentEvent
    outlet PipelineMetricsOut is type PipelineSegmentEvent
    updates repository PipelineContext.PipelineRepository
    record OperationsMetrics is  {
      segmentsOperational: Natural with {
        briefly "Operational"
        described as {
          |Operational segments.
        }
      }
      segmentsUnderMaintenance: Natural with {
        briefly "Maintenance"
        described as {
          |Segments under maintenance.
        }
      }
      leakAlertsActive: Natural with {
        briefly "Leak alerts"
        described as {
          |Active leak alerts.
        }
      }
      inspectionsCompleted: Natural with {
        briefly "Inspections"
        described as {
          |Inspections completed.
        }
      }
      averageFlowRate: Decimal(12,3) with {
        briefly "Avg flow"
        described as {
          |Average flow rate.
        }
      }
    } with {
      briefly "Operations metrics"
      described as {
        |Pipeline operations metrics.
      }
    }
    handler MetricsHandler is {
      on event PipelineSegment.SegmentCommissioned is {
        tell event PipelineSegment.SegmentCommissioned to repository PipelineContext.PipelineRepository
        do "Increment operational segments"
      }
      on event PipelineSegment.LeakIndicatorReported is {
        tell event PipelineSegment.LeakIndicatorReported to repository PipelineContext.PipelineRepository
        do "Increment active leak alerts"
      }
      on event PipelineSegment.InspectionRecorded is {
        tell event PipelineSegment.InspectionRecorded to repository PipelineContext.PipelineRepository
        do "Increment inspections completed"
      }
      on event PipelineSegment.SegmentShutDown is {
        tell event PipelineSegment.SegmentShutDown to repository PipelineContext.PipelineRepository
        do "Decrement operational segments"
      }
    } with {
      briefly "Maintains pipeline metrics"
      described as {
        |Projects events into operations metrics.
      }
    }
  } with {
    briefly "Pipeline metrics"
    described as {
      |Pipeline operations analytics.
    }
  }
  // ---- Event publication for PipelineSegment ----
  type PipelineSegmentEvent is one of {
    PipelineContext.PipelineSegment.SegmentCommissioned,
    PipelineContext.PipelineSegment.FlowReadingRecorded,
    PipelineContext.PipelineSegment.LeakIndicatorReported,
    PipelineContext.PipelineSegment.MaintenanceScheduled,
    PipelineContext.PipelineSegment.MaintenanceCompleted,
    PipelineContext.PipelineSegment.InspectionRecorded,
    PipelineContext.PipelineSegment.ComplianceReportFiled,
    PipelineContext.PipelineSegment.SegmentShutDown,
    PipelineContext.PipelineSegment.SegmentRestarted,
    PipelineContext.PipelineSegment.SegmentDecommissioned
  } with {
    briefly "PipelineSegment event alternation"
    described as {
      |Union of all PipelineSegment events, for streaming and event-sourced
      |persistence.
    }
  }
  processor PipelineSegmentEventSource as source is {
    outlet PipelineSegmentEvents is type PipelineSegmentEvent
    handler PipelineSegmentSourceHandler is {
      on event PipelineSegment.SegmentCommissioned is {
        send event PipelineSegment.SegmentCommissioned to outlet PipelineSegmentEvents
      }
      on event PipelineSegment.FlowReadingRecorded is {
        send event PipelineSegment.FlowReadingRecorded to outlet PipelineSegmentEvents
      }
      on event PipelineSegment.LeakIndicatorReported is {
        send event PipelineSegment.LeakIndicatorReported to outlet PipelineSegmentEvents
      }
      on event PipelineSegment.MaintenanceScheduled is {
        send event PipelineSegment.MaintenanceScheduled to outlet PipelineSegmentEvents
      }
      on event PipelineSegment.MaintenanceCompleted is {
        send event PipelineSegment.MaintenanceCompleted to outlet PipelineSegmentEvents
      }
      on event PipelineSegment.InspectionRecorded is {
        send event PipelineSegment.InspectionRecorded to outlet PipelineSegmentEvents
      }
      on event PipelineSegment.ComplianceReportFiled is {
        send event PipelineSegment.ComplianceReportFiled to outlet PipelineSegmentEvents
      }
      on event PipelineSegment.SegmentShutDown is {
        send event PipelineSegment.SegmentShutDown to outlet PipelineSegmentEvents
      }
      on event PipelineSegment.SegmentRestarted is {
        send event PipelineSegment.SegmentRestarted to outlet PipelineSegmentEvents
      }
      on event PipelineSegment.SegmentDecommissioned is {
        send event PipelineSegment.SegmentDecommissioned to outlet PipelineSegmentEvents
      }
      on other is {
        error "Unexpected message for source PipelineSegmentEventSource"
      }
    } with {
      briefly "PipelineSegment source handler"
      described as {
        |Publishes PipelineSegment events onto the outlet.
      }
    }
  } with {
    briefly "PipelineSegment event source"
    described as {
      |Publishes PipelineSegment entity events into the streaming topology.
    }
  }
  processor PipelineSegmentEventSink as sink is {
    inlet PipelineSegmentInlet is type PipelineSegmentEvent
    handler PipelineSegmentSinkHandler is {
      on event PipelineSegment.SegmentCommissioned is {
        tell event PipelineSegment.SegmentCommissioned to repository PipelineContext.PipelineRepository
      }
      on event PipelineSegment.FlowReadingRecorded is {
        tell event PipelineSegment.FlowReadingRecorded to repository PipelineContext.PipelineRepository
      }
      on event PipelineSegment.LeakIndicatorReported is {
        tell event PipelineSegment.LeakIndicatorReported to repository PipelineContext.PipelineRepository
      }
      on event PipelineSegment.MaintenanceScheduled is {
        tell event PipelineSegment.MaintenanceScheduled to repository PipelineContext.PipelineRepository
      }
      on event PipelineSegment.MaintenanceCompleted is {
        tell event PipelineSegment.MaintenanceCompleted to repository PipelineContext.PipelineRepository
      }
      on event PipelineSegment.InspectionRecorded is {
        tell event PipelineSegment.InspectionRecorded to repository PipelineContext.PipelineRepository
      }
      on event PipelineSegment.ComplianceReportFiled is {
        tell event PipelineSegment.ComplianceReportFiled to repository PipelineContext.PipelineRepository
      }
      on event PipelineSegment.SegmentShutDown is {
        tell event PipelineSegment.SegmentShutDown to repository PipelineContext.PipelineRepository
      }
      on event PipelineSegment.SegmentRestarted is {
        tell event PipelineSegment.SegmentRestarted to repository PipelineContext.PipelineRepository
      }
      on event PipelineSegment.SegmentDecommissioned is {
        tell event PipelineSegment.SegmentDecommissioned to repository PipelineContext.PipelineRepository
      }
      on other is {
        error "Unexpected message for sink PipelineSegmentEventSink"
      }
    } with {
      briefly "PipelineSegment sink handler"
      described as {
        |Persists PipelineSegment events via the repository.
      }
    }
  } with {
    briefly "PipelineSegment event sink"
    described as {
      |Receives PipelineSegment events for persistence.
    }
  }
  connector PipelineSegmentEventFlow is {
    from outlet PipelineContext.PipelineSegmentEventSource.PipelineSegmentEvents to
      inlet PipelineContext.PipelineSegmentEventSink.PipelineSegmentInlet
  } with {
    briefly "PipelineSegment event flow"
    described as {
      |Connects the PipelineSegment source to its sink.
    }
  }
  processor PipelineSegmentEventSplit is {
    inlet PipelineSegmentEventSplitIn is type PipelineSegmentEvent
    outlet PipelineSegmentEventSplitToPipelineRepository is type PipelineSegmentEvent
    outlet PipelineSegmentEventSplitToPipelineMetrics is type PipelineSegmentEvent
    handler PipelineSegmentEventSplitHandler is {
      on event PipelineSegment.SegmentCommissioned is {
        send event PipelineSegment.SegmentCommissioned to outlet PipelineSegmentEventSplitToPipelineRepository
        send event PipelineSegment.SegmentCommissioned to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell event PipelineSegment.SegmentCommissioned to entity PipelineContext.PipelineSegment
      }
      on event PipelineSegment.FlowReadingRecorded is {
        send event PipelineSegment.FlowReadingRecorded to outlet PipelineSegmentEventSplitToPipelineRepository
        send event PipelineSegment.FlowReadingRecorded to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell event PipelineSegment.FlowReadingRecorded to entity PipelineContext.PipelineSegment
      }
      on event PipelineSegment.LeakIndicatorReported is {
        send event PipelineSegment.LeakIndicatorReported to outlet PipelineSegmentEventSplitToPipelineRepository
        send event PipelineSegment.LeakIndicatorReported to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell event PipelineSegment.LeakIndicatorReported to entity PipelineContext.PipelineSegment
      }
      on event PipelineSegment.MaintenanceScheduled is {
        send event PipelineSegment.MaintenanceScheduled to outlet PipelineSegmentEventSplitToPipelineRepository
        send event PipelineSegment.MaintenanceScheduled to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell event PipelineSegment.MaintenanceScheduled to entity PipelineContext.PipelineSegment
      }
      on event PipelineSegment.MaintenanceCompleted is {
        send event PipelineSegment.MaintenanceCompleted to outlet PipelineSegmentEventSplitToPipelineRepository
        send event PipelineSegment.MaintenanceCompleted to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell event PipelineSegment.MaintenanceCompleted to entity PipelineContext.PipelineSegment
      }
      on event PipelineSegment.InspectionRecorded is {
        send event PipelineSegment.InspectionRecorded to outlet PipelineSegmentEventSplitToPipelineRepository
        send event PipelineSegment.InspectionRecorded to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell event PipelineSegment.InspectionRecorded to entity PipelineContext.PipelineSegment
      }
      on event PipelineSegment.ComplianceReportFiled is {
        send event PipelineSegment.ComplianceReportFiled to outlet PipelineSegmentEventSplitToPipelineRepository
        send event PipelineSegment.ComplianceReportFiled to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell event PipelineSegment.ComplianceReportFiled to entity PipelineContext.PipelineSegment
      }
      on event PipelineSegment.SegmentShutDown is {
        send event PipelineSegment.SegmentShutDown to outlet PipelineSegmentEventSplitToPipelineRepository
        send event PipelineSegment.SegmentShutDown to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell event PipelineSegment.SegmentShutDown to entity PipelineContext.PipelineSegment
      }
      on event PipelineSegment.SegmentRestarted is {
        send event PipelineSegment.SegmentRestarted to outlet PipelineSegmentEventSplitToPipelineRepository
        send event PipelineSegment.SegmentRestarted to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell event PipelineSegment.SegmentRestarted to entity PipelineContext.PipelineSegment
      }
      on event PipelineSegment.SegmentDecommissioned is {
        send event PipelineSegment.SegmentDecommissioned to outlet PipelineSegmentEventSplitToPipelineRepository
        send event PipelineSegment.SegmentDecommissioned to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell event PipelineSegment.SegmentDecommissioned to entity PipelineContext.PipelineSegment
      }
      on other is {
        error "Unexpected message for processor PipelineSegmentEventSplit"
      }
    } with {
      briefly "PipelineSegment event fan-out handler"
      described as {
        |Delivers each PipelineSegment event to all of its consumers.
      }
    }
  } with {
    briefly "PipelineSegment event fan-out"
    described as {
      |Fans PipelineSegment events out to the repository and projectors.
    }
  }
  connector LinkPipelineSegmentToPipelineSegmentEventSplit is {
    from outlet PipelineContext.PipelineSegment.PipelineSegmentEvents2 to
      inlet PipelineContext.PipelineSegmentEventSplit.PipelineSegmentEventSplitIn
  } with {
    briefly "LinkPipelineSegmentToPipelineSegmentEventSplit"
  }
  connector LinkPipelineSegmentEventSplitToPipelineRepository is {
    from outlet PipelineContext.PipelineSegmentEventSplit.PipelineSegmentEventSplitToPipelineRepository to
      inlet PipelineContext.PipelineRepository.PipelineRepositoryFromPipelineSegment
  } with {
    briefly "LinkPipelineSegmentEventSplitToPipelineRepository"
  }
  connector LinkPipelineSegmentEventSplitToPipelineMetrics is {
    from outlet PipelineContext.PipelineSegmentEventSplit.PipelineSegmentEventSplitToPipelineMetrics to
      inlet PipelineContext.PipelineMetrics.PipelineMetricsFromPipelineSegment
  } with {
    briefly "LinkPipelineSegmentEventSplitToPipelineMetrics"
  }
  connector LinkPipelineMetricsToPipelineRepository is {
    from outlet PipelineContext.PipelineMetrics.PipelineMetricsOut to
      inlet PipelineContext.PipelineRepository.PipelineRepositoryFromPipelineMetrics
  } with {
    briefly "LinkPipelineMetricsToPipelineRepository"
  }
} with {
  briefly "Bounded context for pipeline operations"
  described as {
    |Oil and gas pipeline operations context.
  }
}
