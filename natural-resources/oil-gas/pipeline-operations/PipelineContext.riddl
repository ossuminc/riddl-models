// Pipeline Operations - Pipeline Context
context PipelineContext as router is {
  inlet PipelineSegmentCommandStreamIn is type PipelineSegmentCommand  outlet PipelineSegmentCommandStreamOut is type PipelineSegmentCommand
  inlet PipelineResultStreamIn is type PipelineSegment.PipelineSegmentResult  outlet PipelineResultStreamOut is type PipelineSegment.PipelineSegmentResult
  handler PipelineContextBoundary is {
    on commissionSegment: command PipelineSegment.CommissionSegment is {
      send commissionSegment to outlet PipelineContext.PipelineSegmentCommandStreamOut
    }
    on recordFlowReading: command PipelineSegment.RecordFlowReading is {
      send recordFlowReading to outlet PipelineContext.PipelineSegmentCommandStreamOut
    }
    on reportLeakIndicator: command PipelineSegment.ReportLeakIndicator is {
      send reportLeakIndicator to outlet PipelineContext.PipelineSegmentCommandStreamOut
    }
    on scheduleMaintenance: command PipelineSegment.ScheduleMaintenance is {
      send scheduleMaintenance to outlet PipelineContext.PipelineSegmentCommandStreamOut
    }
    on completeMaintenance: command PipelineSegment.CompleteMaintenance is {
      send completeMaintenance to outlet PipelineContext.PipelineSegmentCommandStreamOut
    }
    on recordInspection: command PipelineSegment.RecordInspection is {
      send recordInspection to outlet PipelineContext.PipelineSegmentCommandStreamOut
    }
    on fileComplianceReport: command PipelineSegment.FileComplianceReport is {
      send fileComplianceReport to outlet PipelineContext.PipelineSegmentCommandStreamOut
    }
    on shutDownSegment: command PipelineSegment.ShutDownSegment is {
      send shutDownSegment to outlet PipelineContext.PipelineSegmentCommandStreamOut
    }
    on restartSegment: command PipelineSegment.RestartSegment is {
      send restartSegment to outlet PipelineContext.PipelineSegmentCommandStreamOut
    }
    on decommissionSegment: command PipelineSegment.DecommissionSegment is {
      send decommissionSegment to outlet PipelineContext.PipelineSegmentCommandStreamOut
    }
    on pipelineSegmentResult: result PipelineSegment.PipelineSegmentResult is {
      send pipelineSegmentResult to outlet PipelineContext.PipelineResultStreamOut
    }
    on other is {
      error "Unexpected message at the PipelineContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PipelineSegmentCommand Stream Intake' is from outlet PipelineContext.PipelineSegmentCommandStreamOut to inlet PipelineContext.PipelineSegment.PipelineSegmentCommands  connector 'PipelineResult Stream Egress' is from outlet PipelineContext.PipelineRepository.PipelineRepositoryResponses to inlet PipelineContext.PipelineResultStreamIn  adaptor FromRegulatoryPortal from context RegulatoryPortal is { 
    handler FromRegulatoryPortalHandler is {
      on result RegulatoryPortal.ComplianceStatus is {
        do "the model receives compliance status"
      }
      on event RegulatoryPortal.FilingSubmitted is {
        do "the model receives filing submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromRegulatoryPortal"
      }
    } with {
      briefly "from regulatory portal"
      described as {
        |Carries messages from the external RegulatoryPortal.
      }
    }
  } with {
    briefly "RegulatoryPortal integration"
    described as {
      |The model's side of the RegulatoryPortal conversation.
    }
  }
  adaptor ToRegulatoryPortal to context RegulatoryPortal is { 
    handler ToRegulatoryPortalHandler is {
      on query RegulatoryPortal.GetComplianceStatus is {
        do "the model sends get compliance status"
      }
      on command RegulatoryPortal.SubmitComplianceFiling is {
        do "the model sends submit compliance filing"
      }
      on other is {
        error "Unexpected message for adaptor ToRegulatoryPortal"
      }
    } with {
      briefly "to regulatory portal"
      described as {
        |Carries messages to the external RegulatoryPortal.
      }
    }
  } with {
    briefly "RegulatoryPortal integration"
    described as {
      |The model's side of the RegulatoryPortal conversation.
    }
  }
  adaptor FromSCADASystem from context SCADASystem is { 
    handler FromSCADASystemHandler is {
      on event SCADASystem.ControlSignalSent is {
        do "the model receives control signal sent"
      }
      on result SCADASystem.LiveReadings is {
        do "the model receives live readings"
      }
      on other is {
        error "Unexpected message for adaptor FromSCADASystem"
      }
    } with {
      briefly "from scada system"
      described as {
        |Carries messages from the external SCADASystem.
      }
    }
  } with {
    briefly "SCADASystem integration"
    described as {
      |The model's side of the SCADASystem conversation.
    }
  }
  adaptor ToSCADASystem to context SCADASystem is { 
    handler ToSCADASystemHandler is {
      on query SCADASystem.GetLiveReadings is {
        do "the model sends get live readings"
      }
      on command SCADASystem.SendControlSignal is {
        do "the model sends send control signal"
      }
      on other is {
        error "Unexpected message for adaptor ToSCADASystem"
      }
    } with {
      briefly "to scada system"
      described as {
        |Carries messages to the external SCADASystem.
      }
    }
  } with {
    briefly "SCADASystem integration"
    described as {
      |The model's side of the SCADASystem conversation.
    }
  }
  include "types.riddl"
  include "PipelineSegment.riddl"
  repository PipelineRepository as merge is {
    command PersistInspectionRecorded is  {
      segmentId: SegmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row InspectionRecorded applies to.
        }
      }
    } with {
      briefly "Persist InspectionRecorded"
      described as {
        |Instructs this repository to apply InspectionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLeakIndicatorReported is  {
      segmentId: SegmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row LeakIndicatorReported applies to.
        }
      }
    } with {
      briefly "Persist LeakIndicatorReported"
      described as {
        |Instructs this repository to apply LeakIndicatorReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSegmentCommissioned is  {
      segmentId: SegmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row SegmentCommissioned applies to.
        }
      }
    } with {
      briefly "Persist SegmentCommissioned"
      described as {
        |Instructs this repository to apply SegmentCommissioned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSegmentShutDown is  {
      segmentId: SegmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row SegmentShutDown applies to.
        }
      }
    } with {
      briefly "Persist SegmentShutDown"
      described as {
        |Instructs this repository to apply SegmentShutDown to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet PipelineRepositoryFromPipelineSegment is type PipelineSegmentEvent    inlet PipelineRepositoryFromPipelineMetrics is type PipelineSegmentEvent    outlet PipelineRepositoryResponses is type PipelineSegment.PipelineSegmentResult
    record StoredPipelineSegment is  {
      pipelineSegmentId: UUID with {
        briefly "pipelineSegmentId"
        described as {
          |The pipelineSegmentId column of the stored pipelineSegment row.
        }
      }
      segmentId: SegmentId with {
        briefly "segmentId"
        described as {
          |The segmentId column of the stored pipelineSegment row.
        }
      }
      segmentInfo: SegmentInfo with {
        briefly "segmentInfo"
        described as {
          |The segmentInfo column of the stored pipelineSegment row.
        }
      }
      status: SegmentStatus with {
        briefly "status"
        described as {
          |The status column of the stored pipelineSegment row.
        }
      }
    } with {
      briefly "Stored pipelineSegment row"
      described as {
        |The persistence shape of pipelineSegment data as this repository stores it.
      }
    }
    schema PipelineData is relational
      of pipelineSegments as type StoredPipelineSegment
        index on field StoredPipelineSegment.segmentId
        index on field StoredPipelineSegment.segmentInfo.pipelineId
        index on field StoredPipelineSegment.status
 with {
      briefly "Pipeline data schema"
      described as {
        |The relational schema holding pipeline data for the PipelineRepository.
      }
    }
    handler PipelinePersistence is {
      on persistInspectionRecorded: command PersistInspectionRecorded is {
        do "apply InspectionRecorded to the stored row"
      }
      on persistLeakIndicatorReported: command PersistLeakIndicatorReported is {
        do "apply LeakIndicatorReported to the stored row"
      }
      on persistSegmentCommissioned: command PersistSegmentCommissioned is {
        do "apply SegmentCommissioned to the stored row"
      }
      on persistSegmentShutDown: command PersistSegmentShutDown is {
        do "apply SegmentShutDown to the stored row"
      }
      on query GetOperationsMetrics is {
        let operationsMetricsView: type OperationsMetricsView = prompt("read the operations metrics projection")
        reply operationsMetricsView
      }
      on command PipelineSegment.CommissionSegment is {
        do "Store new pipeline segment"
      }
      on recordFlowReading: command PipelineSegment.RecordFlowReading is {
        tell event PipelineSegment.FlowReadingRecorded(segmentId = recordFlowReading.segmentId, reading = recordFlowReading.reading) to entity PipelineContext.PipelineSegment
        do "Update latest flow reading"
      }
      on command PipelineSegment.ReportLeakIndicator is {
        do "Store leak indicator"
      }
      on completeMaintenance: command PipelineSegment.CompleteMaintenance is {
        tell event PipelineSegment.MaintenanceCompleted(segmentId = completeMaintenance.segmentId, workOrderId = completeMaintenance.workOrderId, completedAt = completeMaintenance.completedAt) to entity PipelineContext.PipelineSegment
        do "Update maintenance record"
      }
      on recordInspection: command PipelineSegment.RecordInspection is {
        tell event PipelineSegment.InspectionRecorded(segmentId = recordInspection.segmentId, report = recordInspection.report) to entity PipelineContext.PipelineSegment
        do "Store inspection report"
      }
      on shutDownSegment: command PipelineSegment.ShutDownSegment is {
        tell event PipelineSegment.SegmentShutDown(segmentId = shutDownSegment.segmentId, reason = shutDownSegment.reason) to entity PipelineContext.PipelineSegment
        do "Update segment to shut down"
      }
    } with {
      briefly "Persists pipeline commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Pipeline data persistence"
    described as {
      |Persistent storage for pipeline operations.
    }
  }
  query GetOperationsMetrics is  {
    operationsMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which operations metrics to retrieve.
      }
    }
  } with {
    briefly "Get operations metrics"
    described as {
      |Retrieves the operations metrics projection.
    }
  }
  result OperationsMetricsView is  {
    operationsMetrics: PipelineMetrics.OperationsMetrics with {
      briefly "Operations metrics"
      described as {
        |The operations metrics being returned.
      }
    }
  } with {
    briefly "Operations metrics view"
    described as {
      |Read model view carrying the operations metrics projection.
    }
  }
  projector PipelineMetrics as flow is {
    updates repository PipelineContext.PipelineRepository
    inlet PipelineMetricsFromPipelineSegment is type PipelineSegmentEvent    outlet PipelineMetricsOut is type PipelineSegmentEvent
    record OperationsMetrics is  {
      segmentsOperational: Natural with {
        briefly "Operational"
        described as {
          |Operational segments.
        }
      }
      segmentsUnderMaintenance: Natural with {
        briefly "Maintenance"
        described as {
          |Segments under maintenance.
        }
      }
      leakAlertsActive: Natural with {
        briefly "Leak alerts"
        described as {
          |Active leak alerts.
        }
      }
      inspectionsCompleted: Natural with {
        briefly "Inspections"
        described as {
          |Inspections completed.
        }
      }
      averageFlowRate: Decimal(12,3) with {
        briefly "Avg flow"
        described as {
          |Average flow rate.
        }
      }
    } with {
      briefly "Operations metrics"
      described as {
        |Pipeline operations metrics.
      }
    }
    handler MetricsHandler is {
      on segmentCommissioned: event PipelineSegment.SegmentCommissioned is {
        tell command PipelineContext.PipelineRepository.PersistSegmentCommissioned(segmentId = segmentCommissioned.segmentId) to repository PipelineContext.PipelineRepository
        do "Increment operational segments"
      }
      on leakIndicatorReported: event PipelineSegment.LeakIndicatorReported is {
        tell command PipelineContext.PipelineRepository.PersistLeakIndicatorReported(segmentId = leakIndicatorReported.segmentId) to repository PipelineContext.PipelineRepository
        do "Increment active leak alerts"
      }
      on inspectionRecorded: event PipelineSegment.InspectionRecorded is {
        tell command PipelineContext.PipelineRepository.PersistInspectionRecorded(segmentId = inspectionRecorded.segmentId) to repository PipelineContext.PipelineRepository
        do "Increment inspections completed"
      }
      on segmentShutDown: event PipelineSegment.SegmentShutDown is {
        tell command PipelineContext.PipelineRepository.PersistSegmentShutDown(segmentId = segmentShutDown.segmentId) to repository PipelineContext.PipelineRepository
        do "Decrement operational segments"
      }
    } with {
      briefly "Maintains pipeline metrics"
      described as {
        |Projects events into operations metrics.
      }
    }
  } with {
    briefly "Pipeline metrics"
    described as {
      |Pipeline operations analytics.
    }
  }
  // ---- Event publication for PipelineSegment ----
  type PipelineSegmentEvent is one of {
    PipelineContext.PipelineSegment.SegmentCommissioned or PipelineContext.PipelineSegment.FlowReadingRecorded or PipelineContext.PipelineSegment.LeakIndicatorReported or PipelineContext.PipelineSegment.MaintenanceScheduled or PipelineContext.PipelineSegment.MaintenanceCompleted or PipelineContext.PipelineSegment.InspectionRecorded or PipelineContext.PipelineSegment.ComplianceReportFiled or PipelineContext.PipelineSegment.SegmentShutDown or PipelineContext.PipelineSegment.SegmentRestarted or PipelineContext.PipelineSegment.SegmentDecommissioned
  } with {
    briefly "PipelineSegment event alternation"
    described as {
      |Union of all PipelineSegment events, for streaming and event-sourced
      |persistence.
    }
  }
  processor PipelineSegmentEventSource as source is {
    outlet PipelineSegmentEvents is type PipelineSegmentEvent
    handler PipelineSegmentSourceHandler is {
      on segmentCommissioned: event PipelineSegment.SegmentCommissioned is {
        send segmentCommissioned to outlet PipelineSegmentEvents
      }
      on flowReadingRecorded: event PipelineSegment.FlowReadingRecorded is {
        send flowReadingRecorded to outlet PipelineSegmentEvents
      }
      on leakIndicatorReported: event PipelineSegment.LeakIndicatorReported is {
        send leakIndicatorReported to outlet PipelineSegmentEvents
      }
      on maintenanceScheduled: event PipelineSegment.MaintenanceScheduled is {
        send maintenanceScheduled to outlet PipelineSegmentEvents
      }
      on maintenanceCompleted: event PipelineSegment.MaintenanceCompleted is {
        send maintenanceCompleted to outlet PipelineSegmentEvents
      }
      on inspectionRecorded: event PipelineSegment.InspectionRecorded is {
        send inspectionRecorded to outlet PipelineSegmentEvents
      }
      on complianceReportFiled: event PipelineSegment.ComplianceReportFiled is {
        send complianceReportFiled to outlet PipelineSegmentEvents
      }
      on segmentShutDown: event PipelineSegment.SegmentShutDown is {
        send segmentShutDown to outlet PipelineSegmentEvents
      }
      on segmentRestarted: event PipelineSegment.SegmentRestarted is {
        send segmentRestarted to outlet PipelineSegmentEvents
      }
      on segmentDecommissioned: event PipelineSegment.SegmentDecommissioned is {
        send segmentDecommissioned to outlet PipelineSegmentEvents
      }
      on other is {
        error "Unexpected message for source PipelineSegmentEventSource"
      }
    } with {
      briefly "PipelineSegment source handler"
      described as {
        |Publishes PipelineSegment events onto the outlet.
      }
    }
  } with {
    briefly "PipelineSegment event source"
    described as {
      |Publishes PipelineSegment entity events into the streaming topology.
    }
  }
  processor PipelineSegmentEventSink as sink is {
    inlet PipelineSegmentInlet is type PipelineSegmentEvent    handler PipelineSegmentSinkHandler is {
      on segmentCommissioned: event PipelineSegment.SegmentCommissioned is {
        tell segmentCommissioned to repository PipelineContext.PipelineRepository
      }
      on flowReadingRecorded: event PipelineSegment.FlowReadingRecorded is {
        tell flowReadingRecorded to repository PipelineContext.PipelineRepository
      }
      on leakIndicatorReported: event PipelineSegment.LeakIndicatorReported is {
        tell leakIndicatorReported to repository PipelineContext.PipelineRepository
      }
      on maintenanceScheduled: event PipelineSegment.MaintenanceScheduled is {
        tell maintenanceScheduled to repository PipelineContext.PipelineRepository
      }
      on maintenanceCompleted: event PipelineSegment.MaintenanceCompleted is {
        tell maintenanceCompleted to repository PipelineContext.PipelineRepository
      }
      on inspectionRecorded: event PipelineSegment.InspectionRecorded is {
        tell inspectionRecorded to repository PipelineContext.PipelineRepository
      }
      on complianceReportFiled: event PipelineSegment.ComplianceReportFiled is {
        tell complianceReportFiled to repository PipelineContext.PipelineRepository
      }
      on segmentShutDown: event PipelineSegment.SegmentShutDown is {
        tell segmentShutDown to repository PipelineContext.PipelineRepository
      }
      on segmentRestarted: event PipelineSegment.SegmentRestarted is {
        tell segmentRestarted to repository PipelineContext.PipelineRepository
      }
      on segmentDecommissioned: event PipelineSegment.SegmentDecommissioned is {
        tell segmentDecommissioned to repository PipelineContext.PipelineRepository
      }
      on other is {
        error "Unexpected message for sink PipelineSegmentEventSink"
      }
    } with {
      briefly "PipelineSegment sink handler"
      described as {
        |Persists PipelineSegment events via the repository.
      }
    }
  } with {
    briefly "PipelineSegment event sink"
    described as {
      |Receives PipelineSegment events for persistence.
    }
  }
  connector PipelineSegmentEventFlow is from outlet PipelineContext.PipelineSegmentEventSource.PipelineSegmentEvents to inlet PipelineContext.PipelineSegmentEventSink.PipelineSegmentInlet with {
    briefly "PipelineSegment event flow"
    described as {
      |Connects the PipelineSegment source to its sink.
    }
  }
  processor PipelineSegmentEventSplit as split is {
    inlet PipelineSegmentEventSplitIn is type PipelineSegmentEvent    outlet PipelineSegmentEventSplitToPipelineRepository is type PipelineSegmentEvent
    outlet PipelineSegmentEventSplitToPipelineMetrics is type PipelineSegmentEvent
    handler PipelineSegmentEventSplitHandler is {
      on segmentCommissioned: event PipelineSegment.SegmentCommissioned is {
        send segmentCommissioned to outlet PipelineSegmentEventSplitToPipelineRepository
        send segmentCommissioned to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell segmentCommissioned to entity PipelineContext.PipelineSegment
      }
      on flowReadingRecorded: event PipelineSegment.FlowReadingRecorded is {
        send flowReadingRecorded to outlet PipelineSegmentEventSplitToPipelineRepository
        send flowReadingRecorded to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell flowReadingRecorded to entity PipelineContext.PipelineSegment
      }
      on leakIndicatorReported: event PipelineSegment.LeakIndicatorReported is {
        send leakIndicatorReported to outlet PipelineSegmentEventSplitToPipelineRepository
        send leakIndicatorReported to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell leakIndicatorReported to entity PipelineContext.PipelineSegment
      }
      on maintenanceScheduled: event PipelineSegment.MaintenanceScheduled is {
        send maintenanceScheduled to outlet PipelineSegmentEventSplitToPipelineRepository
        send maintenanceScheduled to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell maintenanceScheduled to entity PipelineContext.PipelineSegment
      }
      on maintenanceCompleted: event PipelineSegment.MaintenanceCompleted is {
        send maintenanceCompleted to outlet PipelineSegmentEventSplitToPipelineRepository
        send maintenanceCompleted to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell maintenanceCompleted to entity PipelineContext.PipelineSegment
      }
      on inspectionRecorded: event PipelineSegment.InspectionRecorded is {
        send inspectionRecorded to outlet PipelineSegmentEventSplitToPipelineRepository
        send inspectionRecorded to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell inspectionRecorded to entity PipelineContext.PipelineSegment
      }
      on complianceReportFiled: event PipelineSegment.ComplianceReportFiled is {
        send complianceReportFiled to outlet PipelineSegmentEventSplitToPipelineRepository
        send complianceReportFiled to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell complianceReportFiled to entity PipelineContext.PipelineSegment
      }
      on segmentShutDown: event PipelineSegment.SegmentShutDown is {
        send segmentShutDown to outlet PipelineSegmentEventSplitToPipelineRepository
        send segmentShutDown to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell segmentShutDown to entity PipelineContext.PipelineSegment
      }
      on segmentRestarted: event PipelineSegment.SegmentRestarted is {
        send segmentRestarted to outlet PipelineSegmentEventSplitToPipelineRepository
        send segmentRestarted to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell segmentRestarted to entity PipelineContext.PipelineSegment
      }
      on segmentDecommissioned: event PipelineSegment.SegmentDecommissioned is {
        send segmentDecommissioned to outlet PipelineSegmentEventSplitToPipelineRepository
        send segmentDecommissioned to outlet PipelineSegmentEventSplitToPipelineMetrics
        tell segmentDecommissioned to entity PipelineContext.PipelineSegment
      }
      on other is {
        error "Unexpected message for processor PipelineSegmentEventSplit"
      }
    } with {
      briefly "PipelineSegment event fan-out handler"
      described as {
        |Delivers each PipelineSegment event to all of its consumers.
      }
    }
  } with {
    briefly "PipelineSegment event fan-out"
    described as {
      |Fans PipelineSegment events out to the repository and projectors.
    }
  }
  connector 'PipelineSegmentEvent Stream' is from outlet PipelineContext.PipelineSegment.PipelineSegmentEvents2 to inlet PipelineContext.PipelineSegmentEventSplit.PipelineSegmentEventSplitIn with {
    briefly "PipelineSegment events, fanned out to storage and read models"
  }
  connector 'PipelineSegmentEvent Storage' is from outlet PipelineContext.PipelineSegmentEventSplit.PipelineSegmentEventSplitToPipelineRepository to inlet PipelineContext.PipelineRepository.PipelineRepositoryFromPipelineSegment with {
    briefly "PipelineSegment events on their way to storage"
  }
  connector 'PipelineMetrics Feed' is from outlet PipelineContext.PipelineSegmentEventSplit.PipelineSegmentEventSplitToPipelineMetrics to inlet PipelineContext.PipelineMetrics.PipelineMetricsFromPipelineSegment with {
    briefly "PipelineSegment events feeding the PipelineMetrics projection"
  }
  connector 'PipelineMetrics Storage' is from outlet PipelineContext.PipelineMetrics.PipelineMetricsOut to inlet PipelineContext.PipelineRepository.PipelineRepositoryFromPipelineMetrics with {
    briefly "The PipelineMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for pipeline operations"
  described as {
    |Oil and gas pipeline operations context.
  }
}
