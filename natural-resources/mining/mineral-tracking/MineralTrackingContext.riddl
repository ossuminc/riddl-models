// Mineral Tracking - MineralTracking Context
context MineralTrackingContext is {
  adaptor FromAssayLaboratory from context AssayLaboratory is { 
    handler FromAssayLaboratoryHandler is {
      on event AssayLaboratory.AssayCompleted is {
        do "the model receives assay completed"
      }
      on result AssayLaboratory.AssayHistory is {
        do "the model receives assay history"
      }
      on other is {
        error "Unexpected message for adaptor FromAssayLaboratory"
      }
    } with {
      briefly "from assay laboratory"
      described as {
        |Carries messages from the external AssayLaboratory.
      }
    }
  } with {
    briefly "AssayLaboratory integration"
    described as {
      |The model's side of the AssayLaboratory conversation.
    }
  }
  adaptor ToAssayLaboratory to context AssayLaboratory is { 
    handler ToAssayLaboratoryHandler is {
      on query AssayLaboratory.GetAssayHistory is {
        do "the model sends get assay history"
      }
      on command AssayLaboratory.SubmitSample is {
        do "the model sends submit sample"
      }
      on other is {
        error "Unexpected message for adaptor ToAssayLaboratory"
      }
    } with {
      briefly "to assay laboratory"
      described as {
        |Carries messages to the external AssayLaboratory.
      }
    }
  } with {
    briefly "AssayLaboratory integration"
    described as {
      |The model's side of the AssayLaboratory conversation.
    }
  }
  adaptor FromSmelterSystem from context SmelterSystem is { 
    handler FromSmelterSystemHandler is {
      on event SmelterSystem.DeliveryReceived is {
        do "the model receives delivery received"
      }
      on result SmelterSystem.DeliveryStatus is {
        do "the model receives delivery status"
      }
      on other is {
        error "Unexpected message for adaptor FromSmelterSystem"
      }
    } with {
      briefly "from smelter system"
      described as {
        |Carries messages from the external SmelterSystem.
      }
    }
  } with {
    briefly "SmelterSystem integration"
    described as {
      |The model's side of the SmelterSystem conversation.
    }
  }
  adaptor ToSmelterSystem to context SmelterSystem is { 
    handler ToSmelterSystemHandler is {
      on query SmelterSystem.GetDeliveryStatus is {
        do "the model sends get delivery status"
      }
      on command SmelterSystem.ScheduleDelivery is {
        do "the model sends schedule delivery"
      }
      on other is {
        error "Unexpected message for adaptor ToSmelterSystem"
      }
    } with {
      briefly "to smelter system"
      described as {
        |Carries messages to the external SmelterSystem.
      }
    }
  } with {
    briefly "SmelterSystem integration"
    described as {
      |The model's side of the SmelterSystem conversation.
    }
  }
  include "types.riddl"
  include "MineralBatch.riddl"
  repository MineralTrackingRepository is {
    inlet MineralTrackingRepositoryFromMineralBatch is type MineralBatchEvent    inlet MineralTrackingRepositoryFromMineralTrackingMetrics is type MineralBatchEvent    outlet MineralTrackingRepositoryResponses is type MineralBatch.MineralBatchResult
    record StoredMineralBatch is  {
      mineralBatchId: MineralBatchId with {
        briefly "mineralBatchId"
        described as {
          |The mineralBatchId column of the stored mineralBatch row.
        }
      }
      batchId: MineralBatchId with {
        briefly "batchId"
        described as {
          |The batchId column of the stored mineralBatch row.
        }
      }
      extractionInfo: ExtractionInfo with {
        briefly "extractionInfo"
        described as {
          |The extractionInfo column of the stored mineralBatch row.
        }
      }
      status: BatchStatus with {
        briefly "status"
        described as {
          |The status column of the stored mineralBatch row.
        }
      }
    } with {
      briefly "Stored mineralBatch row"
      described as {
        |The persistence shape of mineralBatch data as this repository stores it.
      }
    }
    schema MineralTrackingData is relational
      of mineralBatches as type StoredMineralBatch
        index on field StoredMineralBatch.batchId
        index on field StoredMineralBatch.extractionInfo.mineId
        index on field StoredMineralBatch.status
 with {
      briefly "Mineral tracking data schema"
      described as {
        |The relational schema holding mineral tracking data for the MineralTrackingRepository.
      }
    }
    handler MineralTrackingPersistence is {
      on query GetBatchMetrics is {
        do "read the batch metrics projection"
        yield result BatchMetricsView
      }
      on command MineralBatch.RecordExtraction is {
        tell event MineralBatch.ExtractionRecorded to entity MineralTrackingContext.MineralBatch
        do "Store new mineral batch extraction"
      }
      on command MineralBatch.RecordAssayResult is {
        tell event MineralBatch.AssayResultRecorded to entity MineralTrackingContext.MineralBatch
        do "Update batch with assay result"
      }
      on command MineralBatch.MoveToStockpile is {
        do "Update batch stockpile location"
      }
      on command MineralBatch.RecordProcessingResult is {
        tell event MineralBatch.ProcessingResultRecorded to entity MineralTrackingContext.MineralBatch
        do "Store processing result"
      }
      on command MineralBatch.ReconcileGrade is {
        do "Store grade reconciliation"
      }
      on command MineralBatch.ShipToSmelter is {
        do "Update batch with shipment info"
      }
      on command MineralBatch.ConfirmDelivery is {
        tell event MineralBatch.DeliveryConfirmed to entity MineralTrackingContext.MineralBatch
        do "Update batch to delivered"
      }
    } with {
      briefly "Persists mineral tracking events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Mineral tracking data persistence"
    described as {
      |Persistent storage for mineral tracking.
    }
  }
  query GetBatchMetrics is  {
    batchMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which batch metrics to retrieve.
      }
    }
  } with {
    briefly "Get batch metrics"
    described as {
      |Retrieves the batch metrics projection.
    }
  }
  result BatchMetricsView is  {
    batchMetrics: MineralTrackingMetrics.BatchMetrics with {
      briefly "Batch metrics"
      described as {
        |The batch metrics being returned.
      }
    }
  } with {
    briefly "Batch metrics view"
    described as {
      |Read model view carrying the batch metrics projection.
    }
  }
  projector MineralTrackingMetrics is {
    updates repository MineralTrackingContext.MineralTrackingRepository
    inlet MineralTrackingMetricsFromMineralBatch is type MineralBatchEvent    outlet MineralTrackingMetricsOut is type MineralBatchEvent
    record BatchMetrics is  {
      batchesExtracted: Natural with {
        briefly "Extracted"
        described as {
          |Batches extracted.
        }
      }
      batchesProcessed: Natural with {
        briefly "Processed"
        described as {
          |Batches processed.
        }
      }
      batchesShipped: Natural with {
        briefly "Shipped"
        described as {
          |Batches shipped.
        }
      }
      batchesRejected: Natural with {
        briefly "Rejected"
        described as {
          |Batches rejected.
        }
      }
      totalTonnageExtracted: Decimal(14,2) with {
        briefly "Total tonnage"
        described as {
          |Total tonnage extracted.
        }
      }
      averageRecoveryRate: Decimal(5,2) with {
        briefly "Avg recovery"
        described as {
          |Average recovery rate.
        }
      }
    } with {
      briefly "Batch metrics"
      described as {
        |Mineral batch processing metrics.
      }
    }
    handler MetricsHandler is {
      on event MineralBatch.ExtractionRecorded is {
        tell event MineralBatch.ExtractionRecorded to repository MineralTrackingContext.MineralTrackingRepository
        do "Increment batches extracted and total tonnage"
      }
      on event MineralBatch.ProcessingResultRecorded is {
        tell event MineralBatch.ProcessingResultRecorded to repository MineralTrackingContext.MineralTrackingRepository
        do "Increment batches processed and update recovery rate"
      }
      on event MineralBatch.ShippedToSmelter is {
        tell event MineralBatch.ShippedToSmelter to repository MineralTrackingContext.MineralTrackingRepository
        do "Increment batches shipped"
      }
      on event MineralBatch.BatchRejected is {
        tell event MineralBatch.BatchRejected to repository MineralTrackingContext.MineralTrackingRepository
        do "Increment batches rejected"
      }
    } with {
      briefly "Maintains mineral tracking metrics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Mineral tracking metrics"
    described as {
      |Mineral tracking analytics and KPIs.
    }
  }
  // ---- Event publication for MineralBatch ----
  type MineralBatchEvent is one of {
    MineralTrackingContext.MineralBatch.ExtractionRecorded or MineralTrackingContext.MineralBatch.AssayResultRecorded or MineralTrackingContext.MineralBatch.MovedToStockpile or MineralTrackingContext.MineralBatch.ProcessingStarted or MineralTrackingContext.MineralBatch.ProcessingResultRecorded or MineralTrackingContext.MineralBatch.GradeReconciled or MineralTrackingContext.MineralBatch.ShippedToSmelter or MineralTrackingContext.MineralBatch.DeliveryConfirmed or MineralTrackingContext.MineralBatch.BatchRejected
  } with {
    briefly "MineralBatch event alternation"
    described as {
      |Union of all MineralBatch events, for streaming and event-sourced
      |persistence.
    }
  }
  processor MineralBatchEventSource as source is {
    outlet MineralBatchEvents is type MineralBatchEvent
    handler MineralBatchSourceHandler is {
      on event MineralBatch.ExtractionRecorded is {
        send event MineralBatch.ExtractionRecorded to outlet MineralBatchEvents
      }
      on event MineralBatch.AssayResultRecorded is {
        send event MineralBatch.AssayResultRecorded to outlet MineralBatchEvents
      }
      on event MineralBatch.MovedToStockpile is {
        send event MineralBatch.MovedToStockpile to outlet MineralBatchEvents
      }
      on event MineralBatch.ProcessingStarted is {
        send event MineralBatch.ProcessingStarted to outlet MineralBatchEvents
      }
      on event MineralBatch.ProcessingResultRecorded is {
        send event MineralBatch.ProcessingResultRecorded to outlet MineralBatchEvents
      }
      on event MineralBatch.GradeReconciled is {
        send event MineralBatch.GradeReconciled to outlet MineralBatchEvents
      }
      on event MineralBatch.ShippedToSmelter is {
        send event MineralBatch.ShippedToSmelter to outlet MineralBatchEvents
      }
      on event MineralBatch.DeliveryConfirmed is {
        send event MineralBatch.DeliveryConfirmed to outlet MineralBatchEvents
      }
      on event MineralBatch.BatchRejected is {
        send event MineralBatch.BatchRejected to outlet MineralBatchEvents
      }
      on other is {
        error "Unexpected message for source MineralBatchEventSource"
      }
    } with {
      briefly "MineralBatch source handler"
      described as {
        |Publishes MineralBatch events onto the outlet.
      }
    }
  } with {
    briefly "MineralBatch event source"
    described as {
      |Publishes MineralBatch entity events into the streaming topology.
    }
  }
  processor MineralBatchEventSink as sink is {
    inlet MineralBatchInlet is type MineralBatchEvent    handler MineralBatchSinkHandler is {
      on event MineralBatch.ExtractionRecorded is {
        tell event MineralBatch.ExtractionRecorded to repository MineralTrackingContext.MineralTrackingRepository
      }
      on event MineralBatch.AssayResultRecorded is {
        tell event MineralBatch.AssayResultRecorded to repository MineralTrackingContext.MineralTrackingRepository
      }
      on event MineralBatch.MovedToStockpile is {
        tell event MineralBatch.MovedToStockpile to repository MineralTrackingContext.MineralTrackingRepository
      }
      on event MineralBatch.ProcessingStarted is {
        tell event MineralBatch.ProcessingStarted to repository MineralTrackingContext.MineralTrackingRepository
      }
      on event MineralBatch.ProcessingResultRecorded is {
        tell event MineralBatch.ProcessingResultRecorded to repository MineralTrackingContext.MineralTrackingRepository
      }
      on event MineralBatch.GradeReconciled is {
        tell event MineralBatch.GradeReconciled to repository MineralTrackingContext.MineralTrackingRepository
      }
      on event MineralBatch.ShippedToSmelter is {
        tell event MineralBatch.ShippedToSmelter to repository MineralTrackingContext.MineralTrackingRepository
      }
      on event MineralBatch.DeliveryConfirmed is {
        tell event MineralBatch.DeliveryConfirmed to repository MineralTrackingContext.MineralTrackingRepository
      }
      on event MineralBatch.BatchRejected is {
        tell event MineralBatch.BatchRejected to repository MineralTrackingContext.MineralTrackingRepository
      }
      on other is {
        error "Unexpected message for sink MineralBatchEventSink"
      }
    } with {
      briefly "MineralBatch sink handler"
      described as {
        |Persists MineralBatch events via the repository.
      }
    }
  } with {
    briefly "MineralBatch event sink"
    described as {
      |Receives MineralBatch events for persistence.
    }
  }
  connector MineralBatchEventFlow is from outlet MineralTrackingContext.MineralBatchEventSource.MineralBatchEvents to inlet MineralTrackingContext.MineralBatchEventSink.MineralBatchInlet with {
    briefly "MineralBatch event flow"
    described as {
      |Connects the MineralBatch source to its sink.
    }
  }
  processor MineralBatchEventSplit is {
    inlet MineralBatchEventSplitIn is type MineralBatchEvent    outlet MineralBatchEventSplitToMineralTrackingRepository is type MineralBatchEvent
    outlet MineralBatchEventSplitToMineralTrackingMetrics is type MineralBatchEvent
    handler MineralBatchEventSplitHandler is {
      on event MineralBatch.ExtractionRecorded is {
        send event MineralBatch.ExtractionRecorded to outlet MineralBatchEventSplitToMineralTrackingRepository
        send event MineralBatch.ExtractionRecorded to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell event MineralBatch.ExtractionRecorded to entity MineralTrackingContext.MineralBatch
      }
      on event MineralBatch.AssayResultRecorded is {
        send event MineralBatch.AssayResultRecorded to outlet MineralBatchEventSplitToMineralTrackingRepository
        send event MineralBatch.AssayResultRecorded to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell event MineralBatch.AssayResultRecorded to entity MineralTrackingContext.MineralBatch
      }
      on event MineralBatch.MovedToStockpile is {
        send event MineralBatch.MovedToStockpile to outlet MineralBatchEventSplitToMineralTrackingRepository
        send event MineralBatch.MovedToStockpile to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell event MineralBatch.MovedToStockpile to entity MineralTrackingContext.MineralBatch
      }
      on event MineralBatch.ProcessingStarted is {
        send event MineralBatch.ProcessingStarted to outlet MineralBatchEventSplitToMineralTrackingRepository
        send event MineralBatch.ProcessingStarted to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell event MineralBatch.ProcessingStarted to entity MineralTrackingContext.MineralBatch
      }
      on event MineralBatch.ProcessingResultRecorded is {
        send event MineralBatch.ProcessingResultRecorded to outlet MineralBatchEventSplitToMineralTrackingRepository
        send event MineralBatch.ProcessingResultRecorded to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell event MineralBatch.ProcessingResultRecorded to entity MineralTrackingContext.MineralBatch
      }
      on event MineralBatch.GradeReconciled is {
        send event MineralBatch.GradeReconciled to outlet MineralBatchEventSplitToMineralTrackingRepository
        send event MineralBatch.GradeReconciled to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell event MineralBatch.GradeReconciled to entity MineralTrackingContext.MineralBatch
      }
      on event MineralBatch.ShippedToSmelter is {
        send event MineralBatch.ShippedToSmelter to outlet MineralBatchEventSplitToMineralTrackingRepository
        send event MineralBatch.ShippedToSmelter to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell event MineralBatch.ShippedToSmelter to entity MineralTrackingContext.MineralBatch
      }
      on event MineralBatch.DeliveryConfirmed is {
        send event MineralBatch.DeliveryConfirmed to outlet MineralBatchEventSplitToMineralTrackingRepository
        send event MineralBatch.DeliveryConfirmed to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell event MineralBatch.DeliveryConfirmed to entity MineralTrackingContext.MineralBatch
      }
      on event MineralBatch.BatchRejected is {
        send event MineralBatch.BatchRejected to outlet MineralBatchEventSplitToMineralTrackingRepository
        send event MineralBatch.BatchRejected to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell event MineralBatch.BatchRejected to entity MineralTrackingContext.MineralBatch
      }
      on other is {
        error "Unexpected message for processor MineralBatchEventSplit"
      }
    } with {
      briefly "MineralBatch event fan-out handler"
      described as {
        |Delivers each MineralBatch event to all of its consumers.
      }
    }
  } with {
    briefly "MineralBatch event fan-out"
    described as {
      |Fans MineralBatch events out to the repository and projectors.
    }
  }
  connector 'MineralBatchEvent Stream' is from outlet MineralTrackingContext.MineralBatch.MineralBatchEvents2 to inlet MineralTrackingContext.MineralBatchEventSplit.MineralBatchEventSplitIn with {
    briefly "MineralBatch events, fanned out to storage and read models"
  }
  connector 'MineralBatchEvent Storage' is from outlet MineralTrackingContext.MineralBatchEventSplit.MineralBatchEventSplitToMineralTrackingRepository to inlet MineralTrackingContext.MineralTrackingRepository.MineralTrackingRepositoryFromMineralBatch with {
    briefly "MineralBatch events on their way to storage"
  }
  connector 'MineralTrackingMetrics Feed' is from outlet MineralTrackingContext.MineralBatchEventSplit.MineralBatchEventSplitToMineralTrackingMetrics to inlet MineralTrackingContext.MineralTrackingMetrics.MineralTrackingMetricsFromMineralBatch with {
    briefly "MineralBatch events feeding the MineralTrackingMetrics projection"
  }
  connector 'MineralTrackingMetrics Storage' is from outlet MineralTrackingContext.MineralTrackingMetrics.MineralTrackingMetricsOut to inlet MineralTrackingContext.MineralTrackingRepository.MineralTrackingRepositoryFromMineralTrackingMetrics with {
    briefly "The MineralTrackingMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for mineral tracking"
  described as {
    |Mineral tracking from extraction through smelter delivery.
  }
}
