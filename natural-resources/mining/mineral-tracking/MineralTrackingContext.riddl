// Mineral Tracking - MineralTracking Context
context MineralTrackingContext as router is {
  inlet MineralBatchCommandStreamIn is type MineralBatchCommand  outlet MineralBatchCommandStreamOut is type MineralBatchCommand
  inlet MineralBatchResultStreamIn is type MineralBatch.MineralBatchResult  outlet MineralBatchResultStreamOut is type MineralBatch.MineralBatchResult
  handler MineralTrackingContextBoundary is {
    on recordExtraction: command MineralBatch.RecordExtraction is {
      send recordExtraction to outlet MineralTrackingContext.MineralBatchCommandStreamOut
    }
    on recordAssayResult: command MineralBatch.RecordAssayResult is {
      send recordAssayResult to outlet MineralTrackingContext.MineralBatchCommandStreamOut
    }
    on moveToStockpile: command MineralBatch.MoveToStockpile is {
      send moveToStockpile to outlet MineralTrackingContext.MineralBatchCommandStreamOut
    }
    on startProcessing: command MineralBatch.StartProcessing is {
      send startProcessing to outlet MineralTrackingContext.MineralBatchCommandStreamOut
    }
    on recordProcessingResult: command MineralBatch.RecordProcessingResult is {
      send recordProcessingResult to outlet MineralTrackingContext.MineralBatchCommandStreamOut
    }
    on reconcileGrade: command MineralBatch.ReconcileGrade is {
      send reconcileGrade to outlet MineralTrackingContext.MineralBatchCommandStreamOut
    }
    on shipToSmelter: command MineralBatch.ShipToSmelter is {
      send shipToSmelter to outlet MineralTrackingContext.MineralBatchCommandStreamOut
    }
    on confirmDelivery: command MineralBatch.ConfirmDelivery is {
      send confirmDelivery to outlet MineralTrackingContext.MineralBatchCommandStreamOut
    }
    on rejectBatch: command MineralBatch.RejectBatch is {
      send rejectBatch to outlet MineralTrackingContext.MineralBatchCommandStreamOut
    }
    on mineralBatchResult: result MineralBatch.MineralBatchResult is {
      send mineralBatchResult to outlet MineralTrackingContext.MineralBatchResultStreamOut
    }
    on other is {
      error "Unexpected message at the MineralTrackingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'MineralBatchCommand Stream Intake' is from outlet MineralTrackingContext.MineralBatchCommandStreamOut to inlet MineralTrackingContext.MineralBatch.MineralBatchCommands  connector 'MineralBatchResult Stream Egress' is from outlet MineralTrackingContext.MineralTrackingRepository.MineralTrackingRepositoryResponses to inlet MineralTrackingContext.MineralBatchResultStreamIn  adaptor FromAssayLaboratory from context AssayLaboratory is { 
    handler FromAssayLaboratoryHandler is {
      on event AssayLaboratory.AssayCompleted is {
        do "the model receives assay completed"
      }
      on result AssayLaboratory.AssayHistory is {
        do "the model receives assay history"
      }
      on other is {
        error "Unexpected message for adaptor FromAssayLaboratory"
      }
    } with {
      briefly "from assay laboratory"
      described as {
        |Carries messages from the external AssayLaboratory.
      }
    }
  } with {
    briefly "AssayLaboratory integration"
    described as {
      |The model's side of the AssayLaboratory conversation.
    }
  }
  adaptor ToAssayLaboratory to context AssayLaboratory is { 
    handler ToAssayLaboratoryHandler is {
      on query AssayLaboratory.GetAssayHistory is {
        do "the model sends get assay history"
      }
      on command AssayLaboratory.SubmitSample is {
        do "the model sends submit sample"
      }
      on other is {
        error "Unexpected message for adaptor ToAssayLaboratory"
      }
    } with {
      briefly "to assay laboratory"
      described as {
        |Carries messages to the external AssayLaboratory.
      }
    }
  } with {
    briefly "AssayLaboratory integration"
    described as {
      |The model's side of the AssayLaboratory conversation.
    }
  }
  adaptor FromSmelterSystem from context SmelterSystem is { 
    handler FromSmelterSystemHandler is {
      on event SmelterSystem.DeliveryReceived is {
        do "the model receives delivery received"
      }
      on result SmelterSystem.DeliveryStatus is {
        do "the model receives delivery status"
      }
      on other is {
        error "Unexpected message for adaptor FromSmelterSystem"
      }
    } with {
      briefly "from smelter system"
      described as {
        |Carries messages from the external SmelterSystem.
      }
    }
  } with {
    briefly "SmelterSystem integration"
    described as {
      |The model's side of the SmelterSystem conversation.
    }
  }
  adaptor ToSmelterSystem to context SmelterSystem is { 
    handler ToSmelterSystemHandler is {
      on query SmelterSystem.GetDeliveryStatus is {
        do "the model sends get delivery status"
      }
      on command SmelterSystem.ScheduleDelivery is {
        do "the model sends schedule delivery"
      }
      on other is {
        error "Unexpected message for adaptor ToSmelterSystem"
      }
    } with {
      briefly "to smelter system"
      described as {
        |Carries messages to the external SmelterSystem.
      }
    }
  } with {
    briefly "SmelterSystem integration"
    described as {
      |The model's side of the SmelterSystem conversation.
    }
  }
  include "types.riddl"
  include "MineralBatch.riddl"
  repository MineralTrackingRepository as merge is {
    command PersistBatchRejected is  {
      batchId: MineralBatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row BatchRejected applies to.
        }
      }
    } with {
      briefly "Persist BatchRejected"
      described as {
        |Instructs this repository to apply BatchRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExtractionRecorded is  {
      batchId: MineralBatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExtractionRecorded applies to.
        }
      }
    } with {
      briefly "Persist ExtractionRecorded"
      described as {
        |Instructs this repository to apply ExtractionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProcessingResultRecorded is  {
      batchId: MineralBatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProcessingResultRecorded applies to.
        }
      }
    } with {
      briefly "Persist ProcessingResultRecorded"
      described as {
        |Instructs this repository to apply ProcessingResultRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShippedToSmelter is  {
      batchId: MineralBatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShippedToSmelter applies to.
        }
      }
    } with {
      briefly "Persist ShippedToSmelter"
      described as {
        |Instructs this repository to apply ShippedToSmelter to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet MineralTrackingRepositoryFromMineralBatch is type MineralBatchEvent    inlet MineralTrackingRepositoryFromMineralTrackingMetrics is type MineralBatchEvent    outlet MineralTrackingRepositoryResponses is type MineralBatch.MineralBatchResult
    record StoredMineralBatch is  {
      mineralBatchId: MineralBatchId with {
        briefly "mineralBatchId"
        described as {
          |The mineralBatchId column of the stored mineralBatch row.
        }
      }
      batchId: MineralBatchId with {
        briefly "batchId"
        described as {
          |The batchId column of the stored mineralBatch row.
        }
      }
      extractionInfo: ExtractionInfo with {
        briefly "extractionInfo"
        described as {
          |The extractionInfo column of the stored mineralBatch row.
        }
      }
      status: BatchStatus with {
        briefly "status"
        described as {
          |The status column of the stored mineralBatch row.
        }
      }
    } with {
      briefly "Stored mineralBatch row"
      described as {
        |The persistence shape of mineralBatch data as this repository stores it.
      }
    }
    schema MineralTrackingData is relational
      of mineralBatches as type StoredMineralBatch
        index on field StoredMineralBatch.batchId
        index on field StoredMineralBatch.extractionInfo.mineId
        index on field StoredMineralBatch.status
 with {
      briefly "Mineral tracking data schema"
      described as {
        |The relational schema holding mineral tracking data for the MineralTrackingRepository.
      }
    }
    handler MineralTrackingPersistence is {
      on persistBatchRejected: command PersistBatchRejected is {
        do "apply BatchRejected to the stored row"
      }
      on persistExtractionRecorded: command PersistExtractionRecorded is {
        do "apply ExtractionRecorded to the stored row"
      }
      on persistProcessingResultRecorded: command PersistProcessingResultRecorded is {
        do "apply ProcessingResultRecorded to the stored row"
      }
      on persistShippedToSmelter: command PersistShippedToSmelter is {
        do "apply ShippedToSmelter to the stored row"
      }
      on query GetBatchMetrics is {
        let batchMetricsView: type BatchMetricsView = prompt("read the batch metrics projection")
        reply batchMetricsView
      }
      on recordExtraction: command MineralBatch.RecordExtraction is {
        tell event MineralBatch.ExtractionRecorded(batchId = recordExtraction.batchId, extractionInfo = recordExtraction.extractionInfo) to entity MineralTrackingContext.MineralBatch
        do "Store new mineral batch extraction"
      }
      on recordAssayResult: command MineralBatch.RecordAssayResult is {
        tell event MineralBatch.AssayResultRecorded(batchId = recordAssayResult.batchId, assayResult = recordAssayResult.assayResult) to entity MineralTrackingContext.MineralBatch
        do "Update batch with assay result"
      }
      on command MineralBatch.MoveToStockpile is {
        do "Update batch stockpile location"
      }
      on recordProcessingResult: command MineralBatch.RecordProcessingResult is {
        tell event MineralBatch.ProcessingResultRecorded(batchId = recordProcessingResult.batchId, processingRecord = recordProcessingResult.processingRecord) to entity MineralTrackingContext.MineralBatch
        do "Store processing result"
      }
      on command MineralBatch.ReconcileGrade is {
        do "Store grade reconciliation"
      }
      on command MineralBatch.ShipToSmelter is {
        do "Update batch with shipment info"
      }
      on confirmDelivery: command MineralBatch.ConfirmDelivery is {
        tell event MineralBatch.DeliveryConfirmed(batchId = confirmDelivery.batchId, shipmentId = confirmDelivery.shipmentId, deliveredAt = confirmDelivery.deliveredAt) to entity MineralTrackingContext.MineralBatch
        do "Update batch to delivered"
      }
    } with {
      briefly "Persists mineral tracking events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Mineral tracking data persistence"
    described as {
      |Persistent storage for mineral tracking.
    }
  }
  query GetBatchMetrics is  {
    batchMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which batch metrics to retrieve.
      }
    }
  } with {
    briefly "Get batch metrics"
    described as {
      |Retrieves the batch metrics projection.
    }
  }
  result BatchMetricsView is  {
    batchMetrics: MineralTrackingMetrics.BatchMetrics with {
      briefly "Batch metrics"
      described as {
        |The batch metrics being returned.
      }
    }
  } with {
    briefly "Batch metrics view"
    described as {
      |Read model view carrying the batch metrics projection.
    }
  }
  projector MineralTrackingMetrics as flow is {
    updates repository MineralTrackingContext.MineralTrackingRepository
    inlet MineralTrackingMetricsFromMineralBatch is type MineralBatchEvent    outlet MineralTrackingMetricsOut is type MineralBatchEvent
    record BatchMetrics is  {
      batchesExtracted: Natural with {
        briefly "Extracted"
        described as {
          |Batches extracted.
        }
      }
      batchesProcessed: Natural with {
        briefly "Processed"
        described as {
          |Batches processed.
        }
      }
      batchesShipped: Natural with {
        briefly "Shipped"
        described as {
          |Batches shipped.
        }
      }
      batchesRejected: Natural with {
        briefly "Rejected"
        described as {
          |Batches rejected.
        }
      }
      totalTonnageExtracted: Decimal(14,2) with {
        briefly "Total tonnage"
        described as {
          |Total tonnage extracted.
        }
      }
      averageRecoveryRate: Decimal(5,2) with {
        briefly "Avg recovery"
        described as {
          |Average recovery rate.
        }
      }
    } with {
      briefly "Batch metrics"
      described as {
        |Mineral batch processing metrics.
      }
    }
    handler MetricsHandler is {
      on extractionRecorded: event MineralBatch.ExtractionRecorded is {
        tell command MineralTrackingContext.MineralTrackingRepository.PersistExtractionRecorded(batchId = extractionRecorded.batchId) to repository MineralTrackingContext.MineralTrackingRepository
        do "Increment batches extracted and total tonnage"
      }
      on processingResultRecorded: event MineralBatch.ProcessingResultRecorded is {
        tell command MineralTrackingContext.MineralTrackingRepository.PersistProcessingResultRecorded(batchId = processingResultRecorded.batchId) to repository MineralTrackingContext.MineralTrackingRepository
        do "Increment batches processed and update recovery rate"
      }
      on shippedToSmelter: event MineralBatch.ShippedToSmelter is {
        tell command MineralTrackingContext.MineralTrackingRepository.PersistShippedToSmelter(batchId = shippedToSmelter.batchId) to repository MineralTrackingContext.MineralTrackingRepository
        do "Increment batches shipped"
      }
      on batchRejected: event MineralBatch.BatchRejected is {
        tell command MineralTrackingContext.MineralTrackingRepository.PersistBatchRejected(batchId = batchRejected.batchId) to repository MineralTrackingContext.MineralTrackingRepository
        do "Increment batches rejected"
      }
    } with {
      briefly "Maintains mineral tracking metrics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Mineral tracking metrics"
    described as {
      |Mineral tracking analytics and KPIs.
    }
  }
  // ---- Event publication for MineralBatch ----
  type MineralBatchEvent is one of {
    MineralTrackingContext.MineralBatch.ExtractionRecorded or MineralTrackingContext.MineralBatch.AssayResultRecorded or MineralTrackingContext.MineralBatch.MovedToStockpile or MineralTrackingContext.MineralBatch.ProcessingStarted or MineralTrackingContext.MineralBatch.ProcessingResultRecorded or MineralTrackingContext.MineralBatch.GradeReconciled or MineralTrackingContext.MineralBatch.ShippedToSmelter or MineralTrackingContext.MineralBatch.DeliveryConfirmed or MineralTrackingContext.MineralBatch.BatchRejected
  } with {
    briefly "MineralBatch event alternation"
    described as {
      |Union of all MineralBatch events, for streaming and event-sourced
      |persistence.
    }
  }
  processor MineralBatchEventSource as source is {
    outlet MineralBatchEvents is type MineralBatchEvent
    handler MineralBatchSourceHandler is {
      on extractionRecorded: event MineralBatch.ExtractionRecorded is {
        send extractionRecorded to outlet MineralBatchEvents
      }
      on assayResultRecorded: event MineralBatch.AssayResultRecorded is {
        send assayResultRecorded to outlet MineralBatchEvents
      }
      on movedToStockpile: event MineralBatch.MovedToStockpile is {
        send movedToStockpile to outlet MineralBatchEvents
      }
      on processingStarted: event MineralBatch.ProcessingStarted is {
        send processingStarted to outlet MineralBatchEvents
      }
      on processingResultRecorded: event MineralBatch.ProcessingResultRecorded is {
        send processingResultRecorded to outlet MineralBatchEvents
      }
      on gradeReconciled: event MineralBatch.GradeReconciled is {
        send gradeReconciled to outlet MineralBatchEvents
      }
      on shippedToSmelter: event MineralBatch.ShippedToSmelter is {
        send shippedToSmelter to outlet MineralBatchEvents
      }
      on deliveryConfirmed: event MineralBatch.DeliveryConfirmed is {
        send deliveryConfirmed to outlet MineralBatchEvents
      }
      on batchRejected: event MineralBatch.BatchRejected is {
        send batchRejected to outlet MineralBatchEvents
      }
      on other is {
        error "Unexpected message for source MineralBatchEventSource"
      }
    } with {
      briefly "MineralBatch source handler"
      described as {
        |Publishes MineralBatch events onto the outlet.
      }
    }
  } with {
    briefly "MineralBatch event source"
    described as {
      |Publishes MineralBatch entity events into the streaming topology.
    }
  }
  processor MineralBatchEventSink as sink is {
    inlet MineralBatchInlet is type MineralBatchEvent    handler MineralBatchSinkHandler is {
      on extractionRecorded: event MineralBatch.ExtractionRecorded is {
        tell extractionRecorded to repository MineralTrackingContext.MineralTrackingRepository
      }
      on assayResultRecorded: event MineralBatch.AssayResultRecorded is {
        tell assayResultRecorded to repository MineralTrackingContext.MineralTrackingRepository
      }
      on movedToStockpile: event MineralBatch.MovedToStockpile is {
        tell movedToStockpile to repository MineralTrackingContext.MineralTrackingRepository
      }
      on processingStarted: event MineralBatch.ProcessingStarted is {
        tell processingStarted to repository MineralTrackingContext.MineralTrackingRepository
      }
      on processingResultRecorded: event MineralBatch.ProcessingResultRecorded is {
        tell processingResultRecorded to repository MineralTrackingContext.MineralTrackingRepository
      }
      on gradeReconciled: event MineralBatch.GradeReconciled is {
        tell gradeReconciled to repository MineralTrackingContext.MineralTrackingRepository
      }
      on shippedToSmelter: event MineralBatch.ShippedToSmelter is {
        tell shippedToSmelter to repository MineralTrackingContext.MineralTrackingRepository
      }
      on deliveryConfirmed: event MineralBatch.DeliveryConfirmed is {
        tell deliveryConfirmed to repository MineralTrackingContext.MineralTrackingRepository
      }
      on batchRejected: event MineralBatch.BatchRejected is {
        tell batchRejected to repository MineralTrackingContext.MineralTrackingRepository
      }
      on other is {
        error "Unexpected message for sink MineralBatchEventSink"
      }
    } with {
      briefly "MineralBatch sink handler"
      described as {
        |Persists MineralBatch events via the repository.
      }
    }
  } with {
    briefly "MineralBatch event sink"
    described as {
      |Receives MineralBatch events for persistence.
    }
  }
  connector MineralBatchEventFlow is from outlet MineralTrackingContext.MineralBatchEventSource.MineralBatchEvents to inlet MineralTrackingContext.MineralBatchEventSink.MineralBatchInlet with {
    briefly "MineralBatch event flow"
    described as {
      |Connects the MineralBatch source to its sink.
    }
  }
  processor MineralBatchEventSplit as split is {
    inlet MineralBatchEventSplitIn is type MineralBatchEvent    outlet MineralBatchEventSplitToMineralTrackingRepository is type MineralBatchEvent
    outlet MineralBatchEventSplitToMineralTrackingMetrics is type MineralBatchEvent
    handler MineralBatchEventSplitHandler is {
      on extractionRecorded: event MineralBatch.ExtractionRecorded is {
        send extractionRecorded to outlet MineralBatchEventSplitToMineralTrackingRepository
        send extractionRecorded to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell extractionRecorded to entity MineralTrackingContext.MineralBatch
      }
      on assayResultRecorded: event MineralBatch.AssayResultRecorded is {
        send assayResultRecorded to outlet MineralBatchEventSplitToMineralTrackingRepository
        send assayResultRecorded to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell assayResultRecorded to entity MineralTrackingContext.MineralBatch
      }
      on movedToStockpile: event MineralBatch.MovedToStockpile is {
        send movedToStockpile to outlet MineralBatchEventSplitToMineralTrackingRepository
        send movedToStockpile to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell movedToStockpile to entity MineralTrackingContext.MineralBatch
      }
      on processingStarted: event MineralBatch.ProcessingStarted is {
        send processingStarted to outlet MineralBatchEventSplitToMineralTrackingRepository
        send processingStarted to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell processingStarted to entity MineralTrackingContext.MineralBatch
      }
      on processingResultRecorded: event MineralBatch.ProcessingResultRecorded is {
        send processingResultRecorded to outlet MineralBatchEventSplitToMineralTrackingRepository
        send processingResultRecorded to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell processingResultRecorded to entity MineralTrackingContext.MineralBatch
      }
      on gradeReconciled: event MineralBatch.GradeReconciled is {
        send gradeReconciled to outlet MineralBatchEventSplitToMineralTrackingRepository
        send gradeReconciled to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell gradeReconciled to entity MineralTrackingContext.MineralBatch
      }
      on shippedToSmelter: event MineralBatch.ShippedToSmelter is {
        send shippedToSmelter to outlet MineralBatchEventSplitToMineralTrackingRepository
        send shippedToSmelter to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell shippedToSmelter to entity MineralTrackingContext.MineralBatch
      }
      on deliveryConfirmed: event MineralBatch.DeliveryConfirmed is {
        send deliveryConfirmed to outlet MineralBatchEventSplitToMineralTrackingRepository
        send deliveryConfirmed to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell deliveryConfirmed to entity MineralTrackingContext.MineralBatch
      }
      on batchRejected: event MineralBatch.BatchRejected is {
        send batchRejected to outlet MineralBatchEventSplitToMineralTrackingRepository
        send batchRejected to outlet MineralBatchEventSplitToMineralTrackingMetrics
        tell batchRejected to entity MineralTrackingContext.MineralBatch
      }
      on other is {
        error "Unexpected message for processor MineralBatchEventSplit"
      }
    } with {
      briefly "MineralBatch event fan-out handler"
      described as {
        |Delivers each MineralBatch event to all of its consumers.
      }
    }
  } with {
    briefly "MineralBatch event fan-out"
    described as {
      |Fans MineralBatch events out to the repository and projectors.
    }
  }
  connector 'MineralBatchEvent Stream' is from outlet MineralTrackingContext.MineralBatch.MineralBatchEvents2 to inlet MineralTrackingContext.MineralBatchEventSplit.MineralBatchEventSplitIn with {
    briefly "MineralBatch events, fanned out to storage and read models"
  }
  connector 'MineralBatchEvent Storage' is from outlet MineralTrackingContext.MineralBatchEventSplit.MineralBatchEventSplitToMineralTrackingRepository to inlet MineralTrackingContext.MineralTrackingRepository.MineralTrackingRepositoryFromMineralBatch with {
    briefly "MineralBatch events on their way to storage"
  }
  connector 'MineralTrackingMetrics Feed' is from outlet MineralTrackingContext.MineralBatchEventSplit.MineralBatchEventSplitToMineralTrackingMetrics to inlet MineralTrackingContext.MineralTrackingMetrics.MineralTrackingMetricsFromMineralBatch with {
    briefly "MineralBatch events feeding the MineralTrackingMetrics projection"
  }
  connector 'MineralTrackingMetrics Storage' is from outlet MineralTrackingContext.MineralTrackingMetrics.MineralTrackingMetricsOut to inlet MineralTrackingContext.MineralTrackingRepository.MineralTrackingRepositoryFromMineralTrackingMetrics with {
    briefly "The MineralTrackingMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for mineral tracking"
  described as {
    |Mineral tracking from extraction through smelter delivery.
  }
}
