// Mine Operations - ExtractionZone Entity
entity ExtractionZone as router is {
  type ExtractionZoneCommand is one of {
    ExtractionZone.SurveyZone or ExtractionZone.StartDrilling or ExtractionZone.RecordBlasting or ExtractionZone.RecordProduction or ExtractionZone.RecordSafetyIncident or ExtractionZone.RecordEnvironmental or ExtractionZone.ExhaustZone or ExtractionZone.InitiateReclamation or ExtractionZone.RecordPermitRequirements
  } with {
    briefly "ExtractionZone command alternation"
    described as {
      |Commands accepted by the ExtractionZone entity.
    }
  }
  inlet ExtractionZoneQueries is query GetExtractionZone with {
    briefly "Look-ups of this extraction zone"
    described as {
      |What MineOperationsApp asks of the extraction zone, by way of MineContext.
    }
  }
  outlet ExtractionZoneReplies is result ExtractionZoneResult
 with {
    briefly "This extraction zone's answers"
    described as {
      |What the extraction zone answers, on its way back to MineContext.
    }
  }
  inlet ExtractionZoneCommands is type ExtractionZoneCommand
  outlet ExtractionZoneEvents2 is type ExtractionZoneEvent
  query GetExtractionZone replies result ExtractionZoneResult is {
    extractionZoneId: ExtractionZoneId with {
      briefly "ID"
      described as {
        |Identifier of the ExtractionZone to retrieve.
      }
    }
  } with {
    briefly "Get ExtractionZone"
    described as {
      |Retrieve ExtractionZone data by identifier.
    }
  }
  result ExtractionZoneResult is {
    extractionZoneId: ExtractionZoneId with {
      briefly "ExtractionZone addressed"
      described as {
        |Which extractionzone this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    extractionZoneData: ExtractionZone.ActiveStateData with {
      briefly "ExtractionZone data"
      described as {
        |The requested ExtractionZone data.
      }
    }
  } with {
    briefly "ExtractionZone result"
    described as {
      |Result carrying the requested ExtractionZone data.
    }
  }
  command SurveyZone is {
    zoneId: ExtractionZoneId with {
      briefly "Zone ID"
      described as {
        |Zone identifier.
      }
    }
    oreBlocks: OreBlock+ with {
      briefly "Ore blocks"
      described as {
        |Surveyed ore blocks.
      }
    }
  } with {
    briefly "Survey zone"
    described as {
      |Records geological survey data.
    }
  }
  command StartDrilling is {
    zoneId: ExtractionZoneId with {
      briefly "Zone ID"
      described as {
        |Zone identifier.
      }
    }
    drillPlan: String(1,2000) with {
      briefly "Plan"
      described as {
        |Drilling plan details.
      }
    }
  } with {
    briefly "Start drilling"
    described as {
      |Initiates drilling operations.
    }
  }
  command RecordBlasting is {
    zoneId: ExtractionZoneId with {
      briefly "Zone ID"
      described as {
        |Zone identifier.
      }
    }
    blastDate: Date with {
      briefly "Date"
      described as {
        |Blast date.
      }
    }
    tonnageBlasted: Decimal(12,2) with {
      briefly "Tonnage"
      described as {
        |Tonnage blasted.
      }
    }
  } with {
    briefly "Record blasting"
    described as {
      |Records blasting activity.
    }
  }
  command RecordProduction is {
    zoneId: ExtractionZoneId with {
      briefly "Zone ID"
      described as {
        |Zone identifier.
      }
    }
    production: ProductionRecord with {
      briefly "Production"
      described as {
        |Production data.
      }
    }
  } with {
    briefly "Record production"
    described as {
      |Records daily production.
    }
  }
  command RecordSafetyIncident is {
    zoneId: ExtractionZoneId with {
      briefly "Zone ID"
      described as {
        |Zone identifier.
      }
    }
    incident: SafetyIncident with {
      briefly "Incident"
      described as {
        |Safety incident.
      }
    }
  } with {
    briefly "Record safety incident"
    described as {
      |Records safety incident.
    }
  }
  command RecordEnvironmental is {
    zoneId: ExtractionZoneId with {
      briefly "Zone ID"
      described as {
        |Zone identifier.
      }
    }
    reading: EnvironmentalReading with {
      briefly "Reading"
      described as {
        |Environmental reading.
      }
    }
  } with {
    briefly "Record environmental"
    described as {
      |Records environmental monitoring.
    }
  }
  command ExhaustZone is {
    zoneId: ExtractionZoneId with {
      briefly "Zone ID"
      described as {
        |Zone identifier.
      }
    }
    exhaustDate: Date with {
      briefly "Date"
      described as {
        |Exhaustion date.
      }
    }
    totalExtracted: Decimal(15,2) with {
      briefly "Total"
      described as {
        |Total tonnage extracted.
      }
    }
  } with {
    briefly "Exhaust zone"
    described as {
      |Marks zone as exhausted.
    }
  }
  command InitiateReclamation is {
    zoneId: ExtractionZoneId with {
      briefly "Zone ID"
      described as {
        |Zone identifier.
      }
    }
    reclamationPlan: String(1,2000) with {
      briefly "Plan"
      described as {
        |Reclamation plan.
      }
    }
  } with {
    briefly "Initiate reclamation"
    described as {
      |Starts land reclamation.
    }
  }
  command RecordPermitRequirements is {
    zoneId: ExtractionZoneId with {
      briefly "extraction zone addressed"
      described as {
        |Extraction zone addressed.
      }
    }
    permitId: UUID with {
      briefly "permit id"
      described as {
        |Permit id.
      }
    }
    requirements: String(1,500)+ with {
      briefly "requirements"
      described as {
        |Requirements.
      }
    }
    expirationDate: Date with {
      briefly "expiration date"
      described as {
        |Expiration date.
      }
    }
  } with {
    briefly "Record permit requirements"
    described as {
      |Carries an answer obtained from an external service into the extraction zone.
    }
  }
  // Events
  event ZoneCreated is {
    zoneId: ExtractionZoneId with {
      briefly "Zone"
      described as {
        |Zone ID.
      }
    }
    zone: ZoneInfo with {
      briefly "Zone"
      described as {
        |Zone info.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Zone created"
    described as {
      |Emitted when zone is created.
    }
  }
  event ZoneSurveyed is {
    zoneId: ExtractionZoneId with {
      briefly "Zone"
      described as {
        |Zone ID.
      }
    }
    blockCount: Natural with {
      briefly "Blocks"
      described as {
        |Number of blocks.
      }
    }
    surveyedAt: TimeStamp with {
      briefly "Surveyed"
      described as {
        |Survey time.
      }
    }
  } with {
    briefly "Zone surveyed"
    described as {
      |Emitted when survey completes.
    }
  }
  event DrillingStarted is {
    zoneId: ExtractionZoneId with {
      briefly "Zone"
      described as {
        |Zone ID.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
  } with {
    briefly "Drilling started"
    described as {
      |Emitted when drilling starts.
    }
  }
  event BlastingRecorded is {
    zoneId: ExtractionZoneId with {
      briefly "Zone"
      described as {
        |Zone ID.
      }
    }
    tonnage: Decimal(12,2) with {
      briefly "Tonnage"
      described as {
        |Tonnage blasted.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Blasting recorded"
    described as {
      |Emitted when blasting is recorded.
    }
  }
  event ProductionRecorded is {
    zoneId: ExtractionZoneId with {
      briefly "Zone"
      described as {
        |Zone ID.
      }
    }
    production: ProductionRecord with {
      briefly "Production"
      described as {
        |Production data.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Production recorded"
    described as {
      |Emitted when production is recorded.
    }
  }
  event SafetyIncidentRecorded is {
    zoneId: ExtractionZoneId with {
      briefly "Zone"
      described as {
        |Zone ID.
      }
    }
    incident: SafetyIncident with {
      briefly "Incident"
      described as {
        |Incident data.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Safety incident recorded"
    described as {
      |Emitted when incident is recorded.
    }
  }
  event EnvironmentalRecorded is {
    zoneId: ExtractionZoneId with {
      briefly "Zone"
      described as {
        |Zone ID.
      }
    }
    reading: EnvironmentalReading with {
      briefly "Reading"
      described as {
        |Reading data.
      }
    }
  } with {
    briefly "Environmental recorded"
    described as {
      |Emitted when reading is recorded.
    }
  }
  event ZoneExhausted is {
    zoneId: ExtractionZoneId with {
      briefly "Zone"
      described as {
        |Zone ID.
      }
    }
    totalExtracted: Decimal(15,2) with {
      briefly "Total"
      described as {
        |Total extracted.
      }
    }
    exhaustedAt: TimeStamp with {
      briefly "Exhausted"
      described as {
        |Exhaustion time.
      }
    }
  } with {
    briefly "Zone exhausted"
    described as {
      |Emitted when zone is exhausted.
    }
  }
  event ReclamationInitiated is {
    zoneId: ExtractionZoneId with {
      briefly "Zone"
      described as {
        |Zone ID.
      }
    }
    initiatedAt: TimeStamp with {
      briefly "Initiated"
      described as {
        |Initiation time.
      }
    }
  } with {
    briefly "Reclamation initiated"
    described as {
      |Emitted when reclamation starts.
    }
  }
  event PermitRequirementsRecorded is {
    zoneId: ExtractionZoneId with {
      briefly "extraction zone addressed"
      described as {
        |Extraction zone addressed.
      }
    }
    permitId: UUID with {
      briefly "permit id"
      described as {
        |Permit id.
      }
    }
    requirements: String(1,500)+ with {
      briefly "requirements"
      described as {
        |Requirements.
      }
    }
    expirationDate: Date with {
      briefly "expiration date"
      described as {
        |Expiration date.
      }
    }
    recordedAt: TimeStamp with {
      briefly "when it was recorded"
      described as {
        |When it was recorded.
      }
    }
  } with {
    briefly "Permit requirements recorded"
    described as {
      |Emitted when record permit requirements has been applied.
    }
  }
  // States
  record ActiveStateData is {
    zoneId: ExtractionZoneId with {
      briefly "Zone"
      described as {
        |Zone ID.
      }
    }
    zone: ZoneInfo with {
      briefly "Zone"
      described as {
        |Zone info.
      }
    }
    updatedOreBlocks: OreBlock* with {
      briefly "Blocks"
      described as {
        |Ore blocks.
      }
    }
    productionHistory: ProductionRecord* with {
      briefly "Production"
      described as {
        |Production history.
      }
    }
    safetyIncidents: SafetyIncident* with {
      briefly "Incidents"
      described as {
        |Safety incidents.
      }
    }
    environmentalReadings: EnvironmentalReading* with {
      briefly "Readings"
      described as {
        |Environmental readings.
      }
    }
    status: ZoneStatus with {
      briefly "Status"
      described as {
        |Zone status.
      }
    }
    totalExtracted: Decimal(15,2) with {
      briefly "Extracted"
      described as {
        |Total extracted.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Active zone state"
    described as {
      |State for active extraction zone.
    }
  }
  record ClosedStateData is {
    zoneId: ExtractionZoneId with {
      briefly "Zone"
      described as {
        |Zone ID.
      }
    }
    zone: ZoneInfo with {
      briefly "Zone"
      described as {
        |Zone info.
      }
    }
    totalExtracted: Decimal(15,2) with {
      briefly "Extracted"
      described as {
        |Total extracted.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed"
      described as {
        |Close time.
      }
    }
    status: ZoneStatus with {
      briefly "Status"
      described as {
        |Final status.
      }
    }
  } with {
    briefly "Closed zone state"
    described as {
      |State for closed zone.
    }
  }
  state ActiveState of record ExtractionZone.ActiveStateData is {
    initial handler ActiveStateInitHandler is {
      on query GetExtractionZone is {
        let extractionZoneResult: type ExtractionZoneResult = prompt("read the extraction zone from the store")
        reply extractionZoneResult
      }
      on exhaustZone: command ExhaustZone is {
        morph entity MineContext.ExtractionZone to state MineContext.ExtractionZone.ClosedState with record ExtractionZone.ClosedStateData(zoneId = exhaustZone.zoneId, totalExtracted = exhaustZone.totalExtracted, zone = ActiveStateData.zone, closedAt = prompt("the closed at of this closed state data"), status = ActiveStateData.status)
        tell event ZoneExhausted(zoneId = exhaustZone.zoneId, totalExtracted = exhaustZone.totalExtracted, exhaustedAt = system.now) to entity MineContext.ExtractionZone
      }
    } with {
      briefly "ActiveState initialization"
      described as {
        |Initializes ActiveState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |The active state of the ExtractionZone entity, carrying ActiveStateData.
    }
  }
  state ClosedState of record ExtractionZone.ClosedStateData with {
    briefly "Closed state"
    described as {
      |The closed state of the ExtractionZone entity, carrying ClosedStateData.
    }
  }
  handler ExtractionZoneHandler is {
    on init(zone: type ZoneInfo) is {
      morph entity MineContext.ExtractionZone to state MineContext.ExtractionZone.ActiveState with record ExtractionZone.ActiveStateData(zoneId = self.id, zone = zone, updatedOreBlocks = empty, productionHistory = empty, safetyIncidents = empty, environmentalReadings = empty, status = prompt("the status of this active state data"), totalExtracted = prompt("the total extracted of this active state data"), createdAt = prompt("the created at of this active state data"))
      tell event ZoneCreated(zoneId = self.id, zone = zone, createdAt = prompt("the created at of this zone created")) to entity MineContext.ExtractionZone
    }
    on surveyZone: command SurveyZone is {
      tell event ZoneSurveyed(zoneId = surveyZone.zoneId, blockCount = prompt("the block count of this zone surveyed"), surveyedAt = system.now) to entity MineContext.ExtractionZone
    }
    on startDrilling: command StartDrilling is {
      tell event DrillingStarted(zoneId = startDrilling.zoneId, startedAt = system.now) to entity MineContext.ExtractionZone
    }
    on recordBlasting: command RecordBlasting is {
      tell event BlastingRecorded(zoneId = recordBlasting.zoneId, tonnage = prompt("the tonnage of this blasting recorded"), recordedAt = system.now) to entity MineContext.ExtractionZone
    }
    on recordProduction: command RecordProduction is {
      tell event ProductionRecorded(zoneId = recordProduction.zoneId, production = recordProduction.production, recordedAt = system.now) to entity MineContext.ExtractionZone
    }
    on recordSafetyIncident: command RecordSafetyIncident is {
      tell event SafetyIncidentRecorded(zoneId = recordSafetyIncident.zoneId, incident = recordSafetyIncident.incident, recordedAt = system.now) to entity MineContext.ExtractionZone
    }
    on recordEnvironmental: command RecordEnvironmental is {
      tell event EnvironmentalRecorded(zoneId = recordEnvironmental.zoneId, reading = recordEnvironmental.reading) to entity MineContext.ExtractionZone
    }
    on initiateReclamation: command InitiateReclamation is {
      tell event ReclamationInitiated(zoneId = initiateReclamation.zoneId, initiatedAt = system.now) to entity MineContext.ExtractionZone
    }
    on recordPermitRequirements: command RecordPermitRequirements is {
      tell event PermitRequirementsRecorded(zoneId = recordPermitRequirements.zoneId, permitId = recordPermitRequirements.permitId, requirements = recordPermitRequirements.requirements, expirationDate = recordPermitRequirements.expirationDate, recordedAt = system.now) to entity MineContext.ExtractionZone
    }
    on blastingRecorded: event BlastingRecorded is {
      do "apply BlastingRecorded to the extractionZone so it can be persisted and replayed"
    }
    on drillingStarted: event DrillingStarted is {
      do "apply DrillingStarted to the extractionZone so it can be persisted and replayed"
    }
    on environmentalRecorded: event EnvironmentalRecorded is {
      do "apply EnvironmentalRecorded to the extractionZone so it can be persisted and replayed"
    }
    on productionRecorded: event ProductionRecorded is {
      do "apply ProductionRecorded to the extractionZone so it can be persisted and replayed"
    }
    on reclamationInitiated: event ReclamationInitiated is {
      do "apply ReclamationInitiated to the extractionZone so it can be persisted and replayed"
    }
    on safetyIncidentRecorded: event SafetyIncidentRecorded is {
      do "apply SafetyIncidentRecorded to the extractionZone so it can be persisted and replayed"
    }
    on zoneCreated: event ZoneCreated is {
      do "apply ZoneCreated to the extractionZone so it can be persisted and replayed"
    }
    on zoneExhausted: event ZoneExhausted is {
      do "apply ZoneExhausted to the extractionZone so it can be persisted and replayed"
    }
    on zoneSurveyed: event ZoneSurveyed is {
      do "apply ZoneSurveyed to the extractionZone so it can be persisted and replayed"
    }
    on permitRequirementsRecorded: event PermitRequirementsRecorded is {
      do "apply PermitRequirementsRecorded to the extraction zone so it can be persisted and replayed"
    }
  } with {
    briefly "Processes extraction zone commands"
    described as {
      |Handles zone lifecycle and operations.
    }
  }
} with {
  briefly "ExtractionZone aggregate"
  described as {
    |Manages mining extraction zones.
  }
}
