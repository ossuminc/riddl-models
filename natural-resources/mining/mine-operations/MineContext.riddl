// Mine Operations - Mine Context
context MineContext is {
  adaptor FromEnvironmentalComplianceService from context EnvironmentalComplianceService is { 
    handler FromEnvironmentalComplianceServiceHandler is {
      on event EnvironmentalComplianceService.ComplianceReportSubmitted is {
        do "the model receives compliance report submitted"
      }
      on result EnvironmentalComplianceService.PermitRequirements is {
        do "the model receives permit requirements"
      }
      on other is {
        error "Unexpected message for adaptor FromEnvironmentalComplianceService"
      }
    } with {
      briefly "from environmental compliance service"
      described as {
        |Carries messages from the external EnvironmentalComplianceService.
      }
    }
  } with {
    briefly "EnvironmentalComplianceService integration"
    described as {
      |The model's side of the EnvironmentalComplianceService conversation.
    }
  }
  adaptor ToEnvironmentalComplianceService to context EnvironmentalComplianceService is { 
    handler ToEnvironmentalComplianceServiceHandler is {
      on query EnvironmentalComplianceService.GetPermitRequirements is {
        do "the model sends get permit requirements"
      }
      on command EnvironmentalComplianceService.SubmitComplianceReport is {
        do "the model sends submit compliance report"
      }
      on other is {
        error "Unexpected message for adaptor ToEnvironmentalComplianceService"
      }
    } with {
      briefly "to environmental compliance service"
      described as {
        |Carries messages to the external EnvironmentalComplianceService.
      }
    }
  } with {
    briefly "EnvironmentalComplianceService integration"
    described as {
      |The model's side of the EnvironmentalComplianceService conversation.
    }
  }
  adaptor FromEquipmentManagementService from context EquipmentManagementService is { 
    handler FromEquipmentManagementServiceHandler is {
      on event EquipmentManagementService.EquipmentDispatched is {
        do "the model receives equipment dispatched"
      }
      on result EquipmentManagementService.EquipmentStatus is {
        do "the model receives equipment status"
      }
      on other is {
        error "Unexpected message for adaptor FromEquipmentManagementService"
      }
    } with {
      briefly "from equipment management service"
      described as {
        |Carries messages from the external EquipmentManagementService.
      }
    }
  } with {
    briefly "EquipmentManagementService integration"
    described as {
      |The model's side of the EquipmentManagementService conversation.
    }
  }
  adaptor ToEquipmentManagementService to context EquipmentManagementService is { 
    handler ToEquipmentManagementServiceHandler is {
      on command EquipmentManagementService.DispatchEquipment is {
        do "the model sends dispatch equipment"
      }
      on query EquipmentManagementService.GetEquipmentStatus is {
        do "the model sends get equipment status"
      }
      on other is {
        error "Unexpected message for adaptor ToEquipmentManagementService"
      }
    } with {
      briefly "to equipment management service"
      described as {
        |Carries messages to the external EquipmentManagementService.
      }
    }
  } with {
    briefly "EquipmentManagementService integration"
    described as {
      |The model's side of the EquipmentManagementService conversation.
    }
  }
  adaptor FromGeologicalSurveyService from context GeologicalSurveyService is { 
    handler FromGeologicalSurveyServiceHandler is {
      on result GeologicalSurveyService.OreBodyModel is {
        do "the model receives ore body model"
      }
      on other is {
        error "Unexpected message for adaptor FromGeologicalSurveyService"
      }
    } with {
      briefly "from geological survey service"
      described as {
        |Carries messages from the external GeologicalSurveyService.
      }
    }
  } with {
    briefly "GeologicalSurveyService integration"
    described as {
      |The model's side of the GeologicalSurveyService conversation.
    }
  }
  adaptor ToGeologicalSurveyService to context GeologicalSurveyService is { 
    handler ToGeologicalSurveyServiceHandler is {
      on query GeologicalSurveyService.GetOreBodyModel is {
        do "the model sends get ore body model"
      }
      on other is {
        error "Unexpected message for adaptor ToGeologicalSurveyService"
      }
    } with {
      briefly "to geological survey service"
      described as {
        |Carries messages to the external GeologicalSurveyService.
      }
    }
  } with {
    briefly "GeologicalSurveyService integration"
    described as {
      |The model's side of the GeologicalSurveyService conversation.
    }
  }
  include "types.riddl"
  include "ExtractionZone.riddl"
  repository MineRepository as merge is {
    inlet MineRepositoryFromExtractionZone is type ExtractionZoneEvent    inlet MineRepositoryFromProductionAnalytics is type ExtractionZoneEvent    outlet MineRepositoryResponses is type ExtractionZone.ExtractionZoneResult
    record StoredExtractionZone is  {
      extractionZoneId: ExtractionZoneId with {
        briefly "extractionZoneId"
        described as {
          |The extractionZoneId column of the stored extractionZone row.
        }
      }
      status: ZoneStatus with {
        briefly "status"
        described as {
          |The status column of the stored extractionZone row.
        }
      }
      zone: ZoneInfo with {
        briefly "zone"
        described as {
          |The zone column of the stored extractionZone row.
        }
      }
      zoneId: ExtractionZoneId with {
        briefly "zoneId"
        described as {
          |The zoneId column of the stored extractionZone row.
        }
      }
    } with {
      briefly "Stored extractionZone row"
      described as {
        |The persistence shape of extractionZone data as this repository stores it.
      }
    }
    schema MineData is relational
      of extractionZones as type StoredExtractionZone
        index on field StoredExtractionZone.zoneId
        index on field StoredExtractionZone.zone.mineId
        index on field StoredExtractionZone.status
 with {
      briefly "Mine data schema"
      described as {
        |The relational schema holding mine data for the MineRepository.
      }
    }
    handler MinePersistence is {
      on query GetDailyProduction is {
        do "read the daily production projection"
        reply result DailyProductionView
      }
      on query GetSafetyMetrics is {
        do "read the safety metrics projection"
        reply result SafetyMetricsView
      }
      on command ExtractionZone.CreateZone is {
        tell event ExtractionZone.ZoneCreated to entity MineContext.ExtractionZone
        do "Store new extraction zone"
      }
      on command ExtractionZone.SurveyZone is {
        do "Store survey data"
      }
      on command ExtractionZone.RecordProduction is {
        tell event ExtractionZone.ProductionRecorded to entity MineContext.ExtractionZone
        do "Store production record"
      }
      on command ExtractionZone.RecordSafetyIncident is {
        tell event ExtractionZone.SafetyIncidentRecorded to entity MineContext.ExtractionZone
        do "Store safety incident"
      }
      on command ExtractionZone.RecordEnvironmental is {
        tell event ExtractionZone.EnvironmentalRecorded to entity MineContext.ExtractionZone
        do "Store environmental reading"
      }
      on command ExtractionZone.ExhaustZone is {
        do "Update zone to exhausted"
      }
    } with {
      briefly "Persists mine commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Mine data persistence"
    described as {
      |Persistent storage for mine operations.
    }
  }
  query GetDailyProduction is  {
    dailyProductionKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily production to retrieve.
      }
    }
  } with {
    briefly "Get daily production"
    described as {
      |Retrieves the daily production projection.
    }
  }
  result DailyProductionView is  {
    dailyProduction: ProductionAnalytics.DailyProduction with {
      briefly "Daily production"
      described as {
        |The daily production being returned.
      }
    }
  } with {
    briefly "Daily production view"
    described as {
      |Read model view carrying the daily production projection.
    }
  }
  query GetSafetyMetrics is  {
    safetyMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which safety metrics to retrieve.
      }
    }
  } with {
    briefly "Get safety metrics"
    described as {
      |Retrieves the safety metrics projection.
    }
  }
  result SafetyMetricsView is  {
    safetyMetrics: ProductionAnalytics.SafetyMetrics with {
      briefly "Safety metrics"
      described as {
        |The safety metrics being returned.
      }
    }
  } with {
    briefly "Safety metrics view"
    described as {
      |Read model view carrying the safety metrics projection.
    }
  }
  projector ProductionAnalytics as flow is {
    updates repository MineContext.MineRepository
    inlet ProductionAnalyticsFromExtractionZone is type ExtractionZoneEvent    outlet ProductionAnalyticsOut is type ExtractionZoneEvent
    record DailyProduction is  {
      productionDate: Date with {
        briefly "Date"
        described as {
          |Production date.
        }
      }
      totalExtracted: Decimal(15,2) with {
        briefly "Extracted"
        described as {
          |Total extracted.
        }
      }
      totalProcessed: Decimal(15,2) with {
        briefly "Processed"
        described as {
          |Total processed.
        }
      }
      averageRecovery: Decimal(5,2) with {
        briefly "Recovery"
        described as {
          |Average recovery rate.
        }
      }
    } with {
      briefly "Daily production"
      described as {
        |Daily production summary.
      }
    }
    record SafetyMetrics is  {
      lostTimeIncidents: Natural with {
        briefly "LTI"
        described as {
          |Lost time incidents.
        }
      }
      nearMisses: Natural with {
        briefly "Near misses"
        described as {
          |Near miss incidents.
        }
      }
      daysWithoutIncident: Natural with {
        briefly "Safe days"
        described as {
          |Days without incident.
        }
      }
    } with {
      briefly "Safety metrics"
      described as {
        |Safety performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on event ExtractionZone.ProductionRecorded is {
        tell event ExtractionZone.ProductionRecorded to repository MineContext.MineRepository
        do "Update production analytics"
      }
      on event ExtractionZone.SafetyIncidentRecorded is {
        tell event ExtractionZone.SafetyIncidentRecorded to repository MineContext.MineRepository
        do "Update safety metrics"
      }
    } with {
      briefly "Maintains production analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Production analytics"
    described as {
      |Mining production analytics.
    }
  }
  // ---- Event publication for ExtractionZone ----
  type ExtractionZoneEvent is one of {
    MineContext.ExtractionZone.ZoneCreated or MineContext.ExtractionZone.ZoneSurveyed or MineContext.ExtractionZone.DrillingStarted or MineContext.ExtractionZone.BlastingRecorded or MineContext.ExtractionZone.ProductionRecorded or MineContext.ExtractionZone.SafetyIncidentRecorded or MineContext.ExtractionZone.EnvironmentalRecorded or MineContext.ExtractionZone.ZoneExhausted or MineContext.ExtractionZone.ReclamationInitiated
  } with {
    briefly "ExtractionZone event alternation"
    described as {
      |Union of all ExtractionZone events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ExtractionZoneEventSource as source is {
    outlet ExtractionZoneEvents is type ExtractionZoneEvent
    handler ExtractionZoneSourceHandler is {
      on event ExtractionZone.ZoneCreated is {
        send event ExtractionZone.ZoneCreated to outlet ExtractionZoneEvents
      }
      on event ExtractionZone.ZoneSurveyed is {
        send event ExtractionZone.ZoneSurveyed to outlet ExtractionZoneEvents
      }
      on event ExtractionZone.DrillingStarted is {
        send event ExtractionZone.DrillingStarted to outlet ExtractionZoneEvents
      }
      on event ExtractionZone.BlastingRecorded is {
        send event ExtractionZone.BlastingRecorded to outlet ExtractionZoneEvents
      }
      on event ExtractionZone.ProductionRecorded is {
        send event ExtractionZone.ProductionRecorded to outlet ExtractionZoneEvents
      }
      on event ExtractionZone.SafetyIncidentRecorded is {
        send event ExtractionZone.SafetyIncidentRecorded to outlet ExtractionZoneEvents
      }
      on event ExtractionZone.EnvironmentalRecorded is {
        send event ExtractionZone.EnvironmentalRecorded to outlet ExtractionZoneEvents
      }
      on event ExtractionZone.ZoneExhausted is {
        send event ExtractionZone.ZoneExhausted to outlet ExtractionZoneEvents
      }
      on event ExtractionZone.ReclamationInitiated is {
        send event ExtractionZone.ReclamationInitiated to outlet ExtractionZoneEvents
      }
      on other is {
        error "Unexpected message for source ExtractionZoneEventSource"
      }
    } with {
      briefly "ExtractionZone source handler"
      described as {
        |Publishes ExtractionZone events onto the outlet.
      }
    }
  } with {
    briefly "ExtractionZone event source"
    described as {
      |Publishes ExtractionZone entity events into the streaming topology.
    }
  }
  processor ExtractionZoneEventSink as sink is {
    inlet ExtractionZoneInlet is type ExtractionZoneEvent    handler ExtractionZoneSinkHandler is {
      on event ExtractionZone.ZoneCreated is {
        tell event ExtractionZone.ZoneCreated to repository MineContext.MineRepository
      }
      on event ExtractionZone.ZoneSurveyed is {
        tell event ExtractionZone.ZoneSurveyed to repository MineContext.MineRepository
      }
      on event ExtractionZone.DrillingStarted is {
        tell event ExtractionZone.DrillingStarted to repository MineContext.MineRepository
      }
      on event ExtractionZone.BlastingRecorded is {
        tell event ExtractionZone.BlastingRecorded to repository MineContext.MineRepository
      }
      on event ExtractionZone.ProductionRecorded is {
        tell event ExtractionZone.ProductionRecorded to repository MineContext.MineRepository
      }
      on event ExtractionZone.SafetyIncidentRecorded is {
        tell event ExtractionZone.SafetyIncidentRecorded to repository MineContext.MineRepository
      }
      on event ExtractionZone.EnvironmentalRecorded is {
        tell event ExtractionZone.EnvironmentalRecorded to repository MineContext.MineRepository
      }
      on event ExtractionZone.ZoneExhausted is {
        tell event ExtractionZone.ZoneExhausted to repository MineContext.MineRepository
      }
      on event ExtractionZone.ReclamationInitiated is {
        tell event ExtractionZone.ReclamationInitiated to repository MineContext.MineRepository
      }
      on other is {
        error "Unexpected message for sink ExtractionZoneEventSink"
      }
    } with {
      briefly "ExtractionZone sink handler"
      described as {
        |Persists ExtractionZone events via the repository.
      }
    }
  } with {
    briefly "ExtractionZone event sink"
    described as {
      |Receives ExtractionZone events for persistence.
    }
  }
  connector ExtractionZoneEventFlow is from outlet MineContext.ExtractionZoneEventSource.ExtractionZoneEvents to inlet MineContext.ExtractionZoneEventSink.ExtractionZoneInlet with {
    briefly "ExtractionZone event flow"
    described as {
      |Connects the ExtractionZone source to its sink.
    }
  }
  processor ExtractionZoneEventSplit as split is {
    inlet ExtractionZoneEventSplitIn is type ExtractionZoneEvent    outlet ExtractionZoneEventSplitToMineRepository is type ExtractionZoneEvent
    outlet ExtractionZoneEventSplitToProductionAnalytics is type ExtractionZoneEvent
    handler ExtractionZoneEventSplitHandler is {
      on event ExtractionZone.ZoneCreated is {
        send event ExtractionZone.ZoneCreated to outlet ExtractionZoneEventSplitToMineRepository
        send event ExtractionZone.ZoneCreated to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell event ExtractionZone.ZoneCreated to entity MineContext.ExtractionZone
      }
      on event ExtractionZone.ZoneSurveyed is {
        send event ExtractionZone.ZoneSurveyed to outlet ExtractionZoneEventSplitToMineRepository
        send event ExtractionZone.ZoneSurveyed to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell event ExtractionZone.ZoneSurveyed to entity MineContext.ExtractionZone
      }
      on event ExtractionZone.DrillingStarted is {
        send event ExtractionZone.DrillingStarted to outlet ExtractionZoneEventSplitToMineRepository
        send event ExtractionZone.DrillingStarted to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell event ExtractionZone.DrillingStarted to entity MineContext.ExtractionZone
      }
      on event ExtractionZone.BlastingRecorded is {
        send event ExtractionZone.BlastingRecorded to outlet ExtractionZoneEventSplitToMineRepository
        send event ExtractionZone.BlastingRecorded to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell event ExtractionZone.BlastingRecorded to entity MineContext.ExtractionZone
      }
      on event ExtractionZone.ProductionRecorded is {
        send event ExtractionZone.ProductionRecorded to outlet ExtractionZoneEventSplitToMineRepository
        send event ExtractionZone.ProductionRecorded to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell event ExtractionZone.ProductionRecorded to entity MineContext.ExtractionZone
      }
      on event ExtractionZone.SafetyIncidentRecorded is {
        send event ExtractionZone.SafetyIncidentRecorded to outlet ExtractionZoneEventSplitToMineRepository
        send event ExtractionZone.SafetyIncidentRecorded to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell event ExtractionZone.SafetyIncidentRecorded to entity MineContext.ExtractionZone
      }
      on event ExtractionZone.EnvironmentalRecorded is {
        send event ExtractionZone.EnvironmentalRecorded to outlet ExtractionZoneEventSplitToMineRepository
        send event ExtractionZone.EnvironmentalRecorded to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell event ExtractionZone.EnvironmentalRecorded to entity MineContext.ExtractionZone
      }
      on event ExtractionZone.ZoneExhausted is {
        send event ExtractionZone.ZoneExhausted to outlet ExtractionZoneEventSplitToMineRepository
        send event ExtractionZone.ZoneExhausted to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell event ExtractionZone.ZoneExhausted to entity MineContext.ExtractionZone
      }
      on event ExtractionZone.ReclamationInitiated is {
        send event ExtractionZone.ReclamationInitiated to outlet ExtractionZoneEventSplitToMineRepository
        send event ExtractionZone.ReclamationInitiated to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell event ExtractionZone.ReclamationInitiated to entity MineContext.ExtractionZone
      }
      on other is {
        error "Unexpected message for processor ExtractionZoneEventSplit"
      }
    } with {
      briefly "ExtractionZone event fan-out handler"
      described as {
        |Delivers each ExtractionZone event to all of its consumers.
      }
    }
  } with {
    briefly "ExtractionZone event fan-out"
    described as {
      |Fans ExtractionZone events out to the repository and projectors.
    }
  }
  connector 'ExtractionZoneEvent Stream' is from outlet MineContext.ExtractionZone.ExtractionZoneEvents2 to inlet MineContext.ExtractionZoneEventSplit.ExtractionZoneEventSplitIn with {
    briefly "ExtractionZone events, fanned out to storage and read models"
  }
  connector 'ExtractionZoneEvent Storage' is from outlet MineContext.ExtractionZoneEventSplit.ExtractionZoneEventSplitToMineRepository to inlet MineContext.MineRepository.MineRepositoryFromExtractionZone with {
    briefly "ExtractionZone events on their way to storage"
  }
  connector 'ProductionAnalytics Feed' is from outlet MineContext.ExtractionZoneEventSplit.ExtractionZoneEventSplitToProductionAnalytics to inlet MineContext.ProductionAnalytics.ProductionAnalyticsFromExtractionZone with {
    briefly "ExtractionZone events feeding the ProductionAnalytics projection"
  }
  connector 'ProductionAnalytics Storage' is from outlet MineContext.ProductionAnalytics.ProductionAnalyticsOut to inlet MineContext.MineRepository.MineRepositoryFromProductionAnalytics with {
    briefly "The ProductionAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for mine operations"
  described as {
    |Mine extraction and processing context.
  }
}
