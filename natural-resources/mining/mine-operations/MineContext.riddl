// Mine Operations - Mine Context
context MineContext as router is {
  inlet ExtractionZoneCommandStreamIn is type ExtractionZoneCommand  outlet ExtractionZoneCommandStreamOut is type ExtractionZoneCommand
  inlet ExtractionZoneResultStreamIn is result ExtractionZone.ExtractionZoneResult  outlet ExtractionZoneResultStreamOut is result ExtractionZone.ExtractionZoneResult
  handler MineContextBoundary is {
    on createZone: command ExtractionZone.CreateZone is {
      send createZone to outlet MineContext.ExtractionZoneCommandStreamOut
    }
    on surveyZone: command ExtractionZone.SurveyZone is {
      send surveyZone to outlet MineContext.ExtractionZoneCommandStreamOut
    }
    on startDrilling: command ExtractionZone.StartDrilling is {
      send startDrilling to outlet MineContext.ExtractionZoneCommandStreamOut
    }
    on recordBlasting: command ExtractionZone.RecordBlasting is {
      send recordBlasting to outlet MineContext.ExtractionZoneCommandStreamOut
    }
    on recordProduction: command ExtractionZone.RecordProduction is {
      send recordProduction to outlet MineContext.ExtractionZoneCommandStreamOut
    }
    on recordSafetyIncident: command ExtractionZone.RecordSafetyIncident is {
      send recordSafetyIncident to outlet MineContext.ExtractionZoneCommandStreamOut
    }
    on recordEnvironmental: command ExtractionZone.RecordEnvironmental is {
      send recordEnvironmental to outlet MineContext.ExtractionZoneCommandStreamOut
    }
    on exhaustZone: command ExtractionZone.ExhaustZone is {
      send exhaustZone to outlet MineContext.ExtractionZoneCommandStreamOut
    }
    on initiateReclamation: command ExtractionZone.InitiateReclamation is {
      send initiateReclamation to outlet MineContext.ExtractionZoneCommandStreamOut
    }
    on extractionZoneResult: result ExtractionZone.ExtractionZoneResult is {
      send extractionZoneResult to outlet MineContext.ExtractionZoneResultStreamOut
    }
    on other is {
      error "Unexpected message at the MineContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ExtractionZoneCommand Stream Intake' is from outlet MineContext.ExtractionZoneCommandStreamOut to inlet MineContext.ExtractionZone.ExtractionZoneCommands  connector 'ExtractionZoneResult Stream Egress' is from outlet MineContext.MineRepository.MineRepositoryResponses to inlet MineContext.ExtractionZoneResultStreamIn  adaptor FromEnvironmentalComplianceService from context EnvironmentalComplianceService is { 
    handler FromEnvironmentalComplianceServiceHandler is {
      on event EnvironmentalComplianceService.ComplianceReportSubmitted is {
        do "the model receives compliance report submitted"
      }
      on result EnvironmentalComplianceService.PermitRequirements is {
        do "the model receives permit requirements"
      }
      on other is {
        error "Unexpected message for adaptor FromEnvironmentalComplianceService"
      }
    } with {
      briefly "from environmental compliance service"
      described as {
        |Carries messages from the external EnvironmentalComplianceService.
      }
    }
  } with {
    briefly "EnvironmentalComplianceService integration"
    described as {
      |The model's side of the EnvironmentalComplianceService conversation.
    }
  }
  adaptor ToEnvironmentalComplianceService to context EnvironmentalComplianceService is { 
    handler ToEnvironmentalComplianceServiceHandler is {
      on query EnvironmentalComplianceService.GetPermitRequirements is {
        do "the model sends get permit requirements"
      }
      on command EnvironmentalComplianceService.SubmitComplianceReport is {
        do "the model sends submit compliance report"
      }
      on other is {
        error "Unexpected message for adaptor ToEnvironmentalComplianceService"
      }
    } with {
      briefly "to environmental compliance service"
      described as {
        |Carries messages to the external EnvironmentalComplianceService.
      }
    }
  } with {
    briefly "EnvironmentalComplianceService integration"
    described as {
      |The model's side of the EnvironmentalComplianceService conversation.
    }
  }
  adaptor FromEquipmentManagementService from context EquipmentManagementService is { 
    handler FromEquipmentManagementServiceHandler is {
      on event EquipmentManagementService.EquipmentDispatched is {
        do "the model receives equipment dispatched"
      }
      on result EquipmentManagementService.EquipmentStatus is {
        do "the model receives equipment status"
      }
      on other is {
        error "Unexpected message for adaptor FromEquipmentManagementService"
      }
    } with {
      briefly "from equipment management service"
      described as {
        |Carries messages from the external EquipmentManagementService.
      }
    }
  } with {
    briefly "EquipmentManagementService integration"
    described as {
      |The model's side of the EquipmentManagementService conversation.
    }
  }
  adaptor ToEquipmentManagementService to context EquipmentManagementService is { 
    handler ToEquipmentManagementServiceHandler is {
      on command EquipmentManagementService.DispatchEquipment is {
        do "the model sends dispatch equipment"
      }
      on query EquipmentManagementService.GetEquipmentStatus is {
        do "the model sends get equipment status"
      }
      on other is {
        error "Unexpected message for adaptor ToEquipmentManagementService"
      }
    } with {
      briefly "to equipment management service"
      described as {
        |Carries messages to the external EquipmentManagementService.
      }
    }
  } with {
    briefly "EquipmentManagementService integration"
    described as {
      |The model's side of the EquipmentManagementService conversation.
    }
  }
  adaptor FromGeologicalSurveyService from context GeologicalSurveyService is { 
    handler FromGeologicalSurveyServiceHandler is {
      on result GeologicalSurveyService.OreBodyModel is {
        do "the model receives ore body model"
      }
      on other is {
        error "Unexpected message for adaptor FromGeologicalSurveyService"
      }
    } with {
      briefly "from geological survey service"
      described as {
        |Carries messages from the external GeologicalSurveyService.
      }
    }
  } with {
    briefly "GeologicalSurveyService integration"
    described as {
      |The model's side of the GeologicalSurveyService conversation.
    }
  }
  adaptor ToGeologicalSurveyService to context GeologicalSurveyService is { 
    handler ToGeologicalSurveyServiceHandler is {
      on query GeologicalSurveyService.GetOreBodyModel is {
        do "the model sends get ore body model"
      }
      on other is {
        error "Unexpected message for adaptor ToGeologicalSurveyService"
      }
    } with {
      briefly "to geological survey service"
      described as {
        |Carries messages to the external GeologicalSurveyService.
      }
    }
  } with {
    briefly "GeologicalSurveyService integration"
    described as {
      |The model's side of the GeologicalSurveyService conversation.
    }
  }
  include "types.riddl"
  include "ExtractionZone.riddl"
  type MineRepositoryCommand is one of {
    MineContext.MineRepository.PersistBlastingRecorded or MineContext.MineRepository.PersistDrillingStarted or MineContext.MineRepository.PersistEnvironmentalRecorded or MineContext.MineRepository.PersistProductionRecorded or MineContext.MineRepository.PersistReclamationInitiated or MineContext.MineRepository.PersistSafetyIncidentRecorded or MineContext.MineRepository.PersistZoneCreated or MineContext.MineRepository.PersistZoneExhausted or MineContext.MineRepository.PersistZoneSurveyed
  } with {
    briefly "Anything that writes MineRepository"
    described as {
      |The persistence commands MineRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository MineRepository as flow is {
    inlet MineRepositoryFromProductionAnalytics is type MineRepositoryCommand    command PersistBlastingRecorded is  {
      zoneId: ExtractionZoneId with {
        briefly "Row addressed"
        described as {
          |Which stored row BlastingRecorded applies to.
        }
      }
    } with {
      briefly "Persist BlastingRecorded"
      described as {
        |Instructs this repository to apply BlastingRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDrillingStarted is  {
      zoneId: ExtractionZoneId with {
        briefly "Row addressed"
        described as {
          |Which stored row DrillingStarted applies to.
        }
      }
    } with {
      briefly "Persist DrillingStarted"
      described as {
        |Instructs this repository to apply DrillingStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEnvironmentalRecorded is  {
      zoneId: ExtractionZoneId with {
        briefly "Row addressed"
        described as {
          |Which stored row EnvironmentalRecorded applies to.
        }
      }
    } with {
      briefly "Persist EnvironmentalRecorded"
      described as {
        |Instructs this repository to apply EnvironmentalRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReclamationInitiated is  {
      zoneId: ExtractionZoneId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReclamationInitiated applies to.
        }
      }
    } with {
      briefly "Persist ReclamationInitiated"
      described as {
        |Instructs this repository to apply ReclamationInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistZoneCreated is  {
      zoneId: ExtractionZoneId with {
        briefly "Row addressed"
        described as {
          |Which stored row ZoneCreated applies to.
        }
      }
    } with {
      briefly "Persist ZoneCreated"
      described as {
        |Instructs this repository to apply ZoneCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistZoneExhausted is  {
      zoneId: ExtractionZoneId with {
        briefly "Row addressed"
        described as {
          |Which stored row ZoneExhausted applies to.
        }
      }
    } with {
      briefly "Persist ZoneExhausted"
      described as {
        |Instructs this repository to apply ZoneExhausted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistZoneSurveyed is  {
      zoneId: ExtractionZoneId with {
        briefly "Row addressed"
        described as {
          |Which stored row ZoneSurveyed applies to.
        }
      }
    } with {
      briefly "Persist ZoneSurveyed"
      described as {
        |Instructs this repository to apply ZoneSurveyed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProductionRecorded is  {
      zoneId: ExtractionZoneId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProductionRecorded applies to.
        }
      }
    } with {
      briefly "Persist ProductionRecorded"
      described as {
        |Instructs this repository to apply ProductionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSafetyIncidentRecorded is  {
      zoneId: ExtractionZoneId with {
        briefly "Row addressed"
        described as {
          |Which stored row SafetyIncidentRecorded applies to.
        }
      }
    } with {
      briefly "Persist SafetyIncidentRecorded"
      described as {
        |Instructs this repository to apply SafetyIncidentRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet MineRepositoryResponses is result ExtractionZone.ExtractionZoneResult
    record StoredExtractionZone is  {
      extractionZoneId: ExtractionZoneId with {
        briefly "extractionZoneId"
        described as {
          |The extractionZoneId column of the stored extractionZone row.
        }
      }
      status: ZoneStatus with {
        briefly "status"
        described as {
          |The status column of the stored extractionZone row.
        }
      }
      zone: ZoneInfo with {
        briefly "zone"
        described as {
          |The zone column of the stored extractionZone row.
        }
      }
      zoneId: ExtractionZoneId with {
        briefly "zoneId"
        described as {
          |The zoneId column of the stored extractionZone row.
        }
      }
    } with {
      briefly "Stored extractionZone row"
      described as {
        |The persistence shape of extractionZone data as this repository stores it.
      }
    }
    schema MineData is relational
      of extractionZones as record StoredExtractionZone
        index on field StoredExtractionZone.zoneId
        index on field StoredExtractionZone.zone.mineId
        index on field StoredExtractionZone.status
 with {
      briefly "Mine data schema"
      described as {
        |The relational schema holding mine data for the MineRepository.
      }
    }
    handler MinePersistence is {
      on persistBlastingRecorded: command PersistBlastingRecorded is {
        do "apply BlastingRecorded to the stored row"
      }
      on persistDrillingStarted: command PersistDrillingStarted is {
        do "apply DrillingStarted to the stored row"
      }
      on persistEnvironmentalRecorded: command PersistEnvironmentalRecorded is {
        do "apply EnvironmentalRecorded to the stored row"
      }
      on persistReclamationInitiated: command PersistReclamationInitiated is {
        do "apply ReclamationInitiated to the stored row"
      }
      on persistZoneCreated: command PersistZoneCreated is {
        do "apply ZoneCreated to the stored row"
      }
      on persistZoneExhausted: command PersistZoneExhausted is {
        do "apply ZoneExhausted to the stored row"
      }
      on persistZoneSurveyed: command PersistZoneSurveyed is {
        do "apply ZoneSurveyed to the stored row"
      }
      on persistProductionRecorded: command PersistProductionRecorded is {
        do "apply ProductionRecorded to the stored row"
      }
      on persistSafetyIncidentRecorded: command PersistSafetyIncidentRecorded is {
        do "apply SafetyIncidentRecorded to the stored row"
      }
      on query GetDailyProduction is {
        let dailyProductionView: type DailyProductionView = prompt("read the daily production projection")
        reply dailyProductionView
      }
      on query GetSafetyMetrics is {
        let safetyMetricsView: type SafetyMetricsView = prompt("read the safety metrics projection")
        reply safetyMetricsView
      }
    } with {
      briefly "Persists mine commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Mine data persistence"
    described as {
      |Persistent storage for mine operations.
    }
  }
  query GetDailyProduction replies result DailyProductionView is  {
    dailyProductionKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily production to retrieve.
      }
    }
  } with {
    briefly "Get daily production"
    described as {
      |Retrieves the daily production projection.
    }
  }
  result DailyProductionView is  {
    dailyProduction: ProductionAnalytics.DailyProduction with {
      briefly "Daily production"
      described as {
        |The daily production being returned.
      }
    }
  } with {
    briefly "Daily production view"
    described as {
      |Read model view carrying the daily production projection.
    }
  }
  query GetSafetyMetrics replies result SafetyMetricsView is  {
    safetyMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which safety metrics to retrieve.
      }
    }
  } with {
    briefly "Get safety metrics"
    described as {
      |Retrieves the safety metrics projection.
    }
  }
  result SafetyMetricsView is  {
    safetyMetrics: ProductionAnalytics.SafetyMetrics with {
      briefly "Safety metrics"
      described as {
        |The safety metrics being returned.
      }
    }
  } with {
    briefly "Safety metrics view"
    described as {
      |Read model view carrying the safety metrics projection.
    }
  }
  projector ProductionAnalytics as flow is {
    updates repository MineContext.MineRepository
    outlet ProductionAnalyticsToRepository is type MineRepositoryCommand
    inlet ProductionAnalyticsFromExtractionZone is type ExtractionZoneEvent    record DailyProduction is  {
      productionDate: Date with {
        briefly "Date"
        described as {
          |Production date.
        }
      }
      totalExtracted: Decimal(15,2) with {
        briefly "Extracted"
        described as {
          |Total extracted.
        }
      }
      totalProcessed: Decimal(15,2) with {
        briefly "Processed"
        described as {
          |Total processed.
        }
      }
      averageRecovery: Decimal(5,2) with {
        briefly "Recovery"
        described as {
          |Average recovery rate.
        }
      }
    } with {
      briefly "Daily production"
      described as {
        |Daily production summary.
      }
    }
    record SafetyMetrics is  {
      lostTimeIncidents: Natural with {
        briefly "LTI"
        described as {
          |Lost time incidents.
        }
      }
      nearMisses: Natural with {
        briefly "Near misses"
        described as {
          |Near miss incidents.
        }
      }
      daysWithoutIncident: Natural with {
        briefly "Safe days"
        described as {
          |Days without incident.
        }
      }
    } with {
      briefly "Safety metrics"
      described as {
        |Safety performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on blastingRecorded: event ExtractionZone.BlastingRecorded is {
        tell command MineContext.MineRepository.PersistBlastingRecorded(zoneId = blastingRecorded.zoneId) to repository MineContext.MineRepository
        do "apply BlastingRecorded to the ProductionAnalytics projection"
      }
      on drillingStarted: event ExtractionZone.DrillingStarted is {
        tell command MineContext.MineRepository.PersistDrillingStarted(zoneId = drillingStarted.zoneId) to repository MineContext.MineRepository
        do "apply DrillingStarted to the ProductionAnalytics projection"
      }
      on environmentalRecorded: event ExtractionZone.EnvironmentalRecorded is {
        tell command MineContext.MineRepository.PersistEnvironmentalRecorded(zoneId = environmentalRecorded.zoneId) to repository MineContext.MineRepository
        do "apply EnvironmentalRecorded to the ProductionAnalytics projection"
      }
      on reclamationInitiated: event ExtractionZone.ReclamationInitiated is {
        tell command MineContext.MineRepository.PersistReclamationInitiated(zoneId = reclamationInitiated.zoneId) to repository MineContext.MineRepository
        do "apply ReclamationInitiated to the ProductionAnalytics projection"
      }
      on zoneCreated: event ExtractionZone.ZoneCreated is {
        tell command MineContext.MineRepository.PersistZoneCreated(zoneId = zoneCreated.zoneId) to repository MineContext.MineRepository
        do "apply ZoneCreated to the ProductionAnalytics projection"
      }
      on zoneExhausted: event ExtractionZone.ZoneExhausted is {
        tell command MineContext.MineRepository.PersistZoneExhausted(zoneId = zoneExhausted.zoneId) to repository MineContext.MineRepository
        do "apply ZoneExhausted to the ProductionAnalytics projection"
      }
      on zoneSurveyed: event ExtractionZone.ZoneSurveyed is {
        tell command MineContext.MineRepository.PersistZoneSurveyed(zoneId = zoneSurveyed.zoneId) to repository MineContext.MineRepository
        do "apply ZoneSurveyed to the ProductionAnalytics projection"
      }
      on productionRecorded: event ExtractionZone.ProductionRecorded is {
        tell command MineContext.MineRepository.PersistProductionRecorded(zoneId = productionRecorded.zoneId) to repository MineContext.MineRepository
        do "Update production analytics"
      }
      on safetyIncidentRecorded: event ExtractionZone.SafetyIncidentRecorded is {
        tell command MineContext.MineRepository.PersistSafetyIncidentRecorded(zoneId = safetyIncidentRecorded.zoneId) to repository MineContext.MineRepository
        do "Update safety metrics"
      }
    } with {
      briefly "Maintains production analytics"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Production analytics"
    described as {
      |Mining production analytics.
    }
  }
  // ---- Event publication for ExtractionZone ----
  type ExtractionZoneEvent is one of {
    MineContext.ExtractionZone.ZoneCreated or MineContext.ExtractionZone.ZoneSurveyed or MineContext.ExtractionZone.DrillingStarted or MineContext.ExtractionZone.BlastingRecorded or MineContext.ExtractionZone.ProductionRecorded or MineContext.ExtractionZone.SafetyIncidentRecorded or MineContext.ExtractionZone.EnvironmentalRecorded or MineContext.ExtractionZone.ZoneExhausted or MineContext.ExtractionZone.ReclamationInitiated
  } with {
    briefly "ExtractionZone event alternation"
    described as {
      |Union of all ExtractionZone events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ExtractionZoneEventSplit as flow is {
    inlet ExtractionZoneEventSplitIn is type ExtractionZoneEvent    outlet ExtractionZoneEventSplitToProductionAnalytics is type ExtractionZoneEvent
    handler ExtractionZoneEventSplitHandler is {
      on zoneCreated: event ExtractionZone.ZoneCreated is {
        send zoneCreated to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell zoneCreated to entity MineContext.ExtractionZone
      }
      on zoneSurveyed: event ExtractionZone.ZoneSurveyed is {
        send zoneSurveyed to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell zoneSurveyed to entity MineContext.ExtractionZone
      }
      on drillingStarted: event ExtractionZone.DrillingStarted is {
        send drillingStarted to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell drillingStarted to entity MineContext.ExtractionZone
      }
      on blastingRecorded: event ExtractionZone.BlastingRecorded is {
        send blastingRecorded to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell blastingRecorded to entity MineContext.ExtractionZone
      }
      on productionRecorded: event ExtractionZone.ProductionRecorded is {
        send productionRecorded to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell productionRecorded to entity MineContext.ExtractionZone
      }
      on safetyIncidentRecorded: event ExtractionZone.SafetyIncidentRecorded is {
        send safetyIncidentRecorded to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell safetyIncidentRecorded to entity MineContext.ExtractionZone
      }
      on environmentalRecorded: event ExtractionZone.EnvironmentalRecorded is {
        send environmentalRecorded to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell environmentalRecorded to entity MineContext.ExtractionZone
      }
      on zoneExhausted: event ExtractionZone.ZoneExhausted is {
        send zoneExhausted to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell zoneExhausted to entity MineContext.ExtractionZone
      }
      on reclamationInitiated: event ExtractionZone.ReclamationInitiated is {
        send reclamationInitiated to outlet ExtractionZoneEventSplitToProductionAnalytics
        tell reclamationInitiated to entity MineContext.ExtractionZone
      }
      on other is {
        error "Unexpected message for processor ExtractionZoneEventSplit"
      }
    } with {
      briefly "ExtractionZone event fan-out handler"
      described as {
        |Delivers each ExtractionZone event to all of its consumers.
      }
    }
  } with {
    briefly "ExtractionZone event fan-out"
    described as {
      |Fans ExtractionZone events out to the repository and projectors.
    }
  }
  connector 'ExtractionZoneEvent Stream' is from outlet MineContext.ExtractionZone.ExtractionZoneEvents2 to inlet MineContext.ExtractionZoneEventSplit.ExtractionZoneEventSplitIn with {
    briefly "ExtractionZone events, fanned out to storage and read models"
  }
  connector 'ProductionAnalytics Feed' is from outlet MineContext.ExtractionZoneEventSplit.ExtractionZoneEventSplitToProductionAnalytics to inlet MineContext.ProductionAnalytics.ProductionAnalyticsFromExtractionZone with {
    briefly "ExtractionZone events feeding the ProductionAnalytics projection"
  }
  connector 'ProductionAnalytics Storage' is from outlet MineContext.ProductionAnalytics.ProductionAnalyticsToRepository to inlet MineContext.MineRepository.MineRepositoryFromProductionAnalytics with {
    briefly "ProductionAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for mine operations"
  described as {
    |Mine extraction and processing context.
  }
}
