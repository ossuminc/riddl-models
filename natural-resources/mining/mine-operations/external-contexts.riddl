// Mine Operations - External Contexts
external context GeologicalSurveyService as flow is {
  outlet GeologicalSurveyServiceRepliesOut is result OreBodyModel
 with {
    briefly "What this service answers, on its way back"
  }
  inlet GeologicalSurveyServiceRequests is query GetOreBodyModel with {
    briefly "What this context asks the service to send"
  }
  handler GeologicalSurveyServiceBoundary is {
    on query GetOreBodyModel is {
      let askAnswer: type OreBodyModel = prompt("look up what GetOreBodyModel asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context GeologicalSurveyService"
    }
  } with {
    briefly "GeologicalSurveyService boundary"
  }
  query GetOreBodyModel replies result OreBodyModel is {
    mineId: MineId with {
      briefly "Mine"
      described as {
        |Mine ID.
      }
    }
    zoneId: ExtractionZoneId with {
      briefly "Zone"
      described as {
        |Zone ID.
      }
    }
  } with {
    briefly "Get ore body model"
    described as {
      |Retrieves geological ore body model.
    }
  }
  result OreBodyModel is {
    estimatedTonnage: Decimal(15,2) with {
      briefly "Tonnage"
      described as {
        |Estimated tonnage.
      }
    }
    averageGrade: Decimal(8,4) with {
      briefly "Grade"
      described as {
        |Average grade.
      }
    }
    confidenceLevel: String(1,50) with {
      briefly "Confidence"
      described as {
        |Estimate confidence.
      }
    }
  } with {
    briefly "Ore body model"
    described as {
      |Geological ore body model.
    }
  }
} with {
  briefly "External geological survey"
  described as {
    |Geological survey and modeling service.
  }
}
external context EquipmentManagementService as split is {
  outlet EquipmentManagementServiceRepliesOut is result EquipmentStatus
 with {
    briefly "What this service answers, on its way back"
  }
  outlet EquipmentManagementServiceEventsOut is event EquipmentDispatched
 with {
    briefly "What this service tells the model, unasked"
  }
  type EquipmentManagementServiceRequest is one of {
    DispatchEquipment or GetEquipmentStatus
  } with {
    briefly "Everything this service can be asked"
  }
  inlet EquipmentManagementServiceRequests is type EquipmentManagementServiceRequest with {
    briefly "What this context asks the service to send"
  }
  handler EquipmentManagementServiceBoundary is {
    on query GetEquipmentStatus is {
      let askAnswer: type EquipmentStatus = prompt("look up what GetEquipmentStatus asks for")
      reply askAnswer
    }
    on command DispatchEquipment is {
      let equipmentDispatched: type EquipmentDispatched = prompt("the equipment dispatched this produces")
      send equipmentDispatched to outlet EquipmentManagementService.EquipmentManagementServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context EquipmentManagementService"
    }
  } with {
    briefly "EquipmentManagementService boundary"
  }
  command DispatchEquipment is {
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    zoneId: ExtractionZoneId with {
      briefly "Zone"
      described as {
        |Target zone.
      }
    }
    task: String(1,200) with {
      briefly "Task"
      described as {
        |Equipment task.
      }
    }
  } with {
    briefly "Dispatch equipment"
    described as {
      |Dispatches equipment to zone.
    }
  }
  event EquipmentDispatched is {
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    dispatchedAt: TimeStamp with {
      briefly "Dispatched"
      described as {
        |Dispatch time.
      }
    }
  } with {
    briefly "Equipment dispatched"
    described as {
      |Emitted when equipment is dispatched.
    }
  }
  query GetEquipmentStatus replies result EquipmentStatus is {
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
  } with {
    briefly "Get equipment status"
    described as {
      |Retrieves equipment status.
    }
  }
  result EquipmentStatus is {
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    equipmentStatus: String(1,50) with {
      briefly "Status"
      described as {
        |Current status.
      }
    }
    location: String(1,100) with {
      briefly "Location"
      described as {
        |Current location.
      }
    }
    hoursOperating: Decimal(10,2) with {
      briefly "Hours"
      described as {
        |Operating hours.
      }
    }
  } with {
    briefly "Equipment status"
    described as {
      |Equipment status information.
    }
  }
} with {
  briefly "External equipment management"
  described as {
    |Mining equipment fleet management.
  }
}
external context EnvironmentalComplianceService as split is {
  outlet EnvironmentalComplianceServiceRepliesOut is result PermitRequirements
 with {
    briefly "What this service answers, on its way back"
  }
  outlet EnvironmentalComplianceServiceEventsOut is event ComplianceReportSubmitted
 with {
    briefly "What this service tells the model, unasked"
  }
  type EnvironmentalComplianceServiceRequest is one of {
    SubmitComplianceReport or GetPermitRequirements
  } with {
    briefly "Everything this service can be asked"
  }
  inlet EnvironmentalComplianceServiceRequests is type EnvironmentalComplianceServiceRequest with {
    briefly "What this context asks the service to send"
  }
  handler EnvironmentalComplianceServiceBoundary is {
    on query GetPermitRequirements is {
      let askAnswer: type PermitRequirements = prompt("look up what GetPermitRequirements asks for")
      reply askAnswer
    }
    on command SubmitComplianceReport is {
      let complianceReportSubmitted: type ComplianceReportSubmitted = prompt("the compliance report submitted this produces")
      send complianceReportSubmitted to outlet EnvironmentalComplianceService.EnvironmentalComplianceServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context EnvironmentalComplianceService"
    }
  } with {
    briefly "EnvironmentalComplianceService boundary"
  }
  command SubmitComplianceReport is {
    mineId: MineId with {
      briefly "Mine"
      described as {
        |Mine ID.
      }
    }
    reportingPeriod: Date with {
      briefly "Period"
      described as {
        |Reporting period.
      }
    }
    readings: EnvironmentalReading+ with {
      briefly "Readings"
      described as {
        |Environmental readings.
      }
    }
  } with {
    briefly "Submit compliance report"
    described as {
      |Submits environmental compliance report.
    }
  }
  event ComplianceReportSubmitted is {
    reportId: UUID with {
      briefly "Report"
      described as {
        |Report ID.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Compliance report submitted"
    described as {
      |Emitted when report is submitted.
    }
  }
  query GetPermitRequirements replies result PermitRequirements is {
    mineId: MineId with {
      briefly "Mine"
      described as {
        |Mine ID.
      }
    }
  } with {
    briefly "Get permit requirements"
    described as {
      |Retrieves environmental permit requirements.
    }
  }
  result PermitRequirements is {
    permitId: UUID with {
      briefly "Permit"
      described as {
        |Permit ID.
      }
    }
    requirements: String(1,500)+ with {
      briefly "Requirements"
      described as {
        |Compliance requirements.
      }
    }
    expirationDate: Date with {
      briefly "Expiration"
      described as {
        |Permit expiration.
      }
    }
  } with {
    briefly "Permit requirements"
    described as {
      |Environmental permit requirements.
    }
  }
} with {
  briefly "External environmental compliance"
  described as {
    |Environmental regulatory compliance service.
  }
}
