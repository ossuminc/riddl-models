// Mine Operations Domain Model
// Mining extraction and processing operations
domain MineOperations is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user MineManager is "person managing mine operations" with {
    briefly "Mine Manager"
    described as {
      |Manager overseeing extraction operations.
    }
  }
  user GeologistUser is "person analyzing ore deposits" with {
    briefly "Geologist"
    described as {
      |Geologist mapping and analyzing deposits.
    }
  }
  user EquipmentOperator is "person operating mining equipment" with {
    briefly "Equipment Operator"
    described as {
      |Operator running extraction equipment.
    }
  }
  epic MiningOperations is {
    user MineManager wants to "to manage extraction operations" so that "ore is extracted safely and efficiently"
    case PlanExtraction is {
      user GeologistUser wants to "to plan extraction zones" so that "ore recovery is maximized"
      step is "Geologist analyzes" "ore body data" "and grades" with {
        briefly "Analyze ore"
        described as {
          |Assess deposit.
        }
      }
      step is "System creates" "extraction plan" "with zones" with {
        briefly "Create plan"
        described as {
          |Generate extraction plan.
        }
      }
    } with {
      briefly "Plan extraction"
      described as {
        |Planning mine extraction zones.
      }
    }
  } with {
    briefly "Mining operations"
    described as {
      |Epic for mine extraction management.
    }
  }
  include "MineContext.riddl"
  include "external-contexts.riddl"
  application context MineOperationsApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in MineOperations are delivered.
      }
    }
    outlet AppExtractionZoneCommands is type MineContext.ExtractionZone.ExtractionZoneCommand
    inlet AppMineRepositoryResponses is type MineContext.ExtractionZone.ExtractionZoneResult    handler MineOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context MineOperationsApp"
      }
    } with {
      briefly "MineOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "MineOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ExtractionZoneCommand Stream' is from outlet MineOperationsApp.AppExtractionZoneCommands to inlet MineContext.ExtractionZone.ExtractionZoneCommands with {
    briefly "ExtractionZone commands from the application"
  }
  persistent connector 'ExtractionZoneResult Stream' is from outlet MineContext.MineRepository.MineRepositoryResponses to inlet MineOperationsApp.AppMineRepositoryResponses with {
    briefly "Mine query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet MineOperationsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Mine operations domain"
  described as {
    |Mining extraction and processing operations.
  }
}
