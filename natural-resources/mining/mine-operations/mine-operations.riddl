// Mine Operations Domain Model
// Mining extraction and processing operations
domain MineOperations is {
  persistent connector 'GeologicalSurveyServiceReply Stream' is from outlet GeologicalSurveyService.GeologicalSurveyServiceRepliesOut to inlet MineContext.ToGeologicalSurveyService.ToGeologicalSurveyServiceReplies with {
    briefly "What GeologicalSurveyService answers MineContext"
  }
  persistent connector 'EquipmentManagementServiceReply Stream' is from outlet EquipmentManagementService.EquipmentManagementServiceRepliesOut to inlet MineContext.ToEquipmentManagementService.ToEquipmentManagementServiceReplies with {
    briefly "What EquipmentManagementService answers MineContext"
  }
  persistent connector 'EnvironmentalComplianceServiceReply Stream' is from outlet EnvironmentalComplianceService.EnvironmentalComplianceServiceRepliesOut to inlet MineContext.ToEnvironmentalComplianceService.ToEnvironmentalComplianceServiceReplies with {
    briefly "What EnvironmentalComplianceService answers MineContext"
  }
  persistent connector 'EnvironmentalComplianceServiceEvent Stream' is from outlet EnvironmentalComplianceService.EnvironmentalComplianceServiceEventsOut to inlet MineContext.FromEnvironmentalComplianceService.FromEnvironmentalComplianceServiceIn with {
    briefly "What EnvironmentalComplianceService tells MineContext, unasked"
  }
  persistent connector 'EquipmentManagementServiceEvent Stream' is from outlet EquipmentManagementService.EquipmentManagementServiceEventsOut to inlet MineContext.FromEquipmentManagementService.FromEquipmentManagementServiceIn with {
    briefly "What EquipmentManagementService tells MineContext, unasked"
  }
  persistent connector 'GeologicalSurveyServiceRequest Stream' is from outlet MineContext.ToGeologicalSurveyService.ToGeologicalSurveyServiceOut to inlet GeologicalSurveyService.GeologicalSurveyServiceRequests with {
    briefly "What MineContext asks GeologicalSurveyService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user MineManager is "person managing mine operations" with {
    briefly "Mine Manager"
    described as {
      |Manager overseeing extraction operations.
    }
  }
  user GeologistUser is "person analyzing ore deposits" with {
    briefly "Geologist"
    described as {
      |Geologist mapping and analyzing deposits.
    }
  }
  user EquipmentOperator is "person operating mining equipment" with {
    briefly "Equipment Operator"
    described as {
      |Operator running extraction equipment.
    }
  }
  epic MiningOperations is {
    user MineManager wants to "to manage extraction operations" so that "ore is extracted safely and efficiently"
    case PlanExtraction is {
      user GeologistUser wants to "to plan extraction zones" so that "ore recovery is maximized"
      step is "Geologist analyzes" "ore body data" "and grades" with {
        briefly "Analyze ore"
        described as {
          |Assess deposit.
        }
      }
      step is "System creates" "extraction plan" "with zones" with {
        briefly "Create plan"
        described as {
          |Generate extraction plan.
        }
      }
    } with {
      briefly "Plan extraction"
      described as {
        |Planning mine extraction zones.
      }
    }
  } with {
    briefly "Mining operations"
    described as {
      |Epic for mine extraction management.
    }
  }
  include "MineContext.riddl"
  include "external-contexts.riddl"
  application context MineOperationsApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in MineOperations are delivered.
      }
    }
    group MineOperationsScreen is {
      input GetSafetyMetricsInput acquires query MineContext.GetSafetyMetrics with {
        briefly "Get safety metrics control"
        described as {
          |The control through which a user asks the get safety metrics question.
        }
      }
      input GetDailyProductionInput acquires query MineContext.GetDailyProduction with {
        briefly "Get daily production control"
        described as {
          |The control through which a user asks the get daily production question.
        }
      }
      input GetExtractionZoneInput acquires query MineContext.ExtractionZone.GetExtractionZone with {
        briefly "Get extraction zone control"
        described as {
          |The control through which a user asks the get extraction zone question.
        }
      }
      input CreateZoneInput acquires command MineContext.CreateZone with {
        briefly "Create zone control"
        described as {
          |The control through which a user submits the create zone request.
        }
      }
      input ExhaustZoneInput acquires command MineContext.ExtractionZone.ExhaustZone with {
        briefly "Exhaust zone control"
        described as {
          |The control through which a user submits the exhaust zone request.
        }
      }
      input InitiateReclamationInput acquires command MineContext.ExtractionZone.InitiateReclamation with {
        briefly "Initiate reclamation control"
        described as {
          |The control through which a user submits the initiate reclamation request.
        }
      }
      input RecordBlastingInput acquires command MineContext.ExtractionZone.RecordBlasting with {
        briefly "Record blasting control"
        described as {
          |The control through which a user submits the record blasting request.
        }
      }
      input RecordEnvironmentalInput acquires command MineContext.ExtractionZone.RecordEnvironmental with {
        briefly "Record environmental control"
        described as {
          |The control through which a user submits the record environmental request.
        }
      }
      input RecordProductionInput acquires command MineContext.ExtractionZone.RecordProduction with {
        briefly "Record production control"
        described as {
          |The control through which a user submits the record production request.
        }
      }
      input StartDrillingInput acquires command MineContext.ExtractionZone.StartDrilling with {
        briefly "Start drilling control"
        described as {
          |The control through which a user submits the start drilling request.
        }
      }
    } with {
      briefly "Mine operations screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppMineRepositoryQueries is type MineContext.MineRepository.MineRepositoryQuery
    inlet AppMineRepositoryReplies is type MineContext.MineRepository.MineRepositoryReply
    outlet AppExtractionZoneQueries is query MineContext.ExtractionZone.GetExtractionZone
    outlet AppExtractionZoneCommands is type MineContext.ExtractionZoneRequest
    inlet AppMineRepositoryResponses is result MineContext.ExtractionZone.ExtractionZoneResult
    handler MineOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context MineOperationsApp"
      }
    } with {
      briefly "MineOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "MineOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'EquipmentManagementServiceRequest Stream' is from outlet MineContext.ToEquipmentManagementService.ToEquipmentManagementServiceOut to inlet EquipmentManagementService.EquipmentManagementServiceRequests with {
    briefly "What MineContext asks EquipmentManagementService to send"
  }
  persistent connector 'EnvironmentalComplianceServiceRequest Stream' is from outlet MineContext.ToEnvironmentalComplianceService.ToEnvironmentalComplianceServiceOut to inlet EnvironmentalComplianceService.EnvironmentalComplianceServiceRequests with {
    briefly "What MineContext asks EnvironmentalComplianceService to send"
  }
  persistent connector 'MineRepositoryQuery Stream' is from outlet MineOperationsApp.AppMineRepositoryQueries to inlet MineContext.MineRepositoryQueriesIn with {
    briefly "MineOperationsApp's look-ups of the mine repository"
  }
  persistent connector 'MineRepositoryReply Stream' is from outlet MineContext.MineRepositoryRepliesOut to inlet MineOperationsApp.AppMineRepositoryReplies with {
    briefly "The mine repository's answers returned to MineOperationsApp"
  }
  persistent connector 'ExtractionZoneQuery Stream' is from outlet MineOperationsApp.AppExtractionZoneQueries to inlet MineContext.ExtractionZoneQueriesIn with {
    briefly "MineOperationsApp's look-ups of the extraction zone"
  }
  persistent connector 'ExtractionZoneCommand Stream' is from outlet MineOperationsApp.AppExtractionZoneCommands to inlet MineContext.ExtractionZoneCommandStreamIn with {
    briefly "ExtractionZone commands from the application"
  }
  persistent connector 'ExtractionZoneResult Stream' is from outlet MineContext.ExtractionZoneResultStreamOut to inlet MineOperationsApp.AppMineRepositoryResponses with {
    briefly "Mine query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet MineOperationsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Mine operations domain"
  described as {
    |Mining extraction and processing operations.
  }
}
