// Athlete Management - Athlete Context
context AthleteContext as router is {
  inlet AthleteCommandStreamIn is type AthleteCommand  outlet AthleteCommandStreamOut is type AthleteCommand
  inlet AthleteResultStreamIn is type Athlete.AthleteResult  outlet AthleteResultStreamOut is type Athlete.AthleteResult
  handler AthleteContextBoundary is {
    on registerAthlete: command Athlete.RegisterAthlete is {
      send registerAthlete to outlet AthleteContext.AthleteCommandStreamOut
    }
    on signContract: command Athlete.SignContract is {
      send signContract to outlet AthleteContext.AthleteCommandStreamOut
    }
    on recordInjury: command Athlete.RecordInjury is {
      send recordInjury to outlet AthleteContext.AthleteCommandStreamOut
    }
    on clearInjury: command Athlete.ClearInjury is {
      send clearInjury to outlet AthleteContext.AthleteCommandStreamOut
    }
    on recordPerformance: command Athlete.RecordPerformance is {
      send recordPerformance to outlet AthleteContext.AthleteCommandStreamOut
    }
    on assignTrainingProgram: command Athlete.AssignTrainingProgram is {
      send assignTrainingProgram to outlet AthleteContext.AthleteCommandStreamOut
    }
    on transferAthlete: command Athlete.TransferAthlete is {
      send transferAthlete to outlet AthleteContext.AthleteCommandStreamOut
    }
    on suspendAthlete: command Athlete.SuspendAthlete is {
      send suspendAthlete to outlet AthleteContext.AthleteCommandStreamOut
    }
    on retireAthlete: command Athlete.RetireAthlete is {
      send retireAthlete to outlet AthleteContext.AthleteCommandStreamOut
    }
    on athleteResult: result Athlete.AthleteResult is {
      send athleteResult to outlet AthleteContext.AthleteResultStreamOut
    }
    on other is {
      error "Unexpected message at the AthleteContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AthleteCommand Stream Intake' is from outlet AthleteContext.AthleteCommandStreamOut to inlet AthleteContext.Athlete.AthleteCommands  connector 'AthleteResult Stream Egress' is from outlet AthleteContext.AthleteRepository.AthleteRepositoryResponses to inlet AthleteContext.AthleteResultStreamIn  adaptor FromLeagueRegistry from context LeagueRegistry is { 
    handler FromLeagueRegistryHandler is {
      on result LeagueRegistry.LeagueEligibility is {
        do "the model receives league eligibility"
      }
      on event LeagueRegistry.LeagueRegistrationCompleted is {
        do "the model receives league registration completed"
      }
      on other is {
        error "Unexpected message for adaptor FromLeagueRegistry"
      }
    } with {
      briefly "from league registry"
      described as {
        |Carries messages from the external LeagueRegistry.
      }
    }
  } with {
    briefly "LeagueRegistry integration"
    described as {
      |The model's side of the LeagueRegistry conversation.
    }
  }
  adaptor ToLeagueRegistry to context LeagueRegistry is { 
    handler ToLeagueRegistryHandler is {
      on query LeagueRegistry.GetLeagueEligibility is {
        do "the model sends get league eligibility"
      }
      on command LeagueRegistry.RegisterWithLeague is {
        do "the model sends register with league"
      }
      on other is {
        error "Unexpected message for adaptor ToLeagueRegistry"
      }
    } with {
      briefly "to league registry"
      described as {
        |Carries messages to the external LeagueRegistry.
      }
    }
  } with {
    briefly "LeagueRegistry integration"
    described as {
      |The model's side of the LeagueRegistry conversation.
    }
  }
  adaptor FromMedicalSystem from context MedicalSystem is { 
    handler FromMedicalSystemHandler is {
      on result MedicalSystem.MedicalHistory is {
        do "the model receives medical history"
      }
      on event MedicalSystem.MedicalReportSubmitted is {
        do "the model receives medical report submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromMedicalSystem"
      }
    } with {
      briefly "from medical system"
      described as {
        |Carries messages from the external MedicalSystem.
      }
    }
  } with {
    briefly "MedicalSystem integration"
    described as {
      |The model's side of the MedicalSystem conversation.
    }
  }
  adaptor ToMedicalSystem to context MedicalSystem is { 
    handler ToMedicalSystemHandler is {
      on query MedicalSystem.GetMedicalHistory is {
        do "the model sends get medical history"
      }
      on command MedicalSystem.SubmitMedicalReport is {
        do "the model sends submit medical report"
      }
      on other is {
        error "Unexpected message for adaptor ToMedicalSystem"
      }
    } with {
      briefly "to medical system"
      described as {
        |Carries messages to the external MedicalSystem.
      }
    }
  } with {
    briefly "MedicalSystem integration"
    described as {
      |The model's side of the MedicalSystem conversation.
    }
  }
  include "types.riddl"
  include "Athlete.riddl"
  type AthleteRepositoryCommand is one of {
    AthleteContext.AthleteRepository.PersistAthleteRegistered or AthleteContext.AthleteRepository.PersistAthleteRetired or AthleteContext.AthleteRepository.PersistAthleteSuspended or AthleteContext.AthleteRepository.PersistAthleteTransferred or AthleteContext.AthleteRepository.PersistContractSigned or AthleteContext.AthleteRepository.PersistInjuryCleared or AthleteContext.AthleteRepository.PersistInjuryRecorded or AthleteContext.AthleteRepository.PersistPerformanceRecorded or AthleteContext.AthleteRepository.PersistTrainingProgramAssigned
  } with {
    briefly "Anything that writes AthleteRepository"
    described as {
      |The persistence commands AthleteRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository AthleteRepository as flow is {
    inlet AthleteRepositoryFromAthleteMetrics is type AthleteRepositoryCommand
    command PersistAthleteSuspended is  {
      athleteId: AthleteId with {
        briefly "Row addressed"
        described as {
          |Which stored row AthleteSuspended applies to.
        }
      }
    } with {
      briefly "Persist AthleteSuspended"
      described as {
        |Instructs this repository to apply AthleteSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAthleteTransferred is  {
      athleteId: AthleteId with {
        briefly "Row addressed"
        described as {
          |Which stored row AthleteTransferred applies to.
        }
      }
    } with {
      briefly "Persist AthleteTransferred"
      described as {
        |Instructs this repository to apply AthleteTransferred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContractSigned is  {
      athleteId: AthleteId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContractSigned applies to.
        }
      }
    } with {
      briefly "Persist ContractSigned"
      described as {
        |Instructs this repository to apply ContractSigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrainingProgramAssigned is  {
      athleteId: AthleteId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrainingProgramAssigned applies to.
        }
      }
    } with {
      briefly "Persist TrainingProgramAssigned"
      described as {
        |Instructs this repository to apply TrainingProgramAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAthleteRegistered is  {
      athleteId: AthleteId with {
        briefly "Row addressed"
        described as {
          |Which stored row AthleteRegistered applies to.
        }
      }
    } with {
      briefly "Persist AthleteRegistered"
      described as {
        |Instructs this repository to apply AthleteRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAthleteRetired is  {
      athleteId: AthleteId with {
        briefly "Row addressed"
        described as {
          |Which stored row AthleteRetired applies to.
        }
      }
    } with {
      briefly "Persist AthleteRetired"
      described as {
        |Instructs this repository to apply AthleteRetired to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInjuryCleared is  {
      athleteId: AthleteId with {
        briefly "Row addressed"
        described as {
          |Which stored row InjuryCleared applies to.
        }
      }
    } with {
      briefly "Persist InjuryCleared"
      described as {
        |Instructs this repository to apply InjuryCleared to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInjuryRecorded is  {
      athleteId: AthleteId with {
        briefly "Row addressed"
        described as {
          |Which stored row InjuryRecorded applies to.
        }
      }
    } with {
      briefly "Persist InjuryRecorded"
      described as {
        |Instructs this repository to apply InjuryRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPerformanceRecorded is  {
      athleteId: AthleteId with {
        briefly "Row addressed"
        described as {
          |Which stored row PerformanceRecorded applies to.
        }
      }
    } with {
      briefly "Persist PerformanceRecorded"
      described as {
        |Instructs this repository to apply PerformanceRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet AthleteRepositoryResponses is type Athlete.AthleteResult
    record StoredAthlete is  {
      athleteId: AthleteId with {
        briefly "athleteId"
        described as {
          |The athleteId column of the stored athlete row.
        }
      }
      teamId: TeamId with {
        briefly "teamId"
        described as {
          |The teamId column of the stored athlete row.
        }
      }
    } with {
      briefly "Stored athlete row"
      described as {
        |The persistence shape of athlete data as this repository stores it.
      }
    }
    schema AthleteData is relational
      of athletes as type StoredAthlete
        index on field StoredAthlete.athleteId
        index on field StoredAthlete.teamId
        index on field StoredAthlete.status
 with {
      briefly "Athlete data schema"
      described as {
        |The relational schema holding athlete data for the AthleteRepository.
      }
    }
    handler AthletePersistence is {
      on persistAthleteSuspended: command PersistAthleteSuspended is {
        do "apply AthleteSuspended to the stored row"
      }
      on persistAthleteTransferred: command PersistAthleteTransferred is {
        do "apply AthleteTransferred to the stored row"
      }
      on persistContractSigned: command PersistContractSigned is {
        do "apply ContractSigned to the stored row"
      }
      on persistTrainingProgramAssigned: command PersistTrainingProgramAssigned is {
        do "apply TrainingProgramAssigned to the stored row"
      }
      on persistAthleteRegistered: command PersistAthleteRegistered is {
        do "apply AthleteRegistered to the stored row"
      }
      on persistAthleteRetired: command PersistAthleteRetired is {
        do "apply AthleteRetired to the stored row"
      }
      on persistInjuryCleared: command PersistInjuryCleared is {
        do "apply InjuryCleared to the stored row"
      }
      on persistInjuryRecorded: command PersistInjuryRecorded is {
        do "apply InjuryRecorded to the stored row"
      }
      on persistPerformanceRecorded: command PersistPerformanceRecorded is {
        do "apply PerformanceRecorded to the stored row"
      }
      on query GetRosterMetrics is {
        let rosterMetricsView: type RosterMetricsView = prompt("read the roster metrics projection")
        reply rosterMetricsView
      }
    } with {
      briefly "Persists athlete commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Athlete data persistence"
    described as {
      |Persistent storage for athlete records.
    }
  }
  query GetRosterMetrics replies result RosterMetricsView is  {
    rosterMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which roster metrics to retrieve.
      }
    }
  } with {
    briefly "Get roster metrics"
    described as {
      |Retrieves the roster metrics projection.
    }
  }
  result RosterMetricsView is  {
    rosterMetrics: AthleteMetrics.RosterMetrics with {
      briefly "Roster metrics"
      described as {
        |The roster metrics being returned.
      }
    }
  } with {
    briefly "Roster metrics view"
    described as {
      |Read model view carrying the roster metrics projection.
    }
  }
  projector AthleteMetrics as flow is {
    outlet AthleteMetricsToRepository is type AthleteRepositoryCommand
    updates repository AthleteContext.AthleteRepository
    inlet AthleteMetricsFromAthlete is type AthleteEvent
    record RosterMetrics is  {
      totalAthletes: Natural with {
        briefly "Total"
        described as {
          |Total athletes.
        }
      }
      activeAthletes: Natural with {
        briefly "Active"
        described as {
          |Active athletes.
        }
      }
      injuredAthletes: Natural with {
        briefly "Injured"
        described as {
          |Injured athletes.
        }
      }
      averagePerformanceRating: Decimal(4,2) with {
        briefly "Avg rating"
        described as {
          |Average performance rating.
        }
      }
    } with {
      briefly "Roster metrics"
      described as {
        |Team roster analytics.
      }
    }
    handler MetricsHandler is {
      on athleteSuspended: event Athlete.AthleteSuspended is {
        tell command AthleteContext.AthleteRepository.PersistAthleteSuspended(athleteId = athleteSuspended.athleteId) to repository AthleteContext.AthleteRepository
        do "apply AthleteSuspended to the AthleteMetrics projection"
      }
      on athleteTransferred: event Athlete.AthleteTransferred is {
        tell command AthleteContext.AthleteRepository.PersistAthleteTransferred(athleteId = athleteTransferred.athleteId) to repository AthleteContext.AthleteRepository
        do "apply AthleteTransferred to the AthleteMetrics projection"
      }
      on contractSigned: event Athlete.ContractSigned is {
        tell command AthleteContext.AthleteRepository.PersistContractSigned(athleteId = contractSigned.athleteId) to repository AthleteContext.AthleteRepository
        do "apply ContractSigned to the AthleteMetrics projection"
      }
      on trainingProgramAssigned: event Athlete.TrainingProgramAssigned is {
        tell command AthleteContext.AthleteRepository.PersistTrainingProgramAssigned(athleteId = trainingProgramAssigned.athleteId) to repository AthleteContext.AthleteRepository
        do "apply TrainingProgramAssigned to the AthleteMetrics projection"
      }
      on athleteRegistered: event Athlete.AthleteRegistered is {
        tell command AthleteContext.AthleteRepository.PersistAthleteRegistered(athleteId = athleteRegistered.athleteId) to repository AthleteContext.AthleteRepository
      }
      on injuryRecorded: event Athlete.InjuryRecorded is {
        tell command AthleteContext.AthleteRepository.PersistInjuryRecorded(athleteId = injuryRecorded.athleteId) to repository AthleteContext.AthleteRepository
      }
      on injuryCleared: event Athlete.InjuryCleared is {
        tell command AthleteContext.AthleteRepository.PersistInjuryCleared(athleteId = injuryCleared.athleteId) to repository AthleteContext.AthleteRepository
      }
      on performanceRecorded: event Athlete.PerformanceRecorded is {
        tell command AthleteContext.AthleteRepository.PersistPerformanceRecorded(athleteId = performanceRecorded.athleteId) to repository AthleteContext.AthleteRepository
      }
      on athleteRetired: event Athlete.AthleteRetired is {
        tell command AthleteContext.AthleteRepository.PersistAthleteRetired(athleteId = athleteRetired.athleteId) to repository AthleteContext.AthleteRepository
      }
    } with {
      briefly "Maintains athlete metrics"
      described as {
        |Projects events into roster metrics.
      }
    }
  } with {
    briefly "Athlete metrics"
    described as {
      |Athlete and roster analytics.
    }
  }
  processor AthleteEventSplit as flow is {
    inlet AthleteEventSplitIn is type AthleteEvent
    outlet AthleteEventSplitToAthleteMetrics is type AthleteEvent
    handler AthleteEventSplitHandler is {
      on athleteRegistered: event Athlete.AthleteRegistered is {
        send athleteRegistered to outlet AthleteEventSplitToAthleteMetrics
        tell athleteRegistered to entity AthleteContext.Athlete
      }
      on contractSigned: event Athlete.ContractSigned is {
        send contractSigned to outlet AthleteEventSplitToAthleteMetrics
        tell contractSigned to entity AthleteContext.Athlete
      }
      on injuryRecorded: event Athlete.InjuryRecorded is {
        send injuryRecorded to outlet AthleteEventSplitToAthleteMetrics
        tell injuryRecorded to entity AthleteContext.Athlete
      }
      on injuryCleared: event Athlete.InjuryCleared is {
        send injuryCleared to outlet AthleteEventSplitToAthleteMetrics
        tell injuryCleared to entity AthleteContext.Athlete
      }
      on performanceRecorded: event Athlete.PerformanceRecorded is {
        send performanceRecorded to outlet AthleteEventSplitToAthleteMetrics
        tell performanceRecorded to entity AthleteContext.Athlete
      }
      on trainingProgramAssigned: event Athlete.TrainingProgramAssigned is {
        send trainingProgramAssigned to outlet AthleteEventSplitToAthleteMetrics
        tell trainingProgramAssigned to entity AthleteContext.Athlete
      }
      on athleteTransferred: event Athlete.AthleteTransferred is {
        send athleteTransferred to outlet AthleteEventSplitToAthleteMetrics
        tell athleteTransferred to entity AthleteContext.Athlete
      }
      on athleteSuspended: event Athlete.AthleteSuspended is {
        send athleteSuspended to outlet AthleteEventSplitToAthleteMetrics
        tell athleteSuspended to entity AthleteContext.Athlete
      }
      on athleteRetired: event Athlete.AthleteRetired is {
        send athleteRetired to outlet AthleteEventSplitToAthleteMetrics
        tell athleteRetired to entity AthleteContext.Athlete
      }
      on other is {
        error "Unexpected message for processor AthleteEventSplit"
      }
    } with {
      briefly "Athlete event fan-out handler"
      described as {
        |Delivers each Athlete event to all of its consumers.
      }
    }
  } with {
    briefly "Athlete event fan-out"
    described as {
      |Fans Athlete events out to the repository and projectors.
    }
  }
  connector 'AthleteEvent Stream' is from outlet AthleteContext.Athlete.AthleteEvents2 to inlet AthleteContext.AthleteEventSplit.AthleteEventSplitIn with {
    briefly "Athlete events, fanned out to storage and read models"
  }
  connector 'AthleteMetrics Feed' is from outlet AthleteContext.AthleteEventSplit.AthleteEventSplitToAthleteMetrics to inlet AthleteContext.AthleteMetrics.AthleteMetricsFromAthlete with {
    briefly "Athlete events feeding the AthleteMetrics projection"
  }
  connector 'AthleteMetrics Storage' is from outlet AthleteContext.AthleteMetrics.AthleteMetricsToRepository to inlet AthleteContext.AthleteRepository.AthleteRepositoryFromAthleteMetrics with {
    briefly "AthleteMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for athlete management"
  described as {
    |Athlete management bounded context.
  }
}
