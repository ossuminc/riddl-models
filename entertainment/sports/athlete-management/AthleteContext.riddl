// Athlete Management - Athlete Context
context AthleteContext is {
  adaptor FromLeagueRegistry from context LeagueRegistry is {
    handler FromLeagueRegistryHandler is {
      on result LeagueRegistry.LeagueEligibility is {
        do "the model receives league eligibility"
      }
      on event LeagueRegistry.LeagueRegistrationCompleted is {
        do "the model receives league registration completed"
      }
      on other is {
        error "Unexpected message for adaptor FromLeagueRegistry"
      }
    } with {
      briefly "from league registry"
      described as {
        |Carries messages from the external LeagueRegistry.
      }
    }
  } with {
      briefly "LeagueRegistry integration"
    described as {
      |The model's side of the LeagueRegistry conversation.
    }
  }
  adaptor ToLeagueRegistry to context LeagueRegistry is {
    handler ToLeagueRegistryHandler is {
      on query LeagueRegistry.GetLeagueEligibility is {
        do "the model sends get league eligibility"
      }
      on command LeagueRegistry.RegisterWithLeague is {
        do "the model sends register with league"
      }
      on other is {
        error "Unexpected message for adaptor ToLeagueRegistry"
      }
    } with {
      briefly "to league registry"
      described as {
        |Carries messages to the external LeagueRegistry.
      }
    }
  } with {
      briefly "LeagueRegistry integration"
    described as {
      |The model's side of the LeagueRegistry conversation.
    }
  }
  adaptor FromMedicalSystem from context MedicalSystem is {
    handler FromMedicalSystemHandler is {
      on result MedicalSystem.MedicalHistory is {
        do "the model receives medical history"
      }
      on event MedicalSystem.MedicalReportSubmitted is {
        do "the model receives medical report submitted"
      }
      on other is {
        error "Unexpected message for adaptor FromMedicalSystem"
      }
    } with {
      briefly "from medical system"
      described as {
        |Carries messages from the external MedicalSystem.
      }
    }
  } with {
      briefly "MedicalSystem integration"
    described as {
      |The model's side of the MedicalSystem conversation.
    }
  }
  adaptor ToMedicalSystem to context MedicalSystem is {
    handler ToMedicalSystemHandler is {
      on query MedicalSystem.GetMedicalHistory is {
        do "the model sends get medical history"
      }
      on command MedicalSystem.SubmitMedicalReport is {
        do "the model sends submit medical report"
      }
      on other is {
        error "Unexpected message for adaptor ToMedicalSystem"
      }
    } with {
      briefly "to medical system"
      described as {
        |Carries messages to the external MedicalSystem.
      }
    }
  } with {
      briefly "MedicalSystem integration"
    described as {
      |The model's side of the MedicalSystem conversation.
    }
  }
  include "types.riddl"
  include "Athlete.riddl"
  repository AthleteRepository is {
    inlet AthleteRepositoryFromAthlete is type AthleteEvent
    inlet AthleteRepositoryFromAthleteMetrics is type AthleteEvent
    outlet AthleteRepositoryResponses is type Athlete.AthleteResult
    schema AthleteData is relational
      of athletes as type Athlete
        index on field Athlete.athleteId
        index on field Athlete.teamId
        index on field Athlete.status
      with {
      briefly "Athlete data schema"
      described as {
        |The relational schema holding athlete data for the AthleteRepository.
      }
    }

    handler AthletePersistence is {
      on command Athlete.RegisterAthlete is {
        tell event Athlete.AthleteRegistered to entity AthleteContext.Athlete
      }
      on command Athlete.SignContract is {
        tell event Athlete.ContractSigned to entity AthleteContext.Athlete
      }
      on command Athlete.RecordInjury is {
        tell event Athlete.InjuryRecorded to entity AthleteContext.Athlete
      }
      on command Athlete.ClearInjury is {
        tell event Athlete.InjuryCleared to entity AthleteContext.Athlete
      }
      on command Athlete.RecordPerformance is {
        tell event Athlete.PerformanceRecorded to entity AthleteContext.Athlete
      }
      on command Athlete.TransferAthlete is {
        tell event Athlete.AthleteTransferred to entity AthleteContext.Athlete
      }
      on command Athlete.RetireAthlete is {
        tell event Athlete.AthleteRetired to entity AthleteContext.Athlete
      }
    } with {
      briefly "Persists athlete commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Athlete data persistence"
    described as {
      |Persistent storage for athlete records.
    }
  }
  projector AthleteMetrics is {
    inlet AthleteMetricsFromAthlete is type AthleteEvent
    outlet AthleteMetricsOut is type AthleteEvent
    updates repository AthleteContext.AthleteRepository
    record RosterMetrics is  {
      totalAthletes: Natural with {
        briefly "Total"
        described as {
          |Total athletes.
        }
      }
      activeAthletes: Natural with {
        briefly "Active"
        described as {
          |Active athletes.
        }
      }
      injuredAthletes: Natural with {
        briefly "Injured"
        described as {
          |Injured athletes.
        }
      }
      averagePerformanceRating: Decimal(4,2) with {
        briefly "Avg rating"
        described as {
          |Average performance rating.
        }
      }
    } with {
      briefly "Roster metrics"
      described as {
        |Team roster analytics.
      }
    }
    handler MetricsHandler is {
      on event Athlete.AthleteRegistered is {
        tell event Athlete.AthleteRegistered to repository AthleteContext.AthleteRepository
      }
      on event Athlete.InjuryRecorded is {
        tell event Athlete.InjuryRecorded to repository AthleteContext.AthleteRepository
      }
      on event Athlete.InjuryCleared is {
        tell event Athlete.InjuryCleared to repository AthleteContext.AthleteRepository
      }
      on event Athlete.PerformanceRecorded is {
        tell event Athlete.PerformanceRecorded to repository AthleteContext.AthleteRepository
      }
      on event Athlete.AthleteRetired is {
        tell event Athlete.AthleteRetired to repository AthleteContext.AthleteRepository
      }
    } with {
      briefly "Maintains athlete metrics"
      described as {
        |Projects events into roster metrics.
      }
    }
  } with {
    briefly "Athlete metrics"
    described as {
      |Athlete and roster analytics.
    }
  }
  processor AthleteEventSource as source is {
    outlet AthleteEvents is type AthleteEvent
    handler AthleteEventEmitter is {
      on init is { tell command InitializeAthlete to entity AthleteContext.Athlete }
      on other is {
        error "Unexpected message for source AthleteEventSource"
      }
      on event Athlete.AthleteRegistered is { send event Athlete.AthleteRegistered to outlet AthleteEvents }
      on event Athlete.AthleteTransferred is { send event Athlete.AthleteTransferred to outlet AthleteEvents }
      on event Athlete.AthleteRetired is { send event Athlete.AthleteRetired to outlet AthleteEvents }
    } with {
      briefly "Athlete event emitter"
      described as {
        |Emits athlete lifecycle events into streaming topology.
      }
    }
  } with {
    briefly "Athlete event source"
    described as {
      |Publishes athlete entity events for streaming.
    }
  }
  processor AthleteEventSink as sink is {
    inlet IncomingAthleteEvents is type AthleteEvent
    handler AthleteEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink AthleteEventSink"
      }
      on event Athlete.AthleteRegistered is { tell event Athlete.AthleteRegistered to repository AthleteContext.AthleteRepository }
      on event Athlete.AthleteRetired is { tell event Athlete.AthleteRetired to repository AthleteContext.AthleteRepository }
    } with {
      briefly "Athlete event receiver"
      described as {
        |Receives athlete events and persists them.
      }
    }
  } with {
    briefly "Athlete event sink"
    described as {
      |Receives athlete events from streaming topology.
    }
  }
  connector AthleteEventPipeline is {
    from outlet AthleteContext.AthleteEventSource.AthleteEvents to inlet AthleteContext.AthleteEventSink.IncomingAthleteEvents
  } with {
    briefly "Athlete event pipeline"
    described as {
      |Wires athlete events from source to sink.
    }
  }
  processor AthleteEventSplit is {
    inlet AthleteEventSplitIn is type AthleteEvent
    outlet AthleteEventSplitToAthleteRepository is type AthleteEvent
    outlet AthleteEventSplitToAthleteMetrics is type AthleteEvent
    handler AthleteEventSplitHandler is {
      on event Athlete.AthleteRegistered is {
        send event Athlete.AthleteRegistered to outlet AthleteEventSplitToAthleteRepository
        send event Athlete.AthleteRegistered to outlet AthleteEventSplitToAthleteMetrics
        tell event Athlete.AthleteRegistered to entity AthleteContext.Athlete
      }
      on event Athlete.ContractSigned is {
        send event Athlete.ContractSigned to outlet AthleteEventSplitToAthleteRepository
        send event Athlete.ContractSigned to outlet AthleteEventSplitToAthleteMetrics
        tell event Athlete.ContractSigned to entity AthleteContext.Athlete
      }
      on event Athlete.InjuryRecorded is {
        send event Athlete.InjuryRecorded to outlet AthleteEventSplitToAthleteRepository
        send event Athlete.InjuryRecorded to outlet AthleteEventSplitToAthleteMetrics
        tell event Athlete.InjuryRecorded to entity AthleteContext.Athlete
      }
      on event Athlete.InjuryCleared is {
        send event Athlete.InjuryCleared to outlet AthleteEventSplitToAthleteRepository
        send event Athlete.InjuryCleared to outlet AthleteEventSplitToAthleteMetrics
        tell event Athlete.InjuryCleared to entity AthleteContext.Athlete
      }
      on event Athlete.PerformanceRecorded is {
        send event Athlete.PerformanceRecorded to outlet AthleteEventSplitToAthleteRepository
        send event Athlete.PerformanceRecorded to outlet AthleteEventSplitToAthleteMetrics
        tell event Athlete.PerformanceRecorded to entity AthleteContext.Athlete
      }
      on event Athlete.TrainingProgramAssigned is {
        send event Athlete.TrainingProgramAssigned to outlet AthleteEventSplitToAthleteRepository
        send event Athlete.TrainingProgramAssigned to outlet AthleteEventSplitToAthleteMetrics
        tell event Athlete.TrainingProgramAssigned to entity AthleteContext.Athlete
      }
      on event Athlete.AthleteTransferred is {
        send event Athlete.AthleteTransferred to outlet AthleteEventSplitToAthleteRepository
        send event Athlete.AthleteTransferred to outlet AthleteEventSplitToAthleteMetrics
        tell event Athlete.AthleteTransferred to entity AthleteContext.Athlete
      }
      on event Athlete.AthleteSuspended is {
        send event Athlete.AthleteSuspended to outlet AthleteEventSplitToAthleteRepository
        send event Athlete.AthleteSuspended to outlet AthleteEventSplitToAthleteMetrics
        tell event Athlete.AthleteSuspended to entity AthleteContext.Athlete
      }
      on event Athlete.AthleteRetired is {
        send event Athlete.AthleteRetired to outlet AthleteEventSplitToAthleteRepository
        send event Athlete.AthleteRetired to outlet AthleteEventSplitToAthleteMetrics
        tell event Athlete.AthleteRetired to entity AthleteContext.Athlete
      }
      on other is {
        error "Unexpected message for processor AthleteEventSplit"
      }
    } with {
      briefly "Athlete event fan-out handler"
      described as {
        |Delivers each Athlete event to all of its consumers.
      }
    }
  } with {
    briefly "Athlete event fan-out"
    described as {
      |Fans Athlete events out to the repository and projectors.
    }
  }
  connector LinkAthleteToAthleteEventSplit is {
    from outlet AthleteContext.Athlete.AthleteEvents2 to
      inlet AthleteContext.AthleteEventSplit.AthleteEventSplitIn
  } with {
    briefly "LinkAthleteToAthleteEventSplit"
  }
  connector LinkAthleteEventSplitToAthleteRepository is {
    from outlet AthleteContext.AthleteEventSplit.AthleteEventSplitToAthleteRepository to
      inlet AthleteContext.AthleteRepository.AthleteRepositoryFromAthlete
  } with {
    briefly "LinkAthleteEventSplitToAthleteRepository"
  }
  connector LinkAthleteEventSplitToAthleteMetrics is {
    from outlet AthleteContext.AthleteEventSplit.AthleteEventSplitToAthleteMetrics to
      inlet AthleteContext.AthleteMetrics.AthleteMetricsFromAthlete
  } with {
    briefly "LinkAthleteEventSplitToAthleteMetrics"
  }
  connector LinkAthleteMetricsToAthleteRepository is {
    from outlet AthleteContext.AthleteMetrics.AthleteMetricsOut to
      inlet AthleteContext.AthleteRepository.AthleteRepositoryFromAthleteMetrics
  } with {
    briefly "LinkAthleteMetricsToAthleteRepository"
  }
} with {
  briefly "Bounded context for athlete management"
  described as {
    |Athlete management bounded context.
  }
}
