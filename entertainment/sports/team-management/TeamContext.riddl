// Team Management bounded context
context TeamContext as router is {
  command CreateTeam yields event Team.TeamCreated is {
    name: String(1,100) with {
      briefly "Team name"
      described as {
        |Official name of the team.
      }
    }
    city: String(1,50) with {
      briefly "City"
      described as {
        |City where the team is based.
      }
    }
    conference: String(1,50) with {
      briefly "Conference"
      described as {
        |League conference the team belongs to.
      }
    }
    division: String(1,50) with {
      briefly "Division"
      described as {
        |Division within the conference.
      }
    }
  } with {
    briefly "Create a new team in the system"
    described as {
      | Initializes a new franchise with basic identifying information
      | including geographic and league organizational details.
    }
  }
  command SignPlayer yields event Player.PlayerSigned is {
    playerInfo: PlayerInfo with {
      briefly "Player information"
      described as {
        |Biographical and physical information about the player.
      }
    }
    contract: ContractInfo with {
      briefly "Contract terms"
      described as {
        |Financial terms of the contract being offered.
      }
    }
    teamId: TeamId with {
      briefly "Signing team"
      described as {
        |Team that is signing the player.
      }
    }
  } with {
    briefly "Sign a new player to the team"
    described as {
      | Initiates the signing of a player including their biographical
      | information and contract terms. Requires salary cap validation.
    }
  }
  type PlayerRequest is one of {
    TeamContext.SignPlayer or Player.PlayerCommand
  } with {
    briefly "Player requests"
    described as {
      |What may be asked of TeamContext about a Player: SignPlayer, which the
      |context does itself by creating one, or any command for an existing one.
    }
  }
  connector 'TeamQuery IntakePort' is from outlet TeamContext.TeamQueriesOutPort to inlet TeamContext.Team.TeamQueriesPort with {
    briefly "Look-ups on their way to the team"
  }
  connector 'TeamReply EgressPort' is from outlet TeamContext.Team.TeamRepliesPort to inlet TeamContext.TeamRepliesInPort with {
    briefly "The team's answers on their way to the boundary"
  }
  connector 'PlayerRepositoryQuery Intake' is from outlet TeamContext.PlayerRepositoryQueriesOut to inlet TeamContext.PlayerRepository.PlayerRepositoryQueries with {
    briefly "Look-ups on their way to the player repository"
  }
  connector 'PlayerRepositoryReply Egress' is from outlet TeamContext.PlayerRepository.PlayerRepositoryResponses to inlet TeamContext.PlayerRepositoryRepliesIn with {
    briefly "The player repository's answers on their way to the boundary"
  }
  connector 'TeamQuery Intake' is from outlet TeamContext.TeamQueriesOut to inlet TeamContext.Team.TeamQueries with {
    briefly "Look-ups on their way to the team"
  }
  connector 'TeamReply Egress' is from outlet TeamContext.Team.TeamReplies to inlet TeamContext.TeamRepliesIn with {
    briefly "The team's answers on their way to the boundary"
  }
  connector 'PlayerQuery Intake' is from outlet TeamContext.PlayerQueriesOut to inlet TeamContext.Player.PlayerQueries with {
    briefly "Look-ups on their way to the player"
  }
  connector 'RosterMetrics Storage' is from outlet TeamContext.RosterMetrics.RosterMetricsToRepository to inlet TeamContext.PlayerRepository.PlayerRepositoryFromRosterMetrics with {
    briefly "RosterMetrics messages on their way to PlayerRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet TeamQueriesInPort is query Team.GetTeam with {
    briefly "Look-ups of the team"
    described as {
      |TeamManagementApp's look-ups, on their way to the team.
    }
  }
  outlet TeamQueriesOutPort is query Team.GetTeam
 with {
    briefly "Look-ups on their way to the team"
    described as {
      |Each look-up goes to the team it names.
    }
  }
  inlet TeamRepliesInPort is result Team.TeamResult with {
    briefly "The team's answers"
    described as {
      |What the team answers about itself.
    }
  }
  outlet TeamRepliesOutPort is result Team.TeamResult
 with {
    briefly "Answers to TeamManagementApp"
    described as {
      |The reply leg of TeamManagementApp's look-ups of the team.
    }
  }
  inlet PlayerRepositoryQueriesIn is type PlayerRepository.PlayerRepositoryQuery with {
    briefly "Look-ups of the player repository"
    described as {
      |TeamManagementApp's look-ups, on their way to the player repository.
    }
  }
  outlet PlayerRepositoryQueriesOut is type PlayerRepository.PlayerRepositoryQuery
 with {
    briefly "Look-ups on their way to the player repository"
    described as {
      |Each look-up goes to the player repository it names.
    }
  }
  inlet PlayerRepositoryRepliesIn is type PlayerRepository.PlayerRepositoryReply with {
    briefly "The player repository's answers"
    described as {
      |What the player repository answers about itself.
    }
  }
  outlet PlayerRepositoryRepliesOut is type PlayerRepository.PlayerRepositoryReply
 with {
    briefly "Answers to TeamManagementApp"
    described as {
      |The reply leg of TeamManagementApp's look-ups of the player repository.
    }
  }
  inlet TeamQueriesIn is query GetRosterMetrics with {
    briefly "Look-ups of the team"
    described as {
      |TeamManagementApp's look-ups, on their way to the team.
    }
  }
  outlet TeamQueriesOut is query GetRosterMetrics
 with {
    briefly "Look-ups on their way to the team"
    described as {
      |Each look-up goes to the team it names.
    }
  }
  inlet TeamRepliesIn is result RosterMetricsView with {
    briefly "The team's answers"
    described as {
      |What the team answers about itself.
    }
  }
  outlet TeamRepliesOut is result RosterMetricsView
 with {
    briefly "Answers to TeamManagementApp"
    described as {
      |The reply leg of TeamManagementApp's look-ups of the team.
    }
  }
  inlet PlayerQueriesIn is query Player.GetPlayer with {
    briefly "Look-ups of the player"
    described as {
      |TeamManagementApp's look-ups, on their way to the player.
    }
  }
  outlet PlayerQueriesOut is query Player.GetPlayer
 with {
    briefly "Look-ups on their way to the player"
    described as {
      |Each look-up goes to the player it names.
    }
  }
  inlet PlayerCommandStreamIn is type TeamContext.PlayerRequest
  outlet PlayerCommandStreamOut is type PlayerCommand
  type TeamRequest is one of {
    TeamContext.CreateTeam or Team.TeamCommand
  } with {
    briefly "Team requests"
    described as {
      |What may be asked of TeamContext about a Team: CreateTeam, which the
      |context does itself by creating one, or any command for an existing one.
    }
  }
  inlet TeamCommandStreamIn is type TeamContext.TeamRequest
  outlet TeamCommandStreamOut is type Team.TeamCommand
  inlet PlayerResultStreamIn is result Player.PlayerResult
  outlet PlayerResultStreamOut is result Player.PlayerResult
  inlet PlayerSignedAnswerIn is event Player.PlayerSigned
  outlet PlayerSignedAnswerOut is event Player.PlayerSigned
  connector 'PlayerSigned Answer Relay' is from outlet TeamContext.PlayerEventSplit.PlayerEventSplitToPlayerSignedAnswer to inlet TeamContext.PlayerSignedAnswerIn with {
    briefly "The player signed answer, on its way out of TeamContext"
  }
  inlet TeamCreatedAnswerIn is event Team.TeamCreated
  outlet TeamCreatedAnswerOut is event Team.TeamCreated
  connector 'TeamCreated Answer Relay' is from outlet TeamContext.TeamEventSplit.TeamEventSplitToTeamCreatedAnswer to inlet TeamContext.TeamCreatedAnswerIn with {
    briefly "The team created answer, on its way out of TeamContext"
  }
  handler TeamContextBoundary is {
    on teamCreated: event Team.TeamCreated is {
      send teamCreated to outlet TeamContext.TeamCreatedAnswerOut
    }
    on playerSigned: event Player.PlayerSigned is {
      send playerSigned to outlet TeamContext.PlayerSignedAnswerOut
    }
    on getTeam: query Team.GetTeam is {
      forward getTeam to outlet TeamContext.TeamQueriesOutPort
    }
    on teamResult: result Team.TeamResult is {
      send teamResult to outlet TeamContext.TeamRepliesOutPort
    }
    on getPlayerById: query PlayerRepository.GetPlayerById is {
      forward getPlayerById to outlet TeamContext.PlayerRepositoryQueriesOut
    }
    on getPlayersByTeam: query PlayerRepository.GetPlayersByTeam is {
      forward getPlayersByTeam to outlet TeamContext.PlayerRepositoryQueriesOut
    }
    on getPlayersByStatus: query PlayerRepository.GetPlayersByStatus is {
      forward getPlayersByStatus to outlet TeamContext.PlayerRepositoryQueriesOut
    }
    on getFreeAgents: query PlayerRepository.GetFreeAgents is {
      forward getFreeAgents to outlet TeamContext.PlayerRepositoryQueriesOut
    }
    on playerList: result PlayerRepository.PlayerList is {
      send playerList to outlet TeamContext.PlayerRepositoryRepliesOut
    }
    on playerRecord: result PlayerRepository.PlayerRecord is {
      send playerRecord to outlet TeamContext.PlayerRepositoryRepliesOut
    }
    on getRosterMetrics: query GetRosterMetrics is {
      forward getRosterMetrics to outlet TeamContext.TeamQueriesOut
    }
    on rosterMetricsView: result RosterMetricsView is {
      send rosterMetricsView to outlet TeamContext.TeamRepliesOut
    }
    on getPlayer: query Player.GetPlayer is {
      forward getPlayer to outlet TeamContext.PlayerQueriesOut
    }
    on signPlayer: command TeamContext.SignPlayer is {
      let givenSignedAt: type TimeStamp = prompt("the signed at of this player signed")
      let newPlayer = create entity TeamContext.Player(playerInfo = signPlayer.playerInfo, contract = signPlayer.contract, teamId = signPlayer.teamId, signedAt = givenSignedAt)
    }
    on assignToRoster: command Player.AssignToRoster is {
      forward assignToRoster to outlet TeamContext.PlayerCommandStreamOut
    }
    on extendContract: command Player.ExtendContract is {
      forward extendContract to outlet TeamContext.PlayerCommandStreamOut
    }
    on tradePlayer: command Player.TradePlayer is {
      forward tradePlayer to outlet TeamContext.PlayerCommandStreamOut
    }
    on releasePlayer: command Player.ReleasePlayer is {
      forward releasePlayer to outlet TeamContext.PlayerCommandStreamOut
    }
    on placeOnInjuredReserve: command Player.PlaceOnInjuredReserve is {
      forward placeOnInjuredReserve to outlet TeamContext.PlayerCommandStreamOut
    }
    on createTeam: command TeamContext.CreateTeam is {
      let teamCreatedAt: type TimeStamp = system.now
      let newTeam = create entity TeamContext.Team(teamName = createTeam.name, teamCity = createTeam.city, teamConference = createTeam.conference, teamDivision = createTeam.division, createdAt = teamCreatedAt)
    }
    on renameTeam: command Team.RenameTeam is {
      send renameTeam to outlet TeamContext.TeamCommandStreamOut
    }
    on relocateTeam: command Team.RelocateTeam is {
      send relocateTeam to outlet TeamContext.TeamCommandStreamOut
    }
    on playerResult: result Player.PlayerResult is {
      send playerResult to outlet TeamContext.PlayerResultStreamOut
    }
    on other is {
      error "Unexpected message at the TeamContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PlayerCommand Stream Intake' is from outlet TeamContext.PlayerCommandStreamOut to inlet TeamContext.Player.PlayerCommands
  connector 'TeamCommand Stream Intake' is from outlet TeamContext.TeamCommandStreamOut to inlet TeamContext.Team.TeamCommands
  connector 'PlayerResult Stream Egress' is from outlet TeamContext.Player.PlayerReplies to inlet TeamContext.PlayerResultStreamIn
  query GetRosterMetrics replies result RosterMetricsView is {
    teamId: TeamId with {
      briefly "Team ID"
      described as {
        |Identifies the Team instance this message addresses.
      }
    }
    rosterMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which RosterMetrics to retrieve.
      }
    }
  } with {
    briefly "Get RosterMetrics"
    described as {
      |Retrieves a RosterMetrics projection.
    }
  }
  result RosterMetricsView is {
    rosterMetrics: RosterMetricsRecord with {
      briefly "RosterMetrics"
      described as {
        |The RosterMetrics data being returned.
      }
    }
  } with {
    briefly "RosterMetrics view"
    described as {
      |Read model view carrying a RosterMetricsRecord.
    }
  }
  include "types.riddl"
  include "Player.riddl"
  // Team entity for managing team-level operations
  aggregate entity Team as router is {
    type TeamCommand is one of {
      Team.RenameTeam or Team.RelocateTeam
    } with {
      briefly "Team command alternation"
      described as {
        |Commands accepted by an existing Team.
      }
    }
    type TeamEvent is one of {
      Team.TeamCreated or Team.TeamRenamed or Team.TeamRelocated
    } with {
      briefly "Team event alternation"
      described as {
        |Events published by the Team entity.
      }
    }
    inlet TeamQueriesPort is query GetTeam with {
      briefly "Look-ups of this team"
      described as {
        |What TeamManagementApp asks of the team, by way of TeamContext.
      }
    }
    outlet TeamRepliesPort is result TeamResult
 with {
      briefly "This team's answers"
      described as {
        |What the team answers, on its way back to TeamContext.
      }
    }
    inlet TeamQueries is query GetRosterMetrics with {
      briefly "Look-ups of this team"
      described as {
        |What TeamManagementApp asks of the team, by way of TeamContext.
      }
    }
    outlet TeamReplies is result RosterMetricsView
 with {
      briefly "This team's answers"
      described as {
        |What the team answers, on its way back to TeamContext.
      }
    }
    inlet TeamCommands is type TeamCommand
    outlet TeamEvents is type TeamEvent
    query GetTeam replies result TeamResult is {
      teamId: TeamId with {
        briefly "ID"
        described as {
          |Identifier of the Team to retrieve.
        }
      }
    } with {
      briefly "Get Team"
      described as {
        |Retrieve Team data by identifier.
      }
    }
    result TeamResult is {
      teamId: TeamId with {
        briefly "Team addressed"
        described as {
          |Which team this message concerns. Named directly rather
          |than left to a wrapped record, because a nested record cannot say
          |which instance is addressed.
        }
      }
      teamData: Team.ActiveTeamData with {
        briefly "Team data"
        described as {
          |The requested Team data.
        }
      }
    } with {
      briefly "Team result"
      described as {
        |Result carrying the requested Team data.
      }
    }
    command RenameTeam is {
      teamId: TeamId with {
        briefly "Team ID"
        described as {
          |Identifies the Team instance this message addresses.
        }
      }
      name: String(1,100) with {
        briefly "New name"
        described as {
          |The team's new official name.
        }
      }
    } with {
      briefly "Rename team"
      described as {
        |Gives an existing team a new official name.
      }
    }
    command RelocateTeam is {
      teamId: TeamId with {
        briefly "Team ID"
        described as {
          |Identifies the Team instance this message addresses.
        }
      }
      city: String(1,50) with {
        briefly "New city"
        described as {
          |The city the team moves to.
        }
      }
    } with {
      briefly "Relocate team"
      described as {
        |Moves an existing franchise to a new home city.
      }
    }
    event TeamRenamed is {
      teamId: TeamId with {
        briefly "Team ID"
        described as {
          |Identifies the Team instance this message addresses.
        }
      }
      name: String(1,100) with {
        briefly "New name"
        described as {
          |The team's new official name.
        }
      }
      renamedAt: TimeStamp with {
        briefly "Renamed at"
        described as {
          |When the new name took effect.
        }
      }
    } with {
      briefly "Team renamed"
      described as {
        |An existing team has a new official name.
      }
    }
    event TeamRelocated is {
      teamId: TeamId with {
        briefly "Team ID"
        described as {
          |Identifies the Team instance this message addresses.
        }
      }
      city: String(1,50) with {
        briefly "New city"
        described as {
          |The team's new home city.
        }
      }
      relocatedAt: TimeStamp with {
        briefly "Relocated at"
        described as {
          |When the move took effect.
        }
      }
    } with {
      briefly "Team relocated"
      described as {
        |An existing franchise has moved to a new home city.
      }
    }
    event TeamCreated is {
      teamId: TeamId with {
        briefly "Team identifier"
        described as {
          |Identifier of the created team.
        }
      }
      name: String(1,100) with {
        briefly "Team name"
        described as {
          |Name of the created team.
        }
      }
      city: String(1,50) with {
        briefly "City"
        described as {
          |City where the team is based.
        }
      }
      conference: String(1,50) with {
        briefly "Conference"
        described as {
          |Conference assignment.
        }
      }
      division: String(1,50) with {
        briefly "Division"
        described as {
          |Division assignment.
        }
      }
      createdAt: TimeStamp with {
        briefly "Creation timestamp"
        described as {
          |When the team was created.
        }
      }
    } with {
      briefly "Team has been created"
      described as {
        | Records the creation of a new team entity in the system.
      }
    }
    record ActiveTeamData is {
      teamId: TeamId with {
        briefly "Team ID"
        described as {
          |Unique team identifier.
        }
      }
      name: String(1,100) with {
        briefly "Name"
        described as {
          |Official team name.
        }
      }
      city: String(1,50) with {
        briefly "City"
        described as {
          |Team's home city.
        }
      }
      conference: String(1,50) with {
        briefly "Conference"
        described as {
          |League conference.
        }
      }
      division: String(1,50) with {
        briefly "Division"
        described as {
          |Conference division.
        }
      }
      rosterSize: Integer with {
        briefly "Roster size"
        described as {
          |Current player count.
        }
      }
      salaryCap: Decimal(12,2) with {
        briefly "Salary cap"
        described as {
          |Maximum payroll.
        }
      }
      currentPayroll: Decimal(12,2) with {
        briefly "Payroll"
        described as {
          |Current payroll.
        }
      }
    } with {
      briefly "Active team state data"
      described as {
        |Data for an active team in the league.
      }
    }
    state ActiveTeam of record Team.ActiveTeamData is {
      initial handler ActiveTeamInitHandler is {
        on query GetRosterMetrics is {
          let rosterMetricsView: type RosterMetricsView = prompt("read the roster metrics projection")
          reply rosterMetricsView
        }
        on renameTeam: command RenameTeam is {
          set field Team.ActiveTeam.name to renameTeam.name
          send event TeamRenamed(teamId = renameTeam.teamId, name = renameTeam.name, renamedAt = system.now) to outlet TeamContext.Team.TeamEvents
        }
        on relocateTeam: command RelocateTeam is {
          set field Team.ActiveTeam.city to relocateTeam.city
          send event TeamRelocated(teamId = relocateTeam.teamId, city = relocateTeam.city, relocatedAt = system.now) to outlet TeamContext.Team.TeamEvents
        }
        on query GetTeam is {
          let teamResult: type TeamResult = prompt("read the team from the store")
          reply teamResult
        }
      } with {
        briefly "Active team init handler"
        described as {
          |Initializes the Active team state.
        }
      }
    } with {
      briefly "Active team"
      described as {
        |Team is active in the league.
      }
    }
    initial handler TeamHandler is {
      on init(teamName: String(1,100), teamCity: String(1,50), teamConference: String(1,50), teamDivision: String(1,50), createdAt: TimeStamp) is {
        morph entity TeamContext.Team to state TeamContext.Team.ActiveTeam with record Team.ActiveTeamData(teamId = self.id, name = teamName, city = teamCity, conference = teamConference, division = teamDivision, rosterSize = 0, salaryCap = prompt("the salary cap a new team starts with"), currentPayroll = 0)
        send event TeamCreated(teamId = self.id, name = teamName, city = teamCity, conference = teamConference, division = teamDivision, createdAt = createdAt) to outlet TeamContext.Team.TeamEvents
      }
    } with {
      briefly "Handles team management commands"
      described as {
        | Processes team-level commands for franchise operations.
      }
    }
  } with {
    briefly "Represents a professional sports team"
    described as {
      | Manages team identity, roster limits, and salary cap tracking
      | for a franchise within the league.
    }
  }
  type PlayerRepositoryCommand is one of {
    TeamContext.PlayerRepository.PersistContractExtended or TeamContext.PlayerRepository.PersistTeamCreated or TeamContext.PlayerRepository.PersistTeamRenamed or TeamContext.PlayerRepository.PersistTeamRelocated or TeamContext.PlayerRepository.PersistPlayerAssignedToRoster or TeamContext.PlayerRepository.PersistPlayerPlacedOnInjuredReserve or TeamContext.PlayerRepository.PersistPlayerReleased or TeamContext.PlayerRepository.PersistPlayerSigned or TeamContext.PlayerRepository.PersistPlayerTraded
  } with {
    briefly "Anything that writes the PlayerRepository"
    described as {
      |The persistence commands PlayerRepository accepts. RosterMetrics turns
      |each Player and Team event into one of these.
    }
  }
  // Repository for player data persistence
  repository PlayerRepository as merge is {
    type PlayerRepositoryQuery is one of {
      GetPlayerById or GetPlayersByTeam or GetPlayersByStatus or GetFreeAgents
    } with {
      briefly "What may be asked of PlayerRepository"
      described as {
        |The look-ups the player repository answers.
      }
    }
    type PlayerRepositoryReply is one of {
      PlayerList or PlayerRecord
    } with {
      briefly "What PlayerRepository answers"
      described as {
        |The answers the player repository gives.
      }
    }
    inlet PlayerRepositoryQueries is type PlayerRepositoryQuery with {
      briefly "Look-ups of this player repository"
      described as {
        |What TeamManagementApp asks of the player repository, by way of TeamContext.
      }
    }
    inlet PlayerRepositoryFromRosterMetrics is type PlayerRepositoryCommand with {
      briefly "What RosterMetrics sends PlayerRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    command PersistContractExtended is {
      playerId: PlayerId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContractExtended applies to.
        }
      }
      contractId: ContractId? with {
        briefly "Contract id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newEndDate: Date? with {
        briefly "New end date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newTotalValue: Decimal(12,2)? with {
        briefly "New total value"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      extendedAt: TimeStamp? with {
        briefly "Extended at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ContractExtended"
      described as {
        |Instructs this repository to apply ContractExtended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTeamCreated is {
      teamId: TeamId with {
        briefly "Row addressed"
        described as {
          |Which stored row TeamCreated applies to.
        }
      }
    } with {
      briefly "Persist TeamCreated"
      described as {
        |Instructs this repository to apply TeamCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTeamRenamed is {
      teamId: TeamId with {
        briefly "Row addressed"
        described as {
          |Which stored row TeamRenamed applies to.
        }
      }
      name: String(1,100)? with {
        briefly "New name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TeamRenamed"
      described as {
        |Instructs this repository to apply TeamRenamed to the stored row. A persistence command, not a domain command: it declares no `yields` because storing a row records no new entity state.
      }
    }
    command PersistTeamRelocated is {
      teamId: TeamId with {
        briefly "Row addressed"
        described as {
          |Which stored row TeamRelocated applies to.
        }
      }
      city: String(1,50)? with {
        briefly "New city"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TeamRelocated"
      described as {
        |Instructs this repository to apply TeamRelocated to the stored row. A persistence command, not a domain command: it declares no `yields` because storing a row records no new entity state.
      }
    }
    command PersistPlayerAssignedToRoster is {
      playerId: PlayerId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayerAssignedToRoster applies to.
        }
      }
      position: String(1,20)? with {
        briefly "Position"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      jerseyNumber: Integer? with {
        briefly "Jersey number"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      status: PlayerStatus? with {
        briefly "Status"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PlayerAssignedToRoster"
      described as {
        |Instructs this repository to apply PlayerAssignedToRoster to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayerPlacedOnInjuredReserve is {
      playerId: PlayerId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayerPlacedOnInjuredReserve applies to.
        }
      }
      injuryDescription: String(1,500)? with {
        briefly "Injury description"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      expectedReturnDate: Date? with {
        briefly "Expected return date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      placedAt: TimeStamp? with {
        briefly "Placed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PlayerPlacedOnInjuredReserve"
      described as {
        |Instructs this repository to apply PlayerPlacedOnInjuredReserve to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayerReleased is {
      playerId: PlayerId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayerReleased applies to.
        }
      }
      releaseDate: Date? with {
        briefly "Release date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      releasedAt: TimeStamp? with {
        briefly "Released at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PlayerReleased"
      described as {
        |Instructs this repository to apply PlayerReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayerSigned is {
      playerId: PlayerId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayerSigned applies to.
        }
      }
      playerInfo: PlayerInfo? with {
        briefly "Player info"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      contract: ContractInfo? with {
        briefly "Contract"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      teamId: TeamId? with {
        briefly "Team id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      signedAt: TimeStamp? with {
        briefly "Signed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PlayerSigned"
      described as {
        |Instructs this repository to apply PlayerSigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayerTraded is {
      playerId: PlayerId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayerTraded applies to.
        }
      }
      tradeInfo: TradeInfo? with {
        briefly "Trade info"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      tradedAt: TimeStamp? with {
        briefly "Traded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PlayerTraded"
      described as {
        |Instructs this repository to apply PlayerTraded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredPlayer is {
      playerId: PlayerId with {
        briefly "playerId"
        described as {
          |The playerId column of the stored player row.
        }
      }
      contractId: ContractId? with {
        briefly "Contract id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newEndDate: Date? with {
        briefly "New end date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newTotalValue: Decimal(12,2)? with {
        briefly "New total value"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      extendedAt: TimeStamp? with {
        briefly "Extended at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      position: String(1,20)? with {
        briefly "Position"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      jerseyNumber: Integer? with {
        briefly "Jersey number"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      status: PlayerStatus? with {
        briefly "Status"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      injuryDescription: String(1,500)? with {
        briefly "Injury description"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      expectedReturnDate: Date? with {
        briefly "Expected return date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      placedAt: TimeStamp? with {
        briefly "Placed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      releaseDate: Date? with {
        briefly "Release date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      releasedAt: TimeStamp? with {
        briefly "Released at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      playerInfo: PlayerInfo? with {
        briefly "Player info"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      contract: ContractInfo? with {
        briefly "Contract"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      teamId: TeamId? with {
        briefly "Team id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      signedAt: TimeStamp? with {
        briefly "Signed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      tradeInfo: TradeInfo? with {
        briefly "Trade info"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      tradedAt: TimeStamp? with {
        briefly "Traded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored player row"
      described as {
        |The persistence shape of player data as this repository stores it.
      }
    }
    schema PlayerData is relational
      of players as record StoredPlayer
        key on field StoredPlayer.playerId
 with {
      briefly "Player data schema"
      described as {
        |The relational schema persisting player records for this repository.
      }
    }
    outlet PlayerRepositoryResponses is type PlayerRepositoryReply
    query GetPlayerById replies result PlayerRecord is {
      playerId: PlayerId with {
        briefly "Player to retrieve"
        described as {
          |Identifier of the player to look up.
        }
      }
    } with {
      briefly "Retrieve player by unique identifier"
      described as {
        | Fetches complete player record including current status,
        | contract, and roster assignment.
      }
    }
    query GetPlayersByTeam replies result PlayerList is {
      teamId: TeamId with {
        briefly "Team to query"
        described as {
          |Identifier of the team whose roster to retrieve.
        }
      }
    } with {
      briefly "Retrieve all players for a team"
      described as {
        | Returns the complete roster of players currently signed
        | to the specified team.
      }
    }
    query GetPlayersByStatus replies result PlayerList is {
      teamId: TeamId with {
        briefly "Team to query"
        described as {
          |Identifier of the team to filter.
        }
      }
      status: PlayerStatus with {
        briefly "Status filter"
        described as {
          |Status to filter players by.
        }
      }
    } with {
      briefly "Retrieve players by roster status"
      described as {
        | Filters team roster by status such as Active, InjuredReserve,
        | or PracticeSquad.
      }
    }
    query GetFreeAgents replies result PlayerList is {
      positionFilter: String(1,20)? with {
        briefly "Position filter"
        described as {
          |Optional position to filter free agents.
        }
      }
    } with {
      briefly "Retrieve available free agents"
      described as {
        | Returns players not currently under contract, optionally
        | filtered by position.
      }
    }
    result PlayerRecord is {
      playerId: PlayerId with {
        briefly "Player identifier"
        described as {
          |Unique identifier for the player.
        }
      }
      playerInfo: PlayerInfo with {
        briefly "Player information"
        described as {
          |Biographical data for the player.
        }
      }
      currentContract: ContractInfo? with {
        briefly "Contract information"
        described as {
          |Current contract if signed.
        }
      }
      currentTeamId: TeamId? with {
        briefly "Current team"
        described as {
          |Team the player is signed with if any.
        }
      }
      status: PlayerStatus with {
        briefly "Player status"
        described as {
          |Current roster status.
        }
      }
      rosterSlot: RosterSlot? with {
        briefly "Roster slot"
        described as {
          |Current roster assignment if any.
        }
      }
    } with {
      briefly "Complete player data record"
      described as {
        | Full player information including biographical data,
        | contract terms, team assignment, and current status.
      }
    }
    result PlayerList is {
      players: PlayerRecord+ with {
        briefly "Player records"
        described as {
          |Collection of player records matching the query.
        }
      }
    } with {
      briefly "Collection of player records"
      described as {
        | List of player records for roster queries.
      }
    }
    handler PlayerPersistence is {
      on persistContractExtended: command PersistContractExtended is {
        update PlayerData.players set contractId = persistContractExtended.contractId, newEndDate = persistContractExtended.newEndDate, newTotalValue = persistContractExtended.newTotalValue, extendedAt = persistContractExtended.extendedAt where playerId == persistContractExtended.playerId
      }
      on persistTeamCreated: command PersistTeamCreated is {
        do "apply TeamCreated to the stored row"
      }
      on persistTeamRenamed: command PersistTeamRenamed is {
        do "apply TeamRenamed to the stored row"
      }
      on persistTeamRelocated: command PersistTeamRelocated is {
        do "apply TeamRelocated to the stored row"
      }
      on persistPlayerAssignedToRoster: command PersistPlayerAssignedToRoster is {
        update PlayerData.players set position = persistPlayerAssignedToRoster.position, jerseyNumber = persistPlayerAssignedToRoster.jerseyNumber, status = persistPlayerAssignedToRoster.status, assignedAt = persistPlayerAssignedToRoster.assignedAt where playerId == persistPlayerAssignedToRoster.playerId
      }
      on persistPlayerPlacedOnInjuredReserve: command PersistPlayerPlacedOnInjuredReserve is {
        update PlayerData.players set injuryDescription = persistPlayerPlacedOnInjuredReserve.injuryDescription, expectedReturnDate = persistPlayerPlacedOnInjuredReserve.expectedReturnDate, placedAt = persistPlayerPlacedOnInjuredReserve.placedAt where playerId == persistPlayerPlacedOnInjuredReserve.playerId
      }
      on persistPlayerReleased: command PersistPlayerReleased is {
        update PlayerData.players set releaseDate = persistPlayerReleased.releaseDate, reason = persistPlayerReleased.reason, releasedAt = persistPlayerReleased.releasedAt where playerId == persistPlayerReleased.playerId
      }
      on persistPlayerSigned: command PersistPlayerSigned is {
        update PlayerData.players set playerInfo = persistPlayerSigned.playerInfo, contract = persistPlayerSigned.contract, teamId = persistPlayerSigned.teamId, signedAt = persistPlayerSigned.signedAt where playerId == persistPlayerSigned.playerId
      }
      on persistPlayerTraded: command PersistPlayerTraded is {
        update PlayerData.players set tradeInfo = persistPlayerTraded.tradeInfo, tradedAt = persistPlayerTraded.tradedAt where playerId == persistPlayerTraded.playerId
      }
      on getPlayerById: query GetPlayerById is {
        do "look up the player record by identifier"
        reply result PlayerRecord(playerId = getPlayerById.playerId, playerInfo = prompt("the player info of this player record"), currentContract = empty, currentTeamId = empty, status = prompt("the status of this player record"), rosterSlot = empty)
      }
      on query GetPlayersByTeam is {
        let playerList: type PlayerList = prompt("list the player records belonging to a team")
        reply playerList
      }
      on query GetPlayersByStatus is {
        let playerList: type PlayerList = prompt("list the player records in a given status")
        reply playerList
      }
      on query GetFreeAgents is {
        let playerList: type PlayerList = prompt("list the player records not currently under contract")
        reply playerList
      }
    } with {
      briefly "Player persistence"
      described as {
        |Answers roster queries from the persisted player records.
      }
    }
  } with {
    briefly "Persistence layer for player data"
    described as {
      | Provides query capabilities for player data including lookups
      | by ID, team, status, and free agency. Supports roster management
      | and player acquisition workflows.
    }
  }
  // Projector for roster analytics
  projector RosterMetrics as merge is {
    updates repository TeamContext.PlayerRepository
    outlet RosterMetricsToRepository is type PlayerRepositoryCommand
 with {
      briefly "What RosterMetrics publishes to PlayerRepository"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to PlayerRepository needs this port to travel on.
      }
    }
    inlet RosterMetricsFromPlayer is type PlayerEvent
    inlet RosterMetricsFromTeam is type TeamEvent
    record RosterMetricsRecord is {
      teamId: TeamId with {
        briefly "Team identifier"
        described as {
          |Team these metrics belong to.
        }
      }
      totalPlayers: Integer with {
        briefly "Total players"
        described as {
          |Total number of players under contract.
        }
      }
      activePlayers: Integer with {
        briefly "Active players"
        described as {
          |Players on the active roster.
        }
      }
      injuredReservePlayers: Integer with {
        briefly "IR players"
        described as {
          |Players on injured reserve.
        }
      }
      practiceSquadPlayers: Integer with {
        briefly "Practice squad"
        described as {
          |Players on the practice squad.
        }
      }
      totalPayroll: Decimal(12,2) with {
        briefly "Total payroll"
        described as {
          |Sum of all player salaries.
        }
      }
      capSpace: Decimal(12,2) with {
        briefly "Cap space"
        described as {
          |Remaining salary cap room.
        }
      }
      averageAge: Decimal(4,1) with {
        briefly "Average age"
        described as {
          |Average age of rostered players.
        }
      }
      averageSalary: Decimal(12,2) with {
        briefly "Average salary"
        described as {
          |Average player salary.
        }
      }
      positionCounts: String(1,500) with {
        briefly "Position counts"
        described as {
          |JSON representation of players per position.
        }
      }
      lastUpdated: TimeStamp with {
        briefly "Last updated"
        described as {
          |When these metrics were last calculated.
        }
      }
    } with {
      briefly "Aggregated roster statistics"
      described as {
        | Pre-computed metrics for roster composition, salary
        | distribution, and team demographics.
      }
    }
    handler RosterMetricsHandler is {
      on contractExtended: event Player.ContractExtended is {
        tell command TeamContext.PlayerRepository.PersistContractExtended(playerId = contractExtended.playerId, contractId = contractExtended.contractId, newEndDate = contractExtended.newEndDate, newTotalValue = contractExtended.newTotalValue, extendedAt = contractExtended.extendedAt) to repository TeamContext.PlayerRepository
        do "apply ContractExtended to the RosterMetrics projection"
      }
      on teamCreated: event Team.TeamCreated is {
        tell command TeamContext.PlayerRepository.PersistTeamCreated(teamId = teamCreated.teamId) to repository TeamContext.PlayerRepository
        do "apply TeamCreated to the RosterMetrics projection"
      }
      on teamRenamed: event Team.TeamRenamed is {
        tell command TeamContext.PlayerRepository.PersistTeamRenamed(teamId = teamRenamed.teamId, name = teamRenamed.name) to repository TeamContext.PlayerRepository
        do "apply TeamRenamed to the RosterMetrics projection"
      }
      on teamRelocated: event Team.TeamRelocated is {
        tell command TeamContext.PlayerRepository.PersistTeamRelocated(teamId = teamRelocated.teamId, city = teamRelocated.city) to repository TeamContext.PlayerRepository
        do "apply TeamRelocated to the RosterMetrics projection"
      }
      on playerSigned: event Player.PlayerSigned is {
        tell command TeamContext.PlayerRepository.PersistPlayerSigned(playerId = playerSigned.playerId, playerInfo = playerSigned.playerInfo, contract = playerSigned.contract, teamId = playerSigned.teamId, signedAt = playerSigned.signedAt) to repository TeamContext.PlayerRepository
        set field RosterMetricsRecord.totalPlayers to "RosterMetricsRecord.totalPlayers + 1"
      }
      on playerReleased: event Player.PlayerReleased is {
        tell command TeamContext.PlayerRepository.PersistPlayerReleased(playerId = playerReleased.playerId, releaseDate = playerReleased.releaseDate, reason = playerReleased.reason, releasedAt = playerReleased.releasedAt) to repository TeamContext.PlayerRepository
        set field RosterMetricsRecord.totalPlayers to "RosterMetricsRecord.totalPlayers - 1"
      }
      on playerTraded: event Player.PlayerTraded is {
        tell command TeamContext.PlayerRepository.PersistPlayerTraded(playerId = playerTraded.playerId, tradeInfo = playerTraded.tradeInfo, tradedAt = playerTraded.tradedAt) to repository TeamContext.PlayerRepository
        set field RosterMetricsRecord.lastUpdated to "now()"
      }
      on playerPlacedOnInjuredReserve: event Player.PlayerPlacedOnInjuredReserve is {
        tell command TeamContext.PlayerRepository.PersistPlayerPlacedOnInjuredReserve(playerId = playerPlacedOnInjuredReserve.playerId, injuryDescription = playerPlacedOnInjuredReserve.injuryDescription, expectedReturnDate = playerPlacedOnInjuredReserve.expectedReturnDate, placedAt = playerPlacedOnInjuredReserve.placedAt) to repository TeamContext.PlayerRepository
        set field RosterMetricsRecord.injuredReservePlayers to "RosterMetricsRecord.injuredReservePlayers + 1"
      }
      on playerAssignedToRoster: event Player.PlayerAssignedToRoster is {
        tell command TeamContext.PlayerRepository.PersistPlayerAssignedToRoster(playerId = playerAssignedToRoster.playerId, position = playerAssignedToRoster.position, jerseyNumber = playerAssignedToRoster.jerseyNumber, status = playerAssignedToRoster.status, assignedAt = playerAssignedToRoster.assignedAt) to repository TeamContext.PlayerRepository
        set field RosterMetricsRecord.activePlayers to "RosterMetricsRecord.activePlayers + 1"
      }
    } with {
      briefly "Updates metrics based on roster events"
      described as {
        | Listens to player lifecycle events and maintains
        | up-to-date roster analytics for reporting and compliance.
      }
    }
  } with {
    briefly "Real-time roster analytics projection"
    described as {
      | Maintains a continuously updated view of roster composition,
      | salary cap utilization, and team demographics. Used for
      | front office decision support and league compliance reporting.
    }
  }
  streamlet PlayerEventSplit as split is {
    outlet PlayerEventSplitToPlayerSignedAnswer is event TeamManagement.TeamContext.Player.PlayerSigned
    inlet PlayerEventSplitIn is type PlayerEvent
    outlet PlayerEventSplitToRosterMetrics is type PlayerEvent
    handler PlayerEventSplitHandler is {
      on playerSigned: event Player.PlayerSigned is {
        send playerSigned to outlet PlayerEventSplitToRosterMetrics
        send playerSigned to outlet PlayerEventSplitToPlayerSignedAnswer
      }
      on playerAssignedToRoster: event Player.PlayerAssignedToRoster is {
        send playerAssignedToRoster to outlet PlayerEventSplitToRosterMetrics
      }
      on contractExtended: event Player.ContractExtended is {
        send contractExtended to outlet PlayerEventSplitToRosterMetrics
      }
      on playerTraded: event Player.PlayerTraded is {
        send playerTraded to outlet PlayerEventSplitToRosterMetrics
      }
      on playerReleased: event Player.PlayerReleased is {
        send playerReleased to outlet PlayerEventSplitToRosterMetrics
      }
      on playerPlacedOnInjuredReserve: event Player.PlayerPlacedOnInjuredReserve is {
        send playerPlacedOnInjuredReserve to outlet PlayerEventSplitToRosterMetrics
      }
      on other is {
        error "Unexpected message for processor PlayerEventSplit"
      }
    } with {
      briefly "Player event fan-out handler"
      described as {
        |Delivers each Player event to all of its consumers.
      }
    }
  } with {
    briefly "Player event fan-out"
    described as {
      |Fans Player events out to the repository and projectors.
    }
  }
  streamlet TeamEventSplit as split is {
    outlet TeamEventSplitToTeamCreatedAnswer is event TeamManagement.TeamContext.Team.TeamCreated
    inlet TeamEventSplitIn is type TeamEvent
    outlet TeamEventSplitToRosterMetrics is type TeamEvent
    handler TeamEventSplitHandler is {
      on teamCreated: event Team.TeamCreated is {
        send teamCreated to outlet TeamEventSplitToRosterMetrics
        send teamCreated to outlet TeamEventSplitToTeamCreatedAnswer
      }
      on teamRenamed: event Team.TeamRenamed is {
        send teamRenamed to outlet TeamEventSplitToRosterMetrics
      }
      on teamRelocated: event Team.TeamRelocated is {
        send teamRelocated to outlet TeamEventSplitToRosterMetrics
      }
      on other is {
        error "Unexpected message for processor TeamEventSplit"
      }
    } with {
      briefly "Team event fan-out handler"
      described as {
        |Delivers each Team event to all of its consumers.
      }
    }
  } with {
    briefly "Team event fan-out"
    described as {
      |Fans Team events out to the repository and projectors.
    }
  }
  connector 'PlayerEvent Stream' is from outlet TeamContext.Player.PlayerEvents2 to inlet TeamContext.PlayerEventSplit.PlayerEventSplitIn with {
    briefly "Player events, fanned out to storage and read models"
  }
  connector 'PlayerEvent Feed' is from outlet TeamContext.PlayerEventSplit.PlayerEventSplitToRosterMetrics to inlet TeamContext.RosterMetrics.RosterMetricsFromPlayer with {
    briefly "PlayerEvent feeding the RosterMetrics projection"
  }
  connector 'TeamEvent Stream' is from outlet TeamContext.Team.TeamEvents to inlet TeamContext.TeamEventSplit.TeamEventSplitIn with {
    briefly "Team events, fanned out to storage and read models"
  }
  connector 'TeamEvent Feed' is from outlet TeamContext.TeamEventSplit.TeamEventSplitToRosterMetrics to inlet TeamContext.RosterMetrics.RosterMetricsFromTeam with {
    briefly "TeamEvent feeding the RosterMetrics projection"
  }
} with {
  briefly "Bounded context for team roster management"
  described as {
    | The TeamContext encompasses all operations related to managing
    | a professional sports team's roster. This includes player signing,
    | contract management, roster assignments, trades, and releases.
    | It integrates with external contexts for league approval, salary
    | cap validation, and injury reporting.
  }
}
