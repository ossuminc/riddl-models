// Team Management bounded context
context TeamContext as router is {
  inlet PlayerCommandStreamIn is type PlayerCommand  outlet PlayerCommandStreamOut is type PlayerCommand
  inlet TeamCommandStreamIn is type TeamCommand  outlet TeamCommandStreamOut is type TeamCommand
  inlet PlayerResultStreamIn is type Player.PlayerResult  outlet PlayerResultStreamOut is type Player.PlayerResult
  handler TeamContextBoundary is {
    on signPlayer: command Player.SignPlayer is {
      forward signPlayer to outlet TeamContext.PlayerCommandStreamOut
    }
    on assignToRoster: command Player.AssignToRoster is {
      forward assignToRoster to outlet TeamContext.PlayerCommandStreamOut
    }
    on extendContract: command Player.ExtendContract is {
      forward extendContract to outlet TeamContext.PlayerCommandStreamOut
    }
    on tradePlayer: command Player.TradePlayer is {
      forward tradePlayer to outlet TeamContext.PlayerCommandStreamOut
    }
    on releasePlayer: command Player.ReleasePlayer is {
      forward releasePlayer to outlet TeamContext.PlayerCommandStreamOut
    }
    on placeOnInjuredReserve: command Player.PlaceOnInjuredReserve is {
      forward placeOnInjuredReserve to outlet TeamContext.PlayerCommandStreamOut
    }
    on createTeam: command Team.CreateTeam is {
      send createTeam to outlet TeamContext.TeamCommandStreamOut
    }
    on playerResult: result Player.PlayerResult is {
      send playerResult to outlet TeamContext.PlayerResultStreamOut
    }
    on other is {
      error "Unexpected message at the TeamContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PlayerCommand Stream Intake' is from outlet TeamContext.PlayerCommandStreamOut to inlet TeamContext.Player.PlayerCommands  connector 'TeamCommand Stream Intake' is from outlet TeamContext.TeamCommandStreamOut to inlet TeamContext.Team.TeamCommands  connector 'PlayerResult Stream Egress' is from outlet TeamContext.PlayerRepository.PlayerRepositoryResponses to inlet TeamContext.PlayerResultStreamIn  query GetRosterMetrics replies result RosterMetricsView is  {
    rosterMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which RosterMetrics to retrieve.
      }
    }
  } with {
    briefly "Get RosterMetrics"
    described as {
      |Retrieves a RosterMetrics projection.
    }
  }
  result RosterMetricsView is  {
    rosterMetrics: RosterMetricsRecord with {
      briefly "RosterMetrics"
      described as {
        |The RosterMetrics data being returned.
      }
    }
  } with {
    briefly "RosterMetrics view"
    described as {
      |Read model view carrying a RosterMetricsRecord.
    }
  }
  include "types.riddl"
  include "Player.riddl"
  // Team entity for managing team-level operations
  aggregate entity Team as flow is {
    type TeamCommand is one of {
      Team.CreateTeam
    } with {
      briefly "Team command alternation"
      described as {
        |Commands accepted by the Team entity.
      }
    }
    type TeamEvent is Team.TeamCreated with {
      briefly "Team event alternation"
      described as {
        |Events published by the Team entity.
      }
    }
    inlet TeamCommands is type TeamCommand    outlet TeamEvents is type TeamEvent
    query GetTeam is  {
      teamId: TeamId with {
        briefly "ID"
        described as {
          |Identifier of the Team to retrieve.
        }
      }
    } with {
      briefly "Get Team"
      described as {
        |Retrieve Team data by identifier.
      }
    }
    result TeamResult is  {
      teamId: TeamId with {
        briefly "Team addressed"
        described as {
          |Which team this message concerns. Named directly rather
          |than left to a wrapped record, because a nested record cannot say
          |which instance is addressed.
        }
      }
      teamData: Team.ActiveTeamData with {
        briefly "Team data"
        described as {
          |The requested Team data.
        }
      }
    } with {
      briefly "Team result"
      described as {
        |Result carrying the requested Team data.
      }
    }
    command CreateTeam is  {
      teamId: TeamId with {
        briefly "Team identifier"
        described as {
          |Unique identifier for the new team.
        }
      }
      name: String(1,100) with {
        briefly "Team name"
        described as {
          |Official name of the team.
        }
      }
      city: String(1,50) with {
        briefly "City"
        described as {
          |City where the team is based.
        }
      }
      conference: String(1,50) with {
        briefly "Conference"
        described as {
          |League conference the team belongs to.
        }
      }
      division: String(1,50) with {
        briefly "Division"
        described as {
          |Division within the conference.
        }
      }
    } with {
      briefly "Create a new team in the system"
      described as {
        | Initializes a new franchise with basic identifying information
        | including geographic and league organizational details.
      }
    }
    event TeamCreated is  {
      teamId: TeamId with {
        briefly "Team identifier"
        described as {
          |Identifier of the created team.
        }
      }
      name: String(1,100) with {
        briefly "Team name"
        described as {
          |Name of the created team.
        }
      }
      city: String(1,50) with {
        briefly "City"
        described as {
          |City where the team is based.
        }
      }
      conference: String(1,50) with {
        briefly "Conference"
        described as {
          |Conference assignment.
        }
      }
      division: String(1,50) with {
        briefly "Division"
        described as {
          |Division assignment.
        }
      }
      createdAt: TimeStamp with {
        briefly "Creation timestamp"
        described as {
          |When the team was created.
        }
      }
    } with {
      briefly "Team has been created"
      described as {
        | Records the creation of a new team entity in the system.
      }
    }
    record ActiveTeamData is  {
      teamId: TeamId with {
        briefly "Team ID"
        described as {
          |Unique team identifier.
        }
      }
      name: String(1,100) with {
        briefly "Name"
        described as {
          |Official team name.
        }
      }
      city: String(1,50) with {
        briefly "City"
        described as {
          |Team's home city.
        }
      }
      conference: String(1,50) with {
        briefly "Conference"
        described as {
          |League conference.
        }
      }
      division: String(1,50) with {
        briefly "Division"
        described as {
          |Conference division.
        }
      }
      rosterSize: Integer with {
        briefly "Roster size"
        described as {
          |Current player count.
        }
      }
      salaryCap: Decimal(12,2) with {
        briefly "Salary cap"
        described as {
          |Maximum payroll.
        }
      }
      currentPayroll: Decimal(12,2) with {
        briefly "Payroll"
        described as {
          |Current payroll.
        }
      }
    } with {
      briefly "Active team state data"
      described as {
        |Data for an active team in the league.
      }
    }
    initial state ActiveTeam of record Team.ActiveTeamData is {
      initial handler ActiveTeamInitHandler is {
        on query GetRosterMetrics is {
          let rosterMetricsView: type RosterMetricsView = prompt("read the roster metrics projection")
          reply rosterMetricsView
        }
        on query GetTeam is {
          let teamResult: type TeamResult = prompt("read the team from the store")
          tell teamResult to entity TeamContext.Team
        }
        on init is {
          set state ActiveTeam to "initialize from TeamCreated event"
        }
      } with {
        briefly "Active team init handler"
        described as {
          |Initializes the Active team state.
        }
      }
    } with {
      briefly "Active team"
      described as {
        |Team is active in the league.
      }
    }
    initial handler TeamHandler is {
    on teamCreated: event TeamCreated is {
      do "apply TeamCreated to the team so it can be persisted and replayed"
    }
      on createTeam: command CreateTeam is {
        yield event TeamCreated(teamId = createTeam.teamId, name = createTeam.name, city = createTeam.city, conference = createTeam.conference, division = createTeam.division, createdAt = prompt("the created at of this team created"))
      }
    } with {
      briefly "Handles team management commands"
      described as {
        | Processes team-level commands for franchise operations.
      }
    }
  } with {
    briefly "Represents a professional sports team"
    described as {
      | Manages team identity, roster limits, and salary cap tracking
      | for a franchise within the league.
    }
  }
  // Repository for player data persistence
  repository PlayerRepository as flow is {
    command PersistContractExtended is  {
      playerId: PlayerId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContractExtended applies to.
        }
      }
    } with {
      briefly "Persist ContractExtended"
      described as {
        |Instructs this repository to apply ContractExtended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTeamCreated is  {
      teamId: TeamId with {
        briefly "Row addressed"
        described as {
          |Which stored row TeamCreated applies to.
        }
      }
    } with {
      briefly "Persist TeamCreated"
      described as {
        |Instructs this repository to apply TeamCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayerAssignedToRoster is  {
      playerId: PlayerId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayerAssignedToRoster applies to.
        }
      }
    } with {
      briefly "Persist PlayerAssignedToRoster"
      described as {
        |Instructs this repository to apply PlayerAssignedToRoster to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayerPlacedOnInjuredReserve is  {
      playerId: PlayerId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayerPlacedOnInjuredReserve applies to.
        }
      }
    } with {
      briefly "Persist PlayerPlacedOnInjuredReserve"
      described as {
        |Instructs this repository to apply PlayerPlacedOnInjuredReserve to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayerReleased is  {
      playerId: PlayerId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayerReleased applies to.
        }
      }
    } with {
      briefly "Persist PlayerReleased"
      described as {
        |Instructs this repository to apply PlayerReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayerSigned is  {
      playerId: PlayerId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayerSigned applies to.
        }
      }
    } with {
      briefly "Persist PlayerSigned"
      described as {
        |Instructs this repository to apply PlayerSigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayerTraded is  {
      playerId: PlayerId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayerTraded applies to.
        }
      }
    } with {
      briefly "Persist PlayerTraded"
      described as {
        |Instructs this repository to apply PlayerTraded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredPlayer is  {
      playerId: PlayerId with {
        briefly "playerId"
        described as {
          |The playerId column of the stored player row.
        }
      }
    } with {
      briefly "Stored player row"
      described as {
        |The persistence shape of player data as this repository stores it.
      }
    }
    schema PlayerData is relational
      of players as type StoredPlayer
        index on field StoredPlayer.playerId
 with {
      briefly "Player data schema"
      described as {
        |The relational schema persisting player records for this repository.
      }
    }
    inlet PlayerRepositoryFromTeam is type TeamEvent    outlet PlayerRepositoryResponses is type Player.PlayerResult
    query GetPlayerById replies result PlayerRecord is  {
      playerId: PlayerId with {
        briefly "Player to retrieve"
        described as {
          |Identifier of the player to look up.
        }
      }
    } with {
      briefly "Retrieve player by unique identifier"
      described as {
        | Fetches complete player record including current status,
        | contract, and roster assignment.
      }
    }
    query GetPlayersByTeam replies result PlayerList is  {
      teamId: TeamId with {
        briefly "Team to query"
        described as {
          |Identifier of the team whose roster to retrieve.
        }
      }
    } with {
      briefly "Retrieve all players for a team"
      described as {
        | Returns the complete roster of players currently signed
        | to the specified team.
      }
    }
    query GetPlayersByStatus replies result PlayerList is  {
      teamId: TeamId with {
        briefly "Team to query"
        described as {
          |Identifier of the team to filter.
        }
      }
      status: PlayerStatus with {
        briefly "Status filter"
        described as {
          |Status to filter players by.
        }
      }
    } with {
      briefly "Retrieve players by roster status"
      described as {
        | Filters team roster by status such as Active, InjuredReserve,
        | or PracticeSquad.
      }
    }
    query GetFreeAgents replies result PlayerList is  {
      positionFilter: String(1,20)? with {
        briefly "Position filter"
        described as {
          |Optional position to filter free agents.
        }
      }
    } with {
      briefly "Retrieve available free agents"
      described as {
        | Returns players not currently under contract, optionally
        | filtered by position.
      }
    }
    result PlayerRecord is  {
      playerId: PlayerId with {
        briefly "Player identifier"
        described as {
          |Unique identifier for the player.
        }
      }
      playerInfo: PlayerInfo with {
        briefly "Player information"
        described as {
          |Biographical data for the player.
        }
      }
      currentContract: ContractInfo? with {
        briefly "Contract information"
        described as {
          |Current contract if signed.
        }
      }
      currentTeamId: TeamId? with {
        briefly "Current team"
        described as {
          |Team the player is signed with if any.
        }
      }
      status: PlayerStatus with {
        briefly "Player status"
        described as {
          |Current roster status.
        }
      }
      rosterSlot: RosterSlot? with {
        briefly "Roster slot"
        described as {
          |Current roster assignment if any.
        }
      }
    } with {
      briefly "Complete player data record"
      described as {
        | Full player information including biographical data,
        | contract terms, team assignment, and current status.
      }
    }
    result PlayerList is  {
      players: PlayerRecord+ with {
        briefly "Player records"
        described as {
          |Collection of player records matching the query.
        }
      }
    } with {
      briefly "Collection of player records"
      described as {
        | List of player records for roster queries.
      }
    }
    handler PlayerPersistence is {
      on other is {
        do "the remaining members of this inlet's type - rejections and events this repository does not act on - change nothing here"
      }
      on persistContractExtended: command PersistContractExtended is {
        do "apply ContractExtended to the stored row"
      }
      on persistTeamCreated: command PersistTeamCreated is {
        do "apply TeamCreated to the stored row"
      }
      on persistPlayerAssignedToRoster: command PersistPlayerAssignedToRoster is {
        do "apply PlayerAssignedToRoster to the stored row"
      }
      on persistPlayerPlacedOnInjuredReserve: command PersistPlayerPlacedOnInjuredReserve is {
        do "apply PlayerPlacedOnInjuredReserve to the stored row"
      }
      on persistPlayerReleased: command PersistPlayerReleased is {
        do "apply PlayerReleased to the stored row"
      }
      on persistPlayerSigned: command PersistPlayerSigned is {
        do "apply PlayerSigned to the stored row"
      }
      on persistPlayerTraded: command PersistPlayerTraded is {
        do "apply PlayerTraded to the stored row"
      }
      on getPlayerById: query GetPlayerById is {
        do "look up the player record by identifier"
        reply result PlayerRecord(playerId = getPlayerById.playerId, playerInfo = prompt("the player info of this player record"), currentContract = empty, currentTeamId = empty, status = prompt("the status of this player record"), rosterSlot = empty)
      }
      on query GetPlayersByTeam is {
        let playerList: type PlayerList = prompt("list the player records belonging to a team")
        reply playerList
      }
      on query GetPlayersByStatus is {
        let playerList: type PlayerList = prompt("list the player records in a given status")
        reply playerList
      }
      on query GetFreeAgents is {
        let playerList: type PlayerList = prompt("list the player records not currently under contract")
        reply playerList
      }
    } with {
      briefly "Player persistence"
      described as {
        |Answers roster queries from the persisted player records.
      }
    }
  } with {
    briefly "Persistence layer for player data"
    described as {
      | Provides query capabilities for player data including lookups
      | by ID, team, status, and free agency. Supports roster management
      | and player acquisition workflows.
    }
  }
  // Projector for roster analytics
  projector RosterMetrics as sink is {
    updates repository TeamContext.PlayerRepository
    inlet RosterMetricsFromPlayer is type PlayerEvent    inlet RosterMetricsFromTeam is type TeamEvent
    record RosterMetricsRecord is  {
      teamId: TeamId with {
        briefly "Team identifier"
        described as {
          |Team these metrics belong to.
        }
      }
      totalPlayers: Integer with {
        briefly "Total players"
        described as {
          |Total number of players under contract.
        }
      }
      activePlayers: Integer with {
        briefly "Active players"
        described as {
          |Players on the active roster.
        }
      }
      injuredReservePlayers: Integer with {
        briefly "IR players"
        described as {
          |Players on injured reserve.
        }
      }
      practiceSquadPlayers: Integer with {
        briefly "Practice squad"
        described as {
          |Players on the practice squad.
        }
      }
      totalPayroll: Decimal(12,2) with {
        briefly "Total payroll"
        described as {
          |Sum of all player salaries.
        }
      }
      capSpace: Decimal(12,2) with {
        briefly "Cap space"
        described as {
          |Remaining salary cap room.
        }
      }
      averageAge: Decimal(4,1) with {
        briefly "Average age"
        described as {
          |Average age of rostered players.
        }
      }
      averageSalary: Decimal(12,2) with {
        briefly "Average salary"
        described as {
          |Average player salary.
        }
      }
      positionCounts: String(1,500) with {
        briefly "Position counts"
        described as {
          |JSON representation of players per position.
        }
      }
      lastUpdated: TimeStamp with {
        briefly "Last updated"
        described as {
          |When these metrics were last calculated.
        }
      }
    } with {
      briefly "Aggregated roster statistics"
      described as {
        | Pre-computed metrics for roster composition, salary
        | distribution, and team demographics.
      }
    }
    handler RosterMetricsHandler is {
      on contractExtended: event Player.ContractExtended is {
        tell command TeamContext.PlayerRepository.PersistContractExtended(playerId = contractExtended.playerId) to repository TeamContext.PlayerRepository
        do "apply ContractExtended to the RosterMetrics projection"
      }
      on teamCreated: event Team.TeamCreated is {
        tell command TeamContext.PlayerRepository.PersistTeamCreated(teamId = teamCreated.teamId) to repository TeamContext.PlayerRepository
        do "apply TeamCreated to the RosterMetrics projection"
      }
      on playerSigned: event Player.PlayerSigned is {
        tell command TeamContext.PlayerRepository.PersistPlayerSigned(playerId = playerSigned.playerId) to repository TeamContext.PlayerRepository
        set field RosterMetricsRecord.totalPlayers to "RosterMetricsRecord.totalPlayers + 1"
      }
      on playerReleased: event Player.PlayerReleased is {
        tell command TeamContext.PlayerRepository.PersistPlayerReleased(playerId = playerReleased.playerId) to repository TeamContext.PlayerRepository
        set field RosterMetricsRecord.totalPlayers to "RosterMetricsRecord.totalPlayers - 1"
      }
      on playerTraded: event Player.PlayerTraded is {
        tell command TeamContext.PlayerRepository.PersistPlayerTraded(playerId = playerTraded.playerId) to repository TeamContext.PlayerRepository
        set field RosterMetricsRecord.lastUpdated to "now()"
      }
      on playerPlacedOnInjuredReserve: event Player.PlayerPlacedOnInjuredReserve is {
        tell command TeamContext.PlayerRepository.PersistPlayerPlacedOnInjuredReserve(playerId = playerPlacedOnInjuredReserve.playerId) to repository TeamContext.PlayerRepository
        set field RosterMetricsRecord.injuredReservePlayers to "RosterMetricsRecord.injuredReservePlayers + 1"
      }
      on playerAssignedToRoster: event Player.PlayerAssignedToRoster is {
        tell command TeamContext.PlayerRepository.PersistPlayerAssignedToRoster(playerId = playerAssignedToRoster.playerId) to repository TeamContext.PlayerRepository
        set field RosterMetricsRecord.activePlayers to "RosterMetricsRecord.activePlayers + 1"
      }
    } with {
      briefly "Updates metrics based on roster events"
      described as {
        | Listens to player lifecycle events and maintains
        | up-to-date roster analytics for reporting and compliance.
      }
    }
  } with {
    briefly "Real-time roster analytics projection"
    described as {
      | Maintains a continuously updated view of roster composition,
      | salary cap utilization, and team demographics. Used for
      | front office decision support and league compliance reporting.
    }
  }
  processor PlayerEventSplit as flow is {
    inlet PlayerEventSplitIn is type PlayerEvent
    outlet PlayerEventSplitToRosterMetrics is type PlayerEvent
    handler PlayerEventSplitHandler is {
      on playerSigned: event Player.PlayerSigned is {
        send playerSigned to outlet PlayerEventSplitToRosterMetrics
        tell playerSigned to entity TeamContext.Player
      }
      on playerAssignedToRoster: event Player.PlayerAssignedToRoster is {
        send playerAssignedToRoster to outlet PlayerEventSplitToRosterMetrics
        tell playerAssignedToRoster to entity TeamContext.Player
      }
      on contractExtended: event Player.ContractExtended is {
        send contractExtended to outlet PlayerEventSplitToRosterMetrics
        tell contractExtended to entity TeamContext.Player
      }
      on playerTraded: event Player.PlayerTraded is {
        send playerTraded to outlet PlayerEventSplitToRosterMetrics
        tell playerTraded to entity TeamContext.Player
      }
      on playerReleased: event Player.PlayerReleased is {
        send playerReleased to outlet PlayerEventSplitToRosterMetrics
        tell playerReleased to entity TeamContext.Player
      }
      on playerPlacedOnInjuredReserve: event Player.PlayerPlacedOnInjuredReserve is {
        send playerPlacedOnInjuredReserve to outlet PlayerEventSplitToRosterMetrics
        tell playerPlacedOnInjuredReserve to entity TeamContext.Player
      }
      on other is {
        error "Unexpected message for processor PlayerEventSplit"
      }
    } with {
      briefly "Player event fan-out handler"
      described as {
        |Delivers each Player event to all of its consumers.
      }
    }
  } with {
    briefly "Player event fan-out"
    described as {
      |Fans Player events out to the repository and projectors.
    }
  }
  processor TeamEventSplit as split is {
    inlet TeamEventSplitIn is type TeamEvent    outlet TeamEventSplitToPlayerRepository is type TeamEvent
    outlet TeamEventSplitToRosterMetrics is type TeamEvent
    handler TeamEventSplitHandler is {
      on teamCreated: event Team.TeamCreated is {
        send teamCreated to outlet TeamEventSplitToPlayerRepository
        send teamCreated to outlet TeamEventSplitToRosterMetrics
        tell teamCreated to entity TeamContext.Team
      }
      on other is {
        error "Unexpected message for processor TeamEventSplit"
      }
    } with {
      briefly "Team event fan-out handler"
      described as {
        |Delivers each Team event to all of its consumers.
      }
    }
  } with {
    briefly "Team event fan-out"
    described as {
      |Fans Team events out to the repository and projectors.
    }
  }
  connector 'PlayerEvent Stream' is from outlet TeamContext.Player.PlayerEvents2 to inlet TeamContext.PlayerEventSplit.PlayerEventSplitIn with {
    briefly "Player events, fanned out to storage and read models"
  }
  connector 'PlayerEvent Feed' is from outlet TeamContext.PlayerEventSplit.PlayerEventSplitToRosterMetrics to inlet TeamContext.RosterMetrics.RosterMetricsFromPlayer with {
    briefly "PlayerEvent feeding the RosterMetrics projection"
  }
  connector 'TeamEvent Stream' is from outlet TeamContext.Team.TeamEvents to inlet TeamContext.TeamEventSplit.TeamEventSplitIn with {
    briefly "Team events, fanned out to storage and read models"
  }
  connector 'TeamEvent Storage' is from outlet TeamContext.TeamEventSplit.TeamEventSplitToPlayerRepository to inlet TeamContext.PlayerRepository.PlayerRepositoryFromTeam with {
    briefly "Team events on their way to storage"
  }
  connector 'TeamEvent Feed' is from outlet TeamContext.TeamEventSplit.TeamEventSplitToRosterMetrics to inlet TeamContext.RosterMetrics.RosterMetricsFromTeam with {
    briefly "TeamEvent feeding the RosterMetrics projection"
  }
} with {
  briefly "Bounded context for team roster management"
  described as {
    | The TeamContext encompasses all operations related to managing
    | a professional sports team's roster. This includes player signing,
    | contract management, roster assignments, trades, and releases.
    | It integrates with external contexts for league approval, salary
    | cap validation, and injury reporting.
  }
}
