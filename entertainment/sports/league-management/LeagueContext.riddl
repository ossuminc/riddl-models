// League Management - League Context
context LeagueContext as router is {
  inlet LeagueContextFromToBroadcastSystem is command Season.RecordBroadcastSlot with {
    briefly "What ToBroadcastSystem makes of the answers it gets"
  }
  connector 'ToBroadcastSystem Intake' is from outlet LeagueContext.ToBroadcastSystem.ToBroadcastSystemToLeagueContext to inlet LeagueContext.LeagueContextFromToBroadcastSystem with {
    briefly "Answers translated by ToBroadcastSystem, on their way in"
  }
  inlet LeagueContextFromToVenueBooking is command Season.RecordVenueAvailability with {
    briefly "What ToVenueBooking makes of the answers it gets"
  }
  connector 'ToVenueBooking Intake' is from outlet LeagueContext.ToVenueBooking.ToVenueBookingToLeagueContext to inlet LeagueContext.LeagueContextFromToVenueBooking with {
    briefly "Answers translated by ToVenueBooking, on their way in"
  }
  inlet SeasonCommandStreamIn is type SeasonCommand  outlet SeasonCommandStreamOut is type SeasonCommand
  inlet SeasonResultStreamIn is result Season.SeasonResult  outlet SeasonResultStreamOut is result Season.SeasonResult
  handler LeagueContextBoundary is {
    on recordVenueAvailability: command Season.RecordVenueAvailability is {
      send recordVenueAvailability to outlet LeagueContext.SeasonCommandStreamOut
    }
    on recordBroadcastSlot: command Season.RecordBroadcastSlot is {
      send recordBroadcastSlot to outlet LeagueContext.SeasonCommandStreamOut
    }
    on createSeason: command Season.CreateSeason is {
      send createSeason to outlet LeagueContext.SeasonCommandStreamOut
    }
    on registerTeam: command Season.RegisterTeam is {
      send registerTeam to outlet LeagueContext.SeasonCommandStreamOut
    }
    on scheduleMatch: command Season.ScheduleMatch is {
      send scheduleMatch to outlet LeagueContext.SeasonCommandStreamOut
    }
    on recordResult: command Season.RecordResult is {
      send recordResult to outlet LeagueContext.SeasonCommandStreamOut
    }
    on assignReferee: command Season.AssignReferee is {
      send assignReferee to outlet LeagueContext.SeasonCommandStreamOut
    }
    on reportViolation: command Season.ReportViolation is {
      send reportViolation to outlet LeagueContext.SeasonCommandStreamOut
    }
    on startPlayoffs: command Season.StartPlayoffs is {
      send startPlayoffs to outlet LeagueContext.SeasonCommandStreamOut
    }
    on advanceBracket: command Season.AdvanceBracket is {
      send advanceBracket to outlet LeagueContext.SeasonCommandStreamOut
    }
    on completeSeason: command Season.CompleteSeason is {
      send completeSeason to outlet LeagueContext.SeasonCommandStreamOut
    }
    on cancelSeason: command Season.CancelSeason is {
      send cancelSeason to outlet LeagueContext.SeasonCommandStreamOut
    }
    on seasonResult: result Season.SeasonResult is {
      send seasonResult to outlet LeagueContext.SeasonResultStreamOut
    }
    on other is {
      error "Unexpected message at the LeagueContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'SeasonCommand Stream Intake' is from outlet LeagueContext.SeasonCommandStreamOut to inlet LeagueContext.Season.SeasonCommands  connector 'SeasonResult Stream Egress' is from outlet LeagueContext.LeagueRepository.LeagueRepositoryResponses to inlet LeagueContext.SeasonResultStreamIn  adaptor FromBroadcastSystem from context BroadcastSystem as sink is { 
    inlet FromBroadcastSystemIn is type BroadcastSystem.BroadcastSystemEvent    handler FromBroadcastSystemHandler is {
      on broadcastCancelled: event BroadcastSystem.BroadcastCancelled is {
        do "a cancelled broadcast does not cancel the match it was to cover"
      }
      on broadcastScheduled: event BroadcastSystem.BroadcastScheduled is {
        do "the broadcast is booked; the match was scheduled before it was offered"
      }
      on other is {
        error "Unexpected message for adaptor FromBroadcastSystem"
      }
    } with {
      briefly "from broadcast system"
      described as {
        |Carries messages from the external BroadcastSystem.
      }
    }
  } with {
    briefly "BroadcastSystem integration"
    described as {
      |The model's side of the BroadcastSystem conversation.
    }
  }
  adaptor ToBroadcastSystem to context BroadcastSystem as router is { 
    outlet ToBroadcastSystemToLeagueContext is command Season.RecordBroadcastSlot
    inlet ToBroadcastSystemIn is type SeasonEvent    inlet ToBroadcastSystemReplies is result BroadcastSystem.BroadcastScheduleResult    outlet ToBroadcastSystemOut is type BroadcastSystem.BroadcastSystemCommand
    handler ToBroadcastSystemHandler is {
      on matchScheduled: event Season.MatchScheduled is {
        let askAnswer: type BroadcastSystem.BroadcastScheduleResult = ask query BroadcastSystem.GetBroadcastSchedule of context BroadcastSystem
        do "a scheduled match being what a broadcast slot is sought for"
        send command Season.RecordBroadcastSlot(seasonId = matchScheduled.seasonId, matchId = matchScheduled.matchId, channels = prompt("the channels of this record broadcast slot")) to outlet LeagueContext.ToBroadcastSystem.ToBroadcastSystemToLeagueContext
        let item0: type BroadcastSystem.ScheduleBroadcast = prompt("translate the matchScheduled event into a ScheduleBroadcast, a scheduled match being what there is to televise")
        send item0 to outlet LeagueContext.ToBroadcastSystem.ToBroadcastSystemOut
      }
      on seasonCancelled: event Season.SeasonCancelled is {
        let item0: type BroadcastSystem.CancelBroadcast = prompt("translate the seasonCancelled event into a CancelBroadcast, a cancelled season leaving nothing to televise")
        send item0 to outlet LeagueContext.ToBroadcastSystem.ToBroadcastSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToBroadcastSystem"
      }
    } with {
      briefly "to broadcast system"
      described as {
        |Carries messages to the external BroadcastSystem.
      }
    }
  } with {
    briefly "BroadcastSystem integration"
    described as {
      |The model's side of the BroadcastSystem conversation.
    }
  }
  adaptor FromVenueBooking from context VenueBooking as sink is { 
    inlet FromVenueBookingIn is type VenueBooking.VenueBookingEvent    handler FromVenueBookingHandler is {
      on venueReleased: event VenueBooking.VenueReleased is {
        do "a released venue follows a match that was already cancelled or moved"
      }
      on venueReserved: event VenueBooking.VenueReserved is {
        do "the venue is held for the match already scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromVenueBooking"
      }
    } with {
      briefly "from venue booking"
      described as {
        |Carries messages from the external VenueBooking.
      }
    }
  } with {
    briefly "VenueBooking integration"
    described as {
      |The model's side of the VenueBooking conversation.
    }
  }
  adaptor ToVenueBooking to context VenueBooking as router is { 
    outlet ToVenueBookingToLeagueContext is command Season.RecordVenueAvailability
    inlet ToVenueBookingIn is type SeasonEvent    inlet ToVenueBookingReplies is result VenueBooking.VenueAvailability    outlet ToVenueBookingOut is type VenueBooking.VenueBookingCommand
    handler ToVenueBookingHandler is {
      on matchScheduled: event Season.MatchScheduled is {
        let askAnswer: type VenueBooking.VenueAvailability = ask query VenueBooking.CheckAvailability of context VenueBooking
        do "and what a venue must be free for"
        send command Season.RecordVenueAvailability(seasonId = matchScheduled.seasonId, matchId = matchScheduled.matchId, venueId = prompt("the venue id of this record venue availability"), available = prompt("the available of this record venue availability")) to outlet LeagueContext.ToVenueBooking.ToVenueBookingToLeagueContext
        let claim: type VenueBooking.ReserveVenue = prompt("translate the matchScheduled event into a ReserveVenue holding the ground the fixture needs")
        send claim to outlet LeagueContext.ToVenueBooking.ToVenueBookingOut
      }
      on seasonCancelled: event Season.SeasonCancelled is {
        let release: type VenueBooking.ReleaseVenue = prompt("translate the seasonCancelled event into a ReleaseVenue giving the grounds back, the fixtures having gone")
        send release to outlet LeagueContext.ToVenueBooking.ToVenueBookingOut
      }
      on other is {
        error "Unexpected message for adaptor ToVenueBooking"
      }
    } with {
      briefly "to venue booking"
      described as {
        |Carries messages to the external VenueBooking.
      }
    }
  } with {
    briefly "VenueBooking integration"
    described as {
      |The model's side of the VenueBooking conversation.
    }
  }
  include "types.riddl"
  include "Season.riddl"
  type LeagueRepositoryCommand is one of {
    LeagueContext.LeagueRepository.PersistBracketAdvanced or LeagueContext.LeagueRepository.PersistMatchScheduled or LeagueContext.LeagueRepository.PersistPlayoffsStarted or LeagueContext.LeagueRepository.PersistRefereeAssigned or LeagueContext.LeagueRepository.PersistResultRecorded or LeagueContext.LeagueRepository.PersistSeasonCancelled or LeagueContext.LeagueRepository.PersistSeasonCompleted or LeagueContext.LeagueRepository.PersistSeasonCreated or LeagueContext.LeagueRepository.PersistTeamRegistered or LeagueContext.LeagueRepository.PersistViolationReported
  } with {
    briefly "Anything that writes LeagueRepository"
    described as {
      |The persistence commands LeagueRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository LeagueRepository as flow is {
    inlet LeagueRepositoryFromLeagueMetrics is type LeagueRepositoryCommand    command PersistBracketAdvanced is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row BracketAdvanced applies to.
        }
      }
      bracketId: BracketId? with {
        briefly "Bracket id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newRound: Natural? with {
        briefly "New round"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      advancedAt: TimeStamp? with {
        briefly "Advanced at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist BracketAdvanced"
      described as {
        |Instructs this repository to apply BracketAdvanced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMatchScheduled is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatchScheduled applies to.
        }
      }
      matchId: MatchId? with {
        briefly "Match id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      scheduledAt: TimeStamp? with {
        briefly "Scheduled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MatchScheduled"
      described as {
        |Instructs this repository to apply MatchScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayoffsStarted is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayoffsStarted applies to.
        }
      }
      bracketId: BracketId? with {
        briefly "Bracket id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      teamCount: Natural? with {
        briefly "Team count"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      startedAt: TimeStamp? with {
        briefly "Started at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PlayoffsStarted"
      described as {
        |Instructs this repository to apply PlayoffsStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRefereeAssigned is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row RefereeAssigned applies to.
        }
      }
      refereeId: RefereeId? with {
        briefly "Referee id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      matchId: MatchId? with {
        briefly "Match id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist RefereeAssigned"
      described as {
        |Instructs this repository to apply RefereeAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSeasonCancelled is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row SeasonCancelled applies to.
        }
      }
      reason: String(3,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SeasonCancelled"
      described as {
        |Instructs this repository to apply SeasonCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSeasonCompleted is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row SeasonCompleted applies to.
        }
      }
      championTeamId: TeamId? with {
        briefly "Champion team id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SeasonCompleted"
      described as {
        |Instructs this repository to apply SeasonCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistResultRecorded is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row ResultRecorded applies to.
        }
      }
      matchId: MatchId? with {
        briefly "Match id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      homeScore: Natural? with {
        briefly "Home score"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      awayScore: Natural? with {
        briefly "Away score"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ResultRecorded"
      described as {
        |Instructs this repository to apply ResultRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSeasonCreated is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row SeasonCreated applies to.
        }
      }
      seasonName: String(3,200)? with {
        briefly "Season name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist SeasonCreated"
      described as {
        |Instructs this repository to apply SeasonCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTeamRegistered is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row TeamRegistered applies to.
        }
      }
      teamId: TeamId? with {
        briefly "Team id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      registeredAt: TimeStamp? with {
        briefly "Registered at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TeamRegistered"
      described as {
        |Instructs this repository to apply TeamRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistViolationReported is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row ViolationReported applies to.
        }
      }
      teamId: TeamId? with {
        briefly "Team id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      violationType: RuleViolationType? with {
        briefly "Violation type"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reportedAt: TimeStamp? with {
        briefly "Reported at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ViolationReported"
      described as {
        |Instructs this repository to apply ViolationReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet LeagueRepositoryResponses is result Season.SeasonResult
    record StoredSeason is {
      seasonId: SeasonId with {
        briefly "seasonId"
        described as {
          |The seasonId column of the stored season row.
        }
      }
      seasonName: String(3,200) with {
        briefly "seasonName"
        described as {
          |The seasonName column of the stored season row.
        }
      }
      bracketId: BracketId? with {
        briefly "Bracket id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newRound: Natural? with {
        briefly "New round"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      advancedAt: TimeStamp? with {
        briefly "Advanced at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      matchId: MatchId? with {
        briefly "Match id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      scheduledAt: TimeStamp? with {
        briefly "Scheduled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      teamCount: Natural? with {
        briefly "Team count"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      startedAt: TimeStamp? with {
        briefly "Started at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      refereeId: RefereeId? with {
        briefly "Referee id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(3,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      championTeamId: TeamId? with {
        briefly "Champion team id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      homeScore: Natural? with {
        briefly "Home score"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      awayScore: Natural? with {
        briefly "Away score"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      recordedAt: TimeStamp? with {
        briefly "Recorded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      teamId: TeamId? with {
        briefly "Team id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      registeredAt: TimeStamp? with {
        briefly "Registered at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      violationType: RuleViolationType? with {
        briefly "Violation type"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reportedAt: TimeStamp? with {
        briefly "Reported at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored season row"
      described as {
        |The persistence shape of season data as this repository stores it.
      }
    }
    schema LeagueData is relational
      of seasons as record StoredSeason
        key on field StoredSeason.seasonId
        index on field StoredSeason.status
        index on field StoredSeason.seasonName
 with {
      briefly "League data schema"
      described as {
        |The relational schema holding league data for the LeagueRepository.
      }
    }
    handler LeaguePersistence is {
      on persistBracketAdvanced: command PersistBracketAdvanced is {
        update LeagueData.seasons set bracketId = persistBracketAdvanced.bracketId, newRound = persistBracketAdvanced.newRound, advancedAt = persistBracketAdvanced.advancedAt where seasonId == persistBracketAdvanced.seasonId
      }
      on persistMatchScheduled: command PersistMatchScheduled is {
        update LeagueData.seasons set matchId = persistMatchScheduled.matchId, scheduledAt = persistMatchScheduled.scheduledAt where seasonId == persistMatchScheduled.seasonId
      }
      on persistPlayoffsStarted: command PersistPlayoffsStarted is {
        update LeagueData.seasons set bracketId = persistPlayoffsStarted.bracketId, teamCount = persistPlayoffsStarted.teamCount, startedAt = persistPlayoffsStarted.startedAt where seasonId == persistPlayoffsStarted.seasonId
      }
      on persistRefereeAssigned: command PersistRefereeAssigned is {
        update LeagueData.seasons set refereeId = persistRefereeAssigned.refereeId, matchId = persistRefereeAssigned.matchId, assignedAt = persistRefereeAssigned.assignedAt where seasonId == persistRefereeAssigned.seasonId
      }
      on persistSeasonCancelled: command PersistSeasonCancelled is {
        update LeagueData.seasons set reason = persistSeasonCancelled.reason, cancelledAt = persistSeasonCancelled.cancelledAt where seasonId == persistSeasonCancelled.seasonId
      }
      on persistSeasonCompleted: command PersistSeasonCompleted is {
        update LeagueData.seasons set championTeamId = persistSeasonCompleted.championTeamId, completedAt = persistSeasonCompleted.completedAt where seasonId == persistSeasonCompleted.seasonId
      }
      on persistResultRecorded: command PersistResultRecorded is {
        update LeagueData.seasons set matchId = persistResultRecorded.matchId, homeScore = persistResultRecorded.homeScore, awayScore = persistResultRecorded.awayScore, recordedAt = persistResultRecorded.recordedAt where seasonId == persistResultRecorded.seasonId
      }
      on persistSeasonCreated: command PersistSeasonCreated is {
        update LeagueData.seasons set seasonName = persistSeasonCreated.seasonName, createdAt = persistSeasonCreated.createdAt where seasonId == persistSeasonCreated.seasonId
      }
      on persistTeamRegistered: command PersistTeamRegistered is {
        update LeagueData.seasons set teamId = persistTeamRegistered.teamId, registeredAt = persistTeamRegistered.registeredAt where seasonId == persistTeamRegistered.seasonId
      }
      on persistViolationReported: command PersistViolationReported is {
        update LeagueData.seasons set teamId = persistViolationReported.teamId, violationType = persistViolationReported.violationType, reportedAt = persistViolationReported.reportedAt where seasonId == persistViolationReported.seasonId
      }
      on query GetStandingsMetrics is {
        let standingsMetricsView: type StandingsMetricsView = prompt("read the standings metrics projection")
        reply standingsMetricsView
      }
    } with {
      briefly "Persists league commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "League data persistence"
    described as {
      |Persistent storage for league data.
    }
  }
  query GetStandingsMetrics replies result StandingsMetricsView is {
    standingsMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which standings metrics to retrieve.
      }
    }
  } with {
    briefly "Get standings metrics"
    described as {
      |Retrieves the standings metrics projection.
    }
  }
  result StandingsMetricsView is {
    standingsMetrics: LeagueMetrics.StandingsMetrics with {
      briefly "Standings metrics"
      described as {
        |The standings metrics being returned.
      }
    }
  } with {
    briefly "Standings metrics view"
    described as {
      |Read model view carrying the standings metrics projection.
    }
  }
  projector LeagueMetrics as flow is {
    updates repository LeagueContext.LeagueRepository
    outlet LeagueMetricsToRepository is type LeagueRepositoryCommand
    inlet LeagueMetricsFromSeason is type SeasonEvent    record StandingsMetrics is {
      totalSeasons: Natural with {
        briefly "Seasons"
        described as {
          |Total seasons.
        }
      }
      totalMatches: Natural with {
        briefly "Matches"
        described as {
          |Total matches played.
        }
      }
      totalTeams: Natural with {
        briefly "Teams"
        described as {
          |Total registered teams.
        }
      }
      totalViolations: Natural with {
        briefly "Violations"
        described as {
          |Total violations reported.
        }
      }
      averageGoalsPerMatch: Decimal(8,2) with {
        briefly "Avg goals"
        described as {
          |Average goals per match.
        }
      }
    } with {
      briefly "Standings metrics"
      described as {
        |League-wide statistics.
      }
    }
    handler MetricsHandler is {
      on bracketAdvanced: event Season.BracketAdvanced is {
        tell command LeagueContext.LeagueRepository.PersistBracketAdvanced(seasonId = bracketAdvanced.seasonId, bracketId = bracketAdvanced.bracketId, newRound = bracketAdvanced.newRound, advancedAt = bracketAdvanced.advancedAt) to repository LeagueContext.LeagueRepository
        do "apply BracketAdvanced to the LeagueMetrics projection"
      }
      on matchScheduled: event Season.MatchScheduled is {
        tell command LeagueContext.LeagueRepository.PersistMatchScheduled(seasonId = matchScheduled.seasonId, matchId = matchScheduled.matchId, scheduledAt = matchScheduled.scheduledAt) to repository LeagueContext.LeagueRepository
        do "apply MatchScheduled to the LeagueMetrics projection"
      }
      on playoffsStarted: event Season.PlayoffsStarted is {
        tell command LeagueContext.LeagueRepository.PersistPlayoffsStarted(seasonId = playoffsStarted.seasonId, bracketId = playoffsStarted.bracketId, teamCount = playoffsStarted.teamCount, startedAt = playoffsStarted.startedAt) to repository LeagueContext.LeagueRepository
        do "apply PlayoffsStarted to the LeagueMetrics projection"
      }
      on refereeAssigned: event Season.RefereeAssigned is {
        tell command LeagueContext.LeagueRepository.PersistRefereeAssigned(seasonId = refereeAssigned.seasonId, refereeId = refereeAssigned.refereeId, matchId = refereeAssigned.matchId, assignedAt = refereeAssigned.assignedAt) to repository LeagueContext.LeagueRepository
        do "apply RefereeAssigned to the LeagueMetrics projection"
      }
      on seasonCancelled: event Season.SeasonCancelled is {
        tell command LeagueContext.LeagueRepository.PersistSeasonCancelled(seasonId = seasonCancelled.seasonId, reason = seasonCancelled.reason, cancelledAt = seasonCancelled.cancelledAt) to repository LeagueContext.LeagueRepository
        do "apply SeasonCancelled to the LeagueMetrics projection"
      }
      on seasonCompleted: event Season.SeasonCompleted is {
        tell command LeagueContext.LeagueRepository.PersistSeasonCompleted(seasonId = seasonCompleted.seasonId, championTeamId = seasonCompleted.championTeamId, completedAt = seasonCompleted.completedAt) to repository LeagueContext.LeagueRepository
        do "apply SeasonCompleted to the LeagueMetrics projection"
      }
      on seasonCreated: event Season.SeasonCreated is {
        tell command LeagueContext.LeagueRepository.PersistSeasonCreated(seasonId = seasonCreated.seasonId, seasonName = seasonCreated.seasonName, createdAt = seasonCreated.createdAt) to repository LeagueContext.LeagueRepository
        do "Increment total seasons"
      }
      on teamRegistered: event Season.TeamRegistered is {
        tell command LeagueContext.LeagueRepository.PersistTeamRegistered(seasonId = teamRegistered.seasonId, teamId = teamRegistered.teamId, registeredAt = teamRegistered.registeredAt) to repository LeagueContext.LeagueRepository
        do "Increment total teams"
      }
      on resultRecorded: event Season.ResultRecorded is {
        tell command LeagueContext.LeagueRepository.PersistResultRecorded(seasonId = resultRecorded.seasonId, matchId = resultRecorded.matchId, homeScore = resultRecorded.homeScore, awayScore = resultRecorded.awayScore, recordedAt = resultRecorded.recordedAt) to repository LeagueContext.LeagueRepository
        do "Increment matches and update average goals"
      }
      on violationReported: event Season.ViolationReported is {
        tell command LeagueContext.LeagueRepository.PersistViolationReported(seasonId = violationReported.seasonId, teamId = violationReported.teamId, violationType = violationReported.violationType, reportedAt = violationReported.reportedAt) to repository LeagueContext.LeagueRepository
        do "Increment total violations"
      }
      on broadcastSlotRecorded: event Season.BroadcastSlotRecorded is {
        do "a broadcast slot recorded changes nothing this projector keeps"
      }
      on venueAvailabilityRecorded: event Season.VenueAvailabilityRecorded is {
        do "a venue availability recorded changes nothing this projector keeps"
      }
    } with {
      briefly "Maintains league metrics"
      described as {
        |Projects events into league statistics.
      }
    }
  } with {
    briefly "League metrics"
    described as {
      |League-wide analytics and statistics.
    }
  }
  // ---- Event publication for Season ----
  type SeasonEvent is one of {
    LeagueContext.Season.SeasonCreated or LeagueContext.Season.TeamRegistered or LeagueContext.Season.MatchScheduled or LeagueContext.Season.ResultRecorded or LeagueContext.Season.RefereeAssigned or LeagueContext.Season.ViolationReported or LeagueContext.Season.PlayoffsStarted or LeagueContext.Season.BracketAdvanced or LeagueContext.Season.SeasonCompleted or LeagueContext.Season.SeasonCancelled or LeagueContext.Season.VenueAvailabilityRecorded or LeagueContext.Season.BroadcastSlotRecorded
  } with {
    briefly "Season event alternation"
    described as {
      |Union of all Season events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet SeasonEventSplit as split is {
    outlet SeasonEventSplitToToVenueBooking is type SeasonEvent
    outlet SeasonEventSplitToToBroadcastSystem is type SeasonEvent
    inlet SeasonEventSplitIn is type SeasonEvent    outlet SeasonEventSplitToLeagueMetrics is type SeasonEvent
    handler SeasonEventSplitHandler is {
      on seasonCreated: event Season.SeasonCreated is {
        send seasonCreated to outlet SeasonEventSplitToLeagueMetrics
        tell seasonCreated to entity LeagueContext.Season
      }
      on teamRegistered: event Season.TeamRegistered is {
        send teamRegistered to outlet SeasonEventSplitToLeagueMetrics
        tell teamRegistered to entity LeagueContext.Season
      }
      on matchScheduled: event Season.MatchScheduled is {
        send matchScheduled to outlet SeasonEventSplitToLeagueMetrics
        send matchScheduled to outlet SeasonEventSplitToToVenueBooking
        send matchScheduled to outlet SeasonEventSplitToToBroadcastSystem
        tell matchScheduled to entity LeagueContext.Season
      }
      on resultRecorded: event Season.ResultRecorded is {
        send resultRecorded to outlet SeasonEventSplitToLeagueMetrics
        tell resultRecorded to entity LeagueContext.Season
      }
      on refereeAssigned: event Season.RefereeAssigned is {
        send refereeAssigned to outlet SeasonEventSplitToLeagueMetrics
        tell refereeAssigned to entity LeagueContext.Season
      }
      on violationReported: event Season.ViolationReported is {
        send violationReported to outlet SeasonEventSplitToLeagueMetrics
        tell violationReported to entity LeagueContext.Season
      }
      on playoffsStarted: event Season.PlayoffsStarted is {
        send playoffsStarted to outlet SeasonEventSplitToLeagueMetrics
        tell playoffsStarted to entity LeagueContext.Season
      }
      on bracketAdvanced: event Season.BracketAdvanced is {
        send bracketAdvanced to outlet SeasonEventSplitToLeagueMetrics
        tell bracketAdvanced to entity LeagueContext.Season
      }
      on seasonCompleted: event Season.SeasonCompleted is {
        send seasonCompleted to outlet SeasonEventSplitToLeagueMetrics
        tell seasonCompleted to entity LeagueContext.Season
      }
      on seasonCancelled: event Season.SeasonCancelled is {
        send seasonCancelled to outlet SeasonEventSplitToLeagueMetrics
        send seasonCancelled to outlet SeasonEventSplitToToVenueBooking
        send seasonCancelled to outlet SeasonEventSplitToToBroadcastSystem
        tell seasonCancelled to entity LeagueContext.Season
      }
      on venueAvailabilityRecorded: event Season.VenueAvailabilityRecorded is {
        send venueAvailabilityRecorded to outlet SeasonEventSplitToLeagueMetrics
        send venueAvailabilityRecorded to outlet SeasonEventSplitToToVenueBooking
        send venueAvailabilityRecorded to outlet SeasonEventSplitToToBroadcastSystem
        tell venueAvailabilityRecorded to entity LeagueContext.Season
      }
      on broadcastSlotRecorded: event Season.BroadcastSlotRecorded is {
        send broadcastSlotRecorded to outlet SeasonEventSplitToLeagueMetrics
        send broadcastSlotRecorded to outlet SeasonEventSplitToToVenueBooking
        send broadcastSlotRecorded to outlet SeasonEventSplitToToBroadcastSystem
        tell broadcastSlotRecorded to entity LeagueContext.Season
      }
      on other is {
        error "Unexpected message for processor SeasonEventSplit"
      }
    } with {
      briefly "Season event fan-out handler"
      described as {
        |Delivers each Season event to all of its consumers.
      }
    }
  } with {
    briefly "Season event fan-out"
    described as {
      |Fans Season events out to the repository and projectors.
    }
  }
  connector 'ToVenueBooking Feed' is from outlet LeagueContext.SeasonEventSplit.SeasonEventSplitToToVenueBooking to inlet LeagueContext.ToVenueBooking.ToVenueBookingIn with {
    briefly "The Season events ToVenueBooking translates, on their way to it"
  }
  connector 'ToBroadcastSystem Feed' is from outlet LeagueContext.SeasonEventSplit.SeasonEventSplitToToBroadcastSystem to inlet LeagueContext.ToBroadcastSystem.ToBroadcastSystemIn with {
    briefly "The Season events ToBroadcastSystem translates, on their way to it"
  }
  connector 'SeasonEvent Stream' is from outlet LeagueContext.Season.SeasonEvents2 to inlet LeagueContext.SeasonEventSplit.SeasonEventSplitIn with {
    briefly "Season events, fanned out to storage and read models"
  }
  connector 'LeagueMetrics Feed' is from outlet LeagueContext.SeasonEventSplit.SeasonEventSplitToLeagueMetrics to inlet LeagueContext.LeagueMetrics.LeagueMetricsFromSeason with {
    briefly "Season events feeding the LeagueMetrics projection"
  }
  connector 'LeagueMetrics Storage' is from outlet LeagueContext.LeagueMetrics.LeagueMetricsToRepository to inlet LeagueContext.LeagueRepository.LeagueRepositoryFromLeagueMetrics with {
    briefly "LeagueMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for league management"
  described as {
    |Sports league management context.
  }
}
