// League Management - League Context
context LeagueContext as router is {
  inlet SeasonCommandStreamIn is type SeasonCommand  outlet SeasonCommandStreamOut is type SeasonCommand
  inlet SeasonResultStreamIn is result Season.SeasonResult  outlet SeasonResultStreamOut is result Season.SeasonResult
  handler LeagueContextBoundary is {
    on createSeason: command Season.CreateSeason is {
      send createSeason to outlet LeagueContext.SeasonCommandStreamOut
    }
    on registerTeam: command Season.RegisterTeam is {
      send registerTeam to outlet LeagueContext.SeasonCommandStreamOut
    }
    on scheduleMatch: command Season.ScheduleMatch is {
      send scheduleMatch to outlet LeagueContext.SeasonCommandStreamOut
    }
    on recordResult: command Season.RecordResult is {
      send recordResult to outlet LeagueContext.SeasonCommandStreamOut
    }
    on assignReferee: command Season.AssignReferee is {
      send assignReferee to outlet LeagueContext.SeasonCommandStreamOut
    }
    on reportViolation: command Season.ReportViolation is {
      send reportViolation to outlet LeagueContext.SeasonCommandStreamOut
    }
    on startPlayoffs: command Season.StartPlayoffs is {
      send startPlayoffs to outlet LeagueContext.SeasonCommandStreamOut
    }
    on advanceBracket: command Season.AdvanceBracket is {
      send advanceBracket to outlet LeagueContext.SeasonCommandStreamOut
    }
    on completeSeason: command Season.CompleteSeason is {
      send completeSeason to outlet LeagueContext.SeasonCommandStreamOut
    }
    on cancelSeason: command Season.CancelSeason is {
      send cancelSeason to outlet LeagueContext.SeasonCommandStreamOut
    }
    on seasonResult: result Season.SeasonResult is {
      send seasonResult to outlet LeagueContext.SeasonResultStreamOut
    }
    on other is {
      error "Unexpected message at the LeagueContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'SeasonCommand Stream Intake' is from outlet LeagueContext.SeasonCommandStreamOut to inlet LeagueContext.Season.SeasonCommands  connector 'SeasonResult Stream Egress' is from outlet LeagueContext.LeagueRepository.LeagueRepositoryResponses to inlet LeagueContext.SeasonResultStreamIn  adaptor FromBroadcastSystem from context BroadcastSystem is { 
    handler FromBroadcastSystemHandler is {
      on event BroadcastSystem.BroadcastCancelled is {
        do "the model receives broadcast cancelled"
      }
      on result BroadcastSystem.BroadcastScheduleResult is {
        do "the model receives broadcast schedule result"
      }
      on event BroadcastSystem.BroadcastScheduled is {
        do "the model receives broadcast scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromBroadcastSystem"
      }
    } with {
      briefly "from broadcast system"
      described as {
        |Carries messages from the external BroadcastSystem.
      }
    }
  } with {
    briefly "BroadcastSystem integration"
    described as {
      |The model's side of the BroadcastSystem conversation.
    }
  }
  adaptor ToBroadcastSystem to context BroadcastSystem is { 
    handler ToBroadcastSystemHandler is {
      on command BroadcastSystem.CancelBroadcast is {
        do "the model sends cancel broadcast"
      }
      on query BroadcastSystem.GetBroadcastSchedule is {
        do "the model sends get broadcast schedule"
      }
      on command BroadcastSystem.ScheduleBroadcast is {
        do "the model sends schedule broadcast"
      }
      on other is {
        error "Unexpected message for adaptor ToBroadcastSystem"
      }
    } with {
      briefly "to broadcast system"
      described as {
        |Carries messages to the external BroadcastSystem.
      }
    }
  } with {
    briefly "BroadcastSystem integration"
    described as {
      |The model's side of the BroadcastSystem conversation.
    }
  }
  adaptor FromVenueBooking from context VenueBooking is { 
    handler FromVenueBookingHandler is {
      on result VenueBooking.VenueAvailability is {
        do "the model receives venue availability"
      }
      on event VenueBooking.VenueReleased is {
        do "the model receives venue released"
      }
      on event VenueBooking.VenueReserved is {
        do "the model receives venue reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromVenueBooking"
      }
    } with {
      briefly "from venue booking"
      described as {
        |Carries messages from the external VenueBooking.
      }
    }
  } with {
    briefly "VenueBooking integration"
    described as {
      |The model's side of the VenueBooking conversation.
    }
  }
  adaptor ToVenueBooking to context VenueBooking is { 
    handler ToVenueBookingHandler is {
      on query VenueBooking.CheckAvailability is {
        do "the model sends check availability"
      }
      on command VenueBooking.ReleaseVenue is {
        do "the model sends release venue"
      }
      on command VenueBooking.ReserveVenue is {
        do "the model sends reserve venue"
      }
      on other is {
        error "Unexpected message for adaptor ToVenueBooking"
      }
    } with {
      briefly "to venue booking"
      described as {
        |Carries messages to the external VenueBooking.
      }
    }
  } with {
    briefly "VenueBooking integration"
    described as {
      |The model's side of the VenueBooking conversation.
    }
  }
  include "types.riddl"
  include "Season.riddl"
  type LeagueRepositoryCommand is one of {
    LeagueContext.LeagueRepository.PersistBracketAdvanced or LeagueContext.LeagueRepository.PersistMatchScheduled or LeagueContext.LeagueRepository.PersistPlayoffsStarted or LeagueContext.LeagueRepository.PersistRefereeAssigned or LeagueContext.LeagueRepository.PersistResultRecorded or LeagueContext.LeagueRepository.PersistSeasonCancelled or LeagueContext.LeagueRepository.PersistSeasonCompleted or LeagueContext.LeagueRepository.PersistSeasonCreated or LeagueContext.LeagueRepository.PersistTeamRegistered or LeagueContext.LeagueRepository.PersistViolationReported
  } with {
    briefly "Anything that writes LeagueRepository"
    described as {
      |The persistence commands LeagueRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository LeagueRepository as flow is {
    inlet LeagueRepositoryFromLeagueMetrics is type LeagueRepositoryCommand    command PersistBracketAdvanced is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row BracketAdvanced applies to.
        }
      }
    } with {
      briefly "Persist BracketAdvanced"
      described as {
        |Instructs this repository to apply BracketAdvanced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMatchScheduled is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatchScheduled applies to.
        }
      }
    } with {
      briefly "Persist MatchScheduled"
      described as {
        |Instructs this repository to apply MatchScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayoffsStarted is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayoffsStarted applies to.
        }
      }
    } with {
      briefly "Persist PlayoffsStarted"
      described as {
        |Instructs this repository to apply PlayoffsStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRefereeAssigned is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row RefereeAssigned applies to.
        }
      }
    } with {
      briefly "Persist RefereeAssigned"
      described as {
        |Instructs this repository to apply RefereeAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSeasonCancelled is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row SeasonCancelled applies to.
        }
      }
    } with {
      briefly "Persist SeasonCancelled"
      described as {
        |Instructs this repository to apply SeasonCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSeasonCompleted is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row SeasonCompleted applies to.
        }
      }
    } with {
      briefly "Persist SeasonCompleted"
      described as {
        |Instructs this repository to apply SeasonCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistResultRecorded is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row ResultRecorded applies to.
        }
      }
    } with {
      briefly "Persist ResultRecorded"
      described as {
        |Instructs this repository to apply ResultRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSeasonCreated is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row SeasonCreated applies to.
        }
      }
    } with {
      briefly "Persist SeasonCreated"
      described as {
        |Instructs this repository to apply SeasonCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTeamRegistered is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row TeamRegistered applies to.
        }
      }
    } with {
      briefly "Persist TeamRegistered"
      described as {
        |Instructs this repository to apply TeamRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistViolationReported is {
      seasonId: SeasonId with {
        briefly "Row addressed"
        described as {
          |Which stored row ViolationReported applies to.
        }
      }
    } with {
      briefly "Persist ViolationReported"
      described as {
        |Instructs this repository to apply ViolationReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet LeagueRepositoryResponses is result Season.SeasonResult
    record StoredSeason is {
      seasonId: SeasonId with {
        briefly "seasonId"
        described as {
          |The seasonId column of the stored season row.
        }
      }
      seasonName: String(3,200) with {
        briefly "seasonName"
        described as {
          |The seasonName column of the stored season row.
        }
      }
    } with {
      briefly "Stored season row"
      described as {
        |The persistence shape of season data as this repository stores it.
      }
    }
    schema LeagueData is relational
      of seasons as record StoredSeason
        index on field StoredSeason.seasonId
        index on field StoredSeason.status
        index on field StoredSeason.seasonName
 with {
      briefly "League data schema"
      described as {
        |The relational schema holding league data for the LeagueRepository.
      }
    }
    handler LeaguePersistence is {
      on persistBracketAdvanced: command PersistBracketAdvanced is {
        do "apply BracketAdvanced to the stored row"
      }
      on persistMatchScheduled: command PersistMatchScheduled is {
        do "apply MatchScheduled to the stored row"
      }
      on persistPlayoffsStarted: command PersistPlayoffsStarted is {
        do "apply PlayoffsStarted to the stored row"
      }
      on persistRefereeAssigned: command PersistRefereeAssigned is {
        do "apply RefereeAssigned to the stored row"
      }
      on persistSeasonCancelled: command PersistSeasonCancelled is {
        do "apply SeasonCancelled to the stored row"
      }
      on persistSeasonCompleted: command PersistSeasonCompleted is {
        do "apply SeasonCompleted to the stored row"
      }
      on persistResultRecorded: command PersistResultRecorded is {
        do "apply ResultRecorded to the stored row"
      }
      on persistSeasonCreated: command PersistSeasonCreated is {
        do "apply SeasonCreated to the stored row"
      }
      on persistTeamRegistered: command PersistTeamRegistered is {
        do "apply TeamRegistered to the stored row"
      }
      on persistViolationReported: command PersistViolationReported is {
        do "apply ViolationReported to the stored row"
      }
      on query GetStandingsMetrics is {
        let standingsMetricsView: type StandingsMetricsView = prompt("read the standings metrics projection")
        reply standingsMetricsView
      }
    } with {
      briefly "Persists league commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "League data persistence"
    described as {
      |Persistent storage for league data.
    }
  }
  query GetStandingsMetrics replies result StandingsMetricsView is {
    standingsMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which standings metrics to retrieve.
      }
    }
  } with {
    briefly "Get standings metrics"
    described as {
      |Retrieves the standings metrics projection.
    }
  }
  result StandingsMetricsView is {
    standingsMetrics: LeagueMetrics.StandingsMetrics with {
      briefly "Standings metrics"
      described as {
        |The standings metrics being returned.
      }
    }
  } with {
    briefly "Standings metrics view"
    described as {
      |Read model view carrying the standings metrics projection.
    }
  }
  projector LeagueMetrics as flow is {
    updates repository LeagueContext.LeagueRepository
    outlet LeagueMetricsToRepository is type LeagueRepositoryCommand
    inlet LeagueMetricsFromSeason is type SeasonEvent    record StandingsMetrics is {
      totalSeasons: Natural with {
        briefly "Seasons"
        described as {
          |Total seasons.
        }
      }
      totalMatches: Natural with {
        briefly "Matches"
        described as {
          |Total matches played.
        }
      }
      totalTeams: Natural with {
        briefly "Teams"
        described as {
          |Total registered teams.
        }
      }
      totalViolations: Natural with {
        briefly "Violations"
        described as {
          |Total violations reported.
        }
      }
      averageGoalsPerMatch: Decimal(8,2) with {
        briefly "Avg goals"
        described as {
          |Average goals per match.
        }
      }
    } with {
      briefly "Standings metrics"
      described as {
        |League-wide statistics.
      }
    }
    handler MetricsHandler is {
      on bracketAdvanced: event Season.BracketAdvanced is {
        tell command LeagueContext.LeagueRepository.PersistBracketAdvanced(seasonId = bracketAdvanced.seasonId) to repository LeagueContext.LeagueRepository
        do "apply BracketAdvanced to the LeagueMetrics projection"
      }
      on matchScheduled: event Season.MatchScheduled is {
        tell command LeagueContext.LeagueRepository.PersistMatchScheduled(seasonId = matchScheduled.seasonId) to repository LeagueContext.LeagueRepository
        do "apply MatchScheduled to the LeagueMetrics projection"
      }
      on playoffsStarted: event Season.PlayoffsStarted is {
        tell command LeagueContext.LeagueRepository.PersistPlayoffsStarted(seasonId = playoffsStarted.seasonId) to repository LeagueContext.LeagueRepository
        do "apply PlayoffsStarted to the LeagueMetrics projection"
      }
      on refereeAssigned: event Season.RefereeAssigned is {
        tell command LeagueContext.LeagueRepository.PersistRefereeAssigned(seasonId = refereeAssigned.seasonId) to repository LeagueContext.LeagueRepository
        do "apply RefereeAssigned to the LeagueMetrics projection"
      }
      on seasonCancelled: event Season.SeasonCancelled is {
        tell command LeagueContext.LeagueRepository.PersistSeasonCancelled(seasonId = seasonCancelled.seasonId) to repository LeagueContext.LeagueRepository
        do "apply SeasonCancelled to the LeagueMetrics projection"
      }
      on seasonCompleted: event Season.SeasonCompleted is {
        tell command LeagueContext.LeagueRepository.PersistSeasonCompleted(seasonId = seasonCompleted.seasonId) to repository LeagueContext.LeagueRepository
        do "apply SeasonCompleted to the LeagueMetrics projection"
      }
      on seasonCreated: event Season.SeasonCreated is {
        tell command LeagueContext.LeagueRepository.PersistSeasonCreated(seasonId = seasonCreated.seasonId) to repository LeagueContext.LeagueRepository
        do "Increment total seasons"
      }
      on teamRegistered: event Season.TeamRegistered is {
        tell command LeagueContext.LeagueRepository.PersistTeamRegistered(seasonId = teamRegistered.seasonId) to repository LeagueContext.LeagueRepository
        do "Increment total teams"
      }
      on resultRecorded: event Season.ResultRecorded is {
        tell command LeagueContext.LeagueRepository.PersistResultRecorded(seasonId = resultRecorded.seasonId) to repository LeagueContext.LeagueRepository
        do "Increment matches and update average goals"
      }
      on violationReported: event Season.ViolationReported is {
        tell command LeagueContext.LeagueRepository.PersistViolationReported(seasonId = violationReported.seasonId) to repository LeagueContext.LeagueRepository
        do "Increment total violations"
      }
    } with {
      briefly "Maintains league metrics"
      described as {
        |Projects events into league statistics.
      }
    }
  } with {
    briefly "League metrics"
    described as {
      |League-wide analytics and statistics.
    }
  }
  // ---- Event publication for Season ----
  type SeasonEvent is one of {
    LeagueContext.Season.SeasonCreated or LeagueContext.Season.TeamRegistered or LeagueContext.Season.MatchScheduled or LeagueContext.Season.ResultRecorded or LeagueContext.Season.RefereeAssigned or LeagueContext.Season.ViolationReported or LeagueContext.Season.PlayoffsStarted or LeagueContext.Season.BracketAdvanced or LeagueContext.Season.SeasonCompleted or LeagueContext.Season.SeasonCancelled
  } with {
    briefly "Season event alternation"
    described as {
      |Union of all Season events, for streaming and event-sourced
      |persistence.
    }
  }
  processor SeasonEventSplit as flow is {
    inlet SeasonEventSplitIn is type SeasonEvent    outlet SeasonEventSplitToLeagueMetrics is type SeasonEvent
    handler SeasonEventSplitHandler is {
      on seasonCreated: event Season.SeasonCreated is {
        send seasonCreated to outlet SeasonEventSplitToLeagueMetrics
        tell seasonCreated to entity LeagueContext.Season
      }
      on teamRegistered: event Season.TeamRegistered is {
        send teamRegistered to outlet SeasonEventSplitToLeagueMetrics
        tell teamRegistered to entity LeagueContext.Season
      }
      on matchScheduled: event Season.MatchScheduled is {
        send matchScheduled to outlet SeasonEventSplitToLeagueMetrics
        tell matchScheduled to entity LeagueContext.Season
      }
      on resultRecorded: event Season.ResultRecorded is {
        send resultRecorded to outlet SeasonEventSplitToLeagueMetrics
        tell resultRecorded to entity LeagueContext.Season
      }
      on refereeAssigned: event Season.RefereeAssigned is {
        send refereeAssigned to outlet SeasonEventSplitToLeagueMetrics
        tell refereeAssigned to entity LeagueContext.Season
      }
      on violationReported: event Season.ViolationReported is {
        send violationReported to outlet SeasonEventSplitToLeagueMetrics
        tell violationReported to entity LeagueContext.Season
      }
      on playoffsStarted: event Season.PlayoffsStarted is {
        send playoffsStarted to outlet SeasonEventSplitToLeagueMetrics
        tell playoffsStarted to entity LeagueContext.Season
      }
      on bracketAdvanced: event Season.BracketAdvanced is {
        send bracketAdvanced to outlet SeasonEventSplitToLeagueMetrics
        tell bracketAdvanced to entity LeagueContext.Season
      }
      on seasonCompleted: event Season.SeasonCompleted is {
        send seasonCompleted to outlet SeasonEventSplitToLeagueMetrics
        tell seasonCompleted to entity LeagueContext.Season
      }
      on seasonCancelled: event Season.SeasonCancelled is {
        send seasonCancelled to outlet SeasonEventSplitToLeagueMetrics
        tell seasonCancelled to entity LeagueContext.Season
      }
      on other is {
        error "Unexpected message for processor SeasonEventSplit"
      }
    } with {
      briefly "Season event fan-out handler"
      described as {
        |Delivers each Season event to all of its consumers.
      }
    }
  } with {
    briefly "Season event fan-out"
    described as {
      |Fans Season events out to the repository and projectors.
    }
  }
  connector 'SeasonEvent Stream' is from outlet LeagueContext.Season.SeasonEvents2 to inlet LeagueContext.SeasonEventSplit.SeasonEventSplitIn with {
    briefly "Season events, fanned out to storage and read models"
  }
  connector 'LeagueMetrics Feed' is from outlet LeagueContext.SeasonEventSplit.SeasonEventSplitToLeagueMetrics to inlet LeagueContext.LeagueMetrics.LeagueMetricsFromSeason with {
    briefly "Season events feeding the LeagueMetrics projection"
  }
  connector 'LeagueMetrics Storage' is from outlet LeagueContext.LeagueMetrics.LeagueMetricsToRepository to inlet LeagueContext.LeagueRepository.LeagueRepositoryFromLeagueMetrics with {
    briefly "LeagueMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for league management"
  described as {
    |Sports league management context.
  }
}
