// League Management - League Context
context LeagueContext is {
  adaptor FromBroadcastSystem from context BroadcastSystem is { 
    handler FromBroadcastSystemHandler is {
      on event BroadcastSystem.BroadcastCancelled is {
        do "the model receives broadcast cancelled"
      }
      on result BroadcastSystem.BroadcastScheduleResult is {
        do "the model receives broadcast schedule result"
      }
      on event BroadcastSystem.BroadcastScheduled is {
        do "the model receives broadcast scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromBroadcastSystem"
      }
    } with {
      briefly "from broadcast system"
      described as {
        |Carries messages from the external BroadcastSystem.
      }
    }
  } with {
    briefly "BroadcastSystem integration"
    described as {
      |The model's side of the BroadcastSystem conversation.
    }
  }
  adaptor ToBroadcastSystem to context BroadcastSystem is { 
    handler ToBroadcastSystemHandler is {
      on command BroadcastSystem.CancelBroadcast is {
        do "the model sends cancel broadcast"
      }
      on query BroadcastSystem.GetBroadcastSchedule is {
        do "the model sends get broadcast schedule"
      }
      on command BroadcastSystem.ScheduleBroadcast is {
        do "the model sends schedule broadcast"
      }
      on other is {
        error "Unexpected message for adaptor ToBroadcastSystem"
      }
    } with {
      briefly "to broadcast system"
      described as {
        |Carries messages to the external BroadcastSystem.
      }
    }
  } with {
    briefly "BroadcastSystem integration"
    described as {
      |The model's side of the BroadcastSystem conversation.
    }
  }
  adaptor FromVenueBooking from context VenueBooking is { 
    handler FromVenueBookingHandler is {
      on result VenueBooking.VenueAvailability is {
        do "the model receives venue availability"
      }
      on event VenueBooking.VenueReleased is {
        do "the model receives venue released"
      }
      on event VenueBooking.VenueReserved is {
        do "the model receives venue reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromVenueBooking"
      }
    } with {
      briefly "from venue booking"
      described as {
        |Carries messages from the external VenueBooking.
      }
    }
  } with {
    briefly "VenueBooking integration"
    described as {
      |The model's side of the VenueBooking conversation.
    }
  }
  adaptor ToVenueBooking to context VenueBooking is { 
    handler ToVenueBookingHandler is {
      on query VenueBooking.CheckAvailability is {
        do "the model sends check availability"
      }
      on command VenueBooking.ReleaseVenue is {
        do "the model sends release venue"
      }
      on command VenueBooking.ReserveVenue is {
        do "the model sends reserve venue"
      }
      on other is {
        error "Unexpected message for adaptor ToVenueBooking"
      }
    } with {
      briefly "to venue booking"
      described as {
        |Carries messages to the external VenueBooking.
      }
    }
  } with {
    briefly "VenueBooking integration"
    described as {
      |The model's side of the VenueBooking conversation.
    }
  }
  include "types.riddl"
  include "Season.riddl"
  repository LeagueRepository is {
    inlet LeagueRepositoryFromSeason is type SeasonEvent    inlet LeagueRepositoryFromLeagueMetrics is type SeasonEvent    outlet LeagueRepositoryResponses is type Season.SeasonResult
    record StoredSeason is  {
      seasonId: SeasonId with {
        briefly "seasonId"
        described as {
          |The seasonId column of the stored season row.
        }
      }
      seasonName: String(3,200) with {
        briefly "seasonName"
        described as {
          |The seasonName column of the stored season row.
        }
      }
    } with {
      briefly "Stored season row"
      described as {
        |The persistence shape of season data as this repository stores it.
      }
    }
    schema LeagueData is relational
      of seasons as type StoredSeason
        index on field StoredSeason.seasonId
        index on field StoredSeason.status
        index on field StoredSeason.seasonName
 with {
      briefly "League data schema"
      described as {
        |The relational schema holding league data for the LeagueRepository.
      }
    }
    handler LeaguePersistence is {
      on query GetStandingsMetrics is {
        do "read the standings metrics projection"
        yield result StandingsMetricsView
      }
      on command Season.CreateSeason is {
        tell event Season.SeasonCreated to entity LeagueContext.Season
        do "Store new season"
      }
      on command Season.RegisterTeam is {
        do "Add team to season"
      }
      on command Season.ScheduleMatch is {
        tell event Season.MatchScheduled to entity LeagueContext.Season
        do "Store scheduled match"
      }
      on command Season.RecordResult is {
        tell event Season.ResultRecorded to entity LeagueContext.Season
        do "Store match result and update standings"
      }
      on command Season.AssignReferee is {
        tell event Season.RefereeAssigned to entity LeagueContext.Season
        do "Store referee assignment"
      }
      on command Season.ReportViolation is {
        do "Store rule violation"
      }
      on command Season.CompleteSeason is {
        tell event Season.SeasonCompleted to entity LeagueContext.Season
        do "Update season to completed"
      }
    } with {
      briefly "Persists league commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "League data persistence"
    described as {
      |Persistent storage for league data.
    }
  }
  query GetStandingsMetrics is  {
    standingsMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which standings metrics to retrieve.
      }
    }
  } with {
    briefly "Get standings metrics"
    described as {
      |Retrieves the standings metrics projection.
    }
  }
  result StandingsMetricsView is  {
    standingsMetrics: LeagueMetrics.StandingsMetrics with {
      briefly "Standings metrics"
      described as {
        |The standings metrics being returned.
      }
    }
  } with {
    briefly "Standings metrics view"
    described as {
      |Read model view carrying the standings metrics projection.
    }
  }
  projector LeagueMetrics is {
    updates repository LeagueContext.LeagueRepository
    inlet LeagueMetricsFromSeason is type SeasonEvent    outlet LeagueMetricsOut is type SeasonEvent
    record StandingsMetrics is  {
      totalSeasons: Natural with {
        briefly "Seasons"
        described as {
          |Total seasons.
        }
      }
      totalMatches: Natural with {
        briefly "Matches"
        described as {
          |Total matches played.
        }
      }
      totalTeams: Natural with {
        briefly "Teams"
        described as {
          |Total registered teams.
        }
      }
      totalViolations: Natural with {
        briefly "Violations"
        described as {
          |Total violations reported.
        }
      }
      averageGoalsPerMatch: Decimal(8,2) with {
        briefly "Avg goals"
        described as {
          |Average goals per match.
        }
      }
    } with {
      briefly "Standings metrics"
      described as {
        |League-wide statistics.
      }
    }
    handler MetricsHandler is {
      on event Season.SeasonCreated is {
        tell event Season.SeasonCreated to repository LeagueContext.LeagueRepository
        do "Increment total seasons"
      }
      on event Season.TeamRegistered is {
        tell event Season.TeamRegistered to repository LeagueContext.LeagueRepository
        do "Increment total teams"
      }
      on event Season.ResultRecorded is {
        tell event Season.ResultRecorded to repository LeagueContext.LeagueRepository
        do "Increment matches and update average goals"
      }
      on event Season.ViolationReported is {
        tell event Season.ViolationReported to repository LeagueContext.LeagueRepository
        do "Increment total violations"
      }
    } with {
      briefly "Maintains league metrics"
      described as {
        |Projects events into league statistics.
      }
    }
  } with {
    briefly "League metrics"
    described as {
      |League-wide analytics and statistics.
    }
  }
  // ---- Event publication for Season ----
  type SeasonEvent is one of {
    LeagueContext.Season.SeasonCreated or LeagueContext.Season.TeamRegistered or LeagueContext.Season.MatchScheduled or LeagueContext.Season.ResultRecorded or LeagueContext.Season.RefereeAssigned or LeagueContext.Season.ViolationReported or LeagueContext.Season.PlayoffsStarted or LeagueContext.Season.BracketAdvanced or LeagueContext.Season.SeasonCompleted or LeagueContext.Season.SeasonCancelled
  } with {
    briefly "Season event alternation"
    described as {
      |Union of all Season events, for streaming and event-sourced
      |persistence.
    }
  }
  processor SeasonEventSource as source is {
    outlet SeasonEvents is type SeasonEvent
    handler SeasonSourceHandler is {
      on event Season.SeasonCreated is {
        send event Season.SeasonCreated to outlet SeasonEvents
      }
      on event Season.TeamRegistered is {
        send event Season.TeamRegistered to outlet SeasonEvents
      }
      on event Season.MatchScheduled is {
        send event Season.MatchScheduled to outlet SeasonEvents
      }
      on event Season.ResultRecorded is {
        send event Season.ResultRecorded to outlet SeasonEvents
      }
      on event Season.RefereeAssigned is {
        send event Season.RefereeAssigned to outlet SeasonEvents
      }
      on event Season.ViolationReported is {
        send event Season.ViolationReported to outlet SeasonEvents
      }
      on event Season.PlayoffsStarted is {
        send event Season.PlayoffsStarted to outlet SeasonEvents
      }
      on event Season.BracketAdvanced is {
        send event Season.BracketAdvanced to outlet SeasonEvents
      }
      on event Season.SeasonCompleted is {
        send event Season.SeasonCompleted to outlet SeasonEvents
      }
      on event Season.SeasonCancelled is {
        send event Season.SeasonCancelled to outlet SeasonEvents
      }
      on other is {
        error "Unexpected message for source SeasonEventSource"
      }
    } with {
      briefly "Season source handler"
      described as {
        |Publishes Season events onto the outlet.
      }
    }
  } with {
    briefly "Season event source"
    described as {
      |Publishes Season entity events into the streaming topology.
    }
  }
  processor SeasonEventSink as sink is {
    inlet SeasonInlet is type SeasonEvent    handler SeasonSinkHandler is {
      on event Season.SeasonCreated is {
        tell event Season.SeasonCreated to repository LeagueContext.LeagueRepository
      }
      on event Season.TeamRegistered is {
        tell event Season.TeamRegistered to repository LeagueContext.LeagueRepository
      }
      on event Season.MatchScheduled is {
        tell event Season.MatchScheduled to repository LeagueContext.LeagueRepository
      }
      on event Season.ResultRecorded is {
        tell event Season.ResultRecorded to repository LeagueContext.LeagueRepository
      }
      on event Season.RefereeAssigned is {
        tell event Season.RefereeAssigned to repository LeagueContext.LeagueRepository
      }
      on event Season.ViolationReported is {
        tell event Season.ViolationReported to repository LeagueContext.LeagueRepository
      }
      on event Season.PlayoffsStarted is {
        tell event Season.PlayoffsStarted to repository LeagueContext.LeagueRepository
      }
      on event Season.BracketAdvanced is {
        tell event Season.BracketAdvanced to repository LeagueContext.LeagueRepository
      }
      on event Season.SeasonCompleted is {
        tell event Season.SeasonCompleted to repository LeagueContext.LeagueRepository
      }
      on event Season.SeasonCancelled is {
        tell event Season.SeasonCancelled to repository LeagueContext.LeagueRepository
      }
      on other is {
        error "Unexpected message for sink SeasonEventSink"
      }
    } with {
      briefly "Season sink handler"
      described as {
        |Persists Season events via the repository.
      }
    }
  } with {
    briefly "Season event sink"
    described as {
      |Receives Season events for persistence.
    }
  }
  connector SeasonEventFlow is from outlet LeagueContext.SeasonEventSource.SeasonEvents to inlet LeagueContext.SeasonEventSink.SeasonInlet with {
    briefly "Season event flow"
    described as {
      |Connects the Season source to its sink.
    }
  }
  processor SeasonEventSplit is {
    inlet SeasonEventSplitIn is type SeasonEvent    outlet SeasonEventSplitToLeagueRepository is type SeasonEvent
    outlet SeasonEventSplitToLeagueMetrics is type SeasonEvent
    handler SeasonEventSplitHandler is {
      on event Season.SeasonCreated is {
        send event Season.SeasonCreated to outlet SeasonEventSplitToLeagueRepository
        send event Season.SeasonCreated to outlet SeasonEventSplitToLeagueMetrics
        tell event Season.SeasonCreated to entity LeagueContext.Season
      }
      on event Season.TeamRegistered is {
        send event Season.TeamRegistered to outlet SeasonEventSplitToLeagueRepository
        send event Season.TeamRegistered to outlet SeasonEventSplitToLeagueMetrics
        tell event Season.TeamRegistered to entity LeagueContext.Season
      }
      on event Season.MatchScheduled is {
        send event Season.MatchScheduled to outlet SeasonEventSplitToLeagueRepository
        send event Season.MatchScheduled to outlet SeasonEventSplitToLeagueMetrics
        tell event Season.MatchScheduled to entity LeagueContext.Season
      }
      on event Season.ResultRecorded is {
        send event Season.ResultRecorded to outlet SeasonEventSplitToLeagueRepository
        send event Season.ResultRecorded to outlet SeasonEventSplitToLeagueMetrics
        tell event Season.ResultRecorded to entity LeagueContext.Season
      }
      on event Season.RefereeAssigned is {
        send event Season.RefereeAssigned to outlet SeasonEventSplitToLeagueRepository
        send event Season.RefereeAssigned to outlet SeasonEventSplitToLeagueMetrics
        tell event Season.RefereeAssigned to entity LeagueContext.Season
      }
      on event Season.ViolationReported is {
        send event Season.ViolationReported to outlet SeasonEventSplitToLeagueRepository
        send event Season.ViolationReported to outlet SeasonEventSplitToLeagueMetrics
        tell event Season.ViolationReported to entity LeagueContext.Season
      }
      on event Season.PlayoffsStarted is {
        send event Season.PlayoffsStarted to outlet SeasonEventSplitToLeagueRepository
        send event Season.PlayoffsStarted to outlet SeasonEventSplitToLeagueMetrics
        tell event Season.PlayoffsStarted to entity LeagueContext.Season
      }
      on event Season.BracketAdvanced is {
        send event Season.BracketAdvanced to outlet SeasonEventSplitToLeagueRepository
        send event Season.BracketAdvanced to outlet SeasonEventSplitToLeagueMetrics
        tell event Season.BracketAdvanced to entity LeagueContext.Season
      }
      on event Season.SeasonCompleted is {
        send event Season.SeasonCompleted to outlet SeasonEventSplitToLeagueRepository
        send event Season.SeasonCompleted to outlet SeasonEventSplitToLeagueMetrics
        tell event Season.SeasonCompleted to entity LeagueContext.Season
      }
      on event Season.SeasonCancelled is {
        send event Season.SeasonCancelled to outlet SeasonEventSplitToLeagueRepository
        send event Season.SeasonCancelled to outlet SeasonEventSplitToLeagueMetrics
        tell event Season.SeasonCancelled to entity LeagueContext.Season
      }
      on other is {
        error "Unexpected message for processor SeasonEventSplit"
      }
    } with {
      briefly "Season event fan-out handler"
      described as {
        |Delivers each Season event to all of its consumers.
      }
    }
  } with {
    briefly "Season event fan-out"
    described as {
      |Fans Season events out to the repository and projectors.
    }
  }
  connector 'SeasonEvent Stream' is from outlet LeagueContext.Season.SeasonEvents2 to inlet LeagueContext.SeasonEventSplit.SeasonEventSplitIn with {
    briefly "Season events, fanned out to storage and read models"
  }
  connector 'SeasonEvent Storage' is from outlet LeagueContext.SeasonEventSplit.SeasonEventSplitToLeagueRepository to inlet LeagueContext.LeagueRepository.LeagueRepositoryFromSeason with {
    briefly "Season events on their way to storage"
  }
  connector 'LeagueMetrics Feed' is from outlet LeagueContext.SeasonEventSplit.SeasonEventSplitToLeagueMetrics to inlet LeagueContext.LeagueMetrics.LeagueMetricsFromSeason with {
    briefly "Season events feeding the LeagueMetrics projection"
  }
  connector 'LeagueMetrics Storage' is from outlet LeagueContext.LeagueMetrics.LeagueMetricsOut to inlet LeagueContext.LeagueRepository.LeagueRepositoryFromLeagueMetrics with {
    briefly "The LeagueMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for league management"
  described as {
    |Sports league management context.
  }
}
