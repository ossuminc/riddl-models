// League Management - League Context
context LeagueContext is {
  include "types.riddl"
  include "Season.riddl"
  repository LeagueRepository is {
    schema LeagueData is relational
      of seasons as type Season
        index on field Season.seasonId
        index on field Season.status
        index on field Season.seasonName

    handler LeaguePersistence is {
      on command Season.CreateSeason is {
        tell event Season.SeasonCreated to entity LeagueContext.Season
        prompt "Store new season"
      }
      on command Season.RegisterTeam is {
        prompt "Add team to season"
      }
      on command Season.ScheduleMatch is {
        tell event Season.MatchScheduled to entity LeagueContext.Season
        prompt "Store scheduled match"
      }
      on command Season.RecordResult is {
        tell event Season.ResultRecorded to entity LeagueContext.Season
        prompt "Store match result and update standings"
      }
      on command Season.AssignReferee is {
        tell event Season.RefereeAssigned to entity LeagueContext.Season
        prompt "Store referee assignment"
      }
      on command Season.ReportViolation is {
        prompt "Store rule violation"
      }
      on command Season.CompleteSeason is {
        tell event Season.SeasonCompleted to entity LeagueContext.Season
        prompt "Update season to completed"
      }
    } with {
      briefly "Persists league commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "League data persistence"
    described as {
      |Persistent storage for league data.
    }
  }
  projector LeagueMetrics is {
    updates repository LeagueContext.LeagueRepository
    record StandingsMetrics is  {
      totalSeasons: Natural with {
        briefly "Seasons"
        described as {
          |Total seasons.
        }
      }
      totalMatches: Natural with {
        briefly "Matches"
        described as {
          |Total matches played.
        }
      }
      totalTeams: Natural with {
        briefly "Teams"
        described as {
          |Total registered teams.
        }
      }
      totalViolations: Natural with {
        briefly "Violations"
        described as {
          |Total violations reported.
        }
      }
      averageGoalsPerMatch: Decimal(8,2) with {
        briefly "Avg goals"
        described as {
          |Average goals per match.
        }
      }
    } with {
      briefly "Standings metrics"
      described as {
        |League-wide statistics.
      }
    }
    handler MetricsHandler is {
      on event Season.SeasonCreated is {
        tell event Season.SeasonCreated to repository LeagueContext.LeagueRepository
        prompt "Increment total seasons"
      }
      on event Season.TeamRegistered is {
        tell event Season.TeamRegistered to repository LeagueContext.LeagueRepository
        prompt "Increment total teams"
      }
      on event Season.ResultRecorded is {
        tell event Season.ResultRecorded to repository LeagueContext.LeagueRepository
        prompt "Increment matches and update average goals"
      }
      on event Season.ViolationReported is {
        tell event Season.ViolationReported to repository LeagueContext.LeagueRepository
        prompt "Increment total violations"
      }
    } with {
      briefly "Maintains league metrics"
      described as {
        |Projects events into league statistics.
      }
    }
  } with {
    briefly "League metrics"
    described as {
      |League-wide analytics and statistics.
    }
  }
  // ---- Event publication for Season ----
  type SeasonEvent is one of {
    LeagueContext.Season.SeasonCreated,
    LeagueContext.Season.TeamRegistered,
    LeagueContext.Season.MatchScheduled,
    LeagueContext.Season.ResultRecorded,
    LeagueContext.Season.RefereeAssigned,
    LeagueContext.Season.ViolationReported,
    LeagueContext.Season.PlayoffsStarted,
    LeagueContext.Season.BracketAdvanced,
    LeagueContext.Season.SeasonCompleted,
    LeagueContext.Season.SeasonCancelled
  } with {
    briefly "Season event alternation"
    described as {
      |Union of all Season events, for streaming and event-sourced
      |persistence.
    }
  }
  source SeasonEventSource is {
    outlet SeasonEvents is type SeasonEvent
    handler SeasonSourceHandler is {
      on event Season.SeasonCreated is {
        send event Season.SeasonCreated to outlet SeasonEvents
      }
      on event Season.TeamRegistered is {
        send event Season.TeamRegistered to outlet SeasonEvents
      }
      on event Season.MatchScheduled is {
        send event Season.MatchScheduled to outlet SeasonEvents
      }
      on event Season.ResultRecorded is {
        send event Season.ResultRecorded to outlet SeasonEvents
      }
      on event Season.RefereeAssigned is {
        send event Season.RefereeAssigned to outlet SeasonEvents
      }
      on event Season.ViolationReported is {
        send event Season.ViolationReported to outlet SeasonEvents
      }
      on event Season.PlayoffsStarted is {
        send event Season.PlayoffsStarted to outlet SeasonEvents
      }
      on event Season.BracketAdvanced is {
        send event Season.BracketAdvanced to outlet SeasonEvents
      }
      on event Season.SeasonCompleted is {
        send event Season.SeasonCompleted to outlet SeasonEvents
      }
      on event Season.SeasonCancelled is {
        send event Season.SeasonCancelled to outlet SeasonEvents
      }
      on other is {
        error "Unexpected message for source SeasonEventSource"
      }
    } with {
      briefly "Season source handler"
      described as {
        |Publishes Season events onto the outlet.
      }
    }
  } with {
    briefly "Season event source"
    described as {
      |Publishes Season entity events into the streaming topology.
    }
  }
  sink SeasonEventSink is {
    inlet SeasonInlet is type SeasonEvent
    handler SeasonSinkHandler is {
      on event Season.SeasonCreated is {
        tell event Season.SeasonCreated to repository LeagueContext.LeagueRepository
      }
      on event Season.TeamRegistered is {
        tell event Season.TeamRegistered to repository LeagueContext.LeagueRepository
      }
      on event Season.MatchScheduled is {
        tell event Season.MatchScheduled to repository LeagueContext.LeagueRepository
      }
      on event Season.ResultRecorded is {
        tell event Season.ResultRecorded to repository LeagueContext.LeagueRepository
      }
      on event Season.RefereeAssigned is {
        tell event Season.RefereeAssigned to repository LeagueContext.LeagueRepository
      }
      on event Season.ViolationReported is {
        tell event Season.ViolationReported to repository LeagueContext.LeagueRepository
      }
      on event Season.PlayoffsStarted is {
        tell event Season.PlayoffsStarted to repository LeagueContext.LeagueRepository
      }
      on event Season.BracketAdvanced is {
        tell event Season.BracketAdvanced to repository LeagueContext.LeagueRepository
      }
      on event Season.SeasonCompleted is {
        tell event Season.SeasonCompleted to repository LeagueContext.LeagueRepository
      }
      on event Season.SeasonCancelled is {
        tell event Season.SeasonCancelled to repository LeagueContext.LeagueRepository
      }
      on other is {
        error "Unexpected message for sink SeasonEventSink"
      }
    } with {
      briefly "Season sink handler"
      described as {
        |Persists Season events via the repository.
      }
    }
  } with {
    briefly "Season event sink"
    described as {
      |Receives Season events for persistence.
    }
  }
  connector SeasonEventFlow is {
    from outlet LeagueContext.SeasonEventSource.SeasonEvents to
      inlet LeagueContext.SeasonEventSink.SeasonInlet
  } with {
    briefly "Season event flow"
    described as {
      |Connects the Season source to its sink.
    }
  }
} with {
  briefly "Bounded context for league management"
  described as {
    |Sports league management context.
  }
}
