// Event Ticketing - Ticketing Context
context TicketingContext as router is {
  inlet TicketCommandStreamIn is type TicketCommand  outlet TicketCommandStreamOut is type TicketCommand
  inlet TicketResultStreamIn is result Ticket.TicketResult  outlet TicketResultStreamOut is result Ticket.TicketResult
  handler TicketingContextBoundary is {
    on createTicket: command Ticket.CreateTicket is {
      send createTicket to outlet TicketingContext.TicketCommandStreamOut
    }
    on reserveTicket: command Ticket.ReserveTicket is {
      send reserveTicket to outlet TicketingContext.TicketCommandStreamOut
    }
    on purchaseTicket: command Ticket.PurchaseTicket is {
      send purchaseTicket to outlet TicketingContext.TicketCommandStreamOut
    }
    on deliverTicket: command Ticket.DeliverTicket is {
      send deliverTicket to outlet TicketingContext.TicketCommandStreamOut
    }
    on validateTicket: command Ticket.ValidateTicket is {
      send validateTicket to outlet TicketingContext.TicketCommandStreamOut
    }
    on refundTicket: command Ticket.RefundTicket is {
      send refundTicket to outlet TicketingContext.TicketCommandStreamOut
    }
    on cancelTicket: command Ticket.CancelTicket is {
      send cancelTicket to outlet TicketingContext.TicketCommandStreamOut
    }
    on expireReservation: command Ticket.ExpireReservation is {
      send expireReservation to outlet TicketingContext.TicketCommandStreamOut
    }
    on ticketResult: result Ticket.TicketResult is {
      send ticketResult to outlet TicketingContext.TicketResultStreamOut
    }
    on other is {
      error "Unexpected message at the TicketingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TicketCommand Stream Intake' is from outlet TicketingContext.TicketCommandStreamOut to inlet TicketingContext.Ticket.TicketCommands  connector 'TicketResult Stream Egress' is from outlet TicketingContext.TicketingRepository.TicketingRepositoryResponses to inlet TicketingContext.TicketResultStreamIn  adaptor FromPaymentGateway from context PaymentGateway is { 
    handler FromPaymentGatewayHandler is {
      on event PaymentGateway.PaymentProcessed is {
        do "the model receives payment processed"
      }
      on event PaymentGateway.RefundProcessed is {
        do "the model receives refund processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentGateway"
      }
    } with {
      briefly "from payment gateway"
      described as {
        |Carries messages from the external PaymentGateway.
      }
    }
  } with {
    briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor ToPaymentGateway to context PaymentGateway is { 
    handler ToPaymentGatewayHandler is {
      on command PaymentGateway.ProcessPayment is {
        do "the model sends process payment"
      }
      on command PaymentGateway.ProcessRefund is {
        do "the model sends process refund"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentGateway"
      }
    } with {
      briefly "to payment gateway"
      described as {
        |Carries messages to the external PaymentGateway.
      }
    }
  } with {
    briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor FromVenueSystem from context VenueSystem is { 
    handler FromVenueSystemHandler is {
      on result VenueSystem.SeatAvailability is {
        do "the model receives seat availability"
      }
      on event VenueSystem.SeatReleased is {
        do "the model receives seat released"
      }
      on event VenueSystem.SeatReserved is {
        do "the model receives seat reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromVenueSystem"
      }
    } with {
      briefly "from venue system"
      described as {
        |Carries messages from the external VenueSystem.
      }
    }
  } with {
    briefly "VenueSystem integration"
    described as {
      |The model's side of the VenueSystem conversation.
    }
  }
  adaptor ToVenueSystem to context VenueSystem is { 
    handler ToVenueSystemHandler is {
      on query VenueSystem.GetSeatAvailability is {
        do "the model sends get seat availability"
      }
      on command VenueSystem.ReleaseSeat is {
        do "the model sends release seat"
      }
      on command VenueSystem.ReserveSeat is {
        do "the model sends reserve seat"
      }
      on other is {
        error "Unexpected message for adaptor ToVenueSystem"
      }
    } with {
      briefly "to venue system"
      described as {
        |Carries messages to the external VenueSystem.
      }
    }
  } with {
    briefly "VenueSystem integration"
    described as {
      |The model's side of the VenueSystem conversation.
    }
  }
  include "types.riddl"
  include "Ticket.riddl"
  type TicketingRepositoryCommand is one of {
    TicketingContext.TicketingRepository.PersistReservationExpired or TicketingContext.TicketingRepository.PersistTicketCancelled or TicketingContext.TicketingRepository.PersistTicketCreated or TicketingContext.TicketingRepository.PersistTicketDelivered or TicketingContext.TicketingRepository.PersistTicketPurchased or TicketingContext.TicketingRepository.PersistTicketRefunded or TicketingContext.TicketingRepository.PersistTicketReserved or TicketingContext.TicketingRepository.PersistTicketValidated
  } with {
    briefly "Anything that writes TicketingRepository"
    described as {
      |The persistence commands TicketingRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository TicketingRepository as flow is {
    inlet TicketingRepositoryFromTicketingMetrics is type TicketingRepositoryCommand
    command PersistReservationExpired is  {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationExpired applies to.
        }
      }
    } with {
      briefly "Persist ReservationExpired"
      described as {
        |Instructs this repository to apply ReservationExpired to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketCancelled is  {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketCancelled applies to.
        }
      }
    } with {
      briefly "Persist TicketCancelled"
      described as {
        |Instructs this repository to apply TicketCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketDelivered is  {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketDelivered applies to.
        }
      }
    } with {
      briefly "Persist TicketDelivered"
      described as {
        |Instructs this repository to apply TicketDelivered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketReserved is  {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketReserved applies to.
        }
      }
    } with {
      briefly "Persist TicketReserved"
      described as {
        |Instructs this repository to apply TicketReserved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketCreated is  {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketCreated applies to.
        }
      }
    } with {
      briefly "Persist TicketCreated"
      described as {
        |Instructs this repository to apply TicketCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketPurchased is  {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketPurchased applies to.
        }
      }
    } with {
      briefly "Persist TicketPurchased"
      described as {
        |Instructs this repository to apply TicketPurchased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketRefunded is  {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketRefunded applies to.
        }
      }
    } with {
      briefly "Persist TicketRefunded"
      described as {
        |Instructs this repository to apply TicketRefunded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketValidated is  {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketValidated applies to.
        }
      }
    } with {
      briefly "Persist TicketValidated"
      described as {
        |Instructs this repository to apply TicketValidated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet TicketingRepositoryResponses is result Ticket.TicketResult
    record StoredTicket is  {
      ticketId: TicketId with {
        briefly "ticketId"
        described as {
          |The ticketId column of the stored ticket row.
        }
      }
      eventInfo: EventInfo with {
        briefly "eventInfo"
        described as {
          |The eventInfo column of the stored ticket row.
        }
      }
      status: TicketStatus with {
        briefly "status"
        described as {
          |The status column of the stored ticket row.
        }
      }
    } with {
      briefly "Stored ticket row"
      described as {
        |The persistence shape of ticket data as this repository stores it.
      }
    }
    schema TicketingData is relational
      of tickets as record StoredTicket
        index on field StoredTicket.ticketId
        index on field StoredTicket.eventInfo.eventId
        index on field StoredTicket.status
 with {
      briefly "Ticketing data schema"
      described as {
        |The relational schema holding ticketing data for the TicketingRepository.
      }
    }
    handler TicketingPersistence is {
      on persistReservationExpired: command PersistReservationExpired is {
        do "apply ReservationExpired to the stored row"
      }
      on persistTicketCancelled: command PersistTicketCancelled is {
        do "apply TicketCancelled to the stored row"
      }
      on persistTicketDelivered: command PersistTicketDelivered is {
        do "apply TicketDelivered to the stored row"
      }
      on persistTicketReserved: command PersistTicketReserved is {
        do "apply TicketReserved to the stored row"
      }
      on persistTicketCreated: command PersistTicketCreated is {
        do "apply TicketCreated to the stored row"
      }
      on persistTicketPurchased: command PersistTicketPurchased is {
        do "apply TicketPurchased to the stored row"
      }
      on persistTicketRefunded: command PersistTicketRefunded is {
        do "apply TicketRefunded to the stored row"
      }
      on persistTicketValidated: command PersistTicketValidated is {
        do "apply TicketValidated to the stored row"
      }
      on query GetSalesMetrics is {
        let salesMetricsView: type SalesMetricsView = prompt("read the sales metrics projection")
        reply salesMetricsView
      }
    } with {
      briefly "Persists ticketing commands"
      described as {
        |Handles event-driven ticket persistence.
      }
    }
  } with {
    briefly "Ticketing data persistence"
    described as {
      |Persistent storage for tickets.
    }
  }
  query GetSalesMetrics replies result SalesMetricsView is  {
    salesMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which sales metrics to retrieve.
      }
    }
  } with {
    briefly "Get sales metrics"
    described as {
      |Retrieves the sales metrics projection.
    }
  }
  result SalesMetricsView is  {
    salesMetrics: TicketingMetrics.SalesMetrics with {
      briefly "Sales metrics"
      described as {
        |The sales metrics being returned.
      }
    }
  } with {
    briefly "Sales metrics view"
    described as {
      |Read model view carrying the sales metrics projection.
    }
  }
  projector TicketingMetrics as flow is {
    outlet TicketingMetricsToRepository is type TicketingRepositoryCommand
    updates repository TicketingContext.TicketingRepository
    inlet TicketingMetricsFromTicket is type TicketEvent
    record SalesMetrics is  {
      ticketsCreated: Natural with {
        briefly "Created"
        described as {
          |Tickets created.
        }
      }
      ticketsSold: Natural with {
        briefly "Sold"
        described as {
          |Tickets sold.
        }
      }
      ticketsRefunded: Natural with {
        briefly "Refunded"
        described as {
          |Tickets refunded.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total ticket revenue.
        }
      }
      averageTicketPrice: Decimal(10,2) with {
        briefly "Avg price"
        described as {
          |Average ticket price.
        }
      }
    } with {
      briefly "Sales metrics"
      described as {
        |Ticket sales metrics.
      }
    }
    handler MetricsHandler is {
      on reservationExpired: event Ticket.ReservationExpired is {
        tell command TicketingContext.TicketingRepository.PersistReservationExpired(ticketId = reservationExpired.ticketId) to repository TicketingContext.TicketingRepository
        do "apply ReservationExpired to the TicketingMetrics projection"
      }
      on ticketCancelled: event Ticket.TicketCancelled is {
        tell command TicketingContext.TicketingRepository.PersistTicketCancelled(ticketId = ticketCancelled.ticketId) to repository TicketingContext.TicketingRepository
        do "apply TicketCancelled to the TicketingMetrics projection"
      }
      on ticketDelivered: event Ticket.TicketDelivered is {
        tell command TicketingContext.TicketingRepository.PersistTicketDelivered(ticketId = ticketDelivered.ticketId) to repository TicketingContext.TicketingRepository
        do "apply TicketDelivered to the TicketingMetrics projection"
      }
      on ticketReserved: event Ticket.TicketReserved is {
        tell command TicketingContext.TicketingRepository.PersistTicketReserved(ticketId = ticketReserved.ticketId) to repository TicketingContext.TicketingRepository
        do "apply TicketReserved to the TicketingMetrics projection"
      }
      on ticketCreated: event Ticket.TicketCreated is {
        tell command TicketingContext.TicketingRepository.PersistTicketCreated(ticketId = ticketCreated.ticketId) to repository TicketingContext.TicketingRepository
      }
      on ticketPurchased: event Ticket.TicketPurchased is {
        tell command TicketingContext.TicketingRepository.PersistTicketPurchased(ticketId = ticketPurchased.ticketId) to repository TicketingContext.TicketingRepository
      }
      on ticketRefunded: event Ticket.TicketRefunded is {
        tell command TicketingContext.TicketingRepository.PersistTicketRefunded(ticketId = ticketRefunded.ticketId) to repository TicketingContext.TicketingRepository
      }
      on ticketValidated: event Ticket.TicketValidated is {
        tell command TicketingContext.TicketingRepository.PersistTicketValidated(ticketId = ticketValidated.ticketId) to repository TicketingContext.TicketingRepository
      }
    } with {
      briefly "Maintains ticketing metrics"
      described as {
        |Projects events into sales metrics.
      }
    }
  } with {
    briefly "Ticketing metrics"
    described as {
      |Ticket sales and entry analytics.
    }
  }
  processor TicketEventSplit as flow is {
    inlet TicketEventSplitIn is type TicketEvent
    outlet TicketEventSplitToTicketingMetrics is type TicketEvent
    handler TicketEventSplitHandler is {
      on ticketCreated: event Ticket.TicketCreated is {
        send ticketCreated to outlet TicketEventSplitToTicketingMetrics
        tell ticketCreated to entity TicketingContext.Ticket
      }
      on ticketReserved: event Ticket.TicketReserved is {
        send ticketReserved to outlet TicketEventSplitToTicketingMetrics
        tell ticketReserved to entity TicketingContext.Ticket
      }
      on ticketPurchased: event Ticket.TicketPurchased is {
        send ticketPurchased to outlet TicketEventSplitToTicketingMetrics
        tell ticketPurchased to entity TicketingContext.Ticket
      }
      on ticketDelivered: event Ticket.TicketDelivered is {
        send ticketDelivered to outlet TicketEventSplitToTicketingMetrics
        tell ticketDelivered to entity TicketingContext.Ticket
      }
      on ticketValidated: event Ticket.TicketValidated is {
        send ticketValidated to outlet TicketEventSplitToTicketingMetrics
        tell ticketValidated to entity TicketingContext.Ticket
      }
      on ticketRefunded: event Ticket.TicketRefunded is {
        send ticketRefunded to outlet TicketEventSplitToTicketingMetrics
        tell ticketRefunded to entity TicketingContext.Ticket
      }
      on ticketCancelled: event Ticket.TicketCancelled is {
        send ticketCancelled to outlet TicketEventSplitToTicketingMetrics
        tell ticketCancelled to entity TicketingContext.Ticket
      }
      on reservationExpired: event Ticket.ReservationExpired is {
        send reservationExpired to outlet TicketEventSplitToTicketingMetrics
        tell reservationExpired to entity TicketingContext.Ticket
      }
      on other is {
        error "Unexpected message for processor TicketEventSplit"
      }
    } with {
      briefly "Ticket event fan-out handler"
      described as {
        |Delivers each Ticket event to all of its consumers.
      }
    }
  } with {
    briefly "Ticket event fan-out"
    described as {
      |Fans Ticket events out to the repository and projectors.
    }
  }
  connector 'TicketEvent Stream' is from outlet TicketingContext.Ticket.TicketEvents2 to inlet TicketingContext.TicketEventSplit.TicketEventSplitIn with {
    briefly "Ticket events, fanned out to storage and read models"
  }
  connector 'TicketingMetrics Feed' is from outlet TicketingContext.TicketEventSplit.TicketEventSplitToTicketingMetrics to inlet TicketingContext.TicketingMetrics.TicketingMetricsFromTicket with {
    briefly "Ticket events feeding the TicketingMetrics projection"
  }
  connector 'TicketingMetrics Storage' is from outlet TicketingContext.TicketingMetrics.TicketingMetricsToRepository to inlet TicketingContext.TicketingRepository.TicketingRepositoryFromTicketingMetrics with {
    briefly "TicketingMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for event ticketing"
  described as {
    |Event ticketing bounded context.
  }
}
