// Event Ticketing Domain Model
// Ticket creation, sales, delivery, validation, and refunds for live events
domain EventTicketing is {
  persistent connector 'VenueSystemReply Stream' is from outlet VenueSystem.VenueSystemRepliesOut to inlet TicketingContext.ToVenueSystem.ToVenueSystemReplies with {
    briefly "What VenueSystem answers TicketingContext"
  }
  persistent connector 'PaymentGatewayEvent Stream' is from outlet PaymentGateway.PaymentGatewayEventsOut to inlet TicketingContext.FromPaymentGateway.FromPaymentGatewayIn with {
    briefly "What PaymentGateway tells TicketingContext, unasked"
  }
  persistent connector 'VenueSystemEvent Stream' is from outlet VenueSystem.VenueSystemEventsOut to inlet TicketingContext.FromVenueSystem.FromVenueSystemIn with {
    briefly "What VenueSystem tells TicketingContext, unasked"
  }
  persistent connector 'VenueSystemRequest Stream' is from outlet TicketingContext.ToVenueSystem.ToVenueSystemOut to inlet VenueSystem.VenueSystemRequests with {
    briefly "What TicketingContext asks VenueSystem to send"
  }
  persistent connector 'PaymentGatewayRequest Stream' is from outlet TicketingContext.ToPaymentGateway.ToPaymentGatewayOut to inlet PaymentGateway.PaymentGatewayRequests with {
    briefly "What TicketingContext asks PaymentGateway to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user EventOrganizer is "person creating and managing events" with {
    briefly "Event Organizer"
    described as {
      |Person who creates events and manages ticket inventory.
    }
  }
  user TicketBuyer is "person purchasing tickets for events" with {
    briefly "Ticket Buyer"
    described as {
      |Customer purchasing and using event tickets.
    }
  }
  user VenueStaff is "person scanning tickets at entry" with {
    briefly "Venue Staff"
    described as {
      |Staff member validating tickets at event entry.
    }
  }
  epic TicketPurchase is {
    user TicketBuyer wants to "to purchase tickets for a live event" so that "they can attend the event"
    case BuyTicketOnline is {
      user TicketBuyer wants to "to buy a ticket online" so that "they receive a digital ticket for entry"
      step is "Buyer selects" "event and pricing tier" "from catalog" with {
        briefly "Select ticket"
        described as {
          |Choose event and tier.
        }
      }
      step is "Buyer completes" "payment transaction" "for ticket" with {
        briefly "Pay for ticket"
        described as {
          |Process payment.
        }
      }
      step is "System delivers" "digital ticket" "to buyer" with {
        briefly "Deliver ticket"
        described as {
          |Send digital ticket.
        }
      }
    } with {
      briefly "Buy ticket online"
      described as {
        |Purchasing a ticket through the online platform.
      }
    }
  } with {
    briefly "Ticket purchase"
    described as {
      |Epic for purchasing event tickets.
    }
  }
  include "TicketingContext.riddl"
  include "external-contexts.riddl"
  application context EventTicketingApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in EventTicketing are delivered.
      }
    }
    group EventTicketingScreen is {
      input GetSalesMetricsInput acquires query TicketingContext.GetSalesMetrics with {
        briefly "Get sales metrics control"
        described as {
          |The control through which a user asks the get sales metrics question.
        }
      }
      input GetTicketInput acquires query TicketingContext.Ticket.GetTicket with {
        briefly "Get ticket control"
        described as {
          |The control through which a user asks the get ticket question.
        }
      }
      input CreateTicketInput acquires command TicketingContext.CreateTicket with {
        briefly "Create ticket control"
        described as {
          |The control through which a user submits the create ticket request.
        }
      }
      input DeliverTicketInput acquires command TicketingContext.Ticket.DeliverTicket with {
        briefly "Deliver ticket control"
        described as {
          |The control through which a user submits the deliver ticket request.
        }
      }
      input ValidateTicketInput acquires command TicketingContext.Ticket.ValidateTicket with {
        briefly "Validate ticket control"
        described as {
          |The control through which a user submits the validate ticket request.
        }
      }
    } with {
      briefly "Event ticketing screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppTicketingRepositoryQueries is query TicketingContext.GetSalesMetrics
    inlet AppTicketingRepositoryReplies is result TicketingContext.SalesMetricsView
    outlet AppTicketQueries is query TicketingContext.Ticket.GetTicket
    outlet AppTicketCommands is type TicketingContext.TicketRequest
    inlet AppTicketingRepositoryResponses is result TicketingContext.Ticket.TicketResult
    handler EventTicketingAppHandler is {
      on other is {
        error "Unexpected message for application context EventTicketingApp"
      }
    } with {
      briefly "EventTicketingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "EventTicketingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'TicketingRepositoryQuery Stream' is from outlet EventTicketingApp.AppTicketingRepositoryQueries to inlet TicketingContext.TicketingRepositoryQueriesIn with {
    briefly "EventTicketingApp's look-ups of the ticketing repository"
  }
  persistent connector 'TicketingRepositoryReply Stream' is from outlet TicketingContext.TicketingRepositoryRepliesOut to inlet EventTicketingApp.AppTicketingRepositoryReplies with {
    briefly "The ticketing repository's answers returned to EventTicketingApp"
  }
  persistent connector 'TicketQuery Stream' is from outlet EventTicketingApp.AppTicketQueries to inlet TicketingContext.TicketQueriesIn with {
    briefly "EventTicketingApp's look-ups of the ticket"
  }
  persistent connector 'TicketCommand Stream' is from outlet EventTicketingApp.AppTicketCommands to inlet TicketingContext.TicketCommandStreamIn with {
    briefly "Ticket commands from the application"
  }
  persistent connector 'TicketResult Stream' is from outlet TicketingContext.TicketResultStreamOut to inlet EventTicketingApp.AppTicketingRepositoryResponses with {
    briefly "Ticketing query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet EventTicketingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Event ticketing domain"
  described as {
    |Ticket creation, sales, delivery, validation, and refunds.
  }
}
