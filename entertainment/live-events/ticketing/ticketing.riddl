// Event Ticketing Domain Model
// Ticket creation, sales, delivery, validation, and refunds for live events
domain EventTicketing is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user EventOrganizer is "person creating and managing events" with {
    briefly "Event Organizer"
    described as {
      |Person who creates events and manages ticket inventory.
    }
  }
  user TicketBuyer is "person purchasing tickets for events" with {
    briefly "Ticket Buyer"
    described as {
      |Customer purchasing and using event tickets.
    }
  }
  user VenueStaff is "person scanning tickets at entry" with {
    briefly "Venue Staff"
    described as {
      |Staff member validating tickets at event entry.
    }
  }
  epic TicketPurchase is {
    user TicketBuyer wants to "to purchase tickets for a live event" so that "they can attend the event"
    case BuyTicketOnline is {
      user TicketBuyer wants to "to buy a ticket online" so that "they receive a digital ticket for entry"
      step is "Buyer selects" "event and pricing tier" "from catalog" with {
        briefly "Select ticket"
        described as {
          |Choose event and tier.
        }
      }
      step is "Buyer completes" "payment transaction" "for ticket" with {
        briefly "Pay for ticket"
        described as {
          |Process payment.
        }
      }
      step is "System delivers" "digital ticket" "to buyer" with {
        briefly "Deliver ticket"
        described as {
          |Send digital ticket.
        }
      }
    } with {
      briefly "Buy ticket online"
      described as {
        |Purchasing a ticket through the online platform.
      }
    }
  } with {
    briefly "Ticket purchase"
    described as {
      |Epic for purchasing event tickets.
    }
  }
  include "TicketingContext.riddl"
  include "external-contexts.riddl"
  application context EventTicketingApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in EventTicketing are delivered.
      }
    }
    outlet AppTicketCommands is type TicketingContext.Ticket.TicketCommand
    inlet AppTicketingRepositoryResponses is type TicketingContext.Ticket.TicketResult    handler EventTicketingAppHandler is {
      on other is {
        error "Unexpected message for application context EventTicketingApp"
      }
    } with {
      briefly "EventTicketingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "EventTicketingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'TicketCommand Stream' is from outlet EventTicketingApp.AppTicketCommands to inlet TicketingContext.Ticket.TicketCommands with {
    briefly "Ticket commands from the application"
  }
  persistent connector 'TicketResult Stream' is from outlet TicketingContext.TicketingRepository.TicketingRepositoryResponses to inlet EventTicketingApp.AppTicketingRepositoryResponses with {
    briefly "Ticketing query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet EventTicketingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Event ticketing domain"
  described as {
    |Ticket creation, sales, delivery, validation, and refunds.
  }
}
