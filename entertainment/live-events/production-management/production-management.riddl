// Production Management Domain Model
// Live event production planning and execution
domain ProductionManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ProductionManager is "person overseeing event productions" with {
    briefly "Production Manager"
    described as {
      |Manager coordinating all aspects of live event production.
    }
  }
  user StageManager is "person managing stage operations and cues" with {
    briefly "Stage Manager"
    described as {
      |Manager responsible for stage setup and show execution.
    }
  }
  user TechnicalDirector is "person coordinating technical equipment" with {
    briefly "Technical Director"
    described as {
      |Director managing sound, lighting, and video systems.
    }
  }
  epic EventProduction is {
    user ProductionManager wants to "to manage live event productions" so that "events are delivered on schedule with proper coordination"
    case PlanAndExecuteShow is {
      user ProductionManager wants to "to plan and execute a show" so that "all production elements come together for a successful event"
      step is "Manager creates" "production plan" "with venue and dates" with {
        briefly "Create production"
        described as {
          |Initialize production.
        }
      }
      step is "Manager schedules" "rehearsals and crew" "for the event" with {
        briefly "Schedule resources"
        described as {
          |Assign crew and rehearsals.
        }
      }
      step is "Manager executes" "the show" "with all elements coordinated" with {
        briefly "Execute show"
        described as {
          |Run the live event.
        }
      }
    } with {
      briefly "Plan and execute show"
      described as {
        |End-to-end live event production workflow.
      }
    }
  } with {
    briefly "Event production"
    described as {
      |Epic for live event production management.
    }
  }
  include "ProductionContext.riddl"
  include "external-contexts.riddl"
  application context ProductionManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ProductionManagement are delivered.
      }
    }
    outlet AppProductionCommands is type ProductionContext.Production.ProductionCommand
    inlet AppProductionRepositoryResponses is type ProductionContext.Production.ProductionResult    handler ProductionManagementAppHandler is {
      on other is {
        error "Unexpected message for application context ProductionManagementApp"
      }
    } with {
      briefly "ProductionManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ProductionManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ProductionCommand Stream' is from outlet ProductionManagementApp.AppProductionCommands to inlet ProductionContext.Production.ProductionCommands with {
    briefly "Production commands from the application"
  }
  persistent connector 'ProductionResult Stream' is from outlet ProductionContext.ProductionRepository.ProductionRepositoryResponses to inlet ProductionManagementApp.AppProductionRepositoryResponses with {
    briefly "Production query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ProductionManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Production management domain"
  described as {
    |Live event production planning and execution.
  }
}
