// Production Management - Production Context
context ProductionContext as router is {
  inlet ProductionContextFromToVenueSystem is command Production.RecordVenueDetails with {
    briefly "What ToVenueSystem makes of the answers it gets"
  }
  connector 'ToVenueSystem Intake' is from outlet ProductionContext.ToVenueSystem.ToVenueSystemToProductionContext to inlet ProductionContext.ProductionContextFromToVenueSystem with {
    briefly "Answers translated by ToVenueSystem, on their way in"
  }
  inlet ProductionContextFromToCrewManagement is command Production.AssignCrew with {
    briefly "What ToCrewManagement makes of the answers it gets"
  }
  connector 'ToCrewManagement Intake' is from outlet ProductionContext.ToCrewManagement.ToCrewManagementToProductionContext to inlet ProductionContext.ProductionContextFromToCrewManagement with {
    briefly "Answers translated by ToCrewManagement, on their way in"
  }
  inlet ProductionContextFromCrewManagement is command Production.AssignCrew with {
    briefly "What FromCrewManagement makes of that service's news"
  }
  connector 'FromCrewManagement Intake' is from outlet ProductionContext.FromCrewManagement.FromCrewManagementToProductionContext to inlet ProductionContext.ProductionContextFromCrewManagement with {
    briefly "What FromCrewManagement makes of that news, on its way in"
  }
  inlet ProductionCommandStreamIn is type ProductionCommand  outlet ProductionCommandStreamOut is type ProductionCommand
  inlet ProductionResultStreamIn is result Production.ProductionResult  outlet ProductionResultStreamOut is result Production.ProductionResult
  handler ProductionContextBoundary is {
    on recordVenueDetails: command Production.RecordVenueDetails is {
      send recordVenueDetails to outlet ProductionContext.ProductionCommandStreamOut
    }
    on createProduction: command Production.CreateProduction is {
      send createProduction to outlet ProductionContext.ProductionCommandStreamOut
    }
    on assignCrew: command Production.AssignCrew is {
      send assignCrew to outlet ProductionContext.ProductionCommandStreamOut
    }
    on allocateEquipment: command Production.AllocateEquipment is {
      send allocateEquipment to outlet ProductionContext.ProductionCommandStreamOut
    }
    on scheduleRehearsal: command Production.ScheduleRehearsal is {
      send scheduleRehearsal to outlet ProductionContext.ProductionCommandStreamOut
    }
    on completeRehearsal: command Production.CompleteRehearsal is {
      send completeRehearsal to outlet ProductionContext.ProductionCommandStreamOut
    }
    on beginLoadIn: command Production.BeginLoadIn is {
      send beginLoadIn to outlet ProductionContext.ProductionCommandStreamOut
    }
    on addCueSheet: command Production.AddCueSheet is {
      send addCueSheet to outlet ProductionContext.ProductionCommandStreamOut
    }
    on startShow: command Production.StartShow is {
      send startShow to outlet ProductionContext.ProductionCommandStreamOut
    }
    on completeShow: command Production.CompleteShow is {
      send completeShow to outlet ProductionContext.ProductionCommandStreamOut
    }
    on cancelProduction: command Production.CancelProduction is {
      send cancelProduction to outlet ProductionContext.ProductionCommandStreamOut
    }
    on productionResult: result Production.ProductionResult is {
      send productionResult to outlet ProductionContext.ProductionResultStreamOut
    }
    on other is {
      error "Unexpected message at the ProductionContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ProductionCommand Stream Intake' is from outlet ProductionContext.ProductionCommandStreamOut to inlet ProductionContext.Production.ProductionCommands  connector 'ProductionResult Stream Egress' is from outlet ProductionContext.ProductionRepository.ProductionRepositoryResponses to inlet ProductionContext.ProductionResultStreamIn  adaptor FromCrewManagement from context CrewManagement as flow is { 
    inlet FromCrewManagementIn is event CrewManagement.CrewMemberBooked    outlet FromCrewManagementToProductionContext is command Production.AssignCrew
    handler FromCrewManagementHandler is {
      on crewMemberBooked: event CrewManagement.CrewMemberBooked is {
        let item0: type Production.AssignCrew = prompt("translate the crewMemberBooked event into a AssignCrew, a booked crew member is who the production actually has")
        send item0 to outlet ProductionContext.FromCrewManagement.FromCrewManagementToProductionContext
      }
      on other is {
        error "Unexpected message for adaptor FromCrewManagement"
      }
    } with {
      briefly "from crew management"
      described as {
        |Carries messages from the external CrewManagement.
      }
    }
  } with {
    briefly "CrewManagement integration"
    described as {
      |The model's side of the CrewManagement conversation.
    }
  }
  adaptor ToCrewManagement to context CrewManagement as router is { 
    outlet ToCrewManagementToProductionContext is command Production.AssignCrew
    inlet ToCrewManagementIn is type ProductionEvent    inlet ToCrewManagementReplies is result CrewManagement.AvailableCrew    outlet ToCrewManagementOut is type CrewManagement.CrewManagementRequest
    handler ToCrewManagementHandler is {
      on crewAssigned: event Production.CrewAssigned is {
        let request: type CrewManagement.BookCrewMember = prompt("translate the crewAssigned event into a BookCrewMember committing that person's time to the production")
        send request to outlet ProductionContext.ToCrewManagement.ToCrewManagementOut
      }
      on productionCreated: event Production.ProductionCreated is {
        let answer: type CrewManagement.AvailableCrew = ask query CrewManagement.GetAvailableCrew of context CrewManagement
        do "hold the crew that came back free against the production, so assignment can choose from it"
        send command Production.AssignCrew(productionId = productionCreated.productionId, assignment = prompt("an assignment drawn from askAnswer.crewMembers")) to outlet ProductionContext.ToCrewManagement.ToCrewManagementToProductionContext
      }
      on other is {
        error "Unexpected message for adaptor ToCrewManagement"
      }
    } with {
      briefly "to crew management"
      described as {
        |Carries messages to the external CrewManagement.
      }
    }
  } with {
    briefly "CrewManagement integration"
    described as {
      |The model's side of the CrewManagement conversation.
    }
  }
  adaptor FromVenueSystem from context VenueSystem as sink is { 
    inlet FromVenueSystemIn is event VenueSystem.VenueReserved    handler FromVenueSystemHandler is {
      on venueReserved: event VenueSystem.VenueReserved is {
        do "the venue is held; load-in begins when the production decides to start"
      }
      on other is {
        error "Unexpected message for adaptor FromVenueSystem"
      }
    } with {
      briefly "from venue system"
      described as {
        |Carries messages from the external VenueSystem.
      }
    }
  } with {
    briefly "VenueSystem integration"
    described as {
      |The model's side of the VenueSystem conversation.
    }
  }
  adaptor ToVenueSystem to context VenueSystem as router is { 
    outlet ToVenueSystemToProductionContext is command Production.RecordVenueDetails
    inlet ToVenueSystemIn is type ProductionEvent    inlet ToVenueSystemReplies is result VenueSystem.VenueDetails    outlet ToVenueSystemOut is type VenueSystem.VenueSystemRequest
    handler ToVenueSystemHandler is {
      on productionCreated: event Production.ProductionCreated is {
        let askAnswer: type VenueSystem.VenueDetails = ask query VenueSystem.GetVenueDetails of context VenueSystem
        do "a production needing the hall's dimensions and rig before anything is planned"
        send command Production.RecordVenueDetails(productionId = productionCreated.productionId, venueId = prompt("the venue id of this record venue details"), capacity = prompt("the capacity of this record venue details"), stageSpecs = prompt("the stage specs of this record venue details")) to outlet ProductionContext.ToVenueSystem.ToVenueSystemToProductionContext
        let item0: type VenueSystem.ReserveVenue = prompt("translate the productionCreated event into a ReserveVenue, the production being what creates the need for a hall")
        send item0 to outlet ProductionContext.ToVenueSystem.ToVenueSystemOut
      }
      on other is {
        error "Unexpected message for adaptor ToVenueSystem"
      }
    } with {
      briefly "to venue system"
      described as {
        |Carries messages to the external VenueSystem.
      }
    }
  } with {
    briefly "VenueSystem integration"
    described as {
      |The model's side of the VenueSystem conversation.
    }
  }
  include "types.riddl"
  include "Production.riddl"
  type ProductionRepositoryCommand is one of {
    ProductionContext.ProductionRepository.PersistCrewAssigned or ProductionContext.ProductionRepository.PersistCueSheetAdded or ProductionContext.ProductionRepository.PersistEquipmentAllocated or ProductionContext.ProductionRepository.PersistLoadInStarted or ProductionContext.ProductionRepository.PersistProductionCancelled or ProductionContext.ProductionRepository.PersistProductionCreated or ProductionContext.ProductionRepository.PersistRehearsalCompleted or ProductionContext.ProductionRepository.PersistRehearsalScheduled or ProductionContext.ProductionRepository.PersistShowCompleted or ProductionContext.ProductionRepository.PersistShowStarted
  } with {
    briefly "Anything that writes ProductionRepository"
    described as {
      |The persistence commands ProductionRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ProductionRepository as flow is {
    inlet ProductionRepositoryFromProductionMetrics is type ProductionRepositoryCommand    command PersistCrewAssigned is {
      productionId: ProductionId with {
        briefly "Row addressed"
        described as {
          |Which stored row CrewAssigned applies to.
        }
      }
      assignment: CrewAssignment? with {
        briefly "Assignment"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CrewAssigned"
      described as {
        |Instructs this repository to apply CrewAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCueSheetAdded is {
      productionId: ProductionId with {
        briefly "Row addressed"
        described as {
          |Which stored row CueSheetAdded applies to.
        }
      }
      cueCount: Natural? with {
        briefly "Cue count"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CueSheetAdded"
      described as {
        |Instructs this repository to apply CueSheetAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEquipmentAllocated is {
      productionId: ProductionId with {
        briefly "Row addressed"
        described as {
          |Which stored row EquipmentAllocated applies to.
        }
      }
      allocation: EquipmentAllocation? with {
        briefly "Allocation"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      allocatedAt: TimeStamp? with {
        briefly "Allocated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist EquipmentAllocated"
      described as {
        |Instructs this repository to apply EquipmentAllocated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLoadInStarted is {
      productionId: ProductionId with {
        briefly "Row addressed"
        described as {
          |Which stored row LoadInStarted applies to.
        }
      }
      startedAt: TimeStamp? with {
        briefly "Started at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist LoadInStarted"
      described as {
        |Instructs this repository to apply LoadInStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRehearsalCompleted is {
      productionId: ProductionId with {
        briefly "Row addressed"
        described as {
          |Which stored row RehearsalCompleted applies to.
        }
      }
      rehearsalId: RehearsalId? with {
        briefly "Rehearsal id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist RehearsalCompleted"
      described as {
        |Instructs this repository to apply RehearsalCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRehearsalScheduled is {
      productionId: ProductionId with {
        briefly "Row addressed"
        described as {
          |Which stored row RehearsalScheduled applies to.
        }
      }
      rehearsal: RehearsalSchedule? with {
        briefly "Rehearsal"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      scheduledAt: TimeStamp? with {
        briefly "Scheduled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist RehearsalScheduled"
      described as {
        |Instructs this repository to apply RehearsalScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShowStarted is {
      productionId: ProductionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShowStarted applies to.
        }
      }
      startedAt: TimeStamp? with {
        briefly "Started at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ShowStarted"
      described as {
        |Instructs this repository to apply ShowStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProductionCancelled is {
      productionId: ProductionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProductionCancelled applies to.
        }
      }
      reason: String(3,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ProductionCancelled"
      described as {
        |Instructs this repository to apply ProductionCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProductionCreated is {
      productionId: ProductionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProductionCreated applies to.
        }
      }
      productionInfo: ProductionInfo? with {
        briefly "Production info"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ProductionCreated"
      described as {
        |Instructs this repository to apply ProductionCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShowCompleted is {
      productionId: ProductionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShowCompleted applies to.
        }
      }
      actualAttendance: Natural? with {
        briefly "Actual attendance"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ShowCompleted"
      described as {
        |Instructs this repository to apply ShowCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ProductionRepositoryResponses is result Production.ProductionResult
    record StoredProduction is {
      productionId: ProductionId with {
        briefly "productionId"
        described as {
          |The productionId column of the stored production row.
        }
      }
      productionInfo: ProductionInfo with {
        briefly "productionInfo"
        described as {
          |The productionInfo column of the stored production row.
        }
      }
      status: ProductionStatus with {
        briefly "status"
        described as {
          |The status column of the stored production row.
        }
      }
      assignment: CrewAssignment? with {
        briefly "Assignment"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      cueCount: Natural? with {
        briefly "Cue count"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      allocation: EquipmentAllocation? with {
        briefly "Allocation"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      allocatedAt: TimeStamp? with {
        briefly "Allocated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      startedAt: TimeStamp? with {
        briefly "Started at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      rehearsalId: RehearsalId? with {
        briefly "Rehearsal id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      completedAt: TimeStamp? with {
        briefly "Completed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      rehearsal: RehearsalSchedule? with {
        briefly "Rehearsal"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      scheduledAt: TimeStamp? with {
        briefly "Scheduled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(3,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      actualAttendance: Natural? with {
        briefly "Actual attendance"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored production row"
      described as {
        |The persistence shape of production data as this repository stores it.
      }
    }
    schema ProductionData is relational
      of productions as record StoredProduction
        key on field StoredProduction.productionId
        index on field StoredProduction.productionInfo.venueId
        index on field StoredProduction.status
 with {
      briefly "Production data schema"
      described as {
        |The relational schema holding production data for the ProductionRepository.
      }
    }
    handler ProductionPersistence is {
      on persistCrewAssigned: command PersistCrewAssigned is {
        update ProductionData.productions set assignment = persistCrewAssigned.assignment, assignedAt = persistCrewAssigned.assignedAt where productionId == persistCrewAssigned.productionId
      }
      on persistCueSheetAdded: command PersistCueSheetAdded is {
        update ProductionData.productions set cueCount = persistCueSheetAdded.cueCount, addedAt = persistCueSheetAdded.addedAt where productionId == persistCueSheetAdded.productionId
      }
      on persistEquipmentAllocated: command PersistEquipmentAllocated is {
        update ProductionData.productions set allocation = persistEquipmentAllocated.allocation, allocatedAt = persistEquipmentAllocated.allocatedAt where productionId == persistEquipmentAllocated.productionId
      }
      on persistLoadInStarted: command PersistLoadInStarted is {
        update ProductionData.productions set startedAt = persistLoadInStarted.startedAt where productionId == persistLoadInStarted.productionId
      }
      on persistRehearsalCompleted: command PersistRehearsalCompleted is {
        update ProductionData.productions set rehearsalId = persistRehearsalCompleted.rehearsalId, completedAt = persistRehearsalCompleted.completedAt where productionId == persistRehearsalCompleted.productionId
      }
      on persistRehearsalScheduled: command PersistRehearsalScheduled is {
        update ProductionData.productions set rehearsal = persistRehearsalScheduled.rehearsal, scheduledAt = persistRehearsalScheduled.scheduledAt where productionId == persistRehearsalScheduled.productionId
      }
      on persistShowStarted: command PersistShowStarted is {
        update ProductionData.productions set startedAt = persistShowStarted.startedAt where productionId == persistShowStarted.productionId
      }
      on persistProductionCancelled: command PersistProductionCancelled is {
        update ProductionData.productions set reason = persistProductionCancelled.reason, cancelledAt = persistProductionCancelled.cancelledAt where productionId == persistProductionCancelled.productionId
      }
      on persistProductionCreated: command PersistProductionCreated is {
        update ProductionData.productions set productionInfo = persistProductionCreated.productionInfo, createdAt = persistProductionCreated.createdAt where productionId == persistProductionCreated.productionId
      }
      on persistShowCompleted: command PersistShowCompleted is {
        update ProductionData.productions set actualAttendance = persistShowCompleted.actualAttendance, completedAt = persistShowCompleted.completedAt where productionId == persistShowCompleted.productionId
      }
      on query GetEventMetrics is {
        let eventMetricsView: type EventMetricsView = prompt("read the event metrics projection")
        reply eventMetricsView
      }
    } with {
      briefly "Persists production commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Production data persistence"
    described as {
      |Persistent storage for productions.
    }
  }
  query GetEventMetrics replies result EventMetricsView is {
    eventMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which event metrics to retrieve.
      }
    }
  } with {
    briefly "Get event metrics"
    described as {
      |Retrieves the event metrics projection.
    }
  }
  result EventMetricsView is {
    eventMetrics: ProductionMetrics.EventMetrics with {
      briefly "Event metrics"
      described as {
        |The event metrics being returned.
      }
    }
  } with {
    briefly "Event metrics view"
    described as {
      |Read model view carrying the event metrics projection.
    }
  }
  projector ProductionMetrics as flow is {
    updates repository ProductionContext.ProductionRepository
    outlet ProductionMetricsToRepository is type ProductionRepositoryCommand
    inlet ProductionMetricsFromProduction is type ProductionEvent    record EventMetrics is {
      productionsCreated: Natural with {
        briefly "Created"
        described as {
          |Productions created.
        }
      }
      productionsCompleted: Natural with {
        briefly "Completed"
        described as {
          |Productions completed.
        }
      }
      productionsCancelled: Natural with {
        briefly "Cancelled"
        described as {
          |Productions cancelled.
        }
      }
      totalAttendance: Natural with {
        briefly "Attendance"
        described as {
          |Total audience attendance.
        }
      }
      averageCrewSize: Decimal(8,2) with {
        briefly "Avg crew"
        described as {
          |Average crew size per production.
        }
      }
    } with {
      briefly "Event metrics"
      described as {
        |Production event metrics.
      }
    }
    handler MetricsHandler is {
      on crewAssigned: event Production.CrewAssigned is {
        tell command ProductionContext.ProductionRepository.PersistCrewAssigned(productionId = crewAssigned.productionId, assignment = crewAssigned.assignment, assignedAt = crewAssigned.assignedAt) to repository ProductionContext.ProductionRepository
        do "apply CrewAssigned to the ProductionMetrics projection"
      }
      on cueSheetAdded: event Production.CueSheetAdded is {
        tell command ProductionContext.ProductionRepository.PersistCueSheetAdded(productionId = cueSheetAdded.productionId, cueCount = cueSheetAdded.cueCount, addedAt = cueSheetAdded.addedAt) to repository ProductionContext.ProductionRepository
        do "apply CueSheetAdded to the ProductionMetrics projection"
      }
      on equipmentAllocated: event Production.EquipmentAllocated is {
        tell command ProductionContext.ProductionRepository.PersistEquipmentAllocated(productionId = equipmentAllocated.productionId, allocation = equipmentAllocated.allocation, allocatedAt = equipmentAllocated.allocatedAt) to repository ProductionContext.ProductionRepository
        do "apply EquipmentAllocated to the ProductionMetrics projection"
      }
      on loadInStarted: event Production.LoadInStarted is {
        tell command ProductionContext.ProductionRepository.PersistLoadInStarted(productionId = loadInStarted.productionId, startedAt = loadInStarted.startedAt) to repository ProductionContext.ProductionRepository
        do "apply LoadInStarted to the ProductionMetrics projection"
      }
      on rehearsalCompleted: event Production.RehearsalCompleted is {
        tell command ProductionContext.ProductionRepository.PersistRehearsalCompleted(productionId = rehearsalCompleted.productionId, rehearsalId = rehearsalCompleted.rehearsalId, completedAt = rehearsalCompleted.completedAt) to repository ProductionContext.ProductionRepository
        do "apply RehearsalCompleted to the ProductionMetrics projection"
      }
      on rehearsalScheduled: event Production.RehearsalScheduled is {
        tell command ProductionContext.ProductionRepository.PersistRehearsalScheduled(productionId = rehearsalScheduled.productionId, rehearsal = rehearsalScheduled.rehearsal, scheduledAt = rehearsalScheduled.scheduledAt) to repository ProductionContext.ProductionRepository
        do "apply RehearsalScheduled to the ProductionMetrics projection"
      }
      on showStarted: event Production.ShowStarted is {
        tell command ProductionContext.ProductionRepository.PersistShowStarted(productionId = showStarted.productionId, startedAt = showStarted.startedAt) to repository ProductionContext.ProductionRepository
        do "apply ShowStarted to the ProductionMetrics projection"
      }
      on productionCreated: event Production.ProductionCreated is {
        tell command ProductionContext.ProductionRepository.PersistProductionCreated(productionId = productionCreated.productionId, productionInfo = productionCreated.productionInfo, createdAt = productionCreated.createdAt) to repository ProductionContext.ProductionRepository
      }
      on showCompleted: event Production.ShowCompleted is {
        tell command ProductionContext.ProductionRepository.PersistShowCompleted(productionId = showCompleted.productionId, actualAttendance = showCompleted.actualAttendance, completedAt = showCompleted.completedAt) to repository ProductionContext.ProductionRepository
      }
      on productionCancelled: event Production.ProductionCancelled is {
        tell command ProductionContext.ProductionRepository.PersistProductionCancelled(productionId = productionCancelled.productionId, reason = productionCancelled.reason, cancelledAt = productionCancelled.cancelledAt) to repository ProductionContext.ProductionRepository
      }
      on venueDetailsRecorded: event Production.VenueDetailsRecorded is {
        do "a venue details recorded changes nothing this projector keeps"
      }
    } with {
      briefly "Maintains production metrics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Production metrics"
    described as {
      |Production management analytics.
    }
  }
  streamlet ProductionEventSplit as split is {
    outlet ProductionEventSplitToToVenueSystem is type ProductionEvent
    outlet ProductionEventSplitToToCrewManagement is type ProductionEvent
    inlet ProductionEventSplitIn is type ProductionEvent    outlet ProductionEventSplitToProductionMetrics is type ProductionEvent
    handler ProductionEventSplitHandler is {
      on productionCreated: event Production.ProductionCreated is {
        send productionCreated to outlet ProductionEventSplitToProductionMetrics
        send productionCreated to outlet ProductionEventSplitToToVenueSystem
        send productionCreated to outlet ProductionEventSplitToToCrewManagement
        tell productionCreated to entity ProductionContext.Production
      }
      on crewAssigned: event Production.CrewAssigned is {
        send crewAssigned to outlet ProductionEventSplitToProductionMetrics
        send crewAssigned to outlet ProductionEventSplitToToCrewManagement
        tell crewAssigned to entity ProductionContext.Production
      }
      on equipmentAllocated: event Production.EquipmentAllocated is {
        send equipmentAllocated to outlet ProductionEventSplitToProductionMetrics
        tell equipmentAllocated to entity ProductionContext.Production
      }
      on rehearsalScheduled: event Production.RehearsalScheduled is {
        send rehearsalScheduled to outlet ProductionEventSplitToProductionMetrics
        tell rehearsalScheduled to entity ProductionContext.Production
      }
      on rehearsalCompleted: event Production.RehearsalCompleted is {
        send rehearsalCompleted to outlet ProductionEventSplitToProductionMetrics
        tell rehearsalCompleted to entity ProductionContext.Production
      }
      on loadInStarted: event Production.LoadInStarted is {
        send loadInStarted to outlet ProductionEventSplitToProductionMetrics
        tell loadInStarted to entity ProductionContext.Production
      }
      on cueSheetAdded: event Production.CueSheetAdded is {
        send cueSheetAdded to outlet ProductionEventSplitToProductionMetrics
        tell cueSheetAdded to entity ProductionContext.Production
      }
      on showStarted: event Production.ShowStarted is {
        send showStarted to outlet ProductionEventSplitToProductionMetrics
        tell showStarted to entity ProductionContext.Production
      }
      on showCompleted: event Production.ShowCompleted is {
        send showCompleted to outlet ProductionEventSplitToProductionMetrics
        tell showCompleted to entity ProductionContext.Production
      }
      on productionCancelled: event Production.ProductionCancelled is {
        send productionCancelled to outlet ProductionEventSplitToProductionMetrics
        tell productionCancelled to entity ProductionContext.Production
      }
      on venueDetailsRecorded: event Production.VenueDetailsRecorded is {
        send venueDetailsRecorded to outlet ProductionEventSplitToProductionMetrics
        tell venueDetailsRecorded to entity ProductionContext.Production
      }
      on other is {
        error "Unexpected message for processor ProductionEventSplit"
      }
    } with {
      briefly "Production event fan-out handler"
      described as {
        |Delivers each Production event to all of its consumers.
      }
    }
  } with {
    briefly "Production event fan-out"
    described as {
      |Fans Production events out to the repository and projectors.
    }
  }
  connector 'ToVenueSystem Feed' is from outlet ProductionContext.ProductionEventSplit.ProductionEventSplitToToVenueSystem to inlet ProductionContext.ToVenueSystem.ToVenueSystemIn with {
    briefly "The Production events ToVenueSystem translates, on their way to it"
  }
  connector 'ToCrewManagement Feed' is from outlet ProductionContext.ProductionEventSplit.ProductionEventSplitToToCrewManagement to inlet ProductionContext.ToCrewManagement.ToCrewManagementIn with {
    briefly "The Production events ToCrewManagement translates, on their way to it"
  }
  connector 'ProductionEvent Stream' is from outlet ProductionContext.Production.ProductionEvents2 to inlet ProductionContext.ProductionEventSplit.ProductionEventSplitIn with {
    briefly "Production events, fanned out to storage and read models"
  }
  connector 'ProductionMetrics Feed' is from outlet ProductionContext.ProductionEventSplit.ProductionEventSplitToProductionMetrics to inlet ProductionContext.ProductionMetrics.ProductionMetricsFromProduction with {
    briefly "Production events feeding the ProductionMetrics projection"
  }
  connector 'ProductionMetrics Storage' is from outlet ProductionContext.ProductionMetrics.ProductionMetricsToRepository to inlet ProductionContext.ProductionRepository.ProductionRepositoryFromProductionMetrics with {
    briefly "ProductionMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for production management"
  described as {
    |Live event production management context.
  }
}
