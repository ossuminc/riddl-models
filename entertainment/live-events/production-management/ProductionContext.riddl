// Production Management - Production Context
context ProductionContext is {
  adaptor FromCrewManagement from context CrewManagement is { 
    handler FromCrewManagementHandler is {
      on result CrewManagement.AvailableCrew is {
        do "the model receives available crew"
      }
      on event CrewManagement.CrewMemberBooked is {
        do "the model receives crew member booked"
      }
      on other is {
        error "Unexpected message for adaptor FromCrewManagement"
      }
    } with {
      briefly "from crew management"
      described as {
        |Carries messages from the external CrewManagement.
      }
    }
  } with {
    briefly "CrewManagement integration"
    described as {
      |The model's side of the CrewManagement conversation.
    }
  }
  adaptor ToCrewManagement to context CrewManagement is { 
    handler ToCrewManagementHandler is {
      on command CrewManagement.BookCrewMember is {
        do "the model sends book crew member"
      }
      on query CrewManagement.GetAvailableCrew is {
        do "the model sends get available crew"
      }
      on other is {
        error "Unexpected message for adaptor ToCrewManagement"
      }
    } with {
      briefly "to crew management"
      described as {
        |Carries messages to the external CrewManagement.
      }
    }
  } with {
    briefly "CrewManagement integration"
    described as {
      |The model's side of the CrewManagement conversation.
    }
  }
  adaptor FromVenueSystem from context VenueSystem is { 
    handler FromVenueSystemHandler is {
      on result VenueSystem.VenueDetails is {
        do "the model receives venue details"
      }
      on event VenueSystem.VenueReserved is {
        do "the model receives venue reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromVenueSystem"
      }
    } with {
      briefly "from venue system"
      described as {
        |Carries messages from the external VenueSystem.
      }
    }
  } with {
    briefly "VenueSystem integration"
    described as {
      |The model's side of the VenueSystem conversation.
    }
  }
  adaptor ToVenueSystem to context VenueSystem is { 
    handler ToVenueSystemHandler is {
      on query VenueSystem.GetVenueDetails is {
        do "the model sends get venue details"
      }
      on command VenueSystem.ReserveVenue is {
        do "the model sends reserve venue"
      }
      on other is {
        error "Unexpected message for adaptor ToVenueSystem"
      }
    } with {
      briefly "to venue system"
      described as {
        |Carries messages to the external VenueSystem.
      }
    }
  } with {
    briefly "VenueSystem integration"
    described as {
      |The model's side of the VenueSystem conversation.
    }
  }
  include "types.riddl"
  include "Production.riddl"
  repository ProductionRepository as merge is {
    inlet ProductionRepositoryFromProduction is type ProductionEvent    inlet ProductionRepositoryFromProductionMetrics is type ProductionEvent    outlet ProductionRepositoryResponses is type Production.ProductionResult
    record StoredProduction is  {
      productionId: ProductionId with {
        briefly "productionId"
        described as {
          |The productionId column of the stored production row.
        }
      }
      productionInfo: ProductionInfo with {
        briefly "productionInfo"
        described as {
          |The productionInfo column of the stored production row.
        }
      }
      status: ProductionStatus with {
        briefly "status"
        described as {
          |The status column of the stored production row.
        }
      }
    } with {
      briefly "Stored production row"
      described as {
        |The persistence shape of production data as this repository stores it.
      }
    }
    schema ProductionData is relational
      of productions as type StoredProduction
        index on field StoredProduction.productionId
        index on field StoredProduction.productionInfo.venueId
        index on field StoredProduction.status
 with {
      briefly "Production data schema"
      described as {
        |The relational schema holding production data for the ProductionRepository.
      }
    }
    handler ProductionPersistence is {
      on query GetEventMetrics is {
        do "read the event metrics projection"
        reply result EventMetricsView
      }
      on createProduction: command Production.CreateProduction is {
        tell event Production.ProductionCreated(productionId = createProduction.productionId, productionInfo = createProduction.productionInfo) to entity ProductionContext.Production
      }
      on assignCrew: command Production.AssignCrew is {
        tell event Production.CrewAssigned(productionId = assignCrew.productionId, assignment = assignCrew.assignment) to entity ProductionContext.Production
      }
      on allocateEquipment: command Production.AllocateEquipment is {
        tell event Production.EquipmentAllocated(productionId = allocateEquipment.productionId, allocation = allocateEquipment.allocation) to entity ProductionContext.Production
      }
      on scheduleRehearsal: command Production.ScheduleRehearsal is {
        tell event Production.RehearsalScheduled(productionId = scheduleRehearsal.productionId, rehearsal = scheduleRehearsal.rehearsal) to entity ProductionContext.Production
      }
      on completeRehearsal: command Production.CompleteRehearsal is {
        tell event Production.RehearsalCompleted(productionId = completeRehearsal.productionId, rehearsalId = completeRehearsal.rehearsalId) to entity ProductionContext.Production
      }
      on completeShow: command Production.CompleteShow is {
        tell event Production.ShowCompleted(productionId = completeShow.productionId, actualAttendance = completeShow.actualAttendance, completedAt = completeShow.completedAt) to entity ProductionContext.Production
      }
    } with {
      briefly "Persists production commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Production data persistence"
    described as {
      |Persistent storage for productions.
    }
  }
  query GetEventMetrics is  {
    eventMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which event metrics to retrieve.
      }
    }
  } with {
    briefly "Get event metrics"
    described as {
      |Retrieves the event metrics projection.
    }
  }
  result EventMetricsView is  {
    eventMetrics: ProductionMetrics.EventMetrics with {
      briefly "Event metrics"
      described as {
        |The event metrics being returned.
      }
    }
  } with {
    briefly "Event metrics view"
    described as {
      |Read model view carrying the event metrics projection.
    }
  }
  projector ProductionMetrics as flow is {
    updates repository ProductionContext.ProductionRepository
    inlet ProductionMetricsFromProduction is type ProductionEvent    outlet ProductionMetricsOut is type ProductionEvent
    record EventMetrics is  {
      productionsCreated: Natural with {
        briefly "Created"
        described as {
          |Productions created.
        }
      }
      productionsCompleted: Natural with {
        briefly "Completed"
        described as {
          |Productions completed.
        }
      }
      productionsCancelled: Natural with {
        briefly "Cancelled"
        described as {
          |Productions cancelled.
        }
      }
      totalAttendance: Natural with {
        briefly "Attendance"
        described as {
          |Total audience attendance.
        }
      }
      averageCrewSize: Decimal(8,2) with {
        briefly "Avg crew"
        described as {
          |Average crew size per production.
        }
      }
    } with {
      briefly "Event metrics"
      described as {
        |Production event metrics.
      }
    }
    handler MetricsHandler is {
      on productionCreated: event Production.ProductionCreated is {
        tell productionCreated to repository ProductionContext.ProductionRepository
      }
      on showCompleted: event Production.ShowCompleted is {
        tell showCompleted to repository ProductionContext.ProductionRepository
      }
      on productionCancelled: event Production.ProductionCancelled is {
        tell productionCancelled to repository ProductionContext.ProductionRepository
      }
    } with {
      briefly "Maintains production metrics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Production metrics"
    described as {
      |Production management analytics.
    }
  }
  processor ProductionEventSource as source is {
    outlet ProductionEvents is type ProductionEvent
    handler ProductionEventEmitter is {
      on init is {
        tell command InitializeProduction to entity ProductionContext.Production
      }
      on other is {
        error "Unexpected message for source ProductionEventSource"
      }
      on productionCreated: event Production.ProductionCreated is {
        send productionCreated to outlet ProductionEvents
      }
      on showCompleted: event Production.ShowCompleted is {
        send showCompleted to outlet ProductionEvents
      }
      on productionCancelled: event Production.ProductionCancelled is {
        send productionCancelled to outlet ProductionEvents
      }
    } with {
      briefly "Production event emitter"
      described as {
        |Emits production lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Production event source"
    described as {
      |Publishes production entity events for streaming.
    }
  }
  processor ProductionEventSink as sink is {
    inlet IncomingProductionEvents is type ProductionEvent    handler ProductionEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink ProductionEventSink"
      }
      on productionCreated: event Production.ProductionCreated is {
        tell productionCreated to repository ProductionContext.ProductionRepository
      }
      on productionCancelled: event Production.ProductionCancelled is {
        tell productionCancelled to repository ProductionContext.ProductionRepository
      }
    } with {
      briefly "Production event receiver"
      described as {
        |Receives production events and persists them.
      }
    }
  } with {
    briefly "Production event sink"
    described as {
      |Receives production events from the streaming topology.
    }
  }
  connector ProductionEventPipeline is from outlet ProductionContext.ProductionEventSource.ProductionEvents to inlet ProductionContext.ProductionEventSink.IncomingProductionEvents with {
    briefly "Production event pipeline"
    described as {
      |Wires production events from source to sink.
    }
  }
  processor ProductionEventSplit as split is {
    inlet ProductionEventSplitIn is type ProductionEvent    outlet ProductionEventSplitToProductionRepository is type ProductionEvent
    outlet ProductionEventSplitToProductionMetrics is type ProductionEvent
    handler ProductionEventSplitHandler is {
      on productionCreated: event Production.ProductionCreated is {
        send productionCreated to outlet ProductionEventSplitToProductionRepository
        send productionCreated to outlet ProductionEventSplitToProductionMetrics
        tell productionCreated to entity ProductionContext.Production
      }
      on crewAssigned: event Production.CrewAssigned is {
        send crewAssigned to outlet ProductionEventSplitToProductionRepository
        send crewAssigned to outlet ProductionEventSplitToProductionMetrics
        tell crewAssigned to entity ProductionContext.Production
      }
      on equipmentAllocated: event Production.EquipmentAllocated is {
        send equipmentAllocated to outlet ProductionEventSplitToProductionRepository
        send equipmentAllocated to outlet ProductionEventSplitToProductionMetrics
        tell equipmentAllocated to entity ProductionContext.Production
      }
      on rehearsalScheduled: event Production.RehearsalScheduled is {
        send rehearsalScheduled to outlet ProductionEventSplitToProductionRepository
        send rehearsalScheduled to outlet ProductionEventSplitToProductionMetrics
        tell rehearsalScheduled to entity ProductionContext.Production
      }
      on rehearsalCompleted: event Production.RehearsalCompleted is {
        send rehearsalCompleted to outlet ProductionEventSplitToProductionRepository
        send rehearsalCompleted to outlet ProductionEventSplitToProductionMetrics
        tell rehearsalCompleted to entity ProductionContext.Production
      }
      on loadInStarted: event Production.LoadInStarted is {
        send loadInStarted to outlet ProductionEventSplitToProductionRepository
        send loadInStarted to outlet ProductionEventSplitToProductionMetrics
        tell loadInStarted to entity ProductionContext.Production
      }
      on cueSheetAdded: event Production.CueSheetAdded is {
        send cueSheetAdded to outlet ProductionEventSplitToProductionRepository
        send cueSheetAdded to outlet ProductionEventSplitToProductionMetrics
        tell cueSheetAdded to entity ProductionContext.Production
      }
      on showStarted: event Production.ShowStarted is {
        send showStarted to outlet ProductionEventSplitToProductionRepository
        send showStarted to outlet ProductionEventSplitToProductionMetrics
        tell showStarted to entity ProductionContext.Production
      }
      on showCompleted: event Production.ShowCompleted is {
        send showCompleted to outlet ProductionEventSplitToProductionRepository
        send showCompleted to outlet ProductionEventSplitToProductionMetrics
        tell showCompleted to entity ProductionContext.Production
      }
      on productionCancelled: event Production.ProductionCancelled is {
        send productionCancelled to outlet ProductionEventSplitToProductionRepository
        send productionCancelled to outlet ProductionEventSplitToProductionMetrics
        tell productionCancelled to entity ProductionContext.Production
      }
      on other is {
        error "Unexpected message for processor ProductionEventSplit"
      }
    } with {
      briefly "Production event fan-out handler"
      described as {
        |Delivers each Production event to all of its consumers.
      }
    }
  } with {
    briefly "Production event fan-out"
    described as {
      |Fans Production events out to the repository and projectors.
    }
  }
  connector 'ProductionEvent Stream' is from outlet ProductionContext.Production.ProductionEvents2 to inlet ProductionContext.ProductionEventSplit.ProductionEventSplitIn with {
    briefly "Production events, fanned out to storage and read models"
  }
  connector 'ProductionEvent Storage' is from outlet ProductionContext.ProductionEventSplit.ProductionEventSplitToProductionRepository to inlet ProductionContext.ProductionRepository.ProductionRepositoryFromProduction with {
    briefly "Production events on their way to storage"
  }
  connector 'ProductionMetrics Feed' is from outlet ProductionContext.ProductionEventSplit.ProductionEventSplitToProductionMetrics to inlet ProductionContext.ProductionMetrics.ProductionMetricsFromProduction with {
    briefly "Production events feeding the ProductionMetrics projection"
  }
  connector 'ProductionMetrics Storage' is from outlet ProductionContext.ProductionMetrics.ProductionMetricsOut to inlet ProductionContext.ProductionRepository.ProductionRepositoryFromProductionMetrics with {
    briefly "The ProductionMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for production management"
  described as {
    |Live event production management context.
  }
}
