// Production Management - Production Context
context ProductionContext is {
  include "types.riddl"
  include "Production.riddl"
  repository ProductionRepository is {
    inlet ProductionRepositoryFromProduction is type ProductionEvent
    inlet ProductionRepositoryFromProductionMetrics is type ProductionEvent
    outlet ProductionRepositoryResponses is type Production.ProductionResult
    schema ProductionData is relational
      of productions as type Production
        index on field Production.productionId
        index on field Production.productionInfo.venueId
        index on field Production.status

    handler ProductionPersistence is {
      on command Production.CreateProduction is {
        tell event Production.ProductionCreated to entity
          ProductionContext.Production
      }
      on command Production.AssignCrew is {
        tell event Production.CrewAssigned to entity
          ProductionContext.Production
      }
      on command Production.AllocateEquipment is {
        tell event Production.EquipmentAllocated to entity
          ProductionContext.Production
      }
      on command Production.ScheduleRehearsal is {
        tell event Production.RehearsalScheduled to entity
          ProductionContext.Production
      }
      on command Production.CompleteRehearsal is {
        tell event Production.RehearsalCompleted to entity
          ProductionContext.Production
      }
      on command Production.CompleteShow is {
        tell event Production.ShowCompleted to entity
          ProductionContext.Production
      }
    } with {
      briefly "Persists production commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Production data persistence"
    described as {
      |Persistent storage for productions.
    }
  }
  projector ProductionMetrics is {
    inlet ProductionMetricsFromProduction is type ProductionEvent
    outlet ProductionMetricsOut is type ProductionEvent
    updates repository ProductionContext.ProductionRepository
    record EventMetrics is  {
      productionsCreated: Natural with {
        briefly "Created"
        described as {
          |Productions created.
        }
      }
      productionsCompleted: Natural with {
        briefly "Completed"
        described as {
          |Productions completed.
        }
      }
      productionsCancelled: Natural with {
        briefly "Cancelled"
        described as {
          |Productions cancelled.
        }
      }
      totalAttendance: Natural with {
        briefly "Attendance"
        described as {
          |Total audience attendance.
        }
      }
      averageCrewSize: Decimal(8,2) with {
        briefly "Avg crew"
        described as {
          |Average crew size per production.
        }
      }
    } with {
      briefly "Event metrics"
      described as {
        |Production event metrics.
      }
    }
    handler MetricsHandler is {
      on event Production.ProductionCreated is {
        tell event Production.ProductionCreated to repository
          ProductionContext.ProductionRepository
      }
      on event Production.ShowCompleted is {
        tell event Production.ShowCompleted to repository
          ProductionContext.ProductionRepository
      }
      on event Production.ProductionCancelled is {
        tell event Production.ProductionCancelled to repository
          ProductionContext.ProductionRepository
      }
    } with {
      briefly "Maintains production metrics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Production metrics"
    described as {
      |Production management analytics.
    }
  }
  processor ProductionEventSource as source is {
    outlet ProductionEvents is type ProductionEvent
    handler ProductionEventEmitter is {
      on init is {
        tell command InitializeProduction to entity
          ProductionContext.Production
      }
      on other is {
        error "Unexpected message for source ProductionEventSource"
      }
      on event Production.ProductionCreated is {
        send event Production.ProductionCreated to outlet ProductionEvents
      }
      on event Production.ShowCompleted is {
        send event Production.ShowCompleted to outlet ProductionEvents
      }
      on event Production.ProductionCancelled is {
        send event Production.ProductionCancelled to outlet ProductionEvents
      }
    } with {
      briefly "Production event emitter"
      described as {
        |Emits production lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Production event source"
    described as {
      |Publishes production entity events for streaming.
    }
  }
  processor ProductionEventSink as sink is {
    inlet IncomingProductionEvents is type ProductionEvent
    handler ProductionEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink ProductionEventSink"
      }
      on event Production.ProductionCreated is {
        tell event Production.ProductionCreated to repository
          ProductionContext.ProductionRepository
      }
      on event Production.ProductionCancelled is {
        tell event Production.ProductionCancelled to repository
          ProductionContext.ProductionRepository
      }
    } with {
      briefly "Production event receiver"
      described as {
        |Receives production events and persists them.
      }
    }
  } with {
    briefly "Production event sink"
    described as {
      |Receives production events from the streaming topology.
    }
  }
  connector ProductionEventPipeline is {
    from outlet ProductionContext.ProductionEventSource.ProductionEvents
      to inlet ProductionContext.ProductionEventSink.IncomingProductionEvents
  } with {
    briefly "Production event pipeline"
    described as {
      |Wires production events from source to sink.
    }
  }
  processor ProductionEventSplit is {
    inlet ProductionEventSplitIn is type ProductionEvent
    outlet ProductionEventSplitToProductionRepository is type ProductionEvent
    outlet ProductionEventSplitToProductionMetrics is type ProductionEvent
    handler ProductionEventSplitHandler is {
      on event Production.ProductionCreated is {
        send event Production.ProductionCreated to outlet ProductionEventSplitToProductionRepository
        send event Production.ProductionCreated to outlet ProductionEventSplitToProductionMetrics
        tell event Production.ProductionCreated to entity ProductionContext.Production
      }
      on event Production.CrewAssigned is {
        send event Production.CrewAssigned to outlet ProductionEventSplitToProductionRepository
        send event Production.CrewAssigned to outlet ProductionEventSplitToProductionMetrics
        tell event Production.CrewAssigned to entity ProductionContext.Production
      }
      on event Production.EquipmentAllocated is {
        send event Production.EquipmentAllocated to outlet ProductionEventSplitToProductionRepository
        send event Production.EquipmentAllocated to outlet ProductionEventSplitToProductionMetrics
        tell event Production.EquipmentAllocated to entity ProductionContext.Production
      }
      on event Production.RehearsalScheduled is {
        send event Production.RehearsalScheduled to outlet ProductionEventSplitToProductionRepository
        send event Production.RehearsalScheduled to outlet ProductionEventSplitToProductionMetrics
        tell event Production.RehearsalScheduled to entity ProductionContext.Production
      }
      on event Production.RehearsalCompleted is {
        send event Production.RehearsalCompleted to outlet ProductionEventSplitToProductionRepository
        send event Production.RehearsalCompleted to outlet ProductionEventSplitToProductionMetrics
        tell event Production.RehearsalCompleted to entity ProductionContext.Production
      }
      on event Production.LoadInStarted is {
        send event Production.LoadInStarted to outlet ProductionEventSplitToProductionRepository
        send event Production.LoadInStarted to outlet ProductionEventSplitToProductionMetrics
        tell event Production.LoadInStarted to entity ProductionContext.Production
      }
      on event Production.CueSheetAdded is {
        send event Production.CueSheetAdded to outlet ProductionEventSplitToProductionRepository
        send event Production.CueSheetAdded to outlet ProductionEventSplitToProductionMetrics
        tell event Production.CueSheetAdded to entity ProductionContext.Production
      }
      on event Production.ShowStarted is {
        send event Production.ShowStarted to outlet ProductionEventSplitToProductionRepository
        send event Production.ShowStarted to outlet ProductionEventSplitToProductionMetrics
        tell event Production.ShowStarted to entity ProductionContext.Production
      }
      on event Production.ShowCompleted is {
        send event Production.ShowCompleted to outlet ProductionEventSplitToProductionRepository
        send event Production.ShowCompleted to outlet ProductionEventSplitToProductionMetrics
        tell event Production.ShowCompleted to entity ProductionContext.Production
      }
      on event Production.ProductionCancelled is {
        send event Production.ProductionCancelled to outlet ProductionEventSplitToProductionRepository
        send event Production.ProductionCancelled to outlet ProductionEventSplitToProductionMetrics
        tell event Production.ProductionCancelled to entity ProductionContext.Production
      }
      on other is {
        error "Unexpected message for processor ProductionEventSplit"
      }
    } with {
      briefly "Production event fan-out handler"
      described as {
        |Delivers each Production event to all of its consumers.
      }
    }
  } with {
    briefly "Production event fan-out"
    described as {
      |Fans Production events out to the repository and projectors.
    }
  }
  connector LinkProductionToProductionEventSplit is {
    from outlet ProductionContext.Production.ProductionEvents2 to
      inlet ProductionContext.ProductionEventSplit.ProductionEventSplitIn
  } with {
    briefly "LinkProductionToProductionEventSplit"
  }
  connector LinkProductionEventSplitToProductionRepository is {
    from outlet ProductionContext.ProductionEventSplit.ProductionEventSplitToProductionRepository to
      inlet ProductionContext.ProductionRepository.ProductionRepositoryFromProduction
  } with {
    briefly "LinkProductionEventSplitToProductionRepository"
  }
  connector LinkProductionEventSplitToProductionMetrics is {
    from outlet ProductionContext.ProductionEventSplit.ProductionEventSplitToProductionMetrics to
      inlet ProductionContext.ProductionMetrics.ProductionMetricsFromProduction
  } with {
    briefly "LinkProductionEventSplitToProductionMetrics"
  }
  connector LinkProductionMetricsToProductionRepository is {
    from outlet ProductionContext.ProductionMetrics.ProductionMetricsOut to
      inlet ProductionContext.ProductionRepository.ProductionRepositoryFromProductionMetrics
  } with {
    briefly "LinkProductionMetricsToProductionRepository"
  }
} with {
  briefly "Bounded context for production management"
  described as {
    |Live event production management context.
  }
}
