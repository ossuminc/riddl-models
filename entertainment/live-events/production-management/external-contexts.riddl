// Production Management - External Contexts
external context VenueSystem as split is {
  outlet VenueSystemRepliesOut is result VenueDetails
 with {
    briefly "What this service answers, on its way back"
  }
  outlet VenueSystemEventsOut is event VenueReserved
 with {
    briefly "What this service tells the model, unasked"
  }
  type VenueSystemRequest is one of {
    ReserveVenue or GetVenueDetails
  } with {
    briefly "Everything this service can be asked"
  }
  inlet VenueSystemRequests is type VenueSystemRequest with {
    briefly "What this context asks the service to send"
  }
  handler VenueSystemBoundary is {
    on query GetVenueDetails is {
      let askAnswer: type VenueDetails = prompt("look up what GetVenueDetails asks for")
      reply askAnswer
    }
    on command ReserveVenue is {
      let venueReserved: type VenueReserved = prompt("the venue reserved this produces")
      send venueReserved to outlet VenueSystem.VenueSystemEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context VenueSystem"
    }
  } with {
    briefly "VenueSystem boundary"
  }
  query GetVenueDetails replies result VenueDetails is {
    venueId: VenueId with {
      briefly "Venue"
      described as {
        |Venue identifier.
      }
    }
  } with {
    briefly "Get venue details"
    described as {
      |Retrieves venue information.
    }
  }
  result VenueDetails is {
    venueId: VenueId with {
      briefly "Venue"
      described as {
        |Venue identifier.
      }
    }
    venueName: String(3,200) with {
      briefly "Name"
      described as {
        |Venue name.
      }
    }
    capacity: Natural with {
      briefly "Capacity"
      described as {
        |Venue capacity.
      }
    }
    stageSpecs: String(3,500) with {
      briefly "Stage specs"
      described as {
        |Stage specifications.
      }
    }
    availableDates: Date+ with {
      briefly "Dates"
      described as {
        |Available dates.
      }
    }
  } with {
    briefly "Venue details"
    described as {
      |Venue information.
    }
  }
  command ReserveVenue is {
    venueId: VenueId with {
      briefly "Venue"
      described as {
        |Venue identifier.
      }
    }
    productionId: ProductionId with {
      briefly "Production"
      described as {
        |Production identifier.
      }
    }
    eventDate: Date with {
      briefly "Date"
      described as {
        |Event date.
      }
    }
    loadInDate: Date with {
      briefly "Load-in"
      described as {
        |Load-in date.
      }
    }
  } with {
    briefly "Reserve venue"
    described as {
      |Reserves the venue for an event.
    }
  }
  event VenueReserved is {
    venueId: VenueId with {
      briefly "Venue"
      described as {
        |Venue identifier.
      }
    }
    productionId: ProductionId with {
      briefly "Production"
      described as {
        |Production identifier.
      }
    }
    reservedAt: TimeStamp with {
      briefly "Reserved"
      described as {
        |Reservation time.
      }
    }
  } with {
    briefly "Venue reserved"
    described as {
      |Emitted when venue is reserved.
    }
  }
} with {
  briefly "External venue system"
  described as {
    |Venue management and booking system.
  }
}
external context CrewManagement as split is {
  outlet CrewManagementRepliesOut is result AvailableCrew
 with {
    briefly "What this service answers, on its way back"
  }
  outlet CrewManagementEventsOut is event CrewMemberBooked
 with {
    briefly "What this service tells the model, unasked"
  }
  type CrewManagementRequest is one of {
    BookCrewMember or GetAvailableCrew
  } with {
    briefly "Everything this service can be asked"
  }
  inlet CrewManagementRequests is type CrewManagementRequest with {
    briefly "What this context asks the service to send"
  }
  handler CrewManagementBoundary is {
    on query GetAvailableCrew is {
      let roster: type AvailableCrew = prompt("look up the crew free for the role and dates GetAvailableCrew names")
      reply roster
    }
    on command BookCrewMember is {
      let crewMemberBooked: type CrewMemberBooked = prompt("the crew member booked this produces")
      send crewMemberBooked to outlet CrewManagement.CrewManagementEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context CrewManagement"
    }
  } with {
    briefly "CrewManagement boundary"
  }
  query GetAvailableCrew replies result AvailableCrew is {
    role: CrewRole with {
      briefly "Role"
      described as {
        |Crew role needed.
      }
    }
    startDate: Date with {
      briefly "Start"
      described as {
        |Start date.
      }
    }
    endDate: Date with {
      briefly "End"
      described as {
        |End date.
      }
    }
  } with {
    briefly "Get available crew"
    described as {
      |Finds available crew members by role.
    }
  }
  result AvailableCrew is {
    crewMembers: CrewAssignment+ with {
      briefly "Crew"
      described as {
        |Available crew members.
      }
    }
  } with {
    briefly "Available crew"
    described as {
      |List of available crew members.
    }
  }
  command BookCrewMember is {
    crewMemberId: CrewMemberId with {
      briefly "Crew member"
      described as {
        |Crew member identifier.
      }
    }
    productionId: ProductionId with {
      briefly "Production"
      described as {
        |Production identifier.
      }
    }
    role: CrewRole with {
      briefly "Role"
      described as {
        |Assigned role.
      }
    }
    callTime: TimeStamp with {
      briefly "Call time"
      described as {
        |Scheduled arrival.
      }
    }
    endTime: TimeStamp with {
      briefly "End time"
      described as {
        |Scheduled end.
      }
    }
  } with {
    briefly "Book crew member"
    described as {
      |Books a crew member for a production.
    }
  }
  event CrewMemberBooked is {
    crewMemberId: CrewMemberId with {
      briefly "Crew member"
      described as {
        |Crew member identifier.
      }
    }
    productionId: ProductionId with {
      briefly "Production"
      described as {
        |Production identifier.
      }
    }
    bookedAt: TimeStamp with {
      briefly "Booked"
      described as {
        |Booking time.
      }
    }
  } with {
    briefly "Crew member booked"
    described as {
      |Emitted when crew member is booked.
    }
  }
} with {
  briefly "External crew management"
  described as {
    |Crew scheduling and management system.
  }
}
