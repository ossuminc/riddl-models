// Ticket Sales - LiveEvent Entity
// The show tickets are sold for. Named LiveEvent because `event` is a keyword.
event-sourced entity LiveEvent as flow is {
  type LiveEventEvent is one of {
    LiveEvent.EventCreated or LiveEvent.TicketsReleased
  } with {
    briefly "LiveEvent event alternation"
    described as {
      |Events published by the LiveEvent entity.
    }
  }
  inlet LiveEventCommands is command LiveEvent.RecordRelease
  outlet LiveEventEvents is type LiveEventEvent
  command RecordRelease yields event TicketsReleased is {
    eventId: EventId with {
      briefly "Event ID"
      described as {
        |The show whose tickets were released.
      }
    }
    tierName: String(1,50) with {
      briefly "Tier name"
      described as {
        |The pricing tier released.
      }
    }
    quantity: Natural with {
      briefly "Quantity"
      described as {
        |How many tickets were released.
      }
    }
  } with {
    briefly "Record a ticket release"
    described as {
      |Tells the show that the context has created tickets for one of its
      |tiers, so the release can be announced.
    }
  }
  event EventCreated is {
    eventId: EventId with {
      briefly "Event identifier"
      described as {
        |The unique identifier of the created event.
      }
    }
    name: String(1,200) with {
      briefly "Event name"
      described as {
        |Name of the event.
      }
    }
    venueId: VenueId with {
      briefly "Venue"
      described as {
        |Where the event will be held.
      }
    }
    venueName: String(1,200) with {
      briefly "Venue name"
      described as {
        |Name of the venue.
      }
    }
    eventDate: DateTime with {
      briefly "Event date"
      described as {
        |When the event occurs.
      }
    }
    totalCapacity: Natural with {
      briefly "Capacity"
      described as {
        |Total ticket capacity for the event.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |When the event was created.
      }
    }
  } with {
    briefly "A new event was created"
    described as {
      |Emitted when an event promoter creates a new event.
    }
  }
  event TicketsReleased is {
    eventId: EventId with {
      briefly "Event identifier"
      described as {
        |The event for which tickets were released.
      }
    }
    tierName: String(1,50) with {
      briefly "Tier"
      described as {
        |Pricing tier that was released.
      }
    }
    quantity: Natural with {
      briefly "Quantity"
      described as {
        |Number of tickets released.
      }
    }
    releasedAt: TimeStamp with {
      briefly "Released"
      described as {
        |When tickets were released.
      }
    }
  } with {
    briefly "Tickets were released for sale"
    described as {
      |Emitted when tickets become available for purchase.
    }
  }
  record ScheduledEventData is {
    eventId: EventId with {
      briefly "Event ID"
      described as {
        |Which show this is.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |The show's name.
      }
    }
    description: String(1,2000) with {
      briefly "Description"
      described as {
        |What the show is.
      }
    }
    venueId: VenueId with {
      briefly "Venue"
      described as {
        |Where the show is held.
      }
    }
    venueName: String(1,200) with {
      briefly "Venue name"
      described as {
        |The venue's name.
      }
    }
    eventDate: DateTime with {
      briefly "Event date"
      described as {
        |When the show starts.
      }
    }
    doorsOpen: DateTime with {
      briefly "Doors open"
      described as {
        |When the audience may enter.
      }
    }
    category: String(1,100) with {
      briefly "Category"
      described as {
        |The kind of show.
      }
    }
    ageRestriction: String(1,50)? with {
      briefly "Age restriction"
      described as {
        |Who may attend, if restricted.
      }
    }
    refundPolicy: String(1,500) with {
      briefly "Refund policy"
      described as {
        |Terms on which tickets are refunded.
      }
    }
    pricingTiers: PricingTier+ with {
      briefly "Pricing tiers"
      described as {
        |The tiers tickets are sold in.
      }
    }
    totalCapacity: Natural with {
      briefly "Total capacity"
      described as {
        |How many tickets the show can sell across all tiers.
      }
    }
    lastReleasedAt: TimeStamp? with {
      briefly "Last released at"
      described as {
        |When tickets were last released for sale; empty until the first release.
      }
    }
  } with {
    briefly "Scheduled show data"
    described as {
      |What is known about a show that has been scheduled.
    }
  }
  state ScheduledState of record LiveEvent.ScheduledEventData with {
    briefly "Scheduled state"
    described as {
      |The show is on the calendar and its tickets may be released and sold.
    }
  }
  initial handler LiveEventHandler is {
    on init(name: String(1,200), description: String(1,2000), venueId: type VenueId, venueName: String(1,200), eventDate: DateTime, doorsOpen: DateTime, category: String(1,100), ageRestriction: String(1,50)?, refundPolicy: String(1,500), pricingTiers: type PricingTier+, totalCapacity: Natural, createdAt: TimeStamp) is {
      morph entity LiveEvent to state LiveEvent.ScheduledState with record LiveEvent.ScheduledEventData(eventId = self.id, name = name, description = description, venueId = venueId, venueName = venueName, eventDate = eventDate, doorsOpen = doorsOpen, category = category, ageRestriction = ageRestriction, refundPolicy = refundPolicy, pricingTiers = pricingTiers, totalCapacity = totalCapacity, lastReleasedAt = empty)
      send event EventCreated(eventId = self.id, name = name, venueId = venueId, venueName = venueName, eventDate = eventDate, totalCapacity = totalCapacity, createdAt = createdAt) to outlet TicketContext.LiveEvent.LiveEventEvents
    }
    on recordRelease: command RecordRelease is {
      yield event TicketsReleased(eventId = recordRelease.eventId, tierName = recordRelease.tierName, quantity = recordRelease.quantity, releasedAt = system.now)
    }
    on ticketsReleased: event TicketsReleased is {
      set field LiveEvent.ScheduledState.lastReleasedAt to ticketsReleased.releasedAt
    }
  } with {
    briefly "Processes show commands"
    described as {
      |Records ticket releases against the show.
    }
  }
} with {
  briefly "A show that tickets are sold for"
  described as {
    | A scheduled live performance at a venue. The context creates one when
    | a show is scheduled, and the tickets released for it name it by id.
  }
}
