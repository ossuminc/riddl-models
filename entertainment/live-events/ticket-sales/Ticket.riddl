// Ticket Sales - Ticket Entity
// The primary aggregate for ticket lifecycle management
event-sourced entity Ticket as flow is {
  type TicketCommand is one of {
    Ticket.PurchaseTicket or Ticket.ReserveTicket or Ticket.TransferTicket or Ticket.RefundTicket or Ticket.CancelReservation or Ticket.ScanTicket
  } with {
    briefly "Ticket command alternation"
    described as {
      |Commands accepted by the Ticket entity.
    }
  }
  inlet TicketCommands is type TicketCommand
  outlet TicketEvents2 is type TicketEvent
  // Commands
  command PurchaseTicket yields event TicketPurchased is {
    ticketId: TicketId with {
      briefly "Ticket identifier"
      described as {
        |The ticket being purchased.
      }
    }
    buyerId: BuyerId with {
      briefly "Buyer"
      described as {
        |The person purchasing the ticket.
      }
    }
    paymentTransactionId: String(1,100) with {
      briefly "Payment transaction"
      described as {
        |Transaction ID from payment processor.
      }
    }
    amountPaid: Money with {
      briefly "Amount paid"
      described as {
        |Total amount paid including fees.
      }
    }
  } with {
    briefly "Complete ticket purchase after payment"
    described as {
      |Finalizes ticket purchase and assigns ownership to buyer.
    }
  }
  command ReserveTicket yields event TicketReserved is {
    ticketId: TicketId with {
      briefly "Ticket identifier"
      described as {
        |The ticket to reserve temporarily.
      }
    }
    buyerId: BuyerId with {
      briefly "Buyer"
      described as {
        |The buyer requesting the reservation.
      }
    }
    expiresAt: TimeStamp with {
      briefly "Expiration"
      described as {
        |When the reservation expires if not purchased.
      }
    }
  } with {
    briefly "Temporarily hold a ticket during checkout"
    described as {
      |Reserves a ticket for a buyer while they complete checkout.
    }
  }
  command TransferTicket yields event TicketTransferred is {
    ticketId: TicketId with {
      briefly "Ticket identifier"
      described as {
        |The ticket being transferred.
      }
    }
    fromBuyerId: BuyerId with {
      briefly "Current owner"
      described as {
        |The buyer currently holding the ticket.
      }
    }
    toBuyerId: BuyerId with {
      briefly "New owner"
      described as {
        |The buyer receiving the ticket.
      }
    }
    recipientEmail: String(1,200) with {
      briefly "Recipient email"
      described as {
        |Email address to notify the recipient.
      }
    }
  } with {
    briefly "Transfer ticket ownership to another buyer"
    described as {
      |Changes ticket ownership from current holder to a new buyer.
    }
  }
  command RefundTicket yields event TicketRefunded is {
    ticketId: TicketId with {
      briefly "Ticket identifier"
      described as {
        |The ticket being refunded.
      }
    }
    buyerId: BuyerId with {
      briefly "Buyer"
      described as {
        |The buyer requesting the refund.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason for requesting the refund.
      }
    }
    refundAmount: Money with {
      briefly "Refund amount"
      described as {
        |The amount to refund, as the requester determined it by applying
        |the show's refund policy.
      }
    }
  } with {
    briefly "Process a refund for a purchased ticket"
    described as {
      |Refunds the ticket and returns it to available inventory.
    }
  }
  command CancelReservation yields event ReservationCancelled is {
    ticketId: TicketId with {
      briefly "Ticket identifier"
      described as {
        |The reserved ticket to release.
      }
    }
  } with {
    briefly "Cancel an expired or abandoned reservation"
    described as {
      |Returns a reserved ticket to available inventory.
    }
  }
  command ScanTicket yields event TicketScanned is {
    ticketId: TicketId with {
      briefly "Ticket identifier"
      described as {
        |The ticket being scanned for entry.
      }
    }
    scannedAt: TimeStamp with {
      briefly "Scan time"
      described as {
        |When the ticket was scanned.
      }
    }
    gateId: String(1,50) with {
      briefly "Gate"
      described as {
        |Which gate or entrance scanned the ticket.
      }
    }
  } with {
    briefly "Scan ticket for venue entry"
    described as {
      |Marks ticket as used when scanned at venue entrance.
    }
  }
  // Events
  event TicketPurchased is {
    ticketId: TicketId with {
      briefly "Ticket identifier"
      described as {
        |The purchased ticket.
      }
    }
    eventId: EventId with {
      briefly "Event"
      described as {
        |The event the ticket is for.
      }
    }
    buyerId: BuyerId with {
      briefly "Buyer"
      described as {
        |Who purchased the ticket.
      }
    }
    seatId: SeatId with {
      briefly "Seat"
      described as {
        |The assigned seat.
      }
    }
    section: String(1,50) with {
      briefly "Section"
      described as {
        |Venue section.
      }
    }
    pricingTier: String(1,50) with {
      briefly "Tier"
      described as {
        |Pricing tier.
      }
    }
    amountPaid: Money with {
      briefly "Amount"
      described as {
        |Total amount paid.
      }
    }
    purchasedAt: TimeStamp with {
      briefly "Purchased"
      described as {
        |When purchased.
      }
    }
    paymentTransactionId: String(1,100) with {
      briefly "Payment transaction id"
    }
  } with {
    briefly "A ticket was purchased"
    described as {
      |Emitted when a buyer successfully purchases a ticket.
    }
  }
  event TicketReserved is {
    ticketId: TicketId with {
      briefly "Ticket identifier"
      described as {
        |The reserved ticket.
      }
    }
    buyerId: BuyerId with {
      briefly "Buyer"
      described as {
        |Who reserved the ticket.
      }
    }
    expiresAt: TimeStamp with {
      briefly "Expires"
      described as {
        |When the reservation expires.
      }
    }
    reservedAt: TimeStamp with {
      briefly "Reserved"
      described as {
        |When reserved.
      }
    }
  } with {
    briefly "A ticket was temporarily reserved"
    described as {
      |Emitted when a ticket is held for checkout.
    }
  }
  event TicketTransferred is {
    ticketId: TicketId with {
      briefly "Ticket identifier"
      described as {
        |The transferred ticket.
      }
    }
    eventId: EventId with {
      briefly "Event"
      described as {
        |The event the ticket is for.
      }
    }
    fromBuyerId: BuyerId with {
      briefly "From"
      described as {
        |Previous owner.
      }
    }
    toBuyerId: BuyerId with {
      briefly "To"
      described as {
        |New owner.
      }
    }
    transferredAt: TimeStamp with {
      briefly "Transferred"
      described as {
        |When transferred.
      }
    }
  } with {
    briefly "A ticket was transferred to a new owner"
    described as {
      |Emitted when ticket ownership changes.
    }
  }
  event TicketRefunded is {
    ticketId: TicketId with {
      briefly "Ticket identifier"
      described as {
        |The refunded ticket.
      }
    }
    eventId: EventId with {
      briefly "Event"
      described as {
        |The event the ticket was for.
      }
    }
    buyerId: BuyerId with {
      briefly "Buyer"
      described as {
        |Who received the refund.
      }
    }
    refundAmount: Money with {
      briefly "Amount"
      described as {
        |Amount refunded.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Refund reason.
      }
    }
    refundedAt: TimeStamp with {
      briefly "Refunded"
      described as {
        |When refunded.
      }
    }
  } with {
    briefly "A ticket was refunded"
    described as {
      |Emitted when a ticket purchase is refunded.
    }
  }
  event ReservationCancelled is {
    ticketId: TicketId with {
      briefly "Ticket identifier"
      described as {
        |The ticket whose reservation was cancelled.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |When the reservation was cancelled.
      }
    }
  } with {
    briefly "A ticket reservation was cancelled"
    described as {
      |Emitted when a reservation expires or is abandoned.
    }
  }
  event TicketScanned is {
    ticketId: TicketId with {
      briefly "Ticket identifier"
      described as {
        |The scanned ticket.
      }
    }
    eventId: EventId with {
      briefly "Event"
      described as {
        |The event.
      }
    }
    buyerId: BuyerId with {
      briefly "Holder"
      described as {
        |The ticket holder.
      }
    }
    gateId: String(1,50) with {
      briefly "Gate"
      described as {
        |Entry gate.
      }
    }
    scannedAt: TimeStamp with {
      briefly "Scanned"
      described as {
        |When scanned.
      }
    }
  } with {
    briefly "A ticket was scanned for entry"
    described as {
      |Emitted when a ticket is used for venue admission.
    }
  }
  // State Records
  record AvailableTicketData is {
    ticketId: TicketId with {
      briefly "Ticket ID"
      described as {
        |Ticket identifier.
      }
    }
    eventId: EventId with {
      briefly "Event ID"
      described as {
        |Event reference.
      }
    }
    seatId: SeatId with {
      briefly "Seat ID"
      described as {
        |Seat assignment.
      }
    }
    section: String(1,50) with {
      briefly "Section"
      described as {
        |Venue section.
      }
    }
    row: String(1,20)? with {
      briefly "Row"
      described as {
        |Row designation.
      }
    }
    seatNumber: String(1,20)? with {
      briefly "Seat"
      described as {
        |Seat number.
      }
    }
    pricingTier: String(1,50) with {
      briefly "Tier"
      described as {
        |Pricing tier.
      }
    }
    faceValue: Money with {
      briefly "Price"
      described as {
        |Face value price.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |When created.
      }
    }
    releasedAt: TimeStamp? with {
      briefly "Released at"
    }
  } with {
    briefly "Ticket data when available for sale"
    described as {
      |State data for a ticket that is available for purchase.
    }
  }
  record ReservedTicketData is {
    ticketId: TicketId with {
      briefly "Ticket ID"
      described as {
        |Ticket identifier.
      }
    }
    eventId: EventId with {
      briefly "Event ID"
      described as {
        |Event reference.
      }
    }
    seatId: SeatId with {
      briefly "Seat ID"
      described as {
        |Seat assignment.
      }
    }
    section: String(1,50) with {
      briefly "Section"
      described as {
        |Venue section.
      }
    }
    row: String(1,20)? with {
      briefly "Row"
      described as {
        |Row designation.
      }
    }
    seatNumber: String(1,20)? with {
      briefly "Seat"
      described as {
        |Seat number.
      }
    }
    pricingTier: String(1,50) with {
      briefly "Tier"
      described as {
        |Pricing tier.
      }
    }
    faceValue: Money with {
      briefly "Price"
      described as {
        |Face value price.
      }
    }
    buyerId: BuyerId with {
      briefly "Buyer"
      described as {
        |Buyer holding reservation.
      }
    }
    reservedAt: TimeStamp with {
      briefly "Reserved"
      described as {
        |When reserved.
      }
    }
    expiresAt: TimeStamp with {
      briefly "Expires"
      described as {
        |Reservation expiration.
      }
    }
  } with {
    briefly "Ticket data when temporarily reserved"
    described as {
      |State data for a ticket held during checkout.
    }
  }
  record SoldTicketData is {
    ticketId: TicketId with {
      briefly "Ticket ID"
      described as {
        |Ticket identifier.
      }
    }
    eventId: EventId with {
      briefly "Event ID"
      described as {
        |Event reference.
      }
    }
    seatId: SeatId with {
      briefly "Seat ID"
      described as {
        |Seat assignment.
      }
    }
    section: String(1,50) with {
      briefly "Section"
      described as {
        |Venue section.
      }
    }
    row: String(1,20)? with {
      briefly "Row"
      described as {
        |Row designation.
      }
    }
    seatNumber: String(1,20)? with {
      briefly "Seat"
      described as {
        |Seat number.
      }
    }
    pricingTier: String(1,50) with {
      briefly "Tier"
      described as {
        |Pricing tier.
      }
    }
    faceValue: Money with {
      briefly "Price"
      described as {
        |Face value price.
      }
    }
    buyerId: BuyerId with {
      briefly "Owner"
      described as {
        |Current ticket owner.
      }
    }
    amountPaid: Money with {
      briefly "Paid"
      described as {
        |Amount paid for ticket.
      }
    }
    paymentTransactionId: String(1,100) with {
      briefly "Transaction"
      described as {
        |Payment transaction ID.
      }
    }
    purchasedAt: TimeStamp with {
      briefly "Purchased"
      described as {
        |When purchased.
      }
    }
    transferHistory: TransferRecord+ with {
      briefly "Transfers"
      described as {
        |Transfer history.
      }
    }
  } with {
    briefly "Ticket data when sold to a buyer"
    described as {
      |State data for a ticket that has been purchased.
    }
  }
  record RefundedTicketData is {
    ticketId: TicketId with {
      briefly "Ticket ID"
      described as {
        |Ticket identifier.
      }
    }
    eventId: EventId with {
      briefly "Event ID"
      described as {
        |Event reference.
      }
    }
    seatId: SeatId with {
      briefly "Seat ID"
      described as {
        |Seat assignment.
      }
    }
    section: String(1,50) with {
      briefly "Section"
      described as {
        |Venue section.
      }
    }
    pricingTier: String(1,50) with {
      briefly "Tier"
      described as {
        |Pricing tier.
      }
    }
    faceValue: Money with {
      briefly "Price"
      described as {
        |Face value price.
      }
    }
    originalBuyerId: BuyerId with {
      briefly "Original buyer"
      described as {
        |Who was refunded.
      }
    }
    refundAmount: Money with {
      briefly "Refund"
      described as {
        |Amount refunded.
      }
    }
    refundReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Refund reason.
      }
    }
    refundedAt: TimeStamp with {
      briefly "Refunded"
      described as {
        |When refunded.
      }
    }
  } with {
    briefly "Ticket data after refund"
    described as {
      |State data for a ticket that was refunded.
    }
  }
  record UsedTicketData is {
    ticketId: TicketId with {
      briefly "Ticket ID"
      described as {
        |Ticket identifier.
      }
    }
    eventId: EventId with {
      briefly "Event ID"
      described as {
        |Event reference.
      }
    }
    seatId: SeatId with {
      briefly "Seat ID"
      described as {
        |Seat assignment.
      }
    }
    section: String(1,50) with {
      briefly "Section"
      described as {
        |Venue section.
      }
    }
    row: String(1,20)? with {
      briefly "Row"
      described as {
        |Row designation.
      }
    }
    seatNumber: String(1,20)? with {
      briefly "Seat"
      described as {
        |Seat number.
      }
    }
    buyerId: BuyerId with {
      briefly "Holder"
      described as {
        |Who used the ticket.
      }
    }
    gateId: String(1,50) with {
      briefly "Gate"
      described as {
        |Entry gate used.
      }
    }
    scannedAt: TimeStamp with {
      briefly "Scanned"
      described as {
        |When scanned for entry.
      }
    }
  } with {
    briefly "Ticket data after use for entry"
    described as {
      |State data for a ticket used for venue admission.
    }
  }
  query GetTicket replies result TicketResult is {
    ticketId: TicketId with {
      briefly "Ticket ID"
      described as {
        |Identifies the Ticket instance this message addresses.
      }
    }
    eventId: EventId with {
      briefly "Event ID"
      described as {
        |Event to retrieve.
      }
    }
  } with {
    briefly "Get ticket"
    described as {
      |Retrieves ticket data by identifier.
    }
  }
  result TicketResult is {
    ticketId: TicketId with {
      briefly "Ticket addressed"
      described as {
        |Which ticket this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    eventId: EventId with {
      briefly "Event ID"
      described as {
        |Event identifier.
      }
    }
  } with {
    briefly "Ticket result"
    described as {
      |Ticket data result.
    }
  }
  // States
  state AvailableState of record Ticket.AvailableTicketData with {
    briefly "Available state"
    described as {
      |Ticket is available for purchase.
    }
  }
  state ReservedState of record Ticket.ReservedTicketData with {
    briefly "Reserved state"
    described as {
      |Ticket is reserved pending purchase.
    }
  }
  state SoldState of record Ticket.SoldTicketData with {
    briefly "Sold state"
    described as {
      |Ticket has been purchased.
    }
  }
  state RefundedState of record Ticket.RefundedTicketData with {
    briefly "Refunded state"
    described as {
      |Ticket has been refunded.
    }
  }
  state UsedState of record Ticket.UsedTicketData with {
    briefly "Used state"
    described as {
      |Ticket has been used for entry.
    }
  }
  // Handler
  handler TicketHandler is {
    on init(eventId: type EventId, seatId: type SeatId, section: String(1,50), row: String(1,20)?, seatNumber: String(1,20)?, pricingTier: String(1,50), faceValue: type Money, releasedAt: TimeStamp) is {
      morph entity Ticket to state Ticket.AvailableState with record Ticket.AvailableTicketData(ticketId = self.id, eventId = eventId, seatId = seatId, section = section, row = row, seatNumber = seatNumber, pricingTier = pricingTier, faceValue = faceValue, createdAt = releasedAt, releasedAt = releasedAt)
    }
    on reservationCancelled: event ReservationCancelled is {
      morph entity Ticket to state Ticket.AvailableState with record Ticket.AvailableTicketData(ticketId = reservationCancelled.ticketId, eventId = prompt("the event id of this available ticket data"), seatId = prompt("the seat id of this available ticket data"), section = prompt("the section of this available ticket data"), row = empty, seatNumber = empty, pricingTier = prompt("the pricing tier of this available ticket data"), faceValue = prompt("the face value of this available ticket data"), createdAt = prompt("the created at of this available ticket data"), releasedAt = empty)
    }
    on ticketPurchased: event TicketPurchased is {
      morph entity Ticket to state Ticket.SoldState with record Ticket.SoldTicketData(ticketId = ticketPurchased.ticketId, buyerId = ticketPurchased.buyerId, amountPaid = ticketPurchased.amountPaid, paymentTransactionId = ticketPurchased.paymentTransactionId, eventId = prompt("the event id of this sold ticket data"), seatId = prompt("the seat id of this sold ticket data"), section = prompt("the section of this sold ticket data"), row = empty, seatNumber = empty, pricingTier = prompt("the pricing tier of this sold ticket data"), faceValue = prompt("the face value of this sold ticket data"), purchasedAt = prompt("the purchased at of this sold ticket data"), transferHistory = prompt("the transfer history of this sold ticket data"))
    }
    on ticketRefunded: event TicketRefunded is {
      morph entity Ticket to state Ticket.RefundedState with record Ticket.RefundedTicketData(ticketId = ticketRefunded.ticketId, eventId = prompt("the event id of this refunded ticket data"), seatId = prompt("the seat id of this refunded ticket data"), section = prompt("the section of this refunded ticket data"), pricingTier = prompt("the pricing tier of this refunded ticket data"), faceValue = prompt("the face value of this refunded ticket data"), originalBuyerId = prompt("the original buyer id of this refunded ticket data"), refundAmount = prompt("the refund amount of this refunded ticket data"), refundReason = prompt("the refund reason of this refunded ticket data"), refundedAt = prompt("the refunded at of this refunded ticket data"))
    }
    on ticketReserved: event TicketReserved is {
      morph entity Ticket to state Ticket.ReservedState with record Ticket.ReservedTicketData(ticketId = ticketReserved.ticketId, buyerId = ticketReserved.buyerId, expiresAt = ticketReserved.expiresAt, eventId = prompt("the event id of this reserved ticket data"), seatId = prompt("the seat id of this reserved ticket data"), section = prompt("the section of this reserved ticket data"), row = empty, seatNumber = empty, pricingTier = prompt("the pricing tier of this reserved ticket data"), faceValue = prompt("the face value of this reserved ticket data"), reservedAt = prompt("the reserved at of this reserved ticket data"))
    }
    on ticketScanned: event TicketScanned is {
      morph entity Ticket to state Ticket.UsedState with record Ticket.UsedTicketData(ticketId = ticketScanned.ticketId, gateId = ticketScanned.gateId, scannedAt = ticketScanned.scannedAt, eventId = prompt("the event id of this used ticket data"), seatId = prompt("the seat id of this used ticket data"), section = prompt("the section of this used ticket data"), row = empty, seatNumber = empty, buyerId = prompt("the buyer id of this used ticket data"))
    }
    on ticketTransferred: event TicketTransferred is {
      set field Ticket.SoldState.buyerId to ticketTransferred.toBuyerId
      append prompt("a TransferRecord of fromBuyerId, toBuyerId and transferredAt") to field Ticket.SoldState.transferHistory
    }
    on reserveTicket: command ReserveTicket is {
      yield event TicketReserved(ticketId = reserveTicket.ticketId, buyerId = reserveTicket.buyerId, expiresAt = reserveTicket.expiresAt, reservedAt = system.now)
    }
    on purchaseTicket: command PurchaseTicket is {
      yield event TicketPurchased(ticketId = purchaseTicket.ticketId, buyerId = purchaseTicket.buyerId, amountPaid = purchaseTicket.amountPaid, eventId = Ticket.ReservedState.eventId, seatId = Ticket.ReservedState.seatId, section = Ticket.ReservedState.section, pricingTier = Ticket.ReservedState.pricingTier, purchasedAt = system.now, paymentTransactionId = purchaseTicket.paymentTransactionId)
    }
    on transferTicket: command TransferTicket is {
      yield event TicketTransferred(ticketId = transferTicket.ticketId, fromBuyerId = transferTicket.fromBuyerId, toBuyerId = transferTicket.toBuyerId, eventId = Ticket.SoldState.eventId, transferredAt = system.now)
    }
    on refundTicket: command RefundTicket is {
      yield event TicketRefunded(ticketId = refundTicket.ticketId, buyerId = refundTicket.buyerId, reason = refundTicket.reason, eventId = Ticket.SoldState.eventId, refundAmount = refundTicket.refundAmount, refundedAt = system.now)
    }
    on cancelReservation: command CancelReservation is {
      yield event ReservationCancelled(ticketId = cancelReservation.ticketId, cancelledAt = system.now)
    }
    on scanTicket: command ScanTicket is {
      yield event TicketScanned(ticketId = scanTicket.ticketId, gateId = scanTicket.gateId, scannedAt = scanTicket.scannedAt, eventId = Ticket.SoldState.eventId, buyerId = Ticket.SoldState.buyerId)
    }
    on getTicket: query GetTicket is {
      reply result TicketResult(eventId = getTicket.eventId, ticketId = prompt("the ticket id of this ticket result"))
    }
  } with {
    briefly "Processes ticket lifecycle commands"
    described as {
      | Handles all commands related to ticket state transitions including
      | reservations, purchases, transfers, refunds, and venue entry.
    }
  }
} with {
  briefly "The ticket aggregate managing ticket lifecycle"
  described as {
    | The Ticket entity is the primary aggregate for the Ticket Sales
    | bounded context. It tracks tickets from inventory release through
    | sale, transfer, or refund, and finally venue admission. Events
    | maintain a complete audit trail of all ticket transactions.
  }
}
