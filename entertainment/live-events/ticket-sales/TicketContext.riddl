// Ticket Sales - Ticket Context
// The primary bounded context for ticket sales management
context TicketContext as router is {
  inlet TicketCommandStreamIn is type TicketCommand
  outlet TicketCommandStreamOut is type TicketCommand
  inlet TicketResultStreamIn is type Ticket.TicketResult
  outlet TicketResultStreamOut is type Ticket.TicketResult
  handler TicketContextBoundary is {
    on createEvent: command Ticket.CreateEvent is {
      send createEvent to outlet TicketContext.TicketCommandStreamOut
    }
    on releaseTickets: command Ticket.ReleaseTickets is {
      send releaseTickets to outlet TicketContext.TicketCommandStreamOut
    }
    on purchaseTicket: command Ticket.PurchaseTicket is {
      send purchaseTicket to outlet TicketContext.TicketCommandStreamOut
    }
    on reserveTicket: command Ticket.ReserveTicket is {
      send reserveTicket to outlet TicketContext.TicketCommandStreamOut
    }
    on transferTicket: command Ticket.TransferTicket is {
      send transferTicket to outlet TicketContext.TicketCommandStreamOut
    }
    on refundTicket: command Ticket.RefundTicket is {
      send refundTicket to outlet TicketContext.TicketCommandStreamOut
    }
    on cancelReservation: command Ticket.CancelReservation is {
      send cancelReservation to outlet TicketContext.TicketCommandStreamOut
    }
    on scanTicket: command Ticket.ScanTicket is {
      send scanTicket to outlet TicketContext.TicketCommandStreamOut
    }
    on initializeTicket: command Ticket.InitializeTicket is {
      send initializeTicket to outlet TicketContext.TicketCommandStreamOut
    }
    on ticketResult: result Ticket.TicketResult is {
      send ticketResult to outlet TicketContext.TicketResultStreamOut
    }
    on other is {
      error "Unexpected message at the TicketContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TicketCommand Stream Intake' is from outlet TicketContext.TicketCommandStreamOut to inlet TicketContext.Ticket.TicketCommands
  connector 'TicketResult Stream Egress' is from outlet TicketContext.TicketRepository.TicketRepositoryResponses to inlet TicketContext.TicketResultStreamIn
  include "types.riddl"
  include "Ticket.riddl"
  // Adaptors for external system integration
  adaptor PaymentAdapter from context PaymentGateway is { 
    handler InboundPayments is {
      on event PaymentGateway.PaymentSucceeded is {
        let purchaseTicket: type PurchaseTicket = prompt("the purchase ticket that results from payment succeeded")
        tell purchaseTicket to entity Ticket
      }
      on event PaymentGateway.PaymentFailed is {
        let cancelReservation: type CancelReservation = prompt("the cancel reservation that results from payment failed")
        tell cancelReservation to entity Ticket
      }
      on event PaymentGateway.RefundCompleted is {
        let refundTicket: type RefundTicket = prompt("the refund ticket that results from refund completed")
        tell refundTicket to entity Ticket
      }
      on other is {
        error "Unexpected message for adaptor PaymentAdapter"
      }
    } with {
      briefly "Handles payment events from gateway"
      described as {
        |Processes inbound payment status events and routes to Ticket entity.
      }
    }
  } with {
    briefly "Translates payment gateway events"
    described as {
      | Receives payment status events from the external PaymentGateway
      | and translates them into commands for the Ticket entity.
    }
  }
  adaptor VenueAdapter from context VenueManagement is { 
    handler InboundVenue is {
      on event VenueManagement.SeatingChartUpdated is {
        let releaseTickets: type ReleaseTickets = prompt("the release tickets that results from seating chart updated")
        tell releaseTickets to entity Ticket
      }
      on event VenueManagement.VenueCapacityChanged is {
        let releaseTickets: type ReleaseTickets = prompt("the release tickets that results from venue capacity changed")
        tell releaseTickets to entity Ticket
      }
      on other is {
        error "Unexpected message for adaptor VenueAdapter"
      }
    } with {
      briefly "Handles venue management events"
      described as {
        |Processes venue updates that affect ticket inventory.
      }
    }
  } with {
    briefly "Translates venue management events"
    described as {
      | Receives venue updates from the VenueManagement context
      | and adjusts ticket inventory accordingly.
    }
  }
  adaptor MarketingAdapter to context MarketingService as source is { 
    outlet MarketingAdapterOut is type MarketingService.MarketingCommand
    handler OutboundMarketing is {
      on announceEvent: command MarketingService.AnnounceEvent is {
        tell announceEvent to context MarketingService
      }
      on notifySubscribers: command MarketingService.NotifySubscribers is {
        tell notifySubscribers to context MarketingService
      }
      on sendConfirmation: command MarketingService.SendConfirmation is {
        tell sendConfirmation to context MarketingService
      }
      on notifyTransfer: command MarketingService.NotifyTransfer is {
        tell notifyTransfer to context MarketingService
      }
      on other is {
        error "Unexpected message for adaptor MarketingAdapter"
      }
    } with {
      briefly "Sends events to marketing service"
      described as {
        |Routes ticket events to marketing for notifications and campaigns.
      }
    }
  } with {
    briefly "Translates events for marketing"
    described as {
      | Sends relevant ticket events to the MarketingService context
      | for email notifications, announcements, and campaigns.
    }
  }
  // Repository for ticket persistence
  repository TicketRepository as merge is {
    inlet TicketRepositoryFromTicket is type TicketEvent    inlet TicketRepositoryFromSalesMetrics is type TicketEvent    outlet TicketRepositoryResponses is type Ticket.TicketResult
    record StoredTicket is  {
      ticketId: TicketId with {
        briefly "ticketId"
        described as {
          |The ticketId column of the stored ticket row.
        }
      }
      buyerId: BuyerId with {
        briefly "buyerId"
        described as {
          |The buyerId column of the stored ticket row.
        }
      }
      eventId: EventId with {
        briefly "eventId"
        described as {
          |The eventId column of the stored ticket row.
        }
      }
      seatId: SeatId with {
        briefly "seatId"
        described as {
          |The seatId column of the stored ticket row.
        }
      }
    } with {
      briefly "Stored ticket row"
      described as {
        |The persistence shape of ticket data as this repository stores it.
      }
    }
    schema TicketData is relational
      of tickets as type StoredTicket
        index on field StoredTicket.eventId
        index on field StoredTicket.buyerId
        index on field StoredTicket.seatId
 with {
      briefly "Ticket data schema"
      described as {
        |The relational schema holding ticket data for the TicketRepository.
      }
    }
    handler TicketPersistence is {
      on query GetEventSalesMetrics is {
        let eventSalesMetricsView: type EventSalesMetricsView = prompt("read the event sales metrics projection")
        reply eventSalesMetricsView
      }
      on query GetDailySalesMetrics is {
        let dailySalesMetricsView: type DailySalesMetricsView = prompt("read the daily sales metrics projection")
        reply dailySalesMetricsView
      }
      on createEvent: command Ticket.CreateEvent is {
        tell event Ticket.EventCreated(eventId = createEvent.eventId, name = createEvent.name, venueId = createEvent.venueId, venueName = createEvent.venueName, eventDate = createEvent.eventDate) to entity TicketContext.Ticket
      }
      on releaseTickets: command Ticket.ReleaseTickets is {
        tell event Ticket.TicketsReleased(eventId = releaseTickets.eventId, tierName = releaseTickets.tierName, quantity = releaseTickets.quantity) to entity TicketContext.Ticket
      }
      on reserveTicket: command Ticket.ReserveTicket is {
        tell event Ticket.TicketReserved(ticketId = reserveTicket.ticketId, buyerId = reserveTicket.buyerId, expiresAt = reserveTicket.expiresAt) to entity TicketContext.Ticket
      }
      on purchaseTicket: command Ticket.PurchaseTicket is {
        tell event Ticket.TicketPurchased(ticketId = purchaseTicket.ticketId, buyerId = purchaseTicket.buyerId, amountPaid = purchaseTicket.amountPaid) to entity TicketContext.Ticket
      }
      on transferTicket: command Ticket.TransferTicket is {
        tell event Ticket.TicketTransferred(ticketId = transferTicket.ticketId, fromBuyerId = transferTicket.fromBuyerId, toBuyerId = transferTicket.toBuyerId) to entity TicketContext.Ticket
      }
      on refundTicket: command Ticket.RefundTicket is {
        tell event Ticket.TicketRefunded(ticketId = refundTicket.ticketId, buyerId = refundTicket.buyerId, reason = refundTicket.reason) to entity TicketContext.Ticket
      }
      on cancelReservation: command Ticket.CancelReservation is {
        tell event Ticket.ReservationCancelled(ticketId = cancelReservation.ticketId) to entity TicketContext.Ticket
      }
      on scanTicket: command Ticket.ScanTicket is {
        tell event Ticket.TicketScanned(ticketId = scanTicket.ticketId, gateId = scanTicket.gateId, scannedAt = scanTicket.scannedAt) to entity TicketContext.Ticket
      }
    } with {
      briefly "Persists ticket events to storage"
      described as {
        |Handles all event-driven persistence operations for tickets.
      }
    }
  } with {
    briefly "Persistent storage for ticket data"
    described as {
      | The TicketRepository provides persistent storage for tickets
      | with indexes optimized for common query patterns by event,
      | buyer, and seat.
    }
  }
  // Projector for sales metrics
  query GetEventSalesMetrics is  {
    eventSalesMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which event sales metrics to retrieve.
      }
    }
  } with {
    briefly "Get event sales metrics"
    described as {
      |Retrieves the event sales metrics projection.
    }
  }
  result EventSalesMetricsView is  {
    eventSalesMetrics: SalesMetrics.EventSalesMetrics with {
      briefly "Event sales metrics"
      described as {
        |The event sales metrics being returned.
      }
    }
  } with {
    briefly "Event sales metrics view"
    described as {
      |Read model view carrying the event sales metrics projection.
    }
  }
  query GetDailySalesMetrics is  {
    dailySalesMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily sales metrics to retrieve.
      }
    }
  } with {
    briefly "Get daily sales metrics"
    described as {
      |Retrieves the daily sales metrics projection.
    }
  }
  result DailySalesMetricsView is  {
    dailySalesMetrics: SalesMetrics.DailySalesMetrics with {
      briefly "Daily sales metrics"
      described as {
        |The daily sales metrics being returned.
      }
    }
  } with {
    briefly "Daily sales metrics view"
    described as {
      |Read model view carrying the daily sales metrics projection.
    }
  }
  projector SalesMetrics as flow is {
    updates repository TicketContext.TicketRepository
    inlet SalesMetricsFromTicket is type TicketEvent    outlet SalesMetricsOut is type TicketEvent
    record EventSalesMetrics is  {
      eventId: EventId with {
        briefly "Event identifier"
        described as {
          |The event these metrics are for.
        }
      }
      totalCapacity: Natural with {
        briefly "Total capacity"
        described as {
          |Total tickets available for the event.
        }
      }
      ticketsSold: Natural with {
        briefly "Tickets sold"
        described as {
          |Number of tickets sold.
        }
      }
      ticketsReserved: Natural with {
        briefly "Tickets reserved"
        described as {
          |Currently reserved tickets.
        }
      }
      ticketsAvailable: Natural with {
        briefly "Tickets available"
        described as {
          |Remaining available tickets.
        }
      }
      ticketsRefunded: Natural with {
        briefly "Tickets refunded"
        described as {
          |Number of refunded tickets.
        }
      }
      grossRevenue: Money with {
        briefly "Gross revenue"
        described as {
          |Total revenue from ticket sales.
        }
      }
      netRevenue: Money with {
        briefly "Net revenue"
        described as {
          |Revenue minus refunds.
        }
      }
      averageTicketPrice: Money with {
        briefly "Average price"
        described as {
          |Average price per ticket sold.
        }
      }
      salesByTier: {
        tierName: String(1,50) with {
          briefly "Tier"
          described as {
            |Pricing tier name.
          }
        }
        sold: Natural with {
          briefly "Sold"
          described as {
            |Tickets sold in this tier.
          }
        }
        revenue: Money with {
          briefly "Revenue"
          described as {
            |Revenue from this tier.
          }
        }
      }
+ with {
        briefly "Sales by tier"
        described as {
          |Breakdown of sales by pricing tier.
        }
      }
      lastUpdated: TimeStamp with {
        briefly "Updated"
        described as {
          |When metrics were last calculated.
        }
      }
    } with {
      briefly "Aggregated sales metrics for an event"
      described as {
        |Real-time sales statistics for a single event.
      }
    }
    record DailySalesMetrics is  {
      date: Date with {
        briefly "Date"
        described as {
          |The date for these metrics.
        }
      }
      totalTicketsSold: Natural with {
        briefly "Tickets sold"
        described as {
          |Total tickets sold this day.
        }
      }
      totalRevenue: Money with {
        briefly "Revenue"
        described as {
          |Total revenue for the day.
        }
      }
      ticketsByEvent: {
        eventId: EventId with {
          briefly "Event"
          described as {
            |Event identifier.
          }
        }
        eventName: String(1,200) with {
          briefly "Name"
          described as {
            |Event name.
          }
        }
        ticketsSold: Natural with {
          briefly "Sold"
          described as {
            |Tickets sold for this event.
          }
        }
        revenue: Money with {
          briefly "Revenue"
          described as {
            |Revenue for this event.
          }
        }
      }
+ with {
        briefly "Daily sales by event"
        described as {
          |Breakdown of daily sales by event.
        }
      }
      refundsProcessed: Natural with {
        briefly "Refunds"
        described as {
          |Number of refunds processed.
        }
      }
      refundTotal: Money with {
        briefly "Refund total"
        described as {
          |Total amount refunded.
        }
      }
      transfersCompleted: Natural with {
        briefly "Transfers"
        described as {
          |Number of ticket transfers.
        }
      }
    } with {
      briefly "Daily aggregated sales metrics"
      described as {
        |Aggregated sales statistics for a single day.
      }
    }
    handler SalesMetricsHandler is {
      on ticketPurchased: event Ticket.TicketPurchased is {
        tell ticketPurchased to repository TicketContext.TicketRepository
      }
      on ticketRefunded: event Ticket.TicketRefunded is {
        tell ticketRefunded to repository TicketContext.TicketRepository
      }
      on ticketTransferred: event Ticket.TicketTransferred is {
        tell ticketTransferred to repository TicketContext.TicketRepository
      }
      on eventCreated: event Ticket.EventCreated is {
        tell eventCreated to repository TicketContext.TicketRepository
      }
      on ticketsReleased: event Ticket.TicketsReleased is {
        tell ticketsReleased to repository TicketContext.TicketRepository
      }
    } with {
      briefly "Projects ticket events for sales analytics"
      described as {
        |Maintains real-time sales metrics from ticket events.
      }
    }
  } with {
    briefly "Projects ticket events for sales reporting"
    described as {
      | Maintains aggregated views of sales data for dashboards,
      | promoter reporting, and business intelligence. Tracks
      | sales velocity, revenue, and inventory levels in real-time.
    }
  }
  processor TicketEventSource as source is {
    outlet TicketEvents is type TicketEvent
    handler TicketEventEmitter is {
      on init is {
        let initializeTicket: type InitializeTicket = prompt("the initialize ticket that brings this this into existence")
        tell initializeTicket to entity TicketContext.Ticket
      }
      on other is {
        error "Unexpected message for source TicketEventSource"
      }
      on eventCreated: event Ticket.EventCreated is {
        send eventCreated to outlet TicketEvents
      }
      on ticketPurchased: event Ticket.TicketPurchased is {
        send ticketPurchased to outlet TicketEvents
      }
      on ticketRefunded: event Ticket.TicketRefunded is {
        send ticketRefunded to outlet TicketEvents
      }
      on ticketScanned: event Ticket.TicketScanned is {
        send ticketScanned to outlet TicketEvents
      }
    } with {
      briefly "Ticket event emitter"
      described as {
        |Emits ticket lifecycle events into the streaming topology.
      }
    }
  } with {
    briefly "Ticket event source"
    described as {
      |Publishes ticket entity events for streaming.
    }
  }
  processor TicketEventSink as sink is {
    inlet IncomingTicketEvents is type TicketEvent    handler TicketEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink TicketEventSink"
      }
      on eventCreated: event Ticket.EventCreated is {
        tell eventCreated to repository TicketContext.TicketRepository
      }
      on ticketScanned: event Ticket.TicketScanned is {
        tell ticketScanned to repository TicketContext.TicketRepository
      }
    } with {
      briefly "Ticket event receiver"
      described as {
        |Receives ticket events and persists them.
      }
    }
  } with {
    briefly "Ticket event sink"
    described as {
      |Receives ticket events from the streaming topology.
    }
  }
  connector TicketEventPipeline is from outlet TicketContext.TicketEventSource.TicketEvents to inlet TicketContext.TicketEventSink.IncomingTicketEvents with {
    briefly "Ticket event pipeline"
    described as {
      |Wires ticket events from source to sink.
    }
  }
  processor TicketEventSplit as split is {
    inlet TicketEventSplitIn is type TicketEvent    outlet TicketEventSplitToTicketRepository is type TicketEvent
    outlet TicketEventSplitToSalesMetrics is type TicketEvent
    handler TicketEventSplitHandler is {
      on eventCreated: event Ticket.EventCreated is {
        send eventCreated to outlet TicketEventSplitToTicketRepository
        send eventCreated to outlet TicketEventSplitToSalesMetrics
        tell eventCreated to entity TicketContext.Ticket
      }
      on ticketsReleased: event Ticket.TicketsReleased is {
        send ticketsReleased to outlet TicketEventSplitToTicketRepository
        send ticketsReleased to outlet TicketEventSplitToSalesMetrics
        tell ticketsReleased to entity TicketContext.Ticket
      }
      on ticketPurchased: event Ticket.TicketPurchased is {
        send ticketPurchased to outlet TicketEventSplitToTicketRepository
        send ticketPurchased to outlet TicketEventSplitToSalesMetrics
        tell ticketPurchased to entity TicketContext.Ticket
      }
      on ticketReserved: event Ticket.TicketReserved is {
        send ticketReserved to outlet TicketEventSplitToTicketRepository
        send ticketReserved to outlet TicketEventSplitToSalesMetrics
        tell ticketReserved to entity TicketContext.Ticket
      }
      on ticketTransferred: event Ticket.TicketTransferred is {
        send ticketTransferred to outlet TicketEventSplitToTicketRepository
        send ticketTransferred to outlet TicketEventSplitToSalesMetrics
        tell ticketTransferred to entity TicketContext.Ticket
      }
      on ticketRefunded: event Ticket.TicketRefunded is {
        send ticketRefunded to outlet TicketEventSplitToTicketRepository
        send ticketRefunded to outlet TicketEventSplitToSalesMetrics
        tell ticketRefunded to entity TicketContext.Ticket
      }
      on reservationCancelled: event Ticket.ReservationCancelled is {
        send reservationCancelled to outlet TicketEventSplitToTicketRepository
        send reservationCancelled to outlet TicketEventSplitToSalesMetrics
        tell reservationCancelled to entity TicketContext.Ticket
      }
      on ticketScanned: event Ticket.TicketScanned is {
        send ticketScanned to outlet TicketEventSplitToTicketRepository
        send ticketScanned to outlet TicketEventSplitToSalesMetrics
        tell ticketScanned to entity TicketContext.Ticket
      }
      on other is {
        error "Unexpected message for processor TicketEventSplit"
      }
    } with {
      briefly "Ticket event fan-out handler"
      described as {
        |Delivers each Ticket event to all of its consumers.
      }
    }
  } with {
    briefly "Ticket event fan-out"
    described as {
      |Fans Ticket events out to the repository and projectors.
    }
  }
  connector 'TicketEvent Stream' is from outlet TicketContext.Ticket.TicketEvents2 to inlet TicketContext.TicketEventSplit.TicketEventSplitIn with {
    briefly "Ticket events, fanned out to storage and read models"
  }
  connector 'TicketEvent Storage' is from outlet TicketContext.TicketEventSplit.TicketEventSplitToTicketRepository to inlet TicketContext.TicketRepository.TicketRepositoryFromTicket with {
    briefly "Ticket events on their way to storage"
  }
  connector 'SalesMetrics Feed' is from outlet TicketContext.TicketEventSplit.TicketEventSplitToSalesMetrics to inlet TicketContext.SalesMetrics.SalesMetricsFromTicket with {
    briefly "Ticket events feeding the SalesMetrics projection"
  }
  connector 'SalesMetrics Storage' is from outlet TicketContext.SalesMetrics.SalesMetricsOut to inlet TicketContext.TicketRepository.TicketRepositoryFromSalesMetrics with {
    briefly "The SalesMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for ticket sales"
  described as {
    | The TicketContext is the primary bounded context for the Ticket
    | Sales domain. It contains the Ticket entity, repository for
    | persistence, projector for analytics, and adaptors for
    | integration with payment, venue, and marketing systems.
  }
}
