// Ticket Sales - Ticket Context
// The primary bounded context for ticket sales management
context TicketContext as router is {
  inlet LiveEventAnswers is event LiveEvent.TicketsReleased
  command CreateEvent yields event LiveEvent.EventCreated is {
    name: String(1,200) with {
      briefly "Event name"
      described as {
        |The official name or title of the event.
      }
    }
    description: String(1,2000) with {
      briefly "Event description"
      described as {
        |Detailed description of the event.
      }
    }
    venueId: VenueId with {
      briefly "Venue reference"
      described as {
        |Reference to the venue where the event will be held.
      }
    }
    venueName: String(1,200) with {
      briefly "Venue name"
      described as {
        |Human-readable name of the venue.
      }
    }
    eventDate: DateTime with {
      briefly "Event date"
      described as {
        |When the event will take place.
      }
    }
    doorsOpen: DateTime with {
      briefly "Doors open"
      described as {
        |When venue doors open for entry.
      }
    }
    category: String(1,100) with {
      briefly "Category"
      described as {
        |Event category for classification.
      }
    }
    ageRestriction: String(1,50)? with {
      briefly "Age restriction"
      described as {
        |Minimum age requirement if any.
      }
    }
    refundPolicy: String(1,500) with {
      briefly "Refund policy"
      described as {
        |Policy for ticket refunds.
      }
    }
    totalCapacity: Natural with {
      briefly "Total capacity"
      described as {
        |How many tickets the show can sell across all tiers.
      }
    }
    pricingTiers: PricingTier+ with {
      briefly "Pricing tiers"
      described as {
        |Available pricing tiers for the event.
      }
    }
  } with {
    briefly "Create a new event with ticket inventory"
    described as {
      | Creates a new event with venue, timing, and pricing information.
      | Ticket inventory is prepared but not yet released for sale.
    }
  }
  command ReleaseTickets is {
    eventId: EventId with {
      briefly "Event identifier"
      described as {
        |The event for which tickets are being released.
      }
    }
    tierName: String(1,50) with {
      briefly "Pricing tier"
      described as {
        |Which pricing tier to release tickets for.
      }
    }
    faceValue: Money with {
      briefly "Face value"
      described as {
        |The price every released seat is sold at.
      }
    }
    seats: SeatInfo+ with {
      briefly "Seats"
      described as {
        |The seats released, one ticket each.
      }
    }
    releaseTime: DateTime? with {
      briefly "Release time"
      described as {
        |Scheduled time to make tickets available, or now if null.
      }
    }
  } with {
    briefly "Release tickets for sale to the public"
    described as {
      |Makes specified tickets available for purchase in the given tier.
    }
  }
  type TicketRequest is one of {
    TicketContext.CreateEvent or TicketContext.ReleaseTickets or Ticket.TicketCommand
  } with {
    briefly "Ticket requests"
    described as {
      |What may be asked of TicketContext: CreateEvent, which creates a show;
      |ReleaseTickets, which creates a ticket per released seat; or any command
      |for an existing ticket.
    }
  }
  connector 'LiveEventQuery Intake' is from outlet TicketContext.LiveEventQueriesOut to inlet TicketContext.LiveEvent.LiveEventQueries with {
    briefly "Look-ups on their way to the live event"
  }
  connector 'LiveEventReply Egress' is from outlet TicketContext.LiveEvent.LiveEventReplies to inlet TicketContext.LiveEventRepliesIn with {
    briefly "The live event's answers on their way to the boundary"
  }
  connector 'TicketRepositoryQuery Intake' is from outlet TicketContext.TicketRepositoryQueriesOut to inlet TicketContext.TicketRepository.TicketRepositoryQueries with {
    briefly "Look-ups on their way to the ticket repository"
  }
  connector 'TicketRepositoryReply Egress' is from outlet TicketContext.TicketRepository.TicketRepositoryResponses to inlet TicketContext.TicketRepositoryRepliesIn with {
    briefly "The ticket repository's answers on their way to the boundary"
  }
  connector 'TicketQuery Intake' is from outlet TicketContext.TicketQueriesOut to inlet TicketContext.Ticket.TicketQueries with {
    briefly "Look-ups on their way to the ticket"
  }
  connector 'VenueAdapter Intake' is from outlet TicketContext.VenueAdapter.VenueAdapterToTicketContext to inlet TicketContext.TicketContextFromVenueAdapter with {
    briefly "VenueAdapter messages on their way to TicketContext"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet LiveEventQueriesIn is query LiveEvent.GetLiveEvent with {
    briefly "Look-ups of the live event"
    described as {
      |TicketSalesApp's look-ups, on their way to the live event.
    }
  }
  outlet LiveEventQueriesOut is query LiveEvent.GetLiveEvent
 with {
    briefly "Look-ups on their way to the live event"
    described as {
      |Each look-up goes to the live event it names.
    }
  }
  inlet LiveEventRepliesIn is result LiveEvent.LiveEventResult with {
    briefly "The live event's answers"
    described as {
      |What the live event answers about itself.
    }
  }
  outlet LiveEventRepliesOut is result LiveEvent.LiveEventResult
 with {
    briefly "Answers to TicketSalesApp"
    described as {
      |The reply leg of TicketSalesApp's look-ups of the live event.
    }
  }
  inlet TicketRepositoryQueriesIn is type TicketRepository.TicketRepositoryQuery with {
    briefly "Look-ups of the ticket repository"
    described as {
      |TicketSalesApp's look-ups, on their way to the ticket repository.
    }
  }
  outlet TicketRepositoryQueriesOut is type TicketRepository.TicketRepositoryQuery
 with {
    briefly "Look-ups on their way to the ticket repository"
    described as {
      |Each look-up goes to the ticket repository it names.
    }
  }
  inlet TicketRepositoryRepliesIn is type TicketRepository.TicketRepositoryReply with {
    briefly "The ticket repository's answers"
    described as {
      |What the ticket repository answers about itself.
    }
  }
  outlet TicketRepositoryRepliesOut is type TicketRepository.TicketRepositoryReply
 with {
    briefly "Answers to TicketSalesApp"
    described as {
      |The reply leg of TicketSalesApp's look-ups of the ticket repository.
    }
  }
  inlet TicketQueriesIn is query Ticket.GetTicket with {
    briefly "Look-ups of the ticket"
    described as {
      |TicketSalesApp's look-ups, on their way to the ticket.
    }
  }
  outlet TicketQueriesOut is query Ticket.GetTicket
 with {
    briefly "Look-ups on their way to the ticket"
    described as {
      |Each look-up goes to the ticket it names.
    }
  }
  inlet TicketContextFromVenueAdapter is command TicketContext.ReleaseTickets with {
    briefly "What VenueAdapter sends TicketContext"
    described as {
      |Its own inlet: an inlet accepts exactly one connector.
    }
  }
  connector 'PaymentAdapter Intake' is from outlet TicketContext.PaymentAdapter.PaymentAdapterToTicketContext to inlet TicketContext.TicketContextFromPaymentAdapter with {
    briefly "PaymentAdapter messages on their way to TicketContext"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet TicketContextFromPaymentAdapter is type TicketCommand with {
    briefly "What PaymentAdapter sends TicketContext"
    described as {
      |Its own inlet: an inlet accepts exactly one connector.
    }
  }
  inlet TicketCommandStreamIn is type TicketContext.TicketRequest
  outlet TicketCommandStreamOut is type TicketCommand
  outlet LiveEventCommandStreamOut is command LiveEvent.RecordRelease
  inlet TicketResultStreamIn is result Ticket.TicketResult
  outlet TicketResultStreamOut is result Ticket.TicketResult
  inlet EventCreatedAnswerIn is event LiveEvent.EventCreated
  outlet EventCreatedAnswerOut is event LiveEvent.EventCreated
  connector 'EventCreated Answer Relay' is from outlet TicketContext.TicketEventSplit.TicketEventSplitToEventCreatedAnswer to inlet TicketContext.EventCreatedAnswerIn with {
    briefly "The event created answer, on its way out of TicketContext"
  }
  handler TicketContextBoundary is {
    on eventCreated: event LiveEvent.EventCreated is {
      send eventCreated to outlet TicketContext.EventCreatedAnswerOut
    }
    on getLiveEvent: query LiveEvent.GetLiveEvent is {
      forward getLiveEvent to outlet TicketContext.LiveEventQueriesOut
    }
    on liveEventResult: result LiveEvent.LiveEventResult is {
      send liveEventResult to outlet TicketContext.LiveEventRepliesOut
    }
    on getEventSalesMetrics: query GetEventSalesMetrics is {
      forward getEventSalesMetrics to outlet TicketContext.TicketRepositoryQueriesOut
    }
    on getDailySalesMetrics: query GetDailySalesMetrics is {
      forward getDailySalesMetrics to outlet TicketContext.TicketRepositoryQueriesOut
    }
    on dailySalesMetricsView: result DailySalesMetricsView is {
      send dailySalesMetricsView to outlet TicketContext.TicketRepositoryRepliesOut
    }
    on eventSalesMetricsView: result EventSalesMetricsView is {
      send eventSalesMetricsView to outlet TicketContext.TicketRepositoryRepliesOut
    }
    on getTicket: query Ticket.GetTicket is {
      forward getTicket to outlet TicketContext.TicketQueriesOut
    }
    on createEvent: command TicketContext.CreateEvent is {
      let eventCreatedAt: type TimeStamp = system.now
      let newEvent = create entity TicketContext.LiveEvent(name = createEvent.name, description = createEvent.description, venueId = createEvent.venueId, venueName = createEvent.venueName, eventDate = createEvent.eventDate, doorsOpen = createEvent.doorsOpen, category = createEvent.category, ageRestriction = createEvent.ageRestriction, refundPolicy = createEvent.refundPolicy, pricingTiers = createEvent.pricingTiers, totalCapacity = createEvent.totalCapacity, createdAt = eventCreatedAt)
    }
    on releaseTickets: command TicketContext.ReleaseTickets is {
      let ticketsReleasedAt: type TimeStamp = system.now
      foreach seat in field TicketContext.ReleaseTickets.seats {
        let newTicket = create entity TicketContext.Ticket(eventId = releaseTickets.eventId, seatId = seat.seatId, section = seat.section, row = seat.row, seatNumber = seat.seatNumber, pricingTier = releaseTickets.tierName, faceValue = releaseTickets.faceValue, releasedAt = ticketsReleasedAt)
        log newTicket
      }
      send command LiveEvent.RecordRelease(eventId = releaseTickets.eventId, tierName = releaseTickets.tierName, quantity = prompt("how many seats releaseTickets.seats holds")) to outlet TicketContext.LiveEventCommandStreamOut
    }
    on purchaseTicket: command Ticket.PurchaseTicket is {
      forward purchaseTicket to outlet TicketContext.TicketCommandStreamOut
    }
    on reserveTicket: command Ticket.ReserveTicket is {
      forward reserveTicket to outlet TicketContext.TicketCommandStreamOut
    }
    on transferTicket: command Ticket.TransferTicket is {
      forward transferTicket to outlet TicketContext.TicketCommandStreamOut
    }
    on refundTicket: command Ticket.RefundTicket is {
      forward refundTicket to outlet TicketContext.TicketCommandStreamOut
    }
    on cancelReservation: command Ticket.CancelReservation is {
      forward cancelReservation to outlet TicketContext.TicketCommandStreamOut
    }
    on scanTicket: command Ticket.ScanTicket is {
      forward scanTicket to outlet TicketContext.TicketCommandStreamOut
    }
    on ticketResult: result Ticket.TicketResult is {
      send ticketResult to outlet TicketContext.TicketResultStreamOut
    }
    on ticketsReleased: event LiveEvent.TicketsReleased is {
      log ticketsReleased
    }
    on other is {
      error "Unexpected message at the TicketContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'LiveEventCommand Stream Intake' is from outlet TicketContext.LiveEventCommandStreamOut to inlet TicketContext.LiveEvent.LiveEventCommands
  connector 'TicketCommand Stream Intake' is from outlet TicketContext.TicketCommandStreamOut to inlet TicketContext.Ticket.TicketCommands
  connector 'TicketResult Stream Egress' is from outlet TicketContext.Ticket.TicketReplies to inlet TicketContext.TicketResultStreamIn
  include "types.riddl"
  include "Ticket.riddl"
  include "LiveEvent.riddl"
  // Adaptors for external system integration
  adaptor ToVenueManagement to context VenueManagement as flow is { 
    inlet ToVenueManagementIn is type TicketEvent
    outlet ToVenueManagementOut is type VenueManagement.VenueManagementCommand
    handler ToVenueManagementHandler is {
      on eventCreated: event LiveEvent.EventCreated is {
        let item0: type VenueManagement.ReserveVenue = prompt("translate the eventCreated event into a ReserveVenue, the event being what creates the need for a hall")
        send item0 to outlet TicketContext.ToVenueManagement.ToVenueManagementOut
        let item1: type VenueManagement.GetSeatingChart = prompt("translate the eventCreated event into a GetSeatingChart, and the chart being what its seats must be laid out from")
        send item1 to outlet TicketContext.ToVenueManagement.ToVenueManagementOut
      }
      on other is {
        error "Unexpected message for adaptor ToVenueManagement"
      }
    } with {
      briefly "to venue management"
      described as {
        |Carries messages to the external VenueManagement.
      }
    }
  } with {
    briefly "VenueManagement integration"
    described as {
      |The model's side of the VenueManagement conversation.
    }
  }
  adaptor PaymentAdapter from context PaymentGateway as merge is { 
    inlet TicketAnswers is type TicketEvent
    inlet PaymentAdapterIn is type PaymentGateway.PaymentGatewayEvent
    outlet PaymentAdapterToTicketContext is type TicketCommand
 with {
      briefly "What PaymentAdapter publishes to TicketContext"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to TicketContext needs this port to travel on.
      }
    }
    handler InboundPayments is {
      on event PaymentGateway.PaymentSucceeded is {
        let purchaseTicket: type PurchaseTicket = prompt("the purchase ticket that results from payment succeeded")
        tell purchaseTicket to context TicketContext
      }
      on event PaymentGateway.PaymentFailed is {
        let cancelReservation: type CancelReservation = prompt("the cancel reservation that results from payment failed")
        tell cancelReservation to context TicketContext
      }
      on event PaymentGateway.RefundCompleted is {
        do "the ticket already refunded itself when it started the refund, so the gateway's completion changes nothing here"
      }
      on ticketPurchased: event Ticket.TicketPurchased is {
        log ticketPurchased
      }
      on reservationCancelled: event Ticket.ReservationCancelled is {
        log reservationCancelled
      }
      on other is {
        error "Unexpected message for adaptor PaymentAdapter"
      }
    } with {
      briefly "Handles payment events from gateway"
      described as {
        |Processes inbound payment status events and routes to Ticket entity.
      }
    }
  } with {
    briefly "Translates payment gateway events"
    described as {
      | Receives payment status events from the external PaymentGateway
      | and translates them into commands for the Ticket entity.
    }
  }
  adaptor VenueAdapter from context VenueManagement as flow is { 
    inlet VenueAdapterIn is type VenueManagement.VenueManagementEvent
    outlet VenueAdapterToTicketContext is command TicketContext.ReleaseTickets
 with {
      briefly "What VenueAdapter publishes to TicketContext"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to TicketContext needs this port to travel on.
      }
    }
    handler InboundVenue is {
      on event VenueManagement.SeatingChartUpdated is {
        let releaseTickets: type TicketContext.ReleaseTickets = prompt("the release tickets that results from seating chart updated")
        tell releaseTickets to context TicketContext
      }
      on event VenueManagement.VenueCapacityChanged is {
        let releaseTickets: type TicketContext.ReleaseTickets = prompt("the release tickets that results from venue capacity changed")
        tell releaseTickets to context TicketContext
      }
      on other is {
        error "Unexpected message for adaptor VenueAdapter"
      }
    } with {
      briefly "Handles venue management events"
      described as {
        |Processes venue updates that affect ticket inventory.
      }
    }
  } with {
    briefly "Translates venue management events"
    described as {
      | Receives venue updates from the VenueManagement context
      | and adjusts ticket inventory accordingly.
    }
  }
  adaptor ToPaymentGateway to context PaymentGateway as flow is { 
    inlet ToPaymentGatewayIn is type TicketEvent
    outlet ToPaymentGatewayOut is type PaymentGateway.PaymentGatewayCommand
    handler ToPaymentGatewayHandler is {
      on ticketPurchased: event TicketPurchased is {
        let notice: type PaymentGateway.ProcessPayment = prompt("translate the ticketPurchased event into a ProcessPayment taking the buyer's payment for the ticket they have just committed to")
        send notice to outlet TicketContext.ToPaymentGateway.ToPaymentGatewayOut
      }
      on ticketRefunded: event TicketRefunded is {
        let notice: type PaymentGateway.RefundPayment = prompt("translate the ticketRefunded event into a RefundPayment returning the buyer's money for the ticket just refunded")
        send notice to outlet TicketContext.ToPaymentGateway.ToPaymentGatewayOut
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentGateway"
      }
    } with {
      briefly "to payment gateway"
      described as {
        |Carries messages to the external PaymentGateway.
      }
    }
  } with {
    briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor FromMarketingService from context MarketingService as sink is { 
    inlet FromMarketingServiceIn is type MarketingService.MarketingServiceEvent
    handler FromMarketingServiceHandler is {
      on campaignTriggered: event MarketingService.CampaignTriggered is {
        do "the campaign is running; announcing the event was recorded here"
      }
      on notificationSent: event MarketingService.NotificationSent is {
        do "the subscribers have been told; the ticket's own state is unchanged"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketingService"
      }
    } with {
      briefly "from marketing service"
      described as {
        |Carries messages from the external MarketingService.
      }
    }
  } with {
    briefly "MarketingService integration"
    described as {
      |The model's side of the MarketingService conversation.
    }
  }
  adaptor MarketingAdapter to context MarketingService as flow is { 
    inlet MarketingAdapterIn is type TicketEvent
    outlet MarketingAdapterOut is type MarketingService.MarketingCommand
    handler OutboundMarketing is {
      on eventCreated: event LiveEvent.EventCreated is {
        let announcement: type MarketingService.AnnounceEvent = prompt("translate the eventCreated event into an AnnounceEvent putting the new show in front of the audience")
        send announcement to outlet TicketContext.MarketingAdapter.MarketingAdapterOut
      }
      on ticketsReleased: event LiveEvent.TicketsReleased is {
        let notice: type MarketingService.NotifySubscribers = prompt("translate the ticketsReleased event into a NotifySubscribers telling followers that tickets are now on sale, which is the moment they can act on")
        send notice to outlet TicketContext.MarketingAdapter.MarketingAdapterOut
      }
      on ticketPurchased: event Ticket.TicketPurchased is {
        let confirmation: type MarketingService.SendConfirmation = prompt("translate the ticketPurchased event into a SendConfirmation giving the buyer their ticket details")
        send confirmation to outlet TicketContext.MarketingAdapter.MarketingAdapterOut
      }
      on ticketTransferred: event Ticket.TicketTransferred is {
        let notice: type MarketingService.NotifyTransfer = prompt("translate the ticketTransferred event into a NotifyTransfer telling the recipient a ticket is now theirs to claim")
        send notice to outlet TicketContext.MarketingAdapter.MarketingAdapterOut
      }
      on other is {
        error "Unexpected message for adaptor MarketingAdapter"
      }
    } with {
      briefly "Sends events to marketing service"
      described as {
        |Routes ticket events to marketing for notifications and campaigns.
      }
    }
  } with {
    briefly "Translates events for marketing"
    described as {
      | Sends relevant ticket events to the MarketingService context
      | for email notifications, announcements, and campaigns.
    }
  }
  // Repository for ticket persistence
  type TicketRepositoryCommand is one of {
    TicketContext.TicketRepository.PersistEventCreated or TicketContext.TicketRepository.PersistReservationCancelled or TicketContext.TicketRepository.PersistTicketPurchased or TicketContext.TicketRepository.PersistTicketRefunded or TicketContext.TicketRepository.PersistTicketReserved or TicketContext.TicketRepository.PersistTicketScanned or TicketContext.TicketRepository.PersistTicketTransferred or TicketContext.TicketRepository.PersistTicketsReleased
  } with {
    briefly "Anything that writes TicketRepository"
    described as {
      |The persistence commands TicketRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository TicketRepository as merge is {
    type TicketRepositoryQuery is one of {
      GetEventSalesMetrics or GetDailySalesMetrics
    } with {
      briefly "What may be asked of TicketRepository"
      described as {
        |The look-ups the ticket repository answers.
      }
    }
    type TicketRepositoryReply is one of {
      DailySalesMetricsView or EventSalesMetricsView
    } with {
      briefly "What TicketRepository answers"
      described as {
        |The answers the ticket repository gives.
      }
    }
    inlet TicketRepositoryQueries is type TicketRepositoryQuery with {
      briefly "Look-ups of this ticket repository"
      described as {
        |What TicketSalesApp asks of the ticket repository, by way of TicketContext.
      }
    }
    inlet TicketRepositoryFromSalesMetrics is type TicketRepositoryCommand
    command PersistReservationCancelled is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationCancelled applies to.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReservationCancelled"
      described as {
        |Instructs this repository to apply ReservationCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketReserved is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketReserved applies to.
        }
      }
      buyerId: BuyerId? with {
        briefly "Buyer id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      expiresAt: TimeStamp? with {
        briefly "Expires at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reservedAt: TimeStamp? with {
        briefly "Reserved at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TicketReserved"
      described as {
        |Instructs this repository to apply TicketReserved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketScanned is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketScanned applies to.
        }
      }
      eventId: EventId? with {
        briefly "Event id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      buyerId: BuyerId? with {
        briefly "Buyer id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      gateId: String(1,50)? with {
        briefly "Gate id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      scannedAt: TimeStamp? with {
        briefly "Scanned at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TicketScanned"
      described as {
        |Instructs this repository to apply TicketScanned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEventCreated is {
      eventId: EventId with {
        briefly "Row addressed"
        described as {
          |Which stored row EventCreated applies to.
        }
      }
      name: String(1,200)? with {
        briefly "Name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      venueId: VenueId? with {
        briefly "Venue id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      venueName: String(1,200)? with {
        briefly "Venue name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      eventDate: DateTime? with {
        briefly "Event date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      totalCapacity: Natural? with {
        briefly "Total capacity"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist EventCreated"
      described as {
        |Instructs this repository to apply EventCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketPurchased is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketPurchased applies to.
        }
      }
      eventId: EventId? with {
        briefly "Event id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      buyerId: BuyerId? with {
        briefly "Buyer id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      seatId: SeatId? with {
        briefly "Seat id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      section: String(1,50)? with {
        briefly "Section"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      pricingTier: String(1,50)? with {
        briefly "Pricing tier"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      amountPaid: Money? with {
        briefly "Amount paid"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      purchasedAt: TimeStamp? with {
        briefly "Purchased at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      paymentTransactionId: String(1,100)? with {
        briefly "Payment transaction id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TicketPurchased"
      described as {
        |Instructs this repository to apply TicketPurchased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketRefunded is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketRefunded applies to.
        }
      }
      eventId: EventId? with {
        briefly "Event id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      buyerId: BuyerId? with {
        briefly "Buyer id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      refundAmount: Money? with {
        briefly "Refund amount"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      refundedAt: TimeStamp? with {
        briefly "Refunded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TicketRefunded"
      described as {
        |Instructs this repository to apply TicketRefunded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketTransferred is {
      ticketId: TicketId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketTransferred applies to.
        }
      }
      eventId: EventId? with {
        briefly "Event id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      fromBuyerId: BuyerId? with {
        briefly "From buyer id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      toBuyerId: BuyerId? with {
        briefly "To buyer id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      transferredAt: TimeStamp? with {
        briefly "Transferred at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TicketTransferred"
      described as {
        |Instructs this repository to apply TicketTransferred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketsReleased is {
      eventId: EventId with {
        briefly "Row addressed"
        described as {
          |Which stored row TicketsReleased applies to.
        }
      }
      tierName: String(1,50)? with {
        briefly "Tier name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      quantity: Natural? with {
        briefly "Quantity"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      releasedAt: TimeStamp? with {
        briefly "Released at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TicketsReleased"
      described as {
        |Instructs this repository to apply TicketsReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet TicketRepositoryResponses is type TicketRepositoryReply
    record StoredLiveEvent is {
      eventId: EventId with {
        briefly "Event ID"
        described as {
          |Which show this row is.
        }
      }
      name: String(1,200)? with {
        briefly "Name"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      venueId: VenueId? with {
        briefly "Venue id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      venueName: String(1,200)? with {
        briefly "Venue name"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      eventDate: DateTime? with {
        briefly "Event date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      totalCapacity: Natural? with {
        briefly "Total capacity"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      tierName: String(1,50)? with {
        briefly "Tier name"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      quantity: Natural? with {
        briefly "Quantity"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      releasedAt: TimeStamp? with {
        briefly "Released at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored show row"
      described as {
        |The persistence shape of a show as this repository stores it.
      }
    }
    record StoredTicket is {
      ticketId: TicketId with {
        briefly "ticketId"
        described as {
          |The ticketId column of the stored ticket row.
        }
      }
      buyerId: BuyerId with {
        briefly "buyerId"
        described as {
          |The buyerId column of the stored ticket row.
        }
      }
      eventId: EventId with {
        briefly "eventId"
        described as {
          |The eventId column of the stored ticket row.
        }
      }
      seatId: SeatId with {
        briefly "seatId"
        described as {
          |The seatId column of the stored ticket row.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      expiresAt: TimeStamp? with {
        briefly "Expires at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reservedAt: TimeStamp? with {
        briefly "Reserved at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      gateId: String(1,50)? with {
        briefly "Gate id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      scannedAt: TimeStamp? with {
        briefly "Scanned at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      section: String(1,50)? with {
        briefly "Section"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      pricingTier: String(1,50)? with {
        briefly "Pricing tier"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      amountPaid: Money? with {
        briefly "Amount paid"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      purchasedAt: TimeStamp? with {
        briefly "Purchased at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      paymentTransactionId: String(1,100)? with {
        briefly "Payment transaction id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      refundAmount: Money? with {
        briefly "Refund amount"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      refundedAt: TimeStamp? with {
        briefly "Refunded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      fromBuyerId: BuyerId? with {
        briefly "From buyer id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      toBuyerId: BuyerId? with {
        briefly "To buyer id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      transferredAt: TimeStamp? with {
        briefly "Transferred at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored ticket row"
      described as {
        |The persistence shape of ticket data as this repository stores it.
      }
    }
    schema TicketData is relational
      of liveEvents as record StoredLiveEvent
      of tickets as record StoredTicket
        link ticketShow as field StoredTicket.eventId to field StoredLiveEvent.eventId
        key on field StoredLiveEvent.eventId
        key on field StoredTicket.ticketId
        index on field StoredTicket.eventId
        index on field StoredTicket.buyerId
        index on field StoredTicket.seatId
 with {
      briefly "Ticket data schema"
      described as {
        |The relational schema holding ticket data for the TicketRepository.
      }
    }
    handler TicketPersistence is {
      on persistReservationCancelled: command PersistReservationCancelled is {
        update TicketData.tickets set cancelledAt = persistReservationCancelled.cancelledAt where ticketId == persistReservationCancelled.ticketId
      }
      on persistTicketReserved: command PersistTicketReserved is {
        update TicketData.tickets set buyerId = persistTicketReserved.buyerId, expiresAt = persistTicketReserved.expiresAt, reservedAt = persistTicketReserved.reservedAt where ticketId == persistTicketReserved.ticketId
      }
      on persistTicketScanned: command PersistTicketScanned is {
        update TicketData.tickets set eventId = persistTicketScanned.eventId, buyerId = persistTicketScanned.buyerId, gateId = persistTicketScanned.gateId, scannedAt = persistTicketScanned.scannedAt where ticketId == persistTicketScanned.ticketId
      }
      on persistEventCreated: command PersistEventCreated is {
        store record StoredLiveEvent(eventId = persistEventCreated.eventId, name = persistEventCreated.name, venueId = persistEventCreated.venueId, venueName = persistEventCreated.venueName, eventDate = persistEventCreated.eventDate, totalCapacity = persistEventCreated.totalCapacity, createdAt = persistEventCreated.createdAt, tierName = empty, quantity = empty, releasedAt = empty) in TicketData.liveEvents
      }
      on persistTicketPurchased: command PersistTicketPurchased is {
        update TicketData.tickets set eventId = persistTicketPurchased.eventId, buyerId = persistTicketPurchased.buyerId, seatId = persistTicketPurchased.seatId, section = persistTicketPurchased.section, pricingTier = persistTicketPurchased.pricingTier, amountPaid = persistTicketPurchased.amountPaid, purchasedAt = persistTicketPurchased.purchasedAt, paymentTransactionId = persistTicketPurchased.paymentTransactionId where ticketId == persistTicketPurchased.ticketId
      }
      on persistTicketRefunded: command PersistTicketRefunded is {
        update TicketData.tickets set eventId = persistTicketRefunded.eventId, buyerId = persistTicketRefunded.buyerId, refundAmount = persistTicketRefunded.refundAmount, reason = persistTicketRefunded.reason, refundedAt = persistTicketRefunded.refundedAt where ticketId == persistTicketRefunded.ticketId
      }
      on persistTicketTransferred: command PersistTicketTransferred is {
        update TicketData.tickets set eventId = persistTicketTransferred.eventId, fromBuyerId = persistTicketTransferred.fromBuyerId, toBuyerId = persistTicketTransferred.toBuyerId, transferredAt = persistTicketTransferred.transferredAt where ticketId == persistTicketTransferred.ticketId
      }
      on persistTicketsReleased: command PersistTicketsReleased is {
        update TicketData.liveEvents set tierName = persistTicketsReleased.tierName, quantity = persistTicketsReleased.quantity, releasedAt = persistTicketsReleased.releasedAt where eventId == persistTicketsReleased.eventId
      }
      on query GetEventSalesMetrics is {
        let eventSalesMetricsView: type EventSalesMetricsView = prompt("read the event sales metrics projection")
        reply eventSalesMetricsView
      }
      on query GetDailySalesMetrics is {
        let dailySalesMetricsView: type DailySalesMetricsView = prompt("read the daily sales metrics projection")
        reply dailySalesMetricsView
      }
    } with {
      briefly "Persists ticket events to storage"
      described as {
        |Handles all event-driven persistence operations for tickets.
      }
    }
  } with {
    briefly "Persistent storage for ticket data"
    described as {
      | The TicketRepository provides persistent storage for tickets
      | with indexes optimized for common query patterns by event,
      | buyer, and seat.
    }
  }
  // Projector for sales metrics
  query GetEventSalesMetrics replies result EventSalesMetricsView is {
    eventSalesMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which event sales metrics to retrieve.
      }
    }
  } with {
    briefly "Get event sales metrics"
    described as {
      |Retrieves the event sales metrics projection.
    }
  }
  result EventSalesMetricsView is {
    eventSalesMetrics: SalesMetrics.EventSalesMetrics with {
      briefly "Event sales metrics"
      described as {
        |The event sales metrics being returned.
      }
    }
  } with {
    briefly "Event sales metrics view"
    described as {
      |Read model view carrying the event sales metrics projection.
    }
  }
  query GetDailySalesMetrics replies result DailySalesMetricsView is {
    dailySalesMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily sales metrics to retrieve.
      }
    }
  } with {
    briefly "Get daily sales metrics"
    described as {
      |Retrieves the daily sales metrics projection.
    }
  }
  result DailySalesMetricsView is {
    dailySalesMetrics: SalesMetrics.DailySalesMetrics with {
      briefly "Daily sales metrics"
      described as {
        |The daily sales metrics being returned.
      }
    }
  } with {
    briefly "Daily sales metrics view"
    described as {
      |Read model view carrying the daily sales metrics projection.
    }
  }
  projector SalesMetrics as flow is {
    updates repository TicketContext.TicketRepository
    outlet SalesMetricsToRepository is type TicketRepositoryCommand
    inlet SalesMetricsFromTicket is type TicketEvent
    record EventSalesMetrics is {
      eventId: EventId with {
        briefly "Event identifier"
        described as {
          |The event these metrics are for.
        }
      }
      totalCapacity: Natural with {
        briefly "Total capacity"
        described as {
          |Total tickets available for the event.
        }
      }
      ticketsSold: Natural with {
        briefly "Tickets sold"
        described as {
          |Number of tickets sold.
        }
      }
      ticketsReserved: Natural with {
        briefly "Tickets reserved"
        described as {
          |Currently reserved tickets.
        }
      }
      ticketsAvailable: Natural with {
        briefly "Tickets available"
        described as {
          |Remaining available tickets.
        }
      }
      ticketsRefunded: Natural with {
        briefly "Tickets refunded"
        described as {
          |Number of refunded tickets.
        }
      }
      grossRevenue: Money with {
        briefly "Gross revenue"
        described as {
          |Total revenue from ticket sales.
        }
      }
      netRevenue: Money with {
        briefly "Net revenue"
        described as {
          |Revenue minus refunds.
        }
      }
      averageTicketPrice: Money with {
        briefly "Average price"
        described as {
          |Average price per ticket sold.
        }
      }
      salesByTier: {
        tierName: String(1,50) with {
          briefly "Tier"
          described as {
            |Pricing tier name.
          }
        }
        sold: Natural with {
          briefly "Sold"
          described as {
            |Tickets sold in this tier.
          }
        }
        revenue: Money with {
          briefly "Revenue"
          described as {
            |Revenue from this tier.
          }
        }
      }
+ with {
        briefly "Sales by tier"
        described as {
          |Breakdown of sales by pricing tier.
        }
      }
      lastUpdated: TimeStamp with {
        briefly "Updated"
        described as {
          |When metrics were last calculated.
        }
      }
    } with {
      briefly "Aggregated sales metrics for an event"
      described as {
        |Real-time sales statistics for a single event.
      }
    }
    record DailySalesMetrics is {
      date: Date with {
        briefly "Date"
        described as {
          |The date for these metrics.
        }
      }
      totalTicketsSold: Natural with {
        briefly "Tickets sold"
        described as {
          |Total tickets sold this day.
        }
      }
      totalRevenue: Money with {
        briefly "Revenue"
        described as {
          |Total revenue for the day.
        }
      }
      ticketsByEvent: {
        eventId: EventId with {
          briefly "Event"
          described as {
            |Event identifier.
          }
        }
        eventName: String(1,200) with {
          briefly "Name"
          described as {
            |Event name.
          }
        }
        ticketsSold: Natural with {
          briefly "Sold"
          described as {
            |Tickets sold for this event.
          }
        }
        revenue: Money with {
          briefly "Revenue"
          described as {
            |Revenue for this event.
          }
        }
      }
+ with {
        briefly "Daily sales by event"
        described as {
          |Breakdown of daily sales by event.
        }
      }
      refundsProcessed: Natural with {
        briefly "Refunds"
        described as {
          |Number of refunds processed.
        }
      }
      refundTotal: Money with {
        briefly "Refund total"
        described as {
          |Total amount refunded.
        }
      }
      transfersCompleted: Natural with {
        briefly "Transfers"
        described as {
          |Number of ticket transfers.
        }
      }
    } with {
      briefly "Daily aggregated sales metrics"
      described as {
        |Aggregated sales statistics for a single day.
      }
    }
    handler SalesMetricsHandler is {
      on reservationCancelled: event Ticket.ReservationCancelled is {
        tell command TicketContext.TicketRepository.PersistReservationCancelled(ticketId = reservationCancelled.ticketId, cancelledAt = reservationCancelled.cancelledAt) to repository TicketContext.TicketRepository
        do "apply ReservationCancelled to the SalesMetrics projection"
      }
      on ticketReserved: event Ticket.TicketReserved is {
        tell command TicketContext.TicketRepository.PersistTicketReserved(ticketId = ticketReserved.ticketId, buyerId = ticketReserved.buyerId, expiresAt = ticketReserved.expiresAt, reservedAt = ticketReserved.reservedAt) to repository TicketContext.TicketRepository
        do "apply TicketReserved to the SalesMetrics projection"
      }
      on ticketScanned: event Ticket.TicketScanned is {
        tell command TicketContext.TicketRepository.PersistTicketScanned(ticketId = ticketScanned.ticketId, eventId = ticketScanned.eventId, buyerId = ticketScanned.buyerId, gateId = ticketScanned.gateId, scannedAt = ticketScanned.scannedAt) to repository TicketContext.TicketRepository
        do "apply TicketScanned to the SalesMetrics projection"
      }
      on ticketPurchased: event Ticket.TicketPurchased is {
        tell command TicketContext.TicketRepository.PersistTicketPurchased(ticketId = ticketPurchased.ticketId, eventId = ticketPurchased.eventId, buyerId = ticketPurchased.buyerId, seatId = ticketPurchased.seatId, section = ticketPurchased.section, pricingTier = ticketPurchased.pricingTier, amountPaid = ticketPurchased.amountPaid, purchasedAt = ticketPurchased.purchasedAt, paymentTransactionId = ticketPurchased.paymentTransactionId) to repository TicketContext.TicketRepository
      }
      on ticketRefunded: event Ticket.TicketRefunded is {
        tell command TicketContext.TicketRepository.PersistTicketRefunded(ticketId = ticketRefunded.ticketId, eventId = ticketRefunded.eventId, buyerId = ticketRefunded.buyerId, refundAmount = ticketRefunded.refundAmount, reason = ticketRefunded.reason, refundedAt = ticketRefunded.refundedAt) to repository TicketContext.TicketRepository
      }
      on ticketTransferred: event Ticket.TicketTransferred is {
        tell command TicketContext.TicketRepository.PersistTicketTransferred(ticketId = ticketTransferred.ticketId, eventId = ticketTransferred.eventId, fromBuyerId = ticketTransferred.fromBuyerId, toBuyerId = ticketTransferred.toBuyerId, transferredAt = ticketTransferred.transferredAt) to repository TicketContext.TicketRepository
      }
      on eventCreated: event LiveEvent.EventCreated is {
        tell command TicketContext.TicketRepository.PersistEventCreated(eventId = eventCreated.eventId, name = eventCreated.name, venueId = eventCreated.venueId, venueName = eventCreated.venueName, eventDate = eventCreated.eventDate, totalCapacity = eventCreated.totalCapacity, createdAt = eventCreated.createdAt) to repository TicketContext.TicketRepository
      }
      on ticketsReleased: event LiveEvent.TicketsReleased is {
        tell command TicketContext.TicketRepository.PersistTicketsReleased(eventId = ticketsReleased.eventId, tierName = ticketsReleased.tierName, quantity = ticketsReleased.quantity, releasedAt = ticketsReleased.releasedAt) to repository TicketContext.TicketRepository
      }
    } with {
      briefly "Projects ticket events for sales analytics"
      described as {
        |Maintains real-time sales metrics from ticket events.
      }
    }
  } with {
    briefly "Projects ticket events for sales reporting"
    described as {
      | Maintains aggregated views of sales data for dashboards,
      | promoter reporting, and business intelligence. Tracks
      | sales velocity, revenue, and inventory levels in real-time.
    }
  }
  connector 'TicketContext LiveEvent Answers' is from outlet TicketContext.TicketEventSplit.TicketEventSplitToTicketContext to inlet TicketContext.LiveEventAnswers
  connector 'PaymentAdapter Ticket Answers' is from outlet TicketContext.TicketEventSplit.TicketEventSplitToPaymentAdapter to inlet TicketContext.PaymentAdapter.TicketAnswers
  streamlet TicketEventSplit as router is {
    outlet TicketEventSplitToEventCreatedAnswer is event TicketSales.TicketContext.LiveEvent.EventCreated
    outlet TicketEventSplitToTicketContext is event LiveEvent.TicketsReleased
    outlet TicketEventSplitToPaymentAdapter is type TicketEvent
    inlet TicketEventSplitFromLiveEvent is type LiveEvent.LiveEventEvent
    outlet TicketEventSplitToToVenueManagement is type TicketEvent
    outlet TicketEventSplitToToPaymentGateway is type TicketEvent
    outlet TicketEventSplitToMarketingAdapter is type TicketEvent
    inlet TicketEventSplitIn is type TicketEvent
    outlet TicketEventSplitToSalesMetrics is type TicketEvent
    handler TicketEventSplitHandler is {
      on eventCreated: event LiveEvent.EventCreated is {
        send eventCreated to outlet TicketEventSplitToSalesMetrics
        send eventCreated to outlet TicketEventSplitToToVenueManagement
        send eventCreated to outlet TicketEventSplitToMarketingAdapter
        send eventCreated to outlet TicketEventSplitToEventCreatedAnswer
      }
      on ticketsReleased: event LiveEvent.TicketsReleased is {
        send ticketsReleased to outlet TicketEventSplitToTicketContext
        send ticketsReleased to outlet TicketEventSplitToSalesMetrics
        send ticketsReleased to outlet TicketEventSplitToMarketingAdapter
      }
      on ticketPurchased: event Ticket.TicketPurchased is {
        send ticketPurchased to outlet TicketEventSplitToPaymentAdapter
        send ticketPurchased to outlet TicketEventSplitToSalesMetrics
        send ticketPurchased to outlet TicketEventSplitToToPaymentGateway
        send ticketPurchased to outlet TicketEventSplitToMarketingAdapter
      }
      on ticketReserved: event Ticket.TicketReserved is {
        send ticketReserved to outlet TicketEventSplitToSalesMetrics
      }
      on ticketTransferred: event Ticket.TicketTransferred is {
        send ticketTransferred to outlet TicketEventSplitToSalesMetrics
        send ticketTransferred to outlet TicketEventSplitToMarketingAdapter
      }
      on ticketRefunded: event Ticket.TicketRefunded is {
        send ticketRefunded to outlet TicketEventSplitToSalesMetrics
        send ticketRefunded to outlet TicketEventSplitToToPaymentGateway
      }
      on reservationCancelled: event Ticket.ReservationCancelled is {
        send reservationCancelled to outlet TicketEventSplitToPaymentAdapter
        send reservationCancelled to outlet TicketEventSplitToSalesMetrics
      }
      on ticketScanned: event Ticket.TicketScanned is {
        send ticketScanned to outlet TicketEventSplitToSalesMetrics
      }
      on other is {
        error "Unexpected message for processor TicketEventSplit"
      }
    } with {
      briefly "Ticket event fan-out handler"
      described as {
        |Delivers each Ticket event to all of its consumers.
      }
    }
  } with {
    briefly "Ticket event fan-out"
    described as {
      |Fans Ticket events out to the repository and projectors.
    }
  }
  connector 'ToVenueManagement Feed' is from outlet TicketContext.TicketEventSplit.TicketEventSplitToToVenueManagement to inlet TicketContext.ToVenueManagement.ToVenueManagementIn with {
    briefly "The Ticket events ToVenueManagement translates, on their way to it"
  }
  connector 'ToPaymentGateway Feed' is from outlet TicketContext.TicketEventSplit.TicketEventSplitToToPaymentGateway to inlet TicketContext.ToPaymentGateway.ToPaymentGatewayIn with {
    briefly "The Ticket events ToPaymentGateway translates, on their way to it"
  }
  connector 'MarketingAdapter Feed' is from outlet TicketContext.TicketEventSplit.TicketEventSplitToMarketingAdapter to inlet TicketContext.MarketingAdapter.MarketingAdapterIn with {
    briefly "The Ticket events MarketingAdapter translates, on their way to it"
  }
  connector 'TicketEvent Stream' is from outlet TicketContext.Ticket.TicketEvents2 to inlet TicketContext.TicketEventSplit.TicketEventSplitIn with {
    briefly "Ticket events, fanned out to storage and read models"
  }
  connector 'LiveEventEvent Stream' is from outlet TicketContext.LiveEvent.LiveEventEvents to inlet TicketContext.TicketEventSplit.TicketEventSplitFromLiveEvent with {
    briefly "LiveEvent events, fanned out with the tickets' own"
  }
  connector 'SalesMetrics Feed' is from outlet TicketContext.TicketEventSplit.TicketEventSplitToSalesMetrics to inlet TicketContext.SalesMetrics.SalesMetricsFromTicket with {
    briefly "Ticket events feeding the SalesMetrics projection"
  }
  connector 'SalesMetrics Storage' is from outlet TicketContext.SalesMetrics.SalesMetricsToRepository to inlet TicketContext.TicketRepository.TicketRepositoryFromSalesMetrics with {
    briefly "SalesMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for ticket sales"
  described as {
    | The TicketContext is the primary bounded context for the Ticket
    | Sales domain. It contains the Ticket entity, repository for
    | persistence, projector for analytics, and adaptors for
    | integration with payment, venue, and marketing systems.
  }
}
