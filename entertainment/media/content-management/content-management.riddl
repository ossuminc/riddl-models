// Content Management Domain Model
// Digital content lifecycle, metadata, and distribution
domain ContentManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ContentManager is "person managing content library" with {
    briefly "Content Manager"
    described as {
      |Person overseeing content operations.
    }
  }
  user ContentCreator is "person creating media content" with {
    briefly "Content Creator"
    described as {
      |Person producing digital content.
    }
  }
  user RightsManager is "person managing content rights" with {
    briefly "Rights Manager"
    described as {
      |Person handling licensing and rights.
    }
  }
  epic ContentPublishingEpic is {
    user ContentManager wants to "to publish content to platforms" so that "audiences can access media"
    case PublishContentAsset is {
      user ContentManager wants to "to prepare and publish a content asset" so that "it is available for distribution"
      step is "Manager reviews" "content metadata" "for completeness" with {
        briefly "Review metadata"
        described as {
          |Check content details.
        }
      }
      step is "Manager verifies" "rights clearance" "for territories" with {
        briefly "Verify rights"
        described as {
          |Confirm distribution rights.
        }
      }
      step take input ContentManagementApp.ContentManagementScreen.PublishContentInput from user ContentManager with {
        briefly "Publish content"
        described as {
          |Make content available.
        }
      }
      step is "System distributes" "to delivery platforms" "for consumption" with {
        briefly "Distribute"
        described as {
          |Send to platforms.
        }
      }
    } with {
      briefly "Content publishing workflow"
      described as {
        |Standard flow for publishing content.
      }
    }
  } with {
    briefly "Content publishing processing"
    described as {
      | Epic covering content preparation, rights verification,
      | and platform distribution.
    }
  }
  include "ContentContext.riddl"
  include "external-contexts.riddl"
  application context ContentManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ContentManagement are delivered.
      }
    }
    group ContentManagementScreen is {
      input PublishContentInput acquires command ContentContext.Content.PublishContent with {
        briefly "Publish content control"
        described as {
          |The control through which a user submits the publish content request.
        }
      }
    } with {
      briefly "Content management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppContentCommands is type ContentContext.Content.ContentCommand
    inlet AppContentRepositoryResponses is type ContentContext.Content.ContentResult    handler ContentManagementAppHandler is {
      on other is {
        error "Unexpected message for application context ContentManagementApp"
      }
    } with {
      briefly "ContentManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ContentManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ContentCommand Stream' is from outlet ContentManagementApp.AppContentCommands to inlet ContentContext.ContentCommandStreamIn with {
    briefly "Content commands from the application"
  }
  persistent connector 'ContentResult Stream' is from outlet ContentContext.ContentResultStreamOut to inlet ContentManagementApp.AppContentRepositoryResponses with {
    briefly "Content query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ContentManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term DeliveryPlatform is  "A platform to which content is distributed for consumption." 
  briefly "Content management domain"
  described as {
    | The ContentManagement domain handles digital content
    | lifecycle, metadata, rights, and multi-platform distribution.
  }
}
