// Content Management - Content Context
context ContentContext as router is {
  inlet ContentContextFromToRightsService is command Content.RejectContent with {
    briefly "What ToRightsService makes of the answers it gets"
  }
  connector 'ToRightsService Intake' is from outlet ContentContext.ToRightsService.ToRightsServiceToContentContext to inlet ContentContext.ContentContextFromToRightsService with {
    briefly "Answers translated by ToRightsService, on their way in"
  }
  inlet ContentContextFromMediaAssetService is command Content.AddAsset with {
    briefly "What FromMediaAssetService makes of that service's news"
  }
  connector 'FromMediaAssetService Intake' is from outlet ContentContext.FromMediaAssetService.FromMediaAssetServiceToContentContext to inlet ContentContext.ContentContextFromMediaAssetService with {
    briefly "What FromMediaAssetService makes of that news, on its way in"
  }
  inlet ContentContextFromTranscodingService is command Content.CreateVersion with {
    briefly "What FromTranscodingService makes of that service's news"
  }
  connector 'FromTranscodingService Intake' is from outlet ContentContext.FromTranscodingService.FromTranscodingServiceToContentContext to inlet ContentContext.ContentContextFromTranscodingService with {
    briefly "What FromTranscodingService makes of that news, on its way in"
  }
  inlet ContentCommandStreamIn is type ContentCommand  outlet ContentCommandStreamOut is type ContentCommand
  inlet ContentResultStreamIn is result Content.ContentResult  outlet ContentResultStreamOut is result Content.ContentResult
  handler ContentContextBoundary is {
    on createContent: command Content.CreateContent is {
      send createContent to outlet ContentContext.ContentCommandStreamOut
    }
    on updateMetadata: command Content.UpdateMetadata is {
      send updateMetadata to outlet ContentContext.ContentCommandStreamOut
    }
    on addAsset: command Content.AddAsset is {
      send addAsset to outlet ContentContext.ContentCommandStreamOut
    }
    on removeAsset: command Content.RemoveAsset is {
      send removeAsset to outlet ContentContext.ContentCommandStreamOut
    }
    on createVersion: command Content.CreateVersion is {
      send createVersion to outlet ContentContext.ContentCommandStreamOut
    }
    on assignRights: command Content.AssignRights is {
      send assignRights to outlet ContentContext.ContentCommandStreamOut
    }
    on submitForReview: command Content.SubmitForReview is {
      send submitForReview to outlet ContentContext.ContentCommandStreamOut
    }
    on approveContent: command Content.ApproveContent is {
      send approveContent to outlet ContentContext.ContentCommandStreamOut
    }
    on rejectContent: command Content.RejectContent is {
      send rejectContent to outlet ContentContext.ContentCommandStreamOut
    }
    on publishContent: command Content.PublishContent is {
      send publishContent to outlet ContentContext.ContentCommandStreamOut
    }
    on unpublishContent: command Content.UnpublishContent is {
      send unpublishContent to outlet ContentContext.ContentCommandStreamOut
    }
    on archiveContent: command Content.ArchiveContent is {
      send archiveContent to outlet ContentContext.ContentCommandStreamOut
    }
    on contentResult: result Content.ContentResult is {
      send contentResult to outlet ContentContext.ContentResultStreamOut
    }
    on other is {
      error "Unexpected message at the ContentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ContentCommand Stream Intake' is from outlet ContentContext.ContentCommandStreamOut to inlet ContentContext.Content.ContentCommands  connector 'ContentResult Stream Egress' is from outlet ContentContext.ContentRepository.ContentRepositoryResponses to inlet ContentContext.ContentResultStreamIn  adaptor FromCDNService from context CDNService as sink is { 
    inlet FromCDNServiceIn is event CDNService.ContentDistributed    handler FromCDNServiceHandler is {
      on contentDistributed: event CDNService.ContentDistributed is {
        do "the CDN has it; publishing was decided here before it was pushed"
      }
      on other is {
        error "Unexpected message for adaptor FromCDNService"
      }
    } with {
      briefly "from cdn service"
      described as {
        |Carries messages from the external CDNService.
      }
    }
  } with {
    briefly "CDNService integration"
    described as {
      |The model's side of the CDNService conversation.
    }
  }
  adaptor ToCDNService to context CDNService as flow is { 
    inlet ToCDNServiceIn is type ContentEvent    outlet ToCDNServiceOut is command CDNService.DistributeContent
    handler ToCDNServiceHandler is {
      on contentPublished: event Content.ContentPublished is {
        let item0: type CDNService.DistributeContent = prompt("translate the contentPublished event into a DistributeContent, publication being what commits content to the edge")
        send item0 to outlet ContentContext.ToCDNService.ToCDNServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToCDNService"
      }
    } with {
      briefly "to cdn service"
      described as {
        |Carries messages to the external CDNService.
      }
    }
  } with {
    briefly "CDNService integration"
    described as {
      |The model's side of the CDNService conversation.
    }
  }
  adaptor FromMediaAssetService from context MediaAssetService as flow is { 
    inlet FromMediaAssetServiceIn is event MediaAssetService.AssetUploaded    outlet FromMediaAssetServiceToContentContext is command Content.AddAsset
    handler FromMediaAssetServiceHandler is {
      on assetUploaded: event MediaAssetService.AssetUploaded is {
        let item0: type Content.AddAsset = prompt("translate the assetUploaded event into a AddAsset, an asset that has actually landed is what the content record can point at")
        send item0 to outlet ContentContext.FromMediaAssetService.FromMediaAssetServiceToContentContext
      }
      on other is {
        error "Unexpected message for adaptor FromMediaAssetService"
      }
    } with {
      briefly "from media asset service"
      described as {
        |Carries messages from the external MediaAssetService.
      }
    }
  } with {
    briefly "MediaAssetService integration"
    described as {
      |The model's side of the MediaAssetService conversation.
    }
  }
  adaptor ToMediaAssetService to context MediaAssetService as flow is { 
    inlet ToMediaAssetServiceIn is type ContentEvent    outlet ToMediaAssetServiceOut is command MediaAssetService.UploadAsset
    handler ToMediaAssetServiceHandler is {
      on assetAdded: event Content.AssetAdded is {
        let item0: type MediaAssetService.UploadAsset = prompt("translate the assetAdded event into a UploadAsset, an attached asset having to live where the library can serve it")
        send item0 to outlet ContentContext.ToMediaAssetService.ToMediaAssetServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToMediaAssetService"
      }
    } with {
      briefly "to media asset service"
      described as {
        |Carries messages to the external MediaAssetService.
      }
    }
  } with {
    briefly "MediaAssetService integration"
    described as {
      |The model's side of the MediaAssetService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type ContentEvent    outlet ToNotificationServiceOut is command NotificationService.SendContentNotification
    handler ToNotificationServiceHandler is {
      on contentApproved: event ContentApproved is {
        let notice: type NotificationService.SendContentNotification = prompt("translate the contentApproved event into a SendContentNotification telling the author their content passed review and may be published")
        send notice to outlet ContentContext.ToNotificationService.ToNotificationServiceOut
      }
      on contentRejected: event ContentRejected is {
        let notice: type NotificationService.SendContentNotification = prompt("translate the contentRejected event into a SendContentNotification telling the author what was rejected and the recorded reason, since they must revise it")
        send notice to outlet ContentContext.ToNotificationService.ToNotificationServiceOut
      }
      on contentPublished: event ContentPublished is {
        let notice: type NotificationService.SendContentNotification = prompt("translate the contentPublished event into a SendContentNotification telling the author their content is live")
        send notice to outlet ContentContext.ToNotificationService.ToNotificationServiceOut
      }
      on contentUnpublished: event ContentUnpublished is {
        let notice: type NotificationService.SendContentNotification = prompt("translate the contentUnpublished event into a SendContentNotification telling the author their content has been taken down and why")
        send notice to outlet ContentContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToRightsService to context RightsService as router is { 
    outlet ToRightsServiceToContentContext is command Content.RejectContent
    inlet ToRightsServiceIn is type ContentEvent    inlet ToRightsServiceReplies is result RightsService.RightsClearance    outlet ToRightsServiceOut is query RightsService.CheckRightsClearance
    handler ToRightsServiceHandler is {
      on contentSubmittedForReview: event Content.ContentSubmittedForReview is {
        let askAnswer: type RightsService.RightsClearance = ask query RightsService.CheckRightsClearance of context RightsService
        do "content going to review needing its rights to be clear first"
        when prompt("not askAnswer.cleared") then
          send command Content.RejectContent(contentId = contentSubmittedForReview.contentId, rejectedBy = prompt("the rights service, acting for the review"), reason = prompt("the restrictions in askAnswer that block clearance")) to outlet ContentContext.ToRightsService.ToRightsServiceToContentContext
        end
      }
      on other is {
        error "Unexpected message for adaptor ToRightsService"
      }
    } with {
      briefly "to rights service"
      described as {
        |Carries messages to the external RightsService.
      }
    }
  } with {
    briefly "RightsService integration"
    described as {
      |The model's side of the RightsService conversation.
    }
  }
  adaptor FromSearchService from context SearchService as sink is { 
    inlet FromSearchServiceIn is event SearchService.ContentIndexed    handler FromSearchServiceHandler is {
      on contentIndexed: event SearchService.ContentIndexed is {
        do "the content is findable; publishing it here is what made it worth indexing"
      }
      on other is {
        error "Unexpected message for adaptor FromSearchService"
      }
    } with {
      briefly "from search service"
      described as {
        |Carries messages from the external SearchService.
      }
    }
  } with {
    briefly "SearchService integration"
    described as {
      |The model's side of the SearchService conversation.
    }
  }
  adaptor ToSearchService to context SearchService as flow is { 
    inlet ToSearchServiceIn is type ContentEvent    outlet ToSearchServiceOut is command SearchService.IndexContent
    handler ToSearchServiceHandler is {
      on contentPublished: event Content.ContentPublished is {
        let item0: type SearchService.IndexContent = prompt("translate the contentPublished event into a IndexContent, publication being what makes content findable")
        send item0 to outlet ContentContext.ToSearchService.ToSearchServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToSearchService"
      }
    } with {
      briefly "to search service"
      described as {
        |Carries messages to the external SearchService.
      }
    }
  } with {
    briefly "SearchService integration"
    described as {
      |The model's side of the SearchService conversation.
    }
  }
  adaptor FromTranscodingService from context TranscodingService as flow is { 
    inlet FromTranscodingServiceIn is event TranscodingService.TranscodingCompleted    outlet FromTranscodingServiceToContentContext is command Content.CreateVersion
    handler FromTranscodingServiceHandler is {
      on transcodingCompleted: event TranscodingService.TranscodingCompleted is {
        let item0: type Content.CreateVersion = prompt("translate the transcodingCompleted event into a CreateVersion, a transcoded rendition is a new version of the content, not a change to the old one")
        send item0 to outlet ContentContext.FromTranscodingService.FromTranscodingServiceToContentContext
      }
      on other is {
        error "Unexpected message for adaptor FromTranscodingService"
      }
    } with {
      briefly "from transcoding service"
      described as {
        |Carries messages from the external TranscodingService.
      }
    }
  } with {
    briefly "TranscodingService integration"
    described as {
      |The model's side of the TranscodingService conversation.
    }
  }
  adaptor ToTranscodingService to context TranscodingService as flow is { 
    inlet ToTranscodingServiceIn is type ContentEvent    outlet ToTranscodingServiceOut is command TranscodingService.TranscodeAsset
    handler ToTranscodingServiceHandler is {
      on assetAdded: event Content.AssetAdded is {
        let item0: type TranscodingService.TranscodeAsset = prompt("translate the assetAdded event into a TranscodeAsset, a new asset arriving in one format and needing others")
        send item0 to outlet ContentContext.ToTranscodingService.ToTranscodingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToTranscodingService"
      }
    } with {
      briefly "to transcoding service"
      described as {
        |Carries messages to the external TranscodingService.
      }
    }
  } with {
    briefly "TranscodingService integration"
    described as {
      |The model's side of the TranscodingService conversation.
    }
  }
  include "types.riddl"
  include "Content.riddl"
  // Repository for content persistence
  type ContentRepositoryCommand is one of {
    ContentContext.ContentRepository.PersistAssetAdded or ContentContext.ContentRepository.PersistAssetRemoved or ContentContext.ContentRepository.PersistContentApproved or ContentContext.ContentRepository.PersistContentArchived or ContentContext.ContentRepository.PersistContentCreated or ContentContext.ContentRepository.PersistContentPublished or ContentContext.ContentRepository.PersistContentRejected or ContentContext.ContentRepository.PersistContentSubmittedForReview or ContentContext.ContentRepository.PersistContentUnpublished or ContentContext.ContentRepository.PersistMetadataUpdated or ContentContext.ContentRepository.PersistRightsAssigned or ContentContext.ContentRepository.PersistVersionCreated
  } with {
    briefly "Anything that writes ContentRepository"
    described as {
      |The persistence commands ContentRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ContentRepository as flow is {
    inlet ContentRepositoryFromContentAnalytics is type ContentRepositoryCommand    command PersistAssetRemoved is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssetRemoved applies to.
        }
      }
      assetId: AssetId? with {
        briefly "Asset id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist AssetRemoved"
      described as {
        |Instructs this repository to apply AssetRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContentApproved is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContentApproved applies to.
        }
      }
      approvedBy: ContentUserId? with {
        briefly "Approved by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      approvedAt: TimeStamp? with {
        briefly "Approved at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ContentApproved"
      described as {
        |Instructs this repository to apply ContentApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContentRejected is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContentRejected applies to.
        }
      }
      rejectedBy: ContentUserId? with {
        briefly "Rejected by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String(1,1000)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      rejectedAt: TimeStamp? with {
        briefly "Rejected at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ContentRejected"
      described as {
        |Instructs this repository to apply ContentRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContentSubmittedForReview is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContentSubmittedForReview applies to.
        }
      }
      submittedBy: ContentUserId? with {
        briefly "Submitted by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      submittedAt: TimeStamp? with {
        briefly "Submitted at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ContentSubmittedForReview"
      described as {
        |Instructs this repository to apply ContentSubmittedForReview to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContentUnpublished is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContentUnpublished applies to.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      unpublishedAt: TimeStamp? with {
        briefly "Unpublished at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ContentUnpublished"
      described as {
        |Instructs this repository to apply ContentUnpublished to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMetadataUpdated is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row MetadataUpdated applies to.
        }
      }
      info: ContentInfo? with {
        briefly "Info"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MetadataUpdated"
      described as {
        |Instructs this repository to apply MetadataUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRightsAssigned is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row RightsAssigned applies to.
        }
      }
      rights: ContentRights? with {
        briefly "Rights"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist RightsAssigned"
      described as {
        |Instructs this repository to apply RightsAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVersionCreated is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row VersionCreated applies to.
        }
      }
      version: ContentVersion? with {
        briefly "Version"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist VersionCreated"
      described as {
        |Instructs this repository to apply VersionCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAssetAdded is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssetAdded applies to.
        }
      }
      asset: MediaAsset? with {
        briefly "Asset"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist AssetAdded"
      described as {
        |Instructs this repository to apply AssetAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContentArchived is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContentArchived applies to.
        }
      }
      archivedAt: TimeStamp? with {
        briefly "Archived at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ContentArchived"
      described as {
        |Instructs this repository to apply ContentArchived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContentCreated is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContentCreated applies to.
        }
      }
      info: ContentInfo? with {
        briefly "Info"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdBy: ContentUserId? with {
        briefly "Created by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ContentCreated"
      described as {
        |Instructs this repository to apply ContentCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContentPublished is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContentPublished applies to.
        }
      }
      publishedBy: ContentUserId? with {
        briefly "Published by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      publishedAt: TimeStamp? with {
        briefly "Published at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ContentPublished"
      described as {
        |Instructs this repository to apply ContentPublished to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ContentRepositoryResponses is result Content.ContentResult
    record StoredContent is {
      contentId: ContentId with {
        briefly "contentId"
        described as {
          |The contentId column of the stored content row.
        }
      }
      info: ContentInfo with {
        briefly "info"
        described as {
          |The info column of the stored content row.
        }
      }
      assetId: AssetId? with {
        briefly "Asset id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      approvedBy: ContentUserId? with {
        briefly "Approved by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      approvedAt: TimeStamp? with {
        briefly "Approved at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      rejectedBy: ContentUserId? with {
        briefly "Rejected by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,1000)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      rejectedAt: TimeStamp? with {
        briefly "Rejected at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      submittedBy: ContentUserId? with {
        briefly "Submitted by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      submittedAt: TimeStamp? with {
        briefly "Submitted at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      unpublishedAt: TimeStamp? with {
        briefly "Unpublished at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      rights: ContentRights? with {
        briefly "Rights"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      version: ContentVersion? with {
        briefly "Version"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      asset: MediaAsset? with {
        briefly "Asset"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      archivedAt: TimeStamp? with {
        briefly "Archived at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdBy: ContentUserId? with {
        briefly "Created by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      publishedBy: ContentUserId? with {
        briefly "Published by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      publishedAt: TimeStamp? with {
        briefly "Published at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored content row"
      described as {
        |The persistence shape of content data as this repository stores it.
      }
    }
    schema ContentData is relational
      of contents as record StoredContent
        key on field StoredContent.contentId
        index on field StoredContent.info.contentType
 with {
      briefly "Content data schema"
      described as {
        |The relational schema holding content data for the ContentRepository.
      }
    }
    handler ContentPersistence is {
      on persistAssetRemoved: command PersistAssetRemoved is {
        update ContentData.contents set assetId = persistAssetRemoved.assetId, removedAt = persistAssetRemoved.removedAt where contentId == persistAssetRemoved.contentId
      }
      on persistContentApproved: command PersistContentApproved is {
        update ContentData.contents set approvedBy = persistContentApproved.approvedBy, approvedAt = persistContentApproved.approvedAt where contentId == persistContentApproved.contentId
      }
      on persistContentRejected: command PersistContentRejected is {
        update ContentData.contents set rejectedBy = persistContentRejected.rejectedBy, reason = persistContentRejected.reason, rejectedAt = persistContentRejected.rejectedAt where contentId == persistContentRejected.contentId
      }
      on persistContentSubmittedForReview: command PersistContentSubmittedForReview is {
        update ContentData.contents set submittedBy = persistContentSubmittedForReview.submittedBy, submittedAt = persistContentSubmittedForReview.submittedAt where contentId == persistContentSubmittedForReview.contentId
      }
      on persistContentUnpublished: command PersistContentUnpublished is {
        update ContentData.contents set reason = persistContentUnpublished.reason, unpublishedAt = persistContentUnpublished.unpublishedAt where contentId == persistContentUnpublished.contentId
      }
      on persistMetadataUpdated: command PersistMetadataUpdated is {
        update ContentData.contents set info = persistMetadataUpdated.info, updatedAt = persistMetadataUpdated.updatedAt where contentId == persistMetadataUpdated.contentId
      }
      on persistRightsAssigned: command PersistRightsAssigned is {
        update ContentData.contents set rights = persistRightsAssigned.rights, assignedAt = persistRightsAssigned.assignedAt where contentId == persistRightsAssigned.contentId
      }
      on persistVersionCreated: command PersistVersionCreated is {
        update ContentData.contents set version = persistVersionCreated.version, createdAt = persistVersionCreated.createdAt where contentId == persistVersionCreated.contentId
      }
      on persistAssetAdded: command PersistAssetAdded is {
        update ContentData.contents set asset = persistAssetAdded.asset, addedAt = persistAssetAdded.addedAt where contentId == persistAssetAdded.contentId
      }
      on persistContentArchived: command PersistContentArchived is {
        update ContentData.contents set archivedAt = persistContentArchived.archivedAt where contentId == persistContentArchived.contentId
      }
      on persistContentCreated: command PersistContentCreated is {
        update ContentData.contents set info = persistContentCreated.info, createdBy = persistContentCreated.createdBy, createdAt = persistContentCreated.createdAt where contentId == persistContentCreated.contentId
      }
      on persistContentPublished: command PersistContentPublished is {
        update ContentData.contents set publishedBy = persistContentPublished.publishedBy, publishedAt = persistContentPublished.publishedAt where contentId == persistContentPublished.contentId
      }
      on query GetContentStats is {
        let contentStatsView: type ContentStatsView = prompt("read the content stats projection")
        reply contentStatsView
      }
    } with {
      briefly "Persists content commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Content data persistence"
    described as {
      | The ContentRepository provides persistent storage for
      | content items, assets, and rights.
    }
  }
  // Projector for content analytics
  query GetContentStats replies result ContentStatsView is {
    contentStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which content stats to retrieve.
      }
    }
  } with {
    briefly "Get content stats"
    described as {
      |Retrieves the content stats projection.
    }
  }
  result ContentStatsView is {
    contentStats: ContentAnalytics.ContentStats with {
      briefly "Content stats"
      described as {
        |The content stats being returned.
      }
    }
  } with {
    briefly "Content stats view"
    described as {
      |Read model view carrying the content stats projection.
    }
  }
  projector ContentAnalytics as flow is {
    updates repository ContentContext.ContentRepository
    outlet ContentAnalyticsToRepository is type ContentRepositoryCommand
    inlet ContentAnalyticsFromContent is type ContentEvent    record ContentStats is {
      contentType: ContentType with {
        briefly "Type"
        described as {
          |Content type.
        }
      }
      totalItems: Natural with {
        briefly "Items"
        described as {
          |Total content items.
        }
      }
      publishedItems: Natural with {
        briefly "Published"
        described as {
          |Published items.
        }
      }
      totalAssets: Natural with {
        briefly "Assets"
        described as {
          |Total assets.
        }
      }
      totalStorageBytes: Natural with {
        briefly "Storage"
        described as {
          |Total storage used.
        }
      }
    } with {
      briefly "Content statistics"
      described as {
        |Content library metrics.
      }
    }
    handler AnalyticsHandler is {
      on assetRemoved: event Content.AssetRemoved is {
        tell command ContentContext.ContentRepository.PersistAssetRemoved(contentId = assetRemoved.contentId, assetId = assetRemoved.assetId, removedAt = assetRemoved.removedAt) to repository ContentContext.ContentRepository
        do "apply AssetRemoved to the ContentAnalytics projection"
      }
      on contentApproved: event Content.ContentApproved is {
        tell command ContentContext.ContentRepository.PersistContentApproved(contentId = contentApproved.contentId, approvedBy = contentApproved.approvedBy, approvedAt = contentApproved.approvedAt) to repository ContentContext.ContentRepository
        do "apply ContentApproved to the ContentAnalytics projection"
      }
      on contentRejected: event Content.ContentRejected is {
        tell command ContentContext.ContentRepository.PersistContentRejected(contentId = contentRejected.contentId, rejectedBy = contentRejected.rejectedBy, reason = contentRejected.reason, rejectedAt = contentRejected.rejectedAt) to repository ContentContext.ContentRepository
        do "apply ContentRejected to the ContentAnalytics projection"
      }
      on contentSubmittedForReview: event Content.ContentSubmittedForReview is {
        tell command ContentContext.ContentRepository.PersistContentSubmittedForReview(contentId = contentSubmittedForReview.contentId, submittedBy = contentSubmittedForReview.submittedBy, submittedAt = contentSubmittedForReview.submittedAt) to repository ContentContext.ContentRepository
        do "apply ContentSubmittedForReview to the ContentAnalytics projection"
      }
      on contentUnpublished: event Content.ContentUnpublished is {
        tell command ContentContext.ContentRepository.PersistContentUnpublished(contentId = contentUnpublished.contentId, reason = contentUnpublished.reason, unpublishedAt = contentUnpublished.unpublishedAt) to repository ContentContext.ContentRepository
        do "apply ContentUnpublished to the ContentAnalytics projection"
      }
      on metadataUpdated: event Content.MetadataUpdated is {
        tell command ContentContext.ContentRepository.PersistMetadataUpdated(contentId = metadataUpdated.contentId, info = metadataUpdated.info, updatedAt = metadataUpdated.updatedAt) to repository ContentContext.ContentRepository
        do "apply MetadataUpdated to the ContentAnalytics projection"
      }
      on rightsAssigned: event Content.RightsAssigned is {
        tell command ContentContext.ContentRepository.PersistRightsAssigned(contentId = rightsAssigned.contentId, rights = rightsAssigned.rights, assignedAt = rightsAssigned.assignedAt) to repository ContentContext.ContentRepository
        do "apply RightsAssigned to the ContentAnalytics projection"
      }
      on versionCreated: event Content.VersionCreated is {
        tell command ContentContext.ContentRepository.PersistVersionCreated(contentId = versionCreated.contentId, version = versionCreated.version, createdAt = versionCreated.createdAt) to repository ContentContext.ContentRepository
        do "apply VersionCreated to the ContentAnalytics projection"
      }
      on contentCreated: event Content.ContentCreated is {
        tell command ContentContext.ContentRepository.PersistContentCreated(contentId = contentCreated.contentId, info = contentCreated.info, createdBy = contentCreated.createdBy, createdAt = contentCreated.createdAt) to repository ContentContext.ContentRepository
      }
      on assetAdded: event Content.AssetAdded is {
        tell command ContentContext.ContentRepository.PersistAssetAdded(contentId = assetAdded.contentId, asset = assetAdded.asset, addedAt = assetAdded.addedAt) to repository ContentContext.ContentRepository
      }
      on contentPublished: event Content.ContentPublished is {
        tell command ContentContext.ContentRepository.PersistContentPublished(contentId = contentPublished.contentId, publishedBy = contentPublished.publishedBy, publishedAt = contentPublished.publishedAt) to repository ContentContext.ContentRepository
      }
      on contentArchived: event Content.ContentArchived is {
        tell command ContentContext.ContentRepository.PersistContentArchived(contentId = contentArchived.contentId, archivedAt = contentArchived.archivedAt) to repository ContentContext.ContentRepository
      }
    } with {
      briefly "Maintains content analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Content analytics projections"
    described as {
      |Maintains content library analytics data.
    }
  }
  streamlet ContentEventSplit as split is {
    outlet ContentEventSplitToToTranscodingService is type ContentEvent
    outlet ContentEventSplitToToSearchService is type ContentEvent
    outlet ContentEventSplitToToRightsService is type ContentEvent
    outlet ContentEventSplitToToNotificationService is type ContentEvent
    outlet ContentEventSplitToToMediaAssetService is type ContentEvent
    outlet ContentEventSplitToToCDNService is type ContentEvent
    inlet ContentEventSplitIn is type ContentEvent    outlet ContentEventSplitToContentAnalytics is type ContentEvent
    handler ContentEventSplitHandler is {
      on contentCreated: event Content.ContentCreated is {
        send contentCreated to outlet ContentEventSplitToContentAnalytics
        tell contentCreated to entity ContentContext.Content
      }
      on metadataUpdated: event Content.MetadataUpdated is {
        send metadataUpdated to outlet ContentEventSplitToContentAnalytics
        tell metadataUpdated to entity ContentContext.Content
      }
      on assetAdded: event Content.AssetAdded is {
        send assetAdded to outlet ContentEventSplitToContentAnalytics
        send assetAdded to outlet ContentEventSplitToToTranscodingService
        send assetAdded to outlet ContentEventSplitToToMediaAssetService
        tell assetAdded to entity ContentContext.Content
      }
      on assetRemoved: event Content.AssetRemoved is {
        send assetRemoved to outlet ContentEventSplitToContentAnalytics
        tell assetRemoved to entity ContentContext.Content
      }
      on versionCreated: event Content.VersionCreated is {
        send versionCreated to outlet ContentEventSplitToContentAnalytics
        tell versionCreated to entity ContentContext.Content
      }
      on rightsAssigned: event Content.RightsAssigned is {
        send rightsAssigned to outlet ContentEventSplitToContentAnalytics
        tell rightsAssigned to entity ContentContext.Content
      }
      on contentSubmittedForReview: event Content.ContentSubmittedForReview is {
        send contentSubmittedForReview to outlet ContentEventSplitToContentAnalytics
        send contentSubmittedForReview to outlet ContentEventSplitToToRightsService
        tell contentSubmittedForReview to entity ContentContext.Content
      }
      on contentApproved: event Content.ContentApproved is {
        send contentApproved to outlet ContentEventSplitToContentAnalytics
        send contentApproved to outlet ContentEventSplitToToNotificationService
        tell contentApproved to entity ContentContext.Content
      }
      on contentRejected: event Content.ContentRejected is {
        send contentRejected to outlet ContentEventSplitToContentAnalytics
        send contentRejected to outlet ContentEventSplitToToNotificationService
        tell contentRejected to entity ContentContext.Content
      }
      on contentPublished: event Content.ContentPublished is {
        send contentPublished to outlet ContentEventSplitToContentAnalytics
        send contentPublished to outlet ContentEventSplitToToSearchService
        send contentPublished to outlet ContentEventSplitToToNotificationService
        send contentPublished to outlet ContentEventSplitToToCDNService
        tell contentPublished to entity ContentContext.Content
      }
      on contentUnpublished: event Content.ContentUnpublished is {
        send contentUnpublished to outlet ContentEventSplitToContentAnalytics
        send contentUnpublished to outlet ContentEventSplitToToNotificationService
        tell contentUnpublished to entity ContentContext.Content
      }
      on contentArchived: event Content.ContentArchived is {
        send contentArchived to outlet ContentEventSplitToContentAnalytics
        tell contentArchived to entity ContentContext.Content
      }
      on other is {
        error "Unexpected message for processor ContentEventSplit"
      }
    } with {
      briefly "Content event fan-out handler"
      described as {
        |Delivers each Content event to all of its consumers.
      }
    }
  } with {
    briefly "Content event fan-out"
    described as {
      |Fans Content events out to the repository and projectors.
    }
  }
  connector 'ToTranscodingService Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToToTranscodingService to inlet ContentContext.ToTranscodingService.ToTranscodingServiceIn with {
    briefly "The Content events ToTranscodingService translates, on their way to it"
  }
  connector 'ToSearchService Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToToSearchService to inlet ContentContext.ToSearchService.ToSearchServiceIn with {
    briefly "The Content events ToSearchService translates, on their way to it"
  }
  connector 'ToRightsService Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToToRightsService to inlet ContentContext.ToRightsService.ToRightsServiceIn with {
    briefly "The Content events ToRightsService translates, on their way to it"
  }
  connector 'ToNotificationService Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToToNotificationService to inlet ContentContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The Content events ToNotificationService translates, on their way to it"
  }
  connector 'ToMediaAssetService Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToToMediaAssetService to inlet ContentContext.ToMediaAssetService.ToMediaAssetServiceIn with {
    briefly "The Content events ToMediaAssetService translates, on their way to it"
  }
  connector 'ToCDNService Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToToCDNService to inlet ContentContext.ToCDNService.ToCDNServiceIn with {
    briefly "The Content events ToCDNService translates, on their way to it"
  }
  connector 'ContentEvent Stream' is from outlet ContentContext.Content.ContentEvents2 to inlet ContentContext.ContentEventSplit.ContentEventSplitIn with {
    briefly "Content events, fanned out to storage and read models"
  }
  connector 'ContentAnalytics Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToContentAnalytics to inlet ContentContext.ContentAnalytics.ContentAnalyticsFromContent with {
    briefly "Content events feeding the ContentAnalytics projection"
  }
  connector 'ContentAnalytics Storage' is from outlet ContentContext.ContentAnalytics.ContentAnalyticsToRepository to inlet ContentContext.ContentRepository.ContentRepositoryFromContentAnalytics with {
    briefly "ContentAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for content management"
  described as {
    | The ContentContext is the bounded context for digital
    | content lifecycle, metadata, and distribution management.
  }
}
