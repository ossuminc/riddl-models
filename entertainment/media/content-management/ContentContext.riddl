// Content Management - Content Context
context ContentContext as router is {
  inlet ContentCommandStreamIn is type ContentCommand
  outlet ContentCommandStreamOut is type ContentCommand
  inlet ContentResultStreamIn is type Content.ContentResult
  outlet ContentResultStreamOut is type Content.ContentResult
  handler ContentContextBoundary is {
    on createContent: command Content.CreateContent is {
      send createContent to outlet ContentContext.ContentCommandStreamOut
    }
    on updateMetadata: command Content.UpdateMetadata is {
      send updateMetadata to outlet ContentContext.ContentCommandStreamOut
    }
    on addAsset: command Content.AddAsset is {
      send addAsset to outlet ContentContext.ContentCommandStreamOut
    }
    on removeAsset: command Content.RemoveAsset is {
      send removeAsset to outlet ContentContext.ContentCommandStreamOut
    }
    on createVersion: command Content.CreateVersion is {
      send createVersion to outlet ContentContext.ContentCommandStreamOut
    }
    on assignRights: command Content.AssignRights is {
      send assignRights to outlet ContentContext.ContentCommandStreamOut
    }
    on submitForReview: command Content.SubmitForReview is {
      send submitForReview to outlet ContentContext.ContentCommandStreamOut
    }
    on approveContent: command Content.ApproveContent is {
      send approveContent to outlet ContentContext.ContentCommandStreamOut
    }
    on rejectContent: command Content.RejectContent is {
      send rejectContent to outlet ContentContext.ContentCommandStreamOut
    }
    on publishContent: command Content.PublishContent is {
      send publishContent to outlet ContentContext.ContentCommandStreamOut
    }
    on unpublishContent: command Content.UnpublishContent is {
      send unpublishContent to outlet ContentContext.ContentCommandStreamOut
    }
    on archiveContent: command Content.ArchiveContent is {
      send archiveContent to outlet ContentContext.ContentCommandStreamOut
    }
    on initializeContent: command Content.InitializeContent is {
      send initializeContent to outlet ContentContext.ContentCommandStreamOut
    }
    on contentResult: result Content.ContentResult is {
      send contentResult to outlet ContentContext.ContentResultStreamOut
    }
    on other is {
      error "Unexpected message at the ContentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ContentCommand Stream Intake' is from outlet ContentContext.ContentCommandStreamOut to inlet ContentContext.Content.ContentCommands
  connector 'ContentResult Stream Egress' is from outlet ContentContext.ContentRepository.ContentRepositoryResponses to inlet ContentContext.ContentResultStreamIn
  adaptor FromCDNService from context CDNService is { 
    handler FromCDNServiceHandler is {
      on event CDNService.ContentDistributed is {
        do "the model receives content distributed"
      }
      on other is {
        error "Unexpected message for adaptor FromCDNService"
      }
    } with {
      briefly "from cdn service"
      described as {
        |Carries messages from the external CDNService.
      }
    }
  } with {
    briefly "CDNService integration"
    described as {
      |The model's side of the CDNService conversation.
    }
  }
  adaptor ToCDNService to context CDNService is { 
    handler ToCDNServiceHandler is {
      on command CDNService.DistributeContent is {
        do "the model sends distribute content"
      }
      on other is {
        error "Unexpected message for adaptor ToCDNService"
      }
    } with {
      briefly "to cdn service"
      described as {
        |Carries messages to the external CDNService.
      }
    }
  } with {
    briefly "CDNService integration"
    described as {
      |The model's side of the CDNService conversation.
    }
  }
  adaptor FromMediaAssetService from context MediaAssetService is { 
    handler FromMediaAssetServiceHandler is {
      on event MediaAssetService.AssetUploaded is {
        do "the model receives asset uploaded"
      }
      on other is {
        error "Unexpected message for adaptor FromMediaAssetService"
      }
    } with {
      briefly "from media asset service"
      described as {
        |Carries messages from the external MediaAssetService.
      }
    }
  } with {
    briefly "MediaAssetService integration"
    described as {
      |The model's side of the MediaAssetService conversation.
    }
  }
  adaptor ToMediaAssetService to context MediaAssetService is { 
    handler ToMediaAssetServiceHandler is {
      on command MediaAssetService.UploadAsset is {
        do "the model sends upload asset"
      }
      on other is {
        error "Unexpected message for adaptor ToMediaAssetService"
      }
    } with {
      briefly "to media asset service"
      described as {
        |Carries messages to the external MediaAssetService.
      }
    }
  } with {
    briefly "MediaAssetService integration"
    described as {
      |The model's side of the MediaAssetService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendContentNotification is {
        do "the model sends send content notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromRightsService from context RightsService is { 
    handler FromRightsServiceHandler is {
      on result RightsService.RightsClearance is {
        do "the model receives rights clearance"
      }
      on other is {
        error "Unexpected message for adaptor FromRightsService"
      }
    } with {
      briefly "from rights service"
      described as {
        |Carries messages from the external RightsService.
      }
    }
  } with {
    briefly "RightsService integration"
    described as {
      |The model's side of the RightsService conversation.
    }
  }
  adaptor ToRightsService to context RightsService is { 
    handler ToRightsServiceHandler is {
      on query RightsService.CheckRightsClearance is {
        do "the model sends check rights clearance"
      }
      on other is {
        error "Unexpected message for adaptor ToRightsService"
      }
    } with {
      briefly "to rights service"
      described as {
        |Carries messages to the external RightsService.
      }
    }
  } with {
    briefly "RightsService integration"
    described as {
      |The model's side of the RightsService conversation.
    }
  }
  adaptor FromSearchService from context SearchService is { 
    handler FromSearchServiceHandler is {
      on event SearchService.ContentIndexed is {
        do "the model receives content indexed"
      }
      on other is {
        error "Unexpected message for adaptor FromSearchService"
      }
    } with {
      briefly "from search service"
      described as {
        |Carries messages from the external SearchService.
      }
    }
  } with {
    briefly "SearchService integration"
    described as {
      |The model's side of the SearchService conversation.
    }
  }
  adaptor ToSearchService to context SearchService is { 
    handler ToSearchServiceHandler is {
      on command SearchService.IndexContent is {
        do "the model sends index content"
      }
      on other is {
        error "Unexpected message for adaptor ToSearchService"
      }
    } with {
      briefly "to search service"
      described as {
        |Carries messages to the external SearchService.
      }
    }
  } with {
    briefly "SearchService integration"
    described as {
      |The model's side of the SearchService conversation.
    }
  }
  adaptor FromTranscodingService from context TranscodingService is { 
    handler FromTranscodingServiceHandler is {
      on event TranscodingService.TranscodingCompleted is {
        do "the model receives transcoding completed"
      }
      on other is {
        error "Unexpected message for adaptor FromTranscodingService"
      }
    } with {
      briefly "from transcoding service"
      described as {
        |Carries messages from the external TranscodingService.
      }
    }
  } with {
    briefly "TranscodingService integration"
    described as {
      |The model's side of the TranscodingService conversation.
    }
  }
  adaptor ToTranscodingService to context TranscodingService is { 
    handler ToTranscodingServiceHandler is {
      on command TranscodingService.TranscodeAsset is {
        do "the model sends transcode asset"
      }
      on other is {
        error "Unexpected message for adaptor ToTranscodingService"
      }
    } with {
      briefly "to transcoding service"
      described as {
        |Carries messages to the external TranscodingService.
      }
    }
  } with {
    briefly "TranscodingService integration"
    described as {
      |The model's side of the TranscodingService conversation.
    }
  }
  include "types.riddl"
  include "Content.riddl"
  // Repository for content persistence
  repository ContentRepository as merge is {
    inlet ContentRepositoryFromContent is type ContentEvent    inlet ContentRepositoryFromContentAnalytics is type ContentEvent    outlet ContentRepositoryResponses is type Content.ContentResult
    record StoredContent is  {
      contentId: ContentId with {
        briefly "contentId"
        described as {
          |The contentId column of the stored content row.
        }
      }
      info: ContentInfo with {
        briefly "info"
        described as {
          |The info column of the stored content row.
        }
      }
    } with {
      briefly "Stored content row"
      described as {
        |The persistence shape of content data as this repository stores it.
      }
    }
    schema ContentData is relational
      of contents as type StoredContent
        index on field StoredContent.contentId
        index on field StoredContent.info.contentType
 with {
      briefly "Content data schema"
      described as {
        |The relational schema holding content data for the ContentRepository.
      }
    }
    handler ContentPersistence is {
      on query GetContentStats is {
        let contentStatsView: type ContentStatsView = prompt("read the content stats projection")
        reply contentStatsView
      }
      on createContent: command Content.CreateContent is {
        tell event Content.ContentCreated(contentId = createContent.contentId, info = createContent.info, createdBy = createContent.createdBy) to entity ContentContext.Content
      }
      on updateMetadata: command Content.UpdateMetadata is {
        tell event Content.MetadataUpdated(contentId = updateMetadata.contentId, info = updateMetadata.info) to entity ContentContext.Content
      }
      on addAsset: command Content.AddAsset is {
        tell event Content.AssetAdded(contentId = addAsset.contentId, asset = addAsset.asset) to entity ContentContext.Content
      }
      on removeAsset: command Content.RemoveAsset is {
        tell event Content.AssetRemoved(contentId = removeAsset.contentId, assetId = removeAsset.assetId) to entity ContentContext.Content
      }
      on createVersion: command Content.CreateVersion is {
        tell event Content.VersionCreated(contentId = createVersion.contentId, version = createVersion.version) to entity ContentContext.Content
      }
      on assignRights: command Content.AssignRights is {
        tell event Content.RightsAssigned(contentId = assignRights.contentId, rights = assignRights.rights) to entity ContentContext.Content
      }
      on submitForReview: command Content.SubmitForReview is {
        tell event Content.ContentSubmittedForReview(contentId = submitForReview.contentId, submittedBy = submitForReview.submittedBy) to entity ContentContext.Content
      }
      on approveContent: command Content.ApproveContent is {
        tell event Content.ContentApproved(contentId = approveContent.contentId, approvedBy = approveContent.approvedBy) to entity ContentContext.Content
      }
      on rejectContent: command Content.RejectContent is {
        tell event Content.ContentRejected(contentId = rejectContent.contentId, rejectedBy = rejectContent.rejectedBy, reason = rejectContent.reason) to entity ContentContext.Content
      }
      on publishContent: command Content.PublishContent is {
        tell event Content.ContentPublished(contentId = publishContent.contentId, publishedBy = publishContent.publishedBy) to entity ContentContext.Content
      }
      on unpublishContent: command Content.UnpublishContent is {
        tell event Content.ContentUnpublished(contentId = unpublishContent.contentId, reason = unpublishContent.reason) to entity ContentContext.Content
      }
      on archiveContent: command Content.ArchiveContent is {
        tell event Content.ContentArchived(contentId = archiveContent.contentId) to entity ContentContext.Content
      }
    } with {
      briefly "Persists content commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Content data persistence"
    described as {
      | The ContentRepository provides persistent storage for
      | content items, assets, and rights.
    }
  }
  // Projector for content analytics
  query GetContentStats is  {
    contentStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which content stats to retrieve.
      }
    }
  } with {
    briefly "Get content stats"
    described as {
      |Retrieves the content stats projection.
    }
  }
  result ContentStatsView is  {
    contentStats: ContentAnalytics.ContentStats with {
      briefly "Content stats"
      described as {
        |The content stats being returned.
      }
    }
  } with {
    briefly "Content stats view"
    described as {
      |Read model view carrying the content stats projection.
    }
  }
  projector ContentAnalytics as flow is {
    updates repository ContentContext.ContentRepository
    inlet ContentAnalyticsFromContent is type ContentEvent    outlet ContentAnalyticsOut is type ContentEvent
    record ContentStats is  {
      contentType: ContentType with {
        briefly "Type"
        described as {
          |Content type.
        }
      }
      totalItems: Natural with {
        briefly "Items"
        described as {
          |Total content items.
        }
      }
      publishedItems: Natural with {
        briefly "Published"
        described as {
          |Published items.
        }
      }
      totalAssets: Natural with {
        briefly "Assets"
        described as {
          |Total assets.
        }
      }
      totalStorageBytes: Natural with {
        briefly "Storage"
        described as {
          |Total storage used.
        }
      }
    } with {
      briefly "Content statistics"
      described as {
        |Content library metrics.
      }
    }
    handler AnalyticsHandler is {
      on contentCreated: event Content.ContentCreated is {
        tell contentCreated to repository ContentContext.ContentRepository
      }
      on assetAdded: event Content.AssetAdded is {
        tell assetAdded to repository ContentContext.ContentRepository
      }
      on contentPublished: event Content.ContentPublished is {
        tell contentPublished to repository ContentContext.ContentRepository
      }
      on contentArchived: event Content.ContentArchived is {
        tell contentArchived to repository ContentContext.ContentRepository
      }
    } with {
      briefly "Maintains content analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Content analytics projections"
    described as {
      |Maintains content library analytics data.
    }
  }
  processor ContentEventSource as source is {
    outlet ContentEvents is type ContentEvent
    handler ContentEventEmitter is {
      on init is {
        let initializeContent: type InitializeContent = prompt("the initialize content that brings this this into existence")
        tell initializeContent to entity ContentContext.Content
      }
      on other is {
        error "Unexpected message for source ContentEventSource"
      }
      on contentCreated: event Content.ContentCreated is {
        send contentCreated to outlet ContentEvents
      }
      on contentPublished: event Content.ContentPublished is {
        send contentPublished to outlet ContentEvents
      }
      on contentArchived: event Content.ContentArchived is {
        send contentArchived to outlet ContentEvents
      }
    } with {
      briefly "Content event emitter"
      described as {
        |Emits content lifecycle events into streaming topology.
      }
    }
  } with {
    briefly "Content event source"
    described as {
      |Publishes content entity events for streaming.
    }
  }
  processor ContentEventSink as sink is {
    inlet IncomingContentEvents is type ContentEvent    handler ContentEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink ContentEventSink"
      }
      on contentCreated: event Content.ContentCreated is {
        tell contentCreated to repository ContentContext.ContentRepository
      }
      on contentArchived: event Content.ContentArchived is {
        tell contentArchived to repository ContentContext.ContentRepository
      }
    } with {
      briefly "Content event receiver"
      described as {
        |Receives content events and persists them.
      }
    }
  } with {
    briefly "Content event sink"
    described as {
      |Receives content events from streaming topology.
    }
  }
  connector ContentEventPipeline is from outlet ContentContext.ContentEventSource.ContentEvents to inlet ContentContext.ContentEventSink.IncomingContentEvents with {
    briefly "Content event pipeline"
    described as {
      |Wires content events from source to sink.
    }
  }
  processor ContentEventSplit as split is {
    inlet ContentEventSplitIn is type ContentEvent    outlet ContentEventSplitToContentRepository is type ContentEvent
    outlet ContentEventSplitToContentAnalytics is type ContentEvent
    handler ContentEventSplitHandler is {
      on contentCreated: event Content.ContentCreated is {
        send contentCreated to outlet ContentEventSplitToContentRepository
        send contentCreated to outlet ContentEventSplitToContentAnalytics
        tell contentCreated to entity ContentContext.Content
      }
      on metadataUpdated: event Content.MetadataUpdated is {
        send metadataUpdated to outlet ContentEventSplitToContentRepository
        send metadataUpdated to outlet ContentEventSplitToContentAnalytics
        tell metadataUpdated to entity ContentContext.Content
      }
      on assetAdded: event Content.AssetAdded is {
        send assetAdded to outlet ContentEventSplitToContentRepository
        send assetAdded to outlet ContentEventSplitToContentAnalytics
        tell assetAdded to entity ContentContext.Content
      }
      on assetRemoved: event Content.AssetRemoved is {
        send assetRemoved to outlet ContentEventSplitToContentRepository
        send assetRemoved to outlet ContentEventSplitToContentAnalytics
        tell assetRemoved to entity ContentContext.Content
      }
      on versionCreated: event Content.VersionCreated is {
        send versionCreated to outlet ContentEventSplitToContentRepository
        send versionCreated to outlet ContentEventSplitToContentAnalytics
        tell versionCreated to entity ContentContext.Content
      }
      on rightsAssigned: event Content.RightsAssigned is {
        send rightsAssigned to outlet ContentEventSplitToContentRepository
        send rightsAssigned to outlet ContentEventSplitToContentAnalytics
        tell rightsAssigned to entity ContentContext.Content
      }
      on contentSubmittedForReview: event Content.ContentSubmittedForReview is {
        send contentSubmittedForReview to outlet ContentEventSplitToContentRepository
        send contentSubmittedForReview to outlet ContentEventSplitToContentAnalytics
        tell contentSubmittedForReview to entity ContentContext.Content
      }
      on contentApproved: event Content.ContentApproved is {
        send contentApproved to outlet ContentEventSplitToContentRepository
        send contentApproved to outlet ContentEventSplitToContentAnalytics
        tell contentApproved to entity ContentContext.Content
      }
      on contentRejected: event Content.ContentRejected is {
        send contentRejected to outlet ContentEventSplitToContentRepository
        send contentRejected to outlet ContentEventSplitToContentAnalytics
        tell contentRejected to entity ContentContext.Content
      }
      on contentPublished: event Content.ContentPublished is {
        send contentPublished to outlet ContentEventSplitToContentRepository
        send contentPublished to outlet ContentEventSplitToContentAnalytics
        tell contentPublished to entity ContentContext.Content
      }
      on contentUnpublished: event Content.ContentUnpublished is {
        send contentUnpublished to outlet ContentEventSplitToContentRepository
        send contentUnpublished to outlet ContentEventSplitToContentAnalytics
        tell contentUnpublished to entity ContentContext.Content
      }
      on contentArchived: event Content.ContentArchived is {
        send contentArchived to outlet ContentEventSplitToContentRepository
        send contentArchived to outlet ContentEventSplitToContentAnalytics
        tell contentArchived to entity ContentContext.Content
      }
      on other is {
        error "Unexpected message for processor ContentEventSplit"
      }
    } with {
      briefly "Content event fan-out handler"
      described as {
        |Delivers each Content event to all of its consumers.
      }
    }
  } with {
    briefly "Content event fan-out"
    described as {
      |Fans Content events out to the repository and projectors.
    }
  }
  connector 'ContentEvent Stream' is from outlet ContentContext.Content.ContentEvents2 to inlet ContentContext.ContentEventSplit.ContentEventSplitIn with {
    briefly "Content events, fanned out to storage and read models"
  }
  connector 'ContentEvent Storage' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToContentRepository to inlet ContentContext.ContentRepository.ContentRepositoryFromContent with {
    briefly "Content events on their way to storage"
  }
  connector 'ContentAnalytics Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToContentAnalytics to inlet ContentContext.ContentAnalytics.ContentAnalyticsFromContent with {
    briefly "Content events feeding the ContentAnalytics projection"
  }
  connector 'ContentAnalytics Storage' is from outlet ContentContext.ContentAnalytics.ContentAnalyticsOut to inlet ContentContext.ContentRepository.ContentRepositoryFromContentAnalytics with {
    briefly "The ContentAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for content management"
  described as {
    | The ContentContext is the bounded context for digital
    | content lifecycle, metadata, and distribution management.
  }
}
