// Content Management - Content Context
context ContentContext is {
  include "types.riddl"
  include "Content.riddl"
  // Repository for content persistence
  repository ContentRepository is {
    inlet ContentRepositoryFromContent is type ContentEvent
    inlet ContentRepositoryFromContentAnalytics is type ContentEvent
    outlet ContentRepositoryResponses is type Content.ContentResult
    schema ContentData is relational
      of contents as type Content
        index on field Content.contentId
        index on field Content.info.contentType

    handler ContentPersistence is {
      on command Content.CreateContent is {
        tell event Content.ContentCreated to entity ContentContext.Content
      }
      on command Content.UpdateMetadata is {
        tell event Content.MetadataUpdated to entity ContentContext.Content
      }
      on command Content.AddAsset is {
        tell event Content.AssetAdded to entity ContentContext.Content
      }
      on command Content.RemoveAsset is {
        tell event Content.AssetRemoved to entity ContentContext.Content
      }
      on command Content.CreateVersion is {
        tell event Content.VersionCreated to entity ContentContext.Content
      }
      on command Content.AssignRights is {
        tell event Content.RightsAssigned to entity ContentContext.Content
      }
      on command Content.SubmitForReview is {
        tell event Content.ContentSubmittedForReview to entity ContentContext.Content
      }
      on command Content.ApproveContent is {
        tell event Content.ContentApproved to entity ContentContext.Content
      }
      on command Content.RejectContent is {
        tell event Content.ContentRejected to entity ContentContext.Content
      }
      on command Content.PublishContent is {
        tell event Content.ContentPublished to entity ContentContext.Content
      }
      on command Content.UnpublishContent is {
        tell event Content.ContentUnpublished to entity ContentContext.Content
      }
      on command Content.ArchiveContent is {
        tell event Content.ContentArchived to entity ContentContext.Content
      }
    } with {
      briefly "Persists content commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Content data persistence"
    described as {
      | The ContentRepository provides persistent storage for
      | content items, assets, and rights.
    }
  }
  // Projector for content analytics
  projector ContentAnalytics is {
    inlet ContentAnalyticsFromContent is type ContentEvent
    outlet ContentAnalyticsOut is type ContentEvent
    updates repository ContentContext.ContentRepository
    record ContentStats is  {
      contentType: ContentType with {
        briefly "Type"
        described as {
          |Content type.
        }
      }
      totalItems: Natural with {
        briefly "Items"
        described as {
          |Total content items.
        }
      }
      publishedItems: Natural with {
        briefly "Published"
        described as {
          |Published items.
        }
      }
      totalAssets: Natural with {
        briefly "Assets"
        described as {
          |Total assets.
        }
      }
      totalStorageBytes: Natural with {
        briefly "Storage"
        described as {
          |Total storage used.
        }
      }
    } with {
      briefly "Content statistics"
      described as {
        |Content library metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Content.ContentCreated is {
        tell event Content.ContentCreated to repository ContentContext.ContentRepository
      }
      on event Content.AssetAdded is {
        tell event Content.AssetAdded to repository ContentContext.ContentRepository
      }
      on event Content.ContentPublished is {
        tell event Content.ContentPublished to repository ContentContext.ContentRepository
      }
      on event Content.ContentArchived is {
        tell event Content.ContentArchived to repository ContentContext.ContentRepository
      }
    } with {
      briefly "Maintains content analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Content analytics projections"
    described as {
      |Maintains content library analytics data.
    }
  }
  processor ContentEventSource as source is {
    outlet ContentEvents is type ContentEvent
    handler ContentEventEmitter is {
      on init is { tell command InitializeContent to entity ContentContext.Content }
      on other is {
        error "Unexpected message for source ContentEventSource"
      }
      on event Content.ContentCreated is { send event Content.ContentCreated to outlet ContentEvents }
      on event Content.ContentPublished is { send event Content.ContentPublished to outlet ContentEvents }
      on event Content.ContentArchived is { send event Content.ContentArchived to outlet ContentEvents }
    } with {
      briefly "Content event emitter"
      described as {
        |Emits content lifecycle events into streaming topology.
      }
    }
  } with {
    briefly "Content event source"
    described as {
      |Publishes content entity events for streaming.
    }
  }
  processor ContentEventSink as sink is {
    inlet IncomingContentEvents is type ContentEvent
    handler ContentEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink ContentEventSink"
      }
      on event Content.ContentCreated is { tell event Content.ContentCreated to repository ContentContext.ContentRepository }
      on event Content.ContentArchived is { tell event Content.ContentArchived to repository ContentContext.ContentRepository }
    } with {
      briefly "Content event receiver"
      described as {
        |Receives content events and persists them.
      }
    }
  } with {
    briefly "Content event sink"
    described as {
      |Receives content events from streaming topology.
    }
  }
  connector ContentEventPipeline is {
    from outlet ContentContext.ContentEventSource.ContentEvents to inlet ContentContext.ContentEventSink.IncomingContentEvents
  } with {
    briefly "Content event pipeline"
    described as {
      |Wires content events from source to sink.
    }
  }
  processor ContentEventSplit is {
    inlet ContentEventSplitIn is type ContentEvent
    outlet ContentEventSplitToContentRepository is type ContentEvent
    outlet ContentEventSplitToContentAnalytics is type ContentEvent
    handler ContentEventSplitHandler is {
      on event Content.ContentCreated is {
        send event Content.ContentCreated to outlet ContentEventSplitToContentRepository
        send event Content.ContentCreated to outlet ContentEventSplitToContentAnalytics
        tell event Content.ContentCreated to entity ContentContext.Content
      }
      on event Content.MetadataUpdated is {
        send event Content.MetadataUpdated to outlet ContentEventSplitToContentRepository
        send event Content.MetadataUpdated to outlet ContentEventSplitToContentAnalytics
        tell event Content.MetadataUpdated to entity ContentContext.Content
      }
      on event Content.AssetAdded is {
        send event Content.AssetAdded to outlet ContentEventSplitToContentRepository
        send event Content.AssetAdded to outlet ContentEventSplitToContentAnalytics
        tell event Content.AssetAdded to entity ContentContext.Content
      }
      on event Content.AssetRemoved is {
        send event Content.AssetRemoved to outlet ContentEventSplitToContentRepository
        send event Content.AssetRemoved to outlet ContentEventSplitToContentAnalytics
        tell event Content.AssetRemoved to entity ContentContext.Content
      }
      on event Content.VersionCreated is {
        send event Content.VersionCreated to outlet ContentEventSplitToContentRepository
        send event Content.VersionCreated to outlet ContentEventSplitToContentAnalytics
        tell event Content.VersionCreated to entity ContentContext.Content
      }
      on event Content.RightsAssigned is {
        send event Content.RightsAssigned to outlet ContentEventSplitToContentRepository
        send event Content.RightsAssigned to outlet ContentEventSplitToContentAnalytics
        tell event Content.RightsAssigned to entity ContentContext.Content
      }
      on event Content.ContentSubmittedForReview is {
        send event Content.ContentSubmittedForReview to outlet ContentEventSplitToContentRepository
        send event Content.ContentSubmittedForReview to outlet ContentEventSplitToContentAnalytics
        tell event Content.ContentSubmittedForReview to entity ContentContext.Content
      }
      on event Content.ContentApproved is {
        send event Content.ContentApproved to outlet ContentEventSplitToContentRepository
        send event Content.ContentApproved to outlet ContentEventSplitToContentAnalytics
        tell event Content.ContentApproved to entity ContentContext.Content
      }
      on event Content.ContentRejected is {
        send event Content.ContentRejected to outlet ContentEventSplitToContentRepository
        send event Content.ContentRejected to outlet ContentEventSplitToContentAnalytics
        tell event Content.ContentRejected to entity ContentContext.Content
      }
      on event Content.ContentPublished is {
        send event Content.ContentPublished to outlet ContentEventSplitToContentRepository
        send event Content.ContentPublished to outlet ContentEventSplitToContentAnalytics
        tell event Content.ContentPublished to entity ContentContext.Content
      }
      on event Content.ContentUnpublished is {
        send event Content.ContentUnpublished to outlet ContentEventSplitToContentRepository
        send event Content.ContentUnpublished to outlet ContentEventSplitToContentAnalytics
        tell event Content.ContentUnpublished to entity ContentContext.Content
      }
      on event Content.ContentArchived is {
        send event Content.ContentArchived to outlet ContentEventSplitToContentRepository
        send event Content.ContentArchived to outlet ContentEventSplitToContentAnalytics
        tell event Content.ContentArchived to entity ContentContext.Content
      }
      on other is {
        error "Unexpected message for processor ContentEventSplit"
      }
    } with {
      briefly "Content event fan-out handler"
      described as {
        |Delivers each Content event to all of its consumers.
      }
    }
  } with {
    briefly "Content event fan-out"
    described as {
      |Fans Content events out to the repository and projectors.
    }
  }
  connector LinkContentToContentEventSplit is {
    from outlet ContentContext.Content.ContentEvents2 to
      inlet ContentContext.ContentEventSplit.ContentEventSplitIn
  } with {
    briefly "LinkContentToContentEventSplit"
  }
  connector LinkContentEventSplitToContentRepository is {
    from outlet ContentContext.ContentEventSplit.ContentEventSplitToContentRepository to
      inlet ContentContext.ContentRepository.ContentRepositoryFromContent
  } with {
    briefly "LinkContentEventSplitToContentRepository"
  }
  connector LinkContentEventSplitToContentAnalytics is {
    from outlet ContentContext.ContentEventSplit.ContentEventSplitToContentAnalytics to
      inlet ContentContext.ContentAnalytics.ContentAnalyticsFromContent
  } with {
    briefly "LinkContentEventSplitToContentAnalytics"
  }
  connector LinkContentAnalyticsToContentRepository is {
    from outlet ContentContext.ContentAnalytics.ContentAnalyticsOut to
      inlet ContentContext.ContentRepository.ContentRepositoryFromContentAnalytics
  } with {
    briefly "LinkContentAnalyticsToContentRepository"
  }
} with {
  briefly "Bounded context for content management"
  described as {
    | The ContentContext is the bounded context for digital
    | content lifecycle, metadata, and distribution management.
  }
}
