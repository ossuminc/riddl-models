// Streaming Platform - External Contexts
// CDN Service
external context CDNService as sink is {
  inlet CDNServiceRequests is query GetStreamUrl with {
    briefly "What this context asks the service to send"
  }
  handler CDNServiceBoundary is {
    on query GetStreamUrl is {
      let askAnswer: type StreamUrlResult = prompt("look up what GetStreamUrl asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context CDNService"
    }
  } with {
    briefly "CDNService boundary"
  }
  query GetStreamUrl replies result StreamUrlResult is {
    contentId: ContentId with {
      briefly "Content"
      described as {
        |Content ID.
      }
    }
    quality: StreamQuality with {
      briefly "Quality"
      described as {
        |Requested quality.
      }
    }
    region: String(1,50) with {
      briefly "Region"
      described as {
        |User region.
      }
    }
  } with {
    briefly "Get stream URL"
    described as {
      |Retrieves CDN playback URL.
    }
  }
  result StreamUrlResult is {
    streamUrl: URL with {
      briefly "URL"
      described as {
        |Stream URL.
      }
    }
    expiresAt: TimeStamp with {
      briefly "Expires"
      described as {
        |URL expiration.
      }
    }
  } with {
    briefly "Stream URL result"
    described as {
      |CDN stream URL response.
    }
  }
} with {
  briefly "External CDN service"
  described as {
    |External content delivery network.
  }
}
// DRM Service
external context DRMService as flow is {
  outlet DRMServiceEventsOut is event LicenseGranted
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet DRMServiceRequests is command RequestLicense with {
    briefly "What this context asks the service to send"
  }
  handler DRMServiceBoundary is {
    on command RequestLicense is {
      let licenseGranted: type LicenseGranted = prompt("the license granted this produces")
      send licenseGranted to outlet DRMService.DRMServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context DRMService"
    }
  } with {
    briefly "DRMService boundary"
  }
  command RequestLicense is {
    contentId: ContentId with {
      briefly "Content"
      described as {
        |Content ID.
      }
    }
    deviceId: DeviceId with {
      briefly "Device"
      described as {
        |Device ID.
      }
    }
    subscriberId: SubscriberId with {
      briefly "Subscriber"
      described as {
        |Subscriber ID.
      }
    }
  } with {
    briefly "Request license"
    described as {
      |Requests DRM license.
    }
  }
  event LicenseGranted is {
    licenseId: UUID with {
      briefly "License"
      described as {
        |License ID.
      }
    }
    contentId: ContentId with {
      briefly "Content"
      described as {
        |Content ID.
      }
    }
    expiresAt: TimeStamp with {
      briefly "Expires"
      described as {
        |License expiration.
      }
    }
  } with {
    briefly "License was granted"
    described as {
      |Emitted when license is issued.
    }
  }
} with {
  briefly "External DRM service"
  described as {
    |External digital rights management.
  }
}
// Recommendation Service
external context RecommendationService as sink is {
  inlet RecommendationServiceRequests is query GetRecommendations with {
    briefly "What this context asks the service to send"
  }
  handler RecommendationServiceBoundary is {
    on query GetRecommendations is {
      let askAnswer: type RecommendationList = prompt("look up what GetRecommendations asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context RecommendationService"
    }
  } with {
    briefly "RecommendationService boundary"
  }
  query GetRecommendations replies result RecommendationList is {
    subscriberId: SubscriberId with {
      briefly "Subscriber"
      described as {
        |Subscriber ID.
      }
    }
    profileId: ProfileId with {
      briefly "Profile"
      described as {
        |Profile ID.
      }
    }
    limit: Natural with {
      briefly "Limit"
      described as {
        |Max recommendations.
      }
    }
  } with {
    briefly "Get recommendations"
    described as {
      |Retrieves personalized recommendations.
    }
  }
  result RecommendationList is {
    recommendations: Recommendation+ with {
      briefly "Recommendations"
      described as {
        |Content recommendations.
      }
    }
  } with {
    briefly "Recommendation list"
    described as {
      |Personalized recommendations.
    }
  }
} with {
  briefly "External recommendation service"
  described as {
    |External recommendation engine.
  }
}
// Subscription Service
external context SubscriptionService as sink is {
  inlet SubscriptionServiceRequests is query CheckEntitlement with {
    briefly "What this context asks the service to send"
  }
  handler SubscriptionServiceBoundary is {
    on query CheckEntitlement is {
      let askAnswer: type EntitlementResult = prompt("look up what CheckEntitlement asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context SubscriptionService"
    }
  } with {
    briefly "SubscriptionService boundary"
  }
  query CheckEntitlement replies result EntitlementResult is {
    subscriberId: SubscriberId with {
      briefly "Subscriber"
      described as {
        |Subscriber ID.
      }
    }
    contentId: ContentId with {
      briefly "Content"
      described as {
        |Content ID.
      }
    }
  } with {
    briefly "Check entitlement"
    described as {
      |Verifies content access.
    }
  }
  result EntitlementResult is {
    entitled: Boolean with {
      briefly "Entitled"
      described as {
        |Has access.
      }
    }
    denialReason: String(1,200)? with {
      briefly "Reason"
      described as {
        |Denial reason.
      }
    }
  } with {
    briefly "Entitlement result"
    described as {
      |Access verification result.
    }
  }
} with {
  briefly "External subscription service"
  described as {
    |External subscription management.
  }
}
// Analytics Service
external context AnalyticsService as flow is {
  outlet AnalyticsServiceEventsOut is event ViewEventTracked
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet AnalyticsServiceRequests is command TrackViewEvent with {
    briefly "What this context asks the service to send"
  }
  handler AnalyticsServiceBoundary is {
    on command TrackViewEvent is {
      let viewEventTracked: type ViewEventTracked = prompt("the view event tracked this produces")
      send viewEventTracked to outlet AnalyticsService.AnalyticsServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context AnalyticsService"
    }
  } with {
    briefly "AnalyticsService boundary"
  }
  command TrackViewEvent is {
    subscriberId: SubscriberId with {
      briefly "Subscriber"
      described as {
        |Subscriber ID.
      }
    }
    contentId: ContentId with {
      briefly "Content"
      described as {
        |Content ID.
      }
    }
    eventType: String(1,50) with {
      briefly "Event"
      described as {
        |Event type.
      }
    }
    properties: String(1,2000) with {
      briefly "Properties"
      described as {
        |Event properties.
      }
    }
  } with {
    briefly "Track event"
    described as {
      |Tracks viewing analytics.
    }
  }
  event ViewEventTracked is {
    eventId: UUID with {
      briefly "Event"
      described as {
        |Event ID.
      }
    }
    trackedAt: TimeStamp with {
      briefly "Tracked"
      described as {
        |Track time.
      }
    }
  } with {
    briefly "Event was tracked"
    described as {
      |Emitted when event is recorded.
    }
  }
} with {
  briefly "External analytics service"
  described as {
    |External analytics platform.
  }
}
// Continue Watching Service
external context ContinueWatchingService as sink is {
  type ContinueWatchingServiceRequest is one of {
    SaveProgress or GetProgress
  } with {
    briefly "Everything this service can be asked"
  }
  inlet ContinueWatchingServiceRequests is type ContinueWatchingServiceRequest with {
    briefly "What this context asks the service to send"
  }
  handler ContinueWatchingServiceBoundary is {
    on query GetProgress is {
      let askAnswer: type GetProgressResult = prompt("look up what GetProgress asks for")
      reply askAnswer
    }
    on command SaveProgress is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context ContinueWatchingService"
    }
  } with {
    briefly "ContinueWatchingService boundary"
  }
  result GetProgressResult is {
    subscriberId: SubscriberId with {
      briefly "Key"
      described as {
        |Echoes the GetProgress that was requested.
      }
    }
    getProgressStatus: String(1,50) with {
      briefly "Status"
      described as {
        |Outcome reported by the service for this GetProgress.
      }
    }
  } with {
    briefly "GetProgress result"
    described as {
      |Response carrying the requested GetProgress data.
    }
  }
  command SaveProgress is {
    subscriberId: SubscriberId with {
      briefly "Subscriber"
      described as {
        |Subscriber ID.
      }
    }
    profileId: ProfileId with {
      briefly "Profile"
      described as {
        |Profile ID.
      }
    }
    progress: ViewingProgress with {
      briefly "Progress"
      described as {
        |Watch progress.
      }
    }
  } with {
    briefly "Save progress"
    described as {
      |Saves viewing progress.
    }
  }
  query GetProgress replies result GetProgressResult is {
    subscriberId: SubscriberId with {
      briefly "Subscriber"
      described as {
        |Subscriber ID.
      }
    }
    profileId: ProfileId with {
      briefly "Profile"
      described as {
        |Profile ID.
      }
    }
    contentId: ContentId with {
      briefly "Content"
      described as {
        |Content ID.
      }
    }
  } with {
    briefly "Get progress"
    described as {
      |Retrieves viewing progress.
    }
  }
} with {
  briefly "External continue watching service"
  described as {
    |External progress tracking service.
  }
}
