// Streaming Platform Domain Model
// Video and audio streaming service operations
domain StreamingPlatform is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Subscriber is "person subscribing to streaming service" with {
    briefly "Subscriber"
    described as {
      |Paying customer of the platform.
    }
  }
  user ContentCurator is "person managing platform content" with {
    briefly "Content Curator"
    described as {
      |Person curating platform offerings.
    }
  }
  user PlatformOperator is "person managing platform operations" with {
    briefly "Platform Operator"
    described as {
      |Person ensuring service reliability.
    }
  }
  epic StreamingExperienceEpic is {
    user Subscriber wants to "to stream content seamlessly" so that "entertainment is accessible anytime"
    case WatchContent is {
      user Subscriber wants to "to watch video content" so that "they can enjoy entertainment"
      step is "Subscriber selects" "content to watch" "from catalog" with {
        briefly "Select content"
        described as {
          |Choose what to watch.
        }
      }
      step is "Platform initiates" "playback session" "with optimal quality" with {
        briefly "Start playback"
        described as {
          |Begin streaming.
        }
      }
      step take input StreamingPlatformApp.StreamingPlatformScreen.StartStreamInput from user Subscriber with {
        briefly "Start stream"
        described as {
          |Create playback session.
        }
      }
      step is "Platform tracks" "viewing progress" "for resume capability" with {
        briefly "Track progress"
        described as {
          |Save watch position.
        }
      }
    } with {
      briefly "Content streaming workflow"
      described as {
        |Standard flow for watching content.
      }
    }
  } with {
    briefly "Streaming experience processing"
    described as {
      | Epic covering content playback from selection
      | through viewing and progress tracking.
    }
  }
  include "StreamContext.riddl"
  include "external-contexts.riddl"
  application context StreamingPlatformApp is {
    group StreamingPlatformScreen is {
      input StartStreamInput acquires command StreamContext.Stream.StartStream with {
        briefly "Start stream control"
        described as {
          |The control through which a user submits the start stream request.
        }
      }
    } with {
      briefly "Streaming platform screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppStreamCommands is type StreamContext.Stream.StreamCommand
    inlet AppStreamRepositoryResponses is type StreamContext.Stream.StreamResult
    handler StreamingPlatformAppHandler is {
      on other is {
        error "Unexpected message for application context StreamingPlatformApp"
      }
    } with {
      briefly "StreamingPlatformApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "StreamingPlatformApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppStreamCommands is {
    from outlet StreamingPlatformApp.AppStreamCommands to
      inlet StreamContext.Stream.StreamCommands
  } with {
    option is persistent
    briefly "LinkAppStreamCommands"
  }
  connector LinkAppStreamRepositoryResponses is {
    from outlet StreamContext.StreamRepository.StreamRepositoryResponses to
      inlet StreamingPlatformApp.AppStreamRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppStreamRepositoryResponses"
  }
} with {
  briefly "Streaming platform domain"
  described as {
    | The StreamingPlatform domain handles video and audio
    | streaming, playback sessions, and viewing analytics.
  }
}
