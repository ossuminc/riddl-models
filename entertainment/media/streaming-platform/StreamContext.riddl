// Streaming Platform - Stream Context
context StreamContext as router is {
  inlet StreamCommandStreamIn is type StreamCommand  outlet StreamCommandStreamOut is type StreamCommand
  inlet StreamResultStreamIn is result Stream.StreamResult  outlet StreamResultStreamOut is result Stream.StreamResult
  handler StreamContextBoundary is {
    on startStream: command Stream.StartStream is {
      send startStream to outlet StreamContext.StreamCommandStreamOut
    }
    on pauseStream: command Stream.PauseStream is {
      send pauseStream to outlet StreamContext.StreamCommandStreamOut
    }
    on resumeStream: command Stream.ResumeStream is {
      send resumeStream to outlet StreamContext.StreamCommandStreamOut
    }
    on seekPosition: command Stream.SeekPosition is {
      send seekPosition to outlet StreamContext.StreamCommandStreamOut
    }
    on changeQuality: command Stream.ChangeQuality is {
      send changeQuality to outlet StreamContext.StreamCommandStreamOut
    }
    on reportMetrics: command Stream.ReportMetrics is {
      send reportMetrics to outlet StreamContext.StreamCommandStreamOut
    }
    on endStream: command Stream.EndStream is {
      send endStream to outlet StreamContext.StreamCommandStreamOut
    }
    on reportError: command Stream.ReportError is {
      send reportError to outlet StreamContext.StreamCommandStreamOut
    }
    on streamResult: result Stream.StreamResult is {
      send streamResult to outlet StreamContext.StreamResultStreamOut
    }
    on other is {
      error "Unexpected message at the StreamContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'StreamCommand Stream Intake' is from outlet StreamContext.StreamCommandStreamOut to inlet StreamContext.Stream.StreamCommands  connector 'StreamResult Stream Egress' is from outlet StreamContext.StreamRepository.StreamRepositoryResponses to inlet StreamContext.StreamResultStreamIn  adaptor FromAnalyticsService from context AnalyticsService is { 
    handler FromAnalyticsServiceHandler is {
      on event AnalyticsService.ViewEventTracked is {
        do "the model receives view event tracked"
      }
      on other is {
        error "Unexpected message for adaptor FromAnalyticsService"
      }
    } with {
      briefly "from analytics service"
      described as {
        |Carries messages from the external AnalyticsService.
      }
    }
  } with {
    briefly "AnalyticsService integration"
    described as {
      |The model's side of the AnalyticsService conversation.
    }
  }
  adaptor ToAnalyticsService to context AnalyticsService is { 
    handler ToAnalyticsServiceHandler is {
      on command AnalyticsService.TrackViewEvent is {
        do "the model sends track view event"
      }
      on other is {
        error "Unexpected message for adaptor ToAnalyticsService"
      }
    } with {
      briefly "to analytics service"
      described as {
        |Carries messages to the external AnalyticsService.
      }
    }
  } with {
    briefly "AnalyticsService integration"
    described as {
      |The model's side of the AnalyticsService conversation.
    }
  }
  adaptor FromCDNService from context CDNService is { 
    handler FromCDNServiceHandler is {
      on result CDNService.StreamUrlResult is {
        do "the model receives stream url result"
      }
      on other is {
        error "Unexpected message for adaptor FromCDNService"
      }
    } with {
      briefly "from cdn service"
      described as {
        |Carries messages from the external CDNService.
      }
    }
  } with {
    briefly "CDNService integration"
    described as {
      |The model's side of the CDNService conversation.
    }
  }
  adaptor ToCDNService to context CDNService is { 
    handler ToCDNServiceHandler is {
      on query CDNService.GetStreamUrl is {
        do "the model sends get stream url"
      }
      on other is {
        error "Unexpected message for adaptor ToCDNService"
      }
    } with {
      briefly "to cdn service"
      described as {
        |Carries messages to the external CDNService.
      }
    }
  } with {
    briefly "CDNService integration"
    described as {
      |The model's side of the CDNService conversation.
    }
  }
  adaptor FromContinueWatchingService from context ContinueWatchingService is { 
    handler FromContinueWatchingServiceHandler is {
      on result ContinueWatchingService.GetProgressResult is {
        do "the model receives get progress result"
      }
      on other is {
        error "Unexpected message for adaptor FromContinueWatchingService"
      }
    } with {
      briefly "from continue watching service"
      described as {
        |Carries messages from the external ContinueWatchingService.
      }
    }
  } with {
    briefly "ContinueWatchingService integration"
    described as {
      |The model's side of the ContinueWatchingService conversation.
    }
  }
  adaptor ToContinueWatchingService to context ContinueWatchingService is { 
    handler ToContinueWatchingServiceHandler is {
      on query ContinueWatchingService.GetProgress is {
        do "the model sends get progress"
      }
      on command ContinueWatchingService.SaveProgress is {
        do "the model sends save progress"
      }
      on other is {
        error "Unexpected message for adaptor ToContinueWatchingService"
      }
    } with {
      briefly "to continue watching service"
      described as {
        |Carries messages to the external ContinueWatchingService.
      }
    }
  } with {
    briefly "ContinueWatchingService integration"
    described as {
      |The model's side of the ContinueWatchingService conversation.
    }
  }
  adaptor FromDRMService from context DRMService is { 
    handler FromDRMServiceHandler is {
      on event DRMService.LicenseGranted is {
        do "the model receives license granted"
      }
      on other is {
        error "Unexpected message for adaptor FromDRMService"
      }
    } with {
      briefly "from drm service"
      described as {
        |Carries messages from the external DRMService.
      }
    }
  } with {
    briefly "DRMService integration"
    described as {
      |The model's side of the DRMService conversation.
    }
  }
  adaptor ToDRMService to context DRMService is { 
    handler ToDRMServiceHandler is {
      on command DRMService.RequestLicense is {
        do "the model sends request license"
      }
      on other is {
        error "Unexpected message for adaptor ToDRMService"
      }
    } with {
      briefly "to drm service"
      described as {
        |Carries messages to the external DRMService.
      }
    }
  } with {
    briefly "DRMService integration"
    described as {
      |The model's side of the DRMService conversation.
    }
  }
  adaptor FromRecommendationService from context RecommendationService is { 
    handler FromRecommendationServiceHandler is {
      on result RecommendationService.RecommendationList is {
        do "the model receives recommendation list"
      }
      on other is {
        error "Unexpected message for adaptor FromRecommendationService"
      }
    } with {
      briefly "from recommendation service"
      described as {
        |Carries messages from the external RecommendationService.
      }
    }
  } with {
    briefly "RecommendationService integration"
    described as {
      |The model's side of the RecommendationService conversation.
    }
  }
  adaptor ToRecommendationService to context RecommendationService is { 
    handler ToRecommendationServiceHandler is {
      on query RecommendationService.GetRecommendations is {
        do "the model sends get recommendations"
      }
      on other is {
        error "Unexpected message for adaptor ToRecommendationService"
      }
    } with {
      briefly "to recommendation service"
      described as {
        |Carries messages to the external RecommendationService.
      }
    }
  } with {
    briefly "RecommendationService integration"
    described as {
      |The model's side of the RecommendationService conversation.
    }
  }
  adaptor FromSubscriptionService from context SubscriptionService is { 
    handler FromSubscriptionServiceHandler is {
      on result SubscriptionService.EntitlementResult is {
        do "the model receives entitlement result"
      }
      on other is {
        error "Unexpected message for adaptor FromSubscriptionService"
      }
    } with {
      briefly "from subscription service"
      described as {
        |Carries messages from the external SubscriptionService.
      }
    }
  } with {
    briefly "SubscriptionService integration"
    described as {
      |The model's side of the SubscriptionService conversation.
    }
  }
  adaptor ToSubscriptionService to context SubscriptionService is { 
    handler ToSubscriptionServiceHandler is {
      on query SubscriptionService.CheckEntitlement is {
        do "the model sends check entitlement"
      }
      on other is {
        error "Unexpected message for adaptor ToSubscriptionService"
      }
    } with {
      briefly "to subscription service"
      described as {
        |Carries messages to the external SubscriptionService.
      }
    }
  } with {
    briefly "SubscriptionService integration"
    described as {
      |The model's side of the SubscriptionService conversation.
    }
  }
  include "types.riddl"
  include "Stream.riddl"
  // Repository for stream persistence
  type StreamRepositoryCommand is one of {
    StreamContext.StreamRepository.PersistMetricsReported or StreamContext.StreamRepository.PersistPositionSeeked or StreamContext.StreamRepository.PersistQualityChanged or StreamContext.StreamRepository.PersistStreamEnded or StreamContext.StreamRepository.PersistStreamErrorOccurred or StreamContext.StreamRepository.PersistStreamPaused or StreamContext.StreamRepository.PersistStreamResumed or StreamContext.StreamRepository.PersistStreamStarted
  } with {
    briefly "Anything that writes StreamRepository"
    described as {
      |The persistence commands StreamRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository StreamRepository as flow is {
    inlet StreamRepositoryFromStreamAnalytics is type StreamRepositoryCommand
    command PersistPositionSeeked is  {
      streamId: StreamId with {
        briefly "Row addressed"
        described as {
          |Which stored row PositionSeeked applies to.
        }
      }
    } with {
      briefly "Persist PositionSeeked"
      described as {
        |Instructs this repository to apply PositionSeeked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistQualityChanged is  {
      streamId: StreamId with {
        briefly "Row addressed"
        described as {
          |Which stored row QualityChanged applies to.
        }
      }
    } with {
      briefly "Persist QualityChanged"
      described as {
        |Instructs this repository to apply QualityChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStreamErrorOccurred is  {
      streamId: StreamId with {
        briefly "Row addressed"
        described as {
          |Which stored row StreamErrorOccurred applies to.
        }
      }
    } with {
      briefly "Persist StreamErrorOccurred"
      described as {
        |Instructs this repository to apply StreamErrorOccurred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStreamPaused is  {
      streamId: StreamId with {
        briefly "Row addressed"
        described as {
          |Which stored row StreamPaused applies to.
        }
      }
    } with {
      briefly "Persist StreamPaused"
      described as {
        |Instructs this repository to apply StreamPaused to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStreamResumed is  {
      streamId: StreamId with {
        briefly "Row addressed"
        described as {
          |Which stored row StreamResumed applies to.
        }
      }
    } with {
      briefly "Persist StreamResumed"
      described as {
        |Instructs this repository to apply StreamResumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMetricsReported is  {
      streamId: StreamId with {
        briefly "Row addressed"
        described as {
          |Which stored row MetricsReported applies to.
        }
      }
    } with {
      briefly "Persist MetricsReported"
      described as {
        |Instructs this repository to apply MetricsReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStreamEnded is  {
      streamId: StreamId with {
        briefly "Row addressed"
        described as {
          |Which stored row StreamEnded applies to.
        }
      }
    } with {
      briefly "Persist StreamEnded"
      described as {
        |Instructs this repository to apply StreamEnded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStreamStarted is  {
      streamId: StreamId with {
        briefly "Row addressed"
        described as {
          |Which stored row StreamStarted applies to.
        }
      }
    } with {
      briefly "Persist StreamStarted"
      described as {
        |Instructs this repository to apply StreamStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet StreamRepositoryResponses is result Stream.StreamResult
    record StoredStream is  {
      streamId: StreamId with {
        briefly "streamId"
        described as {
          |The streamId column of the stored stream row.
        }
      }
      subscriberId: SubscriberId with {
        briefly "subscriberId"
        described as {
          |The subscriberId column of the stored stream row.
        }
      }
    } with {
      briefly "Stored stream row"
      described as {
        |The persistence shape of stream data as this repository stores it.
      }
    }
    schema StreamData is relational
      of streams as record StoredStream
        index on field StoredStream.streamId
        index on field StoredStream.subscriberId
 with {
      briefly "Stream data schema"
      described as {
        |The relational schema holding stream data for the StreamRepository.
      }
    }
    handler StreamPersistence is {
      on persistPositionSeeked: command PersistPositionSeeked is {
        do "apply PositionSeeked to the stored row"
      }
      on persistQualityChanged: command PersistQualityChanged is {
        do "apply QualityChanged to the stored row"
      }
      on persistStreamErrorOccurred: command PersistStreamErrorOccurred is {
        do "apply StreamErrorOccurred to the stored row"
      }
      on persistStreamPaused: command PersistStreamPaused is {
        do "apply StreamPaused to the stored row"
      }
      on persistStreamResumed: command PersistStreamResumed is {
        do "apply StreamResumed to the stored row"
      }
      on persistMetricsReported: command PersistMetricsReported is {
        do "apply MetricsReported to the stored row"
      }
      on persistStreamEnded: command PersistStreamEnded is {
        do "apply StreamEnded to the stored row"
      }
      on persistStreamStarted: command PersistStreamStarted is {
        do "apply StreamStarted to the stored row"
      }
      on query GetStreamStats is {
        let streamStatsView: type StreamStatsView = prompt("read the stream stats projection")
        reply streamStatsView
      }
    } with {
      briefly "Persists stream commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Stream data persistence"
    described as {
      | The StreamRepository provides persistent storage for
      | streaming sessions and playback analytics.
    }
  }
  // Projector for streaming analytics
  query GetStreamStats replies result StreamStatsView is  {
    streamStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which stream stats to retrieve.
      }
    }
  } with {
    briefly "Get stream stats"
    described as {
      |Retrieves the stream stats projection.
    }
  }
  result StreamStatsView is  {
    streamStats: StreamAnalytics.StreamStats with {
      briefly "Stream stats"
      described as {
        |The stream stats being returned.
      }
    }
  } with {
    briefly "Stream stats view"
    described as {
      |Read model view carrying the stream stats projection.
    }
  }
  projector StreamAnalytics as flow is {
    outlet StreamAnalyticsToRepository is type StreamRepositoryCommand
    updates repository StreamContext.StreamRepository
    inlet StreamAnalyticsFromStream is type StreamEvent
    record StreamStats is  {
      contentId: ContentId with {
        briefly "Content"
        described as {
          |Content ID.
        }
      }
      totalViews: Natural with {
        briefly "Views"
        described as {
          |Total views.
        }
      }
      totalWatchTime: Duration with {
        briefly "Watch time"
        described as {
          |Total watch time.
        }
      }
      averageWatchPercent: Decimal(5,2) with {
        briefly "Avg percent"
        described as {
          |Average completion.
        }
      }
      concurrentStreams: Natural with {
        briefly "Concurrent"
        described as {
          |Peak concurrent.
        }
      }
      avgBufferEvents: Decimal(8,2) with {
        briefly "Buffers"
        described as {
          |Average rebuffers.
        }
      }
    } with {
      briefly "Stream statistics"
      described as {
        |Content streaming metrics.
      }
    }
    handler AnalyticsHandler is {
      on positionSeeked: event Stream.PositionSeeked is {
        tell command StreamContext.StreamRepository.PersistPositionSeeked(streamId = positionSeeked.streamId) to repository StreamContext.StreamRepository
        do "apply PositionSeeked to the StreamAnalytics projection"
      }
      on qualityChanged: event Stream.QualityChanged is {
        tell command StreamContext.StreamRepository.PersistQualityChanged(streamId = qualityChanged.streamId) to repository StreamContext.StreamRepository
        do "apply QualityChanged to the StreamAnalytics projection"
      }
      on streamErrorOccurred: event Stream.StreamErrorOccurred is {
        tell command StreamContext.StreamRepository.PersistStreamErrorOccurred(streamId = streamErrorOccurred.streamId) to repository StreamContext.StreamRepository
        do "apply StreamErrorOccurred to the StreamAnalytics projection"
      }
      on streamPaused: event Stream.StreamPaused is {
        tell command StreamContext.StreamRepository.PersistStreamPaused(streamId = streamPaused.streamId) to repository StreamContext.StreamRepository
        do "apply StreamPaused to the StreamAnalytics projection"
      }
      on streamResumed: event Stream.StreamResumed is {
        tell command StreamContext.StreamRepository.PersistStreamResumed(streamId = streamResumed.streamId) to repository StreamContext.StreamRepository
        do "apply StreamResumed to the StreamAnalytics projection"
      }
      on streamStarted: event Stream.StreamStarted is {
        tell command StreamContext.StreamRepository.PersistStreamStarted(streamId = streamStarted.streamId) to repository StreamContext.StreamRepository
      }
      on metricsReported: event Stream.MetricsReported is {
        tell command StreamContext.StreamRepository.PersistMetricsReported(streamId = metricsReported.streamId) to repository StreamContext.StreamRepository
      }
      on streamEnded: event Stream.StreamEnded is {
        tell command StreamContext.StreamRepository.PersistStreamEnded(streamId = streamEnded.streamId) to repository StreamContext.StreamRepository
      }
    } with {
      briefly "Maintains stream analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Stream analytics projections"
    described as {
      |Maintains streaming analytics data.
    }
  }
  processor StreamEventSplit as flow is {
    inlet StreamEventSplitIn is type StreamEvent
    outlet StreamEventSplitToStreamAnalytics is type StreamEvent
    handler StreamEventSplitHandler is {
      on streamStarted: event Stream.StreamStarted is {
        send streamStarted to outlet StreamEventSplitToStreamAnalytics
        tell streamStarted to entity StreamContext.Stream
      }
      on streamPaused: event Stream.StreamPaused is {
        send streamPaused to outlet StreamEventSplitToStreamAnalytics
        tell streamPaused to entity StreamContext.Stream
      }
      on streamResumed: event Stream.StreamResumed is {
        send streamResumed to outlet StreamEventSplitToStreamAnalytics
        tell streamResumed to entity StreamContext.Stream
      }
      on positionSeeked: event Stream.PositionSeeked is {
        send positionSeeked to outlet StreamEventSplitToStreamAnalytics
        tell positionSeeked to entity StreamContext.Stream
      }
      on qualityChanged: event Stream.QualityChanged is {
        send qualityChanged to outlet StreamEventSplitToStreamAnalytics
        tell qualityChanged to entity StreamContext.Stream
      }
      on metricsReported: event Stream.MetricsReported is {
        send metricsReported to outlet StreamEventSplitToStreamAnalytics
        tell metricsReported to entity StreamContext.Stream
      }
      on streamEnded: event Stream.StreamEnded is {
        send streamEnded to outlet StreamEventSplitToStreamAnalytics
        tell streamEnded to entity StreamContext.Stream
      }
      on streamErrorOccurred: event Stream.StreamErrorOccurred is {
        send streamErrorOccurred to outlet StreamEventSplitToStreamAnalytics
        tell streamErrorOccurred to entity StreamContext.Stream
      }
      on other is {
        error "Unexpected message for processor StreamEventSplit"
      }
    } with {
      briefly "Stream event fan-out handler"
      described as {
        |Delivers each Stream event to all of its consumers.
      }
    }
  } with {
    briefly "Stream event fan-out"
    described as {
      |Fans Stream events out to the repository and projectors.
    }
  }
  connector 'StreamEvent Stream' is from outlet StreamContext.Stream.StreamEvents2 to inlet StreamContext.StreamEventSplit.StreamEventSplitIn with {
    briefly "Stream events, fanned out to storage and read models"
  }
  connector 'StreamAnalytics Feed' is from outlet StreamContext.StreamEventSplit.StreamEventSplitToStreamAnalytics to inlet StreamContext.StreamAnalytics.StreamAnalyticsFromStream with {
    briefly "Stream events feeding the StreamAnalytics projection"
  }
  connector 'StreamAnalytics Storage' is from outlet StreamContext.StreamAnalytics.StreamAnalyticsToRepository to inlet StreamContext.StreamRepository.StreamRepositoryFromStreamAnalytics with {
    briefly "StreamAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for streaming"
  described as {
    | The StreamContext is the bounded context for streaming
    | sessions, playback control, and viewing analytics.
  }
}
