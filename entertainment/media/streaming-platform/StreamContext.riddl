// Streaming Platform - Stream Context
context StreamContext is {
  include "types.riddl"
  include "Stream.riddl"
  // Repository for stream persistence
  repository StreamRepository is {
    inlet StreamRepositoryFromStream is type StreamEvent
    inlet StreamRepositoryFromStreamAnalytics is type StreamEvent
    outlet StreamRepositoryResponses is type Stream.StreamResult
    schema StreamData is relational
      of streams as type Stream
        index on field Stream.streamId
        index on field Stream.subscriberId
      with {
      briefly "Stream data schema"
      described as {
        |The relational schema holding stream data for the StreamRepository.
      }
    }

    handler StreamPersistence is {
      on command Stream.StartStream is {
        tell event Stream.StreamStarted to entity StreamContext.Stream
      }
      on command Stream.PauseStream is {
        tell event Stream.StreamPaused to entity StreamContext.Stream
      }
      on command Stream.ResumeStream is {
        tell event Stream.StreamResumed to entity StreamContext.Stream
      }
      on command Stream.SeekPosition is {
        tell event Stream.PositionSeeked to entity StreamContext.Stream
      }
      on command Stream.ChangeQuality is {
        tell event Stream.QualityChanged to entity StreamContext.Stream
      }
      on command Stream.ReportMetrics is {
        tell event Stream.MetricsReported to entity StreamContext.Stream
      }
      on command Stream.EndStream is {
        tell event Stream.StreamEnded to entity StreamContext.Stream
      }
      on command Stream.ReportError is {
        tell event Stream.StreamErrorOccurred to entity StreamContext.Stream
      }
    } with {
      briefly "Persists stream commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Stream data persistence"
    described as {
      | The StreamRepository provides persistent storage for
      | streaming sessions and playback analytics.
    }
  }
  // Projector for streaming analytics
  projector StreamAnalytics is {
    inlet StreamAnalyticsFromStream is type StreamEvent
    outlet StreamAnalyticsOut is type StreamEvent
    updates repository StreamContext.StreamRepository
    record StreamStats is  {
      contentId: ContentId with {
        briefly "Content"
        described as {
          |Content ID.
        }
      }
      totalViews: Natural with {
        briefly "Views"
        described as {
          |Total views.
        }
      }
      totalWatchTime: Duration with {
        briefly "Watch time"
        described as {
          |Total watch time.
        }
      }
      averageWatchPercent: Decimal(5,2) with {
        briefly "Avg percent"
        described as {
          |Average completion.
        }
      }
      concurrentStreams: Natural with {
        briefly "Concurrent"
        described as {
          |Peak concurrent.
        }
      }
      avgBufferEvents: Decimal(8,2) with {
        briefly "Buffers"
        described as {
          |Average rebuffers.
        }
      }
    } with {
      briefly "Stream statistics"
      described as {
        |Content streaming metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Stream.StreamStarted is {
        tell event Stream.StreamStarted to repository StreamContext.StreamRepository
      }
      on event Stream.MetricsReported is {
        tell event Stream.MetricsReported to repository StreamContext.StreamRepository
      }
      on event Stream.StreamEnded is {
        tell event Stream.StreamEnded to repository StreamContext.StreamRepository
      }
    } with {
      briefly "Maintains stream analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Stream analytics projections"
    described as {
      |Maintains streaming analytics data.
    }
  }
  processor StreamEventSource as source is {
    outlet StreamEvents is type StreamEvent
    handler StreamEventEmitter is {
      on init is { tell command InitializeStream to entity StreamContext.Stream }
      on other is {
        error "Unexpected message for source StreamEventSource"
      }
      on event Stream.StreamStarted is { send event Stream.StreamStarted to outlet StreamEvents }
      on event Stream.StreamEnded is { send event Stream.StreamEnded to outlet StreamEvents }
      on event Stream.StreamErrorOccurred is { send event Stream.StreamErrorOccurred to outlet StreamEvents }
    } with {
      briefly "Stream event emitter"
      described as {
        |Emits stream lifecycle events into streaming topology.
      }
    }
  } with {
    briefly "Stream event source"
    described as {
      |Publishes stream entity events for streaming.
    }
  }
  processor StreamEventSink as sink is {
    inlet IncomingStreamEvents is type StreamEvent
    handler StreamEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink StreamEventSink"
      }
      on event Stream.StreamStarted is { tell event Stream.StreamStarted to repository StreamContext.StreamRepository }
      on event Stream.StreamEnded is { tell event Stream.StreamEnded to repository StreamContext.StreamRepository }
    } with {
      briefly "Stream event receiver"
      described as {
        |Receives stream events and persists them.
      }
    }
  } with {
    briefly "Stream event sink"
    described as {
      |Receives stream events from streaming topology.
    }
  }
  connector StreamEventPipeline is {
    from outlet StreamContext.StreamEventSource.StreamEvents to inlet StreamContext.StreamEventSink.IncomingStreamEvents
  } with {
    briefly "Stream event pipeline"
    described as {
      |Wires stream events from source to sink.
    }
  }
  processor StreamEventSplit is {
    inlet StreamEventSplitIn is type StreamEvent
    outlet StreamEventSplitToStreamRepository is type StreamEvent
    outlet StreamEventSplitToStreamAnalytics is type StreamEvent
    handler StreamEventSplitHandler is {
      on event Stream.StreamStarted is {
        send event Stream.StreamStarted to outlet StreamEventSplitToStreamRepository
        send event Stream.StreamStarted to outlet StreamEventSplitToStreamAnalytics
        tell event Stream.StreamStarted to entity StreamContext.Stream
      }
      on event Stream.StreamPaused is {
        send event Stream.StreamPaused to outlet StreamEventSplitToStreamRepository
        send event Stream.StreamPaused to outlet StreamEventSplitToStreamAnalytics
        tell event Stream.StreamPaused to entity StreamContext.Stream
      }
      on event Stream.StreamResumed is {
        send event Stream.StreamResumed to outlet StreamEventSplitToStreamRepository
        send event Stream.StreamResumed to outlet StreamEventSplitToStreamAnalytics
        tell event Stream.StreamResumed to entity StreamContext.Stream
      }
      on event Stream.PositionSeeked is {
        send event Stream.PositionSeeked to outlet StreamEventSplitToStreamRepository
        send event Stream.PositionSeeked to outlet StreamEventSplitToStreamAnalytics
        tell event Stream.PositionSeeked to entity StreamContext.Stream
      }
      on event Stream.QualityChanged is {
        send event Stream.QualityChanged to outlet StreamEventSplitToStreamRepository
        send event Stream.QualityChanged to outlet StreamEventSplitToStreamAnalytics
        tell event Stream.QualityChanged to entity StreamContext.Stream
      }
      on event Stream.MetricsReported is {
        send event Stream.MetricsReported to outlet StreamEventSplitToStreamRepository
        send event Stream.MetricsReported to outlet StreamEventSplitToStreamAnalytics
        tell event Stream.MetricsReported to entity StreamContext.Stream
      }
      on event Stream.StreamEnded is {
        send event Stream.StreamEnded to outlet StreamEventSplitToStreamRepository
        send event Stream.StreamEnded to outlet StreamEventSplitToStreamAnalytics
        tell event Stream.StreamEnded to entity StreamContext.Stream
      }
      on event Stream.StreamErrorOccurred is {
        send event Stream.StreamErrorOccurred to outlet StreamEventSplitToStreamRepository
        send event Stream.StreamErrorOccurred to outlet StreamEventSplitToStreamAnalytics
        tell event Stream.StreamErrorOccurred to entity StreamContext.Stream
      }
      on other is {
        error "Unexpected message for processor StreamEventSplit"
      }
    } with {
      briefly "Stream event fan-out handler"
      described as {
        |Delivers each Stream event to all of its consumers.
      }
    }
  } with {
    briefly "Stream event fan-out"
    described as {
      |Fans Stream events out to the repository and projectors.
    }
  }
  connector LinkStreamToStreamEventSplit is {
    from outlet StreamContext.Stream.StreamEvents2 to
      inlet StreamContext.StreamEventSplit.StreamEventSplitIn
  } with {
    briefly "LinkStreamToStreamEventSplit"
  }
  connector LinkStreamEventSplitToStreamRepository is {
    from outlet StreamContext.StreamEventSplit.StreamEventSplitToStreamRepository to
      inlet StreamContext.StreamRepository.StreamRepositoryFromStream
  } with {
    briefly "LinkStreamEventSplitToStreamRepository"
  }
  connector LinkStreamEventSplitToStreamAnalytics is {
    from outlet StreamContext.StreamEventSplit.StreamEventSplitToStreamAnalytics to
      inlet StreamContext.StreamAnalytics.StreamAnalyticsFromStream
  } with {
    briefly "LinkStreamEventSplitToStreamAnalytics"
  }
  connector LinkStreamAnalyticsToStreamRepository is {
    from outlet StreamContext.StreamAnalytics.StreamAnalyticsOut to
      inlet StreamContext.StreamRepository.StreamRepositoryFromStreamAnalytics
  } with {
    briefly "LinkStreamAnalyticsToStreamRepository"
  }
} with {
  briefly "Bounded context for streaming"
  described as {
    | The StreamContext is the bounded context for streaming
    | sessions, playback control, and viewing analytics.
  }
}
