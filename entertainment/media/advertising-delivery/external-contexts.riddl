// Advertising Delivery - External Contexts
// Ad Decision Service
external context AdDecisionService as flow is {
  outlet AdDecisionServiceRepliesOut is result AdDecision
 with {
    briefly "What this service answers, on its way back"
  }
  inlet AdDecisionServiceRequests is query RequestAd with {
    briefly "What this context asks the service to send"
  }
  handler AdDecisionServiceBoundary is {
    on query RequestAd is {
      let askAnswer: type AdDecision = prompt("look up what RequestAd asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context AdDecisionService"
    }
  } with {
    briefly "AdDecisionService boundary"
  }
  query RequestAd replies result AdDecision is {
    placement: AdPlacement with {
      briefly "Placement"
      described as {
        |Ad placement.
      }
    }
    viewer: ViewerContext with {
      briefly "Viewer"
      described as {
        |Viewer context.
      }
    }
  } with {
    briefly "Request ad"
    described as {
      |Requests ad decision.
    }
  }
  result AdDecision is {
    selectedAdUnit: AdUnit? with {
      briefly "Ad unit"
      described as {
        |Selected ad.
      }
    }
    noFill: Boolean with {
      briefly "No fill"
      described as {
        |No ad available.
      }
    }
  } with {
    briefly "Ad decision"
    described as {
      |Ad selection result.
    }
  }
} with {
  briefly "External ad decision service"
  described as {
    |External ad selection engine.
  }
}
// RTB Exchange
external context RTBExchange as flow is {
  outlet RTBExchangeEventsOut is event BidResponseReceived
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet RTBExchangeRequests is command SendBidRequest with {
    briefly "What this context asks the service to send"
  }
  handler RTBExchangeBoundary is {
    on command SendBidRequest is {
      let bidResponseReceived: type BidResponseReceived = prompt("the bid response received this produces")
      send bidResponseReceived to outlet RTBExchange.RTBExchangeEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context RTBExchange"
    }
  } with {
    briefly "RTBExchange boundary"
  }
  command SendBidRequest is {
    placement: AdPlacement with {
      briefly "Placement"
      described as {
        |Ad placement.
      }
    }
    viewer: ViewerContext with {
      briefly "Viewer"
      described as {
        |Viewer context.
      }
    }
    timeout: Duration with {
      briefly "Timeout"
      described as {
        |Bid timeout.
      }
    }
  } with {
    briefly "Send bid request"
    described as {
      |Sends RTB bid request.
    }
  }
  event BidResponseReceived is {
    bids: BidResponse+ with {
      briefly "Bids"
      described as {
        |Bid responses.
      }
    }
    receivedAt: TimeStamp with {
      briefly "Received"
      described as {
        |Receipt time.
      }
    }
  } with {
    briefly "Bid response received"
    described as {
      |Emitted when bids arrive.
    }
  }
} with {
  briefly "External RTB exchange"
  described as {
    |Real-time bidding exchange.
  }
}
// Campaign Management Service
external context CampaignService as split is {
  outlet CampaignServiceRepliesOut is result GetCampaignResult
 with {
    briefly "What this service answers, on its way back"
  }
  outlet CampaignServiceEventsOut is event CampaignUpdated
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet CampaignServiceRequests is query GetCampaign with {
    briefly "What this context asks the service to send"
  }
  handler CampaignServiceBoundary is {
    on query GetCampaign is {
      let askAnswer: type GetCampaignResult = prompt("look up what GetCampaign asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context CampaignService"
    }
  } with {
    briefly "CampaignService boundary"
  }
  result GetCampaignResult is {
    campaignId: CampaignId with {
      briefly "Key"
      described as {
        |Echoes the GetCampaign that was requested.
      }
    }
    getCampaignStatus: String(1,50) with {
      briefly "Status"
      described as {
        |Outcome reported by the service for this GetCampaign.
      }
    }
  } with {
    briefly "GetCampaign result"
    described as {
      |Response carrying the requested GetCampaign data.
    }
  }
  query GetCampaign replies result GetCampaignResult is {
    campaignId: CampaignId with {
      briefly "Campaign"
      described as {
        |Campaign ID.
      }
    }
  } with {
    briefly "Get campaign"
    described as {
      |Retrieves campaign details.
    }
  }
  event CampaignUpdated is {
    campaignId: CampaignId with {
      briefly "Campaign"
      described as {
        |Campaign ID.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Campaign was updated"
    described as {
      |Emitted when campaign changes.
    }
  }
} with {
  briefly "External campaign service"
  described as {
    |External campaign management.
  }
}
// Targeting Service
external context TargetingService as flow is {
  outlet TargetingServiceRepliesOut is result TargetingResult
 with {
    briefly "What this service answers, on its way back"
  }
  inlet TargetingServiceRequests is query EvaluateTargeting with {
    briefly "What this context asks the service to send"
  }
  handler TargetingServiceBoundary is {
    on query EvaluateTargeting is {
      let askAnswer: type TargetingResult = prompt("look up what EvaluateTargeting asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context TargetingService"
    }
  } with {
    briefly "TargetingService boundary"
  }
  query EvaluateTargeting replies result TargetingResult is {
    criteria: TargetingCriteria+ with {
      briefly "Criteria"
      described as {
        |Targeting rules.
      }
    }
    viewer: ViewerContext with {
      briefly "Viewer"
      described as {
        |Viewer context.
      }
    }
  } with {
    briefly "Evaluate targeting"
    described as {
      |Checks if viewer matches targeting.
    }
  }
  result TargetingResult is {
    matches: Boolean with {
      briefly "Matches"
      described as {
        |Targeting matched.
      }
    }
    score: Decimal(5,4) with {
      briefly "Score"
      described as {
        |Match score.
      }
    }
  } with {
    briefly "Targeting result"
    described as {
      |Targeting evaluation result.
    }
  }
} with {
  briefly "External targeting service"
  described as {
    |External audience targeting.
  }
}
// Billing Service
external context BillingService as flow is {
  outlet BillingServiceEventsOut is event BillableEventRecorded
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet BillingServiceRequests is command RecordBillableEvent with {
    briefly "What this context asks the service to send"
  }
  handler BillingServiceBoundary is {
    on command RecordBillableEvent is {
      let billableEventRecorded: type BillableEventRecorded = prompt("the billable event recorded this produces")
      send billableEventRecorded to outlet BillingService.BillingServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context BillingService"
    }
  } with {
    briefly "BillingService boundary"
  }
  command RecordBillableEvent is {
    impressionId: ImpressionId with {
      briefly "Impression"
      described as {
        |Impression ID.
      }
    }
    campaignId: CampaignId with {
      briefly "Campaign"
      described as {
        |Campaign ID.
      }
    }
    eventType: String(1,50) with {
      briefly "Event"
      described as {
        |Billable event type.
      }
    }
    amount: Decimal(10,6) with {
      briefly "Amount"
      described as {
        |Billing amount.
      }
    }
  } with {
    briefly "Record billable event"
    described as {
      |Records billing event.
    }
  }
  event BillableEventRecorded is {
    eventId: UUID with {
      briefly "Event"
      described as {
        |Event ID.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Billable event recorded"
    described as {
      |Emitted when billing is recorded.
    }
  }
} with {
  briefly "External billing service"
  described as {
    |External ad billing system.
  }
}
// Fraud Detection Service
external context FraudDetectionService as flow is {
  outlet FraudDetectionServiceEventsOut is event ImpressionValidated
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet FraudDetectionServiceRequests is command CheckImpression with {
    briefly "What this context asks the service to send"
  }
  handler FraudDetectionServiceBoundary is {
    on command CheckImpression is {
      let impressionValidated: type ImpressionValidated = prompt("the impression validated this produces")
      send impressionValidated to outlet FraudDetectionService.FraudDetectionServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context FraudDetectionService"
    }
  } with {
    briefly "FraudDetectionService boundary"
  }
  command CheckImpression is {
    impressionId: ImpressionId with {
      briefly "Impression"
      described as {
        |Impression ID.
      }
    }
    viewer: ViewerContext with {
      briefly "Viewer"
      described as {
        |Viewer context.
      }
    }
  } with {
    briefly "Check impression"
    described as {
      |Validates impression authenticity.
    }
  }
  event ImpressionValidated is {
    impressionId: ImpressionId with {
      briefly "Impression"
      described as {
        |Impression ID.
      }
    }
    valid: Boolean with {
      briefly "Valid"
      described as {
        |Is valid.
      }
    }
    riskScore: Decimal(5,4) with {
      briefly "Risk"
      described as {
        |Risk score.
      }
    }
  } with {
    briefly "Impression was validated"
    described as {
      |Emitted when validation completes.
    }
  }
} with {
  briefly "External fraud detection"
  described as {
    |External ad fraud prevention.
  }
}
