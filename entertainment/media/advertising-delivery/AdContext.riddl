// Advertising Delivery - Ad Context
context AdContext as router is {
  inlet AdImpressionCommandStreamIn is type AdImpressionCommand  outlet AdImpressionCommandStreamOut is type AdImpressionCommand
  inlet AdImpressionResultStreamIn is result AdImpression.AdImpressionResult  outlet AdImpressionResultStreamOut is result AdImpression.AdImpressionResult
  handler AdContextBoundary is {
    on recordImpression: command AdImpression.RecordImpression is {
      send recordImpression to outlet AdContext.AdImpressionCommandStreamOut
    }
    on recordStart: command AdImpression.RecordStart is {
      send recordStart to outlet AdContext.AdImpressionCommandStreamOut
    }
    on recordQuartile: command AdImpression.RecordQuartile is {
      send recordQuartile to outlet AdContext.AdImpressionCommandStreamOut
    }
    on recordComplete: command AdImpression.RecordComplete is {
      send recordComplete to outlet AdContext.AdImpressionCommandStreamOut
    }
    on recordSkip: command AdImpression.RecordSkip is {
      send recordSkip to outlet AdContext.AdImpressionCommandStreamOut
    }
    on recordClick: command AdImpression.RecordClick is {
      send recordClick to outlet AdContext.AdImpressionCommandStreamOut
    }
    on recordError: command AdImpression.RecordError is {
      send recordError to outlet AdContext.AdImpressionCommandStreamOut
    }
    on adImpressionResult: result AdImpression.AdImpressionResult is {
      send adImpressionResult to outlet AdContext.AdImpressionResultStreamOut
    }
    on other is {
      error "Unexpected message at the AdContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AdImpressionCommand Stream Intake' is from outlet AdContext.AdImpressionCommandStreamOut to inlet AdContext.AdImpression.AdImpressionCommands  connector 'AdImpressionResult Stream Egress' is from outlet AdContext.AdRepository.AdRepositoryResponses to inlet AdContext.AdImpressionResultStreamIn  adaptor FromAdDecisionService from context AdDecisionService is { 
    handler FromAdDecisionServiceHandler is {
      on result AdDecisionService.AdDecision is {
        do "the model receives ad decision"
      }
      on other is {
        error "Unexpected message for adaptor FromAdDecisionService"
      }
    } with {
      briefly "from ad decision service"
      described as {
        |Carries messages from the external AdDecisionService.
      }
    }
  } with {
    briefly "AdDecisionService integration"
    described as {
      |The model's side of the AdDecisionService conversation.
    }
  }
  adaptor ToAdDecisionService to context AdDecisionService is { 
    handler ToAdDecisionServiceHandler is {
      on query AdDecisionService.RequestAd is {
        do "the model sends request ad"
      }
      on other is {
        error "Unexpected message for adaptor ToAdDecisionService"
      }
    } with {
      briefly "to ad decision service"
      described as {
        |Carries messages to the external AdDecisionService.
      }
    }
  } with {
    briefly "AdDecisionService integration"
    described as {
      |The model's side of the AdDecisionService conversation.
    }
  }
  adaptor FromBillingService from context BillingService is { 
    handler FromBillingServiceHandler is {
      on event BillingService.BillableEventRecorded is {
        do "the model receives billable event recorded"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService is { 
    handler ToBillingServiceHandler is {
      on command BillingService.RecordBillableEvent is {
        do "the model sends record billable event"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromCampaignService from context CampaignService is { 
    handler FromCampaignServiceHandler is {
      on event CampaignService.CampaignUpdated is {
        do "the model receives campaign updated"
      }
      on result CampaignService.GetCampaignResult is {
        do "the model receives get campaign result"
      }
      on other is {
        error "Unexpected message for adaptor FromCampaignService"
      }
    } with {
      briefly "from campaign service"
      described as {
        |Carries messages from the external CampaignService.
      }
    }
  } with {
    briefly "CampaignService integration"
    described as {
      |The model's side of the CampaignService conversation.
    }
  }
  adaptor ToCampaignService to context CampaignService is { 
    handler ToCampaignServiceHandler is {
      on query CampaignService.GetCampaign is {
        do "the model sends get campaign"
      }
      on other is {
        error "Unexpected message for adaptor ToCampaignService"
      }
    } with {
      briefly "to campaign service"
      described as {
        |Carries messages to the external CampaignService.
      }
    }
  } with {
    briefly "CampaignService integration"
    described as {
      |The model's side of the CampaignService conversation.
    }
  }
  adaptor FromFraudDetectionService from context FraudDetectionService is { 
    handler FromFraudDetectionServiceHandler is {
      on event FraudDetectionService.ImpressionValidated is {
        do "the model receives impression validated"
      }
      on other is {
        error "Unexpected message for adaptor FromFraudDetectionService"
      }
    } with {
      briefly "from fraud detection service"
      described as {
        |Carries messages from the external FraudDetectionService.
      }
    }
  } with {
    briefly "FraudDetectionService integration"
    described as {
      |The model's side of the FraudDetectionService conversation.
    }
  }
  adaptor ToFraudDetectionService to context FraudDetectionService is { 
    handler ToFraudDetectionServiceHandler is {
      on command FraudDetectionService.CheckImpression is {
        do "the model sends check impression"
      }
      on other is {
        error "Unexpected message for adaptor ToFraudDetectionService"
      }
    } with {
      briefly "to fraud detection service"
      described as {
        |Carries messages to the external FraudDetectionService.
      }
    }
  } with {
    briefly "FraudDetectionService integration"
    described as {
      |The model's side of the FraudDetectionService conversation.
    }
  }
  adaptor FromRTBExchange from context RTBExchange is { 
    handler FromRTBExchangeHandler is {
      on event RTBExchange.BidResponseReceived is {
        do "the model receives bid response received"
      }
      on other is {
        error "Unexpected message for adaptor FromRTBExchange"
      }
    } with {
      briefly "from rtb exchange"
      described as {
        |Carries messages from the external RTBExchange.
      }
    }
  } with {
    briefly "RTBExchange integration"
    described as {
      |The model's side of the RTBExchange conversation.
    }
  }
  adaptor ToRTBExchange to context RTBExchange is { 
    handler ToRTBExchangeHandler is {
      on command RTBExchange.SendBidRequest is {
        do "the model sends send bid request"
      }
      on other is {
        error "Unexpected message for adaptor ToRTBExchange"
      }
    } with {
      briefly "to rtb exchange"
      described as {
        |Carries messages to the external RTBExchange.
      }
    }
  } with {
    briefly "RTBExchange integration"
    described as {
      |The model's side of the RTBExchange conversation.
    }
  }
  adaptor FromTargetingService from context TargetingService is { 
    handler FromTargetingServiceHandler is {
      on result TargetingService.TargetingResult is {
        do "the model receives targeting result"
      }
      on other is {
        error "Unexpected message for adaptor FromTargetingService"
      }
    } with {
      briefly "from targeting service"
      described as {
        |Carries messages from the external TargetingService.
      }
    }
  } with {
    briefly "TargetingService integration"
    described as {
      |The model's side of the TargetingService conversation.
    }
  }
  adaptor ToTargetingService to context TargetingService is { 
    handler ToTargetingServiceHandler is {
      on query TargetingService.EvaluateTargeting is {
        do "the model sends evaluate targeting"
      }
      on other is {
        error "Unexpected message for adaptor ToTargetingService"
      }
    } with {
      briefly "to targeting service"
      described as {
        |Carries messages to the external TargetingService.
      }
    }
  } with {
    briefly "TargetingService integration"
    described as {
      |The model's side of the TargetingService conversation.
    }
  }
  include "types.riddl"
  include "AdImpression.riddl"
  // Repository for ad persistence
  type AdRepositoryCommand is one of {
    AdContext.AdRepository.PersistAdClicked or AdContext.AdRepository.PersistAdCompleted or AdContext.AdRepository.PersistAdErrorOccurred or AdContext.AdRepository.PersistAdSkipped or AdContext.AdRepository.PersistAdStarted or AdContext.AdRepository.PersistImpressionRecorded or AdContext.AdRepository.PersistQuartileReached
  } with {
    briefly "Anything that writes AdRepository"
    described as {
      |The persistence commands AdRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository AdRepository as flow is {
    inlet AdRepositoryFromAdAnalytics is type AdRepositoryCommand    command PersistAdErrorOccurred is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row AdErrorOccurred applies to.
        }
      }
    } with {
      briefly "Persist AdErrorOccurred"
      described as {
        |Instructs this repository to apply AdErrorOccurred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAdSkipped is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row AdSkipped applies to.
        }
      }
    } with {
      briefly "Persist AdSkipped"
      described as {
        |Instructs this repository to apply AdSkipped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistQuartileReached is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row QuartileReached applies to.
        }
      }
    } with {
      briefly "Persist QuartileReached"
      described as {
        |Instructs this repository to apply QuartileReached to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAdClicked is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row AdClicked applies to.
        }
      }
    } with {
      briefly "Persist AdClicked"
      described as {
        |Instructs this repository to apply AdClicked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAdCompleted is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row AdCompleted applies to.
        }
      }
    } with {
      briefly "Persist AdCompleted"
      described as {
        |Instructs this repository to apply AdCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAdStarted is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row AdStarted applies to.
        }
      }
    } with {
      briefly "Persist AdStarted"
      described as {
        |Instructs this repository to apply AdStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistImpressionRecorded is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ImpressionRecorded applies to.
        }
      }
    } with {
      briefly "Persist ImpressionRecorded"
      described as {
        |Instructs this repository to apply ImpressionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet AdRepositoryResponses is result AdImpression.AdImpressionResult
    record StoredAdImpression is {
      adImpressionId: UUID with {
        briefly "adImpressionId"
        described as {
          |The adImpressionId column of the stored adImpression row.
        }
      }
      adUnit: AdUnit with {
        briefly "adUnit"
        described as {
          |The adUnit column of the stored adImpression row.
        }
      }
      impressionId: ImpressionId with {
        briefly "impressionId"
        described as {
          |The impressionId column of the stored adImpression row.
        }
      }
    } with {
      briefly "Stored adImpression row"
      described as {
        |The persistence shape of adImpression data as this repository stores it.
      }
    }
    schema AdData is relational
      of impressions as record StoredAdImpression
        index on field StoredAdImpression.impressionId
        index on field StoredAdImpression.adUnit.campaignId
 with {
      briefly "Ad data schema"
      described as {
        |The relational schema holding ad data for the AdRepository.
      }
    }
    handler AdPersistence is {
      on persistAdErrorOccurred: command PersistAdErrorOccurred is {
        do "apply AdErrorOccurred to the stored row"
      }
      on persistAdSkipped: command PersistAdSkipped is {
        do "apply AdSkipped to the stored row"
      }
      on persistQuartileReached: command PersistQuartileReached is {
        do "apply QuartileReached to the stored row"
      }
      on persistAdClicked: command PersistAdClicked is {
        do "apply AdClicked to the stored row"
      }
      on persistAdCompleted: command PersistAdCompleted is {
        do "apply AdCompleted to the stored row"
      }
      on persistAdStarted: command PersistAdStarted is {
        do "apply AdStarted to the stored row"
      }
      on persistImpressionRecorded: command PersistImpressionRecorded is {
        do "apply ImpressionRecorded to the stored row"
      }
      on query GetCampaignStats is {
        let campaignStatsView: type CampaignStatsView = prompt("read the campaign stats projection")
        reply campaignStatsView
      }
    } with {
      briefly "Persists ad commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Ad data persistence"
    described as {
      | The AdRepository provides persistent storage for
      | ad impressions and engagement data.
    }
  }
  // Projector for ad analytics
  query GetCampaignStats replies result CampaignStatsView is {
    campaignStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which campaign stats to retrieve.
      }
    }
  } with {
    briefly "Get campaign stats"
    described as {
      |Retrieves the campaign stats projection.
    }
  }
  result CampaignStatsView is {
    campaignStats: AdAnalytics.CampaignStats with {
      briefly "Campaign stats"
      described as {
        |The campaign stats being returned.
      }
    }
  } with {
    briefly "Campaign stats view"
    described as {
      |Read model view carrying the campaign stats projection.
    }
  }
  projector AdAnalytics as flow is {
    updates repository AdContext.AdRepository
    outlet AdAnalyticsToRepository is type AdRepositoryCommand
    inlet AdAnalyticsFromAdImpression is type AdImpressionEvent    record CampaignStats is {
      campaignId: CampaignId with {
        briefly "Campaign"
        described as {
          |Campaign ID.
        }
      }
      impressions: Natural with {
        briefly "Impressions"
        described as {
          |Total impressions.
        }
      }
      views: Natural with {
        briefly "Views"
        described as {
          |View count.
        }
      }
      completions: Natural with {
        briefly "Completions"
        described as {
          |Completion count.
        }
      }
      clicks: Natural with {
        briefly "Clicks"
        described as {
          |Click count.
        }
      }
      clickRate: Decimal(5,4) with {
        briefly "CTR"
        described as {
          |Click-through rate.
        }
      }
      completionRate: Decimal(5,4) with {
        briefly "VCR"
        described as {
          |View completion rate.
        }
      }
    } with {
      briefly "Campaign statistics"
      described as {
        |Campaign performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on adErrorOccurred: event AdImpression.AdErrorOccurred is {
        tell command AdContext.AdRepository.PersistAdErrorOccurred(impressionId = adErrorOccurred.impressionId) to repository AdContext.AdRepository
        do "apply AdErrorOccurred to the AdAnalytics projection"
      }
      on adSkipped: event AdImpression.AdSkipped is {
        tell command AdContext.AdRepository.PersistAdSkipped(impressionId = adSkipped.impressionId) to repository AdContext.AdRepository
        do "apply AdSkipped to the AdAnalytics projection"
      }
      on quartileReached: event AdImpression.QuartileReached is {
        tell command AdContext.AdRepository.PersistQuartileReached(impressionId = quartileReached.impressionId) to repository AdContext.AdRepository
        do "apply QuartileReached to the AdAnalytics projection"
      }
      on impressionRecorded: event AdImpression.ImpressionRecorded is {
        tell command AdContext.AdRepository.PersistImpressionRecorded(impressionId = impressionRecorded.impressionId) to repository AdContext.AdRepository
      }
      on adStarted: event AdImpression.AdStarted is {
        tell command AdContext.AdRepository.PersistAdStarted(impressionId = adStarted.impressionId) to repository AdContext.AdRepository
      }
      on adCompleted: event AdImpression.AdCompleted is {
        tell command AdContext.AdRepository.PersistAdCompleted(impressionId = adCompleted.impressionId) to repository AdContext.AdRepository
      }
      on adClicked: event AdImpression.AdClicked is {
        tell command AdContext.AdRepository.PersistAdClicked(impressionId = adClicked.impressionId) to repository AdContext.AdRepository
      }
    } with {
      briefly "Maintains ad analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Ad analytics projections"
    described as {
      |Maintains advertising analytics data.
    }
  }
  streamlet AdImpressionEventSplit as flow is {
    inlet AdImpressionEventSplitIn is type AdImpressionEvent    outlet AdImpressionEventSplitToAdAnalytics is type AdImpressionEvent
    handler AdImpressionEventSplitHandler is {
      on impressionRecorded: event AdImpression.ImpressionRecorded is {
        send impressionRecorded to outlet AdImpressionEventSplitToAdAnalytics
        tell impressionRecorded to entity AdContext.AdImpression
      }
      on adStarted: event AdImpression.AdStarted is {
        send adStarted to outlet AdImpressionEventSplitToAdAnalytics
        tell adStarted to entity AdContext.AdImpression
      }
      on quartileReached: event AdImpression.QuartileReached is {
        send quartileReached to outlet AdImpressionEventSplitToAdAnalytics
        tell quartileReached to entity AdContext.AdImpression
      }
      on adCompleted: event AdImpression.AdCompleted is {
        send adCompleted to outlet AdImpressionEventSplitToAdAnalytics
        tell adCompleted to entity AdContext.AdImpression
      }
      on adSkipped: event AdImpression.AdSkipped is {
        send adSkipped to outlet AdImpressionEventSplitToAdAnalytics
        tell adSkipped to entity AdContext.AdImpression
      }
      on adClicked: event AdImpression.AdClicked is {
        send adClicked to outlet AdImpressionEventSplitToAdAnalytics
        tell adClicked to entity AdContext.AdImpression
      }
      on adErrorOccurred: event AdImpression.AdErrorOccurred is {
        send adErrorOccurred to outlet AdImpressionEventSplitToAdAnalytics
        tell adErrorOccurred to entity AdContext.AdImpression
      }
      on other is {
        error "Unexpected message for processor AdImpressionEventSplit"
      }
    } with {
      briefly "AdImpression event fan-out handler"
      described as {
        |Delivers each AdImpression event to all of its consumers.
      }
    }
  } with {
    briefly "AdImpression event fan-out"
    described as {
      |Fans AdImpression events out to the repository and projectors.
    }
  }
  connector 'AdImpressionEvent Stream' is from outlet AdContext.AdImpression.AdImpressionEvents2 to inlet AdContext.AdImpressionEventSplit.AdImpressionEventSplitIn with {
    briefly "AdImpression events, fanned out to storage and read models"
  }
  connector 'AdAnalytics Feed' is from outlet AdContext.AdImpressionEventSplit.AdImpressionEventSplitToAdAnalytics to inlet AdContext.AdAnalytics.AdAnalyticsFromAdImpression with {
    briefly "AdImpression events feeding the AdAnalytics projection"
  }
  connector 'AdAnalytics Storage' is from outlet AdContext.AdAnalytics.AdAnalyticsToRepository to inlet AdContext.AdRepository.AdRepositoryFromAdAnalytics with {
    briefly "AdAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for advertising"
  described as {
    | The AdContext is the bounded context for ad delivery,
    | impression tracking, and performance analytics.
  }
}
