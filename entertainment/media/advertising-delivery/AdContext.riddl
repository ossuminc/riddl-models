// Advertising Delivery - Ad Context
context AdContext is {
  include "types.riddl"
  include "AdImpression.riddl"
  // Repository for ad persistence
  repository AdRepository is {
    inlet AdRepositoryFromAdImpression is type AdImpressionEvent
    inlet AdRepositoryFromAdAnalytics is type AdImpressionEvent
    outlet AdRepositoryResponses is type AdImpression.AdImpressionResult
    schema AdData is relational
      of impressions as type AdImpression
        index on field AdImpression.impressionId
        index on field AdImpression.adUnit.campaignId

    handler AdPersistence is {
      on command AdImpression.RecordImpression is {
        tell event AdImpression.ImpressionRecorded to entity AdContext.AdImpression
      }
      on command AdImpression.RecordStart is {
        tell event AdImpression.AdStarted to entity AdContext.AdImpression
      }
      on command AdImpression.RecordQuartile is {
        tell event AdImpression.QuartileReached to entity AdContext.AdImpression
      }
      on command AdImpression.RecordComplete is {
        tell event AdImpression.AdCompleted to entity AdContext.AdImpression
      }
      on command AdImpression.RecordSkip is {
        tell event AdImpression.AdSkipped to entity AdContext.AdImpression
      }
      on command AdImpression.RecordClick is {
        tell event AdImpression.AdClicked to entity AdContext.AdImpression
      }
      on command AdImpression.RecordError is {
        tell event AdImpression.AdErrorOccurred to entity AdContext.AdImpression
      }
    } with {
      briefly "Persists ad commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Ad data persistence"
    described as {
      | The AdRepository provides persistent storage for
      | ad impressions and engagement data.
    }
  }
  // Projector for ad analytics
  projector AdAnalytics is {
    inlet AdAnalyticsFromAdImpression is type AdImpressionEvent
    outlet AdAnalyticsOut is type AdImpressionEvent
    updates repository AdContext.AdRepository
    record CampaignStats is  {
      campaignId: CampaignId with {
        briefly "Campaign"
        described as {
          |Campaign ID.
        }
      }
      impressions: Natural with {
        briefly "Impressions"
        described as {
          |Total impressions.
        }
      }
      views: Natural with {
        briefly "Views"
        described as {
          |View count.
        }
      }
      completions: Natural with {
        briefly "Completions"
        described as {
          |Completion count.
        }
      }
      clicks: Natural with {
        briefly "Clicks"
        described as {
          |Click count.
        }
      }
      clickRate: Decimal(5,4) with {
        briefly "CTR"
        described as {
          |Click-through rate.
        }
      }
      completionRate: Decimal(5,4) with {
        briefly "VCR"
        described as {
          |View completion rate.
        }
      }
    } with {
      briefly "Campaign statistics"
      described as {
        |Campaign performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on event AdImpression.ImpressionRecorded is {
        tell event AdImpression.ImpressionRecorded to repository AdContext.AdRepository
      }
      on event AdImpression.AdStarted is {
        tell event AdImpression.AdStarted to repository AdContext.AdRepository
      }
      on event AdImpression.AdCompleted is {
        tell event AdImpression.AdCompleted to repository AdContext.AdRepository
      }
      on event AdImpression.AdClicked is {
        tell event AdImpression.AdClicked to repository AdContext.AdRepository
      }
    } with {
      briefly "Maintains ad analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Ad analytics projections"
    described as {
      |Maintains advertising analytics data.
    }
  }
  processor AdImpressionEventSource as source is {
    outlet AdImpressionEvents is type AdImpressionEvent
    handler AdImpressionEventEmitter is {
      on init is { tell command InitializeAdImpression to entity AdContext.AdImpression }
      on other is {
        error "Unexpected message for source AdImpressionEventSource"
      }
      on event AdImpression.ImpressionRecorded is {
        send event AdImpression.ImpressionRecorded to outlet AdImpressionEvents
      }
      on event AdImpression.AdCompleted is {
        send event AdImpression.AdCompleted to outlet AdImpressionEvents
      }
      on event AdImpression.AdClicked is {
        send event AdImpression.AdClicked to outlet AdImpressionEvents
      }
    } with {
      briefly "Ad impression event emitter"
      described as {
        |Emits ad impression events into streaming topology.
      }
    }
  } with {
    briefly "Ad impression event source"
    described as {
      |Publishes ad impression events for streaming.
    }
  }
  processor AdImpressionEventSink as sink is {
    inlet IncomingAdImpressionEvents is type AdImpressionEvent
    handler AdImpressionEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink AdImpressionEventSink"
      }
      on event AdImpression.ImpressionRecorded is {
        tell event AdImpression.ImpressionRecorded to repository AdContext.AdRepository
      }
      on event AdImpression.AdClicked is {
        tell event AdImpression.AdClicked to repository AdContext.AdRepository
      }
    } with {
      briefly "Ad impression event receiver"
      described as {
        |Receives ad impression events and persists them.
      }
    }
  } with {
    briefly "Ad impression event sink"
    described as {
      |Receives ad impression events from streaming topology.
    }
  }
  connector AdImpressionEventPipeline is {
    from outlet AdContext.AdImpressionEventSource.AdImpressionEvents
      to inlet AdContext.AdImpressionEventSink.IncomingAdImpressionEvents
  } with {
    briefly "Ad impression event pipeline"
    described as {
      |Wires ad impression events from source to sink.
    }
  }
  processor AdImpressionEventSplit is {
    inlet AdImpressionEventSplitIn is type AdImpressionEvent
    outlet AdImpressionEventSplitToAdRepository is type AdImpressionEvent
    outlet AdImpressionEventSplitToAdAnalytics is type AdImpressionEvent
    handler AdImpressionEventSplitHandler is {
      on event AdImpression.ImpressionRecorded is {
        send event AdImpression.ImpressionRecorded to outlet AdImpressionEventSplitToAdRepository
        send event AdImpression.ImpressionRecorded to outlet AdImpressionEventSplitToAdAnalytics
        tell event AdImpression.ImpressionRecorded to entity AdContext.AdImpression
      }
      on event AdImpression.AdStarted is {
        send event AdImpression.AdStarted to outlet AdImpressionEventSplitToAdRepository
        send event AdImpression.AdStarted to outlet AdImpressionEventSplitToAdAnalytics
        tell event AdImpression.AdStarted to entity AdContext.AdImpression
      }
      on event AdImpression.QuartileReached is {
        send event AdImpression.QuartileReached to outlet AdImpressionEventSplitToAdRepository
        send event AdImpression.QuartileReached to outlet AdImpressionEventSplitToAdAnalytics
        tell event AdImpression.QuartileReached to entity AdContext.AdImpression
      }
      on event AdImpression.AdCompleted is {
        send event AdImpression.AdCompleted to outlet AdImpressionEventSplitToAdRepository
        send event AdImpression.AdCompleted to outlet AdImpressionEventSplitToAdAnalytics
        tell event AdImpression.AdCompleted to entity AdContext.AdImpression
      }
      on event AdImpression.AdSkipped is {
        send event AdImpression.AdSkipped to outlet AdImpressionEventSplitToAdRepository
        send event AdImpression.AdSkipped to outlet AdImpressionEventSplitToAdAnalytics
        tell event AdImpression.AdSkipped to entity AdContext.AdImpression
      }
      on event AdImpression.AdClicked is {
        send event AdImpression.AdClicked to outlet AdImpressionEventSplitToAdRepository
        send event AdImpression.AdClicked to outlet AdImpressionEventSplitToAdAnalytics
        tell event AdImpression.AdClicked to entity AdContext.AdImpression
      }
      on event AdImpression.AdErrorOccurred is {
        send event AdImpression.AdErrorOccurred to outlet AdImpressionEventSplitToAdRepository
        send event AdImpression.AdErrorOccurred to outlet AdImpressionEventSplitToAdAnalytics
        tell event AdImpression.AdErrorOccurred to entity AdContext.AdImpression
      }
      on other is {
        error "Unexpected message for processor AdImpressionEventSplit"
      }
    } with {
      briefly "AdImpression event fan-out handler"
      described as {
        |Delivers each AdImpression event to all of its consumers.
      }
    }
  } with {
    briefly "AdImpression event fan-out"
    described as {
      |Fans AdImpression events out to the repository and projectors.
    }
  }
  connector LinkAdImpressionToAdImpressionEventSplit is {
    from outlet AdContext.AdImpression.AdImpressionEvents2 to
      inlet AdContext.AdImpressionEventSplit.AdImpressionEventSplitIn
  } with {
    briefly "LinkAdImpressionToAdImpressionEventSplit"
  }
  connector LinkAdImpressionEventSplitToAdRepository is {
    from outlet AdContext.AdImpressionEventSplit.AdImpressionEventSplitToAdRepository to
      inlet AdContext.AdRepository.AdRepositoryFromAdImpression
  } with {
    briefly "LinkAdImpressionEventSplitToAdRepository"
  }
  connector LinkAdImpressionEventSplitToAdAnalytics is {
    from outlet AdContext.AdImpressionEventSplit.AdImpressionEventSplitToAdAnalytics to
      inlet AdContext.AdAnalytics.AdAnalyticsFromAdImpression
  } with {
    briefly "LinkAdImpressionEventSplitToAdAnalytics"
  }
  connector LinkAdAnalyticsToAdRepository is {
    from outlet AdContext.AdAnalytics.AdAnalyticsOut to
      inlet AdContext.AdRepository.AdRepositoryFromAdAnalytics
  } with {
    briefly "LinkAdAnalyticsToAdRepository"
  }
} with {
  briefly "Bounded context for advertising"
  described as {
    | The AdContext is the bounded context for ad delivery,
    | impression tracking, and performance analytics.
  }
}
