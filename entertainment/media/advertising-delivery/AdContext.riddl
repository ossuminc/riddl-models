// Advertising Delivery - Ad Context
context AdContext as router is {
  inlet AdContextFromToCampaignService is command AdImpression.AttributeToCampaign with {
    briefly "What ToCampaignService makes of the answers it gets"
  }
  connector 'ToCampaignService Intake' is from outlet AdContext.ToCampaignService.ToCampaignServiceToAdContext to inlet AdContext.AdContextFromToCampaignService with {
    briefly "Answers translated by ToCampaignService, on their way in"
  }
  inlet AdContextFromToTargetingService is command AdImpression.RecordTargetingOutcome with {
    briefly "What ToTargetingService makes of the answers it gets"
  }
  connector 'ToTargetingService Intake' is from outlet AdContext.ToTargetingService.ToTargetingServiceToAdContext to inlet AdContext.AdContextFromToTargetingService with {
    briefly "Answers translated by ToTargetingService, on their way in"
  }
  inlet AdContextFromToAdDecisionService is command AdImpression.RecordImpression with {
    briefly "What ToAdDecisionService makes of the answers it gets"
  }
  connector 'ToAdDecisionService Intake' is from outlet AdContext.ToAdDecisionService.ToAdDecisionServiceToAdContext to inlet AdContext.AdContextFromToAdDecisionService with {
    briefly "Answers translated by ToAdDecisionService, on their way in"
  }
  inlet AdImpressionCommandStreamIn is type AdImpressionCommand  outlet AdImpressionCommandStreamOut is type AdImpressionCommand
  inlet AdImpressionResultStreamIn is result AdImpression.AdImpressionResult  outlet AdImpressionResultStreamOut is result AdImpression.AdImpressionResult
  handler AdContextBoundary is {
    on recordTargetingOutcome: command AdImpression.RecordTargetingOutcome is {
      send recordTargetingOutcome to outlet AdContext.AdImpressionCommandStreamOut
    }
    on attributeToCampaign: command AdImpression.AttributeToCampaign is {
      send attributeToCampaign to outlet AdContext.AdImpressionCommandStreamOut
    }
    on openImpressionOpportunity: command AdImpression.OpenImpressionOpportunity is {
      send openImpressionOpportunity to outlet AdContext.AdImpressionCommandStreamOut
    }
    on recordImpression: command AdImpression.RecordImpression is {
      send recordImpression to outlet AdContext.AdImpressionCommandStreamOut
    }
    on recordStart: command AdImpression.RecordStart is {
      send recordStart to outlet AdContext.AdImpressionCommandStreamOut
    }
    on recordQuartile: command AdImpression.RecordQuartile is {
      send recordQuartile to outlet AdContext.AdImpressionCommandStreamOut
    }
    on recordComplete: command AdImpression.RecordComplete is {
      send recordComplete to outlet AdContext.AdImpressionCommandStreamOut
    }
    on recordSkip: command AdImpression.RecordSkip is {
      send recordSkip to outlet AdContext.AdImpressionCommandStreamOut
    }
    on recordClick: command AdImpression.RecordClick is {
      send recordClick to outlet AdContext.AdImpressionCommandStreamOut
    }
    on recordError: command AdImpression.RecordError is {
      send recordError to outlet AdContext.AdImpressionCommandStreamOut
    }
    on adImpressionResult: result AdImpression.AdImpressionResult is {
      send adImpressionResult to outlet AdContext.AdImpressionResultStreamOut
    }
    on other is {
      error "Unexpected message at the AdContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AdImpressionCommand Stream Intake' is from outlet AdContext.AdImpressionCommandStreamOut to inlet AdContext.AdImpression.AdImpressionCommands  connector 'AdImpressionResult Stream Egress' is from outlet AdContext.AdRepository.AdRepositoryResponses to inlet AdContext.AdImpressionResultStreamIn  adaptor ToAdDecisionService to context AdDecisionService as router is { 
    outlet ToAdDecisionServiceToAdContext is command AdImpression.RecordImpression
    inlet ToAdDecisionServiceIn is type AdImpressionEvent    inlet ToAdDecisionServiceReplies is result AdDecisionService.AdDecision    outlet ToAdDecisionServiceOut is query AdDecisionService.RequestAd
    handler ToAdDecisionServiceHandler is {
      on impressionOpportunityOpened: event AdImpression.ImpressionOpportunityOpened is {
        let askAnswer: type AdDecisionService.AdDecision = ask query AdDecisionService.RequestAd of context AdDecisionService
        do "an opportunity opening needing an ad chosen to fill it"
        when prompt("not askAnswer.noFill") then
          send command AdImpression.RecordImpression(impressionId = impressionOpportunityOpened.impressionId, adUnit = askAnswer.selectedAdUnit, placement = impressionOpportunityOpened.placement, viewer = impressionOpportunityOpened.viewer) to outlet AdContext.ToAdDecisionService.ToAdDecisionServiceToAdContext
        end
      }
      on other is {
        error "Unexpected message for adaptor ToAdDecisionService"
      }
    } with {
      briefly "to ad decision service"
      described as {
        |Carries messages to the external AdDecisionService.
      }
    }
  } with {
    briefly "AdDecisionService integration"
    described as {
      |The model's side of the AdDecisionService conversation.
    }
  }
  adaptor FromBillingService from context BillingService as sink is { 
    inlet FromBillingServiceIn is event BillingService.BillableEventRecorded    handler FromBillingServiceHandler is {
      on billableEventRecorded: event BillingService.BillableEventRecorded is {
        do "billing has the event; the impression was recorded here first"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService as flow is { 
    inlet ToBillingServiceIn is type AdImpressionEvent    outlet ToBillingServiceOut is command BillingService.RecordBillableEvent
    handler ToBillingServiceHandler is {
      on impressionRecorded: event AdImpression.ImpressionRecorded is {
        let item0: type BillingService.RecordBillableEvent = prompt("translate the impressionRecorded event into a RecordBillableEvent, an impression being what an advertiser pays for")
        send item0 to outlet AdContext.ToBillingService.ToBillingServiceOut
      }
      on adClicked: event AdImpression.AdClicked is {
        let item0: type BillingService.RecordBillableEvent = prompt("translate the adClicked event into a RecordBillableEvent, and a click being what they pay more for")
        send item0 to outlet AdContext.ToBillingService.ToBillingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromCampaignService from context CampaignService as sink is { 
    inlet FromCampaignServiceIn is event CampaignService.CampaignUpdated    handler FromCampaignServiceHandler is {
      on campaignUpdated: event CampaignService.CampaignUpdated is {
        do "campaign changes apply to opportunities not yet filled; one already served stands"
      }
      on other is {
        error "Unexpected message for adaptor FromCampaignService"
      }
    } with {
      briefly "from campaign service"
      described as {
        |Carries messages from the external CampaignService.
      }
    }
  } with {
    briefly "CampaignService integration"
    described as {
      |The model's side of the CampaignService conversation.
    }
  }
  adaptor ToCampaignService to context CampaignService as router is { 
    outlet ToCampaignServiceToAdContext is command AdImpression.AttributeToCampaign
    inlet ToCampaignServiceIn is type AdImpressionEvent    inlet ToCampaignServiceReplies is result CampaignService.GetCampaignResult    outlet ToCampaignServiceOut is query CampaignService.GetCampaign
    handler ToCampaignServiceHandler is {
      on impressionRecorded: event AdImpression.ImpressionRecorded is {
        let askAnswer: type CampaignService.GetCampaignResult = ask query CampaignService.GetCampaign of context CampaignService
        do "a recorded impression needing the campaign it should be counted against"
        send command AdImpression.AttributeToCampaign(impressionId = impressionRecorded.impressionId, campaignId = prompt("the campaign id of this attribute to campaign")) to outlet AdContext.ToCampaignService.ToCampaignServiceToAdContext
      }
      on other is {
        error "Unexpected message for adaptor ToCampaignService"
      }
    } with {
      briefly "to campaign service"
      described as {
        |Carries messages to the external CampaignService.
      }
    }
  } with {
    briefly "CampaignService integration"
    described as {
      |The model's side of the CampaignService conversation.
    }
  }
  adaptor FromFraudDetectionService from context FraudDetectionService as sink is { 
    inlet FromFraudDetectionServiceIn is event FraudDetectionService.ImpressionValidated    handler FromFraudDetectionServiceHandler is {
      on impressionValidated: event FraudDetectionService.ImpressionValidated is {
        do "fraud has looked; the impression was recorded when it was served"
      }
      on other is {
        error "Unexpected message for adaptor FromFraudDetectionService"
      }
    } with {
      briefly "from fraud detection service"
      described as {
        |Carries messages from the external FraudDetectionService.
      }
    }
  } with {
    briefly "FraudDetectionService integration"
    described as {
      |The model's side of the FraudDetectionService conversation.
    }
  }
  adaptor ToFraudDetectionService to context FraudDetectionService as flow is { 
    inlet ToFraudDetectionServiceIn is type AdImpressionEvent    outlet ToFraudDetectionServiceOut is command FraudDetectionService.CheckImpression
    handler ToFraudDetectionServiceHandler is {
      on impressionRecorded: event ImpressionRecorded is {
        let item0: type FraudDetectionService.CheckImpression = prompt("translate the impressionRecorded event into a CheckImpression, since an impression is only worth paying for if it was real")
        send item0 to outlet AdContext.ToFraudDetectionService.ToFraudDetectionServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToFraudDetectionService"
      }
    } with {
      briefly "to fraud detection service"
      described as {
        |Carries messages to the external FraudDetectionService.
      }
    }
  } with {
    briefly "FraudDetectionService integration"
    described as {
      |The model's side of the FraudDetectionService conversation.
    }
  }
  adaptor FromRTBExchange from context RTBExchange as sink is { 
    inlet FromRTBExchangeIn is event RTBExchange.BidResponseReceived    handler FromRTBExchangeHandler is {
      on bidResponseReceived: event RTBExchange.BidResponseReceived is {
        do "a bid response decides which ad is served; the impression is recorded when it actually renders"
      }
      on other is {
        error "Unexpected message for adaptor FromRTBExchange"
      }
    } with {
      briefly "from rtb exchange"
      described as {
        |Carries messages from the external RTBExchange.
      }
    }
  } with {
    briefly "RTBExchange integration"
    described as {
      |The model's side of the RTBExchange conversation.
    }
  }
  adaptor ToRTBExchange to context RTBExchange as flow is { 
    inlet ToRTBExchangeIn is type AdImpressionEvent    outlet ToRTBExchangeOut is command RTBExchange.SendBidRequest
    handler ToRTBExchangeHandler is {
      on impressionOpportunityOpened: event AdImpression.ImpressionOpportunityOpened is {
        let item0: type RTBExchange.SendBidRequest = prompt("translate the impressionOpportunityOpened event into a SendBidRequest, a slot coming free being what is auctioned, before any ad has been chosen")
        send item0 to outlet AdContext.ToRTBExchange.ToRTBExchangeOut
      }
      on other is {
        error "Unexpected message for adaptor ToRTBExchange"
      }
    } with {
      briefly "to rtb exchange"
      described as {
        |Carries messages to the external RTBExchange.
      }
    }
  } with {
    briefly "RTBExchange integration"
    described as {
      |The model's side of the RTBExchange conversation.
    }
  }
  adaptor ToTargetingService to context TargetingService as router is { 
    outlet ToTargetingServiceToAdContext is command AdImpression.RecordTargetingOutcome
    inlet ToTargetingServiceIn is type AdImpressionEvent    inlet ToTargetingServiceReplies is result TargetingService.TargetingResult    outlet ToTargetingServiceOut is query TargetingService.EvaluateTargeting
    handler ToTargetingServiceHandler is {
      on impressionOpportunityOpened: event AdImpression.ImpressionOpportunityOpened is {
        let askAnswer: type TargetingService.TargetingResult = ask query TargetingService.EvaluateTargeting of context TargetingService
        do "an opportunity opening needing the viewer matched against the targeting rules"
        send command AdImpression.RecordTargetingOutcome(impressionId = impressionOpportunityOpened.impressionId, matches = prompt("the matches of this record targeting outcome"), score = prompt("the score of this record targeting outcome")) to outlet AdContext.ToTargetingService.ToTargetingServiceToAdContext
      }
      on other is {
        error "Unexpected message for adaptor ToTargetingService"
      }
    } with {
      briefly "to targeting service"
      described as {
        |Carries messages to the external TargetingService.
      }
    }
  } with {
    briefly "TargetingService integration"
    described as {
      |The model's side of the TargetingService conversation.
    }
  }
  include "types.riddl"
  include "AdImpression.riddl"
  // Repository for ad persistence
  type AdRepositoryCommand is one of {
    AdContext.AdRepository.PersistAdClicked or AdContext.AdRepository.PersistAdCompleted or AdContext.AdRepository.PersistAdErrorOccurred or AdContext.AdRepository.PersistAdSkipped or AdContext.AdRepository.PersistAdStarted or AdContext.AdRepository.PersistImpressionOpportunityOpened or AdContext.AdRepository.PersistImpressionRecorded or AdContext.AdRepository.PersistQuartileReached
  } with {
    briefly "Anything that writes AdRepository"
    described as {
      |The persistence commands AdRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository AdRepository as flow is {
    inlet AdRepositoryFromAdAnalytics is type AdRepositoryCommand    command PersistAdErrorOccurred is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row AdErrorOccurred applies to.
        }
      }
    } with {
      briefly "Persist AdErrorOccurred"
      described as {
        |Instructs this repository to apply AdErrorOccurred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAdSkipped is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row AdSkipped applies to.
        }
      }
    } with {
      briefly "Persist AdSkipped"
      described as {
        |Instructs this repository to apply AdSkipped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistQuartileReached is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row QuartileReached applies to.
        }
      }
    } with {
      briefly "Persist QuartileReached"
      described as {
        |Instructs this repository to apply QuartileReached to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAdClicked is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row AdClicked applies to.
        }
      }
    } with {
      briefly "Persist AdClicked"
      described as {
        |Instructs this repository to apply AdClicked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAdCompleted is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row AdCompleted applies to.
        }
      }
    } with {
      briefly "Persist AdCompleted"
      described as {
        |Instructs this repository to apply AdCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAdStarted is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row AdStarted applies to.
        }
      }
    } with {
      briefly "Persist AdStarted"
      described as {
        |Instructs this repository to apply AdStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistImpressionOpportunityOpened is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ImpressionOpportunityOpened applies to.
        }
      }
    } with {
      briefly "Persist ImpressionOpportunityOpened"
      described as {
        |Instructs this repository to apply ImpressionOpportunityOpened to
        |the stored row. A persistence command, not a domain command: it
        |declares no `yields` because storing a row records no new entity
        |state.
      }
    }
    command PersistImpressionRecorded is {
      impressionId: ImpressionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ImpressionRecorded applies to.
        }
      }
    } with {
      briefly "Persist ImpressionRecorded"
      described as {
        |Instructs this repository to apply ImpressionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet AdRepositoryResponses is result AdImpression.AdImpressionResult
    record StoredAdImpression is {
      adImpressionId: UUID with {
        briefly "adImpressionId"
        described as {
          |The adImpressionId column of the stored adImpression row.
        }
      }
      adUnit: AdUnit with {
        briefly "adUnit"
        described as {
          |The adUnit column of the stored adImpression row.
        }
      }
      impressionId: ImpressionId with {
        briefly "impressionId"
        described as {
          |The impressionId column of the stored adImpression row.
        }
      }
    } with {
      briefly "Stored adImpression row"
      described as {
        |The persistence shape of adImpression data as this repository stores it.
      }
    }
    schema AdData is relational
      of impressions as record StoredAdImpression
        index on field StoredAdImpression.impressionId
        index on field StoredAdImpression.adUnit.campaignId
 with {
      briefly "Ad data schema"
      described as {
        |The relational schema holding ad data for the AdRepository.
      }
    }
    handler AdPersistence is {
      on persistAdErrorOccurred: command PersistAdErrorOccurred is {
        do "apply AdErrorOccurred to the stored row"
      }
      on persistAdSkipped: command PersistAdSkipped is {
        do "apply AdSkipped to the stored row"
      }
      on persistQuartileReached: command PersistQuartileReached is {
        do "apply QuartileReached to the stored row"
      }
      on persistAdClicked: command PersistAdClicked is {
        do "apply AdClicked to the stored row"
      }
      on persistAdCompleted: command PersistAdCompleted is {
        do "apply AdCompleted to the stored row"
      }
      on persistAdStarted: command PersistAdStarted is {
        do "apply AdStarted to the stored row"
      }
      on persistImpressionOpportunityOpened: command PersistImpressionOpportunityOpened is {
        do "apply ImpressionOpportunityOpened to the stored row"
      }
      on persistImpressionRecorded: command PersistImpressionRecorded is {
        do "apply ImpressionRecorded to the stored row"
      }
      on query GetCampaignStats is {
        let campaignStatsView: type CampaignStatsView = prompt("read the campaign stats projection")
        reply campaignStatsView
      }
    } with {
      briefly "Persists ad commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Ad data persistence"
    described as {
      | The AdRepository provides persistent storage for
      | ad impressions and engagement data.
    }
  }
  // Projector for ad analytics
  query GetCampaignStats replies result CampaignStatsView is {
    campaignStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which campaign stats to retrieve.
      }
    }
  } with {
    briefly "Get campaign stats"
    described as {
      |Retrieves the campaign stats projection.
    }
  }
  result CampaignStatsView is {
    campaignStats: AdAnalytics.CampaignStats with {
      briefly "Campaign stats"
      described as {
        |The campaign stats being returned.
      }
    }
  } with {
    briefly "Campaign stats view"
    described as {
      |Read model view carrying the campaign stats projection.
    }
  }
  projector AdAnalytics as flow is {
    updates repository AdContext.AdRepository
    outlet AdAnalyticsToRepository is type AdRepositoryCommand
    inlet AdAnalyticsFromAdImpression is type AdImpressionEvent    record CampaignStats is {
      campaignId: CampaignId with {
        briefly "Campaign"
        described as {
          |Campaign ID.
        }
      }
      impressions: Natural with {
        briefly "Impressions"
        described as {
          |Total impressions.
        }
      }
      views: Natural with {
        briefly "Views"
        described as {
          |View count.
        }
      }
      completions: Natural with {
        briefly "Completions"
        described as {
          |Completion count.
        }
      }
      clicks: Natural with {
        briefly "Clicks"
        described as {
          |Click count.
        }
      }
      clickRate: Decimal(5,4) with {
        briefly "CTR"
        described as {
          |Click-through rate.
        }
      }
      completionRate: Decimal(5,4) with {
        briefly "VCR"
        described as {
          |View completion rate.
        }
      }
    } with {
      briefly "Campaign statistics"
      described as {
        |Campaign performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on impressionOpportunityOpened: event AdImpression.ImpressionOpportunityOpened is {
        tell command AdContext.AdRepository.PersistImpressionOpportunityOpened(impressionId = impressionOpportunityOpened.impressionId) to repository AdContext.AdRepository
        do "apply ImpressionOpportunityOpened to the AdAnalytics projection"
      }
      on adErrorOccurred: event AdImpression.AdErrorOccurred is {
        tell command AdContext.AdRepository.PersistAdErrorOccurred(impressionId = adErrorOccurred.impressionId) to repository AdContext.AdRepository
        do "apply AdErrorOccurred to the AdAnalytics projection"
      }
      on adSkipped: event AdImpression.AdSkipped is {
        tell command AdContext.AdRepository.PersistAdSkipped(impressionId = adSkipped.impressionId) to repository AdContext.AdRepository
        do "apply AdSkipped to the AdAnalytics projection"
      }
      on quartileReached: event AdImpression.QuartileReached is {
        tell command AdContext.AdRepository.PersistQuartileReached(impressionId = quartileReached.impressionId) to repository AdContext.AdRepository
        do "apply QuartileReached to the AdAnalytics projection"
      }
      on impressionRecorded: event AdImpression.ImpressionRecorded is {
        tell command AdContext.AdRepository.PersistImpressionRecorded(impressionId = impressionRecorded.impressionId) to repository AdContext.AdRepository
      }
      on adStarted: event AdImpression.AdStarted is {
        tell command AdContext.AdRepository.PersistAdStarted(impressionId = adStarted.impressionId) to repository AdContext.AdRepository
      }
      on adCompleted: event AdImpression.AdCompleted is {
        tell command AdContext.AdRepository.PersistAdCompleted(impressionId = adCompleted.impressionId) to repository AdContext.AdRepository
      }
      on adClicked: event AdImpression.AdClicked is {
        tell command AdContext.AdRepository.PersistAdClicked(impressionId = adClicked.impressionId) to repository AdContext.AdRepository
      }
      on campaignAttributed: event AdImpression.CampaignAttributed is {
        do "a campaign attributed changes nothing this projector keeps"
      }
      on targetingOutcomeRecorded: event AdImpression.TargetingOutcomeRecorded is {
        do "a targeting outcome recorded changes nothing this projector keeps"
      }
    } with {
      briefly "Maintains ad analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Ad analytics projections"
    described as {
      |Maintains advertising analytics data.
    }
  }
  streamlet AdImpressionEventSplit as split is {
    outlet AdImpressionEventSplitToToTargetingService is type AdImpressionEvent
    outlet AdImpressionEventSplitToToRTBExchange is type AdImpressionEvent
    outlet AdImpressionEventSplitToToAdDecisionService is type AdImpressionEvent
    outlet AdImpressionEventSplitToToFraudDetectionService is type AdImpressionEvent
    outlet AdImpressionEventSplitToToCampaignService is type AdImpressionEvent
    outlet AdImpressionEventSplitToToBillingService is type AdImpressionEvent
    inlet AdImpressionEventSplitIn is type AdImpressionEvent    outlet AdImpressionEventSplitToAdAnalytics is type AdImpressionEvent
    handler AdImpressionEventSplitHandler is {
      on impressionRecorded: event AdImpression.ImpressionRecorded is {
        send impressionRecorded to outlet AdImpressionEventSplitToAdAnalytics
        send impressionRecorded to outlet AdImpressionEventSplitToToFraudDetectionService
        send impressionRecorded to outlet AdImpressionEventSplitToToCampaignService
        send impressionRecorded to outlet AdImpressionEventSplitToToBillingService
        tell impressionRecorded to entity AdContext.AdImpression
      }
      on adStarted: event AdImpression.AdStarted is {
        send adStarted to outlet AdImpressionEventSplitToAdAnalytics
        tell adStarted to entity AdContext.AdImpression
      }
      on quartileReached: event AdImpression.QuartileReached is {
        send quartileReached to outlet AdImpressionEventSplitToAdAnalytics
        tell quartileReached to entity AdContext.AdImpression
      }
      on adCompleted: event AdImpression.AdCompleted is {
        send adCompleted to outlet AdImpressionEventSplitToAdAnalytics
        tell adCompleted to entity AdContext.AdImpression
      }
      on adSkipped: event AdImpression.AdSkipped is {
        send adSkipped to outlet AdImpressionEventSplitToAdAnalytics
        tell adSkipped to entity AdContext.AdImpression
      }
      on adClicked: event AdImpression.AdClicked is {
        send adClicked to outlet AdImpressionEventSplitToAdAnalytics
        send adClicked to outlet AdImpressionEventSplitToToBillingService
        tell adClicked to entity AdContext.AdImpression
      }
      on adErrorOccurred: event AdImpression.AdErrorOccurred is {
        send adErrorOccurred to outlet AdImpressionEventSplitToAdAnalytics
        tell adErrorOccurred to entity AdContext.AdImpression
      }
      on impressionOpportunityOpened: event AdImpression.ImpressionOpportunityOpened is {
        send impressionOpportunityOpened to outlet AdImpressionEventSplitToToAdDecisionService
        send impressionOpportunityOpened to outlet AdImpressionEventSplitToToRTBExchange
        send impressionOpportunityOpened to outlet AdImpressionEventSplitToToTargetingService
      }
      on targetingOutcomeRecorded: event AdImpression.TargetingOutcomeRecorded is {
        send targetingOutcomeRecorded to outlet AdImpressionEventSplitToToAdDecisionService
        send targetingOutcomeRecorded to outlet AdImpressionEventSplitToToRTBExchange
        send targetingOutcomeRecorded to outlet AdImpressionEventSplitToToTargetingService
      }
      on campaignAttributed: event AdImpression.CampaignAttributed is {
        send campaignAttributed to outlet AdImpressionEventSplitToToAdDecisionService
        send campaignAttributed to outlet AdImpressionEventSplitToToRTBExchange
        send campaignAttributed to outlet AdImpressionEventSplitToToTargetingService
      }
      on other is {
        error "Unexpected message for processor AdImpressionEventSplit"
      }
    } with {
      briefly "AdImpression event fan-out handler"
      described as {
        |Delivers each AdImpression event to all of its consumers.
      }
    }
  } with {
    briefly "AdImpression event fan-out"
    described as {
      |Fans AdImpression events out to the repository and projectors.
    }
  }
  connector 'ToFraudDetectionService Feed' is from outlet AdContext.AdImpressionEventSplit.AdImpressionEventSplitToToFraudDetectionService to inlet AdContext.ToFraudDetectionService.ToFraudDetectionServiceIn with {
    briefly "The AdImpression events ToFraudDetectionService translates, on their way to it"
  }
  connector 'ToCampaignService Feed' is from outlet AdContext.AdImpressionEventSplit.AdImpressionEventSplitToToCampaignService to inlet AdContext.ToCampaignService.ToCampaignServiceIn with {
    briefly "The AdImpression events ToCampaignService translates, on their way to it"
  }
  connector 'ToBillingService Feed' is from outlet AdContext.AdImpressionEventSplit.AdImpressionEventSplitToToBillingService to inlet AdContext.ToBillingService.ToBillingServiceIn with {
    briefly "The AdImpression events ToBillingService translates, on their way to it"
  }
  connector 'ToTargetingService Feed' is from outlet AdContext.AdImpressionEventSplit.AdImpressionEventSplitToToTargetingService to inlet AdContext.ToTargetingService.ToTargetingServiceIn with {
    briefly "The AdImpression events ToTargetingService translates, on their way to it"
  }
  connector 'ToRTBExchange Feed' is from outlet AdContext.AdImpressionEventSplit.AdImpressionEventSplitToToRTBExchange to inlet AdContext.ToRTBExchange.ToRTBExchangeIn with {
    briefly "The AdImpression events ToRTBExchange translates, on their way to it"
  }
  connector 'ToAdDecisionService Feed' is from outlet AdContext.AdImpressionEventSplit.AdImpressionEventSplitToToAdDecisionService to inlet AdContext.ToAdDecisionService.ToAdDecisionServiceIn with {
    briefly "The AdImpression events ToAdDecisionService translates, on their way to it"
  }
  connector 'AdImpressionEvent Stream' is from outlet AdContext.AdImpression.AdImpressionEvents2 to inlet AdContext.AdImpressionEventSplit.AdImpressionEventSplitIn with {
    briefly "AdImpression events, fanned out to storage and read models"
  }
  connector 'AdAnalytics Feed' is from outlet AdContext.AdImpressionEventSplit.AdImpressionEventSplitToAdAnalytics to inlet AdContext.AdAnalytics.AdAnalyticsFromAdImpression with {
    briefly "AdImpression events feeding the AdAnalytics projection"
  }
  connector 'AdAnalytics Storage' is from outlet AdContext.AdAnalytics.AdAnalyticsToRepository to inlet AdContext.AdRepository.AdRepositoryFromAdAnalytics with {
    briefly "AdAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for advertising"
  described as {
    | The AdContext is the bounded context for ad delivery,
    | impression tracking, and performance analytics.
  }
}
