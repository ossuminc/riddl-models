// Advertising Delivery Domain Model
// Ad serving, targeting, and performance tracking
domain AdvertisingDelivery is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user AdOperator is "person managing ad campaigns" with {
    briefly "Ad Operator"
    described as {
      |Person configuring ad delivery.
    }
  }
  user Advertiser is "business running advertisements" with {
    briefly "Advertiser"
    described as {
      |Company purchasing ad inventory.
    }
  }
  user Publisher is "platform displaying advertisements" with {
    briefly "Publisher"
    described as {
      |Media platform showing ads.
    }
  }
  epic AdDeliveryEpic is {
    user AdOperator wants to "to serve relevant ads to viewers" so that "advertisers reach target audiences"
    case ServeAdvertisement is {
      user AdOperator wants to "to deliver ads during content playback" so that "monetization occurs seamlessly"
      step is "Platform requests" "ad decision" "for viewer context" with {
        briefly "Request ad"
        described as {
          |Get ad for placement.
        }
      }
      step is "System selects" "best matching ad" "based on targeting" with {
        briefly "Select ad"
        described as {
          |Choose optimal ad.
        }
      }
      step take input AdvertisingDeliveryApp.AdvertisingDeliveryScreen.RecordImpressionInput from user Publisher with {
        briefly "Record impression"
        described as {
          |Log ad view.
        }
      }
      step is "System tracks" "viewer engagement" "for performance" with {
        briefly "Track engagement"
        described as {
          |Monitor interaction.
        }
      }
    } with {
      briefly "Ad delivery workflow"
      described as {
        |Standard flow for serving advertisements.
      }
    }
  } with {
    briefly "Ad delivery processing"
    described as {
      | Epic covering ad selection, delivery,
      | and performance measurement.
    }
  }
  include "AdContext.riddl"
  include "external-contexts.riddl"
  application context AdvertisingDeliveryApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in AdvertisingDelivery are delivered.
      }
    }
    group AdvertisingDeliveryScreen is {
      input RecordImpressionInput acquires command AdContext.AdImpression.RecordImpression with {
        briefly "Record impression control"
        described as {
          |The control through which a user submits the record impression request.
        }
      }
    } with {
      briefly "Advertising delivery screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppAdImpressionCommands is type AdContext.AdImpression.AdImpressionCommand
    inlet AppAdRepositoryResponses is type AdContext.AdImpression.AdImpressionResult    handler AdvertisingDeliveryAppHandler is {
      on other is {
        error "Unexpected message for application context AdvertisingDeliveryApp"
      }
    } with {
      briefly "AdvertisingDeliveryApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "AdvertisingDeliveryApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'AdImpressionCommand Stream' is from outlet AdvertisingDeliveryApp.AppAdImpressionCommands to inlet AdContext.AdImpression.AdImpressionCommands with {
    option persistent()
    briefly "AdImpression commands from the application"
  }
  connector 'AdImpressionResult Stream' is from outlet AdContext.AdRepository.AdRepositoryResponses to inlet AdvertisingDeliveryApp.AppAdRepositoryResponses with {
    option persistent()
    briefly "Ad query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet AdvertisingDeliveryApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term AdDecision is  "The decision selecting which ad to serve for a viewer request." 
  briefly "Advertising delivery domain"
  described as {
    | The AdvertisingDelivery domain handles ad serving,
    | targeting, impressions, and conversion tracking.
  }
}
