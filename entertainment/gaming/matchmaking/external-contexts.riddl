// Matchmaking - External Contexts
// Queue Service
external context QueueService as flow is {
  outlet QueueServiceEventsOut is event PlayerQueued
 with {
    briefly "What this service tells the model, unasked"
  }
  type QueueServiceCommand is one of {
    AddToQueue or RemoveFromQueue
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet QueueServiceRequests is type QueueServiceCommand with {
    briefly "What this context asks the service to send"
  }
  handler QueueServiceBoundary is {
    on command AddToQueue is {
      let playerQueued: type PlayerQueued = prompt("the player queued this produces")
      send playerQueued to outlet QueueService.QueueServiceEventsOut
      do "deliver it to the recipient"
    }
    on command RemoveFromQueue is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context QueueService"
    }
  } with {
    briefly "QueueService boundary"
  }
  command AddToQueue is {
    entry: QueueEntry with {
      briefly "Entry"
      described as {
        |Queue entry.
      }
    }
  } with {
    briefly "Add to queue"
    described as {
      |Adds player to matchmaking queue.
    }
  }
  command RemoveFromQueue is {
    playerId: PlayerId with {
      briefly "Player"
      described as {
        |Player to remove.
      }
    }
  } with {
    briefly "Remove from queue"
    described as {
      |Removes player from queue.
    }
  }
  event PlayerQueued is {
    playerId: PlayerId with {
      briefly "Player"
      described as {
        |Queued player.
      }
    }
    queuedAt: TimeStamp with {
      briefly "Queued"
      described as {
        |Queue time.
      }
    }
  } with {
    briefly "Player was queued"
    described as {
      |Emitted when player joins queue.
    }
  }
} with {
  briefly "External queue service"
  described as {
    |External matchmaking queue manager.
  }
}
// Server Allocation Service
external context ServerAllocationService as flow is {
  outlet ServerAllocationServiceEventsOut is event ServerAllocated
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet ServerAllocationServiceRequests is command RequestServer with {
    briefly "What this context asks the service to send"
  }
  handler ServerAllocationServiceBoundary is {
    on command RequestServer is {
      let serverAllocated: type ServerAllocated = prompt("the server allocated this produces")
      send serverAllocated to outlet ServerAllocationService.ServerAllocationServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context ServerAllocationService"
    }
  } with {
    briefly "ServerAllocationService boundary"
  }
  command RequestServer is {
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    region: String(1,50) with {
      briefly "Region"
      described as {
        |Preferred region.
      }
    }
    playerCount: Natural with {
      briefly "Players"
      described as {
        |Required capacity.
      }
    }
  } with {
    briefly "Request server"
    described as {
      |Requests game server allocation.
    }
  }
  event ServerAllocated is {
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    server: ServerAssignment with {
      briefly "Server"
      described as {
        |Allocated server.
      }
    }
    allocatedAt: TimeStamp with {
      briefly "Allocated"
      described as {
        |Allocation time.
      }
    }
  } with {
    briefly "Server was allocated"
    described as {
      |Emitted when server is assigned.
    }
  }
} with {
  briefly "External server service"
  described as {
    |External game server allocation.
  }
}
// Player Rating Service
external context RatingService as flow is {
  outlet RatingServiceEventsOut is event RatingUpdated
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet RatingServiceRequests is command UpdateRating with {
    briefly "What this context asks the service to send"
  }
  handler RatingServiceBoundary is {
    on command UpdateRating is {
      let ratingUpdated: type RatingUpdated = prompt("the rating updated this produces")
      send ratingUpdated to outlet RatingService.RatingServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context RatingService"
    }
  } with {
    briefly "RatingService boundary"
  }
  command UpdateRating is {
    playerId: PlayerId with {
      briefly "Player"
      described as {
        |Player ID.
      }
    }
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    ratingChange: Decimal(6,2) with {
      briefly "Change"
      described as {
        |Rating change.
      }
    }
  } with {
    briefly "Update rating"
    described as {
      |Updates player skill rating.
    }
  }
  event RatingUpdated is {
    playerId: PlayerId with {
      briefly "Player"
      described as {
        |Player ID.
      }
    }
    newRating: Decimal(8,2) with {
      briefly "Rating"
      described as {
        |New rating.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Rating was updated"
    described as {
      |Emitted when rating changes.
    }
  }
} with {
  briefly "External rating service"
  described as {
    |External player rating system.
  }
}
// Anti-Cheat Service
external context AntiCheatService as flow is {
  outlet AntiCheatServiceEventsOut is event PlayerValidated
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet AntiCheatServiceRequests is command ValidatePlayer with {
    briefly "What this context asks the service to send"
  }
  handler AntiCheatServiceBoundary is {
    on command ValidatePlayer is {
      let playerValidated: type PlayerValidated = prompt("the player validated this produces")
      send playerValidated to outlet AntiCheatService.AntiCheatServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context AntiCheatService"
    }
  } with {
    briefly "AntiCheatService boundary"
  }
  command ValidatePlayer is {
    playerId: PlayerId with {
      briefly "Player"
      described as {
        |Player ID.
      }
    }
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
  } with {
    briefly "Validate player"
    described as {
      |Checks player for cheating.
    }
  }
  event PlayerValidated is {
    playerId: PlayerId with {
      briefly "Player"
      described as {
        |Player ID.
      }
    }
    valid: Boolean with {
      briefly "Valid"
      described as {
        |Is valid.
      }
    }
    validatedAt: TimeStamp with {
      briefly "Validated"
      described as {
        |Validation time.
      }
    }
  } with {
    briefly "Player was validated"
    described as {
      |Emitted when validation completes.
    }
  }
} with {
  briefly "External anti-cheat service"
  described as {
    |External anti-cheat system.
  }
}
// Notification Service
external context NotificationService as sink is {
  inlet NotificationServiceRequests is command SendMatchNotification with {
    briefly "What this context asks the service to send"
  }
  handler NotificationServiceBoundary is {
    on command SendMatchNotification is {
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context NotificationService"
    }
  } with {
    briefly "NotificationService boundary"
  }
  command SendMatchNotification is {
    playerId: PlayerId with {
      briefly "Player"
      described as {
        |Player ID.
      }
    }
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    notificationType: String(1,50) with {
      briefly "Type"
      described as {
        |Notification type.
      }
    }
    message: String(1,500) with {
      briefly "Message"
      described as {
        |Notification message.
      }
    }
  } with {
    briefly "Send notification"
    described as {
      |Sends match notification.
    }
  }
  event NotificationSent is {
    notificationId: UUID with {
      briefly "Notification"
      described as {
        |Notification ID.
      }
    }
    sentAt: TimeStamp with {
      briefly "Sent"
      described as {
        |Send time.
      }
    }
  } with {
    briefly "Notification was sent"
    described as {
      |Emitted when notification is delivered.
    }
  }
} with {
  briefly "External notification service"
  described as {
    |External player notification system.
  }
}
