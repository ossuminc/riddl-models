// Matchmaking Domain Model
// Online game player matching and lobby management
domain Matchmaking is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Player is "person playing online games" with {
    briefly "Player"
    described as {
      |Gaming platform user.
    }
  }
  user GameAdmin is "person managing game servers" with {
    briefly "Game Admin"
    described as {
      |Person overseeing game operations.
    }
  }
  epic MatchmakingEpic is {
    user Player wants to "to find balanced matches quickly" so that "gameplay is enjoyable and fair"
    case FindMatch is {
      user Player wants to "to be matched with other players" so that "they can play a multiplayer game"
      step is "Player enters" "matchmaking queue" "for game mode" with {
        briefly "Enter queue"
        described as {
          |Join matchmaking.
        }
      }
      step is "System evaluates" "skill levels" "of queued players" with {
        briefly "Evaluate skill"
        described as {
          |Assess player ratings.
        }
      }
      step take input MatchmakingApp.MatchmakingScreen.CreateMatchInput from user GameAdmin with {
        briefly "Create match"
        described as {
          |Form player groups.
        }
      }
      step is "System assigns" "game server" "for the match" with {
        briefly "Assign server"
        described as {
          |Allocate resources.
        }
      }
    } with {
      briefly "Matchmaking workflow"
      described as {
        |Standard flow for finding matches.
      }
    }
  } with {
    briefly "Matchmaking processing"
    described as {
      | Epic covering player matching from queue
      | entry through match formation.
    }
  }
  include "MatchContext.riddl"
  include "external-contexts.riddl"
  application context MatchmakingApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in Matchmaking are delivered.
      }
    }
    group MatchmakingScreen is {
      input CreateMatchInput acquires command MatchContext.Match.CreateMatch with {
        briefly "Create match control"
        described as {
          |The control through which a user submits the create match request.
        }
      }
    } with {
      briefly "Matchmaking screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppMatchCommands is type MatchContext.Match.MatchCommand
    inlet AppMatchRepositoryResponses is type MatchContext.Match.MatchQueryResult    handler MatchmakingAppHandler is {
      on other is {
        error "Unexpected message for application context MatchmakingApp"
      }
    } with {
      briefly "MatchmakingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "MatchmakingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'MatchCommand Stream' is from outlet MatchmakingApp.AppMatchCommands to inlet MatchContext.Match.MatchCommands with {
    option persistent()
    briefly "Match commands from the application"
  }
  connector 'MatchQueryResult Stream' is from outlet MatchContext.MatchRepository.MatchRepositoryResponses to inlet MatchmakingApp.AppMatchRepositoryResponses with {
    option persistent()
    briefly "Match query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet MatchmakingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Matchmaking domain"
  described as {
    | The Matchmaking domain handles player matching,
    | skill-based grouping, and lobby management.
  }
}
