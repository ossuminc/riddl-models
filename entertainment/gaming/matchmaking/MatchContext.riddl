// Matchmaking - Match Context
context MatchContext as router is {
  inlet MatchContextFromAntiCheatService is command Match.ConfirmPlayer with {
    briefly "What FromAntiCheatService makes of that service's news"
  }
  connector 'FromAntiCheatService Intake' is from outlet MatchContext.FromAntiCheatService.FromAntiCheatServiceToMatchContext to inlet MatchContext.MatchContextFromAntiCheatService with {
    briefly "What FromAntiCheatService makes of that news, on its way in"
  }
  inlet MatchContextFromServerAllocationService is command Match.AssignServer with {
    briefly "What FromServerAllocationService makes of that service's news"
  }
  connector 'FromServerAllocationService Intake' is from outlet MatchContext.FromServerAllocationService.FromServerAllocationServiceToMatchContext to inlet MatchContext.MatchContextFromServerAllocationService with {
    briefly "What FromServerAllocationService makes of that news, on its way in"
  }
  inlet MatchCommandStreamIn is type MatchCommand  outlet MatchCommandStreamOut is type MatchCommand
  inlet MatchQueryResultStreamIn is result Match.MatchQueryResult  outlet MatchQueryResultStreamOut is result Match.MatchQueryResult
  handler MatchContextBoundary is {
    on createMatch: command Match.CreateMatch is {
      send createMatch to outlet MatchContext.MatchCommandStreamOut
    }
    on assignServer: command Match.AssignServer is {
      send assignServer to outlet MatchContext.MatchCommandStreamOut
    }
    on confirmPlayer: command Match.ConfirmPlayer is {
      send confirmPlayer to outlet MatchContext.MatchCommandStreamOut
    }
    on startMatch: command Match.StartMatch is {
      send startMatch to outlet MatchContext.MatchCommandStreamOut
    }
    on updateScore: command Match.UpdateScore is {
      send updateScore to outlet MatchContext.MatchCommandStreamOut
    }
    on endMatch: command Match.EndMatch is {
      send endMatch to outlet MatchContext.MatchCommandStreamOut
    }
    on cancelMatch: command Match.CancelMatch is {
      send cancelMatch to outlet MatchContext.MatchCommandStreamOut
    }
    on removePlayer: command Match.RemovePlayer is {
      send removePlayer to outlet MatchContext.MatchCommandStreamOut
    }
    on matchQueryResult: result Match.MatchQueryResult is {
      send matchQueryResult to outlet MatchContext.MatchQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the MatchContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'MatchCommand Stream Intake' is from outlet MatchContext.MatchCommandStreamOut to inlet MatchContext.Match.MatchCommands  connector 'MatchQueryResult Stream Egress' is from outlet MatchContext.MatchRepository.MatchRepositoryResponses to inlet MatchContext.MatchQueryResultStreamIn  adaptor FromAntiCheatService from context AntiCheatService as flow is { 
    inlet FromAntiCheatServiceIn is event AntiCheatService.PlayerValidated    outlet FromAntiCheatServiceToMatchContext is command Match.ConfirmPlayer
    handler FromAntiCheatServiceHandler is {
      on playerValidated: event AntiCheatService.PlayerValidated is {
        let item0: type Match.ConfirmPlayer = prompt("translate the playerValidated event into a ConfirmPlayer, a player cleared by anti-cheat is one the match can confirm")
        send item0 to outlet MatchContext.FromAntiCheatService.FromAntiCheatServiceToMatchContext
      }
      on other is {
        error "Unexpected message for adaptor FromAntiCheatService"
      }
    } with {
      briefly "from anti cheat service"
      described as {
        |Carries messages from the external AntiCheatService.
      }
    }
  } with {
    briefly "AntiCheatService integration"
    described as {
      |The model's side of the AntiCheatService conversation.
    }
  }
  adaptor ToAntiCheatService to context AntiCheatService as flow is { 
    inlet ToAntiCheatServiceIn is type MatchEvent    outlet ToAntiCheatServiceOut is command AntiCheatService.ValidatePlayer
    handler ToAntiCheatServiceHandler is {
      on playerConfirmed: event Match.PlayerConfirmed is {
        let item0: type AntiCheatService.ValidatePlayer = prompt("translate the playerConfirmed event into a ValidatePlayer, a player having to be clean before the match counts")
        send item0 to outlet MatchContext.ToAntiCheatService.ToAntiCheatServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToAntiCheatService"
      }
    } with {
      briefly "to anti cheat service"
      described as {
        |Carries messages to the external AntiCheatService.
      }
    }
  } with {
    briefly "AntiCheatService integration"
    described as {
      |The model's side of the AntiCheatService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type MatchEvent    outlet ToNotificationServiceOut is command NotificationService.SendMatchNotification
    handler ToNotificationServiceHandler is {
      on matchCreated: event MatchCreated is {
        let notice: type NotificationService.SendMatchNotification = prompt("translate the matchCreated event into a SendMatchNotification telling the players a match has been formed and that they must confirm")
        send notice to outlet MatchContext.ToNotificationService.ToNotificationServiceOut
      }
      on serverAssigned: event ServerAssigned is {
        let notice: type NotificationService.SendMatchNotification = prompt("translate the serverAssigned event into a SendMatchNotification telling the players where to connect, since they cannot play without it")
        send notice to outlet MatchContext.ToNotificationService.ToNotificationServiceOut
      }
      on matchStarted: event MatchStarted is {
        let notice: type NotificationService.SendMatchNotification = prompt("translate the matchStarted event into a SendMatchNotification telling the players the match is live")
        send notice to outlet MatchContext.ToNotificationService.ToNotificationServiceOut
      }
      on matchCancelled: event MatchCancelled is {
        let notice: type NotificationService.SendMatchNotification = prompt("translate the matchCancelled event into a SendMatchNotification telling the players the match will not happen and why")
        send notice to outlet MatchContext.ToNotificationService.ToNotificationServiceOut
      }
      on playerRemoved: event PlayerRemoved is {
        let notice: type NotificationService.SendMatchNotification = prompt("translate the playerRemoved event into a SendMatchNotification telling the remaining players the roster changed, and the removed player why they are out")
        send notice to outlet MatchContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromQueueService from context QueueService as sink is { 
    inlet FromQueueServiceIn is event QueueService.PlayerQueued    handler FromQueueServiceHandler is {
      on playerQueued: event QueueService.PlayerQueued is {
        do "the player is waiting; a match forms when there are enough of them"
      }
      on other is {
        error "Unexpected message for adaptor FromQueueService"
      }
    } with {
      briefly "from queue service"
      described as {
        |Carries messages from the external QueueService.
      }
    }
  } with {
    briefly "QueueService integration"
    described as {
      |The model's side of the QueueService conversation.
    }
  }
  adaptor ToQueueService to context QueueService as flow is { 
    inlet ToQueueServiceIn is type MatchEvent    outlet ToQueueServiceOut is type QueueService.QueueServiceCommand
    handler ToQueueServiceHandler is {
      on matchCreated: event Match.MatchCreated is {
        let item0: type QueueService.AddToQueue = prompt("translate the matchCreated event into a AddToQueue, a match being what players queue for")
        send item0 to outlet MatchContext.ToQueueService.ToQueueServiceOut
      }
      on playerRemoved: event Match.PlayerRemoved is {
        let item0: type QueueService.RemoveFromQueue = prompt("translate the playerRemoved event into a RemoveFromQueue, and removal being what takes them out")
        send item0 to outlet MatchContext.ToQueueService.ToQueueServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToQueueService"
      }
    } with {
      briefly "to queue service"
      described as {
        |Carries messages to the external QueueService.
      }
    }
  } with {
    briefly "QueueService integration"
    described as {
      |The model's side of the QueueService conversation.
    }
  }
  adaptor FromRatingService from context RatingService as sink is { 
    inlet FromRatingServiceIn is event RatingService.RatingUpdated    handler FromRatingServiceHandler is {
      on ratingUpdated: event RatingService.RatingUpdated is {
        do "ratings settle after the match; the match itself is already over"
      }
      on other is {
        error "Unexpected message for adaptor FromRatingService"
      }
    } with {
      briefly "from rating service"
      described as {
        |Carries messages from the external RatingService.
      }
    }
  } with {
    briefly "RatingService integration"
    described as {
      |The model's side of the RatingService conversation.
    }
  }
  adaptor ToRatingService to context RatingService as flow is { 
    inlet ToRatingServiceIn is type MatchEvent    outlet ToRatingServiceOut is command RatingService.UpdateRating
    handler ToRatingServiceHandler is {
      on matchEnded: event Match.MatchEnded is {
        let item0: type RatingService.UpdateRating = prompt("translate the matchEnded event into a UpdateRating, the result being what changes a player's standing")
        send item0 to outlet MatchContext.ToRatingService.ToRatingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToRatingService"
      }
    } with {
      briefly "to rating service"
      described as {
        |Carries messages to the external RatingService.
      }
    }
  } with {
    briefly "RatingService integration"
    described as {
      |The model's side of the RatingService conversation.
    }
  }
  adaptor FromServerAllocationService from context ServerAllocationService as flow is { 
    inlet FromServerAllocationServiceIn is event ServerAllocationService.ServerAllocated    outlet FromServerAllocationServiceToMatchContext is command Match.AssignServer
    handler FromServerAllocationServiceHandler is {
      on serverAllocated: event ServerAllocationService.ServerAllocated is {
        let item0: type Match.AssignServer = prompt("translate the serverAllocated event into a AssignServer, an allocated server is what the match is assigned to play on")
        send item0 to outlet MatchContext.FromServerAllocationService.FromServerAllocationServiceToMatchContext
      }
      on other is {
        error "Unexpected message for adaptor FromServerAllocationService"
      }
    } with {
      briefly "from server allocation service"
      described as {
        |Carries messages from the external ServerAllocationService.
      }
    }
  } with {
    briefly "ServerAllocationService integration"
    described as {
      |The model's side of the ServerAllocationService conversation.
    }
  }
  adaptor ToServerAllocationService to context ServerAllocationService as flow is { 
    inlet ToServerAllocationServiceIn is type MatchEvent    outlet ToServerAllocationServiceOut is command ServerAllocationService.RequestServer
    handler ToServerAllocationServiceHandler is {
      on matchCreated: event Match.MatchCreated is {
        let item0: type ServerAllocationService.RequestServer = prompt("translate the matchCreated event into a RequestServer, a match needing somewhere to run before anyone joins")
        send item0 to outlet MatchContext.ToServerAllocationService.ToServerAllocationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToServerAllocationService"
      }
    } with {
      briefly "to server allocation service"
      described as {
        |Carries messages to the external ServerAllocationService.
      }
    }
  } with {
    briefly "ServerAllocationService integration"
    described as {
      |The model's side of the ServerAllocationService conversation.
    }
  }
  include "types.riddl"
  include "Match.riddl"
  // Repository for match persistence
  type MatchRepositoryCommand is one of {
    MatchContext.MatchRepository.PersistMatchCancelled or MatchContext.MatchRepository.PersistMatchCreated or MatchContext.MatchRepository.PersistMatchEnded or MatchContext.MatchRepository.PersistMatchStarted or MatchContext.MatchRepository.PersistPlayerConfirmed or MatchContext.MatchRepository.PersistPlayerRemoved or MatchContext.MatchRepository.PersistScoreUpdated or MatchContext.MatchRepository.PersistServerAssigned
  } with {
    briefly "Anything that writes MatchRepository"
    described as {
      |The persistence commands MatchRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository MatchRepository as flow is {
    inlet MatchRepositoryFromMatchAnalytics is type MatchRepositoryCommand    command PersistMatchCancelled is {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatchCancelled applies to.
        }
      }
      reason: String(1,200)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MatchCancelled"
      described as {
        |Instructs this repository to apply MatchCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayerConfirmed is {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayerConfirmed applies to.
        }
      }
      playerId: PlayerId? with {
        briefly "Player id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      confirmedAt: TimeStamp? with {
        briefly "Confirmed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PlayerConfirmed"
      described as {
        |Instructs this repository to apply PlayerConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayerRemoved is {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayerRemoved applies to.
        }
      }
      playerId: PlayerId? with {
        briefly "Player id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String(1,200)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PlayerRemoved"
      described as {
        |Instructs this repository to apply PlayerRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistScoreUpdated is {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row ScoreUpdated applies to.
        }
      }
      playerId: PlayerId? with {
        briefly "Player id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      score: Natural? with {
        briefly "Score"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ScoreUpdated"
      described as {
        |Instructs this repository to apply ScoreUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServerAssigned is {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServerAssigned applies to.
        }
      }
      server: ServerAssignment? with {
        briefly "Server"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ServerAssigned"
      described as {
        |Instructs this repository to apply ServerAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMatchCreated is {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatchCreated applies to.
        }
      }
      gameMode: GameMode? with {
        briefly "Game mode"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      matchType: MatchType? with {
        briefly "Match type"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      teams: MatchTeam+ with {
        briefly "Teams"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MatchCreated"
      described as {
        |Instructs this repository to apply MatchCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMatchEnded is {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatchEnded applies to.
        }
      }
      result: MatchResult? with {
        briefly "Result"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      endedAt: TimeStamp? with {
        briefly "Ended at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MatchEnded"
      described as {
        |Instructs this repository to apply MatchEnded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMatchStarted is {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatchStarted applies to.
        }
      }
      startedAt: TimeStamp? with {
        briefly "Started at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MatchStarted"
      described as {
        |Instructs this repository to apply MatchStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet MatchRepositoryResponses is result Match.MatchQueryResult
    record StoredMatch is {
      matchId: MatchId with {
        briefly "matchId"
        described as {
          |The matchId column of the stored match row.
        }
      }
      gameMode: GameMode with {
        briefly "gameMode"
        described as {
          |The gameMode column of the stored match row.
        }
      }
      reason: String(1,200)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      playerId: PlayerId? with {
        briefly "Player id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      confirmedAt: TimeStamp? with {
        briefly "Confirmed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      score: Natural? with {
        briefly "Score"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      server: ServerAssignment? with {
        briefly "Server"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      matchType: MatchType? with {
        briefly "Match type"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      teams: MatchTeam+ with {
        briefly "Teams"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      result: MatchResult? with {
        briefly "Result"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      endedAt: TimeStamp? with {
        briefly "Ended at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      startedAt: TimeStamp? with {
        briefly "Started at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored match row"
      described as {
        |The persistence shape of match data as this repository stores it.
      }
    }
    schema MatchData is relational
      of matches as record StoredMatch
        key on field StoredMatch.matchId
        index on field StoredMatch.gameMode
 with {
      briefly "Match data schema"
      described as {
        |The relational schema holding match data for the MatchRepository.
      }
    }
    handler MatchPersistence is {
      on persistMatchCancelled: command PersistMatchCancelled is {
        update MatchData.matches set reason = persistMatchCancelled.reason, cancelledAt = persistMatchCancelled.cancelledAt where matchId == persistMatchCancelled.matchId
      }
      on persistPlayerConfirmed: command PersistPlayerConfirmed is {
        update MatchData.matches set playerId = persistPlayerConfirmed.playerId, confirmedAt = persistPlayerConfirmed.confirmedAt where matchId == persistPlayerConfirmed.matchId
      }
      on persistPlayerRemoved: command PersistPlayerRemoved is {
        update MatchData.matches set playerId = persistPlayerRemoved.playerId, reason = persistPlayerRemoved.reason, removedAt = persistPlayerRemoved.removedAt where matchId == persistPlayerRemoved.matchId
      }
      on persistScoreUpdated: command PersistScoreUpdated is {
        update MatchData.matches set playerId = persistScoreUpdated.playerId, score = persistScoreUpdated.score, updatedAt = persistScoreUpdated.updatedAt where matchId == persistScoreUpdated.matchId
      }
      on persistServerAssigned: command PersistServerAssigned is {
        update MatchData.matches set server = persistServerAssigned.server, assignedAt = persistServerAssigned.assignedAt where matchId == persistServerAssigned.matchId
      }
      on persistMatchCreated: command PersistMatchCreated is {
        update MatchData.matches set gameMode = persistMatchCreated.gameMode, matchType = persistMatchCreated.matchType, teams = persistMatchCreated.teams, createdAt = persistMatchCreated.createdAt where matchId == persistMatchCreated.matchId
      }
      on persistMatchEnded: command PersistMatchEnded is {
        update MatchData.matches set result = persistMatchEnded.result, endedAt = persistMatchEnded.endedAt where matchId == persistMatchEnded.matchId
      }
      on persistMatchStarted: command PersistMatchStarted is {
        update MatchData.matches set startedAt = persistMatchStarted.startedAt where matchId == persistMatchStarted.matchId
      }
      on query GetMatchStats is {
        let matchStatsView: type MatchStatsView = prompt("read the match stats projection")
        reply matchStatsView
      }
    } with {
      briefly "Persists match commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Match data persistence"
    described as {
      | The MatchRepository provides persistent storage for
      | matches and matchmaking data.
    }
  }
  // Projector for matchmaking analytics
  query GetMatchStats replies result MatchStatsView is {
    matchStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which match stats to retrieve.
      }
    }
  } with {
    briefly "Get match stats"
    described as {
      |Retrieves the match stats projection.
    }
  }
  result MatchStatsView is {
    matchStats: MatchAnalytics.MatchStats with {
      briefly "Match stats"
      described as {
        |The match stats being returned.
      }
    }
  } with {
    briefly "Match stats view"
    described as {
      |Read model view carrying the match stats projection.
    }
  }
  projector MatchAnalytics as flow is {
    updates repository MatchContext.MatchRepository
    outlet MatchAnalyticsToRepository is type MatchRepositoryCommand
    inlet MatchAnalyticsFromMatch is type MatchEvent    record MatchStats is {
      gameMode: GameMode with {
        briefly "Mode"
        described as {
          |Game mode.
        }
      }
      totalMatches: Natural with {
        briefly "Matches"
        described as {
          |Total matches.
        }
      }
      averageQueueTime: Duration with {
        briefly "Queue time"
        described as {
          |Avg queue time.
        }
      }
      averageMatchDuration: Duration with {
        briefly "Duration"
        described as {
          |Avg match duration.
        }
      }
      completionRate: Decimal(5,4) with {
        briefly "Completion"
        described as {
          |Completion rate.
        }
      }
      activePlayers: Natural with {
        briefly "Players"
        described as {
          |Active players.
        }
      }
    } with {
      briefly "Match statistics"
      described as {
        |Matchmaking metrics.
      }
    }
    handler AnalyticsHandler is {
      on matchCancelled: event Match.MatchCancelled is {
        tell command MatchContext.MatchRepository.PersistMatchCancelled(matchId = matchCancelled.matchId, reason = matchCancelled.reason, cancelledAt = matchCancelled.cancelledAt) to repository MatchContext.MatchRepository
        do "apply MatchCancelled to the MatchAnalytics projection"
      }
      on playerConfirmed: event Match.PlayerConfirmed is {
        tell command MatchContext.MatchRepository.PersistPlayerConfirmed(matchId = playerConfirmed.matchId, playerId = playerConfirmed.playerId, confirmedAt = playerConfirmed.confirmedAt) to repository MatchContext.MatchRepository
        do "apply PlayerConfirmed to the MatchAnalytics projection"
      }
      on playerRemoved: event Match.PlayerRemoved is {
        tell command MatchContext.MatchRepository.PersistPlayerRemoved(matchId = playerRemoved.matchId, playerId = playerRemoved.playerId, reason = playerRemoved.reason, removedAt = playerRemoved.removedAt) to repository MatchContext.MatchRepository
        do "apply PlayerRemoved to the MatchAnalytics projection"
      }
      on scoreUpdated: event Match.ScoreUpdated is {
        tell command MatchContext.MatchRepository.PersistScoreUpdated(matchId = scoreUpdated.matchId, playerId = scoreUpdated.playerId, score = scoreUpdated.score, updatedAt = scoreUpdated.updatedAt) to repository MatchContext.MatchRepository
        do "apply ScoreUpdated to the MatchAnalytics projection"
      }
      on serverAssigned: event Match.ServerAssigned is {
        tell command MatchContext.MatchRepository.PersistServerAssigned(matchId = serverAssigned.matchId, server = serverAssigned.server, assignedAt = serverAssigned.assignedAt) to repository MatchContext.MatchRepository
        do "apply ServerAssigned to the MatchAnalytics projection"
      }
      on matchCreated: event Match.MatchCreated is {
        tell command MatchContext.MatchRepository.PersistMatchCreated(matchId = matchCreated.matchId, gameMode = matchCreated.gameMode, matchType = matchCreated.matchType, teams = matchCreated.teams, createdAt = matchCreated.createdAt) to repository MatchContext.MatchRepository
      }
      on matchStarted: event Match.MatchStarted is {
        tell command MatchContext.MatchRepository.PersistMatchStarted(matchId = matchStarted.matchId, startedAt = matchStarted.startedAt) to repository MatchContext.MatchRepository
      }
      on matchEnded: event Match.MatchEnded is {
        tell command MatchContext.MatchRepository.PersistMatchEnded(matchId = matchEnded.matchId, result = matchEnded.result, endedAt = matchEnded.endedAt) to repository MatchContext.MatchRepository
      }
    } with {
      briefly "Maintains match analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Match analytics projections"
    described as {
      |Maintains matchmaking analytics data.
    }
  }
  streamlet MatchEventSplit as split is {
    outlet MatchEventSplitToToServerAllocationService is type MatchEvent
    outlet MatchEventSplitToToRatingService is type MatchEvent
    outlet MatchEventSplitToToQueueService is type MatchEvent
    outlet MatchEventSplitToToNotificationService is type MatchEvent
    outlet MatchEventSplitToToAntiCheatService is type MatchEvent
    inlet MatchEventSplitIn is type MatchEvent    outlet MatchEventSplitToMatchAnalytics is type MatchEvent
    handler MatchEventSplitHandler is {
      on matchCreated: event Match.MatchCreated is {
        send matchCreated to outlet MatchEventSplitToMatchAnalytics
        send matchCreated to outlet MatchEventSplitToToServerAllocationService
        send matchCreated to outlet MatchEventSplitToToQueueService
        send matchCreated to outlet MatchEventSplitToToNotificationService
        tell matchCreated to entity MatchContext.Match
      }
      on serverAssigned: event Match.ServerAssigned is {
        send serverAssigned to outlet MatchEventSplitToMatchAnalytics
        send serverAssigned to outlet MatchEventSplitToToNotificationService
        tell serverAssigned to entity MatchContext.Match
      }
      on playerConfirmed: event Match.PlayerConfirmed is {
        send playerConfirmed to outlet MatchEventSplitToMatchAnalytics
        send playerConfirmed to outlet MatchEventSplitToToAntiCheatService
        tell playerConfirmed to entity MatchContext.Match
      }
      on matchStarted: event Match.MatchStarted is {
        send matchStarted to outlet MatchEventSplitToMatchAnalytics
        send matchStarted to outlet MatchEventSplitToToNotificationService
        tell matchStarted to entity MatchContext.Match
      }
      on scoreUpdated: event Match.ScoreUpdated is {
        send scoreUpdated to outlet MatchEventSplitToMatchAnalytics
        tell scoreUpdated to entity MatchContext.Match
      }
      on matchEnded: event Match.MatchEnded is {
        send matchEnded to outlet MatchEventSplitToMatchAnalytics
        send matchEnded to outlet MatchEventSplitToToRatingService
        tell matchEnded to entity MatchContext.Match
      }
      on matchCancelled: event Match.MatchCancelled is {
        send matchCancelled to outlet MatchEventSplitToMatchAnalytics
        send matchCancelled to outlet MatchEventSplitToToNotificationService
        tell matchCancelled to entity MatchContext.Match
      }
      on playerRemoved: event Match.PlayerRemoved is {
        send playerRemoved to outlet MatchEventSplitToMatchAnalytics
        send playerRemoved to outlet MatchEventSplitToToQueueService
        send playerRemoved to outlet MatchEventSplitToToNotificationService
        tell playerRemoved to entity MatchContext.Match
      }
      on other is {
        error "Unexpected message for processor MatchEventSplit"
      }
    } with {
      briefly "Match event fan-out handler"
      described as {
        |Delivers each Match event to all of its consumers.
      }
    }
  } with {
    briefly "Match event fan-out"
    described as {
      |Fans Match events out to the repository and projectors.
    }
  }
  connector 'ToServerAllocationService Feed' is from outlet MatchContext.MatchEventSplit.MatchEventSplitToToServerAllocationService to inlet MatchContext.ToServerAllocationService.ToServerAllocationServiceIn with {
    briefly "The Match events ToServerAllocationService translates, on their way to it"
  }
  connector 'ToRatingService Feed' is from outlet MatchContext.MatchEventSplit.MatchEventSplitToToRatingService to inlet MatchContext.ToRatingService.ToRatingServiceIn with {
    briefly "The Match events ToRatingService translates, on their way to it"
  }
  connector 'ToQueueService Feed' is from outlet MatchContext.MatchEventSplit.MatchEventSplitToToQueueService to inlet MatchContext.ToQueueService.ToQueueServiceIn with {
    briefly "The Match events ToQueueService translates, on their way to it"
  }
  connector 'ToNotificationService Feed' is from outlet MatchContext.MatchEventSplit.MatchEventSplitToToNotificationService to inlet MatchContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The Match events ToNotificationService translates, on their way to it"
  }
  connector 'ToAntiCheatService Feed' is from outlet MatchContext.MatchEventSplit.MatchEventSplitToToAntiCheatService to inlet MatchContext.ToAntiCheatService.ToAntiCheatServiceIn with {
    briefly "The Match events ToAntiCheatService translates, on their way to it"
  }
  connector 'MatchEvent Stream' is from outlet MatchContext.Match.MatchEvents2 to inlet MatchContext.MatchEventSplit.MatchEventSplitIn with {
    briefly "Match events, fanned out to storage and read models"
  }
  connector 'MatchAnalytics Feed' is from outlet MatchContext.MatchEventSplit.MatchEventSplitToMatchAnalytics to inlet MatchContext.MatchAnalytics.MatchAnalyticsFromMatch with {
    briefly "Match events feeding the MatchAnalytics projection"
  }
  connector 'MatchAnalytics Storage' is from outlet MatchContext.MatchAnalytics.MatchAnalyticsToRepository to inlet MatchContext.MatchRepository.MatchRepositoryFromMatchAnalytics with {
    briefly "MatchAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for matchmaking"
  described as {
    | The MatchContext is the bounded context for player
    | matching, game sessions, and match results.
  }
}
