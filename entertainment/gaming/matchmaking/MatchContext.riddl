// Matchmaking - Match Context
context MatchContext as router is {
  inlet MatchCommandStreamIn is type MatchCommand  outlet MatchCommandStreamOut is type MatchCommand
  inlet MatchQueryResultStreamIn is type Match.MatchQueryResult  outlet MatchQueryResultStreamOut is type Match.MatchQueryResult
  handler MatchContextBoundary is {
    on createMatch: command Match.CreateMatch is {
      send createMatch to outlet MatchContext.MatchCommandStreamOut
    }
    on assignServer: command Match.AssignServer is {
      send assignServer to outlet MatchContext.MatchCommandStreamOut
    }
    on confirmPlayer: command Match.ConfirmPlayer is {
      send confirmPlayer to outlet MatchContext.MatchCommandStreamOut
    }
    on startMatch: command Match.StartMatch is {
      send startMatch to outlet MatchContext.MatchCommandStreamOut
    }
    on updateScore: command Match.UpdateScore is {
      send updateScore to outlet MatchContext.MatchCommandStreamOut
    }
    on endMatch: command Match.EndMatch is {
      send endMatch to outlet MatchContext.MatchCommandStreamOut
    }
    on cancelMatch: command Match.CancelMatch is {
      send cancelMatch to outlet MatchContext.MatchCommandStreamOut
    }
    on removePlayer: command Match.RemovePlayer is {
      send removePlayer to outlet MatchContext.MatchCommandStreamOut
    }
    on matchQueryResult: result Match.MatchQueryResult is {
      send matchQueryResult to outlet MatchContext.MatchQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the MatchContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'MatchCommand Stream Intake' is from outlet MatchContext.MatchCommandStreamOut to inlet MatchContext.Match.MatchCommands  connector 'MatchQueryResult Stream Egress' is from outlet MatchContext.MatchRepository.MatchRepositoryResponses to inlet MatchContext.MatchQueryResultStreamIn  adaptor FromAntiCheatService from context AntiCheatService is { 
    handler FromAntiCheatServiceHandler is {
      on event AntiCheatService.PlayerValidated is {
        do "the model receives player validated"
      }
      on other is {
        error "Unexpected message for adaptor FromAntiCheatService"
      }
    } with {
      briefly "from anti cheat service"
      described as {
        |Carries messages from the external AntiCheatService.
      }
    }
  } with {
    briefly "AntiCheatService integration"
    described as {
      |The model's side of the AntiCheatService conversation.
    }
  }
  adaptor ToAntiCheatService to context AntiCheatService is { 
    handler ToAntiCheatServiceHandler is {
      on command AntiCheatService.ValidatePlayer is {
        do "the model sends validate player"
      }
      on other is {
        error "Unexpected message for adaptor ToAntiCheatService"
      }
    } with {
      briefly "to anti cheat service"
      described as {
        |Carries messages to the external AntiCheatService.
      }
    }
  } with {
    briefly "AntiCheatService integration"
    described as {
      |The model's side of the AntiCheatService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendMatchNotification is {
        do "the model sends send match notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromQueueService from context QueueService is { 
    handler FromQueueServiceHandler is {
      on event QueueService.PlayerQueued is {
        do "the model receives player queued"
      }
      on other is {
        error "Unexpected message for adaptor FromQueueService"
      }
    } with {
      briefly "from queue service"
      described as {
        |Carries messages from the external QueueService.
      }
    }
  } with {
    briefly "QueueService integration"
    described as {
      |The model's side of the QueueService conversation.
    }
  }
  adaptor ToQueueService to context QueueService is { 
    handler ToQueueServiceHandler is {
      on command QueueService.AddToQueue is {
        do "the model sends add to queue"
      }
      on command QueueService.RemoveFromQueue is {
        do "the model sends remove from queue"
      }
      on other is {
        error "Unexpected message for adaptor ToQueueService"
      }
    } with {
      briefly "to queue service"
      described as {
        |Carries messages to the external QueueService.
      }
    }
  } with {
    briefly "QueueService integration"
    described as {
      |The model's side of the QueueService conversation.
    }
  }
  adaptor FromRatingService from context RatingService is { 
    handler FromRatingServiceHandler is {
      on event RatingService.RatingUpdated is {
        do "the model receives rating updated"
      }
      on other is {
        error "Unexpected message for adaptor FromRatingService"
      }
    } with {
      briefly "from rating service"
      described as {
        |Carries messages from the external RatingService.
      }
    }
  } with {
    briefly "RatingService integration"
    described as {
      |The model's side of the RatingService conversation.
    }
  }
  adaptor ToRatingService to context RatingService is { 
    handler ToRatingServiceHandler is {
      on command RatingService.UpdateRating is {
        do "the model sends update rating"
      }
      on other is {
        error "Unexpected message for adaptor ToRatingService"
      }
    } with {
      briefly "to rating service"
      described as {
        |Carries messages to the external RatingService.
      }
    }
  } with {
    briefly "RatingService integration"
    described as {
      |The model's side of the RatingService conversation.
    }
  }
  adaptor FromServerAllocationService from context ServerAllocationService is { 
    handler FromServerAllocationServiceHandler is {
      on event ServerAllocationService.ServerAllocated is {
        do "the model receives server allocated"
      }
      on other is {
        error "Unexpected message for adaptor FromServerAllocationService"
      }
    } with {
      briefly "from server allocation service"
      described as {
        |Carries messages from the external ServerAllocationService.
      }
    }
  } with {
    briefly "ServerAllocationService integration"
    described as {
      |The model's side of the ServerAllocationService conversation.
    }
  }
  adaptor ToServerAllocationService to context ServerAllocationService is { 
    handler ToServerAllocationServiceHandler is {
      on command ServerAllocationService.RequestServer is {
        do "the model sends request server"
      }
      on other is {
        error "Unexpected message for adaptor ToServerAllocationService"
      }
    } with {
      briefly "to server allocation service"
      described as {
        |Carries messages to the external ServerAllocationService.
      }
    }
  } with {
    briefly "ServerAllocationService integration"
    described as {
      |The model's side of the ServerAllocationService conversation.
    }
  }
  include "types.riddl"
  include "Match.riddl"
  // Repository for match persistence
  type MatchRepositoryCommand is one of {
    MatchContext.MatchRepository.PersistMatchCancelled or MatchContext.MatchRepository.PersistMatchCreated or MatchContext.MatchRepository.PersistMatchEnded or MatchContext.MatchRepository.PersistMatchStarted or MatchContext.MatchRepository.PersistPlayerConfirmed or MatchContext.MatchRepository.PersistPlayerRemoved or MatchContext.MatchRepository.PersistScoreUpdated or MatchContext.MatchRepository.PersistServerAssigned
  } with {
    briefly "Anything that writes MatchRepository"
    described as {
      |The persistence commands MatchRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository MatchRepository as flow is {
    inlet MatchRepositoryFromMatchAnalytics is type MatchRepositoryCommand
    command PersistMatchCancelled is  {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatchCancelled applies to.
        }
      }
    } with {
      briefly "Persist MatchCancelled"
      described as {
        |Instructs this repository to apply MatchCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayerConfirmed is  {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayerConfirmed applies to.
        }
      }
    } with {
      briefly "Persist PlayerConfirmed"
      described as {
        |Instructs this repository to apply PlayerConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlayerRemoved is  {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlayerRemoved applies to.
        }
      }
    } with {
      briefly "Persist PlayerRemoved"
      described as {
        |Instructs this repository to apply PlayerRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistScoreUpdated is  {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row ScoreUpdated applies to.
        }
      }
    } with {
      briefly "Persist ScoreUpdated"
      described as {
        |Instructs this repository to apply ScoreUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServerAssigned is  {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServerAssigned applies to.
        }
      }
    } with {
      briefly "Persist ServerAssigned"
      described as {
        |Instructs this repository to apply ServerAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMatchCreated is  {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatchCreated applies to.
        }
      }
    } with {
      briefly "Persist MatchCreated"
      described as {
        |Instructs this repository to apply MatchCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMatchEnded is  {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatchEnded applies to.
        }
      }
    } with {
      briefly "Persist MatchEnded"
      described as {
        |Instructs this repository to apply MatchEnded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMatchStarted is  {
      matchId: MatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row MatchStarted applies to.
        }
      }
    } with {
      briefly "Persist MatchStarted"
      described as {
        |Instructs this repository to apply MatchStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet MatchRepositoryResponses is type Match.MatchQueryResult
    record StoredMatch is  {
      matchId: MatchId with {
        briefly "matchId"
        described as {
          |The matchId column of the stored match row.
        }
      }
      gameMode: GameMode with {
        briefly "gameMode"
        described as {
          |The gameMode column of the stored match row.
        }
      }
    } with {
      briefly "Stored match row"
      described as {
        |The persistence shape of match data as this repository stores it.
      }
    }
    schema MatchData is relational
      of matches as type StoredMatch
        index on field StoredMatch.matchId
        index on field StoredMatch.gameMode
 with {
      briefly "Match data schema"
      described as {
        |The relational schema holding match data for the MatchRepository.
      }
    }
    handler MatchPersistence is {
      on persistMatchCancelled: command PersistMatchCancelled is {
        do "apply MatchCancelled to the stored row"
      }
      on persistPlayerConfirmed: command PersistPlayerConfirmed is {
        do "apply PlayerConfirmed to the stored row"
      }
      on persistPlayerRemoved: command PersistPlayerRemoved is {
        do "apply PlayerRemoved to the stored row"
      }
      on persistScoreUpdated: command PersistScoreUpdated is {
        do "apply ScoreUpdated to the stored row"
      }
      on persistServerAssigned: command PersistServerAssigned is {
        do "apply ServerAssigned to the stored row"
      }
      on persistMatchCreated: command PersistMatchCreated is {
        do "apply MatchCreated to the stored row"
      }
      on persistMatchEnded: command PersistMatchEnded is {
        do "apply MatchEnded to the stored row"
      }
      on persistMatchStarted: command PersistMatchStarted is {
        do "apply MatchStarted to the stored row"
      }
      on query GetMatchStats is {
        let matchStatsView: type MatchStatsView = prompt("read the match stats projection")
        reply matchStatsView
      }
    } with {
      briefly "Persists match commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Match data persistence"
    described as {
      | The MatchRepository provides persistent storage for
      | matches and matchmaking data.
    }
  }
  // Projector for matchmaking analytics
  query GetMatchStats replies result MatchStatsView is  {
    matchStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which match stats to retrieve.
      }
    }
  } with {
    briefly "Get match stats"
    described as {
      |Retrieves the match stats projection.
    }
  }
  result MatchStatsView is  {
    matchStats: MatchAnalytics.MatchStats with {
      briefly "Match stats"
      described as {
        |The match stats being returned.
      }
    }
  } with {
    briefly "Match stats view"
    described as {
      |Read model view carrying the match stats projection.
    }
  }
  projector MatchAnalytics as flow is {
    outlet MatchAnalyticsToRepository is type MatchRepositoryCommand
    updates repository MatchContext.MatchRepository
    inlet MatchAnalyticsFromMatch is type MatchEvent
    record MatchStats is  {
      gameMode: GameMode with {
        briefly "Mode"
        described as {
          |Game mode.
        }
      }
      totalMatches: Natural with {
        briefly "Matches"
        described as {
          |Total matches.
        }
      }
      averageQueueTime: Duration with {
        briefly "Queue time"
        described as {
          |Avg queue time.
        }
      }
      averageMatchDuration: Duration with {
        briefly "Duration"
        described as {
          |Avg match duration.
        }
      }
      completionRate: Decimal(5,4) with {
        briefly "Completion"
        described as {
          |Completion rate.
        }
      }
      activePlayers: Natural with {
        briefly "Players"
        described as {
          |Active players.
        }
      }
    } with {
      briefly "Match statistics"
      described as {
        |Matchmaking metrics.
      }
    }
    handler AnalyticsHandler is {
      on matchCancelled: event Match.MatchCancelled is {
        tell command MatchContext.MatchRepository.PersistMatchCancelled(matchId = matchCancelled.matchId) to repository MatchContext.MatchRepository
        do "apply MatchCancelled to the MatchAnalytics projection"
      }
      on playerConfirmed: event Match.PlayerConfirmed is {
        tell command MatchContext.MatchRepository.PersistPlayerConfirmed(matchId = playerConfirmed.matchId) to repository MatchContext.MatchRepository
        do "apply PlayerConfirmed to the MatchAnalytics projection"
      }
      on playerRemoved: event Match.PlayerRemoved is {
        tell command MatchContext.MatchRepository.PersistPlayerRemoved(matchId = playerRemoved.matchId) to repository MatchContext.MatchRepository
        do "apply PlayerRemoved to the MatchAnalytics projection"
      }
      on scoreUpdated: event Match.ScoreUpdated is {
        tell command MatchContext.MatchRepository.PersistScoreUpdated(matchId = scoreUpdated.matchId) to repository MatchContext.MatchRepository
        do "apply ScoreUpdated to the MatchAnalytics projection"
      }
      on serverAssigned: event Match.ServerAssigned is {
        tell command MatchContext.MatchRepository.PersistServerAssigned(matchId = serverAssigned.matchId) to repository MatchContext.MatchRepository
        do "apply ServerAssigned to the MatchAnalytics projection"
      }
      on matchCreated: event Match.MatchCreated is {
        tell command MatchContext.MatchRepository.PersistMatchCreated(matchId = matchCreated.matchId) to repository MatchContext.MatchRepository
      }
      on matchStarted: event Match.MatchStarted is {
        tell command MatchContext.MatchRepository.PersistMatchStarted(matchId = matchStarted.matchId) to repository MatchContext.MatchRepository
      }
      on matchEnded: event Match.MatchEnded is {
        tell command MatchContext.MatchRepository.PersistMatchEnded(matchId = matchEnded.matchId) to repository MatchContext.MatchRepository
      }
    } with {
      briefly "Maintains match analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Match analytics projections"
    described as {
      |Maintains matchmaking analytics data.
    }
  }
  processor MatchEventSplit as flow is {
    inlet MatchEventSplitIn is type MatchEvent
    outlet MatchEventSplitToMatchAnalytics is type MatchEvent
    handler MatchEventSplitHandler is {
      on matchCreated: event Match.MatchCreated is {
        send matchCreated to outlet MatchEventSplitToMatchAnalytics
        tell matchCreated to entity MatchContext.Match
      }
      on serverAssigned: event Match.ServerAssigned is {
        send serverAssigned to outlet MatchEventSplitToMatchAnalytics
        tell serverAssigned to entity MatchContext.Match
      }
      on playerConfirmed: event Match.PlayerConfirmed is {
        send playerConfirmed to outlet MatchEventSplitToMatchAnalytics
        tell playerConfirmed to entity MatchContext.Match
      }
      on matchStarted: event Match.MatchStarted is {
        send matchStarted to outlet MatchEventSplitToMatchAnalytics
        tell matchStarted to entity MatchContext.Match
      }
      on scoreUpdated: event Match.ScoreUpdated is {
        send scoreUpdated to outlet MatchEventSplitToMatchAnalytics
        tell scoreUpdated to entity MatchContext.Match
      }
      on matchEnded: event Match.MatchEnded is {
        send matchEnded to outlet MatchEventSplitToMatchAnalytics
        tell matchEnded to entity MatchContext.Match
      }
      on matchCancelled: event Match.MatchCancelled is {
        send matchCancelled to outlet MatchEventSplitToMatchAnalytics
        tell matchCancelled to entity MatchContext.Match
      }
      on playerRemoved: event Match.PlayerRemoved is {
        send playerRemoved to outlet MatchEventSplitToMatchAnalytics
        tell playerRemoved to entity MatchContext.Match
      }
      on other is {
        error "Unexpected message for processor MatchEventSplit"
      }
    } with {
      briefly "Match event fan-out handler"
      described as {
        |Delivers each Match event to all of its consumers.
      }
    }
  } with {
    briefly "Match event fan-out"
    described as {
      |Fans Match events out to the repository and projectors.
    }
  }
  connector 'MatchEvent Stream' is from outlet MatchContext.Match.MatchEvents2 to inlet MatchContext.MatchEventSplit.MatchEventSplitIn with {
    briefly "Match events, fanned out to storage and read models"
  }
  connector 'MatchAnalytics Feed' is from outlet MatchContext.MatchEventSplit.MatchEventSplitToMatchAnalytics to inlet MatchContext.MatchAnalytics.MatchAnalyticsFromMatch with {
    briefly "Match events feeding the MatchAnalytics projection"
  }
  connector 'MatchAnalytics Storage' is from outlet MatchContext.MatchAnalytics.MatchAnalyticsToRepository to inlet MatchContext.MatchRepository.MatchRepositoryFromMatchAnalytics with {
    briefly "MatchAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for matchmaking"
  described as {
    | The MatchContext is the bounded context for player
    | matching, game sessions, and match results.
  }
}
