// Matchmaking - Match Entity
entity Match as flow is {
  type MatchCommand is one of {
    Match.CreateMatch or Match.AssignServer or Match.ConfirmPlayer or Match.StartMatch or Match.UpdateScore or Match.EndMatch or Match.CancelMatch or Match.RemovePlayer
  } with {
    briefly "Match command alternation"
    described as {
      |Commands accepted by the Match entity.
    }
  }
  inlet MatchCommands is type MatchCommand  outlet MatchEvents2 is type MatchEvent
  // Commands
  command CreateMatch is  {
    matchId: MatchId with {
      briefly "Match ID"
      described as {
        |New match identifier.
      }
    }
    gameMode: GameMode with {
      briefly "Mode"
      described as {
        |Game mode.
      }
    }
    matchType: MatchType with {
      briefly "Type"
      described as {
        |Match type.
      }
    }
    teams: MatchTeam+ with {
      briefly "Teams"
      described as {
        |Match teams.
      }
    }
  } with {
    briefly "Create match"
    described as {
      |Creates a new match.
    }
  }
  command AssignServer is  {
    matchId: MatchId with {
      briefly "Match ID"
      described as {
        |Match identifier.
      }
    }
    server: ServerAssignment with {
      briefly "Server"
      described as {
        |Assigned server.
      }
    }
  } with {
    briefly "Assign server"
    described as {
      |Assigns game server to match.
    }
  }
  command ConfirmPlayer is  {
    matchId: MatchId with {
      briefly "Match ID"
      described as {
        |Match identifier.
      }
    }
    playerId: PlayerId with {
      briefly "Player"
      described as {
        |Confirming player.
      }
    }
  } with {
    briefly "Confirm player"
    described as {
      |Records player ready confirmation.
    }
  }
  command StartMatch is  {
    matchId: MatchId with {
      briefly "Match ID"
      described as {
        |Match to start.
      }
    }
  } with {
    briefly "Start match"
    described as {
      |Starts the match.
    }
  }
  command UpdateScore is  {
    matchId: MatchId with {
      briefly "Match ID"
      described as {
        |Match identifier.
      }
    }
    playerId: PlayerId with {
      briefly "Player"
      described as {
        |Scoring player.
      }
    }
    score: Natural with {
      briefly "Score"
      described as {
        |New score.
      }
    }
  } with {
    briefly "Update score"
    described as {
      |Updates player score.
    }
  }
  command EndMatch is  {
    matchId: MatchId with {
      briefly "Match ID"
      described as {
        |Match to end.
      }
    }
    result: MatchResult with {
      briefly "Result"
      described as {
        |Match result.
      }
    }
  } with {
    briefly "End match"
    described as {
      |Ends the match.
    }
  }
  command CancelMatch is  {
    matchId: MatchId with {
      briefly "Match ID"
      described as {
        |Match to cancel.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
  } with {
    briefly "Cancel match"
    described as {
      |Cancels the match.
    }
  }
  command RemovePlayer is  {
    matchId: MatchId with {
      briefly "Match ID"
      described as {
        |Match identifier.
      }
    }
    playerId: PlayerId with {
      briefly "Player"
      described as {
        |Player to remove.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Removal reason.
      }
    }
  } with {
    briefly "Remove player"
    described as {
      |Removes player from match.
    }
  }
  // Events
  event MatchCreated is  {
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    gameMode: GameMode with {
      briefly "Mode"
      described as {
        |Game mode.
      }
    }
    matchType: MatchType with {
      briefly "Type"
      described as {
        |Match type.
      }
    }
    teams: MatchTeam+ with {
      briefly "Teams"
      described as {
        |Match teams.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Match was created"
    described as {
      |Emitted when match is formed.
    }
  }
  event ServerAssigned is  {
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    server: ServerAssignment with {
      briefly "Server"
      described as {
        |Assigned server.
      }
    }
    assignedAt: TimeStamp with {
      briefly "Assigned"
      described as {
        |Assignment time.
      }
    }
  } with {
    briefly "Server was assigned"
    described as {
      |Emitted when server is allocated.
    }
  }
  event PlayerConfirmed is  {
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    playerId: PlayerId with {
      briefly "Player"
      described as {
        |Confirmed player.
      }
    }
    confirmedAt: TimeStamp with {
      briefly "Confirmed"
      described as {
        |Confirmation time.
      }
    }
  } with {
    briefly "Player was confirmed"
    described as {
      |Emitted when player confirms ready.
    }
  }
  event MatchStarted is  {
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
  } with {
    briefly "Match was started"
    described as {
      |Emitted when match begins.
    }
  }
  event ScoreUpdated is  {
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    playerId: PlayerId with {
      briefly "Player"
      described as {
        |Player ID.
      }
    }
    score: Natural with {
      briefly "Score"
      described as {
        |New score.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Score was updated"
    described as {
      |Emitted when score changes.
    }
  }
  event MatchEnded is  {
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    result: MatchResult with {
      briefly "Result"
      described as {
        |Match result.
      }
    }
    endedAt: TimeStamp with {
      briefly "Ended"
      described as {
        |End time.
      }
    }
  } with {
    briefly "Match was ended"
    described as {
      |Emitted when match completes.
    }
  }
  event MatchCancelled is  {
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancellation time.
      }
    }
  } with {
    briefly "Match was cancelled"
    described as {
      |Emitted when match is cancelled.
    }
  }
  event PlayerRemoved is  {
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    playerId: PlayerId with {
      briefly "Player"
      described as {
        |Removed player.
      }
    }
    reason: String(1,200) with {
      briefly "Reason"
      described as {
        |Removal reason.
      }
    }
    removedAt: TimeStamp with {
      briefly "Removed"
      described as {
        |Removal time.
      }
    }
  } with {
    briefly "Player was removed"
    described as {
      |Emitted when player leaves.
    }
  }
  // State Records
  record FormingStateData is  {
    stateValue: MatchStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    gameMode: GameMode with {
      briefly "Mode"
      described as {
        |Game mode.
      }
    }
    matchType: MatchType with {
      briefly "Type"
      described as {
        |Match type.
      }
    }
    teams: MatchTeam+ with {
      briefly "Teams"
      described as {
        |Match teams.
      }
    }
    confirmedPlayers: PlayerId+ with {
      briefly "Confirmed"
      described as {
        |Confirmed players.
      }
    }
    pendingServer: ServerAssignment? with {
      briefly "Server"
      described as {
        |Assigned server.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Forming state data"
    described as {
      |State data for forming match.
    }
  }
  record ActiveStateData is  {
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    gameMode: GameMode with {
      briefly "Mode"
      described as {
        |Game mode.
      }
    }
    matchType: MatchType with {
      briefly "Type"
      described as {
        |Match type.
      }
    }
    teams: MatchTeam+ with {
      briefly "Teams"
      described as {
        |Match teams.
      }
    }
    server: ServerAssignment with {
      briefly "Server"
      described as {
        |Game server.
      }
    }
    scores: PlayerStats+ with {
      briefly "Scores"
      described as {
        |Player scores.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
  } with {
    briefly "Active state data"
    described as {
      |State data for active match.
    }
  }
  record CompletedStateData is  {
    stateValue: MatchStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    matchId: MatchId with {
      briefly "Match"
      described as {
        |Match ID.
      }
    }
    gameMode: GameMode with {
      briefly "Mode"
      described as {
        |Game mode.
      }
    }
    matchType: MatchType with {
      briefly "Type"
      described as {
        |Match type.
      }
    }
    result: MatchResult with {
      briefly "Result"
      described as {
        |Match result.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
    endedAt: TimeStamp with {
      briefly "Ended"
      described as {
        |End time.
      }
    }
  } with {
    briefly "Completed state data"
    described as {
      |State data for completed match.
    }
  }
  // Query/Result
  query GetMatch replies result MatchQueryResult is {
    matchId: MatchId with {
      briefly "Match ID"
      described as {
        |Match to retrieve.
      }
    }
  } with {
    briefly "Get match"
    described as {
      |Retrieves match data by identifier.
    }
  }
  result MatchQueryResult is  {
    matchId: MatchId with {
      briefly "Match ID"
      described as {
        |Match identifier.
      }
    }
    gameMode: GameMode with {
      briefly "Mode"
      described as {
        |Game mode.
      }
    }
    matchType: MatchType with {
      briefly "Type"
      described as {
        |Match type.
      }
    }
  } with {
    briefly "Match result"
    described as {
      |Match data result.
    }
  }
  // States
  initial state FormingState of record Match.FormingStateData is {
    initial handler FormingStateInitHandler is {
      on init is {
        set state FormingState to "initialize from MatchCreated event"
        set field FormingStateData.stateValue to "Forming"
      }
    } with {
      briefly "Forming state init handler"
      described as {
        |Initializes the Forming state.
      }
    }
  } with {
    briefly "Forming state"
    described as {
      |Match is being formed with players.
    }
  }
  state ActiveState of record Match.ActiveStateData is {
    initial handler ActiveStateInitHandler is {
      on init is {
        set state ActiveState to "initialize from MatchStarted event"
      }
    } with {
      briefly "Active state init handler"
      described as {
        |Initializes the Active state.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |Match is in progress.
    }
  }
  state CompletedState of record Match.CompletedStateData is {
    initial handler CompletedStateInitHandler is {
      on init is {
        set state CompletedState to "initialize from MatchEnded event"
        set field CompletedStateData.stateValue to "Completed"
      }
    } with {
      briefly "Completed state init handler"
      described as {
        |Initializes the Completed state.
      }
    }
  } with {
    briefly "Completed state"
    described as {
      |Match has ended.
    }
  }
  // Handler
  handler MatchHandler is {
    on createMatch: command CreateMatch is {
      morph entity MatchContext.Match to state MatchContext.Match.FormingState with record Match.FormingStateData(matchId = createMatch.matchId, gameMode = createMatch.gameMode, matchType = createMatch.matchType, teams = createMatch.teams)
      tell event MatchCreated(matchId = createMatch.matchId, gameMode = createMatch.gameMode, matchType = createMatch.matchType, teams = createMatch.teams) to entity MatchContext.Match
    }
    on assignServer: command AssignServer is {
      tell event ServerAssigned(matchId = assignServer.matchId, server = assignServer.server) to entity MatchContext.Match
    }
    on confirmPlayer: command ConfirmPlayer is {
      tell event PlayerConfirmed(matchId = confirmPlayer.matchId, playerId = confirmPlayer.playerId) to entity MatchContext.Match
    }
    on startMatch: command StartMatch is {
      morph entity MatchContext.Match to state MatchContext.Match.ActiveState with record Match.ActiveStateData(matchId = startMatch.matchId)
      tell event MatchStarted(matchId = startMatch.matchId) to entity MatchContext.Match
    }
    on updateScore: command UpdateScore is {
      tell event ScoreUpdated(matchId = updateScore.matchId, playerId = updateScore.playerId, score = updateScore.score) to entity MatchContext.Match
    }
    on endMatch: command EndMatch is {
      morph entity MatchContext.Match to state MatchContext.Match.CompletedState with record Match.CompletedStateData(matchId = endMatch.matchId, result = endMatch.result)
      tell event MatchEnded(matchId = endMatch.matchId, result = endMatch.result) to entity MatchContext.Match
    }
    on cancelMatch: command CancelMatch is {
      tell event MatchCancelled(matchId = cancelMatch.matchId, reason = cancelMatch.reason) to entity MatchContext.Match
    }
    on removePlayer: command RemovePlayer is {
      tell event PlayerRemoved(matchId = removePlayer.matchId, playerId = removePlayer.playerId, reason = removePlayer.reason) to entity MatchContext.Match
    }
    on getMatch: query GetMatch is {
      reply result MatchQueryResult(matchId = getMatch.matchId)
    }
  } with {
    briefly "Processes match commands"
    described as {
      | Handles match lifecycle including formation,
      | gameplay, and completion.
    }
  }
} with {
  briefly "Match aggregate"
  described as {
    | The Match entity manages game matches including
    | team formation, server assignment, and results.
  }
}
