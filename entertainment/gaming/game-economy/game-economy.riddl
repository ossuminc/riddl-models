// Game Economy Domain Model
// In-game currencies, items, trading, and monetization
domain GameEconomy is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Player is "person with in-game wallet and inventory" with {
    briefly "Player"
    described as {
      |Gaming platform user.
    }
  }
  user EconomyManager is "person managing game economy" with {
    briefly "Economy Manager"
    described as {
      |Person balancing game economy.
    }
  }
  epic TradingEpic is {
    user Player wants to "to trade items with other players" so that "they can obtain desired items"
    case ExecuteTrade is {
      user Player wants to "to complete a trade with another player" so that "items are exchanged safely"
      step is "Player initiates" "trade offer" "with items and currency" with {
        briefly "Initiate trade"
        described as {
          |Create trade offer.
        }
      }
      step is "System verifies" "item ownership" "and currency balance" with {
        briefly "Verify assets"
        described as {
          |Check ownership.
        }
      }
      step take input GameEconomyApp.GameEconomyScreen.TransferCurrencyInput from user Player with {
        briefly "Transfer funds"
        described as {
          |Move currency.
        }
      }
      step is "System exchanges" "items between" "player inventories" with {
        briefly "Exchange items"
        described as {
          |Swap items.
        }
      }
    } with {
      briefly "Trading workflow"
      described as {
        |Standard flow for player trades.
      }
    }
  } with {
    briefly "Trading processing"
    described as {
      | Epic covering player-to-player trading
      | from offer through completion.
    }
  }
  include "WalletContext.riddl"
  include "external-contexts.riddl"
  application context GameEconomyApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in GameEconomy are delivered.
      }
    }
    group GameEconomyScreen is {
      input TransferCurrencyInput acquires command WalletContext.Wallet.TransferCurrency with {
        briefly "Transfer currency control"
        described as {
          |The control through which a user submits the transfer currency request.
        }
      }
    } with {
      briefly "Game economy screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppWalletCommands is type WalletContext.Wallet.WalletCommand
    inlet AppWalletRepositoryResponses is type WalletContext.Wallet.WalletResult    handler GameEconomyAppHandler is {
      on other is {
        error "Unexpected message for application context GameEconomyApp"
      }
    } with {
      briefly "GameEconomyApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "GameEconomyApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'WalletCommand Stream' is from outlet GameEconomyApp.AppWalletCommands to inlet WalletContext.WalletCommandStreamIn with {
    briefly "Wallet commands from the application"
  }
  persistent connector 'WalletResult Stream' is from outlet WalletContext.WalletResultStreamOut to inlet GameEconomyApp.AppWalletRepositoryResponses with {
    briefly "Wallet query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet GameEconomyApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term CurrencyBalance is  "The virtual currency balance a player holds for item purchases." 
  briefly "Game economy domain"
  described as {
    | The GameEconomy domain handles in-game currencies,
    | virtual items, trading, and monetization.
  }
}
