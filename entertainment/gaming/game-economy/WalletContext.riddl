// Game Economy - Wallet Context
context WalletContext is {
  adaptor FromFraudDetectionService from context FraudDetectionService is { 
    handler FromFraudDetectionServiceHandler is {
      on event FraudDetectionService.TransactionChecked is {
        do "the model receives transaction checked"
      }
      on other is {
        error "Unexpected message for adaptor FromFraudDetectionService"
      }
    } with {
      briefly "from fraud detection service"
      described as {
        |Carries messages from the external FraudDetectionService.
      }
    }
  } with {
    briefly "FraudDetectionService integration"
    described as {
      |The model's side of the FraudDetectionService conversation.
    }
  }
  adaptor ToFraudDetectionService to context FraudDetectionService is { 
    handler ToFraudDetectionServiceHandler is {
      on command FraudDetectionService.CheckTransaction is {
        do "the model sends check transaction"
      }
      on other is {
        error "Unexpected message for adaptor ToFraudDetectionService"
      }
    } with {
      briefly "to fraud detection service"
      described as {
        |Carries messages to the external FraudDetectionService.
      }
    }
  } with {
    briefly "FraudDetectionService integration"
    described as {
      |The model's side of the FraudDetectionService conversation.
    }
  }
  adaptor FromIAPService from context IAPService is { 
    handler FromIAPServiceHandler is {
      on event IAPService.PurchaseVerified is {
        do "the model receives purchase verified"
      }
      on other is {
        error "Unexpected message for adaptor FromIAPService"
      }
    } with {
      briefly "from iap service"
      described as {
        |Carries messages from the external IAPService.
      }
    }
  } with {
    briefly "IAPService integration"
    described as {
      |The model's side of the IAPService conversation.
    }
  }
  adaptor ToIAPService to context IAPService is { 
    handler ToIAPServiceHandler is {
      on command IAPService.ProcessPurchase is {
        do "the model sends process purchase"
      }
      on other is {
        error "Unexpected message for adaptor ToIAPService"
      }
    } with {
      briefly "to iap service"
      described as {
        |Carries messages to the external IAPService.
      }
    }
  } with {
    briefly "IAPService integration"
    described as {
      |The model's side of the IAPService conversation.
    }
  }
  adaptor FromItemCatalogService from context ItemCatalogService is { 
    handler FromItemCatalogServiceHandler is {
      on result ItemCatalogService.StoreCatalog is {
        do "the model receives store catalog"
      }
      on other is {
        error "Unexpected message for adaptor FromItemCatalogService"
      }
    } with {
      briefly "from item catalog service"
      described as {
        |Carries messages from the external ItemCatalogService.
      }
    }
  } with {
    briefly "ItemCatalogService integration"
    described as {
      |The model's side of the ItemCatalogService conversation.
    }
  }
  adaptor ToItemCatalogService to context ItemCatalogService is { 
    handler ToItemCatalogServiceHandler is {
      on query ItemCatalogService.GetStoreItems is {
        do "the model sends get store items"
      }
      on other is {
        error "Unexpected message for adaptor ToItemCatalogService"
      }
    } with {
      briefly "to item catalog service"
      described as {
        |Carries messages to the external ItemCatalogService.
      }
    }
  } with {
    briefly "ItemCatalogService integration"
    described as {
      |The model's side of the ItemCatalogService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendTransactionNotification is {
        do "the model sends send transaction notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromTradeEscrowService from context TradeEscrowService is { 
    handler FromTradeEscrowServiceHandler is {
      on event TradeEscrowService.EscrowReleased is {
        do "the model receives escrow released"
      }
      on other is {
        error "Unexpected message for adaptor FromTradeEscrowService"
      }
    } with {
      briefly "from trade escrow service"
      described as {
        |Carries messages from the external TradeEscrowService.
      }
    }
  } with {
    briefly "TradeEscrowService integration"
    described as {
      |The model's side of the TradeEscrowService conversation.
    }
  }
  adaptor ToTradeEscrowService to context TradeEscrowService is { 
    handler ToTradeEscrowServiceHandler is {
      on command TradeEscrowService.EscrowItems is {
        do "the model sends escrow items"
      }
      on command TradeEscrowService.ReleaseEscrow is {
        do "the model sends release escrow"
      }
      on other is {
        error "Unexpected message for adaptor ToTradeEscrowService"
      }
    } with {
      briefly "to trade escrow service"
      described as {
        |Carries messages to the external TradeEscrowService.
      }
    }
  } with {
    briefly "TradeEscrowService integration"
    described as {
      |The model's side of the TradeEscrowService conversation.
    }
  }
  include "types.riddl"
  include "Wallet.riddl"
  // Repository for wallet persistence
  repository WalletRepository as merge is {
    inlet WalletRepositoryFromWallet is type WalletEvent    inlet WalletRepositoryFromEconomyAnalytics is type WalletEvent    outlet WalletRepositoryResponses is type Wallet.WalletResult
    record StoredWallet is  {
      walletId: WalletId with {
        briefly "walletId"
        described as {
          |The walletId column of the stored wallet row.
        }
      }
      playerId: PlayerId with {
        briefly "playerId"
        described as {
          |The playerId column of the stored wallet row.
        }
      }
    } with {
      briefly "Stored wallet row"
      described as {
        |The persistence shape of wallet data as this repository stores it.
      }
    }
    schema WalletData is relational
      of wallets as type StoredWallet
        index on field StoredWallet.walletId
        index on field StoredWallet.playerId
 with {
      briefly "Wallet data schema"
      described as {
        |The relational schema holding wallet data for the WalletRepository.
      }
    }
    handler WalletPersistence is {
      on query GetEconomyStats is {
        do "read the economy stats projection"
        reply result EconomyStatsView
      }
      on command Wallet.CreateWallet is {
        tell event Wallet.WalletCreated to entity WalletContext.Wallet
      }
      on command Wallet.AddCurrency is {
        tell event Wallet.CurrencyAdded to entity WalletContext.Wallet
      }
      on command Wallet.SpendCurrency is {
        tell event Wallet.CurrencySpent to entity WalletContext.Wallet
      }
      on command Wallet.TransferCurrency is {
        tell event Wallet.CurrencyTransferred to entity WalletContext.Wallet
      }
      on command Wallet.AddItem is {
        tell event Wallet.ItemAdded to entity WalletContext.Wallet
      }
      on command Wallet.RemoveItem is {
        tell event Wallet.ItemRemoved to entity WalletContext.Wallet
      }
      on command Wallet.PurchaseItem is {
        tell event Wallet.ItemPurchased to entity WalletContext.Wallet
      }
      on command Wallet.InitiateTrade is {
        tell event Wallet.TradeInitiated to entity WalletContext.Wallet
      }
      on command Wallet.CompleteTrade is {
        tell event Wallet.TradeCompleted to entity WalletContext.Wallet
      }
    } with {
      briefly "Persists wallet commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Wallet data persistence"
    described as {
      | The WalletRepository provides persistent storage for
      | player wallets, inventories, and transactions.
    }
  }
  // Projector for economy analytics
  query GetEconomyStats is  {
    economyStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which economy stats to retrieve.
      }
    }
  } with {
    briefly "Get economy stats"
    described as {
      |Retrieves the economy stats projection.
    }
  }
  result EconomyStatsView is  {
    economyStats: EconomyAnalytics.EconomyStats with {
      briefly "Economy stats"
      described as {
        |The economy stats being returned.
      }
    }
  } with {
    briefly "Economy stats view"
    described as {
      |Read model view carrying the economy stats projection.
    }
  }
  projector EconomyAnalytics as flow is {
    updates repository WalletContext.WalletRepository
    inlet EconomyAnalyticsFromWallet is type WalletEvent    outlet EconomyAnalyticsOut is type WalletEvent
    record EconomyStats is  {
      currencyType: CurrencyType with {
        briefly "Currency"
        described as {
          |Currency type.
        }
      }
      totalCirculating: Decimal(20,4) with {
        briefly "Circulating"
        described as {
          |Total in circulation.
        }
      }
      dailyEarned: Decimal(15,4) with {
        briefly "Earned"
        described as {
          |Daily earned.
        }
      }
      dailySpent: Decimal(15,4) with {
        briefly "Spent"
        described as {
          |Daily spent.
        }
      }
      activePlayers: Natural with {
        briefly "Players"
        described as {
          |Active players.
        }
      }
      averageBalance: Decimal(15,4) with {
        briefly "Average"
        described as {
          |Average balance.
        }
      }
    } with {
      briefly "Economy statistics"
      described as {
        |Game economy metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Wallet.CurrencyAdded is {
        tell event Wallet.CurrencyAdded to repository WalletContext.WalletRepository
      }
      on event Wallet.CurrencySpent is {
        tell event Wallet.CurrencySpent to repository WalletContext.WalletRepository
      }
      on event Wallet.ItemPurchased is {
        tell event Wallet.ItemPurchased to repository WalletContext.WalletRepository
      }
      on event Wallet.TradeCompleted is {
        tell event Wallet.TradeCompleted to repository WalletContext.WalletRepository
      }
    } with {
      briefly "Maintains economy analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Economy analytics projections"
    described as {
      |Maintains game economy analytics data.
    }
  }
  processor WalletEventSource as source is {
    outlet WalletEvents is type WalletEvent
    handler WalletEventEmitter is {
      on init is {
        tell command InitializeWallet to entity WalletContext.Wallet
      }
      on other is {
        error "Unexpected message for source WalletEventSource"
      }
      on event Wallet.WalletCreated is {
        send event Wallet.WalletCreated to outlet WalletEvents
      }
      on event Wallet.CurrencyAdded is {
        send event Wallet.CurrencyAdded to outlet WalletEvents
      }
      on event Wallet.CurrencySpent is {
        send event Wallet.CurrencySpent to outlet WalletEvents
      }
      on event Wallet.ItemPurchased is {
        send event Wallet.ItemPurchased to outlet WalletEvents
      }
      on event Wallet.TradeCompleted is {
        send event Wallet.TradeCompleted to outlet WalletEvents
      }
    } with {
      briefly "Wallet event emitter"
      described as {
        |Emits wallet lifecycle events into the streaming
        |topology.
      }
    }
  } with {
    briefly "Wallet event source"
    described as {
      |Publishes wallet entity events for streaming.
    }
  }
  processor WalletEventSink as sink is {
    inlet IncomingWalletEvents is type WalletEvent    handler WalletEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink WalletEventSink"
      }
      on event Wallet.WalletCreated is {
        tell event Wallet.WalletCreated to repository WalletContext.WalletRepository
      }
      on event Wallet.TradeCompleted is {
        tell event Wallet.TradeCompleted to repository WalletContext.WalletRepository
      }
    } with {
      briefly "Wallet event receiver"
      described as {
        |Receives wallet events and persists them.
      }
    }
  } with {
    briefly "Wallet event sink"
    described as {
      |Receives wallet events from the streaming topology.
    }
  }
  connector WalletEventPipeline is from outlet WalletContext.WalletEventSource.WalletEvents to inlet WalletContext.WalletEventSink.IncomingWalletEvents with {
    briefly "Wallet event pipeline"
    described as {
      |Wires wallet events from source to sink.
    }
  }
  processor WalletEventSplit as split is {
    inlet WalletEventSplitIn is type WalletEvent    outlet WalletEventSplitToWalletRepository is type WalletEvent
    outlet WalletEventSplitToEconomyAnalytics is type WalletEvent
    handler WalletEventSplitHandler is {
      on event Wallet.WalletCreated is {
        send event Wallet.WalletCreated to outlet WalletEventSplitToWalletRepository
        send event Wallet.WalletCreated to outlet WalletEventSplitToEconomyAnalytics
        tell event Wallet.WalletCreated to entity WalletContext.Wallet
      }
      on event Wallet.CurrencyAdded is {
        send event Wallet.CurrencyAdded to outlet WalletEventSplitToWalletRepository
        send event Wallet.CurrencyAdded to outlet WalletEventSplitToEconomyAnalytics
        tell event Wallet.CurrencyAdded to entity WalletContext.Wallet
      }
      on event Wallet.CurrencySpent is {
        send event Wallet.CurrencySpent to outlet WalletEventSplitToWalletRepository
        send event Wallet.CurrencySpent to outlet WalletEventSplitToEconomyAnalytics
        tell event Wallet.CurrencySpent to entity WalletContext.Wallet
      }
      on event Wallet.CurrencyTransferred is {
        send event Wallet.CurrencyTransferred to outlet WalletEventSplitToWalletRepository
        send event Wallet.CurrencyTransferred to outlet WalletEventSplitToEconomyAnalytics
        tell event Wallet.CurrencyTransferred to entity WalletContext.Wallet
      }
      on event Wallet.ItemAdded is {
        send event Wallet.ItemAdded to outlet WalletEventSplitToWalletRepository
        send event Wallet.ItemAdded to outlet WalletEventSplitToEconomyAnalytics
        tell event Wallet.ItemAdded to entity WalletContext.Wallet
      }
      on event Wallet.ItemRemoved is {
        send event Wallet.ItemRemoved to outlet WalletEventSplitToWalletRepository
        send event Wallet.ItemRemoved to outlet WalletEventSplitToEconomyAnalytics
        tell event Wallet.ItemRemoved to entity WalletContext.Wallet
      }
      on event Wallet.ItemPurchased is {
        send event Wallet.ItemPurchased to outlet WalletEventSplitToWalletRepository
        send event Wallet.ItemPurchased to outlet WalletEventSplitToEconomyAnalytics
        tell event Wallet.ItemPurchased to entity WalletContext.Wallet
      }
      on event Wallet.TradeInitiated is {
        send event Wallet.TradeInitiated to outlet WalletEventSplitToWalletRepository
        send event Wallet.TradeInitiated to outlet WalletEventSplitToEconomyAnalytics
        tell event Wallet.TradeInitiated to entity WalletContext.Wallet
      }
      on event Wallet.TradeCompleted is {
        send event Wallet.TradeCompleted to outlet WalletEventSplitToWalletRepository
        send event Wallet.TradeCompleted to outlet WalletEventSplitToEconomyAnalytics
        tell event Wallet.TradeCompleted to entity WalletContext.Wallet
      }
      on other is {
        error "Unexpected message for processor WalletEventSplit"
      }
    } with {
      briefly "Wallet event fan-out handler"
      described as {
        |Delivers each Wallet event to all of its consumers.
      }
    }
  } with {
    briefly "Wallet event fan-out"
    described as {
      |Fans Wallet events out to the repository and projectors.
    }
  }
  connector 'WalletEvent Stream' is from outlet WalletContext.Wallet.WalletEvents2 to inlet WalletContext.WalletEventSplit.WalletEventSplitIn with {
    briefly "Wallet events, fanned out to storage and read models"
  }
  connector 'WalletEvent Storage' is from outlet WalletContext.WalletEventSplit.WalletEventSplitToWalletRepository to inlet WalletContext.WalletRepository.WalletRepositoryFromWallet with {
    briefly "Wallet events on their way to storage"
  }
  connector 'EconomyAnalytics Feed' is from outlet WalletContext.WalletEventSplit.WalletEventSplitToEconomyAnalytics to inlet WalletContext.EconomyAnalytics.EconomyAnalyticsFromWallet with {
    briefly "Wallet events feeding the EconomyAnalytics projection"
  }
  connector 'EconomyAnalytics Storage' is from outlet WalletContext.EconomyAnalytics.EconomyAnalyticsOut to inlet WalletContext.WalletRepository.WalletRepositoryFromEconomyAnalytics with {
    briefly "The EconomyAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for game economy"
  described as {
    | The WalletContext is the bounded context for player
    | wallets, currencies, items, and transactions.
  }
}
