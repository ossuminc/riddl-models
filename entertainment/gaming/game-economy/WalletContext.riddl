// Game Economy - Wallet Context
context WalletContext as router is {
  inlet WalletContextFromIAPService is command Wallet.AddCurrency with {
    briefly "What FromIAPService makes of that service's news"
  }
  connector 'FromIAPService Intake' is from outlet WalletContext.FromIAPService.FromIAPServiceToWalletContext to inlet WalletContext.WalletContextFromIAPService with {
    briefly "What FromIAPService makes of that news, on its way in"
  }
  inlet WalletContextFromTradeEscrowService is command Wallet.CompleteTrade with {
    briefly "What FromTradeEscrowService makes of that service's news"
  }
  connector 'FromTradeEscrowService Intake' is from outlet WalletContext.FromTradeEscrowService.FromTradeEscrowServiceToWalletContext to inlet WalletContext.WalletContextFromTradeEscrowService with {
    briefly "What FromTradeEscrowService makes of that news, on its way in"
  }
  inlet WalletCommandStreamIn is type WalletCommand  outlet WalletCommandStreamOut is type WalletCommand
  inlet WalletResultStreamIn is result Wallet.WalletResult  outlet WalletResultStreamOut is result Wallet.WalletResult
  handler WalletContextBoundary is {
    on createWallet: command Wallet.CreateWallet is {
      send createWallet to outlet WalletContext.WalletCommandStreamOut
    }
    on addCurrency: command Wallet.AddCurrency is {
      send addCurrency to outlet WalletContext.WalletCommandStreamOut
    }
    on spendCurrency: command Wallet.SpendCurrency is {
      send spendCurrency to outlet WalletContext.WalletCommandStreamOut
    }
    on transferCurrency: command Wallet.TransferCurrency is {
      send transferCurrency to outlet WalletContext.WalletCommandStreamOut
    }
    on addItem: command Wallet.AddItem is {
      send addItem to outlet WalletContext.WalletCommandStreamOut
    }
    on removeItem: command Wallet.RemoveItem is {
      send removeItem to outlet WalletContext.WalletCommandStreamOut
    }
    on purchaseItem: command Wallet.PurchaseItem is {
      send purchaseItem to outlet WalletContext.WalletCommandStreamOut
    }
    on initiateTrade: command Wallet.InitiateTrade is {
      send initiateTrade to outlet WalletContext.WalletCommandStreamOut
    }
    on completeTrade: command Wallet.CompleteTrade is {
      send completeTrade to outlet WalletContext.WalletCommandStreamOut
    }
    on walletResult: result Wallet.WalletResult is {
      send walletResult to outlet WalletContext.WalletResultStreamOut
    }
    on other is {
      error "Unexpected message at the WalletContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'WalletCommand Stream Intake' is from outlet WalletContext.WalletCommandStreamOut to inlet WalletContext.Wallet.WalletCommands  connector 'WalletResult Stream Egress' is from outlet WalletContext.WalletRepository.WalletRepositoryResponses to inlet WalletContext.WalletResultStreamIn  adaptor FromFraudDetectionService from context FraudDetectionService is { 
    inlet FromFraudDetectionServiceIn is event FraudDetectionService.TransactionChecked    handler FromFraudDetectionServiceHandler is {
      on transactionChecked: event FraudDetectionService.TransactionChecked is {
        do "fraud has looked; the wallet acts on the purchase, not on the check"
      }
      on other is {
        error "Unexpected message for adaptor FromFraudDetectionService"
      }
    } with {
      briefly "from fraud detection service"
      described as {
        |Carries messages from the external FraudDetectionService.
      }
    }
  } with {
    briefly "FraudDetectionService integration"
    described as {
      |The model's side of the FraudDetectionService conversation.
    }
  }
  adaptor ToFraudDetectionService to context FraudDetectionService as flow is { 
    outlet ToFraudDetectionServiceOut is command FraudDetectionService.CheckTransaction
    handler ToFraudDetectionServiceHandler is {
      on tradeInitiated: event TradeInitiated is {
        let item0: type FraudDetectionService.CheckTransaction = prompt("translate the tradeInitiated event into a CheckTransaction, a trade being the moment value can be moved illegitimately")
        send item0 to outlet WalletContext.ToFraudDetectionService.ToFraudDetectionServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToFraudDetectionService"
      }
    } with {
      briefly "to fraud detection service"
      described as {
        |Carries messages to the external FraudDetectionService.
      }
    }
  } with {
    briefly "FraudDetectionService integration"
    described as {
      |The model's side of the FraudDetectionService conversation.
    }
  }
  adaptor FromIAPService from context IAPService as flow is { 
    inlet FromIAPServiceIn is event IAPService.PurchaseVerified    outlet FromIAPServiceToWalletContext is command Wallet.AddCurrency
    handler FromIAPServiceHandler is {
      on purchaseVerified: event IAPService.PurchaseVerified is {
        let item0: type Wallet.AddCurrency = prompt("translate the purchaseVerified event into a AddCurrency, a verified real-money purchase is what puts currency in the wallet")
        send item0 to outlet WalletContext.FromIAPService.FromIAPServiceToWalletContext
      }
      on other is {
        error "Unexpected message for adaptor FromIAPService"
      }
    } with {
      briefly "from iap service"
      described as {
        |Carries messages from the external IAPService.
      }
    }
  } with {
    briefly "IAPService integration"
    described as {
      |The model's side of the IAPService conversation.
    }
  }
  adaptor ToIAPService to context IAPService as flow is { 
    outlet ToIAPServiceOut is command IAPService.ProcessPurchase
    handler ToIAPServiceHandler is {
      on itemPurchased: event Wallet.ItemPurchased is {
        let item0: type IAPService.ProcessPurchase = prompt("translate the itemPurchased event into a ProcessPurchase, the purchase being what the store must actually take money for")
        send item0 to outlet WalletContext.ToIAPService.ToIAPServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToIAPService"
      }
    } with {
      briefly "to iap service"
      described as {
        |Carries messages to the external IAPService.
      }
    }
  } with {
    briefly "IAPService integration"
    described as {
      |The model's side of the IAPService conversation.
    }
  }
  adaptor ToItemCatalogService to context ItemCatalogService as flow is { 
    outlet ToItemCatalogServiceOut is query ItemCatalogService.GetStoreItems
    handler ToItemCatalogServiceHandler is {
      on itemPurchased: event Wallet.ItemPurchased is {
        let askAnswer: type ItemCatalogService.StoreCatalog = ask query ItemCatalogService.GetStoreItems of context ItemCatalogService
        do "a purchase needing the catalogue to say what was bought and for how much"
      }
      on other is {
        error "Unexpected message for adaptor ToItemCatalogService"
      }
    } with {
      briefly "to item catalog service"
      described as {
        |Carries messages to the external ItemCatalogService.
      }
    }
  } with {
    briefly "ItemCatalogService integration"
    described as {
      |The model's side of the ItemCatalogService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    outlet ToNotificationServiceOut is command NotificationService.SendTransactionNotification
    handler ToNotificationServiceHandler is {
      on tradeCompleted: event TradeCompleted is {
        let notice: type NotificationService.SendTransactionNotification = prompt("translate the tradeCompleted event into a SendTransactionNotification telling both players the trade went through and what each now holds")
        send notice to outlet WalletContext.ToNotificationService.ToNotificationServiceOut
      }
      on currencyTransferred: event CurrencyTransferred is {
        let notice: type NotificationService.SendTransactionNotification = prompt("translate the currencyTransferred event into a SendTransactionNotification telling the receiving player currency has arrived from another player")
        send notice to outlet WalletContext.ToNotificationService.ToNotificationServiceOut
      }
      on itemPurchased: event ItemPurchased is {
        let notice: type NotificationService.SendTransactionNotification = prompt("translate the itemPurchased event into a SendTransactionNotification telling the player what they bought and what it cost them")
        send notice to outlet WalletContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromTradeEscrowService from context TradeEscrowService as flow is { 
    inlet FromTradeEscrowServiceIn is event TradeEscrowService.EscrowReleased    outlet FromTradeEscrowServiceToWalletContext is command Wallet.CompleteTrade
    handler FromTradeEscrowServiceHandler is {
      on escrowReleased: event TradeEscrowService.EscrowReleased is {
        let item0: type Wallet.CompleteTrade = prompt("translate the escrowReleased event into a CompleteTrade, escrow releasing the items is what completes the trade")
        send item0 to outlet WalletContext.FromTradeEscrowService.FromTradeEscrowServiceToWalletContext
      }
      on other is {
        error "Unexpected message for adaptor FromTradeEscrowService"
      }
    } with {
      briefly "from trade escrow service"
      described as {
        |Carries messages from the external TradeEscrowService.
      }
    }
  } with {
    briefly "TradeEscrowService integration"
    described as {
      |The model's side of the TradeEscrowService conversation.
    }
  }
  adaptor ToTradeEscrowService to context TradeEscrowService as flow is { 
    outlet ToTradeEscrowServiceOut is type TradeEscrowService.TradeEscrowServiceCommand
    handler ToTradeEscrowServiceHandler is {
      on tradeInitiated: event Wallet.TradeInitiated is {
        let item0: type TradeEscrowService.EscrowItems = prompt("translate the tradeInitiated event into a EscrowItems, a trade being what puts items beyond either party's reach")
        send item0 to outlet WalletContext.ToTradeEscrowService.ToTradeEscrowServiceOut
      }
      on tradeCompleted: event Wallet.TradeCompleted is {
        let item0: type TradeEscrowService.ReleaseEscrow = prompt("translate the tradeCompleted event into a ReleaseEscrow, completion being what returns them")
        send item0 to outlet WalletContext.ToTradeEscrowService.ToTradeEscrowServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToTradeEscrowService"
      }
    } with {
      briefly "to trade escrow service"
      described as {
        |Carries messages to the external TradeEscrowService.
      }
    }
  } with {
    briefly "TradeEscrowService integration"
    described as {
      |The model's side of the TradeEscrowService conversation.
    }
  }
  include "types.riddl"
  include "Wallet.riddl"
  // Repository for wallet persistence
  type WalletRepositoryCommand is one of {
    WalletContext.WalletRepository.PersistCurrencyAdded or WalletContext.WalletRepository.PersistCurrencySpent or WalletContext.WalletRepository.PersistCurrencyTransferred or WalletContext.WalletRepository.PersistItemAdded or WalletContext.WalletRepository.PersistItemPurchased or WalletContext.WalletRepository.PersistItemRemoved or WalletContext.WalletRepository.PersistTradeCompleted or WalletContext.WalletRepository.PersistTradeInitiated or WalletContext.WalletRepository.PersistWalletCreated
  } with {
    briefly "Anything that writes WalletRepository"
    described as {
      |The persistence commands WalletRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository WalletRepository as flow is {
    inlet WalletRepositoryFromEconomyAnalytics is type WalletRepositoryCommand    command PersistCurrencyTransferred is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row CurrencyTransferred applies to.
        }
      }
    } with {
      briefly "Persist CurrencyTransferred"
      described as {
        |Instructs this repository to apply CurrencyTransferred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemAdded is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemAdded applies to.
        }
      }
    } with {
      briefly "Persist ItemAdded"
      described as {
        |Instructs this repository to apply ItemAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemRemoved is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemRemoved applies to.
        }
      }
    } with {
      briefly "Persist ItemRemoved"
      described as {
        |Instructs this repository to apply ItemRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTradeInitiated is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row TradeInitiated applies to.
        }
      }
    } with {
      briefly "Persist TradeInitiated"
      described as {
        |Instructs this repository to apply TradeInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWalletCreated is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row WalletCreated applies to.
        }
      }
    } with {
      briefly "Persist WalletCreated"
      described as {
        |Instructs this repository to apply WalletCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCurrencyAdded is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row CurrencyAdded applies to.
        }
      }
    } with {
      briefly "Persist CurrencyAdded"
      described as {
        |Instructs this repository to apply CurrencyAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCurrencySpent is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row CurrencySpent applies to.
        }
      }
    } with {
      briefly "Persist CurrencySpent"
      described as {
        |Instructs this repository to apply CurrencySpent to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemPurchased is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemPurchased applies to.
        }
      }
    } with {
      briefly "Persist ItemPurchased"
      described as {
        |Instructs this repository to apply ItemPurchased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTradeCompleted is {
      walletId: WalletId with {
        briefly "Row addressed"
        described as {
          |Which stored row TradeCompleted applies to.
        }
      }
    } with {
      briefly "Persist TradeCompleted"
      described as {
        |Instructs this repository to apply TradeCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet WalletRepositoryResponses is result Wallet.WalletResult
    record StoredWallet is {
      walletId: WalletId with {
        briefly "walletId"
        described as {
          |The walletId column of the stored wallet row.
        }
      }
      playerId: PlayerId with {
        briefly "playerId"
        described as {
          |The playerId column of the stored wallet row.
        }
      }
    } with {
      briefly "Stored wallet row"
      described as {
        |The persistence shape of wallet data as this repository stores it.
      }
    }
    schema WalletData is relational
      of wallets as record StoredWallet
        index on field StoredWallet.walletId
        index on field StoredWallet.playerId
 with {
      briefly "Wallet data schema"
      described as {
        |The relational schema holding wallet data for the WalletRepository.
      }
    }
    handler WalletPersistence is {
      on persistCurrencyTransferred: command PersistCurrencyTransferred is {
        do "apply CurrencyTransferred to the stored row"
      }
      on persistItemAdded: command PersistItemAdded is {
        do "apply ItemAdded to the stored row"
      }
      on persistItemRemoved: command PersistItemRemoved is {
        do "apply ItemRemoved to the stored row"
      }
      on persistTradeInitiated: command PersistTradeInitiated is {
        do "apply TradeInitiated to the stored row"
      }
      on persistWalletCreated: command PersistWalletCreated is {
        do "apply WalletCreated to the stored row"
      }
      on persistCurrencyAdded: command PersistCurrencyAdded is {
        do "apply CurrencyAdded to the stored row"
      }
      on persistCurrencySpent: command PersistCurrencySpent is {
        do "apply CurrencySpent to the stored row"
      }
      on persistItemPurchased: command PersistItemPurchased is {
        do "apply ItemPurchased to the stored row"
      }
      on persistTradeCompleted: command PersistTradeCompleted is {
        do "apply TradeCompleted to the stored row"
      }
      on query GetEconomyStats is {
        let economyStatsView: type EconomyStatsView = prompt("read the economy stats projection")
        reply economyStatsView
      }
    } with {
      briefly "Persists wallet commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Wallet data persistence"
    described as {
      | The WalletRepository provides persistent storage for
      | player wallets, inventories, and transactions.
    }
  }
  // Projector for economy analytics
  query GetEconomyStats replies result EconomyStatsView is {
    economyStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which economy stats to retrieve.
      }
    }
  } with {
    briefly "Get economy stats"
    described as {
      |Retrieves the economy stats projection.
    }
  }
  result EconomyStatsView is {
    economyStats: EconomyAnalytics.EconomyStats with {
      briefly "Economy stats"
      described as {
        |The economy stats being returned.
      }
    }
  } with {
    briefly "Economy stats view"
    described as {
      |Read model view carrying the economy stats projection.
    }
  }
  projector EconomyAnalytics as flow is {
    updates repository WalletContext.WalletRepository
    outlet EconomyAnalyticsToRepository is type WalletRepositoryCommand
    inlet EconomyAnalyticsFromWallet is type WalletEvent    record EconomyStats is {
      currencyType: CurrencyType with {
        briefly "Currency"
        described as {
          |Currency type.
        }
      }
      totalCirculating: Decimal(20,4) with {
        briefly "Circulating"
        described as {
          |Total in circulation.
        }
      }
      dailyEarned: Decimal(15,4) with {
        briefly "Earned"
        described as {
          |Daily earned.
        }
      }
      dailySpent: Decimal(15,4) with {
        briefly "Spent"
        described as {
          |Daily spent.
        }
      }
      activePlayers: Natural with {
        briefly "Players"
        described as {
          |Active players.
        }
      }
      averageBalance: Decimal(15,4) with {
        briefly "Average"
        described as {
          |Average balance.
        }
      }
    } with {
      briefly "Economy statistics"
      described as {
        |Game economy metrics.
      }
    }
    handler AnalyticsHandler is {
      on currencyTransferred: event Wallet.CurrencyTransferred is {
        tell command WalletContext.WalletRepository.PersistCurrencyTransferred(walletId = currencyTransferred.walletId) to repository WalletContext.WalletRepository
        do "apply CurrencyTransferred to the EconomyAnalytics projection"
      }
      on itemAdded: event Wallet.ItemAdded is {
        tell command WalletContext.WalletRepository.PersistItemAdded(walletId = itemAdded.walletId) to repository WalletContext.WalletRepository
        do "apply ItemAdded to the EconomyAnalytics projection"
      }
      on itemRemoved: event Wallet.ItemRemoved is {
        tell command WalletContext.WalletRepository.PersistItemRemoved(walletId = itemRemoved.walletId) to repository WalletContext.WalletRepository
        do "apply ItemRemoved to the EconomyAnalytics projection"
      }
      on tradeInitiated: event Wallet.TradeInitiated is {
        tell command WalletContext.WalletRepository.PersistTradeInitiated(walletId = tradeInitiated.walletId) to repository WalletContext.WalletRepository
        do "apply TradeInitiated to the EconomyAnalytics projection"
      }
      on walletCreated: event Wallet.WalletCreated is {
        tell command WalletContext.WalletRepository.PersistWalletCreated(walletId = walletCreated.walletId) to repository WalletContext.WalletRepository
        do "apply WalletCreated to the EconomyAnalytics projection"
      }
      on currencyAdded: event Wallet.CurrencyAdded is {
        tell command WalletContext.WalletRepository.PersistCurrencyAdded(walletId = currencyAdded.walletId) to repository WalletContext.WalletRepository
      }
      on currencySpent: event Wallet.CurrencySpent is {
        tell command WalletContext.WalletRepository.PersistCurrencySpent(walletId = currencySpent.walletId) to repository WalletContext.WalletRepository
      }
      on itemPurchased: event Wallet.ItemPurchased is {
        tell command WalletContext.WalletRepository.PersistItemPurchased(walletId = itemPurchased.walletId) to repository WalletContext.WalletRepository
      }
      on tradeCompleted: event Wallet.TradeCompleted is {
        tell command WalletContext.WalletRepository.PersistTradeCompleted(walletId = tradeCompleted.walletId) to repository WalletContext.WalletRepository
      }
    } with {
      briefly "Maintains economy analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Economy analytics projections"
    described as {
      |Maintains game economy analytics data.
    }
  }
  streamlet WalletEventSplit as flow is {
    inlet WalletEventSplitIn is type WalletEvent    outlet WalletEventSplitToEconomyAnalytics is type WalletEvent
    handler WalletEventSplitHandler is {
      on walletCreated: event Wallet.WalletCreated is {
        send walletCreated to outlet WalletEventSplitToEconomyAnalytics
        tell walletCreated to entity WalletContext.Wallet
      }
      on currencyAdded: event Wallet.CurrencyAdded is {
        send currencyAdded to outlet WalletEventSplitToEconomyAnalytics
        tell currencyAdded to entity WalletContext.Wallet
      }
      on currencySpent: event Wallet.CurrencySpent is {
        send currencySpent to outlet WalletEventSplitToEconomyAnalytics
        tell currencySpent to entity WalletContext.Wallet
      }
      on currencyTransferred: event Wallet.CurrencyTransferred is {
        send currencyTransferred to outlet WalletEventSplitToEconomyAnalytics
        tell currencyTransferred to entity WalletContext.Wallet by walletId
      }
      on itemAdded: event Wallet.ItemAdded is {
        send itemAdded to outlet WalletEventSplitToEconomyAnalytics
        tell itemAdded to entity WalletContext.Wallet
      }
      on itemRemoved: event Wallet.ItemRemoved is {
        send itemRemoved to outlet WalletEventSplitToEconomyAnalytics
        tell itemRemoved to entity WalletContext.Wallet
      }
      on itemPurchased: event Wallet.ItemPurchased is {
        send itemPurchased to outlet WalletEventSplitToEconomyAnalytics
        tell itemPurchased to entity WalletContext.Wallet
      }
      on tradeInitiated: event Wallet.TradeInitiated is {
        send tradeInitiated to outlet WalletEventSplitToEconomyAnalytics
        tell tradeInitiated to entity WalletContext.Wallet
      }
      on tradeCompleted: event Wallet.TradeCompleted is {
        send tradeCompleted to outlet WalletEventSplitToEconomyAnalytics
        tell tradeCompleted to entity WalletContext.Wallet
      }
      on other is {
        error "Unexpected message for processor WalletEventSplit"
      }
    } with {
      briefly "Wallet event fan-out handler"
      described as {
        |Delivers each Wallet event to all of its consumers.
      }
    }
  } with {
    briefly "Wallet event fan-out"
    described as {
      |Fans Wallet events out to the repository and projectors.
    }
  }
  connector 'WalletEvent Stream' is from outlet WalletContext.Wallet.WalletEvents2 to inlet WalletContext.WalletEventSplit.WalletEventSplitIn with {
    briefly "Wallet events, fanned out to storage and read models"
  }
  connector 'EconomyAnalytics Feed' is from outlet WalletContext.WalletEventSplit.WalletEventSplitToEconomyAnalytics to inlet WalletContext.EconomyAnalytics.EconomyAnalyticsFromWallet with {
    briefly "Wallet events feeding the EconomyAnalytics projection"
  }
  connector 'EconomyAnalytics Storage' is from outlet WalletContext.EconomyAnalytics.EconomyAnalyticsToRepository to inlet WalletContext.WalletRepository.WalletRepositoryFromEconomyAnalytics with {
    briefly "EconomyAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for game economy"
  described as {
    | The WalletContext is the bounded context for player
    | wallets, currencies, items, and transactions.
  }
}
