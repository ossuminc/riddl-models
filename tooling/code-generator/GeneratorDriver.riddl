application context GeneratorDriver as router is {
  outlet AppHoleQueries is query HoleFilling.Hole.GetHole
  inlet AppHoleReplies is result HoleFilling.Hole.HoleResult with {
    briefly "How the hole stands, back from HoleFilling"
  }
  outlet AppArtifactQueries is query CodeEmission.Artifact.GetArtifact
  inlet AppArtifactReplies is result CodeEmission.Artifact.ArtifactResult with {
    briefly "How the artifact stands, back from CodeEmission"
  }
  outlet AppGenerationRunQueries is query Intake.GenerationRun.GetGenerationRun
  inlet AppGenerationRunReplies is result Intake.GenerationRun.GenerationRunResult with {
    briefly "How the generation run stands, back from Intake"
  }
  outlet IntakeCommands is type Intake.IntakeCommand
 with {
    briefly "Intake commands from the driver"
    described as {
      |Where the driver publishes the commands that begin a run.
    }
  }
  outlet PlanningCommands is type Planning.PlanningCommand
 with {
    briefly "Planning commands from the driver"
    described as {
      |Where the driver publishes the commands that plan a run.
    }
  }
  outlet SpecEmissionCommands is type SpecEmission.SpecEmissionCommand
 with {
    briefly "SpecEmission commands from the driver"
    described as {
      |Where the driver publishes the commands that emit a run's suite.
    }
  }
  outlet CodeEmissionCommands is type CodeEmission.CodeEmissionCommand
 with {
    briefly "CodeEmission commands from the driver"
    described as {
      |Where the driver publishes the commands that emit a run's code.
    }
  }
  outlet HoleFillingCommands is type HoleFilling.HoleFillingCommand
 with {
    briefly "HoleFilling commands from the driver"
    described as {
      |Where the driver publishes the commands that fill a run's holes.
    }
  }
  outlet ProvingCommands is type Proving.ProvingCommand
 with {
    briefly "Proving commands from the driver"
    described as {
      |Where the driver publishes the commands that prove a run's artifacts.
    }
  }
  group GeneratorConsole is {
    input StartRunInput acquires command Intake.StartRun with {
      briefly "Start run subcommand"
      described as {
        |The subcommand through which a person asks the generator to start run.
      }
    }
    output RunStartedView presents event Intake.GenerationRun.RunStarted with {
      briefly "The run started answer"
      described as {
        |What StartRun brought into being, with the id it was given.
      }
    }
    input AdmitModelInput acquires command Intake.GenerationRun.AdmitModel with {
      briefly "Admit model subcommand"
      described as {
        |The subcommand through which a person asks the generator to admit model.
      }
    }
    input RefuseModelInput acquires command Intake.GenerationRun.RefuseModel with {
      briefly "Refuse model subcommand"
      described as {
        |The subcommand through which a person asks the generator to refuse model.
      }
    }
    input PlanModelInput acquires command Planning.PlanModel with {
      briefly "Plan model subcommand"
      described as {
        |The subcommand through which a person asks the generator to plan model.
      }
    }
    input DiscardPlanInput acquires command Planning.DiscardPlan with {
      briefly "Discard plan subcommand"
      described as {
        |The subcommand through which a person asks the generator to discard plan.
      }
    }
    input EmitSpecsInput acquires command SpecEmission.EmitSpecs with {
      briefly "Emit specs subcommand"
      described as {
        |The subcommand through which a person asks the generator to emit specs.
      }
    }
    input DiscardSpecsInput acquires command SpecEmission.DiscardSpecs with {
      briefly "Discard specs subcommand"
      described as {
        |The subcommand through which a person asks the generator to discard specs.
      }
    }
    input EmitCodeInput acquires command CodeEmission.EmitCode with {
      briefly "Emit code subcommand"
      described as {
        |The subcommand through which a person asks the generator to emit code.
      }
    }
    input DiscardCodeInput acquires command CodeEmission.DiscardCode with {
      briefly "Discard code subcommand"
      described as {
        |The subcommand through which a person asks the generator to discard code.
      }
    }
    input FillCodeInput acquires command CodeEmission.FillCode with {
      briefly "Fill code subcommand"
      described as {
        |The subcommand through which a person asks the generator to fill code.
      }
    }
    input VerifyCodeInput acquires command CodeEmission.VerifyCode with {
      briefly "Verify code subcommand"
      described as {
        |The subcommand through which a person asks the generator to verify code.
      }
    }
    input FillHolesInput acquires command HoleFilling.FillHoles with {
      briefly "Fill holes subcommand"
      described as {
        |The subcommand through which a person asks the generator to fill holes.
      }
    }
    input ReopenHolesInput acquires command HoleFilling.ReopenHoles with {
      briefly "Reopen holes subcommand"
      described as {
        |The subcommand through which a person asks the generator to reopen holes.
      }
    }
    input DiscardFillsInput acquires command HoleFilling.DiscardFills with {
      briefly "Discard fills subcommand"
      described as {
        |The subcommand through which a person asks the generator to discard fills.
      }
    }
    input RunBootGateInput acquires command Proving.RunBootGate with {
      briefly "Run boot gate subcommand"
      described as {
        |The subcommand through which a person asks the generator to run boot gate.
      }
    }
    input RunGreenGateInput acquires command Proving.RunGreenGate with {
      briefly "Run green gate subcommand"
      described as {
        |The subcommand through which a person asks the generator to run green gate.
      }
    }
    input DiscardProofInput acquires command Proving.DiscardProof with {
      briefly "Discard proof subcommand"
      described as {
        |The subcommand through which a person asks the generator to discard proof.
      }
    }
    input GetGenerationRunInput acquires query Intake.GenerationRun.GetGenerationRun with {
      briefly "Run status"
      described as {
        |Asks how a generation run ended: admitted, or refused and why.
      }
    }
    input GetArtifactInput acquires query CodeEmission.Artifact.GetArtifact with {
      briefly "Artifact status"
      described as {
        |Asks an artifact's path, paradigm and open holes.
      }
    }
    input GetHoleInput acquires query HoleFilling.Hole.GetHole with {
      briefly "Hole status"
      described as {
        |Asks a hole's prompt, its context and its fill attempts.
      }
    }
  } with {
    briefly "Generator console"
    described as {
      |The terminal from which a person runs the generator and reads its report.
    }
  }
  inlet AppRunStartedAnswer is event Intake.GenerationRun.RunStarted
  handler GeneratorDriverReport is {
    on runStarted: event Intake.GenerationRun.RunStarted is {
      put runStarted to output GeneratorDriver.GeneratorConsole.RunStartedView
    }
    on generationRunResult: result Intake.GenerationRun.GenerationRunResult is {
      log generationRunResult
    }
    on artifactResult: result CodeEmission.Artifact.ArtifactResult is {
      log artifactResult
    }
    on holeResult: result HoleFilling.Hole.HoleResult is {
      log holeResult
    }
    on other is {
      error "Unexpected message for application context GeneratorDriver"
    }
  } with {
    briefly "The run report"
    described as {
      |What the driver learns back about a run, an artifact or a hole, and
      |reports to whoever ran the generator.
    }
  }
} with {
  briefly "The process that runs a generation"
  described as {
    |A command-line invocation, a serve-mode request, or a test harness. It
    |is modelled because the pipeline's contexts must be reachable from
    |somewhere, and pretending a saga reaches them by itself would leave
    |every step unreachable.
  }
}
