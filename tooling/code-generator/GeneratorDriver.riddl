application context GeneratorDriver as source is {
  outlet IntakeCommands is type Intake.IntakeCommand
 with {
    briefly "Intake commands from the driver"
    described as {
      |Where the driver publishes the commands that begin a run.
    }
  }
  outlet PlanningCommands is type Planning.PlanningCommand
 with {
    briefly "Planning commands from the driver"
    described as {
      |Where the driver publishes the commands that plan a run.
    }
  }
  outlet SpecEmissionCommands is type SpecEmission.SpecEmissionCommand
 with {
    briefly "SpecEmission commands from the driver"
    described as {
      |Where the driver publishes the commands that emit a run's suite.
    }
  }
  outlet CodeEmissionCommands is type CodeEmission.CodeEmissionCommand
 with {
    briefly "CodeEmission commands from the driver"
    described as {
      |Where the driver publishes the commands that emit a run's code.
    }
  }
  outlet HoleFillingCommands is type HoleFilling.HoleFillingCommand
 with {
    briefly "HoleFilling commands from the driver"
    described as {
      |Where the driver publishes the commands that fill a run's holes.
    }
  }
  outlet ProvingCommands is type Proving.ProvingCommand
 with {
    briefly "Proving commands from the driver"
    described as {
      |Where the driver publishes the commands that prove a run's artifacts.
    }
  }
} with {
  briefly "The process that runs a generation"
  described as {
    |A command-line invocation, a serve-mode request, or a test harness. It
    |is modelled because the pipeline's contexts must be reachable from
    |somewhere, and pretending a saga reaches them by itself would leave
    |every step unreachable.
  }
}
