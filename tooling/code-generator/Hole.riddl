event-sourced entity Hole as flow is {
  type HoleEvent is one of {
    Hole.HoleOpened or Hole.HoleFilled or Hole.HoleProved or Hole.HoleReopened
  } with {
    briefly "Hole event alternation"
    described as {
      |Events published by the Hole entity.
    }
  }
  inlet HoleCommands is type HoleFilling.HoleCommand with {
    briefly "Commands routed to this hole"
    described as {
      |Commands relayed from the HoleFilling boundary.
    }
  }
  outlet HoleEvents is type HoleEvent
 with {
    briefly "Events this hole publishes"
    described as {
      |Lifecycle events, consumed by the projection that persists them.
    }
  }
  command OpenHole yields event HoleOpened is {
    holeId: HoleId with {
      briefly "Hole"
      described as {
        |The hole being opened.
      }
    }
    holeArtifactId: CodeEmission.ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact this hole belongs to.
      }
    }
    holePrompt: String(1,4096) with {
      briefly "Prompt"
      described as {
        |The do/prompt text this hole came from.
      }
    }
    enclosingProcessor: String(1,256) with {
      briefly "Processor"
      described as {
        |The fill context's first component: the processor enclosing this
        |hole.
      }
    }
    codeSoFar: String(1,65535) with {
      briefly "Code"
      described as {
        |The artifact's code at the point of this hole.
      }
    }
    declarationsInScope: String(1,65535) with {
      briefly "Declarations"
      described as {
        |What the AI may draw on to fill this hole.
      }
    }
  } with {
    briefly "Open a hole"
    described as {
      |Begins a hole against the prose it came from and the local slice of
      |context it may be filled against, before any fill attempt has been
      |made.
    }
  }
  command FillHole yields event HoleFilled is {
    holeId: HoleId with {
      briefly "Hole"
      described as {
        |The hole being filled.
      }
    }
  } with {
    briefly "Attempt a fill"
    described as {
      |Assembles this hole's local fill context and requests a fill from
      |the AI backend, bounded by AttemptsBounded.
    }
  }
  command ProveHole yields event HoleProved is {
    holeId: HoleId with {
      briefly "Hole"
      described as {
        |The hole being proven.
      }
    }
  } with {
    briefly "Accept a fill"
    described as {
      |Records that this hole's fill is locally coherent with its
      |declarations in scope. This is local acceptance of one hole's
      |content, not the artifact-wide proof that Proving runs.
    }
  }
  command ReopenHole yields event HoleReopened is {
    holeId: HoleId with {
      briefly "Hole"
      described as {
        |The hole being reopened.
      }
    }
  } with {
    briefly "Reopen a hole for another fill attempt"
    described as {
      |Relayed from HoleFilling.ReopenHoles when Proving rejects the
      |artifact as a whole and this hole's fill is implicated, returning it
      |to Open for another pass. fillAttempts is not reset: the cap bounds
      |the total attempts ever made on this hole, across every reopen.
    }
  }
  event HoleOpened is {
    holeId: HoleId with {
      briefly "Hole"
      described as {
        |The hole that came into existence.
      }
    }
    holeArtifactId: CodeEmission.ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact it belongs to.
      }
    }
    holePrompt: String(1,4096) with {
      briefly "Prompt"
      described as {
        |The do/prompt text it came from.
      }
    }
    enclosingProcessor: String(1,256) with {
      briefly "Processor"
      described as {
        |The processor enclosing it.
      }
    }
    codeSoFar: String(1,65535) with {
      briefly "Code"
      described as {
        |The artifact's code at the point of the hole.
      }
    }
    declarationsInScope: String(1,65535) with {
      briefly "Declarations"
      described as {
        |What the AI may draw on.
      }
    }
  } with {
    briefly "Hole opened"
    described as {
      |A hole came into existence. Nothing has been filled yet.
    }
  }
  event HoleFilled is {
    holeId: HoleId with {
      briefly "Hole"
      described as {
        |The hole filled.
      }
    }
  } with {
    briefly "Hole filled"
    described as {
      |A fill attempt produced content for this hole.
    }
  }
  event HoleProved is {
    holeId: HoleId with {
      briefly "Hole"
      described as {
        |The hole proven.
      }
    }
  } with {
    briefly "Hole proven"
    described as {
      |This hole's fill was accepted as locally coherent.
    }
  }
  event HoleReopened is {
    holeId: HoleId with {
      briefly "Hole"
      described as {
        |The hole reopened.
      }
    }
  } with {
    briefly "Hole reopened"
    described as {
      |This hole was returned to Open for another fill attempt.
    }
  }
  record HoleData is {
    holeId: HoleId with {
      briefly "Hole"
      described as {
        |The hole this state belongs to, carried through every state so the
        |record can be rebuilt by replaying the event log.
      }
    }
    holeArtifactId: CodeEmission.ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact this hole belongs to.
      }
    }
    holePrompt: String(1,4096) with {
      briefly "Prompt"
      described as {
        |The do/prompt text this hole came from — the one seam the
        |language deliberately leaves vague. Conditions and branching are
        |not holes: RIDDL 2.0 shipped typed holes, a closed boolean
        |expression grammar and structured match patterns, which moved
        |that work into the deterministic tier. A generator still routing
        |conditions through AI FILL is doing work the language now does
        |for it.
      }
    }
    enclosingProcessor: String(1,256) with {
      briefly "Processor"
      described as {
        |The fill context's first component: the processor enclosing this
        |hole.
      }
    }
    codeSoFar: String(1,65535) with {
      briefly "Code"
      described as {
        |The artifact's code at the point of this hole. Filling depends on
        |this local slice, not the whole model being generated for.
      }
    }
    declarationsInScope: String(1,65535) with {
      briefly "Declarations"
      described as {
        |What the AI may draw on to fill this hole.
      }
    }
    fillAttempts: Natural with {
      briefly "Attempts"
      described as {
        |The retry cap's counter, bounded by AttemptsBounded across every
        |fill attempt this hole ever makes, including after a reopen.
      }
    }
  } with {
    briefly "Hole state data"
    described as {
      |Full state of a hole. Shared across all its states.
    }
  }
  initial state Open of record Hole.HoleData is {
    initial handler OpenInit is {
      on init is {
        let creation: type HoleOpened = prompt("the hole opened that brings this hole into existence")
        yield creation
      }
    } with {
      briefly "Open init handler"
      described as {
        |Brings the hole into existence by yielding its entering event.
      }
    }
    invariant AttemptsBounded is "HoleData.fillAttempts <= 5" with {
      briefly "Fill attempts are capped"
      described as {
        |An unbounded fill-and-prove cycle against an AI backend is a
        |runaway. The cap is what makes the cycle terminate on failure; the
        |normal termination is the artifact's open hole count reaching
        |zero.
      }
    }
    handler OpenHandler is {
      on command OpenHole is {
        yield event HoleOpened(holeId = OpenHole.holeId, holeArtifactId = OpenHole.holeArtifactId, holePrompt = OpenHole.holePrompt, enclosingProcessor = OpenHole.enclosingProcessor, codeSoFar = OpenHole.codeSoFar, declarationsInScope = OpenHole.declarationsInScope)
      }
      on openedEvent: event HoleOpened is {
        send openedEvent to outlet HoleFilling.Hole.HoleEvents
      }
      on command FillHole is {
        require invariant AttemptsBounded
        let assembled = call function HoleFilling.AssembleFillContext(requestHoleId = FillHole.holeId, requestArtifactId = HoleData.holeArtifactId)
        do "invoke the AI backend with assembled.contextProcessor,
           assembled.contextCodeSoFar and assembled.contextDeclarations
           to produce a fill for holeId"
        yield event HoleFilled(holeId = FillHole.holeId)
      }
      on filledEvent: event HoleFilled is {
        send filledEvent to outlet HoleFilling.Hole.HoleEvents
        morph entity HoleFilling.Hole to state HoleFilling.Hole.Filled with record Hole.HoleData(holeId = filledEvent.holeId, holeArtifactId = HoleData.holeArtifactId, holePrompt = HoleData.holePrompt, enclosingProcessor = HoleData.enclosingProcessor, codeSoFar = HoleData.codeSoFar, declarationsInScope = HoleData.declarationsInScope, fillAttempts = prompt("HoleData.fillAttempts + 1"))
      }
      on other is {
        error "Unexpected message for Hole while Open"
      }
    } with {
      briefly "Open state handler"
      described as {
        |Attempts a fill, bounded by AttemptsBounded, then advances to
        |Filled.
      }
    }
  } with {
    briefly "Open state"
    described as {
      |A prompt and its local fill context are known. No fill has
      |succeeded yet.
    }
  }
  state Filled of record Hole.HoleData is {
    initial handler FilledInit is {
      on init is {
        let entering: type HoleFilled = prompt("the hole filled that enters this state")
        yield entering
      }
    } with {
      briefly "Filled init handler"
      described as {
        |Enters the filled state.
      }
    }
    handler FilledHandler is {
      on command ProveHole is {
        do "check whether this hole's fill is locally coherent with
           declarationsInScope"
        yield event HoleProved(holeId = ProveHole.holeId)
      }
      on provedEvent: event HoleProved is {
        send provedEvent to outlet HoleFilling.Hole.HoleEvents
        morph entity HoleFilling.Hole to state HoleFilling.Hole.Proven with record Hole.HoleData(holeId = provedEvent.holeId, holeArtifactId = HoleData.holeArtifactId, holePrompt = HoleData.holePrompt, enclosingProcessor = HoleData.enclosingProcessor, codeSoFar = HoleData.codeSoFar, declarationsInScope = HoleData.declarationsInScope, fillAttempts = HoleData.fillAttempts)
      }
      on other is {
        error "Unexpected message for Hole while Filled"
      }
    } with {
      briefly "Filled state handler"
      described as {
        |Waits for local acceptance of this hole's fill, then advances to
        |Proven.
      }
    }
  } with {
    briefly "Filled state"
    described as {
      |A fill attempt produced content. It has not yet been accepted.
    }
  }
  state Proven of record Hole.HoleData is {
    initial handler ProvenInit is {
      on init is {
        let entering: type HoleProved = prompt("the hole proved that enters this state")
        yield entering
      }
    } with {
      briefly "Proven init handler"
      described as {
        |Enters the proven state.
      }
    }
    handler ProvenHandler is {
      on command ReopenHole is {
        yield event HoleReopened(holeId = ReopenHole.holeId)
      }
      on reopenedEvent: event HoleReopened is {
        send reopenedEvent to outlet HoleFilling.Hole.HoleEvents
        morph entity HoleFilling.Hole to state HoleFilling.Hole.Open with record Hole.HoleData(holeId = reopenedEvent.holeId, holeArtifactId = HoleData.holeArtifactId, holePrompt = HoleData.holePrompt, enclosingProcessor = HoleData.enclosingProcessor, codeSoFar = HoleData.codeSoFar, declarationsInScope = HoleData.declarationsInScope, fillAttempts = HoleData.fillAttempts)
      }
      on other is {
        error "Unexpected message for Hole while Proven"
      }
    } with {
      briefly "Proven state handler"
      described as {
        |Locally accepted. Waits for either nothing further, or a reopen
        |from HoleFilling.ReopenHoles when Proving rejects the artifact
        |and another fill attempt is owed.
      }
    }
  } with {
    briefly "Proven state"
    described as {
      |This hole's fill was accepted as locally coherent. It may still be
      |reopened if the artifact-wide proof fails.
    }
  }
} with {
  briefly "One hole in one artifact, moving from open to proven"
  described as {
    |A hole is a do/prompt statement's seam — the one place the language
    |deliberately leaves vague. Conditions and branching are not modelled
    |here: RIDDL 2.0's typed holes, closed boolean expressions and
    |structured match patterns already made those deterministic, so a
    |generator that still routes them through AI FILL is redoing work the
    |language now does for it. Open -> Filled -> Proven, with Proven ->
    |Open the one cycle back, driven by HoleFilling.ReopenHoles rather
    |than by anything this entity decides on its own.
  }
}
