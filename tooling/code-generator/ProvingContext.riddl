context Proving as router is {
  command RunBootGate is {
    gateArtifactId: CodeEmission.ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact this gate is proving.
      }
    }
    gateRunId: Intake.GenerationRunId with {
      briefly "Run"
      described as {
        |The generation run this gate belongs to.
      }
    }
  } with {
    briefly "Run the pass-1 boot gate"
    described as {
      |Compiles, augments and boots the emitted artifact with its generated
      |suite skipped, precisely because behaviour is not yet assertable: the
      |suite that would assert it still contains open holes. Boot success is
      |the whole of pass-1's acceptance.
    }
  }
  command RunGreenGate yields event GateRun is {
    gateArtifactId: CodeEmission.ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact this gate is proving.
      }
    }
    gateRunId: Intake.GenerationRunId with {
      briefly "Run"
      described as {
        |The generation run this gate belongs to.
      }
    }
  } with {
    briefly "Run the pass-2 green gate"
    described as {
      |Runs the generated suite, now that hole filling has supplied the
      |behaviour pass-1 could not assert. Acceptance is the suite going
      |green; every run reports GateRun, green or red.
    }
  }
  command DiscardProof is {
    proofArtifactId: CodeEmission.ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact whose proof attempt is to be forgotten.
      }
    }
    proofRunId: Intake.GenerationRunId with {
      briefly "Run"
      described as {
        |The generation run this proof belongs to.
      }
    }
  } with {
    briefly "Forget a proof attempt"
    described as {
      |Compensates RunGreenGate for the saga's sake. Proving holds no
      |state of its own — the gates assert, they do not persist — so
      |this command is a formal acknowledgement rather than an undo; the
      |substantive compensation is HoleFilling.ReopenHoles, which the
      |saga tells alongside it.
    }
  }
  type ProvingCommand is one of {
    Proving.RunBootGate or Proving.RunGreenGate or Proving.DiscardProof
  } with {
    briefly "Proving command alternation"
    described as {
      |Commands accepted at the Proving boundary.
    }
  }
  inlet ProvingCommandsIn is type ProvingCommand with {
    briefly "Proving command intake"
    described as {
      |Where peers deliver commands for Proving.
    }
  }
  event GateRun is {
    gateArtifactId: CodeEmission.ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact whose green gate was run.
      }
    }
    passed: Boolean with {
      briefly "Passed"
      described as {
        |Whether the generated suite went green.
      }
    }
    failureDetail: String(1,4096)? with {
      briefly "Detail"
      described as {
        |What the generated suite reported when it did not go green; empty
        |when it did.
      }
    }
  } with {
    briefly "A green gate was run"
    described as {
      |The outcome of every pass-2 run, green or red. Published so
      |HoleFilling can reopen the holes implicated in a red one. This is
      |the retry cycle's whole mechanism: an event, not a loop. A reactive
      |system re-enters a prior stage by publishing what went wrong rather
      |than iterating until something changes.
    }
  }
  outlet GateRuns is event GateRun
 with {
    briefly "Green-gate outcome egress"
    described as {
      |Where every green-gate run republishes GateRun for HoleFilling.
    }
  }
  outlet TestRunnerQueries is query TestRunner.RunSuite
 with {
    briefly "Suite runs, on their way to the test runner"
    described as {
      |Where the green gate asks the test runner to run a suite.
    }
  }
  inlet TestRunnerReplies is result TestRunner.SuiteResult with {
    briefly "Suite outcomes, on their way back"
    described as {
      |Where the test runner's answer to the green gate arrives.
    }
  }
  adaptor ToTestRunner to context TestRunner as flow is { 
    inlet ToTestRunnerIn is query TestRunner.RunSuite with {
      briefly "Suite runs from the green gate"
      described as {
        |Where the green gate's question reaches the adaptor.
      }
    }
    outlet ToTestRunnerOut is query TestRunner.RunSuite
 with {
      briefly "Suite runs to the test runner"
      described as {
        |Where the question leaves Proving for the test runner.
      }
    }
    handler ToTestRunnerHandler is {
      on runSuite: query TestRunner.RunSuite is {
        send runSuite to outlet Proving.ToTestRunner.ToTestRunnerOut
      }
      on other is {
        error "Unexpected message for adaptor ToTestRunner"
      }
    } with {
      briefly "to test runner"
      described as {
        |Relays each suite run the green gate asks for to the test runner.
      }
    }
  } with {
    briefly "TestRunner integration"
    described as {
      |Proving's outbound boundary toward the test runner: the question leg
      |of the green gate's ask.
    }
  }
  adaptor FromTestRunner from context TestRunner as flow is { 
    inlet FromTestRunnerIn is result TestRunner.SuiteResult with {
      briefly "Suite outcomes from the test runner"
      described as {
        |Where the test runner's answer reaches Proving.
      }
    }
    outlet FromTestRunnerToProving is result TestRunner.SuiteResult
 with {
      briefly "Suite outcomes to the green gate"
      described as {
        |Where the answer is handed on to Proving's own reply inlet.
      }
    }
    handler FromTestRunnerHandler is {
      on suiteResult: result TestRunner.SuiteResult is {
        send suiteResult to outlet Proving.FromTestRunner.FromTestRunnerToProving
      }
      on other is {
        error "Unexpected message for adaptor FromTestRunner"
      }
    } with {
      briefly "from test runner"
      described as {
        |Relays each suite outcome back to the green gate that asked.
      }
    }
  } with {
    briefly "TestRunner answers"
    described as {
      |Proving's inbound boundary from the test runner: the reply leg of
      |the green gate's ask.
    }
  }
  connector 'TestRunner Question' is from outlet Proving.TestRunnerQueries to inlet Proving.ToTestRunner.ToTestRunnerIn with {
    briefly "Suite runs on their way to the outbound adaptor"
    described as {
      |Carries the green gate's question to the adaptor that crosses the
      |boundary.
    }
  }
  connector 'TestRunner Answer' is from outlet Proving.FromTestRunner.FromTestRunnerToProving to inlet Proving.TestRunnerReplies with {
    briefly "Suite outcomes on their way to the green gate"
    described as {
      |Carries the test runner's answer from the inbound adaptor to the
      |green gate.
    }
  }
  handler ProvingBoundary is {
    on command RunBootGate is {
      do "compile, augment and boot the artifact identified by
         RunBootGate.gateArtifactId with its generated suite skipped"
    }
    on command RunGreenGate is {
      do "run the generated suite for the artifact identified by
         RunGreenGate.gateArtifactId"
      let suiteResult: type TestRunner.SuiteResult = ask query TestRunner.RunSuite(artifactId = RunGreenGate.gateArtifactId) of context TestRunner
      when not suiteResult.passed then
        yield event GateRun(gateArtifactId = RunGreenGate.gateArtifactId, passed = suiteResult.passed, failureDetail = suiteResult.output)
      else
        yield event GateRun(gateArtifactId = RunGreenGate.gateArtifactId, passed = suiteResult.passed, failureDetail = empty)
      end
    }
    on gateRun: event GateRun is {
      send gateRun to outlet Proving.GateRuns
    }
    on command DiscardProof is {
      do "acknowledge that nothing is stored for
         DiscardProof.proofArtifactId — Proving holds no state to
         discard"
    }
    on other is {
      error "Unexpected message at the Proving boundary"
    }
  } with {
    briefly "Context boundary and gate runner"
    described as {
      |Nothing inside needs routing to, so the boundary handler runs both
      |gates directly rather than forwarding them. RunGreenGate asks the
      |test runner for the suite's outcome and yields GateRun on every
      |path; the same handler republishes it to GateRuns, which is what
      |closes the
      |cycle back to HoleFilling rather than looping in place here.
      |DiscardProof exists only for the saga's compensation symmetry —
      |Proving is stateless, so there is nothing here to actually forget.
    }
  }
} with {
  briefly "Proving the emitted artifact against its two gates"
  described as {
    |Two gates, not one, because they assert different things. Pass-1 —
    |RunBootGate — compiles, augments and boots the artifact with its
    |suite's own assertions skipped, because behaviour is not yet
    |assertable while holes remain open. Pass-2 — RunGreenGate — runs
    |that suite for real, now that hole filling has supplied the missing
    |behaviour, and its acceptance is the suite going green.
    |
    |There is no loop construct here, and that is the correct shape.
    |Retry-until-green is an event cycle, not iteration: a failed green
    |gate yields a red GateRun, which this boundary republishes to
    |GateRuns; HoleFilling reopens the holes the failure implicates
    |and refills them. Re-running RunGreenGate itself is outside this
    |cycle's reach — that is the driver's job, telling Proving again once
    |HoleFilling's refill pass has completed. That is what a
    |reactive system does instead of looping. The cycle terminates two
    |ways — the artifact's open hole count reaching zero, or a Hole
    |hitting its MaxFillAttempts cap — and neither termination is
    |Proving's to enforce; both live where the state they depend on
    |already lives.
  }
}
