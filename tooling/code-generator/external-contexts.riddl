external context TestRunner as flow is {
  inlet TestRunnerRequests is query RunSuite with {
    briefly "What Proving asks the test runner to run"
    described as {
      |Where a request to run an artifact's generated suite arrives.
    }
  }
  outlet TestRunnerRepliesOut is result SuiteResult
 with {
    briefly "What the test runner answers, on its way back"
    described as {
      |Where the outcome of a suite run leaves for the asker.
    }
  }
  query RunSuite replies result SuiteResult is {
    artifactId: CodeEmission.ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact whose generated suite is to be run.
      }
    }
  } with {
    briefly "Run an artifact's generated suite"
    described as {
      |Runs the derived test suite against the artifact, for real, and
      |answers with whether it went green and what it printed.
    }
  }
  result SuiteResult is {
    passed: Boolean with {
      briefly "Passed"
      described as {
        |Whether every test in the suite went green.
      }
    }
    output: String(1,4096) with {
      briefly "Output"
      described as {
        |What the suite reported while it ran.
      }
    }
  } with {
    briefly "The outcome of a suite run"
    described as {
      |Green or not, with the suite's own report of why.
    }
  }
  handler TestRunnerBoundary is {
    on query RunSuite is {
      let suiteResult: type SuiteResult = prompt("run the suite RunSuite names and report the outcome")
      reply suiteResult
    }
    on other is {
      error "Unexpected message for external context TestRunner"
    }
  } with {
    briefly "TestRunner boundary"
    described as {
      |Answers each suite run it is asked for.
    }
  }
} with {
  briefly "External test runner"
  described as {
    |Whatever runs a target's tests — sbt, vitest, cargo — and reports the
    |outcome. Proving's green gate is this runner's answer, not a guess.
  }
}
