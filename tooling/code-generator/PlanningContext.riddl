context Planning as split is {
  command PlanModel is {
    subjectModel: ModelRef with {
      briefly "Model"
      described as {
        |The model whose definitions are to be planned.
      }
    }
  } with {
    briefly "Plan a model"
    described as {
      |Requests that every definition in subjectModel be lowered against
      |the target profiles and lowering catalogue.
    }
  }
  command DiscardPlan is {
    subjectModel: ModelRef with {
      briefly "Model"
      described as {
        |The model whose plan is to be discarded.
      }
    }
  } with {
    briefly "Discard a plan"
    described as {
      |Compensates PlanModel: forgets whatever planning subjectModel
      |produced.
    }
  }
  type PlanningCommand is one of {
    Planning.PlanModel or Planning.DiscardPlan
  } with {
    briefly "Planning command alternation"
    described as {
      |Commands accepted at the Planning boundary.
    }
  }
  inlet PlanningCommandsIn is type PlanningCommand with {
    briefly "Planning command intake"
    described as {
      |Where peers deliver commands for Planning.
    }
  }
  outlet PlanningToProfiles is command Planning.TargetProfiles.PersistTargetProfile
 with {
    briefly "Target profile egress"
    described as {
      |Where a derived target profile row is published toward storage.
    }
  }
  outlet PlanningToCatalogue is command Planning.LoweringCatalogue.PersistLoweringRule
 with {
    briefly "Lowering rule egress"
    described as {
      |Where a derived lowering rule row is published toward storage.
    }
  }
  handler PlanningBoundary is {
    on planModel: command Planning.PlanModel is {
      let selection: type ParadigmSelection = prompt("the target and definition kind to select a paradigm for, given planModel.subjectModel")
      let chosen = call function Planning.SelectParadigm(profileTarget = selection.profileTarget, selectionKind = selection.selectionKind)
      let request: type LoweringRequest = prompt("the lowering request for the definition being planned, carrying selection.selectionKind and chosen.chosenParadigm")
      let planned = call function Planning.LowerDefinition(definitionPath = request.definitionPath, definitionName = request.definitionName, basePackage = request.basePackage, requestKind = request.requestKind, requestParadigm = request.requestParadigm)
      let owed: type Capability = prompt("the capability chosen.chosenParadigm owes for selection.selectionKind, if any")
      let required: type Capability = prompt("the capability request.requestKind requires of request.requestParadigm")
      send command Planning.TargetProfiles.PersistTargetProfile(targetName = selection.profileTarget, processorKind = selection.selectionKind, selectedParadigm = chosen.chosenParadigm, owedCapability = owed) to outlet Planning.PlanningToProfiles
      send command Planning.LoweringCatalogue.PersistLoweringRule(ruleDefinitionKind = request.requestKind, ruleParadigm = request.requestParadigm, requiredCapability = required, plannedArtifactKind = planned.artifactPackage, preservedGuarantee = prompt("the guarantee this rule is bound to preserve")) to outlet Planning.PlanningToCatalogue
    }
    on discardPlan: command Planning.DiscardPlan is {
      do "discard whatever planning discardPlan.subjectModel previously produced"
    }
    on other is {
      error "Unexpected message at the Planning boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary. Planning is
      |aggregate-free, so there is no entity to relay to: the boundary
      |handler does the planning work itself, selecting a paradigm,
      |lowering the definition against it, and sending both persistence
      |commands to Planning's own outlets.
    }
  }
  record ParadigmSelection is {
    profileTarget: String(1,64) with {
      briefly "Target"
      described as {
        |The target whose profile decides.
      }
    }
    selectionKind: DefinitionKind with {
      briefly "Kind"
      described as {
        |The definition kind being lowered.
      }
    }
  } with {
    briefly "Input to paradigm selection"
    described as {
      |What SelectParadigm needs to consult a profile.
    }
  }
  record SelectedParadigm is {
    chosenParadigm: Paradigm with {
      briefly "Paradigm"
      described as {
        |The highest-precedence paradigm this target supplies for this kind.
      }
    }
  } with {
    briefly "Result of paradigm selection"
    described as {
      |What the catalogue is then keyed on.
    }
  }
  function SelectParadigm is { 
    requires record ParadigmSelection
    returns  record SelectedParadigm
    return prompt("the selectedParadigm recorded in TargetProfileData.profiles for profileTarget and selectionKind")
  } with {
    briefly "Choose the paradigm for a kind on a target"
    described as {
      |Half of the two-step selection: profile gives paradigm, then
      |catalogue gives rule. Keying the catalogue on paradigm rather than
      |on target is what stops it carrying one near-duplicate copy per
      |target — adding a target adds a profile, not forty rules.
    }
  }
  record LoweringRequest is {
    definitionPath: String(1,1024) with {
      briefly "Path"
      described as {
        |The definition's path from the root, joined with dots.
      }
    }
    definitionName: String(1,256) with {
      briefly "Name"
      described as {
        |The definition's own name, as the model spells it.
      }
    }
    basePackage: String(1,256) with {
      briefly "Base"
      described as {
        |The base package the derived path hangs from.
      }
    }
    requestKind: DefinitionKind with {
      briefly "Kind"
      described as {
        |The definition kind being lowered.
      }
    }
    requestParadigm: Paradigm with {
      briefly "Paradigm"
      described as {
        |The paradigm already selected for this kind on this target.
      }
    }
  } with {
    briefly "Input to lowering one definition"
    described as {
      |What LowerDefinition needs: the definition's identity and the
      |paradigm already chosen for it.
    }
  }
  record PlannedArtifact is {
    artifactPackage: String(1,1024) with {
      briefly "Package"
      described as {
        |The package the planned artifact belongs to.
      }
    }
    artifactName: String(1,256) with {
      briefly "Name"
      described as {
        |The planned artifact's name, legal in the target language.
      }
    }
  } with {
    briefly "Result of lowering one definition"
    described as {
      |Where a definition's generated artifact will live, and what it will
      |be named.
    }
  }
  function LowerDefinition is { 
    requires record LoweringRequest
    returns  record PlannedArtifact
    let derived = call function Naming.DerivePackage(hierarchyPath = LoweringRequest.definitionPath, basePackage = LoweringRequest.basePackage)
    let safe = call function Naming.Sanitize(sourceName = LoweringRequest.definitionName)
    return prompt("a planned artifact in package derived.packageName named safe.safeName, per the catalogue rule for this kind and paradigm")
  } with {
    briefly "Lower one definition to a planned artifact"
    described as {
      |Consults the catalogue rather than hard-coding its rule. That is what
      |makes an unused rule visible as a `usage` finding, which this
      |corpus's zero standard turns into a build failure. It does not make a
      |MISSING rule visible; that gap is real and is stated in the spec.
    }
  }
  repository TargetProfiles as sink is {
    inlet TargetProfilesInbound is command Planning.TargetProfiles.PersistTargetProfile with {
      briefly "Target profile intake"
      described as {
        |Persistence commands recording one target's profile.
      }
    }
    record StoredTargetProfile is {
      targetName: String(1,64) with {
        briefly "targetName"
        described as {
          |The targetName column of the stored profile row.
        }
      }
      processorKind: DefinitionKind with {
        briefly "processorKind"
        described as {
          |The processorKind column of the stored profile row.
        }
      }
      selectedParadigm: Paradigm with {
        briefly "selectedParadigm"
        described as {
          |The selectedParadigm column of the stored profile row.
        }
      }
      owedCapability: Capability? with {
        briefly "owedCapability"
        described as {
          |The owedCapability column of the stored profile row, when this
          |paradigm owes one.
        }
      }
    } with {
      briefly "Stored target profile row"
      described as {
        |The persistence shape of a target's profile as this repository
        |stores it.
      }
    }
    schema TargetProfileData is relational
      of profiles as record StoredTargetProfile
        index on field StoredTargetProfile.targetName
 with {
      briefly "Target profile data schema"
      described as {
        |Relational schema for persisting target profiles, one row per
        |target.
      }
    }
    command PersistTargetProfile is {
      targetName: String(1,64) with {
        briefly "targetName"
        described as {
          |The stored row to create or update.
        }
      }
      processorKind: DefinitionKind with {
        briefly "Kind"
        described as {
          |The definition kind this profile row describes.
        }
      }
      selectedParadigm: Paradigm with {
        briefly "Paradigm"
        described as {
          |The paradigm this target supplies for processorKind.
        }
      }
      owedCapability: Capability? with {
        briefly "Owed"
        described as {
          |The capability this paradigm owes, when it owes one.
        }
      }
    } with {
      briefly "Persist TargetProfile"
      described as {
        |Instructs this repository to record one target's profile row.
      }
    }
    handler TargetProfilePersistence is {
      on command PersistTargetProfile is {
        do "insert or update TargetProfileData.profiles the row for targetName and processorKind with selectedParadigm and owedCapability"
      }
    } with {
      briefly "TargetProfile persistence handler"
      described as {
        |Applies each persistence command to the stored row.
      }
    }
  } with {
    briefly "Target profile repository"
    described as {
      |Stores, one row per target, which paradigm that target supplies for
      |each definition kind.
    }
  }
  repository LoweringCatalogue as sink is {
    inlet LoweringCatalogueInbound is command Planning.LoweringCatalogue.PersistLoweringRule with {
      briefly "Lowering rule intake"
      described as {
        |Persistence commands recording one lowering rule.
      }
    }
    record StoredLoweringRule is {
      ruleDefinitionKind: DefinitionKind with {
        briefly "ruleDefinitionKind"
        described as {
          |The ruleDefinitionKind column of the stored rule row.
        }
      }
      ruleParadigm: Paradigm with {
        briefly "ruleParadigm"
        described as {
          |The ruleParadigm column of the stored rule row.
        }
      }
      requiredCapability: Capability with {
        briefly "requiredCapability"
        described as {
          |The requiredCapability column of the stored rule row.
        }
      }
      plannedArtifactKind: String(1,64) with {
        briefly "plannedArtifactKind"
        described as {
          |The plannedArtifactKind column of the stored rule row.
        }
      }
      preservedGuarantee: String(1,512) with {
        briefly "preservedGuarantee"
        described as {
          |The preservedGuarantee column of the stored rule row.
        }
      }
    } with {
      briefly "Stored lowering rule row"
      described as {
        |The persistence shape of a lowering rule as this repository
        |stores it.
      }
    }
    schema LoweringRuleData is relational
      of rules as record StoredLoweringRule
        index on field StoredLoweringRule.ruleDefinitionKind
 with {
      briefly "Lowering rule data schema"
      described as {
        |Relational schema for persisting lowering rules, one row per
        |(definitionKind, paradigm).
      }
    }
    command PersistLoweringRule is {
      ruleDefinitionKind: DefinitionKind with {
        briefly "Kind"
        described as {
          |The definition kind this rule applies to.
        }
      }
      ruleParadigm: Paradigm with {
        briefly "Paradigm"
        described as {
          |The paradigm this rule applies to.
        }
      }
      requiredCapability: Capability with {
        briefly "Requires"
        described as {
          |The capability this rule's lowering requires of the target.
        }
      }
      plannedArtifactKind: String(1,64) with {
        briefly "Artifact"
        described as {
          |What kind of artifact this rule plans to emit.
        }
      }
      preservedGuarantee: String(1,512) with {
        briefly "Preserves"
        described as {
          |The guarantee this rule's lowering is bound to preserve.
        }
      }
    } with {
      briefly "Persist LoweringRule"
      described as {
        |Instructs this repository to record one lowering rule row.
      }
    }
    handler LoweringRulePersistence is {
      on command PersistLoweringRule is {
        do "insert or update LoweringRuleData.rules the row for ruleDefinitionKind and ruleParadigm with requiredCapability, plannedArtifactKind and preservedGuarantee"
      }
    } with {
      briefly "LoweringRule persistence handler"
      described as {
        |Applies each persistence command to the stored row.
      }
    }
  } with {
    briefly "Lowering catalogue repository"
    described as {
      |Stores, one row per (definitionKind, paradigm), the rule a lowering
      |must follow and the guarantee it must preserve.
    }
  }
  connector 'TargetProfiles Storage' is from outlet Planning.PlanningToProfiles to inlet Planning.TargetProfiles.TargetProfilesInbound with {
    briefly "Target profile rows on their way to TargetProfiles"
    described as {
      |Carries persistence commands to the repository that stores them.
    }
  }
  connector 'LoweringCatalogue Storage' is from outlet Planning.PlanningToCatalogue to inlet Planning.LoweringCatalogue.LoweringCatalogueInbound with {
    briefly "Lowering rule rows on their way to LoweringCatalogue"
    described as {
      |Carries persistence commands to the repository that stores them.
    }
  }
} with {
  briefly "Confines all target-awareness to one context"
  described as {
    |Everything upstream and downstream of Planning is target-agnostic.
    |SelectParadigm and LowerDefinition are the two functions the boundary
    |handler calls to plan a definition; Planning is aggregate-free, so
    |that handler does the work directly rather than relaying to an
    |entity that does not exist here. The catalogue and profiles they
    |consult are populated through this context's own Persist commands.
  }
}
