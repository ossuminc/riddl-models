context Planning as split is {
  command PlanModel is {
    subjectModel: ModelRef with {
      briefly "Model"
      described as {
        |The model whose definitions are to be planned.
      }
    }
  } with {
    briefly "Plan a model"
    described as {
      |Requests that every definition in subjectModel be lowered against
      |the target profiles and lowering catalogue.
    }
  }
  command DiscardPlan is {
    subjectModel: ModelRef with {
      briefly "Model"
      described as {
        |The model whose plan is to be discarded.
      }
    }
  } with {
    briefly "Discard a plan"
    described as {
      |Compensates PlanModel: forgets whatever planning subjectModel
      |produced.
    }
  }
  type PlanningCommand is one of {
    Planning.PlanModel or Planning.DiscardPlan
  } with {
    briefly "Planning command alternation"
    described as {
      |Commands accepted at the Planning boundary.
    }
  }
  inlet PlanningCommandsIn is type PlanningCommand with {
    briefly "Planning command intake"
    described as {
      |Where peers deliver commands for Planning.
    }
  }
  outlet PlanningToProfiles is command Planning.TargetProfiles.PersistTargetProfile
 with {
    briefly "Target profile egress"
    described as {
      |Where a derived target profile row is published toward storage.
    }
  }
  outlet PlanningToCatalogue is command Planning.LoweringCatalogue.PersistLoweringRule
 with {
    briefly "Lowering rule egress"
    described as {
      |Where a derived lowering rule row is published toward storage.
    }
  }
  handler PlanningBoundary is {
    on planModel: command Planning.PlanModel is {
      let selection: type ParadigmSelection = prompt("the target and definition kind to select a paradigm for, given planModel.subjectModel")
      let chosen = call function Planning.SelectParadigm(profileTarget = selection.profileTarget, selectionKind = selection.selectionKind)
      let request: type LoweringRequest = prompt("the lowering request for the definition being planned, carrying selection.selectionKind and chosen.chosenParadigm")
      let planned = call function Planning.LowerDefinition(definitionPath = request.definitionPath, definitionName = request.definitionName, basePackage = request.basePackage, requestKind = request.requestKind, requestParadigm = request.requestParadigm)
      let owed: type Capability = prompt("the capability chosen.chosenParadigm owes for selection.selectionKind, if any")
      let required: type Capability = prompt("the capability request.requestKind requires of request.requestParadigm")
      send command Planning.TargetProfiles.PersistTargetProfile(targetName = selection.profileTarget, processorKind = selection.selectionKind, selectedParadigm = chosen.chosenParadigm, owedCapability = owed) to outlet Planning.PlanningToProfiles
      send command Planning.LoweringCatalogue.PersistLoweringRule(ruleDefinitionKind = request.requestKind, ruleParadigm = request.requestParadigm, requiredCapability = required, plannedArtifactKind = planned.artifactPackage, preservedGuarantee = prompt("the guarantee this rule is bound to preserve")) to outlet Planning.PlanningToCatalogue
    }
    on discardPlan: command Planning.DiscardPlan is {
      do "discard whatever planning discardPlan.subjectModel previously produced"
    }
    on other is {
      error "Unexpected message at the Planning boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary. Planning is
      |aggregate-free, so there is no entity to relay to: the boundary
      |handler does the planning work itself, selecting a paradigm,
      |lowering the definition against it, and sending both persistence
      |commands to Planning's own outlets.
    }
  }
  record ParadigmSelection is {
    profileTarget: String(1,64) with {
      briefly "Target"
      described as {
        |The target whose profile decides.
      }
    }
    selectionKind: DefinitionKind with {
      briefly "Kind"
      described as {
        |The definition kind being lowered.
      }
    }
  } with {
    briefly "Input to paradigm selection"
    described as {
      |What SelectParadigm needs to consult a profile.
    }
  }
  record SelectedParadigm is {
    chosenParadigm: Paradigm with {
      briefly "Paradigm"
      described as {
        |The highest-precedence paradigm this target supplies for this kind.
      }
    }
  } with {
    briefly "Result of paradigm selection"
    described as {
      |What the catalogue is then keyed on.
    }
  }
  function SelectParadigm is { 
    requires record ParadigmSelection
    returns  record SelectedParadigm
    return prompt("the selectedParadigm recorded in TargetProfileData.profiles for profileTarget and selectionKind")
  } with {
    briefly "Choose the paradigm for a kind on a target"
    described as {
      |Half of the two-step selection: profile gives paradigm, then
      |catalogue gives rule. Keying the catalogue on paradigm rather than
      |on target is what stops it carrying one near-duplicate copy per
      |target — adding a target adds a profile, not forty rules.
    }
  }
  record LoweringRequest is {
    definitionPath: String(1,1024) with {
      briefly "Path"
      described as {
        |The definition's path from the root, joined with dots.
      }
    }
    definitionName: String(1,256) with {
      briefly "Name"
      described as {
        |The definition's own name, as the model spells it.
      }
    }
    basePackage: String(1,256) with {
      briefly "Base"
      described as {
        |The base package the derived path hangs from.
      }
    }
    requestKind: DefinitionKind with {
      briefly "Kind"
      described as {
        |The definition kind being lowered.
      }
    }
    requestParadigm: Paradigm with {
      briefly "Paradigm"
      described as {
        |The paradigm already selected for this kind on this target.
      }
    }
  } with {
    briefly "Input to lowering one definition"
    described as {
      |What LowerDefinition needs: the definition's identity and the
      |paradigm already chosen for it.
    }
  }
  record PlannedArtifact is {
    artifactPackage: String(1,1024) with {
      briefly "Package"
      described as {
        |The package the planned artifact belongs to.
      }
    }
    artifactName: String(1,256) with {
      briefly "Name"
      described as {
        |The planned artifact's name, legal in the target language.
      }
    }
  } with {
    briefly "Result of lowering one definition"
    described as {
      |Where a definition's generated artifact will live, and what it will
      |be named.
    }
  }
  function LowerDefinition is { 
    requires record LoweringRequest
    returns  record PlannedArtifact
    let derived = call function Naming.DerivePackage(hierarchyPath = LoweringRequest.definitionPath, basePackage = LoweringRequest.basePackage)
    let safe = call function Naming.Sanitize(sourceName = LoweringRequest.definitionName)
    return prompt("a planned artifact in package derived.packageName named safe.safeName, per the catalogue rule for this kind and paradigm")
  } with {
    briefly "Lower one definition to a planned artifact"
    described as {
      |Meant to consult the catalogue rather than hard-code its rule, but
      |as written its body is a bare `prompt` with no query and no
      |reference to StoredLoweringRule. The catalogue's rules live as
      |`described as` prose on LoweringCatalogue, not as RIDDL
      |definitions, so there is nothing here for riddlc to check
      |consultation against: a rule that nothing consults will NOT
      |surface as a `usage` finding, or any other finding -- that is a
      |real, unclosed gap in this model, not a self-enforcing property it
      |does not have. It also does not make a MISSING rule visible; that
      |gap is real too and is stated in the spec.
    }
  }
  repository TargetProfiles as sink is {
    inlet TargetProfilesInbound is command Planning.TargetProfiles.PersistTargetProfile with {
      briefly "Target profile intake"
      described as {
        |Persistence commands recording one target's profile.
      }
    }
    record StoredTargetProfile is {
      targetName: String(1,64) with {
        briefly "targetName"
        described as {
          |The targetName column of the stored profile row.
        }
      }
      processorKind: DefinitionKind with {
        briefly "processorKind"
        described as {
          |The processorKind column of the stored profile row.
        }
      }
      selectedParadigm: Paradigm with {
        briefly "selectedParadigm"
        described as {
          |The selectedParadigm column of the stored profile row.
        }
      }
      owedCapability: Capability? with {
        briefly "owedCapability"
        described as {
          |The owedCapability column of the stored profile row, when this
          |paradigm owes one.
        }
      }
    } with {
      briefly "Stored target profile row"
      described as {
        |The persistence shape of a target's profile as this repository
        |stores it.
      }
    }
    schema TargetProfileData is relational
      of profiles as record StoredTargetProfile
        index on field StoredTargetProfile.targetName
 with {
      briefly "Target profile data schema"
      described as {
        |Relational schema for persisting target profiles, one row per
        |target.
      }
    }
    command PersistTargetProfile is {
      targetName: String(1,64) with {
        briefly "targetName"
        described as {
          |The stored row to create or update.
        }
      }
      processorKind: DefinitionKind with {
        briefly "Kind"
        described as {
          |The definition kind this profile row describes.
        }
      }
      selectedParadigm: Paradigm with {
        briefly "Paradigm"
        described as {
          |The paradigm this target supplies for processorKind.
        }
      }
      owedCapability: Capability? with {
        briefly "Owed"
        described as {
          |The capability this paradigm owes, when it owes one.
        }
      }
    } with {
      briefly "Persist TargetProfile"
      described as {
        |Instructs this repository to record one target's profile row.
      }
    }
    handler TargetProfilePersistence is {
      on command PersistTargetProfile is {
        do "insert or update TargetProfileData.profiles the row for
           targetName and processorKind with selectedParadigm and
           owedCapability.

           owedCapability is a single optional field, but a target may owe
           several capabilities for one kind (Quarkus/Java owes three for
           EntityKind -- see described-as). Where that happens, send one
           PersistTargetProfile per owed capability, all sharing the same
           targetName and processorKind: the store then holds one row per
           (targetName, processorKind, owedCapability) rather than the
           last capability silently overwriting the others under an
           upsert keyed on (targetName, processorKind) alone. A target
           that owes nothing for a kind (Pekko/Scala for EntityKind) sends
           exactly one row with owedCapability empty."
      }
    } with {
      briefly "TargetProfile persistence handler"
      described as {
        |Applies each persistence command to the stored row. See the do
        |text for how a target owing more than one capability for a kind
        |is recorded without one overwriting another.
      }
    }
  } with {
    briefly "Target profile repository"
    described as {
      |Stores, one row per target and definition kind, which paradigm
      |that target supplies and what capability it owes as a result.
      |Three worked examples below show the shape of the paradigm
      |indirection end to end — prose, like LowerDefinition's own
      |catalogue rules (see its described-as), asserted here rather than
      |mechanically checked:
      |
      |Pekko/Scala selects Actor for EntityKind and owes nothing: Pekko
      |supplies AddressableIdentity, SerialExecution, ChannelInteraction
      |and, via Pekko Persistence, DurableJournal, all natively. This is
      |the top of the precedence -- the representation that costs no
      |facade at all (design 2.3.1).
      |
      |Quarkus/Java selects Component for EntityKind and owes three
      |capabilities: SerialExecution (a bean's container gives no
      |per-instance serialization guard of its own), ChannelInteraction
      |(a bean is invoked, not addressed over a channel, until Reactive
      |Messaging is wired in) and DurableJournal (Hibernate Reactive
      |persists current state, not an append-only log). This is the
      |middle tier the design names directly (2.3.2): reactive tenets
      |(Mutiny, SmallRye Reactive Messaging, Hibernate Reactive) without
      |the actor representation underneath them.
      |
      |TypeScript/Effect selects Actor for EntityKind, via @effect/
      |cluster (CM 4.4's own example of a target reaching Actor without a
      |native actor language feature: "sharded, addressable, durable
      |entities modeled on Akka Cluster Sharding"), and owes exactly
      |DurableJournal, since no event-sourcing library is assumed
      |present. This is the design's proof case (spec 2.3.2, Reid's
      |ruling): owing a capability never disqualifies a target -- the
      |generator emits the journal, and TypeScript/Effect remains
      |Actor-tier despite the gap. Quarkus/Java, by contrast, never
      |reaches Actor-tier at all: Component is the middle tier of the
      |precedence, not its floor (PlainObject is), and Quarkus stops
      |there, owing three capabilities instead of TypeScript/Effect's
      |one.
    }
  }
  repository LoweringCatalogue as sink is {
    inlet LoweringCatalogueInbound is command Planning.LoweringCatalogue.PersistLoweringRule with {
      briefly "Lowering rule intake"
      described as {
        |Persistence commands recording one lowering rule.
      }
    }
    record StoredLoweringRule is {
      ruleDefinitionKind: DefinitionKind with {
        briefly "ruleDefinitionKind"
        described as {
          |The ruleDefinitionKind column of the stored rule row.
        }
      }
      ruleParadigm: Paradigm with {
        briefly "ruleParadigm"
        described as {
          |The ruleParadigm column of the stored rule row.
        }
      }
      requiredCapability: Capability with {
        briefly "requiredCapability"
        described as {
          |The requiredCapability column of the stored rule row.
        }
      }
      plannedArtifactKind: String(1,64) with {
        briefly "plannedArtifactKind"
        described as {
          |The plannedArtifactKind column of the stored rule row.
        }
      }
      preservedGuarantee: String(1,512) with {
        briefly "preservedGuarantee"
        described as {
          |The preservedGuarantee column of the stored rule row.
        }
      }
    } with {
      briefly "Stored lowering rule row"
      described as {
        |The persistence shape of a lowering rule as this repository
        |stores it.
      }
    }
    schema LoweringRuleData is relational
      of rules as record StoredLoweringRule
        index on field StoredLoweringRule.ruleDefinitionKind
 with {
      briefly "Lowering rule data schema"
      described as {
        |Relational schema for persisting lowering rules, one row per
        |(definitionKind, paradigm).
      }
    }
    command PersistLoweringRule is {
      ruleDefinitionKind: DefinitionKind with {
        briefly "Kind"
        described as {
          |The definition kind this rule applies to.
        }
      }
      ruleParadigm: Paradigm with {
        briefly "Paradigm"
        described as {
          |The paradigm this rule applies to.
        }
      }
      requiredCapability: Capability with {
        briefly "Requires"
        described as {
          |The capability this rule's lowering requires of the target.
        }
      }
      plannedArtifactKind: String(1,64) with {
        briefly "Artifact"
        described as {
          |What kind of artifact this rule plans to emit.
        }
      }
      preservedGuarantee: String(1,512) with {
        briefly "Preserves"
        described as {
          |The guarantee this rule's lowering is bound to preserve.
        }
      }
    } with {
      briefly "Persist LoweringRule"
      described as {
        |Instructs this repository to record one lowering rule row.
      }
    }
    handler LoweringRulePersistence is {
      on command PersistLoweringRule is {
        require not PersistLoweringRule.ruleDefinitionKind == ConnectorKind or PersistLoweringRule.requiredCapability == DurableJournal
        require not PersistLoweringRule.ruleDefinitionKind == EntityKind or PersistLoweringRule.requiredCapability == DurableJournal
        require not PersistLoweringRule.ruleDefinitionKind == SagaKind or PersistLoweringRule.requiredCapability == DurableJournal
        do "insert or update LoweringRuleData.rules the row for
           ruleDefinitionKind and ruleParadigm with requiredCapability,
           plannedArtifactKind and preservedGuarantee.

           The three require statements above are the catalogue's genuine
           two-outcome decisions -- CrossContextConnectorIsPersistent,
           EventSourcedEntityAlwaysJournals and SagaProgressAlwaysDurable
           (LoweringCatalogue's described-as gives each its CM citation).
           Each is named for its CM-motivating case, but the Entity and
           Connector checks necessarily test the WHOLE kind at this
           catalogue's (DefinitionKind, Paradigm) granularity, which is
           broader than the CM sections they cite -- see described-as for
           exactly how far each citation reaches and why.
           Each is a structured boolean expression comparing
           PersistLoweringRule's own enum fields against DefinitionKind
           and Capability MEMBERS -- never a bare literal, and there is no
           comparand form for a quoted string at all, so the mistake this
           corpus forbids (a literal_string invariant that is a comment
           shaped like a guarantee) is not even parseable here. 'not A or
           B' is this grammar's spelling of 'A implies B': boolean_expression
           has and/or/not/comparison but no implies operator.

           They are inline require statements rather than named invariant
           definitions because riddlc rc.26 carries a confirmed bug (filed
           upstream, ../riddl/task/2026-08-27-invariant-requires-type-never-
           applied-false-positive.md): an invariant declared 'requires
           <type>' -- mandatory here, since a Repository has no state to
           read implicitly, unlike an Entity's State -- and applied via
           'require invariant X with <expr>' is unconditionally reported
           [usage] [invariant-requires-never-applied], even though riddlc
           dump --json shows the reference resolves to the exact right
           invariant. Ruled out as an artifact of this model: reproduced
           with a single bare comparison, with the with-value as a
           constructor and as a bare reference, and with the invariant
           moved into an Entity's State handler -- same finding every
           time. The inline form checks the identical condition and
           validates clean, which is the corpus's zero standard; the
           named-invariant form does not, for a reason that is riddlc's,
           not this model's."
      }
    } with {
      briefly "LoweringRule persistence handler"
      described as {
        |Applies each persistence command to the stored row, after
        |checking the three rules that are genuine two-outcome decisions
        |rather than free choices (see the do text for why they are
        |inline require statements and not named invariant definitions).
      }
    }
  } with {
    briefly "Lowering catalogue repository"
    described as {
      |Thirty-two rules, one per (DefinitionKind, Paradigm) pair that
      |can actually occur -- not the full 13x10 cross product. TypeKind
      |never lands on Actor, the design's own example of a non-occurring
      |pair: a RIDDL Type is a DDD Value Object with no identity and no
      |lifecycle (CM 11.1), so it is never itself represented as an actor
      |regardless of what paradigm its enclosing processor selects.
      |Paradigms within each kind are listed in the precedence order
      |type Paradigm declares (Actor, ActiveObject, CspProcess, Service,
      |DddAggregate, ReactiveStream, Component, MonadicStateMachine,
      |PlainObject, Dci), never any other order.
      |
      |Six processor-family kinds carry the paradigm precedence directly,
      |because CM Part One treats each as a first-class computational
      |artifact with its own concurrency and addressing story:
      |
      |EntityKind -- Actor (native; a Pekko/Akka persistent actor, one
      |instance per identity, per CM 4.1's own Akka-actor mental model),
      |ActiveObject (a proxy class fronting a scheduler-managed
      |activation queue -- CM 4.1's own named facade for a target without
      |native actors, and exactly what this design's TypeScript/Effect
      |profile means by "fibers + Queue"), DddAggregate (a DDD aggregate
      |class guarded by an explicit per-identity dispatcher), Component
      |(a Quarkus bean over Hibernate Reactive), PlainObject (a plain
      |class plus a hand-rolled dispatcher, queue and log).
      |EventSourcedEntityAlwaysJournals pins requiredCapability to
      |DurableJournal on all five rows -- but this is a granularity
      |limit, not a literal CM ruling, and the name records its
      |motivating case rather than its full scope. CM 4.8 requires a
      |durable journal only for an EVENT-SOURCED entity ("a generator may
      |choose the journal... but not whether a mutation is
      |event-derived"); it lists "event-sourced vs. CRUD persistence when
      |no option pins it" as free to choose, and a transient entity owns
      |no journal at all. DefinitionKind has one EntityKind for
      |event-sourced, CRUD and transient entities alike, so the catalogue
      |-- keyed at (DefinitionKind, Paradigm) -- cannot distinguish them,
      |and the check necessarily applies to every EntityKind row rather
      |than only the event-sourced ones CM 4.8 actually binds. A
      |transient entity is not separately expressible at this
      |granularity.
      |
      |RepositoryKind -- Actor (CM 5.6: "Repository is a Processor... like
      |an actor"), Component (a Quarkus/Panache repository bean),
      |PlainObject (a plain DAO with a hand-written write lock).
      |requiredCapability is ChannelInteraction on all three rows: CM
      |5.6's own guarantee is that queries execute ALWAYS CONCURRENTLY,
      |which needs non-blocking, asynchronous access rather than serial
      |execution -- SerialExecution is that guarantee's opposite, and
      |belongs to the write side instead, which the available option may
      |relax toward concurrency. requiredCapability is a property of the
      |construct and so does not vary by paradigm; what varies by
      |paradigm is how much of ChannelInteraction is supplied natively
      |versus owed as facade, which is exactly what
      |TargetProfile.owedCapability -- not this field -- records.
      |
      |ProjectorKind -- Actor (a Pekko actor consuming its event stream),
      |ReactiveStream (Pekko Streams / Effect Stream folding straight into
      |repository writes -- CM 6.4 names this the projector's OWN native
      |tier, since its computational artifact already reads as a stream),
      |Component (a SmallRye Reactive Messaging bean). Key-based
      |distribution for correlating projectors (CM 6.6) is the guarantee
      |threaded through all three.
      |
      |ProcessorKind, the streamlet shape-kinds (source, sink, flow,
      |merge, split, router, void) -- Actor (a Pekko Streams stage hosted
      |for supervision), CspProcess (a Go goroutine over typed channels,
      |where back-pressure becomes bounded channel capacity rather than a
      |demand signal), ReactiveStream (CM 8.4: "the most natural mapping
      |in the whole language"). Per-inlet ordering (CM 8.6) survives
      |on all three.
      |
      |AdaptorKind -- Actor (a thin translating actor deployed inside the
      |owning context), Component (a reactive converter bean), PlainObject
      |(a plain synchronous translation class). The isolation seam (CM
      |7.6 -- foreign types confined to the adaptor) and determinism of
      |translation (CM 7.7) are the guarantees common to all three.
      |
      |SagaKind -- Actor (a Pekko Persistence FSM actor tracking step
      |progress), Component (a Quarkus bean over a database-backed
      |progress table), MonadicStateMachine (an explicit persisted FSM:
      |a saga-progress record plus a step dispatch table plus a
      |compensation walker -- the SHAPE CM 9.4 names as its own fallback
      |for a target with no durable-workflow machinery, not an
      |endorsement of the cataloged MonadicStateMachine paradigm itself,
      |which -- like Elm/Redux -- supplies no native durability of its
      |own; this row is what that paradigm degenerates to once the
      |required journal is emitted as facade). SagaProgressAlwaysDurable
      |pins requiredCapability to DurableJournal on all three rows, per CM
      |9.5: "saga progress must be durable... or a crash mid-saga strands
      |participants" -- not optional, and not excused by Actor tier the
      |way it might look, since Pekko Persistence's journal IS the
      |durable store being required.
      |
      |Two kinds have their own rows precisely because their realization
      |differs by tier without either landing on the full precedence:
      |
      |ContextKind -- CM 3.4 calls a Context a deployment unit, not an
      |addressable per-identity instance, so it never lands on Actor or
      |DddAggregate; it is recorded at Service (a Pekko-hosted composition
      |root: an ActorSystem wiring every contained processor behind the
      |context's own portlets) and Component (a Quarkus deployment unit
      |wiring every contained bean behind a facade). Both preserve
      |independent deployability (CM 3.8) regardless of what paradigm the
      |contents individually select.
      |
      |HandlerKind is derivative of its enclosing processor's own
      |paradigm -- CM 17.4 calls it "a dispatch function (message, state)
      |-> Effect" belonging to whatever realizes the processor -- but its
      |dispatch SHAPE genuinely differs between an actor's receive loop
      |and a bean's dispatch method, which is why it gets two rows (Actor,
      |Component) rather than one, never a paradigm of its own account.
      |
      |Four kinds select no paradigm at all, because none of them is
      |addressable, concurrent, message-driven or durable: DomainKind (CM
      |2.4: "None at runtime... a namespace/package path"), TypeKind (CM
      |11.1: "no identity, no lifecycle, no behavior" -- the exemplar
      |above), FunctionKind (CM 19.1: "Not a processor, not a service"),
      |EpicKind (CM 26.3/26.5: "purely static... nothing to persist,
      |nothing to recover"). The schema still requires a Capability value
      |on every row regardless, so each of these four is recorded once
      |under AddressableIdentity as a nominal placeholder: the one thing
      |still true of a bare name -- a domain's path, a type's identifier,
      |a function's signature, an epic's story -- is that it is ADDRESSED
      |by reference, even though nothing about it runs.
      |
      |ConnectorKind -- Actor (a Pekko Streams / ActorRef-mediated pub-sub
      |channel), CspProcess (a bounded Go channel fronted by a generated
      |persistent buffer, since a bare channel supplies no durability of
      |its own), ReactiveStream (a plain Reactive Streams
      |Publisher/Subscriber pairing with no actor or bean wrapping at all
      |-- CM 25.4 requires Reactive Streams back-pressure semantics of
      |EVERY connector realization, which this row satisfies most
      |directly, with nothing else riding along), Component (a SmallRye
      |Reactive Messaging channel over Kafka/AMQP).
      |CrossContextConnectorIsPersistent pins requiredCapability to
      |DurableJournal on all four rows -- again a granularity limit
      |rather than a literal CM ruling: CM 25.8 scopes the durability
      |expectation to CROSS-CONTEXT edges specifically, and as a
      |validator WARNING, not a hard rule ("cross-context connectors
      |lacking [persistent] draw a validator warning... durability there
      |is not merely a deployment matter"); CM 25.4 explicitly permits "a
      |bounded in-memory channel... fused function call" for
      |same-context edges. DefinitionKind has one ConnectorKind for
      |cross-context and same-context connectors alike, so the catalogue
      |cannot distinguish them and the check applies to every
      |ConnectorKind row rather than only the cross-context ones CM 25.8
      |actually binds; an intra-context connector is not separately
      |expressible at this granularity. riddlg currently defaults the
      |cross-context case the OTHER way (riddl-generator BACKLOG item 6),
      |which is the motivating case the name records. The CspProcess row
      |is this design's "owing a capability never disqualifies a target"
      |claim (spec 2.3.2) made concrete for a Connector rather than an
      |Entity: the channel plus an emitted persistent buffer is the
      |facade a CSP-tier target owes.
    }
  }
  connector 'TargetProfiles Storage' is from outlet Planning.PlanningToProfiles to inlet Planning.TargetProfiles.TargetProfilesInbound with {
    briefly "Target profile rows on their way to TargetProfiles"
    described as {
      |Carries persistence commands to the repository that stores them.
    }
  }
  connector 'LoweringCatalogue Storage' is from outlet Planning.PlanningToCatalogue to inlet Planning.LoweringCatalogue.LoweringCatalogueInbound with {
    briefly "Lowering rule rows on their way to LoweringCatalogue"
    described as {
      |Carries persistence commands to the repository that stores them.
    }
  }
} with {
  briefly "Confines all target-awareness to one context"
  described as {
    |Everything upstream and downstream of Planning is target-agnostic.
    |SelectParadigm and LowerDefinition are the two functions the boundary
    |handler calls to plan a definition; Planning is aggregate-free, so
    |that handler does the work directly rather than relaying to an
    |entity that does not exist here. The catalogue and profiles they
    |consult are populated through this context's own Persist commands.
  }
}
