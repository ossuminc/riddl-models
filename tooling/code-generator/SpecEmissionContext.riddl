context SpecEmission as sink is {
  command EmitSpecs is {
    specRunId: Intake.GenerationRunId with {
      briefly "Run"
      described as {
        |The generation run this suite is emitted for.
      }
    }
    specSubject: ModelRef with {
      briefly "Model"
      described as {
        |The model the emitted suite is derived from.
      }
    }
  } with {
    briefly "Emit the derived test suite"
    described as {
      |Requests that the suite derived from specSubject be written out. No
      |yields: this context has no aggregate, so nothing records new entity
      |state.
    }
  }
  command DiscardSpecs is {
    specRunId: Intake.GenerationRunId with {
      briefly "Run"
      described as {
        |The generation run whose emitted suite is to be discarded.
      }
    }
  } with {
    briefly "Discard the emitted suite"
    described as {
      |Compensates EmitSpecs: forgets whatever suite specRunId previously
      |produced.
    }
  }
  type SpecEmissionCommand is one of {
    SpecEmission.EmitSpecs or SpecEmission.DiscardSpecs
  } with {
    briefly "SpecEmission command alternation"
    described as {
      |Commands accepted at the SpecEmission boundary.
    }
  }
  inlet SpecEmissionCommandsIn is type SpecEmissionCommand with {
    briefly "SpecEmission command intake"
    described as {
      |Where peers deliver commands for SpecEmission.
    }
  }
  handler SpecEmissionBoundary is {
    on command EmitSpecs is {
      do "emit, for specSubject, the test suite that acceptance-checks the
         CM aspects a conforming generator must preserve: definitional
         semantics, message contracts, state-machine shape, concurrency
         boundaries, persistence obligations, error handling, saga
         compensation, and the generability bar itself"
    }
    on command DiscardSpecs is {
      do "discard whatever suite specRunId previously emitted"
    }
    on other is {
      error "Unexpected message at the SpecEmission boundary"
    }
  } with {
    briefly "Context boundary and emitter"
    described as {
      |Nothing inside needs routing to, so the boundary handler does the
      |emission work directly rather than forwarding it. The CM aspects
      |this emission holds the generated code to are stated here because
      |they are this handler's acceptance criteria.
    }
  }
} with {
  briefly "Emission of the derived test suite"
  described as {
    |Emits the suite derived from the model: what the generated code must
    |do, stated before anything does it. The suite is NECESSARILY RED on
    |emission — it asserts behaviour that only hole filling supplies — and
    |that is the design rather than a regression. It is why the two
    |emissions are separate contexts with different acceptance: the pass-1
    |gate cannot assert behaviour, and this is what it would have asserted.
  }
}
