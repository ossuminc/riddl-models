event-sourced entity Artifact as split is {
  type ArtifactEvent is one of {
    Artifact.ArtifactPlanned or Artifact.ArtifactEmitted or Artifact.ArtifactFilled or Artifact.ArtifactVerified
  } with {
    briefly "Artifact event alternation"
    described as {
      |Events published by the Artifact entity.
    }
  }
  inlet ArtifactCommands is type CodeEmission.ArtifactCommand with {
    briefly "Commands routed to this artifact"
    described as {
      |Commands relayed from the CodeEmission boundary.
    }
  }
  outlet ArtifactEvents is type ArtifactEvent
 with {
    briefly "Events this artifact publishes"
    described as {
      |Lifecycle events, consumed by the projection that persists them.
    }
  }
  outlet ArtifactDecisions is command CodeEmission.DecisionLog.PersistDecision
 with {
    briefly "Decisions this artifact records"
    described as {
      |Where a non-obvious emission choice is published toward the
      |decision log, sent from the same on-event clause that applies
      |ArtifactEmitted on replay — GenerationRun's events are sent from
      |on-event clauses too. What sets DecisionLog apart is being written
      |directly rather than through the persistence projection, not when
      |in the handler chain it is sent.
    }
  }
  command PlanArtifact yields event ArtifactPlanned is {
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact being planned.
      }
    }
    artifactPath: String(1,1024) with {
      briefly "Path"
      described as {
        |The file path this artifact will occupy.
      }
    }
    artifactParadigm: Paradigm with {
      briefly "Paradigm"
      described as {
        |The paradigm Planning selected for this artifact's definition.
      }
    }
  } with {
    briefly "Plan an artifact"
    described as {
      |Begins an artifact against a planned path and paradigm, before
      |anything has been emitted.
    }
  }
  command EmitArtifact yields event ArtifactEmitted is {
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact being emitted.
      }
    }
    openHoleCount: Natural with {
      briefly "Holes"
      described as {
        |How many [[AI FILL]] holes this emission created.
      }
    }
    decisionSubject: String(1,256) with {
      briefly "Subject"
      described as {
        |What the non-obvious choice made during this emission was about.
      }
    }
    decisionRationale: String(1,2048) with {
      briefly "Rationale"
      described as {
        |Why that choice was made.
      }
    }
  } with {
    briefly "Emit framework and structure"
    described as {
      |Requests that the derivable framework, structure and headers be
      |written for artifactPath, marking what cannot be derived.
    }
  }
  command FillArtifact yields event ArtifactFilled is {
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact being filled.
      }
    }
    openHoleCount: Natural with {
      briefly "Holes"
      described as {
        |How many [[AI FILL]] holes remain open after this fill pass.
      }
    }
  } with {
    briefly "Fill open holes"
    described as {
      |Records the result of a fill pass over HoleFilling's holes for this
      |artifact. openHoleCount reaching zero is the retry cycle's
      |terminating condition (spec §4.8).
    }
  }
  command VerifyArtifact yields event ArtifactVerified is {
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact being verified.
      }
    }
  } with {
    briefly "Verify the artifact"
    described as {
      |Records that Proving accepted this artifact.
    }
  }
  event ArtifactPlanned is {
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact that came into existence.
      }
    }
    artifactPath: String(1,1024) with {
      briefly "Path"
      described as {
        |The file path it will occupy.
      }
    }
    artifactParadigm: Paradigm with {
      briefly "Paradigm"
      described as {
        |The paradigm it will be emitted in.
      }
    }
  } with {
    briefly "Artifact planned"
    described as {
      |A file was planned; nothing has been written yet.
    }
  }
  event ArtifactEmitted is {
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact emitted.
      }
    }
    openHoleCount: Natural with {
      briefly "Holes"
      described as {
        |The number of [[AI FILL]] holes this emission created.
      }
    }
    decisionSubject: String(1,256) with {
      briefly "Subject"
      described as {
        |What the recorded decision was about.
      }
    }
    decisionRationale: String(1,2048) with {
      briefly "Rationale"
      described as {
        |Why the decision was made.
      }
    }
  } with {
    briefly "Artifact emitted"
    described as {
      |Framework, structure and headers were written; holes remain where
      |nothing could be derived.
    }
  }
  event ArtifactFilled is {
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact filled.
      }
    }
    openHoleCount: Natural with {
      briefly "Holes"
      described as {
        |Holes still open after this fill pass.
      }
    }
  } with {
    briefly "Artifact filled"
    described as {
      |A fill pass completed. HoleFilling consumes this to decide whether
      |another pass is owed.
    }
  }
  event ArtifactVerified is {
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact verified.
      }
    }
  } with {
    briefly "Artifact verified"
    described as {
      |Proving accepted this artifact. Terminal.
    }
  }
  record ArtifactData is {
    artifactId: ArtifactId with {
      briefly "Artifact"
      described as {
        |The artifact this state belongs to, carried through every state so
        |the record can be rebuilt by replaying the event log.
      }
    }
    artifactPath: String(1,1024) with {
      briefly "Path"
      described as {
        |The file path this artifact occupies.
      }
    }
    artifactParadigm: Paradigm with {
      briefly "Paradigm"
      described as {
        |The paradigm this artifact is emitted in.
      }
    }
    openHoleCount: Natural with {
      briefly "Holes"
      described as {
        |How many [[AI FILL]] holes remain open. Reaching zero is the
        |retry cycle's terminating condition (spec §4.8).
      }
    }
  } with {
    briefly "Artifact state data"
    described as {
      |Full state of an artifact, shared across all its states.
    }
  }
  initial state Planned of record Artifact.ArtifactData is {
    initial handler PlannedInit is {
      on init is {
        let creation: type ArtifactPlanned = prompt("the artifact planned that brings this artifact into existence")
        yield creation
      }
    } with {
      briefly "Planned init handler"
      described as {
        |Brings the artifact into existence by yielding its entering event.
      }
    }
    handler PlannedHandler is {
      on command PlanArtifact is {
        yield event ArtifactPlanned(artifactId = PlanArtifact.artifactId, artifactPath = PlanArtifact.artifactPath, artifactParadigm = PlanArtifact.artifactParadigm)
      }
      on plannedEvent: event ArtifactPlanned is {
        send plannedEvent to outlet CodeEmission.Artifact.ArtifactEvents
      }
      on command EmitArtifact is {
        do "emit, for artifactPath, the framework and structure derivable
           from the plan: signatures, imports and the file skeleton,
           marking every non-derivable choice with an [[AI FILL]] hole,
           and prefix the artifact with the nearest enclosing scope's
           copyright header, verbatim, written in EmitArtifact's target
           comment syntax"
        yield event ArtifactEmitted(artifactId = EmitArtifact.artifactId, openHoleCount = EmitArtifact.openHoleCount, decisionSubject = EmitArtifact.decisionSubject, decisionRationale = EmitArtifact.decisionRationale)
      }
      on emittedEvent: event ArtifactEmitted is {
        send emittedEvent to outlet CodeEmission.Artifact.ArtifactEvents
        send command CodeEmission.DecisionLog.PersistDecision(decisionArtifactId = emittedEvent.artifactId, decisionSubject = emittedEvent.decisionSubject, decisionRationale = emittedEvent.decisionRationale) to outlet CodeEmission.Artifact.ArtifactDecisions
        morph entity CodeEmission.Artifact to state CodeEmission.Artifact.Emitted with record Artifact.ArtifactData(artifactId = emittedEvent.artifactId, artifactPath = ArtifactData.artifactPath, artifactParadigm = ArtifactData.artifactParadigm, openHoleCount = emittedEvent.openHoleCount)
      }
      on other is {
        error "Unexpected message for Artifact while Planned"
      }
    } with {
      briefly "Planned state handler"
      described as {
        |Emits framework, structure and headers, recording the decision
        |behind any non-obvious choice, then advances to Emitted.
      }
    }
  } with {
    briefly "Planned state"
    described as {
      |A path and paradigm are known. Nothing has been written yet.
    }
  }
  state Emitted of record Artifact.ArtifactData is {
    initial handler EmittedInit is {
      on init is {
        let entering: type ArtifactEmitted = prompt("the artifact emitted that enters this state")
        yield entering
      }
    } with {
      briefly "Emitted init handler"
      described as {
        |Enters the emitted state.
      }
    }
    handler EmittedHandler is {
      on command FillArtifact is {
        yield event ArtifactFilled(artifactId = FillArtifact.artifactId, openHoleCount = FillArtifact.openHoleCount)
      }
      on filledEvent: event ArtifactFilled is {
        send filledEvent to outlet CodeEmission.Artifact.ArtifactEvents
        morph entity CodeEmission.Artifact to state CodeEmission.Artifact.Filled with record Artifact.ArtifactData(artifactId = filledEvent.artifactId, artifactPath = ArtifactData.artifactPath, artifactParadigm = ArtifactData.artifactParadigm, openHoleCount = filledEvent.openHoleCount)
      }
      on other is {
        error "Unexpected message for Artifact while Emitted"
      }
    } with {
      briefly "Emitted state handler"
      described as {
        |Waits for a fill pass over this artifact's open holes.
      }
    }
  } with {
    briefly "Emitted state"
    described as {
      |Framework, structure and headers are written. Holes remain.
    }
  }
  state Filled of record Artifact.ArtifactData is {
    initial handler FilledInit is {
      on init is {
        let entering: type ArtifactFilled = prompt("the artifact filled that enters this state")
        yield entering
      }
    } with {
      briefly "Filled init handler"
      described as {
        |Enters the filled state.
      }
    }
    handler FilledHandler is {
      on command VerifyArtifact is {
        yield event ArtifactVerified(artifactId = VerifyArtifact.artifactId)
      }
      on verifiedEvent: event ArtifactVerified is {
        send verifiedEvent to outlet CodeEmission.Artifact.ArtifactEvents
        morph entity CodeEmission.Artifact to state CodeEmission.Artifact.Verified with record Artifact.ArtifactData(artifactId = verifiedEvent.artifactId, artifactPath = ArtifactData.artifactPath, artifactParadigm = ArtifactData.artifactParadigm, openHoleCount = ArtifactData.openHoleCount)
      }
      on other is {
        error "Unexpected message for Artifact while Filled"
      }
    } with {
      briefly "Filled state handler"
      described as {
        |Waits for Proving to verify this artifact. A fill pass that does
        |not reach zero open holes returns here via HoleFilling's retry
        |cycle rather than through this entity's own states.
      }
    }
  } with {
    briefly "Filled state"
    described as {
      |A fill pass completed. Verification has not yet run.
    }
  }
  state Verified of record Artifact.ArtifactData is {
    initial handler VerifiedInit is {
      on init is {
        let entering: type ArtifactVerified = prompt("the artifact verified that enters this state")
        yield entering
      }
    } with {
      briefly "Verified init handler"
      described as {
        |Enters the verified state.
      }
    }
    handler VerifiedHandler is {
      on other is {
        error "An artifact that has been verified accepts no further commands"
      }
    } with {
      briefly "Verified state handler"
      described as {
        |Terminal. Proving accepted this artifact.
      }
    }
  } with {
    briefly "Verified state"
    described as {
      |Proving accepted the artifact. Nothing further happens to it.
    }
  }
} with {
  briefly "One generated file, moving from plan to proof"
  described as {
    |A file identified by path, carrying the framework and structure
    |emission produced for it, the holes still open in it, and whether it
    |has been verified. Planned -> Emitted -> Filled -> Verified.
  }
}
