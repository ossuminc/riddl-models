*.class
*.log

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# sbt build artifacts
target/
project/target/
project/project/

# IDE and tool artifacts
.idea/
.bsp/
*.iml

# Synapify editor metadata (project.json, diagram layouts). Written beside a
# model's entry point deliberately, so layouts travel with the model -- which
# means they land in this repo whenever a model here is opened in Synapify.
.synapify/

# Cached riddlc binary (downloaded by sbt task)
.riddlc/

# OS artifacts
.DS_Store
/task/

# Claude Code transient files
.claude/*
!.claude/skills/
!.claude/skills/**

# Python bytecode
__pycache__/
*.pyc
