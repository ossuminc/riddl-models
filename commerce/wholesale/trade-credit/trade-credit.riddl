// Trade Credit Domain Model
// Wholesale credit management, terms, and collections
domain TradeCredit is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user CreditManager is "staff managing customer credit" with {
    briefly "Credit manager"
    described as {
      |Staff responsible for credit decisions.
    }
  }
  user CollectionsAgent is "staff handling overdue accounts" with {
    briefly "Collections agent"
    described as {
      |Staff managing payment collections.
    }
  }
  epic CreditApplicationEpic is {
    user CreditManager wants to "to evaluate credit applications" so that "qualified customers can receive trade credit"
    case EvaluateCreditApplication is {
      user CreditManager wants to "to assess a customer's creditworthiness" so that "appropriate credit terms can be offered"
      step is "Manager reviews application" "with financial statements" "and references" with {
        briefly "Review app"
        described as {
          |Manager reviews credit application.
        }
      }
      step is "System checks credit bureau" "for credit history" "and score" with {
        briefly "Credit check"
        described as {
          |System retrieves credit data.
        }
      }
      step take input TradeCreditApp.TradeCreditScreen.ApproveCreditInput from user CreditManager with {
        briefly "Approve credit"
        described as {
          |Send approval decision.
        }
      }
      step is "System notifies customer" "of credit terms" "and limit" with {
        briefly "Notify customer"
        described as {
          |System sends approval notice.
        }
      }
    } with {
      briefly "Credit application evaluation"
      described as {
        |Standard flow for reviewing credit requests.
      }
    }
  } with {
    briefly "Credit application processing"
    described as {
      | Epic covering the credit application workflow from submission
      | through evaluation and approval.
    }
  }
  include "CreditContext.riddl"
  include "external-contexts.riddl"
  application context TradeCreditApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in TradeCredit are delivered.
      }
    }
    group TradeCreditScreen is {
      input ApproveCreditInput acquires command CreditContext.CreditAccount.ApproveCredit with {
        briefly "Approve credit control"
        described as {
          |The control through which a user submits the approve credit request.
        }
      }
    } with {
      briefly "Trade credit screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppCreditAccountCommands is type CreditContext.CreditAccount.CreditAccountCommand
    inlet AppCreditRepositoryResponses is type CreditContext.CreditAccount.CreditAccountResult    handler TradeCreditAppHandler is {
      on other is {
        error "Unexpected message for application context TradeCreditApp"
      }
    } with {
      briefly "TradeCreditApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "TradeCreditApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'CreditAccountCommand Stream' is from outlet TradeCreditApp.AppCreditAccountCommands to inlet CreditContext.CreditAccount.CreditAccountCommands with {
    briefly "CreditAccount commands from the application"
  }
  persistent connector 'CreditAccountResult Stream' is from outlet CreditContext.CreditRepository.CreditRepositoryResponses to inlet TradeCreditApp.AppCreditRepositoryResponses with {
    briefly "Credit query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet TradeCreditApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Trade credit management domain"
  described as {
    | The TradeCredit domain handles wholesale credit operations
    | including applications, limits, invoicing, and collections.
  }
}
