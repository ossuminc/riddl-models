// Trade Credit - Credit Context
context CreditContext as router is {
  inlet CreditAccountCommandStreamIn is type CreditAccountCommand  outlet CreditAccountCommandStreamOut is type CreditAccountCommand
  inlet CreditAccountResultStreamIn is result CreditAccount.CreditAccountResult  outlet CreditAccountResultStreamOut is result CreditAccount.CreditAccountResult
  handler CreditContextBoundary is {
    on applyForCredit: command CreditAccount.ApplyForCredit is {
      send applyForCredit to outlet CreditContext.CreditAccountCommandStreamOut
    }
    on approveCredit: command CreditAccount.ApproveCredit is {
      send approveCredit to outlet CreditContext.CreditAccountCommandStreamOut
    }
    on denyCredit: command CreditAccount.DenyCredit is {
      send denyCredit to outlet CreditContext.CreditAccountCommandStreamOut
    }
    on postInvoice: command CreditAccount.PostInvoice is {
      send postInvoice to outlet CreditContext.CreditAccountCommandStreamOut
    }
    on applyPayment: command CreditAccount.ApplyPayment is {
      send applyPayment to outlet CreditContext.CreditAccountCommandStreamOut
    }
    on adjustCreditLimit: command CreditAccount.AdjustCreditLimit is {
      send adjustCreditLimit to outlet CreditContext.CreditAccountCommandStreamOut
    }
    on suspendAccount: command CreditAccount.SuspendAccount is {
      send suspendAccount to outlet CreditContext.CreditAccountCommandStreamOut
    }
    on reinstateAccount: command CreditAccount.ReinstateAccount is {
      send reinstateAccount to outlet CreditContext.CreditAccountCommandStreamOut
    }
    on recordCollectionAction: command CreditAccount.RecordCollectionAction is {
      send recordCollectionAction to outlet CreditContext.CreditAccountCommandStreamOut
    }
    on creditAccountResult: result CreditAccount.CreditAccountResult is {
      send creditAccountResult to outlet CreditContext.CreditAccountResultStreamOut
    }
    on other is {
      error "Unexpected message at the CreditContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CreditAccountCommand Stream Intake' is from outlet CreditContext.CreditAccountCommandStreamOut to inlet CreditContext.CreditAccount.CreditAccountCommands  connector 'CreditAccountResult Stream Egress' is from outlet CreditContext.CreditRepository.CreditRepositoryResponses to inlet CreditContext.CreditAccountResultStreamIn  adaptor FromCreditBureauService from context CreditBureauService is { 
    handler FromCreditBureauServiceHandler is {
      on event CreditBureauService.CreditReportReceived is {
        do "the model receives credit report received"
      }
      on other is {
        error "Unexpected message for adaptor FromCreditBureauService"
      }
    } with {
      briefly "from credit bureau service"
      described as {
        |Carries messages from the external CreditBureauService.
      }
    }
  } with {
    briefly "CreditBureauService integration"
    described as {
      |The model's side of the CreditBureauService conversation.
    }
  }
  adaptor FromLegalService from context LegalService is { 
    handler FromLegalServiceHandler is {
      on event LegalService.CollectionsEscalated is {
        do "the model receives collections escalated"
      }
      on other is {
        error "Unexpected message for adaptor FromLegalService"
      }
    } with {
      briefly "from legal service"
      described as {
        |Carries messages from the external LegalService.
      }
    }
  } with {
    briefly "LegalService integration"
    described as {
      |The model's side of the LegalService conversation.
    }
  }
  adaptor ToLegalService to context LegalService is { 
    handler ToLegalServiceHandler is {
      on command LegalService.EscalateToCollections is {
        do "the model sends escalate to collections"
      }
      on other is {
        error "Unexpected message for adaptor ToLegalService"
      }
    } with {
      briefly "to legal service"
      described as {
        |Carries messages to the external LegalService.
      }
    }
  } with {
    briefly "LegalService integration"
    described as {
      |The model's side of the LegalService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NoticeSent is {
        do "the model receives notice sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendCollectionLetter is {
        do "the model sends send collection letter"
      }
      on command NotificationService.SendCreditNotice is {
        do "the model sends send credit notice"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "CreditAccount.riddl"
  // Adaptors for external system integration
  adaptor CreditBureauAdapter to context CreditBureauService is { 
    handler CreditChecks is {
      on command CreditBureauService.RequestCreditReport is {
        do "Request credit bureau report"
      }
      on other is {
        error "Unexpected message for adaptor CreditBureauAdapter"
      }
    } with {
      briefly "Handles credit checks"
      described as {
        |Requests credit reports for applications.
      }
    }
  } with {
    briefly "Credit bureau integration"
    described as {
      |Integrates with credit bureaus.
    }
  }
  adaptor OrderAdapter from context OrderService is { 
    handler OrderEvents is {
      on event OrderService.OrderShipped is {
        do "Post invoice to credit account"
      }
      on other is {
        error "Unexpected message for adaptor OrderAdapter"
      }
    } with {
      briefly "Handles order events"
      described as {
        |Creates invoices from shipped orders.
      }
    }
  } with {
    briefly "Order integration"
    described as {
      |Receives order events for invoicing.
    }
  }
  adaptor PaymentAdapter from context PaymentService is { 
    handler PaymentEvents is {
      on event PaymentService.PaymentReceived is {
        do "Apply payment to credit account"
      }
      on other is {
        error "Unexpected message for adaptor PaymentAdapter"
      }
    } with {
      briefly "Handles payment events"
      described as {
        |Processes payments on account.
      }
    }
  } with {
    briefly "Payment integration"
    described as {
      |Receives payment notifications.
    }
  }
  // Repository for credit persistence
  type CreditRepositoryCommand is one of {
    CreditContext.CreditRepository.PersistAccountReinstated or CreditContext.CreditRepository.PersistAccountSuspended or CreditContext.CreditRepository.PersistCollectionActionRecorded or CreditContext.CreditRepository.PersistCreditApplied or CreditContext.CreditRepository.PersistCreditApproved or CreditContext.CreditRepository.PersistCreditDenied or CreditContext.CreditRepository.PersistCreditLimitAdjusted or CreditContext.CreditRepository.PersistInvoicePosted or CreditContext.CreditRepository.PersistPaymentApplied
  } with {
    briefly "Anything that writes CreditRepository"
    described as {
      |The persistence commands CreditRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository CreditRepository as flow is {
    inlet CreditRepositoryFromCreditAnalytics is type CreditRepositoryCommand    command PersistAccountReinstated is {
      creditAccountId: CreditAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountReinstated applies to.
        }
      }
    } with {
      briefly "Persist AccountReinstated"
      described as {
        |Instructs this repository to apply AccountReinstated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountSuspended is {
      creditAccountId: CreditAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row AccountSuspended applies to.
        }
      }
    } with {
      briefly "Persist AccountSuspended"
      described as {
        |Instructs this repository to apply AccountSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCollectionActionRecorded is {
      creditAccountId: CreditAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row CollectionActionRecorded applies to.
        }
      }
    } with {
      briefly "Persist CollectionActionRecorded"
      described as {
        |Instructs this repository to apply CollectionActionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCreditApplied is {
      creditAccountId: CreditAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row CreditApplied applies to.
        }
      }
    } with {
      briefly "Persist CreditApplied"
      described as {
        |Instructs this repository to apply CreditApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCreditApproved is {
      creditAccountId: CreditAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row CreditApproved applies to.
        }
      }
    } with {
      briefly "Persist CreditApproved"
      described as {
        |Instructs this repository to apply CreditApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCreditDenied is {
      creditAccountId: CreditAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row CreditDenied applies to.
        }
      }
    } with {
      briefly "Persist CreditDenied"
      described as {
        |Instructs this repository to apply CreditDenied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCreditLimitAdjusted is {
      creditAccountId: CreditAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row CreditLimitAdjusted applies to.
        }
      }
    } with {
      briefly "Persist CreditLimitAdjusted"
      described as {
        |Instructs this repository to apply CreditLimitAdjusted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInvoicePosted is {
      creditAccountId: CreditAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row InvoicePosted applies to.
        }
      }
    } with {
      briefly "Persist InvoicePosted"
      described as {
        |Instructs this repository to apply InvoicePosted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentApplied is {
      creditAccountId: CreditAccountId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentApplied applies to.
        }
      }
    } with {
      briefly "Persist PaymentApplied"
      described as {
        |Instructs this repository to apply PaymentApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet CreditRepositoryResponses is result CreditAccount.CreditAccountResult
    record StoredCreditAccount is {
      creditAccountId: CreditAccountId with {
        briefly "creditAccountId"
        described as {
          |The creditAccountId column of the stored creditAccount row.
        }
      }
      customerId: CustomerId with {
        briefly "customerId"
        described as {
          |The customerId column of the stored creditAccount row.
        }
      }
    } with {
      briefly "Stored creditAccount row"
      described as {
        |The persistence shape of creditAccount data as this repository stores it.
      }
    }
    schema CreditData is relational
      of accounts as record StoredCreditAccount
        index on field StoredCreditAccount.customerId
        index on field StoredCreditAccount.creditAccountId
 with {
      briefly "Credit data schema"
      described as {
        |The relational schema holding credit data for the CreditRepository.
      }
    }
    handler CreditPersistence is {
      on persistAccountReinstated: command PersistAccountReinstated is {
        do "apply AccountReinstated to the stored row"
      }
      on persistAccountSuspended: command PersistAccountSuspended is {
        do "apply AccountSuspended to the stored row"
      }
      on persistCollectionActionRecorded: command PersistCollectionActionRecorded is {
        do "apply CollectionActionRecorded to the stored row"
      }
      on persistCreditApplied: command PersistCreditApplied is {
        do "apply CreditApplied to the stored row"
      }
      on persistCreditApproved: command PersistCreditApproved is {
        do "apply CreditApproved to the stored row"
      }
      on persistCreditDenied: command PersistCreditDenied is {
        do "apply CreditDenied to the stored row"
      }
      on persistCreditLimitAdjusted: command PersistCreditLimitAdjusted is {
        do "apply CreditLimitAdjusted to the stored row"
      }
      on persistInvoicePosted: command PersistInvoicePosted is {
        do "apply InvoicePosted to the stored row"
      }
      on persistPaymentApplied: command PersistPaymentApplied is {
        do "apply PaymentApplied to the stored row"
      }
      on query GetAgingReport is {
        let agingReportView: type AgingReportView = prompt("read the aging report projection")
        reply agingReportView
      }
    } with {
      briefly "Persists credit commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Credit data persistence"
    described as {
      | The CreditRepository provides persistent storage for
      | credit accounts and invoices.
    }
  }
  // Projector for credit analytics
  query GetAgingReport replies result AgingReportView is {
    agingReportKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which aging report to retrieve.
      }
    }
  } with {
    briefly "Get aging report"
    described as {
      |Retrieves the aging report projection.
    }
  }
  result AgingReportView is {
    agingReport: CreditAnalytics.AgingReport with {
      briefly "Aging report"
      described as {
        |The aging report being returned.
      }
    }
  } with {
    briefly "Aging report view"
    described as {
      |Read model view carrying the aging report projection.
    }
  }
  projector CreditAnalytics as flow is {
    updates repository CreditContext.CreditRepository
    outlet CreditAnalyticsToRepository is type CreditRepositoryCommand
    inlet CreditAnalyticsFromCreditAccount is type CreditAccountEvent    record AgingReport is {
      customerId: CustomerId with {
        briefly "Customer"
        described as {
          |Customer ID.
        }
      }
      current: Money with {
        briefly "Current"
        described as {
          |Current balance.
        }
      }
      thirtyDays: Money with {
        briefly "30 days"
        described as {
          |31-60 days.
        }
      }
      sixtyDays: Money with {
        briefly "60 days"
        described as {
          |61-90 days.
        }
      }
      ninetyPlus: Money with {
        briefly "90+ days"
        described as {
          |Over 90 days.
        }
      }
    } with {
      briefly "Aging report"
      described as {
        |Accounts receivable aging.
      }
    }
    handler AnalyticsHandler is {
      on accountReinstated: event CreditAccount.AccountReinstated is {
        tell command CreditContext.CreditRepository.PersistAccountReinstated(creditAccountId = accountReinstated.creditAccountId) to repository CreditContext.CreditRepository
        do "apply AccountReinstated to the CreditAnalytics projection"
      }
      on accountSuspended: event CreditAccount.AccountSuspended is {
        tell command CreditContext.CreditRepository.PersistAccountSuspended(creditAccountId = accountSuspended.creditAccountId) to repository CreditContext.CreditRepository
        do "apply AccountSuspended to the CreditAnalytics projection"
      }
      on collectionActionRecorded: event CreditAccount.CollectionActionRecorded is {
        tell command CreditContext.CreditRepository.PersistCollectionActionRecorded(creditAccountId = collectionActionRecorded.creditAccountId) to repository CreditContext.CreditRepository
        do "apply CollectionActionRecorded to the CreditAnalytics projection"
      }
      on creditApplied: event CreditAccount.CreditApplied is {
        tell command CreditContext.CreditRepository.PersistCreditApplied(creditAccountId = creditApplied.creditAccountId) to repository CreditContext.CreditRepository
        do "apply CreditApplied to the CreditAnalytics projection"
      }
      on creditApproved: event CreditAccount.CreditApproved is {
        tell command CreditContext.CreditRepository.PersistCreditApproved(creditAccountId = creditApproved.creditAccountId) to repository CreditContext.CreditRepository
        do "apply CreditApproved to the CreditAnalytics projection"
      }
      on creditDenied: event CreditAccount.CreditDenied is {
        tell command CreditContext.CreditRepository.PersistCreditDenied(creditAccountId = creditDenied.creditAccountId) to repository CreditContext.CreditRepository
        do "apply CreditDenied to the CreditAnalytics projection"
      }
      on creditLimitAdjusted: event CreditAccount.CreditLimitAdjusted is {
        tell command CreditContext.CreditRepository.PersistCreditLimitAdjusted(creditAccountId = creditLimitAdjusted.creditAccountId) to repository CreditContext.CreditRepository
        do "apply CreditLimitAdjusted to the CreditAnalytics projection"
      }
      on invoicePosted: event CreditAccount.InvoicePosted is {
        tell command CreditContext.CreditRepository.PersistInvoicePosted(creditAccountId = invoicePosted.creditAccountId) to repository CreditContext.CreditRepository
        do "Update aging report"
      }
      on paymentApplied: event CreditAccount.PaymentApplied is {
        tell command CreditContext.CreditRepository.PersistPaymentApplied(creditAccountId = paymentApplied.creditAccountId) to repository CreditContext.CreditRepository
        do "Update aging report"
      }
    } with {
      briefly "Maintains analytics views"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Credit analytics projections"
    described as {
      |Maintains credit analytics data.
    }
  }
  // ---- Event publication for CreditAccount ----
  type CreditAccountEvent is one of {
    CreditContext.CreditAccount.CreditApplied or CreditContext.CreditAccount.CreditApproved or CreditContext.CreditAccount.CreditDenied or CreditContext.CreditAccount.InvoicePosted or CreditContext.CreditAccount.PaymentApplied or CreditContext.CreditAccount.CreditLimitAdjusted or CreditContext.CreditAccount.AccountSuspended or CreditContext.CreditAccount.AccountReinstated or CreditContext.CreditAccount.CollectionActionRecorded
  } with {
    briefly "CreditAccount event alternation"
    described as {
      |Union of all CreditAccount events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet CreditAccountEventSplit as flow is {
    inlet CreditAccountEventSplitIn is type CreditAccountEvent    outlet CreditAccountEventSplitToCreditAnalytics is type CreditAccountEvent
    handler CreditAccountEventSplitHandler is {
      on creditApplied: event CreditAccount.CreditApplied is {
        send creditApplied to outlet CreditAccountEventSplitToCreditAnalytics
        tell creditApplied to entity CreditContext.CreditAccount
      }
      on creditApproved: event CreditAccount.CreditApproved is {
        send creditApproved to outlet CreditAccountEventSplitToCreditAnalytics
        tell creditApproved to entity CreditContext.CreditAccount
      }
      on creditDenied: event CreditAccount.CreditDenied is {
        send creditDenied to outlet CreditAccountEventSplitToCreditAnalytics
        tell creditDenied to entity CreditContext.CreditAccount
      }
      on invoicePosted: event CreditAccount.InvoicePosted is {
        send invoicePosted to outlet CreditAccountEventSplitToCreditAnalytics
        tell invoicePosted to entity CreditContext.CreditAccount
      }
      on paymentApplied: event CreditAccount.PaymentApplied is {
        send paymentApplied to outlet CreditAccountEventSplitToCreditAnalytics
        tell paymentApplied to entity CreditContext.CreditAccount
      }
      on creditLimitAdjusted: event CreditAccount.CreditLimitAdjusted is {
        send creditLimitAdjusted to outlet CreditAccountEventSplitToCreditAnalytics
        tell creditLimitAdjusted to entity CreditContext.CreditAccount
      }
      on accountSuspended: event CreditAccount.AccountSuspended is {
        send accountSuspended to outlet CreditAccountEventSplitToCreditAnalytics
        tell accountSuspended to entity CreditContext.CreditAccount
      }
      on accountReinstated: event CreditAccount.AccountReinstated is {
        send accountReinstated to outlet CreditAccountEventSplitToCreditAnalytics
        tell accountReinstated to entity CreditContext.CreditAccount
      }
      on collectionActionRecorded: event CreditAccount.CollectionActionRecorded is {
        send collectionActionRecorded to outlet CreditAccountEventSplitToCreditAnalytics
        tell collectionActionRecorded to entity CreditContext.CreditAccount
      }
      on other is {
        error "Unexpected message for processor CreditAccountEventSplit"
      }
    } with {
      briefly "CreditAccount event fan-out handler"
      described as {
        |Delivers each CreditAccount event to all of its consumers.
      }
    }
  } with {
    briefly "CreditAccount event fan-out"
    described as {
      |Fans CreditAccount events out to the repository and projectors.
    }
  }
  connector 'CreditAccountEvent Stream' is from outlet CreditContext.CreditAccount.CreditAccountEvents2 to inlet CreditContext.CreditAccountEventSplit.CreditAccountEventSplitIn with {
    briefly "CreditAccount events, fanned out to storage and read models"
  }
  connector 'CreditAnalytics Feed' is from outlet CreditContext.CreditAccountEventSplit.CreditAccountEventSplitToCreditAnalytics to inlet CreditContext.CreditAnalytics.CreditAnalyticsFromCreditAccount with {
    briefly "CreditAccount events feeding the CreditAnalytics projection"
  }
  connector 'CreditAnalytics Storage' is from outlet CreditContext.CreditAnalytics.CreditAnalyticsToRepository to inlet CreditContext.CreditRepository.CreditRepositoryFromCreditAnalytics with {
    briefly "CreditAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for trade credit"
  described as {
    | The CreditContext is the bounded context for wholesale
    | credit management. It handles accounts, invoicing, and collections.
  }
}
