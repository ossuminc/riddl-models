// Trade Credit - Credit Context
context CreditContext is {
  adaptor FromCreditBureauService from context CreditBureauService is {
    handler FromCreditBureauServiceHandler is {
      on event CreditBureauService.CreditReportReceived is {
        do "the model receives credit report received"
      }
      on other is {
        error "Unexpected message for adaptor FromCreditBureauService"
      }
    } with {
      briefly "from credit bureau service"
      described as {
        |Carries messages from the external CreditBureauService.
      }
    }
  } with {
      briefly "CreditBureauService integration"
    described as {
      |The model's side of the CreditBureauService conversation.
    }
  }
  adaptor FromLegalService from context LegalService is {
    handler FromLegalServiceHandler is {
      on event LegalService.CollectionsEscalated is {
        do "the model receives collections escalated"
      }
      on other is {
        error "Unexpected message for adaptor FromLegalService"
      }
    } with {
      briefly "from legal service"
      described as {
        |Carries messages from the external LegalService.
      }
    }
  } with {
      briefly "LegalService integration"
    described as {
      |The model's side of the LegalService conversation.
    }
  }
  adaptor ToLegalService to context LegalService is {
    handler ToLegalServiceHandler is {
      on command LegalService.EscalateToCollections is {
        do "the model sends escalate to collections"
      }
      on other is {
        error "Unexpected message for adaptor ToLegalService"
      }
    } with {
      briefly "to legal service"
      described as {
        |Carries messages to the external LegalService.
      }
    }
  } with {
      briefly "LegalService integration"
    described as {
      |The model's side of the LegalService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is {
    handler FromNotificationServiceHandler is {
      on event NotificationService.NoticeSent is {
        do "the model receives notice sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is {
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendCollectionLetter is {
        do "the model sends send collection letter"
      }
      on command NotificationService.SendCreditNotice is {
        do "the model sends send credit notice"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "CreditAccount.riddl"
  // Adaptors for external system integration
  adaptor CreditBureauAdapter to context CreditBureauService is { 
    handler CreditChecks is {
      on command CreditBureauService.RequestCreditReport is {
        do "Request credit bureau report"
      }
      on other is {
        error "Unexpected message for adaptor CreditBureauAdapter"
      }
    } with {
      briefly "Handles credit checks"
      described as {
        |Requests credit reports for applications.
      }
    }
  } with {
    briefly "Credit bureau integration"
    described as {
      |Integrates with credit bureaus.
    }
  }
  adaptor OrderAdapter from context OrderService is { 
    handler OrderEvents is {
      on event OrderService.OrderShipped is {
        do "Post invoice to credit account"
      }
      on other is {
        error "Unexpected message for adaptor OrderAdapter"
      }
    } with {
      briefly "Handles order events"
      described as {
        |Creates invoices from shipped orders.
      }
    }
  } with {
    briefly "Order integration"
    described as {
      |Receives order events for invoicing.
    }
  }
  adaptor PaymentAdapter from context PaymentService is { 
    handler PaymentEvents is {
      on event PaymentService.PaymentReceived is {
        do "Apply payment to credit account"
      }
      on other is {
        error "Unexpected message for adaptor PaymentAdapter"
      }
    } with {
      briefly "Handles payment events"
      described as {
        |Processes payments on account.
      }
    }
  } with {
    briefly "Payment integration"
    described as {
      |Receives payment notifications.
    }
  }
  // Repository for credit persistence
  repository CreditRepository is {
    inlet CreditRepositoryFromCreditAccount is type CreditAccountEvent
    inlet CreditRepositoryFromCreditAnalytics is type CreditAccountEvent
    outlet CreditRepositoryResponses is type CreditAccount.CreditAccountResult
    record StoredCreditAccount is {
      creditAccountId: CreditAccountId with {
        briefly "creditAccountId"
        described as {
          |The creditAccountId column of the stored creditAccount row.
        }
      }
      customerId: CustomerId with {
        briefly "customerId"
        described as {
          |The customerId column of the stored creditAccount row.
        }
      }
    } with {
      briefly "Stored creditAccount row"
      described as {
        |The persistence shape of creditAccount data as this repository stores it.
      }
    }
    schema CreditData is relational
      of accounts as type StoredCreditAccount
        index on field StoredCreditAccount.customerId
        index on field StoredCreditAccount.creditAccountId
      with {
      briefly "Credit data schema"
      described as {
        |The relational schema holding credit data for the CreditRepository.
      }
    }

    handler CreditPersistence is {
      on command CreditAccount.ApplyForCredit is {
        do "Create pending credit application"
      }
      on command CreditAccount.ApproveCredit is {
        tell event CreditAccount.CreditApproved to entity CreditContext.CreditAccount
        do "Update account status to active"
      }
      on command CreditAccount.DenyCredit is {
        do "Update account status to denied"
      }
      on command CreditAccount.PostInvoice is {
        do "Record invoice and update balance"
      }
      on command CreditAccount.ApplyPayment is {
        do "Record payment and update balance"
      }
      on command CreditAccount.SuspendAccount is {
        tell event CreditAccount.AccountSuspended to entity CreditContext.CreditAccount
        do "Update account status to suspended"
      }
    } with {
      briefly "Persists credit commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Credit data persistence"
    described as {
      | The CreditRepository provides persistent storage for
      | credit accounts and invoices.
    }
  }
  // Projector for credit analytics
  projector CreditAnalytics is {
    inlet CreditAnalyticsFromCreditAccount is type CreditAccountEvent
    outlet CreditAnalyticsOut is type CreditAccountEvent
    updates repository CreditContext.CreditRepository
    record AgingReport is  {
      customerId: CustomerId with {
        briefly "Customer"
        described as {
          |Customer ID.
        }
      }
      current: Money with {
        briefly "Current"
        described as {
          |Current balance.
        }
      }
      thirtyDays: Money with {
        briefly "30 days"
        described as {
          |31-60 days.
        }
      }
      sixtyDays: Money with {
        briefly "60 days"
        described as {
          |61-90 days.
        }
      }
      ninetyPlus: Money with {
        briefly "90+ days"
        described as {
          |Over 90 days.
        }
      }
    } with {
      briefly "Aging report"
      described as {
        |Accounts receivable aging.
      }
    }
    handler AnalyticsHandler is {
      on event CreditAccount.InvoicePosted is {
        tell event CreditAccount.InvoicePosted to repository CreditContext.CreditRepository
        do "Update aging report"
      }
      on event CreditAccount.PaymentApplied is {
        tell event CreditAccount.PaymentApplied to repository CreditContext.CreditRepository
        do "Update aging report"
      }
    } with {
      briefly "Maintains analytics views"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Credit analytics projections"
    described as {
      |Maintains credit analytics data.
    }
  }
  // ---- Event publication for CreditAccount ----
  type CreditAccountEvent is one of {
    CreditContext.CreditAccount.CreditApplied,
    CreditContext.CreditAccount.CreditApproved,
    CreditContext.CreditAccount.CreditDenied,
    CreditContext.CreditAccount.InvoicePosted,
    CreditContext.CreditAccount.PaymentApplied,
    CreditContext.CreditAccount.CreditLimitAdjusted,
    CreditContext.CreditAccount.AccountSuspended,
    CreditContext.CreditAccount.AccountReinstated,
    CreditContext.CreditAccount.CollectionActionRecorded
  } with {
    briefly "CreditAccount event alternation"
    described as {
      |Union of all CreditAccount events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CreditAccountEventSource as source is {
    outlet CreditAccountEvents is type CreditAccountEvent
    handler CreditAccountSourceHandler is {
      on event CreditAccount.CreditApplied is {
        send event CreditAccount.CreditApplied to outlet CreditAccountEvents
      }
      on event CreditAccount.CreditApproved is {
        send event CreditAccount.CreditApproved to outlet CreditAccountEvents
      }
      on event CreditAccount.CreditDenied is {
        send event CreditAccount.CreditDenied to outlet CreditAccountEvents
      }
      on event CreditAccount.InvoicePosted is {
        send event CreditAccount.InvoicePosted to outlet CreditAccountEvents
      }
      on event CreditAccount.PaymentApplied is {
        send event CreditAccount.PaymentApplied to outlet CreditAccountEvents
      }
      on event CreditAccount.CreditLimitAdjusted is {
        send event CreditAccount.CreditLimitAdjusted to outlet CreditAccountEvents
      }
      on event CreditAccount.AccountSuspended is {
        send event CreditAccount.AccountSuspended to outlet CreditAccountEvents
      }
      on event CreditAccount.AccountReinstated is {
        send event CreditAccount.AccountReinstated to outlet CreditAccountEvents
      }
      on event CreditAccount.CollectionActionRecorded is {
        send event CreditAccount.CollectionActionRecorded to outlet CreditAccountEvents
      }
      on other is {
        error "Unexpected message for source CreditAccountEventSource"
      }
    } with {
      briefly "CreditAccount source handler"
      described as {
        |Publishes CreditAccount events onto the outlet.
      }
    }
  } with {
    briefly "CreditAccount event source"
    described as {
      |Publishes CreditAccount entity events into the streaming topology.
    }
  }
  processor CreditAccountEventSink as sink is {
    inlet CreditAccountInlet is type CreditAccountEvent
    handler CreditAccountSinkHandler is {
      on event CreditAccount.CreditApplied is {
        tell event CreditAccount.CreditApplied to repository CreditContext.CreditRepository
      }
      on event CreditAccount.CreditApproved is {
        tell event CreditAccount.CreditApproved to repository CreditContext.CreditRepository
      }
      on event CreditAccount.CreditDenied is {
        tell event CreditAccount.CreditDenied to repository CreditContext.CreditRepository
      }
      on event CreditAccount.InvoicePosted is {
        tell event CreditAccount.InvoicePosted to repository CreditContext.CreditRepository
      }
      on event CreditAccount.PaymentApplied is {
        tell event CreditAccount.PaymentApplied to repository CreditContext.CreditRepository
      }
      on event CreditAccount.CreditLimitAdjusted is {
        tell event CreditAccount.CreditLimitAdjusted to repository CreditContext.CreditRepository
      }
      on event CreditAccount.AccountSuspended is {
        tell event CreditAccount.AccountSuspended to repository CreditContext.CreditRepository
      }
      on event CreditAccount.AccountReinstated is {
        tell event CreditAccount.AccountReinstated to repository CreditContext.CreditRepository
      }
      on event CreditAccount.CollectionActionRecorded is {
        tell event CreditAccount.CollectionActionRecorded to repository CreditContext.CreditRepository
      }
      on other is {
        error "Unexpected message for sink CreditAccountEventSink"
      }
    } with {
      briefly "CreditAccount sink handler"
      described as {
        |Persists CreditAccount events via the repository.
      }
    }
  } with {
    briefly "CreditAccount event sink"
    described as {
      |Receives CreditAccount events for persistence.
    }
  }
  connector CreditAccountEventFlow is {
    from outlet CreditContext.CreditAccountEventSource.CreditAccountEvents to
      inlet CreditContext.CreditAccountEventSink.CreditAccountInlet
  } with {
    briefly "CreditAccount event flow"
    described as {
      |Connects the CreditAccount source to its sink.
    }
  }
  processor CreditAccountEventSplit is {
    inlet CreditAccountEventSplitIn is type CreditAccountEvent
    outlet CreditAccountEventSplitToCreditRepository is type CreditAccountEvent
    outlet CreditAccountEventSplitToCreditAnalytics is type CreditAccountEvent
    handler CreditAccountEventSplitHandler is {
      on event CreditAccount.CreditApplied is {
        send event CreditAccount.CreditApplied to outlet CreditAccountEventSplitToCreditRepository
        send event CreditAccount.CreditApplied to outlet CreditAccountEventSplitToCreditAnalytics
        tell event CreditAccount.CreditApplied to entity CreditContext.CreditAccount
      }
      on event CreditAccount.CreditApproved is {
        send event CreditAccount.CreditApproved to outlet CreditAccountEventSplitToCreditRepository
        send event CreditAccount.CreditApproved to outlet CreditAccountEventSplitToCreditAnalytics
        tell event CreditAccount.CreditApproved to entity CreditContext.CreditAccount
      }
      on event CreditAccount.CreditDenied is {
        send event CreditAccount.CreditDenied to outlet CreditAccountEventSplitToCreditRepository
        send event CreditAccount.CreditDenied to outlet CreditAccountEventSplitToCreditAnalytics
        tell event CreditAccount.CreditDenied to entity CreditContext.CreditAccount
      }
      on event CreditAccount.InvoicePosted is {
        send event CreditAccount.InvoicePosted to outlet CreditAccountEventSplitToCreditRepository
        send event CreditAccount.InvoicePosted to outlet CreditAccountEventSplitToCreditAnalytics
        tell event CreditAccount.InvoicePosted to entity CreditContext.CreditAccount
      }
      on event CreditAccount.PaymentApplied is {
        send event CreditAccount.PaymentApplied to outlet CreditAccountEventSplitToCreditRepository
        send event CreditAccount.PaymentApplied to outlet CreditAccountEventSplitToCreditAnalytics
        tell event CreditAccount.PaymentApplied to entity CreditContext.CreditAccount
      }
      on event CreditAccount.CreditLimitAdjusted is {
        send event CreditAccount.CreditLimitAdjusted to outlet CreditAccountEventSplitToCreditRepository
        send event CreditAccount.CreditLimitAdjusted to outlet CreditAccountEventSplitToCreditAnalytics
        tell event CreditAccount.CreditLimitAdjusted to entity CreditContext.CreditAccount
      }
      on event CreditAccount.AccountSuspended is {
        send event CreditAccount.AccountSuspended to outlet CreditAccountEventSplitToCreditRepository
        send event CreditAccount.AccountSuspended to outlet CreditAccountEventSplitToCreditAnalytics
        tell event CreditAccount.AccountSuspended to entity CreditContext.CreditAccount
      }
      on event CreditAccount.AccountReinstated is {
        send event CreditAccount.AccountReinstated to outlet CreditAccountEventSplitToCreditRepository
        send event CreditAccount.AccountReinstated to outlet CreditAccountEventSplitToCreditAnalytics
        tell event CreditAccount.AccountReinstated to entity CreditContext.CreditAccount
      }
      on event CreditAccount.CollectionActionRecorded is {
        send event CreditAccount.CollectionActionRecorded to outlet CreditAccountEventSplitToCreditRepository
        send event CreditAccount.CollectionActionRecorded to outlet CreditAccountEventSplitToCreditAnalytics
        tell event CreditAccount.CollectionActionRecorded to entity CreditContext.CreditAccount
      }
      on other is {
        error "Unexpected message for processor CreditAccountEventSplit"
      }
    } with {
      briefly "CreditAccount event fan-out handler"
      described as {
        |Delivers each CreditAccount event to all of its consumers.
      }
    }
  } with {
    briefly "CreditAccount event fan-out"
    described as {
      |Fans CreditAccount events out to the repository and projectors.
    }
  }
  connector LinkCreditAccountToCreditAccountEventSplit is {
    from outlet CreditContext.CreditAccount.CreditAccountEvents2 to
      inlet CreditContext.CreditAccountEventSplit.CreditAccountEventSplitIn
  } with {
    briefly "LinkCreditAccountToCreditAccountEventSplit"
  }
  connector LinkCreditAccountEventSplitToCreditRepository is {
    from outlet CreditContext.CreditAccountEventSplit.CreditAccountEventSplitToCreditRepository to
      inlet CreditContext.CreditRepository.CreditRepositoryFromCreditAccount
  } with {
    briefly "LinkCreditAccountEventSplitToCreditRepository"
  }
  connector LinkCreditAccountEventSplitToCreditAnalytics is {
    from outlet CreditContext.CreditAccountEventSplit.CreditAccountEventSplitToCreditAnalytics to
      inlet CreditContext.CreditAnalytics.CreditAnalyticsFromCreditAccount
  } with {
    briefly "LinkCreditAccountEventSplitToCreditAnalytics"
  }
  connector LinkCreditAnalyticsToCreditRepository is {
    from outlet CreditContext.CreditAnalytics.CreditAnalyticsOut to
      inlet CreditContext.CreditRepository.CreditRepositoryFromCreditAnalytics
  } with {
    briefly "LinkCreditAnalyticsToCreditRepository"
  }
} with {
  briefly "Bounded context for trade credit"
  described as {
    | The CreditContext is the bounded context for wholesale
    | credit management. It handles accounts, invoicing, and collections.
  }
}
