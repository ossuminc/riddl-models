// Distribution - DistributionOrder Entity
entity DistributionOrder as flow is {
  type DistributionOrderCommand is one of {
    DistributionOrder.CreateOrder or DistributionOrder.AllocateInventory or DistributionOrder.ConfirmOrder or DistributionOrder.ShipOrder or DistributionOrder.DeliverOrder or DistributionOrder.CancelOrder
  } with {
    briefly "DistributionOrder command alternation"
    described as {
      |Commands accepted by the DistributionOrder entity.
    }
  }
  inlet DistributionOrderCommands is type DistributionOrderCommand  outlet DistributionOrderEvents2 is type DistributionOrderEvent
  query GetDistributionOrder replies result DistributionOrderResult is {
    orderId: OrderId with {
      briefly "ID"
      described as {
        |Identifier of the DistributionOrder to retrieve.
      }
    }
  } with {
    briefly "Get DistributionOrder"
    described as {
      |Retrieve DistributionOrder data by identifier.
    }
  }
  result DistributionOrderResult is  {
    distributionOrderId: OrderId with {
      briefly "DistributionOrder addressed"
      described as {
        |Which distributionorder this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    distributionOrderData: DistributionOrder.PendingOrderData with {
      briefly "DistributionOrder data"
      described as {
        |The requested DistributionOrder data.
      }
    }
  } with {
    briefly "DistributionOrder result"
    described as {
      |Result carrying the requested DistributionOrder data.
    }
  }
  // Commands
  command CreateOrder is  {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Unique identifier.
      }
    }
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Ordering customer.
      }
    }
    lines: OrderLine+ with {
      briefly "Lines"
      described as {
        |Order line items.
      }
    }
    shippingAddress: ShippingAddress with {
      briefly "Shipping"
      described as {
        |Delivery address.
      }
    }
    pricingTier: PricingTier with {
      briefly "Pricing"
      described as {
        |Customer pricing tier.
      }
    }
  } with {
    briefly "Create distribution order"
    described as {
      |Creates a new wholesale order.
    }
  }
  command AllocateInventory is  {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order to allocate.
      }
    }
    allocations: AllocationResult+ with {
      briefly "Allocations"
      described as {
        |Inventory allocations.
      }
    }
  } with {
    briefly "Allocate inventory"
    described as {
      |Allocates stock from warehouses.
    }
  }
  command ConfirmOrder is  {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order to confirm.
      }
    }
    confirmedBy: String(1,100) with {
      briefly "Confirmed by"
      described as {
        |Person confirming.
      }
    }
  } with {
    briefly "Confirm order"
    described as {
      |Confirms order for fulfillment.
    }
  }
  command ShipOrder is  {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order to ship.
      }
    }
    shipment: ShipmentInfo with {
      briefly "Shipment"
      described as {
        |Shipment details.
      }
    }
  } with {
    briefly "Ship order"
    described as {
      |Records order shipment.
    }
  }
  command DeliverOrder is  {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order delivered.
      }
    }
    deliveredAt: TimeStamp with {
      briefly "Delivered at"
      described as {
        |Delivery time.
      }
    }
    receivedBy: String(1,100) with {
      briefly "Received by"
      described as {
        |Person receiving.
      }
    }
  } with {
    briefly "Confirm delivery"
    described as {
      |Records order delivery.
    }
  }
  command CancelOrder is  {
    orderId: OrderId with {
      briefly "Order ID"
      described as {
        |Order to cancel.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
    cancelledBy: String(1,100) with {
      briefly "Cancelled by"
      described as {
        |Person cancelling.
      }
    }
  } with {
    briefly "Cancel order"
    described as {
      |Cancels the distribution order.
    }
  }
  // Events
  event OrderCreated is  {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    lineCount: Natural with {
      briefly "Lines"
      described as {
        |Number of lines.
      }
    }
    totalAmount: Money with {
      briefly "Total"
      described as {
        |Order total.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Order was created"
    described as {
      |Emitted when distribution order is placed.
    }
  }
  event InventoryAllocated is  {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    allocations: AllocationResult+ with {
      briefly "Allocations"
      described as {
        |Allocation results.
      }
    }
    fullyAllocated: Boolean with {
      briefly "Complete"
      described as {
        |Whether fully allocated.
      }
    }
    allocatedAt: TimeStamp with {
      briefly "Allocated"
      described as {
        |Allocation time.
      }
    }
  } with {
    briefly "Inventory was allocated"
    described as {
      |Emitted when stock is reserved.
    }
  }
  event OrderConfirmed is  {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    confirmedBy: String(1,100) with {
      briefly "Confirmed by"
      described as {
        |Confirmer.
      }
    }
    confirmedAt: TimeStamp with {
      briefly "Confirmed"
      described as {
        |Confirmation time.
      }
    }
  } with {
    briefly "Order was confirmed"
    described as {
      |Emitted when order is confirmed.
    }
  }
  event OrderShipped is  {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    shipment: ShipmentInfo with {
      briefly "Shipment"
      described as {
        |Shipment details.
      }
    }
    shippedAt: TimeStamp with {
      briefly "Shipped"
      described as {
        |Ship time.
      }
    }
  } with {
    briefly "Order was shipped"
    described as {
      |Emitted when order ships.
    }
  }
  event OrderDelivered is  {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    deliveredAt: TimeStamp with {
      briefly "Delivered"
      described as {
        |Delivery time.
      }
    }
    receivedBy: String(1,100) with {
      briefly "Received by"
      described as {
        |Receiver.
      }
    }
  } with {
    briefly "Order was delivered"
    described as {
      |Emitted when order is delivered.
    }
  }
  event OrderCancelled is  {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancellation time.
      }
    }
  } with {
    briefly "Order was cancelled"
    described as {
      |Emitted when order is cancelled.
    }
  }
  // State Records
  record PendingOrderData is  {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    lines: OrderLine+ with {
      briefly "Lines"
      described as {
        |Order lines.
      }
    }
    shippingAddress: ShippingAddress with {
      briefly "Shipping"
      described as {
        |Delivery address.
      }
    }
    pricingTier: PricingTier with {
      briefly "Pricing"
      described as {
        |Pricing tier.
      }
    }
    totalAmount: Money with {
      briefly "Total"
      described as {
        |Order total.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Pending order data"
    described as {
      |State data for an unconfirmed order.
    }
  }
  record ConfirmedOrderData is  {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    lines: OrderLine+ with {
      briefly "Lines"
      described as {
        |Order lines.
      }
    }
    shippingAddress: ShippingAddress with {
      briefly "Shipping"
      described as {
        |Delivery address.
      }
    }
    totalAmount: Money with {
      briefly "Total"
      described as {
        |Order total.
      }
    }
    confirmedAt: TimeStamp with {
      briefly "Confirmed"
      described as {
        |Confirmation time.
      }
    }
  } with {
    briefly "Confirmed order data"
    described as {
      |State data for a confirmed order.
    }
  }
  record ShippedOrderData is  {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    shipment: ShipmentInfo with {
      briefly "Shipment"
      described as {
        |Shipment info.
      }
    }
    totalAmount: Money with {
      briefly "Total"
      described as {
        |Order total.
      }
    }
    shippedAt: TimeStamp with {
      briefly "Shipped"
      described as {
        |Ship time.
      }
    }
  } with {
    briefly "Shipped order data"
    described as {
      |State data for a shipped order.
    }
  }
  record DeliveredOrderData is  {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    totalAmount: Money with {
      briefly "Total"
      described as {
        |Order total.
      }
    }
    deliveredAt: TimeStamp with {
      briefly "Delivered"
      described as {
        |Delivery time.
      }
    }
  } with {
    briefly "Delivered order data"
    described as {
      |State data for a delivered order.
    }
  }
  record CancelledOrderData is  {
    orderId: OrderId with {
      briefly "Order"
      described as {
        |Order ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancellation time.
      }
    }
  } with {
    briefly "Cancelled order data"
    described as {
      |State data for a cancelled order.
    }
  }
  // States
  initial state PendingState of record DistributionOrder.PendingOrderData is {
    initial handler PendingStateInitHandler is {
      on query GetDistributionOrder is {
        let distributionOrderResult: type DistributionOrderResult = prompt("read the distribution order from the store")
        reply distributionOrderResult
      }
      on init is {
        set state PendingState to "initialize from prior event"
      }
    } with {
      briefly "PendingState init handler"
      described as {
        |Initializes the PendingState state.
      }
    }
  } with {
    briefly "PendingState state"
    described as {
      |The PendingState state of the DistributionOrder.
    }
  }
  state ConfirmedState of record DistributionOrder.ConfirmedOrderData is {
    initial handler ConfirmedStateInitHandler is {
      on init is {
        set state ConfirmedState to "initialize from prior event"
      }
    } with {
      briefly "ConfirmedState init handler"
      described as {
        |Initializes the ConfirmedState state.
      }
    }
  } with {
    briefly "ConfirmedState state"
    described as {
      |The ConfirmedState state of the DistributionOrder.
    }
  }
  state ShippedState of record DistributionOrder.ShippedOrderData is {
    initial handler ShippedStateInitHandler is {
      on init is {
        set state ShippedState to "initialize from prior event"
      }
    } with {
      briefly "ShippedState init handler"
      described as {
        |Initializes the ShippedState state.
      }
    }
  } with {
    briefly "ShippedState state"
    described as {
      |The ShippedState state of the DistributionOrder.
    }
  }
  state DeliveredState of record DistributionOrder.DeliveredOrderData is {
    initial handler DeliveredStateInitHandler is {
      on init is {
        set state DeliveredState to "initialize from prior event"
      }
    } with {
      briefly "DeliveredState init handler"
      described as {
        |Initializes the DeliveredState state.
      }
    }
  } with {
    briefly "DeliveredState state"
    described as {
      |The DeliveredState state of the DistributionOrder.
    }
  }
  state CancelledState of record DistributionOrder.CancelledOrderData is {
    initial handler CancelledStateInitHandler is {
      on init is {
        set state CancelledState to "initialize from prior event"
      }
    } with {
      briefly "CancelledState init handler"
      described as {
        |Initializes the CancelledState state.
      }
    }
  } with {
    briefly "CancelledState state"
    described as {
      |The CancelledState state of the DistributionOrder.
    }
  }
  // Handler
  handler OrderHandler is {
    on createOrder: command CreateOrder is {
      morph entity DistributionContext.DistributionOrder to state DistributionContext.DistributionOrder.PendingState with record DistributionOrder.PendingOrderData(orderId = createOrder.orderId, customerId = createOrder.customerId, lines = createOrder.lines, shippingAddress = createOrder.shippingAddress, pricingTier = createOrder.pricingTier, totalAmount = prompt("the total amount of this pending order data"), createdAt = prompt("the created at of this pending order data"))
      tell event OrderCreated(orderId = createOrder.orderId, customerId = createOrder.customerId, lineCount = prompt("the line count of this order created"), totalAmount = prompt("the total amount of this order created"), createdAt = prompt("the created at of this order created")) to entity DistributionContext.DistributionOrder
    }
    on allocateInventory: command AllocateInventory is {
      tell event InventoryAllocated(orderId = allocateInventory.orderId, allocations = allocateInventory.allocations, fullyAllocated = prompt("the fully allocated of this inventory allocated"), allocatedAt = prompt("the allocated at of this inventory allocated")) to entity DistributionContext.DistributionOrder
    }
    on confirmOrder: command ConfirmOrder is {
      morph entity DistributionContext.DistributionOrder to state DistributionContext.DistributionOrder.ConfirmedState with record DistributionOrder.ConfirmedOrderData(orderId = confirmOrder.orderId, customerId = prompt("the customer id of this confirmed order data"), lines = prompt("the lines of this confirmed order data"), shippingAddress = prompt("the shipping address of this confirmed order data"), totalAmount = prompt("the total amount of this confirmed order data"), confirmedAt = prompt("the confirmed at of this confirmed order data"))
      tell event OrderConfirmed(orderId = confirmOrder.orderId, confirmedBy = confirmOrder.confirmedBy, confirmedAt = prompt("the confirmed at of this order confirmed")) to entity DistributionContext.DistributionOrder
    }
    on shipOrder: command ShipOrder is {
      morph entity DistributionContext.DistributionOrder to state DistributionContext.DistributionOrder.ShippedState with record DistributionOrder.ShippedOrderData(orderId = shipOrder.orderId, shipment = shipOrder.shipment, customerId = prompt("the customer id of this shipped order data"), totalAmount = prompt("the total amount of this shipped order data"), shippedAt = prompt("the shipped at of this shipped order data"))
      tell event OrderShipped(orderId = shipOrder.orderId, shipment = shipOrder.shipment, shippedAt = prompt("the shipped at of this order shipped")) to entity DistributionContext.DistributionOrder
    }
    on deliverOrder: command DeliverOrder is {
      morph entity DistributionContext.DistributionOrder to state DistributionContext.DistributionOrder.DeliveredState with record DistributionOrder.DeliveredOrderData(orderId = deliverOrder.orderId, deliveredAt = deliverOrder.deliveredAt, customerId = prompt("the customer id of this delivered order data"), totalAmount = prompt("the total amount of this delivered order data"))
      tell event OrderDelivered(orderId = deliverOrder.orderId, deliveredAt = deliverOrder.deliveredAt, receivedBy = deliverOrder.receivedBy) to entity DistributionContext.DistributionOrder
    }
    on cancelOrder: command CancelOrder is {
      morph entity DistributionContext.DistributionOrder to state DistributionContext.DistributionOrder.CancelledState with record DistributionOrder.CancelledOrderData(orderId = cancelOrder.orderId, reason = cancelOrder.reason, cancelledAt = prompt("the cancelled at of this cancelled order data"))
      tell event OrderCancelled(orderId = cancelOrder.orderId, reason = cancelOrder.reason, cancelledAt = prompt("the cancelled at of this order cancelled")) to entity DistributionContext.DistributionOrder
    }
      on inventoryAllocated: event InventoryAllocated is {
      do "apply InventoryAllocated to the distributionOrder so it can be persisted and replayed"
    }
    on orderCancelled: event OrderCancelled is {
      do "apply OrderCancelled to the distributionOrder so it can be persisted and replayed"
    }
    on orderConfirmed: event OrderConfirmed is {
      do "apply OrderConfirmed to the distributionOrder so it can be persisted and replayed"
    }
    on orderCreated: event OrderCreated is {
      do "apply OrderCreated to the distributionOrder so it can be persisted and replayed"
    }
    on orderDelivered: event OrderDelivered is {
      do "apply OrderDelivered to the distributionOrder so it can be persisted and replayed"
    }
    on orderShipped: event OrderShipped is {
      do "apply OrderShipped to the distributionOrder so it can be persisted and replayed"
    }
} with {
    briefly "Processes order commands"
    described as {
      | Handles distribution order lifecycle including creation,
      | allocation, shipping, and delivery.
    }
  }
} with {
  briefly "Distribution order aggregate"
  described as {
    | The DistributionOrder entity manages wholesale orders including
    | inventory allocation, fulfillment, and delivery tracking.
  }
}
