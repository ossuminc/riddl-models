// Distribution - Distribution Context
context DistributionContext is {
  adaptor FromBillingService from context BillingService is {
    handler FromBillingServiceHandler is {
      on event BillingService.InvoiceCreated is {
        do "the model receives invoice created"
      }
      on event BillingService.PaymentReceived is {
        do "the model receives payment received"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
      briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromCRMService from context CRMService is {
    handler FromCRMServiceHandler is {
      on event CRMService.CustomerCreditUpdated is {
        do "the model receives customer credit updated"
      }
      on event CRMService.CustomerPricingUpdated is {
        do "the model receives customer pricing updated"
      }
      on other is {
        error "Unexpected message for adaptor FromCRMService"
      }
    } with {
      briefly "from crm service"
      described as {
        |Carries messages from the external CRMService.
      }
    }
  } with {
      briefly "CRMService integration"
    described as {
      |The model's side of the CRMService conversation.
    }
  }
  adaptor FromInventoryService from context InventoryService is {
    handler FromInventoryServiceHandler is {
      on event InventoryService.StockAllocated is {
        do "the model receives stock allocated"
      }
      on event InventoryService.StockUnavailable is {
        do "the model receives stock unavailable"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
      briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromShippingService from context ShippingService is {
    handler FromShippingServiceHandler is {
      on event ShippingService.PickupScheduled is {
        do "the model receives pickup scheduled"
      }
      on event ShippingService.ShipmentDelivered is {
        do "the model receives shipment delivered"
      }
      on other is {
        error "Unexpected message for adaptor FromShippingService"
      }
    } with {
      briefly "from shipping service"
      described as {
        |Carries messages from the external ShippingService.
      }
    }
  } with {
      briefly "ShippingService integration"
    described as {
      |The model's side of the ShippingService conversation.
    }
  }
  include "types.riddl"
  include "DistributionOrder.riddl"
  // Adaptors for external system integration
  adaptor InventoryAdapter to context InventoryService is { 
    handler InventoryAllocation is {
      on command InventoryService.AllocateStock is {
        do "Request inventory allocation"
      }
      on command InventoryService.ReleaseStock is {
        do "Release allocated inventory"
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles inventory allocation"
      described as {
        |Requests inventory for orders.
      }
    }
  } with {
    briefly "Inventory integration"
    described as {
      |Manages inventory allocation requests.
    }
  }
  adaptor ShippingAdapter to context ShippingService is { 
    handler ShippingEvents is {
      on command ShippingService.SchedulePickup is {
        do "Schedule shipment pickup"
      }
      on other is {
        error "Unexpected message for adaptor ShippingAdapter"
      }
    } with {
      briefly "Handles shipping coordination"
      described as {
        |Schedules shipments for confirmed orders.
      }
    }
  } with {
    briefly "Shipping integration"
    described as {
      |Coordinates with shipping carriers.
    }
  }
  adaptor BillingAdapter to context BillingService is { 
    handler BillingEvents is {
      on command BillingService.CreateInvoice is {
        do "Generate invoice for shipped order"
      }
      on other is {
        error "Unexpected message for adaptor BillingAdapter"
      }
    } with {
      briefly "Handles billing"
      described as {
        |Triggers invoicing on shipment.
      }
    }
  } with {
    briefly "Billing integration"
    described as {
      |Publishes billing events.
    }
  }
  // Repository for order persistence
  repository OrderRepository is {
    inlet OrderRepositoryFromDistributionOrder is type DistributionOrderEvent
    inlet OrderRepositoryFromDistributionAnalytics is type DistributionOrderEvent
    outlet OrderRepositoryResponses is type DistributionOrder.DistributionOrderResult
    schema OrderData is relational
      of orders as type DistributionOrder
        index on field DistributionOrder.customerId
        index on field DistributionOrder.orderId
      with {
      briefly "Order data schema"
      described as {
        |The relational schema holding order data for the OrderRepository.
      }
    }

    handler OrderPersistence is {
      on command DistributionOrder.CreateOrder is {
        tell event DistributionOrder.OrderCreated to entity DistributionContext.DistributionOrder
        do "Persist new order"
      }
      on command DistributionOrder.AllocateInventory is {
        do "Update allocation status"
      }
      on command DistributionOrder.ConfirmOrder is {
        tell event DistributionOrder.OrderConfirmed to entity DistributionContext.DistributionOrder
        do "Update order status"
      }
      on command DistributionOrder.ShipOrder is {
        tell event DistributionOrder.OrderShipped to entity DistributionContext.DistributionOrder
        do "Record shipment"
      }
      on command DistributionOrder.DeliverOrder is {
        tell event DistributionOrder.OrderDelivered to entity DistributionContext.DistributionOrder
        do "Record delivery"
      }
      on command DistributionOrder.CancelOrder is {
        tell event DistributionOrder.OrderCancelled to entity DistributionContext.DistributionOrder
        do "Mark order cancelled"
      }
    } with {
      briefly "Persists order commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Order data persistence"
    described as {
      | The OrderRepository provides persistent storage for
      | distribution orders.
    }
  }
  // Projector for distribution analytics
  projector DistributionAnalytics is {
    inlet DistributionAnalyticsFromDistributionOrder is type DistributionOrderEvent
    outlet DistributionAnalyticsOut is type DistributionOrderEvent
    updates repository DistributionContext.OrderRepository
    record CustomerOrderMetrics is  {
      customerId: CustomerId with {
        briefly "Customer"
        described as {
          |Customer ID.
        }
      }
      totalOrders: Natural with {
        briefly "Orders"
        described as {
          |Total orders.
        }
      }
      totalRevenue: Money with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      avgOrderValue: Money with {
        briefly "AOV"
        described as {
          |Average order value.
        }
      }
    } with {
      briefly "Customer order metrics"
      described as {
        |Aggregated customer order data.
      }
    }
    handler AnalyticsHandler is {
      on event DistributionOrder.OrderDelivered is {
        tell event DistributionOrder.OrderDelivered to repository DistributionContext.OrderRepository
        do "Update customer metrics"
      }
    } with {
      briefly "Maintains analytics views"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Distribution analytics projections"
    described as {
      |Maintains order analytics data.
    }
  }
  // ---- Event publication for DistributionOrder ----
  type DistributionOrderEvent is one of {
    DistributionContext.DistributionOrder.OrderCreated,
    DistributionContext.DistributionOrder.InventoryAllocated,
    DistributionContext.DistributionOrder.OrderConfirmed,
    DistributionContext.DistributionOrder.OrderShipped,
    DistributionContext.DistributionOrder.OrderDelivered,
    DistributionContext.DistributionOrder.OrderCancelled
  } with {
    briefly "DistributionOrder event alternation"
    described as {
      |Union of all DistributionOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor DistributionOrderEventSource as source is {
    outlet DistributionOrderEvents is type DistributionOrderEvent
    handler DistributionOrderSourceHandler is {
      on event DistributionOrder.OrderCreated is {
        send event DistributionOrder.OrderCreated to outlet DistributionOrderEvents
      }
      on event DistributionOrder.InventoryAllocated is {
        send event DistributionOrder.InventoryAllocated to outlet DistributionOrderEvents
      }
      on event DistributionOrder.OrderConfirmed is {
        send event DistributionOrder.OrderConfirmed to outlet DistributionOrderEvents
      }
      on event DistributionOrder.OrderShipped is {
        send event DistributionOrder.OrderShipped to outlet DistributionOrderEvents
      }
      on event DistributionOrder.OrderDelivered is {
        send event DistributionOrder.OrderDelivered to outlet DistributionOrderEvents
      }
      on event DistributionOrder.OrderCancelled is {
        send event DistributionOrder.OrderCancelled to outlet DistributionOrderEvents
      }
      on other is {
        error "Unexpected message for source DistributionOrderEventSource"
      }
    } with {
      briefly "DistributionOrder source handler"
      described as {
        |Publishes DistributionOrder events onto the outlet.
      }
    }
  } with {
    briefly "DistributionOrder event source"
    described as {
      |Publishes DistributionOrder entity events into the streaming topology.
    }
  }
  processor DistributionOrderEventSink as sink is {
    inlet DistributionOrderInlet is type DistributionOrderEvent
    handler DistributionOrderSinkHandler is {
      on event DistributionOrder.OrderCreated is {
        tell event DistributionOrder.OrderCreated to repository DistributionContext.OrderRepository
      }
      on event DistributionOrder.InventoryAllocated is {
        tell event DistributionOrder.InventoryAllocated to repository DistributionContext.OrderRepository
      }
      on event DistributionOrder.OrderConfirmed is {
        tell event DistributionOrder.OrderConfirmed to repository DistributionContext.OrderRepository
      }
      on event DistributionOrder.OrderShipped is {
        tell event DistributionOrder.OrderShipped to repository DistributionContext.OrderRepository
      }
      on event DistributionOrder.OrderDelivered is {
        tell event DistributionOrder.OrderDelivered to repository DistributionContext.OrderRepository
      }
      on event DistributionOrder.OrderCancelled is {
        tell event DistributionOrder.OrderCancelled to repository DistributionContext.OrderRepository
      }
      on other is {
        error "Unexpected message for sink DistributionOrderEventSink"
      }
    } with {
      briefly "DistributionOrder sink handler"
      described as {
        |Persists DistributionOrder events via the repository.
      }
    }
  } with {
    briefly "DistributionOrder event sink"
    described as {
      |Receives DistributionOrder events for persistence.
    }
  }
  connector DistributionOrderEventFlow is {
    from outlet DistributionContext.DistributionOrderEventSource.DistributionOrderEvents to
      inlet DistributionContext.DistributionOrderEventSink.DistributionOrderInlet
  } with {
    briefly "DistributionOrder event flow"
    described as {
      |Connects the DistributionOrder source to its sink.
    }
  }
  processor DistributionOrderEventSplit is {
    inlet DistributionOrderEventSplitIn is type DistributionOrderEvent
    outlet DistributionOrderEventSplitToOrderRepository is type DistributionOrderEvent
    outlet DistributionOrderEventSplitToDistributionAnalytics is type DistributionOrderEvent
    handler DistributionOrderEventSplitHandler is {
      on event DistributionOrder.OrderCreated is {
        send event DistributionOrder.OrderCreated to outlet DistributionOrderEventSplitToOrderRepository
        send event DistributionOrder.OrderCreated to outlet DistributionOrderEventSplitToDistributionAnalytics
        tell event DistributionOrder.OrderCreated to entity DistributionContext.DistributionOrder
      }
      on event DistributionOrder.InventoryAllocated is {
        send event DistributionOrder.InventoryAllocated to outlet DistributionOrderEventSplitToOrderRepository
        send event DistributionOrder.InventoryAllocated to outlet DistributionOrderEventSplitToDistributionAnalytics
        tell event DistributionOrder.InventoryAllocated to entity DistributionContext.DistributionOrder
      }
      on event DistributionOrder.OrderConfirmed is {
        send event DistributionOrder.OrderConfirmed to outlet DistributionOrderEventSplitToOrderRepository
        send event DistributionOrder.OrderConfirmed to outlet DistributionOrderEventSplitToDistributionAnalytics
        tell event DistributionOrder.OrderConfirmed to entity DistributionContext.DistributionOrder
      }
      on event DistributionOrder.OrderShipped is {
        send event DistributionOrder.OrderShipped to outlet DistributionOrderEventSplitToOrderRepository
        send event DistributionOrder.OrderShipped to outlet DistributionOrderEventSplitToDistributionAnalytics
        tell event DistributionOrder.OrderShipped to entity DistributionContext.DistributionOrder
      }
      on event DistributionOrder.OrderDelivered is {
        send event DistributionOrder.OrderDelivered to outlet DistributionOrderEventSplitToOrderRepository
        send event DistributionOrder.OrderDelivered to outlet DistributionOrderEventSplitToDistributionAnalytics
        tell event DistributionOrder.OrderDelivered to entity DistributionContext.DistributionOrder
      }
      on event DistributionOrder.OrderCancelled is {
        send event DistributionOrder.OrderCancelled to outlet DistributionOrderEventSplitToOrderRepository
        send event DistributionOrder.OrderCancelled to outlet DistributionOrderEventSplitToDistributionAnalytics
        tell event DistributionOrder.OrderCancelled to entity DistributionContext.DistributionOrder
      }
      on other is {
        error "Unexpected message for processor DistributionOrderEventSplit"
      }
    } with {
      briefly "DistributionOrder event fan-out handler"
      described as {
        |Delivers each DistributionOrder event to all of its consumers.
      }
    }
  } with {
    briefly "DistributionOrder event fan-out"
    described as {
      |Fans DistributionOrder events out to the repository and projectors.
    }
  }
  connector LinkDistributionOrderToDistributionOrderEventSplit is {
    from outlet DistributionContext.DistributionOrder.DistributionOrderEvents2 to
      inlet DistributionContext.DistributionOrderEventSplit.DistributionOrderEventSplitIn
  } with {
    briefly "LinkDistributionOrderToDistributionOrderEventSplit"
  }
  connector LinkDistributionOrderEventSplitToOrderRepository is {
    from outlet DistributionContext.DistributionOrderEventSplit.DistributionOrderEventSplitToOrderRepository to
      inlet DistributionContext.OrderRepository.OrderRepositoryFromDistributionOrder
  } with {
    briefly "LinkDistributionOrderEventSplitToOrderRepository"
  }
  connector LinkDistributionOrderEventSplitToDistributionAnalytics is {
    from outlet DistributionContext.DistributionOrderEventSplit.DistributionOrderEventSplitToDistributionAnalytics to
      inlet DistributionContext.DistributionAnalytics.DistributionAnalyticsFromDistributionOrder
  } with {
    briefly "LinkDistributionOrderEventSplitToDistributionAnalytics"
  }
  connector LinkDistributionAnalyticsToOrderRepository is {
    from outlet DistributionContext.DistributionAnalytics.DistributionAnalyticsOut to
      inlet DistributionContext.OrderRepository.OrderRepositoryFromDistributionAnalytics
  } with {
    briefly "LinkDistributionAnalyticsToOrderRepository"
  }
} with {
  briefly "Bounded context for distribution"
  described as {
    | The DistributionContext is the bounded context for wholesale
    | distribution. It manages orders, allocation, and fulfillment.
  }
}
