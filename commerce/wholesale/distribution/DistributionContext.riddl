// Distribution - Distribution Context
context DistributionContext is {
  include "types.riddl"
  include "DistributionOrder.riddl"
  // Adaptors for external system integration
  adaptor InventoryAdapter to context InventoryService is { 
    handler InventoryAllocation is {
      on command InventoryService.AllocateStock is {
        prompt "Request inventory allocation"
      }
      on command InventoryService.ReleaseStock is {
        prompt "Release allocated inventory"
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles inventory allocation"
      described as {
        |Requests inventory for orders.
      }
    }
  } with {
    briefly "Inventory integration"
    described as {
      |Manages inventory allocation requests.
    }
  }
  adaptor ShippingAdapter to context ShippingService is { 
    handler ShippingEvents is {
      on command ShippingService.SchedulePickup is {
        prompt "Schedule shipment pickup"
      }
      on other is {
        error "Unexpected message for adaptor ShippingAdapter"
      }
    } with {
      briefly "Handles shipping coordination"
      described as {
        |Schedules shipments for confirmed orders.
      }
    }
  } with {
    briefly "Shipping integration"
    described as {
      |Coordinates with shipping carriers.
    }
  }
  adaptor BillingAdapter to context BillingService is { 
    handler BillingEvents is {
      on command BillingService.CreateInvoice is {
        prompt "Generate invoice for shipped order"
      }
      on other is {
        error "Unexpected message for adaptor BillingAdapter"
      }
    } with {
      briefly "Handles billing"
      described as {
        |Triggers invoicing on shipment.
      }
    }
  } with {
    briefly "Billing integration"
    described as {
      |Publishes billing events.
    }
  }
  // Repository for order persistence
  repository OrderRepository is {
    schema OrderData is relational
      of orders as type DistributionOrder
        index on field DistributionOrder.customerId
        index on field DistributionOrder.orderId

    handler OrderPersistence is {
      on command DistributionOrder.CreateOrder is {
        tell event DistributionOrder.OrderCreated to entity DistributionContext.DistributionOrder
        prompt "Persist new order"
      }
      on command DistributionOrder.AllocateInventory is {
        prompt "Update allocation status"
      }
      on command DistributionOrder.ConfirmOrder is {
        tell event DistributionOrder.OrderConfirmed to entity DistributionContext.DistributionOrder
        prompt "Update order status"
      }
      on command DistributionOrder.ShipOrder is {
        tell event DistributionOrder.OrderShipped to entity DistributionContext.DistributionOrder
        prompt "Record shipment"
      }
      on command DistributionOrder.DeliverOrder is {
        tell event DistributionOrder.OrderDelivered to entity DistributionContext.DistributionOrder
        prompt "Record delivery"
      }
      on command DistributionOrder.CancelOrder is {
        tell event DistributionOrder.OrderCancelled to entity DistributionContext.DistributionOrder
        prompt "Mark order cancelled"
      }
    } with {
      briefly "Persists order commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Order data persistence"
    described as {
      | The OrderRepository provides persistent storage for
      | distribution orders.
    }
  }
  // Projector for distribution analytics
  projector DistributionAnalytics is {
    updates repository DistributionContext.OrderRepository
    record CustomerOrderMetrics is  {
      customerId: CustomerId with {
        briefly "Customer"
        described as {
          |Customer ID.
        }
      }
      totalOrders: Natural with {
        briefly "Orders"
        described as {
          |Total orders.
        }
      }
      totalRevenue: Money with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      avgOrderValue: Money with {
        briefly "AOV"
        described as {
          |Average order value.
        }
      }
    } with {
      briefly "Customer order metrics"
      described as {
        |Aggregated customer order data.
      }
    }
    handler AnalyticsHandler is {
      on event DistributionOrder.OrderDelivered is {
        tell event DistributionOrder.OrderDelivered to repository DistributionContext.OrderRepository
        prompt "Update customer metrics"
      }
    } with {
      briefly "Maintains analytics views"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Distribution analytics projections"
    described as {
      |Maintains order analytics data.
    }
  }
  // ---- Event publication for DistributionOrder ----
  type DistributionOrderEvent is one of {
    DistributionContext.DistributionOrder.OrderCreated,
    DistributionContext.DistributionOrder.InventoryAllocated,
    DistributionContext.DistributionOrder.OrderConfirmed,
    DistributionContext.DistributionOrder.OrderShipped,
    DistributionContext.DistributionOrder.OrderDelivered,
    DistributionContext.DistributionOrder.OrderCancelled
  } with {
    briefly "DistributionOrder event alternation"
    described as {
      |Union of all DistributionOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor DistributionOrderEventSource as source is {
    outlet DistributionOrderEvents is type DistributionOrderEvent
    handler DistributionOrderSourceHandler is {
      on event DistributionOrder.OrderCreated is {
        send event DistributionOrder.OrderCreated to outlet DistributionOrderEvents
      }
      on event DistributionOrder.InventoryAllocated is {
        send event DistributionOrder.InventoryAllocated to outlet DistributionOrderEvents
      }
      on event DistributionOrder.OrderConfirmed is {
        send event DistributionOrder.OrderConfirmed to outlet DistributionOrderEvents
      }
      on event DistributionOrder.OrderShipped is {
        send event DistributionOrder.OrderShipped to outlet DistributionOrderEvents
      }
      on event DistributionOrder.OrderDelivered is {
        send event DistributionOrder.OrderDelivered to outlet DistributionOrderEvents
      }
      on event DistributionOrder.OrderCancelled is {
        send event DistributionOrder.OrderCancelled to outlet DistributionOrderEvents
      }
      on other is {
        error "Unexpected message for source DistributionOrderEventSource"
      }
    } with {
      briefly "DistributionOrder source handler"
      described as {
        |Publishes DistributionOrder events onto the outlet.
      }
    }
  } with {
    briefly "DistributionOrder event source"
    described as {
      |Publishes DistributionOrder entity events into the streaming topology.
    }
  }
  processor DistributionOrderEventSink as sink is {
    inlet DistributionOrderInlet is type DistributionOrderEvent
    handler DistributionOrderSinkHandler is {
      on event DistributionOrder.OrderCreated is {
        tell event DistributionOrder.OrderCreated to repository DistributionContext.OrderRepository
      }
      on event DistributionOrder.InventoryAllocated is {
        tell event DistributionOrder.InventoryAllocated to repository DistributionContext.OrderRepository
      }
      on event DistributionOrder.OrderConfirmed is {
        tell event DistributionOrder.OrderConfirmed to repository DistributionContext.OrderRepository
      }
      on event DistributionOrder.OrderShipped is {
        tell event DistributionOrder.OrderShipped to repository DistributionContext.OrderRepository
      }
      on event DistributionOrder.OrderDelivered is {
        tell event DistributionOrder.OrderDelivered to repository DistributionContext.OrderRepository
      }
      on event DistributionOrder.OrderCancelled is {
        tell event DistributionOrder.OrderCancelled to repository DistributionContext.OrderRepository
      }
      on other is {
        error "Unexpected message for sink DistributionOrderEventSink"
      }
    } with {
      briefly "DistributionOrder sink handler"
      described as {
        |Persists DistributionOrder events via the repository.
      }
    }
  } with {
    briefly "DistributionOrder event sink"
    described as {
      |Receives DistributionOrder events for persistence.
    }
  }
  connector DistributionOrderEventFlow is {
    from outlet DistributionContext.DistributionOrderEventSource.DistributionOrderEvents to
      inlet DistributionContext.DistributionOrderEventSink.DistributionOrderInlet
  } with {
    briefly "DistributionOrder event flow"
    described as {
      |Connects the DistributionOrder source to its sink.
    }
  }
} with {
  briefly "Bounded context for distribution"
  described as {
    | The DistributionContext is the bounded context for wholesale
    | distribution. It manages orders, allocation, and fulfillment.
  }
}
