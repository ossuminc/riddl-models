// Distribution - Distribution Context
context DistributionContext as router is {
  inlet DistributionOrderCommandStreIn is type DistributionOrderCommand
  outlet DistributionOrderCommandStreOut is type DistributionOrderCommand
  inlet MarketplaceOrderResultStreamIn is type DistributionOrder.DistributionOrderResult
  outlet MarketplaceOrderResultStreamOut is type DistributionOrder.DistributionOrderResult
  handler DistributionContextBoundary is {
    on createOrder: command DistributionOrder.CreateOrder is {
      send createOrder to outlet DistributionContext.DistributionOrderCommandStreOut
    }
    on allocateInventory: command DistributionOrder.AllocateInventory is {
      send allocateInventory to outlet DistributionContext.DistributionOrderCommandStreOut
    }
    on confirmOrder: command DistributionOrder.ConfirmOrder is {
      send confirmOrder to outlet DistributionContext.DistributionOrderCommandStreOut
    }
    on shipOrder: command DistributionOrder.ShipOrder is {
      send shipOrder to outlet DistributionContext.DistributionOrderCommandStreOut
    }
    on deliverOrder: command DistributionOrder.DeliverOrder is {
      send deliverOrder to outlet DistributionContext.DistributionOrderCommandStreOut
    }
    on cancelOrder: command DistributionOrder.CancelOrder is {
      send cancelOrder to outlet DistributionContext.DistributionOrderCommandStreOut
    }
    on distributionOrderResult: result DistributionOrder.DistributionOrderResult is {
      send distributionOrderResult to outlet DistributionContext.MarketplaceOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the DistributionContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'DistributionOrderCommand Stream Intake' is from outlet DistributionContext.DistributionOrderCommandStreOut to inlet DistributionContext.DistributionOrder.DistributionOrderCommands
  connector 'MarketplaceOrderResult Stream Egress' is from outlet DistributionContext.OrderRepository.OrderRepositoryResponses to inlet DistributionContext.MarketplaceOrderResultStreamIn
  adaptor FromBillingService from context BillingService is { 
    handler FromBillingServiceHandler is {
      on event BillingService.InvoiceCreated is {
        do "the model receives invoice created"
      }
      on event BillingService.PaymentReceived is {
        do "the model receives payment received"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromCRMService from context CRMService is { 
    handler FromCRMServiceHandler is {
      on event CRMService.CustomerCreditUpdated is {
        do "the model receives customer credit updated"
      }
      on event CRMService.CustomerPricingUpdated is {
        do "the model receives customer pricing updated"
      }
      on other is {
        error "Unexpected message for adaptor FromCRMService"
      }
    } with {
      briefly "from crm service"
      described as {
        |Carries messages from the external CRMService.
      }
    }
  } with {
    briefly "CRMService integration"
    described as {
      |The model's side of the CRMService conversation.
    }
  }
  adaptor FromInventoryService from context InventoryService is { 
    handler FromInventoryServiceHandler is {
      on event InventoryService.StockAllocated is {
        do "the model receives stock allocated"
      }
      on event InventoryService.StockUnavailable is {
        do "the model receives stock unavailable"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromShippingService from context ShippingService is { 
    handler FromShippingServiceHandler is {
      on event ShippingService.PickupScheduled is {
        do "the model receives pickup scheduled"
      }
      on event ShippingService.ShipmentDelivered is {
        do "the model receives shipment delivered"
      }
      on other is {
        error "Unexpected message for adaptor FromShippingService"
      }
    } with {
      briefly "from shipping service"
      described as {
        |Carries messages from the external ShippingService.
      }
    }
  } with {
    briefly "ShippingService integration"
    described as {
      |The model's side of the ShippingService conversation.
    }
  }
  include "types.riddl"
  include "DistributionOrder.riddl"
  // Adaptors for external system integration
  adaptor InventoryAdapter to context InventoryService is { 
    handler InventoryAllocation is {
      on command InventoryService.AllocateStock is {
        do "Request inventory allocation"
      }
      on command InventoryService.ReleaseStock is {
        do "Release allocated inventory"
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles inventory allocation"
      described as {
        |Requests inventory for orders.
      }
    }
  } with {
    briefly "Inventory integration"
    described as {
      |Manages inventory allocation requests.
    }
  }
  adaptor ShippingAdapter to context ShippingService is { 
    handler ShippingEvents is {
      on command ShippingService.SchedulePickup is {
        do "Schedule shipment pickup"
      }
      on other is {
        error "Unexpected message for adaptor ShippingAdapter"
      }
    } with {
      briefly "Handles shipping coordination"
      described as {
        |Schedules shipments for confirmed orders.
      }
    }
  } with {
    briefly "Shipping integration"
    described as {
      |Coordinates with shipping carriers.
    }
  }
  adaptor BillingAdapter to context BillingService is { 
    handler BillingEvents is {
      on command BillingService.CreateInvoice is {
        do "Generate invoice for shipped order"
      }
      on other is {
        error "Unexpected message for adaptor BillingAdapter"
      }
    } with {
      briefly "Handles billing"
      described as {
        |Triggers invoicing on shipment.
      }
    }
  } with {
    briefly "Billing integration"
    described as {
      |Publishes billing events.
    }
  }
  // Repository for order persistence
  repository OrderRepository as merge is {
    inlet OrderRepositoryFromDistributionOrder is type DistributionOrderEvent    inlet OrderRepositoryFromDistributionAnalytics is type DistributionOrderEvent    outlet OrderRepositoryResponses is type DistributionOrder.DistributionOrderResult
    record StoredDistributionOrder is  {
      distributionOrderId: UUID with {
        briefly "distributionOrderId"
        described as {
          |The distributionOrderId column of the stored distributionOrder row.
        }
      }
      customerId: CustomerId with {
        briefly "customerId"
        described as {
          |The customerId column of the stored distributionOrder row.
        }
      }
      orderId: OrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored distributionOrder row.
        }
      }
    } with {
      briefly "Stored distributionOrder row"
      described as {
        |The persistence shape of distributionOrder data as this repository stores it.
      }
    }
    schema OrderData is relational
      of orders as type StoredDistributionOrder
        index on field StoredDistributionOrder.customerId
        index on field StoredDistributionOrder.orderId
 with {
      briefly "Order data schema"
      described as {
        |The relational schema holding order data for the OrderRepository.
      }
    }
    handler OrderPersistence is {
      on query GetCustomerOrderMetrics is {
        let customerOrderMetricsView: type CustomerOrderMetricsView = prompt("read the customer order metrics projection")
        reply customerOrderMetricsView
      }
      on createOrder: command DistributionOrder.CreateOrder is {
        tell event DistributionOrder.OrderCreated(orderId = createOrder.orderId, customerId = createOrder.customerId) to entity DistributionContext.DistributionOrder
        do "Persist new order"
      }
      on command DistributionOrder.AllocateInventory is {
        do "Update allocation status"
      }
      on confirmOrder: command DistributionOrder.ConfirmOrder is {
        tell event DistributionOrder.OrderConfirmed(orderId = confirmOrder.orderId, confirmedBy = confirmOrder.confirmedBy) to entity DistributionContext.DistributionOrder
        do "Update order status"
      }
      on shipOrder: command DistributionOrder.ShipOrder is {
        tell event DistributionOrder.OrderShipped(orderId = shipOrder.orderId, shipment = shipOrder.shipment) to entity DistributionContext.DistributionOrder
        do "Record shipment"
      }
      on deliverOrder: command DistributionOrder.DeliverOrder is {
        tell event DistributionOrder.OrderDelivered(orderId = deliverOrder.orderId, deliveredAt = deliverOrder.deliveredAt, receivedBy = deliverOrder.receivedBy) to entity DistributionContext.DistributionOrder
        do "Record delivery"
      }
      on cancelOrder: command DistributionOrder.CancelOrder is {
        tell event DistributionOrder.OrderCancelled(orderId = cancelOrder.orderId, reason = cancelOrder.reason) to entity DistributionContext.DistributionOrder
        do "Mark order cancelled"
      }
    } with {
      briefly "Persists order commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Order data persistence"
    described as {
      | The OrderRepository provides persistent storage for
      | distribution orders.
    }
  }
  // Projector for distribution analytics
  query GetCustomerOrderMetrics is  {
    customerOrderMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which customer order metrics to retrieve.
      }
    }
  } with {
    briefly "Get customer order metrics"
    described as {
      |Retrieves the customer order metrics projection.
    }
  }
  result CustomerOrderMetricsView is  {
    customerOrderMetrics: DistributionAnalytics.CustomerOrderMetrics with {
      briefly "Customer order metrics"
      described as {
        |The customer order metrics being returned.
      }
    }
  } with {
    briefly "Customer order metrics view"
    described as {
      |Read model view carrying the customer order metrics projection.
    }
  }
  projector DistributionAnalytics as flow is {
    updates repository DistributionContext.OrderRepository
    inlet DistributionAnalyticsFromDistributionOrder is type DistributionOrderEvent    outlet DistributionAnalyticsOut is type DistributionOrderEvent
    record CustomerOrderMetrics is  {
      customerId: CustomerId with {
        briefly "Customer"
        described as {
          |Customer ID.
        }
      }
      totalOrders: Natural with {
        briefly "Orders"
        described as {
          |Total orders.
        }
      }
      totalRevenue: Money with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      avgOrderValue: Money with {
        briefly "AOV"
        described as {
          |Average order value.
        }
      }
    } with {
      briefly "Customer order metrics"
      described as {
        |Aggregated customer order data.
      }
    }
    handler AnalyticsHandler is {
      on orderDelivered: event DistributionOrder.OrderDelivered is {
        tell orderDelivered to repository DistributionContext.OrderRepository
        do "Update customer metrics"
      }
    } with {
      briefly "Maintains analytics views"
      described as {
        |Projects events into analytics.
      }
    }
  } with {
    briefly "Distribution analytics projections"
    described as {
      |Maintains order analytics data.
    }
  }
  // ---- Event publication for DistributionOrder ----
  type DistributionOrderEvent is one of {
    DistributionContext.DistributionOrder.OrderCreated or DistributionContext.DistributionOrder.InventoryAllocated or DistributionContext.DistributionOrder.OrderConfirmed or DistributionContext.DistributionOrder.OrderShipped or DistributionContext.DistributionOrder.OrderDelivered or DistributionContext.DistributionOrder.OrderCancelled
  } with {
    briefly "DistributionOrder event alternation"
    described as {
      |Union of all DistributionOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor DistributionOrderEventSource as source is {
    outlet DistributionOrderEvents is type DistributionOrderEvent
    handler DistributionOrderSourceHandler is {
      on orderCreated: event DistributionOrder.OrderCreated is {
        send orderCreated to outlet DistributionOrderEvents
      }
      on inventoryAllocated: event DistributionOrder.InventoryAllocated is {
        send inventoryAllocated to outlet DistributionOrderEvents
      }
      on orderConfirmed: event DistributionOrder.OrderConfirmed is {
        send orderConfirmed to outlet DistributionOrderEvents
      }
      on orderShipped: event DistributionOrder.OrderShipped is {
        send orderShipped to outlet DistributionOrderEvents
      }
      on orderDelivered: event DistributionOrder.OrderDelivered is {
        send orderDelivered to outlet DistributionOrderEvents
      }
      on orderCancelled: event DistributionOrder.OrderCancelled is {
        send orderCancelled to outlet DistributionOrderEvents
      }
      on other is {
        error "Unexpected message for source DistributionOrderEventSource"
      }
    } with {
      briefly "DistributionOrder source handler"
      described as {
        |Publishes DistributionOrder events onto the outlet.
      }
    }
  } with {
    briefly "DistributionOrder event source"
    described as {
      |Publishes DistributionOrder entity events into the streaming topology.
    }
  }
  processor DistributionOrderEventSink as sink is {
    inlet DistributionOrderInlet is type DistributionOrderEvent    handler DistributionOrderSinkHandler is {
      on orderCreated: event DistributionOrder.OrderCreated is {
        tell orderCreated to repository DistributionContext.OrderRepository
      }
      on inventoryAllocated: event DistributionOrder.InventoryAllocated is {
        tell inventoryAllocated to repository DistributionContext.OrderRepository
      }
      on orderConfirmed: event DistributionOrder.OrderConfirmed is {
        tell orderConfirmed to repository DistributionContext.OrderRepository
      }
      on orderShipped: event DistributionOrder.OrderShipped is {
        tell orderShipped to repository DistributionContext.OrderRepository
      }
      on orderDelivered: event DistributionOrder.OrderDelivered is {
        tell orderDelivered to repository DistributionContext.OrderRepository
      }
      on orderCancelled: event DistributionOrder.OrderCancelled is {
        tell orderCancelled to repository DistributionContext.OrderRepository
      }
      on other is {
        error "Unexpected message for sink DistributionOrderEventSink"
      }
    } with {
      briefly "DistributionOrder sink handler"
      described as {
        |Persists DistributionOrder events via the repository.
      }
    }
  } with {
    briefly "DistributionOrder event sink"
    described as {
      |Receives DistributionOrder events for persistence.
    }
  }
  connector DistributionOrderEventFlow is from outlet DistributionContext.DistributionOrderEventSource.DistributionOrderEvents to inlet DistributionContext.DistributionOrderEventSink.DistributionOrderInlet with {
    briefly "DistributionOrder event flow"
    described as {
      |Connects the DistributionOrder source to its sink.
    }
  }
  processor DistributionOrderEventSplit as split is {
    inlet DistributionOrderEventSplitIn is type DistributionOrderEvent    outlet DistributionOrderEventSplitToOrderRepository is type DistributionOrderEvent
    outlet DistributionOrderEventSplitToDistributionAnalytics is type DistributionOrderEvent
    handler DistributionOrderEventSplitHandler is {
      on orderCreated: event DistributionOrder.OrderCreated is {
        send orderCreated to outlet DistributionOrderEventSplitToOrderRepository
        send orderCreated to outlet DistributionOrderEventSplitToDistributionAnalytics
        tell orderCreated to entity DistributionContext.DistributionOrder
      }
      on inventoryAllocated: event DistributionOrder.InventoryAllocated is {
        send inventoryAllocated to outlet DistributionOrderEventSplitToOrderRepository
        send inventoryAllocated to outlet DistributionOrderEventSplitToDistributionAnalytics
        tell inventoryAllocated to entity DistributionContext.DistributionOrder
      }
      on orderConfirmed: event DistributionOrder.OrderConfirmed is {
        send orderConfirmed to outlet DistributionOrderEventSplitToOrderRepository
        send orderConfirmed to outlet DistributionOrderEventSplitToDistributionAnalytics
        tell orderConfirmed to entity DistributionContext.DistributionOrder
      }
      on orderShipped: event DistributionOrder.OrderShipped is {
        send orderShipped to outlet DistributionOrderEventSplitToOrderRepository
        send orderShipped to outlet DistributionOrderEventSplitToDistributionAnalytics
        tell orderShipped to entity DistributionContext.DistributionOrder
      }
      on orderDelivered: event DistributionOrder.OrderDelivered is {
        send orderDelivered to outlet DistributionOrderEventSplitToOrderRepository
        send orderDelivered to outlet DistributionOrderEventSplitToDistributionAnalytics
        tell orderDelivered to entity DistributionContext.DistributionOrder
      }
      on orderCancelled: event DistributionOrder.OrderCancelled is {
        send orderCancelled to outlet DistributionOrderEventSplitToOrderRepository
        send orderCancelled to outlet DistributionOrderEventSplitToDistributionAnalytics
        tell orderCancelled to entity DistributionContext.DistributionOrder
      }
      on other is {
        error "Unexpected message for processor DistributionOrderEventSplit"
      }
    } with {
      briefly "DistributionOrder event fan-out handler"
      described as {
        |Delivers each DistributionOrder event to all of its consumers.
      }
    }
  } with {
    briefly "DistributionOrder event fan-out"
    described as {
      |Fans DistributionOrder events out to the repository and projectors.
    }
  }
  connector 'DistributionOrderEvent Stream' is from outlet DistributionContext.DistributionOrder.DistributionOrderEvents2 to inlet DistributionContext.DistributionOrderEventSplit.DistributionOrderEventSplitIn with {
    briefly "DistributionOrder events, fanned out to storage and read models"
  }
  connector 'DistributionOrderEvent Storage' is from outlet DistributionContext.DistributionOrderEventSplit.DistributionOrderEventSplitToOrderRepository to inlet DistributionContext.OrderRepository.OrderRepositoryFromDistributionOrder with {
    briefly "DistributionOrder events on their way to storage"
  }
  connector 'DistributionAnalytics Feed' is from outlet DistributionContext.DistributionOrderEventSplit.DistributionOrderEventSplitToDistributionAnalytics to inlet DistributionContext.DistributionAnalytics.DistributionAnalyticsFromDistributionOrder with {
    briefly "DistributionOrder events feeding the DistributionAnalytics projection"
  }
  connector 'DistributionAnalytics Storage' is from outlet DistributionContext.DistributionAnalytics.DistributionAnalyticsOut to inlet DistributionContext.OrderRepository.OrderRepositoryFromDistributionAnalytics with {
    briefly "The DistributionAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for distribution"
  described as {
    | The DistributionContext is the bounded context for wholesale
    | distribution. It manages orders, allocation, and fulfillment.
  }
}
