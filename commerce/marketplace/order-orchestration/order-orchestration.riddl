// Order Orchestration Domain Model
// Marketplace order splitting, routing, and multi-vendor coordination
domain OrderOrchestration is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Customer is "a marketplace customer placing orders" with {
    briefly "Marketplace customer"
    described as {
      |A customer ordering from multiple vendors.
    }
  }
  user OperationsTeam is "staff managing order routing and exceptions" with {
    briefly "Operations staff"
    described as {
      |Team handling order exceptions and routing issues.
    }
  }
  epic PlaceOrderEpic is {
    user Customer wants to "to checkout with items from multiple vendors" so that "they receive a single unified order experience"
    case MultiVendorCheckout is {
      user Customer wants to "to complete a multi-vendor purchase" so that "items from different sellers arrive as expected"
      step is "Customer submits checkout" "with items from multiple vendors" "for purchase" with {
        briefly "Submit checkout"
        described as {
          |Customer initiates checkout.
        }
      }
      step is "System splits order by vendor" "creating sub-orders for each seller" "for fulfillment" with {
        briefly "Split order"
        described as {
          |System creates vendor sub-orders.
        }
      }
      step take input OrderOrchestrationApp.OrderOrchestrationScreen.CreateOrderInput from user Customer with {
        briefly "Create order"
        described as {
          |Send create order command.
        }
      }
      step is "System routes sub-orders to vendors" "notifying each seller" "of their items" with {
        briefly "Route orders"
        described as {
          |System sends to vendors.
        }
      }
    } with {
      briefly "Multi-vendor checkout flow"
      described as {
        |Standard checkout with order splitting across vendors.
      }
    }
  } with {
    briefly "Marketplace order placement"
    described as {
      | Epic covering the multi-vendor checkout workflow including order
      | splitting, routing, and consolidated customer communication.
    }
  }
  include "OrchestrationContext.riddl"
  include "external-contexts.riddl"
  application context OrderOrchestrationApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in OrderOrchestration are delivered.
      }
    }
    group OrderOrchestrationScreen is {
      input CreateOrderInput acquires command OrchestrationContext.MarketplaceOrder.CreateOrder with {
        briefly "Create order control"
        described as {
          |The control through which a user submits the create order request.
        }
      }
    } with {
      briefly "Order orchestration screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppMarketplaceOrderCommands is type OrchestrationContext.MarketplaceOrder.MarketplaceOrderCommand
    inlet AppOrderRepositoryResponses is type OrchestrationContext.MarketplaceOrder.MarketplaceOrderResult    handler OrderOrchestrationAppHandler is {
      on other is {
        error "Unexpected message for application context OrderOrchestrationApp"
      }
    } with {
      briefly "OrderOrchestrationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "OrderOrchestrationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'MarketplaceOrderCommand Stream' is from outlet OrderOrchestrationApp.AppMarketplaceOrderCommands to inlet OrchestrationContext.MarketplaceOrder.MarketplaceOrderCommands with {
    briefly "MarketplaceOrder commands from the application"
  }
  persistent connector 'MarketplaceOrderResult Stream' is from outlet OrchestrationContext.OrderRepository.OrderRepositoryResponses to inlet OrderOrchestrationApp.AppOrderRepositoryResponses with {
    briefly "Order query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet OrderOrchestrationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Order orchestration domain"
  described as {
    | The OrderOrchestration domain manages marketplace order lifecycle
    | including splitting orders across vendors, tracking fulfillment,
    | and coordinating delivery of multi-vendor purchases.
  }
}
