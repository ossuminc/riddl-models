// Order Orchestration - Orchestration Context
context OrchestrationContext is {
  adaptor FromInventoryService from context InventoryService is { 
    handler FromInventoryServiceHandler is {
      on event InventoryService.StockReserved is {
        do "the model receives stock reserved"
      }
      on event InventoryService.StockUnavailable is {
        do "the model receives stock unavailable"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor ToInventoryService to context InventoryService is { 
    handler ToInventoryServiceHandler is {
      on command InventoryService.ReserveStock is {
        do "the model sends reserve stock"
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryService"
      }
    } with {
      briefly "to inventory service"
      described as {
        |Carries messages to the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentService from context PaymentService is { 
    handler FromPaymentServiceHandler is {
      on event PaymentService.PaymentCaptured is {
        do "the model receives payment captured"
      }
      on event PaymentService.PaymentRefunded is {
        do "the model receives payment refunded"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentService"
      }
    } with {
      briefly "from payment service"
      described as {
        |Carries messages from the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor FromVendorService from context VendorService is { 
    handler FromVendorServiceHandler is {
      on event VendorService.VendorConfirmed is {
        do "the model receives vendor confirmed"
      }
      on event VendorService.VendorShipped is {
        do "the model receives vendor shipped"
      }
      on other is {
        error "Unexpected message for adaptor FromVendorService"
      }
    } with {
      briefly "from vendor service"
      described as {
        |Carries messages from the external VendorService.
      }
    }
  } with {
    briefly "VendorService integration"
    described as {
      |The model's side of the VendorService conversation.
    }
  }
  include "types.riddl"
  include "MarketplaceOrder.riddl"
  // Adaptors for external system integration
  adaptor VendorAdapter to context VendorService is { 
    handler VendorRouting is {
      on command VendorService.NotifyNewSubOrder is {
        do "Route sub-orders to vendors"
      }
      on other is {
        error "Unexpected message for adaptor VendorAdapter"
      }
    } with {
      briefly "Handles vendor routing"
      described as {
        |Routes sub-orders to vendors.
      }
    }
  } with {
    briefly "Vendor integration"
    described as {
      |Publishes sub-orders to vendor systems.
    }
  }
  adaptor PaymentAdapter to context PaymentService is { 
    handler PaymentProcessing is {
      on command PaymentService.CapturePayment is {
        do "Capture payment for order"
      }
      on command PaymentService.RefundPayment is {
        do "Process refund for cancelled order"
      }
      on other is {
        error "Unexpected message for adaptor PaymentAdapter"
      }
    } with {
      briefly "Handles payment processing"
      described as {
        |Processes payments and refunds.
      }
    }
  } with {
    briefly "Payment integration"
    described as {
      |Manages payment capture and refunds.
    }
  }
  adaptor NotificationAdapter to context NotificationService is { 
    handler CustomerNotifications is {
      on command NotificationService.SendOrderConfirmation is {
        do "Send order confirmation to customer"
      }
      on command NotificationService.SendShippingUpdate is {
        do "Send shipping notification with tracking"
      }
      on other is {
        error "Unexpected message for adaptor NotificationAdapter"
      }
    } with {
      briefly "Handles customer notifications"
      described as {
        |Sends order status updates to customers.
      }
    }
  } with {
    briefly "Notification integration"
    described as {
      |Publishes order events for customer notifications.
    }
  }
  // Repository for order persistence
  repository OrderRepository is {
    inlet OrderRepositoryFromMarketplaceOrder is type MarketplaceOrderEvent    inlet OrderRepositoryFromOrderAnalytics is type MarketplaceOrderEvent    outlet OrderRepositoryResponses is type MarketplaceOrder.MarketplaceOrderResult
    record StoredMarketplaceOrder is  {
      marketplaceOrderId: UUID with {
        briefly "marketplaceOrderId"
        described as {
          |The marketplaceOrderId column of the stored marketplaceOrder row.
        }
      }
      customerId: CustomerId with {
        briefly "customerId"
        described as {
          |The customerId column of the stored marketplaceOrder row.
        }
      }
      orderId: OrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored marketplaceOrder row.
        }
      }
    } with {
      briefly "Stored marketplaceOrder row"
      described as {
        |The persistence shape of marketplaceOrder data as this repository stores it.
      }
    }
    schema OrderData is relational
      of orders as type StoredMarketplaceOrder
        index on field StoredMarketplaceOrder.customerId
        index on field StoredMarketplaceOrder.orderId
 with {
      briefly "Order data schema"
      described as {
        |The relational schema holding order data for the OrderRepository.
      }
    }
    handler OrderPersistence is {
      on query GetVendorFulfillmentMetrics is {
        do "read the vendor fulfillment metrics projection"
        yield result VendorFulfillmentMetricsView
      }
      on command MarketplaceOrder.CreateOrder is {
        tell event MarketplaceOrder.OrderCreated to entity OrchestrationContext.MarketplaceOrder
        do "Persist new order with sub-orders"
      }
      on command MarketplaceOrder.AcknowledgeSubOrder is {
        tell event MarketplaceOrder.SubOrderAcknowledged to entity OrchestrationContext.MarketplaceOrder
        do "Update sub-order status to acknowledged"
      }
      on command MarketplaceOrder.ShipSubOrder is {
        tell event MarketplaceOrder.SubOrderShipped to entity OrchestrationContext.MarketplaceOrder
        do "Update sub-order with shipping info"
      }
      on command MarketplaceOrder.ConfirmDelivery is {
        do "Update sub-order status to delivered"
      }
      on command MarketplaceOrder.CancelSubOrder is {
        tell event MarketplaceOrder.SubOrderCancelled to entity OrchestrationContext.MarketplaceOrder
        do "Update sub-order status to cancelled"
      }
      on command MarketplaceOrder.CancelOrder is {
        tell event MarketplaceOrder.OrderCancelled to entity OrchestrationContext.MarketplaceOrder
        do "Update order status to cancelled"
      }
    } with {
      briefly "Persists order commands"
      described as {
        |Handles command-driven persistence for orders.
      }
    }
  } with {
    briefly "Order data persistence"
    described as {
      | The OrderRepository provides persistent storage for marketplace
      | orders with indexes for customer and order lookup.
    }
  }
  // Projector for order analytics
  query GetVendorFulfillmentMetrics is  {
    vendorFulfillmentMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which vendor fulfillment metrics to retrieve.
      }
    }
  } with {
    briefly "Get vendor fulfillment metrics"
    described as {
      |Retrieves the vendor fulfillment metrics projection.
    }
  }
  result VendorFulfillmentMetricsView is  {
    vendorFulfillmentMetrics: OrderAnalytics.VendorFulfillmentMetrics with {
      briefly "Vendor fulfillment metrics"
      described as {
        |The vendor fulfillment metrics being returned.
      }
    }
  } with {
    briefly "Vendor fulfillment metrics view"
    described as {
      |Read model view carrying the vendor fulfillment metrics projection.
    }
  }
  projector OrderAnalytics is {
    updates repository OrchestrationContext.OrderRepository
    inlet OrderAnalyticsFromMarketplaceOrder is type MarketplaceOrderEvent    outlet OrderAnalyticsOut is type MarketplaceOrderEvent
    record VendorFulfillmentMetrics is  {
      vendorId: VendorId with {
        briefly "Vendor"
        described as {
          |Vendor identifier.
        }
      }
      totalOrders: Natural with {
        briefly "Orders"
        described as {
          |Total orders.
        }
      }
      avgFulfillmentTime: Duration with {
        briefly "Avg time"
        described as {
          |Average fulfillment.
        }
      }
      onTimeRate: Decimal(5,2) with {
        briefly "On-time"
        described as {
          |On-time percentage.
        }
      }
    } with {
      briefly "Vendor fulfillment metrics"
      described as {
        |Fulfillment performance for a vendor.
      }
    }
    handler AnalyticsHandler is {
      on event MarketplaceOrder.SubOrderDelivered is {
        tell event MarketplaceOrder.SubOrderDelivered to repository OrchestrationContext.OrderRepository
        do "Update vendor fulfillment metrics"
      }
      on event MarketplaceOrder.OrderCompleted is {
        tell event MarketplaceOrder.OrderCompleted to repository OrchestrationContext.OrderRepository
        do "Update overall marketplace metrics"
      }
    } with {
      briefly "Maintains analytics views"
      described as {
        |Projects events into analytics data.
      }
    }
  } with {
    briefly "Order analytics projections"
    described as {
      |Maintains fulfillment analytics for marketplace.
    }
  }
  // ---- Event publication for MarketplaceOrder ----
  type MarketplaceOrderEvent is one of {
    OrchestrationContext.MarketplaceOrder.OrderCreated or OrchestrationContext.MarketplaceOrder.SubOrderRouted or OrchestrationContext.MarketplaceOrder.SubOrderAcknowledged or OrchestrationContext.MarketplaceOrder.SubOrderShipped or OrchestrationContext.MarketplaceOrder.SubOrderDelivered or OrchestrationContext.MarketplaceOrder.SubOrderCancelled or OrchestrationContext.MarketplaceOrder.OrderCompleted or OrchestrationContext.MarketplaceOrder.OrderCancelled
  } with {
    briefly "MarketplaceOrder event alternation"
    described as {
      |Union of all MarketplaceOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor MarketplaceOrderEventSource as source is {
    outlet MarketplaceOrderEvents is type MarketplaceOrderEvent
    handler MarketplaceOrderSourceHandler is {
      on event MarketplaceOrder.OrderCreated is {
        send event MarketplaceOrder.OrderCreated to outlet MarketplaceOrderEvents
      }
      on event MarketplaceOrder.SubOrderRouted is {
        send event MarketplaceOrder.SubOrderRouted to outlet MarketplaceOrderEvents
      }
      on event MarketplaceOrder.SubOrderAcknowledged is {
        send event MarketplaceOrder.SubOrderAcknowledged to outlet MarketplaceOrderEvents
      }
      on event MarketplaceOrder.SubOrderShipped is {
        send event MarketplaceOrder.SubOrderShipped to outlet MarketplaceOrderEvents
      }
      on event MarketplaceOrder.SubOrderDelivered is {
        send event MarketplaceOrder.SubOrderDelivered to outlet MarketplaceOrderEvents
      }
      on event MarketplaceOrder.SubOrderCancelled is {
        send event MarketplaceOrder.SubOrderCancelled to outlet MarketplaceOrderEvents
      }
      on event MarketplaceOrder.OrderCompleted is {
        send event MarketplaceOrder.OrderCompleted to outlet MarketplaceOrderEvents
      }
      on event MarketplaceOrder.OrderCancelled is {
        send event MarketplaceOrder.OrderCancelled to outlet MarketplaceOrderEvents
      }
      on other is {
        error "Unexpected message for source MarketplaceOrderEventSource"
      }
    } with {
      briefly "MarketplaceOrder source handler"
      described as {
        |Publishes MarketplaceOrder events onto the outlet.
      }
    }
  } with {
    briefly "MarketplaceOrder event source"
    described as {
      |Publishes MarketplaceOrder entity events into the streaming topology.
    }
  }
  processor MarketplaceOrderEventSink as sink is {
    inlet MarketplaceOrderInlet is type MarketplaceOrderEvent    handler MarketplaceOrderSinkHandler is {
      on event MarketplaceOrder.OrderCreated is {
        tell event MarketplaceOrder.OrderCreated to repository OrchestrationContext.OrderRepository
      }
      on event MarketplaceOrder.SubOrderRouted is {
        tell event MarketplaceOrder.SubOrderRouted to repository OrchestrationContext.OrderRepository
      }
      on event MarketplaceOrder.SubOrderAcknowledged is {
        tell event MarketplaceOrder.SubOrderAcknowledged to repository OrchestrationContext.OrderRepository
      }
      on event MarketplaceOrder.SubOrderShipped is {
        tell event MarketplaceOrder.SubOrderShipped to repository OrchestrationContext.OrderRepository
      }
      on event MarketplaceOrder.SubOrderDelivered is {
        tell event MarketplaceOrder.SubOrderDelivered to repository OrchestrationContext.OrderRepository
      }
      on event MarketplaceOrder.SubOrderCancelled is {
        tell event MarketplaceOrder.SubOrderCancelled to repository OrchestrationContext.OrderRepository
      }
      on event MarketplaceOrder.OrderCompleted is {
        tell event MarketplaceOrder.OrderCompleted to repository OrchestrationContext.OrderRepository
      }
      on event MarketplaceOrder.OrderCancelled is {
        tell event MarketplaceOrder.OrderCancelled to repository OrchestrationContext.OrderRepository
      }
      on other is {
        error "Unexpected message for sink MarketplaceOrderEventSink"
      }
    } with {
      briefly "MarketplaceOrder sink handler"
      described as {
        |Persists MarketplaceOrder events via the repository.
      }
    }
  } with {
    briefly "MarketplaceOrder event sink"
    described as {
      |Receives MarketplaceOrder events for persistence.
    }
  }
  connector MarketplaceOrderEventFlow is from outlet OrchestrationContext.MarketplaceOrderEventSource.MarketplaceOrderEvents to inlet OrchestrationContext.MarketplaceOrderEventSink.MarketplaceOrderInlet with {
    briefly "MarketplaceOrder event flow"
    described as {
      |Connects the MarketplaceOrder source to its sink.
    }
  }
  processor MarketplaceOrderEventSplit is {
    inlet MarketplaceOrderEventSplitIn is type MarketplaceOrderEvent    outlet MarketplaceOrderEventSplitToOrderRepository is type MarketplaceOrderEvent
    outlet MarketplaceOrderEventSplitToOrderAnalytics is type MarketplaceOrderEvent
    handler MarketplaceOrderEventSplitHandler is {
      on event MarketplaceOrder.OrderCreated is {
        send event MarketplaceOrder.OrderCreated to outlet MarketplaceOrderEventSplitToOrderRepository
        send event MarketplaceOrder.OrderCreated to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell event MarketplaceOrder.OrderCreated to entity OrchestrationContext.MarketplaceOrder
      }
      on event MarketplaceOrder.SubOrderRouted is {
        send event MarketplaceOrder.SubOrderRouted to outlet MarketplaceOrderEventSplitToOrderRepository
        send event MarketplaceOrder.SubOrderRouted to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell event MarketplaceOrder.SubOrderRouted to entity OrchestrationContext.MarketplaceOrder
      }
      on event MarketplaceOrder.SubOrderAcknowledged is {
        send event MarketplaceOrder.SubOrderAcknowledged to outlet MarketplaceOrderEventSplitToOrderRepository
        send event MarketplaceOrder.SubOrderAcknowledged to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell event MarketplaceOrder.SubOrderAcknowledged to entity OrchestrationContext.MarketplaceOrder
      }
      on event MarketplaceOrder.SubOrderShipped is {
        send event MarketplaceOrder.SubOrderShipped to outlet MarketplaceOrderEventSplitToOrderRepository
        send event MarketplaceOrder.SubOrderShipped to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell event MarketplaceOrder.SubOrderShipped to entity OrchestrationContext.MarketplaceOrder
      }
      on event MarketplaceOrder.SubOrderDelivered is {
        send event MarketplaceOrder.SubOrderDelivered to outlet MarketplaceOrderEventSplitToOrderRepository
        send event MarketplaceOrder.SubOrderDelivered to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell event MarketplaceOrder.SubOrderDelivered to entity OrchestrationContext.MarketplaceOrder
      }
      on event MarketplaceOrder.SubOrderCancelled is {
        send event MarketplaceOrder.SubOrderCancelled to outlet MarketplaceOrderEventSplitToOrderRepository
        send event MarketplaceOrder.SubOrderCancelled to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell event MarketplaceOrder.SubOrderCancelled to entity OrchestrationContext.MarketplaceOrder
      }
      on event MarketplaceOrder.OrderCompleted is {
        send event MarketplaceOrder.OrderCompleted to outlet MarketplaceOrderEventSplitToOrderRepository
        send event MarketplaceOrder.OrderCompleted to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell event MarketplaceOrder.OrderCompleted to entity OrchestrationContext.MarketplaceOrder
      }
      on event MarketplaceOrder.OrderCancelled is {
        send event MarketplaceOrder.OrderCancelled to outlet MarketplaceOrderEventSplitToOrderRepository
        send event MarketplaceOrder.OrderCancelled to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell event MarketplaceOrder.OrderCancelled to entity OrchestrationContext.MarketplaceOrder
      }
      on other is {
        error "Unexpected message for processor MarketplaceOrderEventSplit"
      }
    } with {
      briefly "MarketplaceOrder event fan-out handler"
      described as {
        |Delivers each MarketplaceOrder event to all of its consumers.
      }
    }
  } with {
    briefly "MarketplaceOrder event fan-out"
    described as {
      |Fans MarketplaceOrder events out to the repository and projectors.
    }
  }
  connector MarketplaceOrderEventStream is from outlet OrchestrationContext.MarketplaceOrder.MarketplaceOrderEvents2 to inlet OrchestrationContext.MarketplaceOrderEventSplit.MarketplaceOrderEventSplitIn with {
    briefly "MarketplaceOrder events, fanned out to storage and read models"
  }
  connector MarketplaceOrderEventStorage is from outlet OrchestrationContext.MarketplaceOrderEventSplit.MarketplaceOrderEventSplitToOrderRepository to inlet OrchestrationContext.OrderRepository.OrderRepositoryFromMarketplaceOrder with {
    briefly "MarketplaceOrder events on their way to storage"
  }
  connector OrderAnalyticsFeed is from outlet OrchestrationContext.MarketplaceOrderEventSplit.MarketplaceOrderEventSplitToOrderAnalytics to inlet OrchestrationContext.OrderAnalytics.OrderAnalyticsFromMarketplaceOrder with {
    briefly "MarketplaceOrder events feeding the OrderAnalytics projection"
  }
  connector OrderAnalyticsStorage is from outlet OrchestrationContext.OrderAnalytics.OrderAnalyticsOut to inlet OrchestrationContext.OrderRepository.OrderRepositoryFromOrderAnalytics with {
    briefly "The OrderAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for order orchestration"
  described as {
    | The OrchestrationContext is the bounded context for marketplace
    | order management. It handles order splitting, routing, and
    | multi-vendor coordination.
  }
}
