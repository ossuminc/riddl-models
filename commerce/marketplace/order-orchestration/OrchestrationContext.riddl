// Order Orchestration - Orchestration Context
context OrchestrationContext as router is {
  inlet MarketplaceOrderCommandStreaIn is type MarketplaceOrderCommand  outlet MarketplaceOrderCommandStreaOut is type MarketplaceOrderCommand
  inlet MarketplaceOrderResultStreamIn is result MarketplaceOrder.MarketplaceOrderResult  outlet MarketplaceOrderResultStreamOut is result MarketplaceOrder.MarketplaceOrderResult
  handler OrchestrationContextBoundary is {
    on createOrder: command MarketplaceOrder.CreateOrder is {
      send createOrder to outlet OrchestrationContext.MarketplaceOrderCommandStreaOut
    }
    on acknowledgeSubOrder: command MarketplaceOrder.AcknowledgeSubOrder is {
      send acknowledgeSubOrder to outlet OrchestrationContext.MarketplaceOrderCommandStreaOut
    }
    on shipSubOrder: command MarketplaceOrder.ShipSubOrder is {
      send shipSubOrder to outlet OrchestrationContext.MarketplaceOrderCommandStreaOut
    }
    on confirmDelivery: command MarketplaceOrder.ConfirmDelivery is {
      send confirmDelivery to outlet OrchestrationContext.MarketplaceOrderCommandStreaOut
    }
    on cancelSubOrder: command MarketplaceOrder.CancelSubOrder is {
      send cancelSubOrder to outlet OrchestrationContext.MarketplaceOrderCommandStreaOut
    }
    on cancelOrder: command MarketplaceOrder.CancelOrder is {
      send cancelOrder to outlet OrchestrationContext.MarketplaceOrderCommandStreaOut
    }
    on marketplaceOrderResult: result MarketplaceOrder.MarketplaceOrderResult is {
      send marketplaceOrderResult to outlet OrchestrationContext.MarketplaceOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the OrchestrationContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'MarketplaceOrderCommand Stream Intake' is from outlet OrchestrationContext.MarketplaceOrderCommandStreaOut to inlet OrchestrationContext.MarketplaceOrder.MarketplaceOrderCommands  connector 'MarketplaceOrderResult Stream Egress' is from outlet OrchestrationContext.OrderRepository.OrderRepositoryResponses to inlet OrchestrationContext.MarketplaceOrderResultStreamIn  adaptor FromInventoryService from context InventoryService is { 
    handler FromInventoryServiceHandler is {
      on event InventoryService.StockReserved is {
        do "the model receives stock reserved"
      }
      on event InventoryService.StockUnavailable is {
        do "the model receives stock unavailable"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor ToInventoryService to context InventoryService is { 
    handler ToInventoryServiceHandler is {
      on command InventoryService.ReserveStock is {
        do "the model sends reserve stock"
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryService"
      }
    } with {
      briefly "to inventory service"
      described as {
        |Carries messages to the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentService from context PaymentService is { 
    handler FromPaymentServiceHandler is {
      on event PaymentService.PaymentCaptured is {
        do "the model receives payment captured"
      }
      on event PaymentService.PaymentRefunded is {
        do "the model receives payment refunded"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentService"
      }
    } with {
      briefly "from payment service"
      described as {
        |Carries messages from the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor FromVendorService from context VendorService is { 
    handler FromVendorServiceHandler is {
      on event VendorService.VendorConfirmed is {
        do "the model receives vendor confirmed"
      }
      on event VendorService.VendorShipped is {
        do "the model receives vendor shipped"
      }
      on other is {
        error "Unexpected message for adaptor FromVendorService"
      }
    } with {
      briefly "from vendor service"
      described as {
        |Carries messages from the external VendorService.
      }
    }
  } with {
    briefly "VendorService integration"
    described as {
      |The model's side of the VendorService conversation.
    }
  }
  include "types.riddl"
  include "MarketplaceOrder.riddl"
  // Adaptors for external system integration
  adaptor VendorAdapter to context VendorService is { 
    handler VendorRouting is {
      on command VendorService.NotifyNewSubOrder is {
        do "Route sub-orders to vendors"
      }
      on other is {
        error "Unexpected message for adaptor VendorAdapter"
      }
    } with {
      briefly "Handles vendor routing"
      described as {
        |Routes sub-orders to vendors.
      }
    }
  } with {
    briefly "Vendor integration"
    described as {
      |Publishes sub-orders to vendor systems.
    }
  }
  adaptor PaymentAdapter to context PaymentService is { 
    handler PaymentProcessing is {
      on command PaymentService.CapturePayment is {
        do "Capture payment for order"
      }
      on command PaymentService.RefundPayment is {
        do "Process refund for cancelled order"
      }
      on other is {
        error "Unexpected message for adaptor PaymentAdapter"
      }
    } with {
      briefly "Handles payment processing"
      described as {
        |Processes payments and refunds.
      }
    }
  } with {
    briefly "Payment integration"
    described as {
      |Manages payment capture and refunds.
    }
  }
  adaptor NotificationAdapter to context NotificationService is { 
    handler CustomerNotifications is {
      on command NotificationService.SendOrderConfirmation is {
        do "Send order confirmation to customer"
      }
      on command NotificationService.SendShippingUpdate is {
        do "Send shipping notification with tracking"
      }
      on other is {
        error "Unexpected message for adaptor NotificationAdapter"
      }
    } with {
      briefly "Handles customer notifications"
      described as {
        |Sends order status updates to customers.
      }
    }
  } with {
    briefly "Notification integration"
    described as {
      |Publishes order events for customer notifications.
    }
  }
  // Repository for order persistence
  type OrderRepositoryCommand is one of {
    OrchestrationContext.OrderRepository.PersistOrderCancelled or OrchestrationContext.OrderRepository.PersistOrderCompleted or OrchestrationContext.OrderRepository.PersistOrderCreated or OrchestrationContext.OrderRepository.PersistSubOrderAcknowledged or OrchestrationContext.OrderRepository.PersistSubOrderCancelled or OrchestrationContext.OrderRepository.PersistSubOrderDelivered or OrchestrationContext.OrderRepository.PersistSubOrderRouted or OrchestrationContext.OrderRepository.PersistSubOrderShipped
  } with {
    briefly "Anything that writes OrderRepository"
    described as {
      |The persistence commands OrderRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository OrderRepository as flow is {
    inlet OrderRepositoryFromOrderAnalytics is type OrderRepositoryCommand
    command PersistOrderCancelled is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCancelled applies to.
        }
      }
    } with {
      briefly "Persist OrderCancelled"
      described as {
        |Instructs this repository to apply OrderCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderCreated is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCreated applies to.
        }
      }
    } with {
      briefly "Persist OrderCreated"
      described as {
        |Instructs this repository to apply OrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubOrderAcknowledged is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubOrderAcknowledged applies to.
        }
      }
    } with {
      briefly "Persist SubOrderAcknowledged"
      described as {
        |Instructs this repository to apply SubOrderAcknowledged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubOrderCancelled is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubOrderCancelled applies to.
        }
      }
    } with {
      briefly "Persist SubOrderCancelled"
      described as {
        |Instructs this repository to apply SubOrderCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubOrderRouted is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubOrderRouted applies to.
        }
      }
    } with {
      briefly "Persist SubOrderRouted"
      described as {
        |Instructs this repository to apply SubOrderRouted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubOrderShipped is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubOrderShipped applies to.
        }
      }
    } with {
      briefly "Persist SubOrderShipped"
      described as {
        |Instructs this repository to apply SubOrderShipped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderCompleted is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCompleted applies to.
        }
      }
    } with {
      briefly "Persist OrderCompleted"
      described as {
        |Instructs this repository to apply OrderCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubOrderDelivered is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubOrderDelivered applies to.
        }
      }
    } with {
      briefly "Persist SubOrderDelivered"
      described as {
        |Instructs this repository to apply SubOrderDelivered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet OrderRepositoryResponses is result MarketplaceOrder.MarketplaceOrderResult
    record StoredMarketplaceOrder is  {
      marketplaceOrderId: UUID with {
        briefly "marketplaceOrderId"
        described as {
          |The marketplaceOrderId column of the stored marketplaceOrder row.
        }
      }
      customerId: CustomerId with {
        briefly "customerId"
        described as {
          |The customerId column of the stored marketplaceOrder row.
        }
      }
      orderId: OrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored marketplaceOrder row.
        }
      }
    } with {
      briefly "Stored marketplaceOrder row"
      described as {
        |The persistence shape of marketplaceOrder data as this repository stores it.
      }
    }
    schema OrderData is relational
      of orders as record StoredMarketplaceOrder
        index on field StoredMarketplaceOrder.customerId
        index on field StoredMarketplaceOrder.orderId
 with {
      briefly "Order data schema"
      described as {
        |The relational schema holding order data for the OrderRepository.
      }
    }
    handler OrderPersistence is {
      on persistOrderCancelled: command PersistOrderCancelled is {
        do "apply OrderCancelled to the stored row"
      }
      on persistOrderCreated: command PersistOrderCreated is {
        do "apply OrderCreated to the stored row"
      }
      on persistSubOrderAcknowledged: command PersistSubOrderAcknowledged is {
        do "apply SubOrderAcknowledged to the stored row"
      }
      on persistSubOrderCancelled: command PersistSubOrderCancelled is {
        do "apply SubOrderCancelled to the stored row"
      }
      on persistSubOrderRouted: command PersistSubOrderRouted is {
        do "apply SubOrderRouted to the stored row"
      }
      on persistSubOrderShipped: command PersistSubOrderShipped is {
        do "apply SubOrderShipped to the stored row"
      }
      on persistOrderCompleted: command PersistOrderCompleted is {
        do "apply OrderCompleted to the stored row"
      }
      on persistSubOrderDelivered: command PersistSubOrderDelivered is {
        do "apply SubOrderDelivered to the stored row"
      }
      on query GetVendorFulfillmentMetrics is {
        let vendorFulfillmentMetricsView: type VendorFulfillmentMetricsView = prompt("read the vendor fulfillment metrics projection")
        reply vendorFulfillmentMetricsView
      }
    } with {
      briefly "Persists order commands"
      described as {
        |Handles command-driven persistence for orders.
      }
    }
  } with {
    briefly "Order data persistence"
    described as {
      | The OrderRepository provides persistent storage for marketplace
      | orders with indexes for customer and order lookup.
    }
  }
  // Projector for order analytics
  query GetVendorFulfillmentMetrics replies result VendorFulfillmentMetricsView is  {
    vendorFulfillmentMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which vendor fulfillment metrics to retrieve.
      }
    }
  } with {
    briefly "Get vendor fulfillment metrics"
    described as {
      |Retrieves the vendor fulfillment metrics projection.
    }
  }
  result VendorFulfillmentMetricsView is  {
    vendorFulfillmentMetrics: OrderAnalytics.VendorFulfillmentMetrics with {
      briefly "Vendor fulfillment metrics"
      described as {
        |The vendor fulfillment metrics being returned.
      }
    }
  } with {
    briefly "Vendor fulfillment metrics view"
    described as {
      |Read model view carrying the vendor fulfillment metrics projection.
    }
  }
  projector OrderAnalytics as flow is {
    outlet OrderAnalyticsToRepository is type OrderRepositoryCommand
    updates repository OrchestrationContext.OrderRepository
    inlet OrderAnalyticsFromMarketplaceOrder is type MarketplaceOrderEvent
    record VendorFulfillmentMetrics is  {
      vendorId: VendorId with {
        briefly "Vendor"
        described as {
          |Vendor identifier.
        }
      }
      totalOrders: Natural with {
        briefly "Orders"
        described as {
          |Total orders.
        }
      }
      avgFulfillmentTime: Duration with {
        briefly "Avg time"
        described as {
          |Average fulfillment.
        }
      }
      onTimeRate: Decimal(5,2) with {
        briefly "On-time"
        described as {
          |On-time percentage.
        }
      }
    } with {
      briefly "Vendor fulfillment metrics"
      described as {
        |Fulfillment performance for a vendor.
      }
    }
    handler AnalyticsHandler is {
      on orderCancelled: event MarketplaceOrder.OrderCancelled is {
        tell command OrchestrationContext.OrderRepository.PersistOrderCancelled(orderId = orderCancelled.orderId) to repository OrchestrationContext.OrderRepository
        do "apply OrderCancelled to the OrderAnalytics projection"
      }
      on orderCreated: event MarketplaceOrder.OrderCreated is {
        tell command OrchestrationContext.OrderRepository.PersistOrderCreated(orderId = orderCreated.orderId) to repository OrchestrationContext.OrderRepository
        do "apply OrderCreated to the OrderAnalytics projection"
      }
      on subOrderAcknowledged: event MarketplaceOrder.SubOrderAcknowledged is {
        tell command OrchestrationContext.OrderRepository.PersistSubOrderAcknowledged(orderId = subOrderAcknowledged.orderId) to repository OrchestrationContext.OrderRepository
        do "apply SubOrderAcknowledged to the OrderAnalytics projection"
      }
      on subOrderCancelled: event MarketplaceOrder.SubOrderCancelled is {
        tell command OrchestrationContext.OrderRepository.PersistSubOrderCancelled(orderId = subOrderCancelled.orderId) to repository OrchestrationContext.OrderRepository
        do "apply SubOrderCancelled to the OrderAnalytics projection"
      }
      on subOrderRouted: event MarketplaceOrder.SubOrderRouted is {
        tell command OrchestrationContext.OrderRepository.PersistSubOrderRouted(orderId = subOrderRouted.orderId) to repository OrchestrationContext.OrderRepository
        do "apply SubOrderRouted to the OrderAnalytics projection"
      }
      on subOrderShipped: event MarketplaceOrder.SubOrderShipped is {
        tell command OrchestrationContext.OrderRepository.PersistSubOrderShipped(orderId = subOrderShipped.orderId) to repository OrchestrationContext.OrderRepository
        do "apply SubOrderShipped to the OrderAnalytics projection"
      }
      on subOrderDelivered: event MarketplaceOrder.SubOrderDelivered is {
        tell command OrchestrationContext.OrderRepository.PersistSubOrderDelivered(orderId = subOrderDelivered.orderId) to repository OrchestrationContext.OrderRepository
        do "Update vendor fulfillment metrics"
      }
      on orderCompleted: event MarketplaceOrder.OrderCompleted is {
        tell command OrchestrationContext.OrderRepository.PersistOrderCompleted(orderId = orderCompleted.orderId) to repository OrchestrationContext.OrderRepository
        do "Update overall marketplace metrics"
      }
    } with {
      briefly "Maintains analytics views"
      described as {
        |Projects events into analytics data.
      }
    }
  } with {
    briefly "Order analytics projections"
    described as {
      |Maintains fulfillment analytics for marketplace.
    }
  }
  // ---- Event publication for MarketplaceOrder ----
  type MarketplaceOrderEvent is one of {
    OrchestrationContext.MarketplaceOrder.OrderCreated or OrchestrationContext.MarketplaceOrder.SubOrderRouted or OrchestrationContext.MarketplaceOrder.SubOrderAcknowledged or OrchestrationContext.MarketplaceOrder.SubOrderShipped or OrchestrationContext.MarketplaceOrder.SubOrderDelivered or OrchestrationContext.MarketplaceOrder.SubOrderCancelled or OrchestrationContext.MarketplaceOrder.OrderCompleted or OrchestrationContext.MarketplaceOrder.OrderCancelled
  } with {
    briefly "MarketplaceOrder event alternation"
    described as {
      |Union of all MarketplaceOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor MarketplaceOrderEventSplit as flow is {
    inlet MarketplaceOrderEventSplitIn is type MarketplaceOrderEvent
    outlet MarketplaceOrderEventSplitToOrderAnalytics is type MarketplaceOrderEvent
    handler MarketplaceOrderEventSplitHandler is {
      on orderCreated: event MarketplaceOrder.OrderCreated is {
        send orderCreated to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell orderCreated to entity OrchestrationContext.MarketplaceOrder
      }
      on subOrderRouted: event MarketplaceOrder.SubOrderRouted is {
        send subOrderRouted to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell subOrderRouted to entity OrchestrationContext.MarketplaceOrder
      }
      on subOrderAcknowledged: event MarketplaceOrder.SubOrderAcknowledged is {
        send subOrderAcknowledged to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell subOrderAcknowledged to entity OrchestrationContext.MarketplaceOrder
      }
      on subOrderShipped: event MarketplaceOrder.SubOrderShipped is {
        send subOrderShipped to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell subOrderShipped to entity OrchestrationContext.MarketplaceOrder
      }
      on subOrderDelivered: event MarketplaceOrder.SubOrderDelivered is {
        send subOrderDelivered to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell subOrderDelivered to entity OrchestrationContext.MarketplaceOrder
      }
      on subOrderCancelled: event MarketplaceOrder.SubOrderCancelled is {
        send subOrderCancelled to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell subOrderCancelled to entity OrchestrationContext.MarketplaceOrder
      }
      on orderCompleted: event MarketplaceOrder.OrderCompleted is {
        send orderCompleted to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell orderCompleted to entity OrchestrationContext.MarketplaceOrder
      }
      on orderCancelled: event MarketplaceOrder.OrderCancelled is {
        send orderCancelled to outlet MarketplaceOrderEventSplitToOrderAnalytics
        tell orderCancelled to entity OrchestrationContext.MarketplaceOrder
      }
      on other is {
        error "Unexpected message for processor MarketplaceOrderEventSplit"
      }
    } with {
      briefly "MarketplaceOrder event fan-out handler"
      described as {
        |Delivers each MarketplaceOrder event to all of its consumers.
      }
    }
  } with {
    briefly "MarketplaceOrder event fan-out"
    described as {
      |Fans MarketplaceOrder events out to the repository and projectors.
    }
  }
  connector 'MarketplaceOrderEvent Stream' is from outlet OrchestrationContext.MarketplaceOrder.MarketplaceOrderEvents2 to inlet OrchestrationContext.MarketplaceOrderEventSplit.MarketplaceOrderEventSplitIn with {
    briefly "MarketplaceOrder events, fanned out to storage and read models"
  }
  connector 'OrderAnalytics Feed' is from outlet OrchestrationContext.MarketplaceOrderEventSplit.MarketplaceOrderEventSplitToOrderAnalytics to inlet OrchestrationContext.OrderAnalytics.OrderAnalyticsFromMarketplaceOrder with {
    briefly "MarketplaceOrder events feeding the OrderAnalytics projection"
  }
  connector 'OrderAnalytics Storage' is from outlet OrchestrationContext.OrderAnalytics.OrderAnalyticsToRepository to inlet OrchestrationContext.OrderRepository.OrderRepositoryFromOrderAnalytics with {
    briefly "OrderAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for order orchestration"
  described as {
    | The OrchestrationContext is the bounded context for marketplace
    | order management. It handles order splitting, routing, and
    | multi-vendor coordination.
  }
}
