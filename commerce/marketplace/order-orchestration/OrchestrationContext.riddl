// Order Orchestration - Orchestration Context
context OrchestrationContext is {
  include "types.riddl"
  include "MarketplaceOrder.riddl"
  // Adaptors for external system integration
  adaptor VendorAdapter to context VendorService is { 
    handler VendorRouting is {
      on command VendorService.NotifyNewSubOrder is {
        prompt "Route sub-orders to vendors"
      }
      on other is {
        error "Unexpected message for adaptor VendorAdapter"
      }
    } with {
      briefly "Handles vendor routing"
      described as {
        |Routes sub-orders to vendors.
      }
    }
  } with {
    briefly "Vendor integration"
    described as {
      |Publishes sub-orders to vendor systems.
    }
  }
  adaptor PaymentAdapter to context PaymentService is { 
    handler PaymentProcessing is {
      on command PaymentService.CapturePayment is {
        prompt "Capture payment for order"
      }
      on command PaymentService.RefundPayment is {
        prompt "Process refund for cancelled order"
      }
      on other is {
        error "Unexpected message for adaptor PaymentAdapter"
      }
    } with {
      briefly "Handles payment processing"
      described as {
        |Processes payments and refunds.
      }
    }
  } with {
    briefly "Payment integration"
    described as {
      |Manages payment capture and refunds.
    }
  }
  adaptor NotificationAdapter to context NotificationService is { 
    handler CustomerNotifications is {
      on command NotificationService.SendOrderConfirmation is {
        prompt "Send order confirmation to customer"
      }
      on command NotificationService.SendShippingUpdate is {
        prompt "Send shipping notification with tracking"
      }
      on other is {
        error "Unexpected message for adaptor NotificationAdapter"
      }
    } with {
      briefly "Handles customer notifications"
      described as {
        |Sends order status updates to customers.
      }
    }
  } with {
    briefly "Notification integration"
    described as {
      |Publishes order events for customer notifications.
    }
  }
  // Repository for order persistence
  repository OrderRepository is {
    schema OrderData is relational
      of orders as type MarketplaceOrder
        index on field MarketplaceOrder.customerId
        index on field MarketplaceOrder.orderId

    handler OrderPersistence is {
      on command MarketplaceOrder.CreateOrder is {
        tell event MarketplaceOrder.OrderCreated to entity OrchestrationContext.MarketplaceOrder
        prompt "Persist new order with sub-orders"
      }
      on command MarketplaceOrder.AcknowledgeSubOrder is {
        tell event MarketplaceOrder.SubOrderAcknowledged to entity OrchestrationContext.MarketplaceOrder
        prompt "Update sub-order status to acknowledged"
      }
      on command MarketplaceOrder.ShipSubOrder is {
        tell event MarketplaceOrder.SubOrderShipped to entity OrchestrationContext.MarketplaceOrder
        prompt "Update sub-order with shipping info"
      }
      on command MarketplaceOrder.ConfirmDelivery is {
        prompt "Update sub-order status to delivered"
      }
      on command MarketplaceOrder.CancelSubOrder is {
        tell event MarketplaceOrder.SubOrderCancelled to entity OrchestrationContext.MarketplaceOrder
        prompt "Update sub-order status to cancelled"
      }
      on command MarketplaceOrder.CancelOrder is {
        tell event MarketplaceOrder.OrderCancelled to entity OrchestrationContext.MarketplaceOrder
        prompt "Update order status to cancelled"
      }
    } with {
      briefly "Persists order commands"
      described as {
        |Handles command-driven persistence for orders.
      }
    }
  } with {
    briefly "Order data persistence"
    described as {
      | The OrderRepository provides persistent storage for marketplace
      | orders with indexes for customer and order lookup.
    }
  }
  // Projector for order analytics
  projector OrderAnalytics is {
    updates repository OrchestrationContext.OrderRepository
    record VendorFulfillmentMetrics is  {
      vendorId: VendorId with {
        briefly "Vendor"
        described as {
          |Vendor identifier.
        }
      }
      totalOrders: Natural with {
        briefly "Orders"
        described as {
          |Total orders.
        }
      }
      avgFulfillmentTime: Duration with {
        briefly "Avg time"
        described as {
          |Average fulfillment.
        }
      }
      onTimeRate: Decimal(5,2) with {
        briefly "On-time"
        described as {
          |On-time percentage.
        }
      }
    } with {
      briefly "Vendor fulfillment metrics"
      described as {
        |Fulfillment performance for a vendor.
      }
    }
    handler AnalyticsHandler is {
      on event MarketplaceOrder.SubOrderDelivered is {
        tell event MarketplaceOrder.SubOrderDelivered to repository OrchestrationContext.OrderRepository
        prompt "Update vendor fulfillment metrics"
      }
      on event MarketplaceOrder.OrderCompleted is {
        tell event MarketplaceOrder.OrderCompleted to repository OrchestrationContext.OrderRepository
        prompt "Update overall marketplace metrics"
      }
    } with {
      briefly "Maintains analytics views"
      described as {
        |Projects events into analytics data.
      }
    }
  } with {
    briefly "Order analytics projections"
    described as {
      |Maintains fulfillment analytics for marketplace.
    }
  }
  // ---- Event publication for MarketplaceOrder ----
  type MarketplaceOrderEvent is one of {
    OrchestrationContext.MarketplaceOrder.OrderCreated,
    OrchestrationContext.MarketplaceOrder.SubOrderRouted,
    OrchestrationContext.MarketplaceOrder.SubOrderAcknowledged,
    OrchestrationContext.MarketplaceOrder.SubOrderShipped,
    OrchestrationContext.MarketplaceOrder.SubOrderDelivered,
    OrchestrationContext.MarketplaceOrder.SubOrderCancelled,
    OrchestrationContext.MarketplaceOrder.OrderCompleted,
    OrchestrationContext.MarketplaceOrder.OrderCancelled
  } with {
    briefly "MarketplaceOrder event alternation"
    described as {
      |Union of all MarketplaceOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor MarketplaceOrderEventSource as source is {
    outlet MarketplaceOrderEvents is type MarketplaceOrderEvent
    handler MarketplaceOrderSourceHandler is {
      on event MarketplaceOrder.OrderCreated is {
        send event MarketplaceOrder.OrderCreated to outlet MarketplaceOrderEvents
      }
      on event MarketplaceOrder.SubOrderRouted is {
        send event MarketplaceOrder.SubOrderRouted to outlet MarketplaceOrderEvents
      }
      on event MarketplaceOrder.SubOrderAcknowledged is {
        send event MarketplaceOrder.SubOrderAcknowledged to outlet MarketplaceOrderEvents
      }
      on event MarketplaceOrder.SubOrderShipped is {
        send event MarketplaceOrder.SubOrderShipped to outlet MarketplaceOrderEvents
      }
      on event MarketplaceOrder.SubOrderDelivered is {
        send event MarketplaceOrder.SubOrderDelivered to outlet MarketplaceOrderEvents
      }
      on event MarketplaceOrder.SubOrderCancelled is {
        send event MarketplaceOrder.SubOrderCancelled to outlet MarketplaceOrderEvents
      }
      on event MarketplaceOrder.OrderCompleted is {
        send event MarketplaceOrder.OrderCompleted to outlet MarketplaceOrderEvents
      }
      on event MarketplaceOrder.OrderCancelled is {
        send event MarketplaceOrder.OrderCancelled to outlet MarketplaceOrderEvents
      }
      on other is {
        error "Unexpected message for source MarketplaceOrderEventSource"
      }
    } with {
      briefly "MarketplaceOrder source handler"
      described as {
        |Publishes MarketplaceOrder events onto the outlet.
      }
    }
  } with {
    briefly "MarketplaceOrder event source"
    described as {
      |Publishes MarketplaceOrder entity events into the streaming topology.
    }
  }
  processor MarketplaceOrderEventSink as sink is {
    inlet MarketplaceOrderInlet is type MarketplaceOrderEvent
    handler MarketplaceOrderSinkHandler is {
      on event MarketplaceOrder.OrderCreated is {
        tell event MarketplaceOrder.OrderCreated to repository OrchestrationContext.OrderRepository
      }
      on event MarketplaceOrder.SubOrderRouted is {
        tell event MarketplaceOrder.SubOrderRouted to repository OrchestrationContext.OrderRepository
      }
      on event MarketplaceOrder.SubOrderAcknowledged is {
        tell event MarketplaceOrder.SubOrderAcknowledged to repository OrchestrationContext.OrderRepository
      }
      on event MarketplaceOrder.SubOrderShipped is {
        tell event MarketplaceOrder.SubOrderShipped to repository OrchestrationContext.OrderRepository
      }
      on event MarketplaceOrder.SubOrderDelivered is {
        tell event MarketplaceOrder.SubOrderDelivered to repository OrchestrationContext.OrderRepository
      }
      on event MarketplaceOrder.SubOrderCancelled is {
        tell event MarketplaceOrder.SubOrderCancelled to repository OrchestrationContext.OrderRepository
      }
      on event MarketplaceOrder.OrderCompleted is {
        tell event MarketplaceOrder.OrderCompleted to repository OrchestrationContext.OrderRepository
      }
      on event MarketplaceOrder.OrderCancelled is {
        tell event MarketplaceOrder.OrderCancelled to repository OrchestrationContext.OrderRepository
      }
      on other is {
        error "Unexpected message for sink MarketplaceOrderEventSink"
      }
    } with {
      briefly "MarketplaceOrder sink handler"
      described as {
        |Persists MarketplaceOrder events via the repository.
      }
    }
  } with {
    briefly "MarketplaceOrder event sink"
    described as {
      |Receives MarketplaceOrder events for persistence.
    }
  }
  connector MarketplaceOrderEventFlow is {
    from outlet OrchestrationContext.MarketplaceOrderEventSource.MarketplaceOrderEvents to
      inlet OrchestrationContext.MarketplaceOrderEventSink.MarketplaceOrderInlet
  } with {
    briefly "MarketplaceOrder event flow"
    described as {
      |Connects the MarketplaceOrder source to its sink.
    }
  }
} with {
  briefly "Bounded context for order orchestration"
  described as {
    | The OrchestrationContext is the bounded context for marketplace
    | order management. It handles order splitting, routing, and
    | multi-vendor coordination.
  }
}
