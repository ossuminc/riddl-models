// Vendor Management - Vendor Context
context VendorContext is {
  adaptor FromComplianceService from context ComplianceService is { 
    handler FromComplianceServiceHandler is {
      on event ComplianceService.ComplianceCheckFailed is {
        do "the model receives compliance check failed"
      }
      on event ComplianceService.TaxIdVerified is {
        do "the model receives tax id verified"
      }
      on other is {
        error "Unexpected message for adaptor FromComplianceService"
      }
    } with {
      briefly "from compliance service"
      described as {
        |Carries messages from the external ComplianceService.
      }
    }
  } with {
    briefly "ComplianceService integration"
    described as {
      |The model's side of the ComplianceService conversation.
    }
  }
  adaptor ToComplianceService to context ComplianceService is { 
    handler ToComplianceServiceHandler is {
      on command ComplianceService.VerifyTaxId is {
        do "the model sends verify tax id"
      }
      on other is {
        error "Unexpected message for adaptor ToComplianceService"
      }
    } with {
      briefly "to compliance service"
      described as {
        |Carries messages to the external ComplianceService.
      }
    }
  } with {
    briefly "ComplianceService integration"
    described as {
      |The model's side of the ComplianceService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentService from context PaymentService is { 
    handler FromPaymentServiceHandler is {
      on event PaymentService.PayoutProcessed is {
        do "the model receives payout processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentService"
      }
    } with {
      briefly "from payment service"
      described as {
        |Carries messages from the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  include "types.riddl"
  include "Vendor.riddl"
  // Adaptors for external system integration
  adaptor PaymentAdapter to context PaymentService is { 
    handler PayoutProcessing is {
      on command PaymentService.CreatePayoutAccount is {
        do "Create vendor payout account"
      }
      on command PaymentService.ProcessPayout is {
        do "Process vendor payout"
      }
      on other is {
        error "Unexpected message for adaptor PaymentAdapter"
      }
    } with {
      briefly "Handles payout setup"
      described as {
        |Configures vendor payment accounts.
      }
    }
  } with {
    briefly "Payment integration"
    described as {
      |Manages vendor payout configuration.
    }
  }
  adaptor OrderAdapter from context OrderService is { 
    handler OrderEvents is {
      on event OrderService.OrderFulfilled is {
        do "Calculate vendor commission and queue payout"
      }
      on event OrderService.OrderReturned is {
        do "Adjust vendor balance for return"
      }
      on other is {
        error "Unexpected message for adaptor OrderAdapter"
      }
    } with {
      briefly "Handles order events"
      described as {
        |Processes orders for commission calculation.
      }
    }
  } with {
    briefly "Order service integration"
    described as {
      |Receives order events for vendor earnings.
    }
  }
  adaptor NotificationAdapter to context NotificationService is { 
    handler VendorNotifications is {
      on command NotificationService.SendEmail is {
        do "Send vendor lifecycle notification email"
      }
      on other is {
        error "Unexpected message for adaptor NotificationAdapter"
      }
    } with {
      briefly "Handles vendor notifications"
      described as {
        |Sends notifications for vendor lifecycle events.
      }
    }
  } with {
    briefly "Notification integration"
    described as {
      |Publishes vendor events for notifications.
    }
  }
  // Repository for vendor persistence
  repository VendorRepository is {
    inlet VendorRepositoryFromVendor is type VendorEvent    inlet VendorRepositoryFromVendorAnalytics is type VendorEvent    outlet VendorRepositoryResponses is type Vendor.VendorResult
    record StoredVendor is  {
      vendorId: VendorId with {
        briefly "vendorId"
        described as {
          |The vendorId column of the stored vendor row.
        }
      }
      businessName: BusinessName with {
        briefly "businessName"
        described as {
          |The businessName column of the stored vendor row.
        }
      }
      email: Email with {
        briefly "email"
        described as {
          |The email column of the stored vendor row.
        }
      }
      storeName: StoreName with {
        briefly "storeName"
        described as {
          |The storeName column of the stored vendor row.
        }
      }
    } with {
      briefly "Stored vendor row"
      described as {
        |The persistence shape of vendor data as this repository stores it.
      }
    }
    schema VendorData is relational
      of vendors as type StoredVendor
        index on field StoredVendor.businessName
        index on field StoredVendor.storeName
        index on field StoredVendor.email
 with {
      briefly "Vendor data schema"
      described as {
        |The relational schema holding vendor data for the VendorRepository.
      }
    }
    handler VendorPersistence is {
      on query GetVendorPerformanceSummary is {
        do "read the vendor performance summary projection"
        yield result VendorPerformanceSummaryView
      }
      on command Vendor.SubmitApplication is {
        tell event Vendor.ApplicationSubmitted to entity VendorContext.Vendor
        do "Persist new vendor application"
      }
      on command Vendor.ApproveVendor is {
        tell event Vendor.VendorApproved to entity VendorContext.Vendor
        do "Update vendor status to active"
      }
      on command Vendor.RejectVendor is {
        tell event Vendor.VendorRejected to entity VendorContext.Vendor
        do "Update vendor status to rejected"
      }
      on command Vendor.UpdateVendorInfo is {
        tell event Vendor.VendorInfoUpdated to entity VendorContext.Vendor
        do "Update vendor profile"
      }
      on command Vendor.SetBankAccount is {
        tell event Vendor.BankAccountSet to entity VendorContext.Vendor
        do "Update payout account"
      }
      on command Vendor.SuspendVendor is {
        tell event Vendor.VendorSuspended to entity VendorContext.Vendor
        do "Update vendor status to suspended"
      }
      on command Vendor.ReinstateVendor is {
        tell event Vendor.VendorReinstated to entity VendorContext.Vendor
        do "Update vendor status to active"
      }
      on command Vendor.TerminateVendor is {
        tell event Vendor.VendorTerminated to entity VendorContext.Vendor
        do "Update vendor status to terminated"
      }
      on command Vendor.UpdatePerformance is {
        tell event Vendor.PerformanceUpdated to entity VendorContext.Vendor
        do "Update vendor performance metrics"
      }
    } with {
      briefly "Persists vendor commands"
      described as {
        |Handles command-driven persistence for vendor data.
      }
    }
  } with {
    briefly "Vendor data persistence"
    described as {
      | The VendorRepository provides persistent storage for vendors
      | with indexes for searching by name and email.
    }
  }
  // Projector for vendor analytics
  query GetVendorPerformanceSummary is  {
    vendorPerformanceSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which vendor performance summary to retrieve.
      }
    }
  } with {
    briefly "Get vendor performance summary"
    described as {
      |Retrieves the vendor performance summary projection.
    }
  }
  result VendorPerformanceSummaryView is  {
    vendorPerformanceSummary: VendorAnalytics.VendorPerformanceSummary with {
      briefly "Vendor performance summary"
      described as {
        |The vendor performance summary being returned.
      }
    }
  } with {
    briefly "Vendor performance summary view"
    described as {
      |Read model view carrying the vendor performance summary projection.
    }
  }
  projector VendorAnalytics is {
    updates repository VendorContext.VendorRepository
    inlet VendorAnalyticsFromVendor is type VendorEvent    outlet VendorAnalyticsOut is type VendorEvent
    record VendorPerformanceSummary is  {
      vendorId: VendorId with {
        briefly "Vendor"
        described as {
          |Vendor identifier.
        }
      }
      storeName: StoreName with {
        briefly "Store"
        described as {
          |Store name.
        }
      }
      tier: VendorTier with {
        briefly "Tier"
        described as {
          |Vendor tier.
        }
      }
      totalOrders: Natural with {
        briefly "Orders"
        described as {
          |Total orders fulfilled.
        }
      }
      totalRevenue: Money with {
        briefly "Revenue"
        described as {
          |Total revenue generated.
        }
      }
      avgRating: Decimal(3,2) with {
        briefly "Rating"
        described as {
          |Average rating.
        }
      }
    } with {
      briefly "Vendor performance summary"
      described as {
        |Aggregated vendor performance data.
      }
    }
    handler AnalyticsHandler is {
      on event Vendor.PerformanceUpdated is {
        tell event Vendor.PerformanceUpdated to repository VendorContext.VendorRepository
        do "Update vendor performance summary"
      }
      on event Vendor.VendorApproved is {
        tell event Vendor.VendorApproved to repository VendorContext.VendorRepository
        do "Initialize vendor analytics record"
      }
    } with {
      briefly "Maintains analytics views"
      described as {
        |Projects events into analytics data.
      }
    }
  } with {
    briefly "Vendor analytics projections"
    described as {
      |Maintains performance analytics for vendors.
    }
  }
  // ---- Event publication for Vendor ----
  type VendorEvent is one of {
    VendorContext.Vendor.ApplicationSubmitted or VendorContext.Vendor.VendorApproved or VendorContext.Vendor.VendorRejected or VendorContext.Vendor.VendorInfoUpdated or VendorContext.Vendor.BankAccountSet or VendorContext.Vendor.VendorSuspended or VendorContext.Vendor.VendorReinstated or VendorContext.Vendor.VendorTerminated or VendorContext.Vendor.PerformanceUpdated
  } with {
    briefly "Vendor event alternation"
    described as {
      |Union of all Vendor events, for streaming and event-sourced
      |persistence.
    }
  }
  processor VendorEventSource as source is {
    outlet VendorEvents is type VendorEvent
    handler VendorSourceHandler is {
      on event Vendor.ApplicationSubmitted is {
        send event Vendor.ApplicationSubmitted to outlet VendorEvents
      }
      on event Vendor.VendorApproved is {
        send event Vendor.VendorApproved to outlet VendorEvents
      }
      on event Vendor.VendorRejected is {
        send event Vendor.VendorRejected to outlet VendorEvents
      }
      on event Vendor.VendorInfoUpdated is {
        send event Vendor.VendorInfoUpdated to outlet VendorEvents
      }
      on event Vendor.BankAccountSet is {
        send event Vendor.BankAccountSet to outlet VendorEvents
      }
      on event Vendor.VendorSuspended is {
        send event Vendor.VendorSuspended to outlet VendorEvents
      }
      on event Vendor.VendorReinstated is {
        send event Vendor.VendorReinstated to outlet VendorEvents
      }
      on event Vendor.VendorTerminated is {
        send event Vendor.VendorTerminated to outlet VendorEvents
      }
      on event Vendor.PerformanceUpdated is {
        send event Vendor.PerformanceUpdated to outlet VendorEvents
      }
      on other is {
        error "Unexpected message for source VendorEventSource"
      }
    } with {
      briefly "Vendor source handler"
      described as {
        |Publishes Vendor events onto the outlet.
      }
    }
  } with {
    briefly "Vendor event source"
    described as {
      |Publishes Vendor entity events into the streaming topology.
    }
  }
  processor VendorEventSink as sink is {
    inlet VendorInlet is type VendorEvent    handler VendorSinkHandler is {
      on event Vendor.ApplicationSubmitted is {
        tell event Vendor.ApplicationSubmitted to repository VendorContext.VendorRepository
      }
      on event Vendor.VendorApproved is {
        tell event Vendor.VendorApproved to repository VendorContext.VendorRepository
      }
      on event Vendor.VendorRejected is {
        tell event Vendor.VendorRejected to repository VendorContext.VendorRepository
      }
      on event Vendor.VendorInfoUpdated is {
        tell event Vendor.VendorInfoUpdated to repository VendorContext.VendorRepository
      }
      on event Vendor.BankAccountSet is {
        tell event Vendor.BankAccountSet to repository VendorContext.VendorRepository
      }
      on event Vendor.VendorSuspended is {
        tell event Vendor.VendorSuspended to repository VendorContext.VendorRepository
      }
      on event Vendor.VendorReinstated is {
        tell event Vendor.VendorReinstated to repository VendorContext.VendorRepository
      }
      on event Vendor.VendorTerminated is {
        tell event Vendor.VendorTerminated to repository VendorContext.VendorRepository
      }
      on event Vendor.PerformanceUpdated is {
        tell event Vendor.PerformanceUpdated to repository VendorContext.VendorRepository
      }
      on other is {
        error "Unexpected message for sink VendorEventSink"
      }
    } with {
      briefly "Vendor sink handler"
      described as {
        |Persists Vendor events via the repository.
      }
    }
  } with {
    briefly "Vendor event sink"
    described as {
      |Receives Vendor events for persistence.
    }
  }
  connector VendorEventFlow is from outlet VendorContext.VendorEventSource.VendorEvents to inlet VendorContext.VendorEventSink.VendorInlet with {
    briefly "Vendor event flow"
    described as {
      |Connects the Vendor source to its sink.
    }
  }
  processor VendorEventSplit is {
    inlet VendorEventSplitIn is type VendorEvent    outlet VendorEventSplitToVendorRepository is type VendorEvent
    outlet VendorEventSplitToVendorAnalytics is type VendorEvent
    handler VendorEventSplitHandler is {
      on event Vendor.ApplicationSubmitted is {
        send event Vendor.ApplicationSubmitted to outlet VendorEventSplitToVendorRepository
        send event Vendor.ApplicationSubmitted to outlet VendorEventSplitToVendorAnalytics
        tell event Vendor.ApplicationSubmitted to entity VendorContext.Vendor
      }
      on event Vendor.VendorApproved is {
        send event Vendor.VendorApproved to outlet VendorEventSplitToVendorRepository
        send event Vendor.VendorApproved to outlet VendorEventSplitToVendorAnalytics
        tell event Vendor.VendorApproved to entity VendorContext.Vendor
      }
      on event Vendor.VendorRejected is {
        send event Vendor.VendorRejected to outlet VendorEventSplitToVendorRepository
        send event Vendor.VendorRejected to outlet VendorEventSplitToVendorAnalytics
        tell event Vendor.VendorRejected to entity VendorContext.Vendor
      }
      on event Vendor.VendorInfoUpdated is {
        send event Vendor.VendorInfoUpdated to outlet VendorEventSplitToVendorRepository
        send event Vendor.VendorInfoUpdated to outlet VendorEventSplitToVendorAnalytics
        tell event Vendor.VendorInfoUpdated to entity VendorContext.Vendor
      }
      on event Vendor.BankAccountSet is {
        send event Vendor.BankAccountSet to outlet VendorEventSplitToVendorRepository
        send event Vendor.BankAccountSet to outlet VendorEventSplitToVendorAnalytics
        tell event Vendor.BankAccountSet to entity VendorContext.Vendor
      }
      on event Vendor.VendorSuspended is {
        send event Vendor.VendorSuspended to outlet VendorEventSplitToVendorRepository
        send event Vendor.VendorSuspended to outlet VendorEventSplitToVendorAnalytics
        tell event Vendor.VendorSuspended to entity VendorContext.Vendor
      }
      on event Vendor.VendorReinstated is {
        send event Vendor.VendorReinstated to outlet VendorEventSplitToVendorRepository
        send event Vendor.VendorReinstated to outlet VendorEventSplitToVendorAnalytics
        tell event Vendor.VendorReinstated to entity VendorContext.Vendor
      }
      on event Vendor.VendorTerminated is {
        send event Vendor.VendorTerminated to outlet VendorEventSplitToVendorRepository
        send event Vendor.VendorTerminated to outlet VendorEventSplitToVendorAnalytics
        tell event Vendor.VendorTerminated to entity VendorContext.Vendor
      }
      on event Vendor.PerformanceUpdated is {
        send event Vendor.PerformanceUpdated to outlet VendorEventSplitToVendorRepository
        send event Vendor.PerformanceUpdated to outlet VendorEventSplitToVendorAnalytics
        tell event Vendor.PerformanceUpdated to entity VendorContext.Vendor
      }
      on other is {
        error "Unexpected message for processor VendorEventSplit"
      }
    } with {
      briefly "Vendor event fan-out handler"
      described as {
        |Delivers each Vendor event to all of its consumers.
      }
    }
  } with {
    briefly "Vendor event fan-out"
    described as {
      |Fans Vendor events out to the repository and projectors.
    }
  }
  connector 'VendorEvent Stream' is from outlet VendorContext.Vendor.VendorEvents2 to inlet VendorContext.VendorEventSplit.VendorEventSplitIn with {
    briefly "Vendor events, fanned out to storage and read models"
  }
  connector 'VendorEvent Storage' is from outlet VendorContext.VendorEventSplit.VendorEventSplitToVendorRepository to inlet VendorContext.VendorRepository.VendorRepositoryFromVendor with {
    briefly "Vendor events on their way to storage"
  }
  connector 'VendorAnalytics Feed' is from outlet VendorContext.VendorEventSplit.VendorEventSplitToVendorAnalytics to inlet VendorContext.VendorAnalytics.VendorAnalyticsFromVendor with {
    briefly "Vendor events feeding the VendorAnalytics projection"
  }
  connector 'VendorAnalytics Storage' is from outlet VendorContext.VendorAnalytics.VendorAnalyticsOut to inlet VendorContext.VendorRepository.VendorRepositoryFromVendorAnalytics with {
    briefly "The VendorAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for vendor management"
  described as {
    | The VendorContext is the bounded context for marketplace vendor
    | management. It contains the Vendor entity with integrations to
    | payment, order, and notification systems.
  }
}
