// Vendor Management - Vendor Context
context VendorContext as router is {
  inlet VendorCommandStreamIn is type VendorCommand  outlet VendorCommandStreamOut is type VendorCommand
  inlet VendorResultStreamIn is result Vendor.VendorResult  outlet VendorResultStreamOut is result Vendor.VendorResult
  handler VendorContextBoundary is {
    on submitApplication: command Vendor.SubmitApplication is {
      send submitApplication to outlet VendorContext.VendorCommandStreamOut
    }
    on approveVendor: command Vendor.ApproveVendor is {
      send approveVendor to outlet VendorContext.VendorCommandStreamOut
    }
    on rejectVendor: command Vendor.RejectVendor is {
      send rejectVendor to outlet VendorContext.VendorCommandStreamOut
    }
    on updateVendorInfo: command Vendor.UpdateVendorInfo is {
      send updateVendorInfo to outlet VendorContext.VendorCommandStreamOut
    }
    on setBankAccount: command Vendor.SetBankAccount is {
      send setBankAccount to outlet VendorContext.VendorCommandStreamOut
    }
    on suspendVendor: command Vendor.SuspendVendor is {
      send suspendVendor to outlet VendorContext.VendorCommandStreamOut
    }
    on reinstateVendor: command Vendor.ReinstateVendor is {
      send reinstateVendor to outlet VendorContext.VendorCommandStreamOut
    }
    on terminateVendor: command Vendor.TerminateVendor is {
      send terminateVendor to outlet VendorContext.VendorCommandStreamOut
    }
    on updatePerformance: command Vendor.UpdatePerformance is {
      send updatePerformance to outlet VendorContext.VendorCommandStreamOut
    }
    on vendorResult: result Vendor.VendorResult is {
      send vendorResult to outlet VendorContext.VendorResultStreamOut
    }
    on other is {
      error "Unexpected message at the VendorContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'VendorCommand Stream Intake' is from outlet VendorContext.VendorCommandStreamOut to inlet VendorContext.Vendor.VendorCommands  connector 'VendorResult Stream Egress' is from outlet VendorContext.VendorRepository.VendorRepositoryResponses to inlet VendorContext.VendorResultStreamIn  adaptor FromComplianceService from context ComplianceService is { 
    handler FromComplianceServiceHandler is {
      on event ComplianceService.ComplianceCheckFailed is {
        do "the model receives compliance check failed"
      }
      on event ComplianceService.TaxIdVerified is {
        do "the model receives tax id verified"
      }
      on other is {
        error "Unexpected message for adaptor FromComplianceService"
      }
    } with {
      briefly "from compliance service"
      described as {
        |Carries messages from the external ComplianceService.
      }
    }
  } with {
    briefly "ComplianceService integration"
    described as {
      |The model's side of the ComplianceService conversation.
    }
  }
  adaptor ToComplianceService to context ComplianceService is { 
    handler ToComplianceServiceHandler is {
      on command ComplianceService.VerifyTaxId is {
        do "the model sends verify tax id"
      }
      on other is {
        error "Unexpected message for adaptor ToComplianceService"
      }
    } with {
      briefly "to compliance service"
      described as {
        |Carries messages to the external ComplianceService.
      }
    }
  } with {
    briefly "ComplianceService integration"
    described as {
      |The model's side of the ComplianceService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentService from context PaymentService is { 
    handler FromPaymentServiceHandler is {
      on event PaymentService.PayoutProcessed is {
        do "the model receives payout processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentService"
      }
    } with {
      briefly "from payment service"
      described as {
        |Carries messages from the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  include "types.riddl"
  include "Vendor.riddl"
  // Adaptors for external system integration
  adaptor PaymentAdapter to context PaymentService is { 
    handler PayoutProcessing is {
      on command PaymentService.CreatePayoutAccount is {
        do "Create vendor payout account"
      }
      on command PaymentService.ProcessPayout is {
        do "Process vendor payout"
      }
      on other is {
        error "Unexpected message for adaptor PaymentAdapter"
      }
    } with {
      briefly "Handles payout setup"
      described as {
        |Configures vendor payment accounts.
      }
    }
  } with {
    briefly "Payment integration"
    described as {
      |Manages vendor payout configuration.
    }
  }
  adaptor OrderAdapter from context OrderService is { 
    handler OrderEvents is {
      on event OrderService.OrderFulfilled is {
        do "Calculate vendor commission and queue payout"
      }
      on event OrderService.OrderReturned is {
        do "Adjust vendor balance for return"
      }
      on other is {
        error "Unexpected message for adaptor OrderAdapter"
      }
    } with {
      briefly "Handles order events"
      described as {
        |Processes orders for commission calculation.
      }
    }
  } with {
    briefly "Order service integration"
    described as {
      |Receives order events for vendor earnings.
    }
  }
  adaptor NotificationAdapter to context NotificationService is { 
    handler VendorNotifications is {
      on command NotificationService.SendEmail is {
        do "Send vendor lifecycle notification email"
      }
      on other is {
        error "Unexpected message for adaptor NotificationAdapter"
      }
    } with {
      briefly "Handles vendor notifications"
      described as {
        |Sends notifications for vendor lifecycle events.
      }
    }
  } with {
    briefly "Notification integration"
    described as {
      |Publishes vendor events for notifications.
    }
  }
  // Repository for vendor persistence
  type VendorRepositoryCommand is one of {
    VendorContext.VendorRepository.PersistApplicationSubmitted or VendorContext.VendorRepository.PersistBankAccountSet or VendorContext.VendorRepository.PersistPerformanceUpdated or VendorContext.VendorRepository.PersistVendorApproved or VendorContext.VendorRepository.PersistVendorInfoUpdated or VendorContext.VendorRepository.PersistVendorReinstated or VendorContext.VendorRepository.PersistVendorRejected or VendorContext.VendorRepository.PersistVendorSuspended or VendorContext.VendorRepository.PersistVendorTerminated
  } with {
    briefly "Anything that writes VendorRepository"
    described as {
      |The persistence commands VendorRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository VendorRepository as flow is {
    inlet VendorRepositoryFromVendorAnalytics is type VendorRepositoryCommand    command PersistApplicationSubmitted is {
      vendorId: VendorId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApplicationSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ApplicationSubmitted"
      described as {
        |Instructs this repository to apply ApplicationSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBankAccountSet is {
      vendorId: VendorId with {
        briefly "Row addressed"
        described as {
          |Which stored row BankAccountSet applies to.
        }
      }
    } with {
      briefly "Persist BankAccountSet"
      described as {
        |Instructs this repository to apply BankAccountSet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVendorInfoUpdated is {
      vendorId: VendorId with {
        briefly "Row addressed"
        described as {
          |Which stored row VendorInfoUpdated applies to.
        }
      }
    } with {
      briefly "Persist VendorInfoUpdated"
      described as {
        |Instructs this repository to apply VendorInfoUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVendorReinstated is {
      vendorId: VendorId with {
        briefly "Row addressed"
        described as {
          |Which stored row VendorReinstated applies to.
        }
      }
    } with {
      briefly "Persist VendorReinstated"
      described as {
        |Instructs this repository to apply VendorReinstated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVendorRejected is {
      vendorId: VendorId with {
        briefly "Row addressed"
        described as {
          |Which stored row VendorRejected applies to.
        }
      }
    } with {
      briefly "Persist VendorRejected"
      described as {
        |Instructs this repository to apply VendorRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVendorSuspended is {
      vendorId: VendorId with {
        briefly "Row addressed"
        described as {
          |Which stored row VendorSuspended applies to.
        }
      }
    } with {
      briefly "Persist VendorSuspended"
      described as {
        |Instructs this repository to apply VendorSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVendorTerminated is {
      vendorId: VendorId with {
        briefly "Row addressed"
        described as {
          |Which stored row VendorTerminated applies to.
        }
      }
    } with {
      briefly "Persist VendorTerminated"
      described as {
        |Instructs this repository to apply VendorTerminated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPerformanceUpdated is {
      vendorId: VendorId with {
        briefly "Row addressed"
        described as {
          |Which stored row PerformanceUpdated applies to.
        }
      }
    } with {
      briefly "Persist PerformanceUpdated"
      described as {
        |Instructs this repository to apply PerformanceUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVendorApproved is {
      vendorId: VendorId with {
        briefly "Row addressed"
        described as {
          |Which stored row VendorApproved applies to.
        }
      }
    } with {
      briefly "Persist VendorApproved"
      described as {
        |Instructs this repository to apply VendorApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet VendorRepositoryResponses is result Vendor.VendorResult
    record StoredVendor is {
      vendorId: VendorId with {
        briefly "vendorId"
        described as {
          |The vendorId column of the stored vendor row.
        }
      }
      businessName: BusinessName with {
        briefly "businessName"
        described as {
          |The businessName column of the stored vendor row.
        }
      }
      email: Email with {
        briefly "email"
        described as {
          |The email column of the stored vendor row.
        }
      }
      storeName: StoreName with {
        briefly "storeName"
        described as {
          |The storeName column of the stored vendor row.
        }
      }
    } with {
      briefly "Stored vendor row"
      described as {
        |The persistence shape of vendor data as this repository stores it.
      }
    }
    schema VendorData is relational
      of vendors as record StoredVendor
        index on field StoredVendor.businessName
        index on field StoredVendor.storeName
        index on field StoredVendor.email
 with {
      briefly "Vendor data schema"
      described as {
        |The relational schema holding vendor data for the VendorRepository.
      }
    }
    handler VendorPersistence is {
      on persistApplicationSubmitted: command PersistApplicationSubmitted is {
        do "apply ApplicationSubmitted to the stored row"
      }
      on persistBankAccountSet: command PersistBankAccountSet is {
        do "apply BankAccountSet to the stored row"
      }
      on persistVendorInfoUpdated: command PersistVendorInfoUpdated is {
        do "apply VendorInfoUpdated to the stored row"
      }
      on persistVendorReinstated: command PersistVendorReinstated is {
        do "apply VendorReinstated to the stored row"
      }
      on persistVendorRejected: command PersistVendorRejected is {
        do "apply VendorRejected to the stored row"
      }
      on persistVendorSuspended: command PersistVendorSuspended is {
        do "apply VendorSuspended to the stored row"
      }
      on persistVendorTerminated: command PersistVendorTerminated is {
        do "apply VendorTerminated to the stored row"
      }
      on persistPerformanceUpdated: command PersistPerformanceUpdated is {
        do "apply PerformanceUpdated to the stored row"
      }
      on persistVendorApproved: command PersistVendorApproved is {
        do "apply VendorApproved to the stored row"
      }
      on query GetVendorPerformanceSummary is {
        let vendorPerformanceSummaryView: type VendorPerformanceSummaryView = prompt("read the vendor performance summary projection")
        reply vendorPerformanceSummaryView
      }
    } with {
      briefly "Persists vendor commands"
      described as {
        |Handles command-driven persistence for vendor data.
      }
    }
  } with {
    briefly "Vendor data persistence"
    described as {
      | The VendorRepository provides persistent storage for vendors
      | with indexes for searching by name and email.
    }
  }
  // Projector for vendor analytics
  query GetVendorPerformanceSummary replies result VendorPerformanceSummaryView is {
    vendorPerformanceSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which vendor performance summary to retrieve.
      }
    }
  } with {
    briefly "Get vendor performance summary"
    described as {
      |Retrieves the vendor performance summary projection.
    }
  }
  result VendorPerformanceSummaryView is {
    vendorPerformanceSummary: VendorAnalytics.VendorPerformanceSummary with {
      briefly "Vendor performance summary"
      described as {
        |The vendor performance summary being returned.
      }
    }
  } with {
    briefly "Vendor performance summary view"
    described as {
      |Read model view carrying the vendor performance summary projection.
    }
  }
  projector VendorAnalytics as flow is {
    updates repository VendorContext.VendorRepository
    outlet VendorAnalyticsToRepository is type VendorRepositoryCommand
    inlet VendorAnalyticsFromVendor is type VendorEvent    record VendorPerformanceSummary is {
      vendorId: VendorId with {
        briefly "Vendor"
        described as {
          |Vendor identifier.
        }
      }
      storeName: StoreName with {
        briefly "Store"
        described as {
          |Store name.
        }
      }
      tier: VendorTier with {
        briefly "Tier"
        described as {
          |Vendor tier.
        }
      }
      totalOrders: Natural with {
        briefly "Orders"
        described as {
          |Total orders fulfilled.
        }
      }
      totalRevenue: Money with {
        briefly "Revenue"
        described as {
          |Total revenue generated.
        }
      }
      avgRating: Decimal(3,2) with {
        briefly "Rating"
        described as {
          |Average rating.
        }
      }
    } with {
      briefly "Vendor performance summary"
      described as {
        |Aggregated vendor performance data.
      }
    }
    handler AnalyticsHandler is {
      on applicationSubmitted: event Vendor.ApplicationSubmitted is {
        tell command VendorContext.VendorRepository.PersistApplicationSubmitted(vendorId = applicationSubmitted.vendorId) to repository VendorContext.VendorRepository
        do "apply ApplicationSubmitted to the VendorAnalytics projection"
      }
      on bankAccountSet: event Vendor.BankAccountSet is {
        tell command VendorContext.VendorRepository.PersistBankAccountSet(vendorId = bankAccountSet.vendorId) to repository VendorContext.VendorRepository
        do "apply BankAccountSet to the VendorAnalytics projection"
      }
      on vendorInfoUpdated: event Vendor.VendorInfoUpdated is {
        tell command VendorContext.VendorRepository.PersistVendorInfoUpdated(vendorId = vendorInfoUpdated.vendorId) to repository VendorContext.VendorRepository
        do "apply VendorInfoUpdated to the VendorAnalytics projection"
      }
      on vendorReinstated: event Vendor.VendorReinstated is {
        tell command VendorContext.VendorRepository.PersistVendorReinstated(vendorId = vendorReinstated.vendorId) to repository VendorContext.VendorRepository
        do "apply VendorReinstated to the VendorAnalytics projection"
      }
      on vendorRejected: event Vendor.VendorRejected is {
        tell command VendorContext.VendorRepository.PersistVendorRejected(vendorId = vendorRejected.vendorId) to repository VendorContext.VendorRepository
        do "apply VendorRejected to the VendorAnalytics projection"
      }
      on vendorSuspended: event Vendor.VendorSuspended is {
        tell command VendorContext.VendorRepository.PersistVendorSuspended(vendorId = vendorSuspended.vendorId) to repository VendorContext.VendorRepository
        do "apply VendorSuspended to the VendorAnalytics projection"
      }
      on vendorTerminated: event Vendor.VendorTerminated is {
        tell command VendorContext.VendorRepository.PersistVendorTerminated(vendorId = vendorTerminated.vendorId) to repository VendorContext.VendorRepository
        do "apply VendorTerminated to the VendorAnalytics projection"
      }
      on performanceUpdated: event Vendor.PerformanceUpdated is {
        tell command VendorContext.VendorRepository.PersistPerformanceUpdated(vendorId = performanceUpdated.vendorId) to repository VendorContext.VendorRepository
        do "Update vendor performance summary"
      }
      on vendorApproved: event Vendor.VendorApproved is {
        tell command VendorContext.VendorRepository.PersistVendorApproved(vendorId = vendorApproved.vendorId) to repository VendorContext.VendorRepository
        do "Initialize vendor analytics record"
      }
    } with {
      briefly "Maintains analytics views"
      described as {
        |Projects events into analytics data.
      }
    }
  } with {
    briefly "Vendor analytics projections"
    described as {
      |Maintains performance analytics for vendors.
    }
  }
  // ---- Event publication for Vendor ----
  type VendorEvent is one of {
    VendorContext.Vendor.ApplicationSubmitted or VendorContext.Vendor.VendorApproved or VendorContext.Vendor.VendorRejected or VendorContext.Vendor.VendorInfoUpdated or VendorContext.Vendor.BankAccountSet or VendorContext.Vendor.VendorSuspended or VendorContext.Vendor.VendorReinstated or VendorContext.Vendor.VendorTerminated or VendorContext.Vendor.PerformanceUpdated
  } with {
    briefly "Vendor event alternation"
    described as {
      |Union of all Vendor events, for streaming and event-sourced
      |persistence.
    }
  }
  processor VendorEventSplit as flow is {
    inlet VendorEventSplitIn is type VendorEvent    outlet VendorEventSplitToVendorAnalytics is type VendorEvent
    handler VendorEventSplitHandler is {
      on applicationSubmitted: event Vendor.ApplicationSubmitted is {
        send applicationSubmitted to outlet VendorEventSplitToVendorAnalytics
        tell applicationSubmitted to entity VendorContext.Vendor
      }
      on vendorApproved: event Vendor.VendorApproved is {
        send vendorApproved to outlet VendorEventSplitToVendorAnalytics
        tell vendorApproved to entity VendorContext.Vendor
      }
      on vendorRejected: event Vendor.VendorRejected is {
        send vendorRejected to outlet VendorEventSplitToVendorAnalytics
        tell vendorRejected to entity VendorContext.Vendor
      }
      on vendorInfoUpdated: event Vendor.VendorInfoUpdated is {
        send vendorInfoUpdated to outlet VendorEventSplitToVendorAnalytics
        tell vendorInfoUpdated to entity VendorContext.Vendor
      }
      on bankAccountSet: event Vendor.BankAccountSet is {
        send bankAccountSet to outlet VendorEventSplitToVendorAnalytics
        tell bankAccountSet to entity VendorContext.Vendor
      }
      on vendorSuspended: event Vendor.VendorSuspended is {
        send vendorSuspended to outlet VendorEventSplitToVendorAnalytics
        tell vendorSuspended to entity VendorContext.Vendor
      }
      on vendorReinstated: event Vendor.VendorReinstated is {
        send vendorReinstated to outlet VendorEventSplitToVendorAnalytics
        tell vendorReinstated to entity VendorContext.Vendor
      }
      on vendorTerminated: event Vendor.VendorTerminated is {
        send vendorTerminated to outlet VendorEventSplitToVendorAnalytics
        tell vendorTerminated to entity VendorContext.Vendor
      }
      on performanceUpdated: event Vendor.PerformanceUpdated is {
        send performanceUpdated to outlet VendorEventSplitToVendorAnalytics
        tell performanceUpdated to entity VendorContext.Vendor
      }
      on other is {
        error "Unexpected message for processor VendorEventSplit"
      }
    } with {
      briefly "Vendor event fan-out handler"
      described as {
        |Delivers each Vendor event to all of its consumers.
      }
    }
  } with {
    briefly "Vendor event fan-out"
    described as {
      |Fans Vendor events out to the repository and projectors.
    }
  }
  connector 'VendorEvent Stream' is from outlet VendorContext.Vendor.VendorEvents2 to inlet VendorContext.VendorEventSplit.VendorEventSplitIn with {
    briefly "Vendor events, fanned out to storage and read models"
  }
  connector 'VendorAnalytics Feed' is from outlet VendorContext.VendorEventSplit.VendorEventSplitToVendorAnalytics to inlet VendorContext.VendorAnalytics.VendorAnalyticsFromVendor with {
    briefly "Vendor events feeding the VendorAnalytics projection"
  }
  connector 'VendorAnalytics Storage' is from outlet VendorContext.VendorAnalytics.VendorAnalyticsToRepository to inlet VendorContext.VendorRepository.VendorRepositoryFromVendorAnalytics with {
    briefly "VendorAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for vendor management"
  described as {
    | The VendorContext is the bounded context for marketplace vendor
    | management. It contains the Vendor entity with integrations to
    | payment, order, and notification systems.
  }
}
