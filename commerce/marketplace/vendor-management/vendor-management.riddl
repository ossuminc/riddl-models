// Vendor Management Domain Model
// Marketplace vendor onboarding, management, and performance tracking
domain VendorManagement is {
  persistent connector 'OrderServiceEvent Stream' is from outlet OrderService.OrderServiceEventsOut to inlet VendorContext.OrderAdapter.OrderAdapterIn with {
    briefly "What OrderService tells VendorContext, unasked"
  }
  persistent connector 'ComplianceServiceEvent Stream' is from outlet ComplianceService.ComplianceServiceEventsOut to inlet VendorContext.FromComplianceService.FromComplianceServiceIn with {
    briefly "What ComplianceService tells VendorContext, unasked"
  }
  persistent connector 'PaymentServiceEvent Stream' is from outlet PaymentService.PaymentServiceEventsOut to inlet VendorContext.FromPaymentService.FromPaymentServiceIn with {
    briefly "What PaymentService tells VendorContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user MarketplaceAdmin is "a platform administrator managing vendor relationships" with {
    briefly "Marketplace administrator"
    described as {
      |Staff managing vendor onboarding and compliance.
    }
  }
  user VendorUser is "a seller offering products on the marketplace" with {
    briefly "Marketplace vendor"
    described as {
      |A third-party seller on the marketplace platform.
    }
  }
  epic VendorOnboardingEpic is {
    user VendorUser wants to "to become a seller on the marketplace" so that "they can reach customers and sell products"
    case StandardOnboarding is {
      user VendorUser wants to "to complete vendor registration" so that "they can start listing products"
      step is "Vendor submits application" "with business details" "and documentation" with {
        briefly "Submit application"
        described as {
          |Vendor provides business information.
        }
      }
      step is "System validates business information" "checking tax IDs and addresses" "for accuracy" with {
        briefly "Validate info"
        described as {
          |System verifies vendor details.
        }
      }
      step take input VendorManagementApp.VendorManagementScreen.SubmitApplicationInput from user VendorUser with {
        briefly "Submit app"
        described as {
          |Send application to vendor entity.
        }
      }
      step is "Admin reviews application" "verifying documents" "and business legitimacy" with {
        briefly "Admin review"
        described as {
          |Administrator reviews application.
        }
      }
      step take input VendorManagementApp.VendorManagementScreen.ApproveVendorInput from user MarketplaceAdmin with {
        briefly "Approve vendor"
        described as {
          |Admin approves the vendor.
        }
      }
    } with {
      briefly "Standard vendor onboarding"
      described as {
        |Normal workflow for new vendor registration and approval.
      }
    }
  } with {
    briefly "Vendor onboarding process"
    described as {
      | Epic covering the vendor application workflow from initial submission
      | through verification and approval.
    }
  }
  include "VendorContext.riddl"
  include "external-contexts.riddl"
  application context VendorManagementApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in VendorManagement are delivered.
      }
    }
    group VendorManagementScreen is {
      input GetVendorPerformanceSummaryInput acquires query VendorContext.GetVendorPerformanceSummary with {
        briefly "Get vendor performance summary control"
        described as {
          |The control through which a user asks the get vendor performance summary question.
        }
      }
      input GetVendorInput acquires query VendorContext.Vendor.GetVendor with {
        briefly "Get vendor control"
        described as {
          |The control through which a user asks the get vendor question.
        }
      }
      input ReinstateVendorInput acquires command VendorContext.Vendor.ReinstateVendor with {
        briefly "Reinstate vendor control"
        described as {
          |The control through which a user submits the reinstate vendor request.
        }
      }
      input SetBankAccountInput acquires command VendorContext.Vendor.SetBankAccount with {
        briefly "Set bank account control"
        described as {
          |The control through which a user submits the set bank account request.
        }
      }
      input SuspendVendorInput acquires command VendorContext.Vendor.SuspendVendor with {
        briefly "Suspend vendor control"
        described as {
          |The control through which a user submits the suspend vendor request.
        }
      }
      input TerminateVendorInput acquires command VendorContext.Vendor.TerminateVendor with {
        briefly "Terminate vendor control"
        described as {
          |The control through which a user submits the terminate vendor request.
        }
      }
      input UpdatePerformanceInput acquires command VendorContext.Vendor.UpdatePerformance with {
        briefly "Update performance control"
        described as {
          |The control through which a user submits the update performance request.
        }
      }
      input UpdateVendorInfoInput acquires command VendorContext.Vendor.UpdateVendorInfo with {
        briefly "Update vendor info control"
        described as {
          |The control through which a user submits the update vendor info request.
        }
      }
      input SubmitApplicationInput acquires command VendorContext.SubmitApplication with {
        briefly "Submit application control"
        described as {
          |The control through which a user submits the submit application request.
        }
      }
      input ApproveVendorInput acquires command VendorContext.Vendor.ApproveVendor with {
        briefly "Approve vendor control"
        described as {
          |The control through which a user submits the approve vendor request.
        }
      }
    } with {
      briefly "Vendor management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppVendorRepositoryQueries is query VendorContext.GetVendorPerformanceSummary
    inlet AppVendorRepositoryReplies is result VendorContext.VendorPerformanceSummaryView
    outlet AppVendorQueries is query VendorContext.Vendor.GetVendor
    outlet AppVendorCommands is type VendorContext.VendorRequest
    inlet AppVendorRepositoryResponses is result VendorContext.Vendor.VendorResult
    handler VendorManagementAppHandler is {
      on other is {
        error "Unexpected message for application context VendorManagementApp"
      }
    } with {
      briefly "VendorManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "VendorManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ComplianceServiceRequest Stream' is from outlet VendorContext.ToComplianceService.ToComplianceServiceOut to inlet ComplianceService.ComplianceServiceRequests with {
    briefly "What VendorContext asks ComplianceService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet VendorContext.NotificationAdapter.NotificationAdapterOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What VendorContext asks NotificationService to send"
  }
  persistent connector 'PaymentServiceRequest Stream' is from outlet VendorContext.PaymentAdapter.PaymentAdapterOut to inlet PaymentService.PaymentServiceRequests with {
    briefly "What VendorContext asks PaymentService to send"
  }
  persistent connector 'VendorRepositoryQuery Stream' is from outlet VendorManagementApp.AppVendorRepositoryQueries to inlet VendorContext.VendorRepositoryQueriesIn with {
    briefly "VendorManagementApp's look-ups of the vendor repository"
  }
  persistent connector 'VendorRepositoryReply Stream' is from outlet VendorContext.VendorRepositoryRepliesOut to inlet VendorManagementApp.AppVendorRepositoryReplies with {
    briefly "The vendor repository's answers returned to VendorManagementApp"
  }
  persistent connector 'VendorQuery Stream' is from outlet VendorManagementApp.AppVendorQueries to inlet VendorContext.VendorQueriesIn with {
    briefly "VendorManagementApp's look-ups of the vendor"
  }
  persistent connector 'VendorCommand Stream' is from outlet VendorManagementApp.AppVendorCommands to inlet VendorContext.VendorCommandStreamIn with {
    briefly "Vendor commands from the application"
  }
  persistent connector 'VendorResult Stream' is from outlet VendorContext.VendorResultStreamOut to inlet VendorManagementApp.AppVendorRepositoryResponses with {
    briefly "Vendor query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet VendorManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Vendor management domain"
  described as {
    | The VendorManagement domain handles marketplace vendor lifecycle
    | including onboarding, verification, performance tracking, and
    | payout management.
  }
}
