// Product Catalog Domain
// Manages product listings, categories, and merchandising
domain ProductCatalog is {
  author Ossum is {
    name = "Ossum Inc."
    email = "info@ossum.com"
  } with {
    briefly "Domain author"
    described as {
      |The organization responsible for this domain model.
    }
  }
  // Users
  user ProductManager is "manages product listings and pricing" with {
    briefly "Product manager"
    described as {
      |Staff member responsible for product catalog management.
    }
  }
  user Merchandiser is "configures categories and promotions" with {
    briefly "Merchandiser"
    described as {
      |Staff member who organizes products and creates promotional content.
    }
  }
  user Customer is "browses and searches products" with {
    briefly "Customer"
    described as {
      |End user browsing the product catalog.
    }
  }
  // Include the bounded context
  include "CatalogContext.riddl"
  include "external-contexts.riddl"
  // Epics
  epic CreateProductEpic is {
    user ProductManager wants to "to add a new product to the catalog" so that "customers can discover and purchase it"
    case HappyPath is {
      user ProductManager wants to "to create a product with complete information" so that "it can be published immediately"
      step is "Product Manager enters product details" "including name, description, and attributes" "in the catalog system" with {
        briefly "Enter details"
        described as {
          |Manager enters product information.
        }
      }
      step is "System validates product information" "checking for required fields" "and data quality" with {
        briefly "Validate info"
        described as {
          |System checks product data quality.
        }
      }
      step take input ProductCatalogApp.ProductCatalogScreen.CreateProductInput from user ProductManager with {
        briefly "Create product"
        described as {
          |Send create command to product entity.
        }
      }
      step is "System assigns SKU and categories" "based on product attributes" "for organization" with {
        briefly "Assign SKU"
        described as {
          |System assigns SKU and categories.
        }
      }
      step is "Product Manager sets pricing" "for different customer tiers" "and regions" with {
        briefly "Set pricing"
        described as {
          |Manager configures product pricing.
        }
      }
      step take input ProductCatalogApp.ProductCatalogScreen.PublishProductInput from user ProductManager with {
        briefly "Publish product"
        described as {
          |Send publish command to product entity.
        }
      }
    } with {
      briefly "Create and publish a new product"
      described as {
        |The standard workflow for adding a new product to the catalog.
      }
    }
  } with {
    briefly "Add products to catalog"
    described as {
      | Epic covering the product creation workflow from initial entry
      | through categorization, pricing, and publication.
    }
  }
  epic SearchProductsEpic is {
    user Customer wants to "to find products matching their needs" so that "they can make informed purchase decisions"
    case BrowseByCategory is {
      user Customer wants to "to browse products in a category" so that "they can explore available options"
      step is "Customer selects a category" "from the navigation menu" "to browse" with {
        briefly "Select category"
        described as {
          |Customer chooses a category to browse.
        }
      }
      step is "System displays products in category" "with filters and sorting options" "for discovery" with {
        briefly "Display products"
        described as {
          |System shows products with filtering options.
        }
      }
      step is "Customer applies filters" "to narrow down results" "by attributes" with {
        briefly "Apply filters"
        described as {
          |Customer narrows results using filters.
        }
      }
      step is "System refines product list" "based on selected criteria" "for relevance" with {
        briefly "Refine results"
        described as {
          |System updates product list based on filters.
        }
      }
    } with {
      briefly "Browse products by category"
      described as {
        |Customer navigation through product categories.
      }
    }
  } with {
    briefly "Product discovery and search"
    described as {
      | Epic covering customer product discovery through browsing,
      | searching, and filtering the product catalog.
    }
  }
  application context ProductCatalogApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ProductCatalog are delivered.
      }
    }
    group ProductCatalogScreen is {
      input CreateProductInput acquires command CreateProduct with {
        briefly "Create product control"
        described as {
          |The control through which a user submits the create product request.
        }
      }
      input PublishProductInput acquires command PublishProduct with {
        briefly "Publish product control"
        described as {
          |The control through which a user submits the publish product request.
        }
      }
    } with {
      briefly "Product catalog screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppCategoryCommands is type CatalogContext.Category.CategoryCommand
    outlet AppPriceListCommands is type CatalogContext.PriceList.PriceListCommand
    outlet AppProductCommands is type CatalogContext.Product.ProductCommand
    inlet AppCatalogRepositoryResponses is type CatalogContext.Category.CategoryResult    handler ProductCatalogAppHandler is {
      on other is {
        error "Unexpected message for application context ProductCatalogApp"
      }
    } with {
      briefly "ProductCatalogApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ProductCatalogApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'CategoryCommand Stream' is from outlet ProductCatalogApp.AppCategoryCommands to inlet CatalogContext.Category.CategoryCommands with {
    option persistent()
    briefly "Category commands from the application"
  }
  connector 'PriceListCommand Stream' is from outlet ProductCatalogApp.AppPriceListCommands to inlet CatalogContext.PriceList.PriceListCommands with {
    option persistent()
    briefly "PriceList commands from the application"
  }
  connector 'ProductCommand Stream' is from outlet ProductCatalogApp.AppProductCommands to inlet CatalogContext.Product.ProductCommands with {
    option persistent()
    briefly "Product commands from the application"
  }
  connector 'CategoryResult Stream' is from outlet CatalogContext.CatalogRepository.CatalogRepositoryResponses to inlet ProductCatalogApp.AppCatalogRepositoryResponses with {
    option persistent()
    briefly "Catalog query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ProductCatalogApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Product catalog management domain"
  described as {
    | The Product Catalog domain manages product information, categorization,
    | pricing, and merchandising for e-commerce operations. It provides
    | product discovery capabilities for customers and management tools
    | for merchandising staff.
  }
}
