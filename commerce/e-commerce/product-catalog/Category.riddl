// Product Catalog - Category Entity
entity Category as flow is {
  type CategoryCommand is one of {
    Category.CreateCategory or Category.UpdateCategory or Category.MoveCategory or Category.ActivateCategory or Category.DeactivateCategory
  } with {
    briefly "Category command alternation"
    described as {
      |Commands accepted by the Category entity.
    }
  }
  inlet CategoryCommands is type CategoryCommand  outlet CategoryEvents2 is type CategoryEvent
  // Commands
  command CreateCategory yields event CategoryCreated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Unique identifier for the new category.
      }
    }
    categoryName: String(1,100) with {
      briefly "Name"
      described as {
        |Display name for the category.
      }
    }
    categoryDescription: String(1,500) with {
      briefly "Description"
      described as {
        |Category description for navigation.
      }
    }
    parentId: CategoryId? with {
      briefly "Parent category"
      described as {
        |Parent category for hierarchical navigation.
      }
    }
    displayOrder: Natural with {
      briefly "Display order"
      described as {
        |Sort order for display in navigation.
      }
    }
  } with {
    briefly "Create a new category"
    described as {
      |Adds a new category to the catalog hierarchy.
    }
  }
  command UpdateCategory yields event CategoryUpdated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category to update.
      }
    }
    updatedCategoryName: String(1,100)? with {
      briefly "Name"
      described as {
        |New name if changing.
      }
    }
    updatedCategoryDescription: String(1,500)? with {
      briefly "Description"
      described as {
        |New description if changing.
      }
    }
    newDisplayOrder: Natural? with {
      briefly "Display order"
      described as {
        |New sort order if changing.
      }
    }
  } with {
    briefly "Update category details"
    described as {
      |Modifies category information.
    }
  }
  command MoveCategory yields event CategoryMoved is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category to move.
      }
    }
    newParentId: CategoryId? with {
      briefly "New parent"
      described as {
        |New parent category, or none for top-level.
      }
    }
  } with {
    briefly "Move category in hierarchy"
    described as {
      |Changes the parent of a category.
    }
  }
  command ActivateCategory yields event CategoryActivated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category to activate.
      }
    }
  } with {
    briefly "Activate category"
    described as {
      |Makes the category visible in navigation.
    }
  }
  command DeactivateCategory yields event CategoryDeactivated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category to deactivate.
      }
    }
  } with {
    briefly "Deactivate category"
    described as {
      |Hides the category from navigation.
    }
  }
  // Events
  event CategoryCreated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |New category.
      }
    }
    categoryName: String(1,100) with {
      briefly "Name"
      described as {
        |Category name.
      }
    }
    parentId: CategoryId? with {
      briefly "Parent"
      described as {
        |Parent category.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created at"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Category was created"
    described as {
      |Emitted when a new category is added.
    }
  }
  event CategoryUpdated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Updated category.
      }
    }
    updatedCategoryName: String(1,100)? with {
      briefly "Name"
      described as {
        |New name.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated at"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Category was updated"
    described as {
      |Emitted when category details change.
    }
  }
  event CategoryMoved is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Moved category.
      }
    }
    oldParentId: CategoryId? with {
      briefly "Old parent"
      described as {
        |Previous parent.
      }
    }
    newParentId: CategoryId? with {
      briefly "New parent"
      described as {
        |New parent.
      }
    }
    movedAt: TimeStamp with {
      briefly "Moved at"
      described as {
        |Move time.
      }
    }
  } with {
    briefly "Category was moved"
    described as {
      |Emitted when a category changes parent.
    }
  }
  event CategoryActivated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Activated category.
      }
    }
    activatedAt: TimeStamp with {
      briefly "Activated at"
      described as {
        |Activation time.
      }
    }
  } with {
    briefly "Category was activated"
    described as {
      |Emitted when a category becomes visible.
    }
  }
  event CategoryDeactivated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Deactivated category.
      }
    }
    deactivatedAt: TimeStamp with {
      briefly "Deactivated at"
      described as {
        |Deactivation time.
      }
    }
  } with {
    briefly "Category was deactivated"
    described as {
      |Emitted when a category is hidden.
    }
  }
  // State Records
  record ActiveCategoryData is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category identifier.
      }
    }
    categoryName: String(1,100) with {
      briefly "Name"
      described as {
        |Category name.
      }
    }
    categoryDescription: String(1,500) with {
      briefly "Description"
      described as {
        |Category description.
      }
    }
    parentId: CategoryId? with {
      briefly "Parent"
      described as {
        |Parent category.
      }
    }
    displayOrder: Natural with {
      briefly "Order"
      described as {
        |Display order.
      }
    }
    productCount: Natural with {
      briefly "Products"
      described as {
        |Number of products.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Active category data"
    described as {
      |State data for a visible category.
    }
  }
  record InactiveCategoryData is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category identifier.
      }
    }
    categoryName: String(1,100) with {
      briefly "Name"
      described as {
        |Category name.
      }
    }
    deactivatedAt: TimeStamp with {
      briefly "Deactivated"
      described as {
        |Deactivation time.
      }
    }
  } with {
    briefly "Inactive category data"
    described as {
      |State data for a hidden category.
    }
  }
  query GetCategory replies result CategoryResult is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category to retrieve.
      }
    }
  } with {
    briefly "Get category"
    described as {
      |Retrieves category data.
    }
  }
  result CategoryResult is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category identifier.
      }
    }
    categoryName: String(1,100) with {
      briefly "Name"
      described as {
        |Category name.
      }
    }
  } with {
    briefly "Category result"
    described as {
      |Category data result.
    }
  }
  // States
  initial state ActiveState of record Category.ActiveCategoryData is {
    initial handler ActiveStateInitHandler is {
      on init is {
        set state ActiveState to "initialize from prior event"
      }
    } with {
      briefly "Active state init handler"
      described as {
        |Initializes the Active state.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |Category is active.
    }
  }
  state InactiveState of record Category.InactiveCategoryData is {
    initial handler InactiveStateInitHandler is {
      on init is {
        set state InactiveState to "initialize from prior event"
      }
    } with {
      briefly "Inactive state init handler"
      described as {
        |Initializes the Inactive state.
      }
    }
  } with {
    briefly "Inactive state"
    described as {
      |Category is inactive.
    }
  }
  // Handler
  handler CategoryHandler is {
    on categoryActivated: event CategoryActivated is {
      do "apply CategoryActivated to the category so it can be persisted and replayed"
    }
    on categoryCreated: event CategoryCreated is {
      do "apply CategoryCreated to the category so it can be persisted and replayed"
    }
    on categoryDeactivated: event CategoryDeactivated is {
      do "apply CategoryDeactivated to the category so it can be persisted and replayed"
    }
    on categoryMoved: event CategoryMoved is {
      do "apply CategoryMoved to the category so it can be persisted and replayed"
    }
    on categoryUpdated: event CategoryUpdated is {
      do "apply CategoryUpdated to the category so it can be persisted and replayed"
    }
    on createCategory: command CreateCategory is {
      morph entity Category to state Category.ActiveState with record Category.ActiveCategoryData(categoryId = createCategory.categoryId, categoryName = createCategory.categoryName, categoryDescription = createCategory.categoryDescription, parentId = createCategory.parentId, displayOrder = createCategory.displayOrder, productCount = prompt("the product count of this active category data"), createdAt = prompt("the created at of this active category data"))
      yield event CategoryCreated(categoryId = createCategory.categoryId, categoryName = createCategory.categoryName, parentId = createCategory.parentId, createdAt = prompt("the created at of this category created"))
    }
    on updateCategory: command UpdateCategory is {
      yield event CategoryUpdated(categoryId = updateCategory.categoryId, updatedCategoryName = updateCategory.updatedCategoryName, updatedAt = prompt("the updated at of this category updated"))
    }
    on moveCategory: command MoveCategory is {
      yield event CategoryMoved(categoryId = moveCategory.categoryId, newParentId = moveCategory.newParentId, oldParentId = empty, movedAt = prompt("the moved at of this category moved"))
    }
    on activateCategory: command ActivateCategory is {
      morph entity Category to state Category.ActiveState with record Category.ActiveCategoryData(categoryId = activateCategory.categoryId, categoryName = prompt("the category name of this active category data"), categoryDescription = prompt("the category description of this active category data"), parentId = empty, displayOrder = prompt("the display order of this active category data"), productCount = prompt("the product count of this active category data"), createdAt = prompt("the created at of this active category data"))
      yield event CategoryActivated(categoryId = activateCategory.categoryId, activatedAt = prompt("the activated at of this category activated"))
    }
    on deactivateCategory: command DeactivateCategory is {
      morph entity Category to state Category.InactiveState with record Category.InactiveCategoryData(categoryId = deactivateCategory.categoryId, categoryName = prompt("the category name of this inactive category data"), deactivatedAt = prompt("the deactivated at of this inactive category data"))
      yield event CategoryDeactivated(categoryId = deactivateCategory.categoryId, deactivatedAt = prompt("the deactivated at of this category deactivated"))
    }
    on getCategory: query GetCategory is {
      reply result CategoryResult(categoryId = getCategory.categoryId, categoryName = prompt("the category name of this category result"))
    }
  } with {
    briefly "Processes category commands"
    described as {
      |Handles category lifecycle and hierarchy management.
    }
  }
} with {
  briefly "Category for product organization"
  described as {
    | The Category entity manages hierarchical product categorization
    | for navigation and discovery. Categories can be nested and
    | activated or deactivated for display control.
  }
}
