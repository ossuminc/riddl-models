// Product Catalog - Category Entity
event-sourced entity Category as router is {
  type CategoryCommand is one of {
    Category.UpdateCategory or Category.MoveCategory or Category.ActivateCategory or Category.DeactivateCategory
  } with {
    briefly "Category command alternation"
    described as {
      |Commands accepted by the Category entity.
    }
  }
  inlet CategoryQueries is query GetCategory with {
    briefly "Look-ups of this category"
    described as {
      |What ProductCatalogApp asks of the category, by way of CatalogContext.
    }
  }
  outlet CategoryReplies is result CategoryResult
 with {
    briefly "This category's answers"
    described as {
      |What the category answers, on its way back to CatalogContext.
    }
  }
  inlet CategoryCommands is type CategoryCommand
  outlet CategoryEvents2 is type CategoryEvent
  // Commands
  command UpdateCategory yields event CategoryUpdated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category to update.
      }
    }
    updatedCategoryName: String(1,100)? with {
      briefly "Name"
      described as {
        |New name if changing.
      }
    }
    updatedCategoryDescription: String(1,500)? with {
      briefly "Description"
      described as {
        |New description if changing.
      }
    }
    newDisplayOrder: Natural? with {
      briefly "Display order"
      described as {
        |New sort order if changing.
      }
    }
  } with {
    briefly "Update category details"
    described as {
      |Modifies category information.
    }
  }
  command MoveCategory yields event CategoryMoved is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category to move.
      }
    }
    newParentId: CategoryId? with {
      briefly "New parent"
      described as {
        |New parent category, or none for top-level.
      }
    }
  } with {
    briefly "Move category in hierarchy"
    described as {
      |Changes the parent of a category.
    }
  }
  command ActivateCategory yields event CategoryActivated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category to activate.
      }
    }
  } with {
    briefly "Activate category"
    described as {
      |Makes the category visible in navigation.
    }
  }
  command DeactivateCategory yields event CategoryDeactivated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category to deactivate.
      }
    }
  } with {
    briefly "Deactivate category"
    described as {
      |Hides the category from navigation.
    }
  }
  // Events
  event CategoryCreated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |New category.
      }
    }
    categoryName: String(1,100) with {
      briefly "Name"
      described as {
        |Category name.
      }
    }
    parentId: CategoryId? with {
      briefly "Parent"
      described as {
        |Parent category.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created at"
      described as {
        |Creation time.
      }
    }
    categoryDescription: String(1,500) with {
      briefly "Category description"
    }
    displayOrder: Natural with {
      briefly "Display order"
    }
  } with {
    briefly "Category was created"
    described as {
      |Emitted when a new category is added.
    }
  }
  event CategoryUpdated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Updated category.
      }
    }
    updatedCategoryName: String(1,100)? with {
      briefly "Name"
      described as {
        |New name.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated at"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Category was updated"
    described as {
      |Emitted when category details change.
    }
  }
  event CategoryMoved is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Moved category.
      }
    }
    oldParentId: CategoryId? with {
      briefly "Old parent"
      described as {
        |Previous parent.
      }
    }
    newParentId: CategoryId? with {
      briefly "New parent"
      described as {
        |New parent.
      }
    }
    movedAt: TimeStamp with {
      briefly "Moved at"
      described as {
        |Move time.
      }
    }
  } with {
    briefly "Category was moved"
    described as {
      |Emitted when a category changes parent.
    }
  }
  event CategoryActivated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Activated category.
      }
    }
    activatedAt: TimeStamp with {
      briefly "Activated at"
      described as {
        |Activation time.
      }
    }
  } with {
    briefly "Category was activated"
    described as {
      |Emitted when a category becomes visible.
    }
  }
  event CategoryDeactivated is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Deactivated category.
      }
    }
    deactivatedAt: TimeStamp with {
      briefly "Deactivated at"
      described as {
        |Deactivation time.
      }
    }
  } with {
    briefly "Category was deactivated"
    described as {
      |Emitted when a category is hidden.
    }
  }
  // State Records
  record ActiveCategoryData is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category identifier.
      }
    }
    categoryName: String(1,100) with {
      briefly "Name"
      described as {
        |Category name.
      }
    }
    categoryDescription: String(1,500) with {
      briefly "Description"
      described as {
        |Category description.
      }
    }
    parentId: CategoryId? with {
      briefly "Parent"
      described as {
        |Parent category.
      }
    }
    displayOrder: Natural with {
      briefly "Order"
      described as {
        |Display order.
      }
    }
    productCount: Natural with {
      briefly "Products"
      described as {
        |Number of products.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
    movedAt: TimeStamp? with {
      briefly "Moved at"
    }
    updatedAt: TimeStamp? with {
      briefly "Updated at"
    }
  } with {
    briefly "Active category data"
    described as {
      |State data for a visible category.
    }
  }
  record InactiveCategoryData is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category identifier.
      }
    }
    categoryName: String(1,100) with {
      briefly "Name"
      described as {
        |Category name.
      }
    }
    deactivatedAt: TimeStamp with {
      briefly "Deactivated"
      described as {
        |Deactivation time.
      }
    }
  } with {
    briefly "Inactive category data"
    described as {
      |State data for a hidden category.
    }
  }
  query GetCategory replies result CategoryResult is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category to retrieve.
      }
    }
  } with {
    briefly "Get category"
    described as {
      |Retrieves category data.
    }
  }
  result CategoryResult is {
    categoryId: CategoryId with {
      briefly "Category ID"
      described as {
        |Category identifier.
      }
    }
    categoryName: String(1,100) with {
      briefly "Name"
      described as {
        |Category name.
      }
    }
  } with {
    briefly "Category result"
    described as {
      |Category data result.
    }
  }
  // States
  state ActiveState of record Category.ActiveCategoryData with {
    briefly "Active state"
    described as {
      |Category is active.
    }
  }
  state InactiveState of record Category.InactiveCategoryData with {
    briefly "Inactive state"
    described as {
      |Category is inactive.
    }
  }
  // Handler
  handler CategoryHandler is {
    on init(categoryName: String(1,100), parentId: type CategoryId?, createdAt: TimeStamp, categoryDescription: String(1,500), displayOrder: Natural) is {
      morph entity Category to state Category.ActiveState with record Category.ActiveCategoryData(categoryId = self.id, categoryName = categoryName, categoryDescription = categoryDescription, parentId = parentId, displayOrder = displayOrder, productCount = prompt("the product count of this active category data"), createdAt = prompt("the created at of this active category data"), movedAt = empty, updatedAt = empty)
      send event CategoryCreated(categoryId = self.id, categoryName = categoryName, parentId = parentId, createdAt = createdAt, categoryDescription = categoryDescription, displayOrder = displayOrder) to outlet CatalogContext.Category.CategoryEvents2
    }
    on categoryActivated: event CategoryActivated is {
      morph entity Category to state Category.ActiveState with record Category.ActiveCategoryData(categoryId = categoryActivated.categoryId, categoryName = prompt("the category name of this active category data"), categoryDescription = prompt("the category description of this active category data"), parentId = empty, displayOrder = prompt("the display order of this active category data"), productCount = prompt("the product count of this active category data"), createdAt = prompt("the created at of this active category data"), movedAt = empty, updatedAt = empty)
    }
    on categoryDeactivated: event CategoryDeactivated is {
      morph entity Category to state Category.InactiveState with record Category.InactiveCategoryData(categoryId = categoryDeactivated.categoryId, categoryName = prompt("the category name of this inactive category data"), deactivatedAt = prompt("the deactivated at of this inactive category data"))
    }
    on categoryMoved: event CategoryMoved is {
      set field Category.ActiveState.parentId to categoryMoved.newParentId
      set field Category.ActiveState.movedAt to categoryMoved.movedAt
    }
    on categoryUpdated: event CategoryUpdated is {
      set field Category.ActiveState.categoryName to prompt("updatedCategoryName when present, else unchanged")
      set field Category.ActiveState.updatedAt to categoryUpdated.updatedAt
    }
    on updateCategory: command UpdateCategory is {
      yield event CategoryUpdated(categoryId = updateCategory.categoryId, updatedCategoryName = updateCategory.updatedCategoryName, updatedAt = system.now)
    }
    on moveCategory: command MoveCategory is {
      yield event CategoryMoved(categoryId = moveCategory.categoryId, newParentId = moveCategory.newParentId, oldParentId = empty, movedAt = system.now)
    }
    on activateCategory: command ActivateCategory is {
      yield event CategoryActivated(categoryId = activateCategory.categoryId, activatedAt = system.now)
    }
    on deactivateCategory: command DeactivateCategory is {
      yield event CategoryDeactivated(categoryId = deactivateCategory.categoryId, deactivatedAt = system.now)
    }
    on getCategory: query GetCategory is {
      reply result CategoryResult(categoryId = getCategory.categoryId, categoryName = prompt("the category name of this category result"))
    }
  } with {
    briefly "Processes category commands"
    described as {
      |Handles category lifecycle and hierarchy management.
    }
  }
} with {
  briefly "Category for product organization"
  described as {
    | The Category entity manages hierarchical product categorization
    | for navigation and discovery. Categories can be nested and
    | activated or deactivated for display control.
  }
}
