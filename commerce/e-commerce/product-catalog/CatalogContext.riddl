      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      attributes: AttributeValue+ with {
        briefly "Attributes"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      images: ImageUrl+ with {
        briefly "Images"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ProductCreated"
      described as {
        |Instructs this repository to apply ProductCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
