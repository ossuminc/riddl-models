    }
    command PersistPriceListCreated is {
      priceListId: PriceListId with {
        briefly "Row addressed"
        described as {
          |Which stored row PriceListCreated applies to.
        }
      }
      listName: String(1,100)? with {
        briefly "List name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      currency: Currency(USD)? with {
        briefly "Currency"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      listDescription: String(1,500)? with {
        briefly "List description"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      priority: Natural? with {
        briefly "Priority"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PriceListCreated"
      described as {
        |Instructs this repository to apply PriceListCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
