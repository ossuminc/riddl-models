// Product Catalog - Catalog Context
context CatalogContext as router is {
  inlet CategoryCommandStreamIn is type CategoryCommand  outlet CategoryCommandStreamOut is type CategoryCommand
  inlet PriceListCommandStreamIn is type PriceListCommand  outlet PriceListCommandStreamOut is type PriceListCommand
  inlet ProductCommandStreamIn is type ProductCommand  outlet ProductCommandStreamOut is type ProductCommand
  inlet CategoryResultStreamIn is result Category.CategoryResult  outlet CategoryResultStreamOut is result Category.CategoryResult
  handler CatalogContextBoundary is {
    on createCategory: command Category.CreateCategory is {
      forward createCategory to outlet CatalogContext.CategoryCommandStreamOut
    }
    on updateCategory: command Category.UpdateCategory is {
      forward updateCategory to outlet CatalogContext.CategoryCommandStreamOut
    }
    on moveCategory: command Category.MoveCategory is {
      forward moveCategory to outlet CatalogContext.CategoryCommandStreamOut
    }
    on activateCategory: command Category.ActivateCategory is {
      forward activateCategory to outlet CatalogContext.CategoryCommandStreamOut
    }
    on deactivateCategory: command Category.DeactivateCategory is {
      forward deactivateCategory to outlet CatalogContext.CategoryCommandStreamOut
    }
    on createPriceList: command PriceList.CreatePriceList is {
      forward createPriceList to outlet CatalogContext.PriceListCommandStreamOut
    }
    on setProductPrice: command PriceList.SetProductPrice is {
      forward setProductPrice to outlet CatalogContext.PriceListCommandStreamOut
    }
    on activatePriceList: command PriceList.ActivatePriceList is {
      forward activatePriceList to outlet CatalogContext.PriceListCommandStreamOut
    }
    on deactivatePriceList: command PriceList.DeactivatePriceList is {
      forward deactivatePriceList to outlet CatalogContext.PriceListCommandStreamOut
    }
    on createProduct: command Product.CreateProduct is {
      forward createProduct to outlet CatalogContext.ProductCommandStreamOut
    }
    on updateProduct: command Product.UpdateProduct is {
      forward updateProduct to outlet CatalogContext.ProductCommandStreamOut
    }
    on setPrice: command Product.SetPrice is {
      forward setPrice to outlet CatalogContext.ProductCommandStreamOut
    }
    on addVariant: command Product.AddVariant is {
      forward addVariant to outlet CatalogContext.ProductCommandStreamOut
    }
    on assignCategory: command Product.AssignCategory is {
      forward assignCategory to outlet CatalogContext.ProductCommandStreamOut
    }
    on publishProduct: command Product.PublishProduct is {
      forward publishProduct to outlet CatalogContext.ProductCommandStreamOut
    }
    on retireProduct: command Product.RetireProduct is {
      forward retireProduct to outlet CatalogContext.ProductCommandStreamOut
    }
    on categoryResult: result Category.CategoryResult is {
      send categoryResult to outlet CatalogContext.CategoryResultStreamOut
    }
    on other is {
      error "Unexpected message at the CatalogContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CategoryCommand Stream Intake' is from outlet CatalogContext.CategoryCommandStreamOut to inlet CatalogContext.Category.CategoryCommands  connector 'PriceListCommand Stream Intake' is from outlet CatalogContext.PriceListCommandStreamOut to inlet CatalogContext.PriceList.PriceListCommands  connector 'ProductCommand Stream Intake' is from outlet CatalogContext.ProductCommandStreamOut to inlet CatalogContext.Product.ProductCommands  connector 'CategoryResult Stream Egress' is from outlet CatalogContext.CatalogRepository.CatalogRepositoryResponses to inlet CatalogContext.CategoryResultStreamIn  adaptor FromERPSystem from context ERPSystem is { 
    handler FromERPSystemHandler is {
      on event ERPSystem.ProductMasterCreated is {
        do "the model receives product master created"
      }
      on event ERPSystem.ProductMasterUpdated is {
        do "the model receives product master updated"
      }
      on other is {
        error "Unexpected message for adaptor FromERPSystem"
      }
    } with {
      briefly "from erp system"
      described as {
        |Carries messages from the external ERPSystem.
      }
    }
  } with {
    briefly "ERPSystem integration"
    described as {
      |The model's side of the ERPSystem conversation.
    }
  }
  adaptor FromSearchEngine from context SearchEngine is { 
    handler FromSearchEngineHandler is {
      on event SearchEngine.ProductIndexed is {
        do "the model receives product indexed"
      }
      on other is {
        error "Unexpected message for adaptor FromSearchEngine"
      }
    } with {
      briefly "from search engine"
      described as {
        |Carries messages from the external SearchEngine.
      }
    }
  } with {
    briefly "SearchEngine integration"
    described as {
      |The model's side of the SearchEngine conversation.
    }
  }
  include "types.riddl"
  include "Product.riddl"
  include "Category.riddl"
  include "PriceList.riddl"
  // Adaptors for external system integration
  adaptor InventoryAdapter from context InventoryService is { 
    handler InventoryEvents is {
      on event InventoryService.StockLevelChanged is {
        do "Update product availability display"
      }
      on event InventoryService.StockDepleted is {
        do "Mark product as out of stock"
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles inventory events"
      described as {
        |Processes inventory updates for availability display.
      }
    }
  } with {
    briefly "Inventory integration"
    described as {
      |Receives stock level updates from the inventory system.
    }
  }
  adaptor SearchAdapter to context SearchEngine is { 
    handler SearchIndexing is {
      on command SearchEngine.IndexProduct is {
        do "Index or update product in search engine"
      }
      on command SearchEngine.RemoveProduct is {
        do "Remove product from search index"
      }
      on other is {
        error "Unexpected message for adaptor SearchAdapter"
      }
    } with {
      briefly "Handles search indexing"
      described as {
        |Translates product commands for search engine indexing.
      }
    }
  } with {
    briefly "Search engine integration"
    described as {
      |Publishes product changes to the search engine for discovery.
    }
  }
  adaptor ContentAdapter from context ContentManagement is { 
    handler ContentEvents is {
      on event ContentManagement.ImageUploaded is {
        do "Associate image with product"
      }
      on event ContentManagement.ImageDeleted is {
        do "Remove image reference from product"
      }
      on other is {
        error "Unexpected message for adaptor ContentAdapter"
      }
    } with {
      briefly "Handles content events"
      described as {
        |Processes image and content updates.
      }
    }
  } with {
    briefly "Content management integration"
    described as {
      |Receives image and content updates from the CMS.
    }
  }
  // Repository for catalog persistence
  type CatalogRepositoryCommand is one of {
    CatalogContext.CatalogRepository.PersistCategoryActivated or CatalogContext.CatalogRepository.PersistCategoryAssigned or CatalogContext.CatalogRepository.PersistCategoryCreated or CatalogContext.CatalogRepository.PersistCategoryDeactivated or CatalogContext.CatalogRepository.PersistCategoryMoved or CatalogContext.CatalogRepository.PersistCategoryUpdated or CatalogContext.CatalogRepository.PersistPriceChanged or CatalogContext.CatalogRepository.PersistPriceListActivated or CatalogContext.CatalogRepository.PersistPriceListCreated or CatalogContext.CatalogRepository.PersistPriceListDeactivated or CatalogContext.CatalogRepository.PersistProductCreated or CatalogContext.CatalogRepository.PersistProductPriceSet or CatalogContext.CatalogRepository.PersistProductPublished or CatalogContext.CatalogRepository.PersistProductRetired or CatalogContext.CatalogRepository.PersistProductUpdated or CatalogContext.CatalogRepository.PersistVariantAdded
  } with {
    briefly "Anything that writes CatalogRepository"
    described as {
      |The persistence commands CatalogRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository CatalogRepository as flow is {
    inlet CatalogRepositoryFromCatalogViews is type CatalogRepositoryCommand    command PersistCategoryActivated is  {
      categoryId: CategoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row CategoryActivated applies to.
        }
      }
    } with {
      briefly "Persist CategoryActivated"
      described as {
        |Instructs this repository to apply CategoryActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCategoryCreated is  {
      categoryId: CategoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row CategoryCreated applies to.
        }
      }
    } with {
      briefly "Persist CategoryCreated"
      described as {
        |Instructs this repository to apply CategoryCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCategoryDeactivated is  {
      categoryId: CategoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row CategoryDeactivated applies to.
        }
      }
    } with {
      briefly "Persist CategoryDeactivated"
      described as {
        |Instructs this repository to apply CategoryDeactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCategoryMoved is  {
      categoryId: CategoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row CategoryMoved applies to.
        }
      }
    } with {
      briefly "Persist CategoryMoved"
      described as {
        |Instructs this repository to apply CategoryMoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCategoryUpdated is  {
      categoryId: CategoryId with {
        briefly "Row addressed"
        described as {
          |Which stored row CategoryUpdated applies to.
        }
      }
    } with {
      briefly "Persist CategoryUpdated"
      described as {
        |Instructs this repository to apply CategoryUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPriceListActivated is  {
      priceListId: PriceListId with {
        briefly "Row addressed"
        described as {
          |Which stored row PriceListActivated applies to.
        }
      }
    } with {
      briefly "Persist PriceListActivated"
      described as {
        |Instructs this repository to apply PriceListActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPriceListCreated is  {
      priceListId: PriceListId with {
        briefly "Row addressed"
        described as {
          |Which stored row PriceListCreated applies to.
        }
      }
    } with {
      briefly "Persist PriceListCreated"
      described as {
        |Instructs this repository to apply PriceListCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPriceListDeactivated is  {
      priceListId: PriceListId with {
        briefly "Row addressed"
        described as {
          |Which stored row PriceListDeactivated applies to.
        }
      }
    } with {
      briefly "Persist PriceListDeactivated"
      described as {
        |Instructs this repository to apply PriceListDeactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProductPriceSet is  {
      priceListId: PriceListId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProductPriceSet applies to.
        }
      }
    } with {
      briefly "Persist ProductPriceSet"
      described as {
        |Instructs this repository to apply ProductPriceSet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPriceChanged is  {
      productId: ProductId with {
        briefly "Row addressed"
        described as {
          |Which stored row PriceChanged applies to.
        }
      }
    } with {
      briefly "Persist PriceChanged"
      described as {
        |Instructs this repository to apply PriceChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProductRetired is  {
      productId: ProductId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProductRetired applies to.
        }
      }
    } with {
      briefly "Persist ProductRetired"
      described as {
        |Instructs this repository to apply ProductRetired to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProductUpdated is  {
      productId: ProductId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProductUpdated applies to.
        }
      }
    } with {
      briefly "Persist ProductUpdated"
      described as {
        |Instructs this repository to apply ProductUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVariantAdded is  {
      productId: ProductId with {
        briefly "Row addressed"
        described as {
          |Which stored row VariantAdded applies to.
        }
      }
    } with {
      briefly "Persist VariantAdded"
      described as {
        |Instructs this repository to apply VariantAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCategoryAssigned is  {
      productId: ProductId with {
        briefly "Row addressed"
        described as {
          |Which stored row CategoryAssigned applies to.
        }
      }
    } with {
      briefly "Persist CategoryAssigned"
      described as {
        |Instructs this repository to apply CategoryAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProductCreated is  {
      productId: ProductId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProductCreated applies to.
        }
      }
    } with {
      briefly "Persist ProductCreated"
      described as {
        |Instructs this repository to apply ProductCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProductPublished is  {
      productId: ProductId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProductPublished applies to.
        }
      }
    } with {
      briefly "Persist ProductPublished"
      described as {
        |Instructs this repository to apply ProductPublished to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet CatalogRepositoryResponses is result Category.CategoryResult
    record StoredCategory is  {
      categoryId: CategoryId with {
        briefly "categoryId"
        described as {
          |The categoryId column of the stored category row.
        }
      }
      categoryName: String(1,100) with {
        briefly "categoryName"
        described as {
          |The categoryName column of the stored category row.
        }
      }
    } with {
      briefly "Stored category row"
      described as {
        |The persistence shape of category data as this repository stores it.
      }
    }
    record StoredPriceList is  {
      priceListId: PriceListId with {
        briefly "priceListId"
        described as {
          |The priceListId column of the stored priceList row.
        }
      }
    } with {
      briefly "Stored priceList row"
      described as {
        |The persistence shape of priceList data as this repository stores it.
      }
    }
    record StoredProduct is  {
      productId: ProductId with {
        briefly "productId"
        described as {
          |The productId column of the stored product row.
        }
      }
      name: ProductName with {
        briefly "name"
        described as {
          |The name column of the stored product row.
        }
      }
      primaryCategory: CategoryId? with {
        briefly "primaryCategory"
        described as {
          |The primaryCategory column of the stored product row.
        }
      }
      sku: SKU with {
        briefly "sku"
        described as {
          |The sku column of the stored product row.
        }
      }
    } with {
      briefly "Stored product row"
      described as {
        |The persistence shape of product data as this repository stores it.
      }
    }
    schema CatalogData is relational
      of categories as record StoredCategory
      of priceLists as record StoredPriceList
      of products as record StoredProduct
        link productCategories as field StoredProduct.primaryCategory to field StoredCategory.categoryId
        index on field StoredProduct.sku
        index on field StoredProduct.name
        index on field StoredCategory.categoryName
 with {
      briefly "Catalog data schema"
      described as {
        |The relational schema holding catalog data for the CatalogRepository.
      }
    }
    handler CatalogPersistence is {
      on persistCategoryActivated: command PersistCategoryActivated is {
        do "apply CategoryActivated to the stored row"
      }
      on persistCategoryCreated: command PersistCategoryCreated is {
        do "apply CategoryCreated to the stored row"
      }
      on persistCategoryDeactivated: command PersistCategoryDeactivated is {
        do "apply CategoryDeactivated to the stored row"
      }
      on persistCategoryMoved: command PersistCategoryMoved is {
        do "apply CategoryMoved to the stored row"
      }
      on persistCategoryUpdated: command PersistCategoryUpdated is {
        do "apply CategoryUpdated to the stored row"
      }
      on persistPriceListActivated: command PersistPriceListActivated is {
        do "apply PriceListActivated to the stored row"
      }
      on persistPriceListCreated: command PersistPriceListCreated is {
        do "apply PriceListCreated to the stored row"
      }
      on persistPriceListDeactivated: command PersistPriceListDeactivated is {
        do "apply PriceListDeactivated to the stored row"
      }
      on persistProductPriceSet: command PersistProductPriceSet is {
        do "apply ProductPriceSet to the stored row"
      }
      on persistPriceChanged: command PersistPriceChanged is {
        do "apply PriceChanged to the stored row"
      }
      on persistProductRetired: command PersistProductRetired is {
        do "apply ProductRetired to the stored row"
      }
      on persistProductUpdated: command PersistProductUpdated is {
        do "apply ProductUpdated to the stored row"
      }
      on persistVariantAdded: command PersistVariantAdded is {
        do "apply VariantAdded to the stored row"
      }
      on persistCategoryAssigned: command PersistCategoryAssigned is {
        do "apply CategoryAssigned to the stored row"
      }
      on persistProductCreated: command PersistProductCreated is {
        do "apply ProductCreated to the stored row"
      }
      on persistProductPublished: command PersistProductPublished is {
        do "apply ProductPublished to the stored row"
      }
      on query GetProductSummary is {
        let productSummaryView: type ProductSummaryView = prompt("read the product summary projection")
        reply productSummaryView
      }
    } with {
      briefly "Persists catalog commands"
      described as {
        |Handles command-driven persistence for catalog data.
      }
    }
  } with {
    briefly "Catalog data persistence"
    described as {
      | The CatalogRepository provides persistent storage for products,
      | categories, and price lists with indexes for efficient queries.
    }
  }
  // Projector for catalog views
  query GetProductSummary replies result ProductSummaryView is  {
    productSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which product summary to retrieve.
      }
    }
  } with {
    briefly "Get product summary"
    described as {
      |Retrieves the product summary projection.
    }
  }
  result ProductSummaryView is  {
    productSummary: CatalogViews.ProductSummary with {
      briefly "Product summary"
      described as {
        |The product summary being returned.
      }
    }
  } with {
    briefly "Product summary view"
    described as {
      |Read model view carrying the product summary projection.
    }
  }
  projector CatalogViews as merge is {
    updates repository CatalogContext.CatalogRepository
    outlet CatalogViewsToRepository is type CatalogRepositoryCommand
    inlet CatalogViewsFromCategory is type CategoryEvent    inlet CatalogViewsFromPriceList is type PriceListEvent    inlet CatalogViewsFromProduct is type ProductEvent    record ProductSummary is  {
      productId: ProductId with {
        briefly "ID"
        described as {
          |Product identifier.
        }
      }
      sku: SKU with {
        briefly "SKU"
        described as {
          |Stock keeping unit.
        }
      }
      name: ProductName with {
        briefly "Name"
        described as {
          |Product name.
        }
      }
      basePrice: Money with {
        briefly "Price"
        described as {
          |Base price.
        }
      }
      category: String(1,100) with {
        briefly "Category"
        described as {
          |Primary category name.
        }
      }
      status: ProductStatus with {
        briefly "Status"
        described as {
          |Product status.
        }
      }
      imageUrl: ImageUrl? with {
        briefly "Image"
        described as {
          |Primary image URL.
        }
      }
    } with {
      briefly "Product summary for listings"
      described as {
        |Lightweight product view for catalog listings.
      }
    }
    handler ViewHandler is {
      on categoryActivated: event Category.CategoryActivated is {
        tell command CatalogContext.CatalogRepository.PersistCategoryActivated(categoryId = categoryActivated.categoryId) to repository CatalogContext.CatalogRepository
        do "apply CategoryActivated to the CatalogViews projection"
      }
      on categoryCreated: event Category.CategoryCreated is {
        tell command CatalogContext.CatalogRepository.PersistCategoryCreated(categoryId = categoryCreated.categoryId) to repository CatalogContext.CatalogRepository
        do "apply CategoryCreated to the CatalogViews projection"
      }
      on categoryDeactivated: event Category.CategoryDeactivated is {
        tell command CatalogContext.CatalogRepository.PersistCategoryDeactivated(categoryId = categoryDeactivated.categoryId) to repository CatalogContext.CatalogRepository
        do "apply CategoryDeactivated to the CatalogViews projection"
      }
      on categoryMoved: event Category.CategoryMoved is {
        tell command CatalogContext.CatalogRepository.PersistCategoryMoved(categoryId = categoryMoved.categoryId) to repository CatalogContext.CatalogRepository
        do "apply CategoryMoved to the CatalogViews projection"
      }
      on categoryUpdated: event Category.CategoryUpdated is {
        tell command CatalogContext.CatalogRepository.PersistCategoryUpdated(categoryId = categoryUpdated.categoryId) to repository CatalogContext.CatalogRepository
        do "apply CategoryUpdated to the CatalogViews projection"
      }
      on priceListActivated: event PriceList.PriceListActivated is {
        tell command CatalogContext.CatalogRepository.PersistPriceListActivated(priceListId = priceListActivated.priceListId) to repository CatalogContext.CatalogRepository
        do "apply PriceListActivated to the CatalogViews projection"
      }
      on priceListCreated: event PriceList.PriceListCreated is {
        tell command CatalogContext.CatalogRepository.PersistPriceListCreated(priceListId = priceListCreated.priceListId) to repository CatalogContext.CatalogRepository
        do "apply PriceListCreated to the CatalogViews projection"
      }
      on priceListDeactivated: event PriceList.PriceListDeactivated is {
        tell command CatalogContext.CatalogRepository.PersistPriceListDeactivated(priceListId = priceListDeactivated.priceListId) to repository CatalogContext.CatalogRepository
        do "apply PriceListDeactivated to the CatalogViews projection"
      }
      on productPriceSet: event PriceList.ProductPriceSet is {
        tell command CatalogContext.CatalogRepository.PersistProductPriceSet(priceListId = productPriceSet.priceListId) to repository CatalogContext.CatalogRepository
        do "apply ProductPriceSet to the CatalogViews projection"
      }
      on priceChanged: event Product.PriceChanged is {
        tell command CatalogContext.CatalogRepository.PersistPriceChanged(productId = priceChanged.productId) to repository CatalogContext.CatalogRepository
        do "apply PriceChanged to the CatalogViews projection"
      }
      on productRetired: event Product.ProductRetired is {
        tell command CatalogContext.CatalogRepository.PersistProductRetired(productId = productRetired.productId) to repository CatalogContext.CatalogRepository
        do "apply ProductRetired to the CatalogViews projection"
      }
      on productUpdated: event Product.ProductUpdated is {
        tell command CatalogContext.CatalogRepository.PersistProductUpdated(productId = productUpdated.productId) to repository CatalogContext.CatalogRepository
        do "apply ProductUpdated to the CatalogViews projection"
      }
      on variantAdded: event Product.VariantAdded is {
        tell command CatalogContext.CatalogRepository.PersistVariantAdded(productId = variantAdded.productId) to repository CatalogContext.CatalogRepository
        do "apply VariantAdded to the CatalogViews projection"
      }
      on productCreated: event Product.ProductCreated is {
        tell command CatalogContext.CatalogRepository.PersistProductCreated(productId = productCreated.productId) to repository CatalogContext.CatalogRepository
        do "Create product summary view"
      }
      on productPublished: event Product.ProductPublished is {
        tell command CatalogContext.CatalogRepository.PersistProductPublished(productId = productPublished.productId) to repository CatalogContext.CatalogRepository
        do "Update product summary as active"
      }
      on categoryAssigned: event Product.CategoryAssigned is {
        tell command CatalogContext.CatalogRepository.PersistCategoryAssigned(productId = categoryAssigned.productId) to repository CatalogContext.CatalogRepository
        do "Update product category in summary"
      }
    } with {
      briefly "Maintains catalog views"
      described as {
        |Projects events into optimized read views.
      }
    }
  } with {
    briefly "Catalog view projections"
    described as {
      |Maintains read-optimized views of catalog data.
    }
  }
  // ---- Event publication for Product ----
  type ProductEvent is one of {
    CatalogContext.Product.ProductCreated or CatalogContext.Product.ProductUpdated or CatalogContext.Product.PriceChanged or CatalogContext.Product.VariantAdded or CatalogContext.Product.CategoryAssigned or CatalogContext.Product.ProductPublished or CatalogContext.Product.ProductRetired
  } with {
    briefly "Product event alternation"
    described as {
      |Union of all Product events, for streaming and event-sourced
      |persistence.
    }
  }
  // ---- Event publication for Category ----
  type CategoryEvent is one of {
    CatalogContext.Category.CategoryCreated or CatalogContext.Category.CategoryUpdated or CatalogContext.Category.CategoryMoved or CatalogContext.Category.CategoryActivated or CatalogContext.Category.CategoryDeactivated
  } with {
    briefly "Category event alternation"
    described as {
      |Union of all Category events, for streaming and event-sourced
      |persistence.
    }
  }
  // ---- Event publication for PriceList ----
  type PriceListEvent is one of {
    CatalogContext.PriceList.PriceListCreated or CatalogContext.PriceList.ProductPriceSet or CatalogContext.PriceList.PriceListActivated or CatalogContext.PriceList.PriceListDeactivated
  } with {
    briefly "PriceList event alternation"
    described as {
      |Union of all PriceList events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CategoryEventSplit as flow is {
    inlet CategoryEventSplitIn is type CategoryEvent    outlet CategoryEventSplitToCatalogViews is type CategoryEvent
    handler CategoryEventSplitHandler is {
      on categoryCreated: event Category.CategoryCreated is {
        send categoryCreated to outlet CategoryEventSplitToCatalogViews
        tell categoryCreated to entity CatalogContext.Category
      }
      on categoryUpdated: event Category.CategoryUpdated is {
        send categoryUpdated to outlet CategoryEventSplitToCatalogViews
        tell categoryUpdated to entity CatalogContext.Category
      }
      on categoryMoved: event Category.CategoryMoved is {
        send categoryMoved to outlet CategoryEventSplitToCatalogViews
        tell categoryMoved to entity CatalogContext.Category
      }
      on categoryActivated: event Category.CategoryActivated is {
        send categoryActivated to outlet CategoryEventSplitToCatalogViews
        tell categoryActivated to entity CatalogContext.Category
      }
      on categoryDeactivated: event Category.CategoryDeactivated is {
        send categoryDeactivated to outlet CategoryEventSplitToCatalogViews
        tell categoryDeactivated to entity CatalogContext.Category
      }
      on other is {
        error "Unexpected message for processor CategoryEventSplit"
      }
    } with {
      briefly "Category event fan-out handler"
      described as {
        |Delivers each Category event to all of its consumers.
      }
    }
  } with {
    briefly "Category event fan-out"
    described as {
      |Fans Category events out to the repository and projectors.
    }
  }
  processor PriceListEventSplit as flow is {
    inlet PriceListEventSplitIn is type PriceListEvent    outlet PriceListEventSplitToCatalogViews is type PriceListEvent
    handler PriceListEventSplitHandler is {
      on priceListCreated: event PriceList.PriceListCreated is {
        send priceListCreated to outlet PriceListEventSplitToCatalogViews
        tell priceListCreated to entity CatalogContext.PriceList
      }
      on productPriceSet: event PriceList.ProductPriceSet is {
        send productPriceSet to outlet PriceListEventSplitToCatalogViews
        tell productPriceSet to entity CatalogContext.PriceList
      }
      on priceListActivated: event PriceList.PriceListActivated is {
        send priceListActivated to outlet PriceListEventSplitToCatalogViews
        tell priceListActivated to entity CatalogContext.PriceList
      }
      on priceListDeactivated: event PriceList.PriceListDeactivated is {
        send priceListDeactivated to outlet PriceListEventSplitToCatalogViews
        tell priceListDeactivated to entity CatalogContext.PriceList
      }
      on other is {
        error "Unexpected message for processor PriceListEventSplit"
      }
    } with {
      briefly "PriceList event fan-out handler"
      described as {
        |Delivers each PriceList event to all of its consumers.
      }
    }
  } with {
    briefly "PriceList event fan-out"
    described as {
      |Fans PriceList events out to the repository and projectors.
    }
  }
  processor ProductEventSplit as flow is {
    inlet ProductEventSplitIn is type ProductEvent    outlet ProductEventSplitToCatalogViews is type ProductEvent
    handler ProductEventSplitHandler is {
      on productCreated: event Product.ProductCreated is {
        send productCreated to outlet ProductEventSplitToCatalogViews
        tell productCreated to entity CatalogContext.Product
      }
      on productUpdated: event Product.ProductUpdated is {
        send productUpdated to outlet ProductEventSplitToCatalogViews
        tell productUpdated to entity CatalogContext.Product
      }
      on priceChanged: event Product.PriceChanged is {
        send priceChanged to outlet ProductEventSplitToCatalogViews
        tell priceChanged to entity CatalogContext.Product
      }
      on variantAdded: event Product.VariantAdded is {
        send variantAdded to outlet ProductEventSplitToCatalogViews
        tell variantAdded to entity CatalogContext.Product
      }
      on categoryAssigned: event Product.CategoryAssigned is {
        send categoryAssigned to outlet ProductEventSplitToCatalogViews
        tell categoryAssigned to entity CatalogContext.Product
      }
      on productPublished: event Product.ProductPublished is {
        send productPublished to outlet ProductEventSplitToCatalogViews
        tell productPublished to entity CatalogContext.Product
      }
      on productRetired: event Product.ProductRetired is {
        send productRetired to outlet ProductEventSplitToCatalogViews
        tell productRetired to entity CatalogContext.Product
      }
      on other is {
        error "Unexpected message for processor ProductEventSplit"
      }
    } with {
      briefly "Product event fan-out handler"
      described as {
        |Delivers each Product event to all of its consumers.
      }
    }
  } with {
    briefly "Product event fan-out"
    described as {
      |Fans Product events out to the repository and projectors.
    }
  }
  connector 'CategoryEvent Stream' is from outlet CatalogContext.Category.CategoryEvents2 to inlet CatalogContext.CategoryEventSplit.CategoryEventSplitIn with {
    briefly "Category events, fanned out to storage and read models"
  }
  connector 'CategoryEvent Feed' is from outlet CatalogContext.CategoryEventSplit.CategoryEventSplitToCatalogViews to inlet CatalogContext.CatalogViews.CatalogViewsFromCategory with {
    briefly "CategoryEvent feeding the CatalogViews projection"
  }
  connector 'PriceListEvent Stream' is from outlet CatalogContext.PriceList.PriceListEvents2 to inlet CatalogContext.PriceListEventSplit.PriceListEventSplitIn with {
    briefly "PriceList events, fanned out to storage and read models"
  }
  connector 'PriceListEvent Feed' is from outlet CatalogContext.PriceListEventSplit.PriceListEventSplitToCatalogViews to inlet CatalogContext.CatalogViews.CatalogViewsFromPriceList with {
    briefly "PriceListEvent feeding the CatalogViews projection"
  }
  connector 'ProductEvent Stream' is from outlet CatalogContext.Product.ProductEvents2 to inlet CatalogContext.ProductEventSplit.ProductEventSplitIn with {
    briefly "Product events, fanned out to storage and read models"
  }
  connector 'ProductEvent Feed' is from outlet CatalogContext.ProductEventSplit.ProductEventSplitToCatalogViews to inlet CatalogContext.CatalogViews.CatalogViewsFromProduct with {
    briefly "ProductEvent feeding the CatalogViews projection"
  }
  connector 'CatalogViews Storage' is from outlet CatalogContext.CatalogViews.CatalogViewsToRepository to inlet CatalogContext.CatalogRepository.CatalogRepositoryFromCatalogViews with {
    briefly "CatalogViews updates on their way to storage"
  }
} with {
  briefly "Bounded context for product catalog"
  described as {
    | The CatalogContext is the bounded context for product catalog
    | management. It contains entities for products, categories, and
    | price lists, with integrations to inventory, search, and content
    | management systems.
  }
}
