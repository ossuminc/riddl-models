// Product Catalog - Catalog Context
context CatalogContext is {
  include "types.riddl"
  include "Product.riddl"
  include "Category.riddl"
  include "PriceList.riddl"
  // Adaptors for external system integration
  adaptor InventoryAdapter from context InventoryService is { 
    handler InventoryEvents is {
      on event InventoryService.StockLevelChanged is {
        prompt "Update product availability display"
      }
      on event InventoryService.StockDepleted is {
        prompt "Mark product as out of stock"
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles inventory events"
      described as {
        |Processes inventory updates for availability display.
      }
    }
  } with {
    briefly "Inventory integration"
    described as {
      |Receives stock level updates from the inventory system.
    }
  }
  adaptor SearchAdapter to context SearchEngine is { 
    handler SearchIndexing is {
      on command SearchEngine.IndexProduct is {
        prompt "Index or update product in search engine"
      }
      on command SearchEngine.RemoveProduct is {
        prompt "Remove product from search index"
      }
      on other is {
        error "Unexpected message for adaptor SearchAdapter"
      }
    } with {
      briefly "Handles search indexing"
      described as {
        |Translates product commands for search engine indexing.
      }
    }
  } with {
    briefly "Search engine integration"
    described as {
      |Publishes product changes to the search engine for discovery.
    }
  }
  adaptor ContentAdapter from context ContentManagement is { 
    handler ContentEvents is {
      on event ContentManagement.ImageUploaded is {
        prompt "Associate image with product"
      }
      on event ContentManagement.ImageDeleted is {
        prompt "Remove image reference from product"
      }
      on other is {
        error "Unexpected message for adaptor ContentAdapter"
      }
    } with {
      briefly "Handles content events"
      described as {
        |Processes image and content updates.
      }
    }
  } with {
    briefly "Content management integration"
    described as {
      |Receives image and content updates from the CMS.
    }
  }
  // Repository for catalog persistence
  repository CatalogRepository is {
    schema CatalogData is relational
      of categories as type Category
      of priceLists as type PriceList
      of products as type Product
        link productCategories as field Product.primaryCategory to field Category.categoryId
        index on field Product.sku
        index on field Product.name
        index on field Category.categoryName

    handler CatalogPersistence is {
      on command Product.CreateProduct is {
        tell event Product.ProductCreated to entity CatalogContext.Product
        prompt "Persist new product to database"
      }
      on command Product.UpdateProduct is {
        tell event Product.ProductUpdated to entity CatalogContext.Product
        prompt "Update product in database"
      }
      on command Product.SetPrice is {
        prompt "Update product price in database"
      }
      on command Product.PublishProduct is {
        tell event Product.ProductPublished to entity CatalogContext.Product
        prompt "Update product status to published"
      }
      on command Product.RetireProduct is {
        prompt "Update product status to retired"
      }
      on command Category.CreateCategory is {
        tell event Category.CategoryCreated to entity CatalogContext.Category
        prompt "Persist new category"
      }
      on command Category.UpdateCategory is {
        tell event Category.CategoryUpdated to entity CatalogContext.Category
        prompt "Update category in database"
      }
      on command PriceList.CreatePriceList is {
        tell event PriceList.PriceListCreated to entity CatalogContext.PriceList
        prompt "Persist new price list"
      }
      on command PriceList.SetProductPrice is {
        tell event PriceList.ProductPriceSet to entity CatalogContext.PriceList
        prompt "Update product price in list"
      }
    } with {
      briefly "Persists catalog commands"
      described as {
        |Handles command-driven persistence for catalog data.
      }
    }
  } with {
    briefly "Catalog data persistence"
    described as {
      | The CatalogRepository provides persistent storage for products,
      | categories, and price lists with indexes for efficient queries.
    }
  }
  // Projector for catalog views
  projector CatalogViews is {
    updates repository CatalogContext.CatalogRepository
    record ProductSummary is  {
      productId: ProductId with {
        briefly "ID"
        described as {
          |Product identifier.
        }
      }
      sku: SKU with {
        briefly "SKU"
        described as {
          |Stock keeping unit.
        }
      }
      name: ProductName with {
        briefly "Name"
        described as {
          |Product name.
        }
      }
      basePrice: Money with {
        briefly "Price"
        described as {
          |Base price.
        }
      }
      category: String(1,100) with {
        briefly "Category"
        described as {
          |Primary category name.
        }
      }
      status: ProductStatus with {
        briefly "Status"
        described as {
          |Product status.
        }
      }
      imageUrl: ImageUrl? with {
        briefly "Image"
        described as {
          |Primary image URL.
        }
      }
    } with {
      briefly "Product summary for listings"
      described as {
        |Lightweight product view for catalog listings.
      }
    }
    handler ViewHandler is {
      on event Product.ProductCreated is {
        tell event Product.ProductCreated to repository CatalogContext.CatalogRepository
        prompt "Create product summary view"
      }
      on event Product.ProductPublished is {
        tell event Product.ProductPublished to repository CatalogContext.CatalogRepository
        prompt "Update product summary as active"
      }
      on event Product.CategoryAssigned is {
        tell event Product.CategoryAssigned to repository CatalogContext.CatalogRepository
        prompt "Update product category in summary"
      }
    } with {
      briefly "Maintains catalog views"
      described as {
        |Projects events into optimized read views.
      }
    }
  } with {
    briefly "Catalog view projections"
    described as {
      |Maintains read-optimized views of catalog data.
    }
  }
  // ---- Event publication for Product ----
  type ProductEvent is one of {
    CatalogContext.Product.ProductCreated,
    CatalogContext.Product.ProductUpdated,
    CatalogContext.Product.PriceChanged,
    CatalogContext.Product.VariantAdded,
    CatalogContext.Product.CategoryAssigned,
    CatalogContext.Product.ProductPublished,
    CatalogContext.Product.ProductRetired
  } with {
    briefly "Product event alternation"
    described as {
      |Union of all Product events, for streaming and event-sourced
      |persistence.
    }
  }
  source ProductEventSource is {
    outlet ProductEvents is type ProductEvent
    handler ProductSourceHandler is {
      on event Product.ProductCreated is {
        send event Product.ProductCreated to outlet ProductEvents
      }
      on event Product.ProductUpdated is {
        send event Product.ProductUpdated to outlet ProductEvents
      }
      on event Product.PriceChanged is {
        send event Product.PriceChanged to outlet ProductEvents
      }
      on event Product.VariantAdded is {
        send event Product.VariantAdded to outlet ProductEvents
      }
      on event Product.CategoryAssigned is {
        send event Product.CategoryAssigned to outlet ProductEvents
      }
      on event Product.ProductPublished is {
        send event Product.ProductPublished to outlet ProductEvents
      }
      on event Product.ProductRetired is {
        send event Product.ProductRetired to outlet ProductEvents
      }
      on other is {
        error "Unexpected message for source ProductEventSource"
      }
    } with {
      briefly "Product source handler"
      described as {
        |Publishes Product events onto the outlet.
      }
    }
  } with {
    briefly "Product event source"
    described as {
      |Publishes Product entity events into the streaming topology.
    }
  }
  sink ProductEventSink is {
    inlet ProductInlet is type ProductEvent
    handler ProductSinkHandler is {
      on event Product.ProductCreated is {
        tell event Product.ProductCreated to repository CatalogContext.CatalogRepository
      }
      on event Product.ProductUpdated is {
        tell event Product.ProductUpdated to repository CatalogContext.CatalogRepository
      }
      on event Product.PriceChanged is {
        tell event Product.PriceChanged to repository CatalogContext.CatalogRepository
      }
      on event Product.VariantAdded is {
        tell event Product.VariantAdded to repository CatalogContext.CatalogRepository
      }
      on event Product.CategoryAssigned is {
        tell event Product.CategoryAssigned to repository CatalogContext.CatalogRepository
      }
      on event Product.ProductPublished is {
        tell event Product.ProductPublished to repository CatalogContext.CatalogRepository
      }
      on event Product.ProductRetired is {
        tell event Product.ProductRetired to repository CatalogContext.CatalogRepository
      }
      on other is {
        error "Unexpected message for sink ProductEventSink"
      }
    } with {
      briefly "Product sink handler"
      described as {
        |Persists Product events via the repository.
      }
    }
  } with {
    briefly "Product event sink"
    described as {
      |Receives Product events for persistence.
    }
  }
  connector ProductEventFlow is {
    from outlet CatalogContext.ProductEventSource.ProductEvents to
      inlet CatalogContext.ProductEventSink.ProductInlet
  } with {
    briefly "Product event flow"
    described as {
      |Connects the Product source to its sink.
    }
  }
  // ---- Event publication for Category ----
  type CategoryEvent is one of {
    CatalogContext.Category.CategoryCreated,
    CatalogContext.Category.CategoryUpdated,
    CatalogContext.Category.CategoryMoved,
    CatalogContext.Category.CategoryActivated,
    CatalogContext.Category.CategoryDeactivated
  } with {
    briefly "Category event alternation"
    described as {
      |Union of all Category events, for streaming and event-sourced
      |persistence.
    }
  }
  source CategoryEventSource is {
    outlet CategoryEvents is type CategoryEvent
    handler CategorySourceHandler is {
      on event Category.CategoryCreated is {
        send event Category.CategoryCreated to outlet CategoryEvents
      }
      on event Category.CategoryUpdated is {
        send event Category.CategoryUpdated to outlet CategoryEvents
      }
      on event Category.CategoryMoved is {
        send event Category.CategoryMoved to outlet CategoryEvents
      }
      on event Category.CategoryActivated is {
        send event Category.CategoryActivated to outlet CategoryEvents
      }
      on event Category.CategoryDeactivated is {
        send event Category.CategoryDeactivated to outlet CategoryEvents
      }
      on other is {
        error "Unexpected message for source CategoryEventSource"
      }
    } with {
      briefly "Category source handler"
      described as {
        |Publishes Category events onto the outlet.
      }
    }
  } with {
    briefly "Category event source"
    described as {
      |Publishes Category entity events into the streaming topology.
    }
  }
  sink CategoryEventSink is {
    inlet CategoryInlet is type CategoryEvent
    handler CategorySinkHandler is {
      on event Category.CategoryCreated is {
        tell event Category.CategoryCreated to repository CatalogContext.CatalogRepository
      }
      on event Category.CategoryUpdated is {
        tell event Category.CategoryUpdated to repository CatalogContext.CatalogRepository
      }
      on event Category.CategoryMoved is {
        tell event Category.CategoryMoved to repository CatalogContext.CatalogRepository
      }
      on event Category.CategoryActivated is {
        tell event Category.CategoryActivated to repository CatalogContext.CatalogRepository
      }
      on event Category.CategoryDeactivated is {
        tell event Category.CategoryDeactivated to repository CatalogContext.CatalogRepository
      }
      on other is {
        error "Unexpected message for sink CategoryEventSink"
      }
    } with {
      briefly "Category sink handler"
      described as {
        |Persists Category events via the repository.
      }
    }
  } with {
    briefly "Category event sink"
    described as {
      |Receives Category events for persistence.
    }
  }
  connector CategoryEventFlow is {
    from outlet CatalogContext.CategoryEventSource.CategoryEvents to
      inlet CatalogContext.CategoryEventSink.CategoryInlet
  } with {
    briefly "Category event flow"
    described as {
      |Connects the Category source to its sink.
    }
  }
  // ---- Event publication for PriceList ----
  type PriceListEvent is one of {
    CatalogContext.PriceList.PriceListCreated,
    CatalogContext.PriceList.ProductPriceSet,
    CatalogContext.PriceList.PriceListActivated,
    CatalogContext.PriceList.PriceListDeactivated
  } with {
    briefly "PriceList event alternation"
    described as {
      |Union of all PriceList events, for streaming and event-sourced
      |persistence.
    }
  }
  source PriceListEventSource is {
    outlet PriceListEvents is type PriceListEvent
    handler PriceListSourceHandler is {
      on event PriceList.PriceListCreated is {
        send event PriceList.PriceListCreated to outlet PriceListEvents
      }
      on event PriceList.ProductPriceSet is {
        send event PriceList.ProductPriceSet to outlet PriceListEvents
      }
      on event PriceList.PriceListActivated is {
        send event PriceList.PriceListActivated to outlet PriceListEvents
      }
      on event PriceList.PriceListDeactivated is {
        send event PriceList.PriceListDeactivated to outlet PriceListEvents
      }
      on other is {
        error "Unexpected message for source PriceListEventSource"
      }
    } with {
      briefly "PriceList source handler"
      described as {
        |Publishes PriceList events onto the outlet.
      }
    }
  } with {
    briefly "PriceList event source"
    described as {
      |Publishes PriceList entity events into the streaming topology.
    }
  }
  sink PriceListEventSink is {
    inlet PriceListInlet is type PriceListEvent
    handler PriceListSinkHandler is {
      on event PriceList.PriceListCreated is {
        tell event PriceList.PriceListCreated to repository CatalogContext.CatalogRepository
      }
      on event PriceList.ProductPriceSet is {
        tell event PriceList.ProductPriceSet to repository CatalogContext.CatalogRepository
      }
      on event PriceList.PriceListActivated is {
        tell event PriceList.PriceListActivated to repository CatalogContext.CatalogRepository
      }
      on event PriceList.PriceListDeactivated is {
        tell event PriceList.PriceListDeactivated to repository CatalogContext.CatalogRepository
      }
      on other is {
        error "Unexpected message for sink PriceListEventSink"
      }
    } with {
      briefly "PriceList sink handler"
      described as {
        |Persists PriceList events via the repository.
      }
    }
  } with {
    briefly "PriceList event sink"
    described as {
      |Receives PriceList events for persistence.
    }
  }
  connector PriceListEventFlow is {
    from outlet CatalogContext.PriceListEventSource.PriceListEvents to
      inlet CatalogContext.PriceListEventSink.PriceListInlet
  } with {
    briefly "PriceList event flow"
    described as {
      |Connects the PriceList source to its sink.
    }
  }
} with {
  briefly "Bounded context for product catalog"
  described as {
    | The CatalogContext is the bounded context for product catalog
    | management. It contains entities for products, categories, and
    | price lists, with integrations to inventory, search, and content
    | management systems.
  }
}
