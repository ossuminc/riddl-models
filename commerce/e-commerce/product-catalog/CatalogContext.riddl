    }
    command PersistPriceChanged is {
      productId: ProductId with {
        briefly "Row addressed"
        described as {
          |Which stored row PriceChanged applies to.
        }
      }
      oldPrice: Money? with {
        briefly "Old price"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newPrice: Money? with {
        briefly "New price"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      changedAt: TimeStamp? with {
        briefly "Changed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PriceChanged"
      described as {
        |Instructs this repository to apply PriceChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProductRetired is {
      productId: ProductId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProductRetired applies to.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      retiredAt: TimeStamp? with {
        briefly "Retired at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ProductRetired"
      described as {
        |Instructs this repository to apply ProductRetired to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProductUpdated is {
      productId: ProductId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProductUpdated applies to.
        }
      }
      updatedName: ProductName? with {
        briefly "Updated name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedDescription: ProductDescription? with {
        briefly "Updated description"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
