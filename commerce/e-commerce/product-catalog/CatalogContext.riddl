        }
      }
      movedAt: TimeStamp? with {
        briefly "Moved at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedCategoryName: String(1,100)? with {
        briefly "Updated category name"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored category row"
      described as {
        |The persistence shape of category data as this repository stores it.
      }
    }
    record StoredPriceList is {
      priceListId: PriceListId with {
        briefly "priceListId"
        described as {
          |The priceListId column of the stored priceList row.
        }
      }
      activatedAt: TimeStamp? with {
        briefly "Activated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      listName: String(1,100)? with {
        briefly "List name"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      currency: Currency(USD)? with {
        briefly "Currency"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      listDescription: String(1,500)? with {
        briefly "List description"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      priority: Natural? with {
        briefly "Priority"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      deactivatedAt: TimeStamp? with {
        briefly "Deactivated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      productId: ProductId? with {
        briefly "Product id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      price: Money? with {
        briefly "Price"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      setAt: TimeStamp? with {
        briefly "Set at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored priceList row"
      described as {
        |The persistence shape of priceList data as this repository stores it.
      }
    }
    record StoredProduct is {
      productId: ProductId with {
        briefly "productId"
        described as {
          |The productId column of the stored product row.
        }
      }
      name: ProductName with {
        briefly "name"
        described as {
          |The name column of the stored product row.
        }
      }
      primaryCategory: CategoryId? with {
        briefly "primaryCategory"
        described as {
          |The primaryCategory column of the stored product row.
        }
      }
      sku: SKU with {
        briefly "sku"
        described as {
          |The sku column of the stored product row.
        }
      }
      oldPrice: Money? with {
        briefly "Old price"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newPrice: Money? with {
        briefly "New price"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      changedAt: TimeStamp? with {
        briefly "Changed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      retiredAt: TimeStamp? with {
        briefly "Retired at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedName: ProductName? with {
        briefly "Updated name"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedDescription: ProductDescription? with {
        briefly "Updated description"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      variant: ProductVariant? with {
        briefly "Variant"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      categoryId: CategoryId? with {
        briefly "Category id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      isPrimary: Boolean? with {
        briefly "Is primary"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      assignedAt: TimeStamp? with {
        briefly "Assigned at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      description: ProductDescription? with {
        briefly "Description"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      basePrice: Money? with {
        briefly "Base price"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      attributes: AttributeValue+ with {
        briefly "Attributes"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      images: ImageUrl+ with {
        briefly "Images"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      publishedAt: TimeStamp? with {
        briefly "Published at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored product row"
      described as {
        |The persistence shape of product data as this repository stores it.
      }
    }
    schema CatalogData is relational
      of categories as record StoredCategory
      of priceLists as record StoredPriceList
      of products as record StoredProduct
        link productCategories as field StoredProduct.primaryCategory to field StoredCategory.categoryId
        key on field StoredCategory.categoryId
        key on field StoredPriceList.priceListId
        key on field StoredProduct.productId
        index on field StoredProduct.sku
        index on field StoredProduct.name
        index on field StoredCategory.categoryName
 with {
      briefly "Catalog data schema"
      described as {
        |The relational schema holding catalog data for the CatalogRepository.
      }
    }
    handler CatalogPersistence is {
      on persistCategoryActivated: command PersistCategoryActivated is {
        update CatalogData.categories set activatedAt = persistCategoryActivated.activatedAt where categoryId == persistCategoryActivated.categoryId
      }
      on persistCategoryCreated: command PersistCategoryCreated is {
        update CatalogData.categories set categoryName = persistCategoryCreated.categoryName, parentId = persistCategoryCreated.parentId, createdAt = persistCategoryCreated.createdAt, categoryDescription = persistCategoryCreated.categoryDescription, displayOrder = persistCategoryCreated.displayOrder where categoryId == persistCategoryCreated.categoryId
      }
      on persistCategoryDeactivated: command PersistCategoryDeactivated is {
        update CatalogData.categories set deactivatedAt = persistCategoryDeactivated.deactivatedAt where categoryId == persistCategoryDeactivated.categoryId
      }
      on persistCategoryMoved: command PersistCategoryMoved is {
        update CatalogData.categories set oldParentId = persistCategoryMoved.oldParentId, newParentId = persistCategoryMoved.newParentId, movedAt = persistCategoryMoved.movedAt where categoryId == persistCategoryMoved.categoryId
      }
      on persistCategoryUpdated: command PersistCategoryUpdated is {
        update CatalogData.categories set updatedCategoryName = persistCategoryUpdated.updatedCategoryName, updatedAt = persistCategoryUpdated.updatedAt where categoryId == persistCategoryUpdated.categoryId
      }
      on persistPriceListActivated: command PersistPriceListActivated is {
        update CatalogData.priceLists set activatedAt = persistPriceListActivated.activatedAt where priceListId == persistPriceListActivated.priceListId
      }
      on persistPriceListCreated: command PersistPriceListCreated is {
        update CatalogData.priceLists set listName = persistPriceListCreated.listName, currency = persistPriceListCreated.currency, createdAt = persistPriceListCreated.createdAt, listDescription = persistPriceListCreated.listDescription, priority = persistPriceListCreated.priority where priceListId == persistPriceListCreated.priceListId
      }
      on persistPriceListDeactivated: command PersistPriceListDeactivated is {
        update CatalogData.priceLists set deactivatedAt = persistPriceListDeactivated.deactivatedAt where priceListId == persistPriceListDeactivated.priceListId
      }
      on persistProductPriceSet: command PersistProductPriceSet is {
        update CatalogData.priceLists set productId = persistProductPriceSet.productId, price = persistProductPriceSet.price, setAt = persistProductPriceSet.setAt where priceListId == persistProductPriceSet.priceListId
      }
      on persistPriceChanged: command PersistPriceChanged is {
        update CatalogData.products set oldPrice = persistPriceChanged.oldPrice, newPrice = persistPriceChanged.newPrice, changedAt = persistPriceChanged.changedAt where productId == persistPriceChanged.productId
      }
      on persistProductRetired: command PersistProductRetired is {
        update CatalogData.products set reason = persistProductRetired.reason, retiredAt = persistProductRetired.retiredAt where productId == persistProductRetired.productId
      }
      on persistProductUpdated: command PersistProductUpdated is {
        update CatalogData.products set updatedName = persistProductUpdated.updatedName, updatedDescription = persistProductUpdated.updatedDescription, updatedAt = persistProductUpdated.updatedAt where productId == persistProductUpdated.productId
      }
      on persistVariantAdded: command PersistVariantAdded is {
        update CatalogData.products set variant = persistVariantAdded.variant, addedAt = persistVariantAdded.addedAt where productId == persistVariantAdded.productId
      }
      on persistCategoryAssigned: command PersistCategoryAssigned is {
        update CatalogData.products set categoryId = persistCategoryAssigned.categoryId, isPrimary = persistCategoryAssigned.isPrimary, assignedAt = persistCategoryAssigned.assignedAt where productId == persistCategoryAssigned.productId
      }
      on persistProductCreated: command PersistProductCreated is {
        update CatalogData.products set sku = persistProductCreated.sku, name = persistProductCreated.name, description = persistProductCreated.description, basePrice = persistProductCreated.basePrice, createdAt = persistProductCreated.createdAt, attributes = persistProductCreated.attributes, images = persistProductCreated.images where productId == persistProductCreated.productId
      }
      on persistProductPublished: command PersistProductPublished is {
        update CatalogData.products set publishedAt = persistProductPublished.publishedAt where productId == persistProductPublished.productId
      }
      on query GetProductSummary is {
        let productSummaryView: type ProductSummaryView = prompt("read the product summary projection")
        reply productSummaryView
      }
    } with {
      briefly "Persists catalog commands"
      described as {
        |Handles command-driven persistence for catalog data.
      }
    }
  } with {
    briefly "Catalog data persistence"
    described as {
      | The CatalogRepository provides persistent storage for products,
      | categories, and price lists with indexes for efficient queries.
    }
  }
  // Projector for catalog views
  query GetProductSummary replies result ProductSummaryView is {
    productSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which product summary to retrieve.
      }
    }
  } with {
    briefly "Get product summary"
    described as {
      |Retrieves the product summary projection.
    }
  }
  result ProductSummaryView is {
    productSummary: CatalogViews.ProductSummary with {
      briefly "Product summary"
      described as {
        |The product summary being returned.
      }
    }
  } with {
    briefly "Product summary view"
    described as {
      |Read model view carrying the product summary projection.
    }
  }
  projector CatalogViews as merge is {
    updates repository CatalogContext.CatalogRepository
    outlet CatalogViewsToRepository is type CatalogRepositoryCommand
    inlet CatalogViewsFromCategory is type CategoryEvent    inlet CatalogViewsFromPriceList is type PriceListEvent    inlet CatalogViewsFromProduct is type ProductEvent    record ProductSummary is {
      productId: ProductId with {
        briefly "ID"
        described as {
          |Product identifier.
        }
      }
      sku: SKU with {
        briefly "SKU"
        described as {
          |Stock keeping unit.
        }
      }
      name: ProductName with {
        briefly "Name"
        described as {
          |Product name.
        }
      }
      basePrice: Money with {
        briefly "Price"
        described as {
          |Base price.
        }
      }
      category: String(1,100) with {
        briefly "Category"
        described as {
          |Primary category name.
        }
      }
      status: ProductStatus with {
        briefly "Status"
        described as {
          |Product status.
        }
      }
      imageUrl: ImageUrl? with {
        briefly "Image"
        described as {
          |Primary image URL.
        }
      }
    } with {
      briefly "Product summary for listings"
      described as {
        |Lightweight product view for catalog listings.
      }
    }
    handler ViewHandler is {
      on categoryActivated: event Category.CategoryActivated is {
        tell command CatalogContext.CatalogRepository.PersistCategoryActivated(categoryId = categoryActivated.categoryId, activatedAt = categoryActivated.activatedAt) to repository CatalogContext.CatalogRepository
        do "apply CategoryActivated to the CatalogViews projection"
      }
      on categoryCreated: event Category.CategoryCreated is {
        tell command CatalogContext.CatalogRepository.PersistCategoryCreated(categoryId = categoryCreated.categoryId, categoryName = categoryCreated.categoryName, parentId = categoryCreated.parentId, createdAt = categoryCreated.createdAt, categoryDescription = categoryCreated.categoryDescription, displayOrder = categoryCreated.displayOrder) to repository CatalogContext.CatalogRepository
        do "apply CategoryCreated to the CatalogViews projection"
      }
      on categoryDeactivated: event Category.CategoryDeactivated is {
        tell command CatalogContext.CatalogRepository.PersistCategoryDeactivated(categoryId = categoryDeactivated.categoryId, deactivatedAt = categoryDeactivated.deactivatedAt) to repository CatalogContext.CatalogRepository
        do "apply CategoryDeactivated to the CatalogViews projection"
      }
      on categoryMoved: event Category.CategoryMoved is {
        tell command CatalogContext.CatalogRepository.PersistCategoryMoved(categoryId = categoryMoved.categoryId, oldParentId = categoryMoved.oldParentId, newParentId = categoryMoved.newParentId, movedAt = categoryMoved.movedAt) to repository CatalogContext.CatalogRepository
        do "apply CategoryMoved to the CatalogViews projection"
      }
      on categoryUpdated: event Category.CategoryUpdated is {
        tell command CatalogContext.CatalogRepository.PersistCategoryUpdated(categoryId = categoryUpdated.categoryId, updatedCategoryName = categoryUpdated.updatedCategoryName, updatedAt = categoryUpdated.updatedAt) to repository CatalogContext.CatalogRepository
        do "apply CategoryUpdated to the CatalogViews projection"
      }
      on priceListActivated: event PriceList.PriceListActivated is {
        tell command CatalogContext.CatalogRepository.PersistPriceListActivated(priceListId = priceListActivated.priceListId, activatedAt = priceListActivated.activatedAt) to repository CatalogContext.CatalogRepository
        do "apply PriceListActivated to the CatalogViews projection"
      }
      on priceListCreated: event PriceList.PriceListCreated is {
        tell command CatalogContext.CatalogRepository.PersistPriceListCreated(priceListId = priceListCreated.priceListId, listName = priceListCreated.listName, currency = priceListCreated.currency, createdAt = priceListCreated.createdAt, listDescription = priceListCreated.listDescription, priority = priceListCreated.priority) to repository CatalogContext.CatalogRepository
        do "apply PriceListCreated to the CatalogViews projection"
      }
      on priceListDeactivated: event PriceList.PriceListDeactivated is {
        tell command CatalogContext.CatalogRepository.PersistPriceListDeactivated(priceListId = priceListDeactivated.priceListId, deactivatedAt = priceListDeactivated.deactivatedAt) to repository CatalogContext.CatalogRepository
        do "apply PriceListDeactivated to the CatalogViews projection"
      }
      on productPriceSet: event PriceList.ProductPriceSet is {
        tell command CatalogContext.CatalogRepository.PersistProductPriceSet(priceListId = productPriceSet.priceListId, productId = productPriceSet.productId, price = productPriceSet.price, setAt = productPriceSet.setAt) to repository CatalogContext.CatalogRepository
        do "apply ProductPriceSet to the CatalogViews projection"
      }
      on priceChanged: event Product.PriceChanged is {
        tell command CatalogContext.CatalogRepository.PersistPriceChanged(productId = priceChanged.productId, oldPrice = priceChanged.oldPrice, newPrice = priceChanged.newPrice, changedAt = priceChanged.changedAt) to repository CatalogContext.CatalogRepository
        do "apply PriceChanged to the CatalogViews projection"
      }
      on productRetired: event Product.ProductRetired is {
        tell command CatalogContext.CatalogRepository.PersistProductRetired(productId = productRetired.productId, reason = productRetired.reason, retiredAt = productRetired.retiredAt) to repository CatalogContext.CatalogRepository
        do "apply ProductRetired to the CatalogViews projection"
      }
      on productUpdated: event Product.ProductUpdated is {
        tell command CatalogContext.CatalogRepository.PersistProductUpdated(productId = productUpdated.productId, updatedName = productUpdated.updatedName, updatedDescription = productUpdated.updatedDescription, updatedAt = productUpdated.updatedAt) to repository CatalogContext.CatalogRepository
        do "apply ProductUpdated to the CatalogViews projection"
      }
      on variantAdded: event Product.VariantAdded is {
        tell command CatalogContext.CatalogRepository.PersistVariantAdded(productId = variantAdded.productId, variant = variantAdded.variant, addedAt = variantAdded.addedAt) to repository CatalogContext.CatalogRepository
        do "apply VariantAdded to the CatalogViews projection"
      }
      on productCreated: event Product.ProductCreated is {
        tell command CatalogContext.CatalogRepository.PersistProductCreated(productId = productCreated.productId, sku = productCreated.sku, name = productCreated.name, description = productCreated.description, basePrice = productCreated.basePrice, createdAt = productCreated.createdAt, attributes = productCreated.attributes, images = productCreated.images) to repository CatalogContext.CatalogRepository
        do "Create product summary view"
      }
      on productPublished: event Product.ProductPublished is {
        tell command CatalogContext.CatalogRepository.PersistProductPublished(productId = productPublished.productId, publishedAt = productPublished.publishedAt) to repository CatalogContext.CatalogRepository
        do "Update product summary as active"
      }
      on categoryAssigned: event Product.CategoryAssigned is {
        tell command CatalogContext.CatalogRepository.PersistCategoryAssigned(productId = categoryAssigned.productId, categoryId = categoryAssigned.categoryId, isPrimary = categoryAssigned.isPrimary, assignedAt = categoryAssigned.assignedAt) to repository CatalogContext.CatalogRepository
        do "Update product category in summary"
      }
    } with {
      briefly "Maintains catalog views"
      described as {
        |Projects events into optimized read views.
      }
    }
  } with {
    briefly "Catalog view projections"
    described as {
      |Maintains read-optimized views of catalog data.
    }
  }
  // ---- Event publication for Product ----
  type ProductEvent is one of {
    CatalogContext.Product.ProductCreated or CatalogContext.Product.ProductUpdated or CatalogContext.Product.PriceChanged or CatalogContext.Product.VariantAdded or CatalogContext.Product.CategoryAssigned or CatalogContext.Product.ProductPublished or CatalogContext.Product.ProductRetired
  } with {
    briefly "Product event alternation"
    described as {
      |Union of all Product events, for streaming and event-sourced
      |persistence.
    }
  }
  // ---- Event publication for Category ----
  type CategoryEvent is one of {
    CatalogContext.Category.CategoryCreated or CatalogContext.Category.CategoryUpdated or CatalogContext.Category.CategoryMoved or CatalogContext.Category.CategoryActivated or CatalogContext.Category.CategoryDeactivated
  } with {
    briefly "Category event alternation"
    described as {
      |Union of all Category events, for streaming and event-sourced
      |persistence.
    }
  }
  // ---- Event publication for PriceList ----
  type PriceListEvent is one of {
    CatalogContext.PriceList.PriceListCreated or CatalogContext.PriceList.ProductPriceSet or CatalogContext.PriceList.PriceListActivated or CatalogContext.PriceList.PriceListDeactivated
  } with {
    briefly "PriceList event alternation"
    described as {
      |Union of all PriceList events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet CategoryEventSplit as flow is {
    inlet CategoryEventSplitIn is type CategoryEvent    outlet CategoryEventSplitToCatalogViews is type CategoryEvent
    handler CategoryEventSplitHandler is {
      on categoryCreated: event Category.CategoryCreated is {
        send categoryCreated to outlet CategoryEventSplitToCatalogViews
        tell categoryCreated to entity CatalogContext.Category
      }
      on categoryUpdated: event Category.CategoryUpdated is {
        send categoryUpdated to outlet CategoryEventSplitToCatalogViews
        tell categoryUpdated to entity CatalogContext.Category
      }
      on categoryMoved: event Category.CategoryMoved is {
        send categoryMoved to outlet CategoryEventSplitToCatalogViews
        tell categoryMoved to entity CatalogContext.Category
      }
      on categoryActivated: event Category.CategoryActivated is {
        send categoryActivated to outlet CategoryEventSplitToCatalogViews
        tell categoryActivated to entity CatalogContext.Category
      }
      on categoryDeactivated: event Category.CategoryDeactivated is {
        send categoryDeactivated to outlet CategoryEventSplitToCatalogViews
        tell categoryDeactivated to entity CatalogContext.Category
      }
      on other is {
        error "Unexpected message for processor CategoryEventSplit"
      }
    } with {
      briefly "Category event fan-out handler"
      described as {
        |Delivers each Category event to all of its consumers.
      }
    }
  } with {
    briefly "Category event fan-out"
    described as {
      |Fans Category events out to the repository and projectors.
    }
  }
  streamlet PriceListEventSplit as flow is {
    inlet PriceListEventSplitIn is type PriceListEvent    outlet PriceListEventSplitToCatalogViews is type PriceListEvent
    handler PriceListEventSplitHandler is {
      on priceListCreated: event PriceList.PriceListCreated is {
        send priceListCreated to outlet PriceListEventSplitToCatalogViews
        tell priceListCreated to entity CatalogContext.PriceList
      }
      on productPriceSet: event PriceList.ProductPriceSet is {
        send productPriceSet to outlet PriceListEventSplitToCatalogViews
        tell productPriceSet to entity CatalogContext.PriceList
      }
      on priceListActivated: event PriceList.PriceListActivated is {
        send priceListActivated to outlet PriceListEventSplitToCatalogViews
        tell priceListActivated to entity CatalogContext.PriceList
      }
      on priceListDeactivated: event PriceList.PriceListDeactivated is {
        send priceListDeactivated to outlet PriceListEventSplitToCatalogViews
        tell priceListDeactivated to entity CatalogContext.PriceList
      }
      on other is {
        error "Unexpected message for processor PriceListEventSplit"
      }
    } with {
      briefly "PriceList event fan-out handler"
      described as {
        |Delivers each PriceList event to all of its consumers.
      }
    }
  } with {
    briefly "PriceList event fan-out"
    described as {
      |Fans PriceList events out to the repository and projectors.
    }
  }
  streamlet ProductEventSplit as split is {
    outlet ProductEventSplitToSearchAdapter is type ProductEvent
    inlet ProductEventSplitIn is type ProductEvent    outlet ProductEventSplitToCatalogViews is type ProductEvent
    handler ProductEventSplitHandler is {
      on productCreated: event Product.ProductCreated is {
        send productCreated to outlet ProductEventSplitToCatalogViews
        tell productCreated to entity CatalogContext.Product
      }
      on productUpdated: event Product.ProductUpdated is {
        send productUpdated to outlet ProductEventSplitToCatalogViews
        tell productUpdated to entity CatalogContext.Product
      }
      on priceChanged: event Product.PriceChanged is {
        send priceChanged to outlet ProductEventSplitToCatalogViews
        tell priceChanged to entity CatalogContext.Product
      }
      on variantAdded: event Product.VariantAdded is {
        send variantAdded to outlet ProductEventSplitToCatalogViews
        tell variantAdded to entity CatalogContext.Product
      }
      on categoryAssigned: event Product.CategoryAssigned is {
        send categoryAssigned to outlet ProductEventSplitToCatalogViews
        tell categoryAssigned to entity CatalogContext.Product
      }
      on productPublished: event Product.ProductPublished is {
        send productPublished to outlet ProductEventSplitToCatalogViews
        send productPublished to outlet ProductEventSplitToSearchAdapter
        tell productPublished to entity CatalogContext.Product
      }
      on productRetired: event Product.ProductRetired is {
        send productRetired to outlet ProductEventSplitToCatalogViews
        send productRetired to outlet ProductEventSplitToSearchAdapter
        tell productRetired to entity CatalogContext.Product
      }
      on other is {
        error "Unexpected message for processor ProductEventSplit"
      }
    } with {
      briefly "Product event fan-out handler"
      described as {
        |Delivers each Product event to all of its consumers.
      }
    }
  } with {
    briefly "Product event fan-out"
    described as {
      |Fans Product events out to the repository and projectors.
    }
  }
  connector 'CategoryEvent Stream' is from outlet CatalogContext.Category.CategoryEvents2 to inlet CatalogContext.CategoryEventSplit.CategoryEventSplitIn with {
    briefly "Category events, fanned out to storage and read models"
  }
  connector 'CategoryEvent Feed' is from outlet CatalogContext.CategoryEventSplit.CategoryEventSplitToCatalogViews to inlet CatalogContext.CatalogViews.CatalogViewsFromCategory with {
    briefly "CategoryEvent feeding the CatalogViews projection"
  }
  connector 'PriceListEvent Stream' is from outlet CatalogContext.PriceList.PriceListEvents2 to inlet CatalogContext.PriceListEventSplit.PriceListEventSplitIn with {
    briefly "PriceList events, fanned out to storage and read models"
  }
  connector 'PriceListEvent Feed' is from outlet CatalogContext.PriceListEventSplit.PriceListEventSplitToCatalogViews to inlet CatalogContext.CatalogViews.CatalogViewsFromPriceList with {
    briefly "PriceListEvent feeding the CatalogViews projection"
  }
  connector 'SearchAdapter Feed' is from outlet CatalogContext.ProductEventSplit.ProductEventSplitToSearchAdapter to inlet CatalogContext.SearchAdapter.SearchAdapterIn with {
    briefly "The Product events SearchAdapter translates, on their way to it"
  }
  connector 'ProductEvent Stream' is from outlet CatalogContext.Product.ProductEvents2 to inlet CatalogContext.ProductEventSplit.ProductEventSplitIn with {
    briefly "Product events, fanned out to storage and read models"
  }
  connector 'ProductEvent Feed' is from outlet CatalogContext.ProductEventSplit.ProductEventSplitToCatalogViews to inlet CatalogContext.CatalogViews.CatalogViewsFromProduct with {
    briefly "ProductEvent feeding the CatalogViews projection"
  }
  connector 'CatalogViews Storage' is from outlet CatalogContext.CatalogViews.CatalogViewsToRepository to inlet CatalogContext.CatalogRepository.CatalogRepositoryFromCatalogViews with {
    briefly "CatalogViews updates on their way to storage"
  }
} with {
  briefly "Bounded context for product catalog"
  described as {
    | The CatalogContext is the bounded context for product catalog
    | management. It contains entities for products, categories, and
    | price lists, with integrations to inventory, search, and content
    | management systems.
  }
}
