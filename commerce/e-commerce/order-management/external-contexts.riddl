// Order Management - External Contexts
// These represent external systems that Order Management integrates with
external context PaymentGateway is {
  type PaymentAmount is Decimal(10,2) with {
    briefly "Payment amount in dollars"
  }
  command ProcessPayment yields event PaymentSucceeded is {
    orderId: OrderId
    paymentAmount: PaymentAmount
    paymentMethod: PaymentMethod
    customerId: CustomerId
  } with {
    briefly "Process a payment transaction"
  }
  command RefundPayment yields event RefundCompleted is {
    transactionId: String(1,100)
    paymentRefundAmount: PaymentAmount
    reason: String(1,500)
  } with {
    briefly "Refund a previous payment"
  }
  event PaymentSucceeded is {
    transactionId: String(1,100)
    orderId: OrderId
    paymentAmount: PaymentAmount
    processedAt: TimeStamp
  } with {
    briefly "Payment was successfully processed"
  }
  event PaymentFailed is {
    orderId: OrderId
    reason: String(1,500)
    failedAt: TimeStamp
  } with {
    briefly "Payment processing failed"
  }
  event RefundCompleted is {
    transactionId: String(1,100)
    paymentRefundAmount: PaymentAmount
    refundedAt: TimeStamp
  } with {
    briefly "Refund was processed"
  }
  handler PaymentHandler is {
    on processPayment: command ProcessPayment is {
      yield event PaymentSucceeded(orderId = processPayment.orderId, paymentAmount = processPayment.paymentAmount, transactionId = prompt("the transaction id of this payment succeeded"), processedAt = prompt("the processed at of this payment succeeded"))
    }
    on refundPayment: command RefundPayment is {
      yield event RefundCompleted(transactionId = refundPayment.transactionId, paymentRefundAmount = refundPayment.paymentRefundAmount, refundedAt = prompt("the refunded at of this refund completed"))
    }
  } with {
    briefly "Handles payment commands"
  }
} with {
  briefly "External payment processing service"
  described as {
    | The PaymentGateway context represents an external payment
    | processor (e.g., Stripe, Square, PayPal) that handles
    | credit card processing, refunds, and payment validation.
  }
}
external context InventoryService is {
  command AllocateStock yields event StockAllocated is {
    orderId: OrderId
    stockItems: {
      productId: ProductId with {
        briefly "Product id"
        described as {
          |The product id carried by this message.
        }
      }
      sku: SKU with {
        briefly "Sku"
        described as {
          |The sku carried by this message.
        }
      }
      quantity: Quantity with {
        briefly "Quantity"
        described as {
          |The quantity carried by this message.
        }
      }
    }
+
  } with {
    briefly "Reserve inventory for an order"
  }
  command ReleaseStock yields event StockReleased is {
    orderId: OrderId
    stockItems: {
      productId: ProductId with {
        briefly "Product id"
        described as {
          |The product id carried by this message.
        }
      }
      sku: SKU with {
        briefly "Sku"
        described as {
          |The sku carried by this message.
        }
      }
      quantity: Quantity with {
        briefly "Quantity"
        described as {
          |The quantity carried by this message.
        }
      }
    }
+
  } with {
    briefly "Release previously reserved inventory"
  }
  event StockAllocated is {
    orderId: OrderId
    allItemsAllocated: Boolean
    allocatedAt: TimeStamp
  } with {
    briefly "Inventory was allocated"
  }
  event StockAllocationFailed is {
    orderId: OrderId
    unavailableItems: {
      productId: ProductId with {
        briefly "Product id"
        described as {
          |The product id carried by this message.
        }
      }
      requestedQuantity: Quantity with {
        briefly "Requested quantity"
        described as {
          |The requested quantity carried by this message.
        }
      }
      availableQuantity: Quantity with {
        briefly "Available quantity"
        described as {
          |The available quantity carried by this message.
        }
      }
    }
+
    failedAt: TimeStamp
  } with {
    briefly "Inventory allocation failed"
  }
  event StockReleased is {
    orderId: OrderId
    releasedAt: TimeStamp
  } with {
    briefly "Reserved inventory was released"
  }
  handler InventoryHandler is {
    on allocateStock: command AllocateStock is {
      yield event StockAllocated(orderId = allocateStock.orderId, allItemsAllocated = prompt("the all items allocated of this stock allocated"), allocatedAt = prompt("the allocated at of this stock allocated"))
    }
    on releaseStock: command ReleaseStock is {
      yield event StockReleased(orderId = releaseStock.orderId, releasedAt = prompt("the released at of this stock released"))
    }
  } with {
    briefly "Handles inventory commands"
  }
} with {
  briefly "External inventory management service"
  described as {
    | The InventoryService context represents the external inventory
    | management system that tracks stock levels, handles allocation,
    | and manages warehouse operations.
  }
}
external context ShippingCarrier is {
  command CreateShipment yields event ShipmentCreatedByCarrier is {
    orderId: OrderId
    carrier: CarrierCode
    shippingAddress: Address
    packageItems: {
      productId: ProductId with {
        briefly "Product id"
        described as {
          |The product id carried by this message.
        }
      }
      quantity: Quantity with {
        briefly "Quantity"
        described as {
          |The quantity carried by this message.
        }
      }
      weight: Real? with {
        briefly "Weight"
        described as {
          |The weight carried by this message.
        }
      }
    }
+
  } with {
    briefly "Create a shipment with carrier"
  }
  command CancelShipment yields event ShipmentCancelled is {
    shipmentId: ShipmentId
    reason: String(1,500)
  } with {
    briefly "Cancel a pending shipment"
  }
  event ShipmentCreatedByCarrier is {
    shipmentId: ShipmentId
    orderId: OrderId
    trackingNumber: TrackingNumber
    estimatedDelivery: Date?
    createdAt: TimeStamp
  } with {
    briefly "Shipment was created with carrier"
  }
  event ShipmentPickedUp is {
    shipmentId: ShipmentId
    pickedUpAt: TimeStamp
  } with {
    briefly "Carrier picked up the shipment"
  }
  event ShipmentInTransit is {
    shipmentId: ShipmentId
    currentLocation: String(1,200)?
    updatedAt: TimeStamp
  } with {
    briefly "Shipment is in transit"
  }
  event ShipmentDeliveredByCarrier is {
    shipmentId: ShipmentId
    deliveredAt: TimeStamp
    signedBy: String(1,100)?
  } with {
    briefly "Shipment was delivered"
  }
  event ShipmentCancelled is {
    shipmentId: ShipmentId
    cancelledAt: TimeStamp
  } with {
    briefly "Shipment was cancelled"
  }
  handler ShippingHandler is {
    on createShipment: command CreateShipment is {
      yield event ShipmentCreatedByCarrier(orderId = createShipment.orderId, shipmentId = prompt("the shipment id of this shipment created by carrier"), trackingNumber = prompt("the tracking number of this shipment created by carrier"), estimatedDelivery = empty, createdAt = prompt("the created at of this shipment created by carrier"))
    }
    on cancelShipment: command CancelShipment is {
      yield event ShipmentCancelled(shipmentId = cancelShipment.shipmentId, cancelledAt = prompt("the cancelled at of this shipment cancelled"))
    }
  } with {
    briefly "Handles shipping commands"
  }
} with {
  briefly "External shipping carrier integration"
  described as {
    | The ShippingCarrier context represents integration with
    | shipping carriers (UPS, FedEx, USPS, etc.) for creating
    | shipments, obtaining tracking numbers, and receiving
    | delivery status updates via webhooks.
  }
}
external context CustomerService is {
  command SendOrderConfirmation yields event NotificationSent is {
    orderId: OrderId
    customerId: CustomerId
    orderDetails: {
      orderItems: OrderItemRecord+ with {
        briefly "Order items"
        described as {
          |The order items carried by this message.
        }
      }
      total: Money with {
        briefly "Total"
        described as {
          |The total carried by this message.
        }
      }
      trackingNumber: TrackingNumber? with {
        briefly "Tracking number"
        described as {
          |The tracking number carried by this message.
        }
      }
    }

  } with {
    briefly "Send order confirmation to customer"
  }
  command SendOrderCancellation yields event NotificationSent is {
    orderId: OrderId
    customerId: CustomerId
    reason: String(1,500)
  } with {
    briefly "Send cancellation notice to customer"
  }
  command SendShippingUpdate yields event NotificationSent is {
    orderId: OrderId
    customerId: CustomerId
    trackingNumber: TrackingNumber
    shippingStatus: String(1,100)
  } with {
    briefly "Send shipping status update"
  }
  command CreateSupportTicket yields event SupportTicketCreated is {
    orderId: OrderId
    customerId: CustomerId
    issue: String(1,1000)
    priority: String(1,20)
  } with {
    briefly "Create a support ticket for order issue"
  }
  event NotificationSent is {
    customerId: CustomerId
    notificationType: String(1,50)
    sentAt: TimeStamp
  } with {
    briefly "Notification was sent to customer"
  }
  event SupportTicketCreated is {
    ticketId: UUID
    orderId: OrderId
    createdAt: TimeStamp
  } with {
    briefly "Support ticket was created"
  }
  handler CustomerServiceHandler is {
    on sendOrderConfirmation: command SendOrderConfirmation is {
      yield event NotificationSent(customerId = sendOrderConfirmation.customerId, notificationType = prompt("the notification type of this notification sent"), sentAt = prompt("the sent at of this notification sent"))
    }
    on sendOrderCancellation: command SendOrderCancellation is {
      yield event NotificationSent(customerId = sendOrderCancellation.customerId, notificationType = prompt("the notification type of this notification sent"), sentAt = prompt("the sent at of this notification sent"))
    }
    on sendShippingUpdate: command SendShippingUpdate is {
      yield event NotificationSent(customerId = sendShippingUpdate.customerId, notificationType = prompt("the notification type of this notification sent"), sentAt = prompt("the sent at of this notification sent"))
    }
    on createSupportTicket: command CreateSupportTicket is {
      yield event SupportTicketCreated(orderId = createSupportTicket.orderId, ticketId = prompt("the ticket id of this support ticket created"), createdAt = prompt("the created at of this support ticket created"))
    }
  } with {
    briefly "Handles customer communication commands"
  }
} with {
  briefly "External customer service system"
  described as {
    | The CustomerService context represents the external customer
    | communication and support system that handles notifications,
    | email/SMS alerts, and support ticket management.
  }
}
