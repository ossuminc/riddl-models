// Order Management - Order Context
// The primary bounded context for order lifecycle management
context OrderContext is {
  include "types.riddl"
  include "Order.riddl"
  include "Shipment.riddl"
  include "Return.riddl"
  include "OrderFulfillmentSaga.riddl"
  // Adaptors for external system integration
  adaptor PaymentAdapter from context PaymentGateway is { 
    handler InboundPayments is {
      on event PaymentGateway.PaymentSucceeded is {
        tell command ConfirmPayment to entity Order
      }
      on event PaymentGateway.PaymentFailed is {
        do "Log payment failure and notify order processing"
      }
      on event PaymentGateway.RefundCompleted is {
        do "Update return status with refund confirmation"
      }
      on other is {
        error "Unexpected message for adaptor PaymentAdapter"
      }
    } with {
      briefly "Handles payment events from gateway"
      described as {
        |Processes inbound payment status events and routes to Order entity.
      }
    }
  } with {
    briefly "Translates payment gateway events"
    described as {
      | Receives payment status events from the external PaymentGateway
      | and translates them into commands for the Order entity.
    }
  }
  adaptor InventoryAdapter from context InventoryService is { 
    handler InboundInventory is {
      on event InventoryService.StockAllocated is {
        tell command AllocateInventory to entity Order
      }
      on event InventoryService.StockAllocationFailed is {
        do "Handle inventory shortage - may need to cancel or partial fulfill"
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles inventory events"
      described as {
        |Processes inventory allocation results from warehouse system.
      }
    }
  } with {
    briefly "Translates inventory service events"
    described as {
      | Receives stock allocation events from the InventoryService
      | and updates order status accordingly.
    }
  }
  adaptor ShippingAdapter from context ShippingCarrier is { 
    handler InboundShipping is {
      on event ShippingCarrier.ShipmentCreatedByCarrier is {
        tell command Shipment.InitShipment to entity Shipment
      }
      on event ShippingCarrier.ShipmentPickedUp is {
        tell command UpdateTracking to entity Shipment
      }
      on event ShippingCarrier.ShipmentInTransit is {
        tell command UpdateTracking to entity Shipment
      }
      on event ShippingCarrier.ShipmentDeliveredByCarrier is {
        tell command MarkDelivered to entity Shipment
        tell command DeliverOrder to entity Order
      }
      on other is {
        error "Unexpected message for adaptor ShippingAdapter"
      }
    } with {
      briefly "Handles shipping carrier events"
      described as {
        |Processes carrier tracking webhooks and updates shipment status.
      }
    }
  } with {
    briefly "Translates shipping carrier events"
    described as {
      | Receives tracking updates from shipping carriers via webhooks
      | and updates both Shipment and Order entities.
    }
  }
  // Repository for order persistence
  repository OrderRepository as merge is {
    inlet OrderRepositoryFromOrder is type OrderEvent    inlet OrderRepositoryFromReturn is type ReturnEvent    inlet OrderRepositoryFromShipment is type ShipmentStreamEvent    inlet OrderRepositoryFromOrderAnalytics is type OrderEvent    outlet OrderRepositoryResponses is type Order.OrderResult
    record StoredOrder is  {
      orderId: OrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored order row.
        }
      }
      customerId: CustomerId with {
        briefly "customerId"
        described as {
          |The customerId column of the stored order row.
        }
      }
    } with {
      briefly "Stored order row"
      described as {
        |The persistence shape of order data as this repository stores it.
      }
    }
    record StoredReturn is  {
      returnId: ReturnId with {
        briefly "returnId"
        described as {
          |The returnId column of the stored return row.
        }
      }
      orderId: OrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored return row.
        }
      }
    } with {
      briefly "Stored return row"
      described as {
        |The persistence shape of return data as this repository stores it.
      }
    }
    record StoredShipment is  {
      shipmentId: ShipmentId with {
        briefly "shipmentId"
        described as {
          |The shipmentId column of the stored shipment row.
        }
      }
      orderId: OrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored shipment row.
        }
      }
    } with {
      briefly "Stored shipment row"
      described as {
        |The persistence shape of shipment data as this repository stores it.
      }
    }
    schema OrderData is relational
      of orders as type StoredOrder
      of returns as type StoredReturn
      of shipments as type StoredShipment
        link orderReturns as field StoredOrder.orderId to field StoredReturn.orderId
        link orderShipments as field StoredOrder.orderId to field StoredShipment.orderId
        index on field StoredOrder.customerId
 with {
      briefly "Order data schema"
      described as {
        |The relational schema holding order data for the OrderRepository.
      }
    }
    handler OrderPersistence is {
      on query GetDailyOrderMetrics is {
        do "read the daily order metrics projection"
        reply result DailyOrderMetricsView
      }
      on command Order.PlaceOrder is {
        tell event Order.OrderPlaced to entity OrderContext.Order
        do "Persist new order to database"
      }
      on command Order.ConfirmPayment is {
        tell event Order.PaymentConfirmed to entity OrderContext.Order
        do "Update order with payment confirmation"
      }
      on command Order.ShipOrder is {
        tell event Order.OrderShipped to entity OrderContext.Order
        do "Update order status and link shipment"
      }
      on command Order.DeliverOrder is {
        tell event Order.OrderDelivered to entity OrderContext.Order
        do "Update order to delivered status"
      }
      on command Order.CancelOrder is {
        tell event Order.OrderCancelled to entity OrderContext.Order
        do "Update order to cancelled status"
      }
      on command Return.RequestReturn is {
        do "Create return record linked to order"
      }
      on command Return.ProcessRefund is {
        tell event Return.RefundProcessed to entity OrderContext.Return
        do "Update order with refund information"
      }
    } with {
      briefly "Persists order data via commands"
      described as {
        |Handles command-driven persistence operations for orders.
      }
    }
  } with {
    briefly "Persistent storage for order data"
    described as {
      | The OrderRepository provides persistent storage for orders,
      | shipments, and returns with appropriate indexes for query
      | performance on common access patterns.
    }
  }
  // Projector for order analytics
  query GetDailyOrderMetrics is  {
    dailyOrderMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily order metrics to retrieve.
      }
    }
  } with {
    briefly "Get daily order metrics"
    described as {
      |Retrieves the daily order metrics projection.
    }
  }
  result DailyOrderMetricsView is  {
    dailyOrderMetrics: OrderAnalytics.DailyOrderMetrics with {
      briefly "Daily order metrics"
      described as {
        |The daily order metrics being returned.
      }
    }
  } with {
    briefly "Daily order metrics view"
    described as {
      |Read model view carrying the daily order metrics projection.
    }
  }
  projector OrderAnalytics as merge is {
    updates repository OrderContext.OrderRepository
    inlet OrderAnalyticsFromOrder is type OrderEvent    inlet OrderAnalyticsFromReturn is type ReturnEvent    inlet OrderAnalyticsFromShipment is type ShipmentStreamEvent    outlet OrderAnalyticsOut is type OrderEvent
    record DailyOrderMetrics is  {
      date: Date with {
        briefly "Date"
        described as {
          |The date for these metrics.
        }
      }
      orderCount: Natural with {
        briefly "Orders"
        described as {
          |Number of orders.
        }
      }
      totalRevenue: Money with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageOrderValue: Money with {
        briefly "AOV"
        described as {
          |Average order value.
        }
      }
      cancellationCount: Natural with {
        briefly "Cancellations"
        described as {
          |Orders cancelled.
        }
      }
      refundCount: Natural with {
        briefly "Refunds"
        described as {
          |Refunds processed.
        }
      }
      refundTotal: Money with {
        briefly "Refund total"
        described as {
          |Total refunded.
        }
      }
    } with {
      briefly "Daily aggregated order metrics"
      described as {
        |Aggregated order statistics for a single day.
      }
    }
    handler AnalyticsHandler is {
      on orderPlaced: event Order.OrderPlaced is {
        tell orderPlaced to repository OrderContext.OrderRepository
        do "Update daily order counts and revenue metrics"
      }
      on orderCancelled: event Order.OrderCancelled is {
        tell orderCancelled to repository OrderContext.OrderRepository
        do "Update cancellation rate metrics"
      }
      on refundProcessed: event Return.RefundProcessed is {
        tell refundProcessed to repository OrderContext.OrderRepository
        do "Update refund metrics and return rates"
      }
    } with {
      briefly "Projects order events for analytics"
      described as {
        |Processes order events to maintain aggregate metrics.
      }
    }
  } with {
    briefly "Projects order events for reporting"
    described as {
      | Maintains aggregated views of order data for dashboards
      | and business intelligence reporting.
    }
  }
  // ---- Event publication for Order ----
  type OrderEvent is one of {
    OrderContext.Order.OrderPlaced or OrderContext.Order.PaymentConfirmed or OrderContext.Order.InventoryAllocated or OrderContext.Order.OrderShipped or OrderContext.Order.OrderDelivered or OrderContext.Order.CustomerNotified or OrderContext.Order.OrderCancelled
  } with {
    briefly "Order event alternation"
    described as {
      |Union of all Order events, for streaming and event-sourced
      |persistence.
    }
  }
  processor OrderEventSource as source is {
    outlet OrderEvents is type OrderEvent
    handler OrderSourceHandler is {
      on orderPlaced: event Order.OrderPlaced is {
        send orderPlaced to outlet OrderEvents
      }
      on paymentConfirmed: event Order.PaymentConfirmed is {
        send paymentConfirmed to outlet OrderEvents
      }
      on inventoryAllocated: event Order.InventoryAllocated is {
        send inventoryAllocated to outlet OrderEvents
      }
      on orderShipped: event Order.OrderShipped is {
        send orderShipped to outlet OrderEvents
      }
      on orderDelivered: event Order.OrderDelivered is {
        send orderDelivered to outlet OrderEvents
      }
      on orderCancelled: event Order.OrderCancelled is {
        send orderCancelled to outlet OrderEvents
      }
      on other is {
        error "Unexpected message for source OrderEventSource"
      }
    } with {
      briefly "Order source handler"
      described as {
        |Publishes Order events onto the outlet.
      }
    }
  } with {
    briefly "Order event source"
    described as {
      |Publishes Order entity events into the streaming topology.
    }
  }
  processor OrderEventSink as sink is {
    inlet OrderInlet is type OrderEvent    handler OrderSinkHandler is {
      on orderPlaced: event Order.OrderPlaced is {
        tell orderPlaced to repository OrderContext.OrderRepository
      }
      on paymentConfirmed: event Order.PaymentConfirmed is {
        tell paymentConfirmed to repository OrderContext.OrderRepository
      }
      on inventoryAllocated: event Order.InventoryAllocated is {
        tell inventoryAllocated to repository OrderContext.OrderRepository
      }
      on orderShipped: event Order.OrderShipped is {
        tell orderShipped to repository OrderContext.OrderRepository
      }
      on orderDelivered: event Order.OrderDelivered is {
        tell orderDelivered to repository OrderContext.OrderRepository
      }
      on orderCancelled: event Order.OrderCancelled is {
        tell orderCancelled to repository OrderContext.OrderRepository
      }
      on other is {
        error "Unexpected message for sink OrderEventSink"
      }
    } with {
      briefly "Order sink handler"
      described as {
        |Persists Order events via the repository.
      }
    }
  } with {
    briefly "Order event sink"
    described as {
      |Receives Order events for persistence.
    }
  }
  connector OrderEventFlow is from outlet OrderContext.OrderEventSource.OrderEvents to inlet OrderContext.OrderEventSink.OrderInlet with {
    briefly "Order event flow"
    described as {
      |Connects the Order source to its sink.
    }
  }
  // ---- Event publication for Shipment ----
  type ShipmentStreamEvent is one of {
    OrderContext.Shipment.ShipmentCreated or OrderContext.Shipment.TrackingUpdated or OrderContext.Shipment.ShipmentDelivered or OrderContext.Shipment.ShipmentFailed
  } with {
    briefly "Shipment event alternation"
    described as {
      |Union of all Shipment events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ShipmentEventSource as source is {
    outlet ShipmentEvents is type ShipmentStreamEvent
    handler ShipmentSourceHandler is {
      on shipmentCreated: event Shipment.ShipmentCreated is {
        send shipmentCreated to outlet ShipmentEvents
      }
      on trackingUpdated: event Shipment.TrackingUpdated is {
        send trackingUpdated to outlet ShipmentEvents
      }
      on shipmentDelivered: event Shipment.ShipmentDelivered is {
        send shipmentDelivered to outlet ShipmentEvents
      }
      on shipmentFailed: event Shipment.ShipmentFailed is {
        send shipmentFailed to outlet ShipmentEvents
      }
      on other is {
        error "Unexpected message for source ShipmentEventSource"
      }
    } with {
      briefly "Shipment source handler"
      described as {
        |Publishes Shipment events onto the outlet.
      }
    }
  } with {
    briefly "Shipment event source"
    described as {
      |Publishes Shipment entity events into the streaming topology.
    }
  }
  processor ShipmentEventSink as sink is {
    inlet ShipmentInlet is type ShipmentStreamEvent    handler ShipmentSinkHandler is {
      on shipmentCreated: event Shipment.ShipmentCreated is {
        tell shipmentCreated to repository OrderContext.OrderRepository
      }
      on trackingUpdated: event Shipment.TrackingUpdated is {
        tell trackingUpdated to repository OrderContext.OrderRepository
      }
      on shipmentDelivered: event Shipment.ShipmentDelivered is {
        tell shipmentDelivered to repository OrderContext.OrderRepository
      }
      on shipmentFailed: event Shipment.ShipmentFailed is {
        tell shipmentFailed to repository OrderContext.OrderRepository
      }
      on other is {
        error "Unexpected message for sink ShipmentEventSink"
      }
    } with {
      briefly "Shipment sink handler"
      described as {
        |Persists Shipment events via the repository.
      }
    }
  } with {
    briefly "Shipment event sink"
    described as {
      |Receives Shipment events for persistence.
    }
  }
  connector ShipmentEventFlow is from outlet OrderContext.ShipmentEventSource.ShipmentEvents to inlet OrderContext.ShipmentEventSink.ShipmentInlet with {
    briefly "Shipment event flow"
    described as {
      |Connects the Shipment source to its sink.
    }
  }
  // ---- Event publication for Return ----
  type ReturnEvent is one of {
    OrderContext.Return.ReturnRequested or OrderContext.Return.ReturnApproved or OrderContext.Return.ReturnDenied or OrderContext.Return.ReturnReceived or OrderContext.Return.RefundProcessed
  } with {
    briefly "Return event alternation"
    described as {
      |Union of all Return events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ReturnEventSource as source is {
    outlet ReturnEvents is type ReturnEvent
    handler ReturnSourceHandler is {
      on returnRequested: event Return.ReturnRequested is {
        send returnRequested to outlet ReturnEvents
      }
      on returnApproved: event Return.ReturnApproved is {
        send returnApproved to outlet ReturnEvents
      }
      on returnDenied: event Return.ReturnDenied is {
        send returnDenied to outlet ReturnEvents
      }
      on returnReceived: event Return.ReturnReceived is {
        send returnReceived to outlet ReturnEvents
      }
      on refundProcessed: event Return.RefundProcessed is {
        send refundProcessed to outlet ReturnEvents
      }
      on other is {
        error "Unexpected message for source ReturnEventSource"
      }
    } with {
      briefly "Return source handler"
      described as {
        |Publishes Return events onto the outlet.
      }
    }
  } with {
    briefly "Return event source"
    described as {
      |Publishes Return entity events into the streaming topology.
    }
  }
  processor ReturnEventSink as sink is {
    inlet ReturnInlet is type ReturnEvent    handler ReturnSinkHandler is {
      on returnRequested: event Return.ReturnRequested is {
        tell returnRequested to repository OrderContext.OrderRepository
      }
      on returnApproved: event Return.ReturnApproved is {
        tell returnApproved to repository OrderContext.OrderRepository
      }
      on returnDenied: event Return.ReturnDenied is {
        tell returnDenied to repository OrderContext.OrderRepository
      }
      on returnReceived: event Return.ReturnReceived is {
        tell returnReceived to repository OrderContext.OrderRepository
      }
      on refundProcessed: event Return.RefundProcessed is {
        tell refundProcessed to repository OrderContext.OrderRepository
      }
      on other is {
        error "Unexpected message for sink ReturnEventSink"
      }
    } with {
      briefly "Return sink handler"
      described as {
        |Persists Return events via the repository.
      }
    }
  } with {
    briefly "Return event sink"
    described as {
      |Receives Return events for persistence.
    }
  }
  connector ReturnEventFlow is from outlet OrderContext.ReturnEventSource.ReturnEvents to inlet OrderContext.ReturnEventSink.ReturnInlet with {
    briefly "Return event flow"
    described as {
      |Connects the Return source to its sink.
    }
  }
  processor OrderEventSplit as split is {
    inlet OrderEventSplitIn is type OrderEvent    outlet OrderEventSplitToOrderRepository is type OrderEvent
    outlet OrderEventSplitToOrderAnalytics is type OrderEvent
    handler OrderEventSplitHandler is {
      on orderPlaced: event Order.OrderPlaced is {
        send orderPlaced to outlet OrderEventSplitToOrderRepository
        send orderPlaced to outlet OrderEventSplitToOrderAnalytics
        tell orderPlaced to entity OrderContext.Order
      }
      on paymentConfirmed: event Order.PaymentConfirmed is {
        send paymentConfirmed to outlet OrderEventSplitToOrderRepository
        send paymentConfirmed to outlet OrderEventSplitToOrderAnalytics
        tell paymentConfirmed to entity OrderContext.Order
      }
      on inventoryAllocated: event Order.InventoryAllocated is {
        send inventoryAllocated to outlet OrderEventSplitToOrderRepository
        send inventoryAllocated to outlet OrderEventSplitToOrderAnalytics
        tell inventoryAllocated to entity OrderContext.Order
      }
      on orderShipped: event Order.OrderShipped is {
        send orderShipped to outlet OrderEventSplitToOrderRepository
        send orderShipped to outlet OrderEventSplitToOrderAnalytics
        tell orderShipped to entity OrderContext.Order
      }
      on orderDelivered: event Order.OrderDelivered is {
        send orderDelivered to outlet OrderEventSplitToOrderRepository
        send orderDelivered to outlet OrderEventSplitToOrderAnalytics
        tell orderDelivered to entity OrderContext.Order
      }
      on orderCancelled: event Order.OrderCancelled is {
        send orderCancelled to outlet OrderEventSplitToOrderRepository
        send orderCancelled to outlet OrderEventSplitToOrderAnalytics
        tell orderCancelled to entity OrderContext.Order
      }
      on other is {
        error "Unexpected message for processor OrderEventSplit"
      }
    } with {
      briefly "Order event fan-out handler"
      described as {
        |Delivers each Order event to all of its consumers.
      }
    }
  } with {
    briefly "Order event fan-out"
    described as {
      |Fans Order events out to the repository and projectors.
    }
  }
  processor ReturnEventSplit as split is {
    inlet ReturnEventSplitIn is type ReturnEvent    outlet ReturnEventSplitToOrderRepository is type ReturnEvent
    outlet ReturnEventSplitToOrderAnalytics is type ReturnEvent
    handler ReturnEventSplitHandler is {
      on returnRequested: event Return.ReturnRequested is {
        send returnRequested to outlet ReturnEventSplitToOrderRepository
        send returnRequested to outlet ReturnEventSplitToOrderAnalytics
        tell returnRequested to entity OrderContext.Return
      }
      on returnApproved: event Return.ReturnApproved is {
        send returnApproved to outlet ReturnEventSplitToOrderRepository
        send returnApproved to outlet ReturnEventSplitToOrderAnalytics
        tell returnApproved to entity OrderContext.Return
      }
      on returnDenied: event Return.ReturnDenied is {
        send returnDenied to outlet ReturnEventSplitToOrderRepository
        send returnDenied to outlet ReturnEventSplitToOrderAnalytics
        tell returnDenied to entity OrderContext.Return
      }
      on returnReceived: event Return.ReturnReceived is {
        send returnReceived to outlet ReturnEventSplitToOrderRepository
        send returnReceived to outlet ReturnEventSplitToOrderAnalytics
        tell returnReceived to entity OrderContext.Return
      }
      on refundProcessed: event Return.RefundProcessed is {
        send refundProcessed to outlet ReturnEventSplitToOrderRepository
        send refundProcessed to outlet ReturnEventSplitToOrderAnalytics
        tell refundProcessed to entity OrderContext.Return
      }
      on other is {
        error "Unexpected message for processor ReturnEventSplit"
      }
    } with {
      briefly "Return event fan-out handler"
      described as {
        |Delivers each Return event to all of its consumers.
      }
    }
  } with {
    briefly "Return event fan-out"
    described as {
      |Fans Return events out to the repository and projectors.
    }
  }
  processor ShipmentEventSplit as split is {
    inlet ShipmentEventSplitIn is type ShipmentStreamEvent    outlet ShipmentEventSplitToOrderRepository is type ShipmentStreamEvent
    outlet ShipmentEventSplitToOrderAnalytics is type ShipmentStreamEvent
    handler ShipmentEventSplitHandler is {
      on shipmentCreated: event Shipment.ShipmentCreated is {
        send shipmentCreated to outlet ShipmentEventSplitToOrderRepository
        send shipmentCreated to outlet ShipmentEventSplitToOrderAnalytics
        tell shipmentCreated to entity OrderContext.Shipment
      }
      on trackingUpdated: event Shipment.TrackingUpdated is {
        send trackingUpdated to outlet ShipmentEventSplitToOrderRepository
        send trackingUpdated to outlet ShipmentEventSplitToOrderAnalytics
        tell trackingUpdated to entity OrderContext.Shipment
      }
      on shipmentDelivered: event Shipment.ShipmentDelivered is {
        send shipmentDelivered to outlet ShipmentEventSplitToOrderRepository
        send shipmentDelivered to outlet ShipmentEventSplitToOrderAnalytics
        tell shipmentDelivered to entity OrderContext.Shipment
      }
      on shipmentFailed: event Shipment.ShipmentFailed is {
        send shipmentFailed to outlet ShipmentEventSplitToOrderRepository
        send shipmentFailed to outlet ShipmentEventSplitToOrderAnalytics
        tell shipmentFailed to entity OrderContext.Shipment
      }
      on other is {
        error "Unexpected message for processor ShipmentEventSplit"
      }
    } with {
      briefly "Shipment event fan-out handler"
      described as {
        |Delivers each Shipment event to all of its consumers.
      }
    }
  } with {
    briefly "Shipment event fan-out"
    described as {
      |Fans Shipment events out to the repository and projectors.
    }
  }
  connector 'OrderEvent Stream' is from outlet OrderContext.Order.OrderEvents2 to inlet OrderContext.OrderEventSplit.OrderEventSplitIn with {
    briefly "Order events, fanned out to storage and read models"
  }
  connector 'OrderEvent Storage' is from outlet OrderContext.OrderEventSplit.OrderEventSplitToOrderRepository to inlet OrderContext.OrderRepository.OrderRepositoryFromOrder with {
    briefly "Order events on their way to storage"
  }
  connector 'OrderEvent Feed' is from outlet OrderContext.OrderEventSplit.OrderEventSplitToOrderAnalytics to inlet OrderContext.OrderAnalytics.OrderAnalyticsFromOrder with {
    briefly "OrderEvent feeding the OrderAnalytics projection"
  }
  connector 'ReturnEvent Stream' is from outlet OrderContext.Return.ReturnEvents2 to inlet OrderContext.ReturnEventSplit.ReturnEventSplitIn with {
    briefly "Return events, fanned out to storage and read models"
  }
  connector 'ReturnEvent Storage' is from outlet OrderContext.ReturnEventSplit.ReturnEventSplitToOrderRepository to inlet OrderContext.OrderRepository.OrderRepositoryFromReturn with {
    briefly "Return events on their way to storage"
  }
  connector 'ReturnEvent Feed' is from outlet OrderContext.ReturnEventSplit.ReturnEventSplitToOrderAnalytics to inlet OrderContext.OrderAnalytics.OrderAnalyticsFromReturn with {
    briefly "ReturnEvent feeding the OrderAnalytics projection"
  }
  connector 'ShipmentStreamEvent Stream' is from outlet OrderContext.Shipment.ShipmentEvents2 to inlet OrderContext.ShipmentEventSplit.ShipmentEventSplitIn with {
    briefly "Shipment events, fanned out to storage and read models"
  }
  connector 'ShipmentStreamEvent Storage' is from outlet OrderContext.ShipmentEventSplit.ShipmentEventSplitToOrderRepository to inlet OrderContext.OrderRepository.OrderRepositoryFromShipment with {
    briefly "Shipment events on their way to storage"
  }
  connector 'ShipmentStreamEvent Feed' is from outlet OrderContext.ShipmentEventSplit.ShipmentEventSplitToOrderAnalytics to inlet OrderContext.OrderAnalytics.OrderAnalyticsFromShipment with {
    briefly "ShipmentStreamEvent feeding the OrderAnalytics projection"
  }
  connector 'OrderAnalytics Storage' is from outlet OrderContext.OrderAnalytics.OrderAnalyticsOut to inlet OrderContext.OrderRepository.OrderRepositoryFromOrderAnalytics with {
    briefly "The OrderAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for order management"
  described as {
    | The OrderContext is the primary bounded context for the Order
    | Management domain. It contains all entities, sagas, and
    | integrations needed to manage the complete order lifecycle
    | from placement through delivery or return.
  }
}
