    } with {
      briefly "Stored shipment row"
      described as {
        |The persistence shape of shipment data as this repository stores it.
      }
    }
    schema OrderData is relational
      of orders as record StoredOrder
      of returns as record StoredReturn
      of shipments as record StoredShipment
        link orderReturns as field StoredOrder.orderId to field StoredReturn.orderId
        link orderShipments as field StoredOrder.orderId to field StoredShipment.orderId
        key on field StoredOrder.orderId
        key on field StoredReturn.returnId
        key on field StoredShipment.shipmentId
        index on field StoredOrder.customerId
 with {
      briefly "Order data schema"
      described as {
        |The relational schema holding order data for the OrderRepository.
      }
    }
    handler OrderPersistence is {
      on persistPaymentConfirmed: command PersistPaymentConfirmed is {
        update OrderData.orders set transactionId = persistPaymentConfirmed.transactionId, amountPaid = persistPaymentConfirmed.amountPaid, confirmedAt = persistPaymentConfirmed.confirmedAt where orderId == persistPaymentConfirmed.orderId
      }
      on persistInventoryAllocated: command PersistInventoryAllocated is {
        update OrderData.orders set allItemsAllocated = persistInventoryAllocated.allItemsAllocated, allocatedAt = persistInventoryAllocated.allocatedAt where orderId == persistInventoryAllocated.orderId
      }
      on persistOrderShipped: command PersistOrderShipped is {
        update OrderData.orders set shipmentId = persistOrderShipped.shipmentId, carrier = persistOrderShipped.carrier, trackingNumber = persistOrderShipped.trackingNumber, shippedAt = persistOrderShipped.shippedAt where orderId == persistOrderShipped.orderId
      }
      on persistOrderDelivered: command PersistOrderDelivered is {
        update OrderData.orders set deliveredAt = persistOrderDelivered.deliveredAt, signedBy = persistOrderDelivered.signedBy where orderId == persistOrderDelivered.orderId
      }
      on persistCustomerNotified: command PersistCustomerNotified is {
        update OrderData.orders set customerId = persistCustomerNotified.customerId, notifiedAt = persistCustomerNotified.notifiedAt where orderId == persistCustomerNotified.orderId
      }
      on persistReturnRequested: command PersistReturnRequested is {
        update OrderData.returns set orderId = persistReturnRequested.orderId, customerId = persistReturnRequested.customerId, returnItems = persistReturnRequested.returnItems, returnReason = persistReturnRequested.returnReason, requestedAt = persistReturnRequested.requestedAt where returnId == persistReturnRequested.returnId
      }
      on persistReturnApproved: command PersistReturnApproved is {
        update OrderData.returns set approvedBy = persistReturnApproved.approvedBy, returnLabel = persistReturnApproved.returnLabel, approvedAt = persistReturnApproved.approvedAt where returnId == persistReturnApproved.returnId
      }
      on persistReturnDenied: command PersistReturnDenied is {
        update OrderData.returns set deniedBy = persistReturnDenied.deniedBy, reason = persistReturnDenied.reason, deniedAt = persistReturnDenied.deniedAt where returnId == persistReturnDenied.returnId
      }
      on persistReturnReceived: command PersistReturnReceived is {
        update OrderData.returns set receivedAt = persistReturnReceived.receivedAt, condition = persistReturnReceived.condition, allItemsReceived = persistReturnReceived.allItemsReceived where returnId == persistReturnReceived.returnId
      }
      on persistShipmentCreated: command PersistShipmentCreated is {
        update OrderData.shipments set orderId = persistShipmentCreated.orderId, carrier = persistShipmentCreated.carrier, trackingNumber = persistShipmentCreated.trackingNumber, shippingAddress = persistShipmentCreated.shippingAddress, createdAt = persistShipmentCreated.createdAt, items = persistShipmentCreated.items where shipmentId == persistShipmentCreated.shipmentId
      }
      on persistTrackingUpdated: command PersistTrackingUpdated is {
        update OrderData.shipments set status = persistTrackingUpdated.status, location = persistTrackingUpdated.location, description = persistTrackingUpdated.description, updatedAt = persistTrackingUpdated.updatedAt where shipmentId == persistTrackingUpdated.shipmentId
      }
      on persistShipmentDelivered: command PersistShipmentDelivered is {
        update OrderData.shipments set orderId = persistShipmentDelivered.orderId, deliveredAt = persistShipmentDelivered.deliveredAt, signedBy = persistShipmentDelivered.signedBy where shipmentId == persistShipmentDelivered.shipmentId
      }
      on persistShipmentFailed: command PersistShipmentFailed is {
        update OrderData.shipments set orderId = persistShipmentFailed.orderId, reason = persistShipmentFailed.reason, failedAt = persistShipmentFailed.failedAt where shipmentId == persistShipmentFailed.shipmentId
      }
      on persistOrderCancelled: command PersistOrderCancelled is {
        update OrderData.orders set reason = persistOrderCancelled.reason, cancelledBy = persistOrderCancelled.cancelledBy, cancelledAt = persistOrderCancelled.cancelledAt where orderId == persistOrderCancelled.orderId
      }
      on persistOrderPlaced: command PersistOrderPlaced is {
        update OrderData.orders set customerId = persistOrderPlaced.customerId, items = persistOrderPlaced.items, subtotal = persistOrderPlaced.subtotal, tax = persistOrderPlaced.tax, shippingCost = persistOrderPlaced.shippingCost, total = persistOrderPlaced.total, shippingAddress = persistOrderPlaced.shippingAddress, billingAddress = persistOrderPlaced.billingAddress, placedAt = persistOrderPlaced.placedAt, paymentMethod = persistOrderPlaced.paymentMethod where orderId == persistOrderPlaced.orderId
      }
      on persistRefundProcessed: command PersistRefundProcessed is {
        update OrderData.returns set orderId = persistRefundProcessed.orderId, refundAmount = persistRefundProcessed.refundAmount, refundMethod = persistRefundProcessed.refundMethod, processedAt = persistRefundProcessed.processedAt where returnId == persistRefundProcessed.returnId
      }
      on query GetDailyOrderMetrics is {
        let dailyOrderMetricsView: type DailyOrderMetricsView = prompt("read the daily order metrics projection")
        reply dailyOrderMetricsView
      }
      on processRefund: command Return.ProcessRefund is {
        tell event Return.RefundProcessed(returnId = processRefund.returnId, refundAmount = processRefund.refundAmount, refundMethod = processRefund.refundMethod, orderId = prompt("the order id of this refund processed"), processedAt = prompt("the processed at of this refund processed")) to entity OrderContext.Return
        do "Update order with refund information"
      }
    } with {
      briefly "Persists order data via commands"
      described as {
        |Handles command-driven persistence operations for orders.
      }
    }
  } with {
    briefly "Persistent storage for order data"
    described as {
      | The OrderRepository provides persistent storage for orders,
      | shipments, and returns with appropriate indexes for query
      | performance on common access patterns.
    }
  }
  // Projector for order analytics
  query GetDailyOrderMetrics replies result DailyOrderMetricsView is {
    dailyOrderMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily order metrics to retrieve.
      }
    }
  } with {
    briefly "Get daily order metrics"
    described as {
      |Retrieves the daily order metrics projection.
    }
  }
  result DailyOrderMetricsView is {
    dailyOrderMetrics: OrderAnalytics.DailyOrderMetrics with {
      briefly "Daily order metrics"
      described as {
        |The daily order metrics being returned.
      }
    }
  } with {
    briefly "Daily order metrics view"
    described as {
      |Read model view carrying the daily order metrics projection.
    }
  }
  projector OrderAnalytics as merge is {
    updates repository OrderContext.OrderRepository
    outlet OrderAnalyticsToRepository is type OrderRepositoryCommand
    inlet OrderAnalyticsFromOrder is type OrderEvent    inlet OrderAnalyticsFromReturn is type ReturnEvent    inlet OrderAnalyticsFromShipment is type ShipmentStreamEvent    record DailyOrderMetrics is {
      date: Date with {
        briefly "Date"
        described as {
          |The date for these metrics.
        }
      }
      orderCount: Natural with {
        briefly "Orders"
        described as {
          |Number of orders.
        }
      }
      totalRevenue: Money with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageOrderValue: Money with {
        briefly "AOV"
        described as {
          |Average order value.
        }
      }
      cancellationCount: Natural with {
        briefly "Cancellations"
        described as {
          |Orders cancelled.
        }
      }
      refundCount: Natural with {
        briefly "Refunds"
        described as {
          |Refunds processed.
        }
      }
      refundTotal: Money with {
        briefly "Refund total"
        described as {
          |Total refunded.
        }
      }
    } with {
      briefly "Daily aggregated order metrics"
      described as {
        |Aggregated order statistics for a single day.
      }
    }
    handler AnalyticsHandler is {
      on paymentConfirmed: event Order.PaymentConfirmed is {
        tell command OrderContext.OrderRepository.PersistPaymentConfirmed(orderId = paymentConfirmed.orderId, transactionId = paymentConfirmed.transactionId, amountPaid = paymentConfirmed.amountPaid, confirmedAt = paymentConfirmed.confirmedAt) to repository OrderContext.OrderRepository
        do "Count the order as paid in the day's confirmed revenue"
      }
      on inventoryAllocated: event Order.InventoryAllocated is {
        tell command OrderContext.OrderRepository.PersistInventoryAllocated(orderId = inventoryAllocated.orderId, allItemsAllocated = inventoryAllocated.allItemsAllocated, allocatedAt = inventoryAllocated.allocatedAt) to repository OrderContext.OrderRepository
        do "Record the stock reservation for the allocation-latency measure"
      }
      on orderShipped: event Order.OrderShipped is {
        tell command OrderContext.OrderRepository.PersistOrderShipped(orderId = orderShipped.orderId, shipmentId = orderShipped.shipmentId, carrier = orderShipped.carrier, trackingNumber = orderShipped.trackingNumber, shippedAt = orderShipped.shippedAt) to repository OrderContext.OrderRepository
        do "Advance the order to shipped in the daily fulfilment funnel"
      }
      on orderDelivered: event Order.OrderDelivered is {
        tell command OrderContext.OrderRepository.PersistOrderDelivered(orderId = orderDelivered.orderId, deliveredAt = orderDelivered.deliveredAt, signedBy = orderDelivered.signedBy) to repository OrderContext.OrderRepository
        do "Close the fulfilment funnel and record time-to-deliver"
      }
      on customerNotified: event Order.CustomerNotified is {
        tell command OrderContext.OrderRepository.PersistCustomerNotified(orderId = customerNotified.orderId, customerId = customerNotified.customerId, notifiedAt = customerNotified.notifiedAt) to repository OrderContext.OrderRepository
        do "Count the notification against the day's customer-contact volume"
      }
      on returnRequested: event Return.ReturnRequested is {
        tell command OrderContext.OrderRepository.PersistReturnRequested(returnId = returnRequested.returnId, orderId = returnRequested.orderId, customerId = returnRequested.customerId, returnItems = returnRequested.returnItems, returnReason = returnRequested.returnReason, requestedAt = returnRequested.requestedAt) to repository OrderContext.OrderRepository
        do "Open a return in the day's return counts"
      }
      on returnApproved: event Return.ReturnApproved is {
        tell command OrderContext.OrderRepository.PersistReturnApproved(returnId = returnApproved.returnId, approvedBy = returnApproved.approvedBy, returnLabel = returnApproved.returnLabel, approvedAt = returnApproved.approvedAt) to repository OrderContext.OrderRepository
        do "Move the return from requested to approved in the return funnel"
      }
      on returnDenied: event Return.ReturnDenied is {
        tell command OrderContext.OrderRepository.PersistReturnDenied(returnId = returnDenied.returnId, deniedBy = returnDenied.deniedBy, reason = returnDenied.reason, deniedAt = returnDenied.deniedAt) to repository OrderContext.OrderRepository
        do "Record the denial, ending this return's contribution to refund totals"
      }
      on returnReceived: event Return.ReturnReceived is {
        tell command OrderContext.OrderRepository.PersistReturnReceived(returnId = returnReceived.returnId, receivedAt = returnReceived.receivedAt, condition = returnReceived.condition, allItemsReceived = returnReceived.allItemsReceived) to repository OrderContext.OrderRepository
        do "Record physical receipt, the point a refund becomes payable"
      }
      on shipmentCreated: event Shipment.ShipmentCreated is {
        tell command OrderContext.OrderRepository.PersistShipmentCreated(shipmentId = shipmentCreated.shipmentId, orderId = shipmentCreated.orderId, carrier = shipmentCreated.carrier, trackingNumber = shipmentCreated.trackingNumber, shippingAddress = shipmentCreated.shippingAddress, createdAt = shipmentCreated.createdAt, items = shipmentCreated.items) to repository OrderContext.OrderRepository
        do "Start tracking this shipment in the day's in-transit count"
      }
      on trackingUpdated: event Shipment.TrackingUpdated is {
        tell command OrderContext.OrderRepository.PersistTrackingUpdated(shipmentId = trackingUpdated.shipmentId, status = trackingUpdated.status, location = trackingUpdated.location, description = trackingUpdated.description, updatedAt = trackingUpdated.updatedAt) to repository OrderContext.OrderRepository
        do "Refresh shipment progress without changing the in-transit count"
      }
      on shipmentDelivered: event Shipment.ShipmentDelivered is {
        tell command OrderContext.OrderRepository.PersistShipmentDelivered(shipmentId = shipmentDelivered.shipmentId, orderId = shipmentDelivered.orderId, deliveredAt = shipmentDelivered.deliveredAt, signedBy = shipmentDelivered.signedBy) to repository OrderContext.OrderRepository
        do "Remove from in-transit and count the shipment delivered"
      }
      on shipmentFailed: event Shipment.ShipmentFailed is {
        tell command OrderContext.OrderRepository.PersistShipmentFailed(shipmentId = shipmentFailed.shipmentId, orderId = shipmentFailed.orderId, reason = shipmentFailed.reason, failedAt = shipmentFailed.failedAt) to repository OrderContext.OrderRepository
        do "Remove from in-transit and count the shipment failed"
      }
      on orderPlaced: event Order.OrderPlaced is {
        tell command OrderContext.OrderRepository.PersistOrderPlaced(orderId = orderPlaced.orderId, customerId = orderPlaced.customerId, items = orderPlaced.items, subtotal = orderPlaced.subtotal, tax = orderPlaced.tax, shippingCost = orderPlaced.shippingCost, total = orderPlaced.total, shippingAddress = orderPlaced.shippingAddress, billingAddress = orderPlaced.billingAddress, placedAt = orderPlaced.placedAt, paymentMethod = orderPlaced.paymentMethod) to repository OrderContext.OrderRepository
        do "Update daily order counts and revenue metrics"
      }
      on orderCancelled: event Order.OrderCancelled is {
        tell command OrderContext.OrderRepository.PersistOrderCancelled(orderId = orderCancelled.orderId, reason = orderCancelled.reason, cancelledBy = orderCancelled.cancelledBy, cancelledAt = orderCancelled.cancelledAt) to repository OrderContext.OrderRepository
        do "Update cancellation rate metrics"
      }
      on refundProcessed: event Return.RefundProcessed is {
        tell command OrderContext.OrderRepository.PersistRefundProcessed(returnId = refundProcessed.returnId, orderId = refundProcessed.orderId, refundAmount = refundProcessed.refundAmount, refundMethod = refundProcessed.refundMethod, processedAt = refundProcessed.processedAt) to repository OrderContext.OrderRepository
        do "Update refund metrics and return rates"
      }
    } with {
      briefly "Projects order events for analytics"
      described as {
        |Processes order events to maintain aggregate metrics.
      }
    }
  } with {
    briefly "Projects order events for reporting"
    described as {
      | Maintains aggregated views of order data for dashboards
      | and business intelligence reporting.
    }
  }
  // ---- Event publication for Order ----
  type OrderEvent is one of {
    OrderContext.Order.OrderPlaced or OrderContext.Order.PaymentConfirmed or OrderContext.Order.InventoryAllocated or OrderContext.Order.OrderShipped or OrderContext.Order.OrderDelivered or OrderContext.Order.CustomerNotified or OrderContext.Order.OrderCancelled
  } with {
    briefly "Order event alternation"
    described as {
      |Union of all Order events, for streaming and event-sourced
      |persistence.
    }
  }
  // ---- Event publication for Shipment ----
  type ShipmentStreamEvent is one of {
    OrderContext.Shipment.ShipmentCreated or OrderContext.Shipment.TrackingUpdated or OrderContext.Shipment.ShipmentDelivered or OrderContext.Shipment.ShipmentFailed
  } with {
    briefly "Shipment event alternation"
    described as {
      |Union of all Shipment events, for streaming and event-sourced
      |persistence.
    }
  }
  // ---- Event publication for Return ----
  type ReturnEvent is one of {
    OrderContext.Return.ReturnRequested or OrderContext.Return.ReturnApproved or OrderContext.Return.ReturnDenied or OrderContext.Return.ReturnReceived or OrderContext.Return.RefundProcessed
  } with {
    briefly "Return event alternation"
    described as {
      |Union of all Return events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet OrderEventSplit as split is {
    outlet OrderEventSplitToToShippingCarrier is type OrderEvent
    outlet OrderEventSplitToToCustomerService is type OrderEvent
    outlet OrderEventSplitToToPaymentGateway is type OrderEvent
    outlet OrderEventSplitToToInventoryService is type OrderEvent
    inlet OrderEventSplitIn is type OrderEvent    outlet OrderEventSplitToOrderAnalytics is type OrderEvent
    handler OrderEventSplitHandler is {
      on orderPlaced: event Order.OrderPlaced is {
        send orderPlaced to outlet OrderEventSplitToOrderAnalytics
        send orderPlaced to outlet OrderEventSplitToToPaymentGateway
        send orderPlaced to outlet OrderEventSplitToToInventoryService
        send orderPlaced to outlet OrderEventSplitToToCustomerService
        tell orderPlaced to entity OrderContext.Order
      }
      on paymentConfirmed: event Order.PaymentConfirmed is {
        send paymentConfirmed to outlet OrderEventSplitToOrderAnalytics
        tell paymentConfirmed to entity OrderContext.Order
      }
      on inventoryAllocated: event Order.InventoryAllocated is {
        send inventoryAllocated to outlet OrderEventSplitToOrderAnalytics
        tell inventoryAllocated to entity OrderContext.Order
      }
      on orderShipped: event Order.OrderShipped is {
        send orderShipped to outlet OrderEventSplitToOrderAnalytics
        send orderShipped to outlet OrderEventSplitToToCustomerService
        tell orderShipped to entity OrderContext.Order
      }
      on orderDelivered: event Order.OrderDelivered is {
        send orderDelivered to outlet OrderEventSplitToOrderAnalytics
        tell orderDelivered to entity OrderContext.Order
      }
      on orderCancelled: event Order.OrderCancelled is {
        send orderCancelled to outlet OrderEventSplitToOrderAnalytics
        send orderCancelled to outlet OrderEventSplitToToPaymentGateway
        send orderCancelled to outlet OrderEventSplitToToInventoryService
        send orderCancelled to outlet OrderEventSplitToToShippingCarrier
        send orderCancelled to outlet OrderEventSplitToToCustomerService
        tell orderCancelled to entity OrderContext.Order
      }
      on other is {
        error "Unexpected message for processor OrderEventSplit"
      }
    } with {
      briefly "Order event fan-out handler"
      described as {
        |Delivers each Order event to all of its consumers.
      }
    }
  } with {
    briefly "Order event fan-out"
    described as {
      |Fans Order events out to the repository and projectors.
    }
  }
  streamlet ReturnEventSplit as flow is {
    inlet ReturnEventSplitIn is type ReturnEvent    outlet ReturnEventSplitToOrderAnalytics is type ReturnEvent
    handler ReturnEventSplitHandler is {
      on returnRequested: event Return.ReturnRequested is {
        send returnRequested to outlet ReturnEventSplitToOrderAnalytics
        tell returnRequested to entity OrderContext.Return
      }
      on returnApproved: event Return.ReturnApproved is {
        send returnApproved to outlet ReturnEventSplitToOrderAnalytics
        tell returnApproved to entity OrderContext.Return
      }
      on returnDenied: event Return.ReturnDenied is {
        send returnDenied to outlet ReturnEventSplitToOrderAnalytics
        tell returnDenied to entity OrderContext.Return
      }
      on returnReceived: event Return.ReturnReceived is {
        send returnReceived to outlet ReturnEventSplitToOrderAnalytics
        tell returnReceived to entity OrderContext.Return
      }
      on refundProcessed: event Return.RefundProcessed is {
        send refundProcessed to outlet ReturnEventSplitToOrderAnalytics
        tell refundProcessed to entity OrderContext.Return
      }
      on other is {
        error "Unexpected message for processor ReturnEventSplit"
      }
    } with {
      briefly "Return event fan-out handler"
      described as {
        |Delivers each Return event to all of its consumers.
      }
    }
  } with {
    briefly "Return event fan-out"
    described as {
      |Fans Return events out to the repository and projectors.
    }
  }
  streamlet ShipmentEventSplit as split is {
    outlet ShipmentEventSplitToToShippingCarrier is type ShipmentStreamEvent
    outlet ShipmentEventSplitToToCustomerService is type ShipmentStreamEvent
    inlet ShipmentEventSplitIn is type ShipmentStreamEvent    outlet ShipmentEventSplitToOrderAnalytics is type ShipmentStreamEvent
    handler ShipmentEventSplitHandler is {
      on shipmentCreated: event Shipment.ShipmentCreated is {
        send shipmentCreated to outlet ShipmentEventSplitToOrderAnalytics
        send shipmentCreated to outlet ShipmentEventSplitToToShippingCarrier
        tell shipmentCreated to entity OrderContext.Shipment
      }
      on trackingUpdated: event Shipment.TrackingUpdated is {
        send trackingUpdated to outlet ShipmentEventSplitToOrderAnalytics
        tell trackingUpdated to entity OrderContext.Shipment
      }
      on shipmentDelivered: event Shipment.ShipmentDelivered is {
        send shipmentDelivered to outlet ShipmentEventSplitToOrderAnalytics
        tell shipmentDelivered to entity OrderContext.Shipment
      }
      on shipmentFailed: event Shipment.ShipmentFailed is {
        send shipmentFailed to outlet ShipmentEventSplitToOrderAnalytics
        send shipmentFailed to outlet ShipmentEventSplitToToCustomerService
        tell shipmentFailed to entity OrderContext.Shipment
      }
      on other is {
        error "Unexpected message for processor ShipmentEventSplit"
      }
    } with {
      briefly "Shipment event fan-out handler"
      described as {
        |Delivers each Shipment event to all of its consumers.
      }
    }
  } with {
    briefly "Shipment event fan-out"
    described as {
      |Fans Shipment events out to the repository and projectors.
    }
  }
  connector 'ToPaymentGateway Feed' is from outlet OrderContext.OrderEventSplit.OrderEventSplitToToPaymentGateway to inlet OrderContext.ToPaymentGateway.ToPaymentGatewayIn with {
    briefly "The Order events ToPaymentGateway translates, on their way to it"
  }
  connector 'ToInventoryService Feed' is from outlet OrderContext.OrderEventSplit.OrderEventSplitToToInventoryService to inlet OrderContext.ToInventoryService.ToInventoryServiceIn with {
    briefly "The Order events ToInventoryService translates, on their way to it"
  }
  connector 'ToShippingCarrier Order Feed' is from outlet OrderContext.OrderEventSplit.OrderEventSplitToToShippingCarrier to inlet OrderContext.ToShippingCarrier.ToShippingCarrierFromOrderIn with {
    briefly "The Order events ToShippingCarrier translates, on their way to it"
  }
  connector 'ToCustomerService Order Feed' is from outlet OrderContext.OrderEventSplit.OrderEventSplitToToCustomerService to inlet OrderContext.ToCustomerService.ToCustomerServiceFromOrderIn with {
    briefly "The Order events ToCustomerService translates, on their way to it"
  }
  connector 'OrderEvent Stream' is from outlet OrderContext.Order.OrderEvents2 to inlet OrderContext.OrderEventSplit.OrderEventSplitIn with {
    briefly "Order events, fanned out to storage and read models"
  }
  connector 'OrderEvent Feed' is from outlet OrderContext.OrderEventSplit.OrderEventSplitToOrderAnalytics to inlet OrderContext.OrderAnalytics.OrderAnalyticsFromOrder with {
    briefly "OrderEvent feeding the OrderAnalytics projection"
  }
  connector 'ReturnEvent Stream' is from outlet OrderContext.Return.ReturnEvents2 to inlet OrderContext.ReturnEventSplit.ReturnEventSplitIn with {
    briefly "Return events, fanned out to storage and read models"
  }
  connector 'ReturnEvent Feed' is from outlet OrderContext.ReturnEventSplit.ReturnEventSplitToOrderAnalytics to inlet OrderContext.OrderAnalytics.OrderAnalyticsFromReturn with {
    briefly "ReturnEvent feeding the OrderAnalytics projection"
  }
  connector 'ToShippingCarrier Shipment Feed' is from outlet OrderContext.ShipmentEventSplit.ShipmentEventSplitToToShippingCarrier to inlet OrderContext.ToShippingCarrier.ToShippingCarrierFromShipmentIn with {
    briefly "The Shipment events ToShippingCarrier translates, on their way to it"
  }
  connector 'ToCustomerService Shipment Feed' is from outlet OrderContext.ShipmentEventSplit.ShipmentEventSplitToToCustomerService to inlet OrderContext.ToCustomerService.ToCustomerServiceFromShipmentIn with {
    briefly "The Shipment events ToCustomerService translates, on their way to it"
  }
  connector 'ShipmentStreamEvent Stream' is from outlet OrderContext.Shipment.ShipmentEvents2 to inlet OrderContext.ShipmentEventSplit.ShipmentEventSplitIn with {
    briefly "Shipment events, fanned out to storage and read models"
  }
  connector 'ShipmentStreamEvent Feed' is from outlet OrderContext.ShipmentEventSplit.ShipmentEventSplitToOrderAnalytics to inlet OrderContext.OrderAnalytics.OrderAnalyticsFromShipment with {
    briefly "ShipmentStreamEvent feeding the OrderAnalytics projection"
  }
  connector 'OrderAnalytics Storage' is from outlet OrderContext.OrderAnalytics.OrderAnalyticsToRepository to inlet OrderContext.OrderRepository.OrderRepositoryFromOrderAnalytics with {
    briefly "OrderAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for order management"
  described as {
    | The OrderContext is the primary bounded context for the Order
    | Management domain. It contains all entities, sagas, and
    | integrations needed to manage the complete order lifecycle
    | from placement through delivery or return.
  }
}
