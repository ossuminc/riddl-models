// Order Management - Order Context
// The primary bounded context for order lifecycle management
context OrderContext as router is {
  connector 'ShippingAdapter Intake' is from outlet OrderContext.ShippingAdapter.ShippingAdapterToOrderContext to inlet OrderContext.OrderContextFromShippingAdapter with {
    briefly "ShippingAdapter messages on their way to OrderContext"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet OrderContextFromShippingAdapter is type OrderCommand with {
    briefly "What ShippingAdapter sends OrderContext"
    described as {
      |Its own inlet: an inlet accepts exactly one connector.
    }
  }
  connector 'InventoryAdapter Intake' is from outlet OrderContext.InventoryAdapter.InventoryAdapterToOrderContext to inlet OrderContext.OrderContextFromInventoryAdapter with {
    briefly "InventoryAdapter messages on their way to OrderContext"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet OrderContextFromInventoryAdapter is type OrderCommand with {
    briefly "What InventoryAdapter sends OrderContext"
    described as {
      |Its own inlet: an inlet accepts exactly one connector.
    }
  }
  connector 'PaymentAdapter Intake' is from outlet OrderContext.PaymentAdapter.PaymentAdapterToOrderContext to inlet OrderContext.OrderContextFromPaymentAdapter with {
    briefly "PaymentAdapter messages on their way to OrderContext"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet OrderContextFromPaymentAdapter is type OrderCommand with {
    briefly "What PaymentAdapter sends OrderContext"
    described as {
      |Its own inlet: an inlet accepts exactly one connector.
    }
  }
  inlet OrderCommandStreamIn is type OrderCommand  outlet OrderCommandStreamOut is type OrderCommand
  inlet ReturnCommandStreamIn is type ReturnCommand  outlet ReturnCommandStreamOut is type ReturnCommand
  inlet ShipmentCommandStreamIn is type ShipmentCommand  outlet ShipmentCommandStreamOut is type ShipmentCommand
  inlet MarketplaceOrderResultStreamIn is result Order.OrderResult  outlet MarketplaceOrderResultStreamOut is result Order.OrderResult
  handler OrderContextBoundary is {
    on placeOrder: command Order.PlaceOrder is {
      forward placeOrder to outlet OrderContext.OrderCommandStreamOut
    }
    on confirmPayment: command Order.ConfirmPayment is {
      forward confirmPayment to outlet OrderContext.OrderCommandStreamOut
    }
    on allocateInventory: command Order.AllocateInventory is {
      forward allocateInventory to outlet OrderContext.OrderCommandStreamOut
    }
    on shipOrder: command Order.ShipOrder is {
      forward shipOrder to outlet OrderContext.OrderCommandStreamOut
    }
    on deliverOrder: command Order.DeliverOrder is {
      forward deliverOrder to outlet OrderContext.OrderCommandStreamOut
    }
    on notifyCustomer: command Order.NotifyCustomer is {
      forward notifyCustomer to outlet OrderContext.OrderCommandStreamOut
    }
    on cancelOrder: command Order.CancelOrder is {
      forward cancelOrder to outlet OrderContext.OrderCommandStreamOut
    }
    on requestReturn: command Return.RequestReturn is {
      send requestReturn to outlet OrderContext.ReturnCommandStreamOut
    }
    on approveReturn: command Return.ApproveReturn is {
      send approveReturn to outlet OrderContext.ReturnCommandStreamOut
    }
    on denyReturn: command Return.DenyReturn is {
      send denyReturn to outlet OrderContext.ReturnCommandStreamOut
    }
    on receiveReturn: command Return.ReceiveReturn is {
      send receiveReturn to outlet OrderContext.ReturnCommandStreamOut
    }
    on initShipment: command Shipment.InitShipment is {
      forward initShipment to outlet OrderContext.ShipmentCommandStreamOut
    }
    on updateTracking: command Shipment.UpdateTracking is {
      forward updateTracking to outlet OrderContext.ShipmentCommandStreamOut
    }
    on markDelivered: command Shipment.MarkDelivered is {
      forward markDelivered to outlet OrderContext.ShipmentCommandStreamOut
    }
    on markFailed: command Shipment.MarkFailed is {
      forward markFailed to outlet OrderContext.ShipmentCommandStreamOut
    }
    on orderResult: result Order.OrderResult is {
      send orderResult to outlet OrderContext.MarketplaceOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the OrderContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'OrderCommand Stream Intake' is from outlet OrderContext.OrderCommandStreamOut to inlet OrderContext.Order.OrderCommands  connector 'ReturnCommand Stream Intake' is from outlet OrderContext.ReturnCommandStreamOut to inlet OrderContext.Return.ReturnCommands  connector 'ShipmentCommand Stream Intake' is from outlet OrderContext.ShipmentCommandStreamOut to inlet OrderContext.Shipment.ShipmentCommands  connector 'MarketplaceOrderResult Stream Egress' is from outlet OrderContext.OrderRepository.OrderRepositoryResponses to inlet OrderContext.MarketplaceOrderResultStreamIn  include "types.riddl"
  include "Order.riddl"
  include "Shipment.riddl"
  include "Return.riddl"
  include "OrderFulfillmentSaga.riddl"
  // Adaptors for external system integration
  adaptor ToShippingCarrier to context ShippingCarrier as merge is { 
    inlet ToShippingCarrierFromShipmentIn is type ShipmentStreamEvent    inlet ToShippingCarrierFromOrderIn is type OrderEvent    outlet ToShippingCarrierOut is type ShippingCarrier.ShippingCarrierCommand
    handler ToShippingCarrierHandler is {
      on shipmentCreated: event Shipment.ShipmentCreated is {
        let item0: type ShippingCarrier.CreateShipment = prompt("translate the shipmentCreated event into a CreateShipment, the shipment being what creates the need for a carrier")
        send item0 to outlet OrderContext.ToShippingCarrier.ToShippingCarrierOut
      }
      on orderCancelled: event Order.OrderCancelled is {
        let item0: type ShippingCarrier.CancelShipment = prompt("translate the orderCancelled event into a CancelShipment, cancellation being what ends it")
        send item0 to outlet OrderContext.ToShippingCarrier.ToShippingCarrierOut
      }
      on other is {
        error "Unexpected message for adaptor ToShippingCarrier"
      }
    } with {
      briefly "to shipping carrier"
      described as {
        |Carries messages to the external ShippingCarrier.
      }
    }
  } with {
    briefly "ShippingCarrier integration"
    described as {
      |The model's side of the ShippingCarrier conversation.
    }
  }
  adaptor ToInventoryService to context InventoryService as flow is { 
    inlet ToInventoryServiceIn is type OrderEvent    outlet ToInventoryServiceOut is type InventoryService.InventoryServiceCommand
    handler ToInventoryServiceHandler is {
      on orderPlaced: event Order.OrderPlaced is {
        let item0: type InventoryService.AllocateStock = prompt("translate the orderPlaced event into a AllocateStock, the order being what creates the claim on stock")
        send item0 to outlet OrderContext.ToInventoryService.ToInventoryServiceOut
      }
      on orderCancelled: event Order.OrderCancelled is {
        let item0: type InventoryService.ReleaseStock = prompt("translate the orderCancelled event into a ReleaseStock, cancellation being what ends it")
        send item0 to outlet OrderContext.ToInventoryService.ToInventoryServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryService"
      }
    } with {
      briefly "to inventory service"
      described as {
        |Carries messages to the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromCustomerService from context CustomerService as sink is { 
    inlet FromCustomerServiceIn is type CustomerService.CustomerServiceEvent    handler FromCustomerServiceHandler is {
      on notificationSent: event CustomerService.NotificationSent is {
        do "the customer has been told; the order's own state is unchanged"
      }
      on supportTicketCreated: event CustomerService.SupportTicketCreated is {
        do "support has the ticket; the order that raised it was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerService"
      }
    } with {
      briefly "from customer service"
      described as {
        |Carries messages from the external CustomerService.
      }
    }
  } with {
    briefly "CustomerService integration"
    described as {
      |The model's side of the CustomerService conversation.
    }
  }
  adaptor ToCustomerService to context CustomerService as merge is { 
    inlet ToCustomerServiceFromShipmentIn is type ShipmentStreamEvent    inlet ToCustomerServiceFromOrderIn is type OrderEvent    outlet ToCustomerServiceOut is type CustomerService.CustomerServiceCommand
    handler ToCustomerServiceHandler is {
      on orderPlaced: event Order.OrderPlaced is {
        let item0: type CustomerService.SendOrderConfirmation = prompt("translate the orderPlaced event into a SendOrderConfirmation, the customer needing to know their order stands")
        send item0 to outlet OrderContext.ToCustomerService.ToCustomerServiceOut
      }
      on orderCancelled: event Order.OrderCancelled is {
        let item0: type CustomerService.SendOrderCancellation = prompt("translate the orderCancelled event into a SendOrderCancellation, a cancellation being a terminal outcome they experience")
        send item0 to outlet OrderContext.ToCustomerService.ToCustomerServiceOut
      }
      on orderShipped: event Order.OrderShipped is {
        let item0: type CustomerService.SendShippingUpdate = prompt("translate the orderShipped event into a SendShippingUpdate, dispatch being when they must arrange to receive")
        send item0 to outlet OrderContext.ToCustomerService.ToCustomerServiceOut
      }
      on shipmentFailed: event Shipment.ShipmentFailed is {
        let item0: type CustomerService.CreateSupportTicket = prompt("translate the shipmentFailed event into a CreateSupportTicket, a failed delivery being a case nothing resolves without a person")
        send item0 to outlet OrderContext.ToCustomerService.ToCustomerServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerService"
      }
    } with {
      briefly "to customer service"
      described as {
        |Carries messages to the external CustomerService.
      }
    }
  } with {
    briefly "CustomerService integration"
    described as {
      |The model's side of the CustomerService conversation.
    }
  }
  adaptor ToPaymentGateway to context PaymentGateway as flow is { 
    inlet ToPaymentGatewayIn is type OrderEvent    outlet ToPaymentGatewayOut is type PaymentGateway.PaymentGatewayCommand
    handler ToPaymentGatewayHandler is {
      on orderPlaced: event Order.OrderPlaced is {
        let notice: type PaymentGateway.ProcessPayment = prompt("translate the orderPlaced event into a ProcessPayment taking payment for the order the customer has just committed to")
        send notice to outlet OrderContext.ToPaymentGateway.ToPaymentGatewayOut
      }
      on orderCancelled: event Order.OrderCancelled is {
        let notice: type PaymentGateway.RefundPayment = prompt("translate the orderCancelled event into a RefundPayment returning what was taken for the order whose commitment has just been released")
        send notice to outlet OrderContext.ToPaymentGateway.ToPaymentGatewayOut
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentGateway"
      }
    } with {
      briefly "to payment gateway"
      described as {
        |Carries messages to the external PaymentGateway.
      }
    }
  } with {
    briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor PaymentAdapter from context PaymentGateway as flow is { 
    inlet PaymentAdapterIn is type PaymentGateway.PaymentGatewayEvent    outlet PaymentAdapterToOrderContext is type OrderCommand
 with {
      briefly "What PaymentAdapter publishes to OrderContext"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to OrderContext needs this port to travel on.
      }
    }
    handler InboundPayments is {
      on paymentSucceeded: event PaymentGateway.PaymentSucceeded is {
        tell command ConfirmPayment(orderId = paymentSucceeded.orderId, transactionId = paymentSucceeded.transactionId, amountPaid = prompt("the amount paid of this confirm payment")) to context OrderContext
      }
      on event PaymentGateway.PaymentFailed is {
        do "Log payment failure and notify order processing"
      }
      on event PaymentGateway.RefundCompleted is {
        do "Update return status with refund confirmation"
      }
      on other is {
        error "Unexpected message for adaptor PaymentAdapter"
      }
    } with {
      briefly "Handles payment events from gateway"
      described as {
        |Processes inbound payment status events and routes to Order entity.
      }
    }
  } with {
    briefly "Translates payment gateway events"
    described as {
      | Receives payment status events from the external PaymentGateway
      | and translates them into commands for the Order entity.
    }
  }
  adaptor InventoryAdapter from context InventoryService as flow is { 
    inlet InventoryAdapterIn is type InventoryService.InventoryServiceEvent    outlet InventoryAdapterToOrderContext is type OrderCommand
 with {
      briefly "What InventoryAdapter publishes to OrderContext"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to OrderContext needs this port to travel on.
      }
    }
    handler InboundInventory is {
      on stockAllocated: event InventoryService.StockAllocated is {
        tell command AllocateInventory(orderId = stockAllocated.orderId, allocations = prompt("the allocations of this allocate inventory")) to context OrderContext
      }
      on event InventoryService.StockAllocationFailed is {
        do "Handle inventory shortage - may need to cancel or partial fulfill"
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles inventory events"
      described as {
        |Processes inventory allocation results from warehouse system.
      }
    }
  } with {
    briefly "Translates inventory service events"
    described as {
      | Receives stock allocation events from the InventoryService
      | and updates order status accordingly.
    }
  }
  adaptor ShippingAdapter from context ShippingCarrier as flow is { 
    inlet ShippingAdapterIn is type ShippingCarrier.ShippingCarrierEvent    outlet ShippingAdapterToOrderContext is type OrderCommand
 with {
      briefly "What ShippingAdapter publishes to OrderContext"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to OrderContext needs this port to travel on.
      }
    }
    handler InboundShipping is {
      on shipmentCreatedByCarrier: event ShippingCarrier.ShipmentCreatedByCarrier is {
        tell command Shipment.InitShipment(shipmentId = shipmentCreatedByCarrier.shipmentId, orderId = shipmentCreatedByCarrier.orderId, trackingNumber = shipmentCreatedByCarrier.trackingNumber, carrier = prompt("the carrier of this init shipment"), shippingAddress = prompt("the shipping address of this init shipment"), items = prompt("the items of this init shipment")) to context OrderContext
      }
      on shipmentPickedUp: event ShippingCarrier.ShipmentPickedUp is {
        tell command UpdateTracking(shipmentId = shipmentPickedUp.shipmentId, status = prompt("the status of this update tracking"), location = empty, description = prompt("the description of this update tracking")) to context OrderContext
      }
      on shipmentInTransit: event ShippingCarrier.ShipmentInTransit is {
        tell command UpdateTracking(shipmentId = shipmentInTransit.shipmentId, status = prompt("the status of this update tracking"), location = empty, description = prompt("the description of this update tracking")) to context OrderContext
      }
      on shipmentDeliveredByCarrier: event ShippingCarrier.ShipmentDeliveredByCarrier is {
        tell command MarkDelivered(shipmentId = shipmentDeliveredByCarrier.shipmentId, deliveredAt = shipmentDeliveredByCarrier.deliveredAt, signedBy = shipmentDeliveredByCarrier.signedBy) to context OrderContext
        tell command DeliverOrder(deliveredAt = shipmentDeliveredByCarrier.deliveredAt, signedBy = shipmentDeliveredByCarrier.signedBy, orderId = prompt("the order id of this deliver order")) to context OrderContext
      }
      on other is {
        error "Unexpected message for adaptor ShippingAdapter"
      }
    } with {
      briefly "Handles shipping carrier events"
      described as {
        |Processes carrier tracking webhooks and updates shipment status.
      }
    }
  } with {
    briefly "Translates shipping carrier events"
    described as {
      | Receives tracking updates from shipping carriers via webhooks
      | and updates both Shipment and Order entities.
    }
  }
  // Repository for order persistence
  type OrderRepositoryCommand is one of {
    OrderContext.OrderRepository.PersistCustomerNotified or OrderContext.OrderRepository.PersistInventoryAllocated or OrderContext.OrderRepository.PersistOrderCancelled or OrderContext.OrderRepository.PersistOrderDelivered or OrderContext.OrderRepository.PersistOrderPlaced or OrderContext.OrderRepository.PersistOrderShipped or OrderContext.OrderRepository.PersistPaymentConfirmed or OrderContext.OrderRepository.PersistRefundProcessed or OrderContext.OrderRepository.PersistReturnApproved or OrderContext.OrderRepository.PersistReturnDenied or OrderContext.OrderRepository.PersistReturnReceived or OrderContext.OrderRepository.PersistReturnRequested or OrderContext.OrderRepository.PersistShipmentCreated or OrderContext.OrderRepository.PersistShipmentDelivered or OrderContext.OrderRepository.PersistShipmentFailed or OrderContext.OrderRepository.PersistTrackingUpdated
  } with {
    briefly "Anything that writes the OrderRepository"
    described as {
      |The persistence commands OrderRepository accepts. Entity events never
      |reach it directly; the projector turns each event into one of these.
    }
  }
  repository OrderRepository as flow is {
    command PersistPaymentConfirmed is {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentConfirmed applies to.
        }
      }
      transactionId: String(1,100)? with {
        briefly "Transaction id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      amountPaid: Money? with {
        briefly "Amount paid"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      confirmedAt: TimeStamp? with {
        briefly "Confirmed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PaymentConfirmed"
      described as {
        |Instructs this repository to apply PaymentConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInventoryAllocated is {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryAllocated applies to.
        }
      }
      allItemsAllocated: Boolean? with {
        briefly "All items allocated"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      allocatedAt: TimeStamp? with {
        briefly "Allocated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist InventoryAllocated"
      described as {
        |Instructs this repository to apply InventoryAllocated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderShipped is {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderShipped applies to.
        }
      }
      shipmentId: ShipmentId? with {
        briefly "Shipment id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      carrier: CarrierCode? with {
        briefly "Carrier"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      trackingNumber: TrackingNumber? with {
        briefly "Tracking number"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      shippedAt: TimeStamp? with {
        briefly "Shipped at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist OrderShipped"
      described as {
        |Instructs this repository to apply OrderShipped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderDelivered is {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderDelivered applies to.
        }
      }
      deliveredAt: TimeStamp? with {
        briefly "Delivered at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      signedBy: String(1,100)? with {
        briefly "Signed by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist OrderDelivered"
      described as {
        |Instructs this repository to apply OrderDelivered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCustomerNotified is {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row CustomerNotified applies to.
        }
      }
      customerId: CustomerId? with {
        briefly "Customer id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      notifiedAt: TimeStamp? with {
        briefly "Notified at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CustomerNotified"
      described as {
        |Instructs this repository to apply CustomerNotified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnRequested is {
      returnId: ReturnId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnRequested applies to.
        }
      }
      orderId: OrderId? with {
        briefly "Order id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      customerId: CustomerId? with {
        briefly "Customer id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      returnItems: ReturnItemRecord+ with {
        briefly "Return items"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      returnReason: ReturnReason? with {
        briefly "Return reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      requestedAt: TimeStamp? with {
        briefly "Requested at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReturnRequested"
      described as {
        |Instructs this repository to apply ReturnRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnApproved is {
      returnId: ReturnId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnApproved applies to.
        }
      }
      approvedBy: String(1,100)? with {
        briefly "Approved by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      returnLabel: String(1,200)? with {
        briefly "Return label"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      approvedAt: TimeStamp? with {
        briefly "Approved at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReturnApproved"
      described as {
        |Instructs this repository to apply ReturnApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnDenied is {
      returnId: ReturnId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnDenied applies to.
        }
      }
      deniedBy: String(1,100)? with {
        briefly "Denied by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      deniedAt: TimeStamp? with {
        briefly "Denied at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReturnDenied"
      described as {
        |Instructs this repository to apply ReturnDenied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnReceived is {
      returnId: ReturnId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnReceived applies to.
        }
      }
      receivedAt: TimeStamp? with {
        briefly "Received at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      condition: String(1,200)? with {
        briefly "Condition"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      allItemsReceived: Boolean? with {
        briefly "All items received"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReturnReceived"
      described as {
        |Instructs this repository to apply ReturnReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentCreated is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShipmentCreated applies to.
        }
      }
      orderId: OrderId? with {
        briefly "Order id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      carrier: CarrierCode? with {
        briefly "Carrier"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      trackingNumber: TrackingNumber? with {
        briefly "Tracking number"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      shippingAddress: Address? with {
        briefly "Shipping address"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      items: OrderItemRecord+ with {
        briefly "Items"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ShipmentCreated"
      described as {
        |Instructs this repository to apply ShipmentCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
