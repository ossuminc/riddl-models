// Order Management - Order Context
// The primary bounded context for order lifecycle management
context OrderContext as router is {
  connector 'ShippingAdapter Intake' is from outlet OrderContext.ShippingAdapter.ShippingAdapterToOrderContext to inlet OrderContext.OrderContextFromShippingAdapter with {
    briefly "ShippingAdapter messages on their way to OrderContext"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet OrderContextFromShippingAdapter is type OrderCommand with {
    briefly "What ShippingAdapter sends OrderContext"
    described as {
      |Its own inlet: an inlet accepts exactly one connector.
    }
  }
  connector 'InventoryAdapter Intake' is from outlet OrderContext.InventoryAdapter.InventoryAdapterToOrderContext to inlet OrderContext.OrderContextFromInventoryAdapter with {
    briefly "InventoryAdapter messages on their way to OrderContext"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet OrderContextFromInventoryAdapter is type OrderCommand with {
    briefly "What InventoryAdapter sends OrderContext"
    described as {
      |Its own inlet: an inlet accepts exactly one connector.
    }
  }
  connector 'PaymentAdapter Intake' is from outlet OrderContext.PaymentAdapter.PaymentAdapterToOrderContext to inlet OrderContext.OrderContextFromPaymentAdapter with {
    briefly "PaymentAdapter messages on their way to OrderContext"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet OrderContextFromPaymentAdapter is type OrderCommand with {
    briefly "What PaymentAdapter sends OrderContext"
    described as {
      |Its own inlet: an inlet accepts exactly one connector.
    }
  }
  inlet OrderCommandStreamIn is type OrderCommand  outlet OrderCommandStreamOut is type OrderCommand
  inlet ReturnCommandStreamIn is type ReturnCommand  outlet ReturnCommandStreamOut is type ReturnCommand
  inlet ShipmentCommandStreamIn is type ShipmentCommand  outlet ShipmentCommandStreamOut is type ShipmentCommand
  inlet MarketplaceOrderResultStreamIn is result Order.OrderResult  outlet MarketplaceOrderResultStreamOut is result Order.OrderResult
  handler OrderContextBoundary is {
    on placeOrder: command Order.PlaceOrder is {
      forward placeOrder to outlet OrderContext.OrderCommandStreamOut
    }
    on confirmPayment: command Order.ConfirmPayment is {
      forward confirmPayment to outlet OrderContext.OrderCommandStreamOut
    }
    on allocateInventory: command Order.AllocateInventory is {
      forward allocateInventory to outlet OrderContext.OrderCommandStreamOut
    }
    on shipOrder: command Order.ShipOrder is {
      forward shipOrder to outlet OrderContext.OrderCommandStreamOut
    }
    on deliverOrder: command Order.DeliverOrder is {
      forward deliverOrder to outlet OrderContext.OrderCommandStreamOut
    }
    on notifyCustomer: command Order.NotifyCustomer is {
      forward notifyCustomer to outlet OrderContext.OrderCommandStreamOut
    }
    on cancelOrder: command Order.CancelOrder is {
      forward cancelOrder to outlet OrderContext.OrderCommandStreamOut
    }
    on requestReturn: command Return.RequestReturn is {
      send requestReturn to outlet OrderContext.ReturnCommandStreamOut
    }
    on approveReturn: command Return.ApproveReturn is {
      send approveReturn to outlet OrderContext.ReturnCommandStreamOut
    }
    on denyReturn: command Return.DenyReturn is {
      send denyReturn to outlet OrderContext.ReturnCommandStreamOut
    }
    on receiveReturn: command Return.ReceiveReturn is {
      send receiveReturn to outlet OrderContext.ReturnCommandStreamOut
    }
    on initShipment: command Shipment.InitShipment is {
      forward initShipment to outlet OrderContext.ShipmentCommandStreamOut
    }
    on updateTracking: command Shipment.UpdateTracking is {
      forward updateTracking to outlet OrderContext.ShipmentCommandStreamOut
    }
    on markDelivered: command Shipment.MarkDelivered is {
      forward markDelivered to outlet OrderContext.ShipmentCommandStreamOut
    }
    on markFailed: command Shipment.MarkFailed is {
      forward markFailed to outlet OrderContext.ShipmentCommandStreamOut
    }
    on orderResult: result Order.OrderResult is {
      send orderResult to outlet OrderContext.MarketplaceOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the OrderContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'OrderCommand Stream Intake' is from outlet OrderContext.OrderCommandStreamOut to inlet OrderContext.Order.OrderCommands  connector 'ReturnCommand Stream Intake' is from outlet OrderContext.ReturnCommandStreamOut to inlet OrderContext.Return.ReturnCommands  connector 'ShipmentCommand Stream Intake' is from outlet OrderContext.ShipmentCommandStreamOut to inlet OrderContext.Shipment.ShipmentCommands  connector 'MarketplaceOrderResult Stream Egress' is from outlet OrderContext.OrderRepository.OrderRepositoryResponses to inlet OrderContext.MarketplaceOrderResultStreamIn  include "types.riddl"
  include "Order.riddl"
  include "Shipment.riddl"
  include "Return.riddl"
  include "OrderFulfillmentSaga.riddl"
  // Adaptors for external system integration
  adaptor PaymentAdapter from context PaymentGateway as source is { 
    outlet PaymentAdapterToOrderContext is type OrderCommand
 with {
      briefly "What PaymentAdapter publishes to OrderContext"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to OrderContext needs this port to travel on.
      }
    }
    handler InboundPayments is {
      on paymentSucceeded: event PaymentGateway.PaymentSucceeded is {
        tell command ConfirmPayment(orderId = paymentSucceeded.orderId, transactionId = paymentSucceeded.transactionId, amountPaid = prompt("the amount paid of this confirm payment")) to context OrderContext
      }
      on event PaymentGateway.PaymentFailed is {
        do "Log payment failure and notify order processing"
      }
      on event PaymentGateway.RefundCompleted is {
        do "Update return status with refund confirmation"
      }
      on other is {
        error "Unexpected message for adaptor PaymentAdapter"
      }
    } with {
      briefly "Handles payment events from gateway"
      described as {
        |Processes inbound payment status events and routes to Order entity.
      }
    }
  } with {
    briefly "Translates payment gateway events"
    described as {
      | Receives payment status events from the external PaymentGateway
      | and translates them into commands for the Order entity.
    }
  }
  adaptor InventoryAdapter from context InventoryService as source is { 
    outlet InventoryAdapterToOrderContext is type OrderCommand
 with {
      briefly "What InventoryAdapter publishes to OrderContext"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to OrderContext needs this port to travel on.
      }
    }
    handler InboundInventory is {
      on stockAllocated: event InventoryService.StockAllocated is {
        tell command AllocateInventory(orderId = stockAllocated.orderId, allocations = prompt("the allocations of this allocate inventory")) to context OrderContext
      }
      on event InventoryService.StockAllocationFailed is {
        do "Handle inventory shortage - may need to cancel or partial fulfill"
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles inventory events"
      described as {
        |Processes inventory allocation results from warehouse system.
      }
    }
  } with {
    briefly "Translates inventory service events"
    described as {
      | Receives stock allocation events from the InventoryService
      | and updates order status accordingly.
    }
  }
  adaptor ShippingAdapter from context ShippingCarrier as source is { 
    outlet ShippingAdapterToOrderContext is type OrderCommand
 with {
      briefly "What ShippingAdapter publishes to OrderContext"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to OrderContext needs this port to travel on.
      }
    }
    handler InboundShipping is {
      on shipmentCreatedByCarrier: event ShippingCarrier.ShipmentCreatedByCarrier is {
        tell command Shipment.InitShipment(shipmentId = shipmentCreatedByCarrier.shipmentId, orderId = shipmentCreatedByCarrier.orderId, trackingNumber = shipmentCreatedByCarrier.trackingNumber, carrier = prompt("the carrier of this init shipment"), shippingAddress = prompt("the shipping address of this init shipment"), items = prompt("the items of this init shipment")) to context OrderContext
      }
      on shipmentPickedUp: event ShippingCarrier.ShipmentPickedUp is {
        tell command UpdateTracking(shipmentId = shipmentPickedUp.shipmentId, status = prompt("the status of this update tracking"), location = empty, description = prompt("the description of this update tracking")) to context OrderContext
      }
      on shipmentInTransit: event ShippingCarrier.ShipmentInTransit is {
        tell command UpdateTracking(shipmentId = shipmentInTransit.shipmentId, status = prompt("the status of this update tracking"), location = empty, description = prompt("the description of this update tracking")) to context OrderContext
      }
      on shipmentDeliveredByCarrier: event ShippingCarrier.ShipmentDeliveredByCarrier is {
        tell command MarkDelivered(shipmentId = shipmentDeliveredByCarrier.shipmentId, deliveredAt = shipmentDeliveredByCarrier.deliveredAt, signedBy = shipmentDeliveredByCarrier.signedBy) to context OrderContext
        tell command DeliverOrder(deliveredAt = shipmentDeliveredByCarrier.deliveredAt, signedBy = shipmentDeliveredByCarrier.signedBy, orderId = prompt("the order id of this deliver order")) to context OrderContext
      }
      on other is {
        error "Unexpected message for adaptor ShippingAdapter"
      }
    } with {
      briefly "Handles shipping carrier events"
      described as {
        |Processes carrier tracking webhooks and updates shipment status.
      }
    }
  } with {
    briefly "Translates shipping carrier events"
    described as {
      | Receives tracking updates from shipping carriers via webhooks
      | and updates both Shipment and Order entities.
    }
  }
  // Repository for order persistence
  type OrderRepositoryCommand is one of {
    OrderContext.OrderRepository.PersistCustomerNotified or OrderContext.OrderRepository.PersistInventoryAllocated or OrderContext.OrderRepository.PersistOrderCancelled or OrderContext.OrderRepository.PersistOrderDelivered or OrderContext.OrderRepository.PersistOrderPlaced or OrderContext.OrderRepository.PersistOrderShipped or OrderContext.OrderRepository.PersistPaymentConfirmed or OrderContext.OrderRepository.PersistRefundProcessed or OrderContext.OrderRepository.PersistReturnApproved or OrderContext.OrderRepository.PersistReturnDenied or OrderContext.OrderRepository.PersistReturnReceived or OrderContext.OrderRepository.PersistReturnRequested or OrderContext.OrderRepository.PersistShipmentCreated or OrderContext.OrderRepository.PersistShipmentDelivered or OrderContext.OrderRepository.PersistShipmentFailed or OrderContext.OrderRepository.PersistTrackingUpdated
  } with {
    briefly "Anything that writes the OrderRepository"
    described as {
      |The persistence commands OrderRepository accepts. Entity events never
      |reach it directly; the projector turns each event into one of these.
    }
  }
  repository OrderRepository as flow is {
    command PersistPaymentConfirmed is {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentConfirmed applies to.
        }
      }
    } with {
      briefly "Persist PaymentConfirmed"
      described as {
        |Instructs this repository to apply PaymentConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInventoryAllocated is {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryAllocated applies to.
        }
      }
    } with {
      briefly "Persist InventoryAllocated"
      described as {
        |Instructs this repository to apply InventoryAllocated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderShipped is {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderShipped applies to.
        }
      }
    } with {
      briefly "Persist OrderShipped"
      described as {
        |Instructs this repository to apply OrderShipped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderDelivered is {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderDelivered applies to.
        }
      }
    } with {
      briefly "Persist OrderDelivered"
      described as {
        |Instructs this repository to apply OrderDelivered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCustomerNotified is {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row CustomerNotified applies to.
        }
      }
    } with {
      briefly "Persist CustomerNotified"
      described as {
        |Instructs this repository to apply CustomerNotified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnRequested is {
      returnId: ReturnId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnRequested applies to.
        }
      }
    } with {
      briefly "Persist ReturnRequested"
      described as {
        |Instructs this repository to apply ReturnRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnApproved is {
      returnId: ReturnId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnApproved applies to.
        }
      }
    } with {
      briefly "Persist ReturnApproved"
      described as {
        |Instructs this repository to apply ReturnApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnDenied is {
      returnId: ReturnId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnDenied applies to.
        }
      }
    } with {
      briefly "Persist ReturnDenied"
      described as {
        |Instructs this repository to apply ReturnDenied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnReceived is {
      returnId: ReturnId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnReceived applies to.
        }
      }
    } with {
      briefly "Persist ReturnReceived"
      described as {
        |Instructs this repository to apply ReturnReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentCreated is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShipmentCreated applies to.
        }
      }
    } with {
      briefly "Persist ShipmentCreated"
      described as {
        |Instructs this repository to apply ShipmentCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrackingUpdated is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrackingUpdated applies to.
        }
      }
    } with {
      briefly "Persist TrackingUpdated"
      described as {
        |Instructs this repository to apply TrackingUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentDelivered is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShipmentDelivered applies to.
        }
      }
    } with {
      briefly "Persist ShipmentDelivered"
      described as {
        |Instructs this repository to apply ShipmentDelivered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentFailed is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShipmentFailed applies to.
        }
      }
    } with {
      briefly "Persist ShipmentFailed"
      described as {
        |Instructs this repository to apply ShipmentFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet OrderRepositoryFromOrderAnalytics is type OrderRepositoryCommand    command PersistOrderCancelled is {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCancelled applies to.
        }
      }
    } with {
      briefly "Persist OrderCancelled"
      described as {
        |Instructs this repository to apply OrderCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderPlaced is {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderPlaced applies to.
        }
      }
    } with {
      briefly "Persist OrderPlaced"
      described as {
        |Instructs this repository to apply OrderPlaced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRefundProcessed is {
      returnId: ReturnId with {
        briefly "Row addressed"
        described as {
          |Which stored row RefundProcessed applies to.
        }
      }
    } with {
      briefly "Persist RefundProcessed"
      described as {
        |Instructs this repository to apply RefundProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet OrderRepositoryResponses is result Order.OrderResult
    record StoredOrder is {
      orderId: OrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored order row.
        }
      }
      customerId: CustomerId with {
        briefly "customerId"
        described as {
          |The customerId column of the stored order row.
        }
      }
    } with {
      briefly "Stored order row"
      described as {
        |The persistence shape of order data as this repository stores it.
      }
    }
    record StoredReturn is {
      returnId: ReturnId with {
        briefly "returnId"
        described as {
          |The returnId column of the stored return row.
        }
      }
      orderId: OrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored return row.
        }
      }
    } with {
      briefly "Stored return row"
      described as {
        |The persistence shape of return data as this repository stores it.
      }
    }
    record StoredShipment is {
      shipmentId: ShipmentId with {
        briefly "shipmentId"
        described as {
          |The shipmentId column of the stored shipment row.
        }
      }
      orderId: OrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored shipment row.
        }
      }
    } with {
      briefly "Stored shipment row"
      described as {
        |The persistence shape of shipment data as this repository stores it.
      }
    }
    schema OrderData is relational
      of orders as record StoredOrder
      of returns as record StoredReturn
      of shipments as record StoredShipment
        link orderReturns as field StoredOrder.orderId to field StoredReturn.orderId
        link orderShipments as field StoredOrder.orderId to field StoredShipment.orderId
        index on field StoredOrder.customerId
 with {
      briefly "Order data schema"
      described as {
        |The relational schema holding order data for the OrderRepository.
      }
    }
    handler OrderPersistence is {
      on persistPaymentConfirmed: command PersistPaymentConfirmed is {
        do "apply PaymentConfirmed to the stored row"
      }
      on persistInventoryAllocated: command PersistInventoryAllocated is {
        do "apply InventoryAllocated to the stored row"
      }
      on persistOrderShipped: command PersistOrderShipped is {
        do "apply OrderShipped to the stored row"
      }
      on persistOrderDelivered: command PersistOrderDelivered is {
        do "apply OrderDelivered to the stored row"
      }
      on persistCustomerNotified: command PersistCustomerNotified is {
        do "apply CustomerNotified to the stored row"
      }
      on persistReturnRequested: command PersistReturnRequested is {
        do "apply ReturnRequested to the stored row"
      }
      on persistReturnApproved: command PersistReturnApproved is {
        do "apply ReturnApproved to the stored row"
      }
      on persistReturnDenied: command PersistReturnDenied is {
        do "apply ReturnDenied to the stored row"
      }
      on persistReturnReceived: command PersistReturnReceived is {
        do "apply ReturnReceived to the stored row"
      }
      on persistShipmentCreated: command PersistShipmentCreated is {
        do "apply ShipmentCreated to the stored row"
      }
      on persistTrackingUpdated: command PersistTrackingUpdated is {
        do "apply TrackingUpdated to the stored row"
      }
      on persistShipmentDelivered: command PersistShipmentDelivered is {
        do "apply ShipmentDelivered to the stored row"
      }
      on persistShipmentFailed: command PersistShipmentFailed is {
        do "apply ShipmentFailed to the stored row"
      }
      on persistOrderCancelled: command PersistOrderCancelled is {
        do "apply OrderCancelled to the stored row"
      }
      on persistOrderPlaced: command PersistOrderPlaced is {
        do "apply OrderPlaced to the stored row"
      }
      on persistRefundProcessed: command PersistRefundProcessed is {
        do "apply RefundProcessed to the stored row"
      }
      on query GetDailyOrderMetrics is {
        let dailyOrderMetricsView: type DailyOrderMetricsView = prompt("read the daily order metrics projection")
        reply dailyOrderMetricsView
      }
      on processRefund: command Return.ProcessRefund is {
        tell event Return.RefundProcessed(returnId = processRefund.returnId, refundAmount = processRefund.refundAmount, refundMethod = processRefund.refundMethod, orderId = prompt("the order id of this refund processed"), processedAt = prompt("the processed at of this refund processed")) to entity OrderContext.Return
        do "Update order with refund information"
      }
    } with {
      briefly "Persists order data via commands"
      described as {
        |Handles command-driven persistence operations for orders.
      }
    }
  } with {
    briefly "Persistent storage for order data"
    described as {
      | The OrderRepository provides persistent storage for orders,
      | shipments, and returns with appropriate indexes for query
      | performance on common access patterns.
    }
  }
  // Projector for order analytics
  query GetDailyOrderMetrics replies result DailyOrderMetricsView is {
    dailyOrderMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily order metrics to retrieve.
      }
    }
  } with {
    briefly "Get daily order metrics"
    described as {
      |Retrieves the daily order metrics projection.
    }
  }
  result DailyOrderMetricsView is {
    dailyOrderMetrics: OrderAnalytics.DailyOrderMetrics with {
      briefly "Daily order metrics"
      described as {
        |The daily order metrics being returned.
      }
    }
  } with {
    briefly "Daily order metrics view"
    described as {
      |Read model view carrying the daily order metrics projection.
    }
  }
  projector OrderAnalytics as merge is {
    updates repository OrderContext.OrderRepository
    outlet OrderAnalyticsToRepository is type OrderRepositoryCommand
    inlet OrderAnalyticsFromOrder is type OrderEvent    inlet OrderAnalyticsFromReturn is type ReturnEvent    inlet OrderAnalyticsFromShipment is type ShipmentStreamEvent    record DailyOrderMetrics is {
      date: Date with {
        briefly "Date"
        described as {
          |The date for these metrics.
        }
      }
      orderCount: Natural with {
        briefly "Orders"
        described as {
          |Number of orders.
        }
      }
      totalRevenue: Money with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageOrderValue: Money with {
        briefly "AOV"
        described as {
          |Average order value.
        }
      }
      cancellationCount: Natural with {
        briefly "Cancellations"
        described as {
          |Orders cancelled.
        }
      }
      refundCount: Natural with {
        briefly "Refunds"
        described as {
          |Refunds processed.
        }
      }
      refundTotal: Money with {
        briefly "Refund total"
        described as {
          |Total refunded.
        }
      }
    } with {
      briefly "Daily aggregated order metrics"
      described as {
        |Aggregated order statistics for a single day.
      }
    }
    handler AnalyticsHandler is {
      on paymentConfirmed: event Order.PaymentConfirmed is {
        tell command OrderContext.OrderRepository.PersistPaymentConfirmed(orderId = paymentConfirmed.orderId) to repository OrderContext.OrderRepository
        do "Count the order as paid in the day's confirmed revenue"
      }
      on inventoryAllocated: event Order.InventoryAllocated is {
        tell command OrderContext.OrderRepository.PersistInventoryAllocated(orderId = inventoryAllocated.orderId) to repository OrderContext.OrderRepository
        do "Record the stock reservation for the allocation-latency measure"
      }
      on orderShipped: event Order.OrderShipped is {
        tell command OrderContext.OrderRepository.PersistOrderShipped(orderId = orderShipped.orderId) to repository OrderContext.OrderRepository
        do "Advance the order to shipped in the daily fulfilment funnel"
      }
      on orderDelivered: event Order.OrderDelivered is {
        tell command OrderContext.OrderRepository.PersistOrderDelivered(orderId = orderDelivered.orderId) to repository OrderContext.OrderRepository
        do "Close the fulfilment funnel and record time-to-deliver"
      }
      on customerNotified: event Order.CustomerNotified is {
        tell command OrderContext.OrderRepository.PersistCustomerNotified(orderId = customerNotified.orderId) to repository OrderContext.OrderRepository
        do "Count the notification against the day's customer-contact volume"
      }
      on returnRequested: event Return.ReturnRequested is {
        tell command OrderContext.OrderRepository.PersistReturnRequested(returnId = returnRequested.returnId) to repository OrderContext.OrderRepository
        do "Open a return in the day's return counts"
      }
      on returnApproved: event Return.ReturnApproved is {
        tell command OrderContext.OrderRepository.PersistReturnApproved(returnId = returnApproved.returnId) to repository OrderContext.OrderRepository
        do "Move the return from requested to approved in the return funnel"
      }
      on returnDenied: event Return.ReturnDenied is {
        tell command OrderContext.OrderRepository.PersistReturnDenied(returnId = returnDenied.returnId) to repository OrderContext.OrderRepository
        do "Record the denial, ending this return's contribution to refund totals"
      }
      on returnReceived: event Return.ReturnReceived is {
        tell command OrderContext.OrderRepository.PersistReturnReceived(returnId = returnReceived.returnId) to repository OrderContext.OrderRepository
        do "Record physical receipt, the point a refund becomes payable"
      }
      on shipmentCreated: event Shipment.ShipmentCreated is {
        tell command OrderContext.OrderRepository.PersistShipmentCreated(shipmentId = shipmentCreated.shipmentId) to repository OrderContext.OrderRepository
        do "Start tracking this shipment in the day's in-transit count"
      }
      on trackingUpdated: event Shipment.TrackingUpdated is {
        tell command OrderContext.OrderRepository.PersistTrackingUpdated(shipmentId = trackingUpdated.shipmentId) to repository OrderContext.OrderRepository
        do "Refresh shipment progress without changing the in-transit count"
      }
      on shipmentDelivered: event Shipment.ShipmentDelivered is {
        tell command OrderContext.OrderRepository.PersistShipmentDelivered(shipmentId = shipmentDelivered.shipmentId) to repository OrderContext.OrderRepository
        do "Remove from in-transit and count the shipment delivered"
      }
      on shipmentFailed: event Shipment.ShipmentFailed is {
        tell command OrderContext.OrderRepository.PersistShipmentFailed(shipmentId = shipmentFailed.shipmentId) to repository OrderContext.OrderRepository
        do "Remove from in-transit and count the shipment failed"
      }
      on orderPlaced: event Order.OrderPlaced is {
        tell command OrderContext.OrderRepository.PersistOrderPlaced(orderId = orderPlaced.orderId) to repository OrderContext.OrderRepository
        do "Update daily order counts and revenue metrics"
      }
      on orderCancelled: event Order.OrderCancelled is {
        tell command OrderContext.OrderRepository.PersistOrderCancelled(orderId = orderCancelled.orderId) to repository OrderContext.OrderRepository
        do "Update cancellation rate metrics"
      }
      on refundProcessed: event Return.RefundProcessed is {
        tell command OrderContext.OrderRepository.PersistRefundProcessed(returnId = refundProcessed.returnId) to repository OrderContext.OrderRepository
        do "Update refund metrics and return rates"
      }
    } with {
      briefly "Projects order events for analytics"
      described as {
        |Processes order events to maintain aggregate metrics.
      }
    }
  } with {
    briefly "Projects order events for reporting"
    described as {
      | Maintains aggregated views of order data for dashboards
      | and business intelligence reporting.
    }
  }
  // ---- Event publication for Order ----
  type OrderEvent is one of {
    OrderContext.Order.OrderPlaced or OrderContext.Order.PaymentConfirmed or OrderContext.Order.InventoryAllocated or OrderContext.Order.OrderShipped or OrderContext.Order.OrderDelivered or OrderContext.Order.CustomerNotified or OrderContext.Order.OrderCancelled
  } with {
    briefly "Order event alternation"
    described as {
      |Union of all Order events, for streaming and event-sourced
      |persistence.
    }
  }
  // ---- Event publication for Shipment ----
  type ShipmentStreamEvent is one of {
    OrderContext.Shipment.ShipmentCreated or OrderContext.Shipment.TrackingUpdated or OrderContext.Shipment.ShipmentDelivered or OrderContext.Shipment.ShipmentFailed
  } with {
    briefly "Shipment event alternation"
    described as {
      |Union of all Shipment events, for streaming and event-sourced
      |persistence.
    }
  }
  // ---- Event publication for Return ----
  type ReturnEvent is one of {
    OrderContext.Return.ReturnRequested or OrderContext.Return.ReturnApproved or OrderContext.Return.ReturnDenied or OrderContext.Return.ReturnReceived or OrderContext.Return.RefundProcessed
  } with {
    briefly "Return event alternation"
    described as {
      |Union of all Return events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet OrderEventSplit as flow is {
    inlet OrderEventSplitIn is type OrderEvent    outlet OrderEventSplitToOrderAnalytics is type OrderEvent
    handler OrderEventSplitHandler is {
      on orderPlaced: event Order.OrderPlaced is {
        send orderPlaced to outlet OrderEventSplitToOrderAnalytics
        tell orderPlaced to entity OrderContext.Order
      }
      on paymentConfirmed: event Order.PaymentConfirmed is {
        send paymentConfirmed to outlet OrderEventSplitToOrderAnalytics
        tell paymentConfirmed to entity OrderContext.Order
      }
      on inventoryAllocated: event Order.InventoryAllocated is {
        send inventoryAllocated to outlet OrderEventSplitToOrderAnalytics
        tell inventoryAllocated to entity OrderContext.Order
      }
      on orderShipped: event Order.OrderShipped is {
        send orderShipped to outlet OrderEventSplitToOrderAnalytics
        tell orderShipped to entity OrderContext.Order
      }
      on orderDelivered: event Order.OrderDelivered is {
        send orderDelivered to outlet OrderEventSplitToOrderAnalytics
        tell orderDelivered to entity OrderContext.Order
      }
      on orderCancelled: event Order.OrderCancelled is {
        send orderCancelled to outlet OrderEventSplitToOrderAnalytics
        tell orderCancelled to entity OrderContext.Order
      }
      on other is {
        error "Unexpected message for processor OrderEventSplit"
      }
    } with {
      briefly "Order event fan-out handler"
      described as {
        |Delivers each Order event to all of its consumers.
      }
    }
  } with {
    briefly "Order event fan-out"
    described as {
      |Fans Order events out to the repository and projectors.
    }
  }
  streamlet ReturnEventSplit as flow is {
    inlet ReturnEventSplitIn is type ReturnEvent    outlet ReturnEventSplitToOrderAnalytics is type ReturnEvent
    handler ReturnEventSplitHandler is {
      on returnRequested: event Return.ReturnRequested is {
        send returnRequested to outlet ReturnEventSplitToOrderAnalytics
        tell returnRequested to entity OrderContext.Return
      }
      on returnApproved: event Return.ReturnApproved is {
        send returnApproved to outlet ReturnEventSplitToOrderAnalytics
        tell returnApproved to entity OrderContext.Return
      }
      on returnDenied: event Return.ReturnDenied is {
        send returnDenied to outlet ReturnEventSplitToOrderAnalytics
        tell returnDenied to entity OrderContext.Return
      }
      on returnReceived: event Return.ReturnReceived is {
        send returnReceived to outlet ReturnEventSplitToOrderAnalytics
        tell returnReceived to entity OrderContext.Return
      }
      on refundProcessed: event Return.RefundProcessed is {
        send refundProcessed to outlet ReturnEventSplitToOrderAnalytics
        tell refundProcessed to entity OrderContext.Return
      }
      on other is {
        error "Unexpected message for processor ReturnEventSplit"
      }
    } with {
      briefly "Return event fan-out handler"
      described as {
        |Delivers each Return event to all of its consumers.
      }
    }
  } with {
    briefly "Return event fan-out"
    described as {
      |Fans Return events out to the repository and projectors.
    }
  }
  streamlet ShipmentEventSplit as flow is {
    inlet ShipmentEventSplitIn is type ShipmentStreamEvent    outlet ShipmentEventSplitToOrderAnalytics is type ShipmentStreamEvent
    handler ShipmentEventSplitHandler is {
      on shipmentCreated: event Shipment.ShipmentCreated is {
        send shipmentCreated to outlet ShipmentEventSplitToOrderAnalytics
        tell shipmentCreated to entity OrderContext.Shipment
      }
      on trackingUpdated: event Shipment.TrackingUpdated is {
        send trackingUpdated to outlet ShipmentEventSplitToOrderAnalytics
        tell trackingUpdated to entity OrderContext.Shipment
      }
      on shipmentDelivered: event Shipment.ShipmentDelivered is {
        send shipmentDelivered to outlet ShipmentEventSplitToOrderAnalytics
        tell shipmentDelivered to entity OrderContext.Shipment
      }
      on shipmentFailed: event Shipment.ShipmentFailed is {
        send shipmentFailed to outlet ShipmentEventSplitToOrderAnalytics
        tell shipmentFailed to entity OrderContext.Shipment
      }
      on other is {
        error "Unexpected message for processor ShipmentEventSplit"
      }
    } with {
      briefly "Shipment event fan-out handler"
      described as {
        |Delivers each Shipment event to all of its consumers.
      }
    }
  } with {
    briefly "Shipment event fan-out"
    described as {
      |Fans Shipment events out to the repository and projectors.
    }
  }
  connector 'OrderEvent Stream' is from outlet OrderContext.Order.OrderEvents2 to inlet OrderContext.OrderEventSplit.OrderEventSplitIn with {
    briefly "Order events, fanned out to storage and read models"
  }
  connector 'OrderEvent Feed' is from outlet OrderContext.OrderEventSplit.OrderEventSplitToOrderAnalytics to inlet OrderContext.OrderAnalytics.OrderAnalyticsFromOrder with {
    briefly "OrderEvent feeding the OrderAnalytics projection"
  }
  connector 'ReturnEvent Stream' is from outlet OrderContext.Return.ReturnEvents2 to inlet OrderContext.ReturnEventSplit.ReturnEventSplitIn with {
    briefly "Return events, fanned out to storage and read models"
  }
  connector 'ReturnEvent Feed' is from outlet OrderContext.ReturnEventSplit.ReturnEventSplitToOrderAnalytics to inlet OrderContext.OrderAnalytics.OrderAnalyticsFromReturn with {
    briefly "ReturnEvent feeding the OrderAnalytics projection"
  }
  connector 'ShipmentStreamEvent Stream' is from outlet OrderContext.Shipment.ShipmentEvents2 to inlet OrderContext.ShipmentEventSplit.ShipmentEventSplitIn with {
    briefly "Shipment events, fanned out to storage and read models"
  }
  connector 'ShipmentStreamEvent Feed' is from outlet OrderContext.ShipmentEventSplit.ShipmentEventSplitToOrderAnalytics to inlet OrderContext.OrderAnalytics.OrderAnalyticsFromShipment with {
    briefly "ShipmentStreamEvent feeding the OrderAnalytics projection"
  }
  connector 'OrderAnalytics Storage' is from outlet OrderContext.OrderAnalytics.OrderAnalyticsToRepository to inlet OrderContext.OrderRepository.OrderRepositoryFromOrderAnalytics with {
    briefly "OrderAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for order management"
  described as {
    | The OrderContext is the primary bounded context for the Order
    | Management domain. It contains all entities, sagas, and
    | integrations needed to manage the complete order lifecycle
    | from placement through delivery or return.
  }
}
