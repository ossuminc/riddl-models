// Order Management - Order Fulfillment Saga
// Orchestrates the complete order lifecycle with compensation
record OrderFulfillmentSagaArgs is  {
  orderId: OrderId
  customerId: CustomerId
  items: OrderItemRecord+
  total: Money
  paymentMethod: PaymentMethod
  shippingAddress: Address
} with {
  briefly "Order fulfillment saga input"
  described as {
    |Input required to start the order fulfillment saga.
  }
}
record OrderFulfillmentSagaResult is  {
  success: Boolean
  shipmentId: ShipmentId?
  trackingNumber: TrackingNumber?
  errorReason: String(1,500)?
} with {
  briefly "Order fulfillment saga output"
  described as {
    |Outcome of the order fulfillment saga, including the
    |shipment identifiers on success or a reason on failure.
  }
}
saga OrderFulfillmentSaga is {
  requires record OrderFulfillmentSagaArgs
  returns  record OrderFulfillmentSagaResult
  step StepProcessPayment is  {
    do "Submit payment request to PaymentGateway context"
    do "Wait for payment confirmation or failure"
    let confirmPayment: type ConfirmPayment = prompt("the confirm payment for this this")
    tell confirmPayment to entity Order
  }
  reverted by {
    do "Request refund from PaymentGateway"
    let cancelOrder: type CancelOrder = prompt("the cancel order for this this")
    tell cancelOrder to entity Order
  }
 with {
    briefly "Process customer payment"
    described as {
      | Submits the payment to the external payment gateway.
      | If payment fails, the saga terminates with failure.
      | If later steps fail, the payment is refunded.
    }
  }
  step StepAllocateInventory is  {
    do "Request inventory allocation from InventoryService"
    do "Reserve stock for all order items"
    let allocateInventory: type AllocateInventory = prompt("the allocate inventory for this this")
    tell allocateInventory to entity Order
  }
  reverted by {
    do "Release reserved inventory back to available stock"
    let cancelOrder: type CancelOrder = prompt("the cancel order for this this")
    tell cancelOrder to entity Order
  }
 with {
    briefly "Reserve inventory for order items"
    described as {
      | Reserves inventory for each item in the order.
      | If allocation fails, payment is refunded and saga terminates.
      | If later steps fail, inventory is released.
    }
  }
  step StepCreateShipment is  {
    do "Create shipment request with ShippingCarrier"
    do "Obtain tracking number and estimated delivery"
    let shipOrder: type ShipOrder = prompt("the ship order for this this")
    tell shipOrder to entity Order
  }
  reverted by {
    do "Cancel the shipment with the carrier if not yet picked up"
    let cancelOrder: type CancelOrder = prompt("the cancel order for this this")
    tell cancelOrder to entity Order
  }
 with {
    briefly "Create shipment with carrier"
    described as {
      | Creates a shipment with the shipping carrier.
      | If shipment creation fails, inventory is released and payment refunded.
    }
  }
  step StepNotifyCustomer is  {
    do "Send order confirmation and tracking info to customer"
    let notifyCustomer: type NotifyCustomer = prompt("the notify customer for this this")
    tell notifyCustomer to entity Order
  }
  reverted by {
    do "Send order cancellation notification to customer"
    let notifyCustomer: type NotifyCustomer = prompt("the notify customer for this this")
    tell notifyCustomer to entity Order
  }
 with {
    briefly "Send confirmation to customer"
    described as {
      | Notifies the customer that their order is confirmed and shipping.
      | If this fails, it's logged but doesn't fail the order.
    }
  }
} with {
  briefly "Orchestrates order fulfillment workflow"
  described as {
    | The OrderFulfillmentSaga coordinates the complete order processing
    | workflow including payment, inventory allocation, shipment creation,
    | and customer notification. Each step has compensation logic to handle
    | failures gracefully and maintain system consistency.
  }
}
