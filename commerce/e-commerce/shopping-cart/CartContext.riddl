// Shopping Cart - Cart Context
context CartContext is {
  adaptor FromCustomerService from context CustomerService is { 
    handler FromCustomerServiceHandler is {
      on event CustomerService.CustomerAuthenticated is {
        do "the model receives customer authenticated"
      }
      on event CustomerService.CustomerLoggedOut is {
        do "the model receives customer logged out"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerService"
      }
    } with {
      briefly "from customer service"
      described as {
        |Carries messages from the external CustomerService.
      }
    }
  } with {
    briefly "CustomerService integration"
    described as {
      |The model's side of the CustomerService conversation.
    }
  }
  adaptor FromInventoryService from context InventoryService is { 
    handler FromInventoryServiceHandler is {
      on event InventoryService.StockReserved is {
        do "the model receives stock reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
    handler InventoryEvents is {
      on event InventoryService.StockDepleted is {
        tell command Cart.RemoveItem to entity CartContext.Cart
      }
      on event InventoryService.StockReplenished is {
        tell command Cart.AddItem to entity CartContext.Cart
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles inventory events"
      described as {
        |Processes stock level updates for cart items.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromOrderService from context OrderService is { 
    handler FromOrderServiceHandler is {
      on event OrderService.OrderCreated is {
        do "the model receives order created"
      }
      on other is {
        error "Unexpected message for adaptor FromOrderService"
      }
    } with {
      briefly "from order service"
      described as {
        |Carries messages from the external OrderService.
      }
    }
  } with {
    briefly "OrderService integration"
    described as {
      |The model's side of the OrderService conversation.
    }
  }
  adaptor FromPricingService from context PricingService is { 
    handler FromPricingServiceHandler is {
      on event PricingService.PromotionDeactivated is {
        do "the model receives promotion deactivated"
      }
      on other is {
        error "Unexpected message for adaptor FromPricingService"
      }
    } with {
      briefly "from pricing service"
      described as {
        |Carries messages from the external PricingService.
      }
    }
    handler PricingEvents is {
      on event PricingService.PriceChanged is {
        tell command Cart.UpdateQuantity to entity CartContext.Cart
      }
      on event PricingService.PromotionActivated is {
        tell command Cart.ApplyPromoCode to entity CartContext.Cart
      }
      on other is {
        error "Unexpected message for adaptor PricingAdapter"
      }
    } with {
      briefly "Handles pricing events"
      described as {
        |Processes price and promotion updates.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  include "types.riddl"
  include "Cart.riddl"
  // Adaptors for external system integration
  adaptor OrderAdapter to context OrderService is { 
    handler OrderCreation is {
      on command OrderService.CreateOrder is {
        tell event Cart.CartCheckedOut to entity CartContext.Cart
      }
      on other is {
        error "Unexpected message for adaptor OrderAdapter"
      }
    } with {
      briefly "Handles order creation"
      described as {
        |Sends cart data to order service on checkout.
      }
    }
  } with {
    briefly "Order service integration"
    described as {
      |Creates orders from checked out carts.
    }
  }
  // Repository for cart persistence
  repository CartRepository as merge is {
    inlet CartRepositoryFromCart is type CartEvent    inlet CartRepositoryFromCartAnalytics is type CartEvent    outlet CartRepositoryResponses is type Cart.CartResult
    record StoredCart is  {
      cartId: CartId with {
        briefly "cartId"
        described as {
          |The cartId column of the stored cart row.
        }
      }
      customerId: CustomerId? with {
        briefly "customerId"
        described as {
          |The customerId column of the stored cart row.
        }
      }
      sessionId: SessionId with {
        briefly "sessionId"
        described as {
          |The sessionId column of the stored cart row.
        }
      }
    } with {
      briefly "Stored cart row"
      described as {
        |The persistence shape of cart data as this repository stores it.
      }
    }
    schema CartData is relational
      of carts as type StoredCart
        index on field StoredCart.customerId
        index on field StoredCart.sessionId
 with {
      briefly "Cart data schema"
      described as {
        |The relational schema holding cart data for the CartRepository.
      }
    }
    handler CartPersistence is {
      on query GetAbandonedCartMetrics is {
        do "read the abandoned cart metrics projection"
        reply result AbandonedCartMetricsView
      }
      on command Cart.CreateCart is {
        tell event Cart.CartCreated to entity CartContext.Cart
      }
      on command Cart.AddItem is {
        tell event Cart.ItemAdded to entity CartContext.Cart
      }
      on command Cart.RemoveItem is {
        tell event Cart.ItemRemoved to entity CartContext.Cart
      }
      on command Cart.UpdateQuantity is {
        tell event Cart.ItemQuantityUpdated to entity CartContext.Cart
      }
      on command Cart.ApplyPromoCode is {
        tell event Cart.PromoCodeApplied to entity CartContext.Cart
      }
      on command Cart.Checkout is {
        tell event Cart.CartCheckedOut to entity CartContext.Cart
      }
      on command Cart.AbandonCart is {
        tell event Cart.CartAbandoned to entity CartContext.Cart
      }
    } with {
      briefly "Persists cart commands"
      described as {
        |Handles command-driven persistence for cart data.
      }
    }
  } with {
    briefly "Cart data persistence"
    described as {
      | The CartRepository provides persistent storage for shopping carts
      | with indexes for customer and session lookup.
    }
  }
  // Projector for cart analytics
  query GetAbandonedCartMetrics is  {
    abandonedCartMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which abandoned cart metrics to retrieve.
      }
    }
  } with {
    briefly "Get abandoned cart metrics"
    described as {
      |Retrieves the abandoned cart metrics projection.
    }
  }
  result AbandonedCartMetricsView is  {
    abandonedCartMetrics: CartAnalytics.AbandonedCartMetrics with {
      briefly "Abandoned cart metrics"
      described as {
        |The abandoned cart metrics being returned.
      }
    }
  } with {
    briefly "Abandoned cart metrics view"
    described as {
      |Read model view carrying the abandoned cart metrics projection.
    }
  }
  projector CartAnalytics as flow is {
    updates repository CartContext.CartRepository
    inlet CartAnalyticsFromCart is type CartEvent    outlet CartAnalyticsOut is type CartEvent
    record AbandonedCartMetrics is  {
      period: Date with {
        briefly "Period"
        described as {
          |Reporting period.
        }
      }
      abandonedCount: Natural with {
        briefly "Count"
        described as {
          |Abandoned carts.
        }
      }
      totalValue: Money with {
        briefly "Value"
        described as {
          |Total abandoned value.
        }
      }
      avgItems: Decimal(5,2) with {
        briefly "Avg items"
        described as {
          |Average items.
        }
      }
    } with {
      briefly "Abandoned cart metrics"
      described as {
        |Analytics for abandoned carts.
      }
    }
    handler AnalyticsHandler is {
      on event Cart.CartAbandoned is {
        tell event Cart.CartAbandoned to repository CartContext.CartRepository
      }
      on event Cart.CartCheckedOut is {
        tell event Cart.CartCheckedOut to repository CartContext.CartRepository
      }
    } with {
      briefly "Maintains analytics views"
      described as {
        |Projects events into analytics data.
      }
    }
  } with {
    briefly "Cart analytics projections"
    described as {
      |Maintains analytics views for cart behavior.
    }
  }
  processor CartEventSource as source is {
    outlet CartEvents is type CartEvent
    handler CartSourceHandler is {
      on init is {
        tell command Cart.InitializeCart to entity CartContext.Cart
      }
      on other is {
        error "Unexpected message for source CartEventSource"
      }
      on event Cart.CartCreated is {
        send event Cart.CartCreated to outlet CartEvents
      }
      on event Cart.CartCheckedOut is {
        send event Cart.CartCheckedOut to outlet CartEvents
      }
      on event Cart.CartAbandoned is {
        send event Cart.CartAbandoned to outlet CartEvents
      }
    } with {
      briefly "Cart source handler"
      described as {
        |Handles cart events and sends to outlet.
      }
    }
  } with {
    briefly "Cart event source"
    described as {
      |Publishes cart entity events.
    }
  }
  processor CartEventSink as sink is {
    inlet CartInlet is type CartEvent    handler CartSinkHandler is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink CartEventSink"
      }
      on event Cart.CartCreated is {
        tell event Cart.CartCreated to repository CartContext.CartRepository
      }
      on event Cart.CartCheckedOut is {
        tell event Cart.CartCheckedOut to repository CartContext.CartRepository
      }
    } with {
      briefly "Cart sink handler"
      described as {
        |Receives cart events and persists them.
      }
    }
  } with {
    briefly "Cart event sink"
    described as {
      |Receives cart events for persistence.
    }
  }
  connector CartEventFlow is from outlet CartContext.CartEventSource.CartEvents to inlet CartContext.CartEventSink.CartInlet with {
    briefly "Cart event flow"
    described as {
      |Connects cart source to sink.
    }
  }
  processor CartEventSplit as split is {
    inlet CartEventSplitIn is type CartEvent    outlet CartEventSplitToCartRepository is type CartEvent
    outlet CartEventSplitToCartAnalytics is type CartEvent
    handler CartEventSplitHandler is {
      on event Cart.CartCreated is {
        send event Cart.CartCreated to outlet CartEventSplitToCartRepository
        send event Cart.CartCreated to outlet CartEventSplitToCartAnalytics
        tell event Cart.CartCreated to entity CartContext.Cart
      }
      on event Cart.ItemAdded is {
        send event Cart.ItemAdded to outlet CartEventSplitToCartRepository
        send event Cart.ItemAdded to outlet CartEventSplitToCartAnalytics
        tell event Cart.ItemAdded to entity CartContext.Cart
      }
      on event Cart.ItemQuantityUpdated is {
        send event Cart.ItemQuantityUpdated to outlet CartEventSplitToCartRepository
        send event Cart.ItemQuantityUpdated to outlet CartEventSplitToCartAnalytics
        tell event Cart.ItemQuantityUpdated to entity CartContext.Cart
      }
      on event Cart.ItemRemoved is {
        send event Cart.ItemRemoved to outlet CartEventSplitToCartRepository
        send event Cart.ItemRemoved to outlet CartEventSplitToCartAnalytics
        tell event Cart.ItemRemoved to entity CartContext.Cart
      }
      on event Cart.PromoCodeApplied is {
        send event Cart.PromoCodeApplied to outlet CartEventSplitToCartRepository
        send event Cart.PromoCodeApplied to outlet CartEventSplitToCartAnalytics
        tell event Cart.PromoCodeApplied to entity CartContext.Cart
      }
      on event Cart.PromoCodeRemoved is {
        send event Cart.PromoCodeRemoved to outlet CartEventSplitToCartRepository
        send event Cart.PromoCodeRemoved to outlet CartEventSplitToCartAnalytics
        tell event Cart.PromoCodeRemoved to entity CartContext.Cart
      }
      on event Cart.ShippingAddressSet is {
        send event Cart.ShippingAddressSet to outlet CartEventSplitToCartRepository
        send event Cart.ShippingAddressSet to outlet CartEventSplitToCartAnalytics
        tell event Cart.ShippingAddressSet to entity CartContext.Cart
      }
      on event Cart.CartsMerged is {
        send event Cart.CartsMerged to outlet CartEventSplitToCartRepository
        send event Cart.CartsMerged to outlet CartEventSplitToCartAnalytics
        tell event Cart.CartsMerged to entity CartContext.Cart
      }
      on event Cart.CartCheckedOut is {
        send event Cart.CartCheckedOut to outlet CartEventSplitToCartRepository
        send event Cart.CartCheckedOut to outlet CartEventSplitToCartAnalytics
        tell event Cart.CartCheckedOut to entity CartContext.Cart
      }
      on event Cart.CartAbandoned is {
        send event Cart.CartAbandoned to outlet CartEventSplitToCartRepository
        send event Cart.CartAbandoned to outlet CartEventSplitToCartAnalytics
        tell event Cart.CartAbandoned to entity CartContext.Cart
      }
      on other is {
        error "Unexpected message for processor CartEventSplit"
      }
    } with {
      briefly "Cart event fan-out handler"
      described as {
        |Delivers each Cart event to all of its consumers.
      }
    }
  } with {
    briefly "Cart event fan-out"
    described as {
      |Fans Cart events out to the repository and projectors.
    }
  }
  connector 'CartEvent Stream' is from outlet CartContext.Cart.CartEvents2 to inlet CartContext.CartEventSplit.CartEventSplitIn with {
    briefly "Cart events, fanned out to storage and read models"
  }
  connector 'CartEvent Storage' is from outlet CartContext.CartEventSplit.CartEventSplitToCartRepository to inlet CartContext.CartRepository.CartRepositoryFromCart with {
    briefly "Cart events on their way to storage"
  }
  connector 'CartAnalytics Feed' is from outlet CartContext.CartEventSplit.CartEventSplitToCartAnalytics to inlet CartContext.CartAnalytics.CartAnalyticsFromCart with {
    briefly "Cart events feeding the CartAnalytics projection"
  }
  connector 'CartAnalytics Storage' is from outlet CartContext.CartAnalytics.CartAnalyticsOut to inlet CartContext.CartRepository.CartRepositoryFromCartAnalytics with {
    briefly "The CartAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for shopping carts"
  described as {
    | The CartContext is the bounded context for shopping cart management.
    | It contains the Cart entity with integrations to pricing, inventory,
    | and order management systems.
  }
}
