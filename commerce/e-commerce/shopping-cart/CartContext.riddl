// Shopping Cart - Cart Context
context CartContext as router is {
  inlet CartCommandStreamIn is type CartCommand  outlet CartCommandStreamOut is type CartCommand
  inlet CartResultStreamIn is type Cart.CartResult  outlet CartResultStreamOut is type Cart.CartResult
  handler CartContextBoundary is {
    on createCart: command Cart.CreateCart is {
      send createCart to outlet CartContext.CartCommandStreamOut
    }
    on addItem: command Cart.AddItem is {
      send addItem to outlet CartContext.CartCommandStreamOut
    }
    on updateQuantity: command Cart.UpdateQuantity is {
      send updateQuantity to outlet CartContext.CartCommandStreamOut
    }
    on removeItem: command Cart.RemoveItem is {
      send removeItem to outlet CartContext.CartCommandStreamOut
    }
    on applyPromoCode: command Cart.ApplyPromoCode is {
      send applyPromoCode to outlet CartContext.CartCommandStreamOut
    }
    on removePromoCode: command Cart.RemovePromoCode is {
      send removePromoCode to outlet CartContext.CartCommandStreamOut
    }
    on setShippingAddress: command Cart.SetShippingAddress is {
      send setShippingAddress to outlet CartContext.CartCommandStreamOut
    }
    on mergeCart: command Cart.MergeCart is {
      send mergeCart to outlet CartContext.CartCommandStreamOut
    }
    on checkout: command Cart.Checkout is {
      send checkout to outlet CartContext.CartCommandStreamOut
    }
    on abandonCart: command Cart.AbandonCart is {
      send abandonCart to outlet CartContext.CartCommandStreamOut
    }
    on initializeCart: command Cart.InitializeCart is {
      send initializeCart to outlet CartContext.CartCommandStreamOut
    }
    on cartResult: result Cart.CartResult is {
      send cartResult to outlet CartContext.CartResultStreamOut
    }
    on other is {
      error "Unexpected message at the CartContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CartCommand Stream Intake' is from outlet CartContext.CartCommandStreamOut to inlet CartContext.Cart.CartCommands  connector 'CartResult Stream Egress' is from outlet CartContext.CartRepository.CartRepositoryResponses to inlet CartContext.CartResultStreamIn  adaptor FromCustomerService from context CustomerService is { 
    handler FromCustomerServiceHandler is {
      on event CustomerService.CustomerAuthenticated is {
        do "the model receives customer authenticated"
      }
      on event CustomerService.CustomerLoggedOut is {
        do "the model receives customer logged out"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerService"
      }
    } with {
      briefly "from customer service"
      described as {
        |Carries messages from the external CustomerService.
      }
    }
  } with {
    briefly "CustomerService integration"
    described as {
      |The model's side of the CustomerService conversation.
    }
  }
  adaptor FromInventoryService from context InventoryService is { 
    handler FromInventoryServiceHandler is {
      on event InventoryService.StockReserved is {
        do "the model receives stock reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
    handler InventoryEvents is {
      on stockDepleted: event InventoryService.StockDepleted is {
        tell command Cart.RemoveItem(productId = stockDepleted.productId) to entity CartContext.Cart
      }
      on stockReplenished: event InventoryService.StockReplenished is {
        tell command Cart.AddItem(productId = stockReplenished.productId, sku = stockReplenished.sku) to entity CartContext.Cart
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles inventory events"
      described as {
        |Processes stock level updates for cart items.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromOrderService from context OrderService is { 
    handler FromOrderServiceHandler is {
      on event OrderService.OrderCreated is {
        do "the model receives order created"
      }
      on other is {
        error "Unexpected message for adaptor FromOrderService"
      }
    } with {
      briefly "from order service"
      described as {
        |Carries messages from the external OrderService.
      }
    }
  } with {
    briefly "OrderService integration"
    described as {
      |The model's side of the OrderService conversation.
    }
  }
  adaptor FromPricingService from context PricingService is { 
    handler FromPricingServiceHandler is {
      on event PricingService.PromotionDeactivated is {
        do "the model receives promotion deactivated"
      }
      on other is {
        error "Unexpected message for adaptor FromPricingService"
      }
    } with {
      briefly "from pricing service"
      described as {
        |Carries messages from the external PricingService.
      }
    }
    handler PricingEvents is {
      on priceChanged: event PricingService.PriceChanged is {
        tell command Cart.UpdateQuantity(productId = priceChanged.productId) to entity CartContext.Cart
      }
      on promotionActivated: event PricingService.PromotionActivated is {
        tell command Cart.ApplyPromoCode(code = promotionActivated.code) to entity CartContext.Cart
      }
      on other is {
        error "Unexpected message for adaptor PricingAdapter"
      }
    } with {
      briefly "Handles pricing events"
      described as {
        |Processes price and promotion updates.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  include "types.riddl"
  include "Cart.riddl"
  // Adaptors for external system integration
  adaptor OrderAdapter to context OrderService is { 
    handler OrderCreation is {
      on createOrder: command OrderService.CreateOrder is {
        tell event Cart.CartCheckedOut(cartId = createOrder.cartId, total = createOrder.total) to entity CartContext.Cart
      }
      on other is {
        error "Unexpected message for adaptor OrderAdapter"
      }
    } with {
      briefly "Handles order creation"
      described as {
        |Sends cart data to order service on checkout.
      }
    }
  } with {
    briefly "Order service integration"
    described as {
      |Creates orders from checked out carts.
    }
  }
  // Repository for cart persistence
  repository CartRepository as merge is {
    command PersistCartAbandoned is  {
      cartId: CartId with {
        briefly "Row addressed"
        described as {
          |Which stored row CartAbandoned applies to.
        }
      }
    } with {
      briefly "Persist CartAbandoned"
      described as {
        |Instructs this repository to apply CartAbandoned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCartCheckedOut is  {
      cartId: CartId with {
        briefly "Row addressed"
        described as {
          |Which stored row CartCheckedOut applies to.
        }
      }
    } with {
      briefly "Persist CartCheckedOut"
      described as {
        |Instructs this repository to apply CartCheckedOut to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet CartRepositoryFromCart is type CartEvent    inlet CartRepositoryFromCartAnalytics is type CartEvent    outlet CartRepositoryResponses is type Cart.CartResult
    record StoredCart is  {
      cartId: CartId with {
        briefly "cartId"
        described as {
          |The cartId column of the stored cart row.
        }
      }
      customerId: CustomerId? with {
        briefly "customerId"
        described as {
          |The customerId column of the stored cart row.
        }
      }
      sessionId: SessionId with {
        briefly "sessionId"
        described as {
          |The sessionId column of the stored cart row.
        }
      }
    } with {
      briefly "Stored cart row"
      described as {
        |The persistence shape of cart data as this repository stores it.
      }
    }
    schema CartData is relational
      of carts as type StoredCart
        index on field StoredCart.customerId
        index on field StoredCart.sessionId
 with {
      briefly "Cart data schema"
      described as {
        |The relational schema holding cart data for the CartRepository.
      }
    }
    handler CartPersistence is {
      on persistCartAbandoned: command PersistCartAbandoned is {
        do "apply CartAbandoned to the stored row"
      }
      on persistCartCheckedOut: command PersistCartCheckedOut is {
        do "apply CartCheckedOut to the stored row"
      }
      on query GetAbandonedCartMetrics is {
        let abandonedCartMetricsView: type AbandonedCartMetricsView = prompt("read the abandoned cart metrics projection")
        reply abandonedCartMetricsView
      }
      on createCart: command Cart.CreateCart is {
        tell event Cart.CartCreated(cartId = createCart.cartId, customerId = createCart.customerId, sessionId = createCart.sessionId) to entity CartContext.Cart
      }
      on addItem: command Cart.AddItem is {
        tell event Cart.ItemAdded(cartId = addItem.cartId) to entity CartContext.Cart
      }
      on removeItem: command Cart.RemoveItem is {
        tell event Cart.ItemRemoved(cartId = removeItem.cartId, productId = removeItem.productId) to entity CartContext.Cart
      }
      on updateQuantity: command Cart.UpdateQuantity is {
        tell event Cart.ItemQuantityUpdated(cartId = updateQuantity.cartId, productId = updateQuantity.productId, newQuantity = updateQuantity.newQuantity) to entity CartContext.Cart
      }
      on applyPromoCode: command Cart.ApplyPromoCode is {
        tell event Cart.PromoCodeApplied(cartId = applyPromoCode.cartId) to entity CartContext.Cart
      }
      on checkout: command Cart.Checkout is {
        tell event Cart.CartCheckedOut(cartId = checkout.cartId) to entity CartContext.Cart
      }
      on abandonCart: command Cart.AbandonCart is {
        tell event Cart.CartAbandoned(cartId = abandonCart.cartId) to entity CartContext.Cart
      }
    } with {
      briefly "Persists cart commands"
      described as {
        |Handles command-driven persistence for cart data.
      }
    }
  } with {
    briefly "Cart data persistence"
    described as {
      | The CartRepository provides persistent storage for shopping carts
      | with indexes for customer and session lookup.
    }
  }
  // Projector for cart analytics
  query GetAbandonedCartMetrics replies result AbandonedCartMetricsView is  {
    abandonedCartMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which abandoned cart metrics to retrieve.
      }
    }
  } with {
    briefly "Get abandoned cart metrics"
    described as {
      |Retrieves the abandoned cart metrics projection.
    }
  }
  result AbandonedCartMetricsView is  {
    abandonedCartMetrics: CartAnalytics.AbandonedCartMetrics with {
      briefly "Abandoned cart metrics"
      described as {
        |The abandoned cart metrics being returned.
      }
    }
  } with {
    briefly "Abandoned cart metrics view"
    described as {
      |Read model view carrying the abandoned cart metrics projection.
    }
  }
  projector CartAnalytics as flow is {
    updates repository CartContext.CartRepository
    inlet CartAnalyticsFromCart is type CartEvent    outlet CartAnalyticsOut is type CartEvent
    record AbandonedCartMetrics is  {
      period: Date with {
        briefly "Period"
        described as {
          |Reporting period.
        }
      }
      abandonedCount: Natural with {
        briefly "Count"
        described as {
          |Abandoned carts.
        }
      }
      totalValue: Money with {
        briefly "Value"
        described as {
          |Total abandoned value.
        }
      }
      avgItems: Decimal(5,2) with {
        briefly "Avg items"
        described as {
          |Average items.
        }
      }
    } with {
      briefly "Abandoned cart metrics"
      described as {
        |Analytics for abandoned carts.
      }
    }
    handler AnalyticsHandler is {
      on cartAbandoned: event Cart.CartAbandoned is {
        tell command CartContext.CartRepository.PersistCartAbandoned(cartId = cartAbandoned.cartId) to repository CartContext.CartRepository
      }
      on cartCheckedOut: event Cart.CartCheckedOut is {
        tell command CartContext.CartRepository.PersistCartCheckedOut(cartId = cartCheckedOut.cartId) to repository CartContext.CartRepository
      }
    } with {
      briefly "Maintains analytics views"
      described as {
        |Projects events into analytics data.
      }
    }
  } with {
    briefly "Cart analytics projections"
    described as {
      |Maintains analytics views for cart behavior.
    }
  }
  processor CartEventSource as source is {
    outlet CartEvents is type CartEvent
    handler CartSourceHandler is {
      on init is {
        let initializeCart: type Cart.InitializeCart = prompt("the initialize cart that brings this this into existence")
        tell initializeCart to entity CartContext.Cart
      }
      on other is {
        error "Unexpected message for source CartEventSource"
      }
      on cartCreated: event Cart.CartCreated is {
        send cartCreated to outlet CartEvents
      }
      on cartCheckedOut: event Cart.CartCheckedOut is {
        send cartCheckedOut to outlet CartEvents
      }
      on cartAbandoned: event Cart.CartAbandoned is {
        send cartAbandoned to outlet CartEvents
      }
    } with {
      briefly "Cart source handler"
      described as {
        |Handles cart events and sends to outlet.
      }
    }
  } with {
    briefly "Cart event source"
    described as {
      |Publishes cart entity events.
    }
  }
  processor CartEventSink as sink is {
    inlet CartInlet is type CartEvent    handler CartSinkHandler is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink CartEventSink"
      }
      on cartCreated: event Cart.CartCreated is {
        tell cartCreated to repository CartContext.CartRepository
      }
      on cartCheckedOut: event Cart.CartCheckedOut is {
        tell cartCheckedOut to repository CartContext.CartRepository
      }
    } with {
      briefly "Cart sink handler"
      described as {
        |Receives cart events and persists them.
      }
    }
  } with {
    briefly "Cart event sink"
    described as {
      |Receives cart events for persistence.
    }
  }
  connector CartEventFlow is from outlet CartContext.CartEventSource.CartEvents to inlet CartContext.CartEventSink.CartInlet with {
    briefly "Cart event flow"
    described as {
      |Connects cart source to sink.
    }
  }
  processor CartEventSplit as split is {
    inlet CartEventSplitIn is type CartEvent    outlet CartEventSplitToCartRepository is type CartEvent
    outlet CartEventSplitToCartAnalytics is type CartEvent
    handler CartEventSplitHandler is {
      on cartCreated: event Cart.CartCreated is {
        send cartCreated to outlet CartEventSplitToCartRepository
        send cartCreated to outlet CartEventSplitToCartAnalytics
        tell cartCreated to entity CartContext.Cart
      }
      on itemAdded: event Cart.ItemAdded is {
        send itemAdded to outlet CartEventSplitToCartRepository
        send itemAdded to outlet CartEventSplitToCartAnalytics
        tell itemAdded to entity CartContext.Cart
      }
      on itemQuantityUpdated: event Cart.ItemQuantityUpdated is {
        send itemQuantityUpdated to outlet CartEventSplitToCartRepository
        send itemQuantityUpdated to outlet CartEventSplitToCartAnalytics
        tell itemQuantityUpdated to entity CartContext.Cart
      }
      on itemRemoved: event Cart.ItemRemoved is {
        send itemRemoved to outlet CartEventSplitToCartRepository
        send itemRemoved to outlet CartEventSplitToCartAnalytics
        tell itemRemoved to entity CartContext.Cart
      }
      on promoCodeApplied: event Cart.PromoCodeApplied is {
        send promoCodeApplied to outlet CartEventSplitToCartRepository
        send promoCodeApplied to outlet CartEventSplitToCartAnalytics
        tell promoCodeApplied to entity CartContext.Cart
      }
      on promoCodeRemoved: event Cart.PromoCodeRemoved is {
        send promoCodeRemoved to outlet CartEventSplitToCartRepository
        send promoCodeRemoved to outlet CartEventSplitToCartAnalytics
        tell promoCodeRemoved to entity CartContext.Cart
      }
      on shippingAddressSet: event Cart.ShippingAddressSet is {
        send shippingAddressSet to outlet CartEventSplitToCartRepository
        send shippingAddressSet to outlet CartEventSplitToCartAnalytics
        tell shippingAddressSet to entity CartContext.Cart
      }
      on cartsMerged: event Cart.CartsMerged is {
        send cartsMerged to outlet CartEventSplitToCartRepository
        send cartsMerged to outlet CartEventSplitToCartAnalytics
        tell cartsMerged to entity CartContext.Cart by targetCartId
      }
      on cartCheckedOut: event Cart.CartCheckedOut is {
        send cartCheckedOut to outlet CartEventSplitToCartRepository
        send cartCheckedOut to outlet CartEventSplitToCartAnalytics
        tell cartCheckedOut to entity CartContext.Cart
      }
      on cartAbandoned: event Cart.CartAbandoned is {
        send cartAbandoned to outlet CartEventSplitToCartRepository
        send cartAbandoned to outlet CartEventSplitToCartAnalytics
        tell cartAbandoned to entity CartContext.Cart
      }
      on other is {
        error "Unexpected message for processor CartEventSplit"
      }
    } with {
      briefly "Cart event fan-out handler"
      described as {
        |Delivers each Cart event to all of its consumers.
      }
    }
  } with {
    briefly "Cart event fan-out"
    described as {
      |Fans Cart events out to the repository and projectors.
    }
  }
  connector 'CartEvent Stream' is from outlet CartContext.Cart.CartEvents2 to inlet CartContext.CartEventSplit.CartEventSplitIn with {
    briefly "Cart events, fanned out to storage and read models"
  }
  connector 'CartEvent Storage' is from outlet CartContext.CartEventSplit.CartEventSplitToCartRepository to inlet CartContext.CartRepository.CartRepositoryFromCart with {
    briefly "Cart events on their way to storage"
  }
  connector 'CartAnalytics Feed' is from outlet CartContext.CartEventSplit.CartEventSplitToCartAnalytics to inlet CartContext.CartAnalytics.CartAnalyticsFromCart with {
    briefly "Cart events feeding the CartAnalytics projection"
  }
  connector 'CartAnalytics Storage' is from outlet CartContext.CartAnalytics.CartAnalyticsOut to inlet CartContext.CartRepository.CartRepositoryFromCartAnalytics with {
    briefly "The CartAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for shopping carts"
  described as {
    | The CartContext is the bounded context for shopping cart management.
    | It contains the Cart entity with integrations to pricing, inventory,
    | and order management systems.
  }
}
