// Shopping Cart - Cart Context
context CartContext as router is {
  command CreateCart yields event Cart.CartCreated is {
    customerId: CustomerId? with {
      briefly "Customer ID"
      described as {
        |Customer if authenticated, none for guest.
      }
    }
    sessionId: SessionId with {
      briefly "Session ID"
      described as {
        |Browser session for cart association.
      }
    }
  } with {
    briefly "Create a new shopping cart"
    described as {
      |Initializes an empty shopping cart for the session.
    }
  }
  type CartRequest is one of {
    CartContext.CreateCart or Cart.CartCommand
  } with {
    briefly "Cart requests"
    described as {
      |What may be asked of CartContext about a Cart: CreateCart, which the
      |context does itself by creating one, or any command for an existing one.
    }
  }
  inlet CartRepositoryQueriesIn is query GetAbandonedCartMetrics with {
    briefly "Look-ups of the cart repository"
    described as {
      |ShoppingCartApp's look-ups, on their way to the cart repository.
    }
  }
  outlet CartRepositoryQueriesOut is query GetAbandonedCartMetrics
 with {
    briefly "Look-ups on their way to the cart repository"
    described as {
      |Each look-up goes to the cart repository it names.
    }
  }
  inlet CartRepositoryRepliesIn is result AbandonedCartMetricsView with {
    briefly "The cart repository's answers"
    described as {
      |What the cart repository answers about itself.
    }
  }
  outlet CartRepositoryRepliesOut is result AbandonedCartMetricsView
 with {
    briefly "Answers to ShoppingCartApp"
    described as {
      |The reply leg of ShoppingCartApp's look-ups of the cart repository.
    }
  }
  inlet CartQueriesIn is query Cart.GetCart with {
    briefly "Look-ups of the cart"
    described as {
      |ShoppingCartApp's look-ups, on their way to the cart.
    }
  }
  outlet CartQueriesOut is query Cart.GetCart
 with {
    briefly "Look-ups on their way to the cart"
    described as {
      |Each look-up goes to the cart it names.
    }
  }
  inlet CartContextFromCustomerService is command Cart.MergeCart with {
    briefly "What FromCustomerService makes of that service's news"
  }
  connector 'CartRepositoryQuery Intake' is from outlet CartContext.CartRepositoryQueriesOut to inlet CartContext.CartRepository.CartRepositoryQueries with {
    briefly "Look-ups on their way to the cart repository"
  }
  connector 'CartRepositoryReply Egress' is from outlet CartContext.CartRepository.CartRepositoryResponses to inlet CartContext.CartRepositoryRepliesIn with {
    briefly "The cart repository's answers on their way to the boundary"
  }
  connector 'CartQuery Intake' is from outlet CartContext.CartQueriesOut to inlet CartContext.Cart.CartQueries with {
    briefly "Look-ups on their way to the cart"
  }
  connector 'FromCustomerService Intake' is from outlet CartContext.FromCustomerService.FromCustomerServiceToCartContext to inlet CartContext.CartContextFromCustomerService with {
    briefly "What FromCustomerService makes of that news, on its way in"
  }
  connector 'FromPricingService Intake' is from outlet CartContext.FromPricingService.FromPricingServiceToCartContext to inlet CartContext.CartContextFromFromPricingService with {
    briefly "FromPricingService messages on their way to CartContext"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet CartContextFromFromPricingService is type CartContext.CartRequest with {
    briefly "What FromPricingService sends CartContext"
    described as {
      |Its own inlet: an inlet accepts exactly one connector.
    }
  }
  connector 'FromInventoryService Intake' is from outlet CartContext.FromInventoryService.FromInventoryServiceToCartContext to inlet CartContext.CartContextFromFromInventoryService with {
    briefly "FromInventoryService messages on their way to CartContext"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet CartContextFromFromInventoryService is type CartContext.CartRequest with {
    briefly "What FromInventoryService sends CartContext"
    described as {
      |Its own inlet: an inlet accepts exactly one connector.
    }
  }
  inlet CartContextFromFromOrderService is command Cart.RecordOrder with {
    briefly "What FromOrderService makes of that service's news"
  }
  connector 'FromOrderService Intake' is from outlet CartContext.FromOrderService.FromOrderServiceToCartContext to inlet CartContext.CartContextFromFromOrderService with {
    briefly "What FromOrderService makes of that news, on its way in"
  }
  inlet CartCommandStreamIn is type CartContext.CartRequest
  outlet CartCommandStreamOut is type CartCommand
  inlet CartResultStreamIn is result Cart.CartResult
  outlet CartResultStreamOut is result Cart.CartResult
  handler CartContextBoundary is {
    on getAbandonedCartMetrics: query GetAbandonedCartMetrics is {
      forward getAbandonedCartMetrics to outlet CartContext.CartRepositoryQueriesOut
    }
    on abandonedCartMetricsView: result AbandonedCartMetricsView is {
      send abandonedCartMetricsView to outlet CartContext.CartRepositoryRepliesOut
    }
    on getCart: query Cart.GetCart is {
      forward getCart to outlet CartContext.CartQueriesOut
    }
    on createCart: command CartContext.CreateCart is {
      let givenCreatedAt: type TimeStamp = prompt("the created at of this cart created")
      let newCart = create entity CartContext.Cart(customerId = createCart.customerId, sessionId = createCart.sessionId, createdAt = givenCreatedAt)
    }
    on addItem: command Cart.AddItem is {
      forward addItem to outlet CartContext.CartCommandStreamOut
    }
    on updateQuantity: command Cart.UpdateQuantity is {
      forward updateQuantity to outlet CartContext.CartCommandStreamOut
    }
    on removeItem: command Cart.RemoveItem is {
      forward removeItem to outlet CartContext.CartCommandStreamOut
    }
    on applyPromoCode: command Cart.ApplyPromoCode is {
      forward applyPromoCode to outlet CartContext.CartCommandStreamOut
    }
    on removePromoCode: command Cart.RemovePromoCode is {
      forward removePromoCode to outlet CartContext.CartCommandStreamOut
    }
    on setShippingAddress: command Cart.SetShippingAddress is {
      forward setShippingAddress to outlet CartContext.CartCommandStreamOut
    }
    on mergeCart: command Cart.MergeCart is {
      forward mergeCart to outlet CartContext.CartCommandStreamOut
    }
    on checkout: command Cart.Checkout is {
      forward checkout to outlet CartContext.CartCommandStreamOut
    }
    on estimateShipping: command Cart.EstimateShipping is {
      forward estimateShipping to outlet CartContext.CartCommandStreamOut
    }
    on recordOrder: command Cart.RecordOrder is {
      forward recordOrder to outlet CartContext.CartCommandStreamOut
    }
    on cartResult: result Cart.CartResult is {
      send cartResult to outlet CartContext.CartResultStreamOut
    }
    on other is {
      error "Unexpected message at the CartContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CartCommand Stream Intake' is from outlet CartContext.CartCommandStreamOut to inlet CartContext.Cart.CartCommands
  connector 'CartResult Stream Egress' is from outlet CartContext.Cart.CartReplies to inlet CartContext.CartResultStreamIn
  adaptor FromCustomerService from context CustomerService as merge is { 
    inlet CartAnswers is event Cart.CartsMerged
    inlet FromCustomerServiceIn is type CustomerService.CustomerServiceEvent
    outlet FromCustomerServiceToCartContext is command Cart.MergeCart
    handler FromCustomerServiceHandler is {
      on customerAuthenticated: event CustomerService.CustomerAuthenticated is {
        let item0: type Cart.MergeCart = prompt("translate the customerAuthenticated event into a MergeCart, a guest cart belongs to the person once they are known, so the two carts become one")
        send item0 to outlet CartContext.FromCustomerService.FromCustomerServiceToCartContext
      }
      on customerLoggedOut: event CustomerService.CustomerLoggedOut is {
        do "the cart outlives the session, so logging out changes nothing here"
      }
      on cartsMerged: event Cart.CartsMerged is {
        log cartsMerged
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerService"
      }
    } with {
      briefly "from customer service"
      described as {
        |Carries messages from the external CustomerService.
      }
    }
  } with {
    briefly "CustomerService integration"
    described as {
      |The model's side of the CustomerService conversation.
    }
  }
  adaptor FromInventoryService from context InventoryService as merge is { 
    inlet CartAnswers is type CartEvent
    inlet FromInventoryServiceIn is type InventoryService.InventoryServiceEvent
    outlet FromInventoryServiceToCartContext is type CartContext.CartRequest
 with {
      briefly "What FromInventoryService publishes to CartContext"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to CartContext needs this port to travel on.
      }
    }
    handler InventoryEvents is {
      on stockDepleted: event InventoryService.StockDepleted is {
        tell command Cart.RemoveItem(productId = stockDepleted.productId, cartId = prompt("the cart id of this remove item")) to context CartContext
      }
      on stockReplenished: event InventoryService.StockReplenished is {
        tell command Cart.AddItem(productId = stockReplenished.productId, sku = stockReplenished.sku, cartId = prompt("the cart id of this add item"), name = prompt("the name of this add item"), quantity = prompt("the quantity of this add item"), unitPrice = prompt("the unit price of this add item")) to context CartContext
      }
      on stockReserved: event InventoryService.StockReserved is {
        do "stock is held for the checkout; the cart is spent when the order is created"
      }
      on itemRemoved: event Cart.ItemRemoved is {
        log itemRemoved
      }
      on itemAdded: event Cart.ItemAdded is {
        log itemAdded
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles inventory events"
      described as {
        |Processes stock level updates for cart items.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromOrderService from context OrderService as merge is { 
    inlet CartAnswers is event Cart.OrderLinked
    inlet FromOrderServiceIn is event OrderService.OrderCreated
    outlet FromOrderServiceToCartContext is command Cart.RecordOrder
    handler FromOrderServiceHandler is {
      on orderCreated: event OrderService.OrderCreated is {
        send command Cart.RecordOrder(cartId = orderCreated.cartId, orderId = orderCreated.orderId) to outlet CartContext.FromOrderService.FromOrderServiceToCartContext
      }
      on orderLinked: event Cart.OrderLinked is {
        log orderLinked
      }
      on other is {
        error "Unexpected message for adaptor FromOrderService"
      }
    } with {
      briefly "from order service"
      described as {
        |Carries messages from the external OrderService.
      }
    }
  } with {
    briefly "OrderService integration"
    described as {
      |The model's side of the OrderService conversation.
    }
  }
  adaptor FromPricingService from context PricingService as merge is { 
    inlet CartAnswers is type CartEvent
    inlet FromPricingServiceIn is type PricingService.PricingServiceEvent
    outlet FromPricingServiceToCartContext is type CartContext.CartRequest
 with {
      briefly "What FromPricingService publishes to CartContext"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to CartContext needs this port to travel on.
      }
    }
    handler PricingEvents is {
      on priceChanged: event PricingService.PriceChanged is {
        tell command Cart.UpdateQuantity(productId = priceChanged.productId, cartId = prompt("the cart id of this update quantity"), newQuantity = prompt("the new quantity of this update quantity")) to context CartContext
      }
      on promotionActivated: event PricingService.PromotionActivated is {
        tell command Cart.ApplyPromoCode(code = promotionActivated.code, discountPercent = promotionActivated.discountPercent, cartId = prompt("the cart id of this apply promo code")) to context CartContext
      }
      on promotionDeactivated: event PricingService.PromotionDeactivated is {
        tell command Cart.RemovePromoCode(code = prompt("the code of the promotion that was deactivated"), cartId = prompt("the cart id of this remove promo code")) to context CartContext
      }
      on itemQuantityUpdated: event Cart.ItemQuantityUpdated is {
        log itemQuantityUpdated
      }
      on promoCodeApplied: event Cart.PromoCodeApplied is {
        log promoCodeApplied
      }
      on promoCodeRemoved: event Cart.PromoCodeRemoved is {
        log promoCodeRemoved
      }
      on other is {
        error "Unexpected message for adaptor PricingAdapter"
      }
    } with {
      briefly "Handles pricing events"
      described as {
        |Processes price and promotion updates.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  include "types.riddl"
  include "Cart.riddl"
  // Adaptors for external system integration
  adaptor OrderAdapter to context OrderService as flow is { 
    inlet OrderAdapterIn is type CartEvent
    outlet OrderAdapterOut is command OrderService.CreateOrder
 with {
      briefly "What CartContext asks OrderService to send"
      described as {
        |A sender publishes only through its OWN outlet.
      }
    }
    handler OrderCreation is {
      on cartCheckedOut: event Cart.CartCheckedOut is {
        let item0: type OrderService.CreateOrder = prompt("translate the cartCheckedOut event into a CreateOrder, checkout being when the cart becomes an order somebody else must fulfil")
        send item0 to outlet CartContext.OrderAdapter.OrderAdapterOut
      }
      on other is {
        error "Unexpected message for adaptor OrderAdapter"
      }
    } with {
      briefly "Handles order creation"
      described as {
        |Sends cart data to order service on checkout.
      }
    }
  } with {
    briefly "Order service integration"
    described as {
      |Creates orders from checked out carts.
    }
  }
  // Repository for cart persistence
  type CartRepositoryCommand is one of {
    CartContext.CartRepository.PersistCartAbandoned or CartContext.CartRepository.PersistCartCheckedOut or CartContext.CartRepository.PersistCartCreated or CartContext.CartRepository.PersistCartsMerged or CartContext.CartRepository.PersistItemAdded or CartContext.CartRepository.PersistItemQuantityUpdated or CartContext.CartRepository.PersistItemRemoved or CartContext.CartRepository.PersistPromoCodeApplied or CartContext.CartRepository.PersistPromoCodeRemoved or CartContext.CartRepository.PersistShippingAddressSet or CartContext.CartRepository.PersistShippingEstimated or CartContext.CartRepository.PersistOrderLinked
  } with {
    briefly "Anything that writes the CartRepository"
    described as {
      |The persistence commands CartRepository accepts. Entity events never
      |reach it directly; the projector turns each event into one of these.
    }
  }
  repository CartRepository as merge is {
    command PersistCartCreated is {
      cartId: CartId with {
        briefly "Row addressed"
        described as {
          |Which stored row CartCreated applies to.
        }
      }
      customerId: CustomerId? with {
        briefly "Customer id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      sessionId: SessionId? with {
        briefly "Session id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CartCreated"
      described as {
        |Instructs this repository to apply CartCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCartsMerged is {
      targetCartId: CartId with {
        briefly "Row addressed"
        described as {
          |Which stored row CartsMerged applies to.
        }
      }
      sourceCartId: CartId? with {
        briefly "Source cart id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      addedItems: Natural? with {
        briefly "Added items"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      mergedAt: TimeStamp? with {
        briefly "Merged at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CartsMerged"
      described as {
        |Instructs this repository to apply CartsMerged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemAdded is {
      cartId: CartId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemAdded applies to.
        }
      }
      item: CartItem? with {
        briefly "Item"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newTotal: Money? with {
        briefly "New total"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ItemAdded"
      described as {
        |Instructs this repository to apply ItemAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemQuantityUpdated is {
      cartId: CartId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemQuantityUpdated applies to.
        }
      }
      productId: ProductId? with {
        briefly "Product id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      oldQuantity: Quantity? with {
        briefly "Old quantity"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newQuantity: Quantity? with {
        briefly "New quantity"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newTotal: Money? with {
        briefly "New total"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ItemQuantityUpdated"
      described as {
        |Instructs this repository to apply ItemQuantityUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemRemoved is {
      cartId: CartId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemRemoved applies to.
        }
      }
      productId: ProductId? with {
        briefly "Product id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newTotal: Money? with {
        briefly "New total"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ItemRemoved"
      described as {
        |Instructs this repository to apply ItemRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPromoCodeApplied is {
      cartId: CartId with {
        briefly "Row addressed"
        described as {
          |Which stored row PromoCodeApplied applies to.
        }
      }
      code: PromoCode? with {
        briefly "Code"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      discountPercent: Decimal(5,2)? with {
        briefly "Discount percent"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      appliedAt: TimeStamp? with {
        briefly "Applied at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PromoCodeApplied"
      described as {
        |Instructs this repository to apply PromoCodeApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPromoCodeRemoved is {
      cartId: CartId with {
        briefly "Row addressed"
        described as {
          |Which stored row PromoCodeRemoved applies to.
        }
      }
      code: PromoCode? with {
        briefly "Code"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      newTotal: Money? with {
        briefly "New total"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PromoCodeRemoved"
      described as {
        |Instructs this repository to apply PromoCodeRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShippingAddressSet is {
      cartId: CartId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShippingAddressSet applies to.
        }
      }
      address: ShippingAddress? with {
        briefly "Address"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      setAt: TimeStamp? with {
        briefly "Set at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ShippingAddressSet"
      described as {
        |Instructs this repository to apply ShippingAddressSet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCartAbandoned is {
      cartId: CartId with {
        briefly "Row addressed"
        described as {
          |Which stored row CartAbandoned applies to.
        }
      }
      itemCount: Natural? with {
        briefly "Item count"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      cartValue: Money? with {
        briefly "Cart value"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      abandonedAt: TimeStamp? with {
        briefly "Abandoned at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CartAbandoned"
      described as {
        |Instructs this repository to apply CartAbandoned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCartCheckedOut is {
      cartId: CartId with {
        briefly "Row addressed"
        described as {
          |Which stored row CartCheckedOut applies to.
        }
      }
      total: Money? with {
        briefly "Total"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      checkedOutAt: TimeStamp? with {
        briefly "Checked out at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CartCheckedOut"
      described as {
        |Instructs this repository to apply CartCheckedOut to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShippingEstimated is {
      cartId: CartId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShippingEstimated applies to.
        }
      }
      shippingEstimate: Money? with {
        briefly "Shipping estimate"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      estimatedAt: TimeStamp? with {
        briefly "Estimated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ShippingEstimated"
      described as {
        |Instructs this repository to apply ShippingEstimated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderLinked is {
      cartId: CartId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderLinked applies to.
        }
      }
      orderId: UUID? with {
        briefly "Order id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      linkedAt: TimeStamp? with {
        briefly "Linked at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist OrderLinked"
      described as {
        |Instructs this repository to apply OrderLinked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet CartRepositoryQueries is query GetAbandonedCartMetrics with {
      briefly "Look-ups of this cart repository"
      described as {
        |What ShoppingCartApp asks of the cart repository, by way of CartContext.
      }
    }
    inlet CartRepositoryFromCartAnalytics is type CartRepositoryCommand
    outlet CartRepositoryResponses is result AbandonedCartMetricsView
    record StoredCart is {
      cartId: CartId with {
        briefly "cartId"
        described as {
          |The cartId column of the stored cart row.
        }
      }
      customerId: CustomerId? with {
        briefly "customerId"
        described as {
          |The customerId column of the stored cart row.
        }
      }
      sessionId: SessionId with {
        briefly "sessionId"
        described as {
          |The sessionId column of the stored cart row.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      targetCartId: CartId? with {
        briefly "Target cart id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      sourceCartId: CartId? with {
        briefly "Source cart id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      addedItems: Natural? with {
        briefly "Added items"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      mergedAt: TimeStamp? with {
        briefly "Merged at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      item: CartItem? with {
        briefly "Item"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newTotal: Money? with {
        briefly "New total"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      addedAt: TimeStamp? with {
        briefly "Added at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      productId: ProductId? with {
        briefly "Product id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      oldQuantity: Quantity? with {
        briefly "Old quantity"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      newQuantity: Quantity? with {
        briefly "New quantity"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      removedAt: TimeStamp? with {
        briefly "Removed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      discountPercent: Decimal(5,2)? with {
        briefly "Discount percent"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      appliedAt: TimeStamp? with {
        briefly "Applied at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      code: PromoCode? with {
        briefly "Code"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      address: ShippingAddress? with {
        briefly "Address"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      shippingEstimate: Money? with {
        briefly "Shipping estimate"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      setAt: TimeStamp? with {
        briefly "Set at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      itemCount: Natural? with {
        briefly "Item count"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      cartValue: Money? with {
        briefly "Cart value"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      abandonedAt: TimeStamp? with {
        briefly "Abandoned at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      orderId: UUID? with {
        briefly "Order id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      total: Money? with {
        briefly "Total"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      checkedOutAt: TimeStamp? with {
        briefly "Checked out at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      estimatedAt: TimeStamp? with {
        briefly "Estimated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      linkedAt: TimeStamp? with {
        briefly "Linked at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored cart row"
      described as {
        |The persistence shape of cart data as this repository stores it.
      }
    }
    schema CartData is relational
      of carts as record StoredCart
        key on field StoredCart.cartId
        index on field StoredCart.customerId
        index on field StoredCart.sessionId
 with {
      briefly "Cart data schema"
      described as {
        |The relational schema holding cart data for the CartRepository.
      }
    }
    handler CartPersistence is {
      on persistCartCreated: command PersistCartCreated is {
        update CartData.carts set customerId = persistCartCreated.customerId, sessionId = persistCartCreated.sessionId, createdAt = persistCartCreated.createdAt where cartId == persistCartCreated.cartId
      }
      on persistCartsMerged: command PersistCartsMerged is {
        do "apply CartsMerged to the stored row"
      }
      on persistItemAdded: command PersistItemAdded is {
        update CartData.carts set item = persistItemAdded.item, newTotal = persistItemAdded.newTotal, addedAt = persistItemAdded.addedAt where cartId == persistItemAdded.cartId
      }
      on persistItemQuantityUpdated: command PersistItemQuantityUpdated is {
        update CartData.carts set productId = persistItemQuantityUpdated.productId, oldQuantity = persistItemQuantityUpdated.oldQuantity, newQuantity = persistItemQuantityUpdated.newQuantity, newTotal = persistItemQuantityUpdated.newTotal, updatedAt = persistItemQuantityUpdated.updatedAt where cartId == persistItemQuantityUpdated.cartId
      }
      on persistItemRemoved: command PersistItemRemoved is {
        update CartData.carts set productId = persistItemRemoved.productId, newTotal = persistItemRemoved.newTotal, removedAt = persistItemRemoved.removedAt where cartId == persistItemRemoved.cartId
      }
      on persistPromoCodeApplied: command PersistPromoCodeApplied is {
        update CartData.carts set code = persistPromoCodeApplied.code, discountPercent = persistPromoCodeApplied.discountPercent, appliedAt = persistPromoCodeApplied.appliedAt where cartId == persistPromoCodeApplied.cartId
      }
      on persistPromoCodeRemoved: command PersistPromoCodeRemoved is {
        update CartData.carts set code = persistPromoCodeRemoved.code, newTotal = persistPromoCodeRemoved.newTotal, removedAt = persistPromoCodeRemoved.removedAt where cartId == persistPromoCodeRemoved.cartId
      }
      on persistShippingAddressSet: command PersistShippingAddressSet is {
        update CartData.carts set address = persistShippingAddressSet.address, setAt = persistShippingAddressSet.setAt where cartId == persistShippingAddressSet.cartId
      }
      on persistShippingEstimated: command PersistShippingEstimated is {
        update CartData.carts set shippingEstimate = persistShippingEstimated.shippingEstimate, estimatedAt = persistShippingEstimated.estimatedAt where cartId == persistShippingEstimated.cartId
      }
      on persistOrderLinked: command PersistOrderLinked is {
        update CartData.carts set orderId = persistOrderLinked.orderId, linkedAt = persistOrderLinked.linkedAt where cartId == persistOrderLinked.cartId
      }
      on persistCartAbandoned: command PersistCartAbandoned is {
        update CartData.carts set itemCount = persistCartAbandoned.itemCount, cartValue = persistCartAbandoned.cartValue, abandonedAt = persistCartAbandoned.abandonedAt where cartId == persistCartAbandoned.cartId
      }
      on persistCartCheckedOut: command PersistCartCheckedOut is {
        update CartData.carts set total = persistCartCheckedOut.total, checkedOutAt = persistCartCheckedOut.checkedOutAt where cartId == persistCartCheckedOut.cartId
      }
      on query GetAbandonedCartMetrics is {
        let abandonedCartMetricsView: type AbandonedCartMetricsView = prompt("read the abandoned cart metrics projection")
        reply abandonedCartMetricsView
      }
    } with {
      briefly "Persists cart commands"
      described as {
        |Handles command-driven persistence for cart data.
      }
    }
  } with {
    briefly "Cart data persistence"
    described as {
      | The CartRepository provides persistent storage for shopping carts
      | with indexes for customer and session lookup.
    }
  }
  // Projector for cart analytics
  query GetAbandonedCartMetrics replies result AbandonedCartMetricsView is {
    abandonedCartMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which abandoned cart metrics to retrieve.
      }
    }
  } with {
    briefly "Get abandoned cart metrics"
    described as {
      |Retrieves the abandoned cart metrics projection.
    }
  }
  result AbandonedCartMetricsView is {
    abandonedCartMetrics: CartAnalytics.AbandonedCartMetrics with {
      briefly "Abandoned cart metrics"
      described as {
        |The abandoned cart metrics being returned.
      }
    }
  } with {
    briefly "Abandoned cart metrics view"
    described as {
      |Read model view carrying the abandoned cart metrics projection.
    }
  }
  projector CartAnalytics as flow is {
    updates repository CartContext.CartRepository
    inlet CartAnalyticsFromCart is type CartEvent
    outlet CartAnalyticsToRepository is type CartRepositoryCommand
    record AbandonedCartMetrics is {
      period: Date with {
        briefly "Period"
        described as {
          |Reporting period.
        }
      }
      abandonedCount: Natural with {
        briefly "Count"
        described as {
          |Abandoned carts.
        }
      }
      totalValue: Money with {
        briefly "Value"
        described as {
          |Total abandoned value.
        }
      }
      avgItems: Decimal(5,2) with {
        briefly "Avg items"
        described as {
          |Average items.
        }
      }
    } with {
      briefly "Abandoned cart metrics"
      described as {
        |Analytics for abandoned carts.
      }
    }
    handler AnalyticsHandler is {
      on cartCreated: event Cart.CartCreated is {
        tell command CartContext.CartRepository.PersistCartCreated(cartId = cartCreated.cartId, customerId = cartCreated.customerId, sessionId = cartCreated.sessionId, createdAt = cartCreated.createdAt) to repository CartContext.CartRepository
        do "apply CartCreated to the CartAnalytics projection"
      }
      on cartsMerged: event Cart.CartsMerged is {
        tell command CartContext.CartRepository.PersistCartsMerged(targetCartId = cartsMerged.targetCartId, sourceCartId = cartsMerged.sourceCartId, addedItems = cartsMerged.addedItems, mergedAt = cartsMerged.mergedAt) to repository CartContext.CartRepository
        do "apply CartsMerged to the CartAnalytics projection"
      }
      on itemAdded: event Cart.ItemAdded is {
        tell command CartContext.CartRepository.PersistItemAdded(cartId = itemAdded.cartId, item = itemAdded.item, newTotal = itemAdded.newTotal, addedAt = itemAdded.addedAt) to repository CartContext.CartRepository
        do "apply ItemAdded to the CartAnalytics projection"
      }
      on itemQuantityUpdated: event Cart.ItemQuantityUpdated is {
        tell command CartContext.CartRepository.PersistItemQuantityUpdated(cartId = itemQuantityUpdated.cartId, productId = itemQuantityUpdated.productId, oldQuantity = itemQuantityUpdated.oldQuantity, newQuantity = itemQuantityUpdated.newQuantity, newTotal = itemQuantityUpdated.newTotal, updatedAt = itemQuantityUpdated.updatedAt) to repository CartContext.CartRepository
        do "apply ItemQuantityUpdated to the CartAnalytics projection"
      }
      on itemRemoved: event Cart.ItemRemoved is {
        tell command CartContext.CartRepository.PersistItemRemoved(cartId = itemRemoved.cartId, productId = itemRemoved.productId, newTotal = itemRemoved.newTotal, removedAt = itemRemoved.removedAt) to repository CartContext.CartRepository
        do "apply ItemRemoved to the CartAnalytics projection"
      }
      on promoCodeApplied: event Cart.PromoCodeApplied is {
        tell command CartContext.CartRepository.PersistPromoCodeApplied(cartId = promoCodeApplied.cartId, code = promoCodeApplied.code, discountPercent = promoCodeApplied.discountPercent, appliedAt = promoCodeApplied.appliedAt) to repository CartContext.CartRepository
        do "apply PromoCodeApplied to the CartAnalytics projection"
      }
      on promoCodeRemoved: event Cart.PromoCodeRemoved is {
        tell command CartContext.CartRepository.PersistPromoCodeRemoved(cartId = promoCodeRemoved.cartId, code = promoCodeRemoved.code, newTotal = promoCodeRemoved.newTotal, removedAt = promoCodeRemoved.removedAt) to repository CartContext.CartRepository
        do "apply PromoCodeRemoved to the CartAnalytics projection"
      }
      on shippingAddressSet: event Cart.ShippingAddressSet is {
        tell command CartContext.CartRepository.PersistShippingAddressSet(cartId = shippingAddressSet.cartId, address = shippingAddressSet.address, setAt = shippingAddressSet.setAt) to repository CartContext.CartRepository
        do "apply ShippingAddressSet to the CartAnalytics projection"
      }
      on shippingEstimated: event Cart.ShippingEstimated is {
        tell command CartContext.CartRepository.PersistShippingEstimated(cartId = shippingEstimated.cartId, shippingEstimate = shippingEstimated.shippingEstimate, estimatedAt = shippingEstimated.estimatedAt) to repository CartContext.CartRepository
      }
      on orderLinked: event Cart.OrderLinked is {
        tell command CartContext.CartRepository.PersistOrderLinked(cartId = orderLinked.cartId, orderId = orderLinked.orderId, linkedAt = orderLinked.linkedAt) to repository CartContext.CartRepository
      }
      on cartAbandoned: event Cart.CartAbandoned is {
        tell command CartContext.CartRepository.PersistCartAbandoned(cartId = cartAbandoned.cartId, itemCount = cartAbandoned.itemCount, cartValue = cartAbandoned.cartValue, abandonedAt = cartAbandoned.abandonedAt) to repository CartContext.CartRepository
      }
      on cartCheckedOut: event Cart.CartCheckedOut is {
        tell command CartContext.CartRepository.PersistCartCheckedOut(cartId = cartCheckedOut.cartId, total = cartCheckedOut.total, checkedOutAt = cartCheckedOut.checkedOutAt) to repository CartContext.CartRepository
      }
    } with {
      briefly "Maintains analytics views"
      described as {
        |Projects events into analytics data.
      }
    }
  } with {
    briefly "Cart analytics projections"
    described as {
      |Maintains analytics views for cart behavior.
    }
  }
  connector 'FromCustomerService Cart Answers' is from outlet CartContext.CartEventSplit.CartEventSplitToFromCustomerService to inlet CartContext.FromCustomerService.CartAnswers
  connector 'FromInventoryService Cart Answers' is from outlet CartContext.CartEventSplit.CartEventSplitToFromInventoryService to inlet CartContext.FromInventoryService.CartAnswers
  connector 'FromOrderService Cart Answers' is from outlet CartContext.CartEventSplit.CartEventSplitToFromOrderService to inlet CartContext.FromOrderService.CartAnswers
  connector 'FromPricingService Cart Answers' is from outlet CartContext.CartEventSplit.CartEventSplitToFromPricingService to inlet CartContext.FromPricingService.CartAnswers
  streamlet CartEventSplit as split is {
    outlet CartEventSplitToFromCustomerService is event Cart.CartsMerged
    outlet CartEventSplitToFromInventoryService is type CartEvent
    outlet CartEventSplitToFromOrderService is event Cart.OrderLinked
    outlet CartEventSplitToFromPricingService is type CartEvent
    outlet CartEventSplitToOrderAdapter is type CartEvent
    inlet CartEventSplitIn is type CartEvent
    outlet CartEventSplitToCartAnalytics is type CartEvent
    handler CartEventSplitHandler is {
      on cartCreated: event Cart.CartCreated is {
        send cartCreated to outlet CartEventSplitToCartAnalytics
      }
      on itemAdded: event Cart.ItemAdded is {
        send itemAdded to outlet CartEventSplitToFromInventoryService
        send itemAdded to outlet CartEventSplitToCartAnalytics
      }
      on itemQuantityUpdated: event Cart.ItemQuantityUpdated is {
        send itemQuantityUpdated to outlet CartEventSplitToFromPricingService
        send itemQuantityUpdated to outlet CartEventSplitToCartAnalytics
      }
      on itemRemoved: event Cart.ItemRemoved is {
        send itemRemoved to outlet CartEventSplitToFromInventoryService
        send itemRemoved to outlet CartEventSplitToCartAnalytics
      }
      on promoCodeApplied: event Cart.PromoCodeApplied is {
        send promoCodeApplied to outlet CartEventSplitToFromPricingService
        send promoCodeApplied to outlet CartEventSplitToCartAnalytics
      }
      on promoCodeRemoved: event Cart.PromoCodeRemoved is {
        send promoCodeRemoved to outlet CartEventSplitToFromPricingService
        send promoCodeRemoved to outlet CartEventSplitToCartAnalytics
      }
      on shippingAddressSet: event Cart.ShippingAddressSet is {
        send shippingAddressSet to outlet CartEventSplitToCartAnalytics
      }
      on cartsMerged: event Cart.CartsMerged is {
        send cartsMerged to outlet CartEventSplitToFromCustomerService
        send cartsMerged to outlet CartEventSplitToCartAnalytics
      }
      on cartCheckedOut: event Cart.CartCheckedOut is {
        send cartCheckedOut to outlet CartEventSplitToCartAnalytics
        send cartCheckedOut to outlet CartEventSplitToOrderAdapter
      }
      on cartAbandoned: event Cart.CartAbandoned is {
        send cartAbandoned to outlet CartEventSplitToCartAnalytics
      }
      on shippingEstimated: event Cart.ShippingEstimated is {
        send shippingEstimated to outlet CartEventSplitToCartAnalytics
      }
      on orderLinked: event Cart.OrderLinked is {
        send orderLinked to outlet CartEventSplitToFromOrderService
        send orderLinked to outlet CartEventSplitToCartAnalytics
      }
      on other is {
        error "Unexpected message for processor CartEventSplit"
      }
    } with {
      briefly "Cart event fan-out handler"
      described as {
        |Delivers each Cart event to all of its consumers.
      }
    }
  } with {
    briefly "Cart event fan-out"
    described as {
      |Fans Cart events out to the repository and projectors.
    }
  }
  connector 'OrderAdapter Feed' is from outlet CartContext.CartEventSplit.CartEventSplitToOrderAdapter to inlet CartContext.OrderAdapter.OrderAdapterIn with {
    briefly "The Cart events OrderAdapter translates, on their way to it"
  }
  connector 'CartEvent Stream' is from outlet CartContext.Cart.CartEvents2 to inlet CartContext.CartEventSplit.CartEventSplitIn with {
    briefly "Cart events, fanned out to storage and read models"
  }
  connector 'CartAnalytics Storage' is from outlet CartContext.CartAnalytics.CartAnalyticsToRepository to inlet CartContext.CartRepository.CartRepositoryFromCartAnalytics with {
    briefly "CartAnalytics projections on their way to storage"
  }
  connector 'CartAnalytics Feed' is from outlet CartContext.CartEventSplit.CartEventSplitToCartAnalytics to inlet CartContext.CartAnalytics.CartAnalyticsFromCart with {
    briefly "Cart events feeding the CartAnalytics projection"
  }
} with {
  briefly "Bounded context for shopping carts"
  described as {
    | The CartContext is the bounded context for shopping cart management.
    | It contains the Cart entity with integrations to pricing, inventory,
    | and order management systems.
  }
}
