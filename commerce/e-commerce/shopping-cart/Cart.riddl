// Shopping Cart - Cart Entity
event-sourced entity Cart as router is {
  type CartCommand is one of {
    Cart.AddItem or Cart.UpdateQuantity or Cart.RemoveItem or Cart.ApplyPromoCode or Cart.RemovePromoCode or Cart.SetShippingAddress or Cart.MergeCart or Cart.Checkout or Cart.AbandonCart or Cart.EstimateShipping or Cart.RecordOrder
  } with {
    briefly "Cart command alternation"
    described as {
      |Commands accepted by the Cart entity.
    }
  }
  inlet CartQueries is query GetCart with {
    briefly "Look-ups of this cart"
    described as {
      |What ShoppingCartApp asks of the cart, by way of CartContext.
    }
  }
  outlet CartReplies is result CartResult
 with {
    briefly "This cart's answers"
    described as {
      |What the cart answers, on its way back to CartContext.
    }
  }
  inlet CartCommands is type CartCommand
  outlet CartEvents2 is type CartEvent
  // Commands
  command AddItem yields event ItemAdded is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart to add item to.
      }
    }
    productId: ProductId with {
      briefly "Product ID"
      described as {
        |Product to add.
      }
    }
    sku: SKU with {
      briefly "SKU"
      described as {
        |Product SKU.
      }
    }
    name: ProductName with {
      briefly "Name"
      described as {
        |Product name.
      }
    }
    quantity: Quantity with {
      briefly "Quantity"
      described as {
        |Number of units to add.
      }
    }
    unitPrice: Money with {
      briefly "Unit price"
      described as {
        |Current unit price.
      }
    }
  } with {
    briefly "Add item to cart"
    described as {
      |Adds a product to the shopping cart or increases quantity.
    }
  }
  command UpdateQuantity yields event ItemQuantityUpdated is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart containing the item.
      }
    }
    productId: ProductId with {
      briefly "Product ID"
      described as {
        |Product to update.
      }
    }
    newQuantity: Quantity with {
      briefly "New quantity"
      described as {
        |Updated quantity for the item.
      }
    }
  } with {
    briefly "Update item quantity"
    described as {
      |Changes the quantity of an item in the cart.
    }
  }
  command RemoveItem yields event ItemRemoved is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart containing the item.
      }
    }
    productId: ProductId with {
      briefly "Product ID"
      described as {
        |Product to remove.
      }
    }
  } with {
    briefly "Remove item from cart"
    described as {
      |Removes an item completely from the cart.
    }
  }
  command ApplyPromoCode yields event PromoCodeApplied is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart to apply code to.
      }
    }
    code: PromoCode with {
      briefly "Promo code"
      described as {
        |Promotional code to apply.
      }
    }
    discountPercent: Decimal(5,2) with {
      briefly "Discount percent"
      described as {
        |The promotion's percentage off, as the pricing service announced it.
      }
    }
  } with {
    briefly "Apply promotional code"
    described as {
      |Applies a discount code to the cart.
    }
  }
  command RemovePromoCode yields event PromoCodeRemoved is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart to remove code from.
      }
    }
    code: PromoCode with {
      briefly "Promo code"
      described as {
        |Promotional code to remove.
      }
    }
  } with {
    briefly "Remove promotional code"
    described as {
      |Removes a previously applied promo code.
    }
  }
  command SetShippingAddress yields event ShippingAddressSet is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart to set address for.
      }
    }
    address: ShippingAddress with {
      briefly "Address"
      described as {
        |Shipping address for the order.
      }
    }
  } with {
    briefly "Set shipping address"
    described as {
      |Sets the delivery address for checkout.
    }
  }
  command MergeCart yields event CartsMerged is {
    targetCartId: CartId with {
      briefly "Target cart ID"
      described as {
        |Cart to merge into.
      }
    }
    sourceCartId: CartId with {
      briefly "Source cart ID"
      described as {
        |Cart to merge from.
      }
    }
    sourceItems: CartItem+ with {
      briefly "Source items"
      described as {
        |The guest cart's items, as the sender read them.
      }
    }
  } with {
    briefly "Merge carts"
    described as {
      |Merges a guest cart into a customer cart after login.
    }
  }
  command EstimateShipping yields event ShippingEstimated is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart to estimate shipping for.
      }
    }
    shippingEstimate: Money with {
      briefly "Shipping estimate"
      described as {
        |Estimated shipping cost to the cart's address.
      }
    }
  } with {
    briefly "Estimate shipping"
    described as {
      |Records the estimated shipping cost the application obtained for the
      |cart's shipping address.
    }
  }
  command RecordOrder yields event OrderLinked is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Checked-out cart the order was created from.
      }
    }
    orderId: UUID with {
      briefly "Order ID"
      described as {
        |The order the order service created.
      }
    }
  } with {
    briefly "Record the resulting order"
    described as {
      |Links a checked-out cart to the order the order service created from it.
    }
  }
  command Checkout yields event CartCheckedOut is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart to checkout.
      }
    }
  } with {
    briefly "Initiate checkout"
    described as {
      |Begins the checkout process for the cart.
    }
  }
  command AbandonCart yields event CartAbandoned is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart to mark abandoned.
      }
    }
  } with {
    briefly "Mark cart as abandoned"
    described as {
      |Marks an inactive cart as abandoned.
    }
  }
  // Events
  event CartCreated is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |New cart identifier.
      }
    }
    customerId: CustomerId? with {
      briefly "Customer"
      described as {
        |Customer if known.
      }
    }
    sessionId: SessionId with {
      briefly "Session"
      described as {
        |Browser session.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Cart was created"
    described as {
      |Emitted when a new shopping cart is initialized.
    }
  }
  event ItemAdded is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart identifier.
      }
    }
    item: CartItem with {
      briefly "Item"
      described as {
        |Added item details.
      }
    }
    newTotal: Money with {
      briefly "New total"
      described as {
        |Updated cart total.
      }
    }
    addedAt: TimeStamp with {
      briefly "Added"
      described as {
        |When item was added.
      }
    }
  } with {
    briefly "Item was added to cart"
    described as {
      |Emitted when a product is added to the cart.
    }
  }
  event ItemQuantityUpdated is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart identifier.
      }
    }
    productId: ProductId with {
      briefly "Product"
      described as {
        |Updated product.
      }
    }
    oldQuantity: Quantity with {
      briefly "Old qty"
      described as {
        |Previous quantity.
      }
    }
    newQuantity: Quantity with {
      briefly "New qty"
      described as {
        |Updated quantity.
      }
    }
    newTotal: Money with {
      briefly "New total"
      described as {
        |Updated cart total.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |When updated.
      }
    }
  } with {
    briefly "Item quantity was updated"
    described as {
      |Emitted when an item quantity changes.
    }
  }
  event ItemRemoved is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart identifier.
      }
    }
    productId: ProductId with {
      briefly "Product"
      described as {
        |Removed product.
      }
    }
    newTotal: Money with {
      briefly "New total"
      described as {
        |Updated cart total.
      }
    }
    removedAt: TimeStamp with {
      briefly "Removed"
      described as {
        |When removed.
      }
    }
  } with {
    briefly "Item was removed from cart"
    described as {
      |Emitted when an item is removed from the cart.
    }
  }
  event PromoCodeApplied is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart identifier.
      }
    }
    code: PromoCode with {
      briefly "Code"
      described as {
        |Applied code.
      }
    }
    discountPercent: Decimal(5,2) with {
      briefly "Discount percent"
      described as {
        |Percentage off; the fold computes the saving from it.
      }
    }
    appliedAt: TimeStamp with {
      briefly "Applied"
      described as {
        |When applied.
      }
    }
  } with {
    briefly "Promo code was applied"
    described as {
      |Emitted when a promotional code is applied.
    }
  }
  event PromoCodeRemoved is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart identifier.
      }
    }
    code: PromoCode with {
      briefly "Code"
      described as {
        |Removed code.
      }
    }
    newTotal: Money with {
      briefly "New total"
      described as {
        |Updated cart total.
      }
    }
    removedAt: TimeStamp with {
      briefly "Removed"
      described as {
        |When removed.
      }
    }
  } with {
    briefly "Promo code was removed"
    described as {
      |Emitted when a promo code is removed.
    }
  }
  event ShippingAddressSet is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart identifier.
      }
    }
    address: ShippingAddress with {
      briefly "Address"
      described as {
        |Set address.
      }
    }
    setAt: TimeStamp with {
      briefly "Set at"
      described as {
        |When address was set.
      }
    }
  } with {
    briefly "Shipping address was set"
    described as {
      |Emitted when shipping address is provided.
    }
  }
  event CartsMerged is {
    targetCartId: CartId with {
      briefly "Target"
      described as {
        |Merged into cart.
      }
    }
    sourceCartId: CartId with {
      briefly "Source"
      described as {
        |Merged from cart.
      }
    }
    mergedItems: CartItem+ with {
      briefly "Merged items"
      described as {
        |The source cart's items, appended to the target.
      }
    }
    addedItems: Natural with {
      briefly "Added"
      described as {
        |Items added from source.
      }
    }
    mergedAt: TimeStamp with {
      briefly "Merged"
      described as {
        |When merged.
      }
    }
  } with {
    briefly "Carts were merged"
    described as {
      |Emitted when a guest cart is merged into customer cart.
    }
  }
  event CartCheckedOut is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Checked out cart.
      }
    }
    total: Money with {
      briefly "Total"
      described as {
        |Order total.
      }
    }
    checkedOutAt: TimeStamp with {
      briefly "Checked out"
      described as {
        |Checkout time.
      }
    }
  } with {
    briefly "Cart was checked out"
    described as {
      |Emitted when cart is converted to an order.
    }
  }
  event ShippingEstimated is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart identifier.
      }
    }
    shippingEstimate: Money with {
      briefly "Shipping"
      described as {
        |Estimated shipping cost.
      }
    }
    estimatedAt: TimeStamp with {
      briefly "Estimated at"
      described as {
        |When the estimate was recorded.
      }
    }
  } with {
    briefly "Shipping was estimated"
    described as {
      |Emitted when a shipping cost estimate is recorded for the cart.
    }
  }
  event OrderLinked is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Checked out cart.
      }
    }
    orderId: UUID with {
      briefly "Order ID"
      described as {
        |Resulting order.
      }
    }
    linkedAt: TimeStamp with {
      briefly "Linked at"
      described as {
        |When the order was recorded against the cart.
      }
    }
  } with {
    briefly "Order was linked to the cart"
    described as {
      |Emitted when the order created from a checked-out cart is recorded.
    }
  }
  event CartAbandoned is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Abandoned cart.
      }
    }
    itemCount: Natural with {
      briefly "Items"
      described as {
        |Items in cart.
      }
    }
    cartValue: Money with {
      briefly "Value"
      described as {
        |Cart value.
      }
    }
    abandonedAt: TimeStamp with {
      briefly "Abandoned"
      described as {
        |When marked abandoned.
      }
    }
  } with {
    briefly "Cart was abandoned"
    described as {
      |Emitted when cart is marked as abandoned.
    }
  }
  // State Records
  record ActiveCartData is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart identifier.
      }
    }
    customerId: CustomerId? with {
      briefly "Customer"
      described as {
        |Customer if known.
      }
    }
    sessionId: SessionId with {
      briefly "Session"
      described as {
        |Browser session.
      }
    }
    items: CartItem+ with {
      briefly "Items"
      described as {
        |Cart line items.
      }
    }
    discounts: DiscountAmount+ with {
      briefly "Discounts"
      described as {
        |Applied discounts.
      }
    }
    shippingAddress: ShippingAddress? with {
      briefly "Shipping"
      described as {
        |Delivery address.
      }
    }
    summary: CartSummary with {
      briefly "Summary"
      described as {
        |Cart totals.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
    lastUpdatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Last update time.
      }
    }
    shippingEstimate: Money? with {
      briefly "Shipping estimate"
    }
  } with {
    briefly "Active cart data"
    described as {
      |State data for an active shopping cart.
    }
  }
  record CheckedOutCartData is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart identifier.
      }
    }
    orderId: UUID? with {
      briefly "Order ID"
      described as {
        |Resulting order, once the order service reports it.
      }
    }
    total: Money with {
      briefly "Total"
      described as {
        |Final order total.
      }
    }
    checkedOutAt: TimeStamp with {
      briefly "Checked out"
      described as {
        |Checkout time.
      }
    }
  } with {
    briefly "Checked out cart data"
    described as {
      |State data for a cart that was converted to an order.
    }
  }
  record AbandonedCartData is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart identifier.
      }
    }
    customerId: CustomerId? with {
      briefly "Customer"
      described as {
        |Customer if known.
      }
    }
    items: CartItem+ with {
      briefly "Items"
      described as {
        |Cart items at abandonment.
      }
    }
    cartValue: Money with {
      briefly "Value"
      described as {
        |Cart value.
      }
    }
    abandonedAt: TimeStamp with {
      briefly "Abandoned"
      described as {
        |When marked abandoned.
      }
    }
  } with {
    briefly "Abandoned cart data"
    described as {
      |State data for an abandoned shopping cart.
    }
  }
  query GetCart replies result CartResult is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Identifier of the cart to retrieve.
      }
    }
  } with {
    briefly "Get cart"
    described as {
      |Retrieves cart data.
    }
  }
  result CartResult is {
    cartId: CartId with {
      briefly "Cart ID"
      described as {
        |Cart identifier.
      }
    }
    cartStatus: CartStatus with {
      briefly "Status"
      described as {
        |Current cart status.
      }
    }
  } with {
    briefly "Cart result"
    described as {
      |Cart data result.
    }
  }
  // States
  state ActiveState of record Cart.ActiveCartData is {
    initial handler ActiveStateInitHandler is {
      on quiescence "30 minutes" is {
        tell command AbandonCart(cartId = self.id) to entity CartContext.Cart
      }
    } with {
      briefly "Active state init handler"
      described as {
        |Initializes the Active state.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |Cart with items being managed.
    }
  }
  state CheckedOutState of record Cart.CheckedOutCartData with {
    briefly "Checked out state"
    described as {
      |Cart has been checked out.
    }
  }
  state AbandonedState of record Cart.AbandonedCartData with {
    briefly "Abandoned state"
    described as {
      |Cart has been abandoned.
    }
  }
  // Handler
  handler CartHandler is {
    on init(customerId: type CustomerId?, sessionId: type SessionId, createdAt: TimeStamp) is {
      morph entity Cart to state Cart.ActiveState with record Cart.ActiveCartData(cartId = self.id, customerId = customerId, sessionId = sessionId, items = prompt("the items of this active cart data"), discounts = prompt("the discounts of this active cart data"), shippingAddress = empty, summary = prompt("the summary of this active cart data"), createdAt = prompt("the created at of this active cart data"), lastUpdatedAt = prompt("the last updated at of this active cart data"), shippingEstimate = empty)
      send event CartCreated(cartId = self.id, customerId = customerId, sessionId = sessionId, createdAt = createdAt) to outlet CartContext.Cart.CartEvents2
    }
    on cartAbandoned: event CartAbandoned is {
      morph entity Cart to state Cart.AbandonedState with record Cart.AbandonedCartData(cartId = cartAbandoned.cartId, customerId = empty, items = prompt("the items of this abandoned cart data"), cartValue = prompt("the cart value of this abandoned cart data"), abandonedAt = prompt("the abandoned at of this abandoned cart data"))
    }
    on cartCheckedOut: event CartCheckedOut is {
      morph entity Cart to state Cart.CheckedOutState with record Cart.CheckedOutCartData(cartId = cartCheckedOut.cartId, orderId = empty, total = prompt("the total of this checked out cart data"), checkedOutAt = prompt("the checked out at of this checked out cart data"))
    }
    on cartsMerged: event CartsMerged is {
      foreach mergedItem in field Cart.CartsMerged.mergedItems {
        append mergedItem to field Cart.ActiveState.items
      }
      set field Cart.ActiveState.lastUpdatedAt to cartsMerged.mergedAt
    }
    on itemAdded: event ItemAdded is {
      append itemAdded.item to field Cart.ActiveState.items
      set field Cart.ActiveState.summary.subtotal to itemAdded.newTotal
      set field Cart.ActiveState.lastUpdatedAt to itemAdded.addedAt
    }
    on itemQuantityUpdated: event ItemQuantityUpdated is {
      set field Cart.ActiveState.items to prompt("the items with productId's quantity set to newQuantity")
      set field Cart.ActiveState.summary.subtotal to itemQuantityUpdated.newTotal
      set field Cart.ActiveState.lastUpdatedAt to itemQuantityUpdated.updatedAt
    }
    on itemRemoved: event ItemRemoved is {
      remove from field Cart.ActiveState.items where productId == itemRemoved.productId
      set field Cart.ActiveState.summary.subtotal to itemRemoved.newTotal
      set field Cart.ActiveState.lastUpdatedAt to itemRemoved.removedAt
    }
    on promoCodeApplied: event PromoCodeApplied is {
      let saving: type Money = record Money(amount = Cart.ActiveState.summary.subtotal.amount * promoCodeApplied.discountPercent / 100, currency = Cart.ActiveState.summary.subtotal.currency)
      append record DiscountAmount(code = promoCodeApplied.code, description = promoCodeApplied.code, discountAmount = saving) to field Cart.ActiveState.discounts
      set field Cart.ActiveState.summary.subtotal to record Money(amount = Cart.ActiveState.summary.subtotal.amount - saving.amount, currency = Cart.ActiveState.summary.subtotal.currency)
      set field Cart.ActiveState.lastUpdatedAt to promoCodeApplied.appliedAt
    }
    on promoCodeRemoved: event PromoCodeRemoved is {
      remove from field Cart.ActiveState.discounts where code == promoCodeRemoved.code
      set field Cart.ActiveState.summary.subtotal to promoCodeRemoved.newTotal
      set field Cart.ActiveState.lastUpdatedAt to promoCodeRemoved.removedAt
    }
    on shippingAddressSet: event ShippingAddressSet is {
      set field Cart.ActiveState.shippingAddress to shippingAddressSet.address
      set field Cart.ActiveState.lastUpdatedAt to shippingAddressSet.setAt
    }
    on shippingEstimated: event ShippingEstimated is {
      set field Cart.ActiveState.shippingEstimate to shippingEstimated.shippingEstimate
      set field Cart.ActiveState.lastUpdatedAt to shippingEstimated.estimatedAt
    }
    on orderLinked: event OrderLinked is {
      set field Cart.CheckedOutState.orderId to orderLinked.orderId
    }
    on addItem: command AddItem is {
      yield event ItemAdded(cartId = addItem.cartId, item = record CartItem(productId = addItem.productId, sku = addItem.sku, name = addItem.name, quantity = addItem.quantity, unitPrice = addItem.unitPrice, lineTotal = record Money(amount = addItem.unitPrice.amount * addItem.quantity, currency = addItem.unitPrice.currency), addedAt = system.now), newTotal = record Money(amount = Cart.ActiveState.summary.subtotal.amount + addItem.unitPrice.amount * addItem.quantity, currency = Cart.ActiveState.summary.subtotal.currency), addedAt = system.now)
    }
    on updateQuantity: command UpdateQuantity is {
      yield event ItemQuantityUpdated(cartId = updateQuantity.cartId, productId = updateQuantity.productId, newQuantity = updateQuantity.newQuantity, oldQuantity = prompt("the old quantity of this item quantity updated"), newTotal = prompt("the new total of this item quantity updated"), updatedAt = system.now)
    }
    on removeItem: command RemoveItem is {
      let line = one of Cart.ActiveState.items as e where e.productId == removeItem.productId
      yield event ItemRemoved(cartId = removeItem.cartId, productId = removeItem.productId, newTotal = record Money(amount = Cart.ActiveState.summary.subtotal.amount - (line.lineTotal.amount otherwise 0), currency = Cart.ActiveState.summary.subtotal.currency), removedAt = system.now)
    }
    on applyPromoCode: command ApplyPromoCode is {
      yield event PromoCodeApplied(cartId = applyPromoCode.cartId, code = applyPromoCode.code, discountPercent = applyPromoCode.discountPercent, appliedAt = system.now)
    }
    on removePromoCode: command RemovePromoCode is {
      let removed = one of Cart.ActiveState.discounts as d where d.code == removePromoCode.code
      yield event PromoCodeRemoved(cartId = removePromoCode.cartId, code = removePromoCode.code, newTotal = record Money(amount = Cart.ActiveState.summary.subtotal.amount + (removed.discountAmount.amount otherwise 0), currency = Cart.ActiveState.summary.subtotal.currency), removedAt = system.now)
    }
    on setShippingAddress: command SetShippingAddress is {
      yield event ShippingAddressSet(cartId = setShippingAddress.cartId, address = setShippingAddress.address, setAt = system.now)
    }
    on estimateShipping: command EstimateShipping is {
      yield event ShippingEstimated(cartId = estimateShipping.cartId, shippingEstimate = estimateShipping.shippingEstimate, estimatedAt = system.now)
    }
    on mergeCart: command MergeCart is {
      yield event CartsMerged(targetCartId = mergeCart.targetCartId, sourceCartId = mergeCart.sourceCartId, mergedItems = mergeCart.sourceItems, addedItems = count of mergeCart.sourceItems, mergedAt = system.now)
    }
    on checkout: command Checkout is {
      yield event CartCheckedOut(cartId = checkout.cartId, total = Cart.ActiveState.summary.estimatedTotal, checkedOutAt = system.now)
    }
    on recordOrder: command RecordOrder is {
      yield event OrderLinked(cartId = recordOrder.cartId, orderId = recordOrder.orderId, linkedAt = system.now)
    }
    on abandonCart: command AbandonCart is {
      yield event CartAbandoned(cartId = abandonCart.cartId, itemCount = Cart.ActiveState.summary.itemCount, cartValue = Cart.ActiveState.summary.subtotal, abandonedAt = system.now)
      terminate self.id
    }
    on term is {
      do "release every inventory reservation this cart was holding, so stock
        the shopper never bought stops being unavailable to everyone else"
    } with {
      briefly "What ending a cart releases"
      described as {
        |An abandoned cart holds inventory reservations and nothing else of value:
        |the shopper is gone and the contents are not an order. Its destruction is
        |what returns that stock. No parameters, because a cart ends exactly one
        |way and the abandonment event already records when.
      }
    }
    on getCart: query GetCart is {
      reply result CartResult(cartId = getCart.cartId, cartStatus = prompt("the cart status of this cart result"))
    }
  } with {
    briefly "Processes cart commands"
    described as {
      | Handles all shopping cart operations including item management,
      | promotions, and checkout initiation.
    }
  }
} with {
  briefly "Shopping cart aggregate"
  described as {
    | The Cart entity manages a customer's shopping cart including
    | item management, pricing, discounts, and checkout initiation.
    | Supports both authenticated customers and guest sessions.
  }
}
