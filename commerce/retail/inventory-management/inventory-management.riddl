// Inventory Management Domain Model
// Retail stock tracking, replenishment, and allocation
domain InventoryManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user InventoryManager is "staff managing stock levels and replenishment" with {
    briefly "Inventory manager"
    described as {
      |Staff responsible for inventory operations.
    }
  }
  user WarehouseWorker is "staff handling physical inventory" with {
    briefly "Warehouse worker"
    described as {
      |Staff performing receiving, picking, and counting.
    }
  }
  epic ReplenishmentEpic is {
    user InventoryManager wants to "to maintain optimal stock levels" so that "products are available for sale without overstocking"
    case AutoReplenishment is {
      user InventoryManager wants to "automatic reorder when stock is low" so that "stockouts are prevented"
      step is "System monitors stock levels" "against reorder points" "continuously" with {
        briefly "Monitor stock"
        described as {
          |System tracks inventory levels.
        }
      }
      step is "System detects low stock" "below reorder threshold" "for product" with {
        briefly "Detect low"
        described as {
          |System identifies reorder need.
        }
      }
      step take input InventoryManagementApp.InventoryManagementScreen.CreateReplenishmentOrderInput from user InventoryManager with {
        briefly "Create order"
        described as {
          |Send replenishment command.
        }
      }
      step is "System notifies purchasing" "of replenishment need" "for action" with {
        briefly "Notify"
        described as {
          |System alerts purchasing team.
        }
      }
    } with {
      briefly "Automatic stock replenishment"
      described as {
        |Automated reordering based on stock levels.
      }
    }
  } with {
    briefly "Inventory replenishment"
    described as {
      | Epic covering the replenishment workflow from low stock detection
      | through purchase order creation.
    }
  }
  include "InventoryContext.riddl"
  include "external-contexts.riddl"
  application context InventoryManagementApp is {
    group InventoryManagementScreen is {
      input CreateReplenishmentOrderInput acquires command InventoryContext.StockItem.CreateReplenishmentOrder with {
        briefly "Create replenishment order control"
        described as {
          |The control through which a user submits the create replenishment order request.
        }
      }
    } with {
      briefly "Inventory management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppStockItemCommands is type InventoryContext.StockItem.StockItemCommand
    inlet AppInventoryRepositoryResponses is type InventoryContext.StockItem.StockItemResult
    handler InventoryManagementAppHandler is {
      on other is {
        error "Unexpected message for application context InventoryManagementApp"
      }
    } with {
      briefly "InventoryManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "InventoryManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppStockItemCommands is {
    from outlet InventoryManagementApp.AppStockItemCommands to
      inlet InventoryContext.StockItem.StockItemCommands
  } with {
    option is persistent
    briefly "LinkAppStockItemCommands"
  }
  connector LinkAppInventoryRepositoryResponses is {
    from outlet InventoryContext.InventoryRepository.InventoryRepositoryResponses to
      inlet InventoryManagementApp.AppInventoryRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppInventoryRepositoryResponses"
  }
} with {
  briefly "Inventory management domain"
  described as {
    | The InventoryManagement domain handles retail stock tracking,
    | receiving, allocation, adjustments, and replenishment across
    | stores and warehouses.
  }
}
