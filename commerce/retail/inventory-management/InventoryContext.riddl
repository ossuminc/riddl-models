// Inventory Management - Inventory Context
context InventoryContext as router is {
  inlet StockItemCommandStreamIn is type StockItemCommand
  outlet StockItemCommandStreamOut is type StockItemCommand
  inlet StockItemResultStreamIn is type StockItem.StockItemResult
  outlet StockItemResultStreamOut is type StockItem.StockItemResult
  handler InventoryContextBoundary is {
    on createStockItem: command StockItem.CreateStockItem is {
      send createStockItem to outlet InventoryContext.StockItemCommandStreamOut
    }
    on receiveStock: command StockItem.ReceiveStock is {
      send receiveStock to outlet InventoryContext.StockItemCommandStreamOut
    }
    on reserveStock: command StockItem.ReserveStock is {
      send reserveStock to outlet InventoryContext.StockItemCommandStreamOut
    }
    on releaseReservation: command StockItem.ReleaseReservation is {
      send releaseReservation to outlet InventoryContext.StockItemCommandStreamOut
    }
    on deductStock: command StockItem.DeductStock is {
      send deductStock to outlet InventoryContext.StockItemCommandStreamOut
    }
    on adjustStock: command StockItem.AdjustStock is {
      send adjustStock to outlet InventoryContext.StockItemCommandStreamOut
    }
    on transferStock: command StockItem.TransferStock is {
      send transferStock to outlet InventoryContext.StockItemCommandStreamOut
    }
    on setReorderPoint: command StockItem.SetReorderPoint is {
      send setReorderPoint to outlet InventoryContext.StockItemCommandStreamOut
    }
    on createReplenishmentOrder: command StockItem.CreateReplenishmentOrder is {
      send createReplenishmentOrder to outlet InventoryContext.StockItemCommandStreamOut
    }
    on stockItemResult: result StockItem.StockItemResult is {
      send stockItemResult to outlet InventoryContext.StockItemResultStreamOut
    }
    on other is {
      error "Unexpected message at the InventoryContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'StockItemCommand Stream Intake' is from outlet InventoryContext.StockItemCommandStreamOut to inlet InventoryContext.StockItem.StockItemCommands
  connector 'StockItemResult Stream Egress' is from outlet InventoryContext.InventoryRepository.InventoryRepositoryResponses to inlet InventoryContext.StockItemResultStreamIn
  adaptor FromPurchasingService from context PurchasingService is { 
    handler FromPurchasingServiceHandler is {
      on event PurchasingService.PurchaseOrderCreated is {
        do "the model receives purchase order created"
      }
      on other is {
        error "Unexpected message for adaptor FromPurchasingService"
      }
    } with {
      briefly "from purchasing service"
      described as {
        |Carries messages from the external PurchasingService.
      }
    }
  } with {
    briefly "PurchasingService integration"
    described as {
      |The model's side of the PurchasingService conversation.
    }
  }
  adaptor FromWarehouseService from context WarehouseService is { 
    handler FromWarehouseServiceHandler is {
      on event WarehouseService.LocationCreated is {
        do "the model receives location created"
      }
      on event WarehouseService.LocationDeactivated is {
        do "the model receives location deactivated"
      }
      on other is {
        error "Unexpected message for adaptor FromWarehouseService"
      }
    } with {
      briefly "from warehouse service"
      described as {
        |Carries messages from the external WarehouseService.
      }
    }
  } with {
    briefly "WarehouseService integration"
    described as {
      |The model's side of the WarehouseService conversation.
    }
  }
  include "types.riddl"
  include "StockItem.riddl"
  // Adaptors for external system integration
  adaptor OrderAdapter from context OrderService is { 
    handler OrderEvents is {
      on event OrderService.OrderPlaced is {
        do "Reserve stock for order items"
      }
      on event OrderService.OrderCancelled is {
        do "Release reserved stock"
      }
      on event OrderService.OrderFulfilled is {
        do "Deduct fulfilled stock"
      }
      on other is {
        error "Unexpected message for adaptor OrderAdapter"
      }
    } with {
      briefly "Handles order events"
      described as {
        |Processes orders for stock allocation.
      }
    }
  } with {
    briefly "Order integration"
    described as {
      |Receives order events for inventory allocation.
    }
  }
  adaptor PurchasingAdapter to context PurchasingService is { 
    handler ReplenishmentEvents is {
      on command PurchasingService.CreatePurchaseOrder is {
        do "Create purchase requisition"
      }
      on other is {
        error "Unexpected message for adaptor PurchasingAdapter"
      }
    } with {
      briefly "Handles replenishment"
      described as {
        |Sends restock requests to purchasing.
      }
    }
  } with {
    briefly "Purchasing integration"
    described as {
      |Publishes replenishment needs to purchasing.
    }
  }
  adaptor ReceivingAdapter from context ReceivingService is { 
    handler ReceivingEvents is {
      on event ReceivingService.GoodsReceived is {
        do "Update stock quantities from receipt"
      }
      on event ReceivingService.ReceiptDiscrepancy is {
        do "Flag discrepancy for review"
      }
      on other is {
        error "Unexpected message for adaptor ReceivingAdapter"
      }
    } with {
      briefly "Handles receiving events"
      described as {
        |Processes goods receipt notifications.
      }
    }
  } with {
    briefly "Receiving integration"
    described as {
      |Receives goods receipt notifications.
    }
  }
  // Repository for inventory persistence
  repository InventoryRepository as merge is {
    inlet InventoryRepositoryFromStockItem is type StockItemEvent    inlet InventoryRepositoryFromInventoryViews is type StockItemEvent    outlet InventoryRepositoryResponses is type StockItem.StockItemResult
    record StoredStockItem is  {
      stockItemId: StockItemId with {
        briefly "stockItemId"
        described as {
          |The stockItemId column of the stored stockItem row.
        }
      }
      location: StorageLocation with {
        briefly "location"
        described as {
          |The location column of the stored stockItem row.
        }
      }
      productId: ProductId with {
        briefly "productId"
        described as {
          |The productId column of the stored stockItem row.
        }
      }
      sku: SKU with {
        briefly "sku"
        described as {
          |The sku column of the stored stockItem row.
        }
      }
    } with {
      briefly "Stored stockItem row"
      described as {
        |The persistence shape of stockItem data as this repository stores it.
      }
    }
    schema InventoryData is relational
      of stockItems as type StoredStockItem
        index on field StoredStockItem.productId
        index on field StoredStockItem.sku
        index on field StoredStockItem.location
 with {
      briefly "Inventory data schema"
      described as {
        |The relational schema holding inventory data for the InventoryRepository.
      }
    }
    handler InventoryPersistence is {
      on query GetLocationInventorySummary is {
        let locationInventorySummaryView: type LocationInventorySummaryView = prompt("read the location inventory summary projection")
        reply locationInventorySummaryView
      }
      on createStockItem: command StockItem.CreateStockItem is {
        tell event StockItem.StockItemCreated(stockItemId = createStockItem.stockItemId, productId = createStockItem.productId, sku = createStockItem.sku, location = createStockItem.location, initialQuantity = createStockItem.initialQuantity) to entity InventoryContext.StockItem
        do "Persist new stock item"
      }
      on receiveStock: command StockItem.ReceiveStock is {
        tell event StockItem.StockReceived(stockItemId = receiveStock.stockItemId, receipt = receiveStock.receipt) to entity InventoryContext.StockItem
        do "Update stock quantities"
      }
      on reserveStock: command StockItem.ReserveStock is {
        tell event StockItem.StockReserved(stockItemId = reserveStock.stockItemId, orderId = reserveStock.orderId, quantity = reserveStock.quantity) to entity InventoryContext.StockItem
        do "Update reservations"
      }
      on command StockItem.DeductStock is {
        do "Update on-hand quantities"
      }
      on adjustStock: command StockItem.AdjustStock is {
        tell event StockItem.StockAdjusted(stockItemId = adjustStock.stockItemId, adjustment = adjustStock.adjustment) to entity InventoryContext.StockItem
        do "Record adjustment and update quantities"
      }
      on transferStock: command StockItem.TransferStock is {
        tell event StockItem.StockTransferred(stockItemId = transferStock.stockItemId, toLocation = transferStock.toLocation, quantity = transferStock.quantity) to entity InventoryContext.StockItem
        do "Update location quantities"
      }
    } with {
      briefly "Persists inventory commands"
      described as {
        |Handles command-driven persistence for inventory.
      }
    }
  } with {
    briefly "Inventory data persistence"
    described as {
      | The InventoryRepository provides persistent storage for stock
      | items with indexes for product and location lookup.
    }
  }
  // Projector for inventory views
  query GetLocationInventorySummary is  {
    locationInventorySummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which location inventory summary to retrieve.
      }
    }
  } with {
    briefly "Get location inventory summary"
    described as {
      |Retrieves the location inventory summary projection.
    }
  }
  result LocationInventorySummaryView is  {
    locationInventorySummary: InventoryViews.LocationInventorySummary with {
      briefly "Location inventory summary"
      described as {
        |The location inventory summary being returned.
      }
    }
  } with {
    briefly "Location inventory summary view"
    described as {
      |Read model view carrying the location inventory summary projection.
    }
  }
  projector InventoryViews as flow is {
    updates repository InventoryContext.InventoryRepository
    inlet InventoryViewsFromStockItem is type StockItemEvent    outlet InventoryViewsOut is type StockItemEvent
    record LocationInventorySummary is  {
      locationId: LocationId with {
        briefly "Location"
        described as {
          |Location ID.
        }
      }
      locationName: String(1,100) with {
        briefly "Name"
        described as {
          |Location name.
        }
      }
      totalItems: Natural with {
        briefly "Items"
        described as {
          |Total unique items.
        }
      }
      totalUnits: Quantity with {
        briefly "Units"
        described as {
          |Total units on hand.
        }
      }
      totalValue: Money with {
        briefly "Value"
        described as {
          |Total inventory value.
        }
      }
    } with {
      briefly "Location inventory summary"
      described as {
        |Aggregated inventory for a location.
      }
    }
    handler ViewHandler is {
      on stockReceived: event StockItem.StockReceived is {
        tell stockReceived to repository InventoryContext.InventoryRepository
        do "Update location summary"
      }
      on stockDeducted: event StockItem.StockDeducted is {
        tell stockDeducted to repository InventoryContext.InventoryRepository
        do "Update location summary"
      }
      on stockTransferred: event StockItem.StockTransferred is {
        tell stockTransferred to repository InventoryContext.InventoryRepository
        do "Update both location summaries"
      }
    } with {
      briefly "Maintains inventory views"
      described as {
        |Projects events into summary views.
      }
    }
  } with {
    briefly "Inventory view projections"
    described as {
      |Maintains summarized views of inventory.
    }
  }
  // ---- Event publication for StockItem ----
  type StockItemEvent is one of {
    InventoryContext.StockItem.StockItemCreated or InventoryContext.StockItem.StockReceived or InventoryContext.StockItem.StockReserved or InventoryContext.StockItem.ReservationReleased or InventoryContext.StockItem.StockDeducted or InventoryContext.StockItem.StockAdjusted or InventoryContext.StockItem.StockTransferred or InventoryContext.StockItem.LowStockDetected or InventoryContext.StockItem.ReplenishmentOrderCreated
  } with {
    briefly "StockItem event alternation"
    described as {
      |Union of all StockItem events, for streaming and event-sourced
      |persistence.
    }
  }
  processor StockItemEventSource as source is {
    outlet StockItemEvents is type StockItemEvent
    handler StockItemSourceHandler is {
      on stockItemCreated: event StockItem.StockItemCreated is {
        send stockItemCreated to outlet StockItemEvents
      }
      on stockReceived: event StockItem.StockReceived is {
        send stockReceived to outlet StockItemEvents
      }
      on stockReserved: event StockItem.StockReserved is {
        send stockReserved to outlet StockItemEvents
      }
      on reservationReleased: event StockItem.ReservationReleased is {
        send reservationReleased to outlet StockItemEvents
      }
      on stockDeducted: event StockItem.StockDeducted is {
        send stockDeducted to outlet StockItemEvents
      }
      on stockAdjusted: event StockItem.StockAdjusted is {
        send stockAdjusted to outlet StockItemEvents
      }
      on stockTransferred: event StockItem.StockTransferred is {
        send stockTransferred to outlet StockItemEvents
      }
      on lowStockDetected: event StockItem.LowStockDetected is {
        send lowStockDetected to outlet StockItemEvents
      }
      on replenishmentOrderCreated: event StockItem.ReplenishmentOrderCreated is {
        send replenishmentOrderCreated to outlet StockItemEvents
      }
      on other is {
        error "Unexpected message for source StockItemEventSource"
      }
    } with {
      briefly "StockItem source handler"
      described as {
        |Publishes StockItem events onto the outlet.
      }
    }
  } with {
    briefly "StockItem event source"
    described as {
      |Publishes StockItem entity events into the streaming topology.
    }
  }
  processor StockItemEventSink as sink is {
    inlet StockItemInlet is type StockItemEvent    handler StockItemSinkHandler is {
      on stockItemCreated: event StockItem.StockItemCreated is {
        tell stockItemCreated to repository InventoryContext.InventoryRepository
      }
      on stockReceived: event StockItem.StockReceived is {
        tell stockReceived to repository InventoryContext.InventoryRepository
      }
      on stockReserved: event StockItem.StockReserved is {
        tell stockReserved to repository InventoryContext.InventoryRepository
      }
      on reservationReleased: event StockItem.ReservationReleased is {
        tell reservationReleased to repository InventoryContext.InventoryRepository
      }
      on stockDeducted: event StockItem.StockDeducted is {
        tell stockDeducted to repository InventoryContext.InventoryRepository
      }
      on stockAdjusted: event StockItem.StockAdjusted is {
        tell stockAdjusted to repository InventoryContext.InventoryRepository
      }
      on stockTransferred: event StockItem.StockTransferred is {
        tell stockTransferred to repository InventoryContext.InventoryRepository
      }
      on lowStockDetected: event StockItem.LowStockDetected is {
        tell lowStockDetected to repository InventoryContext.InventoryRepository
      }
      on replenishmentOrderCreated: event StockItem.ReplenishmentOrderCreated is {
        tell replenishmentOrderCreated to repository InventoryContext.InventoryRepository
      }
      on other is {
        error "Unexpected message for sink StockItemEventSink"
      }
    } with {
      briefly "StockItem sink handler"
      described as {
        |Persists StockItem events via the repository.
      }
    }
  } with {
    briefly "StockItem event sink"
    described as {
      |Receives StockItem events for persistence.
    }
  }
  connector StockItemEventFlow is from outlet InventoryContext.StockItemEventSource.StockItemEvents to inlet InventoryContext.StockItemEventSink.StockItemInlet with {
    briefly "StockItem event flow"
    described as {
      |Connects the StockItem source to its sink.
    }
  }
  processor StockItemEventSplit as split is {
    inlet StockItemEventSplitIn is type StockItemEvent    outlet StockItemEventSplitToInventoryRepository is type StockItemEvent
    outlet StockItemEventSplitToInventoryViews is type StockItemEvent
    handler StockItemEventSplitHandler is {
      on stockItemCreated: event StockItem.StockItemCreated is {
        send stockItemCreated to outlet StockItemEventSplitToInventoryRepository
        send stockItemCreated to outlet StockItemEventSplitToInventoryViews
        tell stockItemCreated to entity InventoryContext.StockItem
      }
      on stockReceived: event StockItem.StockReceived is {
        send stockReceived to outlet StockItemEventSplitToInventoryRepository
        send stockReceived to outlet StockItemEventSplitToInventoryViews
        tell stockReceived to entity InventoryContext.StockItem
      }
      on stockReserved: event StockItem.StockReserved is {
        send stockReserved to outlet StockItemEventSplitToInventoryRepository
        send stockReserved to outlet StockItemEventSplitToInventoryViews
        tell stockReserved to entity InventoryContext.StockItem
      }
      on reservationReleased: event StockItem.ReservationReleased is {
        send reservationReleased to outlet StockItemEventSplitToInventoryRepository
        send reservationReleased to outlet StockItemEventSplitToInventoryViews
        tell reservationReleased to entity InventoryContext.StockItem
      }
      on stockDeducted: event StockItem.StockDeducted is {
        send stockDeducted to outlet StockItemEventSplitToInventoryRepository
        send stockDeducted to outlet StockItemEventSplitToInventoryViews
        tell stockDeducted to entity InventoryContext.StockItem
      }
      on stockAdjusted: event StockItem.StockAdjusted is {
        send stockAdjusted to outlet StockItemEventSplitToInventoryRepository
        send stockAdjusted to outlet StockItemEventSplitToInventoryViews
        tell stockAdjusted to entity InventoryContext.StockItem
      }
      on stockTransferred: event StockItem.StockTransferred is {
        send stockTransferred to outlet StockItemEventSplitToInventoryRepository
        send stockTransferred to outlet StockItemEventSplitToInventoryViews
        tell stockTransferred to entity InventoryContext.StockItem
      }
      on lowStockDetected: event StockItem.LowStockDetected is {
        send lowStockDetected to outlet StockItemEventSplitToInventoryRepository
        send lowStockDetected to outlet StockItemEventSplitToInventoryViews
        tell lowStockDetected to entity InventoryContext.StockItem
      }
      on replenishmentOrderCreated: event StockItem.ReplenishmentOrderCreated is {
        send replenishmentOrderCreated to outlet StockItemEventSplitToInventoryRepository
        send replenishmentOrderCreated to outlet StockItemEventSplitToInventoryViews
        tell replenishmentOrderCreated to entity InventoryContext.StockItem
      }
      on other is {
        error "Unexpected message for processor StockItemEventSplit"
      }
    } with {
      briefly "StockItem event fan-out handler"
      described as {
        |Delivers each StockItem event to all of its consumers.
      }
    }
  } with {
    briefly "StockItem event fan-out"
    described as {
      |Fans StockItem events out to the repository and projectors.
    }
  }
  connector 'StockItemEvent Stream' is from outlet InventoryContext.StockItem.StockItemEvents2 to inlet InventoryContext.StockItemEventSplit.StockItemEventSplitIn with {
    briefly "StockItem events, fanned out to storage and read models"
  }
  connector 'StockItemEvent Storage' is from outlet InventoryContext.StockItemEventSplit.StockItemEventSplitToInventoryRepository to inlet InventoryContext.InventoryRepository.InventoryRepositoryFromStockItem with {
    briefly "StockItem events on their way to storage"
  }
  connector 'InventoryViews Feed' is from outlet InventoryContext.StockItemEventSplit.StockItemEventSplitToInventoryViews to inlet InventoryContext.InventoryViews.InventoryViewsFromStockItem with {
    briefly "StockItem events feeding the InventoryViews projection"
  }
  connector 'InventoryViews Storage' is from outlet InventoryContext.InventoryViews.InventoryViewsOut to inlet InventoryContext.InventoryRepository.InventoryRepositoryFromInventoryViews with {
    briefly "The InventoryViews projection on its way to storage"
  }
} with {
  briefly "Bounded context for inventory management"
  described as {
    | The InventoryContext is the bounded context for stock tracking.
    | It manages inventory levels, reservations, and replenishment
    | across locations.
  }
}
