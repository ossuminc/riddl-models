// Inventory Management - Inventory Context
context InventoryContext is {
  include "types.riddl"
  include "StockItem.riddl"
  // Adaptors for external system integration
  adaptor OrderAdapter from context OrderService is { 
    handler OrderEvents is {
      on event OrderService.OrderPlaced is {
        do "Reserve stock for order items"
      }
      on event OrderService.OrderCancelled is {
        do "Release reserved stock"
      }
      on event OrderService.OrderFulfilled is {
        do "Deduct fulfilled stock"
      }
      on other is {
        error "Unexpected message for adaptor OrderAdapter"
      }
    } with {
      briefly "Handles order events"
      described as {
        |Processes orders for stock allocation.
      }
    }
  } with {
    briefly "Order integration"
    described as {
      |Receives order events for inventory allocation.
    }
  }
  adaptor PurchasingAdapter to context PurchasingService is { 
    handler ReplenishmentEvents is {
      on command PurchasingService.CreatePurchaseOrder is {
        do "Create purchase requisition"
      }
      on other is {
        error "Unexpected message for adaptor PurchasingAdapter"
      }
    } with {
      briefly "Handles replenishment"
      described as {
        |Sends restock requests to purchasing.
      }
    }
  } with {
    briefly "Purchasing integration"
    described as {
      |Publishes replenishment needs to purchasing.
    }
  }
  adaptor ReceivingAdapter from context ReceivingService is { 
    handler ReceivingEvents is {
      on event ReceivingService.GoodsReceived is {
        do "Update stock quantities from receipt"
      }
      on event ReceivingService.ReceiptDiscrepancy is {
        do "Flag discrepancy for review"
      }
      on other is {
        error "Unexpected message for adaptor ReceivingAdapter"
      }
    } with {
      briefly "Handles receiving events"
      described as {
        |Processes goods receipt notifications.
      }
    }
  } with {
    briefly "Receiving integration"
    described as {
      |Receives goods receipt notifications.
    }
  }
  // Repository for inventory persistence
  repository InventoryRepository is {
    inlet InventoryRepositoryFromStockItem is type StockItemEvent
    inlet InventoryRepositoryFromInventoryViews is type StockItemEvent
    outlet InventoryRepositoryResponses is type StockItem.StockItemResult
    schema InventoryData is relational
      of stockItems as type StockItem
        index on field StockItem.productId
        index on field StockItem.sku
        index on field StockItem.location
      with {
      briefly "Inventory data schema"
      described as {
        |The relational schema holding inventory data for the InventoryRepository.
      }
    }

    handler InventoryPersistence is {
      on command StockItem.CreateStockItem is {
        tell event StockItem.StockItemCreated to entity InventoryContext.StockItem
        do "Persist new stock item"
      }
      on command StockItem.ReceiveStock is {
        tell event StockItem.StockReceived to entity InventoryContext.StockItem
        do "Update stock quantities"
      }
      on command StockItem.ReserveStock is {
        tell event StockItem.StockReserved to entity InventoryContext.StockItem
        do "Update reservations"
      }
      on command StockItem.DeductStock is {
        do "Update on-hand quantities"
      }
      on command StockItem.AdjustStock is {
        tell event StockItem.StockAdjusted to entity InventoryContext.StockItem
        do "Record adjustment and update quantities"
      }
      on command StockItem.TransferStock is {
        tell event StockItem.StockTransferred to entity InventoryContext.StockItem
        do "Update location quantities"
      }
    } with {
      briefly "Persists inventory commands"
      described as {
        |Handles command-driven persistence for inventory.
      }
    }
  } with {
    briefly "Inventory data persistence"
    described as {
      | The InventoryRepository provides persistent storage for stock
      | items with indexes for product and location lookup.
    }
  }
  // Projector for inventory views
  projector InventoryViews is {
    inlet InventoryViewsFromStockItem is type StockItemEvent
    outlet InventoryViewsOut is type StockItemEvent
    updates repository InventoryContext.InventoryRepository
    record LocationInventorySummary is  {
      locationId: LocationId with {
        briefly "Location"
        described as {
          |Location ID.
        }
      }
      locationName: String(1,100) with {
        briefly "Name"
        described as {
          |Location name.
        }
      }
      totalItems: Natural with {
        briefly "Items"
        described as {
          |Total unique items.
        }
      }
      totalUnits: Quantity with {
        briefly "Units"
        described as {
          |Total units on hand.
        }
      }
      totalValue: Money with {
        briefly "Value"
        described as {
          |Total inventory value.
        }
      }
    } with {
      briefly "Location inventory summary"
      described as {
        |Aggregated inventory for a location.
      }
    }
    handler ViewHandler is {
      on event StockItem.StockReceived is {
        tell event StockItem.StockReceived to repository InventoryContext.InventoryRepository
        do "Update location summary"
      }
      on event StockItem.StockDeducted is {
        tell event StockItem.StockDeducted to repository InventoryContext.InventoryRepository
        do "Update location summary"
      }
      on event StockItem.StockTransferred is {
        tell event StockItem.StockTransferred to repository InventoryContext.InventoryRepository
        do "Update both location summaries"
      }
    } with {
      briefly "Maintains inventory views"
      described as {
        |Projects events into summary views.
      }
    }
  } with {
    briefly "Inventory view projections"
    described as {
      |Maintains summarized views of inventory.
    }
  }
  // ---- Event publication for StockItem ----
  type StockItemEvent is one of {
    InventoryContext.StockItem.StockItemCreated,
    InventoryContext.StockItem.StockReceived,
    InventoryContext.StockItem.StockReserved,
    InventoryContext.StockItem.ReservationReleased,
    InventoryContext.StockItem.StockDeducted,
    InventoryContext.StockItem.StockAdjusted,
    InventoryContext.StockItem.StockTransferred,
    InventoryContext.StockItem.LowStockDetected,
    InventoryContext.StockItem.ReplenishmentOrderCreated
  } with {
    briefly "StockItem event alternation"
    described as {
      |Union of all StockItem events, for streaming and event-sourced
      |persistence.
    }
  }
  processor StockItemEventSource as source is {
    outlet StockItemEvents is type StockItemEvent
    handler StockItemSourceHandler is {
      on event StockItem.StockItemCreated is {
        send event StockItem.StockItemCreated to outlet StockItemEvents
      }
      on event StockItem.StockReceived is {
        send event StockItem.StockReceived to outlet StockItemEvents
      }
      on event StockItem.StockReserved is {
        send event StockItem.StockReserved to outlet StockItemEvents
      }
      on event StockItem.ReservationReleased is {
        send event StockItem.ReservationReleased to outlet StockItemEvents
      }
      on event StockItem.StockDeducted is {
        send event StockItem.StockDeducted to outlet StockItemEvents
      }
      on event StockItem.StockAdjusted is {
        send event StockItem.StockAdjusted to outlet StockItemEvents
      }
      on event StockItem.StockTransferred is {
        send event StockItem.StockTransferred to outlet StockItemEvents
      }
      on event StockItem.LowStockDetected is {
        send event StockItem.LowStockDetected to outlet StockItemEvents
      }
      on event StockItem.ReplenishmentOrderCreated is {
        send event StockItem.ReplenishmentOrderCreated to outlet StockItemEvents
      }
      on other is {
        error "Unexpected message for source StockItemEventSource"
      }
    } with {
      briefly "StockItem source handler"
      described as {
        |Publishes StockItem events onto the outlet.
      }
    }
  } with {
    briefly "StockItem event source"
    described as {
      |Publishes StockItem entity events into the streaming topology.
    }
  }
  processor StockItemEventSink as sink is {
    inlet StockItemInlet is type StockItemEvent
    handler StockItemSinkHandler is {
      on event StockItem.StockItemCreated is {
        tell event StockItem.StockItemCreated to repository InventoryContext.InventoryRepository
      }
      on event StockItem.StockReceived is {
        tell event StockItem.StockReceived to repository InventoryContext.InventoryRepository
      }
      on event StockItem.StockReserved is {
        tell event StockItem.StockReserved to repository InventoryContext.InventoryRepository
      }
      on event StockItem.ReservationReleased is {
        tell event StockItem.ReservationReleased to repository InventoryContext.InventoryRepository
      }
      on event StockItem.StockDeducted is {
        tell event StockItem.StockDeducted to repository InventoryContext.InventoryRepository
      }
      on event StockItem.StockAdjusted is {
        tell event StockItem.StockAdjusted to repository InventoryContext.InventoryRepository
      }
      on event StockItem.StockTransferred is {
        tell event StockItem.StockTransferred to repository InventoryContext.InventoryRepository
      }
      on event StockItem.LowStockDetected is {
        tell event StockItem.LowStockDetected to repository InventoryContext.InventoryRepository
      }
      on event StockItem.ReplenishmentOrderCreated is {
        tell event StockItem.ReplenishmentOrderCreated to repository InventoryContext.InventoryRepository
      }
      on other is {
        error "Unexpected message for sink StockItemEventSink"
      }
    } with {
      briefly "StockItem sink handler"
      described as {
        |Persists StockItem events via the repository.
      }
    }
  } with {
    briefly "StockItem event sink"
    described as {
      |Receives StockItem events for persistence.
    }
  }
  connector StockItemEventFlow is {
    from outlet InventoryContext.StockItemEventSource.StockItemEvents to
      inlet InventoryContext.StockItemEventSink.StockItemInlet
  } with {
    briefly "StockItem event flow"
    described as {
      |Connects the StockItem source to its sink.
    }
  }
  processor StockItemEventSplit is {
    inlet StockItemEventSplitIn is type StockItemEvent
    outlet StockItemEventSplitToInventoryRepository is type StockItemEvent
    outlet StockItemEventSplitToInventoryViews is type StockItemEvent
    handler StockItemEventSplitHandler is {
      on event StockItem.StockItemCreated is {
        send event StockItem.StockItemCreated to outlet StockItemEventSplitToInventoryRepository
        send event StockItem.StockItemCreated to outlet StockItemEventSplitToInventoryViews
        tell event StockItem.StockItemCreated to entity InventoryContext.StockItem
      }
      on event StockItem.StockReceived is {
        send event StockItem.StockReceived to outlet StockItemEventSplitToInventoryRepository
        send event StockItem.StockReceived to outlet StockItemEventSplitToInventoryViews
        tell event StockItem.StockReceived to entity InventoryContext.StockItem
      }
      on event StockItem.StockReserved is {
        send event StockItem.StockReserved to outlet StockItemEventSplitToInventoryRepository
        send event StockItem.StockReserved to outlet StockItemEventSplitToInventoryViews
        tell event StockItem.StockReserved to entity InventoryContext.StockItem
      }
      on event StockItem.ReservationReleased is {
        send event StockItem.ReservationReleased to outlet StockItemEventSplitToInventoryRepository
        send event StockItem.ReservationReleased to outlet StockItemEventSplitToInventoryViews
        tell event StockItem.ReservationReleased to entity InventoryContext.StockItem
      }
      on event StockItem.StockDeducted is {
        send event StockItem.StockDeducted to outlet StockItemEventSplitToInventoryRepository
        send event StockItem.StockDeducted to outlet StockItemEventSplitToInventoryViews
        tell event StockItem.StockDeducted to entity InventoryContext.StockItem
      }
      on event StockItem.StockAdjusted is {
        send event StockItem.StockAdjusted to outlet StockItemEventSplitToInventoryRepository
        send event StockItem.StockAdjusted to outlet StockItemEventSplitToInventoryViews
        tell event StockItem.StockAdjusted to entity InventoryContext.StockItem
      }
      on event StockItem.StockTransferred is {
        send event StockItem.StockTransferred to outlet StockItemEventSplitToInventoryRepository
        send event StockItem.StockTransferred to outlet StockItemEventSplitToInventoryViews
        tell event StockItem.StockTransferred to entity InventoryContext.StockItem
      }
      on event StockItem.LowStockDetected is {
        send event StockItem.LowStockDetected to outlet StockItemEventSplitToInventoryRepository
        send event StockItem.LowStockDetected to outlet StockItemEventSplitToInventoryViews
        tell event StockItem.LowStockDetected to entity InventoryContext.StockItem
      }
      on event StockItem.ReplenishmentOrderCreated is {
        send event StockItem.ReplenishmentOrderCreated to outlet StockItemEventSplitToInventoryRepository
        send event StockItem.ReplenishmentOrderCreated to outlet StockItemEventSplitToInventoryViews
        tell event StockItem.ReplenishmentOrderCreated to entity InventoryContext.StockItem
      }
      on other is {
        error "Unexpected message for processor StockItemEventSplit"
      }
    } with {
      briefly "StockItem event fan-out handler"
      described as {
        |Delivers each StockItem event to all of its consumers.
      }
    }
  } with {
    briefly "StockItem event fan-out"
    described as {
      |Fans StockItem events out to the repository and projectors.
    }
  }
  connector LinkStockItemToStockItemEventSplit is {
    from outlet InventoryContext.StockItem.StockItemEvents2 to
      inlet InventoryContext.StockItemEventSplit.StockItemEventSplitIn
  } with {
    briefly "LinkStockItemToStockItemEventSplit"
  }
  connector LinkStockItemEventSplitToInventoryRepository is {
    from outlet InventoryContext.StockItemEventSplit.StockItemEventSplitToInventoryRepository to
      inlet InventoryContext.InventoryRepository.InventoryRepositoryFromStockItem
  } with {
    briefly "LinkStockItemEventSplitToInventoryRepository"
  }
  connector LinkStockItemEventSplitToInventoryViews is {
    from outlet InventoryContext.StockItemEventSplit.StockItemEventSplitToInventoryViews to
      inlet InventoryContext.InventoryViews.InventoryViewsFromStockItem
  } with {
    briefly "LinkStockItemEventSplitToInventoryViews"
  }
  connector LinkInventoryViewsToInventoryRepository is {
    from outlet InventoryContext.InventoryViews.InventoryViewsOut to
      inlet InventoryContext.InventoryRepository.InventoryRepositoryFromInventoryViews
  } with {
    briefly "LinkInventoryViewsToInventoryRepository"
  }
} with {
  briefly "Bounded context for inventory management"
  described as {
    | The InventoryContext is the bounded context for stock tracking.
    | It manages inventory levels, reservations, and replenishment
    | across locations.
  }
}
