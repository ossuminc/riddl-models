// Store Operations Domain Model
// Retail store management including staff, scheduling, and daily operations
domain StoreOperations is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user StoreManager is "manager overseeing store operations" with {
    briefly "Store manager"
    described as {
      |Manager responsible for store performance.
    }
  }
  user StoreAssociate is "retail staff member" with {
    briefly "Store associate"
    described as {
      |Staff working in the retail store.
    }
  }
  epic DailyOperationsEpic is {
    user StoreManager wants to "to manage daily store operations" so that "the store runs efficiently"
    case OpeningProcedure is {
      user StoreManager wants to "to open the store for business" so that "customers can shop"
      step is "Manager arrives and unlocks" "the store" "for opening" with {
        briefly "Unlock store"
        described as {
          |Manager opens the building.
        }
      }
      step take input StoreOperationsApp.StoreOperationsScreen.OpenStoreInput from user StoreManager with {
        briefly "Open store"
        described as {
          |Record store opening in system.
        }
      }
      step is "Manager counts opening cash" "in registers" "for reconciliation" with {
        briefly "Count cash"
        described as {
          |Manager verifies starting cash.
        }
      }
      step is "System enables POS terminals" "for transactions" "accepting sales" with {
        briefly "Enable POS"
        described as {
          |System activates terminals.
        }
      }
    } with {
      briefly "Store opening procedure"
      described as {
        |Standard process for opening the store.
      }
    }
  } with {
    briefly "Daily store operations"
    described as {
      | Epic covering daily operational procedures including
      | opening, closing, and shift management.
    }
  }
  include "StoreContext.riddl"
  include "external-contexts.riddl"
  application context StoreOperationsApp is {
    group StoreOperationsScreen is {
      input OpenStoreInput acquires command StoreContext.Store.OpenStore with {
        briefly "Open store control"
        described as {
          |The control through which a user submits the open store request.
        }
      }
    } with {
      briefly "Store operations screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppStoreCommands is type StoreContext.Store.StoreCommand
    inlet AppStoreRepositoryResponses is type StoreContext.Store.StoreResult
    handler StoreOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context StoreOperationsApp"
      }
    } with {
      briefly "StoreOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "StoreOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppStoreCommands is {
    from outlet StoreOperationsApp.AppStoreCommands to
      inlet StoreContext.Store.StoreCommands
  } with {
    option is persistent
    briefly "LinkAppStoreCommands"
  }
  connector LinkAppStoreRepositoryResponses is {
    from outlet StoreContext.StoreRepository.StoreRepositoryResponses to
      inlet StoreOperationsApp.AppStoreRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppStoreRepositoryResponses"
  }
} with {
  term PointOfSaleTerminal is "A terminal at which a cashier accepts sales transactions in a store."
  briefly "Store operations domain"
  described as {
    | The StoreOperations domain handles retail store management
    | including scheduling, cash management, and operational procedures.
  }
}
