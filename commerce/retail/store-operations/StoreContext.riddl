// Store Operations - Store Context
context StoreContext is {
  adaptor FromFacilitiesService from context FacilitiesService is { 
    handler FromFacilitiesServiceHandler is {
      on event FacilitiesService.MaintenanceCompleted is {
        do "the model receives maintenance completed"
      }
      on event FacilitiesService.MaintenanceRequired is {
        do "the model receives maintenance required"
      }
      on other is {
        error "Unexpected message for adaptor FromFacilitiesService"
      }
    } with {
      briefly "from facilities service"
      described as {
        |Carries messages from the external FacilitiesService.
      }
    }
  } with {
    briefly "FacilitiesService integration"
    described as {
      |The model's side of the FacilitiesService conversation.
    }
  }
  adaptor FromHRService from context HRService is { 
    handler FromHRServiceHandler is {
      on event HRService.EmployeeTerminated is {
        do "the model receives employee terminated"
      }
      on other is {
        error "Unexpected message for adaptor FromHRService"
      }
    } with {
      briefly "from hr service"
      described as {
        |Carries messages from the external HRService.
      }
    }
    handler ScheduleEvents is {
      on event HRService.ShiftScheduled is {
        do "Add shift to store schedule"
      }
      on event HRService.ShiftCancelled is {
        do "Remove shift from schedule"
      }
      on other is {
        error "Unexpected message for adaptor HRAdapter"
      }
    } with {
      briefly "Handles HR events"
      described as {
        |Receives scheduling updates from HR.
      }
    }
  } with {
    briefly "HRService integration"
    described as {
      |The model's side of the HRService conversation.
    }
  }
  adaptor FromReportingService from context ReportingService is { 
    handler FromReportingServiceHandler is {
      on event ReportingService.ReportGenerated is {
        do "the model receives report generated"
      }
      on other is {
        error "Unexpected message for adaptor FromReportingService"
      }
    } with {
      briefly "from reporting service"
      described as {
        |Carries messages from the external ReportingService.
      }
    }
  } with {
    briefly "ReportingService integration"
    described as {
      |The model's side of the ReportingService conversation.
    }
  }
  adaptor ToReportingService to context ReportingService is { 
    handler ToReportingServiceHandler is {
      on command ReportingService.GenerateDailyReport is {
        do "the model sends generate daily report"
      }
      on other is {
        error "Unexpected message for adaptor ToReportingService"
      }
    } with {
      briefly "to reporting service"
      described as {
        |Carries messages to the external ReportingService.
      }
    }
  } with {
    briefly "ReportingService integration"
    described as {
      |The model's side of the ReportingService conversation.
    }
  }
  adaptor FromSecurityService from context SecurityService is { 
    handler FromSecurityServiceHandler is {
      on event SecurityService.SecurityAlertIssued is {
        do "the model receives security alert issued"
      }
      on other is {
        error "Unexpected message for adaptor FromSecurityService"
      }
    } with {
      briefly "from security service"
      described as {
        |Carries messages from the external SecurityService.
      }
    }
  } with {
    briefly "SecurityService integration"
    described as {
      |The model's side of the SecurityService conversation.
    }
  }
  include "types.riddl"
  include "Store.riddl"
  // Adaptors for external system integration
  adaptor SecurityAdapter to context SecurityService is { 
    handler SecurityNotifications is {
      on command SecurityService.NotifyStoreStatus is {
        do "Notify security of store status change"
      }
      on command SecurityService.ReportIncident is {
        do "Report incident to security"
      }
      on other is {
        error "Unexpected message for adaptor SecurityAdapter"
      }
    } with {
      briefly "Handles security notifications"
      described as {
        |Sends alerts to security system.
      }
    }
  } with {
    briefly "Security integration"
    described as {
      |Publishes events to security service.
    }
  }
  // Repository for store persistence
  repository StoreRepository is {
    inlet StoreRepositoryFromStore is type StoreEvent    inlet StoreRepositoryFromOperationsAnalytics is type StoreEvent    outlet StoreRepositoryResponses is type Store.StoreResult
    record StoredStore is  {
      storeId: StoreId with {
        briefly "storeId"
        described as {
          |The storeId column of the stored store row.
        }
      }
      name: String(1,200) with {
        briefly "name"
        described as {
          |The name column of the stored store row.
        }
      }
    } with {
      briefly "Stored store row"
      described as {
        |The persistence shape of store data as this repository stores it.
      }
    }
    schema StoreData is relational
      of stores as type StoredStore
        index on field StoredStore.storeId
        index on field StoredStore.name
 with {
      briefly "Store data schema"
      described as {
        |The relational schema holding store data for the StoreRepository.
      }
    }
    handler StorePersistence is {
      on query GetDailyOperationsSummary is {
        do "read the daily operations summary projection"
        yield result DailyOperationsSummaryView
      }
      on command Store.OpenStore is {
        tell event Store.StoreOpened to entity StoreContext.Store
        do "Update store status to open"
      }
      on command Store.CloseStore is {
        tell event Store.StoreClosed to entity StoreContext.Store
        do "Update store status to closed"
      }
      on command Store.StartShift is {
        tell event Store.ShiftStarted to entity StoreContext.Store
        do "Record shift start"
      }
      on command Store.EndShift is {
        do "Record shift end"
      }
      on command Store.OpenRegister is {
        tell event Store.RegisterOpened to entity StoreContext.Store
        do "Record register opening"
      }
      on command Store.CloseRegister is {
        tell event Store.RegisterClosed to entity StoreContext.Store
        do "Record register closing with cash count"
      }
      on command Store.RecordIncident is {
        tell event Store.IncidentRecorded to entity StoreContext.Store
        do "Persist incident report"
      }
    } with {
      briefly "Persists store commands"
      described as {
        |Handles command-driven persistence for stores.
      }
    }
  } with {
    briefly "Store data persistence"
    described as {
      | The StoreRepository provides persistent storage for store
      | operations data.
    }
  }
  // Projector for operations analytics
  query GetDailyOperationsSummary is  {
    dailyOperationsSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily operations summary to retrieve.
      }
    }
  } with {
    briefly "Get daily operations summary"
    described as {
      |Retrieves the daily operations summary projection.
    }
  }
  result DailyOperationsSummaryView is  {
    dailyOperationsSummary: OperationsAnalytics.DailyOperationsSummary with {
      briefly "Daily operations summary"
      described as {
        |The daily operations summary being returned.
      }
    }
  } with {
    briefly "Daily operations summary view"
    described as {
      |Read model view carrying the daily operations summary projection.
    }
  }
  projector OperationsAnalytics is {
    updates repository StoreContext.StoreRepository
    inlet OperationsAnalyticsFromStore is type StoreEvent    outlet OperationsAnalyticsOut is type StoreEvent
    record DailyOperationsSummary is  {
      storeId: StoreId with {
        briefly "Store"
        described as {
          |Store ID.
        }
      }
      date: Date with {
        briefly "Date"
        described as {
          |Operations date.
        }
      }
      hoursOpen: Decimal(4,2) with {
        briefly "Hours"
        described as {
          |Hours open.
        }
      }
      staffHours: Decimal(6,2) with {
        briefly "Staff hours"
        described as {
          |Total staff hours.
        }
      }
      incidentCount: Natural with {
        briefly "Incidents"
        described as {
          |Number of incidents.
        }
      }
      cashVariance: Money with {
        briefly "Variance"
        described as {
          |Total cash variance.
        }
      }
    } with {
      briefly "Daily operations summary"
      described as {
        |Aggregated daily operations metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Store.StoreClosed is {
        tell event Store.StoreClosed to repository StoreContext.StoreRepository
        do "Finalize daily operations summary"
      }
      on event Store.RegisterClosed is {
        tell event Store.RegisterClosed to repository StoreContext.StoreRepository
        do "Update cash variance metrics"
      }
    } with {
      briefly "Maintains operations analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Operations analytics projections"
    described as {
      |Maintains summarized operations data.
    }
  }
  // ---- Event publication for Store ----
  type StoreEvent is one of {
    StoreContext.Store.StoreOpened or StoreContext.Store.StoreClosed or StoreContext.Store.ShiftStarted or StoreContext.Store.ShiftEnded or StoreContext.Store.RegisterOpened or StoreContext.Store.RegisterClosed or StoreContext.Store.IncidentRecorded or StoreContext.Store.TaskAssigned or StoreContext.Store.TaskCompleted
  } with {
    briefly "Store event alternation"
    described as {
      |Union of all Store events, for streaming and event-sourced
      |persistence.
    }
  }
  processor StoreEventSource as source is {
    outlet StoreEvents is type StoreEvent
    handler StoreSourceHandler is {
      on event Store.StoreOpened is {
        send event Store.StoreOpened to outlet StoreEvents
      }
      on event Store.StoreClosed is {
        send event Store.StoreClosed to outlet StoreEvents
      }
      on event Store.ShiftStarted is {
        send event Store.ShiftStarted to outlet StoreEvents
      }
      on event Store.ShiftEnded is {
        send event Store.ShiftEnded to outlet StoreEvents
      }
      on event Store.RegisterOpened is {
        send event Store.RegisterOpened to outlet StoreEvents
      }
      on event Store.RegisterClosed is {
        send event Store.RegisterClosed to outlet StoreEvents
      }
      on event Store.IncidentRecorded is {
        send event Store.IncidentRecorded to outlet StoreEvents
      }
      on event Store.TaskAssigned is {
        send event Store.TaskAssigned to outlet StoreEvents
      }
      on event Store.TaskCompleted is {
        send event Store.TaskCompleted to outlet StoreEvents
      }
      on other is {
        error "Unexpected message for source StoreEventSource"
      }
    } with {
      briefly "Store source handler"
      described as {
        |Publishes Store events onto the outlet.
      }
    }
  } with {
    briefly "Store event source"
    described as {
      |Publishes Store entity events into the streaming topology.
    }
  }
  processor StoreEventSink as sink is {
    inlet StoreInlet is type StoreEvent    handler StoreSinkHandler is {
      on event Store.StoreOpened is {
        tell event Store.StoreOpened to repository StoreContext.StoreRepository
      }
      on event Store.StoreClosed is {
        tell event Store.StoreClosed to repository StoreContext.StoreRepository
      }
      on event Store.ShiftStarted is {
        tell event Store.ShiftStarted to repository StoreContext.StoreRepository
      }
      on event Store.ShiftEnded is {
        tell event Store.ShiftEnded to repository StoreContext.StoreRepository
      }
      on event Store.RegisterOpened is {
        tell event Store.RegisterOpened to repository StoreContext.StoreRepository
      }
      on event Store.RegisterClosed is {
        tell event Store.RegisterClosed to repository StoreContext.StoreRepository
      }
      on event Store.IncidentRecorded is {
        tell event Store.IncidentRecorded to repository StoreContext.StoreRepository
      }
      on event Store.TaskAssigned is {
        tell event Store.TaskAssigned to repository StoreContext.StoreRepository
      }
      on event Store.TaskCompleted is {
        tell event Store.TaskCompleted to repository StoreContext.StoreRepository
      }
      on other is {
        error "Unexpected message for sink StoreEventSink"
      }
    } with {
      briefly "Store sink handler"
      described as {
        |Persists Store events via the repository.
      }
    }
  } with {
    briefly "Store event sink"
    described as {
      |Receives Store events for persistence.
    }
  }
  connector StoreEventFlow is from outlet StoreContext.StoreEventSource.StoreEvents to inlet StoreContext.StoreEventSink.StoreInlet with {
    briefly "Store event flow"
    described as {
      |Connects the Store source to its sink.
    }
  }
  processor StoreEventSplit is {
    inlet StoreEventSplitIn is type StoreEvent    outlet StoreEventSplitToStoreRepository is type StoreEvent
    outlet StoreEventSplitToOperationsAnalytics is type StoreEvent
    handler StoreEventSplitHandler is {
      on event Store.StoreOpened is {
        send event Store.StoreOpened to outlet StoreEventSplitToStoreRepository
        send event Store.StoreOpened to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.StoreOpened to entity StoreContext.Store
      }
      on event Store.StoreClosed is {
        send event Store.StoreClosed to outlet StoreEventSplitToStoreRepository
        send event Store.StoreClosed to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.StoreClosed to entity StoreContext.Store
      }
      on event Store.ShiftStarted is {
        send event Store.ShiftStarted to outlet StoreEventSplitToStoreRepository
        send event Store.ShiftStarted to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.ShiftStarted to entity StoreContext.Store
      }
      on event Store.ShiftEnded is {
        send event Store.ShiftEnded to outlet StoreEventSplitToStoreRepository
        send event Store.ShiftEnded to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.ShiftEnded to entity StoreContext.Store
      }
      on event Store.RegisterOpened is {
        send event Store.RegisterOpened to outlet StoreEventSplitToStoreRepository
        send event Store.RegisterOpened to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.RegisterOpened to entity StoreContext.Store
      }
      on event Store.RegisterClosed is {
        send event Store.RegisterClosed to outlet StoreEventSplitToStoreRepository
        send event Store.RegisterClosed to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.RegisterClosed to entity StoreContext.Store
      }
      on event Store.IncidentRecorded is {
        send event Store.IncidentRecorded to outlet StoreEventSplitToStoreRepository
        send event Store.IncidentRecorded to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.IncidentRecorded to entity StoreContext.Store
      }
      on event Store.TaskAssigned is {
        send event Store.TaskAssigned to outlet StoreEventSplitToStoreRepository
        send event Store.TaskAssigned to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.TaskAssigned to entity StoreContext.Store
      }
      on event Store.TaskCompleted is {
        send event Store.TaskCompleted to outlet StoreEventSplitToStoreRepository
        send event Store.TaskCompleted to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.TaskCompleted to entity StoreContext.Store
      }
      on other is {
        error "Unexpected message for processor StoreEventSplit"
      }
    } with {
      briefly "Store event fan-out handler"
      described as {
        |Delivers each Store event to all of its consumers.
      }
    }
  } with {
    briefly "Store event fan-out"
    described as {
      |Fans Store events out to the repository and projectors.
    }
  }
  connector 'StoreEvent Stream' is from outlet StoreContext.Store.StoreEvents2 to inlet StoreContext.StoreEventSplit.StoreEventSplitIn with {
    briefly "Store events, fanned out to storage and read models"
  }
  connector 'StoreEvent Storage' is from outlet StoreContext.StoreEventSplit.StoreEventSplitToStoreRepository to inlet StoreContext.StoreRepository.StoreRepositoryFromStore with {
    briefly "Store events on their way to storage"
  }
  connector 'OperationsAnalytics Feed' is from outlet StoreContext.StoreEventSplit.StoreEventSplitToOperationsAnalytics to inlet StoreContext.OperationsAnalytics.OperationsAnalyticsFromStore with {
    briefly "Store events feeding the OperationsAnalytics projection"
  }
  connector 'OperationsAnalytics Storage' is from outlet StoreContext.OperationsAnalytics.OperationsAnalyticsOut to inlet StoreContext.StoreRepository.StoreRepositoryFromOperationsAnalytics with {
    briefly "The OperationsAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for store operations"
  described as {
    | The StoreContext is the bounded context for retail store
    | operations. It manages daily procedures, scheduling, and
    | incident tracking.
  }
}
