// Store Operations - Store Context
context StoreContext is {
  include "types.riddl"
  include "Store.riddl"
  // Adaptors for external system integration
  adaptor HRAdapter from context HRService is { 
    handler ScheduleEvents is {
      on event HRService.ShiftScheduled is {
        prompt "Add shift to store schedule"
      }
      on event HRService.ShiftCancelled is {
        prompt "Remove shift from schedule"
      }
      on other is {
        error "Unexpected message for adaptor HRAdapter"
      }
    } with {
      briefly "Handles HR events"
      described as {
        |Receives scheduling updates from HR.
      }
    }
  } with {
    briefly "HR integration"
    described as {
      |Receives employee scheduling from HR.
    }
  }
  adaptor SecurityAdapter to context SecurityService is { 
    handler SecurityNotifications is {
      on command SecurityService.NotifyStoreStatus is {
        prompt "Notify security of store status change"
      }
      on command SecurityService.ReportIncident is {
        prompt "Report incident to security"
      }
      on other is {
        error "Unexpected message for adaptor SecurityAdapter"
      }
    } with {
      briefly "Handles security notifications"
      described as {
        |Sends alerts to security system.
      }
    }
  } with {
    briefly "Security integration"
    described as {
      |Publishes events to security service.
    }
  }
  // Repository for store persistence
  repository StoreRepository is {
    inlet StoreRepositoryFromStore is type StoreEvent
    inlet StoreRepositoryFromOperationsAnalytics is type StoreEvent
    outlet StoreRepositoryResponses is type Store.StoreResult
    schema StoreData is relational
      of stores as type Store
        index on field Store.storeId
        index on field Store.name

    handler StorePersistence is {
      on command Store.OpenStore is {
        tell event Store.StoreOpened to entity StoreContext.Store
        prompt "Update store status to open"
      }
      on command Store.CloseStore is {
        tell event Store.StoreClosed to entity StoreContext.Store
        prompt "Update store status to closed"
      }
      on command Store.StartShift is {
        tell event Store.ShiftStarted to entity StoreContext.Store
        prompt "Record shift start"
      }
      on command Store.EndShift is {
        prompt "Record shift end"
      }
      on command Store.OpenRegister is {
        tell event Store.RegisterOpened to entity StoreContext.Store
        prompt "Record register opening"
      }
      on command Store.CloseRegister is {
        tell event Store.RegisterClosed to entity StoreContext.Store
        prompt "Record register closing with cash count"
      }
      on command Store.RecordIncident is {
        tell event Store.IncidentRecorded to entity StoreContext.Store
        prompt "Persist incident report"
      }
    } with {
      briefly "Persists store commands"
      described as {
        |Handles command-driven persistence for stores.
      }
    }
  } with {
    briefly "Store data persistence"
    described as {
      | The StoreRepository provides persistent storage for store
      | operations data.
    }
  }
  // Projector for operations analytics
  projector OperationsAnalytics is {
    inlet OperationsAnalyticsFromStore is type StoreEvent
    outlet OperationsAnalyticsOut is type StoreEvent
    updates repository StoreContext.StoreRepository
    record DailyOperationsSummary is  {
      storeId: StoreId with {
        briefly "Store"
        described as {
          |Store ID.
        }
      }
      date: Date with {
        briefly "Date"
        described as {
          |Operations date.
        }
      }
      hoursOpen: Decimal(4,2) with {
        briefly "Hours"
        described as {
          |Hours open.
        }
      }
      staffHours: Decimal(6,2) with {
        briefly "Staff hours"
        described as {
          |Total staff hours.
        }
      }
      incidentCount: Natural with {
        briefly "Incidents"
        described as {
          |Number of incidents.
        }
      }
      cashVariance: Money with {
        briefly "Variance"
        described as {
          |Total cash variance.
        }
      }
    } with {
      briefly "Daily operations summary"
      described as {
        |Aggregated daily operations metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Store.StoreClosed is {
        tell event Store.StoreClosed to repository StoreContext.StoreRepository
        prompt "Finalize daily operations summary"
      }
      on event Store.RegisterClosed is {
        tell event Store.RegisterClosed to repository StoreContext.StoreRepository
        prompt "Update cash variance metrics"
      }
    } with {
      briefly "Maintains operations analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Operations analytics projections"
    described as {
      |Maintains summarized operations data.
    }
  }
  // ---- Event publication for Store ----
  type StoreEvent is one of {
    StoreContext.Store.StoreOpened,
    StoreContext.Store.StoreClosed,
    StoreContext.Store.ShiftStarted,
    StoreContext.Store.ShiftEnded,
    StoreContext.Store.RegisterOpened,
    StoreContext.Store.RegisterClosed,
    StoreContext.Store.IncidentRecorded,
    StoreContext.Store.TaskAssigned,
    StoreContext.Store.TaskCompleted
  } with {
    briefly "Store event alternation"
    described as {
      |Union of all Store events, for streaming and event-sourced
      |persistence.
    }
  }
  processor StoreEventSource as source is {
    outlet StoreEvents is type StoreEvent
    handler StoreSourceHandler is {
      on event Store.StoreOpened is {
        send event Store.StoreOpened to outlet StoreEvents
      }
      on event Store.StoreClosed is {
        send event Store.StoreClosed to outlet StoreEvents
      }
      on event Store.ShiftStarted is {
        send event Store.ShiftStarted to outlet StoreEvents
      }
      on event Store.ShiftEnded is {
        send event Store.ShiftEnded to outlet StoreEvents
      }
      on event Store.RegisterOpened is {
        send event Store.RegisterOpened to outlet StoreEvents
      }
      on event Store.RegisterClosed is {
        send event Store.RegisterClosed to outlet StoreEvents
      }
      on event Store.IncidentRecorded is {
        send event Store.IncidentRecorded to outlet StoreEvents
      }
      on event Store.TaskAssigned is {
        send event Store.TaskAssigned to outlet StoreEvents
      }
      on event Store.TaskCompleted is {
        send event Store.TaskCompleted to outlet StoreEvents
      }
      on other is {
        error "Unexpected message for source StoreEventSource"
      }
    } with {
      briefly "Store source handler"
      described as {
        |Publishes Store events onto the outlet.
      }
    }
  } with {
    briefly "Store event source"
    described as {
      |Publishes Store entity events into the streaming topology.
    }
  }
  processor StoreEventSink as sink is {
    inlet StoreInlet is type StoreEvent
    handler StoreSinkHandler is {
      on event Store.StoreOpened is {
        tell event Store.StoreOpened to repository StoreContext.StoreRepository
      }
      on event Store.StoreClosed is {
        tell event Store.StoreClosed to repository StoreContext.StoreRepository
      }
      on event Store.ShiftStarted is {
        tell event Store.ShiftStarted to repository StoreContext.StoreRepository
      }
      on event Store.ShiftEnded is {
        tell event Store.ShiftEnded to repository StoreContext.StoreRepository
      }
      on event Store.RegisterOpened is {
        tell event Store.RegisterOpened to repository StoreContext.StoreRepository
      }
      on event Store.RegisterClosed is {
        tell event Store.RegisterClosed to repository StoreContext.StoreRepository
      }
      on event Store.IncidentRecorded is {
        tell event Store.IncidentRecorded to repository StoreContext.StoreRepository
      }
      on event Store.TaskAssigned is {
        tell event Store.TaskAssigned to repository StoreContext.StoreRepository
      }
      on event Store.TaskCompleted is {
        tell event Store.TaskCompleted to repository StoreContext.StoreRepository
      }
      on other is {
        error "Unexpected message for sink StoreEventSink"
      }
    } with {
      briefly "Store sink handler"
      described as {
        |Persists Store events via the repository.
      }
    }
  } with {
    briefly "Store event sink"
    described as {
      |Receives Store events for persistence.
    }
  }
  connector StoreEventFlow is {
    from outlet StoreContext.StoreEventSource.StoreEvents to
      inlet StoreContext.StoreEventSink.StoreInlet
  } with {
    briefly "Store event flow"
    described as {
      |Connects the Store source to its sink.
    }
  }
  processor StoreEventSplit is {
    inlet StoreEventSplitIn is type StoreEvent
    outlet StoreEventSplitToStoreRepository is type StoreEvent
    outlet StoreEventSplitToOperationsAnalytics is type StoreEvent
    handler StoreEventSplitHandler is {
      on event Store.StoreOpened is {
        send event Store.StoreOpened to outlet StoreEventSplitToStoreRepository
        send event Store.StoreOpened to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.StoreOpened to entity StoreContext.Store
      }
      on event Store.StoreClosed is {
        send event Store.StoreClosed to outlet StoreEventSplitToStoreRepository
        send event Store.StoreClosed to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.StoreClosed to entity StoreContext.Store
      }
      on event Store.ShiftStarted is {
        send event Store.ShiftStarted to outlet StoreEventSplitToStoreRepository
        send event Store.ShiftStarted to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.ShiftStarted to entity StoreContext.Store
      }
      on event Store.ShiftEnded is {
        send event Store.ShiftEnded to outlet StoreEventSplitToStoreRepository
        send event Store.ShiftEnded to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.ShiftEnded to entity StoreContext.Store
      }
      on event Store.RegisterOpened is {
        send event Store.RegisterOpened to outlet StoreEventSplitToStoreRepository
        send event Store.RegisterOpened to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.RegisterOpened to entity StoreContext.Store
      }
      on event Store.RegisterClosed is {
        send event Store.RegisterClosed to outlet StoreEventSplitToStoreRepository
        send event Store.RegisterClosed to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.RegisterClosed to entity StoreContext.Store
      }
      on event Store.IncidentRecorded is {
        send event Store.IncidentRecorded to outlet StoreEventSplitToStoreRepository
        send event Store.IncidentRecorded to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.IncidentRecorded to entity StoreContext.Store
      }
      on event Store.TaskAssigned is {
        send event Store.TaskAssigned to outlet StoreEventSplitToStoreRepository
        send event Store.TaskAssigned to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.TaskAssigned to entity StoreContext.Store
      }
      on event Store.TaskCompleted is {
        send event Store.TaskCompleted to outlet StoreEventSplitToStoreRepository
        send event Store.TaskCompleted to outlet StoreEventSplitToOperationsAnalytics
        tell event Store.TaskCompleted to entity StoreContext.Store
      }
      on other is {
        error "Unexpected message for processor StoreEventSplit"
      }
    } with {
      briefly "Store event fan-out handler"
      described as {
        |Delivers each Store event to all of its consumers.
      }
    }
  } with {
    briefly "Store event fan-out"
    described as {
      |Fans Store events out to the repository and projectors.
    }
  }
  connector LinkStoreToStoreEventSplit is {
    from outlet StoreContext.Store.StoreEvents2 to
      inlet StoreContext.StoreEventSplit.StoreEventSplitIn
  } with {
    briefly "LinkStoreToStoreEventSplit"
  }
  connector LinkStoreEventSplitToStoreRepository is {
    from outlet StoreContext.StoreEventSplit.StoreEventSplitToStoreRepository to
      inlet StoreContext.StoreRepository.StoreRepositoryFromStore
  } with {
    briefly "LinkStoreEventSplitToStoreRepository"
  }
  connector LinkStoreEventSplitToOperationsAnalytics is {
    from outlet StoreContext.StoreEventSplit.StoreEventSplitToOperationsAnalytics to
      inlet StoreContext.OperationsAnalytics.OperationsAnalyticsFromStore
  } with {
    briefly "LinkStoreEventSplitToOperationsAnalytics"
  }
  connector LinkOperationsAnalyticsToStoreRepository is {
    from outlet StoreContext.OperationsAnalytics.OperationsAnalyticsOut to
      inlet StoreContext.StoreRepository.StoreRepositoryFromOperationsAnalytics
  } with {
    briefly "LinkOperationsAnalyticsToStoreRepository"
  }
} with {
  briefly "Bounded context for store operations"
  described as {
    | The StoreContext is the bounded context for retail store
    | operations. It manages daily procedures, scheduling, and
    | incident tracking.
  }
}
