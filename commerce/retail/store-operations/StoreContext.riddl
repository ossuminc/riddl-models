// Store Operations - Store Context
context StoreContext as router is {
  type FromFacilitiesServiceCommand is one of {
    Store.AssignTask or Store.CompleteTask
  } with {
    briefly "What FromFacilitiesService turns that service's news into"
  }
  inlet StoreContextFromFacilitiesService is type StoreContext.FromFacilitiesServiceCommand with {
    briefly "What FromFacilitiesService makes of that service's news"
  }
  connector 'FromFacilitiesService Intake' is from outlet StoreContext.FromFacilitiesService.FromFacilitiesServiceToStoreContext to inlet StoreContext.StoreContextFromFacilitiesService with {
    briefly "What FromFacilitiesService makes of that news, on its way in"
  }
  inlet StoreContextFromHRService is command Store.EndShift with {
    briefly "What FromHRService makes of that service's news"
  }
  connector 'FromHRService Intake' is from outlet StoreContext.FromHRService.FromHRServiceToStoreContext to inlet StoreContext.StoreContextFromHRService with {
    briefly "What FromHRService makes of that news, on its way in"
  }
  inlet StoreCommandStreamIn is type StoreCommand  outlet StoreCommandStreamOut is type StoreCommand
  inlet StoreResultStreamIn is result Store.StoreResult  outlet StoreResultStreamOut is result Store.StoreResult
  handler StoreContextBoundary is {
    on openStore: command Store.OpenStore is {
      send openStore to outlet StoreContext.StoreCommandStreamOut
    }
    on closeStore: command Store.CloseStore is {
      send closeStore to outlet StoreContext.StoreCommandStreamOut
    }
    on startShift: command Store.StartShift is {
      send startShift to outlet StoreContext.StoreCommandStreamOut
    }
    on endShift: command Store.EndShift is {
      send endShift to outlet StoreContext.StoreCommandStreamOut
    }
    on openRegister: command Store.OpenRegister is {
      send openRegister to outlet StoreContext.StoreCommandStreamOut
    }
    on closeRegister: command Store.CloseRegister is {
      send closeRegister to outlet StoreContext.StoreCommandStreamOut
    }
    on recordIncident: command Store.RecordIncident is {
      send recordIncident to outlet StoreContext.StoreCommandStreamOut
    }
    on assignTask: command Store.AssignTask is {
      send assignTask to outlet StoreContext.StoreCommandStreamOut
    }
    on completeTask: command Store.CompleteTask is {
      send completeTask to outlet StoreContext.StoreCommandStreamOut
    }
    on storeResult: result Store.StoreResult is {
      send storeResult to outlet StoreContext.StoreResultStreamOut
    }
    on other is {
      error "Unexpected message at the StoreContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'StoreCommand Stream Intake' is from outlet StoreContext.StoreCommandStreamOut to inlet StoreContext.Store.StoreCommands  connector 'StoreResult Stream Egress' is from outlet StoreContext.StoreRepository.StoreRepositoryResponses to inlet StoreContext.StoreResultStreamIn  adaptor FromFacilitiesService from context FacilitiesService as flow is { 
    inlet FromFacilitiesServiceIn is type FacilitiesService.FacilitiesServiceEvent    outlet FromFacilitiesServiceToStoreContext is type StoreContext.FromFacilitiesServiceCommand
    handler FromFacilitiesServiceHandler is {
      on maintenanceCompleted: event FacilitiesService.MaintenanceCompleted is {
        let item0: type Store.CompleteTask = prompt("translate the maintenanceCompleted event into a CompleteTask, work the facility has finished closes the task the store was holding for it")
        send item0 to outlet StoreContext.FromFacilitiesService.FromFacilitiesServiceToStoreContext
      }
      on maintenanceRequired: event FacilitiesService.MaintenanceRequired is {
        let item0: type Store.AssignTask = prompt("translate the maintenanceRequired event into a AssignTask, maintenance the facility flags is work someone in the store must be given")
        send item0 to outlet StoreContext.FromFacilitiesService.FromFacilitiesServiceToStoreContext
      }
      on other is {
        error "Unexpected message for adaptor FromFacilitiesService"
      }
    } with {
      briefly "from facilities service"
      described as {
        |Carries messages from the external FacilitiesService.
      }
    }
  } with {
    briefly "FacilitiesService integration"
    described as {
      |The model's side of the FacilitiesService conversation.
    }
  }
  adaptor FromHRService from context HRService as flow is { 
    inlet FromHRServiceIn is event HRService.EmployeeTerminated    outlet FromHRServiceToStoreContext is command Store.EndShift
    handler FromHRServiceHandler is {
      on employeeTerminated: event HRService.EmployeeTerminated is {
        let item0: type Store.EndShift = prompt("translate the employeeTerminated event into a EndShift, someone no longer employed cannot remain on an open shift")
        send item0 to outlet StoreContext.FromHRService.FromHRServiceToStoreContext
      }
      on other is {
        error "Unexpected message for adaptor FromHRService"
      }
    } with {
      briefly "from hr service"
      described as {
        |Carries messages from the external HRService.
      }
    }
    handler ScheduleEvents is {
      on event HRService.ShiftScheduled is {
        do "Add shift to store schedule"
      }
      on event HRService.ShiftCancelled is {
        do "Remove shift from schedule"
      }
      on other is {
        error "Unexpected message for adaptor HRAdapter"
      }
    } with {
      briefly "Handles HR events"
      described as {
        |Receives scheduling updates from HR.
      }
    }
  } with {
    briefly "HRService integration"
    described as {
      |The model's side of the HRService conversation.
    }
  }
  adaptor FromReportingService from context ReportingService as flow is { 
    inlet FromReportingServiceIn is event ReportingService.ReportGenerated    handler FromReportingServiceHandler is {
      on reportGenerated: event ReportingService.ReportGenerated is {
        do "the report exists; the day it covers was already closed here"
      }
      on other is {
        error "Unexpected message for adaptor FromReportingService"
      }
    } with {
      briefly "from reporting service"
      described as {
        |Carries messages from the external ReportingService.
      }
    }
  } with {
    briefly "ReportingService integration"
    described as {
      |The model's side of the ReportingService conversation.
    }
  }
  adaptor ToReportingService to context ReportingService as flow is { 
    outlet ToReportingServiceOut is command ReportingService.GenerateDailyReport
    handler ToReportingServiceHandler is {
      on storeClosed: event Store.StoreClosed is {
        let item0: type ReportingService.GenerateDailyReport = prompt("translate the storeClosed event into a GenerateDailyReport, the day's close being when there is a day to report on")
        send item0 to outlet StoreContext.ToReportingService.ToReportingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToReportingService"
      }
    } with {
      briefly "to reporting service"
      described as {
        |Carries messages to the external ReportingService.
      }
    }
  } with {
    briefly "ReportingService integration"
    described as {
      |The model's side of the ReportingService conversation.
    }
  }
  adaptor FromSecurityService from context SecurityService as flow is { 
    inlet FromSecurityServiceIn is event SecurityService.SecurityAlertIssued    handler FromSecurityServiceHandler is {
      on securityAlertIssued: event SecurityService.SecurityAlertIssued is {
        do "security has raised it; the store records the incidents it observes itself"
      }
      on other is {
        error "Unexpected message for adaptor FromSecurityService"
      }
    } with {
      briefly "from security service"
      described as {
        |Carries messages from the external SecurityService.
      }
    }
  } with {
    briefly "SecurityService integration"
    described as {
      |The model's side of the SecurityService conversation.
    }
  }
  include "types.riddl"
  include "Store.riddl"
  // Adaptors for external system integration
  adaptor SecurityAdapter to context SecurityService as flow is { 
    outlet SecurityAdapterOut is type SecurityService.SecurityServiceCommand
    handler SecurityNotifications is {
      on storeOpened: event Store.StoreOpened is {
        let item0: type SecurityService.NotifyStoreStatus = prompt("translate the storeOpened event into a NotifyStoreStatus, opening changing whether the premises are attended")
        send item0 to outlet StoreContext.SecurityAdapter.SecurityAdapterOut
      }
      on storeClosed: event Store.StoreClosed is {
        let item0: type SecurityService.NotifyStoreStatus = prompt("translate the storeClosed event into a NotifyStoreStatus, and closing changing it back")
        send item0 to outlet StoreContext.SecurityAdapter.SecurityAdapterOut
      }
      on incidentRecorded: event Store.IncidentRecorded is {
        let item0: type SecurityService.ReportIncident = prompt("translate the incidentRecorded event into a ReportIncident, a recorded incident being what security exists for")
        send item0 to outlet StoreContext.SecurityAdapter.SecurityAdapterOut
      }
      on other is {
        error "Unexpected message for adaptor SecurityAdapter"
      }
    } with {
      briefly "Handles security notifications"
      described as {
        |Sends alerts to security system.
      }
    }
  } with {
    briefly "Security integration"
    described as {
      |Publishes events to security service.
    }
  }
  // Repository for store persistence
  type StoreRepositoryCommand is one of {
    StoreContext.StoreRepository.PersistIncidentRecorded or StoreContext.StoreRepository.PersistRegisterClosed or StoreContext.StoreRepository.PersistRegisterOpened or StoreContext.StoreRepository.PersistShiftEnded or StoreContext.StoreRepository.PersistShiftStarted or StoreContext.StoreRepository.PersistStoreClosed or StoreContext.StoreRepository.PersistStoreOpened or StoreContext.StoreRepository.PersistTaskAssigned or StoreContext.StoreRepository.PersistTaskCompleted
  } with {
    briefly "Anything that writes StoreRepository"
    described as {
      |The persistence commands StoreRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository StoreRepository as flow is {
    inlet StoreRepositoryFromOperationsAnalytics is type StoreRepositoryCommand    command PersistIncidentRecorded is {
      storeId: StoreId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncidentRecorded applies to.
        }
      }
    } with {
      briefly "Persist IncidentRecorded"
      described as {
        |Instructs this repository to apply IncidentRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRegisterOpened is {
      storeId: StoreId with {
        briefly "Row addressed"
        described as {
          |Which stored row RegisterOpened applies to.
        }
      }
    } with {
      briefly "Persist RegisterOpened"
      described as {
        |Instructs this repository to apply RegisterOpened to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShiftEnded is {
      storeId: StoreId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShiftEnded applies to.
        }
      }
    } with {
      briefly "Persist ShiftEnded"
      described as {
        |Instructs this repository to apply ShiftEnded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShiftStarted is {
      storeId: StoreId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShiftStarted applies to.
        }
      }
    } with {
      briefly "Persist ShiftStarted"
      described as {
        |Instructs this repository to apply ShiftStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStoreOpened is {
      storeId: StoreId with {
        briefly "Row addressed"
        described as {
          |Which stored row StoreOpened applies to.
        }
      }
    } with {
      briefly "Persist StoreOpened"
      described as {
        |Instructs this repository to apply StoreOpened to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTaskAssigned is {
      storeId: StoreId with {
        briefly "Row addressed"
        described as {
          |Which stored row TaskAssigned applies to.
        }
      }
    } with {
      briefly "Persist TaskAssigned"
      described as {
        |Instructs this repository to apply TaskAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTaskCompleted is {
      storeId: StoreId with {
        briefly "Row addressed"
        described as {
          |Which stored row TaskCompleted applies to.
        }
      }
    } with {
      briefly "Persist TaskCompleted"
      described as {
        |Instructs this repository to apply TaskCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRegisterClosed is {
      storeId: StoreId with {
        briefly "Row addressed"
        described as {
          |Which stored row RegisterClosed applies to.
        }
      }
    } with {
      briefly "Persist RegisterClosed"
      described as {
        |Instructs this repository to apply RegisterClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStoreClosed is {
      storeId: StoreId with {
        briefly "Row addressed"
        described as {
          |Which stored row StoreClosed applies to.
        }
      }
    } with {
      briefly "Persist StoreClosed"
      described as {
        |Instructs this repository to apply StoreClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet StoreRepositoryResponses is result Store.StoreResult
    record StoredStore is {
      storeId: StoreId with {
        briefly "storeId"
        described as {
          |The storeId column of the stored store row.
        }
      }
      name: String(1,200) with {
        briefly "name"
        described as {
          |The name column of the stored store row.
        }
      }
    } with {
      briefly "Stored store row"
      described as {
        |The persistence shape of store data as this repository stores it.
      }
    }
    schema StoreData is relational
      of stores as record StoredStore
        index on field StoredStore.storeId
        index on field StoredStore.name
 with {
      briefly "Store data schema"
      described as {
        |The relational schema holding store data for the StoreRepository.
      }
    }
    handler StorePersistence is {
      on persistIncidentRecorded: command PersistIncidentRecorded is {
        do "apply IncidentRecorded to the stored row"
      }
      on persistRegisterOpened: command PersistRegisterOpened is {
        do "apply RegisterOpened to the stored row"
      }
      on persistShiftEnded: command PersistShiftEnded is {
        do "apply ShiftEnded to the stored row"
      }
      on persistShiftStarted: command PersistShiftStarted is {
        do "apply ShiftStarted to the stored row"
      }
      on persistStoreOpened: command PersistStoreOpened is {
        do "apply StoreOpened to the stored row"
      }
      on persistTaskAssigned: command PersistTaskAssigned is {
        do "apply TaskAssigned to the stored row"
      }
      on persistTaskCompleted: command PersistTaskCompleted is {
        do "apply TaskCompleted to the stored row"
      }
      on persistRegisterClosed: command PersistRegisterClosed is {
        do "apply RegisterClosed to the stored row"
      }
      on persistStoreClosed: command PersistStoreClosed is {
        do "apply StoreClosed to the stored row"
      }
      on query GetDailyOperationsSummary is {
        let dailyOperationsSummaryView: type DailyOperationsSummaryView = prompt("read the daily operations summary projection")
        reply dailyOperationsSummaryView
      }
    } with {
      briefly "Persists store commands"
      described as {
        |Handles command-driven persistence for stores.
      }
    }
  } with {
    briefly "Store data persistence"
    described as {
      | The StoreRepository provides persistent storage for store
      | operations data.
    }
  }
  // Projector for operations analytics
  query GetDailyOperationsSummary replies result DailyOperationsSummaryView is {
    dailyOperationsSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily operations summary to retrieve.
      }
    }
  } with {
    briefly "Get daily operations summary"
    described as {
      |Retrieves the daily operations summary projection.
    }
  }
  result DailyOperationsSummaryView is {
    dailyOperationsSummary: OperationsAnalytics.DailyOperationsSummary with {
      briefly "Daily operations summary"
      described as {
        |The daily operations summary being returned.
      }
    }
  } with {
    briefly "Daily operations summary view"
    described as {
      |Read model view carrying the daily operations summary projection.
    }
  }
  projector OperationsAnalytics as flow is {
    updates repository StoreContext.StoreRepository
    outlet OperationsAnalyticsToRepository is type StoreRepositoryCommand
    inlet OperationsAnalyticsFromStore is type StoreEvent    record DailyOperationsSummary is {
      storeId: StoreId with {
        briefly "Store"
        described as {
          |Store ID.
        }
      }
      date: Date with {
        briefly "Date"
        described as {
          |Operations date.
        }
      }
      hoursOpen: Decimal(4,2) with {
        briefly "Hours"
        described as {
          |Hours open.
        }
      }
      staffHours: Decimal(6,2) with {
        briefly "Staff hours"
        described as {
          |Total staff hours.
        }
      }
      incidentCount: Natural with {
        briefly "Incidents"
        described as {
          |Number of incidents.
        }
      }
      cashVariance: Money with {
        briefly "Variance"
        described as {
          |Total cash variance.
        }
      }
    } with {
      briefly "Daily operations summary"
      described as {
        |Aggregated daily operations metrics.
      }
    }
    handler AnalyticsHandler is {
      on incidentRecorded: event Store.IncidentRecorded is {
        tell command StoreContext.StoreRepository.PersistIncidentRecorded(storeId = incidentRecorded.storeId) to repository StoreContext.StoreRepository
        do "apply IncidentRecorded to the OperationsAnalytics projection"
      }
      on registerOpened: event Store.RegisterOpened is {
        tell command StoreContext.StoreRepository.PersistRegisterOpened(storeId = registerOpened.storeId) to repository StoreContext.StoreRepository
        do "apply RegisterOpened to the OperationsAnalytics projection"
      }
      on shiftEnded: event Store.ShiftEnded is {
        tell command StoreContext.StoreRepository.PersistShiftEnded(storeId = shiftEnded.storeId) to repository StoreContext.StoreRepository
        do "apply ShiftEnded to the OperationsAnalytics projection"
      }
      on shiftStarted: event Store.ShiftStarted is {
        tell command StoreContext.StoreRepository.PersistShiftStarted(storeId = shiftStarted.storeId) to repository StoreContext.StoreRepository
        do "apply ShiftStarted to the OperationsAnalytics projection"
      }
      on storeOpened: event Store.StoreOpened is {
        tell command StoreContext.StoreRepository.PersistStoreOpened(storeId = storeOpened.storeId) to repository StoreContext.StoreRepository
        do "apply StoreOpened to the OperationsAnalytics projection"
      }
      on taskAssigned: event Store.TaskAssigned is {
        tell command StoreContext.StoreRepository.PersistTaskAssigned(storeId = taskAssigned.storeId) to repository StoreContext.StoreRepository
        do "apply TaskAssigned to the OperationsAnalytics projection"
      }
      on taskCompleted: event Store.TaskCompleted is {
        tell command StoreContext.StoreRepository.PersistTaskCompleted(storeId = taskCompleted.storeId) to repository StoreContext.StoreRepository
        do "apply TaskCompleted to the OperationsAnalytics projection"
      }
      on storeClosed: event Store.StoreClosed is {
        tell command StoreContext.StoreRepository.PersistStoreClosed(storeId = storeClosed.storeId) to repository StoreContext.StoreRepository
        do "Finalize daily operations summary"
      }
      on registerClosed: event Store.RegisterClosed is {
        tell command StoreContext.StoreRepository.PersistRegisterClosed(storeId = registerClosed.storeId) to repository StoreContext.StoreRepository
        do "Update cash variance metrics"
      }
    } with {
      briefly "Maintains operations analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Operations analytics projections"
    described as {
      |Maintains summarized operations data.
    }
  }
  // ---- Event publication for Store ----
  type StoreEvent is one of {
    StoreContext.Store.StoreOpened or StoreContext.Store.StoreClosed or StoreContext.Store.ShiftStarted or StoreContext.Store.ShiftEnded or StoreContext.Store.RegisterOpened or StoreContext.Store.RegisterClosed or StoreContext.Store.IncidentRecorded or StoreContext.Store.TaskAssigned or StoreContext.Store.TaskCompleted
  } with {
    briefly "Store event alternation"
    described as {
      |Union of all Store events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet StoreEventSplit as flow is {
    inlet StoreEventSplitIn is type StoreEvent    outlet StoreEventSplitToOperationsAnalytics is type StoreEvent
    handler StoreEventSplitHandler is {
      on storeOpened: event Store.StoreOpened is {
        send storeOpened to outlet StoreEventSplitToOperationsAnalytics
        tell storeOpened to entity StoreContext.Store
      }
      on storeClosed: event Store.StoreClosed is {
        send storeClosed to outlet StoreEventSplitToOperationsAnalytics
        tell storeClosed to entity StoreContext.Store
      }
      on shiftStarted: event Store.ShiftStarted is {
        send shiftStarted to outlet StoreEventSplitToOperationsAnalytics
        tell shiftStarted to entity StoreContext.Store
      }
      on shiftEnded: event Store.ShiftEnded is {
        send shiftEnded to outlet StoreEventSplitToOperationsAnalytics
        tell shiftEnded to entity StoreContext.Store
      }
      on registerOpened: event Store.RegisterOpened is {
        send registerOpened to outlet StoreEventSplitToOperationsAnalytics
        tell registerOpened to entity StoreContext.Store
      }
      on registerClosed: event Store.RegisterClosed is {
        send registerClosed to outlet StoreEventSplitToOperationsAnalytics
        tell registerClosed to entity StoreContext.Store
      }
      on incidentRecorded: event Store.IncidentRecorded is {
        send incidentRecorded to outlet StoreEventSplitToOperationsAnalytics
        tell incidentRecorded to entity StoreContext.Store
      }
      on taskAssigned: event Store.TaskAssigned is {
        send taskAssigned to outlet StoreEventSplitToOperationsAnalytics
        tell taskAssigned to entity StoreContext.Store
      }
      on taskCompleted: event Store.TaskCompleted is {
        send taskCompleted to outlet StoreEventSplitToOperationsAnalytics
        tell taskCompleted to entity StoreContext.Store
      }
      on other is {
        error "Unexpected message for processor StoreEventSplit"
      }
    } with {
      briefly "Store event fan-out handler"
      described as {
        |Delivers each Store event to all of its consumers.
      }
    }
  } with {
    briefly "Store event fan-out"
    described as {
      |Fans Store events out to the repository and projectors.
    }
  }
  connector 'StoreEvent Stream' is from outlet StoreContext.Store.StoreEvents2 to inlet StoreContext.StoreEventSplit.StoreEventSplitIn with {
    briefly "Store events, fanned out to storage and read models"
  }
  connector 'OperationsAnalytics Feed' is from outlet StoreContext.StoreEventSplit.StoreEventSplitToOperationsAnalytics to inlet StoreContext.OperationsAnalytics.OperationsAnalyticsFromStore with {
    briefly "Store events feeding the OperationsAnalytics projection"
  }
  connector 'OperationsAnalytics Storage' is from outlet StoreContext.OperationsAnalytics.OperationsAnalyticsToRepository to inlet StoreContext.StoreRepository.StoreRepositoryFromOperationsAnalytics with {
    briefly "OperationsAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for store operations"
  described as {
    | The StoreContext is the bounded context for retail store
    | operations. It manages daily procedures, scheduling, and
    | incident tracking.
  }
}
