// Point of Sale - POS Context
context POSContext as router is {
  inlet TransactionCommandStreamIn is type TransactionCommand  outlet TransactionCommandStreamOut is type TransactionCommand
  inlet TransactionResultStreamIn is type Transaction.TransactionResult  outlet TransactionResultStreamOut is type Transaction.TransactionResult
  handler POSContextBoundary is {
    on startTransaction: command Transaction.StartTransaction is {
      send startTransaction to outlet POSContext.TransactionCommandStreamOut
    }
    on addLineItem: command Transaction.AddLineItem is {
      send addLineItem to outlet POSContext.TransactionCommandStreamOut
    }
    on voidLineItem: command Transaction.VoidLineItem is {
      send voidLineItem to outlet POSContext.TransactionCommandStreamOut
    }
    on applyDiscount: command Transaction.ApplyDiscount is {
      send applyDiscount to outlet POSContext.TransactionCommandStreamOut
    }
    on processPayment: command Transaction.ProcessPayment is {
      send processPayment to outlet POSContext.TransactionCommandStreamOut
    }
    on completeTransaction: command Transaction.CompleteTransaction is {
      send completeTransaction to outlet POSContext.TransactionCommandStreamOut
    }
    on voidTransaction: command Transaction.VoidTransaction is {
      send voidTransaction to outlet POSContext.TransactionCommandStreamOut
    }
    on suspendTransaction: command Transaction.SuspendTransaction is {
      send suspendTransaction to outlet POSContext.TransactionCommandStreamOut
    }
    on resumeTransaction: command Transaction.ResumeTransaction is {
      send resumeTransaction to outlet POSContext.TransactionCommandStreamOut
    }
    on transactionResult: result Transaction.TransactionResult is {
      send transactionResult to outlet POSContext.TransactionResultStreamOut
    }
    on other is {
      error "Unexpected message at the POSContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TransactionCommand Stream Intake' is from outlet POSContext.TransactionCommandStreamOut to inlet POSContext.Transaction.TransactionCommands  connector 'TransactionResult Stream Egress' is from outlet POSContext.TransactionRepository.TransactionRepositoryResponses to inlet POSContext.TransactionResultStreamIn  adaptor FromInventoryService from context InventoryService is { 
    handler FromInventoryServiceHandler is {
      on event InventoryService.StockDeducted is {
        do "the model receives stock deducted"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromPaymentGateway from context PaymentGateway is { 
    handler FromPaymentGatewayHandler is {
      on event PaymentGateway.PaymentAuthorized is {
        do "the model receives payment authorized"
      }
      on event PaymentGateway.PaymentDeclined is {
        do "the model receives payment declined"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentGateway"
      }
    } with {
      briefly "from payment gateway"
      described as {
        |Carries messages from the external PaymentGateway.
      }
    }
  } with {
    briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor ToPaymentGateway to context PaymentGateway is { 
    handler ToPaymentGatewayHandler is {
      on command PaymentGateway.RefundPayment is {
        do "the model sends refund payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentGateway"
      }
    } with {
      briefly "to payment gateway"
      described as {
        |Carries messages to the external PaymentGateway.
      }
    }
    handler PaymentProcessing is {
      on command PaymentGateway.AuthorizePayment is {
        do "Authorize card payment"
      }
      on command PaymentGateway.CapturePayment is {
        do "Capture authorized payment"
      }
      on other is {
        error "Unexpected message for adaptor PaymentAdapter"
      }
    } with {
      briefly "Handles payment processing"
      described as {
        |Processes card payments through gateway.
      }
    }
  } with {
    briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor FromPricingService from context PricingService is { 
    handler FromPricingServiceHandler is {
      on event PricingService.PriceRetrieved is {
        do "the model receives price retrieved"
      }
      on event PricingService.PromotionApplied is {
        do "the model receives promotion applied"
      }
      on other is {
        error "Unexpected message for adaptor FromPricingService"
      }
    } with {
      briefly "from pricing service"
      described as {
        |Carries messages from the external PricingService.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  adaptor FromReceiptService from context ReceiptService is { 
    handler FromReceiptServiceHandler is {
      on event ReceiptService.ReceiptGenerated is {
        do "the model receives receipt generated"
      }
      on other is {
        error "Unexpected message for adaptor FromReceiptService"
      }
    } with {
      briefly "from receipt service"
      described as {
        |Carries messages from the external ReceiptService.
      }
    }
  } with {
    briefly "ReceiptService integration"
    described as {
      |The model's side of the ReceiptService conversation.
    }
  }
  adaptor ToReceiptService to context ReceiptService is { 
    handler ToReceiptServiceHandler is {
      on command ReceiptService.EmailReceipt is {
        do "the model sends email receipt"
      }
      on other is {
        error "Unexpected message for adaptor ToReceiptService"
      }
    } with {
      briefly "to receipt service"
      described as {
        |Carries messages to the external ReceiptService.
      }
    }
    handler ReceiptGeneration is {
      on command ReceiptService.GenerateReceipt is {
        do "Generate and print receipt"
      }
      on other is {
        error "Unexpected message for adaptor ReceiptAdapter"
      }
    } with {
      briefly "Handles receipt generation"
      described as {
        |Generates receipts for completed sales.
      }
    }
  } with {
    briefly "ReceiptService integration"
    described as {
      |The model's side of the ReceiptService conversation.
    }
  }
  include "types.riddl"
  include "Transaction.riddl"
  // Adaptors for external system integration
  adaptor InventoryAdapter to context InventoryService is { 
    handler InventoryUpdates is {
      on command InventoryService.DeductStock is {
        do "Deduct sold items from inventory"
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles inventory updates"
      described as {
        |Updates inventory for completed sales.
      }
    }
  } with {
    briefly "Inventory integration"
    described as {
      |Publishes sales for inventory deduction.
    }
  }
  // Repository for transaction persistence
  repository TransactionRepository as merge is {
    command PersistTransactionCompleted is  {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransactionCompleted applies to.
        }
      }
    } with {
      briefly "Persist TransactionCompleted"
      described as {
        |Instructs this repository to apply TransactionCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet TransactionRepositoryFromTransaction is type TransactionEvent    inlet TransactionRepositoryFromSalesAnalytics is type TransactionEvent    outlet TransactionRepositoryResponses is type Transaction.TransactionResult
    record StoredTransaction is  {
      transactionId: TransactionId with {
        briefly "transactionId"
        described as {
          |The transactionId column of the stored transaction row.
        }
      }
      cashierId: CashierId with {
        briefly "cashierId"
        described as {
          |The cashierId column of the stored transaction row.
        }
      }
      terminalId: TerminalId with {
        briefly "terminalId"
        described as {
          |The terminalId column of the stored transaction row.
        }
      }
    } with {
      briefly "Stored transaction row"
      described as {
        |The persistence shape of transaction data as this repository stores it.
      }
    }
    schema TransactionData is relational
      of transactions as type StoredTransaction
        index on field StoredTransaction.terminalId
        index on field StoredTransaction.cashierId
        index on field StoredTransaction.transactionId
 with {
      briefly "Transaction data schema"
      described as {
        |The relational schema holding transaction data for the TransactionRepository.
      }
    }
    handler TransactionPersistence is {
      on persistTransactionCompleted: command PersistTransactionCompleted is {
        do "apply TransactionCompleted to the stored row"
      }
      on query GetDailySalesSummary is {
        let dailySalesSummaryView: type DailySalesSummaryView = prompt("read the daily sales summary projection")
        reply dailySalesSummaryView
      }
      on startTransaction: command Transaction.StartTransaction is {
        tell event Transaction.TransactionStarted(transactionId = startTransaction.transactionId, terminalId = startTransaction.terminalId, cashierId = startTransaction.cashierId) to entity POSContext.Transaction
        do "Create new transaction record"
      }
      on addLineItem: command Transaction.AddLineItem is {
        tell event Transaction.LineItemAdded(transactionId = addLineItem.transactionId) to entity POSContext.Transaction
        do "Add line item to transaction"
      }
      on processPayment: command Transaction.ProcessPayment is {
        tell event Transaction.PaymentProcessed(transactionId = processPayment.transactionId, tender = processPayment.tender) to entity POSContext.Transaction
        do "Record payment"
      }
      on completeTransaction: command Transaction.CompleteTransaction is {
        tell event Transaction.TransactionCompleted(transactionId = completeTransaction.transactionId) to entity POSContext.Transaction
        do "Finalize transaction record"
      }
      on command Transaction.VoidTransaction is {
        do "Mark transaction as voided"
      }
    } with {
      briefly "Persists transaction commands"
      described as {
        |Handles command-driven persistence for transactions.
      }
    }
  } with {
    briefly "Transaction data persistence"
    described as {
      | The TransactionRepository provides persistent storage for
      | POS transactions with indexes for terminal and cashier lookup.
    }
  }
  // Projector for sales analytics
  query GetDailySalesSummary replies result DailySalesSummaryView is  {
    dailySalesSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily sales summary to retrieve.
      }
    }
  } with {
    briefly "Get daily sales summary"
    described as {
      |Retrieves the daily sales summary projection.
    }
  }
  result DailySalesSummaryView is  {
    dailySalesSummary: SalesAnalytics.DailySalesSummary with {
      briefly "Daily sales summary"
      described as {
        |The daily sales summary being returned.
      }
    }
  } with {
    briefly "Daily sales summary view"
    described as {
      |Read model view carrying the daily sales summary projection.
    }
  }
  projector SalesAnalytics as flow is {
    updates repository POSContext.TransactionRepository
    inlet SalesAnalyticsFromTransaction is type TransactionEvent    outlet SalesAnalyticsOut is type TransactionEvent
    record DailySalesSummary is  {
      date: Date with {
        briefly "Date"
        described as {
          |Sales date.
        }
      }
      terminalId: TerminalId with {
        briefly "Terminal"
        described as {
          |Terminal ID.
        }
      }
      transactionCount: Natural with {
        briefly "Count"
        described as {
          |Number of transactions.
        }
      }
      grossSales: Money with {
        briefly "Gross"
        described as {
          |Gross sales.
        }
      }
      totalDiscounts: Money with {
        briefly "Discounts"
        described as {
          |Total discounts.
        }
      }
      netSales: Money with {
        briefly "Net"
        described as {
          |Net sales.
        }
      }
      taxCollected: Money with {
        briefly "Tax"
        described as {
          |Tax collected.
        }
      }
    } with {
      briefly "Daily sales summary"
      described as {
        |Aggregated daily sales by terminal.
      }
    }
    handler AnalyticsHandler is {
      on transactionCompleted: event Transaction.TransactionCompleted is {
        tell command POSContext.TransactionRepository.PersistTransactionCompleted(transactionId = transactionCompleted.transactionId) to repository POSContext.TransactionRepository
        do "Update daily sales summary"
      }
    } with {
      briefly "Maintains sales analytics"
      described as {
        |Projects transactions into analytics.
      }
    }
  } with {
    briefly "Sales analytics projections"
    described as {
      |Maintains summarized sales data.
    }
  }
  // ---- Event publication for Transaction ----
  type TransactionEvent is one of {
    POSContext.Transaction.TransactionStarted or POSContext.Transaction.LineItemAdded or POSContext.Transaction.LineItemVoided or POSContext.Transaction.DiscountApplied or POSContext.Transaction.PaymentProcessed or POSContext.Transaction.TransactionCompleted or POSContext.Transaction.TransactionVoided or POSContext.Transaction.TransactionSuspended or POSContext.Transaction.TransactionResumed
  } with {
    briefly "Transaction event alternation"
    described as {
      |Union of all Transaction events, for streaming and event-sourced
      |persistence.
    }
  }
  processor TransactionEventSource as source is {
    outlet TransactionEvents is type TransactionEvent
    handler TransactionSourceHandler is {
      on transactionStarted: event Transaction.TransactionStarted is {
        send transactionStarted to outlet TransactionEvents
      }
      on lineItemAdded: event Transaction.LineItemAdded is {
        send lineItemAdded to outlet TransactionEvents
      }
      on lineItemVoided: event Transaction.LineItemVoided is {
        send lineItemVoided to outlet TransactionEvents
      }
      on discountApplied: event Transaction.DiscountApplied is {
        send discountApplied to outlet TransactionEvents
      }
      on paymentProcessed: event Transaction.PaymentProcessed is {
        send paymentProcessed to outlet TransactionEvents
      }
      on transactionCompleted: event Transaction.TransactionCompleted is {
        send transactionCompleted to outlet TransactionEvents
      }
      on transactionVoided: event Transaction.TransactionVoided is {
        send transactionVoided to outlet TransactionEvents
      }
      on transactionSuspended: event Transaction.TransactionSuspended is {
        send transactionSuspended to outlet TransactionEvents
      }
      on transactionResumed: event Transaction.TransactionResumed is {
        send transactionResumed to outlet TransactionEvents
      }
      on other is {
        error "Unexpected message for source TransactionEventSource"
      }
    } with {
      briefly "Transaction source handler"
      described as {
        |Publishes Transaction events onto the outlet.
      }
    }
  } with {
    briefly "Transaction event source"
    described as {
      |Publishes Transaction entity events into the streaming topology.
    }
  }
  processor TransactionEventSink as sink is {
    inlet TransactionInlet is type TransactionEvent    handler TransactionSinkHandler is {
      on transactionStarted: event Transaction.TransactionStarted is {
        tell transactionStarted to repository POSContext.TransactionRepository
      }
      on lineItemAdded: event Transaction.LineItemAdded is {
        tell lineItemAdded to repository POSContext.TransactionRepository
      }
      on lineItemVoided: event Transaction.LineItemVoided is {
        tell lineItemVoided to repository POSContext.TransactionRepository
      }
      on discountApplied: event Transaction.DiscountApplied is {
        tell discountApplied to repository POSContext.TransactionRepository
      }
      on paymentProcessed: event Transaction.PaymentProcessed is {
        tell paymentProcessed to repository POSContext.TransactionRepository
      }
      on transactionCompleted: event Transaction.TransactionCompleted is {
        tell transactionCompleted to repository POSContext.TransactionRepository
      }
      on transactionVoided: event Transaction.TransactionVoided is {
        tell transactionVoided to repository POSContext.TransactionRepository
      }
      on transactionSuspended: event Transaction.TransactionSuspended is {
        tell transactionSuspended to repository POSContext.TransactionRepository
      }
      on transactionResumed: event Transaction.TransactionResumed is {
        tell transactionResumed to repository POSContext.TransactionRepository
      }
      on other is {
        error "Unexpected message for sink TransactionEventSink"
      }
    } with {
      briefly "Transaction sink handler"
      described as {
        |Persists Transaction events via the repository.
      }
    }
  } with {
    briefly "Transaction event sink"
    described as {
      |Receives Transaction events for persistence.
    }
  }
  connector TransactionEventFlow is from outlet POSContext.TransactionEventSource.TransactionEvents to inlet POSContext.TransactionEventSink.TransactionInlet with {
    briefly "Transaction event flow"
    described as {
      |Connects the Transaction source to its sink.
    }
  }
  processor TransactionEventSplit as split is {
    inlet TransactionEventSplitIn is type TransactionEvent    outlet TransactionEventSplitToTransactionRepository is type TransactionEvent
    outlet TransactionEventSplitToSalesAnalytics is type TransactionEvent
    handler TransactionEventSplitHandler is {
      on transactionStarted: event Transaction.TransactionStarted is {
        send transactionStarted to outlet TransactionEventSplitToTransactionRepository
        send transactionStarted to outlet TransactionEventSplitToSalesAnalytics
        tell transactionStarted to entity POSContext.Transaction
      }
      on lineItemAdded: event Transaction.LineItemAdded is {
        send lineItemAdded to outlet TransactionEventSplitToTransactionRepository
        send lineItemAdded to outlet TransactionEventSplitToSalesAnalytics
        tell lineItemAdded to entity POSContext.Transaction
      }
      on lineItemVoided: event Transaction.LineItemVoided is {
        send lineItemVoided to outlet TransactionEventSplitToTransactionRepository
        send lineItemVoided to outlet TransactionEventSplitToSalesAnalytics
        tell lineItemVoided to entity POSContext.Transaction
      }
      on discountApplied: event Transaction.DiscountApplied is {
        send discountApplied to outlet TransactionEventSplitToTransactionRepository
        send discountApplied to outlet TransactionEventSplitToSalesAnalytics
        tell discountApplied to entity POSContext.Transaction
      }
      on paymentProcessed: event Transaction.PaymentProcessed is {
        send paymentProcessed to outlet TransactionEventSplitToTransactionRepository
        send paymentProcessed to outlet TransactionEventSplitToSalesAnalytics
        tell paymentProcessed to entity POSContext.Transaction
      }
      on transactionCompleted: event Transaction.TransactionCompleted is {
        send transactionCompleted to outlet TransactionEventSplitToTransactionRepository
        send transactionCompleted to outlet TransactionEventSplitToSalesAnalytics
        tell transactionCompleted to entity POSContext.Transaction
      }
      on transactionVoided: event Transaction.TransactionVoided is {
        send transactionVoided to outlet TransactionEventSplitToTransactionRepository
        send transactionVoided to outlet TransactionEventSplitToSalesAnalytics
        tell transactionVoided to entity POSContext.Transaction
      }
      on transactionSuspended: event Transaction.TransactionSuspended is {
        send transactionSuspended to outlet TransactionEventSplitToTransactionRepository
        send transactionSuspended to outlet TransactionEventSplitToSalesAnalytics
        tell transactionSuspended to entity POSContext.Transaction
      }
      on transactionResumed: event Transaction.TransactionResumed is {
        send transactionResumed to outlet TransactionEventSplitToTransactionRepository
        send transactionResumed to outlet TransactionEventSplitToSalesAnalytics
        tell transactionResumed to entity POSContext.Transaction
      }
      on other is {
        error "Unexpected message for processor TransactionEventSplit"
      }
    } with {
      briefly "Transaction event fan-out handler"
      described as {
        |Delivers each Transaction event to all of its consumers.
      }
    }
  } with {
    briefly "Transaction event fan-out"
    described as {
      |Fans Transaction events out to the repository and projectors.
    }
  }
  connector 'TransactionEvent Stream' is from outlet POSContext.Transaction.TransactionEvents2 to inlet POSContext.TransactionEventSplit.TransactionEventSplitIn with {
    briefly "Transaction events, fanned out to storage and read models"
  }
  connector 'TransactionEvent Storage' is from outlet POSContext.TransactionEventSplit.TransactionEventSplitToTransactionRepository to inlet POSContext.TransactionRepository.TransactionRepositoryFromTransaction with {
    briefly "Transaction events on their way to storage"
  }
  connector 'SalesAnalytics Feed' is from outlet POSContext.TransactionEventSplit.TransactionEventSplitToSalesAnalytics to inlet POSContext.SalesAnalytics.SalesAnalyticsFromTransaction with {
    briefly "Transaction events feeding the SalesAnalytics projection"
  }
  connector 'SalesAnalytics Storage' is from outlet POSContext.SalesAnalytics.SalesAnalyticsOut to inlet POSContext.TransactionRepository.TransactionRepositoryFromSalesAnalytics with {
    briefly "The SalesAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for point of sale"
  described as {
    | The POSContext is the bounded context for retail transaction
    | processing. It manages transactions, payments, and receipts.
  }
}
