// Point of Sale - POS Context
context POSContext as router is {
  inlet POSContextFromPaymentGateway is command Transaction.ProcessPayment with {
    briefly "What FromPaymentGateway makes of that service's news"
  }
  connector 'FromPaymentGateway Intake' is from outlet POSContext.FromPaymentGateway.FromPaymentGatewayToPOSContext to inlet POSContext.POSContextFromPaymentGateway with {
    briefly "What FromPaymentGateway makes of that news, on its way in"
  }
  inlet POSContextFromPricingService is command Transaction.ApplyDiscount with {
    briefly "What FromPricingService makes of that service's news"
  }
  connector 'FromPricingService Intake' is from outlet POSContext.FromPricingService.FromPricingServiceToPOSContext to inlet POSContext.POSContextFromPricingService with {
    briefly "What FromPricingService makes of that news, on its way in"
  }
  inlet TransactionCommandStreamIn is type TransactionCommand  outlet TransactionCommandStreamOut is type TransactionCommand
  inlet TransactionResultStreamIn is result Transaction.TransactionResult  outlet TransactionResultStreamOut is result Transaction.TransactionResult
  handler POSContextBoundary is {
    on startTransaction: command Transaction.StartTransaction is {
      send startTransaction to outlet POSContext.TransactionCommandStreamOut
    }
    on addLineItem: command Transaction.AddLineItem is {
      send addLineItem to outlet POSContext.TransactionCommandStreamOut
    }
    on voidLineItem: command Transaction.VoidLineItem is {
      send voidLineItem to outlet POSContext.TransactionCommandStreamOut
    }
    on applyDiscount: command Transaction.ApplyDiscount is {
      send applyDiscount to outlet POSContext.TransactionCommandStreamOut
    }
    on processPayment: command Transaction.ProcessPayment is {
      send processPayment to outlet POSContext.TransactionCommandStreamOut
    }
    on completeTransaction: command Transaction.CompleteTransaction is {
      send completeTransaction to outlet POSContext.TransactionCommandStreamOut
    }
    on voidTransaction: command Transaction.VoidTransaction is {
      send voidTransaction to outlet POSContext.TransactionCommandStreamOut
    }
    on suspendTransaction: command Transaction.SuspendTransaction is {
      send suspendTransaction to outlet POSContext.TransactionCommandStreamOut
    }
    on resumeTransaction: command Transaction.ResumeTransaction is {
      send resumeTransaction to outlet POSContext.TransactionCommandStreamOut
    }
    on transactionResult: result Transaction.TransactionResult is {
      send transactionResult to outlet POSContext.TransactionResultStreamOut
    }
    on other is {
      error "Unexpected message at the POSContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TransactionCommand Stream Intake' is from outlet POSContext.TransactionCommandStreamOut to inlet POSContext.Transaction.TransactionCommands  connector 'TransactionResult Stream Egress' is from outlet POSContext.TransactionRepository.TransactionRepositoryResponses to inlet POSContext.TransactionResultStreamIn  adaptor FromInventoryService from context InventoryService is { 
    inlet FromInventoryServiceIn is event InventoryService.StockDeducted    handler FromInventoryServiceHandler is {
      on stockDeducted: event InventoryService.StockDeducted is {
        do "the sale is already recorded; stock agreeing is confirmation, not a change"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromPaymentGateway from context PaymentGateway as flow is { 
    inlet FromPaymentGatewayIn is type PaymentGateway.PaymentGatewayEvent    outlet FromPaymentGatewayToPOSContext is command Transaction.ProcessPayment
    handler FromPaymentGatewayHandler is {
      on paymentAuthorized: event PaymentGateway.PaymentAuthorized is {
        let item0: type Transaction.ProcessPayment = prompt("translate the paymentAuthorized event into a ProcessPayment, an authorised card is what lets the transaction record a payment against itself")
        send item0 to outlet POSContext.FromPaymentGateway.FromPaymentGatewayToPOSContext
      }
      on paymentDeclined: event PaymentGateway.PaymentDeclined is {
        do "a declined tender leaves the sale open for another; the cashier decides what happens next"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentGateway"
      }
    } with {
      briefly "from payment gateway"
      described as {
        |Carries messages from the external PaymentGateway.
      }
    }
  } with {
    briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor ToPaymentGateway to context PaymentGateway as flow is { 
    inlet ToPaymentGatewayIn is type TransactionEvent    outlet ToPaymentGatewayOut is type PaymentGateway.PaymentGatewayCommand
    handler ToPaymentGatewayHandler is {
      on transactionVoided: event TransactionVoided is {
        let notice: type PaymentGateway.RefundPayment = prompt("translate the transactionVoided event into a RefundPayment returning anything already tendered on a transaction that has been voided")
        send notice to outlet POSContext.ToPaymentGateway.ToPaymentGatewayOut
      }
      on paymentProcessed: event PaymentProcessed is {
        let notice: type PaymentGateway.AuthorizePayment = prompt("translate the paymentProcessed event into an AuthorizePayment holding the tender the customer has just presented")
        send notice to outlet POSContext.ToPaymentGateway.ToPaymentGatewayOut
      }
      on transactionCompleted: event TransactionCompleted is {
        let notice: type PaymentGateway.CapturePayment = prompt("translate the transactionCompleted event into a CapturePayment taking the authorized tender now that the sale total is final")
        send notice to outlet POSContext.ToPaymentGateway.ToPaymentGatewayOut
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentGateway"
      }
    } with {
      briefly "to payment gateway"
      described as {
        |Carries messages to the external PaymentGateway.
      }
    }
  } with {
    briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor FromPricingService from context PricingService as flow is { 
    inlet FromPricingServiceIn is type PricingService.PricingServiceEvent    outlet FromPricingServiceToPOSContext is command Transaction.ApplyDiscount
    handler FromPricingServiceHandler is {
      on priceRetrieved: event PricingService.PriceRetrieved is {
        do "a retrieved price is used as the line is added; on its own it changes nothing"
      }
      on promotionApplied: event PricingService.PromotionApplied is {
        let item0: type Transaction.ApplyDiscount = prompt("translate the promotionApplied event into a ApplyDiscount, a promotion the pricing service grants must appear as a discount on the sale or the totals disagree")
        send item0 to outlet POSContext.FromPricingService.FromPricingServiceToPOSContext
      }
      on other is {
        error "Unexpected message for adaptor FromPricingService"
      }
    } with {
      briefly "from pricing service"
      described as {
        |Carries messages from the external PricingService.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  adaptor FromReceiptService from context ReceiptService is { 
    inlet FromReceiptServiceIn is event ReceiptService.ReceiptGenerated    handler FromReceiptServiceHandler is {
      on receiptGenerated: event ReceiptService.ReceiptGenerated is {
        do "the receipt exists; the sale was already complete when it was asked for"
      }
      on other is {
        error "Unexpected message for adaptor FromReceiptService"
      }
    } with {
      briefly "from receipt service"
      described as {
        |Carries messages from the external ReceiptService.
      }
    }
  } with {
    briefly "ReceiptService integration"
    described as {
      |The model's side of the ReceiptService conversation.
    }
  }
  adaptor ToReceiptService to context ReceiptService as flow is { 
    inlet ToReceiptServiceIn is type TransactionEvent    outlet ToReceiptServiceOut is type ReceiptService.ReceiptServiceCommand
    handler ToReceiptServiceHandler is {
      on transactionCompleted: event Transaction.TransactionCompleted is {
        let item0: type ReceiptService.GenerateReceipt = prompt("translate the transactionCompleted event into a GenerateReceipt, completion being when there is a total to print")
        send item0 to outlet POSContext.ToReceiptService.ToReceiptServiceOut
        let item1: type ReceiptService.EmailReceipt = prompt("translate the transactionCompleted event into a EmailReceipt, and when the customer can be sent it")
        send item1 to outlet POSContext.ToReceiptService.ToReceiptServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToReceiptService"
      }
    } with {
      briefly "to receipt service"
      described as {
        |Carries messages to the external ReceiptService.
      }
    }
    handler ReceiptGeneration is {
      on command ReceiptService.GenerateReceipt is {
        do "Generate and print receipt"
      }
      on other is {
        error "Unexpected message for adaptor ReceiptAdapter"
      }
    } with {
      briefly "Handles receipt generation"
      described as {
        |Generates receipts for completed sales.
      }
    }
  } with {
    briefly "ReceiptService integration"
    described as {
      |The model's side of the ReceiptService conversation.
    }
  }
  include "types.riddl"
  include "Transaction.riddl"
  // Adaptors for external system integration
  adaptor InventoryAdapter to context InventoryService as flow is { 
    inlet InventoryAdapterIn is type TransactionEvent    outlet InventoryAdapterOut is command InventoryService.DeductStock
    handler InventoryUpdates is {
      on transactionCompleted: event Transaction.TransactionCompleted is {
        let movement: type InventoryService.DeductStock = prompt("translate the transactionCompleted event into a DeductStock taking the sold goods out of stock, the sale being final at completion")
        send movement to outlet POSContext.InventoryAdapter.InventoryAdapterOut
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles inventory updates"
      described as {
        |Updates inventory for completed sales.
      }
    }
  } with {
    briefly "Inventory integration"
    described as {
      |Publishes sales for inventory deduction.
    }
  }
  // Repository for transaction persistence
  type TransactionRepositoryCommand is one of {
    POSContext.TransactionRepository.PersistDiscountApplied or POSContext.TransactionRepository.PersistLineItemAdded or POSContext.TransactionRepository.PersistLineItemVoided or POSContext.TransactionRepository.PersistPaymentProcessed or POSContext.TransactionRepository.PersistTransactionCompleted or POSContext.TransactionRepository.PersistTransactionResumed or POSContext.TransactionRepository.PersistTransactionStarted or POSContext.TransactionRepository.PersistTransactionSuspended or POSContext.TransactionRepository.PersistTransactionVoided
  } with {
    briefly "Anything that writes TransactionRepository"
    described as {
      |The persistence commands TransactionRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository TransactionRepository as flow is {
    inlet TransactionRepositoryFromSalesAnalytics is type TransactionRepositoryCommand    command PersistDiscountApplied is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row DiscountApplied applies to.
        }
      }
    } with {
      briefly "Persist DiscountApplied"
      described as {
        |Instructs this repository to apply DiscountApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLineItemAdded is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row LineItemAdded applies to.
        }
      }
    } with {
      briefly "Persist LineItemAdded"
      described as {
        |Instructs this repository to apply LineItemAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLineItemVoided is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row LineItemVoided applies to.
        }
      }
    } with {
      briefly "Persist LineItemVoided"
      described as {
        |Instructs this repository to apply LineItemVoided to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentProcessed is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentProcessed applies to.
        }
      }
    } with {
      briefly "Persist PaymentProcessed"
      described as {
        |Instructs this repository to apply PaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransactionResumed is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransactionResumed applies to.
        }
      }
    } with {
      briefly "Persist TransactionResumed"
      described as {
        |Instructs this repository to apply TransactionResumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransactionStarted is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransactionStarted applies to.
        }
      }
    } with {
      briefly "Persist TransactionStarted"
      described as {
        |Instructs this repository to apply TransactionStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransactionSuspended is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransactionSuspended applies to.
        }
      }
    } with {
      briefly "Persist TransactionSuspended"
      described as {
        |Instructs this repository to apply TransactionSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransactionVoided is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransactionVoided applies to.
        }
      }
    } with {
      briefly "Persist TransactionVoided"
      described as {
        |Instructs this repository to apply TransactionVoided to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransactionCompleted is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransactionCompleted applies to.
        }
      }
    } with {
      briefly "Persist TransactionCompleted"
      described as {
        |Instructs this repository to apply TransactionCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet TransactionRepositoryResponses is result Transaction.TransactionResult
    record StoredTransaction is {
      transactionId: TransactionId with {
        briefly "transactionId"
        described as {
          |The transactionId column of the stored transaction row.
        }
      }
      cashierId: CashierId with {
        briefly "cashierId"
        described as {
          |The cashierId column of the stored transaction row.
        }
      }
      terminalId: TerminalId with {
        briefly "terminalId"
        described as {
          |The terminalId column of the stored transaction row.
        }
      }
    } with {
      briefly "Stored transaction row"
      described as {
        |The persistence shape of transaction data as this repository stores it.
      }
    }
    schema TransactionData is relational
      of transactions as record StoredTransaction
        index on field StoredTransaction.terminalId
        index on field StoredTransaction.cashierId
        index on field StoredTransaction.transactionId
 with {
      briefly "Transaction data schema"
      described as {
        |The relational schema holding transaction data for the TransactionRepository.
      }
    }
    handler TransactionPersistence is {
      on persistDiscountApplied: command PersistDiscountApplied is {
        do "apply DiscountApplied to the stored row"
      }
      on persistLineItemAdded: command PersistLineItemAdded is {
        do "apply LineItemAdded to the stored row"
      }
      on persistLineItemVoided: command PersistLineItemVoided is {
        do "apply LineItemVoided to the stored row"
      }
      on persistPaymentProcessed: command PersistPaymentProcessed is {
        do "apply PaymentProcessed to the stored row"
      }
      on persistTransactionResumed: command PersistTransactionResumed is {
        do "apply TransactionResumed to the stored row"
      }
      on persistTransactionStarted: command PersistTransactionStarted is {
        do "apply TransactionStarted to the stored row"
      }
      on persistTransactionSuspended: command PersistTransactionSuspended is {
        do "apply TransactionSuspended to the stored row"
      }
      on persistTransactionVoided: command PersistTransactionVoided is {
        do "apply TransactionVoided to the stored row"
      }
      on persistTransactionCompleted: command PersistTransactionCompleted is {
        do "apply TransactionCompleted to the stored row"
      }
      on query GetDailySalesSummary is {
        let dailySalesSummaryView: type DailySalesSummaryView = prompt("read the daily sales summary projection")
        reply dailySalesSummaryView
      }
    } with {
      briefly "Persists transaction commands"
      described as {
        |Handles command-driven persistence for transactions.
      }
    }
  } with {
    briefly "Transaction data persistence"
    described as {
      | The TransactionRepository provides persistent storage for
      | POS transactions with indexes for terminal and cashier lookup.
    }
  }
  // Projector for sales analytics
  query GetDailySalesSummary replies result DailySalesSummaryView is {
    dailySalesSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which daily sales summary to retrieve.
      }
    }
  } with {
    briefly "Get daily sales summary"
    described as {
      |Retrieves the daily sales summary projection.
    }
  }
  result DailySalesSummaryView is {
    dailySalesSummary: SalesAnalytics.DailySalesSummary with {
      briefly "Daily sales summary"
      described as {
        |The daily sales summary being returned.
      }
    }
  } with {
    briefly "Daily sales summary view"
    described as {
      |Read model view carrying the daily sales summary projection.
    }
  }
  projector SalesAnalytics as flow is {
    updates repository POSContext.TransactionRepository
    outlet SalesAnalyticsToRepository is type TransactionRepositoryCommand
    inlet SalesAnalyticsFromTransaction is type TransactionEvent    record DailySalesSummary is {
      date: Date with {
        briefly "Date"
        described as {
          |Sales date.
        }
      }
      terminalId: TerminalId with {
        briefly "Terminal"
        described as {
          |Terminal ID.
        }
      }
      transactionCount: Natural with {
        briefly "Count"
        described as {
          |Number of transactions.
        }
      }
      grossSales: Money with {
        briefly "Gross"
        described as {
          |Gross sales.
        }
      }
      totalDiscounts: Money with {
        briefly "Discounts"
        described as {
          |Total discounts.
        }
      }
      netSales: Money with {
        briefly "Net"
        described as {
          |Net sales.
        }
      }
      taxCollected: Money with {
        briefly "Tax"
        described as {
          |Tax collected.
        }
      }
    } with {
      briefly "Daily sales summary"
      described as {
        |Aggregated daily sales by terminal.
      }
    }
    handler AnalyticsHandler is {
      on discountApplied: event Transaction.DiscountApplied is {
        tell command POSContext.TransactionRepository.PersistDiscountApplied(transactionId = discountApplied.transactionId) to repository POSContext.TransactionRepository
        do "apply DiscountApplied to the SalesAnalytics projection"
      }
      on lineItemAdded: event Transaction.LineItemAdded is {
        tell command POSContext.TransactionRepository.PersistLineItemAdded(transactionId = lineItemAdded.transactionId) to repository POSContext.TransactionRepository
        do "apply LineItemAdded to the SalesAnalytics projection"
      }
      on lineItemVoided: event Transaction.LineItemVoided is {
        tell command POSContext.TransactionRepository.PersistLineItemVoided(transactionId = lineItemVoided.transactionId) to repository POSContext.TransactionRepository
        do "apply LineItemVoided to the SalesAnalytics projection"
      }
      on paymentProcessed: event Transaction.PaymentProcessed is {
        tell command POSContext.TransactionRepository.PersistPaymentProcessed(transactionId = paymentProcessed.transactionId) to repository POSContext.TransactionRepository
        do "apply PaymentProcessed to the SalesAnalytics projection"
      }
      on transactionResumed: event Transaction.TransactionResumed is {
        tell command POSContext.TransactionRepository.PersistTransactionResumed(transactionId = transactionResumed.transactionId) to repository POSContext.TransactionRepository
        do "apply TransactionResumed to the SalesAnalytics projection"
      }
      on transactionStarted: event Transaction.TransactionStarted is {
        tell command POSContext.TransactionRepository.PersistTransactionStarted(transactionId = transactionStarted.transactionId) to repository POSContext.TransactionRepository
        do "apply TransactionStarted to the SalesAnalytics projection"
      }
      on transactionSuspended: event Transaction.TransactionSuspended is {
        tell command POSContext.TransactionRepository.PersistTransactionSuspended(transactionId = transactionSuspended.transactionId) to repository POSContext.TransactionRepository
        do "apply TransactionSuspended to the SalesAnalytics projection"
      }
      on transactionVoided: event Transaction.TransactionVoided is {
        tell command POSContext.TransactionRepository.PersistTransactionVoided(transactionId = transactionVoided.transactionId) to repository POSContext.TransactionRepository
        do "apply TransactionVoided to the SalesAnalytics projection"
      }
      on transactionCompleted: event Transaction.TransactionCompleted is {
        tell command POSContext.TransactionRepository.PersistTransactionCompleted(transactionId = transactionCompleted.transactionId) to repository POSContext.TransactionRepository
        do "Update daily sales summary"
      }
    } with {
      briefly "Maintains sales analytics"
      described as {
        |Projects transactions into analytics.
      }
    }
  } with {
    briefly "Sales analytics projections"
    described as {
      |Maintains summarized sales data.
    }
  }
  // ---- Event publication for Transaction ----
  type TransactionEvent is one of {
    POSContext.Transaction.TransactionStarted or POSContext.Transaction.LineItemAdded or POSContext.Transaction.LineItemVoided or POSContext.Transaction.DiscountApplied or POSContext.Transaction.PaymentProcessed or POSContext.Transaction.TransactionCompleted or POSContext.Transaction.TransactionVoided or POSContext.Transaction.TransactionSuspended or POSContext.Transaction.TransactionResumed
  } with {
    briefly "Transaction event alternation"
    described as {
      |Union of all Transaction events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet TransactionEventSplit as split is {
    outlet TransactionEventSplitToToReceiptService is type TransactionEvent
    outlet TransactionEventSplitToToPaymentGateway is type TransactionEvent
    outlet TransactionEventSplitToInventoryAdapter is type TransactionEvent
    inlet TransactionEventSplitIn is type TransactionEvent    outlet TransactionEventSplitToSalesAnalytics is type TransactionEvent
    handler TransactionEventSplitHandler is {
      on transactionStarted: event Transaction.TransactionStarted is {
        send transactionStarted to outlet TransactionEventSplitToSalesAnalytics
        tell transactionStarted to entity POSContext.Transaction
      }
      on lineItemAdded: event Transaction.LineItemAdded is {
        send lineItemAdded to outlet TransactionEventSplitToSalesAnalytics
        tell lineItemAdded to entity POSContext.Transaction
      }
      on lineItemVoided: event Transaction.LineItemVoided is {
        send lineItemVoided to outlet TransactionEventSplitToSalesAnalytics
        tell lineItemVoided to entity POSContext.Transaction
      }
      on discountApplied: event Transaction.DiscountApplied is {
        send discountApplied to outlet TransactionEventSplitToSalesAnalytics
        tell discountApplied to entity POSContext.Transaction
      }
      on paymentProcessed: event Transaction.PaymentProcessed is {
        send paymentProcessed to outlet TransactionEventSplitToSalesAnalytics
        send paymentProcessed to outlet TransactionEventSplitToToPaymentGateway
        tell paymentProcessed to entity POSContext.Transaction
      }
      on transactionCompleted: event Transaction.TransactionCompleted is {
        send transactionCompleted to outlet TransactionEventSplitToSalesAnalytics
        send transactionCompleted to outlet TransactionEventSplitToToReceiptService
        send transactionCompleted to outlet TransactionEventSplitToToPaymentGateway
        send transactionCompleted to outlet TransactionEventSplitToInventoryAdapter
        tell transactionCompleted to entity POSContext.Transaction
      }
      on transactionVoided: event Transaction.TransactionVoided is {
        send transactionVoided to outlet TransactionEventSplitToSalesAnalytics
        send transactionVoided to outlet TransactionEventSplitToToPaymentGateway
        tell transactionVoided to entity POSContext.Transaction
      }
      on transactionSuspended: event Transaction.TransactionSuspended is {
        send transactionSuspended to outlet TransactionEventSplitToSalesAnalytics
        tell transactionSuspended to entity POSContext.Transaction
      }
      on transactionResumed: event Transaction.TransactionResumed is {
        send transactionResumed to outlet TransactionEventSplitToSalesAnalytics
        tell transactionResumed to entity POSContext.Transaction
      }
      on other is {
        error "Unexpected message for processor TransactionEventSplit"
      }
    } with {
      briefly "Transaction event fan-out handler"
      described as {
        |Delivers each Transaction event to all of its consumers.
      }
    }
  } with {
    briefly "Transaction event fan-out"
    described as {
      |Fans Transaction events out to the repository and projectors.
    }
  }
  connector 'ToReceiptService Feed' is from outlet POSContext.TransactionEventSplit.TransactionEventSplitToToReceiptService to inlet POSContext.ToReceiptService.ToReceiptServiceIn with {
    briefly "The Transaction events ToReceiptService translates, on their way to it"
  }
  connector 'ToPaymentGateway Feed' is from outlet POSContext.TransactionEventSplit.TransactionEventSplitToToPaymentGateway to inlet POSContext.ToPaymentGateway.ToPaymentGatewayIn with {
    briefly "The Transaction events ToPaymentGateway translates, on their way to it"
  }
  connector 'InventoryAdapter Feed' is from outlet POSContext.TransactionEventSplit.TransactionEventSplitToInventoryAdapter to inlet POSContext.InventoryAdapter.InventoryAdapterIn with {
    briefly "The Transaction events InventoryAdapter translates, on their way to it"
  }
  connector 'TransactionEvent Stream' is from outlet POSContext.Transaction.TransactionEvents2 to inlet POSContext.TransactionEventSplit.TransactionEventSplitIn with {
    briefly "Transaction events, fanned out to storage and read models"
  }
  connector 'SalesAnalytics Feed' is from outlet POSContext.TransactionEventSplit.TransactionEventSplitToSalesAnalytics to inlet POSContext.SalesAnalytics.SalesAnalyticsFromTransaction with {
    briefly "Transaction events feeding the SalesAnalytics projection"
  }
  connector 'SalesAnalytics Storage' is from outlet POSContext.SalesAnalytics.SalesAnalyticsToRepository to inlet POSContext.TransactionRepository.TransactionRepositoryFromSalesAnalytics with {
    briefly "SalesAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for point of sale"
  described as {
    | The POSContext is the bounded context for retail transaction
    | processing. It manages transactions, payments, and receipts.
  }
}
