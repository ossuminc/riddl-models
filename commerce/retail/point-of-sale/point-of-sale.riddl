// Point of Sale Domain Model
// Retail transaction processing, payments, and receipts
domain PointOfSale is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Cashier is "store employee processing transactions" with {
    briefly "Store cashier"
    described as {
      |Staff operating the point of sale terminal.
    }
  }
  user Customer is "customer making a purchase" with {
    briefly "Store customer"
    described as {
      |A customer purchasing products in-store.
    }
  }
  epic CheckoutEpic is {
    user Cashier wants to "to process customer purchases" so that "customers can complete their transactions"
    case StandardCheckout is {
      user Cashier wants to "to ring up customer items" so that "the sale can be completed"
      step is "Cashier scans items" "into the POS system" "for purchase" with {
        briefly "Scan items"
        described as {
          |Cashier scans product barcodes.
        }
      }
      step take input PointOfSaleApp.PointOfSaleScreen.AddLineItemInput from user Cashier with {
        briefly "Add item"
        described as {
          |Add scanned item to transaction.
        }
      }
      step is "Customer selects payment method" "credit, debit, or cash" "to pay" with {
        briefly "Select payment"
        described as {
          |Customer chooses payment.
        }
      }
      step take input PointOfSaleApp.PointOfSaleScreen.ProcessPaymentInput from user Cashier with {
        briefly "Process payment"
        described as {
          |Process the payment.
        }
      }
      step is "System prints receipt" "for the customer" "as confirmation" with {
        briefly "Print receipt"
        described as {
          |System generates receipt.
        }
      }
    } with {
      briefly "Standard checkout process"
      described as {
        |Normal flow for processing a sale.
      }
    }
  } with {
    briefly "Customer checkout"
    described as {
      | Epic covering the checkout workflow from item scanning through
      | payment processing and receipt generation.
    }
  }
  include "POSContext.riddl"
  include "external-contexts.riddl"
  application context PointOfSaleApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PointOfSale are delivered.
      }
    }
    group PointOfSaleScreen is {
      input AddLineItemInput acquires command POSContext.Transaction.AddLineItem with {
        briefly "Add line item control"
        described as {
          |The control through which a user submits the add line item request.
        }
      }
      input ProcessPaymentInput acquires command POSContext.Transaction.ProcessPayment with {
        briefly "Process payment control"
        described as {
          |The control through which a user submits the process payment request.
        }
      }
    } with {
      briefly "Point of sale screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppTransactionCommands is type POSContext.Transaction.TransactionCommand
    inlet AppTransactionRepositoryResponses is type POSContext.Transaction.TransactionResult    handler PointOfSaleAppHandler is {
      on other is {
        error "Unexpected message for application context PointOfSaleApp"
      }
    } with {
      briefly "PointOfSaleApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PointOfSaleApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppTransactionCommands is from outlet PointOfSaleApp.AppTransactionCommands to inlet POSContext.Transaction.TransactionCommands with {
    option persistent()
    briefly "LinkAppTransactionCommands"
  }
  connector LinkAppTransactionRepositoryResponses is from outlet POSContext.TransactionRepository.TransactionRepositoryResponses to inlet PointOfSaleApp.AppTransactionRepositoryResponses with {
    option persistent()
    briefly "LinkAppTransactionRepositoryResponses"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PointOfSaleApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Point of sale domain"
  described as {
    | The PointOfSale domain handles retail transaction processing
    | including item scanning, pricing, discounts, payments, and
    | receipt generation.
  }
}
