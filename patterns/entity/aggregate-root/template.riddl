// Aggregate Root Pattern
// Replace {AggregateName} with the parent entity name (e.g., Cart, Order)
// Replace {ChildName} with the child entity name (e.g., Item, Line)
//
// The aggregate root is the only way in. Children have no identity outside
// it, so every command names the root, and the root enforces the invariants
// that span its children. That is what `aggregate` declares.

aggregate entity {AggregateName} is {
  type {AggregateName}Id is Id({AggregateName}) with {
    briefly "{AggregateName} identifier"
    described as {
      |Identifies one {AggregateName}.
    }
  }
  // The child is a record, not an entity: it has no life of its own.
  record {ChildName} is {
    childId: String with {
      briefly "Child ID"
      described as {
        |Identifies the child within its parent. TODO: add child fields.
      }
    }
  } with {
    briefly "A {ChildName} held by the aggregate"
    described as {
      |One child of the aggregate. It is addressed through the root.
    }
  }
  command Add{ChildName} is {
    aggregateId: {AggregateName}Id with {
      briefly "Aggregate"
      described as {
        |The {AggregateName} to add to.
      }
    }
    child: {ChildName} with {
      briefly "Child"
      described as {
        |The {ChildName} being added.
      }
    }
  } with {
    briefly "Add a {ChildName}"
    described as {
      |Adds a child through the root, where the invariants are enforced.
    }
  }
  command Remove{ChildName} is {
    aggregateId: {AggregateName}Id with {
      briefly "Aggregate"
      described as {
        |The {AggregateName} to remove from.
      }
    }
    childId: String with {
      briefly "Child ID"
      described as {
        |Which child to remove.
      }
    }
  } with {
    briefly "Remove a {ChildName}"
    described as {
      |Removes a child through the root.
    }
  }
  event {ChildName}Added is {
    aggregateId: {AggregateName}Id with {
      briefly "Aggregate"
      described as {
        |The {AggregateName} that changed.
      }
    }
    child: {ChildName} with {
      briefly "Child"
      described as {
        |The {ChildName} that was added.
      }
    }
  } with {
    briefly "A {ChildName} was added"
    described as {
      |Records the addition.
    }
  }
  event {ChildName}Removed is {
    aggregateId: {AggregateName}Id with {
      briefly "Aggregate"
      described as {
        |The {AggregateName} that changed.
      }
    }
    childId: String with {
      briefly "Child ID"
      described as {
        |The {ChildName} that was removed.
      }
    }
  } with {
    briefly "A {ChildName} was removed"
    described as {
      |Records the removal.
    }
  }
  record ActiveData is {
    id: {AggregateName}Id with {
      briefly "ID"
      described as {
        |The {AggregateName} this state belongs to.
      }
    }
    children: many {ChildName} with {
      briefly "Children"
      described as {
        |The children the root holds. TODO: add other aggregate state.
      }
    }
  } with {
    briefly "Active {AggregateName} data"
    described as {
      |The aggregate and everything inside its boundary.
    }
  }
  initial state Active of record {AggregateName}.ActiveData is {
    initial handler ActiveInitHandler is {
      on init is {
        set state Active to "an empty {AggregateName} with no children"
      }
    } with {
      briefly "Active init handler"
      described as {
        |Starts the aggregate empty.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |The aggregate is live.
    }
  }
  handler {AggregateName}Handler is {
    on command Add{ChildName} is {
      do "TODO: enforce the invariants that span the children -- a size
        limit, a uniqueness rule, a total that must balance"
      set field {AggregateName}.ActiveData.children to "the children plus the added one"
      send event {ChildName}Added to outlet {AggregateName}Events
    }
    on command Remove{ChildName} is {
      do "TODO: check the child is present"
      set field {AggregateName}.ActiveData.children to "the children minus the removed one"
      send event {ChildName}Removed to outlet {AggregateName}Events
    }
  } with {
    briefly "{AggregateName} handler"
    described as {
      |Applies changes to children through the root, so no child is ever
      |modified behind the aggregate's back.
    }
  }
  outlet {AggregateName}Events is type {AggregateName}Event
  type {AggregateName}Event is one of {
    {ChildName}Added or {ChildName}Removed
  } with {
    briefly "{AggregateName} event alternation"
    described as {
      |What the aggregate publishes.
    }
  }
} with {
  briefly "Aggregate root that manages {ChildName} children"
  described as {
    |The consistency boundary. Children are reached only through the root,
    |which is what lets the root enforce invariants across them.
  }
}
