// Aggregate Root Example: Shopping Cart with Line Items
//
// A worked instantiation of the aggregate-root pattern. The cart is the only
// thing the outside world addresses; line items live inside it and are never
// commanded directly. Every change goes through the root, which is what lets
// it keep item count and subtotal consistent.
domain Commerce is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Model author and maintainer"
    described as {
      |Ossum Inc., authors and maintainers of this pattern library.
    }
  }
  context Shopping is {
    inlet ShoppingCommandsIn is type Cart.CartCommand
    outlet ShoppingCommandsFwd is type Cart.CartCommand
    handler ShoppingBoundary is {
      on addLineItem: command Cart.AddLineItem is {
        send addLineItem to outlet Shopping.ShoppingCommandsFwd
      }
      on updateQuantity: command Cart.UpdateQuantity is {
        send updateQuantity to outlet Shopping.ShoppingCommandsFwd
      }
      on removeLineItem: command Cart.RemoveLineItem is {
        send removeLineItem to outlet Shopping.ShoppingCommandsFwd
      }
      on clearCart: command Cart.ClearCart is {
        send clearCart to outlet Shopping.ShoppingCommandsFwd
      }
    } with {
      briefly "Context boundary relay"
      described as {
        |The context is the port at its own boundary: a peer connects here,
        |never to a definition inside.
      }
    }
    connector AppCommandsToCartIntake is from outlet Shopping.ShoppingCommandsFwd to inlet Shopping.Cart.CartCommands with {
      briefly "Boundary to the aggregate"
    }
    type ProductId is UUID with {
      briefly "Product identifier"
      described as {
        |Identifies a product that may be placed in a cart.
      }
    }
    type CartId is Id(Shopping.Cart) with {
      briefly "Cart identifier"
      described as {
        |Uniquely identifies a cart.
      }
    }
    type LineItemId is UUID with {
      briefly "Line item identifier"
      described as {
        |Identifies a line within its cart. Deliberately not an entity
        |identifier: line items have no life outside the aggregate.
      }
    }
    type LineItem is {
      lineItemId: Shopping.LineItemId with {
        briefly "Line item"
        described as {
          |Identifies this line within the cart.
        }
      }
      productId: Shopping.ProductId with {
        briefly "Product"
        described as {
          |The product this line refers to.
        }
      }
      quantity: Integer with {
        briefly "Quantity"
        described as {
          |How many of the product this line carries.
        }
      }
      unitPrice: Decimal(10, 2) with {
        briefly "Unit price"
        described as {
          |Price of a single unit when it was added.
        }
      }
    } with {
      briefly "Cart line item"
      described as {
        |One product line inside a cart, addressed only through the root.
      }
    }
    aggregate entity Cart as flow is {
      type CartCommand is one of {
        Cart.AddLineItem or Cart.UpdateQuantity or Cart.RemoveLineItem or
        Cart.ClearCart
      } with {
        briefly "Cart command alternation"
        described as {
          |Commands accepted by the Cart aggregate root.
        }
      }
      type CartEvent is one of {
        Cart.LineItemAdded or Cart.QuantityUpdated or Cart.LineItemRemoved or
        Cart.CartCleared
      } with {
        briefly "Cart event alternation"
        described as {
          |Events published by the Cart aggregate root.
        }
      }
      inlet CartCommands is type CartCommand
      outlet CartEvents is type CartEvent
      command AddLineItem is {
        cartId: Shopping.CartId with {
          briefly "Cart"
          described as {
            |The cart being added to.
          }
        }
        item: Shopping.LineItem with {
          briefly "Item"
          described as {
            |The line to add.
          }
        }
      } with {
        briefly "Add a line item"
        described as {
          |Adds a line to the cart through the root.
        }
      }
      command UpdateQuantity is {
        cartId: Shopping.CartId with {
          briefly "Cart"
          described as {
            |The cart holding the line.
          }
        }
        lineItemId: Shopping.LineItemId with {
          briefly "Line item"
          described as {
            |Which line to change.
          }
        }
        newQuantity: Integer with {
          briefly "New quantity"
          described as {
            |The quantity to set.
          }
        }
      } with {
        briefly "Change a line quantity"
        described as {
          |Changes the quantity of one line through the root.
        }
      }
      command RemoveLineItem is {
        cartId: Shopping.CartId with {
          briefly "Cart"
          described as {
            |The cart holding the line.
          }
        }
        lineItemId: Shopping.LineItemId with {
          briefly "Line item"
          described as {
            |Which line to remove.
          }
        }
      } with {
        briefly "Remove a line item"
        described as {
          |Removes a line from the cart through the root.
        }
      }
      command ClearCart is {
        cartId: Shopping.CartId with {
          briefly "Cart"
          described as {
            |The cart to empty.
          }
        }
      } with {
        briefly "Empty the cart"
        described as {
          |Removes every line at once.
        }
      }
      event LineItemAdded is {
        cartId: Shopping.CartId with {
          briefly "Cart"
          described as {
            |The cart that gained a line.
          }
        }
        item: Shopping.LineItem with {
          briefly "Item"
          described as {
            |The line that was added.
          }
        }
      } with {
        briefly "A line was added"
        described as {
          |Records that a line joined the cart.
        }
      }
      event QuantityUpdated is {
        cartId: Shopping.CartId with {
          briefly "Cart"
          described as {
            |The cart holding the line.
          }
        }
        lineItemId: Shopping.LineItemId with {
          briefly "Line item"
          described as {
            |The line whose quantity changed.
          }
        }
        oldQuantity: Integer with {
          briefly "Old quantity"
          described as {
            |Quantity before the change.
          }
        }
        newQuantity: Integer with {
          briefly "New quantity"
          described as {
            |Quantity after the change.
          }
        }
      } with {
        briefly "A quantity changed"
        described as {
          |Records a quantity change on one line.
        }
      }
      event LineItemRemoved is {
        cartId: Shopping.CartId with {
          briefly "Cart"
          described as {
            |The cart that lost a line.
          }
        }
        lineItemId: Shopping.LineItemId with {
          briefly "Line item"
          described as {
            |The line that was removed.
          }
        }
      } with {
        briefly "A line was removed"
        described as {
          |Records that a line left the cart.
        }
      }
      event CartCleared is {
        cartId: Shopping.CartId with {
          briefly "Cart"
          described as {
            |The cart that was emptied.
          }
        }
        itemCount: Integer with {
          briefly "Items removed"
          described as {
            |How many lines were removed.
          }
        }
      } with {
        briefly "The cart was emptied"
        described as {
          |Records that every line was removed at once.
        }
      }
      record ActiveCartData is {
        cartId: Shopping.CartId with {
          briefly "Cart"
          described as {
            |The cart this state belongs to.
          }
        }
        items: Shopping.LineItem* with {
          briefly "Items"
          described as {
            |The lines the cart currently holds.
          }
        }
        itemCount: Integer with {
          briefly "Item count"
          described as {
            |How many lines the cart holds. Maintained by the root.
          }
        }
        subtotal: Decimal(10, 2) with {
          briefly "Subtotal"
          described as {
            |Sum of the lines. Maintained by the root.
          }
        }
      } with {
        briefly "Active cart data"
        described as {
          |The data an open cart carries.
        }
      }
      query GetCart is {
        cartId: Shopping.CartId with {
          briefly "Cart"
          described as {
            |Which cart to retrieve.
          }
        }
      } with {
        briefly "Get cart"
        described as {
          |Retrieves a cart and its lines.
        }
      }
      result CartResult is {
        cartId: CartId with {
          briefly "Cart addressed"
          described as {
            |Which cart this result concerns. A result names the instance it
            |answers about rather than relying on the record it wraps, because
            |seeing through a nested record is an unbounded search.
          }
        }
        cart: Cart.ActiveCartData with {
          briefly "Cart"
          described as {
            |The cart being returned.
          }
        }
      } with {
        briefly "Cart result"
        described as {
          |Result carrying the requested cart.
        }
      }
      state Active of record Cart.ActiveCartData is {
        handler ActiveCartHandler is {
          on init is {
            set state Active to "initialize the cart from the creating message"
          }
        } with {
          briefly "Active cart handler"
          described as {
            |Initializes a cart on entry to the active state.
          }
        }
      } with {
        briefly "Active state"
        described as {
          |The cart is open and accepting changes.
        }
      }
      handler CartHandler is {
        on query GetCart is {
          let cartResult: Cart.CartResult = prompt("read the cart from the store")
          reply cartResult
        }
        on addLineItem: command AddLineItem is {
          set field Cart.ActiveCartData.itemCount to "the count plus one"
          send event Cart.LineItemAdded(cartId = addLineItem.cartId, item = addLineItem.item) to outlet CartEvents
        }
        on updateQuantity: command UpdateQuantity is {
          set field Cart.ActiveCartData.subtotal to "the subtotal recomputed from the lines"
          send event Cart.QuantityUpdated(cartId = updateQuantity.cartId, lineItemId = updateQuantity.lineItemId, newQuantity = updateQuantity.newQuantity, oldQuantity = prompt("the old quantity of this quantity updated")) to outlet CartEvents
        }
        on removeLineItem: command RemoveLineItem is {
          set field Cart.ActiveCartData.itemCount to "the count minus one"
          send event Cart.LineItemRemoved(cartId = removeLineItem.cartId, lineItemId = removeLineItem.lineItemId) to outlet CartEvents
        }
        on clearCart: command ClearCart is {
          set field Cart.ActiveCartData.itemCount to "zero"
          send event Cart.CartCleared(cartId = clearCart.cartId, itemCount = prompt("the item count of this cart cleared")) to outlet CartEvents
        }
      } with {
        briefly "Cart command handler"
        described as {
          |Every change enters here. Lines are never addressed directly, which
          |is what lets the root keep count and subtotal consistent.
        }
      }
    } with {
      briefly "A shopping cart"
      described as {
        |The aggregate root. It owns its line items and is the only thing the
        |outside world addresses.
      }
    }
    type CartRepositoryCommand is one of {
      Shopping.CartRepository.PersistLineItemAdded or
      Shopping.CartRepository.PersistQuantityUpdated or
      Shopping.CartRepository.PersistLineItemRemoved or
      Shopping.CartRepository.PersistCartCleared
    } with {
      briefly "Anything that writes the CartRepository"
      described as {
        |The persistence commands CartRepository accepts. Cart events never
        |reach it directly; the projector turns each one into one of these.
        |A repository processes commands and queries, never events: the effect
        |of a command is a database update, the effect of a query is a result.
      }
    }
    repository CartRepository as sink is {
      inlet CartRepositoryFromProjection is type CartRepositoryCommand
      record StoredCart is {
        cartId: Shopping.CartId with {
          briefly "cartId"
          described as {
            |The cartId column of the stored cart row.
          }
        }
        itemCount: Integer with {
          briefly "itemCount"
          described as {
            |The itemCount column of the stored cart row.
          }
        }
      } with {
        briefly "Stored cart row"
        described as {
          |The persistence shape of cart data as this repository stores it.
        }
      }
      schema CartData is relational
        of carts as record StoredCart
          index on field StoredCart.cartId
        with {
        briefly "Cart data schema"
        described as {
          |The relational schema holding cart rows.
        }
      }
      command PersistLineItemAdded is {
        cartId: Shopping.CartId with {
          briefly "Row addressed"
          described as {
            |Which stored cart row LineItemAdded applies to.
          }
        }
      } with {
        briefly "Persist LineItemAdded"
        described as {
          |Instructs this repository to apply LineItemAdded to the stored row. A
          |persistence command, not a domain command: it declares no `yields`
          |because storing a row records no new aggregate state.
        }
      }
      command PersistQuantityUpdated is {
        cartId: Shopping.CartId with {
          briefly "Row addressed"
          described as {
            |Which stored cart row QuantityUpdated applies to.
          }
        }
      } with {
        briefly "Persist QuantityUpdated"
        described as {
          |Instructs this repository to apply QuantityUpdated to the stored row. A
          |persistence command, not a domain command: it declares no `yields`
          |because storing a row records no new aggregate state.
        }
      }
      command PersistLineItemRemoved is {
        cartId: Shopping.CartId with {
          briefly "Row addressed"
          described as {
            |Which stored cart row LineItemRemoved applies to.
          }
        }
      } with {
        briefly "Persist LineItemRemoved"
        described as {
          |Instructs this repository to apply LineItemRemoved to the stored row. A
          |persistence command, not a domain command: it declares no `yields`
          |because storing a row records no new aggregate state.
        }
      }
      command PersistCartCleared is {
        cartId: Shopping.CartId with {
          briefly "Row addressed"
          described as {
            |Which stored cart row CartCleared applies to.
          }
        }
      } with {
        briefly "Persist CartCleared"
        described as {
          |Instructs this repository to apply CartCleared to the stored row. A
          |persistence command, not a domain command: it declares no `yields`
          |because storing a row records no new aggregate state.
        }
      }
      handler CartPersistence is {
        on command CartRepository.PersistLineItemAdded is {
          do "apply LineItemAdded to the stored cart row"
        }
        on command CartRepository.PersistQuantityUpdated is {
          do "apply QuantityUpdated to the stored cart row"
        }
        on command CartRepository.PersistLineItemRemoved is {
          do "apply LineItemRemoved to the stored cart row"
        }
        on command CartRepository.PersistCartCleared is {
          do "apply CartCleared to the stored cart row"
        }
        on query Cart.GetCart is {
          let cartResult: Shopping.Cart.CartResult = prompt("read the cart from the store")
          tell cartResult to entity Shopping.Cart
        }
      } with {
        briefly "Cart persistence"
        described as {
          |Keeps the stored cart row in step with the aggregate.
        }
      }
    } with {
      briefly "Cart repository"
      described as {
        |Persists carts and answers cart queries.
      }
    }
    projector CartProjection as flow is {
      updates repository Shopping.CartRepository
      inlet CartProjectionFromCart is type Cart.CartEvent
      outlet CartProjectionToRepository is type CartRepositoryCommand
      handler CartProjectionHandler is {
        on lineItemAdded: event Cart.LineItemAdded is {
          tell command Shopping.CartRepository.PersistLineItemAdded(cartId = lineItemAdded.cartId) to repository Shopping.CartRepository
        }
        on quantityUpdated: event Cart.QuantityUpdated is {
          tell command Shopping.CartRepository.PersistQuantityUpdated(cartId = quantityUpdated.cartId) to repository Shopping.CartRepository
        }
        on lineItemRemoved: event Cart.LineItemRemoved is {
          tell command Shopping.CartRepository.PersistLineItemRemoved(cartId = lineItemRemoved.cartId) to repository Shopping.CartRepository
        }
        on cartCleared: event Cart.CartCleared is {
          tell command Shopping.CartRepository.PersistCartCleared(cartId = cartCleared.cartId) to repository Shopping.CartRepository
        }
      } with {
        briefly "Cart projection handler"
        described as {
          |Turns each cart event into the repository command that writes it.
          |The aggregate never writes the store itself, so there is exactly
          |one write path rather than two.
        }
      }
    } with {
      briefly "Cart projection"
      described as {
        |Builds the stored cart view from the aggregate's events.
      }
    }
    connector CartProjectionToStorage is {
      from outlet Shopping.CartProjection.CartProjectionToRepository to
        inlet Shopping.CartRepository.CartRepositoryFromProjection
    } with {
      briefly "Cart projection to storage"
      described as {
        |Carries the persistence commands the projector produces.
      }
    }
    connector CartEventsToProjection is {
      from outlet Shopping.Cart.CartEvents to
        inlet Shopping.CartProjection.CartProjectionFromCart
    } with {
      briefly "Cart events to repository"
      described as {
        |Carries cart events to the repository that persists them.
      }
    }
  } with {
    briefly "Shopping context"
    described as {
      |The bounded context owning the cart aggregate and its persistence.
    }
  }
  application context CommerceApp as source is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in Commerce are delivered.
      }
    }
    outlet AppCartCommands is type Shopping.Cart.CartCommand
    group CartScreen is {
      input AddLineItemInput acquires command Shopping.Cart.AddLineItem with {
        briefly "Add to cart control"
        described as {
          |The control through which a shopper adds a line to the cart.
        }
      }
      output CartView presents result Shopping.Cart.CartResult with {
        briefly "Cart view"
        described as {
          |Shows the shopper the cart and its lines.
        }
      }
    } with {
      briefly "Cart screen"
      described as {
        |The screen through which shoppers act on their cart.
      }
    }
    handler CommerceAppHandler is {
      on other is {
        error "Unexpected message for application context CommerceApp"
      }
    } with {
      briefly "CommerceApp handler"
      described as {
        |Originates cart commands.
      }
    }
  } with {
    briefly "Commerce application"
    described as {
      |The UI-bearing application that originates cart commands.
    }
  }
  persistent connector AppCommandsToCart is {
    from outlet CommerceApp.AppCartCommands to
      inlet Shopping.ShoppingCommandsIn
  } with {
    briefly "Application commands to cart"
    described as {
      |Carries commands from the application to the cart aggregate.
    }
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CommerceApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }

} with {
  by author OssumInc
  briefly "Commerce domain"
  described as {
    |A worked example of the aggregate-root pattern.
  }
}
