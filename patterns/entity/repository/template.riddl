// Repository Pattern
// Replace {RepositoryName} with your repository name (e.g., OrderRepository)
// Replace {EntityName} with the entity being persisted (e.g., Order)
//
// A repository stores the consequence of a decision; it does not make one.
// That is why its commands are its OWN -- `Persist<Event>`, `Store<Entity>` --
// and why none of them declares `yields`. Handling the entity's domain
// commands here would claim the repository records the entity's events, and
// once those commands declare `yields` (as an event-sourced entity's must)
// riddlc rejects it outright.
//
// A repository handles commands and queries. Never events: the read side
// follows the write side, and riddlc says so.

repository {RepositoryName} is {
  record Stored{EntityName} is {
    id: String with {
      briefly "Key"
      described as {
        |The key of the stored row. TODO: add the columns you store.
      }
    }
  } with {
    briefly "Stored {EntityName} row"
    described as {
      |The persistence shape of {EntityName}, which need not match the
      |entity's own state record.
    }
  }
  schema {EntityName}Data is relational
    of rows as record Stored{EntityName}
      index on field Stored{EntityName}.id
    with {
    briefly "{EntityName} data schema"
    described as {
      |The relational schema holding {EntityName} rows. A schema is made of
      |data types, not entities.
    }
  }
  command Persist{EntityName} is {
    id: String with {
      briefly "Key"
      described as {
        |The row to write.
      }
    }
  } with {
    briefly "Persist a {EntityName}"
    described as {
      |A persistence command, not a domain command: it declares no `yields`
      |because storing a row records no new entity state.
    }
  }
  command Delete{EntityName} is {
    id: String with {
      briefly "Key"
      described as {
        |The row to remove.
      }
    }
  } with {
    briefly "Delete a {EntityName}"
    described as {
      |Removes a stored row.
    }
  }
  query Find{EntityName}ById is {
    id: String with {
      briefly "Key"
      described as {
        |The row to fetch.
      }
    }
  } with {
    briefly "Find a {EntityName} by id"
    described as {
      |Reads one row by key.
    }
  }
  result {EntityName}Found is {
    row: Stored{EntityName} with {
      briefly "Row"
      described as {
        |The row that was found.
      }
    }
  } with {
    briefly "{EntityName} lookup result"
    described as {
      |Carries the row back to the caller.
    }
  }
  handler {RepositoryName}Handler is {
    on command Persist{EntityName} is {
      set field Stored{EntityName}.id to "the key from the incoming row"
      do "TODO: write the remaining columns"
    }
    on command Delete{EntityName} is {
      do "TODO: delete the row this key identifies"
    }
    on query Find{EntityName}ById is {
      reply result {EntityName}Found
    }
  } with {
    briefly "{RepositoryName} handler"
    described as {
      |Writes and reads {EntityName} rows.
    }
  }
} with {
  briefly "Repository for persisting and querying {EntityName} entities"
  described as {
    |Owns the storage of {EntityName}, and nothing about its behaviour.
  }
}
