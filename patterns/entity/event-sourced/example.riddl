// Event-Sourced Entity Example: Bank Account
//
// A worked instantiation of the event-sourced entity pattern. Every command
// the entity accepts results in an event, and those events are what the
// repository persists -- the state is a projection of them.
domain Banking is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Model author and maintainer"
    described as {
      |Ossum Inc., authors and maintainers of this pattern library.
    }
  }
  type Money is Decimal(12, 2) with {
    briefly "Money"
    described as {
      |A monetary amount, to two decimal places.
    }
  }
  context Accounts as flow is {
    inlet AccountsCommandsIn is type Account.AccountCommand
    outlet AccountsCommandsFwd is type Account.AccountCommand
    handler AccountsBoundary is {
      on openAccount: command Account.OpenAccount is {
        forward openAccount to outlet Accounts.AccountsCommandsFwd
      }
      on deposit: command Account.Deposit is {
        forward deposit to outlet Accounts.AccountsCommandsFwd
      }
      on withdraw: command Account.Withdraw is {
        forward withdraw to outlet Accounts.AccountsCommandsFwd
      }
      on closeAccount: command Account.CloseAccount is {
        forward closeAccount to outlet Accounts.AccountsCommandsFwd
      }
    } with {
      briefly "Context boundary relay"
      described as {
        |The context is the port at its own boundary: a peer connects here,
        |never to a definition inside.
      }
    }
    connector AppCommandsToAccountIntake is from outlet Accounts.AccountsCommandsFwd to inlet Accounts.Account.AccountCommands with {
      briefly "Boundary to the aggregate"
    }
    type AccountId is Id(Accounts.Account) with {
      briefly "Account identifier"
      described as {
        |Uniquely identifies an account.
      }
    }
    aggregate event-sourced entity Account as flow is {
      type AccountCommand is one of {
        Account.OpenAccount or Account.Deposit or Account.Withdraw or
        Account.CloseAccount
      } with {
        briefly "Account command alternation"
        described as {
          |Commands accepted by the Account entity.
        }
      }
      type AccountEvent is one of {
        Account.AccountOpened or Account.MoneyDeposited or
        Account.MoneyWithdrawn or Account.AccountClosed
      } with {
        briefly "Account event alternation"
        described as {
          |Events published by the Account entity.
        }
      }
      inlet AccountCommands is type AccountCommand
      outlet AccountEvents is type AccountEvent
      command OpenAccount yields event AccountOpened is {
        accountId: AccountId with {
          briefly "Account"
          described as {
            |The account being opened.
          }
        }
        ownerName: String(1, 100) with {
          briefly "Owner"
          described as {
            |Name of the account holder.
          }
        }
        initialDeposit: Banking.Money with {
          briefly "Initial deposit"
          described as {
            |Amount the account is opened with.
          }
        }
      } with {
        briefly "Open an account"
        described as {
          |Opens a new account for a named owner with an initial deposit.
        }
      }
      command Deposit yields event MoneyDeposited is {
        accountId: AccountId with {
          briefly "Account"
          described as {
            |The account being credited.
          }
        }
        amount: Banking.Money with {
          briefly "Amount"
          described as {
            |Amount to deposit.
          }
        }
      } with {
        briefly "Deposit funds"
        described as {
          |Credits the account with the given amount.
        }
      }
      command Withdraw yields event MoneyWithdrawn is {
        accountId: AccountId with {
          briefly "Account"
          described as {
            |The account being debited.
          }
        }
        amount: Banking.Money with {
          briefly "Amount"
          described as {
            |Amount to withdraw.
          }
        }
      } with {
        briefly "Withdraw funds"
        described as {
          |Debits the account, provided the balance covers it.
        }
      }
      command CloseAccount yields event AccountClosed is {
        accountId: AccountId with {
          briefly "Account"
          described as {
            |The account being closed.
          }
        }
      } with {
        briefly "Close an account"
        described as {
          |Closes the account and settles its final balance.
        }
      }
      event AccountOpened is {
        accountId: AccountId with {
          briefly "Account"
          described as {
            |The account that was opened.
          }
        }
        ownerName: String(1, 100) with {
          briefly "Owner"
          described as {
            |Name of the account holder.
          }
        }
        initialBalance: Banking.Money with {
          briefly "Opening balance"
          described as {
            |Balance the account was opened with.
          }
        }
        openedAt: TimeStamp with {
          briefly "Opened"
          described as {
            |When the account was opened.
          }
        }
      } with {
        briefly "Account was opened"
        described as {
          |Records that an account came into existence.
        }
      }
      event MoneyDeposited is {
        accountId: AccountId with {
          briefly "Account"
          described as {
            |The account that was credited.
          }
        }
        amount: Banking.Money with {
          briefly "Amount"
          described as {
            |Amount deposited.
          }
        }
        newBalance: Banking.Money with {
          briefly "Balance"
          described as {
            |Balance after the deposit.
          }
        }
        depositedAt: TimeStamp with {
          briefly "Deposited"
          described as {
            |When the deposit was applied.
          }
        }
      } with {
        briefly "Money was deposited"
        described as {
          |Records a credit to the account.
        }
      }
      event MoneyWithdrawn is {
        accountId: AccountId with {
          briefly "Account"
          described as {
            |The account that was debited.
          }
        }
        amount: Banking.Money with {
          briefly "Amount"
          described as {
            |Amount withdrawn.
          }
        }
        newBalance: Banking.Money with {
          briefly "Balance"
          described as {
            |Balance after the withdrawal.
          }
        }
        withdrawnAt: TimeStamp with {
          briefly "Withdrawn"
          described as {
            |When the withdrawal was applied.
          }
        }
      } with {
        briefly "Money was withdrawn"
        described as {
          |Records a debit against the account.
        }
      }
      event AccountClosed is {
        accountId: AccountId with {
          briefly "Account"
          described as {
            |The account that was closed.
          }
        }
        finalBalance: Banking.Money with {
          briefly "Final balance"
          described as {
            |Balance at the moment of closure.
          }
        }
        closedAt: TimeStamp with {
          briefly "Closed"
          described as {
            |When the account was closed.
          }
        }
      } with {
        briefly "Account was closed"
        described as {
          |Records that an account was closed.
        }
      }
      record ActiveStateData is {
        accountId: AccountId with {
          briefly "Account"
          described as {
            |The account this state belongs to.
          }
        }
        ownerName: String(1, 100) with {
          briefly "Owner"
          described as {
            |Name of the account holder.
          }
        }
        balance: Banking.Money with {
          briefly "Balance"
          described as {
            |Current balance.
          }
        }
        openedAt: TimeStamp with {
          briefly "Opened"
          described as {
            |When the account was opened.
          }
        }
      } with {
        briefly "Active account data"
        described as {
          |The data an open account carries.
        }
      }
      record ClosedStateData is {
        accountId: AccountId with {
          briefly "Account"
          described as {
            |The account this state belongs to.
          }
        }
        closedAt: TimeStamp with {
          briefly "Closed"
          described as {
            |When the account was closed.
          }
        }
      } with {
        briefly "Closed account data"
        described as {
          |The data a closed account retains.
        }
      }
      state Active of record Account.ActiveStateData is {
        handler ActiveHandler is {
          on init is {
            let accountOpened: Account.AccountOpened = prompt("the account opened that brings this account into existence")
            yield accountOpened
          }
        } with {
          briefly "Active state handler"
          described as {
            |Initializes an account on entry to the active state.
          }
        }
      } with {
        briefly "Active state"
        described as {
          |The account is open and transacting.
        }
      }
      state Closed of record Account.ClosedStateData is {
        handler ClosedHandler is {
          on init is {
            let accountClosed: Account.AccountClosed = prompt("the account closed that brings this account into existence")
            yield accountClosed
          }
        } with {
          briefly "Closed state handler"
          described as {
            |Initializes an account on entry to the closed state.
          }
        }
      } with {
        briefly "Closed state"
        described as {
          |The account is closed and no longer transacting.
        }
      }
      query GetAccount replies result AccountResult is {
        accountId: Accounts.AccountId with {
          briefly "Account"
          described as {
            |Which account to retrieve.
          }
        }
      } with {
        briefly "Get account"
        described as {
          |Retrieves an account by identifier.
        }
      }
      result AccountResult is {
        accountId: AccountId with {
          briefly "Account addressed"
          described as {
            |Which account this result concerns. A result names the instance it
            |answers about rather than relying on the record it wraps, because
            |seeing through a nested record is an unbounded search.
          }
        }
        account: Account.ActiveStateData with {
          briefly "Account"
          described as {
            |The account being returned.
          }
        }
      } with {
        briefly "Account result"
        described as {
          |Result carrying the requested account.
        }
      }
      handler AccountHandler is {
        on query GetAccount is {
          let accountResult: Account.AccountResult = prompt("read the account from the store")
          reply accountResult
        }
        on openAccount: command OpenAccount is {
          yield event Account.AccountOpened(accountId = openAccount.accountId, ownerName = openAccount.ownerName, initialBalance = prompt("the initial balance of this account opened"), openedAt = prompt("the opened at of this account opened"))
          send event Account.AccountOpened(accountId = openAccount.accountId, ownerName = openAccount.ownerName, initialBalance = prompt("the initial balance of this account opened"), openedAt = prompt("the opened at of this account opened")) to outlet AccountEvents
        }
        on deposit: command Deposit is {
          yield event Account.MoneyDeposited(accountId = deposit.accountId, amount = deposit.amount, newBalance = prompt("the new balance of this money deposited"), depositedAt = prompt("the deposited at of this money deposited"))
          send event Account.MoneyDeposited(accountId = deposit.accountId, amount = deposit.amount, newBalance = prompt("the new balance of this money deposited"), depositedAt = prompt("the deposited at of this money deposited")) to outlet AccountEvents
        }
        on withdraw: command Withdraw is {
          yield event Account.MoneyWithdrawn(accountId = withdraw.accountId, amount = withdraw.amount, newBalance = prompt("the new balance of this money withdrawn"), withdrawnAt = prompt("the withdrawn at of this money withdrawn"))
          send event Account.MoneyWithdrawn(accountId = withdraw.accountId, amount = withdraw.amount, newBalance = prompt("the new balance of this money withdrawn"), withdrawnAt = prompt("the withdrawn at of this money withdrawn")) to outlet AccountEvents
        }
        on closeAccount: command CloseAccount is {
          yield event Account.AccountClosed(accountId = closeAccount.accountId, finalBalance = prompt("the final balance of this account closed"), closedAt = prompt("the closed at of this account closed"))
          send event Account.AccountClosed(accountId = closeAccount.accountId, finalBalance = prompt("the final balance of this account closed"), closedAt = prompt("the closed at of this account closed")) to outlet AccountEvents
        }
        on accountOpened: event Account.AccountOpened is {
          morph entity Accounts.Account to state Accounts.Account.Active with record Account.ActiveStateData(accountId = accountOpened.accountId, ownerName = accountOpened.ownerName, openedAt = accountOpened.openedAt, balance = prompt("the balance of this active state data"))
        }
        on event Account.MoneyDeposited is {
          set field Account.ActiveStateData.balance to "balance plus the deposited amount"
        }
        on event Account.MoneyWithdrawn is {
          set field Account.ActiveStateData.balance to "balance minus the withdrawn amount"
        }
        on accountClosed: event Account.AccountClosed is {
          morph entity Accounts.Account to state Accounts.Account.Closed with record Account.ClosedStateData(accountId = accountClosed.accountId, closedAt = accountClosed.closedAt)
        }
      } with {
        briefly "Account command handler"
        described as {
          |Turns each accepted command into the event that records it.
        }
      }
    } with {
      briefly "A bank account"
      described as {
        |An event-sourced account: every balance change is recorded as an
        |event, and the states are projections of those events.
      }
    }
    type AccountRepositoryCommand is one of {
      Accounts.AccountRepository.PersistAccountOpened or
      Accounts.AccountRepository.PersistMoneyDeposited or
      Accounts.AccountRepository.PersistMoneyWithdrawn or
      Accounts.AccountRepository.PersistAccountClosed
    } with {
      briefly "Anything that writes the AccountRepository"
      described as {
        |The persistence commands AccountRepository accepts. Account events
        |never reach it directly; the projector turns each one into one of
        |these. A repository processes commands and queries, never events:
        |the effect of a command is a database update, the effect of a query
        |is a result.
      }
    }
    repository AccountRepository as sink is {
      inlet AccountRepositoryFromProjection is type AccountRepositoryCommand
      record StoredAccount is {
        accountId: Accounts.AccountId with {
          briefly "accountId"
          described as {
            |The accountId column of the stored account row.
          }
        }
        balance: Banking.Money with {
          briefly "balance"
          described as {
            |The balance column of the stored account row.
          }
        }
      } with {
        briefly "Stored account row"
        described as {
          |The persistence shape of account data as this repository stores it.
        }
      }
      schema AccountData is relational
        of accounts as record StoredAccount
          index on field StoredAccount.accountId
        with {
        briefly "Account data schema"
        described as {
          |The relational schema holding account rows.
        }
      }
      command PersistAccountOpened is {
        accountId: AccountId with {
          briefly "ID"
          described as {
            |The stored account row to update.
          }
        }
      } with {
        briefly "Persist AccountOpened"
        described as {
          |Instructs this repository to apply AccountOpened to the stored row. A
          |persistence command, not a domain command: it declares no `yields`
          |because storing a row records no new entity state.
        }
      }
      command PersistMoneyDeposited is {
        accountId: AccountId with {
          briefly "ID"
          described as {
            |The stored account row to update.
          }
        }
      } with {
        briefly "Persist MoneyDeposited"
        described as {
          |Instructs this repository to apply MoneyDeposited to the stored row. A
          |persistence command, not a domain command: it declares no `yields`
          |because storing a row records no new entity state.
        }
      }
      command PersistMoneyWithdrawn is {
        accountId: AccountId with {
          briefly "ID"
          described as {
            |The stored account row to update.
          }
        }
      } with {
        briefly "Persist MoneyWithdrawn"
        described as {
          |Instructs this repository to apply MoneyWithdrawn to the stored row. A
          |persistence command, not a domain command: it declares no `yields`
          |because storing a row records no new entity state.
        }
      }
      command PersistAccountClosed is {
        accountId: AccountId with {
          briefly "ID"
          described as {
            |The stored account row to update.
          }
        }
      } with {
        briefly "Persist AccountClosed"
        described as {
          |Instructs this repository to apply AccountClosed to the stored row. A
          |persistence command, not a domain command: it declares no `yields`
          |because storing a row records no new entity state.
        }
      }
      handler AccountPersistence is {
        on command PersistAccountOpened is {
          do "insert the opened account row"
        }
        on command PersistMoneyDeposited is {
          do "update the stored balance from the deposit"
        }
        on command PersistMoneyWithdrawn is {
          do "update the stored balance from the withdrawal"
        }
        on command PersistAccountClosed is {
          do "mark the stored account row closed"
        }
        on query GetAccount is {
          let accountResult: Accounts.Account.AccountResult = prompt("read the account from the store")
          reply accountResult
        }
      } with {
        briefly "Account persistence"
        described as {
          |Applies each account event to the stored row.
        }
      }
    } with {
      briefly "Account repository"
      described as {
        |Persists the account projection built from account events.
      }
    }
    projector AccountProjection as flow is {
      updates repository Accounts.AccountRepository
      inlet AccountProjectionFromAccount is type Account.AccountEvent
      outlet AccountProjectionToRepository is type AccountRepositoryCommand
      handler AccountProjectionHandler is {
        on accountOpened: event Account.AccountOpened is {
          tell command Accounts.AccountRepository.PersistAccountOpened(accountId = accountOpened.accountId) to repository Accounts.AccountRepository
        }
        on moneyDeposited: event Account.MoneyDeposited is {
          tell command Accounts.AccountRepository.PersistMoneyDeposited(accountId = moneyDeposited.accountId) to repository Accounts.AccountRepository
        }
        on moneyWithdrawn: event Account.MoneyWithdrawn is {
          tell command Accounts.AccountRepository.PersistMoneyWithdrawn(accountId = moneyWithdrawn.accountId) to repository Accounts.AccountRepository
        }
        on accountClosed: event Account.AccountClosed is {
          tell command Accounts.AccountRepository.PersistAccountClosed(accountId = accountClosed.accountId) to repository Accounts.AccountRepository
        }
      } with {
        briefly "Account projection handler"
        described as {
          |Turns each account event into the repository command that writes it.
          |This translation is the projector's job precisely so the entity does
          |not write the store itself -- one write path, not two.
        }
      }
    } with {
      briefly "Account projection"
      described as {
        |Builds the stored account view from the entity's events.
      }
    }
    streamlet AccountEventSource as source is {
      outlet PublishedAccountEvents is type Account.AccountEvent
      handler AccountEventEmitter is {
        on accountOpened: event Account.AccountOpened is {
          send accountOpened to outlet PublishedAccountEvents
        }
        on other is {
          error "Unexpected message for source AccountEventSource"
        }
      } with {
        briefly "Account event emitter"
        described as {
          |Publishes account events beyond this context.
        }
      }
    } with {
      briefly "Account event source"
      described as {
        |Publishes the account event stream.
      }
    }
    streamlet AccountEventSink as sink is {
      inlet IncomingAccountEvents is type Account.AccountEvent
      handler AccountEventReceiver is {
        on accountOpened: event Account.AccountOpened is {
          tell accountOpened to entity Accounts.Account
          do "record that an account was opened"
        }
        on other is {
          error "Unexpected message for sink AccountEventSink"
        }
      } with {
        briefly "Account event receiver"
        described as {
          |Receives published account events for downstream dispatch.
        }
      }
    } with {
      briefly "Account event sink"
      described as {
        |Terminates the published account event stream.
      }
    }
    connector PublishedEventsToSink is {
      from outlet Accounts.AccountEventSource.PublishedAccountEvents to
        inlet Accounts.AccountEventSink.IncomingAccountEvents
    } with {
      briefly "Published events to sink"
      described as {
        |Carries published account events to the sink that terminates them.
      }
    }
    connector AccountEventsToProjection is {
      from outlet Accounts.Account.AccountEvents to
        inlet Accounts.AccountProjection.AccountProjectionFromAccount
    } with {
      briefly "Account events to the projection"
      described as {
        |Carries account events to the projector that builds the stored view.
      }
    }
    connector AccountProjectionToStorage is {
      from outlet Accounts.AccountProjection.AccountProjectionToRepository to
        inlet Accounts.AccountRepository.AccountRepositoryFromProjection
    } with {
      briefly "Account projection to storage"
      described as {
        |Carries the persistence commands the projector produces.
      }
    }
  } with {
    briefly "Accounts context"
    described as {
      |The bounded context owning account behaviour and its persistence.
    }
  }
  application context BankingApp as source is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in Banking are delivered.
      }
    }
    outlet AppAccountCommands is type Accounts.Account.AccountCommand
    group AccountScreen is {
      input OpenAccountInput acquires command Accounts.Account.OpenAccount with {
        briefly "Open account control"
        described as {
          |The control through which a customer opens an account.
        }
      }
    } with {
      briefly "Account screen"
      described as {
        |The screen through which customers act on accounts.
      }
    }
    handler BankingAppHandler is {
      on other is {
        error "Unexpected message for application context BankingApp"
      }
    } with {
      briefly "BankingApp handler"
      described as {
        |Originates account commands.
      }
    }
  } with {
    briefly "Banking application"
    described as {
      |The UI-bearing application that originates account commands.
    }
  }
  persistent connector AppCommandsToAccount is {
    from outlet BankingApp.AppAccountCommands to
      inlet Accounts.AccountsCommandsIn
  } with {
    briefly "Application commands to account"
    described as {
      |Carries commands from the application to the account entity.
    }
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet BankingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }

} with {
  by author OssumInc
  briefly "Banking domain"
  described as {
    |A worked example of the event-sourced entity pattern.
  }
}
