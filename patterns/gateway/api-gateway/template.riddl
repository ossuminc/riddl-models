// API Gateway Pattern
// Replace {GatewayName} with your gateway name (e.g., Public)
//
// The gateway is the only context outsiders address. It translates their
// vocabulary into the domain's and routes the result inward, so no external
// protocol leaks past this boundary.
//
// Note where the work goes. An adaptor translates INTO another context and is
// named `to context <Target>`; it handles the SOURCE message it translates,
// not the target's command, because it does not fulfil that command -- the
// target does.

context {GatewayName}Gateway is {
  type {GatewayName}Request is {
    correlationId: String with {
      briefly "Correlation"
      described as {
        |Ties a response back to its request. TODO: add request fields.
      }
    }
  } with {
    briefly "An inbound {GatewayName} request"
    described as {
      |The external vocabulary, before translation.
    }
  }
  type {GatewayName}Response is {
    correlationId: String with {
      briefly "Correlation"
      described as {
        |The request this answers. TODO: add response fields.
      }
    }
  } with {
    briefly "An outbound {GatewayName} response"
    described as {
      |The external vocabulary, after translation back.
    }
  }
  command ProcessRequest is {
    request: {GatewayName}Request with {
      briefly "Request"
      described as {
        |The request to route.
      }
    }
  } with {
    briefly "Route an inbound request"
    described as {
      |Accepts an external request at the boundary.
    }
  }
  result RequestResult is {
    response: {GatewayName}Response with {
      briefly "Response"
      described as {
        |What to send back.
      }
    }
    success: Boolean with {
      briefly "Succeeded"
      described as {
        |Whether the request was served.
      }
    }
  } with {
    briefly "The outcome of a routed request"
    described as {
      |Carries the translated response back to the caller.
    }
  }
  record RouterData is {
    correlationId: String with {
      briefly "Correlation"
      described as {
        |The request in flight.
      }
    }
  } with {
    briefly "Router state data"
    described as {
      |What the router remembers while a request is in flight.
    }
  }
  persistent entity GatewayRouter is {
    initial state Routing of record {GatewayName}Gateway.RouterData is {
      initial handler RoutingInitHandler is {
        on init is {
          set state Routing to "no request in flight"
        }
      } with {
        briefly "Routing init handler"
        described as {
          |Starts with nothing in flight.
        }
      }
    } with {
      briefly "Routing state"
      described as {
        |The router is ready to route.
      }
    }
    handler APIHandler is {
      on command ProcessRequest is {
        do "TODO: validate and authenticate the request at the boundary"
        do "TODO: tell the internal command this request translates to"
        reply result RequestResult
      }
    } with {
      briefly "API handler"
      described as {
        |Routes an external request to the context that serves it.
      }
    }
  } with {
    briefly "Routes external requests to internal contexts"
    described as {
      |Holds whatever correlation the gateway needs while a request is in
      |flight.
    }
  }
} with {
  briefly "Public API facade for the domain"
  described as {
    |The one context outsiders address. Everything beyond it speaks the
    |domain's own vocabulary.
  }
}
