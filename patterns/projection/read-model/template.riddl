// Projector Pattern (Read Model)
// Replace {ProjectorName} with your projector name (e.g., OrderSummaryView)
// Replace {ViewName} with the view record name (e.g., OrderSummary)
// Replace {EntityName} with the source entity (e.g., Order)
//
// A projector builds a read-optimised view by reacting to events. It handles
// events only -- never commands or queries -- because the write side owns
// those and the read side follows.

projector {ProjectorName} is {
  // Where the projection is kept. A projector that persists nowhere is a
  // read model no one can read.
  updates repository {ViewName}Store
  // The read model structure. Shape these fields for the queries you intend
  // to serve, not for the entity they came from: duplication is the point.
  record {ViewName} is {
    ???
  } with {
    briefly "The {ViewName} read model"
    described as {
      |One row of the read-optimised view this projector maintains.
    }
  }
  handler {ProjectorName}Handler is {
    on event {EntityName}Created is {
      tell event {EntityName}Created to repository {ViewName}Store
      do "insert a {ViewName} row from the {EntityName}Created event"
    }
    on event {EntityName}Updated is {
      tell event {EntityName}Updated to repository {ViewName}Store
      do "update the {ViewName} row the {EntityName}Updated event refers to"
    }
    on event {EntityName}Deleted is {
      tell event {EntityName}Deleted to repository {ViewName}Store
      do "remove the {ViewName} row the {EntityName}Deleted event refers to"
    }
  } with {
    briefly "{ProjectorName} handler"
    described as {
      |Applies {EntityName} events to the {ViewName} read model.
    }
  }
} with {
  briefly "Read model projector that builds {ViewName} views"
  described as {
    |Maintains a query-optimised projection of {EntityName} state. The
    |projection is eventually consistent with the entity it follows.
  }
}
