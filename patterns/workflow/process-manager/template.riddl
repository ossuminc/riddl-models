// Process Manager Pattern
// Replace {ProcessName} with your process name (e.g., OrderFulfillment)
//
// A process manager coordinates a workflow that spans several entities. It
// holds only the tracking state the coordination needs -- who has done what
// so far -- and reacts to the events those entities publish.
//
// This one is `persistent` rather than `event-sourced`: a coordinator's state
// is a position in a workflow, not a ledger of business facts. Make it
// `event-sourced` instead if you need to replay how the process got here, and
// then every command it handles must declare `yields`.

persistent entity {ProcessName}Manager is {
  type {ProcessName}Id is Id({ProcessName}Manager) with {
    briefly "{ProcessName} identifier"
    described as {
      |Identifies one run of the process.
    }
  }
  type {ProcessName}Status is any of {
    NotStarted or InProgress or Completed or Failed
  } with {
    briefly "Where the process has got to"
    described as {
      |The position of one run of the process.
    }
  }
  // The events this manager reacts to. In a real model these are declared by
  // the entities that publish them and referenced here instead.
  event {ProcessName}Triggered is {
    processId: {ProcessName}Id with {
      briefly "Process"
      described as {
        |The run being started.
      }
    }
  } with {
    briefly "The process was triggered"
    described as {
      |Something happened that starts this process.
    }
  }
  event Step1Completed is {
    processId: {ProcessName}Id with {
      briefly "Process"
      described as {
        |The run whose first step finished.
      }
    }
  } with {
    briefly "The first step completed"
    described as {
      |TODO: replace with the real event from the entity that does step 1.
    }
  }
  event Step2Completed is {
    processId: {ProcessName}Id with {
      briefly "Process"
      described as {
        |The run whose second step finished.
      }
    }
  } with {
    briefly "The second step completed"
    described as {
      |TODO: replace with the real event from the entity that does step 2.
    }
  }
  event StepFailed is {
    processId: {ProcessName}Id with {
      briefly "Process"
      described as {
        |The run that failed.
      }
    }
  } with {
    briefly "A step failed"
    described as {
      |Any step reporting failure lands here, and compensation follows.
    }
  }
  record TrackingData is {
    processId: {ProcessName}Id with {
      briefly "Process"
      described as {
        |The run this state tracks.
      }
    }
    currentStatus: {ProcessName}Status with {
      briefly "Status"
      described as {
        |Where the run has got to.
      }
    }
  } with {
    briefly "Process tracking data"
    described as {
      |What the manager remembers. TODO: add the correlation data your
      |steps need to find each other.
    }
  }
  initial state Tracking of record {ProcessName}Manager.TrackingData is {
    initial handler TrackingInitHandler is {
      on init is {
        set state Tracking to "start at NotStarted, awaiting the trigger"
      }
    } with {
      briefly "Tracking init handler"
      described as {
        |Starts a run at NotStarted.
      }
    }
  } with {
    briefly "Tracking state"
    described as {
      |The single state of the manager; the workflow position lives in the
      |record, not in separate states.
    }
  }
  handler {ProcessName}Handler is {
    on event {ProcessName}Triggered is {
      set field {ProcessName}Manager.TrackingData.currentStatus to "InProgress"
      do "TODO: tell the command that starts step 1"
    }
    on event Step1Completed is {
      do "TODO: tell the command that starts step 2"
    }
    on event Step2Completed is {
      set field {ProcessName}Manager.TrackingData.currentStatus to "Completed"
    }
    on event StepFailed is {
      set field {ProcessName}Manager.TrackingData.currentStatus to "Failed"
      do "TODO: tell the compensating commands, newest step first"
    }
  } with {
    briefly "{ProcessName} handler"
    described as {
      |Advances the process as each step reports back, and compensates when
      |one fails.
    }
  }
} with {
  briefly "Process manager that coordinates the {ProcessName} workflow"
  described as {
    |Coordinates a workflow across entities without owning their state.
  }
}
