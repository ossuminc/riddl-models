// Saga Pattern (Distributed Transaction)
// Replace {SagaName} with your saga name (e.g., PlaceOrder, TransferFunds)
//
// NOTE (RIDDL 2.0): `requires`/`returns` take a NAMED type reference, not an
// inline aggregation. Declare a `record` and reference it as
// `requires record <Name>`. An inline `requires { ... }` still parses but
// raises a [deprecated] warning.

// Saga input / output
record {SagaName}Args is {
  // TODO: Add input fields
} with {
  briefly "Input required to start {SagaName}"
}
record {SagaName}Result is {
  success: Boolean
  // TODO: Add result fields
} with {
  briefly "Outcome of {SagaName}"
}

// Per-step input / output
record Step1Args is { /* TODO: input for this step */ } with {
  briefly "Step1 input"
}
record Step1Result is { /* TODO: output from this step */ } with {
  briefly "Step1 output"
}
record Step2Args is { /* TODO: input, may include Step1 output */ } with {
  briefly "Step2 input"
}
record Step2Result is { /* TODO: output from this step */ } with {
  briefly "Step2 output"
}
record Step3Args is { /* input */ } with {
  briefly "Step3 input"
}
record Step3Result is { /* final output */ } with {
  briefly "Step3 output"
}

saga {SagaName} is {
  briefly "Distributed transaction saga for {SagaName}"

  requires record {SagaName}Args
  returns record {SagaName}Result

  // Step 1: First action
  step Step1 is {
    requires record Step1Args
    returns record Step1Result
    do {
      // TODO: send command DoStep1 to entity Target1
      ???
    }
    undo {
      // TODO: send command UndoStep1 to entity Target1
      ???
    }
  }

  // Step 2: Second action (depends on Step1)
  step Step2 is {
    requires record Step2Args
    returns record Step2Result
    do {
      // TODO: send command DoStep2 to entity Target2
      ???
    }
    undo {
      // TODO: send command UndoStep2 to entity Target2
      ???
    }
  }

  // Step 3: Final action
  step Step3 is {
    requires record Step3Args
    returns record Step3Result
    do {
      // TODO: send command DoStep3 to entity Target3
      ???
    }
    undo {
      // TODO: send command UndoStep3 to entity Target3
      ???
    }
  }
}
