// Saga Pattern (Distributed Transaction)
// Replace {SagaName} with your saga name (e.g., PlaceOrder, TransferFunds)
//
// NOTE (RIDDL 2.0): `requires`/`returns` take a NAMED type reference, not an
// inline aggregation. Declare a `record` and reference it as
// `requires record <Name>`. An inline `requires { ... }` still parses but
// raises a [deprecated] warning.
//
// NOTE: `requires`/`returns` belong to the SAGA, not to a step. A step's body
// is statements, its compensation is spelled `reverted by`, and its metadata
// follows both.

record {SagaName}Args is {
  ???
} with {
  briefly "Input required to start {SagaName}"
  described as {
    |What the caller must supply. TODO: add the input fields.
  }
}
record {SagaName}Result is {
  success: Boolean with {
    briefly "Succeeded"
    described as {
      |Whether every step completed without compensation.
    }
  }
} with {
  briefly "Outcome of {SagaName}"
  described as {
    |What the saga reports back. TODO: add the result fields.
  }
}

saga {SagaName} is {
  requires record {SagaName}Args
  returns record {SagaName}Result
  // Compensation runs the COMPLETED steps' `reverted by` blocks in reverse
  // order, so a failure in Step3 undoes Step2 and then Step1. Write each
  // `reverted by` to be safe if the step it reverses never took effect.
  step Step1 is {
    do "TODO: tell the command that performs this step"
  }
  reverted by {
    do "TODO: tell the command that reverses this step"
  }
 with {
    briefly "First action"
    described as {
      |TODO: in the step body, tell the command that performs it; in
      |`reverted by`, the command that reverses it.
    }
  }
  // Depends on Step1: it may read what Step1 produced.
  step Step2 is {
    do "TODO: tell the command that performs this step"
  }
  reverted by {
    do "TODO: tell the command that reverses this step"
  }
 with {
    briefly "Second action, which depends on Step1"
    described as {
      |TODO: in the step body, tell the command that performs it; in
      |`reverted by`, the command that reverses it.
    }
  }
  // The last step. If this one fails, everything before it is compensated.
  step Step3 is {
    do "TODO: tell the command that performs this step"
  }
  reverted by {
    do "TODO: tell the command that reverses this step"
  }
 with {
    briefly "Final action"
    described as {
      |TODO: in the step body, tell the command that performs it; in
      |`reverted by`, the command that reverses it.
    }
  }
} with {
  briefly "Distributed transaction saga for {SagaName}"
  described as {
    |A multi-step process across contexts. Each step names how to do it and
    |how to undo it, so a failure part-way through can be compensated rather
    |than left half-applied.
  }
}
