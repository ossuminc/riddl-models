// Freight Forwarding - Shipment Context
context ShipmentContext as router is {
  inlet ShipmentCommandStreamIn is type ShipmentCommand  outlet ShipmentCommandStreamOut is type ShipmentCommand
  inlet ShipmentResultStreamIn is result Shipment.ShipmentResult  outlet ShipmentResultStreamOut is result Shipment.ShipmentResult
  handler ShipmentContextBoundary is {
    on createShipment: command Shipment.CreateShipment is {
      send createShipment to outlet ShipmentContext.ShipmentCommandStreamOut
    }
    on attachQuote: command Shipment.AttachQuote is {
      send attachQuote to outlet ShipmentContext.ShipmentCommandStreamOut
    }
    on bookCarrier: command Shipment.BookCarrier is {
      send bookCarrier to outlet ShipmentContext.ShipmentCommandStreamOut
    }
    on assignContainers: command Shipment.AssignContainers is {
      send assignContainers to outlet ShipmentContext.ShipmentCommandStreamOut
    }
    on updateContainerSeal: command Shipment.UpdateContainerSeal is {
      send updateContainerSeal to outlet ShipmentContext.ShipmentCommandStreamOut
    }
    on schedulePickup: command Shipment.SchedulePickup is {
      send schedulePickup to outlet ShipmentContext.ShipmentCommandStreamOut
    }
    on recordMilestone: command Shipment.RecordMilestone is {
      send recordMilestone to outlet ShipmentContext.ShipmentCommandStreamOut
    }
    on issueDocument: command Shipment.IssueDocument is {
      send issueDocument to outlet ShipmentContext.ShipmentCommandStreamOut
    }
    on updateStatus: command Shipment.UpdateStatus is {
      send updateStatus to outlet ShipmentContext.ShipmentCommandStreamOut
    }
    on recordDelivery: command Shipment.RecordDelivery is {
      send recordDelivery to outlet ShipmentContext.ShipmentCommandStreamOut
    }
    on cancelShipment: command Shipment.CancelShipment is {
      send cancelShipment to outlet ShipmentContext.ShipmentCommandStreamOut
    }
    on shipmentResult: result Shipment.ShipmentResult is {
      send shipmentResult to outlet ShipmentContext.ShipmentResultStreamOut
    }
    on other is {
      error "Unexpected message at the ShipmentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ShipmentCommand Stream Intake' is from outlet ShipmentContext.ShipmentCommandStreamOut to inlet ShipmentContext.Shipment.ShipmentCommands  connector 'ShipmentResult Stream Egress' is from outlet ShipmentContext.ShipmentRepository.ShipmentRepositoryResponses to inlet ShipmentContext.ShipmentResultStreamIn  adaptor FromAirCarrierService from context AirCarrierService is { 
    handler FromAirCarrierServiceHandler is {
      on event AirCarrierService.AirBookingConfirmed is {
        do "the model receives air booking confirmed"
      }
      on result AirCarrierService.FlightResult is {
        do "the model receives flight result"
      }
      on other is {
        error "Unexpected message for adaptor FromAirCarrierService"
      }
    } with {
      briefly "from air carrier service"
      described as {
        |Carries messages from the external AirCarrierService.
      }
    }
  } with {
    briefly "AirCarrierService integration"
    described as {
      |The model's side of the AirCarrierService conversation.
    }
  }
  adaptor ToAirCarrierService to context AirCarrierService is { 
    handler ToAirCarrierServiceHandler is {
      on command AirCarrierService.BookAirFreight is {
        do "the model sends book air freight"
      }
      on query AirCarrierService.GetFlights is {
        do "the model sends get flights"
      }
      on other is {
        error "Unexpected message for adaptor ToAirCarrierService"
      }
    } with {
      briefly "to air carrier service"
      described as {
        |Carries messages to the external AirCarrierService.
      }
    }
  } with {
    briefly "AirCarrierService integration"
    described as {
      |The model's side of the AirCarrierService conversation.
    }
  }
  adaptor FromContainerTrackingService from context ContainerTrackingService is { 
    handler FromContainerTrackingServiceHandler is {
      on event ContainerTrackingService.ContainerMilestone is {
        do "the model receives container milestone"
      }
      on result ContainerTrackingService.ContainerTrackingResult is {
        do "the model receives container tracking result"
      }
      on other is {
        error "Unexpected message for adaptor FromContainerTrackingService"
      }
    } with {
      briefly "from container tracking service"
      described as {
        |Carries messages from the external ContainerTrackingService.
      }
    }
  } with {
    briefly "ContainerTrackingService integration"
    described as {
      |The model's side of the ContainerTrackingService conversation.
    }
  }
  adaptor ToContainerTrackingService to context ContainerTrackingService is { 
    handler ToContainerTrackingServiceHandler is {
      on query ContainerTrackingService.TrackContainer is {
        do "the model sends track container"
      }
      on other is {
        error "Unexpected message for adaptor ToContainerTrackingService"
      }
    } with {
      briefly "to container tracking service"
      described as {
        |Carries messages to the external ContainerTrackingService.
      }
    }
  } with {
    briefly "ContainerTrackingService integration"
    described as {
      |The model's side of the ContainerTrackingService conversation.
    }
  }
  adaptor FromDocumentGenerationService from context DocumentGenerationService is { 
    handler FromDocumentGenerationServiceHandler is {
      on event DocumentGenerationService.BillOfLadingGenerated is {
        do "the model receives bill of lading generated"
      }
      on event DocumentGenerationService.CommercialInvoiceGenerated is {
        do "the model receives commercial invoice generated"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentGenerationService"
      }
    } with {
      briefly "from document generation service"
      described as {
        |Carries messages from the external DocumentGenerationService.
      }
    }
  } with {
    briefly "DocumentGenerationService integration"
    described as {
      |The model's side of the DocumentGenerationService conversation.
    }
  }
  adaptor ToDocumentGenerationService to context DocumentGenerationService is { 
    handler ToDocumentGenerationServiceHandler is {
      on command DocumentGenerationService.GenerateBillOfLading is {
        do "the model sends generate bill of lading"
      }
      on command DocumentGenerationService.GenerateCommercialInvoice is {
        do "the model sends generate commercial invoice"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentGenerationService"
      }
    } with {
      briefly "to document generation service"
      described as {
        |Carries messages to the external DocumentGenerationService.
      }
    }
  } with {
    briefly "DocumentGenerationService integration"
    described as {
      |The model's side of the DocumentGenerationService conversation.
    }
  }
  adaptor FromOceanCarrierService from context OceanCarrierService is { 
    handler FromOceanCarrierServiceHandler is {
      on event OceanCarrierService.BookingConfirmed is {
        do "the model receives booking confirmed"
      }
      on event OceanCarrierService.BookingRejected is {
        do "the model receives booking rejected"
      }
      on result OceanCarrierService.ScheduleResult is {
        do "the model receives schedule result"
      }
      on other is {
        error "Unexpected message for adaptor FromOceanCarrierService"
      }
    } with {
      briefly "from ocean carrier service"
      described as {
        |Carries messages from the external OceanCarrierService.
      }
    }
  } with {
    briefly "OceanCarrierService integration"
    described as {
      |The model's side of the OceanCarrierService conversation.
    }
  }
  adaptor ToOceanCarrierService to context OceanCarrierService is { 
    handler ToOceanCarrierServiceHandler is {
      on query OceanCarrierService.GetSchedules is {
        do "the model sends get schedules"
      }
      on command OceanCarrierService.RequestBooking is {
        do "the model sends request booking"
      }
      on other is {
        error "Unexpected message for adaptor ToOceanCarrierService"
      }
    } with {
      briefly "to ocean carrier service"
      described as {
        |Carries messages to the external OceanCarrierService.
      }
    }
  } with {
    briefly "OceanCarrierService integration"
    described as {
      |The model's side of the OceanCarrierService conversation.
    }
  }
  adaptor FromRatingService from context RatingService is { 
    handler FromRatingServiceHandler is {
      on event RatingService.CustomQuoteProvided is {
        do "the model receives custom quote provided"
      }
      on result RatingService.RatesResult is {
        do "the model receives rates result"
      }
      on other is {
        error "Unexpected message for adaptor FromRatingService"
      }
    } with {
      briefly "from rating service"
      described as {
        |Carries messages from the external RatingService.
      }
    }
  } with {
    briefly "RatingService integration"
    described as {
      |The model's side of the RatingService conversation.
    }
  }
  adaptor ToRatingService to context RatingService is { 
    handler ToRatingServiceHandler is {
      on query RatingService.GetRates is {
        do "the model sends get rates"
      }
      on command RatingService.RequestCustomQuote is {
        do "the model sends request custom quote"
      }
      on other is {
        error "Unexpected message for adaptor ToRatingService"
      }
    } with {
      briefly "to rating service"
      described as {
        |Carries messages to the external RatingService.
      }
    }
  } with {
    briefly "RatingService integration"
    described as {
      |The model's side of the RatingService conversation.
    }
  }
  adaptor FromTruckingService from context TruckingService is { 
    handler FromTruckingServiceHandler is {
      on event TruckingService.DeliveryConfirmed is {
        do "the model receives delivery confirmed"
      }
      on event TruckingService.PickupCompleted is {
        do "the model receives pickup completed"
      }
      on event TruckingService.PickupConfirmed is {
        do "the model receives pickup confirmed"
      }
      on other is {
        error "Unexpected message for adaptor FromTruckingService"
      }
    } with {
      briefly "from trucking service"
      described as {
        |Carries messages from the external TruckingService.
      }
    }
  } with {
    briefly "TruckingService integration"
    described as {
      |The model's side of the TruckingService conversation.
    }
  }
  adaptor ToTruckingService to context TruckingService is { 
    handler ToTruckingServiceHandler is {
      on command TruckingService.RequestDelivery is {
        do "the model sends request delivery"
      }
      on command TruckingService.RequestPickup is {
        do "the model sends request pickup"
      }
      on other is {
        error "Unexpected message for adaptor ToTruckingService"
      }
    } with {
      briefly "to trucking service"
      described as {
        |Carries messages to the external TruckingService.
      }
    }
  } with {
    briefly "TruckingService integration"
    described as {
      |The model's side of the TruckingService conversation.
    }
  }
  include "types.riddl"
  include "Shipment.riddl"
  // Repository for shipment persistence
  type ShipmentRepositoryCommand is one of {
    ShipmentContext.ShipmentRepository.PersistCarrierBooked or ShipmentContext.ShipmentRepository.PersistContainerSealUpdated or ShipmentContext.ShipmentRepository.PersistContainersAssigned or ShipmentContext.ShipmentRepository.PersistDocumentIssued or ShipmentContext.ShipmentRepository.PersistMilestoneRecorded or ShipmentContext.ShipmentRepository.PersistPickupScheduled or ShipmentContext.ShipmentRepository.PersistQuoteAttached or ShipmentContext.ShipmentRepository.PersistShipmentCancelled or ShipmentContext.ShipmentRepository.PersistShipmentCreated or ShipmentContext.ShipmentRepository.PersistShipmentDelivered or ShipmentContext.ShipmentRepository.PersistShipmentStatusUpdated
  } with {
    briefly "Anything that writes ShipmentRepository"
    described as {
      |The persistence commands ShipmentRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ShipmentRepository as flow is {
    inlet ShipmentRepositoryFromForwardingAnalytics is type ShipmentRepositoryCommand    command PersistContainerSealUpdated is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContainerSealUpdated applies to.
        }
      }
    } with {
      briefly "Persist ContainerSealUpdated"
      described as {
        |Instructs this repository to apply ContainerSealUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContainersAssigned is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContainersAssigned applies to.
        }
      }
    } with {
      briefly "Persist ContainersAssigned"
      described as {
        |Instructs this repository to apply ContainersAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDocumentIssued is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DocumentIssued applies to.
        }
      }
    } with {
      briefly "Persist DocumentIssued"
      described as {
        |Instructs this repository to apply DocumentIssued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMilestoneRecorded is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row MilestoneRecorded applies to.
        }
      }
    } with {
      briefly "Persist MilestoneRecorded"
      described as {
        |Instructs this repository to apply MilestoneRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPickupScheduled is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row PickupScheduled applies to.
        }
      }
    } with {
      briefly "Persist PickupScheduled"
      described as {
        |Instructs this repository to apply PickupScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistQuoteAttached is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row QuoteAttached applies to.
        }
      }
    } with {
      briefly "Persist QuoteAttached"
      described as {
        |Instructs this repository to apply QuoteAttached to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentCancelled is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShipmentCancelled applies to.
        }
      }
    } with {
      briefly "Persist ShipmentCancelled"
      described as {
        |Instructs this repository to apply ShipmentCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentStatusUpdated is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShipmentStatusUpdated applies to.
        }
      }
    } with {
      briefly "Persist ShipmentStatusUpdated"
      described as {
        |Instructs this repository to apply ShipmentStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCarrierBooked is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row CarrierBooked applies to.
        }
      }
    } with {
      briefly "Persist CarrierBooked"
      described as {
        |Instructs this repository to apply CarrierBooked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentCreated is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShipmentCreated applies to.
        }
      }
    } with {
      briefly "Persist ShipmentCreated"
      described as {
        |Instructs this repository to apply ShipmentCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentDelivered is {
      shipmentId: ShipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ShipmentDelivered applies to.
        }
      }
    } with {
      briefly "Persist ShipmentDelivered"
      described as {
        |Instructs this repository to apply ShipmentDelivered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ShipmentRepositoryResponses is result Shipment.ShipmentResult
    record StoredShipment is {
      shipmentId: ShipmentId with {
        briefly "shipmentId"
        described as {
          |The shipmentId column of the stored shipment row.
        }
      }
      booking: CarrierBooking with {
        briefly "booking"
        described as {
          |The booking column of the stored shipment row.
        }
      }
      route: RouteInfo with {
        briefly "route"
        described as {
          |The route column of the stored shipment row.
        }
      }
      status: ShipmentStatus with {
        briefly "status"
        described as {
          |The status column of the stored shipment row.
        }
      }
    } with {
      briefly "Stored shipment row"
      described as {
        |The persistence shape of shipment data as this repository stores it.
      }
    }
    schema ShipmentData is relational
      of shipments as record StoredShipment
        index on field StoredShipment.shipmentId
        index on field StoredShipment.booking.bookingNumber
        index on field StoredShipment.route.originPort
        index on field StoredShipment.route.destinationPort
        index on field StoredShipment.status
 with {
      briefly "Shipment data schema"
      described as {
        |The relational schema holding shipment data for the ShipmentRepository.
      }
    }
    handler ShipmentPersistence is {
      on persistContainerSealUpdated: command PersistContainerSealUpdated is {
        do "apply ContainerSealUpdated to the stored row"
      }
      on persistContainersAssigned: command PersistContainersAssigned is {
        do "apply ContainersAssigned to the stored row"
      }
      on persistDocumentIssued: command PersistDocumentIssued is {
        do "apply DocumentIssued to the stored row"
      }
      on persistMilestoneRecorded: command PersistMilestoneRecorded is {
        do "apply MilestoneRecorded to the stored row"
      }
      on persistPickupScheduled: command PersistPickupScheduled is {
        do "apply PickupScheduled to the stored row"
      }
      on persistQuoteAttached: command PersistQuoteAttached is {
        do "apply QuoteAttached to the stored row"
      }
      on persistShipmentCancelled: command PersistShipmentCancelled is {
        do "apply ShipmentCancelled to the stored row"
      }
      on persistShipmentStatusUpdated: command PersistShipmentStatusUpdated is {
        do "apply ShipmentStatusUpdated to the stored row"
      }
      on persistCarrierBooked: command PersistCarrierBooked is {
        do "apply CarrierBooked to the stored row"
      }
      on persistShipmentCreated: command PersistShipmentCreated is {
        do "apply ShipmentCreated to the stored row"
      }
      on persistShipmentDelivered: command PersistShipmentDelivered is {
        do "apply ShipmentDelivered to the stored row"
      }
      on query GetForwardingStats is {
        let forwardingStatsView: type ForwardingStatsView = prompt("read the forwarding stats projection")
        reply forwardingStatsView
      }
    } with {
      briefly "Persists shipment commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Shipment data persistence"
    described as {
      | The ShipmentRepository provides persistent storage
      | for freight shipments.
    }
  }
  // Projector for forwarding analytics
  query GetForwardingStats replies result ForwardingStatsView is {
    forwardingStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which forwarding stats to retrieve.
      }
    }
  } with {
    briefly "Get forwarding stats"
    described as {
      |Retrieves the forwarding stats projection.
    }
  }
  result ForwardingStatsView is {
    forwardingStats: ForwardingAnalytics.ForwardingStats with {
      briefly "Forwarding stats"
      described as {
        |The forwarding stats being returned.
      }
    }
  } with {
    briefly "Forwarding stats view"
    described as {
      |Read model view carrying the forwarding stats projection.
    }
  }
  projector ForwardingAnalytics as flow is {
    updates repository ShipmentContext.ShipmentRepository
    outlet ForwardingAnalyticsToRepository is type ShipmentRepositoryCommand
    inlet ForwardingAnalyticsFromShipment is type ShipmentEvent    record ForwardingStats is {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      shipmentsBooked: Natural with {
        briefly "Booked"
        described as {
          |Shipments booked.
        }
      }
      shipmentsDelivered: Natural with {
        briefly "Delivered"
        described as {
          |Shipments delivered.
        }
      }
      teuVolume: Decimal(12,2) with {
        briefly "TEU"
        described as {
          |TEU volume.
        }
      }
      totalRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageTransitDays: Decimal(5,2) with {
        briefly "Transit"
        described as {
          |Avg transit days.
        }
      }
      onTimeDeliveryRate: Decimal(5,2) with {
        briefly "OTD"
        described as {
          |On-time delivery rate.
        }
      }
    } with {
      briefly "Forwarding statistics"
      described as {
        |Daily forwarding metrics.
      }
    }
    handler AnalyticsHandler is {
      on containerSealUpdated: event Shipment.ContainerSealUpdated is {
        tell command ShipmentContext.ShipmentRepository.PersistContainerSealUpdated(shipmentId = containerSealUpdated.shipmentId) to repository ShipmentContext.ShipmentRepository
        do "apply ContainerSealUpdated to the ForwardingAnalytics projection"
      }
      on containersAssigned: event Shipment.ContainersAssigned is {
        tell command ShipmentContext.ShipmentRepository.PersistContainersAssigned(shipmentId = containersAssigned.shipmentId) to repository ShipmentContext.ShipmentRepository
        do "apply ContainersAssigned to the ForwardingAnalytics projection"
      }
      on documentIssued: event Shipment.DocumentIssued is {
        tell command ShipmentContext.ShipmentRepository.PersistDocumentIssued(shipmentId = documentIssued.shipmentId) to repository ShipmentContext.ShipmentRepository
        do "apply DocumentIssued to the ForwardingAnalytics projection"
      }
      on milestoneRecorded: event Shipment.MilestoneRecorded is {
        tell command ShipmentContext.ShipmentRepository.PersistMilestoneRecorded(shipmentId = milestoneRecorded.shipmentId) to repository ShipmentContext.ShipmentRepository
        do "apply MilestoneRecorded to the ForwardingAnalytics projection"
      }
      on pickupScheduled: event Shipment.PickupScheduled is {
        tell command ShipmentContext.ShipmentRepository.PersistPickupScheduled(shipmentId = pickupScheduled.shipmentId) to repository ShipmentContext.ShipmentRepository
        do "apply PickupScheduled to the ForwardingAnalytics projection"
      }
      on quoteAttached: event Shipment.QuoteAttached is {
        tell command ShipmentContext.ShipmentRepository.PersistQuoteAttached(shipmentId = quoteAttached.shipmentId) to repository ShipmentContext.ShipmentRepository
        do "apply QuoteAttached to the ForwardingAnalytics projection"
      }
      on shipmentCancelled: event Shipment.ShipmentCancelled is {
        tell command ShipmentContext.ShipmentRepository.PersistShipmentCancelled(shipmentId = shipmentCancelled.shipmentId) to repository ShipmentContext.ShipmentRepository
        do "apply ShipmentCancelled to the ForwardingAnalytics projection"
      }
      on shipmentStatusUpdated: event Shipment.ShipmentStatusUpdated is {
        tell command ShipmentContext.ShipmentRepository.PersistShipmentStatusUpdated(shipmentId = shipmentStatusUpdated.shipmentId) to repository ShipmentContext.ShipmentRepository
        do "apply ShipmentStatusUpdated to the ForwardingAnalytics projection"
      }
      on shipmentCreated: event Shipment.ShipmentCreated is {
        tell command ShipmentContext.ShipmentRepository.PersistShipmentCreated(shipmentId = shipmentCreated.shipmentId) to repository ShipmentContext.ShipmentRepository
        do "Update booking metrics"
      }
      on carrierBooked: event Shipment.CarrierBooked is {
        tell command ShipmentContext.ShipmentRepository.PersistCarrierBooked(shipmentId = carrierBooked.shipmentId) to repository ShipmentContext.ShipmentRepository
        do "Update volume metrics"
      }
      on shipmentDelivered: event Shipment.ShipmentDelivered is {
        tell command ShipmentContext.ShipmentRepository.PersistShipmentDelivered(shipmentId = shipmentDelivered.shipmentId) to repository ShipmentContext.ShipmentRepository
        do "Update delivery metrics"
      }
    } with {
      briefly "Maintains forwarding analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Forwarding analytics projections"
    described as {
      |Maintains freight forwarding analytics.
    }
  }
  // ---- Event publication for Shipment ----
  type ShipmentEvent is one of {
    ShipmentContext.Shipment.ShipmentCreated or ShipmentContext.Shipment.QuoteAttached or ShipmentContext.Shipment.CarrierBooked or ShipmentContext.Shipment.ContainersAssigned or ShipmentContext.Shipment.ContainerSealUpdated or ShipmentContext.Shipment.PickupScheduled or ShipmentContext.Shipment.MilestoneRecorded or ShipmentContext.Shipment.DocumentIssued or ShipmentContext.Shipment.ShipmentStatusUpdated or ShipmentContext.Shipment.ShipmentDelivered or ShipmentContext.Shipment.ShipmentCancelled
  } with {
    briefly "Shipment event alternation"
    described as {
      |Union of all Shipment events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet ShipmentEventSplit as flow is {
    inlet ShipmentEventSplitIn is type ShipmentEvent    outlet ShipmentEventSplitToForwardingAnalytics is type ShipmentEvent
    handler ShipmentEventSplitHandler is {
      on shipmentCreated: event Shipment.ShipmentCreated is {
        send shipmentCreated to outlet ShipmentEventSplitToForwardingAnalytics
        tell shipmentCreated to entity ShipmentContext.Shipment
      }
      on quoteAttached: event Shipment.QuoteAttached is {
        send quoteAttached to outlet ShipmentEventSplitToForwardingAnalytics
        tell quoteAttached to entity ShipmentContext.Shipment
      }
      on carrierBooked: event Shipment.CarrierBooked is {
        send carrierBooked to outlet ShipmentEventSplitToForwardingAnalytics
        tell carrierBooked to entity ShipmentContext.Shipment
      }
      on containersAssigned: event Shipment.ContainersAssigned is {
        send containersAssigned to outlet ShipmentEventSplitToForwardingAnalytics
        tell containersAssigned to entity ShipmentContext.Shipment
      }
      on containerSealUpdated: event Shipment.ContainerSealUpdated is {
        send containerSealUpdated to outlet ShipmentEventSplitToForwardingAnalytics
        tell containerSealUpdated to entity ShipmentContext.Shipment
      }
      on pickupScheduled: event Shipment.PickupScheduled is {
        send pickupScheduled to outlet ShipmentEventSplitToForwardingAnalytics
        tell pickupScheduled to entity ShipmentContext.Shipment
      }
      on milestoneRecorded: event Shipment.MilestoneRecorded is {
        send milestoneRecorded to outlet ShipmentEventSplitToForwardingAnalytics
        tell milestoneRecorded to entity ShipmentContext.Shipment
      }
      on documentIssued: event Shipment.DocumentIssued is {
        send documentIssued to outlet ShipmentEventSplitToForwardingAnalytics
        tell documentIssued to entity ShipmentContext.Shipment
      }
      on shipmentStatusUpdated: event Shipment.ShipmentStatusUpdated is {
        send shipmentStatusUpdated to outlet ShipmentEventSplitToForwardingAnalytics
        tell shipmentStatusUpdated to entity ShipmentContext.Shipment
      }
      on shipmentDelivered: event Shipment.ShipmentDelivered is {
        send shipmentDelivered to outlet ShipmentEventSplitToForwardingAnalytics
        tell shipmentDelivered to entity ShipmentContext.Shipment
      }
      on shipmentCancelled: event Shipment.ShipmentCancelled is {
        send shipmentCancelled to outlet ShipmentEventSplitToForwardingAnalytics
        tell shipmentCancelled to entity ShipmentContext.Shipment
      }
      on other is {
        error "Unexpected message for processor ShipmentEventSplit"
      }
    } with {
      briefly "Shipment event fan-out handler"
      described as {
        |Delivers each Shipment event to all of its consumers.
      }
    }
  } with {
    briefly "Shipment event fan-out"
    described as {
      |Fans Shipment events out to the repository and projectors.
    }
  }
  connector 'ShipmentStreamEvent Stream' is from outlet ShipmentContext.Shipment.ShipmentEvents2 to inlet ShipmentContext.ShipmentEventSplit.ShipmentEventSplitIn with {
    briefly "Shipment events, fanned out to storage and read models"
  }
  connector 'ForwardingAnalytics Feed' is from outlet ShipmentContext.ShipmentEventSplit.ShipmentEventSplitToForwardingAnalytics to inlet ShipmentContext.ForwardingAnalytics.ForwardingAnalyticsFromShipment with {
    briefly "Shipment events feeding the ForwardingAnalytics projection"
  }
  connector 'ForwardingAnalytics Storage' is from outlet ShipmentContext.ForwardingAnalytics.ForwardingAnalyticsToRepository to inlet ShipmentContext.ShipmentRepository.ShipmentRepositoryFromForwardingAnalytics with {
    briefly "ForwardingAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for shipments"
  described as {
    | The ShipmentContext is the bounded context for
    | freight forwarding operations.
  }
}
