// Freight Forwarding - Shipment Context
context ShipmentContext is {
  include "types.riddl"
  include "Shipment.riddl"
  // Repository for shipment persistence
  repository ShipmentRepository is {
    schema ShipmentData is relational
      of shipments as type Shipment
        index on field Shipment.shipmentId
        index on field Shipment.booking.bookingNumber
        index on field Shipment.route.originPort
        index on field Shipment.route.destinationPort
        index on field Shipment.status

    handler ShipmentPersistence is {
      on command Shipment.CreateShipment is {
        tell event Shipment.ShipmentCreated to entity ShipmentContext.Shipment
        prompt "Store new shipment"
      }
      on command Shipment.AttachQuote is {
        prompt "Store quote"
      }
      on command Shipment.BookCarrier is {
        prompt "Store carrier booking"
      }
      on command Shipment.AssignContainers is {
        tell event Shipment.ContainersAssigned to entity ShipmentContext.Shipment
        prompt "Store containers"
      }
      on command Shipment.UpdateContainerSeal is {
        tell event Shipment.ContainerSealUpdated to entity ShipmentContext.Shipment
        prompt "Update container seal"
      }
      on command Shipment.SchedulePickup is {
        tell event Shipment.PickupScheduled to entity ShipmentContext.Shipment
        prompt "Store pickup schedule"
      }
      on command Shipment.RecordMilestone is {
        tell event Shipment.MilestoneRecorded to entity ShipmentContext.Shipment
        prompt "Store milestone"
      }
      on command Shipment.IssueDocument is {
        tell event Shipment.DocumentIssued to entity ShipmentContext.Shipment
        prompt "Store document"
      }
      on command Shipment.UpdateStatus is {
        prompt "Update status"
      }
      on command Shipment.RecordDelivery is {
        prompt "Update to delivered"
      }
      on command Shipment.CancelShipment is {
        tell event Shipment.ShipmentCancelled to entity ShipmentContext.Shipment
        prompt "Update to cancelled"
      }
    } with {
      briefly "Persists shipment commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Shipment data persistence"
    described as {
      | The ShipmentRepository provides persistent storage
      | for freight shipments.
    }
  }
  // Projector for forwarding analytics
  projector ForwardingAnalytics is {
    updates repository ShipmentContext.ShipmentRepository
    record ForwardingStats is  {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      shipmentsBooked: Natural with {
        briefly "Booked"
        described as {
          |Shipments booked.
        }
      }
      shipmentsDelivered: Natural with {
        briefly "Delivered"
        described as {
          |Shipments delivered.
        }
      }
      teuVolume: Decimal(12,2) with {
        briefly "TEU"
        described as {
          |TEU volume.
        }
      }
      totalRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageTransitDays: Decimal(5,2) with {
        briefly "Transit"
        described as {
          |Avg transit days.
        }
      }
      onTimeDeliveryRate: Decimal(5,2) with {
        briefly "OTD"
        described as {
          |On-time delivery rate.
        }
      }
    } with {
      briefly "Forwarding statistics"
      described as {
        |Daily forwarding metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Shipment.ShipmentCreated is {
        tell event Shipment.ShipmentCreated to repository ShipmentContext.ShipmentRepository
        prompt "Update booking metrics"
      }
      on event Shipment.CarrierBooked is {
        tell event Shipment.CarrierBooked to repository ShipmentContext.ShipmentRepository
        prompt "Update volume metrics"
      }
      on event Shipment.ShipmentDelivered is {
        tell event Shipment.ShipmentDelivered to repository ShipmentContext.ShipmentRepository
        prompt "Update delivery metrics"
      }
    } with {
      briefly "Maintains forwarding analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Forwarding analytics projections"
    described as {
      |Maintains freight forwarding analytics.
    }
  }
  // ---- Event publication for Shipment ----
  type ShipmentEvent is one of {
    ShipmentContext.Shipment.ShipmentCreated,
    ShipmentContext.Shipment.QuoteAttached,
    ShipmentContext.Shipment.CarrierBooked,
    ShipmentContext.Shipment.ContainersAssigned,
    ShipmentContext.Shipment.ContainerSealUpdated,
    ShipmentContext.Shipment.PickupScheduled,
    ShipmentContext.Shipment.MilestoneRecorded,
    ShipmentContext.Shipment.DocumentIssued,
    ShipmentContext.Shipment.ShipmentStatusUpdated,
    ShipmentContext.Shipment.ShipmentDelivered,
    ShipmentContext.Shipment.ShipmentCancelled
  } with {
    briefly "Shipment event alternation"
    described as {
      |Union of all Shipment events, for streaming and event-sourced
      |persistence.
    }
  }
  source ShipmentEventSource is {
    outlet ShipmentEvents is type ShipmentEvent
    handler ShipmentSourceHandler is {
      on event Shipment.ShipmentCreated is {
        send event Shipment.ShipmentCreated to outlet ShipmentEvents
      }
      on event Shipment.QuoteAttached is {
        send event Shipment.QuoteAttached to outlet ShipmentEvents
      }
      on event Shipment.CarrierBooked is {
        send event Shipment.CarrierBooked to outlet ShipmentEvents
      }
      on event Shipment.ContainersAssigned is {
        send event Shipment.ContainersAssigned to outlet ShipmentEvents
      }
      on event Shipment.ContainerSealUpdated is {
        send event Shipment.ContainerSealUpdated to outlet ShipmentEvents
      }
      on event Shipment.PickupScheduled is {
        send event Shipment.PickupScheduled to outlet ShipmentEvents
      }
      on event Shipment.MilestoneRecorded is {
        send event Shipment.MilestoneRecorded to outlet ShipmentEvents
      }
      on event Shipment.DocumentIssued is {
        send event Shipment.DocumentIssued to outlet ShipmentEvents
      }
      on event Shipment.ShipmentStatusUpdated is {
        send event Shipment.ShipmentStatusUpdated to outlet ShipmentEvents
      }
      on event Shipment.ShipmentDelivered is {
        send event Shipment.ShipmentDelivered to outlet ShipmentEvents
      }
      on event Shipment.ShipmentCancelled is {
        send event Shipment.ShipmentCancelled to outlet ShipmentEvents
      }
      on other is {
        error "Unexpected message for source ShipmentEventSource"
      }
    } with {
      briefly "Shipment source handler"
      described as {
        |Publishes Shipment events onto the outlet.
      }
    }
  } with {
    briefly "Shipment event source"
    described as {
      |Publishes Shipment entity events into the streaming topology.
    }
  }
  sink ShipmentEventSink is {
    inlet ShipmentInlet is type ShipmentEvent
    handler ShipmentSinkHandler is {
      on event Shipment.ShipmentCreated is {
        tell event Shipment.ShipmentCreated to repository ShipmentContext.ShipmentRepository
      }
      on event Shipment.QuoteAttached is {
        tell event Shipment.QuoteAttached to repository ShipmentContext.ShipmentRepository
      }
      on event Shipment.CarrierBooked is {
        tell event Shipment.CarrierBooked to repository ShipmentContext.ShipmentRepository
      }
      on event Shipment.ContainersAssigned is {
        tell event Shipment.ContainersAssigned to repository ShipmentContext.ShipmentRepository
      }
      on event Shipment.ContainerSealUpdated is {
        tell event Shipment.ContainerSealUpdated to repository ShipmentContext.ShipmentRepository
      }
      on event Shipment.PickupScheduled is {
        tell event Shipment.PickupScheduled to repository ShipmentContext.ShipmentRepository
      }
      on event Shipment.MilestoneRecorded is {
        tell event Shipment.MilestoneRecorded to repository ShipmentContext.ShipmentRepository
      }
      on event Shipment.DocumentIssued is {
        tell event Shipment.DocumentIssued to repository ShipmentContext.ShipmentRepository
      }
      on event Shipment.ShipmentStatusUpdated is {
        tell event Shipment.ShipmentStatusUpdated to repository ShipmentContext.ShipmentRepository
      }
      on event Shipment.ShipmentDelivered is {
        tell event Shipment.ShipmentDelivered to repository ShipmentContext.ShipmentRepository
      }
      on event Shipment.ShipmentCancelled is {
        tell event Shipment.ShipmentCancelled to repository ShipmentContext.ShipmentRepository
      }
      on other is {
        error "Unexpected message for sink ShipmentEventSink"
      }
    } with {
      briefly "Shipment sink handler"
      described as {
        |Persists Shipment events via the repository.
      }
    }
  } with {
    briefly "Shipment event sink"
    described as {
      |Receives Shipment events for persistence.
    }
  }
  connector ShipmentEventFlow is {
    from outlet ShipmentContext.ShipmentEventSource.ShipmentEvents to
      inlet ShipmentContext.ShipmentEventSink.ShipmentInlet
  } with {
    briefly "Shipment event flow"
    described as {
      |Connects the Shipment source to its sink.
    }
  }
} with {
  briefly "Bounded context for shipments"
  described as {
    | The ShipmentContext is the bounded context for
    | freight forwarding operations.
  }
}
