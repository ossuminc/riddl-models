// Freight Forwarding Domain Model
// International logistics and cargo booking
domain FreightForwarding is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user FreightForwarder is "person coordinating shipments" with {
    briefly "Freight Forwarder"
    described as {
      |Staff managing international logistics.
    }
  }
  user Shipper is "person sending cargo" with {
    briefly "Shipper"
    described as {
      |Business shipping goods.
    }
  }
  user Consignee is "person receiving cargo" with {
    briefly "Consignee"
    described as {
      |Business receiving goods.
    }
  }
  epic ForwardingEpic is {
    user Shipper wants to "to ship cargo internationally" so that "goods reach their destination"
    case BookShipment is {
      user Shipper wants to "to book international cargo" so that "goods are transported"
      step is "Shipper requests" "quote for shipment" "with cargo details" with {
        briefly "Request quote"
        described as {
          |Get shipping quote.
        }
      }
      step take input FreightForwardingApp.FreightForwardingScreen.CreateShipmentInput from user FreightForwarder with {
        briefly "Create shipment"
        described as {
          |Book the shipment.
        }
      }
      step is "Forwarder coordinates" "carriers and customs" "for delivery" with {
        briefly "Coordinate"
        described as {
          |Manage logistics.
        }
      }
    } with {
      briefly "Book shipment"
      described as {
        |Shipment booking workflow.
      }
    }
  } with {
    briefly "Freight forwarding"
    described as {
      | Epic covering cargo booking, carrier coordination,
      | and shipment tracking.
    }
  }
  include "ShipmentContext.riddl"
  include "external-contexts.riddl"
  application context FreightForwardingApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in FreightForwarding are delivered.
      }
    }
    group FreightForwardingScreen is {
      input CreateShipmentInput acquires command ShipmentContext.Shipment.CreateShipment with {
        briefly "Create shipment control"
        described as {
          |The control through which a user submits the create shipment request.
        }
      }
    } with {
      briefly "Freight forwarding screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppShipmentCommands is type ShipmentContext.Shipment.ShipmentCommand
    inlet AppShipmentRepositoryResponses is type ShipmentContext.Shipment.ShipmentResult    handler FreightForwardingAppHandler is {
      on other is {
        error "Unexpected message for application context FreightForwardingApp"
      }
    } with {
      briefly "FreightForwardingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "FreightForwardingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ShipmentCommand Stream' is from outlet FreightForwardingApp.AppShipmentCommands to inlet ShipmentContext.Shipment.ShipmentCommands with {
    briefly "Shipment commands from the application"
  }
  persistent connector 'ShipmentResult Stream' is from outlet ShipmentContext.ShipmentRepository.ShipmentRepositoryResponses to inlet FreightForwardingApp.AppShipmentRepositoryResponses with {
    briefly "Shipment query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet FreightForwardingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Freight forwarding domain"
  described as {
    | The FreightForwarding domain handles international
    | logistics and cargo management.
  }
}
