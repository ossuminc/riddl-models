// Intermodal Domain Model
// Multi-modal freight transportation management
domain Intermodal is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user IntermodalPlanner is "person planning intermodal moves" with {
    briefly "Intermodal Planner"
    described as {
      |Staff coordinating multi-modal transport.
    }
  }
  user TerminalOperator is "person managing terminal operations" with {
    briefly "Terminal Operator"
    described as {
      |Staff at intermodal terminal.
    }
  }
  user RailDispatcher is "person coordinating rail movements" with {
    briefly "Rail Dispatcher"
    described as {
      |Staff managing rail operations.
    }
  }
  epic IntermodalEpic is {
    user IntermodalPlanner wants to "to coordinate intermodal transport" so that "cargo moves efficiently between modes"
    case PlanIntermodalMove is {
      user IntermodalPlanner wants to "to plan a rail-truck intermodal move" so that "cargo is transported cost-effectively"
      step is "Planner evaluates" "routing options" "for shipment" with {
        briefly "Evaluate routes"
        described as {
          |Find best route.
        }
      }
      step take input IntermodalApp.IntermodalScreen.CreateMoveInput from user IntermodalPlanner with {
        briefly "Create move"
        described as {
          |Book the move.
        }
      }
      step is "System coordinates" "rail and dray" "segments" with {
        briefly "Coordinate"
        described as {
          |Execute transport.
        }
      }
    } with {
      briefly "Plan intermodal move"
      described as {
        |Intermodal planning workflow.
      }
    }
  } with {
    briefly "Intermodal transport"
    described as {
      | Epic covering intermodal planning, terminal operations,
      | and multi-modal coordination.
    }
  }
  include "MoveContext.riddl"
  include "external-contexts.riddl"
  application context IntermodalApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in Intermodal are delivered.
      }
    }
    group IntermodalScreen is {
      input CreateMoveInput acquires command MoveContext.Move.CreateMove with {
        briefly "Create move control"
        described as {
          |The control through which a user submits the create move request.
        }
      }
    } with {
      briefly "Intermodal screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppMoveCommands is type MoveContext.Move.MoveCommand
    inlet AppMoveRepositoryResponses is type MoveContext.Move.MoveResult    handler IntermodalAppHandler is {
      on other is {
        error "Unexpected message for application context IntermodalApp"
      }
    } with {
      briefly "IntermodalApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "IntermodalApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'MoveCommand Stream' is from outlet IntermodalApp.AppMoveCommands to inlet MoveContext.Move.MoveCommands with {
    briefly "Move commands from the application"
  }
  persistent connector 'MoveResult Stream' is from outlet MoveContext.MoveRepository.MoveRepositoryResponses to inlet IntermodalApp.AppMoveRepositoryResponses with {
    briefly "Move query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet IntermodalApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Intermodal domain"
  described as {
    | The Intermodal domain handles multi-modal
    | freight transportation.
  }
}
