// Intermodal - Move Context
context MoveContext as router is {
  inlet MoveCommandStreamIn is type MoveCommand  outlet MoveCommandStreamOut is type MoveCommand
  inlet MoveResultStreamIn is result Move.MoveResult  outlet MoveResultStreamOut is result Move.MoveResult
  handler MoveContextBoundary is {
    on createMove: command Move.CreateMove is {
      send createMove to outlet MoveContext.MoveCommandStreamOut
    }
    on scheduleOriginDray: command Move.ScheduleOriginDray is {
      send scheduleOriginDray to outlet MoveContext.MoveCommandStreamOut
    }
    on recordTerminalIngate: command Move.RecordTerminalIngate is {
      send recordTerminalIngate to outlet MoveContext.MoveCommandStreamOut
    }
    on assignToTrain: command Move.AssignToTrain is {
      send assignToTrain to outlet MoveContext.MoveCommandStreamOut
    }
    on recordTrainDeparture: command Move.RecordTrainDeparture is {
      send recordTrainDeparture to outlet MoveContext.MoveCommandStreamOut
    }
    on recordTrainArrival: command Move.RecordTrainArrival is {
      send recordTrainArrival to outlet MoveContext.MoveCommandStreamOut
    }
    on recordTerminalOutgate: command Move.RecordTerminalOutgate is {
      send recordTerminalOutgate to outlet MoveContext.MoveCommandStreamOut
    }
    on scheduleDestinationDray: command Move.ScheduleDestinationDray is {
      send scheduleDestinationDray to outlet MoveContext.MoveCommandStreamOut
    }
    on recordDelivery: command Move.RecordDelivery is {
      send recordDelivery to outlet MoveContext.MoveCommandStreamOut
    }
    on recordException: command Move.RecordException is {
      send recordException to outlet MoveContext.MoveCommandStreamOut
    }
    on cancelMove: command Move.CancelMove is {
      send cancelMove to outlet MoveContext.MoveCommandStreamOut
    }
    on moveResult: result Move.MoveResult is {
      send moveResult to outlet MoveContext.MoveResultStreamOut
    }
    on other is {
      error "Unexpected message at the MoveContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'MoveCommand Stream Intake' is from outlet MoveContext.MoveCommandStreamOut to inlet MoveContext.Move.MoveCommands  connector 'MoveResult Stream Egress' is from outlet MoveContext.MoveRepository.MoveRepositoryResponses to inlet MoveContext.MoveResultStreamIn  adaptor FromChassisPoolService from context ChassisPoolService is { 
    handler FromChassisPoolServiceHandler is {
      on result ChassisPoolService.ChassisAvailabilityResult is {
        do "the model receives chassis availability result"
      }
      on event ChassisPoolService.ChassisReserved is {
        do "the model receives chassis reserved"
      }
      on event ChassisPoolService.ChassisReturned is {
        do "the model receives chassis returned"
      }
      on other is {
        error "Unexpected message for adaptor FromChassisPoolService"
      }
    } with {
      briefly "from chassis pool service"
      described as {
        |Carries messages from the external ChassisPoolService.
      }
    }
  } with {
    briefly "ChassisPoolService integration"
    described as {
      |The model's side of the ChassisPoolService conversation.
    }
  }
  adaptor ToChassisPoolService to context ChassisPoolService is { 
    handler ToChassisPoolServiceHandler is {
      on query ChassisPoolService.GetChassisAvailability is {
        do "the model sends get chassis availability"
      }
      on command ChassisPoolService.ReserveChassis is {
        do "the model sends reserve chassis"
      }
      on other is {
        error "Unexpected message for adaptor ToChassisPoolService"
      }
    } with {
      briefly "to chassis pool service"
      described as {
        |Carries messages to the external ChassisPoolService.
      }
    }
  } with {
    briefly "ChassisPoolService integration"
    described as {
      |The model's side of the ChassisPoolService conversation.
    }
  }
  adaptor FromDrayCarrierService from context DrayCarrierService is { 
    handler FromDrayCarrierServiceHandler is {
      on event DrayCarrierService.DrayCompleted is {
        do "the model receives dray completed"
      }
      on event DrayCarrierService.DrayConfirmed is {
        do "the model receives dray confirmed"
      }
      on event DrayCarrierService.DrayDispatched is {
        do "the model receives dray dispatched"
      }
      on other is {
        error "Unexpected message for adaptor FromDrayCarrierService"
      }
    } with {
      briefly "from dray carrier service"
      described as {
        |Carries messages from the external DrayCarrierService.
      }
    }
  } with {
    briefly "DrayCarrierService integration"
    described as {
      |The model's side of the DrayCarrierService conversation.
    }
  }
  adaptor ToDrayCarrierService to context DrayCarrierService is { 
    handler ToDrayCarrierServiceHandler is {
      on command DrayCarrierService.RequestDray is {
        do "the model sends request dray"
      }
      on other is {
        error "Unexpected message for adaptor ToDrayCarrierService"
      }
    } with {
      briefly "to dray carrier service"
      described as {
        |Carries messages to the external DrayCarrierService.
      }
    }
  } with {
    briefly "DrayCarrierService integration"
    described as {
      |The model's side of the DrayCarrierService conversation.
    }
  }
  adaptor FromIntermodalRatingService from context IntermodalRatingService is { 
    handler FromIntermodalRatingServiceHandler is {
      on result IntermodalRatingService.RatesResult is {
        do "the model receives rates result"
      }
      on other is {
        error "Unexpected message for adaptor FromIntermodalRatingService"
      }
    } with {
      briefly "from intermodal rating service"
      described as {
        |Carries messages from the external IntermodalRatingService.
      }
    }
  } with {
    briefly "IntermodalRatingService integration"
    described as {
      |The model's side of the IntermodalRatingService conversation.
    }
  }
  adaptor ToIntermodalRatingService to context IntermodalRatingService is { 
    handler ToIntermodalRatingServiceHandler is {
      on query IntermodalRatingService.GetRates is {
        do "the model sends get rates"
      }
      on other is {
        error "Unexpected message for adaptor ToIntermodalRatingService"
      }
    } with {
      briefly "to intermodal rating service"
      described as {
        |Carries messages to the external IntermodalRatingService.
      }
    }
  } with {
    briefly "IntermodalRatingService integration"
    described as {
      |The model's side of the IntermodalRatingService conversation.
    }
  }
  adaptor FromRailCarrierService from context RailCarrierService is { 
    handler FromRailCarrierServiceHandler is {
      on result RailCarrierService.AvailabilityResult is {
        do "the model receives availability result"
      }
      on event RailCarrierService.RailBookingConfirmed is {
        do "the model receives rail booking confirmed"
      }
      on event RailCarrierService.TrainArrived is {
        do "the model receives train arrived"
      }
      on event RailCarrierService.TrainDeparted is {
        do "the model receives train departed"
      }
      on other is {
        error "Unexpected message for adaptor FromRailCarrierService"
      }
    } with {
      briefly "from rail carrier service"
      described as {
        |Carries messages from the external RailCarrierService.
      }
    }
  } with {
    briefly "RailCarrierService integration"
    described as {
      |The model's side of the RailCarrierService conversation.
    }
  }
  adaptor ToRailCarrierService to context RailCarrierService is { 
    handler ToRailCarrierServiceHandler is {
      on command RailCarrierService.BookRail is {
        do "the model sends book rail"
      }
      on query RailCarrierService.GetAvailability is {
        do "the model sends get availability"
      }
      on other is {
        error "Unexpected message for adaptor ToRailCarrierService"
      }
    } with {
      briefly "to rail carrier service"
      described as {
        |Carries messages to the external RailCarrierService.
      }
    }
  } with {
    briefly "RailCarrierService integration"
    described as {
      |The model's side of the RailCarrierService conversation.
    }
  }
  adaptor FromTerminalOperatingSystem from context TerminalOperatingSystem is { 
    handler FromTerminalOperatingSystemHandler is {
      on event TerminalOperatingSystem.ContainerIngated is {
        do "the model receives container ingated"
      }
      on event TerminalOperatingSystem.ContainerLoaded is {
        do "the model receives container loaded"
      }
      on event TerminalOperatingSystem.ContainerOutgated is {
        do "the model receives container outgated"
      }
      on event TerminalOperatingSystem.ContainerUnloaded is {
        do "the model receives container unloaded"
      }
      on other is {
        error "Unexpected message for adaptor FromTerminalOperatingSystem"
      }
    } with {
      briefly "from terminal operating system"
      described as {
        |Carries messages from the external TerminalOperatingSystem.
      }
    }
  } with {
    briefly "TerminalOperatingSystem integration"
    described as {
      |The model's side of the TerminalOperatingSystem conversation.
    }
  }
  adaptor ToTerminalOperatingSystem to context TerminalOperatingSystem is { 
    handler ToTerminalOperatingSystemHandler is {
      on command TerminalOperatingSystem.RequestIngate is {
        do "the model sends request ingate"
      }
      on other is {
        error "Unexpected message for adaptor ToTerminalOperatingSystem"
      }
    } with {
      briefly "to terminal operating system"
      described as {
        |Carries messages to the external TerminalOperatingSystem.
      }
    }
  } with {
    briefly "TerminalOperatingSystem integration"
    described as {
      |The model's side of the TerminalOperatingSystem conversation.
    }
  }
  include "types.riddl"
  include "Move.riddl"
  // Repository for move persistence
  type MoveRepositoryCommand is one of {
    MoveContext.MoveRepository.PersistAssignedToTrain or MoveContext.MoveRepository.PersistDeliveryRecorded or MoveContext.MoveRepository.PersistDestinationDrayScheduled or MoveContext.MoveRepository.PersistExceptionRecorded or MoveContext.MoveRepository.PersistMoveCancelled or MoveContext.MoveRepository.PersistMoveCreated or MoveContext.MoveRepository.PersistOriginDrayScheduled or MoveContext.MoveRepository.PersistTerminalIngateRecorded or MoveContext.MoveRepository.PersistTerminalOutgateRecorded or MoveContext.MoveRepository.PersistTrainArrivalRecorded or MoveContext.MoveRepository.PersistTrainDepartureRecorded
  } with {
    briefly "Anything that writes MoveRepository"
    described as {
      |The persistence commands MoveRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository MoveRepository as flow is {
    inlet MoveRepositoryFromIntermodalAnalytics is type MoveRepositoryCommand    command PersistAssignedToTrain is {
      moveId: MoveId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssignedToTrain applies to.
        }
      }
    } with {
      briefly "Persist AssignedToTrain"
      described as {
        |Instructs this repository to apply AssignedToTrain to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDestinationDrayScheduled is {
      moveId: MoveId with {
        briefly "Row addressed"
        described as {
          |Which stored row DestinationDrayScheduled applies to.
        }
      }
    } with {
      briefly "Persist DestinationDrayScheduled"
      described as {
        |Instructs this repository to apply DestinationDrayScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMoveCancelled is {
      moveId: MoveId with {
        briefly "Row addressed"
        described as {
          |Which stored row MoveCancelled applies to.
        }
      }
    } with {
      briefly "Persist MoveCancelled"
      described as {
        |Instructs this repository to apply MoveCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOriginDrayScheduled is {
      moveId: MoveId with {
        briefly "Row addressed"
        described as {
          |Which stored row OriginDrayScheduled applies to.
        }
      }
    } with {
      briefly "Persist OriginDrayScheduled"
      described as {
        |Instructs this repository to apply OriginDrayScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTerminalIngateRecorded is {
      moveId: MoveId with {
        briefly "Row addressed"
        described as {
          |Which stored row TerminalIngateRecorded applies to.
        }
      }
    } with {
      briefly "Persist TerminalIngateRecorded"
      described as {
        |Instructs this repository to apply TerminalIngateRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTerminalOutgateRecorded is {
      moveId: MoveId with {
        briefly "Row addressed"
        described as {
          |Which stored row TerminalOutgateRecorded applies to.
        }
      }
    } with {
      briefly "Persist TerminalOutgateRecorded"
      described as {
        |Instructs this repository to apply TerminalOutgateRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrainArrivalRecorded is {
      moveId: MoveId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrainArrivalRecorded applies to.
        }
      }
    } with {
      briefly "Persist TrainArrivalRecorded"
      described as {
        |Instructs this repository to apply TrainArrivalRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrainDepartureRecorded is {
      moveId: MoveId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrainDepartureRecorded applies to.
        }
      }
    } with {
      briefly "Persist TrainDepartureRecorded"
      described as {
        |Instructs this repository to apply TrainDepartureRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryRecorded is {
      moveId: MoveId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryRecorded applies to.
        }
      }
    } with {
      briefly "Persist DeliveryRecorded"
      described as {
        |Instructs this repository to apply DeliveryRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExceptionRecorded is {
      moveId: MoveId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExceptionRecorded applies to.
        }
      }
    } with {
      briefly "Persist ExceptionRecorded"
      described as {
        |Instructs this repository to apply ExceptionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMoveCreated is {
      moveId: MoveId with {
        briefly "Row addressed"
        described as {
          |Which stored row MoveCreated applies to.
        }
      }
    } with {
      briefly "Persist MoveCreated"
      described as {
        |Instructs this repository to apply MoveCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet MoveRepositoryResponses is result Move.MoveResult
    record StoredMove is {
      moveId: MoveId with {
        briefly "moveId"
        described as {
          |The moveId column of the stored move row.
        }
      }
      container: ContainerInfo with {
        briefly "container"
        described as {
          |The container column of the stored move row.
        }
      }
      railLeg: RailLeg with {
        briefly "railLeg"
        described as {
          |The railLeg column of the stored move row.
        }
      }
      status: MoveStatus with {
        briefly "status"
        described as {
          |The status column of the stored move row.
        }
      }
    } with {
      briefly "Stored move row"
      described as {
        |The persistence shape of move data as this repository stores it.
      }
    }
    schema MoveData is relational
      of moves as record StoredMove
        index on field StoredMove.moveId
        index on field StoredMove.container.containerNumber
        index on field StoredMove.railLeg.originTerminal.terminalId
        index on field StoredMove.railLeg.destinationTerminal.terminalId
        index on field StoredMove.status
 with {
      briefly "Move data schema"
      described as {
        |The relational schema holding move data for the MoveRepository.
      }
    }
    handler MovePersistence is {
      on persistAssignedToTrain: command PersistAssignedToTrain is {
        do "apply AssignedToTrain to the stored row"
      }
      on persistDestinationDrayScheduled: command PersistDestinationDrayScheduled is {
        do "apply DestinationDrayScheduled to the stored row"
      }
      on persistMoveCancelled: command PersistMoveCancelled is {
        do "apply MoveCancelled to the stored row"
      }
      on persistOriginDrayScheduled: command PersistOriginDrayScheduled is {
        do "apply OriginDrayScheduled to the stored row"
      }
      on persistTerminalIngateRecorded: command PersistTerminalIngateRecorded is {
        do "apply TerminalIngateRecorded to the stored row"
      }
      on persistTerminalOutgateRecorded: command PersistTerminalOutgateRecorded is {
        do "apply TerminalOutgateRecorded to the stored row"
      }
      on persistTrainArrivalRecorded: command PersistTrainArrivalRecorded is {
        do "apply TrainArrivalRecorded to the stored row"
      }
      on persistTrainDepartureRecorded: command PersistTrainDepartureRecorded is {
        do "apply TrainDepartureRecorded to the stored row"
      }
      on persistDeliveryRecorded: command PersistDeliveryRecorded is {
        do "apply DeliveryRecorded to the stored row"
      }
      on persistExceptionRecorded: command PersistExceptionRecorded is {
        do "apply ExceptionRecorded to the stored row"
      }
      on persistMoveCreated: command PersistMoveCreated is {
        do "apply MoveCreated to the stored row"
      }
      on query GetIntermodalStats is {
        let intermodalStatsView: type IntermodalStatsView = prompt("read the intermodal stats projection")
        reply intermodalStatsView
      }
    } with {
      briefly "Persists move commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Move data persistence"
    described as {
      | The MoveRepository provides persistent storage
      | for intermodal moves.
    }
  }
  // Projector for intermodal analytics
  query GetIntermodalStats replies result IntermodalStatsView is {
    intermodalStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which intermodal stats to retrieve.
      }
    }
  } with {
    briefly "Get intermodal stats"
    described as {
      |Retrieves the intermodal stats projection.
    }
  }
  result IntermodalStatsView is {
    intermodalStats: IntermodalAnalytics.IntermodalStats with {
      briefly "Intermodal stats"
      described as {
        |The intermodal stats being returned.
      }
    }
  } with {
    briefly "Intermodal stats view"
    described as {
      |Read model view carrying the intermodal stats projection.
    }
  }
  projector IntermodalAnalytics as flow is {
    updates repository MoveContext.MoveRepository
    outlet IntermodalAnalyticsToRepository is type MoveRepositoryCommand
    inlet IntermodalAnalyticsFromMove is type MoveEvent    record IntermodalStats is {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      movesBooked: Natural with {
        briefly "Booked"
        described as {
          |Moves booked.
        }
      }
      movesDelivered: Natural with {
        briefly "Delivered"
        described as {
          |Moves delivered.
        }
      }
      averageTransitDays: Decimal(5,2) with {
        briefly "Transit"
        described as {
          |Avg transit days.
        }
      }
      onTimePerformance: Decimal(5,2) with {
        briefly "OTP"
        described as {
          |On-time percentage.
        }
      }
      containerVolume: Natural with {
        briefly "Containers"
        described as {
          |Container count.
        }
      }
      exceptionRate: Decimal(5,2) with {
        briefly "Exceptions"
        described as {
          |Exception rate.
        }
      }
    } with {
      briefly "Intermodal statistics"
      described as {
        |Daily intermodal metrics.
      }
    }
    handler AnalyticsHandler is {
      on assignedToTrain: event Move.AssignedToTrain is {
        tell command MoveContext.MoveRepository.PersistAssignedToTrain(moveId = assignedToTrain.moveId) to repository MoveContext.MoveRepository
        do "apply AssignedToTrain to the IntermodalAnalytics projection"
      }
      on destinationDrayScheduled: event Move.DestinationDrayScheduled is {
        tell command MoveContext.MoveRepository.PersistDestinationDrayScheduled(moveId = destinationDrayScheduled.moveId) to repository MoveContext.MoveRepository
        do "apply DestinationDrayScheduled to the IntermodalAnalytics projection"
      }
      on moveCancelled: event Move.MoveCancelled is {
        tell command MoveContext.MoveRepository.PersistMoveCancelled(moveId = moveCancelled.moveId) to repository MoveContext.MoveRepository
        do "apply MoveCancelled to the IntermodalAnalytics projection"
      }
      on originDrayScheduled: event Move.OriginDrayScheduled is {
        tell command MoveContext.MoveRepository.PersistOriginDrayScheduled(moveId = originDrayScheduled.moveId) to repository MoveContext.MoveRepository
        do "apply OriginDrayScheduled to the IntermodalAnalytics projection"
      }
      on terminalIngateRecorded: event Move.TerminalIngateRecorded is {
        tell command MoveContext.MoveRepository.PersistTerminalIngateRecorded(moveId = terminalIngateRecorded.moveId) to repository MoveContext.MoveRepository
        do "apply TerminalIngateRecorded to the IntermodalAnalytics projection"
      }
      on terminalOutgateRecorded: event Move.TerminalOutgateRecorded is {
        tell command MoveContext.MoveRepository.PersistTerminalOutgateRecorded(moveId = terminalOutgateRecorded.moveId) to repository MoveContext.MoveRepository
        do "apply TerminalOutgateRecorded to the IntermodalAnalytics projection"
      }
      on trainArrivalRecorded: event Move.TrainArrivalRecorded is {
        tell command MoveContext.MoveRepository.PersistTrainArrivalRecorded(moveId = trainArrivalRecorded.moveId) to repository MoveContext.MoveRepository
        do "apply TrainArrivalRecorded to the IntermodalAnalytics projection"
      }
      on trainDepartureRecorded: event Move.TrainDepartureRecorded is {
        tell command MoveContext.MoveRepository.PersistTrainDepartureRecorded(moveId = trainDepartureRecorded.moveId) to repository MoveContext.MoveRepository
        do "apply TrainDepartureRecorded to the IntermodalAnalytics projection"
      }
      on moveCreated: event Move.MoveCreated is {
        tell command MoveContext.MoveRepository.PersistMoveCreated(moveId = moveCreated.moveId) to repository MoveContext.MoveRepository
        do "Update booking metrics"
      }
      on deliveryRecorded: event Move.DeliveryRecorded is {
        tell command MoveContext.MoveRepository.PersistDeliveryRecorded(moveId = deliveryRecorded.moveId) to repository MoveContext.MoveRepository
        do "Update delivery metrics"
      }
      on exceptionRecorded: event Move.ExceptionRecorded is {
        tell command MoveContext.MoveRepository.PersistExceptionRecorded(moveId = exceptionRecorded.moveId) to repository MoveContext.MoveRepository
        do "Update exception metrics"
      }
    } with {
      briefly "Maintains intermodal analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Intermodal analytics projections"
    described as {
      |Maintains intermodal operational analytics.
    }
  }
  // ---- Event publication for Move ----
  type MoveEvent is one of {
    MoveContext.Move.MoveCreated or MoveContext.Move.OriginDrayScheduled or MoveContext.Move.TerminalIngateRecorded or MoveContext.Move.AssignedToTrain or MoveContext.Move.TrainDepartureRecorded or MoveContext.Move.TrainArrivalRecorded or MoveContext.Move.TerminalOutgateRecorded or MoveContext.Move.DestinationDrayScheduled or MoveContext.Move.DeliveryRecorded or MoveContext.Move.ExceptionRecorded or MoveContext.Move.MoveCancelled
  } with {
    briefly "Move event alternation"
    described as {
      |Union of all Move events, for streaming and event-sourced
      |persistence.
    }
  }
  processor MoveEventSplit as flow is {
    inlet MoveEventSplitIn is type MoveEvent    outlet MoveEventSplitToIntermodalAnalytics is type MoveEvent
    handler MoveEventSplitHandler is {
      on moveCreated: event Move.MoveCreated is {
        send moveCreated to outlet MoveEventSplitToIntermodalAnalytics
        tell moveCreated to entity MoveContext.Move
      }
      on originDrayScheduled: event Move.OriginDrayScheduled is {
        send originDrayScheduled to outlet MoveEventSplitToIntermodalAnalytics
        tell originDrayScheduled to entity MoveContext.Move
      }
      on terminalIngateRecorded: event Move.TerminalIngateRecorded is {
        send terminalIngateRecorded to outlet MoveEventSplitToIntermodalAnalytics
        tell terminalIngateRecorded to entity MoveContext.Move
      }
      on assignedToTrain: event Move.AssignedToTrain is {
        send assignedToTrain to outlet MoveEventSplitToIntermodalAnalytics
        tell assignedToTrain to entity MoveContext.Move
      }
      on trainDepartureRecorded: event Move.TrainDepartureRecorded is {
        send trainDepartureRecorded to outlet MoveEventSplitToIntermodalAnalytics
        tell trainDepartureRecorded to entity MoveContext.Move
      }
      on trainArrivalRecorded: event Move.TrainArrivalRecorded is {
        send trainArrivalRecorded to outlet MoveEventSplitToIntermodalAnalytics
        tell trainArrivalRecorded to entity MoveContext.Move
      }
      on terminalOutgateRecorded: event Move.TerminalOutgateRecorded is {
        send terminalOutgateRecorded to outlet MoveEventSplitToIntermodalAnalytics
        tell terminalOutgateRecorded to entity MoveContext.Move
      }
      on destinationDrayScheduled: event Move.DestinationDrayScheduled is {
        send destinationDrayScheduled to outlet MoveEventSplitToIntermodalAnalytics
        tell destinationDrayScheduled to entity MoveContext.Move
      }
      on deliveryRecorded: event Move.DeliveryRecorded is {
        send deliveryRecorded to outlet MoveEventSplitToIntermodalAnalytics
        tell deliveryRecorded to entity MoveContext.Move
      }
      on exceptionRecorded: event Move.ExceptionRecorded is {
        send exceptionRecorded to outlet MoveEventSplitToIntermodalAnalytics
        tell exceptionRecorded to entity MoveContext.Move
      }
      on moveCancelled: event Move.MoveCancelled is {
        send moveCancelled to outlet MoveEventSplitToIntermodalAnalytics
        tell moveCancelled to entity MoveContext.Move
      }
      on other is {
        error "Unexpected message for processor MoveEventSplit"
      }
    } with {
      briefly "Move event fan-out handler"
      described as {
        |Delivers each Move event to all of its consumers.
      }
    }
  } with {
    briefly "Move event fan-out"
    described as {
      |Fans Move events out to the repository and projectors.
    }
  }
  connector 'MoveEvent Stream' is from outlet MoveContext.Move.MoveEvents2 to inlet MoveContext.MoveEventSplit.MoveEventSplitIn with {
    briefly "Move events, fanned out to storage and read models"
  }
  connector 'IntermodalAnalytics Feed' is from outlet MoveContext.MoveEventSplit.MoveEventSplitToIntermodalAnalytics to inlet MoveContext.IntermodalAnalytics.IntermodalAnalyticsFromMove with {
    briefly "Move events feeding the IntermodalAnalytics projection"
  }
  connector 'IntermodalAnalytics Storage' is from outlet MoveContext.IntermodalAnalytics.IntermodalAnalyticsToRepository to inlet MoveContext.MoveRepository.MoveRepositoryFromIntermodalAnalytics with {
    briefly "IntermodalAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for intermodal moves"
  described as {
    | The MoveContext is the bounded context for
    | intermodal transportation management.
  }
}
