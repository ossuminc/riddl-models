// Intermodal - Move Context
context MoveContext is {
  adaptor FromChassisPoolService from context ChassisPoolService is { 
    handler FromChassisPoolServiceHandler is {
      on result ChassisPoolService.ChassisAvailabilityResult is {
        do "the model receives chassis availability result"
      }
      on event ChassisPoolService.ChassisReserved is {
        do "the model receives chassis reserved"
      }
      on event ChassisPoolService.ChassisReturned is {
        do "the model receives chassis returned"
      }
      on other is {
        error "Unexpected message for adaptor FromChassisPoolService"
      }
    } with {
      briefly "from chassis pool service"
      described as {
        |Carries messages from the external ChassisPoolService.
      }
    }
  } with {
    briefly "ChassisPoolService integration"
    described as {
      |The model's side of the ChassisPoolService conversation.
    }
  }
  adaptor ToChassisPoolService to context ChassisPoolService is { 
    handler ToChassisPoolServiceHandler is {
      on query ChassisPoolService.GetChassisAvailability is {
        do "the model sends get chassis availability"
      }
      on command ChassisPoolService.ReserveChassis is {
        do "the model sends reserve chassis"
      }
      on other is {
        error "Unexpected message for adaptor ToChassisPoolService"
      }
    } with {
      briefly "to chassis pool service"
      described as {
        |Carries messages to the external ChassisPoolService.
      }
    }
  } with {
    briefly "ChassisPoolService integration"
    described as {
      |The model's side of the ChassisPoolService conversation.
    }
  }
  adaptor FromDrayCarrierService from context DrayCarrierService is { 
    handler FromDrayCarrierServiceHandler is {
      on event DrayCarrierService.DrayCompleted is {
        do "the model receives dray completed"
      }
      on event DrayCarrierService.DrayConfirmed is {
        do "the model receives dray confirmed"
      }
      on event DrayCarrierService.DrayDispatched is {
        do "the model receives dray dispatched"
      }
      on other is {
        error "Unexpected message for adaptor FromDrayCarrierService"
      }
    } with {
      briefly "from dray carrier service"
      described as {
        |Carries messages from the external DrayCarrierService.
      }
    }
  } with {
    briefly "DrayCarrierService integration"
    described as {
      |The model's side of the DrayCarrierService conversation.
    }
  }
  adaptor ToDrayCarrierService to context DrayCarrierService is { 
    handler ToDrayCarrierServiceHandler is {
      on command DrayCarrierService.RequestDray is {
        do "the model sends request dray"
      }
      on other is {
        error "Unexpected message for adaptor ToDrayCarrierService"
      }
    } with {
      briefly "to dray carrier service"
      described as {
        |Carries messages to the external DrayCarrierService.
      }
    }
  } with {
    briefly "DrayCarrierService integration"
    described as {
      |The model's side of the DrayCarrierService conversation.
    }
  }
  adaptor FromIntermodalRatingService from context IntermodalRatingService is { 
    handler FromIntermodalRatingServiceHandler is {
      on result IntermodalRatingService.RatesResult is {
        do "the model receives rates result"
      }
      on other is {
        error "Unexpected message for adaptor FromIntermodalRatingService"
      }
    } with {
      briefly "from intermodal rating service"
      described as {
        |Carries messages from the external IntermodalRatingService.
      }
    }
  } with {
    briefly "IntermodalRatingService integration"
    described as {
      |The model's side of the IntermodalRatingService conversation.
    }
  }
  adaptor ToIntermodalRatingService to context IntermodalRatingService is { 
    handler ToIntermodalRatingServiceHandler is {
      on query IntermodalRatingService.GetRates is {
        do "the model sends get rates"
      }
      on other is {
        error "Unexpected message for adaptor ToIntermodalRatingService"
      }
    } with {
      briefly "to intermodal rating service"
      described as {
        |Carries messages to the external IntermodalRatingService.
      }
    }
  } with {
    briefly "IntermodalRatingService integration"
    described as {
      |The model's side of the IntermodalRatingService conversation.
    }
  }
  adaptor FromRailCarrierService from context RailCarrierService is { 
    handler FromRailCarrierServiceHandler is {
      on result RailCarrierService.AvailabilityResult is {
        do "the model receives availability result"
      }
      on event RailCarrierService.RailBookingConfirmed is {
        do "the model receives rail booking confirmed"
      }
      on event RailCarrierService.TrainArrived is {
        do "the model receives train arrived"
      }
      on event RailCarrierService.TrainDeparted is {
        do "the model receives train departed"
      }
      on other is {
        error "Unexpected message for adaptor FromRailCarrierService"
      }
    } with {
      briefly "from rail carrier service"
      described as {
        |Carries messages from the external RailCarrierService.
      }
    }
  } with {
    briefly "RailCarrierService integration"
    described as {
      |The model's side of the RailCarrierService conversation.
    }
  }
  adaptor ToRailCarrierService to context RailCarrierService is { 
    handler ToRailCarrierServiceHandler is {
      on command RailCarrierService.BookRail is {
        do "the model sends book rail"
      }
      on query RailCarrierService.GetAvailability is {
        do "the model sends get availability"
      }
      on other is {
        error "Unexpected message for adaptor ToRailCarrierService"
      }
    } with {
      briefly "to rail carrier service"
      described as {
        |Carries messages to the external RailCarrierService.
      }
    }
  } with {
    briefly "RailCarrierService integration"
    described as {
      |The model's side of the RailCarrierService conversation.
    }
  }
  adaptor FromTerminalOperatingSystem from context TerminalOperatingSystem is { 
    handler FromTerminalOperatingSystemHandler is {
      on event TerminalOperatingSystem.ContainerIngated is {
        do "the model receives container ingated"
      }
      on event TerminalOperatingSystem.ContainerLoaded is {
        do "the model receives container loaded"
      }
      on event TerminalOperatingSystem.ContainerOutgated is {
        do "the model receives container outgated"
      }
      on event TerminalOperatingSystem.ContainerUnloaded is {
        do "the model receives container unloaded"
      }
      on other is {
        error "Unexpected message for adaptor FromTerminalOperatingSystem"
      }
    } with {
      briefly "from terminal operating system"
      described as {
        |Carries messages from the external TerminalOperatingSystem.
      }
    }
  } with {
    briefly "TerminalOperatingSystem integration"
    described as {
      |The model's side of the TerminalOperatingSystem conversation.
    }
  }
  adaptor ToTerminalOperatingSystem to context TerminalOperatingSystem is { 
    handler ToTerminalOperatingSystemHandler is {
      on command TerminalOperatingSystem.RequestIngate is {
        do "the model sends request ingate"
      }
      on other is {
        error "Unexpected message for adaptor ToTerminalOperatingSystem"
      }
    } with {
      briefly "to terminal operating system"
      described as {
        |Carries messages to the external TerminalOperatingSystem.
      }
    }
  } with {
    briefly "TerminalOperatingSystem integration"
    described as {
      |The model's side of the TerminalOperatingSystem conversation.
    }
  }
  include "types.riddl"
  include "Move.riddl"
  // Repository for move persistence
  repository MoveRepository is {
    inlet MoveRepositoryFromMove is type MoveEvent    inlet MoveRepositoryFromIntermodalAnalytics is type MoveEvent    outlet MoveRepositoryResponses is type Move.MoveResult
    record StoredMove is  {
      moveId: MoveId with {
        briefly "moveId"
        described as {
          |The moveId column of the stored move row.
        }
      }
      container: ContainerInfo with {
        briefly "container"
        described as {
          |The container column of the stored move row.
        }
      }
      railLeg: RailLeg with {
        briefly "railLeg"
        described as {
          |The railLeg column of the stored move row.
        }
      }
      status: MoveStatus with {
        briefly "status"
        described as {
          |The status column of the stored move row.
        }
      }
    } with {
      briefly "Stored move row"
      described as {
        |The persistence shape of move data as this repository stores it.
      }
    }
    schema MoveData is relational
      of moves as type StoredMove
        index on field StoredMove.moveId
        index on field StoredMove.container.containerNumber
        index on field StoredMove.railLeg.originTerminal.terminalId
        index on field StoredMove.railLeg.destinationTerminal.terminalId
        index on field StoredMove.status
 with {
      briefly "Move data schema"
      described as {
        |The relational schema holding move data for the MoveRepository.
      }
    }
    handler MovePersistence is {
      on query GetIntermodalStats is {
        do "read the intermodal stats projection"
        yield result IntermodalStatsView
      }
      on command Move.CreateMove is {
        tell event Move.MoveCreated to entity MoveContext.Move
        do "Store new move"
      }
      on command Move.ScheduleOriginDray is {
        tell event Move.OriginDrayScheduled to entity MoveContext.Move
        do "Update origin dray schedule"
      }
      on command Move.RecordTerminalIngate is {
        tell event Move.TerminalIngateRecorded to entity MoveContext.Move
        do "Store terminal ingate"
      }
      on command Move.AssignToTrain is {
        do "Store train assignment"
      }
      on command Move.RecordTrainDeparture is {
        tell event Move.TrainDepartureRecorded to entity MoveContext.Move
        do "Update to in transit"
      }
      on command Move.RecordTrainArrival is {
        tell event Move.TrainArrivalRecorded to entity MoveContext.Move
        do "Update to at destination"
      }
      on command Move.RecordTerminalOutgate is {
        tell event Move.TerminalOutgateRecorded to entity MoveContext.Move
        do "Store terminal outgate"
      }
      on command Move.ScheduleDestinationDray is {
        tell event Move.DestinationDrayScheduled to entity MoveContext.Move
        do "Update destination dray schedule"
      }
      on command Move.RecordDelivery is {
        tell event Move.DeliveryRecorded to entity MoveContext.Move
        do "Update to delivered"
      }
      on command Move.RecordException is {
        tell event Move.ExceptionRecorded to entity MoveContext.Move
        do "Store exception"
      }
      on command Move.CancelMove is {
        tell event Move.MoveCancelled to entity MoveContext.Move
        do "Update to cancelled"
      }
    } with {
      briefly "Persists move commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Move data persistence"
    described as {
      | The MoveRepository provides persistent storage
      | for intermodal moves.
    }
  }
  // Projector for intermodal analytics
  query GetIntermodalStats is  {
    intermodalStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which intermodal stats to retrieve.
      }
    }
  } with {
    briefly "Get intermodal stats"
    described as {
      |Retrieves the intermodal stats projection.
    }
  }
  result IntermodalStatsView is  {
    intermodalStats: IntermodalAnalytics.IntermodalStats with {
      briefly "Intermodal stats"
      described as {
        |The intermodal stats being returned.
      }
    }
  } with {
    briefly "Intermodal stats view"
    described as {
      |Read model view carrying the intermodal stats projection.
    }
  }
  projector IntermodalAnalytics is {
    updates repository MoveContext.MoveRepository
    inlet IntermodalAnalyticsFromMove is type MoveEvent    outlet IntermodalAnalyticsOut is type MoveEvent
    record IntermodalStats is  {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      movesBooked: Natural with {
        briefly "Booked"
        described as {
          |Moves booked.
        }
      }
      movesDelivered: Natural with {
        briefly "Delivered"
        described as {
          |Moves delivered.
        }
      }
      averageTransitDays: Decimal(5,2) with {
        briefly "Transit"
        described as {
          |Avg transit days.
        }
      }
      onTimePerformance: Decimal(5,2) with {
        briefly "OTP"
        described as {
          |On-time percentage.
        }
      }
      containerVolume: Natural with {
        briefly "Containers"
        described as {
          |Container count.
        }
      }
      exceptionRate: Decimal(5,2) with {
        briefly "Exceptions"
        described as {
          |Exception rate.
        }
      }
    } with {
      briefly "Intermodal statistics"
      described as {
        |Daily intermodal metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Move.MoveCreated is {
        tell event Move.MoveCreated to repository MoveContext.MoveRepository
        do "Update booking metrics"
      }
      on event Move.DeliveryRecorded is {
        tell event Move.DeliveryRecorded to repository MoveContext.MoveRepository
        do "Update delivery metrics"
      }
      on event Move.ExceptionRecorded is {
        tell event Move.ExceptionRecorded to repository MoveContext.MoveRepository
        do "Update exception metrics"
      }
    } with {
      briefly "Maintains intermodal analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Intermodal analytics projections"
    described as {
      |Maintains intermodal operational analytics.
    }
  }
  // ---- Event publication for Move ----
  type MoveEvent is one of {
    MoveContext.Move.MoveCreated or MoveContext.Move.OriginDrayScheduled or MoveContext.Move.TerminalIngateRecorded or MoveContext.Move.AssignedToTrain or MoveContext.Move.TrainDepartureRecorded or MoveContext.Move.TrainArrivalRecorded or MoveContext.Move.TerminalOutgateRecorded or MoveContext.Move.DestinationDrayScheduled or MoveContext.Move.DeliveryRecorded or MoveContext.Move.ExceptionRecorded or MoveContext.Move.MoveCancelled
  } with {
    briefly "Move event alternation"
    described as {
      |Union of all Move events, for streaming and event-sourced
      |persistence.
    }
  }
  processor MoveEventSource as source is {
    outlet MoveEvents is type MoveEvent
    handler MoveSourceHandler is {
      on event Move.MoveCreated is {
        send event Move.MoveCreated to outlet MoveEvents
      }
      on event Move.OriginDrayScheduled is {
        send event Move.OriginDrayScheduled to outlet MoveEvents
      }
      on event Move.TerminalIngateRecorded is {
        send event Move.TerminalIngateRecorded to outlet MoveEvents
      }
      on event Move.AssignedToTrain is {
        send event Move.AssignedToTrain to outlet MoveEvents
      }
      on event Move.TrainDepartureRecorded is {
        send event Move.TrainDepartureRecorded to outlet MoveEvents
      }
      on event Move.TrainArrivalRecorded is {
        send event Move.TrainArrivalRecorded to outlet MoveEvents
      }
      on event Move.TerminalOutgateRecorded is {
        send event Move.TerminalOutgateRecorded to outlet MoveEvents
      }
      on event Move.DestinationDrayScheduled is {
        send event Move.DestinationDrayScheduled to outlet MoveEvents
      }
      on event Move.DeliveryRecorded is {
        send event Move.DeliveryRecorded to outlet MoveEvents
      }
      on event Move.ExceptionRecorded is {
        send event Move.ExceptionRecorded to outlet MoveEvents
      }
      on event Move.MoveCancelled is {
        send event Move.MoveCancelled to outlet MoveEvents
      }
      on other is {
        error "Unexpected message for source MoveEventSource"
      }
    } with {
      briefly "Move source handler"
      described as {
        |Publishes Move events onto the outlet.
      }
    }
  } with {
    briefly "Move event source"
    described as {
      |Publishes Move entity events into the streaming topology.
    }
  }
  processor MoveEventSink as sink is {
    inlet MoveInlet is type MoveEvent    handler MoveSinkHandler is {
      on event Move.MoveCreated is {
        tell event Move.MoveCreated to repository MoveContext.MoveRepository
      }
      on event Move.OriginDrayScheduled is {
        tell event Move.OriginDrayScheduled to repository MoveContext.MoveRepository
      }
      on event Move.TerminalIngateRecorded is {
        tell event Move.TerminalIngateRecorded to repository MoveContext.MoveRepository
      }
      on event Move.AssignedToTrain is {
        tell event Move.AssignedToTrain to repository MoveContext.MoveRepository
      }
      on event Move.TrainDepartureRecorded is {
        tell event Move.TrainDepartureRecorded to repository MoveContext.MoveRepository
      }
      on event Move.TrainArrivalRecorded is {
        tell event Move.TrainArrivalRecorded to repository MoveContext.MoveRepository
      }
      on event Move.TerminalOutgateRecorded is {
        tell event Move.TerminalOutgateRecorded to repository MoveContext.MoveRepository
      }
      on event Move.DestinationDrayScheduled is {
        tell event Move.DestinationDrayScheduled to repository MoveContext.MoveRepository
      }
      on event Move.DeliveryRecorded is {
        tell event Move.DeliveryRecorded to repository MoveContext.MoveRepository
      }
      on event Move.ExceptionRecorded is {
        tell event Move.ExceptionRecorded to repository MoveContext.MoveRepository
      }
      on event Move.MoveCancelled is {
        tell event Move.MoveCancelled to repository MoveContext.MoveRepository
      }
      on other is {
        error "Unexpected message for sink MoveEventSink"
      }
    } with {
      briefly "Move sink handler"
      described as {
        |Persists Move events via the repository.
      }
    }
  } with {
    briefly "Move event sink"
    described as {
      |Receives Move events for persistence.
    }
  }
  connector MoveEventFlow is from outlet MoveContext.MoveEventSource.MoveEvents to inlet MoveContext.MoveEventSink.MoveInlet with {
    briefly "Move event flow"
    described as {
      |Connects the Move source to its sink.
    }
  }
  processor MoveEventSplit is {
    inlet MoveEventSplitIn is type MoveEvent    outlet MoveEventSplitToMoveRepository is type MoveEvent
    outlet MoveEventSplitToIntermodalAnalytics is type MoveEvent
    handler MoveEventSplitHandler is {
      on event Move.MoveCreated is {
        send event Move.MoveCreated to outlet MoveEventSplitToMoveRepository
        send event Move.MoveCreated to outlet MoveEventSplitToIntermodalAnalytics
        tell event Move.MoveCreated to entity MoveContext.Move
      }
      on event Move.OriginDrayScheduled is {
        send event Move.OriginDrayScheduled to outlet MoveEventSplitToMoveRepository
        send event Move.OriginDrayScheduled to outlet MoveEventSplitToIntermodalAnalytics
        tell event Move.OriginDrayScheduled to entity MoveContext.Move
      }
      on event Move.TerminalIngateRecorded is {
        send event Move.TerminalIngateRecorded to outlet MoveEventSplitToMoveRepository
        send event Move.TerminalIngateRecorded to outlet MoveEventSplitToIntermodalAnalytics
        tell event Move.TerminalIngateRecorded to entity MoveContext.Move
      }
      on event Move.AssignedToTrain is {
        send event Move.AssignedToTrain to outlet MoveEventSplitToMoveRepository
        send event Move.AssignedToTrain to outlet MoveEventSplitToIntermodalAnalytics
        tell event Move.AssignedToTrain to entity MoveContext.Move
      }
      on event Move.TrainDepartureRecorded is {
        send event Move.TrainDepartureRecorded to outlet MoveEventSplitToMoveRepository
        send event Move.TrainDepartureRecorded to outlet MoveEventSplitToIntermodalAnalytics
        tell event Move.TrainDepartureRecorded to entity MoveContext.Move
      }
      on event Move.TrainArrivalRecorded is {
        send event Move.TrainArrivalRecorded to outlet MoveEventSplitToMoveRepository
        send event Move.TrainArrivalRecorded to outlet MoveEventSplitToIntermodalAnalytics
        tell event Move.TrainArrivalRecorded to entity MoveContext.Move
      }
      on event Move.TerminalOutgateRecorded is {
        send event Move.TerminalOutgateRecorded to outlet MoveEventSplitToMoveRepository
        send event Move.TerminalOutgateRecorded to outlet MoveEventSplitToIntermodalAnalytics
        tell event Move.TerminalOutgateRecorded to entity MoveContext.Move
      }
      on event Move.DestinationDrayScheduled is {
        send event Move.DestinationDrayScheduled to outlet MoveEventSplitToMoveRepository
        send event Move.DestinationDrayScheduled to outlet MoveEventSplitToIntermodalAnalytics
        tell event Move.DestinationDrayScheduled to entity MoveContext.Move
      }
      on event Move.DeliveryRecorded is {
        send event Move.DeliveryRecorded to outlet MoveEventSplitToMoveRepository
        send event Move.DeliveryRecorded to outlet MoveEventSplitToIntermodalAnalytics
        tell event Move.DeliveryRecorded to entity MoveContext.Move
      }
      on event Move.ExceptionRecorded is {
        send event Move.ExceptionRecorded to outlet MoveEventSplitToMoveRepository
        send event Move.ExceptionRecorded to outlet MoveEventSplitToIntermodalAnalytics
        tell event Move.ExceptionRecorded to entity MoveContext.Move
      }
      on event Move.MoveCancelled is {
        send event Move.MoveCancelled to outlet MoveEventSplitToMoveRepository
        send event Move.MoveCancelled to outlet MoveEventSplitToIntermodalAnalytics
        tell event Move.MoveCancelled to entity MoveContext.Move
      }
      on other is {
        error "Unexpected message for processor MoveEventSplit"
      }
    } with {
      briefly "Move event fan-out handler"
      described as {
        |Delivers each Move event to all of its consumers.
      }
    }
  } with {
    briefly "Move event fan-out"
    described as {
      |Fans Move events out to the repository and projectors.
    }
  }
  connector MoveEventStream is from outlet MoveContext.Move.MoveEvents2 to inlet MoveContext.MoveEventSplit.MoveEventSplitIn with {
    briefly "Move events, fanned out to storage and read models"
  }
  connector MoveEventStorage is from outlet MoveContext.MoveEventSplit.MoveEventSplitToMoveRepository to inlet MoveContext.MoveRepository.MoveRepositoryFromMove with {
    briefly "Move events on their way to storage"
  }
  connector IntermodalAnalyticsFeed is from outlet MoveContext.MoveEventSplit.MoveEventSplitToIntermodalAnalytics to inlet MoveContext.IntermodalAnalytics.IntermodalAnalyticsFromMove with {
    briefly "Move events feeding the IntermodalAnalytics projection"
  }
  connector IntermodalAnalyticsStorage is from outlet MoveContext.IntermodalAnalytics.IntermodalAnalyticsOut to inlet MoveContext.MoveRepository.MoveRepositoryFromIntermodalAnalytics with {
    briefly "The IntermodalAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for intermodal moves"
  described as {
    | The MoveContext is the bounded context for
    | intermodal transportation management.
  }
}
