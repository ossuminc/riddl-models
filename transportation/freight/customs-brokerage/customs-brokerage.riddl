// Customs Brokerage Domain Model
// Import/export customs clearance management
domain CustomsBrokerage is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user CustomsBroker is "person managing customs clearance" with {
    briefly "Customs Broker"
    described as {
      |Licensed customs broker handling entries.
    }
  }
  user Importer is "person importing goods" with {
    briefly "Importer"
    described as {
      |Business importing merchandise.
    }
  }
  user ComplianceOfficer is "person overseeing trade compliance" with {
    briefly "Compliance Officer"
    described as {
      |Staff ensuring regulatory compliance.
    }
  }
  epic CustomsEpic is {
    user Importer wants to "to clear goods through customs" so that "merchandise can enter the country"
    case FileCustomsEntry is {
      user CustomsBroker wants to "to file a customs entry" so that "goods can be released"
      step is "Broker receives" "shipping documents" "from importer" with {
        briefly "Receive docs"
        described as {
          |Gather documentation.
        }
      }
      step take input CustomsBrokerageApp.CustomsBrokerageScreen.CreateEntryInput from user CustomsBroker with {
        briefly "Create entry"
        described as {
          |File customs entry.
        }
      }
      step is "Customs reviews" "and releases" "goods for import" with {
        briefly "Release"
        described as {
          |Obtain release.
        }
      }
    } with {
      briefly "File customs entry"
      described as {
        |Customs entry filing workflow.
      }
    }
  } with {
    briefly "Customs brokerage"
    described as {
      | Epic covering customs entries, compliance,
      | and goods release.
    }
  }
  include "EntryContext.riddl"
  include "external-contexts.riddl"
  application context CustomsBrokerageApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CustomsBrokerage are delivered.
      }
    }
    group CustomsBrokerageScreen is {
      input CreateEntryInput acquires command EntryContext.Entry.CreateEntry with {
        briefly "Create entry control"
        described as {
          |The control through which a user submits the create entry request.
        }
      }
    } with {
      briefly "Customs brokerage screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppEntryCommands is type EntryContext.Entry.EntryCommand
    inlet AppEntryRepositoryResponses is type EntryContext.Entry.EntryResult    handler CustomsBrokerageAppHandler is {
      on other is {
        error "Unexpected message for application context CustomsBrokerageApp"
      }
    } with {
      briefly "CustomsBrokerageApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CustomsBrokerageApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'EntryCommand Stream' is from outlet CustomsBrokerageApp.AppEntryCommands to inlet EntryContext.Entry.EntryCommands with {
    option persistent()
    briefly "Entry commands from the application"
  }
  connector 'EntryResult Stream' is from outlet EntryContext.EntryRepository.EntryRepositoryResponses to inlet CustomsBrokerageApp.AppEntryRepositoryResponses with {
    option persistent()
    briefly "Entry query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CustomsBrokerageApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Customs brokerage domain"
  described as {
    | The CustomsBrokerage domain handles import/export
    | customs clearance and compliance.
  }
}
