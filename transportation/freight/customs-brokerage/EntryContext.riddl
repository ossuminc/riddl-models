// Customs Brokerage - Entry Context
context EntryContext is {
  include "types.riddl"
  include "Entry.riddl"
  // Repository for entry persistence
  repository EntryRepository is {
    inlet EntryRepositoryFromEntry is type EntryEvent
    inlet EntryRepositoryFromBrokerageAnalytics is type EntryEvent
    outlet EntryRepositoryResponses is type Entry.EntryResult
    schema EntryData is relational
      of entries as type Entry
        index on field Entry.entryId
        index on field Entry.entryNumber
        index on field Entry.importer.importerId
        index on field Entry.shipment.masterBillNumber
        index on field Entry.status
      with {
      briefly "Entry data schema"
      described as {
        |The relational schema holding entry data for the EntryRepository.
      }
    }

    handler EntryPersistence is {
      on command Entry.CreateEntry is {
        tell event Entry.EntryCreated to entity EntryContext.Entry
        do "Store new entry"
      }
      on command Entry.UpdateEntry is {
        tell event Entry.EntryUpdated to entity EntryContext.Entry
        do "Update entry lines"
      }
      on command Entry.AttachDocument is {
        do "Store document reference"
      }
      on command EntryContext.Entry.SubmitEntry is {
        tell event Entry.EntrySubmitted to entity EntryContext.Entry
        do "Update to submitted"
      }
      on command Entry.RecordCBPResponse is {
        tell event Entry.CBPResponseReceived to entity EntryContext.Entry
        do "Store CBP response"
      }
      on command Entry.RequestRelease is {
        do "Store release request"
      }
      on command Entry.RecordRelease is {
        do "Update to released"
      }
      on command Entry.ProcessPayment is {
        tell event Entry.PaymentProcessed to entity EntryContext.Entry
        do "Store payment record"
      }
      on command Entry.RespondToInquiry is {
        do "Store inquiry response"
      }
      on command Entry.RecordLiquidation is {
        do "Store liquidation"
      }
      on command Entry.FileProtest is {
        do "Store protest"
      }
      on command Entry.CancelEntry is {
        tell event Entry.EntryCancelled to entity EntryContext.Entry
        do "Update to cancelled"
      }
    } with {
      briefly "Persists entry commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Entry data persistence"
    described as {
      | The EntryRepository provides persistent storage
      | for customs entries.
    }
  }
  // Projector for brokerage analytics
  projector BrokerageAnalytics is {
    inlet BrokerageAnalyticsFromEntry is type EntryEvent
    outlet BrokerageAnalyticsOut is type EntryEvent
    updates repository EntryContext.EntryRepository
    record BrokerageStats is  {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      entriesSubmitted: Natural with {
        briefly "Submitted"
        described as {
          |Entries submitted.
        }
      }
      entriesReleased: Natural with {
        briefly "Released"
        described as {
          |Entries released.
        }
      }
      entriesOnHold: Natural with {
        briefly "On hold"
        described as {
          |Entries on hold.
        }
      }
      totalDutyCollected: Decimal(14,2) with {
        briefly "Duty"
        described as {
          |Total duty.
        }
      }
      averageClearanceTime: Duration with {
        briefly "Clearance time"
        described as {
          |Avg clearance time.
        }
      }
      complianceRate: Decimal(5,2) with {
        briefly "Compliance"
        described as {
          |Compliance rate.
        }
      }
    } with {
      briefly "Brokerage statistics"
      described as {
        |Daily brokerage metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Entry.EntrySubmitted is {
        tell event Entry.EntrySubmitted to repository EntryContext.EntryRepository
        do "Update submission metrics"
      }
      on event Entry.CargoReleased is {
        tell event Entry.CargoReleased to repository EntryContext.EntryRepository
        do "Update release metrics"
      }
      on event Entry.PaymentProcessed is {
        tell event Entry.PaymentProcessed to repository EntryContext.EntryRepository
        do "Update duty metrics"
      }
      on event Entry.CBPResponseReceived is {
        tell event Entry.CBPResponseReceived to repository EntryContext.EntryRepository
        do "Update hold metrics"
      }
    } with {
      briefly "Maintains brokerage analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Brokerage analytics projections"
    described as {
      |Maintains customs clearance analytics.
    }
  }
  // ---- Event publication for Entry ----
  type EntryEvent is one of {
    EntryContext.Entry.EntryCreated,
    EntryContext.Entry.EntryUpdated,
    EntryContext.Entry.DocumentAttached,
    EntryContext.Entry.EntrySubmitted,
    EntryContext.Entry.CBPResponseReceived,
    EntryContext.Entry.ReleaseRequested,
    EntryContext.Entry.CargoReleased,
    EntryContext.Entry.PaymentProcessed,
    EntryContext.Entry.InquiryResponseSubmitted,
    EntryContext.Entry.EntryLiquidated,
    EntryContext.Entry.ProtestFiled,
    EntryContext.Entry.EntryCancelled
  } with {
    briefly "Entry event alternation"
    described as {
      |Union of all Entry events, for streaming and event-sourced
      |persistence.
    }
  }
  processor EntryEventSource as source is {
    outlet EntryEvents is type EntryEvent
    handler EntrySourceHandler is {
      on event Entry.EntryCreated is {
        send event Entry.EntryCreated to outlet EntryEvents
      }
      on event Entry.EntryUpdated is {
        send event Entry.EntryUpdated to outlet EntryEvents
      }
      on event Entry.DocumentAttached is {
        send event Entry.DocumentAttached to outlet EntryEvents
      }
      on event Entry.EntrySubmitted is {
        send event Entry.EntrySubmitted to outlet EntryEvents
      }
      on event Entry.CBPResponseReceived is {
        send event Entry.CBPResponseReceived to outlet EntryEvents
      }
      on event Entry.ReleaseRequested is {
        send event Entry.ReleaseRequested to outlet EntryEvents
      }
      on event Entry.CargoReleased is {
        send event Entry.CargoReleased to outlet EntryEvents
      }
      on event Entry.PaymentProcessed is {
        send event Entry.PaymentProcessed to outlet EntryEvents
      }
      on event Entry.InquiryResponseSubmitted is {
        send event Entry.InquiryResponseSubmitted to outlet EntryEvents
      }
      on event Entry.EntryLiquidated is {
        send event Entry.EntryLiquidated to outlet EntryEvents
      }
      on event Entry.ProtestFiled is {
        send event Entry.ProtestFiled to outlet EntryEvents
      }
      on event Entry.EntryCancelled is {
        send event Entry.EntryCancelled to outlet EntryEvents
      }
      on other is {
        error "Unexpected message for source EntryEventSource"
      }
    } with {
      briefly "Entry source handler"
      described as {
        |Publishes Entry events onto the outlet.
      }
    }
  } with {
    briefly "Entry event source"
    described as {
      |Publishes Entry entity events into the streaming topology.
    }
  }
  processor EntryEventSink as sink is {
    inlet EntryInlet is type EntryEvent
    handler EntrySinkHandler is {
      on event Entry.EntryCreated is {
        tell event Entry.EntryCreated to repository EntryContext.EntryRepository
      }
      on event Entry.EntryUpdated is {
        tell event Entry.EntryUpdated to repository EntryContext.EntryRepository
      }
      on event Entry.DocumentAttached is {
        tell event Entry.DocumentAttached to repository EntryContext.EntryRepository
      }
      on event Entry.EntrySubmitted is {
        tell event Entry.EntrySubmitted to repository EntryContext.EntryRepository
      }
      on event Entry.CBPResponseReceived is {
        tell event Entry.CBPResponseReceived to repository EntryContext.EntryRepository
      }
      on event Entry.ReleaseRequested is {
        tell event Entry.ReleaseRequested to repository EntryContext.EntryRepository
      }
      on event Entry.CargoReleased is {
        tell event Entry.CargoReleased to repository EntryContext.EntryRepository
      }
      on event Entry.PaymentProcessed is {
        tell event Entry.PaymentProcessed to repository EntryContext.EntryRepository
      }
      on event Entry.InquiryResponseSubmitted is {
        tell event Entry.InquiryResponseSubmitted to repository EntryContext.EntryRepository
      }
      on event Entry.EntryLiquidated is {
        tell event Entry.EntryLiquidated to repository EntryContext.EntryRepository
      }
      on event Entry.ProtestFiled is {
        tell event Entry.ProtestFiled to repository EntryContext.EntryRepository
      }
      on event Entry.EntryCancelled is {
        tell event Entry.EntryCancelled to repository EntryContext.EntryRepository
      }
      on other is {
        error "Unexpected message for sink EntryEventSink"
      }
    } with {
      briefly "Entry sink handler"
      described as {
        |Persists Entry events via the repository.
      }
    }
  } with {
    briefly "Entry event sink"
    described as {
      |Receives Entry events for persistence.
    }
  }
  connector EntryEventFlow is {
    from outlet EntryContext.EntryEventSource.EntryEvents to
      inlet EntryContext.EntryEventSink.EntryInlet
  } with {
    briefly "Entry event flow"
    described as {
      |Connects the Entry source to its sink.
    }
  }
  processor EntryEventSplit is {
    inlet EntryEventSplitIn is type EntryEvent
    outlet EntryEventSplitToEntryRepository is type EntryEvent
    outlet EntryEventSplitToBrokerageAnalytics is type EntryEvent
    handler EntryEventSplitHandler is {
      on event Entry.EntryCreated is {
        send event Entry.EntryCreated to outlet EntryEventSplitToEntryRepository
        send event Entry.EntryCreated to outlet EntryEventSplitToBrokerageAnalytics
        tell event Entry.EntryCreated to entity EntryContext.Entry
      }
      on event Entry.EntryUpdated is {
        send event Entry.EntryUpdated to outlet EntryEventSplitToEntryRepository
        send event Entry.EntryUpdated to outlet EntryEventSplitToBrokerageAnalytics
        tell event Entry.EntryUpdated to entity EntryContext.Entry
      }
      on event Entry.DocumentAttached is {
        send event Entry.DocumentAttached to outlet EntryEventSplitToEntryRepository
        send event Entry.DocumentAttached to outlet EntryEventSplitToBrokerageAnalytics
        tell event Entry.DocumentAttached to entity EntryContext.Entry
      }
      on event Entry.EntrySubmitted is {
        send event Entry.EntrySubmitted to outlet EntryEventSplitToEntryRepository
        send event Entry.EntrySubmitted to outlet EntryEventSplitToBrokerageAnalytics
        tell event Entry.EntrySubmitted to entity EntryContext.Entry
      }
      on event Entry.CBPResponseReceived is {
        send event Entry.CBPResponseReceived to outlet EntryEventSplitToEntryRepository
        send event Entry.CBPResponseReceived to outlet EntryEventSplitToBrokerageAnalytics
        tell event Entry.CBPResponseReceived to entity EntryContext.Entry
      }
      on event Entry.ReleaseRequested is {
        send event Entry.ReleaseRequested to outlet EntryEventSplitToEntryRepository
        send event Entry.ReleaseRequested to outlet EntryEventSplitToBrokerageAnalytics
        tell event Entry.ReleaseRequested to entity EntryContext.Entry
      }
      on event Entry.CargoReleased is {
        send event Entry.CargoReleased to outlet EntryEventSplitToEntryRepository
        send event Entry.CargoReleased to outlet EntryEventSplitToBrokerageAnalytics
        tell event Entry.CargoReleased to entity EntryContext.Entry
      }
      on event Entry.PaymentProcessed is {
        send event Entry.PaymentProcessed to outlet EntryEventSplitToEntryRepository
        send event Entry.PaymentProcessed to outlet EntryEventSplitToBrokerageAnalytics
        tell event Entry.PaymentProcessed to entity EntryContext.Entry
      }
      on event Entry.InquiryResponseSubmitted is {
        send event Entry.InquiryResponseSubmitted to outlet EntryEventSplitToEntryRepository
        send event Entry.InquiryResponseSubmitted to outlet EntryEventSplitToBrokerageAnalytics
        tell event Entry.InquiryResponseSubmitted to entity EntryContext.Entry
      }
      on event Entry.EntryLiquidated is {
        send event Entry.EntryLiquidated to outlet EntryEventSplitToEntryRepository
        send event Entry.EntryLiquidated to outlet EntryEventSplitToBrokerageAnalytics
        tell event Entry.EntryLiquidated to entity EntryContext.Entry
      }
      on event Entry.ProtestFiled is {
        send event Entry.ProtestFiled to outlet EntryEventSplitToEntryRepository
        send event Entry.ProtestFiled to outlet EntryEventSplitToBrokerageAnalytics
        tell event Entry.ProtestFiled to entity EntryContext.Entry
      }
      on event Entry.EntryCancelled is {
        send event Entry.EntryCancelled to outlet EntryEventSplitToEntryRepository
        send event Entry.EntryCancelled to outlet EntryEventSplitToBrokerageAnalytics
        tell event Entry.EntryCancelled to entity EntryContext.Entry
      }
      on other is {
        error "Unexpected message for processor EntryEventSplit"
      }
    } with {
      briefly "Entry event fan-out handler"
      described as {
        |Delivers each Entry event to all of its consumers.
      }
    }
  } with {
    briefly "Entry event fan-out"
    described as {
      |Fans Entry events out to the repository and projectors.
    }
  }
  connector LinkEntryToEntryEventSplit is {
    from outlet EntryContext.Entry.EntryEvents2 to
      inlet EntryContext.EntryEventSplit.EntryEventSplitIn
  } with {
    briefly "LinkEntryToEntryEventSplit"
  }
  connector LinkEntryEventSplitToEntryRepository is {
    from outlet EntryContext.EntryEventSplit.EntryEventSplitToEntryRepository to
      inlet EntryContext.EntryRepository.EntryRepositoryFromEntry
  } with {
    briefly "LinkEntryEventSplitToEntryRepository"
  }
  connector LinkEntryEventSplitToBrokerageAnalytics is {
    from outlet EntryContext.EntryEventSplit.EntryEventSplitToBrokerageAnalytics to
      inlet EntryContext.BrokerageAnalytics.BrokerageAnalyticsFromEntry
  } with {
    briefly "LinkEntryEventSplitToBrokerageAnalytics"
  }
  connector LinkBrokerageAnalyticsToEntryRepository is {
    from outlet EntryContext.BrokerageAnalytics.BrokerageAnalyticsOut to
      inlet EntryContext.EntryRepository.EntryRepositoryFromBrokerageAnalytics
  } with {
    briefly "LinkBrokerageAnalyticsToEntryRepository"
  }
} with {
  briefly "Bounded context for customs entries"
  described as {
    | The EntryContext is the bounded context for
    | customs entry processing.
  }
}
