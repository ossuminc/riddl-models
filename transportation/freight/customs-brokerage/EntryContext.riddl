// Customs Brokerage - Entry Context
context EntryContext as router is {
  inlet EntryCommandStreamIn is type EntryCommand
  outlet EntryCommandStreamOut is type EntryCommand
  inlet EntryResultStreamIn is type Entry.EntryResult
  outlet EntryResultStreamOut is type Entry.EntryResult
  handler EntryContextBoundary is {
    on createEntry: command Entry.CreateEntry is {
      send createEntry to outlet EntryContext.EntryCommandStreamOut
    }
    on updateEntry: command Entry.UpdateEntry is {
      send updateEntry to outlet EntryContext.EntryCommandStreamOut
    }
    on attachDocument: command Entry.AttachDocument is {
      send attachDocument to outlet EntryContext.EntryCommandStreamOut
    }
    on submitEntry: command Entry.SubmitEntry is {
      send submitEntry to outlet EntryContext.EntryCommandStreamOut
    }
    on recordCBPResponse: command Entry.RecordCBPResponse is {
      send recordCBPResponse to outlet EntryContext.EntryCommandStreamOut
    }
    on requestRelease: command Entry.RequestRelease is {
      send requestRelease to outlet EntryContext.EntryCommandStreamOut
    }
    on recordRelease: command Entry.RecordRelease is {
      send recordRelease to outlet EntryContext.EntryCommandStreamOut
    }
    on processPayment: command Entry.ProcessPayment is {
      send processPayment to outlet EntryContext.EntryCommandStreamOut
    }
    on respondToInquiry: command Entry.RespondToInquiry is {
      send respondToInquiry to outlet EntryContext.EntryCommandStreamOut
    }
    on recordLiquidation: command Entry.RecordLiquidation is {
      send recordLiquidation to outlet EntryContext.EntryCommandStreamOut
    }
    on fileProtest: command Entry.FileProtest is {
      send fileProtest to outlet EntryContext.EntryCommandStreamOut
    }
    on cancelEntry: command Entry.CancelEntry is {
      send cancelEntry to outlet EntryContext.EntryCommandStreamOut
    }
    on entryResult: result Entry.EntryResult is {
      send entryResult to outlet EntryContext.EntryResultStreamOut
    }
    on other is {
      error "Unexpected message at the EntryContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'EntryCommand Stream Intake' is from outlet EntryContext.EntryCommandStreamOut to inlet EntryContext.Entry.EntryCommands
  connector 'EntryResult Stream Egress' is from outlet EntryContext.EntryRepository.EntryRepositoryResponses to inlet EntryContext.EntryResultStreamIn
  adaptor FromCBPAceService from context CBPAceService is { 
    handler FromCBPAceServiceHandler is {
      on event CBPAceService.EntryAccepted is {
        do "the model receives entry accepted"
      }
      on event CBPAceService.EntryAcknowledged is {
        do "the model receives entry acknowledged"
      }
      on event CBPAceService.EntryRejected is {
        do "the model receives entry rejected"
      }
      on result CBPAceService.EntryStatusResult is {
        do "the model receives entry status result"
      }
      on event CBPAceService.HoldNotification is {
        do "the model receives hold notification"
      }
      on event CBPAceService.ReleaseNotification is {
        do "the model receives release notification"
      }
      on other is {
        error "Unexpected message for adaptor FromCBPAceService"
      }
    } with {
      briefly "from cbp ace service"
      described as {
        |Carries messages from the external CBPAceService.
      }
    }
  } with {
    briefly "CBPAceService integration"
    described as {
      |The model's side of the CBPAceService conversation.
    }
  }
  adaptor ToCBPAceService to context CBPAceService is { 
    handler ToCBPAceServiceHandler is {
      on query CBPAceService.GetEntryStatus is {
        do "the model sends get entry status"
      }
      on command CBPAceService.QueryEntryStatus is {
        do "the model sends query entry status"
      }
      on command CBPAceService.SubmitEntry is {
        do "the model sends submit entry"
      }
      on other is {
        error "Unexpected message for adaptor ToCBPAceService"
      }
    } with {
      briefly "to cbp ace service"
      described as {
        |Carries messages to the external CBPAceService.
      }
    }
  } with {
    briefly "CBPAceService integration"
    described as {
      |The model's side of the CBPAceService conversation.
    }
  }
  adaptor FromDocumentManagementService from context DocumentManagementService is { 
    handler FromDocumentManagementServiceHandler is {
      on result DocumentManagementService.DocumentResult is {
        do "the model receives document result"
      }
      on event DocumentManagementService.DocumentUploaded is {
        do "the model receives document uploaded"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentManagementService"
      }
    } with {
      briefly "from document management service"
      described as {
        |Carries messages from the external DocumentManagementService.
      }
    }
  } with {
    briefly "DocumentManagementService integration"
    described as {
      |The model's side of the DocumentManagementService conversation.
    }
  }
  adaptor ToDocumentManagementService to context DocumentManagementService is { 
    handler ToDocumentManagementServiceHandler is {
      on query DocumentManagementService.GetDocument is {
        do "the model sends get document"
      }
      on command DocumentManagementService.UploadDocument is {
        do "the model sends upload document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentManagementService"
      }
    } with {
      briefly "to document management service"
      described as {
        |Carries messages to the external DocumentManagementService.
      }
    }
  } with {
    briefly "DocumentManagementService integration"
    described as {
      |The model's side of the DocumentManagementService conversation.
    }
  }
  adaptor FromDutyPaymentService from context DutyPaymentService is { 
    handler FromDutyPaymentServiceHandler is {
      on event DutyPaymentService.PaymentConfirmed is {
        do "the model receives payment confirmed"
      }
      on event DutyPaymentService.PaymentFailed is {
        do "the model receives payment failed"
      }
      on event DutyPaymentService.RefundProcessed is {
        do "the model receives refund processed"
      }
      on other is {
        error "Unexpected message for adaptor FromDutyPaymentService"
      }
    } with {
      briefly "from duty payment service"
      described as {
        |Carries messages from the external DutyPaymentService.
      }
    }
  } with {
    briefly "DutyPaymentService integration"
    described as {
      |The model's side of the DutyPaymentService conversation.
    }
  }
  adaptor ToDutyPaymentService to context DutyPaymentService is { 
    handler ToDutyPaymentServiceHandler is {
      on command DutyPaymentService.RequestRefund is {
        do "the model sends request refund"
      }
      on command DutyPaymentService.SubmitPayment is {
        do "the model sends submit payment"
      }
      on other is {
        error "Unexpected message for adaptor ToDutyPaymentService"
      }
    } with {
      briefly "to duty payment service"
      described as {
        |Carries messages to the external DutyPaymentService.
      }
    }
  } with {
    briefly "DutyPaymentService integration"
    described as {
      |The model's side of the DutyPaymentService conversation.
    }
  }
  adaptor FromHTSClassificationService from context HTSClassificationService is { 
    handler FromHTSClassificationServiceHandler is {
      on result HTSClassificationService.ClassificationResult is {
        do "the model receives classification result"
      }
      on result HTSClassificationService.RulingResult is {
        do "the model receives ruling result"
      }
      on other is {
        error "Unexpected message for adaptor FromHTSClassificationService"
      }
    } with {
      briefly "from hts classification service"
      described as {
        |Carries messages from the external HTSClassificationService.
      }
    }
  } with {
    briefly "HTSClassificationService integration"
    described as {
      |The model's side of the HTSClassificationService conversation.
    }
  }
  adaptor ToHTSClassificationService to context HTSClassificationService is { 
    handler ToHTSClassificationServiceHandler is {
      on query HTSClassificationService.ClassifyProduct is {
        do "the model sends classify product"
      }
      on query HTSClassificationService.GetRuling is {
        do "the model sends get ruling"
      }
      on other is {
        error "Unexpected message for adaptor ToHTSClassificationService"
      }
    } with {
      briefly "to hts classification service"
      described as {
        |Carries messages to the external HTSClassificationService.
      }
    }
  } with {
    briefly "HTSClassificationService integration"
    described as {
      |The model's side of the HTSClassificationService conversation.
    }
  }
  adaptor FromPGAPartnerService from context PGAPartnerService is { 
    handler FromPGAPartnerServiceHandler is {
      on event PGAPartnerService.PGAHold is {
        do "the model receives pga hold"
      }
      on event PGAPartnerService.PGAMayProceed is {
        do "the model receives pga may proceed"
      }
      on event PGAPartnerService.PGAResponseReceived is {
        do "the model receives pga response received"
      }
      on other is {
        error "Unexpected message for adaptor FromPGAPartnerService"
      }
    } with {
      briefly "from pga partner service"
      described as {
        |Carries messages from the external PGAPartnerService.
      }
    }
  } with {
    briefly "PGAPartnerService integration"
    described as {
      |The model's side of the PGAPartnerService conversation.
    }
  }
  adaptor ToPGAPartnerService to context PGAPartnerService is { 
    handler ToPGAPartnerServiceHandler is {
      on command PGAPartnerService.SubmitPGAData is {
        do "the model sends submit pga data"
      }
      on other is {
        error "Unexpected message for adaptor ToPGAPartnerService"
      }
    } with {
      briefly "to pga partner service"
      described as {
        |Carries messages to the external PGAPartnerService.
      }
    }
  } with {
    briefly "PGAPartnerService integration"
    described as {
      |The model's side of the PGAPartnerService conversation.
    }
  }
  adaptor FromTradeAgreementService from context TradeAgreementService is { 
    handler FromTradeAgreementServiceHandler is {
      on result TradeAgreementService.CertificateRequirementsResult is {
        do "the model receives certificate requirements result"
      }
      on result TradeAgreementService.EligibilityResult is {
        do "the model receives eligibility result"
      }
      on other is {
        error "Unexpected message for adaptor FromTradeAgreementService"
      }
    } with {
      briefly "from trade agreement service"
      described as {
        |Carries messages from the external TradeAgreementService.
      }
    }
  } with {
    briefly "TradeAgreementService integration"
    described as {
      |The model's side of the TradeAgreementService conversation.
    }
  }
  adaptor ToTradeAgreementService to context TradeAgreementService is { 
    handler ToTradeAgreementServiceHandler is {
      on query TradeAgreementService.CheckEligibility is {
        do "the model sends check eligibility"
      }
      on query TradeAgreementService.GetCertificateRequirements is {
        do "the model sends get certificate requirements"
      }
      on other is {
        error "Unexpected message for adaptor ToTradeAgreementService"
      }
    } with {
      briefly "to trade agreement service"
      described as {
        |Carries messages to the external TradeAgreementService.
      }
    }
  } with {
    briefly "TradeAgreementService integration"
    described as {
      |The model's side of the TradeAgreementService conversation.
    }
  }
  include "types.riddl"
  include "Entry.riddl"
  // Repository for entry persistence
  repository EntryRepository as merge is {
    inlet EntryRepositoryFromEntry is type EntryEvent    inlet EntryRepositoryFromBrokerageAnalytics is type EntryEvent    outlet EntryRepositoryResponses is type Entry.EntryResult
    record StoredEntry is  {
      entryId: EntryId with {
        briefly "entryId"
        described as {
          |The entryId column of the stored entry row.
        }
      }
      importer: ImporterInfo with {
        briefly "importer"
        described as {
          |The importer column of the stored entry row.
        }
      }
      shipment: ShipmentInfo with {
        briefly "shipment"
        described as {
          |The shipment column of the stored entry row.
        }
      }
      status: EntryStatus with {
        briefly "status"
        described as {
          |The status column of the stored entry row.
        }
      }
    } with {
      briefly "Stored entry row"
      described as {
        |The persistence shape of entry data as this repository stores it.
      }
    }
    schema EntryData is relational
      of entries as type StoredEntry
        index on field StoredEntry.entryId
        index on field StoredEntry.entryNumber
        index on field StoredEntry.importer.importerId
        index on field StoredEntry.shipment.masterBillNumber
        index on field StoredEntry.status
 with {
      briefly "Entry data schema"
      described as {
        |The relational schema holding entry data for the EntryRepository.
      }
    }
    handler EntryPersistence is {
      on query GetBrokerageStats is {
        let brokerageStatsView: type BrokerageStatsView = prompt("read the brokerage stats projection")
        reply brokerageStatsView
      }
      on createEntry: command Entry.CreateEntry is {
        tell event Entry.EntryCreated(entryId = createEntry.entryId, entryType = createEntry.entryType, importer = createEntry.importer, shipment = createEntry.shipment) to entity EntryContext.Entry
        do "Store new entry"
      }
      on updateEntry: command Entry.UpdateEntry is {
        tell event Entry.EntryUpdated(entryId = updateEntry.entryId, lineItems = updateEntry.lineItems) to entity EntryContext.Entry
        do "Update entry lines"
      }
      on command Entry.AttachDocument is {
        do "Store document reference"
      }
      on command EntryContext.Entry.SubmitEntry is {
        let entrySubmitted: type Entry.EntrySubmitted = prompt("the entry submitted that results from submit entry")
        tell entrySubmitted to entity EntryContext.Entry
        do "Update to submitted"
      }
      on recordCBPResponse: command Entry.RecordCBPResponse is {
        tell event Entry.CBPResponseReceived(entryId = recordCBPResponse.entryId, response = recordCBPResponse.response) to entity EntryContext.Entry
        do "Store CBP response"
      }
      on command Entry.RequestRelease is {
        do "Store release request"
      }
      on command Entry.RecordRelease is {
        do "Update to released"
      }
      on processPayment: command Entry.ProcessPayment is {
        tell event Entry.PaymentProcessed(entryId = processPayment.entryId, payment = processPayment.payment) to entity EntryContext.Entry
        do "Store payment record"
      }
      on command Entry.RespondToInquiry is {
        do "Store inquiry response"
      }
      on command Entry.RecordLiquidation is {
        do "Store liquidation"
      }
      on command Entry.FileProtest is {
        do "Store protest"
      }
      on cancelEntry: command Entry.CancelEntry is {
        tell event Entry.EntryCancelled(entryId = cancelEntry.entryId, reason = cancelEntry.reason) to entity EntryContext.Entry
        do "Update to cancelled"
      }
    } with {
      briefly "Persists entry commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Entry data persistence"
    described as {
      | The EntryRepository provides persistent storage
      | for customs entries.
    }
  }
  // Projector for brokerage analytics
  query GetBrokerageStats is  {
    brokerageStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which brokerage stats to retrieve.
      }
    }
  } with {
    briefly "Get brokerage stats"
    described as {
      |Retrieves the brokerage stats projection.
    }
  }
  result BrokerageStatsView is  {
    brokerageStats: BrokerageAnalytics.BrokerageStats with {
      briefly "Brokerage stats"
      described as {
        |The brokerage stats being returned.
      }
    }
  } with {
    briefly "Brokerage stats view"
    described as {
      |Read model view carrying the brokerage stats projection.
    }
  }
  projector BrokerageAnalytics as flow is {
    updates repository EntryContext.EntryRepository
    inlet BrokerageAnalyticsFromEntry is type EntryEvent    outlet BrokerageAnalyticsOut is type EntryEvent
    record BrokerageStats is  {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      entriesSubmitted: Natural with {
        briefly "Submitted"
        described as {
          |Entries submitted.
        }
      }
      entriesReleased: Natural with {
        briefly "Released"
        described as {
          |Entries released.
        }
      }
      entriesOnHold: Natural with {
        briefly "On hold"
        described as {
          |Entries on hold.
        }
      }
      totalDutyCollected: Decimal(14,2) with {
        briefly "Duty"
        described as {
          |Total duty.
        }
      }
      averageClearanceTime: Duration with {
        briefly "Clearance time"
        described as {
          |Avg clearance time.
        }
      }
      complianceRate: Decimal(5,2) with {
        briefly "Compliance"
        described as {
          |Compliance rate.
        }
      }
    } with {
      briefly "Brokerage statistics"
      described as {
        |Daily brokerage metrics.
      }
    }
    handler AnalyticsHandler is {
      on entrySubmitted: event Entry.EntrySubmitted is {
        tell entrySubmitted to repository EntryContext.EntryRepository
        do "Update submission metrics"
      }
      on cargoReleased: event Entry.CargoReleased is {
        tell cargoReleased to repository EntryContext.EntryRepository
        do "Update release metrics"
      }
      on paymentProcessed: event Entry.PaymentProcessed is {
        tell paymentProcessed to repository EntryContext.EntryRepository
        do "Update duty metrics"
      }
      on cBPResponseReceived: event Entry.CBPResponseReceived is {
        tell cBPResponseReceived to repository EntryContext.EntryRepository
        do "Update hold metrics"
      }
    } with {
      briefly "Maintains brokerage analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Brokerage analytics projections"
    described as {
      |Maintains customs clearance analytics.
    }
  }
  // ---- Event publication for Entry ----
  type EntryEvent is one of {
    EntryContext.Entry.EntryCreated or EntryContext.Entry.EntryUpdated or EntryContext.Entry.DocumentAttached or EntryContext.Entry.EntrySubmitted or EntryContext.Entry.CBPResponseReceived or EntryContext.Entry.ReleaseRequested or EntryContext.Entry.CargoReleased or EntryContext.Entry.PaymentProcessed or EntryContext.Entry.InquiryResponseSubmitted or EntryContext.Entry.EntryLiquidated or EntryContext.Entry.ProtestFiled or EntryContext.Entry.EntryCancelled
  } with {
    briefly "Entry event alternation"
    described as {
      |Union of all Entry events, for streaming and event-sourced
      |persistence.
    }
  }
  processor EntryEventSource as source is {
    outlet EntryEvents is type EntryEvent
    handler EntrySourceHandler is {
      on entryCreated: event Entry.EntryCreated is {
        send entryCreated to outlet EntryEvents
      }
      on entryUpdated: event Entry.EntryUpdated is {
        send entryUpdated to outlet EntryEvents
      }
      on documentAttached: event Entry.DocumentAttached is {
        send documentAttached to outlet EntryEvents
      }
      on entrySubmitted: event Entry.EntrySubmitted is {
        send entrySubmitted to outlet EntryEvents
      }
      on cBPResponseReceived: event Entry.CBPResponseReceived is {
        send cBPResponseReceived to outlet EntryEvents
      }
      on releaseRequested: event Entry.ReleaseRequested is {
        send releaseRequested to outlet EntryEvents
      }
      on cargoReleased: event Entry.CargoReleased is {
        send cargoReleased to outlet EntryEvents
      }
      on paymentProcessed: event Entry.PaymentProcessed is {
        send paymentProcessed to outlet EntryEvents
      }
      on inquiryResponseSubmitted: event Entry.InquiryResponseSubmitted is {
        send inquiryResponseSubmitted to outlet EntryEvents
      }
      on entryLiquidated: event Entry.EntryLiquidated is {
        send entryLiquidated to outlet EntryEvents
      }
      on protestFiled: event Entry.ProtestFiled is {
        send protestFiled to outlet EntryEvents
      }
      on entryCancelled: event Entry.EntryCancelled is {
        send entryCancelled to outlet EntryEvents
      }
      on other is {
        error "Unexpected message for source EntryEventSource"
      }
    } with {
      briefly "Entry source handler"
      described as {
        |Publishes Entry events onto the outlet.
      }
    }
  } with {
    briefly "Entry event source"
    described as {
      |Publishes Entry entity events into the streaming topology.
    }
  }
  processor EntryEventSink as sink is {
    inlet EntryInlet is type EntryEvent    handler EntrySinkHandler is {
      on entryCreated: event Entry.EntryCreated is {
        tell entryCreated to repository EntryContext.EntryRepository
      }
      on entryUpdated: event Entry.EntryUpdated is {
        tell entryUpdated to repository EntryContext.EntryRepository
      }
      on documentAttached: event Entry.DocumentAttached is {
        tell documentAttached to repository EntryContext.EntryRepository
      }
      on entrySubmitted: event Entry.EntrySubmitted is {
        tell entrySubmitted to repository EntryContext.EntryRepository
      }
      on cBPResponseReceived: event Entry.CBPResponseReceived is {
        tell cBPResponseReceived to repository EntryContext.EntryRepository
      }
      on releaseRequested: event Entry.ReleaseRequested is {
        tell releaseRequested to repository EntryContext.EntryRepository
      }
      on cargoReleased: event Entry.CargoReleased is {
        tell cargoReleased to repository EntryContext.EntryRepository
      }
      on paymentProcessed: event Entry.PaymentProcessed is {
        tell paymentProcessed to repository EntryContext.EntryRepository
      }
      on inquiryResponseSubmitted: event Entry.InquiryResponseSubmitted is {
        tell inquiryResponseSubmitted to repository EntryContext.EntryRepository
      }
      on entryLiquidated: event Entry.EntryLiquidated is {
        tell entryLiquidated to repository EntryContext.EntryRepository
      }
      on protestFiled: event Entry.ProtestFiled is {
        tell protestFiled to repository EntryContext.EntryRepository
      }
      on entryCancelled: event Entry.EntryCancelled is {
        tell entryCancelled to repository EntryContext.EntryRepository
      }
      on other is {
        error "Unexpected message for sink EntryEventSink"
      }
    } with {
      briefly "Entry sink handler"
      described as {
        |Persists Entry events via the repository.
      }
    }
  } with {
    briefly "Entry event sink"
    described as {
      |Receives Entry events for persistence.
    }
  }
  connector EntryEventFlow is from outlet EntryContext.EntryEventSource.EntryEvents to inlet EntryContext.EntryEventSink.EntryInlet with {
    briefly "Entry event flow"
    described as {
      |Connects the Entry source to its sink.
    }
  }
  processor EntryEventSplit as split is {
    inlet EntryEventSplitIn is type EntryEvent    outlet EntryEventSplitToEntryRepository is type EntryEvent
    outlet EntryEventSplitToBrokerageAnalytics is type EntryEvent
    handler EntryEventSplitHandler is {
      on entryCreated: event Entry.EntryCreated is {
        send entryCreated to outlet EntryEventSplitToEntryRepository
        send entryCreated to outlet EntryEventSplitToBrokerageAnalytics
        tell entryCreated to entity EntryContext.Entry
      }
      on entryUpdated: event Entry.EntryUpdated is {
        send entryUpdated to outlet EntryEventSplitToEntryRepository
        send entryUpdated to outlet EntryEventSplitToBrokerageAnalytics
        tell entryUpdated to entity EntryContext.Entry
      }
      on documentAttached: event Entry.DocumentAttached is {
        send documentAttached to outlet EntryEventSplitToEntryRepository
        send documentAttached to outlet EntryEventSplitToBrokerageAnalytics
        tell documentAttached to entity EntryContext.Entry
      }
      on entrySubmitted: event Entry.EntrySubmitted is {
        send entrySubmitted to outlet EntryEventSplitToEntryRepository
        send entrySubmitted to outlet EntryEventSplitToBrokerageAnalytics
        tell entrySubmitted to entity EntryContext.Entry
      }
      on cBPResponseReceived: event Entry.CBPResponseReceived is {
        send cBPResponseReceived to outlet EntryEventSplitToEntryRepository
        send cBPResponseReceived to outlet EntryEventSplitToBrokerageAnalytics
        tell cBPResponseReceived to entity EntryContext.Entry
      }
      on releaseRequested: event Entry.ReleaseRequested is {
        send releaseRequested to outlet EntryEventSplitToEntryRepository
        send releaseRequested to outlet EntryEventSplitToBrokerageAnalytics
        tell releaseRequested to entity EntryContext.Entry
      }
      on cargoReleased: event Entry.CargoReleased is {
        send cargoReleased to outlet EntryEventSplitToEntryRepository
        send cargoReleased to outlet EntryEventSplitToBrokerageAnalytics
        tell cargoReleased to entity EntryContext.Entry
      }
      on paymentProcessed: event Entry.PaymentProcessed is {
        send paymentProcessed to outlet EntryEventSplitToEntryRepository
        send paymentProcessed to outlet EntryEventSplitToBrokerageAnalytics
        tell paymentProcessed to entity EntryContext.Entry
      }
      on inquiryResponseSubmitted: event Entry.InquiryResponseSubmitted is {
        send inquiryResponseSubmitted to outlet EntryEventSplitToEntryRepository
        send inquiryResponseSubmitted to outlet EntryEventSplitToBrokerageAnalytics
        tell inquiryResponseSubmitted to entity EntryContext.Entry
      }
      on entryLiquidated: event Entry.EntryLiquidated is {
        send entryLiquidated to outlet EntryEventSplitToEntryRepository
        send entryLiquidated to outlet EntryEventSplitToBrokerageAnalytics
        tell entryLiquidated to entity EntryContext.Entry
      }
      on protestFiled: event Entry.ProtestFiled is {
        send protestFiled to outlet EntryEventSplitToEntryRepository
        send protestFiled to outlet EntryEventSplitToBrokerageAnalytics
        tell protestFiled to entity EntryContext.Entry
      }
      on entryCancelled: event Entry.EntryCancelled is {
        send entryCancelled to outlet EntryEventSplitToEntryRepository
        send entryCancelled to outlet EntryEventSplitToBrokerageAnalytics
        tell entryCancelled to entity EntryContext.Entry
      }
      on other is {
        error "Unexpected message for processor EntryEventSplit"
      }
    } with {
      briefly "Entry event fan-out handler"
      described as {
        |Delivers each Entry event to all of its consumers.
      }
    }
  } with {
    briefly "Entry event fan-out"
    described as {
      |Fans Entry events out to the repository and projectors.
    }
  }
  connector 'EntryEvent Stream' is from outlet EntryContext.Entry.EntryEvents2 to inlet EntryContext.EntryEventSplit.EntryEventSplitIn with {
    briefly "Entry events, fanned out to storage and read models"
  }
  connector 'EntryEvent Storage' is from outlet EntryContext.EntryEventSplit.EntryEventSplitToEntryRepository to inlet EntryContext.EntryRepository.EntryRepositoryFromEntry with {
    briefly "Entry events on their way to storage"
  }
  connector 'BrokerageAnalytics Feed' is from outlet EntryContext.EntryEventSplit.EntryEventSplitToBrokerageAnalytics to inlet EntryContext.BrokerageAnalytics.BrokerageAnalyticsFromEntry with {
    briefly "Entry events feeding the BrokerageAnalytics projection"
  }
  connector 'BrokerageAnalytics Storage' is from outlet EntryContext.BrokerageAnalytics.BrokerageAnalyticsOut to inlet EntryContext.EntryRepository.EntryRepositoryFromBrokerageAnalytics with {
    briefly "The BrokerageAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for customs entries"
  described as {
    | The EntryContext is the bounded context for
    | customs entry processing.
  }
}
