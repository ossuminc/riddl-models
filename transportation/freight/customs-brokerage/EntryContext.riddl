// Customs Brokerage - Entry Context
context EntryContext as router is {
  inlet EntryContextFromToCBPAceService is command Entry.RecordCBPResponse with {
    briefly "What ToCBPAceService makes of the answers it gets"
  }
  connector 'ToCBPAceService Intake' is from outlet EntryContext.ToCBPAceService.ToCBPAceServiceToEntryContext to inlet EntryContext.EntryContextFromToCBPAceService with {
    briefly "Answers translated by ToCBPAceService, on their way in"
  }
  inlet EntryContextFromToDocumentManagementService is command Entry.RespondToInquiry with {
    briefly "What ToDocumentManagementService makes of the answers it gets"
  }
  connector 'ToDocumentManagementService Intake' is from outlet EntryContext.ToDocumentManagementService.ToDocumentManagementServiceToEntryContext to inlet EntryContext.EntryContextFromToDocumentManagementService with {
    briefly "Answers translated by ToDocumentManagementService, on their way in"
  }
  type ToHTSClassificationServiceCommand is one of {
    Entry.FileProtest or Entry.UpdateEntry
  } with {
    briefly "What ToHTSClassificationService turns its answers into"
  }
  inlet EntryContextFromToHTSClassificationService is type ToHTSClassificationServiceCommand with {
    briefly "What ToHTSClassificationService makes of the answers it gets"
  }
  connector 'ToHTSClassificationService Intake' is from outlet EntryContext.ToHTSClassificationService.ToHTSClassificationServiceToEntryContext to inlet EntryContext.EntryContextFromToHTSClassificationService with {
    briefly "Answers translated by ToHTSClassificationService, on their way in"
  }
  type ToTradeAgreementServiceCommand is one of {
    Entry.AttachDocument or Entry.UpdateEntry
  } with {
    briefly "What ToTradeAgreementService turns its answers into"
  }
  inlet EntryContextFromToTradeAgreementService is type ToTradeAgreementServiceCommand with {
    briefly "What ToTradeAgreementService makes of the answers it gets"
  }
  connector 'ToTradeAgreementService Intake' is from outlet EntryContext.ToTradeAgreementService.ToTradeAgreementServiceToEntryContext to inlet EntryContext.EntryContextFromToTradeAgreementService with {
    briefly "Answers translated by ToTradeAgreementService, on their way in"
  }
  type FromCBPAceServiceCommand is one of {
    Entry.RecordCBPResponse or Entry.RecordRelease
  } with {
    briefly "What FromCBPAceService turns that service's news into"
  }
  inlet EntryContextFromCBPAceService is type EntryContext.FromCBPAceServiceCommand with {
    briefly "What FromCBPAceService makes of that service's news"
  }
  connector 'FromCBPAceService Intake' is from outlet EntryContext.FromCBPAceService.FromCBPAceServiceToEntryContext to inlet EntryContext.EntryContextFromCBPAceService with {
    briefly "What FromCBPAceService makes of that news, on its way in"
  }
  inlet EntryContextFromDutyPaymentService is command Entry.ProcessPayment with {
    briefly "What FromDutyPaymentService makes of that service's news"
  }
  connector 'FromDutyPaymentService Intake' is from outlet EntryContext.FromDutyPaymentService.FromDutyPaymentServiceToEntryContext to inlet EntryContext.EntryContextFromDutyPaymentService with {
    briefly "What FromDutyPaymentService makes of that news, on its way in"
  }
  inlet EntryCommandStreamIn is type EntryCommand  outlet EntryCommandStreamOut is type EntryCommand
  inlet EntryResultStreamIn is result Entry.EntryResult  outlet EntryResultStreamOut is result Entry.EntryResult
  handler EntryContextBoundary is {
    on createEntry: command Entry.CreateEntry is {
      send createEntry to outlet EntryContext.EntryCommandStreamOut
    }
    on updateEntry: command Entry.UpdateEntry is {
      send updateEntry to outlet EntryContext.EntryCommandStreamOut
    }
    on attachDocument: command Entry.AttachDocument is {
      send attachDocument to outlet EntryContext.EntryCommandStreamOut
    }
    on submitEntry: command Entry.SubmitEntry is {
      send submitEntry to outlet EntryContext.EntryCommandStreamOut
    }
    on recordCBPResponse: command Entry.RecordCBPResponse is {
      send recordCBPResponse to outlet EntryContext.EntryCommandStreamOut
    }
    on requestRelease: command Entry.RequestRelease is {
      send requestRelease to outlet EntryContext.EntryCommandStreamOut
    }
    on recordRelease: command Entry.RecordRelease is {
      send recordRelease to outlet EntryContext.EntryCommandStreamOut
    }
    on processPayment: command Entry.ProcessPayment is {
      send processPayment to outlet EntryContext.EntryCommandStreamOut
    }
    on respondToInquiry: command Entry.RespondToInquiry is {
      send respondToInquiry to outlet EntryContext.EntryCommandStreamOut
    }
    on recordLiquidation: command Entry.RecordLiquidation is {
      send recordLiquidation to outlet EntryContext.EntryCommandStreamOut
    }
    on fileProtest: command Entry.FileProtest is {
      send fileProtest to outlet EntryContext.EntryCommandStreamOut
    }
    on cancelEntry: command Entry.CancelEntry is {
      send cancelEntry to outlet EntryContext.EntryCommandStreamOut
    }
    on entryResult: result Entry.EntryResult is {
      send entryResult to outlet EntryContext.EntryResultStreamOut
    }
    on other is {
      error "Unexpected message at the EntryContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'EntryCommand Stream Intake' is from outlet EntryContext.EntryCommandStreamOut to inlet EntryContext.Entry.EntryCommands  connector 'EntryResult Stream Egress' is from outlet EntryContext.EntryRepository.EntryRepositoryResponses to inlet EntryContext.EntryResultStreamIn  adaptor FromCBPAceService from context CBPAceService as flow is { 
    inlet FromCBPAceServiceIn is type CBPAceService.CBPAceServiceEvent    outlet FromCBPAceServiceToEntryContext is type EntryContext.FromCBPAceServiceCommand
    handler FromCBPAceServiceHandler is {
      on entryAccepted: event CBPAceService.EntryAccepted is {
        let item0: type Entry.RecordCBPResponse = prompt("translate the entryAccepted event into a RecordCBPResponse, acceptance is CBP's response to the entry, and the entry records it")
        send item0 to outlet EntryContext.FromCBPAceService.FromCBPAceServiceToEntryContext
      }
      on entryAcknowledged: event CBPAceService.EntryAcknowledged is {
        do "CBP has the entry; submitting was recorded here and the response follows"
      }
      on entryRejected: event CBPAceService.EntryRejected is {
        let item0: type Entry.RecordCBPResponse = prompt("translate the entryRejected event into a RecordCBPResponse, rejection is CBP's response to the entry, and the entry records it")
        send item0 to outlet EntryContext.FromCBPAceService.FromCBPAceServiceToEntryContext
      }
      on holdNotification: event CBPAceService.HoldNotification is {
        let item0: type Entry.RecordCBPResponse = prompt("translate the holdNotification event into a RecordCBPResponse, a hold is CBP's response to the entry, and the entry records it")
        send item0 to outlet EntryContext.FromCBPAceService.FromCBPAceServiceToEntryContext
      }
      on releaseNotification: event CBPAceService.ReleaseNotification is {
        let item0: type Entry.RecordRelease = prompt("translate the releaseNotification event into a RecordRelease, CBP releasing the goods is the release the entry records")
        send item0 to outlet EntryContext.FromCBPAceService.FromCBPAceServiceToEntryContext
      }
      on other is {
        error "Unexpected message for adaptor FromCBPAceService"
      }
    } with {
      briefly "from cbp ace service"
      described as {
        |Carries messages from the external CBPAceService.
      }
    }
  } with {
    briefly "CBPAceService integration"
    described as {
      |The model's side of the CBPAceService conversation.
    }
  }
  adaptor ToCBPAceService to context CBPAceService as router is { 
    outlet ToCBPAceServiceToEntryContext is command Entry.RecordCBPResponse
    inlet ToCBPAceServiceIn is type EntryEvent    inlet ToCBPAceServiceReplies is result CBPAceService.EntryStatusResult    outlet ToCBPAceServiceOut is type CBPAceService.CBPAceServiceCommand
    handler ToCBPAceServiceHandler is {
      on entrySubmitted: event Entry.EntrySubmitted is {
        let item0: type CBPAceService.SubmitEntry = prompt("translate the entrySubmitted event into a SubmitEntry, the submission being the entry itself")
        send item0 to outlet EntryContext.ToCBPAceService.ToCBPAceServiceOut
      }
      on releaseRequested: event Entry.ReleaseRequested is {
        let askAnswer: type CBPAceService.EntryStatusResult = ask query CBPAceService.GetEntryStatus of context CBPAceService
        do "release being pursued only against a known entry status"
        when prompt("askAnswer.status has moved since the last response recorded") then
          send command Entry.RecordCBPResponse(entryId = releaseRequested.entryId, response = prompt("a response carrying askAnswer.status and askAnswer.messages")) to outlet EntryContext.ToCBPAceService.ToCBPAceServiceToEntryContext
        end
        let item0: type CBPAceService.QueryEntryStatus = prompt("translate the releaseRequested event into a QueryEntryStatus, release being pursued only against a known entry status")
        send item0 to outlet EntryContext.ToCBPAceService.ToCBPAceServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToCBPAceService"
      }
    } with {
      briefly "to cbp ace service"
      described as {
        |Carries messages to the external CBPAceService.
      }
    }
  } with {
    briefly "CBPAceService integration"
    described as {
      |The model's side of the CBPAceService conversation.
    }
  }
  adaptor FromDocumentManagementService from context DocumentManagementService as sink is { 
    inlet FromDocumentManagementServiceIn is event DocumentManagementService.DocumentUploaded    handler FromDocumentManagementServiceHandler is {
      on documentUploaded: event DocumentManagementService.DocumentUploaded is {
        do "the document is stored; attaching it was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentManagementService"
      }
    } with {
      briefly "from document management service"
      described as {
        |Carries messages from the external DocumentManagementService.
      }
    }
  } with {
    briefly "DocumentManagementService integration"
    described as {
      |The model's side of the DocumentManagementService conversation.
    }
  }
  adaptor ToDocumentManagementService to context DocumentManagementService as router is { 
    outlet ToDocumentManagementServiceToEntryContext is command Entry.RespondToInquiry
    inlet ToDocumentManagementServiceIn is type EntryEvent    inlet ToDocumentManagementServiceReplies is result DocumentManagementService.DocumentResult    outlet ToDocumentManagementServiceOut is type DocumentManagementService.DocumentManagementServiceRequest
    handler ToDocumentManagementServiceHandler is {
      on documentAttached: event DocumentAttached is {
        let artifact: type DocumentManagementService.UploadDocument = prompt("translate the documentAttached event into an UploadDocument putting the commercial paperwork where customs can be shown it")
        send artifact to outlet EntryContext.ToDocumentManagementService.ToDocumentManagementServiceOut
      }
      on inquiryResponseSubmitted: event Entry.InquiryResponseSubmitted is {
        let askAnswer: type DocumentManagementService.DocumentResult = ask query DocumentManagementService.GetDocument of context DocumentManagementService
        do "an inquiry response needing the document CBP asked about"
        when prompt("the response went without its supporting document") then
          send command Entry.RespondToInquiry(entryId = inquiryResponseSubmitted.entryId, inquiryResponse = prompt("the response with the document attached"), supportingDocs = prompt("askAnswer.fileName")) to outlet EntryContext.ToDocumentManagementService.ToDocumentManagementServiceToEntryContext
        end
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentManagementService"
      }
    } with {
      briefly "to document management service"
      described as {
        |Carries messages to the external DocumentManagementService.
      }
    }
  } with {
    briefly "DocumentManagementService integration"
    described as {
      |The model's side of the DocumentManagementService conversation.
    }
  }
  adaptor FromDutyPaymentService from context DutyPaymentService as flow is { 
    inlet FromDutyPaymentServiceIn is type DutyPaymentService.DutyPaymentServiceEvent    outlet FromDutyPaymentServiceToEntryContext is command Entry.ProcessPayment
    handler FromDutyPaymentServiceHandler is {
      on paymentConfirmed: event DutyPaymentService.PaymentConfirmed is {
        let item0: type Entry.ProcessPayment = prompt("translate the paymentConfirmed event into a ProcessPayment, duty actually paid is what the entry records as paid")
        send item0 to outlet EntryContext.FromDutyPaymentService.FromDutyPaymentServiceToEntryContext
      }
      on paymentFailed: event DutyPaymentService.PaymentFailed is {
        do "the duty payment did not clear; the broker resubmits it"
      }
      on refundProcessed: event DutyPaymentService.RefundProcessed is {
        do "the refund has gone; liquidation was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromDutyPaymentService"
      }
    } with {
      briefly "from duty payment service"
      described as {
        |Carries messages from the external DutyPaymentService.
      }
    }
  } with {
    briefly "DutyPaymentService integration"
    described as {
      |The model's side of the DutyPaymentService conversation.
    }
  }
  adaptor ToDutyPaymentService to context DutyPaymentService as flow is { 
    inlet ToDutyPaymentServiceIn is type EntryEvent    outlet ToDutyPaymentServiceOut is type DutyPaymentService.DutyPaymentServiceCommand
    handler ToDutyPaymentServiceHandler is {
      on entrySubmitted: event Entry.EntrySubmitted is {
        let notice: type DutyPaymentService.SubmitPayment = prompt("translate the entrySubmitted event into a SubmitPayment tendering the duty the filed entry declares as owed")
        send notice to outlet EntryContext.ToDutyPaymentService.ToDutyPaymentServiceOut
      }
      on entryLiquidated: event Entry.EntryLiquidated is {
        let notice: type DutyPaymentService.RequestRefund = prompt("translate the entryLiquidated event into a RequestRefund reclaiming any duty the liquidation record shows was overpaid, liquidation being the final determination of what was owed")
        send notice to outlet EntryContext.ToDutyPaymentService.ToDutyPaymentServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToDutyPaymentService"
      }
    } with {
      briefly "to duty payment service"
      described as {
        |Carries messages to the external DutyPaymentService.
      }
    }
  } with {
    briefly "DutyPaymentService integration"
    described as {
      |The model's side of the DutyPaymentService conversation.
    }
  }
  adaptor ToHTSClassificationService to context HTSClassificationService as router is { 
    outlet ToHTSClassificationServiceToEntryContext is type ToHTSClassificationServiceCommand
    inlet ToHTSClassificationServiceIn is type EntryEvent    inlet ToHTSClassificationServiceReplies is type HTSClassificationService.HTSClassificationServiceReply    outlet ToHTSClassificationServiceOut is type HTSClassificationService.HTSClassificationServiceRequest
    handler ToHTSClassificationServiceHandler is {
      on entryCreated: event Entry.EntryCreated is {
        let askAnswer: type HTSClassificationService.ClassificationResult = ask query HTSClassificationService.ClassifyProduct of context HTSClassificationService
        do "a new entry needing each product's tariff classification"
        send command Entry.UpdateEntry(entryId = entryCreated.entryId, lineItems = prompt("the line items classified at askAnswer.htsCode with duty askAnswer.dutyRate")) to outlet EntryContext.ToHTSClassificationService.ToHTSClassificationServiceToEntryContext
      }
      on protestFiled: event Entry.ProtestFiled is {
        let askAnswer: type HTSClassificationService.RulingResult = ask query HTSClassificationService.GetRuling of context HTSClassificationService
        do "a protest needing the binding ruling it will argue from"
        when prompt("askAnswer.rulingNumber is present and the protest did not cite it") then
          send command Entry.FileProtest(entryId = protestFiled.entryId, protestReason = prompt("the protest argued from ruling askAnswer.rulingNumber"), requestedRelief = prompt("reclassification to askAnswer.htsCode")) to outlet EntryContext.ToHTSClassificationService.ToHTSClassificationServiceToEntryContext
        end
      }
      on other is {
        error "Unexpected message for adaptor ToHTSClassificationService"
      }
    } with {
      briefly "to hts classification service"
      described as {
        |Carries messages to the external HTSClassificationService.
      }
    }
  } with {
    briefly "HTSClassificationService integration"
    described as {
      |The model's side of the HTSClassificationService conversation.
    }
  }
  adaptor FromPGAPartnerService from context PGAPartnerService as sink is { 
    inlet FromPGAPartnerServiceIn is type PGAPartnerService.PGAPartnerServiceEvent    handler FromPGAPartnerServiceHandler is {
      on pGAHold: event PGAPartnerService.PGAHold is {
        do "a partner agency holds the goods; the broker responds through the agency, not the entry"
      }
      on pGAMayProceed: event PGAPartnerService.PGAMayProceed is {
        do "the partner agency has no objection; release still comes from CBP"
      }
      on pGAResponseReceived: event PGAPartnerService.PGAResponseReceived is {
        do "the agency has answered; the broker reads it"
      }
      on other is {
        error "Unexpected message for adaptor FromPGAPartnerService"
      }
    } with {
      briefly "from pga partner service"
      described as {
        |Carries messages from the external PGAPartnerService.
      }
    }
  } with {
    briefly "PGAPartnerService integration"
    described as {
      |The model's side of the PGAPartnerService conversation.
    }
  }
  adaptor ToPGAPartnerService to context PGAPartnerService as flow is { 
    inlet ToPGAPartnerServiceIn is type EntryEvent    outlet ToPGAPartnerServiceOut is command PGAPartnerService.SubmitPGAData
    handler ToPGAPartnerServiceHandler is {
      on entrySubmitted: event Entry.EntrySubmitted is {
        let item0: type PGAPartnerService.SubmitPGAData = prompt("translate the entrySubmitted event into a SubmitPGAData, the entry being what partner agencies file against")
        send item0 to outlet EntryContext.ToPGAPartnerService.ToPGAPartnerServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToPGAPartnerService"
      }
    } with {
      briefly "to pga partner service"
      described as {
        |Carries messages to the external PGAPartnerService.
      }
    }
  } with {
    briefly "PGAPartnerService integration"
    described as {
      |The model's side of the PGAPartnerService conversation.
    }
  }
  adaptor ToTradeAgreementService to context TradeAgreementService as router is { 
    outlet ToTradeAgreementServiceToEntryContext is type ToTradeAgreementServiceCommand
    inlet ToTradeAgreementServiceIn is type EntryEvent    inlet ToTradeAgreementServiceReplies is type TradeAgreementService.TradeAgreementServiceReply    outlet ToTradeAgreementServiceOut is type TradeAgreementService.TradeAgreementServiceRequest
    handler ToTradeAgreementServiceHandler is {
      on entryCreated: event Entry.EntryCreated is {
        let askAnswer: type TradeAgreementService.EligibilityResult = ask query TradeAgreementService.CheckEligibility of context TradeAgreementService
        do "a new entry needing to know which agreement it can claim"
        when prompt("askAnswer.eligible") then
          send command Entry.UpdateEntry(entryId = entryCreated.entryId, lineItems = prompt("the line items claiming askAnswer.preferentialRate under the agreement")) to outlet EntryContext.ToTradeAgreementService.ToTradeAgreementServiceToEntryContext
        end
      }
      on documentAttached: event Entry.DocumentAttached is {
        let askAnswer: type TradeAgreementService.CertificateRequirementsResult = ask query TradeAgreementService.GetCertificateRequirements of context TradeAgreementService
        do "an attached document needing the certificate rules it must satisfy"
        when prompt("the attached document lacks a field in askAnswer.requiredFields") then
          send command Entry.AttachDocument(entryId = documentAttached.entryId, document = prompt("the certificate reissued in askAnswer.certificateFormat with askAnswer.requiredFields")) to outlet EntryContext.ToTradeAgreementService.ToTradeAgreementServiceToEntryContext
        end
      }
      on other is {
        error "Unexpected message for adaptor ToTradeAgreementService"
      }
    } with {
      briefly "to trade agreement service"
      described as {
        |Carries messages to the external TradeAgreementService.
      }
    }
  } with {
    briefly "TradeAgreementService integration"
    described as {
      |The model's side of the TradeAgreementService conversation.
    }
  }
  include "types.riddl"
  include "Entry.riddl"
  // Repository for entry persistence
  type EntryRepositoryCommand is one of {
    EntryContext.EntryRepository.PersistCBPResponseReceived or EntryContext.EntryRepository.PersistCargoReleased or EntryContext.EntryRepository.PersistDocumentAttached or EntryContext.EntryRepository.PersistEntryCancelled or EntryContext.EntryRepository.PersistEntryCreated or EntryContext.EntryRepository.PersistEntryLiquidated or EntryContext.EntryRepository.PersistEntrySubmitted or EntryContext.EntryRepository.PersistEntryUpdated or EntryContext.EntryRepository.PersistInquiryResponseSubmitted or EntryContext.EntryRepository.PersistPaymentProcessed or EntryContext.EntryRepository.PersistProtestFiled or EntryContext.EntryRepository.PersistReleaseRequested
  } with {
    briefly "Anything that writes EntryRepository"
    described as {
      |The persistence commands EntryRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository EntryRepository as flow is {
    inlet EntryRepositoryFromBrokerageAnalytics is type EntryRepositoryCommand    command PersistDocumentAttached is {
      entryId: EntryId with {
        briefly "Row addressed"
        described as {
          |Which stored row DocumentAttached applies to.
        }
      }
      document: EntryDocument? with {
        briefly "Document"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      attachedAt: TimeStamp? with {
        briefly "Attached at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DocumentAttached"
      described as {
        |Instructs this repository to apply DocumentAttached to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEntryCancelled is {
      entryId: EntryId with {
        briefly "Row addressed"
        described as {
          |Which stored row EntryCancelled applies to.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist EntryCancelled"
      described as {
        |Instructs this repository to apply EntryCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEntryCreated is {
      entryId: EntryId with {
        briefly "Row addressed"
        described as {
          |Which stored row EntryCreated applies to.
        }
      }
      entryType: EntryType? with {
        briefly "Entry type"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      importer: ImporterInfo? with {
        briefly "Importer"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      shipment: ShipmentInfo? with {
        briefly "Shipment"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist EntryCreated"
      described as {
        |Instructs this repository to apply EntryCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEntryLiquidated is {
      entryId: EntryId with {
        briefly "Row addressed"
        described as {
          |Which stored row EntryLiquidated applies to.
        }
      }
      liquidation: LiquidationRecord? with {
        briefly "Liquidation"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist EntryLiquidated"
      described as {
        |Instructs this repository to apply EntryLiquidated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEntryUpdated is {
      entryId: EntryId with {
        briefly "Row addressed"
        described as {
          |Which stored row EntryUpdated applies to.
        }
      }
      lineItems: LineItem+ with {
        briefly "Line items"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist EntryUpdated"
      described as {
        |Instructs this repository to apply EntryUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInquiryResponseSubmitted is {
      entryId: EntryId with {
        briefly "Row addressed"
        described as {
          |Which stored row InquiryResponseSubmitted applies to.
        }
      }
      respondedAt: TimeStamp? with {
        briefly "Responded at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist InquiryResponseSubmitted"
      described as {
        |Instructs this repository to apply InquiryResponseSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProtestFiled is {
      entryId: EntryId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProtestFiled applies to.
        }
      }
      protestReason: String(1,2000)? with {
        briefly "Protest reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      filedAt: TimeStamp? with {
        briefly "Filed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ProtestFiled"
      described as {
        |Instructs this repository to apply ProtestFiled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReleaseRequested is {
      entryId: EntryId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReleaseRequested applies to.
        }
      }
      releaseType: String(1,50)? with {
        briefly "Release type"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      requestedAt: TimeStamp? with {
        briefly "Requested at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReleaseRequested"
      described as {
        |Instructs this repository to apply ReleaseRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCBPResponseReceived is {
      entryId: EntryId with {
        briefly "Row addressed"
        described as {
          |Which stored row CBPResponseReceived applies to.
        }
      }
      response: CBPResponse? with {
        briefly "Response"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CBPResponseReceived"
      described as {
        |Instructs this repository to apply CBPResponseReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCargoReleased is {
      entryId: EntryId with {
        briefly "Row addressed"
        described as {
          |Which stored row CargoReleased applies to.
        }
      }
      releaseDate: Date? with {
        briefly "Release date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      releaseNumber: String(1,50)? with {
        briefly "Release number"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CargoReleased"
      described as {
        |Instructs this repository to apply CargoReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEntrySubmitted is {
      entryId: EntryId with {
        briefly "Row addressed"
        described as {
          |Which stored row EntrySubmitted applies to.
        }
      }
      submittedBy: BrokerId? with {
        briefly "Submitted by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      submittedAt: TimeStamp? with {
        briefly "Submitted at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist EntrySubmitted"
      described as {
        |Instructs this repository to apply EntrySubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentProcessed is {
      entryId: EntryId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentProcessed applies to.
        }
      }
      payment: DutyPayment? with {
        briefly "Payment"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PaymentProcessed"
      described as {
        |Instructs this repository to apply PaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet EntryRepositoryResponses is result Entry.EntryResult
    record StoredEntry is {
      entryId: EntryId with {
        briefly "entryId"
        described as {
          |The entryId column of the stored entry row.
        }
      }
      importer: ImporterInfo with {
        briefly "importer"
        described as {
          |The importer column of the stored entry row.
        }
      }
      shipment: ShipmentInfo with {
        briefly "shipment"
        described as {
          |The shipment column of the stored entry row.
        }
      }
      status: EntryStatus with {
        briefly "status"
        described as {
          |The status column of the stored entry row.
        }
      }
      document: EntryDocument? with {
        briefly "Document"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      attachedAt: TimeStamp? with {
        briefly "Attached at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,500)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      cancelledAt: TimeStamp? with {
        briefly "Cancelled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      entryType: EntryType? with {
        briefly "Entry type"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      liquidation: LiquidationRecord? with {
        briefly "Liquidation"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      lineItems: LineItem+ with {
        briefly "Line items"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      respondedAt: TimeStamp? with {
        briefly "Responded at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      protestReason: String(1,2000)? with {
        briefly "Protest reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      filedAt: TimeStamp? with {
        briefly "Filed at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      releaseType: String(1,50)? with {
        briefly "Release type"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      requestedAt: TimeStamp? with {
        briefly "Requested at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      response: CBPResponse? with {
        briefly "Response"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      releaseDate: Date? with {
        briefly "Release date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      releaseNumber: String(1,50)? with {
        briefly "Release number"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      submittedBy: BrokerId? with {
        briefly "Submitted by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      submittedAt: TimeStamp? with {
        briefly "Submitted at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      payment: DutyPayment? with {
        briefly "Payment"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored entry row"
      described as {
        |The persistence shape of entry data as this repository stores it.
      }
    }
    schema EntryData is relational
      of entries as record StoredEntry
        key on field StoredEntry.entryId
        index on field StoredEntry.entryNumber
        index on field StoredEntry.importer.importerId
        index on field StoredEntry.shipment.masterBillNumber
        index on field StoredEntry.status
 with {
      briefly "Entry data schema"
      described as {
        |The relational schema holding entry data for the EntryRepository.
      }
    }
    handler EntryPersistence is {
      on persistDocumentAttached: command PersistDocumentAttached is {
        update EntryData.entries set document = persistDocumentAttached.document, attachedAt = persistDocumentAttached.attachedAt where entryId == persistDocumentAttached.entryId
      }
      on persistEntryCancelled: command PersistEntryCancelled is {
        update EntryData.entries set reason = persistEntryCancelled.reason, cancelledAt = persistEntryCancelled.cancelledAt where entryId == persistEntryCancelled.entryId
      }
      on persistEntryCreated: command PersistEntryCreated is {
        update EntryData.entries set entryType = persistEntryCreated.entryType, importer = persistEntryCreated.importer, shipment = persistEntryCreated.shipment, createdAt = persistEntryCreated.createdAt where entryId == persistEntryCreated.entryId
      }
      on persistEntryLiquidated: command PersistEntryLiquidated is {
        update EntryData.entries set liquidation = persistEntryLiquidated.liquidation where entryId == persistEntryLiquidated.entryId
      }
      on persistEntryUpdated: command PersistEntryUpdated is {
        update EntryData.entries set lineItems = persistEntryUpdated.lineItems, updatedAt = persistEntryUpdated.updatedAt where entryId == persistEntryUpdated.entryId
      }
      on persistInquiryResponseSubmitted: command PersistInquiryResponseSubmitted is {
        update EntryData.entries set respondedAt = persistInquiryResponseSubmitted.respondedAt where entryId == persistInquiryResponseSubmitted.entryId
      }
      on persistProtestFiled: command PersistProtestFiled is {
        update EntryData.entries set protestReason = persistProtestFiled.protestReason, filedAt = persistProtestFiled.filedAt where entryId == persistProtestFiled.entryId
      }
      on persistReleaseRequested: command PersistReleaseRequested is {
        update EntryData.entries set releaseType = persistReleaseRequested.releaseType, requestedAt = persistReleaseRequested.requestedAt where entryId == persistReleaseRequested.entryId
      }
      on persistCBPResponseReceived: command PersistCBPResponseReceived is {
        update EntryData.entries set response = persistCBPResponseReceived.response where entryId == persistCBPResponseReceived.entryId
      }
      on persistCargoReleased: command PersistCargoReleased is {
        update EntryData.entries set releaseDate = persistCargoReleased.releaseDate, releaseNumber = persistCargoReleased.releaseNumber where entryId == persistCargoReleased.entryId
      }
      on persistEntrySubmitted: command PersistEntrySubmitted is {
        update EntryData.entries set submittedBy = persistEntrySubmitted.submittedBy, submittedAt = persistEntrySubmitted.submittedAt where entryId == persistEntrySubmitted.entryId
      }
      on persistPaymentProcessed: command PersistPaymentProcessed is {
        update EntryData.entries set payment = persistPaymentProcessed.payment where entryId == persistPaymentProcessed.entryId
      }
      on query GetBrokerageStats is {
        let brokerageStatsView: type BrokerageStatsView = prompt("read the brokerage stats projection")
        reply brokerageStatsView
      }
    } with {
      briefly "Persists entry commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Entry data persistence"
    described as {
      | The EntryRepository provides persistent storage
      | for customs entries.
    }
  }
  // Projector for brokerage analytics
  query GetBrokerageStats replies result BrokerageStatsView is {
    brokerageStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which brokerage stats to retrieve.
      }
    }
  } with {
    briefly "Get brokerage stats"
    described as {
      |Retrieves the brokerage stats projection.
    }
  }
  result BrokerageStatsView is {
    brokerageStats: BrokerageAnalytics.BrokerageStats with {
      briefly "Brokerage stats"
      described as {
        |The brokerage stats being returned.
      }
    }
  } with {
    briefly "Brokerage stats view"
    described as {
      |Read model view carrying the brokerage stats projection.
    }
  }
  projector BrokerageAnalytics as flow is {
    updates repository EntryContext.EntryRepository
    outlet BrokerageAnalyticsToRepository is type EntryRepositoryCommand
    inlet BrokerageAnalyticsFromEntry is type EntryEvent    record BrokerageStats is {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      entriesSubmitted: Natural with {
        briefly "Submitted"
        described as {
          |Entries submitted.
        }
      }
      entriesReleased: Natural with {
        briefly "Released"
        described as {
          |Entries released.
        }
      }
      entriesOnHold: Natural with {
        briefly "On hold"
        described as {
          |Entries on hold.
        }
      }
      totalDutyCollected: Decimal(14,2) with {
        briefly "Duty"
        described as {
          |Total duty.
        }
      }
      averageClearanceTime: Duration with {
        briefly "Clearance time"
        described as {
          |Avg clearance time.
        }
      }
      complianceRate: Decimal(5,2) with {
        briefly "Compliance"
        described as {
          |Compliance rate.
        }
      }
    } with {
      briefly "Brokerage statistics"
      described as {
        |Daily brokerage metrics.
      }
    }
    handler AnalyticsHandler is {
      on documentAttached: event Entry.DocumentAttached is {
        tell command EntryContext.EntryRepository.PersistDocumentAttached(entryId = documentAttached.entryId, document = documentAttached.document, attachedAt = documentAttached.attachedAt) to repository EntryContext.EntryRepository
        do "apply DocumentAttached to the BrokerageAnalytics projection"
      }
      on entryCancelled: event Entry.EntryCancelled is {
        tell command EntryContext.EntryRepository.PersistEntryCancelled(entryId = entryCancelled.entryId, reason = entryCancelled.reason, cancelledAt = entryCancelled.cancelledAt) to repository EntryContext.EntryRepository
        do "apply EntryCancelled to the BrokerageAnalytics projection"
      }
      on entryCreated: event Entry.EntryCreated is {
        tell command EntryContext.EntryRepository.PersistEntryCreated(entryId = entryCreated.entryId, entryType = entryCreated.entryType, importer = entryCreated.importer, shipment = entryCreated.shipment, createdAt = entryCreated.createdAt) to repository EntryContext.EntryRepository
        do "apply EntryCreated to the BrokerageAnalytics projection"
      }
      on entryLiquidated: event Entry.EntryLiquidated is {
        tell command EntryContext.EntryRepository.PersistEntryLiquidated(entryId = entryLiquidated.entryId, liquidation = entryLiquidated.liquidation) to repository EntryContext.EntryRepository
        do "apply EntryLiquidated to the BrokerageAnalytics projection"
      }
      on entryUpdated: event Entry.EntryUpdated is {
        tell command EntryContext.EntryRepository.PersistEntryUpdated(entryId = entryUpdated.entryId, lineItems = entryUpdated.lineItems, updatedAt = entryUpdated.updatedAt) to repository EntryContext.EntryRepository
        do "apply EntryUpdated to the BrokerageAnalytics projection"
      }
      on inquiryResponseSubmitted: event Entry.InquiryResponseSubmitted is {
        tell command EntryContext.EntryRepository.PersistInquiryResponseSubmitted(entryId = inquiryResponseSubmitted.entryId, respondedAt = inquiryResponseSubmitted.respondedAt) to repository EntryContext.EntryRepository
        do "apply InquiryResponseSubmitted to the BrokerageAnalytics projection"
      }
      on protestFiled: event Entry.ProtestFiled is {
        tell command EntryContext.EntryRepository.PersistProtestFiled(entryId = protestFiled.entryId, protestReason = protestFiled.protestReason, filedAt = protestFiled.filedAt) to repository EntryContext.EntryRepository
        do "apply ProtestFiled to the BrokerageAnalytics projection"
      }
      on releaseRequested: event Entry.ReleaseRequested is {
        tell command EntryContext.EntryRepository.PersistReleaseRequested(entryId = releaseRequested.entryId, releaseType = releaseRequested.releaseType, requestedAt = releaseRequested.requestedAt) to repository EntryContext.EntryRepository
        do "apply ReleaseRequested to the BrokerageAnalytics projection"
      }
      on entrySubmitted: event Entry.EntrySubmitted is {
        tell command EntryContext.EntryRepository.PersistEntrySubmitted(entryId = entrySubmitted.entryId, submittedBy = entrySubmitted.submittedBy, submittedAt = entrySubmitted.submittedAt) to repository EntryContext.EntryRepository
        do "Update submission metrics"
      }
      on cargoReleased: event Entry.CargoReleased is {
        tell command EntryContext.EntryRepository.PersistCargoReleased(entryId = cargoReleased.entryId, releaseDate = cargoReleased.releaseDate, releaseNumber = cargoReleased.releaseNumber) to repository EntryContext.EntryRepository
        do "Update release metrics"
      }
      on paymentProcessed: event Entry.PaymentProcessed is {
        tell command EntryContext.EntryRepository.PersistPaymentProcessed(entryId = paymentProcessed.entryId, payment = paymentProcessed.payment) to repository EntryContext.EntryRepository
        do "Update duty metrics"
      }
      on cBPResponseReceived: event Entry.CBPResponseReceived is {
        tell command EntryContext.EntryRepository.PersistCBPResponseReceived(entryId = cBPResponseReceived.entryId, response = cBPResponseReceived.response) to repository EntryContext.EntryRepository
        do "Update hold metrics"
      }
    } with {
      briefly "Maintains brokerage analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Brokerage analytics projections"
    described as {
      |Maintains customs clearance analytics.
    }
  }
  // ---- Event publication for Entry ----
  type EntryEvent is one of {
    EntryContext.Entry.EntryCreated or EntryContext.Entry.EntryUpdated or EntryContext.Entry.DocumentAttached or EntryContext.Entry.EntrySubmitted or EntryContext.Entry.CBPResponseReceived or EntryContext.Entry.ReleaseRequested or EntryContext.Entry.CargoReleased or EntryContext.Entry.PaymentProcessed or EntryContext.Entry.InquiryResponseSubmitted or EntryContext.Entry.EntryLiquidated or EntryContext.Entry.ProtestFiled or EntryContext.Entry.EntryCancelled
  } with {
    briefly "Entry event alternation"
    described as {
      |Union of all Entry events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet EntryEventSplit as split is {
    outlet EntryEventSplitToToTradeAgreementService is type EntryEvent
    outlet EntryEventSplitToToPGAPartnerService is type EntryEvent
    outlet EntryEventSplitToToHTSClassificationService is type EntryEvent
    outlet EntryEventSplitToToDutyPaymentService is type EntryEvent
    outlet EntryEventSplitToToDocumentManagementService is type EntryEvent
    outlet EntryEventSplitToToCBPAceService is type EntryEvent
    inlet EntryEventSplitIn is type EntryEvent    outlet EntryEventSplitToBrokerageAnalytics is type EntryEvent
    handler EntryEventSplitHandler is {
      on entryCreated: event Entry.EntryCreated is {
        send entryCreated to outlet EntryEventSplitToBrokerageAnalytics
        send entryCreated to outlet EntryEventSplitToToTradeAgreementService
        send entryCreated to outlet EntryEventSplitToToHTSClassificationService
        tell entryCreated to entity EntryContext.Entry
      }
      on entryUpdated: event Entry.EntryUpdated is {
        send entryUpdated to outlet EntryEventSplitToBrokerageAnalytics
        tell entryUpdated to entity EntryContext.Entry
      }
      on documentAttached: event Entry.DocumentAttached is {
        send documentAttached to outlet EntryEventSplitToBrokerageAnalytics
        send documentAttached to outlet EntryEventSplitToToTradeAgreementService
        send documentAttached to outlet EntryEventSplitToToDocumentManagementService
        tell documentAttached to entity EntryContext.Entry
      }
      on entrySubmitted: event Entry.EntrySubmitted is {
        send entrySubmitted to outlet EntryEventSplitToBrokerageAnalytics
        send entrySubmitted to outlet EntryEventSplitToToPGAPartnerService
        send entrySubmitted to outlet EntryEventSplitToToDutyPaymentService
        send entrySubmitted to outlet EntryEventSplitToToCBPAceService
        tell entrySubmitted to entity EntryContext.Entry
      }
      on cBPResponseReceived: event Entry.CBPResponseReceived is {
        send cBPResponseReceived to outlet EntryEventSplitToBrokerageAnalytics
        tell cBPResponseReceived to entity EntryContext.Entry
      }
      on releaseRequested: event Entry.ReleaseRequested is {
        send releaseRequested to outlet EntryEventSplitToBrokerageAnalytics
        send releaseRequested to outlet EntryEventSplitToToCBPAceService
        tell releaseRequested to entity EntryContext.Entry
      }
      on cargoReleased: event Entry.CargoReleased is {
        send cargoReleased to outlet EntryEventSplitToBrokerageAnalytics
        tell cargoReleased to entity EntryContext.Entry
      }
      on paymentProcessed: event Entry.PaymentProcessed is {
        send paymentProcessed to outlet EntryEventSplitToBrokerageAnalytics
        tell paymentProcessed to entity EntryContext.Entry
      }
      on inquiryResponseSubmitted: event Entry.InquiryResponseSubmitted is {
        send inquiryResponseSubmitted to outlet EntryEventSplitToBrokerageAnalytics
        send inquiryResponseSubmitted to outlet EntryEventSplitToToDocumentManagementService
        tell inquiryResponseSubmitted to entity EntryContext.Entry
      }
      on entryLiquidated: event Entry.EntryLiquidated is {
        send entryLiquidated to outlet EntryEventSplitToBrokerageAnalytics
        send entryLiquidated to outlet EntryEventSplitToToDutyPaymentService
        tell entryLiquidated to entity EntryContext.Entry
      }
      on protestFiled: event Entry.ProtestFiled is {
        send protestFiled to outlet EntryEventSplitToBrokerageAnalytics
        send protestFiled to outlet EntryEventSplitToToHTSClassificationService
        tell protestFiled to entity EntryContext.Entry
      }
      on entryCancelled: event Entry.EntryCancelled is {
        send entryCancelled to outlet EntryEventSplitToBrokerageAnalytics
        tell entryCancelled to entity EntryContext.Entry
      }
      on other is {
        error "Unexpected message for processor EntryEventSplit"
      }
    } with {
      briefly "Entry event fan-out handler"
      described as {
        |Delivers each Entry event to all of its consumers.
      }
    }
  } with {
    briefly "Entry event fan-out"
    described as {
      |Fans Entry events out to the repository and projectors.
    }
  }
  connector 'ToTradeAgreementService Feed' is from outlet EntryContext.EntryEventSplit.EntryEventSplitToToTradeAgreementService to inlet EntryContext.ToTradeAgreementService.ToTradeAgreementServiceIn with {
    briefly "The Entry events ToTradeAgreementService translates, on their way to it"
  }
  connector 'ToPGAPartnerService Feed' is from outlet EntryContext.EntryEventSplit.EntryEventSplitToToPGAPartnerService to inlet EntryContext.ToPGAPartnerService.ToPGAPartnerServiceIn with {
    briefly "The Entry events ToPGAPartnerService translates, on their way to it"
  }
  connector 'ToHTSClassificationService Feed' is from outlet EntryContext.EntryEventSplit.EntryEventSplitToToHTSClassificationService to inlet EntryContext.ToHTSClassificationService.ToHTSClassificationServiceIn with {
    briefly "The Entry events ToHTSClassificationService translates, on their way to it"
  }
  connector 'ToDutyPaymentService Feed' is from outlet EntryContext.EntryEventSplit.EntryEventSplitToToDutyPaymentService to inlet EntryContext.ToDutyPaymentService.ToDutyPaymentServiceIn with {
    briefly "The Entry events ToDutyPaymentService translates, on their way to it"
  }
  connector 'ToDocumentManagementService Feed' is from outlet EntryContext.EntryEventSplit.EntryEventSplitToToDocumentManagementService to inlet EntryContext.ToDocumentManagementService.ToDocumentManagementServiceIn with {
    briefly "The Entry events ToDocumentManagementService translates, on their way to it"
  }
  connector 'ToCBPAceService Feed' is from outlet EntryContext.EntryEventSplit.EntryEventSplitToToCBPAceService to inlet EntryContext.ToCBPAceService.ToCBPAceServiceIn with {
    briefly "The Entry events ToCBPAceService translates, on their way to it"
  }
  connector 'EntryEvent Stream' is from outlet EntryContext.Entry.EntryEvents2 to inlet EntryContext.EntryEventSplit.EntryEventSplitIn with {
    briefly "Entry events, fanned out to storage and read models"
  }
  connector 'BrokerageAnalytics Feed' is from outlet EntryContext.EntryEventSplit.EntryEventSplitToBrokerageAnalytics to inlet EntryContext.BrokerageAnalytics.BrokerageAnalyticsFromEntry with {
    briefly "Entry events feeding the BrokerageAnalytics projection"
  }
  connector 'BrokerageAnalytics Storage' is from outlet EntryContext.BrokerageAnalytics.BrokerageAnalyticsToRepository to inlet EntryContext.EntryRepository.EntryRepositoryFromBrokerageAnalytics with {
    briefly "BrokerageAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for customs entries"
  described as {
    | The EntryContext is the bounded context for
    | customs entry processing.
  }
}
