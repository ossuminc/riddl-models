// Ride Sharing Domain Model
// On-demand transportation and ride matching
domain RideSharing is {
  persistent connector 'RoutingServiceReply Stream' is from outlet RoutingService.RoutingServiceRepliesOut to inlet RideContext.ToRoutingService.ToRoutingServiceReplies with {
    briefly "What RoutingService answers RideContext"
  }
  persistent connector 'FareCalculationServiceReply Stream' is from outlet FareCalculationService.FareCalculationServiceRepliesOut to inlet RideContext.ToFareCalculationService.ToFareCalculationServiceReplies with {
    briefly "What FareCalculationService answers RideContext"
  }
  persistent connector 'DriverMatchingServiceReply Stream' is from outlet DriverMatchingService.DriverMatchingServiceRepliesOut to inlet RideContext.ToDriverMatchingService.ToDriverMatchingServiceReplies with {
    briefly "What DriverMatchingService answers RideContext"
  }
  persistent connector 'DriverMatchingServiceEvent Stream' is from outlet DriverMatchingService.DriverMatchingServiceEventsOut to inlet RideContext.FromDriverMatchingService.FromDriverMatchingServiceIn with {
    briefly "What DriverMatchingService tells RideContext, unasked"
  }
  persistent connector 'PaymentServiceEvent Stream' is from outlet PaymentService.PaymentServiceEventsOut to inlet RideContext.FromPaymentService.FromPaymentServiceIn with {
    briefly "What PaymentService tells RideContext, unasked"
  }
  persistent connector 'SafetyServiceEvent Stream' is from outlet SafetyService.SafetyServiceEventsOut to inlet RideContext.FromSafetyService.FromSafetyServiceIn with {
    briefly "What SafetyService tells RideContext, unasked"
  }
  persistent connector 'RoutingServiceRequest Stream' is from outlet RideContext.ToRoutingService.ToRoutingServiceOut to inlet RoutingService.RoutingServiceRequests with {
    briefly "What RideContext asks RoutingService to send"
  }
  persistent connector 'DriverMatchingServiceRequest Stream' is from outlet RideContext.ToDriverMatchingService.ToDriverMatchingServiceOut to inlet DriverMatchingService.DriverMatchingServiceRequests with {
    briefly "What RideContext asks DriverMatchingService to send"
  }
  persistent connector 'SafetyServiceRequest Stream' is from outlet RideContext.ToSafetyService.ToSafetyServiceOut to inlet SafetyService.SafetyServiceRequests with {
    briefly "What RideContext asks SafetyService to send"
  }
  persistent connector 'FareCalculationServiceRequest Stream' is from outlet RideContext.ToFareCalculationService.ToFareCalculationServiceOut to inlet FareCalculationService.FareCalculationServiceRequests with {
    briefly "What RideContext asks FareCalculationService to send"
  }
  persistent connector 'PaymentServiceRequest Stream' is from outlet RideContext.ToPaymentService.ToPaymentServiceOut to inlet PaymentService.PaymentServiceRequests with {
    briefly "What RideContext asks PaymentService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet RideContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What RideContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Rider is "person requesting rides" with {
    briefly "Rider"
    described as {
      |Person booking transportation.
    }
  }
  user Driver is "person providing rides" with {
    briefly "Driver"
    described as {
      |Person driving for the service.
    }
  }
  user OperationsManager is "person managing ride operations" with {
    briefly "Operations Manager"
    described as {
      |Person overseeing ride service.
    }
  }
  epic RideEpic is {
    user Rider wants to "to get transportation on demand" so that "they can travel conveniently"
    case RequestRideUseCase is {
      user Rider wants to "to request a ride" so that "they are picked up at their location"
      step is "Rider enters" "pickup and destination" "locations" with {
        briefly "Enter locations"
        described as {
          |Set pickup/dropoff.
        }
      }
      step is "System calculates" "fare estimate" "and ETA" with {
        briefly "Calculate fare"
        described as {
          |Show price and time.
        }
      }
      step take input RideSharingApp.RideSharingScreen.RequestRideInput from user Rider with {
        briefly "Request ride"
        described as {
          |Submit ride request.
        }
      }
      step is "System matches" "available driver" "and dispatches" with {
        briefly "Match driver"
        described as {
          |Find and assign driver.
        }
      }
    } with {
      briefly "Ride request"
      described as {
        |Requesting on-demand transportation.
      }
    }
  } with {
    briefly "Ride management"
    described as {
      | Epic covering ride requests, driver matching,
      | trip tracking, and payment processing.
    }
  }
  include "RideContext.riddl"
  include "external-contexts.riddl"
  application context RideSharingApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in RideSharing are delivered.
      }
    }
    group RideSharingScreen is {
      input GetRideStatsInput acquires query RideContext.GetRideStats with {
        briefly "Get ride stats control"
        described as {
          |The control through which a user asks the get ride stats question.
        }
      }
      input GetRideInput acquires query RideContext.Ride.GetRide with {
        briefly "Get ride control"
        described as {
          |The control through which a user asks the get ride question.
        }
      }
      input CancelRideInput acquires command RideContext.Ride.CancelRide with {
        briefly "Cancel ride control"
        described as {
          |The control through which a user submits the cancel ride request.
        }
      }
      input CompleteTripInput acquires command RideContext.Ride.CompleteTrip with {
        briefly "Complete trip control"
        described as {
          |The control through which a user submits the complete trip request.
        }
      }
      input DriverArrivedInput acquires command RideContext.Ride.DriverArrived with {
        briefly "Driver arrived control"
        described as {
          |The control through which a user submits the driver arrived request.
        }
      }
      input RateRideInput acquires command RideContext.Ride.RateRide with {
        briefly "Rate ride control"
        described as {
          |The control through which a user submits the rate ride request.
        }
      }
      input ReportRideIncidentInput acquires command RideContext.Ride.ReportRideIncident with {
        briefly "Report ride incident control"
        described as {
          |The control through which a user submits the report ride incident request.
        }
      }
      input StartTripInput acquires command RideContext.Ride.StartTrip with {
        briefly "Start trip control"
        described as {
          |The control through which a user submits the start trip request.
        }
      }
      input RequestRideInput acquires command RideContext.RequestRide with {
        briefly "Request ride control"
        described as {
          |The control through which a user submits the request ride request.
        }
      }
    } with {
      briefly "Ride sharing screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppRideRepositoryQueries is query RideContext.GetRideStats
    inlet AppRideRepositoryReplies is result RideContext.RideStatsView
    outlet AppRideQueries is query RideContext.Ride.GetRide
    outlet AppRideCommands is type RideContext.RideRequest
    inlet AppRideRepositoryResponses is result RideContext.Ride.RideResult
    handler RideSharingAppHandler is {
      on other is {
        error "Unexpected message for application context RideSharingApp"
      }
    } with {
      briefly "RideSharingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "RideSharingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'RideRepositoryQuery Stream' is from outlet RideSharingApp.AppRideRepositoryQueries to inlet RideContext.RideRepositoryQueriesIn with {
    briefly "RideSharingApp's look-ups of the ride repository"
  }
  persistent connector 'RideRepositoryReply Stream' is from outlet RideContext.RideRepositoryRepliesOut to inlet RideSharingApp.AppRideRepositoryReplies with {
    briefly "The ride repository's answers returned to RideSharingApp"
  }
  persistent connector 'RideQuery Stream' is from outlet RideSharingApp.AppRideQueries to inlet RideContext.RideQueriesIn with {
    briefly "RideSharingApp's look-ups of the ride"
  }
  persistent connector 'RideCommand Stream' is from outlet RideSharingApp.AppRideCommands to inlet RideContext.RideCommandStreamIn with {
    briefly "Ride commands from the application"
  }
  persistent connector 'RideResult Stream' is from outlet RideContext.RideResultStreamOut to inlet RideSharingApp.AppRideRepositoryResponses with {
    briefly "Ride query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet RideSharingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term FareEstimate is "The estimated fare quoted to a rider before a trip."
  briefly "Ride sharing domain"
  described as {
    | The RideSharing domain handles on-demand
    | transportation and ride matching.
  }
}
