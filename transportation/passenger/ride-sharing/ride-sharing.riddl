// Ride Sharing Domain Model
// On-demand transportation and ride matching
domain RideSharing is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Rider is "person requesting rides" with {
    briefly "Rider"
    described as {
      |Person booking transportation.
    }
  }
  user Driver is "person providing rides" with {
    briefly "Driver"
    described as {
      |Person driving for the service.
    }
  }
  user OperationsManager is "person managing ride operations" with {
    briefly "Operations Manager"
    described as {
      |Person overseeing ride service.
    }
  }
  epic RideEpic is {
    user Rider wants to "to get transportation on demand" so that "they can travel conveniently"
    case RequestRideUseCase is {
      user Rider wants to "to request a ride" so that "they are picked up at their location"
      step is "Rider enters" "pickup and destination" "locations" with {
        briefly "Enter locations"
        described as {
          |Set pickup/dropoff.
        }
      }
      step is "System calculates" "fare estimate" "and ETA" with {
        briefly "Calculate fare"
        described as {
          |Show price and time.
        }
      }
      step take input RideSharingApp.RideSharingScreen.RequestRideInput from user Rider with {
        briefly "Request ride"
        described as {
          |Submit ride request.
        }
      }
      step is "System matches" "available driver" "and dispatches" with {
        briefly "Match driver"
        described as {
          |Find and assign driver.
        }
      }
    } with {
      briefly "Ride request"
      described as {
        |Requesting on-demand transportation.
      }
    }
  } with {
    briefly "Ride management"
    described as {
      | Epic covering ride requests, driver matching,
      | trip tracking, and payment processing.
    }
  }
  include "RideContext.riddl"
  include "external-contexts.riddl"
  application context RideSharingApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in RideSharing are delivered.
      }
    }
    group RideSharingScreen is {
      input RequestRideInput acquires command RideContext.Ride.RequestRide with {
        briefly "Request ride control"
        described as {
          |The control through which a user submits the request ride request.
        }
      }
    } with {
      briefly "Ride sharing screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppRideCommands is type RideContext.Ride.RideCommand
    inlet AppRideRepositoryResponses is type RideContext.Ride.RideResult    handler RideSharingAppHandler is {
      on other is {
        error "Unexpected message for application context RideSharingApp"
      }
    } with {
      briefly "RideSharingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "RideSharingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'RideCommand Stream' is from outlet RideSharingApp.AppRideCommands to inlet RideContext.Ride.RideCommands with {
    briefly "Ride commands from the application"
  }
  persistent connector 'RideResult Stream' is from outlet RideContext.RideRepository.RideRepositoryResponses to inlet RideSharingApp.AppRideRepositoryResponses with {
    briefly "Ride query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet RideSharingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term FareEstimate is  "The estimated fare quoted to a rider before a trip." 
  briefly "Ride sharing domain"
  described as {
    | The RideSharing domain handles on-demand
    | transportation and ride matching.
  }
}
