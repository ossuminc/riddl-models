// Ride Sharing - Ride Context
context RideContext as router is {
  inlet RideCommandStreamIn is type RideCommand  outlet RideCommandStreamOut is type RideCommand
  inlet RideResultStreamIn is result Ride.RideResult  outlet RideResultStreamOut is result Ride.RideResult
  handler RideContextBoundary is {
    on requestRide: command Ride.RequestRide is {
      send requestRide to outlet RideContext.RideCommandStreamOut
    }
    on assignDriver: command Ride.AssignDriver is {
      send assignDriver to outlet RideContext.RideCommandStreamOut
    }
    on driverEnRoute: command Ride.DriverEnRoute is {
      send driverEnRoute to outlet RideContext.RideCommandStreamOut
    }
    on driverArrived: command Ride.DriverArrived is {
      send driverArrived to outlet RideContext.RideCommandStreamOut
    }
    on startTrip: command Ride.StartTrip is {
      send startTrip to outlet RideContext.RideCommandStreamOut
    }
    on updateLocation: command Ride.UpdateLocation is {
      send updateLocation to outlet RideContext.RideCommandStreamOut
    }
    on completeTrip: command Ride.CompleteTrip is {
      send completeTrip to outlet RideContext.RideCommandStreamOut
    }
    on processPayment: command Ride.ProcessPayment is {
      send processPayment to outlet RideContext.RideCommandStreamOut
    }
    on rateRide: command Ride.RateRide is {
      send rateRide to outlet RideContext.RideCommandStreamOut
    }
    on cancelRide: command Ride.CancelRide is {
      send cancelRide to outlet RideContext.RideCommandStreamOut
    }
    on rideResult: result Ride.RideResult is {
      send rideResult to outlet RideContext.RideResultStreamOut
    }
    on other is {
      error "Unexpected message at the RideContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'RideCommand Stream Intake' is from outlet RideContext.RideCommandStreamOut to inlet RideContext.Ride.RideCommands  connector 'RideResult Stream Egress' is from outlet RideContext.RideRepository.RideRepositoryResponses to inlet RideContext.RideResultStreamIn  adaptor FromDriverMatchingService from context DriverMatchingService is { 
    handler FromDriverMatchingServiceHandler is {
      on result DriverMatchingService.AvailableDrivers is {
        do "the model receives available drivers"
      }
      on event DriverMatchingService.DriverDispatched is {
        do "the model receives driver dispatched"
      }
      on other is {
        error "Unexpected message for adaptor FromDriverMatchingService"
      }
    } with {
      briefly "from driver matching service"
      described as {
        |Carries messages from the external DriverMatchingService.
      }
    }
  } with {
    briefly "DriverMatchingService integration"
    described as {
      |The model's side of the DriverMatchingService conversation.
    }
  }
  adaptor ToDriverMatchingService to context DriverMatchingService is { 
    handler ToDriverMatchingServiceHandler is {
      on command DriverMatchingService.DispatchDriver is {
        do "the model sends dispatch driver"
      }
      on command DriverMatchingService.FindAvailableDrivers is {
        do "the model sends find available drivers"
      }
      on query DriverMatchingService.GetAvailableDrivers is {
        do "the model sends get available drivers"
      }
      on other is {
        error "Unexpected message for adaptor ToDriverMatchingService"
      }
    } with {
      briefly "to driver matching service"
      described as {
        |Carries messages to the external DriverMatchingService.
      }
    }
  } with {
    briefly "DriverMatchingService integration"
    described as {
      |The model's side of the DriverMatchingService conversation.
    }
  }
  adaptor FromFareCalculationService from context FareCalculationService is { 
    handler FromFareCalculationServiceHandler is {
      on result FareCalculationService.FareCalculation is {
        do "the model receives fare calculation"
      }
      on result FareCalculationService.FinalFare is {
        do "the model receives final fare"
      }
      on other is {
        error "Unexpected message for adaptor FromFareCalculationService"
      }
    } with {
      briefly "from fare calculation service"
      described as {
        |Carries messages from the external FareCalculationService.
      }
    }
  } with {
    briefly "FareCalculationService integration"
    described as {
      |The model's side of the FareCalculationService conversation.
    }
  }
  adaptor ToFareCalculationService to context FareCalculationService is { 
    handler ToFareCalculationServiceHandler is {
      on command FareCalculationService.CalculateFare is {
        do "the model sends calculate fare"
      }
      on command FareCalculationService.CalculateFinalFare is {
        do "the model sends calculate final fare"
      }
      on query FareCalculationService.GetFareCalculation is {
        do "the model sends get fare calculation"
      }
      on other is {
        error "Unexpected message for adaptor ToFareCalculationService"
      }
    } with {
      briefly "to fare calculation service"
      described as {
        |Carries messages to the external FareCalculationService.
      }
    }
  } with {
    briefly "FareCalculationService integration"
    described as {
      |The model's side of the FareCalculationService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.DriverNotified is {
        do "the model receives driver notified"
      }
      on event NotificationService.RiderNotified is {
        do "the model receives rider notified"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendDriverNotification is {
        do "the model sends send driver notification"
      }
      on command NotificationService.SendRiderNotification is {
        do "the model sends send rider notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentService from context PaymentService is { 
    handler FromPaymentServiceHandler is {
      on event PaymentService.ChargeFailed is {
        do "the model receives charge failed"
      }
      on event PaymentService.DriverPaid is {
        do "the model receives driver paid"
      }
      on event PaymentService.RideCharged is {
        do "the model receives ride charged"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentService"
      }
    } with {
      briefly "from payment service"
      described as {
        |Carries messages from the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor ToPaymentService to context PaymentService is { 
    handler ToPaymentServiceHandler is {
      on command PaymentService.ChargeRide is {
        do "the model sends charge ride"
      }
      on command PaymentService.PayDriver is {
        do "the model sends pay driver"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentService"
      }
    } with {
      briefly "to payment service"
      described as {
        |Carries messages to the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor FromRoutingService from context RoutingService is { 
    handler FromRoutingServiceHandler is {
      on result RoutingService.ETAResult is {
        do "the model receives eta result"
      }
      on result RoutingService.RouteResult is {
        do "the model receives route result"
      }
      on other is {
        error "Unexpected message for adaptor FromRoutingService"
      }
    } with {
      briefly "from routing service"
      described as {
        |Carries messages from the external RoutingService.
      }
    }
  } with {
    briefly "RoutingService integration"
    described as {
      |The model's side of the RoutingService conversation.
    }
  }
  adaptor ToRoutingService to context RoutingService is { 
    handler ToRoutingServiceHandler is {
      on query RoutingService.GetETA is {
        do "the model sends get eta"
      }
      on query RoutingService.GetRoute is {
        do "the model sends get route"
      }
      on other is {
        error "Unexpected message for adaptor ToRoutingService"
      }
    } with {
      briefly "to routing service"
      described as {
        |Carries messages to the external RoutingService.
      }
    }
  } with {
    briefly "RoutingService integration"
    described as {
      |The model's side of the RoutingService conversation.
    }
  }
  adaptor FromSafetyService from context SafetyService is { 
    handler FromSafetyServiceHandler is {
      on event SafetyService.IncidentReported is {
        do "the model receives incident reported"
      }
      on event SafetyService.TripShared is {
        do "the model receives trip shared"
      }
      on other is {
        error "Unexpected message for adaptor FromSafetyService"
      }
    } with {
      briefly "from safety service"
      described as {
        |Carries messages from the external SafetyService.
      }
    }
  } with {
    briefly "SafetyService integration"
    described as {
      |The model's side of the SafetyService conversation.
    }
  }
  adaptor ToSafetyService to context SafetyService is { 
    handler ToSafetyServiceHandler is {
      on command SafetyService.ReportSafetyIncident is {
        do "the model sends report safety incident"
      }
      on command SafetyService.ShareTripStatus is {
        do "the model sends share trip status"
      }
      on other is {
        error "Unexpected message for adaptor ToSafetyService"
      }
    } with {
      briefly "to safety service"
      described as {
        |Carries messages to the external SafetyService.
      }
    }
  } with {
    briefly "SafetyService integration"
    described as {
      |The model's side of the SafetyService conversation.
    }
  }
  include "types.riddl"
  include "Ride.riddl"
  // Repository for ride persistence
  type RideRepositoryCommand is one of {
    RideContext.RideRepository.PersistDriverAssigned or RideContext.RideRepository.PersistDriverHasArrived or RideContext.RideRepository.PersistDriverIsEnRoute or RideContext.RideRepository.PersistLocationUpdated or RideContext.RideRepository.PersistPaymentProcessed or RideContext.RideRepository.PersistRideCancelled or RideContext.RideRepository.PersistRideRated or RideContext.RideRepository.PersistRideRequested or RideContext.RideRepository.PersistTripCompleted or RideContext.RideRepository.PersistTripStarted
  } with {
    briefly "Anything that writes RideRepository"
    described as {
      |The persistence commands RideRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository RideRepository as flow is {
    inlet RideRepositoryFromRideAnalytics is type RideRepositoryCommand
    command PersistDriverAssigned is  {
      rideId: RideId with {
        briefly "Row addressed"
        described as {
          |Which stored row DriverAssigned applies to.
        }
      }
    } with {
      briefly "Persist DriverAssigned"
      described as {
        |Instructs this repository to apply DriverAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDriverHasArrived is  {
      rideId: RideId with {
        briefly "Row addressed"
        described as {
          |Which stored row DriverHasArrived applies to.
        }
      }
    } with {
      briefly "Persist DriverHasArrived"
      described as {
        |Instructs this repository to apply DriverHasArrived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDriverIsEnRoute is  {
      rideId: RideId with {
        briefly "Row addressed"
        described as {
          |Which stored row DriverIsEnRoute applies to.
        }
      }
    } with {
      briefly "Persist DriverIsEnRoute"
      described as {
        |Instructs this repository to apply DriverIsEnRoute to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLocationUpdated is  {
      rideId: RideId with {
        briefly "Row addressed"
        described as {
          |Which stored row LocationUpdated applies to.
        }
      }
    } with {
      briefly "Persist LocationUpdated"
      described as {
        |Instructs this repository to apply LocationUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentProcessed is  {
      rideId: RideId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentProcessed applies to.
        }
      }
    } with {
      briefly "Persist PaymentProcessed"
      described as {
        |Instructs this repository to apply PaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTripStarted is  {
      rideId: RideId with {
        briefly "Row addressed"
        described as {
          |Which stored row TripStarted applies to.
        }
      }
    } with {
      briefly "Persist TripStarted"
      described as {
        |Instructs this repository to apply TripStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRideCancelled is  {
      rideId: RideId with {
        briefly "Row addressed"
        described as {
          |Which stored row RideCancelled applies to.
        }
      }
    } with {
      briefly "Persist RideCancelled"
      described as {
        |Instructs this repository to apply RideCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRideRated is  {
      rideId: RideId with {
        briefly "Row addressed"
        described as {
          |Which stored row RideRated applies to.
        }
      }
    } with {
      briefly "Persist RideRated"
      described as {
        |Instructs this repository to apply RideRated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRideRequested is  {
      rideId: RideId with {
        briefly "Row addressed"
        described as {
          |Which stored row RideRequested applies to.
        }
      }
    } with {
      briefly "Persist RideRequested"
      described as {
        |Instructs this repository to apply RideRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTripCompleted is  {
      rideId: RideId with {
        briefly "Row addressed"
        described as {
          |Which stored row TripCompleted applies to.
        }
      }
    } with {
      briefly "Persist TripCompleted"
      described as {
        |Instructs this repository to apply TripCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet RideRepositoryResponses is result Ride.RideResult
    record StoredRide is  {
      rideId: RideId with {
        briefly "rideId"
        described as {
          |The rideId column of the stored ride row.
        }
      }
      rider: RiderInfo with {
        briefly "rider"
        described as {
          |The rider column of the stored ride row.
        }
      }
      status: RideStatus with {
        briefly "status"
        described as {
          |The status column of the stored ride row.
        }
      }
    } with {
      briefly "Stored ride row"
      described as {
        |The persistence shape of ride data as this repository stores it.
      }
    }
    schema RideData is relational
      of rides as record StoredRide
        index on field StoredRide.rideId
        index on field StoredRide.rider.riderId
        index on field StoredRide.status
 with {
      briefly "Ride data schema"
      described as {
        |The relational schema holding ride data for the RideRepository.
      }
    }
    handler RidePersistence is {
      on persistDriverAssigned: command PersistDriverAssigned is {
        do "apply DriverAssigned to the stored row"
      }
      on persistDriverHasArrived: command PersistDriverHasArrived is {
        do "apply DriverHasArrived to the stored row"
      }
      on persistDriverIsEnRoute: command PersistDriverIsEnRoute is {
        do "apply DriverIsEnRoute to the stored row"
      }
      on persistLocationUpdated: command PersistLocationUpdated is {
        do "apply LocationUpdated to the stored row"
      }
      on persistPaymentProcessed: command PersistPaymentProcessed is {
        do "apply PaymentProcessed to the stored row"
      }
      on persistTripStarted: command PersistTripStarted is {
        do "apply TripStarted to the stored row"
      }
      on persistRideCancelled: command PersistRideCancelled is {
        do "apply RideCancelled to the stored row"
      }
      on persistRideRated: command PersistRideRated is {
        do "apply RideRated to the stored row"
      }
      on persistRideRequested: command PersistRideRequested is {
        do "apply RideRequested to the stored row"
      }
      on persistTripCompleted: command PersistTripCompleted is {
        do "apply TripCompleted to the stored row"
      }
      on query GetRideStats is {
        let rideStatsView: type RideStatsView = prompt("read the ride stats projection")
        reply rideStatsView
      }
    } with {
      briefly "Persists ride commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Ride data persistence"
    described as {
      | The RideRepository provides persistent storage for
      | rides, trips, and ratings.
    }
  }
  // Projector for ride analytics
  query GetRideStats replies result RideStatsView is  {
    rideStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which ride stats to retrieve.
      }
    }
  } with {
    briefly "Get ride stats"
    described as {
      |Retrieves the ride stats projection.
    }
  }
  result RideStatsView is  {
    rideStats: RideAnalytics.RideStats with {
      briefly "Ride stats"
      described as {
        |The ride stats being returned.
      }
    }
  } with {
    briefly "Ride stats view"
    described as {
      |Read model view carrying the ride stats projection.
    }
  }
  projector RideAnalytics as flow is {
    outlet RideAnalyticsToRepository is type RideRepositoryCommand
    updates repository RideContext.RideRepository
    inlet RideAnalyticsFromRide is type RideEvent
    record RideStats is  {
      activeRides: Natural with {
        briefly "Active"
        described as {
          |Active rides.
        }
      }
      ridesCompletedToday: Natural with {
        briefly "Completed"
        described as {
          |Rides completed today.
        }
      }
      averageFare: Decimal(10,2) with {
        briefly "Avg fare"
        described as {
          |Average fare.
        }
      }
      averageRating: Decimal(2,1) with {
        briefly "Avg rating"
        described as {
          |Average driver rating.
        }
      }
      cancellationRate: Decimal(5,4) with {
        briefly "Cancellation"
        described as {
          |Cancellation rate.
        }
      }
      averageWaitTime: Natural with {
        briefly "Wait time"
        described as {
          |Average wait time (min).
        }
      }
    } with {
      briefly "Ride statistics"
      described as {
        |Ride-sharing metrics.
      }
    }
    handler AnalyticsHandler is {
      on driverAssigned: event Ride.DriverAssigned is {
        tell command RideContext.RideRepository.PersistDriverAssigned(rideId = driverAssigned.rideId) to repository RideContext.RideRepository
        do "apply DriverAssigned to the RideAnalytics projection"
      }
      on driverHasArrived: event Ride.DriverHasArrived is {
        tell command RideContext.RideRepository.PersistDriverHasArrived(rideId = driverHasArrived.rideId) to repository RideContext.RideRepository
        do "apply DriverHasArrived to the RideAnalytics projection"
      }
      on driverIsEnRoute: event Ride.DriverIsEnRoute is {
        tell command RideContext.RideRepository.PersistDriverIsEnRoute(rideId = driverIsEnRoute.rideId) to repository RideContext.RideRepository
        do "apply DriverIsEnRoute to the RideAnalytics projection"
      }
      on locationUpdated: event Ride.LocationUpdated is {
        tell command RideContext.RideRepository.PersistLocationUpdated(rideId = locationUpdated.rideId) to repository RideContext.RideRepository
        do "apply LocationUpdated to the RideAnalytics projection"
      }
      on paymentProcessed: event Ride.PaymentProcessed is {
        tell command RideContext.RideRepository.PersistPaymentProcessed(rideId = paymentProcessed.rideId) to repository RideContext.RideRepository
        do "apply PaymentProcessed to the RideAnalytics projection"
      }
      on tripStarted: event Ride.TripStarted is {
        tell command RideContext.RideRepository.PersistTripStarted(rideId = tripStarted.rideId) to repository RideContext.RideRepository
        do "apply TripStarted to the RideAnalytics projection"
      }
      on rideRequested: event Ride.RideRequested is {
        tell command RideContext.RideRepository.PersistRideRequested(rideId = rideRequested.rideId) to repository RideContext.RideRepository
        do "Update request counts"
      }
      on tripCompleted: event Ride.TripCompleted is {
        tell command RideContext.RideRepository.PersistTripCompleted(rideId = tripCompleted.rideId) to repository RideContext.RideRepository
        do "Update completion metrics"
      }
      on rideRated: event Ride.RideRated is {
        tell command RideContext.RideRepository.PersistRideRated(rideId = rideRated.rideId) to repository RideContext.RideRepository
        do "Update rating metrics"
      }
      on rideCancelled: event Ride.RideCancelled is {
        tell command RideContext.RideRepository.PersistRideCancelled(rideId = rideCancelled.rideId) to repository RideContext.RideRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains ride analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Ride analytics projections"
    described as {
      |Maintains ride-sharing analytics data.
    }
  }
  // ---- Event publication for Ride ----
  type RideEvent is one of {
    RideContext.Ride.RideRequested or RideContext.Ride.DriverAssigned or RideContext.Ride.DriverIsEnRoute or RideContext.Ride.DriverHasArrived or RideContext.Ride.TripStarted or RideContext.Ride.LocationUpdated or RideContext.Ride.TripCompleted or RideContext.Ride.PaymentProcessed or RideContext.Ride.RideRated or RideContext.Ride.RideCancelled
  } with {
    briefly "Ride event alternation"
    described as {
      |Union of all Ride events, for streaming and event-sourced
      |persistence.
    }
  }
  processor RideEventSplit as flow is {
    inlet RideEventSplitIn is type RideEvent
    outlet RideEventSplitToRideAnalytics is type RideEvent
    handler RideEventSplitHandler is {
      on rideRequested: event Ride.RideRequested is {
        send rideRequested to outlet RideEventSplitToRideAnalytics
        tell rideRequested to entity RideContext.Ride
      }
      on driverAssigned: event Ride.DriverAssigned is {
        send driverAssigned to outlet RideEventSplitToRideAnalytics
        tell driverAssigned to entity RideContext.Ride
      }
      on driverIsEnRoute: event Ride.DriverIsEnRoute is {
        send driverIsEnRoute to outlet RideEventSplitToRideAnalytics
        tell driverIsEnRoute to entity RideContext.Ride
      }
      on driverHasArrived: event Ride.DriverHasArrived is {
        send driverHasArrived to outlet RideEventSplitToRideAnalytics
        tell driverHasArrived to entity RideContext.Ride
      }
      on tripStarted: event Ride.TripStarted is {
        send tripStarted to outlet RideEventSplitToRideAnalytics
        tell tripStarted to entity RideContext.Ride
      }
      on locationUpdated: event Ride.LocationUpdated is {
        send locationUpdated to outlet RideEventSplitToRideAnalytics
        tell locationUpdated to entity RideContext.Ride
      }
      on tripCompleted: event Ride.TripCompleted is {
        send tripCompleted to outlet RideEventSplitToRideAnalytics
        tell tripCompleted to entity RideContext.Ride
      }
      on paymentProcessed: event Ride.PaymentProcessed is {
        send paymentProcessed to outlet RideEventSplitToRideAnalytics
        tell paymentProcessed to entity RideContext.Ride
      }
      on rideRated: event Ride.RideRated is {
        send rideRated to outlet RideEventSplitToRideAnalytics
        tell rideRated to entity RideContext.Ride
      }
      on rideCancelled: event Ride.RideCancelled is {
        send rideCancelled to outlet RideEventSplitToRideAnalytics
        tell rideCancelled to entity RideContext.Ride
      }
      on other is {
        error "Unexpected message for processor RideEventSplit"
      }
    } with {
      briefly "Ride event fan-out handler"
      described as {
        |Delivers each Ride event to all of its consumers.
      }
    }
  } with {
    briefly "Ride event fan-out"
    described as {
      |Fans Ride events out to the repository and projectors.
    }
  }
  connector 'RideEvent Stream' is from outlet RideContext.Ride.RideEvents2 to inlet RideContext.RideEventSplit.RideEventSplitIn with {
    briefly "Ride events, fanned out to storage and read models"
  }
  connector 'RideAnalytics Feed' is from outlet RideContext.RideEventSplit.RideEventSplitToRideAnalytics to inlet RideContext.RideAnalytics.RideAnalyticsFromRide with {
    briefly "Ride events feeding the RideAnalytics projection"
  }
  connector 'RideAnalytics Storage' is from outlet RideContext.RideAnalytics.RideAnalyticsToRepository to inlet RideContext.RideRepository.RideRepositoryFromRideAnalytics with {
    briefly "RideAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for ride sharing"
  described as {
    | The RideContext is the bounded context for
    | on-demand ride management.
  }
}
