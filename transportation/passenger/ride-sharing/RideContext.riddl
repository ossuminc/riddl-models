// Ride Sharing - Ride Context
context RideContext is {
  adaptor FromDriverMatchingService from context DriverMatchingService is { 
    handler FromDriverMatchingServiceHandler is {
      on result DriverMatchingService.AvailableDrivers is {
        do "the model receives available drivers"
      }
      on event DriverMatchingService.DriverDispatched is {
        do "the model receives driver dispatched"
      }
      on other is {
        error "Unexpected message for adaptor FromDriverMatchingService"
      }
    } with {
      briefly "from driver matching service"
      described as {
        |Carries messages from the external DriverMatchingService.
      }
    }
  } with {
    briefly "DriverMatchingService integration"
    described as {
      |The model's side of the DriverMatchingService conversation.
    }
  }
  adaptor ToDriverMatchingService to context DriverMatchingService is { 
    handler ToDriverMatchingServiceHandler is {
      on command DriverMatchingService.DispatchDriver is {
        do "the model sends dispatch driver"
      }
      on command DriverMatchingService.FindAvailableDrivers is {
        do "the model sends find available drivers"
      }
      on query DriverMatchingService.GetAvailableDrivers is {
        do "the model sends get available drivers"
      }
      on other is {
        error "Unexpected message for adaptor ToDriverMatchingService"
      }
    } with {
      briefly "to driver matching service"
      described as {
        |Carries messages to the external DriverMatchingService.
      }
    }
  } with {
    briefly "DriverMatchingService integration"
    described as {
      |The model's side of the DriverMatchingService conversation.
    }
  }
  adaptor FromFareCalculationService from context FareCalculationService is { 
    handler FromFareCalculationServiceHandler is {
      on result FareCalculationService.FareCalculation is {
        do "the model receives fare calculation"
      }
      on result FareCalculationService.FinalFare is {
        do "the model receives final fare"
      }
      on other is {
        error "Unexpected message for adaptor FromFareCalculationService"
      }
    } with {
      briefly "from fare calculation service"
      described as {
        |Carries messages from the external FareCalculationService.
      }
    }
  } with {
    briefly "FareCalculationService integration"
    described as {
      |The model's side of the FareCalculationService conversation.
    }
  }
  adaptor ToFareCalculationService to context FareCalculationService is { 
    handler ToFareCalculationServiceHandler is {
      on command FareCalculationService.CalculateFare is {
        do "the model sends calculate fare"
      }
      on command FareCalculationService.CalculateFinalFare is {
        do "the model sends calculate final fare"
      }
      on query FareCalculationService.GetFareCalculation is {
        do "the model sends get fare calculation"
      }
      on other is {
        error "Unexpected message for adaptor ToFareCalculationService"
      }
    } with {
      briefly "to fare calculation service"
      described as {
        |Carries messages to the external FareCalculationService.
      }
    }
  } with {
    briefly "FareCalculationService integration"
    described as {
      |The model's side of the FareCalculationService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.DriverNotified is {
        do "the model receives driver notified"
      }
      on event NotificationService.RiderNotified is {
        do "the model receives rider notified"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendDriverNotification is {
        do "the model sends send driver notification"
      }
      on command NotificationService.SendRiderNotification is {
        do "the model sends send rider notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentService from context PaymentService is { 
    handler FromPaymentServiceHandler is {
      on event PaymentService.ChargeFailed is {
        do "the model receives charge failed"
      }
      on event PaymentService.DriverPaid is {
        do "the model receives driver paid"
      }
      on event PaymentService.RideCharged is {
        do "the model receives ride charged"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentService"
      }
    } with {
      briefly "from payment service"
      described as {
        |Carries messages from the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor ToPaymentService to context PaymentService is { 
    handler ToPaymentServiceHandler is {
      on command PaymentService.ChargeRide is {
        do "the model sends charge ride"
      }
      on command PaymentService.PayDriver is {
        do "the model sends pay driver"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentService"
      }
    } with {
      briefly "to payment service"
      described as {
        |Carries messages to the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor FromRoutingService from context RoutingService is { 
    handler FromRoutingServiceHandler is {
      on result RoutingService.ETAResult is {
        do "the model receives eta result"
      }
      on result RoutingService.RouteResult is {
        do "the model receives route result"
      }
      on other is {
        error "Unexpected message for adaptor FromRoutingService"
      }
    } with {
      briefly "from routing service"
      described as {
        |Carries messages from the external RoutingService.
      }
    }
  } with {
    briefly "RoutingService integration"
    described as {
      |The model's side of the RoutingService conversation.
    }
  }
  adaptor ToRoutingService to context RoutingService is { 
    handler ToRoutingServiceHandler is {
      on query RoutingService.GetETA is {
        do "the model sends get eta"
      }
      on query RoutingService.GetRoute is {
        do "the model sends get route"
      }
      on other is {
        error "Unexpected message for adaptor ToRoutingService"
      }
    } with {
      briefly "to routing service"
      described as {
        |Carries messages to the external RoutingService.
      }
    }
  } with {
    briefly "RoutingService integration"
    described as {
      |The model's side of the RoutingService conversation.
    }
  }
  adaptor FromSafetyService from context SafetyService is { 
    handler FromSafetyServiceHandler is {
      on event SafetyService.IncidentReported is {
        do "the model receives incident reported"
      }
      on event SafetyService.TripShared is {
        do "the model receives trip shared"
      }
      on other is {
        error "Unexpected message for adaptor FromSafetyService"
      }
    } with {
      briefly "from safety service"
      described as {
        |Carries messages from the external SafetyService.
      }
    }
  } with {
    briefly "SafetyService integration"
    described as {
      |The model's side of the SafetyService conversation.
    }
  }
  adaptor ToSafetyService to context SafetyService is { 
    handler ToSafetyServiceHandler is {
      on command SafetyService.ReportSafetyIncident is {
        do "the model sends report safety incident"
      }
      on command SafetyService.ShareTripStatus is {
        do "the model sends share trip status"
      }
      on other is {
        error "Unexpected message for adaptor ToSafetyService"
      }
    } with {
      briefly "to safety service"
      described as {
        |Carries messages to the external SafetyService.
      }
    }
  } with {
    briefly "SafetyService integration"
    described as {
      |The model's side of the SafetyService conversation.
    }
  }
  include "types.riddl"
  include "Ride.riddl"
  // Repository for ride persistence
  repository RideRepository is {
    inlet RideRepositoryFromRide is type RideEvent    inlet RideRepositoryFromRideAnalytics is type RideEvent    outlet RideRepositoryResponses is type Ride.RideResult
    record StoredRide is  {
      rideId: RideId with {
        briefly "rideId"
        described as {
          |The rideId column of the stored ride row.
        }
      }
      rider: RiderInfo with {
        briefly "rider"
        described as {
          |The rider column of the stored ride row.
        }
      }
      status: RideStatus with {
        briefly "status"
        described as {
          |The status column of the stored ride row.
        }
      }
    } with {
      briefly "Stored ride row"
      described as {
        |The persistence shape of ride data as this repository stores it.
      }
    }
    schema RideData is relational
      of rides as type StoredRide
        index on field StoredRide.rideId
        index on field StoredRide.rider.riderId
        index on field StoredRide.status
 with {
      briefly "Ride data schema"
      described as {
        |The relational schema holding ride data for the RideRepository.
      }
    }
    handler RidePersistence is {
      on query GetRideStats is {
        do "read the ride stats projection"
        yield result RideStatsView
      }
      on command Ride.RequestRide is {
        do "Store new ride request"
      }
      on command Ride.AssignDriver is {
        tell event Ride.DriverAssigned to entity RideContext.Ride
        do "Update driver assignment"
      }
      on command Ride.DriverEnRoute is {
        tell event Ride.DriverIsEnRoute to entity RideContext.Ride
        do "Update driver location"
      }
      on command Ride.DriverArrived is {
        do "Update arrival status"
      }
      on command Ride.StartTrip is {
        tell event Ride.TripStarted to entity RideContext.Ride
        do "Update to in progress"
      }
      on command Ride.UpdateLocation is {
        tell event Ride.LocationUpdated to entity RideContext.Ride
        do "Store location update"
      }
      on command Ride.CompleteTrip is {
        tell event Ride.TripCompleted to entity RideContext.Ride
        do "Store trip completion"
      }
      on command Ride.ProcessPayment is {
        tell event Ride.PaymentProcessed to entity RideContext.Ride
        do "Store payment"
      }
      on command Ride.RateRide is {
        do "Store ratings"
      }
      on command Ride.CancelRide is {
        tell event Ride.RideCancelled to entity RideContext.Ride
        do "Update to cancelled"
      }
    } with {
      briefly "Persists ride commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Ride data persistence"
    described as {
      | The RideRepository provides persistent storage for
      | rides, trips, and ratings.
    }
  }
  // Projector for ride analytics
  query GetRideStats is  {
    rideStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which ride stats to retrieve.
      }
    }
  } with {
    briefly "Get ride stats"
    described as {
      |Retrieves the ride stats projection.
    }
  }
  result RideStatsView is  {
    rideStats: RideAnalytics.RideStats with {
      briefly "Ride stats"
      described as {
        |The ride stats being returned.
      }
    }
  } with {
    briefly "Ride stats view"
    described as {
      |Read model view carrying the ride stats projection.
    }
  }
  projector RideAnalytics is {
    updates repository RideContext.RideRepository
    inlet RideAnalyticsFromRide is type RideEvent    outlet RideAnalyticsOut is type RideEvent
    record RideStats is  {
      activeRides: Natural with {
        briefly "Active"
        described as {
          |Active rides.
        }
      }
      ridesCompletedToday: Natural with {
        briefly "Completed"
        described as {
          |Rides completed today.
        }
      }
      averageFare: Decimal(10,2) with {
        briefly "Avg fare"
        described as {
          |Average fare.
        }
      }
      averageRating: Decimal(2,1) with {
        briefly "Avg rating"
        described as {
          |Average driver rating.
        }
      }
      cancellationRate: Decimal(5,4) with {
        briefly "Cancellation"
        described as {
          |Cancellation rate.
        }
      }
      averageWaitTime: Natural with {
        briefly "Wait time"
        described as {
          |Average wait time (min).
        }
      }
    } with {
      briefly "Ride statistics"
      described as {
        |Ride-sharing metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Ride.RideRequested is {
        tell event Ride.RideRequested to repository RideContext.RideRepository
        do "Update request counts"
      }
      on event Ride.TripCompleted is {
        tell event Ride.TripCompleted to repository RideContext.RideRepository
        do "Update completion metrics"
      }
      on event Ride.RideRated is {
        tell event Ride.RideRated to repository RideContext.RideRepository
        do "Update rating metrics"
      }
      on event Ride.RideCancelled is {
        tell event Ride.RideCancelled to repository RideContext.RideRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains ride analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Ride analytics projections"
    described as {
      |Maintains ride-sharing analytics data.
    }
  }
  // ---- Event publication for Ride ----
  type RideEvent is one of {
    RideContext.Ride.RideRequested or RideContext.Ride.DriverAssigned or RideContext.Ride.DriverIsEnRoute or RideContext.Ride.DriverHasArrived or RideContext.Ride.TripStarted or RideContext.Ride.LocationUpdated or RideContext.Ride.TripCompleted or RideContext.Ride.PaymentProcessed or RideContext.Ride.RideRated or RideContext.Ride.RideCancelled
  } with {
    briefly "Ride event alternation"
    described as {
      |Union of all Ride events, for streaming and event-sourced
      |persistence.
    }
  }
  processor RideEventSource as source is {
    outlet RideEvents is type RideEvent
    handler RideSourceHandler is {
      on event Ride.RideRequested is {
        send event Ride.RideRequested to outlet RideEvents
      }
      on event Ride.DriverAssigned is {
        send event Ride.DriverAssigned to outlet RideEvents
      }
      on event Ride.DriverIsEnRoute is {
        send event Ride.DriverIsEnRoute to outlet RideEvents
      }
      on event Ride.DriverHasArrived is {
        send event Ride.DriverHasArrived to outlet RideEvents
      }
      on event Ride.TripStarted is {
        send event Ride.TripStarted to outlet RideEvents
      }
      on event Ride.LocationUpdated is {
        send event Ride.LocationUpdated to outlet RideEvents
      }
      on event Ride.TripCompleted is {
        send event Ride.TripCompleted to outlet RideEvents
      }
      on event Ride.PaymentProcessed is {
        send event Ride.PaymentProcessed to outlet RideEvents
      }
      on event Ride.RideRated is {
        send event Ride.RideRated to outlet RideEvents
      }
      on event Ride.RideCancelled is {
        send event Ride.RideCancelled to outlet RideEvents
      }
      on other is {
        error "Unexpected message for source RideEventSource"
      }
    } with {
      briefly "Ride source handler"
      described as {
        |Publishes Ride events onto the outlet.
      }
    }
  } with {
    briefly "Ride event source"
    described as {
      |Publishes Ride entity events into the streaming topology.
    }
  }
  processor RideEventSink as sink is {
    inlet RideInlet is type RideEvent    handler RideSinkHandler is {
      on event Ride.RideRequested is {
        tell event Ride.RideRequested to repository RideContext.RideRepository
      }
      on event Ride.DriverAssigned is {
        tell event Ride.DriverAssigned to repository RideContext.RideRepository
      }
      on event Ride.DriverIsEnRoute is {
        tell event Ride.DriverIsEnRoute to repository RideContext.RideRepository
      }
      on event Ride.DriverHasArrived is {
        tell event Ride.DriverHasArrived to repository RideContext.RideRepository
      }
      on event Ride.TripStarted is {
        tell event Ride.TripStarted to repository RideContext.RideRepository
      }
      on event Ride.LocationUpdated is {
        tell event Ride.LocationUpdated to repository RideContext.RideRepository
      }
      on event Ride.TripCompleted is {
        tell event Ride.TripCompleted to repository RideContext.RideRepository
      }
      on event Ride.PaymentProcessed is {
        tell event Ride.PaymentProcessed to repository RideContext.RideRepository
      }
      on event Ride.RideRated is {
        tell event Ride.RideRated to repository RideContext.RideRepository
      }
      on event Ride.RideCancelled is {
        tell event Ride.RideCancelled to repository RideContext.RideRepository
      }
      on other is {
        error "Unexpected message for sink RideEventSink"
      }
    } with {
      briefly "Ride sink handler"
      described as {
        |Persists Ride events via the repository.
      }
    }
  } with {
    briefly "Ride event sink"
    described as {
      |Receives Ride events for persistence.
    }
  }
  connector RideEventFlow is from outlet RideContext.RideEventSource.RideEvents to inlet RideContext.RideEventSink.RideInlet with {
    briefly "Ride event flow"
    described as {
      |Connects the Ride source to its sink.
    }
  }
  processor RideEventSplit is {
    inlet RideEventSplitIn is type RideEvent    outlet RideEventSplitToRideRepository is type RideEvent
    outlet RideEventSplitToRideAnalytics is type RideEvent
    handler RideEventSplitHandler is {
      on event Ride.RideRequested is {
        send event Ride.RideRequested to outlet RideEventSplitToRideRepository
        send event Ride.RideRequested to outlet RideEventSplitToRideAnalytics
        tell event Ride.RideRequested to entity RideContext.Ride
      }
      on event Ride.DriverAssigned is {
        send event Ride.DriverAssigned to outlet RideEventSplitToRideRepository
        send event Ride.DriverAssigned to outlet RideEventSplitToRideAnalytics
        tell event Ride.DriverAssigned to entity RideContext.Ride
      }
      on event Ride.DriverIsEnRoute is {
        send event Ride.DriverIsEnRoute to outlet RideEventSplitToRideRepository
        send event Ride.DriverIsEnRoute to outlet RideEventSplitToRideAnalytics
        tell event Ride.DriverIsEnRoute to entity RideContext.Ride
      }
      on event Ride.DriverHasArrived is {
        send event Ride.DriverHasArrived to outlet RideEventSplitToRideRepository
        send event Ride.DriverHasArrived to outlet RideEventSplitToRideAnalytics
        tell event Ride.DriverHasArrived to entity RideContext.Ride
      }
      on event Ride.TripStarted is {
        send event Ride.TripStarted to outlet RideEventSplitToRideRepository
        send event Ride.TripStarted to outlet RideEventSplitToRideAnalytics
        tell event Ride.TripStarted to entity RideContext.Ride
      }
      on event Ride.LocationUpdated is {
        send event Ride.LocationUpdated to outlet RideEventSplitToRideRepository
        send event Ride.LocationUpdated to outlet RideEventSplitToRideAnalytics
        tell event Ride.LocationUpdated to entity RideContext.Ride
      }
      on event Ride.TripCompleted is {
        send event Ride.TripCompleted to outlet RideEventSplitToRideRepository
        send event Ride.TripCompleted to outlet RideEventSplitToRideAnalytics
        tell event Ride.TripCompleted to entity RideContext.Ride
      }
      on event Ride.PaymentProcessed is {
        send event Ride.PaymentProcessed to outlet RideEventSplitToRideRepository
        send event Ride.PaymentProcessed to outlet RideEventSplitToRideAnalytics
        tell event Ride.PaymentProcessed to entity RideContext.Ride
      }
      on event Ride.RideRated is {
        send event Ride.RideRated to outlet RideEventSplitToRideRepository
        send event Ride.RideRated to outlet RideEventSplitToRideAnalytics
        tell event Ride.RideRated to entity RideContext.Ride
      }
      on event Ride.RideCancelled is {
        send event Ride.RideCancelled to outlet RideEventSplitToRideRepository
        send event Ride.RideCancelled to outlet RideEventSplitToRideAnalytics
        tell event Ride.RideCancelled to entity RideContext.Ride
      }
      on other is {
        error "Unexpected message for processor RideEventSplit"
      }
    } with {
      briefly "Ride event fan-out handler"
      described as {
        |Delivers each Ride event to all of its consumers.
      }
    }
  } with {
    briefly "Ride event fan-out"
    described as {
      |Fans Ride events out to the repository and projectors.
    }
  }
  connector LinkRideToRideEventSplit is from outlet RideContext.Ride.RideEvents2 to inlet RideContext.RideEventSplit.RideEventSplitIn with {
    briefly "LinkRideToRideEventSplit"
  }
  connector LinkRideEventSplitToRideRepository is from outlet RideContext.RideEventSplit.RideEventSplitToRideRepository to inlet RideContext.RideRepository.RideRepositoryFromRide with {
    briefly "LinkRideEventSplitToRideRepository"
  }
  connector LinkRideEventSplitToRideAnalytics is from outlet RideContext.RideEventSplit.RideEventSplitToRideAnalytics to inlet RideContext.RideAnalytics.RideAnalyticsFromRide with {
    briefly "LinkRideEventSplitToRideAnalytics"
  }
  connector LinkRideAnalyticsToRideRepository is from outlet RideContext.RideAnalytics.RideAnalyticsOut to inlet RideContext.RideRepository.RideRepositoryFromRideAnalytics with {
    briefly "LinkRideAnalyticsToRideRepository"
  }
} with {
  briefly "Bounded context for ride sharing"
  described as {
    | The RideContext is the bounded context for
    | on-demand ride management.
  }
}
