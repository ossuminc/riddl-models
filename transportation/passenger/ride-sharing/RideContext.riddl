// Ride Sharing - Ride Context
context RideContext is {
  include "types.riddl"
  include "Ride.riddl"
  // Repository for ride persistence
  repository RideRepository is {
    schema RideData is relational
      of rides as type Ride
        index on field Ride.rideId
        index on field Ride.rider.riderId
        index on field Ride.status

    handler RidePersistence is {
      on command Ride.RequestRide is {
        prompt "Store new ride request"
      }
      on command Ride.AssignDriver is {
        tell event Ride.DriverAssigned to entity RideContext.Ride
        prompt "Update driver assignment"
      }
      on command Ride.DriverEnRoute is {
        tell event Ride.DriverIsEnRoute to entity RideContext.Ride
        prompt "Update driver location"
      }
      on command Ride.DriverArrived is {
        prompt "Update arrival status"
      }
      on command Ride.StartTrip is {
        tell event Ride.TripStarted to entity RideContext.Ride
        prompt "Update to in progress"
      }
      on command Ride.UpdateLocation is {
        tell event Ride.LocationUpdated to entity RideContext.Ride
        prompt "Store location update"
      }
      on command Ride.CompleteTrip is {
        tell event Ride.TripCompleted to entity RideContext.Ride
        prompt "Store trip completion"
      }
      on command Ride.ProcessPayment is {
        tell event Ride.PaymentProcessed to entity RideContext.Ride
        prompt "Store payment"
      }
      on command Ride.RateRide is {
        prompt "Store ratings"
      }
      on command Ride.CancelRide is {
        tell event Ride.RideCancelled to entity RideContext.Ride
        prompt "Update to cancelled"
      }
    } with {
      briefly "Persists ride commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Ride data persistence"
    described as {
      | The RideRepository provides persistent storage for
      | rides, trips, and ratings.
    }
  }
  // Projector for ride analytics
  projector RideAnalytics is {
    updates repository RideContext.RideRepository
    record RideStats is  {
      activeRides: Natural with {
        briefly "Active"
        described as {
          |Active rides.
        }
      }
      ridesCompletedToday: Natural with {
        briefly "Completed"
        described as {
          |Rides completed today.
        }
      }
      averageFare: Decimal(10,2) with {
        briefly "Avg fare"
        described as {
          |Average fare.
        }
      }
      averageRating: Decimal(2,1) with {
        briefly "Avg rating"
        described as {
          |Average driver rating.
        }
      }
      cancellationRate: Decimal(5,4) with {
        briefly "Cancellation"
        described as {
          |Cancellation rate.
        }
      }
      averageWaitTime: Natural with {
        briefly "Wait time"
        described as {
          |Average wait time (min).
        }
      }
    } with {
      briefly "Ride statistics"
      described as {
        |Ride-sharing metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Ride.RideRequested is {
        tell event Ride.RideRequested to repository RideContext.RideRepository
        prompt "Update request counts"
      }
      on event Ride.TripCompleted is {
        tell event Ride.TripCompleted to repository RideContext.RideRepository
        prompt "Update completion metrics"
      }
      on event Ride.RideRated is {
        tell event Ride.RideRated to repository RideContext.RideRepository
        prompt "Update rating metrics"
      }
      on event Ride.RideCancelled is {
        tell event Ride.RideCancelled to repository RideContext.RideRepository
        prompt "Update cancellation metrics"
      }
    } with {
      briefly "Maintains ride analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Ride analytics projections"
    described as {
      |Maintains ride-sharing analytics data.
    }
  }
  // ---- Event publication for Ride ----
  type RideEvent is one of {
    RideContext.Ride.RideRequested,
    RideContext.Ride.DriverAssigned,
    RideContext.Ride.DriverIsEnRoute,
    RideContext.Ride.DriverHasArrived,
    RideContext.Ride.TripStarted,
    RideContext.Ride.LocationUpdated,
    RideContext.Ride.TripCompleted,
    RideContext.Ride.PaymentProcessed,
    RideContext.Ride.RideRated,
    RideContext.Ride.RideCancelled
  } with {
    briefly "Ride event alternation"
    described as {
      |Union of all Ride events, for streaming and event-sourced
      |persistence.
    }
  }
  source RideEventSource is {
    outlet RideEvents is type RideEvent
    handler RideSourceHandler is {
      on event Ride.RideRequested is {
        send event Ride.RideRequested to outlet RideEvents
      }
      on event Ride.DriverAssigned is {
        send event Ride.DriverAssigned to outlet RideEvents
      }
      on event Ride.DriverIsEnRoute is {
        send event Ride.DriverIsEnRoute to outlet RideEvents
      }
      on event Ride.DriverHasArrived is {
        send event Ride.DriverHasArrived to outlet RideEvents
      }
      on event Ride.TripStarted is {
        send event Ride.TripStarted to outlet RideEvents
      }
      on event Ride.LocationUpdated is {
        send event Ride.LocationUpdated to outlet RideEvents
      }
      on event Ride.TripCompleted is {
        send event Ride.TripCompleted to outlet RideEvents
      }
      on event Ride.PaymentProcessed is {
        send event Ride.PaymentProcessed to outlet RideEvents
      }
      on event Ride.RideRated is {
        send event Ride.RideRated to outlet RideEvents
      }
      on event Ride.RideCancelled is {
        send event Ride.RideCancelled to outlet RideEvents
      }
      on other is {
        error "Unexpected message for source RideEventSource"
      }
    } with {
      briefly "Ride source handler"
      described as {
        |Publishes Ride events onto the outlet.
      }
    }
  } with {
    briefly "Ride event source"
    described as {
      |Publishes Ride entity events into the streaming topology.
    }
  }
  sink RideEventSink is {
    inlet RideInlet is type RideEvent
    handler RideSinkHandler is {
      on event Ride.RideRequested is {
        tell event Ride.RideRequested to repository RideContext.RideRepository
      }
      on event Ride.DriverAssigned is {
        tell event Ride.DriverAssigned to repository RideContext.RideRepository
      }
      on event Ride.DriverIsEnRoute is {
        tell event Ride.DriverIsEnRoute to repository RideContext.RideRepository
      }
      on event Ride.DriverHasArrived is {
        tell event Ride.DriverHasArrived to repository RideContext.RideRepository
      }
      on event Ride.TripStarted is {
        tell event Ride.TripStarted to repository RideContext.RideRepository
      }
      on event Ride.LocationUpdated is {
        tell event Ride.LocationUpdated to repository RideContext.RideRepository
      }
      on event Ride.TripCompleted is {
        tell event Ride.TripCompleted to repository RideContext.RideRepository
      }
      on event Ride.PaymentProcessed is {
        tell event Ride.PaymentProcessed to repository RideContext.RideRepository
      }
      on event Ride.RideRated is {
        tell event Ride.RideRated to repository RideContext.RideRepository
      }
      on event Ride.RideCancelled is {
        tell event Ride.RideCancelled to repository RideContext.RideRepository
      }
      on other is {
        error "Unexpected message for sink RideEventSink"
      }
    } with {
      briefly "Ride sink handler"
      described as {
        |Persists Ride events via the repository.
      }
    }
  } with {
    briefly "Ride event sink"
    described as {
      |Receives Ride events for persistence.
    }
  }
  connector RideEventFlow is {
    from outlet RideContext.RideEventSource.RideEvents to
      inlet RideContext.RideEventSink.RideInlet
  } with {
    briefly "Ride event flow"
    described as {
      |Connects the Ride source to its sink.
    }
  }
} with {
  briefly "Bounded context for ride sharing"
  described as {
    | The RideContext is the bounded context for
    | on-demand ride management.
  }
}
