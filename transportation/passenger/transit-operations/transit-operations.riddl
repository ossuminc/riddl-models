// Transit Operations Domain Model
// Public transit fleet and service management
domain TransitOperations is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Dispatcher is "person managing transit operations" with {
    briefly "Dispatcher"
    described as {
      |Operations center staff managing service.
    }
  }
  user Operator is "person driving transit vehicle" with {
    briefly "Operator"
    described as {
      |Bus or train operator.
    }
  }
  user ServicePlanner is "person planning transit schedules" with {
    briefly "Service Planner"
    described as {
      |Staff planning routes and schedules.
    }
  }
  epic TransitEpic is {
    user Dispatcher wants to "to monitor transit operations" so that "service runs on schedule"
    case ManageService is {
      user Dispatcher wants to "to manage daily transit service" so that "riders get reliable service"
      step is "Dispatcher monitors" "vehicle locations" "in real-time" with {
        briefly "Monitor"
        described as {
          |Track vehicles.
        }
      }
      step take input TransitOperationsApp.TransitOperationsScreen.UpdateLocationInput from user Operator with {
        briefly "Update location"
        described as {
          |Report position.
        }
      }
      step is "System detects" "delays and issues" "automatically" with {
        briefly "Detect issues"
        described as {
          |Identify problems.
        }
      }
    } with {
      briefly "Manage service"
      described as {
        |Daily operations workflow.
      }
    }
  } with {
    briefly "Transit operations"
    described as {
      | Epic covering vehicle tracking, schedule adherence,
      | and service management.
    }
  }
  include "VehicleContext.riddl"
  include "external-contexts.riddl"
  application context TransitOperationsApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in TransitOperations are delivered.
      }
    }
    group TransitOperationsScreen is {
      input UpdateLocationInput acquires command VehicleContext.Vehicle.UpdateLocation with {
        briefly "Update location control"
        described as {
          |The control through which a user submits the update location request.
        }
      }
    } with {
      briefly "Transit operations screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppVehicleCommands is type VehicleContext.Vehicle.VehicleCommand
    inlet AppVehicleRepositoryResponses is type VehicleContext.Vehicle.VehicleResult    handler TransitOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context TransitOperationsApp"
      }
    } with {
      briefly "TransitOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "TransitOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'VehicleCommand Stream' is from outlet TransitOperationsApp.AppVehicleCommands to inlet VehicleContext.VehicleCommandStreamIn with {
    briefly "Vehicle commands from the application"
  }
  persistent connector 'VehicleResult Stream' is from outlet VehicleContext.VehicleResultStreamOut to inlet TransitOperationsApp.AppVehicleRepositoryResponses with {
    briefly "Vehicle query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet TransitOperationsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term ServiceDelay is  "A detected delay in scheduled service, raised automatically." 
  briefly "Transit operations domain"
  described as {
    | The TransitOperations domain handles public
    | transit service management.
  }
}
