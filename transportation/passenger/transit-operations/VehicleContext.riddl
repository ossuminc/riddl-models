// Transit Operations - Vehicle Context
context VehicleContext is {
  include "types.riddl"
  include "Vehicle.riddl"
  // Repository for vehicle persistence
  repository VehicleRepository is {
    inlet VehicleRepositoryFromVehicle is type VehicleEvent
    inlet VehicleRepositoryFromTransitAnalytics is type VehicleEvent
    outlet VehicleRepositoryResponses is type Vehicle.VehicleResult
    schema VehicleData is relational
      of vehicles as type Vehicle
        index on field Vehicle.vehicleId
        index on field Vehicle.info.vehicleNumber
        index on field Vehicle.currentTrip.routeId
        index on field Vehicle.status

    handler VehiclePersistence is {
      on command Vehicle.RegisterVehicle is {
        prompt "Store new vehicle"
      }
      on command Vehicle.UpdateVehicleInfo is {
        tell event Vehicle.VehicleInfoUpdated to entity VehicleContext.Vehicle
        prompt "Update vehicle info"
      }
      on command Vehicle.AssignOperator is {
        tell event Vehicle.OperatorAssigned to entity VehicleContext.Vehicle
        prompt "Store operator assignment"
      }
      on command Vehicle.AssignTrip is {
        tell event Vehicle.TripAssigned to entity VehicleContext.Vehicle
        prompt "Store trip assignment"
      }
      on command Vehicle.UpdateLocation is {
        tell event Vehicle.LocationUpdated to entity VehicleContext.Vehicle
        prompt "Store position update"
      }
      on command Vehicle.RecordStopEvent is {
        tell event Vehicle.StopEventRecorded to entity VehicleContext.Vehicle
        prompt "Store stop event"
      }
      on command Vehicle.UpdatePassengerLoad is {
        tell event Vehicle.PassengerLoadUpdated to entity VehicleContext.Vehicle
        prompt "Store passenger count"
      }
      on command Vehicle.ReportIncident is {
        prompt "Store incident"
      }
      on command Vehicle.CompleteTrip is {
        tell event Vehicle.TripCompleted to entity VehicleContext.Vehicle
        prompt "Update trip to completed"
      }
      on command Vehicle.SetVehicleStatus is {
        prompt "Update vehicle status"
      }
      on command Vehicle.PullFromService is {
        prompt "Update to out of service"
      }
      on command Vehicle.ReturnToService is {
        prompt "Update to in service"
      }
    } with {
      briefly "Persists vehicle commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Vehicle data persistence"
    described as {
      | The VehicleRepository provides persistent storage
      | for transit vehicles.
    }
  }
  // Projector for transit analytics
  projector TransitAnalytics is {
    inlet TransitAnalyticsFromVehicle is type VehicleEvent
    outlet TransitAnalyticsOut is type VehicleEvent
    updates repository VehicleContext.VehicleRepository
    record TransitStats is  {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      totalTrips: Natural with {
        briefly "Trips"
        described as {
          |Total trips.
        }
      }
      completedTrips: Natural with {
        briefly "Completed"
        described as {
          |Completed trips.
        }
      }
      onTimePercent: Decimal(5,2) with {
        briefly "On-time"
        described as {
          |On-time percentage.
        }
      }
      totalRidership: Natural with {
        briefly "Ridership"
        described as {
          |Total riders.
        }
      }
      averageLoad: Decimal(5,2) with {
        briefly "Avg load"
        described as {
          |Average load percent.
        }
      }
      incidentCount: Natural with {
        briefly "Incidents"
        described as {
          |Incident count.
        }
      }
      vehiclesInService: Natural with {
        briefly "In service"
        described as {
          |Vehicles in service.
        }
      }
    } with {
      briefly "Transit statistics"
      described as {
        |Daily transit metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Vehicle.TripAssigned is {
        tell event Vehicle.TripAssigned to repository VehicleContext.VehicleRepository
        prompt "Update trip count"
      }
      on event Vehicle.TripCompleted is {
        tell event Vehicle.TripCompleted to repository VehicleContext.VehicleRepository
        prompt "Update completion metrics"
      }
      on event Vehicle.StopEventRecorded is {
        tell event Vehicle.StopEventRecorded to repository VehicleContext.VehicleRepository
        prompt "Update schedule adherence"
      }
      on event Vehicle.PassengerLoadUpdated is {
        tell event Vehicle.PassengerLoadUpdated to repository VehicleContext.VehicleRepository
        prompt "Update ridership metrics"
      }
      on event Vehicle.IncidentReported is {
        tell event Vehicle.IncidentReported to repository VehicleContext.VehicleRepository
        prompt "Update incident metrics"
      }
    } with {
      briefly "Maintains transit analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Transit analytics projections"
    described as {
      |Maintains transit performance analytics.
    }
  }
  // ---- Event publication for Vehicle ----
  type VehicleEvent is one of {
    VehicleContext.Vehicle.VehicleRegistered,
    VehicleContext.Vehicle.VehicleInfoUpdated,
    VehicleContext.Vehicle.OperatorAssigned,
    VehicleContext.Vehicle.TripAssigned,
    VehicleContext.Vehicle.LocationUpdated,
    VehicleContext.Vehicle.StopEventRecorded,
    VehicleContext.Vehicle.PassengerLoadUpdated,
    VehicleContext.Vehicle.IncidentReported,
    VehicleContext.Vehicle.TripCompleted,
    VehicleContext.Vehicle.VehicleStatusChanged,
    VehicleContext.Vehicle.VehiclePulledFromService,
    VehicleContext.Vehicle.VehicleReturnedToService
  } with {
    briefly "Vehicle event alternation"
    described as {
      |Union of all Vehicle events, for streaming and event-sourced
      |persistence.
    }
  }
  processor VehicleEventSource as source is {
    outlet VehicleEvents is type VehicleEvent
    handler VehicleSourceHandler is {
      on event Vehicle.VehicleRegistered is {
        send event Vehicle.VehicleRegistered to outlet VehicleEvents
      }
      on event Vehicle.VehicleInfoUpdated is {
        send event Vehicle.VehicleInfoUpdated to outlet VehicleEvents
      }
      on event Vehicle.OperatorAssigned is {
        send event Vehicle.OperatorAssigned to outlet VehicleEvents
      }
      on event Vehicle.TripAssigned is {
        send event Vehicle.TripAssigned to outlet VehicleEvents
      }
      on event Vehicle.LocationUpdated is {
        send event Vehicle.LocationUpdated to outlet VehicleEvents
      }
      on event Vehicle.StopEventRecorded is {
        send event Vehicle.StopEventRecorded to outlet VehicleEvents
      }
      on event Vehicle.PassengerLoadUpdated is {
        send event Vehicle.PassengerLoadUpdated to outlet VehicleEvents
      }
      on event Vehicle.IncidentReported is {
        send event Vehicle.IncidentReported to outlet VehicleEvents
      }
      on event Vehicle.TripCompleted is {
        send event Vehicle.TripCompleted to outlet VehicleEvents
      }
      on event Vehicle.VehicleStatusChanged is {
        send event Vehicle.VehicleStatusChanged to outlet VehicleEvents
      }
      on event Vehicle.VehiclePulledFromService is {
        send event Vehicle.VehiclePulledFromService to outlet VehicleEvents
      }
      on event Vehicle.VehicleReturnedToService is {
        send event Vehicle.VehicleReturnedToService to outlet VehicleEvents
      }
      on other is {
        error "Unexpected message for source VehicleEventSource"
      }
    } with {
      briefly "Vehicle source handler"
      described as {
        |Publishes Vehicle events onto the outlet.
      }
    }
  } with {
    briefly "Vehicle event source"
    described as {
      |Publishes Vehicle entity events into the streaming topology.
    }
  }
  processor VehicleEventSink as sink is {
    inlet VehicleInlet is type VehicleEvent
    handler VehicleSinkHandler is {
      on event Vehicle.VehicleRegistered is {
        tell event Vehicle.VehicleRegistered to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.VehicleInfoUpdated is {
        tell event Vehicle.VehicleInfoUpdated to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.OperatorAssigned is {
        tell event Vehicle.OperatorAssigned to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.TripAssigned is {
        tell event Vehicle.TripAssigned to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.LocationUpdated is {
        tell event Vehicle.LocationUpdated to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.StopEventRecorded is {
        tell event Vehicle.StopEventRecorded to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.PassengerLoadUpdated is {
        tell event Vehicle.PassengerLoadUpdated to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.IncidentReported is {
        tell event Vehicle.IncidentReported to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.TripCompleted is {
        tell event Vehicle.TripCompleted to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.VehicleStatusChanged is {
        tell event Vehicle.VehicleStatusChanged to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.VehiclePulledFromService is {
        tell event Vehicle.VehiclePulledFromService to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.VehicleReturnedToService is {
        tell event Vehicle.VehicleReturnedToService to repository VehicleContext.VehicleRepository
      }
      on other is {
        error "Unexpected message for sink VehicleEventSink"
      }
    } with {
      briefly "Vehicle sink handler"
      described as {
        |Persists Vehicle events via the repository.
      }
    }
  } with {
    briefly "Vehicle event sink"
    described as {
      |Receives Vehicle events for persistence.
    }
  }
  connector VehicleEventFlow is {
    from outlet VehicleContext.VehicleEventSource.VehicleEvents to
      inlet VehicleContext.VehicleEventSink.VehicleInlet
  } with {
    briefly "Vehicle event flow"
    described as {
      |Connects the Vehicle source to its sink.
    }
  }
  processor VehicleEventSplit is {
    inlet VehicleEventSplitIn is type VehicleEvent
    outlet VehicleEventSplitToVehicleRepository is type VehicleEvent
    outlet VehicleEventSplitToTransitAnalytics is type VehicleEvent
    handler VehicleEventSplitHandler is {
      on event Vehicle.VehicleRegistered is {
        send event Vehicle.VehicleRegistered to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.VehicleRegistered to outlet VehicleEventSplitToTransitAnalytics
        tell event Vehicle.VehicleRegistered to entity VehicleContext.Vehicle
      }
      on event Vehicle.VehicleInfoUpdated is {
        send event Vehicle.VehicleInfoUpdated to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.VehicleInfoUpdated to outlet VehicleEventSplitToTransitAnalytics
        tell event Vehicle.VehicleInfoUpdated to entity VehicleContext.Vehicle
      }
      on event Vehicle.OperatorAssigned is {
        send event Vehicle.OperatorAssigned to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.OperatorAssigned to outlet VehicleEventSplitToTransitAnalytics
        tell event Vehicle.OperatorAssigned to entity VehicleContext.Vehicle
      }
      on event Vehicle.TripAssigned is {
        send event Vehicle.TripAssigned to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.TripAssigned to outlet VehicleEventSplitToTransitAnalytics
        tell event Vehicle.TripAssigned to entity VehicleContext.Vehicle
      }
      on event Vehicle.LocationUpdated is {
        send event Vehicle.LocationUpdated to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.LocationUpdated to outlet VehicleEventSplitToTransitAnalytics
        tell event Vehicle.LocationUpdated to entity VehicleContext.Vehicle
      }
      on event Vehicle.StopEventRecorded is {
        send event Vehicle.StopEventRecorded to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.StopEventRecorded to outlet VehicleEventSplitToTransitAnalytics
        tell event Vehicle.StopEventRecorded to entity VehicleContext.Vehicle
      }
      on event Vehicle.PassengerLoadUpdated is {
        send event Vehicle.PassengerLoadUpdated to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.PassengerLoadUpdated to outlet VehicleEventSplitToTransitAnalytics
        tell event Vehicle.PassengerLoadUpdated to entity VehicleContext.Vehicle
      }
      on event Vehicle.IncidentReported is {
        send event Vehicle.IncidentReported to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.IncidentReported to outlet VehicleEventSplitToTransitAnalytics
        tell event Vehicle.IncidentReported to entity VehicleContext.Vehicle
      }
      on event Vehicle.TripCompleted is {
        send event Vehicle.TripCompleted to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.TripCompleted to outlet VehicleEventSplitToTransitAnalytics
        tell event Vehicle.TripCompleted to entity VehicleContext.Vehicle
      }
      on event Vehicle.VehicleStatusChanged is {
        send event Vehicle.VehicleStatusChanged to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.VehicleStatusChanged to outlet VehicleEventSplitToTransitAnalytics
        tell event Vehicle.VehicleStatusChanged to entity VehicleContext.Vehicle
      }
      on event Vehicle.VehiclePulledFromService is {
        send event Vehicle.VehiclePulledFromService to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.VehiclePulledFromService to outlet VehicleEventSplitToTransitAnalytics
        tell event Vehicle.VehiclePulledFromService to entity VehicleContext.Vehicle
      }
      on event Vehicle.VehicleReturnedToService is {
        send event Vehicle.VehicleReturnedToService to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.VehicleReturnedToService to outlet VehicleEventSplitToTransitAnalytics
        tell event Vehicle.VehicleReturnedToService to entity VehicleContext.Vehicle
      }
      on other is {
        error "Unexpected message for processor VehicleEventSplit"
      }
    } with {
      briefly "Vehicle event fan-out handler"
      described as {
        |Delivers each Vehicle event to all of its consumers.
      }
    }
  } with {
    briefly "Vehicle event fan-out"
    described as {
      |Fans Vehicle events out to the repository and projectors.
    }
  }
  connector LinkVehicleToVehicleEventSplit is {
    from outlet VehicleContext.Vehicle.VehicleEvents2 to
      inlet VehicleContext.VehicleEventSplit.VehicleEventSplitIn
  } with {
    briefly "LinkVehicleToVehicleEventSplit"
  }
  connector LinkVehicleEventSplitToVehicleRepository is {
    from outlet VehicleContext.VehicleEventSplit.VehicleEventSplitToVehicleRepository to
      inlet VehicleContext.VehicleRepository.VehicleRepositoryFromVehicle
  } with {
    briefly "LinkVehicleEventSplitToVehicleRepository"
  }
  connector LinkVehicleEventSplitToTransitAnalytics is {
    from outlet VehicleContext.VehicleEventSplit.VehicleEventSplitToTransitAnalytics to
      inlet VehicleContext.TransitAnalytics.TransitAnalyticsFromVehicle
  } with {
    briefly "LinkVehicleEventSplitToTransitAnalytics"
  }
  connector LinkTransitAnalyticsToVehicleRepository is {
    from outlet VehicleContext.TransitAnalytics.TransitAnalyticsOut to
      inlet VehicleContext.VehicleRepository.VehicleRepositoryFromTransitAnalytics
  } with {
    briefly "LinkTransitAnalyticsToVehicleRepository"
  }
} with {
  briefly "Bounded context for transit vehicles"
  described as {
    | The VehicleContext is the bounded context for
    | transit vehicle operations.
  }
}
