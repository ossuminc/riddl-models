// Transit Operations - Vehicle Context
context VehicleContext as router is {
  inlet VehicleCommandStreamIn is type VehicleCommand  outlet VehicleCommandStreamOut is type VehicleCommand
  inlet VehicleResultStreamIn is result Vehicle.VehicleResult  outlet VehicleResultStreamOut is result Vehicle.VehicleResult
  handler VehicleContextBoundary is {
    on registerVehicle: command Vehicle.RegisterVehicle is {
      send registerVehicle to outlet VehicleContext.VehicleCommandStreamOut
    }
    on updateVehicleInfo: command Vehicle.UpdateVehicleInfo is {
      send updateVehicleInfo to outlet VehicleContext.VehicleCommandStreamOut
    }
    on assignOperator: command Vehicle.AssignOperator is {
      send assignOperator to outlet VehicleContext.VehicleCommandStreamOut
    }
    on assignTrip: command Vehicle.AssignTrip is {
      send assignTrip to outlet VehicleContext.VehicleCommandStreamOut
    }
    on updateLocation: command Vehicle.UpdateLocation is {
      send updateLocation to outlet VehicleContext.VehicleCommandStreamOut
    }
    on recordStopEvent: command Vehicle.RecordStopEvent is {
      send recordStopEvent to outlet VehicleContext.VehicleCommandStreamOut
    }
    on updatePassengerLoad: command Vehicle.UpdatePassengerLoad is {
      send updatePassengerLoad to outlet VehicleContext.VehicleCommandStreamOut
    }
    on reportIncident: command Vehicle.ReportIncident is {
      send reportIncident to outlet VehicleContext.VehicleCommandStreamOut
    }
    on completeTrip: command Vehicle.CompleteTrip is {
      send completeTrip to outlet VehicleContext.VehicleCommandStreamOut
    }
    on setVehicleStatus: command Vehicle.SetVehicleStatus is {
      send setVehicleStatus to outlet VehicleContext.VehicleCommandStreamOut
    }
    on pullFromService: command Vehicle.PullFromService is {
      send pullFromService to outlet VehicleContext.VehicleCommandStreamOut
    }
    on returnToService: command Vehicle.ReturnToService is {
      send returnToService to outlet VehicleContext.VehicleCommandStreamOut
    }
    on vehicleResult: result Vehicle.VehicleResult is {
      send vehicleResult to outlet VehicleContext.VehicleResultStreamOut
    }
    on other is {
      error "Unexpected message at the VehicleContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'VehicleCommand Stream Intake' is from outlet VehicleContext.VehicleCommandStreamOut to inlet VehicleContext.Vehicle.VehicleCommands  connector 'VehicleResult Stream Egress' is from outlet VehicleContext.VehicleRepository.VehicleRepositoryResponses to inlet VehicleContext.VehicleResultStreamIn  adaptor FromCADService from context CADService is { 
    inlet FromCADServiceIn is type CADService.CADServiceEvent    handler FromCADServiceHandler is {
      on operatorMessageSent: event CADService.OperatorMessageSent is {
        do "the operator has the message; reporting the incident was recorded here"
      }
      on vehicleDispatched: event CADService.VehicleDispatched is {
        do "the vehicle is dispatched; assigning the trip was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromCADService"
      }
    } with {
      briefly "from cad service"
      described as {
        |Carries messages from the external CADService.
      }
    }
  } with {
    briefly "CADService integration"
    described as {
      |The model's side of the CADService conversation.
    }
  }
  adaptor ToCADService to context CADService as flow is { 
    outlet ToCADServiceOut is type CADService.CADServiceCommand
    handler ToCADServiceHandler is {
      on tripAssigned: event Vehicle.TripAssigned is {
        let askAnswer: type CADService.ActiveVehiclesResult = ask query CADService.GetActiveVehicles of context CADService
        do "assigning a trip needing to know which vehicles are actually running"
        let item0: type CADService.DispatchVehicle = prompt("translate the tripAssigned event into a DispatchVehicle, an assigned trip being what puts a bus on the road")
        send item0 to outlet VehicleContext.ToCADService.ToCADServiceOut
      }
      on incidentReported: event Vehicle.IncidentReported is {
        let item0: type CADService.SendOperatorMessage = prompt("translate the incidentReported event into a SendOperatorMessage, an incident being what the operator must be told about")
        send item0 to outlet VehicleContext.ToCADService.ToCADServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToCADService"
      }
    } with {
      briefly "to cad service"
      described as {
        |Carries messages to the external CADService.
      }
    }
  } with {
    briefly "CADService integration"
    described as {
      |The model's side of the CADService conversation.
    }
  }
  adaptor FromEmergencyService from context EmergencyService is { 
    inlet FromEmergencyServiceIn is type EmergencyService.EmergencyServiceEvent    handler FromEmergencyServiceHandler is {
      on emergencyAlertTriggered: event EmergencyService.EmergencyAlertTriggered is {
        do "responders have been alerted; reporting the incident was recorded here"
      }
      on emergencyResolved: event EmergencyService.EmergencyResolved is {
        do "the emergency is over; returning the vehicle to service is dispatch's call"
      }
      on other is {
        error "Unexpected message for adaptor FromEmergencyService"
      }
    } with {
      briefly "from emergency service"
      described as {
        |Carries messages from the external EmergencyService.
      }
    }
  } with {
    briefly "EmergencyService integration"
    described as {
      |The model's side of the EmergencyService conversation.
    }
  }
  adaptor ToEmergencyService to context EmergencyService as flow is { 
    outlet ToEmergencyServiceOut is command EmergencyService.TriggerEmergencyAlert
    handler ToEmergencyServiceHandler is {
      on incidentReported: event Vehicle.IncidentReported is {
        let item0: type EmergencyService.TriggerEmergencyAlert = prompt("translate the incidentReported event into a TriggerEmergencyAlert, the same incident being what emergency services are called for")
        send item0 to outlet VehicleContext.ToEmergencyService.ToEmergencyServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToEmergencyService"
      }
    } with {
      briefly "to emergency service"
      described as {
        |Carries messages to the external EmergencyService.
      }
    }
  } with {
    briefly "EmergencyService integration"
    described as {
      |The model's side of the EmergencyService conversation.
    }
  }
  adaptor FromFareCollectionService from context FareCollectionService is { 
    inlet FromFareCollectionServiceIn is event FareCollectionService.FareValidated    handler FromFareCollectionServiceHandler is {
      on fareValidated: event FareCollectionService.FareValidated is {
        do "a fare was tapped; the passenger load is counted at the stop"
      }
      on other is {
        error "Unexpected message for adaptor FromFareCollectionService"
      }
    } with {
      briefly "from fare collection service"
      described as {
        |Carries messages from the external FareCollectionService.
      }
    }
  } with {
    briefly "FareCollectionService integration"
    described as {
      |The model's side of the FareCollectionService conversation.
    }
  }
  adaptor ToFareCollectionService to context FareCollectionService as flow is { 
    outlet ToFareCollectionServiceOut is query FareCollectionService.GetVehicleFareTotal
    handler ToFareCollectionServiceHandler is {
      on tripCompleted: event Vehicle.TripCompleted is {
        let askAnswer: type FareCollectionService.VehicleFareTotalResult = ask query FareCollectionService.GetVehicleFareTotal of context FareCollectionService
        do "a completed trip needing the fares taken on it"
      }
      on other is {
        error "Unexpected message for adaptor ToFareCollectionService"
      }
    } with {
      briefly "to fare collection service"
      described as {
        |Carries messages to the external FareCollectionService.
      }
    }
  } with {
    briefly "FareCollectionService integration"
    described as {
      |The model's side of the FareCollectionService conversation.
    }
  }
  adaptor FromMaintenanceService from context MaintenanceService is { 
    inlet FromMaintenanceServiceIn is type MaintenanceService.MaintenanceServiceEvent    handler FromMaintenanceServiceHandler is {
      on defectReportCreated: event MaintenanceService.DefectReportCreated is {
        do "maintenance has the defect; pulling the vehicle was recorded here"
      }
      on vehicleClearedForService: event MaintenanceService.VehicleClearedForService is {
        do "maintenance has cleared it; returning it to service is dispatch's call"
      }
      on other is {
        error "Unexpected message for adaptor FromMaintenanceService"
      }
    } with {
      briefly "from maintenance service"
      described as {
        |Carries messages from the external MaintenanceService.
      }
    }
  } with {
    briefly "MaintenanceService integration"
    described as {
      |The model's side of the MaintenanceService conversation.
    }
  }
  adaptor ToMaintenanceService to context MaintenanceService as flow is { 
    outlet ToMaintenanceServiceOut is type MaintenanceService.MaintenanceServiceRequest
    handler ToMaintenanceServiceHandler is {
      on tripAssigned: event Vehicle.TripAssigned is {
        let askAnswer: type MaintenanceService.MaintenanceStatusResult = ask query MaintenanceService.GetVehicleMaintenanceStatus of context MaintenanceService
        do "a trip assignment needing the vehicle to be fit to run it"
      }
      on vehiclePulledFromService: event Vehicle.VehiclePulledFromService is {
        let item0: type MaintenanceService.CreateDefectReport = prompt("translate the vehiclePulledFromService event into a CreateDefectReport, a vehicle pulled from service being what a defect report explains")
        send item0 to outlet VehicleContext.ToMaintenanceService.ToMaintenanceServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToMaintenanceService"
      }
    } with {
      briefly "to maintenance service"
      described as {
        |Carries messages to the external MaintenanceService.
      }
    }
  } with {
    briefly "MaintenanceService integration"
    described as {
      |The model's side of the MaintenanceService conversation.
    }
  }
  adaptor FromPassengerInformationService from context PassengerInformationService is { 
    inlet FromPassengerInformationServiceIn is type PassengerInformationService.PassengerInformationServiceEvent    handler FromPassengerInformationServiceHandler is {
      on arrivalPredictionPublished: event PassengerInformationService.ArrivalPredictionPublished is {
        do "riders can see the prediction; the stop event was recorded here"
      }
      on serviceAlertPublished: event PassengerInformationService.ServiceAlertPublished is {
        do "riders can see the alert; the incident was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromPassengerInformationService"
      }
    } with {
      briefly "from passenger information service"
      described as {
        |Carries messages from the external PassengerInformationService.
      }
    }
  } with {
    briefly "PassengerInformationService integration"
    described as {
      |The model's side of the PassengerInformationService conversation.
    }
  }
  adaptor ToPassengerInformationService to context PassengerInformationService as flow is { 
    outlet ToPassengerInformationServiceOut is type PassengerInformationService.PassengerInformationServiceCommand
    handler ToPassengerInformationServiceHandler is {
      on stopEventRecorded: event Vehicle.StopEventRecorded is {
        let item0: type PassengerInformationService.PublishArrivalPrediction = prompt("translate the stopEventRecorded event into a PublishArrivalPrediction, a stop event being what a prediction is recomputed from")
        send item0 to outlet VehicleContext.ToPassengerInformationService.ToPassengerInformationServiceOut
      }
      on incidentReported: event Vehicle.IncidentReported is {
        let item0: type PassengerInformationService.PublishServiceAlert = prompt("translate the incidentReported event into a PublishServiceAlert, an incident being what passengers must be warned of")
        send item0 to outlet VehicleContext.ToPassengerInformationService.ToPassengerInformationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToPassengerInformationService"
      }
    } with {
      briefly "to passenger information service"
      described as {
        |Carries messages to the external PassengerInformationService.
      }
    }
  } with {
    briefly "PassengerInformationService integration"
    described as {
      |The model's side of the PassengerInformationService conversation.
    }
  }
  adaptor FromScheduleService from context ScheduleService is { 
    inlet FromScheduleServiceIn is event ScheduleService.ScheduleChanged    handler FromScheduleServiceHandler is {
      on scheduleChanged: event ScheduleService.ScheduleChanged is {
        do "the schedule changed; which vehicle takes which trip is dispatch's act"
      }
      on other is {
        error "Unexpected message for adaptor FromScheduleService"
      }
    } with {
      briefly "from schedule service"
      described as {
        |Carries messages from the external ScheduleService.
      }
    }
  } with {
    briefly "ScheduleService integration"
    described as {
      |The model's side of the ScheduleService conversation.
    }
  }
  adaptor ToScheduleService to context ScheduleService as flow is { 
    outlet ToScheduleServiceOut is type ScheduleService.ScheduleServiceRequest
    handler ToScheduleServiceHandler is {
      on stopEventRecorded: event Vehicle.StopEventRecorded is {
        let askAnswer: type ScheduleService.StopTimesResult = ask query ScheduleService.GetStopTimes of context ScheduleService
        do "a stop event needing the scheduled time to measure lateness against"
      }
      on tripAssigned: event Vehicle.TripAssigned is {
        let askAnswer: type ScheduleService.ScheduleResult = ask query ScheduleService.GetTodaySchedule of context ScheduleService
        do "an assigned trip needing today's schedule it must run to"
      }
      on other is {
        error "Unexpected message for adaptor ToScheduleService"
      }
    } with {
      briefly "to schedule service"
      described as {
        |Carries messages to the external ScheduleService.
      }
    }
  } with {
    briefly "ScheduleService integration"
    described as {
      |The model's side of the ScheduleService conversation.
    }
  }
  include "types.riddl"
  include "Vehicle.riddl"
  // Repository for vehicle persistence
  type VehicleRepositoryCommand is one of {
    VehicleContext.VehicleRepository.PersistIncidentReported or VehicleContext.VehicleRepository.PersistLocationUpdated or VehicleContext.VehicleRepository.PersistOperatorAssigned or VehicleContext.VehicleRepository.PersistPassengerLoadUpdated or VehicleContext.VehicleRepository.PersistStopEventRecorded or VehicleContext.VehicleRepository.PersistTripAssigned or VehicleContext.VehicleRepository.PersistTripCompleted or VehicleContext.VehicleRepository.PersistVehicleInfoUpdated or VehicleContext.VehicleRepository.PersistVehiclePulledFromService or VehicleContext.VehicleRepository.PersistVehicleRegistered or VehicleContext.VehicleRepository.PersistVehicleReturnedToService or VehicleContext.VehicleRepository.PersistVehicleStatusChanged
  } with {
    briefly "Anything that writes VehicleRepository"
    described as {
      |The persistence commands VehicleRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository VehicleRepository as flow is {
    inlet VehicleRepositoryFromTransitAnalytics is type VehicleRepositoryCommand    command PersistLocationUpdated is {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row LocationUpdated applies to.
        }
      }
    } with {
      briefly "Persist LocationUpdated"
      described as {
        |Instructs this repository to apply LocationUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOperatorAssigned is {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row OperatorAssigned applies to.
        }
      }
    } with {
      briefly "Persist OperatorAssigned"
      described as {
        |Instructs this repository to apply OperatorAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVehicleInfoUpdated is {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row VehicleInfoUpdated applies to.
        }
      }
    } with {
      briefly "Persist VehicleInfoUpdated"
      described as {
        |Instructs this repository to apply VehicleInfoUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVehiclePulledFromService is {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row VehiclePulledFromService applies to.
        }
      }
    } with {
      briefly "Persist VehiclePulledFromService"
      described as {
        |Instructs this repository to apply VehiclePulledFromService to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVehicleRegistered is {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row VehicleRegistered applies to.
        }
      }
    } with {
      briefly "Persist VehicleRegistered"
      described as {
        |Instructs this repository to apply VehicleRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVehicleReturnedToService is {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row VehicleReturnedToService applies to.
        }
      }
    } with {
      briefly "Persist VehicleReturnedToService"
      described as {
        |Instructs this repository to apply VehicleReturnedToService to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVehicleStatusChanged is {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row VehicleStatusChanged applies to.
        }
      }
    } with {
      briefly "Persist VehicleStatusChanged"
      described as {
        |Instructs this repository to apply VehicleStatusChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIncidentReported is {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row IncidentReported applies to.
        }
      }
    } with {
      briefly "Persist IncidentReported"
      described as {
        |Instructs this repository to apply IncidentReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPassengerLoadUpdated is {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row PassengerLoadUpdated applies to.
        }
      }
    } with {
      briefly "Persist PassengerLoadUpdated"
      described as {
        |Instructs this repository to apply PassengerLoadUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStopEventRecorded is {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row StopEventRecorded applies to.
        }
      }
    } with {
      briefly "Persist StopEventRecorded"
      described as {
        |Instructs this repository to apply StopEventRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTripAssigned is {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row TripAssigned applies to.
        }
      }
    } with {
      briefly "Persist TripAssigned"
      described as {
        |Instructs this repository to apply TripAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTripCompleted is {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row TripCompleted applies to.
        }
      }
    } with {
      briefly "Persist TripCompleted"
      described as {
        |Instructs this repository to apply TripCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet VehicleRepositoryResponses is result Vehicle.VehicleResult
    record StoredVehicle is {
      vehicleId: VehicleId with {
        briefly "vehicleId"
        described as {
          |The vehicleId column of the stored vehicle row.
        }
      }
      currentTrip: TripAssignment? with {
        briefly "currentTrip"
        described as {
          |The currentTrip column of the stored vehicle row.
        }
      }
      info: VehicleInfo with {
        briefly "info"
        described as {
          |The info column of the stored vehicle row.
        }
      }
      status: VehicleStatus with {
        briefly "status"
        described as {
          |The status column of the stored vehicle row.
        }
      }
    } with {
      briefly "Stored vehicle row"
      described as {
        |The persistence shape of vehicle data as this repository stores it.
      }
    }
    schema VehicleData is relational
      of vehicles as record StoredVehicle
        index on field StoredVehicle.vehicleId
        index on field StoredVehicle.info.vehicleNumber
        index on field StoredVehicle.currentTrip.routeId
        index on field StoredVehicle.status
 with {
      briefly "Vehicle data schema"
      described as {
        |The relational schema holding vehicle data for the VehicleRepository.
      }
    }
    handler VehiclePersistence is {
      on persistLocationUpdated: command PersistLocationUpdated is {
        do "apply LocationUpdated to the stored row"
      }
      on persistOperatorAssigned: command PersistOperatorAssigned is {
        do "apply OperatorAssigned to the stored row"
      }
      on persistVehicleInfoUpdated: command PersistVehicleInfoUpdated is {
        do "apply VehicleInfoUpdated to the stored row"
      }
      on persistVehiclePulledFromService: command PersistVehiclePulledFromService is {
        do "apply VehiclePulledFromService to the stored row"
      }
      on persistVehicleRegistered: command PersistVehicleRegistered is {
        do "apply VehicleRegistered to the stored row"
      }
      on persistVehicleReturnedToService: command PersistVehicleReturnedToService is {
        do "apply VehicleReturnedToService to the stored row"
      }
      on persistVehicleStatusChanged: command PersistVehicleStatusChanged is {
        do "apply VehicleStatusChanged to the stored row"
      }
      on persistIncidentReported: command PersistIncidentReported is {
        do "apply IncidentReported to the stored row"
      }
      on persistPassengerLoadUpdated: command PersistPassengerLoadUpdated is {
        do "apply PassengerLoadUpdated to the stored row"
      }
      on persistStopEventRecorded: command PersistStopEventRecorded is {
        do "apply StopEventRecorded to the stored row"
      }
      on persistTripAssigned: command PersistTripAssigned is {
        do "apply TripAssigned to the stored row"
      }
      on persistTripCompleted: command PersistTripCompleted is {
        do "apply TripCompleted to the stored row"
      }
      on query GetTransitStats is {
        let transitStatsView: type TransitStatsView = prompt("read the transit stats projection")
        reply transitStatsView
      }
    } with {
      briefly "Persists vehicle commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Vehicle data persistence"
    described as {
      | The VehicleRepository provides persistent storage
      | for transit vehicles.
    }
  }
  // Projector for transit analytics
  query GetTransitStats replies result TransitStatsView is {
    transitStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which transit stats to retrieve.
      }
    }
  } with {
    briefly "Get transit stats"
    described as {
      |Retrieves the transit stats projection.
    }
  }
  result TransitStatsView is {
    transitStats: TransitAnalytics.TransitStats with {
      briefly "Transit stats"
      described as {
        |The transit stats being returned.
      }
    }
  } with {
    briefly "Transit stats view"
    described as {
      |Read model view carrying the transit stats projection.
    }
  }
  projector TransitAnalytics as flow is {
    updates repository VehicleContext.VehicleRepository
    outlet TransitAnalyticsToRepository is type VehicleRepositoryCommand
    inlet TransitAnalyticsFromVehicle is type VehicleEvent    record TransitStats is {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      totalTrips: Natural with {
        briefly "Trips"
        described as {
          |Total trips.
        }
      }
      completedTrips: Natural with {
        briefly "Completed"
        described as {
          |Completed trips.
        }
      }
      onTimePercent: Decimal(5,2) with {
        briefly "On-time"
        described as {
          |On-time percentage.
        }
      }
      totalRidership: Natural with {
        briefly "Ridership"
        described as {
          |Total riders.
        }
      }
      averageLoad: Decimal(5,2) with {
        briefly "Avg load"
        described as {
          |Average load percent.
        }
      }
      incidentCount: Natural with {
        briefly "Incidents"
        described as {
          |Incident count.
        }
      }
      vehiclesInService: Natural with {
        briefly "In service"
        described as {
          |Vehicles in service.
        }
      }
    } with {
      briefly "Transit statistics"
      described as {
        |Daily transit metrics.
      }
    }
    handler AnalyticsHandler is {
      on locationUpdated: event Vehicle.LocationUpdated is {
        tell command VehicleContext.VehicleRepository.PersistLocationUpdated(vehicleId = locationUpdated.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply LocationUpdated to the TransitAnalytics projection"
      }
      on operatorAssigned: event Vehicle.OperatorAssigned is {
        tell command VehicleContext.VehicleRepository.PersistOperatorAssigned(vehicleId = operatorAssigned.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply OperatorAssigned to the TransitAnalytics projection"
      }
      on vehicleInfoUpdated: event Vehicle.VehicleInfoUpdated is {
        tell command VehicleContext.VehicleRepository.PersistVehicleInfoUpdated(vehicleId = vehicleInfoUpdated.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply VehicleInfoUpdated to the TransitAnalytics projection"
      }
      on vehiclePulledFromService: event Vehicle.VehiclePulledFromService is {
        tell command VehicleContext.VehicleRepository.PersistVehiclePulledFromService(vehicleId = vehiclePulledFromService.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply VehiclePulledFromService to the TransitAnalytics projection"
      }
      on vehicleRegistered: event Vehicle.VehicleRegistered is {
        tell command VehicleContext.VehicleRepository.PersistVehicleRegistered(vehicleId = vehicleRegistered.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply VehicleRegistered to the TransitAnalytics projection"
      }
      on vehicleReturnedToService: event Vehicle.VehicleReturnedToService is {
        tell command VehicleContext.VehicleRepository.PersistVehicleReturnedToService(vehicleId = vehicleReturnedToService.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply VehicleReturnedToService to the TransitAnalytics projection"
      }
      on vehicleStatusChanged: event Vehicle.VehicleStatusChanged is {
        tell command VehicleContext.VehicleRepository.PersistVehicleStatusChanged(vehicleId = vehicleStatusChanged.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply VehicleStatusChanged to the TransitAnalytics projection"
      }
      on tripAssigned: event Vehicle.TripAssigned is {
        tell command VehicleContext.VehicleRepository.PersistTripAssigned(vehicleId = tripAssigned.vehicleId) to repository VehicleContext.VehicleRepository
        do "Update trip count"
      }
      on tripCompleted: event Vehicle.TripCompleted is {
        tell command VehicleContext.VehicleRepository.PersistTripCompleted(vehicleId = tripCompleted.vehicleId) to repository VehicleContext.VehicleRepository
        do "Update completion metrics"
      }
      on stopEventRecorded: event Vehicle.StopEventRecorded is {
        tell command VehicleContext.VehicleRepository.PersistStopEventRecorded(vehicleId = stopEventRecorded.vehicleId) to repository VehicleContext.VehicleRepository
        do "Update schedule adherence"
      }
      on passengerLoadUpdated: event Vehicle.PassengerLoadUpdated is {
        tell command VehicleContext.VehicleRepository.PersistPassengerLoadUpdated(vehicleId = passengerLoadUpdated.vehicleId) to repository VehicleContext.VehicleRepository
        do "Update ridership metrics"
      }
      on incidentReported: event Vehicle.IncidentReported is {
        tell command VehicleContext.VehicleRepository.PersistIncidentReported(vehicleId = incidentReported.vehicleId) to repository VehicleContext.VehicleRepository
        do "Update incident metrics"
      }
    } with {
      briefly "Maintains transit analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Transit analytics projections"
    described as {
      |Maintains transit performance analytics.
    }
  }
  // ---- Event publication for Vehicle ----
  type VehicleEvent is one of {
    VehicleContext.Vehicle.VehicleRegistered or VehicleContext.Vehicle.VehicleInfoUpdated or VehicleContext.Vehicle.OperatorAssigned or VehicleContext.Vehicle.TripAssigned or VehicleContext.Vehicle.LocationUpdated or VehicleContext.Vehicle.StopEventRecorded or VehicleContext.Vehicle.PassengerLoadUpdated or VehicleContext.Vehicle.IncidentReported or VehicleContext.Vehicle.TripCompleted or VehicleContext.Vehicle.VehicleStatusChanged or VehicleContext.Vehicle.VehiclePulledFromService or VehicleContext.Vehicle.VehicleReturnedToService
  } with {
    briefly "Vehicle event alternation"
    described as {
      |Union of all Vehicle events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet VehicleEventSplit as flow is {
    inlet VehicleEventSplitIn is type VehicleEvent    outlet VehicleEventSplitToTransitAnalytics is type VehicleEvent
    handler VehicleEventSplitHandler is {
      on vehicleRegistered: event Vehicle.VehicleRegistered is {
        send vehicleRegistered to outlet VehicleEventSplitToTransitAnalytics
        tell vehicleRegistered to entity VehicleContext.Vehicle
      }
      on vehicleInfoUpdated: event Vehicle.VehicleInfoUpdated is {
        send vehicleInfoUpdated to outlet VehicleEventSplitToTransitAnalytics
        tell vehicleInfoUpdated to entity VehicleContext.Vehicle
      }
      on operatorAssigned: event Vehicle.OperatorAssigned is {
        send operatorAssigned to outlet VehicleEventSplitToTransitAnalytics
        tell operatorAssigned to entity VehicleContext.Vehicle
      }
      on tripAssigned: event Vehicle.TripAssigned is {
        send tripAssigned to outlet VehicleEventSplitToTransitAnalytics
        tell tripAssigned to entity VehicleContext.Vehicle
      }
      on locationUpdated: event Vehicle.LocationUpdated is {
        send locationUpdated to outlet VehicleEventSplitToTransitAnalytics
        tell locationUpdated to entity VehicleContext.Vehicle
      }
      on stopEventRecorded: event Vehicle.StopEventRecorded is {
        send stopEventRecorded to outlet VehicleEventSplitToTransitAnalytics
        tell stopEventRecorded to entity VehicleContext.Vehicle
      }
      on passengerLoadUpdated: event Vehicle.PassengerLoadUpdated is {
        send passengerLoadUpdated to outlet VehicleEventSplitToTransitAnalytics
        tell passengerLoadUpdated to entity VehicleContext.Vehicle
      }
      on incidentReported: event Vehicle.IncidentReported is {
        send incidentReported to outlet VehicleEventSplitToTransitAnalytics
        tell incidentReported to entity VehicleContext.Vehicle
      }
      on tripCompleted: event Vehicle.TripCompleted is {
        send tripCompleted to outlet VehicleEventSplitToTransitAnalytics
        tell tripCompleted to entity VehicleContext.Vehicle
      }
      on vehicleStatusChanged: event Vehicle.VehicleStatusChanged is {
        send vehicleStatusChanged to outlet VehicleEventSplitToTransitAnalytics
        tell vehicleStatusChanged to entity VehicleContext.Vehicle
      }
      on vehiclePulledFromService: event Vehicle.VehiclePulledFromService is {
        send vehiclePulledFromService to outlet VehicleEventSplitToTransitAnalytics
        tell vehiclePulledFromService to entity VehicleContext.Vehicle
      }
      on vehicleReturnedToService: event Vehicle.VehicleReturnedToService is {
        send vehicleReturnedToService to outlet VehicleEventSplitToTransitAnalytics
        tell vehicleReturnedToService to entity VehicleContext.Vehicle
      }
      on other is {
        error "Unexpected message for processor VehicleEventSplit"
      }
    } with {
      briefly "Vehicle event fan-out handler"
      described as {
        |Delivers each Vehicle event to all of its consumers.
      }
    }
  } with {
    briefly "Vehicle event fan-out"
    described as {
      |Fans Vehicle events out to the repository and projectors.
    }
  }
  connector 'VehicleEvent Stream' is from outlet VehicleContext.Vehicle.VehicleEvents2 to inlet VehicleContext.VehicleEventSplit.VehicleEventSplitIn with {
    briefly "Vehicle events, fanned out to storage and read models"
  }
  connector 'TransitAnalytics Feed' is from outlet VehicleContext.VehicleEventSplit.VehicleEventSplitToTransitAnalytics to inlet VehicleContext.TransitAnalytics.TransitAnalyticsFromVehicle with {
    briefly "Vehicle events feeding the TransitAnalytics projection"
  }
  connector 'TransitAnalytics Storage' is from outlet VehicleContext.TransitAnalytics.TransitAnalyticsToRepository to inlet VehicleContext.VehicleRepository.VehicleRepositoryFromTransitAnalytics with {
    briefly "TransitAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for transit vehicles"
  described as {
    | The VehicleContext is the bounded context for
    | transit vehicle operations.
  }
}
