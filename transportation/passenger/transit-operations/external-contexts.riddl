// Transit Operations - External Contexts
// Computer-Aided Dispatch Service
external context CADService as split is {
  outlet CADServiceRepliesOut is result ActiveVehiclesResult
 with {
    briefly "What this service answers, on its way back"
  }
  type CADServiceEvent is one of {
    OperatorMessageSent or VehicleDispatched
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet CADServiceEventsOut is type CADServiceEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type CADServiceCommand is one of {
    DispatchVehicle or SendOperatorMessage or GetActiveVehicles
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet CADServiceRequests is type CADServiceCommand with {
    briefly "What this context asks the service to send"
  }
  handler CADServiceBoundary is {
    on query GetActiveVehicles is {
      let askAnswer: type ActiveVehiclesResult = prompt("look up what GetActiveVehicles asks for")
      reply askAnswer
    }
    on command DispatchVehicle is {
      let vehicleDispatched: type VehicleDispatched = prompt("the vehicle dispatched this produces")
      send vehicleDispatched to outlet CADService.CADServiceEventsOut
      do "deliver it to the recipient"
    }
    on command SendOperatorMessage is {
      let operatorMessageSent: type OperatorMessageSent = prompt("the operator message sent this produces")
      send operatorMessageSent to outlet CADService.CADServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context CADService"
    }
  } with {
    briefly "CADService boundary"
  }
  query GetActiveVehicles replies result ActiveVehiclesResult is {
    filterRouteId: RouteId? with {
      briefly "Route"
      described as {
        |Filter by route.
      }
    }
  } with {
    briefly "Get active vehicles"
    described as {
      |Queries vehicles in service.
    }
  }
  result ActiveVehiclesResult is {
    vehicles: VehiclePosition+ with {
      briefly "Vehicles"
      described as {
        |Active vehicles.
      }
    }
  } with {
    briefly "Active vehicles result"
    described as {
      |List of active vehicles.
    }
  }
  command DispatchVehicle is {
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
    tripId: TripId with {
      briefly "Trip"
      described as {
        |Trip ID.
      }
    }
    dispatchedAt: TimeStamp with {
      briefly "Dispatched"
      described as {
        |Dispatch time.
      }
    }
  } with {
    briefly "Dispatch vehicle"
    described as {
      |Dispatches vehicle for trip.
    }
  }
  event VehicleDispatched is {
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
    tripId: TripId with {
      briefly "Trip"
      described as {
        |Trip ID.
      }
    }
    dispatchedAt: TimeStamp with {
      briefly "Dispatched"
      described as {
        |Dispatch time.
      }
    }
  } with {
    briefly "Vehicle dispatched"
    described as {
      |Emitted when vehicle is dispatched.
    }
  }
  command SendOperatorMessage is {
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
    message: String(1,500) with {
      briefly "Message"
      described as {
        |Message text.
      }
    }
    priority: String(1,20) with {
      briefly "Priority"
      described as {
        |Message priority.
      }
    }
  } with {
    briefly "Send operator message"
    described as {
      |Sends message to vehicle operator.
    }
  }
  event OperatorMessageSent is {
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
    sentAt: TimeStamp with {
      briefly "Sent"
      described as {
        |Send time.
      }
    }
  } with {
    briefly "Operator message sent"
    described as {
      |Emitted when message is sent.
    }
  }
} with {
  briefly "External CAD"
  described as {
    |Computer-aided dispatch system.
  }
}
// Schedule Service
external context ScheduleService as split is {
  type ScheduleServiceReply is one of {
    ScheduleResult or StopTimesResult
  } with {
    briefly "Everything this service answers"
  }
  outlet ScheduleServiceRepliesOut is type ScheduleServiceReply
 with {
    briefly "What this service answers, on its way back"
  }
  outlet ScheduleServiceEventsOut is event ScheduleChanged
 with {
    briefly "What this service tells the model, unasked"
  }
  type ScheduleServiceRequest is one of {
    GetStopTimes or GetTodaySchedule
  } with {
    briefly "Everything this service can be asked"
  }
  inlet ScheduleServiceRequests is type ScheduleServiceRequest with {
    briefly "What this context asks the service to send"
  }
  handler ScheduleServiceBoundary is {
    on query GetStopTimes is {
      let askAnswer: type StopTimesResult = prompt("look up what GetStopTimes asks for")
      reply askAnswer
    }
    on query GetTodaySchedule is {
      let askAnswer: type ScheduleResult = prompt("look up what GetTodaySchedule asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context ScheduleService"
    }
  } with {
    briefly "ScheduleService boundary"
  }
  query GetTodaySchedule replies result ScheduleResult is {
    filterRouteId: RouteId? with {
      briefly "Route"
      described as {
        |Filter by route.
      }
    }
    filterBlockId: BlockId? with {
      briefly "Block"
      described as {
        |Filter by block.
      }
    }
  } with {
    briefly "Get today's schedule"
    described as {
      |Queries scheduled trips.
    }
  }
  result ScheduleResult is {
    trips: TripAssignment+ with {
      briefly "Trips"
      described as {
        |Scheduled trips.
      }
    }
  } with {
    briefly "Schedule result"
    described as {
      |Daily trip schedule.
    }
  }
  query GetStopTimes replies result StopTimesResult is {
    tripId: TripId with {
      briefly "Trip"
      described as {
        |Trip ID.
      }
    }
  } with {
    briefly "Get stop times"
    described as {
      |Queries scheduled stop times.
    }
  }
  result StopTimesResult is {
    stops: ScheduledStopTime+ with {
      briefly "Stops"
      described as {
        |Scheduled stops.
      }
    }
  } with {
    briefly "Stop times result"
    described as {
      |Trip stop schedule.
    }
  }
  type ScheduledStopTime is {
    stopId: StopId with {
      briefly "Stop"
      described as {
        |Stop ID.
      }
    }
    stopName: String(1,200) with {
      briefly "Name"
      described as {
        |Stop name.
      }
    }
    scheduledArrival: TimeStamp with {
      briefly "Arrival"
      described as {
        |Scheduled arrival.
      }
    }
    scheduledDeparture: TimeStamp with {
      briefly "Departure"
      described as {
        |Scheduled departure.
      }
    }
    stopSequence: Natural with {
      briefly "Sequence"
      described as {
        |Stop sequence.
      }
    }
    timepoint: Boolean with {
      briefly "Timepoint"
      described as {
        |Is timepoint.
      }
    }
  } with {
    briefly "Scheduled stop time"
    described as {
      |Scheduled stop arrival/departure.
    }
  }
  event ScheduleChanged is {
    routeId: RouteId with {
      briefly "Route"
      described as {
        |Route ID.
      }
    }
    changeType: String(1,50) with {
      briefly "Type"
      described as {
        |Change type.
      }
    }
    effectiveDate: Date with {
      briefly "Effective"
      described as {
        |Effective date.
      }
    }
  } with {
    briefly "Schedule changed"
    described as {
      |Emitted when schedule is modified.
    }
  }
} with {
  briefly "External schedule"
  described as {
    |Schedule management service.
  }
}
// Passenger Information Service
external context PassengerInformationService as flow is {
  type PassengerInformationServiceEvent is one of {
    ArrivalPredictionPublished or ServiceAlertPublished
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet PassengerInformationServiceEventsOut is type PassengerInformationServiceEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type PassengerInformationServiceCommand is one of {
    PublishArrivalPrediction or PublishServiceAlert
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet PassengerInformationServiceRequests is type PassengerInformationServiceCommand with {
    briefly "What this context asks the service to send"
  }
  handler PassengerInformationServiceBoundary is {
    on command PublishArrivalPrediction is {
      let arrivalPredictionPublished: type ArrivalPredictionPublished = prompt("the arrival prediction published this produces")
      send arrivalPredictionPublished to outlet PassengerInformationService.PassengerInformationServiceEventsOut
      do "deliver it to the recipient"
    }
    on command PublishServiceAlert is {
      let serviceAlertPublished: type ServiceAlertPublished = prompt("the service alert published this produces")
      send serviceAlertPublished to outlet PassengerInformationService.PassengerInformationServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context PassengerInformationService"
    }
  } with {
    briefly "PassengerInformationService boundary"
  }
  command PublishArrivalPrediction is {
    stopId: StopId with {
      briefly "Stop"
      described as {
        |Stop ID.
      }
    }
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
    routeId: RouteId with {
      briefly "Route"
      described as {
        |Route ID.
      }
    }
    predictedArrival: TimeStamp with {
      briefly "Predicted"
      described as {
        |Predicted arrival.
      }
    }
    confidence: Decimal(3,2) with {
      briefly "Confidence"
      described as {
        |Prediction confidence.
      }
    }
  } with {
    briefly "Publish arrival prediction"
    described as {
      |Publishes real-time arrival.
    }
  }
  event ArrivalPredictionPublished is {
    stopId: StopId with {
      briefly "Stop"
      described as {
        |Stop ID.
      }
    }
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
    publishedAt: TimeStamp with {
      briefly "Published"
      described as {
        |Publish time.
      }
    }
  } with {
    briefly "Arrival prediction published"
    described as {
      |Emitted when prediction is published.
    }
  }
  command PublishServiceAlert is {
    routeId: RouteId with {
      briefly "Route"
      described as {
        |Affected route.
      }
    }
    alertType: String(1,50) with {
      briefly "Type"
      described as {
        |Alert type.
      }
    }
    message: String(1,1000) with {
      briefly "Message"
      described as {
        |Alert message.
      }
    }
    effectStart: TimeStamp with {
      briefly "Start"
      described as {
        |Effect start.
      }
    }
    effectEnd: TimeStamp? with {
      briefly "End"
      described as {
        |Effect end.
      }
    }
  } with {
    briefly "Publish service alert"
    described as {
      |Publishes service alert.
    }
  }
  event ServiceAlertPublished is {
    alertId: UUID with {
      briefly "Alert"
      described as {
        |Alert ID.
      }
    }
    routeId: RouteId with {
      briefly "Route"
      described as {
        |Affected route.
      }
    }
    publishedAt: TimeStamp with {
      briefly "Published"
      described as {
        |Publish time.
      }
    }
  } with {
    briefly "Service alert published"
    described as {
      |Emitted when alert is published.
    }
  }
} with {
  briefly "External passenger info"
  described as {
    |Real-time passenger information system.
  }
}
// Fare Collection Service
external context FareCollectionService as split is {
  outlet FareCollectionServiceRepliesOut is result VehicleFareTotalResult
 with {
    briefly "What this service answers, on its way back"
  }
  outlet FareCollectionServiceEventsOut is event FareValidated
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet FareCollectionServiceRequests is query GetVehicleFareTotal with {
    briefly "What this context asks the service to send"
  }
  handler FareCollectionServiceBoundary is {
    on query GetVehicleFareTotal is {
      let askAnswer: type VehicleFareTotalResult = prompt("look up what GetVehicleFareTotal asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context FareCollectionService"
    }
  } with {
    briefly "FareCollectionService boundary"
  }
  event FareValidated is {
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
    fareType: String(1,50) with {
      briefly "Type"
      described as {
        |Fare type.
      }
    }
    amount: Decimal(8,2) with {
      briefly "Amount"
      described as {
        |Fare amount.
      }
    }
    validatedAt: TimeStamp with {
      briefly "Validated"
      described as {
        |Validation time.
      }
    }
  } with {
    briefly "Fare validated"
    described as {
      |Emitted when fare is collected.
    }
  }
  query GetVehicleFareTotal replies result VehicleFareTotalResult is {
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
    date: Date with {
      briefly "Date"
      described as {
        |Service date.
      }
    }
  } with {
    briefly "Get vehicle fare total"
    described as {
      |Queries daily fare collection.
    }
  }
  result VehicleFareTotalResult is {
    totalFares: Decimal(10,2) with {
      briefly "Total"
      described as {
        |Total fares.
      }
    }
    fareCount: Natural with {
      briefly "Count"
      described as {
        |Transaction count.
      }
    }
    faresByType: FareTypeTotal+ with {
      briefly "By type"
      described as {
        |Totals by fare type.
      }
    }
  } with {
    briefly "Vehicle fare total"
    described as {
      |Daily fare collection totals.
    }
  }
  type FareTypeTotal is {
    fareType: String(1,50) with {
      briefly "Type"
      described as {
        |Fare type.
      }
    }
    count: Natural with {
      briefly "Count"
      described as {
        |Transaction count.
      }
    }
    total: Decimal(10,2) with {
      briefly "Total"
      described as {
        |Total amount.
      }
    }
  } with {
    briefly "Fare type total"
    described as {
      |Totals for fare type.
    }
  }
} with {
  briefly "External fare collection"
  described as {
    |Automated fare collection system.
  }
}
// Maintenance Service
external context MaintenanceService as split is {
  outlet MaintenanceServiceRepliesOut is result MaintenanceStatusResult
 with {
    briefly "What this service answers, on its way back"
  }
  type MaintenanceServiceEvent is one of {
    DefectReportCreated or VehicleClearedForService
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet MaintenanceServiceEventsOut is type MaintenanceServiceEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type MaintenanceServiceRequest is one of {
    CreateDefectReport or GetVehicleMaintenanceStatus
  } with {
    briefly "Everything this service can be asked"
  }
  inlet MaintenanceServiceRequests is type MaintenanceServiceRequest with {
    briefly "What this context asks the service to send"
  }
  handler MaintenanceServiceBoundary is {
    on query GetVehicleMaintenanceStatus is {
      let askAnswer: type MaintenanceStatusResult = prompt("look up what GetVehicleMaintenanceStatus asks for")
      reply askAnswer
    }
    on command CreateDefectReport is {
      let defectReportCreated: type DefectReportCreated = prompt("the defect report created this produces")
      send defectReportCreated to outlet MaintenanceService.MaintenanceServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context MaintenanceService"
    }
  } with {
    briefly "MaintenanceService boundary"
  }
  query GetVehicleMaintenanceStatus replies result MaintenanceStatusResult is {
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
  } with {
    briefly "Get maintenance status"
    described as {
      |Queries vehicle maintenance status.
    }
  }
  result MaintenanceStatusResult is {
    nextServiceDue: Date with {
      briefly "Next service"
      described as {
        |Next service date.
      }
    }
    milesSinceService: Natural with {
      briefly "Miles"
      described as {
        |Miles since service.
      }
    }
    openWorkOrders: Natural with {
      briefly "Open orders"
      described as {
        |Open work orders.
      }
    }
    safetyInspectionDue: Date with {
      briefly "Inspection"
      described as {
        |Inspection due date.
      }
    }
  } with {
    briefly "Maintenance status"
    described as {
      |Vehicle maintenance status.
    }
  }
  command CreateDefectReport is {
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
    defect: String(1,500) with {
      briefly "Defect"
      described as {
        |Defect description.
      }
    }
    severity: String(1,20) with {
      briefly "Severity"
      described as {
        |Defect severity.
      }
    }
    reportedBy: OperatorId with {
      briefly "By"
      described as {
        |Reporting operator.
      }
    }
  } with {
    briefly "Create defect report"
    described as {
      |Reports vehicle defect.
    }
  }
  event DefectReportCreated is {
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
    defectId: UUID with {
      briefly "Defect"
      described as {
        |Defect ID.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Report time.
      }
    }
  } with {
    briefly "Defect report created"
    described as {
      |Emitted when defect is reported.
    }
  }
  event VehicleClearedForService is {
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
    clearedAt: TimeStamp with {
      briefly "Cleared"
      described as {
        |Clearance time.
      }
    }
  } with {
    briefly "Vehicle cleared"
    described as {
      |Emitted when vehicle is cleared.
    }
  }
} with {
  briefly "External maintenance"
  described as {
    |Fleet maintenance management system.
  }
}
// Emergency Service
external context EmergencyService as flow is {
  type EmergencyServiceEvent is one of {
    EmergencyAlertTriggered or EmergencyResolved
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet EmergencyServiceEventsOut is type EmergencyServiceEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet EmergencyServiceRequests is command TriggerEmergencyAlert with {
    briefly "What this context asks the service to send"
  }
  handler EmergencyServiceBoundary is {
    on command TriggerEmergencyAlert is {
      let emergencyAlertTriggered: type EmergencyAlertTriggered = prompt("the emergency alert triggered this produces")
      send emergencyAlertTriggered to outlet EmergencyService.EmergencyServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context EmergencyService"
    }
  } with {
    briefly "EmergencyService boundary"
  }
  command TriggerEmergencyAlert is {
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
    alertType: String(1,50) with {
      briefly "Type"
      described as {
        |Emergency type.
      }
    }
    location: GpsLocation with {
      briefly "Location"
      described as {
        |Emergency location.
      }
    }
    triggeredBy: OperatorId with {
      briefly "By"
      described as {
        |Triggering operator.
      }
    }
  } with {
    briefly "Trigger emergency alert"
    described as {
      |Activates emergency alert.
    }
  }
  event EmergencyAlertTriggered is {
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
    alertType: String(1,50) with {
      briefly "Type"
      described as {
        |Emergency type.
      }
    }
    triggeredAt: TimeStamp with {
      briefly "Triggered"
      described as {
        |Trigger time.
      }
    }
    location: GpsLocation with {
      briefly "Location"
      described as {
        |Emergency location.
      }
    }
  } with {
    briefly "Emergency alert triggered"
    described as {
      |Emitted when emergency is triggered.
    }
  }
  event EmergencyResolved is {
    vehicleId: VehicleId with {
      briefly "Vehicle"
      described as {
        |Vehicle ID.
      }
    }
    resolvedAt: TimeStamp with {
      briefly "Resolved"
      described as {
        |Resolution time.
      }
    }
    resolution: String(1,500) with {
      briefly "Resolution"
      described as {
        |Resolution details.
      }
    }
  } with {
    briefly "Emergency resolved"
    described as {
      |Emitted when emergency is resolved.
    }
  }
} with {
  briefly "External emergency"
  described as {
    |Emergency response system.
  }
}
