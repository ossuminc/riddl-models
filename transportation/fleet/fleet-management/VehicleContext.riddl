// Fleet Management - Vehicle Context
context VehicleContext is {
  adaptor FromAlertNotificationService from context AlertNotificationService is { 
    handler FromAlertNotificationServiceHandler is {
      on event AlertNotificationService.AlertSent is {
        do "the model receives alert sent"
      }
      on event AlertNotificationService.MaintenanceReminderSent is {
        do "the model receives maintenance reminder sent"
      }
      on other is {
        error "Unexpected message for adaptor FromAlertNotificationService"
      }
    } with {
      briefly "from alert notification service"
      described as {
        |Carries messages from the external AlertNotificationService.
      }
    }
  } with {
    briefly "AlertNotificationService integration"
    described as {
      |The model's side of the AlertNotificationService conversation.
    }
  }
  adaptor ToAlertNotificationService to context AlertNotificationService is { 
    handler ToAlertNotificationServiceHandler is {
      on command AlertNotificationService.SendAlert is {
        do "the model sends send alert"
      }
      on command AlertNotificationService.SendMaintenanceReminder is {
        do "the model sends send maintenance reminder"
      }
      on other is {
        error "Unexpected message for adaptor ToAlertNotificationService"
      }
    } with {
      briefly "to alert notification service"
      described as {
        |Carries messages to the external AlertNotificationService.
      }
    }
  } with {
    briefly "AlertNotificationService integration"
    described as {
      |The model's side of the AlertNotificationService conversation.
    }
  }
  adaptor FromDriverManagementService from context DriverManagementService is { 
    handler FromDriverManagementServiceHandler is {
      on result DriverManagementService.AvailableDrivers is {
        do "the model receives available drivers"
      }
      on result DriverManagementService.DriverDetails is {
        do "the model receives driver details"
      }
      on event DriverManagementService.DrivingHoursLogged is {
        do "the model receives driving hours logged"
      }
      on other is {
        error "Unexpected message for adaptor FromDriverManagementService"
      }
    } with {
      briefly "from driver management service"
      described as {
        |Carries messages from the external DriverManagementService.
      }
    }
  } with {
    briefly "DriverManagementService integration"
    described as {
      |The model's side of the DriverManagementService conversation.
    }
  }
  adaptor ToDriverManagementService to context DriverManagementService is { 
    handler ToDriverManagementServiceHandler is {
      on query DriverManagementService.GetAvailableDrivers is {
        do "the model sends get available drivers"
      }
      on query DriverManagementService.GetDriverInfo is {
        do "the model sends get driver info"
      }
      on command DriverManagementService.LogDrivingHours is {
        do "the model sends log driving hours"
      }
      on other is {
        error "Unexpected message for adaptor ToDriverManagementService"
      }
    } with {
      briefly "to driver management service"
      described as {
        |Carries messages to the external DriverManagementService.
      }
    }
  } with {
    briefly "DriverManagementService integration"
    described as {
      |The model's side of the DriverManagementService conversation.
    }
  }
  adaptor FromFuelCardService from context FuelCardService is { 
    handler FromFuelCardServiceHandler is {
      on event FuelCardService.FuelPurchaseAuthorized is {
        do "the model receives fuel purchase authorized"
      }
      on event FuelCardService.FuelPurchaseCompleted is {
        do "the model receives fuel purchase completed"
      }
      on other is {
        error "Unexpected message for adaptor FromFuelCardService"
      }
    } with {
      briefly "from fuel card service"
      described as {
        |Carries messages from the external FuelCardService.
      }
    }
  } with {
    briefly "FuelCardService integration"
    described as {
      |The model's side of the FuelCardService conversation.
    }
  }
  adaptor ToFuelCardService to context FuelCardService is { 
    handler ToFuelCardServiceHandler is {
      on command FuelCardService.AuthorizeFuelPurchase is {
        do "the model sends authorize fuel purchase"
      }
      on other is {
        error "Unexpected message for adaptor ToFuelCardService"
      }
    } with {
      briefly "to fuel card service"
      described as {
        |Carries messages to the external FuelCardService.
      }
    }
  } with {
    briefly "FuelCardService integration"
    described as {
      |The model's side of the FuelCardService conversation.
    }
  }
  adaptor FromGpsTrackingService from context GpsTrackingService is { 
    handler FromGpsTrackingServiceHandler is {
      on event GpsTrackingService.LocationReceived is {
        do "the model receives location received"
      }
      on event GpsTrackingService.TrackingStarted is {
        do "the model receives tracking started"
      }
      on event GpsTrackingService.TrackingStopped is {
        do "the model receives tracking stopped"
      }
      on other is {
        error "Unexpected message for adaptor FromGpsTrackingService"
      }
    } with {
      briefly "from gps tracking service"
      described as {
        |Carries messages from the external GpsTrackingService.
      }
    }
  } with {
    briefly "GpsTrackingService integration"
    described as {
      |The model's side of the GpsTrackingService conversation.
    }
  }
  adaptor ToGpsTrackingService to context GpsTrackingService is { 
    handler ToGpsTrackingServiceHandler is {
      on command GpsTrackingService.StartTracking is {
        do "the model sends start tracking"
      }
      on command GpsTrackingService.StopTracking is {
        do "the model sends stop tracking"
      }
      on other is {
        error "Unexpected message for adaptor ToGpsTrackingService"
      }
    } with {
      briefly "to gps tracking service"
      described as {
        |Carries messages to the external GpsTrackingService.
      }
    }
  } with {
    briefly "GpsTrackingService integration"
    described as {
      |The model's side of the GpsTrackingService conversation.
    }
  }
  adaptor FromInsuranceService from context InsuranceService is { 
    handler FromInsuranceServiceHandler is {
      on event InsuranceService.IncidentReportFiled is {
        do "the model receives incident report filed"
      }
      on result InsuranceService.VehicleCoverage is {
        do "the model receives vehicle coverage"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceService"
      }
    } with {
      briefly "from insurance service"
      described as {
        |Carries messages from the external InsuranceService.
      }
    }
  } with {
    briefly "InsuranceService integration"
    described as {
      |The model's side of the InsuranceService conversation.
    }
  }
  adaptor ToInsuranceService to context InsuranceService is { 
    handler ToInsuranceServiceHandler is {
      on command InsuranceService.FileIncidentReport is {
        do "the model sends file incident report"
      }
      on query InsuranceService.GetVehicleCoverage is {
        do "the model sends get vehicle coverage"
      }
      on other is {
        error "Unexpected message for adaptor ToInsuranceService"
      }
    } with {
      briefly "to insurance service"
      described as {
        |Carries messages to the external InsuranceService.
      }
    }
  } with {
    briefly "InsuranceService integration"
    described as {
      |The model's side of the InsuranceService conversation.
    }
  }
  adaptor FromMaintenanceServiceProvider from context MaintenanceServiceProvider is { 
    handler FromMaintenanceServiceProviderHandler is {
      on result MaintenanceServiceProvider.AvailableSlots is {
        do "the model receives available slots"
      }
      on event MaintenanceServiceProvider.ServiceBooked is {
        do "the model receives service booked"
      }
      on event MaintenanceServiceProvider.ServiceCompleted is {
        do "the model receives service completed"
      }
      on other is {
        error "Unexpected message for adaptor FromMaintenanceServiceProvider"
      }
    } with {
      briefly "from maintenance service provider"
      described as {
        |Carries messages from the external MaintenanceServiceProvider.
      }
    }
  } with {
    briefly "MaintenanceServiceProvider integration"
    described as {
      |The model's side of the MaintenanceServiceProvider conversation.
    }
  }
  adaptor ToMaintenanceServiceProvider to context MaintenanceServiceProvider is { 
    handler ToMaintenanceServiceProviderHandler is {
      on command MaintenanceServiceProvider.BookService is {
        do "the model sends book service"
      }
      on query MaintenanceServiceProvider.GetAvailableSlots is {
        do "the model sends get available slots"
      }
      on other is {
        error "Unexpected message for adaptor ToMaintenanceServiceProvider"
      }
    } with {
      briefly "to maintenance service provider"
      described as {
        |Carries messages to the external MaintenanceServiceProvider.
      }
    }
  } with {
    briefly "MaintenanceServiceProvider integration"
    described as {
      |The model's side of the MaintenanceServiceProvider conversation.
    }
  }
  include "types.riddl"
  include "Vehicle.riddl"
  // Repository for vehicle persistence
  repository VehicleRepository is {
    inlet VehicleRepositoryFromVehicle is type VehicleEvent    inlet VehicleRepositoryFromFleetAnalytics is type VehicleEvent    outlet VehicleRepositoryResponses is type Vehicle.VehicleResult
    record StoredVehicle is  {
      vehicleId: VehicleId with {
        briefly "vehicleId"
        described as {
          |The vehicleId column of the stored vehicle row.
        }
      }
      assignedDriver: DriverInfo? with {
        briefly "assignedDriver"
        described as {
          |The assignedDriver column of the stored vehicle row.
        }
      }
      status: VehicleStatus with {
        briefly "status"
        described as {
          |The status column of the stored vehicle row.
        }
      }
      vehicleInfo: VehicleInfo with {
        briefly "vehicleInfo"
        described as {
          |The vehicleInfo column of the stored vehicle row.
        }
      }
    } with {
      briefly "Stored vehicle row"
      described as {
        |The persistence shape of vehicle data as this repository stores it.
      }
    }
    schema VehicleData is relational
      of vehicles as type StoredVehicle
        index on field StoredVehicle.vehicleId
        index on field StoredVehicle.vehicleInfo.licensePlate
        index on field StoredVehicle.assignedDriver.driverId
        index on field StoredVehicle.status
 with {
      briefly "Vehicle data schema"
      described as {
        |The relational schema holding vehicle data for the VehicleRepository.
      }
    }
    handler VehiclePersistence is {
      on query GetFleetStats is {
        do "read the fleet stats projection"
        yield result FleetStatsView
      }
      on command Vehicle.RegisterVehicle is {
        do "Store new vehicle"
      }
      on command Vehicle.UpdateLocation is {
        tell event Vehicle.LocationUpdated to entity VehicleContext.Vehicle
        do "Update vehicle location"
      }
      on command Vehicle.UpdateOdometer is {
        tell event Vehicle.OdometerUpdated to entity VehicleContext.Vehicle
        do "Update odometer reading"
      }
      on command Vehicle.UpdateFuelLevel is {
        tell event Vehicle.FuelLevelUpdated to entity VehicleContext.Vehicle
        do "Update fuel level"
      }
      on command Vehicle.AssignDriver is {
        tell event Vehicle.DriverAssigned to entity VehicleContext.Vehicle
        do "Store driver assignment"
      }
      on command Vehicle.UnassignDriver is {
        do "Remove driver assignment"
      }
      on command Vehicle.StartTrip is {
        tell event Vehicle.TripStarted to entity VehicleContext.Vehicle
        do "Store trip start"
      }
      on command Vehicle.EndTrip is {
        do "Store trip end"
      }
      on command Vehicle.ScheduleMaintenance is {
        tell event Vehicle.MaintenanceScheduled to entity VehicleContext.Vehicle
        do "Store maintenance schedule"
      }
      on command Vehicle.StartMaintenance is {
        tell event Vehicle.MaintenanceStarted to entity VehicleContext.Vehicle
        do "Update maintenance to started"
      }
      on command Vehicle.CompleteMaintenance is {
        tell event Vehicle.MaintenanceCompleted to entity VehicleContext.Vehicle
        do "Update maintenance to completed"
      }
      on command Vehicle.RaiseAlert is {
        do "Store alert"
      }
      on command Vehicle.AcknowledgeAlert is {
        tell event Vehicle.AlertAcknowledged to entity VehicleContext.Vehicle
        do "Update alert acknowledgment"
      }
      on command Vehicle.DecommissionVehicle is {
        do "Update to decommissioned"
      }
    } with {
      briefly "Persists vehicle commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Vehicle data persistence"
    described as {
      | The VehicleRepository provides persistent storage for
      | vehicles and related data.
    }
  }
  // Projector for fleet analytics
  query GetFleetStats is  {
    fleetStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which fleet stats to retrieve.
      }
    }
  } with {
    briefly "Get fleet stats"
    described as {
      |Retrieves the fleet stats projection.
    }
  }
  result FleetStatsView is  {
    fleetStats: FleetAnalytics.FleetStats with {
      briefly "Fleet stats"
      described as {
        |The fleet stats being returned.
      }
    }
  } with {
    briefly "Fleet stats view"
    described as {
      |Read model view carrying the fleet stats projection.
    }
  }
  projector FleetAnalytics is {
    updates repository VehicleContext.VehicleRepository
    inlet FleetAnalyticsFromVehicle is type VehicleEvent    outlet FleetAnalyticsOut is type VehicleEvent
    record FleetStats is  {
      totalVehicles: Natural with {
        briefly "Total"
        described as {
          |Total vehicles.
        }
      }
      availableVehicles: Natural with {
        briefly "Available"
        described as {
          |Available vehicles.
        }
      }
      inUseVehicles: Natural with {
        briefly "In use"
        described as {
          |Vehicles in use.
        }
      }
      inMaintenanceVehicles: Natural with {
        briefly "In maintenance"
        described as {
          |In maintenance.
        }
      }
      totalMileage: Natural with {
        briefly "Mileage"
        described as {
          |Total fleet mileage.
        }
      }
      maintenanceCosts: Decimal(12,2) with {
        briefly "Maintenance costs"
        described as {
          |Total maintenance costs.
        }
      }
      activeAlertCount: Natural with {
        briefly "Alerts"
        described as {
          |Active alert count.
        }
      }
    } with {
      briefly "Fleet statistics"
      described as {
        |Fleet operational metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Vehicle.VehicleRegistered is {
        tell event Vehicle.VehicleRegistered to repository VehicleContext.VehicleRepository
        do "Update vehicle counts"
      }
      on event Vehicle.TripStarted is {
        tell event Vehicle.TripStarted to repository VehicleContext.VehicleRepository
        do "Update in-use counts"
      }
      on event Vehicle.TripEnded is {
        tell event Vehicle.TripEnded to repository VehicleContext.VehicleRepository
        do "Update mileage and availability"
      }
      on event Vehicle.MaintenanceCompleted is {
        tell event Vehicle.MaintenanceCompleted to repository VehicleContext.VehicleRepository
        do "Update maintenance costs"
      }
      on event Vehicle.AlertRaised is {
        tell event Vehicle.AlertRaised to repository VehicleContext.VehicleRepository
        do "Update alert counts"
      }
      on event Vehicle.AlertAcknowledged is {
        tell event Vehicle.AlertAcknowledged to repository VehicleContext.VehicleRepository
        do "Update acknowledged alerts"
      }
    } with {
      briefly "Maintains fleet analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Fleet analytics projections"
    described as {
      |Maintains fleet operational analytics data.
    }
  }
  // ---- Event publication for Vehicle ----
  type VehicleEvent is one of {
    VehicleContext.Vehicle.VehicleRegistered or VehicleContext.Vehicle.LocationUpdated or VehicleContext.Vehicle.OdometerUpdated or VehicleContext.Vehicle.FuelLevelUpdated or VehicleContext.Vehicle.DriverAssigned or VehicleContext.Vehicle.DriverUnassigned or VehicleContext.Vehicle.TripStarted or VehicleContext.Vehicle.TripEnded or VehicleContext.Vehicle.MaintenanceScheduled or VehicleContext.Vehicle.MaintenanceStarted or VehicleContext.Vehicle.MaintenanceCompleted or VehicleContext.Vehicle.AlertRaised or VehicleContext.Vehicle.AlertAcknowledged or VehicleContext.Vehicle.VehicleDecommissioned
  } with {
    briefly "Vehicle event alternation"
    described as {
      |Union of all Vehicle events, for streaming and event-sourced
      |persistence.
    }
  }
  processor VehicleEventSource as source is {
    outlet VehicleEvents is type VehicleEvent
    handler VehicleSourceHandler is {
      on event Vehicle.VehicleRegistered is {
        send event Vehicle.VehicleRegistered to outlet VehicleEvents
      }
      on event Vehicle.LocationUpdated is {
        send event Vehicle.LocationUpdated to outlet VehicleEvents
      }
      on event Vehicle.OdometerUpdated is {
        send event Vehicle.OdometerUpdated to outlet VehicleEvents
      }
      on event Vehicle.FuelLevelUpdated is {
        send event Vehicle.FuelLevelUpdated to outlet VehicleEvents
      }
      on event Vehicle.DriverAssigned is {
        send event Vehicle.DriverAssigned to outlet VehicleEvents
      }
      on event Vehicle.DriverUnassigned is {
        send event Vehicle.DriverUnassigned to outlet VehicleEvents
      }
      on event Vehicle.TripStarted is {
        send event Vehicle.TripStarted to outlet VehicleEvents
      }
      on event Vehicle.TripEnded is {
        send event Vehicle.TripEnded to outlet VehicleEvents
      }
      on event Vehicle.MaintenanceScheduled is {
        send event Vehicle.MaintenanceScheduled to outlet VehicleEvents
      }
      on event Vehicle.MaintenanceStarted is {
        send event Vehicle.MaintenanceStarted to outlet VehicleEvents
      }
      on event Vehicle.MaintenanceCompleted is {
        send event Vehicle.MaintenanceCompleted to outlet VehicleEvents
      }
      on event Vehicle.AlertRaised is {
        send event Vehicle.AlertRaised to outlet VehicleEvents
      }
      on event Vehicle.AlertAcknowledged is {
        send event Vehicle.AlertAcknowledged to outlet VehicleEvents
      }
      on event Vehicle.VehicleDecommissioned is {
        send event Vehicle.VehicleDecommissioned to outlet VehicleEvents
      }
      on other is {
        error "Unexpected message for source VehicleEventSource"
      }
    } with {
      briefly "Vehicle source handler"
      described as {
        |Publishes Vehicle events onto the outlet.
      }
    }
  } with {
    briefly "Vehicle event source"
    described as {
      |Publishes Vehicle entity events into the streaming topology.
    }
  }
  processor VehicleEventSink as sink is {
    inlet VehicleInlet is type VehicleEvent    handler VehicleSinkHandler is {
      on event Vehicle.VehicleRegistered is {
        tell event Vehicle.VehicleRegistered to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.LocationUpdated is {
        tell event Vehicle.LocationUpdated to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.OdometerUpdated is {
        tell event Vehicle.OdometerUpdated to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.FuelLevelUpdated is {
        tell event Vehicle.FuelLevelUpdated to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.DriverAssigned is {
        tell event Vehicle.DriverAssigned to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.DriverUnassigned is {
        tell event Vehicle.DriverUnassigned to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.TripStarted is {
        tell event Vehicle.TripStarted to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.TripEnded is {
        tell event Vehicle.TripEnded to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.MaintenanceScheduled is {
        tell event Vehicle.MaintenanceScheduled to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.MaintenanceStarted is {
        tell event Vehicle.MaintenanceStarted to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.MaintenanceCompleted is {
        tell event Vehicle.MaintenanceCompleted to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.AlertRaised is {
        tell event Vehicle.AlertRaised to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.AlertAcknowledged is {
        tell event Vehicle.AlertAcknowledged to repository VehicleContext.VehicleRepository
      }
      on event Vehicle.VehicleDecommissioned is {
        tell event Vehicle.VehicleDecommissioned to repository VehicleContext.VehicleRepository
      }
      on other is {
        error "Unexpected message for sink VehicleEventSink"
      }
    } with {
      briefly "Vehicle sink handler"
      described as {
        |Persists Vehicle events via the repository.
      }
    }
  } with {
    briefly "Vehicle event sink"
    described as {
      |Receives Vehicle events for persistence.
    }
  }
  connector VehicleEventFlow is from outlet VehicleContext.VehicleEventSource.VehicleEvents to inlet VehicleContext.VehicleEventSink.VehicleInlet with {
    briefly "Vehicle event flow"
    described as {
      |Connects the Vehicle source to its sink.
    }
  }
  processor VehicleEventSplit is {
    inlet VehicleEventSplitIn is type VehicleEvent    outlet VehicleEventSplitToVehicleRepository is type VehicleEvent
    outlet VehicleEventSplitToFleetAnalytics is type VehicleEvent
    handler VehicleEventSplitHandler is {
      on event Vehicle.VehicleRegistered is {
        send event Vehicle.VehicleRegistered to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.VehicleRegistered to outlet VehicleEventSplitToFleetAnalytics
        tell event Vehicle.VehicleRegistered to entity VehicleContext.Vehicle
      }
      on event Vehicle.LocationUpdated is {
        send event Vehicle.LocationUpdated to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.LocationUpdated to outlet VehicleEventSplitToFleetAnalytics
        tell event Vehicle.LocationUpdated to entity VehicleContext.Vehicle
      }
      on event Vehicle.OdometerUpdated is {
        send event Vehicle.OdometerUpdated to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.OdometerUpdated to outlet VehicleEventSplitToFleetAnalytics
        tell event Vehicle.OdometerUpdated to entity VehicleContext.Vehicle
      }
      on event Vehicle.FuelLevelUpdated is {
        send event Vehicle.FuelLevelUpdated to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.FuelLevelUpdated to outlet VehicleEventSplitToFleetAnalytics
        tell event Vehicle.FuelLevelUpdated to entity VehicleContext.Vehicle
      }
      on event Vehicle.DriverAssigned is {
        send event Vehicle.DriverAssigned to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.DriverAssigned to outlet VehicleEventSplitToFleetAnalytics
        tell event Vehicle.DriverAssigned to entity VehicleContext.Vehicle
      }
      on event Vehicle.DriverUnassigned is {
        send event Vehicle.DriverUnassigned to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.DriverUnassigned to outlet VehicleEventSplitToFleetAnalytics
        tell event Vehicle.DriverUnassigned to entity VehicleContext.Vehicle
      }
      on event Vehicle.TripStarted is {
        send event Vehicle.TripStarted to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.TripStarted to outlet VehicleEventSplitToFleetAnalytics
        tell event Vehicle.TripStarted to entity VehicleContext.Vehicle
      }
      on event Vehicle.TripEnded is {
        send event Vehicle.TripEnded to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.TripEnded to outlet VehicleEventSplitToFleetAnalytics
        tell event Vehicle.TripEnded to entity VehicleContext.Vehicle
      }
      on event Vehicle.MaintenanceScheduled is {
        send event Vehicle.MaintenanceScheduled to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.MaintenanceScheduled to outlet VehicleEventSplitToFleetAnalytics
        tell event Vehicle.MaintenanceScheduled to entity VehicleContext.Vehicle
      }
      on event Vehicle.MaintenanceStarted is {
        send event Vehicle.MaintenanceStarted to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.MaintenanceStarted to outlet VehicleEventSplitToFleetAnalytics
        tell event Vehicle.MaintenanceStarted to entity VehicleContext.Vehicle
      }
      on event Vehicle.MaintenanceCompleted is {
        send event Vehicle.MaintenanceCompleted to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.MaintenanceCompleted to outlet VehicleEventSplitToFleetAnalytics
        tell event Vehicle.MaintenanceCompleted to entity VehicleContext.Vehicle
      }
      on event Vehicle.AlertRaised is {
        send event Vehicle.AlertRaised to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.AlertRaised to outlet VehicleEventSplitToFleetAnalytics
        tell event Vehicle.AlertRaised to entity VehicleContext.Vehicle
      }
      on event Vehicle.AlertAcknowledged is {
        send event Vehicle.AlertAcknowledged to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.AlertAcknowledged to outlet VehicleEventSplitToFleetAnalytics
        tell event Vehicle.AlertAcknowledged to entity VehicleContext.Vehicle
      }
      on event Vehicle.VehicleDecommissioned is {
        send event Vehicle.VehicleDecommissioned to outlet VehicleEventSplitToVehicleRepository
        send event Vehicle.VehicleDecommissioned to outlet VehicleEventSplitToFleetAnalytics
        tell event Vehicle.VehicleDecommissioned to entity VehicleContext.Vehicle
      }
      on other is {
        error "Unexpected message for processor VehicleEventSplit"
      }
    } with {
      briefly "Vehicle event fan-out handler"
      described as {
        |Delivers each Vehicle event to all of its consumers.
      }
    }
  } with {
    briefly "Vehicle event fan-out"
    described as {
      |Fans Vehicle events out to the repository and projectors.
    }
  }
  connector VehicleEventStream is from outlet VehicleContext.Vehicle.VehicleEvents2 to inlet VehicleContext.VehicleEventSplit.VehicleEventSplitIn with {
    briefly "Vehicle events, fanned out to storage and read models"
  }
  connector VehicleEventStorage is from outlet VehicleContext.VehicleEventSplit.VehicleEventSplitToVehicleRepository to inlet VehicleContext.VehicleRepository.VehicleRepositoryFromVehicle with {
    briefly "Vehicle events on their way to storage"
  }
  connector FleetAnalyticsFeed is from outlet VehicleContext.VehicleEventSplit.VehicleEventSplitToFleetAnalytics to inlet VehicleContext.FleetAnalytics.FleetAnalyticsFromVehicle with {
    briefly "Vehicle events feeding the FleetAnalytics projection"
  }
  connector FleetAnalyticsStorage is from outlet VehicleContext.FleetAnalytics.FleetAnalyticsOut to inlet VehicleContext.VehicleRepository.VehicleRepositoryFromFleetAnalytics with {
    briefly "The FleetAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for fleet management"
  described as {
    | The VehicleContext is the bounded context for
    | vehicle tracking and fleet operations.
  }
}
