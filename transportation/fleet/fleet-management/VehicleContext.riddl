// Fleet Management - Vehicle Context
context VehicleContext as router is {
  inlet VehicleCommandStreamIn is type VehicleCommand  outlet VehicleCommandStreamOut is type VehicleCommand
  inlet VehicleResultStreamIn is result Vehicle.VehicleResult  outlet VehicleResultStreamOut is result Vehicle.VehicleResult
  handler VehicleContextBoundary is {
    on registerVehicle: command Vehicle.RegisterVehicle is {
      send registerVehicle to outlet VehicleContext.VehicleCommandStreamOut
    }
    on updateLocation: command Vehicle.UpdateLocation is {
      send updateLocation to outlet VehicleContext.VehicleCommandStreamOut
    }
    on updateOdometer: command Vehicle.UpdateOdometer is {
      send updateOdometer to outlet VehicleContext.VehicleCommandStreamOut
    }
    on updateFuelLevel: command Vehicle.UpdateFuelLevel is {
      send updateFuelLevel to outlet VehicleContext.VehicleCommandStreamOut
    }
    on assignDriver: command Vehicle.AssignDriver is {
      send assignDriver to outlet VehicleContext.VehicleCommandStreamOut
    }
    on unassignDriver: command Vehicle.UnassignDriver is {
      send unassignDriver to outlet VehicleContext.VehicleCommandStreamOut
    }
    on startTrip: command Vehicle.StartTrip is {
      send startTrip to outlet VehicleContext.VehicleCommandStreamOut
    }
    on endTrip: command Vehicle.EndTrip is {
      send endTrip to outlet VehicleContext.VehicleCommandStreamOut
    }
    on scheduleMaintenance: command Vehicle.ScheduleMaintenance is {
      send scheduleMaintenance to outlet VehicleContext.VehicleCommandStreamOut
    }
    on startMaintenance: command Vehicle.StartMaintenance is {
      send startMaintenance to outlet VehicleContext.VehicleCommandStreamOut
    }
    on completeMaintenance: command Vehicle.CompleteMaintenance is {
      send completeMaintenance to outlet VehicleContext.VehicleCommandStreamOut
    }
    on raiseAlert: command Vehicle.RaiseAlert is {
      send raiseAlert to outlet VehicleContext.VehicleCommandStreamOut
    }
    on acknowledgeAlert: command Vehicle.AcknowledgeAlert is {
      send acknowledgeAlert to outlet VehicleContext.VehicleCommandStreamOut
    }
    on decommissionVehicle: command Vehicle.DecommissionVehicle is {
      send decommissionVehicle to outlet VehicleContext.VehicleCommandStreamOut
    }
    on vehicleResult: result Vehicle.VehicleResult is {
      send vehicleResult to outlet VehicleContext.VehicleResultStreamOut
    }
    on other is {
      error "Unexpected message at the VehicleContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'VehicleCommand Stream Intake' is from outlet VehicleContext.VehicleCommandStreamOut to inlet VehicleContext.Vehicle.VehicleCommands  connector 'VehicleResult Stream Egress' is from outlet VehicleContext.VehicleRepository.VehicleRepositoryResponses to inlet VehicleContext.VehicleResultStreamIn  adaptor FromAlertNotificationService from context AlertNotificationService is { 
    handler FromAlertNotificationServiceHandler is {
      on event AlertNotificationService.AlertSent is {
        do "the model receives alert sent"
      }
      on event AlertNotificationService.MaintenanceReminderSent is {
        do "the model receives maintenance reminder sent"
      }
      on other is {
        error "Unexpected message for adaptor FromAlertNotificationService"
      }
    } with {
      briefly "from alert notification service"
      described as {
        |Carries messages from the external AlertNotificationService.
      }
    }
  } with {
    briefly "AlertNotificationService integration"
    described as {
      |The model's side of the AlertNotificationService conversation.
    }
  }
  adaptor ToAlertNotificationService to context AlertNotificationService is { 
    handler ToAlertNotificationServiceHandler is {
      on command AlertNotificationService.SendAlert is {
        do "the model sends send alert"
      }
      on command AlertNotificationService.SendMaintenanceReminder is {
        do "the model sends send maintenance reminder"
      }
      on other is {
        error "Unexpected message for adaptor ToAlertNotificationService"
      }
    } with {
      briefly "to alert notification service"
      described as {
        |Carries messages to the external AlertNotificationService.
      }
    }
  } with {
    briefly "AlertNotificationService integration"
    described as {
      |The model's side of the AlertNotificationService conversation.
    }
  }
  adaptor FromDriverManagementService from context DriverManagementService is { 
    handler FromDriverManagementServiceHandler is {
      on result DriverManagementService.AvailableDrivers is {
        do "the model receives available drivers"
      }
      on result DriverManagementService.DriverDetails is {
        do "the model receives driver details"
      }
      on event DriverManagementService.DrivingHoursLogged is {
        do "the model receives driving hours logged"
      }
      on other is {
        error "Unexpected message for adaptor FromDriverManagementService"
      }
    } with {
      briefly "from driver management service"
      described as {
        |Carries messages from the external DriverManagementService.
      }
    }
  } with {
    briefly "DriverManagementService integration"
    described as {
      |The model's side of the DriverManagementService conversation.
    }
  }
  adaptor ToDriverManagementService to context DriverManagementService is { 
    handler ToDriverManagementServiceHandler is {
      on query DriverManagementService.GetAvailableDrivers is {
        do "the model sends get available drivers"
      }
      on query DriverManagementService.GetDriverInfo is {
        do "the model sends get driver info"
      }
      on command DriverManagementService.LogDrivingHours is {
        do "the model sends log driving hours"
      }
      on other is {
        error "Unexpected message for adaptor ToDriverManagementService"
      }
    } with {
      briefly "to driver management service"
      described as {
        |Carries messages to the external DriverManagementService.
      }
    }
  } with {
    briefly "DriverManagementService integration"
    described as {
      |The model's side of the DriverManagementService conversation.
    }
  }
  adaptor FromFuelCardService from context FuelCardService is { 
    handler FromFuelCardServiceHandler is {
      on event FuelCardService.FuelPurchaseAuthorized is {
        do "the model receives fuel purchase authorized"
      }
      on event FuelCardService.FuelPurchaseCompleted is {
        do "the model receives fuel purchase completed"
      }
      on other is {
        error "Unexpected message for adaptor FromFuelCardService"
      }
    } with {
      briefly "from fuel card service"
      described as {
        |Carries messages from the external FuelCardService.
      }
    }
  } with {
    briefly "FuelCardService integration"
    described as {
      |The model's side of the FuelCardService conversation.
    }
  }
  adaptor ToFuelCardService to context FuelCardService is { 
    handler ToFuelCardServiceHandler is {
      on command FuelCardService.AuthorizeFuelPurchase is {
        do "the model sends authorize fuel purchase"
      }
      on other is {
        error "Unexpected message for adaptor ToFuelCardService"
      }
    } with {
      briefly "to fuel card service"
      described as {
        |Carries messages to the external FuelCardService.
      }
    }
  } with {
    briefly "FuelCardService integration"
    described as {
      |The model's side of the FuelCardService conversation.
    }
  }
  adaptor FromGpsTrackingService from context GpsTrackingService is { 
    handler FromGpsTrackingServiceHandler is {
      on event GpsTrackingService.LocationReceived is {
        do "the model receives location received"
      }
      on event GpsTrackingService.TrackingStarted is {
        do "the model receives tracking started"
      }
      on event GpsTrackingService.TrackingStopped is {
        do "the model receives tracking stopped"
      }
      on other is {
        error "Unexpected message for adaptor FromGpsTrackingService"
      }
    } with {
      briefly "from gps tracking service"
      described as {
        |Carries messages from the external GpsTrackingService.
      }
    }
  } with {
    briefly "GpsTrackingService integration"
    described as {
      |The model's side of the GpsTrackingService conversation.
    }
  }
  adaptor ToGpsTrackingService to context GpsTrackingService is { 
    handler ToGpsTrackingServiceHandler is {
      on command GpsTrackingService.StartTracking is {
        do "the model sends start tracking"
      }
      on command GpsTrackingService.StopTracking is {
        do "the model sends stop tracking"
      }
      on other is {
        error "Unexpected message for adaptor ToGpsTrackingService"
      }
    } with {
      briefly "to gps tracking service"
      described as {
        |Carries messages to the external GpsTrackingService.
      }
    }
  } with {
    briefly "GpsTrackingService integration"
    described as {
      |The model's side of the GpsTrackingService conversation.
    }
  }
  adaptor FromInsuranceService from context InsuranceService is { 
    handler FromInsuranceServiceHandler is {
      on event InsuranceService.IncidentReportFiled is {
        do "the model receives incident report filed"
      }
      on result InsuranceService.VehicleCoverage is {
        do "the model receives vehicle coverage"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceService"
      }
    } with {
      briefly "from insurance service"
      described as {
        |Carries messages from the external InsuranceService.
      }
    }
  } with {
    briefly "InsuranceService integration"
    described as {
      |The model's side of the InsuranceService conversation.
    }
  }
  adaptor ToInsuranceService to context InsuranceService is { 
    handler ToInsuranceServiceHandler is {
      on command InsuranceService.FileIncidentReport is {
        do "the model sends file incident report"
      }
      on query InsuranceService.GetVehicleCoverage is {
        do "the model sends get vehicle coverage"
      }
      on other is {
        error "Unexpected message for adaptor ToInsuranceService"
      }
    } with {
      briefly "to insurance service"
      described as {
        |Carries messages to the external InsuranceService.
      }
    }
  } with {
    briefly "InsuranceService integration"
    described as {
      |The model's side of the InsuranceService conversation.
    }
  }
  adaptor FromMaintenanceServiceProvider from context MaintenanceServiceProvider is { 
    handler FromMaintenanceServiceProviderHandler is {
      on result MaintenanceServiceProvider.AvailableSlots is {
        do "the model receives available slots"
      }
      on event MaintenanceServiceProvider.ServiceBooked is {
        do "the model receives service booked"
      }
      on event MaintenanceServiceProvider.ServiceCompleted is {
        do "the model receives service completed"
      }
      on other is {
        error "Unexpected message for adaptor FromMaintenanceServiceProvider"
      }
    } with {
      briefly "from maintenance service provider"
      described as {
        |Carries messages from the external MaintenanceServiceProvider.
      }
    }
  } with {
    briefly "MaintenanceServiceProvider integration"
    described as {
      |The model's side of the MaintenanceServiceProvider conversation.
    }
  }
  adaptor ToMaintenanceServiceProvider to context MaintenanceServiceProvider is { 
    handler ToMaintenanceServiceProviderHandler is {
      on command MaintenanceServiceProvider.BookService is {
        do "the model sends book service"
      }
      on query MaintenanceServiceProvider.GetAvailableSlots is {
        do "the model sends get available slots"
      }
      on other is {
        error "Unexpected message for adaptor ToMaintenanceServiceProvider"
      }
    } with {
      briefly "to maintenance service provider"
      described as {
        |Carries messages to the external MaintenanceServiceProvider.
      }
    }
  } with {
    briefly "MaintenanceServiceProvider integration"
    described as {
      |The model's side of the MaintenanceServiceProvider conversation.
    }
  }
  include "types.riddl"
  include "Vehicle.riddl"
  // Repository for vehicle persistence
  type VehicleRepositoryCommand is one of {
    VehicleContext.VehicleRepository.PersistAlertAcknowledged or VehicleContext.VehicleRepository.PersistAlertRaised or VehicleContext.VehicleRepository.PersistDriverAssigned or VehicleContext.VehicleRepository.PersistDriverUnassigned or VehicleContext.VehicleRepository.PersistFuelLevelUpdated or VehicleContext.VehicleRepository.PersistLocationUpdated or VehicleContext.VehicleRepository.PersistMaintenanceCompleted or VehicleContext.VehicleRepository.PersistMaintenanceScheduled or VehicleContext.VehicleRepository.PersistMaintenanceStarted or VehicleContext.VehicleRepository.PersistOdometerUpdated or VehicleContext.VehicleRepository.PersistTripEnded or VehicleContext.VehicleRepository.PersistTripStarted or VehicleContext.VehicleRepository.PersistVehicleDecommissioned or VehicleContext.VehicleRepository.PersistVehicleRegistered
  } with {
    briefly "Anything that writes VehicleRepository"
    described as {
      |The persistence commands VehicleRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository VehicleRepository as flow is {
    inlet VehicleRepositoryFromFleetAnalytics is type VehicleRepositoryCommand
    command PersistDriverAssigned is  {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row DriverAssigned applies to.
        }
      }
    } with {
      briefly "Persist DriverAssigned"
      described as {
        |Instructs this repository to apply DriverAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDriverUnassigned is  {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row DriverUnassigned applies to.
        }
      }
    } with {
      briefly "Persist DriverUnassigned"
      described as {
        |Instructs this repository to apply DriverUnassigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFuelLevelUpdated is  {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row FuelLevelUpdated applies to.
        }
      }
    } with {
      briefly "Persist FuelLevelUpdated"
      described as {
        |Instructs this repository to apply FuelLevelUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLocationUpdated is  {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row LocationUpdated applies to.
        }
      }
    } with {
      briefly "Persist LocationUpdated"
      described as {
        |Instructs this repository to apply LocationUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceScheduled is  {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceScheduled applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceScheduled"
      described as {
        |Instructs this repository to apply MaintenanceScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceStarted is  {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceStarted applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceStarted"
      described as {
        |Instructs this repository to apply MaintenanceStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOdometerUpdated is  {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row OdometerUpdated applies to.
        }
      }
    } with {
      briefly "Persist OdometerUpdated"
      described as {
        |Instructs this repository to apply OdometerUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVehicleDecommissioned is  {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row VehicleDecommissioned applies to.
        }
      }
    } with {
      briefly "Persist VehicleDecommissioned"
      described as {
        |Instructs this repository to apply VehicleDecommissioned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAlertAcknowledged is  {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlertAcknowledged applies to.
        }
      }
    } with {
      briefly "Persist AlertAcknowledged"
      described as {
        |Instructs this repository to apply AlertAcknowledged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAlertRaised is  {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlertRaised applies to.
        }
      }
    } with {
      briefly "Persist AlertRaised"
      described as {
        |Instructs this repository to apply AlertRaised to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceCompleted is  {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceCompleted applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceCompleted"
      described as {
        |Instructs this repository to apply MaintenanceCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTripEnded is  {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row TripEnded applies to.
        }
      }
    } with {
      briefly "Persist TripEnded"
      described as {
        |Instructs this repository to apply TripEnded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTripStarted is  {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row TripStarted applies to.
        }
      }
    } with {
      briefly "Persist TripStarted"
      described as {
        |Instructs this repository to apply TripStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVehicleRegistered is  {
      vehicleId: VehicleId with {
        briefly "Row addressed"
        described as {
          |Which stored row VehicleRegistered applies to.
        }
      }
    } with {
      briefly "Persist VehicleRegistered"
      described as {
        |Instructs this repository to apply VehicleRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet VehicleRepositoryResponses is result Vehicle.VehicleResult
    record StoredVehicle is  {
      vehicleId: VehicleId with {
        briefly "vehicleId"
        described as {
          |The vehicleId column of the stored vehicle row.
        }
      }
      assignedDriver: DriverInfo? with {
        briefly "assignedDriver"
        described as {
          |The assignedDriver column of the stored vehicle row.
        }
      }
      status: VehicleStatus with {
        briefly "status"
        described as {
          |The status column of the stored vehicle row.
        }
      }
      vehicleInfo: VehicleInfo with {
        briefly "vehicleInfo"
        described as {
          |The vehicleInfo column of the stored vehicle row.
        }
      }
    } with {
      briefly "Stored vehicle row"
      described as {
        |The persistence shape of vehicle data as this repository stores it.
      }
    }
    schema VehicleData is relational
      of vehicles as record StoredVehicle
        index on field StoredVehicle.vehicleId
        index on field StoredVehicle.vehicleInfo.licensePlate
        index on field StoredVehicle.assignedDriver.driverId
        index on field StoredVehicle.status
 with {
      briefly "Vehicle data schema"
      described as {
        |The relational schema holding vehicle data for the VehicleRepository.
      }
    }
    handler VehiclePersistence is {
      on persistDriverAssigned: command PersistDriverAssigned is {
        do "apply DriverAssigned to the stored row"
      }
      on persistDriverUnassigned: command PersistDriverUnassigned is {
        do "apply DriverUnassigned to the stored row"
      }
      on persistFuelLevelUpdated: command PersistFuelLevelUpdated is {
        do "apply FuelLevelUpdated to the stored row"
      }
      on persistLocationUpdated: command PersistLocationUpdated is {
        do "apply LocationUpdated to the stored row"
      }
      on persistMaintenanceScheduled: command PersistMaintenanceScheduled is {
        do "apply MaintenanceScheduled to the stored row"
      }
      on persistMaintenanceStarted: command PersistMaintenanceStarted is {
        do "apply MaintenanceStarted to the stored row"
      }
      on persistOdometerUpdated: command PersistOdometerUpdated is {
        do "apply OdometerUpdated to the stored row"
      }
      on persistVehicleDecommissioned: command PersistVehicleDecommissioned is {
        do "apply VehicleDecommissioned to the stored row"
      }
      on persistAlertAcknowledged: command PersistAlertAcknowledged is {
        do "apply AlertAcknowledged to the stored row"
      }
      on persistAlertRaised: command PersistAlertRaised is {
        do "apply AlertRaised to the stored row"
      }
      on persistMaintenanceCompleted: command PersistMaintenanceCompleted is {
        do "apply MaintenanceCompleted to the stored row"
      }
      on persistTripEnded: command PersistTripEnded is {
        do "apply TripEnded to the stored row"
      }
      on persistTripStarted: command PersistTripStarted is {
        do "apply TripStarted to the stored row"
      }
      on persistVehicleRegistered: command PersistVehicleRegistered is {
        do "apply VehicleRegistered to the stored row"
      }
      on query GetFleetStats is {
        let fleetStatsView: type FleetStatsView = prompt("read the fleet stats projection")
        reply fleetStatsView
      }
    } with {
      briefly "Persists vehicle commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Vehicle data persistence"
    described as {
      | The VehicleRepository provides persistent storage for
      | vehicles and related data.
    }
  }
  // Projector for fleet analytics
  query GetFleetStats replies result FleetStatsView is  {
    fleetStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which fleet stats to retrieve.
      }
    }
  } with {
    briefly "Get fleet stats"
    described as {
      |Retrieves the fleet stats projection.
    }
  }
  result FleetStatsView is  {
    fleetStats: FleetAnalytics.FleetStats with {
      briefly "Fleet stats"
      described as {
        |The fleet stats being returned.
      }
    }
  } with {
    briefly "Fleet stats view"
    described as {
      |Read model view carrying the fleet stats projection.
    }
  }
  projector FleetAnalytics as flow is {
    outlet FleetAnalyticsToRepository is type VehicleRepositoryCommand
    updates repository VehicleContext.VehicleRepository
    inlet FleetAnalyticsFromVehicle is type VehicleEvent
    record FleetStats is  {
      totalVehicles: Natural with {
        briefly "Total"
        described as {
          |Total vehicles.
        }
      }
      availableVehicles: Natural with {
        briefly "Available"
        described as {
          |Available vehicles.
        }
      }
      inUseVehicles: Natural with {
        briefly "In use"
        described as {
          |Vehicles in use.
        }
      }
      inMaintenanceVehicles: Natural with {
        briefly "In maintenance"
        described as {
          |In maintenance.
        }
      }
      totalMileage: Natural with {
        briefly "Mileage"
        described as {
          |Total fleet mileage.
        }
      }
      maintenanceCosts: Decimal(12,2) with {
        briefly "Maintenance costs"
        described as {
          |Total maintenance costs.
        }
      }
      activeAlertCount: Natural with {
        briefly "Alerts"
        described as {
          |Active alert count.
        }
      }
    } with {
      briefly "Fleet statistics"
      described as {
        |Fleet operational metrics.
      }
    }
    handler AnalyticsHandler is {
      on driverAssigned: event Vehicle.DriverAssigned is {
        tell command VehicleContext.VehicleRepository.PersistDriverAssigned(vehicleId = driverAssigned.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply DriverAssigned to the FleetAnalytics projection"
      }
      on driverUnassigned: event Vehicle.DriverUnassigned is {
        tell command VehicleContext.VehicleRepository.PersistDriverUnassigned(vehicleId = driverUnassigned.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply DriverUnassigned to the FleetAnalytics projection"
      }
      on fuelLevelUpdated: event Vehicle.FuelLevelUpdated is {
        tell command VehicleContext.VehicleRepository.PersistFuelLevelUpdated(vehicleId = fuelLevelUpdated.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply FuelLevelUpdated to the FleetAnalytics projection"
      }
      on locationUpdated: event Vehicle.LocationUpdated is {
        tell command VehicleContext.VehicleRepository.PersistLocationUpdated(vehicleId = locationUpdated.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply LocationUpdated to the FleetAnalytics projection"
      }
      on maintenanceScheduled: event Vehicle.MaintenanceScheduled is {
        tell command VehicleContext.VehicleRepository.PersistMaintenanceScheduled(vehicleId = maintenanceScheduled.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply MaintenanceScheduled to the FleetAnalytics projection"
      }
      on maintenanceStarted: event Vehicle.MaintenanceStarted is {
        tell command VehicleContext.VehicleRepository.PersistMaintenanceStarted(vehicleId = maintenanceStarted.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply MaintenanceStarted to the FleetAnalytics projection"
      }
      on odometerUpdated: event Vehicle.OdometerUpdated is {
        tell command VehicleContext.VehicleRepository.PersistOdometerUpdated(vehicleId = odometerUpdated.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply OdometerUpdated to the FleetAnalytics projection"
      }
      on vehicleDecommissioned: event Vehicle.VehicleDecommissioned is {
        tell command VehicleContext.VehicleRepository.PersistVehicleDecommissioned(vehicleId = vehicleDecommissioned.vehicleId) to repository VehicleContext.VehicleRepository
        do "apply VehicleDecommissioned to the FleetAnalytics projection"
      }
      on vehicleRegistered: event Vehicle.VehicleRegistered is {
        tell command VehicleContext.VehicleRepository.PersistVehicleRegistered(vehicleId = vehicleRegistered.vehicleId) to repository VehicleContext.VehicleRepository
        do "Update vehicle counts"
      }
      on tripStarted: event Vehicle.TripStarted is {
        tell command VehicleContext.VehicleRepository.PersistTripStarted(vehicleId = tripStarted.vehicleId) to repository VehicleContext.VehicleRepository
        do "Update in-use counts"
      }
      on tripEnded: event Vehicle.TripEnded is {
        tell command VehicleContext.VehicleRepository.PersistTripEnded(vehicleId = tripEnded.vehicleId) to repository VehicleContext.VehicleRepository
        do "Update mileage and availability"
      }
      on maintenanceCompleted: event Vehicle.MaintenanceCompleted is {
        tell command VehicleContext.VehicleRepository.PersistMaintenanceCompleted(vehicleId = maintenanceCompleted.vehicleId) to repository VehicleContext.VehicleRepository
        do "Update maintenance costs"
      }
      on alertRaised: event Vehicle.AlertRaised is {
        tell command VehicleContext.VehicleRepository.PersistAlertRaised(vehicleId = alertRaised.vehicleId) to repository VehicleContext.VehicleRepository
        do "Update alert counts"
      }
      on alertAcknowledged: event Vehicle.AlertAcknowledged is {
        tell command VehicleContext.VehicleRepository.PersistAlertAcknowledged(vehicleId = alertAcknowledged.vehicleId) to repository VehicleContext.VehicleRepository
        do "Update acknowledged alerts"
      }
    } with {
      briefly "Maintains fleet analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Fleet analytics projections"
    described as {
      |Maintains fleet operational analytics data.
    }
  }
  // ---- Event publication for Vehicle ----
  type VehicleEvent is one of {
    VehicleContext.Vehicle.VehicleRegistered or VehicleContext.Vehicle.LocationUpdated or VehicleContext.Vehicle.OdometerUpdated or VehicleContext.Vehicle.FuelLevelUpdated or VehicleContext.Vehicle.DriverAssigned or VehicleContext.Vehicle.DriverUnassigned or VehicleContext.Vehicle.TripStarted or VehicleContext.Vehicle.TripEnded or VehicleContext.Vehicle.MaintenanceScheduled or VehicleContext.Vehicle.MaintenanceStarted or VehicleContext.Vehicle.MaintenanceCompleted or VehicleContext.Vehicle.AlertRaised or VehicleContext.Vehicle.AlertAcknowledged or VehicleContext.Vehicle.VehicleDecommissioned
  } with {
    briefly "Vehicle event alternation"
    described as {
      |Union of all Vehicle events, for streaming and event-sourced
      |persistence.
    }
  }
  processor VehicleEventSplit as flow is {
    inlet VehicleEventSplitIn is type VehicleEvent
    outlet VehicleEventSplitToFleetAnalytics is type VehicleEvent
    handler VehicleEventSplitHandler is {
      on vehicleRegistered: event Vehicle.VehicleRegistered is {
        send vehicleRegistered to outlet VehicleEventSplitToFleetAnalytics
        tell vehicleRegistered to entity VehicleContext.Vehicle
      }
      on locationUpdated: event Vehicle.LocationUpdated is {
        send locationUpdated to outlet VehicleEventSplitToFleetAnalytics
        tell locationUpdated to entity VehicleContext.Vehicle
      }
      on odometerUpdated: event Vehicle.OdometerUpdated is {
        send odometerUpdated to outlet VehicleEventSplitToFleetAnalytics
        tell odometerUpdated to entity VehicleContext.Vehicle
      }
      on fuelLevelUpdated: event Vehicle.FuelLevelUpdated is {
        send fuelLevelUpdated to outlet VehicleEventSplitToFleetAnalytics
        tell fuelLevelUpdated to entity VehicleContext.Vehicle
      }
      on driverAssigned: event Vehicle.DriverAssigned is {
        send driverAssigned to outlet VehicleEventSplitToFleetAnalytics
        tell driverAssigned to entity VehicleContext.Vehicle
      }
      on driverUnassigned: event Vehicle.DriverUnassigned is {
        send driverUnassigned to outlet VehicleEventSplitToFleetAnalytics
        tell driverUnassigned to entity VehicleContext.Vehicle
      }
      on tripStarted: event Vehicle.TripStarted is {
        send tripStarted to outlet VehicleEventSplitToFleetAnalytics
        tell tripStarted to entity VehicleContext.Vehicle
      }
      on tripEnded: event Vehicle.TripEnded is {
        send tripEnded to outlet VehicleEventSplitToFleetAnalytics
        tell tripEnded to entity VehicleContext.Vehicle
      }
      on maintenanceScheduled: event Vehicle.MaintenanceScheduled is {
        send maintenanceScheduled to outlet VehicleEventSplitToFleetAnalytics
        tell maintenanceScheduled to entity VehicleContext.Vehicle
      }
      on maintenanceStarted: event Vehicle.MaintenanceStarted is {
        send maintenanceStarted to outlet VehicleEventSplitToFleetAnalytics
        tell maintenanceStarted to entity VehicleContext.Vehicle
      }
      on maintenanceCompleted: event Vehicle.MaintenanceCompleted is {
        send maintenanceCompleted to outlet VehicleEventSplitToFleetAnalytics
        tell maintenanceCompleted to entity VehicleContext.Vehicle
      }
      on alertRaised: event Vehicle.AlertRaised is {
        send alertRaised to outlet VehicleEventSplitToFleetAnalytics
        tell alertRaised to entity VehicleContext.Vehicle
      }
      on alertAcknowledged: event Vehicle.AlertAcknowledged is {
        send alertAcknowledged to outlet VehicleEventSplitToFleetAnalytics
        tell alertAcknowledged to entity VehicleContext.Vehicle
      }
      on vehicleDecommissioned: event Vehicle.VehicleDecommissioned is {
        send vehicleDecommissioned to outlet VehicleEventSplitToFleetAnalytics
        tell vehicleDecommissioned to entity VehicleContext.Vehicle
      }
      on other is {
        error "Unexpected message for processor VehicleEventSplit"
      }
    } with {
      briefly "Vehicle event fan-out handler"
      described as {
        |Delivers each Vehicle event to all of its consumers.
      }
    }
  } with {
    briefly "Vehicle event fan-out"
    described as {
      |Fans Vehicle events out to the repository and projectors.
    }
  }
  connector 'VehicleEvent Stream' is from outlet VehicleContext.Vehicle.VehicleEvents2 to inlet VehicleContext.VehicleEventSplit.VehicleEventSplitIn with {
    briefly "Vehicle events, fanned out to storage and read models"
  }
  connector 'FleetAnalytics Feed' is from outlet VehicleContext.VehicleEventSplit.VehicleEventSplitToFleetAnalytics to inlet VehicleContext.FleetAnalytics.FleetAnalyticsFromVehicle with {
    briefly "Vehicle events feeding the FleetAnalytics projection"
  }
  connector 'FleetAnalytics Storage' is from outlet VehicleContext.FleetAnalytics.FleetAnalyticsToRepository to inlet VehicleContext.VehicleRepository.VehicleRepositoryFromFleetAnalytics with {
    briefly "FleetAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for fleet management"
  described as {
    | The VehicleContext is the bounded context for
    | vehicle tracking and fleet operations.
  }
}
