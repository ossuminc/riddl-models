// Fleet Management Domain Model
// Vehicle fleet tracking and maintenance management
domain FleetManagement is {
  persistent connector 'InsuranceServiceReply Stream' is from outlet InsuranceService.InsuranceServiceRepliesOut to inlet VehicleContext.ToInsuranceService.ToInsuranceServiceReplies with {
    briefly "What InsuranceService answers VehicleContext"
  }
  persistent connector 'DriverManagementServiceReply Stream' is from outlet DriverManagementService.DriverManagementServiceRepliesOut to inlet VehicleContext.ToDriverManagementService.ToDriverManagementServiceReplies with {
    briefly "What DriverManagementService answers VehicleContext"
  }
  persistent connector 'DriverManagementServiceEvent Stream' is from outlet DriverManagementService.DriverManagementServiceEventsOut to inlet VehicleContext.FromDriverManagementService.FromDriverManagementServiceIn with {
    briefly "What DriverManagementService tells VehicleContext, unasked"
  }
  persistent connector 'FuelCardServiceEvent Stream' is from outlet FuelCardService.FuelCardServiceEventsOut to inlet VehicleContext.FromFuelCardService.FromFuelCardServiceIn with {
    briefly "What FuelCardService tells VehicleContext, unasked"
  }
  persistent connector 'GpsTrackingServiceEvent Stream' is from outlet GpsTrackingService.GpsTrackingServiceEventsOut to inlet VehicleContext.FromGpsTrackingService.FromGpsTrackingServiceIn with {
    briefly "What GpsTrackingService tells VehicleContext, unasked"
  }
  persistent connector 'InsuranceServiceEvent Stream' is from outlet InsuranceService.InsuranceServiceEventsOut to inlet VehicleContext.FromInsuranceService.FromInsuranceServiceIn with {
    briefly "What InsuranceService tells VehicleContext, unasked"
  }
  persistent connector 'MaintenanceServiceProviderEvent Stream' is from outlet MaintenanceServiceProvider.MaintenanceServiceProviderEventsOut to inlet VehicleContext.FromMaintenanceServiceProvider.FromMaintenanceServiceProviderIn with {
    briefly "What MaintenanceServiceProvider tells VehicleContext, unasked"
  }
  persistent connector 'MaintenanceServiceProviderRequest Stream' is from outlet VehicleContext.ToMaintenanceServiceProvider.ToMaintenanceServiceProviderOut to inlet MaintenanceServiceProvider.MaintenanceServiceProviderRequests with {
    briefly "What VehicleContext asks MaintenanceServiceProvider to send"
  }
  persistent connector 'FuelCardServiceRequest Stream' is from outlet VehicleContext.ToFuelCardService.ToFuelCardServiceOut to inlet FuelCardService.FuelCardServiceRequests with {
    briefly "What VehicleContext asks FuelCardService to send"
  }
  persistent connector 'InsuranceServiceRequest Stream' is from outlet VehicleContext.ToInsuranceService.ToInsuranceServiceOut to inlet InsuranceService.InsuranceServiceRequests with {
    briefly "What VehicleContext asks InsuranceService to send"
  }
  persistent connector 'DriverManagementServiceRequest Stream' is from outlet VehicleContext.ToDriverManagementService.ToDriverManagementServiceOut to inlet DriverManagementService.DriverManagementServiceRequests with {
    briefly "What VehicleContext asks DriverManagementService to send"
  }
  persistent connector 'GpsTrackingServiceRequest Stream' is from outlet VehicleContext.ToGpsTrackingService.ToGpsTrackingServiceOut to inlet GpsTrackingService.GpsTrackingServiceRequests with {
    briefly "What VehicleContext asks GpsTrackingService to send"
  }
  persistent connector 'AlertNotificationServiceRequest Stream' is from outlet VehicleContext.ToAlertNotificationService.ToAlertNotificationServiceOut to inlet AlertNotificationService.AlertNotificationServiceRequests with {
    briefly "What VehicleContext asks AlertNotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user FleetManager is "person managing vehicle fleet" with {
    briefly "Fleet Manager"
    described as {
      |Person overseeing fleet operations.
    }
  }
  user Driver is "person operating vehicle" with {
    briefly "Driver"
    described as {
      |Vehicle operator.
    }
  }
  user Mechanic is "person maintaining vehicles" with {
    briefly "Mechanic"
    described as {
      |Maintenance technician.
    }
  }
  epic FleetEpic is {
    user FleetManager wants to "to manage the vehicle fleet" so that "vehicles are available and well-maintained"
    case TrackVehicle is {
      user FleetManager wants to "to track vehicle status and location" so that "I know where vehicles are"
      step is "System receives" "GPS location update" "from vehicle" with {
        briefly "Receive location"
        described as {
          |Get GPS data.
        }
      }
      step take input FleetManagementApp.FleetManagementScreen.UpdateLocationInput from user FleetManager with {
        briefly "Update location"
        described as {
          |Update vehicle position.
        }
      }
      step is "Manager views" "vehicle on map" "in dashboard" with {
        briefly "View map"
        described as {
          |Display on map.
        }
      }
    } with {
      briefly "Track vehicle"
      described as {
        |Tracking vehicle locations.
      }
    }
  } with {
    briefly "Fleet management"
    described as {
      | Epic covering vehicle tracking, maintenance,
      | and fleet optimization.
    }
  }
  include "VehicleContext.riddl"
  include "external-contexts.riddl"
  application context FleetManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in FleetManagement are delivered.
      }
    }
    group FleetManagementScreen is {
      input UpdateLocationInput acquires command VehicleContext.Vehicle.UpdateLocation with {
        briefly "Update location control"
        described as {
          |The control through which a user submits the update location request.
        }
      }
    } with {
      briefly "Fleet management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppVehicleCommands is type VehicleContext.Vehicle.VehicleCommand
    inlet AppVehicleRepositoryResponses is result VehicleContext.Vehicle.VehicleResult    handler FleetManagementAppHandler is {
      on other is {
        error "Unexpected message for application context FleetManagementApp"
      }
    } with {
      briefly "FleetManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "FleetManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'VehicleCommand Stream' is from outlet FleetManagementApp.AppVehicleCommands to inlet VehicleContext.VehicleCommandStreamIn with {
    briefly "Vehicle commands from the application"
  }
  persistent connector 'VehicleResult Stream' is from outlet VehicleContext.VehicleResultStreamOut to inlet FleetManagementApp.AppVehicleRepositoryResponses with {
    briefly "Vehicle query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet FleetManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Fleet management domain"
  described as {
    | The FleetManagement domain handles vehicle
    | tracking, maintenance, and fleet operations.
  }
}
