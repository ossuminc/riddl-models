// Route Optimization - Route Context
context RouteContext as router is {
  inlet RouteCommandStreamIn is type RouteCommand  outlet RouteCommandStreamOut is type RouteCommand
  inlet RouteResultStreamIn is type Route.RouteResult  outlet RouteResultStreamOut is type Route.RouteResult
  handler RouteContextBoundary is {
    on createRoute: command Route.CreateRoute is {
      send createRoute to outlet RouteContext.RouteCommandStreamOut
    }
    on addStop: command Route.AddStop is {
      send addStop to outlet RouteContext.RouteCommandStreamOut
    }
    on removeStop: command Route.RemoveStop is {
      send removeStop to outlet RouteContext.RouteCommandStreamOut
    }
    on optimizeRoute: command Route.OptimizeRoute is {
      send optimizeRoute to outlet RouteContext.RouteCommandStreamOut
    }
    on reorderStops: command Route.ReorderStops is {
      send reorderStops to outlet RouteContext.RouteCommandStreamOut
    }
    on assignDriver: command Route.AssignDriver is {
      send assignDriver to outlet RouteContext.RouteCommandStreamOut
    }
    on startRoute: command Route.StartRoute is {
      send startRoute to outlet RouteContext.RouteCommandStreamOut
    }
    on arriveAtStop: command Route.ArriveAtStop is {
      send arriveAtStop to outlet RouteContext.RouteCommandStreamOut
    }
    on completeStop: command Route.CompleteStop is {
      send completeStop to outlet RouteContext.RouteCommandStreamOut
    }
    on skipStop: command Route.SkipStop is {
      send skipStop to outlet RouteContext.RouteCommandStreamOut
    }
    on recordDeliveryFailure: command Route.RecordDeliveryFailure is {
      send recordDeliveryFailure to outlet RouteContext.RouteCommandStreamOut
    }
    on completeRoute: command Route.CompleteRoute is {
      send completeRoute to outlet RouteContext.RouteCommandStreamOut
    }
    on cancelRoute: command Route.CancelRoute is {
      send cancelRoute to outlet RouteContext.RouteCommandStreamOut
    }
    on routeResult: result Route.RouteResult is {
      send routeResult to outlet RouteContext.RouteResultStreamOut
    }
    on other is {
      error "Unexpected message at the RouteContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'RouteCommand Stream Intake' is from outlet RouteContext.RouteCommandStreamOut to inlet RouteContext.Route.RouteCommands  connector 'RouteResult Stream Egress' is from outlet RouteContext.RouteRepository.RouteRepositoryResponses to inlet RouteContext.RouteResultStreamIn  adaptor FromCustomerNotificationService from context CustomerNotificationService is { 
    handler FromCustomerNotificationServiceHandler is {
      on event CustomerNotificationService.ConfirmationSent is {
        do "the model receives confirmation sent"
      }
      on event CustomerNotificationService.EtaSent is {
        do "the model receives eta sent"
      }
      on event CustomerNotificationService.FailureNoticeSent is {
        do "the model receives failure notice sent"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerNotificationService"
      }
    } with {
      briefly "from customer notification service"
      described as {
        |Carries messages from the external CustomerNotificationService.
      }
    }
  } with {
    briefly "CustomerNotificationService integration"
    described as {
      |The model's side of the CustomerNotificationService conversation.
    }
  }
  adaptor ToCustomerNotificationService to context CustomerNotificationService is { 
    handler ToCustomerNotificationServiceHandler is {
      on command CustomerNotificationService.SendDeliveryConfirmation is {
        do "the model sends send delivery confirmation"
      }
      on command CustomerNotificationService.SendDeliveryEta is {
        do "the model sends send delivery eta"
      }
      on command CustomerNotificationService.SendDeliveryFailureNotice is {
        do "the model sends send delivery failure notice"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerNotificationService"
      }
    } with {
      briefly "to customer notification service"
      described as {
        |Carries messages to the external CustomerNotificationService.
      }
    }
  } with {
    briefly "CustomerNotificationService integration"
    described as {
      |The model's side of the CustomerNotificationService conversation.
    }
  }
  adaptor FromDriverMobileAppService from context DriverMobileAppService is { 
    handler FromDriverMobileAppServiceHandler is {
      on event DriverMobileAppService.NavigationUpdateSent is {
        do "the model receives navigation update sent"
      }
      on event DriverMobileAppService.RouteReceivedByDriver is {
        do "the model receives route received by driver"
      }
      on other is {
        error "Unexpected message for adaptor FromDriverMobileAppService"
      }
    } with {
      briefly "from driver mobile app service"
      described as {
        |Carries messages from the external DriverMobileAppService.
      }
    }
  } with {
    briefly "DriverMobileAppService integration"
    described as {
      |The model's side of the DriverMobileAppService conversation.
    }
  }
  adaptor ToDriverMobileAppService to context DriverMobileAppService is { 
    handler ToDriverMobileAppServiceHandler is {
      on command DriverMobileAppService.SendNavigationUpdate is {
        do "the model sends send navigation update"
      }
      on command DriverMobileAppService.SendRouteToDriver is {
        do "the model sends send route to driver"
      }
      on other is {
        error "Unexpected message for adaptor ToDriverMobileAppService"
      }
    } with {
      briefly "to driver mobile app service"
      described as {
        |Carries messages to the external DriverMobileAppService.
      }
    }
  } with {
    briefly "DriverMobileAppService integration"
    described as {
      |The model's side of the DriverMobileAppService conversation.
    }
  }
  adaptor FromGeocodingService from context GeocodingService is { 
    handler FromGeocodingServiceHandler is {
      on result GeocodingService.AddressResult is {
        do "the model receives address result"
      }
      on result GeocodingService.GeocodedLocation is {
        do "the model receives geocoded location"
      }
      on other is {
        error "Unexpected message for adaptor FromGeocodingService"
      }
    } with {
      briefly "from geocoding service"
      described as {
        |Carries messages from the external GeocodingService.
      }
    }
  } with {
    briefly "GeocodingService integration"
    described as {
      |The model's side of the GeocodingService conversation.
    }
  }
  adaptor ToGeocodingService to context GeocodingService is { 
    handler ToGeocodingServiceHandler is {
      on query GeocodingService.GeocodeAddress is {
        do "the model sends geocode address"
      }
      on query GeocodingService.ReverseGeocode is {
        do "the model sends reverse geocode"
      }
      on other is {
        error "Unexpected message for adaptor ToGeocodingService"
      }
    } with {
      briefly "to geocoding service"
      described as {
        |Carries messages to the external GeocodingService.
      }
    }
  } with {
    briefly "GeocodingService integration"
    described as {
      |The model's side of the GeocodingService conversation.
    }
  }
  adaptor FromOptimizationEngineService from context OptimizationEngineService is { 
    handler FromOptimizationEngineServiceHandler is {
      on event OptimizationEngineService.OptimizationCompleted is {
        do "the model receives optimization completed"
      }
      on other is {
        error "Unexpected message for adaptor FromOptimizationEngineService"
      }
    } with {
      briefly "from optimization engine service"
      described as {
        |Carries messages from the external OptimizationEngineService.
      }
    }
  } with {
    briefly "OptimizationEngineService integration"
    described as {
      |The model's side of the OptimizationEngineService conversation.
    }
  }
  adaptor ToOptimizationEngineService to context OptimizationEngineService is { 
    handler ToOptimizationEngineServiceHandler is {
      on command OptimizationEngineService.OptimizeStopSequence is {
        do "the model sends optimize stop sequence"
      }
      on command OptimizationEngineService.ReoptimizeRoute is {
        do "the model sends reoptimize route"
      }
      on other is {
        error "Unexpected message for adaptor ToOptimizationEngineService"
      }
    } with {
      briefly "to optimization engine service"
      described as {
        |Carries messages to the external OptimizationEngineService.
      }
    }
  } with {
    briefly "OptimizationEngineService integration"
    described as {
      |The model's side of the OptimizationEngineService conversation.
    }
  }
  adaptor FromRoutingEngineService from context RoutingEngineService is { 
    handler FromRoutingEngineServiceHandler is {
      on result RoutingEngineService.DistanceMatrix is {
        do "the model receives distance matrix"
      }
      on result RoutingEngineService.DrivingRoute is {
        do "the model receives driving route"
      }
      on other is {
        error "Unexpected message for adaptor FromRoutingEngineService"
      }
    } with {
      briefly "from routing engine service"
      described as {
        |Carries messages from the external RoutingEngineService.
      }
    }
  } with {
    briefly "RoutingEngineService integration"
    described as {
      |The model's side of the RoutingEngineService conversation.
    }
  }
  adaptor ToRoutingEngineService to context RoutingEngineService is { 
    handler ToRoutingEngineServiceHandler is {
      on query RoutingEngineService.CalculateRoute is {
        do "the model sends calculate route"
      }
      on query RoutingEngineService.GetDistanceMatrix is {
        do "the model sends get distance matrix"
      }
      on other is {
        error "Unexpected message for adaptor ToRoutingEngineService"
      }
    } with {
      briefly "to routing engine service"
      described as {
        |Carries messages to the external RoutingEngineService.
      }
    }
  } with {
    briefly "RoutingEngineService integration"
    described as {
      |The model's side of the RoutingEngineService conversation.
    }
  }
  adaptor FromTrafficService from context TrafficService is { 
    handler FromTrafficServiceHandler is {
      on event TrafficService.TrafficAlert is {
        do "the model receives traffic alert"
      }
      on result TrafficService.TrafficConditions is {
        do "the model receives traffic conditions"
      }
      on other is {
        error "Unexpected message for adaptor FromTrafficService"
      }
    } with {
      briefly "from traffic service"
      described as {
        |Carries messages from the external TrafficService.
      }
    }
  } with {
    briefly "TrafficService integration"
    described as {
      |The model's side of the TrafficService conversation.
    }
  }
  adaptor ToTrafficService to context TrafficService is { 
    handler ToTrafficServiceHandler is {
      on query TrafficService.GetTrafficConditions is {
        do "the model sends get traffic conditions"
      }
      on other is {
        error "Unexpected message for adaptor ToTrafficService"
      }
    } with {
      briefly "to traffic service"
      described as {
        |Carries messages to the external TrafficService.
      }
    }
  } with {
    briefly "TrafficService integration"
    described as {
      |The model's side of the TrafficService conversation.
    }
  }
  include "types.riddl"
  include "Route.riddl"
  // Repository for route persistence
  repository RouteRepository as merge is {
    command PersistDeliveryFailed is  {
      routeId: RouteId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryFailed applies to.
        }
      }
    } with {
      briefly "Persist DeliveryFailed"
      described as {
        |Instructs this repository to apply DeliveryFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRouteCompleted is  {
      routeId: RouteId with {
        briefly "Row addressed"
        described as {
          |Which stored row RouteCompleted applies to.
        }
      }
    } with {
      briefly "Persist RouteCompleted"
      described as {
        |Instructs this repository to apply RouteCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRouteCreated is  {
      routeId: RouteId with {
        briefly "Row addressed"
        described as {
          |Which stored row RouteCreated applies to.
        }
      }
    } with {
      briefly "Persist RouteCreated"
      described as {
        |Instructs this repository to apply RouteCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRouteOptimized is  {
      routeId: RouteId with {
        briefly "Row addressed"
        described as {
          |Which stored row RouteOptimized applies to.
        }
      }
    } with {
      briefly "Persist RouteOptimized"
      described as {
        |Instructs this repository to apply RouteOptimized to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStopCompleted is  {
      routeId: RouteId with {
        briefly "Row addressed"
        described as {
          |Which stored row StopCompleted applies to.
        }
      }
    } with {
      briefly "Persist StopCompleted"
      described as {
        |Instructs this repository to apply StopCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet RouteRepositoryFromRoute is type RouteEvent    inlet RouteRepositoryFromRouteAnalytics is type RouteEvent    outlet RouteRepositoryResponses is type Route.RouteResult
    record StoredRoute is  {
      routeId: RouteId with {
        briefly "routeId"
        described as {
          |The routeId column of the stored route row.
        }
      }
      driver: DriverInfo with {
        briefly "driver"
        described as {
          |The driver column of the stored route row.
        }
      }
      scheduledDate: Date with {
        briefly "scheduledDate"
        described as {
          |The scheduledDate column of the stored route row.
        }
      }
      status: RouteStatus with {
        briefly "status"
        described as {
          |The status column of the stored route row.
        }
      }
    } with {
      briefly "Stored route row"
      described as {
        |The persistence shape of route data as this repository stores it.
      }
    }
    schema RouteData is relational
      of routes as type StoredRoute
        index on field StoredRoute.routeId
        index on field StoredRoute.scheduledDate
        index on field StoredRoute.driver.driverId
        index on field StoredRoute.status
 with {
      briefly "Route data schema"
      described as {
        |The relational schema holding route data for the RouteRepository.
      }
    }
    handler RoutePersistence is {
      on persistDeliveryFailed: command PersistDeliveryFailed is {
        do "apply DeliveryFailed to the stored row"
      }
      on persistRouteCompleted: command PersistRouteCompleted is {
        do "apply RouteCompleted to the stored row"
      }
      on persistRouteCreated: command PersistRouteCreated is {
        do "apply RouteCreated to the stored row"
      }
      on persistRouteOptimized: command PersistRouteOptimized is {
        do "apply RouteOptimized to the stored row"
      }
      on persistStopCompleted: command PersistStopCompleted is {
        do "apply StopCompleted to the stored row"
      }
      on query GetRouteStats is {
        let routeStatsView: type RouteStatsView = prompt("read the route stats projection")
        reply routeStatsView
      }
      on createRoute: command Route.CreateRoute is {
        tell event Route.RouteCreated(routeId = createRoute.routeId, name = createRoute.name, scheduledDate = createRoute.scheduledDate, stops = createRoute.stops) to entity RouteContext.Route
        do "Store new route"
      }
      on addStop: command Route.AddStop is {
        tell event Route.StopAdded(routeId = addStop.routeId, stop = addStop.stop) to entity RouteContext.Route
        do "Add stop to route"
      }
      on removeStop: command Route.RemoveStop is {
        tell event Route.StopRemoved(routeId = removeStop.routeId, stopId = removeStop.stopId) to entity RouteContext.Route
        do "Remove stop from route"
      }
      on command Route.OptimizeRoute is {
        do "Update route optimization"
      }
      on command Route.ReorderStops is {
        do "Update stop sequence"
      }
      on assignDriver: command Route.AssignDriver is {
        tell event Route.DriverAssigned(routeId = assignDriver.routeId, driver = assignDriver.driver) to entity RouteContext.Route
        do "Store driver assignment"
      }
      on startRoute: command Route.StartRoute is {
        tell event Route.RouteStarted(routeId = startRoute.routeId, startedAt = startRoute.startedAt, startOdometer = startRoute.startOdometer) to entity RouteContext.Route
        do "Update to in progress"
      }
      on command Route.ArriveAtStop is {
        do "Update stop arrival"
      }
      on completeStop: command Route.CompleteStop is {
        tell event Route.StopCompleted(routeId = completeStop.routeId, completion = completeStop.completion) to entity RouteContext.Route
        do "Update stop completion"
      }
      on command Route.SkipStop is {
        do "Update stop to skipped"
      }
      on command Route.RecordDeliveryFailure is {
        do "Update stop to failed"
      }
      on completeRoute: command Route.CompleteRoute is {
        tell event Route.RouteCompleted(routeId = completeRoute.routeId, completedAt = completeRoute.completedAt, endOdometer = completeRoute.endOdometer) to entity RouteContext.Route
        do "Update to completed"
      }
      on cancelRoute: command Route.CancelRoute is {
        tell event Route.RouteCancelled(routeId = cancelRoute.routeId, reason = cancelRoute.reason) to entity RouteContext.Route
        do "Update to cancelled"
      }
    } with {
      briefly "Persists route commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Route data persistence"
    described as {
      | The RouteRepository provides persistent storage for
      | routes and related data.
    }
  }
  // Projector for route analytics
  query GetRouteStats is  {
    routeStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which route stats to retrieve.
      }
    }
  } with {
    briefly "Get route stats"
    described as {
      |Retrieves the route stats projection.
    }
  }
  result RouteStatsView is  {
    routeStats: RouteAnalytics.RouteStats with {
      briefly "Route stats"
      described as {
        |The route stats being returned.
      }
    }
  } with {
    briefly "Route stats view"
    described as {
      |Read model view carrying the route stats projection.
    }
  }
  projector RouteAnalytics as flow is {
    updates repository RouteContext.RouteRepository
    inlet RouteAnalyticsFromRoute is type RouteEvent    outlet RouteAnalyticsOut is type RouteEvent
    record RouteStats is  {
      totalRoutes: Natural with {
        briefly "Total"
        described as {
          |Total routes.
        }
      }
      completedRoutes: Natural with {
        briefly "Completed"
        described as {
          |Completed routes.
        }
      }
      onTimeDeliveries: Natural with {
        briefly "On time"
        described as {
          |On-time deliveries.
        }
      }
      lateDeliveries: Natural with {
        briefly "Late"
        described as {
          |Late deliveries.
        }
      }
      failedDeliveries: Natural with {
        briefly "Failed"
        described as {
          |Failed deliveries.
        }
      }
      aggregateDistance: Decimal(12,2) with {
        briefly "Distance"
        described as {
          |Total fleet distance.
        }
      }
      avgOptimizationSavings: Decimal(5,2) with {
        briefly "Savings"
        described as {
          |Avg optimization savings.
        }
      }
    } with {
      briefly "Route statistics"
      described as {
        |Route operational metrics.
      }
    }
    handler AnalyticsHandler is {
      on routeCreated: event Route.RouteCreated is {
        tell command RouteContext.RouteRepository.PersistRouteCreated(routeId = routeCreated.routeId) to repository RouteContext.RouteRepository
        do "Update route counts"
      }
      on routeOptimized: event Route.RouteOptimized is {
        tell command RouteContext.RouteRepository.PersistRouteOptimized(routeId = routeOptimized.routeId) to repository RouteContext.RouteRepository
        do "Update optimization metrics"
      }
      on stopCompleted: event Route.StopCompleted is {
        tell command RouteContext.RouteRepository.PersistStopCompleted(routeId = stopCompleted.routeId) to repository RouteContext.RouteRepository
        do "Update delivery metrics"
      }
      on deliveryFailed: event Route.DeliveryFailed is {
        tell command RouteContext.RouteRepository.PersistDeliveryFailed(routeId = deliveryFailed.routeId) to repository RouteContext.RouteRepository
        do "Update failure metrics"
      }
      on routeCompleted: event Route.RouteCompleted is {
        tell command RouteContext.RouteRepository.PersistRouteCompleted(routeId = routeCompleted.routeId) to repository RouteContext.RouteRepository
        do "Update completion metrics"
      }
    } with {
      briefly "Maintains route analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Route analytics projections"
    described as {
      |Maintains route operational analytics data.
    }
  }
  // ---- Event publication for Route ----
  type RouteEvent is one of {
    RouteContext.Route.RouteCreated or RouteContext.Route.StopAdded or RouteContext.Route.StopRemoved or RouteContext.Route.RouteOptimized or RouteContext.Route.StopsReordered or RouteContext.Route.DriverAssigned or RouteContext.Route.RouteStarted or RouteContext.Route.ArrivedAtStop or RouteContext.Route.StopCompleted or RouteContext.Route.StopSkipped or RouteContext.Route.DeliveryFailed or RouteContext.Route.RouteCompleted or RouteContext.Route.RouteCancelled
  } with {
    briefly "Route event alternation"
    described as {
      |Union of all Route events, for streaming and event-sourced
      |persistence.
    }
  }
  processor RouteEventSource as source is {
    outlet RouteEvents is type RouteEvent
    handler RouteSourceHandler is {
      on routeCreated: event Route.RouteCreated is {
        send routeCreated to outlet RouteEvents
      }
      on stopAdded: event Route.StopAdded is {
        send stopAdded to outlet RouteEvents
      }
      on stopRemoved: event Route.StopRemoved is {
        send stopRemoved to outlet RouteEvents
      }
      on routeOptimized: event Route.RouteOptimized is {
        send routeOptimized to outlet RouteEvents
      }
      on stopsReordered: event Route.StopsReordered is {
        send stopsReordered to outlet RouteEvents
      }
      on driverAssigned: event Route.DriverAssigned is {
        send driverAssigned to outlet RouteEvents
      }
      on routeStarted: event Route.RouteStarted is {
        send routeStarted to outlet RouteEvents
      }
      on arrivedAtStop: event Route.ArrivedAtStop is {
        send arrivedAtStop to outlet RouteEvents
      }
      on stopCompleted: event Route.StopCompleted is {
        send stopCompleted to outlet RouteEvents
      }
      on stopSkipped: event Route.StopSkipped is {
        send stopSkipped to outlet RouteEvents
      }
      on deliveryFailed: event Route.DeliveryFailed is {
        send deliveryFailed to outlet RouteEvents
      }
      on routeCompleted: event Route.RouteCompleted is {
        send routeCompleted to outlet RouteEvents
      }
      on routeCancelled: event Route.RouteCancelled is {
        send routeCancelled to outlet RouteEvents
      }
      on other is {
        error "Unexpected message for source RouteEventSource"
      }
    } with {
      briefly "Route source handler"
      described as {
        |Publishes Route events onto the outlet.
      }
    }
  } with {
    briefly "Route event source"
    described as {
      |Publishes Route entity events into the streaming topology.
    }
  }
  processor RouteEventSink as sink is {
    inlet RouteInlet is type RouteEvent    handler RouteSinkHandler is {
      on routeCreated: event Route.RouteCreated is {
        tell routeCreated to repository RouteContext.RouteRepository
      }
      on stopAdded: event Route.StopAdded is {
        tell stopAdded to repository RouteContext.RouteRepository
      }
      on stopRemoved: event Route.StopRemoved is {
        tell stopRemoved to repository RouteContext.RouteRepository
      }
      on routeOptimized: event Route.RouteOptimized is {
        tell routeOptimized to repository RouteContext.RouteRepository
      }
      on stopsReordered: event Route.StopsReordered is {
        tell stopsReordered to repository RouteContext.RouteRepository
      }
      on driverAssigned: event Route.DriverAssigned is {
        tell driverAssigned to repository RouteContext.RouteRepository
      }
      on routeStarted: event Route.RouteStarted is {
        tell routeStarted to repository RouteContext.RouteRepository
      }
      on arrivedAtStop: event Route.ArrivedAtStop is {
        tell arrivedAtStop to repository RouteContext.RouteRepository
      }
      on stopCompleted: event Route.StopCompleted is {
        tell stopCompleted to repository RouteContext.RouteRepository
      }
      on stopSkipped: event Route.StopSkipped is {
        tell stopSkipped to repository RouteContext.RouteRepository
      }
      on deliveryFailed: event Route.DeliveryFailed is {
        tell deliveryFailed to repository RouteContext.RouteRepository
      }
      on routeCompleted: event Route.RouteCompleted is {
        tell routeCompleted to repository RouteContext.RouteRepository
      }
      on routeCancelled: event Route.RouteCancelled is {
        tell routeCancelled to repository RouteContext.RouteRepository
      }
      on other is {
        error "Unexpected message for sink RouteEventSink"
      }
    } with {
      briefly "Route sink handler"
      described as {
        |Persists Route events via the repository.
      }
    }
  } with {
    briefly "Route event sink"
    described as {
      |Receives Route events for persistence.
    }
  }
  connector RouteEventFlow is from outlet RouteContext.RouteEventSource.RouteEvents to inlet RouteContext.RouteEventSink.RouteInlet with {
    briefly "Route event flow"
    described as {
      |Connects the Route source to its sink.
    }
  }
  processor RouteEventSplit as split is {
    inlet RouteEventSplitIn is type RouteEvent    outlet RouteEventSplitToRouteRepository is type RouteEvent
    outlet RouteEventSplitToRouteAnalytics is type RouteEvent
    handler RouteEventSplitHandler is {
      on routeCreated: event Route.RouteCreated is {
        send routeCreated to outlet RouteEventSplitToRouteRepository
        send routeCreated to outlet RouteEventSplitToRouteAnalytics
        tell routeCreated to entity RouteContext.Route
      }
      on stopAdded: event Route.StopAdded is {
        send stopAdded to outlet RouteEventSplitToRouteRepository
        send stopAdded to outlet RouteEventSplitToRouteAnalytics
        tell stopAdded to entity RouteContext.Route
      }
      on stopRemoved: event Route.StopRemoved is {
        send stopRemoved to outlet RouteEventSplitToRouteRepository
        send stopRemoved to outlet RouteEventSplitToRouteAnalytics
        tell stopRemoved to entity RouteContext.Route
      }
      on routeOptimized: event Route.RouteOptimized is {
        send routeOptimized to outlet RouteEventSplitToRouteRepository
        send routeOptimized to outlet RouteEventSplitToRouteAnalytics
        tell routeOptimized to entity RouteContext.Route
      }
      on stopsReordered: event Route.StopsReordered is {
        send stopsReordered to outlet RouteEventSplitToRouteRepository
        send stopsReordered to outlet RouteEventSplitToRouteAnalytics
        tell stopsReordered to entity RouteContext.Route
      }
      on driverAssigned: event Route.DriverAssigned is {
        send driverAssigned to outlet RouteEventSplitToRouteRepository
        send driverAssigned to outlet RouteEventSplitToRouteAnalytics
        tell driverAssigned to entity RouteContext.Route
      }
      on routeStarted: event Route.RouteStarted is {
        send routeStarted to outlet RouteEventSplitToRouteRepository
        send routeStarted to outlet RouteEventSplitToRouteAnalytics
        tell routeStarted to entity RouteContext.Route
      }
      on arrivedAtStop: event Route.ArrivedAtStop is {
        send arrivedAtStop to outlet RouteEventSplitToRouteRepository
        send arrivedAtStop to outlet RouteEventSplitToRouteAnalytics
        tell arrivedAtStop to entity RouteContext.Route
      }
      on stopCompleted: event Route.StopCompleted is {
        send stopCompleted to outlet RouteEventSplitToRouteRepository
        send stopCompleted to outlet RouteEventSplitToRouteAnalytics
        tell stopCompleted to entity RouteContext.Route
      }
      on stopSkipped: event Route.StopSkipped is {
        send stopSkipped to outlet RouteEventSplitToRouteRepository
        send stopSkipped to outlet RouteEventSplitToRouteAnalytics
        tell stopSkipped to entity RouteContext.Route
      }
      on deliveryFailed: event Route.DeliveryFailed is {
        send deliveryFailed to outlet RouteEventSplitToRouteRepository
        send deliveryFailed to outlet RouteEventSplitToRouteAnalytics
        tell deliveryFailed to entity RouteContext.Route
      }
      on routeCompleted: event Route.RouteCompleted is {
        send routeCompleted to outlet RouteEventSplitToRouteRepository
        send routeCompleted to outlet RouteEventSplitToRouteAnalytics
        tell routeCompleted to entity RouteContext.Route
      }
      on routeCancelled: event Route.RouteCancelled is {
        send routeCancelled to outlet RouteEventSplitToRouteRepository
        send routeCancelled to outlet RouteEventSplitToRouteAnalytics
        tell routeCancelled to entity RouteContext.Route
      }
      on other is {
        error "Unexpected message for processor RouteEventSplit"
      }
    } with {
      briefly "Route event fan-out handler"
      described as {
        |Delivers each Route event to all of its consumers.
      }
    }
  } with {
    briefly "Route event fan-out"
    described as {
      |Fans Route events out to the repository and projectors.
    }
  }
  connector 'RouteEvent Stream' is from outlet RouteContext.Route.RouteEvents2 to inlet RouteContext.RouteEventSplit.RouteEventSplitIn with {
    briefly "Route events, fanned out to storage and read models"
  }
  connector 'RouteEvent Storage' is from outlet RouteContext.RouteEventSplit.RouteEventSplitToRouteRepository to inlet RouteContext.RouteRepository.RouteRepositoryFromRoute with {
    briefly "Route events on their way to storage"
  }
  connector 'RouteAnalytics Feed' is from outlet RouteContext.RouteEventSplit.RouteEventSplitToRouteAnalytics to inlet RouteContext.RouteAnalytics.RouteAnalyticsFromRoute with {
    briefly "Route events feeding the RouteAnalytics projection"
  }
  connector 'RouteAnalytics Storage' is from outlet RouteContext.RouteAnalytics.RouteAnalyticsOut to inlet RouteContext.RouteRepository.RouteRepositoryFromRouteAnalytics with {
    briefly "The RouteAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for route optimization"
  described as {
    | The RouteContext is the bounded context for
    | delivery route planning and execution.
  }
}
