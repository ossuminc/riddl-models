// Route Optimization - Route Context
context RouteContext is {
  adaptor FromCustomerNotificationService from context CustomerNotificationService is { 
    handler FromCustomerNotificationServiceHandler is {
      on event CustomerNotificationService.ConfirmationSent is {
        do "the model receives confirmation sent"
      }
      on event CustomerNotificationService.EtaSent is {
        do "the model receives eta sent"
      }
      on event CustomerNotificationService.FailureNoticeSent is {
        do "the model receives failure notice sent"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerNotificationService"
      }
    } with {
      briefly "from customer notification service"
      described as {
        |Carries messages from the external CustomerNotificationService.
      }
    }
  } with {
    briefly "CustomerNotificationService integration"
    described as {
      |The model's side of the CustomerNotificationService conversation.
    }
  }
  adaptor ToCustomerNotificationService to context CustomerNotificationService is { 
    handler ToCustomerNotificationServiceHandler is {
      on command CustomerNotificationService.SendDeliveryConfirmation is {
        do "the model sends send delivery confirmation"
      }
      on command CustomerNotificationService.SendDeliveryEta is {
        do "the model sends send delivery eta"
      }
      on command CustomerNotificationService.SendDeliveryFailureNotice is {
        do "the model sends send delivery failure notice"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerNotificationService"
      }
    } with {
      briefly "to customer notification service"
      described as {
        |Carries messages to the external CustomerNotificationService.
      }
    }
  } with {
    briefly "CustomerNotificationService integration"
    described as {
      |The model's side of the CustomerNotificationService conversation.
    }
  }
  adaptor FromDriverMobileAppService from context DriverMobileAppService is { 
    handler FromDriverMobileAppServiceHandler is {
      on event DriverMobileAppService.NavigationUpdateSent is {
        do "the model receives navigation update sent"
      }
      on event DriverMobileAppService.RouteReceivedByDriver is {
        do "the model receives route received by driver"
      }
      on other is {
        error "Unexpected message for adaptor FromDriverMobileAppService"
      }
    } with {
      briefly "from driver mobile app service"
      described as {
        |Carries messages from the external DriverMobileAppService.
      }
    }
  } with {
    briefly "DriverMobileAppService integration"
    described as {
      |The model's side of the DriverMobileAppService conversation.
    }
  }
  adaptor ToDriverMobileAppService to context DriverMobileAppService is { 
    handler ToDriverMobileAppServiceHandler is {
      on command DriverMobileAppService.SendNavigationUpdate is {
        do "the model sends send navigation update"
      }
      on command DriverMobileAppService.SendRouteToDriver is {
        do "the model sends send route to driver"
      }
      on other is {
        error "Unexpected message for adaptor ToDriverMobileAppService"
      }
    } with {
      briefly "to driver mobile app service"
      described as {
        |Carries messages to the external DriverMobileAppService.
      }
    }
  } with {
    briefly "DriverMobileAppService integration"
    described as {
      |The model's side of the DriverMobileAppService conversation.
    }
  }
  adaptor FromGeocodingService from context GeocodingService is { 
    handler FromGeocodingServiceHandler is {
      on result GeocodingService.AddressResult is {
        do "the model receives address result"
      }
      on result GeocodingService.GeocodedLocation is {
        do "the model receives geocoded location"
      }
      on other is {
        error "Unexpected message for adaptor FromGeocodingService"
      }
    } with {
      briefly "from geocoding service"
      described as {
        |Carries messages from the external GeocodingService.
      }
    }
  } with {
    briefly "GeocodingService integration"
    described as {
      |The model's side of the GeocodingService conversation.
    }
  }
  adaptor ToGeocodingService to context GeocodingService is { 
    handler ToGeocodingServiceHandler is {
      on query GeocodingService.GeocodeAddress is {
        do "the model sends geocode address"
      }
      on query GeocodingService.ReverseGeocode is {
        do "the model sends reverse geocode"
      }
      on other is {
        error "Unexpected message for adaptor ToGeocodingService"
      }
    } with {
      briefly "to geocoding service"
      described as {
        |Carries messages to the external GeocodingService.
      }
    }
  } with {
    briefly "GeocodingService integration"
    described as {
      |The model's side of the GeocodingService conversation.
    }
  }
  adaptor FromOptimizationEngineService from context OptimizationEngineService is { 
    handler FromOptimizationEngineServiceHandler is {
      on event OptimizationEngineService.OptimizationCompleted is {
        do "the model receives optimization completed"
      }
      on other is {
        error "Unexpected message for adaptor FromOptimizationEngineService"
      }
    } with {
      briefly "from optimization engine service"
      described as {
        |Carries messages from the external OptimizationEngineService.
      }
    }
  } with {
    briefly "OptimizationEngineService integration"
    described as {
      |The model's side of the OptimizationEngineService conversation.
    }
  }
  adaptor ToOptimizationEngineService to context OptimizationEngineService is { 
    handler ToOptimizationEngineServiceHandler is {
      on command OptimizationEngineService.OptimizeStopSequence is {
        do "the model sends optimize stop sequence"
      }
      on command OptimizationEngineService.ReoptimizeRoute is {
        do "the model sends reoptimize route"
      }
      on other is {
        error "Unexpected message for adaptor ToOptimizationEngineService"
      }
    } with {
      briefly "to optimization engine service"
      described as {
        |Carries messages to the external OptimizationEngineService.
      }
    }
  } with {
    briefly "OptimizationEngineService integration"
    described as {
      |The model's side of the OptimizationEngineService conversation.
    }
  }
  adaptor FromRoutingEngineService from context RoutingEngineService is { 
    handler FromRoutingEngineServiceHandler is {
      on result RoutingEngineService.DistanceMatrix is {
        do "the model receives distance matrix"
      }
      on result RoutingEngineService.DrivingRoute is {
        do "the model receives driving route"
      }
      on other is {
        error "Unexpected message for adaptor FromRoutingEngineService"
      }
    } with {
      briefly "from routing engine service"
      described as {
        |Carries messages from the external RoutingEngineService.
      }
    }
  } with {
    briefly "RoutingEngineService integration"
    described as {
      |The model's side of the RoutingEngineService conversation.
    }
  }
  adaptor ToRoutingEngineService to context RoutingEngineService is { 
    handler ToRoutingEngineServiceHandler is {
      on query RoutingEngineService.CalculateRoute is {
        do "the model sends calculate route"
      }
      on query RoutingEngineService.GetDistanceMatrix is {
        do "the model sends get distance matrix"
      }
      on other is {
        error "Unexpected message for adaptor ToRoutingEngineService"
      }
    } with {
      briefly "to routing engine service"
      described as {
        |Carries messages to the external RoutingEngineService.
      }
    }
  } with {
    briefly "RoutingEngineService integration"
    described as {
      |The model's side of the RoutingEngineService conversation.
    }
  }
  adaptor FromTrafficService from context TrafficService is { 
    handler FromTrafficServiceHandler is {
      on event TrafficService.TrafficAlert is {
        do "the model receives traffic alert"
      }
      on result TrafficService.TrafficConditions is {
        do "the model receives traffic conditions"
      }
      on other is {
        error "Unexpected message for adaptor FromTrafficService"
      }
    } with {
      briefly "from traffic service"
      described as {
        |Carries messages from the external TrafficService.
      }
    }
  } with {
    briefly "TrafficService integration"
    described as {
      |The model's side of the TrafficService conversation.
    }
  }
  adaptor ToTrafficService to context TrafficService is { 
    handler ToTrafficServiceHandler is {
      on query TrafficService.GetTrafficConditions is {
        do "the model sends get traffic conditions"
      }
      on other is {
        error "Unexpected message for adaptor ToTrafficService"
      }
    } with {
      briefly "to traffic service"
      described as {
        |Carries messages to the external TrafficService.
      }
    }
  } with {
    briefly "TrafficService integration"
    described as {
      |The model's side of the TrafficService conversation.
    }
  }
  include "types.riddl"
  include "Route.riddl"
  // Repository for route persistence
  repository RouteRepository is {
    inlet RouteRepositoryFromRoute is type RouteEvent    inlet RouteRepositoryFromRouteAnalytics is type RouteEvent    outlet RouteRepositoryResponses is type Route.RouteResult
    record StoredRoute is  {
      routeId: RouteId with {
        briefly "routeId"
        described as {
          |The routeId column of the stored route row.
        }
      }
      driver: DriverInfo with {
        briefly "driver"
        described as {
          |The driver column of the stored route row.
        }
      }
      scheduledDate: Date with {
        briefly "scheduledDate"
        described as {
          |The scheduledDate column of the stored route row.
        }
      }
      status: RouteStatus with {
        briefly "status"
        described as {
          |The status column of the stored route row.
        }
      }
    } with {
      briefly "Stored route row"
      described as {
        |The persistence shape of route data as this repository stores it.
      }
    }
    schema RouteData is relational
      of routes as type StoredRoute
        index on field StoredRoute.routeId
        index on field StoredRoute.scheduledDate
        index on field StoredRoute.driver.driverId
        index on field StoredRoute.status
 with {
      briefly "Route data schema"
      described as {
        |The relational schema holding route data for the RouteRepository.
      }
    }
    handler RoutePersistence is {
      on query GetRouteStats is {
        do "read the route stats projection"
        yield result RouteStatsView
      }
      on command Route.CreateRoute is {
        tell event Route.RouteCreated to entity RouteContext.Route
        do "Store new route"
      }
      on command Route.AddStop is {
        tell event Route.StopAdded to entity RouteContext.Route
        do "Add stop to route"
      }
      on command Route.RemoveStop is {
        tell event Route.StopRemoved to entity RouteContext.Route
        do "Remove stop from route"
      }
      on command Route.OptimizeRoute is {
        do "Update route optimization"
      }
      on command Route.ReorderStops is {
        do "Update stop sequence"
      }
      on command Route.AssignDriver is {
        tell event Route.DriverAssigned to entity RouteContext.Route
        do "Store driver assignment"
      }
      on command Route.StartRoute is {
        tell event Route.RouteStarted to entity RouteContext.Route
        do "Update to in progress"
      }
      on command Route.ArriveAtStop is {
        do "Update stop arrival"
      }
      on command Route.CompleteStop is {
        tell event Route.StopCompleted to entity RouteContext.Route
        do "Update stop completion"
      }
      on command Route.SkipStop is {
        do "Update stop to skipped"
      }
      on command Route.RecordDeliveryFailure is {
        do "Update stop to failed"
      }
      on command Route.CompleteRoute is {
        tell event Route.RouteCompleted to entity RouteContext.Route
        do "Update to completed"
      }
      on command Route.CancelRoute is {
        tell event Route.RouteCancelled to entity RouteContext.Route
        do "Update to cancelled"
      }
    } with {
      briefly "Persists route commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Route data persistence"
    described as {
      | The RouteRepository provides persistent storage for
      | routes and related data.
    }
  }
  // Projector for route analytics
  query GetRouteStats is  {
    routeStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which route stats to retrieve.
      }
    }
  } with {
    briefly "Get route stats"
    described as {
      |Retrieves the route stats projection.
    }
  }
  result RouteStatsView is  {
    routeStats: RouteAnalytics.RouteStats with {
      briefly "Route stats"
      described as {
        |The route stats being returned.
      }
    }
  } with {
    briefly "Route stats view"
    described as {
      |Read model view carrying the route stats projection.
    }
  }
  projector RouteAnalytics is {
    updates repository RouteContext.RouteRepository
    inlet RouteAnalyticsFromRoute is type RouteEvent    outlet RouteAnalyticsOut is type RouteEvent
    record RouteStats is  {
      totalRoutes: Natural with {
        briefly "Total"
        described as {
          |Total routes.
        }
      }
      completedRoutes: Natural with {
        briefly "Completed"
        described as {
          |Completed routes.
        }
      }
      onTimeDeliveries: Natural with {
        briefly "On time"
        described as {
          |On-time deliveries.
        }
      }
      lateDeliveries: Natural with {
        briefly "Late"
        described as {
          |Late deliveries.
        }
      }
      failedDeliveries: Natural with {
        briefly "Failed"
        described as {
          |Failed deliveries.
        }
      }
      aggregateDistance: Decimal(12,2) with {
        briefly "Distance"
        described as {
          |Total fleet distance.
        }
      }
      avgOptimizationSavings: Decimal(5,2) with {
        briefly "Savings"
        described as {
          |Avg optimization savings.
        }
      }
    } with {
      briefly "Route statistics"
      described as {
        |Route operational metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Route.RouteCreated is {
        tell event Route.RouteCreated to repository RouteContext.RouteRepository
        do "Update route counts"
      }
      on event Route.RouteOptimized is {
        tell event Route.RouteOptimized to repository RouteContext.RouteRepository
        do "Update optimization metrics"
      }
      on event Route.StopCompleted is {
        tell event Route.StopCompleted to repository RouteContext.RouteRepository
        do "Update delivery metrics"
      }
      on event Route.DeliveryFailed is {
        tell event Route.DeliveryFailed to repository RouteContext.RouteRepository
        do "Update failure metrics"
      }
      on event Route.RouteCompleted is {
        tell event Route.RouteCompleted to repository RouteContext.RouteRepository
        do "Update completion metrics"
      }
    } with {
      briefly "Maintains route analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Route analytics projections"
    described as {
      |Maintains route operational analytics data.
    }
  }
  // ---- Event publication for Route ----
  type RouteEvent is one of {
    RouteContext.Route.RouteCreated or RouteContext.Route.StopAdded or RouteContext.Route.StopRemoved or RouteContext.Route.RouteOptimized or RouteContext.Route.StopsReordered or RouteContext.Route.DriverAssigned or RouteContext.Route.RouteStarted or RouteContext.Route.ArrivedAtStop or RouteContext.Route.StopCompleted or RouteContext.Route.StopSkipped or RouteContext.Route.DeliveryFailed or RouteContext.Route.RouteCompleted or RouteContext.Route.RouteCancelled
  } with {
    briefly "Route event alternation"
    described as {
      |Union of all Route events, for streaming and event-sourced
      |persistence.
    }
  }
  processor RouteEventSource as source is {
    outlet RouteEvents is type RouteEvent
    handler RouteSourceHandler is {
      on event Route.RouteCreated is {
        send event Route.RouteCreated to outlet RouteEvents
      }
      on event Route.StopAdded is {
        send event Route.StopAdded to outlet RouteEvents
      }
      on event Route.StopRemoved is {
        send event Route.StopRemoved to outlet RouteEvents
      }
      on event Route.RouteOptimized is {
        send event Route.RouteOptimized to outlet RouteEvents
      }
      on event Route.StopsReordered is {
        send event Route.StopsReordered to outlet RouteEvents
      }
      on event Route.DriverAssigned is {
        send event Route.DriverAssigned to outlet RouteEvents
      }
      on event Route.RouteStarted is {
        send event Route.RouteStarted to outlet RouteEvents
      }
      on event Route.ArrivedAtStop is {
        send event Route.ArrivedAtStop to outlet RouteEvents
      }
      on event Route.StopCompleted is {
        send event Route.StopCompleted to outlet RouteEvents
      }
      on event Route.StopSkipped is {
        send event Route.StopSkipped to outlet RouteEvents
      }
      on event Route.DeliveryFailed is {
        send event Route.DeliveryFailed to outlet RouteEvents
      }
      on event Route.RouteCompleted is {
        send event Route.RouteCompleted to outlet RouteEvents
      }
      on event Route.RouteCancelled is {
        send event Route.RouteCancelled to outlet RouteEvents
      }
      on other is {
        error "Unexpected message for source RouteEventSource"
      }
    } with {
      briefly "Route source handler"
      described as {
        |Publishes Route events onto the outlet.
      }
    }
  } with {
    briefly "Route event source"
    described as {
      |Publishes Route entity events into the streaming topology.
    }
  }
  processor RouteEventSink as sink is {
    inlet RouteInlet is type RouteEvent    handler RouteSinkHandler is {
      on event Route.RouteCreated is {
        tell event Route.RouteCreated to repository RouteContext.RouteRepository
      }
      on event Route.StopAdded is {
        tell event Route.StopAdded to repository RouteContext.RouteRepository
      }
      on event Route.StopRemoved is {
        tell event Route.StopRemoved to repository RouteContext.RouteRepository
      }
      on event Route.RouteOptimized is {
        tell event Route.RouteOptimized to repository RouteContext.RouteRepository
      }
      on event Route.StopsReordered is {
        tell event Route.StopsReordered to repository RouteContext.RouteRepository
      }
      on event Route.DriverAssigned is {
        tell event Route.DriverAssigned to repository RouteContext.RouteRepository
      }
      on event Route.RouteStarted is {
        tell event Route.RouteStarted to repository RouteContext.RouteRepository
      }
      on event Route.ArrivedAtStop is {
        tell event Route.ArrivedAtStop to repository RouteContext.RouteRepository
      }
      on event Route.StopCompleted is {
        tell event Route.StopCompleted to repository RouteContext.RouteRepository
      }
      on event Route.StopSkipped is {
        tell event Route.StopSkipped to repository RouteContext.RouteRepository
      }
      on event Route.DeliveryFailed is {
        tell event Route.DeliveryFailed to repository RouteContext.RouteRepository
      }
      on event Route.RouteCompleted is {
        tell event Route.RouteCompleted to repository RouteContext.RouteRepository
      }
      on event Route.RouteCancelled is {
        tell event Route.RouteCancelled to repository RouteContext.RouteRepository
      }
      on other is {
        error "Unexpected message for sink RouteEventSink"
      }
    } with {
      briefly "Route sink handler"
      described as {
        |Persists Route events via the repository.
      }
    }
  } with {
    briefly "Route event sink"
    described as {
      |Receives Route events for persistence.
    }
  }
  connector RouteEventFlow is from outlet RouteContext.RouteEventSource.RouteEvents to inlet RouteContext.RouteEventSink.RouteInlet with {
    briefly "Route event flow"
    described as {
      |Connects the Route source to its sink.
    }
  }
  processor RouteEventSplit is {
    inlet RouteEventSplitIn is type RouteEvent    outlet RouteEventSplitToRouteRepository is type RouteEvent
    outlet RouteEventSplitToRouteAnalytics is type RouteEvent
    handler RouteEventSplitHandler is {
      on event Route.RouteCreated is {
        send event Route.RouteCreated to outlet RouteEventSplitToRouteRepository
        send event Route.RouteCreated to outlet RouteEventSplitToRouteAnalytics
        tell event Route.RouteCreated to entity RouteContext.Route
      }
      on event Route.StopAdded is {
        send event Route.StopAdded to outlet RouteEventSplitToRouteRepository
        send event Route.StopAdded to outlet RouteEventSplitToRouteAnalytics
        tell event Route.StopAdded to entity RouteContext.Route
      }
      on event Route.StopRemoved is {
        send event Route.StopRemoved to outlet RouteEventSplitToRouteRepository
        send event Route.StopRemoved to outlet RouteEventSplitToRouteAnalytics
        tell event Route.StopRemoved to entity RouteContext.Route
      }
      on event Route.RouteOptimized is {
        send event Route.RouteOptimized to outlet RouteEventSplitToRouteRepository
        send event Route.RouteOptimized to outlet RouteEventSplitToRouteAnalytics
        tell event Route.RouteOptimized to entity RouteContext.Route
      }
      on event Route.StopsReordered is {
        send event Route.StopsReordered to outlet RouteEventSplitToRouteRepository
        send event Route.StopsReordered to outlet RouteEventSplitToRouteAnalytics
        tell event Route.StopsReordered to entity RouteContext.Route
      }
      on event Route.DriverAssigned is {
        send event Route.DriverAssigned to outlet RouteEventSplitToRouteRepository
        send event Route.DriverAssigned to outlet RouteEventSplitToRouteAnalytics
        tell event Route.DriverAssigned to entity RouteContext.Route
      }
      on event Route.RouteStarted is {
        send event Route.RouteStarted to outlet RouteEventSplitToRouteRepository
        send event Route.RouteStarted to outlet RouteEventSplitToRouteAnalytics
        tell event Route.RouteStarted to entity RouteContext.Route
      }
      on event Route.ArrivedAtStop is {
        send event Route.ArrivedAtStop to outlet RouteEventSplitToRouteRepository
        send event Route.ArrivedAtStop to outlet RouteEventSplitToRouteAnalytics
        tell event Route.ArrivedAtStop to entity RouteContext.Route
      }
      on event Route.StopCompleted is {
        send event Route.StopCompleted to outlet RouteEventSplitToRouteRepository
        send event Route.StopCompleted to outlet RouteEventSplitToRouteAnalytics
        tell event Route.StopCompleted to entity RouteContext.Route
      }
      on event Route.StopSkipped is {
        send event Route.StopSkipped to outlet RouteEventSplitToRouteRepository
        send event Route.StopSkipped to outlet RouteEventSplitToRouteAnalytics
        tell event Route.StopSkipped to entity RouteContext.Route
      }
      on event Route.DeliveryFailed is {
        send event Route.DeliveryFailed to outlet RouteEventSplitToRouteRepository
        send event Route.DeliveryFailed to outlet RouteEventSplitToRouteAnalytics
        tell event Route.DeliveryFailed to entity RouteContext.Route
      }
      on event Route.RouteCompleted is {
        send event Route.RouteCompleted to outlet RouteEventSplitToRouteRepository
        send event Route.RouteCompleted to outlet RouteEventSplitToRouteAnalytics
        tell event Route.RouteCompleted to entity RouteContext.Route
      }
      on event Route.RouteCancelled is {
        send event Route.RouteCancelled to outlet RouteEventSplitToRouteRepository
        send event Route.RouteCancelled to outlet RouteEventSplitToRouteAnalytics
        tell event Route.RouteCancelled to entity RouteContext.Route
      }
      on other is {
        error "Unexpected message for processor RouteEventSplit"
      }
    } with {
      briefly "Route event fan-out handler"
      described as {
        |Delivers each Route event to all of its consumers.
      }
    }
  } with {
    briefly "Route event fan-out"
    described as {
      |Fans Route events out to the repository and projectors.
    }
  }
  connector 'RouteEvent Stream' is from outlet RouteContext.Route.RouteEvents2 to inlet RouteContext.RouteEventSplit.RouteEventSplitIn with {
    briefly "Route events, fanned out to storage and read models"
  }
  connector 'RouteEvent Storage' is from outlet RouteContext.RouteEventSplit.RouteEventSplitToRouteRepository to inlet RouteContext.RouteRepository.RouteRepositoryFromRoute with {
    briefly "Route events on their way to storage"
  }
  connector 'RouteAnalytics Feed' is from outlet RouteContext.RouteEventSplit.RouteEventSplitToRouteAnalytics to inlet RouteContext.RouteAnalytics.RouteAnalyticsFromRoute with {
    briefly "Route events feeding the RouteAnalytics projection"
  }
  connector 'RouteAnalytics Storage' is from outlet RouteContext.RouteAnalytics.RouteAnalyticsOut to inlet RouteContext.RouteRepository.RouteRepositoryFromRouteAnalytics with {
    briefly "The RouteAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for route optimization"
  described as {
    | The RouteContext is the bounded context for
    | delivery route planning and execution.
  }
}
