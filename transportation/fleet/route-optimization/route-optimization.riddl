// Route Optimization Domain Model
// Delivery route planning and optimization
domain RouteOptimization is {
  persistent connector 'TrafficServiceReply Stream' is from outlet TrafficService.TrafficServiceRepliesOut to inlet RouteContext.ToTrafficService.ToTrafficServiceReplies with {
    briefly "What TrafficService answers RouteContext"
  }
  persistent connector 'RoutingEngineServiceReply Stream' is from outlet RoutingEngineService.RoutingEngineServiceRepliesOut to inlet RouteContext.ToRoutingEngineService.ToRoutingEngineServiceReplies with {
    briefly "What RoutingEngineService answers RouteContext"
  }
  persistent connector 'GeocodingServiceReply Stream' is from outlet GeocodingService.GeocodingServiceRepliesOut to inlet RouteContext.ToGeocodingService.ToGeocodingServiceReplies with {
    briefly "What GeocodingService answers RouteContext"
  }
  persistent connector 'CustomerNotificationServiceEvent Stream' is from outlet CustomerNotificationService.CustomerNotificationServiceEventsOut to inlet RouteContext.FromCustomerNotificationService.FromCustomerNotificationServiceIn with {
    briefly "What CustomerNotificationService tells RouteContext, unasked"
  }
  persistent connector 'DriverMobileAppServiceEvent Stream' is from outlet DriverMobileAppService.DriverMobileAppServiceEventsOut to inlet RouteContext.FromDriverMobileAppService.FromDriverMobileAppServiceIn with {
    briefly "What DriverMobileAppService tells RouteContext, unasked"
  }
  persistent connector 'OptimizationEngineServiceEvent Stream' is from outlet OptimizationEngineService.OptimizationEngineServiceEventsOut to inlet RouteContext.FromOptimizationEngineService.FromOptimizationEngineServiceIn with {
    briefly "What OptimizationEngineService tells RouteContext, unasked"
  }
  persistent connector 'TrafficServiceEvent Stream' is from outlet TrafficService.TrafficServiceEventsOut to inlet RouteContext.FromTrafficService.FromTrafficServiceIn with {
    briefly "What TrafficService tells RouteContext, unasked"
  }
  persistent connector 'TrafficServiceRequest Stream' is from outlet RouteContext.ToTrafficService.ToTrafficServiceOut to inlet TrafficService.TrafficServiceRequests with {
    briefly "What RouteContext asks TrafficService to send"
  }
  persistent connector 'RoutingEngineServiceRequest Stream' is from outlet RouteContext.ToRoutingEngineService.ToRoutingEngineServiceOut to inlet RoutingEngineService.RoutingEngineServiceRequests with {
    briefly "What RouteContext asks RoutingEngineService to send"
  }
  persistent connector 'GeocodingServiceRequest Stream' is from outlet RouteContext.ToGeocodingService.ToGeocodingServiceOut to inlet GeocodingService.GeocodingServiceRequests with {
    briefly "What RouteContext asks GeocodingService to send"
  }
  persistent connector 'OptimizationEngineServiceRequest Stream' is from outlet RouteContext.ToOptimizationEngineService.ToOptimizationEngineServiceOut to inlet OptimizationEngineService.OptimizationEngineServiceRequests with {
    briefly "What RouteContext asks OptimizationEngineService to send"
  }
  persistent connector 'DriverMobileAppServiceRequest Stream' is from outlet RouteContext.ToDriverMobileAppService.ToDriverMobileAppServiceOut to inlet DriverMobileAppService.DriverMobileAppServiceRequests with {
    briefly "What RouteContext asks DriverMobileAppService to send"
  }
  persistent connector 'CustomerNotificationServiceRequest Stream' is from outlet RouteContext.ToCustomerNotificationService.ToCustomerNotificationServiceOut to inlet CustomerNotificationService.CustomerNotificationServiceRequests with {
    briefly "What RouteContext asks CustomerNotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Dispatcher is "person planning routes" with {
    briefly "Dispatcher"
    described as {
      |Person managing route assignments.
    }
  }
  user Driver is "person executing routes" with {
    briefly "Driver"
    described as {
      |Person driving the route.
    }
  }
  user RouteManager is "person overseeing route operations" with {
    briefly "Route Manager"
    described as {
      |Person overseeing delivery operations.
    }
  }
  epic RouteEpic is {
    user Dispatcher wants to "to optimize delivery routes" so that "deliveries are efficient"
    case PlanDeliveryRoute is {
      user Dispatcher wants to "to create an optimized delivery route" so that "drivers can complete deliveries efficiently"
      step is "Dispatcher inputs" "delivery stops" "for the day" with {
        briefly "Input stops"
        described as {
          |Enter delivery locations.
        }
      }
      step take input RouteOptimizationApp.RouteOptimizationScreen.CreateRouteInput from user Dispatcher with {
        briefly "Create route"
        described as {
          |Generate optimized route.
        }
      }
      step is "System calculates" "optimal sequence" "using algorithms" with {
        briefly "Optimize"
        described as {
          |Calculate best route.
        }
      }
      step is "Dispatcher reviews" "and assigns route" "to driver" with {
        briefly "Assign"
        described as {
          |Assign to driver.
        }
      }
    } with {
      briefly "Plan delivery route"
      described as {
        |Creating optimized routes.
      }
    }
  } with {
    briefly "Route optimization"
    described as {
      | Epic covering route planning, optimization,
      | and real-time adjustments.
    }
  }
  include "RouteContext.riddl"
  include "external-contexts.riddl"
  application context RouteOptimizationApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in RouteOptimization are delivered.
      }
    }
    group RouteOptimizationScreen is {
      input GetRouteStatsInput acquires query RouteContext.GetRouteStats with {
        briefly "Get route stats control"
        described as {
          |The control through which a user asks the get route stats question.
        }
      }
      input GetRouteInput acquires query RouteContext.Route.GetRoute with {
        briefly "Get route control"
        described as {
          |The control through which a user asks the get route question.
        }
      }
      input AssignDriverInput acquires command RouteContext.Route.AssignDriver with {
        briefly "Assign driver control"
        described as {
          |The control through which a user submits the assign driver request.
        }
      }
      input CancelRouteInput acquires command RouteContext.Route.CancelRoute with {
        briefly "Cancel route control"
        described as {
          |The control through which a user submits the cancel route request.
        }
      }
      input CompleteRouteInput acquires command RouteContext.Route.CompleteRoute with {
        briefly "Complete route control"
        described as {
          |The control through which a user submits the complete route request.
        }
      }
      input CompleteStopInput acquires command RouteContext.Route.CompleteStop with {
        briefly "Complete stop control"
        described as {
          |The control through which a user submits the complete stop request.
        }
      }
      input RecordDeliveryFailureInput acquires command RouteContext.Route.RecordDeliveryFailure with {
        briefly "Record delivery failure control"
        described as {
          |The control through which a user submits the record delivery failure request.
        }
      }
      input RemoveStopInput acquires command RouteContext.Route.RemoveStop with {
        briefly "Remove stop control"
        described as {
          |The control through which a user submits the remove stop request.
        }
      }
      input SkipStopInput acquires command RouteContext.Route.SkipStop with {
        briefly "Skip stop control"
        described as {
          |The control through which a user submits the skip stop request.
        }
      }
      input StartRouteInput acquires command RouteContext.Route.StartRoute with {
        briefly "Start route control"
        described as {
          |The control through which a user submits the start route request.
        }
      }
      input CreateRouteInput acquires command RouteContext.CreateRoute with {
        briefly "Create route control"
        described as {
          |The control through which a user submits the create route request.
        }
      }
    } with {
      briefly "Route optimization screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppRouteRepositoryQueries is query RouteContext.GetRouteStats
    inlet AppRouteRepositoryReplies is result RouteContext.RouteStatsView
    outlet AppRouteQueries is query RouteContext.Route.GetRoute
    outlet AppRouteCommands is type RouteContext.RouteRequest
    inlet AppRouteRepositoryResponses is result RouteContext.Route.RouteResult
    handler RouteOptimizationAppHandler is {
      on other is {
        error "Unexpected message for application context RouteOptimizationApp"
      }
    } with {
      briefly "RouteOptimizationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "RouteOptimizationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'RouteRepositoryQuery Stream' is from outlet RouteOptimizationApp.AppRouteRepositoryQueries to inlet RouteContext.RouteRepositoryQueriesIn with {
    briefly "RouteOptimizationApp's look-ups of the route repository"
  }
  persistent connector 'RouteRepositoryReply Stream' is from outlet RouteContext.RouteRepositoryRepliesOut to inlet RouteOptimizationApp.AppRouteRepositoryReplies with {
    briefly "The route repository's answers returned to RouteOptimizationApp"
  }
  persistent connector 'RouteQuery Stream' is from outlet RouteOptimizationApp.AppRouteQueries to inlet RouteContext.RouteQueriesIn with {
    briefly "RouteOptimizationApp's look-ups of the route"
  }
  persistent connector 'RouteCommand Stream' is from outlet RouteOptimizationApp.AppRouteCommands to inlet RouteContext.RouteCommandStreamIn with {
    briefly "Route commands from the application"
  }
  persistent connector 'RouteResult Stream' is from outlet RouteContext.RouteResultStreamOut to inlet RouteOptimizationApp.AppRouteRepositoryResponses with {
    briefly "Route query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet RouteOptimizationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Route optimization domain"
  described as {
    | The RouteOptimization domain handles delivery
    | route planning and optimization.
  }
}
