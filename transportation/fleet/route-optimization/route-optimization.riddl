// Route Optimization Domain Model
// Delivery route planning and optimization
domain RouteOptimization is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Dispatcher is "person planning routes" with {
    briefly "Dispatcher"
    described as {
      |Person managing route assignments.
    }
  }
  user Driver is "person executing routes" with {
    briefly "Driver"
    described as {
      |Person driving the route.
    }
  }
  user RouteManager is "person overseeing route operations" with {
    briefly "Route Manager"
    described as {
      |Person overseeing delivery operations.
    }
  }
  epic RouteEpic is {
    user Dispatcher wants to "to optimize delivery routes" so that "deliveries are efficient"
    case PlanDeliveryRoute is {
      user Dispatcher wants to "to create an optimized delivery route" so that "drivers can complete deliveries efficiently"
      step is "Dispatcher inputs" "delivery stops" "for the day" with {
        briefly "Input stops"
        described as {
          |Enter delivery locations.
        }
      }
      step take input RouteOptimizationApp.RouteOptimizationScreen.CreateRouteInput from user Dispatcher with {
        briefly "Create route"
        described as {
          |Generate optimized route.
        }
      }
      step is "System calculates" "optimal sequence" "using algorithms" with {
        briefly "Optimize"
        described as {
          |Calculate best route.
        }
      }
      step is "Dispatcher reviews" "and assigns route" "to driver" with {
        briefly "Assign"
        described as {
          |Assign to driver.
        }
      }
    } with {
      briefly "Plan delivery route"
      described as {
        |Creating optimized routes.
      }
    }
  } with {
    briefly "Route optimization"
    described as {
      | Epic covering route planning, optimization,
      | and real-time adjustments.
    }
  }
  include "RouteContext.riddl"
  include "external-contexts.riddl"
  application context RouteOptimizationApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in RouteOptimization are delivered.
      }
    }
    group RouteOptimizationScreen is {
      input CreateRouteInput acquires command RouteContext.Route.CreateRoute with {
        briefly "Create route control"
        described as {
          |The control through which a user submits the create route request.
        }
      }
    } with {
      briefly "Route optimization screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppRouteCommands is type RouteContext.Route.RouteCommand
    inlet AppRouteRepositoryResponses is type RouteContext.Route.RouteResult    handler RouteOptimizationAppHandler is {
      on other is {
        error "Unexpected message for application context RouteOptimizationApp"
      }
    } with {
      briefly "RouteOptimizationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "RouteOptimizationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'RouteCommand Stream' is from outlet RouteOptimizationApp.AppRouteCommands to inlet RouteContext.Route.RouteCommands with {
    option persistent()
    briefly "Route commands from the application"
  }
  connector 'RouteResult Stream' is from outlet RouteContext.RouteRepository.RouteRepositoryResponses to inlet RouteOptimizationApp.AppRouteRepositoryResponses with {
    option persistent()
    briefly "Route query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet RouteOptimizationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Route optimization domain"
  described as {
    | The RouteOptimization domain handles delivery
    | route planning and optimization.
  }
}
