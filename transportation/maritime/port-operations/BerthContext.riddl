// Port Operations - Berth Context
context BerthContext is {
  include "types.riddl"
  include "Berth.riddl"
  // Repository for berth persistence
  repository BerthRepository is {
    inlet BerthRepositoryFromBerth is type BerthEvent
    inlet BerthRepositoryFromPortAnalytics is type BerthEvent
    outlet BerthRepositoryResponses is type Berth.BerthResult
    schema BerthData is relational
      of berths as type Berth
        index on field Berth.berthId
        index on field Berth.details.terminalId
        index on field Berth.details.berthNumber
        index on field Berth.status

    handler BerthPersistence is {
      on command Berth.CreateBerth is {
        tell event Berth.BerthCreated to entity BerthContext.Berth
        do "Store new berth"
      }
      on command Berth.UpdateBerthDetails is {
        tell event Berth.BerthDetailsUpdated to entity BerthContext.Berth
        do "Update berth details"
      }
      on command Berth.RequestBerth is {
        do "Store berth request"
      }
      on command Berth.ConfirmBerthAssignment is {
        tell event Berth.BerthAssignmentConfirmed to entity BerthContext.Berth
        do "Store berth assignment"
      }
      on command Berth.AssignPilot is {
        tell event Berth.PilotAssigned to entity BerthContext.Berth
        do "Store pilot assignment"
      }
      on command BerthContext.Berth.OrderTugs is {
        do "Store tug order"
      }
      on command Berth.RecordVesselArrival is {
        do "Update to occupied"
      }
      on command Berth.RecordMooring is {
        do "Store mooring record"
      }
      on command Berth.StartCargoOperations is {
        tell event Berth.CargoOperationsStarted to entity BerthContext.Berth
        do "Store cargo operation start"
      }
      on command Berth.CompleteCargoOperations is {
        tell event Berth.CargoOperationsCompleted to entity BerthContext.Berth
        do "Store cargo operation completion"
      }
      on command Berth.RecordVesselDeparture is {
        do "Update to available"
      }
      on command Berth.GeneratePortCharges is {
        do "Store port charges"
      }
      on command Berth.CancelPortCall is {
        tell event Berth.PortCallCancelled to entity BerthContext.Berth
        do "Update port call status"
      }
      on command Berth.SetBerthMaintenance is {
        do "Store maintenance schedule"
      }
    } with {
      briefly "Persists berth commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Berth data persistence"
    described as {
      | The BerthRepository provides persistent storage
      | for berths and port call data.
    }
  }
  // Projector for port analytics
  projector PortAnalytics is {
    inlet PortAnalyticsFromBerth is type BerthEvent
    outlet PortAnalyticsOut is type BerthEvent
    updates repository BerthContext.BerthRepository
    record PortStats is  {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      vesselCalls: Natural with {
        briefly "Calls"
        described as {
          |Vessel port calls.
        }
      }
      totalCargoVolume: Decimal(14,2) with {
        briefly "Cargo"
        described as {
          |Total cargo volume.
        }
      }
      averageTurnaroundTime: Duration with {
        briefly "Turnaround"
        described as {
          |Avg turnaround time.
        }
      }
      berthUtilization: Decimal(5,2) with {
        briefly "Utilization"
        described as {
          |Berth utilization percent.
        }
      }
      totalRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Total port charges.
        }
      }
      craneMoves: Natural with {
        briefly "Moves"
        described as {
          |Total crane moves.
        }
      }
    } with {
      briefly "Port statistics"
      described as {
        |Daily port metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Berth.VesselArrived is {
        tell event Berth.VesselArrived to repository BerthContext.BerthRepository
        do "Update arrival metrics"
      }
      on event Berth.CargoOperationsCompleted is {
        tell event Berth.CargoOperationsCompleted to repository BerthContext.BerthRepository
        do "Update cargo metrics"
      }
      on event Berth.VesselDeparted is {
        tell event Berth.VesselDeparted to repository BerthContext.BerthRepository
        do "Update turnaround metrics"
      }
      on event Berth.PortChargesGenerated is {
        tell event Berth.PortChargesGenerated to repository BerthContext.BerthRepository
        do "Update revenue metrics"
      }
    } with {
      briefly "Maintains port analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Port analytics projections"
    described as {
      |Maintains port operational analytics.
    }
  }
  // ---- Event publication for Berth ----
  type BerthEvent is one of {
    BerthContext.Berth.BerthCreated,
    BerthContext.Berth.BerthDetailsUpdated,
    BerthContext.Berth.BerthRequested,
    BerthContext.Berth.BerthAssignmentConfirmed,
    BerthContext.Berth.PilotAssigned,
    BerthContext.Berth.TugsOrdered,
    BerthContext.Berth.VesselArrived,
    BerthContext.Berth.MooringCompleted,
    BerthContext.Berth.CargoOperationsStarted,
    BerthContext.Berth.CargoOperationsCompleted,
    BerthContext.Berth.VesselDeparted,
    BerthContext.Berth.PortChargesGenerated,
    BerthContext.Berth.PortCallCancelled,
    BerthContext.Berth.BerthMaintenanceScheduled
  } with {
    briefly "Berth event alternation"
    described as {
      |Union of all Berth events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BerthEventSource as source is {
    outlet BerthEvents is type BerthEvent
    handler BerthSourceHandler is {
      on event Berth.BerthCreated is {
        send event Berth.BerthCreated to outlet BerthEvents
      }
      on event Berth.BerthDetailsUpdated is {
        send event Berth.BerthDetailsUpdated to outlet BerthEvents
      }
      on event Berth.BerthRequested is {
        send event Berth.BerthRequested to outlet BerthEvents
      }
      on event Berth.BerthAssignmentConfirmed is {
        send event Berth.BerthAssignmentConfirmed to outlet BerthEvents
      }
      on event Berth.PilotAssigned is {
        send event Berth.PilotAssigned to outlet BerthEvents
      }
      on event Berth.TugsOrdered is {
        send event Berth.TugsOrdered to outlet BerthEvents
      }
      on event Berth.VesselArrived is {
        send event Berth.VesselArrived to outlet BerthEvents
      }
      on event Berth.MooringCompleted is {
        send event Berth.MooringCompleted to outlet BerthEvents
      }
      on event Berth.CargoOperationsStarted is {
        send event Berth.CargoOperationsStarted to outlet BerthEvents
      }
      on event Berth.CargoOperationsCompleted is {
        send event Berth.CargoOperationsCompleted to outlet BerthEvents
      }
      on event Berth.VesselDeparted is {
        send event Berth.VesselDeparted to outlet BerthEvents
      }
      on event Berth.PortChargesGenerated is {
        send event Berth.PortChargesGenerated to outlet BerthEvents
      }
      on event Berth.PortCallCancelled is {
        send event Berth.PortCallCancelled to outlet BerthEvents
      }
      on event Berth.BerthMaintenanceScheduled is {
        send event Berth.BerthMaintenanceScheduled to outlet BerthEvents
      }
      on other is {
        error "Unexpected message for source BerthEventSource"
      }
    } with {
      briefly "Berth source handler"
      described as {
        |Publishes Berth events onto the outlet.
      }
    }
  } with {
    briefly "Berth event source"
    described as {
      |Publishes Berth entity events into the streaming topology.
    }
  }
  processor BerthEventSink as sink is {
    inlet BerthInlet is type BerthEvent
    handler BerthSinkHandler is {
      on event Berth.BerthCreated is {
        tell event Berth.BerthCreated to repository BerthContext.BerthRepository
      }
      on event Berth.BerthDetailsUpdated is {
        tell event Berth.BerthDetailsUpdated to repository BerthContext.BerthRepository
      }
      on event Berth.BerthRequested is {
        tell event Berth.BerthRequested to repository BerthContext.BerthRepository
      }
      on event Berth.BerthAssignmentConfirmed is {
        tell event Berth.BerthAssignmentConfirmed to repository BerthContext.BerthRepository
      }
      on event Berth.PilotAssigned is {
        tell event Berth.PilotAssigned to repository BerthContext.BerthRepository
      }
      on event Berth.TugsOrdered is {
        tell event Berth.TugsOrdered to repository BerthContext.BerthRepository
      }
      on event Berth.VesselArrived is {
        tell event Berth.VesselArrived to repository BerthContext.BerthRepository
      }
      on event Berth.MooringCompleted is {
        tell event Berth.MooringCompleted to repository BerthContext.BerthRepository
      }
      on event Berth.CargoOperationsStarted is {
        tell event Berth.CargoOperationsStarted to repository BerthContext.BerthRepository
      }
      on event Berth.CargoOperationsCompleted is {
        tell event Berth.CargoOperationsCompleted to repository BerthContext.BerthRepository
      }
      on event Berth.VesselDeparted is {
        tell event Berth.VesselDeparted to repository BerthContext.BerthRepository
      }
      on event Berth.PortChargesGenerated is {
        tell event Berth.PortChargesGenerated to repository BerthContext.BerthRepository
      }
      on event Berth.PortCallCancelled is {
        tell event Berth.PortCallCancelled to repository BerthContext.BerthRepository
      }
      on event Berth.BerthMaintenanceScheduled is {
        tell event Berth.BerthMaintenanceScheduled to repository BerthContext.BerthRepository
      }
      on other is {
        error "Unexpected message for sink BerthEventSink"
      }
    } with {
      briefly "Berth sink handler"
      described as {
        |Persists Berth events via the repository.
      }
    }
  } with {
    briefly "Berth event sink"
    described as {
      |Receives Berth events for persistence.
    }
  }
  connector BerthEventFlow is {
    from outlet BerthContext.BerthEventSource.BerthEvents to
      inlet BerthContext.BerthEventSink.BerthInlet
  } with {
    briefly "Berth event flow"
    described as {
      |Connects the Berth source to its sink.
    }
  }
  processor BerthEventSplit is {
    inlet BerthEventSplitIn is type BerthEvent
    outlet BerthEventSplitToBerthRepository is type BerthEvent
    outlet BerthEventSplitToPortAnalytics is type BerthEvent
    handler BerthEventSplitHandler is {
      on event Berth.BerthCreated is {
        send event Berth.BerthCreated to outlet BerthEventSplitToBerthRepository
        send event Berth.BerthCreated to outlet BerthEventSplitToPortAnalytics
        tell event Berth.BerthCreated to entity BerthContext.Berth
      }
      on event Berth.BerthDetailsUpdated is {
        send event Berth.BerthDetailsUpdated to outlet BerthEventSplitToBerthRepository
        send event Berth.BerthDetailsUpdated to outlet BerthEventSplitToPortAnalytics
        tell event Berth.BerthDetailsUpdated to entity BerthContext.Berth
      }
      on event Berth.BerthRequested is {
        send event Berth.BerthRequested to outlet BerthEventSplitToBerthRepository
        send event Berth.BerthRequested to outlet BerthEventSplitToPortAnalytics
        tell event Berth.BerthRequested to entity BerthContext.Berth
      }
      on event Berth.BerthAssignmentConfirmed is {
        send event Berth.BerthAssignmentConfirmed to outlet BerthEventSplitToBerthRepository
        send event Berth.BerthAssignmentConfirmed to outlet BerthEventSplitToPortAnalytics
        tell event Berth.BerthAssignmentConfirmed to entity BerthContext.Berth
      }
      on event Berth.PilotAssigned is {
        send event Berth.PilotAssigned to outlet BerthEventSplitToBerthRepository
        send event Berth.PilotAssigned to outlet BerthEventSplitToPortAnalytics
        tell event Berth.PilotAssigned to entity BerthContext.Berth
      }
      on event Berth.TugsOrdered is {
        send event Berth.TugsOrdered to outlet BerthEventSplitToBerthRepository
        send event Berth.TugsOrdered to outlet BerthEventSplitToPortAnalytics
        tell event Berth.TugsOrdered to entity BerthContext.Berth
      }
      on event Berth.VesselArrived is {
        send event Berth.VesselArrived to outlet BerthEventSplitToBerthRepository
        send event Berth.VesselArrived to outlet BerthEventSplitToPortAnalytics
        tell event Berth.VesselArrived to entity BerthContext.Berth
      }
      on event Berth.MooringCompleted is {
        send event Berth.MooringCompleted to outlet BerthEventSplitToBerthRepository
        send event Berth.MooringCompleted to outlet BerthEventSplitToPortAnalytics
        tell event Berth.MooringCompleted to entity BerthContext.Berth
      }
      on event Berth.CargoOperationsStarted is {
        send event Berth.CargoOperationsStarted to outlet BerthEventSplitToBerthRepository
        send event Berth.CargoOperationsStarted to outlet BerthEventSplitToPortAnalytics
        tell event Berth.CargoOperationsStarted to entity BerthContext.Berth
      }
      on event Berth.CargoOperationsCompleted is {
        send event Berth.CargoOperationsCompleted to outlet BerthEventSplitToBerthRepository
        send event Berth.CargoOperationsCompleted to outlet BerthEventSplitToPortAnalytics
        tell event Berth.CargoOperationsCompleted to entity BerthContext.Berth
      }
      on event Berth.VesselDeparted is {
        send event Berth.VesselDeparted to outlet BerthEventSplitToBerthRepository
        send event Berth.VesselDeparted to outlet BerthEventSplitToPortAnalytics
        tell event Berth.VesselDeparted to entity BerthContext.Berth
      }
      on event Berth.PortChargesGenerated is {
        send event Berth.PortChargesGenerated to outlet BerthEventSplitToBerthRepository
        send event Berth.PortChargesGenerated to outlet BerthEventSplitToPortAnalytics
        tell event Berth.PortChargesGenerated to entity BerthContext.Berth
      }
      on event Berth.PortCallCancelled is {
        send event Berth.PortCallCancelled to outlet BerthEventSplitToBerthRepository
        send event Berth.PortCallCancelled to outlet BerthEventSplitToPortAnalytics
        tell event Berth.PortCallCancelled to entity BerthContext.Berth
      }
      on event Berth.BerthMaintenanceScheduled is {
        send event Berth.BerthMaintenanceScheduled to outlet BerthEventSplitToBerthRepository
        send event Berth.BerthMaintenanceScheduled to outlet BerthEventSplitToPortAnalytics
        tell event Berth.BerthMaintenanceScheduled to entity BerthContext.Berth
      }
      on other is {
        error "Unexpected message for processor BerthEventSplit"
      }
    } with {
      briefly "Berth event fan-out handler"
      described as {
        |Delivers each Berth event to all of its consumers.
      }
    }
  } with {
    briefly "Berth event fan-out"
    described as {
      |Fans Berth events out to the repository and projectors.
    }
  }
  connector LinkBerthToBerthEventSplit is {
    from outlet BerthContext.Berth.BerthEvents2 to
      inlet BerthContext.BerthEventSplit.BerthEventSplitIn
  } with {
    briefly "LinkBerthToBerthEventSplit"
  }
  connector LinkBerthEventSplitToBerthRepository is {
    from outlet BerthContext.BerthEventSplit.BerthEventSplitToBerthRepository to
      inlet BerthContext.BerthRepository.BerthRepositoryFromBerth
  } with {
    briefly "LinkBerthEventSplitToBerthRepository"
  }
  connector LinkBerthEventSplitToPortAnalytics is {
    from outlet BerthContext.BerthEventSplit.BerthEventSplitToPortAnalytics to
      inlet BerthContext.PortAnalytics.PortAnalyticsFromBerth
  } with {
    briefly "LinkBerthEventSplitToPortAnalytics"
  }
  connector LinkPortAnalyticsToBerthRepository is {
    from outlet BerthContext.PortAnalytics.PortAnalyticsOut to
      inlet BerthContext.BerthRepository.BerthRepositoryFromPortAnalytics
  } with {
    briefly "LinkPortAnalyticsToBerthRepository"
  }
} with {
  briefly "Bounded context for berth management"
  described as {
    | The BerthContext is the bounded context for
    | berth allocation and port call management.
  }
}
