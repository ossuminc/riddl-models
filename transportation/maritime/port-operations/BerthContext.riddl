// Port Operations - Berth Context
context BerthContext is {
  adaptor FromCustomsService from context CustomsService is { 
    handler FromCustomsServiceHandler is {
      on event CustomsService.ArrivalNotificationAcknowledged is {
        do "the model receives arrival notification acknowledged"
      }
      on event CustomsService.ClearanceGranted is {
        do "the model receives clearance granted"
      }
      on event CustomsService.ClearanceHeld is {
        do "the model receives clearance held"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomsService"
      }
    } with {
      briefly "from customs service"
      described as {
        |Carries messages from the external CustomsService.
      }
    }
  } with {
    briefly "CustomsService integration"
    described as {
      |The model's side of the CustomsService conversation.
    }
  }
  adaptor ToCustomsService to context CustomsService is { 
    handler ToCustomsServiceHandler is {
      on command CustomsService.SubmitArrivalNotification is {
        do "the model sends submit arrival notification"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomsService"
      }
    } with {
      briefly "to customs service"
      described as {
        |Carries messages to the external CustomsService.
      }
    }
  } with {
    briefly "CustomsService integration"
    described as {
      |The model's side of the CustomsService conversation.
    }
  }
  adaptor FromPilotCoordinationService from context PilotCoordinationService is { 
    handler FromPilotCoordinationServiceHandler is {
      on result PilotCoordinationService.AvailablePilotsResult is {
        do "the model receives available pilots result"
      }
      on event PilotCoordinationService.PilotAssignmentConfirmed is {
        do "the model receives pilot assignment confirmed"
      }
      on event PilotCoordinationService.PilotDisembarked is {
        do "the model receives pilot disembarked"
      }
      on event PilotCoordinationService.PilotOnBoard is {
        do "the model receives pilot on board"
      }
      on other is {
        error "Unexpected message for adaptor FromPilotCoordinationService"
      }
    } with {
      briefly "from pilot coordination service"
      described as {
        |Carries messages from the external PilotCoordinationService.
      }
    }
  } with {
    briefly "PilotCoordinationService integration"
    described as {
      |The model's side of the PilotCoordinationService conversation.
    }
  }
  adaptor ToPilotCoordinationService to context PilotCoordinationService is { 
    handler ToPilotCoordinationServiceHandler is {
      on query PilotCoordinationService.GetAvailablePilots is {
        do "the model sends get available pilots"
      }
      on command PilotCoordinationService.RequestPilot is {
        do "the model sends request pilot"
      }
      on other is {
        error "Unexpected message for adaptor ToPilotCoordinationService"
      }
    } with {
      briefly "to pilot coordination service"
      described as {
        |Carries messages to the external PilotCoordinationService.
      }
    }
  } with {
    briefly "PilotCoordinationService integration"
    described as {
      |The model's side of the PilotCoordinationService conversation.
    }
  }
  adaptor FromPortBillingService from context PortBillingService is { 
    handler FromPortBillingServiceHandler is {
      on event PortBillingService.InvoiceGenerated is {
        do "the model receives invoice generated"
      }
      on event PortBillingService.PaymentReceived is {
        do "the model receives payment received"
      }
      on other is {
        error "Unexpected message for adaptor FromPortBillingService"
      }
    } with {
      briefly "from port billing service"
      described as {
        |Carries messages from the external PortBillingService.
      }
    }
  } with {
    briefly "PortBillingService integration"
    described as {
      |The model's side of the PortBillingService conversation.
    }
  }
  adaptor ToPortBillingService to context PortBillingService is { 
    handler ToPortBillingServiceHandler is {
      on command PortBillingService.GenerateInvoice is {
        do "the model sends generate invoice"
      }
      on other is {
        error "Unexpected message for adaptor ToPortBillingService"
      }
    } with {
      briefly "to port billing service"
      described as {
        |Carries messages to the external PortBillingService.
      }
    }
  } with {
    briefly "PortBillingService integration"
    described as {
      |The model's side of the PortBillingService conversation.
    }
  }
  adaptor FromTerminalOperatingSystem from context TerminalOperatingSystem is { 
    handler FromTerminalOperatingSystemHandler is {
      on event TerminalOperatingSystem.CargoOperationScheduled is {
        do "the model receives cargo operation scheduled"
      }
      on event TerminalOperatingSystem.CraneMoveCompleted is {
        do "the model receives crane move completed"
      }
      on result TerminalOperatingSystem.YardCapacityResult is {
        do "the model receives yard capacity result"
      }
      on other is {
        error "Unexpected message for adaptor FromTerminalOperatingSystem"
      }
    } with {
      briefly "from terminal operating system"
      described as {
        |Carries messages from the external TerminalOperatingSystem.
      }
    }
  } with {
    briefly "TerminalOperatingSystem integration"
    described as {
      |The model's side of the TerminalOperatingSystem conversation.
    }
  }
  adaptor ToTerminalOperatingSystem to context TerminalOperatingSystem is { 
    handler ToTerminalOperatingSystemHandler is {
      on query TerminalOperatingSystem.GetYardCapacity is {
        do "the model sends get yard capacity"
      }
      on command TerminalOperatingSystem.ScheduleCargoOperation is {
        do "the model sends schedule cargo operation"
      }
      on other is {
        error "Unexpected message for adaptor ToTerminalOperatingSystem"
      }
    } with {
      briefly "to terminal operating system"
      described as {
        |Carries messages to the external TerminalOperatingSystem.
      }
    }
  } with {
    briefly "TerminalOperatingSystem integration"
    described as {
      |The model's side of the TerminalOperatingSystem conversation.
    }
  }
  adaptor FromTowageService from context TowageService is { 
    handler FromTowageServiceHandler is {
      on result TowageService.AvailableTugsResult is {
        do "the model receives available tugs result"
      }
      on event TowageService.TugOperationCompleted is {
        do "the model receives tug operation completed"
      }
      on event TowageService.TugOperationStarted is {
        do "the model receives tug operation started"
      }
      on event TowageService.TugsConfirmed is {
        do "the model receives tugs confirmed"
      }
      on other is {
        error "Unexpected message for adaptor FromTowageService"
      }
    } with {
      briefly "from towage service"
      described as {
        |Carries messages from the external TowageService.
      }
    }
  } with {
    briefly "TowageService integration"
    described as {
      |The model's side of the TowageService conversation.
    }
  }
  adaptor ToTowageService to context TowageService is { 
    handler ToTowageServiceHandler is {
      on query TowageService.GetAvailableTugs is {
        do "the model sends get available tugs"
      }
      on command TowageService.OrderTugs is {
        do "the model sends order tugs"
      }
      on other is {
        error "Unexpected message for adaptor ToTowageService"
      }
    } with {
      briefly "to towage service"
      described as {
        |Carries messages to the external TowageService.
      }
    }
  } with {
    briefly "TowageService integration"
    described as {
      |The model's side of the TowageService conversation.
    }
  }
  adaptor FromVesselTrafficService from context VesselTrafficService is { 
    handler FromVesselTrafficServiceHandler is {
      on event VesselTrafficService.VesselApproaching is {
        do "the model receives vessel approaching"
      }
      on event VesselTrafficService.VesselInPortLimits is {
        do "the model receives vessel in port limits"
      }
      on result VesselTrafficService.VesselPositionResult is {
        do "the model receives vessel position result"
      }
      on other is {
        error "Unexpected message for adaptor FromVesselTrafficService"
      }
    } with {
      briefly "from vessel traffic service"
      described as {
        |Carries messages from the external VesselTrafficService.
      }
    }
  } with {
    briefly "VesselTrafficService integration"
    described as {
      |The model's side of the VesselTrafficService conversation.
    }
  }
  adaptor ToVesselTrafficService to context VesselTrafficService is { 
    handler ToVesselTrafficServiceHandler is {
      on query VesselTrafficService.GetVesselPosition is {
        do "the model sends get vessel position"
      }
      on other is {
        error "Unexpected message for adaptor ToVesselTrafficService"
      }
    } with {
      briefly "to vessel traffic service"
      described as {
        |Carries messages to the external VesselTrafficService.
      }
    }
  } with {
    briefly "VesselTrafficService integration"
    described as {
      |The model's side of the VesselTrafficService conversation.
    }
  }
  include "types.riddl"
  include "Berth.riddl"
  include "PortCall.riddl"
  // Repository for berth persistence
  repository BerthRepository as merge is {
    inlet BerthRepositoryFromBerth is type BerthEvent    inlet BerthRepositoryFromPortAnalytics is type BerthEvent    inlet BerthRepositoryFromPortCall is type PortCall.PortCallEvent    outlet BerthRepositoryResponses is type Berth.BerthResult
    record StoredBerth is  {
      berthId: BerthId with {
        briefly "berthId"
        described as {
          |The berthId column of the stored berth row.
        }
      }
      details: BerthDetails with {
        briefly "details"
        described as {
          |The details column of the stored berth row.
        }
      }
      status: BerthStatus with {
        briefly "status"
        described as {
          |The status column of the stored berth row.
        }
      }
    } with {
      briefly "Stored berth row"
      described as {
        |The persistence shape of berth data as this repository stores it.
      }
    }
    schema BerthData is relational
      of berths as type StoredBerth
        index on field StoredBerth.berthId
        index on field StoredBerth.details.terminalId
        index on field StoredBerth.details.berthNumber
        index on field StoredBerth.status
 with {
      briefly "Berth data schema"
      described as {
        |The relational schema holding berth data for the BerthRepository.
      }
    }
    handler BerthPersistence is {
      on query GetPortStats is {
        do "read the port stats projection"
        reply result PortStatsView
      }
      on command Berth.CreateBerth is {
        tell event Berth.BerthCreated to entity BerthContext.Berth
        do "Store new berth"
      }
      on command Berth.UpdateBerthDetails is {
        tell event Berth.BerthDetailsUpdated to entity BerthContext.Berth
        do "Update berth details"
      }
      on command PortCall.RequestBerth is {
        do "Store berth request"
      }
      on command PortCall.ConfirmBerthAssignment is {
        tell event PortCall.BerthAssignmentConfirmed to entity BerthContext.Berth
        do "Store berth assignment"
      }
      on command PortCall.AssignPilot is {
        tell event PortCall.PilotAssigned to entity BerthContext.Berth
        do "Store pilot assignment"
      }
      on command BerthContext.PortCall.OrderTugs is {
        do "Store tug order"
      }
      on command PortCall.RecordVesselArrival is {
        do "Update to occupied"
      }
      on command PortCall.RecordMooring is {
        do "Store mooring record"
      }
      on command PortCall.StartCargoOperations is {
        tell event PortCall.CargoOperationsStarted to entity BerthContext.Berth
        do "Store cargo operation start"
      }
      on command PortCall.CompleteCargoOperations is {
        tell event PortCall.CargoOperationsCompleted to entity BerthContext.Berth
        do "Store cargo operation completion"
      }
      on command PortCall.RecordVesselDeparture is {
        do "Update to available"
      }
      on command PortCall.GeneratePortCharges is {
        do "Store port charges"
      }
      on command PortCall.CancelPortCall is {
        tell event PortCall.PortCallCancelled to entity BerthContext.Berth
        do "Update port call status"
      }
      on command Berth.SetBerthMaintenance is {
        do "Store maintenance schedule"
      }
    } with {
      briefly "Persists berth commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Berth data persistence"
    described as {
      | The BerthRepository provides persistent storage
      | for berths and port call data.
    }
  }
  // Projector for port analytics
  query GetPortStats is  {
    portStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which port stats to retrieve.
      }
    }
  } with {
    briefly "Get port stats"
    described as {
      |Retrieves the port stats projection.
    }
  }
  result PortStatsView is  {
    portStats: PortAnalytics.PortStats with {
      briefly "Port stats"
      described as {
        |The port stats being returned.
      }
    }
  } with {
    briefly "Port stats view"
    described as {
      |Read model view carrying the port stats projection.
    }
  }
  projector PortAnalytics as flow is {
    updates repository BerthContext.BerthRepository
    inlet PortAnalyticsFromBerth is type BerthEvent    outlet PortAnalyticsOut is type BerthEvent
    record PortStats is  {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      vesselCalls: Natural with {
        briefly "Calls"
        described as {
          |Vessel port calls.
        }
      }
      totalCargoVolume: Decimal(14,2) with {
        briefly "Cargo"
        described as {
          |Total cargo volume.
        }
      }
      averageTurnaroundTime: Duration with {
        briefly "Turnaround"
        described as {
          |Avg turnaround time.
        }
      }
      berthUtilization: Decimal(5,2) with {
        briefly "Utilization"
        described as {
          |Berth utilization percent.
        }
      }
      totalRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Total port charges.
        }
      }
      craneMoves: Natural with {
        briefly "Moves"
        described as {
          |Total crane moves.
        }
      }
    } with {
      briefly "Port statistics"
      described as {
        |Daily port metrics.
      }
    }
    handler AnalyticsHandler is {
      on event PortCall.VesselArrived is {
        tell event PortCall.VesselArrived to repository BerthContext.BerthRepository
        do "Update arrival metrics"
      }
      on event PortCall.CargoOperationsCompleted is {
        tell event PortCall.CargoOperationsCompleted to repository BerthContext.BerthRepository
        do "Update cargo metrics"
      }
      on event PortCall.VesselDeparted is {
        tell event PortCall.VesselDeparted to repository BerthContext.BerthRepository
        do "Update turnaround metrics"
      }
      on event PortCall.PortChargesGenerated is {
        tell event PortCall.PortChargesGenerated to repository BerthContext.BerthRepository
        do "Update revenue metrics"
      }
    } with {
      briefly "Maintains port analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Port analytics projections"
    described as {
      |Maintains port operational analytics.
    }
  }
  // ---- Event publication for Berth ----
  type BerthEvent is one of {
    BerthContext.Berth.BerthCreated or BerthContext.Berth.BerthDetailsUpdated or BerthContext.PortCall.BerthRequested or BerthContext.PortCall.BerthAssignmentConfirmed or BerthContext.PortCall.PilotAssigned or BerthContext.PortCall.TugsOrdered or BerthContext.PortCall.VesselArrived or BerthContext.PortCall.MooringCompleted or BerthContext.PortCall.CargoOperationsStarted or BerthContext.PortCall.CargoOperationsCompleted or BerthContext.PortCall.VesselDeparted or BerthContext.PortCall.PortChargesGenerated or BerthContext.PortCall.PortCallCancelled or BerthContext.Berth.BerthMaintenanceScheduled
  } with {
    briefly "Berth event alternation"
    described as {
      |Union of all Berth events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BerthEventSource as source is {
    outlet BerthEvents is type BerthEvent
    handler BerthSourceHandler is {
      on event Berth.BerthCreated is {
        send event Berth.BerthCreated to outlet BerthEvents
      }
      on event Berth.BerthDetailsUpdated is {
        send event Berth.BerthDetailsUpdated to outlet BerthEvents
      }
      on event PortCall.BerthRequested is {
        send event PortCall.BerthRequested to outlet BerthEvents
      }
      on event PortCall.BerthAssignmentConfirmed is {
        send event PortCall.BerthAssignmentConfirmed to outlet BerthEvents
      }
      on event PortCall.PilotAssigned is {
        send event PortCall.PilotAssigned to outlet BerthEvents
      }
      on event PortCall.TugsOrdered is {
        send event PortCall.TugsOrdered to outlet BerthEvents
      }
      on event PortCall.VesselArrived is {
        send event PortCall.VesselArrived to outlet BerthEvents
      }
      on event PortCall.MooringCompleted is {
        send event PortCall.MooringCompleted to outlet BerthEvents
      }
      on event PortCall.CargoOperationsStarted is {
        send event PortCall.CargoOperationsStarted to outlet BerthEvents
      }
      on event PortCall.CargoOperationsCompleted is {
        send event PortCall.CargoOperationsCompleted to outlet BerthEvents
      }
      on event PortCall.VesselDeparted is {
        send event PortCall.VesselDeparted to outlet BerthEvents
      }
      on event PortCall.PortChargesGenerated is {
        send event PortCall.PortChargesGenerated to outlet BerthEvents
      }
      on event PortCall.PortCallCancelled is {
        send event PortCall.PortCallCancelled to outlet BerthEvents
      }
      on event Berth.BerthMaintenanceScheduled is {
        send event Berth.BerthMaintenanceScheduled to outlet BerthEvents
      }
      on other is {
        error "Unexpected message for source BerthEventSource"
      }
    } with {
      briefly "Berth source handler"
      described as {
        |Publishes Berth events onto the outlet.
      }
    }
  } with {
    briefly "Berth event source"
    described as {
      |Publishes Berth entity events into the streaming topology.
    }
  }
  processor BerthEventSink as sink is {
    inlet BerthInlet is type BerthEvent    handler BerthSinkHandler is {
      on event Berth.BerthCreated is {
        tell event Berth.BerthCreated to repository BerthContext.BerthRepository
      }
      on event Berth.BerthDetailsUpdated is {
        tell event Berth.BerthDetailsUpdated to repository BerthContext.BerthRepository
      }
      on event PortCall.BerthRequested is {
        tell event PortCall.BerthRequested to repository BerthContext.BerthRepository
      }
      on event PortCall.BerthAssignmentConfirmed is {
        tell event PortCall.BerthAssignmentConfirmed to repository BerthContext.BerthRepository
      }
      on event PortCall.PilotAssigned is {
        tell event PortCall.PilotAssigned to repository BerthContext.BerthRepository
      }
      on event PortCall.TugsOrdered is {
        tell event PortCall.TugsOrdered to repository BerthContext.BerthRepository
      }
      on event PortCall.VesselArrived is {
        tell event PortCall.VesselArrived to repository BerthContext.BerthRepository
      }
      on event PortCall.MooringCompleted is {
        tell event PortCall.MooringCompleted to repository BerthContext.BerthRepository
      }
      on event PortCall.CargoOperationsStarted is {
        tell event PortCall.CargoOperationsStarted to repository BerthContext.BerthRepository
      }
      on event PortCall.CargoOperationsCompleted is {
        tell event PortCall.CargoOperationsCompleted to repository BerthContext.BerthRepository
      }
      on event PortCall.VesselDeparted is {
        tell event PortCall.VesselDeparted to repository BerthContext.BerthRepository
      }
      on event PortCall.PortChargesGenerated is {
        tell event PortCall.PortChargesGenerated to repository BerthContext.BerthRepository
      }
      on event PortCall.PortCallCancelled is {
        tell event PortCall.PortCallCancelled to repository BerthContext.BerthRepository
      }
      on event Berth.BerthMaintenanceScheduled is {
        tell event Berth.BerthMaintenanceScheduled to repository BerthContext.BerthRepository
      }
      on other is {
        error "Unexpected message for sink BerthEventSink"
      }
    } with {
      briefly "Berth sink handler"
      described as {
        |Persists Berth events via the repository.
      }
    }
  } with {
    briefly "Berth event sink"
    described as {
      |Receives Berth events for persistence.
    }
  }
  connector 'PortCall Storage' is from outlet BerthContext.PortCall.PortCallEvents to inlet BerthContext.BerthRepository.BerthRepositoryFromPortCall with {
    briefly "Port call events to repository"
    described as {
      |Carries port call events to the repository that persists them.
    }
  }
  connector BerthEventFlow is from outlet BerthContext.BerthEventSource.BerthEvents to inlet BerthContext.BerthEventSink.BerthInlet with {
    briefly "Berth event flow"
    described as {
      |Connects the Berth source to its sink.
    }
  }
  processor BerthEventSplit as split is {
    inlet BerthEventSplitIn is type BerthEvent    outlet BerthEventSplitToBerthRepository is type BerthEvent
    outlet BerthEventSplitToPortAnalytics is type BerthEvent
    handler BerthEventSplitHandler is {
      on event Berth.BerthCreated is {
        send event Berth.BerthCreated to outlet BerthEventSplitToBerthRepository
        send event Berth.BerthCreated to outlet BerthEventSplitToPortAnalytics
        tell event Berth.BerthCreated to entity BerthContext.Berth
      }
      on event Berth.BerthDetailsUpdated is {
        send event Berth.BerthDetailsUpdated to outlet BerthEventSplitToBerthRepository
        send event Berth.BerthDetailsUpdated to outlet BerthEventSplitToPortAnalytics
        tell event Berth.BerthDetailsUpdated to entity BerthContext.Berth
      }
      on event PortCall.BerthRequested is {
        send event PortCall.BerthRequested to outlet BerthEventSplitToBerthRepository
        send event PortCall.BerthRequested to outlet BerthEventSplitToPortAnalytics
        tell event PortCall.BerthRequested to entity BerthContext.Berth
      }
      on event PortCall.BerthAssignmentConfirmed is {
        send event PortCall.BerthAssignmentConfirmed to outlet BerthEventSplitToBerthRepository
        send event PortCall.BerthAssignmentConfirmed to outlet BerthEventSplitToPortAnalytics
        tell event PortCall.BerthAssignmentConfirmed to entity BerthContext.Berth
      }
      on event PortCall.PilotAssigned is {
        send event PortCall.PilotAssigned to outlet BerthEventSplitToBerthRepository
        send event PortCall.PilotAssigned to outlet BerthEventSplitToPortAnalytics
        tell event PortCall.PilotAssigned to entity BerthContext.Berth
      }
      on event PortCall.TugsOrdered is {
        send event PortCall.TugsOrdered to outlet BerthEventSplitToBerthRepository
        send event PortCall.TugsOrdered to outlet BerthEventSplitToPortAnalytics
        tell event PortCall.TugsOrdered to entity BerthContext.Berth
      }
      on event PortCall.VesselArrived is {
        send event PortCall.VesselArrived to outlet BerthEventSplitToBerthRepository
        send event PortCall.VesselArrived to outlet BerthEventSplitToPortAnalytics
        tell event PortCall.VesselArrived to entity BerthContext.Berth
      }
      on event PortCall.MooringCompleted is {
        send event PortCall.MooringCompleted to outlet BerthEventSplitToBerthRepository
        send event PortCall.MooringCompleted to outlet BerthEventSplitToPortAnalytics
        tell event PortCall.MooringCompleted to entity BerthContext.Berth
      }
      on event PortCall.CargoOperationsStarted is {
        send event PortCall.CargoOperationsStarted to outlet BerthEventSplitToBerthRepository
        send event PortCall.CargoOperationsStarted to outlet BerthEventSplitToPortAnalytics
        tell event PortCall.CargoOperationsStarted to entity BerthContext.Berth
      }
      on event PortCall.CargoOperationsCompleted is {
        send event PortCall.CargoOperationsCompleted to outlet BerthEventSplitToBerthRepository
        send event PortCall.CargoOperationsCompleted to outlet BerthEventSplitToPortAnalytics
        tell event PortCall.CargoOperationsCompleted to entity BerthContext.Berth
      }
      on event PortCall.VesselDeparted is {
        send event PortCall.VesselDeparted to outlet BerthEventSplitToBerthRepository
        send event PortCall.VesselDeparted to outlet BerthEventSplitToPortAnalytics
        tell event PortCall.VesselDeparted to entity BerthContext.Berth
      }
      on event PortCall.PortChargesGenerated is {
        send event PortCall.PortChargesGenerated to outlet BerthEventSplitToBerthRepository
        send event PortCall.PortChargesGenerated to outlet BerthEventSplitToPortAnalytics
        tell event PortCall.PortChargesGenerated to entity BerthContext.Berth
      }
      on event PortCall.PortCallCancelled is {
        send event PortCall.PortCallCancelled to outlet BerthEventSplitToBerthRepository
        send event PortCall.PortCallCancelled to outlet BerthEventSplitToPortAnalytics
        tell event PortCall.PortCallCancelled to entity BerthContext.Berth
      }
      on event Berth.BerthMaintenanceScheduled is {
        send event Berth.BerthMaintenanceScheduled to outlet BerthEventSplitToBerthRepository
        send event Berth.BerthMaintenanceScheduled to outlet BerthEventSplitToPortAnalytics
        tell event Berth.BerthMaintenanceScheduled to entity BerthContext.Berth
      }
      on other is {
        error "Unexpected message for processor BerthEventSplit"
      }
    } with {
      briefly "Berth event fan-out handler"
      described as {
        |Delivers each Berth event to all of its consumers.
      }
    }
  } with {
    briefly "Berth event fan-out"
    described as {
      |Fans Berth events out to the repository and projectors.
    }
  }
  connector 'BerthEvent Stream' is from outlet BerthContext.Berth.BerthEvents2 to inlet BerthContext.BerthEventSplit.BerthEventSplitIn with {
    briefly "Berth events, fanned out to storage and read models"
  }
  connector 'BerthEvent Storage' is from outlet BerthContext.BerthEventSplit.BerthEventSplitToBerthRepository to inlet BerthContext.BerthRepository.BerthRepositoryFromBerth with {
    briefly "Berth events on their way to storage"
  }
  connector 'PortAnalytics Feed' is from outlet BerthContext.BerthEventSplit.BerthEventSplitToPortAnalytics to inlet BerthContext.PortAnalytics.PortAnalyticsFromBerth with {
    briefly "Berth events feeding the PortAnalytics projection"
  }
  connector 'PortAnalytics Storage' is from outlet BerthContext.PortAnalytics.PortAnalyticsOut to inlet BerthContext.BerthRepository.BerthRepositoryFromPortAnalytics with {
    briefly "The PortAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for berth management"
  described as {
    | The BerthContext is the bounded context for
    | berth allocation and port call management.
  }
}
