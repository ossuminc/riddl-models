// Port Operations - Berth Context
context BerthContext as router is {
  inlet PortCallCommandStreamIn is type PortCallCommand  outlet PortCallCommandStreamOut is type PortCallCommand
  inlet BerthCommandStreamIn is type BerthCommand  outlet BerthCommandStreamOut is type BerthCommand
  inlet BerthResultStreamIn is type Berth.BerthResult  outlet BerthResultStreamOut is type Berth.BerthResult
  handler BerthContextBoundary is {
    on requestBerth: command PortCall.RequestBerth is {
      send requestBerth to outlet BerthContext.PortCallCommandStreamOut
    }
    on confirmBerthAssignment: command PortCall.ConfirmBerthAssignment is {
      send confirmBerthAssignment to outlet BerthContext.PortCallCommandStreamOut
    }
    on assignPilot: command PortCall.AssignPilot is {
      send assignPilot to outlet BerthContext.PortCallCommandStreamOut
    }
    on orderTugs: command PortCall.OrderTugs is {
      send orderTugs to outlet BerthContext.PortCallCommandStreamOut
    }
    on recordVesselArrival: command PortCall.RecordVesselArrival is {
      send recordVesselArrival to outlet BerthContext.PortCallCommandStreamOut
    }
    on recordMooring: command PortCall.RecordMooring is {
      send recordMooring to outlet BerthContext.PortCallCommandStreamOut
    }
    on startCargoOperations: command PortCall.StartCargoOperations is {
      send startCargoOperations to outlet BerthContext.PortCallCommandStreamOut
    }
    on completeCargoOperations: command PortCall.CompleteCargoOperations is {
      send completeCargoOperations to outlet BerthContext.PortCallCommandStreamOut
    }
    on recordVesselDeparture: command PortCall.RecordVesselDeparture is {
      send recordVesselDeparture to outlet BerthContext.PortCallCommandStreamOut
    }
    on generatePortCharges: command PortCall.GeneratePortCharges is {
      send generatePortCharges to outlet BerthContext.PortCallCommandStreamOut
    }
    on cancelPortCall: command PortCall.CancelPortCall is {
      send cancelPortCall to outlet BerthContext.PortCallCommandStreamOut
    }
    on createBerth: command Berth.CreateBerth is {
      send createBerth to outlet BerthContext.BerthCommandStreamOut
    }
    on updateBerthDetails: command Berth.UpdateBerthDetails is {
      send updateBerthDetails to outlet BerthContext.BerthCommandStreamOut
    }
    on setBerthMaintenance: command Berth.SetBerthMaintenance is {
      send setBerthMaintenance to outlet BerthContext.BerthCommandStreamOut
    }
    on berthResult: result Berth.BerthResult is {
      send berthResult to outlet BerthContext.BerthResultStreamOut
    }
    on other is {
      error "Unexpected message at the BerthContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PortCallCommand Stream Intake' is from outlet BerthContext.PortCallCommandStreamOut to inlet BerthContext.PortCall.PortCallCommands  connector 'BerthCommand Stream Intake' is from outlet BerthContext.BerthCommandStreamOut to inlet BerthContext.Berth.BerthCommands  connector 'BerthResult Stream Egress' is from outlet BerthContext.BerthRepository.BerthRepositoryResponses to inlet BerthContext.BerthResultStreamIn  adaptor FromCustomsService from context CustomsService is { 
    handler FromCustomsServiceHandler is {
      on event CustomsService.ArrivalNotificationAcknowledged is {
        do "the model receives arrival notification acknowledged"
      }
      on event CustomsService.ClearanceGranted is {
        do "the model receives clearance granted"
      }
      on event CustomsService.ClearanceHeld is {
        do "the model receives clearance held"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomsService"
      }
    } with {
      briefly "from customs service"
      described as {
        |Carries messages from the external CustomsService.
      }
    }
  } with {
    briefly "CustomsService integration"
    described as {
      |The model's side of the CustomsService conversation.
    }
  }
  adaptor ToCustomsService to context CustomsService is { 
    handler ToCustomsServiceHandler is {
      on command CustomsService.SubmitArrivalNotification is {
        do "the model sends submit arrival notification"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomsService"
      }
    } with {
      briefly "to customs service"
      described as {
        |Carries messages to the external CustomsService.
      }
    }
  } with {
    briefly "CustomsService integration"
    described as {
      |The model's side of the CustomsService conversation.
    }
  }
  adaptor FromPilotCoordinationService from context PilotCoordinationService is { 
    handler FromPilotCoordinationServiceHandler is {
      on result PilotCoordinationService.AvailablePilotsResult is {
        do "the model receives available pilots result"
      }
      on event PilotCoordinationService.PilotAssignmentConfirmed is {
        do "the model receives pilot assignment confirmed"
      }
      on event PilotCoordinationService.PilotDisembarked is {
        do "the model receives pilot disembarked"
      }
      on event PilotCoordinationService.PilotOnBoard is {
        do "the model receives pilot on board"
      }
      on other is {
        error "Unexpected message for adaptor FromPilotCoordinationService"
      }
    } with {
      briefly "from pilot coordination service"
      described as {
        |Carries messages from the external PilotCoordinationService.
      }
    }
  } with {
    briefly "PilotCoordinationService integration"
    described as {
      |The model's side of the PilotCoordinationService conversation.
    }
  }
  adaptor ToPilotCoordinationService to context PilotCoordinationService is { 
    handler ToPilotCoordinationServiceHandler is {
      on query PilotCoordinationService.GetAvailablePilots is {
        do "the model sends get available pilots"
      }
      on command PilotCoordinationService.RequestPilot is {
        do "the model sends request pilot"
      }
      on other is {
        error "Unexpected message for adaptor ToPilotCoordinationService"
      }
    } with {
      briefly "to pilot coordination service"
      described as {
        |Carries messages to the external PilotCoordinationService.
      }
    }
  } with {
    briefly "PilotCoordinationService integration"
    described as {
      |The model's side of the PilotCoordinationService conversation.
    }
  }
  adaptor FromPortBillingService from context PortBillingService is { 
    handler FromPortBillingServiceHandler is {
      on event PortBillingService.InvoiceGenerated is {
        do "the model receives invoice generated"
      }
      on event PortBillingService.PaymentReceived is {
        do "the model receives payment received"
      }
      on other is {
        error "Unexpected message for adaptor FromPortBillingService"
      }
    } with {
      briefly "from port billing service"
      described as {
        |Carries messages from the external PortBillingService.
      }
    }
  } with {
    briefly "PortBillingService integration"
    described as {
      |The model's side of the PortBillingService conversation.
    }
  }
  adaptor ToPortBillingService to context PortBillingService is { 
    handler ToPortBillingServiceHandler is {
      on command PortBillingService.GenerateInvoice is {
        do "the model sends generate invoice"
      }
      on other is {
        error "Unexpected message for adaptor ToPortBillingService"
      }
    } with {
      briefly "to port billing service"
      described as {
        |Carries messages to the external PortBillingService.
      }
    }
  } with {
    briefly "PortBillingService integration"
    described as {
      |The model's side of the PortBillingService conversation.
    }
  }
  adaptor FromTerminalOperatingSystem from context TerminalOperatingSystem is { 
    handler FromTerminalOperatingSystemHandler is {
      on event TerminalOperatingSystem.CargoOperationScheduled is {
        do "the model receives cargo operation scheduled"
      }
      on event TerminalOperatingSystem.CraneMoveCompleted is {
        do "the model receives crane move completed"
      }
      on result TerminalOperatingSystem.YardCapacityResult is {
        do "the model receives yard capacity result"
      }
      on other is {
        error "Unexpected message for adaptor FromTerminalOperatingSystem"
      }
    } with {
      briefly "from terminal operating system"
      described as {
        |Carries messages from the external TerminalOperatingSystem.
      }
    }
  } with {
    briefly "TerminalOperatingSystem integration"
    described as {
      |The model's side of the TerminalOperatingSystem conversation.
    }
  }
  adaptor ToTerminalOperatingSystem to context TerminalOperatingSystem is { 
    handler ToTerminalOperatingSystemHandler is {
      on query TerminalOperatingSystem.GetYardCapacity is {
        do "the model sends get yard capacity"
      }
      on command TerminalOperatingSystem.ScheduleCargoOperation is {
        do "the model sends schedule cargo operation"
      }
      on other is {
        error "Unexpected message for adaptor ToTerminalOperatingSystem"
      }
    } with {
      briefly "to terminal operating system"
      described as {
        |Carries messages to the external TerminalOperatingSystem.
      }
    }
  } with {
    briefly "TerminalOperatingSystem integration"
    described as {
      |The model's side of the TerminalOperatingSystem conversation.
    }
  }
  adaptor FromTowageService from context TowageService is { 
    handler FromTowageServiceHandler is {
      on result TowageService.AvailableTugsResult is {
        do "the model receives available tugs result"
      }
      on event TowageService.TugOperationCompleted is {
        do "the model receives tug operation completed"
      }
      on event TowageService.TugOperationStarted is {
        do "the model receives tug operation started"
      }
      on event TowageService.TugsConfirmed is {
        do "the model receives tugs confirmed"
      }
      on other is {
        error "Unexpected message for adaptor FromTowageService"
      }
    } with {
      briefly "from towage service"
      described as {
        |Carries messages from the external TowageService.
      }
    }
  } with {
    briefly "TowageService integration"
    described as {
      |The model's side of the TowageService conversation.
    }
  }
  adaptor ToTowageService to context TowageService is { 
    handler ToTowageServiceHandler is {
      on query TowageService.GetAvailableTugs is {
        do "the model sends get available tugs"
      }
      on command TowageService.OrderTugs is {
        do "the model sends order tugs"
      }
      on other is {
        error "Unexpected message for adaptor ToTowageService"
      }
    } with {
      briefly "to towage service"
      described as {
        |Carries messages to the external TowageService.
      }
    }
  } with {
    briefly "TowageService integration"
    described as {
      |The model's side of the TowageService conversation.
    }
  }
  adaptor FromVesselTrafficService from context VesselTrafficService is { 
    handler FromVesselTrafficServiceHandler is {
      on event VesselTrafficService.VesselApproaching is {
        do "the model receives vessel approaching"
      }
      on event VesselTrafficService.VesselInPortLimits is {
        do "the model receives vessel in port limits"
      }
      on result VesselTrafficService.VesselPositionResult is {
        do "the model receives vessel position result"
      }
      on other is {
        error "Unexpected message for adaptor FromVesselTrafficService"
      }
    } with {
      briefly "from vessel traffic service"
      described as {
        |Carries messages from the external VesselTrafficService.
      }
    }
  } with {
    briefly "VesselTrafficService integration"
    described as {
      |The model's side of the VesselTrafficService conversation.
    }
  }
  adaptor ToVesselTrafficService to context VesselTrafficService is { 
    handler ToVesselTrafficServiceHandler is {
      on query VesselTrafficService.GetVesselPosition is {
        do "the model sends get vessel position"
      }
      on other is {
        error "Unexpected message for adaptor ToVesselTrafficService"
      }
    } with {
      briefly "to vessel traffic service"
      described as {
        |Carries messages to the external VesselTrafficService.
      }
    }
  } with {
    briefly "VesselTrafficService integration"
    described as {
      |The model's side of the VesselTrafficService conversation.
    }
  }
  include "types.riddl"
  include "Berth.riddl"
  include "PortCall.riddl"
  // Repository for berth persistence
  type BerthRepositoryCommand is one of {
    BerthContext.BerthRepository.PersistBerthAssignmentConfirmed or BerthContext.BerthRepository.PersistBerthCreated or BerthContext.BerthRepository.PersistBerthDetailsUpdated or BerthContext.BerthRepository.PersistBerthMaintenanceScheduled or BerthContext.BerthRepository.PersistBerthRequested or BerthContext.BerthRepository.PersistCargoOperationsCompleted or BerthContext.BerthRepository.PersistCargoOperationsStarted or BerthContext.BerthRepository.PersistMooringCompleted or BerthContext.BerthRepository.PersistPilotAssigned or BerthContext.BerthRepository.PersistPortCallCancelled or BerthContext.BerthRepository.PersistPortChargesGenerated or BerthContext.BerthRepository.PersistTugsOrdered or BerthContext.BerthRepository.PersistVesselArrived or BerthContext.BerthRepository.PersistVesselDeparted
  } with {
    briefly "Anything that writes BerthRepository"
    described as {
      |The persistence commands BerthRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository BerthRepository as flow is {
    inlet BerthRepositoryFromPortAnalytics is type BerthRepositoryCommand
    command PersistBerthAssignmentConfirmed is  {
      berthId: BerthId with {
        briefly "Row addressed"
        described as {
          |Which stored row BerthAssignmentConfirmed applies to.
        }
      }
    } with {
      briefly "Persist BerthAssignmentConfirmed"
      described as {
        |Instructs this repository to apply BerthAssignmentConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBerthCreated is  {
      berthId: BerthId with {
        briefly "Row addressed"
        described as {
          |Which stored row BerthCreated applies to.
        }
      }
    } with {
      briefly "Persist BerthCreated"
      described as {
        |Instructs this repository to apply BerthCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBerthDetailsUpdated is  {
      berthId: BerthId with {
        briefly "Row addressed"
        described as {
          |Which stored row BerthDetailsUpdated applies to.
        }
      }
    } with {
      briefly "Persist BerthDetailsUpdated"
      described as {
        |Instructs this repository to apply BerthDetailsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBerthMaintenanceScheduled is  {
      berthId: BerthId with {
        briefly "Row addressed"
        described as {
          |Which stored row BerthMaintenanceScheduled applies to.
        }
      }
    } with {
      briefly "Persist BerthMaintenanceScheduled"
      described as {
        |Instructs this repository to apply BerthMaintenanceScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBerthRequested is  {
      berthId: BerthId with {
        briefly "Row addressed"
        described as {
          |Which stored row BerthRequested applies to.
        }
      }
    } with {
      briefly "Persist BerthRequested"
      described as {
        |Instructs this repository to apply BerthRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCargoOperationsStarted is  {
      berthId: BerthId with {
        briefly "Row addressed"
        described as {
          |Which stored row CargoOperationsStarted applies to.
        }
      }
    } with {
      briefly "Persist CargoOperationsStarted"
      described as {
        |Instructs this repository to apply CargoOperationsStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMooringCompleted is  {
      berthId: BerthId with {
        briefly "Row addressed"
        described as {
          |Which stored row MooringCompleted applies to.
        }
      }
    } with {
      briefly "Persist MooringCompleted"
      described as {
        |Instructs this repository to apply MooringCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPilotAssigned is  {
      berthId: BerthId with {
        briefly "Row addressed"
        described as {
          |Which stored row PilotAssigned applies to.
        }
      }
    } with {
      briefly "Persist PilotAssigned"
      described as {
        |Instructs this repository to apply PilotAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPortCallCancelled is  {
      berthId: BerthId with {
        briefly "Row addressed"
        described as {
          |Which stored row PortCallCancelled applies to.
        }
      }
    } with {
      briefly "Persist PortCallCancelled"
      described as {
        |Instructs this repository to apply PortCallCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTugsOrdered is  {
      berthId: BerthId with {
        briefly "Row addressed"
        described as {
          |Which stored row TugsOrdered applies to.
        }
      }
    } with {
      briefly "Persist TugsOrdered"
      described as {
        |Instructs this repository to apply TugsOrdered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCargoOperationsCompleted is  {
      berthId: BerthId with {
        briefly "Row addressed"
        described as {
          |Which stored row CargoOperationsCompleted applies to.
        }
      }
    } with {
      briefly "Persist CargoOperationsCompleted"
      described as {
        |Instructs this repository to apply CargoOperationsCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPortChargesGenerated is  {
      berthId: BerthId with {
        briefly "Row addressed"
        described as {
          |Which stored row PortChargesGenerated applies to.
        }
      }
    } with {
      briefly "Persist PortChargesGenerated"
      described as {
        |Instructs this repository to apply PortChargesGenerated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVesselArrived is  {
      berthId: BerthId with {
        briefly "Row addressed"
        described as {
          |Which stored row VesselArrived applies to.
        }
      }
    } with {
      briefly "Persist VesselArrived"
      described as {
        |Instructs this repository to apply VesselArrived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVesselDeparted is  {
      berthId: BerthId with {
        briefly "Row addressed"
        described as {
          |Which stored row VesselDeparted applies to.
        }
      }
    } with {
      briefly "Persist VesselDeparted"
      described as {
        |Instructs this repository to apply VesselDeparted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet BerthRepositoryResponses is type Berth.BerthResult
    record StoredBerth is  {
      berthId: BerthId with {
        briefly "berthId"
        described as {
          |The berthId column of the stored berth row.
        }
      }
      details: BerthDetails with {
        briefly "details"
        described as {
          |The details column of the stored berth row.
        }
      }
      status: BerthStatus with {
        briefly "status"
        described as {
          |The status column of the stored berth row.
        }
      }
    } with {
      briefly "Stored berth row"
      described as {
        |The persistence shape of berth data as this repository stores it.
      }
    }
    schema BerthData is relational
      of berths as type StoredBerth
        index on field StoredBerth.berthId
        index on field StoredBerth.details.terminalId
        index on field StoredBerth.details.berthNumber
        index on field StoredBerth.status
 with {
      briefly "Berth data schema"
      described as {
        |The relational schema holding berth data for the BerthRepository.
      }
    }
    handler BerthPersistence is {
      on persistBerthAssignmentConfirmed: command PersistBerthAssignmentConfirmed is {
        do "apply BerthAssignmentConfirmed to the stored row"
      }
      on persistBerthCreated: command PersistBerthCreated is {
        do "apply BerthCreated to the stored row"
      }
      on persistBerthDetailsUpdated: command PersistBerthDetailsUpdated is {
        do "apply BerthDetailsUpdated to the stored row"
      }
      on persistBerthMaintenanceScheduled: command PersistBerthMaintenanceScheduled is {
        do "apply BerthMaintenanceScheduled to the stored row"
      }
      on persistBerthRequested: command PersistBerthRequested is {
        do "apply BerthRequested to the stored row"
      }
      on persistCargoOperationsStarted: command PersistCargoOperationsStarted is {
        do "apply CargoOperationsStarted to the stored row"
      }
      on persistMooringCompleted: command PersistMooringCompleted is {
        do "apply MooringCompleted to the stored row"
      }
      on persistPilotAssigned: command PersistPilotAssigned is {
        do "apply PilotAssigned to the stored row"
      }
      on persistPortCallCancelled: command PersistPortCallCancelled is {
        do "apply PortCallCancelled to the stored row"
      }
      on persistTugsOrdered: command PersistTugsOrdered is {
        do "apply TugsOrdered to the stored row"
      }
      on persistCargoOperationsCompleted: command PersistCargoOperationsCompleted is {
        do "apply CargoOperationsCompleted to the stored row"
      }
      on persistPortChargesGenerated: command PersistPortChargesGenerated is {
        do "apply PortChargesGenerated to the stored row"
      }
      on persistVesselArrived: command PersistVesselArrived is {
        do "apply VesselArrived to the stored row"
      }
      on persistVesselDeparted: command PersistVesselDeparted is {
        do "apply VesselDeparted to the stored row"
      }
      on query GetPortStats is {
        let portStatsView: type PortStatsView = prompt("read the port stats projection")
        reply portStatsView
      }
      on command BerthContext.PortCall.OrderTugs is {
        do "Store tug order"
      }
    } with {
      briefly "Persists berth commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Berth data persistence"
    described as {
      | The BerthRepository provides persistent storage
      | for berths and port call data.
    }
  }
  // Projector for port analytics
  query GetPortStats replies result PortStatsView is  {
    portStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which port stats to retrieve.
      }
    }
  } with {
    briefly "Get port stats"
    described as {
      |Retrieves the port stats projection.
    }
  }
  result PortStatsView is  {
    portStats: PortAnalytics.PortStats with {
      briefly "Port stats"
      described as {
        |The port stats being returned.
      }
    }
  } with {
    briefly "Port stats view"
    described as {
      |Read model view carrying the port stats projection.
    }
  }
  projector PortAnalytics as flow is {
    outlet PortAnalyticsToRepository is type BerthRepositoryCommand
    updates repository BerthContext.BerthRepository
    inlet PortAnalyticsFromBerth is type BerthEvent
    record PortStats is  {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      vesselCalls: Natural with {
        briefly "Calls"
        described as {
          |Vessel port calls.
        }
      }
      totalCargoVolume: Decimal(14,2) with {
        briefly "Cargo"
        described as {
          |Total cargo volume.
        }
      }
      averageTurnaroundTime: Duration with {
        briefly "Turnaround"
        described as {
          |Avg turnaround time.
        }
      }
      berthUtilization: Decimal(5,2) with {
        briefly "Utilization"
        described as {
          |Berth utilization percent.
        }
      }
      totalRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Total port charges.
        }
      }
      craneMoves: Natural with {
        briefly "Moves"
        described as {
          |Total crane moves.
        }
      }
    } with {
      briefly "Port statistics"
      described as {
        |Daily port metrics.
      }
    }
    handler AnalyticsHandler is {
      on berthAssignmentConfirmed: event PortCall.BerthAssignmentConfirmed is {
        tell command BerthContext.BerthRepository.PersistBerthAssignmentConfirmed(berthId = berthAssignmentConfirmed.berthId) to repository BerthContext.BerthRepository
        do "apply BerthAssignmentConfirmed to the PortAnalytics projection"
      }
      on berthCreated: event Berth.BerthCreated is {
        tell command BerthContext.BerthRepository.PersistBerthCreated(berthId = berthCreated.berthId) to repository BerthContext.BerthRepository
        do "apply BerthCreated to the PortAnalytics projection"
      }
      on berthDetailsUpdated: event Berth.BerthDetailsUpdated is {
        tell command BerthContext.BerthRepository.PersistBerthDetailsUpdated(berthId = berthDetailsUpdated.berthId) to repository BerthContext.BerthRepository
        do "apply BerthDetailsUpdated to the PortAnalytics projection"
      }
      on berthMaintenanceScheduled: event Berth.BerthMaintenanceScheduled is {
        tell command BerthContext.BerthRepository.PersistBerthMaintenanceScheduled(berthId = berthMaintenanceScheduled.berthId) to repository BerthContext.BerthRepository
        do "apply BerthMaintenanceScheduled to the PortAnalytics projection"
      }
      on berthRequested: event PortCall.BerthRequested is {
        tell command BerthContext.BerthRepository.PersistBerthRequested(berthId = berthRequested.berthId) to repository BerthContext.BerthRepository
        do "apply BerthRequested to the PortAnalytics projection"
      }
      on cargoOperationsStarted: event PortCall.CargoOperationsStarted is {
        tell command BerthContext.BerthRepository.PersistCargoOperationsStarted(berthId = cargoOperationsStarted.berthId) to repository BerthContext.BerthRepository
        do "apply CargoOperationsStarted to the PortAnalytics projection"
      }
      on mooringCompleted: event PortCall.MooringCompleted is {
        tell command BerthContext.BerthRepository.PersistMooringCompleted(berthId = mooringCompleted.berthId) to repository BerthContext.BerthRepository
        do "apply MooringCompleted to the PortAnalytics projection"
      }
      on pilotAssigned: event PortCall.PilotAssigned is {
        tell command BerthContext.BerthRepository.PersistPilotAssigned(berthId = pilotAssigned.berthId) to repository BerthContext.BerthRepository
        do "apply PilotAssigned to the PortAnalytics projection"
      }
      on portCallCancelled: event PortCall.PortCallCancelled is {
        tell command BerthContext.BerthRepository.PersistPortCallCancelled(berthId = portCallCancelled.berthId) to repository BerthContext.BerthRepository
        do "apply PortCallCancelled to the PortAnalytics projection"
      }
      on tugsOrdered: event PortCall.TugsOrdered is {
        tell command BerthContext.BerthRepository.PersistTugsOrdered(berthId = tugsOrdered.berthId) to repository BerthContext.BerthRepository
        do "apply TugsOrdered to the PortAnalytics projection"
      }
      on vesselArrived: event PortCall.VesselArrived is {
        tell command BerthContext.BerthRepository.PersistVesselArrived(berthId = vesselArrived.berthId) to repository BerthContext.BerthRepository
        do "Update arrival metrics"
      }
      on cargoOperationsCompleted: event PortCall.CargoOperationsCompleted is {
        tell command BerthContext.BerthRepository.PersistCargoOperationsCompleted(berthId = cargoOperationsCompleted.berthId) to repository BerthContext.BerthRepository
        do "Update cargo metrics"
      }
      on vesselDeparted: event PortCall.VesselDeparted is {
        tell command BerthContext.BerthRepository.PersistVesselDeparted(berthId = vesselDeparted.berthId) to repository BerthContext.BerthRepository
        do "Update turnaround metrics"
      }
      on portChargesGenerated: event PortCall.PortChargesGenerated is {
        tell command BerthContext.BerthRepository.PersistPortChargesGenerated(berthId = portChargesGenerated.berthId) to repository BerthContext.BerthRepository
        do "Update revenue metrics"
      }
    } with {
      briefly "Maintains port analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Port analytics projections"
    described as {
      |Maintains port operational analytics.
    }
  }
  // ---- Event publication for Berth ----
  type BerthEvent is one of {
    BerthContext.Berth.BerthCreated or BerthContext.Berth.BerthDetailsUpdated or BerthContext.PortCall.BerthRequested or BerthContext.PortCall.BerthAssignmentConfirmed or BerthContext.PortCall.PilotAssigned or BerthContext.PortCall.TugsOrdered or BerthContext.PortCall.VesselArrived or BerthContext.PortCall.MooringCompleted or BerthContext.PortCall.CargoOperationsStarted or BerthContext.PortCall.CargoOperationsCompleted or BerthContext.PortCall.VesselDeparted or BerthContext.PortCall.PortChargesGenerated or BerthContext.PortCall.PortCallCancelled or BerthContext.Berth.BerthMaintenanceScheduled
  } with {
    briefly "Berth event alternation"
    described as {
      |Union of all Berth events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BerthEventSplit as flow is {
    inlet BerthEventSplitIn is type BerthEvent
    outlet BerthEventSplitToPortAnalytics is type BerthEvent
    handler BerthEventSplitHandler is {
      on berthCreated: event Berth.BerthCreated is {
        send berthCreated to outlet BerthEventSplitToPortAnalytics
        tell berthCreated to entity BerthContext.Berth
      }
      on berthDetailsUpdated: event Berth.BerthDetailsUpdated is {
        send berthDetailsUpdated to outlet BerthEventSplitToPortAnalytics
        tell berthDetailsUpdated to entity BerthContext.Berth
      }
      on berthRequested: event PortCall.BerthRequested is {
        send berthRequested to outlet BerthEventSplitToPortAnalytics
        tell berthRequested to entity BerthContext.Berth
      }
      on berthAssignmentConfirmed: event PortCall.BerthAssignmentConfirmed is {
        send berthAssignmentConfirmed to outlet BerthEventSplitToPortAnalytics
        tell berthAssignmentConfirmed to entity BerthContext.Berth
      }
      on pilotAssigned: event PortCall.PilotAssigned is {
        send pilotAssigned to outlet BerthEventSplitToPortAnalytics
        tell pilotAssigned to entity BerthContext.Berth
      }
      on tugsOrdered: event PortCall.TugsOrdered is {
        send tugsOrdered to outlet BerthEventSplitToPortAnalytics
        tell tugsOrdered to entity BerthContext.Berth
      }
      on vesselArrived: event PortCall.VesselArrived is {
        send vesselArrived to outlet BerthEventSplitToPortAnalytics
        tell vesselArrived to entity BerthContext.Berth
      }
      on mooringCompleted: event PortCall.MooringCompleted is {
        send mooringCompleted to outlet BerthEventSplitToPortAnalytics
        tell mooringCompleted to entity BerthContext.Berth
      }
      on cargoOperationsStarted: event PortCall.CargoOperationsStarted is {
        send cargoOperationsStarted to outlet BerthEventSplitToPortAnalytics
        tell cargoOperationsStarted to entity BerthContext.Berth
      }
      on cargoOperationsCompleted: event PortCall.CargoOperationsCompleted is {
        send cargoOperationsCompleted to outlet BerthEventSplitToPortAnalytics
        tell cargoOperationsCompleted to entity BerthContext.Berth
      }
      on vesselDeparted: event PortCall.VesselDeparted is {
        send vesselDeparted to outlet BerthEventSplitToPortAnalytics
        tell vesselDeparted to entity BerthContext.Berth
      }
      on portChargesGenerated: event PortCall.PortChargesGenerated is {
        send portChargesGenerated to outlet BerthEventSplitToPortAnalytics
        tell portChargesGenerated to entity BerthContext.Berth
      }
      on portCallCancelled: event PortCall.PortCallCancelled is {
        send portCallCancelled to outlet BerthEventSplitToPortAnalytics
        tell portCallCancelled to entity BerthContext.Berth
      }
      on berthMaintenanceScheduled: event Berth.BerthMaintenanceScheduled is {
        send berthMaintenanceScheduled to outlet BerthEventSplitToPortAnalytics
        tell berthMaintenanceScheduled to entity BerthContext.Berth
      }
      on other is {
        error "Unexpected message for processor BerthEventSplit"
      }
    } with {
      briefly "Berth event fan-out handler"
      described as {
        |Delivers each Berth event to all of its consumers.
      }
    }
  } with {
    briefly "Berth event fan-out"
    described as {
      |Fans Berth events out to the repository and projectors.
    }
  }
  connector 'BerthEvent Stream' is from outlet BerthContext.Berth.BerthEvents2 to inlet BerthContext.BerthEventSplit.BerthEventSplitIn with {
    briefly "Berth events, fanned out to storage and read models"
  }
  connector 'PortAnalytics Feed' is from outlet BerthContext.BerthEventSplit.BerthEventSplitToPortAnalytics to inlet BerthContext.PortAnalytics.PortAnalyticsFromBerth with {
    briefly "Berth events feeding the PortAnalytics projection"
  }
  connector 'PortAnalytics Storage' is from outlet BerthContext.PortAnalytics.PortAnalyticsToRepository to inlet BerthContext.BerthRepository.BerthRepositoryFromPortAnalytics with {
    briefly "PortAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for berth management"
  described as {
    | The BerthContext is the bounded context for
    | berth allocation and port call management.
  }
}
