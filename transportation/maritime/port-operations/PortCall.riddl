// Port Operations - PortCall Entity
// // A port call is its own aggregate: one visit of one vessel to the port, from
// the request for a berth through to departure and charging. PortCallStatus
// enumerates its eight stages, which is why they live here -- a Berth is a
// fixed piece of quay that outlives every call made against it, and cannot
// meaningfully be "Arriving" or "Departing".
aggregate event-sourced entity PortCall as flow is {
  type PortCallCommand is one of {
    PortCall.RequestBerth or PortCall.ConfirmBerthAssignment or PortCall.AssignPilot or PortCall.OrderTugs or PortCall.RecordVesselArrival or PortCall.RecordMooring or PortCall.StartCargoOperations or PortCall.CompleteCargoOperations or PortCall.RecordVesselDeparture or PortCall.GeneratePortCharges or PortCall.CancelPortCall
  } with {
    briefly "Port call command alternation"
    described as {
      |Commands accepted by the PortCall entity.
    }
  }
  type PortCallEvent is one of {
    PortCall.BerthRequested or PortCall.BerthAssignmentConfirmed or PortCall.PilotAssigned or PortCall.TugsOrdered or PortCall.VesselArrived or PortCall.MooringCompleted or PortCall.CargoOperationsStarted or PortCall.CargoOperationsCompleted or PortCall.VesselDeparted or PortCall.PortChargesGenerated or PortCall.PortCallCancelled
  } with {
    briefly "Port call event alternation"
    described as {
      |Events published by the PortCall entity.
    }
  }
  inlet PortCallCommands is type PortCallCommand  outlet PortCallEvents is type PortCallEvent
  query GetPortCall replies result PortCall.PortCallResult is {
    portCallId: PortCallId with {
      briefly "ID"
      described as {
        |Identifier of the port call to retrieve.
      }
    }
  } with {
    briefly "Get port call"
    described as {
      |Retrieve port call data by identifier.
    }
  }
  result PortCallResult is {
    portCallData: PortCall.RequestedStateData with {
      briefly "Port call data"
      described as {
        |The requested port call data.
      }
    }
  } with {
    briefly "Port call result"
    described as {
      |Result carrying the requested port call data.
    }
  }
  command RequestBerth yields event BerthRequested is {
    portCallId: PortCallId with {
      briefly "PortCall ID"
      described as {
        |Identifies the PortCall instance this message addresses.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    request: PortCallRequest with {
      briefly "Request"
      described as {
        |Port call request.
      }
    }
  } with {
    briefly "Request berth"
    described as {
      |Requests berth allocation for port call.
    }
  }
  command ConfirmBerthAssignment yields event BerthAssignmentConfirmed is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    assignment: BerthAssignment with {
      briefly "Assignment"
      described as {
        |Berth assignment details.
      }
    }
  } with {
    briefly "Confirm berth"
    described as {
      |Confirms berth assignment.
    }
  }
  command AssignPilot yields event PilotAssigned is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    pilotage: PilotageInfo with {
      briefly "Pilotage"
      described as {
        |Pilotage details.
      }
    }
  } with {
    briefly "Assign pilot"
    described as {
      |Assigns pilot for arrival.
    }
  }
  command OrderTugs yields event TugsOrdered is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    tugs: TugService with {
      briefly "Tugs"
      described as {
        |Tug service details.
      }
    }
  } with {
    briefly "Order tugs"
    described as {
      |Orders tug assistance.
    }
  }
  command RecordVesselArrival yields event VesselArrived is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    arrivedAt: TimeStamp with {
      briefly "Arrived"
      described as {
        |Arrival time.
      }
    }
    actualDraft: Decimal(4,2) with {
      briefly "Draft"
      described as {
        |Actual draft.
      }
    }
  } with {
    briefly "Record arrival"
    described as {
      |Records vessel arrival.
    }
  }
  command RecordMooring yields event MooringCompleted is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    mooring: MooringOperation with {
      briefly "Mooring"
      described as {
        |Mooring details.
      }
    }
  } with {
    briefly "Record mooring"
    described as {
      |Records mooring completion.
    }
  }
  command StartCargoOperations yields event CargoOperationsStarted is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    operation: CargoOperation with {
      briefly "Operation"
      described as {
        |Cargo operation details.
      }
    }
  } with {
    briefly "Start cargo operations"
    described as {
      |Starts cargo handling.
    }
  }
  command CompleteCargoOperations yields event CargoOperationsCompleted is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    completion: CargoOperation with {
      briefly "Completion"
      described as {
        |Completed operation.
      }
    }
  } with {
    briefly "Complete cargo operations"
    described as {
      |Completes cargo handling.
    }
  }
  command RecordVesselDeparture yields event VesselDeparted is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    departedAt: TimeStamp with {
      briefly "Departed"
      described as {
        |Departure time.
      }
    }
    nextPort: String(1,200) with {
      briefly "Next port"
      described as {
        |Next destination.
      }
    }
  } with {
    briefly "Record departure"
    described as {
      |Records vessel departure.
    }
  }
  command GeneratePortCharges yields event PortChargesGenerated is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    charges: PortCharges with {
      briefly "Charges"
      described as {
        |Port charges.
      }
    }
  } with {
    briefly "Generate charges"
    described as {
      |Generates port call charges.
    }
  }
  command CancelPortCall yields event PortCallCancelled is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
  } with {
    briefly "Cancel port call"
    described as {
      |Cancels scheduled port call.
    }
  }
  event BerthRequested is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    request: PortCallRequest with {
      briefly "Request"
      described as {
        |Port call request.
      }
    }
    requestedAt: TimeStamp with {
      briefly "Requested"
      described as {
        |Request time.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
    }
  } with {
    briefly "Berth requested"
    described as {
      |Emitted when berth is requested.
    }
  }
  event BerthAssignmentConfirmed is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    assignment: BerthAssignment with {
      briefly "Assignment"
      described as {
        |Assignment details.
      }
    }
    confirmedAt: TimeStamp with {
      briefly "Confirmed"
      described as {
        |Confirmation time.
      }
    }
  } with {
    briefly "Berth confirmed"
    described as {
      |Emitted when berth is confirmed.
    }
  }
  event PilotAssigned is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    pilotage: PilotageInfo with {
      briefly "Pilotage"
      described as {
        |Pilotage details.
      }
    }
  } with {
    briefly "Pilot assigned"
    described as {
      |Emitted when pilot is assigned.
    }
  }
  event TugsOrdered is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    tugs: TugService with {
      briefly "Tugs"
      described as {
        |Tug details.
      }
    }
    orderedAt: TimeStamp with {
      briefly "Ordered"
      described as {
        |Order time.
      }
    }
  } with {
    briefly "Tugs ordered"
    described as {
      |Emitted when tugs are ordered.
    }
  }
  event VesselArrived is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    arrivedAt: TimeStamp with {
      briefly "Arrived"
      described as {
        |Arrival time.
      }
    }
  } with {
    briefly "Vessel arrived"
    described as {
      |Emitted when vessel arrives.
    }
  }
  event MooringCompleted is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    mooring: MooringOperation with {
      briefly "Mooring"
      described as {
        |Mooring details.
      }
    }
  } with {
    briefly "Mooring completed"
    described as {
      |Emitted when mooring is done.
    }
  }
  event CargoOperationsStarted is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    operation: CargoOperation with {
      briefly "Operation"
      described as {
        |Cargo operation.
      }
    }
  } with {
    briefly "Cargo operations started"
    described as {
      |Emitted when cargo handling starts.
    }
  }
  event CargoOperationsCompleted is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    operation: CargoOperation with {
      briefly "Operation"
      described as {
        |Cargo operation.
      }
    }
  } with {
    briefly "Cargo operations completed"
    described as {
      |Emitted when cargo handling completes.
    }
  }
  event VesselDeparted is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    departedAt: TimeStamp with {
      briefly "Departed"
      described as {
        |Departure time.
      }
    }
    nextPort: String(1,200) with {
      briefly "Next port"
      described as {
        |Next destination.
      }
    }
  } with {
    briefly "Vessel departed"
    described as {
      |Emitted when vessel departs.
    }
  }
  event PortChargesGenerated is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    charges: PortCharges with {
      briefly "Charges"
      described as {
        |Port charges.
      }
    }
    generatedAt: TimeStamp with {
      briefly "Generated"
      described as {
        |Generation time.
      }
    }
  } with {
    briefly "Port charges generated"
    described as {
      |Emitted when charges are calculated.
    }
  }
  event PortCallCancelled is {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancel reason.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancel time.
      }
    }
  } with {
    briefly "Port call cancelled"
    described as {
      |Emitted when port call is cancelled.
    }
  }
  record RequestedStateData is {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
  } with {
    briefly "Requested port call"
    described as {
      |A port call where a berth has been requested but not yet confirmed.
    }
  }
  record ConfirmedStateData is {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
  } with {
    briefly "Confirmed port call"
    described as {
      |A port call where the berth assignment is confirmed and the vessel is expected.
    }
  }
  record ArrivingStateData is {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
    arrivedAt: TimeStamp? with {
      briefly "Arrived at"
    }
    orderedTugs: TugService? with {
      briefly "Tugs ordered"
    }
    tugsOrderedAt: TimeStamp? with {
      briefly "Tugs ordered at"
    }
  } with {
    briefly "Arriving port call"
    described as {
      |A port call where pilot and tugs are arranged and the vessel is approaching.
    }
  }
  record BerthedStateData is {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
  } with {
    briefly "Berthed port call"
    described as {
      |A port call where the vessel is moored alongside.
    }
  }
  record CargoOperationsStateData is {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
  } with {
    briefly "CargoOperations port call"
    described as {
      |A port call where cargo is being worked.
    }
  }
  record DepartingStateData is {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
    departedAt: TimeStamp? with {
      briefly "Departed at"
    }
    nextPort: String(1,200)? with {
      briefly "Next port"
    }
  } with {
    briefly "Departing port call"
    described as {
      |A port call where cargo work is complete and the vessel is unmooring.
    }
  }
  record CompletedStateData is {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
  } with {
    briefly "Completed port call"
    described as {
      |A port call where the vessel has sailed and charges are raised.
    }
  }
  record CancelledStateData is {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
  } with {
    briefly "Cancelled port call"
    described as {
      |A port call where the port call was abandoned.
    }
  }
  initial state RequestedState of record PortCall.RequestedStateData is {
    initial handler RequestedInitHandler is {
      on init is {
        let berthRequested: type BerthRequested = prompt("the berth requested that brings this port call into existence")
        yield berthRequested
      }
    } with {
      briefly "Requested init handler"
      described as {
        |Initializes a port call on entry to the Requested state.
      }
    }
  } with {
    briefly "Requested state"
    described as {
      |A port call where a berth has been requested but not yet confirmed.
    }
  }
  state ConfirmedState of record PortCall.ConfirmedStateData is {
    initial handler ConfirmedInitHandler is {
      on init is {
        let berthAssignmentConfirmed: type BerthAssignmentConfirmed = prompt("the berth assignment confirmed that brings this port call into existence")
        yield berthAssignmentConfirmed
      }
    } with {
      briefly "Confirmed init handler"
      described as {
        |Initializes a port call on entry to the Confirmed state.
      }
    }
  } with {
    briefly "Confirmed state"
    described as {
      |A port call where the berth assignment is confirmed and the vessel is expected.
    }
  }
  state ArrivingState of record PortCall.ArrivingStateData is {
    initial handler ArrivingInitHandler is {
      on init is {
        let pilotAssigned: type PilotAssigned = prompt("the pilot assigned that brings this port call into existence")
        yield pilotAssigned
      }
    } with {
      briefly "Arriving init handler"
      described as {
        |Initializes a port call on entry to the Arriving state.
      }
    }
  } with {
    briefly "Arriving state"
    described as {
      |A port call where pilot and tugs are arranged and the vessel is approaching.
    }
  }
  state BerthedState of record PortCall.BerthedStateData is {
    initial handler BerthedInitHandler is {
      on init is {
        let mooringCompleted: type MooringCompleted = prompt("the mooring completed that brings this port call into existence")
        yield mooringCompleted
      }
    } with {
      briefly "Berthed init handler"
      described as {
        |Initializes a port call on entry to the Berthed state.
      }
    }
  } with {
    briefly "Berthed state"
    described as {
      |A port call where the vessel is moored alongside.
    }
  }
  state CargoOperationsState of record PortCall.CargoOperationsStateData is {
    initial handler CargoOperationsInitHandler is {
      on init is {
        let cargoOperationsStarted: type CargoOperationsStarted = prompt("the cargo operations started that brings this port call into existence")
        yield cargoOperationsStarted
      }
    } with {
      briefly "CargoOperations init handler"
      described as {
        |Initializes a port call on entry to the CargoOperations state.
      }
    }
  } with {
    briefly "CargoOperations state"
    described as {
      |A port call where cargo is being worked.
    }
  }
  state DepartingState of record PortCall.DepartingStateData is {
    initial handler DepartingInitHandler is {
      on init is {
        let cargoOperationsCompleted: type CargoOperationsCompleted = prompt("the cargo operations completed that brings this port call into existence")
        yield cargoOperationsCompleted
      }
    } with {
      briefly "Departing init handler"
      described as {
        |Initializes a port call on entry to the Departing state.
      }
    }
  } with {
    briefly "Departing state"
    described as {
      |A port call where cargo work is complete and the vessel is unmooring.
    }
  }
  state CompletedState of record PortCall.CompletedStateData is {
    initial handler CompletedInitHandler is {
      on init is {
        let portChargesGenerated: type PortChargesGenerated = prompt("the port charges generated that brings this port call into existence")
        yield portChargesGenerated
      }
      on query GetPortCall is {
        let portCallResult: type PortCall.PortCallResult = prompt("read the port call from the store")
        reply portCallResult
      }
      on other is {
        error "a completed port call is read-only; it reports itself but accepts no changes"
      }
    } with {
      briefly "Completed init handler"
      described as {
        |Initializes a port call on entry to the Completed state.
      }
    }
  } with {
    briefly "Completed state"
    described as {
      |A port call where the vessel has sailed and charges are raised.
    }
  }
  state CancelledState of record PortCall.CancelledStateData is {
    initial handler CancelledInitHandler is {
      on init is {
        let portCallCancelled: type PortCallCancelled = prompt("the port call cancelled that brings this port call into existence")
        yield portCallCancelled
      }
      on other is {
        error "the port call was cancelled and accepts no further activity"
      }
    } with {
      briefly "Cancelled init handler"
      described as {
        |Initializes a port call on entry to the Cancelled state.
      }
    }
  } with {
    briefly "Cancelled state"
    described as {
      |A port call where the port call was abandoned.
    }
  }
  handler PortCallHandler is {
    on query GetPortCall is {
      let portCallResult: type PortCall.PortCallResult = prompt("read the port call from the store")
      reply portCallResult
    }
    on requestBerth: command RequestBerth is {
      yield event BerthRequested(berthId = requestBerth.berthId, request = requestBerth.request, requestedAt = prompt("the requested at of this berth requested"), portCallId = requestBerth.portCallId)
      send event PortCall.BerthRequested(berthId = requestBerth.berthId, request = requestBerth.request, requestedAt = prompt("the requested at of this berth requested"), portCallId = requestBerth.portCallId) to outlet PortCallEvents
    }
    on confirmBerthAssignment: command ConfirmBerthAssignment is {
      yield event BerthAssignmentConfirmed(berthId = confirmBerthAssignment.berthId, portCallId = confirmBerthAssignment.portCallId, assignment = confirmBerthAssignment.assignment, confirmedAt = prompt("the confirmed at of this berth assignment confirmed"))
      send event PortCall.BerthAssignmentConfirmed(berthId = confirmBerthAssignment.berthId, portCallId = confirmBerthAssignment.portCallId, assignment = confirmBerthAssignment.assignment, confirmedAt = prompt("the confirmed at of this berth assignment confirmed")) to outlet PortCallEvents
    }
    on assignPilot: command AssignPilot is {
      yield event PilotAssigned(berthId = assignPilot.berthId, portCallId = assignPilot.portCallId, pilotage = assignPilot.pilotage)
      send event PortCall.PilotAssigned(berthId = assignPilot.berthId, portCallId = assignPilot.portCallId, pilotage = assignPilot.pilotage) to outlet PortCallEvents
    }
    on orderTugs: command PortCall.OrderTugs is {
      yield event TugsOrdered(berthId = orderTugs.berthId, portCallId = orderTugs.portCallId, tugs = orderTugs.tugs, orderedAt = prompt("the ordered at of this tugs ordered"))
    }
    on recordVesselArrival: command RecordVesselArrival is {
      yield event VesselArrived(berthId = recordVesselArrival.berthId, portCallId = recordVesselArrival.portCallId, arrivedAt = recordVesselArrival.arrivedAt)
      send event PortCall.VesselArrived(berthId = recordVesselArrival.berthId, portCallId = recordVesselArrival.portCallId, arrivedAt = recordVesselArrival.arrivedAt) to outlet PortCallEvents
    }
    on recordMooring: command RecordMooring is {
      yield event MooringCompleted(berthId = recordMooring.berthId, portCallId = recordMooring.portCallId, mooring = recordMooring.mooring)
      send event PortCall.MooringCompleted(berthId = recordMooring.berthId, portCallId = recordMooring.portCallId, mooring = recordMooring.mooring) to outlet PortCallEvents
    }
    on startCargoOperations: command StartCargoOperations is {
      yield event CargoOperationsStarted(berthId = startCargoOperations.berthId, portCallId = startCargoOperations.portCallId, operation = startCargoOperations.operation)
      send event PortCall.CargoOperationsStarted(berthId = startCargoOperations.berthId, portCallId = startCargoOperations.portCallId, operation = startCargoOperations.operation) to outlet PortCallEvents
    }
    on completeCargoOperations: command CompleteCargoOperations is {
      yield event CargoOperationsCompleted(berthId = completeCargoOperations.berthId, portCallId = completeCargoOperations.portCallId, operation = prompt("the operation of this cargo operations completed"))
      send event PortCall.CargoOperationsCompleted(berthId = completeCargoOperations.berthId, portCallId = completeCargoOperations.portCallId, operation = prompt("the operation of this cargo operations completed")) to outlet PortCallEvents
    }
    on recordVesselDeparture: command RecordVesselDeparture is {
      yield event VesselDeparted(berthId = recordVesselDeparture.berthId, portCallId = recordVesselDeparture.portCallId, departedAt = recordVesselDeparture.departedAt, nextPort = recordVesselDeparture.nextPort)
      send event PortCall.VesselDeparted(berthId = recordVesselDeparture.berthId, portCallId = recordVesselDeparture.portCallId, departedAt = recordVesselDeparture.departedAt, nextPort = recordVesselDeparture.nextPort) to outlet PortCallEvents
    }
    on generatePortCharges: command GeneratePortCharges is {
      yield event PortChargesGenerated(berthId = generatePortCharges.berthId, portCallId = generatePortCharges.portCallId, charges = generatePortCharges.charges, generatedAt = prompt("the generated at of this port charges generated"))
      send event PortCall.PortChargesGenerated(berthId = generatePortCharges.berthId, portCallId = generatePortCharges.portCallId, charges = generatePortCharges.charges, generatedAt = prompt("the generated at of this port charges generated")) to outlet PortCallEvents
    }
    on cancelPortCall: command CancelPortCall is {
      yield event PortCallCancelled(berthId = cancelPortCall.berthId, portCallId = cancelPortCall.portCallId, reason = cancelPortCall.reason, cancelledAt = prompt("the cancelled at of this port call cancelled"))
      send event PortCall.PortCallCancelled(berthId = cancelPortCall.berthId, portCallId = cancelPortCall.portCallId, reason = cancelPortCall.reason, cancelledAt = prompt("the cancelled at of this port call cancelled")) to outlet PortCallEvents
    }
    on portCallCancelled: event PortCallCancelled is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.CancelledState with record PortCall.CancelledStateData(portCallId = portCallCancelled.portCallId, berthId = portCallCancelled.berthId, stateValue = prompt("the state value of this cancelled state data"))
    }
    on portChargesGenerated: event PortChargesGenerated is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.CompletedState with record PortCall.CompletedStateData(portCallId = portChargesGenerated.portCallId, berthId = portChargesGenerated.berthId, stateValue = prompt("the state value of this completed state data"))
    }
    on vesselDeparted: event VesselDeparted is {
      set field PortCall.DepartingState.stateValue to PortCallStatus.Completed
      set field PortCall.DepartingState.departedAt to vesselDeparted.departedAt
      set field PortCall.DepartingState.nextPort to vesselDeparted.nextPort
    }
    on cargoOperationsCompleted: event CargoOperationsCompleted is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.DepartingState with record PortCall.DepartingStateData(portCallId = cargoOperationsCompleted.portCallId, berthId = cargoOperationsCompleted.berthId, stateValue = prompt("the state value of this departing state data"), departedAt = empty, nextPort = empty)
    }
    on cargoOperationsStarted: event CargoOperationsStarted is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.CargoOperationsState with record PortCall.CargoOperationsStateData(portCallId = cargoOperationsStarted.portCallId, berthId = cargoOperationsStarted.berthId, stateValue = prompt("the state value of this cargo operations state data"))
    }
    on mooringCompleted: event MooringCompleted is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.BerthedState with record PortCall.BerthedStateData(portCallId = mooringCompleted.portCallId, berthId = mooringCompleted.berthId, stateValue = prompt("the state value of this berthed state data"))
    }
    on vesselArrived: event VesselArrived is {
      set field PortCall.ArrivingState.stateValue to PortCallStatus.Berthed
      set field PortCall.ArrivingState.arrivedAt to vesselArrived.arrivedAt
    }
    on tugsOrdered: event TugsOrdered is {
      set field PortCall.ArrivingState.orderedTugs to tugsOrdered.tugs
      set field PortCall.ArrivingState.tugsOrderedAt to tugsOrdered.orderedAt
    }
    on pilotAssigned: event PilotAssigned is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.ArrivingState with record PortCall.ArrivingStateData(portCallId = pilotAssigned.portCallId, berthId = pilotAssigned.berthId, stateValue = prompt("the state value of this arriving state data"), arrivedAt = empty, orderedTugs = empty, tugsOrderedAt = empty)
    }
    on berthAssignmentConfirmed: event BerthAssignmentConfirmed is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.ConfirmedState with record PortCall.ConfirmedStateData(portCallId = berthAssignmentConfirmed.portCallId, berthId = berthAssignmentConfirmed.berthId, stateValue = prompt("the state value of this confirmed state data"))
    }
    on berthRequested: event BerthRequested is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.RequestedState with record PortCall.RequestedStateData(berthId = berthRequested.berthId, stateValue = prompt("the state value of this requested state data"), portCallId = berthRequested.portCallId)
    }
  } with {
    briefly "Port call command handler"
    described as {
      |Walks a port call through its eight stages, from the berth request to
      |departure and charging, or to cancellation.
    }
  }
} with {
  briefly "A vessel's call at the port"
  described as {
    |One visit of one vessel: berth request, confirmation, arrival, mooring,
    |cargo work, departure and charges. Its own aggregate, because a berth
    |outlives every call made against it.
  }
}
